# The dynamic surface of libnupp: every symbol the embedding library exports,
# and every symbol the Nupp host executable exports on macOS. It is the one list
# each platform's linker is given -- an exported-symbols list on macOS, a version
# script on Linux, and a module definition file on Windows -- so a change to what
# either exports is a change to this file.
#
# A section header names the host crate features that bring its symbols in, and
# `always` is every build. A section applies when any feature it names is on.
#
# The LuaJIT C API is exported so that a host linking the dynamic library can
# use the state nupp_runtime_lua_state returns, and so that an ahead-of-time
# compiled module finds the API in the process. That pins the LuaJIT floor the
# embedding guide states. LUAJIT_VERSION_SYM stands for the version symbol the
# staged luajit.h names, which moves with the LuaJIT pin. lua_setlevel is
# declared by lua.h and defined nowhere, so it is absent.

[always]
# The embedding API, host/include/nupp.h.
nupp_config_init
nupp_runtime_new
nupp_runtime_attach
nupp_runtime_lua_state
nupp_runtime_add_feature
nupp_runtime_add_resource
nupp_runtime_preload
nupp_runtime_register_aot_builders
nupp_component_load
nupp_component_start
nupp_export_find
nupp_call
nupp_handle_release
nupp_value_release
nupp_runtime_shutdown
nupp_runtime_poll
nupp_reload_config_init
nupp_reload_open
nupp_reload_attach
nupp_reload_find
nupp_reload_prepare
nupp_reload_apply
nupp_reload_poll
nupp_reload_message
nupp_reload_close
nupp_reload_free
nupp_component_release
nupp_runtime_free
nupp_error_status
nupp_error_category
nupp_error_message
nupp_error_message_length
nupp_error_free

# The LuaJIT C API: lua.h, lauxlib.h, lualib.h and luajit.h.
lua_newstate
lua_close
