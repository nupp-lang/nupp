#!/bin/sh
# Build coordination runs on Nupp; the frozen Python driver stays available
# for first bootstrap and the existing explicit interpreter-only modes.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
serial() {
    remaining=$#
    while [ "$remaining" -gt 0 ]; do
        option=$1; shift
        remaining=$((remaining - 1))
        if [ "$option" = --compiler-generation ]; then
            echo "nupp: --compiler-generation requires the Nupp build coordinator" >&2
            exit 2
        elif [ "$option" = --jobs ]; then
            [ "$remaining" -gt 0 ] || { echo "nupp: --jobs requires 1 through 4" >&2; exit 2; }
            case "$1" in 1|2|3|4) ;; *) echo "nupp: --jobs requires 1 through 4" >&2; exit 2 ;; esac
            shift
            remaining=$((remaining - 1))
        else
            set -- "$@" "$option"
        fi
    done
    exec python3 "$ROOT/scripts/vm-cli" "$@"
}
case " $* " in
    *" --seed image "*|*" --no-aot "*|*" --no-cache "*)
        serial "$@" ;;
esac
if [ ! -f "$ROOT/.nupp/vm-cli/current" ] || [ "${NUPP_VM_BUILD_SERIAL:-0}" = 1 ]; then
    serial "$@"
fi
unset NO_AOT JIT_ONLY JIT_SKIP JIT_LIMIT AOT_ONLY JIT_REGALLOC EMIT_STUBS EMIT_SURVEY
unset GC_STRESS GC_INTERLEAVE GC_ORACLE GC_QUARANTINE
unset NUPP_VM_BINARY NUPP_VM_CLI_IMAGE NUPP_VM_EMIT_CACHE
unset NUPP_AOT_OBJECT NUPP_NATIVE_RUNTIME_OBJECT
export NO_JIT=1 NUPP_VM_AUTO_REBUILD=0 NUPP_COMPILER_ROOT="$ROOT"
GENERATION=$(cat "$ROOT/.nupp/vm-cli/current")
case "$GENERATION" in
    ""|*[!0-9a-f]*) echo "nupp: invalid compiler generation" >&2; exit 1 ;;
esac
[ "${#GENERATION}" -eq 64 ] || exit 1
PAIR="$ROOT/.nupp/vm-cli/$GENERATION"
case " $* " in
    *" --compiler-generation "*)
        if ! capability=$("$PAIR/runtime" run "$PAIR/compiler.image" nupp.tools.vm.build compilerSelection 2>/dev/null) \
            || [ "$capability" != 1 ]; then
            echo "nupp: rebuild once without --compiler-generation to update the build coordinator" >&2
            exit 2
        fi ;;
esac
# The compiler doing the build and its AOT job count, which the build key
# covers beside the sources (`scripts/shared-cache build-key`).
BUILDER=$GENERATION
JOBS=${NUPP_VM_AOT_JOBS:-4}
previous=""
for option in "$@"; do
    case "$previous" in
        --compiler-generation) BUILDER=$option ;;
        --jobs) JOBS=$option ;;
    esac
    previous=$option
done
SHARED="$ROOT/scripts/shared-cache"
# A build compiler this checkout lacks may be in the machine's shared store.
if [ ! -f "$ROOT/.nupp/vm-cli/$BUILDER/format" ]; then
    "$SHARED" materialize "$ROOT" "$BUILDER" > /dev/null 2>&1 || true
fi
# A build whose every input matches one made before, here or in any other
# checkout, selects what that build made instead of making it again.
# NUPP_VM_BUILD_FRESH=1 builds regardless.
KEY=""
if [ "${1:-}" = build ] && [ "${NUPP_VM_BUILD_FRESH:-0}" != 1 ]; then
    KEY=$("$SHARED" build-key "$ROOT" "$BUILDER" "$JOBS" 2> /dev/null || true)
    if [ -n "$KEY" ] && adopted=$("$SHARED" adopt "$ROOT" "$KEY" 2> /dev/null); then
        echo "vm-build: these inputs were built before; selected that compiler" >&2
        echo "$adopted"
        exit 0
    fi
fi
if available=$("$PAIR/runtime" run "$PAIR/compiler.image" nupp.tools.vm.build available 2>/dev/null) \
    && [ "$available" = 1 ]; then
    "$PAIR/runtime" exec "$PAIR/compiler.image" nupp.tools.vm.build "$ROOT" "$@" || exit $?
    # Remembered only when the sources did not move while it built.
    if [ -n "$KEY" ] && [ "$("$SHARED" build-key "$ROOT" "$BUILDER" "$JOBS" 2> /dev/null || true)" = "$KEY" ]; then
        "$SHARED" record "$ROOT" "$KEY" > /dev/null 2>&1 || true
    fi
    exit 0
fi
# The first build carries the coordinator into the linked compiler. Later
# builds execute that compiled coordinator rather than interpreting a script.
serial "$@"
