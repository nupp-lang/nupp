Fixes carried against the pinned LuaJIT, applied to a private copy of its
source by scripts/toolchain before it is built. Each hunk says why.

irt_size indexed the type-size table with the whole IR type, flags included,
so a guarded integer became a wrong width: ARM64 stack arguments stored a
uint32_t as a halfword.

--- a/src/lj_ir.h
+++ b/src/lj_ir.h
@@ -409,7 +409,7 @@
 #define irt_is64(t)		((IRT_IS64 >> irt_type(t)) & 1)
 #define irt_is64orfp(t)		(((IRT_IS64|(1u<<IRT_FLOAT))>>irt_type(t)) & 1)

-#define irt_size(t)		(lj_ir_type_size[irt_t((t))])
+#define irt_size(t)		(lj_ir_type_size[irt_type((t))])

 LJ_DATA const uint8_t lj_ir_type_size[];

ARM64's JFORI, the loop entry once a numeric for loop has a trace, leaves PC
at the loop body on its floating-point path when the loop runs no iterations,
so the body ran once. Any bound that is not an int32 takes that path:
`for i = 2.5, 0` or `for i = 0, -2^40` after the loop traced over integers.
The integer path and the other VMs branch to the loop exit here.

--- a/src/vm_arm64.dasc
+++ b/src/vm_arm64.dasc
@@ -3939,6 +3939,7 @@
     if (op == BC_FORI) {
       |  csel PC, RC, PC, hi
     } else if (op == BC_JFORI) {
+      |  mov PC, RC
       |  ldrh RCw, [RC, #-4+OFS_RD]
       |  bls =>BC_JLOOP
     } else if (op == BC_IFORL) {

Darwin tmpfile uses a process-wide signal mask while unlinking its file.
Concurrent Lua worker states can leave that mask blocked after returning.
Create and unlink the temporary file without changing signals.

--- a/src/lib_io.c
+++ b/src/lib_io.c
@@ -26,6 +26,36 @@
 #include "lj_ff.h"
 #include "lj_lib.h"
 #include "lj_strscan.h"
+
+#if LJ_TARGET_OSX
+#include <stdlib.h>
+#include <unistd.h>
+
+/* Darwin tmpfile() changes the process signal mask around unlink. Concurrent
+** calls can restore another thread's temporary mask and strand child exits.
+** An exclusively created, immediately unlinked file needs no signal masking.
+*/
+static FILE *io_tmpfile_open(void)
+{
+  char path[] = P_tmpdir "/lua_XXXXXX";
+  int fd = mkstemp(path);
+  FILE *fp;
+  if (fd < 0) return NULL;
+  if (unlink(path) != 0) {
+    int saved = errno;
+    close(fd);
+    errno = saved;
+    return NULL;
+  }
+  fp = fdopen(fd, "w+b");
+  if (!fp) {
+    int saved = errno;
+    close(fd);
+    errno = saved;
+  }
+  return fp;
+}
+#endif

 /* Userdata payload for I/O file. */
 typedef struct IOFileUD {
@@ -444,6 +474,8 @@
   IOFileUD *iof = io_file_new(L);
 #if LJ_TARGET_PS3 || LJ_TARGET_PS4 || LJ_TARGET_PS5 || LJ_TARGET_PSVITA || LJ_TARGET_NX
   iof->fp = NULL; errno = ENOSYS;
+#elif LJ_TARGET_OSX
+  iof->fp = io_tmpfile_open();
 #else
   iof->fp = tmpfile();
 #endif

On Windows, ffi.load(name, true) discarded its global flag, and ffi.C
searched only the executable, lua51, the C runtime, kernel32, user32 and
gdi32. A library loaded globally exported nothing to ffi.C, so a bare
`cdef function` binding one of its symbols failed where POSIX succeeds.
ffi.C now searches globally loaded modules after the defaults.

--- a/src/lj_clib.c
+++ b/src/lj_clib.c
@@ -171,6 +171,19 @@
 
 static void *clib_def_handle[CLIB_HANDLE_MAX];
 
+#if !LJ_TARGET_UWP
+/* Modules loaded with ffi.load(name, true). ffi.C searches them after the
+** default libraries, in load order, the way RTLD_GLOBAL adds a library to
+** the namespace a POSIX ffi.C searches. Each entry holds its own module
+** reference, so collecting the namespace ffi.load returned leaves it loaded.
+** Process-wide like clib_def_handle: a slot is claimed atomically and filled
+** afterwards, so a reader skips one it sees still empty.
+*/
+#define CLIB_GLOBAL_MAX	64
+static void *volatile clib_global_handle[CLIB_GLOBAL_MAX];
+static volatile LONG clib_global_count;
+#endif
+
 LJ_NORET LJ_NOINLINE static void clib_error(lua_State *L, const char *fmt,
 					    const char *name)
 {
@@ -213,8 +226,33 @@
   DWORD oldwerr = GetLastError();
   void *h = LJ_WIN_LOADLIBA(clib_extname(L, name));
   if (!h) clib_error(L, "cannot load module " LUA_QS ": %s", name);
-  SetLastError(oldwerr);
+#if !LJ_TARGET_UWP
+  if (global) {
+    LONG i, n = clib_global_count;
+    for (i = 0; i < n && i < CLIB_GLOBAL_MAX; i++)
+      if (clib_global_handle[i] == h) break;
+    if (i == n || i == CLIB_GLOBAL_MAX) {
+      HMODULE ref;
+      LONG slot = InterlockedIncrement(&clib_global_count) - 1;
+      if (slot >= CLIB_GLOBAL_MAX) {
+	InterlockedDecrement(&clib_global_count);
+	FreeLibrary((HINSTANCE)h);
+	lj_err_callermsg(L, lj_strfmt_pushf(L,
+	  "cannot load module " LUA_QS " globally: more than %d global modules",
+	  name, CLIB_GLOBAL_MAX));
+      }
+      /* The handle's address lies inside the module, so this takes a second
+      ** reference to the same module rather than loading anything. */
+      if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS,
+			      (const char *)h, &ref))
+	ref = (HMODULE)h;
+      clib_global_handle[slot] = (void *)ref;
+    }
+  }
+#else
   UNUSED(global);
+#endif
+  SetLastError(oldwerr);
   return h;
 }
 
@@ -272,6 +310,15 @@
       p = (void *)GetProcAddress(h, name);
       if (p) break;
     }
+#if !LJ_TARGET_UWP
+    if (!p) {  /* Then the modules loaded with ffi.load(name, true). */
+      LONG n = clib_global_count;
+      for (i = 0; i < (MSize)n && i < CLIB_GLOBAL_MAX; i++) {
+	HINSTANCE g = (HINSTANCE)clib_global_handle[i];
+	if (g && (p = (void *)GetProcAddress(g, name)) != NULL) break;
+      }
+    }
+#endif
   } else {
     p = (void *)GetProcAddress((HINSTANCE)cl->handle, name);
   }
