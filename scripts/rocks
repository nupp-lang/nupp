#!/bin/sh
# Installs the Lua libraries the toolchain uses into ./.rocks.
#
# A project-local tree, not the user's: two checkouts of Nupp may want different
# versions, and neither should be able to break the other's build by upgrading
# something. `bin/nupp` and `tests/run` put this tree on the search path, so a
# checkout that has run this script needs nothing installed globally.
#
# Every rock is pinned. LuaRocks resolves transitive dependencies itself, which
# is the point of using it, but the versions this project was written against
# are named here so that a fresh install and an old one are the same install.
set -e

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TREE="$ROOT/.rocks"

# LuaJIT is Lua 5.1, and the C rocks have to be compiled against its headers or
# they load into a VM that cannot call them.
LUA_VERSION=5.1
LUA_DIR="${NUPP_LUA_DIR:-$(luajit -e 'io.write(package.cpath:match("([^;]*)/lib/lua") or "")' 2>/dev/null)}"
[ -n "$LUA_DIR" ] || LUA_DIR=/usr/local

# Renders markdown for `nupp doc`. Pulls in lpeg, cosmo, alt-getopt and luautf8.
LUNAMARK=0.6.0-1
# Syntax highlighting for fenced code in the generated site. Not published on
# LuaRocks, so the rockspec beside this script points at the upstream release.
SCINTILLUA_ROCKSPEC="$ROOT/scripts/scintillua-6.7-1.rockspec"

command -v luarocks >/dev/null 2>&1 || {
    echo "nupp: luarocks is not on PATH; install it to build the docs" >&2
    exit 1
}

rocks() {
    luarocks --lua-version="$LUA_VERSION" --tree="$TREE" --lua-dir="$LUA_DIR" "$@"
}

echo "nupp: installing rocks into $TREE"
rocks install "lunamark" "$LUNAMARK"
rocks install "$SCINTILLUA_ROCKSPEC"
echo "nupp: done"
