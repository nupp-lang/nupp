#!/bin/sh
# Regenerates src/nupp/compiler/aot/llvm/wasm/libm.ll: the libm an independent
# Wasm AOT module links, as LLVM IR.
#
#   scripts/wasm-libm
#
# The functions are musl's, compiled for wasm32 with the clang of the LLVM the
# backend pins, because the browser guest's LuaJIT is a musl build and its
# math is the reference a Wasm kernel is compared with, bit for bit. Nothing
# about this runs when Nupp is built or used: the IR is committed, and a build
# compiles it once and links it beside each unit, which keeps what it uses.
#
# CLANG names the clang (default: clang); llvm-link and opt are taken from
# beside it. Its major version must be the pinned LLVM's.
set -eu

MUSL_VERSION=1.2.5
MUSL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4
# What the backend's IR can call, and so what the module exports to the unit.
API="sin cos tan asin acos atan atan2 sinh cosh tanh exp log pow fmod expf fma fmaf"
# The sources those need. sqrt, fabs and floor are Wasm instructions rather
# than musl's portable code (identical results: both are exact).
SOURCES="sin cos tan asin acos atan atan2 sinh cosh tanh exp log pow fmod expf fma fmaf
__sin __cos __tan __rem_pio2 __rem_pio2_large __expo2 expm1 scalbn
exp_data log_data pow_data exp2f_data
__math_divzero __math_invalid __math_oflow __math_oflowf __math_uflow __math_uflowf __math_xflow __math_xflowf"

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUTPUT="$ROOT/src/nupp/compiler/aot/llvm/wasm/libm.ll"
CLANG=${CLANG:-clang}
BIN=$(dirname "$(command -v "$CLANG")")
PINNED=$(sed -n 's/^LLVM_VERSION=//p' "$ROOT/scripts/toolchain.pins" | head -n 1)
FOUND=$("$CLANG" --version | sed -n 's/.*clang version \([0-9][0-9]*\)\..*/\1/p' | head -n 1)
if [ -n "$PINNED" ] && [ "${PINNED%%.*}" != "$FOUND" ]; then
    echo "wasm-libm: $CLANG is clang $FOUND; the backend pins LLVM $PINNED" >&2
    exit 1
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cd "$WORK"
curl -sSfL "https://musl.libc.org/releases/musl-$MUSL_VERSION.tar.gz" -o musl.tar.gz
echo "$MUSL_SHA256  musl.tar.gz" | shasum -a 256 -c - >/dev/null
tar xzf musl.tar.gz
MUSL="$WORK/musl-$MUSL_VERSION"

# musl has no wasm32 port. riscv32 is the ILP32, little-endian port whose long
# double is binary128 like wasm32's; its exception flags are replaced by the
# generic port's none, since Wasm has no floating-point environment.
mkdir -p include/bits
sed -f "$MUSL/tools/mkalltypes.sed" "$MUSL/arch/riscv32/bits/alltypes.h.in" "$MUSL/include/alltypes.h.in" \
    > include/bits/alltypes.h
cp "$MUSL/arch/generic/bits/fenv.h" include/bits/fenv.h
cat > instructions.c <<'EOF'
double sqrt(double x) { return __builtin_sqrt(x); }
double fabs(double x) { return __builtin_fabs(x); }
double floor(double x) { return __builtin_floor(x); }
EOF

FLAGS="--target=wasm32-unknown-unknown -O2 -std=c99 -nostdinc -ffreestanding -fno-builtin -fno-math-errno
-ffp-contract=off -fexcess-precision=standard -D_XOPEN_SOURCE=700 -w -S -emit-llvm
-I$WORK/include -I$MUSL/arch/riscv32 -I$MUSL/arch/generic -I$MUSL/src/include -I$MUSL/src/internal -I$MUSL/include"
units=""
for name in $SOURCES; do
    # shellcheck disable=SC2086
    "$CLANG" $FLAGS "$MUSL/src/math/$name.c" -o "$name.ll"
    units="$units $name.ll"
done
# shellcheck disable=SC2086
"$CLANG" $FLAGS "$MUSL/src/fenv/fenv.c" -o fenv.ll
"$CLANG" --target=wasm32-unknown-unknown -O2 -ffreestanding -fno-math-errno -S -emit-llvm instructions.c -o instructions.ll

# shellcheck disable=SC2086
"$BIN/llvm-link" $units fenv.ll instructions.ll -o linked.bc
exports=$(echo $API | tr ' ' ',')
"$BIN/opt" -passes='internalize,globaldce' -strip-debug -internalize-public-api-list="$exports" linked.bc -o kept.bc
"$BIN/llvm-dis" kept.bc -o kept.ll

# Everything it calls is itself or an LLVM intrinsic.
undefined=$(grep -E '^declare' kept.ll | grep -v '@llvm\.' || true)
if [ -n "$undefined" ]; then
    echo "wasm-libm: the module still needs:" >&2
    echo "$undefined" >&2
    exit 1
fi

{
    echo "; musl $MUSL_VERSION's libm for wasm32 ($API), generated by"
    echo "; scripts/wasm-libm with $("$CLANG" --version | head -n 1). Do not edit: rerun the script."
    echo "; musl is MIT licensed; see host/notices/musl-COPYRIGHT.txt."
    grep -v -E '^(; ModuleID|source_filename|!llvm.ident|!llvm.module.flags|!\{i32 [0-9]+, !"|!\{!"clang version)' kept.ll
} > "$OUTPUT"
cp "$MUSL/COPYRIGHT" "$ROOT/host/notices/musl-COPYRIGHT.txt"
echo "wrote $OUTPUT"
