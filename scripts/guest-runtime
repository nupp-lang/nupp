#!/bin/sh
# Regenerates src/nupp/compiler/aot/llvm/lua/runtime-i686.ll: the AOT runtime
# (native/crates/native/c/ks_rt.c) as LLVM IR for the browser guest.
#
#   scripts/guest-runtime
#
# The guest runs LuaJIT on i386 musl inside v86, with no native provider to
# hand a compiled module the runtime's table, so a module built for it links
# the runtime in. It is compiled against musl's headers because the string
# accumulator is LuaJIT's `luaL_Buffer`, whose size is the C library's BUFSIZ,
# and the guest's LuaJIT is a musl build. The IR is committed; nothing about
# this runs when Nupp is built or used.
#
# CLANG names the clang (default: clang); opt and llvm-dis are taken from
# beside it. Its major version must be the pinned LLVM's.
set -eu

MUSL_VERSION=1.2.5
MUSL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUTPUT="$ROOT/src/nupp/compiler/aot/llvm/lua/runtime-i686.ll"
CLANG=${CLANG:-clang}
BIN=$(dirname "$(command -v "$CLANG")")
PINNED=$(sed -n 's/^LLVM_VERSION=//p' "$ROOT/scripts/toolchain.pins" | head -n 1)
FOUND=$("$CLANG" --version | sed -n 's/.*clang version \([0-9][0-9]*\)\..*/\1/p' | head -n 1)
if [ -n "$PINNED" ] && [ "${PINNED%%.*}" != "$FOUND" ]; then
    echo "guest-runtime: $CLANG is clang $FOUND; the backend pins LLVM $PINNED" >&2
    exit 1
fi
RESOURCE=$("$CLANG" -print-resource-dir)

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
cd "$WORK"
curl -sSfL "https://musl.libc.org/releases/musl-$MUSL_VERSION.tar.gz" -o musl.tar.gz
echo "$MUSL_SHA256  musl.tar.gz" | shasum -a 256 -c - >/dev/null
tar xzf musl.tar.gz
MUSL="$WORK/musl-$MUSL_VERSION"
mkdir -p include/bits
sed -f "$MUSL/tools/mkalltypes.sed" "$MUSL/arch/i386/bits/alltypes.h.in" "$MUSL/include/alltypes.h.in" \
    > include/bits/alltypes.h
cp "$MUSL/arch/i386/bits/syscall.h.in" include/bits/syscall.h

# The guest's own code-generation choices: frame pointers and unwind tables,
# which LuaJIT's callback exceptions walk.
"$CLANG" --target=i386-linux-musl -march=pentium4 -O2 -fPIC -std=c11 -ffp-contract=off -fno-fast-math \
    -fno-omit-frame-pointer -funwind-tables -nostdinc \
    -isystem "$WORK/include" -isystem "$MUSL/arch/i386" -isystem "$MUSL/arch/generic" -isystem "$MUSL/include" \
    -isystem "$RESOURCE/include" -I "$ROOT/src/nupp/compiler/aot/include" \
    -S -emit-llvm "$ROOT/native/crates/native/c/ks_rt.c" -o runtime.ll
# The table is the only thing a module refers to, and it stays inside the
# library that links it.
"$BIN/opt" -strip-debug runtime.ll -S -o stripped.ll
sed 's/^@ks_rt_table = /@ks_rt_table = hidden /' stripped.ll > kept.ll

{
    echo "; The AOT runtime (native/crates/native/c/ks_rt.c) for the i686 browser guest,"
    echo "; against musl $MUSL_VERSION's headers, generated by scripts/guest-runtime with"
    echo "; $("$CLANG" --version | head -n 1). Do not edit: rerun the script."
    grep -v -E '^(; ModuleID|source_filename|!llvm.ident|!\{!"clang version)' kept.ll
} > "$OUTPUT"
echo "wrote $OUTPUT"
