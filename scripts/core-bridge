#!/bin/sh
# Build the C startup transport and guard, or an opt-in Win64 fixture.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
sanitize=${NUPP_CORE_BRIDGE_SANITIZE:-0}
test=0
# The runtime emitted as C (scripts/core-c), linked in place of the runtime
# code a bundle carries.
c_runtime=
for argument in "$@"; do
    case "$argument" in
        --sanitize) sanitize=1 ;;
        --test) test=1 ;;
        --c-runtime=*) c_runtime=${argument#--c-runtime=} ;;
        --win64-contracts | --win64-http-link) ;;
        *) printf 'usage: scripts/core-bridge [--sanitize] [--test] [--c-runtime=DIR] | --win64-contracts | --win64-http-link\n' >&2; exit 2 ;;
    esac
done
defaults=
flags="-std=c11 -O2 -g -Wall -Wextra -Werror -pthread"
if [ "$sanitize" = 1 ]; then
    OUT=${NUPP_CORE_BRIDGE_DIR:-"$ROOT/build/c-core-bridge-sanitize"}
    defaults="$ROOT/native/corebridge/sanitize.c"
    flags="$flags -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
else
    OUT=${NUPP_CORE_BRIDGE_DIR:-"$ROOT/build/c-core-bridge"}
fi
die() { printf 'core-bridge: %s\n' "$*" >&2; exit 1; }
platform="$(sh "$ROOT/scripts/host-machine")"

win64_mode=${1:-}
if [ "$win64_mode" = --win64-contracts ] || [ "$win64_mode" = --win64-http-link ]; then
    case "$platform" in
        MINGW*:x86_64|MSYS*:x86_64) ;;
        *) die 'Win64 contracts require a Windows x64 MSVC shell' ;;
    esac
    [ "$#" -eq 1 ] || die "usage: scripts/core-bridge $win64_mode"
    [ -n "${INCLUDE:-}" ] && [ -n "${LIB:-}" ] ||
        die 'Win64 contracts require the x64 Visual Studio developer environment'
    command -v clang > /dev/null || die 'Win64 contracts require clang'
    command -v cl > /dev/null || die 'Win64 contracts require the MSVC SDK compiler'
    # Git Bash places its POSIX link command ahead of Visual Studio.
    if [ -n "${VCToolsInstallDir:-}" ]; then
        msvc_bin="$(cygpath -u "$VCToolsInstallDir")/bin/Hostx64/x64"
        if [ -x "$msvc_bin/link.exe" ]; then
            PATH="$msvc_bin:$PATH"
            export PATH
        fi
    fi
    if [ "$win64_mode" = --win64-http-link ]; then
        . "$ROOT/scripts/core-http-windows-sdk.sh"
        ssl=$(NUPP_NATIVE_TARGET=x86_64-pc-windows-msvc NUPP_CC=cl \
            sh "$ROOT/scripts/native-libraries" openssl)
    fi
    uv=$(NUPP_NATIVE_TARGET=x86_64-pc-windows-msvc NUPP_CC=cl \
        sh "$ROOT/scripts/native-libraries" libuv)
    [ -r "$uv/bin/uv.dll" ] && [ -r "$uv/lib/uv.lib" ] ||
        die 'pinned Win64 libuv SDK lacks uv.dll or uv.lib'
    mkdir -p "$OUT"
    stage=$(mktemp -d "$OUT/${win64_mode#--}.XXXXXX")
    cp -P "$uv/bin/uv.dll" "$stage/"
    cp -RP "$uv/notices" "$stage/"
    root_native=$(cygpath -m "$ROOT")
    uv_native=$(cygpath -m "$uv")
    stage_native=$(cygpath -m "$stage")
    compile_win64() {
        # uv_fs_open and the bridge exchange CRT descriptors. Match the
        # runtime used by uv.dll so both use one descriptor table. Override
        # the clang driver's static CRT default at the linker as well.
        clang --target=x86_64-pc-windows-msvc -std=c11 -O2 -Wall -Wextra -Werror \
            -fms-runtime-lib=dll -Xlinker -NODEFAULTLIB:libcmt \
            -D_CRT_SECURE_NO_WARNINGS -DUSING_UV_SHARED=1 -I"$uv_native/include" "$@" \
            "$uv_native/lib/uv.lib" -lws2_32
    }
    common="$root_native/native/corebridge"
    if [ "$win64_mode" = --win64-http-link ]; then
        for dll in $curl_dlls; do cp -P "$curl/bin/$dll" "$stage/"; done
        for notice in $curl_notices; do cp -P "$curl/notices/$notice" "$stage/notices/"; done
        curl_headers=$(cygpath -m "$curl/include")
        curl_lib=$(cygpath -m "$curl_import")
        ssl_native=$(cygpath -m "$ssl")
        icu_headers=$(cygpath -m "$icu_include")
        icu_lib=$(cygpath -m "$icu_import")
        http="$root_native/native/httpcurl"
        # LINK accepts -DEF, which avoids a slash-prefixed MSYS argument.
        compile_win64 -DNUPP_CORE_HTTP -DNUPP_WIN64_HTTP_SYSTEM_ICU=1 -DNUPP_WIN64_PROCESS -DNUPP_CORE_NET -DNUPP_CORE_TLS \
            -iquote "$common" -I"$curl_headers" -I"$icu_headers" -I"$ssl_native/include" \
            "$common/main.c" "$common/uv.c" "$common/winposix.c" "$http/transport.c" "$http/uriidna.c" \
            "$common/process.c" "$common/winpipe.c" "$common/streamio.c" \
            "$common/netbridge.c" "$common/tcp.c" "$common/udp.c" "$common/tlsbio.c" \
            "$curl_lib" "$icu_lib" "$ssl_native/lib/libssl.lib" "$ssl_native/lib/libcrypto.lib" -lcrypt32 -lbcrypt \
            -Xlinker "-DEF:$common/http-win64.def" \
            -o "$stage_native/nupp-core.exe"
        printf '%s\n' "$stage"
        exit 0
    fi
    tests="$root_native/tests/core"
    compile_win64 "$common/main.c" "$common/uv.c" "$common/winposix.c" -lbcrypt -o "$stage_native/nupp-core.exe"
    compile_win64 "$tests/socketbrokerwin64.c" -o "$stage_native/socket-broker.exe"
    compile_win64 -DNUPP_WIN64_PROCESS -iquote "$common" \
        "$tests/bridgeloaderwin64contract.c" "$common/uv.c" "$common/winposix.c" -lbcrypt \
        "$common/process.c" "$common/winpipe.c" "$common/streamio.c" \
        -o "$stage_native/bridge-loader.exe"
    compile_win64 "$tests/bridgeabiwin64contract.c" "$tests/bridge-abi-win64.S" -o "$stage_native/bridge-abi.exe"
    compile_win64 -DNUPP_WIN64_PROCESS -iquote "$common" \
        "$tests/processwin64contract.c" "$common/process.c" "$common/uv.c" \
        "$common/winpipe.c" "$common/streamio.c" \
        -o "$stage_native/process.exe"
    compile_win64 -iquote "$common" "$tests/tcpcontracts.c" "$common/tcp.c" \
        "$common/streamio.c" \
        -o "$stage_native/tcp.exe"
    compile_win64 -DNUPP_CORE_NET -iquote "$common" \
        "$tests/netbridgecontracts.c" "$common/netbridge.c" "$common/tcp.c" \
        "$common/streamio.c" "$common/udp.c" "$common/uv.c" -o "$stage_native/net.exe"
    for probe in socket-broker bridge-loader bridge-abi process tcp net; do
        "$stage/$probe.exe" >&2
    done
    printf '%s\n' "$stage"
    exit 0
fi

case "$platform" in
    MINGW*:aarch64 | MSYS*:aarch64)
        . "$ROOT/scripts/core-bridge-windows.sh"
        exit 0
        ;;
esac

case "$platform" in
    Darwin:arm64)
        SDKROOT=${SDKROOT:-$(xcrun --sdk macosx --show-sdk-path)}
        case "$SDKROOT" in /*) ;; *) die 'SDKROOT must be an absolute macOS SDK path' ;; esac
        CC=${NUPP_CC:-$(xcrun --sdk macosx --find clang)}
        NUPP_CC=$CC
        MACOSX_DEPLOYMENT_TARGET=11.0
        export SDKROOT NUPP_CC MACOSX_DEPLOYMENT_TARGET
        icu="$SDKROOT/usr/lib/libicucore.tbd"
        [ -r "$SDKROOT/usr/include/unicode/uidna.h" ] && [ -r "$icu" ] ||
            die 'selected SDK lacks the ICU header or link stub'
        curl=$(sh "$ROOT/scripts/native-libraries" libcurl)
        uv_name=libuv.dylib
        shared_suffix=dylib
        rpath='@loader_path/lib'
        export_flag=-Wl,-export_dynamic
        ;;
    Linux:aarch64|Linux:arm64)
        CC=${NUPP_CC:-cc}
        . "$ROOT/scripts/core-http-linux-sdk.sh"
        uv_name=libuv.so
        shared_suffix=so
        rpath='$ORIGIN/lib'
        export_flag=-rdynamic
        ;;
    *) die 'ARM64 macOS, Linux or Windows is required' ;;
esac

# The deployment floor and SDK above select normal pinned cache entries.
uv=$(sh "$ROOT/scripts/native-libraries" libuv)
ssl=$(sh "$ROOT/scripts/native-libraries" openssl)
common="$ROOT/native/corebridge"
http="$ROOT/native/httpcurl"
mkdir -p "$OUT"
stage=$(mktemp -d "$OUT/.sidecars.XXXXXX")
pending=".$$.pending"
trap 'rm -rf "$stage" "$OUT"/*"$pending" "$OUT"/*"$pending".dSYM "$OUT"/lib/*"$pending" "$OUT"/notices/*"$pending"' EXIT
mkdir "$stage/lib" "$stage/notices"
for package in "$uv" "$curl"; do
    cp -RP "$package/lib/." "$stage/lib/"
    cp -RP "$package/notices/." "$stage/notices/"
done

# Refuse higher-minimum or non-ARM64 products before publishing this bundle.
check_floor() {
    [ "$platform" = Darwin:arm64 ] || return 0
    xcrun otool -arch arm64 -l "$1" | awk '
        $1 == "cmd" { cmd = $2 }
        (cmd == "LC_BUILD_VERSION" && $1 == "minos") ||
        (cmd == "LC_VERSION_MIN_MACOSX" && $1 == "version") {
            split($2, v, ".")
            if (v[1] + 0 > 11 || v[1] + 0 == 11 && (v[2] + 0 || v[3] + 0)) bad = 1
            seen = 1
        }
        END { exit (!seen || bad) }
    ' || die "missing ARM64 deployment metadata or minimum exceeds 11.0: $1"
}
[ -f "$stage/lib/$uv_name" ] || die "missing staged $uv_name"
for library in libcurl libssl libcrypto libz; do
    [ -f "$stage/lib/$library.$shared_suffix" ] || die "missing staged $library.$shared_suffix"
done
if [ "$platform" = Darwin:arm64 ]; then
    for library in "$stage"/lib/*.dylib; do check_floor "$library"; done
fi
# No builtin's library is ever staged beside the bridge.
sh "$ROOT/scripts/core-bridge-builtins" "$stage"

compile() {
    if [ "$platform" = Darwin:arm64 ]; then
        set -- -target arm64-apple-macos11.0 -isysroot "$SDKROOT" "$@"
    fi
    "$CC" \
        $flags \
        -DNUPP_CORE_HTTP -DNUPP_CORE_NET -DNUPP_CORE_TLS \
        -I"$common" -I"$uv/include" -I"$curl/include" -I"$ssl/include" "$@"
}
link_bridge() {
    if [ "$platform" != Darwin:arm64 ]; then
        # The bridge's ELF RPATH also covers dependencies of its sidecars.
        set -- "$@" -Wl,--disable-new-dtags -Wl,-rpath-link,"$stage/lib" -ldl
    else
        set -- "$@" -framework Security -framework CoreFoundation
    fi
    compile "$export_flag" -Wl,-rpath,"$rpath" "$@" "$common/process.c" \
        "$common/netbridge.c" "$common/tcp.c" "$common/streamio.c" "$common/udp.c" "$common/tlsbio.c" \
        ${defaults:+"$defaults"} \
        "$http/transport.c" "$stage/uriidna.o" "$stage/lib/libcurl.$shared_suffix" \
        "$icu" "$stage/lib/$uv_name" "$stage/lib/libssl.$shared_suffix" "$stage/lib/libcrypto.$shared_suffix"
}
if [ "$platform" = Darwin:arm64 ]; then
    compile -c "$http/uriidna.c" -o "$stage/uriidna.o"
else
    compile -I"$icu_include" -c "$http/uriidna.c" -o "$stage/uriidna.o"
fi
if [ -n "$c_runtime" ]; then
    # Each module of the emitted runtime and the C beside it (native/corec),
    # compiled at once and optimized across modules when linked. Handlers
    # tail-call each other, so the emitted C is held to no warning policy of
    # its own; the compiler checked the Nupp it came from.
    # Float arithmetic is exactly what the Nupp says: no fused multiply-add,
    # which would change results from s0's and break bit-exact replay.
    corec="$ROOT/native/corec"
    runtime_objects=
    pids=
    for source in "$c_runtime"/*.c "$corec"/*.c "$corec/foreigncall.S"; do
        object="$stage/runtime-$(basename "$source").o"
        runtime_objects="$runtime_objects $object"
        if [ "$platform" = Darwin:arm64 ]; then
            target_flags="-target arm64-apple-macos11.0 -isysroot $SDKROOT"
        else
            target_flags=
        fi
        # shellcheck disable=SC2086
        "$CC" $target_flags -std=c11 -O2 -g -fno-builtin -fwrapv -fno-strict-aliasing -ffp-contract=off -flto=thin -w ${NUPP_CORE_C_FLAGS:-} \
            -I"$c_runtime" -I"$corec" -c "$source" -o "$object" &
        pids="$pids $!"
    done
    for pid in $pids; do
        wait "$pid" || die "the C runtime did not compile"
    done
    # shellcheck disable=SC2086
    link_bridge -flto=thin ${NUPP_CORE_C_FLAGS:-} -DNUPP_CORE_C_RUNTIME "$common/main.c" "$common/uv.c" $runtime_objects \
        -o "$OUT/nupp-core$pending"
else
    link_bridge "$common/main.c" "$common/uv.c" -o "$OUT/nupp-core$pending"
fi
link_bridge "$common/guard.c" "$common/uv.c" "$ROOT/tests/core/bridgeabi.S" \
    -o "$OUT/nupp-core-guard$pending"
check_floor "$OUT/nupp-core$pending"
check_floor "$OUT/nupp-core-guard$pending"
mkdir -p "$OUT/lib" "$OUT/notices"
for file in "$stage"/lib/*.dylib "$stage"/lib/*.so "$stage"/lib/*.so.* "$stage"/notices/*.txt; do
    [ -f "$file" ] || continue
    relative=${file#"$stage"/}
    cp -P "$file" "$OUT/$relative$pending"
    mv -f "$OUT/$relative$pending" "$OUT/$relative"
done
mv "$OUT/nupp-core$pending" "$OUT/nupp-core"
mv "$OUT/nupp-core-guard$pending" "$OUT/nupp-core-guard"
if [ "$test" = 1 ]; then
    link_bridge \
        "$ROOT/tests/core/bridgecontracts.c" "$ROOT/tests/core/uvcontracts.c" \
        "$ROOT/tests/core/processcontracts.c" \
        "$ROOT/tests/core/bridgeabi.S" -o "$OUT/nupp-core-contracts$pending"
    check_floor "$OUT/nupp-core-contracts$pending"
    mv "$OUT/nupp-core-contracts$pending" "$OUT/nupp-core-contracts"
    "$OUT/nupp-core-contracts" >&2
    compile -Wl,-rpath,"$rpath" "$ROOT/tests/core/tcpcontracts.c" "$common/tcp.c" \
        "$common/streamio.c" \
        ${defaults:+"$defaults"} "$stage/lib/$uv_name" -o "$OUT/nupp-tcp-contracts$pending"
    check_floor "$OUT/nupp-tcp-contracts$pending"
    mv "$OUT/nupp-tcp-contracts$pending" "$OUT/nupp-tcp-contracts"
    "$OUT/nupp-tcp-contracts" >&2
    link_bridge "$ROOT/tests/core/netbridgecontracts.c" "$common/uv.c" \
        -o "$OUT/nupp-net-contracts$pending"
    check_floor "$OUT/nupp-net-contracts$pending"
    mv "$OUT/nupp-net-contracts$pending" "$OUT/nupp-net-contracts"
    "$OUT/nupp-net-contracts" >&2
    link_bridge "$ROOT/tests/core/tlsbiocontracts.c" "$common/uv.c" \
        -o "$OUT/nupp-tls-bio-contracts$pending"
    check_floor "$OUT/nupp-tls-bio-contracts$pending"
    mv "$OUT/nupp-tls-bio-contracts$pending" "$OUT/nupp-tls-bio-contracts"
    fixtures="$ROOT/tests/stdlib/io/net/fixtures"
    (unset SSL_CERT_FILE SSL_CERT_DIR
        "$OUT/nupp-tls-bio-contracts" "$fixtures/localhost-cert.pem" "$fixtures/localhost-key.pem") >&2
    (unset SSL_CERT_FILE
        SSL_CERT_DIR="$fixtures" "$OUT/nupp-tls-bio-contracts" \
            "$fixtures/localhost-cert.pem" "$fixtures/localhost-key.pem" configured
        SSL_CERT_DIR="$fixtures/missing" "$OUT/nupp-tls-bio-contracts" \
            "$fixtures/localhost-cert.pem" "$fixtures/localhost-key.pem" missing) >&2
fi
printf '%s\n' "$OUT"
