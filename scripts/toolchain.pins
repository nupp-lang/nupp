# Pinned sources Nupp provisions for itself.
#
# One record per component: the version or revision, the SHA-256 of the exact
# archive, the URL it comes from, and a file the archive is known to contain.
# The digest authenticates the bytes; the URL only says where to look first, and
# a mirror may replace it. Nothing here is committed to the tree, because a
# generated dependency in the tree is one to keep current by hand.
#
# Bumping a pin means bumping its digest and, where the component ships a
# licence Nupp redistributes, refreshing notices beside it. `scripts/toolchain`
# refuses to build a source whose notice has drifted.

# LuaJIT v2.1, at 2.1.1785763465: the interpreter LuaRocks runs on, and the
# headers C rocks build against.
LUAJIT_REV=1edc3e52b67eaf6ce5f809be8e17d6862594b8bc
LUAJIT_SHA256=85497ea149d136afbe2d7ef222e08849248e52cecc6dc8deefd8588e551e4e00
LUAJIT_URL='https://github.com/LuaJIT/LuaJIT/archive/${LUAJIT_REV}.tar.gz'
LUAJIT_MARKER=src/lj_arch.h
LUAJIT_DIRECTORY='LuaJIT-${LUAJIT_REV}'

# The dependency resolver. It is a build tool rather than a runtime library,
# but pinning it keeps documentation and release builds off the host image.
LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=71adfead6966e2912034b8fb8103dd343c3adc6c91a276f1d209eebbaefe3a15
LUAROCKS_URL='https://github.com/luarocks/luarocks/archive/refs/tags/v${LUAROCKS_VERSION}.tar.gz'
LUAROCKS_MARKER=src/luarocks/core/cfg.lua
LUAROCKS_DIRECTORY='luarocks-${LUAROCKS_VERSION}'

# Uncrustify, which scripts/format-c runs after clang-format to place the
# blank lines clang-format cannot (.uncrustify.cfg). Every machine that checks
# C formatting needs this exact release, because another one places them
# differently. Building it needs CMake, a C++ compiler and Python 3, which
# generates part of its source.
UNCRUSTIFY_VERSION=0.83.0
UNCRUSTIFY_SHA256=1d4d3ab3a991c66eb24cb0a3e690573b4882fd98bc6ec64a01c283998c20dc87
UNCRUSTIFY_URL='https://github.com/uncrustify/uncrustify/archive/refs/tags/uncrustify-${UNCRUSTIFY_VERSION}.tar.gz'
UNCRUSTIFY_MARKER=src/uncrustify.cpp
UNCRUSTIFY_DIRECTORY='uncrustify-uncrustify-${UNCRUSTIFY_VERSION}'

# A standalone release image for tools that explicitly request stage0-image.
# Cold compiler builds use the matching runtime/image execution seed pinned in
# scripts/bootstrap-seeds.json (`scripts/vm-cli build`), then run new images on
# that same verified runtime. Building a Rust execution loop from these sources
# is not a bootstrap fallback. Compiler sources may use a language feature only
# after the selected execution seed understands it.
#
# The digest is of the decompressed image, not of the `.gz` the release
# publishes. Two gzips given identical input write different bytes, so pinning
# the compressed form would pin whichever gzip cut the release; the digest of
# the image the runtime actually loads is reproducible from the tag by anyone
# who runs `nupp fixpoint --emit-stage0` there. `scripts/toolchain stage0-image`
# verifies it after decompressing and before installing, and an offline builder
# may supply either spelling.
STAGE0_IMAGE_TAG=v0.0.15-native-api-seed.6
STAGE0_IMAGE_SHA256=ab1b144840350699ef459b9b4db218834ffcec94a0f9d1c9597f335370cfc665
STAGE0_IMAGE_URL='https://github.com/nupp-lang/nupp/releases/download/${STAGE0_IMAGE_TAG}/nupp-stage0-${STAGE0_IMAGE_TAG}.image.gz'

# The flip. A host listed here runs on the native core: its stage zero is the
# core seed below rather than the VM seed and image above, and bin/nupp, the
# build and `nupp fixpoint` run on the core through scripts/core-cli, with no
# fallback to the Rust VM. Hosts not listed keep the VM seed until their
# target's bring-up moves them (`scripts/stage0-runtime` reads this).
#
# A host is listed once three things hold for it: its core seed below is
# published and pinned; core compiler generations are shared across worktrees
# by their sources (scripts/core-cli), so a fresh worktree or a rebase that
# changes no compiler source builds nothing; and `nupp test` and `nupp run`
# work on the core. Until then NUPP_RUNTIME=core opts a command in.
STAGE0_CORE_HOSTS=

# The core seed for each host: the compiler and C bridge pair `nupp fixpoint
# --runtime core --package-seed` packages, as the release that publishes it
# names the archive. The digest is of the archive; `scripts/toolchain
# core-seed` verifies it before unpacking, and the manifest inside it before
# running anything. macOS ARM64's is v0.0.15-core-seed.2, Linux ARM64's
# v0.0.15-core-seed.3 and Windows ARM64's v0.0.15-core-seed.4.
STAGE0_CORE_URL_AARCH64_APPLE_DARWIN=https://github.com/nupp-lang/nupp/releases/download/v0.0.15-core-seed.2/nupp-core-seed-aarch64-apple-darwin-2cf4b2d54da1acdf82233ebfad309a9a99e0504f.tar.gz
STAGE0_CORE_SHA256_AARCH64_APPLE_DARWIN=a6de0caae3ade1b533fa6a0d56cc2c4f34e253276c8b0d6ef5238ce4f27ae2a5
STAGE0_CORE_URL_AARCH64_UNKNOWN_LINUX_GNU=https://github.com/nupp-lang/nupp/releases/download/v0.0.15-core-seed.3/nupp-core-seed-aarch64-unknown-linux-gnu-88b0887624e37fc9234203fe8ecd5431e50be42d.tar.gz
STAGE0_CORE_SHA256_AARCH64_UNKNOWN_LINUX_GNU=f5948521d8c114c88b79def5211323536f35d4ea6769d2dfab8307b71a276a3f
STAGE0_CORE_URL_AARCH64_PC_WINDOWS_GNULLVM=https://github.com/nupp-lang/nupp/releases/download/v0.0.15-core-seed.4/nupp-core-seed-aarch64-pc-windows-gnullvm-18d8fce25851b70452134a66c4164c86eb4f7b56.tar.gz
STAGE0_CORE_SHA256_AARCH64_PC_WINDOWS_GNULLVM=9221663e722836a6c7ad636ff32656f3578d32b2787ee0caaa6346c7f14419d2

