# Pinned sources Nupp provisions for itself.
#
# One record per component: the version or revision, the SHA-256 of the exact
# archive, the URL it comes from, and a file the archive is known to contain.
# The digest authenticates the bytes; the URL only says where to look first, and
# a mirror may replace it. Nothing here is committed to the tree, because a
# generated dependency in the tree is one to keep current by hand.
#
# Bumping a pin means bumping its digest and, where the component ships a
# licence Nupp redistributes, refreshing host/notices beside it. `scripts/toolchain`
# refuses to build a source whose notice has drifted.

# LuaJIT v2.1, at 2.1.1785763465. The floor is 2.1.1784535649, the first build
# carrying the backported operators; anything older rejects generated Nupp at
# parse time. This is why the pin lives here rather than trailing a package
# manager: the interpreter has to be new enough to parse what the compiler emits.
LUAJIT_REV=1edc3e52b67eaf6ce5f809be8e17d6862594b8bc
LUAJIT_SHA256=85497ea149d136afbe2d7ef222e08849248e52cecc6dc8deefd8588e551e4e00
LUAJIT_URL='https://github.com/LuaJIT/LuaJIT/archive/${LUAJIT_REV}.tar.gz'
LUAJIT_MARKER=src/lj_arch.h
LUAJIT_DIRECTORY='LuaJIT-${LUAJIT_REV}'

# The dependency resolver. It is a build tool rather than a runtime library,
# but pinning it keeps documentation and release builds off the host image.
LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=71adfead6966e2912034b8fb8103dd343c3adc6c91a276f1d209eebbaefe3a15
LUAROCKS_URL='https://github.com/luarocks/luarocks/archive/refs/tags/v${LUAROCKS_VERSION}.tar.gz'
LUAROCKS_MARKER=src/luarocks/core/cfg.lua
LUAROCKS_DIRECTORY='luarocks-${LUAROCKS_VERSION}'

LPEG_VERSION=1.1.0
LPEG_SHA256=4b155d67d2246c1ffa7ad7bc466c1ea899bbc40fef0257cc9c03cecbaed4352a
LPEG_URL='https://www.inf.puc-rio.br/~roberto/lpeg/lpeg-${LPEG_VERSION}.tar.gz'
LPEG_MARKER=lptree.c
LPEG_DIRECTORY='lpeg-${LPEG_VERSION}'

# The stage-zero compiler: the previous release's own compiler, lowered to one
# Lua file, which is what compiles this tree's Nupp the first time. It is the
# one pin whose subject is Nupp itself, and it is why the compiler's sources are
# written in the language of the tag below rather than the language of this
# commit -- a feature reaches them only after a release carrying it is tagged
# and this pin moves to it.
#
# The digest is of the decompressed bundle, not of the `.gz` the release
# publishes. Two gzips given identical input write different bytes, so pinning
# the compressed form would pin whichever gzip cut the release; the digest of
# the source the compiler actually loads is reproducible from the tag by anyone
# who rebuilds it. `scripts/toolchain stage0` verifies it after decompressing
# and before installing, and an offline builder may supply either spelling.
STAGE0_TAG=v0.0.9
STAGE0_SHA256=15ed8a0432bd4c2df5840c7c8959c54ef4310611f29cae30da57a5f5621ac53b
STAGE0_URL='https://github.com/nupp-lang/nupp/releases/download/${STAGE0_TAG}/nupp-stage0-${STAGE0_TAG}.lua.gz'

# Opt-in browser guest inputs. These do not change the native toolchain key.
# The guest image is built from these sources; no unpublished image is pinned.
BROWSER_LINUX_VERSION=6.12.110
BROWSER_LINUX_SHA256=8cee19e1839bb6ff4d5254d761933ae6ab670492d5ed030e09a80538320d5c4c
BROWSER_LINUX_URL='https://www.kernel.org/pub/linux/kernel/v6.x/linux-${BROWSER_LINUX_VERSION}.tar.xz'
BROWSER_LINUX_ARCHIVE='linux-${BROWSER_LINUX_VERSION}.tar.xz'
BROWSER_LINUX_DIRECTORY='linux-${BROWSER_LINUX_VERSION}'
BROWSER_LINUX_MARKER=Makefile
BROWSER_MUSL_VERSION=1.2.6
BROWSER_MUSL_SHA256=d585fd3b613c66151fc3249e8ed44f77020cb5e6c1e635a616d3f9f82460512a
BROWSER_MUSL_URL='https://musl.libc.org/releases/musl-${BROWSER_MUSL_VERSION}.tar.gz'
BROWSER_MUSL_ARCHIVE='musl-${BROWSER_MUSL_VERSION}.tar.gz'
BROWSER_MUSL_DIRECTORY='musl-${BROWSER_MUSL_VERSION}'
BROWSER_MUSL_MARKER=configure
BROWSER_LIBUNWIND_VERSION=20.1.8
BROWSER_LIBUNWIND_SHA256=0bced9d701e300f8fe6599523367e214c1f928ac559afceece58f47018e9c4a7
BROWSER_LIBUNWIND_URL='https://github.com/llvm/llvm-project/releases/download/llvmorg-${BROWSER_LIBUNWIND_VERSION}/libunwind-${BROWSER_LIBUNWIND_VERSION}.src.tar.xz'
BROWSER_LIBUNWIND_ARCHIVE='libunwind-${BROWSER_LIBUNWIND_VERSION}.src.tar.xz'
BROWSER_LIBUNWIND_DIRECTORY='libunwind-${BROWSER_LIBUNWIND_VERSION}.src'
BROWSER_LIBUNWIND_MARKER=src/libunwind.cpp
BROWSER_SEABIOS_VERSION=1.16.2
BROWSER_SEABIOS_SHA256=fcb12b790971dd9918b1c631b34677f996bd283f0f8ee5c57aa98ab90645f5c0
BROWSER_SEABIOS_URL='https://github.com/qemu/seabios/archive/refs/tags/rel-${BROWSER_SEABIOS_VERSION}.tar.gz'
BROWSER_SEABIOS_ARCHIVE='seabios-${BROWSER_SEABIOS_VERSION}.tar.gz'
BROWSER_SEABIOS_DIRECTORY='seabios-rel-${BROWSER_SEABIOS_VERSION}'
BROWSER_SEABIOS_MARKER=src/post.c
BROWSER_V86_VERSION=0.5.461
BROWSER_V86_REV=589487c7758a2775f606ec631bd78609497f6e05
BROWSER_V86_SHA256=1e180db36a808c2e1c0056efe419f5b5530dd17328c26a9981fd00cd9f8f4328
BROWSER_V86_URL='https://registry.npmjs.org/v86/-/v86-${BROWSER_V86_VERSION}.tgz'
BROWSER_V86_ARCHIVE='v86-${BROWSER_V86_VERSION}.tgz'
BROWSER_V86_DIRECTORY=package
BROWSER_V86_MARKER=build/libv86.mjs
