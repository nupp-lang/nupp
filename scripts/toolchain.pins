# Pinned sources Nupp provisions for itself.
#
# One record per component: the version or revision, the SHA-256 of the exact
# archive, the URL it comes from, and a file the archive is known to contain.
# The digest authenticates the bytes; the URL only says where to look first, and
# a mirror may replace it. Nothing here is committed to the tree, because a
# generated dependency in the tree is one to keep current by hand.
#
# Bumping a pin means bumping its digest and, where the component ships a
# licence Nupp redistributes, refreshing host/notices beside it. `scripts/toolchain`
# refuses to build a source whose notice has drifted.

# LuaJIT v2.1, at 2.1.1785763465. The floor is 2.1.1784535649, the first build
# carrying the backported operators; anything older rejects generated Nupp at
# parse time. This is why the pin lives here rather than trailing a package
# manager: the interpreter has to be new enough to parse what the compiler emits.
LUAJIT_REV=1edc3e52b67eaf6ce5f809be8e17d6862594b8bc
LUAJIT_SHA256=85497ea149d136afbe2d7ef222e08849248e52cecc6dc8deefd8588e551e4e00
LUAJIT_URL='https://github.com/LuaJIT/LuaJIT/archive/${LUAJIT_REV}.tar.gz'
LUAJIT_MARKER=src/lj_arch.h
LUAJIT_DIRECTORY='LuaJIT-${LUAJIT_REV}'

# The dependency resolver. It is a build tool rather than a runtime library,
# but pinning it keeps documentation and release builds off the host image.
LUAROCKS_VERSION=3.13.0
LUAROCKS_SHA256=71adfead6966e2912034b8fb8103dd343c3adc6c91a276f1d209eebbaefe3a15
LUAROCKS_URL='https://github.com/luarocks/luarocks/archive/refs/tags/v${LUAROCKS_VERSION}.tar.gz'
LUAROCKS_MARKER=src/luarocks/core/cfg.lua
LUAROCKS_DIRECTORY='luarocks-${LUAROCKS_VERSION}'

LPEG_VERSION=1.1.0
LPEG_SHA256=4b155d67d2246c1ffa7ad7bc466c1ea899bbc40fef0257cc9c03cecbaed4352a
LPEG_URL='https://www.inf.puc-rio.br/~roberto/lpeg/lpeg-${LPEG_VERSION}.tar.gz'
LPEG_MARKER=lptree.c
LPEG_DIRECTORY='lpeg-${LPEG_VERSION}'

# Lunamark's entity table needs a utf8.char that Lua 5.1 does not have.
LUAUTF8_VERSION=0.2.1
LUAUTF8_SHA256=ea52075cd960aed8c37512ab31cdc166aa77a6458504d29f33ae40b93d2d8594
LUAUTF8_URL='https://github.com/starwing/luautf8/archive/refs/tags/${LUAUTF8_VERSION}.tar.gz'
LUAUTF8_MARKER=lutf8lib.c
LUAUTF8_DIRECTORY='luautf8-${LUAUTF8_VERSION}'

# The long-term-support line, and the release tarball rather than the GitHub
# archive: only the release carries the framework the build reads.
MBEDTLS_VERSION=3.6.2
MBEDTLS_SHA256=8b54fb9bcf4d5a7078028e0520acddefb7900b3e66fec7f7175bb5b7d85ccdca
MBEDTLS_URL='https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-${MBEDTLS_VERSION}/mbedtls-${MBEDTLS_VERSION}.tar.bz2'
MBEDTLS_SUFFIX=.tar.bz2
MBEDTLS_MARKER=Makefile
MBEDTLS_DIRECTORY='mbedtls-${MBEDTLS_VERSION}'

# The remaining C network provider's sockets and event loop on Linux, macOS and
# Windows. Node.js runs on it, which is the reason to trust its Windows half
# more than a platform layer written here and rarely run.
#
# Built from a source list rather than through its own build system: libuv needs
# autoconf or CMake, and it has no generated configuration header, so naming the
# files it compiles on each platform is cheaper than asking for either.
LIBUV_VERSION=1.52.1
LIBUV_SHA256=478baf2599bfbc882c355288c9cb6f92e0e7dda435fa04031fa5b607cf3f414c
LIBUV_URL='https://github.com/libuv/libuv/archive/refs/tags/v${LIBUV_VERSION}.tar.gz'
LIBUV_MARKER=include/uv.h
LIBUV_DIRECTORY='libuv-${LIBUV_VERSION}'

# The headless GPU conformance device. CI builds this exact Vulkan ICD rather
# than accepting whichever physical adapter a hosted runner happens to expose.
SWIFTSHADER_REV=694585a05946e1ed49b6bd577ca6537cbb57f025
SWIFTSHADER_SHA256=96d0072058c4d9535ded472e4f12ce79976287d4ee9dce2915566ec4648e560e
SWIFTSHADER_URL='https://github.com/google/swiftshader/archive/${SWIFTSHADER_REV}.tar.gz'
SWIFTSHADER_MARKER=CMakeLists.txt
SWIFTSHADER_DIRECTORY='swiftshader-${SWIFTSHADER_REV}'
