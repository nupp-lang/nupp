#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    echo "usage: scripts/browser-app PROJECT [TARGET [OUTPUT_DIR]]" >&2
    exit 2
fi

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
project=$1
target=${2:-app}
output=${3:-$project/dist/browser}
runtime=${NUPP_BROWSER_RUNTIME:-$root/build/wasm-app-runtime}
lua_source=${NUPP_LUA51_SOURCE:-/tmp/nupp-portable-compiler/lua-5.1.5/src}

exec node "$root/runtime/wasm/package-browser-app.mjs" \
    --project "$project" \
    --target "$target" \
    --output "$output" \
    --runtime "$runtime" \
    --lua-source "$lua_source"
