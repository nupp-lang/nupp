#!/bin/sh
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 3 ]; then
    echo "usage: scripts/browser-app PROJECT [TARGET [OUTPUT_DIR]]" >&2
    exit 2
fi

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
project=$1
target=${2:-app}
output=${3:-$project/dist/browser}
backend=${NUPP_BROWSER_BACKEND:-luajit}
case "$backend" in
    luajit)
        exec node "$root/runtime/luajit/package-browser-app.mjs" \
            --project "$project" --target "$target" --output "$output"
        ;;
    lua51)
        runtime=${NUPP_BROWSER_RUNTIME:-$root/build/wasm-app-runtime}
        temporary=${RUNNER_TEMP:-/tmp}
        lua_source=${NUPP_LUA51_SOURCE:-$temporary/nupp-portable-compiler/lua-5.1.5/src}
        exec node "$root/runtime/wasm/package-browser-app.mjs" \
            --project "$project" --target "$target" --output "$output" \
            --runtime "$runtime" --lua-source "$lua_source"
        ;;
    *) echo "browser package: NUPP_BROWSER_BACKEND must be luajit or lua51" >&2; exit 2 ;;
esac
