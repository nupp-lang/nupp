#!/bin/sh
# The launcher bin/nupp hands every command to on a host the pins flip to the
# native core (`scripts/stage0-runtime`), or anywhere under NUPP_RUNTIME=core:
# the compiler runs on the core through the C bridge, never on the Rust VM.
#
#   scripts/core-cli run ARGUMENT...           run the installed core compiler
#   scripts/core-cli build                     rebuild it from these sources
#   scripts/core-cli install RUNTIME COMPILER  install a pair and select it
#   scripts/core-cli current                   exit 0 when it is current
#   scripts/core-cli select                    select a stored generation built
#                                              from these sources, if any
#
# The installed compiler is `.nupp/core-cli/current`, which names a generation
# directory by its digest: the bridge (`runtime`), the compiler
# (`compiler.bundle`), the libraries it loads relative to itself (`lib`),
# `format`, and what it was built from -- the digest of its sources (`source`)
# and the compiler that built it (`builder`). Both are in the digest beside the
# files themselves, so one compiler's work is never taken for another's.
#
# A checkout with none builds one from these sources. On a flipped host the
# pinned core seed builds it (`scripts/toolchain stage0-seed`). An installed
# generation is kept as the builder on hosts with a pinned core seed,
# including under NUPP_RUNTIME=core before the flip, so edits keep the same
# compiler's piece store. The VM bootstraps an opt-in checkout and supplies
# rebuilds on hosts without a pinned core seed.
# Either way the build goes through scripts/core-self-build or that command.
# A rebuild that fails leaves the previous generation selected and says so;
# with no generation at all, the command fails.
#
# Every generation built from recorded sources is also kept in a store all the
# repository's worktrees share (STORE), by the digest of the sources it was
# built from. A checkout with no generation, or whose sources changed, first
# takes one from there that was built from the sources as they are now: a
# fresh worktree, or a rebase that changed no compiler source, builds nothing.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
CLI="$ROOT/.nupp/core-cli"
FORMAT=nupp-core-cli-1
LOCK="$CLI/build.lock"
# What a core compiler is built from, beside the compiler that builds it.
SOURCES='src templates native/corebridge nupp.lua scripts/core-self-build scripts/core-bridge
scripts/core-http-linux-sdk.sh scripts/native-libraries native/httpcurl
scripts/c-libraries/libuv.sh scripts/c-libraries/libcurl.sh scripts/c-libraries/openssl.sh
scripts/c-libraries/libcurl-early-response.patch scripts/c-libraries/zlib.sh scripts/toolchain.pins notices/libuv-LICENSE.txt
notices/libuv-LICENSE-extra.txt notices/libcurl-LICENSE.txt
notices/OpenSSL-LICENSE.txt notices/zlib-LICENSE.txt'
# What decides how a module lowers, the compiler's lowering of the image's own
# modules included: a builder whose sources differ here lowers the image
# differently from the compiler it builds.
LOWERING='src/nupp/compiler src/nupp/core'
# The shared store: beside the repository's other machine caches, or where
# NUPP_CORE_CLI_STORE names. `GENERATION/` is a generation as a checkout keeps
# it, and `sources/DIGEST` names the one built from the sources DIGEST names.
# It keeps the STORE_KEEP generations published last.
if [ -n "${NUPP_CORE_CLI_STORE:-}" ]; then
    STORE=$NUPP_CORE_CLI_STORE
else
    COMMON=$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    if [ -n "$COMMON" ]; then STORE="$(dirname "$COMMON")/.nupp-cache/core-cli"; else STORE="$CLI/store"; fi
fi
STORE_KEEP=8

note() { printf 'nupp: %s\n' "$*" >&2; }
die() {
    note "$*"
    exit 1
}

if command -v shasum >/dev/null 2>&1; then
    digest_stdin() { shasum -a 256 | cut -d' ' -f1; }
    digest_files() { xargs -0 shasum -a 256; }
else
    digest_stdin() { sha256sum | cut -d' ' -f1; }
    digest_files() { xargs -0 sha256sum; }
fi

# Whether this host runs on the core because the pins say so, rather than
# because NUPP_RUNTIME asked for it.
flipped() {
    [ "$(sh "$ROOT/scripts/stage0-runtime")" = core ]
}

# The digest of the sources a core compiler is built from, as they are now:
# every file git tracks or would track under SOURCES, by name and content.
# Nothing outside a git checkout, which then is never current by content.
source_fingerprint() {
    git -C "$ROOT" rev-parse --git-dir > /dev/null 2>&1 || return 0
    # A tracked file deleted in the work tree is named with no digest.
    # shellcheck disable=SC2086 # the sources are a list of paths
    (cd "$ROOT" && git ls-files --cached --others --exclude-standard -- $SOURCES | LC_ALL=C sort -u \
        | tr '\n' '\0' | digest_files 2>&1) | digest_stdin
}

# The digest of the sources under LOWERING as they are now, as
# source_fingerprint digests SOURCES.
lowering_fingerprint() {
    git -C "$ROOT" rev-parse --git-dir > /dev/null 2>&1 || return 0
    # shellcheck disable=SC2086 # the sources are a list of paths
    (cd "$ROOT" && git ls-files --cached --others --exclude-standard -- $LOWERING | LC_ALL=C sort -u \
        | tr '\n' '\0' | digest_files 2>&1) | digest_stdin
}

# The generation `current` selects; fails when there is none.
selected() {
    [ -f "$CLI/current" ] || return 1
    generation=$(cat "$CLI/current")
    case "$generation" in "" | *[!0-9a-f]*) die "invalid core compiler selection in $CLI/current" ;; esac
    [ "${#generation}" -eq 64 ] || die "invalid core compiler selection in $CLI/current"
    [ "$(cat "$CLI/$generation/format" 2>/dev/null)" = "$FORMAT" ] \
        || die "incomplete core compiler generation $CLI/$generation"
    printf '%s\n' "$CLI/$generation"
}

# Installs RUNTIME and COMPILER as a generation and selects it, with the
# libraries the compiler loads relative to itself (`lib` beside it). SOURCE and
# BUILDER say what it was built from; a pair installed by hand says neither.
install_pair() {
    runtime=$1 compiler=$2 source=${3:-} builder=${4:-} lowering=${5:-}
    libraries=$(dirname "$compiler")/lib
    runtime_dir=$(dirname "$runtime")
    # A Windows bridge is an .exe whose DLLs sit beside it; it is installed
    # as runtime.exe, which `runtime` names to the shell and to CreateProcess.
    suffix=
    # MSYS's test finds runtime.exe as runtime, so look for the .exe first.
    if [ -f "$runtime.exe" ]; then
        runtime=$runtime.exe
    fi
    case "$runtime" in *.exe) suffix=.exe ;; esac
    "$runtime" 2>&1 | grep -q '^nupp-core: usage: nupp-core BUNDLE INPUT OUTPUT' \
        || die "$runtime is not the core's C bridge"
    [ "$(head -c 8 "$compiler")" = NUPPCORE ] || die "$compiler is not a core compiler"
    mkdir -p "$CLI"
    key=$({
        digest_stdin < "$runtime"
        digest_stdin < "$compiler"
        if [ -d "$libraries" ]; then
            for library in "$libraries"/*; do
                [ -f "$library" ] && digest_stdin < "$library"
            done
        fi
        for file in "$runtime_dir"/lib/*.dylib "$runtime_dir"/lib/*.so "$runtime_dir"/lib/*.so.* "$runtime_dir"/*.dll "$runtime_dir"/notices/*.txt; do
            if [ -f "$file" ]; then
                printf 'sidecar %s\n' "${file#"$runtime_dir"/}"
                digest_stdin < "$file"
            fi
        done
        printf 'source %s\nbuilder %s\n' "$source" "$builder"
    } | digest_stdin)
    destination="$CLI/$key"
    if [ ! -d "$destination" ]; then
        staged="$CLI/.install.$$"
        rm -rf "$staged"
        mkdir -p "$staged"
        cp "$runtime" "$staged/runtime$suffix"
        chmod 755 "$staged/runtime$suffix"
        cp "$compiler" "$staged/compiler.bundle"
        [ ! -d "$libraries" ] || cp -RP "$libraries" "$staged/lib"
        for file in "$runtime_dir"/lib/*.dylib "$runtime_dir"/lib/*.so "$runtime_dir"/lib/*.so.* "$runtime_dir"/*.dll "$runtime_dir"/notices/*.txt; do
            [ -f "$file" ] || continue
            relative=${file#"$runtime_dir"/}
            case "$relative" in */*) mkdir -p "$staged/${relative%/*}" ;; esac
            cp -P "$file" "$staged/$relative"
        done
        "$staged/runtime" 2>&1 | grep -q '^nupp-core: usage: nupp-core BUNDLE INPUT OUTPUT' \
            || die "$runtime could not load from its installed location"
        printf '%s\n' "$source" > "$staged/source"
        printf '%s\n' "$builder" > "$staged/builder"
        printf '%s\n' "$lowering" > "$staged/lowering"
        printf '%s\n' "$FORMAT" > "$staged/format"
        mv "$staged" "$destination" 2>/dev/null || rm -rf "$staged"
    fi
    printf '%s\n' "$key" > "$CLI/current.$$"
    mv -f "$CLI/current.$$" "$CLI/current"
    printf '%s\n' "$destination"
}

# A directory's timestamp changes when an input is removed. When an input
# root itself is missing, look at its nearest existing parent instead.
sources_newer_than() (
    cd "$ROOT"
    for source_path in $SOURCES; do
        if [ ! -e "$source_path" ]; then
            parent=$source_path
            while [ ! -d "$parent" ]; do
                case "$parent" in
                    */*) parent=${parent%/*} ;;
                    *) parent=. ;;
                esac
            done
            [ "$parent" -nt "$1" ] && return 0
        fi
    done
    # shellcheck disable=SC2086 # the sources are a list of paths
    [ -n "$(find $SOURCES \( -type f -o -type d \) ! -name '.DS_Store' -newer "$1" 2>/dev/null | head -n 1)" ]
)

# Whether the selected generation `$1` was built from the sources as they are
# now. Asked once the times say stale: a fresh worktree seeded with a
# generation has every file newer than its stamp. A match moves the stamp to
# the moment before the sources were read, so the next command does not ask.
content_current() {
    recorded=$(cat "$1/source" 2>/dev/null) || return 1
    [ -n "$recorded" ] || return 1
    : > "$CLI/.stamp.$$"
    if [ "$(source_fingerprint)" = "$recorded" ]; then
        mv -f "$CLI/.stamp.$$" "$CLI/stamp"
        return 0
    fi
    rm -f "$CLI/.stamp.$$"
    return 1
}

# Whether the selected generation `$1` is current: by time when nothing is
# newer than its stamp, and otherwise by content. A pair installed by hand,
# with no stamp and no record of its sources, says nothing to compare, and is
# run as it is.
generation_current() {
    if [ -f "$CLI/stamp" ] && ! sources_newer_than "$CLI/stamp"; then
        return 0
    fi
    if [ ! -f "$CLI/stamp" ] && [ -z "$(cat "$1/source" 2>/dev/null)" ]; then
        return 0
    fi
    content_current "$1"
}

# A rebuild of these very sources already failed: `failed` carries the time
# that rebuild started, so an edit made while it ran is newer.
failed_unchanged() {
    [ -f "$CLI/failed" ] && ! sources_newer_than "$CLI/failed"
}

# Installs what a build wrote to `$1` from the sources `$2` by the compiler
# `$3`: its own runtime when it emits one, and otherwise the bridge built from
# these sources.
install_built() {
    built="$1/runtime"
    if [ ! -f "$built" ]; then
        bridge=$(sh "$ROOT/scripts/core-bridge") || die "the core's C bridge did not build"
        built="$(printf '%s\n' "$bridge" | tail -n 1)/nupp-core"
    fi
    previous=$(cat "$CLI/current" 2>/dev/null || true)
    install_pair "$built" "$1/compiler.bundle" "$2" "$3" "${4:-}" > /dev/null
    prune "$(cat "$CLI/current")" "$previous"
    publish
}

# A copy of the generation directory `$1` at `$2`: a clone where the file
# system can make one, which costs no space.
copy_generation() {
    rm -rf "$2.$$"
    if [ "$(uname)" = Darwin ]; then
        cp -cRp "$1" "$2.$$" 2>/dev/null || { rm -rf "$2.$$"; cp -Rp "$1" "$2.$$"; }
    else
        cp -Rp --reflink=auto "$1" "$2.$$" 2>/dev/null || { rm -rf "$2.$$"; cp -Rp "$1" "$2.$$"; }
    fi
    mv "$2.$$" "$2" 2>/dev/null || rm -rf "$2.$$"
}

# Keeps the selected generation in the store, under the sources it was built
# from, when it records them; and the store to its last STORE_KEEP.
publish() {
    key=$(cat "$CLI/current")
    recorded=$(cat "$CLI/$key/source" 2>/dev/null || true)
    [ -n "$recorded" ] || return 0
    mkdir -p "$STORE/sources"
    [ -d "$STORE/$key" ] || copy_generation "$CLI/$key" "$STORE/$key"
    [ -d "$STORE/$key" ] || return 0
    printf '%s\n' "$key" > "$STORE/sources/$recorded.$$"
    mv -f "$STORE/sources/$recorded.$$" "$STORE/sources/$recorded"
    touch "$STORE/$key"
    # shellcheck disable=SC2012 # the names are digests
    ls -td "$STORE"/* 2>/dev/null | while IFS= read -r directory; do
        name=$(basename "$directory")
        case "$name" in *[!0-9a-f]*) continue ;; esac
        [ "${#name}" -eq 64 ] && printf '%s\n' "$directory"
    done | tail -n +$((STORE_KEEP + 1)) | while IFS= read -r directory; do
        rm -rf "$directory"
    done
}

# Selects the stored generation built from the sources as they are now, with
# no build; fails when the store has none.
reuse() {
    mkdir -p "$CLI"
    : > "$CLI/.stamp.$$"
    fingerprint=$(source_fingerprint)
    key=$(cat "$STORE/sources/$fingerprint" 2>/dev/null) || key=
    case "$key" in "" | *[!0-9a-f]*) rm -f "$CLI/.stamp.$$"; return 1 ;; esac
    if [ "$(cat "$STORE/$key/format" 2>/dev/null)" != "$FORMAT" ] \
        || [ "$(cat "$STORE/$key/source" 2>/dev/null)" != "$fingerprint" ]; then
        rm -f "$CLI/.stamp.$$"
        return 1
    fi
    [ -d "$CLI/$key" ] || copy_generation "$STORE/$key" "$CLI/$key"
    previous=$(cat "$CLI/current" 2>/dev/null || true)
    printf '%s\n' "$key" > "$CLI/current.$$"
    mv -f "$CLI/current.$$" "$CLI/current"
    mv -f "$CLI/.stamp.$$" "$CLI/stamp"
    rm -f "$CLI/failed"
    touch "$STORE/$key"
    prune "$key" "$previous"
}

# Removes every generation but `$1` and `$2`, with the chunks each kept: the
# one selected now, and the one a command started before it may still be
# running on.
prune() {
    kept_builder=
    if [ -r "$CLI/builder" ]; then
        read -r ignored_pin kept_builder < "$CLI/builder" || kept_builder=
    fi
    for directory in "$CLI"/* "$CLI"/chunks/*; do
        name=$(basename "$directory")
        case "$name" in *[!0-9a-f]*) continue ;; esac
        [ "${#name}" -eq 64 ] && [ "$name" != "$1" ] && [ "$name" != "$2" ] && [ "$name" != "$kept_builder" ] || continue
        rm -rf "$directory"
    done
}

# Builds these sources with the core compiler RUNTIME COMPILER and installs
# what it built. `stamp` keeps the time the build started, so an edit made
# while it ran is newer; a failed build leaves that time in `failed` instead.
build_with() {
    runtime=$1 compiler=$2
    mkdir -p "$CLI"
    output="$CLI/.build.$$"
    rm -rf "$output"
    : > "$CLI/.started.$$"
    source=$(source_fingerprint)
    lowering=$(lowering_fingerprint)
    builder="core $(cat "$runtime" "$compiler" | digest_stdin)"
    if ! sh "$ROOT/scripts/core-self-build" core "$runtime" "$compiler" "$output" > "$CLI/build.log" 2>&1; then
        mv -f "$CLI/.started.$$" "$CLI/failed"
        rm -rf "$output"
        return 1
    fi
    install_built "$output" "$source" "$builder" "$lowering"
    mv -f "$CLI/.started.$$" "$CLI/stamp"
    rm -f "$CLI/failed"
    rm -rf "$output"
}

# The VM compiler bin/nupp runs before the pin, by what names it: the image
# NUPP_VM_CLI_IMAGE selects, or the generation `.nupp/vm-cli` installs.
vm_builder() {
    if [ -n "${NUPP_VM_CLI_IMAGE:-}" ] && [ -f "$NUPP_VM_CLI_IMAGE" ]; then
        printf 'vm-image %s\n' "$(digest_stdin < "$NUPP_VM_CLI_IMAGE")"
    else
        printf 'vm %s\n' "$(cat "$ROOT/.nupp/vm-cli/current" 2>/dev/null)"
    fi
}

# Builds these sources with the VM compiler bin/nupp runs, which brings itself
# current first, and installs what it built, as build_with does.
build_with_vm() {
    mkdir -p "$CLI"
    output="$CLI/.build.$$"
    rm -rf "$output"
    : > "$CLI/.started.$$"
    source=$(source_fingerprint)
    if ! NUPP_RUNTIME=vm sh "$ROOT/bin/nupp" __core-compiler "$output" > "$CLI/build.log" 2>&1; then
        mv -f "$CLI/.started.$$" "$CLI/failed"
        rm -rf "$output"
        return 1
    fi
    install_built "$output" "$source" "$(vm_builder)"
    mv -f "$CLI/.started.$$" "$CLI/stamp"
    rm -f "$CLI/failed"
    rm -rf "$output"
}

# Name the host's pinned seed by its digest, without fetching it on an edit.
seed_pin() {
    host_key=$(sh "$ROOT/scripts/stage0-runtime" --host | tr '[:lower:]-' '[:upper:]_')
    pinned=$(sed -n "s/^STAGE0_CORE_SHA256_${host_key}=//p" "$ROOT/scripts/toolchain.pins" 2>/dev/null)
    [ -n "$pinned" ] || return 1
    printf '%s\n' "$pinned" | digest_stdin
}

remember_builder() {
    printf '%s %s\n' "$1" "${2##*/}" > "$CLI/.builder.$$"
    mv -f "$CLI/.builder.$$" "$CLI/builder"
}

# Whether a build lowers the modules bundled into the image with the compiler
# it builds: NUPP_CORE_SECOND_STAGE=1 asks for it, =0 refuses it, and CI,
# where the image's correctness matters more than the build's time, has it.
second_stage() {
    case "${NUPP_CORE_SECOND_STAGE:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    [ -n "${CI:-}" ] && [ "$CI" != false ] && [ "$CI" != 0 ]
}

# Builds with the builder ANCHOR, which pin PIN keeps. The builder lowers all
# the image carries, and so the modules bundled into it that programs run
# (`simd` among them) are lowered as the builder lowers. Where the sources
# under LOWERING changed since it was built, a second stage (second_stage)
# makes the generation it built the builder and builds once more, which costs
# a full build; edits that change no lowering source then reuse that
# builder's pieces. Without one, the build says its bundled modules may be
# stale. The compiler's own code is correct either way.
anchored_build() {
    anchor=$1 pin=$2
    build_with "$anchor/runtime" "$anchor/compiler.bundle" || return 1
    [ "$(cat "$anchor/lowering" 2>/dev/null)" != "$(lowering_fingerprint)" ] || return 0
    if ! second_stage; then
        note "modules bundled into this core compiler were lowered by an older builder;" \
            "NUPP_CORE_SECOND_STAGE=1 sh scripts/core-cli build lowers them with this one"
        return 0
    fi
    stage=$(selected)
    remember_builder "$pin" "$stage"
    note "the compiler's lowering changed since its builder was built; building it again with itself"
    build_with "$stage/runtime" "$stage/compiler.bundle"
}

# Keep an immutable builder so the code that owns a piece key stays the same
# over multiple edits. A new seed pin bootstraps a new builder on its first edit,
# and a lowering change a new one (anchored_build).
rebuild() {
    if ! anchor_pin=$(seed_pin); then
        if flipped; then
            note "the host's core seed digest is unavailable"
            return 1
        fi
        build_with_vm
        return
    fi
    anchor_generation=
    previous_pin=
    if [ -r "$CLI/builder" ]; then
        read -r previous_pin anchor_generation < "$CLI/builder" || anchor_generation=
    fi
    if [ -n "$previous_pin" ] && [ "$previous_pin" != "$anchor_pin" ]; then
        anchor_seed=$(sh "$ROOT/scripts/toolchain" core-seed) || return 1
        build_with "$anchor_seed/runtime" "$anchor_seed/compiler.bundle" || return 1
        remember_builder "$anchor_pin" "$(selected)"
        anchored_build "$(selected)" "$anchor_pin"
        return
    fi
    case "$anchor_generation" in "" | *[!0-9a-f]*) anchor_generation= ;; esac
    anchor_package="$CLI/$anchor_generation"
    if [ "${#anchor_generation}" -ne 64 ] \
        || [ "$(cat "$anchor_package/format" 2>/dev/null)" != "$FORMAT" ] \
        || [ ! -x "$anchor_package/runtime" ] || [ ! -f "$anchor_package/compiler.bundle" ]; then
        anchor_package=$1
        remember_builder "$anchor_pin" "$anchor_package"
    fi
    anchored_build "$anchor_package" "$anchor_pin"
}

# One build at a time per checkout, under a lock directory its builder claims
# (`scripts/lock-owner`); a command that finds it held waits for it.
lock() {
    mkdir -p "$CLI"
    until mkdir "$LOCK" 2>/dev/null; do
        if ! sh "$ROOT/scripts/lock-owner" holder "$LOCK" > /dev/null; then
            rm -rf "$LOCK"
            continue
        fi
        sleep 1
    done
    sh "$ROOT/scripts/lock-owner" claim "$LOCK" "$$"
    trap 'rm -rf "$LOCK"' EXIT
    trap 'rm -rf "$LOCK"; exit 130' INT
    trap 'rm -rf "$LOCK"; exit 143' TERM
}

unlock() {
    rm -rf "$LOCK"
    trap - EXIT INT TERM
}

# Builds the first generation: from the pinned core seed on a flipped host,
# and from the VM compiler before the pin.
bootstrap() {
    if flipped; then
        note "no core compiler in this checkout; building one from the pinned core seed"
        seed=$(sh "$ROOT/scripts/toolchain" stage0-seed) || die "the pinned core seed is unavailable"
        if ! build_with "$seed/runtime" "$seed/compiler.bundle"; then
            tail -n 20 "$CLI/build.log" | sed 's/^/  /' >&2
            die "the core compiler did not build from the pinned seed (see $CLI/build.log)"
        fi
    else
        note "no core compiler in this checkout; building one with the VM compiler"
        if ! build_with_vm; then
            tail -n 20 "$CLI/build.log" | sed 's/^/  /' >&2
            die "the core compiler did not build with the VM compiler (see $CLI/build.log)"
        fi
    fi
}

# The generation to run, built first when there is none and rebuilt when the
# sources changed since it was.
current() {
    package=$(selected) || package=
    if [ -z "$package" ]; then
        lock
        package=$(selected) || package=
        if [ -z "$package" ]; then
            reuse || bootstrap
            package=$(selected)
        fi
        unlock
    elif [ "${1:-}" = rebuild ] && ! generation_current "$package" && ! failed_unchanged; then
        lock
        # The build this command waited for may have been of these same sources.
        package=$(selected)
        if ! generation_current "$package" && ! reuse; then
            note "compiler sources changed, rebuilding the core compiler"
            if ! rebuild "$package"; then
                note "the core compiler did not build; running the last one that did (see $CLI/build.log)"
            fi
            package=$(selected)
        fi
        unlock
    fi
    printf '%s\n' "$package"
}

case "${1:-}" in
    run)
        shift
        case "${1:-}" in
            "" | -h | --help | help | __*) package=$(current) ;;
            *)
                if [ "${NUPP_CORE_AUTO_REBUILD:-1}" != 0 ]; then
                    package=$(current rebuild)
                else
                    package=$(current)
                fi
                ;;
        esac
        [ -n "$package" ] || exit 1
        # Nothing a core compiler starts may reach for the VM.
        unset NUPP_VM_BINARY NUPP_VM_CLI_IMAGE NUPP_VM_CLI_ENTRY
        NUPP_COMPILER_ROOT=${NUPP_COMPILER_ROOT:-"$ROOT"}
        NUPP_CORE_RUNTIME="$package/runtime"
        NUPP_CORE_COMPILER="$package/compiler.bundle"
        # A child bin/nupp the compiler starts runs on the core too.
        NUPP_RUNTIME=core
        # The Lua files this compiler compiled on the core, kept for the next
        # command it runs (`nupp.runtime.chunkfiles`): one directory per
        # generation, since a chunk is the compiler's that compiled it, and
        # so never one a parent command on another generation named.
        NUPP_CORE_CHUNK_CACHE="$CLI/chunks/$(basename "$package")"
        mkdir -p "$NUPP_CORE_CHUNK_CACHE" 2>/dev/null || NUPP_CORE_CHUNK_CACHE=
        export NUPP_COMPILER_ROOT NUPP_CORE_RUNTIME NUPP_CORE_COMPILER NUPP_RUNTIME NUPP_CORE_CHUNK_CACHE
        exec "$NUPP_CORE_RUNTIME" "$NUPP_CORE_COMPILER" /dev/null /dev/null "$@"
        ;;
    build)
        package=$(selected) || die "no core compiler is installed to rebuild with"
        lock
        rebuild "$package" || die "the core compiler did not build (see $CLI/build.log)"
        unlock
        selected
        ;;
    current)
        package=$(selected) || exit 1
        generation_current "$package"
        ;;
    install)
        [ "$#" -eq 3 ] || die "usage: scripts/core-cli install RUNTIME COMPILER"
        lock
        install_pair "$2" "$3"
        rm -f "$CLI/builder"
        unlock
        ;;
    select)
        lock
        reuse || exit 1
        unlock
        selected
        ;;
    *) die "usage: scripts/core-cli run ARGUMENT... | build | current | install RUNTIME COMPILER | select" ;;
esac
