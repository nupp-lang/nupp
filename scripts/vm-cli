#!/usr/bin/env python3
"""Install or inspect a verified local VM CLI compiler snapshot."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import re
import tempfile
import time

ROOT = Path(__file__).resolve().parent.parent
PACKAGES = ROOT / ".nupp/vm-cli"
FORMAT = "nupp-vm-cli-1"


def digest(path):
    with path.open("rb") as source:
        result = hashlib.sha256()
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            result.update(chunk)
        return result.hexdigest()


def source_state():
    try:
        revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, stderr=subprocess.DEVNULL, text=True).strip()
    except subprocess.CalledProcessError:
        revision = None
    try:
        paths = subprocess.check_output([
            "git", "ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", "src", "templates", "native", "runtime",
            "scripts", "bin", "nupp.lua", "tests/run.lua", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".cargo",
        ], cwd=ROOT, stderr=subprocess.DEVNULL).split(b"\0")
    except subprocess.CalledProcessError:
        return {"revision": None, "fingerprint": None}
    state = hashlib.sha256()
    for name in sorted(filter(None, paths)):
        path = ROOT / os.fsdecode(name)
        state.update(name + b"\0")
        state.update(path.read_bytes() if path.is_file() else b"<missing>")
        state.update(b"\0")
    return {"revision": revision, "fingerprint": state.hexdigest()}


def selected():
    generation = (PACKAGES / "current").read_text().strip()
    if len(generation) != 64 or any(c not in "0123456789abcdef" for c in generation):
        raise ValueError("invalid VM CLI package selection")
    package = PACKAGES / generation
    if (package / "format").read_text().strip() != FORMAT:
        raise ValueError("incomplete VM CLI package")
    return package


def validate_files(package, receipt):
    for key, filename in (("runtimeSha256", "runtime"), ("imageSha256", "compiler.image")):
        if digest(package / filename) != receipt[key]:
            raise ValueError(f"VM CLI package {filename} does not match its receipt")
    if not os.access(package / "runtime", os.X_OK):
        raise ValueError("VM CLI runtime is not executable")


def write_stamp(pending=None):
    """Mark the selected generation as built from the sources as they were when
    `pending` was made (now, without one). The launcher rebuilds when a compiler
    source is newer than this file; an edit made while a build runs is newer
    than the stamp that build leaves, so it is not lost."""
    target = PACKAGES / "stamp"
    if pending is not None and Path(pending).exists():
        os.replace(pending, target)
    else:
        handle, fresh = tempfile.mkstemp(prefix=".stamp-", dir=PACKAGES)
        os.close(handle)
        os.replace(fresh, target)
    (PACKAGES / "failed").unlink(missing_ok=True)


def move_into_place(stage, package):
    """Renames the staged generation into place. Windows refuses a rename while
    something still holds a file under it -- the runtime the validation just
    ran, or a scanner reading it -- so there it retries, then copies: a held
    file can still be read."""
    for attempt in range(20 if os.name == "nt" else 1):
        try:
            stage.rename(package)
            return
        except PermissionError:
            if os.name != "nt":
                raise
            time.sleep(0.5)
    copied = package.with_name(package.name + ".copy")
    shutil.rmtree(copied, ignore_errors=True)
    shutil.copytree(stage, copied)
    copied.rename(package)


def install(args):
    runtime, image = args.runtime.resolve(strict=True), args.image.resolve(strict=True)
    if not os.access(runtime, os.X_OK):
        raise ValueError("runtime is not executable")
    # A graph image names its modules in its header; the verifier below
    # checks the rest.
    if b"nupp.tools.vm.root" not in image.read_bytes():
        raise ValueError("image does not contain the full nupp.tools.vm.root CLI")
    PACKAGES.mkdir(parents=True, exist_ok=True)
    # Windows may still hold a file the validation ran when the stage is
    # removed; what is left behind is only a stale staging directory.
    leftovers = {"ignore_cleanup_errors": True} if sys.version_info >= (3, 10) else {}
    with tempfile.TemporaryDirectory(prefix=".install-", dir=PACKAGES, **leftovers) as directory:
        stage = Path(directory)
        shutil.copyfile(runtime, stage / "runtime")
        (stage / "runtime").chmod(0o755)
        shutil.copyfile(image, stage / "compiler.image")
        receipt = {
            "format": FORMAT,
            "runtimeSha256": digest(stage / "runtime"),
            "imageSha256": digest(stage / "compiler.image"),
            "installedFrom": {"runtime": str(runtime), "image": str(image)},
            "sourceAtInstall": source_state(),
            "sourceProvenance": "Source state at installation, not a claim that supplied artifacts were built from it.",
            "execution": "JIT disabled during validation; supplied matching-image AOT remains enabled",
            "linked": bool(getattr(args, "linked", False)),
            "validation": ["image verifier", "full root CLI --help"],
        }
        env = dict(os.environ, NO_JIT="1", NUPP_COMPILER_ROOT=str(ROOT),
                   NUPP_VM_BINARY=str(stage / "runtime"), NUPP_VM_CLI_IMAGE=str(stage / "compiler.image"))
        for name in ("JIT_ONLY", "JIT_SKIP", "JIT_LIMIT", "EMIT_STUBS", "EMIT_SURVEY"):
            env.pop(name, None)
        for command in (
            [str(stage / "runtime"), "verify", str(stage / "compiler.image")],
            [str(stage / "runtime"), "exec", str(stage / "compiler.image"), "nupp.tools.vm.root", "--help"],
        ):
            result = subprocess.run(command, cwd=ROOT, env=env, capture_output=True, text=True, timeout=300)
            if result.returncode:
                raise ValueError("package validation failed: " + result.stderr[-8000:])
            if command[1] == "exec" and "Usage:" not in result.stdout:
                raise ValueError("root CLI help did not produce its usage text")
        material = json.dumps({key: receipt[key] for key in ("format", "runtimeSha256", "imageSha256")},
                              sort_keys=True, separators=(",", ":")).encode()
        generation = hashlib.sha256(material).hexdigest()
        (stage / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
        (stage / "format").write_text(FORMAT + "\n")
        package = PACKAGES / generation
        reused = package.exists()
        if not reused:
            try:
                move_into_place(stage, package)
            except OSError:
                if not package.exists():
                    raise
                reused = True
        if reused:
            validate_files(package, receipt)
            if (package / "format").read_text().strip() != FORMAT:
                raise ValueError("incomplete VM CLI package")
            # Artifact bytes stay immutable. A validated repeated installation
            # refreshes only its installation provenance, using the same source
            # snapshot the staged receipt took before validation.
            os.replace(stage / "receipt.json", package / "receipt.json")
        # Readers see a complete generation with an atomic installation receipt.
        # Existing children retain their absolute runtime and image paths.
        handle, pending = tempfile.mkstemp(prefix=".current-", dir=PACKAGES)
        try:
            with os.fdopen(handle, "w") as target:
                target.write(generation + "\n")
            os.replace(pending, PACKAGES / "current")
        finally:
            Path(pending).unlink(missing_ok=True)
    write_stamp(getattr(args, "stamp", None))
    prune()
    print(package)


def current(_args):
    """Exit 0 when the selected generation was installed from exactly these sources:
    a fresh worktree seeded with it is then current although every file in it is
    newer than the stamp, and the launcher needs no rebuild."""
    package = selected()
    receipt = json.loads((package / "receipt.json").read_text())
    validate_files(package, receipt)
    now = source_state()["fingerprint"]
    recorded = receipt.get("sourceAtInstall", {}).get("fingerprint")
    sys.exit(0 if now is not None and now == recorded else 1)


def status():
    package = selected()
    receipt = json.loads((package / "receipt.json").read_text())
    validate_files(package, receipt)
    current = source_state()
    recorded = receipt["sourceAtInstall"]
    print(json.dumps({
        "package": str(package), "receipt": receipt,
        "sourceChangedSinceInstall": None if current["fingerprint"] is None else current["fingerprint"] != recorded["fingerprint"],
        "sourceNow": current,
        "policy": "bin/nupp rebuilds and installs a new generation when a compiler source is newer than .nupp/vm-cli/stamp.",
    }, indent=2))


def root_extras():
    """The extras list `nupp.tools.vm.project.ROOT_EXTRAS` spells, read from source so
    a seed image older than that constant can still be asked for the same image."""
    text = (ROOT / "src/nupp/tools/vm/project.nupp").read_text()
    block = re.search(r"project\.ROOT_EXTRAS = (.*?)\n\n", text, re.S)
    if not block:
        raise ValueError("cannot find project.ROOT_EXTRAS")
    return "".join(re.findall(r'"([^"]*)"', block.group(1)))


def run_step(command, env=None, what=""):
    started = time.time()
    result = subprocess.run(command, cwd=ROOT, env=env)
    if result.returncode:
        raise ValueError(f"{what or command[0]} failed with status {result.returncode}")
    print(f"vm-cli: {what} took {time.time() - started:.0f}s", file=sys.stderr)


def cargo(features, target, extra_env=None, default_features=True):
    env = dict(os.environ, CARGO_TARGET_DIR=str(target), **(extra_env or {}))
    # Share compiled dependencies across worktrees when sccache is installed.
    if "RUSTC_WRAPPER" not in env and shutil.which("sccache"):
        env["RUSTC_WRAPPER"] = "sccache"
    # Locked always, offline only when asked, as scripts/toolchain builds: a
    # fresh machine has fetched no crates yet.
    command = ["cargo", "build", "--locked", "--release", "-p", "nupp-vm"]
    if os.environ.get("NUPP_HOST_OFFLINE"):
        command.append("--offline")
    if not default_features:
        command.append("--no-default-features")
    if features:
        command += ["--features", features]
    run_step(command, env, "cargo " + (features or "default"))
    # Cargo names a Windows executable with its suffix; copies made from it
    # keep their own names, which Windows runs by full path.
    return target / "release" / ("nupp-vm.exe" if os.name == "nt" else "nupp-vm")


def generation_dir(generation):
    """The installed generation named `generation`, or None when it is not there
    whole."""
    if not generation or len(generation) != 64 or any(c not in "0123456789abcdef" for c in generation):
        return None
    package = PACKAGES / generation
    try:
        if (package / "format").read_text().strip() == FORMAT:
            return package
    except OSError:
        pass
    return None


def pinned():
    """The generation auto rebuilds lower with: the one whose lowering the emit
    cache holds. Rebuilding with each new generation instead would start the
    cache cold whenever the checker or the lowering changed, which is every
    second rebuild of somebody working on them."""
    try:
        return generation_dir((PACKAGES / "emitter").read_text().strip())
    except OSError:
        return None


def pin(package):
    handle, pending = tempfile.mkstemp(prefix=".emitter-", dir=PACKAGES)
    with os.fdopen(handle, "w") as target:
        target.write((package.name if package else "") + "\n")
    os.replace(pending, PACKAGES / "emitter")


def prune():
    """Remove generations nothing selects that have not been touched for a day. A
    command started under an older generation keeps running from its directory,
    so one is only removed once no command could plausibly still hold it."""
    keep_seconds = float(os.environ.get("NUPP_VM_CLI_KEEP_SECONDS", 86400))
    keep = {p.name for p in (selected(), pinned()) if p is not None}
    now = time.time()
    for package in PACKAGES.iterdir():
        if package.name in keep or not generation_dir(package.name):
            continue
        try:
            if now - (package / "format").stat().st_mtime > keep_seconds:
                shutil.rmtree(package)
        except OSError:
            pass


def emit_with(package, image, env):
    """Lower these sources into `image` with the installed generation `package`,
    on its own runtime: the runtime it was built and checked with, and with its
    functions compiled in when it was linked."""
    run_step([str(package / "runtime"), "run", str(package / "compiler.image"), "nupp.tools.vm.project", "emit",
              str(ROOT), "nupp.tools.vm.root", root_extras(), "--output", str(image)], env, "VM-hosted root emit")


def build(args):
    """Emit the root CLI image from this checkout, link its compiled code into a
    runtime, and install the pair. The image is lowered by the installed VM CLI
    when there is one (`--seed vm`), by the generation the emit cache was filled
    by (`--seed pinned`, what the launcher's automatic rebuild asks for), or by
    a verified execution seed (`scripts/toolchain stage0-seed`), then once more
    by what that lowered."""
    out = ROOT / "build/vm-cli"
    out.mkdir(parents=True, exist_ok=True)
    target = ROOT / "build/rust/target"
    image = out / "compiler.image"
    image.unlink(missing_ok=True)
    # What the sources looked like when this build started: an edit made while
    # it runs is newer, so the launcher builds again.
    PACKAGES.mkdir(parents=True, exist_ok=True)
    handle, stamp = tempfile.mkstemp(prefix=".stamp-", dir=PACKAGES)
    os.close(handle)
    args.stamp = stamp
    try:
        build_from(args, out, target, image)
    finally:
        Path(stamp).unlink(missing_ok=True)


def execution_seed():
    """A digest-verified matching runtime/image pair, never a source-built VM."""
    found = subprocess.run([str(ROOT / "scripts/toolchain"), "stage0-seed"], cwd=ROOT,
                           capture_output=True, text=True)
    if found.returncode:
        raise ValueError("no bootstrap execution seed: " + found.stderr.strip())
    package = Path(found.stdout.strip().splitlines()[-1]).resolve(strict=True)
    run_step([sys.executable, str(ROOT / "scripts/bootstrap-seed"), "verify", str(package)],
             what="verify execution seed")
    return package


def execution_environment(cache=None):
    """New images execute on the seed interpreter, never matching-image AOT."""
    env = compiler_environment(cache)
    env.update(NO_AOT="1", SIMD_INTERPRET="1")
    env.pop("NO_THREADED", None)
    return env


def build_from(args, out, target, image):
    # Per-module lowering kept between emits (nupp.tools.vm.emitcache).
    cache = None if args.no_cache else (args.cache or out / "emit-cache")
    cached = {"NUPP_VM_EMIT_CACHE": str(cache)} if cache else {}
    installed = (PACKAGES / "current").exists()
    seed = args.seed or ("vm" if installed else "image")
    if seed == "pinned" and not installed:
        seed = "image"
    env = dict(os.environ, NO_JIT="1", NUPP_COMPILER_ROOT=str(ROOT), **cached)
    for name in ("GC_STRESS", "GC_INTERLEAVE", "GC_ORACLE", "GC_QUARANTINE", "NUPP_VM_CLI_IMAGE", "NUPP_VM_BINARY"):
        env.pop(name, None)
    if seed in ("vm", "pinned"):
        emitter = (pinned() if seed == "pinned" else None) or selected()
        try:
            emit_with(emitter, image, env)
        except ValueError:
            # An older compiler may not read what the sources now say; the newest
            # one is the next best thing, and the stage zero, which the pin keeps
            # able to read them, the last.
            emitter = None
            if (pinned() if seed == "pinned" else None) not in (None, selected()):
                print("vm-cli: the pinned compiler could not lower these sources; using the installed one",
                      file=sys.stderr)
                try:
                    emit_with(selected(), image, env)
                    emitter = selected()
                except ValueError:
                    pass
            if emitter is None:
                print("vm-cli: the installed compiler could not lower these sources; starting from the stage zero",
                      file=sys.stderr)
                seed = "image"
        if emitter is not None and (seed == "vm" or pinned() is None or emitter != pinned()):
            pin(emitter)
    if seed == "image":
        pair = execution_seed()
        seed_image = pair / "compiler.image"
        runner = pair / "runtime"
        run_step([str(runner), "run", str(seed_image), "nupp.tools.vm.project", "emit", str(ROOT),
                  "nupp.tools.vm.root", root_extras(), "--output", str(image)], execution_environment(cache), "seed root emit")
        # A pinned image is an older compiler: what it lowers is these sources
        # as its lowerer spells them. One more pass lowers them with their own
        # lowerer, which is the image the fixpoint verifies.
        first = out / "stage1.image"
        image.replace(first)
        run_step([str(runner), "run", str(first), "nupp.tools.vm.project", "emit", str(ROOT),
                  "nupp.tools.vm.root", root_extras(), "--output", str(image)], execution_environment(cache), "self-hosting root emit")
        first.unlink()
    if not image.is_file():
        raise ValueError("the root emit wrote no image")
    if seed == "image":
        # A compiler from elsewhere filled the cache; the next automatic rebuild
        # pins what this one installs.
        (PACKAGES / "emitter").unlink(missing_ok=True)
    args.linked = not args.no_aot
    if args.no_aot:
        pair = execution_seed()
        obj = native_runtime_object(pair / "runtime", image, out / "native", target)
        runtime = cargo("native-runtime", target, {"NUPP_NATIVE_RUNTIME_OBJECT": str(obj)})
    else:
        runtime = linked_runtime(image, out, target)
    staged = out / "runtime"
    # Never copied over an executable in place: macOS kills a process whose
    # mapped binary changes under it.
    shutil.copyfile(runtime, out / "runtime.new")
    (out / "runtime.new").chmod(0o755)
    os.replace(out / "runtime.new", staged)
    args.runtime, args.image = staged, image
    install(args)


NATIVE_OUT = ROOT / "build/native-runtime"
# What the lowering needs beside itself when it runs as a small image of its own.
LOWERING_EXTRAS = ",".join([
    "nupp.compiler.hostservices", "nupp.compiler.fs", "nupp.compiler.project.projectconfig",
    "nupp.compiler.project.store", "nupp.compiler.project.fingerprint", "nupp.compiler.hash",
    "nupp.compiler.project.preludecache", "nupp.runtime.provider.nativeprocess",
    "nupp.runtime.provider.nativepath", "nupp.runtime.provider.nativefiles",
])


def compiler_environment(cache):
    env = dict(os.environ, NO_JIT="1", NUPP_COMPILER_ROOT=str(ROOT))
    for name in ("GC_STRESS", "GC_INTERLEAVE", "GC_ORACLE", "GC_QUARANTINE", "NUPP_VM_CLI_IMAGE", "NUPP_VM_BINARY",
                 "NUPP_NATIVE_RUNTIME_OBJECT", "NUPP_AOT_OBJECT"):
        env.pop(name, None)
    if cache:
        env["NUPP_VM_EMIT_CACHE"] = str(cache)
    return env


def native_runtime_object(runner, image, out, target, glue=None):
    """The native core: the handler sources under src/nupp/runtime/native lowered
    to CLIF by `nupp.compiler.clif.lower` running on `runner` with the compiler
    `image`, against the layouts the glue measures, and compiled to an object by
    the glue (`nupp-vm native`). Answers the object's path; the glue's `.rs`
    sidecar and `.txt` listing land beside it."""
    out.mkdir(parents=True, exist_ok=True)
    glue = glue or cargo("aot", target)
    layouts = out / "layouts.json"
    run_step([str(glue), "native", "layouts", str(layouts)], None, "native layouts")
    clif = out / "runtime.clif"
    clif.unlink(missing_ok=True)
    run_step([str(runner), "run", str(image), "nupp.compiler.clif.lower", "compileRuntime", str(ROOT), str(layouts),
              "--output", str(clif)], execution_environment(None), "lowering of the native core")
    if not clif.is_file():
        raise ValueError("the lowering wrote no CLIF")
    obj = out / "runtime.o"
    run_step([str(glue), "native", "object", str(clif), str(obj)], None, "native object")
    (ROOT / "native/crates/vm/src/lib.rs").touch()
    return obj


def lowering_image(out, target, cache):
    """A small image holding the lowering, emitted from these sources by the
    installed compiler, or by the pinned stage zero on a plain runtime when
    nothing is installed. Answers the image's path."""
    out.mkdir(parents=True, exist_ok=True)
    image = out / "lower.image"
    image.unlink(missing_ok=True)
    env = compiler_environment(cache)
    if (PACKAGES / "current").exists():
        package = selected()
        runner = package / "runtime"
        compiler = package / "compiler.image"
    else:
        package = execution_seed()
        runner = package / "runtime"
        compiler = package / "compiler.image"
        env = execution_environment(cache)
    run_step([str(runner), "run", str(compiler), "nupp.tools.vm.project", "emit", str(ROOT),
              "nupp.compiler.clif.lower", LOWERING_EXTRAS, "src", "--output", str(image)], env,
             "emit of the lowering image")
    if not image.is_file():
        raise ValueError("the lowering image was not written")
    return image


def glue(_args):
    """Build the glue (`nupp-vm` with the code generator, `native` and `aot`
    subcommands) into the shared target directory and print its path."""
    print(cargo("aot", ROOT / "build/rust/target"))


def runtime(args):
    """Build the native core object into build/native-runtime, and with
    `--link` a runtime that has it linked in (build/native-runtime/runtime), for
    measurement against a runtime without it."""
    out = NATIVE_OUT
    target = ROOT / "build/rust/target"
    pair = execution_seed()
    source = source_state()["fingerprint"]
    key = {"source": source, "seed": digest(pair / "manifest.json")}
    receipt_file = out / "source.json"
    if getattr(args, "reuse", False) and not args.link:
        try:
            receipt = json.loads(receipt_file.read_text())
            if receipt["inputs"] == key and all(digest(out / name) == sha for name, sha in receipt["artifacts"].items()):
                print(out / "runtime.o")
                return
        except (OSError, ValueError, KeyError):
            pass
    glue = cargo("aot", target)
    image = lowering_image(out, target, None if args.no_cache else out / "emit-cache")
    # Layout/object generation is mechanical. Only the verified seed executes
    # this newly emitted image, with matching-image AOT disabled.
    obj = native_runtime_object(pair / "runtime", image, out, target, glue)
    receipt_file.write_text(json.dumps({"inputs": key, "artifacts": {
        name: digest(out / name) for name in ("runtime.clif", "runtime.o", "runtime.o.rs")
    }}, indent=2) + "\n")
    print(obj)
    if args.link:
        built = cargo("aot,native-runtime", target, {"NUPP_NATIVE_RUNTIME_OBJECT": str(obj)})
        shutil.copyfile(built, out / "runtime.new")
        (out / "runtime.new").chmod(0o755)
        os.replace(out / "runtime.new", out / "runtime")
        print(out / "runtime")


def linked_runtime(image, out, target):
    """A runtime with `image`'s functions compiled in, and with `native` the
    Nupp-authored interpreter core linked in as well."""
    aot_tool = cargo("aot", target)
    shutil.copyfile(aot_tool, out / "aot-tool.new")
    (out / "aot-tool.new").chmod(0o755)
    os.replace(out / "aot-tool.new", out / "aot-tool")
    obj = out / "compiler.o"
    run_step([str(out / "aot-tool"), "aot", str(image), str(obj), "--frames"], None, "AOT of the root image")
    features = "aot-linked,c-headers,native-ffi,compression,net,http,regex,markdown"
    env = {"NUPP_AOT_OBJECT": str(obj)}
    # AOT retains the normal compiler route. Its boundary operations still need
    # the Nupp interpreter, and the machine tool must not execute guest code.
    core = native_runtime_object(execution_seed() / "runtime", image, out / "native", target, out / "aot-tool")
    features += ",native-runtime"
    env["NUPP_NATIVE_RUNTIME_OBJECT"] = str(core)
    # The object is read by the build script, which does not see a changed
    # file behind an unchanged variable.
    (ROOT / "native/crates/vm/src/lib.rs").touch()
    return cargo(features, target, env, default_features=False)


class build_lock:
    """The launcher's rebuild lock (`bin/nupp`): a directory holding its owner's
    pid, taken over from an owner that is gone."""
    path = ROOT / ".nupp/vm-cli-build.lock"

    def __init__(self, path=None):
        if path is not None:
            self.path = path

    def __enter__(self):
        while True:
            try:
                self.path.mkdir(parents=True)
                (self.path / "pid").write_text("%d\n" % os.getpid())
                return self
            except FileExistsError:
                try:
                    os.kill(int((self.path / "pid").read_text()), 0)
                except (OSError, ValueError):
                    # Its owner writes the pid just after making it.
                    try:
                        young = time.time() - self.path.stat().st_mtime < 10
                    except OSError:
                        continue
                    if not young:
                        shutil.rmtree(self.path, ignore_errors=True)
                        continue
                time.sleep(1)

    def __exit__(self, *_):
        shutil.rmtree(self.path, ignore_errors=True)


def link(args):
    """Replace the selected generation's interpreter-only runtime with one that
    has its image compiled in, keeping the image. Installs only while that
    generation is still the selected one; when a newer one was installed
    meanwhile, links that one instead. One link at a time per checkout: a link
    asked for while one runs is left to it, since it links whatever is selected
    when it finishes."""
    lock = ROOT / ".nupp/vm-cli-link.lock"
    try:
        lock.mkdir(parents=True)
    except FileExistsError:
        try:
            os.kill(int((lock / "pid").read_text()), 0)
            return
        except (OSError, ValueError):
            shutil.rmtree(lock, ignore_errors=True)
            lock.mkdir(parents=True)
    (lock / "pid").write_text("%d\n" % os.getpid())
    try:
        while True:
            package = selected()
            receipt = json.loads((package / "receipt.json").read_text())
            if receipt.get("linked"):
                return
            out = ROOT / "build/vm-cli/link"
            out.mkdir(parents=True, exist_ok=True)
            image = out / "compiler.image"
            shutil.copyfile(package / "compiler.image", image)
            # A target directory of its own: a rebuild running beside this one
            # builds the interpreter-only runtime into the shared one, at the same
            # path.
            runtime = linked_runtime(image, out, ROOT / "build/rust/link-target")
            shutil.copyfile(runtime, out / "runtime.new")
            (out / "runtime.new").chmod(0o755)
            os.replace(out / "runtime.new", out / "runtime")
            # Selected and replaced under the launcher's build lock, so a rebuild
            # cannot install between the two.
            with build_lock():
                if selected() != package:
                    print("vm-cli: a newer generation was installed while linking; linking that", file=sys.stderr)
                    continue
                # The linked runtime runs the same image, so it is as current as
                # the interpreter it replaces: the stamp carries over unchanged.
                keep = None
                stamp = PACKAGES / "stamp"
                if stamp.exists():
                    handle, keep = tempfile.mkstemp(prefix=".stamp-", dir=PACKAGES)
                    os.close(handle)
                    shutil.copystat(stamp, keep)
                args.runtime, args.image, args.stamp, args.linked = out / "runtime", image, keep, True
                install(args)
                # The emit cache's compiler is this image too, now faster to run.
                if pinned() == package:
                    pin(selected())
    finally:
        shutil.rmtree(lock, ignore_errors=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    command = commands.add_parser("install", help="verify and atomically select a runtime and full root CLI image")
    command.add_argument("--runtime", type=Path, required=True)
    command.add_argument("--image", type=Path, required=True)
    command.add_argument("--linked", action="store_true", help="the runtime has this image's functions compiled in")
    commands.add_parser("status", help="verify installed artifacts and report source changes since installation")
    commands.add_parser("current", help="exit 0 when the selected generation was built from exactly these sources")
    command = commands.add_parser("build", help="emit, link and install a VM CLI from this checkout's sources")
    command.add_argument("--seed", choices=["vm", "pinned", "image"], help="compiler that lowers the image (default: installed VM CLI, else verified execution seed; pinned: the generation the emit cache was filled by)")
    command.add_argument("--no-aot", action="store_true", help="install an interpreter-only runtime instead of linking compiled code")
    command.add_argument("--cache", type=Path, help="where emits keep per-module lowering (default: build/vm-cli/emit-cache)")
    command.add_argument("--no-cache", action="store_true", help="lower every module from source and keep nothing")
    command = commands.add_parser("link", help="link the selected generation's image into its runtime")
    commands.add_parser("glue", help="build the glue tool (nupp-vm with aot and native subcommands) and print its path")
    command = commands.add_parser("runtime", help="build the native core object (build/native-runtime/runtime.o) from the handler sources")
    command.add_argument("--link", action="store_true", help="also build a runtime with the object linked in, for measurement")
    command.add_argument("--no-cache", action="store_true", help="lower the lowering's image from source and keep nothing")
    command.add_argument("--reuse", action="store_true", help="reuse a verified native object for identical source and seed bytes")
    args = parser.parse_args()
    try:
        if args.command == "runtime":
            with build_lock(ROOT / ".nupp/native-runtime-build.lock"):
                runtime(args)
        else:
            {"install": install, "status": lambda _: status(), "build": build, "link": link, "current": current,
             "glue": glue}[args.command](args)
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired) as error:
        print(f"nupp: {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
