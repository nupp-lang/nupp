#!/bin/sh
# Create a Nupp task worktree and seed only caches safe to carry across it.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)

usage() {
    echo "usage: scripts/worktree BRANCH PATH [START_POINT]" >&2
    exit 2
}

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
BRANCH=$1
TASK_PATH=$2
START_POINT=${3:-HEAD}

git -C "$ROOT" worktree add -b "$BRANCH" "$TASK_PATH" "$START_POINT"
TASK_ROOT=$(git -C "$TASK_PATH" rev-parse --show-toplevel)

mkdir -p "$TASK_ROOT/build"

# build/rust runs to a hundred gigabytes, so a plain copy per worktree fills a disk
# in two or three. Clone where the filesystem can, and copy only where it cannot.
# A failed clone leaves a partial tree, which is removed before the next attempt;
# the destination did not exist before this call.
copy_tree() {
    if [ "$(uname)" = Darwin ]; then
        cp -cRp "$1" "$2" 2>/dev/null && return 0
    else
        cp -Rp --reflink=auto "$1" "$2" 2>/dev/null && return 0
    fi
    rm -rf "$2"
    cp -Rp "$1" "$2"
}

copy_if_absent() {
    SOURCE=$1
    DESTINATION=$2
    if [ -e "$SOURCE" ] && [ ! -e "$DESTINATION" ] && [ ! -L "$DESTINATION" ]; then
        mkdir -p "$(dirname "$DESTINATION")"
        copy_tree "$SOURCE" "$DESTINATION"
    fi
}

# These stores validate their own content keys. A stale entry is a miss, so copying
# them can save work but cannot change an answer.
copy_if_absent "$ROOT/build/cache" "$TASK_ROOT/build/cache"
copy_if_absent "$ROOT/build/rust" "$TASK_ROOT/build/rust"
copy_if_absent "$ROOT/build/.nupp-test-times.json" "$TASK_ROOT/build/.nupp-test-times.json"

# Generated compiler output is reusable only when it represents this exact revision
# and the originating checkout itself considers it current. Touching the copied stamp
# is then sound: the fresh worktree's source mtimes describe checkout time, not edits.
ORIGIN_HEAD=$(git -C "$ROOT" rev-parse HEAD)
TASK_HEAD=$(git -C "$TASK_ROOT" rev-parse HEAD)
ORIGIN_STAMP="$ROOT/build/.nupp-complete"
ORIGIN_BUILT="$ROOT/build/nupp/tools/main.lua"
NEWER_SOURCE=""
if [ -f "$ORIGIN_STAMP" ]; then
    NEWER_SOURCE=$(find "$ROOT/src" -type f -newer "$ORIGIN_STAMP" -print -quit 2>/dev/null || true)
    if [ -z "$NEWER_SOURCE" ] && [ "$ROOT/nupp.lua" -nt "$ORIGIN_STAMP" ]; then
        NEWER_SOURCE="$ROOT/nupp.lua"
    fi
fi
ORIGIN_SOURCE_CHANGES=$(git -C "$ROOT" status --porcelain --untracked-files=normal -- \
    src nupp.lua native Cargo.toml Cargo.lock rust-toolchain.toml .cargo/config.toml)
if [ "$ORIGIN_HEAD" = "$TASK_HEAD" ] && [ -f "$ORIGIN_STAMP" ] \
    && [ -f "$ORIGIN_BUILT" ] && [ -z "$NEWER_SOURCE" ] \
    && [ -z "$ORIGIN_SOURCE_CHANGES" ]; then
    for SOURCE_ROOT in "$ROOT"/src/*; do
        SOURCE_NAME=${SOURCE_ROOT##*/}
        if [ -d "$SOURCE_ROOT" ]; then
            copy_if_absent "$ROOT/build/$SOURCE_NAME" "$TASK_ROOT/build/$SOURCE_NAME"
            copy_if_absent "$ROOT/build/$SOURCE_NAME.lua" "$TASK_ROOT/build/$SOURCE_NAME.lua"
        else
            case "$SOURCE_NAME" in
                *.nupp) MODULE_NAME=${SOURCE_NAME%.nupp} ;;
                *.lua) MODULE_NAME=${SOURCE_NAME%.lua} ;;
                *) continue ;;
            esac
            copy_if_absent "$ROOT/build/$MODULE_NAME.lua" "$TASK_ROOT/build/$MODULE_NAME.lua"
        fi
    done
    copy_if_absent "$ROOT/build/lib" "$TASK_ROOT/build/lib"
    copy_if_absent "$ROOT/build/.nupp-state.json" "$TASK_ROOT/build/.nupp-state.json"
    copy_if_absent "$ORIGIN_STAMP" "$TASK_ROOT/build/.nupp-complete"
    touch "$TASK_ROOT/build/.nupp-complete"
fi

# The VM compiler. A checkout with no installed VM CLI falls back to the LuaJIT
# path, which rebuilds the compiler from stage zero (an hour and more), so seed
# the new worktree from a checkout that has one: this one, or else the worktree
# that has the start point checked out. The generations are immutable; each is
# also kept in the machine's shared store (scripts/shared-cache), where any
# checkout's build of the same inputs finds it instead of building it again.
#
# The emit cache is not copied: what it keeps names the checkout's own paths,
# so another checkout's misses every entry and lowers everything regardless.
VM_ORIGIN=""
if [ -e "$ROOT/.nupp/vm-cli/current" ]; then
    VM_ORIGIN=$ROOT
else
    VM_ORIGIN=$(git -C "$ROOT" worktree list --porcelain | awk -v ref="refs/heads/$START_POINT" '
        /^worktree /{path=substr($0, 10)} $0 == "branch " ref {print path; exit}')
    [ -n "$VM_ORIGIN" ] && [ -e "$VM_ORIGIN/.nupp/vm-cli/current" ] || VM_ORIGIN=""
fi
if [ -n "$VM_ORIGIN" ] && [ "$VM_ORIGIN" != "$TASK_ROOT" ]; then
    copy_if_absent "$VM_ORIGIN/.nupp/vm-cli" "$TASK_ROOT/.nupp/vm-cli"
    "$ROOT/scripts/shared-cache" publish "$VM_ORIGIN" all || true
fi

# Runtime kernels are read from the shared store directly. A checkout that kept
# them under build/core-unit-cache, before there was one, adds what it has.
# Each entry is named by its content, so one already there is the same entry.
KERNELS="$("$ROOT/scripts/shared-cache" home)/kernels"
for KERNEL_ORIGIN in "$ROOT" ${VM_ORIGIN:+"$VM_ORIGIN"}; do
    if [ -d "$KERNEL_ORIGIN/build/core-unit-cache" ]; then
        mkdir -p "$KERNELS"
        if [ "$(uname)" = Darwin ]; then
            cp -cRn "$KERNEL_ORIGIN/build/core-unit-cache/." "$KERNELS/" 2>/dev/null || true
        else
            cp -Rn --reflink=auto "$KERNEL_ORIGIN/build/core-unit-cache/." "$KERNELS/" 2>/dev/null || true
        fi
    fi
done
("$ROOT/scripts/shared-cache" sweep --if-due > /dev/null 2>&1 &)

# `core.hooksPath` is one setting for the whole repository, worktrees included,
# so this is idempotent and the last worktree to be made does not undo it for
# the others. Set here rather than left to be remembered: the hook exists to
# catch what CI would otherwise report twenty minutes later, and a hook nobody
# turned on catches nothing.
if [ "$(git -C "$TASK_ROOT" config core.hooksPath || true)" != ".githooks" ]; then
    git -C "$TASK_ROOT" config core.hooksPath .githooks
fi

echo "created $TASK_ROOT"
echo "seeded compiler, VM CLI, test scheduling, and native build caches where available"
echo "shared store: $("$ROOT/scripts/shared-cache" home)"
echo "hooks: .githooks (pre-push checks formatting; --no-verify skips it)"
