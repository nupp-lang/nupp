#!/bin/sh
# Formats the C the repository owns and the CMake that builds it, or with
# --check says whether they are. --list names the C files, which
# scripts/lint-c checks too. Leading comment spacing also applies to the
# other native sources.
#
# clang-format lays the code out (.clang-format), Uncrustify adds the blank
# lines clang-format cannot place (.uncrustify.cfg), and clang-format runs
# again to restore whatever layout Uncrustify disturbed. gersemi formats the
# CMake (.gersemirc). The external formatters are pinned: clang-format and
# gersemi through pipx, Uncrustify through scripts/toolchain.
set -eu

case "$#:${1-}" in
    1:--check|1:--write|1:--list) mode=$1 ;;
    *)
        printf 'Usage: %s --check|--write|--list\n' "$0" >&2
        exit 2
        ;;
esac

cd "$(git rev-parse --show-toplevel)"

# Every C file the repository owns, which is every tracked one but these:
# the Rust VM's FFI fixtures, which go with the VM at the flip, and the libuv
# probe, which lands from another tree.
set --
for file in $(git ls-files '*.c' '*.h'); do
    case "$file" in
        native/crates/vm/*|tests/fixtures/libuv/*) continue ;;
    esac
    if [ -f "$file" ]; then
        set -- "$@" "$file"
    fi
done

if [ "$mode" = --list ]; then
    printf '%s\n' "$@"
    exit 0
fi

commentFiles=""
for file in $(git ls-files '*.c' '*.h' '*.cc' '*.cpp' '*.cxx' '*.hh' '*.hpp' '*.hxx' '*.S' '*.def'); do
    if [ -f "$file" ]; then
        commentFiles="$commentFiles $file"
    fi
done
commentFormatter=$PWD/scripts/space-native-comments.py

space_comments() {
    # shellcheck disable=SC2086
    python3 "$commentFormatter" $commentFiles
}

# The CMake beside it, with the same exceptions.
cmake=""
for file in $(git ls-files 'CMakeLists.txt' '*/CMakeLists.txt' '*.cmake'); do
    case "$file" in
        native/crates/vm/*|tests/fixtures/libuv/*) continue ;;
    esac
    if [ -f "$file" ]; then
        cmake="$cmake $file"
    fi
done

gersemi() {
    pipx run --spec gersemi==0.29.2 gersemi --config .gersemirc "$@"
}

# shellcheck disable=SC2086
if [ -n "$cmake" ]; then
    if [ "$mode" = --write ]; then
        gersemi --in-place --quiet $cmake
    elif ! gersemi --check --quiet $cmake; then
        printf 'format-c: CMake gersemi would rewrite; run scripts/format-c --write\n' >&2
        cmakeStatus=1
    fi
fi

clang_format() {
    pipx run --spec clang-format==22.1.8 --pip-args=--only-binary=:all: \
        clang-format --style=file:.clang-format "$@"
}

# Formats the named files in place.
format() {
    if [ "$#" -gt 0 ]; then
        clang_format -i "$@"
        "$uncrustify" -q -c .uncrustify.cfg -l C --replace --no-backup "$@"
        clang_format -i "$@"
    fi
    space_comments
}

if [ "$#" -gt 0 ]; then
    uncrustify=$(sh scripts/toolchain uncrustify)
fi

if [ "$mode" = --write ]; then
    format "$@"
    exit 0
fi

# Formats a copy of every file and compares it with the original.
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
for file in $commentFiles; do
    mkdir -p "$scratch/$(dirname "$file")"
    cp "$file" "$scratch/$file"
done
cp .clang-format .uncrustify.cfg "$scratch/"
(cd "$scratch" && format "$@") >/dev/null
status=${cmakeStatus:-0}
for file in $commentFiles; do
    if ! cmp -s "$file" "$scratch/$file"; then
        diff -u "$file" "$scratch/$file" || true
        status=1
    fi
done
exit "$status"
