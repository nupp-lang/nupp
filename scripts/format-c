#!/bin/sh
set -eu

case "$#:${1-}" in
    1:--check|1:--write) mode=$1 ;;
    *)
        printf 'Usage: %s --check|--write\n' "$0" >&2
        exit 2
        ;;
esac

cd "$(git rev-parse --show-toplevel)"

# Every C file the repository owns, which is every tracked one but these:
# the header-import fixtures, whose exact text the C-header tests read; the
# Rust VM's FFI fixtures, which go with the VM at the flip; and the libuv
# probe, which lands from another tree.
set --
for file in $(git ls-files '*.c' '*.h'); do
    case "$file" in
        tests/fixtures/*/*) ;;
        tests/fixtures/*) continue ;;
    esac
    case "$file" in
        native/crates/vm/*|tests/fixtures/libuv/*) continue ;;
    esac
    if [ -f "$file" ]; then
        set -- "$@" "$file"
    fi
done

if [ "$#" -eq 0 ]; then
    set -- --assume-filename=rollout.c --dump-config
    exec >/dev/null
elif [ "$mode" = --check ]; then
    set -- --dry-run --Werror "$@"
else
    set -- -i "$@"
fi

exec pipx run --spec clang-format==22.1.8 --pip-args=--only-binary=:all: \
    clang-format --style=file:.clang-format "$@"
