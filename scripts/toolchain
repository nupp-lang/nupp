#!/bin/sh
# Provisions the native prerequisites Nupp builds against.
#
# Nupp asks for a C and a C++ compiler. Everything else it needs -- the VM
# runtimes, the stage-zero image its first build starts from, and LuaRocks with
# the LuaJIT it runs on for project rock dependencies -- is fetched here from a
# pinned source, verified against a digest, built with that compiler pair, and
# cached.
#
# This is the only thing that builds those. A component is asked for by name and
# answers with the prefix it was installed under, so a caller composes paths
# rather than knowing the layout:
#
#     scripts/toolchain luajit          # -> /path/to/.nupp-cache/toolchain/<key>/luajit
#     scripts/toolchain --all           # everything, quietly, for a cache warm
#
# Building is idempotent and cached: the second call is a directory test. The
# cache is keyed by the compilers' own version output, so switching NUPP_CC from
# clang to gcc builds beside the old answer rather than over it.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT/scripts/toolchain.pins"

# A pin's URL and directory are templates over its own version, so a bump moves
# them with it and the pins file stays the one place a source is named.
expand_pin() { eval "printf '%s' \"$1\""; }

# Names shared with the archive fetching the host build already had, so a CI job
# or an offline builder that supplies pinned archives keeps working unchanged.
SOURCE_DIR=${NUPP_HOST_SOURCE_DIR:-}
SOURCE_BASE_URL=${NUPP_HOST_SOURCE_BASE_URL:-}
OFFLINE=${NUPP_HOST_OFFLINE:-}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/toolchain COMPONENT...
       scripts/toolchain --all
       scripts/toolchain --prefix

Components: luajit luarocks stage0-image stage0-seed
            rust-vendor OUTPUT
            vm-runtime FACILITIES, vm-program FACILITIES PAYLOAD
            archive DIRECTORY OUTPUT

Prints the install prefix of each component named, building it first when it is
not already cached. --all builds every component and prints nothing. --prefix
prints the root the components are installed under without building anything.

Environment:
  NUPP_CC, NUPP_CXX          the compiler pair. Probed when unset.
  NUPP_CARGO, NUPP_RUSTC     the pinned Rust toolchain. Probed when unset.
  NUPP_RUST_WINDOWS_ABI      GNU (default) or gnullvm for LLVM-MinGW.
  NUPP_TOOLCHAIN_DIR         where to install. Defaults to the repository cache.
  NUPP_RUST_BUILD_DIR        Rust outputs. Defaults to build/rust.
  NUPP_RUST_VENDOR_DIR       cargo-vendor directory required by offline Rust builds.
  NUPP_HOST_SOURCE_DIR       a directory of already-downloaded pinned archives.
  NUPP_HOST_SOURCE_BASE_URL  a flat mirror to fetch archives from.
  NUPP_HOST_OFFLINE          refuse to reach the network.
USAGE
    exit 2
}

note() { printf 'toolchain: %s\n' "$*" >&2; }
die() { printf 'toolchain: %s\n' "$*" >&2; exit 1; }

# --- toolchain selection ----------------------------------------------------

probe() {
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

UNAME=$(uname -s 2>/dev/null || echo unknown)
case "$UNAME" in
    Darwin*)              PLATFORM=darwin ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
    FreeBSD*|DragonFly*)  PLATFORM=bsd ;;
    *)                    PLATFORM=posix ;;
esac

CC=${NUPP_CC:-}
CXX=${NUPP_CXX:-}
case "$PLATFORM" in
    # This driver uses the dependencies' GNU make builds. The hosted Windows
    # clang targets MSVC, where LuaJIT's makefile asks its linker for Unix
    # libraries such as `-lm`; the MinGW pair is the compatible default.
    windows)
        [ -n "$CC" ] || CC=$(probe gcc cc clang) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe g++ c++ clang++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
    *)
        [ -n "$CC" ] || CC=$(probe clang cc gcc) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe clang++ c++ g++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
esac

RUST_WINDOWS_ABI=${NUPP_RUST_WINDOWS_ABI:-gnu}
case "$RUST_WINDOWS_ABI" in
    gnu) ;;
    gnullvm)
        [ "$PLATFORM" = windows ] \
            || die "NUPP_RUST_WINDOWS_ABI=gnullvm is only supported on Windows"
        ;;
    *) die "NUPP_RUST_WINDOWS_ABI must be gnu or gnullvm" ;;
esac

command -v "$CC" >/dev/null 2>&1 || die "NUPP_CC names $CC, which is not on PATH"
command -v "$CXX" >/dev/null 2>&1 || die "NUPP_CXX names $CXX, which is not on PATH"

case "$PLATFORM" in
    bsd) MAKE=${MAKE:-gmake} ;;
    *)   MAKE=${MAKE:-make} ;;
esac

# Paths printed to a caller can leave the MSYS shell and be handed directly to
# a native Windows process. Give those consumers the drive-letter spelling;
# Git Bash accepts it too. Tests that emulate Windows on another host have no
# cygpath and keep their host spelling.
native_path() {
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s\n' "$1"
    fi
}

# A directory for Cargo, which hands it to build scripts as OUT_DIR. On Windows
# that is the backslash spelling: libffi-sys turns a prefix into an MSYS path by
# replacing ":\", so given D:/a/... it installed to /D:/a/..., and the native
# ranlib it then ran could not find the archive there.
cargo_dir() {
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -w "$1"
    else
        printf '%s\n' "$1"
    fi
}

# --- digests ----------------------------------------------------------------

# Whichever of these the machine has. All three answer the same question and no
# platform reliably carries a particular one.
if command -v shasum >/dev/null 2>&1; then
    sha256_stdin() { shasum -a 256 | cut -d' ' -f1; }
elif command -v sha256sum >/dev/null 2>&1; then
    sha256_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
    sha256_stdin() { openssl dgst -sha256 | sed 's/.*= *//'; }
else
    die "no sha256 tool found; install one of shasum, sha256sum or openssl"
fi
sha256() { sha256_stdin < "$1"; }

# The pins that decide a native artifact, which is every pin but the stage-zero
# one. That one names a Nupp release and a bundle of Lua; no C compiler ever
# sees it, and keying LuaJIT and every Rust crate on it would make the
# one-line pin bump a stage-zero move asks for a from-scratch native rebuild on
# machine that pulls it. Assignments only, so a comment is documentation rather
# than a cache generation. A mirror list says where else the same bytes may be
# found, which changes no artifact either.
pins_digest() {
    grep '^[A-Z][A-Z0-9_]*=' "$ROOT/scripts/toolchain.pins" \
        | grep -v -e '^STAGE0_' -e '^[A-Z0-9_]*_MIRRORS=' \
        | sha256_stdin
}

# Rust inputs have their own content key: every workspace or lock-file change
# rebuilds the Rust artifact.
# Hashing every native source costs seconds on a loaded machine; a run that
# asks for several components computes it once (by setting `RUST_SOURCES_DIGEST`).
rust_sources_digest() {
    if [ -n "${RUST_SOURCES_DIGEST:-}" ]; then
        printf '%s\n' "$RUST_SOURCES_DIGEST"
        return 0
    fi
    {
        # `scripts/toolchain.pins` is not in this list because it is folded in
        # below through `pins_digest`, which leaves out the stage-zero pin.
        for file in Cargo.toml Cargo.lock rust-toolchain.toml .cargo/config.toml \
            scripts/toolchain scripts/patches/luajit.patch \
            host/include/nupp.exports; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
        (cd "$ROOT" && find native/crates -type f \
            \( -name '*.rs' -o -name '*.c' -o -name '*.cpp' -o -name '*.h' \
                -o -name 'Cargo.toml' -o -name 'build.rs' \) \
            2>/dev/null) || true
    } | LC_ALL=C sort | {
        while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done
        printf 'scripts/toolchain.pins %s\n' "$(pins_digest)"
    } | sha256_stdin | cut -c1-16
}
# --- where things go --------------------------------------------------------

# Beside the repository's common git directory, so every worktree of this
# checkout shares one build of LuaJIT rather than each paying for its own. A
# source archive with no git metadata falls back to the checkout.
if [ -n "${NUPP_TOOLCHAIN_DIR:-}" ]; then
    CACHE=$NUPP_TOOLCHAIN_DIR
else
    COMMON=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$COMMON" ]; then
        case "$COMMON" in
            /*|[A-Za-z]:*) ;;
            *) COMMON="$ROOT/$COMMON" ;;
        esac
        CACHE="$(dirname "$COMMON")/.nupp-cache/toolchain"
    else
        CACHE="$ROOT/build/toolchain"
    fi
fi

ARCHIVES="$CACHE/archives"
SOURCES="$CACHE/sources"

# What the answer depends on: the compilers, their versions, the machine, and
# these provisioning rules. Several change without a native source changing;
# ignoring one can return an artifact built with another compiler or link line.
key_material() {
    printf '%s\n%s\n' "$CC" "$CXX"
    "$CC" --version 2>&1 | head -n 2 || true
    "$CXX" --version 2>&1 | head -n 2 || true
    printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    sha256 "$ROOT/scripts/toolchain"
    sha256 "$ROOT/scripts/patches/luajit.patch"
    pins_digest
}
KEY=$(key_material | sha256_stdin | cut -c1-16)
PREFIX="$CACHE/$KEY"
RUST_BUILD_ROOT=${NUPP_RUST_BUILD_DIR:-"$ROOT/build/rust"}

# --- fetching ---------------------------------------------------------------

download() {
    url=$1 destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet --output-document "$destination" "$url"
    else
        die "no downloader found; install curl or wget"
    fi
}

offline() {
    case "$OFFLINE" in
        1|true|yes|on|TRUE|YES|ON) return 0 ;;
        ""|0|false|no|off|FALSE|NO|OFF) return 1 ;;
        *) die "NUPP_HOST_OFFLINE must be one of 1, true, yes, on, 0, false, no or off" ;;
    esac
}

# One pinned archive, in the cache, verified. A digest is checked before a byte
# is unpacked, so a mirror that served something else is refused rather than
# compiled.
#
# The URL is where to look first, not what is trusted. A pin may name mirrors
# after it, tried in order when the one before could not be downloaded or did not
# have the pinned digest; each answer is held to the same digest, so a mirror adds
# a place to look and nothing else. An origin that was unreachable for an
# afternoon otherwise failed every CI job whose cache happened to miss.
archive() {
    name=$1 url=$2 digest=$3 suffix=${4:-.tar.gz} mirrors=${5:-}
    file="$ARCHIVES/$name$suffix"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi

    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name$suffix" ]; then
        cp "$SOURCE_DIR/$name$suffix" "$file.$$"
        verified "$file.$$" "$name" "$digest" || die "$refusal"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name$suffix is not cached; put the pinned archive in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name$suffix"
        fi
        fetch_verified "$file.$$" "$name" "$digest" "$url" $mirrors
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# Whether a download has the pinned digest, removing it and saying why when it
# does not. The refusal names both digests, so a stale pin reads differently from
# a bad download.
refusal=""
verified() {
    candidate=$1 label=$2 expected=$3
    found=$(sha256 "$candidate")
    [ "$found" = "$expected" ] && return 0
    rm -f "$candidate"
    refusal="$label has digest $found, expected $expected; refusing to cache or compile it"
    return 1
}

# The first of these URLs to answer with the pinned digest. Every failure is
# reported on the way past it, and the last one is what the build stops with.
fetch_verified() {
    destination=$1 label=$2 expected=$3
    shift 3
    refusal=""
    for candidate in "$@"; do
        [ -n "$refusal" ] && note "$refusal; trying $candidate"
        note "fetching $label"
        if ! download "$candidate" "$destination"; then
            rm -f "$destination"
            refusal="cannot download $candidate"
            continue
        fi
        verified "$destination" "$label" "$expected" && return 0
    done
    die "$refusal"
}

# One pinned file, verified. Not every source is an archive: a single-header
# library is a handful of loose files, and unpacking one would mean requiring an
# archive tool this does not otherwise need.
pinned_file() {
    name=$1 url=$2 digest=$3
    file="$ARCHIVES/$name"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi
    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$file.$$"
        verified "$file.$$" "$name" "$digest" || die "$refusal"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name is not cached; put the pinned file in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name"
        fi
        fetch_verified "$file.$$" "$name" "$digest" "$url"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One extracted source tree. Extraction is into a temporary sibling and renamed,
# so a killed run never leaves a half-unpacked tree a later one trusts.
source_tree() {
    name=$1 url=$2 digest=$3 marker=$4 suffix=${5:-.tar.gz} mirrors=${6:-}
    tree="$SOURCES/$name"
    if [ -f "$tree/$marker" ]; then
        printf '%s\n' "$tree"
        return 0
    fi

    file=$(archive "$name" "$url" "$digest" "$suffix" "$mirrors")
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$name.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    case "$suffix" in
        *.bz2) tar xjf "$file" -C "$staging" ;;
        *)     tar xzf "$file" -C "$staging" ;;
    esac
    [ -f "$staging/$name/$marker" ] \
        || die "$name$suffix did not extract the expected $name/$marker"
    rm -rf "$tree"
    mv "$staging/$name" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# --- the stage-zero compiler ------------------------------------------------

# The compiler that compiles this tree's Nupp before this tree has a compiler: a
# release's root CLI image, which a cold checkout runs on a runtime built from
# its own sources to lower them into a VM compiler (`scripts/vm-cli build
# --seed-image`). It is published as an asset of that release and fetched here
# the way every other pinned source is. Unlike LuaJIT it is neither built nor
# platform-specific, so it is cached by its own digest rather than under the
# compiler-pair key, and every worktree of every checkout on this machine that
# pins the same release shares the one copy. The pin says why the digest is of
# the decompressed file.
stage0_image() {
    [ -n "${STAGE0_IMAGE_SHA256:-}" ] || die "no VM stage-zero image is pinned in scripts/toolchain.pins"
    out="$CACHE/stage0-image/$STAGE0_IMAGE_SHA256"
    file="$out/compiler.image"
    if [ -f "$file" ]; then
        if [ "$(sha256 "$file")" = "$STAGE0_IMAGE_SHA256" ]; then
            native_path "$file"
            return 0
        fi
        note "the cached $STAGE0_IMAGE_TAG stage-zero image does not have the pinned digest; fetching it again"
        rm -f "$file"
    fi

    name="nupp-stage0-$STAGE0_IMAGE_TAG.image"
    mkdir -p "$CACHE/stage0-image"
    staged="$out.$$"
    rm -rf "$staged"
    mkdir -p "$staged"
    # shellcheck disable=SC2064
    trap "rm -rf '$staged'" EXIT HUP INT TERM
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$staged/compiler.image"
    elif [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name.gz" ]; then
        cp "$SOURCE_DIR/$name.gz" "$staged/compiler.image.gz"
        gunzip "$staged/compiler.image.gz" || die "$name.gz did not decompress"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and the $STAGE0_IMAGE_TAG stage-zero image is not cached; put $name.gz in NUPP_HOST_SOURCE_DIR"
    else
        url=$(expand_pin "$STAGE0_IMAGE_URL")
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name.gz"
        fi
        note "fetching the $STAGE0_IMAGE_TAG stage-zero image"
        download "$url" "$staged/compiler.image.gz" || die "cannot download $url"
        gunzip "$staged/compiler.image.gz" || die "$name.gz did not decompress"
    fi

    found=$(sha256 "$staged/compiler.image")
    if [ "$found" != "$STAGE0_IMAGE_SHA256" ]; then
        rm -rf "$staged"
        trap - EXIT HUP INT TERM
        die "the $STAGE0_IMAGE_TAG stage-zero image has digest $found, expected $STAGE0_IMAGE_SHA256; refusing to cache or run it"
    fi
    mkdir -p "$out"
    mv "$staged/compiler.image" "$file.$$"
    mv "$file.$$" "$file"
    rm -rf "$staged"
    trap - EXIT HUP INT TERM
    native_path "$file"
}

# --- notices ----------------------------------------------------------------

# Each of these is MIT, and MIT asks that its notice travel with the copies. The
# sources are fetched rather than committed, so the only copy this repository
# ships is the one in `host/notices` -- and a copy that has drifted from the
# source it claims to reproduce is a false statement about what was distributed.
# Bumping a pin fails here until the notice beside it is updated too.
verify_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    [ -f "$noticeSource" ] \
        || die "the pinned source has no $noticeSource to check $notice against"
    [ -f "$committed" ] || die "host/notices/$notice is missing"
    if ! cmp -s "$noticeSource" "$committed"; then
        die "host/notices/$notice is not what $noticeSource says any more. Copy it across: the pinned source is what is distributed, and the notice beside it is what says so."
    fi
}

# --- one build at a time ----------------------------------------------------

# Two commands wanting the same component start together often enough -- a test
# suite runs the launcher many times -- and they would otherwise be two makes
# writing one source tree. `mkdir` is the lock because it is atomic wherever
# this runs; the pid in it tells a held lock from one a killed build left.
LOCK=""
release_lock() { [ -n "$LOCK" ] && rm -rf "$LOCK"; LOCK=""; return 0; }

# Says that this run is waiting and on whom: once after a short grace, then
# once a minute. Waiting in silence read as a hang for as long as the other
# build took -- a quarter of an hour, several times over, with nothing to say
# why. Said on standard error whether or not it is a terminal: the runs that
# waited longest were a test suite's and an agent's, whose standard error is
# captured, and captured is exactly where a stall needs explaining. Callers
# read only standard output, so the answer they take is unchanged.
say_waiting() {
    [ "$3" -eq 3 ] || [ $(($3 % 60)) -eq 0 ] || return 0
    note "waiting for $1, which pid $2 is building (${3}s so far)"
}

take_lock() {
    lock="$CACHE/.lock-$1"
    waited=0
    mkdir -p "$CACHE"
    while ! mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        # A marker is sufficient for existing callers. Components whose
        # artifacts are separate from that marker also supply a readiness
        # command, so contention cannot turn an incomplete cache into success.
        if [ -f "$2" ]; then
            if [ "$#" -eq 2 ] || (shift 2; "$@"); then
                return 1
            fi
        fi
        sleep 1
        waited=$((waited + 1))
        say_waiting "$1" "$holder" "$waited"
        if [ "$waited" -ge 1800 ]; then
            note "another run has held $lock for ${waited}s; building without it"
            return 0
        fi
    done
    printf '%s\n' "$$" > "$lock/pid"
    LOCK=$lock
    trap 'release_lock' EXIT
    trap 'release_lock; exit 130' INT
    trap 'release_lock; exit 143' TERM
    return 0
}

# --- components -------------------------------------------------------------

# Rust is a deliberate native prerequisite, not another ambient implementation
# detail. The exact release in rust-toolchain.toml is accepted; a newer stable
# is not silently substituted, because compiler and Cargo versions participate
# in the artifact identity and can change code generation or feature solving.
select_rust_tools() {
    CARGO=${NUPP_CARGO:-cargo}
    RUSTC=${NUPP_RUSTC:-rustc}
    # A content-addressed compiler cache shared by every checkout and worktree on
    # the machine, when one is installed: parallel worktrees then compile each
    # dependency once. It changes no output, so it is not part of any cache key.
    if [ -z "${RUSTC_WRAPPER:-}" ] && command -v sccache >/dev/null 2>&1; then
        RUSTC_WRAPPER=sccache
        export RUSTC_WRAPPER
    fi
    # Asked for before reading it, so a tree without one is reported by the line
    # below rather than by `sed` naming a path on standard error. Every caller
    # here captures only standard output, so that stray line arrives wherever
    # the caller's own output was going.
    [ -f "$ROOT/rust-toolchain.toml" ] || die "rust-toolchain.toml is missing; nothing pins the Rust toolchain"
    expected=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' "$ROOT/rust-toolchain.toml")
    [ -n "$expected" ] || die "rust-toolchain.toml names no exact channel"
    rustup_toolchain=$expected
    [ "$PLATFORM" != windows ] \
        || rustup_toolchain="$expected-x86_64-pc-windows-$RUST_WINDOWS_ABI"
    rustup_which() {
        RUSTUP_TOOLCHAIN="$rustup_toolchain" RUSTUP_SKIP_UPDATE_CHECK=1 \
            rustup which "$1" 2>/dev/null
    }
    # The pinned toolchain is provisioned like every other pin: a machine
    # with rustup but not this channel gets it rather than a failure.
    if [ -z "${NUPP_CARGO:-}${NUPP_RUSTC:-}" ] && command -v rustup >/dev/null 2>&1 \
        && ! rustup_which cargo >/dev/null; then
        note "installing the pinned Rust toolchain $rustup_toolchain"
        rustup toolchain install "$rustup_toolchain" --profile minimal >&2 \
            || die "rustup could not install $rustup_toolchain"
    fi
    if [ -z "${NUPP_CARGO:-}" ] && command -v rustup >/dev/null 2>&1; then
        CARGO=$(rustup_which cargo || printf cargo)
    fi
    if [ -z "${NUPP_RUSTC:-}" ] && command -v rustup >/dev/null 2>&1; then
        RUSTC=$(rustup_which rustc || printf rustc)
    fi
    command -v "$CARGO" >/dev/null 2>&1 \
        || die "no Cargo found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_CARGO"
    command -v "$RUSTC" >/dev/null 2>&1 \
        || die "no rustc found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_RUSTC"

    # Resolve rustup's proxy once above, then execute the exact tool binary.
    # Running an ambient proxy here can synchronize a channel and mix its
    # progress into the version identity or select a different host ABI.
    cargo_version=$("$CARGO" --version) \
        || die "cannot run Cargo named by NUPP_CARGO"
    rustc_version=$("$RUSTC" --version) \
        || die "cannot run rustc named by NUPP_RUSTC"
    # A release reports its own number; a dated nightly reports the next
    # release's number with `-nightly` and its commit date, which is not the
    # channel's date, so the channel is what rustup selected above.
    case "$expected" in
        nightly-*)
            case "$cargo_version" in
                cargo\ *-nightly\ *) ;;
                *) die "Cargo is $cargo_version; rust-toolchain.toml requires cargo $expected" ;;
            esac
            case "$rustc_version" in
                rustc\ *-nightly\ *) ;;
                *) die "rustc is $rustc_version; rust-toolchain.toml requires rustc $expected" ;;
            esac
            ;;
        *)
            case "$cargo_version" in
                "cargo $expected "*) ;;
                *) die "Cargo is $cargo_version; rust-toolchain.toml requires cargo $expected" ;;
            esac
            case "$rustc_version" in
                "rustc $expected "*) ;;
                *) die "rustc is $rustc_version; rust-toolchain.toml requires rustc $expected" ;;
            esac
            ;;
    esac
    rustc_verbose=$("$RUSTC" -vV) \
        || die "cannot inspect rustc named by NUPP_RUSTC"
    rust_host=$(printf '%s\n' "$rustc_verbose" | sed -n 's/^host: //p')
    rust_commit=$(printf '%s\n' "$rustc_verbose" | sed -n 's/^commit-hash: //p')
    rust_sysroot=$("$RUSTC" --print sysroot) \
        || die "cannot locate the sysroot for rustc named by NUPP_RUSTC"
    if [ "$PLATFORM" = darwin ]; then
        rust_runtime="$rust_sysroot/lib"
        case ":${DYLD_FALLBACK_LIBRARY_PATH:-}:" in
            *":$rust_runtime:"*) ;;
            *)
                DYLD_FALLBACK_LIBRARY_PATH="$rust_runtime${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
                export DYLD_FALLBACK_LIBRARY_PATH
                ;;
        esac
    fi
    if [ "$PLATFORM" = windows ]; then
        case "$RUST_WINDOWS_ABI:$rust_host" in
            gnu:x86_64-pc-windows-gnu|gnullvm:x86_64-pc-windows-gnullvm) ;;
            *) die "Rust host $rust_host does not match NUPP_RUST_WINDOWS_ABI=$RUST_WINDOWS_ABI; install rustup toolchain $rustup_toolchain or name an equivalent toolchain" ;;
        esac
        case "$RUST_WINDOWS_ABI" in
            gnu)
                unset CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_LINKER
                export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$CC"
                ;;
            gnullvm)
                unset CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER
                export CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_LINKER="$CC"
                ;;
        esac
    fi
    RUST_TOOL_MATERIAL=$(printf '%s\n%s\n' "$cargo_version" "$rustc_verbose")
}

normalize_rust_features() {
    raw=${1:-}
    case "$raw" in
        *[!A-Za-z0-9_,-]*) die "invalid Rust feature list $raw" ;;
    esac
    features=$(printf '%s' "$raw" | tr ',' ' ')
    for feature in $features; do
        case "$feature" in
            *[!A-Za-z0-9_-]*) die "invalid Rust feature $feature" ;;
        esac
    done
    printf '%s\n' $features | sed '/^$/d' | LC_ALL=C sort -u \
        | tr '\n' ',' | sed 's/,$//'
}

rust_library_filename() {
    case "$PLATFORM" in
        darwin)  printf '%s\n' libnupp_native.dylib ;;
        windows) printf '%s\n' nupp_native.dll ;;
        *)       printf '%s\n' libnupp_native.so ;;
    esac
}

# Cargo accepts ambient knobs that materially alter a binary without changing
# its source or lock file. Keep supported codegen/profile overrides, and the
# C flags build scripts compile with, in the content key, and reject the
# implicit target override because the artifact path and platform filename
# below deliberately describe the host target.
rust_environment_material() {
    [ -z "${CARGO_BUILD_TARGET:-}" ] \
        || die "CARGO_BUILD_TARGET is unsupported; Rust host builds require an explicit toolchain target design"
    env | LC_ALL=C sort | sed -n \
        -e '/^RUSTFLAGS=/p' \
        -e '/^CARGO_ENCODED_RUSTFLAGS=/p' \
        -e '/^CARGO_PROFILE_/p' \
        -e '/^CARGO_TARGET_.*_RUSTFLAGS=/p' \
        -e '/^MACOSX_DEPLOYMENT_TARGET=/p' \
        -e '/^IPHONEOS_DEPLOYMENT_TARGET=/p' \
        -e '/^CFLAGS=/p' \
        -e '/^CFLAGS_/p' \
        -e '/^HOST_CFLAGS=/p' \
        -e '/^TARGET_CFLAGS=/p'
}

# Rust writes the path of every source a panic can be reported from into the
# binary: about 675 under the building user's CARGO_HOME, and about 122 under
# rustup's copy of the standard library, which rustc substitutes for the
# `/rustc/<commit>` path the release was built with whenever rust-src is
# installed. Both name a home directory, so two users' builds of one tree
# differed. The registry goes to `/cargo`, a vendor directory to `/vendor`, and
# the standard library back to the path the release itself records, so a build
# on a machine without rust-src is the same build.
#
# Through build.rustflags, so every crate in the graph is remapped rather than
# only the final one `cargo rustc --` reaches. What it maps from is left out of
# the artifact key on purpose: the point is that the answer does not depend on
# it. An ambient RUSTFLAGS replaces build.rustflags in Cargo, and is already
# part of the key.
rust_remap_arguments() {
    cargo_home=${CARGO_HOME:-$HOME/.cargo}
    vendor=${NUPP_RUST_VENDOR_DIR:-}
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cargo_home=$(cygpath -w "$cargo_home")
        [ -z "$vendor" ] || vendor=$(cygpath -w "$vendor")
    fi
    # Later mappings win in rustc, so the more specific ones go last.
    flags="$(toml_string "--remap-path-prefix=$cargo_home=/cargo")"
    [ -z "$vendor" ] || flags="$flags, $(toml_string "--remap-path-prefix=$vendor=/vendor")"
    [ -z "$rust_commit" ] || flags="$flags, $(toml_string \
        "--remap-path-prefix=$rust_sysroot/lib/rustlib/src/rust=/rustc/$rust_commit")"
    printf 'build.rustflags=[%s]\n' "$flags"
}

# A TOML basic string, for a value handed to `cargo --config`. Windows paths are
# full of backslashes, and a path may hold a quote.
toml_string() {
    printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

rust_vendor_arguments() {
    vendor=${NUPP_RUST_VENDOR_DIR:-}
    if [ -z "$vendor" ]; then
        offline && die "offline Rust builds require NUPP_RUST_VENDOR_DIR; provision it with scripts/toolchain rust-vendor OUTPUT"
        return 0
    fi
    [ -d "$vendor" ] || die "NUPP_RUST_VENDOR_DIR is not a directory: $vendor"
    printf '%s\n' \
        "source.crates-io.replace-with='nupp-vendored-sources'" \
        "source.nupp-vendored-sources.directory='$vendor'"
}

provision_rust_vendor() {
    destination=$1
    [ -n "$destination" ] || die "rust-vendor needs an output directory"
    [ ! -e "$destination" ] || die "rust-vendor refuses to replace $destination"
    select_rust_tools
    note "provisioning locked Rust sources in $destination"
    set -- "$CARGO" vendor --locked "$destination"
    offline && set -- "$@" --offline
    RUSTC="$RUSTC" "$@" >&2
}

# The runtime a VM program binary is stamped onto: the interpreter with linked
# entry support and native C calls, and of the facilities a program may reach
# (compression, net, http, regex, markdown, c-headers, the C declaration reader
# a compiler reaches, and jit, used by the Windows vector fallback) the ones it names. Every source
# state of one facility set shares a target directory, so an edit to the VM is
# an incremental rebuild rather than a cold one beside every earlier result;
# each result is copied out to its content key, which is the file a build reads.
build_rust_vm_runtime() {
    facilities=$(normalize_rust_features "${1:-}")
    for facility in $(printf '%s' "$facilities" | tr ',' ' '); do
        case "$facility" in
            compression|net|http|regex|markdown|jit|c-headers) ;;
            *) die "unknown VM runtime facility $facility" ;;
        esac
    done
    select_rust_tools
    # The execution core is built before this runtime is linked; Cargo's
    # machine tool never supplies an interpreter during bootstrap.
    core=$(python3 "$ROOT/scripts/vm-cli" runtime --reuse | tail -n 1) \
        || die "cannot build the Nupp execution core"
    [ -f "$core" ] || die "native core builder named no object"
    vm_features=aot-linked,native-ffi,native-runtime${facilities:+,$facilities}
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-vm-runtime "$vm_features" "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
        printf 'native-core %s\n' "$(sha256 "$core")"
    } | sha256_stdin | cut -c1-16)
    executable=nupp-vm
    [ "$PLATFORM" = windows ] && executable=nupp-vm.exe
    out="$RUST_BUILD_ROOT/vm-runtime/$digest"
    target="$RUST_BUILD_ROOT/vm-runtime/target-${facilities:-base}"
    RUST_VM_RUNTIME_OUT="$out/$executable"
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_RUNTIME_OUT" ] && return 0

    # One lock per target directory, because that is what two builds share.
    take_lock "rust-vm-runtime-$(printf '%s' "$target" | sha256_stdin | cut -c1-16)" "$out/.complete" \
        || return 0
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_RUNTIME_OUT" ] \
        && { release_lock; return 0; }

    note "building the VM program runtime with $RUSTC"
    set -- "$CARGO" build \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-vm \
        --bin nupp-vm \
        --release \
        --locked \
        --no-default-features \
        --features "$vm_features" \
        --target-dir "$(cargo_dir "$target")" \
        --config 'profile.release.lto="fat"' \
        --config 'profile.release.codegen-units=1' \
        --config 'profile.release.strip=true'
    offline && set -- "$@" --offline
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    set -- "$@" --config "$(rust_remap_arguments)"
    # A linked compiler object belongs to the compiler's runtime, never to a
    # program's: an object for one image refuses every other at startup.
    (unset NUPP_AOT_OBJECT; NUPP_NATIVE_RUNTIME_OBJECT="$core" CC="$CC" CXX="$CXX" RUSTC="$RUSTC" "$@" >&2) \
        || die "Cargo could not build the VM program runtime"
    built="$target/release/$executable"
    [ -f "$built" ] || die "Cargo built nupp-vm but did not write $built"
    mkdir -p "$out"
    cp "$built" "$out/$executable.partial" && mv "$out/$executable.partial" "$RUST_VM_RUNTIME_OUT" \
        || die "cannot stage the VM program runtime in $out"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# The object emitter a program with vector code is compiled by: `nupp-vm` with
# the code generator and its object writer. A build tool, never shipped, so it
# is built once per source state without the program runtime's LTO.
build_rust_vm_aot_tool() {
    select_rust_tools
    core=$(python3 "$ROOT/scripts/vm-cli" runtime --reuse | tail -n 1) \
        || die "cannot build the Nupp object core"
    [ -f "$core" ] || die "native core builder named no object"
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s\n' nupp-vm-aot-tool "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
        printf 'native-core %s\n' "$(sha256 "$core")"
    } | sha256_stdin | cut -c1-16)
    executable=nupp-vm
    [ "$PLATFORM" = windows ] && executable=nupp-vm.exe
    out="$RUST_BUILD_ROOT/vm-aot-tool/$digest"
    target="$RUST_BUILD_ROOT/vm-aot-tool/target"
    RUST_VM_AOT_TOOL_OUT="$out/$executable"
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_AOT_TOOL_OUT" ] && return 0
    take_lock "rust-vm-aot-tool" "$out/.complete" test -f "$RUST_VM_AOT_TOOL_OUT" || return 0
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_AOT_TOOL_OUT" ] && { release_lock; return 0; }
    note "building the VM object emitter with $RUSTC"
    set -- "$CARGO" build --manifest-path "$ROOT/Cargo.toml" --package nupp-vm --bin nupp-vm \
        --release --locked --features aot,native-runtime --target-dir "$(cargo_dir "$target")"
    offline && set -- "$@" --offline
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    (unset NUPP_AOT_OBJECT; NUPP_NATIVE_RUNTIME_OBJECT="$core" CC="$CC" CXX="$CXX" RUSTC="$RUSTC" "$@" >&2) \
        || die "Cargo could not build the VM object emitter"
    mkdir -p "$out"
    cp "$target/release/$executable" "$out/$executable.partial" \
        && mv "$out/$executable.partial" "$RUST_VM_AOT_TOOL_OUT" \
        || die "cannot stage the VM object emitter in $out"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# The runner as a static archive (`native/crates/vm-program`) with the
# facilities a program names, and the native libraries its final link needs.
# Built once per facility set and source state, with the program runtime's
# LTO, so a program's own link is the archive and its object.
vm_program_archive_ready() {
    [ -f "$RUST_VM_PROGRAM_ARCHIVE" ] && [ -s "$RUST_VM_PROGRAM_LIBRARIES" ]
}

build_rust_vm_program_archive() {
    facilities=$1
    select_rust_tools
    core=$(python3 "$ROOT/scripts/vm-cli" runtime --reuse | tail -n 1) \
        || die "cannot build the Nupp execution core"
    [ -f "$core" ] || die "native core builder named no object"
    features=native-ffi,native-runtime${facilities:+,$facilities}
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-vm-program "$features" "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
        printf 'native-core %s\n' "$(sha256 "$core")"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/vm-program/$digest"
    target="$RUST_BUILD_ROOT/vm-program/target-${facilities:-base}"
    RUST_VM_PROGRAM_ARCHIVE="$out/libnupp_vm_program.a"
    RUST_VM_PROGRAM_LIBRARIES="$out/link-libraries"
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_PROGRAM_ARCHIVE" ] && [ -s "$RUST_VM_PROGRAM_LIBRARIES" ] && return 0
    take_lock "rust-vm-program-$(printf '%s' "$target" | sha256_stdin | cut -c1-16)" "$out/.complete" vm_program_archive_ready \
        || return 0
    [ -f "$out/.complete" ] && [ -f "$RUST_VM_PROGRAM_ARCHIVE" ] && [ -s "$RUST_VM_PROGRAM_LIBRARIES" ] && { release_lock; return 0; }
    note "building the VM program archive with $RUSTC"
    # A source/environment key also names rustc's metadata, so the archive
    # emits its library list without deleting Cargo fingerprint state.
    set -- "$CARGO" rustc --manifest-path "$ROOT/Cargo.toml" --package nupp-vm-program --lib \
        --release --locked --no-default-features --features "aot-linked,compiled-runtime,$features" \
        --target-dir "$(cargo_dir "$target")" \
        --config 'profile.release.lto="fat"' \
        --config 'profile.release.codegen-units=1'
    offline && set -- "$@" --offline
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    set -- "$@" --config "$(rust_remap_arguments)" -- -C "metadata=$digest" --print native-static-libs
    mkdir -p "$out"
    (unset NUPP_AOT_OBJECT; NUPP_NATIVE_RUNTIME_OBJECT="$core" CC="$CC" CXX="$CXX" RUSTC="$RUSTC" "$@" 2>"$out/cargo.log") \
        || { cat "$out/cargo.log" >&2; die "Cargo could not build the VM program archive"; }
    libraries=$(sed -n 's/.*native-static-libs: //p' "$out/cargo.log" | tail -n 1)
    [ -n "$libraries" ] || die "rustc did not name the VM program archive's native libraries"
    printf '%s\n' "$libraries" > "$RUST_VM_PROGRAM_LIBRARIES"
    cp "$target/release/libnupp_vm_program.a" "$RUST_VM_PROGRAM_ARCHIVE.partial" \
        && mv "$RUST_VM_PROGRAM_ARCHIVE.partial" "$RUST_VM_PROGRAM_ARCHIVE" \
        || die "cannot stage the VM program archive in $out"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# The runtime of one program with vector code: the functions holding vector
# instructions, which only run compiled, compiled ahead of time into an object
# and linked with the program archive, so the binary carries no code generator
# and allocates no executable memory. Everything else stays on the
# interpreter: compiling it too made the compiler's own binary 155 MB larger
# to run it a fifth faster. PAYLOAD is the program payload (entry module,
# newline, image); the object is built for exactly that image, which the
# runtime checks at startup. Windows links the code generator instead until
# its link line is validated.
build_vm_program() {
    facilities=$(normalize_rust_features "${1:-}")
    payload=${2:-}
    [ -f "$payload" ] || die "usage: scripts/toolchain vm-program FACILITIES PAYLOAD"
    for facility in $(printf '%s' "$facilities" | tr ',' ' '); do
        case "$facility" in
            compression|net|http|regex|markdown|c-headers) ;;
            *) die "unknown VM program facility $facility" ;;
        esac
    done
    if [ "$PLATFORM" = windows ]; then
        build_rust_vm_runtime "${facilities:+$facilities,}jit"
        VM_PROGRAM_OUT=$RUST_VM_RUNTIME_OUT
        return 0
    fi
    RUST_SOURCES_DIGEST=$(rust_sources_digest)
    build_rust_vm_aot_tool
    build_rust_vm_program_archive "$facilities"
    image_digest=$(tail -n +2 "$payload" | sha256_stdin)
    digest=$(printf '%s|%s|%s|%s\n' "$image_digest" "$RUST_VM_PROGRAM_ARCHIVE" "$RUST_VM_AOT_TOOL_OUT" "$KEY" \
        | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/vm-program/programs/$digest"
    VM_PROGRAM_OUT="$out/nupp-vm"
    [ -f "$out/.complete" ] && [ -f "$VM_PROGRAM_OUT" ] && return 0
    take_lock "vm-program-$digest" "$out/.complete" test -f "$VM_PROGRAM_OUT" || return 0
    [ -f "$out/.complete" ] && [ -f "$VM_PROGRAM_OUT" ] && { release_lock; return 0; }
    mkdir -p "$(dirname "$out")"
    work=$(mktemp -d "$out.work.XXXXXX") || die "cannot create program link workspace"
    tail -n +2 "$payload" > "$work/program.image"
    "$RUST_VM_AOT_TOOL_OUT" aot "$work/program.image" "$work/program.o" --frames --vector-only 2>"$work/emit.log" \
        || { cat "$work/emit.log" >&2; die "cannot compile the program's functions ahead of time"; }
    "$CC" -c "$ROOT/native/crates/vm-program/src/main.c" -o "$work/main.o" \
        || die "cannot compile the program entry"
    case "$PLATFORM" in
        darwin) strip_unused=-Wl,-dead_strip ;;
        *) strip_unused=-Wl,--gc-sections ;;
    esac
    # shellcheck disable=SC2046 # rustc's library list is words for the linker.
    "$CC" "$strip_unused" "$work/main.o" "$work/program.o" "$core" "$RUST_VM_PROGRAM_ARCHIVE" \
        $(cat "$RUST_VM_PROGRAM_LIBRARIES") -o "$work/nupp-vm" 2>"$work/link.log" \
        || { cat "$work/link.log" >&2; die "cannot link the program runtime"; }
    strip "$work/nupp-vm" || die "cannot strip the program runtime"
    mkdir -p "$out"
    mv "$work/nupp-vm" "$VM_PROGRAM_OUT" || die "cannot stage the program runtime in $out"
    # Preserve the exact image/object/maps and logs beside this completed link.
    printf 'done\n' > "$out/.complete"
    release_lock
}

# The receipt the install leaves beside the interpreter. `scripts/luajit.sh`
# reads the same one to decide whether a LuaJIT on the PATH is this one.
luajit_receipt() {
    cksum < "$ROOT/scripts/patches/luajit.patch"
    cksum < "$1/bin/luajit"
}

# Finished and still what was installed. The marker alone was believed, so an
# interpreter damaged afterwards was handed to every command, which the kernel
# then killed before it printed anything.
luajit_intact() {
    [ -f "$1/.complete" ] && [ -f "$1/.nupp-runtime-patch" ] || return 1
    [ "$(luajit_receipt "$1" 2>/dev/null)" = "$(cat "$1/.nupp-runtime-patch")" ]
}

build_luajit() {
    out="$PREFIX/luajit"
    take_lock luajit "$out/.complete" || return 0
    luajit_intact "$out" && { release_lock; return 0; }
    [ -f "$out/.complete" ] && note "the cached LuaJIT is not what was installed; building it again"

    directory=$(expand_pin "$LUAJIT_DIRECTORY")
    url=$(expand_pin "$LUAJIT_URL")
    luajit_source=$(source_tree "$directory" "$url" "$LUAJIT_SHA256" "$LUAJIT_MARKER")
    verify_notice "$luajit_source/COPYRIGHT" LuaJIT-COPYRIGHT.txt

    # Shared verified sources are immutable inputs. Patch and compile a fresh
    # private copy, so another compiler key cannot observe either change.
    luajit_build="$PREFIX/.luajit-source"
    rm -rf "$luajit_build"
    mkdir -p "$luajit_build"
    cp -R "$luajit_source/." "$luajit_build/"
    patch -f -p1 -d "$luajit_build" < "$ROOT/scripts/patches/luajit.patch" >&2
    tree=$luajit_build

    note "building LuaJIT with $CC"
    rm -rf "$out"
    # LuaJIT bakes its module search paths in at compile time, so the prefix has
    # to be the one it is installed under rather than one it is copied to. It
    # also refuses to guess an Apple deployment target, preferring to stop over
    # producing something that runs here and nowhere else.
    if [ "$PLATFORM" = darwin ] && [ -z "${MACOSX_DEPLOYMENT_TARGET:-}" ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) MACOSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      MACOSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
        export MACOSX_DEPLOYMENT_TARGET
    fi
    "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
    "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
    "$MAKE" -C "$tree" PREFIX="$out" install >&2

    # LuaJIT's top-level install recipe only knows the Unix artifact names.
    # Its Windows build is deliberately dynamic so C modules bind to the same
    # VM as the interpreter, but that leaves lua51.dll and its import library
    # in the source tree. Stage both, then make the static archive separately:
    # standalone Nupp hosts carry their VM and cannot depend on a sibling DLL.
    if [ "$PLATFORM" = windows ]; then
        [ -f "$tree/src/lua51.dll" ] \
            || die "LuaJIT's Windows build produced no lua51.dll"
        [ -f "$tree/src/libluajit-5.1.dll.a" ] \
            || die "LuaJIT's Windows build produced no import library"
        cp "$tree/src/lua51.dll" "$out/bin/lua51.dll"
        cp "$tree/src/luajit.exe" "$out/bin/luajit.exe"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/libluajit-5.1.dll.a"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/liblua51.a"

        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" \
            XCFLAGS=-fPIC BUILDMODE=static >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's Windows static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"

        # The same Unix-only install recipe leaves the interpreter's own Lua
        # modules behind. `jit.vmdef` is what the bytecode reader loads and
        # `jit.zone` is what the profiler does, so without them every question
        # about a trace answered "module not found" rather than answering.
        #
        # Beside the executable, because that is where this interpreter looks:
        # the Unix build compiles in a prefix and finds `share/luajit-2.1`, and
        # the Windows one searches `<exedir>\lua\?.lua`. Staged under the
        # prefix as well, for anything reading the tree rather than running it.
        for jit_dir in "$out/bin/lua/jit" "$out/share/luajit-2.1/jit"; do
            mkdir -p "$jit_dir"
            cp "$tree/src/jit/"*.lua "$jit_dir/"
            [ -f "$jit_dir/vmdef.lua" ] \
                || die "LuaJIT's Windows build staged no jit/vmdef.lua"
        done
    else
        # The prefix baked in above is for this interpreter. The static archive
        # is what a host carries into every stamped binary, where the prefix
        # named this machine's cache in package.path -- a directory no user of
        # a released nupp has, and different bytes from every other checkout.
        # Build the archive with LuaJIT's stock paths instead; the host preloads
        # the jit.* modules it needs.
        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX=/usr/local CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"
    fi

    # `luajit` itself is a versioned name plus a symlink upstream only makes on
    # some platforms, and everything here runs the plain one.
    if [ ! -x "$out/bin/luajit" ]; then
        for candidate in "$out"/bin/luajit-*; do
            [ -x "$candidate" ] || continue
            ln -sf "$(basename "$candidate")" "$out/bin/luajit"
            break
        done
    fi
    [ -x "$out/bin/luajit" ] || die "LuaJIT installed no interpreter under $out/bin"

    # Where the headers landed, which is a versioned directory, said once here so
    # nothing downstream has to know the version.
    include=$(find "$out/include" -maxdepth 1 -type d -name 'luajit-*' | head -n 1)
    [ -n "$include" ] || include="$out/include"
    native_path "$include" > "$out/.include"
    luajit_receipt "$out" > "$out/.nupp-runtime-patch"
    rm -rf "$luajit_build"
    printf 'done\n' > "$out/.complete"
    release_lock
}

luajit_include() {
    build_luajit
    cat "$PREFIX/luajit/.include"
}

build_luarocks() {
    out="$PREFIX/luarocks"
    luajit=$(build_luajit; printf '%s' "$PREFIX/luajit")
    include=$(cat "$luajit/.include")
    take_lock luarocks "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory=$(expand_pin "$LUAROCKS_DIRECTORY")
    url=$(expand_pin "$LUAROCKS_URL")
    tree=$(source_tree "$directory" "$url" "$LUAROCKS_SHA256" "$LUAROCKS_MARKER")

    note "installing LuaRocks"
    rm -rf "$out"
    if [ "$PLATFORM" = windows ]; then
        outWindows=$(cygpath -w "$out")
        rocksWindows=$(cygpath -w "$ROOT/.rocks")
        binWindows=$(cygpath -w "$luajit/bin")
        includeWindows=$(cygpath -w "$include")
        libWindows=$(cygpath -w "$luajit/lib")
        # Git Bash otherwise rewrites switches such as /P and /TREE as paths
        # before the batch installer sees them.
        (cd "$tree" && MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c call install.bat \
            /P "$outWindows" /TREE "$rocksWindows" \
            /LV 5.1 /INC "$includeWindows" /LIB "$libWindows" \
            /BIN "$binWindows" /MW /Q /F /NOREG /NOADMIN \
            /FORCECONFIG) >&2
    else
        (cd "$tree" && ./configure \
            --prefix="$out" \
            --rocks-tree="$ROOT/.rocks" \
            --lua-version=5.1 \
            --with-lua-bin="$luajit/bin" \
            --with-lua-include="$include" \
            --with-lua-lib="$luajit/lib" \
            --with-lua-interpreter=luajit \
            --force-config && "$MAKE" install) >&2
        if [ "$PLATFORM" = darwin ]; then
            # LuaRocks takes the first 32 hex characters from the checker's
            # output. OpenSSL prints the filename first, so commit-hash archive
            # names are mistaken for their digest. BSD md5's quiet form prints
            # only the digest, regardless of the filename.
            cat >> "$out/etc/luarocks/config-5.1.lua" <<'EOF'
variables = variables or {}
variables.MD5SUM = "/sbin/md5 -q"
EOF
        fi
    fi
    case "$PLATFORM" in
        windows) executable="$out/luarocks.bat" ;;
        *) executable="$out/bin/luarocks" ;;
    esac
    [ -f "$executable" ] || die "LuaRocks installed no executable under $out"
    native_path "$executable" > "$out/.executable"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# --- Release archives ---------------------------------------------------------

# A gzip'd POSIX tar of a directory's files whose bytes are a function of
# their names and contents alone. A rebuild of a tag reproduces the digest its
# release published, and tar otherwise writes the building user's name, the
# build's clock and its umask into each header.
deterministic_archive() {
    archive_source=$1
    archive_output=$2
    archive_staging=$(mktemp -d "${TMPDIR:-/tmp}/nupp-archive.XXXXXX") || return 1
    cp -R "$archive_source/." "$archive_staging/" || { rm -rf "$archive_staging"; return 1; }
    rm -f "$archive_staging/.complete"
    chmod -R u+rwX,go+rX,go-w "$archive_staging"
    find "$archive_staging" -exec env TZ=UTC touch -h -t 198001010000 {} +
    case "$(tar --version 2>/dev/null)" in
        *GNU*) archive_owner="--owner=0 --group=0 --numeric-owner" ;;
        *) archive_owner="--uid 0 --gid 0 --numeric-owner" ;;
    esac
    # shellcheck disable=SC2086 # the owner options are separate words
    (cd "$archive_staging" && find . -type f | LC_ALL=C sort | sed 's|^\./||' \
        | COPYFILE_DISABLE=1 tar --format ustar $archive_owner -cf - -T - \
        | gzip -9n > "$archive_output")
    archive_status=$?
    rm -rf "$archive_staging"
    return $archive_status
}

# --- entry ------------------------------------------------------------------

[ "$#" -ge 1 ] || usage

case "$1" in
    --prefix) native_path "$PREFIX"; exit 0 ;;
    --all)
        build_luajit
        build_luarocks
        # A checkout with no compiler needs this before it can build one, and a
        # warm is the moment to pay for it: an ordinary command in a built tree
        # never asks.
        stage0_image >/dev/null
        exit 0
        ;;
    rust-vendor)
        provision_rust_vendor "${2:-}"
        native_path "${2:-}"
        exit 0
        ;;
    vm-runtime)
        build_rust_vm_runtime "${2:-}"
        native_path "$RUST_VM_RUNTIME_OUT"
        exit 0
        ;;
    vm-program)
        build_vm_program "${2:-}" "${3:-}"
        native_path "$VM_PROGRAM_OUT"
        exit 0
        ;;
    archive)
        # Any directory as a release carries it, so a rebuild of a tag
        # reproduces the digest its release published.
        [ "$#" -eq 3 ] && [ -d "$2" ] || die "usage: scripts/toolchain archive DIRECTORY OUTPUT"
        output=$(cd "$(dirname "$3")" && pwd)/$(basename "$3")
        deterministic_archive "$2" "$output" || die "cannot archive $2"
        native_path "$output"
        exit 0
        ;;
    -h|--help) usage ;;
esac

for component in "$@"; do
    case "$component" in
        luajit)   build_luajit;   native_path "$PREFIX/luajit" ;;
        luarocks) build_luarocks; native_path "$PREFIX/luarocks" ;;
        stage0-image) stage0_image ;;
        stage0-seed) python3 "$ROOT/scripts/bootstrap-seed" fetch --cache "$CACHE" ;;
        *) note "unknown component $component"; usage ;;
    esac
done
