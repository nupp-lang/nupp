#!/bin/sh
# Provisions the native prerequisites Nupp builds against.
#
# Nupp asks for a C and a C++ compiler. Everything else it needs to build itself
# -- the LuaJIT the compiler runs on and the LPeg the documentation renderer
# parses with -- is fetched here from a pinned source, verified against a digest,
# built with that compiler pair, and cached.
#
# This is the only thing that builds those. A component is asked for by name and
# answers with the prefix it was installed under, so a caller composes paths
# rather than knowing the layout:
#
#     scripts/toolchain luajit          # -> /path/to/.nupp-cache/toolchain/<key>/luajit
#     scripts/toolchain --all           # everything, quietly, for a cache warm
#
# Building is idempotent and cached: the second call is a directory test. The
# cache is keyed by the compilers' own version output, so switching NUPP_CC from
# clang to gcc builds beside the old answer rather than over it.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT/scripts/toolchain.pins"

# Names shared with the archive fetching the host build already had, so a CI job
# or an offline builder that supplies pinned archives keeps working unchanged.
SOURCE_DIR=${NUPP_HOST_SOURCE_DIR:-}
SOURCE_BASE_URL=${NUPP_HOST_SOURCE_BASE_URL:-}
OFFLINE=${NUPP_HOST_OFFLINE:-}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/toolchain COMPONENT...
       scripts/toolchain --all
       scripts/toolchain --prefix

Components: luajit luarocks lpeg lpeg-source stage0 llvm
            browser-sources browser-emulator browser-guest
            native-rust FEATURES
            rust-vendor OUTPUT
            host FEATURES, host-rust, host-library FEATURES
            host-link FEATURES OUTPUT ARCHIVE... -- LINK_FLAG...
            kit FEATURES, kit-archive FEATURES OUTPUT

Prints the install prefix of each component named, building it first when it is
not already cached. --all builds every component and prints nothing. --prefix
prints the root the components are installed under without building anything.

Environment:
  NUPP_CC, NUPP_CXX          the compiler pair. Probed when unset.
  NUPP_CARGO, NUPP_RUSTC     the pinned Rust toolchain. Probed when unset.
  NUPP_RUST_WINDOWS_ABI      GNU (default) or gnullvm for LLVM-MinGW.
  NUPP_TOOLCHAIN_DIR         where to install. Defaults to the repository cache.
  NUPP_RUST_BUILD_DIR        Rust outputs. Defaults to build/rust.
  NUPP_RUST_VENDOR_DIR       cargo-vendor directory required by offline Rust builds.
  NUPP_HOST_SOURCE_DIR       a directory of already-downloaded pinned archives.
  NUPP_HOST_SOURCE_BASE_URL  a flat mirror to fetch archives from.
  NUPP_HOST_OFFLINE          refuse to reach the network.
  NUPP_LLVM_PREFIX           an existing build of the pinned LLVM to use as is.

`llvm --available` prints the pinned LLVM's prefix if it is already built (or
named by NUPP_LLVM_PREFIX) and exits 1 otherwise, building nothing.
USAGE
    exit 2
}

note() { printf 'toolchain: %s\n' "$*" >&2; }
die() { printf 'toolchain: %s\n' "$*" >&2; exit 1; }

# --- toolchain selection ----------------------------------------------------

# `NUPP_NATIVE_CC` named the C compiler before the toolchain names were unified.
# It remains an alias and is read only where the primary name is unset.
probe() {
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

UNAME=$(uname -s 2>/dev/null || echo unknown)
case "$UNAME" in
    Darwin*)              PLATFORM=darwin ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
    FreeBSD*|DragonFly*)  PLATFORM=bsd ;;
    *)                    PLATFORM=posix ;;
esac

CC=${NUPP_CC:-${NUPP_NATIVE_CC:-}}
CXX=${NUPP_CXX:-}
case "$PLATFORM" in
    # This driver uses the dependencies' GNU make builds. The hosted Windows
    # clang targets MSVC, where LuaJIT's makefile asks its linker for Unix
    # libraries such as `-lm`; the MinGW pair is the compatible default.
    windows)
        [ -n "$CC" ] || CC=$(probe gcc cc clang) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe g++ c++ clang++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
    *)
        [ -n "$CC" ] || CC=$(probe clang cc gcc) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe clang++ c++ g++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
esac

RUST_WINDOWS_ABI=${NUPP_RUST_WINDOWS_ABI:-gnu}
case "$RUST_WINDOWS_ABI" in
    gnu) ;;
    gnullvm)
        [ "$PLATFORM" = windows ] \
            || die "NUPP_RUST_WINDOWS_ABI=gnullvm is only supported on Windows"
        ;;
    *) die "NUPP_RUST_WINDOWS_ABI must be gnu or gnullvm" ;;
esac

command -v "$CC" >/dev/null 2>&1 || die "NUPP_CC names $CC, which is not on PATH"
command -v "$CXX" >/dev/null 2>&1 || die "NUPP_CXX names $CXX, which is not on PATH"

case "$PLATFORM" in
    bsd) MAKE=${MAKE:-gmake} ;;
    *)   MAKE=${MAKE:-make} ;;
esac

# Paths printed to a caller can leave the MSYS shell and be handed directly to
# a native Windows process. Give those consumers the drive-letter spelling;
# Git Bash accepts it too. Tests that emulate Windows on another host have no
# cygpath and keep their host spelling.
native_path() {
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s\n' "$1"
    fi
}

# --- digests ----------------------------------------------------------------

# Whichever of these the machine has. All three answer the same question and no
# platform reliably carries a particular one.
if command -v shasum >/dev/null 2>&1; then
    sha256_stdin() { shasum -a 256 | cut -d' ' -f1; }
elif command -v sha256sum >/dev/null 2>&1; then
    sha256_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
    sha256_stdin() { openssl dgst -sha256 | sed 's/.*= *//'; }
else
    die "no sha256 tool found; install one of shasum, sha256sum or openssl"
fi
sha256() { sha256_stdin < "$1"; }

# The pins that decide a native artifact, which is every pin but the stage-zero
# one. That one names a Nupp release and a bundle of Lua; no C compiler ever
# sees it, and keying LuaJIT, LPeg and every Rust crate on it would make the
# one-line pin bump a stage-zero move asks for a from-scratch native rebuild on
# machine that pulls it. Assignments only, so a comment is documentation rather
# than a cache generation.
pins_digest() {
    grep '^[A-Z][A-Z0-9_]*=' "$ROOT/scripts/toolchain.pins" \
        | grep -v -e '^STAGE0_' -e '^BROWSER_' -e '^LLVM_' | sha256_stdin
}

# Public embedding headers are staged beside the Rust libraries rather than
# compiled into them. Give those staged SDKs their own content key so changing
# the public ABI refreshes the SDK without needlessly rebuilding a Rust crate.
embedding_headers_digest() {
    (cd "$ROOT" && find host/include -type f -name '*.h' 2>/dev/null) \
        | LC_ALL=C sort | while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done | sha256_stdin | cut -c1-16
}

# Rust inputs have their own content key. Keeping this separate from the public
# headers means editing a header only restages the SDK, while every workspace or
# lock-file change rebuilds the Rust artifact.
rust_sources_digest() {
    {
        # `scripts/toolchain.pins` is not in this list because it is folded in
        # below through `pins_digest`, which leaves out the stage-zero pin.
        for file in Cargo.toml Cargo.lock rust-toolchain.toml .cargo/config.toml \
            scripts/toolchain scripts/patches/luajit-irt-size.patch; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
        (cd "$ROOT" && find native/crates -type f \
            \( -name '*.rs' -o -name '*.c' -o -name '*.h' \
                -o -name 'Cargo.toml' -o -name 'build.rs' \) \
            2>/dev/null) || true
    } | LC_ALL=C sort | {
        while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done
        printf 'scripts/toolchain.pins %s\n' "$(pins_digest)"
    } | sha256_stdin | cut -c1-16
}
# --- where things go --------------------------------------------------------

# Beside the repository's common git directory, so every worktree of this
# checkout shares one build of LuaJIT rather than each paying for its own. A
# source archive with no git metadata falls back to the checkout.
if [ -n "${NUPP_TOOLCHAIN_DIR:-}" ]; then
    CACHE=$NUPP_TOOLCHAIN_DIR
else
    COMMON=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$COMMON" ]; then
        case "$COMMON" in
            /*|[A-Za-z]:*) ;;
            *) COMMON="$ROOT/$COMMON" ;;
        esac
        CACHE="$(dirname "$COMMON")/.nupp-cache/toolchain"
    else
        CACHE="$ROOT/build/toolchain"
    fi
fi

ARCHIVES="$CACHE/archives"
SOURCES="$CACHE/sources"

# What the answer depends on: the compilers, their versions, the machine, and
# these provisioning rules. Several change without a native source changing;
# ignoring one can return an artifact built with another compiler or link line.
key_material() {
    printf '%s\n%s\n' "$CC" "$CXX"
    "$CC" --version 2>&1 | head -n 2 || true
    "$CXX" --version 2>&1 | head -n 2 || true
    printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    sha256 "$ROOT/scripts/toolchain"
    sha256 "$ROOT/scripts/patches/luajit-irt-size.patch"
    pins_digest
}
KEY=$(key_material | sha256_stdin | cut -c1-16)
PREFIX="$CACHE/$KEY"
RUST_BUILD_ROOT=${NUPP_RUST_BUILD_DIR:-"$ROOT/build/rust"}

# --- fetching ---------------------------------------------------------------

download() {
    url=$1 destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet --output-document "$destination" "$url"
    else
        die "no downloader found; install curl or wget"
    fi
}

offline() {
    case "$OFFLINE" in
        1|true|yes|on|TRUE|YES|ON) return 0 ;;
        ""|0|false|no|off|FALSE|NO|OFF) return 1 ;;
        *) die "NUPP_HOST_OFFLINE must be one of 1, true, yes, on, 0, false, no or off" ;;
    esac
}

# One pinned archive, in the cache, verified. A digest is checked before a byte
# is unpacked, so a mirror that served something else is refused rather than
# compiled.
archive() {
    name=$1 url=$2 digest=$3 suffix=${4:-.tar.gz}
    file="$ARCHIVES/$name$suffix"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi

    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name$suffix" ]; then
        cp "$SOURCE_DIR/$name$suffix" "$file.$$"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name$suffix is not cached; put the pinned archive in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name$suffix"
        fi
        note "fetching $name"
        download "$url" "$file.$$" || { rm -f "$file.$$"; die "cannot download $url"; }
    fi

    found=$(sha256 "$file.$$")
    if [ "$found" != "$digest" ]; then
        rm -f "$file.$$"
        die "$name has digest $found, expected $digest; refusing to cache or compile it"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One pinned file, verified. Not every source is an archive: a single-header
# library is a handful of loose files, and unpacking one would mean requiring an
# archive tool this does not otherwise need.
pinned_file() {
    name=$1 url=$2 digest=$3
    file="$ARCHIVES/$name"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi
    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$file.$$"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name is not cached; put the pinned file in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name"
        fi
        note "fetching $name"
        download "$url" "$file.$$" || { rm -f "$file.$$"; die "cannot download $url"; }
    fi
    found=$(sha256 "$file.$$")
    if [ "$found" != "$digest" ]; then
        rm -f "$file.$$"
        die "$name has digest $found, expected $digest; refusing to cache or compile it"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One extracted source tree. Extraction is into a temporary sibling and renamed,
# so a killed run never leaves a half-unpacked tree a later one trusts.
source_tree() {
    name=$1 url=$2 digest=$3 marker=$4 suffix=${5:-.tar.gz}
    tree="$SOURCES/$name"
    if [ -f "$tree/$marker" ]; then
        printf '%s\n' "$tree"
        return 0
    fi

    file=$(archive "$name" "$url" "$digest" "$suffix")
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$name.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    case "$suffix" in
        *.bz2) tar xjf "$file" -C "$staging" ;;
        *)     tar xzf "$file" -C "$staging" ;;
    esac
    [ -f "$staging/$name/$marker" ] \
        || die "$name$suffix did not extract the expected $name/$marker"
    rm -rf "$tree"
    mv "$staging/$name" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# --- the stage-zero compiler ------------------------------------------------

# The compiler that compiles this tree's Nupp before this tree has a compiler.
#
# It is the previous release's own compiler, lowered to one Lua file and
# published as an asset of that release, and it is fetched here the way every
# other pinned source is. What makes it different from LuaJIT or LPeg is that it
# is neither built nor platform-specific: one file of Lua, good on every machine
# that has a LuaJIT new enough to parse generated Nupp, which the pins above
# already guarantee. So it is cached by its own digest rather than under the
# compiler-pair key, and every worktree of every checkout on this machine that
# pins the same release shares the one copy.
#
# This is fetched rather than committed, and the pin says why the digest is of
# the decompressed file.
stage0_runtime() {
    stage0_verified_file=$1
    stage0_runtime_root="$ROOT/build/stage0/$STAGE0_SHA256"
    stage0_runtime_digest=$(sha256 "$ROOT/scripts/stage0-runtime.lua")
    stage0_runtime_file="$stage0_runtime_root/nupp-$stage0_runtime_digest.lua"
    stage0_verified_copy="$stage0_runtime_root/verified.lua"
    build_luajit
    mkdir -p "$stage0_runtime_root/scripts" "$stage0_runtime_root/bin"
    [ -f "$stage0_verified_copy" ] || cp "$stage0_verified_file" "$stage0_verified_copy"
    stage0_driver=$(printf '%s' "$ROOT/scripts/toolchain" | sed "s/'/'\\\\''/g")
    printf '#!/bin/sh\nexec '\''%s'\'' "$@"\n' "$stage0_driver" > "$stage0_runtime_root/scripts/toolchain"
    chmod +x "$stage0_runtime_root/scripts/toolchain"
    stage0_entry=$(printf '%s' "$stage0_runtime_file" | sed "s/'/'\\\\''/g")
    printf '#!/bin/sh\nexec luajit '\''%s'\'' "$@"\n' "$stage0_entry" > "$stage0_runtime_root/bin/nupp"
    chmod +x "$stage0_runtime_root/bin/nupp"
    stage0_runtime_stamp="$stage0_runtime_root/.runtime-$stage0_runtime_digest.complete"
    take_lock "stage0-runtime-$STAGE0_SHA256" "$stage0_runtime_stamp" || return 0
    "$PREFIX/luajit/bin/luajit" \
        "$(native_path "$ROOT/scripts/stage0-runtime.lua")" \
        "$(native_path "$stage0_verified_file")" \
        "$(native_path "$stage0_runtime_file")" \
        "$(native_path "$stage0_runtime_root")" \
        "$(native_path "$stage0_runtime_stamp")"
    release_lock
}

stage0() {
    out="$CACHE/stage0/$STAGE0_SHA256"
    file="$out/nupp.lua"
    if [ -f "$file" ]; then
        stage0_runtime "$file"
        native_path "$stage0_runtime_file"
        return 0
    fi

    name="nupp-stage0-$STAGE0_TAG.lua"
    mkdir -p "$CACHE/stage0"
    staged="$out.$$"
    rm -rf "$staged"
    mkdir -p "$staged"
    # shellcheck disable=SC2064
    trap "rm -rf '$staged'" EXIT HUP INT TERM

    # An offline builder supplies either spelling: the asset as published, or
    # the plain bundle, which is what the digest is of and so the easier one to
    # check by hand.
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$staged/nupp.lua"
    elif [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name.gz" ]; then
        cp "$SOURCE_DIR/$name.gz" "$staged/nupp.lua.gz"
        gunzip "$staged/nupp.lua.gz" || die "$name.gz did not decompress"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and the $STAGE0_TAG stage-zero compiler is not cached; put $name.gz in NUPP_HOST_SOURCE_DIR"
    else
        # Spelled out rather than expanded from the pin, which is how every
        # other component here reaches its URL: the pin says where to look and
        # the digest says what is acceptable.
        url="https://github.com/nupp-lang/nupp/releases/download/$STAGE0_TAG/$name.gz"
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name.gz"
        fi
        note "fetching the $STAGE0_TAG stage-zero compiler"
        download "$url" "$staged/nupp.lua.gz" \
            || die "cannot download $url"
        gunzip "$staged/nupp.lua.gz" || die "$name.gz did not decompress"
    fi

    found=$(sha256 "$staged/nupp.lua")
    if [ "$found" != "$STAGE0_SHA256" ]; then
        rm -rf "$staged"
        trap - EXIT HUP INT TERM
        die "the $STAGE0_TAG stage-zero compiler has digest $found, expected $STAGE0_SHA256; refusing to cache or run it"
    fi
    # Renamed into place whole, so a killed fetch never leaves a truncated
    # compiler behind for the next command to run, and the digest directory is
    # created only once its one file has been verified.
    mkdir -p "$out"
    mv "$staged/nupp.lua" "$file.$$"
    mv "$file.$$" "$file"
    rm -rf "$staged"
    trap - EXIT HUP INT TERM
    stage0_runtime "$file"
    native_path "$stage0_runtime_file"
}

# --- notices ----------------------------------------------------------------

# Each of these is MIT, and MIT asks that its notice travel with the copies. The
# sources are fetched rather than committed, so the only copy this repository
# ships is the one in `host/notices` -- and a copy that has drifted from the
# source it claims to reproduce is a false statement about what was distributed.
# Bumping a pin fails here until the notice beside it is updated too.
verify_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    [ -f "$noticeSource" ] \
        || die "the pinned source has no $noticeSource to check $notice against"
    [ -f "$committed" ] || die "host/notices/$notice is missing"
    if ! cmp -s "$noticeSource" "$committed"; then
        die "host/notices/$notice is not what $noticeSource says any more. Copy it across: the pinned source is what is distributed, and the notice beside it is what says so."
    fi
}

# LPeg ships its licence inside its manual rather than as a file, so the notice
# beside it is checked for the clauses instead of byte for byte.
verify_embedded_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    for text in '2007-2023 Lua.org, PUC-Rio' 'Permission is hereby granted' 'THE SOFTWARE IS PROVIDED'; do
        grep -qF "$text" "$noticeSource" && grep -qF "$text" "$committed" \
            || die "host/notices/$notice no longer agrees with $noticeSource"
    done
}

# --- one build at a time ----------------------------------------------------

# Two commands wanting the same component start together often enough -- a test
# suite runs the launcher many times -- and they would otherwise be two makes
# writing one source tree. `mkdir` is the lock because it is atomic wherever
# this runs; the pid in it tells a held lock from one a killed build left.
LOCK=""
HOST_OUT=""
NATIVE_OUT=""
RUST_NATIVE_OUT=""
RUST_HOST_OUT=""
RUST_HOST_STATIC_OUT=""
RUST_EMBED_DYNAMIC_OUT=""
RUST_EMBED_IMPORT_OUT=""
release_lock() { [ -n "$LOCK" ] && rm -rf "$LOCK"; LOCK=""; return 0; }

take_lock() {
    lock="$CACHE/.lock-$1"
    waited=0
    mkdir -p "$CACHE"
    while ! mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        # Whoever holds it is building what this one wants, so their answer is
        # this one's answer.
        [ -f "$2" ] && return 1
        sleep 1
        waited=$((waited + 1))
        if [ "$waited" -ge 1800 ]; then
            note "another run has held $lock for ${waited}s; building without it"
            return 0
        fi
    done
    printf '%s\n' "$$" > "$lock/pid"
    LOCK=$lock
    trap 'release_lock' EXIT
    trap 'release_lock; exit 130' INT
    trap 'release_lock; exit 143' TERM
    return 0
}

# --- components -------------------------------------------------------------

# Rust is a deliberate native prerequisite, not another ambient implementation
# detail. The exact release in rust-toolchain.toml is accepted; a newer stable
# is not silently substituted, because compiler and Cargo versions participate
# in the artifact identity and can change code generation or feature solving.
select_rust_tools() {
    CARGO=${NUPP_CARGO:-cargo}
    RUSTC=${NUPP_RUSTC:-rustc}
    # Asked for before reading it, so a tree without one is reported by the line
    # below rather than by `sed` naming a path on standard error. Every caller
    # here captures only standard output, so that stray line arrives wherever
    # the caller's own output was going.
    [ -f "$ROOT/rust-toolchain.toml" ] || die "rust-toolchain.toml is missing; nothing pins the Rust toolchain"
    expected=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' "$ROOT/rust-toolchain.toml")
    [ -n "$expected" ] || die "rust-toolchain.toml names no exact channel"
    rustup_toolchain=$expected
    [ "$PLATFORM" != windows ] \
        || rustup_toolchain="$expected-x86_64-pc-windows-$RUST_WINDOWS_ABI"
    rustup_which() {
        RUSTUP_TOOLCHAIN="$rustup_toolchain" RUSTUP_SKIP_UPDATE_CHECK=1 \
            rustup which "$1" 2>/dev/null
    }
    if [ -z "${NUPP_CARGO:-}" ] && command -v rustup >/dev/null 2>&1; then
        CARGO=$(rustup_which cargo || printf cargo)
    fi
    if [ -z "${NUPP_RUSTC:-}" ] && command -v rustup >/dev/null 2>&1; then
        RUSTC=$(rustup_which rustc || printf rustc)
    fi
    command -v "$CARGO" >/dev/null 2>&1 \
        || die "no Cargo found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_CARGO"
    command -v "$RUSTC" >/dev/null 2>&1 \
        || die "no rustc found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_RUSTC"

    # Resolve rustup's proxy once above, then execute the exact tool binary.
    # Running an ambient proxy here can synchronize a channel and mix its
    # progress into the version identity or select a different host ABI.
    cargo_version=$("$CARGO" --version) \
        || die "cannot run Cargo named by NUPP_CARGO"
    rustc_version=$("$RUSTC" --version) \
        || die "cannot run rustc named by NUPP_RUSTC"
    case "$cargo_version" in
        "cargo $expected "*) ;;
        *) die "Cargo is $cargo_version; rust-toolchain.toml requires cargo $expected" ;;
    esac
    case "$rustc_version" in
        "rustc $expected "*) ;;
        *) die "rustc is $rustc_version; rust-toolchain.toml requires rustc $expected" ;;
    esac
    rustc_verbose=$("$RUSTC" -vV) \
        || die "cannot inspect rustc named by NUPP_RUSTC"
    rust_host=$(printf '%s\n' "$rustc_verbose" | sed -n 's/^host: //p')
    if [ "$PLATFORM" = darwin ]; then
        rust_sysroot=$("$RUSTC" --print sysroot) \
            || die "cannot locate the sysroot for rustc named by NUPP_RUSTC"
        rust_runtime="$rust_sysroot/lib"
        case ":${DYLD_FALLBACK_LIBRARY_PATH:-}:" in
            *":$rust_runtime:"*) ;;
            *)
                DYLD_FALLBACK_LIBRARY_PATH="$rust_runtime${DYLD_FALLBACK_LIBRARY_PATH:+:$DYLD_FALLBACK_LIBRARY_PATH}"
                export DYLD_FALLBACK_LIBRARY_PATH
                ;;
        esac
    fi
    if [ "$PLATFORM" = windows ]; then
        case "$RUST_WINDOWS_ABI:$rust_host" in
            gnu:x86_64-pc-windows-gnu|gnullvm:x86_64-pc-windows-gnullvm) ;;
            *) die "Rust host $rust_host does not match NUPP_RUST_WINDOWS_ABI=$RUST_WINDOWS_ABI; install rustup toolchain $rustup_toolchain or name an equivalent toolchain" ;;
        esac
        case "$RUST_WINDOWS_ABI" in
            gnu)
                unset CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_LINKER
                export CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER="$CC"
                ;;
            gnullvm)
                unset CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER
                export CARGO_TARGET_X86_64_PC_WINDOWS_GNULLVM_LINKER="$CC"
                ;;
        esac
    fi
    RUST_TOOL_MATERIAL=$(printf '%s\n%s\n' "$cargo_version" "$rustc_verbose")
}

normalize_rust_features() {
    raw=${1:-}
    case "$raw" in
        *[!A-Za-z0-9_,-]*) die "invalid Rust feature list $raw" ;;
    esac
    features=$(printf '%s' "$raw" | tr ',' ' ')
    for feature in $features; do
        case "$feature" in
            *[!A-Za-z0-9_-]*) die "invalid Rust feature $feature" ;;
        esac
    done
    printf '%s\n' $features | sed '/^$/d' | LC_ALL=C sort -u \
        | tr '\n' ',' | sed 's/,$//'
}

rust_library_filename() {
    case "$PLATFORM" in
        darwin)  printf '%s\n' libnupp_native.dylib ;;
        windows) printf '%s\n' nupp_native.dll ;;
        *)       printf '%s\n' libnupp_native.so ;;
    esac
}

# Cargo accepts ambient knobs that materially alter a binary without changing
# its source or lock file. Keep supported codegen/profile overrides in the
# content key, and reject the implicit target override because the artifact
# path and platform filename below deliberately describe the host target.
rust_environment_material() {
    [ -z "${CARGO_BUILD_TARGET:-}" ] \
        || die "CARGO_BUILD_TARGET is unsupported; Rust host builds require an explicit toolchain target design"
    env | LC_ALL=C sort | sed -n \
        -e '/^RUSTFLAGS=/p' \
        -e '/^CARGO_ENCODED_RUSTFLAGS=/p' \
        -e '/^CARGO_PROFILE_/p' \
        -e '/^CARGO_TARGET_.*_RUSTFLAGS=/p' \
        -e '/^MACOSX_DEPLOYMENT_TARGET=/p' \
        -e '/^IPHONEOS_DEPLOYMENT_TARGET=/p'
}

rust_vendor_arguments() {
    vendor=${NUPP_RUST_VENDOR_DIR:-}
    if [ -z "$vendor" ]; then
        offline && die "offline Rust builds require NUPP_RUST_VENDOR_DIR; provision it with scripts/toolchain rust-vendor OUTPUT"
        return 0
    fi
    [ -d "$vendor" ] || die "NUPP_RUST_VENDOR_DIR is not a directory: $vendor"
    printf '%s\n' \
        "source.crates-io.replace-with='nupp-vendored-sources'" \
        "source.nupp-vendored-sources.directory='$vendor'"
}

provision_rust_vendor() {
    destination=$1
    [ -n "$destination" ] || die "rust-vendor needs an output directory"
    [ ! -e "$destination" ] || die "rust-vendor refuses to replace $destination"
    select_rust_tools
    note "provisioning locked Rust sources in $destination"
    set -- "$CARGO" vendor --locked "$destination"
    offline && set -- "$@" --offline
    RUSTC="$RUSTC" "$@" >&2
}

# Rust entry points are content-addressed under the checkout's build/rust tree.
# They always build the locked workspace with default features disabled so the
# compiler-selected feature union is the dependency union.
# A feature list naming the code generator needs the pinned LLVM: it is built
# (or found) first, handed to cargo, and folded into the artifact's key, since
# the LLVM pin is deliberately not part of the ordinary native key.
# Whether a feature list's code generator is built in: when the pinned LLVM is
# already built, or when NUPP_REQUIRE_CODEGEN=1 asks for it (a release, which
# builds LLVM if it must). Otherwise the build goes ahead without it, the way
# bin/nupp's own provider does, so a checkout or CI shard that never compiles
# AOT code never waits an hour for LLVM. `@aot` then says what is missing.
codegen_wanted() {
    [ "${NUPP_REQUIRE_CODEGEN:-}" = 1 ] && return 0
    (build_llvm available) >/dev/null 2>&1 && return 0
    note "building without the code generator: the pinned LLVM is not built (scripts/toolchain llvm)"
    return 1
}

# The Rust feature list without `codegen` when codegen_wanted declines it.
optional_codegen() {
    case ",$1," in
        *,codegen,*)
            if codegen_wanted; then
                printf '%s\n' "$1"
            else
                printf '%s\n' "$1" | tr ',' '\n' | grep -v '^codegen$' | tr '\n' ',' | sed 's/,$//'
            fi
            ;;
        *) printf '%s\n' "$1" ;;
    esac
}

llvm_for_features() {
    RUST_LLVM_MATERIAL=
    case ",$1," in
        *,codegen,*|*,native-codegen,*)
            build_llvm
            NUPP_LLVM_PREFIX=$LLVM_OUT
            export NUPP_LLVM_PREFIX
            RUST_LLVM_MATERIAL="llvm $LLVM_VERSION $LLVM_SHA256 $LLVM_OUT"
            ;;
    esac
}

build_rust_native() {
    sorted=$(optional_codegen "$(normalize_rust_features "${1:-}")")
    select_rust_tools
    llvm_for_features "$sorted"
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s|%s\n' \
            nupp-native "$sorted" "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)" "$KEY" "$RUST_LLVM_MATERIAL"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/native/$digest"
    filename=$(rust_library_filename)
    RUST_NATIVE_OUT="$out/target/release/$filename"
    RUST_NATIVE_STATIC_OUT="$out/target/release/libnupp_native.a"

    take_lock "rust-native-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && [ -f "$RUST_NATIVE_OUT" ] \
        && [ -f "$RUST_NATIVE_STATIC_OUT" ] \
        && { release_lock; return 0; }

    note "building the Rust native provider with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    cargo_action=build
    [ "$PLATFORM" = darwin ] && cargo_action=rustc
    set -- "$CARGO" "$cargo_action" \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    [ "$PLATFORM" = darwin ] && set -- "$@" --lib
    if offline; then
        set -- "$@" --offline
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    if [ -n "$sorted" ]; then
        set -- "$@" --features "$sorted"
    fi
    # rustc otherwise records the content-addressed target directory as this
    # dylib's identity. A program linked against the provider would then load
    # that cache path after the library was staged or packaged elsewhere.
    if [ "$PLATFORM" = darwin ]; then
        set -- "$@" -- -C "link-arg=-Wl,-install_name,@rpath/$filename"
    fi
    CC="$CC" CXX="$CXX" RUSTC="$RUSTC" "$@" >&2
    [ -f "$RUST_NATIVE_OUT" ] \
        || die "Cargo built nupp-native but did not write $RUST_NATIVE_OUT"
    [ -f "$RUST_NATIVE_STATIC_OUT" ] \
        || die "Cargo built nupp-native but did not write $RUST_NATIVE_STATIC_OUT"
    printf 'done\n' > "$out/.complete"
    release_lock
}

select_host_features() {
    host_feature_words=$(printf '%s' "${1:-}" | tr ',' ' ')
    host_feature_words=$(printf '%s\n' $host_feature_words | LC_ALL=C sort -u | tr '\n' ' ')
    host_cargo_features=""
    host_lpeg_prefix=""
    for feature in $host_feature_words; do
        case "$feature" in
            lpeg)
                host_lpeg_prefix=$(build_lpeg; printf '%s' "$PREFIX/lpeg")
                host_cargo_features="$host_cargo_features,lpeg"
                ;;
            workers) host_cargo_features="$host_cargo_features,workers" ;;
            native-files|files|filesystem)
                host_cargo_features="$host_cargo_features,native-files"
                ;;
            native-gpu|gpu) host_cargo_features="$host_cargo_features,native-gpu" ;;
            native-net|net) host_cargo_features="$host_cargo_features,native-net" ;;
            native-tls|tls) host_cargo_features="$host_cargo_features,native-tls" ;;
            native-process|process)
                host_cargo_features="$host_cargo_features,native-process"
                ;;
            native-compression|compression)
                host_cargo_features="$host_cargo_features,native-compression"
                ;;
            native-codegen|codegen)
                if codegen_wanted; then
                    host_cargo_features="$host_cargo_features,native-codegen"
                fi
                ;;
            base) ;;
            *) die "unknown host feature $feature" ;;
        esac
    done
    host_cargo_features=$(normalize_rust_features "${host_cargo_features#,}")
}

host_export_arguments() {
    case "$PLATFORM" in
        darwin) printf '%s\n' '-C' 'link-arg=-Wl,-export_dynamic' ;;
        windows) printf '%s\n' '-C' 'link-arg=-Wl,--export-all-symbols' ;;
        *) printf '%s\n' '-C' 'link-arg=-Wl,-E' ;;
    esac
}

embedding_library_filename() {
    case "$PLATFORM" in
        darwin) printf '%s\n' libnupp.dylib ;;
        windows) printf '%s\n' nupp.dll ;;
        *) printf '%s\n' libnupp.so ;;
    esac
}

build_rust_host() {
    host_kind=${1:-binary}
    # Reject a mismatched Windows Rust/MinGW family before provisioning the C
    # dependencies whose archives that Rust host would be unable to consume.
    select_rust_tools
    select_host_features "${2:-}"
    llvm_for_features "$host_cargo_features"
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s|%s\n' \
            nupp-native-host "$host_kind" "$host_cargo_features" \
            "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)|$KEY" "$RUST_LLVM_MATERIAL"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/host-$host_kind/$digest"
    executable=nupp-host-rust
    [ "$PLATFORM" = windows ] && executable=nupp-host-rust.exe
    RUST_HOST_OUT="$out/target/release/$executable"
    RUST_HOST_STATIC_OUT="$out/target/release/libnupp.a"

    expected=$RUST_HOST_OUT
    [ "$host_kind" = application ] && expected=$RUST_HOST_STATIC_OUT
    take_lock "rust-host-$host_kind-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && [ -f "$expected" ] \
        && { release_lock; return 0; }

    note "building the Rust $host_kind host with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    set -- "$CARGO" rustc \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native-host \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    if [ "$host_kind" = application ]; then
        host_cargo_features=$(normalize_rust_features \
            "${host_cargo_features:+$host_cargo_features,}application-entry")
        set -- "$@" --lib
    else
        set -- "$@" --bin nupp-host-rust
    fi
    if offline; then
        set -- "$@" --offline
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    [ -z "$host_cargo_features" ] || set -- "$@" --features "$host_cargo_features"
    set -- "$@" -- -C link-dead-code
    if [ "$host_kind" != application ]; then
        while IFS= read -r argument; do
            set -- "$@" "$argument"
        done <<EOF
$(host_export_arguments)
EOF
    fi
    NUPP_CC="$CC" \
        NUPP_LUAJIT_PREFIX="$PREFIX/luajit" NUPP_LPEG_PREFIX="$host_lpeg_prefix" \
        RUSTC="$RUSTC" "$@" >&2
    [ -f "$expected" ] \
        || die "Cargo built nupp-native-host but did not write $expected"
    printf 'done\n' > "$out/.complete"
    release_lock
}

build_rust_embedding() {
    luajit_prefix=$1
    embedding_features=${2:-}
    lpeg_prefix=${3:-}
    select_rust_tools
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-native-embedding "$embedding_features" "$RUST_TOOL_MATERIAL" \
            "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/embedding/$digest"
    RUST_EMBED_OUT="$out/target/release/libnupp.a"
    case "$PLATFORM" in
        darwin) cargo_dynamic=libnupp.dylib ;;
        windows)
            cargo_dynamic=nupp.dll
            RUST_EMBED_IMPORT_OUT="$out/target/release/libnupp.dll.a"
            ;;
        *) cargo_dynamic=libnupp.so ;;
    esac
    RUST_EMBED_DYNAMIC_OUT="$out/target/release/$cargo_dynamic"

    take_lock "rust-embedding-$digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$RUST_EMBED_OUT" ] \
        && [ -f "$RUST_EMBED_DYNAMIC_OUT" ]; then
        [ "$PLATFORM" != windows ] || [ -f "$RUST_EMBED_IMPORT_OUT" ] \
            || die "the cached Windows embedding SDK has no import library"
        release_lock
        return 0
    fi

    note "building the Rust embedding library with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    set -- "$CARGO" rustc \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native-host \
        --lib \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    if offline; then
        set -- "$@" --offline
    fi
    if [ -n "$embedding_features" ]; then
        set -- "$@" --features "$embedding_features"
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    set -- "$@" -- -C link-dead-code
    case "$PLATFORM" in
        darwin) set -- "$@" -C 'link-arg=-Wl,-install_name,@rpath/libnupp.dylib' ;;
    esac
    NUPP_CC="$CC" \
        NUPP_LUAJIT_PREFIX="$luajit_prefix" NUPP_LPEG_PREFIX="$lpeg_prefix" \
        RUSTC="$RUSTC" "$@" >&2
    [ -f "$RUST_EMBED_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_OUT"
    [ -f "$RUST_EMBED_DYNAMIC_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_DYNAMIC_OUT"
    [ "$PLATFORM" != windows ] || [ -f "$RUST_EMBED_IMPORT_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_IMPORT_OUT"
    printf 'done\n' > "$out/.complete"
    release_lock
}

shared_flags() {
    case "$PLATFORM" in
        darwin)  printf '%s' "-bundle -undefined dynamic_lookup" ;;
        windows) printf '%s' "-shared" ;;
        *)       printf '%s' "-shared" ;;
    esac
}

module_extension() {
    case "$PLATFORM" in
        windows) printf '%s' ".dll" ;;
        *)       printf '%s' ".so" ;;
    esac
}

build_luajit() {
    out="$PREFIX/luajit"
    take_lock luajit "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory="LuaJIT-$LUAJIT_REV"
    url="https://github.com/LuaJIT/LuaJIT/archive/$LUAJIT_REV.tar.gz"
    luajit_source=$(source_tree "$directory" "$url" "$LUAJIT_SHA256" "$LUAJIT_MARKER")
    verify_notice "$luajit_source/COPYRIGHT" LuaJIT-COPYRIGHT.txt

    # Shared verified sources are immutable inputs. Patch and compile a fresh
    # private copy, so another compiler key cannot observe either change.
    luajit_build="$PREFIX/.luajit-source"
    rm -rf "$luajit_build"
    mkdir -p "$luajit_build"
    cp -R "$luajit_source/." "$luajit_build/"
    patch -f -p1 -d "$luajit_build" < "$ROOT/scripts/patches/luajit-irt-size.patch" >&2
    tree=$luajit_build

    note "building LuaJIT with $CC"
    rm -rf "$out"
    # LuaJIT bakes its module search paths in at compile time, so the prefix has
    # to be the one it is installed under rather than one it is copied to. It
    # also refuses to guess an Apple deployment target, preferring to stop over
    # producing something that runs here and nowhere else.
    if [ "$PLATFORM" = darwin ] && [ -z "${MACOSX_DEPLOYMENT_TARGET:-}" ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) MACOSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      MACOSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
        export MACOSX_DEPLOYMENT_TARGET
    fi
    "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
    "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
    "$MAKE" -C "$tree" PREFIX="$out" install >&2

    # LuaJIT's top-level install recipe only knows the Unix artifact names.
    # Its Windows build is deliberately dynamic so C modules bind to the same
    # VM as the interpreter, but that leaves lua51.dll and its import library
    # in the source tree. Stage both, then make the static archive separately:
    # standalone Nupp hosts carry their VM and cannot depend on a sibling DLL.
    if [ "$PLATFORM" = windows ]; then
        [ -f "$tree/src/lua51.dll" ] \
            || die "LuaJIT's Windows build produced no lua51.dll"
        [ -f "$tree/src/libluajit-5.1.dll.a" ] \
            || die "LuaJIT's Windows build produced no import library"
        cp "$tree/src/lua51.dll" "$out/bin/lua51.dll"
        cp "$tree/src/luajit.exe" "$out/bin/luajit.exe"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/libluajit-5.1.dll.a"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/liblua51.a"

        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" \
            XCFLAGS=-fPIC BUILDMODE=static >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's Windows static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"

        # The same Unix-only install recipe leaves the interpreter's own Lua
        # modules behind. `jit.vmdef` is what the bytecode reader loads and
        # `jit.zone` is what the profiler does, so without them every question
        # about a trace answered "module not found" rather than answering.
        #
        # Beside the executable, because that is where this interpreter looks:
        # the Unix build compiles in a prefix and finds `share/luajit-2.1`, and
        # the Windows one searches `<exedir>\lua\?.lua`. Staged under the
        # prefix as well, for anything reading the tree rather than running it.
        for jit_dir in "$out/bin/lua/jit" "$out/share/luajit-2.1/jit"; do
            mkdir -p "$jit_dir"
            cp "$tree/src/jit/"*.lua "$jit_dir/"
            [ -f "$jit_dir/vmdef.lua" ] \
                || die "LuaJIT's Windows build staged no jit/vmdef.lua"
        done
    fi

    # `luajit` itself is a versioned name plus a symlink upstream only makes on
    # some platforms, and everything here runs the plain one.
    if [ ! -x "$out/bin/luajit" ]; then
        for candidate in "$out"/bin/luajit-*; do
            [ -x "$candidate" ] || continue
            ln -sf "$(basename "$candidate")" "$out/bin/luajit"
            break
        done
    fi
    [ -x "$out/bin/luajit" ] || die "LuaJIT installed no interpreter under $out/bin"

    # Where the headers landed, which is a versioned directory, said once here so
    # nothing downstream has to know the version.
    include=$(find "$out/include" -maxdepth 1 -type d -name 'luajit-*' | head -n 1)
    [ -n "$include" ] || include="$out/include"
    native_path "$include" > "$out/.include"
    {
        cksum < "$ROOT/scripts/patches/luajit-irt-size.patch"
        cksum < "$out/bin/luajit"
    } > "$out/.nupp-runtime-patch"
    rm -rf "$luajit_build"
    printf 'done\n' > "$out/.complete"
    release_lock
}

luajit_include() {
    build_luajit
    cat "$PREFIX/luajit/.include"
}

build_luarocks() {
    out="$PREFIX/luarocks"
    luajit=$(build_luajit; printf '%s' "$PREFIX/luajit")
    include=$(cat "$luajit/.include")
    take_lock luarocks "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory="luarocks-$LUAROCKS_VERSION"
    url="https://github.com/luarocks/luarocks/archive/refs/tags/v$LUAROCKS_VERSION.tar.gz"
    tree=$(source_tree "$directory" "$url" "$LUAROCKS_SHA256" "$LUAROCKS_MARKER")

    note "installing LuaRocks"
    rm -rf "$out"
    if [ "$PLATFORM" = windows ]; then
        outWindows=$(cygpath -w "$out")
        rocksWindows=$(cygpath -w "$ROOT/.rocks")
        binWindows=$(cygpath -w "$luajit/bin")
        includeWindows=$(cygpath -w "$include")
        libWindows=$(cygpath -w "$luajit/lib")
        # Git Bash otherwise rewrites switches such as /P and /TREE as paths
        # before the batch installer sees them.
        (cd "$tree" && MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c call install.bat \
            /P "$outWindows" /TREE "$rocksWindows" \
            /LV 5.1 /INC "$includeWindows" /LIB "$libWindows" \
            /BIN "$binWindows" /MW /Q /F /NOREG /NOADMIN \
            /FORCECONFIG) >&2
    else
        (cd "$tree" && ./configure \
            --prefix="$out" \
            --rocks-tree="$ROOT/.rocks" \
            --lua-version=5.1 \
            --with-lua-bin="$luajit/bin" \
            --with-lua-include="$include" \
            --with-lua-lib="$luajit/lib" \
            --with-lua-interpreter=luajit \
            --force-config && "$MAKE" install) >&2
    fi
    case "$PLATFORM" in
        windows) executable="$out/luarocks.bat" ;;
        *) executable="$out/bin/luarocks" ;;
    esac
    [ -f "$executable" ] || die "LuaRocks installed no executable under $out"
    native_path "$executable" > "$out/.executable"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# LPeg is built straight from its sources. It is a handful of files against the
# Lua headers, and naming them is shorter than teaching its build system where
# the staged LuaJIT is.
build_lua_module() {
    name=$1 out=$2 tree=$3 include=$4
    shift 4
    objects=""
    for file in "$@"; do
        object="$out/objects/$(basename "$file" .c).o"
        mkdir -p "$out/objects"
        "$CC" -c -O2 -fPIC -w -DNDEBUG -I"$include" -o "$object" "$tree/$file" >&2
        objects="$objects $object"
    done
    mkdir -p "$out/lib"
    # Both shapes, because both are wanted: a loadable module for an interpreter
    # that requires it, and an archive for a host that links it in.
    # shellcheck disable=SC2086
    luaLibrary=""
    if [ "$PLATFORM" = windows ]; then
        luaLibrary="$PREFIX/luajit/lib/libluajit-5.1.dll.a"
    fi
    "$CC" $(shared_flags) -o "$out/lib/$name$(module_extension)" \
        $objects $luaLibrary >&2
    # shellcheck disable=SC2086
    ar rcs "$out/lib/lib$name.a" $objects
}

# The pinned, verified LPeg source tree. A caller that compiles LPeg with a
# compiler of its own -- the playground's Emscripten host links it into the
# application VM, where a loadable C module is not a thing that exists -- wants
# the sources rather than this machine's build of them, and wants them fetched
# through the same pin and the same notice check.
lpeg_source() {
    directory="lpeg-$LPEG_VERSION"
    url="https://www.inf.puc-rio.br/~roberto/lpeg/lpeg-$LPEG_VERSION.tar.gz"
    tree=$(source_tree "$directory" "$url" "$LPEG_SHA256" "$LPEG_MARKER")
    verify_embedded_notice "$tree/lpeg.html" LPeg-LICENSE.txt
    printf '%s\n' "$tree"
}

build_lpeg() {
    out="$PREFIX/lpeg"
    # Before the lock, not inside it: these locks do not nest, and building
    # LuaJIT under the LPeg lock would release the LPeg one on its way out.
    include=$(luajit_include)
    tree=$(lpeg_source)
    take_lock lpeg "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    note "building LPeg with $CC"
    rm -rf "$out"
    build_lua_module lpeg "$out" "$tree" "$include" \
        lpvm.c lpcap.c lptree.c lpcode.c lpprint.c lpcset.c
    # The official frontend is Lua, and a caller that wants `re` wants it beside
    # the module it parses with.
    mkdir -p "$out/share"
    cp "$tree/re.lua" "$out/share/re.lua"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# --- the host ------------------------------------------------------------

# A Rust staticlib flattens its dependency rlibs. On Windows GNU that includes
# import thunk members from windows-targets, sometimes under the same archive
# member name more than once. Non-Windows application hosts are force-loaded
# because provider exports are reached only through LuaJIT FFI. Windows keeps
# those exports in one selected codegen unit and uses a sanitized archive with
# an unmodified companion linked through ordinary archive
# selection after MinGW's system import libraries: the latter then supplies
# only Rust std imports which those libraries do not expose, without selecting
# flattened duplicate thunks for symbols MinGW already owns.
stage_application_archive() {
    source=$1
    destination=$2
    imports_archive=${3:-}
    cp "$source" "$destination"
    [ "$PLATFORM" = windows ] || return 0
    [ -n "$imports_archive" ] || die "the Windows application archive needs an import companion"
    cp "$source" "$imports_archive"

    archive_tool=${AR:-ar}
    members="$destination.members.$$"
    imports="$destination.imports.$$"
    "$archive_tool" t "$destination" > "$members"
    : > "$imports"
    while IFS= read -r member; do
        member=$(printf '%s' "$member" | tr -d '\r')
        case "$member" in
            *.dlls[0-9]*.o|*.dllh.o|*.dllt.o)
                printf '%s\n' "$member" >> "$imports"
                ;;
        esac
    done < "$members"
    if [ -s "$imports" ]; then
        # GNU ar processes every response-file argument in memory and writes
        # the archive once. Repeated names in this list therefore remove each
        # duplicate instance without rewriting the large Rust staticlib once
        # per member.
        imports_native=$(native_path "$imports")
        "$archive_tool" d "$destination" "@$imports_native"
    fi
    "$archive_tool" s "$destination"
    "$archive_tool" t "$destination" > "$members"
    while IFS= read -r member; do
        member=$(printf '%s' "$member" | tr -d '\r')
        case "$member" in
            *.dlls[0-9]*.o|*.dllh.o|*.dllt.o)
                rm -f "$members" "$imports"
                die "the staged Windows application archive retains import member $member"
                ;;
        esac
    done < "$members"
    rm -f "$members" "$imports"
}

# System dependencies needed by consumers of the flattened Rust static archive.
# Keep the application linker and the embedding SDK's machine-readable contract
# on the same feature-specific list.
host_system_flags() {
    case "$PLATFORM" in
        darwin)
            printf '%s\n' -lm -lpthread -framework CoreFoundation -framework Security
            case ",$1," in
                *,native-gpu,*) printf '%s\n' -framework Metal -framework CoreGraphics -framework Foundation ;;
            esac
            ;;
        windows)
            printf '%s\n' -lpthread -lpsapi -luser32 -ladvapi32 -liphlpapi -luserenv \
                -lws2_32 -ldbghelp -lole32 -lshell32 -lbcrypt -lcrypt32 -lntdll \
                -lkernel32 -lsecur32 -lncrypt
            ;;
        *) printf '%s\n' -lm -lpthread -ldl ;;
    esac
}

# Stages the Rust executable and static application entry, or the Rust embedding
# SDK, for one exact compiler-selected feature set.
build_host() {
    kind=$1
    features=${2:-}
    select_host_features "$features"
    selected_cargo_features=$host_cargo_features
    selected_lpeg_prefix=$host_lpeg_prefix
    digest=$(printf '%s|%s|%s|%s' \
        "$kind" "$selected_cargo_features" "$(embedding_headers_digest)" "$(rust_sources_digest)" \
        | sha256_stdin | cut -c1-16)
    out="$PREFIX/host/$digest"
    HOST_OUT="$out"
    stage_out=$out
    stage_digest=$digest
    luajit_prefix=$(build_luajit; printf '%s' "$PREFIX/luajit")

    if [ "$kind" = library ]; then
        build_rust_embedding "$luajit_prefix" "$selected_cargo_features" "$selected_lpeg_prefix"
        rust_embedding=$RUST_EMBED_OUT
        rust_dynamic=$RUST_EMBED_DYNAMIC_OUT
        dynamic_name=$(embedding_library_filename)
        out=$stage_out
        digest=$stage_digest
        HOST_OUT=$out

        take_lock "host-$digest" "$out/.complete" || return 0
        [ -f "$out/.complete" ] && [ -f "$out/libnupp.a" ] \
            && [ -f "$out/$dynamic_name" ] && { release_lock; return 0; }
        note "staging the Rust embedding SDK"
        rm -rf "$out"
        mkdir -p "$out"
        cp "$rust_embedding" "$out/libnupp.a"
        cp "$rust_dynamic" "$out/$dynamic_name"
        if [ "$PLATFORM" = windows ]; then
            cp "$RUST_EMBED_IMPORT_OUT" "$out/libnupp.dll.a"
        fi
        cp "$ROOT/host/include/nupp.h" "$out/nupp.h"
        {
            printf '{\n  "schemaVersion": 1,\n'
            printf '  "features": "%s",\n' "$selected_cargo_features"
            printf '  "header": "nupp.h",\n'
            printf '  "static": "libnupp.a",\n'
            printf '  "staticLinkFlags": ['
            separator=''
            while IFS= read -r flag; do
                printf '%s"%s"' "$separator" "$flag"
                separator=', '
            done <<EOF
$(host_system_flags "$selected_cargo_features")
EOF
            printf '],\n'
            if [ "$PLATFORM" = windows ]; then
                printf '  "dynamic": "%s",\n' "$dynamic_name"
                printf '  "import": "libnupp.dll.a"\n}\n'
            else
                printf '  "dynamic": "%s"\n}\n' "$dynamic_name"
            fi
        } > "$out/link.json"
        printf 'done\n' > "$out/.complete"
        release_lock
        HOST_OUT=$out
        return 0
    fi

    build_rust_host binary "$features"
    rust_executable=$RUST_HOST_OUT
    build_rust_host application "$features"
    rust_application=$RUST_HOST_STATIC_OUT
    out=$stage_out
    digest=$stage_digest
    HOST_OUT=$out

    take_lock "host-$digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$out/nupp-host" ] \
        && [ -f "$out/libnupp-host.a" ]; then
        if [ "$PLATFORM" != windows ] || [ -f "$out/libnupp-host-imports.a" ]; then
            release_lock
            return 0
        fi
    fi
    note "staging the Rust application host"
    rm -rf "$out"
    mkdir -p "$out"
    cp "$rust_executable" "$out/nupp-host"
    stage_application_archive \
        "$rust_application" "$out/libnupp-host.a" "$out/libnupp-host-imports.a"
    chmod +x "$out/nupp-host" 2>/dev/null || true
    printf 'done\n' > "$out/.complete"
    release_lock
    HOST_OUT="$out"
}

# Relinks the Rust application host with application-owned static archives. The
# archive list comes before `--`; everything after it is an ordinary trailing
# linker argument. Application archives are force-loaded because FFI gives them
# no relocations. The Rust host is force-loaded where safe; Windows selects its
# one-codegen-unit export surfaces normally after the application archives.
link_host() {
    features=${1:-}
    output=${2:-}
    [ -n "$output" ] || die "host-link needs an output path"
    shift 2

    build_host stub "$features"
    host_out=$HOST_OUT
    archives=""
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
        archives="$archives
$1"
        shift
    done
    [ "$#" -eq 0 ] || shift
    flags_file="$output.nupp-link-flags.$$"
    trap 'rm -f "$flags_file"' EXIT HUP INT TERM
    : > "$flags_file"
    while [ "$#" -gt 0 ]; do
        printf '%s\n' "$1" >> "$flags_file"
        shift
    done

    # Construct argv with `set --` so cache and project paths containing spaces
    # remain one linker argument.
    set -- "$CC" -o "$output"
    case "$PLATFORM" in
        darwin) set -- "$@" "-Wl,-force_load,$host_out/libnupp-host.a" ;;
        windows) ;;
        *) set -- "$@" -Wl,--whole-archive "$host_out/libnupp-host.a" -Wl,--no-whole-archive ;;
    esac

    if [ -n "$archives" ]; then
        case "$PLATFORM" in
            darwin)
                while IFS= read -r archive; do
                    [ -z "$archive" ] || set -- "$@" "-Wl,-force_load,$archive"
                done <<EOF
$archives
EOF
                ;;
            *)
                set -- "$@" -Wl,--whole-archive
                while IFS= read -r archive; do
                    [ -z "$archive" ] || set -- "$@" "$archive"
                done <<EOF
$archives
EOF
                set -- "$@" -Wl,--no-whole-archive
                ;;
        esac
    fi
    if [ "$PLATFORM" = windows ]; then
        # Ordinary archives are one-pass. Application/AOT archives come first
        # so every host and LuaJIT reference exists before this archive scan.
        set -- "$@" "$host_out/libnupp-host.a"
    fi
    while IFS= read -r flag; do
        set -- "$@" "$flag"
    done < "$flags_file"
    while IFS= read -r flag; do
        set -- "$@" "$flag"
    done <<EOF
$(host_system_flags "$features")
EOF
    case "$PLATFORM" in
        darwin) set -- "$@" -Wl,-export_dynamic ;;
        windows)
            set -- "$@" "$host_out/libnupp-host-imports.a"
            set -- "$@" -Wl,--export-all-symbols
            ;;
        *) set -- "$@" -Wl,-E ;;
    esac
    "$@" >&2
    rm -f "$flags_file"
    trap - EXIT HUP INT TERM
    native_path "$output"
}

# --- Link kits ----------------------------------------------------------------

# What AOT objects may reference from the C library beyond what the runtime
# does: the libm functions the backend emits, and the memory functions LLVM
# lowers copies to. A kit's C-library stubs carry them whether or not the
# runtime itself uses them.
KIT_AOT_SYMBOLS="sin cos tan asin acos atan atan2 sinh cosh tanh exp log pow fmod expf fma fmaf
floor ceil trunc round sqrt memcpy memmove memset bzero memcmp bcmp memchr strtod"

# Stages the link kit for one host feature set: the runtime archive, stubs for
# every system library it and AOT code bind to, and kit.json naming them, so
# `nupp` links a standalone program with lld and nothing else. The stubs name
# symbols and install names only, taken from a probe link against this
# machine's SDK; no SDK file is copied.
# The public Nupp platform a kit built on this machine links for.
kit_target() {
    case "$PLATFORM-$(uname -m 2>/dev/null)" in
        windows-x86_64) echo x86_64-pc-windows-msvc ;;
        darwin-arm64) echo aarch64-apple-darwin ;;
        darwin-x86_64) echo x86_64-apple-darwin ;;
        linux-x86_64) echo x86_64-unknown-linux-gnu ;;
        linux-aarch64|linux-arm64) echo aarch64-unknown-linux-gnu ;;
        *) die "no link kit target for $PLATFORM on $(uname -m)" ;;
    esac
}

# The oldest macOS a kit's programs run on: LuaJIT's deployment floor.
kit_minimum() {
    case "$(uname -m 2>/dev/null)" in
        x86_64) echo 10.14 ;;
        *) echo 11.0 ;;
    esac
}

build_kit() {
    features=${1:-}
    build_host stub "$features"
    host_out=$HOST_OUT
    digest=$(printf 'kit-3|%s' "$(basename "$host_out")" | sha256_stdin | cut -c1-16)
    out="$PREFIX/kits/$digest"
    KIT_OUT=$out
    take_lock "kit-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }
    case "$PLATFORM" in
        darwin) ;;
        linux) build_kit_linux "$features" "$host_out" "$out"; release_lock; return 0 ;;
        windows) build_kit_windows "$features" "$host_out" "$out"; release_lock; return 0 ;;
        *) die "link kits are built on macOS, Linux and Windows" ;;
    esac
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/sdk"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -o "$probe" "-Wl,-force_load,$out/libnupp-runtime.a" "-Wl,-force_load,$probe-aot.o"
    host_system_flags "$features" > "$probe-flags"
    while IFS= read -r flag; do
        [ -z "$flag" ] || set -- "$@" "$flag"
    done < "$probe-flags"
    set -- "$@" -Wl,-export_dynamic
    "$@" >&2

    # Which library each symbol binds to, and what each library is.
    nm -m "$probe" | sed -n 's/^ *(undefined) [a-z ]*external \([^ ]*\) (from \([^)]*\)).*/\2 \1/p' \
        | sort -u > "$out/binds"
    otool -L "$probe" | sed -n '2,$p' > "$out/libraries"
    : > "$out/flags"
    while read -r path rest; do
        name=$(basename "$path")
        case "$path" in
            */Frameworks/*.framework/*)
                short=$name
                stub="$out/sdk/System/Library/Frameworks/$name.framework/$name.tbd"
                printf '%s\n' "-framework" "$name" >> "$out/flags"
                ;;
            *)
                short=$(printf '%s' "$name" | sed 's/\.dylib$//; s/\.[A-Z]$//')
                stub="$out/sdk/usr/lib/$short.tbd"
                printf '%s\n' "-l${short#lib}" >> "$out/flags"
                ;;
        esac
        compatibility=$(printf '%s' "$rest" | sed -n 's/.*compatibility version \([0-9.]*\).*/\1/p')
        current=$(printf '%s' "$rest" | sed -n 's/.*current version \([0-9.]*\).*/\1/p')
        mkdir -p "$(dirname "$stub")"
        {
            printf -- '--- !tapi-tbd\ntbd-version: 4\ntargets: [ arm64-macos, x86_64-macos ]\n'
            printf "install-name: '%s'\n" "$path"
            printf 'current-version: %s\ncompatibility-version: %s\n' "$current" "$compatibility"
            printf 'exports:\n  - targets: [ arm64-macos, x86_64-macos ]\n    symbols: [ '
            awk -v lib="$short" '$1 == lib { printf "%s\x27%s\x27", (n++ ? ", " : ""), $2 }' "$out/binds"
            # The lazy-binding helper a linker binds itself, never named.
            [ "$short" != libSystem ] || printf ", 'dyld_stub_binder'"
            printf ' ]\n...\n'
        } > "$stub"
    done < "$out/libraries"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "macos",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "minimum": "%s",\n' "$(kit_minimum)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n  "syslibroot": "sdk",\n' "$features"
        printf '  "libraries": ['
        awk '{ printf "%s\"%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/flags"
        printf ']\n}\n'
    } > "$out/kit.json"
    rm -f "$probe" "$probe-aot.c" "$probe-aot.o" "$probe-flags" "$out/binds" "$out/libraries" "$out/flags"
    printf 'ok\n' > "$out/.complete"
    release_lock
}

# The Windows (MinGW) kit: the link the C compiler's driver would run for a
# program, recorded with every object and library it names copied into the
# kit -- the CRT startup objects, the MinGW and libgcc archives, and the
# system DLLs' import libraries, all MinGW-w64's own -- so lld's MinGW driver
# replays it with the program's objects in place of the probe's.
build_kit_windows() {
    features=$1
    host_out=$2
    out=$3
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/lib"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"
    cp "$host_out/libnupp-host-imports.a" "$out/lib/libnupp-host-imports.a"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -v -o "$probe.exe" "$probe-aot.o" "$out/libnupp-runtime.a"
    while IFS= read -r flag; do
        set -- "$@" "$flag"
    done <<EOF
$(host_system_flags "$features")
EOF
    set -- "$@" "$out/lib/libnupp-host-imports.a" -Wl,--export-all-symbols
    "$@" > "$out/probe.log" 2>&1 || { tail -n 40 "$out/probe.log" >&2; die "the kit's probe link failed"; }
    line=$(grep -E '(collect2|ld)(\.exe)?"? ' "$out/probe.log" | tail -n 1)
    [ -n "$line" ] || die "the C compiler's driver did not say how it links"

    # One argument per line: the linker itself dropped, search directories
    # used to find each -l, then dropped; the probe's own inputs replaced by
    # placeholders; each object or library copied in and named relative to
    # the kit. Argument order is the link's, which one-pass archives need.
    : > "$out/dirs"
    for word in $line; do
        case "$word" in -L*) printf '%s\n' "${word#-L}" >> "$out/dirs" ;; esac
    done
    : > "$out/argv"
    first=1
    for word in $line; do
        word=${word%\"}
        word=${word#\"}
        if [ "$first" = 1 ]; then first=0; continue; fi
        case "$word" in
            -plugin|-plugin-opt=*|--sysroot=*|-L*) continue ;;
            */liblto_plugin*) continue ;;
            # By name: the driver prints its arguments as Windows paths.
            probe.exe|*/probe.exe|*\\probe.exe) printf '{output}\n' >> "$out/argv" ;;
            */probe-aot.o|*\\probe-aot.o) printf '{archives}\n' >> "$out/argv" ;;
            */libnupp-runtime.a|*\\libnupp-runtime.a) printf '{runtime}\n' >> "$out/argv" ;;
            */libnupp-host-imports.a|*\\libnupp-host-imports.a)
                printf '{kit}/lib/libnupp-host-imports.a\n' >> "$out/argv"
                ;;
            -l*)
                name=${word#-l}
                found=""
                while IFS= read -r dir; do
                    for candidate in "$dir/lib$name.a" "$dir/lib$name.dll.a" "$dir/$name.lib"; do
                        if [ -z "$found" ] && [ -f "$candidate" ]; then found=$candidate; fi
                    done
                done < "$out/dirs"
                [ -n "$found" ] || die "the probe link names -l$name, which no search directory holds"
                base=$(basename "$found")
                [ -f "$out/lib/$base" ] || cp "$found" "$out/lib/$base"
                printf '{kit}/lib/%s\n' "$base" >> "$out/argv"
                ;;
            *.o|*.obj|*.a)
                base=$(basename "$word")
                [ -f "$out/lib/$base" ] || cp "$word" "$out/lib/$base"
                printf '{kit}/lib/%s\n' "$base" >> "$out/argv"
                ;;
            *) printf '%s\n' "$word" >> "$out/argv" ;;
        esac
    done
    grep -q '^{archives}$' "$out/argv" || die "the probe link did not name the probe object"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "windows",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n' "$features"
        printf '  "argv": ['
        awk '{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s\"%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/argv"
        printf ']\n}\n'
    } > "$out/kit.json"
    rm -f "$probe.exe" "$probe-aot.c" "$probe-aot.o" "$out/probe.log" "$out/dirs" "$out/argv"
    printf 'ok\n' > "$out/.complete"
}

# The Linux (glibc) kit: the runtime, the C runtime's startup objects and
# libgcc, and a stub for every shared library the probe link needs -- same
# SONAME, each symbol at the version the probe bound it to, data objects at
# their real size -- so lld links against glibc's ABI without glibc's files.
build_kit_linux() {
    features=$1
    host_out=$2
    out=$3
    note "staging the link kit"
    rm -rf "$out"
    mkdir -p "$out/lib" "$out/stubs"
    cp "$host_out/libnupp-host.a" "$out/libnupp-runtime.a"
    for object in Scrt1.o crti.o crtbeginS.o crtendS.o crtn.o; do
        found=$("$CC" -print-file-name="$object")
        [ -f "$found" ] || die "the C compiler has no $object"
        cp "$found" "$out/lib/$object"
    done
    cp "$("$CC" -print-libgcc-file-name)" "$out/lib/libgcc.a"

    probe="$out/probe"
    {
        for name in $KIT_AOT_SYMBOLS; do printf 'extern char %s[];\n' "$name"; done
        printf 'void *nupp_kit_probe[] = {\n'
        for name in $KIT_AOT_SYMBOLS; do printf '    %s,\n' "$name"; done
        printf '};\n'
    } > "$probe-aot.c"
    "$CC" -c -w -fno-builtin -fPIC -o "$probe-aot.o" "$probe-aot.c"
    set -- "$CC" -pie -o "$probe" -Wl,--whole-archive "$out/libnupp-runtime.a" "$probe-aot.o" -Wl,--no-whole-archive
    host_system_flags "$features" > "$probe-flags"
    while IFS= read -r flag; do
        [ -z "$flag" ] || set -- "$@" "$flag"
    done < "$probe-flags"
    set -- "$@" -Wl,-E
    "$@" >&2

    # NEEDED libraries, the dynamic linker, and each undefined symbol with
    # its version and type.
    readelf -d "$probe" | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p' > "$out/needed"
    interpreter=$(readelf -l "$probe" | sed -n 's/.*Requesting program interpreter: \(.*\)]/\1/p')
    readelf -V -W "$probe" | awk '
        /File: / { for (i = 1; i <= NF; i++) if ($i == "File:") file = $(i + 1) }
        /Name: / && file != "" { for (i = 1; i <= NF; i++) if ($i == "Name:") print $(i + 1), file }
    ' | sort -u > "$out/versions"
    readelf --dyn-syms -W "$probe" | awk '$7 == "UND" && $8 != "" { print $4, $8 }' | sort -u > "$out/undefined"
    : > "$out/flags"
    while IFS= read -r soname; do
        # Where the real library is, for data symbols' sizes.
        real=$("$CC" -print-file-name="$soname")
        [ -f "$real" ] || real=$(ldconfig -p 2>/dev/null | awk -v n="$soname" '$1 == n { print $NF; exit }')
        stub="$out/stubs/$soname"
        : > "$stub.c"
        : > "$stub.map"
        awk -v lib="$soname" '$2 == lib { print $1 }' "$out/versions" | while IFS= read -r version; do
            printf '%s {\n' "$version" >> "$stub.map"
            awk -v v="$version" '{ split($2, parts, "@"); if (parts[2] == v) print $1, parts[1] }' "$out/undefined" \
                | while read -r kind symbol; do
                    printf '  %s;\n' "$symbol" >> "$stub.map"
                    if [ "$kind" = OBJECT ] || [ "$kind" = TLS ]; then
                        size=$(readelf --dyn-syms -W "$real" 2>/dev/null \
                            | awk -v s="$symbol@@$version" -v t="$symbol@$version" '$8 == s || $8 == t { print $3; exit }')
                        [ -n "$size" ] || size=8
                        if [ "$kind" = TLS ]; then
                            printf '__thread char %s[%s];\n' "$symbol" "$size" >> "$stub.c"
                        else
                            printf 'char %s[%s];\n' "$symbol" "$size" >> "$stub.c"
                        fi
                    else
                        printf 'void %s(void) {}\n' "$symbol" >> "$stub.c"
                    fi
                done
            printf '};\n' >> "$stub.map"
        done
        "$CC" -shared -nostdlib -fPIC -w -fno-builtin -o "$out/lib/$soname" "$stub.c" \
            -Wl,--version-script="$stub.map" -Wl,-soname,"$soname"
        printf '%s\n' "$soname" >> "$out/flags"
    done < "$out/needed"

    {
        printf '{\n  "schemaVersion": 1,\n  "platform": "linux",\n  "target": "%s",\n' "$(kit_target)"
        printf '  "features": "%s",\n  "runtime": "libnupp-runtime.a",\n' "$features"
        printf '  "interpreter": "%s",\n' "$interpreter"
        printf '  "startup": ["lib/Scrt1.o", "lib/crti.o", "lib/crtbeginS.o"],\n'
        printf '  "finish": ["lib/libgcc.a", "lib/crtendS.o", "lib/crtn.o"],\n'
        printf '  "libraries": ['
        awk '{ printf "%s\"lib/%s\"", (NR > 1 ? ", " : ""), $0 }' "$out/flags"
        printf ']\n}\n'
    } > "$out/kit.json"
    rm -rf "$probe" "$probe-aot.c" "$probe-aot.o" "$probe-flags" "$out/needed" "$out/versions" \
        "$out/undefined" "$out/flags" "$out/stubs"
    printf 'ok\n' > "$out/.complete"
}

# --- LLVM ---------------------------------------------------------------------

# The configuration of the pinned LLVM. Every line decides what the libraries
# contain, so the list is part of the cache key: change a line and the next
# request builds beside the old tree rather than over it.
llvm_cmake_options() {
    cat <<'OPTIONS'
-DCMAKE_BUILD_TYPE=MinSizeRel
-DLLVM_TARGETS_TO_BUILD=AArch64;X86;WebAssembly
-DLLVM_ENABLE_PROJECTS=lld
-DLLD_BUILD_TOOLS=OFF
-DLLVM_BUILD_TOOLS=OFF
-DLLVM_INCLUDE_TESTS=OFF
-DLLVM_INCLUDE_EXAMPLES=OFF
-DLLVM_INCLUDE_BENCHMARKS=OFF
-DLLVM_INCLUDE_DOCS=OFF
-DLLVM_INCLUDE_UTILS=OFF
-DLLVM_ENABLE_BINDINGS=OFF
-DLLVM_ENABLE_ASSERTIONS=OFF
-DLLVM_ENABLE_ZLIB=OFF
-DLLVM_ENABLE_ZSTD=OFF
-DLLVM_ENABLE_LIBXML2=OFF
-DLLVM_ENABLE_LIBEDIT=OFF
-DLLVM_ENABLE_TERMINFO=OFF
-DLLVM_ENABLE_Z3_SOLVER=OFF
OPTIONS
    # The deployment floor LuaJIT is built for; the libraries link into the
    # same binary and must not ask for a newer macOS than it does.
    if [ "$PLATFORM" = darwin ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) printf '%s\n' -DCMAKE_OSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      printf '%s\n' -DCMAKE_OSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
    fi
    # MinGW's runtime DLLs are whichever PATH finds first, and on a runner
    # that is often another toolchain's: tablegen then dies at load
    # (0xC0000139). Tools linked statically carry their own.
    if [ "$PLATFORM" = windows ]; then
        printf '%s\n' -DCMAKE_EXE_LINKER_FLAGS=-static
    fi
}

llvm_key() {
    {
        printf '%s\n%s\n' "$LLVM_VERSION" "$LLVM_SHA256"
        llvm_cmake_options
        printf '%s\n%s\n' "$CC" "$CXX"
        "$CC" --version 2>&1 | head -n 2 || true
        "$CXX" --version 2>&1 | head -n 2 || true
        printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    } | sha256_stdin | cut -c1-16
}

# A usable tree answers llvm-config and carries lld's libraries.
llvm_complete() {
    tree=$1
    [ -f "$tree/.complete" ] || [ -n "${NUPP_LLVM_PREFIX:-}" ] || return 1
    [ -x "$tree/bin/llvm-config" ] || [ -x "$tree/bin/llvm-config.exe" ] || return 1
    for library in lldCommon lldMachO lldELF lldCOFF lldMinGW lldWasm; do
        [ -f "$tree/lib/lib$library.a" ] || return 1
    done
    return 0
}

# The pins spell their templates the way the other components' do.
LLVM_DIRECTORY=$(eval "printf '%s' \"$LLVM_DIRECTORY\"")
LLVM_URL=$(eval "printf '%s' \"$LLVM_URL\"")

# The source, extracted once per machine beside the other pinned sources.
llvm_source() {
    tree="$SOURCES/$LLVM_DIRECTORY"
    if [ -f "$tree/llvm/CMakeLists.txt" ] && [ -f "$tree/lld/CMakeLists.txt" ]; then
        printf '%s\n' "$tree"
        return 0
    fi
    file=$(archive "$LLVM_DIRECTORY" "$LLVM_URL" "$LLVM_SHA256" .tar.xz)
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$LLVM_DIRECTORY.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    # mlgo-utils holds symlinks MSYS2 cannot create, and nothing builds from it.
    tar -xJf "$file" -C "$staging" --exclude='*/mlgo-utils' \
        "$LLVM_DIRECTORY/llvm" "$LLVM_DIRECTORY/cmake" "$LLVM_DIRECTORY/third-party" \
        "$LLVM_DIRECTORY/libc" "$LLVM_DIRECTORY/lld" "$LLVM_DIRECTORY/libunwind/include" \
        || die "$LLVM_DIRECTORY.tar.xz did not extract"
    [ -f "$staging/$LLVM_DIRECTORY/llvm/CMakeLists.txt" ] \
        || die "$LLVM_DIRECTORY.tar.xz did not extract llvm/CMakeLists.txt"
    rm -rf "$tree"
    mv "$staging/$LLVM_DIRECTORY" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# The pinned LLVM, as a build tree: `bin/llvm-config`, `lib/*.a`, generated
# headers under `include`, and the source's headers found through llvm-config.
# NUPP_LLVM_PREFIX names an existing tree to use as is (it is checked, not
# built). Sets LLVM_OUT.
build_llvm() {
    if [ -n "${NUPP_LLVM_PREFIX:-}" ]; then
        llvm_complete "$NUPP_LLVM_PREFIX" \
            || die "NUPP_LLVM_PREFIX names $NUPP_LLVM_PREFIX, which has no llvm-config or lld libraries"
        LLVM_OUT=$NUPP_LLVM_PREFIX
        return 0
    fi
    out="$CACHE/llvm/$(llvm_key)"
    LLVM_OUT=$out
    LLVM_SOURCE="$SOURCES/$LLVM_DIRECTORY"
    llvm_complete "$out" && return 0
    [ "${1:-}" = available ] && return 1
    for tool in cmake ninja; do
        command -v "$tool" >/dev/null 2>&1 \
            || die "building LLVM needs $tool on PATH (and Python 3)"
    done
    take_lock "llvm-$(llvm_key)" "$out/.complete" || return 0
    llvm_complete "$out" && { release_lock; return 0; }
    source=$(llvm_source)
    LLVM_SOURCE=$source
    jobs=${NUPP_LLVM_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc 2>/dev/null || echo 4)}
    note "building LLVM $LLVM_VERSION with $CC/$CXX, $jobs jobs (this takes a while)"
    rm -rf "$out"
    mkdir -p "$out"
    set -- cmake -G Ninja -S "$(native_path "$source/llvm")" -B "$(native_path "$out")" \
        -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX"
    while IFS= read -r option; do
        set -- "$@" "$option"
    done <<EOF
$(llvm_cmake_options)
EOF
    started=$(date +%s)
    "$@" > "$out/configure.log" 2>&1 \
        || { tail -n 40 "$out/configure.log" >&2; die "configuring LLVM failed; see $out/configure.log"; }
    # llvm-config is a tool, outside `all` when LLVM_BUILD_TOOLS is off.
    ninja -C "$(native_path "$out")" -j "$jobs" all llvm-config > "$out/build.log" 2>&1 \
        || { tail -n 40 "$out/build.log" >&2; die "building LLVM failed; see $out/build.log"; }
    printf 'LLVM %s built in %ss with %s jobs\n' "$LLVM_VERSION" "$(( $(date +%s) - started ))" "$jobs" \
        > "$out/.complete"
    note "$(cat "$out/.complete")"
    release_lock
}

# --- entry ------------------------------------------------------------------

[ "$#" -ge 1 ] || usage

case "$1" in
    --prefix) native_path "$PREFIX"; exit 0 ;;
    --all)
        build_luajit
        build_luarocks
        build_lpeg
        # A checkout with no compiler needs this before it can run one, and a
        # warm is the moment to pay for it: an ordinary command in a built tree
        # never asks.
        stage0 >/dev/null
        exit 0
        ;;
    native-rust)
        build_rust_native "${2:-}"
        native_path "$RUST_NATIVE_OUT"
        exit 0
        ;;
    rust-vendor)
        provision_rust_vendor "${2:-}"
        native_path "${2:-}"
        exit 0
        ;;
    host)
        build_host stub "${2:-}"
        native_path "$HOST_OUT/nupp-host"
        exit 0
        ;;
    host-rust)
        build_rust_host binary "${2:-}"
        native_path "$RUST_HOST_OUT"
        exit 0
        ;;
    host-library)
        build_host library "${2:-}"
        native_path "$HOST_OUT"
        exit 0
        ;;
    host-link)
        host_link_features=${2:-}
        host_link_output=${3:-}
        shift 3
        link_host "$host_link_features" "$host_link_output" "$@"
        exit 0
        ;;
    kit)
        build_kit "${2:-}"
        native_path "$KIT_OUT"
        exit 0
        ;;
    kit-archive)
        # The kit as a release carries it: a gzip'd POSIX tar of the kit's
        # files, which nupp unpacks itself after checking the catalog's digest.
        [ "$#" -eq 3 ] || die "usage: scripts/toolchain kit-archive FEATURES OUTPUT"
        build_kit "$2"
        output=$(cd "$(dirname "$3")" && pwd)/$(basename "$3")
        (cd "$KIT_OUT" && find . -type f ! -name .complete | LC_ALL=C sort | sed 's|^\./||' \
            | COPYFILE_DISABLE=1 tar --format ustar -cf - -T - | gzip -9n > "$output")
        native_path "$output"
        exit 0
        ;;
    browser-sources|browser-emulator|browser-guest)
        browser_component=$1
        shift
        exec "${NUPP_PYTHON:-python3}" "$ROOT/scripts/browser-toolchain.py" "$browser_component" "$CACHE" "$@"
        ;;
    llvm)
        if [ "${2:-}" = --available ]; then
            build_llvm available || exit 1
        else
            build_llvm
        fi
        native_path "$LLVM_OUT"
        exit 0
        ;;
    -h|--help) usage ;;
esac

for component in "$@"; do
    case "$component" in
        luajit)   build_luajit;   native_path "$PREFIX/luajit" ;;
        luarocks) build_luarocks; native_path "$PREFIX/luarocks" ;;
        lpeg)     build_lpeg;     native_path "$PREFIX/lpeg" ;;
        lpeg-source) native_path "$(lpeg_source)" ;;
        llvm)     build_llvm;     native_path "$LLVM_OUT" ;;
        stage0)   stage0 ;;
        *) note "unknown component $component"; usage ;;
    esac
done
