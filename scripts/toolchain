#!/bin/sh
# Provisions the native prerequisites Nupp builds against.
#
# Nupp asks for a C and a C++ compiler. Everything else it needs to build itself
# -- the LuaJIT the compiler runs on and the LPeg the documentation renderer
# parses with -- is fetched here from a pinned source, verified against a digest,
# built with that compiler pair, and cached.
#
# This is the only thing that builds those. A component is asked for by name and
# answers with the prefix it was installed under, so a caller composes paths
# rather than knowing the layout:
#
#     scripts/toolchain luajit          # -> /path/to/.nupp-cache/toolchain/<key>/luajit
#     scripts/toolchain --all           # everything, quietly, for a cache warm
#
# Building is idempotent and cached: the second call is a directory test. The
# cache is keyed by the compilers' own version output, so switching NUPP_CC from
# clang to gcc builds beside the old answer rather than over it.

set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
. "$ROOT/scripts/toolchain.pins"

# Names shared with the archive fetching the host build already had, so a CI job
# or an offline builder that supplies pinned archives keeps working unchanged.
SOURCE_DIR=${NUPP_HOST_SOURCE_DIR:-}
SOURCE_BASE_URL=${NUPP_HOST_SOURCE_BASE_URL:-}
OFFLINE=${NUPP_HOST_OFFLINE:-}

usage() {
    cat >&2 <<'USAGE'
usage: scripts/toolchain COMPONENT...
       scripts/toolchain --all
       scripts/toolchain --prefix

Components: luajit luarocks lpeg lpeg-source
            swiftshader
            native-rust FEATURES
            rust-vendor OUTPUT
            host FEATURES, host-rust, host-library FEATURES
            host-link FEATURES OUTPUT ARCHIVE... -- LINK_FLAG...

Prints the install prefix of each component named, building it first when it is
not already cached. --all builds every component and prints nothing. --prefix
prints the root the components are installed under without building anything.

Environment:
  NUPP_CC, NUPP_CXX          the compiler pair. Probed when unset.
  NUPP_CARGO, NUPP_RUSTC     the pinned Rust toolchain. Probed when unset.
  NUPP_TOOLCHAIN_DIR         where to install. Defaults to the repository cache.
  NUPP_RUST_BUILD_DIR        Rust outputs. Defaults to build/rust.
  NUPP_RUST_VENDOR_DIR       cargo-vendor directory required by offline Rust builds.
  NUPP_HOST_SOURCE_DIR       a directory of already-downloaded pinned archives.
  NUPP_HOST_SOURCE_BASE_URL  a flat mirror to fetch archives from.
  NUPP_HOST_OFFLINE          refuse to reach the network.
USAGE
    exit 2
}

note() { printf 'toolchain: %s\n' "$*" >&2; }
die() { printf 'toolchain: %s\n' "$*" >&2; exit 1; }

# --- toolchain selection ----------------------------------------------------

# `NUPP_NATIVE_CC` named the C compiler before the toolchain names were unified.
# It remains an alias and is read only where the primary name is unset.
probe() {
    for candidate in "$@"; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

UNAME=$(uname -s 2>/dev/null || echo unknown)
case "$UNAME" in
    Darwin*)              PLATFORM=darwin ;;
    MINGW*|MSYS*|CYGWIN*) PLATFORM=windows ;;
    FreeBSD*|DragonFly*)  PLATFORM=bsd ;;
    *)                    PLATFORM=posix ;;
esac

CC=${NUPP_CC:-${NUPP_NATIVE_CC:-}}
CXX=${NUPP_CXX:-}
case "$PLATFORM" in
    # This driver uses the dependencies' GNU make builds. The hosted Windows
    # clang targets MSVC, where LuaJIT's makefile asks its linker for Unix
    # libraries such as `-lm`; the MinGW pair is the compatible default.
    windows)
        [ -n "$CC" ] || CC=$(probe gcc cc clang) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe g++ c++ clang++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
    *)
        [ -n "$CC" ] || CC=$(probe clang cc gcc) \
            || die "no C compiler found. Name one with NUPP_CC"
        [ -n "$CXX" ] || CXX=$(probe clang++ c++ g++) \
            || die "no C++ compiler found. Name one with NUPP_CXX"
        ;;
esac

command -v "$CC" >/dev/null 2>&1 || die "NUPP_CC names $CC, which is not on PATH"
command -v "$CXX" >/dev/null 2>&1 || die "NUPP_CXX names $CXX, which is not on PATH"

case "$PLATFORM" in
    bsd) MAKE=${MAKE:-gmake} ;;
    *)   MAKE=${MAKE:-make} ;;
esac

# Paths printed to a caller can leave the MSYS shell and be handed directly to
# a native Windows process. Give those consumers the drive-letter spelling;
# Git Bash accepts it too. Tests that emulate Windows on another host have no
# cygpath and keep their host spelling.
native_path() {
    if [ "$PLATFORM" = windows ] && command -v cygpath >/dev/null 2>&1; then
        cygpath -m "$1"
    else
        printf '%s\n' "$1"
    fi
}

# --- digests ----------------------------------------------------------------

# Whichever of these the machine has. All three answer the same question and no
# platform reliably carries a particular one.
if command -v shasum >/dev/null 2>&1; then
    sha256_stdin() { shasum -a 256 | cut -d' ' -f1; }
elif command -v sha256sum >/dev/null 2>&1; then
    sha256_stdin() { sha256sum | cut -d' ' -f1; }
elif command -v openssl >/dev/null 2>&1; then
    sha256_stdin() { openssl dgst -sha256 | sed 's/.*= *//'; }
else
    die "no sha256 tool found; install one of shasum, sha256sum or openssl"
fi
sha256() { sha256_stdin < "$1"; }

# The digest of the C host, in a fixed order. Host build directories are keyed
# on it as well as on their feature list, because a cache keyed on the request
# alone answers an edited source tree with the artifact built from the source
# it replaced.
sources_digest() {
    (cd "$ROOT" && find host/c host/include \
        -type f \( -name '*.c' -o -name '*.h' \) 2>/dev/null) \
        | LC_ALL=C sort | while IFS= read -r file; do
            printf '%s ' "$file"
            sha256 "$ROOT/$file"
        done | sha256_stdin | cut -c1-16
}

# Rust inputs have their own content key. Keeping this separate from the C
# digest means editing a crate does not rebuild LuaJIT or the C host,
# while every workspace or lock-file change does rebuild the Rust artifact.
rust_sources_digest() {
    {
        for file in Cargo.toml Cargo.lock rust-toolchain.toml .cargo/config.toml \
            scripts/toolchain scripts/toolchain.pins; do
            [ -f "$ROOT/$file" ] && printf '%s\n' "$file"
        done
        (cd "$ROOT" && find native/crates -type f \
            \( -name '*.rs' -o -name '*.c' -o -name '*.h' \
                -o -name 'Cargo.toml' -o -name 'build.rs' \) \
            2>/dev/null) || true
    } | LC_ALL=C sort | while IFS= read -r file; do
        printf '%s ' "$file"
        sha256 "$ROOT/$file"
    done | sha256_stdin | cut -c1-16
}
# --- where things go --------------------------------------------------------

# Beside the repository's common git directory, so every worktree of this
# checkout shares one build of LuaJIT rather than each paying for its own. A
# source archive with no git metadata falls back to the checkout.
if [ -n "${NUPP_TOOLCHAIN_DIR:-}" ]; then
    CACHE=$NUPP_TOOLCHAIN_DIR
else
    COMMON=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    if [ -n "$COMMON" ]; then
        case "$COMMON" in
            /*|[A-Za-z]:*) ;;
            *) COMMON="$ROOT/$COMMON" ;;
        esac
        CACHE="$(dirname "$COMMON")/.nupp-cache/toolchain"
    else
        CACHE="$ROOT/build/toolchain"
    fi
fi

ARCHIVES="$CACHE/archives"
SOURCES="$CACHE/sources"

# What the answer depends on: the compilers, their versions, the machine, and
# these provisioning rules. Several change without a native source changing;
# ignoring one can return an artifact built with another compiler or link line.
key_material() {
    printf '%s\n%s\n' "$CC" "$CXX"
    "$CC" --version 2>&1 | head -n 2 || true
    "$CXX" --version 2>&1 | head -n 2 || true
    printf '%s %s\n' "$UNAME" "$(uname -m 2>/dev/null || echo unknown)"
    sha256 "$ROOT/scripts/toolchain"
    sha256 "$ROOT/scripts/toolchain.pins"
}
KEY=$(key_material | sha256_stdin | cut -c1-16)
PREFIX="$CACHE/$KEY"
RUST_BUILD_ROOT=${NUPP_RUST_BUILD_DIR:-"$ROOT/build/rust"}

# --- fetching ---------------------------------------------------------------

download() {
    url=$1 destination=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --silent --show-error --output "$destination" "$url"
    elif command -v wget >/dev/null 2>&1; then
        wget --quiet --output-document "$destination" "$url"
    else
        die "no downloader found; install curl or wget"
    fi
}

offline() {
    case "$OFFLINE" in
        1|true|yes|on|TRUE|YES|ON) return 0 ;;
        ""|0|false|no|off|FALSE|NO|OFF) return 1 ;;
        *) die "NUPP_HOST_OFFLINE must be one of 1, true, yes, on, 0, false, no or off" ;;
    esac
}

# One pinned archive, in the cache, verified. A digest is checked before a byte
# is unpacked, so a mirror that served something else is refused rather than
# compiled.
archive() {
    name=$1 url=$2 digest=$3 suffix=${4:-.tar.gz}
    file="$ARCHIVES/$name$suffix"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi

    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name$suffix" ]; then
        cp "$SOURCE_DIR/$name$suffix" "$file.$$"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name$suffix is not cached; put the pinned archive in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name$suffix"
        fi
        note "fetching $name"
        download "$url" "$file.$$" || { rm -f "$file.$$"; die "cannot download $url"; }
    fi

    found=$(sha256 "$file.$$")
    if [ "$found" != "$digest" ]; then
        rm -f "$file.$$"
        die "$name has digest $found, expected $digest; refusing to cache or compile it"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One pinned file, verified. Not every source is an archive: a single-header
# library is a handful of loose files, and unpacking one would mean requiring an
# archive tool this does not otherwise need.
pinned_file() {
    name=$1 url=$2 digest=$3
    file="$ARCHIVES/$name"
    if [ -f "$file" ] && [ "$(sha256 "$file")" = "$digest" ]; then
        printf '%s\n' "$file"
        return 0
    fi
    mkdir -p "$ARCHIVES"
    if [ -n "$SOURCE_DIR" ] && [ -f "$SOURCE_DIR/$name" ]; then
        cp "$SOURCE_DIR/$name" "$file.$$"
    elif offline; then
        die "NUPP_HOST_OFFLINE is set and $name is not cached; put the pinned file in NUPP_HOST_SOURCE_DIR"
    else
        if [ -n "$SOURCE_BASE_URL" ]; then
            url="${SOURCE_BASE_URL%/}/$name"
        fi
        note "fetching $name"
        download "$url" "$file.$$" || { rm -f "$file.$$"; die "cannot download $url"; }
    fi
    found=$(sha256 "$file.$$")
    if [ "$found" != "$digest" ]; then
        rm -f "$file.$$"
        die "$name has digest $found, expected $digest; refusing to cache or compile it"
    fi
    mv "$file.$$" "$file"
    printf '%s\n' "$file"
}

# One extracted source tree. Extraction is into a temporary sibling and renamed,
# so a killed run never leaves a half-unpacked tree a later one trusts.
source_tree() {
    name=$1 url=$2 digest=$3 marker=$4 suffix=${5:-.tar.gz}
    tree="$SOURCES/$name"
    if [ -f "$tree/$marker" ]; then
        printf '%s\n' "$tree"
        return 0
    fi

    file=$(archive "$name" "$url" "$digest" "$suffix")
    mkdir -p "$SOURCES"
    staging="$SOURCES/.$name.$$"
    rm -rf "$staging"
    mkdir -p "$staging"
    case "$suffix" in
        *.bz2) tar xjf "$file" -C "$staging" ;;
        *)     tar xzf "$file" -C "$staging" ;;
    esac
    [ -f "$staging/$name/$marker" ] \
        || die "$name$suffix did not extract the expected $name/$marker"
    rm -rf "$tree"
    mv "$staging/$name" "$tree"
    rm -rf "$staging"
    printf '%s\n' "$tree"
}

# --- notices ----------------------------------------------------------------

# Each of these is MIT, and MIT asks that its notice travel with the copies. The
# sources are fetched rather than committed, so the only copy this repository
# ships is the one in `host/notices` -- and a copy that has drifted from the
# source it claims to reproduce is a false statement about what was distributed.
# Bumping a pin fails here until the notice beside it is updated too.
verify_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    [ -f "$noticeSource" ] \
        || die "the pinned source has no $noticeSource to check $notice against"
    [ -f "$committed" ] || die "host/notices/$notice is missing"
    if ! cmp -s "$noticeSource" "$committed"; then
        die "host/notices/$notice is not what $noticeSource says any more. Copy it across: the pinned source is what is distributed, and the notice beside it is what says so."
    fi
}

# LPeg ships its licence inside its manual rather than as a file, so the notice
# beside it is checked for the clauses instead of byte for byte.
verify_embedded_notice() {
    noticeSource=$1 notice=$2
    committed="$ROOT/host/notices/$notice"
    for text in '2007-2023 Lua.org, PUC-Rio' 'Permission is hereby granted' 'THE SOFTWARE IS PROVIDED'; do
        grep -qF "$text" "$noticeSource" && grep -qF "$text" "$committed" \
            || die "host/notices/$notice no longer agrees with $noticeSource"
    done
}

# --- one build at a time ----------------------------------------------------

# Two commands wanting the same component start together often enough -- a test
# suite runs the launcher many times -- and they would otherwise be two makes
# writing one source tree. `mkdir` is the lock because it is atomic wherever
# this runs; the pid in it tells a held lock from one a killed build left.
LOCK=""
HOST_OUT=""
NATIVE_OUT=""
RUST_NATIVE_OUT=""
RUST_HOST_OUT=""
RUST_HOST_STATIC_OUT=""
RUST_EMBED_DYNAMIC_OUT=""
RUST_EMBED_IMPORT_OUT=""
release_lock() { [ -n "$LOCK" ] && rm -rf "$LOCK"; LOCK=""; return 0; }

take_lock() {
    lock="$CACHE/.lock-$1"
    waited=0
    mkdir -p "$CACHE"
    while ! mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -z "$holder" ] || ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        # Whoever holds it is building what this one wants, so their answer is
        # this one's answer.
        [ -f "$2" ] && return 1
        sleep 1
        waited=$((waited + 1))
        if [ "$waited" -ge 1800 ]; then
            note "another run has held $lock for ${waited}s; building without it"
            return 0
        fi
    done
    printf '%s\n' "$$" > "$lock/pid"
    LOCK=$lock
    trap 'release_lock' EXIT
    trap 'release_lock; exit 130' INT
    trap 'release_lock; exit 143' TERM
    return 0
}

# --- components -------------------------------------------------------------

# Rust is a deliberate native prerequisite, not another ambient implementation
# detail. The exact release in rust-toolchain.toml is accepted; a newer stable
# is not silently substituted, because compiler and Cargo versions participate
# in the artifact identity and can change code generation or feature solving.
select_rust_tools() {
    CARGO=${NUPP_CARGO:-cargo}
    RUSTC=${NUPP_RUSTC:-rustc}
    expected=$(sed -n 's/^channel = "\([^"]*\)"$/\1/p' "$ROOT/rust-toolchain.toml")
    [ -n "$expected" ] || die "rust-toolchain.toml names no exact channel"
    rustup_which() {
        RUSTUP_TOOLCHAIN="$expected" RUSTUP_SKIP_UPDATE_CHECK=1 \
            rustup which "$1" 2>/dev/null \
            || RUSTUP_TOOLCHAIN=stable RUSTUP_SKIP_UPDATE_CHECK=1 \
                rustup which "$1" 2>/dev/null
    }
    if [ -z "${NUPP_CARGO:-}" ] && ! command -v "$CARGO" >/dev/null 2>&1 \
        && command -v rustup >/dev/null 2>&1; then
        CARGO=$(rustup_which cargo || printf cargo)
    fi
    if [ -z "${NUPP_RUSTC:-}" ] && ! command -v "$RUSTC" >/dev/null 2>&1 \
        && command -v rustup >/dev/null 2>&1; then
        RUSTC=$(rustup_which rustc || printf rustc)
    fi
    command -v "$CARGO" >/dev/null 2>&1 \
        || die "no Cargo found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_CARGO"
    command -v "$RUSTC" >/dev/null 2>&1 \
        || die "no rustc found. Install the toolchain pinned by rust-toolchain.toml or name it with NUPP_RUSTC"

    cargo_version=$("$CARGO" --version 2>&1) \
        || die "cannot run Cargo named by NUPP_CARGO"
    rustc_version=$("$RUSTC" --version 2>&1) \
        || die "cannot run rustc named by NUPP_RUSTC"
    case "$cargo_version" in
        "cargo $expected "*) ;;
        *) die "Cargo is $cargo_version; rust-toolchain.toml requires cargo $expected" ;;
    esac
    case "$rustc_version" in
        "rustc $expected "*) ;;
        *) die "rustc is $rustc_version; rust-toolchain.toml requires rustc $expected" ;;
    esac
    rustc_verbose=$("$RUSTC" -vV 2>&1) \
        || die "cannot inspect rustc named by NUPP_RUSTC"
    rust_host=$(printf '%s\n' "$rustc_verbose" | sed -n 's/^host: //p')
    if [ "$PLATFORM" = windows ]; then
        case "$rust_host" in
            *-windows-gnu) ;;
            *) die "Rust host $rust_host is not ABI-compatible with the pinned MinGW LuaJIT; use a windows-gnu Rust toolchain" ;;
        esac
    fi
    RUST_TOOL_MATERIAL=$(printf '%s\n%s\n' "$cargo_version" "$rustc_verbose")
}

normalize_rust_features() {
    raw=${1:-}
    case "$raw" in
        *[!A-Za-z0-9_,-]*) die "invalid Rust feature list $raw" ;;
    esac
    features=$(printf '%s' "$raw" | tr ',' ' ')
    for feature in $features; do
        case "$feature" in
            *[!A-Za-z0-9_-]*) die "invalid Rust feature $feature" ;;
        esac
    done
    printf '%s\n' $features | sed '/^$/d' | LC_ALL=C sort -u \
        | tr '\n' ',' | sed 's/,$//'
}

rust_library_filename() {
    case "$PLATFORM" in
        darwin)  printf '%s\n' libnupp_native_v2.dylib ;;
        windows) printf '%s\n' nupp_native_v2.dll ;;
        *)       printf '%s\n' libnupp_native_v2.so ;;
    esac
}

# Cargo accepts ambient knobs that materially alter a binary without changing
# its source or lock file. Keep supported codegen/profile overrides in the
# content key, and reject the implicit target override because the artifact
# path and platform filename below deliberately describe the host target.
rust_environment_material() {
    [ -z "${CARGO_BUILD_TARGET:-}" ] \
        || die "CARGO_BUILD_TARGET is unsupported; Rust host builds require an explicit toolchain target design"
    env | LC_ALL=C sort | sed -n \
        -e '/^RUSTFLAGS=/p' \
        -e '/^CARGO_ENCODED_RUSTFLAGS=/p' \
        -e '/^CARGO_PROFILE_/p' \
        -e '/^CARGO_TARGET_.*_RUSTFLAGS=/p' \
        -e '/^MACOSX_DEPLOYMENT_TARGET=/p' \
        -e '/^IPHONEOS_DEPLOYMENT_TARGET=/p'
}

rust_vendor_arguments() {
    vendor=${NUPP_RUST_VENDOR_DIR:-}
    if [ -z "$vendor" ]; then
        offline && die "offline Rust builds require NUPP_RUST_VENDOR_DIR; provision it with scripts/toolchain rust-vendor OUTPUT"
        return 0
    fi
    [ -d "$vendor" ] || die "NUPP_RUST_VENDOR_DIR is not a directory: $vendor"
    printf '%s\n' \
        "source.crates-io.replace-with='nupp-vendored-sources'" \
        "source.nupp-vendored-sources.directory='$vendor'"
}

provision_rust_vendor() {
    destination=$1
    [ -n "$destination" ] || die "rust-vendor needs an output directory"
    [ ! -e "$destination" ] || die "rust-vendor refuses to replace $destination"
    select_rust_tools
    note "provisioning locked Rust sources in $destination"
    set -- "$CARGO" vendor --locked "$destination"
    offline && set -- "$@" --offline
    RUSTC="$RUSTC" "$@" >&2
}

# Rust entry points are content-addressed under the checkout's build/rust tree.
# They always build the locked workspace with default features disabled so the
# compiler-selected feature union is the dependency union.
build_rust_native() {
    sorted=$(normalize_rust_features "${1:-}")
    select_rust_tools
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-native "$sorted" "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/native/$digest"
    filename=$(rust_library_filename)
    RUST_NATIVE_OUT="$out/target/release/$filename"
    RUST_NATIVE_STATIC_OUT="$out/target/release/libnupp_native_v2.a"

    take_lock "rust-native-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && [ -f "$RUST_NATIVE_OUT" ] \
        && [ -f "$RUST_NATIVE_STATIC_OUT" ] \
        && { release_lock; return 0; }

    note "building the Rust native provider with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    cargo_action=build
    [ "$PLATFORM" = darwin ] && cargo_action=rustc
    set -- "$CARGO" "$cargo_action" \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    [ "$PLATFORM" = darwin ] && set -- "$@" --lib
    if offline; then
        set -- "$@" --offline
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    if [ -n "$sorted" ]; then
        set -- "$@" --features "$sorted"
    fi
    # rustc otherwise records the content-addressed target directory as this
    # dylib's identity. A program linked against the provider would then load
    # that cache path after the library was staged or packaged elsewhere.
    if [ "$PLATFORM" = darwin ]; then
        set -- "$@" -- -C "link-arg=-Wl,-install_name,@rpath/$filename"
    fi
    CC="$CC" CXX="$CXX" RUSTC="$RUSTC" "$@" >&2
    [ -f "$RUST_NATIVE_OUT" ] \
        || die "Cargo built nupp-native but did not write $RUST_NATIVE_OUT"
    [ -f "$RUST_NATIVE_STATIC_OUT" ] \
        || die "Cargo built nupp-native but did not write $RUST_NATIVE_STATIC_OUT"
    printf 'done\n' > "$out/.complete"
    release_lock
}

select_host_features() {
    host_feature_words=$(printf '%s' "${1:-}" | tr ',' ' ')
    host_feature_words=$(printf '%s\n' $host_feature_words | LC_ALL=C sort -u | tr '\n' ' ')
    host_cargo_features=""
    host_lpeg_prefix=""
    for feature in $host_feature_words; do
        case "$feature" in
            lpeg)
                host_lpeg_prefix=$(build_lpeg; printf '%s' "$PREFIX/lpeg")
                host_cargo_features="$host_cargo_features,lpeg"
                ;;
            workers) host_cargo_features="$host_cargo_features,workers" ;;
            native-files|files|filesystem)
                host_cargo_features="$host_cargo_features,native-files"
                ;;
            native-net|net) host_cargo_features="$host_cargo_features,native-net" ;;
            native-tls|tls) host_cargo_features="$host_cargo_features,native-tls" ;;
            native-process|process)
                host_cargo_features="$host_cargo_features,native-process"
                ;;
            base) ;;
            *) die "unknown host feature $feature" ;;
        esac
    done
    host_cargo_features=$(normalize_rust_features "${host_cargo_features#,}")
}

host_export_arguments() {
    case "$PLATFORM" in
        darwin) printf '%s\n' '-C' 'link-arg=-Wl,-export_dynamic' ;;
        windows) printf '%s\n' '-C' 'link-arg=-Wl,--export-all-symbols' ;;
        *) printf '%s\n' '-C' 'link-arg=-Wl,-E' ;;
    esac
}

embedding_library_filename() {
    case "$PLATFORM" in
        darwin) printf '%s\n' libnupp.dylib ;;
        windows) printf '%s\n' nupp.dll ;;
        *) printf '%s\n' libnupp.so ;;
    esac
}

build_rust_host() {
    host_kind=${1:-binary}
    select_host_features "${2:-}"
    select_rust_tools
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-native-host "$host_kind" "$host_cargo_features" \
            "$RUST_TOOL_MATERIAL" "$(rust_sources_digest)|$KEY"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/host-$host_kind/$digest"
    executable=nupp-host-rust
    [ "$PLATFORM" = windows ] && executable=nupp-host-rust.exe
    RUST_HOST_OUT="$out/target/release/$executable"
    RUST_HOST_STATIC_OUT="$out/target/release/libnupp_native_host.a"

    expected=$RUST_HOST_OUT
    [ "$host_kind" = application ] && expected=$RUST_HOST_STATIC_OUT
    take_lock "rust-host-$host_kind-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && [ -f "$expected" ] \
        && { release_lock; return 0; }

    note "building the Rust $host_kind host with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    set -- "$CARGO" rustc \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native-host \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    if [ "$host_kind" = application ]; then
        host_cargo_features=$(normalize_rust_features \
            "${host_cargo_features:+$host_cargo_features,}application-entry")
        set -- "$@" --lib
    else
        set -- "$@" --bin nupp-host-rust
    fi
    if offline; then
        set -- "$@" --offline
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    [ -z "$host_cargo_features" ] || set -- "$@" --features "$host_cargo_features"
    set -- "$@" -- -C link-dead-code
    if [ "$host_kind" != application ]; then
        while IFS= read -r argument; do
            set -- "$@" "$argument"
        done <<EOF
$(host_export_arguments)
EOF
    fi
    NUPP_LUAJIT_PREFIX="$PREFIX/luajit" NUPP_LPEG_PREFIX="$host_lpeg_prefix" \
        RUSTC="$RUSTC" "$@" >&2
    [ -f "$expected" ] \
        || die "Cargo built nupp-native-host but did not write $expected"
    printf 'done\n' > "$out/.complete"
    release_lock
}

build_rust_embedding() {
    luajit_prefix=$1
    embedding_features=${2:-}
    lpeg_prefix=${3:-}
    select_rust_tools
    rust_environment=$(rust_environment_material)
    digest=$({
        printf '%s|%s|%s|%s|%s\n' \
            nupp-native-embedding "$embedding_features" "$RUST_TOOL_MATERIAL" \
            "$(rust_sources_digest)" "$KEY"
        printf '%s\n' "$rust_environment"
    } | sha256_stdin | cut -c1-16)
    out="$RUST_BUILD_ROOT/embedding/$digest"
    RUST_EMBED_OUT="$out/target/release/libnupp_native_host.a"
    case "$PLATFORM" in
        darwin) cargo_dynamic=libnupp_native_host.dylib ;;
        windows)
            cargo_dynamic=nupp_native_host.dll
            RUST_EMBED_IMPORT_OUT="$out/target/release/libnupp_native_host.dll.a"
            ;;
        *) cargo_dynamic=libnupp_native_host.so ;;
    esac
    RUST_EMBED_DYNAMIC_OUT="$out/target/release/$cargo_dynamic"

    take_lock "rust-embedding-$digest" "$out/.complete" || return 0
    if [ -f "$out/.complete" ] && [ -f "$RUST_EMBED_OUT" ] \
        && [ -f "$RUST_EMBED_DYNAMIC_OUT" ]; then
        [ "$PLATFORM" != windows ] || [ -f "$RUST_EMBED_IMPORT_OUT" ] \
            || die "the cached Windows embedding SDK has no import library"
        release_lock
        return 0
    fi

    note "building the Rust embedding library with $RUSTC"
    rm -rf "$out"
    mkdir -p "$out"
    set -- "$CARGO" rustc \
        --manifest-path "$ROOT/Cargo.toml" \
        --package nupp-native-host \
        --lib \
        --release \
        --locked \
        --no-default-features \
        --target-dir "$out/target"
    if offline; then
        set -- "$@" --offline
    fi
    if [ -n "$embedding_features" ]; then
        set -- "$@" --features "$embedding_features"
    fi
    vendor_arguments=$(rust_vendor_arguments)
    if [ -n "$vendor_arguments" ]; then
        while IFS= read -r config; do
            set -- "$@" --config "$config"
        done <<EOF
$vendor_arguments
EOF
    fi
    set -- "$@" -- -C link-dead-code
    case "$PLATFORM" in
        darwin) set -- "$@" -C 'link-arg=-Wl,-install_name,@rpath/libnupp.dylib' ;;
    esac
    NUPP_LUAJIT_PREFIX="$luajit_prefix" NUPP_LPEG_PREFIX="$lpeg_prefix" \
        RUSTC="$RUSTC" "$@" >&2
    [ -f "$RUST_EMBED_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_OUT"
    [ -f "$RUST_EMBED_DYNAMIC_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_DYNAMIC_OUT"
    [ "$PLATFORM" != windows ] || [ -f "$RUST_EMBED_IMPORT_OUT" ] \
        || die "Cargo built nupp-native-host but did not write $RUST_EMBED_IMPORT_OUT"
    printf 'done\n' > "$out/.complete"
    release_lock
}

shared_flags() {
    case "$PLATFORM" in
        darwin)  printf '%s' "-bundle -undefined dynamic_lookup" ;;
        windows) printf '%s' "-shared" ;;
        *)       printf '%s' "-shared" ;;
    esac
}

module_extension() {
    case "$PLATFORM" in
        windows) printf '%s' ".dll" ;;
        *)       printf '%s' ".so" ;;
    esac
}

build_luajit() {
    out="$PREFIX/luajit"
    take_lock luajit "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory="LuaJIT-$LUAJIT_REV"
    url="https://github.com/LuaJIT/LuaJIT/archive/$LUAJIT_REV.tar.gz"
    tree=$(source_tree "$directory" "$url" "$LUAJIT_SHA256" "$LUAJIT_MARKER")
    verify_notice "$tree/COPYRIGHT" LuaJIT-COPYRIGHT.txt

    note "building LuaJIT with $CC"
    rm -rf "$out"
    # LuaJIT bakes its module search paths in at compile time, so the prefix has
    # to be the one it is installed under rather than one it is copied to. It
    # also refuses to guess an Apple deployment target, preferring to stop over
    # producing something that runs here and nowhere else.
    if [ "$PLATFORM" = darwin ] && [ -z "${MACOSX_DEPLOYMENT_TARGET:-}" ]; then
        case "$(uname -m 2>/dev/null)" in
            x86_64) MACOSX_DEPLOYMENT_TARGET=10.14 ;;
            *)      MACOSX_DEPLOYMENT_TARGET=11.0 ;;
        esac
        export MACOSX_DEPLOYMENT_TARGET
    fi
    "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
    "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" XCFLAGS=-fPIC >&2
    "$MAKE" -C "$tree" PREFIX="$out" install >&2

    # LuaJIT's top-level install recipe only knows the Unix artifact names.
    # Its Windows build is deliberately dynamic so C modules bind to the same
    # VM as the interpreter, but that leaves lua51.dll and its import library
    # in the source tree. Stage both, then make the static archive separately:
    # standalone Nupp hosts carry their VM and cannot depend on a sibling DLL.
    if [ "$PLATFORM" = windows ]; then
        [ -f "$tree/src/lua51.dll" ] \
            || die "LuaJIT's Windows build produced no lua51.dll"
        [ -f "$tree/src/libluajit-5.1.dll.a" ] \
            || die "LuaJIT's Windows build produced no import library"
        cp "$tree/src/lua51.dll" "$out/bin/lua51.dll"
        cp "$tree/src/luajit.exe" "$out/bin/luajit.exe"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/libluajit-5.1.dll.a"
        cp "$tree/src/libluajit-5.1.dll.a" \
            "$out/lib/liblua51.a"

        "$MAKE" -C "$tree" clean >/dev/null 2>&1 || true
        "$MAKE" -C "$tree" PREFIX="$out" CC="$CC" HOST_CC="$CC" \
            XCFLAGS=-fPIC BUILDMODE=static >&2
        [ -f "$tree/src/libluajit.a" ] \
            || die "LuaJIT's Windows static build produced no archive"
        cp "$tree/src/libluajit.a" "$out/lib/libluajit-5.1.a"

        # The same Unix-only install recipe leaves the interpreter's own Lua
        # modules behind. `jit.vmdef` is what the bytecode reader loads and
        # `jit.zone` is what the profiler does, so without them every question
        # about a trace answered "module not found" rather than answering.
        #
        # Beside the executable, because that is where this interpreter looks:
        # the Unix build compiles in a prefix and finds `share/luajit-2.1`, and
        # the Windows one searches `<exedir>\lua\?.lua`. Staged under the
        # prefix as well, for anything reading the tree rather than running it.
        for jit_dir in "$out/bin/lua/jit" "$out/share/luajit-2.1/jit"; do
            mkdir -p "$jit_dir"
            cp "$tree/src/jit/"*.lua "$jit_dir/"
            [ -f "$jit_dir/vmdef.lua" ] \
                || die "LuaJIT's Windows build staged no jit/vmdef.lua"
        done
    fi

    # `luajit` itself is a versioned name plus a symlink upstream only makes on
    # some platforms, and everything here runs the plain one.
    if [ ! -x "$out/bin/luajit" ]; then
        for candidate in "$out"/bin/luajit-*; do
            [ -x "$candidate" ] || continue
            ln -sf "$(basename "$candidate")" "$out/bin/luajit"
            break
        done
    fi
    [ -x "$out/bin/luajit" ] || die "LuaJIT installed no interpreter under $out/bin"

    # Where the headers landed, which is a versioned directory, said once here so
    # nothing downstream has to know the version.
    include=$(find "$out/include" -maxdepth 1 -type d -name 'luajit-*' | head -n 1)
    [ -n "$include" ] || include="$out/include"
    native_path "$include" > "$out/.include"
    printf 'done\n' > "$out/.complete"
    release_lock
}

luajit_include() {
    build_luajit
    cat "$PREFIX/luajit/.include"
}

build_luarocks() {
    out="$PREFIX/luarocks"
    luajit=$(build_luajit; printf '%s' "$PREFIX/luajit")
    include=$(cat "$luajit/.include")
    take_lock luarocks "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    directory="luarocks-$LUAROCKS_VERSION"
    url="https://github.com/luarocks/luarocks/archive/refs/tags/v$LUAROCKS_VERSION.tar.gz"
    tree=$(source_tree "$directory" "$url" "$LUAROCKS_SHA256" "$LUAROCKS_MARKER")

    note "installing LuaRocks"
    rm -rf "$out"
    if [ "$PLATFORM" = windows ]; then
        outWindows=$(cygpath -w "$out")
        rocksWindows=$(cygpath -w "$ROOT/.rocks")
        binWindows=$(cygpath -w "$luajit/bin")
        includeWindows=$(cygpath -w "$include")
        libWindows=$(cygpath -w "$luajit/lib")
        # Git Bash otherwise rewrites switches such as /P and /TREE as paths
        # before the batch installer sees them.
        (cd "$tree" && MSYS2_ARG_CONV_EXCL='*' cmd.exe /d /c call install.bat \
            /P "$outWindows" /TREE "$rocksWindows" \
            /LV 5.1 /INC "$includeWindows" /LIB "$libWindows" \
            /BIN "$binWindows" /MW /Q /F /NOREG /NOADMIN \
            /FORCECONFIG) >&2
    else
        (cd "$tree" && ./configure \
            --prefix="$out" \
            --rocks-tree="$ROOT/.rocks" \
            --lua-version=5.1 \
            --with-lua-bin="$luajit/bin" \
            --with-lua-include="$include" \
            --with-lua-lib="$luajit/lib" \
            --with-lua-interpreter=luajit \
            --force-config && "$MAKE" install) >&2
    fi
    case "$PLATFORM" in
        windows) executable="$out/luarocks.bat" ;;
        *) executable="$out/bin/luarocks" ;;
    esac
    [ -f "$executable" ] || die "LuaRocks installed no executable under $out"
    native_path "$executable" > "$out/.executable"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# LPeg is built straight from its sources. It is a handful of files against the
# Lua headers, and naming them is shorter than teaching its build system where
# the staged LuaJIT is.
build_lua_module() {
    name=$1 out=$2 tree=$3 include=$4
    shift 4
    objects=""
    for file in "$@"; do
        object="$out/objects/$(basename "$file" .c).o"
        mkdir -p "$out/objects"
        "$CC" -c -O2 -fPIC -w -DNDEBUG -I"$include" -o "$object" "$tree/$file" >&2
        objects="$objects $object"
    done
    mkdir -p "$out/lib"
    # Both shapes, because both are wanted: a loadable module for an interpreter
    # that requires it, and an archive for a host that links it in.
    # shellcheck disable=SC2086
    luaLibrary=""
    if [ "$PLATFORM" = windows ]; then
        luaLibrary="$PREFIX/luajit/lib/libluajit-5.1.dll.a"
    fi
    "$CC" $(shared_flags) -o "$out/lib/$name$(module_extension)" \
        $objects $luaLibrary >&2
    # shellcheck disable=SC2086
    ar rcs "$out/lib/lib$name.a" $objects
}

# The pinned, verified LPeg source tree. A caller that compiles LPeg with a
# compiler of its own -- the playground's Emscripten host links it into the
# application VM, where a loadable C module is not a thing that exists -- wants
# the sources rather than this machine's build of them, and wants them fetched
# through the same pin and the same notice check.
lpeg_source() {
    directory="lpeg-$LPEG_VERSION"
    url="https://www.inf.puc-rio.br/~roberto/lpeg/lpeg-$LPEG_VERSION.tar.gz"
    tree=$(source_tree "$directory" "$url" "$LPEG_SHA256" "$LPEG_MARKER")
    verify_embedded_notice "$tree/lpeg.html" LPeg-LICENSE.txt
    printf '%s\n' "$tree"
}

build_lpeg() {
    out="$PREFIX/lpeg"
    # Before the lock, not inside it: these locks do not nest, and building
    # LuaJIT under the LPeg lock would release the LPeg one on its way out.
    include=$(luajit_include)
    tree=$(lpeg_source)
    take_lock lpeg "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }

    note "building LPeg with $CC"
    rm -rf "$out"
    build_lua_module lpeg "$out" "$tree" "$include" \
        lpvm.c lpcap.c lptree.c lpcode.c lpprint.c lpcset.c
    # The official frontend is Lua, and a caller that wants `re` wants it beside
    # the module it parses with.
    mkdir -p "$out/share"
    cp "$tree/re.lua" "$out/share/re.lua"
    printf 'done\n' > "$out/.complete"
    release_lock
}

build_swiftshader() {
    out="$PREFIX/swiftshader"
    take_lock swiftshader "$out/.complete" || return 0
    [ -f "$out/.complete" ] && { release_lock; return 0; }
    command -v cmake >/dev/null 2>&1 || die "building SwiftShader needs cmake"

    directory="swiftshader-$SWIFTSHADER_REV"
    url="https://github.com/google/swiftshader/archive/$SWIFTSHADER_REV.tar.gz"
    tree=$(source_tree "$directory" "$url" "$SWIFTSHADER_SHA256" "$SWIFTSHADER_MARKER")

    note "building the pinned SwiftShader Vulkan ICD with $CXX"
    rm -rf "$out"
    cmake -S "$tree" -B "$out/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DSWIFTSHADER_BUILD_TESTS=OFF \
        -DSWIFTSHADER_BUILD_BENCHMARKS=OFF \
        -DSWIFTSHADER_BUILD_WSI_XCB=OFF \
        -DSWIFTSHADER_BUILD_WSI_WAYLAND=OFF >&2
    cmake --build "$out/build" --target vk_swiftshader \
        --parallel "${NUPP_TOOLCHAIN_JOBS:-4}" >&2
    icd=$(find "$out/build" -name vk_swiftshader_icd.json -type f | head -n 1)
    [ -n "$icd" ] || die "SwiftShader produced no Vulkan ICD manifest"
    native_path "$icd" > "$out/.icd"
    printf 'done\n' > "$out/.complete"
    release_lock
}

# --- the host ------------------------------------------------------------

# Stages the Rust executable and static application entry, or the Rust embedding
# SDK, for one exact compiler-selected feature set.
build_host() {
    kind=$1
    features=${2:-}
    select_host_features "$features"
    selected_cargo_features=$host_cargo_features
    selected_lpeg_prefix=$host_lpeg_prefix
    digest=$(printf '%s|%s|%s|%s' \
        "$kind" "$selected_cargo_features" "$(sources_digest)" "$(rust_sources_digest)" \
        | sha256_stdin | cut -c1-16)
    out="$PREFIX/host/$digest"
    HOST_OUT="$out"
    stage_out=$out
    stage_digest=$digest
    luajit_prefix=$(build_luajit; printf '%s' "$PREFIX/luajit")

    if [ "$kind" = library ]; then
        build_rust_embedding "$luajit_prefix" "$selected_cargo_features" "$selected_lpeg_prefix"
        rust_embedding=$RUST_EMBED_OUT
        rust_dynamic=$RUST_EMBED_DYNAMIC_OUT
        dynamic_name=$(embedding_library_filename)
        out=$stage_out
        digest=$stage_digest
        HOST_OUT=$out

        take_lock "host-$digest" "$out/.complete" || return 0
        [ -f "$out/.complete" ] && [ -f "$out/libnupp.a" ] \
            && [ -f "$out/$dynamic_name" ] && { release_lock; return 0; }
        note "staging the Rust embedding SDK"
        rm -rf "$out"
        mkdir -p "$out"
        cp "$rust_embedding" "$out/libnupp.a"
        cp "$rust_dynamic" "$out/$dynamic_name"
        if [ "$PLATFORM" = windows ]; then
            cp "$RUST_EMBED_IMPORT_OUT" "$out/libnupp.dll.a"
        fi
        cp "$ROOT/host/include/nupp.h" "$out/nupp.h"
        {
            printf '{\n  "schemaVersion": 1,\n'
            printf '  "features": "%s",\n' "$selected_cargo_features"
            printf '  "header": "nupp.h",\n'
            printf '  "static": "libnupp.a",\n'
            if [ "$PLATFORM" = windows ]; then
                printf '  "dynamic": "%s",\n' "$dynamic_name"
                printf '  "import": "libnupp.dll.a"\n}\n'
            else
                printf '  "dynamic": "%s"\n}\n' "$dynamic_name"
            fi
        } > "$out/link.json"
        printf 'done\n' > "$out/.complete"
        release_lock
        HOST_OUT=$out
        return 0
    fi

    build_rust_host binary "$features"
    rust_executable=$RUST_HOST_OUT
    build_rust_host application "$features"
    rust_application=$RUST_HOST_STATIC_OUT
    out=$stage_out
    digest=$stage_digest
    HOST_OUT=$out

    take_lock "host-$digest" "$out/.complete" || return 0
    [ -f "$out/.complete" ] && [ -f "$out/nupp-host" ] \
        && [ -f "$out/libnupp-host.a" ] && { release_lock; return 0; }
    note "staging the Rust application host"
    rm -rf "$out"
    mkdir -p "$out"
    cp "$rust_executable" "$out/nupp-host"
    cp "$rust_application" "$out/libnupp-host.a"
    chmod +x "$out/nupp-host" 2>/dev/null || true
    printf 'done\n' > "$out/.complete"
    release_lock
    HOST_OUT="$out"
}

# Relinks the Rust application host with application-owned static archives. The
# archive list comes before `--`; everything after it is an ordinary trailing
# linker argument. Both archives are force-loaded: the Rust host owns `main`
# and provider exports, while FFI gives application archives no relocations.
link_host() {
    features=${1:-}
    output=${2:-}
    [ -n "$output" ] || die "host-link needs an output path"
    shift 2

    build_host stub "$features"
    host_out=$HOST_OUT
    archives=""
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
        archives="$archives
$1"
        shift
    done
    [ "$#" -eq 0 ] || shift
    flags_file="$output.nupp-link-flags.$$"
    trap 'rm -f "$flags_file"' EXIT HUP INT TERM
    : > "$flags_file"
    while [ "$#" -gt 0 ]; do
        printf '%s\n' "$1" >> "$flags_file"
        shift
    done

    # Construct argv with `set --` so cache and project paths containing spaces
    # remain one linker argument.
    set -- "$CC" -o "$output"
    case "$PLATFORM" in
        darwin) set -- "$@" "-Wl,-force_load,$host_out/libnupp-host.a" ;;
        *) set -- "$@" -Wl,--whole-archive "$host_out/libnupp-host.a" -Wl,--no-whole-archive ;;
    esac

    if [ -n "$archives" ]; then
        case "$PLATFORM" in
            darwin)
                while IFS= read -r archive; do
                    [ -z "$archive" ] || set -- "$@" "-Wl,-force_load,$archive"
                done <<EOF
$archives
EOF
                ;;
            *)
                set -- "$@" -Wl,--whole-archive
                while IFS= read -r archive; do
                    [ -z "$archive" ] || set -- "$@" "$archive"
                done <<EOF
$archives
EOF
                set -- "$@" -Wl,--no-whole-archive
                ;;
        esac
    fi
    while IFS= read -r flag; do
        set -- "$@" "$flag"
    done < "$flags_file"
    case "$PLATFORM" in
        darwin)
            set -- "$@" -lm -lpthread -framework CoreFoundation -framework Security
            set -- "$@" -Wl,-export_dynamic
            ;;
        windows)
            set -- "$@" -lpthread -lpsapi -luser32 -ladvapi32 -liphlpapi -luserenv
            set -- "$@" -lws2_32 -ldbghelp -lole32 -lshell32 -lbcrypt -lcrypt32 -Wl,--export-all-symbols
            ;;
        *)       set -- "$@" -lm -lpthread -ldl -Wl,-E ;;
    esac
    "$@" >&2
    rm -f "$flags_file"
    trap - EXIT HUP INT TERM
    native_path "$output"
}

# --- entry ------------------------------------------------------------------

[ "$#" -ge 1 ] || usage

case "$1" in
    --prefix) native_path "$PREFIX"; exit 0 ;;
    --all)
        build_luajit
        build_luarocks
        build_lpeg
        exit 0
        ;;
    native-rust)
        build_rust_native "${2:-}"
        native_path "$RUST_NATIVE_OUT"
        exit 0
        ;;
    rust-vendor)
        provision_rust_vendor "${2:-}"
        native_path "${2:-}"
        exit 0
        ;;
    host)
        build_host stub "${2:-}"
        native_path "$HOST_OUT/nupp-host"
        exit 0
        ;;
    host-rust)
        build_rust_host binary "${2:-}"
        native_path "$RUST_HOST_OUT"
        exit 0
        ;;
    host-library)
        build_host library "${2:-}"
        native_path "$HOST_OUT"
        exit 0
        ;;
    host-link)
        host_link_features=${2:-}
        host_link_output=${3:-}
        shift 3
        link_host "$host_link_features" "$host_link_output" "$@"
        exit 0
        ;;
    -h|--help) usage ;;
esac

for component in "$@"; do
    case "$component" in
        luajit)   build_luajit;   native_path "$PREFIX/luajit" ;;
        luarocks) build_luarocks; native_path "$PREFIX/luarocks" ;;
        lpeg)     build_lpeg;     native_path "$PREFIX/lpeg" ;;
        lpeg-source) native_path "$(lpeg_source)" ;;
        swiftshader) build_swiftshader; cat "$PREFIX/swiftshader/.icd" ;;
        *) note "unknown component $component"; usage ;;
    esac
done
