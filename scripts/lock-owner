#!/bin/sh
# Who holds a lock directory, said firmly enough to tell a live holder from a
# pid that merely came round again.
#
#   lock-owner claim DIR PID              record PID as the holder of DIR
#   lock-owner claim DIR --windows-pid N  the same for a native Windows process
#   lock-owner holder DIR                 print the holder's pid; exit 1 when
#                                         DIR was abandoned and may be taken
#
# The caller makes DIR with `mkdir`, which is atomic wherever this runs, and
# claims it at once. A pid alone does not identify the holder. A container
# killed while it held a lock in a checkout it shared left pid 7 there, and the
# next container's launcher was pid 7 too: it found its own pid alive and
# waited on itself for an hour. A reboot reuses pids the same way. So the claim
# also records the holder's identity: its start time, plus on Linux the boot and
# the pid namespace it was counted in. A holder whose pid is alive with another
# identity is somebody else, and its lock is abandoned.
#
# A live holder is never mistaken for an abandoned one on the host that took
# the lock: its identity reads the same however often it is read. Where it cannot
# be read the pid alone decides, as it did before identities were recorded.
# bin/nupp, scripts/toolchain, scripts/native-producer and scripts/vm-cli share
# this, so a lock one takes reads the same to the others.
set -u

# Sets IDENTITY to that of process `$1` as this host sees it, or to nothing
# when it cannot be read. Shell builtins where they do: on Windows every
# process started costs a tenth of a second or more, and a claim made slowly
# delays the build it guards.
identity() {
    IDENTITY=
    if [ -r "/proc/$1/stat" ]; then
        # Field 22, its start in clock ticks since boot. The command name before
        # it is parenthesized and may hold spaces, so count from its end.
        IFS= read -r stat < "/proc/$1/stat" || return 0
        set -f
        set -- ${stat##*) }
        set +f
        [ "$#" -ge 20 ] || return 0
        start=${20}
        # Containers share the kernel's boot id but each counts its own pids.
        boot=
        [ -r /proc/sys/kernel/random/boot_id ] && read -r boot < /proc/sys/kernel/random/boot_id
        namespace=
        [ -e /proc/self/ns/pid ] && namespace=$(readlink /proc/self/ns/pid 2>/dev/null)
        IDENTITY="$start${boot:+ $boot}${namespace:+ $namespace}"
    else
        # Wall-clock time, so a reboot changes it. Pinned to one locale and
        # zone, so a waiter with another environment reads the same text.
        IDENTITY=$(LC_ALL=C TZ=UTC0 ps -o lstart= -p "$1" 2>/dev/null | awk 'NF { $1 = $1; print; exit }')
    fi
}

claim() {
    pid=$2
    if [ "$pid" = --windows-pid ]; then
        # A native process has an MSYS pid too, the one kill and /proc know it by.
        pid=$(grep -lx "$3" /proc/[0-9]*/winpid 2>/dev/null | sed -n '1s,^/proc/\([0-9]*\)/winpid$,\1,p')
        [ -n "$pid" ] || pid=$3
    fi
    identity "$pid"
    # The identity is written whole before the pid, so a waiter that reads the
    # pid reads all of it.
    printf '%s\n' "$IDENTITY" > "$1/identity" && printf '%s\n' "$pid" > "$1/pid"
}

holder() {
    # Its holder claims it just after making it, a moment that a slow machine
    # stretches; a lock with no pid for longer than that was abandoned.
    waited=0
    pid=
    until [ -r "$1/pid" ] && IFS= read -r pid < "$1/pid" && [ -n "$pid" ]; do
        [ -d "$1" ] && [ "$waited" -lt 10 ] || return 1
        sleep 1
        waited=$((waited + 1))
    done
    case "$pid" in *[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    recorded=
    [ -r "$1/identity" ] && IFS= read -r recorded < "$1/identity"
    if [ -n "$recorded" ]; then
        identity "$pid"
        [ -z "$IDENTITY" ] || [ "$IDENTITY" = "$recorded" ] || return 1
    fi
    printf '%s\n' "$pid"
}

case "${1:-}" in
    claim) [ "$#" -ge 3 ] && claim "$2" "$3" "${4:-}" ;;
    holder) [ "$#" -eq 2 ] && holder "$2" ;;
    identity) [ "$#" -eq 2 ] && identity "$2" && printf '%s\n' "$IDENTITY" ;;
    *) echo "usage: lock-owner claim DIR PID | holder DIR" >&2; exit 2 ;;
esac
