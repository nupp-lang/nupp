#!/bin/sh
# The nupp launcher.
#
# Runs an explicitly selected or installed VM compiler snapshot, rebuilding the
# installed one when compiler sources change.
#
# What it cannot do is start from nothing. The compiler is written in Nupp, so
# compiling it needs a Nupp compiler, and the one it starts from is a release's
# matching runtime/image pair, fetched by `scripts/toolchain stage0-seed`
# against pinned digests, which lowers these sources into a VM compiler.
# Nothing here is committed, and nothing here is fetched until a command finds no
# VM compiler -- which, in a built tree, is never.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Autoconf writes the shell it ran under into each Makefile unquoted, and in
# Git Bash that shell reaches a native process as C:/Program Files/..., which
# the libtool command line then splits at the space. libffi's build, which
# Cargo runs for the VM, failed that way. Name the shell by its short form.
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
        if [ -z "${CONFIG_SHELL:-}" ] && command -v cygpath >/dev/null 2>&1; then
            CONFIG_SHELL=$(cygpath -m -s /usr/bin/sh.exe 2>/dev/null || true)
            [ -n "$CONFIG_SHELL" ] && export CONFIG_SHELL
        fi
        ;;
esac
# Cargo builds the compiler starts (native providers, VM runtimes) share one
# content-addressed compiler cache across worktrees when sccache is installed.
if [ -z "${RUSTC_WRAPPER:-}" ] && command -v sccache >/dev/null 2>&1; then
    RUSTC_WRAPPER=sccache
    export RUSTC_WRAPPER
fi
# A verified local VM package is an installed compiler snapshot. Publish a new
# snapshot with scripts/vm-cli install; source edits do not rebuild its workers.
# Pin the selected immutable generation in the environment before any child can
# start, so replacing `current` cannot mix compiler generations in one command.
# A checkout with no VM CLI yet builds one when a VM stage-zero image is pinned:
# the seed lowers these sources, then the emitted image lowers them once more
# on that same verified runner (`scripts/vm-cli build --seed image`).
# Concurrent commands wait for the one building.
if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] \
    && [ ! -e "$ROOT/.nupp/vm-cli/current" ] \
    && grep -q '^STAGE0_IMAGE_SHA256=..*' "$ROOT/scripts/toolchain.pins" 2>/dev/null; then
    mkdir -p "$ROOT/.nupp"
    if mkdir "$ROOT/.nupp/vm-cli-bootstrap.lock" 2>/dev/null; then
        echo "nupp: no VM compiler in this checkout; building one from the pinned stage zero" >&2
        # NUPP_VM_AUTO_LINK=0 skips linking the image's compiled code here too,
        # as it does for the rebuild below: an interpreter-only runtime.
        no_aot=
        [ "${NUPP_VM_AUTO_LINK:-1}" != 0 ] || no_aot=--no-aot
        python3 "$ROOT/scripts/vm-cli" build --seed image $no_aot >&2
        bootstrap_status=$?
        rm -rf "$ROOT/.nupp/vm-cli-bootstrap.lock"
        [ "$bootstrap_status" -eq 0 ] || exit "$bootstrap_status"
    else
        while [ -d "$ROOT/.nupp/vm-cli-bootstrap.lock" ]; do sleep 2; done
    fi
fi
# The installed VM compiler is rebuilt when its sources change, the way build/
# is below: a compiler source newer than `.nupp/vm-cli/stamp`, which every
# install leaves with the time its build started, means the generation has not
# seen that edit. The rebuild reuses what earlier emits lowered for every module
# nothing it read has changed (`nupp.tools.vm.emitcache`), lowering with the
# generation that cache was filled by (`scripts/vm-cli build --seed pinned`; an
# explicit `scripts/vm-cli build` moves the pin to the installed one). It
# installs an interpreter-only runtime and links the image's compiled code into
# a runtime in the background, which replaces that one when it is done
# (NUPP_VM_AUTO_LINK=0 skips it).
#
# One rebuild at a time per checkout, under a lock directory holding the
# builder's pid; a command that finds it held waits, and then runs what that
# build installed. A failed rebuild leaves the previous generation selected and
# says so; `.nupp/vm-cli/failed` remembers it, so later commands do not try
# again until another source changes. NUPP_VM_AUTO_REBUILD=0 turns all of this
# off, and an explicit NUPP_VM_CLI_IMAGE bypasses it, as it bypasses the
# installed generation. Only a command somebody ran asks: the workers and child
# commands a compiler starts inherit its NUPP_VM_CLI_IMAGE.
VM_CLI="$ROOT/.nupp/vm-cli"
VM_BUILD_LOCK="$ROOT/.nupp/vm-cli-build.lock"
VM_BUILD_LOCK_WAIT=${NUPP_VM_BUILD_LOCK_WAIT:-3600}

# Whether any file a VM compiler is built from is newer than `$1`.
vm_sources_newer_than() {
    [ -n "$(find "$ROOT/src" "$ROOT/templates" \
        "$ROOT/native/crates/vm/src" "$ROOT/native/crates/vm/lib" "$ROOT/native/crates/vm/decls" \
        "$ROOT/native/crates/vm/csrc" "$ROOT/native/crates/vm/build.rs" "$ROOT/native/crates/vm/Cargo.toml" \
        "$ROOT/native/crates/platform" "$ROOT/native/crates/checksum" "$ROOT/native/crates/files" \
        "$ROOT/native/crates/compression" "$ROOT/native/crates/net" "$ROOT/native/crates/tls" \
        "$ROOT/native/crates/http" "$ROOT/native/crates/abi" "$ROOT/native/crates/process" \
        "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" "$ROOT/scripts/vm-cli" "$ROOT/tests/run.lua" \
        -type f ! -name '.DS_Store' -newer "$1" 2>/dev/null | head -n 1)" ]
}

# An installation older than the stamp has its selection's time instead.
vm_cli_is_current() {
    if [ -f "$VM_CLI/stamp" ]; then
        ! vm_sources_newer_than "$VM_CLI/stamp"
    else
        ! vm_sources_newer_than "$VM_CLI/current"
    fi
}

# Every file is newer than the stamp in a fresh worktree seeded with a generation,
# yet that generation may have been built from exactly these sources. Asked only
# once the times say stale; a match refreshes the stamp so the next command does
# not ask again.
vm_cli_content_current() {
    python3 "$ROOT/scripts/vm-cli" current >/dev/null 2>&1 || return 1
    : > "$VM_CLI/stamp"
}

# A rebuild of these very sources already failed.
vm_cli_failed_unchanged() {
    [ -f "$VM_CLI/failed" ] && ! vm_sources_newer_than "$VM_CLI/failed"
}

# Its owner writes the pid just after making the directory, so a lock without
# one is given a moment before it is taken for abandoned.
vm_build_lock_alive() {
    holder=$(cat "$VM_BUILD_LOCK/pid" 2>/dev/null)
    if [ -z "$holder" ]; then
        sleep 1
        holder=$(cat "$VM_BUILD_LOCK/pid" 2>/dev/null) || return 1
    fi
    [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null
}

vm_release_build_lock() {
    rm -rf "$VM_BUILD_LOCK"
    trap - EXIT INT TERM
}

vm_notice() {
    if [ -t 2 ] && [ "${TERM:-}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;36mnupp:\033[0m %s\n' "$1" >&2
    else
        printf 'nupp: %s\n' "$1" >&2
    fi
}

vm_cli_rebuild() {
    waited=0
    while ! mkdir "$VM_BUILD_LOCK" 2>/dev/null; do
        if ! vm_build_lock_alive; then
            rm -rf "$VM_BUILD_LOCK"
            continue
        fi
        if [ -t 2 ] && { [ "$waited" -eq 3 ] || { [ "$waited" -gt 0 ] && [ $((waited % 60)) -eq 0 ]; }; }; then
            echo "nupp: waiting for the VM compiler build pid $holder is running (${waited}s so far)" >&2
        fi
        sleep 1
        waited=$((waited + 1))
        if [ "$waited" -ge "$VM_BUILD_LOCK_WAIT" ]; then
            echo "nupp: another VM compiler build has run for ${waited}s; running the installed one" >&2
            return 0
        fi
    done
    printf '%s\n' "$$" > "$VM_BUILD_LOCK/pid"
    trap 'rm -rf "$VM_BUILD_LOCK"' EXIT
    trap 'rm -rf "$VM_BUILD_LOCK"; exit 130' INT
    trap 'rm -rf "$VM_BUILD_LOCK"; exit 143' TERM
    # The build this command waited for may have been of these same sources.
    if vm_cli_is_current; then
        vm_release_build_lock
        return 0
    fi
    if vm_cli_failed_unchanged; then
        vm_release_build_lock
        echo "nupp: the VM compiler did not build from these sources (see $VM_CLI/rebuild.log);" \
            "running the last one that did" >&2
        return 0
    fi
    vm_notice "compiler sources changed, rebuilding the VM compiler"
    started=$(date +%s)
    if python3 "$ROOT/scripts/vm-cli" build --seed pinned --no-aot > "$VM_CLI/rebuild.log" 2>&1; then
        rm -f "$VM_CLI/failed"
        # The emit's own account of what it reused, when it kept a cache.
        reused=$(sed -n 's/^vm emit: \([0-9]* modules* lowered, [0-9]* replayed\).*/: \1/p' \
            "$VM_CLI/rebuild.log" | tail -n 1)
        vm_notice "rebuilt the VM compiler in $(($(date +%s) - started))s$reused"
        if [ "${NUPP_VM_AUTO_LINK:-1}" != 0 ]; then
            nohup python3 "$ROOT/scripts/vm-cli" link > "$VM_CLI/link.log" 2>&1 < /dev/null &
        fi
    else
        : > "$VM_CLI/failed"
        echo "nupp: the VM compiler did not build; running the last one that did" >&2
        tail -n 20 "$VM_CLI/rebuild.log" | sed 's/^/  /' >&2
        echo "  (the whole log is $VM_CLI/rebuild.log)" >&2
    fi
    vm_release_build_lock
}


if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] && [ -e "$VM_CLI/current" ] \
    && [ "${NUPP_VM_AUTO_REBUILD:-1}" != 0 ]; then
    case "${1:-}" in
        ""|-h|--help|help|__*) ;;
        *) vm_cli_is_current || vm_cli_content_current || vm_cli_rebuild ;;
    esac
fi

if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] && [ -e "$ROOT/.nupp/vm-cli/current" ]; then
    VM_GENERATION=$(cat "$ROOT/.nupp/vm-cli/current") || exit 1
    case "$VM_GENERATION" in
        ""|*[!0-9a-f]*) echo "nupp: invalid VM CLI package selection; run scripts/vm-cli install" >&2; exit 1 ;;
    esac
    VM_PACKAGE="$ROOT/.nupp/vm-cli/$VM_GENERATION"
    if [ "${#VM_GENERATION}" -ne 64 ] || [ "$(cat "$VM_PACKAGE/format" 2>/dev/null)" != nupp-vm-cli-1 ]; then
        echo "nupp: incomplete VM CLI package; run scripts/vm-cli install" >&2
        exit 1
    fi
    NUPP_VM_CLI_IMAGE="$VM_PACKAGE/compiler.image"
    NUPP_VM_BINARY="$VM_PACKAGE/runtime"
    # The packaged CLI disables JIT; heap-frame cleanup uses Rust dispatch. AOT remains
    # available when the supplied runtime contains it.
    NO_JIT=1
    export NUPP_VM_CLI_IMAGE NUPP_VM_BINARY NO_JIT
fi
# An explicitly selected VM image owns this whole invocation, including worker
# commands launched by the compiler. Missing artifacts are a configuration error.
if [ -n "${NUPP_VM_CLI_IMAGE:-}" ]; then
    VM_RUNTIME=${NUPP_VM_BINARY:-"$ROOT/build/rust/target/release/nupp-vm"}
    if [ ! -x "$VM_RUNTIME" ] || [ ! -f "$NUPP_VM_CLI_IMAGE" ]; then
        echo "nupp: VM CLI runtime or image is missing" >&2
        exit 1
    fi
    NUPP_COMPILER_ROOT=${NUPP_COMPILER_ROOT:-"$ROOT"}
    # A rock dependency runs LuaRocks, which is the pinned one: the shim
    # provisions it on first use. Windows starts tools natively and cannot run a
    # shell script, so there it is the installed batch file when the toolchain
    # has one, and the PATH lookup otherwise.
    if [ -z "${NUPP_LUAROCKS:-}" ]; then
        case "$(uname -s 2>/dev/null)" in
            MINGW*|MSYS*|CYGWIN*)
                prefix=$("$ROOT/scripts/toolchain" --prefix 2>/dev/null || true)
                if [ -n "$prefix" ] && [ -f "$prefix/luarocks/.complete" ] && [ -f "$prefix/luarocks/.executable" ]; then
                    NUPP_LUAROCKS=$(cat "$prefix/luarocks/.executable")
                    export NUPP_LUAROCKS
                fi
                ;;
            *) NUPP_LUAROCKS="$ROOT/scripts/luarocks"; export NUPP_LUAROCKS ;;
        esac
    fi
    # Programs `nupp run` compiles have no linked entries; a deployed no-JIT
    # host refuses their SIMD functions, the developer CLI interprets them.
    SIMD_INTERPRET=${SIMD_INTERPRET:-1}
    # What a child compiler starts on when it cannot go through this script,
    # which a Windows process cannot run (`nupp.compiler.process`).
    NUPP_VM_BINARY=$VM_RUNTIME
    NUPP_VM_CLI_ENTRY=nupp.tools.vm.root
    export NUPP_COMPILER_ROOT SIMD_INTERPRET NUPP_VM_BINARY NUPP_VM_CLI_ENTRY
    exec "$VM_RUNTIME" exec "$NUPP_VM_CLI_IMAGE" "$NUPP_VM_CLI_ENTRY" "$@"
fi
# Nothing above found or built a compiler: no VM CLI is installed, and no stage
# zero is pinned to build one from.
echo "nupp: no VM compiler in this checkout, and no pinned stage-zero image to build one with" >&2
exit 1
