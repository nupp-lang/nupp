#!/bin/sh
# The nupp launcher.
#
# Runs build/nupp/compiler when it is there and no source is newer than it, and builds it
# first when it is not, so an edit to the compiler is picked up by the next
# command rather than by the next person who remembers to build.
#
# What it cannot do is start from nothing. The compiler is written in Nupp, so
# compiling it needs a Nupp compiler; bootstrap/nupp.lua is that compiler,
# already lowered to Lua, and it is the one thing here that does not itself need
# building. A checkout without it has no way in.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILT="$ROOT/build/nupp/compiler/main.lua"
STAMP="$ROOT/build/.nupp-complete"
BOOTSTRAP="$ROOT/bootstrap/nupp.lua"

# Two spellings of the same directory, because under Git Bash they are not the
# same string. `ROOT` is the POSIX one this script tests files with; `LUA_ROOT`
# is what the interpreter and the toolchain read, and on Windows that has to be
# a native path. MSYS rewrites a path it sees as a command argument, and does
# not rewrite one it hands over as an environment value or one buried in a Lua
# string, which is every use below. `pwd -W` is how MSYS spells "natively", and
# fails everywhere else, which is the test.
LUA_ROOT="$ROOT"
if ( cd "$ROOT" && pwd -W ) >/dev/null 2>&1; then
    LUA_ROOT="$(cd "$ROOT" && pwd -W)"
fi
LUAPATH="package.path=\"$LUA_ROOT/build/?.lua;\" .. package.path"

# The project's own rock tree, from `scripts/rocks`. Exported rather than passed
# with -e, because the toolchain starts other interpreters — `nupp run`, the
# configured test command — and a library the compiler can see should be one
# they can see too. A trailing empty entry is where Lua substitutes the default
# path, so nothing already installed is hidden.
ROCKS="$LUA_ROOT/.rocks"
LUA_PATH="$ROCKS/share/lua/5.1/?.lua;$ROCKS/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
# Both suffixes, because the tree is the project's own and its extension is
# the host's: a rock built here is .so on unix and .dll on Windows, and
# naming only one leaves the other invisible.
LUA_CPATH="$ROCKS/lib/lua/5.1/?.so;$ROCKS/lib/lua/5.1/?.dll;${LUA_CPATH:-;}"
export LUA_PATH LUA_CPATH
export NUPP_COMPILER_ROOT="$LUA_ROOT"

# The compiler lists directories through `nupp.io.files`, so it needs that
# facility's native provider the way any other program using one does. A built
# program finds its library beside itself; the compiler's own output tree puts
# `build/lib` one level further out than the generated loader looks, so name it
# outright. Every interpreter this launcher starts inherits it.
export NUPP_NATIVE_LIBRARY="$LUA_ROOT/build/lib/nupp_native"
# The same file, spelled for this shell rather than for the interpreter.
NATIVE_LIBRARY="$ROOT/build/lib/nupp_native"

# Which makes Cargo a prerequisite for building Nupp at all, rather than only for
# a target that asked for a native facility. Stage 0 reaches the provider while
# listing the sources it is about to compile, so there is no ordering in which
# the compiler builds it for itself first.
NATIVE_MANIFEST="$ROOT/runtime/native/Cargo.toml"
NATIVE_TARGET="$ROOT/build/native/nupp_native"
build_native() {
    command -v cargo >/dev/null 2>&1 || {
        echo "nupp: cargo is not on PATH, and the compiler needs the native" \
            "file provider to list its own sources" >&2
        return 1
    }
    cargo build --release --manifest-path "$NATIVE_MANIFEST" \
        --target-dir "$NATIVE_TARGET" --no-default-features --features files \
        >/dev/null || return 1
    mkdir -p "$ROOT/build/lib"
    for name in libnupp_native.dylib libnupp_native.so nupp_native.dll; do
        if [ -f "$NATIVE_TARGET/release/$name" ]; then
            cp "$NATIVE_TARGET/release/$name" "$NATIVE_LIBRARY" && return 0
        fi
    done
    echo "nupp: cargo built no shared library for the file provider" >&2
    return 1
}

# Generated Nupp is written in the LuaJIT 3.0 syntax that 2.1 backported, and
# every command here either produces generated code or runs it, so an older
# interpreter cannot do the job whatever it manages to load. Saying which build
# is wanted beats a syntax error pointing at a line nobody wrote by hand.
LUAJIT_FLOOR=1784535649

check_luajit() {
    command -v luajit >/dev/null 2>&1 || {
        echo "nupp: luajit is not on PATH" >&2
        exit 1
    }
    reported=$(luajit -v 2>/dev/null | sed -n '1s/^LuaJIT \([0-9.]*\).*/\1/p')
    # Only the 2.1 series needs the rolling number looked at: 2.0 and older
    # never had the extensions, and anything past 2.1 was born with them.
    case "$reported" in
        "")             return 0 ;; # an unreadable banner proves nothing
        2.1.*)          [ "${reported#2.1.}" -ge "$LUAJIT_FLOOR" ] 2>/dev/null \
                            && return 0 ;;
        1.*|2.0*|2.1)   ;;
        *)              return 0 ;;
    esac
    echo "nupp: LuaJIT $reported is too old; 2.1.$LUAJIT_FLOOR or newer is" \
        "required for the backported syntax extensions" >&2
    exit 1
}

check_luajit

built_exists() {
    [ -f "$STAMP" ] && [ -f "$BUILT" ]
}

# The stamp is rewritten by every build, warm ones included, so one source
# newer than it means the build has not seen that edit. Checking mtimes rather
# than asking the build system costs ten milliseconds where a warm build costs
# two seconds, and this runs before every command.
built_is_current() {
    built_exists || return 1
    [ -z "$(find "$ROOT/src" -name '*.nupp' -newer "$STAMP" 2>/dev/null \
        | head -n 1)" ]
}

# With the best compiler available: the built one when there is one, since a
# compiler that has kept up with the sources is likelier to compile them than a
# bundle from whenever it was last refreshed.
#
# When that one cannot build, the bootstrap gets a turn. A build can succeed and
# still leave a compiler that does not run — that is an ordinary afternoon when
# the thing being edited is the compiler — and without the second attempt the
# only way out is knowing to delete build/ by hand.
build_now() {
    if built_exists; then
        (cd "$ROOT" && luajit -e "$LUAPATH" "$BUILT" build) && return 0
        [ -f "$BOOTSTRAP" ] || return 1
        echo "nupp: falling back to the bootstrap compiler" >&2
    fi
    [ -f "$BOOTSTRAP" ] || return 1
    (cd "$ROOT" && luajit "$BOOTSTRAP" build)
}

# `build` and `clean` are the build; running one before them would be doing
# their job twice or undoing it. `help` and a bare invocation answer without
# reading a single source file.
case "${1:-}" in
    ""|-h|--help|help) rebuild=no ;;
    build|clean)       rebuild=no ;;
    *)                 rebuild=yes ;;
esac

# Help never reads a source file, so it must keep working in a tree that has the
# tracked bootstrap and nothing else. Everything else reaches the provider the
# moment it lists a directory, and saying so beats an ffi.load traceback.
needs_native=yes
case "${1:-}" in
    ""|-h|--help|help) needs_native=no ;;
esac
for argument in "$@"; do
    case "$argument" in
        -h|--help) needs_native=no ;;
    esac
done

if [ "$needs_native" = yes ] && [ ! -f "$NATIVE_LIBRARY" ]; then
    build_native || exit 1
fi

if [ "$rebuild" = yes ] && ! built_is_current; then
    echo "nupp: sources changed, building the compiler" >&2
    if ! build_now; then
        # Mid-edit the compiler often does not compile, and that is no reason
        # for the rest of the toolchain to stop working. The last compiler that
        # did build still runs; it is just running behind, and says so.
        echo "nupp: the compiler did not build; running the last one that did" >&2
    fi
fi

if built_exists; then
    exec luajit -e "$LUAPATH" "$BUILT" "$@"
fi

if [ -f "$BOOTSTRAP" ]; then
    exec luajit "$BOOTSTRAP" "$@"
fi

echo "nupp: no completed build or bootstrap compiler found" >&2
exit 1
