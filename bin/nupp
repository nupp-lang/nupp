#!/bin/sh
# The nupp launcher.
#
# Runs an explicitly selected or installed VM compiler snapshot first. Without
# one, runs build/nupp/tools and rebuilds it when compiler sources change.
#
# What it cannot do is start from nothing. The compiler is written in Nupp, so
# compiling it needs a Nupp compiler, and the one it starts from is the previous
# release's, fetched and cached by `scripts/toolchain stage0` against a digest
# pinned in the tree. Nothing here is committed, and nothing here is fetched
# until a command finds no compiler to run -- which, in a built tree, is never.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# A verified local VM package is an installed compiler snapshot. Publish a new
# snapshot with scripts/vm-cli install; source edits do not rebuild its workers.
# Pin the selected immutable generation in the environment before any child can
# start, so replacing `current` cannot mix compiler generations in one command.
# A checkout with no VM CLI yet builds one when a VM stage-zero image is pinned:
# the image lowers these sources on a runtime built from them, once more by
# themselves, and the result is installed (`scripts/vm-cli build --seed-image`).
# Concurrent commands wait for the one building. Without an image pin this
# falls through to the LuaJIT path below, as it always has.
if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] && [ "${NUPP_ENGINE:-}" != luajit ] \
    && [ ! -e "$ROOT/.nupp/vm-cli/current" ] \
    && grep -q '^STAGE0_IMAGE_SHA256=..*' "$ROOT/scripts/toolchain.pins" 2>/dev/null; then
    mkdir -p "$ROOT/.nupp"
    if mkdir "$ROOT/.nupp/vm-cli-bootstrap.lock" 2>/dev/null; then
        echo "nupp: no VM compiler in this checkout; building one from the pinned stage zero" >&2
        seed=$("$ROOT/scripts/toolchain" stage0-image) \
            && python3 "$ROOT/scripts/vm-cli" build --seed-image "$seed" >&2
        bootstrap_status=$?
        rm -rf "$ROOT/.nupp/vm-cli-bootstrap.lock"
        [ "$bootstrap_status" -eq 0 ] || exit "$bootstrap_status"
    else
        while [ -d "$ROOT/.nupp/vm-cli-bootstrap.lock" ]; do sleep 2; done
    fi
fi
# The installed VM compiler is rebuilt when its sources change, the way build/
# is below: a compiler source newer than `.nupp/vm-cli/stamp`, which every
# install leaves with the time its build started, means the generation has not
# seen that edit. The rebuild reuses what earlier emits lowered for every module
# nothing it read has changed (`nupp.tools.vm.emitcache`), lowering with the
# generation that cache was filled by (`scripts/vm-cli build --seed pinned`; an
# explicit `scripts/vm-cli build` moves the pin to the installed one). It
# installs an interpreter-only runtime and links the image's compiled code into
# a runtime in the background, which replaces that one when it is done
# (NUPP_VM_AUTO_LINK=0 skips it).
#
# One rebuild at a time per checkout, under a lock directory holding the
# builder's pid; a command that finds it held waits, and then runs what that
# build installed. A failed rebuild leaves the previous generation selected and
# says so; `.nupp/vm-cli/failed` remembers it, so later commands do not try
# again until another source changes. NUPP_VM_AUTO_REBUILD=0 turns all of this
# off, and an explicit NUPP_VM_CLI_IMAGE bypasses it, as it bypasses the
# installed generation. Only a command somebody ran asks: the workers and child
# commands a compiler starts inherit its NUPP_VM_CLI_IMAGE.
VM_CLI="$ROOT/.nupp/vm-cli"
VM_BUILD_LOCK="$ROOT/.nupp/vm-cli-build.lock"
VM_BUILD_LOCK_WAIT=${NUPP_VM_BUILD_LOCK_WAIT:-3600}

# Whether any file a VM compiler is built from is newer than `$1`.
vm_sources_newer_than() {
    [ -n "$(find "$ROOT/src" "$ROOT/templates" \
        "$ROOT/native/crates/vm/src" "$ROOT/native/crates/vm/lib" "$ROOT/native/crates/vm/decls" \
        "$ROOT/native/crates/vm/csrc" "$ROOT/native/crates/vm/build.rs" "$ROOT/native/crates/vm/Cargo.toml" \
        "$ROOT/native/crates/platform" "$ROOT/native/crates/checksum" "$ROOT/native/crates/files" \
        "$ROOT/native/crates/compression" "$ROOT/native/crates/net" "$ROOT/native/crates/tls" \
        "$ROOT/native/crates/http" "$ROOT/native/crates/abi" "$ROOT/native/crates/process" \
        "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" "$ROOT/scripts/vm-cli" \
        -type f ! -name '.DS_Store' -newer "$1" 2>/dev/null | head -n 1)" ]
}

# An installation older than the stamp has its selection's time instead.
vm_cli_is_current() {
    if [ -f "$VM_CLI/stamp" ]; then
        ! vm_sources_newer_than "$VM_CLI/stamp"
    else
        ! vm_sources_newer_than "$VM_CLI/current"
    fi
}

# A rebuild of these very sources already failed.
vm_cli_failed_unchanged() {
    [ -f "$VM_CLI/failed" ] && ! vm_sources_newer_than "$VM_CLI/failed"
}

# Its owner writes the pid just after making the directory, so a lock without
# one is given a moment before it is taken for abandoned.
vm_build_lock_alive() {
    holder=$(cat "$VM_BUILD_LOCK/pid" 2>/dev/null)
    if [ -z "$holder" ]; then
        sleep 1
        holder=$(cat "$VM_BUILD_LOCK/pid" 2>/dev/null) || return 1
    fi
    [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null
}

vm_release_build_lock() {
    rm -rf "$VM_BUILD_LOCK"
    trap - EXIT INT TERM
}

vm_notice() {
    if [ -t 2 ] && [ "${TERM:-}" != dumb ] && [ -z "${NO_COLOR:-}" ]; then
        printf '\033[1;36mnupp:\033[0m %s\n' "$1" >&2
    else
        printf 'nupp: %s\n' "$1" >&2
    fi
}

vm_cli_rebuild() {
    waited=0
    while ! mkdir "$VM_BUILD_LOCK" 2>/dev/null; do
        if ! vm_build_lock_alive; then
            rm -rf "$VM_BUILD_LOCK"
            continue
        fi
        if [ -t 2 ] && { [ "$waited" -eq 3 ] || { [ "$waited" -gt 0 ] && [ $((waited % 60)) -eq 0 ]; }; }; then
            echo "nupp: waiting for the VM compiler build pid $holder is running (${waited}s so far)" >&2
        fi
        sleep 1
        waited=$((waited + 1))
        if [ "$waited" -ge "$VM_BUILD_LOCK_WAIT" ]; then
            echo "nupp: another VM compiler build has run for ${waited}s; running the installed one" >&2
            return 0
        fi
    done
    printf '%s\n' "$$" > "$VM_BUILD_LOCK/pid"
    trap 'rm -rf "$VM_BUILD_LOCK"' EXIT
    trap 'rm -rf "$VM_BUILD_LOCK"; exit 130' INT
    trap 'rm -rf "$VM_BUILD_LOCK"; exit 143' TERM
    # The build this command waited for may have been of these same sources.
    if vm_cli_is_current; then
        vm_release_build_lock
        return 0
    fi
    if vm_cli_failed_unchanged; then
        vm_release_build_lock
        echo "nupp: the VM compiler did not build from these sources (see $VM_CLI/rebuild.log);" \
            "running the last one that did" >&2
        return 0
    fi
    vm_notice "compiler sources changed, rebuilding the VM compiler"
    started=$(date +%s)
    if python3 "$ROOT/scripts/vm-cli" build --seed pinned --no-aot > "$VM_CLI/rebuild.log" 2>&1; then
        rm -f "$VM_CLI/failed"
        # The emit's own account of what it reused, when it kept a cache.
        reused=$(sed -n 's/^vm emit: \([0-9]* modules* lowered, [0-9]* replayed\).*/: \1/p' \
            "$VM_CLI/rebuild.log" | tail -n 1)
        vm_notice "rebuilt the VM compiler in $(($(date +%s) - started))s$reused"
        if [ "${NUPP_VM_AUTO_LINK:-1}" != 0 ]; then
            nohup python3 "$ROOT/scripts/vm-cli" link > "$VM_CLI/link.log" 2>&1 < /dev/null &
        fi
    else
        : > "$VM_CLI/failed"
        echo "nupp: the VM compiler did not build; running the last one that did" >&2
        tail -n 20 "$VM_CLI/rebuild.log" | sed 's/^/  /' >&2
        echo "  (the whole log is $VM_CLI/rebuild.log)" >&2
    fi
    vm_release_build_lock
}


if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] && [ "${NUPP_ENGINE:-}" != luajit ] && [ -e "$VM_CLI/current" ] \
    && [ "${NUPP_VM_AUTO_REBUILD:-1}" != 0 ]; then
    case "${1:-}" in
        ""|-h|--help|help|__*) ;;
        *) vm_cli_is_current || vm_cli_rebuild ;;
    esac
fi

# NUPP_ENGINE=luajit skips it, which is how `scripts/vm-cli build --seed luajit`
# reaches the LuaJIT-built compiler in a checkout that has both.
if [ -z "${NUPP_VM_CLI_IMAGE:-}" ] && [ "${NUPP_ENGINE:-}" != luajit ] && [ -e "$ROOT/.nupp/vm-cli/current" ]; then
    VM_GENERATION=$(cat "$ROOT/.nupp/vm-cli/current") || exit 1
    case "$VM_GENERATION" in
        ""|*[!0-9a-f]*) echo "nupp: invalid VM CLI package selection; run scripts/vm-cli install" >&2; exit 1 ;;
    esac
    VM_PACKAGE="$ROOT/.nupp/vm-cli/$VM_GENERATION"
    if [ "${#VM_GENERATION}" -ne 64 ] || [ "$(cat "$VM_PACKAGE/format" 2>/dev/null)" != nupp-vm-cli-1 ]; then
        echo "nupp: incomplete VM CLI package; run scripts/vm-cli install" >&2
        exit 1
    fi
    NUPP_VM_CLI_IMAGE="$VM_PACKAGE/compiler.image"
    NUPP_VM_BINARY="$VM_PACKAGE/runtime"
    # The packaged CLI disables JIT; heap-frame cleanup uses Rust dispatch. AOT remains
    # available when the supplied runtime contains it.
    NO_JIT=1
    export NUPP_VM_CLI_IMAGE NUPP_VM_BINARY NO_JIT
fi
# An explicitly selected VM image owns this whole invocation, including worker
# commands launched by the compiler. Missing artifacts are a configuration error.
if [ -n "${NUPP_VM_CLI_IMAGE:-}" ]; then
    VM_RUNTIME=${NUPP_VM_BINARY:-"$ROOT/build/rust/target/release/nupp-vm"}
    if [ ! -x "$VM_RUNTIME" ] || [ ! -f "$NUPP_VM_CLI_IMAGE" ]; then
        echo "nupp: VM CLI runtime or image is missing" >&2
        exit 1
    fi
    NUPP_COMPILER_ROOT=${NUPP_COMPILER_ROOT:-"$ROOT"}
    # The development rock tree's Lua modules (lunamark, scintillua) are found
    # the way the LuaJIT path below finds them; the VM loads no C modules.
    if [ "${NUPP_LAUNCHER_ROCKS_ROOT:-}" != "$ROOT" ]; then
        . "$ROOT/scripts/rocks.sh"
        link_development_rocks "$ROOT"
        NUPP_LAUNCHER_ROCKS_ROOT=$ROOT
        export NUPP_LAUNCHER_ROCKS_ROOT
    fi
    LUA_PATH="$ROOT/.rocks/share/lua/5.1/?.lua;$ROOT/.rocks/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
    # Programs `nupp run` compiles have no linked entries; a deployed no-JIT
    # host refuses their SIMD functions, the developer CLI interprets them.
    SIMD_INTERPRET=${SIMD_INTERPRET:-1}
    export NUPP_COMPILER_ROOT LUA_PATH SIMD_INTERPRET
    exec "$VM_RUNTIME" exec "$NUPP_VM_CLI_IMAGE" nupp.tools.vm.root "$@"
fi
LUA_ROOT="$ROOT"
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*) LUA_ROOT="$(cygpath -m "$ROOT")" ;;
esac
BUILT="$ROOT/build/nupp/tools/main.lua"
STAMP="$ROOT/build/.nupp-complete"
LUA_BUILT="$LUA_ROOT/build/nupp/tools/main.lua"
LUAPATH="package.path=\"$LUA_ROOT/build/?.lua;\" .. package.path"

# Worked out once per process tree. The check is a `test` in a provisioned
# checkout and costs a `git rev-parse` only where there is no tree to find,
# but the suites run this launcher thousands of times and an answer that
# cannot change should be reached for once.
if [ "${NUPP_LAUNCHER_ROCKS_ROOT:-}" != "$ROOT" ]; then
    . "$ROOT/scripts/rocks.sh"
    link_development_rocks "$ROOT"
    NUPP_LAUNCHER_ROCKS_ROOT=$ROOT
    export NUPP_LAUNCHER_ROCKS_ROOT
fi

# The project's own rock tree, written by a build that declares a luarocks
# dependency -- `nupp build --target bootstrapCompiler` and `--target docs`
# between them install every rock this repository develops against. Exported
# rather than passed
# with -e, because the toolchain starts other interpreters — `nupp run`, the
# configured test command — and a library the compiler can see should be one
# they can see too. A trailing empty entry is where Lua substitutes the default
# path, so nothing already installed is hidden.
ROCKS="$ROOT/.rocks"
LUA_ROCKS="$LUA_ROOT/.rocks"
LUA_PATH="$LUA_ROCKS/share/lua/5.1/?.lua;$LUA_ROCKS/share/lua/5.1/?/init.lua;${LUA_PATH:-;}"
LUA_CPATH="$LUA_ROCKS/lib/lua/5.1/?.so;$LUA_ROCKS/lib/lua/5.1/?.dll;${LUA_CPATH:-;}"

# A clean CI checkout has no development rock tree yet, but provisioning the
# pinned toolchain has already built the exact LPeg the compiler needs. Use it
# when it is complete without making the launcher provision anything itself.
# That keeps help usable without a compiler and lets `.rocks` remain the normal
# development source when it exists.
# Worked out once per process tree rather than once per command.
#
# The prefix is a hash of the compiler pair, their version output, the machine
# and the provisioning rules, so asking for it runs both compilers and hashes
# two files: about sixty milliseconds, which is a third of what checking a small
# project costs. Every nested command pays it again for an answer that cannot
# have changed, and the test suite runs this launcher thousands of times.
#
# Carried in the environment, since that is what a child inherits and a shell
# variable is not. Keyed by everything the answer depends on that a caller can
# move -- the checkout and the four variables `scripts/toolchain` reads -- so a
# command run under a different compiler works its own answer out rather than
# being handed somebody else's.
TOOLCHAIN_CACHE_KEY="$ROOT|${NUPP_CC:-}|${NUPP_CXX:-}|${NUPP_TOOLCHAIN_DIR:-}"
if [ "${NUPP_LAUNCHER_TOOLCHAIN_KEY:-}" = "$TOOLCHAIN_CACHE_KEY" ] \
    && [ -n "${NUPP_LAUNCHER_TOOLCHAIN_PREFIX:-}" ]; then
    TOOLCHAIN_PREFIX=$NUPP_LAUNCHER_TOOLCHAIN_PREFIX
else
    TOOLCHAIN_PREFIX=$("$ROOT/scripts/toolchain" --prefix 2>/dev/null)
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*) TOOLCHAIN_PREFIX=$(cygpath -m "$TOOLCHAIN_PREFIX") ;;
    esac
fi
NUPP_LAUNCHER_TOOLCHAIN_KEY=$TOOLCHAIN_CACHE_KEY
NUPP_LAUNCHER_TOOLCHAIN_PREFIX=$TOOLCHAIN_PREFIX
export NUPP_LAUNCHER_TOOLCHAIN_KEY NUPP_LAUNCHER_TOOLCHAIN_PREFIX

# The stage-zero compiler, fetched and verified on first use.
#
# Asked for only where there is nothing else to run: no built compiler, or one
# that could not rebuild the tree. Every ordinary command in a built tree
# answers without a network round trip or a digest check, and `help` -- which
# reads no source and must work in a tree that has never fetched anything --
# never comes here at all.
#
# Memoized within this process, the failure included: both callers below may
# ask, a cached answer still costs a digest of a twelve-megabyte file, and an
# unreachable one has already said why it could not be had.
#
# Call it as a plain command and read `$STAGE0`, never as `$(stage0_path)`: a
# command substitution runs it in a subshell, which discards both the memo and
# the exported `NUPP_STAGE0` the compiler's own comptime workers are found by.
STAGE0=
STAGE0_TRIED=no
stage0_path() {
    if [ "$STAGE0_TRIED" = no ]; then
        STAGE0_TRIED=yes
        STAGE0=$("$ROOT/scripts/toolchain" stage0) || STAGE0=
        # A build run by stage zero starts comptime workers of its own, and on
        # Windows those are launched as a compiler rather than through this
        # script. Say which compiler is running so they can be the same one.
        if [ -n "$STAGE0" ]; then
            NUPP_STAGE0=$STAGE0
            export NUPP_STAGE0
        fi
    fi
    [ -n "$STAGE0" ] || return 1
    printf '%s\n' "$STAGE0"
}

TOOLCHAIN_LPEG="$TOOLCHAIN_PREFIX/lpeg"
if [ -f "$TOOLCHAIN_LPEG/.complete" ]; then
    LUA_PATH="$TOOLCHAIN_LPEG/share/?.lua;$LUA_PATH"
    LUA_CPATH="$TOOLCHAIN_LPEG/lib/?.so;$TOOLCHAIN_LPEG/lib/?.dll;$LUA_CPATH"
fi
# The interpreter this launcher is about to run under is the one an `@aot` entry
# will be opened by, and on Windows such an entry has to name its import library
# at link time. Say where it is rather than leaving it to be found on a PATH the
# interpreter is not on.
TOOLCHAIN_LUAJIT="$TOOLCHAIN_PREFIX/luajit"
if [ -f "$TOOLCHAIN_LUAJIT/.complete" ]; then
    NUPP_TOOLCHAIN_LUAJIT="$TOOLCHAIN_LUAJIT"
    export NUPP_TOOLCHAIN_LUAJIT
fi

TOOLCHAIN_LUAROCKS="$TOOLCHAIN_PREFIX/luarocks"
if [ -f "$TOOLCHAIN_LUAROCKS/.complete" ] && [ -z "${NUPP_LUAROCKS:-}" ]; then
    NUPP_LUAROCKS=$(cat "$TOOLCHAIN_LUAROCKS/.executable")
    export NUPP_LUAROCKS
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*)
            TOOLCHAIN_LUAROCKS_BIN=$(cygpath -u "$TOOLCHAIN_LUAROCKS")
            ;;
        *) TOOLCHAIN_LUAROCKS_BIN="$TOOLCHAIN_LUAROCKS/bin" ;;
    esac
    PATH="$TOOLCHAIN_LUAROCKS_BIN:$PATH"
    export PATH
elif [ -z "${NUPP_LUAROCKS:-}" ]; then
    # Not installed yet. A build would otherwise run whichever `luarocks` is
    # first on PATH, of any version and from anywhere, and install the rocks a
    # release bundles with it. The shim provisions the pinned one on first use,
    # so a command that installs nothing costs nothing. Windows starts tools
    # natively and cannot run a shell script, so it keeps the PATH lookup; its
    # CI provisions the toolchain before any build.
    case "$(uname -s 2>/dev/null)" in
        MINGW*|MSYS*|CYGWIN*) ;;
        *)
            NUPP_LUAROCKS="$ROOT/scripts/luarocks"
            export NUPP_LUAROCKS
            ;;
    esac
fi
export LUA_PATH LUA_CPATH
export NUPP_COMPILER_ROOT="$LUA_ROOT"

# A compiler rebuild happens before the requested command can parse its options,
# but colour is meant to cover the whole command, including that rebuild. Keep
# the one colour spelling the caller chose so the temporary `build` invocation
# and the launcher notice use the same policy as the command that follows.
BUILD_COLOR_ARG=
BUILD_COLOR_CONFLICT=no
for argument in "$@"; do
    case "$argument" in
        --color) wanted_color=always ;;
        --color=always|--color=never|--color=auto) wanted_color=${argument#--color=} ;;
        --no-color) wanted_color=never ;;
        *) wanted_color= ;;
    esac
    if [ -n "$wanted_color" ]; then
        if [ -n "$BUILD_COLOR_ARG" ] \
            && [ "$BUILD_COLOR_ARG" != "--color=$wanted_color" ]; then
            BUILD_COLOR_CONFLICT=yes
        else
            BUILD_COLOR_ARG="--color=$wanted_color"
        fi
    fi
done
if [ "$BUILD_COLOR_CONFLICT" = yes ]; then
    BUILD_COLOR_ARG=
fi

launcher_color_enabled() {
    case "$BUILD_COLOR_ARG" in
        --color=always) return 0 ;;
        --color=never) return 1 ;;
    esac
    [ -n "${NO_COLOR:-}" ] && [ "${NO_COLOR:-}" != 0 ] && return 1
    [ -n "${CLICOLOR_FORCE:-}" ] && [ "${CLICOLOR_FORCE:-}" != 0 ] && return 0
    [ "${TERM:-}" != dumb ] && [ -t 2 ]
}

launcher_notice() {
    if launcher_color_enabled; then
        printf '\033[1;36mnupp:\033[0m %s\n' "$1" >&2
    else
        printf 'nupp: %s\n' "$1" >&2
    fi
}

# The compiler lists directories through `nupp.io.files`, so it needs that
# facility's native provider the way any other program using one does. A built
# program finds its library beside itself; the compiler's own output tree puts
# `build/lib` one level further out than the generated loader looks, so name it
# outright. Windows requires the real `.dll` filename; keeping the platform
# filename everywhere also makes this override agree with the generated loader.
# Keep the launcher's broad development provider separate from the feature-matched
# provider a build target stages. Otherwise rebuilding the compiler can replace the
# library under a later `nupp run` with a narrower union.
case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
        RUST_NATIVE_FILENAME=nupp_native_dev.dll
        ;;
    Darwin*)
        RUST_NATIVE_FILENAME=libnupp_native_dev.dylib
        ;;
    *)
        RUST_NATIVE_FILENAME=libnupp_native_dev.so
        ;;
esac
export NUPP_NATIVE_LIBRARY="$LUA_ROOT/build/lib/$RUST_NATIVE_FILENAME"

# This makes the Rust provider a prerequisite for building Nupp itself, rather
# than only for a target that asked for a native facility. Stage 0 reaches it
# while listing the sources it is about to compile, so there is no ordering in
# which the compiler builds it for itself first.
#
# `scripts/toolchain` decides where the build lands and how it is cached, which
# is why nothing here names a directory: the answer is keyed by the compiler
# this machine has, and shared by every worktree of this checkout.

build_native() {
    # `files` because stage 0 lists its own sources through it. The rest are
    # optional stdlib facilities a program run by this launcher may select;
    # unlike a packaged build, `nupp run` loads this one development provider
    # rather than staging a target-specific union beside the program.
    features=base,compression,files,gpu,http,net,process,tls,uri,uuid
    built=$("$ROOT/scripts/toolchain" native-rust "$features") || return 1
    mkdir -p "$ROOT/build/lib"
    # Copied beside the destination and renamed onto it, never written in place.
    # A rename within one directory is atomic, so a command loading the library
    # while this runs sees the old file or the new one. Writing over it directly
    # leaves a window in which the file is neither: half a shared library, which
    # the loader does not report as a bad file -- on macOS the kernel refuses the
    # image and kills the process outright, some way from the cause.
    staged="$NUPP_NATIVE_LIBRARY.$$"
    if ! cp "$built" "$staged"; then
        rm -f "$staged"
        echo "nupp: could not stage the Rust native provider" >&2
        return 1
    fi
    if mv -f "$staged" "$NUPP_NATIVE_LIBRARY"; then
        return 0
    fi
    rm -f "$staged"
    echo "nupp: could not install the Rust native provider" >&2
    return 1
}

. "$ROOT/scripts/luajit.sh"
select_luajit "$ROOT" "$TOOLCHAIN_LUAJIT" || exit 1

# The stamp is rewritten by every build, warm ones included, so one source
# newer than it means the build has not seen that edit. Checking mtimes rather
# than asking the build system costs ten milliseconds where a warm build costs
# two seconds, and this runs before every command.
#
# Every file under both trees, not just `*.nupp`: the compiler bundles plain
# files alongside the ones it compiles -- theme.css and stub-catalog.json
# under src/nupp/tools, the project scaffolding under templates -- and a
# build copies them in the same pass that compiles everything else. Narrowing
# this to source extensions once meant an edit to one of those was never seen:
# the copy stayed old until something else forced a rebuild. `.DS_Store` is
# the one file worth ignoring outright, since Finder touches it on its own.
#
# It says whether the last build finished and saw every edit, which is not the
# same question as whether there is a compiler here. Only the rebuild decision
# asks this one; which compiler to run is decided further down on the compiler.
built_is_current() {
    [ -f "$STAMP" ] && [ -f "$BUILT" ] || return 1
    [ -z "$(find "$ROOT/src" "$ROOT/templates" -type f ! -name '.DS_Store' \
        -newer "$STAMP" 2>/dev/null | head -n 1)" ]
}

# One build at a time, per tree.
#
# A build removes the completion stamp before it writes anything, so while one is
# running every other process sees a tree that looks like it was never built --
# and each of them starts its own over the same output directory. A test suite
# whose own build takes a minute is enough: every command a test runs in that
# minute becomes another compiler compiling the same files, and none of them
# finish because the others keep moving the files under them.
#
# `mkdir` is the lock because it is atomic wherever this script runs. The pid in
# it is what tells a lock somebody is holding from one a killed build left
# behind.
BUILD_LOCK="$ROOT/build/.nupp-build-lock"
BUILD_LOCK_HELD=no

# How long to wait for another build before deciding it is not coming back. A
# cold build of this compiler is about twenty seconds and a bootstrap one a few
# minutes, so this is minutes past anything legitimate.
BUILD_LOCK_WAIT=900

release_build_lock() {
    [ "$BUILD_LOCK_HELD" = yes ] || return 0
    BUILD_LOCK_HELD=no
    rm -rf "$BUILD_LOCK"
}

lock_holder_alive() {
    holder=$(cat "$BUILD_LOCK/pid" 2>/dev/null) || return 1
    [ -n "$holder" ] || return 1
    kill -0 "$holder" 2>/dev/null
}

# Says that this command is waiting for another build of this tree and whose:
# once after a short grace, then once a minute. Waiting in silence read as a
# hang for up to BUILD_LOCK_WAIT. Only on a terminal, so captured output stays
# what it was. `holder` is what `lock_holder_alive` last read.
say_waiting_for_build() {
    [ -t 2 ] || return 0
    [ "$waited" -eq 3 ] || [ $((waited % 60)) -eq 0 ] || return 0
    echo "nupp: waiting for the build pid $holder is running in $ROOT" \
        "(${waited}s so far)" >&2
}

# 0 holding the lock and with a build still to do, 1 when somebody else's build
# has already produced what this one was going to.
#
# That second answer is only available to a rebuild this script decided on for
# itself. A build somebody asked for by name has to run: it may have been asked
# for a different target, and a target nobody built is not built because another
# one is. Those wait for the lock however long it takes -- `take_build_lock
# wait` -- and are the reason the argument exists.
take_build_lock() {
    lock_mode=${1:-share}
    waited=0
    while :; do
        mkdir -p "$ROOT/build" 2>/dev/null
        if mkdir "$BUILD_LOCK" 2>/dev/null; then
            printf '%s\n' "$$" > "$BUILD_LOCK/pid"
            BUILD_LOCK_HELD=yes
            trap 'release_build_lock' EXIT
            trap 'release_build_lock; exit 130' INT
            trap 'release_build_lock; exit 143' TERM
            return 0
        fi
        if ! lock_holder_alive; then
            rm -rf "$BUILD_LOCK"
            continue
        fi
        sleep 1
        waited=$((waited + 1))
        say_waiting_for_build
        # Whoever holds it is building the same sources this needs built, so
        # their answer is this one's answer.
        if [ "$lock_mode" = share ]; then
            built_is_current && return 1
        fi
        if [ "$waited" -ge "$BUILD_LOCK_WAIT" ]; then
            echo "nupp: another build has held $BUILD_LOCK for ${waited}s;" \
                "building without it" >&2
            return 0
        fi
    done
}

# Waits out a build of this tree without starting one.
#
# For a command that has no rebuild to ask for and still has to load this
# tree's compiler out of build/ while a build of this tree is rewriting it.
# Cheap when nothing holds the lock, which is every ordinary invocation.
await_build() {
    waited=0
    while [ -d "$BUILD_LOCK" ] && lock_holder_alive; do
        sleep 1
        waited=$((waited + 1))
        say_waiting_for_build
        if [ "$waited" -ge "$BUILD_LOCK_WAIT" ]; then
            echo "nupp: another build has held $BUILD_LOCK for ${waited}s;" \
                "running without waiting for it" >&2
            return 0
        fi
    done
    return 0
}

# With the best compiler available: the built one when there is one, since a
# compiler that has kept up with the sources is likelier to compile them than a
# bundle from whenever it was last refreshed.
#
# The built one is chosen on whether it is there, not on whether the stamp says
# the last build finished. Those differ exactly while a build is running, and
# answering "there is no compiler here" then sent every concurrent command to
# the stage-0 bootstrap -- the slowest compiler in the tree -- to build the
# whole thing from nothing, when a working compiler was sitting right there.
#
# When that one cannot build, the bootstrap gets a turn. A build can succeed and
# still leave a compiler that does not run — that is an ordinary afternoon when
# the thing being edited is the compiler — and without the second attempt the
# only way out is knowing to delete build/ by hand.
# Publish compiler and runtime modules generated by the compiler being built.
complete_bootstrap() {
    [ -f "$BUILT" ] || return 0
    if [ -n "$BUILD_COLOR_ARG" ]; then
        (cd "$ROOT" && NUPP_COMPILER_ROOT="$LUA_ROOT" luajit -e "$LUAPATH" "$LUA_BUILT" build "$BUILD_COLOR_ARG")
    else
        (cd "$ROOT" && NUPP_COMPILER_ROOT="$LUA_ROOT" luajit -e "$LUAPATH" "$LUA_BUILT" build)
    fi
}

build_now() {
    # Announced only by the process that is going to do it.
    #
    # Said before taking the lock, this was said by every command that arrived
    # while somebody else was building -- and a build removes the completion
    # stamp before it writes anything, so that window is the whole build. Under
    # the test suite that is dozens of commands, each announcing a build it then
    # waits for rather than does, into whatever output the test was capturing.
    # Two suites compare that output against what the command is documented to
    # print, and failed on the announcement.
    take_build_lock share || return 0
    launcher_notice "sources changed, building the compiler"
    build_status=1
    if [ -f "$BUILT" ]; then
        if [ -n "$BUILD_COLOR_ARG" ]; then
            (cd "$ROOT" && luajit -e "$LUAPATH" "$LUA_BUILT" build "$BUILD_COLOR_ARG")
        else
            (cd "$ROOT" && luajit -e "$LUAPATH" "$LUA_BUILT" build)
        fi
        if [ "$?" -eq 0 ]; then
            release_build_lock
            return 0
        fi
        echo "nupp: falling back to the stage-zero compiler" >&2
        # The built compiler loads through build/.bytecode, and an entry that is
        # damaged but still loads fails it the same way every time -- including
        # the self-hosted pass after this one. Nothing else notices, so the
        # cache goes with the compiler that could not build.
        rm -rf "$ROOT/build/.bytecode"
    fi
    if stage0_path >/dev/null; then
        if [ -n "$BUILD_COLOR_ARG" ]; then
            (cd "$ROOT" && NUPP_COMPILER_ROOT="$(dirname "$STAGE0")" luajit "$STAGE0" build "$BUILD_COLOR_ARG")
        else
            (cd "$ROOT" && NUPP_COMPILER_ROOT="$(dirname "$STAGE0")" luajit "$STAGE0" build)
        fi
        build_status=$?
        if [ "$build_status" -eq 0 ]; then
            complete_bootstrap
            build_status=$?
        fi
    fi
    release_build_lock

    return "$build_status"
}

# `build` and `clean` are the build; running one before them would be doing
# their job twice or undoing it. `help` and a bare invocation answer without
# reading a single source file.
#
# A comptime worker is a child of a build that is already running: it is handed
# one request by the compiler that started it and answers that. Letting it ask
# whether the tree needs building meant every worker a build spawned started a
# second build of the same tree, while its parent was still writing the files.
#
# Neither asks for a rebuild, but which tree they are the build of decides what
# else they owe. `build` here is one writer of this tree and takes the lock that
# says so. `build` or `clean` anywhere else is a build of somebody else's
# project that happens to load its compiler out of this tree, so it waits for a
# build of this tree rather than reading one that is half rewritten -- the test
# suite is thousands of those, run through this launcher beside the
# repository's own build.
in_this_tree() {
    [ "$(pwd -P 2>/dev/null)" = "$(cd "$ROOT" 2>/dev/null && pwd -P)" ]
}

hold_build_lock=no
wait_for_build=no
case "${1:-}" in
    ""|-h|--help|help) rebuild=no ;;
    # A worker one of this toolchain's own commands started runs the compiler
    # that started it. Deciding to build a different one first is wrong twice
    # over: the parent is waiting on a deadline for an answer, and the compiler's
    # digest keys every artifact, so an answer from a compiler the parent does
    # not recognize is not the answer it asked for. It is also how a generator
    # worker came to be queued behind the build lock its own parent was holding,
    # and to be reported as a worker that timed out.
    __comptime-worker|__comptime-worker-service|__generator-worker|__parallel-check-service|__lsp-reader) rebuild=no ;;
    build)  rebuild=no
            if in_this_tree; then hold_build_lock=yes; else wait_for_build=yes; fi ;;
    clean)  rebuild=no
            if ! in_this_tree; then wait_for_build=yes; fi ;;
    *)      rebuild=yes ;;
esac

# The compiler resolves its path service while constructing the command table,
# before it knows whether this invocation will read source. That includes main
# and subcommand help, so every invocation needs the provider staged before the
# compiler starts. Saying so here beats the ffi.load traceback a cold checkout
# otherwise gets from the fetched stage zero.
needs_native=yes

# The same rule the compiler gets: a source newer than the artifact means the
# artifact has not seen that edit. Without this an edit to the provider was
# picked up by whoever next deleted the library by hand, and everything in
# between tested the one before it.
native_is_current() {
    [ -f "$NUPP_NATIVE_LIBRARY" ] || return 1
    # The launcher owns the broad development feature union, so changing that
    # union invalidates its staged copy.
    [ ! "$ROOT/bin/nupp" -nt "$NUPP_NATIVE_LIBRARY" ] || return 1
    [ -z "$(find "$ROOT/runtime" "$ROOT/native" "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" -type f \
        \( -name '*.rs' -o -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.toml' -o -name 'Cargo.lock' \) \
        -newer "$NUPP_NATIVE_LIBRARY" 2>/dev/null | head -n 1)" ] || return 1
    [ ! "$ROOT/scripts/toolchain" -nt "$NUPP_NATIVE_LIBRARY" ] || return 1
    [ ! "$ROOT/scripts/toolchain.pins" -nt "$NUPP_NATIVE_LIBRARY" ] || return 1
    [ ! "$ROOT/rust-toolchain.toml" -nt "$NUPP_NATIVE_LIBRARY" ] || return 1
    [ ! "$ROOT/.cargo/config.toml" -nt "$NUPP_NATIVE_LIBRARY" ] || return 1
}

# A worker serves the compiler that launched it, including that compiler's
# provider. Rebuilding after an edit here can exceed its request deadline or
# replace the library while the parent is using it.
worker_native=no
case "${1:-}" in
    __comptime-worker|__comptime-worker-service|__generator-worker|__parallel-check-service|__lsp-reader)
        if [ "${NUPP_LAUNCHER_NATIVE_ROOT:-}" = "$ROOT" ] \
            && [ "${NUPP_LAUNCHER_NATIVE_LIBRARY:-}" = "$NUPP_NATIVE_LIBRARY" ] \
            && [ -f "$NUPP_NATIVE_LIBRARY" ]; then
            worker_native=yes
        fi ;;
esac
if [ "$needs_native" = yes ] && [ "$worker_native" != yes ] && ! native_is_current; then
    build_native || exit 1
fi
NUPP_LAUNCHER_NATIVE_ROOT=$ROOT
NUPP_LAUNCHER_NATIVE_LIBRARY=$NUPP_NATIVE_LIBRARY
export NUPP_LAUNCHER_NATIVE_ROOT NUPP_LAUNCHER_NATIVE_LIBRARY

if [ "$rebuild" = yes ] && ! built_is_current; then
    if ! build_now; then
        # Mid-edit the compiler often does not compile, and that is no reason
        # for the rest of the toolchain to stop working. The last compiler that
        # did build still runs; it is just running behind, and says so.
        echo "nupp: the compiler did not build; running the last one that did" >&2
    fi
fi

# This tree's own build is one writer of this tree, however it was asked for.
# `nupp build --target dist` is a build of this repository the same way a bare
# `nupp build` is, and it removes the completion stamp before it writes
# anything -- so for the minute it takes, every other command here read the
# tree as never built and started its own build over the same output directory.
# The lock is what says a build is running; taking it only for the rebuild this
# script decides on left the builds somebody asked for outside it.
#
# A `clean` of this tree waits for nothing and holds nothing: the lock lives in
# the directory it removes, so holding it would have clean delete its own lock
# and then the one a waiting process took in its place.
if [ "$hold_build_lock" = yes ]; then
    take_build_lock wait
elif [ "$wait_for_build" = yes ]; then
    await_build
fi

# With the compiler that is there, rather than the one the stamp says finished.
# Those differ for the length of every build, because a build removes the stamp
# before it writes anything, and answering "there is no compiler here" then had
# one compiler's questions answered by another: a comptime worker handed a value
# its parent does not recognize, a build rejecting its own source with "unknown
# is not a Handler", and -- because the compiler's own digest keys every
# artifact -- a project rebuilding native code that nothing had changed.
#
# It is the same choice `build_now` makes when it picks which compiler to build
# with, and for the same reason: a compiler that has kept up with the sources is
# a better answer than a bundle from whenever stage zero was last refreshed.
using_stage0=no
if [ -f "$BUILT" ]; then
    set -- luajit -e "$LUAPATH" "$LUA_BUILT" "$@"
elif stage0_path >/dev/null; then
    using_stage0=yes
    export NUPP_COMPILER_ROOT="$(dirname "$STAGE0")"
    set -- luajit "$STAGE0" "$@"
else
    echo "nupp: no built compiler, and the stage-zero compiler is not available" >&2
    exit 1
fi

# Holding the lock rules out `exec`: the trap that releases it belongs to this
# shell, and exec leaves no shell to run it.
if [ "$BUILD_LOCK_HELD" = yes ]; then
    "$@"
    status=$?
    if [ "$status" -eq 0 ] && [ "$using_stage0" = yes ]; then
        complete_bootstrap
        status=$?
    fi
    release_build_lock
    exit "$status"
fi

exec "$@"
