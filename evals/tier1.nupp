local harness = require("harness")
local tier1 = require("tier1eval")
local json = nupp.data.json

local arguments = {...} as {string}

local USAGE = [[usage: ./bin/nupp run evals/tier1.nupp CODE [OPTIONS]

Run one diagnostic-repair agent evaluation.

Options:
  --nupp PATH       compiler to grade with (default: ./bin/nupp)
  --model MODEL     Claude model name
  --out DIRECTORY   result directory (default: evals/results)
  --keep            retain the agent workspace
  --timeout SECONDS kill a runaway agent (default: 300)
  --lean            expose only repair tools to the agent
  -h, --help        show this help]]

local function valueAfter(index: integer, option: string): string
    local value = arguments[index + 1]
    if value == nil then
        error(option .. " requires a value", 0)
    end

    return value
end

local function main(): integer
    local code: string? = nil
    local nupp = "bin/nupp"
    local model: string? = nil
    local out = "evals/results"
    local keep, lean = false, false
    local timeout = 300
    local index: integer = 1
    while index <= #arguments do
        local argument = arguments[index]
        if argument == "-h" or argument == "--help" then
            print(USAGE)

            return 0
        elseif argument == "--nupp" then
            nupp = valueAfter(index, argument)
            index = index + 1
        elseif argument == "--model" then
            model = valueAfter(index, argument)
            index = index + 1
        elseif argument == "--out" then
            out = valueAfter(index, argument)
            index = index + 1
        elseif argument == "--timeout" then
            timeout = tonumber(valueAfter(index, argument)) or -1
            if timeout <= 0 then
                error("--timeout must be a positive number", 0)
            end
            index = index + 1
        elseif argument == "--keep" then
            keep = true
        elseif argument == "--lean" then
            lean = true
        elseif argument:sub(1, 1) == "-" then
            error("unknown option " .. argument, 0)
        elseif code == nil then
            code = argument
        else
            error("unexpected argument " .. argument, 0)
        end
        index = index + 1
    end
    if code == nil then
        error("a diagnostic CODE is required\n" .. USAGE, 0)
    end
    nupp = harness.absolute(nupp)
    out = harness.absolute(out)
    if not require("nupp.io.files").exists(nupp) then
        error("no compiler at " .. nupp, 0)
    end
    if not harness.commandAvailable("claude") then
        error("the `claude` CLI is not on PATH", 0)
    end

    local record = tier1.evaluate(nupp, code, out, model, keep, lean, timeout)
    local verdict = record.grade.passed and "PASS" or "FAIL"
    print(verdict .. "  " .. tostring(record.task.code) .. "  " .. tostring(record.task.summary))
    print(
        (
            "  turns=%s tools=%s nupp=%s cost=%s"
        ):format(
            tostring(record.agent.turns),
            tostring(record.agent.toolCallTotal),
            tostring(record.agent.nuppInvocations),
            harness.spent(record.agent)
        )
    )
    print("  before=" .. json.encode(record.grade.diagnosticsBefore))
    print("  after=" .. json.encode(record.grade.diagnosticsAfter))
    if record.grade.suspiciousShrink then
        print("  note: the file shrank by more than half; check the repair")
    end
    if record.workspace ~= json.NULL then
        print("  workspace=" .. tostring(record.workspace))
    end

    return record.grade.passed and 0 or 1
end

local ok, status = pcall(main)
if not ok then
    io.stderr:write("tier1: " .. tostring(status) .. "\n")
    os.exit(2)
end
os.exit(status as integer)
