module s0.corebound

local ir = require("s0.ir")
local bound = {}

-- Every incoming block argument must retain the original dispatch table.
local function tableIdentity(f: ir.Function, value: integer): boolean
    local root = f.params[f.firstParam[1] + f.nparams[1] - 1]
    local seen: {[integer]: boolean} = {}
    local reached = false

    local function visit(v: integer): boolean
        if v == root then
            reached = true;
            return true
        end
        if seen[v] then
            return true
        end
        seen[v] = true
        local block = -f.definitions[v]
        if block <= 1 then
            return false
        end
        local parameter: integer = 0
        for at = 0, f.nparams[block] - 1 do
            if f.params[f.firstParam[block] + at] == v then
                parameter = at + 1
            end
        end
        if parameter == 0 then
            return false
        end
        local incoming: integer = 0
        for edge, target in ipairs(f.edgeTarget) do
            if target == block then
                incoming = incoming + 1
                if not visit(f.edgeArgs[f.edgeFirstArg[edge] + parameter - 1]) then
                    return false
                end
            end
        end

        return incoming > 0
    end

    return visit(value) and reached
end

function bound.extent(functions: {ir.Function}, frames: {integer}, handlers: {integer}, exported: {integer}): integer
    local named: {[string]: integer} = {}
    for index, f in ipairs(functions) do
        named[f.name] = index
    end
    local dispatch = #functions + 1
    local first: {integer}, count: {integer}, target: {integer}, weight: {integer} = {}, {}, {}, {}
    local owner: {integer}, reverseHead: {integer}, reverseNext: {integer} = {}, {}, {}
    local dependent: {[integer]: boolean} = {}
    local queue: {integer} = {}

    local function edge(from: integer, to: integer, bytes: integer): nil
        local at = #target + 1
        target[at], weight[at], owner[at] = to, bytes, from
        count[from] = count[from] + 1
        reverseNext[at], reverseHead[to] = reverseHead[to] or 0, at
    end

    local function requiresTable(index: integer): nil
        if not dependent[index] then
            dependent[index] = true;
            queue[#queue + 1] = index
        end
    end

    for index, f in ipairs(functions) do
        first[index], count[index] = #target + 1, 0
        for at, opcode in ipairs(f.op) do
            local op = ir.opNames[opcode]
            local _ = switch op do
                case "call_indirect" -> do
                    assert(false, "S0 core: non-tail indirect extent in " .. f.name)
                    yield nil
                end
                case "return_call_indirect" -> do
                    assert(
                        f.nargs[at] == 7 and tableIdentity(f, f.args[f.firstArg[at] + 6]),
                        "S0 core: indirect table argument " .. f.name
                    )
                    local load = f.definitions[f.args[f.firstArg[at]]]
                    assert(
                        load > 0 and f.op[load] == ir.opcode("load") and f.aux[load] == 64 and f.imm[load] == 0,
                        "S0 core: indirect target load " .. f.name
                    )
                    local add = f.definitions[f.args[f.firstArg[load]]]
                    assert(add > 0 and f.op[add] == ir.opcode("iadd"), "S0 core: indirect table address " .. f.name)
                    local base, offset = f.args[f.firstArg[add]], f.args[f.firstArg[add] + 1]
                    assert(tableIdentity(f, base), "S0 core: indirect table origin " .. f.name)
                    local shift = f.definitions[offset]
                    assert(shift > 0 and f.op[shift] == ir.opcode("ishl"), "S0 core: dispatch scale " .. f.name)
                    local byte = f.definitions[f.args[f.firstArg[shift]]]
                    local three = f.definitions[f.args[f.firstArg[shift] + 1]]
                    assert(
                        byte > 0 and f.op[byte] == ir.opcode("load") and f.aux[byte] == 8,
                        "S0 core: dispatch index range " .. f.name
                    )
                    assert(
                        three > 0 and f.op[three] == ir.opcode("iconst") and f.imm[three] == 3,
                        "S0 core: dispatch index scale " .. f.name
                    )
                    edge(index, dispatch, 0);
                    requiresTable(index)
                    yield nil
                end
                case "call", "return_call" -> do
                    local callee = named[f.importNames[f.aux[at]]]
                    if callee then
                        edge(index, callee, op == "call" and frames[index] or 0)
                    end
                    yield nil
                end
                else -> nil
            end
        end
    end
    first[dispatch], count[dispatch], frames[dispatch] = #target + 1, 0, 0
    for _, handler in ipairs(handlers) do
        if handler ~= 0 then
            edge(dispatch, handler, 0)
        end
    end
    local cursor: integer = 1
    while cursor <= #queue do
        local index = queue[cursor];
        cursor = cursor + 1
        local at = reverseHead[index] or 0
        while at ~= 0 do
            if owner[at] ~= dispatch then
                requiresTable(owner[at])
            end
            at = reverseNext[at]
        end
    end
    for _, index in ipairs(exported) do
        assert(not dependent[index], "S0 core: exported body requires trusted dispatch " .. functions[index].name)
    end
    for _, f in ipairs(functions) do
        for at, opcode in ipairs(f.op) do
            local _ = switch ir.opNames[opcode] do
                case "call", "return_call" -> do
                    local callee = named[f.importNames[f.aux[at]]]
                    if callee and dependent[callee] then
                        assert(
                            f.nargs[at] > 0 and tableIdentity(f, f.args[f.firstArg[at] + f.nargs[at] - 1]),
                            "S0 core: direct dispatch argument " .. f.name
                        )
                    end
                    yield nil
                end
                else -> nil
            end
        end
    end
    -- Collapse zero-growth tail cycles; a normal call in a cycle is refused.
    local serial: integer, components: integer = 0, 0
    local number: {integer}, low: {integer}, component: {integer}, stack: {integer} = {}, {}, {}, {}
    local active: {[integer]: boolean} = {}

    local function visit(node: integer): nil
        serial = serial + 1;
        number[node], low[node] = serial, serial
        stack[#stack + 1], active[node] = node, true
        for at = first[node], first[node] + count[node] - 1 do
            local nextNode = target[at]
            if not number[nextNode] then
                visit(nextNode);
                low[node] = math.min(low[node], low[nextNode])
            elseif active[nextNode] then
                low[node] = math.min(low[node], number[nextNode])
            end
        end
        if low[node] == number[node] then
            components = components + 1
            while true do
                local member = table.remove(stack)
                active[member], component[member] = false, components
                if member == node then
                    break
                end
            end
        end
    end

    for node = 1, dispatch do
        if not number[node] then
            visit(node)
        end
    end
    local sizes: {integer}, heads: {integer}, nextEdge: {integer} = {}, {}, {}
    for node = 1, dispatch do
        sizes[component[node]] = math.max(sizes[component[node]] or 0, frames[node])
    end
    for at, to in ipairs(target) do
        local fromComponent, toComponent = component[owner[at]], component[to]
        assert(
            fromComponent ~= toComponent or weight[at] == 0,
            "S0 core: positive-growth cycle " .. (
                owner[at] == dispatch and "dispatch" or functions[owner[at]].name
            ) .. " -> " .. (to == dispatch and "dispatch" or functions[to].name)
        )
        if fromComponent ~= toComponent then
            nextEdge[at], heads[fromComponent] = heads[fromComponent] or 0, at
        end
    end
    local done: {[integer]: boolean} = {}

    local function extent(group: integer): integer
        if not done[group] then
            done[group] = true
            local at = heads[group] or 0
            while at ~= 0 do
                sizes[group] = math.max(sizes[group], weight[at] + extent(component[target[at]]))
                at = nextEdge[at]
            end
        end

        return sizes[group]
    end

    local maximum: integer = 0
    for group = 1, components do
        maximum = math.max(maximum, extent(group))
    end
    assert(maximum > 0 and maximum <= 16773120, "S0 core: arena extent limit")

    print(
        (
            "core bound: %d functions, %d edges, %d tail components, %d exact bytes"
        ):format(#functions, #target, components, maximum)
    )

    return (maximum + 4095) & -4096
end

export = bound
