module s0.calltransporttests

local reader = require("s0.reader")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")

export function audit(path: string): string
    local input = assert(io.open(path, "rb"))
    local functions = reader.read(assert(input:read("*a")))
    input:close()
    for _, spill in ipairs({false, true}) do
        for _, f in ipairs(functions) do
            local target = selector.target()
            if spill then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local a = allocate.run(f, target)
            assert(check.run(f, target, a))
            local calls, eligible, rematerialized, spilled, arguments = 0, 0, 0, 0, 0
            for _, block in ipairs(a.blockOrder) do
                for at = f.blockStart[block], f.blockEnd[block] do
                    if f.op[at] >= ir.OP_CALL and f.op[at] <= ir.OP_RETURN_CALL_INDIRECT then
                        calls = calls + 1
                        local fast, memory = true, false
                        for p = f.firstArg[at], f.firstArg[at] + f.nargs[at] - 1 do
                            local value = f.args[p]
                            fast = fast and a.location[value] ~= 0 and a.rematerialize[value] == 0
                            memory = memory or a.location[value] < 0
                            arguments = arguments + 1
                        end
                        eligible = eligible + (fast and 1 or 0)
                        rematerialized = rematerialized + (fast and 0 or 1)
                        spilled = spilled + (memory and 1 or 0)
                    end
                end
            end
            local ok, selected = pcall(selector.run, f, a)
            assert(ok or spill, "normal corpus selection refused")
            local code = ok and selected as selector.Code or nil
            local callWords, words, frameBytes = 0, -1, -1
            if code then
                words, frameBytes = #code.words, code.frameBytes
                for op = ir.OP_CALL, ir.OP_RETURN_CALL_INDIRECT do
                    callWords = callWords + code.opWords[op]
                end
            else
                print("REFUSED " .. f.name .. ": " .. tostring(selected))
            end
            print(
                (
                    "%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d"
                ):format(
                    spill and "spill" or "normal",
                    f.name,
                    calls,
                    eligible,
                    rematerialized,
                    spilled,
                    arguments,
                    callWords,
                    words,
                    frameBytes
                )
            )
        end
    end

    return "allocated call transport audit passed"
end
