module s0.scaledmemorytests

local ir = require("s0.ir")
local encoder = require("s0.arm64tests")
local arm = require("s0.arm64")

local reader = require("s0.reader")
local oracle = require("s0.oracle")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local link = require("s0.link")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

export function prepare(directory: string, digest: string): string
    assert(arm.memory64(false, 0, 1, 2) == 0xf8627820)
    assert(arm.memory64(true, 3, 4, 5) == 0xf8257883)
    assert(not pcall(arm.memory64, false, 32, 0, 0))
    assert(not pcall(arm.memory64, true, 0, -1, 0))
    assert(not pcall(arm.memory64, false, 0, 0, 32))
    encoder.golden()
    encoder.refusals()
    encoder.registers()
    local output = assert(io.open(directory .. "/oracle.tsv", "wb"))
    local count: integer = 0
    for line in read(directory .. "/inputs.tsv"):gmatch("[^\n]+") do
        local name = assert(line:match("^(%w+)"))
        local args: {integer} = {}
        local first = true
        for word in line:gmatch("%S+") do
            if first then
                first = false
            else
                args[#args + 1] = reader.integer(word)
            end
        end
        local path = directory .. "/" .. name .. ".clif"
        local f = reader.read(read(path))[1]
        local bytes: {integer} = {}
        for i = 1, 256 do
            bytes[i] = 0
        end
        local result = oracle.run(
            f,
            args,
            oracle.Memory(bytes = bytes, stackBase = 64),
            oracle.Hooks(call = nil, fma64 = nil),
            10000
        )
        assert(result.status == oracle.OK, "oracle refused " .. name .. ": " .. tostring(result.status))
        output:write(("%s %d %d %d %d\n"):format(name, result.status, result.word, result.word2, result.steps))
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local allocation = allocate.run(f, target)
            assert(check.run(f, target, allocation))
            local code = selector.run(f, allocation)
            local matches: integer = 0
            for _, word in ipairs(code.words) do
                if (word & 0xffa0fc00) == 0xf8207800 then
                    matches = matches + 1
                end
            end
            local folded = name:sub(1, 4) == "fold"
            assert(matches == (folded and 1 or 0), name .. ": indexed memory form")
            if folded then
                assert(code.opWords[ir.OP_IMUL] == 0 and code.opWords[ir.OP_IADD] == 0, name .. ": producers remain")
            end
            link.bundle(path, name, directory .. "/" .. mode .. "/" .. name, digest, mode)
        end
        count = count + 1
    end
    output:close()

    return ("%d oracle results and %d checked native bundles prepared"):format(count, count * 2)
end
