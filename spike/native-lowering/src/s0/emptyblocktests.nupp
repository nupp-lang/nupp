module s0.emptyblocktests

local reader = require("s0.reader")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local oracle = require("s0.oracle")
local differential = require("s0.differentialtests")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

local function machine(code: selector.Code, start: integer): (integer, integer)
    local seen: {[integer]: boolean} = {}
    local at: integer = start
    local hops: integer = 0
    while not seen[at] do
        seen[at] = true
        local word = assert(code.words[at], "branch escaped code")
        if (word & 0xfc000000) ~= 0x14000000 then
            return at, hops
        end
        local delta = word & 0x03ffffff
        if delta >= 0x02000000 then
            delta = delta - 0x04000000
        end
        at, hops = at + delta, hops + 1
    end

    return 0, hops
end

local function semantic(f: ir.Function, a: allocate.Allocation, start: integer): (integer, integer)
    local seen: {[integer]: boolean} = {}
    local block: integer = start
    local hops: integer = 0
    while not seen[block] do
        seen[block] = true
        local at = f.blockStart[block]
        if at ~= f.blockEnd[block] or f.op[at] ~= ir.OP_JUMP or a.nmoves[f.firstEdge[at]] ~= 0 then
            return block, hops
        end
        block, hops = f.edgeTarget[f.firstEdge[at]], hops + 1
    end

    return 0, hops
end

export function prepare(directory: string, digest: string): string
    local count, blocked, residual, collapsed, cycles = 0, 0, 0, 0, 0
    for line in read(directory .. "/structural.tsv"):gmatch("[^\n]+") do
        local name, shape, order = line:match("^(%w+) (%w+) (.+)$")
        assert(name and shape and order, "empty-block fixture")
        local f = reader.read(read(directory .. "/" .. name .. ".clif"))[1]
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local a = allocate.run(f, target)
            assert(check.run(f, target, a))
            if order ~= "default" then
                local blocks: {integer} = {}
                for item in order:gmatch("%d+") do
                    blocks[#blocks + 1] = assert(tonumber(item)) as integer
                end
                assert(#blocks == #a.blockOrder)
                a.blockOrder = blocks
            end
            local code = selector.run(f, a)
            local longest, cycleCount, blockerCount = 0, 0, 0
            for block, at in ipairs(f.blockStart) do
                if at == f.blockEnd[block] and f.op[at] == ir.OP_JUMP then
                    if a.nmoves[f.firstEdge[at]] ~= 0 then
                        blockerCount = blockerCount + 1
                    else
                        local terminal, semanticHops = semantic(f, a, block)
                        local destination, machineHops = machine(code, code.blockWord[block])
                        assert(
                            destination == (terminal == 0 and 0 or code.blockWord[terminal]),
                            name .. ": jump semantics"
                        )
                        if terminal == 0 then
                            cycleCount = cycleCount + 1
                        end
                        longest = math.max(longest, machineHops)
                        if semanticHops > machineHops then
                            collapsed = collapsed + 1
                        end
                    end
                end
            end
            if shape == "forward" then
                assert(longest <= 1, "forward chain retained extra branches")
            elseif shape == "backward" then
                assert(longest > 1, "backedge residual fixture lost its purpose")
            elseif shape == "cycle" then
                assert(cycleCount > 0, "cycle changed into an exit")
                local result = oracle.run(
                    f,
                    {1, 42},
                    oracle.Memory(bytes = {}, stackBase = 0),
                    oracle.Hooks(call = nil, fma64 = nil),
                    50
                )
                assert(result.status == oracle.FUEL, "cycle oracle must not terminate")
            end
            if shape == "phi" and mode == "spill" then
                assert(blockerCount > 0, "missing phi-move blocker")
            end
            blocked, cycles = blocked + blockerCount, cycles + cycleCount
            residual = math.max(residual, longest)
            count = count + 1
        end
    end
    print(
        (
            "%d structural layouts; %d blocked edges, %d collapsed paths, %d cyclic paths; maximum residual %d branches"
        ):format(count, blocked, collapsed, cycles, residual)
    )

    return differential.prepare(directory, digest)
end
