module s0.literal

local literal = {}

-- Parse as integer arithmetic, retaining all bits above binary64 precision.
function literal.integer(text: string): int64
    local negative = text:sub(1, 1) == "-"
    if negative or text:sub(1, 1) == "+" then
        text = text:sub(2)
    end
    text = text:gsub("_", ""):lower()
    local base: int64 = 10
    if text:sub(1, 2) == "0x" then
        base, text = 16, text:sub(3)
    end
    assert(#text > 0 and #text <= (base == 16 and 16 or 20), "S0 reader: integer width")
    if base == 10 and #text == 20 then
        assert(text <= "18446744073709551615", "S0 reader: integer overflow")
    end
    local value: int64 = 0
    for at = 1, #text do
        local byte = text:byte(at)
        local digit: int64 = byte >= 97 and byte - 87 or byte - 48
        assert(digit >= 0 and digit < base, "S0 reader: malformed integer")
        value = value * base + digit
    end

    return negative and -value or value
end

export = literal
