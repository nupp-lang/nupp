module s0.branchtests

local reader = require("s0.reader")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local link = require("s0.link")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

export function prepare(directory: string, digest: string): string
    local count: integer = 0
    for line in read(directory .. "/functions.tsv"):gmatch("[^\n]+") do
        local name, expectedBoolean, expectedJumps = line:match("^(%w+) (%d+) (%d+)$")
        assert(name, "branch fixture row")
        local path = directory .. "/" .. name .. ".clif"
        local f = reader.read(read(path))[1]
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local allocation = allocate.run(f, target)
            assert(check.run(f, target, allocation))
            local code = selector.run(f, allocation)
            local booleans, jumps, branches = 0, 0, 0
            for _, word in ipairs(code.words) do
                -- CSET Wd, cc: discard condition and destination fields only.
                if (word & 0xffff0fe0) == 0x1a9f07e0 then
                    booleans = booleans + 1
                elseif (word & 0xfc000000) == 0x14000000 then
                    jumps = jumps + 1
                elseif (word & 0xff000010) == 0x54000000 then
                    branches = branches + 1
                end
            end
            assert(booleans == tonumber(expectedBoolean), name .. ": comparison materialization")
            assert(jumps == tonumber(expectedJumps), name .. ": fallthrough jump count")
            assert(branches == code.opCounts[ir.OP_BRIF], name .. ": conditional branch count")
            link.bundle(path, name, directory .. "/" .. mode .. "/" .. name, digest, mode)
            count = count + 1
        end
    end

    return ("%d checked branch bundles and instruction-shape assertions passed"):format(count)
end
