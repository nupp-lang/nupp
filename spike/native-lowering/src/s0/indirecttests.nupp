module s0.indirecttests

local reader = require("s0.reader")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local link = require("s0.link")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

export function prepare(directory: string, digest: string): string
    local accepted, refused = 0, 0
    for line in read(directory .. "/functions.tsv"):gmatch("[^\n]+") do
        local name, binding, expected = line:match("^(%w+) ([^ ]+) (.+)$")
        assert(name and binding and expected, "indirect fixture row")
        local path = directory .. "/" .. name .. ".clif"
        local functions = reader.read(read(path))
        local closed: string? = binding ~= "none" and binding or nil
        for _, mode in ipairs({"normal", "spill"}) do
            if expected == "ok" then
                for _, f in ipairs(functions) do
                    local target = selector.target()
                    if mode == "spill" then
                        target.integerRegisters, target.floatRegisters = {}, {}
                    end
                    assert(check.run(f, target, allocate.run(f, target)))
                end
                if name == "nested" or name == "nestedtail" then
                    assert(
                        link.build(functions, name, mode == "spill", closed).arenaBytes >= 12288,
                        "nested arena extent"
                    )
                end
                link.bundle(path, name, directory .. "/" .. mode .. "/" .. name, digest, mode, closed)
                accepted = accepted + 1
            else
                local ok, message = pcall(link.build, functions, name, mode == "spill", closed)
                assert(
                    not ok and tostring(message):find(expected, 1, true),
                    name .. ": wrong refusal " .. tostring(message)
                )
                refused = refused + 1
            end
        end
    end

    return ("%d closed indirect bundles and %d refusals passed"):format(accepted, refused)
end
