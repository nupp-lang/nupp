module s0.operationtests

local reader = require("s0.reader")
local oracle = require("s0.oracle")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local link = require("s0.link")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

export function prepare(directory: string, digest: string): string
    local output = assert(io.open(directory .. "/oracle.tsv", "wb"))
    local accepted, refused = 0, 0
    for line in read(directory .. "/inputs.tsv"):gmatch("[^\n]+") do
        local name, status, binding, words = line:match("^(%w+) (%-?%d+) ([^ ]+) (.*)$")
        assert(name and status and binding and words, "operation fixture row")
        local args: {integer} = {}
        for word in words:gmatch("%S+") do
            args[#args + 1] = reader.integer(word)
        end
        local path = directory .. "/" .. name .. ".clif"
        local functions = reader.read(read(path))
        local f = functions[1]
        local expected = assert(tonumber(status)) as integer
        if expected >= 0 then
            local result = oracle.run(
                f,
                args,
                oracle.Memory(bytes = {}, stackBase = 0),
                oracle.Hooks(call = nil, fma64 = nil),
                1000
            )
            assert(result.status == expected, name .. ": oracle status " .. tostring(result.status))
            output:write(("%s %d %d %d\n"):format(name, result.status, result.word, result.word2))
        end
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            if expected == -1 then
                local refusal = read(directory .. "/" .. name .. ".refusal")
                local ok, message = pcall(
                    link.build,
                    functions,
                    name,
                    mode == "spill",
                    binding ~= "none" and binding or nil
                )
                assert(
                    not ok and tostring(message):find(refusal, 1, true),
                    name .. ": wrong refusal " .. tostring(message)
                )
                refused = refused + 1
            else
                assert(check.run(f, target, allocate.run(f, target)))
                link.bundle(
                    path,
                    name,
                    directory .. "/" .. mode .. "/" .. name,
                    digest,
                    mode,
                    binding ~= "none" and binding or nil
                )
                accepted = accepted + 1
            end
        end
    end
    for line in read(directory .. "/reader-refusals.tsv"):gmatch("[^\n]+") do
        local name, reason = line:match("^(%w+) (.+)$")
        assert(name and reason, "reader refusal fixture row")
        local ok, message = pcall(reader.read, read(directory .. "/" .. name .. ".clif"))
        assert(
            not ok and tostring(message):find(reason, 1, true),
            name .. ": wrong reader refusal " .. tostring(message)
        )
        refused = refused + 1
    end
    output:close()

    return ("%d native bundles and %d explicit refusals prepared"):format(accepted, refused)
end
