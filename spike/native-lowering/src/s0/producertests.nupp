module s0.producertests

local reader = require("s0.reader")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local link = require("s0.link")

local function read(path: string): string
    local file = assert(io.open(path, "rb"))
    local text = assert(file:read("*a"))
    file:close()
    return text
end

export function prepare(directory: string, digest: string): string
    local count: integer = 0
    for line in read(directory .. "/functions.tsv"):gmatch("[^\n]+") do
        local name, producerText, foldedText, maskText, wordText, constantText = line:match(
            "^(%w+) (%d+) (%d+) (%w+) (%w+) ([%d-]+)$"
        )
        assert(name, "producer fixture row")
        local path = directory .. "/" .. name .. ".clif"
        local f = reader.read(read(path))[1]
        local mask, expected = reader.integer(assert(maskText)), reader.integer(assert(wordText))
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters, target.floatRegisters = {}, {}
            end
            local allocation = allocate.run(f, target)
            assert(check.run(f, target, allocation))
            local code = selector.run(f, allocation)
            local producer = reader.integer(assert(producerText))
            if producer > 0 then
                local omitted = code.opWords[producer] == 0
                assert(omitted == (foldedText == "1"), name .. ": producer omission differs")
            end
            local constant = reader.integer(assert(constantText))
            if constant >= 0 then
                assert(
                    code.opWords[ir.OP_ICONST] == constant + (mode == "spill" and 1 or 0),
                    name .. ": constant sequence length"
                )
            end
            local found = mask == 0
            for _, word in ipairs(code.words) do
                if (word & mask) == expected then
                    found = true
                end
            end
            assert(found, name .. ": expected instruction missing")
            link.bundle(path, name, directory .. "/" .. mode .. "/" .. name, digest, mode)
            count = count + 1
        end
    end

    return ("%d checked producer bundles and instruction-shape assertions passed"):format(count)
end
