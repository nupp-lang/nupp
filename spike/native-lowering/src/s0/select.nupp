module s0.select

local ir = require("s0.ir")
local allocate = require("s0.allocate")
local arm = require("s0.arm64")
local target = require("s0.arm64target")
local selector = {}

const BORROW_ICMP: 20 = ir.OP_ICMP as 20
const BORROW_FCMP: 21 = ir.OP_FCMP as 21
const BORROW_SELECT: 22 = ir.OP_SELECT as 22
const BORROW_LOAD: 23 = ir.OP_LOAD as 23
const BORROW_SLOAD: 24 = ir.OP_SLOAD as 24
const BORROW_STACK_ADDR: 46 = ir.OP_STACK_ADDR as 46
local integerConditions = {0, 1, 11, 13, 12, 10, 3, 9, 8, 2}
local floatConditions: {
    [integer]: integer
} = {[1] = 0, [2] = 1, [11] = 7, [12] = 6, [13] = 4, [14] = 9, [15] = 12, [16] = 10, [19] = 6}
local SIGNED_LT, SIGNED_GE = ir.condition("slt"), ir.condition("sge")
local UNORDERED_EQ, ORDERED_NE, LESS_GREATER = ir.condition("ueq"), ir.condition("one"), ir.condition("ltgt")

selector.B26, selector.BL26, selector.IMPORT_LOAD = 1, 2, 3

record selector.Code
    words: {integer}
    fixupWord: {integer}
    fixupKind: {integer}
    fixupName: {string}
    fixupAddend: {integer}
    blockWord: {integer}
    frameBytes: integer
    stackOffsets: {integer}
    opWords: {integer}
    opCounts: {integer}
end

function selector.target(): allocate.Target
    local internal: {boolean} = {}
    local c: {boolean} = {}
    for p = 1, 96 do
        internal[p], c[p] = false, false
    end
    for _, p in ipairs(target.cIntegerPreserved) do
        c[p] = true
    end
    for _, p in ipairs(target.cFloatPreserved) do
        c[p] = true
    end

    return new allocate.Target(
        integerRegisters = target.integerRegisters,
        floatRegisters = target.floatRegisters,
        preservedInternal = internal,
        preservedC = c,
        scratchInt = 17,
        scratchFloat = 96
    )
end

local function bits(kind: integer): integer
    return kind == ir.I8 and 8 or kind == ir.I16 and 16 or (kind == ir.I32 or kind == ir.F32) and 32 or 64
end

local function machine(kind: integer): integer
    return bits(kind) <= 32 and 32 or 64
end

local function align(value: integer, boundary: integer): integer
    assert(boundary > 0 and (boundary & (boundary - 1)) == 0, "S0 select: invalid alignment")
    return (value + boundary - 1) & -boundary
end

-- Return raw logical-immediate fields; the encoder validates their shape.
local function logical(value: integer, width: integer): (integer, integer, integer)
    local mask = width == 64 and -1 or 0xffffffff
    value = value & mask
    if value == 0 or value == mask then
        return -1, 0, 0
    end
    for length = 1, width == 64 and 6 or 5 do
        local size = 1 << length
        local elementMask = size == 64 and -1 or (1 << size) - 1
        local element = value & elementMask
        local repeated = element
        local shift = size
        while shift < width do
            repeated = repeated | (element << shift)
            shift = shift + size
        end
        if repeated == value then
            for rotation = 0, size - 1 do
                local rotated = rotation == 0 and element
                    or ((element >> rotation) | (element << (size - rotation))) & elementMask
                if rotated ~= 0 and rotated ~= elementMask and (rotated & (rotated + 1)) == 0 then
                    local ones = 0
                    while rotated ~= 0 do
                        rotated, ones = rotated >> 1, ones + 1
                    end
                    local n = size == 64 and 1 or 0
                    local imms = ((~(size - 1) << 1) | (ones - 1)) & 63
                    return n, (size - rotation) % size, imms
                end
            end
        end
    end

    return -1, 0, 0
end

local function stackBorrowed(f: ir.Function): {boolean}
    local borrowed: {boolean} = {}
    if #f.stackBytes == 0 then
        return borrowed
    end
    for v = 1, #f.valueKinds do
        borrowed[v] = false
    end
    local changed = true
    while changed do
        changed = false
        for at, opid in ipairs(f.op) do
            local value, op = f.result[at], opid
            if value ~= 0 and not borrowed[value] then
                local derives = op == BORROW_STACK_ADDR
                if op ~= BORROW_LOAD and op ~= BORROW_SLOAD and op ~= BORROW_ICMP and op ~= BORROW_FCMP then
                    for p = f.firstArg[at], f.firstArg[at] + f.nargs[at] - 1 do
                        if (op ~= BORROW_SELECT or p ~= f.firstArg[at]) and borrowed[f.args[p]] then
                            derives = true
                        end
                    end
                end
                if derives then
                    borrowed[value], changed = true, true
                end
            end
            local second = f.result2[at]
            if second ~= 0 and borrowed[value] and not borrowed[second] then
                borrowed[second], changed = true, true
            end
        end
        for edge, block in ipairs(f.edgeTarget) do
            for p = 0, f.edgeNargs[edge] - 1 do
                local value, parameter = f.edgeArgs[f.edgeFirstArg[edge] + p], f.params[f.firstParam[block] + p]
                if borrowed[value] and not borrowed[parameter] then
                    borrowed[parameter], changed = true, true
                end
            end
        end
    end

    return borrowed
end

function selector.run(f: ir.Function, a: allocate.Allocation): selector.Code
    const ICONST: 1 = ir.OP_ICONST as 1
    const FCONST: 2 = ir.OP_FCONST as 2
    const IADD: 3 = ir.OP_IADD as 3
    const ISUB: 4 = ir.OP_ISUB as 4
    const IMUL: 5 = ir.OP_IMUL as 5
    const UDIV: 6 = ir.OP_UDIV as 6
    const SDIV: 7 = ir.OP_SDIV as 7
    const UREM: 8 = ir.OP_UREM as 8
    const SREM: 9 = ir.OP_SREM as 9
    const UMULHI: 10 = ir.OP_UMULHI as 10
    const SMULHI: 11 = ir.OP_SMULHI as 11
    const BAND: 12 = ir.OP_BAND as 12
    const BOR: 13 = ir.OP_BOR as 13
    const BXOR: 14 = ir.OP_BXOR as 14
    const BNOT: 15 = ir.OP_BNOT as 15
    const ISHL: 16 = ir.OP_ISHL as 16
    const USHR: 17 = ir.OP_USHR as 17
    const SSHR: 18 = ir.OP_SSHR as 18
    const POPCNT: 19 = ir.OP_POPCNT as 19
    const ICMP: 20 = ir.OP_ICMP as 20
    const FCMP: 21 = ir.OP_FCMP as 21
    const SELECT: 22 = ir.OP_SELECT as 22
    const LOAD: 23 = ir.OP_LOAD as 23
    const SLOAD: 24 = ir.OP_SLOAD as 24
    const STORE: 25 = ir.OP_STORE as 25
    const IREDUCE: 26 = ir.OP_IREDUCE as 26
    const UEXTEND: 27 = ir.OP_UEXTEND as 27
    const SEXTEND: 28 = ir.OP_SEXTEND as 28
    const BITCAST: 29 = ir.OP_BITCAST as 29
    const FPROMOTE: 30 = ir.OP_FPROMOTE as 30
    const FDEMOTE: 31 = ir.OP_FDEMOTE as 31
    const FADD: 32 = ir.OP_FADD as 32
    const FSUB: 33 = ir.OP_FSUB as 33
    const FMUL: 34 = ir.OP_FMUL as 34
    const FDIV: 35 = ir.OP_FDIV as 35
    const FNEG: 36 = ir.OP_FNEG as 36
    const FABS: 37 = ir.OP_FABS as 37
    const SQRT: 38 = ir.OP_SQRT as 38
    const FLOOR: 39 = ir.OP_FLOOR as 39
    const CEIL: 40 = ir.OP_CEIL as 40
    const FMA: 41 = ir.OP_FMA as 41
    const FCVT_FROM_SINT: 42 = ir.OP_FCVT_FROM_SINT as 42
    const FCVT_FROM_UINT: 43 = ir.OP_FCVT_FROM_UINT as 43
    const FCVT_TO_SINT_SAT: 44 = ir.OP_FCVT_TO_SINT_SAT as 44
    const FCVT_TO_UINT_SAT: 45 = ir.OP_FCVT_TO_UINT_SAT as 45
    const STACK_ADDR: 46 = ir.OP_STACK_ADDR as 46
    const CALL: 47 = ir.OP_CALL as 47
    const CALL_INDIRECT: 48 = ir.OP_CALL_INDIRECT as 48
    const RETURN_CALL: 49 = ir.OP_RETURN_CALL as 49
    const RETURN_CALL_INDIRECT: 50 = ir.OP_RETURN_CALL_INDIRECT as 50
    const JUMP: 51 = ir.OP_JUMP as 51
    const BRIF: 52 = ir.OP_BRIF as 52
    const RETURN: 53 = ir.OP_RETURN as 53
    const TRAP: 54 = ir.OP_TRAP as 54
    local stackValues = stackBorrowed(f)
    local code = new selector.Code(
        words = {},
        fixupWord = {},
        fixupKind = {},
        fixupName = {},
        fixupAddend = {},
        blockWord = {},
        frameBytes = 0,
        stackOffsets = {},
        opWords = {},
        opCounts = {}
    )
    local cursor: integer = 16 + a.spillSlots * 8
    for slot, bytes in ipairs(f.stackBytes) do
        cursor = align(cursor, f.stackAlign[slot])
        code.stackOffsets[slot], cursor = cursor, cursor + bytes
    end
    local scratchBase = align(cursor, 8)
    local stageBase = scratchBase + 64
    code.frameBytes = align(stageBase + 17 * 8, 16)
    assert(code.frameBytes <= 32760, "S0 select: arena frame exceeds direct spill addressing")
    for op = 1, #ir.opNames do
        code.opWords[op], code.opCounts[op] = 0, 0
    end
    local localWord: {integer} = {}
    local localBlock: {integer} = {}
    local borrowed: {integer} = {}
    local occupied: {integer} = {}
    local used: {integer} = {}
    for physical = 1, 96 do
        occupied[physical], used[physical] = 0, 0
    end
    local occupiedStamp: integer = 0
    local usedStamp: integer = 0
    local borrowedCount: integer = 0
    local regs: {integer} = {}
    local transportSources: {integer} = {}
    local transportDestinations: {integer} = {}
    local transportKinds: {integer} = {}
    local abiRegisters: {integer} = {}
    local moveTarget = selector.target()
    local moveWorkspace = allocate.workspace()

    local function emit(word: integer): nil
        assert(word >= 0 and word <= 0xffffffff, "S0 select: codeword range")
        code.words[#code.words + 1] = word
    end

    local function constant(rd: integer, value: integer, width: integer): nil
        local halves = width // 16
        local nonzero, nonones = 0, 0
        for half = 0, halves - 1 do
            local part = (value >> (half * 16)) & 65535
            if part ~= 0 then
                nonzero = nonzero + 1
            end
            if part ~= 65535 then
                nonones = nonones + 1
            end
        end
        local invert = nonones < nonzero
        local first = true
        for half = 0, halves - 1 do
            local part = (value >> (half * 16)) & 65535
            if (invert and part ~= 65535) or (not invert and part ~= 0) then
                if first then
                    emit(invert and arm.movn(width, rd, (~part) & 65535, half) or arm.movz(width, rd, part, half))
                    first = false
                else
                    emit(arm.movk(width, rd, part, half))
                end
            end
        end
        if first then
            emit(invert and arm.movn(width, rd, 0, 0) or arm.movz(width, rd, 0, 0))
        end
    end

    local function addOffset(rd: integer, rn: integer, amount: integer): nil
        assert(amount >= 0 and amount < 16777216, "S0 select: address increment range")
        local high, low = amount >> 12, amount & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, rd, rn, high, 1));
            rn = rd
        end
        if low ~= 0 or high == 0 then
            emit(arm.add_imm(64, rd, rn, low, 0))
        end
    end

    local function spillOffset(location: integer): integer
        assert(location < 0 and -location <= a.spillSlots, "S0 select: invalid spill")
        return 16 + (-location - 1) * 8
    end

    local function save(reg: integer, offset: integer): nil
        emit(reg >= 65 and arm.str_fp(64, reg - 65, 23, offset) or arm.str(8, reg - 1, 23, offset))
    end

    local function restore(reg: integer, offset: integer): nil
        emit(reg >= 65 and arm.ldr_fp(64, reg - 65, 23, offset) or arm.ldr(8, reg - 1, 23, offset))
    end

    local function temporary(floating: boolean): integer
        local first, last = floating and 96 or 18, floating and 65 or 1
        for p = first, last, -1 do
            local allowed = floating or p == 17 or p == 18 or p <= 16
            if allowed and used[p] ~= usedStamp and occupied[p] ~= occupiedStamp then
                used[p] = usedStamp
                if p ~= 17 and p ~= 18 and p ~= 96 then
                    assert(borrowedCount < 8, "S0 select: scratch capacity")
                    save(p, scratchBase + borrowedCount * 8)
                    borrowedCount = borrowedCount + 1
                    borrowed[borrowedCount] = p
                end
                return target.register(p)
            end
        end
        error("S0 select: no scratch register")
    end

    local function source(value: integer): integer
        local location, kind = a.location[value], f.valueKinds[value]
        assert(location ~= 0, "S0 select: unallocated source")
        if location > 0 then
            return target.register(location)
        end
        local reg = temporary(ir.isFloat(kind))
        local remat = a.rematerialize[value]
        if remat ~= 0 and f.op[remat] == ICONST then
            constant(reg, f.imm[remat], machine(kind))
        elseif remat ~= 0 and f.op[remat] == STACK_ADDR then
            addOffset(reg, 23, code.stackOffsets[f.aux[remat]] + f.imm[remat])
        else
            restore(ir.isFloat(kind) and reg + 65 or reg + 1, spillOffset(location))
        end

        return reg
    end

    local function destination(value: integer): integer
        local location = a.location[value]
        assert(location ~= 0, "S0 select: unallocated result")
        return location > 0 and target.register(location) or temporary(ir.isFloat(f.valueKinds[value]))
    end

    local function finish(value: integer, reg: integer): nil
        if value ~= 0 then
            local kind = f.valueKinds[value]
            if kind == ir.I8 or kind == ir.I16 then
                emit(arm.ubfm(32, reg, reg, 0, bits(kind) - 1))
            end
            if a.location[value] < 0 then
                save(ir.isFloat(kind) and reg + 65 or reg + 1, spillOffset(a.location[value]))
            end
        end
        for p = borrowedCount, 1, -1 do
            restore(borrowed[p], scratchBase + (p - 1) * 8)
        end
    end

    local function move(sourceLoc: integer, destinationLoc: integer, kind: integer): nil
        if sourceLoc == destinationLoc then
            return
        end
        if sourceLoc < 0 and destinationLoc < 0 then
            emit(arm.ldr(8, 17, 23, spillOffset(sourceLoc)))
            emit(arm.str(8, 17, 23, spillOffset(destinationLoc)))
        elseif sourceLoc < 0 then
            restore(destinationLoc, spillOffset(sourceLoc))
        elseif destinationLoc < 0 then
            save(sourceLoc, spillOffset(destinationLoc))
        elseif ir.isFloat(kind) then
            emit(arm.fmov(bits(kind), target.register(destinationLoc), target.register(sourceLoc)))
        else
            emit(arm.mov_reg(machine(kind), target.register(destinationLoc), target.register(sourceLoc)))
        end
    end

    local function transport(sources: {integer}, destinations: {integer}, kinds: {integer}): nil
        local first = #a.moveSource + 1
        allocate.parallel(sources, destinations, kinds, moveTarget, a, moveWorkspace)
        for p = first, #a.moveSource do
            move(a.moveSource[p], a.moveTarget[p], a.moveKind[p])
        end
        -- Preserve the allocator's edge-move arrays after temporary scheduling.
        for p = #a.moveSource, first, -1 do
            a.moveSource[p], a.moveTarget[p], a.moveKind[p] = nil, nil, nil
        end
    end

    local function edge(e: integer, nextBlock: integer): nil
        for p = a.firstMove[e], a.firstMove[e] + a.nmoves[e] - 1 do
            move(a.moveSource[p], a.moveTarget[p], a.moveKind[p])
        end
        if f.edgeTarget[e] ~= nextBlock then
            localWord[#localWord + 1], localBlock[#localBlock + 1] = #code.words + 1, f.edgeTarget[e]
            emit(arm.b(0))
        end
    end

    local function symbolic(kind: integer, name: string): nil
        code.fixupWord[#code.fixupWord + 1], code.fixupKind[#code.fixupKind + 1] = #code.words + 1, kind
        code.fixupName[#code.fixupName + 1], code.fixupAddend[#code.fixupAddend + 1] = name, 0
        emit(kind == selector.B26 and arm.b(0) or kind == selector.BL26 and arm.bl(0) or arm.ldr(8, 16, 22, 0))
    end

    local function abi(kinds: {integer}): nil
        local ints: integer = 0
        local floats: integer = 0
        local registers = abiRegisters
        for p, kind in ipairs(kinds) do
            if ir.isFloat(kind) then
                registers[p], floats = 65 + floats, floats + 1
            else
                registers[p], ints = 1 + ints, ints + 1
            end
        end
        assert(ints <= 8 and floats <= 8, "S0 select: stack ABI arguments unsupported")

        for p = #registers, #kinds + 1, -1 do
            registers[p] = nil
        end
    end

    emit(arm.str(8, 30, 23, 0))
    abi(f.signature.params)
    local incoming, incomingLocations = abiRegisters, transportDestinations
    for p, physical in ipairs(incoming) do
        incomingLocations[p] = a.location[f.params[f.firstParam[1] + p - 1]]
    end
    transport(incoming, incomingLocations, f.signature.params)

    -- Keep operation IDs and immutable columns local to the selection loop.
    local colArgs = f.args
    local colAux = f.aux
    local colBlockEnd = f.blockEnd
    local colBlockStart = f.blockStart
    local colDefinitions = f.definitions
    local colFirstArg = f.firstArg
    local colFirstEdge = f.firstEdge
    local colImm = f.imm
    local colImportNames = f.importNames
    local colImportSignatures = f.importSignatures
    local colKind = f.kind
    local colKind2 = f.kind2
    local colNargs = f.nargs
    local colOp = f.op
    local colResult = f.result
    local colResult2 = f.result2
    local colSignatures = f.signatures
    local colValueKinds = f.valueKinds
    local allocationLocation = a.location

    -- Edge arguments count as uses too: a branch may both test a boolean and
    -- carry it into a successor. Only its sole adjacent test can use flags.
    local uses: {integer} = {}
    for value = 1, #colValueKinds do
        uses[value] = 0
    end
    for _, value in ipairs(colArgs) do
        uses[value] = uses[value] + 1
    end
    for _, value in ipairs(f.edgeArgs) do
        uses[value] = uses[value] + 1
    end
    for order, block in ipairs(a.blockOrder) do
        local nextBlock = a.blockOrder[order + 1] or 0
        local fusedCondition: integer = -1
        code.blockWord[block] = #code.words + 1
        for at = colBlockStart[block], colBlockEnd[block] do
            local before = #code.words
            local op, result, kind = colOp[at], colResult[at], colKind[at]
            local firstArg, nargs = colFirstArg[at], colNargs[at]
            local fused = op == ICMP
                and at < colBlockEnd[block]
                and colOp[at + 1] == BRIF
                and colArgs[colFirstArg[at + 1]] == result
                and uses[result] == 1
            borrowedCount, occupiedStamp, usedStamp = 0, occupiedStamp + 1, usedStamp + 1
            for p = colFirstArg[at], colFirstArg[at] + colNargs[at] - 1 do
                local value = colArgs[p]
                if allocationLocation[value] > 0 then
                    occupied[allocationLocation[value]] = occupiedStamp
                end
            end
            if result ~= 0 and allocationLocation[result] > 0 then
                occupied[allocationLocation[result]] = occupiedStamp
            end
            local second = colResult2[at]
            if second ~= 0 and allocationLocation[second] > 0 then
                occupied[allocationLocation[second]] = occupiedStamp
            end
            local rd: integer = 0
            local _ = switch op do
                case JUMP -> do
                    edge(colFirstEdge[at], nextBlock)
                    yield true
                end
                case BRIF -> do
                    local condition = fusedCondition
                    if condition < 0 then
                        local value = source(colArgs[firstArg])
                        emit(arm.cmp_imm(32, value, 0, 0))
                        condition = target.NE
                        finish(0, 0)
                    end
                    -- Only loads restore borrowed scratch after CMP; flags survive.
                    -- The final edge can fall through, after its own parallel moves.
                    local first, last = colFirstEdge[at], colFirstEdge[at] + 1
                    local skip = condition ~ 1
                    if f.edgeTarget[first] == nextBlock and f.edgeTarget[last] ~= nextBlock then
                        first, last, skip = last, first, condition
                    end
                    local branch = #code.words + 1
                    emit(arm.b_cond(skip, 0))
                    edge(first, 0)
                    code.words[branch] = arm.b_cond(skip, (#code.words + 1 - branch) * 4)
                    edge(last, nextBlock)
                    fusedCondition = -1
                    yield true
                end
                case RETURN -> do
                    assert(nargs <= 2, "S0 select: multiple return values")
                    local sources, destinations, kinds = transportSources, transportDestinations, transportKinds
                    for p = #sources, nargs + 1, -1 do
                        sources[p] = nil
                    end
                    for p = #destinations, nargs + 1, -1 do
                        destinations[p] = nil
                    end
                    for p = #kinds, nargs + 1, -1 do
                        kinds[p] = nil
                    end
                    for p = 1, nargs do
                        local value = colArgs[firstArg + p - 1]
                        assert(
                            nargs == 1 or not ir.isFloat(colValueKinds[value]),
                            "S0 select: paired return requires integers"
                        )
                        sources[
                            p
                        ], destinations[p], kinds[p] = allocationLocation[value], ir.isFloat(colValueKinds[value])
                            and 65
                            or p, colValueKinds[value]
                    end
                    transport(sources, destinations, kinds)
                    emit(arm.ldr(8, 30, 23, 0))
                    emit(arm.ret(30))
                    yield true
                end
                case TRAP -> do
                    emit(arm.brk(colImm[at]))
                    yield true
                end
                case CALL, CALL_INDIRECT, RETURN_CALL, RETURN_CALL_INDIRECT -> do
                    local indirect = op == CALL_INDIRECT or op == RETURN_CALL_INDIRECT
                    local tail = op == RETURN_CALL or op == RETURN_CALL_INDIRECT
                    local signature = colSignatures[indirect and colAux[at] or colImportSignatures[colAux[at]]]
                    abi(signature.params)
                    local registers = abiRegisters
                    local shift = indirect and 1 or 0
                    assert(nargs == #registers + shift, "S0 select: call arity")
                    for p = 1, nargs do
                        local value = colArgs[firstArg + p - 1]
                        if tail then
                            assert(not stackValues[value], "S0 select: tail call retains stack address")
                        end
                        local reg = source(value)
                        save(ir.isFloat(colValueKinds[value]) and reg + 65 or reg + 1, stageBase + (p - 1) * 8)
                        finish(0, 0);
                        borrowedCount, usedStamp = 0, usedStamp + 1
                    end
                    for p, physical in ipairs(registers) do
                        restore(physical, stageBase + (p + shift - 1) * 8)
                    end
                    if indirect then
                        restore(17, stageBase)
                    end
                    if tail then
                        emit(arm.ldr(8, 30, 23, 0))
                    end
                    if signature.convention == ir.INTERNAL then
                        if not tail then
                            addOffset(23, 23, code.frameBytes)
                        end
                        if indirect then
                            emit(tail and arm.br(16) or arm.blr(16))
                        else
                            symbolic(tail and selector.B26 or selector.BL26, colImportNames[colAux[at]])
                        end
                        if not tail then
                            local high, low = code.frameBytes >> 12, code.frameBytes & 4095
                            if high ~= 0 then
                                emit(arm.sub_imm(64, 23, 23, high, 1))
                            end
                            if low ~= 0 then
                                emit(arm.sub_imm(64, 23, 23, low, 0))
                            end
                        end
                    else
                        if not indirect then
                            symbolic(selector.IMPORT_LOAD, colImportNames[colAux[at]])
                        end
                        emit(tail and arm.br(16) or arm.blr(16))
                    end
                    if not tail and second ~= 0 then
                        assert(
                            result ~= 0 and not ir.isFloat(kind) and not ir.isFloat(colKind2[at]),
                            "S0 select: paired call requires integers"
                        )
                        save(1, stageBase);
                        save(2, stageBase + 8)
                        for p = 1, 2 do
                            local value = p == 1 and result or second
                            borrowedCount, usedStamp = 0, usedStamp + 1
                            rd = destination(value)
                            restore(rd + 1, stageBase + (p - 1) * 8)
                            finish(value, rd)
                        end
                    elseif not tail and result ~= 0 then
                        borrowedCount, usedStamp = 0, usedStamp + 1
                        rd = destination(result)
                        emit(ir.isFloat(kind) and arm.fmov(bits(kind), rd, 0) or arm.mov_reg(machine(kind), rd, 0))
                        finish(result, rd)
                    end
                    yield true
                end
                else -> do
                    for p = 1, nargs do
                        local value = colArgs[firstArg + p - 1]
                        regs[p] = source(value)
                    end
                    if result ~= 0 and not fused then
                        rd = destination(result)
                    end
                    local width = machine(kind)
                    local x, y, z = nargs >= 1 and regs[1]
                        or 0, nargs >= 2 and regs[2]
                        or 0, nargs >= 3 and regs[3]
                        or 0
                    local _ = switch op do
                        case ICONST -> do
                            constant(rd, colImm[at], width)
                            yield true
                        end
                        case FCONST -> do
                            local temp = temporary(false)
                            constant(temp, colImm[at], bits(kind));
                            emit(arm.fmov_from_int(bits(kind), rd, temp))
                            yield true
                        end
                        case STACK_ADDR -> do
                            addOffset(rd, 23, code.stackOffsets[colAux[at]] + colImm[at])
                            yield true
                        end
                        case IADD -> do
                            emit(arm.add_reg(width, rd, x, y, 0))
                            yield true
                        end
                        case ISUB -> do
                            emit(arm.sub_reg(width, rd, x, y, 0))
                            yield true
                        end
                        case IMUL -> do
                            emit(arm.madd(width, rd, x, y, 31))
                            yield true
                        end
                        case UMULHI, SMULHI -> do
                            assert(width == 64, "S0 select: narrow multiply-high unsupported")
                            emit(op == UMULHI and arm.umulh(rd, x, y) or arm.smulh(rd, x, y))
                            yield true
                        end
                        case BAND, BOR, BXOR -> do
                            local definition = colDefinitions[colArgs[firstArg + 1]]
                            local n: integer = -1
                            local r: integer = 0
                            local s: integer = 0
                            if definition > 0 and colOp[definition] == ICONST then
                                n, r, s = logical(colImm[definition], width)
                            end
                            if n >= 0 then
                                emit(
                                    op == BAND and arm.and_imm(width, rd, x, n, r, s)
                                    or op == BOR and arm.orr_imm(width, rd, x, n, r, s)
                                    or arm.eor_imm(width, rd, x, n, r, s)
                                )
                            else
                                emit(
                                    op == BAND and arm.and_reg(width, rd, x, y)
                                    or op == BOR and arm.orr_reg(width, rd, x, y)
                                    or arm.eor_reg(width, rd, x, y)
                                )
                            end
                            yield true
                        end
                        case BNOT -> do
                            emit(arm.mvn(width, rd, x))
                            yield true
                        end
                        case ISHL, USHR, SSHR -> do
                            if bits(kind) < 32 then
                                local temp = temporary(false)
                                emit(arm.ubfm(32, temp, y, 0, kind == ir.I8 and 2 or 3));
                                y = temp
                                if op == SSHR then
                                    local signed = temporary(false);
                                    emit(arm.sbfm(32, signed, x, 0, bits(kind) - 1));
                                    x = signed
                                end
                            end
                            emit(
                                op == ISHL and arm.lslv(width, rd, x, y)
                                or op == USHR and arm.lsrv(width, rd, x, y)
                                or arm.asrv(width, rd, x, y)
                            )
                            yield true
                        end
                        case POPCNT -> do
                            local t = temporary(false)
                            emit(arm.ubfm(width, t, x, 1, width - 1))
                            emit(arm.and_imm(width, t, t, 0, 0, 60))
                            emit(arm.sub_reg(width, rd, x, t, 0))
                            emit(arm.ubfm(width, t, rd, 2, width - 1))
                            emit(arm.and_imm(width, t, t, 0, 0, 57))
                            emit(arm.and_imm(width, rd, rd, 0, 0, 57))
                            emit(arm.add_reg(width, rd, rd, t, 0))
                            emit(arm.ubfm(width, t, rd, 4, width - 1))
                            emit(arm.add_reg(width, rd, rd, t, 0))
                            emit(arm.and_imm(width, rd, rd, 0, 0, 51))
                            constant(t, width == 64 and 0x0101010101010101 or 0x01010101, width)
                            emit(arm.madd(width, rd, rd, t, 31));
                            emit(arm.ubfm(width, rd, rd, width - 8, width - 1))
                            yield true
                        end
                        case UDIV, SDIV, UREM, SREM -> do
                            local signed = op == SDIV or op == SREM
                            if signed and bits(kind) < 32 then
                                local tx, ty = temporary(false), temporary(false)
                                emit(arm.sbfm(32, tx, x, 0, bits(kind) - 1));
                                emit(arm.sbfm(32, ty, y, 0, bits(kind) - 1));
                                x, y = tx, ty
                            end
                            emit(arm.cbnz(width, y, 8));
                            emit(arm.brk(1))
                            if op == SDIV then
                                local t = temporary(false)
                                constant(t, 1 << (bits(kind) - 1), width)
                                if bits(kind) < 32 then
                                    emit(arm.sbfm(32, t, t, 0, bits(kind) - 1))
                                end
                                emit(arm.cmp_reg(width, x, t));
                                local skip = #code.words + 1;
                                emit(arm.b_cond(target.NE, 0))
                                constant(t, -1, width);
                                emit(arm.cmp_reg(width, y, t));
                                emit(arm.b_cond(target.NE, 8));
                                emit(arm.brk(2))
                                code.words[skip] = arm.b_cond(target.NE, (#code.words + 1 - skip) * 4)
                            end
                            local quotient = (op == UREM or op == SREM) and temporary(false) or rd
                            emit(signed and arm.sdiv(width, quotient, x, y) or arm.udiv(width, quotient, x, y))
                            if quotient ~= rd then
                                emit(arm.msub(width, rd, quotient, y, x))
                            end
                            yield true
                        end
                        case ICMP -> do
                            local condition = colAux[at]
                            local operandKind = colValueKinds[colArgs[firstArg]]
                            local w = machine(operandKind)
                            if condition >= SIGNED_LT and condition <= SIGNED_GE and bits(operandKind) < 32 then
                                local tx, ty = temporary(false), temporary(false)
                                emit(arm.sbfm(32, tx, x, 0, bits(operandKind) - 1));
                                emit(arm.sbfm(32, ty, y, 0, bits(operandKind) - 1));
                                x, y = tx, ty
                            end
                            emit(arm.cmp_reg(w, x, y));
                            local cc = assert(integerConditions[condition], "S0 select: integer comparison")
                            if fused then
                                fusedCondition = cc
                            else
                                emit(arm.cset(32, rd, cc))
                            end
                            yield true
                        end
                        case FCMP -> do
                            local condition = colAux[at]
                            emit(arm.fcmp(bits(colValueKinds[colArgs[firstArg]]), x, y))
                            local cc = floatConditions[condition]
                            if cc ~= nil then
                                emit(arm.cset(32, rd, cc))
                            elseif condition == UNORDERED_EQ then
                                local t = temporary(false)
                                emit(arm.cset(32, t, target.VS));
                                emit(arm.cset(32, rd, target.EQ));
                                emit(arm.orr_reg(32, rd, rd, t))
                            elseif condition == ORDERED_NE or condition == LESS_GREATER then
                                emit(arm.cset(32, rd, target.NE));
                                emit(arm.csel(32, rd, rd, 31, target.VC))
                            else
                                error("S0 select: float comparison")
                            end
                            yield true
                        end
                        case SELECT -> do
                            emit(arm.cmp_imm(32, x, 0, 0))
                            emit(
                                ir.isFloat(kind) and arm.fcsel(bits(kind), rd, y, z, target.NE)
                                or arm.csel(width, rd, y, z, target.NE)
                            )
                            yield true
                        end
                        case IREDUCE, UEXTEND, SEXTEND -> do
                            local from = bits(colValueKinds[colArgs[firstArg]])
                            local retained = math.min(from, bits(kind))
                            emit(
                                op == SEXTEND and arm.sbfm(width, rd, x, 0, retained - 1)
                                or arm.ubfm(width, rd, x, 0, retained - 1)
                            )
                            yield true
                        end
                        case BITCAST -> do
                            local from = colValueKinds[colArgs[firstArg]]
                            assert(bits(from) == bits(kind), "S0 select: bitcast width")
                            if ir.isFloat(kind) == ir.isFloat(from) then
                                emit(ir.isFloat(kind) and arm.fmov(bits(kind), rd, x) or arm.mov_reg(width, rd, x))
                            else
                                emit(
                                    ir.isFloat(kind) and arm.fmov_from_int(bits(kind), rd, x)
                                    or arm.fmov_to_int(bits(kind), rd, x)
                                )
                            end
                            yield true
                        end
                        case FPROMOTE, FDEMOTE -> do
                            emit(arm.fcvt(bits(kind), bits(colValueKinds[colArgs[firstArg]]), rd, x))
                            yield true
                        end
                        case FADD -> do
                            emit(arm.fadd(bits(kind), rd, x, y))
                            yield true
                        end
                        case FSUB -> do
                            emit(arm.fsub(bits(kind), rd, x, y))
                            yield true
                        end
                        case FMUL -> do
                            emit(arm.fmul(bits(kind), rd, x, y))
                            yield true
                        end
                        case FDIV -> do
                            emit(arm.fdiv(bits(kind), rd, x, y))
                            yield true
                        end
                        case FNEG -> do
                            emit(arm.fneg(bits(kind), rd, x))
                            yield true
                        end
                        case FABS -> do
                            emit(arm.fabs(bits(kind), rd, x))
                            yield true
                        end
                        case SQRT -> do
                            emit(arm.fsqrt(bits(kind), rd, x))
                            yield true
                        end
                        case FLOOR -> do
                            emit(arm.frintm(bits(kind), rd, x))
                            yield true
                        end
                        case CEIL -> do
                            emit(arm.frintp(bits(kind), rd, x))
                            yield true
                        end
                        case FMA -> do
                            emit(arm.fmadd(bits(kind), rd, x, y, z))
                            yield true
                        end
                        case FCVT_FROM_SINT, FCVT_FROM_UINT -> do
                            local from = colValueKinds[colArgs[firstArg]]
                            if op == FCVT_FROM_SINT and bits(from) < 32 then
                                local t = temporary(false);
                                emit(arm.sbfm(32, t, x, 0, bits(from) - 1));
                                x = t
                            end
                            emit(
                                op == FCVT_FROM_SINT and arm.scvtf(bits(kind), machine(from), rd, x)
                                or arm.ucvtf(bits(kind), machine(from), rd, x)
                            )
                            yield true
                        end
                        case FCVT_TO_SINT_SAT, FCVT_TO_UINT_SAT -> do
                            assert(bits(kind) >= 32, "S0 select: narrow saturating conversion unsupported")
                            emit(
                                op == FCVT_TO_SINT_SAT
                                and arm.fcvtzs(bits(colValueKinds[colArgs[firstArg]]), width, rd, x)
                                or arm.fcvtzu(bits(colValueKinds[colArgs[firstArg]]), width, rd, x)
                            )
                            yield true
                        end
                        case LOAD, SLOAD, STORE -> do
                            local store = op == STORE
                            local valueKind = store and colValueKinds[colArgs[firstArg]] or kind
                            local bytes = (colAux[at] ~= 0 and colAux[at] or bits(valueKind)) // 8
                            local address, value = store and y or x, store and x or rd
                            local offset = colImm[at]
                            if offset < 0 or offset % bytes ~= 0 or offset // bytes >= 4096 then
                                local temp = temporary(false)
                                constant(temp, offset, 64);
                                emit(arm.add_reg(64, temp, address, temp, 0));
                                address, offset = temp, 0
                            end
                            if ir.isFloat(valueKind) then
                                emit(
                                    store and arm.str_fp(bits(valueKind), value, address, offset)
                                    or arm.ldr_fp(bits(valueKind), value, address, offset)
                                )
                            elseif store then
                                emit(arm.str(bytes, value, address, offset))
                            else
                                emit(arm.ldr(bytes, value, address, offset))
                                if op == SLOAD then
                                    emit(arm.sbfm(machine(valueKind), value, value, 0, bytes * 8 - 1))
                                end
                            end
                            yield true
                        end
                        else -> error("S0 select: unsupported operation " .. tostring(ir.opNames[op]))
                    end
                    finish(fused and 0 or result, rd)
                    yield true
                end
            end
            code.opCounts[colOp[at]] = code.opCounts[colOp[at]] + 1
            code.opWords[colOp[at]] = code.opWords[colOp[at]] + #code.words - before
        end
    end
    for p, word in ipairs(localWord) do
        code.words[word] = arm.b((code.blockWord[localBlock[p]] - word) * 4)
    end

    return code
end

export = selector
