module nupp.compiler.s0.nativegraph

local graph = require("nupp.compiler.vm.graph")
local residual = require("nupp.compiler.vm.residual")
local recipes = require("nupp.compiler.vm.machinerecipes")
local ir = require("s0.ir")
local literal = require("s0.literal")
local sink = {}
local operations = {IAdd = ir.OP_IADD, ISub = ir.OP_ISUB, IAnd = ir.OP_BAND, IOr = ir.OP_BOR}

record sink.Result
    machine: ir.Function
    body: any
    pc: integer
    count: integer
    source: any
    positions: any
    segments: any
    -- Zero marks synthetic entry setup; other entries index the graph metadata.
    instructionPosition: {integer}
    instructionOperation: {integer}
    instructionSegment: {integer}
end

local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item)
    end

    return result
end

-- Prototype: private compiler-result provenance is checked before public data
-- can be observed. Loader opcode/tag and integer-window authority remain pending.
-- The returned artifact retains the exact body owner through linking/execution.
function sink.lower(bound: any, name: string): sink.Result
    bound = residual.snapshot(bound)
    local g = bound.graph
    graph.verify(g)
    assert(bound.body ~= nil, "S0 graph: retained body owner required")
    assert(name:match("^[%w_%.]+$") ~= nil, "S0 graph: invalid name")
    assert(g.native and g.native.abi == "handler" and g.nparams == 6, "S0 graph: handler required")
    assert(#g.blocks == 1 and #g.blocks[1].params == 0, "S0 graph: single closed block required")
    local block = g.blocks[1]
    assert(
        #g.certificates == 0 and g.recovery == nil and g.recoveries == nil,
        "S0 graph: recovery metadata unsupported"
    )
    for _, certificate in ipairs(block.cert) do
        assert(certificate == 0, "S0 graph: certificates unsupported")
    end
    assert(block.term.kind == "dispatch", "S0 graph: dispatch terminator required")
    local signature = new ir.Signature(
        params = {ir.I64, ir.I64, ir.I64, ir.I64, ir.I64, ir.I64},
        results = {ir.I64},
        convention = ir.INTERNAL
    )
    local f = ir.new(name, signature)
    f.signatures[1] = signature
    f.blockStart[1], f.firstParam[1], f.nparams[1] = 1, 1, 6
    -- Preserve reader's vN -> N+1 mapping, including its unused value zero slot.
    local nextValue = #g.types + 1
    local tableValue = nextValue + 1
    nextValue = tableValue
    for index = 1, 6 do
        local value = index == 6 and tableValue or index + 1
        f.params[index] = value
        ir.value(f, value, ir.I64, -1)
    end
    local positions, instructions, segments = {}, {}, {}
    local position, operation, segment = 0, 0, 0

    local function emit(
        op: string,
        destination: any,
        first: any,
        second: any,
        tail: {any}?,
        kind: string,
        loadBits: integer,
        text: string?
    ): any
        local result: integer = destination or 0
        if result == 0 and op ~= "store" and op ~= "return_call_indirect" then
            nextValue = nextValue + 1
            result = nextValue
        end
        local immediate: int64 = text and literal.integer(text) or 0
        local aux = op == "return_call_indirect" and 1 or (op == "load" and loadBits or 0)
        local at = ir.instructionRange(
            f,
            ir.opcode(op),
            result,
            op == "store" and 0 or ir.kind(kind),
            first,
            second,
            tail,
            1,
            tail and #tail or 0,
            immediate,
            aux
        )
        positions[at], instructions[at], segments[at] = position, operation, segment

        return result
    end

    recipes.entry(emit, 7, 3, 32)
    local sourceSegments = bound.segments
        or {{pc = bound.pc, source = g.source, first = 1, last = #block.op, dispatch = block.term}}
    assert(#sourceSegments == (bound.count or 1), "S0 graph: segment count")
    local nextOperation = 1
    for index, item in ipairs(sourceSegments) do
        assert(
            item.first == nextOperation and item.last >= item.first and item.last <= #block.op,
            "S0 graph: segment coverage"
        )
        assert(item.pc == bound.pc + (index - 1) * 16, "S0 graph: segment PC")
        nextOperation = item.last + 1
    end
    assert(nextOperation == #block.op + 1, "S0 graph: segment coverage")
    local detached = copy(sourceSegments)
    for index, op in ipairs(block.op) do
        operation, position = index, block.pos[index]
        for at, item in ipairs(sourceSegments) do
            if index >= item.first and index <= item.last then
                segment = at
                if index == item.first then
                    detached[at].firstMachine = #f.op + 1
                end
            end
        end
        local args, destination = block.args[index], block.dst[index]
        local result = destination ~= 0 and destination + 1 or nil
        local _ = switch op do
            case "NativeConstant" -> do
                assert(
                    g.exactTypes[destination] == "int64" or g.exactTypes[destination] == "uint64",
                    "S0 graph: word literal required"
                )
                emit("iconst", result, nil, nil, nil, "i64", 0, args[1])
                yield nil
            end
            case "IAdd", "ISub", "IAnd", "IOr" -> do
                emit(ir.opNames[operations[op]], result, args[1] + 1, args[2] + 1, nil, "i64", 0, nil)
                yield nil
            end
            case "PointerOffset" -> do
                emit("iadd", result, args[1] + 1, args[2] + 1, nil, "i64", 0, nil)
                yield nil
            end
            case "FrameSlotRead", "FrameSlotWrite" -> do
                local access = args[op == "FrameSlotRead" and 4 or 5]
                assert(access.class == "i" and access.kind == "uint64", "S0 graph: integer bits slot required")
                recipes.slot(
                    emit,
                    result,
                    args[2] + 1,
                    args[3] + 1,
                    op == "FrameSlotWrite" and args[4] + 1 or nil,
                    access,
                    "i64"
                )
                yield nil
            end
            else -> do
                error("S0 graph: unsupported bound operation " .. op, 0)
            end
        end
        for at, item in ipairs(sourceSegments) do
            if index == item.last then
                detached[at].lastMachine = #f.op
            end
        end
    end
    position, operation, segment = block.term.pos, #block.op + 1, #sourceSegments
    local arguments = {}
    for index = 1, 5 do
        arguments[index] = block.term.args[index] + 1
    end
    recipes.dispatch(emit, arguments, tableValue)
    f.blockEnd[1] = #f.op

    return new sink.Result(
        machine = f,
        body = bound.body,
        pc = bound.pc,
        count = bound.count or 1,
        source = copy(g.source),
        positions = copy(g.positions),
        segments = detached,
        instructionPosition = positions,
        instructionOperation = instructions,
        instructionSegment = segments
    )
end

export = sink
