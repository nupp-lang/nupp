module nupp.compiler.s0.nativegraphtests

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local CORE = ROOT .. "/src/nupp/runtime/vm/core.nupp"
local VALUES = ROOT .. "/src/nupp/runtime/vm/values.nupp"
local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local residual = require("nupp.compiler.vm.residual")
local emitter = require("nupp.compiler.clif.graph")
require("nupp.compiler.project.projectconfig")
require("nupp.compiler.hash")
local M = {}

local function read(path: any): any
    local file = assert(io.open(path, "rb"))
    local text = file:read("*a")
    file:close()
    return text
end

local function functionsFrom(parsed: any, scope: any): any
    scope.functions, scope.exports = {}, {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local node = stat.kind == "exportStmt" and stat.stat or stat
            if node and (node.kind == "localFuncStmt" or node.kind == "funcStmt") then
                local body = node.body
                local name = node.kind == "localFuncStmt" and node.name.text or node.name.base.text
                local kinds = {}
                for index, parameter in ipairs(body.params) do
                    kinds[index] = parameter.type.resolvedType.tag
                end
                local result = body.signatureType.rets[1] and body.signatureType.rets[1].tag
                local handler = result == "uint64" and #kinds == 6
                for _, kind in ipairs(kinds) do
                    if kind ~= "voidptr" then
                        handler = false
                    end
                end
                local fn = {
                    name = name,
                    node = node,
                    body = body,
                    scope = scope,
                    paramKinds = kinds,
                    resultKind = result ~= "nil" and result or nil,
                    isHandler = handler,
                    isSupport = not handler and name:match("Slow$") ~= nil
                }
                scope.functions[name] = fn
                if stat.kind == "exportStmt" then
                    scope.exports[name] = fn
                end
            end
        end
    end

    return scope.functions
end

local function checked(source: any): (any, any)
    trivia.installDefault(provider)
    local env: any = environment.new(ROOT, {
        cache = false,
        nativeCompilerServices = false,
        config = {include = {"src"}}
    })
    local parsed: any = parser.parse(source, CORE)
    assert(#parsed.errors == 0, "core fixture did not parse")
    for _, diagnostic in ipairs((checker.check(parsed, CORE, env, {}))) do
        assert(diagnostic.severity ~= "error", diagnostic.code .. ": " .. diagnostic.msg)
    end
    local scope = {name = "nupp.runtime.vm.core", path = CORE}
    local functions = functionsFrom(parsed, scope)
    -- Reproduce the existing checked module record supplied by the native
    -- lowering, taking the constant's lexical text from the actual source.
    local values: any = parser.parse(read(VALUES), VALUES)
    assert(#values.errors == 0)
    for _, diagnostic in ipairs((checker.check(values, VALUES, env, {}))) do
        assert(diagnostic.severity ~= "error", diagnostic.code .. ": " .. diagnostic.msg)
    end
    local constants = {}
    for _, block in ipairs(values.root.blocks) do
        for _, stat in ipairs(block.stats) do
            if stat.kind == "exportStmt" and stat.stat and stat.stat.kind == "localStmt" then
                local declared = stat.stat
                if declared.isConst and #declared.names == 1 and declared.exprs[1].kind == "number" then
                    constants[declared.names[1].text] = declared.exprs[1].token.text:gsub("[Uu]?[Ll][Ll]$", "")
                end
            end
        end
    end

    return functions, {modules = {[scope.name] = scope, ["nupp.runtime.vm.values"] = {exportedConstants = constants}}}
end

local function opcode(name: any): any
    local catalog = assert(read(ROOT .. "/native/crates/vm/src/threaded.rs"):match("codes!%s*{(.-)\n}"))
    local index = 0
    for entry in catalog:gmatch("[%a_][%w_]*") do
        if entry == name then
            return index
        end
        index = index + 1
    end
    error("handler missing from canonical runtime catalog: " .. name)
end

local cached

local function fixtures(): any
    if not cached then
        local functions, options = checked(read(CORE))
        cached = {}
        for _, name in ipairs({"IK", "IMov", "IAddK", "IMaskU32", "IAdd", "ISub", "IAnd", "IOr", "Move", "FMov"}) do
            cached[name] = nativegraph.compile(functions[name], options)
        end
    end

    return cached
end

local function same(a: any, b: any): any
    if type(a) ~= "table" or type(b) ~= "table" then
        return a == b
    end
    for k, v in pairs(a) do
        if not same(v, b[k]) then
            return false
        end
    end
    for k in pairs(b) do
        if a[k] == nil then
            return false
        end
    end

    return true
end

local function rejects(message: any, fn: any): any
    local ok, problem = pcall(fn)
    assert(not ok and tostring(problem):find(message, 1, true), tostring(problem))
end

local function instruction(tag: any, a: any, b: any, c: any, hex: any): any
    local immediate = hex:gsub("..", function(pair: string): string
        return string.char(assert(tonumber(pair, 16)))
    end):reverse()
    return string.char(tag, a, b, c, 0, 0, 0, 0) .. immediate .. string.rep("\0", 16)
end

local function sequence(specification: any, firstPC: any?): (any, any)
    firstPC = firstPC or 0
    local bytes, templates = {}, {}
    for index, step in ipairs(specification) do
        local tag = opcode(step.name)
        templates[index] = residual.prepare(fixtures()[step.name], tag)
        bytes[index] = instruction(tag, step.a, step.b, step.c, step.hex):sub(1, 16)
    end
    bytes[#bytes + 1] = string.rep("\0", 16)
    local body = residual.retain(string.rep("\0", firstPC) .. table.concat(bytes), 4)
    local bound = {}
    for index, template in ipairs(templates) do
        bound[index] = residual.bind(template, body, body, firstPC + (index - 1) * 16)
    end

    return body, bound
end

local function sequenceSteps(count: any): any
    local names = {"IK", "IMov", "IAddK", "IMaskU32", "IAdd", "ISub", "IAnd", "IOr"}
    local steps = {}
    for i = 1, count do
        steps[i] = {name = names[(i - 1) % #names + 1], a = 1, b = 1, c = 2, hex = "ffffffffffffffff"}
    end

    return steps
end

local reference = require("nupp.compiler.s0.referenceclif")
local shim = require("nupp.compiler.s0.nativegraphshim")
local sink = require("nupp.compiler.s0.nativegraph")
local reader = require("s0.reader")
local ir = require("s0.ir")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")

local function exact(a: any, b: any, path: any): any
    if type(a) ~= "table" or type(b) ~= "table" then
        assert(a == b, path .. ": " .. tostring(a) .. " ~= " .. tostring(b))
        return
    end
    for key, item in pairs(a) do
        exact(item, b[key], path .. "." .. tostring(key))
    end
    for key in pairs(b) do
        assert(a[key] ~= nil, path .. ": missing " .. tostring(key))
    end
end

local function builderCases(): nil
    local signature = ir.Signature(params = {}, results = {}, convention = ir.INTERNAL)
    local old, direct = ir.new("builder", signature), ir.new("builder", signature)
    ir.instruction(old, ir.OP_ICONST, 1, ir.I64, {}, 17, 0)
    ir.instructionRange(direct, ir.OP_ICONST, 1, ir.I64, nil, nil, nil, 1, 0, 17, 0)
    ir.instruction(old, ir.OP_IADD, 2, ir.I64, {1, 1}, 0, 0)
    ir.instructionRange(direct, ir.OP_IADD, 2, ir.I64, 1, 1, nil, 1, 0, 0, 0)
    ir.instruction(old, ir.OP_RETURN_CALL_INDIRECT, 0, ir.I64, {2, 1, 2, 1, 2, 1, 2}, 0, 1)
    ir.instructionRange(direct, ir.OP_RETURN_CALL_INDIRECT, 0, ir.I64, 2, 2, {99, 1, 2, 1, 2, 1, 99}, 2, 5, 0, 1)
    exact(old, direct, "builder operands")

    local function refused(message: string, args: any, start: integer, count: integer, result: integer): nil
        rejects(message, function(): nil
            ir.instructionRange(direct, ir.OP_IADD, result, ir.I64, 1, 2, args, start, count, 0, 0)
        end)
        exact(old, direct, "builder refusal changed columns")
    end

    refused("argument range", {1}, 0, 1, 3)
    refused("argument range", {1}, 1, 2, 3)
    refused("argument range", nil, 1, 1, 3)
    local sparse: any = {1, 2, 3}
    sparse[2] = nil
    refused("argument range", sparse, 1, 3, 3)
    refused("duplicate value", {1}, 1, 1, 1)
end

-- Exercise the checked physical projection, including its range verifier,
-- before selecting the exact machine immediates in both allocation modes.
function M.projectedLiterals(): string
    local unit = require("nupp.compiler.vm.nativeunit")
    local graph = require("nupp.compiler.vm.graph")
    local specifications: any = {
        {"int32", "-2147483648", -2147483648, {"-2147483649", "2147483648"}, "native constant exceeds int32"},
        {"int32", "2147483647", 2147483647, {}, ""},
        {"int32", "-1", -1, {}, ""},
        {"uint32", "4294967295", 4294967295, {"4294967296"}, "native constant exceeds 32 bits"},
        {"uint32", "0", 0, {"-1"}, "native uint32 constant cannot be negative"}
    }
    for _, specification in ipairs(specifications) do
        local kind, text = specification[1], specification[2]
        local source = "module nupp.runtime.vm.core\n"
            .. "const native = require(\"nupp.runtime.vm.intrinsics\")\n"
            .. "local struct Narrow\n value: "
            .. kind
            .. "\nend\n"
            .. "local function read(address: uint64): uint64\n"
            .. " local p = native.pointer(address) as Narrow*\n"
            .. " @unsafe do\n if p.value == "
            .. text
            .. " then return 1ULL end\n end\n"
            .. " return 0ULL\nend\n"
        trivia.installDefault(provider)
        local env: any = environment.new(ROOT, {
            cache = false,
            nativeCompilerServices = false,
            config = {include = {"src"}}
        })
        local parsed: any = parser.parse(source, CORE)
        assert(#parsed.errors == 0, "projected literal fixture parse")
        for _, diagnostic in ipairs((checker.check(parsed, CORE, env, {}))) do
            assert(diagnostic.severity ~= "error", diagnostic.code .. ": " .. diagnostic.msg)
        end
        local scope: any = {name = "nupp.runtime.vm.core", path = CORE}
        local owner = unit.functionsFrom(parsed, scope).read
        local g = nativegraph.compile(owner, {
            abi = "leaf",
            physicalTarget = "aarch64-apple-darwin",
            modules = {[scope.name] = scope}
        })
        local count = 0
        for _, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                if op == "NativeConstant" and g.exactTypes[block.dst[at]] == kind then
                    count = count + 1
                    assert(block.args[at][1] == text, "checked projected literal text")
                    graph.verify(g)
                    local artifact = sink.compilerGraph(g, "read", owner, {})
                    local f, found = artifact.machine, false
                    for instruction, result in ipairs(f.result) do
                        if result == block.dst[at] + 1 then
                            assert(f.op[instruction] == ir.OP_ICONST and f.kind[instruction] == ir.I64)
                            assert(f.imm[instruction] == specification[3], "projected literal bits changed")
                            found = true
                        end
                    end
                    assert(found, "projected literal lost its machine definition")
                    for _, spill in ipairs({false, true}) do
                        local target = selector.target()
                        if spill then
                            target.integerRegisters, target.floatRegisters = {}, {}
                        end
                        local allocation = allocate.run(f, target)
                        assert(allocationcheck.run(f, target, allocation))
                        assert(#selector.run(f, allocation).words > 0)
                    end
                    for _, invalid in ipairs(specification[4]) do
                        block.args[at][1] = invalid
                        local ok, message = pcall(sink.compilerGraph, g, "read", owner, {})
                        block.args[at][1] = text
                        assert(not ok and tostring(message):find(specification[5], 1, true), tostring(message))
                    end
                    block.args[at][1] = text
                end
            end
        end
        assert(count == 1, "exactly one projected field comparison required")
        graph.verify(g)
    end

    return "5 checked-source literals, 10 selections, 4 range refusals"
end

function M.cases(): any
    builderCases()
    M.projectedLiterals()
    for name, source in pairs(fixtures()) do
        assert(emitter.emit(source, {name = name}) == reference.emit(source, {name = name}), "CLIF changed: " .. name)
    end
    local cases = {}
    local owner, bindings = sequence(sequenceSteps(8))
    for i, bound in ipairs(bindings) do
        cases[#cases + 1] = {bound, "handler" .. i}
    end
    for _, count in ipairs({1, 64}) do
        local _, bound = sequence(sequenceSteps(count))
        cases[#cases + 1] = {residual.stitch(bound), "stitch" .. count}
    end
    local instructions, words = 0, 0
    for _, item in ipairs(cases) do
        local bound, name = item[1], item[2]
        local direct = sink.lower(bound, name)
        local clif = emitter.emit(bound.graph, {name = name})
        assert(clif == reference.emit(bound.graph, {name = name}), "bound CLIF changed")
        local parsed = reader.read(clif)[1]
        exact(direct.machine, parsed, name)
        assert(rawequal(direct.body, bound.body), "lost body owner")
        assert(not rawequal(direct.positions, bound.graph.positions), "positions not detached")
        local last: integer = 2
        for index, segment in ipairs(direct.segments) do
            assert(segment.firstMachine == last + 1 and segment.lastMachine >= segment.firstMachine)
            for at = segment.firstMachine, segment.lastMachine do
                assert(direct.instructionSegment[at] == index)
                assert(direct.instructionOperation[at] >= segment.first)
                assert(direct.instructionOperation[at] <= segment.last)
            end
            last = segment.lastMachine
        end
        for at = last + 1, #direct.machine.op do
            assert(direct.instructionOperation[at] == #bound.graph.blocks[1].op + 1)
            assert(direct.instructionPosition[at] == bound.graph.blocks[1].term.pos)
        end
        for _, tiny in ipairs({false, true}) do
            local target = selector.target()
            if tiny then
                target.integerRegisters = {}
            end
            local allocation = allocate.run(direct.machine, target)
            assert(allocationcheck.run(direct.machine, target, allocation))
            local code = selector.run(direct.machine, allocation)
            local other = selector.run(parsed, allocate.run(parsed, target))
            exact(code, other, name .. " code")
            words = words + #code.words
        end
        instructions = instructions + #direct.machine.op
        local directory = os.getenv("NUPP_MIR_OUT")
        if directory then
            local file = assert(io.open(directory .. "/" .. name .. ".clif", "wb"))
            file:write(clif);
            file:close()
        end
    end
    local single = residual.stitch({bindings[1]})
    local expected = sink.lower(single, "private")
    single.segments[1].first = 2
    single.graph.recovery = {}
    single.graph.blocks[1].cert[1] = 1
    single.graph.blocks[1].args[1] = {"wrong"}
    single.body, single.pc, single.count = false, -16, 999
    local called = 0

    local function hook(): any
        called = called + 1
        error("result hook executed")
    end

    setmetatable(single, {__index = hook, __pairs = hook, __len = hook})
    exact(sink.lower(single, "private").machine, expected.machine, "private mutation")
    local snapshot = residual.snapshot(single)
    snapshot.graph.blocks[1].args[1] = {"wrong again"}
    snapshot.segments[1].dispatch.args[1] = -1
    exact(sink.lower(single, "private").machine, expected.machine, "snapshot mutation")
    for _, forged in ipairs({
        snapshot,
        {graph = fixtures().IK, body = owner, pc = 0},
        setmetatable({}, {
            __index = hook,
            __pairs = hook
        })
    }) do
        rejects("unknown residual result", function(): nil
            sink.lower(forged, "forged")
        end)
    end
    assert(called == 0)
    -- Unsupported canonical metadata still refuses after private admission.
    local source = fixtures().IK
    source.recovery = {}
    local template = residual.prepare(source, opcode("IK"))
    local body = residual.retain(instruction(opcode("IK"), 0, 1, 2, "0000000000000000"), 4)
    local recovery = residual.bind(template, body, body, 0)
    rejects("recovery metadata", function(): nil
        sink.lower(recovery, "recovery")
    end)
    rejects("recovery metadata", function(): nil
        residual.stitch({recovery})
    end)

    return "direct MIR: " .. #cases .. " cases, " .. instructions .. " instructions, " .. words .. " selected words"
end

function M.native(directory: string, digest: string): string
    local label, steps = "", {}
    local emitted = 0

    local function flush(): nil
        if label == "" then
            return
        end
        local owner, bound = sequence(steps)
        local joined = residual.stitch(bound)
        local artifact = sink.lower(joined, label)
        assert(rawequal(owner, artifact.body))
        local text = emitter.emit(joined.graph, {name = label})
        assert(text == reference.emit(joined.graph, {name = label}))
        exact(artifact.machine, reader.read(text)[1], label)
        for _, mode in ipairs({"normal", "spill"}) do
            local target = selector.target()
            if mode == "spill" then
                target.integerRegisters = {}
            end
            local allocation = allocate.run(artifact.machine, target)
            assert(allocationcheck.run(artifact.machine, target, allocation))
            local code = selector.run(artifact.machine, allocation)
            shim.write(code, #steps, directory .. "/" .. label .. "/" .. mode, digest)
            emitted = emitted + 1
        end
        -- Serialized test artifact retains the exact bound body bytes after the
        -- compiler process exits; it is not a production loader capability.
        local file = assert(io.open(directory .. "/" .. label .. "/body.bin", "wb"))
        for _, step in ipairs(steps) do
            file:write(instruction(opcode(step.name), step.a, step.b, step.c, step.hex):sub(1, 16))
        end
        file:write(string.rep("\0", 16));
        file:close()
    end

    for line in read(directory .. "/cases.tsv"):gmatch("[^\n]+") do
        local name, operation, a, b, c, hex = line:match("^(%S+) (%S+) (%d+) (%d+) (%d+) (%x+)$")
        assert(name, line)
        if name ~= label then
            flush();
            label, steps = name, {}
        end
        steps[#steps + 1] = {name = operation, a = tonumber(a), b = tonumber(b), c = tonumber(c), hex = hex}
    end
    flush()

    return tostring(emitted) .. " native bundles"
end

export = M
