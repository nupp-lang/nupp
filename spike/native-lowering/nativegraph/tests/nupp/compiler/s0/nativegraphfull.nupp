module nupp.compiler.s0.nativegraphfull

local lower = require("nupp.compiler.clif.lower")
local emitter = require("nupp.compiler.clif.graph")
local reference = require("nupp.compiler.s0.referenceclif")
local environment = require("nupp.compiler.project.env")
require("nupp.compiler.project.projectconfig")
require("nupp.compiler.hash")

export function run(root: string, layouts: string, output: string): string
    -- Keep the graph/compiler path unchanged; this test image uses the portable
    -- filesystem transport rather than requiring the CLI's native services.
    local env: any = environment
    local originalNew = env.new
    env.new = function(path: any, options: any): any
        options.nativeCompilerServices = false
        return originalNew(path, options)
    end
    local module: any = emitter
    local original = module.emit
    local calls: integer = 0
    module.emit = function(g: any, options: any): string
        local actual = original(g, options)
        assert(actual == reference.emit(g, options), "core graph CLIF changed: " .. options.name)
        calls = calls + 1
        return actual
    end
    local actual = lower.compileRuntime(root, layouts)
    module.emit = reference.emit
    local baseline = lower.compileRuntime(root, layouts)
    module.emit, env.new = original, originalNew
    assert(actual == baseline, "whole runtime CLIF changed")
    local currentFile = assert(io.open(output .. "/current.clif", "wb"))
    currentFile:write(actual);
    currentFile:close()
    local baselineFile = assert(io.open(output .. "/baseline.clif", "wb"))
    baselineFile:write(baseline);
    baselineFile:close()

    return tostring(calls) .. " graph functions, whole-runtime CLIF byte-identical"
end

export function counters(root: string, layouts: string, output: string, mode: string): string
    assert(mode == "baseline" or mode == "current")
    local env: any = environment
    local originalNew = env.new
    env.new = function(path: any, options: any): any
        options.nativeCompilerServices = false
        return originalNew(path, options)
    end
    local module: any = emitter
    local original = module.emit
    module.emit = mode == "baseline" and reference.emit or original
    local text = lower.compileRuntime(root, layouts)
    module.emit, env.new = original, originalNew
    local file = assert(io.open(output, "wb"))
    file:write(text);
    file:close()

    return tostring(#text)
end
