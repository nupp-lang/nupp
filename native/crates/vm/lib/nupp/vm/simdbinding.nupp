module nupp.vm.simdbinding

local loaded: any = package.loaded
local binding: any = loaded["nupp.simd"]

-- The accepting image exposes both public casings through the same frozen handles.
for _, namespace in ipairs({binding.horizontal, binding.reducer}) do
    local aliases: {[string]: any} = {}
    for name, value in pairs(namespace) do
        if type(name) == "string" and type(value) == "function" then
            aliases[name:lower()] = value
        end
    end
    for name, value in pairs(aliases) do
        namespace[name] = value
    end
end

export = binding
