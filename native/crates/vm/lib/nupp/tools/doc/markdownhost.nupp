@!internal
module nupp.tools.doc.markdownhost

--[[
The VM's Markdown renderer for `nupp doc`: `pulldown-cmark`, which the runtime
installs as `nupp.vm.markdown`. The checkout's own copy of this module answers
that no renderer is available; this one replaces it on the VM.
]]

const markdown = require("nupp.vm.markdown")

local type Host = {render: function(text: string): (string?, string?)}

local host: Host = {
    render = function(text: string): (string?, string?)
        return markdown.render(text)
    end,
}

export = host
