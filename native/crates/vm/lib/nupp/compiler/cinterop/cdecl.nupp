module nupp.compiler.cinterop.cdecl

local cdecl = require("nupp.compiler.cinterop.model")
local json = require("nupp.codec.json")
local native = require("nupp.compiler.nativecdecl")

local function request(operation: string, text: string?, id: integer?): any, string?
    local response = json.decode(native.request(json.encode({operation = operation, text = text, id = id}))) as any
    if not response.ok then
        return nil, response.error
    end

    return response.value
end

function cdecl.declare(text: string): boolean, string?, {[string]: boolean}?
    local names, problem = request("declare", text)
    return names ~= nil, problem, names
end

function cdecl.typeFromString(spec: string): cdecl.CType?, string?
    return request("type", spec)
end

function cdecl.structById(id: integer?): cdecl.Struct?
    if not id then
        return nil
    end
    local declaration = request("struct", nil, id)

    return declaration
end

function cdecl.declaredFunctions(only: {[string]: boolean}?): {[string]: cdecl.Function}
    local all, problem = request("functions")
    assert(all, problem)
    local selected = {}
    for name, value in pairs(all) do
        if not only or only[name] then
            selected[name] = value
        end
    end

    return selected
end

function cdecl.sizeof(spec: string): integer?
    local value = cdecl.typeFromString(spec)
    return value and value.size
end

function cdecl.layout(kind: string, body: string): cdecl.Layout?, string?
    local value, problem = cdecl.typeFromString(kind .. " { " .. body .. " }")
    if not value then
        return nil, problem
    end
    local declaration = cdecl.structById(value.id)

    return declaration and {size = declaration.size, align = declaration.align, fields = declaration.fields}, nil
end

function cdecl.float32(value: number): number
    return assert(request("float32", string.format("%.17g", value)))
end

function cdecl.abiTag(): string
    return assert(request("abi"))
end

function cdecl.inspect(text: string | {string}, prelude: (string | {string})?): cdecl.Inspection?, string?
    return request("inspect", json.encode({text = text, prelude = prelude}))
end

export = cdecl
