module nupp.mem.heap

--[[
Owned contiguous arrays of one storage element type.

The returned array is affine and is released at scope exit. Its
logical element count moves with the allocation and its pointer is available
only through checked span views.

```nupp
local heap = nupp.mem.heap

do
    local values = heap.allocate(ffi.typeof<int32>(), 4)
    local writable = values:write()
    writable[1] = 42 as int32
    nupp.drop(writable)
    local readable = values:read()
    print(readable[1], #readable)
end -- released here
```

The array is managed storage, so it takes part in collection and snapshots, and
releasing it drops the owner's reference rather than freeing the bytes under a
view. An array handed to a worker moves: the worker adopts the allocation
itself, with no copy, and a view the sender still held reports that the storage
moved. Reading and writing are the operations [](nupp.mem.span) defines, and a
live reader and a live writer over one array report `NUPP2607`.

::: tip Nonescaping views at -O1
A nonescaping `read` or `write` can remain virtual, so no span wrapper is
allocated. An escape or an opaque call materializes the same checked span.
:::

See [c-interop.md](docs/learn/runtime/c-interop/index.md#c-arrays) for how this sits beside
`carray`, and [ownership.md](docs/learn/runtime/ownership/borrowing.md) for the borrow rules
the views are written against.
]]

local heap = {}
local span = require("nupp.mem.span")
local storage: any = assert(
    require("nupp.mem.representation").storage,
    "nupp.mem.heap: no storage implementation is available for the target"
)

local function finish_array(takes self: any): nil
    @nosuspend do
        local raw = @unsafe nupp.release(self)
        -- The husk outlives the release wherever a dynamic reference still sees
        -- it, and a nil pointer is what marks the allocation gone.
        raw.pointer = nil
    end
end

local finish_array_nosuspend = finish_array as @nosuspend function(takes self: any): nil

sealed interface heap.ArrayToken
    close: @nosuspend function(takes self: ArrayToken): nil
end

--- Releases an allocation, which is what every heap array's contract names.
---
--- Nothing calls this by hand. It is the terminal consumer `affine` carries, so a
--- scope boundary or an explicit `nupp.drop` reaches it.
---
--- @param self the array, spent by this call
--- @export
function heap.destroyArray<T is heap.ArrayToken>(takes self: T): nil
    self:close()
end

--- An owned contiguous allocation whose logical count cannot be separated from
--- its storage in checked code.
--- @export
record heap.Array<T> is heap.ArrayToken
    @private pointer: T[?]

    --- How many elements the allocation holds.
    @readonly count: integer

    --- Releases the allocation. `nupp.drop` and scope exit both reach this.
    close: @nosuspend function(takes self: Array<T>): nil

    --- Borrows the whole allocation as a shared checked span.
    ---
    --- The borrow lasts as long as the span does, so a writer cannot be taken out
    --- while one is live.
    read: function(borrows self: Array<T>): span.Span<T> borrows (self)

    --- Borrows the whole allocation as an affine checked write span.
    ---
    --- Exclusive for as long as the writer is live, so `read` reports `NUPP2607`
    --- until the writer is dropped.
    write: function(exclusive self: Array<T>): span.Writable<T> borrows (self)
end

function heap.Array.read<T>(borrows self: heap.Array<T>): span.Span<T> borrows (self)
    return span.fromCarray(self.pointer, self.count)
end

function heap.Array.close<T>(takes self: heap.Array<T>): nil
    finish_array_nosuspend(self)
end

function heap.Array.write<T>(exclusive self: heap.Array<T>): span.Writable<T> borrows (self)
    return span.writeCarray(self.pointer, self.count)
end

--- Allocates `count` contiguous values of `element`.
---
--- The result owns the allocation and releases it at its lexical boundary. The
--- bytes start zeroed.
---
--- ```nupp:fragment
--- do
---     local values = heap.allocate(ffi.typeof<int32>(), 1000000)
---     print(values.count)
--- end
--- ```
---
--- @param element the ctype of an element
--- @param count how many elements to allocate
--- @return the array, owned by the caller
--- @export
--- @raises string when count is invalid or the byte size overflows
function heap.allocate<T>(element: ctype<T>, count: integer): affine(heap.Array<T>, heap.destroyArray)
    if count < 0 or count ~= math.floor(count) then
        error("nupp: heap array count must be a nonnegative integer", 2)
    end

    local width = storage.sizeOf(element) as integer
    if width <= 0 or (count > 0 and count > 9007199254740991 // width) then
        error("nupp: heap array byte size is too large", 2)
    end

    @unsafe do
        local pointer = storage.allocateArray(element, count) as T[?]
        local array = new heap.Array(pointer = pointer, count = count) as heap.Array<T>
        return array
    end
end

export = heap
