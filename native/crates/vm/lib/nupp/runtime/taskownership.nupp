@!internal
module nupp.runtime.taskownership

local core = require("nupp.vm.tasks")
local taskownership = {}

function taskownership.release(body: any): nil
    if type(body) == "table" and type(body.__nuppRelease) == "function" then
        body.__nuppRelease()
    else
        core.release(body)
    end
end

export = taskownership
