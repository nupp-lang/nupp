@!internal

module nupp.runtime.provider.nativegpu

--[[
The VM's [](nupp.gpu) provider: no device yet.

LuaJIT's provider drives the `nuppNativeGpu*` C entry points the LuaJIT host
library links, through `ffi` out-parameters and casts over `gpu.Buffer` values.
The VM links no GPU facility, and the runtime plan's "GPU compute on the VM"
replaces that buffer API with storage residency and dispatch as a host
request rather than porting it, so this provider reports no device: `available`
is false and `open` refuses by name. A CPU-only program records no GPU costs.
]]

local api = require("nupp.gpu.api")

local provider = {}

function provider.available(): boolean
    return false
end

function provider.open(): api.KernelContext
    error("nupp: GPU compute is not available on the VM runtime yet", 2)
end

--- Writes the empty cost record a program that ran no GPU operation leaves.
function provider.costsOutput(path: string?): nil
    if path ~= nil then
        local file = assert(io.open(path, "wb"))
        file:close()
    end
end

export = provider
