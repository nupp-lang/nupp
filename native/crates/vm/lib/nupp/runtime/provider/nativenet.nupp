@!internal

module nupp.runtime.provider.nativenet

--[[
The VM's native network provider for [](nupp.io.net): the same receiver-based
protocol as the LuaJIT provider, written over the VM's `nupp.vm.net`
primitives rather than the native library's C ABI. Handles are the primitives'
numbers, and [](nupp.runtime.provider.nativetls) wraps the same streams.

Operations report readiness without running a private loop. `run(0)` takes a
snapshot of the readiness generation every native family shares, and a later
`run(waitMs)` sleeps from it, so a change between the facade's check and its
sleep still wakes it.
]]

local contract = require("nupp.io.net.spi")
local shared = require("nupp.io.net.types")
const host = require("nupp.vm.net")

local function reason(prefix: string, problem: string?): string
    return prefix .. ": " .. (problem or "unknown error")
end

local provider: contract.Provider = {
    listen = function(
        self: contract.Provider,
        address: string,
        port: integer,
        backlog: integer,
        reusePort: boolean
    ): (any?, string?)
        local handle, problem = host.listen(address, port, backlog, reusePort)
        if handle == nil then
            return nil, reason("nupp: could not listen", problem)
        end

        return handle
    end,

    listenPath = function(self: contract.Provider, path: string, backlog: integer): (any?, string?)
        local handle, problem = host.listenPath(path, backlog)
        if handle == nil then
            return nil, reason("nupp: could not listen", problem)
        end

        return handle
    end,

    listenerPort = function(self: contract.Provider, listener: any): integer
        return host.listenerPort(listener as integer)
    end,

    accept = function(self: contract.Provider, listener: any): (any?, string?)
        local handle, problem = host.accept(listener as integer)
        if problem ~= nil then
            return nil, reason("nupp: could not accept", problem)
        end

        return handle
    end,

    closeListener = function(self: contract.Provider, listener: any): nil
        host.closeListener(listener as integer)
    end,

    connect = function(self: contract.Provider, address: string, port: integer, timeoutMs: integer): (any?, string?)
        local handle, problem = host.connect(address, port, timeoutMs)
        if handle == nil then
            return nil, reason("nupp: could not connect", problem)
        end

        return handle
    end,

    connectPath = function(self: contract.Provider, path: string, timeoutMs: integer): (any?, string?)
        local handle, problem = host.connectPath(path, timeoutMs)
        if handle == nil then
            return nil, reason("nupp: could not connect", problem)
        end

        return handle
    end,

    connectPoll = function(self: contract.Provider, request: any): (any?, string?)
        local handle, problem = host.connectPoll(request as integer)
        if problem ~= nil then
            return nil, reason("nupp: could not connect", problem)
        end

        return handle
    end,

    closeConnect = function(self: contract.Provider, request: any): nil
        host.closeConnect(request as integer)
    end,

    read = function(self: contract.Provider, stream: any, wanted: integer): (string?, string?)
        local bytes, problem = host.read(stream as integer, wanted)
        if bytes == nil then
            return nil, reason("nupp: could not read", problem)
        end

        return bytes
    end,

    ended = function(self: contract.Provider, stream: any): boolean
        return host.ended(stream as integer)
    end,

    write = function(self: contract.Provider, stream: any, bytes: string): (integer?, string?)
        local count, problem = host.write(stream as integer, bytes)
        if count == nil then
            return nil, reason("nupp: could not write", problem)
        end

        return count
    end,

    pending = function(self: contract.Provider, stream: any): integer
        return host.pending(stream as integer)
    end,

    writeFailed = function(self: contract.Provider, stream: any): boolean
        return host.writeFailed(stream as integer)
    end,

    shuttingDown = function(self: contract.Provider, stream: any): boolean
        return host.shuttingDown(stream as integer)
    end,

    shutdownWrite = function(self: contract.Provider, stream: any): (boolean, string?)
        local done, problem = host.shutdownWrite(stream as integer)
        if not done then
            return false, reason("nupp: could not end the sending half", problem)
        end

        return true
    end,

    address = function(self: contract.Provider, stream: any, peer: boolean): shared.Address?
        const address, port = host.address(stream as integer, peer)
        if address == nil or port == nil then
            return nil
        end

        return {host = address, port = port} as shared.Address
    end,

    noDelay = function(self: contract.Provider, stream: any, enable: boolean): (boolean, string?)
        local done, problem = host.noDelay(stream as integer, enable)
        if not done then
            return false, reason("nupp: could not set the delay option", problem)
        end

        return true
    end,

    keepAlive = function(self: contract.Provider, stream: any, enable: boolean, delayMs: integer): (boolean, string?)
        local done, problem = host.keepAlive(stream as integer, enable, delayMs)
        if not done then
            return false, reason("nupp: could not set the keepalive option", problem)
        end

        return true
    end,

    broadcast = function(self: contract.Provider, socket: any, enable: boolean): (boolean, string?)
        local done, problem = host.broadcast(socket as integer, enable)
        if not done then
            return false, reason("nupp: could not set the broadcast option", problem)
        end

        return true
    end,

    multicastTtl = function(self: contract.Provider, socket: any, ttl: integer): (boolean, string?)
        local done, problem = host.multicastTtl(socket as integer, ttl)
        if not done then
            return false, reason("nupp: could not set the multicast hop limit", problem)
        end

        return true
    end,

    multicastLoop = function(self: contract.Provider, socket: any, enable: boolean): (boolean, string?)
        local done, problem = host.multicastLoop(socket as integer, enable)
        if not done then
            return false, reason("nupp: could not set the multicast loop option", problem)
        end

        return true
    end,

    membership = function(
        self: contract.Provider,
        socket: any,
        group: string,
        interfaceAddress: string,
        join: boolean
    ): (boolean, string?)
        local done, problem = host.membership(socket as integer, group, interfaceAddress, join)
        if not done then
            return false, reason("nupp: could not change the multicast group", problem)
        end

        return true
    end,

    closeStream = function(self: contract.Provider, stream: any): nil
        host.closeStream(stream as integer)
    end,

    bindDatagram = function(
        self: contract.Provider,
        address: string,
        port: integer,
        reusePort: boolean
    ): (any?, string?)
        local handle, problem = host.bindDatagram(address, port, reusePort)
        if handle == nil then
            return nil, reason("nupp: could not bind", problem)
        end

        return handle
    end,

    datagramPort = function(self: contract.Provider, socket: any): integer
        return host.datagramPort(socket as integer)
    end,

    receive = function(
        self: contract.Provider,
        socket: any,
        maximum: integer
    ): (string?, string?, integer?, boolean?, string?)
        local bytes, address, port, truncated, problem = host.receive(socket as integer, maximum)
        if problem ~= nil then
            return nil, nil, nil, nil, reason("nupp: could not receive", problem)
        end

        return bytes, address, port, truncated
    end,

    sendTo = function(
        self: contract.Provider,
        socket: any,
        address: string,
        port: integer,
        bytes: string
    ): (boolean, string?)
        return host.sendTo(socket as integer, address, port, bytes)
    end,

    closeDatagram = function(self: contract.Provider, socket: any): nil
        host.closeDatagram(socket as integer)
    end,

    run = function(self: contract.Provider, timeoutMs: integer): nil
        -- A zero timeout is the check's half: the snapshot a later sleep waits
        -- from. Any native family's change since then ends the sleep, so a
        -- program waiting on a socket and a transfer at once wakes for either.
        if timeoutMs == 0 then
            host.snapshot()

            return
        end
        host.sleep(timeoutMs)
    end,
}

export = provider
