@!internal

module nupp.runtime.provider.nativehost

--[[
The VM's answer to [](nupp.host) requests: none yet.

LuaJIT's provider reaches the C handlers an embedding application registers
through `nupp_host_register` in the LuaJIT embedding, which the VM does not
carry. The VM's own embedding (an application that loads an image and answers
host kinds) is the runtime plan's "Rust embedding and native extensions" item
and has no host channel today. A program on the VM is therefore run by nothing
that answers requests, as a program `nupp run` starts under LuaJIT is: every
request and route is refused by name, and `attached` says so up front.
]]

local provider = {}

local function refuse(kind: string): nil
    error("nupp: no host answers " .. kind .. "; no embedding application is attached", 0)
end

function provider.attached(): boolean
    return false
end

function provider.call(kind: string, _: any, ...: any): ...any
    refuse(kind)
end

function provider.post(kind: string, ...: any): nil
    refuse(kind)
end

function provider.send(kind: string, _: string, _: integer, ...: any): nil
    refuse(kind)
end

function provider.route(kind: string, _: string, _: integer, _: any): (any, any)
    error("nupp: no host pushes " .. kind .. "; no embedding application is attached", 0)
end

export = provider
