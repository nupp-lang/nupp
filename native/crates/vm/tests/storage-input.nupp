module nupp.tests.vmstorage

const assert2 = require("assert")

local provider: any = require("nupp.vm.storagebinding")
local contract = require("nupp.tests.providers.cstorage")
local persist = require("nupp.vm.persist")
local storage = {}
local held: any = nil

function storage.run(): number
    local ok, problem = contract.test(provider)
    assert2(ok, problem)
    if held ~= nil then
        assert2(held.view[0] == 18446744073709551615ULL)
        held.view[0] = 9007199254740993ULL
        assert2(held.owner[1] == 9007199254740993ULL)
    end

    local kind = provider.scalar("uint64")
    assert2(rawequal(kind, provider.scalar("uint64")))
    local words = provider.allocarray(kind, 3)
    words[0] = 9007199254740993ULL
    words[1] = 18446744073709551615ULL
    words[2] = 0x8000000000000005ULL
    local shifted: any = words + 1
    assert2(shifted[0] == words[1] and shifted - words == 1)
    assert2(provider.sizeof(words) == 24)
    assert2(provider.sizeof(provider.descriptor(words)) == 24)
    assert2(provider.boundedcount(shifted, 2) == 2)
    local bytes = provider.castbytes(words)
    assert2(provider.string(bytes, 8) == provider.encodeuint64(words[0]))
    assert2(
        not pcall(function()
            bytes[0] = 1
        end)
    )
    assert2(not pcall(provider.boundedcount, shifted, 3))
    assert2(
        not pcall(function()
            return words[3]
        end)
    )
    assert2(
        not pcall(function()
            words[-1] = 2
        end)
    )
    assert2(not pcall(provider.allocarray, kind, 2147483647))
    assert2(not pcall(provider.allocbytes, math.huge))
    assert2(not pcall(provider.allocbytes, 0.5))
    assert2(not pcall(provider.decodeuint64, "short"))
    local signed = provider.allocarray(provider.scalar("int64"), 1)
    signed[0] = -9223372036854775807LL
    assert2(signed[0] == -9223372036854775807LL)
    local narrow = provider.allocarray(provider.scalar("int8"), 2)
    narrow[0] = 255
    assert2(narrow[0] == -1)
    local floats = provider.allocarray(provider.scalar("float"), 2)
    floats[0] = 1.5
    assert2(floats[0] == 1.5)
    floats[1] = -0.0
    assert2(1 / floats[1] == -math.huge)

    local shared = {owner = words, view = shifted}
    local restored = persist.load(persist.save(shared))
    assert2(restored.view[0] == words[1])
    restored.view[0] = 13ULL
    assert2(restored.owner[1] == 13ULL and words[1] == 18446744073709551615ULL)
    held = shared

    local array = require("nupp.array")
    do
        const owned = array.bytes(4)
        const writable = owned:write()
        writable[1] = 255
        writable[4] = 42
        own.drop(writable)
        const readable = owned:read()
        assert2(#readable == 4 and readable[1] == 255 and readable[4] == 42)
        const tail = readable:slice(2, 4)
        assert2(#tail == 3 and tail[3] == 42)
        assert2(
            not pcall(function()
                return readable[0]
            end)
        )
        assert2(
            not pcall(function()
                return tail[4]
            end)
        )
    end
    do
        const owned = array.scalar(array.uint64, 2)
        const writable = owned:write()
        writable[1] = 9007199254740993ULL
        writable[2] = 18446744073709551615ULL
        own.drop(writable)
        const readable = owned:read()
        assert2(#readable == 2)
        assert2(readable[1] == 9007199254740993ULL)
        assert2(readable[2] == 18446744073709551615ULL)
    end

    return 42
end

export = storage
