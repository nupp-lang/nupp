--- Interface-heavy typed code: records behind an interface, methods called
--- through it, fields read through a structural view, and callbacks typed as
--- functions. The static types name the interface; which record arrives at a
--- site is what only the run knows. `main` answers a checksum string;
--- `bench` answers the time per phase.
local M = {}

local interface Shape
    name: string

    area: function(self): number
    grow: function(self, k: number): nil
end

local record Circle is Shape
    name: string
    r: number

    function area(self): number
        return 3 * self.r * self.r
    end

    function grow(self, k: number): nil
        self.r = self.r + k
    end
end

local record Rect is Shape
    name: string
    w: number
    h: number

    function area(self): number
        return self.w * self.h
    end

    function grow(self, k: number): nil
        self.w = self.w + k
    end
end

local record Square is Shape
    name: string
    side: number

    function area(self): number
        return self.side * self.side
    end

    function grow(self, k: number): nil
        self.side = self.side + k
    end
end

local function makeShape(i: number, kinds: number): Shape
    local k = i % kinds
    if k == 0 then
        return new Circle(name = "circle", r = i % 5)
    elseif k == 1 then
        return new Rect(name = "rect", w = i % 7, h = 2)
    end

    return new Square(name = "square", side = i % 3)
end

local function total(shapes: {Shape}): number
    local sum = 0
    for i = 1, #shapes do
        sum = sum + shapes[i]:area()
    end

    return sum
end

local function sweep(shapes: {Shape}, rounds: number): number
    local sum = 0
    for round = 1, rounds do
        sum = sum + total(shapes)
        if round % 64 == 0 then
            for i = 1, #shapes do
                shapes[i]:grow(1)
                shapes[i]:grow(-1)
            end
        end
    end

    return sum
end

local function names(shapes: {Shape}, rounds: number): number
    local n = 0
    for _ = 1, rounds do
        for i = 1, #shapes do
            n = n + #shapes[i].name
        end
    end

    return n
end

local function reduce(values: {number}, f: function(number, number): number, start: number): number
    local acc = start
    for i = 1, #values do
        acc = f(acc, values[i])
    end

    return acc
end

local function folds(rounds: number): number
    local values: {number} = {}
    for i = 1, 32 do
        values[i] = i
    end
    local sum = 0
    for _ = 1, rounds do
        sum = sum + reduce(
            values,
            function(a: number, b: number): number
                return a + b
            end,
            0
        )
    end

    return sum
end

local function build(n: integer, kinds: number): {Shape}
    local shapes: {Shape} = {}
    for i = 1, n do
        shapes[i] = makeShape(i, kinds)
    end

    return shapes
end

local function phases(scale: number): {{any}}
    return {
        {
            "monomorphic",
            function(): number
                return sweep(build(32, 1), 2000 * scale)
            end
        },
        {
            "polymorphic",
            function(): number
                return sweep(build(32, 3), 2000 * scale)
            end
        },
        {
            "fields",
            function(): number
                return names(build(32, 3), 2000 * scale)
            end
        },
        {
            "callbacks",
            function(): number
                return folds(4000 * scale)
            end
        },
    }
end

function M.main(): string
    local out: {string} = {}
    for _, p in ipairs(phases(1)) do
        local run: function(): number = p[2]
        out[#out + 1] = p[1] .. "=" .. tostring(run())
    end

    return table.concat(out, " ")
end

function M.bench(): string
    local out: {string} = {}
    local all = 0
    for _, p in ipairs(phases(20)) do
        local run: function(): number = p[2]
        local t0 = os.clock()
        local r = run()
        local ms = (os.clock() - t0) * 1000
        all = all + ms
        out[#out + 1] = string.format("%s %.1f ms (%s)", p[1], ms, tostring(r))
    end
    out[#out + 1] = string.format("total %.1f ms", all)

    return table.concat(out, "\n")
end

return M
