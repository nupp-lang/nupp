module memory.main

const assert2 = require("assert")

const tasks = require("coroutine")

-- Typed packed and columnar arrays, shared byte regions, the logging clock,
-- and detached host and GPU providers run on the VM.

const Array = table.Array
local span = require("binary.span")
const sharedbytes = io.SharedBytes
local log = require("debug.log")
local host = require("os.host")
local gpu = require("io.gpu")

local test = {}

local struct Vector
    x: float64
    y: float64
end

local struct Body
    position: Vector
    mass: float
    id: int32
    flags: uint8
end

local function raises(fn: function(): nil, text: string): nil
    local ok, problem = pcall(fn)
    assert2(not ok, "expected a failure mentioning " .. text)
    assert2(tostring(problem):find(text, 1, true), tostring(problem))
end

local function heapArrays(): nil
    do
        local values = Array.alloc(ffi.typeof<int32>(), 4)
        assert2(values.count == 4)
        do
            local writable = values:write();
            for index = 1, #writable do
                writable[index] = (index * 10) as int32
            end
        end
        local readable = values:read()
        assert2(#readable == 4 and readable[1] == 10 and readable[4] == 40)
        local total = 0
        for index = 1, #readable do
            total = total + readable[index]
        end
        assert2(total == 100)
    end
    do
        local wide = Array.alloc(ffi.typeof<float64>(), 3)
        do
            local writable = wide:write();
            writable[2] = 2.5
        end
        assert2(wide:read()[1] == 0 and wide:read()[2] == 2.5)
        local empty = Array.alloc(ffi.typeof<uint8>(), 0)
        assert2(empty.count == 0 and #empty:read() == 0)
    end
    raises(
        function(): nil
            local _broken = Array.alloc(ffi.typeof<int32>(), -1)
        end,
        "nonnegative integer"
    )
end

local function rowAt(borrows rows: span.Span<Body, "columnar">, index: integer): Body
    return rows[index]
end

local function copyPast(
    exclusive rows: span.WriteSpan<Body, "columnar">,
    borrows source: span.Span<Body, "columnar">
): nil
    rows:copyfrom(2, source, 1, 2)
end

local function soaSlabs(): nil
    local ordinary = types.layoutof(Body)
    assert2(ordinary.size == 32 and ordinary.alignment == 8)
    assert2(ordinary.fields[2].name == "mass" and ordinary.fields[2].offset == 16)
    local layout = Array.layoutof(ffi.typeof<Body>())
    assert2(layout.name == "Body" and #layout.fields == 4)
    assert2(layout.fields[1].name == "position" and layout.fields[1].elementsize == 16)
    assert2(layout.fields[2].ctype == "float" and layout.fields[2].elementsize == 4)
    assert2(layout.fields[4].ctype == "uint8_t" and layout.fields[4].alignment == 1)
    assert2(layout.alignment == 8)
    assert2(layout.fingerprint:find("Body.mass:float@4/4", 1, true), layout.fingerprint)
    local instance = layout:forcount(3)
    assert2(instance.segments[1].offset == 0 and instance.segments[2].offset == 48)
    assert2(instance.segments[3].offset == 60 and instance.segments[4].offset == 72)
    assert2(instance.bytesize == 75)

    local bodies = Array.alloc(ffi.typeof<Body>(), 4, "columnar")
    assert2(bodies.count == 4 and bodies.fingerprint == layout.fingerprint)
    do
        local rows = bodies:write();
        assert2(#rows == 4)
        for index = 1, #rows do
            rows[index].mass = index * 1.5
            rows[index].id = (index * 100) as int32
            rows[index].position.x = index
        end
        rows[2].mass += 10
        rows[3] = Body(Vector(7, 8), 0.5, 9, 3)
        do
            local masses = rows.mass;
            assert2(#masses == 4 and masses[2] == 13)
            masses[4] = 64
        end
        do
            local tail = rows:slice(3, 4);
            assert2(#tail == 2 and tail[1].id == 9 and tail[2].mass == 64)
            tail[2].flags = 5
        end
        assert2(rows[4].flags == 5)
    end
    local outside, problem = pcall(rowAt, bodies:read(), 5)
    assert2(not outside and tostring(problem):find("SoA row index out of bounds", 1, true), tostring(problem))
    local readable = bodies:read()
    local third = readable[3]
    assert2(third.position.x == 7 and third.position.y == 8 and third.id == 9 and third.flags == 3)
    assert2(readable[1].position.x == 1 and readable[2].mass == 13)
    local ids = readable.id
    assert2(#ids == 4 and ids[1] == 100 and ids[4] == 400)

    local copies = Array.alloc(ffi.typeof<Body>(), 2, "columnar")
    do
        local rows = copies:write();
        rows:copyfrom(1, bodies:read(), 3, 2)
    end
    do
        local rows = copies:write();
        local copiedPast, why = pcall(copyPast, rows, bodies:read())
        assert2(not copiedPast and tostring(why):find("SoA copy range is out of bounds", 1, true), tostring(why))
    end
    local copied = copies:read()
    assert2(copied[1].id == 9 and copied[1].position.y == 8 and copied[2].mass == 64)
end

local function sharedRegions(): nil
    local region = sharedbytes.copy("hello, region")
    assert2(region:len() == 13)
    local hello = region:slice(0, 5)
    assert2(hello:len() == 5 and hello:tostring() == "hello")
    local bytes = region:view(7)
    assert2(#bytes == 6 and bytes[1] == string.byte("r"))
    assert2(region == region:slice(0, 13) and region ~= sharedbytes.copy("hello, region"))
    assert2(sharedbytes.copy("") ~= sharedbytes.copy(""))
    raises(
        function(): nil
            region:slice(10, 4)
        end,
        "out of bounds"
    )

    local builder = io.Buffer.create()
    do
        local lease = builder:reserve(5)
        do
            local writer = lease:span();
            for index = 1, 5 do
                writer[index] = 64 + index
            end
        end
        lease:commit(5)
    end
    builder:put("!")
    builder:put(string.rep("z", 100))
    local frozen = builder:freeze()
    assert2(frozen:len() == 106 and frozen:slice(0, 6):tostring() == "ABCDE!")
    assert2(frozen:view(5, 2)[1] == string.byte("!"))

    local words = sharedbytes.copy(string.rep("\0", 28)):slice(4, 24)
    local triples = words:viewas(ffi.typeof<int32>())
    assert2(#triples == 6 and triples[1] == 0)
    raises(
        function(): nil
            local misaligned = words:slice(1, 8)
            misaligned:viewas(ffi.typeof<int32>())
        end,
        "not suitably aligned"
    )

    local missing, why = sharedbytes.readfile("definitely/not/here.bin")
    assert2(missing == nil and why ~= nil)
end

local function logging(): nil
    local lines: {string} = {}
    local previous = log.setsink(
        log.callback(function(_: any, module: string, _: integer, message: string): nil
            lines[#lines + 1] = module .. ": " .. message
        end)
    )
    log.setlevel("info")
    log.named("memory"):info("%d rows", 4)
    log.named("memory"):debug("hidden")
    assert2(#lines == 1 and lines[1] == "memory: 4 rows", lines[1])
    assert2(log.timestamp():match("^%d%d%d%d%-%d%d%-%d%d %d%d:%d%d:%d%d $"), log.timestamp())
    local installed = log.setsink(previous)
    own.drop(installed)
end

-- The storage provider's private view of where an allocation lives: a shared
-- block has one address in every VM holding it, and a moved allocation keeps
-- its address in the VM it moved to.
local representation: any = require("binary._representation").storage

local function regionAddress(region: io.SharedBytes): number
    return representation.address(((region as any)._handle as any).data) as number
end

local function arrayAddress(borrows values: table.Array<int32>): number
    @unsafe do
        return representation.address((values as any).pointer) as number
    end
end

--- What a worker reads of a region it was handed.
function test.regionPrefix(region: io.SharedBytes): string
    return region:slice(0, 5):tostring()
end

--- What a worker reads of a region, and where the block it reads lives.
function test.regionBlock(region: io.SharedBytes): (string, number)
    return region:slice(0, 5):tostring(), regionAddress(region)
end

--- A region a worker makes and hands back.
function test.makeRegion(text: string): (io.SharedBytes, number)
    local region = sharedbytes.copy(text)
    return region, regionAddress(region)
end

--- Writes a moved array and moves it back.
function test.fillMoved(
    takes frame: affine(table.Array<int32>, table.Array.destroy),
    seed: integer
): affine(table.Array<int32>, table.Array.destroy)
    do
        local writable = frame:write();
        for index = 1, #writable do
            writable[index] = (seed + index) as int32
        end
    end

    return frame
end

--- Where a moved array arrived, and the sum of what it holds.
function test.totalMoved(takes values: affine(table.Array<int32>, table.Array.destroy)): (integer, number)
    local sum: integer = 0
    do
        local readable = values:read()
        for index = 1, #readable do
            sum = sum + readable[index]
        end
    end
    local address = arrayAddress(values)
    own.drop(values)

    return sum, address
end

local function workerRegions(): nil
    local region = sharedbytes.copy("hello, worker")
    local builder = io.Buffer.create()
    builder:put("built ")
    builder:put("bytes")
    local built = builder:freeze()
    local large = sharedbytes.copy(string.rep("large", 200000))
    do
        local scope = tasks.scope();
        const one = scope:work(region, test.regionPrefix)
        const two = scope:work(built, test.regionPrefix)
        assert2(one:await() == "hello")
        assert2(two:await() == "built")
        -- By reference: the worker reads the block the caller holds.
        const three = scope:work(region:slice(7, 6), test.regionBlock)
        const four = scope:work(built, test.regionBlock)
        const five = scope:work(large, test.regionBlock)
        local text, address = three:await()
        assert2(text == "worke" and address == regionAddress(region), "a region crosses by reference")
        text, address = four:await()
        assert2(text == "built" and address == regionAddress(built), "a frozen builder crosses by reference")
        text, address = five:await()
        assert2(text == "large" and address == regionAddress(large), "a large region crosses by reference")
        -- A region a worker made comes back as the same block.
        local made, madeAt = scope:work("made in a worker", test.makeRegion):await()
        assert2(made:tostring() == "made in a worker" and regionAddress(made) == madeAt)
    end
    collectgarbage()
    assert2(large:slice(0, 5):tostring() == "large" and region:tostring() == "hello, worker")
end

local function workerMoves(): nil
    local frame = Array.alloc(ffi.typeof<int32>(), 1024)
    const before = arrayAddress(frame)
    do
        local scope = tasks.scope();
        frame = scope:work(frame, 5, test.fillMoved):await()
        -- Moved there and back: the same allocation, not a copy.
        assert2(arrayAddress(frame) == before, "an owned packed array moves rather than copies")
        assert2(frame:read()[1] == 6 and frame:read()[1024] == 1029)
        local sum, address = scope:work(frame, test.totalMoved):await()
        assert2(sum == (6 + 1029) * 1024 // 2 and address == before, "the worker owns the moved allocation")
    end
end

local function detached(): nil
    assert2(not host.attached())
    raises(
        function(): nil
            host.post("memory.ping")
        end,
        "no embedding application is attached"
    )
    assert2(not gpu.available())
    raises(
        function(): nil
            local _context = gpu.open()
        end,
        "GPU compute is not available on the VM runtime"
    )
end

function test.run(): number
    heapArrays()
    soaSlabs()
    sharedRegions()
    logging()
    workerRegions()
    workerMoves()
    detached()
    collectgarbage()

    return 42
end

export = test
