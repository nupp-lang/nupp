module nupp.tests.vmsimd

const assert2 = require("assert")

const array = require("nupp.array")
const simd = require("simd")
const persist = require("nupp.vm.persist")
const tasks = require("coroutine")

local function memory(): nil
    local species = simd.species(array.uint32)
    const owned = array.scalar(array.uint32, 19)
    const writer = owned:write()
    for at, active in species:over(#writer) do
        species:store(writer, at, species:iota(at, 1), active)
    end
    for at, active in species:over(#writer) do
        local values = species:load(writer, at, active)
        species:store(writer, at, values * 3 + 1, active)
    end
    assert2(
        not pcall(function(): nil
            species:store(writer, 19, species:splat(99))
        end)
    )
    assert2(writer[19] == 58)
    own.drop(writer)
    const reader = owned:read()
    for index = 1, #reader do
        assert2(reader[index] == index * 3 + 1)
    end
    local empty = species:load(reader, 20, species:tail(0))
    assert2((empty == 0):all())
    assert2(
        not pcall(function(): nil
            species:store(reader as any, 1, species:splat(99))
        end)
    )
    assert2(reader[1] == 4)
    assert2(
        not pcall(function(): nil
            species:load(reader, 19)
        end)
    )
end

local function numerics(): nil
    local wide = simd.species(array.uint64, 3)
    local values = wide:iota(9007199254740993ULL, 2ULL)
    assert2(values:extract(3) == 9007199254740997ULL)
    assert2(simd.horizontal.wrappingsum(values) == 27021597764222985ULL)
    local copy = persist.load(persist.save(values)) as simd.Vector<uint64, simd.Fixed<3>>
    assert2((copy == values):all())
    local floats = simd.species(array.float32, 3)
    local converted = floats:convert(values)
    assert2(converted:extract(1) == math.f32.narrow(9007199254740993ULL as number))
    local doubles = floats:widen(array.float64)
    assert2(doubles.lanes == 3)
    assert2(doubles:convert(converted):extract(1) == 9007199254740992)
    local bits = simd.species(array.uint32, 3):reinterpret(floats:splat(1.0))
    assert2((bits == 0x3f800000):all())
    local zero = floats:splat(-0.0)
    assert2(1 / simd.horizontal.propagatingmin(zero) == -math.huge)
    local invalid = simd.species(array.float64, 3):splat(math.huge)
    assert2((simd.species(array.int64, 3):convert(invalid) == 0LL):all())
    local upper = simd.species(array.float64, 3):splat(9223372036854775808.0)
    assert2((wide:convert(upper) == 9223372036854775808ULL):all())
end

local function widths(): nil
    assert2((simd.species(array.uint8, 3):iota(250, 3) + 10):extract(3) == 10)
    assert2((simd.species(array.int8, 3):iota(120, 3) + 3):extract(3) == -127)
    assert2((simd.species(array.uint16, 3):iota(65530, 3) + 10):extract(3) == 10)
    assert2((simd.species(array.int16, 3):iota(32760, 3) + 3):extract(3) == -32767)
    assert2((simd.species(array.uint32, 3):iota(4294967290, 3) + 10):extract(3) == 10)
    assert2((simd.species(array.int32, 3):iota(2147483640, 3) + 3):extract(3) == -2147483647)
    assert2((simd.species(array.int64, 3):iota(9223372036854775804LL, 1LL) + 3LL):extract(3) == -9223372036854775807LL)
    assert2((simd.species(array.float32, 3):iota(16777216.0, 1.0) + 1.0):extract(3) == 16777220.0)
end

local function reducers(): nil
    local species = simd.species(array.float64, 3)
    local ordered = simd.reducer.orderedsum(0.0)
    local pairwise = simd.reducer.pairwisesum(0.0)
    local compensated = simd.reducer.compensatedsum(0.0)
    ordered:add(1e16)
    ordered:add(1.0)
    ordered:add(-1e16)
    compensated:add(1e16)
    compensated:add(1.0)
    compensated:add(-1e16)
    assert2(ordered:value() == 0.0)
    assert2(compensated:value() == 1.0)
    pairwise:add(species:iota(1.0, 1.0), species:tail(2))
    pairwise:add(4.0)
    assert2(pairwise:value() == 7.0)
    local restored = persist.load(persist.save(pairwise)) as simd.PairwiseSum<float64>
    restored:add(8.0)
    assert2(restored:value() == 15.0)
    assert2(pairwise:value() == 7.0)
    local wide = simd.species(array.uint64, 3)
    local exact = simd.reducer.wrappingsum(array.uint64, 0ULL)
    exact:add(wide:iota(9007199254740993ULL, 2ULL), wide:tail(2))
    assert2(exact:value() == 18014398509481988ULL)
    local dot = simd.reducer.ordereddot(0.0)
    dot:add(2.0, species:iota(1.0, 1.0))
    dot:add(species:iota(1.0, 1.0), 2.0, species:tail(2))
    assert2(dot:value() == 18.0)
    local wrapped = simd.species(array.uint64, 2)
    assert2((wrapped:splat((-1) as any) == 18446744073709551615ULL):all())
    local argmin = simd.reducer.numberargmin()
    argmin:add(species:iota(3.0, -1.0), species:tail(2))
    argmin:add(1.0)
    assert2(argmin:value() == 4)
end

local function structure(): nil
    local species = simd.species(array.uint64, 3)
    local a = species:iota(9007199254740993ULL, 1ULL)
    local b = species:iota(20ULL, 2ULL)
    local first, second = a:interleave(b)
    local left, right = first:deinterleave(second)
    assert2((left == a):all() and (right == b):all())
    assert2((a:reverse():reverse() == a):all())
    assert2((a:rotateleft(1):rotateright(1) == a):all())
    assert2(a:insert(2, 42ULL):extract(2) == 42ULL)
    assert2(a:align(b, 1):extract(1) == 24ULL)
    local selected = species:tail(2)
    assert2(a:compress(selected):extract(3) == 0ULL)
    assert2((a:compress(selected):expand(selected) == selected:select(a, 0ULL)):all())
    assert2(a:swizzle(species:iota(3ULL, 18446744073709551615ULL)):extract(1) == a:extract(3))
    const storage = array.scalar(array.uint64, 17)
    const writer = storage:write()
    species:storetriples(writer, 1, a, b, species:splat(99ULL))
    species:storetriples(writer, 10, a, b, species:splat(100ULL))
    local x, y, z = species:loadtriples(writer, 1)
    assert2((x == a):all() and (y == b):all() and (z == 99ULL):all())
    local p, q, r = species:loadtriples(writer, 10)
    assert2((p == a):all() and (q == b):all() and r:extract(3) == 0ULL)
    own.drop(writer)
    const reader = storage:read()
    local indices = simd.species(array.int32, 3):iota(1, 8)
    local gathered = species:gather(reader, indices)
    assert2(
        gathered:extract(1) == a:extract(1) and gathered:extract(2) == 99ULL and gathered:extract(3) == b:extract(3)
    )
    local doubles = simd.species(array.float64, 3)
    local samples = doubles:iota(1.0, 3.0)
    local roots = math.sqrt(samples)
    local root = math.sqrt
    local mapped = doubles:map(root, samples)
    assert2((mapped == roots):all())
    assert2(roots:extract(1) == 1.0 and roots:extract(2) == 2.0)
    local iterator = species:over(8)
    local visits, count = 0, 0
    for at, active in iterator do
        visits = visits + at
        count = count + active:count()
    end
    assert2(visits == 12 and count == 8)
end

export function workers(): number
    local species = simd.species(array.uint64, 3)
    local vector = species:iota(9007199254740993ULL, 1ULL)
    do
        local scope = tasks.scope();
        local job = scope:work(vector, function(
            value: simd.Vector<uint64, simd.Fixed<3>>
        ): simd.Vector<uint64, simd.Fixed<3>>
            local changed = value + 7ULL
            tasks.checkpoint()
            return changed * 3ULL
        end)
        local answer = job:await()
        assert2((answer == (vector + 7ULL) * 3ULL):all())
        assert2(vector:extract(1) == 9007199254740993ULL)
    end

    return 42
end

local parked: any = nil
export function checkpointStart(): number
    parked = @unsafe own.release(
        coroutine.create(function(): number
            local species = simd.species(array.float64, 3)
            local values = species:iota(1.0, 1.0)
            local result = simd.reducer.pairwisesum(0.0)
            result:add(values)
            coroutine.yield(20)
            result:add(values * 2)
            assert2(result:value() == 18.0)

            return 42
        end)
    )
    local ok, value = coroutine.resume(parked)
    assert2(ok and value == 20)

    return 42
end

export function checkpointFinish(): number
    local ok, value = coroutine.resume(parked)
    assert2(ok and value == 42)
    assert2(coroutine.status(parked) == "dead")
    parked = nil

    return 42
end

export function run(): number
    memory()
    numerics()
    widths()
    reducers()
    structure()
    local species = simd.species(array.uint32, 4)
    local values = species:iota(1, 2)
    local changed = values * 3 + 1
    local selected = changed > 4
    assert2(species.lanes == 4)
    assert2(selected:count() == 3)

    return changed:extract(3) + 26
end

export function missingPlugin(): number
    local load = (_G as any).__nupp_load_image
    -- A plugin with vector instructions and no compiled implementation is
    -- refused when it is loaded, so nothing in it runs and no module of it
    -- is registered; one without them loads and runs on the same host.
    local ok, problem = pcall(
        load,
        [[function plugin 0 1 8 1 v:v
source nupp.tests.simdplugin
const 0 str "entered"
const 1 num 1
K 2 1
SetField 1 0 2
Simd add number 3 2
Ret 3
end
module nupp.tests.simdplugin 0
entry 0
]]
    )
    assert2(not ok)
    assert2(tostring(problem):find("image refused: function plugin in module", 1, true) ~= nil)
    assert2(tostring(problem):find("native compilation", 1, true) ~= nil)
    assert2(package.loaded["nupp.tests.simdplugin"] == nil)
    assert2(not pcall(require, "nupp.tests.simdplugin"))
    local scalar = load([[function scalar 0 1 4 1 v:v
const 0 num 41
K 1 0
Ret 1
end
entry 0
]])
    assert2(scalar({}) == 41)

    return 42
end
