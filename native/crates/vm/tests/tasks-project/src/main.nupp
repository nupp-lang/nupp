module main

const assert2 = require("assert")

local tasks = require("coroutine")
local main = {}
local savedThread: any = nil

function main.checkpointStart(): number
    savedThread = @unsafe own.release(
        coroutine.create(function(): number
            local suspension = require("coroutine.sus")
            local host = require("coroutine.sus.host")
            local time = require("coroutine")
            local clock = require("nupp.vm.clock")
            local handler = host.Handler(
                canpark = function(_: host.Handler): boolean
                    return true
                end,
                park = function(_: host.Handler, waiting: host.Waiting, _: function(): nil): nil
                    coroutine.yield(20)
                    while not waiting:ready() do
                        suspension.poll()
                        clock.sleep(1)
                    end
                end,
                shutdown = function(_: host.Handler): nil
                end
            )
            const handling = host.install(handler)
            do
                local scope = tasks.scope(timeoutms = 1000);
                local child = scope:spawn(function(): number
                    time.sleep(50)
                    return 42
                end)
                return child:await()
            end
        end)
    )
    local ok, value = coroutine.resume(savedThread)
    assert2(ok and value == 20)

    return 42
end

function main.checkpointFinish(): number
    local ok, value = coroutine.resume(savedThread)
    assert2(ok, tostring(value))
    assert2(value == 42 and coroutine.status(savedThread) == "dead")
    savedThread = nil

    return 42
end

local function resultPack(): (number, nil, number)
    return 20, nil, 22
end

local function protectedPack(...: any): any
    return {
        pcall(
            function(...: any): ...any
                return ...
            end,
            ...
        )
    }
end

function main.resultPacks(): number
    local packed: any = {7, resultPack()}
    assert2(packed[1] == 7 and packed[2] == 20 and packed[3] == nil and packed[4] == 22, "trailing results")
    assert2(table.maxn(packed) == 4)
    local protected = protectedPack(20, nil, 22)
    assert2(
        protected[1] == true and protected[2] == 20 and protected[3] == nil and protected[4] == 22,
        "protected varargs"
    )
    local empty: any = {
        9,
        (function(): nil
        end)()
    }
    assert2(empty[1] == 9 and table.maxn(empty) == 1)
    local nan: any = 0 / 0
    local zero: any = 0
    local negativeZero: any = -zero
    assert2(nan ~= nan and zero == negativeZero)
    local problem: any = setmetatable({answer = 42}, {
        __tostring = function(value: any): string
            return "answer: " .. tostring(value.answer)
        end
    })
    assert2(tostring(problem) == "answer: 42")

    return 42
end

local record Resource is own.Closeable
    state: any

    function close(takes self: Resource): nil
        self.state.closed = self.state.closed + 1
    end
end

local function resource(state: any): affine(Resource)
    return Resource(state = state)
end

function main.run(): number
    local state: any = {closed = 0}
    local answer = 0
    do
        local scope = tasks.scope(limit = 1);
        local first = scope:spawn(function(): number
            do
                local owned = resource(state);
                tasks.checkpoint()
                return 20
            end
        end)
        local second = scope:spawn(function(): number
            do
                local owned = resource(state);
                return 22
            end
        end)
        answer = first:await() + second:await()
    end
    assert2(state.closed == 2, "expected two cleanups: " .. tostring(state.closed))

    return answer
end

function main.cancellation(): number
    do
        local scope = tasks.scope();
        local child = scope:spawn(function(): number
            error("a cancelled queued task must not start")
        end)
        assert2(child:cancel())
        local ok, reason = pcall(function(): number
            return child:await()
        end)
        assert2(not ok and tasks.iscancelled(reason))
        assert2(child:isdone() and child:status() == "cancelled")
    end

    return 42
end

function main.churn(): number
    local total = 0
    do
        local scope = tasks.scope(limit = 1);
        for i = 1, 1000 do
            local child = scope:spawn(function(): number
                return 1
            end)
            total = total + child:await()
            assert2(child:isdone() and child:await() == 1)
        end
    end
    assert2(total == 1000)

    return 42
end

function main.ownership(): number
    local state: any = {closed = 0}
    do
        local owned = resource(state)
        do
            local moved = owned;
            assert2(state.closed == 0)
        end
        assert2(state.closed == 1, "expected one cleanup: " .. tostring(state.closed))
    end
    assert2(state.closed == 1, "expected one cleanup: " .. tostring(state.closed))
    local marker: any = {}
    local ok, reason = pcall(function()
        do
            local owned = resource(state);
            error(marker)
        end
    end)
    assert2(not ok and reason == marker and state.closed == 2)
    local childOk, childReason = pcall(function()
        do
            local scope = tasks.scope();
            local child = scope:spawn(function()
                error(nil)
            end)
            child:await()
        end
    end)
    assert2(not childOk and childReason == nil)

    return 42
end

function main.families(): number
    local a, b, c = tasks.run(function(borrows scope: any): (number, nil, number)
        return 20, nil, 22
    end)
    assert2(a == 20 and b == nil and c == 22)
    local values, errors = tasks.gather<number>({
        function(): number
            return 20
        end,
        function(): number
            error("expected failure")
        end,
        function(): number
            return 22
        end,
    })
    assert2(values[1] == 20 and values[2] == nil and values[3] == 22)
    assert2(errors[2] == "expected failure")
    local value, index = tasks.race<number>({
        function(): number
            return 42
        end,
        function(): number
            return 0
        end
    })
    assert2(value == 42 and index == 1)

    return 42
end

function main.captures(): number
    local state: any = {closed = 0}
    do
        local owned = resource(state)
        local body = function(): number takes (owned)
            assert2(owned.state.closed == 0)
            return 42
        end
        assert2(body() == 42)
    end
    assert2(state.closed == 1, "expected one cleanup: " .. tostring(state.closed))
    do
        local owned = resource(state)
        local body = function(): number takes (owned)
            error("uncalled closure")
        end
    end
    assert2(state.closed == 2, "expected two cleanups: " .. tostring(state.closed))
    do
        local scope = tasks.scope();
        local owned = resource(state)
        local child = scope:spawn(function(): number takes (owned)
            error("cancelled closure")
        end)
        child:cancel()
    end
    assert2(state.closed == 3, "expected three cleanups: " .. tostring(state.closed))

    return 42
end

function main.workers(): number
    local source: any = {answer = 1}
    source.self = source
    do
        local scope = tasks.scope();
        local child = scope:work(source, function(value: any): any
            value.answer = 42
            assert2(value.self == value)
            return value
        end)
        local result = child:await()
        assert2(result.answer == 42 and result.self == result)
        assert2(source.answer == 1 and result ~= source)
    end

    return 42
end

function main.workerSettlement(): number
    local failed, problem = pcall(function(): nil
        do
            local scope = tasks.scope();
            scope:work(function(): number
                error("worker settlement failure")
            end)
        end
    end)
    assert2(not failed and tostring(problem):find("worker settlement failure", 1, true) ~= nil)
    local completed, cancelled = pcall(function(): nil
        do
            local scope = tasks.scope(timeoutms = 10);
            local child = scope:work(function(): number
                local total = 0
                while true do
                    total = total + 1
                end

                return total
            end)
            child:await()
        end
    end)
    assert2(not completed and tasks.iscancelled(cancelled))

    return 42
end

function main.named(): number
    do
        local scope = tasks.scope();
        local child = scope:spawn("named job", function(): number
            return 42
        end)
        child:cancel("requested")
        local ok, reason = pcall(function(): number
            return child:await()
        end)
        assert2(not ok and tasks.iscancelled(reason))
        local cancellation = reason as any
        assert2(cancellation.operation == "named job" and cancellation.reason == "requested")
    end

    return 42
end

local record Pair
    left: Resource
    right: Resource
end

local function conditional(flag: boolean, state: any): nil
    local pair = Pair(left = resource(state), right = resource(state))
    if flag then
        own.drop(pair.left)
    end
    own.drop(pair)
end

function main.fields(): number
    local state: any = {closed = 0}
    conditional(true, state)
    assert2(state.closed == 2)
    conditional(false, state)
    assert2(state.closed == 4)

    return 42
end

function main.coroutines(): number
    local thread = coroutine.create(function(start: number): number
        local again = coroutine.yield(start, nil)
        return again + 1
    end)
    assert2(type(thread) == "thread" and coroutine.status(thread) == "suspended")
    local ok, value, tail = coroutine.resume(thread, 20)
    assert2(ok and value == 20 and tail == nil)
    local done, answer = coroutine.resume(thread, 41)
    assert2(done and answer == 42 and coroutine.status(thread) == "dead")
    local wrapped = coroutine.wrap(function(): number
        coroutine.yield(20)
        return 22
    end)
    assert2(wrapped() + wrapped() == 42)

    return 42
end

function main.channels(): number
    do
        local channel = tasks.channel<number>(1)
        do
            local scope = tasks.scope();
            local sender = scope:work(channel:share(), function(channel: any): number
                channel:send(20)
                channel:send(22)
                return 1
            end)
            local first, firstOk = channel:receive()
            local second, secondOk = channel:receive()
            assert2(firstOk and secondOk and assert2(first) + assert2(second) == 42)
            assert2(sender:await() == 1)
        end
    end

    return 42
end

function main.generators(): number
    local generator = require("nupp.generator")
    local state: any = {closed = 0}
    do
        local values = generator.create<number>(function(emit: function(number): nil): nil
            do
                local owned = resource(state);
                emit(20)
                emit(22)
            end
        end);
        local first, present = values:next()
        assert2(present and first == 20)
    end
    assert2(state.closed == 1)

    return 42
end

function main.automaticClose(): number
    local state: any = {closed = 0}
    do
        local co = coroutine.create(function(): nil
            do
                local owned = resource(state);
                coroutine.yield(1)
                coroutine.yield(2)
            end
        end)
        local ok = coroutine.resume(co)
        assert2(ok)
    end
    assert2(state.closed == 1, "coroutine scope exit must close its resources")
    do
        local step = coroutine.wrap(function(): nil
            do
                local owned = resource(state);
                coroutine.yield(1)
                coroutine.yield(2)
                coroutine.yield(3)
            end
        end)
        assert2(step() == 1 and step() == 2)
    end
    assert2(state.closed == 2, "wrapped coroutine must close on scope exit")
    local ok = pcall(function(): nil
        local co = coroutine.create(function(): nil
            do
                local owned = resource(state);
                coroutine.yield(1)
            end
        end)
        assert2(coroutine.resume(co))
        error("stop")
    end)
    assert2(not ok and state.closed == 3)
    local endpoint: any
    do
        local channel = tasks.channel<number>(1)
        endpoint = channel:share()
        channel:send(42)
    end
    local value, present = endpoint:receive()
    assert2(present and value == 42)
    local _, more = endpoint:receive()
    assert2(not more, "channel scope exit must close after draining")

    return 42
end

export = main
