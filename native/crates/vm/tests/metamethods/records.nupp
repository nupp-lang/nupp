--- Exercises metamethods declared on a typed record and stored on its shape.
--- Length handlers are covered in `len.lua`.
local M = {}

local record V
    x: number
    y: number
    metamethod __add: function(self, other: V): V
    metamethod __sub: function(self, other: V): V
    metamethod __mul: function(self, k: number): V
    metamethod __unm: function(self): V
    metamethod __eq: function(self, other: V): boolean
    metamethod __lt: function(self, other: V): boolean
    metamethod __le: function(self, other: V): boolean
    metamethod __concat: function(self, other: string): string
    metamethod __tostring: function(self): string
    metamethod __call: function(self, k: number): number
end

function V.__add(a: V, b: V): V
    return new V(x = a.x + b.x, y = a.y + b.y)
end

function V.__sub(a: V, b: V): V
    return new V(x = a.x - b.x, y = a.y - b.y)
end

function V.__mul(a: V, k: number): V
    return new V(x = a.x * k, y = a.y * k)
end

function V.__unm(a: V): V
    return new V(x = -a.x, y = -a.y)
end

function V.__eq(a: V, b: V): boolean
    return a.x == b.x and a.y == b.y
end

function V.__lt(a: V, b: V): boolean
    return a.x < b.x
end

function V.__le(a: V, b: V): boolean
    return a.x <= b.x
end

function V.__concat(a: V, s: string): string
    return tostring(a) .. s
end

function V.__tostring(a: V): string
    return "V(" .. tostring(a.x) .. "," .. tostring(a.y) .. ")"
end

function V.__call(a: V, k: number): number
    return a.x * k + a.y
end

function M.main(): string
    local lines: {string} = {}
    local a = new V(x = 1, y = 2)
    local b = new V(x = 3, y = 4)
    local c = a + b
    lines[#lines + 1] = tostring(c)
    lines[#lines + 1] = tostring(b - a)
    lines[#lines + 1] = tostring(a * 3)
    lines[#lines + 1] = tostring(-a)
    lines[#lines + 1] = tostring(a == new V(x = 1, y = 2)) .. " " .. tostring(a ~= b) .. " " .. tostring(a == b)
    lines[#lines + 1] = tostring(a < b) .. " " .. tostring(b <= a) .. " " .. tostring(a >= b)
    lines[#lines + 1] = a .. "!"
    lines[#lines + 1] = tostring(a(10))
    local total = new V(x = 0, y = 0)
    local same = 0
    for i = 1, 1000 do
        total = total + a * 2
        if total == new V(x = 2 * i, y = 4 * i) then
            same = same + 1
        end
    end
    lines[#lines + 1] = tostring(total) .. " " .. tostring(same)

    return table.concat(lines, "\n") .. "\n"
end

return M
