module nupp.compiler.vm.corpus

-- The Lua corpus executes as dynamic source, like the existing Lua test runner.
-- Only its Nupp dependencies pass through semantic checking at image construction.
local envMod = require("nupp.compiler.project.env")
local parser = require("nupp.compiler.syntax.parser")
local check = require("nupp.compiler.check")
local fs = require("nupp.compiler.fs")
local lower = require("nupp.compiler.vm.lower")
local corpus = {}

function corpus.emit(root: string, suites: string, unavailable: string?): string
    require("nupp.compiler.syntax.triviaarena").install(require("nupp.compiler.syntax.triviaarena.table"))
    require("nupp.compiler.vm.chunks").install()
    local env = envMod.new(root, {
        cache = false,
        nativeCompilerServices = false,
        compilerServices = require("nupp.compiler.hostservices"),
        config = {include = {"src", "tests", "native/crates/vm/tests"}}
    })
    table.insert(assert(env.roots), 1, root .. "/native/crates/vm/lib")
    table.insert(assert(env.roots), 1, root .. "/native/crates/vm/decls")
    env.managedCoroutines = true
    env.globals["coroutine"].t = assert(envMod.resolveModule(env, "nupp.vm.ownedCoroutine"))
    local extras = {}
    local missing = {}
    for name in (unavailable or ""):gmatch("[^,]+") do
        missing[name] = true
    end
    -- A suite that names a browser runtime module itself tests that module, which
    -- the image builders otherwise never carry: a program reaches the browser
    -- runtime only on the browser. The suite's own literal requires carry it here.
    local browser: {[string]: boolean} = {}
    for name in suites:gmatch("[^,]+") do
        extras[#extras + 1] = name
        local path = envMod.findRuntimeModulePath(env as any, name)
        local text = path and fs.readFile(path as string) or nil
        for required in (text or ""):gmatch("require%(%s*[\"'](nupp%.runtime%.browser%.[%w_.]+)[\"']%s*%)") do
            browser[required] = true
        end
    end
    -- The `@aot` check loads its backend by name, out of the module graph, and
    -- the root image carries it only because `nupp build` requires it.
    extras[#extras + 1] = "nupp.compiler.aot.compile"
    extras[#extras + 1] = "nupp.compiler.aot.target"
    -- The compiler's carried files, as the root CLI image carries them: a suite
    -- reads them through `nupp.compiler.bundled` where the LuaJIT runner reads
    -- the copies its build staged.
    local manifest, problem = assert(rawget(_G, "loadfile"), "source loader unavailable")(root .. "/nupp.lua")
    assert(manifest, problem)
    local carried = require("nupp.compiler.vm.resources").source(root, manifest())
    extras[#extras + 1] = "nupp.vm.cliResources"

    return lower.emit(
        "corpus-runner",
        extras,
        function(name: string, soft: boolean?): string?
            if missing[name] then
                return nil
            end
            if name == "nupp.vm.cliResources" and not soft then
                return "=(nupp.vm.cliResources)"
            end
            if browser[name] and not soft then
                return envMod.findRuntimeModulePath(env as any, name)
            end

            return require("nupp.tools.vm.project").resolve(env, root, name, soft)
        end,
        function(name: string, path: string): table
            if name == "nupp.vm.cliResources" then
                return parser.parse(carried, path).root
            end
            local parsed = parser.parse(assert(fs.readFile(path)), path)
            assert(#parsed.errors == 0, "parse failed: " .. path)
            if not path:match("%.lua$") then
                local diagnostics = check.check(parsed, path, env as any, {})
                for _, diagnostic in ipairs(diagnostics) do
                    if diagnostic.severity == "error" or not diagnostic.severity then
                        error(path .. ": " .. diagnostic.code .. " " .. diagnostic.msg)
                    end
                end
            end

            return parsed.root
        end
    )
end

export = corpus
