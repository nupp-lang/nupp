  "scope": "P1a logical return destinations, retained program-body loads, ordinary specialization contracts and current helper/park/finite-budget correctness. This does not complete the Rust VM deletion or the common semantic graph.",
  "ownership": "Nupp declarations, checked metadata, validators and ordinary implementations own the contracts. Temporary checked-source-to-CLIF adapters emit only ordinary operations; semantic optimization, lifetime proofs, slot promotion, context balance and recovery belong to the existing Nupp graph in P1b/P7.",
  "contracts": {
    "programLoads": {
      "calls": 253,
      "kinds": [
        "uint8",
        "int32",
        "uint64",
        "int64",
        "number"
      ],
      "source": "code",
      "lifetime": "body",
      "scope": "Retained encoded instructions and jump words only. No readonly machine flag, folding permission or process-wide immutability is inferred. Live function tables, heap-bearing constants, budgets, heat and GC state remain live loads."
    },
    "logicalSlots": {
      "calls": 230,
      "returns": [
        "Ret",
        "RetNil",
        "RetN",
        "PadResults"
      ],
      "scope": "Current ABI headers are decoded at the boundary into caller frame/window/logical-slot destinations. Single float returns retain exact raw bits; value-slot0 padding is distinct from the -1 no-value sentinel. Vector slots remain part of the SIMD port."
    },
    "specialization": {
      "operations": [
        "assertConstant",
        "specializeValue",
        "pushContext",
        "popContext",
        "inInterpreter"
      ],
      "ordinary": "Identity with ownership preserved; identity even outside the bounded domain; no-op context push/pop; inInterpreter=true. Context keys are still evaluated exactly once. Checked function metadata survives export lookup.",
      "defaultVariantCap": 256,
      "maximumVariantCap": 4096,
      "int64EndpointArithmetic": "decimal strings, checked without endpoint overflow",
      "interpreterFeedbackGates": 5,
      "derivedGraphImplemented": false
    }
  },
  "correctness": {
    "equality": "rt_eq_slow publishes the actual native frame, PC, budget and result count before a guest callback, then reloads context on success and error. A callee-only root survives allocation stress, oracle checking and full collection; zero/multiple results and raising callbacks retain state.",
    "parkResume": "Three one-edge scheduler pauses retain closure captures, heap varargs, integer/float windows and a trailing-nil result pack across full GC. A clobbered global last_nres is restored per task. Exact-once counter 3, final [-7,0.25,message,payload,nil], cumulative source limit 99 -> 95; source limit 1 fails rather than parks.",
    "budgets": "Calls and taken backward conditional edges charge exactly once. Untaken edges and terminal instructions do not charge; terminal returns can finish at zero. A source-limit error wins when source and slice are both zero. Parking an unexecuted edge consumes neither budget. Builtins, iterators, resolved calls, typed/host/task and stack-growth fallbacks are covered against the shared temporary Rust boundary.",
    "temporaryFiniteBridges": [
      "CallMethod gates before __index resolution via the whole-op Rust boundary",
      "PCall preserves its existing distinction from ordinary call budget points via the whole-op boundary"
    ],
    "removedRust": "Unused rt_grow helper, twelve lines; no callers or imports.",
    "automaticGraphRootPublicationProof": false
  },
