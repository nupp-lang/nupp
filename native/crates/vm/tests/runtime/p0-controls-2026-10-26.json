  "reproduction": {
    "originalWorkload": "bench/vm/workloads.bench.nupp",
    "guardedWorkloadSource": "local expectedJit = os.getenv(\"NUPP_BASELINE_JIT\")\nif expectedJit then\n    local engine: any = rawget(_G, \"jit\")\n    assert(type(engine) == \"table\", \"baseline is not LuaJIT\")\n    assert(engine.status() == (expectedJit == \"on\"), \"baseline JIT mode differs\")\n    io.stderr:write(\"# verified workload LuaJIT \" .. expectedJit .. \"\\n\")\nend\n\n--- The interpreter workloads: six cases a replacement runtime is judged on.\n---\n--- The same source the hand-rolled comparison ran, as `nupp.bench` cases so the\n--- runner's paired `--against` protocol applies to them. Each case runs its workload\n--- once per iteration -- `n` is fixed at one, so a round is one run of the original\n--- work -- and declares the checksum the original printed, which every fork and both\n--- executables must agree on.\n---\n--- `BENCH_SCALE` is read at run time, as the original read it, so no compiler can\n--- fold a case away. The checksums at scale 1 are fib 832040, loops 761038, tables\n--- 487886131, strings 5281858, records 800000, closures 499892; at scale 2 they are\n--- fib 1346269, loops 522073, tables 487986259, strings 5433712, records 199997,\n--- closures 999754.\n---\n--- Run: nupp bench --file bench/vm/workloads.bench.nupp --against OTHER_NUPP --forks 12\n--- --margin 2\nlocal bench = require(\"nupp.bench\")\n\nlocal scale: number = tonumber(os.getenv(\"BENCH_SCALE\") or \"1\") or 1\n\nlocal function fib(n: number): number\n    if n < 2 then\n        return n\n    end\n\n    return fib(n - 1) + fib(n - 2)\nend\n\nlocal function loops(): number\n    local total = 0\n    for i = 1, 30000000 do\n        total = (total + i * i * scale) % 1000003\n    end\n\n    return total\nend\n\nlocal function tables(): number\n    local counts: {[number]: number} = {}\n    for i = 1, 3000000 do\n        local k = (i * 7919 * scale) % 4099\n        counts[k] = (counts[k] or 0) + 1\n    end\n    local arr: {number} = {}\n    for i = 1, 1000000 do\n        arr[i] = (i * scale) % 977\n    end\n    local sum = 0\n    for _, v in ipairs(arr) do\n        sum = sum + v\n    end\n\n    return sum + #counts\nend\n\nlocal function strings(): number\n    local parts: {string} = {}\n    for i = 1, 300000 do\n        parts[#parts + 1] = (\"item%d:%s\"):format(i, tostring(i * 3 * scale))\n    end\n    local joined = table.concat(parts, \",\")\n    local found = 0\n    for _ in joined:gmatch(\"item%d+5:\") do\n        found = found + 1\n    end\n\n    return #joined + found\nend\n\nlocal record Point\n    x: number\n    y: number\nend\n\nlocal function records(): number\n    local points: {Point} = {}\n    for i = 1, 200000 do\n        points[i] = new Point(x = i * scale, y = i * 2)\n    end\n    local acc = 0.0\n    for _ = 1, 20 do\n        for i = 1, #points do\n            local p = points[i]\n            acc = acc + p.x * 0.5 + p.y * 0.25\n        end\n    end\n\n    return math.floor(acc) % 1000003\nend\n\nlocal function closures(): number\n    local function map(xs: {number}, f: function(number): number): {number}\n        local out: {number} = {}\n        for i = 1, #xs do\n            out[i] = f(xs[i])\n        end\n\n        return out\n    end\n\n    local xs: {number} = {}\n    for i = 1, 100000 do\n        xs[i] = i * scale\n    end\n    local total = 0\n    for round = 1, 30 do\n        local ys = map(xs, function(v: number): number\n            return v * round + 1\n        end)\n        total = (total + ys[#ys]) % 1000003\n    end\n\n    return total\nend\n\nlocal workloads: {{\n    name: string,\n    run: function(): number\n}} = {\n    {\n        name = \"fib\",\n        run = function(): number\n            return fib(29 + scale)\n        end,\n    },\n    {name = \"loops\", run = loops},\n    {name = \"tables\", run = tables},\n    {name = \"strings\", run = strings},\n    {name = \"records\", run = records},\n    {name = \"closures\", run = closures},\n}\n\nfor _, workload in ipairs(workloads) do\n    local run = workload.run\n    bench.case(\n        workload.name,\n        function(b: bench.Case): nil\n            local check = 0\n            for _ = 1, b.n do\n                check = run()\n            end\n            bench.keep(check)\n            b.checksum = check\n        end,\n        1\n    )\nend\n\nbench.report()\n",
    "luaInit": "local mode = os.getenv(\"NUPP_BASELINE_JIT\")\nif mode == \"off\" then jit.off() end\nif mode then assert(jit.status() == (mode == \"on\"), \"wrong baseline LuaJIT mode\") end\n",
    "wrappers": {
      "nupp-interpreter": "#!/bin/sh\nunset LUA_INIT NUPP_BASELINE_JIT GC_STRESS GC_INTERLEAVE GC_ORACLE\nNUPP_COMPILER_ROOT=/Users/dowling/projects/nupp-wt/native-runtime\nNUPP_VM_BINARY=/Users/dowling/projects/nupp-wt/native-runtime/build/native-result-regression/runtime\nNUPP_VM_CLI_IMAGE=/Users/dowling/projects/nupp-wt/native-runtime/.nupp/vm-cli/38beded458f01e50c7bd01edf101dce44831f65c8e67b17b6730c5f8e49d4ce5/compiler.image\nNO_JIT=1\nNO_AOT=1\nSIMD_INTERPRET=1\nNUPP_VM_AUTO_REBUILD=0\nexport NUPP_COMPILER_ROOT NUPP_VM_BINARY NUPP_VM_CLI_IMAGE NO_JIT NO_AOT SIMD_INTERPRET NUPP_VM_AUTO_REBUILD\nexec \"$NUPP_VM_BINARY\" exec \"$NUPP_VM_CLI_IMAGE\" nupp.tools.vm.root \"$@\"\n",
      "luajit-main-on": "#!/bin/sh\nunset NUPP_VM_CLI_IMAGE NUPP_VM_BINARY NUPP_VM_CLI_ENTRY NUPP_COMPILER_ROOT NUPP_JIT_IMAGE\nunset NO_JIT NO_AOT SIMD_INTERPRET JIT_FRAME_THRESHOLD JIT_THRESHOLD GC_STRESS GC_INTERLEAVE GC_ORACLE\nNUPP_BASELINE_JIT=on\nLUA_INIT=@/Users/dowling/projects/nupp-wt/native-runtime/build/native-runtime-p0/luajit-mode.lua\nexport NUPP_BASELINE_JIT LUA_INIT\nexec /Users/dowling/projects/nupp/bin/nupp \"$@\"\n",
      "luajit-main-off": "#!/bin/sh\nunset NUPP_VM_CLI_IMAGE NUPP_VM_BINARY NUPP_VM_CLI_ENTRY NUPP_COMPILER_ROOT NUPP_JIT_IMAGE\nunset NO_JIT NO_AOT SIMD_INTERPRET JIT_FRAME_THRESHOLD JIT_THRESHOLD GC_STRESS GC_INTERLEAVE GC_ORACLE\nNUPP_BASELINE_JIT=off\nLUA_INIT=@/Users/dowling/projects/nupp-wt/native-runtime/build/native-runtime-p0/luajit-mode.lua\nexport NUPP_BASELINE_JIT LUA_INIT\nexec /Users/dowling/projects/nupp/bin/nupp \"$@\"\n"
