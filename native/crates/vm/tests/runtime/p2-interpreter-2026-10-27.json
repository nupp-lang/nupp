  "scope": "P2 interpreter coverage after the initial P1b graph slice. P2, P1b, the Rust loop deletion and the migration remain open.",
  "architecture": {
    "owner": "Nupp owns instruction decode/control, logical frame windows and scalar SIMD lane arithmetic. Semantic optimization belongs in the existing Nupp graph.",
    "graph": "The initial eight handlers still use the common graph. Other functions use the named temporary compileDirectFunction path until P1b retires it. No CLIF optimizer was added.",
    "integerLeaves": [
      "IXor",
      "INot",
      "IBswap32"
    ],
    "records": "Single Nupp record module owns slots, record tags and seven physical-field instruction entries. Full u16 slot indices, aliases, exact values and nil-slot callbacks have acceptance coverage. Named services retain managed descriptor/owner/schema checks, codecs, numeric boxing and dispatch.",
    "simd": "27 instruction entries, scalar lane arithmetic/reductions/conversions/masks and typed scalar/vector transfers. All ten element kinds and conversion pairs have exact reference coverage. Managed permutations, gather/scatter, packaging and storage commits remain in named prepare/finish services.",
    "simdPacket": {
      "bytes": 2080,
      "alignment": 16,
      "descriptorAbiHash": "0xb23176d6aa4d10ea",
      "lifetime": "No managed pointers. Scratch and raw span views never survive dispatch, suspension or collection; frame windows reload after collecting boundaries."
    },
    "transfers": "Ordinary protected pushes bypass budget charges; method calls charge once before resolution. Guarded protected/cleanup returns, exhausted ordinary budgets and remaining call forms still transfer to Rust.",
    "slotContracts": {
      "moduleCount": 12,
      "calls": 323,
      "vectorClasses": [
        "xLow",
        "xHigh"
      ],
      "vectorBytes": 16,
      "halfOffsets": [
        0,
        8
      ]
    },
    "programReadCalls": 333,
    "temporaryLowering": "Scalar helper composition, repeated/nested calls, loops and early returns preserve declared storage types. Support scratch is statically bounded to 4096 bytes total and alignment at most16; opcode handlers remain stackless. This direct path is deletion debt, not another semantic IR.",
    "abiValidation": "Loop-carried context values must reach only the original ABI context unchanged, on every incoming branch. Boundary validation does not rewrite or optimize CLIF.",
    "capability": "A native-core no-JIT binary admits covered SIMD interpretation by default; an objectless no-JIT binary retains early refusal. Explicit disabling remains a refusal.",
    "oracleCorrection": "Scalar equal-operand min/max preserves negative nonzero values; only zero values choose a zero sign. Existing JIT agreement and zero/NaN regressions pass."
  },
