module demo.main

local math = require("demo.math")
local main = {}

local function pack(...)
    return {n = select("#", ...), "prefix", ...}
end

function main.run(): number
    local values = pack(1, nil, 3, 4, 5, 6, 7, 8, 9, 10, 11, nil)
    assert(values.n == 12 and values[1] == "prefix" and values[2] == 1)
    assert(values[3] == nil and values[12] == 11 and values[13] == nil)
    local returned = pack(
        pcall(function()
            return 7, nil, 9
        end)
    )
    assert(returned.n == 4 and returned[2] == true and returned[3] == 7)
    assert(returned[4] == nil and returned[5] == 9)
    local failed = pack(
        pcall(function()
            error("expected")
        end)
    )
    assert(failed.n == 2 and failed[2] == false and failed[3] == "expected")
    local bigA, bigB = 9007199254740990, 9007199254740991
    local tiny = 1e-20
    assert(bigB - bigA == 1 and tiny > 0)

    return math.twice(20) + 2
end

export = main
