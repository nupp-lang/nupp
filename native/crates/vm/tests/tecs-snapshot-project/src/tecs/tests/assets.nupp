module tecs.tests.assets

local assetnative = require("tecs.internal.assetnative")
local fixture = {}

function fixture.run(path: string): integer
    local bytes, width, height = assetnative.load(path, 1)
    assert(width > 0 and height > 0)
    assert(#bytes == width * height * 4)
    local color: {integer} = {string.byte(bytes, 1, 3)}
    local transparent, changedWidth, changedHeight = assetnative.load(path, 1, color)
    assert(changedWidth == width and changedHeight == height)
    for offset = 1, #bytes, 4 do
        local r, g, b, a = string.byte(bytes, offset, offset + 3)
        local rr, gg, bb, aa = string.byte(transparent, offset, offset + 3)
        assert(r == rr and g == gg and b == bb)
        assert(aa == (r == color[1] and g == color[2] and b == color[3] and 0 or a))
    end
    local ok, message = pcall(assetnative.load, path .. ".missing", 1)
    assert(not ok and tostring(message):find("Tecs asset load:", 1, true) ~= nil)
    local again, againWidth, againHeight = assetnative.load(path, 1)
    assert(again == bytes and againWidth == width and againHeight == height)

    return width * height
end

export = fixture
