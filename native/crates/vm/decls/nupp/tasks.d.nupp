-- Task ownership supplied by the native host.
local record Task<R...>
    await: function(self: Task<R...>): R...
    isDone: function(self: Task<R...>): boolean
    status: function(self: Task<R...>): string
    cancel: function(self: Task<R...>, reason: string?): boolean
end

local record Scope is nupp.Closeable
    spawn: function<A..., R...>(
        borrows self: Scope,
        takes body: function(A...): R...,
        ...: A...
    ): Task<R...> borrows (self)
        & function<R...>(
            borrows self: Scope,
            takes body: function(): R...,
            name: string
        ): Task<R...> borrows (self)
    _spawnNamed: function<R...>(
        borrows self: Scope,
        takes body: function(): R...,
        name: string
    ): Task<R...> borrows (self)
    fork: function<A..., R...>(borrows self: Scope, body: function(A...): R..., ...: A...): Task<R...> borrows (self)
    cancel: function(borrows self: Scope, reason: string?): nil
    close: function(takes self: Scope): nil
end

local record ChannelEndpoint<T>
    send: function(self: ChannelEndpoint<T>, value: T): nil
    receive: function(self: ChannelEndpoint<T>): (T?, boolean)
end

local record Channel<T> is nupp.Closeable
    send: function(borrows self: Channel<T>, value: T): nil
    receive: function(borrows self: Channel<T>): (T?, boolean)
    share: function(borrows self: Channel<T>): ChannelEndpoint<T>
    close: function(takes self: Channel<T>): nil
end

local record Tasks
    channel: function<T>(capacity: integer): affine(Channel<T>)
    open: function(limit: integer?, timeoutMs: number?): affine(Scope)
    run: function<R...>(scoped body: function(borrows scope: Scope): R...): R...
        & function<R...>(limit: integer?, timeoutMs: number?, scoped body: function(borrows scope: Scope): R...): R...
    -- The implementation is `nupp.tasks` itself (`nupp.vm.taskScope`), so
    -- these keep its contracts: borrowed bodies, or owned ones it calls or
    -- drops exactly once.
    gather: function<T>(scoped bodies: {function(): T}): ({T?}, {any})
        & function<T>(takes bodies: {function(): T}): ({T?}, {any})
    race: function<T>(scoped bodies: {function(): T}): (T?, integer?)
        & function<T>(takes bodies: {function(): T}): (T?, integer?)
    familyOpen: function(): affine(Scope)
    familyAwait: function(borrows scope: Scope, race: boolean): (any, any)
    checkpoint: function(): nil
    deadline: function(): number?
    isCancelled: function(value: any): boolean
end
type Tasks.Scope = Scope
return Tasks
