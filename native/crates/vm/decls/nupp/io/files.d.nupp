-- The filesystem surface supplied by the VM compiler host.
local paths = require("nupp.io.path")
local bytes = require("nupp.io")
local type Info = {
    kind: string,
    size: number,
    modified: number
}
local type Entry = {
    name: string,
    kind: string
}
local type TemporaryOptions = {
    directory: (string | paths.Path)?,
    prefix: string?,
    suffix: string?
}
local interface TemporaryPath is nupp.Closeable
    toString: function(self: TemporaryPath): string
    isReleased: function(self: TemporaryPath): boolean
    persist: function(self: TemporaryPath, destination: string): (boolean, string?)
    close: @nosuspend function(takes self: TemporaryPath): nil
end
local record Files
    info: function(path: string): (Info?, string?)
    isDirectory: function(path: string): boolean
    isFile: function(path: string): boolean
    exists: function(path: string): boolean
    list: function(path: string): ({Entry}?, string?)
    createDirectory: function(path: string): (boolean, string?)
    remove: function(path: string, recursive: boolean?): (boolean, string?)
    read: function(path: string): (string?, string?)
    write: function(path: string | paths.Path, borrows data: string | bytes.ByteView): (boolean, string?)
    glob: function(pattern: string): ({paths.Path}?, string?)
    createTemporaryFile: function(options: TemporaryOptions?): (affine(TemporaryPath?), string?)
    createTemporaryDirectory: function(options: TemporaryOptions?): (affine(TemporaryPath?), string?)
end
type Files.Path = string
type Files.TemporaryOptions = TemporaryOptions
type Files.TemporaryPath = TemporaryPath
return Files
