-- The URI parser the VM's URI provider is written over.
local type RawParts = {
    text: string,
    scheme: string,
    authority: string?,
    username: string,
    password: string?,
    host: string?,
    path: string,
    query: string?,
    fragment: string?,
    port: integer?
}
local record Host
    parse: function(text: string): (RawParts?, string?)
end
return Host
