module nupp.experiment.runtime

-- The restricted producer of the synthetic ABI pilot (`handlers.nupp`),
-- which `runtime_tail` reads as JSON. The handler slice itself is ordinary
-- Nupp compiled by `nupp.experiment.lower` in handler mode.

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local fs = require("nupp.compiler.fs")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local json = require("nupp.codec.json")

local INTRINSICS = "nupp.runtime.internal.native"
local intrinsics = {
    loadFloat = 2,
    storeFloat = 3,
    bits = 1,
    fromBits = 1,
    pointer = 1,
    floor = 1,
    neg = 1,
    toFloat = 1,
    toInt = 1,
    both = 2,
    either = 2,
    chooseWord = 3,
    unsignedFloat = 1,
    unsignedInt = 1,
    index = 1,
    word = 1,
    address = 1,
    chooseIndex = 3,
    asWord = 1,
    layout = 1,
    slow = 6,
    reenter = 0,
    load8 = 2,
    load32 = 2,
    load64 = 2,
    loadIndex = 2,
    loadPointer = 2,
    store32 = 3,
    store64 = 3,
    storeIndex = 3,
    storePointer = 3,
    fillWords = 4,
    copyWords = 5,
    offset = 2,
    dispatch = 6,
    helper = 5
}
-- Intrinsics with an effect or a transfer: statements, never operands.
local effects = {dispatch = true, slow = true, reenter = true, helper = true, fillWords = true, copyWords = true}
local transfers = {dispatch = true, slow = true, reenter = true}
local binary = {
    ["<<"] = "shl",
    [">>"] = "shr",
    ["+"] = "add",
    ["-"] = "sub",
    ["*"] = "mul",
    ["/"] = "div",
    ["~"] = "xor",
    ["&"] = "and",
    ["|"] = "or",
    ["=="] = "eq",
    ["~="] = "ne",
    ["<"] = "lt",
    ["<="] = "le",
    [">"] = "lt",
    [">="] = "le"
}
-- The greater-than forms are the less-than forms with their operands swapped.
local swapped = {[">"] = true, [">="] = true}

local function need(ok: any, message: string): any
    assert(ok, "native runtime: " .. message)
    return ok
end

local function tag(t: any): string
    while t and t.tag == "literal" do
        t = t.base
    end
    return t and t.tag or "missing"
end

local function nativeCall(node: any): string
    local callee = need(node.obj, "callee")
    need(callee.kind == "dotIndex" and callee.obj.kind == "name", "direct intrinsic call required")
    local definition = callee.obj.token.definition
    need(definition and definition.requiredModule == INTRINSICS, "call must resolve to the private native module")
    local name = callee.name.text
    need(intrinsics[name] ~= nil, "unknown intrinsic " .. name)
    need(#node.args.exprs == intrinsics[name], "intrinsic arity")

    return name
end

-- A local function with the handler signature, six pointer parameters, is a
-- handler. Any other local function is a helper: never emitted on its own,
-- reached only as `return helper(...)`, where its body is inlined with the
-- arguments bound to its parameters. The dispatch stays a tail transfer; the
-- checker types the call as any other.
local function isHelper(node: any): boolean
    local params = node.body.params
    if #params ~= 6 then
        return true
    end
    for _, param in ipairs(params) do
        if not param.type or tag(param.type.resolvedType) ~= "voidptr" then
            return true
        end
    end

    return false
end

local function plainFunction(body: any, what: string): nil
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain " .. what .. " required")
    need(
        body.signatureType and #body.signatureType.rets == 1 and tag(body.signatureType.rets[1]) == "uint64",
        what .. " returns uint64"
    )
end

local function compileFunction(node: any, eager: boolean, helpers: any): any
    local body = node.body
    plainFunction(body, "function")
    need(#body.params == 6, "handler requires six pointer parameters")
    local bindings, instructions = {}, {}
    local id, label = 6, 0
    local inlining = {}
    for index, param in ipairs(body.params) do
        need(param.type and tag(param.type.resolvedType) == "voidptr", "native pointer parameter required")
        bindings[need(param.name, "parameter name").text] = index
    end

    local function emit(op: string, args: any, result: boolean): number
        local target = 0
        if result then
            id = id + 1
            target = id
        end
        instructions[#instructions + 1] = {op = op, args = args, result = target}

        return target
    end

    local expression
    expression = function(n: any): number
        if n.kind == "paren" then
            return expression(n.expr)
        elseif n.kind == "name" then
            return need(bindings[n.token.text], "capture or unknown local " .. n.token.text)
        elseif n.kind == "number" then
            local digits = n.token.text:gsub("[Uu]?[Ll][Ll]$", "")
            need(digits:match("^%d+$"), "decimal integer literal required")
            return emit("constant", {digits}, true)
        elseif n.kind == "unop" and n.op.text == "-" and n.operand.kind == "number" then
            need(n.operand.token.text:match("^%d+$"), "integer literal required")
            return emit("constant", {"-" .. n.operand.token.text}, true)
        elseif n.kind == "binop" then
            local op = need(binary[n.op.text], "unsupported binary operator")
            local lhs, rhs = n.lhs, n.rhs
            if swapped[n.op.text] then
                lhs, rhs = rhs, lhs
            end
            local left, right = tag(lhs.inferredType), tag(rhs.inferredType)
            if left == "number" and right == "number" and not (lhs.kind == "number" and rhs.kind == "number") then
                need(
                    op == "add"
                    or op == "sub"
                    or op == "mul"
                    or op == "div"
                    or op == "eq"
                    or op == "ne"
                    or op == "lt"
                    or op == "le",
                    "unsupported float operator"
                )
                return emit("f" .. op, {expression(lhs), expression(rhs)}, true)
            end
            need(op ~= "div", "integer division outside native subset")
            local wide = left == "int64" or left == "uint64" or right == "int64" or right == "uint64"
            need(wide, "binary operands require established 64-bit values")
            need(left == right or lhs.kind == "number" or rhs.kind == "number", "mixed integer representations")
            need(
                tag(n.inferredType) == "int64" or tag(n.inferredType) == "uint64" or tag(n.inferredType) == "boolean",
                "native operator must preserve its checked representation"
            )
            if op == "lt" or op == "le" then
                op = (left == "uint64" or right == "uint64") and "u" .. op or "s" .. op
            end
            return emit(op, {expression(lhs), expression(rhs)}, true)
        elseif n.kind == "call" then
            local name = nativeCall(n)
            if name == "layout" then
                local arg = n.args.exprs[1]
                need(arg.kind == "string", "literal layout field required")
                return emit("layout", {arg.token.value or arg.token.text:sub(2, -2)}, true)
            end
            need(not effects[name] and name:sub(1, 5) ~= "store", "effect or transfer used as a value")
            local args = {}
            for index, arg in ipairs(n.args.exprs) do
                args[index] = expression(arg)
            end
            return emit(name, args, true)
        end
        error("native runtime: unsupported expression " .. tostring(n.kind), 0)
    end

    -- Conditions contain only pure native expressions and nontrapping loads.
    -- Branch directly through conjunctions instead of materializing booleans
    -- that are immediately consumed by a branch. Value uses remain eager.
    local condition
    condition = function(n: any, yes: number, no: number): nil
        if n.kind == "paren" then
            condition(n.expr, yes, no)
        elseif not eager and n.kind == "call" and (nativeCall(n) == "both" or nativeCall(n) == "either") then
            local conjunction = nativeCall(n) == "both"
            label = label + 1
            local nextLabel = label
            if conjunction then
                condition(n.args.exprs[1], nextLabel, no)
            else
                condition(n.args.exprs[1], yes, nextLabel)
            end
            emit("block", {nextLabel}, false)
            condition(n.args.exprs[2], yes, no)
        else
            emit("branch", {expression(n), yes, no}, false)
        end
    end

    local statements
    local inlineHelper
    inlineHelper = function(helper: any, call: any): nil
        local name = helper.name.text
        need(not inlining[name], "recursive helper " .. name)
        local helperBody = helper.body
        plainFunction(helperBody, "helper")
        need(#call.args.exprs == #helperBody.params, "helper arity")
        local values = {}
        for index, arg in ipairs(call.args.exprs) do
            values[index] = expression(arg)
        end
        local saved = bindings
        bindings = {}
        for index, param in ipairs(helperBody.params) do
            local kind = tag(param.type and param.type.resolvedType)
            need(kind == "voidptr" or kind == "int64" or kind == "uint64", "helper parameter must be a native word")
            bindings[need(param.name, "helper parameter name").text] = values[index]
        end
        inlining[name] = true
        statements(helperBody.body.stats)
        inlining[name] = nil
        bindings = saved
    end
    statements = function(stats: any): nil
        local terminated = false
        for _, stat in ipairs(stats) do
            need(not terminated, "unreachable statement")
            if stat.kind == "localStmt" then
                need(#stat.names == 1 and #stat.exprs == 1, "single initialized local required")
                local name = stat.names[1].text
                need(not bindings[name], "shadowing outside initial native subset")
                bindings[name] = expression(stat.exprs[1])
            elseif stat.kind == "callStmt" then
                local name = nativeCall(stat.expr)
                need(
                    name:sub(1, 5) == "store" or (effects[name] and not transfers[name]),
                    "only explicit stores and helpers may be statements"
                )
                local args = {}
                for index, arg in ipairs(stat.expr.args.exprs) do
                    args[index] = expression(arg)
                end
                emit(name, args, false)
            elseif stat.kind == "returnStmt" then
                need(#stat.exprs == 1, "single return required")
                local value = stat.exprs[1]
                local callee = value.kind == "call" and value.obj.kind == "name" and helpers[value.obj.token.text]
                if callee then
                    inlineHelper(callee, value)
                elseif value.kind == "call" and transfers[nativeCall(value)] then
                    local args = {}
                    for index, arg in ipairs(value.args.exprs) do
                        args[index] = expression(arg)
                    end
                    emit(nativeCall(value), args, false)
                else
                    emit("return", {expression(value)}, false)
                end
                terminated = true
            elseif stat.kind == "ifStmt" then
                need(
                    #stat.clauses == 1 and not stat.clauses[1].binding and stat.elseClause,
                    "native if requires two terminating branches"
                )
                label = label + 2
                local yes, no = label - 1, label
                condition(stat.clauses[1].cond, yes, no)
                local saved = {}
                for name, value in pairs(bindings) do
                    saved[name] = value
                end
                emit("block", {yes}, false)
                statements(stat.clauses[1].body.stats)
                bindings = saved
                emit("block", {no}, false)
                statements(stat.elseClause.body.stats)
                terminated = true
            elseif stat.kind ~= "emptyStmt" then
                error("native runtime: unsupported statement " .. tostring(stat.kind), 0)
            end
        end
        need(terminated, "native handler may not fall through")
    end

    statements(body.body.stats)

    return {name = node.name.text, instructions = instructions, values = id}
end

export function compile(root: string, path: string, mode: string?): string
    need(mode == nil or mode == "eager", "unknown condition mode")
    trivia.installDefault(provider)
    local env = environment.new(root, {cache = false, config = {include = {"lib"}}})
    local parsed = parser.parse(assert(fs.readFile(path)), path)
    need(#parsed.errors == 0, "parse failed")
    local diagnostics = checker.check(parsed, path, env as any, {})
    for _, diagnostic in ipairs(diagnostics) do
        if diagnostic.severity == "error" or not diagnostic.severity then
            error(tostring(diagnostic.code) .. ": " .. tostring(diagnostic.msg), 0)
        end
    end
    local functions, names, helpers = {}, {}, {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local node: any = stat
            if node.kind == "localFuncStmt" then
                need(not names[node.name.text], "duplicate function")
                names[node.name.text] = true
                if isHelper(node) then
                    helpers[node.name.text] = node
                else
                    functions[#functions + 1] = compileFunction(node, mode == "eager", helpers)
                end
            elseif node.kind == "localStmt" then
                need(#node.names == 1 and #node.exprs == 1 and node.isConst, "one constant intrinsic import required")
                local value = node.exprs[1]
                need(
                    value.kind == "call" and value.obj.kind == "name" and value.obj.token.text == "require",
                    "module initialization is not native code"
                )
                need(
                    node.names[1].definition and node.names[1].definition.requiredModule == INTRINSICS,
                    "private intrinsic import required"
                )
            elseif node.kind ~= "moduleStmt" and node.kind ~= "emptyStmt" then
                error("native runtime: unsupported top-level statement " .. tostring(node.kind), 0)
            end
        end
    end
    need(#functions > 0, "no handlers")

    return json.encode({format = "nupp-native-runtime-1", functions = functions})
end
