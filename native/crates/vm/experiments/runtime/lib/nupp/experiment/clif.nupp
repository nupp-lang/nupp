module nupp.experiment.clif

-- Prints a native-runtime function as Cranelift's textual IR (CLIF), for the
-- frame-derived handler layout: six i64 parameters in the tail calling
-- convention, the frame derived from the boxed window, the dispatch table in
-- the sixth register. `cranelift-reader` parses the text and the shim compiles
-- it, so the IR a handler compiles to is decided here and nowhere in Rust.

local function need(ok: any, message: string): any
    assert(ok, "clif: " .. message)
    return ok
end

-- Operations whose result is a 64-bit float, and those whose result is an i8
-- condition; everything else yields an i64 word.
local floats = {
    loadFloat = true,
    fromBits = true,
    floor = true,
    neg = true,
    toFloat = true,
    unsignedFloat = true,
    fadd = true,
    fsub = true,
    fmul = true,
    fdiv = true
}
local conditions = {
    both = true,
    either = true,
    feq = true,
    fne = true,
    flt = true,
    fle = true,
    eq = true,
    ne = true,
    slt = true,
    sle = true,
    ult = true,
    ule = true
}
local intCompare = {eq = "eq", ne = "ne", slt = "slt", sle = "sle", ult = "ult", ule = "ule"}
local floatCompare = {feq = "eq", fne = "ne", flt = "lt", fle = "le"}
local binary = {
    shl = "ishl",
    shr = "ushr",
    add = "iadd",
    offset = "iadd",
    sub = "isub",
    mul = "imul",
    xor = "bxor",
    ["and"] = "band",
    ["or"] = "bor",
    both = "band",
    either = "bor",
    fadd = "fadd",
    fsub = "fsub",
    fmul = "fmul",
    fdiv = "fdiv"
}
local unary = {
    bits = "bitcast.i64",
    fromBits = "bitcast.f64",
    unsignedFloat = "fcvt_from_uint.f64",
    unsignedInt = "fcvt_to_uint_sat.i64",
    floor = "floor",
    neg = "fneg",
    toFloat = "fcvt_from_sint.f64",
    toInt = "fcvt_to_sint_sat.i64",
    asWord = "uextend.i64"
}

export function print(fn: any, layout: function(string): number): string
    local out = {}

    local function line(text: string): nil
        out[#out + 1] = text
    end

    local values = {}
    local types = {}
    local next = 0

    local function fresh(kind: string): string
        local name = "v" .. tostring(next)
        next = next + 1
        types[name] = kind
        return name
    end

    local function bind(id: number, name: string): nil
        values[id] = name
    end

    local function value(id: number): string
        return need(values[id], "undefined operand " .. tostring(id))
    end

    local function kind(name: string): string
        return need(types[name], "untyped value " .. name)
    end

    local maxLabel = 0
    for _, ins in ipairs(fn.instructions) do
        if ins.op == "block" then
            maxLabel = math.max(maxLabel, ins.args[1])
        end
    end
    local blocks = maxLabel

    local function block(): string
        blocks = blocks + 1
        return "block" .. tostring(blocks)
    end

    line("function %" .. fn.name .. "(i64, i64, i64, i64, i64, i64) -> i64 tail {")
    line("    sig0 = (i64, i64, i64, i64, i64, i64) -> i64 tail")
    line("")
    local params = {}
    for index = 1, 6 do
        params[index] = fresh("i64")
    end
    line(
        "block0(" .. table.concat(
            {
                params[1] .. ": i64",
                params[2] .. ": i64",
                params[3] .. ": i64",
                params[4] .. ": i64",
                params[5] .. ": i64",
                params[6] .. ": i64"
            },
            ", "
        ) .. "):"
    )
    -- The logical parameters: pc, the three windows, the context, and the
    -- frame derived from the boxed window. The physical sixth register is the
    -- dispatch table.
    for index = 1, 5 do
        bind(index, params[index])
    end

    local function constant(text: string): string
        local name = fresh("i64")
        line("    " .. name .. " = iconst.i64 " .. text)
        return name
    end

    local function plus(left: string, right: string): string
        local sum = fresh("i64")
        line("    " .. sum .. " = iadd " .. left .. ", " .. right)
        return sum
    end

    local frame = plus(params[2], constant("-32"))
    bind(6, frame)
    local tableValue = params[6]

    local function emit(ins: any, text: string, kind: string): nil
        local result = fresh(kind)
        line("    " .. result .. " = " .. text)
        bind(ins.result, result)
    end

    local function address(ins: any): string
        local sum = fresh("i64")
        line("    " .. sum .. " = iadd " .. value(ins.args[1]) .. ", " .. value(ins.args[2]))
        return sum
    end

    for _, ins in ipairs(fn.instructions) do
        local op = ins.op
        if op == "block" then
            line("")
            line("block" .. tostring(ins.args[1]) .. ":")
        elseif op == "constant" then
            emit(ins, "iconst.i64 " .. ins.args[1], "i64")
        elseif op == "layout" then
            emit(ins, "iconst.i64 " .. tostring(layout(ins.args[1])), "i64")
        elseif op == "loadFloat" then
            emit(ins, "load.f64 notrap " .. address(ins), "f64")
        elseif op == "load8" then
            emit(ins, "uload8.i64 notrap " .. address(ins), "i64")
        elseif op == "load32" then
            emit(ins, "sload32 notrap " .. address(ins), "i64")
        elseif op == "load64" or op == "loadIndex" or op == "loadPointer" then
            emit(ins, "load.i64 notrap " .. address(ins), "i64")
        elseif op == "storeFloat" or op == "store64" or op == "storeIndex" or op == "storePointer" then
            local at = address(ins)
            line("    store notrap " .. value(ins.args[3]) .. ", " .. at)
        elseif op == "store32" then
            local at = address(ins)
            line("    istore32 notrap " .. value(ins.args[3]) .. ", " .. at)
        elseif op == "fillWords" or op == "copyWords" then
            -- A bounded word loop: zero or fewer words stores nothing.
            local copy = op == "copyWords"
            local target = address(ins)
            local source, count, fill = nil, nil, nil
            if copy then
                source = fresh("i64")
                line("    " .. source .. " = iadd " .. value(ins.args[3]) .. ", " .. value(ins.args[4]))
                count = value(ins.args[5])
            else
                count = value(ins.args[3])
                fill = value(ins.args[4])
            end
            local header, body, exit = block(), block(), block()
            local zero = constant("0")
            line("    jump " .. header .. "(" .. zero .. ")")
            line("")
            local index = fresh("i64")
            line(header .. "(" .. index .. ": i64):")
            local done = fresh("i8")
            line("    " .. done .. " = icmp sge " .. index .. ", " .. count)
            line("    brif " .. done .. ", " .. exit .. ", " .. body)
            line("")
            line(body .. ":")
            local shifted = fresh("i64")
            line("    " .. shifted .. " = ishl " .. index .. ", " .. constant("3"))
            local word = fill
            if copy then
                local from = fresh("i64")
                line("    " .. from .. " = iadd " .. source .. ", " .. shifted)
                word = fresh("i64")
                line("    " .. word .. " = load.i64 notrap " .. from)
            end
            local to = fresh("i64")
            line("    " .. to .. " = iadd " .. target .. ", " .. shifted)
            line("    store notrap " .. word .. ", " .. to)
            local advanced = plus(index, constant("1"))
            line("    jump " .. header .. "(" .. advanced .. ")")
            line("")
            line(exit .. ":")
        elseif op == "chooseWord" or op == "chooseIndex" then
            emit(
                ins,
                "select " .. value(ins.args[1]) .. ", " .. value(ins.args[2]) .. ", " .. value(ins.args[3]),
                "i64"
            )
        elseif op == "pointer" or op == "address" or op == "word" or op == "index" then
            bind(ins.result, value(ins.args[1]))
        elseif unary[op] then
            emit(ins, unary[op] .. " " .. value(ins.args[1]), floats[op] and "f64" or "i64")
        elseif intCompare[op] then
            emit(ins, "icmp " .. intCompare[op] .. " " .. value(ins.args[1]) .. ", " .. value(ins.args[2]), "i8")
        elseif floatCompare[op] then
            emit(ins, "fcmp " .. floatCompare[op] .. " " .. value(ins.args[1]) .. ", " .. value(ins.args[2]), "i8")
        elseif binary[op] then
            local kind = floats[op] and "f64" or (conditions[op] and "i8" or "i64")
            emit(ins, binary[op] .. " " .. value(ins.args[1]) .. ", " .. value(ins.args[2]), kind)
        elseif op == "branch" then
            line(
                "    brif " .. value(
                    ins.args[1]
                ) .. ", block" .. tostring(ins.args[2]) .. ", block" .. tostring(ins.args[3])
            )
        elseif op == "return" or op == "slow" then
            line("    return " .. value(ins.args[1]))
        elseif op == "reenter" then
            line("    return " .. constant("1"))
        elseif op == "dispatch" then
            local opcode = fresh("i64")
            line("    " .. opcode .. " = uload8.i64 notrap " .. value(ins.args[1]))
            local shifted = fresh("i64")
            line("    " .. shifted .. " = ishl " .. opcode .. ", " .. constant("3"))
            local slot = plus(tableValue, shifted)
            local target = fresh("i64")
            line("    " .. target .. " = load.i64 notrap " .. slot)
            line(
                "    return_call_indirect sig0, " .. target .. "(" .. table.concat(
                    {
                        value(ins.args[1]),
                        value(ins.args[2]),
                        value(ins.args[3]),
                        value(ins.args[4]),
                        value(ins.args[5]),
                        tableValue
                    },
                    ", "
                ) .. ")"
            )
        elseif op == "helper" then
            error("clif: helpers are not part of the handler slice", 0)
        else
            error("clif: unknown operation " .. tostring(op), 0)
        end
    end
    line("}")
    line("")

    return table.concat(out, "\n")
end
