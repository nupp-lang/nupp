-- Calls and returns. A frame transition stays native when the frame driver
-- has nothing to do at it: outside frame mode always, and in frame mode when
-- the function entered or resumed has no compiled frame entry, no vector
-- instructions, and no JIT counting its frames. Otherwise the native chain
-- leaves with `reenter`, and Rust's `tail_entry` applies the policy to the
-- frame the chain has already pushed or popped, exactly as the Rust call and
-- return handlers do. Growth, varargs, builtins, iterators, compiled entries,
-- the JIT's call threshold, guarded returns, and feedback all leave through
-- `slow` before any state changes, so the Rust handler runs the instruction
-- once from the state it would have seen.

-- The callee's frame is in place and the context names it: continue there,
-- or hand it to the frame driver.
local function enterPushed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64
): uint64
    local mode = native.load32(context, native.layout("frame_mode"))
    local code = native.loadPointer(callee, native.layout("FuncInfo.code"))
    local calleeRegs = native.offset(frame, 32)
    local calleeInts = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_i")) * 8)
    local calleeFloats = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_f")) * 8)
    if mode == 0 then
        return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
    else
        if native.either(
            native.load32(callee, native.layout("FuncInfo.native")) ~= 0,
            native.load32(context, native.layout("jit_frames")) ~= 0
        ) then
            return native.reenter()
        else
            -- The frame entry table is absent, not empty, when nothing is
            -- compiled: it is read only below its recorded length.
            if fid < native.load64(context, native.layout("nframe_entries")) then
                local entry = native.load64(
                    native.loadPointer(context, native.layout("frame_entries")),
                    native.index(fid) * 8
                )
                if entry ~= 0 then
                    return native.reenter()
                else
                    return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
                end
            else
                return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
            end
        end
    end
end

-- The Rust core's `count_call` and `push`: the callee's frame goes above the
-- caller's, `supplied` argument words copied from the argument window and the
-- remaining parameters nil, and the caller's header remembers where to
-- resume. Capacity is checked before the call count moves so a growing call
-- counts exactly once, in Rust; the call that reaches the threshold is left
-- uncounted for Rust as well.
local function pushFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64,
    closure: uint64,
    base: int64,
    supplied: int64
): uint64
    local current = native.load64(context, native.layout("cur"))
    local next = current + ((native.load64(frame, 24) >> 33) & 65535)
    local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & 4294967295
    if next + words > native.load64(context, native.layout("cap")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local threshold = native.load32(context, native.layout("jit_threshold"))
        local calls = native.load32(callee, native.layout("FuncInfo.calls"))
        local counting = native.both(threshold ~= 0, calls < threshold)
        local counted = calls + native.chooseIndex(counting, 1, 0)
        if native.both(counting, counted == threshold) then
            -- The call that makes the function hot is Rust's: its own count
            -- reaches the threshold and hands the call to the interpreter,
            -- which compiles the function.
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            native.store32(callee, native.layout("FuncInfo.calls"), counted)
            local caller = native.loadPointer(
                native.loadPointer(context, native.layout("funcs")),
                native.index(
                    native.load64(frame, 0) & 4294967295
                ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
            )
            local resume = ((native.address(pc) - native.address(caller)) >> 4) + 1
            native.store64(frame, 0, (native.load64(frame, 0) & 4294967295) | (resume << 32))
            local stack = native.loadPointer(context, native.layout("stack"))
            local pushed = native.offset(stack, native.index(next * 8))
            local arguments = current + 4 + native.word(base)
            local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
            native.store64(pushed, 0, fid)
            native.store64(pushed, 8, current | (arguments << 32))
            native.store64(pushed, 16, closure)
            native.store64(pushed, 24, words << 33)
            native.copyWords(pushed, 40, stack, native.index((arguments + 1) * 8), supplied)
            native.fillWords(pushed, (5 + supplied) * 8, nparams - supplied, 9221401712017801216ULL)
            native.store64(context, native.layout("cur"), next)
            return enterPushed(pc, regs, ints, floats, context, pushed, callee, fid)
        end
    end
end

-- The Rust core's `dynamic_call!` once the callee is a known function id:
-- varargs, typed parameters, the unavailable function and compiled entries
-- stay in Rust.
local function dynamicCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    fid: uint64,
    closure: uint64,
    nargs: int64
): uint64
    if fid >= native.load64(context, native.layout("nfuncs")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local callee = native.offset(
            native.loadPointer(context, native.layout("funcs")),
            native.index(fid) * native.layout("FuncInfo.size")
        )
        if native.either(
            native.either(
                native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0,
                native.load32(callee, native.layout("FuncInfo.typed")) ~= 0
            ),
            fid == native.word(native.load32(context, native.layout("unavailable_fid")) & 4294967295)
        ) then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local base = native.load8(pc, 2)
            local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
            local supplied = native.chooseIndex(nargs < nparams, nargs, nparams)
            if native.load32(context, native.layout("frame_mode")) == 0 then
                local entry = native.load64(
                    native.loadPointer(context, native.layout("entries")),
                    native.index(fid) * 8
                )
                if entry ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                else
                    return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, closure, base, supplied)
                end
            else
                return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, closure, base, supplied)
            end
        end
    end
end

-- A static call copies every argument word, as its Rust handler does.
local function Call(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local fid = native.load64(pc, 8)
    local nargs = native.load8(pc, 2)
    local callee = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(fid) * native.layout("FuncInfo.size")
    )
    if native.either(native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0, nargs >= 64) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        return pushFrame(
            pc,
            regs,
            ints,
            floats,
            context,
            frame,
            callee,
            fid,
            9221401712017801216ULL,
            native.load8(pc, 1),
            nargs
        )
    end
end

-- CallK and CallDyn share this body, as their Rust handlers share one.
local function CallK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local nargs = native.load8(pc, 3)
    local value = native.load64(regs, native.load8(pc, 1) * 8)
    if native.either(native.load32(context, native.layout("feedback")) ~= 0, nargs >= 64) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        if value & 9223090561878065152ULL == 9222527611924643840ULL then
            local object = native.pointer(value & 281474976710655ULL)
            if native.load8(object, native.layout("Header.kind")) == 5 then
                return dynamicCall(
                    pc,
                    regs,
                    ints,
                    floats,
                    context,
                    frame,
                    native.word(native.load32(object, native.layout("Header.aux")) & 4294967295),
                    value,
                    nargs
                )
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            if native.both(value & 9223090561878065152ULL == 9222246136947933184ULL, (value >> 32) & 65535 == 0) then
                return dynamicCall(
                    pc,
                    regs,
                    ints,
                    floats,
                    context,
                    frame,
                    value & 4294967295,
                    9221401712017801216ULL,
                    nargs
                )
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        end
    end
end

-- The caller's frame is on top again and the context names it: resume at
-- the instruction after its call, or hand a function with vector
-- instructions to the frame driver, which revalidates it.
local function resumeCaller(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    caller: uint64
): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local resumed = native.offset(stack, native.index(caller * 8))
    local header = native.load64(resumed, 0)
    local callerInfo = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(header & 4294967295) * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(callerInfo, native.layout("FuncInfo.code"))
    local callerPc = native.offset(code, native.index((header >> 32) * 16))
    local callerRegs = native.offset(resumed, 32)
    local callerInts = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_i")) * 8)
    local callerFloats = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_f")) * 8)
    if native.both(
        native.load32(context, native.layout("frame_mode")) ~= 0,
        native.load32(callerInfo, native.layout("FuncInfo.native")) ~= 0
    ) then
        return native.reenter()
    else
        return native.dispatch(callerPc, callerRegs, callerInts, callerFloats, context, resumed)
    end
end

-- A return the Rust path must take: a cleanup or protected call at or above
-- this frame, an unwind in progress, or the task's own end.
local function Ret(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & 4294967295
    if native.either(native.both(guard ~= 18446744073709551615ULL, guard >= current), caller == 4294967295) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local value = native.load64(regs, native.load8(pc, 1) * 8)
        local flags = native.load64(frame, 24)
        local slot = native.chooseWord((flags >> 32) & 1 ~= 0, flags & 4294967295, link >> 32)
        native.store64(context, native.layout("result"), value)
        native.store64(native.loadPointer(context, native.layout("stack")), native.index(slot * 8), value)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 1)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

local function RetNil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & 4294967295
    if native.either(native.both(guard ~= 18446744073709551615ULL, guard >= current), caller == 4294967295) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        native.store64(
            native.loadPointer(context, native.layout("stack")),
            native.index((link >> 32) * 8),
            9221401712017801216ULL
        )
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 0)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

local function RetN(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local count = native.load8(pc, 2)
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & 4294967295
    if native.either(
        native.either(count > 8, native.both(guard ~= 18446744073709551615ULL, guard >= current)),
        caller == 4294967295
    ) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local stack = native.loadPointer(context, native.layout("stack"))
        local results = native.index((link >> 32) * 8)
        native.copyWords(stack, results, regs, native.load8(pc, 1) * 8, count)
        native.fillWords(stack, results, native.chooseIndex(count == 0, 1, 0), 9221401712017801216ULL)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), native.word(count))
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

local function PadResults(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local wanted = native.load8(pc, 2)
    if wanted > 8 then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local delivered = native.loadIndex(context, native.layout("last_nres"))
        native.fillWords(regs, (native.load8(pc, 1) + delivered) * 8, wanted - delivered, 9221401712017801216ULL)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end
