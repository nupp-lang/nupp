        native.storeFloat(floats, a, native.fromBits(bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        if bits == 9221120237041090560ULL then
            native.storeFloat(floats, a, native.fromBits(bits))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    end
end

local function GetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & 9223090561878065152ULL == 9222527611924643840ULL then
        local object = native.pointer(bits & 281474976710655ULL)
        if native.load8(object, native.layout("Header.kind")) == 6 then
            local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
            native.store64(regs, a, native.load64(data, 0))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

local function Add(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & 9221120237041090560ULL ~= 9221120237041090560ULL, x == 9221120237041090560ULL),
        native.either(y & 9221120237041090560ULL ~= 9221120237041090560ULL, y == 9221120237041090560ULL)
    ) then
        local p = native.fromBits(x)
        local q = native.fromBits(y)
        local bits = native.bits(p + q)
        native.store64(
            regs,
            a,
            native.chooseWord(bits & 9221120237041090560ULL == 9221120237041090560ULL, 9221120237041090560ULL, bits)
        )
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

