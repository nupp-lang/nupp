        if native.load8(header, native.layout("Header.kind")) ~= 6 then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
            if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                return barrierStoreSlow(pc, context, cell, value, data, 0)
            else
                native.store64(data, 0, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        end
    end
end

-- A record slot store under the same guards as its read, plus the storage
-- flags that make a record something other than plain slots.
local function SetSlot(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local value = native.load64(regs, native.load8(pc, 3) * 8)
    if object & 9223090561878065152ULL ~= 9222527611924643840ULL then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & 281474976710655ULL)
        local flags = native.load8(header, native.layout("Header.flags"))
        local at = native.load8(pc, 2) * 8
        local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
        if native.both(
            native.both(native.load8(header, native.layout("Header.kind")) == 3, flags & 160 == 0),
            native.load32(header, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            if native.both(flags & 4 ~= 0, native.load64(data, at) == 9221401712017801216ULL) then
                return native.slow(pc, regs, ints, floats, context, frame)
            elseif native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                return barrierStoreSlow(pc, context, object, value, data, at)
            else
                native.store64(data, at, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    end
end

local function SetSlotF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local value = native.loadFloat(floats, native.load8(pc, 3) * 8)
    if object & 9223090561878065152ULL ~= 9222527611924643840ULL then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & 281474976710655ULL)
        local flags = native.load8(header, native.layout("Header.flags"))
        local at = native.load8(pc, 2) * 8
        local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
        if native.both(
            native.both(native.load8(header, native.layout("Header.kind")) == 3, flags & 160 == 0),
            native.load32(header, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            if native.both(flags & 4 ~= 0, native.load64(data, at) == 9221401712017801216ULL) then
                return native.slow(pc, regs, ints, floats, context, frame)
            else
                -- A NaN payload is boxed as the canonical quiet NaN.
                local bits = native.bits(value)
                local nan = native.both(
                    bits & 9221120237041090560ULL == 9221120237041090560ULL,
                    bits ~= 9221120237041090560ULL
                )
                native.store64(data, at, native.chooseWord(nan, 9221120237041090560ULL, bits))
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    end
end

local function TagCheckNum(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = native.load64(regs, native.load8(pc, 2) * 8)
    if native.either(value & 9221120237041090560ULL ~= 9221120237041090560ULL, value == 9221120237041090560ULL) then
        native.store64(regs, native.load8(pc, 1) * 8, value)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

local function IBox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = native.loadIndex(ints, native.load8(pc, 2) * 8)
    if native.either(value < -9007199254740992, 9007199254740992 < value) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        native.store64(regs, native.load8(pc, 1) * 8, native.bits(native.toFloat(value)))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

local function IUnbox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = native.load64(regs, native.load8(pc, 2) * 8)
    if native.either(value & 9221120237041090560ULL ~= 9221120237041090560ULL, value == 9221120237041090560ULL) then
        local d = native.fromBits(value)
        if native.both(native.both(-9223372036854775808.0 <= d, d < 9223372036854775808.0), native.floor(d) == d) then
            native.storeIndex(ints, native.load8(pc, 1) * 8, native.toInt(d))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

local function StrByte(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 2) * 8)
    local position = native.loadIndex(ints, native.load8(pc, 3) * 8)
    if object & 9223090561878065152ULL ~= 9222527611924643840ULL then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & 281474976710655ULL)
        local kind = native.load8(header, native.layout("Header.kind"))
        if native.either(native.both(kind ~= 1, kind ~= 9), position < 0) then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local a = native.load8(pc, 1) * 8
            if native.both(
                position >= 1,
                native.word(position) <= native.load64(header, native.layout("Header.aux_len"))
            ) then
                local byte = native.load8(native.loadPointer(header, native.layout("Header.aux_ptr")), position - 1)
                native.store64(regs, a, native.bits(native.toFloat(byte)))
            else
                native.store64(regs, a, 9221401712017801216ULL)
            end
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        end
    end
end

-- A record allocation: the collector may run, so the frame is published
-- before and the windows derived again after.
local function NewRecord(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    publishPc(pc, context)
    local value = native.newRecord(context, native.loadIndex(pc, 8))
    return continueAfter(pc, context, native.load8(pc, 1), value, true)
end
