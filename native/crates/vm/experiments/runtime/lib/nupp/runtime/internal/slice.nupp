    end
end

local function Mul(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
