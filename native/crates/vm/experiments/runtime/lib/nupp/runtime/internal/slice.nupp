local function ICmpEq(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(ints, b)
    local y = native.load64(ints, c)
    native.store64(ints, a, native.asWord(x == y))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function ICmpNe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(ints, b)
    local y = native.load64(ints, c)
    native.store64(ints, a, native.asWord(x ~= y))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

