            end
        end
    end
end

-- A static call copies every argument word, as its Rust handler does.
local function Call(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local fid = native.load64(pc, 8)
