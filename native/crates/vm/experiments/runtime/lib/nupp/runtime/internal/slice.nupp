-- A return the Rust path must take: a cleanup or protected call at or above
-- this frame, an unwind in progress, or the task's own end.
local function Ret(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
