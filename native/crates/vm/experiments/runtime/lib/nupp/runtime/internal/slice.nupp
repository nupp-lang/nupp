module nupp.runtime.internal.slice

-- Leaf-only production-state experiment. Unsupported instructions and OSR
-- return to the Rust core before any helper can move a frame or collect.
const native = require("nupp.runtime.internal.native")

local function Move(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    native.store64(regs, a, native.load64(regs, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function Nil(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    native.store64(regs, a, 9221401712017801216ULL)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

