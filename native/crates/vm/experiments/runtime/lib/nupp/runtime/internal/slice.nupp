-- Calls and returns. A frame transition stays native when the frame driver
-- has nothing to do at it: outside frame mode always, and in frame mode when
-- the function entered or resumed has no compiled frame entry, no vector
-- instructions, and no JIT counting its frames. Otherwise the native chain
-- leaves with `reenter`, and Rust's `tail_entry` applies the policy to the
-- frame the chain has already pushed or popped, exactly as the Rust call and
-- return handlers do. Growth, varargs, builtins, iterators, compiled entries,
-- the JIT's call threshold, guarded returns, and feedback all leave through
-- `slow` before any state changes, so the Rust handler runs the instruction
-- once from the state it would have seen.

-- The callee's frame is in place and the context names it: continue there,
-- or hand it to the frame driver.
local function enterPushed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64
): uint64
    local mode = native.load32(context, native.layout("frame_mode"))
    local code = native.loadPointer(callee, native.layout("FuncInfo.code"))
    local calleeRegs = native.offset(frame, 32)
    local calleeInts = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_i")) * 8)
    local calleeFloats = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_f")) * 8)
    if mode == 0 then
        return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
    else
        if native.either(
            native.load32(callee, native.layout("FuncInfo.native")) ~= 0,
            native.load32(context, native.layout("jit_frames")) ~= 0
        ) then
            return native.reenter()
        else
            -- The frame entry table is absent, not empty, when nothing is
            -- compiled: it is read only below its recorded length.
            if fid < native.load64(context, native.layout("nframe_entries")) then
                local entry = native.load64(
                    native.loadPointer(context, native.layout("frame_entries")),
                    native.index(fid) * 8
                )
                if entry ~= 0 then
                    return native.reenter()
                else
                    return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
                end
            else
                return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
            end
        end
    end
end

-- The Rust core's `count_call` and `push`: the callee's frame goes above the
-- caller's, `supplied` argument words copied from the argument window and the
-- remaining parameters nil, and the caller's header remembers where to
-- resume. Capacity is checked before the call count moves so a growing call
-- counts exactly once, in Rust; the call that reaches the threshold is left
-- uncounted for Rust as well.
local function pushFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64,
    closure: uint64,
    base: int64,
    supplied: int64
): uint64
    local current = native.load64(context, native.layout("cur"))
    local next = current + ((native.load64(frame, 24) >> 33) & 65535)
    local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & 4294967295
    if next + words > native.load64(context, native.layout("cap")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local threshold = native.load32(context, native.layout("jit_threshold"))
        local calls = native.load32(callee, native.layout("FuncInfo.calls"))
        local counting = native.both(threshold ~= 0, calls < threshold)
        local counted = calls + native.chooseIndex(counting, 1, 0)
        if native.both(counting, counted == threshold) then
            -- The call that makes the function hot is Rust's: its own count
            -- reaches the threshold and hands the call to the interpreter,
            -- which compiles the function.
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            native.store32(callee, native.layout("FuncInfo.calls"), counted)
            local caller = native.loadPointer(
                native.loadPointer(context, native.layout("funcs")),
                native.index(
                    native.load64(frame, 0) & 4294967295
                ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
            )
            local resume = ((native.address(pc) - native.address(caller)) >> 4) + 1
            native.store64(frame, 0, (native.load64(frame, 0) & 4294967295) | (resume << 32))
            local stack = native.loadPointer(context, native.layout("stack"))
            local pushed = native.offset(stack, native.index(next * 8))
            local arguments = current + 4 + native.word(base)
