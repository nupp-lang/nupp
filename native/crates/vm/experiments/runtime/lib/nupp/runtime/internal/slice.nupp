-- Helpers and the handlers that call them. A handler publishes the pc before a
-- Rust helper runs, since the helper notes it for backtraces and the
-- collector's liveness; afterwards it checks for a raise, re-derives its
-- windows from the context because the stack may have moved, and continues.
-- The calls live in `...Slow` support functions the handlers tail-call, so the
-- fast paths stay frameless.

local function publishPc(pc: voidptr, context: voidptr): nil
    local frame = native.offset(
        native.loadPointer(context, native.layout("stack")),
        native.index(native.load64(context, native.layout("cur")) * 8)
    )
    local code = native.loadPointer(
        native.loadPointer(context, native.layout("funcs")),
        native.index(
            native.load64(frame, 0) & 4294967295
        ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
    )
    native.store32(context, native.layout("pc"), native.index((native.address(pc) - native.address(code)) >> 4))
