local function FBox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.bits(native.loadFloat(floats, b))
    if bits & 9221120237041090560ULL == 9221120237041090560ULL then
        native.store64(regs, a, 9221120237041090560ULL)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        native.store64(regs, a, bits)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

