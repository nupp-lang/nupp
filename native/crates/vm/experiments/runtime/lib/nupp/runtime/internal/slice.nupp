local function IAddK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    native.store64(ints, a, native.load64(ints, b) + native.load64(pc, 8))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function IMaskU32(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    native.store64(ints, a, native.load64(ints, b) & 4294967295)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function IAdd(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(ints, b)
    local y = native.load64(ints, c)
    native.store64(ints, a, x + y)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

