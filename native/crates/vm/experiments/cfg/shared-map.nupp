local span = require("nupp.mem.span")

@aot(target = "gpu")
local function mapAdd(exclusive output: span.WriteSpan<uint32>, borrows input: span.Span<uint32>, seed: uint32): nil
    assert(#output == #input, "length mismatch")
    for i = 1, #output do
        output[i] = input[i] + seed
    end
end

@aot(target = "gpu")
local function mapDiamond(exclusive output: span.WriteSpan<uint32>, borrows input: span.Span<uint32>, seed: uint32): nil
    assert(#output == #input, "length mismatch")
    for i = 1, #output do
        local value = input[i]
        if value < seed then
            value = value + 4294967295
        else
            value = value - seed
        end
        output[i] = value
    end
end

@aot(target = "gpu")
local function mapRotate(exclusive output: span.WriteSpan<uint32>, borrows input: span.Span<uint32>, seed: uint32): nil
    assert(#output == #input, "length mismatch")
    for i = 1, #output do
        local a, b = input[i], seed
        local n: uint32 = 0
        while n < 3 do
            local previous = a
            a = b
            b = previous
            n = n + 1
        end
        output[i] = a - b
    end
end

return {mapAdd = mapAdd, mapDiamond = mapDiamond, mapRotate = mapRotate}
