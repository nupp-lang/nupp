local m = {}

function m.diamond(x: number): number
    local y = x
    if x < 0 then
        y = 0 - x
    else
        y = x + 3
    end

    return y * 2
end

function m.loop(n: number): number
    local i, total = 0, 0
    while i < n do
        if i < 5 then
            total = total + i
        else
            total = total - i
        end
        i = i + 1
    end

    return total
end

function m.swap(n: number): number
    local i, a, b = 0, 1, 2
    while i < n do
        a, b = b, a
        i = i + 1
    end

    return a * 10 + b
end

function m.bytes(s: string): number
    local i, total = 1, 0
    while i <= #s do
        total = total + (string.byte(s, i) or 0)
        i = i + 1
    end

    return total
end

function m.byte(s: string, i: number): number
    return string.byte(s, i) or 0
end

function m.suspend(n: number): number
    local i, total = 0, 0
    while i < n do
        total = total + i
        coroutine.yield(total)
        i = i + 1
    end

    return total
end

function m.early(x: number): number
    if x < 0 then
        return 0
    else
        local branchLocal = x + 1
        x = branchLocal
    end

    return x * 2
end

function m.nested(n: number): number
    local i, total = 0, 0
    while i < n do
        local j = 0
        while j < i do
            total = total + j
            j = j + 1
        end
        i = i + 1
    end

    return total
end

function m.rotate(n: number): number
    local i, a, b, c = 0, 1, 2, 3
    while i < n do
        a, b, c = b, c, a
        i = i + 1
    end

    return a * 100 + b * 10 + c
end

function m.suspendBytes(s: string): number
    local i, total = 1, 0
    while i <= #s do
        total = total + (string.byte(s, i) or 0)
        coroutine.yield(total)
        i = i + 1
    end

    return total
end

return m
