module nupp.core.extract

local parser = require("nupp.compiler.syntax.parser")
local check = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local lower = require("nupp.compiler.vm.lower")
local convert = require("nupp.compiler.vm.convert")
local program = require("nupp.core.program")
local json = require("nupp.codec.json")
local extract = {}

function extract.compile(source: string, selected: string): any
    local path = "=core-first-program.nupp"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0, "first program did not parse")
    local env = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = check.check(parsed, path, env as any, {
        moduleName = "core_fixture",
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    (parsed.root as any).vmModuleExports = (parsed as any).moduleExports
    local listings = {}
    local closed = false
    local extracted: any = nil
    local previousSink = lower.graphSink
    lower.graphSink = function(_: string, functions: any, _: any): nil
        for _, f in ipairs(functions) do
            if f.name == selected then
                assert(not closed, "ambiguous first-program function")
                assert(
                    f.parent ~= nil and f.nparams == 0 and not f.vararg and #f.upvals == 0,
                    "first program must be closed"
                )
                assert(not f.sig or #f.sig == 0, "first program has parameters")
                assert((f.ret or "v") == "v" and #f.consts == 0, "first program has boxed constants or return")
                assert(
                    not f.spillReg and not f.spillCount and (f.cleanupDepth or 0) == 0,
                    "first program has frame services"
                )
                local kept = convert.blocks(f)
                extracted = program.fromBlocks(kept)
                closed = true
            end
        end
    end
    local ok, failure = pcall(
        lower.emit,
        "core_fixture",
        {},
        function(name: string): string?
            return name == "core_fixture" and path or nil
        end,
        function(_: string, _: string): table
            return parsed.root
        end,
        nil,
        listings
    )
    lower.graphSink = previousSink
    assert(ok, failure)
    assert(closed, "checked first-program function was not inspected")
    local found = nil
    for _, listing in ipairs(listings) do
        if listing.name == selected then
            assert(found == nil, "ambiguous first-program function")
            found = assert(extracted);
            (found as any).listing = listing.image
        end
    end

    return assert(found, "missing first-program function")
end

function extract.image(source: string, selected: string): string
    return extract.compile(source, selected).code
end

function extract.inspect(source: string, selected: string): string
    local result = extract.compile(source, selected)
    local bytes = {}
    for i = 1, #result.code do
        bytes[i] = assert(result.code:byte(i))
    end

    return json.encode({
        name = result.name,
        slots = result.slots,
        count = result.count,
        result = result.result,
        returns = result.returns,
        listing = result.listing,
        bytes = bytes
    })
end

function extract.verifyData(bytes: string, codeBytes: string): boolean
    program.verifyData(bytes, assert(tonumber(codeBytes)) as integer)
    return true
end

function extract.data(code: string, slots: string, offsets: string, codeBytes: string): string
    local handlers = {}
    for offset in offsets:gmatch("[^,]+") do
        handlers[#handlers + 1] = assert(tonumber(offset))
    end

    return program.data(code, assert(tonumber(slots)) as integer, handlers, assert(tonumber(codeBytes)) as integer)
end

function extract.test(): integer
    local simple = program.encode({{"IK", 0, "9223372036854775807"}, {"IK", 1, 1}, {"IAdd", 2, 0, 1}}, 2)
    local handlers = {}
    for i = 1, #program.names do
        handlers[i] = (i - 1) * 4
    end
    local codeBytes = #program.names * 4
    local data = program.data(simple.code, simple.slots, handlers, codeBytes)
    program.verifyData(data, codeBytes)

    local function rejected(code: string, slots: integer): nil
        assert(not pcall(program.verify, code, slots), "malformed program was accepted")
    end

    rejected(simple.code:sub(2), simple.slots)
    rejected(string.char(255) .. simple.code:sub(2), simple.slots)
    rejected(simple.code, 2)
    rejected(simple.code:sub(1, -17), simple.slots)
    rejected(simple.code:sub(-16) .. simple.code, simple.slots)
    rejected(program.encode({{"IK", 0, 1}}, 0).code:gsub("^.", string.char(2)), 1)
    local padding = simple.code:sub(1, 4) .. string.char(1) .. simple.code:sub(6)
    rejected(padding, simple.slots)
    assert(not pcall(program.verifyData, data .. string.char(0), codeBytes))
    assert(not pcall(program.verifyData, data:sub(1, -2), codeBytes))
    assert(not pcall(program.verifyData, data, codeBytes - 4))
    assert(not pcall(program.fromListing, "function invalid 1 1 3 0 v:v\n  IBox 0 0\n  Ret 0\nend"))
    assert(not pcall(program.fromListing, "function invalid 1 0 3 0 :v\n  IAdd 0 1 2\n  IBox 0 0\n  Ret 0\nend"))

    local cases: integer = 13

    local function graph(blocks: any): any
        return {name = "verify-cfg", constants = {}, blocks = blocks}
    end

    local function returned(register: integer): any
        return {kind = "return", value = register, targets = {}}
    end

    local function jumped(target: integer): any
        return {kind = "jump", targets = {target}}
    end

    local function branched(register: integer, yes: integer, no: integer): any
        return {kind = "branch", value = 256 + register, targets = {yes, no}}
    end

    local function accepts(blocks: any): nil
        program.fromBlocks(graph(blocks))
        cases += 1
    end

    local function refuses(blocks: any): nil
        assert(not pcall(program.fromBlocks, graph(blocks)), "malformed core CFG was accepted")
        cases += 1
    end

    accepts({
        {code = {{"IK", 0, 1}}, term = branched(0, 2, 3)},
        {code = {{"IK", 1, 42}, {"IBox", 0, 1}}, term = returned(0)},
        {code = {{"IK", 2, 99}, {"IBox", 0, 2}}, term = returned(0)}
    })
    accepts({
        {code = {{"IK", 0, 1}}, term = branched(0, 2, 3)},
        {code = {{"IK", 1, 42}}, term = jumped(4)},
        {code = {{"IK", 1, 99}}, term = jumped(4)},
        {code = {{"IBox", 0, 1}}, term = returned(0)}
    })
    refuses({
        {code = {{"IK", 0, 1}}, term = branched(0, 2, 3)},
        {code = {{"IK", 1, 42}}, term = jumped(4)},
        {code = {}, term = jumped(4)},
        {code = {{"IBox", 0, 1}}, term = returned(0)}
    })
    accepts({{code = {{"IK", 0, 1}}, term = jumped(2)}, {code = {{"IAddK", 0, 0, 1}}, term = jumped(2)}})
    accepts({{code = {}, term = jumped(1)}})
    refuses({{code = {}, term = jumped(2)}, {code = {{"IAddK", 0, 0, 1}}, term = jumped(2)}})
    refuses({{code = {{"IK", 0, 1}}, term = jumped(0)}})
    refuses({{code = {{"IK", 0, 1}}, term = jumped(2)}})
    refuses({
        {code = {{"IK", 0, 1}, {"IBox", 0, 0}}, term = returned(0)},
        {code = {{"IK", 1, 2}, {"IBox", 0, 1}}, term = returned(0)}
    })
    refuses({{code = {{"IK", 0, 1}, {"IBox", 0, 0}}, term = returned(1)}})
    refuses({{code = {{"IK", 0, 1}, {"IBox", 300, 0}}, term = returned(300)}})
    assert(not pcall(program.encode, {{"IK", 0, 1}, {"Jmp", 2147483648}}, 0))
    cases += 1
    assert(not pcall(program.encode, {{"IK", 0, 1}, {"Jmp", -2147483649}}, 0))
    cases += 1
    assert(not pcall(program.encode, {{"IK", 0, 1}, {"Jmp", 1}, {"IK", 0, 2}}, 0))
    cases += 1

    return cases
end

function extract.catalog(source: string): string
    local path = "=core-function-catalog.nupp"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0, "catalog source did not parse")
    local env = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = check.check(parsed, path, env as any, {
        moduleName = "core_fixture",
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    (parsed.root as any).vmModuleExports = (parsed as any).moduleExports
    local holder: any = {}
    local previousSink = lower.graphSink
    lower.graphSink = function(entry: string, functions: any, header: any): nil
        local described = {}
        for index, f in ipairs(functions) do
            described[index] = program.catalogFunction(f, convert.blocks(f))
        end
        holder.catalog = {
            version = 1,
            kind = "checked-function-catalog",
            runtimeAdmitted = false,
            entryModule = entry,
            entryFunctionId = header.entry,
            modules = header.modules,
            shapeCount = #header.shapes,
            functions = described
        }
        program.verifyCatalog(holder.catalog)
    end
    local listings = {}
    local ok, image = pcall(
        lower.emit,
        "core_fixture",
        {},
        function(name: string): string?
            return name == "core_fixture" and path or nil
        end,
        function(_: string, _: string): table
            return parsed.root
        end,
        nil,
        listings
    )
    lower.graphSink = previousSink
    assert(ok, image)
    local catalog = assert(holder.catalog, "missing checked function catalog")
    assert(#listings == #catalog.functions, "function listing count changed")
    for index, listing in ipairs(listings) do
        local f = catalog.functions[index]
        assert(
            tonumber(listing.image:match("^function %S+ (%d+) ")) == f.id and listing.name == f.name,
            "function listing identity changed"
        )
        f.listing = listing.image
    end
    catalog.graphImageHex = program.hex(image)

    return json.encode(catalog)
end

function extract.testCatalog(): integer
    local source = "local function fib(n: number): number if n < 2 then return n end return fib(n - 1) + fib(n - 2) end return fib"
    local catalog: any = json.decode(extract.catalog(source))
    assert(catalog.runtimeAdmitted == false and #catalog.functions == 2 and catalog.entryFunctionId == 0)
    local chunk, fib = catalog.functions[1], catalog.functions[2]
    assert(chunk.id == 0 and fib.id == 1 and fib.parent == 0 and fib.name == "fib")
    assert(fib.nparams == 1 and fib.sig == "v" and fib.ret == "v" and not fib.vararg)
    assert(#fib.captures == 1 and fib.captures[1].kind == "local" and fib.captures[1].nameBytes == "666962")
    assert(chunk.opcodeCounts.NewCell == 1 and chunk.opcodeCounts.NewClosure == 1 and chunk.opcodeCounts.SetCell == 1)
    assert(fib.opcodeCounts.CallDyn == 2 and fib.opcodeCounts.GetUpval and fib.opcodeCounts.GetCell)
    assert(fib.opcodeCounts.Sub == 2 and fib.opcodeCounts.Add == 1 and fib.opcodeCounts.Lt == 1)
    assert(fib.listing:find("CallDyn", 1, true) and fib.listing:find("GetCell", 1, true))
    assert(#catalog.graphImageHex > 16 and catalog.graphImageHex:sub(1, 16) == "4e55505047524146")

    local function refused(): nil
        assert(not pcall(program.verifyCatalog, catalog), "invalid catalog was accepted")
    end

    fib.parent = 1
    refused()
    fib.parent = 0
    fib.captures[1].reg = chunk.registers[1]
    refused()
    fib.captures[1].reg = 0
    fib.id = 2
    refused()
    fib.id = 1
    catalog.runtimeAdmitted = true
    refused()

    return 13
end

function extract.testCatalogConstants(source: string): integer
    local catalog: any = json.decode(extract.catalog(source))
    local f = catalog.functions[2]
    local found = {}
    for _, c in ipairs(f.constants) do
        if c.kind == "int64" and c.bitsLE == "0000000000000080" then
            found.signed = true
        elseif c.kind == "uint64" and c.bitsLE == "ffffffffffffffff" then
            found.unsigned = true
        elseif c.kind == "num" and c.bitsLE == "000000000000f83f" then
            found.number = true
        elseif c.kind == "str" and c.bytes == "6100ff7a" then
            found.binaryString = true
        end
    end
    assert(found.signed)
    assert(found.unsigned)
    assert(found.number)
    assert(found.binaryString)
    local zero = false
    for _, b in ipairs(f.blocks) do
        for _, instruction in ipairs(b.code) do
            if instruction.op == "FK" and instruction.operands[2].bitsLE == "0000000000000000" then
                zero = true
            end
        end
    end
    assert(zero)
    assert(f.opcodeCounts.FNeg == 1)

    return 6
end

export = extract
