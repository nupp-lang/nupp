module nupp.core.extract

local parser = require("nupp.compiler.syntax.parser")
local check = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local programgraph = require("nupp.compiler.vm.programgraph")
local guest = require("nupp.compiler.vm.guestprofile")
local graph = require("nupp.compiler.vm.graph")
local program = require("nupp.core.program")
local json = require("serde.json")
local extract = {}

function extract.compile(source: string, selected: string): any
    local path = "=core-first-program.nupp"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0, "first program did not parse")
    local env = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = check.check(parsed, path, env as any, {
        moduleName = "core_fixture",
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    local catalog = programgraph.describe(
        {{name = "core_fixture", path = path, parsed = parsed, diagnostics = diagnostics}},
        "core_fixture"
    )
    local owner = programgraph.select(catalog, "core_fixture", selected)
    local g = programgraph.functionGraph(catalog, owner, guest)

    return program.fromBlocks(g)
end

function extract.image(source: string, selected: string): string
    return extract.compile(source, selected).code
end

function extract.inspect(source: string, selected: string): string
    local result = extract.compile(source, selected)
    local bytes = {}
    for i = 1, #result.code do
        bytes[i] = assert(result.code:byte(i))
    end

    return json.encodevalue({
        name = result.name,
        slots = result.slots,
        count = result.count,
        result = result.result,
        returns = result.returns,
        bytes = bytes,
        frontend = result.frontend,
        representation = result.representation,
        derivation = result.derivation,
        graphBlocks = result.graphBlocks,
        graphValues = result.graphValues,
        graphPositions = result.graphPositions,
        graph = result.graph
    })
end

function extract.verifyData(bytes: string, codeBytes: string): boolean
    program.verifyData(bytes, assert(tonumber(codeBytes)) as integer)
    return true
end

function extract.data(code: string, slots: string, offsets: string, codeBytes: string): string
    local handlers = {}
    for offset in offsets:gmatch("[^,]+") do
        handlers[#handlers + 1] = assert(tonumber(offset))
    end

    return program.data(code, assert(tonumber(slots)) as integer, handlers, assert(tonumber(codeBytes)) as integer)
end

local function cycleGraph(): any
    local g = graph.new(0)
    local first = graph.block(g)
    local a = graph.emit(g, first, "IK", {10})
    local b = graph.emit(g, first, "IK", {20})
    local joined = graph.block(g)
    local x, y = graph.value(g, "i", 0), graph.value(g, "i", 1)
    joined.params = {x, y}
    first.term = {kind = "jump", edges = {{target = joined.id, args = {b, a}}}}
    local sum = graph.emit(g, joined, "IAdd", {x, y})
    joined.term = {kind = "return", value = sum, edges = {}}

    return g
end

function extract.cycleImage(): string
    return program.fromBlocks(cycleGraph()).code
end

function extract.cycleInspect(): string
    local result = program.fromBlocks(cycleGraph())
    return json.encodevalue({
        name = "copy-cycle",
        slots = result.slots,
        count = result.count,
        returns = result.returns,
        frontend = result.frontend,
        representation = result.representation,
        derivation = result.derivation,
        graphBlocks = result.graphBlocks,
        graphValues = result.graphValues,
        graphPositions = result.graphPositions,
        graph = result.graph
    })
end

function extract.test(): integer
    local simple = program.encode({{"IK", 0, "9223372036854775807"}, {"IK", 1, 1}, {"IAdd", 2, 0, 1}}, 2)
    local handlers = {}
    for i = 1, #program.names do
        handlers[i] = (i - 1) * 4
    end
    local codeBytes = #program.names * 4
    local data = program.data(simple.code, simple.slots, handlers, codeBytes)
    program.verifyData(data, codeBytes)
    local cases: integer = 0

    local function rejected(action: function(): any): nil
        assert(not pcall(action), "malformed graph or artifact was accepted")
        cases = cases + 1
    end

    local function raw(code: string, slots: integer): nil
        rejected(function(): any
            return program.verify(code, slots)
        end)
    end

    raw(simple.code:sub(2), simple.slots)
    raw(string.char(255) .. simple.code:sub(2), simple.slots)
    raw(simple.code, 2)
    raw(simple.code:sub(1, -17), simple.slots)
    raw(simple.code:sub(-16) .. simple.code, simple.slots)
    raw(program.encode({{"IK", 0, 1}}, 0).code:gsub("^.", string.char(2)), 1)
    raw(simple.code:sub(1, 4) .. string.char(1) .. simple.code:sub(6), simple.slots)
    rejected(function(): any
        return program.verifyData(data .. string.char(0), codeBytes)
    end)
    rejected(function(): any
        return program.verifyData(data:sub(1, -2), codeBytes)
    end)
    rejected(function(): any
        return program.verifyData(data, codeBytes - 4)
    end)

    local g = cycleGraph()
    local first, joined = g.blocks[1], g.blocks[2]
    local a, sum = first.dst[1], joined.dst[1]
    local artifact = program.fromBlocks(g)
    assert(artifact.representation == "nupp.compiler.vm.graph" and artifact.graphBlocks == 2)
    local copies: integer = 0
    for at = 1, #artifact.code, 16 do
        if artifact.code:byte(at) == 2 then
            copies = copies + 1
        end
    end
    assert(copies >= 3, "parallel-copy cycle did not use the graph deriver")
    cases = cases + 1
    g.nparams = 1
    rejected(function(): any
        return program.fromBlocks(g)
    end)
    g.nparams = 0
    g.constants = {{kind = "num", value = 1}}
    rejected(function(): any
        return program.fromBlocks(g)
    end)
    g.constants = {}
    joined.term.value = 999999
    rejected(function(): any
        return program.fromBlocks(g)
    end)
    joined.term.value = sum
    first.term.edges[1].args = {a}
    rejected(function(): any
        return program.fromBlocks(g)
    end)

    local invokeGraph = graph.new(0)
    local invokeBlock = graph.block(invokeGraph)
    local invocation = {kind = "invoke", args = {}, edges = {}}
    invokeBlock.term = invocation
    local beforeTypes, beforeSlots = invokeGraph.types, invokeGraph.slots
    local ok, problem = pcall(function(): any
        return program.fromBlocks(invokeGraph)
    end)
    assert(
        not ok and tostring(problem):find("core invoke execution is not established", 1, true),
        "core invoke must refuse before verification or pruning"
    )
    assert(
        invokeBlock.term == invocation and invokeGraph.types == beforeTypes and invokeGraph.slots == beforeSlots,
        "refused invoke mutated its graph"
    )
    cases = cases + 1

    return cases
end

export = extract
