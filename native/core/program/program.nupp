module nupp.core.program

local opcodes = require("nupp.compiler.vm.opcodes")
local graphimage = require("nupp.compiler.vm.graphimage")
local graph = require("nupp.compiler.vm.graph")
local program = {}

program.names = {
    "CoreStop",
    "IK",
    "IMov",
    "IAddK",
    "IMaskU32",
    "IAdd",
    "ISub",
    "IAnd",
    "IOr",
    "IXor",
    "INot",
    "IShl",
    "IShrU",
    "ICmpEq",
    "ICmpNe",
    "ICmpLt",
    "ICmpLe",
    "ICmpSLt",
    "ICmpSLe",
    "Jmp",
    "JmpIfIZero"
}
local ids = {}
for i, name in ipairs(program.names) do
    ids[name] = i - 1
end
local zeros = string.rep(string.char(0), 8)

local function integer(value: any, maximum: integer): integer
    assert(type(value) == "number" and value % 1 == 0 and value >= 0 and value <= maximum, "invalid program integer")
    return value as integer
end

local function word(value: integer): string
    return graphimage.wideBytes(value)
end

local function readWord(bytes: string, offset: integer): integer
    assert(offset >= 0 and offset + 8 <= #bytes, "truncated program word")
    local value: integer = 0
    for i = 7, 0, -1 do
        local b = assert(bytes:byte(offset + i + 1))
        assert(value <= 35184372088831, "program extent exceeds exact range")
        value = value * 256 + b
    end

    return value
end

local function signed32(bytes: string, offset: integer): integer
    local a, b, c, d = bytes:byte(offset + 1, offset + 4)
    local value = a + b * 256 + c * 65536 + d * 16777216
    return value >= 2147483648 and value - 4294967296 or value
end

function program.verify(code: string, slots: integer): nil
    integer(slots, 256)
    assert(slots > 0 and #code > 0 and #code % 16 == 0 and #code / 16 <= 1048576, "invalid program extent")
    local count = (#code / 16) as integer
    local successors, reads, writes, leaders = {}, {}, {}, {[1] = true}
    for pc = 1, count do
        local offset = (pc - 1) * 16
        local id, a, b, c = code:byte(offset + 1, offset + 4)
        local name = program.names[id + 1]
        assert(name ~= nil, "unknown core opcode")
        local used, nextPCs = {}, {}
        reads[pc], successors[pc] = used, nextPCs
        local displacement = signed32(code, offset + 4)
        local immediate = code:sub(offset + 9, offset + 16)
        if id == 0 then
            assert(
                a < slots and b == 0 and c == 0 and displacement == 0 and immediate == zeros,
                "invalid stop encoding"
            )
            used[1] = a
        else
            local signature = assert(opcodes.describe(name))
            assert(not signature.frame and #signature.windows == 0, "unsupported core frame effect")
            local registers = {a, b, c}
            local hasImmediate = false
            for at, operand in ipairs(signature.operands) do
                if operand.class == "i" then
                    local register = registers[at]
                    assert(register < slots, "program register outside frame")
                    if operand.mode == "def" then
                        assert(at == 1 and writes[pc] == nil, "unsupported core definition")
                        writes[pc] = register
                    else
                        assert(operand.mode == "use", "unsupported core register mode")
                        used[#used + 1] = register
                    end
                elseif operand.class == "n" then
                    assert(name == "IK" or name == "IAddK", "unsupported core immediate")
                    hasImmediate = true
                else
                    assert(operand.class == "j", "unsupported core operand")
                end
            end
            if not hasImmediate then
                assert(immediate == zeros, "nonzero unused immediate")
            end
            if signature.flow == "jump" or signature.flow == "branch" then
                assert(name == "Jmp" or name == "JmpIfIZero", "unsupported core branch")
                assert(writes[pc] == nil and b == 0 and c == 0, "invalid branch registers")
                if name == "Jmp" then
                    assert(a == 0, "invalid jump register")
                end
                local target = pc + displacement + 1
                assert(target >= 1 and target <= count, "program jump outside body")
                nextPCs[1], leaders[target] = target, true
                if signature.flow == "branch" then
                    assert(pc < count, "program branch falls outside body")
                    nextPCs[2], leaders[pc + 1] = pc + 1, true
                elseif pc < count then
                    leaders[pc + 1] = true
                end
            else
                assert(signature.flow == "next" and writes[pc] == a, "unsupported core flow")
                assert(displacement == 0, "nonzero instruction padding")
                if name == "IK" then
                    assert(b == 0 and c == 0, "invalid immediate encoding")
                elseif name == "IAddK" or #signature.operands == 2 then
                    assert(c == 0, "nonzero unused register")
                end
                assert(pc < count, "program falls outside body")
                nextPCs[1] = pc + 1
            end
        end
        if id == 0 and pc < count then
            leaders[pc + 1] = true
        end
    end
    local reached, stack = {}, {1}
    while #stack > 0 do
        local pc = table.remove(stack)
        if not reached[pc] then
            reached[pc] = true
            for _, target in ipairs(successors[pc]) do
                stack[#stack + 1] = target
            end
        end
    end
    for pc = 1, count do
        assert(reached[pc], "unreachable program instruction")
    end
    local blocks, owner = {}, {}
    for pc = 1, count do
        if leaders[pc] then
            blocks[
                #blocks + 1
            ] = {first = pc, last = pc, required = {}, generated = {}, predecessors = {}, incoming = {}}
        end
        local block = blocks[#blocks]
        owner[pc], block.last = #blocks, pc
        for _, register in ipairs(reads[pc]) do
            if not block.generated[register] then
                block.required[register] = true
            end
        end
        if writes[pc] ~= nil then
            block.generated[writes[pc]] = true
        end
    end
    for index, block in ipairs(blocks) do
        for _, target in ipairs(successors[block.last]) do
            local predecessors = blocks[owner[target]].predecessors
            predecessors[#predecessors + 1] = index
        end
        if index ~= 1 then
            for register = 0, slots - 1 do
                block.incoming[register] = true
            end
        end
    end
    local changed = true
    while changed do
        changed = false
        for index, block in ipairs(blocks) do
            if index ~= 1 then
                for register = 0, slots - 1 do
                    if block.incoming[register] then
                        for _, predecessor in ipairs(block.predecessors) do
                            local before = blocks[predecessor]
                            if not before.incoming[register] and not before.generated[register] then
                                block.incoming[register], changed = nil, true
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    for _, block in ipairs(blocks) do
        for register in pairs(block.required) do
            assert(block.incoming[register], "program register read before definition")
        end
    end
end

local function encodeInstructions(instructions: {any}): any
    assert(#instructions > 0 and #instructions <= 1048576, "program instruction budget exceeded")
    local bytes, returns = {}, {}
    local slots: integer = 1
    for _, instruction in ipairs(instructions) do
        local name = instruction[1]
        local id = ids[name]
        assert(id ~= nil, "unsupported core opcode " .. tostring(name))
        local registers = {0, 0, 0}
        local immediate, displacement = zeros, zeros:sub(1, 4)
        if name == "CoreStop" then
            assert(#instruction == 2, "invalid stop operands")
            registers[1] = integer(instruction[2], 255)
            slots = math.max(slots, registers[1] + 1)
            returns[#returns + 1] = registers[1]
        else
            opcodes.check(instruction)
            local signature = assert(opcodes.describe(name))
            for at, operand in ipairs(signature.operands) do
                local value = instruction[at + 1]
                if operand.class == "i" then
                    local register = integer(value, 255)
                    registers[at] = register
                    slots = math.max(slots, register + 1)
                elseif operand.class == "j" then
                    assert(
                        type(value) == "number" and value % 1 == 0 and value >= -2147483648 and value <= 2147483647,
                        "invalid signed jump displacement"
                    )
                    displacement = graphimage.wideTextBytes(tostring(value)):sub(1, 4)
                else
                    assert(operand.class == "n", "unsupported core operand")
                    immediate = type(value) == "string" and graphimage.wideTextBytes(value)
                        or graphimage.wideBytes(value)
                end
            end
        end
        bytes[#bytes + 1] = string.char(id, registers[1], registers[2], registers[3]) .. displacement .. immediate
    end
    local code = table.concat(bytes)
    program.verify(code, slots)

    return {code = code, slots = slots, count = #bytes, result = #returns == 1 and returns[1] or nil, returns = returns}
end

function program.encode(instructions: {any}, result: integer): any
    local copied = {}
    for _, instruction in ipairs(instructions) do
        copied[#copied + 1] = instruction
    end
    copied[#copied + 1] = {"CoreStop", integer(result, 255)}

    return encodeInstructions(copied)
end

function program.fromBlocks(kept: any): any
    assert(not kept.graph and #kept.blocks > 0 and #kept.constants == 0, "unsupported core function graph")
    local instructions, starts, patches = {}, {}, {}
    for index, block in ipairs(kept.blocks) do
        starts[index] = #instructions + 1
        local term, limit = block.term, #block.code
        local result = nil
        if term.kind == "return" then
            local box = block.code[limit]
            assert(box and box[1] == "IBox" and term.value == box[2], "core return requires an adjacent integer box")
            opcodes.check(box)
            integer(box[2], 255)
            result, limit = box[3], limit - 1
        end
        for i = 1, limit do
            instructions[#instructions + 1] = block.code[i]
        end

        local function jump(name: string, target: integer, register: integer?): nil
            integer(target, #kept.blocks)
            assert(target >= 1, "invalid core block target")
            instructions[#instructions + 1] = register ~= nil and {name, register, 0} or {name, 0}
            patches[#patches + 1] = {at = #instructions, target = target, field = register ~= nil and 3 or 2}
        end

        if term.kind == "return" then
            assert(#term.targets == 0 and term.value ~= nil, "invalid core return")
            instructions[#instructions + 1] = {"CoreStop", result}
        elseif term.kind == "jump" then
            assert(#term.targets == 1, "invalid core jump")
            jump("Jmp", term.targets[1])
        else
            assert(
                term.kind == "branch" and #term.targets == 2 and term.value >= 256 and term.value < 512,
                "core branch requires an integer condition"
            )
            jump("JmpIfIZero", term.targets[2], integer(term.value - 256, 255))
            jump("Jmp", term.targets[1])
        end
    end
    for _, patch in ipairs(patches) do
        instructions[patch.at][patch.field] = starts[patch.target] - patch.at - 1
    end
    local encoded = encodeInstructions(instructions)
    encoded.name = kept.name

    return encoded
end

function program.data(code: string, slots: integer, handlers: {integer}, codeBytes: integer): string
    program.verify(code, slots)
    integer(codeBytes, 2147483647)
    assert(codeBytes > 0 and #handlers == #program.names, "invalid handler table")
    local parts = {word((#code / 16) as integer), word(slots), word(32), word(32 + #code), code}
    for _, offset in ipairs(handlers) do
        integer(offset, codeBytes - 1)
        assert(offset % 4 == 0, "unaligned handler offset")
        parts[#parts + 1] = word(offset)
    end
    local bytes = table.concat(parts)
    program.verifyData(bytes, codeBytes)

    return bytes
end

function program.verifyData(bytes: string, codeBytes: integer): nil
    integer(codeBytes, 2147483647)
    local count = readWord(bytes, 0)
    local slots = readWord(bytes, 8)
    local body = readWord(bytes, 16)
    local handlers = readWord(bytes, 24)
    assert(count > 0 and count <= 1048576 and body == 32, "invalid program header")
    assert(handlers == body + count * 16 and #bytes == handlers + #program.names * 8, "invalid program size")
    program.verify(bytes:sub(body + 1, handlers), slots)
    for i = 0, #program.names - 1 do
        local offset = readWord(bytes, handlers + i * 8)
        assert(offset < codeBytes and offset % 4 == 0, "invalid handler offset")
    end
end

function program.fromListing(text: string): any
    local header = assert(text:match("^[^\n]+"), "missing program header")
    local name, id, parameters, registers, floats, signature = header:match(
        "^function (%S+) (%d+) (%d+) (%d+) (%d+) (%S+)$"
    )
    assert(
        name
        and tonumber(id) ~= nil
        and tonumber(parameters) == 0
        and tonumber(registers) ~= nil
        and tonumber(floats) ~= nil
        and signature == ":v",
        "first program requires a closed zero-argument function"
    )
    local instructions = {}
    for line in text:gmatch("[^\n]+") do
        local body = line:match("^  (.*)$")
        if body and (body:match("^source %S+$") or body:match("^lines [%dx ]+$")) then
            -- Metadata carries no executable operands.
        elseif body then
            local instruction = {}
            for token in body:gmatch("%S+") do
                if #instruction == 0 then
                    instruction[1] = token
                else
                    local signature = opcodes.describe(instruction[1])
                    local operand = signature and signature.operands[#instruction]
                    instruction[#instruction + 1] = operand and operand.class == "n" and token
                        or tonumber(token)
                        or token
                end
            end
            instructions[#instructions + 1] = instruction
        else
            assert(line == header or line == "end", "unknown program listing record")
        end
    end
    local stop = table.remove(instructions)
    local box = table.remove(instructions)
    assert(
        stop and box and stop[1] == "Ret" and box[1] == "IBox" and stop[2] == box[2],
        "first program requires one raw integer return"
    )
    opcodes.check(stop)
    opcodes.check(box)
    integer(stop[2], 255)
    local result = program.encode(instructions, box[3])
    assert(result.slots <= assert(tonumber(registers)), "program slot outside declared extent")
    result.name = name
    result.listing = text

    return result
end

local function hex(bytes: string): string
    local parts = {}
    for i = 1, #bytes do
        parts[i] = string.format("%02x", assert(bytes:byte(i)))
    end

    return table.concat(parts)
end

program.hex = hex

local function constant(c: any): any
    local kind, value = c.kind, c.value
    assert(graphimage.constantKinds[kind] ~= nil, "unknown catalog constant kind")
    local result: any = {kind = kind}
    if kind == "num" then
        result.bitsLE = hex(graphimage.floatBytes(value))
    elseif kind == "int64" or kind == "uint64" then
        result.bitsLE = hex(type(value) == "string" and graphimage.wideTextBytes(value) or graphimage.wideBytes(value))
        result.text = tostring(value)
    elseif kind == "str" or kind == "builtin" then
        result.bytes = hex(value)
    elseif kind == "func" then
        result.functionId = integer(value, 4294967295)
    end

    return result
end

function program.catalogFunction(f: any, kept: any): any
    assert(not kept.graph, "function catalog requires register-form compiler output")
    local captures, captureNames = {}, {}
    for name, index in pairs(f.upvalIndex) do
        integer(index, #f.upvals - 1)
        assert(captureNames[index + 1] == nil, "duplicate capture index")
        captureNames[index + 1] = name
    end
    for index, source in ipairs(f.upvals) do
        local capture: any = {index = index - 1, nameBytes = hex(assert(captureNames[index])), kind = source.kind}
        if source.kind == "local" then
            capture.reg = integer(source.reg, 255)
        elseif source.kind == "spill" then
            capture.keyBytes = hex(source.key)
        else
            assert(source.kind == "upval", "unknown capture source")
            capture.indexInParent = integer(source.index, 4294967295)
        end
        captures[index] = capture
    end
    local constants, blocks = {}, {}
    for index, c in ipairs(kept.constants) do
        constants[index] = constant(c)
        constants[index].index = index - 1
    end
    local unavailable, opCounts = {}, {}
    for bi, b in ipairs(kept.blocks) do
        local code = {}
        for ii, instruction in ipairs(b.code) do
            opcodes.check(instruction)
            local name = instruction[1]
            local described = assert(opcodes.describe(name))
            local signature = assert(graph.signatures[name])
            local operands, arg = {}, 0
            for at = 1, #instruction - 1 do
                local value, operand = instruction[at + 1], described.operands[at]
                local letter
                if at == signature.resultAt then
                    letter = signature.result
                else
                    arg += 1
                    letter = signature.args[arg]
                end
                local item: any = {class = operand.class, mode = operand.mode}
                if letter == "L" then
                    item.bitsLE = hex(
                        type(value) == "string" and graphimage.wideTextBytes(value) or graphimage.wideBytes(value)
                    )
                    item.encoding = "integer64"
                elseif letter == "D" then
                    item.bitsLE = hex(graphimage.floatBytes(value))
                    item.encoding = "binary64"
                elseif type(value) == "string" then
                    item.bytes = hex(value)
                else
                    item.value = value
                end
                operands[at] = item
            end
            code[ii] = {op = name, operands = operands, position = b.pos[ii]}
            opCounts[name] = (opCounts[name] or 0) + 1
            if ids[name] == nil then
                unavailable["opcode:" .. name] = true
            end
        end
        local t, targets = b.term, {}
        for index, target in ipairs(t.targets) do
            targets[index] = target
        end
        blocks[
            bi
        ] = {
            index = bi,
            code = code,
            term = {kind = t.kind, value = t.value, count = t.count, constant = t.constant, targets = targets}
        }
        if t.kind == "return" or t.kind == "returns" then
            unavailable["guest-return"] = true
        elseif t.kind ~= "jump" and t.kind ~= "branch" then
            unavailable["terminator:" .. t.kind] = true
        end
    end
    if #captures > 0 then
        unavailable["upvalue-storage"] = true
    end
    if #constants > 0 then
        unavailable["constant-pool"] = true
    end
    if kept.nparams > 0 then
        unavailable["parameter-transport"] = true
    end
    if kept.vararg then
        unavailable["varargs"] = true
    end
    if f.spillReg ~= nil or f.spillCount ~= nil then
        unavailable["frame-spills"] = true
    end
    if (f.cleanupDepth or 0) > 0 then
        unavailable["cleanup"] = true
    end
    local missing = {}
    for capability in pairs(unavailable) do
        missing[#missing + 1] = capability
    end
    table.sort(missing)

    return {
        id = f.id,
        name = kept.name,
        module = kept.module,
        parent = f.parent and f.parent.id,
        nparams = kept.nparams,
        sig = kept.sig,
        ret = kept.ret,
        vararg = kept.vararg,
        registers = kept.registers,
        frameLayout = "unassigned",
        compilerRegisters = {
            values = f.nregs,
            scalars = f.nfregs,
            vectors = f.nvregs,
            maxValues = f.maxRegs,
            maxScalars = f.maxFregs
        },
        spillReg = f.spillReg,
        spillCount = f.spillCount,
        cleanupDepth = f.cleanupDepth or 0,
        captures = captures,
        constants = constants,
        positions = kept.positions,
        blocks = blocks,
        opcodeCounts = opCounts,
        runtimeAdmitted = false,
        unavailableCapabilities = missing
    }
end

function program.verifyCatalog(catalog: any): nil
    assert(
        catalog.version == 1 and catalog.kind == "checked-function-catalog" and catalog.runtimeAdmitted == false,
        "invalid function catalog"
    )
    local functions = catalog.functions
    assert(#functions > 0 and #functions <= 65536, "invalid catalog function count")
    integer(catalog.entryFunctionId, #functions - 1)
    for index, f in ipairs(functions) do
        assert(f.id == index - 1 and f.runtimeAdmitted == false, "catalog function identity changed")
        assert(#f.sig == f.nparams and #f.registers == 3, "invalid catalog function signature")
        for _, class in ipairs(f.registers) do
            integer(class, 4294967295)
        end
        local parent
        if f.parent ~= nil then
            integer(f.parent, (f.id - 1) as integer)
            parent = functions[f.parent + 1]
        end
        for ui, capture in ipairs(f.captures) do
            assert(parent and capture.index == ui - 1, "invalid catalog capture owner")
            if capture.kind == "local" then
                integer(capture.reg, (parent.registers[1] - 1) as integer)
            elseif capture.kind == "upval" then
                integer(capture.indexInParent, #parent.captures - 1)
            else
                assert(capture.kind == "spill" and type(capture.keyBytes) == "string", "invalid catalog capture")
            end
        end
        for ci, c in ipairs(f.constants) do
            assert(c.index == ci - 1 and graphimage.constantKinds[c.kind] ~= nil, "invalid catalog constant identity")
            if c.kind == "func" then
                integer(c.functionId, #functions - 1)
            elseif c.kind == "num" or c.kind == "int64" or c.kind == "uint64" then
                assert(
                    type(c.bitsLE) == "string" and #c.bitsLE == 16 and c.bitsLE:match("^[0-9a-f]+$"),
                    "invalid catalog constant bits"
                )
            elseif c.kind == "str" or c.kind == "builtin" then
                assert(
                    type(c.bytes) == "string" and #c.bytes % 2 == 0 and not c.bytes:find("[^0-9a-f]"),
                    "invalid catalog constant bytes"
                )
            end
        end
        assert(#f.blocks > 0 and #f.blocks <= 1048576, "invalid catalog block count")
        local instructions = 0
        for bi, b in ipairs(f.blocks) do
            assert(b.index == bi, "catalog block order changed")
            instructions += #b.code
            assert(instructions <= 1048576, "catalog instruction budget exceeded")
            for _, instruction in ipairs(b.code) do
                local described = assert(opcodes.describe(instruction.op))
                assert(
                    #instruction.operands >= described.min and #instruction.operands <= described.max,
                    "invalid catalog operands"
                )
                for at, operand in ipairs(instruction.operands) do
                    local expected = described.operands[at]
                    assert(
                        operand.class == expected.class and operand.mode == expected.mode,
                        "catalog operand descriptor changed"
                    )
                    if operand.class == "fn" then
                        integer(operand.value, #functions - 1)
                    elseif operand.class == "k" then
                        integer(operand.value, #f.constants - 1)
                    end
                end
            end
            local t = b.term
            assert(
                t.kind == "jump"
                or t.kind == "branch"
                or t.kind == "switch"
                or t.kind == "return"
                or t.kind == "returns"
                or t.kind == "raise",
                "unknown catalog terminator"
            )
            for _, target in ipairs(t.targets) do
                assert(integer(target, #f.blocks) > 0, "invalid catalog block target")
            end
        end
    end
    for _, m in ipairs(catalog.modules) do
        integer(m.chunk, #functions - 1)
    end
end

export = program
