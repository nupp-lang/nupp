module nupp.core.cataloglibraryresults

-- Library calls whose last argument is a call with several results: Lua passes
-- every result, so each call goes through the library function's value. Each
-- check is a bit of the score.
local score = 0
local bit = 1

local function check(ok: boolean): nil
    if ok then
        score = score | bit
    end
    bit = bit << 1
end

local function bounds(): (integer, integer)
    return 2, 3
end

local function failing(): (any, string)
    return nil, "why"
end

-- One nil, as a call that answers its arguments gives it.
local function only(...: any): ...any
    return ...
end

local function pair(): (string, integer)
    return "one", 2
end

local function digits(): (string, integer)
    return "ff", 16
end

local function count(): (integer, string)
    return 2, "-"
end

-- Every result of assert, through an open return.
local function both(): ...any
    return assert(pair())
end

local closed: integer = 0

local record Token is own.Closeable
    function close(takes self): nil
        closed = closed + 1
    end
end

local function open(ok: boolean): (Token?, string?)
    if ok then
        return Token(), nil
    end

    return nil, "no token"
end

-- An owner assert answers from the results it was given, closed once.
local function held(): integer
    local token = assert(open(true))
    token:close()

    return closed
end

local function missing(): nil
    local token = assert(open(false))
    token:close()
end

do
    check(string.sub("hello", bounds()) == "el")
    local ok, message = pcall(function()
        assert(failing())
    end)
    check(not ok and message == "why")
    local bare, said = pcall(function()
        assert(only(nil))
    end)
    check(not bare and said == "assertion failed!")
    local first, second = assert(pair())
    check(first == "one" and second == 2)
    check(tonumber(digits()) == 255)
    check(tonumber(("n=42"):match("(%d+)")) == 42)
    check(string.char(table.unpack({104, 105, 33})) == "hi!")
    local caught, reason = pcall(function()
        assert(pcall(error, "bad", 0))
    end)
    check(not caught and reason == "bad")
    check(string.rep("ab", count()) == "ab-ab")
    check(select("#", both()) == 2)
    check(held() == 1)
    local opened, refusal = pcall(missing)
    check(not opened and refusal == "no token" and closed == 1)
    -- error's level counts from the function that called it.
    local positioned, where = pcall(function()
        error(only("boom"))
    end)
    check(not positioned and string.find(tostring(where), ":101: boom", 1, true) ~= nil)
end

export const result = score
