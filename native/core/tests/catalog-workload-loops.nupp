module nupp.core.catalogworkloadloops

-- The `loops` workload of bench/vm/workloads.bench.nupp, whose checksum
-- at scale 1 is 761038. The scale is read from BENCH_SCALE at run time, as the
-- original reads it, so no compiler can fold it away.
-- From i = 11,863,284, i * i leaves the 48-bit immediates and is boxed.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1
local total = 0
for i = 1, 30000000 do
    total = (total + i * i * scale) % 1000003
end
export const result = total
