module nupp.core.catalogworkloadloops

-- The `loops` workload of bench/vm/workloads.bench.nupp at scale 1, whose
-- checksum is 761038; the scale stays an operand rather than folding away.
-- From i = 11,863,284, i * i leaves the 48-bit immediates and is boxed.
local scale = 1
local total = 0
for i = 1, 30000000 do
    total = (total + i * i * scale) % 1000003
end
export = total
