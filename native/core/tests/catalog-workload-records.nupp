module nupp.core.catalogworkloadrecords

-- The `records` workload of bench/vm/workloads.bench.nupp, whose checksum
-- at scale 1 is 800000. The scale is read from BENCH_SCALE at run time, as the
-- original reads it, so no compiler can fold it away.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1

local record Point
    x: number
    y: number
end

local function records(): number
    local points: {Point} = {}
    for i = 1, 200000 do
        points[i] = Point(x = i * scale, y = i * 2)
    end
    local acc = 0.0
    for _ = 1, 20 do
        for i = 1, #points do
            local p = points[i]
            acc = acc + p.x * 0.5 + p.y * 0.25
        end
    end

    return math.floor(acc) % 1000003
end

export const result = records()
