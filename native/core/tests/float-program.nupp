module nupp.core.program

local opcodes = require("nupp.compiler.vm.opcodes")
local graphimage = require("nupp.compiler.vm.graphimage")

-- Test-only straight-line packets, never the production program verifier.
export const names = {
    "CoreStop",
    "CoreFloatStop",
    "IK",
    "FK",
    "FMov",
    "FAdd",
    "FSub",
    "FMul",
    "FDiv",
    "FMod",
    "FNeg",
    "IToF",
    "FToI",
    "FCmpEq",
    "FCmpNe",
    "FCmpLt",
    "FCmpLe"
}

export function data(code: string, slots: integer, offsets: {integer}, codeBytes: integer): string
    assert(slots > 0 and slots <= 256 and #code >= 16 and #code <= 4096 and #code % 16 == 0)
    assert(#offsets == #names and codeBytes > 0 and codeBytes % 4 == 0)
    local defined: {[string]: any} = {i = {}, f = {}}
    for at = 1, #code, 16 do
        local id, a, b, c = code:byte(at, at + 3)
        local name = assert(names[id + 1], "unknown float fixture opcode")
        assert(code:sub(at + 4, at + 7) == string.rep(string.char(0), 4), "fixture padding")
        if id < 2 then
            assert(at + 15 == #code and b == 0 and c == 0 and a < slots, "fixture stop")
            assert(defined[id == 0 and "i" or "f"][a], "undefined fixture result")
        else
            assert(at + 15 < #code, "missing fixture stop")
            local signature = assert(opcodes.describe(name))
            assert(signature.flow == "next" and not signature.frame and #signature.windows == 0)
            local registers, destination, destinationClass = {a, b, c}, nil, nil
            local immediate = false
            for index, operand in ipairs(signature.operands) do
                if operand.class == "n" then
                    assert(name == "IK" or name == "FK", "fixture immediate")
                    immediate = true
                else
                    assert(operand.class == "i" or operand.class == "f", "fixture register class")
                    local slot = registers[index]
                    assert(slot >= 0 and slot < slots, "fixture register extent")
                    if operand.mode == "def" then
                        assert(index == 1 and destination == nil)
                        destination, destinationClass = slot, operand.class
                    else
                        assert(operand.mode == "use" and defined[operand.class][slot], "undefined fixture input")
                    end
                end
            end
            assert(destination ~= nil)
            defined[destinationClass][destination] = true
            if not immediate then
                assert(code:sub(at + 8, at + 15) == string.rep(string.char(0), 8), "fixture immediate padding")
            end
        end
    end
    local parts = {
        graphimage.wideBytes(#code // 16),
        graphimage.wideBytes(slots),
        graphimage.wideBytes(32),
        graphimage.wideBytes(32 + #code),
        code
    }
    for _, offset in ipairs(offsets) do
        assert(offset >= 0 and offset < codeBytes and offset % 4 == 0, "fixture handler offset")
        parts[#parts + 1] = graphimage.wideBytes(offset)
    end

    return table.concat(parts)
end
