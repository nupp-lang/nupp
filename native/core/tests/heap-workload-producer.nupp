module nupp.core.heapworkloadproducer

local contract = require("nupp.compiler.vm.nativeframecontract")
local graph = require("nupp.compiler.vm.graph")
local sink = require("nupp.compiler.s0.nativegraph")
local shim = require("nupp.core.heapshim")
local image = require("nupp.compiler.vm.graphimage")
local json = require("serde.json")
local lower = require("nupp.compiler.vm.lower")
require("nupp.compiler.vm.nativegraph")
require("nupp.compiler.vm.nativecleanup")
require("nupp.compiler.hostservices")

local function hex(value: string): string
    return (value:gsub(".", function(byte: string): string
        return string.format("%02x", byte:byte())
    end))
end

local function write(path: string, bytes: string): nil
    local file = assert(io.open(path, "wb"))
    file:write(bytes)
    file:close()
end

local function progress(directory: string?, phase: string, item: string?): nil
    if directory then
        write(directory .. "/matrix-progress.json", json.encodevalue({phase = phase, item = item}))
    end
end

-- Build artifacts only. Runtime functions execute exclusively on the owned
-- backend. Original graph/Result/Code identity is retained through final link;
-- neither JSON nor names confer executable admission on a copied service unit.
local function prepare(directory: string?): (any, {string}, {[string]: any})
    progress(directory, "building-source", nil)
    local source = contract.buildHeapServices()
    contract.validateHeapServices(source)
    local names: {string} = {}
    local results: {[string]: any} = {}
    for name in pairs(source.resolved) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        progress(directory, "lowering-owner", name)
        local item = source.resolved[name]
        graph.verify(item.graph)
        results[name] = sink.compilerGraph(item.graph, item.owner.name, item.owner, source.resolved, source.context)
    end

    return source, names, results
end

local function selectMode(names: {string}, results: {[string]: any}, mode: string, directory: string?): (any, any)
    assert(mode == "normal" or mode == "spill", "closed allocation mode")
    local selected, metrics = {}, {}
    for _, name in ipairs(names) do
        progress(directory, "selecting-" .. mode, name)
        local allocation = sink.selectAuthenticated(results[name], mode)
        selected[name] = allocation.code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            frameBytes = allocation.code.frameBytes,
            words = #allocation.code.words,
            spillSlots = allocation.spillSlots,
            calls = #allocation.code.fixupName
        }
    end

    return selected, metrics
end

local function artifact(
    source: any,
    selected: any,
    metrics: any,
    mode: string,
    stressText: string,
    scenario: string
): string
    -- The shim calls authenticated linking, including the exact entry-lifetime
    -- verifier. A refused entry cannot become an artifact by stripping a seal.
    local output = shim.build(source, selected, stressText == "stress", scenario)
    local layout = output.layouts.Descriptor
    assert(
        type(layout.size) == "number" and layout.size >= 0 and layout.size <= 1048576 and layout.size % 8 == 0,
        "bounded whole-word descriptor layout required"
    )
    local descriptorSize: integer = layout.size as integer
    local words = {}
    for index = 1, descriptorSize // 8 do
        words[index] = 0
    end

    local function field(name: string, value: integer): nil
        local offset = assert(layout.offsets[name])
        assert(offset % 8 == 0 and offset >= 0 and offset < descriptorSize)
        words[offset // 8 + 1] = value
    end

    field("version", 1)
    field("functionId", 1)
    field("bodyOffset", descriptorSize)
    field("instructionCount", 1)
    field("valueCount", 1)
    field("integerCount", 0)
    field("floatCount", 0)
    field("vectorCount", 0)
    field("tableOffset", descriptorSize + 16)
    field("handlerCount", 1)
    local data = {}
    for _, word in ipairs(words) do
        data[#data + 1] = image.wideBytes(word)
    end
    -- rootentry.start consumes retained code metadata; this workload calls its
    -- source entry directly and never dispatches this inert root record.
    data[#data + 1] = string.rep(string.char(0), 16)
    data[#data + 1] = image.wideBytes(output.descriptorTarget)
    local bytes = table.concat(data)
    output.dataHex, output.dataBytes = hex(bytes), #bytes
    output.mode, output.collectionMode, output.metrics = mode, stressText, metrics
    output.outputWords, output.expectedOutput = 1, 1
    if scenario == "cell" or scenario == "cell-phase-refusal" then
        output.scope = "Owned source-created Heap and real root/frame lifecycle; CELL collection, transfer and reclamation. No closure or whole-language coverage."
    else
        output.scope = "Owned original mapping wrappers: "
            .. scenario
            .. ". No Heap, collector or guest execution. Release refusal is preflight only, not simulated OS failure."
    end
    contract.validateHeapServices(source)

    return json.encodevalue(output)
end

local function build(mode: string, stressText: string, scenario: string): string
    assert(mode == "normal" or mode == "spill", "closed allocation mode")
    assert(stressText == "normal" or stressText == "stress", "closed collection mode")
    local source, names, results = prepare(nil)
    local selected, metrics = selectMode(names, results, mode, nil)

    return artifact(source, selected, metrics, mode, stressText, scenario)
end

-- One checked unit and original Result set remain in this process. Only final
-- serialized artifacts leave it; every case still performs authenticated link
-- and entry verification through the ordinary shim.
export function matrix(directory: string): string
    local source, names, results = prepare(directory)
    local artifacts: {[string]: string} = {}
    for _, mode in ipairs({"normal", "spill"}) do
        local selected, metrics = selectMode(names, results, mode, directory)
        for _, scenario in ipairs({"noop", "acquire-refusal", "release-refusal"}) do
            local key = scenario .. "-" .. mode
            progress(directory, "linking-artifact", key)
            local filename = key .. "-selection.json"
            write(directory .. "/" .. filename, artifact(source, selected, metrics, mode, "normal", scenario))
            artifacts[key] = filename
            progress(directory, "artifact-produced", key)
        end
        for _, stress in ipairs({"normal", "stress"}) do
            local key = "cell-" .. stress .. "-" .. mode
            progress(directory, "linking-artifact", key)
            local filename = key .. "-selection.json"
            write(directory .. "/" .. filename, artifact(source, selected, metrics, mode, stress, "cell"))
            artifacts[key] = filename
            progress(directory, "artifact-produced", key)
        end
        local key = "cell-phase-refusal-" .. mode
        progress(directory, "linking-artifact", key)
        local filename = key .. "-selection.json"
        write(directory .. "/" .. filename, artifact(source, selected, metrics, mode, "normal", "cell-phase-refusal"))
        artifacts[key] = filename
        progress(directory, "artifact-produced", key)
    end
    contract.validateHeapServices(source)

    progress(directory, "matrix-artifacts-produced", nil)

    return json.encodevalue({
        version = 1,
        sourceBuilds = 1,
        loweredOwners = #names,
        selectedOwners = 2 * #names,
        artifacts = artifacts
    })
end

export function compile(mode: string, stressText: string): string
    return build(mode, stressText, "cell")
end

export function refusePhase(mode: string): string
    return build(mode, "normal", "cell-phase-refusal")
end

export function transport(mode: string, scenario: string): string
    assert(
        scenario == "noop" or scenario == "acquire-refusal" or scenario == "release-refusal",
        "closed transport workload"
    )

    return build(mode, "normal", scenario)
end
