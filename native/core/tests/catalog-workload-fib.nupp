module nupp.core.catalogworkloadfib

-- The `fib` workload of bench/vm/workloads.bench.nupp, whose checksum at
-- scale 1 is fib(30) = 832040. The scale is read from BENCH_SCALE at run
-- time, as the original reads it.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1

local function fib(n: number): number
    if n < 2 then
        return n
    end

    return fib(n - 1) + fib(n - 2)
end

export const result = fib(29 + scale)
