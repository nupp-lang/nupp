module nupp.core.catalogstoragebasics

local calls = require("nupp.runtime.storagecalls")

local score = 0
local bytes: any = calls.allocbytes(4)
bytes[0] = 255
bytes[3] = 7
if bytes[0] == 255 and bytes[1] == 0 and bytes[3] == 7 then
    score = score + 1
end
local words: any = calls.allocate(6, 2)
words[0] = -5
words[1] = 4294967295
if words[0] == -5 and words[1] == -1 then
    score = score + 2
end
local floats: any = calls.allocate(9, 1)
floats[0] = 0.1
if floats[0] == math.f32.narrow(0.1) then
    score = score + 4
end
local outside = pcall(function(): any
    return bytes[4]
end)
if not outside then
    score = score + 8
end
if type(bytes) == "userdata" then
    score = score + 16
end
bytes[1] = 300
if bytes[1] == 44 then
    score = score + 32
end
local wide: any = calls.allocate(8, 1)
wide[0] = math.mininteger
if wide[0] == math.mininteger then
    score = score + 64
end
local block: any = calls.allocbytes(8)
calls.copy(block, "abcdefgh", 8)
local tail: any = calls.view(block, 1, 4)
if calls.elements(tail) == 4 and tail[0] == 101 then
    score = score + 128
end
tail[1] = 70
if calls.text(block, 8) == "abcdeFgh" then
    score = score + 256
end
local half: any = calls.view(block, 3, 2, 1)
half[0] = 0x4847
if calls.text(block, 4) == "abGH" and calls.elementkind(half) == 3 then
    score = score + 512
end
calls.fill(tail, 4, 33)
if calls.text(calls.fromstring(calls.text(block, 8)), 8) == "abGH!!!!" then
    score = score + 1024
end
local tooFar = pcall(function(): any
    return calls.view(block, 1, 9)
end)
if not tooFar then
    score = score + 2048
end
local later: any = block + 6
if calls.elements(later) == 2 and later[0] == 33 then
    score = score + 4096
end
export = score
