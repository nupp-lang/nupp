module nupp.runtime.core.rawcatalogprobe

const native = require("nupp.runtime.vm.intrinsics")
const raw = require("nupp.runtime.core.rawcatalog")
const wire = require("nupp.runtime.core.rawwire")

-- The actual helper span is always the disjoint entry-owned spill region.
-- Aliased claimed helper arguments below point at ordinary test storage only.
export function probe(
    data: voidptr,
    bytes: uint64,
    out: voidptr,
    capacity: uint64,
    pool: voidptr,
    poolBytes: uint64,
    helper: voidptr,
    helperBytes: uint64
): uint64
    if raw.admit(data, 0ULL, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, 31ULL, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, 67108865ULL, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, 623ULL, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, 479ULL, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, 0ULL, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, poolBytes, helper, 0ULL) ~= 0ULL
        or raw.admit(native.pointer(0ULL), bytes, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(
            native.pointer(0xfffffffffffffff8ULL),
            bytes,
            out,
            capacity,
            pool,
            poolBytes,
            helper,
            helperBytes
        ) ~= 0ULL
        or raw.admit(
            data,
            bytes,
            native.pointer(0xfffffffffffffff8ULL),
            capacity,
            pool,
            poolBytes,
            helper,
            helperBytes
        ) ~= 0ULL
        or raw.admit(
            data,
            bytes,
            out,
            capacity,
            native.pointer(0xfffffffffffffff8ULL),
            poolBytes,
            helper,
            helperBytes
        ) ~= 0ULL
        or raw.admit(
            data,
            bytes,
            out,
            capacity,
            pool,
            poolBytes,
            native.pointer(0xfffffffffffffff8ULL),
            helperBytes
        ) ~= 0ULL
        or raw.admit(native.offset(data, 1), bytes, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, native.offset(out, 1), capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, native.offset(pool, 1), poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, poolBytes, native.offset(helper, 1), helperBytes) ~= 0ULL
    then
        return 2ULL
    end
    if raw.admit(data, bytes, data, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, data, bytes, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, poolBytes, data, bytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, out, capacity, helper, helperBytes) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, poolBytes, out, capacity) ~= 0ULL
        or raw.admit(data, bytes, out, capacity, pool, poolBytes, pool, poolBytes) ~= 0ULL
    then
        return 3ULL
    end
    local at = 0ULL
    while at < capacity do
        if native.load64(out, native.index(at)) ~= 0ULL then
            return 4ULL
        end
        at = at + 8ULL
    end
    local fixed = raw.workspaceBytes(0ULL, 0ULL)
    if raw.admit(data, bytes, out, capacity, pool, fixed - 1ULL, helper, helperBytes) ~= 0ULL then
        return 8ULL
    end
    local records, section, stringCount = 0ULL, 0ULL, 0ULL
    while section < wire.sectionCount do
        local count = native.load64(data, native.index(wire.headerBytes + section * wire.directoryBytes + wire.D_count))
        if section ~= wire.S_bytes then
            records = records + count
        end
        if section == wire.S_strings then
            stringCount = count
        end
        section = section + 1ULL
    end
    local required = raw.workspaceBytes(records, stringCount)
    if required >= poolBytes then
        return 9ULL
    end
    native.store64(pool, native.index(required), 90ULL)
    if raw.admit(data, bytes, out, capacity, pool, required - 1ULL, helper, helperBytes) ~= 0ULL
        or native.load64(pool, native.index(required)) ~= 90ULL
        or raw.admit(data, bytes, out, capacity, pool, required, helper, helperBytes) ~= 1ULL
        or native.load64(pool, native.index(required)) ~= 90ULL
    then
        return 10ULL
    end
    at = 0ULL
    while at < capacity do
        native.store64(out, native.index(at), 0ULL)
        at = at + 8ULL
    end
    native.store64(out, 472, 7ULL)
    if raw.admit(data, bytes, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or native.load64(out, 472) ~= 7ULL
    then
        return 5ULL
    end
    native.store64(out, 472, 0ULL)
    if raw.admit(data, bytes, out, capacity, pool, poolBytes, helper, helperBytes) ~= 1ULL then
        return 6ULL
    end
    local identity = native.load64(out, 8)
    if raw.admit(data, bytes, out, capacity, pool, poolBytes, helper, helperBytes) ~= 0ULL
        or native.load64(out, 8) ~= identity
        or native.load64(out, 0) ~= 3ULL
    then
        return 7ULL
    end
    -- End the test borrow before returning diagnostic output.
    at = 0ULL
    while at < capacity do
        native.store64(out, native.index(at), 0ULL)
        at = at + 8ULL
    end

    return 0ULL
end
