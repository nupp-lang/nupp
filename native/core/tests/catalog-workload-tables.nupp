module nupp.core.catalogworkloadtables

-- The `tables` workload of bench/vm/workloads.bench.nupp at scale 1, whose
-- checksum is 487886131; the scale stays an operand rather than folding away.
local scale = 1

local function tables(): number
    local counts: {[number]: number} = {}
    for i = 1, 3000000 do
        local k = (i * 7919 * scale) % 4099
        counts[k] = (counts[k] or 0) + 1
    end
    local arr: {number} = {}
    for i = 1, 1000000 do
        arr[i] = (i * scale) % 977
    end
    local sum = 0
    for _, v in ipairs(arr) do
        sum = sum + v
    end

    return sum + #counts
end

export = tables()
