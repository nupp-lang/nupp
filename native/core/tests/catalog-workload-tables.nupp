module nupp.core.catalogworkloadtables

-- The `tables` workload of bench/vm/workloads.bench.nupp, whose checksum
-- at scale 1 is 487886131. The scale is read from BENCH_SCALE at run time, as the
-- original reads it, so no compiler can fold it away.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1

local function tables(): number
    local counts: {[number]: number} = {}
    for i = 1, 3000000 do
        local k = (i * 7919 * scale) % 4099
        counts[k] = (counts[k] or 0) + 1
    end
    local arr: {number} = {}
    for i = 1, 1000000 do
        arr[i] = (i * scale) % 977
    end
    local sum = 0
    for _, v in ipairs(arr) do
        sum = sum + v
    end

    return sum + #counts
end

export const result = tables()
