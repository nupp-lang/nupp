module nupp.runtime.core.framerootchecks

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const collector = require("nupp.runtime.vm.collector")
const values = require("nupp.runtime.vm.values")
const roots = require("nupp.runtime.core.frameroots")

-- Integration helpers, not a standalone probe/entry or a manual Frame builder.
-- The cell/closure workload supplies a real heap and actual beginRoot/prepare/
-- publish/return lifecycle state. Every pointer borrows disjoint retained test
-- storage. No test here substitutes the frozen VM for native core execution.
export struct Fixture
    heap: uint64
    state: uint64
    control: uint64
    rootSerial: uint64
    outer: uint64
    inner: uint64
    result: uint64
    innerResult: uint64
    inputs: uint64
    inputCount: uint64
    expected: uint64
    expectedPairs: uint64
    outputValue: uint64
    outputCount: uint64
    alive: uint64
    aliveCount: uint64
    dead: uint64
    deadCount: uint64
end

local function begin(fixture: voidptr, scope: voidptr, result: voidptr): uint64
    return roots.publish(
        scope,
        native.loadPointer(fixture, native.fieldOffset<Fixture>("heap")),
        native.loadPointer(fixture, native.fieldOffset<Fixture>("state")),
        native.loadPointer(fixture, native.fieldOffset<Fixture>("control")),
        native.load64(fixture, native.fieldOffset<Fixture>("rootSerial")),
        native.loadPointer(fixture, native.fieldOffset<Fixture>("inputs")),
        native.load64(fixture, native.fieldOffset<Fixture>("inputCount")),
        result
    )
end

-- expected[] comes from actual workload-owned windows/closure/control addresses,
-- not by calling rootRanges to manufacture an oracle. Cases include an active
-- root, waiting ancestors, a fully prepared child, and retired pending NIL.
export function publication(fixture: voidptr): uint64
    local outer = native.loadPointer(fixture, native.fieldOffset<Fixture>("outer"))
    local inner = native.loadPointer(fixture, native.fieldOffset<Fixture>("inner"))
    local result = native.loadPointer(fixture, native.fieldOffset<Fixture>("result"))
    local innerResult = native.loadPointer(fixture, native.fieldOffset<Fixture>("innerResult"))
    local h = native.loadPointer(fixture, native.fieldOffset<Fixture>("heap"))
    local ranges = native.loadPointer(h, native.fieldOffset<heap.Heap>("ranges"))
    local base = native.loadPointer(ranges, native.fieldOffset<heap.Words>("base"))
    local before = native.load64(ranges, native.fieldOffset<heap.Words>("count"))
    local token = begin(fixture, outer, result)
    if token == 0ULL then
        return 1ULL
    end
    local after = native.load64(ranges, native.fieldOffset<heap.Words>("count"))
    local expected = native.loadPointer(fixture, native.fieldOffset<Fixture>("expected"))
    local pairs = native.load64(fixture, native.fieldOffset<Fixture>("expectedPairs"))
    if after ~= before + pairs * 2ULL + 4ULL then
        return 2ULL
    end
    local i: uint64 = 0ULL
    while i < pairs * 2ULL do
        if native.load64(
            base,
            native.index((before + i) * 8ULL)
        ) ~= native.load64(expected, native.index(i * 8ULL)) then
            return 3ULL
        end
        i = i + 1ULL
    end
    if roots.close(outer, token + 1ULL) ~= 0ULL
        or begin(fixture, outer, result) ~= 0ULL
        or native.load64(ranges, native.fieldOffset<heap.Words>("count")) ~= after
    then
        return 4ULL
    end
    local innerToken = begin(fixture, inner, innerResult)
    if innerToken == 0ULL then
        return 5ULL
    end
    local nested = native.load64(ranges, native.fieldOffset<heap.Words>("count"))
    if roots.close(outer, token) ~= 0ULL
        or native.load64(ranges, native.fieldOffset<heap.Words>("count")) ~= nested
        or roots.storeResult(inner, innerToken, values.TRUE, 0ULL) ~= 1ULL
        or native.load64(innerResult, native.fieldOffset<roots.Result>("value")) ~= values.NIL
        or native.load64(innerResult, native.fieldOffset<roots.Result>("count")) ~= 0ULL
        or native.load64(innerResult, native.fieldOffset<roots.Result>("ready")) ~= 1ULL
        or roots.close(inner, innerToken) ~= 1ULL
        or native.load64(ranges, native.fieldOffset<heap.Words>("count")) ~= after
    then
        return 6ULL
    end
    if roots.storeResult(outer, token, values.NIL, 1ULL) ~= 1ULL
        or native.load64(result, native.fieldOffset<roots.Result>("count")) ~= 1ULL
        or roots.storeResult(outer, token, values.TRUE, 1ULL) ~= 0ULL
        or roots.close(outer, token) ~= 1ULL
        or roots.close(outer, token) ~= 0ULL
        or native.load64(ranges, native.fieldOffset<heap.Words>("count")) ~= before
    then
        return 7ULL
    end

    return 0ULL
end

-- The integration producer provisions snapshots and capacity; this test changes
-- only a descriptor bound or legacy count, never passes an unmapped fake pointer.
-- A nonempty legacy task vector must refuse before its packed walker can run.
export function refusal(fixture: voidptr): uint64
    local h = native.loadPointer(fixture, native.fieldOffset<Fixture>("heap"))
    local ranges = native.loadPointer(h, native.fieldOffset<heap.Heap>("ranges"))
    local tasks = native.loadPointer(h, native.fieldOffset<heap.Heap>("tasks"))
    local outer = native.loadPointer(fixture, native.fieldOffset<Fixture>("outer"))
    local result = native.loadPointer(fixture, native.fieldOffset<Fixture>("result"))
    local before = native.load64(ranges, native.fieldOffset<heap.Words>("count"))
    local capacity = native.load64(ranges, native.fieldOffset<heap.Words>("capacity"))
    local token = native.load64(outer, native.fieldOffset<roots.Scope>("serial"))
    local phase = native.load64(outer, native.fieldOffset<roots.Scope>("phase"))
    native.store64(ranges, native.fieldOffset<heap.Words>("capacity"), before)
    local short = begin(fixture, outer, result)
    native.store64(ranges, native.fieldOffset<heap.Words>("capacity"), capacity)
    native.store64(tasks, native.fieldOffset<heap.Words>("count"), 1ULL)
    local legacy = begin(fixture, outer, result)
    native.store64(tasks, native.fieldOffset<heap.Words>("count"), 0ULL)
    if short ~= 0ULL
        or legacy ~= 0ULL
        or native.load64(ranges, native.fieldOffset<heap.Words>("count")) ~= before
        or native.load64(outer, native.fieldOffset<roots.Scope>("serial")) ~= token
        or native.load64(outer, native.fieldOffset<roots.Scope>("phase")) ~= phase
        or native.load64(result, native.fieldOffset<roots.Result>("value")) ~= values.NIL
        or native.load64(result, native.fieldOffset<roots.Result>("count")) ~= 0ULL
        or native.load64(result, native.fieldOffset<roots.Result>("ready")) ~= 0ULL
    then
        return 8ULL
    end

    return 0ULL
end

-- Draft combined-vertical-cut gate. Typed borrowed collector calls still require
-- compiler/effect admission; this source is not evidence they lower today. The
-- workload supplies objects held ONLY by final tagged windows/closure/control/
-- constructor inputs/result, plus unrooted objects whose bits occur ONLY in raw
-- numeric/helper slots. Cyclic cell/closure contents are constructed by the real
-- constructors; no fake heap or no-op collection is permitted.
export function collectPublished(h: heap.Heap*, fixture: voidptr): uint64
    if native.address(h) ~= native.load64(fixture, native.fieldOffset<Fixture>("heap")) then
        return 9ULL
    end
    local outer = native.loadPointer(fixture, native.fieldOffset<Fixture>("outer"))
    local result = native.loadPointer(fixture, native.fieldOffset<Fixture>("result"))
    local token = begin(fixture, outer, result)
    if token == 0ULL then
        return 10ULL
    end
    if roots.storeResult(
        outer,
        token,
        native.load64(fixture, native.fieldOffset<Fixture>("outputValue")),
        native.load64(fixture, native.fieldOffset<Fixture>("outputCount"))
    ) ~= 1ULL then
        return 14ULL
    end
    collector.fullCycle(h)
    local alive = native.loadPointer(fixture, native.fieldOffset<Fixture>("alive"))
    local aliveCount = native.load64(fixture, native.fieldOffset<Fixture>("aliveCount"))
    local dead = native.loadPointer(fixture, native.fieldOffset<Fixture>("dead"))
    local deadCount = native.load64(fixture, native.fieldOffset<Fixture>("deadCount"))
    local i: uint64 = 0ULL
    while i < aliveCount do
        if not heap.isLiveSlot(h, native.load64(alive, native.index(i * 8ULL))) then
            return 11ULL
        end
        i = i + 1ULL
    end
    i = 0ULL
    while i < deadCount do
        if heap.isLiveSlot(h, native.load64(dead, native.index(i * 8ULL))) then
            return 12ULL
        end
        i = i + 1ULL
    end
    if collector.checkOracle(h, true) ~= 0ULL or roots.close(outer, token) ~= 1ULL then
        return 13ULL
    end

    return 0ULL
end
