module nupp.core.catalogstringsformat

-- string.format's integer and string conversions with flags, width and
-- precision, checked as one checksum over everything they wrote.
local parts: {string} = {}

local function add(text: string): nil
    parts[#parts + 1] = text
end

add(string.format("%5d|%-5d|%05d", 42, 42, 42))
add(string.format("%+d|% d|%.4d", 7, 7, 7))
add(string.format("%x|%X|%#x", 255, 255, 255))
add(string.format("%o|%#o|%08X", 8, 8, 48879))
add(string.format("%c%c%c", 78, 117, 112))
add(string.format("[%10s][%-10s][%.3s]", "core", "core", "nupp"))
add(string.format("%i|%d|%x", -12, 3.0, -1))
add(string.format("%5.2s|%%|%-3c|", "abc", 65))
local text = table.concat(parts, "\n")
local hash: integer = 0
for i = 1, #text do
    hash = (hash * 31 + (string.byte(text, i) or 0)) % 1000000007
end
export = hash * 100 + #text % 100
