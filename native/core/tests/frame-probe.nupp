module nupp.runtime.core.frameprobe

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const arena = require("nupp.runtime.core.arena")
const frames = require("nupp.runtime.core.frames")

const BAD_BINDINGS = 1ULL
const BAD_LAYOUT = 2ULL
const BAD_PLAN = 3ULL
const REFUSAL_MUTATION = 4ULL
const BAD_SETUP = 5ULL
const BAD_ARGUMENTS = 6ULL
const BAD_PENDING = 7ULL
const BAD_ABORT = 8ULL
const BAD_PUBLISH = 9ULL
const BAD_RETURN = 10ULL
const BAD_NESTED = 11ULL
const BAD_REFUSAL = 12ULL
const BAD_REUSE = 13ULL
const BAD_CODE_ALIAS = 14ULL

local function copy(to: voidptr, from: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        native.store64(to, native.index(at), native.load64(from, native.index(at)))
        at = at + 8ULL
    end

    return 1ULL
end

local function same(a: voidptr, b: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        if native.load64(a, native.index(at)) ~= native.load64(b, native.index(at)) then
            return 0ULL
        end
        at = at + 8ULL
    end

    return 1ULL
end

local function initializeInfo(info: voidptr, code: uint64, id: uint64, parameters: uint64): uint64
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("version"), 1ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("id"), id)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("bodyOwner"), code)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("code"), code)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("instructionCount"), 2ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("nparams"), parameters)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("parameterClass"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("resultClass"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("flags"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("valueCount"), 8ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("integerCount"), 2ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("floatCount"), 2ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("vectorCount"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("objectBytes"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("spillBytes"), 0ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("rootDescriptor"), 0ULL)

    return 1ULL
end

-- This is test-only root initialization, not a second runtime entry policy.
local function initializeRoot(root: voidptr, info: voidptr, plan: voidptr): uint64
    local address = native.address(root)
    native.store64(root, native.fieldOffset<frames.Frame>("previous"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("functionInfo"), native.address(info))
    native.store64(root, native.fieldOffset<frames.Frame>("windowPlan"), native.address(plan))
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("functionId"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("id"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("bodyOwner"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("bodyOwner"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("code"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("code"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("instructionCount"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("instructionCount"))
    )
    native.store64(root, native.fieldOffset<frames.Frame>("resumePC"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("closureRoot"), values.NIL)
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("values"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("values"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("integers"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("integers"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("floats"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("floats"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("vectors"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("vectors"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("objects"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("objects"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("spills"),
        address + native.load64(plan, native.fieldOffset<frames.WindowPlan>("spills"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("valueCount"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("valueCount"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("integerCount"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("integerCount"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("floatCount"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("floatCount"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("vectorCount"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("vectorCount"))
    )
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("rootDescriptor"),
        native.load64(info, native.fieldOffset<frames.FunctionInfo>("rootDescriptor"))
    )
    native.store64(root, native.fieldOffset<frames.Frame>("objectBytes"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("spillBytes"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("liveValues"), 8ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("resultKind"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("resultOwner"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("resultSlot"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("resultCount"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("cleanupCursor"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("frameMark"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("dataMark"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("spillMark"), 0ULL)
    native.store64(
        root,
        native.fieldOffset<frames.Frame>("reservationBytes"),
        native.load64(plan, native.fieldOffset<frames.WindowPlan>("bytes"))
    )
    native.store64(root, native.fieldOffset<frames.Frame>("child"), 0ULL)
    native.store64(root, native.fieldOffset<frames.Frame>("phase"), frames.ACTIVE)
    local slots = native.loadPointer(root, native.fieldOffset<frames.Frame>("values"))
    local i: uint64 = 0ULL
    while i < 8ULL do
        native.store64(slots, native.index(i * 8ULL), values.NIL)
        i = i + 1ULL
    end

    return 1ULL
end

local function snapshot(
    control: voidptr,
    state: voidptr,
    segment: voidptr,
    root: voidptr,
    rootBytes: uint64,
    pool: voidptr
): uint64
    copy(native.offset(control, 512), state, native.sizeOf<frames.State>())
    copy(native.offset(control, 576), segment, native.sizeOf<arena.Segment>())
    copy(native.offset(control, 640), root, rootBytes)
    copy(native.offset(control, 1152), pool, 896ULL)

    return 1ULL
end

local function unchanged(
    control: voidptr,
    state: voidptr,
    segment: voidptr,
    root: voidptr,
    rootBytes: uint64,
    pool: voidptr
): uint64
    if same(native.offset(control, 512), state, native.sizeOf<frames.State>()) == 0ULL
        or same(native.offset(control, 576), segment, native.sizeOf<arena.Segment>()) == 0ULL
        or same(native.offset(control, 640), root, rootBytes) == 0ULL
        or same(native.offset(control, 1152), pool, 896ULL) == 0ULL
    then
        return 0ULL
    end
    local at: uint64 = 896ULL
    while at < 2048ULL do
        if native.load64(pool, native.index(at)) ~= 0ULL then
            return 0ULL
        end
        at = at + 8ULL
    end

    return 1ULL
end

-- Only this test packet assigns pc+4 u32=whole-chain helper extent (<65536),
-- pc+8 u64=helper offset relative to context. Its Nupp producer/verifier must
-- bind both words to actual generated spillOffset/whole-chain extent. They are
-- not production opcode operands or a new entry ABI.
-- The entry lends disjoint 2048-byte regs/ints/floats windows. Control templates
-- and snapshots occupy regs; the root/fake frames occupy floats; ints contains
-- an 896-byte logical arena followed by an untouched canary region. Every field
-- offset/size below comes from the Nupp definitions, not a provider layout table.
export function CoreFrameProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local helperOffset = native.load64(pc, 8)
    local helperBytes = native.word(native.load32(pc, 4))
    local contextAddress = native.address(context)
    if helperBytes == 0ULL or helperBytes >= 65536ULL or helperOffset > 0xffffffffffffffffULL - contextAddress then
        return BAD_BINDINGS
    end
    local helperBase = contextAddress + helperOffset
    if helperBytes > 0xffffffffffffffffULL - helperBase then
        return BAD_BINDINGS
    end
    if helperBase < native.address(regs) + 2048ULL and native.address(regs) < helperBase + helperBytes
        or helperBase < native.address(ints) + 2048ULL and native.address(ints) < helperBase + helperBytes
        or helperBase < native.address(floats) + 2048ULL and native.address(floats) < helperBase + helperBytes
    then
        return BAD_BINDINGS
    end
    if native.sizeOf<frames.FunctionInfo>() > 128ULL
        or native.sizeOf<frames.WindowPlan>() > 64ULL
        or native.sizeOf<frames.State>() > 64ULL
        or native.sizeOf<arena.Segment>() > 64ULL
        or (native.address(floats) & 15ULL) ~= 0ULL
    then
        return BAD_LAYOUT
    end
    local at: uint64 = 0ULL
    while at < 2048ULL do
        native.store64(regs, native.index(at), 0ULL)
        native.store64(ints, native.index(at), 0ULL)
        native.store64(floats, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local rootInfo = regs
    local calleeInfo = native.offset(regs, 128)
    local rootPlan = native.offset(regs, 256)
    local calleePlan = native.offset(regs, 320)
    local state = native.offset(regs, 384)
    local segment = native.offset(regs, 448)
    local root = floats
    local wrong = native.offset(floats, 512)
    initializeInfo(rootInfo, native.address(pc), 0ULL, 0ULL)
    initializeInfo(calleeInfo, native.address(pc), 1ULL, 3ULL)
    if frames.planFixed(rootInfo, rootPlan) ~= 1ULL or frames.planFixed(calleeInfo, calleePlan) ~= 1ULL then
        return BAD_PLAN
    end
    local rootBytes = native.load64(rootPlan, native.fieldOffset<frames.WindowPlan>("bytes"))
    local calleeBytes = native.load64(calleePlan, native.fieldOffset<frames.WindowPlan>("bytes"))
    if rootBytes > 512ULL or calleeBytes > 448ULL then
        return BAD_LAYOUT
    end
    copy(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>())
    -- Both aliases are real mapped buffers; neither is executed as code.
    local aliasIndex: uint64 = 0ULL
    while aliasIndex < 2ULL do
        local codeAlias = native.address(calleePlan)
        if aliasIndex == 1ULL then
            codeAlias = native.address(calleeInfo)
        end
        native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), codeAlias)
        copy(native.offset(regs, 1728), calleeInfo, native.sizeOf<frames.FunctionInfo>())
        if frames.planFixed(calleeInfo, calleePlan) ~= 0ULL
            or same(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>()) == 0ULL
            or same(native.offset(regs, 1728), calleeInfo, native.sizeOf<frames.FunctionInfo>()) == 0ULL
        then
            return BAD_CODE_ALIAS
        end
        aliasIndex = aliasIndex + 1ULL
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("flags"), 1ULL)
    if frames.planFixed(calleeInfo, calleePlan) ~= 0ULL then
        return BAD_PLAN
    end
    if same(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>()) == 0ULL then
        return REFUSAL_MUTATION
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("flags"), 0ULL)
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("valueCount"), 0xffffffffffffffffULL)
    if frames.planFixed(calleeInfo, calleePlan) ~= 0ULL
        or same(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>()) == 0ULL
    then
        return BAD_PLAN
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("valueCount"), 8ULL)
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("integerCount"), 0xffffffffffffffffULL)
    if frames.planFixed(calleeInfo, calleePlan) ~= 0ULL
        or same(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>()) == 0ULL
    then
        return BAD_PLAN
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("integerCount"), 2ULL)
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), 0xfffffffffffffff0ULL)
    if frames.planFixed(calleeInfo, calleePlan) ~= 0ULL
        or same(native.offset(regs, 1664), calleePlan, native.sizeOf<frames.WindowPlan>()) == 0ULL
    then
        return BAD_PLAN
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    if arena.initialize(segment, native.address(ints), 896ULL) ~= 1ULL then
        return BAD_SETUP
    end
    initializeRoot(root, rootInfo, rootPlan)
    initializeRoot(wrong, calleeInfo, calleePlan)
    native.store64(wrong, native.fieldOffset<frames.Frame>("previous"), native.address(root))
    native.store64(wrong, native.fieldOffset<frames.Frame>("resultKind"), frames.CALLER_DESTINATION)
    native.store64(wrong, native.fieldOffset<frames.Frame>("resultOwner"), native.address(root))
    native.store64(wrong, native.fieldOffset<frames.Frame>("resultSlot"), 4ULL)
    native.store64(wrong, native.fieldOffset<frames.Frame>("resultCount"), 1ULL)
    native.store64(
        wrong,
        native.fieldOffset<frames.Frame>("frameMark"),
        native.address(root) + native.word(native.fieldOffset<frames.Frame>("childMark"))
    )
    native.store64(wrong, native.fieldOffset<frames.Frame>("phase"), frames.PREPARED)
    native.store64(state, native.fieldOffset<frames.State>("active"), native.address(root))
    native.store64(state, native.fieldOffset<frames.State>("depth"), 1ULL)
    native.store64(state, native.fieldOffset<frames.State>("limit"), 4ULL)
    native.store64(state, native.fieldOffset<frames.State>("segment"), native.address(segment))
    native.store64(state, native.fieldOffset<frames.State>("lastResultCount"), 0ULL)
    native.store64(state, native.fieldOffset<frames.State>("helperBase"), helperBase)
    native.store64(state, native.fieldOffset<frames.State>("helperBytes"), helperBytes)
    local rootSlots = native.loadPointer(root, native.fieldOffset<frames.Frame>("values"))
    local fortyTwo = values.TAG_INTEGER | 42ULL
    native.store64(rootSlots, 8, fortyTwo)
    native.store64(rootSlots, 16, values.TRUE)
    native.store64(rootSlots, 24, values.FALSE)
    -- Exercise all mutable owners while preserving valid mapped extents.
    aliasIndex = 0ULL
    while aliasIndex < 4ULL do
        local codeAlias = native.address(state)
        if aliasIndex == 1ULL then
            codeAlias = native.address(segment)
        elseif aliasIndex == 2ULL then
            codeAlias = helperBase
        elseif aliasIndex == 3ULL then
            codeAlias = native.address(rootSlots)
        end
        native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), codeAlias)
        snapshot(regs, state, segment, root, rootBytes, ints)
        if frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan) ~= 0ULL
            or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
            or native.load64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code")) ~= codeAlias
        then
            return BAD_CODE_ALIAS
        end
        aliasIndex = aliasIndex + 1ULL
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    native.store64(rootInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(rootSlots))
    native.store64(root, native.fieldOffset<frames.Frame>("code"), native.address(rootSlots))
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_CODE_ALIAS
    end
    native.store64(rootInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    native.store64(root, native.fieldOffset<frames.Frame>("code"), native.address(pc))
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 8ULL, calleePlan) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_REFUSAL
    end
    local childAddress = frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan)
    if childAddress == 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= native.address(root)
        or native.load64(root, native.fieldOffset<frames.Frame>("phase")) ~= frames.ACTIVE
    then
        return BAD_PENDING
    end
    local child = native.pointer(childAddress)
    local childSlots = native.loadPointer(child, native.fieldOffset<frames.Frame>("values"))
    if native.load64(childSlots, 8) ~= fortyTwo
        or native.load64(childSlots, 16) ~= values.NIL
        or native.load64(childSlots, 24) ~= values.NIL
        or native.load64(child, native.fieldOffset<frames.Frame>("closureRoot")) ~= values.NIL
        or native.load64(child, native.fieldOffset<frames.Frame>("liveValues")) ~= 8ULL
    then
        return BAD_ARGUMENTS
    end
    local checkedSlot: uint64 = 0ULL
    while checkedSlot < 8ULL do
        if checkedSlot ~= 1ULL and native.load64(childSlots, native.index(checkedSlot * 8ULL)) ~= values.NIL then
            return BAD_ARGUMENTS
        end
        checkedSlot = checkedSlot + 1ULL
    end
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan) ~= 0ULL
        or frames.publish(state, root, wrong, 1ULL) ~= 0ULL
        or frames.abortPrepared(state, root, wrong) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_PENDING
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(rootSlots))
    native.store64(child, native.fieldOffset<frames.Frame>("code"), native.address(rootSlots))
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.publish(state, root, child, 1ULL) ~= 0ULL
        or frames.abortPrepared(state, root, child) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_CODE_ALIAS
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    native.store64(child, native.fieldOffset<frames.Frame>("code"), native.address(pc))
    if frames.abortPrepared(state, root, child) ~= 1ULL
        or native.load64(segment, native.fieldOffset<arena.Segment>("cursor")) ~= native.address(ints)
        or native.load64(root, native.fieldOffset<frames.Frame>("child")) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= native.address(root)
    then
        return BAD_ABORT
    end
    -- More evaluated arguments than parameters do not create extra parameters.
    childAddress = frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 4ULL, 4ULL, calleePlan)
    if childAddress == 0ULL then
        return BAD_ARGUMENTS
    end
    child = native.pointer(childAddress)
    childSlots = native.loadPointer(child, native.fieldOffset<frames.Frame>("values"))
    if native.load64(childSlots, 8) ~= fortyTwo
        or native.load64(childSlots, 16) ~= values.TRUE
        or native.load64(childSlots, 24) ~= values.FALSE
        or native.load64(childSlots, 32) ~= values.NIL
    then
        return BAD_ARGUMENTS
    end
    if frames.publish(state, root, child, 1ULL) ~= 1ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= childAddress
        or native.load64(root, native.fieldOffset<frames.Frame>("phase")) ~= frames.WAITING
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 2ULL
    then
        return BAD_PUBLISH
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(rootSlots))
    native.store64(child, native.fieldOffset<frames.Frame>("code"), native.address(rootSlots))
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.returnScalar(state, child, values.TRUE) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_CODE_ALIAS
    end
    native.store64(calleeInfo, native.fieldOffset<frames.FunctionInfo>("code"), native.address(pc))
    native.store64(child, native.fieldOffset<frames.Frame>("code"), native.address(pc))
    native.store64(child, native.fieldOffset<frames.Frame>("resultSlot"), 8ULL)
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.returnScalar(state, child, values.TRUE) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_RETURN
    end
    native.store64(child, native.fieldOffset<frames.Frame>("resultSlot"), 4ULL)
    local childMark = native.offset(root, native.fieldOffset<frames.Frame>("childMark"))
    local serial = native.load64(childMark, native.fieldOffset<arena.Mark>("serial"))
    native.store64(childMark, native.fieldOffset<arena.Mark>("serial"), 0ULL)
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.returnScalar(state, child, values.TRUE) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_RETURN
    end
    native.store64(childMark, native.fieldOffset<arena.Mark>("serial"), serial)
    -- Nested calls use the same logical layout and caller-resident mark rule.
    local grandAddress = frames.prepareFixed(state, child, calleeInfo, values.NIL, 0ULL, 1ULL, 5ULL, calleePlan)
    if grandAddress == 0ULL then
        return BAD_NESTED
    end
    local grand = native.pointer(grandAddress)
    if frames.publish(state, child, grand, 1ULL) ~= 1ULL
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 3ULL
    then
        return BAD_NESTED
    end
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.returnScalar(state, child, values.FALSE) ~= 0ULL
        or frames.prepareFixed(state, grand, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_NESTED
    end
    if frames.returnScalar(state, grand, values.TRUE) ~= 1ULL
        or native.load64(childSlots, 40) ~= values.TRUE
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= childAddress
    then
        return BAD_NESTED
    end
    -- Select the result before the callee reservation is retired, as canonical
    -- Ret will. This is a value transport probe, not a Ret implementation.
    local selected = native.load64(childSlots, 8)
    if frames.returnScalar(state, child, selected) ~= 1ULL
        or native.load64(rootSlots, 32) ~= fortyTwo
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= native.address(root)
        or native.load64(state, native.fieldOffset<frames.State>("lastResultCount")) ~= 1ULL
        or native.load64(segment, native.fieldOffset<arena.Segment>("cursor")) ~= native.address(ints)
    then
        return BAD_RETURN
    end
    native.store64(state, native.fieldOffset<frames.State>("limit"), 1ULL)
    snapshot(regs, state, segment, root, rootBytes, ints)
    if frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 1ULL, 4ULL, calleePlan) ~= 0ULL
        or unchanged(regs, state, segment, root, rootBytes, ints) == 0ULL
    then
        return BAD_REFUSAL
    end
    native.store64(state, native.fieldOffset<frames.State>("limit"), 4ULL)
    local reused = frames.prepareFixed(state, root, calleeInfo, values.NIL, 0ULL, 0ULL, 6ULL, calleePlan)
    if reused ~= childAddress then
        return BAD_REUSE
    end
    local reusedSlots = native.loadPointer(native.pointer(reused), native.fieldOffset<frames.Frame>("values"))
    if native.load64(reusedSlots, 8) ~= values.NIL
        or native.load64(rootSlots, 32) ~= fortyTwo
        or frames.abortPrepared(state, root, native.pointer(reused)) ~= 1ULL
    then
        return BAD_REUSE
    end
    local tail: uint64 = 896ULL
    while tail < 2048ULL do
        if native.load64(ints, native.index(tail)) ~= 0ULL then
            return REFUSAL_MUTATION
        end
        tail = tail + 8ULL
    end

    return 0ULL
end
