module nupp.core.catalogclockprovider

local clock = assert(require("nupp.runtime.timeprovider").provider)
local suspension = require("nupp.suspension")
local primitives: any = coroutine
assert(primitives == _G.coroutine)
local running = primitives.running
local main, ismain = running()
assert(main ~= nil and ismain and not primitives.isyieldable())
local co = primitives.create(function(value: any): any
    local answer = primitives.yield(value + 1)
    return answer
end)
local started, yielded = primitives.resume(co, 4)
assert(started and yielded == 5 and primitives.status(co) == "suspended")
local finished, answer = primitives.resume(co, 9)
assert(finished and answer == 9 and primitives.status(co) == "dead")
assert(primitives.close(co))
local wrapped = primitives.wrap(function(value: any): any
    return value * 2
end)
assert(wrapped(3) == 6)

local function noarguments(): ()
end

local directempty = coroutine.create(
    function(value: any): any
        return value
    end,
    noarguments()
)
local directok, directvalue = coroutine.resume(directempty, 13)
assert(directok and directvalue == 13)

local empty = primitives.create(
    function(value: any): any
        return value
    end,
    noarguments()
)
local emptyok, emptyvalue = primitives.resume(empty, 17)
assert(emptyok and emptyvalue == 17)
local boundnil = primitives.create(
    function(...: any): (integer, any)
        return select("#", ...), ...
    end,
    nil
)
local nilok, nilcount, nilvalue = primitives.resume(boundnil, 19)
assert(nilok and nilcount == 1 and nilvalue == nil)
local boundzero = primitives.create(
    function(value: any): any
        return value
    end,
    0
)
local zerook, zerovalue = primitives.resume(boundzero, 23)
assert(zerook and zerovalue == 0)
local boundmany = primitives.create(
    function(...: any): (integer, any, any, any)
        local count = select("#", ...)
        local first, second, third = ...
        local resumed = primitives.yield(count, first, second, third)
        return count, first, third, resumed
    end,
    29,
    31,
    nil
)
local manyok, manycount, manyfirst, manysecond, manythird = primitives.resume(boundmany, 37)
assert(manyok and manycount == 3 and manyfirst == 29 and manysecond == 31 and manythird == nil)
local manydone, finalcount, finalfirst, finalthird, resumed = primitives.resume(boundmany, 41)
assert(manydone and finalcount == 3 and finalfirst == 29 and finalthird == nil and resumed == 41)

local score = 0
local before = clock.now()
local epoch = os.walltime()
if before >= 0 and epoch > 1600000000000 then
    score = score | 1
end
local fired = false
local cancel = clock.wakeat(before, function(_: boolean): nil
    fired = true
end)
cancel()
cancel()
suspension.poll()
if not fired then
    score = score | 2
end
clock.wakeat(before, function(_: boolean): nil
    fired = true
end)
suspension.poll()
if fired then
    score = score | 4
end
clock.sleep(0)
clock.sleep(2)
if clock.now() >= before + 2 then
    score = score | 8
end
clock.sleepuntil(clock.now())
if not pcall(clock.sleep, -1) and not pcall(clock.wakeat, -1, function(_: boolean): nil
end) then
    score = score | 16
end
local public = os.monotonic()
if public >= before and os.walltime() >= epoch then
    score = score | 32
end
export = score
