module nupp.core.guestprogramproducer

local contract = require("nupp.compiler.vm.nativeframecontract")
local lower = require("nupp.compiler.vm.lower")
local profile = require("nupp.compiler.vm.nativegraph")
require("nupp.compiler.hostservices")
require("nupp.compiler.syntax.parser")
require("nupp.compiler.check")
require("nupp.compiler.project.env")
require("nupp.compiler.vm.programgraph")
require("nupp.compiler.vm.taggedprofile")
local executable = require("nupp.compiler.vm.coregraphexecutable")
local graph = require("nupp.compiler.vm.graph")
local sink = require("nupp.compiler.s0.nativegraph")
local shim = require("nupp.core.guestshim")
local auditshim = require("nupp.core.guestauditshim")
local writer = require("nupp.core.guestartifact")
local linker = require("nupp.core.link")
local json = require("nupp.codec.json")
local producer = {}

local function shallow(value: any): any
    local result = {}
    for key, item in pairs(value) do
        result[key] = item
    end

    return result
end

local function hex(value: string): string
    return (value:gsub(".", function(byte: string): string
        return string.format("%02x", byte:byte())
    end))
end

-- Selection, authenticated linking and final byte publication stay in one
-- process. JSON output is an immutable transport artifact, not a reissuable
-- compiler capability or permission to select caller-supplied guest bytes.
local function compile(caseName: string, mode: string, capacityText: string, scenario: string?): string
    assert(mode == "normal" or mode == "spill")
    local capacity = assert(tonumber(capacityText)) as integer
    assert(capacity == 65536 or capacity == 131072)
    assert(type(lower.functionGraph) == "function" and type(profile.initialize) == "function")
    local source = scenario and contract.buildGuestAudit(caseName) or contract.buildGuest(caseName)
    local refusals = {}

    local function reject(name: string, operation: function(): any, expected: string): nil
        local ok, problem = pcall(operation)
        assert(not ok and tostring(problem):find(expected, 1, true), name .. ": " .. tostring(problem))
        refusals[#refusals + 1] = {name = name, diagnostic = tostring(problem)}
    end

    reject(
        "copied build",
        function(): any
            return contract.validateGuest(shallow(source))
        end,
        "unissued guest build"
    )
    for _, name in ipairs({"nupp.runtime.core.guestcatalog", "nupp.runtime.vm.values"}) do
        local original = source.scopes[name]
        source.scopes[name] = shallow(original)
        reject(
            "copied scope " .. name,
            function(): any
                return contract.validateGuest(source)
            end,
            "guest scope identity changed"
        )
        source.scopes[name] = {name = original.name, path = original.path, checkedExports = original.checkedExports}
        reject(
            "forged scope " .. name,
            function(): any
                return contract.validateGuest(source)
            end,
            "guest scope identity changed"
        )
        source.scopes[name] = original
    end
    setmetatable(source.scopes, {__index = {forged = {}}})
    reject(
        "scope metatable",
        function(): any
            return contract.validateGuest(source)
        end,
        "guest maps must remain plain"
    )
    setmetatable(source.scopes, nil)
    source.scopes.extra = source.context
    reject(
        "extra scope",
        function(): any
            return contract.validateGuest(source)
        end,
        "guest scope inventory changed"
    )
    source.scopes.extra = nil
    setmetatable(source.resolved, {__index = {forged = {}}})
    reject(
        "resolved metatable",
        function(): any
            return contract.validateGuest(source)
        end,
        "guest maps must remain plain"
    )
    setmetatable(source.resolved, nil)
    local fn = source.executable.functions[1]
    local bytes = fn.code
    fn.code = string.char((bytes:byte(1) + 1) % 256) .. bytes:sub(2)
    reject(
        "changed executable bytes",
        function(): any
            return executable.validate(source.executable)
        end,
        "changed"
    )
    fn.code = bytes
    reject(
        "copied executable",
        function(): any
            return executable.validate(shallow(source.executable))
        end,
        "unissued"
    )
    contract.validateGuest(source)
    local guestGraph = source.resolved["nupp.runtime.core.guesthandlers.CallK"].graph
    reject(
        "unissued guest slots",
        function(): any
            return contract.requireGuestSlots({})
        end,
        "original guest handler graph required"
    )
    reject(
        "copied guest slot graph",
        function(): any
            return contract.requireGuestSlots(shallow(guestGraph))
        end,
        "original guest handler graph required"
    )
    local slotMarker = guestGraph.nativeFinalFrame
    guestGraph.nativeFinalFrame = nil
    reject(
        "changed guest slot graph",
        function(): any
            return contract.requireGuestSlots(guestGraph)
        end,
        "marker changed"
    )
    guestGraph.nativeFinalFrame = slotMarker
    local names, selected, results, metrics = {}, {}, {}, {}
    for name in pairs(source.resolved) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        local item = source.resolved[name]
        local result = sink.compilerGraph(item.graph, item.owner.name, item.owner, source.resolved, source.context)
        local allocation = sink.selectAuthenticated(result, mode)
        results[name], selected[name] = result, allocation.code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            frameBytes = allocation.code.frameBytes,
            spillSlots = allocation.spillSlots,
            integerRegisters = allocation.integerRegisters,
            floatRegisters = allocation.floatRegisters,
            calls = #allocation.code.fixupName
        }
    end
    local entryName = "nupp.runtime.core.guesthandlers.CallK"
    local item, result, code = source.resolved[entryName], results[entryName], selected[entryName]
    reject(
        "copied Result",
        function(): any
            return sink.selectAuthenticated(shallow(result), mode)
        end,
        "original authenticated Result required"
    )
    reject(
        "caller allocator ABI",
        function(): any
            local forged: any = {}
            return sink.selectAuthenticated(result, forged)
        end,
        "closed allocation mode required"
    )
    local other = source.resolved["nupp.runtime.core.guesthandlers.Ret"]
    reject(
        "different selected origin",
        function(): any
            return sink.verifyCodeOrigin(code, other.graph, other.owner)
        end,
        "origin"
    )
    reject(
        "copied Code",
        function(): any
            return sink.verifyCode(shallow(code))
        end,
        "authenticated Code required"
    )
    reject(
        "issued Code legacy link",
        function(): any
            return linker.assemble({}, {code}, {}, 65536)
        end,
        "issued Code requires authenticated linking"
    )
    local marker = item.graph.nativeFinalFrame
    item.graph.nativeFinalFrame = nil
    reject(
        "removed graph marker",
        function(): any
            return graph.verify(item.graph)
        end,
        "marker changed"
    )
    item.graph.nativeFinalFrame = marker
    local contextCopy = shallow(source.context)
    reject(
        "different checked context",
        function(): any
            return sink.compilerGraph(item.graph, item.owner.name, item.owner, source.resolved, contextCopy)
        end,
        "checked context substitution"
    )
    contract.validateGuest(source)
    local output = shim.build(source, selected, capacity)
    if scenario then
        local audited = auditshim.build(source, selected, output, scenario)
        output.audit = {
            scenario = scenario,
            expectedStatus = audited.expectedStatus,
            expectedUsed = audited.expectedUsed,
            expectedOwner = audited.expectedOwner,
            expectedPC = audited.expectedPC,
            snapshotOffset = audited.snapshotOffset,
            snapshotBytes = audited.snapshotBytes,
            workspaceOffset = audited.workspaceOffset,
            workspaceBytes = audited.workspaceBytes,
            primaryEntry = output.entry,
            primaryWords = #output.words,
            primaryScratchBytes = output.scratchBytes,
            primarySpillOffset = output.spillOffset,
            primaryCallBytes = output.callBytes
        }
        output.words, output.entry, output.scratchBytes = audited.words, audited.entry, audited.scratchBytes
        output.spillOffset, output.callBytes = audited.spillOffset, audited.callBytes
    end
    local packed = writer.encode(source.executable, source.scopes, output.dispatch, #output.words * 4)
    contract.validateGuest(source)
    local programs = {}
    for _, body in ipairs(source.executable.functions) do
        local constants = {}
        for index, constant in ipairs(body.constants) do
            constants[index] = {kind = constant.kind, valueHex = hex(constant.value)}
        end
        programs[
            #programs + 1
        ] = {
            owner = body.owner,
            instructions = body.instructions,
            codeHex = hex(body.code),
            instructionCount = body.instructionCount,
            valueCount = body.valueCount,
            calls = body.calls,
            constants = constants
        }
    end
    output.dataHex, output.dataBytes = hex(packed.bytes), #packed.bytes
    output.mode, output.caseName, output.metrics = mode, caseName, metrics
    output.programs, output.dataflowRefusals, output.provenanceRefusals = programs, source.refusals, refusals
    output.instanceBound = source.executable.instanceCapacity
    output.instanceCapacity = source.executable.instanceCapacity
    output.instanceCreations = source.executable.instanceCreations
    output.frameDepth = source.executable.frameDepth
    output.catalogOffsets = {
        code = packed.codeOffsets,
        constants = packed.constantOffsets,
        dispatch = packed.dispatchOffset
    }
    output.scope = "Checked acyclic scalar guests, with v3 source-bound number addition; no named exports, cycles, general loader, tagged objects or GC"

    return json.encode(output)
end

function producer.compile(caseName: string, mode: string, capacityText: string): string
    return compile(caseName, mode, capacityText, nil)
end

function producer.audit(caseName: string, mode: string, capacityText: string, scenario: string): string
    return compile(caseName, mode, capacityText, scenario)
end

-- The raw profile issues the fixed loader and guest services in one checked
-- source session. Raw graph bytes are supplied only after this code is linked.
function producer.compileRaw(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local source = contract.buildGuest("raw")
    local names, selected, metrics = {}, {}, {}
    for name in pairs(source.resolved) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        local item = source.resolved[name]
        local result = sink.compilerGraph(item.graph, item.owner.name, item.owner, source.resolved, source.context)
        local allocation = sink.selectAuthenticated(result, mode)
        selected[name] = allocation.code
        metrics[
            #metrics + 1
        ] = {name = name, spillSlots = allocation.spillSlots, frameBytes = allocation.code.frameBytes}
    end
    local output = shim.build(source, selected, 33554432, true)
    output.metrics, output.mode = metrics, mode
    output.scope = "Issued v2 raw graph service to retained guest entry: one initializer, scalar K/Nil/Move/Ret"

    return json.encode(output)
end

export = producer
