module nupp.core.rawsemanticfixture

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local program = require("nupp.compiler.vm.programgraph")
local tagged = require("nupp.compiler.vm.taggedprofile")
local contracts = require("nupp.compiler.vm.coregraphcontracts")
local codec = require("nupp.compiler.vm.coregraphcodec")
local schema = require("nupp.compiler.vm.coregraphschema")
local budget = require("nupp.compiler.vm.coregraphbudget")
local json = require("serde.json")
require("nupp.compiler.syntax.triviaarena.table")
require("nupp.compiler.project.projectconfig")
require("nupp.compiler.hash")
local rawheader = require("nupp.core.rawheaderfixture")

local function encoded(source: string): any
    local path, name = "=raw_catalog_fixture.nupp", "raw_catalog_fixture"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0, "raw graph fixture parse")
    local env: any = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = checker.check(parsed, path, env, {
        moduleName = name,
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    local catalog = program.describe({{name = name, path = path, parsed = parsed, diagnostics = diagnostics}}, name)

    return contracts.normalize(program.compile(catalog, tagged))
end

export function data(): string
    return rawheader.data()
end

export function dataVariant(kind: string): string
    local source
    if kind == "shared" then
        source = "local function first(v: boolean): boolean return v end\n"
            .. "local function second(v: boolean): boolean return v end\nreturn second(first(true))"
    elseif kind == "repeated" then
        source = "local function same(v: boolean): boolean return v end\nreturn same(same(true))"
    elseif kind == "nested" then
        source = "local function outer(v: boolean): boolean local function inner(w: boolean): boolean return w end return inner(v) end\nreturn outer(true)"
    elseif kind == "branch" then
        source = "local function identity(value: boolean): boolean return value end\nreturn identity(true)"
    elseif kind == "return0" then
        source = "return"
    else
        assert(kind == "nil1")
        source = "return nil"
    end
    local p = encoded(source)
    if kind == "shared" then
        assert(#p.signatures == 2 and #p.catalog == 3)
        assert(p.catalog[2].signature == p.catalog[3].signature)
    elseif kind == "branch" then
        -- Synthetic persistent CFG from checked identity, not source ifStmt admission.
        p.graphs[
            2
        ].blocks = {
            {
                id = 1,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "branch", value = 1, edges = {{target = 2, args = {}}, {target = 3, args = {}}}}
            },
            {
                id = 2,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "return", value = 1, edges = {}}
            },
            {
                id = 3,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "return", value = 1, edges = {}}
            }
        }
    end

    return codec.encode(p)
end

-- Synthetic persistent CFG variants retain authentic checked catalog owners.
-- They test graph admission, not additional source-level control-flow support.
export function semanticVariant(kind: string): string
    local source = "local function identity(value: boolean): boolean return value end\nreturn identity(true)"
    if kind == "phi" or kind == "text-cap" then
        source = "return true"
    elseif kind == "maximum-arity" then
        local params, args = {}, {}
        for index = 1, 239 do
            params[index], args[index] = "v" .. index .. ": boolean", "true"
        end
        source = "local function identity(" .. table.concat(
            params,
            ","
        ) .. "): boolean return v1 end\nreturn identity(" .. table.concat(args, ",") .. ")"
    elseif kind == "nil-constant" then
        source = "return nil"
    elseif kind == "cross-graph" or kind == "item-cap" then
        source = "local function first(v: boolean): boolean return v end\nlocal function second(v: nil): nil return v end\nfirst(true)\nreturn second(nil)"
    elseif kind == "discard" then
        source = "local function identity(value: boolean): boolean return value end\nidentity(true)\nreturn false"
    end
    local p = encoded(source)

    local function block(id: integer, params: any, term: any): any
        return {id = id, params = params, op = {}, dst = {}, args = {}, pos = {}, cert = {}, term = term}
    end

    if kind == "item-cap" then
        local g, first = p.graphs[1], p.graphs[1].blocks[1]
        first.term.pos = nil
        local remaining = 1048575 - budget.measure(p).items
        while remaining % 6 ~= 0 do
            local id = #g.types + 1
            g.types[id], g.slots[id] = "v", g.counts.v
            g.counts.v += 1
            first.op[#first.op + 1], first.dst[#first.dst + 1], first.args[#first.args + 1] = "Nil", id, {}
            first.pos[#first.pos + 1], first.cert[#first.cert + 1] = 0, 0
            remaining -= 14
        end
        for _, graph in ipairs(p.graphs) do
            while remaining > 0 and #graph.constants < 65536 do
                graph.constants[#graph.constants + 1] = {kind = "true", value = ""}
                remaining -= 6
            end
        end
        assert(remaining == 0 and budget.measure(p).items == 1048575)
    elseif kind == "text-cap" then
        local g = p.graphs[1]
        g.positions = {}
        for index = 1, 16 do
            g.positions[index] = {line = 1, column = 1, source = {moduleName = "", path = ""}}
        end
        local remaining = 16777216 - budget.measure(p).bytes
        for _, position in ipairs(g.positions) do
            local bytes = math.min(remaining, 1048576)
            position.source.path = string.rep("b", bytes)
            remaining -= bytes
        end
        assert(remaining == 0 and budget.measure(p).bytes == 16777216)
    elseif kind == "params-above-slots" then
        p.graphs[2].counts.v = 0
    elseif kind == "reverse-block-order" then
        local g = p.graphs[2]
        g.types, g.slots, g.counts.v = {"v", "v", "v"}, {1, 0, 0}, 1
        g.blocks = {
            block(1, {}, {
                kind = "jump",
                edges = {{target = 3, args = {1}}}
            }),
            block(2, {3}, {
                kind = "return",
                value = 3,
                edges = {}
            }),
            block(3, {2}, {kind = "jump", edges = {{target = 2, args = {2}}}})
        }
    elseif kind == "maximum-values" then
        local g, params, args = p.graphs[2], {}, {}
        g.types, g.slots, g.counts.v = {"v"}, {1}, 65535
        for id = 2, 65536 do
            g.types[id], g.slots[id] = "v", id - 2
            params[#params + 1], args[#args + 1] = id, 1
        end
        g.blocks = {
            block(1, {}, {
                kind = "jump",
                edges = {{target = 2, args = args}}
            }),
            block(2, params, {
                kind = "return",
                value = 65536,
                edges = {}
            })
        }
    elseif kind == "maximum-blocks" then
        local g = p.graphs[2]
        g.blocks, g.counts.v = {}, 0
        for id = 1, 4096 do
            g.blocks[
                id
            ] = block(
                id,
                {},
                id == 4096 and {kind = "return", value = 1, edges = {}}
                or {kind = "jump", edges = {{target = id + 1, args = {}}}}
            )
        end
    elseif kind == "phi" then
        local g, first = p.graphs[1], p.graphs[1].blocks[1]
        assert(first.dst[1] == 1)
        g.types, g.slots, g.counts.v = {"v", "v", "v", "v", "v", "v"}, {0, 0, 0, 0, 1, 1}, 2
        g.constants[2] = {kind = "nil", value = ""}
        first.term = {kind = "branch", value = 1, edges = {{target = 2, args = {1}}, {target = 3, args = {1}}}}
        local left = block(2, {2}, {kind = "jump", edges = {{target = 4, args = {5}}}})
        left.op, left.dst, left.args, left.pos, left.cert = {"Move"}, {5}, {{2}}, {0}, {0}
        local right = block(3, {3}, {kind = "jump", edges = {{target = 4, args = {6}}}})
        right.op, right.dst, right.args, right.pos, right.cert = {"Move"}, {6}, {{3}}, {0}, {0}
        g.blocks = {first, left, right, block(4, {4}, {kind = "return", value = 4, edges = {}})}
    elseif kind == "nil-constant" then
        local g = p.graphs[1]
        assert(g.blocks[1].op[1] == "Nil")
        g.constants = {{kind = "nil", value = ""}}
        g.blocks[1].op[1], g.blocks[1].args[1] = "K", {0}
    elseif kind == "closure-copy" then
        local g = p.graphs[1]
        local b = g.blocks[1]
        local callee = b.term.callee
        assert(b.term.kind == "invoke")
        local id = #g.types + 1
        g.types[id], g.slots[id] = "v", g.counts.v
        g.counts.v += 1
        b.op[#b.op + 1], b.dst[#b.dst + 1], b.args[#b.args + 1] = "Move", id, {callee}
        b.pos[#b.pos + 1], b.cert[#b.cert + 1], b.term.callee = 0, 0, id
    else
        assert(kind == "discard" or kind == "maximum-arity" or kind == "cross-graph")
    end

    return codec.encode(p)
end

export function measure(path: string): string
    local file = assert(io.open(path, "rb"))
    local bytes = file:read("*a")
    file:close()
    return json.encodevalue(budget.measure(codec.decode(bytes)))
end

export function validateMany(path: string): string
    local list = assert(io.open(path, "rb"))
    local inputs = json.decodevalue(list:read("*a"))
    list:close()
    local results = {}
    for _, input in ipairs(inputs) do
        local file = assert(io.open(input.path, "rb"))
        local bytes = file:read("*a")
        file:close()
        local physical = pcall(codec.validateShape, bytes)
        local catalog, metrics = pcall(codec.validateCatalog, bytes)
        local semantic = pcall(codec.decode, bytes)
        results[
            input.name
        ] = {physical = physical, catalog = catalog, semantic = semantic, metrics = catalog and metrics or nil}
    end

    return json.encodevalue(results)
end

export function wire(): string
    return json.encodevalue(schema.wire())
end

export function definition(): string
    return json.encodevalue(schema.describe())
end
