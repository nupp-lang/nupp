module nupp.core.largespillproducer

local ir = require("s0.ir")
local allocate = require("s0.allocate")
local check = require("s0.allocationcheck")
local selector = require("s0.select")
local shim = require("nupp.core.shim")
local json = require("serde.json")
local producer = {}

-- Typed MIR construction only: no bytecode decoder or guest arithmetic.
function producer.compile(gapText: string): string
    local gap = assert(tonumber(gapText)) as integer
    local scratch: integer = 17
    assert(gap == 0 or gap == 4093 or gap == 5000)
    local f = ir.new(
        "large_spill",
        ir.Signature(
            params = {ir.I64, ir.I64, ir.I64, ir.I64, ir.I64, ir.I64},
            results = {ir.I64},
            convention = ir.INTERNAL
        )
    )
    f.blockStart[1], f.firstParam[1], f.nparams[1] = 1, 1, 6
    for value = 1, 6 do
        ir.value(f, value, ir.I64, -1)
        f.params[value] = value
    end
    ir.instruction(f, ir.OP_ICONST, 7, ir.I64, {}, -9223372036854775807LL - 1LL, 0)
    ir.instruction(f, ir.OP_ICONST, 8, ir.I64, {}, 0x7ff8123456789abcLL, 0)
    ir.instruction(f, ir.OP_BITCAST, 9, ir.F64, {7}, 0, 0)
    ir.instruction(f, ir.OP_BITCAST, 10, ir.F64, {8}, 0, 0)
    local jump = ir.instruction(f, ir.OP_JUMP, 0, 0, {}, 0, 0)
    ir.edge(f, jump, 2, {7, 8, 9, 10})
    f.blockEnd[1] = #f.op
    f.blockStart[2], f.firstParam[2], f.nparams[2] = #f.op + 1, #f.params + 1, 4
    for value = 11, 14 do
        ir.value(f, value, value <= 12 and ir.I64 or ir.F64, -2)
        f.params[#f.params + 1] = value
    end
    ir.instruction(f, ir.OP_BITCAST, 15, ir.I64, {13}, 0, 0)
    ir.instruction(f, ir.OP_BITCAST, 16, ir.I64, {14}, 0, 0)
    ir.instruction(f, ir.OP_ICONST, 17, ir.I64, {}, -9223372036854775807LL - 1LL, 0)
    ir.instruction(f, ir.OP_ICONST, 18, ir.I64, {}, 0x7ff8123456789abcLL, 0)
    ir.instruction(f, ir.OP_BXOR, 19, ir.I64, {11, 17}, 0, 0)
    ir.instruction(f, ir.OP_BXOR, 20, ir.I64, {12, 18}, 0, 0)
    ir.instruction(f, ir.OP_BXOR, 21, ir.I64, {15, 17}, 0, 0)
    ir.instruction(f, ir.OP_BXOR, 22, ir.I64, {16, 18}, 0, 0)
    ir.instruction(f, ir.OP_BOR, 23, ir.I64, {19, 20}, 0, 0)
    ir.instruction(f, ir.OP_BOR, 24, ir.I64, {21, 22}, 0, 0)
    ir.instruction(f, ir.OP_BOR, 25, ir.I64, {23, 24}, 0, 0)
    ir.instruction(f, ir.OP_RETURN, 0, 0, {25}, 0, 0)
    f.blockEnd[2] = #f.op
    local target = selector.target()
    target.integerRegisters, target.floatRegisters, target.scratchInt = {}, {}, scratch
    local a = allocate.run(f, target)
    assert(check.run(f, target, a))
    -- Give dead predecessor values' slots to swapped edge parameters, then
    -- rebuild the simultaneous copy schedule and independently check it.
    a.location[11], a.location[12] = a.location[8], a.location[7]
    a.location[13], a.location[14] = a.location[10], a.location[9]
    a.moveSource, a.moveTarget, a.moveKind = {}, {}, {}
    allocate.parallel(
        {a.location[7], a.location[8], a.location[9], a.location[10]},
        {a.location[11], a.location[12], a.location[13], a.location[14]},
        {ir.I64, ir.I64, ir.F64, ir.F64},
        target,
        a
    )
    a.firstMove[1], a.nmoves[1] = 1, #a.moveSource
    assert(check.run(f, target, a))
    -- Relocation preserves every location equality and is checked again.
    for value, location in ipairs(a.location) do
        if location < 0 then
            a.location[value] = location - gap
        end
        a.rematerialize[value] = 0
    end
    for at, location in ipairs(a.moveSource) do
        if location < 0 then
            a.moveSource[at] = location - gap
        end
        if a.moveTarget[at] < 0 then
            a.moveTarget[at] = a.moveTarget[at] - gap
        end
    end
    a.spillSlots = a.spillSlots + gap
    assert(check.run(f, target, a))
    local scratchMoves = 0
    for at, location in ipairs(a.moveSource) do
        if location == scratch or a.moveTarget[at] == scratch then
            scratchMoves = scratchMoves + 1
        end
    end
    assert(scratchMoves >= 2, "integer copy cycle required")
    local code = selector.run(f, a)
    local result = shim.build({code})
    result.gap, result.scratchRegister, result.spillSlots = gap, scratch, a.spillSlots
    result.scratchMoves = scratchMoves
    result.integerRegisters, result.floatRegisters = #target.integerRegisters, #target.floatRegisters

    return json.encodevalue(result)
end

export = producer
