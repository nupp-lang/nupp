module nupp.runtime.core.heapentrychecks

const native = require("nupp.runtime.vm.intrinsics")
const entry = require("nupp.runtime.core.heapentry")
const rootentry = require("nupp.runtime.core.rootentry")
const frames = require("nupp.runtime.core.frames")
const roots = require("nupp.runtime.core.frameroots")
const values = require("nupp.runtime.vm.values")

-- The same owned workload lends the retained Binding/Storage after successful
-- run. Do not call on a failed service scope or inspect destroyed Heap memory.
-- The original scope's sticky error and ledger cleanup are checked by entry.
export function completed(binding: voidptr): uint64
    local storage = native.loadPointer(binding, native.fieldOffset<entry.Binding>("storage"))
    if native.load64(storage, native.fieldOffset<entry.Storage>("entered")) ~= 1ULL
        or native.load64(storage, native.fieldOffset<entry.Storage>("completed")) ~= 1ULL
    then
        return 1ULL
    end
    local rootStorage = native.offset(storage, native.fieldOffset<entry.Storage>("root"))
    local state = native.offset(rootStorage, native.fieldOffset<rootentry.Storage>("state"))
    local control = native.offset(rootStorage, native.fieldOffset<rootentry.Storage>("root"))
    if native.load64(state, native.fieldOffset<frames.State>("active")) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 0ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("frame")) ~= 0ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("phase")) ~= frames.ROOT_RETIRED
        or native.load64(control, native.fieldOffset<frames.RootControl>("count")) ~= 1ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("value")) ~= values.TRUE
    then
        return 2ULL
    end
    local outer = native.offset(storage, native.fieldOffset<entry.Storage>("outerResult"))
    local inner = native.offset(storage, native.fieldOffset<entry.Storage>("innerResult"))
    if native.load64(outer, native.fieldOffset<roots.Result>("value")) ~= values.NIL
        or native.load64(inner, native.fieldOffset<roots.Result>("value")) ~= values.NIL
    then
        return 3ULL
    end

    return 0ULL
end

-- The producer reads checked target-layout expressions for the existing bridge.
export function bindingBytes(): uint64
    return native.sizeOf<entry.Binding>()
end

export function storageBytes(): uint64
    return native.sizeOf<entry.Storage>()
end
