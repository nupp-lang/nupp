module nupp.core.catalogtablesmetaarity

-- A metamethod is called as any function is: parameters past its arguments
-- are nil, and a variadic one packs them.
local function counted(...: any): integer
    return select("#", ...)
end

local spare: any = setmetatable({}, {
    __index = function(t: any, k: integer, extra: any): integer
        if extra == nil then
            return k * 2
        end
        return -1
    end
})
local packed: any = setmetatable({}, {
    __add = function(...: any): integer
        return counted(...) * 100
    end,
    __concat = function(a: any, ...: any): string
        return "c" .. counted(...)
    end
})
local score = spare[7]
score = score + (packed + 1)
if packed .. "x" == "c1" then
    score = score + 1000
end
export = score
