module nupp.core.cataloglibraryvalues

-- A library function is a value as any function is: passed, stored, called
-- through a table, and handed to pcall, it makes the call its name does.
local function apply(f: function(any): any, value: any): any
    return f(value)
end

local convert = tostring
local table: {[string]: any} = {up = string.upper, kind = type}
local missing = "nupp.core.absent"
local ok, reason = pcall(require, missing)
local score = 0
if apply(tostring, 42) == "42" and convert(true) == "true" then
    score = score + 1
end
if table.up("ab") == "AB" and table.kind({}) == "table" then
    score = score + 2
end
if not ok and string.find(tostring(reason), "module 'nupp.core.absent' not found", 1, true) ~= nil then
    score = score + 4
end
if apply(math.floor, 3.7) == 3 then
    score = score + 8
end
export = score
