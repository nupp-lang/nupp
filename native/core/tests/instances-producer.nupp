module nupp.core.instancesproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local graph = require("nupp.compiler.vm.graph")
local profile = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("nupp.compiler.s0.allocate")
local allocationcheck = require("nupp.compiler.s0.allocationcheck")
local selector = require("nupp.compiler.s0.select")
local shim = require("nupp.core.shim")
local graphimage = require("nupp.compiler.vm.graphimage")
local json = require("serde.json")
local MODULE = "nupp.runtime.core.instances"
local PROBE = "nupp.runtime.core.instancesprobe"

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    local path = ROOT .. "/native/core/src/nupp/runtime/core/instances.nupp"
    local owners, options = front.checked(front.read(path), path, MODULE)
    options.abi = "leaf"
    local probePath = ROOT .. "/native/core/src/nupp/runtime/core/instancesprobe.nupp"
    local probes, probeOptions = front.checked(
        front.read(ROOT .. "/native/core/tests/instances-probe.nupp"),
        probePath,
        PROBE
    )
    probeOptions.abi = "leaf"
    probeOptions.modules[MODULE] = options.modules[MODULE]
    local resolved, names = {}, {}
    for _, source in ipairs({{owners = owners, options = options}, {owners = probes, options = probeOptions}}) do
        for name, owner in pairs(source.owners) do
            local ok, g = pcall(function(): any
                return lower.functionGraph(owner, source.options, profile)
            end)
            assert(ok, owner.scope.name .. "." .. name .. ": " .. tostring(g))
            graph.verify(g)
            graph.prune(g)
            graph.verify(g)
            local symbol = owner.scope.name .. "." .. name
            resolved[symbol] = {graph = g, owner = owner}
            names[#names + 1] = symbol
        end
    end
    table.sort(names)
    assert(#names == 17, "exact registry and probe function set")
    local codes, metrics = {}, {}
    for _, symbol in ipairs(names) do
        local item = resolved[symbol]
        local g, owner = item.graph, item.owner
        local artifact = sink.compilerGraph(g, owner.name, owner, resolved)
        assert(artifact.body == owner and artifact.source.path == owner.scope.path, "retained checked registry owner")
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(artifact.machine, target)
        assert(allocationcheck.run(artifact.machine, target, allocation))
        local code = selector.run(artifact.machine, allocation)
        codes[symbol] = code
        metrics[
            #metrics + 1
        ] = {
            name = owner.name,
            symbol = symbol,
            params = g.native.params,
            result = g.native.result,
            calls = #code.fixupKind,
            frameBytes = code.frameBytes,
            spillSlots = allocation.spillSlots,
            words = #code.words,
            integerRegisters = #target.integerRegisters,
            floatRegisters = #target.floatRegisters,
            source = g.source
        }
    end
    local entry = PROBE .. ".CoreInstancesProbe"
    local handler = codes[entry]
    codes[entry] = nil
    local result = shim.build({handler}, codes)
    result.metrics, result.mode = metrics, mode
    result.fixture = "fresh-instance-registry"
    result.failureGroups = 28

    return json.encodevalue(result)
end

export function data(offsetText: string, codeBytesText: string): string
    local offset, bytes = assert(tonumber(offsetText)), assert(tonumber(codeBytesText))
    assert(offset >= 0 and offset < bytes and offset % 4 == 0)
    return graphimage.wideBytes(
        1
    ) .. graphimage.wideBytes(
        256
    ) .. graphimage.wideBytes(
        32
    ) .. graphimage.wideBytes(48) .. string.rep(string.char(0), 16) .. graphimage.wideBytes(offset)
end
