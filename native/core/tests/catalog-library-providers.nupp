module nupp.core.cataloglibraryproviders

-- The provider registry runs on the core: with no provider index an
-- interface has no implementations, `select` chooses none, and `package`
-- gains `providers` and `select`.
const packages = require("nupp.runtime.packages")

local chosen: any = packages.select(packages.providers<any>("nupp.core.Nothing"))
local score = 0
if chosen == nil then
    score = score + 1
end
local ambient = package as any
if ambient.providers ~= nil and ambient.select ~= nil then
    score = score + 2
end
export = score
