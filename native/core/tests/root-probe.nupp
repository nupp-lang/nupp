module nupp.runtime.core.rootprobe

const context = require("nupp.runtime.core.context")
const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const frames = require("nupp.runtime.core.frames")
const rootentry = require("nupp.runtime.core.rootentry")
const arena = require("nupp.runtime.core.arena")

local function copy(to: voidptr, from: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        native.store64(to, native.index(at), native.load64(from, native.index(at)))
        at = at + 8ULL
    end

    return 1ULL
end

local function same(a: voidptr, b: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        if native.load64(a, native.index(at)) ~= native.load64(b, native.index(at)) then
            return 0ULL
        end
        at = at + 8ULL
    end

    return 1ULL
end

-- Every root is constructed by the actual entry/lifecycle implementation.
-- Snapshots use live raw integer slots, never memory after its retirement.
local function lifecycle(frame: voidptr, ints: voidptr, ctx: voidptr): uint64
    local control = native.loadPointer(frame, native.fieldOffset<frames.Frame>("resultOwner"))
    local state = native.loadPointer(control, native.fieldOffset<frames.RootControl>("state"))
    local info = native.loadPointer(frame, native.fieldOffset<frames.Frame>("functionInfo"))
    local plan = native.loadPointer(frame, native.fieldOffset<frames.Frame>("windowPlan"))
    local mark = native.offset(control, native.fieldOffset<frames.RootControl>("mark"))
    local serial = native.load64(mark, native.fieldOffset<arena.Mark>("serial"))
    local savedState = ints
    local savedControl = native.offset(ints, native.index(native.sizeOf<frames.State>()))
    local copiedState = copy(savedState, state, native.sizeOf<frames.State>())
    local copiedControl = copy(savedControl, control, native.sizeOf<frames.RootControl>())
    if frames.beginRoot(state, control, info, plan) ~= 0ULL
        or frames.beginRoot(state, info, info, plan) ~= 0ULL
        or frames.beginRoot(state, frame, info, plan) ~= 0ULL
        or frames.retireRoot(state, control, frame, serial) ~= 0ULL
        or frames.finishRoot(state, control, frame, serial + 1ULL, values.TRUE) ~= 0ULL
        or frames.abortRoot(state, control, frame, serial + 1ULL) ~= 0ULL
        or same(savedState, state, native.sizeOf<frames.State>()) == 0ULL
        or same(savedControl, control, native.sizeOf<frames.RootControl>()) == 0ULL
    then
        return 81ULL
    end
    -- A mapped child identity blocks retirement; no arbitrary pointer is read.
    native.store64(frame, native.fieldOffset<frames.Frame>("child"), native.address(frame))
    if frames.abortRoot(state, control, frame, serial) ~= 0ULL
        or same(savedState, state, native.sizeOf<frames.State>()) == 0ULL
        or same(savedControl, control, native.sizeOf<frames.RootControl>()) == 0ULL
    then
        return 82ULL
    end
    native.store64(frame, native.fieldOffset<frames.Frame>("child"), 0ULL)
    local address = native.address(frame)
    if frames.abortRoot(state, control, frame, serial) ~= 1ULL then
        return 83ULL
    end
    -- No old frame/window dereference after abort. Metadata/control remain live.
    if native.load64(state, native.fieldOffset<frames.State>("active")) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 0ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("count")) ~= 0ULL
        or frames.abortRoot(state, control, frame, serial) ~= 0ULL
    then
        return 84ULL
    end
    -- The test owns otherwise unused context bytes 64..127, outside the pool.
    -- A retired control cannot be rebound to another valid State or segment.
    local alternate = native.offset(ctx, 64)
    local saved = copy(alternate, state, native.sizeOf<frames.State>())
    if frames.beginRoot(alternate, control, info, plan) ~= 0ULL then
        return 91ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<frames.State>("segment"))
    saved = copy(alternate, segment, native.sizeOf<arena.Segment>())
    native.store64(alternate, native.fieldOffset<arena.Segment>("issued"), 0ULL)
    native.store64(state, native.fieldOffset<frames.State>("segment"), native.address(alternate))
    if frames.beginRoot(state, control, info, plan) ~= 0ULL then
        return 92ULL
    end
    native.store64(state, native.fieldOffset<frames.State>("segment"), native.address(segment))
    native.store64(control, native.fieldOffset<frames.RootControl>("phase"), 0ULL)
    if frames.beginRoot(state, control, info, plan) ~= 0ULL then
        return 93ULL
    end
    native.store64(control, native.fieldOffset<frames.RootControl>("phase"), frames.ROOT_RETIRED)
    local oldOwner = native.load64(mark, native.fieldOffset<arena.Mark>("owner"))
    local oldPrevious = native.load64(mark, native.fieldOffset<arena.Mark>("previous"))
    local oldBefore = native.load64(mark, native.fieldOffset<arena.Mark>("before"))
    local oldFinish = native.load64(mark, native.fieldOffset<arena.Mark>("finish"))
    local oldPayload = native.load64(mark, native.fieldOffset<arena.Mark>("payload"))
    local oldBytes = native.load64(mark, native.fieldOffset<arena.Mark>("bytes"))
    local oldCursor = native.load64(segment, native.fieldOffset<arena.Segment>("cursor"))
    local oldTop = native.load64(segment, native.fieldOffset<arena.Segment>("top"))
    -- The retired mark is exclusive and nonlive. Oversized and wrapping
    -- reservation arithmetic must refuse without changing its token or owner.
    if arena.reserve(segment, 0xffffffffffffffffULL, 16ULL, mark) ~= 0ULL
        or arena.reserve(segment, 1ULL, 0ULL, mark) ~= 0ULL
        or native.load64(segment, native.fieldOffset<arena.Segment>("issued")) ~= serial
        or native.load64(mark, native.fieldOffset<arena.Mark>("serial")) ~= serial
        or native.load64(mark, native.fieldOffset<arena.Mark>("owner")) ~= oldOwner
        or native.load64(mark, native.fieldOffset<arena.Mark>("previous")) ~= oldPrevious
        or native.load64(mark, native.fieldOffset<arena.Mark>("before")) ~= oldBefore
        or native.load64(mark, native.fieldOffset<arena.Mark>("finish")) ~= oldFinish
        or native.load64(mark, native.fieldOffset<arena.Mark>("payload")) ~= oldPayload
        or native.load64(mark, native.fieldOffset<arena.Mark>("bytes")) ~= oldBytes
        or native.load64(segment, native.fieldOffset<arena.Segment>("cursor")) ~= oldCursor
        or native.load64(segment, native.fieldOffset<arena.Segment>("top")) ~= oldTop
        or native.load64(control, native.fieldOffset<frames.RootControl>("phase")) ~= frames.ROOT_RETIRED
    then
        return 95ULL
    end
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local bytes = native.load64(plan, native.fieldOffset<frames.WindowPlan>("bytes"))
    native.store64(segment, native.fieldOffset<arena.Segment>("limit"), base + bytes - 1ULL)
    if frames.beginRoot(state, control, info, plan) ~= 0ULL
        or native.load64(segment, native.fieldOffset<arena.Segment>("issued")) ~= serial
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= 0ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("phase")) ~= frames.ROOT_RETIRED
    then
        return 94ULL
    end
    native.store64(segment, native.fieldOffset<arena.Segment>("limit"), base + bytes)
    local next = frames.beginRoot(state, control, info, plan)
    if next ~= address then
        return 85ULL
    end
    local current = native.pointer(next)
    local nextSerial = native.load64(mark, native.fieldOffset<arena.Mark>("serial"))
    if nextSerial <= serial
        or frames.finishRoot(state, control, current, serial, values.FALSE) ~= 0ULL
        or frames.retireRoot(state, control, current, serial) ~= 0ULL
        or frames.abortRoot(state, control, current, serial) ~= 0ULL
    then
        return 86ULL
    end
    if frames.finishRoot(state, control, current, nextSerial, values.TAG_INTEGER | 42ULL) ~= 1ULL
        or frames.finishRoot(state, control, current, nextSerial, values.FALSE) ~= 0ULL
        or frames.abortRoot(state, control, current, nextSerial) ~= 0ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("value")) ~= (values.TAG_INTEGER | 42ULL)
        or frames.retireRoot(state, control, current, nextSerial) ~= 1ULL
    then
        return 87ULL
    end
    if native.load64(control, native.fieldOffset<frames.RootControl>("value")) ~= (values.TAG_INTEGER | 42ULL)
        or frames.retireRoot(state, control, current, nextSerial) ~= 0ULL
    then
        return 88ULL
    end
    native.store64(segment, native.fieldOffset<arena.Segment>("limit"), limit)
    local final = frames.beginRoot(state, control, info, plan)
    if final ~= address then
        return 89ULL
    end
    local finalSerial = native.load64(mark, native.fieldOffset<arena.Mark>("serial"))
    if finalSerial <= nextSerial
        or native.load64(control, native.fieldOffset<frames.RootControl>("value")) ~= values.NIL
        or frames.finishRoot(state, control, native.pointer(final), finalSerial, values.TRUE) ~= 1ULL
    then
        return 90ULL
    end

    local storage = native.offset(state, 0 - native.fieldOffset<rootentry.Storage>("state"))
    if rootentry.complete(storage, native.pointer(final), serial) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= final
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 1ULL
        or native.load64(control, native.fieldOffset<frames.RootControl>("phase")) ~= frames.ROOT_COMPLETE
        or native.load64(control, native.fieldOffset<frames.RootControl>("value")) ~= values.TRUE
        or native.load64(mark, native.fieldOffset<arena.Mark>("serial")) ~= finalSerial
    then
        return 80ULL
    end
    -- Success leaves status zero so the outer stale-entry refusal must itself
    -- produce status1. Reloading the new serial would instead publish output.

    return 0ULL
end

-- A test-only completion handler. It does not introduce a guest Ret opcode or
-- reinterpret raw diagnostic results. Each selected value is already tagged.
export function CoreRootComplete(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if native.address(regs) ~= native.load64(frame, native.fieldOffset<frames.Frame>("values"))
        or native.address(ints) ~= native.load64(frame, native.fieldOffset<frames.Frame>("integers"))
        or native.address(floats) ~= native.load64(frame, native.fieldOffset<frames.Frame>("floats"))
        or native.address(pc) ~= native.load64(frame, native.fieldOffset<frames.Frame>("code"))
        or native.address(frame) == native.address(regs) - 32ULL
        or native.address(ctx) == 0ULL
    then
        if native.address(ctx) ~= 0ULL then
            native.store64(ctx, context.STATUS, 99ULL)
        end
        return 99ULL
    end
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    local slot: uint64 = 0ULL
    while slot < count do
        if native.load64(regs, native.index(slot * 8ULL)) ~= values.NIL then
            native.store64(ctx, context.STATUS, 98ULL)
            return 98ULL
        end
        slot = slot + 1ULL
    end
    local choice = native.load8(pc, 1)
    local value = values.NIL
    if choice == 5ULL then
        local problem = lifecycle(frame, ints, ctx)
        if problem ~= 0ULL then
            native.store64(ctx, context.STATUS, problem)
        end
        return problem
    elseif choice == 1ULL then
        value = values.FALSE
    elseif choice == 2ULL then
        value = values.TRUE
    elseif choice == 3ULL then
        value = values.TAG_INTEGER | 42ULL
    elseif choice == 4ULL then
        -- Deliberate status-zero return without completion must suppress output.
        return 0ULL
    elseif choice ~= 0ULL then
        return 97ULL
    end
    local control = native.loadPointer(frame, native.fieldOffset<frames.Frame>("resultOwner"))
    local state = native.loadPointer(control, native.fieldOffset<frames.RootControl>("state"))
    local mark = native.offset(control, native.fieldOffset<frames.RootControl>("mark"))
    local serial = native.load64(mark, native.fieldOffset<arena.Mark>("serial"))
    if frames.finishRoot(state, control, frame, serial, value) == 0ULL then
        return 96ULL
    end
    -- Poison raw return: the entry must use the retained tagged result instead.

    return 0xdeadbeefULL
end
