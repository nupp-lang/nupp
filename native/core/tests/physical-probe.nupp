module nupp.runtime.core.physicalprobe

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")

export function read(address: uint64): uint64
    local words = native.pointer(address) as heap.Words*
    @unsafe do
        return words.base
    end
end

export function readCount(address: uint64): uint64
    local words = native.pointer(address) as heap.Words*
    @unsafe do
        return words.count
    end
end

export function touch(address: uint64): uint64
    return native.load64(native.pointer(address), 0)
end

export function readAfterCall(address: uint64, flag: uint64): uint64
    local words = native.pointer(address) as heap.Words*
    local saved = touch(address)
    if flag == 0ULL then
        saved = saved + 1ULL
    else
        saved = saved + 2ULL
    end
    @unsafe do
        return words.base + saved
    end
end

-- The fixture owns this mapped integer-window extent. It does not allocate
-- a managed Words object or grant borrowed heap-service permissions.
export function CorePhysicalProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local address = native.address(ints)
    local base = native.fieldOffset<heap.Words>("base")
    native.store64(ints, base, 0xfffffffffffffff0ULL)
    native.store64(ints, native.fieldOffset<heap.Words>("count"), 123ULL)
    native.store64(ints, native.fieldOffset<heap.Words>("capacity"), 456ULL)
    if read(address) ~= 0xfffffffffffffff0ULL then
        return 1ULL
    end
    if readCount(address) ~= 123ULL then
        return 7ULL
    end
    if readAfterCall(address, 0ULL) ~= 0xffffffffffffffe1ULL then
        return 2ULL
    end
    if readAfterCall(address, 1ULL) ~= 0xffffffffffffffe2ULL then
        return 3ULL
    end
    native.store64(ints, base, 0ULL)
    if read(address) ~= 0ULL then
        return 4ULL
    end
    native.store64(ints, base, 0x8000000000000000ULL)
    if read(address) ~= 0x8000000000000000ULL then
        return 5ULL
    end
    if native.load64(ints, native.fieldOffset<heap.Words>("count")) ~= 123ULL
        or native.load64(ints, native.fieldOffset<heap.Words>("capacity")) ~= 456ULL
    then
        return 6ULL
    end

    return 0ULL
end
