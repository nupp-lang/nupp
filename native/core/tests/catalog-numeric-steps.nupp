module nupp.core.catalognumericsteps

local own = require("own")
local closed = 0
local record Owner is own.Closeable
    function close(takes self): nil
        @unsafe own.release(self)
        closed += 1
    end
end

local function total(first: integer, last: integer, step: integer): integer
    local sum: integer = 0
    for value = first, last, step do
        sum += value
        step = -step
    end

    return sum
end

assert(total(1, 5, 2) == 9, "ascending initial step")
assert(total(5, 1, -2) == 9, "descending initial step")
assert(total(5, 1, 2) == 0, "positive empty loop")
assert(total(1, 5, -2) == 0, "negative empty loop")

local function floating(first: float64, last: float64, step: float64): float64
    local sum: float64 = 0.0
    for value = first, last, step do
        sum += value
    end

    return sum
end

assert(floating(0.5, 2.0, 0.5) == 5.0, "floating increasing step")
assert(floating(2.0, 0.5, -0.5) == 5.0, "floating decreasing step")
local nan = 0.0 * (1e308 * 10.0)
assert(floating(1.0, 1.0, nan) == 1.0, "NaN step single iteration")

local function iterations(first: integer, last: integer, step: integer): integer
    local count: integer = 0
    for value = first, last, step do
        count += 1
    end

    return count
end

assert(iterations(math.maxinteger - 1, math.maxinteger, 2) == 1, "positive integer overflow")
assert(iterations(math.mininteger + 1, math.mininteger, -2) == 1, "negative integer overflow")

local function zero(step: integer, last: any): nil
    local resource = Owner()
    for value = 5, last, step do
        error("zero step reached the body", 0)
    end
end

local ok, problem = pcall(zero, 0, {})
if ok or string.find(tostring(problem), "'for' step is zero", 1, true) == nil then
    error("zero step result: " .. tostring(ok) .. " / " .. tostring(problem), 0)
end
assert(closed == 1, "zero step closes owner")
local limitOk, limitProblem = pcall(zero, 1, {})
assert(not limitOk and string.find(tostring(limitProblem), "bad 'for' limit", 1, true) ~= nil, "invalid limit raises")
assert(closed == 2, "invalid limit closes owner")
export = 1
