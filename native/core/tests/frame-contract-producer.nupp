module nupp.core.framecontractproducer

local contract = require("nupp.compiler.vm.nativeframecontract")
local lower = require("nupp.compiler.vm.lower")
local profile = require("nupp.compiler.vm.nativegraph")
require("nupp.compiler.hostservices")
local graph = require("nupp.compiler.vm.graph")
local residual = require("nupp.compiler.vm.residual")
local clif = require("nupp.compiler.clif.graph")
local front = require("nupp.core.source")
local sink = require("nupp.compiler.s0.nativegraph")
local shim = require("nupp.core.shim")
local oldshim = require("nupp.core.framecontractoldshim")
local linker = require("nupp.core.link")
local graphimage = require("nupp.compiler.vm.graphimage")
local json = require("serde.json")

local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item)
    end

    return result
end

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill")
    assert(type(lower.functionGraph) == "function" and type(profile.initialize) == "function")
    local source = contract.build()
    local resolved, names = source.resolved, {}
    for name in pairs(resolved) do
        names[#names + 1] = name
    end
    table.sort(names)
    local refusals = {}

    local function reject(name: string, operation: function(): any, expected: string): nil
        local ok, failure = pcall(operation)
        assert(not ok and tostring(failure):find(expected, 1, true), name .. ": " .. tostring(failure))
        refusals[#refusals + 1] = {name = name, diagnostic = tostring(failure)}
    end

    local probe = resolved[source.probe]
    local capture = resolved["nupp.runtime.core.framecontractprobe.CoreFrameCapture"]
    assert(
        capture.owner.nativeABI == "leaf"
        and capture.graph.native.abi == "leaf"
        and capture.owner.resultKind == "uint64"
        and capture.graph.native.result == "uint64"
        and #capture.owner.paramKinds == 6
        and capture.graph.nparams == 6,
        "terminal capture scalar boundary"
    )
    for index = 1, 6 do
        assert(
            capture.owner.paramKinds[index] == "voidptr" and capture.graph.native.params[index] == "voidptr",
            "terminal capture six actual arguments"
        )
    end
    local g = probe.graph
    -- Plain graph data remains structurally sealed; only privately issued
    -- physical records use identity borrowing inside the same seal.
    local counts = g.counts
    g.counts = copy(counts)
    graph.verify(g)
    g.counts.v += 1
    reject(
        "changed plain graph data",
        function(): any
            return graph.verify(g)
        end,
        "issued graph changed"
    )
    g.counts = copy(counts)
    setmetatable(g.counts, {__index = {}})
    reject(
        "plain graph metatable",
        function(): any
            return graph.verify(g)
        end,
        "issued graph changed"
    )
    g.counts = counts
    graph.verify(g)
    local marker = g.nativeFinalFrame
    g.nativeFinalFrame = nil
    reject(
        "removed marker",
        function(): any
            return graph.verify(g)
        end,
        "marker changed"
    )
    g.nativeFinalFrame = marker
    reject(
        "copied graph",
        function(): any
            return graph.verify(copy(g))
        end,
        "copied final graph is unissued"
    )
    reject(
        "residual copy",
        function(): any
            return residual.prepare(g, 0)
        end,
        "does not carry final frame provenance"
    )
    reject(
        "frozen CLIF",
        function(): any
            return clif.emit(g, {})
        end,
        "does not carry final frame provenance"
    )
    reject(
        "prune without remap contract",
        function(): any
            return graph.prune(g)
        end,
        "does not carry final frame provenance"
    )
    local path = g.source.path
    g.source.path = path .. ".other"
    reject(
        "source replacement",
        function(): any
            return graph.verify(g)
        end,
        "source owner changed"
    )
    g.source.path = path
    local publishName = "nupp.runtime.core.frames.publish"
    local publish = resolved[publishName]
    local other = resolved["nupp.runtime.core.frames.abortPrepared"]
    resolved[publishName] = other
    reject(
        "callee graph replacement",
        function(): any
            return sink.compilerGraph(g, probe.owner.name, probe.owner, resolved, source.context)
        end,
        "leaf"
    )
    resolved[publishName] = publish
    local contextCopy = {}
    for key, value in pairs(source.context) do
        contextCopy[key] = value
    end
    reject(
        "copied checked context",
        function(): any
            return sink.compilerGraph(g, probe.owner.name, probe.owner, resolved, contextCopy)
        end,
        "checked context substitution"
    )
    local forgedContext: any = {
        name = source.context.name,
        path = source.context.path,
        constants = {},
        exportedConstants = {SIZE = "128", DISPATCH_TABLE = "48"}
    }
    for name, text in pairs(forgedContext.exportedConstants) do
        local definition: any = {
            name = name,
            filename = forgedContext.path,
            constant = true,
            type = {tag = "int64"},
            token = {}
        }
        definition.token.definition = definition
        forgedContext.constants[definition] = {kind = "number", token = {text = text}}
    end
    reject(
        "coherently forged context",
        function(): any
            return sink.compilerGraph(g, probe.owner.name, probe.owner, resolved, forgedContext)
        end,
        "checked context substitution"
    )
    local results, codes, metrics = {}, {}, {}
    for _, name in ipairs(names) do
        local item = resolved[name]
        local result = sink.compilerGraph(item.graph, item.owner.name, item.owner, resolved, source.context)
        results[name] = result
        local selected = sink.selectAuthenticated(result, mode)
        codes[name] = selected.code
        metrics[
            #metrics + 1
        ] = {
            name = name,
            frameBytes = selected.code.frameBytes,
            spillSlots = selected.spillSlots,
            integerRegisters = selected.integerRegisters,
            floatRegisters = selected.floatRegisters,
            calls = #selected.code.fixupName
        }
    end
    local result = results[source.probe]
    local resultCopy = {}
    for key, value in pairs(result) do
        resultCopy[key] = value
    end
    reject(
        "copied Result",
        function(): any
            return sink.selectAuthenticated(resultCopy, mode)
        end,
        "original authenticated Result required"
    )
    reject(
        "caller allocator ABI",
        function(): any
            local forged: any = {integerRegisters = {24}, preservedInternal = {[1] = true}}
            return sink.selectAuthenticated(result, forged)
        end,
        "closed allocation mode required"
    )
    local first = result.machine.op[1]
    result.machine.op[1] = -1
    reject(
        "mutated MIR",
        function(): any
            return sink.selectAuthenticated(result, mode)
        end,
        "Result changed"
    )
    result.machine.op[1] = first
    local captureName = "nupp.runtime.core.framecontractprobe.CoreFrameCapture"
    local roots = {codes[source.probe], codes[captureName]}
    codes[source.probe], codes[captureName] = nil, nil
    reject(
        "copied Code",
        function(): any
            return sink.verifyCode(copy(roots[1]))
        end,
        "authenticated Code required"
    )
    local word = roots[1].words[1]
    roots[1].words[1] = 0
    reject(
        "changed Code",
        function(): any
            return sink.verifyCode(roots[1])
        end,
        "issued Code changed"
    )
    roots[1].words[1] = word
    reject(
        "same-signature target substitute",
        function(): any
            return sink.verifyCodeTarget(roots[1], publishName, codes["nupp.runtime.core.frames.beginRoot"])
        end,
        "checked target/Result"
    )
    reject(
        "issued Code legacy link",
        function(): any
            return linker.assemble({}, roots, codes, 65536)
        end,
        "issued Code requires authenticated linking"
    )
    reject(
        "issued Code legacy shim",
        function(): any
            return shim.build(roots, codes)
        end,
        "issued Code requires authenticated linking"
    )
    -- Observe real full verification without replacing its authority. The batch
    -- must visit every supplied original Code once, including unreachable ones.
    local observed, total = {}, 0
    local sinkView: any = sink
    local originalVerify = sinkView.verifyCode
    sinkView.verifyCode = function(code: any): nil
        observed[code] = (observed[code] or 0) + 1
        total += 1
        originalVerify(code)
    end
    local batchOk, batchProblem = pcall(sink.verifyLinkInputs, roots, codes)
    sinkView.verifyCode = originalVerify
    assert(batchOk, tostring(batchProblem))
    assert(total == #names, "link batch repeated full Code verification")
    for _, code in ipairs(roots) do
        assert(observed[code] == 1)
    end
    local calls: integer = 0
    for _, code in pairs(codes) do
        assert(observed[code] == 1)
        calls += #code.fixupName
    end
    for _, code in ipairs(roots) do
        calls += #code.fixupName
    end
    assert(calls > 0, "batch regression must contain checked call edges")
    local batchRefusals = {}

    local function batchReject(name: string, operation: function(): any, expected: string): nil
        local ok, problem = pcall(operation)
        assert(not ok and tostring(problem):find(expected, 1, true), name .. ": " .. tostring(problem))
        batchRefusals[#batchRefusals + 1] = {name = name, diagnostic = tostring(problem)}
    end

    local function linkBatch(): any
        return linker.assembleAuthenticated({}, roots, codes, 65536)
    end

    local initialLink = linkBatch()
    local originalRoot = roots[1]
    roots[1] = copy(originalRoot)
    batchReject("batch copied Code", linkBatch, "authenticated Code required")
    roots[1] = originalRoot
    local originalWord = roots[1].words[1]
    roots[1].words[1] = 0
    batchReject("batch changed Code after successful link", linkBatch, "issued Code changed")
    batchReject(
        "standalone entry changed Code",
        function(): any
            return sink.verifyCodeEntry(roots[1])
        end,
        "issued Code changed"
    )
    roots[1].words[1] = originalWord
    local originalOp = result.machine.op[1]
    result.machine.op[1] = -1
    batchReject("batch retained MIR mutation", linkBatch, "retained Result changed")
    result.machine.op[1] = originalOp
    local originalMarker = g.nativeFinalFrame
    g.nativeFinalFrame = nil
    batchReject("batch graph marker mutation", linkBatch, "marker changed")
    g.nativeFinalFrame = originalMarker
    local originalTarget = codes[publishName]
    codes[publishName] = codes["nupp.runtime.core.frames.beginRoot"]
    batchReject("batch same-signature target substitution", linkBatch, "checked target/Result")
    codes[publishName] = nil
    batchReject("batch missing target", linkBatch, "unresolved function")
    codes[publishName] = originalTarget
    batchReject(
        "standalone unissued OS import",
        function(): any
            return sink.verifyCodeImport(roots[1], "core_os_0")
        end,
        "unissued OS import"
    )
    local callbacks: integer = 0
    local meta = {
        __index = function(): any
            callbacks += 1
            return originalRoot
        end
    }
    setmetatable(roots, meta)
    batchReject("batch root metatable", linkBatch, "plain link inputs")
    setmetatable(roots, nil)
    setmetatable(codes, meta)
    batchReject("batch function metatable", linkBatch, "plain link inputs")
    setmetatable(codes, nil)
    assert(callbacks == 0, "link inventory invoked a caller callback")
    roots[3] = roots[1]
    batchReject("batch duplicate root", linkBatch, "duplicate code owner")
    roots[3] = nil
    codes["batch_alias"] = originalTarget
    batchReject("batch aliased local body", linkBatch, "aliased local body")
    codes["batch_alias"] = nil
    assert(json.encodevalue(linkBatch()) == json.encodevalue(initialLink), "restored batch link differs")
    local selected = shim.buildAuthenticated(roots, codes)
    -- Unissued word copies are used only to compare mechanical transport with
    -- the old implementation. They are never returned as authenticated output.
    local legacyRoots, legacyCodes = copy(roots), copy(codes)
    local legacy = shim.build(legacyRoots, legacyCodes)
    local baseline = oldshim.build(legacyRoots, legacyCodes)
    assert(json.encodevalue(selected) == json.encodevalue(legacy), "authenticated link changes transport words/layout")
    assert(
        json.encodevalue(selected) == json.encodevalue(baseline),
        "shim factor changes accepted transport words/layout"
    )
    reject(
        "whole chain bound",
        function(): any
            return linker.assembleAuthenticated({}, roots, codes, (selected.callBytes as integer) - 1)
        end,
        "call-chain spill extent"
    )
    -- The terminal capture is the only entry here. The larger probe chain is
    -- still included as an original issued Code, so the advertised extent must
    -- cover it even though no root reaches it.
    local unrooted = {}
    for name, code in pairs(codes) do
        unrooted[name] = code
    end
    unrooted[source.probe] = roots[1]
    local isolated = linker.assembleAuthenticated({}, {roots[2]}, unrooted, 65536)
    assert(#isolated.offsets == 1 and isolated.offsets[1] == 0, "isolated root offset")
    assert(
        isolated.callBytes == selected.callBytes and isolated.callBytes > roots[2].frameBytes,
        "unrooted included body must determine whole-chain extent"
    )
    local unrootedOk, unrootedProblem = pcall(function(): any
        return linker.assembleAuthenticated({}, {roots[2]}, unrooted, (isolated.callBytes as integer) - 1)
    end)
    assert(
        not unrootedOk and tostring(unrootedProblem):find("call-chain spill extent", 1, true),
        "unrooted exact-capacity refusal"
    )
    local capOk, capProblem = pcall(function(): any
        return linker.assembleAuthenticated(
            {},
            roots,
            codes,
            (selected.callBytes as integer) - 1,
            "frame fixture exact-capacity refusal"
        )
    end)
    assert(
        not capOk and tostring(capProblem):find("frame fixture exact-capacity refusal", 1, true),
        "custom exact-capacity refusal"
    )
    selected.batchRefusals = batchRefusals
    selected.batchVerification = {uniqueCodes = #names, fullChecks = total, callFixups = calls}
    selected.metrics, selected.mode = metrics, mode
    selected.dataflowRefusals, selected.provenanceRefusals = source.refusals, refusals
    selected.scope = "closed real setup/publish/access/dispatch diagnostic, no guest CallRet or catalog entry"

    return json.encodevalue(selected)
end

export function data(selection: string): string
    local result = json.decodevalue(front.read(selection))
    assert(#result.offsets == 2 and #result.frames == 2)
    local extent, base, codeBytes = result.callBytes, result.spillOffset, #result.words * 4
    assert(extent > 0 and extent < 65536 and extent % 16 == 0)
    assert(base == ((shim.dispatchOffset + 16 + 15) & -16))
    assert(base + extent <= result.scratchBytes and result.scratchBytes == 65536)
    local first = string.rep(string.char(0), 4) .. graphimage.wideBytes(extent):sub(1, 4) .. graphimage.wideBytes(base)
    local second = string.char(1) .. string.rep(string.char(0), 15)
    local data = graphimage.wideBytes(
        2
    ) .. graphimage.wideBytes(256) .. graphimage.wideBytes(32) .. graphimage.wideBytes(64) .. first .. second
    for _, offset in ipairs(result.offsets) do
        assert(offset >= 0 and offset % 4 == 0 and offset < codeBytes)
        data = data .. graphimage.wideBytes(offset)
    end

    return data
end
