module nupp.core.catalogstringmethods

local function typed(value: string): string
    return value:sub(2)
end

local function dynamic(value: any): any
    return value:sub(2)
end

local library: any = string
local meta: any = getmetatable("")
local original = library.sub
local originalindex = meta.__index
local held = ("abc").sub

local function typedalias(value: string): any
    return value.sub
end

local heldtyped = typedalias("abc")
assert(heldtyped == held and heldtyped("abc", 2) == "bc")
assert(("abc"):sub(2) == "bc" and typed("abc") == "bc")
library.sub = function(value: any, first: any): string
    assert(value == "abc" and first == 2)
    return "library"
end
assert(("abc"):sub(2) == "library")
assert(typed("abc") == "library" and dynamic("abc") == "library")
assert(held("abc", 2) == "bc")
local changed = library.sub

local function argument(): integer
    library.sub = original
    return 2
end

assert(("abc"):sub(argument()) == "library")
assert(library.sub == original)
meta.__index = function(value: any, key: any): any
    assert(type(value) == "string")
    if key == "sub" then
        return function(subject: any, first: any): string
            assert(subject == "abc" and first == 2)
            return "index"
        end
    end

    return originalindex[key]
end
collectgarbage("collect")
assert(("abc"):sub(2) == "index")
assert(typed("abc") == "index" and dynamic("abc") == "index")
assert(typedalias("abc")("abc", 2) == "index")
meta.__index = originalindex
assert(typed("abc") == "bc" and changed("abc", 2) == "library")

local function count(...: any): integer
    return select("#", ...)
end

local function bytes(value: string): ...integer
    return value:byte(1, -1)
end

local function dynamicbytes(value: any): ...any
    return value:byte(1, -1)
end

local anyreceiver: any = "abc"
local originalbyte = library.byte
assert(count(bytes("abc")) == 3 and count(dynamicbytes("abc")) == 3)
for size = 0, 3 do
    library.byte = function(value: any, first: any, last: any): ...integer
        assert(value == "abc" and first == 1 and last == -1)
        if size == 0 then
            return
        end
        if size == 1 then
            return 107
        end
        if size == 2 then
            return 107, 109
        end

        return 107, 109, 113
    end
    collectgarbage("collect")
    assert(count(bytes("abc")) == size and count(dynamicbytes("abc")) == size)
    assert(count(anyreceiver:byte(1, -1)) == size)
    assert(count((anyreceiver:byte(1, -1))) == 1)
    assert(select("#", anyreceiver:byte(1, -1)) == size)
    local dynamicpacked = {anyreceiver:byte(1, -1)}
    assert(#dynamicpacked == size)
    assert(select("#", ("abc"):byte(1, -1)) == size)
    local packed = {("abc"):byte(1, -1)}
    assert(#packed == size)
    if size > 0 then
        assert(packed[1] == 107)
    end
end
library.byte = function(value: any, first: any, last: any): ...integer
    assert(value == "abc" and first == 1 and last == -1)
    return 107, 109
end

local function byteargument(): integer
    library.byte = originalbyte
    return 1
end

assert(count(("abc"):byte(byteargument(), -1)) == 2)

assert(count(bytes("abc")) == 3)

local string = {
    sub = function()
        return "shadow"
    end
}
assert(string.sub() == "shadow" and ("abc").sub == held)
assert(typedalias("abc") == heldtyped)
local value: any = "abc"
assert(
    not pcall(function()
        value.sub = original
    end)
)
export const result = 1
