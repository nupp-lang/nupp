module nupp.core.arenaproducer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local front = require("nupp.core.source")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")
local linker = require("nupp.core.link")
local shim = require("nupp.core.shim")
local json = require("nupp.codec.json")
local graphimage = require("nupp.compiler.vm.graphimage")
local producer = {}
local MODULE = "nupp.runtime.core.arena"
local names = {"initialize", "reserve", "release", "reset"}

local function selected(g: any, owner: any, mode: string, resolved: any): (any, any)
    local artifact = sink.compilerGraph(g, owner.name, owner, resolved)
    local target = selector.target()
    if mode == "spill" then
        target.integerRegisters, target.floatRegisters = {}, {}
    end
    local allocation = allocate.run(artifact.machine, target)
    assert(allocationcheck.run(artifact.machine, target, allocation))
    local code = selector.run(artifact.machine, allocation)

    return code, {
        name = owner.name,
        source = g.source,
        params = g.native.params,
        result = g.native.result,
        blocks = #g.blocks,
        machineOps = #artifact.machine.op,
        words = #code.words,
        calls = #code.fixupKind,
        frameBytes = code.frameBytes,
        spillSlots = allocation.spillSlots,
        integerRegisters = #target.integerRegisters,
        floatRegisters = #target.floatRegisters
    }
end

local function refused(action: function(): any, message: string): nil
    local ok, problem = pcall(action)
    assert(
        not ok and tostring(problem):find(message, 1, true),
        "missing refusal: " .. message .. ": " .. tostring(problem)
    )
end

function producer.compile(mode: string, fixture: string): string
    assert(mode == "normal" or mode == "spill")
    local arenaPath = ROOT .. "/native/core/src/nupp/runtime/core/arena.nupp"
    local functions, options = front.checked(front.read(arenaPath), arenaPath, MODULE)
    local resolved, codes, metrics = {}, {}, {}
    for _, name in ipairs(names) do
        local owner = assert(functions[name])
        local g = nativegraph.compile(owner, options)
        resolved[MODULE .. "." .. name] = {graph = g, owner = owner}
    end
    for _, name in ipairs(names) do
        local symbol = MODULE .. "." .. name
        local item = resolved[symbol]
        local code, metric = selected(item.graph, item.owner, mode, resolved)
        codes[symbol], metrics[#metrics + 1] = code, metric
        assert(#code.fixupKind == 0, "arena services must remain closed leaves")
    end
    assert(fixture == "arena" or fixture == "boolean")
    local probePath = ROOT .. "/native/core/tests/" .. fixture .. "-probe.nupp"
    -- The fixture is checked as an in-memory module; retain its physical input
    -- separately from the canonical diagnostic path expected by the checker.
    local checkedPath = ROOT .. "/native/core/src/nupp/runtime/core/arenaprobe.nupp"
    local probes, probeOptions = front.checked(front.read(probePath), checkedPath, "nupp.runtime.core.arenaprobe")
    probeOptions.modules[MODULE] = options.modules[MODULE]
    local owner = assert(probes.CoreArenaProbe)
    local g = nativegraph.compile(owner, probeOptions)
    local code, metric = selected(g, owner, mode, resolved)
    assert(metric.calls >= 4, "probe must execute ordinary calls")
    local result = shim.build({code}, codes)
    result.handlers, result.functions, result.mode = {metric}, metrics, mode
    result.fixtureSource, result.fixtureCheckedPath = probePath, checkedPath
    local negatives = {}

    local function reject(name: string, action: function(): any, message: string): nil
        refused(action, message)
        negatives[#negatives + 1] = name
    end

    reject(
        "unresolved typed call",
        function(): any
            return sink.compilerGraph(g, owner.name, owner, {})
        end,
        "unresolved leaf"
    )
    local first = resolved[MODULE .. ".initialize"]
    local original = first.graph.native.result
    first.graph.native.result = "int64"
    reject(
        "mismatched target signature",
        function(): any
            return sink.compilerGraph(g, owner.name, owner, resolved)
        end,
        "leaf signature mismatch"
    )
    first.graph.native.result = original
    local path = first.graph.source.path
    first.graph.source.path = path .. ".different"
    reject(
        "mismatched checked source",
        function(): any
            return sink.compilerGraph(g, owner.name, owner, resolved)
        end,
        "leaf source mismatch"
    )
    first.graph.source.path = path
    reject(
        "missing local code",
        function(): any
            return linker.assemble({}, {code}, {}, 65536)
        end,
        "unresolved function"
    )
    reject(
        "whole call chain extent",
        function(): any
            return linker.assemble({}, {code}, codes, (result.callBytes as integer) - 1)
        end,
        "call-chain spill extent"
    )
    local kind, word, addend = code.fixupKind[1], code.fixupWord[1], code.fixupAddend[1]
    code.fixupKind[1] = selector.IMPORT_LOAD
    reject(
        "foreign import",
        function(): any
            return linker.assemble({}, {code}, codes, 65536)
        end,
        "non-Nupp fixup"
    )
    code.fixupKind[1], code.fixupWord[1] = kind, #code.words + 1
    reject(
        "fixup outside body",
        function(): any
            return linker.assemble({}, {code}, codes, 65536)
        end,
        "fixup placement"
    )
    code.fixupWord[1], code.fixupAddend[1] = word, 4
    reject(
        "non-entry addend",
        function(): any
            return linker.assemble({}, {code}, codes, 65536)
        end,
        "fixup placement"
    )
    code.fixupAddend[1] = addend
    local alias = MODULE .. ".alias"
    codes[alias] = codes[MODULE .. ".reset"]
    reject(
        "aliased body",
        function(): any
            return linker.assemble({}, {code}, codes, 65536)
        end,
        "aliased local body"
    )
    codes[alias] = nil
    local recursiveSource = "module nupp.runtime.core.arena\nconst self = require(\"nupp.runtime.core.arena\")\nexport function reset(segment: voidptr): uint64\n local pending: uint64 = self.reset(segment)\n return pending\nend\n"
    local recursive, recursiveOptions = front.checked(recursiveSource, arenaPath, MODULE)
    local recursiveOwner = assert(recursive.reset)
    local recursiveGraph = nativegraph.compile(recursiveOwner, recursiveOptions)
    local recursiveTargets = {[MODULE .. ".reset"] = {graph = recursiveGraph, owner = recursiveOwner}}
    local recursiveCode = selected(recursiveGraph, recursiveOwner, mode, recursiveTargets)
    reject(
        "recursive checked source",
        function(): any
            return linker.assemble({}, {recursiveCode}, {[MODULE .. ".reset"] = recursiveCode}, 65536)
        end,
        "recursive call graph"
    )
    result.refusals = negatives

    return json.encode(result)
end

function producer.data(offsetText: string, codeBytesText: string): string
    local offset, codeBytes = assert(tonumber(offsetText)), assert(tonumber(codeBytesText))
    assert(offset >= 0 and offset < codeBytes and offset % 4 == 0)
    return graphimage.wideBytes(
        1
    ) .. graphimage.wideBytes(
        192
    ) .. graphimage.wideBytes(
        32
    ) .. graphimage.wideBytes(48) .. string.rep(string.char(0), 16) .. graphimage.wideBytes(offset)
end

export = producer
