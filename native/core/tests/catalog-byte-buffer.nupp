module nupp.core.catalogbytebuffer

const Buffer = io.Buffer

assert(io == _G.io)
assert(Buffer == _G.io.Buffer)

local b = Buffer.create()
b:put("a", 1):put("b")
local score = 0
if b:tostring() == "a1b" then
    score = score + 1
end
if b:get(2) == "a1" and #b == 1 then
    score = score + 2
end
export = score
