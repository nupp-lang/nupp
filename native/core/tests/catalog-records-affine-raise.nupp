module nupp.core.catalogrecordsaffineraise

-- An error a function that owns affine values raises itself, by error() or
-- in a library call's own check, destroys its owners before it goes on, as
-- one from a call does.
local closed: integer = 0
local order: integer = 0

local record File
    id: integer

    constructor(self, id: integer): affine(File, File.destroy)
        self.id = id
    end

    function destroy(takes self): nil
        closed = closed + 1
        order = order * 10 + self.id
    end
end

local function raising(n: integer): integer
    local f = File(n)
    if n > 2 then
        error("too big")
    end

    return f.id
end

local function libraryraising(code: integer): string
    local g = File(4)
    return string.char(code) .. tostring(g.id)
end

local ok1, e1 = pcall(raising, 1)
local ok2, e2 = pcall(raising, 5)
local ok3, e3 = pcall(libraryraising, 300)
local score: integer = closed * 1000 + order
if ok1 and e1 == 1 and not ok2 and not ok3 then
    score = score + 10000
end
if string.find(tostring(e2), "too big") ~= nil and string.find(tostring(e3), "out of range") ~= nil then
    score = score + 20000
end
-- A destructor that raises on the way out of a function raises there, as
-- Lua raises an error a __close raises.
local record Faulty
    constructor(self): affine(Faulty, Faulty.destroy)
    end

    function destroy(takes self): nil
        error("faulty", 0)
    end
end

local function leaving(): integer
    const f = Faulty()
    return 1
end

const ok4, e4 = pcall(leaving)
if not ok4 and e4 == "faulty" then
    score = score + 40000
end

-- A wrapped thread's error, raised again at the call of its function, lands
-- in the calling function, which destroys its owners.
local function resuming(): integer
    local f = File(6)
    const id = f.id
    local inner = coroutine.wrap(function(): integer
        if id > 0 then
            error("inside", 0)
        end
        return 0
    end)

    return inner()
end

const before = closed
const ok5, e5 = pcall(resuming)
if not ok5 and string.find(tostring(e5), "inside") ~= nil and closed == before + 1 then
    score = score + 80000
end
export = score
