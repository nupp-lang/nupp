module nupp.core.catalogrecordsaffineraise

-- An error a function that owns affine values raises itself, by error() or
-- in a library call's own check, destroys its owners before it goes on, as
-- one from a call does.
local closed: integer = 0
local order: integer = 0

local record File
    id: integer

    constructor(self, id: integer): affine(File, File.destroy)
        self.id = id
    end

    function destroy(takes self): nil
        closed = closed + 1
        order = order * 10 + self.id
    end
end

local function raising(n: integer): integer
    local f = new File(n)
    if n > 2 then
        error("too big")
    end

    return f.id
end

local function libraryraising(code: integer): string
    local g = new File(4)
    return string.char(code) .. tostring(g.id)
end

local ok1, e1 = pcall(raising, 1)
local ok2, e2 = pcall(raising, 5)
local ok3, e3 = pcall(libraryraising, 300)
local score: integer = closed * 1000 + order
if ok1 and e1 == 1 and not ok2 and not ok3 then
    score = score + 10000
end
if string.find(tostring(e2), "too big") ~= nil and string.find(tostring(e3), "out of range") ~= nil then
    score = score + 20000
end
export = score
