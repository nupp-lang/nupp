module nupp.core.catalogcallsxpcall

-- xpcall: a call that succeeds answers true and its results; one that
-- fails answers false and what its message handler made of the error, the
-- handler running even when only the status is kept.
local function risky(n: integer): integer
    if n > 5 then
        error("big")
    end
    return n * 3
end

local handled: integer = 0

local function handler(message: string): string
    handled = handled + 1
    return "handled: " .. message
end

local score: integer = 0
local ok1, v1 = xpcall(risky, handler, 2)
if ok1 and v1 == 6 then
    score = score + 1
end
local ok2, v2 = xpcall(risky, handler, 9)
if not ok2 and string.find(tostring(v2), "handled: ", 1, true) == 1 and string.find(tostring(v2), "big", 1, true) then
    score = score + 10
end
local ok3 = xpcall(risky, handler, 7)
if not ok3 then
    score = score + 100
end
local t: {[integer]: integer} = {}
local ok4, v4 = xpcall(
    function(): integer
        return (t[1] as integer) + 1
    end,
    function(message: string): integer
        return 42
    end
)
if not ok4 and v4 == 42 then
    score = score + 1000
end
local marker = {code = 99}
local callable: any = function(...: any): integer
    local count = select("#", ...)
    assert(count == 2 or count == 63)
    if count == 63 then
        assert(select(32, ...) == nil)
    end
    error(marker, 0)

    return 0
end

local function preserve(problem: any): any
    return problem
end

local selected: any = callable

local function makehandler(): function(any): any
    selected = function(): integer
        return 999
    end
    return preserve
end

local fixedOk, fixedProblem = xpcall(selected, makehandler(), 1, 2)
assert(not fixedOk and fixedProblem == marker)

local function relay(...: any): (boolean, any)
    return xpcall(callable, preserve, ...)
end

local arguments: any = {}
for index = 1, 63 do
    arguments[index] = index
end
arguments[32] = nil
local packedOk, packedProblem = relay(table.unpack(arguments, 1, 63))
assert(not packedOk and packedProblem == marker)
export const result = score + handled * 10000
