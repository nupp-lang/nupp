module nupp.runtime.core.transportprobe

const native = require("nupp.runtime.vm.intrinsics")
const layout = require("nupp.runtime.core.context")

-- The fixture borrows the initial 2048-byte integer window for an alternate
-- dispatch table and helper output. Entry context, frame and windows stay live.
-- This tests physical transport, not construction of core.frames.Frame.
export function pressure(
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    e: uint64,
    f: uint64,
    g: uint64,
    destination: voidptr
): uint64
    local result = (a + b) ~ (c + d) ~ (e + f) ~ g
    native.store64(destination, 8, result)
    return result
end

export function CoreTransport(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local nextPC = native.offset(pc, 16)
    local nextTable = native.offset(ints, 512)
    local output = native.offset(ints, 640)
    local originalTable = native.loadPointer(context, layout.DISPATCH_TABLE)
    native.store64(nextTable, 8, native.load64(originalTable, 16))
    native.storePointer(context, layout.DISPATCH_TABLE, nextTable)
    native.storePointer(context, 64, nextPC)
    native.storePointer(context, 72, regs)
    native.storePointer(context, 80, ints)
    native.storePointer(context, 88, floats)
    native.storePointer(context, 96, context)
    native.storePointer(context, 104, frame)
    local first = pressure(1ULL, 2ULL, 4ULL, 8ULL, 16ULL, 32ULL, 64ULL, output)
    local second = pressure(first, 1ULL, 2ULL, 3ULL, 4ULL, 5ULL, 6ULL, output)
    native.store64(output, 16, first)
    native.store64(output, 24, second)

    return native.dispatch(nextPC, regs, ints, floats, context, frame)
end

export function CoreWrong(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return 99ULL
end

export function CoreCapture(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.address(pc) ~= native.load64(context, 64) then
        return 1ULL
    end
    if native.address(regs) ~= native.load64(context, 72) then
        return 2ULL
    end
    if native.address(ints) ~= native.load64(context, 80) then
        return 3ULL
    end
    if native.address(floats) ~= native.load64(context, 88) then
        return 4ULL
    end
    if native.address(context) ~= native.load64(context, 96) then
        return 5ULL
    end
    if native.address(frame) ~= native.load64(context, 104) then
        return 6ULL
    end
    if native.address(frame) == native.address(regs) - 32ULL
        or native.address(frame) == native.load64(context, layout.DISPATCH_TABLE)
    then
        return 7ULL
    end
    if native.load64(context, layout.DISPATCH_TABLE) ~= native.address(ints) + 512ULL then
        return 8ULL
    end
    local output = native.offset(ints, 640)
    if native.load64(output, 16) ~= 127ULL
        or native.load64(output, 24) ~= 138ULL
        or native.load64(output, 8) ~= 138ULL
    then
        return 9ULL
    end

    return 0ULL
end
