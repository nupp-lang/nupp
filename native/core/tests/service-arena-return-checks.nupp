module nupp.core.servicearenareturnchecks

-- Draft assertions over the actual closed Arena source graphs, before final
-- sealing. This helper neither issues ownership nor executes the services.
local graph = require("nupp.compiler.vm.graph")
local lower = require("nupp.compiler.vm.lower")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local cleanup = require("nupp.compiler.vm.nativecleanup")
local physical = require("nupp.compiler.vm.nativephysical")
local service = require("nupp.compiler.vm.nativeservice")

local function refuses(callback: function(): nil, text: string): nil
    local ok, message = pcall(callback)
    assert(not ok, "unissued Arena return authority accepted")
    assert(tostring(message):find(text, 1, true), tostring(message))
end

local function copy(value: any): any
    local result = {}
    for key, item in pairs(value) do
        result[key] = item
    end

    return result
end

local function checked(build: any, name: string): (any, any)
    local owner = nil
    for _, item in ipairs(service.owners(build.catalog)) do
        if item.scope.name == "nupp.runtime.vm.arena" and item.name == name then
            assert(owner == nil)
            owner = item
        end
    end
    assert(owner, "actual Arena constructor missing: " .. name)
    local operations = {}
    local profile = cleanup.profile(nativegraph)
    local emit = profile.emit
    -- Exercise the same private operation binding as the closed factory,
    -- using the actual emission node rather than reconstructing it afterward.
    profile.emit = function(ctx: any, node: any, op: string, args: any, kind: string?): integer?
        local value = emit(ctx, node, op, args, kind)
        if op == "NativeLeafCall" then
            local target = service.recordTarget(ctx.g, args[1], node)
            operations[#operations + 1] = {declaration = args[1], node = node, target = target}
        end

        return value
    end
    local g = lower.functionGraph(owner, service.options(build.catalog, owner), profile)
    graph.verify(g)
    service.verifyScope(g)

    return g, operations
end

local function operationBindings(g: any, operations: any): nil
    local ordinary, terminals = 0, 0
    for _, operation in ipairs(operations) do
        local declaration, node = operation.declaration, operation.node
        assert(service.recordTarget(g, declaration, node) == operation.target)
        refuses(
            function(): nil
                service.recordTarget(g, copy(declaration), node)
            end,
            "unissued service operation"
        )
        if service.arenaCleanup(g, declaration) then
            terminals = terminals + 1
            refuses(
                function(): nil
                    service.recordTarget(g, declaration, copy(node))
                end,
                "occurrence is outside checked owner"
            )
            -- The target's body is checked, but belongs to a different owner.
            refuses(
                function(): nil
                    service.recordTarget(g, declaration, operation.target.body)
                end,
                "occurrence is outside checked owner"
            )
        else
            ordinary = ordinary + 1
            refuses(
                function(): nil
                    service.recordTarget(g, declaration, copy(node))
                end,
                "service operation owner/site differs"
            )
        end
    end
    assert(ordinary > 0, "actual Arena source call missing")
    if g.source.name ~= "openWith" then
        assert(terminals > 0, "actual Arena terminal emission missing")
    end
end

local function views(g: any): nil
    local count = 0
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativePointerView" then
                local view = block.args[index][2]
                if physical.viewKind(view) == "arenaReturn" then
                    count = count + 1
                    physical.validateCast(view)
                    local owner = g.nativePhysical.signature.owner
                    assert(physical.affineValue(owner, view.target))
                    local unowned = physical.describe(view.target.context, view.target.checkedType)
                    refuses(
                        function(): nil
                            physical.affineValue(owner, unowned)
                        end,
                        "lacks ownership origin"
                    )
                    refuses(
                        function(): nil
                            physical.validateCast(copy(view))
                        end,
                        "unknown checked pointer cast"
                    )
                    local saved = view.source
                    view.source = view.target
                    local ok, message = pcall(physical.validateCast, view)
                    view.source = saved
                    assert(
                        not ok and tostring(message):find("issued physical record field changed", 1, true),
                        tostring(message)
                    )
                    saved = view.target
                    view.target = view.source
                    ok, message = pcall(physical.validateCast, view)
                    view.target = saved
                    assert(
                        not ok and tostring(message):find("issued physical record field changed", 1, true),
                        tostring(message)
                    )
                    local node = view.node
                    view.node = copy(node)
                    ok, message = pcall(physical.validateCast, view)
                    view.node = node
                    assert(
                        not ok and tostring(message):find("issued physical record field changed", 1, true),
                        tostring(message)
                    )
                    physical.validateCast(view)
                end
            end
        end
    end
    assert(count == 1, "actual Arena constructor must have one owning return view")
end

local function offsets(g: any): nil
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "PointerOffset" and g.nativePhysical.values[block.dst[index]] then
                local args, value = block.args[index], block.dst[index]
                assert(service.arenaOffsetOrigin(g, args, value))
                assert(not service.arenaOffsetOrigin({}, args, value))
                assert(not service.arenaOffsetOrigin(g, copy(args), value))
                local saved = args[2]
                args[2] = args[1]
                local ok, message = pcall(service.arenaOffsetOrigin, g, args, value)
                args[2] = saved
                assert(not ok and tostring(message):find("Arena offset operand changed", 1, true), tostring(message))
                local descriptor = g.nativePhysical.values[value]
                g.nativePhysical.values[value] = physical.describe(descriptor.context, descriptor.checkedType)
                ok, message = pcall(service.arenaOffsetOrigin, g, args, value)
                g.nativePhysical.values[value] = descriptor
                assert(
                    not ok and tostring(message):find("Arena offset source or descriptor changed", 1, true),
                    tostring(message)
                )
                assert(service.arenaOffsetOrigin(g, args, value))
            end
        end
    end
end

local function cleanupInstances(g: any): integer
    local found: integer = 0
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local args = block.args[index]
                local declaration = args[1]
                if service.arenaCleanup(g, declaration) then
                    found = found + 1
                    local actual = g.nativePhysical.values[args[2]]
                    assert(actual and service.arenaCleanup(g, declaration, actual))
                    assert(not service.arenaCleanup(g, copy(declaration)))
                    -- The raw source argument is an extent, not the acquired
                    -- owner. Do not manufacture a descriptor to test this.
                    assert(g.nativePhysical.values[1] == nil)
                    local saved = declaration.service
                    declaration.service = {}
                    local ok, message = pcall(service.arenaCleanup, g, declaration, actual)
                    declaration.service = saved
                    assert(not ok and tostring(message):find("service", 1, true), tostring(message))
                    assert(service.arenaCleanup(g, declaration, actual))
                end
            end
        end
    end

    return found
end

local function missingClose(g: any): nil
    local changed = false
    for _, block in ipairs(g.blocks) do
        if not changed then
            for index, op in ipairs(block.op) do
                if op == "NativeLeafCall" and service.arenaCleanup(g, block.args[index][1]) then
                    assert(block.dst[index] == 0, "implicit close unexpectedly produces a result")
                    local saved = {}
                    for _, field in ipairs({"op", "dst", "args", "pos", "cert"}) do
                        saved[field] = table.remove(block[field], index)
                    end
                    local ok, message = pcall(service.verifyScope, g)
                    for _, field in ipairs({"op", "dst", "args", "pos", "cert"}) do
                        table.insert(block[field], index, saved[field])
                    end
                    assert(
                        not ok and tostring(message):find("Arena failure leaves its acquired owner live", 1, true),
                        tostring(message)
                    )
                    changed = true
                    break
                end
            end
        end
    end
    assert(changed, "forwarding constructor lacked an implicit close to remove")
    graph.verify(g)
    service.verifyScope(g)
end

-- Re-enable the actual live flag cleared immediately before the first
-- close. The later unwind must now be rejected as a second retirement.
local function repeatedClose(g: any): nil
    local changed = false
    for _, block in ipairs(g.blocks) do
        if not changed then
            for index, op in ipairs(block.op) do
                if op == "NativeLeafCall" and service.arenaCleanup(g, block.args[index][1]) then
                    assert(index > 1 and block.op[index - 1] == "NativeBoolean")
                    local flag = block.args[index - 1]
                    assert(flag[1] == false, "close must clear its actual live flag")
                    flag[1] = true
                    local ok, message = pcall(service.verifyScope, g)
                    flag[1] = false
                    assert(
                        not ok
                        and tostring(message):find("Arena failure reuses or misroutes its acquired owner", 1, true),
                        tostring(message)
                    )
                    changed = true
                    break
                end
            end
        end
    end
    assert(changed, "forwarding constructor lacked an implicit close to repeat")
    graph.verify(g)
    service.verifyScope(g)
end

local function forwardingCall(g: any): nil
    local found = false
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local args = block.args[index]
                local declaration = args[1]
                if declaration.moduleName == "nupp.runtime.vm.arena" and declaration.name == "openWith" then
                    found = true
                    -- The record is already privately issued; changing its
                    -- callee or source cannot inherit that authority.
                    local saved = declaration.name
                    declaration.name = "close"
                    local ok, message = pcall(service.validateIssued, declaration)
                    declaration.name = saved
                    assert(
                        not ok and tostring(message):find("service declaration source changed", 1, true),
                        tostring(message)
                    )
                    saved = declaration.source
                    declaration.source = copy(saved)
                    ok, message = pcall(service.validateIssued, declaration)
                    declaration.source = saved
                    assert(
                        not ok and tostring(message):find("service record field changed", 1, true),
                        tostring(message)
                    )
                    -- The final hidden operand is the issued service scope;
                    -- the actual first parameter is merely the byte extent.
                    local at = #args
                    assert(declaration.params[at - 1] == "voidptr" and g.exactTypes[1] == "uint64")
                    saved = args[at]
                    args[at] = 1
                    ok, message = pcall(service.verifyScope, g)
                    args[at] = saved
                    assert(
                        not ok and tostring(message):find("call scope is not the retained entry scope", 1, true),
                        tostring(message)
                    )
                    service.validateIssued(declaration)
                    service.verifyScope(g)
                end
            end
        end
    end
    assert(found, "actual forwarding constructor call missing")
end

local function takesEntry(g: any): nil
    local signature = g.nativePhysical.signature
    local owner = signature.owner
    local source = g.nativePhysical.values[1]
    local node, key = owner.body.params[1], owner.parameterDefinitions[1]
    assert(source == signature.params[1] and source.checkedType == key.type)
    assert(key.type.tag == "affine" and #key.type.cleanups == 0)
    assert(owner.parameterModes[1] == "takes" and node.modeTok.text == "takes")
    physical.takesEntry(owner, signature, source, node, key, 1)
    assert(physical.affineValue(owner, source))
    refuses(
        function(): nil
            physical.takesEntry(owner, copy(signature), source, node, key, 1)
        end,
        "unknown checked pointer signature"
    )
    refuses(
        function(): nil
            physical.takesEntry(owner, signature, source, node, copy(key), 1)
        end,
        "exact checked parameter and SSA"
    )
    refuses(
        function(): nil
            physical.takesEntry(owner, signature, source, node, key, 2)
        end,
        "exact checked parameter and SSA"
    )
    refuses(
        function(): nil
            physical.takesEntry(owner, signature, source, copy(node), key, 1)
        end,
        "exact checked parameter and SSA"
    )
    local fresh = physical.describe(source.context, source.checkedType)
    refuses(
        function(): nil
            physical.takesEntry(owner, signature, fresh, node, key, 1)
        end,
        "exact checked parameter and SSA"
    )
    local saved = g.nativePhysical.values[1]
    g.nativePhysical.values[1] = fresh
    local ok = pcall(graph.verify, g)
    g.nativePhysical.values[1] = saved
    assert(not ok, "takes entry accepted a replacement without its issued owner origin")
    graph.verify(g)
    -- Validation did not turn the incoming owner into a local acquisition.
    physical.takesEntry(owner, signature, source, node, key, 1)
    assert(source == signature.params[1] and physical.affineValue(owner, source))
end

export function check(build: any): nil
    local close = checked(build, "close")
    takesEntry(close)
    graph.prune(close)
    graph.verify(close)
    service.verifyScope(close)
    takesEntry(close)
    for _, name in ipairs({"openWith", "open", "openGrowable"}) do
        local g, operations = checked(build, name)
        operationBindings(g, operations)
        views(g)
        offsets(g)
        local before = cleanupInstances(g)
        if name ~= "openWith" then
            assert(before > 0, "forwarding constructor lacks failure-only ownership cleanup")
            missingClose(g)
            repeatedClose(g)
            forwardingCall(g)
        end
        graph.verify(g)
        service.verifyScope(g)
        graph.prune(g)
        graph.verify(g)
        service.verifyScope(g)
        operationBindings(g, operations)
        views(g)
        offsets(g)
        assert(cleanupInstances(g) == before, "prune changed implicit terminal inventory")
        if name ~= "openWith" then
            missingClose(g);
            repeatedClose(g);
            forwardingCall(g)
        end
    end
end
