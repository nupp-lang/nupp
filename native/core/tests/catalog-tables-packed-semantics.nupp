module nupp.core.catalogtablespackedsemantics

-- What Lua sees of tables the core packs (runtime Decision 15): checked
-- `{integer}`, `{float}` and `{boolean}` tables, written by typed code and
-- through `any`, read by indexing, `#`, `next`, `ipairs` and the table
-- library. Every observation goes into a log whose checksum is the result,
-- which reference Lua computes from the twin (catalog-tables-packed-semantics.lua).
-- Hash keys are counted, not listed, since Lua's order for them is its own.
local log: {string} = {}

-- Its argument as `any`, which the checker follows no further: a write
-- through it is untyped.
local function erase(t: any): any
    return t
end

local function put(x: any): nil
    log[#log + 1] = tostring(x)
end

local function walk(t: any): nil
    local k = next(t)
    local count = 0
    while k ~= nil do
        count = count + 1
        if math.type(k) == "integer" and k >= 1 and k <= 8 then
            put(k)
            put(t[k])
        end
        k = next(t, k)
    end
    put(count)
end

local function sequence(t: any): nil
    for i, v in ipairs(t) do
        put(i)
        put(v)
    end
    put(#t)
end

local ints: {integer} = {1, 2, 3}
ints[4] = 4
ints[2] = math.maxinteger
ints[3] = math.mininteger
sequence(ints)
local loose: any = erase(ints)
loose[4] = nil
sequence(ints)
loose[2] = "two"
sequence(ints)
walk(ints)

local floats: {float} = {1.5, -0.0, 2.5}
floats[4] = 0.25
sequence(floats)
put(1 / floats[2] < 0)
loose = erase(floats)
loose[1] = 3
put(math.type(loose[1]))
sequence(floats)

local flags: {boolean} = {true, false, true}
flags[4] = false
sequence(flags)
walk(flags)
loose = erase(flags)
loose[5] = 0
sequence(flags)

local holed: {integer} = {1, 2, 3, 4}
loose = erase(holed)
loose[2] = nil
put(holed[2])
put(holed[3])
walk(holed)
for i, v in ipairs(holed) do
    put(i)
    put(v)
end

local far: {integer} = {1, 2, 3}
loose = erase(far)
loose[10] = 10
sequence(far)
walk(far)

local floated: {integer} = {1, 2, 3}
loose = erase(floated)
loose[2] = 2.0
put(math.type(loose[2]))
sequence(floated)

local keyed: {integer} = {1, 2, 3}
loose = erase(keyed)
loose.name = 5
loose[0] = 6
loose[-1] = 7
loose[1.5] = 8
loose[2.0] = 20
loose[4.0] = 40
put(loose[3.0])
put(loose[1.5])
put(loose[0])
sequence(keyed)
walk(keyed)

local list: {integer} = {5, 3, 8}
table.insert(list, 1)
table.insert(list, 1, 9)
put(table.remove(list, 2))
put(table.remove(list))
table.sort(list)
put(table.concat(list, " "))
local copy: {integer} = {}
table.move(list, 1, #list, 1, copy)
table.move(copy, 1, 2, 2)
put(table.concat(copy, " "))
put(select("#", table.unpack(list)))
local a, b, c = table.unpack(list)
put(a + b * 10 + c * 100)
local reals: {float} = {2.5, 0.5, 1.5}
table.sort(reals, function(x: float, y: float): boolean
    return x > y
end)
put(table.concat(reals, ","))
rawset(list, 4, 10)
rawset(list, 1, 1)
put(rawget(list, 2))
sequence(list)
put(table.remove(list, 1))
sequence(list)
local wide: {integer} = {math.maxinteger, 1, math.mininteger, 3}
table.sort(wide)
sequence(wide)
put(table.concat(wide, ","))
table.insert(wide, 1, math.maxinteger - 5)
put(table.remove(wide, 3))
table.move(wide, 1, 3, 2)
put(table.concat(wide, ","))
local p, q, r = table.unpack(wide, 2, 4)
put(p)
put(q)
put(r)
for k, v in pairs(wide) do
    put(k)
    put(v)
end

local text = table.concat(log, ";")
local sum = 0
for i = 1, #text do
    sum = (sum * 31 + string.byte(text, i)) % 1000000007
end

export = sum
