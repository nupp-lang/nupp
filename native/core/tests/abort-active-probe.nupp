module nupp.runtime.core.abortactiveprobe

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const arena = require("nupp.runtime.core.arena")
const frames = require("nupp.runtime.core.frames")

local function copy(to: voidptr, from: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        native.store64(to, native.index(at), native.load64(from, native.index(at)))
        at = at + 8ULL
    end

    return 1ULL
end

local function same(a: voidptr, b: voidptr, bytes: uint64): uint64
    local at: uint64 = 0ULL
    while at < bytes do
        if native.load64(a, native.index(at)) ~= native.load64(b, native.index(at)) then
            return 0ULL
        end
        at = at + 8ULL
    end

    return 1ULL
end

-- A mapped invalid-field probe, not arbitrary pointer-corruption admission.
-- The complete fixture region includes State, Segment, Control and every frame.
local function refuses(state: voidptr, callee: voidptr, snapshot: voidptr): uint64
    copy(snapshot, state, 2048ULL)
    if frames.abortActive(state, callee) ~= 0ULL then
        return 0ULL
    end

    return same(snapshot, state, 2048ULL)
end

local function changed(
    state: voidptr,
    callee: voidptr,
    snapshot: voidptr,
    target: voidptr,
    offset: int64,
    bad: uint64
): uint64
    local old = native.load64(target, offset)
    native.store64(target, offset, bad)
    local result = refuses(state, callee, snapshot)
    native.store64(target, offset, old)

    return result
end

local function setup(storage: voidptr, helperBase: uint64, helperBytes: uint64): uint64
    local segment = native.offset(storage, 64)
    local control = native.offset(storage, 112)
    local info = native.offset(storage, 224)
    local plan = native.offset(storage, 352)
    local code = native.address(storage) + 432ULL
    local pool = native.address(storage) + 512ULL
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("version"), 1ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("id"), 1ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("bodyOwner"), code)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("code"), code)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("instructionCount"), 2ULL)
    native.store64(info, native.fieldOffset<frames.FunctionInfo>("valueCount"), 2ULL)
    if arena.initialize(segment, pool, 1536ULL) == 0ULL or frames.planFixed(info, plan) == 0ULL then
        return 0ULL
    end
    if native.load64(plan, native.fieldOffset<frames.WindowPlan>("bytes")) > 512ULL then
        return 0ULL
    end
    native.store64(storage, native.fieldOffset<frames.State>("limit"), 3ULL)
    native.store64(storage, native.fieldOffset<frames.State>("segment"), native.address(segment))
    native.store64(storage, native.fieldOffset<frames.State>("helperBase"), helperBase)
    native.store64(storage, native.fieldOffset<frames.State>("helperBytes"), helperBytes)

    return frames.beginRoot(storage, control, info, plan)
end

local function invalidActive(state: voidptr, parent: voidptr, child: voidptr, snapshot: voidptr): uint64
    local mark = native.offset(parent, native.fieldOffset<frames.Frame>("childMark"))
    local segment = native.offset(state, 64)
    if changed(
        state,
        child,
        snapshot,
        state,
        native.fieldOffset<frames.State>("active"),
        native.address(parent)
    ) == 0ULL
        or changed(state, child, snapshot, state, native.fieldOffset<frames.State>("depth"), 1ULL) == 0ULL
        or changed(state, child, snapshot, child, native.fieldOffset<frames.Frame>("phase"), frames.PREPARED) == 0ULL
        or changed(state, child, snapshot, parent, native.fieldOffset<frames.Frame>("phase"), frames.ACTIVE) == 0ULL
        or changed(
            state,
            child,
            snapshot,
            child,
            native.fieldOffset<frames.Frame>("child"),
            native.address(parent)
        ) == 0ULL
        or changed(
            state,
            child,
            snapshot,
            child,
            native.fieldOffset<frames.Frame>("resultOwner"),
            native.address(child)
        ) == 0ULL
        or changed(state, child, snapshot, parent, native.fieldOffset<frames.Frame>("resumePC"), 2ULL) == 0ULL
    then
        return 0ULL
    end
    if changed(state, child, snapshot, mark, native.fieldOffset<arena.Mark>("owner"), native.address(parent)) == 0ULL
        or changed(state, child, snapshot, mark, native.fieldOffset<arena.Mark>("serial"), 0ULL) == 0ULL
        or changed(state, child, snapshot, mark, native.fieldOffset<arena.Mark>("finish"), 0ULL) == 0ULL
        or changed(state, child, snapshot, segment, native.fieldOffset<arena.Segment>("top"), 1ULL) == 0ULL
    then
        return 0ULL
    end

    return 1ULL
end

local function unwind(state: voidptr, parent: voidptr, child: voidptr, depth: uint64): uint64
    local slots = native.loadPointer(parent, native.fieldOffset<frames.Frame>("values"))
    local mark = native.offset(parent, native.fieldOffset<frames.Frame>("childMark"))
    local before = native.load64(mark, native.fieldOffset<arena.Mark>("before"))
    local previous = native.load64(mark, native.fieldOffset<arena.Mark>("previous"))
    native.store64(slots, 8, 0x123456789abcdef0ULL)
    native.store64(state, native.fieldOffset<frames.State>("lastResultCount"), 1ULL)
    if frames.abortActive(state, child) ~= 1ULL then
        return 0ULL
    end
    -- No access to child or its slots follows the release.
    if native.load64(slots, 8) ~= 0x123456789abcdef0ULL
        or native.load64(parent, native.fieldOffset<frames.Frame>("child")) ~= 0ULL
        or native.load64(parent, native.fieldOffset<frames.Frame>("phase")) ~= frames.ACTIVE
        or native.load64(parent, native.fieldOffset<frames.Frame>("resumePC")) ~= 1ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= native.address(parent)
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= depth
        or native.load64(state, native.fieldOffset<frames.State>("lastResultCount")) ~= 0ULL
        or native.load64(native.offset(state, 64), native.fieldOffset<arena.Segment>("cursor")) ~= before
        or native.load64(native.offset(state, 64), native.fieldOffset<arena.Segment>("top")) ~= previous
    then
        return 0ULL
    end

    return 1ULL
end

local function lifecycle(state: voidptr, snapshot: voidptr, controlSnapshot: voidptr, root: voidptr): uint64
    local info, plan, control = native.offset(state, 224), native.offset(state, 352), native.offset(state, 112)
    local serial = native.load64(
        native.offset(control, native.fieldOffset<frames.RootControl>("mark")),
        native.fieldOffset<arena.Mark>("serial")
    )
    copy(controlSnapshot, control, native.sizeOf<frames.RootControl>())
    if refuses(state, root, snapshot) == 0ULL then
        return 3ULL
    end
    local address = frames.prepareFixed(state, root, info, values.NIL, 0ULL, 0ULL, 1ULL, plan)
    if address == 0ULL then
        return 4ULL
    end
    local child = native.pointer(address)
    if refuses(state, child, snapshot) == 0ULL then
        return 5ULL
    end
    if frames.publish(state, root, child, 1ULL) ~= 1ULL then
        return 6ULL
    end
    local nestedAddress = frames.prepareFixed(state, child, info, values.NIL, 0ULL, 0ULL, 1ULL, plan)
    if nestedAddress == 0ULL then
        return 7ULL
    end
    local nested = native.pointer(nestedAddress)
    if refuses(state, child, snapshot) == 0ULL or refuses(state, nested, snapshot) == 0ULL then
        return 8ULL
    end
    if frames.publish(state, child, nested, 1ULL) ~= 1ULL then
        return 9ULL
    end
    if invalidActive(state, child, nested, snapshot) == 0ULL then
        return 10ULL
    end
    if unwind(state, child, nested, 2ULL) == 0ULL then
        return 11ULL
    end
    if unwind(state, root, child, 1ULL) == 0ULL then
        return 12ULL
    end
    if same(controlSnapshot, control, native.sizeOf<frames.RootControl>()) == 0ULL then
        return 13ULL
    end
    copy(snapshot, state, 2048ULL)
    if frames.abortRoot(state, control, root, serial + 1ULL) ~= 0ULL or same(snapshot, state, 2048ULL) == 0ULL then
        return 14ULL
    end
    if frames.abortRoot(state, control, root, serial) ~= 1ULL then
        return 15ULL
    end
    -- Retired root is not dereferenced. A later entry must acquire a fresh serial.
    local nextAddress = frames.beginRoot(state, control, info, plan)
    if nextAddress == 0ULL or nextAddress ~= native.address(root) then
        return 16ULL
    end
    local nextRoot = native.pointer(nextAddress)
    local nextSerial = native.load64(
        native.offset(control, native.fieldOffset<frames.RootControl>("mark")),
        native.fieldOffset<arena.Mark>("serial")
    )
    copy(snapshot, state, 2048ULL)
    if nextSerial <= serial
        or frames.abortRoot(state, control, nextRoot, serial) ~= 0ULL
        or same(snapshot, state, 2048ULL) == 0ULL
    then
        return 17ULL
    end
    if frames.abortRoot(state, control, nextRoot, nextSerial) ~= 1ULL
        or native.load64(state, native.fieldOffset<frames.State>("active")) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("depth")) ~= 0ULL
        or native.load64(state, native.fieldOffset<frames.State>("lastResultCount")) ~= 0ULL
    then
        return 18ULL
    end

    return 0ULL
end

-- Test-only six-argument leaf; no guest call execution or production entry policy.
-- ints is a zeroed 2048-byte fixture, floats its snapshot, regs holds control and
-- context snapshots. Embedded descriptors remain trusted and mapped throughout.
-- pc+4/pc+8 bind the producer's exact whole-chain helper extent and offset.
export function CoreAbortActiveProbe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.sizeOf<frames.State>() > 64ULL
        or native.sizeOf<arena.Segment>() > 48ULL
        or native.sizeOf<frames.RootControl>() > 112ULL
        or native.sizeOf<frames.FunctionInfo>() > 128ULL
        or native.sizeOf<frames.WindowPlan>() > 64ULL
    then
        return 1ULL
    end
    local offset, bytes = native.load64(pc, 8), native.word(native.load32(pc, 4))
    local base = native.address(context)
    if bytes == 0ULL or offset > 65536ULL or bytes > 65536ULL - offset or base > 0xffffffffffffffffULL - offset then
        return 1ULL
    end
    copy(native.offset(regs, 128), context, 128ULL)
    local address = setup(ints, base + offset, bytes)
    if address == 0ULL then
        return 2ULL
    end
    local result = lifecycle(ints, floats, regs, native.pointer(address))
    if result ~= 0ULL then
        return result
    end
    if same(native.offset(regs, 128), context, 128ULL) == 0ULL then
        return 19ULL
    end

    return 0ULL
end
