module nupp.runtime.core.heapboundschecks

const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.vm.arena")
const heap = require("nupp.runtime.vm.heap")

const MAXIMUM: uint64 = 0xffffffffffffffffULL
const MAX_WORDS: uint64 = 0x1fffffffffffffffULL

-- Scenarios for the combined native heap workload. The service scope observes
-- errors and mapping cleanup; the frozen VM must not execute these functions.
export function arenaRefusals(): uint64
    @unsafe do
        do
            local a = arena.open(64ULL)
            local before = a.cursor
            if arena.alloc(a, 8ULL, 0ULL) ~= nil then
                return 1ULL
            end
            if arena.alloc(a, 8ULL, 3ULL) ~= nil then
                return 2ULL
            end
            if arena.alloc(a, MAXIMUM, 8ULL) ~= nil then
                return 3ULL
            end
            if arena.pool(a, MAXIMUM) ~= nil then
                return 4ULL
            end
            if a.cursor ~= before then
                return 5ULL
            end
            local value = arena.alloc(a, 8ULL, 16ULL)
            if value == nil then
                return 6ULL
            end
            local address = native.address(value)
            if (address & 15ULL) ~= 0ULL or address < before or address > a.limit or 8ULL > a.limit - address then
                return 7ULL
            end
            return 0ULL
        end
    end
end

-- A zero-payload growable arena is one OS page. Aligning a full payload to
-- that page skips the chunk header and exhausts every fresh mapping. The old
-- allocator returned an out-of-bounds pointer after its first growth here.
export function arenaGrowthAlignment(): uint64
    @unsafe do
        do
            local a = arena.openGrowable(0ULL)
            local bytes = a.chunkBytes
            if bytes == 0ULL or (bytes & (bytes - 1ULL)) ~= 0ULL or bytes <= native.sizeOf<arena.Chunk>() then
                return 1ULL
            end
            local before = native.address(a.chunk)
            if arena.alloc(a, bytes - native.sizeOf<arena.Chunk>(), bytes) ~= nil then
                return 2ULL
            end
            if native.address(a.chunk) == before then
                return 3ULL
            end
            local previous = a.chunk.previous
            if previous == nil then
                return 4ULL
            end
            if native.address(previous) ~= before
                or a.chunk.bytes ~= bytes
                or a.limit ~= native.address(a.chunk) + bytes
            then
                return 5ULL
            end
            if a.cursor ~= native.address(a.chunk) + native.sizeOf<arena.Chunk>() or a.cursor > a.limit then
                return 6ULL
            end
            local value = arena.alloc(a, 8ULL, 8ULL)
            if value == nil then
                return 7ULL
            end
            local address = native.address(value)
            if address > a.limit or 8ULL > a.limit - address then
                return 8ULL
            end
            return 0ULL
        end
    end
end

-- Each remaining scenario must terminate at its bound error site, with no
-- published result and no mapping acquired. A normal return is a test failure.
export function arenaOpenOverflow(): uint64
    do
        local a = arena.open(MAXIMUM)
        return 1ULL
    end
end

export function wordGrowthOverflow(): uint64
    @unsafe do
        local words = heap.Words(0ULL, MAX_WORDS, MAX_WORDS)
        heap.wordsPush(words, 1ULL)
        return 1ULL
    end
end

export function wordMappingOverflow(): uint64
    @unsafe do
        local words = heap.Words(0ULL, MAX_WORDS - 1ULL, MAX_WORDS - 1ULL)
        heap.wordsPush(words, 1ULL)
        return 1ULL
    end
end

export function wordInvalidCapacity(): uint64
    @unsafe do
        local words = heap.Words(0ULL, 0ULL, MAXIMUM)
        heap.wordsPush(words, 1ULL)
        return 1ULL
    end
end

export function wordInvalidCount(): uint64
    @unsafe do
        local words = heap.Words(0ULL, 1ULL, 0ULL)
        heap.wordsPush(words, 1ULL)
        return 1ULL
    end
end

export function setGrowthOverflow(): uint64
    @unsafe do
        local words = heap.WordSet(0ULL, 0ULL, MAX_WORDS - 1ULL)
        heap.setAdd(words, 1ULL)
        return 1ULL
    end
end

export function setInvalidMask(): uint64
    @unsafe do
        local words = heap.WordSet(0ULL, MAX_WORDS, 0ULL)
        heap.setAdd(words, 1ULL)
        return 1ULL
    end
end
