module nupp.core.rawcatalogfixture

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local program = require("nupp.compiler.vm.programgraph")
local tagged = require("nupp.compiler.vm.taggedprofile")
local contracts = require("nupp.compiler.vm.coregraphcontracts")
local codec = require("nupp.compiler.vm.coregraphcodec")
local schema = require("nupp.compiler.vm.coregraphschema")
local json = require("serde.json")
require("nupp.compiler.syntax.triviaarena.table")
require("nupp.compiler.project.projectconfig")
require("nupp.compiler.hash")
local rawheader = require("nupp.core.rawheaderfixture")

local function encoded(source: string): any
    local path, name = "=raw_catalog_fixture.nupp", "raw_catalog_fixture"
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0, "raw graph fixture parse")
    local env: any = environment.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = checker.check(parsed, path, env, {
        moduleName = name,
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
    for _, diagnostic in ipairs(diagnostics) do
        assert(diagnostic.severity ~= "error", diagnostic.msg)
    end
    local catalog = program.describe({{name = name, path = path, parsed = parsed, diagnostics = diagnostics}}, name)

    return contracts.normalize(program.compile(catalog, tagged))
end

export function data(): string
    return rawheader.data()
end

export function dataVariant(kind: string): string
    local source
    if kind == "shared" then
        source = "local function first(v: boolean): boolean return v end\n"
            .. "local function second(v: boolean): boolean return v end\nreturn second(first(true))"
    elseif kind == "repeated" then
        source = "local function same(v: boolean): boolean return v end\nreturn same(same(true))"
    elseif kind == "nested" then
        source = "local function outer(v: boolean): boolean local function inner(w: boolean): boolean return w end return inner(v) end\nreturn outer(true)"
    elseif kind == "branch" then
        source = "local function identity(value: boolean): boolean return value end\nreturn identity(true)"
    elseif kind == "return0" then
        source = "return"
    else
        assert(kind == "nil1")
        source = "return nil"
    end
    local p = encoded(source)
    if kind == "shared" then
        assert(#p.signatures == 2 and #p.catalog == 3)
        assert(p.catalog[2].signature == p.catalog[3].signature)
    elseif kind == "branch" then
        -- Synthetic persistent CFG from checked identity, not source ifStmt admission.
        p.graphs[
            2
        ].blocks = {
            {
                id = 1,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "branch", value = 1, edges = {{target = 2, args = {}}, {target = 3, args = {}}}}
            },
            {
                id = 2,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "return", value = 1, edges = {}}
            },
            {
                id = 3,
                params = {},
                op = {},
                dst = {},
                args = {},
                pos = {},
                cert = {},
                term = {kind = "return", value = 1, edges = {}}
            }
        }
    end

    return codec.encode(p)
end

export function validateMany(path: string): string
    local list = assert(io.open(path, "rb"))
    local inputs = json.decodevalue(list:read("*a"))
    list:close()
    local results = {}
    for _, input in ipairs(inputs) do
        local file = assert(io.open(input.path, "rb"))
        local bytes = file:read("*a")
        file:close()
        local physical = pcall(codec.validateShape, bytes)
        local catalog, metrics = pcall(codec.validateCatalog, bytes)
        local semantic = pcall(codec.decode, bytes)
        results[
            input.name
        ] = {physical = physical, catalog = catalog, semantic = semantic, metrics = catalog and metrics or nil}
    end

    return json.encodevalue(results)
end

export function wire(): string
    return json.encodevalue(schema.wire())
end

export function definition(): string
    return json.encodevalue(schema.describe())
end
