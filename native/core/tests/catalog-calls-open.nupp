module nupp.core.catalogcallsopen

-- Generic packs pass a callback's arguments and results through whole: a
-- function with open results returns every result of the call last in its
-- return, after any fixed ones.
local function apply<A..., R...>(callback: function(A...): R..., ...: A...): R...
    return callback(...)
end

local function swap(a: integer, b: integer): (integer, integer)
    return b, a
end

local function three(): (integer, string, boolean)
    return 3, "three", true
end

local function prefix<R...>(f: function(): R...): (string, R...)
    return "p", f()
end

-- A library call with several results, last in such a return, gives them all.
local function bytes(s: string): ...integer
    return string.byte(s, 1, 3)
end

local x, y = apply(swap, 1, 2)
local n, s, b = apply(three)
local p, m, t = prefix(three)
local score: integer = x * 10 + y
if n == 3 and s == "three" and b == true then
    score = score + 100
end
if p == "p" and m == 3 and t == "three" then
    score = score + 1000
end
local c1, c2, c3 = bytes("abc")
if c1 == 97 and c2 == 98 and c3 == 99 then
    score = score + 10000
end
export = score
