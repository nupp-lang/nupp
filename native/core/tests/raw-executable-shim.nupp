module nupp.core.rawexecutableshim

local arm = require("s0.arm64")
local selector = require("s0.select")
local linker = require("nupp.core.link")

-- Test-only packet: the selected raw service writes the catalog into scratch,
-- then this boundary returns its status and exact bytes for independent checks.
export function build(functions: {[string]: any}, symbol: string): any
    local scratchBytes: integer = 33554432
    local requestOffset: integer = 128
    local dispatchOffset: integer = 256
    local catalogOffset: integer = 1024
    local catalogBytes: integer = 4096
    local poolOffset: integer = 8192
    local poolBytes: integer = 18874368
    local spillOffset: integer = poolOffset + poolBytes
    local validator = "nupp.runtime.core.guestcatalog.validate"
    local boundary: any = {
        words = {arm.bl(0), arm.bl(0)},
        frameBytes = 0,
        fixupWord = {1, 2},
        fixupKind = {selector.BL26, selector.BL26},
        fixupName = {symbol, validator},
        fixupAddend = {0, 0}
    }
    local extent: integer = linker.assemble({}, {boundary}, functions, scratchBytes - spillOffset).callBytes
    assert(extent >= 16 and extent % 16 == 0 and spillOffset + extent <= scratchBytes)
    local words: {integer} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function imm(reg: integer, value: integer): nil
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(reg: integer, base: integer, value: integer): nil
        assert(reg ~= base)
        imm(reg, value)
        emit(arm.add_reg(64, reg, base, reg, 0))
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160))
    emit(arm.str(8, 0, 31, 168))
    emit(arm.ldr(8, 19, 0, 40))
    emit(arm.ldr(8, 20, 0, 24))
    emit(arm.ldr(8, 21, 0, 32))
    emit(arm.ldr(8, 22, 0, 56))
    offset(23, 19, spillOffset)
    offset(24, 19, requestOffset)
    offset(25, 19, dispatchOffset)
    offset(26, 19, catalogOffset)
    offset(14, 19, poolOffset)
    emit(arm.str(8, 20, 24, 0))
    emit(arm.str(8, 21, 24, 8))
    emit(arm.str(8, 26, 24, 16))
    imm(16, catalogBytes)
    emit(arm.str(8, 16, 24, 24))
    emit(arm.str(8, 14, 24, 32))
    imm(16, poolBytes)
    emit(arm.str(8, 16, 24, 40))
    emit(arm.str(8, 23, 24, 48))
    imm(16, extent)
    emit(arm.str(8, 16, 24, 56))
    emit(arm.str(8, 25, 24, 64))
    imm(16, 57)
    emit(arm.str(8, 16, 24, 72))
    imm(16, 4)
    emit(arm.str(8, 16, 24, 80))
    emit(arm.ldr(8, 16, 31, 168))
    emit(arm.ldr(8, 16, 16, 72))
    emit(arm.ldr(8, 16, 16, 0))
    for scenario = 1, 4 do
        emit(arm.cmp_imm(64, 16, scenario, 0))
        local skip = #words + 1
        emit(arm.b_cond(1, 0))
        if scenario == 1 then
            emit(arm.str(8, 31, 24, 24))
        elseif scenario == 2 then
            imm(17, 8)
            emit(arm.str(8, 17, 25, 0))
        elseif scenario == 3 then
            emit(arm.str(8, 20, 24, 16))
        else
            emit(arm.str(8, 31, 24, 40))
        end
        words[skip] = arm.b_cond(1, (#words + 1 - skip) * 4)
    end
    emit(arm.mov_reg(64, 0, 24))
    local call = #words + 1
    emit(arm.bl(0))
    emit(arm.str(8, 0, 31, 176))
    offset(26, 19, catalogOffset)
    emit(arm.mov_reg(64, 0, 26))
    emit(arm.ldr(8, 1, 26, 8))
    local validate = #words + 1
    emit(arm.bl(0))
    emit(arm.ldr(8, 20, 31, 176))
    emit(arm.and_reg(64, 0, 0, 20))
    emit(arm.ldr(8, 22, 31, 160))
    emit(arm.str(8, 0, 22, 0))
    offset(26, 19, catalogOffset)
    for index = 0, 127 do
        emit(arm.ldr(8, 16, 26, index * 8))
        emit(arm.str(8, 16, 22, (index + 1) * 8))
    end
    emit(arm.movz(64, 0, 0, 0))
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0))
    emit(arm.ret(30))
    boundary.words, boundary.fixupWord = words, {call, validate}
    local linked = linker.assemble({}, {boundary}, functions, scratchBytes - spillOffset)
    assert(linked.callBytes == extent and linked.offsets[1] == 0)

    return {
        words = linked.words,
        entry = 0,
        scratchBytes = scratchBytes,
        spillOffset = spillOffset,
        callBytes = extent,
        outputWords = 129,
        catalogOffset = catalogOffset,
        catalogBytes = catalogBytes,
        poolOffset = poolOffset,
        poolBytes = poolBytes
    }
end
