module nupp.runtime.core.grayfailurechecks

const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.vm.arena")
const heap = require("nupp.runtime.vm.heap")
const marking = require("nupp.runtime.vm.marking")
const values = require("nupp.runtime.vm.values")

-- Retained workload storage, disjoint from the heap, roots and helper arena.
-- The native failure observer reads this snapshot before releasing backing;
-- it must not resume collection or clear the failed service scope to inspect it.
export struct Snapshot
    heap: uint64
    child: uint64
    color: uint64
    gray: uint64
    count: uint64
    previous: uint64
    poolLive: int64
    cursor: uint64
    armed: uint64
end

-- The combined owned-core workload supplies a real Heap and a rooted live
-- WHITE child. Run once with an empty queue and once with a full segment,
-- populated by real shading. A fresh fixed metadata arena has no free pool
-- slots. Root vectors and inspection storage must already be provisioned.
-- A return is a fixture failure; success is the bound gray-stack error exit.
export function refuseGrowth(h: heap.Heap*, value: uint64, snapshot: Snapshot*): uint64
    @unsafe do
        if snapshot.armed ~= 0ULL or value & values.TAG_MASK ~= values.TAG_OBJ then
            return 1ULL
        end
        local address = value & values.PAYLOAD
        if not heap.isLiveSlot(h, address) then
            return 2ULL
        end
        local child = native.pointer(address) as heap.Header*
        if child.color as uint64 ~= heap.COLOR_WHITE then
            return 3ULL
        end
        local pool = h.grayPool
        local a = pool.arena
        if pool.free ~= nil or a.growable or a.cursor > a.limit then
            return 4ULL
        end
        local count: uint64 = 0ULL
        local previous: uint64 = 0ULL
        if h.gray ~= 0ULL then
            local segment = native.pointer(h.gray) as heap.Segment*
            count = segment.count
            previous = segment.previous
            if count ~= heap.SEGMENT_WORDS then
                return 5ULL
            end
        end
        if a.cursor < a.limit and arena.alloc(a, a.limit - a.cursor, 1ULL) == nil then
            return 6ULL
        end
        snapshot.heap = native.address(h as voidptr)
        snapshot.child = address
        snapshot.color = child.color as uint64
        snapshot.gray = h.gray
        snapshot.count = count
        snapshot.previous = previous
        snapshot.poolLive = pool.live
        snapshot.cursor = a.cursor
        snapshot.armed = 1ULL
        marking.shadeValue(h, value)
        return 7ULL
    end
end
