module nupp.core.catalogworkloadclosures

-- The `closures` workload of bench/vm/workloads.bench.nupp, whose checksum
-- at scale 1 is 499892. The scale is read from BENCH_SCALE at run time, as the
-- original reads it, so no compiler can fold it away.
local scale: number = tonumber(os.getenv("BENCH_SCALE") or "1") or 1

local function closures(): number
    local function map(xs: {number}, f: function(number): number): {number}
        local out: {number} = {}
        for i = 1, #xs do
            out[i] = f(xs[i])
        end

        return out
    end

    local xs: {number} = {}
    for i = 1, 100000 do
        xs[i] = i * scale
    end
    local total = 0
    for round = 1, 30 do
        local ys = map(xs, function(v: number): number
            return v * round + 1
        end)
        total = (total + ys[#ys]) % 1000003
    end

    return total
end

export const result = closures()
