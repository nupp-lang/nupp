module nupp.core.stringticketentry

const native = require("nupp.runtime.vm.intrinsics")
const os = require("nupp.runtime.vm.os")
const heap = require("nupp.runtime.vm.heap")
const pages = require("nupp.runtime.core.pagemappings")
const shared = require("nupp.runtime.core.sharedbacking")
const servicescope = require("nupp.runtime.core.servicescope")
const tables = require("nupp.runtime.core.coretables")
const entry = require("nupp.core.releasequeueentry")

const NORMAL: uint64 = 0ULL
const PENDING: uint64 = 4ULL
const OBS_BLOCK: uint64 = 32ULL
const OBS_TARGET: uint64 = 40ULL
const OBS_OTHER: uint64 = 48ULL
const OBS_QUEUED: uint64 = 56ULL
const OBS_TICKET: uint64 = 72ULL

export function prepare(base: voidptr, bytes: uint64): uint64
    return entry.prepare(base, bytes)
end

local function bit(ok: boolean, flag: uint64): uint64
    if ok then
        return flag
    end
    return 0ULL
end

-- All failed frames have returned. Observe before this test-only entry clears
-- the sticky error and resumes explicit teardown. No consumed token is read.
export function finish(scope: voidptr): uint64
    @unsafe do
        local failure = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error"))
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        local extra = native.sizeOf<servicescope.ServiceScope>()
        local h = native.pointer(native.load64(scope, native.index(extra))) as heap.Heap*
        local mode = native.load64(scope, native.index(extra + 24ULL))
        local target = native.pointer(native.load64(scope, native.index(extra + OBS_TARGET))) as heap.Header*
        local other = native.pointer(native.load64(scope, native.index(extra + OBS_OTHER))) as heap.Header*
        local answer = bit((mode == NORMAL and failure == 0ULL) or (mode ~= NORMAL and failure == 1ULL), 1ULL)
        answer = answer | bit(h.liveCount == 0ULL and h.liveBytes == 0ULL, 2ULL)
        answer = answer | bit(native.load64(scope, native.index(extra + OBS_QUEUED)) == 2ULL, 4ULL)
        if mode == PENDING then
            local block = native.pointer(native.load64(scope, native.index(extra + OBS_BLOCK)))
            local token = native.load64(scope, native.index(extra + OBS_TICKET))
            local node = native.pointer(token) as pages.RangeTicket*
            answer = answer
                | bit(
                    h.released.count == 2ULL and heap.wordAt(h.released, 1ULL) == native.address(target as voidptr),
                    8ULL
                )
            answer = answer
                | bit(
                    heap.corestringtail(target).ticket == token
                    and heap.corestringtail(target).block == native.address(block)
                    and target.auxLen == 130ULL,
                    16ULL
                )
            answer = answer
                | bit(
                    node.phase == shared.TICKET_DETACHED
                    and pages.ticketreferences(token) == 0ULL
                    and shared.ticketcount(block) == 0ULL,
                    32ULL
                )
            -- Restore only fixture corruption. The next drain must finish the
            -- pending ticket rather than trying to drop its last alias again.
            if pages.sharedcompare(block, 0ULL, 1ULL) ~= 0ULL then
                error("string ticket observer: restore refused")
            end
        elseif mode == NORMAL then
            answer = answer | bit(h.released.count == 0ULL, 8ULL)
            answer = answer
                | bit(
                    heap.corestringtail(target).ticket == 0ULL
                    and heap.corestringtail(target).block == 0ULL
                    and target.auxLen == 0ULL,
                    16ULL
                )
            answer = answer | bit(other.auxLen == 0ULL, 32ULL)
        else
            answer = answer
                | bit(
                    h.released.count == 1ULL and heap.wordAt(h.released, 0ULL) == native.address(other as voidptr),
                    8ULL
                )
            answer = answer
                | bit(
                    heap.corestringtail(target).ticket == 0ULL
                    and heap.corestringtail(target).block == 0ULL
                    and target.auxLen == 0ULL,
                    16ULL
                )
            answer = answer | bit(other.auxLen == 97ULL and heap.corestringexternal(other), 32ULL)
        end
        tables.drain(h)
        answer = answer | bit(h.released.count == 0ULL, 64ULL)
        heap.destroy(h)
        os.unmapPages(
            native.pointer(native.load64(scope, native.index(extra + 8ULL))),
            native.load64(scope, native.index(extra + 16ULL))
        )
        answer = answer | bit(servicescope.close(scope) == 1ULL, 128ULL)
        return answer
    end
end
