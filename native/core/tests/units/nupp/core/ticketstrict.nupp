module nupp.core.ticketstrict

const pages = require("nupp.runtime.core.pagemappings")
const shared = require("nupp.runtime.core.sharedbacking")

local struct OtherResult
    ticket: uint64
end

local struct OtherScope
    a: uint64
    b: uint64
    c: uint64
    d: uint64
    e: uint64
    f: uint64
    g: uint64
end

export function acquire(block: voidptr): uint64
    local result = shared.TicketResult(0ULL)
    @unsafe do
        local out = result as shared.TicketResult*
        if shared.ticketacquire(out, block, 0ULL, 1ULL) ~= shared.TICKET_OK then
            error("ticket strict: acquire refused")
        end
        return out.ticket
    end
end

export function finish(ticket: uint64): uint64
    local status = pages.Scope(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        local out = status as pages.Scope*
        if shared.ticketfinish(out, ticket) == shared.RELEASED and out.status == 0ULL then
            return 1ULL
        end
        return 0ULL
    end
end

export function release(ticket: uint64): uint64
    local status = pages.Scope(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        local out = status as pages.Scope*
        if shared.ticketrelease(out, ticket) == shared.RELEASED and out.status == 0ULL then
            return 1ULL
        end
        return 0ULL
    end
end

export function wrongacquire(block: voidptr): uint64
    local result = shared.TicketResult(0ULL)
    @unsafe do
        return shared.ticketacquire((result as OtherResult*) as shared.TicketResult*, block, 0ULL, 1ULL)
    end
end

export function wrongfinish(ticket: uint64): uint64
    local status = pages.Scope(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        return shared.ticketfinish((status as OtherScope*) as pages.Scope*, ticket)
    end
end

export function wrongrelease(ticket: uint64): uint64
    local status = pages.Scope(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        return shared.ticketrelease((status as OtherScope*) as pages.Scope*, ticket)
    end
end
