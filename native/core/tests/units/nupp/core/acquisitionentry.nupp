module nupp.core.acquisitionentry

const native = require("nupp.runtime.vm.intrinsics")
const service = require("nupp.runtime.core.servicescope")
const entry = require("nupp.core.unitentry")
const os = require("nupp.runtime.vm.os")
const context = require("nupp.runtime.core.context")

const CHILD: uint64 = 2ULL
const POOL: uint64 = 3ULL
const QUOTA: uint64 = 4ULL
const PIPE: uint64 = 1ULL
const ORIGINAL: uint64 = 88ULL
const BAD_FD: int64 = -9
const NO_CHILD: int64 = -10
const REFUSED: uint64 = 0xffffffffffffffe8ULL

export function prepare(base: voidptr, bytes: uint64): uint64
    return entry.prepare(base, bytes)
end

-- Runs after the interrupted native stack has retired. Checking the real OS
-- objects, not record counts, detects leaked pipe ends and unreaped children.
export function finish(scope: voidptr): uint64
    local extra = native.offset(scope, native.index(native.sizeOf<service.ServiceScope>()))
    local mode = native.load64(extra, 0)
    local result = native.load64(extra, 8)
    local other = native.load64(extra, 16)
    local cancel = native.load64(extra, 24)
    local ctx = native.offset(extra, 128)
    local wanted = context.BUDGET_STATUS
    if cancel ~= 0ULL then
        wanted = context.CANCELLED_STATUS
    end
    local okay = result >> 63ULL == 0ULL
        and native.load64(ctx, context.STATUS) == wanted
        and native.load64(ctx, context.ERROR_OWNER) == ORIGINAL
        and native.load64(ctx, context.ERROR_PC) == 0ULL
    okay = service.close(scope) == 1ULL and okay
    okay = native.load64(ctx, context.STATUS) == wanted and okay
    okay = native.load64(scope, native.fieldOffset<service.ServiceScope>("error")) == ORIGINAL and okay
    if mode == CHILD then
        okay = os.processReap(result) == NO_CHILD and okay
    elseif mode == POOL then
        -- Canceled or finished, this exact ticket is spent.
        okay = os.poolCancel(result) == 0 and okay
    else
        okay = os.fileSeek(result, 0ULL, 0ULL) == BAD_FD and okay
        if mode == PIPE then
            okay = os.fileSeek(other, 0ULL, 0ULL) == BAD_FD and okay
        elseif mode == QUOTA then
            okay = other == REFUSED and okay
        end
    end
    native.store64(scope, native.fieldOffset<service.ServiceScope>("error"), 0ULL)
    if okay then
        return 1ULL
    end

    return 0ULL
end
