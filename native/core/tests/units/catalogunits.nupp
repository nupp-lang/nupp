module catalogunits

-- The raw catalog's call-graph check (nupp.runtime.core.rawcatalog.acyclic)
-- over compressed rows, at owner counts past the 256 the catalog once
-- admitted: an offset per owner plus one, a callee per call edge, and each
-- owner's in-degree counted from every edge.
const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.vm.arena")
const raw = require("nupp.runtime.core.rawcatalog")

-- Appends a call edge to `target`; answers the edge count after it.
local function edge(targets: uint64, degree: uint64, edges: uint64, target: uint64): uint64
    native.store64(native.pointer(targets + edges * 8ULL), 0, target)
    local at = degree + target * 8ULL
    native.store64(native.pointer(at), 0, native.load64(native.pointer(at), 0) + 1ULL)

    return edges + 1ULL
end

-- 1 when `count` owners calling as `shape` says are acyclic, else 0. Shapes:
-- 0, each owner calls the next; 1, that chain closed by the last calling the
-- first; 2, the first owner calls every other twice; 3, the chain with the
-- last calling itself.
export function calls(count: uint64, shape: uint64): uint64
    local answer: uint64 = 0ULL
    do
        local a = arena.open(count * 64ULL + 65536ULL)
        @unsafe do
            local block = arena.alloc(a, count * 40ULL + 8ULL, 8ULL)
            if block == nil then
                error("catalog units: no room for the call graph")
            end
            -- Raw addresses keep the loops free of the nullable pointer.
            local offsets = native.address(block)
            local targets = offsets + (count + 1ULL) * 8ULL
            local degree = targets + count * 16ULL
            local queue = degree + count * 8ULL
            local i: uint64 = 0ULL
            while i < count do
                native.store64(native.pointer(degree + i * 8ULL), 0, 0ULL)
                i = i + 1ULL
            end
            local edges: uint64 = 0ULL
            i = 0ULL
            while i < count do
                native.store64(native.pointer(offsets + i * 8ULL), 0, edges)
                if shape == 2ULL then
                    if i == 0ULL then
                        local j: uint64 = 1ULL
                        while j < count do
                            edges = edge(targets, degree, edges, j)
                            edges = edge(targets, degree, edges, j)
                            j = j + 1ULL
                        end
                    end
                elseif i + 1ULL < count then
                    edges = edge(targets, degree, edges, i + 1ULL)
                elseif shape == 1ULL then
                    edges = edge(targets, degree, edges, 0ULL)
                elseif shape == 3ULL then
                    edges = edge(targets, degree, edges, i)
                end
                i = i + 1ULL
            end
            native.store64(native.pointer(offsets + count * 8ULL), 0, edges)
            answer = raw.acyclic(
                native.pointer(offsets),
                native.pointer(targets),
                native.pointer(degree),
                native.pointer(queue),
                count
            )
        end
    end

    return answer
end
