module nupp.runtime.core.guesthandlers

const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const frames = require("nupp.runtime.core.frames")
const access = require("nupp.runtime.core.frameaccess")
const ops = require("nupp.runtime.core.guestops")
const context = require("nupp.runtime.core.context")
const guestscope = require("nupp.runtime.core.guestscope")
const catalog = require("nupp.runtime.core.guestcatalog")
const guestlib = require("nupp.runtime.core.guestlib")
const strings = require("nupp.runtime.core.corestrings")
const tables = require("nupp.runtime.core.coretables")
const heap = require("nupp.runtime.vm.heap")
const wide = require("nupp.runtime.core.coreintegers")
const threads = require("nupp.runtime.core.threads")
const guestio = require("nupp.runtime.core.guestio")
const basics = require("nupp.runtime.core.guestbasics")
const widths = require("nupp.runtime.core.guestwidths")
const numbers = require("nupp.runtime.core.guestnumbers")
const bitops = require("nupp.runtime.core.guestbits")
const corestorage = require("nupp.runtime.core.corestorage")
const modules = require("nupp.runtime.core.modules")
const texts = require("nupp.runtime.core.guesttexts")

-- The closed checked producer binds these program/slot reads to corebytecode's
-- canonical opcode recipes and its retained complete graph-derived byte stream.
-- Dispatch begins only with real entry-owned State/Frame/window/code facts.
-- RetNil, callbacks and escaping closure handles are refused.

export function K(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local index = program.readSigned32(pc, 4)
    if native.word(dst) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if index < 0 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local value = ops.constant(ctx, frame, pc, native.word(index))
    if value & 0xffff000000000000ULL == catalog.STRING_CONSTANT then
        value = values.TAG_OBJ | guestscope.stringConstant(ctx, value)
    end
    if value & 0xffff000000000000ULL == catalog.INTEGER_CONSTANT then
        value = guestscope.integerConstant(ctx, value)
    end
    if value == 0ULL then
        if ops.constantPresent(ctx, frame, pc, native.word(index)) == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
    end
    slots.writeValue(frame, regs, dst, value)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Require(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local target = program.readSigned32(pc, 4)
    if native.word(dst) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if target < 0 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    -- From v8 a module's chunk runs when first required, as a call; later
    -- requires take the value it answered.
    if modules.lazy(ctx) == 1ULL then
        local loaded = modules.cached(ctx, native.word(target))
        if loaded == 0ULL then
            ops.checkpoint(ctx, frame, pc)
            if modules.begin(ctx, frame, pc, native.word(target), native.word(dst)) ~= 1ULL then
                -- A require cycle runs out of frames as Lua's does.
                if texts.overflow(ctx) == 1ULL then
                    ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
                else
                    ops.failure(ctx, ops.INVALID)
                end
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        slots.writeValue(frame, regs, dst, loaded)
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    local value = ops.moduleValue(ctx, frame, pc, native.word(target))
    if value == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, value)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- Dynamic numbers: binary64 floats and signed 48-bit integer immediates.
-- Integer results that need a canonical integer object refuse with RESOURCE
-- until the core has one; they never round or wrap into a wrong value.
-- Because every integer here is an immediate, converting one to binary64 is
-- exact, so mixed arithmetic and comparison through floats is Lua's exact
-- result. Boxed integers will need the exact mixed algorithms.
const ADD: uint64 = 0ULL
const SUB: uint64 = 1ULL
const MUL: uint64 = 2ULL
const MOD: uint64 = 3ULL
const HIGH16: uint64 = 0xffff000000000000ULL
const SIGN48: uint64 = 0x0000800000000000ULL
const HIGH17: uint64 = 0xffff800000000000ULL
const SIGN64: uint64 = 0x8000000000000000ULL

-- Non-number words report why arithmetic produced no value: TRUE for an
-- operand that is not a number, NIL for an unrepresentable integer, and
-- FALSE for integer modulo by zero.
local function integerWord(value: uint64): boolean
    return value & HIGH16 == values.TAG_INTEGER
end

local function floatWord(value: uint64): boolean
    return value & values.QNAN ~= values.QNAN or value == values.QNAN
end

local function integerBits(value: uint64): uint64
    local payload = value & values.PAYLOAD
    return native.chooseWord(payload & SIGN48 ~= 0ULL, payload | HIGH16, payload)
end

local function integerValue(bits: uint64): uint64
    local high = bits & HIGH17
    if high == 0ULL or high == HIGH17 then
        return values.TAG_INTEGER | (bits & values.PAYLOAD)
    end

    return values.NIL
end

-- Leaves pass floats as IEEE bits; float values stay inside one function.
local function doubleBits(value: uint64): uint64
    if integerWord(value) then
        return native.bits(native.toFloat(native.index(integerBits(value))))
    end
    return value
end

local function floatValue(bits: uint64): uint64
    return native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits)
end

-- C fmod: the exact remainder with the dividend's sign, by shift-and-subtract
-- on the significands (the musl algorithm). Exponents are signed because a
-- subnormal's normalized exponent falls below zero.
local function fmod(ux: uint64, uy: uint64): uint64
    local x = native.fromBits(ux)
    local y = native.fromBits(uy)
    local ex = native.index((ux >> 52) & 0x7ffULL)
    local ey = native.index((uy >> 52) & 0x7ffULL)
    local sx = ux & SIGN64
    if uy << 1 == 0ULL or y ~= y or ex == 0x7ffLL then
        return native.bits((x * y) / (x * y))
    end
    if ux << 1 <= uy << 1 then
        if ux << 1 == uy << 1 then
            return ux & SIGN64
        end
        return ux
    end
    local mx = ux
    if ex == 0LL then
        local probe = mx << 12
        while probe >> 63 == 0ULL do
            ex = ex - 1LL
            probe = probe << 1
        end
        mx = mx << native.word(1LL - ex)
    else
        mx = (mx & 0x000fffffffffffffULL) | 0x0010000000000000ULL
    end
    local my = uy
    if ey == 0LL then
        local probe = my << 12
        while probe >> 63 == 0ULL do
            ey = ey - 1LL
            probe = probe << 1
        end
        my = my << native.word(1LL - ey)
    else
        my = (my & 0x000fffffffffffffULL) | 0x0010000000000000ULL
    end
    while ex > ey do
        local difference = mx - my
        if difference >> 63 == 0ULL then
            if difference == 0ULL then
                return ux & SIGN64
            end
            mx = difference
        end
        mx = mx << 1
        ex = ex - 1LL
    end
    local difference = mx - my
    if difference >> 63 == 0ULL then
        if difference == 0ULL then
            return ux & SIGN64
        end
        mx = difference
    end
    while mx >> 52 == 0ULL do
        mx = mx << 1
        ex = ex - 1LL
    end
    if ex > 0LL then
        mx = (mx - 0x0010000000000000ULL) | (native.word(ex) << 52)
    else
        mx = mx >> native.word(1LL - ex)
    end

    return mx | sx
end

-- Lua's floor modulo for immediates: truncated remainder by magnitudes, then
-- moved to the divisor's sign. A zero divisor is an error, not a value.
local function integerModulo(a: uint64, b: uint64): uint64
    if b == 0ULL then
        return values.FALSE
    end
    local negativeA = a & SIGN64 ~= 0ULL
    local negativeB = b & SIGN64 ~= 0ULL
    local magnitudeA = native.chooseWord(negativeA, 0ULL - a, a)
    local magnitudeB = native.chooseWord(negativeB, 0ULL - b, b)
    local remainder = magnitudeA - (magnitudeA // magnitudeB) * magnitudeB
    local m = native.chooseWord(negativeA, 0ULL - remainder, remainder)
    if m ~= 0ULL and negativeA ~= negativeB then
        m = m + b
    end

    return integerValue(m)
end

local function arithmetic(operation: uint64, left: uint64, right: uint64): uint64
    -- A boxed integer operand takes the wide path (NIL), as does an integer
    -- result outside the immediates.
    if wide.boxed(left) or wide.boxed(right) then
        return values.NIL
    end
    local leftInteger = integerWord(left)
    local rightInteger = integerWord(right)
    if not (leftInteger or floatWord(left)) or not (rightInteger or floatWord(right)) then
        return values.TRUE
    end
    if leftInteger and rightInteger then
        local a = integerBits(left)
        local b = integerBits(right)
        if operation == ADD then
            return integerValue(a + b)
        elseif operation == SUB then
            return integerValue(a - b)
        elseif operation == MUL then
            return integerValue(a * b)
        end
        return integerModulo(a, b)
    end
    local x = native.fromBits(doubleBits(left))
    local y = native.fromBits(doubleBits(right))
    if operation == ADD then
        return floatValue(native.bits(x + y))
    elseif operation == SUB then
        return floatValue(native.bits(x - y))
    elseif operation == MUL then
        return floatValue(native.bits(x * y))
    end
    -- Lua's float modulo: fmod moved to the divisor's sign. The native
    -- profile has no float literals, so zero is spelled by its bits.
    local zero = native.fromBits(0ULL)
    local m = native.fromBits(fmod(native.bits(x), native.bits(y)))
    if m > zero then
        if y < zero then
            m = m + y
        end
    elseif m < zero and y ~= m then
        if y > zero then
            m = m + y
        end
    end

    return floatValue(native.bits(m))
end

-- The wide path of arithmetic: integers wider than the immediates wrap in
-- int64 and are boxed; a boxed integer meeting a float becomes its float.
-- Answers as arithmetic does (TRUE not a number, FALSE modulo by zero).
local function wideResult(ctx: voidptr, operation: uint64, left: uint64, right: uint64): uint64
    if wide.isInteger(left) and wide.isInteger(right) then
        if operation == MOD and wide.bitsOf(right) == 0ULL then
            return values.FALSE
        end
        return guestscope.integer(ctx, wide.arithmetic(operation, wide.bitsOf(left), wide.bitsOf(right)))
    end
    local x = left
    local y = right
    if wide.boxed(x) then
        x = wide.toFloatBits(wide.bitsOf(x))
    end
    if wide.boxed(y) then
        y = wide.toFloatBits(wide.bitsOf(y))
    end

    return arithmetic(operation, x, y)
end

-- Comparisons with a boxed integer: 1 true, 0 false, 2 not numbers.
local function wideOrder(orEqual: boolean, left: uint64, right: uint64): uint64
    local li = wide.isInteger(left)
    local ri = wide.isInteger(right)
    if li and ri then
        local a = native.index(wide.bitsOf(left))
        local b = native.index(wide.bitsOf(right))
        if orEqual then
            return native.asWord(a <= b)
        end
        return native.asWord(a < b)
    end
    if li and floatWord(right) then
        return native.asWord(wide.intFloatLess(wide.bitsOf(left), doubleBits(right), orEqual))
    end
    if ri and floatWord(left) then
        return native.asWord(wide.floatIntLess(doubleBits(left), wide.bitsOf(right), orEqual))
    end

    return 2ULL
end

-- Comparisons of two strings, byte by byte: 1 true, 0 false, 2 not strings.
local function stringOrder(orEqual: boolean, left: uint64, right: uint64): uint64
    local a = strings.header(left)
    local b = strings.header(right)
    if a == 0ULL or b == 0ULL then
        return 2ULL
    end

    return native.asWord(strings.less(a, b, orEqual))
end

-- 1 for true, 0 for false, 2 for an operand that is not a number.
local function order(orEqual: boolean, left: uint64, right: uint64): uint64
    local leftInteger = integerWord(left)
    local rightInteger = integerWord(right)
    if not (leftInteger or floatWord(left)) or not (rightInteger or floatWord(right)) then
        return 2ULL
    end
    if leftInteger and rightInteger then
        local a = native.index(integerBits(left))
        local b = native.index(integerBits(right))
        return native.asWord(a < b or orEqual and a == b)
    end
    local x = native.fromBits(doubleBits(left))
    local y = native.fromBits(doubleBits(right))
    if orEqual then
        return native.asWord(x <= y)
    end

    return native.asWord(x < y)
end

-- The header of a table value, or zero.
local function tableHeader(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local header = native.pointer(value & values.PAYLOAD)
    if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_TABLE then
        return 0ULL
    end

    return value & values.PAYLOAD
end

-- Lua equality for scalars: numbers by value (NaN unequal, signed zeros
-- equal, integers and floats exact), Booleans and nil by identity. 1 or 0.
local function equal(left: uint64, right: uint64): uint64
    -- Boxed integers are interned: equal ones are one object. Only a float can
    -- equal a boxed integer without being it.
    if wide.boxed(left) and floatWord(right) then
        return native.asWord(wide.intFloatEqual(wide.bitsOf(left), doubleBits(right)))
    end
    if wide.boxed(right) and floatWord(left) then
        return native.asWord(wide.intFloatEqual(wide.bitsOf(right), doubleBits(left)))
    end
    local leftInteger = integerWord(left)
    local rightInteger = integerWord(right)
    local leftNumber = leftInteger or floatWord(left)
    local rightNumber = rightInteger or floatWord(right)
    if leftInteger and rightInteger then
        return native.asWord(left == right)
    end
    if leftNumber and rightNumber then
        local x = native.fromBits(doubleBits(left))
        local y = native.fromBits(doubleBits(right))
        return native.asWord(x == y)
    end

    return native.asWord(left == right)
end

export function Add(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = arithmetic(ADD, left, right)
    if result == values.NIL then
        result = wideResult(ctx, ADD, left, right)
    end
    -- Storage plus a count of elements is a view from there on.
    if result == values.TRUE and corestorage.isstorage(left) then
        local view = basics.storageoffset(ctx, left, right)
        if view == values.TRUE then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        slots.writeValue(frame, regs, dst, view)
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    -- Arithmetic on a non-number calls a table operand's metamethod, or is a
    -- guest error, as Lua raises one.
    if result == values.TRUE then
        local callee = guestscope.binaryMeta(ctx, guestscope.META_ADD, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_ARITH, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if result == values.NIL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    if result == values.FALSE then
        guestscope.fault(ctx, guestscope.FAULT_MODZERO, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, result)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Sub(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = arithmetic(SUB, left, right)
    if result == values.NIL then
        result = wideResult(ctx, SUB, left, right)
    end
    -- Arithmetic on a non-number calls a table operand's metamethod, or is a
    -- guest error, as Lua raises one.
    if result == values.TRUE then
        local callee = guestscope.binaryMeta(ctx, guestscope.META_SUB, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_ARITH, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if result == values.NIL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    if result == values.FALSE then
        guestscope.fault(ctx, guestscope.FAULT_MODZERO, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, result)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Mul(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = arithmetic(MUL, left, right)
    if result == values.NIL then
        result = wideResult(ctx, MUL, left, right)
    end
    -- Arithmetic on a non-number calls a table operand's metamethod, or is a
    -- guest error, as Lua raises one.
    if result == values.TRUE then
        local callee = guestscope.binaryMeta(ctx, guestscope.META_MUL, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_ARITH, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if result == values.NIL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    if result == values.FALSE then
        guestscope.fault(ctx, guestscope.FAULT_MODZERO, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, result)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Mod(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = arithmetic(MOD, left, right)
    if result == values.NIL then
        result = wideResult(ctx, MOD, left, right)
    end
    -- Arithmetic on a non-number calls a table operand's metamethod, or is a
    -- guest error, as Lua raises one.
    if result == values.TRUE then
        local callee = guestscope.binaryMeta(ctx, guestscope.META_MOD, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_ARITH, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if result == values.NIL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    if result == values.FALSE then
        guestscope.fault(ctx, guestscope.FAULT_MODZERO, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, result)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Lt(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = order(false, left, right)
    if result > 1ULL then
        result = wideOrder(false, left, right)
    end
    if result > 1ULL then
        result = stringOrder(false, left, right)
    end
    if result > 1ULL then
        -- A table operand's __lt decides, as a boolean.
        local callee = guestscope.binaryMeta(ctx, guestscope.META_LT, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 1ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_COMPARE, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, native.chooseWord(result == 1ULL, values.TRUE, values.FALSE))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Le(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = order(true, left, right)
    if result > 1ULL then
        result = wideOrder(true, left, right)
    end
    if result > 1ULL then
        result = stringOrder(true, left, right)
    end
    if result > 1ULL then
        -- A table operand's __le decides, as a boolean.
        local callee = guestscope.binaryMeta(ctx, guestscope.META_LE, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 1ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_COMPARE, left, right)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, native.chooseWord(result == 1ULL, values.TRUE, values.FALSE))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Eq(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, lhs, rhs = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(lhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(rhs) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local left, right = slots.readValue(frame, regs, lhs), slots.readValue(frame, regs, rhs)
    local result = equal(left, right)
    -- Two distinct tables are equal when an __eq of theirs says so.
    if result ~= 1ULL and tableHeader(left) ~= 0ULL and tableHeader(right) ~= 0ULL then
        local callee = guestscope.binaryMeta(ctx, guestscope.META_EQ, left, right)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, left)
            slots.writeValue(frame, regs, top + 2, right)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 1ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
    end
    slots.writeValue(frame, regs, dst, native.chooseWord(result == 1ULL, values.TRUE, values.FALSE))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Nil(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    if native.word(dst) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, values.NIL)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Move(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst, src = program.readByte(pc, 1), program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, slots.readValue(frame, regs, src))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function NewClosure(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local base, captures = program.readByte(pc, 2), program.readByte(pc, 3)
    local target = program.readWord(pc, 8)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(base) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if ops.heapClosures(ctx) == 1ULL then
        if ops.closureTarget(ctx, frame, pc, target) == 0ULL or native.word(base) + native.word(captures) >= count then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        -- Slot 0 holds the target as an integer immediate; captures follow.
        local header = guestscope.allocate(ctx, heap.KIND_CLOSURE, native.word(captures) + 1ULL)
        local body = native.pointer(native.load64(native.pointer(header), native.fieldOffset<heap.Header>("auxPtr")))
        native.store64(body, 0, values.TAG_INTEGER | target)
        local i: int64 = 0
        while i < captures do
            native.store64(
                body,
                native.index((native.word(i) + 1ULL) * 8ULL),
                slots.readValue(frame, regs, base + 1 + i)
            )
            i = i + 1
        end
        guestscope.initialized(ctx, header)
        slots.writeValue(frame, regs, dst, values.TAG_OBJ | header)
        local next = ops.branch(ctx, frame, pc, 0)
        if next == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end

        return native.dispatch(native.pointer(next), regs, ints, floats, ctx, frame)
    end
    if captures ~= 0 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local handle = ops.closure(ctx, frame, pc, target)
    if handle == 0ULL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, handle)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- The entry's guest heap lives in the services the context points at.
-- Allocation runs collector steps, so every value an allocating handler still
-- needs stays in a frame slot (the pool is a root range) until it is stored.
export function NewCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = guestscope.allocate(ctx, heap.KIND_CELL, 1ULL)
    local body = native.load64(native.pointer(header), native.fieldOffset<heap.Header>("auxPtr"))
    native.store64(native.pointer(body), 0, slots.readValue(frame, regs, src))
    guestscope.initialized(ctx, header)
    slots.writeValue(frame, regs, dst, values.TAG_OBJ | header)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- The header of a cell value, or zero.
local function cellHeader(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local header = native.pointer(value & values.PAYLOAD)
    if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_CELL then
        return 0ULL
    end

    return value & values.PAYLOAD
end

export function GetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = cellHeader(slots.readValue(frame, regs, src))
    if header == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local body = native.load64(native.pointer(header), native.fieldOffset<heap.Header>("auxPtr"))
    slots.writeValue(frame, regs, dst, native.load64(native.pointer(body), 0))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function SetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local cell = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(cell) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = cellHeader(slots.readValue(frame, regs, cell))
    if header == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    guestscope.store(ctx, header, 0ULL, slots.readValue(frame, regs, src))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- A capture of the running closure: slot 0 of the closure is its target, so
-- capture i is slot i + 1.
export function GetUpval(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local index = program.readSigned32(pc, 4)
    if native.word(dst) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) or index < 0 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local closure = native.load64(frame, native.fieldOffset<frames.Frame>("closureRoot"))
    if closure & values.TAG_MASK ~= values.TAG_OBJ then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = native.pointer(closure & values.PAYLOAD)
    local length = native.load64(header, native.fieldOffset<heap.Header>("auxLen"))
    if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_CLOSURE
        or native.word(index) + 1ULL >= length
    then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local body = native.load64(header, native.fieldOffset<heap.Header>("auxPtr"))
    slots.writeValue(
        frame,
        regs,
        dst,
        native.load64(native.pointer(body), native.index((native.word(index) + 1ULL) * 8ULL))
    )
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function NewTable(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    if native.word(dst) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    slots.writeValue(frame, regs, dst, values.TAG_OBJ | guestscope.newTable(ctx))
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- Indexing anything but a table raises, as Lua does without a metatable.
export function GetIdx(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local object = program.readByte(pc, 2)
    local key = program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(object) >= count or native.word(key) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = tableHeader(slots.readValue(frame, regs, object))
    if header == 0ULL and corestorage.isstorage(slots.readValue(frame, regs, object)) then
        -- Storage's element at a zero-based index.
        local element = basics.storageget(ctx, slots.readValue(frame, regs, object), slots.readValue(frame, regs, key))
        if element == values.TRUE then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        slots.writeValue(frame, regs, dst, element)
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    if header == 0ULL then
        guestscope.fault(ctx, guestscope.FAULT_INDEX, slots.readValue(frame, regs, object), values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    local keyValue = slots.readValue(frame, regs, key)
    local value = guestscope.tableGet(ctx, header, keyValue)
    local callee = guestscope.takeMeta(ctx)
    if callee ~= 0ULL then
        -- An __index function: called with the table and the key from the
        -- top of the call window, its result landing in dst.
        local top = native.index(count - 4ULL)
        slots.writeValue(frame, regs, top, callee)
        slots.writeValue(frame, regs, top + 1, guestscope.metaSelf(ctx))
        slots.writeValue(frame, regs, top + 2, keyValue)
        if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
            return native.fail()
        end
        local s = native.pointer(ops.state(ctx))
        local current = native.pointer(access.active(s))
        local currentValues = native.pointer(access.values(s, current))
        local currentIntegers = native.pointer(access.integers(s, current))
        local currentFloats = native.pointer(access.floats(s, current))
        local currentPC = native.pointer(access.pc(s, current))
        access.refresh(s, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end
    slots.writeValue(frame, regs, dst, value)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function SetIdx(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local object = program.readByte(pc, 1)
    local key = program.readByte(pc, 2)
    local src = program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(object) >= count or native.word(key) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local header = tableHeader(slots.readValue(frame, regs, object))
    if header == 0ULL and corestorage.isstorage(slots.readValue(frame, regs, object)) then
        if basics.storageset(
            ctx,
            slots.readValue(frame, regs, object),
            slots.readValue(frame, regs, key),
            slots.readValue(frame, regs, src)
        ) ~= 0ULL then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    if header == 0ULL then
        guestscope.fault(ctx, guestscope.FAULT_INDEX, slots.readValue(frame, regs, object), values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    local status = guestscope.tableSet(
        ctx,
        header,
        slots.readValue(frame, regs, key),
        slots.readValue(frame, regs, src)
    )
    if status == guestscope.META_PENDING then
        -- A __newindex function: called with the table, key and value from
        -- the top of the call window; its result is dropped.
        local top = native.index(count - 4ULL)
        local keyValue = slots.readValue(frame, regs, key)
        local item = slots.readValue(frame, regs, src)
        slots.writeValue(frame, regs, top, guestscope.takeMeta(ctx))
        slots.writeValue(frame, regs, top + 1, guestscope.metaSelf(ctx))
        slots.writeValue(frame, regs, top + 2, keyValue)
        slots.writeValue(frame, regs, top + 3, item)
        if ops.metaCall(ctx, frame, pc, 3ULL, count - 1ULL, 0ULL) ~= 1ULL then
            return native.fail()
        end
        local s = native.pointer(ops.state(ctx))
        local current = native.pointer(access.active(s))
        local currentValues = native.pointer(access.values(s, current))
        local currentIntegers = native.pointer(access.integers(s, current))
        local currentFloats = native.pointer(access.floats(s, current))
        local currentPC = native.pointer(access.pc(s, current))
        access.refresh(s, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end
    if status == guestscope.READONLY then
        guestscope.fault(ctx, guestscope.FAULT_READONLY, values.NIL, values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if status == tables.BAD_KEY then
        guestscope.fault(ctx, guestscope.FAULT_KEY, slots.readValue(frame, regs, key), values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if status ~= tables.OK then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function Len(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local value = slots.readValue(frame, regs, src)
    local header = tableHeader(value)
    local size: uint64 = 0ULL
    if header ~= 0ULL then
        -- A table whose metatable has __len answers what it returns.
        local callee = guestscope.binaryMeta(ctx, guestscope.META_LEN, value, values.NIL)
        if callee ~= 0ULL then
            local top = native.index(count - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, value)
            slots.writeValue(frame, regs, top + 2, value)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        size = tables.length(header)
    else
        local text = strings.header(value)
        if text == 0ULL then
            guestscope.fault(ctx, guestscope.FAULT_LENGTH, value, values.NIL)
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        size = strings.length(text)
    end
    slots.writeValue(frame, regs, dst, values.TAG_INTEGER | size)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- math.floor of a float's bits: an integer immediate when the floor is in the
-- 48-bit range (as Lua answers an integer when it fits), else the float.
local function floorBits(bits: uint64): uint64
    local floored = native.floor(native.fromBits(bits))
    local limit = native.fromBits(0x42e0000000000000ULL)
    if floored >= -limit and floored < limit then
        return values.TAG_INTEGER | (native.word(native.toInt(floored)) & values.PAYLOAD)
    end

    return native.bits(floored)
end

export function MathFloor(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local value = slots.readValue(frame, regs, src)
    local result = value
    if value & 0xffff000000000000ULL ~= values.TAG_INTEGER and not wide.boxed(value) then
        if value & values.QNAN == values.QNAN and value ~= values.QNAN then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        result = floorBits(value)
    end
    slots.writeValue(frame, regs, dst, result)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- A core library call (guestlib): its arguments are staged after `base`.
export function LibCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    -- The id's high bit marks a call in method form, for its errors.
    local encoded = native.word(program.readByte(pc, 2))
    local libraryId = encoded & 127ULL
    local base = program.readByte(pc, 3)
    local count = program.readByte(pc, 4)
    local valueCount = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= valueCount or count < 1 or count > 4 or native.word(base + count) >= valueCount then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local a = slots.readValue(frame, regs, base + 1)
    local b = values.NIL
    local c = values.NIL
    local d = values.NIL
    if count >= 2 then
        b = slots.readValue(frame, regs, base + 2)
    end
    if count >= 3 then
        c = slots.readValue(frame, regs, base + 3)
    end
    if count >= 4 then
        d = slots.readValue(frame, regs, base + 4)
    end
    -- .., /, //, tostring and unary minus on a table with the metamethod
    -- call it, its answer landing in dst.
    local which: uint64 = 0ULL
    local word = libraryId
    if word == guestlib.CONCAT2 then
        which = guestscope.META_CONCAT
    elseif word == guestlib.DIVIDE then
        which = guestscope.META_DIV
    elseif word == guestlib.FLOOR_DIVIDE then
        which = guestscope.META_IDIV
    elseif word == guestlib.POW then
        which = guestscope.META_POW
    elseif word == guestlib.TOSTRING then
        which = guestscope.META_TOSTRING
    elseif word == guestlib.UNM then
        which = guestscope.META_UNM
    end
    if which ~= 0ULL then
        local second = b
        if word == guestlib.TOSTRING or word == guestlib.UNM then
            second = a
        end
        local callee = guestscope.binaryMeta(ctx, which, a, second)
        if callee ~= 0ULL then
            local top = native.index(valueCount - 4ULL)
            slots.writeValue(frame, regs, top, callee)
            slots.writeValue(frame, regs, top + 1, a)
            slots.writeValue(frame, regs, top + 2, second)
            if ops.metaCall(ctx, frame, pc, 2ULL, native.word(dst), 0ULL) ~= 1ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
    end
    -- error(value [, level]) fails the entry here, so the failure records
    -- the pc the message's position names.
    if libraryId == guestlib.RERAISE then
        guestscope.raise(ctx, guestscope.lastError(ctx), 0ULL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    if libraryId == guestlib.ERROR then
        local level: uint64 = 1ULL
        if count >= 2 then
            level = guestlib.errorLevel(b)
        end
        guestscope.raise(ctx, a, level)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    -- rawequal(a, b): equality without __eq.
    if libraryId == basics.LIB_RAWEQUAL then
        if equal(a, b) == 1ULL then
            slots.writeValue(frame, regs, dst, values.TRUE)
        else
            slots.writeValue(frame, regs, dst, values.FALSE)
        end
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    -- assert(v [, message]): v when it holds; else the message, or
    -- "assertion failed!" for none, raised without a position as Lua's is.
    if libraryId == basics.LIB_ASSERT then
        if a == values.NIL or a == values.FALSE then
            local message = b
            if count < 2 or b == values.NIL then
                message = texts.textvalue(ctx, texts.TEXT_ASSERTION)
            end
            guestscope.raise(ctx, message, 0ULL)
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        slots.writeValue(frame, regs, dst, a)
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    guestscope.librarySite(ctx, frame, pc, native.word(count), encoded >> 7ULL)
    -- The coroutine library. Resume and yield switch threads: the context
    -- then runs the other thread, from its active frame.
    if libraryId >= threads.LIB_CREATE and libraryId <= threads.LIB_CLOSE then
        guestscope.nameLibrary(ctx, threads.libraryname(libraryId))
        local switched = true
        if libraryId == threads.LIB_CLOSE then
            -- Closing a suspended thread with cleanups runs it to unwind.
            local answer = threads.close(ctx, frame, pc, a, native.word(dst))
            if answer == threads.UNWIND then
                ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
                return native.fail()
            elseif answer == threads.BROKEN then
                ops.fail(ctx, frame, pc, ops.INVALID)
                return native.fail()
            end
            switched = answer == threads.SWITCHED
        elseif libraryId ~= threads.LIB_RESUME and libraryId ~= threads.LIB_YIELD then
            slots.writeValue(frame, regs, dst, threads.call(ctx, libraryId, a))
            switched = false
        elseif libraryId == threads.LIB_RESUME then
            local answer = threads.resume(ctx, frame, pc, a, b, threads.MODE_PACK, native.word(dst) | (1ULL << 32ULL))
            if answer == threads.BROKEN then
                ops.fail(ctx, frame, pc, ops.INVALID)
                return native.fail()
            end
            switched = answer == threads.SWITCHED
        elseif threads.yield(ctx, frame, pc, native.word(dst), a) ~= 1ULL then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        end
        guestscope.libraryReturned(ctx)
        if switched then
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        -- Otherwise dst has the answer: a refused resume's false and reason.
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    -- `require` of a computed name: the module the image holds by it, as a
    -- static require of it answers or starts it.
    if libraryId == modules.LIB_REQUIRE then
        guestscope.nameLibrary(ctx, texts.NAME_REQUIRE)
        if strings.header(a) == 0ULL then
            texts.argumentError(ctx, 1ULL, texts.TEXT_STRING, 0ULL, a)
        end
        local found = modules.named(ctx, a)
        if found == 0ULL then
            texts.moduleNotFound(ctx, a)
        end
        local target = found - 1ULL
        local loaded = modules.cached(ctx, target)
        guestscope.libraryReturned(ctx)
        if loaded == 0ULL then
            ops.checkpoint(ctx, frame, pc)
            if modules.begin(ctx, frame, pc, target, native.word(dst)) ~= 1ULL then
                if texts.overflow(ctx) == 1ULL then
                    ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
                else
                    ops.failure(ctx, ops.INVALID)
                end
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        slots.writeValue(frame, regs, dst, loaded)
        local after = ops.branch(ctx, frame, pc, 0)
        if after == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
    end
    if libraryId == guestio.LIB_WRITE then
        slots.writeValue(frame, regs, dst, guestio.write(ctx, a))
    elseif libraryId >= widths.LIB_NARROW and libraryId <= widths.LIB_I32WRAP then
        slots.writeValue(frame, regs, dst, widths.call(ctx, libraryId, a))
    elseif libraryId >= bitops.LIB_BAND and libraryId <= bitops.LIB_BNOT then
        slots.writeValue(frame, regs, dst, bitops.bitcall(ctx, libraryId, a, b))
    elseif libraryId == numbers.LIB_FOR_LIMIT then
        slots.writeValue(frame, regs, dst, numbers.forlimit(ctx, a))
    elseif libraryId == numbers.LIB_TONUMBER_BASE then
        slots.writeValue(frame, regs, dst, numbers.tonumberbase(ctx, a, b))
    elseif libraryId == basics.LIB_ALLOCBYTES then
        slots.writeValue(frame, regs, dst, basics.allocate(ctx, values.TAG_INTEGER | corestorage.UINT8, a))
    elseif libraryId == basics.LIB_ALLOCATE then
        slots.writeValue(frame, regs, dst, basics.allocate(ctx, a, b))
    elseif libraryId == basics.LIB_NEWARRAY then
        slots.writeValue(
            frame,
            regs,
            dst,
            values.TAG_OBJ | guestscope.newpacked(ctx, a & values.PAYLOAD, b & values.PAYLOAD)
        )
    elseif libraryId == basics.LIB_PACKEDKIND then
        local packed: uint64 = 0ULL
        if tableHeader(a) ~= 0ULL then
            packed = tables.packedkind(tableHeader(a))
        end
        slots.writeValue(frame, regs, dst, values.TAG_INTEGER | packed)
    elseif libraryId == basics.LIB_CLEANUPSET then
        slots.writeValue(frame, regs, dst, basics.cleanupset(ctx, a, b))
    elseif libraryId == basics.LIB_CLEANUPGET then
        slots.writeValue(frame, regs, dst, basics.cleanupget(ctx, a))
    elseif libraryId >= basics.LIB_VIEW and libraryId <= basics.LIB_CAST then
        slots.writeValue(frame, regs, dst, basics.storagecall(ctx, libraryId, native.word(count), a, b, c, d))
    elseif libraryId == basics.LIB_NEXT or libraryId == basics.LIB_NEXT_ALL then
        guestscope.nameLibrary(ctx, texts.NAME_NEXT)
        local after = values.NIL
        if count >= 2 then
            after = b
        end
        slots.writeValue(frame, regs, dst, basics.rawnext(ctx, a, after, libraryId == basics.LIB_NEXT_ALL))
    elseif libraryId == modules.LIB_NAMES then
        modules.register(ctx, a)
        slots.writeValue(frame, regs, dst, values.NIL)
    elseif libraryId == modules.LIB_PUBLISH then
        modules.store(ctx, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")), a)
        slots.writeValue(frame, regs, dst, a)
    else
        -- The table library over a table with a metatable runs in replay
        -- (guestscope.replaybegin): a function __index, __newindex or __len
        -- it reaches is called here, and the call runs again once it answers.
        local replay: uint64 = 0ULL
        if guestlib.replays(libraryId) then
            replay = guestscope.replaybegin(
                ctx,
                frame,
                slots.readValue(frame, regs, dst),
                guestlib.reachesmeta(libraryId, a, b)
            )
        end
        -- Run again, its arguments are its entry's: the metamethod's staging
        -- overwrote the frame's.
        if replay == 2ULL then
            guestscope.replaykeep(ctx, a, b, c, d)
            guestscope.replaysave(ctx, guestlib.stepstate(ctx, libraryId, a))
            guestlib.copystate(ctx, libraryId, a, guestscope.replaysaved(ctx))
        elseif replay == 1ULL then
            a = guestscope.replayarg(ctx, 0ULL)
            b = guestscope.replayarg(ctx, 1ULL)
            c = guestscope.replayarg(ctx, 2ULL)
            d = guestscope.replayarg(ctx, 3ULL)
            guestlib.copystate(ctx, libraryId, guestscope.replaysaved(ctx), a)
        end
        local result = guestlib.call(ctx, libraryId, native.word(count), a, b, c, d)
        guestscope.libraryReturned(ctx)
        local kind: uint64 = 0ULL
        if replay ~= 0ULL then
            kind = guestscope.replayend(ctx)
        end
        if kind ~= 0ULL then
            local top = native.index(valueCount - 4ULL)
            slots.writeValue(frame, regs, top, guestscope.takeMeta(ctx))
            slots.writeValue(frame, regs, top + 1, guestscope.metaSelf(ctx))
            slots.writeValue(frame, regs, top + 2, guestscope.replaykey(ctx))
            local nargs: uint64 = 2ULL
            if kind == guestscope.ACCESS_SET then
                slots.writeValue(frame, regs, top + 3, guestscope.replayvalue(ctx))
                nargs = 3ULL
            end
            local child = ops.libraryCall(ctx, frame, pc, nargs, native.word(dst))
            if child == 0ULL then
                return native.fail()
            end
            guestscope.replaywait(ctx, child)
            local s = native.pointer(ops.state(ctx))
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        slots.writeValue(frame, regs, dst, result)
    end
    guestscope.libraryReturned(ctx)
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- Lua's not: true for false and nil, false for anything else.
export function Not(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local dst = program.readByte(pc, 1)
    local src = program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(dst) >= count or native.word(src) >= count then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local value = slots.readValue(frame, regs, src)
    slots.writeValue(
        frame,
        regs,
        dst,
        native.chooseWord(value == values.FALSE or value == values.NIL, values.TRUE, values.FALSE)
    )
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

export function CallK(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local calleeSlot = program.readByte(pc, 1)
    local base, nargs = program.readByte(pc, 2), program.readByte(pc, 3)
    local wanted = program.readByte(pc, 4)
    local hint = program.readWord(pc, 8)
    if calleeSlot ~= base then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(calleeSlot) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if nargs > 63 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    -- Wanting none is wanting every result as one pack.
    if native.word(wanted) > frames.MAX_RESULTS then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local callee = slots.readValue(frame, regs, calleeSlot)
    -- A wrapped coroutine's closure resumes its thread with the arguments,
    -- whose values land where this call's results would.
    local wrapped = threads.wrapped(callee)
    if wrapped ~= 0ULL then
        local first = native.index(native.word(base) + 1ULL)
        local args = guestscope.packValues(ctx, native.offset(regs, first * 8), native.word(nargs), 0ULL)
        -- The frame roots the pack until the thread has it.
        slots.writeValue(frame, regs, first, args)
        local answer = threads.resume(
            ctx,
            frame,
            pc,
            wrapped,
            args,
            threads.MODE_CALL,
            (native.word(base) + 1ULL) | (native.word(wanted) << 32ULL)
        )
        if answer == threads.RAISED then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        elseif answer ~= threads.SWITCHED then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        local resumed = native.pointer(ops.state(ctx))
        local active = native.pointer(access.active(resumed))
        local activeValues = native.pointer(access.values(resumed, active))
        local activeIntegers = native.pointer(access.integers(resumed, active))
        local activeFloats = native.pointer(access.floats(resumed, active))
        local activePC = native.pointer(access.pc(resumed, active))
        access.refresh(resumed, active, ctx)
        return native.dispatch(activePC, activeValues, activeIntegers, activeFloats, ctx, active)
    end
    if ops.uncallable(ctx, callee) == 1ULL then
        -- A table with __call is called through it, the table first: the
        -- arguments move up a slot and __call takes the callee's place.
        local handler = guestscope.binaryMeta(ctx, guestscope.META_CALL, callee, values.NIL)
        local first = native.word(base)
        if handler ~= 0ULL
            and first + native.word(nargs) + 1ULL < native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
        then
            local i = native.word(nargs)
            while i > 0ULL do
                slots.writeValue(
                    frame,
                    regs,
                    native.index(first + i + 1ULL),
                    slots.readValue(frame, regs, native.index(first + i))
                )
                i = i - 1ULL
            end
            slots.writeValue(frame, regs, native.index(first + 1ULL), callee)
            slots.writeValue(frame, regs, native.index(first), handler)
            local child = ops.metaPrepare(ctx, frame, pc, first, native.word(nargs) + 1ULL, first + 1ULL)
            if child == 0ULL then
                return native.fail()
            end
            local s = native.pointer(ops.state(ctx))
            if wanted > 1 and frames.wantResults(s, native.pointer(child), native.word(wanted)) ~= 1ULL then
                ops.failure(ctx, ops.INVALID)
                return native.fail()
            end
            if wanted == 0 and frames.packResults(s, native.pointer(child)) ~= 1ULL then
                ops.failure(ctx, ops.INVALID)
                return native.fail()
            end
            if frames.publish(s, frame, native.pointer(child), ops.resume(ctx, frame, pc)) ~= 1ULL then
                ops.failure(ctx, ops.INVALID)
                return native.fail()
            end
            local current = native.pointer(access.active(s))
            local currentValues = native.pointer(access.values(s, current))
            local currentIntegers = native.pointer(access.integers(s, current))
            local currentFloats = native.pointer(access.floats(s, current))
            local currentPC = native.pointer(access.pc(s, current))
            access.refresh(s, current, ctx)
            return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
        end
        guestscope.fault(ctx, guestscope.FAULT_CALL, callee, values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    local resumePC = ops.resume(ctx, frame, pc)
    ops.checkpoint(ctx, frame, pc)
    local child = ops.prepare(
        ctx,
        frame,
        pc,
        callee,
        native.word(base),
        native.word(nargs),
        native.chooseWord(wanted == 0, 1ULL, native.word(wanted)),
        hint
    )
    if child == 0ULL then
        -- No room for another frame is Lua's "stack overflow", which a
        -- protected call can take.
        if texts.overflow(ctx) == 1ULL then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        else
            ops.failure(ctx, ops.RESOURCE)
        end
        return native.fail()
    end
    if wanted > 1 and frames.wantResults(s, native.pointer(child), native.word(wanted)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if wanted == 0 and frames.packResults(s, native.pointer(child)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if ops.packVarargs(ctx, frame, native.pointer(child), native.word(base), native.word(nargs)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local published = frames.publish(s, frame, native.pointer(child), resumePC)
    if published ~= 1ULL then
        -- A prepared child is retained on failure. The closed entry always
        -- calls complete, which aborts preparation before deepest-first unwind.
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function Ret(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local src = program.readByte(pc, 1)
    if native.word(src) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    -- Select the produced value while the callee is live; retirement may reuse
    -- its entire reservation. This path always produces exactly one value.
    local value = slots.readValue(frame, regs, src)
    if ops.result(ctx, frame, pc, value) ~= 1ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    ops.checkpoint(ctx, frame, pc)
    -- A coroutine's body returns to whoever resumed it, its values in a pack.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.THREAD_DESTINATION then
        local results = guestscope.packValues(
            ctx,
            native.offset(regs, native.index(native.word(src) * 8ULL)),
            1ULL,
            0ULL
        )
        if threads.finish(ctx, frame, results) ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        local resumer = native.pointer(ops.state(ctx))
        local current = native.pointer(access.active(resumer))
        local currentValues = native.pointer(access.values(resumer, current))
        local currentIntegers = native.pointer(access.integers(resumer, current))
        local currentFloats = native.pointer(access.floats(resumer, current))
        local currentPC = native.pointer(access.pc(resumer, current))
        access.refresh(resumer, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end
    if ops.root(ctx, frame) == 1ULL then
        -- The root result outlives the guest heap, so it must be an immediate:
        -- a table, string or boxed integer cannot be published.
        if value & values.TAG_MASK == values.TAG_OBJ then
            ops.fail(ctx, frame, pc, ops.RESOURCE)
            return native.fail()
        end
        local finished = ops.finish(ctx, frame, value)
        if finished ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        -- native.fail is the raw-zero transport exit here, not root success.
        -- Entry publishes only checked RootControl completion plus successful
        -- original-root/serial retirement; the verifier requires finish == 1.
        return native.fail()
    end
    -- A caller taking every result as one pack gets this one in a pack.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.PACK_DESTINATION then
        value = guestscope.packValues(ctx, native.offset(regs, native.index(native.word(src) * 8ULL)), 1ULL, 0ULL)
    end
    -- A required module's value is kept for later requires.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.MODULE_DESTINATION then
        modules.store(ctx, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")), value)
    end
    -- A metamethod a library call waits on: that call runs again next.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.LIBRARY_DESTINATION then
        guestscope.answered(ctx, native.address(frame))
    end
    local returned = frames.returnScalar(s, frame, value)
    if returned ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- Return `count` results from consecutive slots starting at `src` (core-only).
-- The caller keeps as many as it wanted, nil-filled; a root keeps the first.
export function RetN(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local src = program.readByte(pc, 1)
    local count = program.readByte(pc, 2)
    if count < 1
        or native.word(count) > frames.MAX_RESULTS
        or native.word(src) + native.word(count) > native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local value = slots.readValue(frame, regs, src)
    if ops.result(ctx, frame, pc, value) ~= 1ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    ops.checkpoint(ctx, frame, pc)
    -- A coroutine's body returns to whoever resumed it, its values in a pack.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.THREAD_DESTINATION then
        local results = guestscope.packValues(
            ctx,
            native.offset(regs, native.index(native.word(src) * 8ULL)),
            native.word(count),
            0ULL
        )
        if threads.finish(ctx, frame, results) ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        local resumer = native.pointer(ops.state(ctx))
        local current = native.pointer(access.active(resumer))
        local currentValues = native.pointer(access.values(resumer, current))
        local currentIntegers = native.pointer(access.integers(resumer, current))
        local currentFloats = native.pointer(access.floats(resumer, current))
        local currentPC = native.pointer(access.pc(resumer, current))
        access.refresh(resumer, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end
    if ops.root(ctx, frame) == 1ULL then
        if value & values.TAG_MASK == values.TAG_OBJ then
            ops.fail(ctx, frame, pc, ops.RESOURCE)
            return native.fail()
        end
        if ops.finish(ctx, frame, value) ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        return native.fail()
    end
    local returned: uint64 = 0ULL
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.MODULE_DESTINATION then
        modules.store(ctx, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")), value)
    end
    -- A metamethod a library call waits on: that call runs again next.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.LIBRARY_DESTINATION then
        guestscope.answered(ctx, native.address(frame))
    end
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.PACK_DESTINATION then
        -- A caller taking every result as one pack gets them in a pack.
        local packed = guestscope.packValues(
            ctx,
            native.offset(regs, native.index(native.word(src) * 8ULL)),
            native.word(count),
            0ULL
        )
        returned = frames.returnScalar(s, frame, packed)
    else
        returned = frames.returnValues(
            s,
            frame,
            native.offset(regs, native.index(native.word(src) * 8ULL)),
            native.word(count)
        )
    end
    if returned ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- CallK with a variadic pack spread after the fixed arguments (core-only):
-- its values are staged after them, within a window of 63 arguments.
export function CallV(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local calleeSlot = program.readByte(pc, 1)
    local base, nargs = program.readByte(pc, 2), program.readByte(pc, 3)
    local wanted = program.readByte(pc, 4)
    local hint = program.readWord(pc, 8)
    if calleeSlot ~= base then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(calleeSlot) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if nargs > 63 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    -- Wanting none is wanting every result as one pack.
    if native.word(wanted) > frames.MAX_RESULTS then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local packSlot = program.readByte(pc, 5)
    if native.word(base) + 64ULL > native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
        or native.word(packSlot) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local pack = slots.readValue(frame, regs, packSlot) & values.PAYLOAD
    local extra = wide.bitsOf(tables.get(pack, values.TAG_INTEGER))
    if native.word(nargs) + extra > 63ULL then
        ops.fail(ctx, frame, pc, ops.RESOURCE)
        return native.fail()
    end
    local k: uint64 = 0ULL
    while k < extra do
        slots.writeValue(
            frame,
            regs,
            base + nargs + 1 + native.index(k),
            tables.get(pack, values.TAG_INTEGER | (k + 1ULL))
        )
        k = k + 1ULL
    end
    local total = native.word(nargs) + extra
    local callee = slots.readValue(frame, regs, calleeSlot)
    -- A wrapped coroutine's closure resumes its thread with the arguments,
    -- whose values land where this call's results would.
    local wrapped = threads.wrapped(callee)
    if wrapped ~= 0ULL then
        local first = native.index(native.word(base) + 1ULL)
        local args = guestscope.packValues(ctx, native.offset(regs, first * 8), total, 0ULL)
        -- The frame roots the pack until the thread has it.
        slots.writeValue(frame, regs, first, args)
        local answer = threads.resume(
            ctx,
            frame,
            pc,
            wrapped,
            args,
            threads.MODE_CALL,
            (native.word(base) + 1ULL) | (native.word(wanted) << 32ULL)
        )
        if answer == threads.RAISED then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return native.fail()
        elseif answer ~= threads.SWITCHED then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        local resumed = native.pointer(ops.state(ctx))
        local active = native.pointer(access.active(resumed))
        local activeValues = native.pointer(access.values(resumed, active))
        local activeIntegers = native.pointer(access.integers(resumed, active))
        local activeFloats = native.pointer(access.floats(resumed, active))
        local activePC = native.pointer(access.pc(resumed, active))
        access.refresh(resumed, active, ctx)
        return native.dispatch(activePC, activeValues, activeIntegers, activeFloats, ctx, active)
    end
    if ops.uncallable(ctx, callee) == 1ULL then
        guestscope.fault(ctx, guestscope.FAULT_CALL, callee, values.NIL)
        ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    local resumePC = ops.resume(ctx, frame, pc)
    ops.checkpoint(ctx, frame, pc)
    local child = ops.prepare(
        ctx,
        frame,
        pc,
        callee,
        native.word(base),
        total,
        native.chooseWord(wanted == 0, 1ULL, native.word(wanted)),
        hint
    )
    if child == 0ULL then
        -- No room for another frame is Lua's "stack overflow", which a
        -- protected call can take.
        if texts.overflow(ctx) == 1ULL then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        else
            ops.failure(ctx, ops.RESOURCE)
        end
        return native.fail()
    end
    if wanted > 1 and frames.wantResults(s, native.pointer(child), native.word(wanted)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if wanted == 0 and frames.packResults(s, native.pointer(child)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if ops.packVarargs(ctx, frame, native.pointer(child), native.word(base), total) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local published = frames.publish(s, frame, native.pointer(child), resumePC)
    if published ~= 1ULL then
        -- A prepared child is retained on failure. The closed entry always
        -- calls complete, which aborts preparation before deepest-first unwind.
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- RetN with a variadic pack after the `count` staged results (core-only): the
-- pack's values are staged after them, up to sixteen results in all.
export function RetV(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local src = program.readByte(pc, 1)
    local fixed = program.readByte(pc, 2)
    local packSlot = program.readByte(pc, 3)
    if native.word(fixed) > frames.MAX_RESULTS
        or native.word(src) + frames.MAX_RESULTS > native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
        or native.word(packSlot) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local pack = slots.readValue(frame, regs, packSlot) & values.PAYLOAD
    -- A caller taking every result as one pack gets them all, past sixteen,
    -- as does a coroutine's resumer.
    local kind = native.load64(frame, native.fieldOffset<frames.Frame>("resultKind"))
    if (kind == frames.PACK_DESTINATION or kind == frames.THREAD_DESTINATION) and ops.root(ctx, frame) ~= 1ULL then
        -- The first result is held to the signature, as any return's is.
        local first = values.NIL
        if fixed > 0 then
            first = slots.readValue(frame, regs, src)
        elseif wide.bitsOf(tables.get(pack, values.TAG_INTEGER)) > 0ULL then
            first = tables.get(pack, values.TAG_INTEGER | 1ULL)
        end
        if ops.result(ctx, frame, pc, first) ~= 1ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        local packed = guestscope.packValues(
            ctx,
            native.offset(regs, native.index(native.word(src) * 8ULL)),
            native.word(fixed),
            pack
        )
        ops.checkpoint(ctx, frame, pc)
        if kind == frames.THREAD_DESTINATION then
            if threads.finish(ctx, frame, packed) ~= 1ULL then
                ops.failure(ctx, ops.INVALID)
                return native.fail()
            end
        elseif frames.returnScalar(native.pointer(ops.state(ctx)), frame, packed) ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        local state = native.pointer(ops.state(ctx))
        local active = native.pointer(access.active(state))
        local activeValues = native.pointer(access.values(state, active))
        local activeIntegers = native.pointer(access.integers(state, active))
        local activeFloats = native.pointer(access.floats(state, active))
        local activePC = native.pointer(access.pc(state, active))
        access.refresh(state, active, ctx)
        return native.dispatch(activePC, activeValues, activeIntegers, activeFloats, ctx, active)
    end
    local extra = wide.bitsOf(tables.get(pack, values.TAG_INTEGER))
    local count = native.word(fixed)
    local k: uint64 = 0ULL
    while k < extra and count < frames.MAX_RESULTS do
        slots.writeValue(frame, regs, src + native.index(count), tables.get(pack, values.TAG_INTEGER | (k + 1ULL)))
        count = count + 1ULL
        k = k + 1ULL
    end
    local value = values.NIL
    if count > 0ULL then
        value = slots.readValue(frame, regs, src)
    end
    if ops.result(ctx, frame, pc, value) ~= 1ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    ops.checkpoint(ctx, frame, pc)
    if ops.root(ctx, frame) == 1ULL then
        if value & values.TAG_MASK == values.TAG_OBJ then
            ops.fail(ctx, frame, pc, ops.RESOURCE)
            return native.fail()
        end
        if ops.finish(ctx, frame, value) ~= 1ULL then
            ops.failure(ctx, ops.INVALID)
            return native.fail()
        end
        return native.fail()
    end
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.MODULE_DESTINATION then
        modules.store(ctx, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")), value)
    end
    -- A metamethod a library call waits on: that call runs again next.
    if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.LIBRARY_DESTINATION then
        guestscope.answered(ctx, native.address(frame))
    end
    local returned = frames.returnValues(s, frame, native.offset(regs, native.index(native.word(src) * 8ULL)), count)
    if returned ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- pcall(f, ...) (core-only): CallK whose child is a protected call. Its caller
-- gets true before its results, or false and the error when an error unwinds
-- to it (guestscope.recoverEntry).
export function PCall(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.charge(ctx, frame, pc) ~= 1ULL then
        return native.fail()
    end
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local calleeSlot = program.readByte(pc, 1)
    local base, nargs = program.readByte(pc, 2), program.readByte(pc, 3)
    local wanted = program.readByte(pc, 4)
    local hint = program.readWord(pc, 8)
    if calleeSlot ~= base then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if native.word(calleeSlot) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if nargs > 63 then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if wanted < 1 or native.word(wanted) > frames.MAX_RESULTS then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local callee = slots.readValue(frame, regs, calleeSlot)
    -- pcall of a wrapped coroutine's closure resumes its thread: true and its
    -- values, or false and its error, land where the call's results would.
    local wrapped = threads.wrapped(callee)
    if wrapped ~= 0ULL then
        local first = native.index(native.word(base) + 1ULL)
        local args = guestscope.packValues(ctx, native.offset(regs, first * 8), native.word(nargs), 0ULL)
        -- The frame roots the pack until the thread has it.
        slots.writeValue(frame, regs, first, args)
        local answer = threads.resume(
            ctx,
            frame,
            pc,
            wrapped,
            args,
            threads.MODE_PROTECTED,
            (native.word(base) + 1ULL) | (native.word(wanted) << 32ULL)
        )
        if answer == threads.REFUSED then
            local after = ops.branch(ctx, frame, pc, 0)
            if after == 0ULL then
                ops.fail(ctx, frame, pc, ops.INVALID)
                return native.fail()
            end
            return native.dispatch(native.pointer(after), regs, ints, floats, ctx, frame)
        elseif answer ~= threads.SWITCHED then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        local resumed = native.pointer(ops.state(ctx))
        local active = native.pointer(access.active(resumed))
        local activeValues = native.pointer(access.values(resumed, active))
        local activeIntegers = native.pointer(access.integers(resumed, active))
        local activeFloats = native.pointer(access.floats(resumed, active))
        local activePC = native.pointer(access.pc(resumed, active))
        access.refresh(resumed, active, ctx)
        return native.dispatch(activePC, activeValues, activeIntegers, activeFloats, ctx, active)
    end
    local s = native.pointer(ops.state(ctx))
    local resumePC = ops.resume(ctx, frame, pc)
    ops.checkpoint(ctx, frame, pc)
    local child = ops.prepare(ctx, frame, pc, callee, native.word(base), native.word(nargs), native.word(wanted), hint)
    if child == 0ULL then
        -- No room for another frame is Lua's "stack overflow", which a
        -- protected call can take.
        if texts.overflow(ctx) == 1ULL then
            ops.fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        else
            ops.failure(ctx, ops.RESOURCE)
        end
        return native.fail()
    end
    if wanted > 1 and frames.wantResults(s, native.pointer(child), native.word(wanted)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if frames.protect(s, native.pointer(child)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    if ops.packVarargs(ctx, frame, native.pointer(child), native.word(base), native.word(nargs)) ~= 1ULL then
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local published = frames.publish(s, frame, native.pointer(child), resumePC)
    if published ~= 1ULL then
        -- A prepared child is retained on failure. The closed entry always
        -- calls complete, which aborts preparation before deepest-first unwind.
        ops.failure(ctx, ops.INVALID)
        return native.fail()
    end
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

-- After xpcall's protected call: when it failed (false in the status
-- slot), its message handler is called with the error, its answer landing
-- where the error would, or nowhere when only the status is wanted.
export function XPHandle(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local status, handlerSlot, wanted = program.readByte(pc, 1), program.readByte(pc, 2), program.readByte(pc, 3)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(status) + 1ULL >= count or native.word(handlerSlot) >= count or count < 5ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    if slots.readValue(frame, regs, status) == values.FALSE then
        local top = native.index(count - 4ULL)
        slots.writeValue(frame, regs, top, slots.readValue(frame, regs, handlerSlot))
        slots.writeValue(frame, regs, top + 1, guestscope.lastError(ctx))
        local resultSlot = count - 1ULL
        if wanted >= 2 then
            resultSlot = native.word(status) + 1ULL
        end
        if ops.metaCall(ctx, frame, pc, 1ULL, resultSlot, 0ULL) ~= 1ULL then
            return native.fail()
        end
        local s = native.pointer(ops.state(ctx))
        local current = native.pointer(access.active(s))
        local currentValues = native.pointer(access.values(s, current))
        local currentIntegers = native.pointer(access.integers(s, current))
        local currentFloats = native.pointer(access.floats(s, current))
        local currentPC = native.pointer(access.pc(s, current))
        access.refresh(s, current, ctx)
        return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
    end
    local nextPC = ops.branch(ctx, frame, pc, 0)
    if nextPC == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(nextPC), regs, ints, floats, ctx, frame)
end

-- An affine value's destructor called on it: the callee and the value are
-- staged at the top of the call window, and the frame resumes after this
-- instruction once the destructor returns, its result dropped.
export function Destroy(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local callee, value = program.readByte(pc, 1), program.readByte(pc, 2)
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if native.word(callee) >= count or native.word(value) >= count or count < 5ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local top = native.index(count - 4ULL)
    local destructor = slots.readValue(frame, regs, callee)
    local owned = slots.readValue(frame, regs, value)
    slots.writeValue(frame, regs, top, destructor)
    slots.writeValue(frame, regs, top + 1, owned)
    if ops.metaCall(ctx, frame, pc, 1ULL, count - 1ULL, 0ULL) ~= 1ULL then
        return native.fail()
    end
    local s = native.pointer(ops.state(ctx))
    local current = native.pointer(access.active(s))
    local currentValues = native.pointer(access.values(s, current))
    local currentIntegers = native.pointer(access.integers(s, current))
    local currentFloats = native.pointer(access.floats(s, current))
    local currentPC = native.pointer(access.pc(s, current))
    access.refresh(s, current, ctx)

    return native.dispatch(currentPC, currentValues, currentIntegers, currentFloats, ctx, current)
end

export function Jmp(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local displacement = program.readSigned32(pc, 4)
    if displacement < 0 then
        if ops.charge(ctx, frame, pc) ~= 1ULL then
            return native.fail()
        end
    end
    local target = ops.branch(ctx, frame, pc, displacement)
    if target == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(target), regs, ints, floats, ctx, frame)
end

export function JmpIf(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, ctx: voidptr, frame: voidptr): uint64
    if ops.current(ctx, frame, pc) == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    local src = program.readByte(pc, 1)
    if native.word(src) >= native.load64(frame, native.fieldOffset<frames.Frame>("valueCount")) then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end
    -- Lua truthiness: everything but false and nil is true. Before v8 only
    -- Booleans and nil reach a branch.
    local value = slots.readValue(frame, regs, src)
    if value == values.FALSE or value == values.NIL then
        local target = ops.branch(ctx, frame, pc, 0)
        if target == 0ULL then
            ops.fail(ctx, frame, pc, ops.INVALID)
            return native.fail()
        end
        return native.dispatch(native.pointer(target), regs, ints, floats, ctx, frame)
    end
    local displacement = program.readSigned32(pc, 4)
    if displacement < 0 then
        if ops.charge(ctx, frame, pc) ~= 1ULL then
            return native.fail()
        end
    end
    local target = ops.branch(ctx, frame, pc, displacement)
    if target == 0ULL then
        ops.fail(ctx, frame, pc, ops.INVALID)
        return native.fail()
    end

    return native.dispatch(native.pointer(target), regs, ints, floats, ctx, frame)
end

export function Invalid(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    ctx: voidptr,
    frame: voidptr
): uint64
    ops.fail(ctx, frame, pc, ops.INVALID)
    return native.fail()
end
