module nupp.runtime.core.frames

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const arena = require("nupp.runtime.core.arena")

-- These descriptors are Nupp-owned logical metadata, not the interim VM layout.
-- Immutable function/plan storage and State live outside the logical frame pool.
-- All pointer arguments borrow mapped storage of the declared extent. Arithmetic
-- checks cannot establish mapping ownership or the validity of tagged values.
export struct FunctionInfo
    version: uint64
    id: uint64
    bodyOwner: uint64
    code: uint64
    instructionCount: uint64
    nparams: uint64
    parameterClass: uint64
    resultClass: uint64
    flags: uint64
    valueCount: uint64
    integerCount: uint64
    floatCount: uint64
    vectorCount: uint64
    objectBytes: uint64
    spillBytes: uint64
    rootDescriptor: uint64
end

export struct WindowPlan
    functionInfo: uint64
    bytes: uint64
    values: uint64
    integers: uint64
    floats: uint64
    vectors: uint64
    objects: uint64
    spills: uint64
end

export struct Frame
    previous: uint64
    functionInfo: uint64
    windowPlan: uint64
    functionId: uint64
    bodyOwner: uint64
    code: uint64
    instructionCount: uint64
    resumePC: uint64
    closureRoot: uint64
    values: uint64
    valueCount: uint64
    integers: uint64
    integerCount: uint64
    floats: uint64
    floatCount: uint64
    vectors: uint64
    vectorCount: uint64
    objects: uint64
    objectBytes: uint64
    spills: uint64
    spillBytes: uint64
    rootDescriptor: uint64
    liveValues: uint64
    resultKind: uint64
    resultOwner: uint64
    resultSlot: uint64
    resultCount: uint64
    cleanupCursor: uint64
    frameMark: uint64
    dataMark: uint64
    spillMark: uint64
    reservationBytes: uint64
    child: uint64
    phase: uint64
    childMark: arena.Mark
end

-- The native entry must bind these bounds to its actual helper spill storage.
-- Declaring a range does not move spills or prove where native control lives.
-- Helper return addresses, spills and reloads must outlive every released frame.
export struct State
    active: uint64
    depth: uint64
    limit: uint64
    segment: uint64
    lastResultCount: uint64
    helperBase: uint64
    helperBytes: uint64
end

-- Entry retains this storage outside every logical reservation and helper span.
-- Fresh storage is zeroed. Only beginRoot reuses a retired control; serials come
-- from the segment and remain monotonic across reservation reuse.
export struct RootControl
    state: uint64
    frame: uint64
    value: uint64
    count: uint64
    phase: uint64
    mark: arena.Mark
end

export const ROOT_ACTIVE: uint64 = 1ULL
export const ROOT_COMPLETE: uint64 = 2ULL
export const ROOT_RETIRED: uint64 = 3ULL
export const ROOT_DESTINATION: uint64 = 2ULL

export const PREPARED: uint64 = 1ULL
export const ACTIVE: uint64 = 2ULL
export const WAITING: uint64 = 3ULL
export const CALLER_DESTINATION: uint64 = 1ULL
-- A protected call's child (pcall): its caller gets true before its results,
-- or false and the error when an error unwinds to it.
export const PROTECTED_DESTINATION: uint64 = 3ULL
-- A comparison metamethod's frame: its caller takes the first result as a
-- boolean, false for nil and false and true for anything else.
export const TRUTH_DESTINATION: uint64 = 4ULL
-- A call whose caller takes every result as one pack {[0] = n, ...}: its
-- return handler packs them, and the caller's slot gets the pack.
export const PACK_DESTINATION: uint64 = 5ULL
-- A coroutine's body (`threads`): the bottom frame of the thread's own
-- segment, whose results go to whoever resumed it.
export const THREAD_DESTINATION: uint64 = 6ULL
-- A required module's chunk (`modules`): its caller takes its value as a
-- call's, and the loaded cache keeps it.
export const MODULE_DESTINATION: uint64 = 7ULL
-- A metamethod a library call waits on (`guestscope.replaybegin`): its
-- caller takes its first result as a call's, and runs the library call
-- again with it.
export const LIBRARY_DESTINATION: uint64 = 8ULL
-- The most results a caller frame may want from one call.
export const MAX_RESULTS: uint64 = 16ULL

local function range(address: uint64, bytes: uint64, alignment: uint64): uint64
    if address == 0ULL or bytes == 0ULL or alignment == 0ULL or (alignment & (alignment - 1ULL)) ~= 0ULL then
        return 0ULL
    end
    if (address & (alignment - 1ULL)) ~= 0ULL or bytes > 0xffffffffffffffffULL - address then
        return 0ULL
    end

    return 1ULL
end

local function overlaps(a: uint64, bytesA: uint64, b: uint64, bytesB: uint64): boolean
    return a < b + bytesB and b < a + bytesA
end

-- The bounded tagged/raw window reservation size is shared with entry admission.
export function fixedBytes(nv: uint64, ni: uint64, nf: uint64, nx: uint64): uint64
    if nv == 0ULL or nv > 256ULL or ni > 256ULL or nf > 256ULL or nx > 256ULL then
        return 0ULL
    end
    local valuesOffset = (native.sizeOf<Frame>() + 15ULL) & 0xfffffffffffffff0ULL
    local vectorOffset = (valuesOffset + (nv + ni + nf) * 8ULL + 15ULL) & 0xfffffffffffffff0ULL

    return vectorOffset + nx * 16ULL
end

local function describe(info: voidptr, plan: voidptr, write: uint64): uint64
    local source, output = native.address(info), native.address(plan)
    if range(source, native.sizeOf<FunctionInfo>(), 8ULL) == 0ULL
        or range(output, native.sizeOf<WindowPlan>(), 8ULL) == 0ULL
    then
        return 0ULL
    end
    if overlaps(source, native.sizeOf<FunctionInfo>(), output, native.sizeOf<WindowPlan>()) or write > 1ULL then
        return 0ULL
    end
    if native.load64(info, native.fieldOffset<FunctionInfo>("version")) ~= 1ULL then
        return 0ULL
    end
    if native.load64(info, native.fieldOffset<FunctionInfo>("id")) > 0xffffffffULL then
        return 0ULL
    end
    local instructions = native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount"))
    if instructions == 0ULL or instructions > 1048576ULL then
        return 0ULL
    end
    local code = native.load64(info, native.fieldOffset<FunctionInfo>("code"))
    local codeBytes = instructions * 16ULL
    if range(code, codeBytes, 8ULL) == 0ULL then
        return 0ULL
    end
    if overlaps(code, codeBytes, source, native.sizeOf<FunctionInfo>())
        or overlaps(code, codeBytes, output, native.sizeOf<WindowPlan>())
    then
        return 0ULL
    end
    if native.load64(info, native.fieldOffset<FunctionInfo>("bodyOwner")) == 0ULL then
        return 0ULL
    end
    -- Class zero is a tagged value. Varargs, cleanups, protected calls,
    -- result packs, frame objects and compiled callee spills remain refused.
    if native.load64(info, native.fieldOffset<FunctionInfo>("parameterClass")) ~= 0ULL
        or native.load64(info, native.fieldOffset<FunctionInfo>("resultClass")) ~= 0ULL
        or native.load64(info, native.fieldOffset<FunctionInfo>("flags")) ~= 0ULL
    then
        return 0ULL
    end
    if native.load64(info, native.fieldOffset<FunctionInfo>("objectBytes")) ~= 0ULL
        or native.load64(info, native.fieldOffset<FunctionInfo>("spillBytes")) ~= 0ULL
    then
        return 0ULL
    end
    local nparams = native.load64(info, native.fieldOffset<FunctionInfo>("nparams"))
    local nv = native.load64(info, native.fieldOffset<FunctionInfo>("valueCount"))
    local ni = native.load64(info, native.fieldOffset<FunctionInfo>("integerCount"))
    local nf = native.load64(info, native.fieldOffset<FunctionInfo>("floatCount"))
    local nx = native.load64(info, native.fieldOffset<FunctionInfo>("vectorCount"))
    if nparams > 255ULL or nv == 0ULL or nv > 256ULL or nv <= nparams or ni > 256ULL or nf > 256ULL or nx > 256ULL then
        return 0ULL
    end
    -- Bounded counts make each multiplication/addition exact before addresses
    -- are formed. Vector and reserved object/spill roles retain alignment 16.
    local valueOffset = (native.sizeOf<Frame>() + 15ULL) & 0xfffffffffffffff0ULL
    local integerOffset = valueOffset + nv * 8ULL
    local floatOffset = integerOffset + ni * 8ULL
    local vectorOffset = (floatOffset + nf * 8ULL + 15ULL) & 0xfffffffffffffff0ULL
    local endOffset = fixedBytes(nv, ni, nf, nx)
    if write == 0ULL then
        if native.load64(plan, native.fieldOffset<WindowPlan>("functionInfo")) ~= source
            or native.load64(plan, native.fieldOffset<WindowPlan>("bytes")) ~= endOffset
        then
            return 0ULL
        end
        if native.load64(plan, native.fieldOffset<WindowPlan>("values")) ~= valueOffset
            or native.load64(plan, native.fieldOffset<WindowPlan>("integers")) ~= integerOffset
            or native.load64(plan, native.fieldOffset<WindowPlan>("floats")) ~= floatOffset
        then
            return 0ULL
        end
        if native.load64(plan, native.fieldOffset<WindowPlan>("vectors")) ~= vectorOffset
            or native.load64(plan, native.fieldOffset<WindowPlan>("objects")) ~= endOffset
            or native.load64(plan, native.fieldOffset<WindowPlan>("spills")) ~= endOffset
        then
            return 0ULL
        end
    else
        native.store64(plan, native.fieldOffset<WindowPlan>("functionInfo"), source)
        native.store64(plan, native.fieldOffset<WindowPlan>("bytes"), endOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("values"), valueOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("integers"), integerOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("floats"), floatOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("vectors"), vectorOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("objects"), endOffset)
        native.store64(plan, native.fieldOffset<WindowPlan>("spills"), endOffset)
    end

    return 1ULL
end

export function planFixed(info: voidptr, plan: voidptr): uint64
    return describe(info, plan, 1ULL)
end

local function validStorage(state: voidptr): uint64
    local address = native.address(state)
    if range(address, native.sizeOf<State>(), 8ULL) == 0ULL then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    if range(native.address(segment), native.sizeOf<arena.Segment>(), 8ULL) == 0ULL then
        return 0ULL
    end
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local cursor = native.load64(segment, native.fieldOffset<arena.Segment>("cursor"))
    if base == 0ULL or limit <= base or cursor < base or cursor > limit then
        return 0ULL
    end
    local helperBase = native.load64(state, native.fieldOffset<State>("helperBase"))
    local helperBytes = native.load64(state, native.fieldOffset<State>("helperBytes"))
    if range(helperBase, helperBytes, 16ULL) == 0ULL then
        return 0ULL
    end
    if overlaps(base, limit - base, helperBase, helperBytes)
        or overlaps(base, limit - base, address, native.sizeOf<State>())
    then
        return 0ULL
    end
    if overlaps(address, native.sizeOf<State>(), helperBase, helperBytes)
        or overlaps(native.address(segment), native.sizeOf<arena.Segment>(), helperBase, helperBytes)
        or overlaps(address, native.sizeOf<State>(), native.address(segment), native.sizeOf<arena.Segment>())
    then
        return 0ULL
    end

    return 1ULL
end

local function validState(state: voidptr): uint64
    if validStorage(state) == 0ULL then
        return 0ULL
    end
    local depth = native.load64(state, native.fieldOffset<State>("depth"))
    if depth == 0ULL or depth > native.load64(state, native.fieldOffset<State>("limit")) then
        return 0ULL
    end

    return 1ULL
end

local function stableMetadata(state: voidptr, info: voidptr, plan: voidptr): uint64
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local source, template = native.address(info), native.address(plan)
    local sourceBytes, templateBytes = native.sizeOf<FunctionInfo>(), native.sizeOf<WindowPlan>()
    if overlaps(source, sourceBytes, base, limit - base) or overlaps(template, templateBytes, base, limit - base) then
        return 0ULL
    end
    if overlaps(source, sourceBytes, native.address(state), native.sizeOf<State>())
        or overlaps(template, templateBytes, native.address(state), native.sizeOf<State>())
    then
        return 0ULL
    end
    if overlaps(source, sourceBytes, native.address(segment), native.sizeOf<arena.Segment>())
        or overlaps(template, templateBytes, native.address(segment), native.sizeOf<arena.Segment>())
    then
        return 0ULL
    end
    local helperBase = native.load64(state, native.fieldOffset<State>("helperBase"))
    local helperBytes = native.load64(state, native.fieldOffset<State>("helperBytes"))
    if overlaps(source, sourceBytes, helperBase, helperBytes)
        or overlaps(template, templateBytes, helperBase, helperBytes)
    then
        return 0ULL
    end
    local code = native.load64(info, native.fieldOffset<FunctionInfo>("code"))
    local codeBytes = native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL
    if overlaps(code, codeBytes, base, limit - base)
        or overlaps(code, codeBytes, native.address(state), native.sizeOf<State>())
        or overlaps(code, codeBytes, native.address(segment), native.sizeOf<arena.Segment>())
        or overlaps(code, codeBytes, helperBase, helperBytes)
    then
        return 0ULL
    end

    return 1ULL
end

-- A root frame is initialized by its entry owner. This helper checks only the
-- metadata needed by transfer, not arbitrary pointer provenance or heap tags.
local function validFrame(state: voidptr, frame: voidptr): uint64
    local address = native.address(frame)
    if range(address, native.sizeOf<Frame>(), 16ULL) == 0ULL then
        return 0ULL
    end
    local info = native.loadPointer(frame, native.fieldOffset<Frame>("functionInfo"))
    local plan = native.loadPointer(frame, native.fieldOffset<Frame>("windowPlan"))
    if describe(info, plan, 0ULL) == 0ULL or stableMetadata(state, info, plan) == 0ULL then
        return 0ULL
    end
    local bytes = native.load64(plan, native.fieldOffset<WindowPlan>("bytes"))
    if range(address, bytes, 16ULL) == 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("reservationBytes")) ~= bytes
    then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("functionId")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("id")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("bodyOwner")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("bodyOwner")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("code")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("code")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("instructionCount")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("valueCount")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("valueCount")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("integerCount")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("integerCount")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("floatCount")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("floatCount")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("vectorCount")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("vectorCount")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("rootDescriptor")
    ) ~= native.load64(info, native.fieldOffset<FunctionInfo>("rootDescriptor")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("values")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("values")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("integers")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("integers")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("floats")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("floats")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("vectors")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("vectors")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("objects")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("objects")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("spills")
    ) ~= address + native.load64(plan, native.fieldOffset<WindowPlan>("spills")) then
        return 0ULL
    end
    if native.load64(
        frame,
        native.fieldOffset<Frame>("liveValues")
    ) ~= native.load64(frame, native.fieldOffset<Frame>("valueCount"))
        or native.load64(frame, native.fieldOffset<Frame>("objectBytes")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("spillBytes")) ~= 0ULL
    then
        return 0ULL
    end
    if native.load64(frame, native.fieldOffset<Frame>("cleanupCursor")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("dataMark")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("spillMark")) ~= 0ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local cursor = native.load64(segment, native.fieldOffset<arena.Segment>("cursor"))
    if overlaps(address, bytes, base, limit - base)
        and (address < base or address > cursor or bytes > cursor - address)
    then
        return 0ULL
    end
    if overlaps(address, bytes, native.address(state), native.sizeOf<State>())
        or overlaps(address, bytes, native.address(segment), native.sizeOf<arena.Segment>())
    then
        return 0ULL
    end
    if overlaps(
        address,
        bytes,
        native.load64(state, native.fieldOffset<State>("helperBase")),
        native.load64(state, native.fieldOffset<State>("helperBytes"))
    ) then
        return 0ULL
    end
    if overlaps(address, bytes, native.address(info), native.sizeOf<FunctionInfo>())
        or overlaps(address, bytes, native.address(plan), native.sizeOf<WindowPlan>())
        or overlaps(
            address,
            bytes,
            native.load64(info, native.fieldOffset<FunctionInfo>("code")),
            native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL
        )
    then
        return 0ULL
    end

    return 1ULL
end

-- A successful reservation and checked plan bound every following store.
-- Caller, metadata, mark and closure satisfy the enclosing service's borrows;
-- no callback, failure or safepoint occurs while initializing this shared frame.
local function initializeFrame(
    caller: voidptr,
    info: voidptr,
    plan: voidptr,
    mark: voidptr,
    closure: uint64,
    resultSlot: uint64
): uint64
    local payload = native.load64(mark, native.fieldOffset<arena.Mark>("payload"))
    local child = native.pointer(payload)
    local bytes = native.load64(plan, native.fieldOffset<WindowPlan>("bytes"))
    -- The reservation has succeeded and every remaining operation is a bounded
    -- store/copy. No failure or safepoint can expose a partial child as active.
    native.store64(child, native.fieldOffset<Frame>("previous"), native.address(caller))
    native.store64(child, native.fieldOffset<Frame>("functionInfo"), native.address(info))
    native.store64(child, native.fieldOffset<Frame>("windowPlan"), native.address(plan))
    native.store64(
        child,
        native.fieldOffset<Frame>("functionId"),
        native.load64(info, native.fieldOffset<FunctionInfo>("id"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("bodyOwner"),
        native.load64(info, native.fieldOffset<FunctionInfo>("bodyOwner"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("code"),
        native.load64(info, native.fieldOffset<FunctionInfo>("code"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("instructionCount"),
        native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount"))
    )
    native.store64(child, native.fieldOffset<Frame>("resumePC"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("closureRoot"), closure)
    native.store64(
        child,
        native.fieldOffset<Frame>("values"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("values"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("integers"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("integers"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("floats"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("floats"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("vectors"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("vectors"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("objects"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("objects"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("spills"),
        payload + native.load64(plan, native.fieldOffset<WindowPlan>("spills"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("valueCount"),
        native.load64(info, native.fieldOffset<FunctionInfo>("valueCount"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("integerCount"),
        native.load64(info, native.fieldOffset<FunctionInfo>("integerCount"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("floatCount"),
        native.load64(info, native.fieldOffset<FunctionInfo>("floatCount"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("vectorCount"),
        native.load64(info, native.fieldOffset<FunctionInfo>("vectorCount"))
    )
    native.store64(
        child,
        native.fieldOffset<Frame>("rootDescriptor"),
        native.load64(info, native.fieldOffset<FunctionInfo>("rootDescriptor"))
    )
    native.store64(child, native.fieldOffset<Frame>("objectBytes"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("spillBytes"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("liveValues"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("resultKind"), CALLER_DESTINATION)
    native.store64(child, native.fieldOffset<Frame>("resultOwner"), native.address(caller))
    native.store64(child, native.fieldOffset<Frame>("resultSlot"), resultSlot)
    native.store64(child, native.fieldOffset<Frame>("resultCount"), 1ULL)
    native.store64(child, native.fieldOffset<Frame>("cleanupCursor"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("frameMark"), native.address(mark))
    native.store64(child, native.fieldOffset<Frame>("dataMark"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("spillMark"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("reservationBytes"), bytes)
    native.store64(child, native.fieldOffset<Frame>("child"), 0ULL)
    native.store64(child, native.fieldOffset<Frame>("phase"), 0ULL)
    local childMark = native.offset(child, native.fieldOffset<Frame>("childMark"))
    local at: uint64 = 0ULL
    while at < native.sizeOf<arena.Mark>() do
        native.store64(childMark, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local slots = native.loadPointer(child, native.fieldOffset<Frame>("values"))
    local nv = native.load64(child, native.fieldOffset<Frame>("valueCount"))
    local i: uint64 = 0ULL
    while i < nv do
        native.store64(slots, native.index(i * 8ULL), values.NIL)
        i = i + 1ULL
    end

    return payload
end

-- The canonical call policy must check work/cancellation and resolve the actual
-- callee before this service. A function-id hint alone is not a target proof.
-- Success returns the unpublished child address; refusal returns zero. From
-- prepare through publish/abort there is no callback, collection or safepoint.
export function prepareFixed(
    state: voidptr,
    caller: voidptr,
    info: voidptr,
    closure: uint64,
    argumentBase: uint64,
    supplied: uint64,
    resultSlot: uint64,
    plan: voidptr
): uint64
    if validState(state) == 0ULL
        or validFrame(state, caller) == 0ULL
        or describe(info, plan, 0ULL) == 0ULL
        or stableMetadata(state, info, plan) == 0ULL
    then
        return 0ULL
    end
    if native.load64(state, native.fieldOffset<State>("active")) ~= native.address(caller)
        or native.load64(caller, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(caller, native.fieldOffset<Frame>("child")) ~= 0ULL
    then
        return 0ULL
    end
    if native.load64(
        state,
        native.fieldOffset<State>("depth")
    ) >= native.load64(state, native.fieldOffset<State>("limit")) then
        return 0ULL
    end
    local count = native.load64(caller, native.fieldOffset<Frame>("valueCount"))
    if resultSlot >= count or argumentBase >= count or supplied > count - argumentBase - 1ULL then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local callerBytes = native.load64(caller, native.fieldOffset<Frame>("reservationBytes"))
    if overlaps(native.address(info), native.sizeOf<FunctionInfo>(), native.address(caller), callerBytes)
        or overlaps(native.address(plan), native.sizeOf<WindowPlan>(), native.address(caller), callerBytes)
        or overlaps(
            native.load64(info, native.fieldOffset<FunctionInfo>("code")),
            native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL,
            native.address(caller),
            callerBytes
        )
    then
        return 0ULL
    end
    local mark = native.offset(caller, native.fieldOffset<Frame>("childMark"))
    local bytes = native.load64(plan, native.fieldOffset<WindowPlan>("bytes"))
    if arena.reserve(segment, bytes, 16ULL, mark) == 0ULL then
        return 0ULL
    end
    local payload = initializeFrame(caller, info, plan, mark, closure, resultSlot)
    local child = native.pointer(payload)
    local slots = native.loadPointer(child, native.fieldOffset<Frame>("values"))
    local nv = native.load64(child, native.fieldOffset<Frame>("valueCount"))
    local i: uint64 = 0ULL
    local nparams = native.load64(info, native.fieldOffset<FunctionInfo>("nparams"))
    local copied = native.chooseWord(supplied < nparams, supplied, nparams)
    local arguments = native.loadPointer(caller, native.fieldOffset<Frame>("values"))
    i = 0ULL
    while i < copied do
        native.store64(
            slots,
            native.index((i + 1ULL) * 8ULL),
            native.load64(arguments, native.index((argumentBase + 1ULL + i) * 8ULL))
        )
        i = i + 1ULL
    end
    -- Missing arguments remain NIL. Extra already-evaluated arguments have no
    -- parameter slot in a fixed, non-vararg function.
    native.store64(child, native.fieldOffset<Frame>("liveValues"), nv)
    native.store64(child, native.fieldOffset<Frame>("phase"), PREPARED)
    native.store64(caller, native.fieldOffset<Frame>("child"), payload)

    return payload
end

local function linked(state: voidptr, parent: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL or validFrame(state, parent) == 0ULL or validFrame(state, child) == 0ULL then
        return 0ULL
    end
    if native.address(parent) == native.address(child)
        or native.load64(child, native.fieldOffset<Frame>("previous")) ~= native.address(parent)
        or native.load64(parent, native.fieldOffset<Frame>("child")) ~= native.address(child)
    then
        return 0ULL
    end
    if native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= CALLER_DESTINATION
        and native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= PROTECTED_DESTINATION
        and native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= TRUTH_DESTINATION
        and native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= PACK_DESTINATION
        and native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= MODULE_DESTINATION
        and native.load64(child, native.fieldOffset<Frame>("resultKind")) ~= LIBRARY_DESTINATION
        or native.load64(child, native.fieldOffset<Frame>("resultOwner")) ~= native.address(parent)
        or native.load64(child, native.fieldOffset<Frame>("resultCount")) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("resultCount")) > MAX_RESULTS
    then
        return 0ULL
    end
    -- Every wanted result lands inside the caller's value window.
    if native.load64(
        child,
        native.fieldOffset<Frame>("resultSlot")
    ) + native.load64(
        child,
        native.fieldOffset<Frame>("resultCount")
    ) > native.load64(parent, native.fieldOffset<Frame>("valueCount")) then
        return 0ULL
    end
    if native.load64(child, native.fieldOffset<Frame>("cleanupCursor")) ~= 0ULL
        or native.load64(child, native.fieldOffset<Frame>("child")) ~= 0ULL
        or native.load64(child, native.fieldOffset<Frame>("dataMark")) ~= 0ULL
        or native.load64(child, native.fieldOffset<Frame>("spillMark")) ~= 0ULL
    then
        return 0ULL
    end
    local mark = native.offset(parent, native.fieldOffset<Frame>("childMark"))
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    if native.load64(child, native.fieldOffset<Frame>("frameMark")) ~= native.address(mark)
        or arena.canRelease(segment, mark) == 0ULL
    then
        return 0ULL
    end
    if native.load64(mark, native.fieldOffset<arena.Mark>("payload")) ~= native.address(child)
        or native.load64(
            mark,
            native.fieldOffset<arena.Mark>("bytes")
        ) ~= native.load64(child, native.fieldOffset<Frame>("reservationBytes"))
    then
        return 0ULL
    end
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local parentAddress = native.address(parent)
    local parentBytes = native.load64(parent, native.fieldOffset<Frame>("reservationBytes"))
    local info = native.loadPointer(child, native.fieldOffset<Frame>("functionInfo"))
    local plan = native.loadPointer(child, native.fieldOffset<Frame>("windowPlan"))
    if overlaps(native.address(info), native.sizeOf<FunctionInfo>(), parentAddress, parentBytes)
        or overlaps(native.address(plan), native.sizeOf<WindowPlan>(), parentAddress, parentBytes)
        or overlaps(
            native.load64(info, native.fieldOffset<FunctionInfo>("code")),
            native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL,
            parentAddress,
            parentBytes
        )
    then
        return 0ULL
    end
    if overlaps(parentAddress, parentBytes, base, limit - base)
        and parentAddress + parentBytes > native.load64(mark, native.fieldOffset<arena.Mark>("before"))
    then
        return 0ULL
    end

    return 1ULL
end

-- Publication is the final store of an initialized child and its root extent.
-- Caller/child ownership is exclusive across this no-safepoint commit.
export function publish(state: voidptr, caller: voidptr, child: voidptr, resumePC: uint64): uint64
    if linked(state, caller, child) == 0ULL then
        return 0ULL
    end
    if native.load64(state, native.fieldOffset<State>("active")) ~= native.address(caller)
        or native.load64(caller, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    if resumePC >= native.load64(caller, native.fieldOffset<Frame>("instructionCount"))
        or native.load64(
            state,
            native.fieldOffset<State>("depth")
        ) >= native.load64(state, native.fieldOffset<State>("limit"))
    then
        return 0ULL
    end
    native.store64(caller, native.fieldOffset<Frame>("resumePC"), resumePC)
    native.store64(caller, native.fieldOffset<Frame>("phase"), WAITING)
    native.store64(child, native.fieldOffset<Frame>("phase"), ACTIVE)
    native.store64(
        state,
        native.fieldOffset<State>("depth"),
        native.load64(state, native.fieldOffset<State>("depth")) + 1ULL
    )
    native.store64(state, native.fieldOffset<State>("active"), native.address(child))

    return 1ULL
end

-- Helper spills/control and all subsequent reloads must live in the disjoint
-- entry-lifetime helper arena, never in the reservation this service releases.
export function abortPrepared(state: voidptr, caller: voidptr, child: voidptr): uint64
    if linked(state, caller, child) == 0ULL then
        return 0ULL
    end
    if native.load64(state, native.fieldOffset<State>("active")) ~= native.address(caller)
        or native.load64(caller, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(caller, native.fieldOffset<Frame>("childMark"))
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    -- No child pointer is dereferenced after retirement.
    native.store64(caller, native.fieldOffset<Frame>("child"), 0ULL)

    return 1ULL
end

-- Retire one published child without producing a value. The caller exclusively
-- owns mapped metadata and retains the helper arena outside the released span.
-- No callback, collection, work-budget or cancellation check occurs here.
export function abortActive(state: voidptr, callee: voidptr): uint64
    if validState(state) == 0ULL or validFrame(state, callee) == 0ULL then
        return 0ULL
    end
    local parent = native.loadPointer(callee, native.fieldOffset<Frame>("previous"))
    if linked(state, parent, callee) == 0ULL then
        return 0ULL
    end
    local depth = native.load64(state, native.fieldOffset<State>("depth"))
    if native.load64(state, native.fieldOffset<State>("active")) ~= native.address(callee)
        or native.load64(callee, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(parent, native.fieldOffset<Frame>("phase")) ~= WAITING
        or depth <= 1ULL
        or native.load64(
            parent,
            native.fieldOffset<Frame>("resumePC")
        ) >= native.load64(parent, native.fieldOffset<Frame>("instructionCount"))
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(parent, native.fieldOffset<Frame>("childMark"))
    -- All fallible checks precede writes. Exclusive ownership and no safepoint
    -- preserve the validated LIFO relation until release finishes.
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    -- Never dereference callee after release, or write the parent's result slot.
    native.store64(parent, native.fieldOffset<Frame>("child"), 0ULL)
    native.store64(parent, native.fieldOffset<Frame>("phase"), ACTIVE)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 0ULL)
    native.store64(state, native.fieldOffset<State>("depth"), depth - 1ULL)
    native.store64(state, native.fieldOffset<State>("active"), native.address(parent))

    return 1ULL
end

-- The caller frame a linked, active callee may return into, or zero.
local function returnTarget(state: voidptr, callee: voidptr): uint64
    if validState(state) == 0ULL or validFrame(state, callee) == 0ULL then
        return 0ULL
    end
    local parent = native.loadPointer(callee, native.fieldOffset<Frame>("previous"))
    if linked(state, parent, callee) == 0ULL then
        return 0ULL
    end
    if native.load64(state, native.fieldOffset<State>("active")) ~= native.address(callee)
        or native.load64(callee, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(parent, native.fieldOffset<Frame>("phase")) ~= WAITING
        or native.load64(state, native.fieldOffset<State>("depth")) <= 1ULL
    then
        return 0ULL
    end
    if native.load64(
        parent,
        native.fieldOffset<Frame>("resumePC")
    ) >= native.load64(parent, native.fieldOffset<Frame>("instructionCount")) then
        return 0ULL
    end

    return native.address(parent)
end

-- Retires the callee once its results are stored: `count` were produced.
local function retire(state: voidptr, parent: voidptr, count: uint64): uint64
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(parent, native.fieldOffset<Frame>("childMark"))
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    -- No callee pointer is dereferenced after retirement. The caller's saved
    -- logical PC is consumed by a future canonical transfer, not by this helper.
    native.store64(parent, native.fieldOffset<Frame>("child"), 0ULL)
    native.store64(parent, native.fieldOffset<Frame>("phase"), ACTIVE)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), count)
    native.store64(
        state,
        native.fieldOffset<State>("depth"),
        native.load64(state, native.fieldOffset<State>("depth")) - 1ULL
    )
    native.store64(state, native.fieldOffset<State>("active"), native.address(parent))

    return 1ULL
end

-- The canonical Ret handler selects the value before calling this leaf.
-- This service decodes no instruction and performs no dispatch. Tagged values
-- must already satisfy their heap lifetime contract; frame objects are refused.
-- Entry-lifetime helper spills/control must remain outside the retired span.
-- A caller that wanted more results gets nil for the rest.
export function returnScalar(state: voidptr, callee: voidptr, value: uint64): uint64
    local parent = returnTarget(state, callee)
    if parent == 0ULL then
        return 0ULL
    end
    -- All fallible metadata/mark checks precede the caller's observable result.
    -- Exclusive ownership and no safepoint keep canRelease valid through release.
    local slots = native.loadPointer(native.pointer(parent), native.fieldOffset<Frame>("values"))
    local slot = native.load64(callee, native.fieldOffset<Frame>("resultSlot"))
    local wanted = native.load64(callee, native.fieldOffset<Frame>("resultCount"))
    -- A protected call's caller gets true first.
    local first: uint64 = 0ULL
    if native.load64(callee, native.fieldOffset<Frame>("resultKind")) == PROTECTED_DESTINATION then
        native.store64(slots, native.index(slot * 8ULL), values.TRUE)
        first = 1ULL
    end
    if first < wanted then
        local given = value
        if native.load64(callee, native.fieldOffset<Frame>("resultKind")) == TRUTH_DESTINATION then
            given = native.chooseWord(value == values.NIL or value == values.FALSE, values.FALSE, values.TRUE)
        end
        native.store64(slots, native.index((slot + first) * 8ULL), given)
    end
    local extra: uint64 = first + 1ULL
    while extra < wanted do
        native.store64(slots, native.index((slot + extra) * 8ULL), values.NIL)
        extra = extra + 1ULL
    end

    return retire(state, native.pointer(parent), 1ULL)
end

-- RetN: `count` results from the callee's window at `source`, adjusted to
-- what the caller wanted as Lua adjusts them: extra results are dropped and
-- missing ones are nil.
export function returnValues(state: voidptr, callee: voidptr, source: voidptr, count: uint64): uint64
    local parent = returnTarget(state, callee)
    if parent == 0ULL or count > MAX_RESULTS then
        return 0ULL
    end
    local slots = native.loadPointer(native.pointer(parent), native.fieldOffset<Frame>("values"))
    local slot = native.load64(callee, native.fieldOffset<Frame>("resultSlot"))
    local wanted = native.load64(callee, native.fieldOffset<Frame>("resultCount"))
    -- A protected call's caller gets true first.
    local first: uint64 = 0ULL
    if native.load64(callee, native.fieldOffset<Frame>("resultKind")) == PROTECTED_DESTINATION then
        native.store64(slots, native.index(slot * 8ULL), values.TRUE)
        first = 1ULL
    end
    local i: uint64 = first
    while i < wanted do
        local value = values.NIL
        if i - first < count then
            value = native.load64(source, native.index((i - first) * 8ULL))
        end
        if i == 0ULL and native.load64(callee, native.fieldOffset<Frame>("resultKind")) == TRUTH_DESTINATION then
            value = native.chooseWord(value == values.NIL or value == values.FALSE, values.FALSE, values.TRUE)
        end
        native.store64(slots, native.index((slot + i) * 8ULL), value)
        i = i + 1ULL
    end

    return retire(state, native.pointer(parent), count)
end

-- How many results a prepared child's caller wants; one unless set.
export function wantResults(state: voidptr, child: voidptr, count: uint64): uint64
    if validState(state) == 0ULL or validFrame(state, child) == 0ULL then
        return 0ULL
    end
    local parent = native.loadPointer(child, native.fieldOffset<Frame>("previous"))
    if count == 0ULL
        or count > MAX_RESULTS
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
        or native.load64(
            child,
            native.fieldOffset<Frame>("resultSlot")
        ) + count > native.load64(parent, native.fieldOffset<Frame>("valueCount"))
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultCount"), count)

    return 1ULL
end

-- These checks validate borrowed mapped extents, not arbitrary pointer ownership.
local function rootStorage(state: voidptr, control: voidptr, info: voidptr, plan: voidptr): uint64
    if validStorage(state) == 0ULL
        or describe(info, plan, 0ULL) == 0ULL
        or stableMetadata(state, info, plan) == 0ULL
    then
        return 0ULL
    end
    local address, bytes = native.address(control), native.sizeOf<RootControl>()
    if range(address, bytes, 8ULL) == 0ULL then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    if overlaps(address, bytes, base, limit - base)
        or overlaps(address, bytes, native.address(state), native.sizeOf<State>())
        or overlaps(address, bytes, native.address(segment), native.sizeOf<arena.Segment>())
        or overlaps(address, bytes, native.address(info), native.sizeOf<FunctionInfo>())
        or overlaps(address, bytes, native.address(plan), native.sizeOf<WindowPlan>())
        or overlaps(
            address,
            bytes,
            native.load64(state, native.fieldOffset<State>("helperBase")),
            native.load64(state, native.fieldOffset<State>("helperBytes"))
        )
        or overlaps(
            address,
            bytes,
            native.load64(info, native.fieldOffset<FunctionInfo>("code")),
            native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL
        )
    then
        return 0ULL
    end

    return 1ULL
end

-- No parameters, varargs, frame objects or pending cleanups in this first root.
-- A failed begin leaves every byte unchanged, including the retained result.
-- The result/mark/control and immutable metadata outlive the whole entry.
export function beginRoot(state: voidptr, control: voidptr, info: voidptr, plan: voidptr): uint64
    if rootStorage(state, control, info, plan) == 0ULL then
        return 0ULL
    end
    local phase = native.load64(control, native.fieldOffset<RootControl>("phase"))
    if (phase ~= 0ULL and phase ~= ROOT_RETIRED)
        or native.load64(control, native.fieldOffset<RootControl>("frame")) ~= 0ULL
        or native.load64(state, native.fieldOffset<State>("active")) ~= 0ULL
        or native.load64(state, native.fieldOffset<State>("depth")) ~= 0ULL
        or native.load64(state, native.fieldOffset<State>("limit")) == 0ULL
        or native.load64(info, native.fieldOffset<FunctionInfo>("nparams")) ~= 0ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(control, native.fieldOffset<RootControl>("mark"))
    if phase == 0ULL then
        local at: uint64 = 0ULL
        while at < native.sizeOf<RootControl>() do
            if native.load64(control, native.index(at)) ~= 0ULL then
                return 0ULL
            end
            at = at + 8ULL
        end
    elseif native.load64(control, native.fieldOffset<RootControl>("state")) ~= native.address(state)
        or native.load64(mark, native.fieldOffset<arena.Mark>("owner")) ~= native.address(segment)
        or native.load64(mark, native.fieldOffset<arena.Mark>("serial")) == 0ULL
        or native.load64(
            mark,
            native.fieldOffset<arena.Mark>("serial")
        ) > native.load64(segment, native.fieldOffset<arena.Segment>("issued"))
    then
        return 0ULL
    end
    local bytes = native.load64(plan, native.fieldOffset<WindowPlan>("bytes"))
    if arena.reserve(segment, bytes, 16ULL, mark) == 0ULL then
        return 0ULL
    end
    -- No fallible operation, callback or safepoint follows the reservation.
    local payload = initializeFrame(native.pointer(0ULL), info, plan, mark, values.NIL, 0ULL)
    local frame = native.pointer(payload)
    native.store64(frame, native.fieldOffset<Frame>("resultKind"), ROOT_DESTINATION)
    native.store64(frame, native.fieldOffset<Frame>("resultOwner"), native.address(control))
    native.store64(
        frame,
        native.fieldOffset<Frame>("liveValues"),
        native.load64(frame, native.fieldOffset<Frame>("valueCount"))
    )
    native.store64(frame, native.fieldOffset<Frame>("phase"), ACTIVE)
    native.store64(control, native.fieldOffset<RootControl>("state"), native.address(state))
    native.store64(control, native.fieldOffset<RootControl>("frame"), payload)
    native.store64(control, native.fieldOffset<RootControl>("value"), values.NIL)
    native.store64(control, native.fieldOffset<RootControl>("count"), 0ULL)
    native.store64(control, native.fieldOffset<RootControl>("phase"), ROOT_ACTIVE)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 0ULL)
    native.store64(state, native.fieldOffset<State>("depth"), 1ULL)
    native.store64(state, native.fieldOffset<State>("active"), payload)

    return payload
end

-- The bottom frame of a coroutine's empty `state`, reserved under `mark`,
-- which the thread keeps outside the segment: it calls `closure` and answers
-- to `owner`, the thread. Its parameters are nil until the caller fills
-- them. Answers the frame, active, or 0 on refusal.
export function beginthread(
    state: voidptr,
    mark: voidptr,
    info: voidptr,
    plan: voidptr,
    closure: uint64,
    owner: uint64
): uint64
    if validStorage(state) == 0ULL
        or describe(info, plan, 0ULL) == 0ULL
        or stableMetadata(state, info, plan) == 0ULL
        or native.load64(state, native.fieldOffset<State>("active")) ~= 0ULL
        or native.load64(state, native.fieldOffset<State>("depth")) ~= 0ULL
        or native.load64(state, native.fieldOffset<State>("limit")) == 0ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local bytes = native.load64(plan, native.fieldOffset<WindowPlan>("bytes"))
    if arena.reserve(segment, bytes, 16ULL, mark) == 0ULL then
        return 0ULL
    end
    local payload = initializeFrame(native.pointer(0ULL), info, plan, mark, closure, 0ULL)
    local frame = native.pointer(payload)
    native.store64(frame, native.fieldOffset<Frame>("resultKind"), THREAD_DESTINATION)
    native.store64(frame, native.fieldOffset<Frame>("resultOwner"), owner)
    native.store64(
        frame,
        native.fieldOffset<Frame>("liveValues"),
        native.load64(frame, native.fieldOffset<Frame>("valueCount"))
    )
    native.store64(frame, native.fieldOffset<Frame>("phase"), ACTIVE)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 0ULL)
    native.store64(state, native.fieldOffset<State>("depth"), 1ULL)
    native.store64(state, native.fieldOffset<State>("active"), payload)

    return payload
end

-- Retires a coroutine's frames, deepest first, its bottom frame last: the
-- thread is done, by returning or by an error nothing in it caught.
-- Answers 1, or 0 when the frames are not as expected.
export function endthread(state: voidptr, mark: voidptr): uint64
    if validState(state) == 0ULL then
        return 0ULL
    end
    local active = native.load64(state, native.fieldOffset<State>("active"))
    local child = native.load64(native.pointer(active), native.fieldOffset<Frame>("child"))
    if child ~= 0ULL and native.load64(native.pointer(child), native.fieldOffset<Frame>("phase")) == PREPARED then
        if abortPrepared(state, native.pointer(active), native.pointer(child)) ~= 1ULL then
            return 0ULL
        end
    end
    while native.load64(state, native.fieldOffset<State>("depth")) > 1ULL do
        if abortActive(state, native.pointer(native.load64(state, native.fieldOffset<State>("active")))) ~= 1ULL then
            return 0ULL
        end
    end
    local bottom = native.load64(state, native.fieldOffset<State>("active"))
    if native.load64(native.pointer(bottom), native.fieldOffset<Frame>("resultKind")) ~= THREAD_DESTINATION
        or native.load64(native.pointer(bottom), native.fieldOffset<Frame>("frameMark")) ~= native.address(mark)
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    native.store64(state, native.fieldOffset<State>("depth"), 0ULL)
    native.store64(state, native.fieldOffset<State>("active"), 0ULL)

    return 1ULL
end

local function rootReservation(state: voidptr, control: voidptr, frame: voidptr, serial: uint64): uint64
    if range(native.address(control), native.sizeOf<RootControl>(), 8ULL) == 0ULL
        or serial == 0ULL
        or validState(state) == 0ULL
    then
        return 0ULL
    end
    if native.load64(control, native.fieldOffset<RootControl>("state")) ~= native.address(state)
        or native.load64(control, native.fieldOffset<RootControl>("frame")) ~= native.address(frame)
        or native.load64(state, native.fieldOffset<State>("active")) ~= native.address(frame)
        or native.load64(state, native.fieldOffset<State>("depth")) ~= 1ULL
        or native.address(frame) == 0ULL
    then
        return 0ULL
    end
    if validFrame(state, frame) == 0ULL then
        return 0ULL
    end
    local info = native.loadPointer(frame, native.fieldOffset<Frame>("functionInfo"))
    local plan = native.loadPointer(frame, native.fieldOffset<Frame>("windowPlan"))
    if rootStorage(state, control, info, plan) == 0ULL then
        return 0ULL
    end
    local mark = native.offset(control, native.fieldOffset<RootControl>("mark"))
    if native.load64(frame, native.fieldOffset<Frame>("previous")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("phase")) ~= ACTIVE
        or native.load64(frame, native.fieldOffset<Frame>("child")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= ROOT_DESTINATION
        or native.load64(frame, native.fieldOffset<Frame>("resultOwner")) ~= native.address(control)
        or native.load64(frame, native.fieldOffset<Frame>("resultSlot")) ~= 0ULL
        or native.load64(frame, native.fieldOffset<Frame>("resultCount")) ~= 1ULL
        or native.load64(frame, native.fieldOffset<Frame>("frameMark")) ~= native.address(mark)
        or native.load64(mark, native.fieldOffset<arena.Mark>("serial")) ~= serial
        or native.load64(mark, native.fieldOffset<arena.Mark>("payload")) ~= native.address(frame)
        or native.load64(
            mark,
            native.fieldOffset<arena.Mark>("bytes")
        ) ~= native.load64(frame, native.fieldOffset<Frame>("reservationBytes"))
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))

    return arena.canRelease(segment, mark)
end

-- The caller has already selected a valid tagged scalar. This does not convert
-- raw integer/floating windows to tagged values, authenticate heap values, or GC.
-- Serial is the begin reservation's retained token, not an address-derived ID.
export function finishRoot(state: voidptr, control: voidptr, frame: voidptr, serial: uint64, value: uint64): uint64
    if rootReservation(state, control, frame, serial) == 0ULL then
        return 0ULL
    end
    if native.load64(control, native.fieldOffset<RootControl>("phase")) ~= ROOT_ACTIVE
        or native.load64(control, native.fieldOffset<RootControl>("count")) ~= 0ULL
    then
        return 0ULL
    end
    native.store64(control, native.fieldOffset<RootControl>("value"), value)
    native.store64(control, native.fieldOffset<RootControl>("count"), 1ULL)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 1ULL)
    native.store64(control, native.fieldOffset<RootControl>("phase"), ROOT_COMPLETE)

    return 1ULL
end

-- Exclusive, scalar, no-safepoint retirement. Entry owns retained result storage
-- through output handoff; helper control/spills are outside the logical pool.
export function retireRoot(state: voidptr, control: voidptr, frame: voidptr, serial: uint64): uint64
    if rootReservation(state, control, frame, serial) == 0ULL then
        return 0ULL
    end
    if native.load64(control, native.fieldOffset<RootControl>("phase")) ~= ROOT_COMPLETE
        or native.load64(control, native.fieldOffset<RootControl>("count")) ~= 1ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(control, native.fieldOffset<RootControl>("mark"))
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    -- Never read the retired frame, including its fields used to locate control.
    native.store64(control, native.fieldOffset<RootControl>("frame"), 0ULL)
    native.store64(control, native.fieldOffset<RootControl>("phase"), ROOT_RETIRED)
    native.store64(state, native.fieldOffset<State>("depth"), 0ULL)
    native.store64(state, native.fieldOffset<State>("active"), 0ULL)

    return 1ULL
end

-- Failed/incomplete execution may discard only an active childless root. It
-- publishes no result and preserves a root whose mark/lifetime cannot be proved.
export function abortRoot(state: voidptr, control: voidptr, frame: voidptr, serial: uint64): uint64
    if rootReservation(state, control, frame, serial) == 0ULL then
        return 0ULL
    end
    if native.load64(control, native.fieldOffset<RootControl>("phase")) ~= ROOT_ACTIVE
        or native.load64(control, native.fieldOffset<RootControl>("count")) ~= 0ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local mark = native.offset(control, native.fieldOffset<RootControl>("mark"))
    if arena.release(segment, mark) == 0ULL then
        return 0ULL
    end
    -- Never read the retired frame, including its fields used to locate control.
    native.store64(control, native.fieldOffset<RootControl>("frame"), 0ULL)
    native.store64(control, native.fieldOffset<RootControl>("phase"), ROOT_RETIRED)
    native.store64(state, native.fieldOffset<State>("depth"), 0ULL)
    native.store64(state, native.fieldOffset<State>("active"), 0ULL)

    native.store64(control, native.fieldOffset<RootControl>("value"), values.NIL)
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 0ULL)

    return 1ULL
end

-- Read-only admission for an external root-publication buffer. State, control,
-- metadata and the complete initialized frame chain are immutable borrows for
-- this call. The caller supplies mapped storage, never forged integer pointers.
-- A live publication additionally forbids frame transitions and suspension;
-- these checks alone cannot establish that temporal effect/borrow contract.
export function rootRangeCount(
    state: voidptr,
    control: voidptr,
    serial: uint64,
    external: uint64,
    bytes: uint64
): uint64
    if validStorage(state) == 0ULL
        or range(native.address(control), native.sizeOf<RootControl>(), 8ULL) == 0ULL
        or range(external, bytes, 8ULL) == 0ULL
        or serial == 0ULL
    then
        return 0ULL
    end
    local segment = native.loadPointer(state, native.fieldOffset<State>("segment"))
    local base = native.load64(segment, native.fieldOffset<arena.Segment>("base"))
    local limit = native.load64(segment, native.fieldOffset<arena.Segment>("limit"))
    local controlAddress = native.address(control)
    local controlBytes = native.sizeOf<RootControl>()
    if overlaps(controlAddress, controlBytes, base, limit - base)
        or overlaps(controlAddress, controlBytes, native.address(state), native.sizeOf<State>())
        or overlaps(controlAddress, controlBytes, native.address(segment), native.sizeOf<arena.Segment>())
        or overlaps(
            controlAddress,
            controlBytes,
            native.load64(state, native.fieldOffset<State>("helperBase")),
            native.load64(state, native.fieldOffset<State>("helperBytes"))
        )
        or overlaps(external, bytes, base, limit - base)
        or overlaps(external, bytes, controlAddress, controlBytes)
        or overlaps(external, bytes, native.address(state), native.sizeOf<State>())
        or overlaps(external, bytes, native.address(segment), native.sizeOf<arena.Segment>())
        or overlaps(
            external,
            bytes,
            native.load64(state, native.fieldOffset<State>("helperBase")),
            native.load64(state, native.fieldOffset<State>("helperBytes"))
        )
    then
        return 0ULL
    end
    local rootMark = native.offset(control, native.fieldOffset<RootControl>("mark"))
    if native.load64(control, native.fieldOffset<RootControl>("state")) ~= native.address(state)
        or native.load64(rootMark, native.fieldOffset<arena.Mark>("owner")) ~= native.address(segment)
        or native.load64(rootMark, native.fieldOffset<arena.Mark>("serial")) ~= serial
        or serial > native.load64(segment, native.fieldOffset<arena.Segment>("issued"))
    then
        return 0ULL
    end
    local phase = native.load64(control, native.fieldOffset<RootControl>("phase"))
    local count = native.load64(control, native.fieldOffset<RootControl>("count"))
    local depth = native.load64(state, native.fieldOffset<State>("depth"))
    local active = native.load64(state, native.fieldOffset<State>("active"))
    if count > 1ULL
        or (count == 0ULL and native.load64(control, native.fieldOffset<RootControl>("value")) ~= values.NIL)
    then
        return 0ULL
    end
    if phase == ROOT_RETIRED then
        if active ~= 0ULL
            or depth ~= 0ULL
            or native.load64(control, native.fieldOffset<RootControl>("frame")) ~= 0ULL
        then
            return 0ULL
        end
        -- Retained result only: never dereference the retired frame address.
        return 1ULL
    end
    if (phase ~= ROOT_ACTIVE and phase ~= ROOT_COMPLETE)
        or (phase == ROOT_ACTIVE and count ~= 0ULL)
        or (phase == ROOT_COMPLETE and count ~= 1ULL)
        or depth == 0ULL
        or depth > native.load64(state, native.fieldOffset<State>("limit"))
        or depth > 65536ULL
        or depth > (limit - base) // native.sizeOf<Frame>()
    then
        return 0ULL
    end
    local cursor = native.load64(segment, native.fieldOffset<arena.Segment>("cursor"))
    if active < base or active > cursor or native.sizeOf<Frame>() > cursor - active then
        return 0ULL
    end
    local frame = native.pointer(active)
    local prepared = native.load64(frame, native.fieldOffset<Frame>("child"))
    local total = depth
    if prepared ~= 0ULL then
        total = total + 1ULL
        frame = native.pointer(prepared)
    end
    if phase == ROOT_COMPLETE and (depth ~= 1ULL or prepared ~= 0ULL) then
        return 0ULL
    end
    local top = native.load64(segment, native.fieldOffset<arena.Segment>("top"))
    if top > native.load64(segment, native.fieldOffset<arena.Segment>("issued")) then
        return 0ULL
    end
    local below: uint64 = 0ULL
    local visited: uint64 = 0ULL
    while visited < total do
        local address = native.address(frame)
        if address < base
            or address > cursor
            or native.sizeOf<Frame>() > cursor - address
            or validFrame(state, frame) == 0ULL
        then
            return 0ULL
        end
        if prepared ~= 0ULL and visited == 1ULL and address ~= active then
            return 0ULL
        end
        local expectedPhase = WAITING
        if visited == 0ULL and prepared ~= 0ULL then
            expectedPhase = PREPARED
        elseif address == active then
            expectedPhase = ACTIVE
        end
        if native.load64(frame, native.fieldOffset<Frame>("phase")) ~= expectedPhase
            or native.load64(frame, native.fieldOffset<Frame>("child")) ~= below
        then
            return 0ULL
        end
        local info = native.loadPointer(frame, native.fieldOffset<Frame>("functionInfo"))
        local plan = native.loadPointer(frame, native.fieldOffset<Frame>("windowPlan"))
        if rootStorage(state, control, info, plan) == 0ULL
            or overlaps(external, bytes, native.address(info), native.sizeOf<FunctionInfo>())
            or overlaps(external, bytes, native.address(plan), native.sizeOf<WindowPlan>())
            or overlaps(
                external,
                bytes,
                native.load64(info, native.fieldOffset<FunctionInfo>("code")),
                native.load64(info, native.fieldOffset<FunctionInfo>("instructionCount")) * 16ULL
            )
        then
            return 0ULL
        end
        local previous = native.load64(frame, native.fieldOffset<Frame>("previous"))
        local mark = rootMark
        if previous ~= 0ULL then
            if previous < base or previous > address or native.sizeOf<Frame>() > address - previous then
                return 0ULL
            end
            local parent = native.pointer(previous)
            mark = native.offset(parent, native.fieldOffset<Frame>("childMark"))
            if native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= CALLER_DESTINATION
                and native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= PROTECTED_DESTINATION
                and native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= TRUTH_DESTINATION
                and native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= PACK_DESTINATION
                and native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= MODULE_DESTINATION
                and native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= LIBRARY_DESTINATION
                or native.load64(frame, native.fieldOffset<Frame>("resultOwner")) ~= previous
                or native.load64(
                    frame,
                    native.fieldOffset<Frame>("resultSlot")
                ) >= native.load64(parent, native.fieldOffset<Frame>("valueCount"))
            then
                return 0ULL
            end
        elseif visited + 1ULL ~= total
            or address ~= native.load64(control, native.fieldOffset<RootControl>("frame"))
            or native.load64(frame, native.fieldOffset<Frame>("resultKind")) ~= ROOT_DESTINATION
            or native.load64(frame, native.fieldOffset<Frame>("resultOwner")) ~= controlAddress
            or native.load64(frame, native.fieldOffset<Frame>("resultSlot")) ~= 0ULL
        then
            return 0ULL
        end
        local before = native.load64(mark, native.fieldOffset<arena.Mark>("before"))
        local older = native.load64(mark, native.fieldOffset<arena.Mark>("previous"))
        if native.load64(frame, native.fieldOffset<Frame>("resultCount")) ~= 1ULL
            or native.load64(frame, native.fieldOffset<Frame>("frameMark")) ~= native.address(mark)
            or native.load64(mark, native.fieldOffset<arena.Mark>("owner")) ~= native.address(segment)
            or native.load64(mark, native.fieldOffset<arena.Mark>("serial")) ~= top
            or top == 0ULL
            or older >= top
            or native.load64(mark, native.fieldOffset<arena.Mark>("finish")) ~= cursor
            or native.load64(mark, native.fieldOffset<arena.Mark>("payload")) ~= address
            or before < base
            or before > address
            or address >= cursor
            or native.load64(mark, native.fieldOffset<arena.Mark>("bytes")) ~= cursor - address
            or native.load64(frame, native.fieldOffset<Frame>("reservationBytes")) ~= cursor - address
            or (older == 0ULL and before ~= base)
        then
            return 0ULL
        end
        if previous ~= 0ULL then
            local parent = native.pointer(previous)
            if previous > before
                or native.load64(parent, native.fieldOffset<Frame>("reservationBytes")) > before - previous
            then
                return 0ULL
            end
        end
        below = address
        frame = native.pointer(previous)
        top, cursor = older, before
        visited = visited + 1ULL
    end
    if native.address(frame) ~= 0ULL then
        return 0ULL
    end

    return total * 2ULL + 1ULL
end

-- Writes only after full admission. The output is disjoint caller-owned mapped
-- storage; no callback, allocation, safepoint or frame mutation may intervene.
-- Each pair is a base address and a tagged-word count, not a legacy frame word.
export function rootRanges(state: voidptr, control: voidptr, serial: uint64, output: voidptr, capacity: uint64): uint64
    if capacity == 0ULL or capacity > 0x0fffffffffffffffULL then
        return 0ULL
    end
    local count = rootRangeCount(state, control, serial, native.address(output), capacity * 16ULL)
    if count == 0ULL or count > capacity then
        return 0ULL
    end
    native.store64(output, 0, native.address(control) + native.word(native.fieldOffset<RootControl>("value")))
    native.store64(output, 8, native.load64(control, native.fieldOffset<RootControl>("count")))
    local frame = native.loadPointer(state, native.fieldOffset<State>("active"))
    if native.address(frame) ~= 0ULL then
        local child = native.loadPointer(frame, native.fieldOffset<Frame>("child"))
        if native.address(child) ~= 0ULL then
            frame = child
        end
    end
    local at: uint64 = 16ULL
    while native.address(frame) ~= 0ULL do
        native.store64(output, native.index(at), native.load64(frame, native.fieldOffset<Frame>("values")))
        native.store64(output, native.index(at + 8ULL), native.load64(frame, native.fieldOffset<Frame>("liveValues")))
        native.store64(
            output,
            native.index(at + 16ULL),
            native.address(frame) + native.word(native.fieldOffset<Frame>("closureRoot"))
        )
        native.store64(output, native.index(at + 24ULL), 1ULL)
        at = at + 32ULL
        frame = native.loadPointer(frame, native.fieldOffset<Frame>("previous"))
    end

    return count
end

-- Marks a prepared child as a protected call's (pcall).
-- Marks a prepared child as a comparison metamethod's (TRUTH_DESTINATION).
export function truth(state: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL
        or validFrame(state, child) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultKind"), TRUTH_DESTINATION)

    return 1ULL
end

-- Marks a prepared child as a required module's chunk.
export function moduleresult(state: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL
        or validFrame(state, child) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultKind"), MODULE_DESTINATION)

    return 1ULL
end

-- Marks a prepared child as a metamethod a library call waits on.
export function libraryresult(state: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL
        or validFrame(state, child) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultKind"), LIBRARY_DESTINATION)

    return 1ULL
end

-- Marks a prepared child as one whose caller takes all its results as a pack.
export function packResults(state: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL
        or validFrame(state, child) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultKind"), PACK_DESTINATION)

    return 1ULL
end

export function protect(state: voidptr, child: voidptr): uint64
    if validState(state) == 0ULL
        or validFrame(state, child) == 0ULL
        or native.load64(child, native.fieldOffset<Frame>("phase")) ~= PREPARED
    then
        return 0ULL
    end
    native.store64(child, native.fieldOffset<Frame>("resultKind"), PROTECTED_DESTINATION)

    return 1ULL
end

-- Unwinds an error to `target`, a frame on the active chain waiting on a
-- call: every frame above it is retired, the call it waits on answers
-- nils, and it is active again, to resume after that call. Answers target,
-- or 0 when the frames are not as expected.
export function land(state: voidptr, target: uint64): uint64
    if validState(state) == 0ULL or target == 0ULL then
        return 0ULL
    end
    local active = native.load64(state, native.fieldOffset<State>("active"))
    if active == target then
        return 0ULL
    end
    local child = native.load64(native.pointer(active), native.fieldOffset<Frame>("child"))
    if child ~= 0ULL and native.load64(native.pointer(child), native.fieldOffset<Frame>("phase")) == PREPARED then
        if abortPrepared(state, native.pointer(active), native.pointer(child)) ~= 1ULL then
            return 0ULL
        end
    end
    local slot: uint64 = 0ULL
    local wanted: uint64 = 0ULL
    while native.load64(state, native.fieldOffset<State>("active")) ~= target do
        local top = native.load64(state, native.fieldOffset<State>("active"))
        if top == 0ULL then
            return 0ULL
        end
        if native.load64(native.pointer(top), native.fieldOffset<Frame>("previous")) == target then
            slot = native.load64(native.pointer(top), native.fieldOffset<Frame>("resultSlot"))
            wanted = native.load64(native.pointer(top), native.fieldOffset<Frame>("resultCount"))
        end
        if abortActive(state, native.pointer(top)) ~= 1ULL then
            return 0ULL
        end
    end
    local slots = native.loadPointer(native.pointer(target), native.fieldOffset<Frame>("values"))
    local i: uint64 = 0ULL
    while i < wanted do
        native.store64(slots, native.index((slot + i) * 8ULL), values.NIL)
        i = i + 1ULL
    end
    native.store64(state, native.fieldOffset<State>("lastResultCount"), wanted)

    return target
end

-- Unwinds an error to the nearest protected frame: every frame above it is
-- retired (an unpublished child of the active frame first), then the
-- protected frame itself, and its caller gets false and `value` in the
-- slots it wanted, nil-filled. Answers the caller now active, or 0 when no
-- protected frame is on the stack or the frames are not as expected; then
-- nothing has been retired.
export function recover(state: voidptr, value: uint64): uint64
    if validState(state) == 0ULL then
        return 0ULL
    end
    local active = native.load64(state, native.fieldOffset<State>("active"))
    local protected: uint64 = 0ULL
    local at = active
    while at ~= 0ULL and protected == 0ULL do
        if native.load64(native.pointer(at), native.fieldOffset<Frame>("resultKind")) == PROTECTED_DESTINATION then
            protected = at
        else
            at = native.load64(native.pointer(at), native.fieldOffset<Frame>("previous"))
        end
    end
    if protected == 0ULL then
        return 0ULL
    end
    local child = native.load64(native.pointer(active), native.fieldOffset<Frame>("child"))
    if child ~= 0ULL and native.load64(native.pointer(child), native.fieldOffset<Frame>("phase")) == PREPARED then
        if abortPrepared(state, native.pointer(active), native.pointer(child)) ~= 1ULL then
            return 0ULL
        end
    end
    while native.load64(state, native.fieldOffset<State>("active")) ~= protected do
        if abortActive(state, native.pointer(native.load64(state, native.fieldOffset<State>("active")))) ~= 1ULL then
            return 0ULL
        end
    end
    local frame = native.pointer(protected)
    local parent = native.load64(frame, native.fieldOffset<Frame>("previous"))
    local slot = native.load64(frame, native.fieldOffset<Frame>("resultSlot"))
    local wanted = native.load64(frame, native.fieldOffset<Frame>("resultCount"))
    if abortActive(state, frame) ~= 1ULL then
        return 0ULL
    end
    local slots = native.loadPointer(native.pointer(parent), native.fieldOffset<Frame>("values"))
    native.store64(slots, native.index(slot * 8ULL), values.FALSE)
    local i: uint64 = 1ULL
    while i < wanted do
        local result = values.NIL
        if i == 1ULL then
            result = value
        end
        native.store64(slots, native.index((slot + i) * 8ULL), result)
        i = i + 1ULL
    end
    native.store64(state, native.fieldOffset<State>("lastResultCount"), 2ULL)

    return parent
end
