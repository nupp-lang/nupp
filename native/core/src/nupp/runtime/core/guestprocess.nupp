module nupp.runtime.core.guestprocess

-- The process layer's calls a program reaches through the file calls' LibCall
-- (HOST_FILES), from PROCESS_FIRST to PROCESS_LAST (librarylayouts):
-- processcalls.d.nupp's, each answering what its system call did (hostpoll,
-- hostprocess). The one table (nupp.compiler.vm.corelibrary) numbers them.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const strings = require("nupp.runtime.core.corestrings")
const ints = require("nupp.runtime.core.coreintegers")
const guestscope = require("nupp.runtime.core.guestscope")
const librarylayouts = require("nupp.runtime.core.librarylayouts")
const hostpoll = require("nupp.runtime.core.hostpoll")
const hostprocess = require("nupp.runtime.core.hostprocess")

-- processcalls.pipe's `keep`: the end the program keeps is nonblocking.
const KEEP_READ_END: uint64 = 0ULL
const KEEP_WRITE_END: uint64 = 1ULL
const INVALID: int64 = 22

local function heapOf(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- The int64 bits of an integer argument. The process layer passes checked
-- integers; anything else is its mistake.
local function integerOf(value: uint64): uint64
    if not ints.isInteger(value) then
        error("process calls: an integer argument was expected")
    end

    return ints.bitsOf(value)
end

-- Process operation `operation` with its arguments a and b.
export function call(ctx: voidptr, operation: uint64, a: uint64, b: uint64): uint64
    @unsafe do
        local h = heapOf(ctx)
        if operation == librarylayouts.PROCESS_PIPE then
            local keep = integerOf(a)
            if keep > KEEP_WRITE_END then
                return ints.make(h, native.word(0 - INVALID))
            end
            return ints.make(h, native.word(hostpoll.pipeWith(h, keep == KEEP_READ_END, keep == KEEP_WRITE_END)))
        elseif operation == librarylayouts.PROCESS_SPAWN then
            local spec = strings.header(a)
            if spec == 0ULL then
                error("process calls: a string argument was expected")
            end
            return ints.make(h, native.word(hostprocess.spawn(h, spec, integerOf(b))))
        elseif operation == librarylayouts.PROCESS_WATCH then
            return ints.make(h, native.word(hostpoll.watch(h, integerOf(a), integerOf(b))))
        elseif operation == librarylayouts.PROCESS_UNWATCH then
            return ints.make(h, native.word(hostpoll.unwatch(h, integerOf(a), integerOf(b))))
        elseif operation == librarylayouts.PROCESS_REAP then
            return ints.make(h, native.word(hostprocess.reap(h, integerOf(a))))
        elseif operation == librarylayouts.PROCESS_KILL then
            return ints.make(h, native.word(hostprocess.killGroup(integerOf(a), integerOf(b))))
        elseif operation == librarylayouts.PROCESS_SIGNAL then
            return ints.make(h, native.word(hostprocess.signal(integerOf(a), integerOf(b))))
        elseif operation == librarylayouts.PROCESS_EXIT then
            local _ = hostprocess.finish(integerOf(a))
            return values.NIL
        end
    end
    error("process calls: no such operation")

    return values.NIL
end
