module nupp.runtime.core.servicescope

const native = require("nupp.runtime.vm.intrinsics")
const pages = require("nupp.runtime.core.pagemappings")
const os = require("nupp.runtime.vm.os")
const journal = require("nupp.runtime.core.resourcejournal")

const RESOURCE_REFUSAL: int64 = 24
const INVALID: int64 = 22

-- Borrowed mapped storage outside the page ledger, frame pool and helper
-- arena. Entry owns its lifetime. Allocating services may neither suspend nor
-- change final-frame ownership while their registered root ranges are live.
export struct ServiceScope
    pages: uint64
    error: uint64
    errorOwner: uint64
    errorSite: uint64
    retainBacking: uint64
    resources: uint64
    resourcephase: uint64
end

-- All spans are borrowed mapped capabilities from the retained entry. This
-- initialization does not infer safe memory from an integer address.
export function initialize(scope: voidptr, scopeBytes: uint64, ledger: voidptr, ledgerBytes: uint64): uint64
    local base, owner = native.address(scope), native.address(ledger)
    local size, ledgerSize = native.sizeOf<ServiceScope>(), native.sizeOf<pages.Scope>()
    local maximum: uint64 = 0xffffffffffffffffULL
    if base == 0ULL
        or owner == 0ULL
        or (base & 7ULL) ~= 0ULL
        or (owner & 7ULL) ~= 0ULL
        or scopeBytes < size
        or ledgerBytes < ledgerSize
        or size > maximum - base
        or ledgerSize > maximum - owner
    then
        return 0ULL
    end
    if base < owner + ledgerSize and owner < base + size then
        return 0ULL
    end
    if native.load64(ledger, native.fieldOffset<pages.Scope>("phase")) ~= 1ULL
        or native.load64(ledger, native.fieldOffset<pages.Scope>("issued")) ~= 0ULL
        or native.load64(ledger, native.fieldOffset<pages.Scope>("live")) ~= 0ULL
        or native.load64(ledger, native.fieldOffset<pages.Scope>("cleanupFailed")) ~= 0ULL
    then
        return 0ULL
    end
    local records = native.load64(ledger, native.fieldOffset<pages.Scope>("records"))
    local capacity = native.load64(ledger, native.fieldOffset<pages.Scope>("capacity"))
    if records == 0ULL or capacity == 0ULL or capacity > 4096ULL then
        return 0ULL
    end
    local recordBytes = capacity * native.sizeOf<pages.Mapping>()
    if recordBytes > maximum - records or base < records + recordBytes and records < base + size then
        return 0ULL
    end
    local offset: uint64 = 0ULL
    while offset < size do
        if native.load64(scope, native.index(offset)) ~= 0ULL then
            return 0ULL
        end
        offset = offset + 8ULL
    end
    native.store64(scope, native.fieldOffset<ServiceScope>("pages"), owner)

    return 1ULL
end

export function okay(scope: voidptr): boolean
    return native.load64(scope, native.fieldOffset<ServiceScope>("error")) == 0ULL
end

-- No allocation and no replacement of the original failure. Literal messages
-- live in the retained source catalog indexed by owner/site, outside the heap.
export function fail(scope: voidptr, code: uint64, owner: uint64, site: uint64): nil
    if code ~= 0ULL and okay(scope) then
        native.store64(scope, native.fieldOffset<ServiceScope>("errorOwner"), owner)
        native.store64(scope, native.fieldOffset<ServiceScope>("errorSite"), site)
        native.store64(scope, native.fieldOffset<ServiceScope>("error"), code)
    end
end

-- Reserve all metadata before an OS acquisition. Once acquired, publication
-- into this record cannot allocate, charge work, suspend or call guest code.
local function reserve(scope: voidptr): uint64
    if native.load64(scope, native.fieldOffset<ServiceScope>("resourcephase")) == journal.CLOSED then
        return 0ULL
    end
    local base = native.load64(scope, native.fieldOffset<ServiceScope>("resources"))
    if base == 0ULL then
        local size = journal.CAPACITY * native.sizeOf<journal.Record>()
        local mapped = pages.map(native.loadPointer(scope, native.fieldOffset<ServiceScope>("pages")), size)
        if mapped == nil then
            return 0ULL
        end
        base = native.address(mapped)
        native.store64(scope, native.fieldOffset<ServiceScope>("resources"), base)
    end

    return journal.reserve(native.pointer(base))
end

local function find(scope: voidptr, kind: uint64, value: uint64): uint64
    local base = native.load64(scope, native.fieldOffset<ServiceScope>("resources"))
    if base == 0ULL then
        return 0ULL
    end

    return journal.find(native.pointer(base), kind, value)
end

local function consume(scope: voidptr, kind: uint64, value: uint64): nil
    local record = find(scope, kind, value)
    if record ~= 0ULL then
        journal.put(native.pointer(record), journal.EMPTY, 0ULL, 0ULL)
    end
end

local function acquired(record: uint64, kind: uint64, result: int64, operation: uint64): int64
    if result < 0 then
        journal.put(native.pointer(record), journal.EMPTY, 0ULL, 0ULL)
    else
        journal.put(native.pointer(record), kind, native.word(result), operation)
    end

    return result
end

-- No guest cleanup can run after work/cancellation refusal. The fallback
-- settles native work first, then closes the descriptors it opened.
local function drain(scope: voidptr): boolean
    native.store64(scope, native.fieldOffset<ServiceScope>("resourcephase"), journal.CLOSED)
    local base = native.load64(scope, native.fieldOffset<ServiceScope>("resources"))
    if base == 0ULL then
        return true
    end
    local index: uint64 = 0ULL
    while index < journal.CAPACITY do
        local record = journal.entry(native.pointer(base), index)
        local kind = journal.kind(record)
        if kind == journal.JOB or kind == journal.TAKEN then
            local ticket = journal.value(record)
            local operation = journal.operation(record)
            local canceled = os.poolCancel(ticket)
            if canceled ~= 1 then
                local result = os.poolsettle(ticket)
                if operation == journal.JOB_OPEN and result >= 0 then
                    journal.closeDescriptor(native.word(result))
                end
            end
            journal.put(record, journal.EMPTY, 0ULL, 0ULL)
        end
        index = index + 1ULL
    end
    index = 0ULL
    while index < journal.CAPACITY do
        local record = journal.entry(native.pointer(base), index)
        if journal.kind(record) == journal.FILE then
            local fd = journal.value(record)
            journal.put(record, journal.EMPTY, 0ULL, 0ULL)
            journal.closeDescriptor(fd)
        end
        index = index + 1ULL
    end

    return true
end

-- These wrappers are the exact replacements for the checked OS declarations
-- within the private service unit. The ledger itself binds the three raw C
-- imports. Source map failure remains nullable and does not itself raise.
export function mapPages(scope: voidptr, bytes: uint64): voidptr?
    return pages.map(native.loadPointer(scope, native.fieldOffset<ServiceScope>("pages")), bytes)
end

export function unmapPages(scope: voidptr, base: voidptr, bytes: uint64): nil
    -- A caller may still reach lexical arena.close after an inner root-close
    -- refusal. Retention blocks that path as well as the final ledger drain.
    if native.load64(scope, native.fieldOffset<ServiceScope>("retainBacking")) ~= 0ULL then
        return
    end
    local status = pages.unmap(native.loadPointer(scope, native.fieldOffset<ServiceScope>("pages")), base, bytes)
    if status ~= 1ULL then
        fail(scope, 2ULL, 0ULL, 0ULL)
    end
end

export function pageSize(scope: voidptr): uint64
    -- Scope is an explicit source operand even though this primitive cannot
    -- mutate it. The raw import has its own zero-argument C signature.
    local _ = scope
    return os.pageSize()
end

-- Where the calling thread's C errno lives, for the host modules' C calls.
export function errnoLocation(scope: voidptr): voidptr
    local _ = scope
    return os.errnoLocation()
end

export function foreignCall(scope: voidptr, block: voidptr): uint64
    local _ = scope
    return os.foreignCall(block)
end

export function foreignCells(scope: voidptr): voidptr
    local _ = scope
    return os.foreignCells()
end

export function atomicload64(scope: voidptr, base: voidptr, offset: int64): uint64
    local _ = scope
    return os.atomicload64(base, offset)
end

export function atomiccas64(scope: voidptr, base: voidptr, offset: int64, expected: uint64, replacement: uint64): uint64
    local _ = scope
    return os.atomiccas64(base, offset, expected, replacement)
end

export function environment(scope: voidptr, name: voidptr, nameBytes: uint64, out: voidptr, room: uint64): int64
    -- Reading the environment leaves the scope alone, as pageSize does.
    local _ = scope
    return os.environment(name, nameBytes, out, room)
end

export function formatNumber(scope: voidptr, bits: uint64, out: voidptr, room: uint64): int64
    local _ = scope
    return os.formatNumber(bits, out, room)
end

export function parseNumber(scope: voidptr, text: voidptr, bytes: uint64, out: voidptr): int64
    local _ = scope
    return os.parseNumber(text, bytes, out)
end

export function writeOutput(scope: voidptr, base: voidptr, bytes: uint64): int64
    local _ = scope
    return os.writeOutput(base, bytes)
end

export function readInput(scope: voidptr, base: voidptr, bytes: uint64): int64
    local _ = scope
    return os.readInput(base, bytes)
end

export function securefill(scope: voidptr, base: voidptr, bytes: uint64): int64
    local _ = scope
    return os.securefill(base, bytes)
end

export function systemquery(scope: voidptr, field: uint64, base: voidptr, room: uint64): int64
    local _ = scope
    return os.systemquery(field, base, room)
end

export function mathFunction(scope: voidptr, op: uint64, x: uint64, y: uint64): uint64
    local _ = scope
    return os.mathFunction(op, x, y)
end

export function randomSeed(scope: voidptr): uint64
    local _ = scope
    return os.randomSeed()
end

export function monotonicNanos(scope: voidptr): uint64
    local _ = scope
    return os.monotonicNanos()
end

export function sleepNanos(scope: voidptr, nanos: uint64): uint64
    local _ = scope
    return os.sleepNanos(nanos)
end

export function argument(scope: voidptr, index: uint64, out: voidptr, room: uint64): int64
    local _ = scope
    return os.argument(index, out, room)
end

export function poolStart(scope: voidptr, threads: uint64): int64
    local _ = scope
    return os.poolStart(threads)
end

export function poolSubmit(scope: voidptr, kind: uint64, word: uint64, base: voidptr, bytes: uint64): int64
    local record = reserve(scope)
    if record == 0ULL then
        return (0 - RESOURCE_REFUSAL)
    end

    return acquired(record, journal.JOB, os.poolSubmit(kind, word, base, bytes), kind)
end

export function poolTake(scope: voidptr): int64
    local ticket = os.poolTake()
    if ticket > 0 then
        local record = find(scope, journal.JOB, native.word(ticket))
        if record ~= 0ULL then
            local item = native.pointer(record)
            journal.put(item, journal.TAKEN, native.word(ticket), journal.operation(item))
        end
    end

    return ticket
end

export function poolFinish(scope: voidptr, ticket: uint64, out: voidptr, room: uint64): int64
    local record = find(scope, journal.TAKEN, ticket)
    if record == 0ULL then
        return (0 - INVALID)
    end
    local item = native.pointer(record)
    local operation = journal.operation(item)
    local result = os.poolFinish(ticket, out, room)
    if operation == journal.JOB_OPEN then
        return acquired(record, journal.FILE, result, 0ULL)
    end
    journal.put(item, journal.EMPTY, 0ULL, 0ULL)

    return result
end

export function poolCancel(scope: voidptr, ticket: uint64): int64
    local result = os.poolCancel(ticket)
    if result == 1 then
        consume(scope, journal.JOB, ticket)
    end

    return result
end

export function wallClock(scope: voidptr): int64
    local _ = scope
    return os.wallClock()
end

export function wallMillis(scope: voidptr): uint64
    local _ = scope
    return os.wallMillis()
end

export function cpuClock(scope: voidptr): uint64

    local _ = scope
    return os.cpuClock()
end

export function timeParts(scope: voidptr, t: uint64, flags: uint64, out: voidptr): int64
    local _ = scope
    return os.timeParts(t, flags, out)
end

export function timeMake(scope: voidptr, fields: voidptr): int64
    local _ = scope
    return os.timeMake(fields)
end

export function timeFormat(
    scope: voidptr,
    t: uint64,
    flags: uint64,
    spec: voidptr,
    bytes: uint64,
    out: voidptr,
    room: uint64
): int64
    local _ = scope
    return os.timeFormat(t, flags, spec, bytes, out, room)
end

-- Root-registration close failure retains all backing. Entry must preserve
-- this scope and ledger, never reset them or drain mappings under live roots.
export function retain(scope: voidptr): nil
    native.store64(scope, native.fieldOffset<ServiceScope>("retainBacking"), 1ULL)
    fail(scope, 3ULL, 0ULL, 0ULL)
end

-- Called only after lexical owners and registered-root borrowers retire. A
-- nonzero retained-backing flag is a refusal, not permission to retry cleanup.
export function close(scope: voidptr): uint64
    if native.load64(scope, native.fieldOffset<ServiceScope>("retainBacking")) ~= 0ULL then
        return 0ULL
    end
    if not drain(scope) then
        native.store64(scope, native.fieldOffset<ServiceScope>("retainBacking"), 1ULL)
        return 0ULL
    end
    local status = pages.close(native.loadPointer(scope, native.fieldOffset<ServiceScope>("pages")))
    if status ~= 1ULL then
        native.store64(scope, native.fieldOffset<ServiceScope>("retainBacking"), 1ULL)
        fail(scope, 2ULL, 0ULL, 0ULL)
        return 0ULL
    end

    native.store64(scope, native.fieldOffset<ServiceScope>("resources"), 0ULL)

    return 1ULL
end
