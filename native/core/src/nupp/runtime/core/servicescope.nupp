-- Root-registration close failure retains all backing. Entry must preserve
-- this scope and ledger, never reset them or drain mappings under live roots.
export function retain(scope: voidptr): nil
    native.store64(scope, native.fieldOffset<ServiceScope>("retainBacking"), 1ULL)
    fail(scope, 3ULL, 0ULL, 0ULL)
end

-- Called only after lexical owners and registered-root borrowers retire. A
-- nonzero retained-backing flag is a refusal, not permission to retry cleanup.
export function close(scope: voidptr): uint64
    if native.load64(scope, native.fieldOffset<ServiceScope>("retainBacking")) ~= 0ULL then
        return 0ULL
    end
    local status = pages.close(native.loadPointer(scope, native.fieldOffset<ServiceScope>("pages")))
    if status ~= 1ULL then
        native.store64(scope, native.fieldOffset<ServiceScope>("retainBacking"), 1ULL)
        fail(scope, 2ULL, 0ULL, 0ULL)
        return 0ULL
    end

    return 1ULL
end
