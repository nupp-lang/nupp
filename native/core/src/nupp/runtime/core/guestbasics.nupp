module nupp.runtime.core.guestbasics

-- The basic library's calls the handlers answer beside guestlib's: assert,
-- rawequal and next; the cleanups registered by key; and a protected call's
-- count of results.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const tables = require("nupp.runtime.core.coretables")
const guestscope = require("nupp.runtime.core.guestscope")
const texts = require("nupp.runtime.core.guesttexts")
const librarytexts = require("nupp.runtime.core.librarytexts")

local function heapof(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- next(t [, k]): the key after k in t, raw, or nil past the last; with
-- `all`, a pack of that key and its value, or of the one nil.
export function rawnext(ctx: voidptr, subject: uint64, after: uint64, all: boolean): uint64
    @unsafe do
        local h = heapof(ctx)
        local t = guestscope.tableof(subject)
        if t == 0ULL then
            texts.argumentError(ctx, 1ULL, librarytexts.TEXT_TABLE, 0ULL, subject)
        end
        -- A record instance's fields go by name (guestscope.slotname).
        local key = tables.nextKey(t, guestscope.slotkey(ctx, t, after))
        if key == values.TRUE then
            texts.libraryError(ctx, librarytexts.TEXT_NEXT_KEY)
        end
        local name = key
        if key ~= values.NIL then
            name = guestscope.slotname(ctx, t, key)
        end
        if not all then
            return name
        end
        local pack = guestscope.newTable(ctx)
        -- Held while a packed table boxes a wide integer, which can collect.
        guestscope.hold(ctx, values.TAG_OBJ | pack)
        if key == values.NIL then
            tables.set(h, pack, values.TAG_INTEGER, values.TAG_INTEGER | 1ULL)
            tables.set(h, pack, values.TAG_INTEGER | 1ULL, values.NIL)
        else
            tables.set(h, pack, values.TAG_INTEGER, values.TAG_INTEGER | 2ULL)
            tables.set(h, pack, values.TAG_INTEGER | 1ULL, name)
            tables.set(h, pack, values.TAG_INTEGER | 2ULL, tables.get(t, key))
        end
        tables.drain(h)

        return values.TAG_OBJ | pack
    end
end

-- Sets cleanup function `fn` under its key.
export function cleanupset(ctx: voidptr, key: uint64, fn: uint64): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local at = native.fieldOffset<guestscope.Services>("cleanups")
        local registry = native.load64(services, at)
        if registry == 0ULL then
            registry = values.TAG_OBJ | guestscope.newTable(ctx)
            native.store64(services, at, registry)
        end
        local h = heapof(ctx)
        if tables.set(h, registry & values.PAYLOAD, key, fn) ~= tables.OK then
            error("not enough memory")
        end
        tables.drain(h)

        return values.NIL
    end
end

-- The cleanup function set under `key`, or nil.
export function cleanupget(ctx: voidptr, key: uint64): uint64
    @unsafe do
        local registry = native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<guestscope.Services>("cleanups")
        )
        if registry == 0ULL then
            return values.NIL
        end

        return tables.get(registry & values.PAYLOAD, key)
    end
end

-- Sets the count of `pack`, whose protected call's status is at `status`
-- and whose count is the call's on success: a failure gives its status and
-- the error alone, so the error is last.
export function protectedcount(ctx: voidptr, pack: uint64, status: uint64): uint64
    @unsafe do
        local t = pack & values.PAYLOAD
        if tables.get(t, status) == values.FALSE then
            local h = heapof(ctx)
            if tables.set(h, t, values.TAG_INTEGER, status + 1ULL) ~= tables.OK then
                error("not enough memory")
            end
            tables.drain(h)
        end

        return values.NIL
    end
end
