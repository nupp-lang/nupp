module nupp.runtime.core.guestbasics

-- The basic library's calls the handlers answer beside guestlib's:
-- assert, rawequal and next.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const tables = require("nupp.runtime.core.coretables")
const ints = require("nupp.runtime.core.coreintegers")
const corestorage = require("nupp.runtime.core.corestorage")
const strings = require("nupp.runtime.core.corestrings")
const guestscope = require("nupp.runtime.core.guestscope")
const texts = require("nupp.runtime.core.guesttexts")

-- assert(v [, message]).
export const LIB_ASSERT: uint64 = 87ULL
-- rawequal(a, b).
export const LIB_RAWEQUAL: uint64 = 88ULL
-- next(t [, k]): its key alone, and its key and value as a pack.
export const LIB_NEXT: uint64 = 89ULL
export const LIB_NEXT_ALL: uint64 = 90ULL
-- The storage calls: allocbytes(count) and allocate(kind, count).
export const LIB_ALLOCBYTES: uint64 = 94ULL
export const LIB_ALLOCATE: uint64 = 95ULL
-- view(storage, kind, offset [, count]), copy(target, source, count),
-- fill(target, count, byte), text(storage, count), fromstring(s),
-- elements(storage) and elementkind(storage).
export const LIB_VIEW: uint64 = 96ULL
export const LIB_COPY: uint64 = 97ULL
export const LIB_FILL: uint64 = 98ULL
export const LIB_TEXT: uint64 = 99ULL
export const LIB_FROMSTRING: uint64 = 100ULL
export const LIB_ELEMENTS: uint64 = 101ULL
export const LIB_ELEMENTKIND: uint64 = 102ULL
-- cast(storage, kind): view(storage, kind, 0).
export const LIB_CAST: uint64 = 103ULL
-- A cleanup function set under its key, and read back by it.
export const LIB_CLEANUPSET: uint64 = 104ULL
export const LIB_CLEANUPGET: uint64 = 105ULL
-- A table constructor for a checked `{T}` whose elements pack: the fresh
-- table, its array part packed as kind a (coretables), with room for b. And
-- storagecalls.packedkind(t): that kind, 0 once the table is general (or for
-- a value that is not a table).
export const LIB_NEWARRAY: uint64 = 116ULL
export const LIB_PACKEDKIND: uint64 = 117ULL

-- No index: an error was raised instead.
const NOINDEX: uint64 = 0xffffffffffffffffULL

local function heapof(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- next(t [, k]): the key after k in t, raw, or nil past the last; with
-- `all`, a pack of that key and its value, or of the one nil.
export function rawnext(ctx: voidptr, subject: uint64, after: uint64, all: boolean): uint64
    @unsafe do
        local h = heapof(ctx)
        local t = guestscope.tableof(subject)
        if t == 0ULL then
            texts.argumentError(ctx, 1ULL, texts.TEXT_TABLE, 0ULL, subject)
        end
        local key = tables.nextKey(t, after)
        if key == values.TRUE then
            texts.libraryError(ctx, texts.TEXT_NEXT_KEY)
        end
        if not all then
            return key
        end
        local pack = guestscope.newTable(ctx)
        -- Held while a packed table boxes a wide integer, which can collect.
        guestscope.hold(ctx, values.TAG_OBJ | pack)
        if key == values.NIL then
            tables.set(h, pack, values.TAG_INTEGER, values.TAG_INTEGER | 1ULL)
            tables.set(h, pack, values.TAG_INTEGER | 1ULL, values.NIL)
        else
            tables.set(h, pack, values.TAG_INTEGER, values.TAG_INTEGER | 2ULL)
            tables.set(h, pack, values.TAG_INTEGER | 1ULL, key)
            tables.set(h, pack, values.TAG_INTEGER | 2ULL, tables.get(t, key))
        end
        tables.drain(h)

        return values.TAG_OBJ | pack
    end
end

-- The element a key names in storage `object`, zero-based, or NOINDEX once
-- "index out of range" is raised for a key that names none.
local function storageindex(ctx: voidptr, object: uint64, key: uint64): uint64
    local index = NOINDEX
    if ints.isInteger(key) then
        index = ints.bitsOf(key)
    elseif key & values.QNAN ~= values.QNAN then
        -- A float that is a whole number names that index.
        local x = native.fromBits(key)
        local whole = native.toInt(x)
        if native.toFloat(whole) == x and whole >= 0 then
            index = native.word(whole)
        end
    end
    if index == NOINDEX or index >= corestorage.elementcount(object) then
        guestscope.raise(ctx, texts.textvalue(ctx, texts.TEXT_INDEX_RANGE), 1ULL)
        return NOINDEX
    end

    return index
end

-- storage[key] for GetIdx: the element, or values.TRUE once an error is
-- raised.
export function storageget(ctx: voidptr, subject: uint64, key: uint64): uint64
    local object = subject & values.PAYLOAD
    local index = storageindex(ctx, object, key)
    if index == NOINDEX then
        return values.TRUE
    end
    @unsafe do
        local h = heapof(ctx)
        local value = corestorage.readelement(h, object, index)
        tables.drain(h)
        return value
    end
end

-- storage[key] = value for SetIdx: 0, or 1 once an error is raised. A float
-- stored as an integer kind is truncated toward zero, as C converts one.
export function storageset(ctx: voidptr, subject: uint64, key: uint64, value: uint64): uint64
    local object = subject & values.PAYLOAD
    local index = storageindex(ctx, object, key)
    if index == NOINDEX then
        return 1ULL
    end
    local kind = corestorage.elementkind(object)
    local floating = kind == corestorage.FLOAT32 or kind == corestorage.FLOAT64
    local bits: uint64 = 0ULL
    if ints.isInteger(value) then
        bits = ints.bitsOf(value)
        if floating then
            bits = ints.toFloatBits(bits)
        end
    elseif value & values.QNAN ~= values.QNAN or value == values.QNAN then
        bits = value
        if not floating then
            bits = native.word(native.toInt(native.fromBits(value)))
        end
    else
        guestscope.raise(ctx, texts.textvalue(ctx, texts.TEXT_NUMBER_EXPECTED), 1ULL)
        return 1ULL
    end
    corestorage.writeelement(object, index, bits)

    return 0ULL
end

-- New zeroed storage of `n` elements of `kind`, an integer value.
export function allocate(ctx: voidptr, kind: uint64, n: uint64): uint64
    local code = corestorage.elementwidth(ints.bitsOf(kind))
    if not ints.isInteger(kind) or code == 0ULL then
        texts.argumentError(ctx, 1ULL, texts.TEXT_NUMBER, 0ULL, kind)
    end
    if not ints.isInteger(n) or native.index(ints.bitsOf(n)) < 0 then
        texts.argumentError(ctx, 2ULL, texts.TEXT_NUMBER, 0ULL, n)
    end
    @unsafe do
        local h = heapof(ctx)
        local made = corestorage.newstorage(h, ints.bitsOf(kind), ints.bitsOf(n))
        if made == 0ULL then
            error("not enough memory")
        end
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end

-- Argument `position`, storage: its header address.
local function storageargument(ctx: voidptr, value: uint64, position: uint64): uint64
    if not corestorage.isstorage(value) then
        texts.argumentError(ctx, position, texts.TEXT_STORAGE, 0ULL, value)
    end

    return value & values.PAYLOAD
end

-- Argument `position`, a count of no more than `limit`.
local function countargument(ctx: voidptr, value: uint64, position: uint64, limit: uint64): uint64
    if not ints.isInteger(value) or native.index(ints.bitsOf(value)) < 0 or ints.bitsOf(value) > limit then
        texts.argumentError(ctx, position, 0ULL, texts.TEXT_INDEX_RANGE, value)
    end

    return ints.bitsOf(value)
end

-- The storage calls from view on (`LIB_VIEW` through `LIB_ELEMENTKIND`),
-- given `n` arguments.
export function storagecall(ctx: voidptr, id: uint64, n: uint64, a: uint64, b: uint64, c: uint64, d: uint64): uint64
    @unsafe do
        local h = heapof(ctx)
        if id == LIB_FROMSTRING then
            local s = strings.header(a)
            if s == 0ULL then
                texts.argumentError(ctx, 1ULL, texts.TEXT_STRING, 0ULL, a)
            end
            local length = strings.length(s)
            local made = corestorage.newstorage(h, corestorage.UINT8, length)
            if made == 0ULL then
                error("not enough memory")
            end
            corestorage.copybytes(corestorage.storagebase(made), (native.pointer(s) as heap.Header*).auxPtr, length)
            tables.drain(h)
            return values.TAG_OBJ | made
        end
        local object = storageargument(ctx, a, 1ULL)
        local size = corestorage.bytelength(object)
        if id == LIB_ELEMENTS then
            return values.TAG_INTEGER | corestorage.elementcount(object)
        elseif id == LIB_ELEMENTKIND then
            return values.TAG_INTEGER | corestorage.elementkind(object)
        elseif id == LIB_VIEW or id == LIB_CAST then
            local kind: uint64 = 0ULL
            if ints.isInteger(b) then
                kind = ints.bitsOf(b)
            end
            local width = corestorage.elementwidth(kind)
            if width == 0ULL then
                texts.argumentError(ctx, 2ULL, texts.TEXT_NUMBER, 0ULL, b)
            end
            local offset: uint64 = 0ULL
            if id == LIB_VIEW then
                offset = countargument(ctx, c, 3ULL, size)
            end
            local count = (size - offset) // width
            if id == LIB_VIEW and n >= 4ULL and d ~= values.NIL then
                count = countargument(ctx, d, 4ULL, count)
            end
            local made = corestorage.newview(h, object, kind, offset, count)
            if made == 0ULL then
                error("not enough memory")
            end
            tables.drain(h)
            return values.TAG_OBJ | made
        elseif id == LIB_COPY then
            -- The source is storage or a string.
            local s = strings.header(b)
            local from: uint64 = 0ULL
            local available: uint64 = 0ULL
            if s ~= 0ULL then
                from = (native.pointer(s) as heap.Header*).auxPtr
                available = strings.length(s)
            else
                local source = storageargument(ctx, b, 2ULL)
                from = corestorage.storagebase(source)
                available = corestorage.bytelength(source)
            end
            local limit = size
            if available < limit then
                limit = available
            end
            local count = countargument(ctx, c, 3ULL, limit)
            corestorage.copybytes(corestorage.storagebase(object), from, count)
            return values.NIL
        elseif id == LIB_FILL then
            local count = countargument(ctx, b, 2ULL, size)
            local byte: uint64 = 0ULL
            if ints.isInteger(c) then
                byte = ints.bitsOf(c)
            end
            corestorage.fillbytes(corestorage.storagebase(object), count, byte)
            return values.NIL
        end
        -- LIB_TEXT: the first `count` bytes as a string.
        local count = countargument(ctx, b, 2ULL, size)
        local made = strings.make(h, corestorage.storagebase(object), count)
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end

-- storage + n: a view from `n` elements in, through its end; values.TRUE
-- once "index out of range" is raised for an `n` outside it.
export function storageoffset(ctx: voidptr, subject: uint64, step: uint64): uint64
    local object = subject & values.PAYLOAD
    local count = corestorage.elementcount(object)
    if not ints.isInteger(step) or native.index(ints.bitsOf(step)) < 0 or ints.bitsOf(step) > count then
        guestscope.raise(ctx, texts.textvalue(ctx, texts.TEXT_INDEX_RANGE), 1ULL)
        return values.TRUE
    end
    local n = ints.bitsOf(step)
    local kind = corestorage.elementkind(object)
    @unsafe do
        local h = heapof(ctx)
        local made = corestorage.newview(h, object, kind, n * corestorage.elementwidth(kind), count - n)
        if made == 0ULL then
            error("not enough memory")
        end
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end

-- Sets cleanup function `fn` under its key.
export function cleanupset(ctx: voidptr, key: uint64, fn: uint64): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local at = native.fieldOffset<guestscope.Services>("cleanups")
        local registry = native.load64(services, at)
        if registry == 0ULL then
            registry = values.TAG_OBJ | guestscope.newTable(ctx)
            native.store64(services, at, registry)
        end
        local h = heapof(ctx)
        if tables.set(h, registry & values.PAYLOAD, key, fn) ~= tables.OK then
            error("not enough memory")
        end
        tables.drain(h)

        return values.NIL
    end
end

-- The cleanup function set under `key`, or nil.
export function cleanupget(ctx: voidptr, key: uint64): uint64
    @unsafe do
        local registry = native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<guestscope.Services>("cleanups")
        )
        if registry == 0ULL then
            return values.NIL
        end

        return tables.get(registry & values.PAYLOAD, key)
    end
end
