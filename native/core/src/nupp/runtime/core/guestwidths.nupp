module nupp.runtime.core.guestwidths

-- The fixed-width math the prelude adds to Lua's: binary32 rounding
-- (`math.f32`) and 32-bit integer wrapping (`math.u32`, `math.i32`).
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const ints = require("nupp.runtime.core.coreintegers")
const guestscope = require("nupp.runtime.core.guestscope")
const guestlib = require("nupp.runtime.core.guestlib")
const corestorage = require("nupp.runtime.core.corestorage")
const texts = require("nupp.runtime.core.guesttexts")

-- math.f32.narrow(x): x rounded to the nearest binary32 value.
export const LIB_NARROW: uint64 = 91ULL
-- math.u32.wrap(x) and math.i32.wrap(x): x's low 32 bits, unsigned and
-- signed.
export const LIB_U32WRAP: uint64 = 92ULL
export const LIB_I32WRAP: uint64 = 93ULL

-- The call `id` makes of `a`.
export function call(ctx: voidptr, id: uint64, a: uint64): uint64
    if id == LIB_NARROW then
        return guestlib.floatValue(corestorage.narrow(guestlib.floatOf(guestlib.numberArgument(ctx, a, 1ULL))))
    end
    if a == values.NIL then
        texts.argumentError(ctx, 1ULL, texts.TEXT_NUMBER, 0ULL, a)
    end
    local low = native.word(guestlib.integerArgument(ctx, a, 0, 1ULL)) & 0xffffffffULL
    if id == LIB_I32WRAP and low >= 0x80000000ULL then
        low = low | 0xffffffff00000000ULL
    end
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local h = native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
        return ints.make(h, low)
    end
end
