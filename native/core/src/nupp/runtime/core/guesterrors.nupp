module nupp.runtime.core.guesterrors

-- Runtime errors on the core: the faults an operation reports, phrased as
-- Lua 5.5 phrases them, with the position of the line that raised them.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const context = require("nupp.runtime.core.context")
const values = require("nupp.runtime.vm.values")
const tables = require("nupp.runtime.core.coretables")
const strings = require("nupp.runtime.core.corestrings")
const ints = require("nupp.runtime.core.coreintegers")
const catalog = require("nupp.runtime.core.guestcatalog")
const frames = require("nupp.runtime.core.frames")
const guestscope = require("nupp.runtime.core.guestscope")

-- Physical frames for the argument-forwarding contract. A protected target
-- is visible, but walking past its C-like boundary is refused.
export function physicalframeat(ctx: voidptr, level: uint64): uint64
    local state = native.loadPointer(ctx, context.STATE)
    local frame = native.load64(state, native.fieldOffset<frames.State>("active"))
    local k: uint64 = 1ULL
    if level == 0ULL then
        return 0ULL
    end
    while k < level do
        if frame == 0ULL or frames.isprotected(native.pointer(frame)) then
            return 0ULL
        end
        frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
        k = k + 1ULL
    end

    return frame
end

-- The catalog record of function `owner`, or 0 when the catalog has none.
local function record(c: voidptr, owner: uint64): uint64
    if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
        return 0ULL
    end

    return native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
end

-- Whether the frame runs a function of the core's C library, written in
-- Nupp for Lua's C functions: the compiler gives those no line table.
local function clibrary(ctx: voidptr, frame: uint64): boolean
    local fn = record(
        native.loadPointer(ctx, context.CATALOG),
        native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
    )

    return fn ~= 0ULL and native.load64(native.pointer(fn), native.fieldOffset<catalog.Function>("lines")) == 0ULL
end

-- The diagnostic row of the call `frame` waits on, at its resume pc less
-- one, or 0: no diagnostics, no catalog function or no call there, or, with
-- `nonlanding`, a function that lands its calls' errors.
local function waitingrow(c: voidptr, frame: uint64, nonlanding: boolean): uint64
    local rows = catalog.diagnostics(c)
    local resume = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("resumePC"))
    local fn = record(c, native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId")))
    if rows == 0ULL
        or fn == 0ULL
        or resume == 0ULL
        or nonlanding and native.load64(native.pointer(fn), native.fieldOffset<catalog.Function>("lands")) ~= 0ULL
    then
        return 0ULL
    end
    local site = catalog.callsite(c, native.pointer(fn), resume - 1ULL)
    local row: uint64 = 0ULL
    if site ~= 0ULL then
        row = rows + native.load64(
            native.pointer(site),
            native.fieldOffset<catalog.Callsite>("id")
        ) * native.sizeOf<catalog.CallDiagnostic>()
    end

    return row
end

local function tailcaller(ctx: voidptr, frame: uint64): boolean
    local row = waitingrow(native.loadPointer(ctx, context.CATALOG), frame, true)

    return row ~= 0ULL
        and native.load64(native.pointer(row), native.fieldOffset<catalog.CallDiagnostic>("method"))
        & catalog.CALL_TAIL ~= 0ULL
end

-- Tail-returned guest calls hide their caller without changing physical roots
-- or cleanup. A protected target remains visible, but its boundary does not.
export function frameat(ctx: voidptr, level: uint64): uint64
    local state = native.loadPointer(ctx, context.STATE)
    local frame = native.load64(state, native.fieldOffset<frames.State>("active"))
    local k: uint64 = 1ULL
    if level == 0ULL then
        return 0ULL
    end
    while k < level do
        if frame == 0ULL or frames.isprotected(native.pointer(frame)) then
            return 0ULL
        end
        -- Lua never tail calls a C function, so one leaves its caller in place.
        local kept = clibrary(ctx, frame)
        frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
        while frame ~= 0ULL and not kept and tailcaller(ctx, frame) do
            if frames.isprotected(native.pointer(frame)) then
                return 0ULL
            end
            frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
        end
        k = k + 1ULL
    end

    return frame
end

-- A string message with Lua's position before it, "chunk:line: ", naming
-- the frame `level` calls out from the one that failed: 1 is that frame at
-- `pc` in `owner`, 2 its caller at the call. Anything else, or a frame with
-- no known line, answers the message as it is. pcall has no line, so a
-- level past a protected call's own frame names nothing.
export function positioned(ctx: voidptr, message: uint64, level: uint64, failedOwner: uint64, failedPc: uint64): uint64
    local state0 = strings.Builder(0ULL, 0ULL)
    @unsafe do
        local s = strings.header(message)
        if s == 0ULL or level == 0ULL then
            return message
        end
        local owner, pc = failedOwner, failedPc
        local frame = frameat(ctx, level)
        local called = level > 1ULL
        if called and frame == 0ULL then
            return message
        end
        -- A C library function has no line: what it raises names the line
        -- that called it, as Lua's C functions' errors do.
        while frame ~= 0ULL and clibrary(ctx, frame) do
            if frames.isprotected(native.pointer(frame)) then
                return message
            end
            frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
            if frame == 0ULL then
                return message
            end
            called = true
        end
        if called then
            owner = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
            local resume = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("resumePC"))
            if resume == 0ULL then
                return message
            end
            pc = resume - 1ULL
        end
        local c = native.loadPointer(ctx, context.CATALOG)
        if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
            return message
        end
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local fn = native.pointer(
            native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
        )
        local lines = native.load64(fn, native.fieldOffset<catalog.Function>("lines"))
        local chunk = native.load64(fn, native.fieldOffset<catalog.Function>("chunk"))
        if lines == 0ULL
            or chunk == 0ULL
            or pc >= native.load64(fn, native.fieldOffset<catalog.Function>("instructionCount"))
        then
            return message
        end
        local line = native.load64(native.pointer(data + lines + pc * 8ULL), 0)
        if line == 0ULL then
            return message
        end
        local at = data + (chunk & values.PAYLOAD)
        local h = native.pointer(guestscope.guestHeap(ctx)) as heap.Heap*
        local builderLifetime = strings.open(h, state0 as strings.Builder*)
        local builder = state0 as strings.Builder*
        if strings.append(h, builder, at + 8ULL, native.load64(native.pointer(at), 0)) ~= 0ULL
            or strings.appendWord(h, builder, 58ULL, 1ULL) ~= 0ULL
            or strings.appendInteger(h, builder, native.index(line)) ~= 0ULL
            or strings.appendWord(h, builder, 0x203aULL, 2ULL) ~= 0ULL
            or strings.appendString(h, builder, s) ~= 0ULL
        then
            strings.release(builder)
            return message
        end
        local result = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | result
    end
end

-- A handler's guest error, before it fails the entry: what went wrong, for
-- the message Lua words (`runtimeError`), and the operands it names.
export function fault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<guestscope.Services>("fault"), kind)
        native.store64(services, native.fieldOffset<guestscope.Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<guestscope.Services>("other"), other)
    end
end

-- A canonical library value's call of its own library function, from
-- `frame` (`nupp.runtime.libraryvalues`): what the call raises is its
-- caller's, as the library function's own error is. It is positioned at the
-- call that reached the value, counting arguments as that call did, a
-- method's from the one after self. Called by a protected call, which has no
-- position, it has none and counts them all.
export function callerSite(ctx: voidptr, frame: voidptr): nil
    local c = native.loadPointer(ctx, context.CATALOG)
    local count = native.load64(c, native.fieldOffset<catalog.Catalog>("count"))
    -- No owner the catalog has: positioned() leaves the message as it is.
    local owner = count
    local pc: uint64 = 0ULL
    local method: uint64 = 0ULL
    local parent = native.load64(frame, native.fieldOffset<frames.Frame>("previous"))
    local row: uint64 = 0ULL
    if not frames.isprotected(frame) and parent ~= 0ULL then
        row = waitingrow(c, parent, false)
    end
    if row ~= 0ULL then
        owner = native.load64(native.pointer(parent), native.fieldOffset<frames.Frame>("functionId"))
        pc = native.load64(native.pointer(parent), native.fieldOffset<frames.Frame>("resumePC")) - 1ULL
        method = native.load64(native.pointer(row), native.fieldOffset<catalog.CallDiagnostic>("method"))
            & catalog.CALL_METHOD
    end
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<guestscope.Services>("libraryOwner"), owner)
        native.store64(services, native.fieldOffset<guestscope.Services>("libraryPc"), pc)
        native.store64(services, native.fieldOffset<guestscope.Services>("libraryMethod"), method)
    end
end

-- Phrases runtime error messages are built from, by id.
const PHRASE_ARITH: uint64 = 1ULL
const PHRASE_MODZERO: uint64 = 2ULL
const PHRASE_COMPARETWO: uint64 = 3ULL
const PHRASE_VALUES: uint64 = 4ULL
const PHRASE_COMPARE: uint64 = 5ULL
const PHRASE_WITH: uint64 = 6ULL
const PHRASE_LENGTH: uint64 = 7ULL
const PHRASE_INDEX: uint64 = 8ULL
const PHRASE_CALL: uint64 = 9ULL
const PHRASE_VALUE: uint64 = 10ULL
const PHRASE_NIL: uint64 = 11ULL
const PHRASE_BOOLEAN: uint64 = 12ULL
const PHRASE_NUMBER: uint64 = 13ULL
const PHRASE_STRING: uint64 = 14ULL
const PHRASE_TABLE: uint64 = 15ULL
const PHRASE_FUNCTION: uint64 = 16ULL
const PHRASE_USERDATA: uint64 = 17ULL
const PHRASE_KEYNIL: uint64 = 18ULL
const PHRASE_KEYNAN: uint64 = 19ULL
const PHRASE_THREAD: uint64 = 20ULL
const PHRASE_BITWISE: uint64 = 21ULL
const PHRASE_NOINT: uint64 = 22ULL
const PHRASE_READONLY: uint64 = 23ULL

-- Appends phrase `id`; answers 1 when backing is refused.
local function appendPhrase(h: heap.Heap*, borrows b: strings.Builder*, id: uint64): uint64
    if id == PHRASE_ARITH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6874697261206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f20636974656dULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_MODZERO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2730256e27206d72ULL, 8ULL)
    elseif id == PHRASE_COMPARETWO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206f7774206572ULL, 7ULL)
    elseif id == PHRASE_VALUES then
        return strings.appendWord(h, b, 0x7365756c617620ULL, 7ULL)
    elseif id == PHRASE_COMPARE then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206572ULL, 3ULL)
    elseif id == PHRASE_WITH then
        return strings.appendWord(h, b, 0x206874697720ULL, 6ULL)
    elseif id == PHRASE_LENGTH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c20746567206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x666f206874676e65ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_INDEX then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x7865646e69206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_CALL then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x206c6c6163206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == PHRASE_VALUE then
        return strings.appendWord(h, b, 0x65756c617620ULL, 6ULL)
    elseif id == PHRASE_NIL then
        return strings.appendWord(h, b, 0x6c696eULL, 3ULL)
    elseif id == PHRASE_BOOLEAN then
        return strings.appendWord(h, b, 0x6e61656c6f6f62ULL, 7ULL)
    elseif id == PHRASE_NUMBER then
        return strings.appendWord(h, b, 0x7265626d756eULL, 6ULL)
    elseif id == PHRASE_STRING then
        return strings.appendWord(h, b, 0x676e69727473ULL, 6ULL)
    elseif id == PHRASE_TABLE then
        return strings.appendWord(h, b, 0x656c626174ULL, 5ULL)
    elseif id == PHRASE_FUNCTION then
        return strings.appendWord(h, b, 0x6e6f6974636e7566ULL, 8ULL)
    elseif id == PHRASE_USERDATA then
        return strings.appendWord(h, b, 0x6174616472657375ULL, 8ULL)
    elseif id == PHRASE_BITWISE then
        -- "attempt to perform bitwise operation on a "
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6977746962206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x617265706f206573ULL, 8ULL)
            | strings.appendWord(h, b, 0x206e6f206e6f6974ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == PHRASE_NOINT then
        -- "number has no integer representation"
        return strings.appendWord(h, b, 0x68207265626d756eULL, 8ULL)
            | strings.appendWord(h, b, 0x6e69206f6e207361ULL, 8ULL)
            | strings.appendWord(h, b, 0x6572207265676574ULL, 8ULL)
            | strings.appendWord(h, b, 0x61746e6573657270ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f6974ULL, 4ULL)
    elseif id == PHRASE_READONLY then
        -- "attempt to modify a readonly table"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6669646f6d206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6461657220612079ULL, 8ULL)
            | strings.appendWord(h, b, 0x62617420796c6e6fULL, 8ULL)
            | strings.appendWord(h, b, 0x656cULL, 2ULL)
    elseif id == PHRASE_THREAD then
        return strings.appendWord(h, b, 0x646165726874ULL, 6ULL)
    elseif id == PHRASE_KEYNIL then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c69ULL, 2ULL)
    elseif id == PHRASE_KEYNAN then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e61ULL, 2ULL)
    end

    return 0ULL
end

-- The phrase naming a value's type, as Lua's type() does.
local function typePhrase(value: uint64): uint64
    if value == values.NIL then
        return PHRASE_NIL
    elseif value == values.TRUE or value == values.FALSE then
        return PHRASE_BOOLEAN
    elseif ints.isInteger(value) or value & values.QNAN ~= values.QNAN or value == values.QNAN then
        return PHRASE_NUMBER
    elseif strings.header(value) ~= 0ULL then
        return PHRASE_STRING
    end
    @unsafe do
        local kind = native.word(
            native.load8(native.pointer(value & values.PAYLOAD), native.fieldOffset<heap.Header>("kind"))
        )
        if kind == heap.KIND_TABLE then
            return PHRASE_TABLE
        elseif kind == heap.KIND_CLOSURE then
            return PHRASE_FUNCTION
        elseif kind == heap.KIND_THREAD then
            return PHRASE_THREAD
        elseif kind == heap.KIND_CORE_STORAGE or kind == heap.KIND_CORE_VIEW or kind == heap.KIND_USERDATA then
            return PHRASE_USERDATA
        end
    end

    return PHRASE_USERDATA
end

local function isNumber(value: uint64): boolean
    return typePhrase(value) == PHRASE_NUMBER
end

-- type(v): the name of a value's type, as an interned string.
export function typeName(ctx: voidptr, value: uint64): uint64
    local state = strings.Builder(0ULL, 0ULL)
    @unsafe do
        local h = native.pointer(guestscope.guestHeap(ctx)) as heap.Heap*
        local builderLifetime = strings.open(h, state as strings.Builder*)
        local builder = state as strings.Builder*
        if appendPhrase(h, builder, typePhrase(value)) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- Whether Lua's tostring of `value` is its type and address: a table,
-- function, thread or userdata.
export function identified(value: uint64): boolean
    local phrase = typePhrase(value)

    return phrase == PHRASE_TABLE or phrase == PHRASE_FUNCTION or phrase == PHRASE_THREAD or phrase == PHRASE_USERDATA
end

-- Appends Lua's tostring of an `identified` value with no __tostring: its
-- type and address in hexadecimal, "table: 0x6000012345a0".
export function appendIdentity(h: heap.Heap*, borrows b: strings.Builder*, value: uint64): uint64
    -- ": 0x" as a little-endian byte word.
    local refused = appendPhrase(h, b, typePhrase(value)) | strings.appendWord(h, b, 0x7830203aULL, 4ULL)
    local address = value & values.PAYLOAD
    local shift: uint64 = 60ULL
    local started = false
    while true do
        local digit = (address >> shift) & 15ULL
        if digit ~= 0ULL or started or shift == 0ULL then
            started = true
            local c = digit + 48ULL
            if digit >= 10ULL then
                c = digit + 87ULL
            end
            refused = refused | strings.appendWord(h, b, c, 1ULL)
        end
        if shift == 0ULL then
            break
        end
        shift = shift - 4ULL
    end

    return refused
end

-- The message a handler's guest error carries, as Lua words it (without the
-- variable Lua names after it), or "runtime error" when no fault was noted.
export function runtimeError(ctx: voidptr): uint64
    local state = strings.Builder(0ULL, 0ULL)
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local kind = native.load64(services, native.fieldOffset<guestscope.Services>("fault"))
        local culprit = native.load64(services, native.fieldOffset<guestscope.Services>("culprit"))
        local other = native.load64(services, native.fieldOffset<guestscope.Services>("other"))
        local h = native.pointer(guestscope.guestHeap(ctx)) as heap.Heap*
        local builderLifetime = strings.open(h, state as strings.Builder*)
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if kind == guestscope.FAULT_ARITH then
            local wrong = culprit
            if isNumber(culprit) then
                wrong = other
            end
            refused = appendPhrase(h, builder, PHRASE_ARITH)
                | appendPhrase(h, builder, typePhrase(wrong))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == guestscope.FAULT_BITWISE then
            local wrong = culprit
            if isNumber(culprit) then
                wrong = other
            end
            refused = appendPhrase(h, builder, PHRASE_BITWISE)
                | appendPhrase(h, builder, typePhrase(wrong))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == guestscope.FAULT_NOINT then
            refused = appendPhrase(h, builder, PHRASE_NOINT)
        elseif kind == guestscope.FAULT_READONLY then
            refused = appendPhrase(h, builder, PHRASE_READONLY)
        elseif kind == guestscope.FAULT_MODZERO then
            refused = appendPhrase(h, builder, PHRASE_MODZERO)
        elseif kind == guestscope.FAULT_COMPARE then
            if typePhrase(culprit) == typePhrase(other) then
                refused = appendPhrase(h, builder, PHRASE_COMPARETWO)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_VALUES)
            else
                refused = appendPhrase(h, builder, PHRASE_COMPARE)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_WITH)
                    | appendPhrase(h, builder, typePhrase(other))
            end
        elseif kind == guestscope.FAULT_LENGTH or kind == guestscope.FAULT_INDEX or kind == guestscope.FAULT_CALL then
            local lead = PHRASE_LENGTH
            if kind == guestscope.FAULT_INDEX then
                lead = PHRASE_INDEX
            elseif kind == guestscope.FAULT_CALL then
                lead = PHRASE_CALL
            end
            refused = appendPhrase(h, builder, lead)
                | appendPhrase(h, builder, typePhrase(culprit))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == guestscope.FAULT_KEY then
            if culprit == values.NIL then
                refused = appendPhrase(h, builder, PHRASE_KEYNIL)
            else
                refused = appendPhrase(h, builder, PHRASE_KEYNAN)
            end
        else
            refused = strings.appendWord(h, builder, 0x20656d69746e7572ULL, 8ULL)
                | strings.appendWord(h, builder, 0x726f727265ULL, 5ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            return values.NIL
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- A runtime error a library call meets (a FAULT_ kind and the operands its
-- message names), raised as a library error.
export function raiseFault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<guestscope.Services>("fault"), kind)
        native.store64(services, native.fieldOffset<guestscope.Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<guestscope.Services>("other"), other)
        local message = runtimeError(ctx)
        native.store64(services, native.fieldOffset<guestscope.Services>("fault"), 0ULL)
        guestscope.raiseLibrary(ctx, message)
    end
end
