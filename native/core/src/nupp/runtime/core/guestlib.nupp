module nupp.runtime.core.guestlib

-- Lua library functions the final core implements, reached through the
-- core-only LibCall opcode: the handler passes up to four argument values and
-- this leaf answers the result value. Unsupported forms raise rather than
-- answer something Lua would not: float text (tostring, %d of a float) and
-- format directives other than %d, %s and %%.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const strings = require("nupp.runtime.core.corestrings")
const tables = require("nupp.runtime.core.coretables")
const patterns = require("nupp.runtime.core.corepattern")
const guestscope = require("nupp.runtime.core.guestscope")
const texts = require("nupp.runtime.core.guesttexts")
const ints = require("nupp.runtime.core.coreintegers")
const os = require("nupp.runtime.vm.os")
const librarycalls = require("nupp.runtime.core.librarycalls")
const librarylayouts = require("nupp.runtime.core.librarylayouts")
const librarytexts = require("nupp.runtime.core.librarytexts")

local function integerValue(value: uint64): int64
    local payload = value & values.PAYLOAD
    if payload & 0x0000800000000000ULL ~= 0ULL then
        payload = payload | 0xffff000000000000ULL
    end

    return native.index(payload)
end

local function isInteger(value: uint64): boolean
    return value & 0xffff000000000000ULL == values.TAG_INTEGER
end

local function guestHeap(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- Appends Lua's tostring of `value`: strings as they are, integers in
-- decimal, booleans and nil by name, and tables, functions, threads and
-- userdata by type and address. A __tostring is the caller's to call.
export function appendText(h: heap.Heap*, b: strings.Builder*, value: uint64): uint64
    local s = strings.header(value)
    if s ~= 0ULL then
        return strings.appendString(h, b, s)
    end
    if ints.isInteger(value) then
        return strings.appendInteger(h, b, native.index(ints.bitsOf(value)))
    end
    -- A float as Nupp writes one (Decision 13): the shorter exact text, which
    -- the host writes whole ("5.0", "1e1").
    if value & values.QNAN ~= values.QNAN or value == values.QNAN then
        @unsafe do
            if strings.reserve(h, b, 66ULL) ~= 0ULL then
                return 1ULL
            end
            local at = b.base + b.length
            local length = os.formatNumber(value, native.pointer(at), 64ULL)
            if length < 0 or length > 64 then
                return 1ULL
            end
            b.length = b.length + native.word(length)
            return 0ULL
        end
    end
    -- "true", "false" and "nil" as little-endian byte words.
    if value == values.TRUE then
        return strings.appendWord(h, b, 0x65757274ULL, 4ULL)
    elseif value == values.FALSE then
        return strings.appendWord(h, b, 0x65736c6166ULL, 5ULL)
    elseif value == values.NIL then
        return strings.appendWord(h, b, 0x6c696eULL, 3ULL)
    end
    if guestscope.identified(value) then
        return guestscope.appendIdentity(h, b, value)
    end
    error("tostring of this value is not yet supported by the core")

    return 1ULL
end

local function tostring(ctx: voidptr, value: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        if strings.header(value) ~= 0ULL then
            return value
        end
        local builder = state as strings.Builder*
        if appendText(h, builder, value) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- An integer argument as Lua reads one: an integer, or a float with an exact
-- integer value; `absent` when the argument is nil.
export function integerArgument(ctx: voidptr, value: uint64, absent: int64, position: uint64): int64
    if value == values.NIL then
        return absent
    end
    if ints.isInteger(value) then
        return native.index(ints.bitsOf(value))
    end
    if value & values.QNAN ~= values.QNAN and ints.integralFloat(value) then
        return native.index(ints.floatToBits(value))
    end
    if value & values.QNAN ~= values.QNAN then
        texts.argumentError(ctx, position, 0ULL, librarytexts.TEXT_NO_INTEGER, value)
    end
    texts.argumentError(ctx, position, librarytexts.TEXT_NUMBER, 0ULL, value)

    return absent
end

-- A number's float bits, or NIL bits for anything else.
export function floatOf(value: uint64): uint64
    if ints.isInteger(value) then
        return ints.toFloatBits(ints.bitsOf(value))
    end
    if value & values.QNAN ~= values.QNAN or value == values.QNAN then
        return value
    end

    return values.NIL
end

-- A float result as a value: NaNs collapse to the one quiet NaN.
export function floatValue(bits: uint64): uint64
    local x = native.fromBits(bits)
    if x ~= x then
        return values.QNAN
    end

    return bits
end

-- Appends `value` in base `radix` (8, 10 or 16), as an unsigned 64-bit
-- number, upper-case digits when `upper`; at least `digits` digits.
local function appendRadix(
    h: heap.Heap*,
    b: strings.Builder*,
    value: uint64,
    radix: uint64,
    upper: boolean,
    digits: uint64
): uint64
    @unsafe do
        if strings.reserve(h, b, 72ULL + digits) ~= 0ULL then
            return 1ULL
        end
        local count: uint64 = 0ULL
        local scan = value
        while scan ~= 0ULL do
            count = count + 1ULL
            scan = scan // radix
        end
        if count < digits then
            count = digits
        end
        local at = b.length + count
        local rest = value
        while at > b.length do
            at = at - 1ULL
            local digit = rest % radix
            local ch = 48ULL + digit
            if digit >= 10ULL then
                ch = 87ULL + digit
                if upper then
                    ch = 55ULL + digit
                end
            end
            native.store8(native.pointer(b.base), native.index(at), ch)
            rest = rest // radix
        end
        b.length = b.length + count
        return 0ULL
    end
end

-- string.format: %d %i %x %X %o %c %s, the float conversions (%f %e %g %a,
-- by the host's C formatting) and %%, with Lua's flags (-, +, space, #, 0),
-- width and precision; up to three arguments after the format. %q is not
-- yet the core's.
-- Appends %q's form of string s: quoted, with `"`, `\` and newline escaped
-- and other control bytes as decimal escapes, padded to three digits when a
-- digit follows. Answers 1 when backing is refused.
local function appendQuoted(h: heap.Heap*, b: strings.Builder*, s: uint64): uint64
    local refused = strings.appendWord(h, b, 34ULL, 1ULL)
    local n = strings.length(s)
    local at = strings.bytes(s)
    local i: uint64 = 0ULL
    while i < n do
        local c = native.word(native.load8(native.pointer(at), native.index(i)))
        if c == 34ULL or c == 92ULL or c == 10ULL then
            refused = refused | strings.appendWord(h, b, 92ULL | (c << 8ULL), 2ULL)
        elseif c < 32ULL or c == 127ULL then
            local digit = false
            if i + 1ULL < n then
                local d = native.word(native.load8(native.pointer(at), native.index(i + 1ULL)))
                digit = d >= 48ULL and d <= 57ULL
            end
            refused = refused | strings.appendWord(h, b, 92ULL, 1ULL)
            if digit then
                refused = refused | appendRadix(h, b, c, 10ULL, false, 3ULL)
            else
                refused = refused | strings.appendInteger(h, b, native.index(c))
            end
        else
            refused = refused | strings.appendWord(h, b, c, 1ULL)
        end
        i = i + 1ULL
    end

    return refused | strings.appendWord(h, b, 34ULL, 1ULL)
end

-- string.format's values are a, b and c, or with `pack` that pack's.
local function format(ctx: voidptr, count: uint64, fmt: uint64, a: uint64, b: uint64, c: uint64, pack: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    local pieceState = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local f = strings.header(fmt)
        if f == 0ULL then
            texts.argumentError(ctx, 1ULL, librarytexts.TEXT_STRING, 0ULL, fmt)
        end
        local builder = state as strings.Builder*
        local piece = pieceState as strings.Builder*
        local p = strings.bytes(f)
        local finish = p + strings.length(f)
        local next: uint64 = 1ULL
        local refused: uint64 = 0ULL
        while p < finish do
            local ch = native.word(native.load8(native.pointer(p), 0))
            if ch ~= 37ULL then
                refused = refused | strings.append(h, builder, p, 1ULL)
                p = p + 1ULL
            elseif p + 1ULL < finish and native.word(native.load8(native.pointer(p + 1ULL), 0)) == 37ULL then
                refused = refused | strings.append(h, builder, p, 1ULL)
                p = p + 2ULL
            else
                local spec = p
                p = p + 1ULL
                -- Flags, then width, then precision.
                local left = false
                local plus = false
                local space = false
                local alternate = false
                local zero = false
                while p < finish do
                    local flag = native.word(native.load8(native.pointer(p), 0))
                    if flag == 45ULL then
                        left = true
                    elseif flag == 43ULL then
                        plus = true
                    elseif flag == 32ULL then
                        space = true
                    elseif flag == 35ULL then
                        alternate = true
                    elseif flag == 48ULL then
                        zero = true
                    else
                        break
                    end
                    p = p + 1ULL
                end
                local width: uint64 = 0ULL
                while p < finish
                    and native.word(native.load8(native.pointer(p), 0)) >= 48ULL
                    and native.word(native.load8(native.pointer(p), 0)) <= 57ULL do
                    width = width * 10ULL + native.word(native.load8(native.pointer(p), 0)) - 48ULL
                    p = p + 1ULL
                end
                local precise = false
                local precision: uint64 = 0ULL
                if p < finish and native.word(native.load8(native.pointer(p), 0)) == 46ULL then
                    precise = true
                    p = p + 1ULL
                    while p < finish
                        and native.word(native.load8(native.pointer(p), 0)) >= 48ULL
                        and native.word(native.load8(native.pointer(p), 0)) <= 57ULL do
                        precision = precision * 10ULL + native.word(native.load8(native.pointer(p), 0)) - 48ULL
                        p = p + 1ULL
                    end
                end
                if p >= finish or width > 99ULL or precision > 99ULL then
                    strings.release(builder)
                    strings.release(piece)
                    texts.conversionError(ctx, spec, p, finish)
                end
                local directive = native.word(native.load8(native.pointer(p), 0))
                p = p + 1ULL
                if next >= count then
                    strings.release(builder)
                    strings.release(piece)
                    texts.argumentError(ctx, next + 1ULL, 0ULL, librarytexts.TEXT_NO_VALUE, values.NIL)
                end
                local argument = a
                if pack ~= 0ULL then
                    argument = tables.get(pack, values.TAG_INTEGER | next)
                elseif next == 2ULL then
                    argument = b
                elseif next == 3ULL then
                    argument = c
                end
                next = next + 1ULL
                -- The converted text goes to `piece`; a sign or prefix is
                -- counted apart, so zero padding goes between it and the digits.
                local prefix: uint64 = 0ULL
                local numeric = true
                if directive == 100ULL or directive == 105ULL then
                    local n = integerArgument(ctx, argument, 0, next)
                    local magnitude = native.word(n)
                    if n < 0 then
                        refused = refused | strings.appendWord(h, piece, 45ULL, 1ULL)
                        magnitude = 0ULL - magnitude
                        prefix = 1ULL
                    elseif plus then
                        refused = refused | strings.appendWord(h, piece, 43ULL, 1ULL)
                        prefix = 1ULL
                    elseif space then
                        refused = refused | strings.appendWord(h, piece, 32ULL, 1ULL)
                        prefix = 1ULL
                    end
                    local digits: uint64 = 1ULL
                    if precise then
                        digits = precision
                    end
                    refused = refused | appendRadix(h, piece, magnitude, 10ULL, false, digits)
                elseif directive == 120ULL or directive == 88ULL or directive == 111ULL then
                    local n = native.word(integerArgument(ctx, argument, 0, next))
                    local radix: uint64 = 16ULL
                    if directive == 111ULL then
                        radix = 8ULL
                    end
                    if alternate and n ~= 0ULL then
                        if directive == 120ULL then
                            refused = refused | strings.appendWord(h, piece, 0x7830ULL, 2ULL)
                            prefix = 2ULL
                        elseif directive == 88ULL then
                            refused = refused | strings.appendWord(h, piece, 0x5830ULL, 2ULL)
                            prefix = 2ULL
                        else
                            refused = refused | strings.appendWord(h, piece, 48ULL, 1ULL)
                            prefix = 1ULL
                        end
                    end
                    local digits: uint64 = 1ULL
                    if precise then
                        digits = precision
                    end
                    refused = refused | appendRadix(h, piece, n, radix, directive == 88ULL, digits)
                elseif directive == 102ULL
                    or directive == 70ULL
                    or directive == 101ULL
                    or directive == 69ULL
                    or directive == 103ULL
                    or directive == 71ULL
                    or directive == 97ULL
                    or directive == 65ULL
                then
                    -- A float conversion is C's: its spec, rebuilt from what was
                    -- read, goes to the host with the number, which pads it too.
                    local bits = floatOf(argument)
                    if bits == values.NIL then
                        strings.release(builder)
                        strings.release(piece)
                        texts.argumentError(ctx, next, librarytexts.TEXT_NUMBER, 0ULL, argument)
                    end
                    refused = refused | strings.appendWord(h, piece, 37ULL, 1ULL)
                    if left then
                        refused = refused | strings.appendWord(h, piece, 45ULL, 1ULL)
                    end
                    if plus then
                        refused = refused | strings.appendWord(h, piece, 43ULL, 1ULL)
                    end
                    if space then
                        refused = refused | strings.appendWord(h, piece, 32ULL, 1ULL)
                    end
                    if alternate then
                        refused = refused | strings.appendWord(h, piece, 35ULL, 1ULL)
                    end
                    if zero then
                        refused = refused | strings.appendWord(h, piece, 48ULL, 1ULL)
                    end
                    if width > 0ULL then
                        refused = refused | strings.appendInteger(h, piece, native.index(width))
                    end
                    if precise then
                        refused = refused
                            | strings.appendWord(h, piece, 46ULL, 1ULL)
                            | strings.appendInteger(h, piece, native.index(precision))
                    end
                    refused = refused
                        | strings.appendWord(h, piece, directive, 1ULL)
                        | strings.appendWord(h, piece, 0ULL, 1ULL)
                        | strings.reserve(h, piece, 520ULL)
                    if refused == 0ULL then
                        local length = os.formatNumber(bits, native.pointer(piece.base), 512ULL | 0x8000000000000000ULL)
                        if length < 0 or length > 511 then
                            strings.release(builder)
                            strings.release(piece)
                            texts.conversionError(ctx, spec, p, finish)
                        end
                        piece.length = native.word(length)
                    end
                    numeric = false
                    width = 0ULL
                elseif directive == 99ULL then
                    numeric = false
                    refused = refused
                        | strings.appendWord(
                            h,
                            piece,
                            native.word(integerArgument(ctx, argument, 0, next)) & 255ULL,
                            1ULL
                        )
                elseif directive == 115ULL then
                    numeric = false
                    refused = refused | appendText(h, piece, argument)
                    if precise and piece.length > precision then
                        piece.length = precision
                    end
                elseif directive == 113ULL then
                    -- %q: the value as Lua source reads it back.
                    if left or plus or space or alternate or zero or width > 0ULL or precise then
                        strings.release(builder)
                        strings.release(piece)
                        texts.libraryError(ctx, librarytexts.TEXT_Q_MODIFIERS)
                    end
                    numeric = false
                    local quoted = strings.header(argument)
                    if quoted ~= 0ULL then
                        refused = refused | appendQuoted(h, piece, quoted)
                    elseif ints.isInteger(argument) then
                        local n = ints.bitsOf(argument)
                        if n == 0x8000000000000000ULL then
                            refused = refused
                                | strings.appendWord(h, piece, 0x7830ULL, 2ULL)
                                | appendRadix(h, piece, n, 16ULL, false, 1ULL)
                        else
                            refused = refused | strings.appendInteger(h, piece, native.index(n))
                        end
                    elseif floatOf(argument) ~= values.NIL then
                        -- Hexadecimal, which reads back exactly; infinities
                        -- and NaN as the expressions that make them.
                        local x = native.fromBits(argument)
                        if argument == 0x7ff0000000000000ULL then
                            refused = refused | strings.appendWord(h, piece, 0x393939396531ULL, 6ULL)
                        elseif argument == 0xfff0000000000000ULL then
                            refused = refused | strings.appendWord(h, piece, 0x3939393965312dULL, 7ULL)
                        elseif x ~= x then
                            refused = refused | strings.appendWord(h, piece, 0x29302f3028ULL, 5ULL)
                        else
                            refused = refused
                                | strings.appendWord(h, piece, 0x006125ULL, 3ULL)
                                | strings.reserve(h, piece, 520ULL)
                            if refused == 0ULL then
                                local length = os.formatNumber(
                                    argument,
                                    native.pointer(piece.base),
                                    512ULL | 0x8000000000000000ULL
                                )
                                if length < 0 or length > 511 then
                                    strings.release(builder)
                                    strings.release(piece)
                                    texts.conversionError(ctx, spec, p, finish)
                                end
                                piece.length = native.word(length)
                            end
                        end
                    elseif argument == values.NIL or argument == values.TRUE or argument == values.FALSE then
                        refused = refused | appendText(h, piece, argument)
                    else
                        strings.release(builder)
                        strings.release(piece)
                        texts.argumentError(ctx, next, 0ULL, librarytexts.TEXT_NO_LITERAL, argument)
                    end
                else
                    -- Any other directive, as Lua refuses it.
                    strings.release(builder)
                    strings.release(piece)
                    texts.conversionError(ctx, spec, p - 1ULL, finish)
                end
                -- Precision decides an integer's digits, so 0 pads only without it.
                local padZero = zero and not left and numeric and not precise
                local length = piece.length
                if not left and not padZero then
                    while width > length do
                        refused = refused | strings.appendWord(h, builder, 32ULL, 1ULL)
                        width = width - 1ULL
                    end
                end
                refused = refused | strings.append(h, builder, piece.base, prefix)
                if padZero then
                    while width > length do
                        refused = refused | strings.appendWord(h, builder, 48ULL, 1ULL)
                        width = width - 1ULL
                    end
                end
                refused = refused | strings.append(h, builder, piece.base + prefix, length - prefix)
                if left then
                    while width > length do
                        refused = refused | strings.appendWord(h, builder, 32ULL, 1ULL)
                        width = width - 1ULL
                    end
                end
                piece.length = 0ULL
            end
        end
        strings.release(piece)
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- The table library calls that run in replay (guestscope.replaybegin).
export function replays(id: uint64): boolean
    return id == librarycalls.TABLE_CONCAT
        or id == librarycalls.TABLE_INSERT
        or id == librarycalls.TABLE_REMOVE
        or id == librarycalls.TABLE_UNPACK
        or id == librarycalls.TABLE_UNPACK_ALL
        or id == librarycalls.TABLE_MOVE
        or id == librarycalls.TABLE_MOVE_PACK
        or id == librarycalls.TABLE_SORT
        or id == librarycalls.TABLE_SORT_BEGIN
        or id == librarycalls.TABLE_SORT_STEP
end

-- table.move's arguments past its first, packed: the destination is the
-- fourth of them.
const MOVE_DESTINATION: uint64 = 4ULL

-- Whether a table library call `id` with arguments a and b reaches a table
-- with a metatable: its list, or table.move's destination.
export function reachesmeta(id: uint64, a: uint64, b: uint64): boolean
    if guestscope.metatabled(a) then
        return true
    end
    -- A comparator's step reaches the list its state holds.
    local state = guestscope.tableof(a)
    if id == librarycalls.TABLE_SORT_STEP and state ~= 0ULL then
        return guestscope.metatabled(tables.get(state, values.TAG_INTEGER | native.word(librarylayouts.SORT_LIST)))
    end
    local pack = guestscope.tableof(b)
    if id == librarycalls.TABLE_MOVE_PACK and pack ~= 0ULL then
        return guestscope.metatabled(tables.get(pack, values.TAG_INTEGER | MOVE_DESTINATION))
    end

    return false
end

-- #t as the table library takes it (guestscope.leni): what __len answers
-- must be an integer, or a float with an integral value. 0 when the call
-- stopped for __len, which its caller checks first.
local function lengthof(ctx: voidptr, t: uint64): int64
    local value = guestscope.leni(ctx, t)
    if guestscope.suspended(ctx) then
        return 0
    end
    if ints.isInteger(value) then
        return native.index(ints.bitsOf(value))
    end
    if value & values.QNAN ~= values.QNAN and ints.integralFloat(value) then
        return native.index(ints.floatToBits(value))
    end
    texts.libraryError(ctx, librarytexts.TEXT_LENGTH_INTEGER)

    return 0
end

-- table.concat(t, sep) over t[1..#t], whose elements are strings or numbers.
local function concat(ctx: voidptr, count: uint64, list: uint64, separator: uint64, first: uint64, last: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        if list & values.TAG_MASK ~= values.TAG_OBJ then
            texts.argumentError(ctx, 1ULL, librarytexts.TEXT_TABLE, 0ULL, list)
        end
        local t = list & values.PAYLOAD
        -- Lua takes the length first, whether or not j is given.
        local size = lengthof(ctx, t)
        if guestscope.suspended(ctx) then
            return values.NIL
        end
        local sep: uint64 = 0ULL
        if count >= 2ULL and separator ~= values.NIL then
            sep = strings.header(separator)
            if sep == 0ULL then
                texts.argumentError(ctx, 2ULL, librarytexts.TEXT_STRING, 0ULL, separator)
            end
        end
        local builder = state as strings.Builder*
        -- t[i] to t[j], 1 and #t by default; strings and numbers only.
        local i = integerArgument(ctx, first, 1, 3ULL)
        local j = integerArgument(ctx, last, size, 4ULL)
        while i <= j do
            local item = guestscope.geti(ctx, t, i)
            if guestscope.suspended(ctx) then
                strings.release(builder)
                return values.NIL
            end
            if strings.header(item) == 0ULL and floatOf(item) == values.NIL then
                strings.release(builder)
                texts.concatError(ctx, item, i)
            end
            appendText(h, builder, item)
            if i < j and sep ~= 0ULL then
                strings.appendString(h, builder, sep)
            end
            i = i + 1
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- One step of `for ... in s:gmatch(p)`, over a state table {s, p, src, last}
-- with byte offsets: finds the next match as lstrlib's gmatch_aux does and
-- stores its captures (or the whole match) from key 5. Answers true or false.
local function gmatchNext(ctx: voidptr, stateValue: uint64): uint64
    local ms0 = new patterns.MatchState(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local state = stateValue & values.PAYLOAD
        local s = strings.header(tables.get(state, values.TAG_INTEGER | librarylayouts.GMATCH_SUBJECT))
        local p = strings.header(tables.get(state, values.TAG_INTEGER | librarylayouts.GMATCH_PATTERN))
        if s == 0ULL or p == 0ULL then
            error("bad argument to 'gmatch' (string expected)")
        end
        local src = native.word(integerValue(tables.get(state, values.TAG_INTEGER | librarylayouts.GMATCH_SOURCE)))
        local last = tables.get(state, values.TAG_INTEGER | librarylayouts.GMATCH_LAST)
        local ms = ms0 as patterns.MatchState*
        local subject = strings.bytes(s)
        local pattern = strings.bytes(p)
        if patterns.prepare(h, ms, subject, strings.length(s), pattern + strings.length(p)) ~= 0ULL then
            patterns.release(ms)
            error("not enough memory")
        end
        local at = subject + src
        local finish = subject + strings.length(s)
        local answer = values.FALSE
        while at <= finish do
            local e = patterns.match(h, ms, at, pattern)
            if e ~= 0ULL and (last == values.NIL or e ~= subject + native.word(integerValue(last))) then
                tables.set(h, state, values.TAG_INTEGER | librarylayouts.GMATCH_SOURCE, values.TAG_INTEGER | (e - subject))
                tables.set(h, state, values.TAG_INTEGER | librarylayouts.GMATCH_LAST, values.TAG_INTEGER | (e - subject))
                local captures = patterns.level(ms)
                if captures == 0ULL then
                    tables.set(h, state, values.TAG_INTEGER | librarylayouts.GMATCH_CAPTURES, values.TAG_OBJ | strings.make(h, at, e - at))
                end
                local i: uint64 = 0ULL
                while i < captures do
                    local start = patterns.captureStart(ms, i)
                    local size = patterns.captureSize(ms, i)
                    local value = values.TAG_INTEGER | (start - subject + 1ULL)
                    if size ~= patterns.POSITION then
                        value = values.TAG_OBJ | strings.make(h, start, size)
                    end
                    tables.set(h, state, values.TAG_INTEGER | (librarylayouts.GMATCH_CAPTURES + i), value)
                    i = i + 1ULL
                end
                answer = values.TRUE
                break
            end
            at = at + 1ULL
        end
        patterns.release(ms)
        if answer == values.FALSE then
            tables.set(h, state, values.TAG_INTEGER | librarylayouts.GMATCH_SOURCE, values.TAG_INTEGER | (strings.length(s) + 1ULL))
        end

        return answer
    end
end

-- a .. b over strings and numbers.
local function concat2(ctx: voidptr, a: uint64, b: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if strings.header(a) == 0ULL and not ints.isInteger(a)
            or strings.header(b) == 0ULL and not ints.isInteger(b)
        then
            error("attempt to concatenate a value the core cannot yet convert")
        end
        appendText(h, builder, a)
        appendText(h, builder, b)
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- Lua's unary minus of a number: integers wrap, floats change sign.
local function negate(ctx: voidptr, a: uint64): uint64
    if ints.isInteger(a) then
        return guestscope.integer(ctx, 0ULL - ints.bitsOf(a))
    end
    local x = floatOf(a)
    if x == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, a)
    end

    -- Times -1.0 (its bits, since a leaf has no unary minus), as Lua negates.

    return floatValue(native.bits(native.fromBits(x) * native.fromBits(0xbff0000000000000ULL)))
end

local function isFloat(value: uint64): boolean
    return value & values.QNAN ~= values.QNAN or value == values.QNAN
end

-- The number a math function takes, raising as Lua does for anything else.
export function numberArgument(ctx: voidptr, value: uint64, position: uint64): uint64
    if not ints.isInteger(value) and not isFloat(value) then
        texts.argumentError(ctx, position, librarytexts.TEXT_NUMBER, 0ULL, value)
    end

    return value
end

-- An integral float as the integer it equals when one does, else nil.
local function integral(ctx: voidptr, value: uint64): uint64
    if ints.isInteger(value) then
        return value
    end
    if isFloat(value) and ints.integralFloat(value) then
        return guestscope.integer(ctx, ints.floatToBits(value))
    end

    return values.NIL
end

-- math.abs: integers wrap at the minimum, as Lua's do.
local function mathAbs(ctx: voidptr, a: uint64): uint64
    numberArgument(ctx, a, 1ULL)
    if ints.isInteger(a) then
        local bits = ints.bitsOf(a)
        if bits >> 63ULL == 1ULL then
            return guestscope.integer(ctx, 0ULL - bits)
        end
        return a
    end

    return floatValue(a & 0x7fffffffffffffffULL)
end

-- math.ceil: an integer when the result fits one, else the float.
local function mathCeil(ctx: voidptr, a: uint64): uint64
    numberArgument(ctx, a, 1ULL)
    if ints.isInteger(a) then
        return a
    end
    local minusOne = native.fromBits(0xbff0000000000000ULL)
    local ceiled = floatValue(native.bits(native.floor(native.fromBits(a) * minusOne) * minusOne))
    local exact = integral(ctx, ceiled)
    if exact ~= values.NIL then
        return exact
    end

    return ceiled
end

-- a < b for two numbers: exact between integers, through floats otherwise.
local function numberLess(a: uint64, b: uint64): boolean
    if ints.isInteger(a) and ints.isInteger(b) then
        return native.index(ints.bitsOf(a)) < native.index(ints.bitsOf(b))
    end

    return native.fromBits(floatOf(a)) < native.fromBits(floatOf(b))
end

-- math.max and math.min over one to four numbers: the first extreme one, as
-- given (an integer stays one).
local function mathExtreme(
    ctx: voidptr,
    count: uint64,
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    largest: boolean
): uint64
    if count == 0ULL then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_NUMBER, 0ULL, values.NIL)
    end
    local best = numberArgument(ctx, a, 1ULL)
    local i: uint64 = 2ULL
    while i <= count do
        local next = b
        if i == 3ULL then
            next = c
        elseif i == 4ULL then
            next = d
        end
        numberArgument(ctx, next, i)
        if largest and numberLess(best, next) or not largest and numberLess(next, best) then
            best = next
        end
        i = i + 1ULL
    end

    return best
end

-- math.type: "integer", "float", or nil for anything else.
local function mathType(ctx: voidptr, a: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        if not ints.isInteger(a) and not isFloat(a) then
            return values.NIL
        end
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if ints.isInteger(a) then
            refused = strings.appendWord(h, builder, 0x72656765746e69ULL, 7ULL)
        else
            refused = strings.appendWord(h, builder, 0x74616f6c66ULL, 5ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- Lua's /: always float.
local function divide(ctx: voidptr, a: uint64, b: uint64): uint64
    local x = floatOf(a)
    local y = floatOf(b)
    if x == values.NIL or y == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return floatValue(native.bits(native.fromBits(x) / native.fromBits(y)))
end

-- Lua's //: floor division, integer for integers (raising for zero) and
-- float otherwise.
local function floorDivide(ctx: voidptr, a: uint64, b: uint64): uint64
    if ints.isInteger(a) and ints.isInteger(b) then
        local x = native.index(ints.bitsOf(a))
        local y = native.index(ints.bitsOf(b))
        if y == 0 then
            texts.libraryError(ctx, librarytexts.TEXT_IDIV_ZERO)
        end
        if y == -1 then
            return guestscope.integer(ctx, 0ULL - native.word(x))
        end
        return guestscope.integer(ctx, native.word(x // y))
    end
    local x = floatOf(a)
    local y = floatOf(b)
    if x == values.NIL or y == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return floatValue(native.bits(native.floor(native.fromBits(x) / native.fromBits(y))))
end

-- One step of `for k, v in pairs(t)` over a state table {t, key, k, v}:
-- advances key and stores the pair at 3 and 4. Answers true or false.
local function nextStep(ctx: voidptr, stateValue: uint64): uint64
    @unsafe do
        local h = guestHeap(ctx)
        local state = stateValue & values.PAYLOAD
        local subject = tables.get(state, values.TAG_INTEGER | librarylayouts.PAIRS_TABLE)
        if subject & values.TAG_MASK ~= values.TAG_OBJ then
            error("bad argument #1 to 'for iterator' (table expected)")
        end
        local t = subject & values.PAYLOAD
        -- A record instance's fields go by name (guestscope.slotname).
        local after = guestscope.slotkey(ctx, t, tables.get(state, values.TAG_INTEGER | librarylayouts.PAIRS_AFTER))
        local key = tables.nextKey(t, after)
        if key == values.TRUE then
            texts.libraryError(ctx, librarytexts.TEXT_NEXT_KEY)
        end
        if key == values.NIL then
            return values.FALSE
        end
        local name = guestscope.slotname(ctx, t, key)
        tables.set(h, state, values.TAG_INTEGER | librarylayouts.PAIRS_AFTER, name)
        tables.set(h, state, values.TAG_INTEGER | librarylayouts.PAIRS_KEY, name)
        tables.set(h, state, values.TAG_INTEGER | librarylayouts.PAIRS_VALUE, tables.get(t, key))
        return values.TRUE
    end
end

local function space(c: uint64): boolean
    return c == 32ULL or (c >= 9ULL and c <= 13ULL)
end

local function hexDigit(c: uint64): uint64
    if c >= 48ULL and c <= 57ULL then
        return c - 48ULL
    elseif c >= 97ULL and c <= 102ULL then
        return c - 87ULL
    elseif c >= 65ULL and c <= 70ULL then
        return c - 55ULL
    end

    return 16ULL
end

-- Lua's tonumber: numbers as they are; strings by l_str2int (optional sign,
-- decimal or wrapping hexadecimal, surrounding space); nil for any other
-- value or text that is not a numeral. Other text, a decimal past int64
-- included, is read as a float by C's strtod through the host.
export function tonumber(ctx: voidptr, value: uint64): uint64
    local cell = new strings.Builder(0ULL, 0ULL, 0ULL)
    if ints.isInteger(value) or floatOf(value) ~= values.NIL then
        return value
    end
    local s = strings.header(value)
    if s == 0ULL then
        if value == values.NIL then
            texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_VALUE_EXPECTED, values.NIL)
        end
        return values.NIL
    end
    @unsafe do
        local p = strings.bytes(s)
        local finish = p + strings.length(s)
        while p < finish and space(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        local negative = false
        if p < finish and native.word(native.load8(native.pointer(p), 0)) == 45ULL then
            negative = true
            p = p + 1ULL
        end
        local bits: uint64 = 0ULL
        local digits: uint64 = 0ULL
        local overflow = false
        local hex = p + 1ULL < finish
            and native.word(native.load8(native.pointer(p), 0)) == 48ULL
            and (native.word(native.load8(native.pointer(p), 1)) | 32ULL) == 120ULL
        if hex then
            p = p + 2ULL
            while p < finish and hexDigit(native.word(native.load8(native.pointer(p), 0))) < 16ULL do
                bits = bits * 16ULL + hexDigit(native.word(native.load8(native.pointer(p), 0)))
                digits = digits + 1ULL
                p = p + 1ULL
            end
        else
            while p < finish do
                local c = native.word(native.load8(native.pointer(p), 0))
                if c < 48ULL or c > 57ULL then
                    break
                end
                local d = c - 48ULL
                -- Past 2^63 - 1 (2^63 when negative) is a float numeral.
                local last: uint64 = 7ULL
                if negative then
                    last = 8ULL
                end
                if bits > 922337203685477580ULL or (bits == 922337203685477580ULL and d > last) then
                    overflow = true
                end
                bits = bits * 10ULL + d
                digits = digits + 1ULL
                p = p + 1ULL
            end
        end
        local numeral = digits > 0ULL and not overflow
        while p < finish and space(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        if numeral and p == finish then
            if negative then
                bits = 0ULL - bits
            end
            return ints.make(guestHeap(ctx), bits)
        end
        -- Otherwise a float numeral by C's strtod, as Lua's l_str2d reads one;
        -- like it, text holding an n or N (inf, nan) is refused first.
        local q = strings.bytes(s)
        while q < finish do
            if native.word(native.load8(native.pointer(q), 0)) | 32ULL == 110ULL then
                return values.NIL
            end
            q = q + 1ULL
        end
        -- The bits land in a builder's word backing.
        local slot = cell as strings.Builder*
        if strings.reserve(guestHeap(ctx), slot, 8ULL) ~= 0ULL then
            error("not enough memory")
        end
        local parsed = os.parseNumber(native.pointer(strings.bytes(s)), strings.length(s), native.pointer(slot.base))
        local bits = native.load64(native.pointer(slot.base), 0)
        strings.release(slot)
        if parsed ~= 1 then
            return values.NIL
        end

        return floatValue(bits)
    end
end

-- os.getenv: the variable's value as a string, nil when it is unset. The
-- value is copied into a builder sized by a first call, then once more if it
-- did not fit.
local function getenv(ctx: voidptr, name: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    local s = strings.header(name)
    if s == 0ULL then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_STRING, 0ULL, name)
    end
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if strings.reserve(h, builder, 256ULL) ~= 0ULL then
            error("not enough memory")
        end
        local length = os.environment(
            native.pointer(strings.bytes(s)),
            strings.length(s),
            native.pointer(builder.base),
            builder.capacity
        )
        if length < 0 then
            strings.release(builder)
            return values.NIL
        end
        if native.word(length) > builder.capacity then
            if strings.reserve(h, builder, native.word(length)) ~= 0ULL then
                strings.release(builder)
                error("not enough memory")
            end
            length = os.environment(
                native.pointer(strings.bytes(s)),
                strings.length(s),
                native.pointer(builder.base),
                builder.capacity
            )
            if length < 0 or native.word(length) > builder.capacity then
                strings.release(builder)
                error("os.getenv: the environment changed while it was read")
            end
        end
        builder.length = native.word(length)
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- The string header of an argument, raising when it is not a string.
local function stringArgument(ctx: voidptr, value: uint64, position: uint64): uint64
    local s = strings.header(value)
    -- A number is its text, as Lua's string arguments take one.
    if s == 0ULL and (ints.isInteger(value) or floatOf(value) ~= values.NIL) then
        s = strings.header(tostring(ctx, value))
    end
    if s == 0ULL then
        texts.argumentError(ctx, position, librarytexts.TEXT_STRING, 0ULL, value)
    end

    return s
end

-- Lua's posrelatI: a start position, negative counting from the end.
local function startPosition(i: int64, length: int64): int64
    if i > 0 then
        return i
    elseif i == 0 then
        return 1
    elseif i < 0 - length then
        return 1
    end

    return length + i + 1
end

-- Lua's getendpos: an end position clamped to the string.
local function endPosition(j: int64, length: int64): int64
    if j > length then
        return length
    elseif j >= 0 then
        return j
    elseif j < 0 - length then
        return 0
    end

    return length + j + 1
end

-- string.sub(s, i [, j]).
local function sub(ctx: voidptr, value: uint64, a: uint64, b: uint64): uint64
    @unsafe do
        local s = stringArgument(ctx, value, 1ULL)
        local length = native.index(strings.length(s))
        local i = startPosition(integerArgument(ctx, a, 1, 2ULL), length)
        local j = endPosition(integerArgument(ctx, b, -1, 3ULL), length)
        if i > j then
            return values.TAG_OBJ | guestscope.makeString(ctx, strings.bytes(s), 0ULL)
        end
        return values.TAG_OBJ
            | guestscope.makeString(ctx, strings.bytes(s) + native.word(i - 1), native.word(j - i + 1))
    end
end

-- Stores the `index`-th value of a pack under construction.
local function packPut(h: heap.Heap*, pack: uint64, index: uint64, value: uint64): nil
    if value ~= values.NIL and tables.set(h, pack, values.TAG_INTEGER | index, value) == tables.NO_MEMORY then
        error("not enough memory")
    end
end

-- A finished pack of `n` values; with no pack, `single` is the answer.
local function packed(h: heap.Heap*, pack: uint64, n: uint64, single: uint64): uint64
    if pack == 0ULL then
        return single
    end
    if tables.set(h, pack, values.TAG_INTEGER, values.TAG_INTEGER | n) == tables.NO_MEMORY then
        error("not enough memory")
    end
    tables.drain(h)

    return values.TAG_OBJ | pack
end

-- string.byte(s [, i [, j]]): the bytes i..j as integers. Alone, the first
-- of them, nil when there is none; with `all`, every one in a pack.
local function bytes(ctx: voidptr, value: uint64, a: uint64, b: uint64, all: boolean): uint64
    @unsafe do
        local pack: uint64 = 0ULL
        if all then
            -- Held while the strings it is given are made.
            pack = guestscope.newTable(ctx)
            guestscope.hold(ctx, values.TAG_OBJ | pack)
        end
        local h = guestHeap(ctx)
        local s = stringArgument(ctx, value, 1ULL)
        local length = native.index(strings.length(s))
        local i = startPosition(integerArgument(ctx, a, 1, 2ULL), length)
        local j = endPosition(integerArgument(ctx, b, i, 3ULL), length)
        if i > j then
            return packed(h, pack, 0ULL, values.NIL)
        end
        local first = values.TAG_INTEGER
            | native.word(native.load8(native.pointer(strings.bytes(s)), native.index(native.word(i - 1))))
        if pack == 0ULL then
            return first
        end
        local k = i
        while k <= j do
            packPut(
                h,
                pack,
                native.word(k - i + 1),
                values.TAG_INTEGER
                | native.word(native.load8(native.pointer(strings.bytes(s)), native.index(native.word(k - 1))))
            )
            k = k + 1
        end
        return packed(h, pack, native.word(j - i + 1), first)
    end
end

-- string.char(n): one byte, 0 to 255.
local function char(ctx: voidptr, a: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local n = integerArgument(ctx, a, -1, 1ULL)
        if n < 0 or n > 255 then
            texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_VALUE_RANGE, a)
        end
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if strings.appendWord(h, builder, native.word(n), 1ULL) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- string.rep(s, n): n copies, empty for n <= 0.
local function rep(ctx: voidptr, value: uint64, a: uint64, separator: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local s = stringArgument(ctx, value, 1ULL)
        local n = integerArgument(ctx, a, 0, 2ULL)
        -- The separator goes between copies.
        local sep: uint64 = 0ULL
        if separator ~= values.NIL then
            sep = stringArgument(ctx, separator, 3ULL)
        end
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local each = strings.length(s)
        if sep ~= 0ULL then
            each = each + strings.length(sep)
        end
        if n > 0 and (native.word(n) > 0x40000000ULL or native.word(n) * each > 0x40000000ULL) then
            texts.libraryError(ctx, librarytexts.TEXT_TOO_LARGE)
        end
        local i: int64 = 0
        while i < n do
            if i > 0 and sep ~= 0ULL and strings.appendString(h, builder, sep) ~= 0ULL then
                strings.release(builder)
                error("not enough memory")
            end
            if strings.appendString(h, builder, s) ~= 0ULL then
                strings.release(builder)
                error("not enough memory")
            end
            i = i + 1
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- string.reverse(s): its bytes in reverse order.
local function reverse(ctx: voidptr, value: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local s = stringArgument(ctx, value, 1ULL)
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local at = strings.bytes(s)
        local i = strings.length(s)
        while i > 0ULL do
            i = i - 1ULL
            if strings.appendWord(
                h,
                builder,
                native.word(native.load8(native.pointer(at), native.index(i))),
                1ULL
            ) ~= 0ULL then
                strings.release(builder)
                error("not enough memory")
            end
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- string.upper and string.lower over ASCII, as the C locale maps them.
local function casing(ctx: voidptr, value: uint64, upper: boolean): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local s = stringArgument(ctx, value, 1ULL)
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if strings.appendString(h, builder, s) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local i: uint64 = 0ULL
        while i < builder.length do
            local c = native.word(native.load8(native.pointer(builder.base), native.index(i)))
            if upper and c >= 97ULL and c <= 122ULL then
                native.store8(native.pointer(builder.base), native.index(i), c - 32ULL)
            elseif not upper and c >= 65ULL and c <= 90ULL then
                native.store8(native.pointer(builder.base), native.index(i), c + 32ULL)
            end
            i = i + 1ULL
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- True when a pattern has none of Lua's special characters, so find can
-- search for it as plain text.
local function plainPattern(p: uint64): boolean
    @unsafe do
        local i: uint64 = 0ULL
        while i < strings.length(p) do
            local c = native.word(native.load8(native.pointer(strings.bytes(p)), native.index(i)))
            if c == 94ULL or c == 36ULL or c == 42ULL or c == 43ULL or c == 63ULL or c == 46ULL then
                return false
            end
            if c == 40ULL or c == 91ULL or c == 37ULL or c == 45ULL then
                return false
            end
            i = i + 1ULL
        end
        return true
    end
end

-- Capture `i` of a match: its text, or its position for `()`.
local function capture(h: heap.Heap*, ms: patterns.MatchState*, subject: uint64, i: uint64): uint64
    local start = patterns.captureStart(ms, i)
    local size = patterns.captureSize(ms, i)
    if size == patterns.POSITION then
        return values.TAG_INTEGER | (start - subject + 1ULL)
    end

    return values.TAG_OBJ | strings.make(h, start, size)
end

-- string.find (start position) and string.match (first capture, or the whole
-- match) from `init`; nil when nothing matches. In a single-value context
-- these are Lua's answers. With `all`, every result in a pack: find's start,
-- end and captures, match's captures or the whole match, or one nil.
local function search(
    ctx: voidptr,
    value: uint64,
    pv: uint64,
    a: uint64,
    plainFlag: uint64,
    matching: boolean,
    all: boolean
): uint64
    local ms0 = new patterns.MatchState(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        local pack: uint64 = 0ULL
        if all then
            -- Held while the strings it is given are made.
            pack = guestscope.newTable(ctx)
            guestscope.hold(ctx, values.TAG_OBJ | pack)
        end
        local h = guestHeap(ctx)
        local s = stringArgument(ctx, value, 1ULL)
        local p = stringArgument(ctx, pv, 2ULL)
        local length = native.index(strings.length(s))
        local init = startPosition(integerArgument(ctx, a, 1, 3ULL), length)
        if init > length + 1 then
            return packed(h, pack, 1ULL, values.NIL)
        end
        local subject = strings.bytes(s)
        local pattern = strings.bytes(p)
        local pEnd = pattern + strings.length(p)
        local plain = plainFlag ~= values.NIL and plainFlag ~= values.FALSE
        if not matching and (plain or plainPattern(p)) then
            -- A plain search: the first position the pattern's bytes occur.
            local at = subject + native.word(init - 1)
            local finish = subject + strings.length(s)
            while at + strings.length(p) <= finish do
                local k: uint64 = 0ULL
                while k < strings.length(p)
                    and native.load8(
                        native.pointer(at),
                        native.index(k)
                    ) == native.load8(native.pointer(pattern), native.index(k)) do
                    k = k + 1ULL
                end
                if k == strings.length(p) then
                    local start = values.TAG_INTEGER | (at - subject + 1ULL)
                    if pack ~= 0ULL then
                        packPut(h, pack, 1ULL, start)
                        packPut(h, pack, 2ULL, values.TAG_INTEGER | (at - subject + strings.length(p)))
                    end
                    return packed(h, pack, 2ULL, start)
                end
                at = at + 1ULL
            end
            return packed(h, pack, 1ULL, values.NIL)
        end
        local anchor = strings.length(p) > 0ULL and native.word(native.load8(native.pointer(pattern), 0)) == 94ULL
        if anchor then
            pattern = pattern + 1ULL
        end
        local ms = ms0 as patterns.MatchState*
        if patterns.prepare(h, ms, subject, strings.length(s), pEnd) ~= 0ULL then
            patterns.release(ms)
            error("not enough memory")
        end
        local at = subject + native.word(init - 1)
        local finish = subject + strings.length(s)
        local answer = values.NIL
        local n: uint64 = 1ULL
        while at <= finish do
            local e = patterns.match(h, ms, at, pattern)
            if e ~= 0ULL then
                if pack ~= 0ULL then
                    n = 0ULL
                    if not matching then
                        packPut(h, pack, 1ULL, values.TAG_INTEGER | (at - subject + 1ULL))
                        packPut(h, pack, 2ULL, values.TAG_INTEGER | (e - subject))
                        n = 2ULL
                    elseif patterns.level(ms) == 0ULL then
                        packPut(h, pack, 1ULL, values.TAG_OBJ | strings.make(h, at, e - at))
                        n = 1ULL
                    end
                    local i: uint64 = 0ULL
                    while i < patterns.level(ms) do
                        n = n + 1ULL
                        packPut(h, pack, n, capture(h, ms, subject, i))
                        i = i + 1ULL
                    end
                elseif not matching then
                    answer = values.TAG_INTEGER | (at - subject + 1ULL)
                elseif patterns.level(ms) == 0ULL then
                    answer = values.TAG_OBJ | strings.make(h, at, e - at)
                else
                    answer = capture(h, ms, subject, 0ULL)
                end
                break
            end
            if anchor then
                break
            end
            at = at + 1ULL
        end
        patterns.release(ms)
        tables.drain(h)

        return packed(h, pack, n, answer)
    end
end

-- The heap kind of an object value, or 0 for an immediate.
local function objectKind(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    @unsafe do
        return native.word(
            native.load8(native.pointer(value & values.PAYLOAD), native.fieldOffset<heap.Header>("kind"))
        )
    end
end

-- Capture `l` of a match of [at, e) as a replacement names it: the whole
-- match when the pattern has no captures and `l` is 0.
local function replacementCapture(
    ctx: voidptr,
    ms: patterns.MatchState*,
    subject: uint64,
    l: uint64,
    at: uint64,
    e: uint64
): uint64
    local h = guestHeap(ctx)
    if l >= patterns.level(ms) then
        if l ~= 0ULL then
            texts.indexedError(ctx, librarytexts.TEXT_CAPTURE_INDEX, native.index(l + 1ULL), 0ULL)
        end
        @unsafe do
            return values.TAG_OBJ | strings.make(h, at, e - at)
        end
    end
    if patterns.captureSize(ms, l) == patterns.UNFINISHED then
        texts.libraryError(ctx, librarytexts.TEXT_UNFINISHED)
    end

    return capture(h, ms, subject, l)
end

-- Appends gsub's replacement for a match of [at, e): a string's bytes with
-- %0 the whole match, %1 to %9 a capture and %% a percent sign; for a
-- table, its value at the first capture, the match itself when that is
-- false or nil. Answers 1 when backing is refused.
local function appendReplacement(
    ctx: voidptr,
    b: strings.Builder*,
    ms: patterns.MatchState*,
    subject: uint64,
    replValue: uint64,
    at: uint64,
    e: uint64
): uint64
    @unsafe do
        local h = guestHeap(ctx)
        if objectKind(replValue) == heap.KIND_TABLE then
            local key = replacementCapture(ctx, ms, subject, 0ULL, at, e)
            local value = tables.lookup(h, replValue & values.PAYLOAD, key)
            if value == values.NIL or value == values.FALSE then
                return strings.append(h, b, at, e - at)
            end
            if strings.header(value) == 0ULL and not ints.isInteger(value) and value & values.QNAN == values.QNAN then
                texts.replacementError(ctx, value)
            end
            return appendText(h, b, value)
        end
        local repl = strings.header(replValue)
        local r = strings.bytes(repl)
        local n = strings.length(repl)
        local i: uint64 = 0ULL
        while i < n do
            local c = native.word(native.load8(native.pointer(r), native.index(i)))
            if c ~= 37ULL then
                if strings.appendWord(h, b, c, 1ULL) ~= 0ULL then
                    return 1ULL
                end
            else
                i = i + 1ULL
                local d: uint64 = 0ULL
                if i < n then
                    d = native.word(native.load8(native.pointer(r), native.index(i)))
                end
                if d == 37ULL then
                    if strings.appendWord(h, b, 37ULL, 1ULL) ~= 0ULL then
                        return 1ULL
                    end
                elseif d == 48ULL then
                    if strings.append(h, b, at, e - at) ~= 0ULL then
                        return 1ULL
                    end
                elseif d >= 49ULL and d <= 57ULL then
                    if appendText(h, b, replacementCapture(ctx, ms, subject, d - 49ULL, at, e)) ~= 0ULL then
                        return 1ULL
                    end
                else
                    texts.libraryError(ctx, librarytexts.TEXT_PERCENT_USE)
                end
            end
            i = i + 1ULL
        end
        return 0ULL
    end
end

-- string.gsub(s, pattern, repl [, n]) with a string, number or table
-- replacement: the new string, and with `all` a pack of it and the count.
local function gsub(ctx: voidptr, value: uint64, pv: uint64, replValue: uint64, maxValue: uint64, all: boolean): uint64
    local ms0 = new patterns.MatchState(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local pack: uint64 = 0ULL
        if all then
            -- Held while the strings it is given are made.
            pack = guestscope.newTable(ctx)
            guestscope.hold(ctx, values.TAG_OBJ | pack)
        end
        local h = guestHeap(ctx)
        local s = stringArgument(ctx, value, 1ULL)
        local p = stringArgument(ctx, pv, 2ULL)
        -- A number replacement is its text; a table is read per match.
        local repl = replValue
        local kind = objectKind(replValue)
        if strings.header(replValue) ~= 0ULL or ints.isInteger(replValue) or replValue & values.QNAN ~= values.QNAN then
            repl = tostring(ctx, replValue)
        elseif kind == heap.KIND_TABLE then
            repl = replValue
        elseif kind == heap.KIND_CLOSURE then
            error("gsub with a function replacement is not yet supported by the core")
        else
            texts.argumentError(ctx, 3ULL, librarytexts.TEXT_REPLACEMENT_KINDS, 0ULL, replValue)
        end
        local length = native.index(strings.length(s))
        local limit = integerArgument(ctx, maxValue, length + 1, 4ULL)
        local subject = strings.bytes(s)
        local pattern = strings.bytes(p)
        local pEnd = pattern + strings.length(p)
        local anchor = strings.length(p) > 0ULL and native.word(native.load8(native.pointer(pattern), 0)) == 94ULL
        if anchor then
            pattern = pattern + 1ULL
        end
        local ms = ms0 as patterns.MatchState*
        local builder = state as strings.Builder*
        if patterns.prepare(h, ms, subject, strings.length(s), pEnd) ~= 0ULL then
            patterns.release(ms)
            error("not enough memory")
        end
        local src = subject
        local finish = subject + strings.length(s)
        local last: uint64 = 0ULL
        local n: int64 = 0
        local refused: uint64 = 0ULL
        while n < limit do
            local e = patterns.match(h, ms, src, pattern)
            if e ~= 0ULL and e ~= last then
                n = n + 1
                refused = refused | appendReplacement(ctx, builder, ms, subject, repl, src, e)
                src = e
                last = e
            elseif src < finish then
                refused = refused | strings.append(h, builder, src, 1ULL)
                src = src + 1ULL
            else
                break
            end
            if anchor then
                break
            end
        end
        refused = refused | strings.append(h, builder, src, finish - src)
        patterns.release(ms)
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local result = values.TAG_OBJ | strings.finish(h, builder)
        if pack ~= 0ULL then
            packPut(h, pack, 1ULL, result)
            packPut(h, pack, 2ULL, values.TAG_INTEGER | native.word(n))
        end
        tables.drain(h)

        return packed(h, pack, 2ULL, result)
    end
end

-- The table a library argument names, raising as Lua does when it is not one.
local function tableArgument(ctx: voidptr, value: uint64, position: uint64): uint64
    if objectKind(value) ~= heap.KIND_TABLE then
        texts.argumentError(ctx, position, librarytexts.TEXT_TABLE, 0ULL, value)
    end

    return value & values.PAYLOAD
end

local function storeAt(h: heap.Heap*, t: uint64, index: int64, value: uint64): nil
    if tables.set(h, t, values.TAG_INTEGER | native.word(index), value) == tables.NO_MEMORY then
        error("not enough memory")
    end
end

local function loadAt(t: uint64, index: int64): uint64
    return tables.get(t, values.TAG_INTEGER | native.word(index))
end

-- A table library call that writes to `t` raises when it is frozen
-- (runtime Decision 16), as Luau's do, before it writes anything.
local function writable(ctx: voidptr, t: uint64): nil
    if tables.frozen(t) then
        guestscope.readonly(ctx)
    end
end

-- table.freeze(t): t, frozen shallowly and for good. A frozen t, or one whose
-- metatable is protected, raises, as Luau's does.
local function tableFreeze(ctx: voidptr, list: uint64): uint64
    local t = tableArgument(ctx, list, 1ULL)
    if tables.frozen(t) then
        texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_ALREADY_FROZEN, list)
    end
    if guestscope.metaField(ctx, t, guestscope.META_METATABLE) ~= values.NIL then
        texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_PROTECTED_TABLE, list)
    end
    tables.freeze(guestHeap(ctx), t)

    return list
end

-- table.isfrozen(t): whether t is frozen.
local function tableIsfrozen(ctx: voidptr, list: uint64): uint64
    if tables.frozen(tableArgument(ctx, list, 1ULL)) then
        return values.TRUE
    end

    return values.FALSE
end

-- table.insert(t, v) appends; table.insert(t, pos, v) moves t[pos..#t] up
-- one first, through the table's __index and __newindex.
local function tableInsert(ctx: voidptr, count: uint64, list: uint64, a: uint64, b: uint64): uint64
    @unsafe do
        local h = guestHeap(ctx)
        local t = tableArgument(ctx, list, 1ULL)
        local size = lengthof(ctx, t)
        if guestscope.suspended(ctx) then
            return values.NIL
        end
        if count == 2ULL then
            writable(ctx, t)
            guestscope.seti(ctx, t, size + 1, a)
            tables.drain(h)
            return values.NIL
        end
        local pos = integerArgument(ctx, a, 0, 2ULL)
        if pos < 1 or pos > size + 1 then
            texts.argumentError(ctx, 2ULL, 0ULL, librarytexts.TEXT_OUT_OF_BOUNDS, a)
        end
        writable(ctx, t)
        local at = size + 1
        while at > pos and not guestscope.suspended(ctx) do
            guestscope.seti(ctx, t, at, guestscope.geti(ctx, t, at - 1))
            at = at - 1
        end
        guestscope.seti(ctx, t, pos, b)
        tables.drain(h)
        return values.NIL
    end
end

-- table.remove(t [, pos]): removes t[pos] (the last by default), moving the
-- rest down, and answers it.
local function tableRemove(ctx: voidptr, count: uint64, list: uint64, a: uint64): uint64
    @unsafe do
        local h = guestHeap(ctx)
        local t = tableArgument(ctx, list, 1ULL)
        local size = lengthof(ctx, t)
        if guestscope.suspended(ctx) then
            return values.NIL
        end
        local pos = size
        if count >= 2ULL then
            pos = integerArgument(ctx, a, size, 2ULL)
            if pos ~= size and (pos < 1 or pos > size + 1) then
                texts.argumentError(ctx, 2ULL, 0ULL, librarytexts.TEXT_OUT_OF_BOUNDS, a)
            end
        end
        writable(ctx, t)
        local removed = guestscope.geti(ctx, t, pos)
        -- A packed table's wide integer is a fresh box, which the reads
        -- after it could collect.
        guestscope.hold(ctx, removed)
        local at = pos
        while at < size and not guestscope.suspended(ctx) do
            guestscope.seti(ctx, t, at, guestscope.geti(ctx, t, at + 1))
            at = at + 1
        end
        if at >= 1 and at <= size then
            guestscope.seti(ctx, t, at, values.NIL)
        end
        tables.drain(h)
        return removed
    end
end

-- table.move(a1, f, e, t [, a2]): a1[f..e] to a2[t..], a2 being a1 when
-- absent, copying backwards when the ranges overlap that way; answers a2.
-- Raw, as the tables' metatables are not consulted.
local function tableMove(ctx: voidptr, source: uint64, fv: uint64, ev: uint64, tv: uint64, target: uint64): uint64
    @unsafe do
        local h = guestHeap(ctx)
        local a1 = tableArgument(ctx, source, 1ULL)
        local destination = source
        if target ~= values.NIL then
            destination = target
        end
        local a2 = tableArgument(ctx, destination, 5ULL)
        local f = integerArgument(ctx, fv, 0, 2ULL)
        local e = integerArgument(ctx, ev, 0, 3ULL)
        local t = integerArgument(ctx, tv, 0, 4ULL)
        if e >= f then
            if f <= 0 and e >= native.index(0x7fffffffffffffffULL) + f then
                texts.argumentError(ctx, 3ULL, 0ULL, librarytexts.TEXT_TOO_MANY_MOVE, ev)
            end
            local n = e - f + 1
            if t > native.index(0x7fffffffffffffffULL) - n + 1 then
                texts.argumentError(ctx, 4ULL, 0ULL, librarytexts.TEXT_WRAP, tv)
            end
            writable(ctx, a2)
            if t > e or t <= f or a1 ~= a2 then
                local i: int64 = 0
                while i < n and not guestscope.suspended(ctx) do
                    guestscope.seti(ctx, a2, t + i, guestscope.geti(ctx, a1, f + i))
                    i = i + 1
                end
            else
                local i = n - 1
                while i >= 0 and not guestscope.suspended(ctx) do
                    guestscope.seti(ctx, a2, t + i, guestscope.geti(ctx, a1, f + i))
                    i = i - 1
                end
            end
            tables.drain(h)
        end
        return destination
    end
end

-- table.unpack(t [, i [, j]]): t[i] to t[j] (1 and #t by default). Alone,
-- the first of them; with `all`, every one in a pack.
local function tableUnpack(ctx: voidptr, list: uint64, a: uint64, b: uint64, all: boolean): uint64
    @unsafe do
        local pack: uint64 = 0ULL
        if all then
            -- Held while the strings it is given are made.
            pack = guestscope.newTable(ctx)
            guestscope.hold(ctx, values.TAG_OBJ | pack)
        end
        local h = guestHeap(ctx)
        local t = tableArgument(ctx, list, 1ULL)
        local i = integerArgument(ctx, a, 1, 2ULL)
        local size: int64 = 0
        if b == values.NIL then
            size = lengthof(ctx, t)
            if guestscope.suspended(ctx) then
                return values.NIL
            end
        end
        local j = integerArgument(ctx, b, size, 3ULL)
        if i > j then
            return packed(h, pack, 0ULL, values.NIL)
        end
        if j - i >= 1000000 then
            texts.libraryError(ctx, librarytexts.TEXT_UNPACK_MANY)
        end
        if pack == 0ULL then
            return guestscope.geti(ctx, t, i)
        end
        local k = i
        while k <= j and not guestscope.suspended(ctx) do
            packPut(h, pack, native.word(k - i + 1), guestscope.geti(ctx, t, k))
            k = k + 1
        end
        return packed(h, pack, native.word(j - i + 1), loadAt(pack, 1))
    end
end

-- Where a sort or a gsub with a function replacement stands (its state's
-- PENDING): running, waiting for the function's answer, or finished.
const RUNNING: int64 = 0
const WAITING: int64 = 1
const FINISHED: int64 = 2

-- table.sort's state, a table keyed by the SORT layout (corelibrary): the
-- list and comparator, the pair awaiting the comparator's answer and the
-- answer, then where the merge sort stands.
local function sortGet(st: uint64, key: int64): int64
    return native.index(loadAt(st, key) & values.PAYLOAD)
end

local function sortPut(h: heap.Heap*, st: uint64, key: int64, n: int64): nil
    storeAt(h, st, key, values.TAG_INTEGER | native.word(n))
end

-- Whether a sorts before b by `<`, for table.sort without a comparator:
-- numbers by value, strings byte by byte.
local function sortLess(ctx: voidptr, a: uint64, b: uint64): boolean
    local ai = ints.isInteger(a)
    local bi = ints.isInteger(b)
    if ai and bi then
        return native.index(ints.bitsOf(a)) < native.index(ints.bitsOf(b))
    end
    if ai and isFloat(b) then
        return ints.intFloatLess(ints.bitsOf(a), b, false)
    end
    if isFloat(a) and bi then
        return ints.floatIntLess(a, ints.bitsOf(b), false)
    end
    if isFloat(a) and isFloat(b) then
        return native.fromBits(a) < native.fromBits(b)
    end
    local x = strings.header(a)
    local y = strings.header(b)
    if x == 0ULL or y == 0ULL then
        texts.faultError(ctx, guestscope.FAULT_COMPARE, a, b)
    end

    return strings.less(x, y, false)
end

-- The merge of runs [lo, lo + width - 1] and [lo + width, hi], the second
-- cut short by the list's end.
local function sortAt(h: heap.Heap*, st: uint64, lo: int64, width: int64): nil
    local n = sortGet(st, librarylayouts.SORT_N)
    local hi = lo + 2 * width - 1
    if hi > n then
        hi = n
    end
    sortPut(h, st, librarylayouts.SORT_WIDTH, width)
    sortPut(h, st, librarylayouts.SORT_LO, lo)
    sortPut(h, st, librarylayouts.SORT_MID, lo + width - 1)
    sortPut(h, st, librarylayouts.SORT_HI, hi)
    sortPut(h, st, librarylayouts.SORT_I, lo)
    sortPut(h, st, librarylayouts.SORT_J, lo + width)
    sortPut(h, st, librarylayouts.SORT_K, lo)
end

-- The next pair of runs to merge, doubling the width once a pass ends.
-- False once one run spans the list.
local function sortRuns(h: heap.Heap*, st: uint64): boolean
    local n = sortGet(st, librarylayouts.SORT_N)
    local width = sortGet(st, librarylayouts.SORT_WIDTH)
    local lo = sortGet(st, librarylayouts.SORT_LO) + 2 * width
    if lo + width > n then
        width = width * 2
        lo = 1
        if width >= n then
            return false
        end
    end
    sortAt(h, st, lo, width)

    return true
end

-- A comparator's step runs in replay as the other table library calls do,
-- but it changes the sort's state as it goes: the state as the step found
-- it is kept before its first run and put back before each rerun. The
-- handler roots the empty copy `stepstate` makes in the call's entry before
-- `copystate` fills it, since filling it can collect. The merge buffer needs
-- no copy, since a step writes every slot of it the step reads.
export function stepstate(ctx: voidptr, id: uint64, value: uint64): uint64
    if id ~= librarycalls.TABLE_SORT_STEP or guestscope.tableof(value) == 0ULL then
        return values.NIL
    end

    return values.TAG_OBJ | guestscope.newTable(ctx)
end

-- Copies the sort state fields of `from` into `to`, for a step of call `id`.
export function copystate(ctx: voidptr, id: uint64, from: uint64, to: uint64): nil
    local source = guestscope.tableof(from)
    local target = guestscope.tableof(to)
    if id ~= librarycalls.TABLE_SORT_STEP or source == 0ULL or target == 0ULL then
        return
    end
    @unsafe do
        local h = guestHeap(ctx)
        local key: int64 = librarylayouts.SORT_LIST
        while key <= librarylayouts.SORT_PENDING do
            storeAt(h, target, key, loadAt(source, key))
            key = key + 1
        end
        tables.drain(h)
    end
end

-- table.sort's state for list t and comparator `less` (nil for `<`), at the
-- first merge. A bottom-up merge sort: stable, and O(n log n) comparisons.
local function sortBegin(ctx: voidptr, list: uint64, less: uint64): uint64
    @unsafe do
        local t = tableArgument(ctx, list, 1ULL)
        writable(ctx, t)
        local state = guestscope.newTable(ctx)
        -- The state is held while the buffer is made, which can collect.
        guestscope.hold(ctx, values.TAG_OBJ | state)
        local buffer = guestscope.newTable(ctx)
        guestscope.release(ctx)
        local h = guestHeap(ctx)
        storeAt(h, state, librarylayouts.SORT_LIST, list)
        storeAt(h, state, librarylayouts.SORT_LESS, less)
        storeAt(h, state, librarylayouts.SORT_BUFFER, values.TAG_OBJ | buffer)
        local n = lengthof(ctx, t)
        sortPut(h, state, librarylayouts.SORT_N, n)
        sortPut(h, state, librarylayouts.SORT_PENDING, RUNNING)
        if n < 2 or guestscope.suspended(ctx) then
            sortPut(h, state, librarylayouts.SORT_PENDING, FINISHED)
        else
            sortAt(h, state, 1, 1)
        end
        tables.drain(h)
        return values.TAG_OBJ | state
    end
end

-- Advances the sort: true when the comparator must say whether state[3]
-- sorts before state[4] (its answer goes to state[5]), false once sorted.
-- Without a comparator it runs to the end.
local function sortStep(ctx: voidptr, value: uint64): uint64
    @unsafe do
        local h = guestHeap(ctx)
        local st = value & values.PAYLOAD
        local pending = sortGet(st, librarylayouts.SORT_PENDING)
        if pending == FINISHED then
            return values.FALSE
        end
        local t = loadAt(st, librarylayouts.SORT_LIST) & values.PAYLOAD
        local buffer = loadAt(st, librarylayouts.SORT_BUFFER) & values.PAYLOAD
        local less = loadAt(st, librarylayouts.SORT_LESS)
        local mid = sortGet(st, librarylayouts.SORT_MID)
        local hi = sortGet(st, librarylayouts.SORT_HI)
        local i = sortGet(st, librarylayouts.SORT_I)
        local j = sortGet(st, librarylayouts.SORT_J)
        local k = sortGet(st, librarylayouts.SORT_K)
        if pending == WAITING then
            -- The right element goes first only when it sorts before the left,
            -- which keeps equal elements in order.
            local answer = loadAt(st, librarylayouts.SORT_ANSWER)
            if answer ~= values.NIL and answer ~= values.FALSE then
                storeAt(h, buffer, k, guestscope.geti(ctx, t, j))
                j = j + 1
            else
                storeAt(h, buffer, k, guestscope.geti(ctx, t, i))
                i = i + 1
            end
            k = k + 1
        end
        while true do
            if guestscope.suspended(ctx) then
                return values.FALSE
            end
            if i <= mid and j <= hi then
                -- Kept in the state while left is read: a packed table's
                -- wide integer is a fresh box, which that read could collect.
                storeAt(h, st, librarylayouts.SORT_A, guestscope.geti(ctx, t, j))
                local left = guestscope.geti(ctx, t, i)
                local right = loadAt(st, librarylayouts.SORT_A)
                if guestscope.suspended(ctx) then
                    return values.FALSE
                end
                if less ~= values.NIL then
                    storeAt(h, st, librarylayouts.SORT_A, right)
                    storeAt(h, st, librarylayouts.SORT_B, left)
                    sortPut(h, st, librarylayouts.SORT_I, i)
                    sortPut(h, st, librarylayouts.SORT_J, j)
                    sortPut(h, st, librarylayouts.SORT_K, k)
                    sortPut(h, st, librarylayouts.SORT_PENDING, WAITING)
                    tables.drain(h)
                    return values.TRUE
                end
                if sortLess(ctx, right, left) then
                    storeAt(h, buffer, k, right)
                    j = j + 1
                else
                    storeAt(h, buffer, k, left)
                    i = i + 1
                end
                k = k + 1
            else
                while i <= mid do
                    storeAt(h, buffer, k, guestscope.geti(ctx, t, i))
                    i = i + 1
                    k = k + 1
                end
                while j <= hi do
                    storeAt(h, buffer, k, guestscope.geti(ctx, t, j))
                    j = j + 1
                    k = k + 1
                end
                local at = sortGet(st, librarylayouts.SORT_LO)
                while at <= hi do
                    guestscope.seti(ctx, t, at, loadAt(buffer, at))
                    at = at + 1
                end
                if not sortRuns(h, st) then
                    sortPut(h, st, librarylayouts.SORT_PENDING, FINISHED)
                    tables.drain(h)
                    return values.FALSE
                end
                mid = sortGet(st, librarylayouts.SORT_MID)
                hi = sortGet(st, librarylayouts.SORT_HI)
                i = sortGet(st, librarylayouts.SORT_I)
                j = sortGet(st, librarylayouts.SORT_J)
                k = sortGet(st, librarylayouts.SORT_K)
            end
        end

        return values.FALSE
    end
end

-- gsub's state for a function replacement, a table keyed by the GSUB
-- layout (corelibrary): the subject, pattern and function, the byte offsets
-- the search has reached and the last match ended at (plus one, so 0 is
-- none), the count and its limit, the pieces of the result and their number,
-- the captures awaiting the function and its answer, the match they came
-- from, PENDING, the anchor, and the offset the unreplaced text runs from.

-- Adds the subject's bytes [from, to) to the result's pieces.
local function gsubPiece(h: heap.Heap*, st: uint64, subject: uint64, from: int64, to: int64): nil
    @unsafe do
        if to <= from then
            return
        end
        local count = sortGet(st, librarylayouts.GSUB_COUNT) + 1
        local piece = strings.make(h, subject + native.word(from), native.word(to - from))
        storeAt(h, loadAt(st, librarylayouts.GSUB_PIECES) & values.PAYLOAD, count, values.TAG_OBJ | piece)
        sortPut(h, st, librarylayouts.GSUB_COUNT, count)
    end
end

-- gsub(s, p, f [, n])'s state, before its first match.
local function gsubBegin(ctx: voidptr, value: uint64, pv: uint64, fn: uint64, maxValue: uint64): uint64
    @unsafe do
        local s = stringArgument(ctx, value, 1ULL)
        local p = stringArgument(ctx, pv, 2ULL)
        local limit = integerArgument(ctx, maxValue, native.index(strings.length(s)) + 1, 4ULL)
        local state = guestscope.newTable(ctx)
        -- The state is held while the pieces table is made.
        guestscope.hold(ctx, values.TAG_OBJ | state)
        local pieces = guestscope.newTable(ctx)
        local h = guestHeap(ctx)
        storeAt(h, state, librarylayouts.GSUB_SUBJECT, value)
        storeAt(h, state, librarylayouts.GSUB_PATTERN, pv)
        storeAt(h, state, librarylayouts.GSUB_FUNCTION, fn)
        storeAt(h, state, librarylayouts.GSUB_PIECES, values.TAG_OBJ | pieces)
        sortPut(h, state, librarylayouts.GSUB_SRC, 0)
        sortPut(h, state, librarylayouts.GSUB_LAST, 0)
        sortPut(h, state, librarylayouts.GSUB_N, 0)
        sortPut(h, state, librarylayouts.GSUB_LIMIT, 0)
        if limit > 0 then
            sortPut(h, state, librarylayouts.GSUB_LIMIT, limit)
        end
        sortPut(h, state, librarylayouts.GSUB_PENDING, RUNNING)
        local anchor = strings.length(p) > 0ULL
            and native.word(native.load8(native.pointer(strings.bytes(p)), 0)) == 94ULL
        sortPut(h, state, librarylayouts.GSUB_ANCHOR, native.index(native.asWord(anchor)))
        sortPut(h, state, librarylayouts.GSUB_COPY, 0)
        sortPut(h, state, librarylayouts.GSUB_COUNT, 0)
        tables.drain(h)
        return values.TAG_OBJ | state
    end
end

-- Advances gsub to its next match: true when the function must be called
-- with the captures at state[9] (its answer goes to state[10]), false once
-- the subject is done.
local function gsubStep(ctx: voidptr, value: uint64): uint64
    local ms0 = new patterns.MatchState(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local st = value & values.PAYLOAD
        local pending = sortGet(st, librarylayouts.GSUB_PENDING)
        if pending == FINISHED then
            return values.FALSE
        end
        local s = strings.header(loadAt(st, librarylayouts.GSUB_SUBJECT))
        local p = strings.header(loadAt(st, librarylayouts.GSUB_PATTERN))
        local subject = strings.bytes(s)
        local length = native.index(strings.length(s))
        local anchor = sortGet(st, librarylayouts.GSUB_ANCHOR) == 1
        local src = sortGet(st, librarylayouts.GSUB_SRC)
        local last = sortGet(st, librarylayouts.GSUB_LAST)
        local finished = false
        if pending == WAITING then
            -- The function's answer replaces the match: false or nil keeps it,
            -- a string or number is its text.
            local at = sortGet(st, librarylayouts.GSUB_AT)
            local e = sortGet(st, librarylayouts.GSUB_END)
            gsubPiece(h, st, subject, sortGet(st, librarylayouts.GSUB_COPY), at)
            local answer = loadAt(st, librarylayouts.GSUB_ANSWER)
            if answer == values.NIL or answer == values.FALSE then
                gsubPiece(h, st, subject, at, e)
            elseif strings.header(answer) ~= 0ULL or ints.isInteger(answer) or isFloat(answer) then
                local text = answer
                if strings.header(answer) == 0ULL then
                    text = tostring(ctx, answer)
                end
                local count = sortGet(st, librarylayouts.GSUB_COUNT) + 1
                storeAt(h, loadAt(st, librarylayouts.GSUB_PIECES) & values.PAYLOAD, count, text)
                sortPut(h, st, librarylayouts.GSUB_COUNT, count)
            elseif objectKind(answer) == heap.KIND_TABLE then
                texts.replacementError(ctx, answer)
            elseif objectKind(answer) == heap.KIND_CLOSURE then
                texts.replacementError(ctx, answer)
            else
                texts.replacementError(ctx, answer)
            end
            sortPut(h, st, librarylayouts.GSUB_COPY, e)
            src = e
            last = e + 1
            finished = anchor
        end
        if not finished then
            local pattern = strings.bytes(p)
            local pEnd = pattern + strings.length(p)
            if anchor then
                pattern = pattern + 1ULL
            end
            local ms = ms0 as patterns.MatchState*
            if patterns.prepare(h, ms, subject, strings.length(s), pEnd) ~= 0ULL then
                patterns.release(ms)
                error("not enough memory")
            end
            local n = sortGet(st, librarylayouts.GSUB_N)
            local limit = sortGet(st, librarylayouts.GSUB_LIMIT)
            while n < limit do
                local e = patterns.match(h, ms, subject + native.word(src), pattern)
                if e ~= 0ULL and (last == 0 or e ~= subject + native.word(last - 1)) then
                    -- The captures, or the whole match without any, as the
                    -- pack the function is called with.
                    local pack = guestscope.newTable(ctx)
                    -- Held while its captures are made.
                    guestscope.hold(ctx, values.TAG_OBJ | pack)
                    local level = patterns.level(ms)
                    if level == 0ULL then
                        packPut(
                            h,
                            pack,
                            1ULL,
                            values.TAG_OBJ | strings.make(h, subject + native.word(src), e - subject - native.word(src))
                        )
                        level = 1ULL
                    else
                        local i: uint64 = 0ULL
                        while i < level do
                            packPut(h, pack, i + 1ULL, capture(h, ms, subject, i))
                            i = i + 1ULL
                        end
                    end
                    packed(h, pack, level, values.NIL)
                    patterns.release(ms)
                    storeAt(h, st, librarylayouts.GSUB_CAPTURES, values.TAG_OBJ | pack)
                    sortPut(h, st, librarylayouts.GSUB_N, n + 1)
                    sortPut(h, st, librarylayouts.GSUB_AT, src)
                    sortPut(h, st, librarylayouts.GSUB_END, native.index(e - subject))
                    sortPut(h, st, librarylayouts.GSUB_SRC, src)
                    sortPut(h, st, librarylayouts.GSUB_LAST, last)
                    sortPut(h, st, librarylayouts.GSUB_PENDING, WAITING)
                    tables.drain(h)
                    return values.TRUE
                elseif src < length then
                    src = src + 1
                else
                    break
                end
                if anchor then
                    break
                end
            end
            patterns.release(ms)
        end
        gsubPiece(h, st, subject, sortGet(st, librarylayouts.GSUB_COPY), length)
        sortPut(h, st, librarylayouts.GSUB_PENDING, FINISHED)
        tables.drain(h)
        return values.FALSE
    end
end

-- gsub's result once its step answers false: the pieces joined, alone or
-- with `all` in a pack with the count of matches.
local function gsubFinish(ctx: voidptr, value: uint64, all: boolean): uint64
    local buffer = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local pack: uint64 = 0ULL
        if all then
            -- Held while the strings it is given are made.
            pack = guestscope.newTable(ctx)
            guestscope.hold(ctx, values.TAG_OBJ | pack)
        end
        local h = guestHeap(ctx)
        local st = value & values.PAYLOAD
        local pieces = loadAt(st, librarylayouts.GSUB_PIECES) & values.PAYLOAD
        local count = sortGet(st, librarylayouts.GSUB_COUNT)
        local builder = buffer as strings.Builder*
        local refused: uint64 = 0ULL
        local i: int64 = 1
        while i <= count do
            refused = refused | strings.appendString(h, builder, strings.header(loadAt(pieces, i)))
            i = i + 1
        end
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local result = values.TAG_OBJ | strings.finish(h, builder)
        if pack ~= 0ULL then
            packPut(h, pack, 1ULL, result)
            packPut(h, pack, 2ULL, values.TAG_INTEGER | native.word(sortGet(st, librarylayouts.GSUB_N)))
        end
        tables.drain(h)

        return packed(h, pack, 2ULL, result)
    end
end

-- print(...) over a pack {[0] = n, ...}: each value's text, separated by
-- tabs, and a newline, written to the host's output at once.
local function printValues(ctx: voidptr, packValue: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local pack = packValue & values.PAYLOAD
        local n = native.word(integerValue(tables.get(pack, values.TAG_INTEGER)))
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        local i: uint64 = 1ULL
        while i <= n do
            if i > 1ULL then
                refused = refused | strings.appendWord(h, builder, 9ULL, 1ULL)
            end
            refused = refused | appendText(h, builder, tables.get(pack, values.TAG_INTEGER | i))
            i = i + 1ULL
        end
        refused = refused | strings.appendWord(h, builder, 10ULL, 1ULL)
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local written = os.writeOutput(native.pointer(builder.base), builder.length)
        local length = builder.length
        strings.release(builder)
        if written < 0 or native.word(written) ~= length then
            error("cannot write output")
        end
        return values.NIL
    end
end

-- select(i, ...) over a variadic pack {[0] = n, ...}: the i-th value, from
-- the end when negative; nil past the end.
local function select(ctx: voidptr, packValue: uint64, index: uint64): uint64
    @unsafe do
        local pack = packValue & values.PAYLOAD
        local n = native.index(ints.bitsOf(tables.get(pack, values.TAG_INTEGER)))
        local i = integerArgument(ctx, index, 0, 1ULL)
        if i < 0 then
            i = n + i + 1
            if i < 1 then
                texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_INDEX_RANGE, index)
            end
        elseif i == 0 then
            texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_INDEX_RANGE, index)
        end
        if i > n then
            return values.NIL
        end
        return tables.get(pack, values.TAG_INTEGER | native.word(i))
    end
end

-- {...}: a fresh table holding a variadic pack's values at 1..n.
local function packCopy(ctx: voidptr, packValue: uint64, named: boolean): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local pack = packValue & values.PAYLOAD
        local n = ints.bitsOf(tables.get(pack, values.TAG_INTEGER))
        local t = guestscope.newTable(ctx)
        -- Held while its key strings are made.
        guestscope.hold(ctx, values.TAG_OBJ | t)
        local i: uint64 = 1ULL
        while i <= n do
            if tables.set(
                h,
                t,
                values.TAG_INTEGER | i,
                tables.get(pack, values.TAG_INTEGER | i)
            ) == tables.NO_MEMORY then
                error("not enough memory")
            end
            i = i + 1ULL
        end
        -- A named vararg carries its count as `n`, as table.pack does.
        if named then
            local builder = state as strings.Builder*
            if strings.appendWord(h, builder, 0x6eULL, 1ULL) ~= 0ULL then
                strings.release(builder)
                error("not enough memory")
            end
            local key = values.TAG_OBJ | strings.finish(h, builder)
            if tables.set(h, t, key, values.TAG_INTEGER | n) == tables.NO_MEMORY then
                error("not enough memory")
            end
            tables.drain(h)
        end
        return values.TAG_OBJ | t
    end
end

-- error's level argument: an integer (a float with an integer value too),
-- 0 for none or a negative one; anything else is the default, 1.
export function errorLevel(value: uint64): uint64
    local level: int64 = 1
    if ints.isInteger(value) then
        level = native.index(ints.bitsOf(value))
    elseif value & values.QNAN ~= values.QNAN and ints.integralFloat(value) then
        level = native.index(ints.floatToBits(value))
    end
    if level < 0 then
        return 0ULL
    end

    return native.word(level)
end

-- C's math functions, by os.mathFunction's numbering.
const C_POW: uint64 = 0ULL
const C_EXP: uint64 = 1ULL
const C_LOG: uint64 = 2ULL
const C_LOG2: uint64 = 3ULL
const C_LOG10: uint64 = 4ULL
const C_SIN: uint64 = 5ULL
const C_COS: uint64 = 6ULL
const C_TAN: uint64 = 7ULL
const C_ASIN: uint64 = 8ULL
const C_ACOS: uint64 = 9ULL
const C_ATAN2: uint64 = 10ULL
const C_FMOD: uint64 = 11ULL

-- C's math function `op` of the numbers a and b, as a float.
local function hostMath(op: uint64, a: uint64, b: uint64): uint64
    return floatValue(os.mathFunction(op, floatOf(a), floatOf(b)))
end

-- a ^ b: always a float, by C's pow.
local function power(ctx: voidptr, a: uint64, b: uint64): uint64
    if floatOf(a) == values.NIL or floatOf(b) == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return hostMath(C_POW, a, b)
end

-- math.log(x [, base]): base 2 and 10 by their own functions, any other as
-- a quotient of natural logarithms.
local function mathLog(ctx: voidptr, count: uint64, x: uint64, base: uint64): uint64
    local value = numberArgument(ctx, x, 1ULL)
    if count < 2ULL then
        return hostMath(C_LOG, value, value)
    end
    -- 2.0 and 10.0 by their bits.
    local b = floatOf(numberArgument(ctx, base, 2ULL))
    if b == 0x4000000000000000ULL then
        return hostMath(C_LOG2, value, value)
    elseif b == 0x4024000000000000ULL then
        return hostMath(C_LOG10, value, value)
    end
    local numerator = native.fromBits(os.mathFunction(C_LOG, floatOf(value), 0ULL))
    local denominator = native.fromBits(os.mathFunction(C_LOG, floatOf(base), 0ULL))

    return floatValue(native.bits(numerator / denominator))
end

-- math.fmod(a, b): for integers, the remainder of truncated division (an
-- error for zero); otherwise C's fmod.
local function mathFmod(ctx: voidptr, a: uint64, b: uint64): uint64
    local x = numberArgument(ctx, a, 1ULL)
    local y = numberArgument(ctx, b, 2ULL)
    if ints.isInteger(x) and ints.isInteger(y) then
        local n = ints.bitsOf(x)
        local d = ints.bitsOf(y)
        if d == 0ULL then
            texts.argumentError(ctx, 2ULL, 0ULL, librarytexts.TEXT_ZERO, b)
        end
        local negative = native.index(n) < 0
        local magnitude = n
        if negative then
            magnitude = 0ULL - n
        end
        local divisor = d
        if native.index(d) < 0 then
            divisor = 0ULL - d
        end
        local r = magnitude % divisor
        if negative then
            r = 0ULL - r
        end
        return guestscope.integer(ctx, r)
    end

    return hostMath(C_FMOD, x, y)
end

-- math.random's four words of state, in the services.
local function randomBase(ctx: voidptr): uint64
    @unsafe do
        return native.address(
            native.offset(
                native.loadPointer(ctx, context.SERVICE_SCOPE),
                native.fieldOffset<guestscope.Services>("random0")
            )
        )
    end
end

local function rotateLeft(x: uint64, n: uint64): uint64
    return (x << n) | (x >> (64ULL - n))
end

-- xoshiro256**, as Lua 5.5 draws: the next value, advancing the state.
local function nextRandom(state: uint64): uint64
    @unsafe do
        local s = native.pointer(state)
        local s0 = native.load64(s, 0)
        local s1 = native.load64(s, 8)
        local s2 = native.load64(s, 16) ~ s0
        local s3 = native.load64(s, 24) ~ s1
        local result = rotateLeft(s1 * 5ULL, 7ULL) * 9ULL
        native.store64(s, 0, s0 ~ s3)
        native.store64(s, 8, s1 ~ s2)
        native.store64(s, 16, s2 ~ (s1 << 17ULL))
        native.store64(s, 24, rotateLeft(s3, 45ULL))
        return result
    end
end

-- Lua's setseed: the two seeds, 0xff so the state is never zero, and
-- sixteen draws discarded to spread them.
local function seedRandom(state: uint64, n1: uint64, n2: uint64): nil
    @unsafe do
        local s = native.pointer(state)
        native.store64(s, 0, n1)
        native.store64(s, 8, 0xffULL)
        native.store64(s, 16, n2)
        native.store64(s, 24, 0ULL)
        local i: int64 = 0
        while i < 16 do
            nextRandom(state)
            i = i + 1
        end
    end
end

-- The state, seeded from the host on first use as Lua seeds at startup.
local function randomState(ctx: voidptr): uint64
    @unsafe do
        local state = randomBase(ctx)
        local s = native.pointer(state)
        if native.load64(s, 0) | native.load64(s, 8) | native.load64(s, 16) | native.load64(s, 24) == 0ULL then
            seedRandom(state, os.randomSeed(), 0ULL)
        end
        return state
    end
end

-- Lua's project: `ran` into [0, n], uniformly, drawing again while the
-- smallest all-ones mask covering n leaves it above n.
local function project(s: uint64, ran: uint64, n: uint64): uint64
    local lim = n
    local sh: uint64 = 1ULL
    while lim & (lim + 1ULL) ~= 0ULL do
        lim = lim | (lim >> sh)
        sh = sh * 2ULL
    end
    local value = ran & lim
    while value > n do
        value = nextRandom(s) & lim
    end

    return value
end

-- math.random(): a float in [0, 1) from the top 53 bits; (m): an integer in
-- [1, m], or any integer for 0; (m, n): an integer in [m, n].
local function mathRandom(ctx: voidptr, count: uint64, a: uint64, b: uint64): uint64
    local s = randomState(ctx)
    local rv = nextRandom(s)
    if count == 0ULL then
        local scaled = native.fromBits(ints.toFloatBits(rv >> 11ULL)) * native.fromBits(0x3ca0000000000000ULL)
        return floatValue(native.bits(scaled))
    end
    local low: int64 = 1
    local up: int64 = 0
    if count == 1ULL then
        up = integerArgument(ctx, a, 0, 1ULL)
        if up == 0 then
            return guestscope.integer(ctx, rv)
        end
    else
        low = integerArgument(ctx, a, 0, 1ULL)
        up = integerArgument(ctx, b, 0, 2ULL)
    end
    if low > up then
        texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_EMPTY_INTERVAL, a)
    end

    return guestscope.integer(ctx, project(s, rv, native.word(up) - native.word(low)) + native.word(low))
end

-- math.randomseed([n1 [, n2]]): seeds the state, from the host and a draw
-- when no seed is given; answers the first seed.
local function mathRandomseed(ctx: voidptr, count: uint64, a: uint64, b: uint64): uint64
    local n1: uint64 = 0ULL
    local n2: uint64 = 0ULL
    if count == 0ULL then
        n1 = os.randomSeed()
        n2 = nextRandom(randomState(ctx))
    else
        n1 = native.word(integerArgument(ctx, a, 0, 1ULL))
        n2 = native.word(integerArgument(ctx, b, 0, 2ULL))
    end
    seedRandom(randomBase(ctx), n1, n2)

    return guestscope.integer(ctx, n1)
end

-- Library call `id` with `count` arguments; answers the result value. error
-- (ERROR) is raised by its handler, which records where.
export function call(ctx: voidptr, id: uint64, count: uint64, a: uint64, b: uint64, c: uint64, d: uint64): uint64
    guestscope.nameLibrary(ctx, librarycalls.libraryname(id))
    if id == librarycalls.TOSTRING then
        return tostring(ctx, a)
    elseif id == librarycalls.STRING_FORMAT then
        return format(ctx, count, a, b, c, d, 0ULL)
    elseif id == librarycalls.POW then
        return power(ctx, a, b)
    elseif id == librarycalls.MATH_EXP then
        return hostMath(C_EXP, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_LOG then
        return mathLog(ctx, count, a, b)
    elseif id == librarycalls.MATH_SIN then
        return hostMath(C_SIN, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_COS then
        return hostMath(C_COS, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_TAN then
        return hostMath(C_TAN, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_ASIN then
        return hostMath(C_ASIN, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_ACOS then
        return hostMath(C_ACOS, numberArgument(ctx, a, 1ULL), a)
    elseif id == librarycalls.MATH_ATAN then
        local x = values.TAG_INTEGER | 1ULL
        if count >= 2ULL then
            x = numberArgument(ctx, b, 2ULL)
        end
        return hostMath(C_ATAN2, numberArgument(ctx, a, 1ULL), x)
    elseif id == librarycalls.MATH_FMOD then
        return mathFmod(ctx, a, b)
    elseif id == librarycalls.MATH_RANDOM then
        return mathRandom(ctx, count, a, b)
    elseif id == librarycalls.MATH_RANDOM_FLOAT then
        return mathRandom(ctx, 0ULL, a, b)
    elseif id == librarycalls.MATH_RANDOMSEED then
        return mathRandomseed(ctx, count, a, b)
    elseif id == librarycalls.MATH_RANDOMSEED_HOST then
        return mathRandomseed(ctx, 0ULL, a, b)
    elseif id == librarycalls.PRINT then
        return printValues(ctx, a)
    elseif id == librarycalls.STRING_FORMAT_PACK then
        -- The pack holds its count at key 0.
        local pack = b & values.PAYLOAD
        local n = native.word(integerValue(tables.get(pack, values.TAG_INTEGER)))
        return format(ctx, n + 1ULL, a, values.NIL, values.NIL, values.NIL, pack)
    elseif id == librarycalls.TABLE_CONCAT then
        return concat(ctx, count, a, b, c, d)
    elseif id == librarycalls.STRING_GMATCH_NEXT then
        return gmatchNext(ctx, a)
    elseif id == librarycalls.CONCAT2 then
        return concat2(ctx, a, b)
    elseif id == librarycalls.DIVIDE then
        return divide(ctx, a, b)
    elseif id == librarycalls.FLOOR_DIVIDE then
        return floorDivide(ctx, a, b)
    elseif id == librarycalls.NEXT_STEP then
        return nextStep(ctx, a)
    elseif id == librarycalls.TONUMBER then
        return tonumber(ctx, a)
    elseif id == librarycalls.OS_GETENV then
        return getenv(ctx, a)
    elseif id == librarycalls.STRING_SUB then
        return sub(ctx, a, b, c)
    elseif id == librarycalls.STRING_BYTE then
        return bytes(ctx, a, b, c, false)
    elseif id == librarycalls.STRING_BYTE_ALL then
        return bytes(ctx, a, b, c, true)
    elseif id == librarycalls.STRING_CHAR then
        return char(ctx, a)
    elseif id == librarycalls.STRING_REP then
        return rep(ctx, a, b, c)
    elseif id == librarycalls.STRING_REVERSE then
        return reverse(ctx, a)
    elseif id == librarycalls.STRING_UPPER then
        return casing(ctx, a, true)
    elseif id == librarycalls.STRING_LOWER then
        return casing(ctx, a, false)
    elseif id == librarycalls.STRING_LEN then
        return values.TAG_INTEGER | strings.length(stringArgument(ctx, a, 1ULL))
    elseif id == librarycalls.STRING_FIND then
        return search(ctx, a, b, c, d, false, false)
    elseif id == librarycalls.STRING_MATCH then
        return search(ctx, a, b, c, values.NIL, true, false)
    elseif id == librarycalls.STRING_FIND_ALL then
        return search(ctx, a, b, c, d, false, true)
    elseif id == librarycalls.STRING_MATCH_ALL then
        return search(ctx, a, b, c, values.NIL, true, true)
    elseif id == librarycalls.STRING_GSUB then
        return gsub(ctx, a, b, c, d, false)
    elseif id == librarycalls.STRING_GSUB_ALL then
        return gsub(ctx, a, b, c, d, true)
    elseif id == librarycalls.TABLE_INSERT then
        return tableInsert(ctx, count, a, b, c)
    elseif id == librarycalls.TABLE_REMOVE then
        return tableRemove(ctx, count, a, b)
    elseif id == librarycalls.TABLE_UNPACK then
        return tableUnpack(ctx, a, b, c, false)
    elseif id == librarycalls.TABLE_UNPACK_ALL then
        return tableUnpack(ctx, a, b, c, true)
    elseif id == librarycalls.TABLE_MOVE then
        return tableMove(ctx, a, b, c, d, values.NIL)
    elseif id == librarycalls.TABLE_MOVE_PACK then
        local pack = b & values.PAYLOAD
        return tableMove(
            ctx,
            a,
            tables.get(pack, values.TAG_INTEGER | 1ULL),
            tables.get(pack, values.TAG_INTEGER | 2ULL),
            tables.get(pack, values.TAG_INTEGER | 3ULL),
            tables.get(pack, values.TAG_INTEGER | 4ULL)
        )
    elseif id == librarycalls.TABLE_FREEZE then
        return tableFreeze(ctx, a)
    elseif id == librarycalls.TABLE_ISFROZEN then
        return tableIsfrozen(ctx, a)
    elseif id == librarycalls.TABLE_SORT then
        -- The state is held while the sort runs: reading a packed table's
        -- wide integer can collect.
        local state = sortBegin(ctx, a, values.NIL)
        guestscope.hold(ctx, state)
        sortStep(ctx, state)
        guestscope.release(ctx)
        return values.NIL
    elseif id == librarycalls.TABLE_SORT_BEGIN then
        return sortBegin(ctx, a, b)
    elseif id == librarycalls.TABLE_SORT_STEP then
        return sortStep(ctx, a)
    elseif id == librarycalls.STRING_GSUB_BEGIN then
        return gsubBegin(ctx, a, b, c, d)
    elseif id == librarycalls.STRING_GSUB_STEP then
        return gsubStep(ctx, a)
    elseif id == librarycalls.STRING_GSUB_FINISH then
        return gsubFinish(ctx, a, false)
    elseif id == librarycalls.STRING_GSUB_FINISH_ALL then
        return gsubFinish(ctx, a, true)
    elseif id == librarycalls.MATH_ABS then
        return mathAbs(ctx, a)
    elseif id == librarycalls.MATH_CEIL then
        return mathCeil(ctx, a)
    elseif id == librarycalls.MATH_MAX then
        return mathExtreme(ctx, count, a, b, c, d, true)
    elseif id == librarycalls.MATH_MIN then
        return mathExtreme(ctx, count, a, b, c, d, false)
    elseif id == librarycalls.MATH_TOINTEGER then
        return integral(ctx, a)
    elseif id == librarycalls.MATH_TYPE then
        return mathType(ctx, a)
    elseif id == librarycalls.MATH_SQRT then
        return floatValue(native.bits(native.sqrt(native.fromBits(floatOf(numberArgument(ctx, a, 1ULL))))))
    elseif id == librarycalls.LANDED then
        return guestscope.takeLanded(ctx)
    elseif id == librarycalls.TYPE then
        return guestscope.typeName(ctx, a)
    elseif id == librarycalls.UNM then
        return negate(ctx, a)
    elseif id == librarycalls.SETMETATABLE then
        return guestscope.setMetatable(ctx, a, b)
    elseif id == librarycalls.GETMETATABLE then
        return guestscope.getMetatable(ctx, a)
    elseif id == librarycalls.RAWGET then
        return guestscope.rawGet(ctx, a, b)
    elseif id == librarycalls.RAWSET then
        return guestscope.rawSet(ctx, a, b, c)
    elseif id == librarycalls.SELECT then
        return select(ctx, a, b)
    elseif id == librarycalls.PACK_COPY then
        return packCopy(ctx, a, false)
    elseif id == librarycalls.PACK_NAMED then
        return packCopy(ctx, a, true)
    elseif id == librarycalls.PACK_APPEND then
        @unsafe do
            local h = guestHeap(ctx)
            local t = a & values.PAYLOAD
            local pack = b & values.PAYLOAD
            local n = ints.bitsOf(tables.get(pack, values.TAG_INTEGER))
            local first = ints.bitsOf(c)
            local i: uint64 = 1ULL
            while i <= n do
                if tables.set(
                    h,
                    t,
                    values.TAG_INTEGER | (first + i - 1ULL),
                    tables.get(pack, values.TAG_INTEGER | i)
                ) == tables.NO_MEMORY then
                    error("not enough memory")
                end
                i = i + 1ULL
            end
            -- A pack being built (print's) also takes the count at key 0.
            if d == values.TRUE
                and tables.set(h, t, values.TAG_INTEGER, values.TAG_INTEGER | (first - 1ULL + n)) == tables.NO_MEMORY
            then
                error("not enough memory")
            end
            tables.drain(h)
        end
        return a
    end
    error("unknown core library call")

    return values.NIL
end
