module nupp.runtime.core.rawshape

const native = require("nupp.runtime.vm.intrinsics")
const header = require("nupp.runtime.core.rawheader")
const wire = require("nupp.runtime.core.rawwire")
const roles = require("nupp.runtime.core.rawroles")

-- Borrowed mappings and immutable input are caller obligations. Actual selected
-- helper/control storage is disjoint before entry, including prologue spills.
-- Refusal leaves output untouched but may alter workspace. Phase 2 means only
-- physical row/reference/ownership shape, never SSA, source, or code authority.
local struct Counters
    expansion: uint64
    stringExpansion: uint64
    byteWork: uint64
    mergeWork: uint64
end

-- Size calculation is not mapping authority. Header caps make each product
-- exact; callers still supply and retain the actual disjoint mapped workspace.
export function workspaceBytes(records: uint64, strings: uint64): uint64
    if records > wire.recordsLimit or strings > records then
        return 0ULL
    end
    local fixed = native.sizeOf<
        header.Descriptor
    >() + wire.sectionCount * native.sizeOf<header.Section>() + native.sizeOf<Counters>() + wire.sectionCount * 8ULL

    return fixed + ((records + 63ULL) >> 6ULL) * 8ULL + strings * 16ULL
end

local function range(base: uint64, bytes: uint64): uint64
    if base == 0ULL or bytes == 0ULL or (base & 7ULL) ~= 0ULL or bytes > 0xffffffffffffffffULL - base then
        return 0ULL
    end
    return 1ULL
end

local function overlaps(a: uint64, an: uint64, b: uint64, bn: uint64): boolean
    return a < b + bn and b < a + an
end

local function u32(data: voidptr, offset: uint64): uint64
    return native.word(native.load32(data, native.index(offset))) & roles.absent
end

local function count(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("count")
    )
end

local function base(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("data")
    )
end

local function charge(control: voidptr, amount: uint64): uint64
    local previous = native.load64(control, native.fieldOffset<Counters>("expansion"))
    if amount > wire.expandedLimit - previous then
        return 0ULL
    end
    native.store64(control, native.fieldOffset<Counters>("expansion"), previous + amount)

    return 1ULL
end

local function claim(
    descriptor: voidptr,
    control: voidptr,
    bitmap: voidptr,
    section: uint64,
    first: uint64,
    amount: uint64,
    maximum: uint64
): uint64
    local available = count(descriptor, section)
    if first > available or amount > available - first or amount > maximum then
        return 0ULL
    end
    if charge(control, amount) == 0ULL then
        return 0ULL
    end
    local prefix = native.load64(control, native.index(native.sizeOf<Counters>() + section * 8ULL))
    local index = 0ULL
    while index < amount do
        local bit = prefix + first + index
        local offset, mask = (bit >> 6ULL) * 8ULL, 1ULL << (bit & 63ULL)
        local previous = native.load64(bitmap, native.index(offset))
        if (previous & mask) ~= 0ULL then
            return 0ULL
        end
        native.store64(bitmap, native.index(offset), previous | mask)
        index = index + 1ULL
    end

    return 1ULL
end

local function stringReference(descriptor: voidptr, control: voidptr, bitmap: voidptr, id: uint64): uint64
    if id >= count(descriptor, wire.S_strings) then
        return 0ULL
    end
    local row = id * wire.stride(wire.S_strings)
    local bytes = u32(native.pointer(base(descriptor, wire.S_strings)), row + roles.F_strings_bytes)
    local previous = native.load64(control, native.fieldOffset<Counters>("stringExpansion"))
    if bytes > wire.stringLimit - previous or charge(control, 1ULL) == 0ULL then
        return 0ULL
    end
    native.store64(control, native.fieldOffset<Counters>("stringExpansion"), previous + bytes)
    local prefix = native.load64(control, native.index(native.sizeOf<Counters>() + wire.S_strings * 8ULL))
    local bit = prefix + id
    local offset, mask = (bit >> 6ULL) * 8ULL, 1ULL << (bit & 63ULL)
    native.store64(bitmap, native.index(offset), native.load64(bitmap, native.index(offset)) | mask)

    return 1ULL
end

local function fields(descriptor: voidptr, control: voidptr, bitmap: voidptr, section: uint64, row: uint64): uint64
    local data = native.pointer(base(descriptor, section))
    local at = row * wire.stride(section)
    local index, total = 0ULL, roles.fieldCount(section)
    while index < total do
        local rule = roles.field(section, index)
        local offset, action, target = rule & 255ULL, (rule >> 8ULL) & 15ULL, (rule >> 12ULL) & 31ULL
        local value, maximum = u32(data, at + offset), rule >> 32ULL
        if action == roles.R_zero then
            if value ~= 0ULL then
                return 0ULL
            end
        elseif action == roles.R_bounded64 then
            if u32(data, at + offset + 4ULL) ~= 0ULL then
                return 0ULL
            end
        elseif action == roles.R_enum then
            if value >= maximum then
                return 0ULL
            end
        elseif action == roles.R_ref or action == roles.R_optionalRef then
            if action == roles.R_ref or value ~= roles.absent then
                if value >= count(descriptor, target) then
                    return 0ULL
                end
            end
        elseif action == roles.R_owned or action == roles.R_optionalOwned then
            if action == roles.R_owned or value ~= roles.absent then
                if claim(descriptor, control, bitmap, target, value, 1ULL, 1ULL) == 0ULL then
                    return 0ULL
                end
            end
        elseif action == roles.R_span then
            local amount = u32(data, at + ((rule >> 17ULL) & 127ULL))
            if claim(descriptor, control, bitmap, target, value, amount, maximum) == 0ULL then
                return 0ULL
            end
        elseif action == roles.R_string then
            if stringReference(descriptor, control, bitmap, value) == 0ULL then
                return 0ULL
            end
        end
        index = index + 1ULL
    end

    return 1ULL
end

local function compare(descriptor: voidptr, control: voidptr, left: uint64, right: uint64): uint64
    local strings, bytes = native.pointer(
        base(descriptor, wire.S_strings)
    ), native.pointer(base(descriptor, wire.S_bytes))
    local x, y = left * wire.stride(wire.S_strings), right * wire.stride(wire.S_strings)
    local xn, yn = u32(strings, x + roles.F_strings_bytes), u32(strings, y + roles.F_strings_bytes)
    local xo, yo = u32(strings, x + roles.F_strings_offset), u32(strings, y + roles.F_strings_offset)
    local at = 0ULL
    while at < xn and at < yn do
        local work = native.load64(control, native.fieldOffset<Counters>("byteWork"))
        native.store64(control, native.fieldOffset<Counters>("byteWork"), work + 1ULL)
        local a, b = native.load8(bytes, native.index(xo + at)), native.load8(bytes, native.index(yo + at))
        if a < b then
            return 1ULL
        elseif a > b then
            return 2ULL
        end
        at = at + 1ULL
    end
    if xn < yn then
        return 1ULL
    elseif xn > yn then
        return 2ULL
    end

    return 0ULL
end

local function strings(descriptor: voidptr, control: voidptr, firstArray: voidptr): uint64
    local number, rawBytes = count(descriptor, wire.S_strings), count(descriptor, wire.S_bytes)
    local rows, nextByte, id = native.pointer(base(descriptor, wire.S_strings)), 0ULL, 0ULL
    while id < number do
        local row = id * wire.stride(wire.S_strings)
        local offset, length = u32(rows, row + roles.F_strings_offset), u32(rows, row + roles.F_strings_bytes)
        if u32(rows, row + roles.F_strings_offset + 4ULL) ~= 0ULL
            or offset ~= nextByte
            or length > roles.stringItemLimit
            or length > rawBytes - nextByte
        then
            return 0ULL
        end
        nextByte = nextByte + length
        native.store64(firstArray, native.index(id * 8ULL), id)
        id = id + 1ULL
    end
    if nextByte ~= rawBytes then
        return 0ULL
    end
    local source, destination, width, levels = 0ULL, number * 8ULL, 1ULL, 0ULL
    while width < number do
        local first = 0ULL
        while first < number do
            local middle, last = first + width, first + width * 2ULL
            if middle > number then
                middle = number
            end
            if last > number then
                last = number
            end
            local left, right, at = first, middle, first
            while at < last do
                local work = native.load64(control, native.fieldOffset<Counters>("mergeWork"))
                native.store64(control, native.fieldOffset<Counters>("mergeWork"), work + 1ULL)
                local takeLeft = right == last
                if left < middle and right < last then
                    local compared = compare(
                        descriptor,
                        control,
                        native.load64(firstArray, native.index(source + left * 8ULL)),
                        native.load64(firstArray, native.index(source + right * 8ULL))
                    )
                    if compared == 0ULL then
                        return 0ULL
                    end
                    takeLeft = compared == 1ULL
                end
                if takeLeft then
                    native.store64(
                        firstArray,
                        native.index(destination + at * 8ULL),
                        native.load64(firstArray, native.index(source + left * 8ULL))
                    )
                    left = left + 1ULL
                else
                    native.store64(
                        firstArray,
                        native.index(destination + at * 8ULL),
                        native.load64(firstArray, native.index(source + right * 8ULL))
                    )
                    right = right + 1ULL
                end
                at = at + 1ULL
            end
            first = last
        end
        source, destination = destination, source
        width, levels = width * 2ULL, levels + 1ULL
    end
    if native.load64(control, native.fieldOffset<Counters>("byteWork")) > 2ULL * (rawBytes + number) * (levels + 1ULL)
        or native.load64(control, native.fieldOffset<Counters>("mergeWork")) > number * (levels + 1ULL)
    then
        return 0ULL
    end

    return 1ULL
end

export function admit(
    data: voidptr,
    dataBytes: uint64,
    out: voidptr,
    outBytes: uint64,
    pool: voidptr,
    poolBytes: uint64,
    helper: voidptr,
    helperBytes: uint64
): uint64
    local d, o, p, h = native.address(data), native.address(out), native.address(pool), native.address(helper)
    local descriptor = native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>()
    local fixed = workspaceBytes(0ULL, 0ULL)
    if range(d, dataBytes) == 0ULL
        or range(o, outBytes) == 0ULL
        or range(p, poolBytes) == 0ULL
        or range(h, helperBytes) == 0ULL
    then
        return 0ULL
    end
    if dataBytes < wire.minimumBytes
        or dataBytes > wire.fileLimit
        or outBytes < descriptor
        or poolBytes < fixed
        or helperBytes < 16ULL
    then
        return 0ULL
    end
    if overlaps(d, dataBytes, o, outBytes)
        or overlaps(d, dataBytes, p, poolBytes)
        or overlaps(d, dataBytes, h, helperBytes)
        or overlaps(o, outBytes, p, poolBytes)
        or overlaps(o, outBytes, h, helperBytes)
        or overlaps(p, poolBytes, h, helperBytes)
    then
        return 0ULL
    end
    local at = 0ULL
    while at < descriptor do
        if native.load64(out, native.index(at)) ~= 0ULL then
            return 0ULL
        end
        at = at + 8ULL
    end
    -- All mapped-span, overlap, freshness and minimum-workspace checks precede
    -- the first workspace write. Header admission is staged away from output.
    at = 0ULL
    while at < fixed do
        native.store64(pool, native.index(at), 0ULL)
        at = at + 8ULL
    end
    if header.admit(data, dataBytes, pool, descriptor, out, outBytes, helper, helperBytes) == 0ULL then
        return 0ULL
    end
    local control = native.offset(pool, native.index(descriptor))
    local section, records = 0ULL, 0ULL
    while section < wire.sectionCount do
        native.store64(control, native.index(native.sizeOf<Counters>() + section * 8ULL), records)
        if section ~= wire.S_bytes then
            records = records + count(pool, section)
        end
        section = section + 1ULL
    end
    local mapBytes = ((records + 63ULL) >> 6ULL) * 8ULL
    local stringCount = count(pool, wire.S_strings)
    local required = workspaceBytes(records, stringCount)
    -- Header caps prove records <= 1 Mi and strings <= records, so all products
    -- are exact and workspace <= fixed + 128 KiB + 16 MiB. No hidden allocation.
    if required > poolBytes then
        return 0ULL
    end
    local bitmap = native.offset(pool, native.index(fixed))
    at = 0ULL
    while at < mapBytes do
        native.store64(bitmap, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local firstArray = native.offset(bitmap, native.index(mapBytes))
    if strings(pool, control, firstArray) == 0ULL then
        return 0ULL
    end
    section = 0ULL
    while section < wire.sectionCount do
        local maximum = roles.rootLimit(section)
        if maximum ~= roles.absent then
            if claim(pool, control, bitmap, section, 0ULL, count(pool, section), maximum) == 0ULL then
                return 0ULL
            end
        end
        section = section + 1ULL
    end
    section = 0ULL
    while section < wire.sectionCount do
        if section ~= wire.S_bytes then
            local row = 0ULL
            while row < count(pool, section) do
                if fields(pool, control, bitmap, section, row) == 0ULL then
                    return 0ULL
                end
                row = row + 1ULL
            end
        end
        section = section + 1ULL
    end
    at = 0ULL
    while at < records do
        local marked = native.load64(bitmap, native.index((at >> 6ULL) * 8ULL))
        if (marked & (1ULL << (at & 63ULL))) == 0ULL then
            return 0ULL
        end
        at = at + 1ULL
    end
    -- No refusing operation follows. Pointer-bearing descriptor data remains
    -- valid only for the original borrowed mapping lifetime, never after it.
    at = 8ULL
    while at < descriptor do
        native.store64(out, native.index(at), native.load64(pool, native.index(at)))
        at = at + 8ULL
    end
    native.store64(out, native.fieldOffset<header.Descriptor>("phase"), 2ULL)

    return 1ULL
end
