module nupp.runtime.core.guestops

const native = require("nupp.runtime.vm.intrinsics")
const frames = require("nupp.runtime.core.frames")
const instances = require("nupp.runtime.core.instances")
const catalog = require("nupp.runtime.core.guestcatalog")
const context = require("nupp.runtime.core.context")
const values = require("nupp.runtime.vm.values")
const heap = require("nupp.runtime.vm.heap")
const guestscope = require("nupp.runtime.core.guestscope")
const threads = require("nupp.runtime.core.threads")

export const INVALID: uint64 = 4ULL
export const RESOURCE: uint64 = 5ULL

-- These helpers borrow only the entry-owned State/catalog/registry and current
-- logical frame. Their raw signatures do not authorize arbitrary context data.
-- The closed producer proves the disjoint mappings and exact checked bodies.
export function state(ctx: voidptr): uint64
    return native.load64(ctx, context.STATE)
end

export function fail(ctx: voidptr, frame: voidptr, pc: voidptr, status: uint64): nil
    if native.load64(ctx, context.STATUS) == 0ULL then
        native.store64(ctx, context.STATUS, status)
        native.store64(ctx, context.ERROR_OWNER, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")))
        local code = native.load64(frame, native.fieldOffset<frames.Frame>("code"))
        local address = native.address(pc)
        local index: uint64 = 0ULL
        if address >= code then
            index = (address - code) // 16ULL
        end
        native.store64(ctx, context.ERROR_PC, index)
    end
end

-- Charge before catalog/instance lookup or frame reservation. Failure records
-- the original owner/PC once; cleanup neither charges nor overwrites the error.
export function charge(ctx: voidptr, frame: voidptr, pc: voidptr): uint64
    if native.load64(ctx, context.STATUS) ~= 0ULL then
        return 0ULL
    end
    if native.load64(ctx, context.CANCELLED) ~= 0ULL then
        fail(ctx, frame, pc, context.CANCELLED_STATUS)
        return 0ULL
    end
    local remaining = native.load64(ctx, context.REMAINING)
    if remaining == 0ULL then
        fail(ctx, frame, pc, context.BUDGET_STATUS)
        return 0ULL
    end
    if remaining ~= context.UNLIMITED then
        native.store64(ctx, context.REMAINING, remaining - 1ULL)
    end

    return 1ULL
end

-- Zero refuses; success is the exact retained function record address. This
-- checks identity and bounds, not the mappedness of a caller-invented pointer.
export function current(ctx: voidptr, frame: voidptr, pc: voidptr): uint64
    local s = native.loadPointer(ctx, context.STATE)
    local c = native.loadPointer(ctx, context.CATALOG)
    if native.load64(c, native.fieldOffset<catalog.Catalog>("phase")) ~= 1ULL
        or native.load64(s, native.fieldOffset<frames.State>("active")) ~= native.address(frame)
        or native.load64(frame, native.fieldOffset<frames.Frame>("phase")) ~= frames.ACTIVE
    then
        return 0ULL
    end
    local id = native.load64(frame, native.fieldOffset<frames.Frame>("functionId"))
    if id >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
        return 0ULL
    end
    local record = native.load64(
        c,
        native.fieldOffset<catalog.Catalog>("records")
    ) + id * native.sizeOf<catalog.Function>()
    local info = native.load64(
        c,
        native.fieldOffset<catalog.Catalog>("infos")
    ) + id * native.sizeOf<frames.FunctionInfo>()
    local plan = native.load64(
        c,
        native.fieldOffset<catalog.Catalog>("plans")
    ) + id * native.sizeOf<frames.WindowPlan>()
    local fn = native.pointer(record)
    local code = native.load64(
        c,
        native.fieldOffset<catalog.Catalog>("data")
    ) + native.load64(fn, native.fieldOffset<catalog.Function>("code"))
    local count = native.load64(fn, native.fieldOffset<catalog.Function>("instructionCount"))
    if native.load64(frame, native.fieldOffset<frames.Frame>("functionInfo")) ~= info
        or native.load64(frame, native.fieldOffset<frames.Frame>("windowPlan")) ~= plan
        or native.load64(frame, native.fieldOffset<frames.Frame>("bodyOwner")) ~= record
        or native.load64(frame, native.fieldOffset<frames.Frame>("code")) ~= code
        or native.load64(frame, native.fieldOffset<frames.Frame>("instructionCount")) ~= count
        or native.load64(
            frame,
            native.fieldOffset<frames.Frame>("valueCount")
        ) ~= native.load64(fn, native.fieldOffset<catalog.Function>("valueCount"))
        or native.load64(
            frame,
            native.fieldOffset<frames.Frame>("values")
        ) ~= native.address(
            frame
        ) + native.load64(native.pointer(plan), native.fieldOffset<frames.WindowPlan>("values"))
    then
        return 0ULL
    end
    local address = native.address(pc)
    if address < code or ((address - code) & 15ULL) ~= 0ULL or (address - code) // 16ULL >= count then
        return 0ULL
    end

    return record
end

export function constantPresent(ctx: voidptr, frame: voidptr, pc: voidptr, index: uint64): uint64
    local found = current(ctx, frame, pc)
    if found == 0ULL then
        return 0ULL
    end

    if index < native.load64(native.pointer(found), native.fieldOffset<catalog.Function>("constantCount")) then
        return 1ULL
    end

    return 0ULL
end

export function constant(ctx: voidptr, frame: voidptr, pc: voidptr, index: uint64): uint64
    local found = current(ctx, frame, pc)
    if found == 0ULL then
        return 0ULL
    end
    local fn = native.pointer(found)
    if index >= native.load64(fn, native.fieldOffset<catalog.Function>("constantCount")) then
        return 0ULL
    end
    local c = native.loadPointer(ctx, context.CATALOG)
    local data = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("data"))
    local offset = native.load64(fn, native.fieldOffset<catalog.Function>("constants"))

    return native.load64(data, native.index(offset + index * 8ULL))
end

-- The first initializer publishes one immediate only after successful root
-- retirement. A later initializer can observe that committed value once.
export function moduleValue(ctx: voidptr, frame: voidptr, pc: voidptr, target: uint64): uint64
    if current(ctx, frame, pc) == 0ULL or native.load64(ctx, context.MODULE_ORDINAL) ~= 1ULL then
        return 0ULL
    end
    local c = native.loadPointer(ctx, context.CATALOG)
    local data = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("data"))
    if native.load64(data, native.fieldOffset<catalog.DescriptorV1>("version")) ~= 2ULL
        or native.load64(data, native.fieldOffset<catalog.Descriptor>("moduleCount")) ~= 2ULL
    then
        return 0ULL
    end
    local offset = native.load64(data, native.fieldOffset<catalog.Descriptor>("modules"))
    if target ~= native.load64(data, native.index(offset)) then
        return 0ULL
    end
    local world = native.loadPointer(ctx, context.WORLD)
    if native.load64(world, native.fieldOffset<instances.World>("modulePhase")) ~= 1ULL then
        return 0ULL
    end
    local value = native.load64(world, native.fieldOffset<instances.World>("moduleValue"))
    if value ~= values.TRUE and value ~= values.FALSE and value ~= values.NIL then
        return 0ULL
    end

    return value
end

export function closure(ctx: voidptr, frame: voidptr, pc: voidptr, target: uint64): uint64
    local parent = current(ctx, frame, pc)
    if parent == 0ULL then
        return 0ULL
    end
    local c = native.loadPointer(ctx, context.CATALOG)
    if target >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
        return 0ULL
    end
    local fn = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("records")),
        native.index(target * native.sizeOf<catalog.Function>())
    )
    if native.load64(fn, native.fieldOffset<catalog.Function>("kind")) ~= catalog.FUNCTION
        or native.load64(
            fn,
            native.fieldOffset<catalog.Function>("parentPlusOne")
        ) ~= native.load64(frame, native.fieldOffset<frames.Frame>("functionId")) + 1ULL
    then
        return 0ULL
    end

    return instances.create(
        native.loadPointer(ctx, context.REGISTRY),
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("targets")),
        target
    )
end

-- v7 and later keep every closure on the collected heap: a KIND_CLOSURE whose
-- first slot holds its target as an integer immediate and whose remaining slots
-- hold its captures.
export function heapClosures(ctx: voidptr): uint64
    local c = native.loadPointer(ctx, context.CATALOG)
    local data = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("data"))
    if native.load64(data, native.fieldOffset<catalog.Descriptor>("version")) >= 7ULL then
        return 1ULL
    end

    return 0ULL
end

-- 1 when `target` is a function nested directly in the current frame's.
export function closureTarget(ctx: voidptr, frame: voidptr, pc: voidptr, target: uint64): uint64
    if current(ctx, frame, pc) == 0ULL then
        return 0ULL
    end
    local c = native.loadPointer(ctx, context.CATALOG)
    if target >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
        return 0ULL
    end
    local fn = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("records")),
        native.index(target * native.sizeOf<catalog.Function>())
    )
    if native.load64(fn, native.fieldOffset<catalog.Function>("kind")) ~= catalog.FUNCTION
        or native.load64(
            fn,
            native.fieldOffset<catalog.Function>("parentPlusOne")
        ) ~= native.load64(frame, native.fieldOffset<frames.Frame>("functionId")) + 1ULL
    then
        return 0ULL
    end

    return 1ULL
end

-- The target of a heap closure value plus one, or zero for anything else.
local function heapTarget(callee: uint64): uint64
    if callee & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local header = native.pointer(callee & values.PAYLOAD)
    if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_CLOSURE
        or native.load64(header, native.fieldOffset<heap.Header>("auxLen")) == 0ULL
    then
        return 0ULL
    end
    local first = native.load64(native.pointer(native.load64(header, native.fieldOffset<heap.Header>("auxPtr"))), 0)

    return (first & values.PAYLOAD) + 1ULL
end

-- 1 when a v7 or later callee is not a closure: calling it is a guest
-- error, as Lua raises one.
export function uncallable(ctx: voidptr, callee: uint64): uint64
    if heapClosures(ctx) == 1ULL and heapTarget(callee) == 0ULL then
        return 1ULL
    end

    return 0ULL
end

-- 1 when a dynamic callsite's signature admits the callee's: a result the
-- site takes as given or as any value. The counts may differ: as Lua calls,
-- extra arguments are dropped and missing ones are nil.
local function compatibleSignatures(c: voidptr, site: uint64, callee: uint64): uint64
    local records = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("signatures"))
    local a = native.offset(records, native.index(site * native.sizeOf<catalog.Signature>()))
    local b = native.offset(records, native.index(callee * native.sizeOf<catalog.Signature>()))
    local wanted = native.load64(a, native.fieldOffset<catalog.Signature>("resultKind"))
    if wanted ~= catalog.VALUE and wanted ~= native.load64(b, native.fieldOffset<catalog.Signature>("resultKind")) then
        return 0ULL
    end

    return 1ULL
end

-- The callee is the actual registry handle loaded from a live slot. Hint alone
-- cannot select a body. Canonical byte fields must also match this PC's retained
-- checked callsite, its target signature and each canonical scalar argument.
export function prepare(
    ctx: voidptr,
    frame: voidptr,
    pc: voidptr,
    callee: uint64,
    base: uint64,
    nargs: uint64,
    wanted: uint64,
    hint: uint64
): uint64
    local found = current(ctx, frame, pc)
    if found == 0ULL or nargs > 63ULL or wanted == 0ULL or wanted > frames.MAX_RESULTS then
        return 0ULL
    end
    local fn = native.pointer(found)
    local c = native.loadPointer(ctx, context.CATALOG)
    local count = native.load64(c, native.fieldOffset<catalog.Catalog>("count"))
    local nv = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    -- A dynamic call (v8) carries the absent hint and resolves its callee here.
    local dynamic = hint == 0xffffffffULL and heapClosures(ctx) == 1ULL
    if hint >= count and not dynamic or base >= nv - 1ULL or nargs > nv - base - 1ULL then
        return 0ULL
    end
    local index = (native.address(pc) - native.load64(frame, native.fieldOffset<frames.Frame>("code"))) // 16ULL
    local first = native.load64(fn, native.fieldOffset<catalog.Function>("firstCall"))
    local calls = native.load64(fn, native.fieldOffset<catalog.Function>("callCount"))
    local records = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("contracts"))
    local at: uint64 = 0ULL
    local contract: uint64 = 0ULL
    while at < calls do
        local candidate = native.offset(records, native.index((first + at) * native.sizeOf<catalog.Callsite>()))
        if native.load64(candidate, native.fieldOffset<catalog.Callsite>("pc")) == index then
            contract = native.address(candidate)
        end
        at = at + 1ULL
    end
    if contract == 0ULL then
        return 0ULL
    end
    local call = native.pointer(contract)
    if native.load64(call, native.fieldOffset<catalog.Callsite>("target")) ~= hint
        or native.load64(call, native.fieldOffset<catalog.Callsite>("argumentBase")) ~= base
        or native.load64(call, native.fieldOffset<catalog.Callsite>("argumentCount")) ~= nargs
        and native.load64(call, native.fieldOffset<catalog.Callsite>("spread")) ~= 1ULL
        or native.load64(call, native.fieldOffset<catalog.Callsite>("argumentCount")) > nargs
        or native.load64(call, native.fieldOffset<catalog.Callsite>("wanted")) ~= wanted
        or native.load64(call, native.fieldOffset<catalog.Callsite>("resultSlot")) ~= base + 1ULL
        or native.load64(call, native.fieldOffset<catalog.Callsite>("resumePC")) ~= index + 1ULL
    then
        return 0ULL
    end
    local targets = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("targets"))
    local resolved: uint64 = 0ULL
    if heapClosures(ctx) == 1ULL then
        resolved = heapTarget(callee)
    else
        resolved = instances.resolve(native.loadPointer(ctx, context.REGISTRY), targets, callee)
    end
    if resolved == 0ULL or not dynamic and resolved - 1ULL ~= hint or resolved > count then
        return 0ULL
    end
    local actual = resolved - 1ULL
    local target = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("records")),
        native.index(actual * native.sizeOf<catalog.Function>())
    )
    local siteSignature = native.load64(call, native.fieldOffset<catalog.Callsite>("signature"))
    local signatureId = native.load64(target, native.fieldOffset<catalog.Function>("signature"))
    if native.load64(target, native.fieldOffset<catalog.Function>("kind")) ~= catalog.FUNCTION then
        return 0ULL
    end
    -- A dynamic call's site may see the callee through erased type
    -- parameters: it holds when the counts agree and the site takes the result
    -- as the callee gives it or as any value. Arguments are checked against
    -- the callee's own kinds below.
    if signatureId ~= siteSignature
        and (not dynamic or compatibleSignatures(c, siteSignature, signatureId) == 0ULL)
    then
        return 0ULL
    end
    local signature = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("signatures")),
        native.index(signatureId * native.sizeOf<catalog.Signature>())
    )
    -- A variadic callee's last parameter is its pack of extra arguments.
    local declared = native.load64(signature, native.fieldOffset<catalog.Signature>("parameterCount"))
    local variadic = native.load64(signature, native.fieldOffset<catalog.Signature>("variadic")) == 1ULL
    local fixed = declared
    if variadic then
        fixed = declared - 1ULL
        if nargs < fixed and not dynamic then
            return 0ULL
        end
    elseif declared ~= nargs and not dynamic then
        return 0ULL
    end
    local data = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("data"))
    local kinds = native.load64(signature, native.fieldOffset<catalog.Signature>("parameters"))
    local window = native.loadPointer(frame, native.fieldOffset<frames.Frame>("values"))
    at = 0ULL
    while at < fixed do
        local kind = native.load64(data, native.index(kinds + at * 8ULL))
        -- A parameter past the arguments given is nil.
        local value = values.NIL
        if at < nargs then
            value = native.load64(window, native.index((base + 1ULL + at) * 8ULL))
        end
        if catalog.scalar(kind, value) == 0ULL then
            return 0ULL
        end
        at = at + 1ULL
    end
    local info = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("infos")),
        native.index(actual * native.sizeOf<frames.FunctionInfo>())
    )
    local plan = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("plans")),
        native.index(actual * native.sizeOf<frames.WindowPlan>())
    )

    return frames.prepareFixed(
        native.loadPointer(ctx, context.STATE),
        frame,
        info,
        callee,
        base,
        nargs,
        base + 1ULL,
        plan
    )
end

-- After prepare: a variadic callee's pack {[0] = n, ...} of the arguments
-- past its fixed ones, stored in its last parameter slot before it is filled
-- so the prepared frame roots it throughout. Answers 1, or 0 on refusal.
export function packVarargs(ctx: voidptr, frame: voidptr, child: voidptr, base: uint64, nargs: uint64): uint64
    local c = native.loadPointer(ctx, context.CATALOG)
    local id = native.load64(child, native.fieldOffset<frames.Frame>("functionId"))
    if id >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
        return 0ULL
    end
    local record = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("records")),
        native.index(id * native.sizeOf<catalog.Function>())
    )
    local signature = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("signatures")),
        native.index(
            native.load64(
                record,
                native.fieldOffset<catalog.Function>("signature")
            ) * native.sizeOf<catalog.Signature>()
        )
    )
    if native.load64(signature, native.fieldOffset<catalog.Signature>("variadic")) ~= 1ULL then
        return 1ULL
    end
    local declared = native.load64(signature, native.fieldOffset<catalog.Signature>("parameterCount"))
    local fixed = declared - 1ULL
    local window = native.loadPointer(frame, native.fieldOffset<frames.Frame>("values"))
    local pack = guestscope.newTable(ctx)
    local slots = native.loadPointer(child, native.fieldOffset<frames.Frame>("values"))
    native.store64(slots, native.index(declared * 8ULL), values.TAG_OBJ | pack)
    -- A dynamic call may give fewer than the fixed ones: then none extra.
    local count: uint64 = 0ULL
    if nargs > fixed then
        count = nargs - fixed
    end
    guestscope.tableSet(ctx, pack, values.TAG_INTEGER, values.TAG_INTEGER | count)
    local k: uint64 = 0ULL
    while k < count do
        local value = native.load64(window, native.index((base + 1ULL + fixed + k) * 8ULL))
        guestscope.tableSet(ctx, pack, values.TAG_INTEGER | (k + 1ULL), value)
        k = k + 1ULL
    end

    return 1ULL
end

export function result(ctx: voidptr, frame: voidptr, pc: voidptr, value: uint64): uint64
    local found = current(ctx, frame, pc)
    if found == 0ULL then
        return 0ULL
    end
    local c = native.loadPointer(ctx, context.CATALOG)
    local id = native.load64(native.pointer(found), native.fieldOffset<catalog.Function>("signature"))
    local signature = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("signatures")),
        native.index(id * native.sizeOf<catalog.Signature>())
    )

    return catalog.scalar(native.load64(signature, native.fieldOffset<catalog.Signature>("resultKind")), value)
end

export function root(ctx: voidptr, frame: voidptr): uint64
    if native.address(frame) ~= native.load64(ctx, context.ORIGINAL_ROOT) then
        return 0ULL
    end
    return 1ULL
end

export function finish(ctx: voidptr, frame: voidptr, value: uint64): uint64
    if root(ctx, frame) == 0ULL then
        return 0ULL
    end
    return frames.finishRoot(
        native.loadPointer(ctx, context.STATE),
        native.loadPointer(ctx, context.ROOT_CONTROL),
        frame,
        native.load64(ctx, context.ROOT_SERIAL),
        value
    )
end

export function branch(ctx: voidptr, frame: voidptr, pc: voidptr, displacement: int64): uint64
    if current(ctx, frame, pc) == 0ULL then
        return 0ULL
    end
    local code = native.load64(frame, native.fieldOffset<frames.Frame>("code"))
    local count = native.load64(frame, native.fieldOffset<frames.Frame>("instructionCount"))
    local index = (native.address(pc) - code) // 16ULL
    local target: uint64 = 0ULL
    if displacement >= 0 then
        local distance = native.word(displacement)
        if distance >= count - index - 1ULL then
            return 0ULL
        end
        target = index + 1ULL + distance
    else
        -- Byte encoding bounds displacement to signed32; -(d+1) is safe even
        -- at its minimum. This formulation does not wrap an unsigned address.
        local distance = native.word(0 - (displacement + 1))
        if distance > index then
            return 0ULL
        end
        target = index - distance
    end

    return code + target * 16ULL
end

-- Record the source position before a transition can retire its Frame. Failure
-- handling after that call uses only retained Context and never the old frame.
export function checkpoint(ctx: voidptr, frame: voidptr, pc: voidptr): nil
    if native.load64(ctx, context.STATUS) == 0ULL then
        native.store64(ctx, context.ERROR_OWNER, native.load64(frame, native.fieldOffset<frames.Frame>("functionId")))
        native.store64(
            ctx,
            context.ERROR_PC,
            (native.address(pc) - native.load64(frame, native.fieldOffset<frames.Frame>("code"))) // 16ULL
        )
    end
end

export function failure(ctx: voidptr, status: uint64): nil
    if native.load64(ctx, context.STATUS) == 0ULL then
        native.store64(ctx, context.STATUS, status)
    end
end

export function resume(ctx: voidptr, frame: voidptr, pc: voidptr): uint64
    return (native.address(pc) - native.load64(frame, native.fieldOffset<frames.Frame>("code"))) // 16ULL + 1ULL
end

-- A call the handler at `pc` makes itself: the callee staged at `base` in
-- the frame's window and `nargs` arguments after it, its first result
-- landing in `resultSlot`. Answers the prepared, unpublished child, or 0
-- after recording the failure; the caller publishes it to resume after
-- `pc`. A callee that takes fewer arguments gets the first of them.
export function metaPrepare(
    ctx: voidptr,
    frame: voidptr,
    pc: voidptr,
    base: uint64,
    nargs: uint64,
    resultSlot: uint64
): uint64
    local found = current(ctx, frame, pc)
    local nv = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if found == 0ULL or base >= nv or nargs > nv - base - 1ULL or nargs > 63ULL or resultSlot >= nv then
        fail(ctx, frame, pc, INVALID)
        return 0ULL
    end
    local window = native.loadPointer(frame, native.fieldOffset<frames.Frame>("values"))
    local callee = native.load64(window, native.index(base * 8ULL))
    local resolved = heapTarget(callee)
    local c = native.loadPointer(ctx, context.CATALOG)
    if heapClosures(ctx) ~= 1ULL
        or resolved == 0ULL
        or resolved > native.load64(c, native.fieldOffset<catalog.Catalog>("count"))
    then
        guestscope.fault(ctx, guestscope.FAULT_CALL, callee, values.NIL)
        fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return 0ULL
    end
    local actual = resolved - 1ULL
    local target = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("records")),
        native.index(actual * native.sizeOf<catalog.Function>())
    )
    local signature = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("signatures")),
        native.index(
            native.load64(
                target,
                native.fieldOffset<catalog.Function>("signature")
            ) * native.sizeOf<catalog.Signature>()
        )
    )
    if native.load64(target, native.fieldOffset<catalog.Function>("kind")) ~= catalog.FUNCTION then
        fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
        return 0ULL
    end
    -- As a dynamic call adjusts them: parameters past the arguments are nil,
    -- arguments past the parameters are dropped, and a variadic callee packs
    -- those past its fixed ones.
    local declared = native.load64(signature, native.fieldOffset<catalog.Signature>("parameterCount"))
    local variadic = native.load64(signature, native.fieldOffset<catalog.Signature>("variadic")) == 1ULL
    local fixed = declared
    if variadic then
        fixed = declared - 1ULL
    end
    local data = native.loadPointer(c, native.fieldOffset<catalog.Catalog>("data"))
    local kinds = native.load64(signature, native.fieldOffset<catalog.Signature>("parameters"))
    local at: uint64 = 0ULL
    while at < fixed do
        local kind = native.load64(data, native.index(kinds + at * 8ULL))
        local value = values.NIL
        if at < nargs then
            value = native.load64(window, native.index((base + 1ULL + at) * 8ULL))
        end
        if catalog.scalar(kind, value) == 0ULL then
            fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return 0ULL
        end
        at = at + 1ULL
    end
    local taken = nargs
    if not variadic and fixed < nargs then
        taken = fixed
    end
    local info = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("infos")),
        native.index(actual * native.sizeOf<frames.FunctionInfo>())
    )
    local plan = native.offset(
        native.loadPointer(c, native.fieldOffset<catalog.Catalog>("plans")),
        native.index(actual * native.sizeOf<frames.WindowPlan>())
    )
    local s = native.loadPointer(ctx, context.STATE)
    checkpoint(ctx, frame, pc)
    local child = frames.prepareFixed(s, frame, info, callee, base, taken, resultSlot, plan)
    if child == 0ULL then
        failure(ctx, RESOURCE)
        return 0ULL
    end
    if variadic and packVarargs(ctx, frame, native.pointer(child), base, nargs) ~= 1ULL then
        failure(ctx, INVALID)
        return 0ULL
    end

    return child
end

-- The metamethod a library call at `pc` waits on (`guestscope.replaybegin`),
-- staged as metaCall stages one: its caller runs `pc` again once it
-- answers. Answers the child's address, or 0 after recording the failure.
export function libraryCall(ctx: voidptr, frame: voidptr, pc: voidptr, nargs: uint64, resultSlot: uint64): uint64
    local nv = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if nv < 5ULL or nargs > 3ULL then
        fail(ctx, frame, pc, INVALID)
        return 0ULL
    end
    local child = metaPrepare(ctx, frame, pc, nv - 4ULL, nargs, resultSlot)
    if child == 0ULL then
        return 0ULL
    end
    local s = native.loadPointer(ctx, context.STATE)
    if frames.libraryresult(s, native.pointer(child)) ~= 1ULL
        or frames.publish(s, frame, native.pointer(child), resume(ctx, frame, pc) - 1ULL) ~= 1ULL
    then
        failure(ctx, INVALID)
        return 0ULL
    end

    return child
end

-- A metamethod call from the handler at `pc`: the callee is staged at the
-- top of the frame's call window (slot valueCount - 4) and `nargs`
-- arguments after it; its result lands in `resultSlot`, and the frame
-- resumes after `pc`, as if the handler had finished. Answers 1 once the
-- callee's frame is published, 0 after recording the failure. A callee
-- that takes fewer arguments gets the first of them, as Lua drops extras.
-- With `truth` the caller takes its result as a boolean.
export function metaCall(
    ctx: voidptr,
    frame: voidptr,
    pc: voidptr,
    nargs: uint64,
    resultSlot: uint64,
    truth: uint64
): uint64
    local nv = native.load64(frame, native.fieldOffset<frames.Frame>("valueCount"))
    if nv < 5ULL or nargs > 3ULL then
        fail(ctx, frame, pc, INVALID)
        return 0ULL
    end
    -- A wrapped coroutine's function as the metamethod: its thread resumes
    -- with the arguments, and what it yields or returns first lands in
    -- resultSlot, a boolean for a comparison.
    local window = native.loadPointer(frame, native.fieldOffset<frames.Frame>("values"))
    local wrapped = threads.wrapped(native.load64(window, native.index((nv - 4ULL) * 8ULL)))
    if wrapped ~= 0ULL then
        local args = guestscope.packValues(ctx, native.offset(window, native.index((nv - 3ULL) * 8ULL)), nargs, 0ULL)
        -- The frame roots the pack until the thread has it.
        native.store64(window, native.index((nv - 3ULL) * 8ULL), args)
        local answer = threads.resume(
            ctx,
            frame,
            pc,
            wrapped,
            args,
            threads.MODE_CALL,
            resultSlot | (1ULL << 32ULL) | (truth << 62ULL)
        )
        if answer == threads.RAISED then
            fail(ctx, frame, pc, context.GUEST_ERROR_STATUS)
            return 0ULL
        elseif answer ~= threads.SWITCHED then
            fail(ctx, frame, pc, INVALID)
            return 0ULL
        end
        return 1ULL
    end
    local child = metaPrepare(ctx, frame, pc, nv - 4ULL, nargs, resultSlot)
    if child == 0ULL then
        return 0ULL
    end
    local s = native.loadPointer(ctx, context.STATE)
    if truth == 1ULL and frames.truth(s, native.pointer(child)) ~= 1ULL then
        failure(ctx, INVALID)
        return 0ULL
    end
    if frames.publish(s, frame, native.pointer(child), resume(ctx, frame, pc)) ~= 1ULL then
        failure(ctx, INVALID)
        return 0ULL
    end

    return 1ULL
end
