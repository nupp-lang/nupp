export function operation(id: uint64): uint64
    if id >= 5ULL then
        return 4294967295ULL
    end
    if id == 4ULL then
        return 257ULL
    end

    return (0x0100000001010100ULL >> (id * 16ULL)) & 65535ULL
end

export function term(id: uint64): uint64
    if id >= 4ULL then
        return 4294967295ULL
    end
    return (0x0101020001000000ULL >> (id * 16ULL)) & 65535ULL
end
