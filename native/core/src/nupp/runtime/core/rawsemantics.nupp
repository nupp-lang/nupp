module nupp.runtime.core.rawsemantics

const native = require("nupp.runtime.vm.intrinsics")
const header = require("nupp.runtime.core.rawheader")
const catalog = require("nupp.runtime.core.rawcatalog")
const budget = require("nupp.runtime.core.rawbudget")
const wire = require("nupp.runtime.core.rawwire")
const fields = require("nupp.runtime.core.rawroles")
const limits = require("nupp.runtime.core.rawcatalogpolicy")
const policy = require("nupp.runtime.core.rawsemanticpolicy")

-- Private transient state. IDs are checked before every value/block indexing.
-- Epochs avoid clearing value and slot tables for every block. Each value
-- word has epoch in low16 and kind/provenance in bits16..47; high16 stays zero.
-- The global definition bitmap and independent slot epochs remain separate.
local struct State
    descriptor: uint64
    graph: uint64
    values: uint64
    parameters: uint64
    slots: uint64
    valuesFirst: uint64
    blocks: uint64
    blocksFirst: uint64
    constants: uint64
    constantsFirst: uint64
    signature: uint64
    returned: uint64
end

local function stateBytes(values: uint64, blocks: uint64): uint64
    return native.sizeOf<State>() + ((values + 63ULL) >> 6ULL) * 8ULL + values * 16ULL + blocks * 16ULL
end

export function workspaceBytes(records: uint64, strings: uint64): uint64
    local prior = catalog.workspaceBytes(records, strings)
    if prior == 0ULL then
        return 0ULL
    end
    local current = stateBytes(limits.values, limits.blocks)
    if current > prior then
        prior = current
    end

    return native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>() + prior
end

local function row(descriptor: voidptr, section: uint64, index: uint64, offset: uint64): uint64
    local address = native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("data")
    )

    return native.word(native.load32(native.pointer(address), native.index(index * wire.stride(section) + offset)))
        & fields.absent
end

local function count(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("count")
    )
end

local function get(state: voidptr, offset: int64): uint64
    return native.load64(state, offset)
end

local function graphField(state: voidptr, offset: uint64): uint64
    return row(
        native.pointer(get(state, native.fieldOffset<State>("descriptor"))),
        wire.S_graphs,
        get(state, native.fieldOffset<State>("graph")),
        offset
    )
end

local function defined(state: voidptr): uint64
    return native.address(state) + native.sizeOf<State>()
end

local function locals(state: voidptr): uint64
    return defined(state) + ((limits.values + 63ULL) >> 6ULL) * 8ULL
end

local function slots(state: voidptr): uint64
    return locals(state) + limits.values * 8ULL
end

local function kinds(state: voidptr): uint64
    return locals(state)
end

local function degree(state: voidptr): uint64
    return slots(state) + limits.values * 8ULL
end

local function queue(state: voidptr): uint64
    return degree(state) + limits.blocks * 8ULL
end

local function clear(address: uint64, bytes: uint64): uint64
    local at = 0ULL
    while at < bytes do
        native.store64(native.pointer(address), native.index(at), 0ULL)
        at = at + 8ULL
    end

    return 1ULL
end

local function valueId(state: voidptr, id: uint64): boolean
    return id > 0ULL and id <= get(state, native.fieldOffset<State>("values"))
end

local function usable(state: voidptr, id: uint64, epoch: uint64): boolean
    if valueId(state, id) == false then
        return false
    end
    return id <= get(state, native.fieldOffset<State>("parameters"))
        or (native.load64(native.pointer(locals(state)), native.index((id - 1ULL) * 8ULL)) & policy.epochMask) == epoch
end

local function define(state: voidptr, id: uint64, epoch: uint64): uint64
    if valueId(state, id) == false then
        return 0ULL
    end
    local bit, mask = id - 1ULL, 1ULL << ((id - 1ULL) & 63ULL)
    local at = native.index((bit >> 6ULL) * 8ULL)
    local previous = native.load64(native.pointer(defined(state)), at)
    if (previous & mask) ~= 0ULL then
        return 0ULL
    end
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local slot = row(
        descriptor,
        wire.S_values,
        get(state, native.fieldOffset<State>("valuesFirst")) + bit,
        fields.F_values_slot
    )
    if slot >= get(state, native.fieldOffset<State>("slots")) then
        return 0ULL
    end
    if native.load64(native.pointer(slots(state)), native.index(slot * 8ULL)) == epoch then
        return 0ULL
    end
    native.store64(native.pointer(slots(state)), native.index(slot * 8ULL), epoch)
    native.store64(native.pointer(defined(state)), at, previous | mask)
    local packed = native.load64(native.pointer(locals(state)), native.index(bit * 8ULL))
    native.store64(
        native.pointer(locals(state)),
        native.index(bit * 8ULL),
        (packed & (policy.kindMask << policy.kindShift)) | epoch
    )

    return 1ULL
end

local function scalar(state: voidptr, id: uint64): uint64
    if valueId(state, id) == false then
        return 0ULL
    end
    return (native.load64(native.pointer(kinds(state)), native.index((id - 1ULL) * 8ULL)) >> policy.kindShift)
        & policy.kindMask
end

local function assign(state: voidptr, id: uint64, kind: uint64): uint64
    if valueId(state, id) == false or kind == 0ULL or kind > policy.maximumKind then
        return 0ULL
    end
    local at = native.index((id - 1ULL) * 8ULL)
    local packed = native.load64(native.pointer(kinds(state)), at)
    local previous = (packed >> policy.kindShift) & policy.kindMask
    if previous ~= 0ULL and previous ~= kind then
        return 0ULL
    end
    native.store64(native.pointer(kinds(state)), at, (packed & policy.epochMask) | (kind << policy.kindShift))

    return 1ULL
end

local function word(state: voidptr, index: uint64): uint64
    return row(
        native.pointer(get(state, native.fieldOffset<State>("descriptor"))),
        wire.S_words,
        index,
        fields.F_words_value
    )
end

local function blockRow(state: voidptr, id: uint64): uint64
    return get(state, native.fieldOffset<State>("blocksFirst")) + id - 1ULL
end

local function incoming(state: voidptr): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local id = 1ULL
    while id <= get(state, native.fieldOffset<State>("blocks")) do
        local term = row(descriptor, wire.S_blocks, blockRow(state, id), fields.F_blocks_term)
        local first = row(descriptor, wire.S_terms, term, fields.F_terms_edgesFirst)
        local length = row(descriptor, wire.S_terms, term, fields.F_terms_edgesCount)
        local at = 0ULL
        while at < length do
            local target = row(descriptor, wire.S_edges, first + at, fields.F_edges_target)
            if target <= 1ULL or target > get(state, native.fieldOffset<State>("blocks")) then
                return 0ULL
            end
            local offset = native.index((target - 1ULL) * 8ULL)
            native.store64(
                native.pointer(degree(state)),
                offset,
                native.load64(native.pointer(degree(state)), offset) + 1ULL
            )
            at = at + 1ULL
        end
        id = id + 1ULL
    end

    return 1ULL
end

local function edgeUses(state: voidptr, term: uint64, epoch: uint64, result: uint64): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local first = row(descriptor, wire.S_terms, term, fields.F_terms_edgesFirst)
    local length = row(descriptor, wire.S_terms, term, fields.F_terms_edgesCount)
    local offset = 0ULL
    if result ~= fields.absent then
        offset = 1ULL
    end
    local at = 0ULL
    while at < length do
        local target = row(descriptor, wire.S_edges, first + at, fields.F_edges_target)
        if target <= 1ULL or target > get(state, native.fieldOffset<State>("blocks")) then
            return 0ULL
        end
        local args = row(descriptor, wire.S_edges, first + at, fields.F_edges_argsFirst)
        local amount = row(descriptor, wire.S_edges, first + at, fields.F_edges_argsCount)
        if amount + offset ~= row(descriptor, wire.S_blocks, blockRow(state, target), fields.F_blocks_paramsCount) then
            return 0ULL
        end
        local item = 0ULL
        while item < amount do
            if usable(state, word(state, args + item), epoch) == false then
                return 0ULL
            end
            item = item + 1ULL
        end
        at = at + 1ULL
    end

    return 1ULL
end

local function termUses(state: voidptr, term: uint64, epoch: uint64): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local rule = policy.term(row(descriptor, wire.S_terms, term, fields.F_terms_kind))
    local result = fields.absent
    local value = row(descriptor, wire.S_terms, term, fields.F_terms_value)
    if (rule & policy.T_branch) ~= 0ULL then
        if usable(state, value, epoch) == false then
            return 0ULL
        end
    end
    if (rule & policy.T_return) ~= 0ULL and value ~= fields.absent then
        if usable(state, value, epoch) == false then
            return 0ULL
        end
    end
    if (rule & policy.T_invoke) ~= 0ULL then
        if usable(state, row(descriptor, wire.S_terms, term, fields.F_terms_callee), epoch) == false then
            return 0ULL
        end
        local first = row(descriptor, wire.S_terms, term, fields.F_terms_argsFirst)
        local length = row(descriptor, wire.S_terms, term, fields.F_terms_argsCount)
        local at = 0ULL
        while at < length do
            if usable(state, word(state, first + at), epoch) == false then
                return 0ULL
            end
            at = at + 1ULL
        end
        local edge = row(descriptor, wire.S_terms, term, fields.F_terms_edgesFirst)
        local target = row(descriptor, wire.S_edges, edge, fields.F_edges_target)
        if target <= 1ULL or target > get(state, native.fieldOffset<State>("blocks")) then
            return 0ULL
        end
        if native.load64(native.pointer(degree(state)), native.index((target - 1ULL) * 8ULL)) ~= 1ULL then
            return 0ULL
        end
        result = row(descriptor, wire.S_terms, term, fields.F_terms_result)
        if result ~= fields.absent then
            local block = blockRow(state, target)
            if valueId(state, result) == false or usable(state, result, epoch) then
                return 0ULL
            end
            if row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsCount) == 0ULL then
                return 0ULL
            end
            if word(state, row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsFirst)) ~= result then
                return 0ULL
            end
        end
    end

    return edgeUses(state, term, epoch, result)
end

local function structure(state: voidptr): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local epoch = 1ULL
    while epoch <= get(state, native.fieldOffset<State>("blocks")) do
        local block = blockRow(state, epoch)
        local first = row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsFirst)
        local length = row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsCount)
        if epoch == 1ULL and length ~= 0ULL then
            return 0ULL
        end
        local at = 0ULL
        while at < length do
            local id = word(state, first + at)
            if id <= get(state, native.fieldOffset<State>("parameters")) or define(state, id, epoch) == 0ULL then
                return 0ULL
            end
            at = at + 1ULL
        end
        first = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsFirst)
        length = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsCount)
        at = 0ULL
        while at < length do
            local rule = policy.operation(row(descriptor, wire.S_operations, first + at, fields.F_operations_opcode))
            if (rule & policy.P_module) ~= 0ULL then
                return 0ULL
            end
            local args = row(descriptor, wire.S_operations, first + at, fields.F_operations_argsFirst)
            if (rule & policy.P_read) ~= 0ULL then
                if usable(state, word(state, args), epoch) == false then
                    return 0ULL
                end
            end
            if define(
                state,
                row(descriptor, wire.S_operations, first + at, fields.F_operations_dst),
                epoch
            ) == 0ULL then
                return 0ULL
            end
            at = at + 1ULL
        end
        if termUses(state, row(descriptor, wire.S_blocks, block, fields.F_blocks_term), epoch) == 0ULL then
            return 0ULL
        end
        epoch = epoch + 1ULL
    end
    local id = 1ULL
    while id <= get(state, native.fieldOffset<State>("values")) do
        if (
            native.load64(native.pointer(defined(state)), native.index(((id - 1ULL) >> 6ULL) * 8ULL))
            & (1ULL << ((id - 1ULL) & 63ULL))
        ) == 0ULL then
            return 0ULL
        end
        id = id + 1ULL
    end

    return 1ULL
end

local function operationKinds(state: voidptr, block: uint64): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local first = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsFirst)
    local length = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsCount)
    local at = 0ULL
    while at < length do
        local rule = policy.operation(row(descriptor, wire.S_operations, first + at, fields.F_operations_opcode))
        local kind = 0ULL
        local argument = 0ULL
        if row(descriptor, wire.S_operations, first + at, fields.F_operations_argsCount) ~= 0ULL then
            argument = word(state, row(descriptor, wire.S_operations, first + at, fields.F_operations_argsFirst))
        end
        if (rule & policy.P_constant) ~= 0ULL then
            if argument >= get(state, native.fieldOffset<State>("constants")) then
                return 0ULL
            end
            kind = policy.constantKind(
                row(
                    descriptor,
                    wire.S_constants,
                    get(state, native.fieldOffset<State>("constantsFirst")) + argument,
                    fields.F_constants_kind
                )
            )
        end
        if (rule & policy.P_nil) ~= 0ULL then
            kind = policy.Kind_nil
        end
        if (rule & policy.P_copy) ~= 0ULL then
            kind = scalar(state, argument)
        end
        if (rule & policy.P_function) ~= 0ULL then
            if argument >= count(descriptor, wire.S_catalog) then
                return 0ULL
            end
            kind = policy.Kind_function + argument
        end
        if assign(state, row(descriptor, wire.S_operations, first + at, fields.F_operations_dst), kind) == 0ULL then
            return 0ULL
        end
        at = at + 1ULL
    end

    return 1ULL
end

local function termKinds(state: voidptr, term: uint64): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local rule = policy.term(row(descriptor, wire.S_terms, term, fields.F_terms_kind))
    if (rule & policy.T_return) ~= 0ULL then
        local value = row(descriptor, wire.S_terms, term, fields.F_terms_value)
        local kind = policy.Kind_nil
        if value ~= fields.absent then
            kind = scalar(state, value)
        end
        if kind ~= policy.Kind_nil and kind ~= policy.Kind_boolean then
            return 0ULL
        end
        local previous = get(state, native.fieldOffset<State>("returned"))
        if previous ~= 0ULL and previous ~= kind then
            return 0ULL
        end
        native.store64(state, native.fieldOffset<State>("returned"), kind)
    end
    if (rule & policy.T_branch) ~= 0ULL then
        local kind = scalar(state, row(descriptor, wire.S_terms, term, fields.F_terms_value))
        if kind ~= policy.Kind_nil and kind ~= policy.Kind_boolean then
            return 0ULL
        end
    end
    if (rule & policy.T_invoke) ~= 0ULL then
        local contract = row(descriptor, wire.S_terms, term, fields.F_terms_contract)
        local target = row(descriptor, wire.S_contracts, contract, fields.F_contracts_target)
        local signature = row(descriptor, wire.S_contracts, contract, fields.F_contracts_signature)
        if scalar(
            state,
            row(descriptor, wire.S_terms, term, fields.F_terms_callee)
        ) ~= policy.Kind_function + target then
            return 0ULL
        end
        local first = row(descriptor, wire.S_terms, term, fields.F_terms_argsFirst)
        local params = row(descriptor, wire.S_signatures, signature, fields.F_signatures_paramsFirst)
        local length = row(descriptor, wire.S_terms, term, fields.F_terms_argsCount)
        local at = 0ULL
        while at < length do
            if scalar(state, word(state, first + at)) ~= word(state, params + at) + 1ULL then
                return 0ULL
            end
            at = at + 1ULL
        end
        local result = row(descriptor, wire.S_terms, term, fields.F_terms_result)
        if result ~= fields.absent then
            if assign(
                state,
                result,
                row(descriptor, wire.S_signatures, signature, fields.F_signatures_result) + 1ULL
            ) == 0ULL then
                return 0ULL
            end
        end
    end

    return 1ULL
end

local function transfer(state: voidptr, term: uint64, ready: uint64): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    local first = row(descriptor, wire.S_terms, term, fields.F_terms_edgesFirst)
    local length = row(descriptor, wire.S_terms, term, fields.F_terms_edgesCount)
    local offset = 0ULL
    if row(descriptor, wire.S_terms, term, fields.F_terms_result) ~= fields.absent then
        offset = 1ULL
    end
    local countReady, at = ready, 0ULL
    while at < length do
        local edge = first + at
        local target = row(descriptor, wire.S_edges, edge, fields.F_edges_target)
        if target <= 1ULL or target > get(state, native.fieldOffset<State>("blocks")) then
            return fields.absent
        end
        local params = row(descriptor, wire.S_blocks, blockRow(state, target), fields.F_blocks_paramsFirst)
        local args = row(descriptor, wire.S_edges, edge, fields.F_edges_argsFirst)
        local amount = row(descriptor, wire.S_edges, edge, fields.F_edges_argsCount)
        local item = 0ULL
        while item < amount do
            if assign(state, word(state, params + item + offset), scalar(state, word(state, args + item))) == 0ULL then
                return fields.absent
            end
            item = item + 1ULL
        end
        local position = native.index((target - 1ULL) * 8ULL)
        local previous = native.load64(native.pointer(degree(state)), position)
        if previous == 0ULL then
            return fields.absent
        end
        native.store64(native.pointer(degree(state)), position, previous - 1ULL)
        if previous == 1ULL then
            if countReady >= get(state, native.fieldOffset<State>("blocks")) then
                return fields.absent
            end
            native.store64(native.pointer(queue(state)), native.index(countReady * 8ULL), target)
            countReady = countReady + 1ULL
        end
        at = at + 1ULL
    end

    return countReady
end

local function provenance(state: voidptr): uint64
    local descriptor = native.pointer(get(state, native.fieldOffset<State>("descriptor")))
    if native.load64(native.pointer(degree(state)), 0) ~= 0ULL then
        return 0ULL
    end
    native.store64(native.pointer(queue(state)), 0, 1ULL)
    local ready, at = 1ULL, 0ULL
    while at < ready do
        local id = native.load64(native.pointer(queue(state)), native.index(at * 8ULL))
        if id == 0ULL or id > get(state, native.fieldOffset<State>("blocks")) then
            return 0ULL
        end
        local block = blockRow(state, id)
        local params = row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsFirst)
        local length = row(descriptor, wire.S_blocks, block, fields.F_blocks_paramsCount)
        local item = 0ULL
        while item < length do
            if scalar(state, word(state, params + item)) == 0ULL then
                return 0ULL
            end
            item = item + 1ULL
        end
        local term = row(descriptor, wire.S_blocks, block, fields.F_blocks_term)
        if operationKinds(state, block) == 0ULL or termKinds(state, term) == 0ULL then
            return 0ULL
        end
        ready = transfer(state, term, ready)
        if ready == fields.absent then
            return 0ULL
        end
        at = at + 1ULL
    end
    if ready ~= get(state, native.fieldOffset<State>("blocks")) then
        return 0ULL
    end
    local expected = row(
        descriptor,
        wire.S_signatures,
        get(state, native.fieldOffset<State>("signature")),
        fields.F_signatures_result
    ) + 1ULL
    if get(state, native.fieldOffset<State>("returned")) ~= expected then
        return 0ULL
    end

    return 1ULL
end

local function graph(descriptor: voidptr, state: voidptr, index: uint64): uint64
    native.store64(state, native.fieldOffset<State>("descriptor"), native.address(descriptor))
    native.store64(state, native.fieldOffset<State>("graph"), index)
    native.store64(state, native.fieldOffset<State>("values"), graphField(state, fields.F_graphs_valuesCount))
    native.store64(state, native.fieldOffset<State>("parameters"), graphField(state, fields.F_graphs_nparams))
    native.store64(state, native.fieldOffset<State>("slots"), graphField(state, fields.F_graphs_nv))
    native.store64(state, native.fieldOffset<State>("valuesFirst"), graphField(state, fields.F_graphs_valuesFirst))
    native.store64(state, native.fieldOffset<State>("blocks"), graphField(state, fields.F_graphs_blocksCount))
    native.store64(state, native.fieldOffset<State>("blocksFirst"), graphField(state, fields.F_graphs_blocksFirst))
    native.store64(state, native.fieldOffset<State>("constants"), graphField(state, fields.F_graphs_constantsCount))
    native.store64(
        state,
        native.fieldOffset<State>("constantsFirst"),
        graphField(state, fields.F_graphs_constantsFirst)
    )
    native.store64(
        state,
        native.fieldOffset<State>("signature"),
        row(descriptor, wire.S_catalog, index, fields.F_catalog_signature)
    )
    native.store64(state, native.fieldOffset<State>("returned"), 0ULL)
    local values = get(state, native.fieldOffset<State>("values"))
    local params = get(state, native.fieldOffset<State>("parameters"))
    local blocks = get(state, native.fieldOffset<State>("blocks"))
    if values > limits.values or params > values or blocks == 0ULL or blocks > limits.blocks then
        return 0ULL
    end
    clear(defined(state), ((values + 63ULL) >> 6ULL) * 8ULL)
    clear(locals(state), values * 8ULL)
    clear(slots(state), get(state, native.fieldOffset<State>("slots")) * 8ULL)
    clear(degree(state), blocks * 8ULL)
    local signature = get(state, native.fieldOffset<State>("signature"))
    local first = row(descriptor, wire.S_signatures, signature, fields.F_signatures_paramsFirst)
    local id = 1ULL
    while id <= params do
        -- Global entry params need slot==id, not slot<counts.v. They never
        -- occupy a local slot epoch in the structural verifier.
        if row(
            descriptor,
            wire.S_values,
            get(state, native.fieldOffset<State>("valuesFirst")) + id - 1ULL,
            fields.F_values_slot
        ) ~= id then
            return 0ULL
        end
        local at, mask = native.index(((id - 1ULL) >> 6ULL) * 8ULL), 1ULL << ((id - 1ULL) & 63ULL)
        native.store64(native.pointer(defined(state)), at, native.load64(native.pointer(defined(state)), at) | mask)
        if assign(state, id, word(state, first + id - 1ULL) + 1ULL) == 0ULL then
            return 0ULL
        end
        id = id + 1ULL
    end
    if incoming(state) == 0ULL or structure(state) == 0ULL or provenance(state) == 0ULL then
        return 0ULL
    end

    return 1ULL
end

local function range(base: uint64, bytes: uint64): uint64
    if base == 0ULL or bytes == 0ULL or (base & 7ULL) ~= 0ULL or bytes > 0xffffffffffffffffULL - base then
        return 0ULL
    end
    return 1ULL
end

local function overlaps(a: uint64, an: uint64, b: uint64, bn: uint64): boolean
    return a < b + bn and b < a + an
end

export function admit(
    data: voidptr,
    dataBytes: uint64,
    out: voidptr,
    outBytes: uint64,
    pool: voidptr,
    poolBytes: uint64,
    helper: voidptr,
    helperBytes: uint64
): uint64
    local d, o, p, h = native.address(data), native.address(out), native.address(pool), native.address(helper)
    local descriptor = native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>()
    local fixed = workspaceBytes(0ULL, 0ULL)
    if range(d, dataBytes) == 0ULL
        or range(o, outBytes) == 0ULL
        or range(p, poolBytes) == 0ULL
        or range(h, helperBytes) == 0ULL
    then
        return 0ULL
    end
    if dataBytes < wire.minimumBytes
        or dataBytes > wire.fileLimit
        or outBytes < descriptor
        or poolBytes < fixed
        or helperBytes < 16ULL
    then
        return 0ULL
    end
    if overlaps(d, dataBytes, o, outBytes)
        or overlaps(d, dataBytes, p, poolBytes)
        or overlaps(d, dataBytes, h, helperBytes)
        or overlaps(o, outBytes, p, poolBytes)
        or overlaps(o, outBytes, h, helperBytes)
        or overlaps(p, poolBytes, h, helperBytes)
    then
        return 0ULL
    end
    local at = 0ULL
    while at < descriptor do
        if native.load64(out, native.index(at)) ~= 0ULL then
            return 0ULL
        end
        at = at + 8ULL
    end
    at = 0ULL
    while at < descriptor do
        native.store64(pool, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local work = native.offset(pool, native.index(descriptor))
    if catalog.admit(data, dataBytes, pool, descriptor, work, poolBytes - descriptor, helper, helperBytes) == 0ULL then
        return 0ULL
    end
    if budget.admitted(pool, work) == 0ULL then
        return 0ULL
    end
    local index = 0ULL
    while index < count(pool, wire.S_graphs) do
        if graph(pool, work, index) == 0ULL then
            return 0ULL
        end
        index = index + 1ULL
    end
    at = 8ULL
    while at < descriptor do
        native.store64(out, native.index(at), native.load64(pool, native.index(at)))
        at = at + 8ULL
    end
    native.store64(out, native.fieldOffset<header.Descriptor>("phase"), 4ULL)

    return 1ULL
end
