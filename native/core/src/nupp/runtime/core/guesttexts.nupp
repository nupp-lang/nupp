module nupp.runtime.core.guesttexts

-- The texts the core's library errors are built from, Lua 5.5's own, kept
-- as code because a leaf has no data: each appends its bytes to a builder.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const guestscope = require("nupp.runtime.core.guestscope")
const strings = require("nupp.runtime.core.corestrings")

-- Each text is its bytes as little-endian words, eight to a word.
export const TEXT_BAD: uint64 = 1ULL
export const TEXT_TO: uint64 = 2ULL
export const TEXT_OPEN: uint64 = 3ULL
export const TEXT_CLOSE: uint64 = 4ULL
export const TEXT_EXPECTED: uint64 = 5ULL
export const TEXT_NO_VALUE: uint64 = 6ULL
export const TEXT_STRING: uint64 = 7ULL
export const TEXT_NUMBER: uint64 = 8ULL
export const TEXT_TABLE: uint64 = 9ULL
export const TEXT_REPLACEMENT_KINDS: uint64 = 10ULL
export const TEXT_NO_INTEGER: uint64 = 11ULL
export const TEXT_EMPTY_INTERVAL: uint64 = 12ULL
export const TEXT_OUT_OF_BOUNDS: uint64 = 13ULL
export const TEXT_ZERO: uint64 = 14ULL
export const TEXT_VALUE_RANGE: uint64 = 15ULL
export const TEXT_INDEX_RANGE: uint64 = 16ULL
export const TEXT_TOO_MANY_MOVE: uint64 = 17ULL
export const TEXT_WRAP: uint64 = 18ULL
export const TEXT_VALUE_EXPECTED: uint64 = 19ULL
export const TEXT_NO_LITERAL: uint64 = 20ULL
export const TEXT_INVALID_CONCAT: uint64 = 21ULL
export const TEXT_IN_CONCAT: uint64 = 22ULL
export const TEXT_INVALID_REPLACEMENT: uint64 = 23ULL
export const TEXT_CAPTURE_INDEX: uint64 = 24ULL
export const TEXT_AT_INDEX: uint64 = 25ULL
export const TEXT_PERCENT_USE: uint64 = 26ULL
export const TEXT_UNFINISHED: uint64 = 27ULL
export const TEXT_UNPACK_MANY: uint64 = 28ULL
export const TEXT_TOO_LARGE: uint64 = 29ULL
export const TEXT_WRONG_COUNT: uint64 = 30ULL
export const TEXT_CONVERSION: uint64 = 31ULL
export const TEXT_TO_FORMAT: uint64 = 32ULL
export const TEXT_Q_MODIFIERS: uint64 = 33ULL
export const TEXT_NEXT_KEY: uint64 = 34ULL
export const TEXT_IDIV_ZERO: uint64 = 35ULL
export const NAME_TOSTRING: uint64 = 36ULL
export const NAME_FORMAT: uint64 = 37ULL
export const NAME_CONCAT: uint64 = 38ULL
export const NAME_GMATCH: uint64 = 39ULL
export const NAME_NEXT: uint64 = 40ULL
export const NAME_TONUMBER: uint64 = 41ULL
export const NAME_GETENV: uint64 = 42ULL
export const NAME_SUB: uint64 = 43ULL
export const NAME_BYTE: uint64 = 44ULL
export const NAME_CHAR: uint64 = 45ULL
export const NAME_REP: uint64 = 46ULL
export const NAME_UPPER: uint64 = 47ULL
export const NAME_LOWER: uint64 = 48ULL
export const NAME_LEN: uint64 = 49ULL
export const NAME_FIND: uint64 = 50ULL
export const NAME_MATCH: uint64 = 51ULL
export const NAME_SELECT: uint64 = 52ULL
export const NAME_GSUB: uint64 = 53ULL
export const NAME_SETMETATABLE: uint64 = 54ULL
export const NAME_GETMETATABLE: uint64 = 55ULL
export const NAME_RAWGET: uint64 = 56ULL
export const NAME_RAWSET: uint64 = 57ULL
export const NAME_TYPE: uint64 = 58ULL
export const NAME_INSERT: uint64 = 59ULL
export const NAME_REMOVE: uint64 = 60ULL
export const NAME_UNPACK: uint64 = 61ULL
export const NAME_ABS: uint64 = 62ULL
export const NAME_CEIL: uint64 = 63ULL
export const NAME_MAX: uint64 = 64ULL
export const NAME_MIN: uint64 = 65ULL
export const NAME_TOINTEGER: uint64 = 66ULL
export const NAME_SQRT: uint64 = 67ULL
export const NAME_SORT: uint64 = 68ULL
export const NAME_PRINT: uint64 = 69ULL
export const NAME_EXP: uint64 = 70ULL
export const NAME_LOG: uint64 = 71ULL
export const NAME_SIN: uint64 = 72ULL
export const NAME_COS: uint64 = 73ULL
export const NAME_TAN: uint64 = 74ULL
export const NAME_ASIN: uint64 = 75ULL
export const NAME_ACOS: uint64 = 76ULL
export const NAME_ATAN: uint64 = 77ULL
export const NAME_FMOD: uint64 = 78ULL
export const NAME_REVERSE: uint64 = 79ULL
export const NAME_MOVE: uint64 = 80ULL
export const NAME_RANDOM: uint64 = 81ULL
export const NAME_RANDOMSEED: uint64 = 82ULL
export const TEXT_CALLING: uint64 = 83ULL
export const TEXT_BAD_SELF: uint64 = 84ULL
export const TEXT_SUSPENDED: uint64 = 85ULL
export const TEXT_RUNNING: uint64 = 86ULL
export const TEXT_NORMAL: uint64 = 87ULL
export const TEXT_DEAD: uint64 = 88ULL
export const TEXT_RESUME_DEAD: uint64 = 89ULL
export const TEXT_RESUME_ACTIVE: uint64 = 90ULL
export const TEXT_YIELD_OUTSIDE: uint64 = 91ULL
export const TEXT_COROUTINE: uint64 = 92ULL
export const NAME_CREATE: uint64 = 93ULL
export const NAME_RESUME: uint64 = 94ULL
export const NAME_YIELD: uint64 = 95ULL
export const NAME_STATUS: uint64 = 96ULL
export const NAME_WRAP: uint64 = 97ULL
export const NAME_ISYIELDABLE: uint64 = 98ULL
export const TEXT_FUNCTION: uint64 = 99ULL
export const TEXT_CLOSE_MAIN: uint64 = 100ULL
export const TEXT_CLOSE_NORMAL: uint64 = 101ULL
export const NAME_CLOSE: uint64 = 102ULL
export const NAME_WRITE: uint64 = 103ULL

export function appendLibraryText(h: heap.Heap*, b: strings.Builder*, id: uint64): uint64
    if id == TEXT_BAD then
        -- "bad argument #"
        return strings.appendWord(h, b, 0x7567726120646162ULL, 8ULL) | strings.appendWord(h, b, 0x2320746e656dULL, 6ULL)
    elseif id == TEXT_TO then
        -- " to '"
        return strings.appendWord(h, b, 0x27206f7420ULL, 5ULL)
    elseif id == TEXT_OPEN then
        -- "' ("
        return strings.appendWord(h, b, 0x282027ULL, 3ULL)
    elseif id == TEXT_CLOSE then
        -- ")"
        return strings.appendWord(h, b, 0x29ULL, 1ULL)
    elseif id == TEXT_EXPECTED then
        -- " expected, got "
        return strings.appendWord(h, b, 0x6574636570786520ULL, 8ULL)
            | strings.appendWord(h, b, 0x20746f67202c64ULL, 7ULL)
    elseif id == TEXT_NO_VALUE then
        -- "no value"
        return strings.appendWord(h, b, 0x65756c6176206f6eULL, 8ULL)
    elseif id == TEXT_STRING then
        -- "string"
        return strings.appendWord(h, b, 0x676e69727473ULL, 6ULL)
    elseif id == TEXT_NUMBER then
        -- "number"
        return strings.appendWord(h, b, 0x7265626d756eULL, 6ULL)
    elseif id == TEXT_TABLE then
        -- "table"
        return strings.appendWord(h, b, 0x656c626174ULL, 5ULL)
    elseif id == TEXT_REPLACEMENT_KINDS then
        -- "string/function/table"
        return strings.appendWord(h, b, 0x662f676e69727473ULL, 8ULL)
            | strings.appendWord(h, b, 0x2f6e6f6974636e75ULL, 8ULL)
            | strings.appendWord(h, b, 0x656c626174ULL, 5ULL)
    elseif id == TEXT_NO_INTEGER then
        -- "number has no integer representation"
        return strings.appendWord(h, b, 0x68207265626d756eULL, 8ULL)
            | strings.appendWord(h, b, 0x6e69206f6e207361ULL, 8ULL)
            | strings.appendWord(h, b, 0x6572207265676574ULL, 8ULL)
            | strings.appendWord(h, b, 0x61746e6573657270ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f6974ULL, 4ULL)
    elseif id == TEXT_EMPTY_INTERVAL then
        -- "interval is empty"
        return strings.appendWord(h, b, 0x6c61767265746e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x74706d6520736920ULL, 8ULL)
            | strings.appendWord(h, b, 0x79ULL, 1ULL)
    elseif id == TEXT_OUT_OF_BOUNDS then
        -- "position out of bounds"
        return strings.appendWord(h, b, 0x6e6f697469736f70ULL, 8ULL)
            | strings.appendWord(h, b, 0x20666f2074756f20ULL, 8ULL)
            | strings.appendWord(h, b, 0x73646e756f62ULL, 6ULL)
    elseif id == TEXT_ZERO then
        -- "zero"
        return strings.appendWord(h, b, 0x6f72657aULL, 4ULL)
    elseif id == TEXT_VALUE_RANGE then
        -- "value out of range"
        return strings.appendWord(h, b, 0x756f2065756c6176ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e617220666f2074ULL, 8ULL)
            | strings.appendWord(h, b, 0x6567ULL, 2ULL)
    elseif id == TEXT_INDEX_RANGE then
        -- "index out of range"
        return strings.appendWord(h, b, 0x756f207865646e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e617220666f2074ULL, 8ULL)
            | strings.appendWord(h, b, 0x6567ULL, 2ULL)
    elseif id == TEXT_TOO_MANY_MOVE then
        -- "too many elements to move"
        return strings.appendWord(h, b, 0x796e616d206f6f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x746e656d656c6520ULL, 8ULL)
            | strings.appendWord(h, b, 0x766f6d206f742073ULL, 8ULL)
            | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == TEXT_WRAP then
        -- "destination wrap around"
        return strings.appendWord(h, b, 0x74616e6974736564ULL, 8ULL)
            | strings.appendWord(h, b, 0x70617277206e6f69ULL, 8ULL)
            | strings.appendWord(h, b, 0x646e756f726120ULL, 7ULL)
    elseif id == TEXT_VALUE_EXPECTED then
        -- "value expected"
        return strings.appendWord(h, b, 0x78652065756c6176ULL, 8ULL) | strings.appendWord(h, b, 0x646574636570ULL, 6ULL)
    elseif id == TEXT_NO_LITERAL then
        -- "value has no literal form"
        return strings.appendWord(h, b, 0x61682065756c6176ULL, 8ULL)
            | strings.appendWord(h, b, 0x74696c206f6e2073ULL, 8ULL)
            | strings.appendWord(h, b, 0x726f66206c617265ULL, 8ULL)
            | strings.appendWord(h, b, 0x6dULL, 1ULL)
    elseif id == TEXT_INVALID_CONCAT then
        -- "invalid value ("
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x282065756c6176ULL, 7ULL)
    elseif id == TEXT_IN_CONCAT then
        -- " in table for 'concat'"
        return strings.appendWord(h, b, 0x6c626174206e6920ULL, 8ULL)
            | strings.appendWord(h, b, 0x632720726f662065ULL, 8ULL)
            | strings.appendWord(h, b, 0x277461636e6fULL, 6ULL)
    elseif id == TEXT_INVALID_REPLACEMENT then
        -- "invalid replacement value (a "
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x6d6563616c706572ULL, 8ULL)
            | strings.appendWord(h, b, 0x756c617620746e65ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061282065ULL, 5ULL)
    elseif id == TEXT_CAPTURE_INDEX then
        -- "invalid capture index %"
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x2065727574706163ULL, 8ULL)
            | strings.appendWord(h, b, 0x25207865646e69ULL, 7ULL)
    elseif id == TEXT_AT_INDEX then
        -- ") at index "
        return strings.appendWord(h, b, 0x646e692074612029ULL, 8ULL) | strings.appendWord(h, b, 0x207865ULL, 3ULL)
    elseif id == TEXT_PERCENT_USE then
        -- "invalid use of '%' in replacement string"
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x2720666f20657375ULL, 8ULL)
            | strings.appendWord(h, b, 0x6572206e69202725ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e656d6563616c70ULL, 8ULL)
            | strings.appendWord(h, b, 0x676e697274732074ULL, 8ULL)
    elseif id == TEXT_UNFINISHED then
        -- "unfinished capture"
        return strings.appendWord(h, b, 0x6873696e69666e75ULL, 8ULL)
            | strings.appendWord(h, b, 0x7574706163206465ULL, 8ULL)
            | strings.appendWord(h, b, 0x6572ULL, 2ULL)
    elseif id == TEXT_UNPACK_MANY then
        -- "too many results to unpack"
        return strings.appendWord(h, b, 0x796e616d206f6f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x73746c7573657220ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706e75206f7420ULL, 8ULL)
            | strings.appendWord(h, b, 0x6b63ULL, 2ULL)
    elseif id == TEXT_TOO_LARGE then
        -- "resulting string too large"
        return strings.appendWord(h, b, 0x6e69746c75736572ULL, 8ULL)
            | strings.appendWord(h, b, 0x676e697274732067ULL, 8ULL)
            | strings.appendWord(h, b, 0x72616c206f6f7420ULL, 8ULL)
            | strings.appendWord(h, b, 0x6567ULL, 2ULL)
    elseif id == TEXT_WRONG_COUNT then
        -- "wrong number of arguments"
        return strings.appendWord(h, b, 0x756e20676e6f7277ULL, 8ULL)
            | strings.appendWord(h, b, 0x20666f207265626dULL, 8ULL)
            | strings.appendWord(h, b, 0x746e656d75677261ULL, 8ULL)
            | strings.appendWord(h, b, 0x73ULL, 1ULL)
    elseif id == TEXT_CONVERSION then
        -- "invalid conversion '"
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x69737265766e6f63ULL, 8ULL)
            | strings.appendWord(h, b, 0x27206e6fULL, 4ULL)
    elseif id == TEXT_TO_FORMAT then
        -- "' to 'format'"
        return strings.appendWord(h, b, 0x6f6627206f742027ULL, 8ULL) | strings.appendWord(h, b, 0x2774616d72ULL, 5ULL)
    elseif id == TEXT_Q_MODIFIERS then
        -- "specifier '%q' cannot have modifiers"
        return strings.appendWord(h, b, 0x6569666963657073ULL, 8ULL)
            | strings.appendWord(h, b, 0x6320277125272072ULL, 8ULL)
            | strings.appendWord(h, b, 0x616820746f6e6e61ULL, 8ULL)
            | strings.appendWord(h, b, 0x6669646f6d206576ULL, 8ULL)
            | strings.appendWord(h, b, 0x73726569ULL, 4ULL)
    elseif id == TEXT_NEXT_KEY then
        -- "invalid key to 'next'"
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x27206f742079656bULL, 8ULL)
            | strings.appendWord(h, b, 0x277478656eULL, 5ULL)
    elseif id == TEXT_IDIV_ZERO then
        -- "attempt to perform 'n//0'"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x302f2f6e27206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x27ULL, 1ULL)
    elseif id == NAME_TOSTRING then
        -- "tostring"
        return strings.appendWord(h, b, 0x676e697274736f74ULL, 8ULL)
    elseif id == NAME_FORMAT then
        -- "format"
        return strings.appendWord(h, b, 0x74616d726f66ULL, 6ULL)
    elseif id == NAME_CONCAT then
        -- "concat"
        return strings.appendWord(h, b, 0x7461636e6f63ULL, 6ULL)
    elseif id == NAME_GMATCH then
        -- "gmatch"
        return strings.appendWord(h, b, 0x686374616d67ULL, 6ULL)
    elseif id == NAME_NEXT then
        -- "next"
        return strings.appendWord(h, b, 0x7478656eULL, 4ULL)
    elseif id == NAME_TONUMBER then
        -- "tonumber"
        return strings.appendWord(h, b, 0x7265626d756e6f74ULL, 8ULL)
    elseif id == NAME_GETENV then
        -- "getenv"
        return strings.appendWord(h, b, 0x766e65746567ULL, 6ULL)
    elseif id == NAME_SUB then
        -- "sub"
        return strings.appendWord(h, b, 0x627573ULL, 3ULL)
    elseif id == NAME_BYTE then
        -- "byte"
        return strings.appendWord(h, b, 0x65747962ULL, 4ULL)
    elseif id == NAME_CHAR then
        -- "char"
        return strings.appendWord(h, b, 0x72616863ULL, 4ULL)
    elseif id == NAME_REP then
        -- "rep"
        return strings.appendWord(h, b, 0x706572ULL, 3ULL)
    elseif id == NAME_UPPER then
        -- "upper"
        return strings.appendWord(h, b, 0x7265707075ULL, 5ULL)
    elseif id == NAME_LOWER then
        -- "lower"
        return strings.appendWord(h, b, 0x7265776f6cULL, 5ULL)
    elseif id == NAME_LEN then
        -- "len"
        return strings.appendWord(h, b, 0x6e656cULL, 3ULL)
    elseif id == NAME_FIND then
        -- "find"
        return strings.appendWord(h, b, 0x646e6966ULL, 4ULL)
    elseif id == NAME_MATCH then
        -- "match"
        return strings.appendWord(h, b, 0x686374616dULL, 5ULL)
    elseif id == NAME_SELECT then
        -- "select"
        return strings.appendWord(h, b, 0x7463656c6573ULL, 6ULL)
    elseif id == NAME_GSUB then
        -- "gsub"
        return strings.appendWord(h, b, 0x62757367ULL, 4ULL)
    elseif id == NAME_SETMETATABLE then
        -- "setmetatable"
        return strings.appendWord(h, b, 0x746174656d746573ULL, 8ULL) | strings.appendWord(h, b, 0x656c6261ULL, 4ULL)
    elseif id == NAME_GETMETATABLE then
        -- "getmetatable"
        return strings.appendWord(h, b, 0x746174656d746567ULL, 8ULL) | strings.appendWord(h, b, 0x656c6261ULL, 4ULL)
    elseif id == NAME_RAWGET then
        -- "rawget"
        return strings.appendWord(h, b, 0x746567776172ULL, 6ULL)
    elseif id == NAME_RAWSET then
        -- "rawset"
        return strings.appendWord(h, b, 0x746573776172ULL, 6ULL)
    elseif id == NAME_TYPE then
        -- "type"
        return strings.appendWord(h, b, 0x65707974ULL, 4ULL)
    elseif id == NAME_INSERT then
        -- "insert"
        return strings.appendWord(h, b, 0x747265736e69ULL, 6ULL)
    elseif id == NAME_REMOVE then
        -- "remove"
        return strings.appendWord(h, b, 0x65766f6d6572ULL, 6ULL)
    elseif id == NAME_UNPACK then
        -- "unpack"
        return strings.appendWord(h, b, 0x6b6361706e75ULL, 6ULL)
    elseif id == NAME_ABS then
        -- "abs"
        return strings.appendWord(h, b, 0x736261ULL, 3ULL)
    elseif id == NAME_CEIL then
        -- "ceil"
        return strings.appendWord(h, b, 0x6c696563ULL, 4ULL)
    elseif id == NAME_MAX then
        -- "max"
        return strings.appendWord(h, b, 0x78616dULL, 3ULL)
    elseif id == NAME_MIN then
        -- "min"
        return strings.appendWord(h, b, 0x6e696dULL, 3ULL)
    elseif id == NAME_TOINTEGER then
        -- "tointeger"
        return strings.appendWord(h, b, 0x656765746e696f74ULL, 8ULL) | strings.appendWord(h, b, 0x72ULL, 1ULL)
    elseif id == NAME_SQRT then
        -- "sqrt"
        return strings.appendWord(h, b, 0x74727173ULL, 4ULL)
    elseif id == NAME_SORT then
        -- "sort"
        return strings.appendWord(h, b, 0x74726f73ULL, 4ULL)
    elseif id == NAME_PRINT then
        -- "print"
        return strings.appendWord(h, b, 0x746e697270ULL, 5ULL)
    elseif id == NAME_EXP then
        -- "exp"
        return strings.appendWord(h, b, 0x707865ULL, 3ULL)
    elseif id == NAME_LOG then
        -- "log"
        return strings.appendWord(h, b, 0x676f6cULL, 3ULL)
    elseif id == NAME_SIN then
        -- "sin"
        return strings.appendWord(h, b, 0x6e6973ULL, 3ULL)
    elseif id == NAME_COS then
        -- "cos"
        return strings.appendWord(h, b, 0x736f63ULL, 3ULL)
    elseif id == NAME_TAN then
        -- "tan"
        return strings.appendWord(h, b, 0x6e6174ULL, 3ULL)
    elseif id == NAME_ASIN then
        -- "asin"
        return strings.appendWord(h, b, 0x6e697361ULL, 4ULL)
    elseif id == NAME_ACOS then
        -- "acos"
        return strings.appendWord(h, b, 0x736f6361ULL, 4ULL)
    elseif id == NAME_ATAN then
        -- "atan"
        return strings.appendWord(h, b, 0x6e617461ULL, 4ULL)
    elseif id == NAME_FMOD then
        -- "fmod"
        return strings.appendWord(h, b, 0x646f6d66ULL, 4ULL)
    elseif id == NAME_REVERSE then
        -- "reverse"
        return strings.appendWord(h, b, 0x65737265766572ULL, 7ULL)
    elseif id == NAME_MOVE then
        -- "move"
        return strings.appendWord(h, b, 0x65766f6dULL, 4ULL)
    elseif id == NAME_RANDOM then
        -- "random"
        return strings.appendWord(h, b, 0x6d6f646e6172ULL, 6ULL)
    elseif id == NAME_RANDOMSEED then
        -- "randomseed"
        return strings.appendWord(h, b, 0x65736d6f646e6172ULL, 8ULL) | strings.appendWord(h, b, 0x6465ULL, 2ULL)
    elseif id == TEXT_CALLING then
        -- "calling '"
        return strings.appendWord(h, b, 0x20676e696c6c6163ULL, 8ULL) | strings.appendWord(h, b, 0x27ULL, 1ULL)
    elseif id == TEXT_BAD_SELF then
        -- "' on bad self ("
        return strings.appendWord(h, b, 0x646162206e6f2027ULL, 8ULL)
            | strings.appendWord(h, b, 0x2820666c657320ULL, 7ULL)
    elseif id == TEXT_SUSPENDED then
        -- "suspended"
        return strings.appendWord(h, b, 0x65646e6570737573ULL, 8ULL) | strings.appendWord(h, b, 0x64ULL, 1ULL)
    elseif id == TEXT_RUNNING then
        -- "running"
        return strings.appendWord(h, b, 0x676e696e6e7572ULL, 7ULL)
    elseif id == TEXT_NORMAL then
        -- "normal"
        return strings.appendWord(h, b, 0x6c616d726f6eULL, 6ULL)
    elseif id == TEXT_DEAD then
        -- "dead"
        return strings.appendWord(h, b, 0x64616564ULL, 4ULL)
    elseif id == TEXT_RESUME_DEAD then
        -- "cannot resume dead coroutine"
        return strings.appendWord(h, b, 0x7220746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x656420656d757365ULL, 8ULL)
            | strings.appendWord(h, b, 0x756f726f63206461ULL, 8ULL)
            | strings.appendWord(h, b, 0x656e6974ULL, 4ULL)
    elseif id == TEXT_RESUME_ACTIVE then
        -- "cannot resume non-suspended coroutine"
        return strings.appendWord(h, b, 0x7220746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f6e20656d757365ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e65707375732d6eULL, 8ULL)
            | strings.appendWord(h, b, 0x6f726f6320646564ULL, 8ULL)
            | strings.appendWord(h, b, 0x656e697475ULL, 5ULL)
    elseif id == TEXT_YIELD_OUTSIDE then
        -- "attempt to yield from outside a coroutine"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x646c656979206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x756f206d6f726620ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061206564697374ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6974756f726f63ULL, 8ULL)
            | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == TEXT_COROUTINE then
        -- "coroutine"
        return strings.appendWord(h, b, 0x6e6974756f726f63ULL, 8ULL) | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == NAME_CREATE then
        -- "create"
        return strings.appendWord(h, b, 0x657461657263ULL, 6ULL)
    elseif id == NAME_RESUME then
        -- "resume"
        return strings.appendWord(h, b, 0x656d75736572ULL, 6ULL)
    elseif id == NAME_YIELD then
        -- "yield"
        return strings.appendWord(h, b, 0x646c656979ULL, 5ULL)
    elseif id == NAME_STATUS then
        -- "status"
        return strings.appendWord(h, b, 0x737574617473ULL, 6ULL)
    elseif id == NAME_WRAP then
        -- "wrap"
        return strings.appendWord(h, b, 0x70617277ULL, 4ULL)
    elseif id == NAME_ISYIELDABLE then
        -- "isyieldable"
        return strings.appendWord(h, b, 0x61646c6569797369ULL, 8ULL) | strings.appendWord(h, b, 0x656c62ULL, 3ULL)
    elseif id == TEXT_FUNCTION then
        -- "function"
        return strings.appendWord(h, b, 0x6e6f6974636e7566ULL, 8ULL)
    elseif id == TEXT_CLOSE_MAIN then
        -- "cannot close main thread"
        return strings.appendWord(h, b, 0x6320746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x69616d2065736f6cULL, 8ULL)
            | strings.appendWord(h, b, 0x646165726874206eULL, 8ULL)
    elseif id == TEXT_CLOSE_NORMAL then
        -- "cannot close a normal coroutine"
        return strings.appendWord(h, b, 0x6320746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e20612065736f6cULL, 8ULL)
            | strings.appendWord(h, b, 0x6f63206c616d726fULL, 8ULL)
            | strings.appendWord(h, b, 0x656e6974756f72ULL, 7ULL)
    elseif id == NAME_CLOSE then
        -- "close"
        return strings.appendWord(h, b, 0x65736f6c63ULL, 5ULL)
    elseif id == NAME_WRITE then
        -- "write"
        return strings.appendWord(h, b, 0x6574697277ULL, 5ULL)
    end

    return 0ULL
end

local function guestHeap(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- Raises `message`, a string built on the guest heap, as Lua raises a
-- library's errors: with the position of the line that called it.
local function raiseText(ctx: voidptr, h: heap.Heap*, b: strings.Builder*, refused: uint64): nil
    @unsafe do
        if refused ~= 0ULL then
            strings.release(b)
            error("not enough memory")
        end
        guestscope.raiseLibrary(ctx, values.TAG_OBJ | strings.finish(h, b))
        error("library error")
    end
end

-- One of the library's texts as a string value.
export function textvalue(ctx: voidptr, id: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if appendLibraryText(h, builder, id) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- Raises one of the library's whole
export function libraryError(ctx: voidptr, text: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        raiseText(ctx, h, builder, appendLibraryText(h, builder, text))
    end
end

-- Raises "bad argument #n to 'name' (detail)": with `expected`, the detail is
-- "T expected, got U", U being the argument's type or "no value" past the
-- call's arguments; else it is the text `detail`.
export function argumentError(ctx: voidptr, position: uint64, expected: uint64, detail: uint64, value: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        -- A method call counts from the argument after self, as Lua does,
        -- and self itself is "calling 'name' on bad self (...)".
        local shown = position
        if guestscope.libraryMethod(ctx) == 1ULL then
            shown = position - 1ULL
        end
        local refused: uint64 = 0ULL
        if shown == 0ULL then
            refused = appendLibraryText(h, builder, TEXT_CALLING)
                | appendLibraryText(h, builder, guestscope.libraryNameOf(ctx))
                | appendLibraryText(h, builder, TEXT_BAD_SELF)
        else
            refused = appendLibraryText(h, builder, TEXT_BAD)
                | strings.appendInteger(h, builder, native.index(shown))
                | appendLibraryText(h, builder, TEXT_TO)
                | appendLibraryText(h, builder, guestscope.libraryNameOf(ctx))
                | appendLibraryText(h, builder, TEXT_OPEN)
        end
        if expected ~= 0ULL then
            refused = refused | appendLibraryText(h, builder, expected) | appendLibraryText(h, builder, TEXT_EXPECTED)
            if position > guestscope.libraryCount(ctx) then
                refused = refused | appendLibraryText(h, builder, TEXT_NO_VALUE)
            else
                refused = refused | strings.appendString(h, builder, strings.header(guestscope.typeName(ctx, value)))
            end
        else
            refused = refused | appendLibraryText(h, builder, detail)
        end
        raiseText(ctx, h, builder, refused | appendLibraryText(h, builder, TEXT_CLOSE))
    end
end

-- Raises `prefix`, the integer n, then `suffix` (0 for none): gsub's
-- invalid capture index.
export function indexedError(ctx: voidptr, prefix: uint64, n: int64, suffix: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = appendLibraryText(h, builder, prefix)
            | strings.appendInteger(h, builder, n)
            | appendLibraryText(h, builder, suffix)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid value (T) at index n in table for 'concat'".
export function concatError(ctx: voidptr, value: uint64, n: int64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = appendLibraryText(h, builder, TEXT_INVALID_CONCAT)
            | strings.appendString(h, builder, strings.header(guestscope.typeName(ctx, value)))
            | appendLibraryText(h, builder, TEXT_AT_INDEX)
            | strings.appendInteger(h, builder, n)
            | appendLibraryText(h, builder, TEXT_IN_CONCAT)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid replacement value (a T)" for gsub's replacement `value`.
export function replacementError(ctx: voidptr, value: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = appendLibraryText(h, builder, TEXT_INVALID_REPLACEMENT)
            | strings.appendString(h, builder, strings.header(guestscope.typeName(ctx, value)))
            | appendLibraryText(h, builder, TEXT_CLOSE)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid conversion '%...' to 'format'" naming the directive from
-- its '%' at `spec` through `p`.
export function conversionError(ctx: voidptr, spec: uint64, p: uint64, finish: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local last = p + 1ULL
        if last > finish then
            last = finish
        end
        local refused = appendLibraryText(h, builder, TEXT_CONVERSION)
            | strings.append(h, builder, spec, last - spec)
            | appendLibraryText(h, builder, TEXT_TO_FORMAT)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises a runtime error (a guestscope FAULT_ kind and its operands) where a
-- library call meets it.
export function faultError(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    guestscope.raiseFault(ctx, kind, culprit, other)
    error("library error")
end
