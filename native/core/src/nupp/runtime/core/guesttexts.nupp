module nupp.runtime.core.guesttexts

-- The core library's errors, built from its texts (librarytexts), Lua 5.5's
-- own.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const guestscope = require("nupp.runtime.core.guestscope")
const frames = require("nupp.runtime.core.frames")
const strings = require("nupp.runtime.core.corestrings")
const librarytexts = require("nupp.runtime.core.librarytexts")
const guesterrors = require("nupp.runtime.core.guesterrors")

local function guestHeap(ctx: voidptr): heap.Heap*
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        return native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
    end
end

-- Raises `message`, a string built on the guest heap, as Lua raises a
-- library's errors: with the position of the line that called it.
local function raiseText(ctx: voidptr, h: heap.Heap*, b: strings.Builder*, refused: uint64): nil
    @unsafe do
        if refused ~= 0ULL then
            strings.release(b)
            error("not enough memory")
        end
        guestscope.raiseLibrary(ctx, values.TAG_OBJ | strings.finish(h, b))
        error("library error")
    end
end

-- One of the library's texts as a string value.
export function textvalue(ctx: voidptr, id: uint64): uint64
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        if librarytexts.append(h, builder, id) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        return values.TAG_OBJ | strings.finish(h, builder)
    end
end

-- When a call found no room for another frame: 1 having noted Lua's
-- "stack overflow", raised where the call is, for the caller to fail the
-- entry with as a guest error; 0 when the frames have room, and the call
-- failed for another reason.
export function overflow(ctx: voidptr): uint64
    local state = native.loadPointer(ctx, context.STATE)
    if native.load64(
        state,
        native.fieldOffset<frames.State>("depth")
    ) < native.load64(state, native.fieldOffset<frames.State>("limit")) then
        return 0ULL
    end
    guestscope.raise(ctx, textvalue(ctx, librarytexts.TEXT_STACK_OVERFLOW), 1ULL)

    return 1ULL
end

-- Raises "module 'name' not found:" and why, for a `require` of a name the
-- image holds no module by: Lua's first line, which code checks for, and
-- the core's reason in place of the paths Lua searched. As Lua's, it carries
-- no position, so the text starts with that line.
export function moduleNotFound(ctx: voidptr, name: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = strings.appendWord(h, builder, 0x2720656c75646f6dULL, 8ULL)
            | strings.appendString(h, builder, strings.header(name))
            | strings.appendWord(h, builder, 0x6f6620746f6e2027ULL, 8ULL)
            | strings.appendWord(h, builder, 0x3a646e75ULL, 4ULL)
            | strings.appendWord(h, builder, 0x646f6d206f6e090aULL, 8ULL)
            | strings.appendWord(h, builder, 0x7420666f20656c75ULL, 8ULL)
            | strings.appendWord(h, builder, 0x656d616e20746168ULL, 8ULL)
            | strings.appendWord(h, builder, 0x20656874206e6920ULL, 8ULL)
            | strings.appendWord(h, builder, 0x6567616d69ULL, 5ULL)
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local message = values.TAG_OBJ | strings.finish(h, builder)
        guestscope.raiseLibrary(ctx, message)
        guestscope.raise(ctx, message, 0ULL)
        error("library error")
    end
end

-- Raises one of the library's texts.
export function libraryError(ctx: voidptr, text: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        raiseText(ctx, h, builder, librarytexts.append(h, builder, text))
    end
end

-- Raises "bad argument #n to 'name' (detail)": with `expected`, the detail is
-- "T expected, got U", U being the argument's type or "no value" past the
-- call's arguments; else it is the text `detail`.
export function argumentError(ctx: voidptr, position: uint64, expected: uint64, detail: uint64, value: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        -- A method call counts from the argument after self, as Lua does,
        -- and self itself is "calling 'name' on bad self (...)".
        local shown = position
        if guestscope.libraryMethod(ctx) == 1ULL then
            shown = position - 1ULL
        end
        local refused: uint64 = 0ULL
        if shown == 0ULL then
            refused = librarytexts.append(h, builder, librarytexts.TEXT_CALLING)
                | librarytexts.append(h, builder, guestscope.libraryNameOf(ctx))
                | librarytexts.append(h, builder, librarytexts.TEXT_BAD_SELF)
        else
            refused = librarytexts.append(h, builder, librarytexts.TEXT_BAD)
                | strings.appendInteger(h, builder, native.index(shown))
                | librarytexts.append(h, builder, librarytexts.TEXT_TO)
                | librarytexts.append(h, builder, guestscope.libraryNameOf(ctx))
                | librarytexts.append(h, builder, librarytexts.TEXT_OPEN)
        end
        if expected ~= 0ULL then
            refused = refused
                | librarytexts.append(h, builder, expected)
                | librarytexts.append(h, builder, librarytexts.TEXT_EXPECTED)
            if position > guestscope.libraryCount(ctx) then
                refused = refused | librarytexts.append(h, builder, librarytexts.TEXT_NO_VALUE)
            else
                refused = refused | strings.appendString(h, builder, strings.header(guesterrors.typeName(ctx, value)))
            end
        else
            refused = refused | librarytexts.append(h, builder, detail)
        end
        raiseText(ctx, h, builder, refused | librarytexts.append(h, builder, librarytexts.TEXT_CLOSE))
    end
end

-- Raises "bad argument #n to 'name' (invalid option 'X')", X the text of
-- the string `value`, as Lua's luaL_checkoption does.
export function optionError(ctx: voidptr, position: uint64, value: uint64): nil
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = librarytexts.append(h, builder, librarytexts.TEXT_BAD)
            | strings.appendInteger(h, builder, native.index(position))
            | librarytexts.append(h, builder, librarytexts.TEXT_TO)
            | librarytexts.append(h, builder, guestscope.libraryNameOf(ctx))
            | librarytexts.append(h, builder, librarytexts.TEXT_OPEN)
            | librarytexts.append(h, builder, librarytexts.TEXT_INVALID_OPTION)
            | strings.appendString(h, builder, strings.header(value))
            | strings.appendWord(h, builder, 0x2927ULL, 2ULL)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises Lua 5.5's "bad 'for' limit (number expected, got <type>)".
export function forLimitError(ctx: voidptr, value: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = librarytexts.append(h, builder, librarytexts.TEXT_FOR_LIMIT)
            | strings.appendString(h, builder, strings.header(guesterrors.typeName(ctx, value)))
            | librarytexts.append(h, builder, librarytexts.TEXT_CLOSE)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises `prefix`, the integer n, then `suffix` (0 for none): gsub's
-- invalid capture index.
export function indexedError(ctx: voidptr, prefix: uint64, n: int64, suffix: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = librarytexts.append(h, builder, prefix)
            | strings.appendInteger(h, builder, n)
            | librarytexts.append(h, builder, suffix)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid value (T) at index n in table for 'concat'".
export function concatError(ctx: voidptr, value: uint64, n: int64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = librarytexts.append(h, builder, librarytexts.TEXT_INVALID_CONCAT)
            | strings.appendString(h, builder, strings.header(guesterrors.typeName(ctx, value)))
            | librarytexts.append(h, builder, librarytexts.TEXT_AT_INDEX)
            | strings.appendInteger(h, builder, n)
            | librarytexts.append(h, builder, librarytexts.TEXT_IN_CONCAT)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid replacement value (a T)" for gsub's replacement `value`.
export function replacementError(ctx: voidptr, value: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local refused = librarytexts.append(h, builder, librarytexts.TEXT_INVALID_REPLACEMENT)
            | strings.appendString(h, builder, strings.header(guesterrors.typeName(ctx, value)))
            | librarytexts.append(h, builder, librarytexts.TEXT_CLOSE)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises "invalid conversion '%...' to 'format'" naming the directive from
-- its '%' at `spec` through `p`.
export function conversionError(ctx: voidptr, spec: uint64, p: uint64, finish: uint64): nil
    local state = strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = guestHeap(ctx)
        local builder = state as strings.Builder*
        local last = p + 1ULL
        if last > finish then
            last = finish
        end
        local refused = librarytexts.append(h, builder, librarytexts.TEXT_CONVERSION)
            | strings.append(h, builder, spec, last - spec)
            | librarytexts.append(h, builder, librarytexts.TEXT_TO_FORMAT)
        raiseText(ctx, h, builder, refused)
    end
end

-- Raises a runtime error (a guestscope FAULT_ kind and its operands) where a
-- library call meets it.
export function faultError(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    guesterrors.raiseFault(ctx, kind, culprit, other)
    error("library error")
end
