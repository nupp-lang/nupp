module nupp.runtime.core.rawsemanticpolicy

-- Generated validation data. No opcode execution or source authority.

export const epochMask = 65535ULL
export const kindMask = 4294967295ULL
export const kindShift = 16ULL
export const maximumKind = 65538ULL
export const Kind_boolean = 1ULL
export const Kind_nil = 2ULL
export const Kind_function = 3ULL
export const P_constant = 2ULL
export const P_nil = 4ULL
export const P_copy = 8ULL
export const P_function = 16ULL
export const P_module = 32ULL
export const P_read = 1ULL

export function operation(id: uint64): uint64
    if id >= 5ULL then
        return 4294967295ULL
    end
    if id == 4ULL then
        return 16ULL
    end

    return (0x0009000400200002ULL >> (id * 16ULL)) & 65535ULL
end

export function constantKind(id: uint64): uint64
    if id >= 4ULL then
        return 4294967295ULL
    end
    return (0x0000000100010002ULL >> (id * 16ULL)) & 65535ULL
end

export const T_return = 1ULL
export const T_branch = 2ULL
export const T_invoke = 4ULL

export function term(id: uint64): uint64
    if id >= 4ULL then
        return 4294967295ULL
    end
    return (0x0004000200000001ULL >> (id * 16ULL)) & 65535ULL
end
