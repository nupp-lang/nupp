module nupp.runtime.core.guestscope

-- A guest entry's services: a page ledger and the service scope handlers make
-- scoped calls with, in caller-provided scratch, and the guest heap. The heap
-- lives for the whole entry rather than a lexical scope, so its arena is built
-- in place over one scoped mapping and torn down by close, not by an affine
-- owner.
const native = require("nupp.runtime.vm.intrinsics")
const os = require("nupp.runtime.vm.os")
const arena = require("nupp.runtime.vm.arena")
const heap = require("nupp.runtime.vm.heap")
const collector = require("nupp.runtime.vm.collector")
const pages = require("nupp.runtime.core.pagemappings")
const servicescope = require("nupp.runtime.core.servicescope")
const context = require("nupp.runtime.core.context")
const values = require("nupp.runtime.vm.values")
const tables = require("nupp.runtime.core.coretables")
const strings = require("nupp.runtime.core.corestrings")
const ints = require("nupp.runtime.core.coreintegers")
const catalog = require("nupp.runtime.core.guestcatalog")
const frames = require("nupp.runtime.core.frames")
const access = require("nupp.runtime.core.frameaccess")
const guestentry = require("nupp.runtime.core.guestentry")
const instances = require("nupp.runtime.core.instances")
const stacks = require("nupp.runtime.core.stacks")
const librarycalls = require("nupp.runtime.core.librarycalls")
const librarylayouts = require("nupp.runtime.core.librarylayouts")

-- The scope comes first, so a Services address is also its scope's address.
export struct Services
    scope: servicescope.ServiceScope
    heap: uint64
    arena: uint64
    -- The value error() raised that no protected call has taken yet, or 0,
    -- and the level it was raised at: 1 cites where error was called, 2 that
    -- function's caller, 0 nothing.
    raised: uint64
    raisedLevel: uint64
    -- What a handler's guest error was (a FAULT_ kind, 0 for none) and the
    -- operands its message names.
    fault: uint64
    culprit: uint64
    other: uint64
    -- The __index or __newindex function a table access found, and the
    -- table whose metatable named it, for its handler to call; 0 for none.
    metaCallee: uint64
    metaSelf: uint64
    -- The value the last recovered error carried, for xpcall's handler.
    lastError: uint64
    -- 1 while an error landed at a frame that owns affine values: its next
    -- status check (LANDED) takes the failure path, destroys them and raises
    -- lastError again.
    landed: uint64
    -- math.random's xoshiro256** state, all zero until the first draw or
    -- math.randomseed seeds it.
    random0: uint64
    random1: uint64
    random2: uint64
    random3: uint64
    -- The library call running (its function's name, a guesttexts NAME_, and
    -- its argument count) and its owner and pc, which a library error's
    -- position names; libraryRaised is 1 while `raised` holds such an error.
    libraryName: uint64
    libraryCount: uint64
    libraryOwner: uint64
    libraryPc: uint64
    libraryRaised: uint64
    -- 1 when the library call is in method form (`s:rep(n)`).
    libraryMethod: uint64
    -- 1 from a library call's start until it returns: an error the runtime's
    -- own code raises meanwhile is positioned at that call.
    libraryActive: uint64
    -- The coroutine running (`threads`), as a value rooted for as long as it
    -- runs, or 0 on the main one; and the main one's thread, once
    -- coroutine.running has made one.
    running: uint64
    main: uint64
    -- The loaded modules (`modules`): a table from chunk ids to values, once
    -- one is required.
    loaded: uint64
    -- The library calls waiting on a metamethod (`replaybegin`): a table
    -- of their entries, once one has waited.
    replays: uint64
    -- An object a library call holds while it allocates another, which
    -- nothing else roots yet (`hold`).
    scratch: uint64
    -- The metamethod names as strings, by META_ id, each made once.
    metanames: uint64
    -- The image's modules by name, each to its chunk, once the entry
    -- registers them for `require` of a computed name (`modules`).
    modulenames: uint64
    -- The cleanup functions by their checked keys ("module#name"), each set
    -- where its declaration runs, for an owner's cleanup to call
    -- (`guestbasics.cleanupset`), once one is.
    cleanups: uint64
    -- 1 while coroutine.close unwinds a suspended thread: its error lands at
    -- every frame that owns affine values, and no protected call takes it.
    closing: uint64
    -- The log of the library call running in replay (a table), or 0; how
    -- many of its accesses this run has made; 1 once one stopped for a
    -- metamethod, which kind of access it was, and its key and value; and
    -- the frame of a metamethod a library call waited on, as it returns.
    replay: uint64
    replaycursor: uint64
    replaysuspend: uint64
    replaykind: uint64
    replaykey: uint64
    replayvalue: uint64
    libraryanswer: uint64
    -- What the collector's oracle found wrong, kept when the heap closes.
    oraclefailures: uint64
    -- The entry's storage, when open mapped it, and its frame pool: their
    -- addresses (0 for none) and mapped bytes, which close unmaps.
    storage: uint64
    storagebytes: uint64
    pool: uint64
    poolbytes: uint64
    -- The initializers' storage, its stride and their count: their frame
    -- stacks' chunks past the pool, which close unmaps.
    stacks: uint64
    stride: uint64
    slots: uint64
    -- First chunks of finished coroutines' stacks, kept for the next ones,
    -- and how many (`stacks.first`).
    chunks: uint64
    chunkcount: uint64
end

-- tableSet's answer when a __newindex function is to be called instead.
export const META_PENDING: uint64 = 100ULL
-- tableSet's answer when the table it would store in is frozen.
export const READONLY: uint64 = 101ULL

export const FAULT_ARITH: uint64 = 1ULL
export const FAULT_MODZERO: uint64 = 2ULL
export const FAULT_COMPARE: uint64 = 3ULL
export const FAULT_LENGTH: uint64 = 4ULL
export const FAULT_INDEX: uint64 = 5ULL
export const FAULT_CALL: uint64 = 6ULL
export const FAULT_KEY: uint64 = 7ULL
export const FAULT_BITWISE: uint64 = 8ULL
export const FAULT_NOINT: uint64 = 9ULL
-- A store into a frozen table: Luau's "attempt to modify a readonly table".
export const FAULT_READONLY: uint64 = 10ULL

const LEDGER: uint64 = 256ULL
const RECORDS: uint64 = 256ULL
const HEAP_BYTES: uint64 = 16777216ULL

local function roundUp(value: uint64, alignment: uint64): uint64
    return (value + (alignment - 1ULL)) & ~(alignment - 1ULL)
end

-- The scratch region holds the ledger, its mapping records and the Services,
-- in that order. Answers the Services address; zero refuses.
export function prepare(base: voidptr, bytes: uint64): uint64
    local recordBytes = RECORDS * native.sizeOf<pages.Mapping>()
    local servicesOffset = LEDGER + recordBytes
    if bytes < servicesOffset + native.sizeOf<Services>() then
        return 0ULL
    end
    local records = native.offset(base, native.index(LEDGER))
    if pages.initialize(base, LEDGER, records, recordBytes, RECORDS) ~= 1ULL then
        return 0ULL
    end
    local services = native.offset(base, native.index(servicesOffset))
    if servicescope.initialize(services, native.sizeOf<servicescope.ServiceScope>(), base, LEDGER) ~= 1ULL then
        return 0ULL
    end
    native.store64(services, native.fieldOffset<Services>("heap"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("arena"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("storage"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("storagebytes"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("pool"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("poolbytes"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("stacks"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("stride"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("slots"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("chunks"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("chunkcount"), 0ULL)

    return native.address(services)
end

-- Maps `bytes` for the entry, its address noted in `field` and its mapped
-- bytes in the field after it for close to unmap; 0 when refused.
local function mapEntry(services: voidptr, field: int64, bytes: uint64): uint64
    local mapped = roundUp(bytes, os.pageSize())
    local base = os.mapPages(mapped)
    if base == nil then
        return 0ULL
    end
    native.store64(services, field, native.address(base as voidptr))
    native.store64(services, field + 8, mapped)

    return native.address(base as voidptr)
end

-- Maps the heap's arena and creates the heap in it; maps the frame pool,
-- `poolBytes`, the first chunk of each initializer's frame stack, which
-- grows past it in chunks of its own (none when 0: the pool lies in
-- scratch, as deep as the program's calls nest), and, when
-- `storage` is 0, the storage of `slots` initializers `stride` bytes apart,
-- which otherwise lies at `storage` in scratch. The module world and each
-- initializer's frame stack, up to its cursor, become root ranges: their
-- words may be stale, which root marking tolerates. Answers 1, or 0 when a
-- mapping is refused, leaving what was mapped for close.
export function open(
    services: voidptr,
    storage: uint64,
    stride: uint64,
    slots: uint64,
    poolBytes: uint64,
    world: uint64,
    stress: uint64
): uint64
    if slots == 0ULL or stride == 0ULL then
        return 0ULL
    end
    local slotstorage = storage
    if slotstorage == 0ULL then
        slotstorage = mapEntry(services, native.fieldOffset<Services>("storage"), slots * stride)
        if slotstorage == 0ULL then
            return 0ULL
        end
    end
    if poolBytes ~= 0ULL and mapEntry(services, native.fieldOffset<Services>("pool"), poolBytes) == 0ULL then
        return 0ULL
    end
    local metadata = roundUp(native.sizeOf<arena.Chunk>(), native.alignmentOf<arena.Arena>())
    local header = roundUp(metadata + native.sizeOf<arena.Arena>(), 16ULL)
    local mapped = roundUp(HEAP_BYTES + header, os.pageSize())
    local base = os.mapPages(mapped)
    if base == nil then
        return 0ULL
    end
    @unsafe do
        local chunk = base as arena.Chunk*
        local a = native.offset(base, native.index(metadata)) as arena.Arena*
        chunk.previous = nil
        chunk.bytes = mapped
        a.chunk = chunk
        a.cursor = native.address(base) + header
        a.limit = native.address(base) + mapped
        a.chunkBytes = mapped
        -- The heap's metadata grows with the guest: further chunks are mapped
        -- through the scope and unmapped by close.
        a.growable = true
        local h = heap.create(a)
        -- Generations (Decision 20) are kept from the first allocation on.
        h.generational = collector.GENERATIONAL
        native.store64(services, native.fieldOffset<Services>("stacks"), slotstorage)
        native.store64(services, native.fieldOffset<Services>("stride"), stride)
        native.store64(services, native.fieldOffset<Services>("slots"), slots)
        local slot: uint64 = 0ULL
        while slot < slots do
            collector.registerChain(
                h,
                slotstorage + slot * stride + native.word(native.fieldOffset<guestentry.Storage>("segment"))
            )
            slot = slot + 1ULL
        end
        collector.register(h, world, native.sizeOf<instances.World>() // 8ULL)
        native.store64(services, native.fieldOffset<Services>("running"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("main"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("loaded"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replays"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("scratch"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("metanames"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("modulenames"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("cleanups"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("closing"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replay"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replaycursor"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replaysuspend"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replaykind"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replaykey"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replayvalue"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryanswer"), 0ULL)
        collector.register(h, native.address(native.offset(services, native.fieldOffset<Services>("running"))), 8ULL)
        -- Collect-at-every-allocation (1): a whole cycle at every safepoint;
        -- interleaved (2): a small incremental step at every safepoint, the
        -- oracle checking each cycle's survivors. Both keep freed objects as
        -- tombstones never reused.
        h.stress = stress == 1ULL
        h.interleave = stress == 2ULL
        h.oracle = stress == 2ULL
        h.quarantine = stress == 2ULL
        native.store64(services, native.fieldOffset<Services>("oraclefailures"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("heap"), native.address(h))
        native.store64(services, native.fieldOffset<Services>("arena"), native.address(a))
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("metaCallee"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("landed"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random0"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random1"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random2"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random3"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryName"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryCount"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryActive"), 0ULL)
    end

    return 1ULL
end

-- Unmaps what `mapEntry` noted in `field`, and forgets it.
local function unmapEntry(services: voidptr, field: int64): nil
    local base = native.load64(services, field)
    if base ~= 0ULL then
        os.unmapPages(native.pointer(base), native.load64(services, field + 8))
        native.store64(services, field, 0ULL)
        native.store64(services, field + 8, 0ULL)
    end
end

-- Unmaps the chunks the initializers' frame stacks grew into past the pool,
-- and the coroutines' first chunks kept for reuse.
local function releaseStacks(services: voidptr): nil
    local slotstorage = native.load64(services, native.fieldOffset<Services>("stacks"))
    local stride = native.load64(services, native.fieldOffset<Services>("stride"))
    local slot: uint64 = 0ULL
    while slotstorage ~= 0ULL and slot < native.load64(services, native.fieldOffset<Services>("slots")) do
        local first = slotstorage + slot * stride + native.word(native.fieldOffset<guestentry.Storage>("segment"))
        local above = heap.chunkAbove(first)
        if above ~= 0ULL then
            native.store64(native.pointer(first), native.fieldOffset<frames.Chunk>("above"), 0ULL)
            heap.releaseChunks(above)
        end
        slot = slot + 1ULL
    end
    native.store64(services, native.fieldOffset<Services>("stacks"), 0ULL)
    stacks.drain(native.offset(services, native.fieldOffset<Services>("chunks")))
end

-- Destroys the heap and unmaps its arena, then the frame stacks, pool and
-- storage; nothing when open never ran.
export function close(services: voidptr): nil
    local address = native.load64(services, native.fieldOffset<Services>("heap"))
    if address == 0ULL then
        unmapEntry(services, native.fieldOffset<Services>("pool"))
        unmapEntry(services, native.fieldOffset<Services>("storage"))
        return
    end
    @unsafe do
        -- Unrooted, a last cycle retires every table so its owned parts are
        -- released before the heap goes.
        local h = native.pointer(address) as heap.Heap*
        native.store64(services, native.fieldOffset<Services>("oraclefailures"), h.oracleFailures)
        h.ranges.count = 0ULL
        collector.fullCycle(h)
        tables.drain(h)
        heap.destroy(native.pointer(address) as heap.Heap*)
        local a = native.pointer(native.load64(services, native.fieldOffset<Services>("arena"))) as arena.Arena*
        local chunk: arena.Chunk*? = a.chunk
        while chunk ~= nil do
            local previous = chunk.previous
            os.unmapPages(chunk as voidptr, chunk.bytes)
            chunk = previous
        end
    end
    native.store64(services, native.fieldOffset<Services>("heap"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("arena"), 0ULL)
    releaseStacks(services)
    unmapEntry(services, native.fieldOffset<Services>("pool"))
    unmapEntry(services, native.fieldOffset<Services>("storage"))
end

-- The first raised error code, or 1000 when the scope cannot close cleanly
-- (a mapping is still live or backing was retained), or 1001 when the
-- collector's oracle found a survivor wrong.
export function finish(services: voidptr): uint64
    local failure = native.load64(services, native.fieldOffset<servicescope.ServiceScope>("error"))
    if servicescope.close(services) ~= 1ULL and failure == 0ULL then
        return 1000ULL
    end
    if failure == 0ULL and native.load64(services, native.fieldOffset<Services>("oraclefailures")) ~= 0ULL then
        return 1001ULL
    end

    return failure
end

-- Handlers reach the heap through these leaves, which hold the typed views a
-- handler cannot. `ctx` is the handler's context.
local function guestHeap(ctx: voidptr): uint64
    local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
    return native.load64(services, native.fieldOffset<Services>("heap"))
end

-- A fresh `kind` object of `length` value slots, all nil; answers its header
-- address. Its slots may be written directly until `initialized`.
export function allocate(ctx: voidptr, kind: uint64, length: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        tables.drain(h)
        local o = collector.allocate(h, kind, length * 8ULL)
        o.auxLen = length
        local i: uint64 = 0ULL
        while i < length do
            native.store64(native.pointer(o.auxPtr), native.index(i * 8ULL), values.NIL)
            i = i + 1ULL
        end

        return native.address(o as voidptr)
    end
end

-- Ends an object's construction (see collector.initialized).
export function initialized(ctx: voidptr, header: uint64): nil
    @unsafe do
        collector.initialized(native.pointer(guestHeap(ctx)) as heap.Heap*, native.pointer(header) as heap.Header*)
    end
end

-- Stores `value` in slot `index` of a constructed object, through the barrier.
export function store(ctx: voidptr, header: uint64, index: uint64, value: uint64): nil
    @unsafe do
        local o = native.pointer(header) as heap.Header*
        collector.barrier(native.pointer(guestHeap(ctx)) as heap.Heap*, o, value)
        native.store64(native.pointer(o.auxPtr), native.index(index * 8ULL), value)
    end
end

-- A fresh table on the entry's heap; answers its header address.
export function newTable(ctx: voidptr): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = tables.create(h)
        tables.drain(h)

        return t
    end
end

-- A fresh table whose array part is packed as `kind` (coretables), with
-- room for `capacity` elements; answers its header address.
export function newpacked(ctx: voidptr, kind: uint64, capacity: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = tables.createpacked(h, kind, capacity)
        tables.drain(h)

        return t
    end
end

-- The pack {[0] = n, ...} of the `count` values at `source` followed by the
-- values of `extra`, a pack (0 for none): a call's results for a caller that
-- takes them all as one value.
export function packValues(ctx: voidptr, source: voidptr, count: uint64, extra: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = tables.create(h)
        local n: uint64 = 0ULL
        while n < count do
            if tables.set(
                h,
                t,
                values.TAG_INTEGER | (n + 1ULL),
                native.load64(source, native.index(n * 8ULL))
            ) == tables.NO_MEMORY then
                error("not enough memory")
            end
            n = n + 1ULL
        end
        if extra ~= 0ULL then
            local more = ints.bitsOf(tables.get(extra, values.TAG_INTEGER))
            local k: uint64 = 1ULL
            while k <= more do
                n = n + 1ULL
                if tables.set(
                    h,
                    t,
                    values.TAG_INTEGER | n,
                    tables.get(extra, values.TAG_INTEGER | k)
                ) == tables.NO_MEMORY then
                    error("not enough memory")
                end
                k = k + 1ULL
            end
        end
        if tables.set(h, t, values.TAG_INTEGER, values.TAG_INTEGER | n) == tables.NO_MEMORY then
            error("not enough memory")
        end
        tables.drain(h)

        return values.TAG_OBJ | t
    end
end

export const META_INDEX: uint64 = 0ULL
export const META_NEWINDEX: uint64 = 1ULL
export const META_METATABLE: uint64 = 2ULL
export const META_ADD: uint64 = 3ULL
export const META_SUB: uint64 = 4ULL
export const META_MUL: uint64 = 5ULL
export const META_MOD: uint64 = 6ULL
export const META_LEN: uint64 = 7ULL
export const META_LT: uint64 = 8ULL
export const META_LE: uint64 = 9ULL
export const META_EQ: uint64 = 10ULL
export const META_CONCAT: uint64 = 11ULL
export const META_DIV: uint64 = 12ULL
export const META_IDIV: uint64 = 13ULL
export const META_TOSTRING: uint64 = 14ULL
export const META_UNM: uint64 = 15ULL
export const META_CALL: uint64 = 16ULL
export const META_POW: uint64 = 17ULL
-- Not a metamethod: a record's table maps its field names to slots under
-- "\0fields", for reads and writes by name its instances' types did not
-- resolve.
export const META_FIELDS: uint64 = 18ULL

-- The interned name of a metatable field: "__index", "__newindex" or
-- "__metatable".
local function makeMetaKey(ctx: voidptr, which: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if which == META_INDEX then
            refused = strings.appendWord(h, builder, 0x7865646e695f5fULL, 7ULL)
        elseif which == META_NEWINDEX then
            refused = strings.appendWord(h, builder, 0x646e6977656e5f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x7865ULL, 2ULL)
        elseif which == META_ADD then
            refused = strings.appendWord(h, builder, 0x6464615f5fULL, 5ULL)
        elseif which == META_SUB then
            refused = strings.appendWord(h, builder, 0x6275735f5fULL, 5ULL)
        elseif which == META_MUL then
            refused = strings.appendWord(h, builder, 0x6c756d5f5fULL, 5ULL)
        elseif which == META_MOD then
            refused = strings.appendWord(h, builder, 0x646f6d5f5fULL, 5ULL)
        elseif which == META_LEN then
            refused = strings.appendWord(h, builder, 0x6e656c5f5fULL, 5ULL)
        elseif which == META_LT then
            refused = strings.appendWord(h, builder, 0x746c5f5fULL, 4ULL)
        elseif which == META_LE then
            refused = strings.appendWord(h, builder, 0x656c5f5fULL, 4ULL)
        elseif which == META_EQ then
            refused = strings.appendWord(h, builder, 0x71655f5fULL, 4ULL)
        elseif which == META_CONCAT then
            refused = strings.appendWord(h, builder, 0x7461636e6f635f5fULL, 8ULL)
        elseif which == META_DIV then
            refused = strings.appendWord(h, builder, 0x7669645f5fULL, 5ULL)
        elseif which == META_IDIV then
            refused = strings.appendWord(h, builder, 0x766964695f5fULL, 6ULL)
        elseif which == META_TOSTRING then
            refused = strings.appendWord(h, builder, 0x697274736f745f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x676eULL, 2ULL)
        elseif which == META_UNM then
            refused = strings.appendWord(h, builder, 0x6d6e755f5fULL, 5ULL)
        elseif which == META_CALL then
            refused = strings.appendWord(h, builder, 0x6c6c61635f5fULL, 6ULL)
        elseif which == META_POW then
            refused = strings.appendWord(h, builder, 0x776f705f5fULL, 5ULL)
        elseif which == META_FIELDS then
            refused = strings.appendWord(h, builder, 0x73646c65696600ULL, 7ULL)
        else
            refused = strings.appendWord(h, builder, 0x61746174656d5f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x656c62ULL, 3ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- Metamethod name `which` as a string: made the first time, then kept in
-- the Services' rooted `metanames` table. Storing it allocates no object,
-- so nothing collects it between its making and its keeping.
export function metaKey(ctx: voidptr, which: uint64): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local names = native.load64(services, native.fieldOffset<Services>("metanames"))
        if names == 0ULL then
            names = values.TAG_OBJ | newTable(ctx)
            native.store64(services, native.fieldOffset<Services>("metanames"), names)
        end
        local key = values.TAG_INTEGER | which
        local known = tables.get(names & values.PAYLOAD, key)
        if known ~= values.NIL then
            return known
        end
        local made = makeMetaKey(ctx, which)
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        if tables.set(h, names & values.PAYLOAD, key, made) == tables.NO_MEMORY then
            error("not enough memory")
        end

        return made
    end
end

-- The table a value names, or 0.
local function tableOf(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    @unsafe do
        local header = native.pointer(value & values.PAYLOAD)
        if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_TABLE then
            return 0ULL
        end
    end

    return value & values.PAYLOAD
end

-- The `which` field of a table's metatable, nil when it has none.
export function metaField(ctx: voidptr, table: uint64, which: uint64): uint64
    local mt = tableOf(tables.meta(table))
    if mt == 0ULL then
        return values.NIL
    end

    return tables.get(mt, metaKey(ctx, which))
end

-- Notes the metamethod function a table access is to call.
local function pend(ctx: voidptr, callee: uint64, table: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("metaCallee"), callee)
        native.store64(services, native.fieldOffset<Services>("metaSelf"), values.TAG_OBJ | table)
    end
end

-- The metamethod function the last table access noted, or 0; taking it
-- clears it. `metaSelf` is the table it is called for.
export function takeMeta(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local callee = native.load64(services, native.fieldOffset<Services>("metaCallee"))
        native.store64(services, native.fieldOffset<Services>("metaCallee"), 0ULL)
        return callee
    end
end

-- The value the last recovered error carried.
export function lastError(ctx: voidptr): uint64
    @unsafe do
        return native.load64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("lastError"))
    end
end

export function metaSelf(ctx: voidptr): uint64
    @unsafe do
        return native.load64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("metaSelf"))
    end
end

-- The `which` metamethod of an operation on `a` and `b`: the first
-- operand's when it has one, else the second's; 0 when neither is a table
-- with it.
export function binaryMeta(ctx: voidptr, which: uint64, a: uint64, b: uint64): uint64
    local first = tableOf(a)
    if first ~= 0ULL then
        local found = metaField(ctx, first, which)
        if found ~= values.NIL then
            return found
        end
    end
    local second = tableOf(b)
    if second ~= 0ULL then
        local found = metaField(ctx, second, which)
        if found ~= values.NIL then
            return found
        end
    end

    return 0ULL
end

-- The slot record instance `t` keeps field `key` in, or nil when its
-- metatable is not a record's or names no such field.
local function recordSlot(ctx: voidptr, t: uint64, key: uint64): uint64
    local fields = tableOf(metaField(ctx, t, META_FIELDS))
    if fields == 0ULL then
        return values.NIL
    end

    return tables.get(fields, key)
end

-- A traversal of a record instance names its fields, as one of a table of
-- fields does, though the instance keeps them in slots: the field name slot
-- `key` of `t` holds, or `key` itself when `t` is no record instance or
-- `key` none of its slots. A table holding the name itself, as a copy of an
-- instance given the record's metatable does, keeps its own keys.
export function slotname(ctx: voidptr, t: uint64, key: uint64): uint64
    if not ints.isInteger(key) then
        return key
    end
    local fields = tableOf(metaField(ctx, t, META_FIELDS))
    if fields == 0ULL then
        return key
    end
    local name = tables.nextKey(fields, values.NIL)
    while name ~= values.NIL and name ~= values.TRUE do
        if tables.get(fields, name) == key then
            if tables.get(t, name) ~= values.NIL then
                return key
            end
            return name
        end
        name = tables.nextKey(fields, name)
    end

    return key
end

-- The key a traversal of `t` resumes after: the slot a field name `key`
-- stands for in a record instance, else `key` itself.
export function slotkey(ctx: voidptr, t: uint64, key: uint64): uint64
    if strings.header(key) == 0ULL or tables.get(t, key) ~= values.NIL then
        return key
    end
    local slot = recordSlot(ctx, t, key)
    if slot == values.NIL then
        return key
    end

    return slot
end

-- Lua's t[k]: the raw value, else through the metatable's __index while it
-- names a table. An __index function is noted (`takeMeta`) for the handler
-- to call, and nil answered meanwhile.
export function tableGet(ctx: voidptr, table: uint64, key: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = table
        local depth: uint64 = 0ULL
        while true do
            local value = tables.lookup(h, t, key)
            if value ~= values.NIL or tables.meta(t) == values.NIL then
                return value
            end
            -- A record instance's field read by name is its slot. An empty
            -- one is an absent key, as a Lua table's: `__index` answers it,
            -- as the record's method a field declares.
            if depth == 0ULL and strings.header(key) ~= 0ULL then
                local slot = recordSlot(ctx, t, key)
                if slot ~= values.NIL then
                    local held = tables.lookup(h, t, slot)
                    if held ~= values.NIL then
                        return held
                    end
                end
            end
            local index = metaField(ctx, t, META_INDEX)
            if index == values.NIL then
                return values.NIL
            end
            local next = tableOf(index)
            if next == 0ULL then
                pend(ctx, index, t)
                return values.NIL
            end
            t = next
            depth = depth + 1ULL
            if depth >= 2000ULL then
                error("'__index' chain too long; possible loop")
            end
        end

        return values.NIL
    end
end

-- Lua's t[k] = v: a key the table holds, or one its metatable has no
-- __newindex for, is stored in place; otherwise in the table __newindex
-- names. Answers coretables.set's status, META_PENDING when a __newindex
-- function is noted (`takeMeta`) for the handler to call, or READONLY when
-- the table the value would be stored in is frozen. As Luau's, a frozen
-- table's __newindex is still followed for a key it lacks.
export function tableSet(ctx: voidptr, table: uint64, key: uint64, value: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = table
        local depth: uint64 = 0ULL
        -- A record instance's field written by name is its slot, which it
        -- holds itself; a table holding the name as its own key, as a copy
        -- of an instance given the record's metatable does, keeps it there.
        if tables.meta(t) ~= values.NIL and strings.header(key) ~= 0ULL and tables.lookup(h, t, key) == values.NIL then
            local slot = recordSlot(ctx, t, key)
            if slot ~= values.NIL then
                if tables.frozen(t) then
                    return READONLY
                end
                local stored = tables.set(h, t, slot, value)
                tables.drain(h)
                return stored
            end
        end
        while tables.meta(t) ~= values.NIL and tables.lookup(h, t, key) == values.NIL do
            local newindex = metaField(ctx, t, META_NEWINDEX)
            if newindex == values.NIL then
                break
            end
            local next = tableOf(newindex)
            if next == 0ULL then
                pend(ctx, newindex, t)
                return META_PENDING
            end
            t = next
            depth = depth + 1ULL
            if depth >= 2000ULL then
                error("'__newindex' chain too long; possible loop")
            end
        end
        if tables.frozen(t) then
            return READONLY
        end
        local status = tables.set(h, t, key, value)
        tables.drain(h)

        return status
    end
end

-- A library call that reaches a function __index, __newindex or __len
-- (the table library's, as Lua 5.5's calls them) cannot call it itself: it
-- stops, its handler calls the metamethod, and the call runs again from the
-- start once that answers. A log of what each of its table accesses
-- answered lets each run replay the accesses made so far, in order and
-- without making them again, and go on to the next.
--
-- `replays` is a stack of the calls running so, from key 1 (its depth at
-- key 0), ENTRY_WORDS keys each: the log (its length at key 0), the frame
-- of the metamethod waited on (nil while none is), the thread whose call it
-- is (false for the main one), the kind of access waiting, and the call's
-- four arguments, which the metamethod's staging overwrites in its frame.
const ENTRY_WORDS: uint64 = 9ULL
const ENTRY_LOG: uint64 = 1ULL
const ENTRY_CHILD: uint64 = 2ULL
const ENTRY_THREAD: uint64 = 3ULL
const ENTRY_KIND: uint64 = 4ULL
const ENTRY_ARGS: uint64 = 5ULL
const ENTRY_STATE: uint64 = 9ULL
export const ACCESS_GET: uint64 = 1ULL
export const ACCESS_SET: uint64 = 2ULL
export const ACCESS_LENGTH: uint64 = 3ULL

local function scopeof(ctx: voidptr): voidptr
    return native.loadPointer(ctx, context.SERVICE_SCOPE)
end

-- Raises Luau's "attempt to modify a readonly table" from a library call
-- that would write to a frozen table (runtime Decision 16). The recovery
-- words the fault (`runtimeError`) and positions it at the library call,
-- as raiseFault does; this one is called from before raiseFault.
export function readonly(ctx: voidptr): nil
    local services = scopeof(ctx)
    native.store64(services, native.fieldOffset<Services>("fault"), FAULT_READONLY)
    native.store64(services, native.fieldOffset<Services>("culprit"), values.NIL)
    native.store64(services, native.fieldOffset<Services>("other"), values.NIL)
    native.store64(services, native.fieldOffset<Services>("libraryRaised"), 1ULL)
    error("library error")
end

local function keyof(depth: uint64, field: uint64): uint64
    return values.TAG_INTEGER | ((depth - 1ULL) * ENTRY_WORDS + field)
end

local function countof(t: uint64): uint64
    local n = tables.get(t, values.TAG_INTEGER)
    if n == values.NIL then
        return 0ULL
    end

    return n & values.PAYLOAD
end

local function setkey(ctx: voidptr, t: uint64, key: uint64, value: uint64): nil
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        if tables.set(h, t, key, value) == tables.NO_MEMORY then
            error("not enough memory")
        end
        tables.drain(h)
    end
end

local function framevalue(frame: uint64): uint64
    return values.TAG_INTEGER | (frame & values.PAYLOAD)
end

local function threadvalue(ctx: voidptr): uint64
    local running = native.load64(scopeof(ctx), native.fieldOffset<Services>("running"))
    if running == 0ULL then
        return values.FALSE
    end

    return running
end

-- Whether entry `depth` waits on a metamethod `frame` runs inside, in the
-- running thread: a call that stopped and was never run again has none.
local function waiting(ctx: voidptr, stack: uint64, depth: uint64, frame: uint64): boolean
    local child = tables.get(stack, keyof(depth, ENTRY_CHILD))
    if child == values.NIL or tables.get(stack, keyof(depth, ENTRY_THREAD)) ~= threadvalue(ctx) then
        return false
    end
    local f = frame
    while f ~= 0ULL do
        if framevalue(f) == child then
            return true
        end
        f = native.load64(native.pointer(f), native.fieldOffset<frames.Frame>("previous"))
    end

    return false
end

-- Drops entry `depth` and every one above it.
local function truncate(ctx: voidptr, stack: uint64, depth: uint64): nil
    local top = countof(stack)
    while top >= depth and top >= 1ULL do
        local field: uint64 = 1ULL
        while field <= ENTRY_WORDS do
            setkey(ctx, stack, keyof(top, field), values.NIL)
            field = field + 1ULL
        end
        top = top - 1ULL
    end
    setkey(ctx, stack, values.TAG_INTEGER, values.TAG_INTEGER | top)
end

-- Drops the entries on top that no longer wait: one an error left behind,
-- or whose metamethod's frame is gone. Another thread's are kept: the
-- threads that resumed this one wait under them, and a thread's death
-- releases its own (`replaydrop`).
local function prune(ctx: voidptr, stack: uint64, frame: uint64): nil
    local depth = countof(stack)
    while depth >= 1ULL do
        local thread = tables.get(stack, keyof(depth, ENTRY_THREAD))
        local child = tables.get(stack, keyof(depth, ENTRY_CHILD))
        if child ~= values.NIL and (thread ~= threadvalue(ctx) or waiting(ctx, stack, depth, frame)) then
            break
        end
        depth = depth - 1ULL
    end
    truncate(ctx, stack, depth + 1ULL)
end

-- Roots `value`, a fresh object a library call holds while it allocates
-- another, until the next hold or `release`.
export function hold(ctx: voidptr, value: uint64): nil
    native.store64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("scratch"), value)
end

export function release(ctx: voidptr): nil
    native.store64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("scratch"), 0ULL)
end

-- Whether `value` is a table with a metatable.
export function metatabled(value: uint64): boolean
    local t = tableOf(value)

    return t ~= 0ULL and tables.meta(t) ~= values.NIL
end

-- `value`'s table, or 0 when it is not one.
export function tableof(value: uint64): uint64
    return tableOf(value)
end

-- How a table library call runs (replaybegin): with no log; again, a
-- metamethod it waited on having answered; or in replay from the start.
export const REPLAY_NONE: uint64 = 0ULL
export const REPLAY_AGAIN: uint64 = 1ULL
export const REPLAY_START: uint64 = 2ULL

-- Starts a table library call at `frame`: answers REPLAY_START when it runs
-- in replay from the start, as a call over a table with a metatable does (its
-- arguments to be kept, `replaykeep`); REPLAY_AGAIN when it runs again, a
-- metamethod it waited on having answered `answer` (its arguments then are
-- `replayarg`'s); REPLAY_NONE when it needs no log.
export function replaybegin(ctx: voidptr, frame: voidptr, answer: uint64, hasmeta: boolean): uint64
    @unsafe do
        local scope = scopeof(ctx)
        local child = native.load64(scope, native.fieldOffset<Services>("libraryanswer"))
        native.store64(scope, native.fieldOffset<Services>("libraryanswer"), 0ULL)
        native.store64(scope, native.fieldOffset<Services>("replay"), 0ULL)
        native.store64(scope, native.fieldOffset<Services>("replaycursor"), 0ULL)
        native.store64(scope, native.fieldOffset<Services>("replaysuspend"), 0ULL)
        if child == 0ULL and not hasmeta then
            return REPLAY_NONE
        end
        local stackvalue = native.load64(scope, native.fieldOffset<Services>("replays"))
        if stackvalue == 0ULL then
            stackvalue = values.TAG_OBJ | newTable(ctx)
            native.store64(scope, native.fieldOffset<Services>("replays"), stackvalue)
        end
        local stack = stackvalue & values.PAYLOAD
        if child ~= 0ULL then
            -- The entry waiting on this metamethod is the nearest the top:
            -- any above it were left by errors its metamethod caught.
            local depth = countof(stack)
            while depth >= 1ULL and tables.get(stack, keyof(depth, ENTRY_CHILD)) ~= framevalue(child) do
                depth = depth - 1ULL
            end
            if depth == 0ULL then
                error("a library call's metamethod answered no waiting call")
            end
            truncate(ctx, stack, depth + 1ULL)
            local log = tables.get(stack, keyof(depth, ENTRY_LOG)) & values.PAYLOAD
            local logged = answer
            if tables.get(stack, keyof(depth, ENTRY_KIND)) == (values.TAG_INTEGER | ACCESS_SET) then
                logged = values.TRUE
            end
            local n = countof(log) + 1ULL
            setkey(ctx, log, values.TAG_INTEGER | n, logged)
            setkey(ctx, log, values.TAG_INTEGER, values.TAG_INTEGER | n)
            setkey(ctx, stack, keyof(depth, ENTRY_CHILD), values.NIL)
            native.store64(scope, native.fieldOffset<Services>("replay"), log)
            return REPLAY_AGAIN
        end
        prune(ctx, stack, native.address(frame))
        -- Each key is made before the log, so storing it allocates nothing
        -- while the log is not yet reachable.
        local depth = countof(stack) + 1ULL
        setkey(ctx, stack, keyof(depth, ENTRY_LOG), values.TRUE)
        setkey(ctx, stack, keyof(depth, ENTRY_THREAD), threadvalue(ctx))
        setkey(ctx, stack, keyof(depth, ENTRY_KIND), values.TAG_INTEGER)
        setkey(ctx, stack, keyof(depth, ENTRY_STATE), values.TRUE)
        setkey(ctx, stack, values.TAG_INTEGER, values.TAG_INTEGER | depth)
        local log = newTable(ctx)
        setkey(ctx, stack, keyof(depth, ENTRY_LOG), values.TAG_OBJ | log)
        native.store64(scope, native.fieldOffset<Services>("replay"), log)

        return REPLAY_START
    end
end

-- Keeps the arguments of the library call replaybegin started from the
-- start, which its frame holds meanwhile.
export function replaykeep(ctx: voidptr, a: uint64, b: uint64, c: uint64, d: uint64): nil
    local stack = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays")) & values.PAYLOAD
    local depth = countof(stack)
    setkey(ctx, stack, keyof(depth, ENTRY_ARGS), a)
    setkey(ctx, stack, keyof(depth, ENTRY_ARGS + 1ULL), b)
    setkey(ctx, stack, keyof(depth, ENTRY_ARGS + 2ULL), c)
    setkey(ctx, stack, keyof(depth, ENTRY_ARGS + 3ULL), d)
end

-- Ends a run that replaybegin started: answers the kind of access it
-- stopped at, its entry kept to wait on the metamethod, or 0 when it
-- finished and its entry is dropped.
export function replayend(ctx: voidptr): uint64
    @unsafe do
        local scope = scopeof(ctx)
        native.store64(scope, native.fieldOffset<Services>("replay"), 0ULL)
        local stack = native.load64(scope, native.fieldOffset<Services>("replays")) & values.PAYLOAD
        local depth = countof(stack)
        if native.load64(scope, native.fieldOffset<Services>("replaysuspend")) == 0ULL then
            truncate(ctx, stack, depth)
            return 0ULL
        end
        native.store64(scope, native.fieldOffset<Services>("replaysuspend"), 0ULL)
        local kind = native.load64(scope, native.fieldOffset<Services>("replaykind"))
        setkey(ctx, stack, keyof(depth, ENTRY_KIND), values.TAG_INTEGER | kind)

        return kind
    end
end

-- The state a library call's step started from (guestlib.stepstate), kept
-- in its entry, and read back for a rerun.
export function replaysave(ctx: voidptr, saved: uint64): nil
    local stack = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays")) & values.PAYLOAD
    setkey(ctx, stack, keyof(countof(stack), ENTRY_STATE), saved)
end

export function replaysaved(ctx: voidptr): uint64
    local stack = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays")) & values.PAYLOAD

    return tables.get(stack, keyof(countof(stack), ENTRY_STATE))
end

-- Argument `index` (0 to 3) of the library call running in replay.
export function replayarg(ctx: voidptr, index: uint64): uint64
    local stack = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays")) & values.PAYLOAD

    return tables.get(stack, keyof(countof(stack), ENTRY_ARGS + index))
end

-- The key and value of the access a run stopped at.
export function replaykey(ctx: voidptr): uint64
    return native.load64(scopeof(ctx), native.fieldOffset<Services>("replaykey"))
end

export function replayvalue(ctx: voidptr): uint64
    return native.load64(scopeof(ctx), native.fieldOffset<Services>("replayvalue"))
end

-- Notes the frame of the metamethod the top entry now waits on.
export function replaywait(ctx: voidptr, child: uint64): nil
    local stack = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays")) & values.PAYLOAD
    setkey(ctx, stack, keyof(countof(stack), ENTRY_CHILD), framevalue(child))
end

-- A metamethod frame a library call waits on returns: the next handler,
-- that call run again, takes its answer.
export function answered(ctx: voidptr, child: uint64): nil
    native.store64(scopeof(ctx), native.fieldOffset<Services>("libraryanswer"), child)
end

-- A thread died: the calls of its that waited never will.
export function replaydrop(ctx: voidptr, thread: uint64): nil
    local stackvalue = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays"))
    if stackvalue == 0ULL then
        return
    end
    local stack = stackvalue & values.PAYLOAD
    local depth = countof(stack)
    while depth >= 1ULL do
        if tables.get(stack, keyof(depth, ENTRY_THREAD)) == thread then
            setkey(ctx, stack, keyof(depth, ENTRY_CHILD), values.NIL)
        end
        depth = depth - 1ULL
    end
end

-- Whether a library call of the running thread waits on a metamethod the
-- active frame runs inside: a yield there would cross it, as Lua's would a
-- C call.
export function crossing(ctx: voidptr): boolean
    local stackvalue = native.load64(scopeof(ctx), native.fieldOffset<Services>("replays"))
    if stackvalue == 0ULL then
        return false
    end
    local stack = stackvalue & values.PAYLOAD
    local frame = access.active(native.loadPointer(ctx, context.STATE))
    local depth = countof(stack)
    while depth >= 1ULL do
        if waiting(ctx, stack, depth, frame) then
            return true
        end
        depth = depth - 1ULL
    end

    return false
end

-- Whether the run in replay stopped for a metamethod; the library call
-- then returns at once, its answer unused.
export function suspended(ctx: voidptr): boolean
    return native.load64(scopeof(ctx), native.fieldOffset<Services>("replaysuspend")) ~= 0ULL
end

local function stop(ctx: voidptr, kind: uint64, key: uint64, value: uint64): uint64
    local scope = scopeof(ctx)
    native.store64(scope, native.fieldOffset<Services>("replaysuspend"), 1ULL)
    native.store64(scope, native.fieldOffset<Services>("replaykind"), kind)
    native.store64(scope, native.fieldOffset<Services>("replaykey"), key)
    native.store64(scope, native.fieldOffset<Services>("replayvalue"), value)

    return values.NIL
end

-- An access of the run in replay: the log's answer while it has one, else
-- the access made and logged, or a stop for its metamethod.
local function replayed(ctx: voidptr, kind: uint64, t: uint64, key: uint64, value: uint64): uint64
    local scope = scopeof(ctx)
    if native.load64(scope, native.fieldOffset<Services>("replaysuspend")) ~= 0ULL then
        return values.NIL
    end
    local log = native.load64(scope, native.fieldOffset<Services>("replay"))
    local cursor = native.load64(scope, native.fieldOffset<Services>("replaycursor")) + 1ULL
    if cursor <= countof(log) then
        native.store64(scope, native.fieldOffset<Services>("replaycursor"), cursor)
        return tables.get(log, values.TAG_INTEGER | cursor)
    end
    local answer = values.TRUE
    if kind == ACCESS_GET then
        answer = tableGet(ctx, t, key)
        if native.load64(scope, native.fieldOffset<Services>("metaCallee")) ~= 0ULL then
            return stop(ctx, kind, key, values.NIL)
        end
    elseif kind == ACCESS_SET then
        local status = tableSet(ctx, t, key, value)
        if status == META_PENDING then
            return stop(ctx, kind, key, value)
        end
        if status == READONLY then
            readonly(ctx)
        end
        if status == tables.NO_MEMORY then
            error("not enough memory")
        end
    else
        local len = metaField(ctx, t, META_LEN)
        if len ~= values.NIL then
            pend(ctx, len, t)
            return stop(ctx, kind, values.TAG_OBJ | t, values.NIL)
        end
        answer = values.TAG_INTEGER | tables.length(t)
    end
    setkey(ctx, log, values.TAG_INTEGER | cursor, answer)
    setkey(ctx, log, values.TAG_INTEGER, values.TAG_INTEGER | cursor)
    native.store64(scope, native.fieldOffset<Services>("replaycursor"), cursor)

    return answer
end

-- t[index] as the table library reads it, through `__index` as Lua 5.5's
-- does; in replay (`replaybegin`) a function `__index` is called.
export function geti(ctx: voidptr, t: uint64, index: int64): uint64
    local key = values.TAG_INTEGER | native.word(index)
    if native.load64(scopeof(ctx), native.fieldOffset<Services>("replay")) ~= 0ULL then
        return replayed(ctx, ACCESS_GET, t, key, values.NIL)
    end
    if tables.meta(t) == values.NIL then
        return tables.get(t, key)
    end
    local value = tableGet(ctx, t, key)
    if takeMeta(ctx) ~= 0ULL then
        error("a function __index outside a table library call")
    end

    return value
end

-- t[index] = value as the table library stores it, through `__newindex`.
export function seti(ctx: voidptr, t: uint64, index: int64, value: uint64): nil
    local key = values.TAG_INTEGER | native.word(index)
    if native.load64(scopeof(ctx), native.fieldOffset<Services>("replay")) ~= 0ULL then
        replayed(ctx, ACCESS_SET, t, key, value)
        return
    end
    local status = tableSet(ctx, t, key, value)
    if status == META_PENDING then
        takeMeta(ctx)
        error("a function __newindex outside a table library call")
    end
    if status == READONLY then
        readonly(ctx)
    end
    if status == tables.NO_MEMORY then
        error("not enough memory")
    end
end

-- #t as the table library takes it, through `__len` as Lua 5.5's luaL_len
-- does: an integer value, or whatever __len answered.
export function leni(ctx: voidptr, t: uint64): uint64
    if native.load64(scopeof(ctx), native.fieldOffset<Services>("replay")) ~= 0ULL then
        return replayed(ctx, ACCESS_LENGTH, t, values.NIL, values.NIL)
    end
    if metaField(ctx, t, META_LEN) ~= values.NIL then
        error("a __len outside a table library call")
    end

    return values.TAG_INTEGER | tables.length(t)
end

-- setmetatable(t, mt): answers t; a metatable with __metatable set is
-- protected. A frozen t cannot take another, and mt freezes as it is
-- attached (runtime Decision 16), so its metamethods stay what they were.
export function setMetatable(ctx: voidptr, value: uint64, mt: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'setmetatable' (table expected)")
    end
    if mt ~= values.NIL and tableOf(mt) == 0ULL then
        error("bad argument #2 to 'setmetatable' (nil or table expected)")
    end
    if metaField(ctx, t, META_METATABLE) ~= values.NIL then
        error("cannot change a protected metatable")
    end
    if tables.frozen(t) then
        readonly(ctx)
    end
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        tables.setMeta(h, t, mt)
        if mt ~= values.NIL then
            tables.freeze(h, mt & values.PAYLOAD)
        end
    end

    return value
end

-- getmetatable(v): a table's metatable, or its __metatable field when it
-- has one; nil for anything else.
export function getMetatable(ctx: voidptr, value: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        return values.NIL
    end
    local protected = metaField(ctx, t, META_METATABLE)
    if protected ~= values.NIL then
        return protected
    end

    return tables.meta(t)
end

-- rawset(t, k, v): stores past any metatable; answers t.
export function rawSet(ctx: voidptr, value: uint64, key: uint64, item: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'rawset' (table expected)")
    end
    if tables.frozen(t) then
        readonly(ctx)
    end
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        if tables.set(h, t, key, item) ~= tables.OK then
            error("invalid key to 'rawset'")
        end
        tables.drain(h)
    end

    return value
end

-- rawget(t, k): the raw value.
export function rawGet(ctx: voidptr, value: uint64, key: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'rawget' (table expected)")
    end
    @unsafe do
        return tables.lookup(native.pointer(guestHeap(ctx)) as heap.Heap*, t, key)
    end
end

-- The interned string a v8 string constant word names in the catalog data;
-- answers its header address.
export function stringConstant(ctx: voidptr, word: uint64): uint64
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local at = data + (word & values.PAYLOAD)
        return strings.make(
            native.pointer(guestHeap(ctx)) as heap.Heap*,
            at + 8ULL,
            native.load64(native.pointer(at), 0)
        )
    end
end

-- The interned string of `count` bytes at `bytes`, on the entry's heap.
export function makeString(ctx: voidptr, bytes: uint64, count: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local s = strings.make(h, bytes, count)
        tables.drain(h)
        return s
    end
end

-- The canonical value of int64 `bits` on the entry's heap: an immediate, or
-- the interned box.
-- The boxed integer a v8 wide integer constant word names in the catalog
-- data.
export function integerConstant(ctx: voidptr, word: uint64): uint64
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local value = ints.make(h, native.load64(native.pointer(data + (word & values.PAYLOAD)), 0))
        tables.drain(h)
        return value
    end
end

export function integer(ctx: voidptr, bits: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local value = ints.make(h, bits)
        tables.drain(h)
        return value
    end
end

-- error(value [, level]): the value and level are kept for the protected
-- call the entry's failure unwinds to (`recoverEntry`); the caller fails the
-- entry as any guest error does.
export function raise(ctx: voidptr, value: uint64, level: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("raised"), value)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), level)
    end
end

-- Before a library call: which call it is and where, for its errors.
export function librarySite(ctx: voidptr, frame: voidptr, pc: voidptr, count: uint64, method: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("libraryCount"), count)
        native.store64(services, native.fieldOffset<Services>("libraryMethod"), method)
        native.store64(
            services,
            native.fieldOffset<Services>("libraryOwner"),
            native.load64(frame, native.fieldOffset<frames.Frame>("functionId"))
        )
        local code = native.load64(frame, native.fieldOffset<frames.Frame>("code"))
        local address = native.address(pc)
        local index: uint64 = 0ULL
        if address >= code then
            index = (address - code) // 16ULL
        end
        native.store64(services, native.fieldOffset<Services>("libraryPc"), index)
        native.store64(services, native.fieldOffset<Services>("libraryActive"), 1ULL)
    end
end

-- After a library call returns: what the runtime raises next is not its.
export function libraryReturned(ctx: voidptr): nil
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryActive"),
            0ULL
        )
    end
end

export function libraryMethod(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryMethod")
        )
    end
end

-- The name of the library function running, for its errors.
export function nameLibrary(ctx: voidptr, name: uint64): nil
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryName"),
            name
        )
    end
end

-- The argument count a library call taking its values as one pack has: its
-- errors count them, not the pack.
export function countlibrary(ctx: voidptr, count: uint64): nil
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryCount"),
            count
        )
    end
end

export function libraryNameOf(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryName")
        )
    end
end

export function libraryCount(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryCount")
        )
    end
end

-- A library error: `message` raised at level 1, positioned at the library
-- call once the entry's failure unwinds to its recovery.
export function raiseLibrary(ctx: voidptr, message: uint64): nil
    raise(ctx, message, 1ULL)
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryRaised"),
            1ULL
        )
    end
end

-- A string message with Lua's position before it, "chunk:line: ", naming
-- the frame `level` calls out from the one that failed: 1 is that frame at
-- `pc` in `owner`, 2 its caller at the call. Anything else, or a frame with
-- no known line, answers the message as it is. pcall has no line, so a
-- level past a protected call's own frame names nothing.
local function positioned(ctx: voidptr, message: uint64, level: uint64, failedOwner: uint64, failedPc: uint64): uint64
    local state0 = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local s = strings.header(message)
        if s == 0ULL or level == 0ULL then
            return message
        end
        local state = native.loadPointer(ctx, context.STATE)
        local frame = native.load64(state, native.fieldOffset<frames.State>("active"))
        local owner = failedOwner
        local pc = failedPc
        local k: uint64 = 1ULL
        while k < level do
            if frame == 0ULL
                or native.load64(
                    native.pointer(frame),
                    native.fieldOffset<frames.Frame>("resultKind")
                ) == frames.PROTECTED_DESTINATION
            then
                return message
            end
            frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
            if frame == 0ULL then
                return message
            end
            owner = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
            local resume = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("resumePC"))
            if resume == 0ULL then
                return message
            end
            pc = resume - 1ULL
            k = k + 1ULL
        end
        local c = native.loadPointer(ctx, context.CATALOG)
        if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
            return message
        end
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local fn = native.pointer(
            native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
        )
        local lines = native.load64(fn, native.fieldOffset<catalog.Function>("lines"))
        local chunk = native.load64(fn, native.fieldOffset<catalog.Function>("chunk"))
        if lines == 0ULL
            or chunk == 0ULL
            or pc >= native.load64(fn, native.fieldOffset<catalog.Function>("instructionCount"))
        then
            return message
        end
        local line = native.load64(native.pointer(data + lines + pc * 8ULL), 0)
        if line == 0ULL then
            return message
        end
        local at = data + (chunk & values.PAYLOAD)
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state0 as strings.Builder*
        if strings.append(h, builder, at + 8ULL, native.load64(native.pointer(at), 0)) ~= 0ULL
            or strings.appendWord(h, builder, 58ULL, 1ULL) ~= 0ULL
            or strings.appendInteger(h, builder, native.index(line)) ~= 0ULL
            or strings.appendWord(h, builder, 0x203aULL, 2ULL) ~= 0ULL
            or strings.appendString(h, builder, s) ~= 0ULL
        then
            strings.release(builder)
            return message
        end
        local result = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | result
    end
end

-- A handler's guest error, before it fails the entry: what went wrong, for
-- the message Lua words (`runtimeError`), and the operands it names.
export function fault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("fault"), kind)
        native.store64(services, native.fieldOffset<Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<Services>("other"), other)
    end
end

-- Phrases runtime error messages are built from, by id.
const PHRASE_ARITH: uint64 = 1ULL
const PHRASE_MODZERO: uint64 = 2ULL
const PHRASE_COMPARETWO: uint64 = 3ULL
const PHRASE_VALUES: uint64 = 4ULL
const PHRASE_COMPARE: uint64 = 5ULL
const PHRASE_WITH: uint64 = 6ULL
const PHRASE_LENGTH: uint64 = 7ULL
const PHRASE_INDEX: uint64 = 8ULL
const PHRASE_CALL: uint64 = 9ULL
const PHRASE_VALUE: uint64 = 10ULL
const PHRASE_NIL: uint64 = 11ULL
const PHRASE_BOOLEAN: uint64 = 12ULL
const PHRASE_NUMBER: uint64 = 13ULL
const PHRASE_STRING: uint64 = 14ULL
const PHRASE_TABLE: uint64 = 15ULL
const PHRASE_FUNCTION: uint64 = 16ULL
const PHRASE_USERDATA: uint64 = 17ULL
const PHRASE_KEYNIL: uint64 = 18ULL
const PHRASE_KEYNAN: uint64 = 19ULL
const PHRASE_THREAD: uint64 = 20ULL
const PHRASE_BITWISE: uint64 = 21ULL
const PHRASE_NOINT: uint64 = 22ULL
const PHRASE_READONLY: uint64 = 23ULL

-- Appends phrase `id`; answers 1 when backing is refused.
local function appendPhrase(h: heap.Heap*, b: strings.Builder*, id: uint64): uint64
    if id == PHRASE_ARITH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6874697261206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f20636974656dULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_MODZERO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2730256e27206d72ULL, 8ULL)
    elseif id == PHRASE_COMPARETWO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206f7774206572ULL, 7ULL)
    elseif id == PHRASE_VALUES then
        return strings.appendWord(h, b, 0x7365756c617620ULL, 7ULL)
    elseif id == PHRASE_COMPARE then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206572ULL, 3ULL)
    elseif id == PHRASE_WITH then
        return strings.appendWord(h, b, 0x206874697720ULL, 6ULL)
    elseif id == PHRASE_LENGTH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c20746567206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x666f206874676e65ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_INDEX then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x7865646e69206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_CALL then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x206c6c6163206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == PHRASE_VALUE then
        return strings.appendWord(h, b, 0x65756c617620ULL, 6ULL)
    elseif id == PHRASE_NIL then
        return strings.appendWord(h, b, 0x6c696eULL, 3ULL)
    elseif id == PHRASE_BOOLEAN then
        return strings.appendWord(h, b, 0x6e61656c6f6f62ULL, 7ULL)
    elseif id == PHRASE_NUMBER then
        return strings.appendWord(h, b, 0x7265626d756eULL, 6ULL)
    elseif id == PHRASE_STRING then
        return strings.appendWord(h, b, 0x676e69727473ULL, 6ULL)
    elseif id == PHRASE_TABLE then
        return strings.appendWord(h, b, 0x656c626174ULL, 5ULL)
    elseif id == PHRASE_FUNCTION then
        return strings.appendWord(h, b, 0x6e6f6974636e7566ULL, 8ULL)
    elseif id == PHRASE_USERDATA then
        return strings.appendWord(h, b, 0x6174616472657375ULL, 8ULL)
    elseif id == PHRASE_BITWISE then
        -- "attempt to perform bitwise operation on a "
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6977746962206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x617265706f206573ULL, 8ULL)
            | strings.appendWord(h, b, 0x206e6f206e6f6974ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == PHRASE_NOINT then
        -- "number has no integer representation"
        return strings.appendWord(h, b, 0x68207265626d756eULL, 8ULL)
            | strings.appendWord(h, b, 0x6e69206f6e207361ULL, 8ULL)
            | strings.appendWord(h, b, 0x6572207265676574ULL, 8ULL)
            | strings.appendWord(h, b, 0x61746e6573657270ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f6974ULL, 4ULL)
    elseif id == PHRASE_READONLY then
        -- "attempt to modify a readonly table"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6669646f6d206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6461657220612079ULL, 8ULL)
            | strings.appendWord(h, b, 0x62617420796c6e6fULL, 8ULL)
            | strings.appendWord(h, b, 0x656cULL, 2ULL)
    elseif id == PHRASE_THREAD then
        return strings.appendWord(h, b, 0x646165726874ULL, 6ULL)
    elseif id == PHRASE_KEYNIL then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c69ULL, 2ULL)
    elseif id == PHRASE_KEYNAN then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e61ULL, 2ULL)
    end

    return 0ULL
end

-- The phrase naming a value's type, as Lua's type() does.
local function typePhrase(value: uint64): uint64
    if value == values.NIL then
        return PHRASE_NIL
    elseif value == values.TRUE or value == values.FALSE then
        return PHRASE_BOOLEAN
    elseif ints.isInteger(value) or value & values.QNAN ~= values.QNAN or value == values.QNAN then
        return PHRASE_NUMBER
    elseif strings.header(value) ~= 0ULL then
        return PHRASE_STRING
    end
    @unsafe do
        local kind = native.word(
            native.load8(native.pointer(value & values.PAYLOAD), native.fieldOffset<heap.Header>("kind"))
        )
        if kind == heap.KIND_TABLE then
            return PHRASE_TABLE
        elseif kind == heap.KIND_CLOSURE then
            return PHRASE_FUNCTION
        elseif kind == heap.KIND_THREAD then
            return PHRASE_THREAD
        elseif kind == heap.KIND_BYTES or kind == heap.KIND_SLICE or kind == heap.KIND_USERDATA then
            return PHRASE_USERDATA
        end
    end

    return PHRASE_USERDATA
end

local function isNumber(value: uint64): boolean
    return typePhrase(value) == PHRASE_NUMBER
end

-- type(v): the name of a value's type, as an interned string.
export function typeName(ctx: voidptr, value: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        if appendPhrase(h, builder, typePhrase(value)) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- Whether Lua's tostring of `value` is its type and address: a table,
-- function, thread or userdata.
export function identified(value: uint64): boolean
    local phrase = typePhrase(value)

    return phrase == PHRASE_TABLE or phrase == PHRASE_FUNCTION or phrase == PHRASE_THREAD or phrase == PHRASE_USERDATA
end

-- Appends Lua's tostring of an `identified` value with no __tostring: its
-- type and address in hexadecimal, "table: 0x6000012345a0".
export function appendIdentity(h: heap.Heap*, b: strings.Builder*, value: uint64): uint64
    -- ": 0x" as a little-endian byte word.
    local refused = appendPhrase(h, b, typePhrase(value)) | strings.appendWord(h, b, 0x7830203aULL, 4ULL)
    local address = value & values.PAYLOAD
    local shift: uint64 = 60ULL
    local started = false
    while true do
        local digit = (address >> shift) & 15ULL
        if digit ~= 0ULL or started or shift == 0ULL then
            started = true
            local c = digit + 48ULL
            if digit >= 10ULL then
                c = digit + 87ULL
            end
            refused = refused | strings.appendWord(h, b, c, 1ULL)
        end
        if shift == 0ULL then
            break
        end
        shift = shift - 4ULL
    end

    return refused
end

-- The message a handler's guest error carries, as Lua words it (without the
-- variable Lua names after it), or "runtime error" when no fault was noted.
local function runtimeError(ctx: voidptr): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local kind = native.load64(services, native.fieldOffset<Services>("fault"))
        local culprit = native.load64(services, native.fieldOffset<Services>("culprit"))
        local other = native.load64(services, native.fieldOffset<Services>("other"))
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if kind == FAULT_ARITH then
            local wrong = culprit
            if isNumber(culprit) then
                wrong = other
            end
            refused = appendPhrase(h, builder, PHRASE_ARITH)
                | appendPhrase(h, builder, typePhrase(wrong))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == FAULT_BITWISE then
            local wrong = culprit
            if isNumber(culprit) then
                wrong = other
            end
            refused = appendPhrase(h, builder, PHRASE_BITWISE)
                | appendPhrase(h, builder, typePhrase(wrong))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == FAULT_NOINT then
            refused = appendPhrase(h, builder, PHRASE_NOINT)
        elseif kind == FAULT_READONLY then
            refused = appendPhrase(h, builder, PHRASE_READONLY)
        elseif kind == FAULT_MODZERO then
            refused = appendPhrase(h, builder, PHRASE_MODZERO)
        elseif kind == FAULT_COMPARE then
            if typePhrase(culprit) == typePhrase(other) then
                refused = appendPhrase(h, builder, PHRASE_COMPARETWO)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_VALUES)
            else
                refused = appendPhrase(h, builder, PHRASE_COMPARE)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_WITH)
                    | appendPhrase(h, builder, typePhrase(other))
            end
        elseif kind == FAULT_LENGTH or kind == FAULT_INDEX or kind == FAULT_CALL then
            local lead = PHRASE_LENGTH
            if kind == FAULT_INDEX then
                lead = PHRASE_INDEX
            elseif kind == FAULT_CALL then
                lead = PHRASE_CALL
            end
            refused = appendPhrase(h, builder, lead)
                | appendPhrase(h, builder, typePhrase(culprit))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == FAULT_KEY then
            if culprit == values.NIL then
                refused = appendPhrase(h, builder, PHRASE_KEYNIL)
            else
                refused = appendPhrase(h, builder, PHRASE_KEYNAN)
            end
        else
            refused = strings.appendWord(h, builder, 0x20656d69746e7572ULL, 8ULL)
                | strings.appendWord(h, builder, 0x726f727265ULL, 5ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            return values.NIL
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- A runtime error a library call meets (a FAULT_ kind and the operands its
-- message names), raised as a library error.
export function raiseFault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("fault"), kind)
        native.store64(services, native.fieldOffset<Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<Services>("other"), other)
        local message = runtimeError(ctx)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        raiseLibrary(ctx, message)
    end
end

-- 1 when the function a frame runs owns affine values (its catalog record
-- lands errors).
local function lands(ctx: voidptr, frame: uint64): boolean
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local owner = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
        if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
            return false
        end
        local fn = native.pointer(
            native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
        )
        return native.load64(fn, native.fieldOffset<catalog.Function>("lands")) == 1ULL
    end
end

-- 1 when `frame`'s function owns affine values: an error lands at it.
export function ownsaffine(ctx: voidptr, frame: uint64): uint64
    if lands(ctx, frame) then
        return 1ULL
    end

    return 0ULL
end

-- A function that owns affine values and raised an error itself, at the
-- instruction `index` of function `owner` that its code follows with a
-- landing check (the LibCall LANDED, as after a call, its operand made by the
-- Nil or Move before it): the active frame, to resume at that check, or 0
-- when the error does not land there.
local function selfLanding(ctx: voidptr, state: voidptr, owner: uint64, index: uint64): uint64
    @unsafe do
        local active = native.load64(state, native.fieldOffset<frames.State>("active"))
        if active == 0ULL or not lands(ctx, active) then
            return 0ULL
        end
        local frame = native.pointer(active)
        if native.load64(frame, native.fieldOffset<frames.Frame>("functionId")) ~= owner then
            return 0ULL
        end
        local count = native.load64(frame, native.fieldOffset<frames.Frame>("instructionCount"))
        local code = native.pointer(native.load64(frame, native.fieldOffset<frames.Frame>("code")))
        local check = index + 1ULL
        local found = false
        while not found and check < count and check <= index + 4ULL do
            local at = native.offset(code, native.index(check * librarylayouts.INSTRUCTION_BYTES))
            local op = native.word(native.load8(at, 0))
            if op == librarylayouts.OPCODE_LIBCALL
                and native.word(native.load32(at, native.index(librarylayouts.ID_OFFSET))) == librarycalls.LANDED
            then
                found = true
            elseif op == librarylayouts.OPCODE_MOVE or op == librarylayouts.OPCODE_NIL then
                check = check + 1ULL
            else
                return 0ULL
            end
        end
        if not found then
            return 0ULL
        end
        -- A call the failing instruction prepared and never published.
        local child = native.load64(frame, native.fieldOffset<frames.Frame>("child"))
        if child ~= 0ULL
            and native.load64(native.pointer(child), native.fieldOffset<frames.Frame>("phase")) == frames.PREPARED
            and frames.abortPrepared(state, frame, native.pointer(child)) ~= 1ULL
        then
            return 0ULL
        end
        native.store64(frame, native.fieldOffset<frames.Frame>("resumePC"), index + 1ULL)
        -- From there the Nil or Move runs, then the check.

        return active
    end
end

-- The frame an error lands at: one that owns affine values and waits on the
-- call the error came from, if there is one before the nearest protected
-- call; 0 otherwise.
local function landingFrame(ctx: voidptr, state: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local closing = native.load64(services, native.fieldOffset<Services>("closing")) == 1ULL
        local at = native.load64(state, native.fieldOffset<frames.State>("active"))
        while at ~= 0ULL do
            if native.load64(
                native.pointer(at),
                native.fieldOffset<frames.Frame>("resultKind")
            ) == frames.PROTECTED_DESTINATION
                and not closing
            then
                return 0ULL
            end
            local parent = native.load64(native.pointer(at), native.fieldOffset<frames.Frame>("previous"))
            if parent ~= 0ULL and lands(ctx, parent) then
                return parent
            end
            at = parent
        end
        return 0ULL
    end
end

-- After a call in a function that owns affine values: false once, when an
-- error has landed there, else true.
export function takeLanded(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        if native.load64(services, native.fieldOffset<Services>("landed")) == 1ULL then
            native.store64(services, native.fieldOffset<Services>("landed"), 0ULL)
            return values.FALSE
        end
        return values.TRUE
    end
end

-- The text of the runtime's own `error("...")` that recorded `owner` and
-- `site` in the scope, as a string, or 0: the program carries the runtime's
-- raise texts after its dispatch table (`guestartifact`), from v8.
local function raiseText(ctx: voidptr, owner: uint64, site: uint64): uint64
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local bytes = native.load64(c, native.fieldOffset<catalog.Catalog>("dataBytes"))
        local base = native.pointer(data)
        if native.load64(base, native.fieldOffset<catalog.Descriptor>("version")) < 8ULL then
            return 0ULL
        end
        local at = native.load64(
            base,
            native.fieldOffset<catalog.Descriptor>("dispatch")
        ) + native.load64(base, native.fieldOffset<catalog.Descriptor>("handlerCount")) * 8ULL
        if at > bytes or bytes - at < 8ULL then
            return 0ULL
        end
        local count = native.load64(native.pointer(data + at), 0)
        if count > (bytes - at - 8ULL) // 24ULL then
            return 0ULL
        end
        local i: uint64 = 0ULL
        while i < count do
            local entry = native.pointer(data + at + 8ULL + i * 24ULL)
            if native.load64(entry, 0) == owner and native.load64(entry, 8) == site then
                local text = native.load64(entry, 16)
                if text > bytes or bytes - text < 8ULL then
                    return 0ULL
                end
                local length = native.load64(native.pointer(data + text), 0)
                if length > bytes - text - 8ULL then
                    return 0ULL
                end
                local made = makeString(ctx, data + text + 8ULL, length)
                if made == 0ULL then
                    return 0ULL
                end
                return values.TAG_OBJ | made
            end
            i = i + 1ULL
        end

        return 0ULL
    end
end

-- The frame an error unwinds to the protected call of: the nearest protected
-- frame, or 0 when there is none.
local function protectedFrame(state: voidptr): uint64
    @unsafe do
        local at = native.load64(state, native.fieldOffset<frames.State>("active"))
        while at ~= 0ULL do
            if native.load64(
                native.pointer(at),
                native.fieldOffset<frames.Frame>("resultKind")
            ) == frames.PROTECTED_DESTINATION then
                return at
            end
            at = native.load64(native.pointer(at), native.fieldOffset<frames.Frame>("previous"))
        end
        return 0ULL
    end
end

-- An error unwinding the frames above `stop` leaves every module whose chunk
-- one of them runs unloaded, as Lua's require does: the next require of it
-- runs its chunk again, where a module with named exports had published its
-- table as it started.
local function forgetModules(ctx: voidptr, state: voidptr, stop: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local loaded = native.load64(services, native.fieldOffset<Services>("loaded"))
        if loaded == 0ULL then
            return
        end
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local at = native.load64(state, native.fieldOffset<frames.State>("active"))
        while at ~= 0ULL and at ~= stop do
            local frame = native.pointer(at)
            if native.load64(frame, native.fieldOffset<frames.Frame>("resultKind")) == frames.MODULE_DESTINATION then
                local key = values.TAG_INTEGER | native.load64(frame, native.fieldOffset<frames.Frame>("functionId"))
                -- Clearing a present key allocates nothing.
                if tables.get(loaded & values.PAYLOAD, key) ~= values.NIL then
                    tables.set(h, loaded & values.PAYLOAD, key, values.NIL)
                end
            end
            at = native.load64(frame, native.fieldOffset<frames.Frame>("previous"))
        end
        tables.drain(h)
    end
end

-- After a guest error stops the handlers: unwinds it to the nearest protected
-- call (frames.recover) and answers the pc to resume at, or 0 when the stop
-- was not a guest error (a refusal, budget or cancellation is not one) or no
-- protected call is on the stack. The error's value is what error() raised,
-- else a runtime error message.
export function recoverEntry(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local status = native.load64(ctx, context.STATUS)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        local raisedInScope = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error")) ~= 0ULL
        if not (status == context.GUEST_ERROR_STATUS or status == 0ULL and raisedInScope) then
            return 0ULL
        end
        -- A library leaf's raise is the scope's error, which every service
        -- call below would take for its own failure: hold it aside, and put it
        -- back when no protected call takes the error.
        local scopeError = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error"))
        local scopeOwner = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"))
        local scopeSite = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"))
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        local value = native.load64(services, native.fieldOffset<Services>("raised"))
        local level = native.load64(services, native.fieldOffset<Services>("raisedLevel"))
        -- Where the error was raised: a failing handler's pc, or a library
        -- call's when the library raised it.
        local failedOwner = native.load64(ctx, context.ERROR_OWNER)
        local failedIndex = native.load64(ctx, context.ERROR_PC)
        local located = status == context.GUEST_ERROR_STATUS
        if not located and native.load64(services, native.fieldOffset<Services>("libraryRaised")) == 1ULL then
            failedOwner = native.load64(services, native.fieldOffset<Services>("libraryOwner"))
            failedIndex = native.load64(services, native.fieldOffset<Services>("libraryPc"))
            located = true
        end
        -- The runtime's own error("..."): its text, positioned at the library
        -- call it raised in, as Lua positions a library's error.
        local inLibrary = native.load64(services, native.fieldOffset<Services>("libraryActive")) == 1ULL
        native.store64(services, native.fieldOffset<Services>("libraryActive"), 0ULL)
        local literal = false
        if value == 0ULL
            and scopeError == 1ULL
            and native.load64(services, native.fieldOffset<Services>("fault")) == 0ULL
        then
            local text = raiseText(ctx, scopeOwner, scopeSite)
            if text ~= 0ULL then
                value, level, literal = text, 0ULL, true
                if inLibrary then
                    level = 1ULL
                    if not located then
                        failedOwner = native.load64(services, native.fieldOffset<Services>("libraryOwner"))
                        failedIndex = native.load64(services, native.fieldOffset<Services>("libraryPc"))
                        located = true
                    end
                end
            end
        end
        if value == 0ULL then
            value = runtimeError(ctx)
            level = 1ULL
        end
        -- A failure the handlers recorded names its owner and pc; one a
        -- library leaf raised does not.
        if status == context.GUEST_ERROR_STATUS then
            value = positioned(
                ctx,
                value,
                level,
                native.load64(ctx, context.ERROR_OWNER),
                native.load64(ctx, context.ERROR_PC)
            )
        elseif native.load64(services, native.fieldOffset<Services>("libraryRaised")) == 1ULL or literal then
            value = positioned(
                ctx,
                value,
                level,
                native.load64(services, native.fieldOffset<Services>("libraryOwner")),
                native.load64(services, native.fieldOffset<Services>("libraryPc"))
            )
        end
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        -- A library call in replay that raised left its entry, which the
        -- next one drops.
        native.store64(services, native.fieldOffset<Services>("replay"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("replaysuspend"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("lastError"), value)
        local state = native.loadPointer(ctx, context.STATE)
        -- A frame that owns affine values and raised the error itself, or
        -- waits on a call nearer than any protected call, takes it first.
        local closing = native.load64(services, native.fieldOffset<Services>("closing")) == 1ULL
        local own: uint64 = 0ULL
        if located and not closing then
            own = selfLanding(ctx, state, failedOwner, failedIndex)
        end
        local landing: uint64 = 0ULL
        if own == 0ULL then
            landing = landingFrame(ctx, state)
        end
        -- The frames the error unwinds: those above the landing frame, or up
        -- to the protected call (all of them when none takes it).
        if own == 0ULL and landing ~= 0ULL then
            forgetModules(ctx, state, landing)
        elseif own == 0ULL and not closing then
            forgetModules(ctx, state, protectedFrame(state))
        end
        local parent: uint64 = 0ULL
        if own ~= 0ULL then
            parent = own
            native.store64(services, native.fieldOffset<Services>("landed"), 1ULL)
        elseif landing ~= 0ULL then
            parent = frames.land(state, landing)
            if parent ~= 0ULL then
                native.store64(services, native.fieldOffset<Services>("landed"), 1ULL)
            end
        elseif native.load64(services, native.fieldOffset<Services>("closing")) == 0ULL then
            parent = frames.recover(state, value)
        end
        if parent == 0ULL then
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), scopeError)
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), scopeOwner)
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), scopeSite)
            return 0ULL
        end
        native.store64(ctx, context.STATUS, 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        access.refresh(state, native.pointer(parent), ctx)
        return access.pc(state, native.pointer(parent))
    end
end

-- Whether an error is failing the entry that a recovery could take: what
-- recoverEntry recovers from.
export function failing(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local status = native.load64(ctx, context.STATUS)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        local raisedInScope = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error")) ~= 0ULL
        if status == context.GUEST_ERROR_STATUS or status == 0ULL and raisedInScope then
            return 1ULL
        end

        return 0ULL
    end
end

-- Nothing is failing any more: an error was given to a coroutine's resumer
-- (`threads`) rather than to a frame.
export function recovered(ctx: voidptr): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        native.store64(ctx, context.STATUS, 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryActive"), 0ULL)
    end
end

-- Fails the entry with `value` raised again at `pc` in function `owner`, a
-- string getting that position: a wrapped coroutine's error, raised where
-- the wrapped function was called, as Lua 5.5 raises it.
export function reraise(ctx: voidptr, value: uint64, owner: uint64, pc: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(ctx, context.ERROR_OWNER, owner)
        native.store64(ctx, context.ERROR_PC, pc)
        native.store64(services, native.fieldOffset<Services>("raised"), value)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 1ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        native.store64(ctx, context.STATUS, context.GUEST_ERROR_STATUS)
    end
end
