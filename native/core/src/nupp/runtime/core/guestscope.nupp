module nupp.runtime.core.guestscope

-- A guest entry's services: a page ledger and the service scope handlers make
-- scoped calls with, in caller-provided scratch, and the guest heap. The heap
-- lives for the whole entry rather than a lexical scope, so its arena is built
-- in place over one scoped mapping and torn down by close, not by an affine
-- owner.
const native = require("nupp.runtime.vm.intrinsics")
const os = require("nupp.runtime.vm.os")
const arena = require("nupp.runtime.vm.arena")
const heap = require("nupp.runtime.vm.heap")
const collector = require("nupp.runtime.vm.collector")
const pages = require("nupp.runtime.core.pagemappings")
const servicescope = require("nupp.runtime.core.servicescope")
const context = require("nupp.runtime.core.context")
const values = require("nupp.runtime.vm.values")
const tables = require("nupp.runtime.core.coretables")
const strings = require("nupp.runtime.core.corestrings")
const ints = require("nupp.runtime.core.coreintegers")
const catalog = require("nupp.runtime.core.guestcatalog")
const frames = require("nupp.runtime.core.frames")
const access = require("nupp.runtime.core.frameaccess")

-- The scope comes first, so a Services address is also its scope's address.
export struct Services
    scope: servicescope.ServiceScope
    heap: uint64
    arena: uint64
    -- The value error() raised that no protected call has taken yet, or 0,
    -- and the level it was raised at: 1 cites where error was called, 2 that
    -- function's caller, 0 nothing.
    raised: uint64
    raisedLevel: uint64
    -- What a handler's guest error was (a FAULT_ kind, 0 for none) and the
    -- operands its message names.
    fault: uint64
    culprit: uint64
    other: uint64
    -- The __index or __newindex function a table access found, and the
    -- table whose metatable named it, for its handler to call; 0 for none.
    metaCallee: uint64
    metaSelf: uint64
    -- The value the last recovered error carried, for xpcall's handler.
    lastError: uint64
    -- 1 while an error landed at a frame that owns affine values: its next
    -- status check (LANDED) takes the failure path, destroys them and raises
    -- lastError again.
    landed: uint64
    -- math.random's xoshiro256** state, all zero until the first draw or
    -- math.randomseed seeds it.
    random0: uint64
    random1: uint64
    random2: uint64
    random3: uint64
    -- The library call running (its function's name, a guesttexts NAME_, and
    -- its argument count) and its owner and pc, which a library error's
    -- position names; libraryRaised is 1 while `raised` holds such an error.
    libraryName: uint64
    libraryCount: uint64
    libraryOwner: uint64
    libraryPc: uint64
    libraryRaised: uint64
    -- 1 when the library call is in method form (`s:rep(n)`).
    libraryMethod: uint64
    -- The coroutine running (`threads`), as a value rooted for as long as it
    -- runs, or 0 on the main one; and the main one's thread, once
    -- coroutine.running has made one.
    running: uint64
    main: uint64
    -- 1 while coroutine.close unwinds a suspended thread: its error lands at
    -- every frame that owns affine values, and no protected call takes it.
    closing: uint64
end

-- tableSet's answer when a __newindex function is to be called instead.
export const META_PENDING: uint64 = 100ULL

export const FAULT_ARITH: uint64 = 1ULL
export const FAULT_MODZERO: uint64 = 2ULL
export const FAULT_COMPARE: uint64 = 3ULL
export const FAULT_LENGTH: uint64 = 4ULL
export const FAULT_INDEX: uint64 = 5ULL
export const FAULT_CALL: uint64 = 6ULL
export const FAULT_KEY: uint64 = 7ULL

const LEDGER: uint64 = 256ULL
const RECORDS: uint64 = 256ULL
const HEAP_BYTES: uint64 = 16777216ULL

local function roundUp(value: uint64, alignment: uint64): uint64
    return (value + (alignment - 1ULL)) & ~(alignment - 1ULL)
end

-- The scratch region holds the ledger, its mapping records and the Services,
-- in that order. Answers the Services address; zero refuses.
export function prepare(base: voidptr, bytes: uint64): uint64
    local recordBytes = RECORDS * native.sizeOf<pages.Mapping>()
    local servicesOffset = LEDGER + recordBytes
    if bytes < servicesOffset + native.sizeOf<Services>() then
        return 0ULL
    end
    local records = native.offset(base, native.index(LEDGER))
    if pages.initialize(base, LEDGER, records, recordBytes, RECORDS) ~= 1ULL then
        return 0ULL
    end
    local services = native.offset(base, native.index(servicesOffset))
    if servicescope.initialize(services, native.sizeOf<servicescope.ServiceScope>(), base, LEDGER) ~= 1ULL then
        return 0ULL
    end
    native.store64(services, native.fieldOffset<Services>("heap"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("arena"), 0ULL)

    return native.address(services)
end

-- Maps the heap's arena, creates the heap in it and registers the guest frame
-- pool and module world as root ranges: their words may be stale, which root
-- marking tolerates. Answers 1, or 0 when the mapping is refused.
export function open(
    services: voidptr,
    pool: uint64,
    poolWords: uint64,
    world: uint64,
    worldWords: uint64,
    stress: uint64
): uint64
    local metadata = roundUp(native.sizeOf<arena.Chunk>(), native.alignmentOf<arena.Arena>())
    local header = roundUp(metadata + native.sizeOf<arena.Arena>(), 16ULL)
    local mapped = roundUp(HEAP_BYTES + header, os.pageSize())
    local base = os.mapPages(mapped)
    if base == nil then
        return 0ULL
    end
    @unsafe do
        local chunk = base as arena.Chunk*
        local a = native.offset(base, native.index(metadata)) as arena.Arena*
        chunk.previous = nil
        chunk.bytes = mapped
        a.chunk = chunk
        a.cursor = native.address(base) + header
        a.limit = native.address(base) + mapped
        a.chunkBytes = mapped
        -- The heap's metadata grows with the guest: further chunks are mapped
        -- through the scope and unmapped by close.
        a.growable = true
        local h = heap.create(a)
        collector.register(h, pool, poolWords)
        collector.register(h, world, worldWords)
        native.store64(services, native.fieldOffset<Services>("running"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("main"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("closing"), 0ULL)
        collector.register(h, native.address(native.offset(services, native.fieldOffset<Services>("running"))), 2ULL)
        -- Collect-at-every-allocation: a whole cycle at every safepoint.
        h.stress = stress ~= 0ULL
        native.store64(services, native.fieldOffset<Services>("heap"), native.address(h))
        native.store64(services, native.fieldOffset<Services>("arena"), native.address(a))
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("metaCallee"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("landed"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random0"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random1"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random2"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("random3"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryName"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryCount"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
    end

    return 1ULL
end

-- Destroys the heap and unmaps its arena; nothing when open never ran.
export function close(services: voidptr): nil
    local address = native.load64(services, native.fieldOffset<Services>("heap"))
    if address == 0ULL then
        return
    end
    @unsafe do
        -- Unrooted, a last cycle retires every table so its owned parts are
        -- released before the heap goes.
        local h = native.pointer(address) as heap.Heap*
        h.ranges.count = 0ULL
        collector.fullCycle(h)
        tables.drain(h)
        heap.destroy(native.pointer(address) as heap.Heap*)
        local a = native.pointer(native.load64(services, native.fieldOffset<Services>("arena"))) as arena.Arena*
        local chunk: arena.Chunk*? = a.chunk
        while chunk ~= nil do
            local previous = chunk.previous
            os.unmapPages(chunk as voidptr, chunk.bytes)
            chunk = previous
        end
    end
    native.store64(services, native.fieldOffset<Services>("heap"), 0ULL)
    native.store64(services, native.fieldOffset<Services>("arena"), 0ULL)
end

-- The first raised error code, or 1000 when the scope cannot close cleanly
-- (a mapping is still live or backing was retained).
export function finish(services: voidptr): uint64
    local failure = native.load64(services, native.fieldOffset<servicescope.ServiceScope>("error"))
    if servicescope.close(services) ~= 1ULL and failure == 0ULL then
        return 1000ULL
    end

    return failure
end

-- Handlers reach the heap through these leaves, which hold the typed views a
-- handler cannot. `ctx` is the handler's context.
local function guestHeap(ctx: voidptr): uint64
    local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
    return native.load64(services, native.fieldOffset<Services>("heap"))
end

-- A fresh `kind` object of `length` value slots, all nil; answers its header
-- address. Its slots may be written directly until `initialized`.
export function allocate(ctx: voidptr, kind: uint64, length: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        tables.drain(h)
        local o = collector.allocate(h, kind, length * 8ULL)
        o.auxLen = length
        local i: uint64 = 0ULL
        while i < length do
            native.store64(native.pointer(o.auxPtr), native.index(i * 8ULL), values.NIL)
            i = i + 1ULL
        end

        return native.address(o as voidptr)
    end
end

-- Ends an object's construction (see collector.initialized).
export function initialized(ctx: voidptr, header: uint64): nil
    @unsafe do
        collector.initialized(native.pointer(guestHeap(ctx)) as heap.Heap*, native.pointer(header) as heap.Header*)
    end
end

-- Stores `value` in slot `index` of a constructed object, through the barrier.
export function store(ctx: voidptr, header: uint64, index: uint64, value: uint64): nil
    @unsafe do
        local o = native.pointer(header) as heap.Header*
        collector.barrier(native.pointer(guestHeap(ctx)) as heap.Heap*, o, value)
        native.store64(native.pointer(o.auxPtr), native.index(index * 8ULL), value)
    end
end

-- A fresh table on the entry's heap; answers its header address.
export function newTable(ctx: voidptr): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = tables.create(h)
        tables.drain(h)

        return t
    end
end

-- The pack {[0] = n, ...} of the `count` values at `source` followed by the
-- values of `extra`, a pack (0 for none): a call's results for a caller that
-- takes them all as one value.
export function packValues(ctx: voidptr, source: voidptr, count: uint64, extra: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = tables.create(h)
        local n: uint64 = 0ULL
        while n < count do
            if tables.set(
                h,
                t,
                values.TAG_INTEGER | (n + 1ULL),
                native.load64(source, native.index(n * 8ULL))
            ) == tables.NO_MEMORY then
                error("not enough memory")
            end
            n = n + 1ULL
        end
        if extra ~= 0ULL then
            local more = ints.bitsOf(tables.get(extra, values.TAG_INTEGER))
            local k: uint64 = 1ULL
            while k <= more do
                n = n + 1ULL
                if tables.set(
                    h,
                    t,
                    values.TAG_INTEGER | n,
                    tables.get(extra, values.TAG_INTEGER | k)
                ) == tables.NO_MEMORY then
                    error("not enough memory")
                end
                k = k + 1ULL
            end
        end
        if tables.set(h, t, values.TAG_INTEGER, values.TAG_INTEGER | n) == tables.NO_MEMORY then
            error("not enough memory")
        end
        tables.drain(h)

        return values.TAG_OBJ | t
    end
end

export const META_INDEX: uint64 = 0ULL
export const META_NEWINDEX: uint64 = 1ULL
export const META_METATABLE: uint64 = 2ULL
export const META_ADD: uint64 = 3ULL
export const META_SUB: uint64 = 4ULL
export const META_MUL: uint64 = 5ULL
export const META_MOD: uint64 = 6ULL
export const META_LEN: uint64 = 7ULL
export const META_LT: uint64 = 8ULL
export const META_LE: uint64 = 9ULL
export const META_EQ: uint64 = 10ULL
export const META_CONCAT: uint64 = 11ULL
export const META_DIV: uint64 = 12ULL
export const META_IDIV: uint64 = 13ULL
export const META_TOSTRING: uint64 = 14ULL
export const META_UNM: uint64 = 15ULL
export const META_CALL: uint64 = 16ULL
export const META_POW: uint64 = 17ULL

-- The interned name of a metatable field: "__index", "__newindex" or
-- "__metatable".
export function metaKey(ctx: voidptr, which: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if which == META_INDEX then
            refused = strings.appendWord(h, builder, 0x7865646e695f5fULL, 7ULL)
        elseif which == META_NEWINDEX then
            refused = strings.appendWord(h, builder, 0x646e6977656e5f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x7865ULL, 2ULL)
        elseif which == META_ADD then
            refused = strings.appendWord(h, builder, 0x6464615f5fULL, 5ULL)
        elseif which == META_SUB then
            refused = strings.appendWord(h, builder, 0x6275735f5fULL, 5ULL)
        elseif which == META_MUL then
            refused = strings.appendWord(h, builder, 0x6c756d5f5fULL, 5ULL)
        elseif which == META_MOD then
            refused = strings.appendWord(h, builder, 0x646f6d5f5fULL, 5ULL)
        elseif which == META_LEN then
            refused = strings.appendWord(h, builder, 0x6e656c5f5fULL, 5ULL)
        elseif which == META_LT then
            refused = strings.appendWord(h, builder, 0x746c5f5fULL, 4ULL)
        elseif which == META_LE then
            refused = strings.appendWord(h, builder, 0x656c5f5fULL, 4ULL)
        elseif which == META_EQ then
            refused = strings.appendWord(h, builder, 0x71655f5fULL, 4ULL)
        elseif which == META_CONCAT then
            refused = strings.appendWord(h, builder, 0x7461636e6f635f5fULL, 8ULL)
        elseif which == META_DIV then
            refused = strings.appendWord(h, builder, 0x7669645f5fULL, 5ULL)
        elseif which == META_IDIV then
            refused = strings.appendWord(h, builder, 0x766964695f5fULL, 6ULL)
        elseif which == META_TOSTRING then
            refused = strings.appendWord(h, builder, 0x697274736f745f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x676eULL, 2ULL)
        elseif which == META_UNM then
            refused = strings.appendWord(h, builder, 0x6d6e755f5fULL, 5ULL)
        elseif which == META_CALL then
            refused = strings.appendWord(h, builder, 0x6c6c61635f5fULL, 6ULL)
        elseif which == META_POW then
            refused = strings.appendWord(h, builder, 0x776f705f5fULL, 5ULL)
        else
            refused = strings.appendWord(h, builder, 0x61746174656d5f5fULL, 8ULL)
                | strings.appendWord(h, builder, 0x656c62ULL, 3ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- The table a value names, or 0.
local function tableOf(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    @unsafe do
        local header = native.pointer(value & values.PAYLOAD)
        if native.word(native.load8(header, native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_TABLE then
            return 0ULL
        end
    end

    return value & values.PAYLOAD
end

-- The `which` field of a table's metatable, nil when it has none.
export function metaField(ctx: voidptr, table: uint64, which: uint64): uint64
    local mt = tableOf(tables.meta(table))
    if mt == 0ULL then
        return values.NIL
    end

    return tables.get(mt, metaKey(ctx, which))
end

-- Notes the metamethod function a table access is to call.
local function pend(ctx: voidptr, callee: uint64, table: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("metaCallee"), callee)
        native.store64(services, native.fieldOffset<Services>("metaSelf"), values.TAG_OBJ | table)
    end
end

-- The metamethod function the last table access noted, or 0; taking it
-- clears it. `metaSelf` is the table it is called for.
export function takeMeta(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local callee = native.load64(services, native.fieldOffset<Services>("metaCallee"))
        native.store64(services, native.fieldOffset<Services>("metaCallee"), 0ULL)
        return callee
    end
end

-- The value the last recovered error carried.
export function lastError(ctx: voidptr): uint64
    @unsafe do
        return native.load64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("lastError"))
    end
end

export function metaSelf(ctx: voidptr): uint64
    @unsafe do
        return native.load64(native.loadPointer(ctx, context.SERVICE_SCOPE), native.fieldOffset<Services>("metaSelf"))
    end
end

-- The `which` metamethod of an operation on `a` and `b`: the first
-- operand's when it has one, else the second's; 0 when neither is a table
-- with it.
export function binaryMeta(ctx: voidptr, which: uint64, a: uint64, b: uint64): uint64
    local first = tableOf(a)
    if first ~= 0ULL then
        local found = metaField(ctx, first, which)
        if found ~= values.NIL then
            return found
        end
    end
    local second = tableOf(b)
    if second ~= 0ULL then
        local found = metaField(ctx, second, which)
        if found ~= values.NIL then
            return found
        end
    end

    return 0ULL
end

-- Lua's t[k]: the raw value, else through the metatable's __index while it
-- names a table. An __index function is noted (`takeMeta`) for the handler
-- to call, and nil answered meanwhile.
export function tableGet(ctx: voidptr, table: uint64, key: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = table
        local depth: uint64 = 0ULL
        while true do
            local value = tables.lookup(h, t, key)
            if value ~= values.NIL or tables.meta(t) == values.NIL then
                return value
            end
            local index = metaField(ctx, t, META_INDEX)
            if index == values.NIL then
                return values.NIL
            end
            local next = tableOf(index)
            if next == 0ULL then
                pend(ctx, index, t)
                return values.NIL
            end
            t = next
            depth = depth + 1ULL
            if depth >= 2000ULL then
                error("'__index' chain too long; possible loop")
            end
        end

        return values.NIL
    end
end

-- Lua's t[k] = v: a key the table holds, or one its metatable has no
-- __newindex for, is stored in place; otherwise in the table __newindex
-- names. Answers coretables.set's status, or META_PENDING when a __newindex
-- function is noted (`takeMeta`) for the handler to call.
export function tableSet(ctx: voidptr, table: uint64, key: uint64, value: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local t = table
        local depth: uint64 = 0ULL
        while tables.meta(t) ~= values.NIL and tables.lookup(h, t, key) == values.NIL do
            local newindex = metaField(ctx, t, META_NEWINDEX)
            if newindex == values.NIL then
                break
            end
            local next = tableOf(newindex)
            if next == 0ULL then
                pend(ctx, newindex, t)
                return META_PENDING
            end
            t = next
            depth = depth + 1ULL
            if depth >= 2000ULL then
                error("'__newindex' chain too long; possible loop")
            end
        end
        local status = tables.set(h, t, key, value)
        tables.drain(h)

        return status
    end
end

-- setmetatable(t, mt): answers t; a metatable with __metatable set is
-- protected.
export function setMetatable(ctx: voidptr, value: uint64, mt: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'setmetatable' (table expected)")
    end
    if mt ~= values.NIL and tableOf(mt) == 0ULL then
        error("bad argument #2 to 'setmetatable' (nil or table expected)")
    end
    if metaField(ctx, t, META_METATABLE) ~= values.NIL then
        error("cannot change a protected metatable")
    end
    @unsafe do
        tables.setMeta(native.pointer(guestHeap(ctx)) as heap.Heap*, t, mt)
    end

    return value
end

-- getmetatable(v): a table's metatable, or its __metatable field when it
-- has one; nil for anything else.
export function getMetatable(ctx: voidptr, value: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        return values.NIL
    end
    local protected = metaField(ctx, t, META_METATABLE)
    if protected ~= values.NIL then
        return protected
    end

    return tables.meta(t)
end

-- rawset(t, k, v): stores past any metatable; answers t.
export function rawSet(ctx: voidptr, value: uint64, key: uint64, item: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'rawset' (table expected)")
    end
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        if tables.set(h, t, key, item) ~= tables.OK then
            error("invalid key to 'rawset'")
        end
        tables.drain(h)
    end

    return value
end

-- rawget(t, k): the raw value.
export function rawGet(ctx: voidptr, value: uint64, key: uint64): uint64
    local t = tableOf(value)
    if t == 0ULL then
        error("bad argument #1 to 'rawget' (table expected)")
    end
    @unsafe do
        return tables.lookup(native.pointer(guestHeap(ctx)) as heap.Heap*, t, key)
    end
end

-- The interned string a v8 string constant word names in the catalog data;
-- answers its header address.
export function stringConstant(ctx: voidptr, word: uint64): uint64
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local at = data + (word & values.PAYLOAD)
        return strings.make(
            native.pointer(guestHeap(ctx)) as heap.Heap*,
            at + 8ULL,
            native.load64(native.pointer(at), 0)
        )
    end
end

-- The interned string of `count` bytes at `bytes`, on the entry's heap.
export function makeString(ctx: voidptr, bytes: uint64, count: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local s = strings.make(h, bytes, count)
        tables.drain(h)
        return s
    end
end

-- The canonical value of int64 `bits` on the entry's heap: an immediate, or
-- the interned box.
-- The boxed integer a v8 wide integer constant word names in the catalog
-- data.
export function integerConstant(ctx: voidptr, word: uint64): uint64
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local value = ints.make(h, native.load64(native.pointer(data + (word & values.PAYLOAD)), 0))
        tables.drain(h)
        return value
    end
end

export function integer(ctx: voidptr, bits: uint64): uint64
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local value = ints.make(h, bits)
        tables.drain(h)
        return value
    end
end

-- error(value [, level]): the value and level are kept for the protected
-- call the entry's failure unwinds to (`recoverEntry`); the caller fails the
-- entry as any guest error does.
export function raise(ctx: voidptr, value: uint64, level: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("raised"), value)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), level)
    end
end

-- Before a library call: which call it is and where, for its errors.
export function librarySite(ctx: voidptr, frame: voidptr, pc: voidptr, count: uint64, method: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("libraryCount"), count)
        native.store64(services, native.fieldOffset<Services>("libraryMethod"), method)
        native.store64(
            services,
            native.fieldOffset<Services>("libraryOwner"),
            native.load64(frame, native.fieldOffset<frames.Frame>("functionId"))
        )
        local code = native.load64(frame, native.fieldOffset<frames.Frame>("code"))
        local address = native.address(pc)
        local index: uint64 = 0ULL
        if address >= code then
            index = (address - code) // 16ULL
        end
        native.store64(services, native.fieldOffset<Services>("libraryPc"), index)
    end
end

export function libraryMethod(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryMethod")
        )
    end
end

-- The name of the library function running, for its errors.
export function nameLibrary(ctx: voidptr, name: uint64): nil
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryName"),
            name
        )
    end
end

export function libraryNameOf(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryName")
        )
    end
end

export function libraryCount(ctx: voidptr): uint64
    @unsafe do
        return native.load64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryCount")
        )
    end
end

-- A library error: `message` raised at level 1, positioned at the library
-- call once the entry's failure unwinds to its recovery.
export function raiseLibrary(ctx: voidptr, message: uint64): nil
    raise(ctx, message, 1ULL)
    @unsafe do
        native.store64(
            native.loadPointer(ctx, context.SERVICE_SCOPE),
            native.fieldOffset<Services>("libraryRaised"),
            1ULL
        )
    end
end

-- A string message with Lua's position before it, "chunk:line: ", naming
-- the frame `level` calls out from the one that failed: 1 is that frame at
-- `pc` in `owner`, 2 its caller at the call. Anything else, or a frame with
-- no known line, answers the message as it is. pcall has no line, so a
-- level past a protected call's own frame names nothing.
local function positioned(ctx: voidptr, message: uint64, level: uint64, failedOwner: uint64, failedPc: uint64): uint64
    local state0 = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local s = strings.header(message)
        if s == 0ULL or level == 0ULL then
            return message
        end
        local state = native.loadPointer(ctx, context.STATE)
        local frame = native.load64(state, native.fieldOffset<frames.State>("active"))
        local owner = failedOwner
        local pc = failedPc
        local k: uint64 = 1ULL
        while k < level do
            if frame == 0ULL
                or native.load64(
                    native.pointer(frame),
                    native.fieldOffset<frames.Frame>("resultKind")
                ) == frames.PROTECTED_DESTINATION
            then
                return message
            end
            frame = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("previous"))
            if frame == 0ULL then
                return message
            end
            owner = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
            local resume = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("resumePC"))
            if resume == 0ULL then
                return message
            end
            pc = resume - 1ULL
            k = k + 1ULL
        end
        local c = native.loadPointer(ctx, context.CATALOG)
        if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
            return message
        end
        local data = native.load64(c, native.fieldOffset<catalog.Catalog>("data"))
        local fn = native.pointer(
            native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
        )
        local lines = native.load64(fn, native.fieldOffset<catalog.Function>("lines"))
        local chunk = native.load64(fn, native.fieldOffset<catalog.Function>("chunk"))
        if lines == 0ULL
            or chunk == 0ULL
            or pc >= native.load64(fn, native.fieldOffset<catalog.Function>("instructionCount"))
        then
            return message
        end
        local line = native.load64(native.pointer(data + lines + pc * 8ULL), 0)
        if line == 0ULL then
            return message
        end
        local at = data + (chunk & values.PAYLOAD)
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state0 as strings.Builder*
        if strings.append(h, builder, at + 8ULL, native.load64(native.pointer(at), 0)) ~= 0ULL
            or strings.appendWord(h, builder, 58ULL, 1ULL) ~= 0ULL
            or strings.appendInteger(h, builder, native.index(line)) ~= 0ULL
            or strings.appendWord(h, builder, 0x203aULL, 2ULL) ~= 0ULL
            or strings.appendString(h, builder, s) ~= 0ULL
        then
            strings.release(builder)
            return message
        end
        local result = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | result
    end
end

-- A handler's guest error, before it fails the entry: what went wrong, for
-- the message Lua words (`runtimeError`), and the operands it names.
export function fault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("fault"), kind)
        native.store64(services, native.fieldOffset<Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<Services>("other"), other)
    end
end

-- Phrases runtime error messages are built from, by id.
const PHRASE_ARITH: uint64 = 1ULL
const PHRASE_MODZERO: uint64 = 2ULL
const PHRASE_COMPARETWO: uint64 = 3ULL
const PHRASE_VALUES: uint64 = 4ULL
const PHRASE_COMPARE: uint64 = 5ULL
const PHRASE_WITH: uint64 = 6ULL
const PHRASE_LENGTH: uint64 = 7ULL
const PHRASE_INDEX: uint64 = 8ULL
const PHRASE_CALL: uint64 = 9ULL
const PHRASE_VALUE: uint64 = 10ULL
const PHRASE_NIL: uint64 = 11ULL
const PHRASE_BOOLEAN: uint64 = 12ULL
const PHRASE_NUMBER: uint64 = 13ULL
const PHRASE_STRING: uint64 = 14ULL
const PHRASE_TABLE: uint64 = 15ULL
const PHRASE_FUNCTION: uint64 = 16ULL
const PHRASE_USERDATA: uint64 = 17ULL
const PHRASE_KEYNIL: uint64 = 18ULL
const PHRASE_KEYNAN: uint64 = 19ULL
const PHRASE_THREAD: uint64 = 20ULL

-- Appends phrase `id`; answers 1 when backing is refused.
local function appendPhrase(h: heap.Heap*, b: strings.Builder*, id: uint64): uint64
    if id == PHRASE_ARITH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x6874697261206d72ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6f20636974656dULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_MODZERO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f66726570206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2730256e27206d72ULL, 8ULL)
    elseif id == PHRASE_COMPARETWO then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206f7774206572ULL, 7ULL)
    elseif id == PHRASE_VALUES then
        return strings.appendWord(h, b, 0x7365756c617620ULL, 7ULL)
    elseif id == PHRASE_COMPARE then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x61706d6f63206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206572ULL, 3ULL)
    elseif id == PHRASE_WITH then
        return strings.appendWord(h, b, 0x206874697720ULL, 6ULL)
    elseif id == PHRASE_LENGTH then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c20746567206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x666f206874676e65ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_INDEX then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x7865646e69206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == PHRASE_CALL then
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x206c6c6163206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == PHRASE_VALUE then
        return strings.appendWord(h, b, 0x65756c617620ULL, 6ULL)
    elseif id == PHRASE_NIL then
        return strings.appendWord(h, b, 0x6c696eULL, 3ULL)
    elseif id == PHRASE_BOOLEAN then
        return strings.appendWord(h, b, 0x6e61656c6f6f62ULL, 7ULL)
    elseif id == PHRASE_NUMBER then
        return strings.appendWord(h, b, 0x7265626d756eULL, 6ULL)
    elseif id == PHRASE_STRING then
        return strings.appendWord(h, b, 0x676e69727473ULL, 6ULL)
    elseif id == PHRASE_TABLE then
        return strings.appendWord(h, b, 0x656c626174ULL, 5ULL)
    elseif id == PHRASE_FUNCTION then
        return strings.appendWord(h, b, 0x6e6f6974636e7566ULL, 8ULL)
    elseif id == PHRASE_USERDATA then
        return strings.appendWord(h, b, 0x6174616472657375ULL, 8ULL)
    elseif id == PHRASE_THREAD then
        return strings.appendWord(h, b, 0x646165726874ULL, 6ULL)
    elseif id == PHRASE_KEYNIL then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c69ULL, 2ULL)
    elseif id == PHRASE_KEYNAN then
        return strings.appendWord(h, b, 0x6e6920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e20736920786564ULL, 8ULL)
            | strings.appendWord(h, b, 0x4e61ULL, 2ULL)
    end

    return 0ULL
end

-- The phrase naming a value's type, as Lua's type() does.
local function typePhrase(value: uint64): uint64
    if value == values.NIL then
        return PHRASE_NIL
    elseif value == values.TRUE or value == values.FALSE then
        return PHRASE_BOOLEAN
    elseif ints.isInteger(value) or value & values.QNAN ~= values.QNAN or value == values.QNAN then
        return PHRASE_NUMBER
    elseif strings.header(value) ~= 0ULL then
        return PHRASE_STRING
    end
    @unsafe do
        local kind = native.word(
            native.load8(native.pointer(value & values.PAYLOAD), native.fieldOffset<heap.Header>("kind"))
        )
        if kind == heap.KIND_TABLE then
            return PHRASE_TABLE
        elseif kind == heap.KIND_CLOSURE then
            return PHRASE_FUNCTION
        elseif kind == heap.KIND_THREAD then
            return PHRASE_THREAD
        end
    end

    return PHRASE_USERDATA
end

local function isNumber(value: uint64): boolean
    return typePhrase(value) == PHRASE_NUMBER
end

-- type(v): the name of a value's type, as an interned string.
export function typeName(ctx: voidptr, value: uint64): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        if appendPhrase(h, builder, typePhrase(value)) ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- The message a handler's guest error carries, as Lua words it (without the
-- variable Lua names after it), or "runtime error" when no fault was noted.
local function runtimeError(ctx: voidptr): uint64
    local state = new strings.Builder(0ULL, 0ULL, 0ULL)
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local kind = native.load64(services, native.fieldOffset<Services>("fault"))
        local culprit = native.load64(services, native.fieldOffset<Services>("culprit"))
        local other = native.load64(services, native.fieldOffset<Services>("other"))
        local h = native.pointer(guestHeap(ctx)) as heap.Heap*
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if kind == FAULT_ARITH then
            local wrong = culprit
            if isNumber(culprit) then
                wrong = other
            end
            refused = appendPhrase(h, builder, PHRASE_ARITH)
                | appendPhrase(h, builder, typePhrase(wrong))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == FAULT_MODZERO then
            refused = appendPhrase(h, builder, PHRASE_MODZERO)
        elseif kind == FAULT_COMPARE then
            if typePhrase(culprit) == typePhrase(other) then
                refused = appendPhrase(h, builder, PHRASE_COMPARETWO)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_VALUES)
            else
                refused = appendPhrase(h, builder, PHRASE_COMPARE)
                    | appendPhrase(h, builder, typePhrase(culprit))
                    | appendPhrase(h, builder, PHRASE_WITH)
                    | appendPhrase(h, builder, typePhrase(other))
            end
        elseif kind == FAULT_LENGTH or kind == FAULT_INDEX or kind == FAULT_CALL then
            local lead = PHRASE_LENGTH
            if kind == FAULT_INDEX then
                lead = PHRASE_INDEX
            elseif kind == FAULT_CALL then
                lead = PHRASE_CALL
            end
            refused = appendPhrase(h, builder, lead)
                | appendPhrase(h, builder, typePhrase(culprit))
                | appendPhrase(h, builder, PHRASE_VALUE)
        elseif kind == FAULT_KEY then
            if culprit == values.NIL then
                refused = appendPhrase(h, builder, PHRASE_KEYNIL)
            else
                refused = appendPhrase(h, builder, PHRASE_KEYNAN)
            end
        else
            refused = strings.appendWord(h, builder, 0x20656d69746e7572ULL, 8ULL)
                | strings.appendWord(h, builder, 0x726f727265ULL, 5ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            return values.NIL
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- A runtime error a library call meets (a FAULT_ kind and the operands its
-- message names), raised as a library error.
export function raiseFault(ctx: voidptr, kind: uint64, culprit: uint64, other: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(services, native.fieldOffset<Services>("fault"), kind)
        native.store64(services, native.fieldOffset<Services>("culprit"), culprit)
        native.store64(services, native.fieldOffset<Services>("other"), other)
        local message = runtimeError(ctx)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        raiseLibrary(ctx, message)
    end
end

-- 1 when the function a frame runs owns affine values (its catalog record
-- lands errors).
local function lands(ctx: voidptr, frame: uint64): boolean
    @unsafe do
        local c = native.loadPointer(ctx, context.CATALOG)
        local owner = native.load64(native.pointer(frame), native.fieldOffset<frames.Frame>("functionId"))
        if owner >= native.load64(c, native.fieldOffset<catalog.Catalog>("count")) then
            return false
        end
        local fn = native.pointer(
            native.load64(c, native.fieldOffset<catalog.Catalog>("records")) + owner * native.sizeOf<catalog.Function>()
        )
        return native.load64(fn, native.fieldOffset<catalog.Function>("lands")) == 1ULL
    end
end

-- 1 when `frame`'s function owns affine values: an error lands at it.
export function ownsAffine(ctx: voidptr, frame: uint64): uint64
    if lands(ctx, frame) then
        return 1ULL
    end

    return 0ULL
end

-- The frame an error lands at: one that owns affine values and waits on the
-- call the error came from, if there is one before the nearest protected
-- call; 0 otherwise.
local function landingFrame(ctx: voidptr, state: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local closing = native.load64(services, native.fieldOffset<Services>("closing")) == 1ULL
        local at = native.load64(state, native.fieldOffset<frames.State>("active"))
        while at ~= 0ULL do
            if native.load64(
                native.pointer(at),
                native.fieldOffset<frames.Frame>("resultKind")
            ) == frames.PROTECTED_DESTINATION and not closing then
                return 0ULL
            end
            local parent = native.load64(native.pointer(at), native.fieldOffset<frames.Frame>("previous"))
            if parent ~= 0ULL and lands(ctx, parent) then
                return parent
            end
            at = parent
        end
        return 0ULL
    end
end

-- After a call in a function that owns affine values: false once, when an
-- error has landed there, else true.
export function takeLanded(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        if native.load64(services, native.fieldOffset<Services>("landed")) == 1ULL then
            native.store64(services, native.fieldOffset<Services>("landed"), 0ULL)
            return values.FALSE
        end
        return values.TRUE
    end
end

-- After a guest error stops the handlers: unwinds it to the nearest protected
-- call (frames.recover) and answers the pc to resume at, or 0 when the stop
-- was not a guest error (a refusal, budget or cancellation is not one) or no
-- protected call is on the stack. The error's value is what error() raised,
-- else a runtime error message.
export function recoverEntry(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local status = native.load64(ctx, context.STATUS)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        local raisedInScope = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error")) ~= 0ULL
        if not (status == context.GUEST_ERROR_STATUS or status == 0ULL and raisedInScope) then
            return 0ULL
        end
        -- A library leaf's raise is the scope's error, which every service
        -- call below would take for its own failure: hold it aside, and put it
        -- back when no protected call takes the error.
        local scopeError = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error"))
        local scopeOwner = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"))
        local scopeSite = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"))
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        local value = native.load64(services, native.fieldOffset<Services>("raised"))
        local level = native.load64(services, native.fieldOffset<Services>("raisedLevel"))
        if value == 0ULL then
            value = runtimeError(ctx)
            level = 1ULL
        end
        -- A failure the handlers recorded names its owner and pc; one a
        -- library leaf raised does not.
        if status == context.GUEST_ERROR_STATUS then
            value = positioned(
                ctx,
                value,
                level,
                native.load64(ctx, context.ERROR_OWNER),
                native.load64(ctx, context.ERROR_PC)
            )
        elseif native.load64(services, native.fieldOffset<Services>("libraryRaised")) == 1ULL then
            value = positioned(
                ctx,
                value,
                level,
                native.load64(services, native.fieldOffset<Services>("libraryOwner")),
                native.load64(services, native.fieldOffset<Services>("libraryPc"))
            )
        end
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("lastError"), value)
        local state = native.loadPointer(ctx, context.STATE)
        -- A frame that owns affine values and waits on a call nearer than any
        -- protected call takes the error first.
        local landing = landingFrame(ctx, state)
        local parent: uint64 = 0ULL
        if landing ~= 0ULL then
            parent = frames.land(state, landing)
            if parent ~= 0ULL then
                native.store64(services, native.fieldOffset<Services>("landed"), 1ULL)
            end
        elseif native.load64(services, native.fieldOffset<Services>("closing")) == 0ULL then
            parent = frames.recover(state, value)
        end
        if parent == 0ULL then
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), scopeError)
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), scopeOwner)
            native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), scopeSite)
            return 0ULL
        end
        native.store64(ctx, context.STATUS, 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        access.refresh(state, native.pointer(parent), ctx)
        return access.pc(state, native.pointer(parent))
    end
end

-- Whether an error is failing the entry that a recovery could take: what
-- recoverEntry recovers from.
export function failing(ctx: voidptr): uint64
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local status = native.load64(ctx, context.STATUS)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        local raisedInScope = native.load64(scope, native.fieldOffset<servicescope.ServiceScope>("error")) ~= 0ULL
        if status == context.GUEST_ERROR_STATUS or status == 0ULL and raisedInScope then
            return 1ULL
        end

        return 0ULL
    end
end

-- Nothing is failing any more: an error was given to a coroutine's resumer
-- (`threads`) rather than to a frame.
export function recovered(ctx: voidptr): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local scope = native.offset(services, native.fieldOffset<Services>("scope"))
        native.store64(ctx, context.STATUS, 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("error"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorOwner"), 0ULL)
        native.store64(scope, native.fieldOffset<servicescope.ServiceScope>("errorSite"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raised"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("fault"), 0ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
    end
end

-- Fails the entry with `value` raised again at `pc` in function `owner`, a
-- string getting that position: a wrapped coroutine's error, raised where
-- the wrapped function was called, as Lua 5.5 raises it.
export function reraise(ctx: voidptr, value: uint64, owner: uint64, pc: uint64): nil
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        native.store64(ctx, context.ERROR_OWNER, owner)
        native.store64(ctx, context.ERROR_PC, pc)
        native.store64(services, native.fieldOffset<Services>("raised"), value)
        native.store64(services, native.fieldOffset<Services>("raisedLevel"), 1ULL)
        native.store64(services, native.fieldOffset<Services>("libraryRaised"), 0ULL)
        native.store64(ctx, context.STATUS, context.GUEST_ERROR_STATUS)
    end
end
