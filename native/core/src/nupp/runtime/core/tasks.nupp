module nupp.runtime.core.tasks

-- The scheduler's primitives (Decision 18), under the scheduler written in
-- Nupp (`nupp.runtime.scheduler`, through `nupp.runtime.taskcalls`): one
-- library call whose first argument is a TASK_ operation. Running and
-- parking a task switch threads (`threads.resume` with MODE_DRIVE,
-- `threads.park`); the rest answer a value. Timers live in the scheduler;
-- what it waits with when nothing can run is TASK_SLEEP, the seam the
-- reactor's wait takes over once there are I/O sources.
const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const clock = require("nupp.runtime.core.hostclock")
const context = require("nupp.runtime.core.context")
const guestscope = require("nupp.runtime.core.guestscope")
const ints = require("nupp.runtime.core.coreintegers")
const threads = require("nupp.runtime.core.threads")
const librarylayouts = require("nupp.runtime.core.librarylayouts")

-- The call is librarycalls.TASKS; its operations, librarylayouts' TASK_ ones,
-- are numbered once in nupp.compiler.vm.corelibrary.

-- A million, as a float's bits: nanoseconds in a millisecond.
const MILLION: uint64 = 0x412e848000000000ULL

local function services(ctx: voidptr): voidptr
    return native.loadPointer(ctx, context.SERVICE_SCOPE)
end

-- The operations that switch threads, from `frame` at `pc`, their answer to
-- land in `slot`: SWITCHED when the context runs another thread, REFUSED
-- when the operation switches nothing (`answer` then gives its value),
-- RAISED or BROKEN as `threads.resume` answers them.
export function switching(
    ctx: voidptr,
    frame: voidptr,
    pc: voidptr,
    op: uint64,
    b: uint64,
    c: uint64,
    slot: uint64
): uint64
    if op == librarylayouts.TASK_RUN then
        -- What happened comes back as a pack.
        return threads.resume(ctx, frame, pc, b, c, threads.MODE_DRIVE, slot | (1ULL << 32ULL))
    elseif op == librarylayouts.TASK_PARK then
        return threads.park(ctx, frame, pc, slot)
    end

    return threads.REFUSED
end

-- The value of an operation that switched nothing.
export function answer(ctx: voidptr, op: uint64, b: uint64, c: uint64): uint64
    if op == librarylayouts.TASK_NEW then
        -- `c` is the pack of the arguments the body starts with.
        return threads.create(ctx, b, c, threads.FLAG_TASK)
    elseif op == librarylayouts.TASK_PARK then
        -- No task runs: the scheduler's caller waits itself.
        return values.FALSE
    elseif op == librarylayouts.TASK_CURRENT then
        local task = threads.currenttask(ctx)
        if task == 0ULL then
            return values.NIL
        end
        return task
    elseif op == librarylayouts.TASK_DATA then
        return threads.taskdata(b)
    elseif op == librarylayouts.TASK_SETDATA then
        threads.setdata(ctx, b, c)
        return values.NIL
    elseif op == librarylayouts.TASK_NOW then
        return native.bits(native.unsignedFloat(clock.monotonicNanos()) / native.fromBits(MILLION))
    elseif op == librarylayouts.TASK_SLEEP then
        local milliseconds = native.fromBits(b)
        if ints.isInteger(b) then
            milliseconds = native.fromBits(ints.toFloatBits(ints.bitsOf(b)))
        end
        if milliseconds > native.fromBits(0ULL) then
            local _ = clock.sleepNanos(native.unsignedInt(milliseconds * native.fromBits(MILLION)))
        end
        return values.NIL
    elseif op == librarylayouts.TASK_INSTALL then
        -- Kept where the collector reaches them.
        native.store64(services(ctx), native.fieldOffset<guestscope.Services>("threadmeta"), b)
        native.store64(services(ctx), native.fieldOffset<guestscope.Services>("closetask"), c)
        return values.NIL
    end

    return values.NIL
end

-- The scheduler's function closing a task, or 0 before it installs one.
export function closer(ctx: voidptr): uint64
    return native.load64(services(ctx), native.fieldOffset<guestscope.Services>("closetask"))
end
