module nupp.core.producer

local ROOT = assert(os.getenv("NUPP_COMPILER_ROOT"))
local CORE = ROOT .. "/src/nupp/runtime/vm/core.nupp"
local nativegraph = require("nupp.compiler.vm.nativegraph")
local lower = require("nupp.compiler.vm.lower")
local sink = require("nupp.compiler.s0.nativegraph")
local allocate = require("s0.allocate")
local allocationcheck = require("s0.allocationcheck")
local selector = require("s0.select")
local shim = require("nupp.core.shim")
local program = require("nupp.core.program")
local json = require("serde.json")
local front = require("nupp.core.source")
local checked, read = front.checked, front.read

export function compile(mode: string): string
    assert(mode == "normal" or mode == "spill", "invalid allocation mode")
    local functions, options = checked(read(CORE), CORE, "nupp.runtime.vm.core")
    local stopPath = ROOT .. "/native/core/src/nupp/runtime/core/entry.nupp"
    local stops, stopOptions = checked(read(stopPath), stopPath, "nupp.runtime.core.entry")
    local callsPath = ROOT .. "/native/core/src/nupp/runtime/core/calls.nupp"
    local _, callsOptions = checked(read(callsPath), callsPath, "nupp.runtime.core.calls")
    local contextPath = ROOT .. "/native/core/src/nupp/runtime/core/context.nupp"
    local _, contextOptions = checked(read(contextPath), contextPath, "nupp.runtime.core.context")
    options.modules["nupp.runtime.vm.calls"] = callsOptions.modules["nupp.runtime.core.calls"]
    options.modules["nupp.runtime.core.context"] = contextOptions.modules["nupp.runtime.core.context"]
    options.abi, stopOptions.abi = "handler", "leaf"
    local codes, metrics = {}, {}
    for index, name in ipairs(program.names) do
        local fn = stops[name] or functions[name]
        local g = lower.functionGraph(assert(fn), stops[name] and stopOptions or options, nativegraph)
        local artifact = sink.compilerGraph(g, name, fn, nil, contextOptions.modules["nupp.runtime.core.context"])
        local target = selector.target()
        if mode == "spill" then
            target.integerRegisters, target.floatRegisters = {}, {}
        end
        local allocation = allocate.run(artifact.machine, target)
        assert(allocationcheck.run(artifact.machine, target, allocation))
        codes[index] = selector.run(artifact.machine, allocation)
        local graphOps = 0
        for _, block in ipairs(g.blocks) do
            graphOps = graphOps + #block.op
        end
        metrics[
            index
        ] = {
            name = name,
            graphOps = graphOps,
            blocks = #g.blocks,
            edges = #artifact.machine.edgeTarget,
            machineOps = #artifact.machine.op,
            words = #codes[index].words,
            spillSlots = allocation.spillSlots,
            integerRegisters = #target.integerRegisters,
            floatRegisters = #target.floatRegisters
        }
    end
    local result = shim.build(codes)
    result.handlers, result.mode = metrics, mode

    return json.encodevalue(result)
end

export function data(path: string, slots: string, offsets: string, codeBytes: string): string
    local code = read(path)
    local handlers = {}
    for text in offsets:gmatch("[^,]+") do
        handlers[#handlers + 1] = assert(tonumber(text))
    end

    return program.data(code, assert(tonumber(slots)) as integer, handlers, assert(tonumber(codeBytes)) as integer)
end
