module nupp.core.guestbuild

-- Builds a guest program and the core that runs it. The program goes through
-- the checked front end, the program graph and the executable; the guest
-- runtime (handlers, entry, frames and what they call) goes through the
-- service catalog and the unit code cache. The core's own code is tested, not
-- proven (runtime plan, "Direction"): nothing here issues final-frame proofs.
local service = require("nupp.compiler.vm.nativeservice")
local runner = require("nupp.core.unitrunner")
local parser = require("nupp.compiler.syntax.parser")
local checker: any = require("nupp.compiler.check")
local environment: any = require("nupp.compiler.project.env")
local cst = require("nupp.compiler.syntax.cst")
local program = require("nupp.compiler.vm.programgraph")
local tagged = require("nupp.compiler.vm.taggedprofile")
local executable = require("nupp.compiler.vm.coregraphexecutable")
require("nupp.compiler.hostservices")
local build = {}

-- Each case's fixture and graph profile version.
local CASES: {[string]: {
    fixture: string,
    version: integer,
    modules: {string}?,
    -- Carries the library modules under `src/` the program requires, as
    -- far as they reach, beside the ones `modules` names.
    follow: boolean?,
    -- The fixture is written under build/core-guests/generated by the runner.
    generated: boolean?
}} = {
    boolean = {fixture = "catalog-boolean", version = 2},
    nilValue = {fixture = "catalog-nil", version = 2},
    live = {fixture = "catalog-live", version = 2},
    fresh = {fixture = "catalog-fresh", version = 2},
    nested = {fixture = "catalog-nested", version = 2},
    branchTrue = {fixture = "catalog-branch-true", version = 2},
    branchFalse = {fixture = "catalog-branch-false", version = 2},
    branchElseif = {fixture = "catalog-branch-elseif", version = 2},
    branchLive = {fixture = "catalog-branch-live", version = 2},
    modulePair = {fixture = "catalog-module-main", version = 2},
    moduleTriple = {fixture = "catalog-module-triple", version = 2},
    numberAdd = {fixture = "catalog-number-add", version = 3},
    numberNegativeZero = {fixture = "catalog-number-negative-zero", version = 3},
    numberNaN = {fixture = "catalog-number-nan", version = 3},
    numberBranch = {fixture = "catalog-number-branch", version = 4},
    numberLoop = {fixture = "catalog-number-loop", version = 5},
    numberLoopZero = {fixture = "catalog-number-loop-zero", version = 5},
    numericFor = {fixture = "catalog-numeric-for", version = 6},
    numericFloat = {fixture = "catalog-numeric-float", version = 6},
    numericModZero = {fixture = "catalog-numeric-modzero", version = 6},
    numericOverflow = {fixture = "catalog-numeric-overflow", version = 6},
    numericControl = {fixture = "catalog-numeric-control", version = 6},
    workloadLoops = {fixture = "catalog-workload-loops", version = 8},
    workloadFib = {fixture = "catalog-workload-fib", version = 8},
    callsNumeric = {fixture = "catalog-calls-numeric", version = 7},
    tablesBasic = {fixture = "catalog-tables-basic", version = 8},
    workloadClosures = {fixture = "catalog-workload-closures", version = 8},
    workloadTables = {fixture = "catalog-workload-tables", version = 8},
    workloadRecords = {fixture = "catalog-workload-records", version = 8},
    workloadStrings = {fixture = "catalog-workload-strings", version = 8},
    stringsBasic = {fixture = "catalog-strings-basic", version = 8},
    integersWide = {fixture = "catalog-integers-wide", version = 8},
    numbersText = {fixture = "catalog-numbers-text", version = 8},
    environmentRead = {fixture = "catalog-environment", version = 8},
    numbersFloat = {fixture = "catalog-numbers-float", version = 8},
    callsResults = {fixture = "catalog-calls-results", version = 8},
    tablesFloatKeys = {fixture = "catalog-tables-floatkeys", version = 8},
    stringsLibrary = {fixture = "catalog-strings-library", version = 8},
    callsGeneric = {fixture = "catalog-calls-generic", version = 8},
    callsVariadic = {fixture = "catalog-calls-variadic", version = 8},
    callsSpread = {fixture = "catalog-calls-spread", version = 8},
    recordsMethods = {fixture = "catalog-records-methods", version = 8},
    callsProtected = {fixture = "catalog-calls-protected", version = 8},
    recordsInline = {fixture = "catalog-records-inline", version = 8},
    errorsPositions = {fixture = "catalog-errors-positions", version = 8},
    tablesMeta = {fixture = "catalog-tables-meta", version = 8},
    errorsTexts = {fixture = "catalog-errors-texts", version = 8},
    callsXpcall = {fixture = "catalog-calls-xpcall", version = 8},
    tablesMetaops = {fixture = "catalog-tables-metaops", version = 8},
    tablesLibrary = {fixture = "catalog-tables-library", version = 8},
    stringsFormat = {fixture = "catalog-strings-format", version = 8},
    recordsConstructors = {fixture = "catalog-records-constructors", version = 8},
    numbersMath = {fixture = "catalog-numbers-math", version = 8},
    recordsAffine = {fixture = "catalog-records-affine", version = 8},
    recordsAffineErrors = {fixture = "catalog-records-affine-errors", version = 8},
    recordsaffineraise = {fixture = "catalog-records-affine-raise", version = 8},
    recordsdynamic = {fixture = "catalog-records-dynamic", version = 8},
    tablesSort = {fixture = "catalog-tables-sort", version = 8},
    stringsGsubFunction = {fixture = "catalog-strings-gsubfn", version = 8},
    stringsQuoted = {fixture = "catalog-strings-quoted", version = 8},
    outputPrint = {fixture = "catalog-output-print", version = 8},
    numbersPower = {fixture = "catalog-numbers-power", version = 8},
    libraryRanges = {fixture = "catalog-library-ranges", version = 8},
    numbersRandom = {fixture = "catalog-numbers-random", version = 8},
    errorsLibrary = {fixture = "catalog-errors-library", version = 8},
    callsAny = {fixture = "catalog-calls-any", version = 8},
    recordsMetamethods = {fixture = "catalog-records-metamethods", version = 8},
    callsPacks = {fixture = "catalog-calls-packs", version = 8},
    callsOpen = {fixture = "catalog-calls-open", version = 8},
    callsExpand = {fixture = "catalog-calls-expand", version = 8},
    errorsMethods = {fixture = "catalog-errors-methods", version = 8},
    recordsAffineReturns = {fixture = "catalog-records-affine-returns", version = 8},
    threadsbasic = {fixture = "catalog-threads-basic", version = 8},
    threadscalls = {fixture = "catalog-threads-calls", version = 8},
    threadsclose = {fixture = "catalog-threads-close", version = 8},
    threadsiterate = {fixture = "catalog-threads-iterate", version = 8},
    threadsmeta = {fixture = "catalog-threads-meta", version = 8},
    outputwrite = {fixture = "catalog-output-write", version = 8},
    libraryspread = {fixture = "catalog-library-spread", version = 8},
    tableslibrarymeta = {fixture = "catalog-tables-library-meta", version = 8},
    tableslibrarycalls = {fixture = "catalog-tables-library-calls", version = 8},
    tablesmetaarity = {fixture = "catalog-tables-meta-arity", version = 8},
    moduleslazy = {
        fixture = "catalog-modules-main",
        version = 8,
        modules = {"catalog-modules-shapes", "catalog-modules-counter"}
    },
    modulesnamed = {fixture = "catalog-modules-named", version = 8, modules = {"catalog-modules-geometry"}},
    modulespattern = {fixture = "catalog-modules-pattern", version = 8, modules = {"catalog-modules-geometry"}},
    modulesrecords = {fixture = "catalog-modules-records", version = 8, modules = {"catalog-modules-boxes"}},
    modulesqualified = {fixture = "catalog-modules-qualified", version = 8, modules = {"catalog-atlas-geometry"},},
    libraryvalues = {fixture = "catalog-library-values", version = 8},
    librarybasics = {fixture = "catalog-library-basics", version = 8, follow = true},
    cleanupfunctions = {fixture = "catalog-cleanup-functions", version = 8, follow = true},
    serdejson = {fixture = "catalog-serde-json", version = 8, follow = true},
    functionsmany = {fixture = "functionsmany", version = 8, generated = true},
    coreoperators = {fixture = "catalog-core-operators", version = 8},
    methodcleanups = {fixture = "catalog-method-cleanups", version = 8, follow = true},
    ownerreinit = {fixture = "catalog-owner-reinit", version = 8, follow = true},
    coreforms = {fixture = "catalog-core-forms", version = 8, follow = true},
    storagebasics = {fixture = "catalog-storage-basics", version = 8},
    storageprovider = {fixture = "catalog-storage-provider", version = 8, follow = true},
    stringbuffer = {
        fixture = "catalog-string-buffer",
        version = 8,
        modules = {"src/nupp/runtime/provider/tablebuffer"},
    },
    textbuffer = {fixture = "catalog-text-buffer", version = 8, modules = {"src/nupp/runtime/provider/tablebuffer"},},
    modulesdynamic = {fixture = "catalog-modules-dynamic", version = 8, modules = {"catalog-modules-geometry"},},
    modulescycle = {
        fixture = "catalog-modules-cycle",
        version = 8,
        modules = {"catalog-modules-ping", "catalog-modules-pong"},
    },
    callsoverflow = {fixture = "catalog-calls-overflow", version = 8},
    tablesfrozen = {fixture = "catalog-tables-frozen", version = 8}
}

-- The handlers a profile version dispatches, in table order.
local function handlerNames(caseName: string, version: integer): {string}
    local names = {"K", "Nil", "Move", "NewClosure", "CallK", "Ret", "Jmp", "JmpIf", "Invalid"}
    if caseName == "modulePair" or version >= 8 then
        table.insert(names, 2, "Require")
    end
    local introduced: {
        [string]: integer
    } = {
        Add = 3,
        Lt = 4,
        Sub = 6,
        Mul = 6,
        Mod = 6,
        Le = 6,
        Eq = 6,
        NewCell = 7,
        GetCell = 7,
        SetCell = 7,
        GetUpval = 7,
        NewTable = 8,
        GetIdx = 8,
        SetIdx = 8,
        Len = 8,
        MathFloor = 8,
        LibCall = 8,
        Not = 8,
        RetN = 8,
        CallV = 8,
        RetV = 8,
        PCall = 8,
        XPHandle = 8,
        Destroy = 8
    }
    for _, name in ipairs({
        "Add",
        "Lt",
        "Sub",
        "Mul",
        "Mod",
        "Le",
        "Eq",
        "NewCell",
        "GetCell",
        "SetCell",
        "GetUpval",
        "NewTable",
        "GetIdx",
        "SetIdx",
        "Len",
        "MathFloor",
        "LibCall",
        "Not",
        "RetN",
        "CallV",
        "RetV",
        "PCall",
        "XPHandle",
        "Destroy"
    }) do
        if version >= introduced[name] then
            table.insert(names, 2, name)
        end
    end

    return names
end

local function read(path: string): string
    local file = assert(io.open(path, "rb"), "guest build: missing source " .. path)
    local text = file:read("*a")
    file:close()

    return text
end

-- The runtime modules a guest links, beyond the service catalog's own.
local RUNTIME = {
    "arena",
    "frames",
    "context",
    "frameaccess",
    "instances",
    "guestcatalog",
    "guestentry",
    "guestops",
    "guesthandlers",
    "guestscope",
    "coretables"
}

-- One runtime build and selection per mode for the process: every case
-- shares them, and only the program differs. Audited builds add the test-only
-- lifecycle audit leaves, which primary programs must not link.
local runtimes: {[string]: any} = {}
local sessions: {[string]: any} = {}

local function runtime(mode: string, cacheDirectory: string?, audited: boolean): any
    local kind = audited and "audited" or "primary"
    local held = runtimes[kind .. ":" .. mode]
    if held then
        return held
    end
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local fixtures = {}
    for _, name in ipairs(RUNTIME) do
        fixtures[
            #fixtures + 1
        ] = {
            moduleName = "nupp.runtime.core." .. name,
            path = root .. "/native/core/src/nupp/runtime/core/" .. name .. ".nupp"
        }
    end
    -- Every handler is built, so one selection serves every profile version.
    local all = handlerNames("modulePair", 8)
    local roots, handlers = {}, {}
    for _, name in ipairs(all) do
        roots[#roots + 1] = {"nupp.runtime.core.guesthandlers", name}
        handlers["nupp.runtime.core.guesthandlers." .. name] = true
    end
    roots[#roots + 1] = {"nupp.runtime.core.guestentry", "start"}
    roots[#roots + 1] = {"nupp.runtime.core.guestentry", "complete"}
    for _, name in ipairs({"prepare", "open", "close", "finish"}) do
        roots[#roots + 1] = {"nupp.runtime.core.guestscope", name}
    end
    roots[#roots + 1] = {"nupp.runtime.core.threads", "recover"}
    if audited then
        fixtures[
            #fixtures + 1
        ] = {
            moduleName = "nupp.runtime.core.guestaudit",
            path = root .. "/build/core-guest-audit/source/nupp/runtime/core/guestaudit.nupp",
            include = "build/core-guest-audit/source"
        }
        for _, name in ipairs({"after", "failedPrefix", "stale", "failedStart"}) do
            roots[#roots + 1] = {"nupp.runtime.core.guestaudit", name}
        end
    end
    local began = os.time()
    -- The checked session and catalog serve both modes.
    sessions[kind] = sessions[kind] or service.buildUnits(fixtures, roots, handlers)
    local units = sessions[kind]
    io.stderr:write(("guest runtime session %ds\n"):format(os.time() - began))
    local timings = {}
    local started = os.clock()
    local chosen = runner.select(
        units,
        mode,
        cacheDirectory,
        handlers,
        function(name: string): nil
            timings[#timings + 1] = {name = name, seconds = os.clock() - started}
            io.stderr:write(("guest runtime %s %ds\n"):format(name, os.time() - began))
        end,
        units.session.module("nupp.runtime.core.context")
    )
    local scopes = {}
    for _, name in ipairs(RUNTIME) do
        scopes["nupp.runtime.core." .. name] = units.session.module("nupp.runtime.core." .. name)
    end
    scopes["nupp.runtime.vm.values"] = units.session.module("nupp.runtime.vm.values")
    if audited then
        scopes["nupp.runtime.core.guestaudit"] = units.session.module("nupp.runtime.core.guestaudit")
    end
    local names, metrics = {}, {}
    for name in pairs(chosen.codes) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        local code = chosen.codes[name]
        metrics[
            #metrics + 1
        ] = {
            name = name,
            frameBytes = code.frameBytes,
            spillSlots = code.allocation.spillSlots,
            integerRegisters = code.allocation.integerRegisters,
            floatRegisters = code.allocation.floatRegisters,
            calls = #code.fixupName
        }
    end
    held = {codes = chosen.codes, owners = chosen.owners, scopes = scopes, timings = timings, metrics = metrics}
    runtimes[kind .. ":" .. mode] = held

    return held
end

-- A case names its modules as fixtures (`native/core/tests`), absolute
-- paths, or library modules under `src/`, which it carries as they are.
local function libraryModule(name: string): boolean
    return name:sub(1, 4) == "src/" or name:find("/src/", 1, true) ~= nil
end

-- The library module under `src/` that module `name` loads from on the
-- core, or nil when none does: a declaration file, or a host module the
-- core does not answer.
local function librarypath(root: string, name: string): string?
    local graph: any = require("nupp.compiler.vm.graph")
    local relative = (graph.coremodule(name) as string):gsub("%.", "/")
    for _, candidate in ipairs({"src/" .. relative, "src/" .. relative .. "/init"}) do
        local file = io.open(root .. "/" .. candidate .. ".nupp", "rb")
        if file then
            file:close()
            return candidate
        end
    end
    -- A plain Lua module, vendored: named with its extension.
    for _, candidate in ipairs({"src/" .. relative .. ".lua", "src/" .. relative .. "/init.lua"}) do
        local file = io.open(root .. "/" .. candidate, "rb")
        if file then
            file:close()
            return candidate
        end
    end

    return nil
end

-- The modules a checked tree loads: its requires, its qualified paths, and
-- the names its source says it requires dynamically.
local function requiredmodules(root: any, source: string): {string}
    local found: {string} = {}
    local walk: function(any): nil
    walk = function(node: any): nil
        if type(node) ~= "table" then
            return
        end
        if node.kind == "call"
            and node.runtimeLoader == "require"
            and type(node.requiredModule) == "string"
            and not node.typeOnlyRequire
        then
            found[#found + 1] = node.requiredModule
        end
        -- A library call the core makes itself (`assert(v)`) loads nothing,
        -- whatever module its name is checked through.
        local graph: any = require("nupp.compiler.vm.graph")
        if node.kind == "call" and graph.coreLibraryCall(node) ~= nil then
            for _, argument in ipairs(node.args and node.args.exprs or {}) do
                walk(argument)
            end
            return
        end
        -- A qualified path loads its module only where it is a value; one
        -- naming a type (`io.Writer`) loads nothing, as the graph sees it.
        if node.kind == "dotIndex" and type(node.qualifiedModule) == "string" then
            found[#found + 1] = node.qualifiedModule
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(root)
    for list in source:gmatch("@requires%-dynamically ([%w%._, ]+)") do
        for name in list:gmatch("[%w%._]+") do
            found[#found + 1] = name
        end
    end

    return found
end

local function modulePath(root: string, name: string): string
    if name:sub(-4) == ".lua" then
        return root .. "/" .. name
    end
    if name:sub(1, 1) == "/" then
        return name .. ".nupp"
    elseif name:sub(1, 4) == "src/" then
        return root .. "/" .. name .. ".nupp"
    end

    return root .. "/native/core/tests/" .. name .. ".nupp"
end

-- The checked program for a case, compiled to the core executable.
local function compileProgram(caseName: string, fixture: string, version: integer): any
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local names = caseName == "modulePair" and {"catalog-module-prefix", fixture}
        or caseName == "moduleTriple" and {"catalog-module-prefix", "catalog-module-middle", fixture}
        or {fixture}
    -- A case's other modules come first, so the modules it requires precede it.
    local declared = CASES[caseName]
    local others = declared and declared.modules
    if others then
        names = {}
        for _, name in ipairs(others) do
            names[#names + 1] = name
        end
        names[#names + 1] = fixture
    end
    -- A program that takes a library function as a value carries the
    -- functions that make those calls, before its entry.
    if version >= 8 then
        local graph: any = require("nupp.compiler.vm.graph")
        local takes = false
        for _, name in ipairs(names) do
            local path = modulePath(root, name)
            takes = takes or graph.mayTakeLibraryValue(parser.parse(read(path), path).root)
        end
        if takes then
            table.insert(names, #names, root .. "/src/nupp/runtime/libraryvalues")
        end
    end
    local staged = root .. "/build/core-guest-programs/source"
    local project: any = nil
    if #names > 1 or declared ~= nil and declared.follow == true then
        local incremental: any = require("nupp.compiler.project.incremental")
        require("nupp.compiler.project.projectconfig")
        require("nupp.compiler.hash")
        project = incremental.new(root, {
            cache = false,
            nativeCompilerServices = false,
            -- Its output is not the build directory the staged sources sit
            -- in, which the project index would leave out, and a qualified
            -- path resolves only modules the index declares.
            config = {
                include = {"src", "build/core-guest-programs/source"},
                build = {outDir = "build/core-guest-programs/out"},
            }
        })
    end
    local modules = {}
    local moduleName = ""
    local follow = declared ~= nil and declared.follow == true
    local carried: {[string]: boolean} = {}
    for _, name in ipairs(names) do
        carried[name] = true
    end
    local entry: any = nil
    local queue: {string} = {}
    for _, name in ipairs(names) do
        queue[#queue + 1] = name
    end
    local at: integer = 1
    while at <= #queue do
        local name = queue[at]
        at = at + 1
        local path = modulePath(root, name)
        local source = read(path)
        local parsed = parser.parse(source, path)
        assert(#parsed.errors == 0, "guest source parse failed: " .. name)
        -- A library module may be named by its path alone.
        local named = cst.declaredModule(parsed.root)
        if named == nil and libraryModule(name) then
            named = (name:match("src/(.*)$") as string):gsub("%.lua$", ""):gsub("/init$", ""):gsub("/", ".")
        end
        local declared = assert(named, "guest module declaration required: " .. name)
        local diagnostics
        if project then
            -- A fixture is checked as its staged copy; a library module
            -- the program carries, where it lives.
            if not libraryModule(name) then
                path = staged .. "/" .. declared:gsub("%.", "/") .. ".nupp"
                assert(read(path) == source, "staged guest source differs: " .. name)
            end
            local checked = project.checkFile(path)
            parsed, diagnostics = assert(checked.result, "checked guest result required"), checked.diags
        else
            local env = environment.new(root, {memoryOnly = true, cache = false, nativeCompilerServices = false})
            diagnostics = checker.check(parsed, path, env, {
                moduleName = declared,
                strict = false,
                lints = {["unused-binding"] = "off"}
            })
        end
        for _, diagnostic in ipairs(diagnostics) do
            assert(diagnostic.severity ~= "error", diagnostic.msg)
        end
        -- A plain Lua module is named by its path, as `require` finds it.
        local named: any = parsed
        if named.moduleName == nil and name:sub(-4) == ".lua" then
            named.moduleName = declared
        end
        local module = {name = declared, path = path, parsed = parsed, diagnostics = diagnostics}
        if name == fixture then
            entry = module
        else
            modules[#modules + 1] = module
        end
        if follow then
            for _, required in ipairs(requiredmodules(parsed.root or parsed, source)) do
                local library = librarypath(root, required)
                if library and not carried[library] then
                    carried[library] = true
                    queue[#queue + 1] = library
                end
            end
            -- What it carries may take a library function as a value.
            local values = root .. "/src/nupp/runtime/libraryvalues"
            local graph: any = require("nupp.compiler.vm.graph")
            if not carried[values]
                and not carried["src/nupp/runtime/libraryvalues"]
                and graph.mayTakeLibraryValue(parser.parse(source, path).root)
            then
                carried[values] = true
                queue[#queue + 1] = values
            end
        end
    end
    -- The entry is last, after the modules it requires.
    modules[#modules + 1] = assert(entry, "guest entry module missing")
    moduleName = entry.name
    local catalog = program.describe(modules, moduleName)

    return executable.fromChecked(
        program.compile(catalog, version >= 5 and tagged.forVersion(version) or tagged),
        version
    )
end

-- The graph profile version a named case compiles at; generated oracle
-- programs are v8.
function build.version(caseName: string): integer
    local case = CASES[caseName]
    if case == nil and caseName:match("^generated%d+$") then
        return 8
    end

    return assert(case, "unknown guest case: " .. caseName).version
end

-- A guest build in the shape guestshim takes: the program executable, the
-- runtime's selected code by qualified name, and the scopes whose layouts
-- the shim and artifact writer read.
function build.guest(caseName: string, mode: string, cacheDirectory: string?, audited: boolean?): any
    -- Generated oracle programs (tests/guests/oracle.lua) live under build.
    local case = CASES[caseName]
    if case == nil and caseName:match("^generated%d+$") then
        case = {
            fixture = assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/build/core-guests/generated/" .. caseName,
            version = 8
        }
    end
    if case ~= nil and case.generated == true then
        case = {
            fixture = assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/build/core-guests/generated/" .. case.fixture,
            version = case.version
        }
    end
    case = assert(case, "unknown guest case: " .. caseName)
    local held = runtime(mode, cacheDirectory, audited == true)
    local program = compileProgram(caseName, case.fixture, case.version)
    local resolved = {}
    for name, owner in pairs(held.owners) do
        resolved[name] = {owner = owner}
    end

    return {
        resolved = resolved,
        selected = held.codes,
        scopes = held.scopes,
        executable = program,
        handlers = handlerNames(caseName, case.version),
        caseName = caseName,
        audited = audited == true,
        refusals = {},
        timings = held.timings,
        metrics = held.metrics
    }
end

export = build
