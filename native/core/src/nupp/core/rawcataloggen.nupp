module nupp.core.rawcataloggen

local schema = require("nupp.compiler.vm.coregraphschema")

export function source(): string
    local semantic, wire = schema.describe(), schema.wire()
    local lines = {
        "module nupp.runtime.core.rawcatalogpolicy",
        "",
        "-- Generated by nupp.core.rawcataloggen from the canonical schema.",
        "-- Catalog metadata only; no executable operation implementation.",
        ""
    }

    local function constant(name: string, value: integer): nil
        lines[#lines + 1] = "export const " .. name .. " = " .. tostring(value) .. "ULL"
    end

    for _, name in ipairs({"owners", "signatures", "modules", "calls", "blocks", "values", "items"}) do
        constant(name, semantic.limits[name])
    end
    for _, section in ipairs(wire.sections) do
        if section.name == "signatures" then
            for _, field in ipairs(section.fields) do
                if field.name == "paramsFirst" then
                    constant("parameters", field.role.limit)
                end
            end
        end
    end
    for _, group in ipairs({
        {prefix = "Owner_", rows = wire.ownerKinds},
        {prefix = "Signature_", rows = wire.signatureKinds},
        {prefix = "Term_", rows = semantic.terms},
        {prefix = "Operation_", rows = semantic.operations}
    }) do
        for _, row in ipairs(group.rows) do
            constant(group.prefix .. row.name, row.id)
        end
    end
    constant("scalarKinds", #semantic.scalarKinds)
    assert(
        #semantic.effects == 2
        and semantic.effects[1].id == 0
        and semantic.effects[1].pure
        and not semantic.effects[1].mayCollect
        and not semantic.effects[1].mayRaise
        and not semantic.effects[1].mayPark
    )
    assert(
        semantic.effects[2].id == 1
        and not semantic.effects[2].pure
        and semantic.effects[2].mayCollect
        and semantic.effects[2].mayRaise
        and not semantic.effects[2].mayPark
    )
    constant("pureEffect", semantic.effects[1].id)
    constant("invokeEffect", semantic.effects[2].id)
    for _, group in ipairs({
        {name = "operation", rows = semantic.operations},
        {name = "term", rows = semantic.terms}
    }) do
        assert(#group.rows > 0 and #group.rows <= 5, "catalog metadata word capacity")
        local parts = {}
        for index = math.min(#group.rows, 4), 1, -1 do
            local row = group.rows[index]
            local arity = group.name == "operation" and #row.args or row.edges
            assert(row.id == index - 1 and arity >= 0 and arity < 256 and arity % 1 == 0)
            assert(row.effect >= 0 and row.effect < 256 and row.effect % 1 == 0)
            parts[#parts + 1] = string.format("%04x", arity * 256 + row.effect)
        end
        lines[#lines + 1] = ""
        lines[#lines + 1] = "export function " .. group.name .. "(id: uint64): uint64"
        lines[#lines + 1] = "    if id >= " .. tostring(#group.rows) .. "ULL then"
        lines[#lines + 1] = "        return 4294967295ULL"
        lines[#lines + 1] = "    end"
        if #group.rows == 5 then
            local row = group.rows[5]
            local arity = group.name == "operation" and #row.args or row.edges
            assert(row.id == 4 and arity >= 0 and arity < 256 and row.effect >= 0 and row.effect < 256)
            lines[#lines + 1] = "    if id == 4ULL then"
            lines[#lines + 1] = "        return " .. tostring(arity * 256 + row.effect) .. "ULL"
            lines[#lines + 1] = "    end"
            lines[#lines + 1] = ""
        end
        lines[#lines + 1] = "    return (0x" .. table.concat(parts) .. "ULL >> (id * 16ULL)) & 65535ULL"
        lines[#lines + 1] = "end"
    end

    return table.concat(lines, "\n") .. "\n"
end
