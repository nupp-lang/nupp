module nupp.core.kernelcompiler

-- The compiler part of every runtime kernel's key (`nupp.core.unitrunner`):
-- everything that shapes selected code besides a function's own modules.
--
-- That is every compiler source, the checker's included, the declarations
-- and backend sources the selection reads, and every module it reaches by a
-- literal require from the unit runner -- except the guest program's own
-- lowering: the modules under `nupp.compiler.vm` the guest builder reaches and
-- the unit runner does not (the tagged profile, the core executable). An edit
-- there reuses every kernel; an edit to any other input invalidates them all.
-- The units harness holds a kernel selection to never loading one of them.
local fingerprint = require("nupp.compiler.project.fingerprint")

-- Cache keys use the build's content digest, which the CLI answers natively:
-- SHA-256 in Nupp ran at about 75 KB/s here, and hashing the lowering's 2 MB
-- of sources took most of every cached selection.
local contentDigest = fingerprint.contentDigest(true)

-- Bumped when what the digest covers changes.
const FORMAT = "kernel-compiler/2"
-- The module the selection starts from: whatever it reaches is an input.
const ROOT_MODULE = "nupp.core.unitrunner"
-- The module the guest program's build starts from, and where the lowering
-- that only it reaches lives.
const GUEST_MODULE = "nupp.core.guestbuild"
const GUEST_LOWERING = "src/nupp/compiler/vm/"
-- Where the units project (native/core/tests/units/nupp.lua) resolves modules
-- from, relative to the checkout root, in its order.
const SEARCH = {
    "native/core/tests/units",
    "tests/fixtures/nativeheap",
    "src",
    "native/core/src",
    "native/crates/vm/lib",
    "native/crates/vm/decls"
}
const SUFFIXES = {".nupp", ".d.nupp", "/init.nupp", ".lua", "/init.lua"}
-- What the selection reads besides what it requires: every compiler source,
-- the owned backend (nupp.compiler.s0) whole among them, the VM's
-- declarations, and the units project's configuration.
const READ = "find src/nupp/compiler -name '*.nupp'; ls src/nupp/runtime/vm/*.d.nupp native/core/tests/units/nupp.lua"

local function readFile(path: string): string?
    local file = io.open(path, "rb")
    if not file then
        return nil
    end
    local text = file:read("*a")
    file:close()

    return text
end

local function writeFile(path: string, text: string): nil
    local file = assert(io.open(path, "wb"))
    file:write(text)
    file:close()
end

-- The file module `name` resolves to under `root`, relative to it, or nil.
local function resolve(root: string, name: string): string?
    local relative = name:gsub("%.", "/")
    for _, base in ipairs(SEARCH) do
        for _, suffix in ipairs(SUFFIXES) do
            local path = base .. "/" .. relative .. suffix
            if readFile(root .. "/" .. path) ~= nil then
                return path
            end
        end
    end

    return nil
end

-- The modules a source names: its requires with a literal name, however
-- spaced, and its declared dynamic requires.
local function named(source: string): {string}
    local names = {}
    for name in source:gmatch("require%s*%(?%s*[\"']([%w_%.]+)[\"']") do
        names[#names + 1] = name
    end
    for name in source:gmatch("@requires%-dynamically%s+([%w_%.]+)") do
        names[#names + 1] = name
    end

    return names
end

-- The files of the modules `roots` reach by literal requires under `root`,
-- by path; a name no file answers (a host module) as `?name`.
local function reached(root: string, roots: {string}): {[string]: boolean}
    local seen: {[string]: boolean} = {}
    local files: {[string]: boolean} = {}
    local pending: {string} = {}
    for _, name in ipairs(roots) do
        pending[#pending + 1] = name
    end
    while #pending > 0 do
        local name = table.remove(pending) as string
        if not seen[name] then
            seen[name] = true
            local path = resolve(root, name)
            if path == nil then
                files["?" .. name] = true
            else
                files[path] = true
                for _, required in ipairs(named(readFile(root .. "/" .. path) or "")) do
                    pending[#pending + 1] = required
                end
            end
        end
    end

    return files
end

-- The names in `set`, sorted.
export function sorted(set: {[string]: boolean}): {string}
    local result: {string} = {}
    for path in pairs(set) do
        result[#result + 1] = path
    end
    table.sort(result)

    return result
end

-- The files the modules `roots` reach by literal requires under `root`, sorted;
-- a name no file answers as `?name`.
export function reachedFiles(root: string, roots: {string}): {string}
    return sorted(reached(root, roots))
end

-- The guest program's own lowering under `root`, sorted: what the kernel key
-- leaves out.
export function excluded(root: string): {string}
    local kernel = reached(root, {ROOT_MODULE})
    local result: {[string]: boolean} = {}
    for path in pairs(reached(root, {GUEST_MODULE})) do
        if path:sub(1, #GUEST_LOWERING) == GUEST_LOWERING and not kernel[path] then
            result[path] = true
        end
    end

    return sorted(result)
end

-- Every input of the kernels' compiler part under `root`, sorted.
export function inputs(root: string): {string}
    local files = reached(root, {ROOT_MODULE})
    local listing = assert(io.popen("cd '" .. root .. "' && { " .. READ .. "; } 2>/dev/null"))
    for path in listing:lines() do
        files[path:gsub("^%./", "")] = true
    end
    listing:close()
    for _, path in ipairs(excluded(root)) do
        files[path] = nil
    end

    return sorted(files)
end

-- The digest of `files` under `root` as `read` answers them (the file system
-- unless a caller gives its own).
export function digestOf(root: string, files: {string}, read: (function(string): string?)?): string
    local reader = read or readFile
    local parts = {FORMAT}
    for _, path in ipairs(files) do
        local bytes = ""
        if path:sub(1, 1) ~= "?" then
            bytes = reader(root .. "/" .. path) or ""
        end
        parts[#parts + 1] = path .. "\0" .. bytes
    end

    return contentDigest(table.concat(parts, "\0"))
end

-- The compiler generation doing the lowering: the one NUPP_VM_CLI_IMAGE names,
-- else the checkout's selected one. Sources alone do not name it: a run on a
-- generation older than its sources would keep code under their key.
local function generation(root: string): string
    local named = (os.getenv("NUPP_VM_CLI_IMAGE") or ""):match("/(%x+)/compiler%.image$")

    return named or (readFile(root .. "/.nupp/vm-cli/current") or ""):gsub("%s+$", "")
end

-- The digest of every input. Any edit to one invalidates all kernels.
export function digest(root: string): string
    return digestOf(root, inputs(root))
end

-- The inner loop may pin the compiler part of every key: NUPP_UNIT_COMPILER_PIN
-- names a file holding it, written on first use. A lowering edit then reuses
-- the code the previous compiler selected, and a handler edit still misses by
-- its own module. Batch gates and milestones leave it unset, so every key there
-- follows the compiler exactly: its sources and the generation running them.
export function keyed(root: string): string
    local pin = os.getenv("NUPP_UNIT_COMPILER_PIN")
    if pin == nil or pin == "" then
        return contentDigest(digest(root) .. "\0" .. generation(root))
    end
    local held = readFile(pin)
    if held ~= nil and held ~= "" then
        return held
    end
    local computed = digest(root)
    writeFile(pin, computed)

    return computed
end
