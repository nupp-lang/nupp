module nupp.core.guestshim

local arm = require("s0.arm64")
local linker = require("nupp.core.link")
local contract = require("nupp.compiler.vm.nativeframecontract")
local sink = require("nupp.compiler.s0.nativegraph")
local targetLayout = require("nupp.compiler.targetlayout")
local opcodes = require("nupp.compiler.vm.opcodes")
local context = require("nupp.runtime.core.context")
local shim = {}

local function align(value: integer): integer
    return (value + 15) & -16
end

-- Only transport is assembled here. All entry/call/return/cleanup policy is
-- ordinary selected Nupp from the same privately retained checked source unit.
-- The bridge supplies fresh mappings. A nonfresh Context refuses before this
-- entry writes it; retained World and consumed Storage are never reset.
function shim.build(source: any, selected: {[string]: any}, capacity: integer?): any
    contract.validateGuest(source)
    local scratchBytes = capacity or 65536
    assert(scratchBytes == 65536 or scratchBytes == 131072, "explicit guest scratch capacity")
    local layouts = {}
    for _, request in ipairs({
        {"Binding", "guestentry"},
        {"Storage", "guestentry"},
        {"Catalog", "guestcatalog"},
        {"Descriptor", "guestcatalog"},
        {"World", "instances"},
        {"Instance", "instances"},
        {"Frame", "frames"},
        {"FunctionInfo", "frames"},
        {"WindowPlan", "frames"},
        {"RootControl", "frames"},
        {"Mark", "arena"}
    }) do
        local scope = source.scopes["nupp.runtime.core." .. request[2]]
        layouts[
            request[1]
        ] = assert(targetLayout.of(assert(scope.checkedExports.types[request[1]]), "aarch64-apple-darwin"))
    end
    local binding = layouts.Binding
    local stride = binding.offsets.context - binding.offsets.data
    local width = binding.fields[1].size
    assert(width == 8 and stride == width * 2 and binding.offsets.data == 0, "Binding pair representation")
    assert(binding.offsets.dataBytes == width and binding.size == stride * 7, "Binding complete pair extent")
    for index, name in ipairs({"data", "context", "world", "storage", "pool", "helper", "code"}) do
        assert(binding.offsets[name] == (index - 1) * stride, "Binding base stride")
        assert(binding.offsets[name .. "Bytes"] == (index - 1) * stride + width, "Binding extent stride")
    end
    for _, field in ipairs(binding.fields) do
        assert(field.size == width and not field.bitWidth, "Binding word field")
    end
    local executable = source.executable
    local catalogOffset = align(layouts.Storage.size)
    local catalogBytes = layouts.Catalog.size + #executable.functions * (
        layouts.FunctionInfo.size + layouts.WindowPlan.size
    )
    local storageBytes = align(
        (catalogOffset + catalogBytes) as integer
    ) + (executable.instanceCapacity as integer) * layouts.Instance.size
    local maximumFrame = 0
    for _, fn in ipairs(executable.functions) do
        maximumFrame = math.max(
            maximumFrame,
            align((align(layouts.Frame.size) + (fn.valueCount as integer) * 8) as integer)
        )
    end
    local poolBytes = (executable.frameDepth as integer) * maximumFrame
    assert(poolBytes > 0 and poolBytes <= 1048576, "guest logical pool bound")
    local worldOffset = align(context.SIZE)
    local bindingOffset = align((worldOffset + layouts.World.size) as integer)
    local storageOffset = align((bindingOffset + layouts.Binding.size) as integer)
    local dispatchOffset = align((storageOffset + storageBytes) as integer)
    local poolOffset = align(dispatchOffset + 256 * 8)
    local spillOffset = align((poolOffset + poolBytes) as integer)
    assert(spillOffset < scratchBytes, "guest entry metadata/pool exceeds scratch")
    local roots, functions, rootNames = {}, {}, {}
    for _, name in ipairs(source.handlers) do
        rootNames[#rootNames + 1] = "nupp.runtime.core.guesthandlers." .. name
    end
    local startIndex, completeIndex = #rootNames + 1, #rootNames + 2
    rootNames[
        startIndex
    ], rootNames[completeIndex] = "nupp.runtime.core.guestentry.start", "nupp.runtime.core.guestentry.complete"
    local rootSet = {}
    for index, name in ipairs(rootNames) do
        local code, item = assert(selected[name]), assert(source.resolved[name])
        sink.verifyCodeOrigin(code, item.graph, item.owner)
        roots[index], rootSet[name] = code, true
    end
    local count = 0
    for name, item in pairs(source.resolved) do
        local code = assert(selected[name], "guest selection missing")
        sink.verifyCodeOrigin(code, item.graph, item.owner)
        -- The separately issued audit unit retains these leaves for its later
        -- test wrapper. They call start/complete, which are roots here; keeping
        -- them out also keeps primary guest code independent of audit bodies.
        local auditScope = source.audited and source.scopes["nupp.runtime.core.guestaudit"]
        if not rootSet[name] and item.owner.scope ~= auditScope then
            functions[name] = code
        end
        count += 1
    end
    local found = 0
    for name in pairs(selected) do
        assert(source.resolved[name], "extra guest selection");
        found += 1
    end
    assert(found == count, "guest selected inventory")
    local extent = linker.assembleAuthenticated({}, roots, functions, scratchBytes - spillOffset).callBytes
    assert(extent > 0 and extent % 16 == 0)
    local words: {integer} = {}
    local refusals: {{
        at: integer,
        condition: integer
    }} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function immediate(reg: integer, value: integer): nil
        assert(value >= 0 and value < 4294967296)
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(dst: integer, base: integer, bytes: integer): nil
        assert(bytes >= 0 and bytes < 16777216)
        local high, low = bytes >> 12, bytes & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, dst, base, high, 1));
            base = dst
        end
        emit(arm.add_imm(64, dst, base, low, 0))
    end

    local function refuse(condition: integer): nil
        refusals[#refusals + 1] = {at = #words + 1, condition = condition}
        emit(arm.b_cond(condition, 0))
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160));
    emit(arm.str(8, 0, 31, 168))
    for _, check in ipairs({
        {0, 1, 1},
        {48, scratchBytes, 3},
        {88, 1, 3},
        {32, layouts.Descriptor.size, 3},
        {80, 2, 8}
    }) do
        emit(arm.ldr(8, 16, 0, check[1]));
        immediate(17, check[2]);
        emit(arm.cmp_reg(64, 16, 17));
        refuse(check[3])
    end
    emit(arm.ldr(8, 19, 0, 40));
    emit(arm.ldr(8, 22, 0, 56))
    for at = 0, context.SIZE - 8, 8 do
        emit(arm.ldr(8, 16, 19, at));
        emit(arm.cmp_imm(64, 16, 0, 0));
        refuse(1)
    end
    offset(21, 19, dispatchOffset);
    offset(23, 19, spillOffset)
    emit(arm.str(8, 21, 19, context.DISPATCH_TABLE))
    emit(arm.str(8, 31, 19, context.CANCELLED));
    emit(arm.str(8, 31, 19, context.STATUS))
    emit(arm.str(8, 31, 19, context.ERROR_PC));
    emit(arm.movn(64, 17, 0, 0));
    emit(arm.str(8, 17, 19, context.REMAINING))
    emit(arm.ldr(8, 16, 0, 80))
    local noBudget = #words + 1;
    emit(arm.cbz(64, 16, 0))
    emit(arm.ldr(8, 17, 0, 72));
    emit(arm.ldr(8, 17, 17, 0));
    emit(arm.str(8, 17, 19, context.REMAINING))
    words[noBudget] = arm.cbz(64, 16, (#words + 1 - noBudget) * 4)
    emit(arm.cmp_imm(64, 16, 2, 0));
    local noCancel = #words + 1;
    emit(arm.b_cond(3, 0))
    emit(arm.ldr(8, 17, 0, 72));
    emit(arm.ldr(8, 17, 17, 8));
    emit(arm.str(8, 17, 19, context.CANCELLED))
    words[noCancel] = arm.b_cond(3, (#words + 1 - noCancel) * 4)
    offset(14, 19, bindingOffset)
    local binding = layouts.Binding.offsets
    emit(arm.ldr(8, 16, 0, 24));
    emit(arm.str(8, 16, 14, binding.data))
    emit(arm.ldr(8, 16, 0, 32));
    emit(arm.str(8, 16, 14, binding.dataBytes))
    emit(arm.ldr(8, 16, 0, 8));
    emit(arm.str(8, 16, 14, binding.code))
    emit(arm.ldr(8, 16, 0, 16));
    emit(arm.str(8, 16, 14, binding.codeBytes))
    for _, field in ipairs({
        {"context", "contextBytes", 0, context.SIZE},
        {"world", "worldBytes", worldOffset, layouts.World.size},
        {"storage", "storageBytes", storageOffset, storageBytes},
        {"pool", "poolBytes", poolOffset, poolBytes},
        {"helper", "helperBytes", spillOffset, extent}
    }) do
        offset(16, 19, field[3]);
        emit(arm.str(8, 16, 14, binding[field[1]]))
        immediate(16, field[4]);
        emit(arm.str(8, 16, 14, binding[field[2]]))
    end
    emit(arm.mov_reg(64, 0, 14));
    local beginCall = #words + 1;
    emit(arm.bl(0))
    emit(arm.cmp_imm(64, 0, 0, 0));
    refuse(0)
    emit(arm.mov_reg(64, 20, 0));
    emit(arm.ldr(8, 17, 19, context.ROOT_SERIAL));
    emit(arm.str(8, 17, 31, 184))
    -- start validated all metadata before success. Materialize exactly256
    -- handler offsets into the separate mapped dispatch extent.
    emit(arm.ldr(8, 13, 31, 168));
    emit(arm.ldr(8, 14, 13, 24));
    emit(arm.ldr(8, 15, 13, 8))
    emit(arm.ldr(8, 16, 14, layouts.Descriptor.offsets.dispatch));
    emit(arm.add_reg(64, 14, 14, 16, 0))
    for index = 0, 255 do
        emit(arm.ldr(8, 16, 14, index * 8));
        emit(arm.add_reg(64, 16, 15, 16, 0));
        emit(arm.str(8, 16, 21, index * 8))
    end
    local frame = layouts.Frame.offsets
    emit(arm.ldr(8, 0, 20, frame.code));
    emit(arm.str(8, 0, 19, context.CODE_START))
    emit(arm.ldr(8, 1, 20, frame.values));
    emit(arm.ldr(8, 2, 20, frame.integers));
    emit(arm.ldr(8, 3, 20, frame.floats))
    emit(arm.mov_reg(64, 4, 19));
    emit(arm.mov_reg(64, 5, 20))
    emit(arm.ldr(1, 16, 0, 0));
    emit(arm.add_reg(64, 16, 21, 16, 3));
    emit(arm.ldr(8, 16, 16, 0));
    emit(arm.blr(16))
    -- Every handler transport exit reaches complete, including failed publish
    -- with a prepared child. No status branch can bypass mandatory cleanup.
    emit(arm.ldr(8, 17, 19, context.STATUS));
    emit(arm.str(8, 17, 31, 176))
    emit(arm.mov_reg(64, 0, 19));
    emit(arm.mov_reg(64, 1, 20));
    emit(arm.ldr(8, 2, 31, 184))
    local completeCall = #words + 1;
    emit(arm.bl(0))
    emit(arm.ldr(8, 17, 31, 176));
    local noStatus = #words + 1;
    emit(arm.cbz(64, 17, 0))
    emit(arm.mov_reg(64, 0, 17));
    local stopped = #words + 1;
    emit(arm.b(0))
    words[noStatus] = arm.cbz(64, 17, (#words + 1 - noStatus) * 4)
    emit(arm.cmp_imm(64, 0, 1, 0));
    refuse(1)
    emit(arm.ldr(8, 16, 19, context.ROOT_CONTROL));
    emit(arm.ldr(8, 17, 16, layouts.RootControl.offsets.value))
    emit(arm.ldr(8, 16, 31, 160));
    emit(arm.str(8, 17, 16, 0));
    emit(arm.movz(64, 0, 0, 0))
    local success = #words + 1;
    emit(arm.b(0))
    local failed = #words + 1;
    emit(arm.movz(64, 0, 1, 0))
    local restore = #words + 1
    words[success], words[stopped] = arm.b((restore - success) * 4), arm.b((restore - stopped) * 4)
    for _, refusal in ipairs(refusals) do
        words[refusal.at] = arm.b_cond(refusal.condition, (failed - refusal.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0));
    emit(arm.ret(30))
    local linked = linker.assembleAuthenticated(words, roots, functions, scratchBytes - spillOffset)
    assert(linked.callBytes == extent)
    linked.words[beginCall] = arm.bl((linked.offsets[startIndex] as integer) - (beginCall - 1) * 4)
    linked.words[completeCall] = arm.bl((linked.offsets[completeIndex] as integer) - (completeCall - 1) * 4)
    local byName = {}
    for index, name in ipairs(source.handlers) do
        byName[name] = linked.offsets[index]
    end
    local dispatch = {}
    for index = 1, 256 do
        dispatch[index] = assert(byName.Invalid)
    end
    for index, name in ipairs(opcodes.names()) do
        if byName[name] then
            assert(index <= 256);
            dispatch[index] = byName[name]
        end
    end
    contract.validateGuest(source)

    return {
        words = linked.words,
        offsets = linked.offsets,
        frames = linked.frames,
        callBytes = extent,
        dispatch = dispatch,
        scratchBytes = scratchBytes,
        spillOffset = spillOffset,
        poolOffset = poolOffset,
        poolBytes = poolBytes,
        storageOffset = storageOffset,
        storageBytes = storageBytes,
        worldOffset = worldOffset,
        bindingOffset = bindingOffset,
        dispatchOffset = dispatchOffset,
        layouts = layouts,
        entry = 0
    }
end

export = shim
