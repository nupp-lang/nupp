module nupp.core.heapshim

local arm = require("s0.arm64")
local literal = require("s0.literal")
local unit = require("nupp.compiler.vm.nativeunit")
local linker = require("nupp.core.link")
local nativeos = require("nupp.compiler.vm.nativeos")
local contract = require("nupp.compiler.vm.nativeframecontract")
local sink = require("nupp.compiler.s0.nativegraph")
local targetLayout = require("nupp.compiler.targetlayout")
local shim = {}

local function checkedInteger(value: any): integer
    assert(
        type(value) == "number" and value >= 0 and value <= 16777216 and value % 1 == 0,
        "bounded integral layout or code offset required"
    )

    return value as integer
end

local function align(bytes: integer): integer
    return (bytes + 15) & -16
end

-- This boundary transports mappings and invokes original checked Nupp bodies.
-- It does not construct a Heap/Frame, run a collector, or interpret guest ops.
-- All entry-owned data survives a failed call independently of bridge scratch.
function shim.build(source: any, selected: {[string]: any}, stress: boolean, scenario: string): any
    assert(
        scenario == "cell"
        or scenario == "cell-phase-refusal"
        or scenario == "noop"
        or scenario == "acquire-refusal"
        or scenario == "release-refusal",
        "closed heap workload"
    )
    contract.validateHeapServices(source)
    local cell = scenario == "cell" or scenario == "cell-phase-refusal"
    local rootNames = {
        "nupp.runtime.core.pagemappings.initialize",
        "nupp.runtime.core.servicescope.initialize",
        "nupp.runtime.core.heapentry.run",
        "nupp.runtime.core.servicescope.close",
        "nupp.runtime.core.pagemappings.acquireEntry",
        "nupp.runtime.core.pagemappings.releaseEntry"
    }
    local kinds = {
        {"voidptr", "uint64", "voidptr", "uint64", "uint64"},
        {"voidptr", "uint64", "voidptr", "uint64"},
        {"voidptr", "voidptr"},
        {"voidptr"},
        {"uint64"},
        {"voidptr", "voidptr", "uint64"}
    }
    local roots, rootSet, functions, layouts = {}, {}, {}, {}
    local rootIndices: {[integer]: integer} = {}
    local sizes: {[string]: integer} = {}
    for index, name in ipairs(rootNames) do
        local item, code = assert(source.resolved[name]), assert(selected[name])
        sink.verifyCodeOrigin(code, item.graph, item.owner)
        local params = item.graph.native.params
        assert(#params == #kinds[index], "heap boundary arity")
        for slot, kind in ipairs(kinds[index]) do
            assert(params[slot] == kind, "heap boundary argument kind")
        end
        assert(item.graph.native.result == (index == 5 and "voidptr" or "uint64"), "heap boundary result kind")
        if cell or index >= 5 then
            roots[#roots + 1], rootSet[name] = code, true
            rootIndices[index] = #roots
        end
    end
    for _, row in ipairs({
        {"Binding", rootNames[3], "Binding"},
        {"Storage", rootNames[3], "Storage"},
        {"ServiceScope", rootNames[2], "ServiceScope"},
        {"PageScope", rootNames[1], "Scope"},
        {"Mapping", rootNames[1], "Mapping"},
        {"EntryBacking", rootNames[5], "EntryBacking"},
        {"Descriptor", "nupp.runtime.core.rootentry.start", "Descriptor"},
        {"RootStorage", "nupp.runtime.core.rootentry.start", "Storage"},
        {"FrameState", "nupp.runtime.core.frames.finishRoot", "State"},
        {"RootControl", "nupp.runtime.core.frames.finishRoot", "RootControl"},
        {"RootResult", "nupp.runtime.core.frameroots.publish", "Result"}
    }) do
        local scope = assert(source.resolved[row[2]]).owner.scope
        local layout = assert(targetLayout.of(assert(scope.checkedExports.types[row[3]]), "aarch64-apple-darwin"))
        sizes[row[1]] = checkedInteger(layout.size)
        for _, value in pairs(layout.offsets) do
            checkedInteger(value)
        end
        layouts[row[1]] = layout
    end

    local entryOwner = assert(source.resolved[rootNames[3]]).owner
    local frames = unit.ownerModule(entryOwner, "nupp.runtime.core.frames")
    local values = unit.ownerModule(entryOwner, "nupp.runtime.vm.values")
    local retired = assert(frames.exportedConstants.ROOT_RETIRED)
    local active = literal.integer(assert(frames.exportedConstants.ROOT_ACTIVE))
    assert(active == 1LL, "checked active root phase")
    local nilValue = assert(values.exportedConstants.NIL)
    local trueValue = assert(values.exportedConstants.TRUE)

    local function size(name: string): integer
        return (assert(sizes[name], "missing checked layout size"))
    end

    local count: integer = 0
    for name, item in pairs(source.resolved) do
        local code = assert(selected[name], "heap selection missing")
        sink.verifyCodeOrigin(code, item.graph, item.owner)
        if not rootSet[name] then
            functions[name] = code
        end
        count = count + 1
    end
    local found: integer = 0
    for name in pairs(selected) do
        assert(source.resolved[name], "extra heap selection")
        found = found + 1
    end
    assert(found == count, "heap selected inventory")
    local scratchSpill = align(size("PageScope"))
    -- A selected chain may need more than the old 128 KiB mapping. Preflight
    -- under a fixed ceiling before allocating either scratch or retained data.
    local scratchCeiling: integer = 1048576
    local extent = checkedInteger(
        linker.assembleAuthenticated(
            {},
            roots,
            functions,
            scratchCeiling - scratchSpill,
            "heap call chain exceeds 1 MiB scratch cap"
        ).callBytes
    )
    assert(extent > 0 and extent % 16 == 0, "heap helper extent")
    local highWater = scratchSpill + extent
    local scratchBytes: integer = 131072
    if highWater > scratchBytes then
        scratchBytes = ((highWater + 65535) // 65536) * 65536
    end
    assert(scratchBytes <= scratchCeiling, "heap scratch capacity")
    local descriptorBytes = size("Descriptor") + 24
    assert(descriptorBytes % 8 == 0, "whole-word root descriptor")
    local bindingOffset = align(size("EntryBacking"))
    local dataOffset = align(bindingOffset + size("Binding"))
    local storageOffset = align(dataOffset + descriptorBytes)
    local scopeOffset = align(storageOffset + size("Storage"))
    local ledgerOffset = align(scopeOffset + size("ServiceScope"))
    local recordsOffset = align(ledgerOffset + size("PageScope"))
    local recordCount: integer = 256
    local recordBytes = recordCount * size("Mapping")
    local poolOffset = align(recordsOffset + recordBytes)
    local poolBytes: integer = 16384
    local helperOffset = align(poolOffset + poolBytes)
    local canaryOffset = helperOffset + extent
    local retainedBytes = canaryOffset + 16
    assert(retainedBytes <= 1048576, "retained entry extent")
    local words: {integer} = {}
    local refusals: {{
        at: integer,
        condition: integer,
        status: integer
    }} = {}
    local calls: {{
        at: integer,
        target: integer
    }} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function immediate(reg: integer, value: integer): nil
        assert(value >= 0 and value < 4294967296)
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(dst: integer, base: integer, bytes: integer): nil
        assert(bytes >= 0 and bytes < 16777216)
        local high, low = bytes >> 12, bytes & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, dst, base, high, 1));
            base = dst
        end
        emit(arm.add_imm(64, dst, base, low, 0))
    end

    local function refuse(condition: integer, status: integer?): nil
        refusals[#refusals + 1] = {at = #words + 1, condition = condition, status = status or 1}
        emit(arm.b_cond(condition, 0))
    end

    local function call(index: integer): nil
        calls[#calls + 1] = {at = #words + 1, target = assert(rootIndices[index])}
        emit(arm.bl(0))
    end

    local function cleanScope(): nil
        offset(16, 19, scopeOffset)
        for _, field in ipairs({"error", "retainBacking"}) do
            emit(arm.ldr(8, 17, 16, layouts.ServiceScope.offsets[field]))
            emit(arm.cmp_imm(64, 17, 0, 0));
            refuse(1)
        end
    end

    -- Read the retained entry state independently of the service's return code.
    -- Any refusal keeps the backing mapped and suppresses scalar success.
    local function completedEntry(): nil
        local function requireWord(layout: any, field: string, expected: string, refusalStatus: integer?): nil
            emit(arm.ldr(8, 16, 15, checkedInteger(layout.offsets[field])))
            local value = literal.integer(expected)
            for half = 0, 3 do
                local part: integer = ((value >> (half * 16)) & 65535LL) as integer
                if half == 0 then
                    emit(arm.movz(64, 17, part, half))
                elseif part ~= 0 then
                    emit(arm.movk(64, 17, part, half))
                end
            end
            emit(arm.cmp_reg(64, 16, 17));
            refuse(1, refusalStatus)
        end

        offset(15, 19, storageOffset)
        requireWord(layouts.Storage, "entered", "1")
        requireWord(layouts.Storage, "completed", "1")
        local rootOffset = storageOffset + checkedInteger(layouts.Storage.offsets.root)
        offset(15, 19, rootOffset + checkedInteger(layouts.RootStorage.offsets.state))
        requireWord(layouts.FrameState, "active", "0")
        requireWord(layouts.FrameState, "depth", "0")
        offset(15, 19, rootOffset + checkedInteger(layouts.RootStorage.offsets.root))
        requireWord(layouts.RootControl, "frame", "0")
        requireWord(layouts.RootControl, "phase", retired, scenario == "cell-phase-refusal" and 2 or 1)
        requireWord(layouts.RootControl, "count", "1")
        requireWord(layouts.RootControl, "value", trueValue)
        offset(15, 19, storageOffset + checkedInteger(layouts.Storage.offsets.outerResult))
        requireWord(layouts.RootResult, "value", nilValue)
        offset(15, 19, storageOffset + checkedInteger(layouts.Storage.offsets.innerResult))
        requireWord(layouts.RootResult, "value", nilValue)
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160));
    emit(arm.str(8, 0, 31, 168))
    for _, check in ipairs({
        {0, 1, 1},
        {32, descriptorBytes, 1},
        {48, scratchBytes, 3},
        {64, nativeos.imports(), 3},
        {80, 0, 1},
        {88, 1, 3}
    }) do
        emit(arm.ldr(8, 16, 0, check[1]));
        immediate(17, check[2])
        emit(arm.cmp_reg(64, 16, 17));
        refuse(check[3])
    end
    emit(arm.ldr(8, 19, 0, 40));
    emit(arm.ldr(8, 22, 0, 56))
    offset(23, 19, scratchSpill)
    -- Acquire/release use helper storage and unmap status OUTSIDE the retained
    -- mapping. Releasing its own active spills would be a use-after-unmap.
    if scenario == "acquire-refusal" then
        immediate(0, 0);
        call(5)
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
    else
        immediate(0, retainedBytes);
        call(5)
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(0)
        emit(arm.mov_reg(64, 19, 0))
        if cell then
            offset(23, 19, helperOffset)
            -- Copy every byte rootentry may retain. Neither Frame.code/bodyOwner nor
            -- Binding.data references packet storage after this copy.
            emit(arm.ldr(8, 13, 31, 168));
            emit(arm.ldr(8, 14, 13, 24))
            offset(15, 19, dataOffset)
            for at = 0, descriptorBytes - 8, 8 do
                emit(arm.ldr(8, 16, 14, at));
                emit(arm.str(8, 16, 15, at))
            end
            offset(14, 19, bindingOffset)

            local function bind(field: string, countField: string, at: integer, bytes: integer): nil
                offset(16, 19, at)
                emit(arm.str(8, 16, 14, checkedInteger(layouts.Binding.offsets[field])))
                immediate(16, bytes)
                emit(arm.str(8, 16, 14, checkedInteger(layouts.Binding.offsets[countField])))
            end

            bind("data", "dataBytes", dataOffset, descriptorBytes)
            bind("storage", "storageBytes", storageOffset, size("Storage"))
            bind("pool", "poolBytes", poolOffset, poolBytes)
            bind("helper", "helperBytes", helperOffset, extent)
            immediate(16, stress and 1 or 0);
            emit(arm.str(8, 16, 14, layouts.Binding.offsets.stress))
            offset(15, 19, canaryOffset);
            emit(arm.movn(64, 16, 0, 0))
            emit(arm.str(8, 16, 15, 0));
            emit(arm.str(8, 16, 15, 8))
            offset(0, 19, ledgerOffset);
            immediate(1, size("PageScope"))
            offset(2, 19, recordsOffset);
            immediate(3, recordBytes);
            immediate(4, recordCount);
            call(1)
            emit(arm.cmp_imm(64, 0, 1, 0));
            refuse(1)
            offset(0, 19, scopeOffset);
            immediate(1, size("ServiceScope"))
            offset(2, 19, ledgerOffset);
            immediate(3, size("PageScope"));
            call(2)
            emit(arm.cmp_imm(64, 0, 1, 0));
            refuse(1)
            cleanScope()
            offset(0, 19, bindingOffset);
            offset(1, 19, scopeOffset);
            call(3)
            emit(arm.str(8, 0, 31, 176))
            cleanScope()
            emit(arm.ldr(8, 16, 31, 176));
            emit(arm.cmp_imm(64, 16, 0, 0));
            refuse(1)
            offset(16, 19, storageOffset)
            emit(arm.ldr(8, 17, 16, layouts.Storage.offsets.completed));
            emit(arm.cmp_imm(64, 17, 1, 0));
            refuse(1)
            offset(15, 19, canaryOffset);
            emit(arm.movn(64, 17, 0, 0))
            for at = 0, 8, 8 do
                emit(arm.ldr(8, 16, 15, at));
                emit(arm.cmp_reg(64, 16, 17));
                refuse(1)
            end
            offset(0, 19, scopeOffset);
            call(4)
            emit(arm.cmp_imm(64, 0, 1, 0));
            refuse(1)
            cleanScope()
            offset(15, 19, canaryOffset);
            emit(arm.movn(64, 17, 0, 0))
            for at = 0, 8, 8 do
                emit(arm.ldr(8, 16, 15, at));
                emit(arm.cmp_reg(64, 16, 17));
                refuse(1)
            end
            if scenario == "cell-phase-refusal" then
                local rootOffset = storageOffset + checkedInteger(layouts.Storage.offsets.root)
                offset(15, 19, rootOffset + checkedInteger(layouts.RootStorage.offsets.root))
                immediate(16, active as integer)
                emit(arm.str(8, 16, 15, checkedInteger(layouts.RootControl.offsets.phase)))
            end
            completedEntry()
        elseif scenario == "release-refusal" then
            -- A mismatched extent refuses before consuming the live token. This
            -- tests source preflight refusal, not retry after an OS unmap failure.
            emit(arm.ldr(8, 13, 31, 168));
            emit(arm.ldr(8, 0, 13, 40))
            immediate(16, 37);
            emit(arm.str(8, 16, 0, layouts.PageScope.offsets.status))
            emit(arm.mov_reg(64, 1, 19));
            immediate(2, retainedBytes + 8);
            call(6)
            emit(arm.cmp_imm(64, 0, 0, 0));
            refuse(1)
            emit(arm.ldr(8, 16, 19, layouts.EntryBacking.offsets.base))
            emit(arm.cmp_reg(64, 16, 19));
            refuse(1)
            emit(arm.ldr(8, 16, 19, layouts.EntryBacking.offsets.bytes));
            immediate(17, retainedBytes)
            emit(arm.cmp_reg(64, 16, 17));
            refuse(1)
            emit(arm.ldr(8, 16, 19, layouts.EntryBacking.offsets.phase))
            emit(arm.cmp_imm(64, 16, 1, 0));
            refuse(1)
            emit(arm.ldr(8, 13, 31, 168));
            emit(arm.ldr(8, 14, 13, 40))
            emit(arm.ldr(8, 16, 14, layouts.PageScope.offsets.status))
            emit(arm.cmp_imm(64, 16, 37, 0));
            refuse(1)
        end
        -- Nothing reads retained metadata after release. The source wrapper writes
        -- OS status to the disjoint scratch Scope and consumes its mapping token.
        emit(arm.mov_reg(64, 1, 19));
        immediate(2, retainedBytes)
        emit(arm.ldr(8, 13, 31, 168));
        emit(arm.ldr(8, 19, 13, 40))
        emit(arm.mov_reg(64, 0, 19));
        offset(23, 19, scratchSpill);
        call(6)
        emit(arm.cmp_imm(64, 0, 1, 0));
        refuse(1)
    end
    emit(arm.ldr(8, 16, 31, 160));
    immediate(17, 1);
    emit(arm.str(8, 17, 16, 0))
    immediate(0, 0)
    local success = #words + 1;
    emit(arm.b(0))
    local failed = #words + 1;
    immediate(0, 1)
    local failedEnd = #words + 1;
    emit(arm.b(0))
    local phaseFailed = #words + 1;
    immediate(0, 2)
    local restore = #words + 1
    words[success] = arm.b((restore - success) * 4)
    words[failedEnd] = arm.b((restore - failedEnd) * 4)
    for _, refusal in ipairs(refusals) do
        local target = refusal.status == 2 and phaseFailed or failed
        words[refusal.at] = arm.b_cond(refusal.condition, (target - refusal.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0));
    emit(arm.ret(30))
    local linked = linker.assembleAuthenticated(words, roots, functions, scratchBytes - scratchSpill)
    assert(linked.callBytes == extent, "heap helper extent changed")
    for _, site in ipairs(calls) do
        linked.words[site.at] = arm.bl(checkedInteger(linked.offsets[site.target]) - (site.at - 1) * 4)
    end
    contract.validateHeapServices(source)

    return {
        words = linked.words,
        offsets = linked.offsets,
        frames = linked.frames,
        scenario = scenario,
        rootNames = cell and rootNames or {rootNames[5], rootNames[6]},
        descriptorTarget = cell and linked.offsets[rootIndices[3]] or 0,
        entry = 0,
        scratchBytes = scratchBytes,
        spillOffset = scratchSpill,
        callBytes = extent,
        retainedBytes = retainedBytes,
        retainedHelperOffset = helperOffset,
        retainedCanaryOffset = canaryOffset,
        bindingOffset = bindingOffset,
        storageOffset = storageOffset,
        serviceScopeOffset = scopeOffset,
        ledgerOffset = ledgerOffset,
        recordsOffset = recordsOffset,
        recordCount = recordCount,
        poolOffset = poolOffset,
        poolBytes = poolBytes,
        layouts = layouts
    }
end

export = shim
