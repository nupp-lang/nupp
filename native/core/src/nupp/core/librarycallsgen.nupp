module nupp.core.librarycallsgen

local corelibrary = require("nupp.compiler.vm.corelibrary")
local coretexts = require("nupp.compiler.vm.coretexts")
local generator = {}

-- The runtime's ids for the core's library calls, from the one table
-- (nupp.compiler.vm.corelibrary): each call's id, a range subject's bounds,
-- and the text each call's errors name it by. The layouts the calls share
-- with the compiler are librarylayoutsgen's.
function generator.source(): string
    local lines = {
        "module nupp.runtime.core.librarycalls",
        "",
        "-- Generated by nupp.core.librarycallsgen from nupp.compiler.vm.corelibrary,",
        "-- the one table of the core's library calls: edit that table, not this file.",
        "",
        "const librarytexts = require(\"nupp.runtime.core.librarytexts\")"
    }

    local function constant(name: string, value: integer): nil
        lines[#lines + 1] = "export const " .. name .. ": uint64 = " .. tostring(value) .. "ULL"
    end

    local texts = {}
    for _, entry in ipairs(coretexts.all()) do
        texts[entry.name] = entry
    end
    local named = {}
    for _, subject in ipairs(corelibrary.subjects()) do
        lines[#lines + 1] = ""
        lines[#lines + 1] = "-- " .. subject.name
        local low: integer, high: integer = corelibrary.LIMIT, 0
        for _, entry in ipairs(subject.calls) do
            constant(entry.name, entry.id)
            low = math.min(low, entry.id) as integer
            high = math.max(high, entry.id) as integer
            if entry.text then
                assert(texts[entry.text], "core library text " .. entry.text .. " is not a core text")
                named[#named + 1] = entry
            end
        end
        if subject.range then
            constant(subject.name:upper() .. "_FIRST", low)
            constant(subject.name:upper() .. "_LAST", high)
        end
    end

    -- By id, so the function reads in the order the calls were numbered.
    table.sort(named, function(a: any, b: any): boolean
        return a.id < b.id
    end)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The text a library call's errors name it by, or 0 for none."
    lines[#lines + 1] = "export function libraryname(id: uint64): uint64"
    for index, entry in ipairs(named) do
        lines[#lines + 1] = (index == 1 and "    if" or "    elseif") .. " id == " .. entry.name .. " then"
        lines[#lines + 1] = "        return librarytexts." .. entry.text
    end
    lines[#lines + 1] = "    end"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end

export = generator
