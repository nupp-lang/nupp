module nupp.core.rawexecutablegen

local schema = require("nupp.compiler.vm.coregraphschema")
local bytecode = require("nupp.compiler.vm.corebytecode")

export function source(): string
    local graph, wire = schema.describe(), schema.wire()
    local names = {"K", "Require", "Nil", "Move"}
    local ids = {}
    for _, item in ipairs(graph.operations) do
        ids[item.name] = item.id
    end
    local lines = {
        "module nupp.runtime.core.rawexecutablepolicy",
        "",
        "-- Generated from the graph schema and canonical final-core byte recipes.",
        "export const version = " .. wire.version .. "ULL",
        "export const profile = " .. wire.profile .. "ULL"
    }
    for _, name in ipairs(names) do
        local id = assert(ids[name], "missing raw executable operation " .. name)
        lines[#lines + 1] = "export const Op_" .. name .. " = " .. id .. "ULL"
    end
    for _, name in ipairs({"K", "Nil", "Move", "Ret"}) do
        local recipe = bytecode.describe(name)
        assert(recipe.bytes == 16 and recipe.id < 256)
        lines[#lines + 1] = "export const Byte_" .. name .. " = " .. recipe.id .. "ULL"
    end
    lines[#lines + 1] = ""

    return table.concat(lines, "\n")
end
