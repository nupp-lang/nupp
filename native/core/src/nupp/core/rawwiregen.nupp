module nupp.core.rawwiregen

local schema = require("nupp.compiler.vm.coregraphschema")

-- Generated native source is a projection of the canonical wire descriptor.
-- No operation IDs or graph semantics belong in this layout projection.
export function source(): string
    local wire = schema.wire()
    local lines = {
        "module nupp.runtime.core.rawwire",
        "",
        "-- Generated by nupp.core.rawwiregen from coregraphschema.wire().",
        "-- Regenerate and compare exactly; do not maintain these values by hand.",
        "const native = require(\"nupp.runtime.vm.intrinsics\")",
        ""
    }

    local function line(text: string): nil
        lines[#lines + 1] = text
    end

    local function constant(name: string, value: number): nil
        line("export const " .. name .. " = " .. tostring(value) .. "ULL")
    end

    for _, name in ipairs({
        "version",
        "profile",
        "headerBytes",
        "directoryBytes",
        "fileLimit",
        "recordsLimit",
        "stringLimit",
        "expandedLimit"
    }) do
        constant(name, wire[name])
    end
    constant("sectionCount", #wire.sections)
    constant("minimumBytes", wire.headerBytes + #wire.sections * wire.directoryBytes)
    for _, pair in ipairs({{wire.header, "H_", 8}, {wire.directory, "D_", 0}}) do
        for _, field in ipairs(pair[1].fields) do
            constant(pair[2] .. field.name, pair[3] + field.offset)
        end
    end
    for _, section in ipairs(wire.sections) do
        constant("S_" .. section.name, section.id)
    end
    line("")
    for _, property in ipairs({"stride", "expansion"}) do
        line("export function " .. property .. "(section: uint64): uint64")
        for index, section in ipairs(wire.sections) do
            local value = property == "stride" and section.stride or 1 + 2 * #section.fields
            line((index == 1 and "    if" or "    elseif") .. " section == " .. tostring(section.id) .. "ULL then")
            line("        return " .. tostring(value) .. "ULL")
        end
        line("    end")
        line("")
        line("    return 0ULL")
        line("end")
        line("")
    end
    line("export function magic(data: voidptr): uint64")
    for at = 1, #wire.magic do
        line("    if native.load8(data, " .. tostring(at - 1) .. ") ~= " .. tostring(wire.magic:byte(at)) .. " then")
        line("        return 0ULL")
        line("    end")
    end
    line("")
    line("    return 1ULL")
    line("end")
    line("")
    line("export function policy(data: voidptr, at: int64): uint64")
    local policy = wire.sections[1]
    assert(policy.name == "schema" and policy.id == 0 and #policy.fields == 4)
    for _, field in ipairs(policy.fields) do
        assert(field.kind == "u32" and wire.policy[field.name] ~= nil)
        line(
            "    if (native.word(native.load32(data, at + " .. tostring(
                field.offset
            ) .. ")) & 0xffffffffULL) ~= " .. tostring(wire.policy[field.name]) .. "ULL then"
        )
        line("        return 0ULL")
        line("    end")
    end
    line("")
    line("    return 1ULL")
    line("end")

    return table.concat(lines, "\n") .. "\n"
end
