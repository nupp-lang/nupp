module nupp.core.librarylayoutsgen

local corelibrary = require("nupp.compiler.vm.corelibrary")
local bytecode = require("nupp.compiler.vm.corebytecode")

-- The layouts the runtime's library calls share with the compiler, from the
-- one table (nupp.compiler.vm.corelibrary) and the instruction recipes
-- (corebytecode): the LibCall instruction, the file operations HOST_FILES
-- takes, and the keys of the state tables some calls keep between steps.
export function source(): string
    local lines = {
        "module nupp.runtime.core.librarylayouts",
        "",
        "-- Generated by nupp.core.librarylayoutsgen from nupp.compiler.vm.corelibrary",
        "-- and corebytecode: edit those, not this file."
    }

    local function constant(name: string, value: integer): nil
        lines[#lines + 1] = "export const " .. name .. ": uint64 = " .. tostring(value) .. "ULL"
    end

    -- The instruction: its opcode, the bytes its id and its argument count
    -- are at, and the count byte's method-form flag. A landing check reads
    -- past the Move and Nil before it.
    local libcall = bytecode.describe("LibCall")
    local idField, countField = libcall.fields[2], libcall.fields[4]
    assert(idField.class == "n" and countField.class == "n", "LibCall layout")
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The LibCall instruction and the two a landing check reads past."
    constant("OPCODE_LIBCALL", libcall.id as integer)
    constant("OPCODE_MOVE", bytecode.describe("Move").id as integer)
    constant("OPCODE_NIL", bytecode.describe("Nil").id as integer)
    constant("INSTRUCTION_BYTES", libcall.bytes as integer)
    constant("ID_OFFSET", idField.offset as integer)
    constant("COUNT_OFFSET", countField.offset as integer)
    lines[#lines + 1] = "-- A call in method form: its argument count carries this flag."

    local function flag(name: string, value: integer): nil
        local shift: integer = 0
        while 1 << shift < value do
            shift += 1
        end
        assert(1 << shift == value, "a count flag is one bit")
        constant(name .. "_SHIFT", shift)
    end

    constant("METHOD_FORM", corelibrary.COUNT_METHOD_FORM)
    assert(corelibrary.COUNT_FORWARD_FORM < corelibrary.COUNT_METHOD_FORM, "the flags sit above the count")
    constant("COUNT_MASK", corelibrary.COUNT_FORWARD_FORM - 1)
    flag("METHOD", corelibrary.COUNT_METHOD_FORM)
    lines[#lines + 1] = "-- A canonical library value's call of its own function: its count carries"
    lines[#lines + 1] = "-- this flag, and its errors are its caller's."
    constant("FORWARD_FORM", corelibrary.COUNT_FORWARD_FORM)
    flag("FORWARD", corelibrary.COUNT_FORWARD_FORM)
    constant("ARGUMENTS", corelibrary.ARGUMENTS)

    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The operations HOST_FILES takes first, by group."
    for _, group in ipairs(corelibrary.groups()) do
        for _, operation in ipairs(group.operations) do
            constant(operation.name, operation.operation)
        end
        constant(group.name .. "_FIRST", group.operations[1].operation)
        constant(group.name .. "_LAST", group.operations[#group.operations].operation)
    end

    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The keys of the state tables some calls keep between steps."
    for _, layout in ipairs(corelibrary.layouts()) do
        local suffix = layout.kind == "uint64" and "ULL" or ""
        for index, field in ipairs(layout.fields) do
            lines[
                #lines + 1
            ] = "export const " .. layout.name .. "_" .. field .. ": " .. layout.kind .. " = " .. tostring(
                index
            ) .. suffix
        end
    end

    return table.concat(lines, "\n") .. "\n"
end
