module nupp.core.guestartifact

-- The guest builder's artifact writer: nupp.compiler.vm.coreartifact, held
-- to the runtime's checked scopes. The catalog layouts, value words, bounds,
-- library call ids and element kinds the writer emits by must be the
-- runtime's own, or a guest reads its artifact wrongly.
local executable = require("nupp.compiler.vm.coregraphexecutable")
local targetLayout = require("nupp.compiler.targetlayout")
local literal = require("s0.literal")
local schema = require("nupp.compiler.vm.coregraphschema")
local corelibrary = require("nupp.compiler.vm.corelibrary")
local writer = require("nupp.compiler.vm.coreartifact")
const TARGET = "aarch64-apple-darwin"
const WORD_BYTES = 8
-- The chunk loader, whose header and relocation words only a chunk needs.
const LOADER = "nupp.runtime.core.guestloader"

-- Where each constant the writer emits by is declared.
const CONSTANT_OWNERS: {
    [string]: string
} = {
    TRUE = "nupp.runtime.vm.values",
    FALSE = "nupp.runtime.vm.values",
    NIL = "nupp.runtime.vm.values",
    DIAGNOSTIC_FORMAT = "nupp.runtime.core.guestcatalog",
    CALL_METHOD = "nupp.runtime.core.guestcatalog",
    CALL_TAIL = "nupp.runtime.core.guestcatalog",
    DIAGNOSTIC_NAME_LIMIT = "nupp.runtime.core.guestcatalog",
    MAGIC = LOADER,
    RELOCATE_FUNCTION = LOADER,
    RELOCATE_MODULE = LOADER,
    RELOCATION_SHIFT = LOADER
}

local function integer(scope: any, name: string, what: string): integer
    return literal.integer((assert(scope.exportedConstants[name], what .. " " .. name)))
end

-- Holds the writer's words and layouts to `scopes`, the runtime's checked
-- modules; the loader's words too when it writes a chunk (`loader`).
local function validate(scopes: any, loader: boolean): nil
    local scope = assert(scopes["nupp.runtime.core.guestcatalog"])
    -- The loader's program-size bounds are the schema's.
    local bounds = schema.limits()
    for name, expected in pairs({
        ownerbound = bounds.owners,
        signaturebound = bounds.signatures,
        modulebound = bounds.modules,
        callbound = bounds.calls,
        instructionbound = bounds.instructions,
        depthbound = executable.depthbound
    }) do
        assert(
            integer(scope, name, "guest catalog bound") == expected,
            "guest catalog bound " .. name .. " differs from the schema"
        )
    end
    -- The runtime's library call ids (generated from corelibrary) and its
    -- element kinds are the table's, which the compiler emits by.
    for _, subject in ipairs(corelibrary.subjects()) do
        local owner = "nupp.runtime.core." .. (subject.output or "librarycalls")
        local calls = assert(scopes[owner], "guest library calls " .. owner)
        for _, call in ipairs(subject.calls) do
            assert(
                integer(calls, call.name, "guest library call") == call.id,
                "guest library call " .. call.name .. " differs from corelibrary"
            )
        end
    end
    for _, row in ipairs(corelibrary.elements()) do
        local owner = assert(scopes["nupp.runtime.core." .. row.module], "guest element kinds " .. row.module)
        assert(
            integer(owner, row.name, "guest element kind") == row.kind,
            "guest element kind " .. row.name .. " differs from corelibrary"
        )
    end
    -- Each catalog record is the writer's fields, a word each, in order.
    for name, fields in pairs(writer.fields) do
        local checked = assert(scope.checkedExports.types[name], "checked catalog layout " .. name)
        assert(scope.checkedExports.typeDefs[name], "checked catalog definition " .. name)
        local layout = assert(targetLayout.of(checked, TARGET))
        assert(layout.target == TARGET and layout.alignment == WORD_BYTES and layout.size == #fields * WORD_BYTES)
        assert(#layout.fields == #fields, "catalog layout " .. name .. " differs from the writer's")
        for index, field in ipairs(layout.fields) do
            assert(
                field.name == fields[index]
                and field.size == WORD_BYTES
                and field.offset == (index - 1) * WORD_BYTES
                and not field.bitWidth,
                "catalog field " .. name .. "." .. tostring(field.name) .. " differs from the writer's"
            )
        end
    end
    for name, owner in pairs(CONSTANT_OWNERS) do
        if loader or owner ~= LOADER then
            local declared = assert(scopes[owner], "guest scope " .. owner)
            assert(
                integer(declared, name, "guest constant") == (writer.constants as {[string]: integer})[name],
                "guest constant " .. name .. " differs from the writer's"
            )
        end
    end
end

-- The executable artifact (coreartifact.encode), once `scopes` agree with it.
export function encode(code: any, scopes: any, dispatch: {integer}, codeBytes: integer, raises: {any}?): any
    validate(scopes, false)

    return writer.encode(code, dispatch, codeBytes, raises)
end

-- A binary chunk (coreartifact.chunk), once `scopes` agree with it.
export function chunk(code: any, scopes: any): string
    validate(scopes, true)

    return writer.chunk(code)
end
