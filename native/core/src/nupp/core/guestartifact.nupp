module nupp.core.guestartifact

local executable = require("nupp.compiler.vm.coregraphexecutable")
local targetLayout = require("nupp.compiler.targetlayout")
local literal = require("s0.literal")
local artifact = {}
-- The constant-word tag of a v8 string constant; the payload is its offset.
local STRING_CONSTANT = 0x7ffe000000000000
-- A wide integer constant (past the 48-bit immediate) over its eight bytes'
-- offset; a negative NaN, which no checked float constant can be.
local INTEGER_CONSTANT = 0xfffe000000000000

-- True when an int64 constant's little-endian bytes do not fit the signed
-- 48-bit immediate.
local function wide(bytes: string): boolean
    local sign, low, high = bytes:byte(6, 8)
    return not (low == 0 and high == 0 and sign < 0x80 or low == 0xff and high == 0xff and sign >= 0x80)
end

-- This writes a trusted checked-source artifact, not a native loader token.
-- The closed producer retains executable issuance and the exact checked layout
-- owners through final publication; a structurally copied layout grants nothing.
function artifact.encode(code: any, scopes: any, dispatch: {integer}, codeBytes: integer): any
    executable.validate(code)
    assert(#dispatch >= 1 and #dispatch <= 256, "guest dispatch extent")
    local scope = assert(scopes["nupp.runtime.core.guestcatalog"])
    local layouts = {}
    for _, name in ipairs({"DescriptorV1", "Descriptor", "Function", "Signature", "Callsite"}) do
        local checked = assert(scope.checkedExports.types[name], "checked catalog layout")
        assert(scope.checkedExports.typeDefs[name], "checked catalog definition")
        local layout = assert(targetLayout.of(checked, "aarch64-apple-darwin"))
        assert(layout.target == "aarch64-apple-darwin" and layout.alignment == 8 and layout.size % 8 == 0)
        for _, field in ipairs(layout.fields) do
            assert(field.size == 8 and field.offset % 8 == 0 and not field.bitWidth)
        end
        layouts[name] = layout
    end
    local records, signatures, calls = code.semantic.catalog, code.semantic.signatures, {}
    for _, fn in ipairs(code.functions) do
        for _, call in ipairs(fn.calls) do
            calls[#calls + 1] = {owner = fn.owner, call = call}
        end
    end
    local version = code.semantic.schema.version >= 3 and code.semantic.schema.version
        or (#code.initializers == 1 and 1 or 2)
    local descriptorName = version == 1 and "DescriptorV1" or "Descriptor"
    local cursor = layouts[descriptorName].size
    local recordOffset = cursor
    cursor += #records * layouts.Function.size
    local signatureOffset = cursor
    cursor += #signatures * layouts.Signature.size
    local callOffset = cursor
    cursor += #calls * layouts.Callsite.size
    local targetOffset = cursor
    cursor += #records * 8
    local moduleOffset = cursor
    if version ~= 1 then
        cursor += #code.initializers * 8
    end
    local parameterOffsets, constantOffsets, codeOffsets = {}, {}, {}
    for index, signature in ipairs(signatures) do
        parameterOffsets[index] = cursor
        cursor += #signature.params * 8
    end
    for index, fn in ipairs(code.functions) do
        constantOffsets[index] = cursor
        cursor += #fn.constants * 8
        codeOffsets[index] = cursor
        cursor += #fn.code
    end
    local dispatchOffset = cursor
    cursor += #dispatch * 8
    -- From v8 string constants are payloads after the dispatch table: a length
    -- word, the bytes and a NUL. Their constant word is STRING_CONSTANT over
    -- the payload's offset.
    -- Integers past the 48-bit immediate follow as their eight int64 bytes,
    -- named by INTEGER_CONSTANT over the offset.
    local stringOffsets: {[string]: integer} = {}
    local stringOrder: {string} = {}
    local integerOffsets: {[string]: integer} = {}
    local integerOrder: {string} = {}
    if version >= 8 then
        for _, fn in ipairs(code.functions) do
            for _, constant in ipairs(fn.constants) do
                if constant.kind == "str" and stringOffsets[constant.value] == nil then
                    stringOffsets[constant.value] = cursor
                    stringOrder[#stringOrder + 1] = constant.value
                    cursor += 8 + ((#constant.value + 8) // 8) * 8
                elseif constant.kind == "int64" and wide(constant.value) and integerOffsets[constant.value] == nil then
                    integerOffsets[constant.value] = cursor
                    integerOrder[#integerOrder + 1] = constant.value
                    cursor += 8
                end
            end
        end
    end
    -- From v8 each function's source lines follow, a word per instruction,
    -- and its chunk name joins the string payloads.
    local lineOffsets: {integer} = {}
    if version >= 8 then
        for index, fn in ipairs(code.functions) do
            local chunk = fn.chunk
            if type(chunk) == "string" and stringOffsets[chunk] == nil then
                stringOffsets[chunk] = cursor
                stringOrder[#stringOrder + 1] = chunk
                cursor += 8 + ((#chunk + 8) // 8) * 8
            end
            if fn.lines and #fn.lines == fn.instructionCount then
                lineOffsets[index] = cursor
                cursor += fn.instructionCount * 8
            end
        end
    end
    assert(cursor <= 67108864 and cursor % 8 == 0, "guest artifact byte budget")
    local bytes = {}
    for index = 1, cursor do
        bytes[index] = 0
    end

    local function word(at: integer, value: int64): nil
        assert(at >= 0 and at % 8 == 0 and at + 8 <= cursor)
        for byte = 0, 7 do
            bytes[at + byte + 1] = (value >> (byte * 8)) & 255
        end
    end

    local function fields(name: string, base: integer, values: any): nil
        local layout = layouts[name]
        for key, value in pairs(values) do
            word((base + assert(layout.offsets[key], "catalog field")) as integer, value)
        end
        for _, field in ipairs(layout.fields) do
            assert(values[field.name] ~= nil, "missing catalog field " .. field.name)
        end
    end

    local function kind(name: string): integer
        assert(
            name == "boolean" or name == "nil" or version >= 3 and name == "number" or version >= 8 and name == "value",
            "scalar signature kind"
        )

        return name == "boolean" and 1 or name == "nil" and 2 or name == "number" and 3 or 4
    end

    local descriptor: any = {
        version = version,
        bytes = cursor,
        ownerCount = #records,
        entry = code.entry,
        records = recordOffset,
        signatures = signatureOffset,
        signatureCount = #signatures,
        contracts = callOffset,
        contractCount = #calls,
        targets = targetOffset,
        instanceBound = code.instanceCapacity,
        frameDepth = code.frameDepth,
        dispatch = dispatchOffset,
        handlerCount = #dispatch
    }
    if version ~= 1 then
        descriptor.moduleCount, descriptor.modules = #code.initializers, moduleOffset
    end
    fields(descriptorName, 0, descriptor)
    local values = assert(scopes["nupp.runtime.vm.values"])
    local constants = {
        ["true"] = literal.integer(assert(values.exportedConstants.TRUE)),
        ["false"] = literal.integer(assert(values.exportedConstants.FALSE)),
        ["nil"] = literal.integer(assert(values.exportedConstants.NIL))
    }
    local nextCall = 0

    local function floatBits(bytes: string): int64
        assert(#bytes == 8, "checked float constant width")
        local hex = {}
        for index = 8, 1, -1 do
            hex[#hex + 1] = string.format("%02x", bytes:byte(index))
        end

        return literal.integer("0x" .. table.concat(hex))
    end

    -- An integer constant is an immediate: TAG_INTEGER over the low 48 bits
    -- of its two's-complement bytes. The graph verifier refused any other.
    local function integerBits(bytes: string): int64
        assert(#bytes == 8, "checked integer constant width")
        local sign, low, high = bytes:byte(6, 8)
        assert(
            low == 0 and high == 0 and sign < 0x80 or low == 0xff and high == 0xff and sign >= 0x80,
            "integer constant exceeds the immediate range"
        )
        local hex = {"7fff"}
        for index = 6, 1, -1 do
            hex[#hex + 1] = string.format("%02x", bytes:byte(index))
        end

        return literal.integer("0x" .. table.concat(hex))
    end

    for index, owner in ipairs(records) do
        local fn = code.functions[index]
        assert(fn.owner == owner.id and owner.id == index - 1)
        fields("Function", (recordOffset + (index - 1) * layouts.Function.size) as integer, {
            id = owner.id,
            parentPlusOne = owner.parent ~= nil and owner.parent + 1 or 0,
            kind = owner.kind == "module" and 0 or 1,
            signature = owner.signature,
            effect = owner.effect,
            code = codeOffsets[index],
            instructionCount = fn.instructionCount,
            valueCount = fn.valueCount,
            constants = constantOffsets[index],
            constantCount = #fn.constants,
            firstCall = nextCall,
            callCount = #fn.calls,
            lines = lineOffsets[index] or 0,
            lands = version >= 8 and fn.lands and 1 or 0,
            chunk = type(fn.chunk) == "string"
            and lineOffsets[index]
            and STRING_CONSTANT | assert(stringOffsets[fn.chunk])
            or 0
        })
        if lineOffsets[index] then
            for pc, line in ipairs(fn.lines) do
                word((lineOffsets[index] + (pc - 1) * 8) as integer, line)
            end
        end
        nextCall += #fn.calls
        word((targetOffset + (index - 1) * 8) as integer, owner.id)
        for ci, constant in ipairs(fn.constants) do
            -- A static module name is checked in the graph and encoded as a
            -- target owner in Require. It has no runtime value-pool payload.
            word(
                (constantOffsets[index] + (ci - 1) * 8) as integer,
                constant.kind == "num" and version >= 3 and floatBits(constant.value)
                or constant.kind == "int64"
                and version >= 8
                and wide(constant.value)
                and INTEGER_CONSTANT | assert(integerOffsets[constant.value])
                or constant.kind == "int64" and version >= 6 and integerBits(constant.value)
                or constant.kind == "str" and version >= 8 and STRING_CONSTANT | assert(stringOffsets[constant.value])
                or assert(constants[constant.kind] or constant.kind == "str" and constants["nil"])
            )
        end
        for byte = 1, #fn.code do
            bytes[codeOffsets[index] + byte] = fn.code:byte(byte)
        end
    end
    if version ~= 1 then
        for index, owner in ipairs(code.initializers) do
            word((moduleOffset + (index - 1) * 8) as integer, owner)
        end
    end
    for index, signature in ipairs(signatures) do
        fields("Signature", (signatureOffset + (index - 1) * layouts.Signature.size) as integer, {
            parameterCount = #signature.params,
            variadic = signature.variadic and 1 or 0,
            resultKind = kind(signature.result),
            parameters = parameterOffsets[index]
        })
        for pi, parameter in ipairs(signature.params) do
            word((parameterOffsets[index] + (pi - 1) * 8) as integer, kind(parameter))
        end
    end
    for index, entry in ipairs(calls) do
        local call = entry.call
        fields("Callsite", (callOffset + (index - 1) * layouts.Callsite.size) as integer, {
            id = call.contract,
            owner = entry.owner,
            pc = call.pc,
            resumePC = call.resumePC,
            target = call.target,
            signature = call.signature,
            argumentCount = call.argumentCount,
            argumentBase = call.argumentBase,
            wanted = call.wanted,
            resultSlot = call.resultSlot,
            spread = call.spread and 1 or 0
        })
    end
    for index, offset in ipairs(dispatch) do
        assert(
            codeBytes > 0 and codeBytes < 134217728 and offset >= 0 and offset % 4 == 0 and offset + 4 <= codeBytes,
            "selected handler offset"
        )
        word((dispatchOffset + (index - 1) * 8) as integer, offset)
    end
    for _, text in ipairs(stringOrder) do
        local at = assert(stringOffsets[text])
        word(at, #text)
        for byte = 1, #text do
            bytes[at + 8 + byte] = text:byte(byte)
        end
    end
    for _, raw in ipairs(integerOrder) do
        local at = assert(integerOffsets[raw])
        for byte = 1, 8 do
            bytes[at + byte] = raw:byte(byte)
        end
    end
    local chunks = {}
    for at = 1, cursor, 64 do
        chunks[#chunks + 1] = string.char(unpack(bytes, at, math.min(at + 63, cursor)))
    end
    executable.validate(code)

    return {
        bytes = table.concat(chunks),
        layouts = layouts,
        dispatchOffset = dispatchOffset,
        codeOffsets = codeOffsets,
        constantOffsets = constantOffsets
    }
end

export = artifact
