--[[
`bytes` provides byte storage, views, encodings, compression, hashes, and bitsets.
Use `Buffer` to build bytes and `hexencode` or `base64encode` to encode them as text.

```nupp
local selected = bytes.Bitset(64)
selected:set(31)
selected:set(32)
assert(selected:count() == 2)
```

A bitset keeps 32 positions in each stored word. Positions and word indexes
start at zero; `wordat` returns a signed 32-bit word. The set grows as positions
are added, and clearing it retains capacity for reuse.

See [](bytes.span) for checked storage views, [](bytes.digest) for digests,
and [](bytes.CompressionFormat) for compression streams.

## Algorithm descriptors

Use `digest`, `checksum`, and `mac` to select reusable algorithm descriptors.
`formats(kind)` lists the available canonical names for a [](bytes.FormatKind).

```nupp
local sha256 = bytes.digest("sha256")
assert(#sha256:computehex("hello") == 64)
local running = sha256:create()
running:write("hello")
assert(running:hexdigest() == sha256:computehex("hello"))
```

Descriptors create independent incremental contexts with `create()`. MAC
operations take a raw-byte key; the descriptor retains no key. See
[digests.md](docs/learn/runtime/data/digests.md) for incremental writes and
finalization.

## Compression

Use `compress` to select a format and `formats("compression")` to list the
available names. A descriptor compresses bytes or wraps an [](io) stream.

```nupp
local gzip = bytes.compress("gzip")
local encoded = gzip:compress("hello", {gzip = {level = 6}})
assert(gzip:decompress(encoded) == "hello")
```

A factory consumes the reader or writer it wraps. A compression writer has to
end in `finish()`; closing or dropping one unfinished aborts the stream and
raises, because a truncated member is worse than a loud failure.

Adapter policy and format options are separate, which is why the options table
is keyed by format name.

## Built-in formats

| Name | Container | Writer options | Reader options |
| --- | --- | --- | --- |
| `gzip` | RFC 1952 gzip | `gzip = { level = 0..9 }` | `gzip = { concatenatedmembers = boolean }` |
| `zlib` | RFC 1950 zlib | `zlib = { level = 0..9 }` | none |
| `deflate-raw` | RFC 1951 raw DEFLATE | `deflateraw = { level = 0..9 }` | none |

All three take levels zero through nine. Gzip checks its CRC and size trailers
and reads concatenated members by default, zlib checks its Adler-32 trailer, and
raw DEFLATE has no checksum at all. Trailing bytes are rejected in every case.

The `deflateraw` options key configures the `deflate-raw` format.
]]
module bytes

const {type Buffer as StorageBuffer, type BufferWriteLease as WriteLease} = require("nupp.io.internal.bytes")

--- An exclusive prepared region of a buffer. Its span may be written, then the
--- lease is committed with the number of bytes that actually landed. Dropping a
--- lease aborts it without changing the buffer's logical length.
--- @export
export type BufferWriteLease = WriteLease

--- Growable byte storage.
---
--- Its pointer and logical length never escape separately. A buffer uses a
--- native array on LuaJIT or a rooted allocation in a Wasm application.
---
--- `Buffer.create()` creates an empty growable buffer. A string supplies initial
--- bytes; an integer reserves capacity without changing the length.
---
--- ```nupp
--- local buffer = bytes.Buffer.create("hello")
--- buffer:put("!")
--- assert(buffer:tostring() == "hello!")
--- ```
---
--- Buffer offsets are zero-based, as they are wherever a count is an offset
--- into storage rather than a position in a Lua string. See [Byte
--- positions](docs/learn/runtime/data/standard-library.md#byte-positions) for
--- the rule and where the other convention applies.
---
--- `readstring(offset, count)` copies a physical range. `writestring` overwrites
--- within the existing extent. `get` and `skip` consume unread bytes; `span`
--- borrows them without copying. A reservation lease appends bytes only after
--- its writer is dropped and the lease is committed.
---
--- @export
export type Buffer = StorageBuffer

--- @internal
export const Buffer = setmetatable({}, {
    __index = function(self: table, key: string): any
        local member = (require("nupp.io.internal.bytes").Buffer as any)[key]
        rawset(self, key, member)
        return member
    end,
}) as metatable<StorageBuffer>

local immutable = require("bytes.internal.bytestypes")

--- Immutable bytes shared across workers without copying.
---
--- Slices retain the same allocation. Positions are zero-based byte offsets; `view` and
--- `viewas` borrow storage, while `tostring` copies it into a Lua string. `copy`
--- creates bytes from a string and `readfile` reads directly into storage.
--- `Buffer:freeze()` consumes a buffer and copies its unread bytes into a region.
--- These operations require the engine host supplied by a stamped binary.
--- `SharedBytes` becomes `string` when workers can share long-string storage.
export type SharedBytes = immutable.SharedBytes

export const SharedBytes = immutable.SharedBytes

local compressionapi = require("nupp.compression")
export type CompressionFormat = compressionapi.CompressionFormat
export type CompressionWriter = compressionapi.CompressionWriter
export type CompressionWriterOptions = compressionapi.CompressionWriterOptions
export type CompressionReaderOptions = compressionapi.CompressionReaderOptions
export type GzipWriterOptions = compressionapi.GzipWriterOptions
export type ZlibWriterOptions = compressionapi.ZlibWriterOptions
export type DeflateRawWriterOptions = compressionapi.DeflateRawWriterOptions
export type GzipReaderOptions = compressionapi.GzipReaderOptions
export const CompressionFormat = compressionapi.CompressionFormat

--- Acquires a retained compression format descriptor or raises when unavailable.
export const compress = compressionapi.compress

local checksumapi = require("nupp.digest.checksum")
export type Checksum = checksumapi.Checksum
export const Checksum = checksumapi.Checksum
export type ChecksumFormat = checksumapi.ChecksumFormat
export const ChecksumFormat = checksumapi.ChecksumFormat

--- Acquires a retained checksum descriptor or raises when unavailable.
export const checksum = checksumapi.checksum

local digestapi = require("nupp.digest.digest")
export type Digest = digestapi.Digest
export const Digest = digestapi.Digest
export type DigestFormat = digestapi.DigestFormat
export const DigestFormat = digestapi.DigestFormat

--- Acquires a retained digest descriptor or raises when unavailable.
export const digest = digestapi.digest

local macapi = require("nupp.digest.mac")
export type Mac = macapi.Mac
export const Mac = macapi.Mac
export type MacFormat = macapi.MacFormat
export const MacFormat = macapi.MacFormat

--- Acquires a retained authentication descriptor without retaining a key.
export const mac = macapi.mac

--- Algorithm families accepted by `formats`.
export type FormatKind = "digest" | "checksum" | "mac" | "compression"

--- Lists available canonical names in ascending order for an algorithm family.
--- @param kind algorithm family to list
--- @return available canonical names in ascending order
--- @raises string when the family is unknown
export function formats(kind: FormatKind): {string}
    if kind == "digest" then
        return digestapi.formats()
    elseif kind == "checksum" then
        return checksumapi.formats()
    elseif kind == "mac" then
        return macapi.formats()
    elseif kind == "compression" then
        return compressionapi.formats()
    end
    error("unknown bytes format kind " .. tostring(kind), 2)
end

local bitset = require("nupp.util.internal.bitset")

--- A growable set of bit positions counting from 0.
export type Bitset = bitset.Bitset

export const Bitset = bitset.Bitset

local hash = require("nupp.util.internal.hash")

--- Hashes bytes with FNV-1a over 64 bits, as sixteen lowercase hexadecimal digits.
export const fnv1a64 = hash.fnv1a64

--- Encodes raw bytes as lowercase hexadecimal.
---
--- ```nupp
--- assert(bytes.hexencode("Nu") == "4e75")
--- ```
export const hexencode = require("nupp.util.internal.encoding").hexencode

--- Decodes either case of hexadecimal without whitespace or a prefix.
---
--- ```nupp
--- assert(bytes.hexdecode("4E75") == "Nu")
--- ```
--- @return raw bytes, or nil and a reason
export function hexdecode(text: string): (string?, string?)
    if #text % 2 ~= 0 then
        return nil, "hex input must contain an even number of digits"
    end
    if text:find("[^0-9a-fA-F]") then
        return nil, "hex input contains a non-hexadecimal digit"
    end
    local parts: {string} = {}
    for index = 1, #text, 2 do
        parts[#parts + 1] = string.char(assert(tonumber(text:sub(index, index + 1), 16)))
    end

    return table.concat(parts)
end

local valuebuilder = require("serde.valuebuilder")

const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

--- The alphabet's inverse, indexed by byte. 255 is not a base64 character.
const INVERSE = "\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\062\255\255\255\063\052\053\054\055\056\057\058\059\060\061\255\255\255\255\255\255\255\000\001\002\003\004\005\006\007\008\009\010\011\012\013\014\015\016\017\018\019\020\021\022\023\024\025\255\255\255\255\255\255\026\027\028\029\030\031\032\033\034\035\036\037\038\039\040\041\042\043\044\045\046\047\048\049\050\051\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255\255"

-- The sentinel a decode publishes instead of a string when the text is not
-- base64. Private, so no caller can pass a value that collides with it.
const INVALID = {}

local function u32(value: integer): uint32
    return math.u32.wrap(value)
end

local function add(a: uint32, b: uint32): uint32
    return math.u32.add(a, b)
end

local function shr(value: uint32, count: uint32): uint32
    return math.u32.shiftrightlogical(value, count)
end

local function shl(value: uint32, count: uint32): uint32
    return math.u32.shiftleft(value, count)
end

local function andBits(a: uint32, b: uint32): uint32
    return math.u32.andbits(a, b)
end

local function orBits(a: uint32, b: uint32): uint32
    return math.u32.orbits(a, b)
end

-- One native-endian word as the big-endian view the encoding is stated in.
-- `nupp.digest.internal.sha256` spells the same reversal in `int32`; every target
-- `targetlayout` models is little-endian, so neither is conditional.
local function reversed(word: uint32): uint32
    return orBits(
        orBits(shl(word, u32(24)), shl(andBits(word, u32(65280)), u32(8))),
        orBits(andBits(shr(word, u32(8)), u32(65280)), shr(word, u32(24)))
    )
end

--- @raises string when the builder cannot allocate or publish
@aot
local function encodeAot(source: string, nullValue: any): any
    local length = valuebuilder.len(source)
    -- Four output bytes per three input, about `1.34n`. There is no division
    -- among the admitted uint32 intrinsics and `1.5n + 4` covers every `n`.
    local bound = add(add(length, shr(length, u32(1))), u32(4))
    local builder = valuebuilder.newsized(nullValue, u32(2), bound)
    local scratch = valuebuilder.newbytescratch(bound)

    local at: uint32 = u32(0)
    local out: uint32 = u32(0)
    while add(at, u32(12)) <= length do
        local wi = shr(at, u32(2))
        local w0 = reversed(valuebuilder.word(source, wi))
        local w1 = reversed(valuebuilder.word(source, add(wi, u32(1))))
        local w2 = reversed(valuebuilder.word(source, add(wi, u32(2))))

        local g0 = shr(w0, u32(8))
        local g1 = orBits(shl(andBits(w0, u32(255)), u32(16)), shr(w1, u32(16)))
        local g2 = orBits(shl(andBits(w1, u32(65535)), u32(8)), shr(w2, u32(24)))
        local g3 = andBits(w2, u32(16777215))

        valuebuilder.setscratchbytes4(
            scratch,
            out,
            orBits(
                orBits(
                    valuebuilder.byte(ALPHABET, andBits(shr(g0, u32(18)), u32(63))),
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g0, u32(12)), u32(63))), u32(8))
                ),
                orBits(
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g0, u32(6)), u32(63))), u32(16)),
                    shl(valuebuilder.byte(ALPHABET, andBits(g0, u32(63))), u32(24))
                )
            )
        )
        valuebuilder.setscratchbytes4(
            scratch,
            add(out, u32(4)),
            orBits(
                orBits(
                    valuebuilder.byte(ALPHABET, andBits(shr(g1, u32(18)), u32(63))),
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g1, u32(12)), u32(63))), u32(8))
                ),
                orBits(
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g1, u32(6)), u32(63))), u32(16)),
                    shl(valuebuilder.byte(ALPHABET, andBits(g1, u32(63))), u32(24))
                )
            )
        )
        valuebuilder.setscratchbytes4(
            scratch,
            add(out, u32(8)),
            orBits(
                orBits(
                    valuebuilder.byte(ALPHABET, andBits(shr(g2, u32(18)), u32(63))),
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g2, u32(12)), u32(63))), u32(8))
                ),
                orBits(
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g2, u32(6)), u32(63))), u32(16)),
                    shl(valuebuilder.byte(ALPHABET, andBits(g2, u32(63))), u32(24))
                )
            )
        )
        valuebuilder.setscratchbytes4(
            scratch,
            add(out, u32(12)),
            orBits(
                orBits(
                    valuebuilder.byte(ALPHABET, andBits(shr(g3, u32(18)), u32(63))),
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g3, u32(12)), u32(63))), u32(8))
                ),
                orBits(
                    shl(valuebuilder.byte(ALPHABET, andBits(shr(g3, u32(6)), u32(63))), u32(16)),
                    shl(valuebuilder.byte(ALPHABET, andBits(g3, u32(63))), u32(24))
                )
            )
        )

        at = add(at, u32(12))
        out = add(out, u32(16))
    end

    while add(at, u32(3)) <= length do
        local b0 = valuebuilder.byte(source, at)
        local b1 = valuebuilder.byte(source, add(at, u32(1)))
        local b2 = valuebuilder.byte(source, add(at, u32(2)))
        valuebuilder.setscratchbyte(scratch, out, valuebuilder.byte(ALPHABET, shr(b0, u32(2))))
        valuebuilder.setscratchbyte(
            scratch,
            add(out, u32(1)),
            valuebuilder.byte(ALPHABET, orBits(shl(andBits(b0, u32(3)), u32(4)), shr(b1, u32(4))))
        )
        valuebuilder.setscratchbyte(
            scratch,
            add(out, u32(2)),
            valuebuilder.byte(ALPHABET, orBits(shl(andBits(b1, u32(15)), u32(2)), shr(b2, u32(6))))
        )
        valuebuilder.setscratchbyte(scratch, add(out, u32(3)), valuebuilder.byte(ALPHABET, andBits(b2, u32(63))))
        at = add(at, u32(3))
        out = add(out, u32(4))
    end

    local rest = math.u32.sub(length, at)
    if rest == 1 then
        local c0 = valuebuilder.byte(source, at)
        valuebuilder.setscratchbyte(scratch, out, valuebuilder.byte(ALPHABET, shr(c0, u32(2))))
        valuebuilder.setscratchbyte(
            scratch,
            add(out, u32(1)),
            valuebuilder.byte(ALPHABET, shl(andBits(c0, u32(3)), u32(4)))
        )
        valuebuilder.setscratchbyte(scratch, add(out, u32(2)), u32(61))
        valuebuilder.setscratchbyte(scratch, add(out, u32(3)), u32(61))
        out = add(out, u32(4))
    elseif rest == 2 then
        local d0 = valuebuilder.byte(source, at)
        local d1 = valuebuilder.byte(source, add(at, u32(1)))
        valuebuilder.setscratchbyte(scratch, out, valuebuilder.byte(ALPHABET, shr(d0, u32(2))))
        valuebuilder.setscratchbyte(
            scratch,
            add(out, u32(1)),
            valuebuilder.byte(ALPHABET, orBits(shl(andBits(d0, u32(3)), u32(4)), shr(d1, u32(4))))
        )
        valuebuilder.setscratchbyte(
            scratch,
            add(out, u32(2)),
            valuebuilder.byte(ALPHABET, shl(andBits(d1, u32(15)), u32(2)))
        )
        valuebuilder.setscratchbyte(scratch, add(out, u32(3)), u32(61))
        out = add(out, u32(4))
    end

    valuebuilder.stringscratch(builder, scratch, u32(0), out)

    return valuebuilder.finish(builder)
end

--- Publishes `nullValue` rather than a string when the text holds a character
--- outside the alphabet. An `@aot` body has no `error` of its own, and the
--- caller cannot be asked to pre-scan the input without paying for the scan
--- twice, so invalidity leaves through the value and `base64.decode` raises.
@aot
local function decodeAot(text: string, nullValue: any): any
    local length = valuebuilder.len(text)
    local builder = valuebuilder.newsized(nullValue, u32(2), add(length, u32(4)))
    local scratch = valuebuilder.newbytescratch(add(length, u32(4)))

    local padding: uint32 = u32(0)
    if length > 0 then
        if valuebuilder.byte(text, math.u32.sub(length, u32(1))) == 61 then
            padding = u32(1)
        end
        -- A '=' in the third position only pads when the fourth is '=' too;
        -- otherwise the quad is invalid and must reach the alphabet check.
        if padding == 1 and length > 1 and valuebuilder.byte(text, math.u32.sub(length, u32(2))) == 61 then
            padding = u32(2)
        end
    end

    local at: uint32 = u32(0)
    local out: uint32 = u32(0)
    local bad: uint32 = u32(0)
    local whole = length
    if padding > 0 then
        whole = math.u32.sub(length, u32(4))
    end
    while at < whole do
        local a = valuebuilder.byte(INVERSE, valuebuilder.byte(text, at))
        local b = valuebuilder.byte(INVERSE, valuebuilder.byte(text, add(at, u32(1))))
        local c = valuebuilder.byte(INVERSE, valuebuilder.byte(text, add(at, u32(2))))
        local d = valuebuilder.byte(INVERSE, valuebuilder.byte(text, add(at, u32(3))))
        bad = orBits(bad, orBits(orBits(a, b), orBits(c, d)))
        local value = orBits(orBits(shl(a, u32(18)), shl(b, u32(12))), orBits(shl(c, u32(6)), d))
        valuebuilder.setscratchbyte(scratch, out, andBits(shr(value, u32(16)), u32(255)))
        valuebuilder.setscratchbyte(scratch, add(out, u32(1)), andBits(shr(value, u32(8)), u32(255)))
        valuebuilder.setscratchbyte(scratch, add(out, u32(2)), andBits(value, u32(255)))
        at = add(at, u32(4))
        out = add(out, u32(3))
    end

    if padding > 0 then
        local a = valuebuilder.byte(INVERSE, valuebuilder.byte(text, at))
        local b = valuebuilder.byte(INVERSE, valuebuilder.byte(text, add(at, u32(1))))
        local c: uint32 = u32(0)
        if padding == 1 then
            c = valuebuilder.byte(INVERSE, valuebuilder.byte(text, add(at, u32(2))))
            -- The low two bits do not contribute to the final byte. Requiring
            -- them to be zero keeps one canonical encoding for those bytes.
            bad = orBits(bad, shl(andBits(c, u32(3)), u32(6)))
        else
            -- With two padding characters, the low four bits of the second
            -- digit are unused and must be zero for canonical base64.
            bad = orBits(bad, shl(andBits(b, u32(15)), u32(6)))
        end
        bad = orBits(bad, orBits(orBits(a, b), c))
        local value = orBits(orBits(shl(a, u32(18)), shl(b, u32(12))), shl(c, u32(6)))
        valuebuilder.setscratchbyte(scratch, out, andBits(shr(value, u32(16)), u32(255)))
        out = add(out, u32(1))
        if padding == 1 then
            valuebuilder.setscratchbyte(scratch, out, andBits(shr(value, u32(8)), u32(255)))
            out = add(out, u32(1))
        end
    end

    if bad > 63 then
        valuebuilder.null(builder)
    else
        valuebuilder.stringscratch(builder, scratch, u32(0), out)
    end

    return valuebuilder.finish(builder)
end

--- Encodes bytes as standard base64, padded.
---
--- ```nupp
--- assert(bytes.base64encode("Nupp") == "TnVwcA==")
--- ```
--- @param value the bytes to encode
--- @return the encoded text
--- @export
export function base64encode(value: string): string
    return encodeAot(value, false) as string
end

--- Decodes canonical standard base64 with required padding.
---
--- Returns nil and a reason when the text is not canonical padded Base64.
---
--- ```nupp
--- assert(bytes.base64decode("TnVwcA==") == "Nupp")
--- local bytes, reason = bytes.base64decode("TnVwcA")
--- assert(bytes == nil and reason ~= nil)
--- ```
--- @param text the text to decode
--- @return the decoded bytes, or nil when the text is not base64
--- @return why the text is not base64, when it is not
--- @export
export function base64decode(text: string): (string?, string?)
    if #text % 4 ~= 0 then
        return nil, "base64 input length is not a multiple of four"
    end
    local decoded = decodeAot(text, INVALID)
    if decoded == INVALID then
        return nil, "base64 input is not canonical padded base64"
    end

    return decoded as string, nil
end
