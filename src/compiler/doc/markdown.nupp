--[[
The markdown rendering of a module.

This is the format the site also writes beside every page as `llms.txt`, so it
has to read as prose on its own rather than as a degraded version of the HTML.
]]

local stringsMod = require("compiler.doc.strings")
local extractMod = require("compiler.doc.extract")
local urlsMod = require("compiler.doc.urls")

local markdownEscape, markdownCell = stringsMod.markdownEscape, stringsMod.markdownCell
local summaryText = stringsMod.summaryText
local childModules = extractMod.children
local symbolLinkIndex = urlsMod.symbolLinkIndex
local rewriteSymbolLinks = urlsMod.rewriteSymbolLinks

local markdown = {}

-- Where a name reaches what documents it, for the length of one render. `anchors` holds
-- what this document renders, which is what a fragment can reach; `known` holds
-- everything the run documented, so a name this document does not carry is still told
-- apart from one nothing documents at all.
local anchors: compiler.doc.urls.Links? = nil
local known: compiler.doc.urls.Links? = nil

-- Prose an author wrote, as opposed to a signature the parser produced. Only prose is
-- searched for references: a signature is code, and `handlers[name](value)` in one is an
-- index call rather than a link.
local function prose(text: string?): string
    local text = tostring(text or "")
    if not anchors then
        return text
    end

    return rewriteSymbolLinks(text, function(name: string): string?
        return anchors[name] or known and known[name]
    end)
end

-- A table cell holding prose, which is the only kind of cell a reference can appear in:
-- the others hold a name or a type the parser read out of the source.
local function cell(text: string?): string
    return markdownCell(prose(text))
end

local function sectionTitle(kind)
    local names = {
        ["function"] = "Functions",
        method = "Methods",
        variable = "Variables",
        type = "Types",
        record = "Records",
        interface = "Interfaces",
        struct = "Structs",
    }

    return names[kind] or (kind:sub(1, 1):upper() .. kind:sub(2) .. "s")
end

-- Function-typed members document like the functions they are, with their own arguments
-- and results, so they are listed apart from the data fields rather than flattened into
-- one table that has nowhere to put an annotation.
local function splitMembers(members)
    local fields, methods = {}, {}
    for _, member in ipairs(members or {}) do
        local into = member.isFunction and methods or fields
        into[#into + 1] = member
    end

    return fields, methods
end

local function markdownArguments(out, params, heading)
    if #params == 0 then
        return
    end
    out[#out + 1] = heading .. " Arguments"
    out[#out + 1] = ""
    out[#out + 1] = "| Name | Type | Description |"
    out[#out + 1] = "| --- | --- | --- |"
    for _, param in ipairs(params) do
        out[
            #out + 1
        ] = "| `" .. markdownEscape(
            param.name
        ) .. "` | `" .. markdownEscape(param.type) .. "` | " .. cell(param.text) .. " |"
    end
    out[#out + 1] = ""
end

local function markdownReturns(out, returns, heading)
    if #returns == 0 then
        return
    end
    out[#out + 1] = heading .. " Returns"
    out[#out + 1] = ""
    out[#out + 1] = "| Type | Description |"
    out[#out + 1] = "| --- | --- |"
    for _, value in ipairs(returns) do
        out[#out + 1] = "| `" .. markdownEscape(value.type) .. "` | " .. cell(value.text) .. " |"
    end
    out[#out + 1] = ""
end

-- A raise is a condition and nothing else. There is no type to put beside it, so this
-- lists where an argument or a result tabulates.
local function markdownRaises(out, raises, heading)
    if #raises == 0 then
        return
    end
    out[#out + 1] = heading .. " Raises"
    out[#out + 1] = ""
    for _, condition in ipairs(raises) do
        out[#out + 1] = "- " .. cell(condition)
    end
    out[#out + 1] = ""
end

local function renderMarkdownItem(out, item)
    out[#out + 1] = '<a id="' .. item.path .. '"></a>'
    out[#out + 1] = "### `" .. item.name .. "` _" .. item.kind .. "_"
    out[#out + 1] = ""
    -- What it is, then how it is spelled: the prose says whether this is the
    -- declaration you are looking for, and the signature answers how to call it once
    -- you know that it is.
    if item.doc.text ~= "" then
        out[#out + 1] = prose(item.doc.text)
        ;
        out[#out + 1] = ""
    end
    out[#out + 1] = "```nupp"
    out[#out + 1] = item.signature
    out[#out + 1] = "```"
    out[#out + 1] = ""
    if #item.typeargs > 0 then
        out[#out + 1] = "#### Type parameters"
        out[#out + 1] = ""
        out[#out + 1] = "| Name | Description |"
        out[#out + 1] = "| --- | --- |"
        for _, typearg in ipairs(item.typeargs) do
            out[#out + 1] = "| `" .. markdownEscape(typearg.name) .. "` | " .. cell(typearg.text) .. " |"
        end
        out[#out + 1] = ""
    end
    markdownArguments(out, item.params, "####")
    markdownReturns(out, item.returns, "####")
    markdownRaises(out, item.raises, "####")
    local fields, methods = splitMembers(item.members)
    if #methods > 0 then
        out[#out + 1] = "#### Methods"
        out[#out + 1] = ""
        for _, method in ipairs(methods) do
            out[#out + 1] = '<a id="' .. method.path .. '"></a>'
            out[#out + 1] = "##### `" .. method.name .. "`"
            out[#out + 1] = ""
            if method.text ~= "" then
                out[#out + 1] = prose(method.text)
                out[#out + 1] = ""
            end
            out[#out + 1] = "```nupp"
            out[#out + 1] = method.name .. ": " .. method.type
            out[#out + 1] = "```"
            out[#out + 1] = ""
            markdownArguments(out, method.params, "######")
            markdownReturns(out, method.returns, "######")
            markdownRaises(out, method.raises, "######")
        end
    end
    if #fields > 0 then
        out[#out + 1] = "#### Fields"
        out[#out + 1] = ""
        out[#out + 1] = "| Name | Type | Description |"
        out[#out + 1] = "| --- | --- | --- |"
        for _, field in ipairs(fields) do
            out[
                #out + 1
            ] = "| `" .. markdownEscape(
                field.name
            ) .. "` | `" .. markdownEscape(field.type) .. "` | " .. cell(field.text) .. " |"
        end
        out[#out + 1] = ""
    end
end

--- Renders modules as one markdown document.
---
--- `all` is every module the run documented. A page renders one module at a time but
--- still has to name the ones nested under it, and only the whole set says which those
--- are; rendering the whole set at once, as `nupp doc markdown` does, is the case where
--- the two arguments are the same list.
function markdown.render(
    modules: {compiler.doc.extract.Module},
    title: string?,
    all: {compiler.doc.extract.Module}?
): string
    local all = all or modules
    anchors = symbolLinkIndex(modules, function(module: string, path: string?): string
        return "#" .. (path or module)
    end)
    known = symbolLinkIndex(all, function(): string
        return ""
    end)
    local out = {}
    if title and title ~= "" then
        out[#out + 1] = "# " .. title
        ;
        out[#out + 1] = ""
    end
    for moduleIndex, module in ipairs(modules) do
        out[#out + 1] = '<a id="' .. module.name .. '"></a>'
        out[#out + 1] = (module.namespace and "# Namespace: `" or "# Module: `") .. module.name .. "`"
        out[#out + 1] = ""
        if module.namespace then
            out[#out + 1] = "Modules nested under `" .. module.name .. "`. Nothing is required by this name itself."
            out[#out + 1] = ""
        elseif module.text ~= "" then
            out[#out + 1] = prose(module.text)
            ;
            out[#out + 1] = ""
        end
        local children = childModules(all, module.name)
        if #children > 0 then
            out[#out + 1] = "## Modules"
            out[#out + 1] = ""
            out[#out + 1] = "| Module | Description |"
            out[#out + 1] = "| --- | --- |"
            for _, child in ipairs(children) do
                -- A child is linked only where this document also renders it. One
                -- module's markdown names its children without holding them.
                local label = "`" .. markdownEscape(child.name) .. "`"
                local anchor = anchors and anchors[child.name]
                local held = #childModules(all, child.name)
                local description = child.namespace
                    and held .. " module" .. (held == 1 and "" or "s")
                    or markdownCell(summaryText(child.text))
                out[
                    #out + 1
                ] = "| " .. (
                    anchor and "[" .. label .. "](" .. anchor .. ")" or label
                ) .. " | " .. description .. " |"
            end
            out[#out + 1] = ""
        end
        local currentKind = nil
        for _, item in ipairs(module.items) do
            if item.kind ~= currentKind then
                currentKind = item.kind
                out[#out + 1] = "## " .. sectionTitle(item.kind)
                out[#out + 1] = ""
            end
            renderMarkdownItem(out, item)
        end
        if moduleIndex < #modules then
            out[#out + 1] = "---"
            ;
            out[#out + 1] = ""
        end
    end
    anchors, known = nil, nil

    return table.concat(out, "\n") .. "\n"
end

return markdown
