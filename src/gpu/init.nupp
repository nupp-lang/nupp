module gpu

--[[
`gpu` manages resident compute buffers over the selected GPU provider.

The context owns every buffer, compiled kernel and binding made from it. Each
is closeable and borrows the context, so checked code cannot close the device
while one is live, or use one after closing it. Uploads, dispatches, and
downloads only enqueue commands; `synchronize()` is the explicit CPU boundary.
`gpu.available()` says whether a device can be opened at all, since `open`
raises when none can.

```nupp:fragment
local gpu = require("gpu")
local array = nupp.mem.array
local kernels = require("kernels")

do
    local context = gpu.open()
    do
        local input = context:buffer(array.float, 1024)
        local output = context:buffer(array.float, 1024)
        do
            local kernel = kernels.scale:compile(context)
            do
                local scale = kernel:bind(output, input)
                context:upload(input, values:read())
                scale:dispatch(2.0)
            end
        end
        context:enqueuedownload(output)
        context:synchronize()
        context:readdownloaded(output, result:write())
    end
end
```

Here `kernels.scale` is generated from an `@aot(target = "gpu")` function by a
target with `aot = "require"`. Shader source, entrypoint identity, binding order
and uniform packing remain compiler details. Ordinary spans are the CPU
boundary; a chain of kernels keeps its intermediate buffers resident and pays
upload/download only where the program asks for them.

`context:tensor(element, shape)` allocates dense row-major storage. A checked
`gpu.Layout` can be sliced, transposed, broadcast, or explicitly strided, then
applied with `buffer:view(layout)` without allocating device storage.
Transfers remain dense; layout-aware kernels consume the explicit metadata.
]]

local spi = require("nupp.runtime.packages")
local target = require("nupp.runtime.target")

local api = require("nupp.gpu.api")
local implementation = require("nupp.gpu.types")
local contract = require("gpu.spi")
local provider: contract.Provider = do
    const chosen = spi.select(spi.providers<contract.Provider>("gpu.spi.Provider"))
    if chosen ~= nil then
        yield chosen
    end
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativegpu") as contract.Provider
    end
    yield _G.require("nupp.runtime.browser.webgpu.internal") as contract.Provider
end
local operations = require("nupp.gpu.operations")
local tensorlayout = require("gpu.layout")

export type Layout = tensorlayout.Layout
export const Layout = tensorlayout.Layout
export type Buffer<T> = api.Buffer<T>
export type Shared<T> = api.Shared<T>
export type Phases = api.Phases
export type Context = api.Context
export const portableworkgroupthreads = implementation.PORTABLE_WORKGROUP_THREADS
export const portablescratchbytes = implementation.PORTABLE_SCRATCH_BYTES
export const workgroups: function(
    groups: uint32,
    size: uint32,
    scoped controller: function(uint32, api.Phases): nil
): nil = operations.workgroups

--- Reports whether the selected provider can open a compute device now.
---
--- `open` raises when none can, so ask this first where a program has another
--- way to run. Checking availability opens and closes a device.
export const available: function(): boolean = provider.available

--- Opens a compute device through the selected provider.
export const open: function(): api.Context = provider.open
