--[[
`warn` joins its arguments and sends warnings through `debug.log`'s sink and
formatter.
Warnings start enabled; `warn("@off")` disables them and `warn("@on")` enables them.

```nupp
warn("cannot read ", "settings.json")
```
]]
module warn

local log = require("debug.log")

export = rawget(log, "__nuppwarn") as function(message: string, ...: string): nil
