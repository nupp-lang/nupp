--[[
`warn` joins its arguments and sends warnings through `debug.log`'s sink and
formatter.
Warnings start enabled; `warn("@off")` disables them and `warn("@on")` enables them.

```nupp
warn("cannot read ", "settings.json")
```
]]
module warn

local log = require("debug.log")
local output = log.formodule("warn")
local enabled = true

local function argument(value: any, index: integer): string
    if type(value) == "string" then
        return value
    elseif type(value) == "number" then
        return tostring(value)
    end
    error(("bad argument #%d to 'warn' (string expected, got %s)"):format(index, type(value)), 3)
end

--- Joins messages and emits a warning, or applies a single control string.
local function warning(message: string, ...: string): nil
    local parts = {argument(message, 1)}
    for index = 1, select("#", ...) do
        parts[index + 1] = argument(select(index, ...), index + 1)
    end
    if #parts == 1 and parts[1]:sub(1, 1) == "@" then
        if parts[1] == "@on" then
            enabled = true
        elseif parts[1] == "@off" then
            enabled = false
        end
        return
    end
    if enabled then
        output.emit(2, 0, table.concat(parts))
    end
end

rawset(_G, "warn", warning)
export = warning
