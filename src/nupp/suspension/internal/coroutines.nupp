@!internal
module nupp.suspension.internal.coroutines

local rawCoroutine = require("nupp.runtime.rawcoroutine")

export function localMap(_: string): any
    return setmetatable({}, {__mode = "k"})
end

export function localState(_: string, initialize: function(): any): any
    return initialize()
end

export function create(body: any, ...: any): thread
    return rawCoroutine.create(body, ...)
end
