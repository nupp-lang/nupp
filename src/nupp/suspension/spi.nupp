module nupp.suspension.spi

--[[
Shared interfaces for scheduler integration.

Importing these declarations initializes no scheduler.
The facade retains the selected functions. Source, Context, Waiting, Handler,
and Installed are the shared types; providers initialize these declarations or
satisfy their exact signatures without replacing their nominal identities.

Each record declares what its holder may read and nothing else. Whatever state an
implementation needs beside that is its own, kept where callers cannot reach it,
so two implementations may represent a source or an installation differently and
neither has to reproduce the other's layout.

A subscription may resume synchronously or later. It must settle a Waiting only
once and run returned cleanup when the wait ends, including cancellation.
`Waiting.onResume` is settle-safe: registering a waker on a wait that has already
settled runs it immediately. Source release and Installed close must not suspend.
Nested installation restores the captured handler, and a driver installation
preserves delegation to the outer scheduler. `create` propagates the suspension
context into a new coroutine.

Sources report readiness in `order`, lowest first. Context.uses identifies sources
needed by a wait. Whether a park is permitted here is `canSuspend`, which answers
for the handler in force. Cancellation values must come from
[](nupp.suspension.cancellation), which preserves recognition by tasks and
worker providers. State belongs to one Lua state; registrations and handlers are
not copied into worker lanes.
]]

--- Readiness registration shared with callers and handlers.
--- release must be idempotent and non-suspending; provider state tracks its lifetime.
export record Source
    --- Unregisters this source without suspending; repeated calls are harmless. The
    --- provider supplies it with the registration.
    release: @nosuspend function(self: Source): nil

    --- Diagnostic identity of the readiness source.
    name: string

    --- Where in a poll pass this source runs; smaller orders are polled first.
    order: integer

    --- Optional bounded blocking waiter receiving milliseconds and returning progress.
    wait: (function(integer): integer)?

    --- Optional predicate deciding whether the source has outstanding work.
    active: (function(source: Source): boolean)?
end

--- Subscription context used to register or associate readiness sources.
--- A subscription may use an existing Source or create a scoped one.
export record Context
    --- Registers a source associated with this subscription, as
    --- [](nupp.suspension.spi.Provider.source) registers one outside any.
    source: function(
        self: Context,
        name: string,
        order: integer,
        poll: function(): integer,
        wait: (function(integer): integer)?,
        active: (function(source: Source): boolean)?
    ): Source

    --- Associates an existing source with this wait without changing its identity.
    uses: function(self: Context, source: Source): nil
end

--- A single pending operation observed by a suspension handler.
--- ready is monotonic once resumed; onResume installs the handler's wake callback.
export record Waiting
    --- Reports whether the subscription has settled.
    ready: function(self: Waiting): boolean

    --- Registers a wake callback for the waiting scheduler.
    ---
    --- Settle-safe: where the wait has already settled, `wake` is called before this
    --- returns rather than stored. A handler may therefore arm once and then yield
    --- until `ready` answers true, without a recheck loop around the arming.
    onResume: function(self: Waiting, wake: function(): nil): nil

    --- Diagnostic operation name supplied to suspend.
    operation: string
end

--- Scheduler integration operations with explicit Handler receivers.
--- park drives or yields a wait; shutdown releases handler-owned scheduling state.
export record Handler
    --- Parks or drives this Waiting; `cleanup` cancels the subscription.
    park: function(self: Handler, waiting: Waiting, cleanup: function(): nil): nil

    --- Reports whether this handler can park the current execution.
    canPark: function(self: Handler): boolean

    --- Releases scheduling state owned by this handler.
    shutdown: function(self: Handler): nil
end

--- Handler restoration state owned by an installation.
--- Closing it restores the outer context and releases registration state.
export record Installed is nupp.Closeable
    --- Restores the outer handler and settles every park this installation accepted,
    --- without suspending. The provider supplies it with the installation; a drain
    --- that fails leaves the installation to be closed again.
    close: @nosuspend function(takes self: Installed): nil

    --- Handler supplied by the caller.
    handler: Handler
end

--- Typed subscription operation preserving the result type T.
--- The subscription returns optional cleanup and may resume synchronously.
export type Suspend = function<T>(operation: string, subscribe: function(function(T), Context): (function()?)): T

--- Coroutine construction preserving arbitrary argument and result packs.
export type Create = function<A..., R...>(body: function(A...): R...): thread

export interface Provider
    @readonly priority: integer?

    --- Registers a named poll source with a poll order and optional blocking waiter.
    --- The optional active predicate controls whether the source can make progress.
    @readonly source: function(
        name: string,
        order: integer,
        poll: function(): integer,
        wait: (function(integer): integer)?,
        active: (function(Source): boolean)?
    ): Source

    --- Polls registered sources and returns the amount of progress reported.
    @readonly poll: function(): integer

    --- Subscribes once, then waits for a typed result through the active handler.
    @readonly suspend: Suspend

    --- Installs a host's handler and returns affine restoration state.
    @readonly install: function(handler: Handler): affine(Installed)

    --- Installs a driver's handler, which stands in front of a host rather than being
    --- one: a task scope opened in a frame installs one so the frame's own waits keep
    --- its children running, and it does not bound a host turn where no host is
    --- beneath it.
    @readonly installDriver: function(handler: Handler): affine(Installed)

    --- Creates a coroutine preserving the active suspension context and result pack.
    @readonly create: Create

    --- Reports whether an installed handler owns the current suspension context.
    @readonly handled: function(): boolean

    --- Reports whether this execution context can perform a suspension.
    @readonly canSuspend: function(): boolean

    --- Captures the barrier in force here, for a driver about to displace it.
    ---
    --- A driver's handler changes where a branch yields and must not quietly grant
    --- permission the handler it displaced refused, so a driver takes this before it
    --- installs and answers `canPark` with it. Resolved when called rather than where
    --- captured, because a host enters and leaves barriers while a driver is live.
    @readonly delegatedCanPark: function(): function(): boolean

    --- Captures how a wait is parked here, for a driver about to displace it.
    ---
    --- A driver runs its own work while a frame waits and hands what it cannot
    --- satisfy to the handler it displaced, or to the blocking park where there is
    --- none. Captured like `delegatedCanPark`, and resolved when called.
    @readonly delegatedPark: function(): function(Waiting, function(): nil): nil

    --- Builds a Waiting that settles when `base` does or when `ready` answers true.
    ---
    --- A driver parks outward on the result, so the park it hands to its host is
    --- woken both by the wait it was given and by its own work becoming runnable.
    --- `arm` registers the driver's own wakers and receives the same callback `base`
    --- is armed with, which runs at most once per registration. Whatever routing
    --- state `base` carries travels with the derived wait, so a blocking park on it
    --- reaches the readiness sources the original named.
    @readonly derive: function(
        base: Waiting,
        ready: function(): boolean,
        arm: function(wake: function(): nil): nil
    ): Waiting

    --- Whether the aggregate running here may spend another coroutine activation
    --- before it owes its host a turn.
    ---
    --- Turn budgeting is an implementation's to offer: absent, the three leave the
    --- aggregate turn unbounded, and the facade supplies that reading. An
    --- implementation publishes all three or none.
    @readonly turnAvailable: (function(): boolean)?

    --- Records one coroutine activation against the current turn.
    @readonly consumeTurn: (function(): nil)?

    --- Parks until the host has had its turn.
    @readonly deferTurn: (function(): nil)?
end
