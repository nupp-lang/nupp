module nupp.core.rawbudgetgen

local budget = require("nupp.compiler.vm.coregraphbudget")

-- Projection only. The consumer must still validate every referenced row and
-- use checked cumulative arithmetic before publishing a later admission phase.
export function source(): string
    local policy = budget.policy()
    local lines = {
        "module nupp.runtime.core.rawbudgetpolicy",
        "",
        "-- Generated by nupp.core.rawbudgetgen from coregraphbudget.policy().",
        "-- Exact inflated item/text costs; depth is a conservative bound.",
        "-- These tables confer no SSA or executable-byte authority.",
        ""
    }

    local function constant(name: string, value: integer): nil
        assert(name:match("^[A-Za-z_][A-Za-z0-9_]*$"), "budget constant name")
        assert(value >= 0 and value <= 4294967295 and value % 1 == 0, "budget constant range")
        if lines[#lines] == "end" then
            lines[#lines + 1] = ""
        end
        lines[#lines + 1] = "export const " .. name .. " = " .. tostring(value) .. "ULL"
    end

    for _, name in ipairs({
        "version",
        "itemLimit",
        "textLimit",
        "textItemLimit",
        "depthLimit",
        "integerLimit",
        "maxDepthBound"
    }) do
        constant(name, policy[name])
    end
    lines[#lines + 1] = ""
    for _, recipe in ipairs(policy.recipes) do
        constant("B_" .. recipe.name .. "_items", recipe.items)
        constant("B_" .. recipe.name .. "_bytes", recipe.bytes)
    end

    -- One uint64 contains at most four exact 16-bit lanes. Construct the
    -- literal as hexadecimal text so the host never rounds a 64-bit number.
    -- A larger profile must deliberately extend this representation.
    local function packed(name: string, rows: any): nil
        assert(name:match("^[A-Za-z_][A-Za-z0-9_]*$"), "budget lookup name")
        assert(#rows > 0 and #rows <= 5, "budget lookup word capacity")
        local parts = {}
        for index = math.min(#rows, 4), 1, -1 do
            local row = rows[index]
            assert(row.id == index - 1, "budget lookup IDs must be dense")
            assert(row.value >= 0 and row.value <= 65535 and row.value % 1 == 0, "budget lookup lane overflow")
            parts[#parts + 1] = string.format("%04x", row.value)
        end
        lines[#lines + 1] = ""
        constant(name .. "Count", #rows)
        lines[#lines + 1] = "export function " .. name .. "(id: uint64): uint64"
        lines[#lines + 1] = "    if id >= " .. tostring(#rows) .. "ULL then"
        lines[#lines + 1] = "        return 4294967295ULL"
        lines[#lines + 1] = "    end"
        if #rows == 5 then
            lines[#lines + 1] = "    if id == 4ULL then"
            lines[#lines + 1] = "        return " .. tostring(rows[5].value) .. "ULL"
            lines[#lines + 1] = "    end"
        end
        lines[#lines + 1] = "    local shift = id * 16ULL"
        lines[#lines + 1] = "    if shift >= 64ULL then"
        lines[#lines + 1] = "        return 4294967295ULL"
        lines[#lines + 1] = "    end"
        lines[#lines + 1] = ""
        lines[#lines + 1] = "    return (0x" .. table.concat(parts) .. "ULL >> shift) & 65535ULL"
        lines[#lines + 1] = "end"
    end

    for _, group in ipairs(policy.enums) do
        local rows = {}
        for _, value in ipairs(group.values) do
            rows[#rows + 1] = {id = value.id, value = value.bytes}
        end
        packed(group.name .. "Bytes", rows)
    end
    -- Derive optional-field bit positions from the recipe order, not an
    -- independent opcode/field list. Generated F_* masks identify each bit.
    local recipes, fieldMasks, fieldCount = {}, {}, 0
    local nextBit: integer = 1
    for _, recipe in ipairs(policy.recipes) do
        assert(recipes[recipe.name] == nil, "duplicate budget recipe")
        recipes[recipe.name] = recipe
        local field = recipe.name:match("^termField_([A-Za-z_][A-Za-z0-9_]*)$")
        if field then
            assert(fieldCount < 16 and fieldMasks[field] == nil, "budget optional-field mask overflow")
            fieldMasks[field] = nextBit
            constant("F_" .. field, nextBit)
            fieldCount, nextBit = fieldCount + 1, nextBit * 2
        end
    end
    assert(fieldCount > 0, "missing budget optional fields")
    local items, bytes, masks = {}, {}, {}
    for _, term in ipairs(policy.termFields) do
        local recipe = assert(recipes["term_" .. term.name], "missing budget term recipe")
        local present, mask = {}, 0
        for _, field in ipairs(term.fields) do
            assert(not present[field], "duplicate budget optional field")
            present[field] = true
            mask += assert(fieldMasks[field], "unknown budget optional field")
        end
        constant("T_" .. term.name .. "_id", term.id)
        items[#items + 1] = {id = term.id, value = recipe.items}
        bytes[#bytes + 1] = {id = term.id, value = recipe.bytes}
        masks[#masks + 1] = {id = term.id, value = mask}
    end
    packed("termItems", items)
    packed("termBytes", bytes)
    packed("termOptionalFields", masks)

    -- Section dispatch projects cost bindings, never opcode implementation.
    for _, metric in ipairs({"items", "bytes"}) do
        lines[#lines + 1] = ""
        lines[
            #lines + 1
        ] = "export function section" .. (metric == "items" and "Items" or "Bytes") .. "(id: uint64): uint64"
        for index, section in ipairs(policy.sections) do
            assert(section.id == index - 1)
            local total = 0
            for _, name in ipairs(section.recipes) do
                total += assert(recipes[name])[metric]
            end
            assert(total >= 0 and total <= 65535)
            lines[#lines + 1] = "    " .. (index == 1 and "if" or "elseif") .. " id == " .. section.id .. "ULL then"
            lines[#lines + 1] = "        return " .. total .. "ULL"
        end
        lines[#lines + 1] = "    end"
        lines[#lines + 1] = ""
        lines[#lines + 1] = "    return 4294967295ULL"
        lines[#lines + 1] = "end"
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "export function enumBytes(section: uint64, offset: uint64, id: uint64): uint64"
    for _, section in ipairs(policy.sections) do
        for _, field in ipairs(section.enums) do
            lines[#lines + 1] = "    if section == " .. section.id .. "ULL and offset == " .. field.offset .. "ULL then"
            lines[#lines + 1] = "        return " .. field.group .. "Bytes(id)"
            lines[#lines + 1] = "    end"
        end
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end
