module nupp.core.corecallvaluesgen

local corelibrary = require("nupp.compiler.vm.corelibrary")

-- The prefix of a core call module's name, which its operations' library
-- names (`filecalls.open`) leave off.
const PREFIX = "nupp.runtime."

-- The core call modules' operations as values (nupp.runtime.corecallvalues),
-- from the one table (nupp.compiler.vm.corelibrary): a table per module of
-- functions that make each call. A module instance whose environment does
-- not stand in for such a module calls through these, as it calls through
-- whatever stands in for one.
export function source(): string
    local operations: {[string]: {corelibrary.Operation}} = {}
    local names: {string} = {}
    for _, group in ipairs(corelibrary.groups()) do
        for _, module in ipairs(group.modules) do
            if operations[module] == nil then
                operations[module] = {}
                names[#names + 1] = module
            end
        end
        for _, operation in ipairs(group.operations) do
            local module = string.match(operation.library, "^([%w_]+)%.") as string
            local list = assert(operations[module], "operation of a module its group does not name")
            list[#list + 1] = operation
        end
    end
    table.sort(names)
    local lines = {
        "@!internal",
        "",
        "module nupp.runtime.corecallvalues",
        "",
        "-- Generated by nupp.core.corecallvaluesgen from nupp.compiler.vm.corelibrary.",
        "-- The core call modules' operations as values, by module name: a module",
        "-- instance calls through these where its environment stands in for none.",
        ""
    }
    for _, module in ipairs(names) do
        lines[#lines + 1] = "const " .. module .. " = require(\"" .. PREFIX .. module .. "\")"
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "export const modules: {[string]: {[string]: any}} = {"
    for index, module in ipairs(names) do
        lines[#lines + 1] = "    [\"" .. PREFIX .. module .. "\"] = {"
        local list = operations[module] as {corelibrary.Operation}
        for at, operation in ipairs(list) do
            local member = string.match(operation.library, "%.([%w_]+)$") as string
            local parameters, arguments = {}, {}
            for argument = 1, operation.arguments do
                parameters[argument] = "a" .. tostring(argument) .. ": any"
                arguments[argument] = "a" .. tostring(argument)
            end
            lines[#lines + 1] = "        " .. member .. " = function(" .. table.concat(parameters, ", ") .. "): any"
            lines[
                #lines + 1
            ] = "            return " .. operation.library .. "(" .. table.concat(arguments, ", ") .. ")"
            lines[#lines + 1] = "        end" .. (at < #list and "," or "")
        end
        lines[#lines + 1] = "    }" .. (index < #names and "," or "")
    end
    lines[#lines + 1] = "}"

    return table.concat(lines, "\n") .. "\n"
end
