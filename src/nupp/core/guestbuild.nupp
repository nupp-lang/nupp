module nupp.core.guestbuild

-- Builds a guest program and the core that runs it. The program goes through
-- the checked front end, the program graph and the executable; the guest
-- runtime (handlers, entry, frames and what they call) goes through the
-- service catalog and the unit code cache. The core's own code is tested, not
-- proven (runtime plan, "Direction"): nothing here issues final-frame proofs.
local service = require("nupp.compiler.vm.nativeservice")
local runner = require("nupp.core.unitrunner")
local parser = require("nupp.compiler.syntax.parser")
local lexer = require("nupp.compiler.syntax.lexer")
local checker: any = require("nupp.compiler.check")
local environment: any = require("nupp.compiler.project.env")
local cst = require("nupp.compiler.syntax.cst")
local programgraph = require("nupp.compiler.vm.programgraph")
local scalartypeof = require("nupp.compiler.vm.scalartypeof")
local ownedcallables = require("nupp.compiler.vm.ownedcallables")
local forwardedexports = require("nupp.compiler.vm.forwardedexports")
local derivedrecipes = require("nupp.compiler.vm.derivedrecipes")
local managedcalls = require("nupp.compiler.vm.managedcalls")
local tagged = require("nupp.compiler.vm.taggedprofile")
local executable = require("nupp.compiler.vm.coregraphexecutable")
local corepiece = require("nupp.compiler.vm.corepiece")
local corelink = require("nupp.compiler.vm.corelink")
local piecestore = require("nupp.core.piecestore")
local corelibrary = require("nupp.compiler.vm.corelibrary")
local writer = require("nupp.core.guestartifact")
require("nupp.compiler.hostservices")
-- Processor seconds by phase across this process's builds, for the runner's
-- summary: the runtime's selection, and each program's compile.
export const timings = {} as {[string]: number}

-- The generated modules main requires in case modulesmany: more than the
-- 256 an entry once took, each a chain of calls whose depths sum past the
-- 4096 frames a program once had.
local function manymodules(): {string}
    local list: {string} = {}
    for index = 1, 260 do
        list[index] = ("modulesmany%03d"):format(index)
    end

    return list
end

-- A file's text, or nil when there is none.
local function contents(path: string): string?
    local file = io.open(path, "rb")
    if file == nil then
        return nil
    end
    local text = file:read("a") as string
    file:close()

    return text
end

-- The namespace of the VM's host modules, which the core answers only where
-- `graph.coremodule` maps one.
const VM_HOST_PREFIX = "nupp.vm."

-- Whether `name` is a VM host module the core does not answer.
local function unansweredhost(name: string): boolean
    local graph: any = require("nupp.compiler.vm.graph")

    return name:sub(1, #VM_HOST_PREFIX) == VM_HOST_PREFIX
        and graph.coremodule(name) == name
        and not graph.corecallmodule(name)
end

-- The modules the compiler CLI's image carries beside what its entry requires,
-- as `nupp.tools.vm.project` names them for the image bin/nupp runs: its
-- ROOT_EXTRAS line, read as scripts/vm-cli reads it, so the two cannot drift.
local function cliextras(): {string}
    local root = os.getenv("NUPP_COMPILER_ROOT")
    if root == nil then
        return {}
    end
    local text = assert(contents(root .. "/src/nupp/tools/vm/project.nupp"), "VM project module missing")
    local start = assert(text:find("project.ROOT_EXTRAS = ", 1, true), "ROOT_EXTRAS line missing")
    local stop = assert(text:find("\n\n", start, true), "ROOT_EXTRAS line unterminated")
    local list: {string} = {}
    for name in text:sub(start, stop):gmatch("\"([^\"]*)\"") do
        for module in name:gmatch("[%w%._]+") do
            -- A VM host provider the core replaces is carried as the core's.
            local graph: any = require("nupp.compiler.vm.graph")
            local relative = "src/" .. (graph.coremodule(module) as string):gsub("%.", "/")
            local source = contents(root .. "/" .. relative .. ".nupp")
            if source == nil then
                relative = relative .. "/init"
                source = contents(root .. "/" .. relative .. ".nupp")
            end
            -- A provider over a VM host the core does not answer (compression,
            -- the network, URIs, workers) is one check and build never select.
            local usable = source ~= nil
            for required in (source or ""):gmatch("require%(%s*[\"']([%w%._]+)[\"']%s*%)") do
                usable = usable and not unansweredhost(required)
            end
            if usable then
                list[#list + 1] = relative
            end
        end
    end

    return list
end

