-- The handlers a profile version dispatches, in table order.
local function handlerNames(caseName: string, version: integer): {string}
    local names = {"K", "Nil", "Move", "NewClosure", "CallK", "Ret", "Jmp", "JmpIf", "Invalid"}
    if caseName == "modulePair" or version >= 8 then
        table.insert(names, 2, "Require")
    end
    local introduced: {
        [string]: integer
    } = {
        Add = 3,
        Lt = 4,
        Sub = 6,
        Mul = 6,
        Mod = 6,
        Le = 6,
        Eq = 6,
        NewCell = 7,
        GetCell = 7,
        SetCell = 7,
        GetUpval = 7,
        NewTable = 8,
        GetIdx = 8,
        SetIdx = 8,
        Len = 8,
        MathFloor = 8,
        LibCall = 8,
        Not = 8,
        RetN = 8,
        CallV = 8,
        RetV = 8,
        PCall = 8,
        XPHandle = 8,
        Destroy = 8
    }
    for _, name in ipairs({
        "Add",
        "Lt",
        "Sub",
        "Mul",
        "Mod",
        "Le",
        "Eq",
        "NewCell",
        "GetCell",
        "SetCell",
        "GetUpval",
        "NewTable",
        "GetIdx",
        "SetIdx",
        "Len",
        "MathFloor",
        "LibCall",
        "Not",
        "RetN",
        "CallV",
        "RetV",
        "PCall",
        "XPHandle",
        "Destroy"
    }) do
        if version >= introduced[name] then
            table.insert(names, 2, name)
        end
    end

    return names
end

local function read(path: string): string
    local file = assert(io.open(path, "rb"), "guest build: missing source " .. path)
    local text = file:read("*a")
    file:close()

    return text
end

-- The runtime modules a guest links, beyond the service catalog's own.
local RUNTIME = {
    "arena",
    "frames",
    "context",
    "frameaccess",
    "instances",
    "guestcatalog",
    "guestentry",
    "guestops",
    "guesthandlers",
    "guestscope",
    "coretables",
    "guestloader",
    "chunkadmission"
}

-- One runtime build and selection per mode for the process: every case
-- shares them, and only the program differs. Audited builds add the test-only
-- lifecycle audit leaves, which primary programs must not link.
local runtimes: {[string]: any} = {}
local sessions: {[string]: any} = {}
-- Each case's program, compiled once for the process: the program does not
-- depend on the mode or the audit, and nothing downstream changes it.
local programs: {[string]: any} = {}

local function runtime(mode: string, cacheDirectory: string?, audited: boolean): any
    local kind = audited and "audited" or "primary"
    local held = runtimes[kind .. ":" .. mode]
    if held then
        return held
    end
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local fixtures = {}
    for _, name in ipairs(RUNTIME) do
        fixtures[
            #fixtures + 1
        ] = {moduleName = "nupp.runtime.core." .. name, path = root .. "/src/nupp/runtime/core/" .. name .. ".nupp"}
    end
    -- Every handler is built, so one selection serves every profile version.
    local all = handlerNames("modulePair", 8)
    local roots, handlers = {}, {}
    for _, name in ipairs(all) do
        roots[#roots + 1] = {"nupp.runtime.core.guesthandlers", name}
        handlers["nupp.runtime.core.guesthandlers." .. name] = true
    end
    roots[#roots + 1] = {"nupp.runtime.core.guestentry", "start"}
    roots[#roots + 1] = {"nupp.runtime.core.guestentry", "complete"}
    for _, name in ipairs({"prepare", "open", "close", "finish"}) do
        roots[#roots + 1] = {"nupp.runtime.core.guestscope", name}
    end
    roots[#roots + 1] = {"nupp.runtime.core.guestuncaught", "recover"}
    if audited then
        fixtures[
            #fixtures + 1
        ] = {
            moduleName = "nupp.runtime.core.guestaudit",
            path = root .. "/build/core-guest-audit/source/nupp/runtime/core/guestaudit.nupp",
            include = "build/core-guest-audit/source"
        }
        for _, name in ipairs({"after", "failedPrefix", "stale", "failedStart"}) do
            roots[#roots + 1] = {"nupp.runtime.core.guestaudit", name}
        end
    end
    local began = os.time()
    -- The checked session and catalog serve both modes.
    sessions[kind] = sessions[kind] or service.buildUnits(fixtures, roots, handlers)
    local units = sessions[kind]
    io.stderr:write(("guest runtime session %ds\n"):format(os.time() - began))
    local phases = {}
    local started = os.clock()
    local chosen = runner.select(
        units,
        mode,
        cacheDirectory,
        handlers,
        function(name: string): nil
            phases[#phases + 1] = {name = name, seconds = os.clock() - started}
            io.stderr:write(("guest runtime %s %ds\n"):format(name, os.time() - began))
        end,
        units.session.module("nupp.runtime.core.context")
    )
    local scopes = {}
    for _, name in ipairs(RUNTIME) do
        scopes["nupp.runtime.core." .. name] = units.session.module("nupp.runtime.core." .. name)
    end
    scopes["nupp.runtime.vm.values"] = units.session.module("nupp.runtime.vm.values")
    -- The modules the artifact producer holds to corelibrary's table.
    for _, name in ipairs({"librarycalls", "corestorage"}) do
        scopes["nupp.runtime.core." .. name] = units.session.module("nupp.runtime.core." .. name)
    end
    for _, subject in ipairs(corelibrary.subjects()) do
        if subject.output then
            local name = "nupp.runtime.core." .. subject.output
            scopes[name] = units.session.module(name)
        end
    end
    if audited then
        scopes["nupp.runtime.core.guestaudit"] = units.session.module("nupp.runtime.core.guestaudit")
    end
    local names, metrics = {}, {}
    for name in pairs(chosen.codes) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        local code = chosen.codes[name]
        metrics[
            #metrics + 1
        ] = {
            name = name,
            frameBytes = code.frameBytes,
            spillSlots = code.allocation.spillSlots,
            integerRegisters = code.allocation.integerRegisters,
            floatRegisters = code.allocation.floatRegisters,
            calls = #code.fixupName
        }
    end
    held = {
        codes = chosen.codes,
        owners = chosen.owners,
        scopes = scopes,
        timings = phases,
        metrics = metrics,
        raises = chosen.raises
    }
    runtimes[kind .. ":" .. mode] = held

    return held
end

-- A case names its modules as fixtures (`tests/core`), absolute
-- paths, or library modules under `src/`, which it carries as they are.
local function libraryModule(name: string): boolean
    return name:sub(1, 4) == "src/" or name:find("/src/", 1, true) ~= nil
end

const NATIVE_HOST_LOADER = "nupp.runtime.native"

-- The library module under `src/` that module `name` loads from on the
-- core, or nil when none does: a declaration file, or a host module the
-- core does not answer.
local function librarypath(root: string, name: string): string?
    local graph: any = require("nupp.compiler.vm.graph")
    local relative = (graph.coremodule(name) as string):gsub("%.", "/")
    for _, candidate in ipairs({"src/" .. relative, "src/" .. relative .. "/init"}) do
        local file = io.open(root .. "/" .. candidate .. ".nupp", "rb")
        if file then
            file:close()
            return candidate
        end
    end
    -- A plain Lua module, vendored: named with its extension.
    for _, candidate in ipairs({"src/" .. relative .. ".lua", "src/" .. relative .. "/init.lua"}) do
        local file = io.open(root .. "/" .. candidate, "rb")
        if file then
            file:close()
            return candidate
        end
    end

    return nil
end

-- Whether a source may call `warn` or set a `__gc`: a builder reads it to
-- carry `nupp.runtime.luawarn`, which gives both their Nupp side. A word
-- anywhere counts; carrying it needlessly costs a module that loads first.
local function readswarn(source: string): boolean
    return source:find("__gc", 1, true) ~= nil or source:find("%f[%w_]warn%f[^%w_]") ~= nil
end

-- Lua's loaders, which `nupp.runtime.luaload` carries.
local LOADERS: {[string]: boolean} = {load = true, loadstring = true, loadfile = true, dofile = true}

-- Whether an unchecked tree may call Lua's loaders: a name spelled as one
-- anywhere, a local of that name included. A builder reads it to carry
-- `nupp.runtime.luaload`; carrying it needlessly costs a module.
local function readsload(root: any): boolean
    local found = false
    local walk: function(any): nil
    walk = function(node: any): nil
        if found or type(node) ~= "table" then
            return
        end
        if node.kind == "name" and node.token and LOADERS[node.token.text] then
            found = true
            return
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(root)

    return found
end

-- The `os` functions the core calls itself, which need no library carried.
local COREOS: {[string]: boolean} = {getenv = true, monotonic = true}

-- Whether an unchecked tree may read Lua's `os` library itself:
-- `os.execute`, `os.exit` or `os` as a value, beyond the calls the core
-- makes itself. A builder reads it to carry `nupp.runtime.luaos`.
local function readsos(root: any): boolean
    local found = false
    local walk: function(any): nil
    walk = function(node: any): nil
        if found or type(node) ~= "table" then
            return
        end
        if node.kind == "dotIndex"
            and node.obj
            and node.obj.kind == "name"
            and node.obj.token
            and node.obj.token.text == "os"
        then
            found = node.name == nil or not COREOS[node.name.text]
            return
        end
        if node.kind == "name" and node.token and node.token.text == "os" then
            found = true
            return
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(root)

    return found
end

-- The modules a checked tree loads: its requires, its qualified paths, and
-- the names its source says it requires dynamically.
local function requiredmodules(root: any, source: string, follow: boolean): ({string}, {[string]: boolean})
    local found: {string} = {}
    local dynamic: {[string]: boolean} = {}
    local mandatory: {[string]: boolean} = {}

    local function add(name: string, optional: boolean): nil
        found[#found + 1] = name
        if optional then
            if not mandatory[name] then
                dynamic[name] = true
            end
        else
            mandatory[name] = true
            dynamic[name] = nil
        end
    end

    local walk: function(any): nil
    walk = function(node: any): nil
        if type(node) ~= "table" then
            return
        end
        local graph: any = require("nupp.compiler.vm.graph")
        if node.kind == "call"
            and node.runtimeLoader == "require"
            and type(node.requiredModule) == "string"
            and not node.typeOnlyRequire
        then
            add(node.requiredModule, false)
        elseif follow and graph.dynamicRequire(node) then
            local args = node.args
            local exprs = args and args.exprs or {}
            local argument = #exprs == 1 and not args.str and not args.table and exprs[1] or nil
            local token = argument and (argument.kind == "string" or argument.kind == "dedentString") and argument.token
                or #exprs == 0 and args and not args.table and args.str
            local name = token and lexer.literalstring(token.text, argument ~= nil and argument.kind == "dedentString")
            if name then
                add(name, true)
            end
        end
        if ownedcallables.taking(node) then
            add(ownedcallables.MODULE, false)
        end
        -- A record a derive recipe gives members loads the factory, and
        -- each helper its members call.
        if managedcalls.managing(node) then
            add(managedcalls.MODULE, false)
        end
        if derivedrecipes.derived(node) then
            add(derivedrecipes.MODULE, false)
            for _, helper in ipairs(derivedrecipes.helperModules(node)) do
                add(helper, false)
            end
        end
        -- A library call the core makes itself (`assert(v)`) loads nothing,
        -- whatever module its name is checked through.
        if node.kind == "call" and graph.coreLibraryCall(node) ~= nil then
            for _, argument in ipairs(node.args and node.args.exprs or {}) do
                walk(argument)
            end
            return
        end
        -- A qualified path loads its module only where it is a value; one
        -- naming a type (`io.Writer`) loads nothing, as the graph sees it.
        local projection = programgraph.builtinprojection(node)
        local libraryValue = graph.libraryValue(node)
        if libraryValue == "coroutine.create" or libraryValue == "coroutine.wrap" then
            add(graph.libraryModule(libraryValue), false)
        end
        if projection then
            add(graph.libraryModule(projection.root), false)
            add(projection.module, false)
        elseif node.kind == "dotIndex" and type(node.qualifiedModule) == "string" then
            add(node.qualifiedModule, false)
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(root)
    if #scalartypeof.imports(root) > 0 then
        add(scalartypeof.MODULE, false)
    end
    if follow then
        for list in source:gmatch("@requires%-dynamically ([%w%._, ]+)") do
            for name in list:gmatch("[%w%._]+") do
                add(name, true)
            end
        end
    end

    return found, dynamic
end

-- Whether optional discovery can carry a library module. Known unavailable
-- VM hosts and the versioned native loader make a provider nonportable, even
-- when its loader has source. Mandatory checked dependencies bypass this
-- filter.
local function portable(root: string, library: string, seen: {[string]: boolean}?): boolean
    local graph: any = require("nupp.compiler.vm.graph")
    if library == "src/" .. NATIVE_HOST_LOADER:gsub("%.", "/")
        and graph.coremodule(NATIVE_HOST_LOADER) == NATIVE_HOST_LOADER
        and not graph.corecallmodule(NATIVE_HOST_LOADER)
    then
        return false
    end
    local visited = seen or {}
    if visited[library] then
        return true
    end
    visited[library] = true
    local source = read(root .. "/" .. library .. (library:sub(-4) == ".lua" and "" or ".nupp"))
    local parsed = parser.parse(source, root .. "/" .. library)
    if #parsed.errors > 0 then
        return false
    end
    local declared = cst.declaredModule(parsed.root)
    local backend = declared and require("nupp.compiler.native").backend(declared)
    if backend then
        local implementation = librarypath(root, backend)
        if implementation then
            if not portable(root, implementation, visited) then
                return false
            end
        elseif not graph.corecallmodule(backend) then
            return false
        end
    end

    for name in source:gmatch("require%(%s*[\"']([%w%._]+)[\"']%s*%)") do
        local found = librarypath(root, name)
        if found ~= nil then
            if not portable(root, found, visited) then
                return false
            end
        elseif unansweredhost(name) then
            return false
        end
    end

    return true
end

local function modulePath(root: string, name: string): string
    if name:sub(-4) == ".lua" then
        return root .. "/" .. name
    end
    if name:sub(1, 1) == "/" then
        return name .. ".nupp"
    elseif name:sub(1, 4) == "src/" then
        return root .. "/" .. name .. ".nupp"
    end

    return root .. "/tests/core/" .. name .. ".nupp"
end

-- The static sources the runner snapshots and stages, named by their parsed
-- module declarations. Generated and checkout-root cases keep their own paths.
export function fixtures(): {{
    path: string,
    module: string,
    source: string
}}
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local paths: {[string]: boolean} = {}
    for _, case in pairs(CASES) do
        if case.generated ~= true and case.rooted ~= true then
            paths[case.fixture] = true
            -- A library module a case carries is no fixture: it is checked
            -- where it lives.
            for _, name in ipairs(case.modules or {}) do
                if not libraryModule(name) then
                    paths[name] = true
                end
            end
            for _, name in ipairs(case.chunks or {}) do
                paths[name] = true
            end
            for _, name in ipairs(case.instances or {}) do
                paths[name] = true
            end
        end
    end
    local names: {string} = {}
    for name in pairs(paths) do
        names[#names + 1] = name
    end
    table.sort(names)
    local fixtures: {{
        path: string,
        module: string,
        source: string
    }} = {}
    local declared: {[string]: string} = {}
    for _, name in ipairs(names) do
        local path = modulePath(root, name)
        local source = read(path)
        local parsed = parser.parse(source, path)
        assert(#parsed.errors == 0, "guest fixture parse failed: " .. path)
        local module = assert(cst.declaredModule(parsed.root), "guest fixture module required: " .. path)
        assert(declared[module] == nil or declared[module] == source, "conflicting guest fixture module: " .. module)
        declared[module] = source
        fixtures[#fixtures + 1] = {path = "tests/core/" .. name .. ".nupp", module = module, source = source}
    end

    return fixtures
end

-- One project for the process's multi-module programs: the library modules
-- they carry are checked once, not once per case. Its staged fixtures are
-- written before the first case and not changed after.
local sharedProject: any = nil

local function checkedProject(root: string): any
    if sharedProject == nil then
        local incremental: any = require("nupp.compiler.project.incremental")
        require("nupp.compiler.project.projectconfig")
        require("nupp.compiler.hash")
        sharedProject = incremental.new(root, {
            cache = false,
            nativeCompilerServices = false,
            -- Its output is not the build directory the staged sources sit
            -- in, which the project index would leave out, and a qualified
            -- path resolves only modules the index declares. The test runner's
            -- root is the repository's, so the runner checks as `main` there.
            config = {
                include = {"src", "build/core-guest-programs/source", "tests/tools/test/runner"},
                build = {outDir = "build/core-guest-programs/out"},
            }
        })
    end

    return sharedProject
end

-- The checked program catalog for a case: its entry after every module it carries.
local function programCatalog(caseName: string, fixture: string, version: integer): any
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))
    local names = {fixture}
    -- A case's other modules come first, so the modules it requires precede it.
    local declared = CASES[caseName]
    local others = declared and declared.modules
    if others then
        names = {}
        for _, name in ipairs(others) do
            -- A generated case's modules are generated beside it.
            names[#names + 1] = declared ~= nil
                and declared.generated == true
                and root .. "/build/core-guests/generated/" .. name
                or name
        end
        names[#names + 1] = fixture
    end
    -- A program that takes a library function as a value carries the
    -- functions that make those calls, before its entry.
    if version >= 8 then
        local graph: any = require("nupp.compiler.vm.graph")
        local takes = false
        for _, name in ipairs(names) do
            local path = modulePath(root, name)
            takes = takes or graph.mayTakeLibraryValue(parser.parse(read(path), path).root)
        end
        if takes then
            table.insert(names, #names, root .. "/src/nupp/runtime/libraryvalues")
        end
        -- One that reads Lua's `io` or `os` carries the core's, over its
        -- process and file layers and the reactor beneath them.
        local usesio, usesos, useswarn, usesload = false, false, false, false
        for _, name in ipairs(names) do
            local source = read(modulePath(root, name))
            local tree = parser.parse(source, modulePath(root, name)).root
            usesio = usesio or graph.mayUseIo(tree)
            usesos = usesos or readsos(tree)
            useswarn = useswarn or readswarn(source)
            usesload = usesload or readsload(tree)
        end
        if useswarn then
            table.insert(names, #names, "src/nupp/runtime/luawarn")
        end
        -- The loaders read files through Lua's `io`.
        if usesload then
            table.insert(names, #names, "src/nupp/runtime/luaload")
            usesio = true
        end
        if usesio or usesos then
            -- Named as following a require names them, so a program that
            -- also requires one carries it once.
            table.insert(names, #names, "src/nupp/runtime/reactor")
            table.insert(names, #names, "src/nupp/runtime/files")
            table.insert(names, #names, "src/nupp/runtime/processes")
            table.insert(names, #names, "src/nupp/runtime/luaargs")
        end
        if usesio then
            table.insert(names, #names, "src/nupp/runtime/luastreams")
            table.insert(names, #names, "src/nupp/runtime/luaprocess")
            table.insert(names, #names, "src/nupp/runtime/luaio")
        end
        if usesos then
            table.insert(names, #names, "src/nupp/runtime/luatime")
            table.insert(names, #names, "src/nupp/runtime/luaos")
        end
        -- A program using the task surface carries the scheduler.
        local tasks = false
        for _, name in ipairs(names) do
            local path = modulePath(root, name)
            tasks = tasks or graph.mayUseScheduler(parser.parse(read(path), path).root)
        end
        if tasks then
            -- The scheduler waits in the reactor, which a program reading
            -- `io` or `os` carries already.
            if not (usesio or usesos) then
                table.insert(names, #names, "src/nupp/runtime/reactor")
            end
            table.insert(names, #names, root .. "/src/nupp/runtime/scheduler")
        end
    end
    local staged = root .. "/build/core-guest-programs/source"
    local project: any = nil
    if #names > 1 or declared ~= nil and declared.follow == true then
        project = checkedProject(root)
    end
    local modules = {}
    local moduleName = ""
    local follow = declared ~= nil and declared.follow == true
    local carried: {[string]: boolean} = {}
    local entry: any = nil
    local queue: {string} = {}

    local function enqueue(name: string): nil
        -- Synthetic and followed dependencies may spell the same source
        -- absolutely or relative to the compiler root. Check it only once.
        local path = modulePath(root, name)
        if not carried[path] then
            carried[path] = true
            queue[#queue + 1] = name
        end
    end

    for _, name in ipairs(names) do
        enqueue(name)
    end
    local at: integer = 1
    local forwarding = false
    while at <= #queue or not forwarding do
        if at > #queue then
            -- A program a require cycle re-enters carries the factory of the
            -- forwarders its cyclic modules publish, checked as the rest is.
            forwarding = true
            local present: {any} = {}
            for _, module in ipairs(modules) do
                present[#present + 1] = module
            end
            present[#present + 1] = assert(entry, "guest entry module missing")
            if next(forwardedexports.cyclic(present)) ~= nil then
                enqueue("src/" .. forwardedexports.MODULE:gsub("%.", "/"))
            end
        else
            local name = queue[at]
            at = at + 1
            local path = modulePath(root, name)
            local source = read(path)
            local parsed = parser.parse(source, path)
            assert(#parsed.errors == 0, "guest source parse failed: " .. name)
            -- A library module may be named by its path alone.
            local named = cst.declaredModule(parsed.root)
            local rooted = name == fixture and declared ~= nil and declared.rooted == true
            if named == nil and rooted then
                named = assert(declared).module
            elseif named == nil and libraryModule(name) then
                named = (name:match("src/(.*)$") as string):gsub("%.lua$", ""):gsub("/init$", ""):gsub("/", ".")
            end
            local declared = assert(named, "guest module declaration required: " .. name)
            local diagnostics
            if project then
                -- A fixture is checked as its staged copy; a library module
                -- the program carries, where it lives.
                if not libraryModule(name) and not rooted then
                    path = staged .. "/" .. declared:gsub("%.", "/") .. ".nupp"
                    assert(read(path) == source, "staged guest source differs: " .. name)
                end
                local checked = project.checkFile(path)
                parsed, diagnostics = assert(checked.result, "checked guest result required"), checked.diags
            else
                local env = environment.new(root, {memoryOnly = true, cache = false, nativeCompilerServices = false})
                diagnostics = checker.check(parsed, path, env, {
                    moduleName = declared,
                    strict = false,
                    lints = {["unused-binding"] = "off"}
                })
            end
            for _, diagnostic in ipairs(diagnostics) do
                assert(
                    diagnostic.severity ~= "error",
                    path .. ":" .. tostring(diagnostic.line) .. ": " .. diagnostic.msg
                )
            end
            -- A plain Lua module is named by its path, as `require` finds it.
            local named: any = parsed
            if named.moduleName == nil and name:sub(-4) == ".lua" then
                named.moduleName = declared
            end
            local module = {name = declared, path = path, parsed = parsed, diagnostics = diagnostics}
            if name == fixture then
                entry = module
            else
                modules[#modules + 1] = module
            end
            do
                -- Checked value dependencies are mandatory in every profile. Only
                -- Carried libraries retain their declared and literal dynamic
                -- dependencies. The case flag controls discovery in fixture code.
                local required, dynamic = requiredmodules(parsed.root or parsed, source, follow or libraryModule(name))
                for _, name in ipairs(required) do
                    local library = librarypath(root, name)
                    if library and (not dynamic[name] or portable(root, library)) then
                        enqueue(library)
                    end
                end
                -- What it carries may take a library function as a value, read
                -- from one unchecked tree.
                local unchecked = parser.parse(source, path).root
                local values = root .. "/src/nupp/runtime/libraryvalues"
                local graph: any = require("nupp.compiler.vm.graph")
                if graph.mayTakeLibraryValue(unchecked, version >= 8) then
                    enqueue(values)
                end
                -- And it may read Lua's `io` or `os`, which the core carries as
                -- modules.
                local luaio = "src/nupp/runtime/luaio"
                if graph.mayUseIo(unchecked) then
                    enqueue(luaio)
                end
                local luaos = "src/nupp/runtime/luaos"
                if readsos(unchecked) then
                    enqueue(luaos)
                end
                local luawarn = "src/nupp/runtime/luawarn"
                if readswarn(source) then
                    enqueue(luawarn)
                end
            end
            local luaload = "src/nupp/runtime/luaload"
            if readsload(parser.parse(source, path).root) then
                enqueue(luaload)
            end
        end
    end
    -- The entry is last, after the modules it requires.
    modules[#modules + 1] = assert(entry, "guest entry module missing")
    moduleName = entry.name
    local catalog = programgraph.describe(modules, moduleName)
    -- What a kept piece is keyed by: what each module's check read.
    catalog.checkedProject = project
    -- A fixture exports `result`, which is what its program answers.
    catalog.entryExport = "result"

    return catalog
end

local function profileFor(version: integer): any
    return version >= 5 and tagged.forVersion(version) or tagged
end

-- Where two executables first differ, or nil when they are the same data. A
-- linked executable carries its semantic graphs and contracts in its pieces,
-- so those are left out.
local function difference(actual: any, expected: any, path: string): string?
    if type(actual) ~= type(expected) then
        return path .. ": " .. type(actual) .. " for " .. type(expected)
    elseif type(actual) ~= "table" then
        if actual == expected and (type(actual) ~= "number" or math.type(actual) == math.type(expected)) then
            return nil
        end
        return path .. ": " .. tostring(actual) .. " for " .. tostring(expected)
    end
    for key, item in pairs(expected as table) do
        if not (path == "executable.semantic" and (key == "graphs" or key == "contracts")) then
            local found = difference((actual as table)[key], item, path .. "." .. tostring(key))
            if found then
                return found
            end
        end
    end
    for key in pairs(actual as table) do
        if (expected as table)[key] == nil then
            return path .. "." .. tostring(key) .. ": unexpected"
        end
    end

    return nil
end

-- The piece store of checked catalog `p` and each module's key in it, or nil.
-- Keys are read from the checked program before anything lowers it: lowering
-- fills in facts of the types it reads (a function type's partition results),
-- which the interfaces a key covers would then spell differently.
local function pieceKeys(p: any): (any, {string?})
    local began = os.clock()
    local store = piecestore.open(assert(os.getenv("NUPP_COMPILER_ROOT")), p, p.checkedProject)
    local keys: {string?} = {}
    if store then
        for index in ipairs(p.modules) do
            keys[index] = store.key(index)
        end
    end
    timings["compile piece store"] = (timings["compile piece store"] or 0) + os.clock() - began

    return store, keys
end

-- A v8 program's pieces in program order, and how many were kept ones: each
-- module's from `store` under its key in `keys` when it holds one (unless
-- `fresh`), the rest compiled and kept. A kept piece that is not this module's
-- is a miss.
local function piecesOf(catalog: any, profile: any, store: any, keys: {string?}, fresh: boolean): ({any}, integer)
    local began = os.clock()
    local state = corepiece.program(catalog, profile)
    local pieces: {any} = {}
    local reused: integer = 0
    local stored: number = 0.0
    for index in ipairs(catalog.modules) do
        local looked = os.clock()
        local kept = not fresh and keys[index] ~= nil and store.lookup(keys[index]) or nil
        stored += os.clock() - looked
        if kept ~= nil and pcall(corepiece.adopt, state, index, kept) then
            pieces[index] = kept
            reused += 1
        else
            corepiece.start(state, index)
        end
    end
    for index in ipairs(catalog.modules) do
        if pieces[index] == nil then
            pieces[index] = corepiece.finish(state, index)
            if keys[index] ~= nil then
                local keeping = os.clock()
                store.keep(keys[index], pieces[index])
                stored += os.clock() - keeping
            end
        end
    end
    if store then
        store.close()
    end
    timings["compile piece store"] = (timings["compile piece store"] or 0) + stored
    timings["compile pieces"] = (timings["compile pieces"] or 0) + os.clock() - began - stored

    return pieces, reused
end

-- The checked program for a case, compiled to the core executable. A v8
-- program is compiled a module at a time, reusing kept pieces, and linked;
-- NUPP_GUEST_PIECES=compare also compiles it whole and requires the two to be
-- the same.
local function compileProgram(caseName: string, fixture: string, version: integer): any
    local began = os.clock()
    local catalog = programCatalog(caseName, fixture, version)
    local described = os.clock()
    timings["compile catalog"] = (timings["compile catalog"] or 0) + described - began
    local profile = profileFor(version)
    if version ~= corepiece.VERSION then
        return executable.fromChecked(programgraph.compile(catalog, profile), version)
    end
    local store, keys = pieceKeys(catalog)
    local pieces, reused = piecesOf(catalog, profile, store, keys, false)
    io.stderr:write(("guest pieces: %s reused %d of %d\n"):format(caseName, reused, #pieces))
    local built = os.clock()
    local entry = catalog.modules[#catalog.modules].name
    local ok, result = pcall(corelink.link, pieces, entry)
    if not ok and reused > 0 then
        -- A kept piece no longer links: what it read of another module, a
        -- callee's signature or an initializer's result, has changed. Every
        -- module is compiled again, so what is refused is what a fresh
        -- build refuses.
        io.stderr:write("guest pieces: compiling ", caseName, " afresh: ", tostring(result), "\n")
        pieces = piecesOf(catalog, profile, store, keys, true)
        result = corelink.link(pieces, entry)
    elseif not ok then
        error(result, 0)
    end
    local linked = result
    timings["compile link"] = (timings["compile link"] or 0) + os.clock() - built
    if os.getenv("NUPP_GUEST_PIECES") == "compare" then
        local linkedAt = os.clock()
        local whole = executable.fromChecked(programgraph.compile(catalog, profile), version)
        timings["compile whole"] = (timings["compile whole"] or 0) + os.clock() - linkedAt
        local found = difference(linked, whole, "executable")
        assert(found == nil, "linked " .. caseName .. " differs from its whole-program build at " .. tostring(found))
    end

    return linked
end

-- A case's program alone, compiled to the core executable, without the
-- runtime a guest links: what a builder reads to see what the core refuses.
local function caseFixture(case: any): string
    local root = assert(os.getenv("NUPP_COMPILER_ROOT"))

    return case.rooted == true and root .. "/" .. case.fixture
        or case.generated == true and root .. "/build/core-guests/generated/" .. case.fixture
        or case.fixture
end

export function program(caseName: string): any
    local case = assert(CASES[caseName], "unknown guest case: " .. caseName)

    return compileProgram(caseName, caseFixture(case), case.version)
end

-- Everything that keeps a case's program from compiling for the core, gathered
-- across its whole closure rather than stopping at the first refusal.
export function inventory(caseName: string): any
    local case = assert(CASES[caseName], "unknown guest case: " .. caseName)
    local catalog = programCatalog(caseName, caseFixture(case), case.version)

    return programgraph.inventory(catalog, profileFor(case.version))
end

-- Fixture `name` compiled at profile `version` as a binary chunk's program:
-- a program of its own, which a case loads (`chunks`).
export function chunk(name: string, version: integer): any
    local compiled = programs[name]
    if compiled == nil then
        compiled = compileProgram(name, name, version)
        programs[name] = compiled
    end

    return compiled
end

-- The modules a case names beside its entry, as written for a generated case.
export function modules(caseName: string): {string}
    local case = assert(CASES[caseName], "unknown guest case: " .. caseName)

    return case.modules or {}
end

-- The graph profile version a named case compiles at; generated oracle
-- programs are v8.
export function version(caseName: string): integer
    local case = CASES[caseName]
    if case == nil and caseName:match("^generated%d+$") then
        return 8
    end

    return assert(case, "unknown guest case: " .. caseName).version
end

-- A guest build in the shape guestshim takes: the program executable, the
-- runtime's selected code by qualified name, and the scopes whose layouts
-- the shim and artifact writer read.
export function guest(caseName: string, mode: string, cacheDirectory: string?, audited: boolean?): any
    -- Generated oracle programs (tests/core/guests/oracle.lua) live under build.
    local case = CASES[caseName]
    if case == nil and caseName:match("^generated%d+$") then
        case = {
            fixture = assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/build/core-guests/generated/" .. caseName,
            version = 8
        }
    end
    if case ~= nil and case.rooted == true then
        case = {fixture = assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/" .. case.fixture, version = case.version}
    elseif case ~= nil and case.generated == true then
        case = {
            fixture = assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/build/core-guests/generated/" .. case.fixture,
            version = case.version
        }
    end
    case = assert(case, "unknown guest case: " .. caseName)
    local began = os.clock()
    -- Refuse invalid guest source before preparing the native runtime.
    -- Keyed by the entry's text too: a generated case may be rewritten.
    local fixturePath = (case.fixture as string):sub(1, 1) == "/" and case.fixture .. ".nupp"
        or assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/tests/core/" .. case.fixture .. ".nupp"
    local key = caseName .. "\0" .. read(fixturePath)
    local cached = programs[key]
    if cached == nil then
        cached = compileProgram(caseName, case.fixture, case.version)
        programs[key] = cached
    end
    -- Its chunks compile before the runtime's selection, as its program
    -- does: a chunk checked after the runtime's session is refused.
    for _, name in ipairs(case.chunks or {}) do
        chunk(name, case.version)
    end
    -- Its chunks, each written as `<fixture>.chunk`: first its module
    -- instance chunks, compiled as the core compiles a module's source for an
    -- instance.
    local chunks: {{
        name: string,
        bytes: string
    }} = {}
    local corechunk: any = case.instances and require("nupp.compiler.vm.corechunk")
    if corechunk then
        -- Its instance fixtures may require other fixtures, staged here.
        corechunk.checkingRoot(assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/build/core-guest-programs/source")
    end
    for _, name in ipairs(case.instances or {}) do
        local display = "tests/core/" .. name .. ".nupp"
        local bytes, problem = corechunk.compileModule(
            read(assert(os.getenv("NUPP_COMPILER_ROOT")) .. "/" .. display),
            display
        )
        chunks[#chunks + 1] = {name = name, bytes = assert(bytes, problem)}
    end
    local compiled = os.clock()
    local held = runtime(mode, cacheDirectory, audited == true)
    timings.compile = (timings.compile or 0) + compiled - began
    timings.runtime = (timings.runtime or 0) + os.clock() - compiled
    local resolved = {}
    for name, owner in pairs(held.owners) do
        resolved[name] = {owner = owner}
    end
    -- Then its chunks that are each a program of its own.
    for _, name in ipairs(case.chunks or {}) do
        chunks[#chunks + 1] = {name = name, bytes = writer.chunk(chunk(name, case.version), held.scopes)}
    end

    return {
        resolved = resolved,
        selected = held.codes,
        scopes = held.scopes,
        executable = cached,
        handlers = handlerNames(caseName, case.version),
        caseName = caseName,
        audited = audited == true,
        refusals = {},
        timings = held.timings,
        metrics = held.metrics,
        -- The runtime's literal raises, whose texts the guest's errors carry.
        raises = held.raises,
        chunks = chunks
    }
end
