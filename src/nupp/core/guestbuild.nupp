    -- far as they reach, beside the ones `modules` names.
    follow: boolean?,
    -- The fixture is written under build/core-guests/generated by the runner.
    generated: boolean?,
    -- The fixture is a source under the checkout root, checked where it
    -- lives and named `module` (a benchmark program declares no module).
    rooted: boolean?,
    -- A declared program (`declareProgram`): the modules it requires that
    -- no library answers are found staged beside it.
    staged: boolean?,
    module: string?,
    -- Fixtures compiled as binary chunks beside the program, which the
    -- runner writes where NUPP_GUEST_TEMP names, as `<fixture>.chunk`.
