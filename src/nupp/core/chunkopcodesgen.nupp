module nupp.core.chunkopcodesgen

local bytecode = require("nupp.compiler.vm.corebytecode")
local opcodes = require("nupp.compiler.vm.opcodes")

-- The bits of a shape (see the generated module's header).
const FUNCTION_OPERAND = 256
const CONSTANT_OPERAND = 512
const MODULE_OPERAND = 1024
const BRANCH_OPERAND = 2048
const FALLS = 4096
const KNOWN = 8192
-- Where an instruction's wide operands sit, as the recipes place them.
const WORD_FIELD = 8
const WORD_BYTES = 8
const SIGNED_FIELD = 4
const SIGNED_BYTES = 4
-- The bytes below the first wide field, any of which may name a register.
const REGISTER_LIMIT = 8
-- The core-only opcodes that end a function, which the frozen VM's table
-- does not describe: every other core-only opcode continues at the next
-- instruction (corebytecode's policies).
const CORE_STOPS: {[string]: boolean} = {RetN = true, RetV = true}

-- `NewClosure` as `NEW_CLOSURE`, `XPHandle` as `XP_HANDLE`.
local function constantName(name: string): string
    local spaced = name:gsub("(%l)(%u)", "%1_%2"):gsub("(%u)(%u%l)", "%1_%2")

    return spaced:upper()
end

local function flow(name: string, core: boolean): string
    if core then
        return CORE_STOPS[name] and "stop" or "next"
    end

    return assert(opcodes.describe(name), "chunk opcode without a canonical row").flow
end

local function shape(description: any, core: boolean): integer
    local bits: integer = KNOWN
    for _, field in ipairs(description.fields) do
        if field.class == "v" then
            assert(field.bytes == 1 and field.offset < REGISTER_LIMIT, "register operand outside the low bytes")
            bits = bits | (1 << (field.offset as integer))
        elseif field.class == "fn" then
            assert(field.offset == WORD_FIELD and field.bytes == WORD_BYTES, "function operand moved")
            bits = bits | FUNCTION_OPERAND
        elseif field.class == "k" then
            assert(field.offset == SIGNED_FIELD and field.bytes == SIGNED_BYTES, "constant operand moved")
            bits = bits | (description.name == "Require" and MODULE_OPERAND or CONSTANT_OPERAND)
        elseif field.class == "j" then
            assert(field.offset == SIGNED_FIELD and field.bytes == SIGNED_BYTES, "branch operand moved")
            bits = bits | BRANCH_OPERAND
        end
    end
    local next = flow(description.name, core)
    if next == "next" or next == "branch" then
        bits = bits | FALLS
    end

    return bits
end

-- Every opcode the core's handlers run, with its recipe, by id.
local function described(): {any}
    local core = bytecode.coreOnly()
    local candidates: {string} = opcodes.names()
    for name in pairs(core) do
        table.insert(candidates, name)
    end
    local rows: {any} = {}
    local seen: {[string]: boolean} = {}
    for _, name in ipairs(candidates) do
        local ok, description = pcall(bytecode.describe, name)
        if ok and not seen[name] then
            seen[name] = true
            rows[#rows + 1] = {description = description, bits = shape(description, core[name] ~= nil)}
        end
    end
    table.sort(rows, function(a: any, b: any): boolean
        return a.description.id < b.description.id
    end)

    return rows
end

-- The runtime's opcode ids and operand shapes for a loaded chunk's
-- admission (nupp.runtime.core.chunkadmission), from the final-core byte
-- recipes (nupp.compiler.vm.corebytecode).
export function source(): string
    local lines = {
        "module nupp.runtime.core.chunkopcodes",
        "",
        "-- Generated by nupp.core.chunkopcodesgen from nupp.compiler.vm.corebytecode's",
        "-- final-core byte recipes: edit those, not this file.",
        "--",
        "-- An opcode's shape: a bit per instruction byte that names a value",
        "-- register, then what its wider operands are, whether execution may",
        "-- continue at the next instruction, and that the core runs it at all.",
        "export const REGISTERS: uint64 = 255ULL",
        "export const FUNCTION_OPERAND: uint64 = " .. FUNCTION_OPERAND .. "ULL",
        "export const CONSTANT_OPERAND: uint64 = " .. CONSTANT_OPERAND .. "ULL",
        "export const MODULE_OPERAND: uint64 = " .. MODULE_OPERAND .. "ULL",
        "export const BRANCH_OPERAND: uint64 = " .. BRANCH_OPERAND .. "ULL",
        "export const FALLS: uint64 = " .. FALLS .. "ULL",
        "export const KNOWN: uint64 = " .. KNOWN .. "ULL",
        ""
    }
    local rows = described()
    for _, row in ipairs(rows) do
        lines[
            #lines + 1
        ] = "export const " .. constantName(row.description.name) .. ": uint64 = " .. row.description.id .. "ULL"
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The shape of opcode `op`, or 0 for one the core does not run."
    lines[#lines + 1] = "export function shape(op: uint64): uint64"
    for index, row in ipairs(rows) do
        lines[
            #lines + 1
        ] = (index == 1 and "    if" or "    elseif") .. " op == " .. constantName(row.description.name) .. " then"
        lines[#lines + 1] = ("        return 0x%XULL"):format(row.bits)
    end
    lines[#lines + 1] = "    end"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end
