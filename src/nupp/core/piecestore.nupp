module nupp.core.piecestore

-- Module pieces (nupp.compiler.vm.corepiece) kept in the shared store
-- (`nupp.core.sharedcache`), so a guest build compiles only the modules whose
-- pieces it cannot reuse.
--
-- A piece is trusted as the output of the compiler that made it, and is
-- reused only under the key of everything it was made from:
--
-- - the producer: the compiler generation running the build, and the source
--   of every module the build reaches that the generation does not carry,
--   which this process loads from source (the guest lowering and builder);
-- - the program: its modules in order, its entry and the modules a require
--   cycle re-enters, which numbering, eager loads and forwarders follow;
-- - the module: its name, path and the bytes its check read;
-- - what its check read: the interface of every module in the closure of the
--   interfaces and exports it read, as position-free text
--   (`nupp.compiler.project.interfacetext`), so a body edit that leaves an
--   interface alone leaves the key alone; and the project answers (callable
--   facts, module resolution, index entries) and external inputs it observed.
--
-- What a piece observed of other pieces, its callees' signatures and the
-- initializer results it read, the link checks again. An entry is sealed by
-- its digest and names its key; one that does not match its seal or its key,
-- or does not decode, is a miss. NUPP_GUEST_PIECE_STORE=0 keeps and reuses
-- nothing.
local sharedcache = require("nupp.core.sharedcache")
local kernelcompiler = require("nupp.core.kernelcompiler")
local fs = require("nupp.compiler.fs")
local fingerprint = require("nupp.compiler.project.fingerprint")
local checkinputs = require("nupp.compiler.project.checkinputs")
local corepiece = require("nupp.compiler.vm.corepiece")
local imagemodules = require("nupp.compiler.imagemodules")
local producermodules = require("nupp.core.producermodules")
local persisted, persist = pcall(require, "nupp.vm.persist")

-- Bumped when an entry's shape or meaning changes.
const FORMAT = "guest-piece/2"
const KIND = "pieces"
-- The module the guest build starts from: what it reaches is the producer.
const BUILDER = "nupp.core.guestbuild"
const GENERATION = "/(%x+)/compiler%.image$"
-- Variables that make a build report as it goes; a reused piece would skip it.
const REPORTING = {"EMIT_SURVEY", "EMIT_TRACE", "EMIT_STUBS", "DEBUG_REGS", "NUPP_CORE_SYMBOLS", "NUPP_MIR_OUT"}

-- NUPP_GUEST_PIECE_TRACE=1 says what each piece key is made of.
local tracing = os.getenv("NUPP_GUEST_PIECE_TRACE") == "1"
local contentDigest = fingerprint.contentDigest(true)

-- The producer's identity under `root`, computed once per process, or nil
-- when nothing may be kept: the generation the image names, and the sources
-- of every module the builder reaches that the image does not carry.
local producer: string? = nil
local disabled = false

local function producerOf(root: string): string?
    if producer ~= nil or disabled then
        return producer
    end
    local image = os.getenv("NUPP_VM_CLI_IMAGE")
    local generation = image and image:match(GENERATION)
    local installed = image and fs.readFile(image)
    disabled = not persisted or installed == nil or generation == nil or os.getenv("NUPP_GUEST_PIECE_STORE") == "0"
    for _, variable in ipairs(REPORTING) do
        disabled = disabled or os.getenv(variable) ~= nil
    end
    if disabled then
        return nil
    end
    local carried = imagemodules.carriedModules()
    local okay, modules = pcall(producermodules.reached, root, {BUILDER}, kernelcompiler.reachedModules)
    disabled = not okay
    if okay then
        local loaded = producermodules.uncarried(modules, carried)
        producer = contentDigest(
            FORMAT .. "\0" .. corepiece.FORMAT .. "\0" .. (
                generation as string
            ) .. "\0" .. kernelcompiler.digestOf(root, kernelcompiler.sorted(loaded))
        )
    end

    return producer
end

-- What every key of checked catalog `p`'s pieces shares, made by `made`: its
-- modules in order, its entry and its cyclic modules.
local function programOf(made: string, p: any): string
    local names: {string} = {}
    for _, module in ipairs(p.modules) do
        names[#names + 1] = module.name .. "\1" .. module.path
    end
    local cyclic: {string} = {}
    for name in pairs(p.cyclic) do
        cyclic[#cyclic + 1] = name
    end
    table.sort(cyclic)

    return contentDigest(
        table.concat({made, table.concat(names, "\0"), p.modules[p.entry + 1].name, table.concat(cyclic, "\0")}, "\2")
    )
end

-- `value` as an entry kept under `key`: a header holding the format, the key
-- and the body's digest, then the body.
local function sealed(key: string, value: any): string?
    local encoded, body = pcall(persist.saveData, value)
    if not encoded then
        io.stderr:write("guest piece store keeps nothing for ", key, ": ", tostring(body), "\n")
        return nil
    end
    local header = persist.saveData({format = FORMAT, key = key, seal = contentDigest(body as string)})

    return tostring(#header) .. "\n" .. header .. (body as string)
end

-- What entry `text`, kept under `key`, holds, or nil when it is not whole:
-- another format, another key's, or a body its digest does not seal.
local function unsealed(key: string, text: string?): any
    local length = text and tonumber(text:match("^(%d+)\n"))
    if not length then
        return nil
    end
    local at = #tostring(length) + 2
    local opened, envelope = pcall(persist.loadData, (text as string):sub(at, at + length - 1))
    local body = (text as string):sub(at + length)
    if not opened
        or type(envelope) ~= "table"
        or envelope.format ~= FORMAT
        or envelope.key ~= key
        or envelope.seal ~= contentDigest(body)
    then
        return nil
    end
    local decoded, value = pcall(persist.loadData, body)

    return decoded and value or nil
end

-- The name a record called `name` is kept under by the producer under `root`,
-- or nil when nothing may be kept.
local function recordKey(root: string, name: string): string?
    local made = producerOf(root)

    return made and contentDigest((made as string) .. "\0" .. name) .. ".record" or nil
end

-- The record the producer under `root` kept as `name`, or nil.
export function recall(root: string, name: string): any
    local key = recordKey(root, name)

    return key and unsealed(key as string, sharedcache.get(sharedcache.directory(KIND), key as string)) or nil
end

-- Keeps `value` as the producer under `root`'s record `name`.
export function remember(root: string, name: string, value: any): nil
    local key = recordKey(root, name)
    local text = key and sealed(key as string, value)
    if text then
        sharedcache.put(sharedcache.directory(KIND), key as string, text as string)
    end
end

-- The store of checked catalog `p`'s pieces, made by `made`, checked in
-- `project` or on their own.
local function storeOf(made: string, p: any, project: any?): any
    local program = programOf(made, p)
    local closure, interfaceOf = nil, nil
    if project ~= nil then
        closure, interfaceOf = checkinputs.readers(project)
    end
    local store: any = {}
    -- The entries this build reused, marked used together when it closes.
    local used: {string} = {}

    -- The key of the `index`th module's piece, whose check read `source`.
    local function keyOf(module: any, source: string): string
        local parts = {program, module.name, module.path, contentDigest(source)}
        if project ~= nil then
            parts[#parts + 1] = (closure as function(string): string)(module.path)
            for _, dependency in ipairs(project.projectDependencies(module.path)) do
                parts[
                    #parts + 1
                ] = dependency.name .. "\1" .. tostring(dependency.key) .. "\1" .. dependency.fingerprint
            end
            for _, input in ipairs(project.externalInputs(module.path)) do
                parts[#parts + 1] = input.path .. "\1" .. input.fingerprint
            end
        end
        if tracing then
            for at, part in ipairs(parts) do
                io.stderr:write("guest piece key ", module.name, " ", tostring(at), " ", contentDigest(part), "\n")
            end
        end

        return contentDigest(table.concat(parts, "")) .. ".bin"
    end

    -- The key of the `index`th module's piece, or nil when the source its
    -- check read cannot be read back.
    function store.key(index: integer): string?
        local module = p.modules[index]
        local source = project ~= nil and project.fileText(module.path) or fs.readFile(module.path)

        return source and keyOf(module, source as string) or nil
    end

    -- The digest of module `name`'s interface as checked in the project.
    function store.interface(name: string): string
        return (interfaceOf as function(string): string)(name)
    end

    -- The piece kept under `key`, or nil.
    function store.lookup(key: string): any
        local piece = unsealed(key, sharedcache.get(sharedcache.directory(KIND), key))
        if type(piece) ~= "table" or piece.format ~= corepiece.FORMAT then
            return nil
        end
        used[#used + 1] = key

        return piece
    end

    -- Marks every entry this build reused as used, at once: the store sweeps
    -- the least recently used first.
    function store.close(): nil
        sharedcache.touch(sharedcache.directory(KIND), used)
        used = {}
    end

    -- Keeps `piece` under `key`, sealed by its digest.
    function store.keep(key: string, piece: any): boolean
        local text = sealed(key, piece)

        return text ~= nil and sharedcache.put(sharedcache.directory(KIND), key, text as string)
    end

    return store
end

-- A store for the pieces of checked catalog `p`, checked in `project` (an
-- incremental project, or nil for a program checked on its own), under
-- checkout `root`. Nil when nothing may be kept.
export function open(root: string, p: any, project: any?): any
    local made = producerOf(root)

    return made and storeOf(made as string, p, project) or nil
end
