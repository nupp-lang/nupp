module nupp.core.guestauditshim

local arm = require("nupp.compiler.s0.arm64")
local linker = require("nupp.core.link")
local literal = require("nupp.compiler.s0.literal")

local function align(value: integer): integer
    return (value + 15) & -16
end

-- This wrapper is test-only. It invokes the unchanged actual program entry,
-- keeps its output/status, then calls three fixed checked audit leaves. Primary
-- bundles are executed separately without this wrapper or these audit sources.
export function build(source: any, selected: {[string]: any}, primary: any, scenario: string): any
    assert(source.audited, "fixed audited guest source required")
    local prefixFailure = source.caseName == "modulePair" and scenario == "budget1"
    local status: integer = 0
    local used = (source.caseName == "fresh" or source.caseName == "nested") and 3 or 1
    if scenario == "budget0" then
        status, used = 2, 0
    elseif scenario == "cancel" then
        status, used = 3, 0
    elseif scenario == "budget1" and prefixFailure then
        status, used = 2, 1
    elseif scenario == "budget2" then
        assert(source.caseName == "nested" or prefixFailure);
        status, used = 2, 1
    elseif scenario == "budget4" then
        assert(source.caseName == "nested");
        status, used = 2, 2
    else
        assert(scenario == "success", "closed audit scenario")
    end
    local owner = source.executable.entry
    if prefixFailure then
        owner = source.executable.initializers[1]
    elseif scenario == "budget2" or scenario == "budget4" then
        owner = source.executable.functions[owner + 1].calls[1].target
        if scenario == "budget4" then
            owner = source.executable.functions[owner + 1].calls[1].target
        end
    end
    local expectedPC: integer? = nil
    local expectedOp = prefixFailure and "CallK" or (status == 0 and "Ret" or "NewClosure")
    for index, instruction in ipairs(source.executable.functions[owner + 1].instructions) do
        if instruction[1] == expectedOp then
            assert(expectedPC == nil, "fixed audit checkpoint unique");
            expectedPC = index - 1
        end
    end
    assert(expectedPC ~= nil, "fixed audit checkpoint missing")
    local values = source.scopes["nupp.runtime.vm.values"]
    local value = literal.integer(assert(values.exportedConstants[source.caseName == "nilValue" and "NIL" or "TRUE"]))
    local roots, rootNames = {}, {}
    for _, name in ipairs({"after", "stale", "failedStart", "failedPrefix"}) do
        local symbol = "nupp.runtime.core.guestaudit." .. name
        assert(source.resolved[symbol], "audit leaf was not lowered")
        local code = assert(selected[symbol])
        roots[#roots + 1] = code
        rootNames[symbol] = true
    end
    local prefix = {}
    for index, word in ipairs(primary.words) do
        prefix[index] = word
    end
    local functions = {}
    for name, code in pairs(selected) do
        if not rootNames[name] then
            functions[name] = code
        end
    end
    local linked = linker.assembleTrusted(prefix, roots, functions, 4194304)
    local snapshotOffset = align(primary.scratchBytes)
    local workspaceOffset = align((snapshotOffset + primary.spillOffset) as integer)
    local workspaceBytes = align(primary.layouts.Binding.size) + 128 + align(primary.storageBytes) + 16
    local helperOffset = align(workspaceOffset + workspaceBytes)
    local highWater = helperOffset + linked.callBytes
    local scratchBytes = align(highWater as integer)
    assert(scratchBytes <= 4194304 and linked.callBytes > 0, "explicit supplemental audit scratch bound")
    local words: {integer} = linked.words
    local refusals: {{
        at: integer,
        condition: integer
    }} = {}
    local entry = #words * 4

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function immediate(reg: integer, number: integer): nil
        emit(arm.movz(64, reg, number & 65535, 0))
        for shift = 1, 3 do
            local part = (number >> (shift * 16)) & 65535
            if part ~= 0 then
                emit(arm.movk(64, reg, part, shift))
            end
        end
    end

    local function offset(reg: integer, bytes: integer): nil
        local high, low = bytes >> 12, bytes & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, reg, 19, high, 1));
            emit(arm.add_imm(64, reg, reg, low, 0))
        else
            emit(arm.add_imm(64, reg, 19, low, 0))
        end
    end

    local function refuse(condition: integer): nil
        refusals[#refusals + 1] = {at = #words + 1, condition = condition}
        emit(arm.b_cond(condition, 0))
    end

    local function call(target: integer): nil
        emit(arm.bl(target - #words * 4))
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 0, 31, 160));
    emit(arm.str(8, 1, 31, 168))
    emit(arm.ldr(8, 16, 0, 48));
    immediate(17, scratchBytes);
    emit(arm.cmp_reg(64, 16, 17));
    refuse(3)
    call(primary.entry)
    emit(arm.str(8, 0, 31, 176));
    immediate(17, status);
    emit(arm.cmp_reg(64, 0, 17));
    refuse(1)
    emit(arm.ldr(8, 20, 31, 160));
    emit(arm.ldr(8, 19, 20, 40));
    offset(23, helperOffset)
    if prefixFailure then
        emit(arm.mov_reg(64, 0, 19));
        offset(1, primary.contextStride)
        immediate(2, owner)
        immediate(3, expectedPC)
        call(linked.offsets[4]);
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
        emit(arm.mov_reg(64, 0, 19));
        immediate(1, 1)
        immediate(2, 2)
        immediate(3, literal.integer(assert(values.exportedConstants.NIL)))
        immediate(4, owner)
        immediate(5, expectedPC)
        call(linked.offsets[1]);
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
    else
        emit(arm.mov_reg(64, 0, 19));
        immediate(1, used);
        immediate(2, status);
        immediate(3, value)
        immediate(4, owner);
        immediate(5, expectedPC)
        call(linked.offsets[1]);
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
        emit(arm.mov_reg(64, 0, 19));
        offset(1, snapshotOffset);
        immediate(2, primary.spillOffset)
        emit(arm.mov_reg(64, 3, 23));
        immediate(4, linked.callBytes)
        call(linked.offsets[2]);
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
        offset(0, primary.bindingOffset);
        offset(1, workspaceOffset);
        immediate(2, workspaceBytes)
        emit(arm.mov_reg(64, 3, 23));
        immediate(4, linked.callBytes)
        call(linked.offsets[3]);
        emit(arm.cmp_imm(64, 0, 0, 0));
        refuse(1)
    end
    emit(arm.ldr(8, 0, 31, 176));
    local done = #words + 1;
    emit(arm.b(0))
    local failed = #words + 1
    -- Distinct from every production refusal, so an audit failure cannot pass
    -- the expected-status test for budget/cancel or expose a successful output.
    emit(arm.movz(64, 0, 99, 0))
    local restore = #words + 1
    words[done] = arm.b((restore - done) * 4)
    for _, fixup in ipairs(refusals) do
        words[fixup.at] = arm.b_cond(fixup.condition, (failed - fixup.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0));
    emit(arm.ret(30))

    return {
        words = words,
        entry = entry,
        scratchBytes = scratchBytes,
        spillOffset = helperOffset,
        callBytes = linked.callBytes,
        scenario = scenario,
        expectedStatus = status,
        expectedUsed = used,
        expectedOwner = owner,
        expectedPC = expectedPC,
        snapshotOffset = snapshotOffset,
        snapshotBytes = primary.spillOffset,
        workspaceOffset = workspaceOffset,
        workspaceBytes = workspaceBytes,
        primaryEntry = primary.entry
    }
end
