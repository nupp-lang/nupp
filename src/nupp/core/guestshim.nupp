module nupp.core.guestshim

local arm = require("s0.arm64")
local linker = require("nupp.core.link")
local nativeos = require("nupp.compiler.vm.nativeos")
local targetLayout = require("nupp.compiler.targetlayout")
local opcodes = require("nupp.compiler.vm.opcodes")
local context = require("nupp.runtime.core.context")

local function align(value: integer): integer
    return (value + 15) & -16
end

-- The most bytes of frames an entry's stack may reach: its catalog's frame
-- depth (at most coregraphexecutable.depthbound) times its largest frame.
local POOL_BOUND: integer = 536870912
-- The most bytes of a mapped pool, the first chunk of an initializer's
-- stack, unless its largest frame needs more: a stack that recurses deeper
-- grows in chunks of its own (`stacks`).
local FIRST_POOL: integer = 262144

-- Entries already built in this process, by everything an entry is made
-- from (`build`): programs alike in those share one, which callers copy.
local built: {[string]: any} = {}

local function shallow(value: any): any
    local result = {}
    for key, item in pairs(value) do
        result[key] = item
    end

    return result
end

-- The issued graph catalog fixes initializer order. Each initializer borrows
-- fresh Context/Storage, then completes before the next starts. The World and
-- immutable image persist across runs; only the final result is published.
-- Entry, call, return and cleanup policy remains selected Nupp code.
export function build(source: any, selected: {[string]: any}, capacity: integer?, raw: boolean?): any
    local scratchBytes = capacity or 65536
    assert(
        raw and source.caseName == "raw" and scratchBytes == 33554432
        or not raw and (scratchBytes == 65536 or scratchBytes == 131072 or scratchBytes == 1048576),
        "explicit guest scratch capacity"
    )
    local layouts = {}
    for _, request in ipairs({
        {"Binding", "guestentry"},
        {"Storage", "guestentry"},
        {"Catalog", "guestcatalog"},
        {"Descriptor", "guestcatalog"},
        {"DescriptorV1", "guestcatalog"},
        {"Request", "rawexecutable"},
        {"World", "instances"},
        {"Instance", "instances"},
        {"Frame", "frames"},
        {"FunctionInfo", "frames"},
        {"WindowPlan", "frames"},
        {"RootControl", "frames"},
        {"State", "frames"},
        {"Mark", "arena"},
        {"Services", "guestscope"}
    }) do
        if request[1] == "Request" and raw
            or request[1] == "Services" and not raw
            or request[1] ~= "Request" and request[1] ~= "Services"
        then
            local scope = source.scopes["nupp.runtime.core." .. request[2]]
            layouts[
                request[1]
            ] = assert(targetLayout.of(assert(scope.checkedExports.types[request[1]]), "aarch64-apple-darwin"))
        end
    end
    local binding = layouts.Binding
    local stride = binding.offsets.context - binding.offsets.data
    local width = binding.fields[1].size
    assert(width == 8 and stride == width * 2 and binding.offsets.data == 0, "Binding pair representation")
    assert(binding.offsets.dataBytes == width and binding.size == stride * 7, "Binding complete pair extent")
    for index, name in ipairs({"data", "context", "world", "storage", "pool", "helper", "code"}) do
        assert(binding.offsets[name] == (index - 1) * stride, "Binding base stride")
        assert(binding.offsets[name .. "Bytes"] == (index - 1) * stride + width, "Binding extent stride")
    end
    for _, field in ipairs(binding.fields) do
        assert(field.size == width and not field.bitWidth, "Binding word field")
    end
    local executable = source.executable
    local moduleCount = #executable.initializers
    -- From v8 only the entry module runs; the others run as it requires
    -- them, so one context, binding and storage serve.
    local lazy = (executable.version as integer) >= 8
    local slots = lazy and 1 or moduleCount
    assert(
        moduleCount >= 1
        and moduleCount <= (lazy and 65536 or 3)
        and executable.initializers[moduleCount] == executable.entry
    )
    -- From v8 the entry's storage, which grows with the program's functions,
    -- is mapped as the services open rather than taken from scratch.
    local mappedStorage = lazy and not raw
    -- From v7, which can recurse, the frame pool is mapped as the services
    -- open too. Before it a program's pool is its exact depth, in scratch,
    -- which the lifecycle audits read after the entry has closed.
    local mappedPool = not raw and source.executable.semantic.schema.version >= 7
    local descriptorLayout = source.executable.semantic.schema.version >= 3 and layouts.Descriptor
        or moduleCount == 1 and layouts.DescriptorV1
        or layouts.Descriptor
    local catalogOffset = align(layouts.Storage.size)
    local catalogBytes = layouts.Catalog.size + #executable.functions * (
        layouts.FunctionInfo.size + layouts.WindowPlan.size
    )
    local storageBytes = align(
        (catalogOffset + catalogBytes) as integer
    ) + (executable.instanceCapacity as integer) * layouts.Instance.size
    local maximumFrame = 0
    for _, fn in ipairs(executable.functions) do
        maximumFrame = math.max(
            maximumFrame,
            align((align(layouts.Frame.size) + (fn.valueCount as integer) * 8) as integer)
        )
    end
    -- The frames as deep as the catalog lets calls nest. A mapped pool is
    -- that much or FIRST_POOL, whichever is less, and its stack grows past
    -- it only as deep as the program's calls reach.
    local poolBytes = raw and 4096 or (executable.frameDepth as integer) * maximumFrame
    assert(
        poolBytes > 0 and poolBytes <= (raw and 4096 or mappedPool and POOL_BOUND or 1048576),
        "guest frame pool bound"
    )
    local firstBytes = math.min(poolBytes, math.max(FIRST_POOL, maximumFrame))
    -- The entry depends on the program only through the numbers above and
    -- its handlers; the selected runtime and its scopes are held per mode.
    local key: string? = nil
    if not raw then
        key = table.concat(
            {
                tostring(selected),
                tostring(source.scopes),
                tostring(source.audited == true),
                tostring(scratchBytes),
                table.concat(source.handlers, ","),
                tostring(moduleCount),
                tostring(lazy),
                tostring(source.executable.semantic.schema.version),
                tostring(#executable.functions),
                tostring(executable.instanceCapacity),
                tostring(executable.frameDepth),
                tostring(maximumFrame)
            },
            "\0"
        )
        if built[key] then
            return shallow(built[key])
        end
    end
    local contextBytes = align(context.SIZE)
    local worldOffset = align(contextBytes * slots)
    local bindingOffset = align((worldOffset + layouts.World.size) as integer)
    local storageOffset = align((bindingOffset + slots * layouts.Binding.size) as integer)
    local dispatchOffset = align((storageOffset + (mappedStorage and 0 or slots * storageBytes)) as integer)
    local poolOffset = align(dispatchOffset + 256 * 8)
    -- The entry's services (page ledger, scope, heap handle): see guestscope.
    local servicesOffset = align((poolOffset + (mappedPool and 0 or poolBytes)) as integer)
    local servicesBytes = raw and 0 or 12288
    local spillOffset = align(servicesOffset + servicesBytes)
    local requestOffset: integer = 131072
    local rawCatalogOffset: integer = 262144
    local rawCatalogBytes: integer = 4096
    local rawPoolOffset: integer = 1048576
    local rawPoolBytes: integer = 18874368
    if raw then
        assert(spillOffset < requestOffset and layouts.Request.size == 88, "raw request separation")
        spillOffset = rawPoolOffset + rawPoolBytes
    end
    assert(spillOffset < scratchBytes, "guest entry metadata/pool exceeds scratch")
    local roots, functions, rootNames = {}, {}, {}
    for _, name in ipairs(source.handlers) do
        rootNames[#rootNames + 1] = "nupp.runtime.core.guesthandlers." .. name
    end
    local startIndex, completeIndex = #rootNames + 1, #rootNames + 2
    rootNames[
        startIndex
    ], rootNames[completeIndex] = "nupp.runtime.core.guestentry.start", "nupp.runtime.core.guestentry.complete"
    local servicesIndex = #rootNames + 1
    if not raw then
        for _, name in ipairs({"prepare", "open", "close", "finish"}) do
            rootNames[#rootNames + 1] = "nupp.runtime.core.guestscope." .. name
        end
        -- Recovery crosses coroutines (threads), and an error it leaves
        -- untaken is reported (guestuncaught).
        rootNames[#rootNames + 1] = "nupp.runtime.core.guestuncaught.recover"
    end
    local rawIndex = #rootNames + 1
    if raw then
        rootNames[rawIndex] = "nupp.runtime.core.rawexecutable.admit"
    end
    local rootSet = {}
    for index, name in ipairs(rootNames) do
        local code = assert(selected[name])
        assert(source.resolved[name], "guest root was not lowered")
        roots[index], rootSet[name] = code, true
    end
    local count = 0
    for name, item in pairs(source.resolved) do
        local code = assert(selected[name], "guest selection missing")
        -- The separately issued audit unit retains these leaves for its later
        -- test wrapper. They call start/complete, which are roots here; keeping
        -- them out also keeps primary guest code independent of audit bodies.
        local auditScope = source.audited and source.scopes["nupp.runtime.core.guestaudit"]
        if not rootSet[name] and item.owner.scope ~= auditScope then
            functions[name] = code
        end
        count += 1
    end
    local found = 0
    for name in pairs(selected) do
        assert(source.resolved[name], "extra guest selection");
        found += 1
    end
    assert(found == count, "guest selected inventory")
    local extent = linker.assembleTrusted({}, roots, functions, scratchBytes - spillOffset).callBytes
    assert(extent > 0 and extent % 16 == 0)
    local words: {integer} = {}
    local refusals: {{
        at: integer,
        condition: integer
    }} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function immediate(reg: integer, value: integer): nil
        assert(value >= 0 and value < 4294967296)
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(dst: integer, base: integer, bytes: integer): nil
        assert(bytes >= 0 and bytes < 33554432)
        local high, low = bytes >> 12, bytes & 4095
        if high > 4095 then
            emit(arm.add_imm(64, dst, base, 4095, 1));
            base = dst
            high -= 4095
        end
        if high ~= 0 then
            emit(arm.add_imm(64, dst, base, high, 1));
            base = dst
        end
        emit(arm.add_imm(64, dst, base, low, 0))
    end

    local function refuse(condition: integer): nil
        refusals[#refusals + 1] = {at = #words + 1, condition = condition}
        emit(arm.b_cond(condition, 0))
    end

    emit(arm.sub_imm(64, 31, 31, 208, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160));
    emit(arm.str(8, 0, 31, 168))
    -- [sp, 192] holds the Services address once prepared, zero before.
    emit(arm.str(8, 31, 31, 192))
    for _, check in ipairs({
        {0, 1, 1},
        {48, scratchBytes, 3},
        {88, 1, 3},
        {32, raw and 48 or descriptorLayout.size, 3},
        {64, nativeos.importCount(), 3},
        {80, 3, 8}
    }) do
        emit(arm.ldr(8, 16, 0, check[1]));
        immediate(17, check[2]);
        emit(arm.cmp_reg(64, 16, 17));
        refuse(check[3])
    end
    local selectedCodePatch: integer? = nil
    if raw then
        -- The bridge reports the mapping extent; only the exact selected
        -- image may carry the offsets admitted below.
        emit(arm.ldr(8, 16, 0, 16))
        selectedCodePatch = #words + 1
        emit(arm.movz(64, 17, 0, 0))
        emit(arm.movk(64, 17, 0, 1))
        emit(arm.cmp_reg(64, 16, 17));
        refuse(1)
    end
    emit(arm.ldr(8, 22, 0, 56))
    local rawCall: integer? = nil
    local rawRefusalAt: integer? = nil
    local startRefusalAt: integer? = nil
    local completeRefusalAt: integer? = nil
    local rawDispatchPatches: {integer} = {}
    local rawCodePatch: integer? = nil
    if raw then
        -- The selected offsets are filled after authenticated linking. Wire
        -- bytes supply neither dispatch nor code authority.
        emit(arm.ldr(8, 27, 0, 40))
        offset(23, 27, spillOffset)
        offset(21, 27, dispatchOffset)
        for index = 0, 255 do
            rawDispatchPatches[index + 1] = #words + 1
            emit(arm.movz(64, 16, 0, 0))
            emit(arm.movk(64, 16, 0, 1))
            emit(arm.str(8, 16, 21, index * 8))
        end
        offset(24, 27, requestOffset)
        emit(arm.ldr(8, 16, 0, 24));
        emit(arm.str(8, 16, 24, 0))
        emit(arm.ldr(8, 16, 0, 32));
        emit(arm.str(8, 16, 24, 8))
        offset(16, 27, rawCatalogOffset);
        emit(arm.str(8, 16, 24, 16))
        immediate(16, rawCatalogBytes);
        emit(arm.str(8, 16, 24, 24))
        offset(16, 27, rawPoolOffset);
        emit(arm.str(8, 16, 24, 32))
        immediate(16, rawPoolBytes);
        emit(arm.str(8, 16, 24, 40))
        offset(16, 27, spillOffset);
        emit(arm.str(8, 16, 24, 48))
        immediate(16, extent);
        emit(arm.str(8, 16, 24, 56))
        emit(arm.str(8, 21, 24, 64))
        immediate(16, 256);
        emit(arm.str(8, 16, 24, 72))
        rawCodePatch = #words + 1
        emit(arm.movz(64, 16, 0, 0))
        emit(arm.movk(64, 16, 0, 1))
        emit(arm.str(8, 16, 24, 80))
        emit(arm.mov_reg(64, 0, 24))
        rawCall = #words + 1
        emit(arm.bl(0))
        emit(arm.cmp_imm(64, 0, 1, 0));
        rawRefusalAt = #words + 1
        emit(arm.b_cond(1, 0))
    end
    local servicesCalls: {integer} = {}
    local recoverCalls: {integer} = {}
    if not raw then
        emit(arm.ldr(8, 0, 31, 168))
        emit(arm.ldr(8, 27, 0, 40))
        offset(23, 27, spillOffset)
        offset(0, 27, servicesOffset)
        immediate(1, servicesBytes)
        servicesCalls[1] = #words + 1
        emit(arm.bl(0))
        emit(arm.cmp_imm(64, 0, 0, 0))
        refuse(0)
        emit(arm.str(8, 0, 31, 192))
        -- open(services, storage, stride, slots, pool bytes, world, stress)
        -- and its scope: storage 0 asks it to map the storage, pool bytes 0
        -- that the pool lies in scratch.
        if mappedStorage then
            emit(arm.movz(64, 1, 0, 0))
        else
            offset(1, 27, storageOffset)
        end
        immediate(2, storageBytes as integer)
        immediate(3, slots)
        immediate(4, mappedPool and firstBytes as integer or 0)
        offset(5, 27, worldOffset)
        -- A third input word asks for collect-at-every-allocation.
        emit(arm.ldr(8, 17, 31, 168))
        emit(arm.ldr(8, 16, 17, 80))
        emit(arm.movz(64, 6, 0, 0))
        emit(arm.cmp_imm(64, 16, 3, 0))
        local noStress = #words + 1
        emit(arm.b_cond(3, 0))
        emit(arm.ldr(8, 17, 17, 72))
        emit(arm.ldr(8, 6, 17, 16))
        words[noStress] = arm.b_cond(3, (#words + 1 - noStress) * 4)
        emit(arm.mov_reg(64, 7, 0))
        servicesCalls[2] = #words + 1
        emit(arm.bl(0))
        emit(arm.cmp_imm(64, 0, 1, 0))
        refuse(1)
    end
    local beginCalls: {integer}, completeCalls: {integer}, stoppedBranches: {integer} = {}, {}, {}
    for moduleIndex = 1, slots do
        local contextOffset = (moduleIndex - 1) * contextBytes
        local moduleBindingOffset = (bindingOffset + (moduleIndex - 1) * layouts.Binding.size) as integer
        local moduleStorageOffset = storageOffset + (moduleIndex - 1) * storageBytes
        emit(arm.ldr(8, 0, 31, 168))
        -- Selected Nupp calls preserve no internal integer registers.
        emit(arm.ldr(8, 27, 0, 40))
        offset(19, 27, contextOffset)
        for at = 0, context.SIZE - 8, 8 do
            emit(arm.ldr(8, 16, 19, at));
            emit(arm.cmp_imm(64, 16, 0, 0));
            refuse(1)
        end
        offset(21, 27, dispatchOffset);
        offset(23, 27, spillOffset)
        emit(arm.str(8, 21, 19, context.DISPATCH_TABLE))
        emit(arm.str(8, 31, 19, context.CANCELLED));
        emit(arm.str(8, 31, 19, context.STATUS))
        emit(arm.str(8, 31, 19, context.ERROR_PC));
        if moduleIndex == 1 then
            emit(arm.movn(64, 17, 0, 0));
            emit(arm.str(8, 17, 19, context.REMAINING))
            emit(arm.ldr(8, 16, 0, 80))
            local noBudget = #words + 1;
            emit(arm.cbz(64, 16, 0))
            emit(arm.ldr(8, 17, 0, 72));
            emit(arm.ldr(8, 17, 17, 0));
            emit(arm.str(8, 17, 19, context.REMAINING))
            words[noBudget] = arm.cbz(64, 16, (#words + 1 - noBudget) * 4)
        else
            offset(16, 27, contextOffset - contextBytes)
            emit(arm.ldr(8, 17, 16, context.REMAINING))
            emit(arm.str(8, 17, 19, context.REMAINING))
        end
        emit(arm.ldr(8, 16, 0, 80))
        emit(arm.cmp_imm(64, 16, 2, 0));
        local noCancel = #words + 1;
        emit(arm.b_cond(3, 0))
        emit(arm.ldr(8, 17, 0, 72));
        emit(arm.ldr(8, 17, 17, 8));
        emit(arm.str(8, 17, 19, context.CANCELLED))
        words[noCancel] = arm.b_cond(3, (#words + 1 - noCancel) * 4)
        offset(14, 27, moduleBindingOffset)
        local binding = layouts.Binding.offsets
        if raw then
            offset(16, 27, rawCatalogOffset)
        else
            emit(arm.ldr(8, 16, 0, 24))
        end
        emit(arm.str(8, 16, 14, binding.data))
        if raw then
            -- The retained catalog binds its exact published length, not
            -- the writable capacity used during raw construction.
            emit(arm.ldr(8, 16, 16, layouts.DescriptorV1.offsets.bytes))
        else
            emit(arm.ldr(8, 16, 0, 32))
        end
        emit(arm.str(8, 16, 14, binding.dataBytes))
        emit(arm.ldr(8, 16, 0, 8));
        emit(arm.str(8, 16, 14, binding.code))
        emit(arm.ldr(8, 16, 0, 16));
        emit(arm.str(8, 16, 14, binding.codeBytes))
        for _, field in ipairs({
            {"context", "contextBytes", contextOffset, context.SIZE},
            {"world", "worldBytes", worldOffset, layouts.World.size},
            {"storage", "storageBytes", moduleStorageOffset, storageBytes, mappedStorage},
            {"pool", "poolBytes", poolOffset, poolBytes, mappedPool, "poolbytes"},
            {"helper", "helperBytes", spillOffset, extent}
        }) do
            if field[5] then
                -- What open mapped, as the Services keep it.
                emit(arm.ldr(8, 16, 31, 192))
                emit(arm.ldr(8, 16, 16, layouts.Services.offsets[field[1]]))
            else
                offset(16, 27, field[3]);
            end
            emit(arm.str(8, 16, 14, binding[field[1]]))
            if field[5] and field[6] then
                -- And its extent: the pool's first chunk, as mapped.
                emit(arm.ldr(8, 16, 31, 192))
                emit(arm.ldr(8, 16, 16, layouts.Services.offsets[field[6]]))
            else
                immediate(16, field[4]);
            end
            emit(arm.str(8, 16, 14, binding[field[2]]))
        end
        emit(arm.mov_reg(64, 0, 14));
        immediate(1, lazy and moduleCount - 1 or moduleIndex - 1)
        beginCalls[moduleIndex] = #words + 1;
        emit(arm.bl(0))
        emit(arm.cmp_imm(64, 0, 0, 0));
        if raw then
            startRefusalAt = #words + 1
            emit(arm.b_cond(0, 0))
        else
            refuse(0)
        end
        emit(arm.mov_reg(64, 20, 0));
        if not raw then
            emit(arm.ldr(8, 16, 31, 192))
            emit(arm.str(8, 16, 19, context.SERVICE_SCOPE))
        end
        emit(arm.ldr(8, 17, 19, context.ROOT_SERIAL));
        emit(arm.str(8, 17, 31, 184))
        -- start validated all metadata before success. Materialize exactly256
        -- handler offsets into the separate mapped dispatch extent.
        emit(arm.ldr(8, 13, 31, 168));
        if raw then
            emit(arm.ldr(8, 27, 13, 40))
            offset(21, 27, dispatchOffset)
            offset(14, 27, rawCatalogOffset)
        else
            emit(arm.ldr(8, 14, 13, 24))
        end
        emit(arm.ldr(8, 15, 13, 8))
        emit(arm.ldr(8, 16, 14, layouts.Descriptor.offsets.dispatch));
        emit(arm.add_reg(64, 14, 14, 16, 0))
        for index = 0, 255 do
            emit(arm.ldr(8, 16, 14, index * 8));
            emit(arm.add_reg(64, 16, 15, 16, 0));
            emit(arm.str(8, 16, 21, index * 8))
        end
        local frame = layouts.Frame.offsets
        emit(arm.ldr(8, 0, 20, frame.code));
        emit(arm.str(8, 0, 19, context.CODE_START))
        emit(arm.ldr(8, 1, 20, frame.values));
        emit(arm.ldr(8, 2, 20, frame.integers));
        emit(arm.ldr(8, 3, 20, frame.floats))
        emit(arm.mov_reg(64, 4, 19));
        emit(arm.mov_reg(64, 5, 20))
        emit(arm.ldr(1, 16, 0, 0));
        emit(arm.add_reg(64, 16, 21, 16, 3));
        emit(arm.ldr(8, 16, 16, 0));
        emit(arm.blr(16))
        -- A guest error a protected call can take unwinds to it: recoverEntry
        -- answers the pc to resume at in the frame now active, or zero. x20
        -- stays the original root frame, which complete is given.
        if not raw then
            local recoverLoop = #words + 1
            emit(arm.mov_reg(64, 0, 19))
            -- Its service scope, the first field of the Services, if it takes one.
            emit(arm.ldr(8, 1, 19, context.SERVICE_SCOPE))
            recoverCalls[#recoverCalls + 1] = #words + 1
            emit(arm.bl(0))
            local noRecovery = #words + 1
            emit(arm.cbz(64, 0, 0))
            emit(arm.ldr(8, 16, 19, context.STATE))
            emit(arm.ldr(8, 5, 16, layouts.State.offsets.active))
            emit(arm.ldr(8, 1, 5, frame.values))
            emit(arm.ldr(8, 2, 5, frame.integers))
            emit(arm.ldr(8, 3, 5, frame.floats))
            emit(arm.mov_reg(64, 4, 19))
            emit(arm.ldr(1, 16, 0, 0))
            emit(arm.add_reg(64, 16, 21, 16, 3))
            emit(arm.ldr(8, 16, 16, 0))
            emit(arm.blr(16))
            emit(arm.b((recoverLoop - #words - 1) * 4))
            words[noRecovery] = arm.cbz(64, 0, (#words + 1 - noRecovery) * 4)
        end
        -- Every handler transport exit reaches complete, including failed publish
        -- with a prepared child. No status branch can bypass mandatory cleanup.
        emit(arm.ldr(8, 17, 19, context.STATUS));
        emit(arm.str(8, 17, 31, 176))
        emit(arm.mov_reg(64, 0, 19));
        emit(arm.mov_reg(64, 1, 20));
        emit(arm.ldr(8, 2, 31, 184))
        completeCalls[moduleIndex] = #words + 1;
        emit(arm.bl(0))
        emit(arm.ldr(8, 17, 31, 176));
        local noStatus = #words + 1;
        emit(arm.cbz(64, 17, 0))
        emit(arm.mov_reg(64, 0, 17));
        stoppedBranches[#stoppedBranches + 1] = #words + 1;
        emit(arm.b(0))
        words[noStatus] = arm.cbz(64, 17, (#words + 1 - noStatus) * 4)
        emit(arm.cmp_imm(64, 0, 1, 0));
        if raw then
            completeRefusalAt = #words + 1
            emit(arm.b_cond(1, 0))
        else
            refuse(1)
        end
        if moduleIndex == slots then
            emit(arm.ldr(8, 16, 19, context.ROOT_CONTROL));
            emit(arm.ldr(8, 17, 16, layouts.RootControl.offsets.value))
            emit(arm.ldr(8, 16, 31, 160));
            emit(arm.str(8, 17, 16, 0));
        end
    end
    emit(arm.movz(64, 0, 0, 0))
    local success = #words + 1;
    emit(arm.b(0))
    local failed = #words + 1;
    emit(arm.movz(64, 0, 1, 0))
    local failedJump: integer? = nil
    local special: {[integer]: integer} = {}
    local specialJumps: {integer} = {}
    if raw then
        failedJump = #words + 1
        emit(arm.b(0))
        for status = 2, 4 do
            special[status] = #words + 1
            emit(arm.movz(64, 0, status as integer, 0))
            specialJumps[#specialJumps + 1] = #words + 1
            emit(arm.b(0))
        end
    end
    local restore = #words + 1
    if not raw then
        -- Every exit tears the services down; a scope that cannot close turns
        -- success into failure.
        emit(arm.str(8, 0, 31, 200))
        emit(arm.ldr(8, 0, 31, 192))
        local unprepared = #words + 1
        emit(arm.cbz(64, 0, 0))
        emit(arm.mov_reg(64, 1, 0))
        servicesCalls[3] = #words + 1
        emit(arm.bl(0))
        emit(arm.ldr(8, 0, 31, 192))
        servicesCalls[4] = #words + 1
        emit(arm.bl(0))
        local clean = #words + 1
        emit(arm.cbz(64, 0, 0))
        emit(arm.ldr(8, 16, 31, 200))
        emit(arm.cmp_imm(64, 16, 1, 0))
        local reported = #words + 1
        emit(arm.b_cond(8, 0))
        -- Report the scope's first error as status 256 + code, over success or
        -- a generic refusal (1); a guest status is kept.
        emit(arm.add_imm(64, 16, 0, 256, 0))
        emit(arm.str(8, 16, 31, 200))
        words[unprepared] = arm.cbz(64, 0, (#words + 1 - unprepared) * 4)
        words[clean] = arm.cbz(64, 0, (#words + 1 - clean) * 4)
        words[reported] = arm.b_cond(8, (#words + 1 - reported) * 4)
        emit(arm.ldr(8, 0, 31, 200))
    end
    if raw then
        words[assert(failedJump)] = arm.b((restore - assert(failedJump)) * 4)
        for _, at in ipairs(specialJumps) do
            words[at] = arm.b((restore - at) * 4)
        end
        words[assert(rawRefusalAt)] = arm.b_cond(1, (assert(special[2]) - assert(rawRefusalAt)) * 4)
        words[assert(startRefusalAt)] = arm.b_cond(0, (assert(special[3]) - assert(startRefusalAt)) * 4)
        words[assert(completeRefusalAt)] = arm.b_cond(1, (assert(special[4]) - assert(completeRefusalAt)) * 4)
    end
    words[success] = arm.b((restore - success) * 4)
    for _, stopped in ipairs(stoppedBranches) do
        words[stopped] = arm.b((restore - stopped) * 4)
    end
    for _, refusal in ipairs(refusals) do
        words[refusal.at] = arm.b_cond(refusal.condition, (failed - refusal.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 208, 0));
    emit(arm.ret(30))
    local linked = linker.assembleTrusted(words, roots, functions, scratchBytes - spillOffset)
    assert(linked.callBytes == extent)
    if raw then
        linked.words[assert(rawCall)] = arm.bl((linked.offsets[rawIndex] as integer) - (assert(rawCall) - 1) * 4)
    end
    for index, call in ipairs(servicesCalls) do
        local target = linked.offsets[servicesIndex + index - 1] as integer
        linked.words[call] = arm.bl(target - (call - 1) * 4)
    end
    for _, call in ipairs(recoverCalls) do
        local target = linked.offsets[servicesIndex + 4] as integer
        linked.words[call] = arm.bl(target - (call - 1) * 4)
    end
    for moduleIndex = 1, slots do
        local beginCall, completeCall = beginCalls[moduleIndex], completeCalls[moduleIndex]
        linked.words[beginCall] = arm.bl((linked.offsets[startIndex] as integer) - (beginCall - 1) * 4)
        linked.words[completeCall] = arm.bl((linked.offsets[completeIndex] as integer) - (completeCall - 1) * 4)
    end
    local byName = {}
    for index, name in ipairs(source.handlers) do
        byName[name] = linked.offsets[index]
    end
    local dispatch = {}
    for index = 1, 256 do
        dispatch[index] = assert(byName.Invalid)
    end
    for index, name in ipairs(opcodes.names()) do
        if byName[name] then
            assert(index <= 256);
            dispatch[index] = byName[name]
        end
    end
    for name, id in pairs(require("nupp.compiler.vm.corebytecode").coreOnly()) do
        if byName[name] then
            dispatch[id + 1] = byName[name]
        end
    end
    if raw then
        local bytes = #linked.words * 4
        assert(bytes < 4294967296 and bytes % 4 == 0)
        local codeAt = assert(selectedCodePatch)
        linked.words[
            codeAt
        ], linked.words[codeAt + 1] = arm.movz(64, 17, bytes & 65535, 0), arm.movk(64, 17, bytes >> 16, 1)
        local at = assert(rawCodePatch)
        linked.words[at], linked.words[at + 1] = arm.movz(64, 16, bytes & 65535, 0), arm.movk(64, 16, bytes >> 16, 1)
        for index, target in ipairs(dispatch) do
            assert(target < bytes and target < 4294967296)
            at = rawDispatchPatches[index]
            linked.words[
                at
            ], linked.words[at + 1] = arm.movz(64, 16, target & 65535, 0), arm.movk(64, 16, target >> 16, 1)
        end
    end

    local result = {
        words = linked.words,
        offsets = linked.offsets,
        frames = linked.frames,
        callBytes = extent,
        dispatch = dispatch,
        scratchBytes = scratchBytes,
        spillOffset = spillOffset,
        poolOffset = poolOffset,
        poolBytes = poolBytes,
        storageOffset = storageOffset,
        storageBytes = storageBytes,
        contextStride = contextBytes,
        worldOffset = worldOffset,
        bindingOffset = bindingOffset,
        dispatchOffset = dispatchOffset,
        rawCatalogOffset = raw and rawCatalogOffset or nil,
        rawCatalogBytes = raw and rawCatalogBytes or nil,
        rawPoolOffset = raw and rawPoolOffset or nil,
        rawPoolBytes = raw and rawPoolBytes or nil,
        layouts = layouts,
        entry = 0
    }
    if key then
        built[key] = result
        return shallow(result)
    end

    return result
end
