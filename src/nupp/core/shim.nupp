module nupp.core.shim

local arm = require("nupp.compiler.s0.arm64")
local context = require("nupp.runtime.core.context")
local linker = require("nupp.core.link")

-- Context 0..127; frame header 128..159: predecessor, function, PC, extent.
-- A 32-byte gap separates the opaque header from the tagged value window.
-- Each window has 256 eight-byte slots; no Frame is inferred from a window.
-- Floats and vectors reserve distinct future regions; neither is a root here.
export const scratchBytes = 65536
export const contextOffset = 0
export const frameOffset = 128
export const taggedOffset = 192
export const integerOffset = 2240
export const floatOffset = 4288
export const vectorOffset = 6336
export const dispatchOffset = 8384
export const spillOffset = 8496

-- Input code and initialized program data are trusted, verified build artifacts.
-- Entry extent checks do not authenticate arbitrary replacement code or data.
local function assemble(codes: {any}, functions: {[string]: any}?, capacity: integer?, authenticated: boolean): any
    local scratch = capacity or scratchBytes
    assert(scratch >= scratchBytes and scratch <= 1048576 and scratch % 65536 == 0, "core shim scratch bound")
    assert(context.SIZE <= frameOffset and context.DISPATCH_TABLE + 8 <= context.SIZE, "core shim context extent")
    assert(#codes >= 1 and #codes <= 256, "core shim handler count")
    local spill = (dispatchOffset + #codes * 8 + 15) & -16
    local words: {integer} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function offset(dst: integer, base: integer, bytes: integer): nil
        local high, low = bytes >> 12, bytes & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, dst, base, high, 1))
            base = dst
        end
        emit(arm.add_imm(64, dst, base, low, 0))
    end

    -- C boundary alone uses the native stack; logical frames and spills do not.
    emit(arm.sub_imm(64, 31, 31, 176, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160))
    local refusals: {{
        at: integer,
        condition: integer
    }} = {}
    for _, check in ipairs({{0, 1, 1}, {48, scratch, 3}, {88, 1, 3}, {32, 48 + #codes * 8, 3}, {80, 2, 8}}) do
        emit(arm.ldr(8, 16, 0, check[1]))
        local value = check[2]
        emit(arm.movz(64, 17, value >= 65536 and (value >> 16) or value, value >= 65536 and 1 or 0))
        emit(arm.cmp_reg(64, 16, 17))
        refusals[#refusals + 1] = {at = #words + 1, condition = check[3]}
        emit(arm.b_cond(check[3], 0))
    end
    emit(arm.ldr(8, 15, 0, 8))
    emit(arm.ldr(8, 14, 0, 24))
    emit(arm.ldr(8, 19, 0, 40))
    emit(arm.ldr(8, 22, 0, 56))
    offset(20, 19, frameOffset)
    offset(21, 19, dispatchOffset)
    offset(23, 19, spill)
    emit(arm.str(8, 21, 19, context.DISPATCH_TABLE))
    emit(arm.str(8, 15, 20, 8))
    offset(17, 14, 32)
    emit(arm.str(8, 17, 20, 16))
    emit(arm.str(8, 17, 19, context.CODE_START))
    emit(arm.str(8, 31, 19, context.CANCELLED))
    emit(arm.str(8, 31, 19, context.STATUS))
    emit(arm.str(8, 31, 19, context.ERROR_PC))
    emit(arm.movn(64, 17, 0, 0))
    emit(arm.str(8, 17, 19, context.REMAINING))
    emit(arm.ldr(8, 16, 0, 80))
    local noBudget = #words + 1
    emit(arm.cbz(64, 16, 0))
    emit(arm.ldr(8, 17, 0, 72))
    emit(arm.ldr(8, 17, 17, 0))
    emit(arm.str(8, 17, 19, context.REMAINING))
    words[noBudget] = arm.cbz(64, 16, (#words + 1 - noBudget) * 4)
    emit(arm.cmp_imm(64, 16, 2, 0))
    local noCancel = #words + 1
    emit(arm.b_cond(3, 0))
    emit(arm.ldr(8, 17, 0, 72))
    emit(arm.ldr(8, 17, 17, 8))
    emit(arm.str(8, 17, 19, context.CANCELLED))
    words[noCancel] = arm.b_cond(3, (#words + 1 - noCancel) * 4)
    emit(arm.ldr(8, 17, 14, 8))
    emit(arm.str(8, 17, 20, 24))
    emit(arm.ldr(8, 16, 14, 24))
    emit(arm.add_reg(64, 13, 14, 16, 0))
    for index = 0, #codes - 1 do
        emit(arm.ldr(8, 16, 13, index * 8))
        emit(arm.add_reg(64, 16, 15, 16, 0))
        emit(arm.str(8, 16, 21, index * 8))
    end
    offset(0, 14, 32)
    offset(1, 19, taggedOffset)
    offset(2, 19, integerOffset)
    offset(3, 19, floatOffset)
    emit(arm.mov_reg(64, 4, 19))
    emit(arm.mov_reg(64, 5, 20))
    emit(arm.ldr(1, 16, 0, 0))
    emit(arm.add_reg(64, 16, 21, 16, 3))
    emit(arm.ldr(8, 16, 16, 0))
    emit(arm.blr(16))
    emit(arm.ldr(8, 17, 19, context.STATUS))
    local completed = #words + 1
    emit(arm.cbz(64, 17, 0))
    emit(arm.mov_reg(64, 0, 17))
    local stopped = #words + 1
    emit(arm.b(0))
    words[completed] = arm.cbz(64, 17, (#words + 1 - completed) * 4)
    emit(arm.ldr(8, 16, 31, 160))
    emit(arm.str(8, 0, 16, 0))
    emit(arm.movz(64, 0, 0, 0))
    local success = #words + 1
    emit(arm.b(0))
    local failed = #words + 1
    emit(arm.movz(64, 0, 1, 0))
    words[success] = arm.b((#words + 1 - success) * 4)
    for _, refusal in ipairs(refusals) do
        words[refusal.at] = arm.b_cond(refusal.condition, (failed - refusal.at) * 4)
    end
    words[stopped] = arm.b((#words + 1 - stopped) * 4)
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 176, 0))
    emit(arm.ret(30))
    local linked = authenticated and linker.assembleAuthenticated(words, codes, functions or {}, scratch - spill)
        or linker.assemble(words, codes, functions or {}, scratch - spill)

    return {
        words = linked.words,
        offsets = linked.offsets,
        frames = linked.frames,
        callBytes = linked.callBytes,
        scratchBytes = scratch,
        spillOffset = spill,
        entry = 0
    }
end

export function build(codes: {any}, functions: {[string]: any}?, capacity: integer?): any
    return assemble(codes, functions, capacity, false)
end

export function buildAuthenticated(codes: {any}, functions: {[string]: any}?, capacity: integer?): any
    return assemble(codes, functions, capacity, true)
end
