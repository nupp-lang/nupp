module nupp.core.compilerroot

-- The checkout root the core's test runners build from, NUPP_COMPILER_ROOT.
-- The compiler matches module paths made from it by their text, so it must
-- be one spelling: absolute, with no `.` or `..` in it. A runner given
-- another spelling, `$PWD/../../../..` or a relative one, runs again under
-- that spelling (`resolve`).

-- A wait status's exit code: os.execute answers the raw status under the
-- VM, and true or nil, the reason and the code under Lua.
const EXIT_SHIFT = 8
const SIGNAL_MASK = 0x7f
const FAILED = 1

local function quote(value: string): string
    return "'" .. value:gsub("'", "'\\''") .. "'"
end

-- `path` as the shell's `pwd` spells it after entering it, or nil when it
-- names no directory.
local function spelled(path: string): string?
    local pipe = io.popen("cd " .. quote(path) .. " 2>/dev/null && pwd")
    if not pipe then
        return nil
    end
    local line = pipe:read("*l")
    pipe:close()

    return line
end

local function exitcode(first: any, _: any, code: any): integer
    if math.type(first) == "integer" then
        if first & SIGNAL_MASK ~= 0 then
            return FAILED
        end
        return first >> EXIT_SHIFT
    end

    return math.tointeger(code) or FAILED
end

-- The root, absolute and without `.` or `..`. Given another spelling, the
-- runner `script` runs again with `arguments` under that one, from this
-- directory, and this process ends with its status.
export function resolve(script: string, arguments: {[integer]: string}): string
    local given = assert(os.getenv("NUPP_COMPILER_ROOT"), "set NUPP_COMPILER_ROOT to the checkout root")
    local root = assert(spelled(given), "NUPP_COMPILER_ROOT names no directory: " .. given)
    if root == given then
        return root
    end
    local words = {"NUPP_COMPILER_ROOT=" .. quote(root), quote(root .. "/bin/nupp"), "run", quote(script)}
    local index: integer = 1
    local argument = arguments[index]
    while argument ~= nil do
        words[#words + 1] = quote(argument)
        index = index + 1
        argument = arguments[index]
    end
    os.exit(exitcode(os.execute(table.concat(words, " "))))

    return root
end
