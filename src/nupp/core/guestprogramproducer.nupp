module nupp.core.guestprogramproducer

require("nupp.compiler.hostservices")
require("nupp.compiler.syntax.parser")
require("nupp.compiler.check")
require("nupp.compiler.project.env")
require("nupp.compiler.vm.programgraph")
require("nupp.compiler.vm.taggedprofile")
local shim = require("nupp.core.guestshim")
local guestbuild = require("nupp.core.guestbuild")
local auditshim = require("nupp.core.guestauditshim")
local writer = require("nupp.core.guestartifact")
-- Bytes are written as hex this many at a time: one format of a byte run
-- costs about a third of formatting each byte, over the tens of megabytes of
-- code a program carrying the compiler publishes.
const HEX_RUN = 64
const HEX_FORMAT = string.rep("%02x", HEX_RUN)

local function hex(value: string): string
    local parts: {string} = {}
    local at, size = 1, #value
    while at <= size do
        local last = math.min(at + HEX_RUN - 1, size)
        local format = last - at + 1 == HEX_RUN and HEX_FORMAT or string.rep("%02x", last - at + 1)
        parts[#parts + 1] = string.format(format, value:byte(at, last))
        at = last + 1
    end

    return table.concat(parts)
end

-- Wraps a primary selection in the supplemental lifecycle audit entry.
local function inspect(source: any, selected: any, output: any, scenario: string): nil
    local audited = auditshim.build(source, selected, output, scenario)
    output.audit = {
        scenario = scenario,
        expectedStatus = audited.expectedStatus,
        expectedUsed = audited.expectedUsed,
        expectedOwner = audited.expectedOwner,
        expectedPC = audited.expectedPC,
        snapshotOffset = audited.snapshotOffset,
        snapshotBytes = audited.snapshotBytes,
        workspaceOffset = audited.workspaceOffset,
        workspaceBytes = audited.workspaceBytes,
        primaryEntry = output.entry,
        primaryWords = #output.words,
        primaryScratchBytes = output.scratchBytes,
        primarySpillOffset = output.spillOffset,
        primaryCallBytes = output.callBytes
    }
    output.words, output.entry, output.scratchBytes = audited.words, audited.entry, audited.scratchBytes
    output.spillOffset, output.callBytes = audited.spillOffset, audited.callBytes
end

local function publish(
    source: any,
    output: any,
    packed: any,
    mode: string,
    caseName: string,
    metrics: any,
    refusals: any
): any
    local programs = {}
    for _, body in ipairs(source.executable.functions) do
        local constants = {}
        for index, constant in ipairs(body.constants) do
            constants[index] = {kind = constant.kind, valueHex = hex(constant.value)}
        end
        programs[
            #programs + 1
        ] = {
            owner = body.owner,
            instructions = body.instructions,
            codeHex = hex(body.code),
            instructionCount = body.instructionCount,
            valueCount = body.valueCount,
            calls = body.calls,
            constants = constants
        }
    end
    output.dataHex, output.dataBytes = hex(packed.bytes), #packed.bytes
    output.mode, output.caseName, output.metrics = mode, caseName, metrics
    output.programs, output.dataflowRefusals, output.provenanceRefusals = programs, source.refusals, refusals
    output.instanceBound = source.executable.instanceCapacity
    output.instanceCapacity = source.executable.instanceCapacity
    output.instanceCreations = source.executable.instanceCreations
    output.frameDepth = source.executable.frameDepth
    output.catalogOffsets = {
        code = packed.codeOffsets,
        constants = packed.constantOffsets,
        dispatch = packed.dispatchOffset
    }
    output.scope = "Checked acyclic scalar guests, with v3 source-bound number addition; no named exports, cycles, general loader, tagged objects or GC"

    return output
end

-- The same selection with the guest runtime built through the service
-- catalog and the unit code cache instead of the frozen final-frame build.
-- The runtime is selected once per mode in a process; each case then costs
-- its program compile and the shim.
export function selectUnits(
    caseName: string,
    mode: string,
    capacityText: string,
    cacheDirectory: string?,
    scenario: string?
): any
    assert(mode == "normal" or mode == "spill")
    local capacity = assert(tonumber(capacityText)) as integer
    assert(capacity == 65536 or capacity == 131072 or capacity == 1048576)
    local timings = guestbuild.timings
    local source = guestbuild.guest(caseName, mode, cacheDirectory, scenario ~= nil)
    local built = os.clock()
    local output = shim.build(source, source.selected, capacity)
    if scenario then
        inspect(source, source.selected, output, scenario)
    end
    local linked = os.clock()
    local packed = writer.encode(source.executable, source.scopes, output.dispatch, #output.words * 4, source.raises)
    local encoded = os.clock()
    local result = publish(source, output, packed, mode, caseName, source.metrics, {})
    result.chunks = {}
    for _, chunk in ipairs(source.chunks) do
        result.chunks[#result.chunks + 1] = {name = chunk.name, hex = hex(chunk.bytes)}
    end
    timings.shim = (timings.shim or 0) + linked - built
    timings.encode = (timings.encode or 0) + encoded - linked
    timings.publish = (timings.publish or 0) + os.clock() - encoded

    return result
end

-- What the C bridge reads (native/core-bridge/main.c): its magic, then the
-- format and architecture versions, the entry's offset, the code's and the
-- data's sizes, the scratch it maps and the words of output it keeps.
const BUNDLE_MAGIC = "NUPPCORE"
const BUNDLE_FORMAT = 1
const BUNDLE_ARCHITECTURE = 1
const BUNDLE_OUTPUT_WORDS = 1

local function u64(value: integer): string
    local bytes: {integer} = {}
    for at = 0, 7 do
        bytes[at + 1] = (value >> (at * 8)) & 255
    end

    return string.char(table.unpack(bytes))
end

-- `words`, each four little-endian bytes. Each is its own `string.char` of
-- four: the VM's keeps only the first 128 of a longer argument list.
local function wordBytes(words: {integer}): string
    local parts: {string} = {}
    for index, word in ipairs(words) do
        parts[index] = string.char(word & 255, (word >> 8) & 255, (word >> 16) & 255, (word >> 24) & 255)
    end

    return table.concat(parts)
end

local function bundleBytes(source: any, capacity: integer): string
    assert(capacity == 65536 or capacity == 131072 or capacity == 1048576, "explicit guest scratch capacity")
    local output = shim.build(source, source.selected, capacity)
    local packed = writer.encode(source.executable, source.scopes, output.dispatch, #output.words * 4, source.raises)
    local code = wordBytes(output.words)

    return table.concat({
        BUNDLE_MAGIC,
        u64(BUNDLE_FORMAT),
        u64(BUNDLE_ARCHITECTURE),
        u64(output.entry),
        u64(#code),
        u64(#packed.bytes),
        u64(capacity),
        u64(BUNDLE_OUTPUT_WORDS),
        u64(0),
        code,
        packed.bytes
    })
end

--- The core bundle the C bridge runs for case `caseName` in normal mode with
--- `capacity` bytes of scratch: the guest's runtime and program, selected,
--- linked and encoded as `selectUnits` does, written without its published
--- hex. A case that loads binary chunks has none to load beside a bundle, and
--- is refused.
export function bundle(caseName: string, capacity: integer): string
    local source = guestbuild.guest(caseName, "normal", nil, false)
    assert(#source.chunks == 0, "a bundle carries no binary chunks: " .. caseName)

    return bundleBytes(source, capacity)
end

export function projectBundle(entry: string, path: string, inc: any, embedded: string?): string
    return bundleBytes(guestbuild.projectGuest(entry, path, inc, embedded), 1048576)
end
