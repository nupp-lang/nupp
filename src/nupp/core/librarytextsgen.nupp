module nupp.core.librarytextsgen

local coretexts = require("nupp.compiler.vm.coretexts")

-- The widest line the formatter keeps whole.
local WIDTH = 120
-- A builder word holds this many bytes.
local WORD_BYTES = 8

-- The appendWord calls that append `text`, a word of up to eight bytes each,
-- little-endian.
local function words(text: string): {string}
    local calls = {}
    local at = 1
    while at <= #text do
        local piece = text:sub(at, at + WORD_BYTES - 1)
        local digits = {}
        for index = #piece, 1, -1 do
            digits[#digits + 1] = string.format("%02x", piece:byte(index))
        end
        local hex = table.concat(digits):gsub("^0+", "")
        calls[#calls + 1] = "strings.appendWord(h, b, 0x" .. hex .. "ULL, " .. tostring(#piece) .. "ULL)"
        at += WORD_BYTES
    end

    return calls
end

-- The runtime's text ids and the code appending each text, from the one
-- table (nupp.compiler.vm.coretexts). A leaf has no data, so each text is
-- kept as code.
export function source(): string
    local lines = {
        "module nupp.runtime.core.librarytexts",
        "",
        "-- Generated by nupp.core.librarytextsgen from nupp.compiler.vm.coretexts,",
        "-- the one table of the core's library texts: edit that table, not this file.",
        "-- A leaf has no data, so each text is its bytes as little-endian words,",
        "-- eight to a word.",
        "const heap = require(\"nupp.runtime.vm.heap\")",
        "const strings = require(\"nupp.runtime.core.corestrings\")",
        ""
    }
    local texts = coretexts.all()
    for _, entry in ipairs(texts) do
        lines[#lines + 1] = "export const " .. entry.name .. ": uint64 = " .. tostring(entry.id) .. "ULL"
    end
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- Appends text `id` to `b`: nonzero when the builder refused it."
    lines[#lines + 1] = "export function append(h: heap.Heap*, borrows b: strings.Builder*, id: uint64): uint64"
    for index, entry in ipairs(texts) do
        assert(not entry.text:find("[%c\"\\]"), "core text needs no escapes: " .. entry.name)
        lines[#lines + 1] = (index == 1 and "    if" or "    elseif") .. " id == " .. entry.name .. " then"
        lines[#lines + 1] = "        -- \"" .. entry.text .. "\""
        local calls = words(entry.text)
        local whole = "        return " .. table.concat(calls, " | ")
        if #whole <= WIDTH then
            lines[#lines + 1] = whole
        else
            lines[#lines + 1] = "        return " .. calls[1]
            for at = 2, #calls do
                lines[#lines + 1] = "            | " .. calls[at]
            end
        end
    end
    lines[#lines + 1] = "    end"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end
