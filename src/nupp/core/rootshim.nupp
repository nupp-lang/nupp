module nupp.core.rootshim

local arm = require("s0.arm64")
local linker = require("nupp.core.link")
local selector = require("s0.select")
local context = require("nupp.runtime.core.context")

export type Layout = {
    storageBytes: integer,
    descriptorBytes: integer,
    rootOffset: integer,
    valueOffset: integer,
    frameCode: integer,
    frameValues: integer,
    frameIntegers: integer,
    frameFloats: integer,
    descriptorTable: integer,
    descriptorHandlers: integer,
    rootMark: integer,
    markSerial: integer
}

-- Layout is read from checked Nupp sizeof/fieldOffset expressions by producer.
-- This C boundary transports pointers; root policy executes in selected Nupp.
export function build(handler: any, functions: {[string]: any}, layout: Layout): any
    local scratchBytes: integer = 131072
    local poolBytes: integer = 16384
    for _, value in pairs(layout) do
        assert(value >= 0 and value <= 65536 and value % 1 == 0, "checked root layout bound")
    end
    local storageOffset = (context.SIZE + 15) & -16
    local dispatchOffset = (storageOffset + layout.storageBytes + 15) & -16
    local poolOffset = (dispatchOffset + 8 + 15) & -16
    local spillOffset = poolOffset + poolBytes
    local entries = {"nupp.runtime.core.rootentry.start", "nupp.runtime.core.rootentry.complete"}
    -- The C boundary uses no logical helper frame. Its native SP saves are
    -- separate; ordinary calls below run at the current x23 helper base.
    local boundary = {
        words = {arm.bl(0), arm.bl(0)},
        frameBytes = 0,
        fixupWord = {1, 2},
        fixupKind = {selector.BL26, selector.BL26},
        fixupName = entries,
        fixupAddend = {0, 0}
    }
    local extent: integer = linker.assemble({}, {boundary, handler}, functions, scratchBytes - spillOffset).callBytes
    assert(extent > 0 and extent % 16 == 0, "root helper extent")
    local words: {integer} = {}
    local refusals: {{
        at: integer,
        condition: integer
    }} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function immediate(reg: integer, value: integer): nil
        assert(value >= 0 and value < 4294967296, "root immediate bound")
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, value >> 16, 1))
        end
    end

    local function offset(dst: integer, base: integer, bytes: integer): nil
        local high, low = bytes >> 12, bytes & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, dst, base, high, 1))
            base = dst
        end
        emit(arm.add_imm(64, dst, base, low, 0))
    end

    local function refuse(condition: integer): nil
        refusals[#refusals + 1] = {at = #words + 1, condition = condition}
        emit(arm.b_cond(condition, 0))
    end

    emit(arm.sub_imm(64, 31, 31, 192, 0))
    for reg = 19, 29, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    for reg = 8, 14, 2 do
        emit(arm.stp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    emit(arm.str(8, 1, 31, 160))
    emit(arm.str(8, 0, 31, 168))
    for _, check in ipairs({
        {0, 1, 1},
        {48, scratchBytes, 3},
        {88, 1, 3},
        {32, layout.descriptorBytes + 24, 3},
        {80, 2, 8}
    }) do
        emit(arm.ldr(8, 16, 0, check[1]))
        immediate(17, check[2])
        emit(arm.cmp_reg(64, 16, 17))
        refuse(check[3])
    end
    emit(arm.ldr(8, 14, 0, 24))
    emit(arm.ldr(8, 16, 14, layout.descriptorHandlers))
    emit(arm.cmp_imm(64, 16, 1, 0))
    refuse(1)
    emit(arm.ldr(8, 19, 0, 40))
    emit(arm.ldr(8, 22, 0, 56))
    offset(21, 19, dispatchOffset)
    offset(23, 19, spillOffset)
    emit(arm.str(8, 21, 19, context.DISPATCH_TABLE))
    emit(arm.str(8, 31, 19, context.CANCELLED))
    emit(arm.str(8, 31, 19, context.STATUS))
    emit(arm.str(8, 31, 19, context.ERROR_PC))
    emit(arm.movn(64, 17, 0, 0))
    emit(arm.str(8, 17, 19, context.REMAINING))
    emit(arm.ldr(8, 16, 0, 80))
    local noBudget = #words + 1
    emit(arm.cbz(64, 16, 0))
    emit(arm.ldr(8, 17, 0, 72))
    emit(arm.ldr(8, 17, 17, 0))
    emit(arm.str(8, 17, 19, context.REMAINING))
    words[noBudget] = arm.cbz(64, 16, (#words + 1 - noBudget) * 4)
    emit(arm.cmp_imm(64, 16, 2, 0))
    local noCancel = #words + 1
    emit(arm.b_cond(3, 0))
    emit(arm.ldr(8, 17, 0, 72))
    emit(arm.ldr(8, 17, 17, 8))
    emit(arm.str(8, 17, 19, context.CANCELLED))
    words[noCancel] = arm.b_cond(3, (#words + 1 - noCancel) * 4)
    -- Internal Nupp ABI: all seven scalar arguments are explicit, not C helpers.
    emit(arm.ldr(8, 1, 0, 32))
    emit(arm.mov_reg(64, 0, 14))
    offset(2, 19, storageOffset)
    offset(3, 19, poolOffset)
    immediate(4, poolBytes)
    emit(arm.mov_reg(64, 5, 23))
    immediate(6, extent)
    local beginCall = #words + 1
    emit(arm.bl(0))
    emit(arm.cmp_imm(64, 0, 0, 0))
    refuse(0)
    emit(arm.mov_reg(64, 20, 0))
    offset(16, 19, storageOffset + layout.rootOffset + layout.rootMark)
    emit(arm.ldr(8, 17, 16, layout.markSerial))
    emit(arm.str(8, 17, 31, 184))
    -- Reload only from entry-retained storage after a clobbering ordinary call.
    emit(arm.ldr(8, 13, 31, 168))
    emit(arm.ldr(8, 14, 13, 24))
    emit(arm.ldr(8, 15, 13, 8))
    emit(arm.ldr(8, 16, 14, layout.descriptorTable))
    emit(arm.add_reg(64, 16, 14, 16, 0))
    emit(arm.ldr(8, 16, 16, 0))
    emit(arm.add_reg(64, 16, 15, 16, 0))
    emit(arm.str(8, 16, 21, 0))
    emit(arm.ldr(8, 0, 20, layout.frameCode))
    emit(arm.str(8, 0, 19, context.CODE_START))
    emit(arm.ldr(8, 1, 20, layout.frameValues))
    emit(arm.ldr(8, 2, 20, layout.frameIntegers))
    emit(arm.ldr(8, 3, 20, layout.frameFloats))
    emit(arm.mov_reg(64, 4, 19))
    emit(arm.mov_reg(64, 5, 20))
    emit(arm.blr(16))
    emit(arm.ldr(8, 17, 19, context.STATUS))
    emit(arm.str(8, 17, 31, 176))
    offset(0, 19, storageOffset)
    emit(arm.mov_reg(64, 1, 20))
    emit(arm.ldr(8, 2, 31, 184))
    local completeCall = #words + 1
    emit(arm.bl(0))
    -- Complete retires or explicitly aborts. No Frame load follows this call.
    emit(arm.ldr(8, 17, 31, 176))
    local noStatus = #words + 1
    emit(arm.cbz(64, 17, 0))
    emit(arm.mov_reg(64, 0, 17))
    local stopped = #words + 1
    emit(arm.b(0))
    words[noStatus] = arm.cbz(64, 17, (#words + 1 - noStatus) * 4)
    emit(arm.cmp_imm(64, 0, 1, 0))
    refuse(1)
    offset(16, 19, storageOffset + layout.rootOffset)
    emit(arm.ldr(8, 17, 16, layout.valueOffset))
    emit(arm.ldr(8, 16, 31, 160))
    emit(arm.str(8, 17, 16, 0))
    emit(arm.movz(64, 0, 0, 0))
    local success = #words + 1
    emit(arm.b(0))
    local failed = #words + 1
    emit(arm.movz(64, 0, 1, 0))
    local restore = #words + 1
    words[success], words[stopped] = arm.b((restore - success) * 4), arm.b((restore - stopped) * 4)
    for _, refusal in ipairs(refusals) do
        words[refusal.at] = arm.b_cond(refusal.condition, (failed - refusal.at) * 4)
    end
    for reg = 8, 14, 2 do
        emit(arm.ldp_fp(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
    end
    for reg = 19, 29, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
    end
    emit(arm.add_imm(64, 31, 31, 192, 0))
    emit(arm.ret(30))
    boundary.words, boundary.fixupWord = words, {beginCall, completeCall}
    local linked = linker.assemble({}, {boundary, handler}, functions, scratchBytes - spillOffset)
    assert(linked.callBytes == extent and linked.offsets[1] == 0)

    return {
        words = linked.words,
        offsets = {linked.offsets[2]},
        frames = {linked.frames[2]},
        callBytes = extent,
        scratchBytes = scratchBytes,
        spillOffset = spillOffset,
        poolOffset = poolOffset,
        poolBytes = poolBytes,
        storageOffset = storageOffset,
        layout = layout,
        entry = 0
    }
end
