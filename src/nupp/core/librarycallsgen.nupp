module nupp.core.librarycallsgen

local corelibrary = require("nupp.compiler.vm.corelibrary")
local coretexts = require("nupp.compiler.vm.coretexts")
const SELECTOR_BITS: integer = 32
const SELECTOR_BASE: integer = 4294967296

local function constant(lines: {string}, name: string, value: integer): nil
    lines[#lines + 1] = "export const " .. name .. ": uint64 = " .. tostring(value) .. "ULL"
end

local function subjectconstants(lines: {string}, subject: corelibrary.Subject): nil
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- " .. subject.name
    local low: integer, high: integer = corelibrary.LIMIT, 0
    for _, entry in ipairs(subject.calls) do
        constant(lines, entry.name, entry.id)
        low = math.min(low, entry.id) as integer
        high = math.max(high, entry.id) as integer
    end
    if subject.range then
        constant(lines, subject.name:upper() .. "_FIRST", low)
        constant(lines, subject.name:upper() .. "_LAST", high)
    end
end

-- The runtime's ids for the core's library calls, from the one table
-- (nupp.compiler.vm.corelibrary): each call's id, a range subject's bounds,
-- and the text each call's errors name it by. The layouts the calls share
-- with the compiler are librarylayoutsgen's.
export function source(): string
    local lines = {
        "module nupp.runtime.core.librarycalls",
        "",
        "-- Generated by nupp.core.librarycallsgen from nupp.compiler.vm.corelibrary,",
        "-- the one table of the core's library calls: edit that table, not this file."
    }

    local texts = {}
    for _, entry in ipairs(coretexts.all()) do
        texts[entry.name] = entry
    end
    local named = {}
    for _, subject in ipairs(corelibrary.subjects()) do
        if subject.output == nil then
            subjectconstants(lines, subject)
        end
        for _, entry in ipairs(subject.calls) do
            if entry.text then
                assert(subject.output == nil, "a separate core subject cannot carry named errors")
                assert(texts[entry.text], "core library text " .. entry.text .. " is not a core text")
                named[#named + 1] = entry
            end
        end
    end

    -- By id, so the function reads in the order the calls were numbered.
    table.sort(named, function(a: any, b: any): boolean
        return a.id < b.id
    end)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The text a library call's errors name it by, or 0 for none."
    lines[#lines + 1] = "export function libraryname(id: uint64): uint64"
    for index, entry in ipairs(named) do
        lines[#lines + 1] = (index == 1 and "    if" or "    elseif") .. " id == " .. entry.name .. " then"
        lines[#lines + 1] = "        return " .. tostring(texts[entry.text].id) .. "ULL"
    end
    lines[#lines + 1] = "    end"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end

-- A canonical subject can keep its constants outside the full module's local budget.
export function subject(name: string): string
    for _, subject in ipairs(corelibrary.subjects()) do
        if subject.name == name then
            assert(subject.output ~= nil, "core subject has no separate output")
            local lines = {
                "module nupp.runtime.core." .. subject.output,
                "",
                "-- Generated by nupp.core.librarycallsgen from nupp.compiler.vm.corelibrary."
            }
            subjectconstants(lines, subject)
            return table.concat(lines, "\n") .. "\n"
        end
    end
    error("no core library subject " .. name)
end

-- The scalar kernel's family and operation labels stay in their own module;
-- call constants remain below the ordinary module-local declaration bound.
export function scalars(): string
    local lines = {
        "module nupp.runtime.core.scalarkinds",
        "",
        "-- Generated by nupp.core.librarycallsgen from nupp.compiler.vm.corelibrary.",
        "const calls = require(\"nupp.runtime.core.librarycalls\")"
    }
    -- The scalar selector is derived from the same rows as its public path and
    -- call id. Both the family and operation labels are generated constants.
    local families, operations, entries = {}, {}, {}
    local seenFamilies, seenOperations = {}, {}
    for _, group in ipairs(corelibrary.subjects()) do
        for _, entry in ipairs(group.calls) do
            if entry.scalar then
                local family, operation = entry.scalar:match("^(%w+)%.(%w+)$")
                assert(family and operation, "invalid core scalar identity")
                if not seenFamilies[family] then
                    seenFamilies[family] = true
                    families[#families + 1] = family
                end
                if not seenOperations[operation] then
                    seenOperations[operation] = true
                    operations[#operations + 1] = operation
                end
                entries[#entries + 1] = {entry = entry, family = family, operation = operation}
            end
        end
    end
    table.sort(families)
    table.sort(operations)
    local familyIds, operationIds = {}, {}
    constant(lines, "SELECTOR_SHIFT", SELECTOR_BITS)
    constant(lines, "SELECTOR_MASK", SELECTOR_BASE - 1)
    lines[#lines + 1] = ""
    for index, name in ipairs(families) do
        familyIds[name] = index
        constant(lines, name:upper(), index)
    end
    for index, name in ipairs(operations) do
        operationIds[name] = index
        constant(lines, name:upper(), index)
    end
    table.sort(entries, function(a: any, b: any): boolean
        return a.entry.id < b.entry.id
    end)
    lines[#lines + 1] = ""
    lines[#lines + 1] = "-- The checked scalar family and operation, packed in high/low32 bits."
    lines[#lines + 1] = "export function selector(id: uint64): uint64"
    for index, row in ipairs(entries) do
        lines[#lines + 1] = (index == 1 and "    if" or "    elseif") .. " id == calls." .. row.entry.name .. " then"
        lines[
            #lines + 1
        ] = "        return " .. tostring(familyIds[row.family] * SELECTOR_BASE + operationIds[row.operation]) .. "ULL"
    end
    lines[#lines + 1] = "    end"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "    return 0ULL"
    lines[#lines + 1] = "end"

    return table.concat(lines, "\n") .. "\n"
end
