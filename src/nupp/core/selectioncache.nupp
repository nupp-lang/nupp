module nupp.core.selectioncache

-- Guest program selections kept in the shared store (`nupp.core.sharedcache`),
-- so a case whose inputs are unchanged is not compiled again, in this checkout
-- or any other.
--
-- A selection is keyed by everything it is computed from: the compiler generation
-- running the producer, the content of every file under the trees the guest project
-- reads its modules from (which holds the producer, the runtime, the cases and the
-- generators of the generated ones), the compiler part of the runtime kernels' keys
-- (`nupp.core.kernelcompiler`, pinned or not), and the case, mode, scratch capacity and
-- build kind. Nothing is kept or reused while a variable asks the lowering to report as
-- it goes, since a hit would skip the report.
local sharedcache = require("nupp.core.sharedcache")
local kernelcompiler = require("nupp.core.kernelcompiler")
local fingerprint = require("nupp.compiler.project.fingerprint")

-- Entries are the host's durable data encoding (`nupp.vm.persist`), which a
-- program carrying the compiler (some 150 MB of selection) reads in about a
-- second where JSON took a minute, and writes as fast where JSON took two. Its
-- records restore as plain tables in any process. A host without it keeps
-- nothing.
local persisted, persist = pcall(require, "nupp.vm.persist")

-- Bumped when an entry's shape or meaning changes.
const FORMAT = "guest-selection/3"
const KIND = "programs"
-- The trees the guest project (tests/core/units/nupp.lua) resolves
-- modules from, relative to the checkout root.
const INPUTS = {"src", "native", "nupp.lua", "tests/core", "tests/fixtures/nativeheap"}
const REPORTING = {"EMIT_SURVEY", "EMIT_TRACE", "EMIT_STUBS", "DEBUG_REGS", "NUPP_CORE_SYMBOLS", "NUPP_MIR_OUT"}
const GENERATION = "/(%x+)/compiler%.image$"
const GENERATION_LENGTH = 64

local contentDigest = fingerprint.contentDigest(true)

-- The installed generation the producer runs on, when the image and runtime
-- are one generation's pair; anything else keeps nothing.
local function generation(): string?
    local image, runtime = os.getenv("NUPP_VM_CLI_IMAGE"), os.getenv("NUPP_VM_BINARY")
    if image == nil or runtime == nil then
        return nil
    end
    local named = image:match(GENERATION)
    if named == nil or #named ~= GENERATION_LENGTH or runtime ~= image:gsub("compiler%.image$", "runtime") then
        return nil
    end

    return named
end

local base: string? = nil
local disabled = false

-- What every key in this process shares, computed once; nil when nothing may
-- be kept.
local function shared(root: string): string?
    if disabled or not persisted then
        return nil
    end
    if base then
        return base
    end
    for _, variable in ipairs(REPORTING) do
        if os.getenv(variable) then
            disabled = true
            return nil
        end
    end
    local named = generation()
    local inputs = named and sharedcache.treeDigest(root, INPUTS)
    if not inputs then
        disabled = true
        return nil
    end
    -- The kernels' compiler part, pinned or not, as the unit runner keys them.
    local kernels, reusable = kernelcompiler.keyed(root)
    disabled = not reusable
    if disabled then
        return nil
    end
    base = contentDigest(table.concat({FORMAT, named as string, inputs as string, kernels}, "\0"))

    return base
end

local function keyOf(root: string, parts: {string}): string?
    local common = shared(root)
    if not common then
        return nil
    end

    return contentDigest(common .. "\0" .. table.concat(parts, "\0")) .. ".bin"
end

-- Two values that are the same data, numbers by their subtype too: what a
-- kept selection must be of the one it was made from.
local function same(a: any, b: any): boolean
    if type(a) ~= type(b) then
        return false
    elseif type(a) == "number" then
        return math.type(a) == math.type(b) and a == b
    elseif type(a) ~= "table" then
        return a == b
    end
    for key, value in pairs(a as table) do
        if not same(value, (b as table)[key]) then
            return false
        end
    end
    for key in pairs(b as table) do
        if (a as table)[key] == nil then
            return false
        end
    end

    return true
end

-- A durable encoding holds at most 256 MB, which the selection of a program
-- carrying the compiler CLI passes: an entry is the selection without its
-- programs, then its programs in pieces of about this many bytes of code.
const PIECE_BYTES = 64 * 1048576
-- What a program record holds besides its code, near enough.
const RECORD_BYTES = 4096

-- The selection and `extra` as pieces of durable encoding: first the selection
-- without its programs with `extra` and the program count, then the programs in
-- order. Nil when one cannot be encoded.
local function encodePieces(selection: any, extra: any): {string}?
    local programs: {any} = selection.programs or {}
    local head: {[any]: any} = {}
    for name, value in pairs(selection as table) do
        if name ~= "programs" then
            head[name] = value
        end
    end
    local values: {any} = {{selection = head, extra = extra, programs = #programs}}
    local chunk: {any} = {}
    local size = 0
    for _, program in ipairs(programs) do
        chunk[#chunk + 1] = program
        size = size + #(program.codeHex or "") + RECORD_BYTES
        if size >= PIECE_BYTES then
            values[#values + 1], chunk, size = chunk, {}, 0
        end
    end
    if #chunk > 0 then
        values[#values + 1] = chunk
    end
    local pieces: {string} = {}
    for index, value in ipairs(values) do
        local encoded, bytes = pcall(persist.saveData, value)
        if not encoded then
            return nil
        end
        pieces[index] = bytes
    end

    return pieces
end

-- The selection and `extra` the pieces encode, or nil.
local function decodePieces(pieces: {string}): (any, any)
    local decoded, first = pcall(persist.loadData, pieces[1] or "")
    if not decoded or type(first) ~= "table" or type(first.selection) ~= "table" then
        return nil, nil
    end
    local selection, programs = first.selection, {}
    for index = 2, #pieces do
        local ok, chunk = pcall(persist.loadData, pieces[index])
        if not ok or type(chunk) ~= "table" then
            return nil, nil
        end
        for _, program in ipairs(chunk as {any}) do
            programs[#programs + 1] = program
        end
    end
    if #programs ~= first.programs then
        return nil, nil
    end
    selection.programs = programs

    return selection, first.extra
end

-- The kept selection for `parts` (case, mode, capacity, build kind) and the
-- extra fields kept beside it, or nil. An entry whose pieces do not match their
-- seal, or do not decode, is a miss.
export function lookup(root: string, parts: {string}): (any, any)
    local key = keyOf(root, parts)
    local text = key and sharedcache.get(sharedcache.directory(KIND), key as string)
    if not text then
        return nil, nil
    end
    local length = tonumber(text:match("^(%d+)\n"))
    local opened, envelope = false, nil
    if length then
        local at = #tostring(length) + 2
        opened, envelope = pcall(persist.loadData, text:sub(at, at + length - 1))
        envelope = opened and type(envelope) == "table" and envelope or nil
        if envelope then
            envelope.body = text:sub(at + length)
        end
    end
    if not envelope
        or envelope.format ~= FORMAT
        or type(envelope.lengths) ~= "table"
        or envelope.seal ~= contentDigest(envelope.body)
    then
        return nil, nil
    end
    local pieces: {string} = {}
    local at = 1
    for index, size in ipairs(envelope.lengths as {integer}) do
        pieces[index] = (envelope.body as string):sub(at, at + size - 1)
        at = at + size
    end
    local selection, extra = decodePieces(pieces)
    if selection == nil then
        return nil, nil
    end
    sharedcache.touch(sharedcache.directory(KIND), {key as string})

    return selection, extra
end

-- Keeps `selection` for `parts`, with `extra` beside it, when it reads back as
-- the same data: a value the encoding cannot carry exactly is not kept. The
-- pieces are sealed with their digest.
export function keep(root: string, parts: {string}, selection: any, extra: any): boolean
    local key = keyOf(root, parts)
    if not key then
        return false
    end
    local pieces = encodePieces(selection, extra)
    local decoded, decodedExtra = nil, nil
    if pieces then
        decoded, decodedExtra = decodePieces(pieces as {string})
    end
    if decoded == nil or not same(decoded, selection) or not same(decodedExtra, extra) then
        io.stderr:write("guest selection not kept: it does not read back as itself\n")
        return false
    end
    local lengths: {integer} = {}
    for index, piece in ipairs(pieces as {string}) do
        lengths[index] = #piece
    end
    local body = table.concat(pieces as {string})
    local header = persist.saveData({format = FORMAT, seal = contentDigest(body), lengths = lengths})
    local kept = sharedcache.put(
        sharedcache.directory(KIND),
        key as string,
        tostring(#header) .. "\n" .. header .. body
    )
    sharedcache.sweep(root)

    return kept
end
