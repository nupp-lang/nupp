module nupp.core.rawshapegen

local schema = require("nupp.compiler.vm.coregraphschema")

-- Each packed rule is offset:8, action:4, target:5, countOffset:7,
-- reserved:8, limit:32. Values come only from canonical wire descriptors.
export function source(): string
    local wire = schema.wire()
    local lines = {
        "module nupp.runtime.core.rawroles",
        "",
        "-- Generated by nupp.core.rawshapegen from coregraphschema.wire().",
        "-- Physical shape only; no SSA or executable opcode semantics.",
        ""
    }

    local function line(text: string): nil
        lines[#lines + 1] = text
    end

    local ids = {}
    for index, name in ipairs(wire.shape.roles) do
        ids[name] = index - 1
        line("export const R_" .. name .. " = " .. tostring(index - 1) .. "ULL")
    end
    line("export const absent = " .. tostring(wire.absent) .. "ULL")
    line("export const stringItemLimit = " .. tostring(wire.shape.stringItemLimit) .. "ULL")
    for _, section in ipairs(wire.sections) do
        for _, field in ipairs(section.fields) do
            line("export const F_" .. section.name .. "_" .. field.name .. " = " .. tostring(field.offset) .. "ULL")
        end
    end
    line("")
    for _, property in ipairs({"rootLimit", "fieldCount"}) do
        line("export function " .. property .. "(section: uint64): uint64")
        for index, section in ipairs(wire.sections) do
            local value = property == "fieldCount" and #section.fields or section.rootLimit or wire.absent
            line((index == 1 and "    if" or "    elseif") .. " section == " .. tostring(section.id) .. "ULL then")
            line("        return " .. tostring(value) .. "ULL")
        end
        line("    end")
        line("")
        line("    return 4294967295ULL")
        line("end")
        line("")
    end
    line("export function field(section: uint64, index: uint64): uint64")
    for index, section in ipairs(wire.sections) do
        line((index == 1 and "    if" or "    elseif") .. " section == " .. tostring(section.id) .. "ULL then")
        for fi, field in ipairs(section.fields) do
            local role = field.role
            local low = field.offset + assert(
                ids[role.kind]
            ) * 256 + (role.target or 0) * 4096 + (role.countOffset or 0) * 131072
            local limit = role.limit or 0
            assert(field.offset < 256 and (role.target or 0) < 32 and (role.countOffset or 0) < 128)
            assert(limit >= 0 and limit <= 4294967295 and limit % 1 == 0)
            line((fi == 1 and "        if" or "        elseif") .. " index == " .. tostring(fi - 1) .. "ULL then")
            line("            return 0x" .. string.format("%x%08x", limit, low) .. "ULL")
        end
        if #section.fields > 0 then
            line("        end")
        end
    end
    line("    end")
    line("")
    line("    return 0ULL")
    line("end")

    return table.concat(lines, "\n") .. "\n"
end
