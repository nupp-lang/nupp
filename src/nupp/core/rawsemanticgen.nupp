module nupp.core.rawsemanticgen

local schema = require("nupp.compiler.vm.coregraphschema")

export function source(): string
    local definition, validation, wire = schema.describe(), schema.validationPolicy(), schema.wire()
    local lines = {
        "module nupp.runtime.core.rawsemanticpolicy",
        "",
        "-- Generated validation data. No opcode execution or source authority.",
        ""
    }

    local function constant(name: string, value: number): nil
        assert(value >= 0 and value <= 4294967295 and value % 1 == 0)
        if lines[#lines] == "end" then
            lines[#lines + 1] = ""
        end
        lines[#lines + 1] = "export const " .. name .. " = " .. value .. "ULL"
    end

    local function packed(name: string, values: any): nil
        assert(#values > 0 and #values <= 5)
        local parts = {}
        for index = math.min(#values, 4), 1, -1 do
            local value = values[index]
            assert(value >= 0 and value <= 65535 and value % 1 == 0)
            parts[#parts + 1] = string.format("%04x", value)
        end
        lines[#lines + 1] = ""
        lines[#lines + 1] = "export function " .. name .. "(id: uint64): uint64"
        lines[#lines + 1] = "    if id >= " .. #values .. "ULL then"
        lines[#lines + 1] = "        return 4294967295ULL"
        lines[#lines + 1] = "    end"
        if #values == 5 then
            lines[#lines + 1] = "    if id == 4ULL then"
            lines[#lines + 1] = "        return " .. values[5] .. "ULL"
            lines[#lines + 1] = "    end"
            lines[#lines + 1] = ""
        end
        lines[#lines + 1] = "    return (0x" .. table.concat(parts) .. "ULL >> (id * 16ULL)) & 65535ULL"
        lines[#lines + 1] = "end"
    end

    assert(definition.limits.blocks <= 65535)
    -- A value's word packs its block epoch in the low 16 bits and its kind
    -- (a scalar kind, or a function: Kind_function plus the owner) in the 32
    -- above, so owners stay well inside the kind field.
    assert(#definition.scalarKinds + definition.limits.owners <= 4294967295)
    constant("epochMask", 65535)
    constant("kindMask", 4294967295)
    constant("kindShift", 16)
    constant("maximumKind", #definition.scalarKinds + definition.limits.owners)
    local scalar = {}
    for index, kind in ipairs(definition.scalarKinds) do
        assert(kind.id == index - 1)
        scalar[kind.name] = index
        constant("Kind_" .. kind.name, index)
    end
    constant("Kind_function", #definition.scalarKinds + 1)
    local modes = {constant = 2, ["nil"] = 4, copy = 8, ["function"] = 16, module = 32}
    for _, mode in ipairs({"constant", "nil", "copy", "function", "module"}) do
        constant("P_" .. mode, modes[mode])
    end
    constant("P_read", 1)
    local operations = {}
    assert(#validation == #definition.operations)
    for index, operation in ipairs(validation) do
        assert(operation.id == index - 1 and operation.name == definition.operations[index].name)
        assert(operation.result == "V" and #operation.args <= 1, "semantic validation result/arity changed")
        local flags = assert(modes[operation.provenance], "unknown provenance recipe")
        if #operation.args == 1 and operation.args[1] == "v" then
            flags += 1
        else
            assert(#operation.args == 0 or operation.args[1] == "k" or operation.args[1] == "n")
        end
        assert((operation.provenance == "copy") == (flags % 2 == 1))
        operations[index] = flags
    end
    packed("operation", operations)
    local constants = {}
    for index, kind in ipairs(wire.constantKinds) do
        assert(kind.id == index - 1)
        assert(kind.name == "nil" or kind.name == "true" or kind.name == "false" or kind.name == "str")
        constants[index] = kind.name == "str" and 0 or assert(scalar[kind.name == "nil" and "nil" or "boolean"])
    end
    packed("constantKind", constants)
    -- Terminator control classes come from the existing canonical term view.
    local termModes = {["return"] = 1, jump = 0, branch = 2, invoke = 4}
    constant("T_return", 1)
    constant("T_branch", 2)
    constant("T_invoke", 4)
    local terms = {}
    for index, term in ipairs(definition.terms) do
        assert(term.id == index - 1)
        terms[index] = assert(termModes[term.name], "unknown terminator validation class")
    end
    packed("term", terms)

    return table.concat(lines, "\n") .. "\n"
end
