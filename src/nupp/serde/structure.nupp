module nupp.serde.structure

local core = require("nupp.serde.value")

export type Has<T> = function(borrows value: T): boolean
export type BorrowGet<T, V is nupp.Copyable> = function(borrows value: T): V borrows (value)
export type CopyGet<T, V is nupp.Copyable> = function(borrows value: T): V
export record BorrowedGet<T, V is nupp.Copyable>
    @readonly kind: "borrowed" = "borrowed"
    @readonly read: BorrowGet<T, V>
end
export record CopiedGet<T, V is nupp.Copyable>
    @readonly kind: "copied" = "copied"
    @readonly read: CopyGet<T, V>
end
export type Get<T, V is nupp.Copyable> = BorrowedGet<T, V> | CopiedGet<T, V>
export function borrowedGet<T, V is nupp.Copyable>(read: BorrowGet<T, V>): Get<T, V>
    return new BorrowedGet<T, V>(read = read)
end

export function copiedGet<T, V is nupp.Copyable>(read: CopyGet<T, V>): Get<T, V>
    return new CopiedGet<T, V>(read = read)
end

export type Set<S, V is nupp.Copyable> = function(exclusive state: S, value: V): nil

export interface Construction<T, S is nupp.Closeable>
    begin: function(self): S
    finish: function(self, takes state: S): T
end

export interface FieldConsumer<T, S is nupp.Closeable, M is core.Member, R>
    apply: function<V is nupp.Copyable>(
        self,
        member: M,
        has: Has<T>,
        get: Get<T, V>,
        set: Set<S, V>,
        adapter: core.Adapter<V, M>,
        fallback: (function(): V)?
    ): R
end

export interface Field<T, S is nupp.Closeable, M is core.Member> is core.Child<M>
    write: function(self, borrows source: T, exclusive writer: core.Writer<M>): nil
    read: function(self, exclusive state: S, exclusive reader: core.Reader<M>): nil
    accept: function<R>(self, consumer: FieldConsumer<T, S, M, R>): R
end

local record Projected<T, S is nupp.Closeable, V is nupp.Copyable, M is core.Member> is Field<T, S, M>
    @readonly member: M
    @readonly required: boolean
    @readonly hasDefault: boolean
    @readonly get: Get<T, V>
    @readonly present: Has<T>?
    @readonly set: Set<S, V>
    @readonly adapter: core.Adapter<V, M>
    function describe(self, direction: core.Direction): core.Description<M>
        return self.adapter:describe(direction)
    end

    function write(self, borrows source: T, exclusive writer: core.Writer<M>): nil
        local present = self.present
        if present ~= nil and not present(source) then
            return
        end
        local get = self.get
        if get.kind == "borrowed" then
            self.adapter:write(get.read(source), writer)
        else
            self.adapter:write(get.read(source), writer)
        end
    end

    function read(self, exclusive state: S, exclusive reader: core.Reader<M>): nil
        self.set(state, self.adapter:read(reader))
    end

    function accept<R>(self, consumer: FieldConsumer<T, S, M, R>): R
        return consumer:apply<V>(
            self.member,
            self.present or function(borrows source: T): boolean
                return true
            end,
            self.get,
            self.set,
            self.adapter,
            nil
        )
    end
end

export function field<T, S is nupp.Closeable, V is nupp.Copyable, M is core.Member>(
    member: M,
    get: BorrowGet<T, V>,
    set: Set<S, V>,
    adapter: core.Adapter<V, M>,
    required: boolean,
    hasDefault: boolean,
    present: Has<T>?
): Field<T, S, M>
    return new Projected<T, S, V, M>(
        member = member,
        get = borrowedGet<T, V>(get),
        present = present,
        set = set,
        adapter = adapter,
        required = required,
        hasDefault = hasDefault
    )
end

export interface Consumer<T, M is core.Member, R>
    apply: function<S is nupp.Closeable>(
        self,
        member: M,
        fields: const{Field<T, S, M>},
        construction: Construction<T, S>,
        unknown: core.UnknownConsumer<S>,
        additional: core.Members<M, T>?
    ): R
end

local interface Operations<T, M is core.Member>
    inspect: function<R>(self, consumer: Consumer<T, M, R>): R
end

local record Description<M is core.Member> is core.Description<M>
    @readonly kind: core.Kind = "structure"
    @readonly member: M
    @readonly nullable: boolean = false
    @readonly width: integer?
    @readonly signed: boolean?
    @readonly canRead: boolean = true
    @readonly children: const{core.Child<M>}
end

local record Emit<T, S is nupp.Closeable, M is core.Member> is core.Members<M, T>
    @readonly fields: const{Field<T, S, M>}
    @readonly additional: core.Members<M, T>?
    function apply(self, borrows source: T, exclusive writer: core.Writer<M>): nil
        for _, item in ipairs(self.fields) do
            if writer:include(item.member) then
                item:write(source, writer)
            end
        end
        local additional = self.additional
        if additional ~= nil then
            additional:apply(source, writer)
        end
    end
end

local record Read<T, S is nupp.Closeable, M is core.Member> is core.MemberConsumer<M, S>
    @readonly byMember: {[M]: Field<T, S, M>}
    function apply(self, exclusive state: S, member: M, exclusive reader: core.Reader<M>): nil
        assert(self.byMember[member], "foreign structure member"):read(state, reader)
    end
end

local record Reject<S is nupp.Closeable> is core.UnknownConsumer<S>
    function apply<F is core.WireField>(
        self,
        exclusive state: S,
        identity: F,
        exclusive reader: core.UnknownReader
    ): nil
        error("unknown member: " .. identity:diagnosticLabel(), 2)
    end
end

local record Adapter<T, S is nupp.Closeable, M is core.Member> is core.Adapter<T, M>, Operations<T, M>
    @readonly description: Description<M>
    @readonly deferredConstruction: boolean
    @readonly fields: const{Field<T, S, M>}
    @readonly construction: Construction<T, S>
    @readonly emit: Emit<T, S, M>
    @readonly consume: Read<T, S, M>
    @readonly unknown: core.UnknownConsumer<S>
    function describe(self, direction: core.Direction): core.Description<M>
        return self.description
    end

    function write(self, borrows source: T, exclusive writer: core.Writer<M>): nil
        writer:writeStruct(self.description.member, source, self.emit)
    end

    function read(self, exclusive reader: core.Reader<M>): T
        local state = self.construction:begin()
        reader:readStruct(self.description.member, state, self.consume, self.unknown)
        return self.construction:finish(state)
    end

    function inspect<R>(self, consumer: Consumer<T, M, R>): R
        return consumer:apply(
            self.description.member,
            self.fields,
            self.construction,
            self.unknown,
            self.emit.additional
        )
    end
end

export function adapter<T, S is nupp.Closeable, M is core.Member>(
    member: M,
    fields: const{Field<T, S, M>},
    construction: Construction<T, S>,
    unknown: core.UnknownConsumer<S>?,
    additional: core.Members<M, T>?,
    deferredConstruction: boolean?
): core.Adapter<T, M>
    local ordered: {Field<T, S, M>} = {}
    local byMember: {[M]: Field<T, S, M>} = {}
    local children: {core.Child<M>} = {}
    for index, item in ipairs(fields) do
        assert(byMember[item.member] == nil, "duplicate structure member")
        ordered[index] = item
        byMember[item.member] = item
        children[index] = item
    end

    return new Adapter<T, S, M>(
        description = new Description<M>(member = member, children = children),
        deferredConstruction = deferredConstruction == true,
        fields = ordered,
        construction = construction,
        emit = new Emit<T, S, M>(fields = ordered, additional = additional),
        consume = new Read<T, S, M>(byMember = byMember),
        unknown = unknown or new Reject<S>()
    )
end

export function inspect<T, M is core.Member, R>(selected: core.Adapter<T, M>, consumer: Consumer<T, M, R>): R?
    if getmetatable(selected) ~= Adapter then
        return nil
    end
    return (selected as Operations<T, M>):inspect(consumer)
end

-- Opting in promises that field setters can run after syntax validation, in
-- declaration order. The default retains the visitor's immediate callbacks.
export function canDefer<T, M is core.Member>(selected: core.Adapter<T, M>): boolean
    return getmetatable(selected) == Adapter and (selected as Adapter<T, nupp.Closeable, M>).deferredConstruction
end

export function rejectsUnknown<S is nupp.Closeable>(consumer: core.UnknownConsumer<S>): boolean
    return getmetatable(consumer) == Reject
end
