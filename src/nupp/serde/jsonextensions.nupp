module nupp.serde.jsonextensions

local core = require("nupp.serde.value")
local plans = require("nupp.serde.jsonplan")
local errors = require("nupp.serde.errors")
local encoding = require("nupp.serde.jsonencoder")
local lowering = require("nupp.serde.jsonlower")
local compiled = require("nupp.serde.jsoncompiled")

export record Operation<T, M is core.Member>
    @readonly policy: plans.Policy<M>
    @readonly plan: plans.Plan<M>
    @readonly native: compiled.Decoder<T>?
    @readonly encoding: lowering.Encoding<T>?
end

local record Slot
    state: "initializing" | "ready" | "failed"
    value: unknown
end

local record Entry
    used: integer
    write: Slot?
    read: Slot?
end

export interface Scope
    resolve: function<T, M is core.Member>(
        self,
        adapter: core.Adapter<T, M>,
        direction: core.Direction
    ): Operation<T, M>
    clear: function(self): nil
    size: function(self): integer
    profile: function(self): plans.PolicyFactory
end

local function initialize<T, M is core.Member>(
    adapter: core.Adapter<T, M>,
    factory: plans.PolicyFactory,
    direction: core.Direction
): Operation<T, M>
    local description = adapter:describe(direction)
    local policy = factory:policy<M>(description.member)
    local plan = plans.resolve(description, policy, direction)
    return new Operation<T, M>(
        policy = policy,
        plan = plan,
        native = direction == "read" and compiled.select(adapter, plan) or nil,
        encoding = direction == "write" and encoding.select(adapter, plan) or nil
    )
end

local record Cache is Scope
    @readonly factory: plans.PolicyFactory
    @readonly capacity: integer
    entries: {[unknown]: Entry}
    clock: integer
    count: integer
    active: integer
    lastAdapter: unknown = nil
    lastEntry: Entry?

    function profile(self): plans.PolicyFactory
        return self.factory
    end

    function size(self): integer
        return self.count
    end

    function clear(self): nil
        assert(self.active == 0, "JSON extensions are initializing")
        self.entries, self.count, self.clock = {}, 0, 0
        self.lastAdapter, self.lastEntry = nil, nil
    end

    function evict(self): nil
        local oldest: unknown = nil
        local age = self.clock + 1
        for adapter, entry in pairs(self.entries) do
            local busy = entry.write ~= nil and entry.write.state == "initializing"
                or entry.read ~= nil and entry.read.state == "initializing"
            if not busy and entry.used < age then
                oldest, age = adapter, entry.used
            end
        end
        assert(oldest ~= nil, "JSON extension capacity exhausted by active initialization")
        self.entries[oldest] = nil
        if self.lastAdapter == oldest then
            self.lastAdapter, self.lastEntry = nil, nil
        end
        self.count -= 1
    end

    function resolve<T, M is core.Member>(self, adapter: core.Adapter<T, M>, direction: core.Direction): Operation<T, M>
        local latest = self.lastEntry
        if self.lastAdapter == adapter and latest ~= nil then
            local hot: Slot?
            if direction == "write" then
                hot = latest.write
            else
                hot = latest.read
            end
            if hot ~= nil then
                if hot.state == "ready" then
                    -- Reusing the most recent entry changes no LRU ordering.
                    return hot.value as Operation<T, M>
                elseif hot.state == "failed" then
                    error(hot.value, 0)
                else
                    -- The initializing case follows the reentrancy guard below.
                    assert(hot.state == "initializing")
                end
            end
        end
        self.clock += 1
        local entry = self.entries[adapter]
        if entry == nil then
            if self.count >= self.capacity then
                self:evict()
            end
            entry = new Entry(used = self.clock)
            self.entries[adapter] = entry
            self.count += 1
        end
        entry.used = self.clock
        self.lastAdapter, self.lastEntry = adapter, entry
        local slot: Slot? = nil
        if direction == "write" then
            slot = entry.write
        else
            slot = entry.read
        end
        if slot ~= nil then
            if slot.state == "ready" then
                -- The adapter identity fixes its private member type. Scope
                -- identity fixes the backend and immutable profile; direction
                -- selects a separate slot. No value is retained in this cache.
                return slot.value as Operation<T, M>
            elseif slot.state == "failed" then
                error(slot.value, 0)
            else
                error("recursive JSON extension initialization", 2)
            end
        end
        slot = new Slot(state = "initializing", value = nil)
        if direction == "write" then
            entry.write = slot
        else
            entry.read = slot
        end
        self.active += 1
        local ok, result = pcall(initialize, adapter, self.factory, direction)
        self.active -= 1
        if not ok then
            result = errors.wrap(result, "$", nil)
        end
        slot.state = ok and "ready" or "failed"
        slot.value = result
        if not ok then
            error(result, 0)
        end

        return result as Operation<T, M>
    end
end

export function scope(factory: plans.PolicyFactory, capacity: integer?): Scope
    local limit = capacity or 256
    assert(limit > 0, "JSON extension capacity must be positive")
    return new Cache(factory = factory, capacity = limit, entries = {}, clock = 0, count = 0, active = 0)
end
