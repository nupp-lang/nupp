module nupp.serde.view

local core = require("nupp.serde.value")
local documents = require("nupp.serde.document")
local bridge = require("nupp.serde.documentcodec")

-- Views retain a copyable owner. Reads observe its current state; snapshots
-- reconstruct an independent value through the same explicit binding.
export record View<T is nupp.Copyable>
    @readonly binding: core.Binding<T>
    @private @readonly value: T
    @private @readonly source: core.Context?
    function context(self): core.Context?
        return self.source
    end

    function document(self): documents.Document
        return bridge.fromBinding(self.binding, self.value, self.source)
    end

    function snapshot(self): View<T>
        return new View<T>(
            binding = self.binding,
            value = bridge.into(self.binding, self:document()),
            source = self.source
        )
    end
end

local record Contents<T is nupp.Copyable, M is core.Member> is core.Adapter<View<T>, M>
    @readonly binding: core.Binding<T>
    @readonly original: core.Adapter<T, M>
    function describe(self, direction: core.Direction): core.Description<M>
        return self.original:describe(direction)
    end

    function write(self, borrows value: View<T>, exclusive writer: core.Writer<M>): nil
        assert(value.binding == self.binding, "typed document belongs to another binding")
        self.original:write(value.value, writer)
    end

    function read(self, exclusive reader: core.Reader<M>): View<T>
        return new View<T>(binding = self.binding, value = self.original:read(reader), source = reader:context())
    end
end
local record Select<T is nupp.Copyable> is core.Consumer<T, nil, nil>
    @readonly binding: core.Binding<T>
    result: core.Binding<View<T>>?
    function apply<M is core.Member>(self, adapter: core.Adapter<T, M>, borrows state: nil): nil
        self.result = new core.Bound<View<T>, M>(
            adapter = new Contents<T, M>(binding = self.binding, original = adapter)
        )
    end
end
local record Adapter<T is nupp.Copyable> is core.DocumentAdapter<View<T>>
    @readonly binding: core.Binding<T>
    @readonly selected: core.Binding<View<T>>
    function context(self, borrows document: View<T>): core.Context?
        assert(document.binding == self.binding, "typed document belongs to another binding")
        return document:context()
    end

    function contents(self): core.Binding<View<T>>
        return self.selected
    end

    function readContents(self, exclusive reader: core.DocumentReader): View<T>
        local source = reader:context()
        local logical = documents.documentAdapter():readContents(reader)
        return new View<T>(binding = self.binding, value = bridge.into(self.binding, logical), source = source)
    end

    function discard(self, takes value: View<T>): nil
        local _copy = @unsafe nupp.release(value)
    end
end
export function of<T is nupp.Copyable>(binding: core.Binding<T>, value: T, context: core.Context?): View<T>
    return new View<T>(binding = binding, value = value, source = context)
end

export function adapter<T is nupp.Copyable>(binding: core.Binding<T>): core.DocumentAdapter<View<T>>
    local select = new Select<T>(binding = binding)
    binding:accept(select, nil)
    return new Adapter<T>(binding = binding, selected = assert(select.result))
end
