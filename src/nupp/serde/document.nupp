module nupp.serde.document

--[[
A document is a value without a schema, which any codec reads and writes. This
module holds the [](Document) tree, conversion between bound values and
documents, typed views, and saved [](nupp.util.Store) snapshots; see
[serde.md](docs/learn/runtime/data/serde.md#documents) for the guide.

```nupp
local document = require("nupp.serde.document")
local json = require("nupp.serde.json")
local value = json.decodeDocument(document.adapter(), '{"id":18446744073709551615,"tags":["a","b"]}')
assert(value.kind == "structure")
assert(assert(value:get("id")):numberToken() == "18446744073709551615")
assert(assert(value:get("tags")):at(2):string() == "b")
assert(json.encodeDocument(document.adapter(), value) == '{"id":18446744073709551615,"tags":["a","b"]}')
```

A document keeps what the codec read without rounding it: integers beyond 2^53
stay exact, decimals keep their digits, floats keep their width, and absent,
null, and present members stay distinct. It also keeps the
[](nupp.serde.Context) it was read under, so a protocol can tell where it came
from.

A document-valued member, one a schema declares without describing, is a
document *boundary*: [](boundary) wraps its contents so a protocol can treat
the member separately from the value inside it.

[](from) and [](into) cross between a bound value and its document, which is
how a value moves between codecs or is inspected without knowing its type:

```nupp
local serde = require("nupp.serde")
local document = require("nupp.serde.document")
local record Point
    x: integer
    y: integer
end
local points = serde.binding(Point)
local tree = document.from(points, new Point(x = 1, y = 2))
assert(assert(tree:get("y")):numberToken() == "2")
assert(document.into(points, tree).x == 1)
```
]]

local documents = require("nupp.serde.internal.document")
local readers = require("nupp.serde.internal.documentreader")
local writers = require("nupp.serde.internal.documentwriter")
local reconstruction = require("nupp.serde.internal.documentcodec")
local views = require("nupp.serde.internal.view")
local persistence = require("nupp.serde.internal.persistence")

--- An immutable value tree.
---
--- `kind` says which accessor applies: `string()` for a string, `at(i)` and
--- `size()` for a list or tuple, `get(name)` and `field(i)` for a structure,
--- `entry(i)` for a map, `document()` for a boundary. `get` returns nil on any
--- other kind; a scalar accessor raises on a document of another kind.
export type Document = documents.Document

export const Document = documents.Document

--- A named structure member, as [](object) takes and `Document:field` returns.
export type Entry = documents.Entry

export const Entry = documents.Entry

--- A map entry, whose key is itself a document.
export type MapEntry = documents.MapEntry

export const MapEntry = documents.MapEntry

--- Returns the adapter that reads and writes a [](Document) as its contents.
---
--- Pass it to a codec's `encodeDocument` and `decodeDocument`, or to
--- [](nupp.serde.adapters.document) for a document-valued member.
---
--- @return the shared adapter
export const adapter = documents.documentAdapter

--- A null.
export const null = documents.null

--- A boolean.
export const boolean = documents.boolean

--- A string.
export const string = documents.string

--- A number kept as the lexeme it was written as, such as a JSON number too
--- large for any integer width.
export const numberToken = documents.numberToken

--- A fixed-width integer.
export const integer = documents.integer

--- A float with its width.
export const float = documents.float

--- An exact decimal.
export const decimal = documents.decimal

--- An integer of unbounded size, from its decimal text.
--- @raises string when the text is not an integer
export const bigInteger = documents.bigInteger

--- Binary data.
export const bytes = documents.bytes

--- A timestamp.
export const timestamp = documents.timestamp

--- A model-defined atom, snapshotted so the document owns it.
export const atom = documents.atom

--- A list.
export const list = documents.list

--- A tuple: a list whose length is part of its shape.
export const tuple = documents.tuple

--- A structure, from its members in order.
---
--- ```nupp
--- local document = require("nupp.serde.document")
--- local json = require("nupp.serde.json")
--- local value = document.object({
---     new document.Entry(name = "ok", value = document.boolean(true)),
---     new document.Entry(name = "note", value = document.null())
--- })
--- assert(json.encodeDocument(document.adapter(), value) == '{"ok":true,"note":null}')
--- ```
---
--- @raises string when two members share a name
export const object = documents.object

--- A union: the one member that is set.
export const union = documents.union

--- A map whose keys are documents.
--- @raises string when two keys are equal
export const map = documents.map

--- A document boundary around contents, for a document-valued member.
export const boundary = documents.document

--- The same document with a context attached.
export const withContext = documents.withContext

--- Converts a bound value to its document.
---
--- @param binding the value's binding
--- @param value the value
--- @param context the context to attach, or nil
--- @return the document
export const from = writers.fromBinding

--- Constructs a bound value from a document.
---
--- The binding's construction runs exactly as a decoder's would, so
--- required fields and defaults are checked the same way.
---
--- @param binding the binding to construct through
--- @param value the document
--- @return the value
--- @raises nupp.serde.Error when the document does not fit the binding
export const into = reconstruction.into

--- Constructs values of one binding from documents, without looking the
--- binding up each time.
export type Decoder<T> = reconstruction.Decoder<T>

--- Returns a binding's [](Decoder), cached by binding identity.
---
--- The cache keeps at most 256 bindings and evicts the least recently used.
--- @param binding the binding
--- @return the decoder
export const decoder = reconstruction.decoder

--- Empties the [](decoder) cache. Decoders already handed out keep working.
--- @raises string when called while a decoder is being built
export const clear = reconstruction.clear

--- Returns how many bindings the [](decoder) cache holds.
export const cachedBindings = reconstruction.cachedBindings

--- Reads a document through the [](nupp.serde.DocumentReader) contract, as a
--- codec's own reader would.
export const reader = readers.reader

--- Copies a document into one that owns all of its values.
export const snapshot = readers.snapshot

--- A bound value presented as a document, without building the tree.
---
--- A codec reads the current value through the binding each time, so a view
--- follows changes to its owner. `snapshot()` reconstructs a detached copy,
--- and `document()` materializes the tree when one is wanted.
---
--- ```nupp
--- local serde = require("nupp.serde")
--- local document = require("nupp.serde.document")
--- local json = require("nupp.serde.json")
--- local record Counter
---     count: integer
--- end
--- local counters = serde.binding(Counter)
--- local owner = new Counter(count = 1)
--- local live = document.view(counters, owner)
--- local frozen = live:snapshot()
--- owner.count = 2
--- local views = document.viewAdapter(counters)
--- assert(json.encodeDocument(views, live) == '{"count":2}')
--- assert(json.encodeDocument(views, frozen) == '{"count":1}')
--- ```
export type View<T is nupp.Copyable> = views.View<T>

export const View = views.View

--- Presents a Copyable value as a [](View).
---
--- @param binding the value's binding
--- @param value the value, which the view keeps
--- @param context the context to attach, or nil
--- @return the view
export const view = views.of

--- Returns the document adapter for views of one binding.
---
--- @param binding the binding the views were made with
--- @return the adapter
export const viewAdapter = views.adapter

--- Saves and restores the entries of a [](nupp.util.Store) by name and
--- version.
---
--- Each registered key names its entry, its binding, its current version, and
--- the migration that upgrades an older one. Saving produces a
--- [](StoreSnapshot) any codec can carry through [](storeBinding).
---
--- ```nupp
--- local serde = require("nupp.serde")
--- local document = require("nupp.serde.document")
--- local json = require("nupp.serde.json")
--- local record Settings
---     volume: integer
--- end
--- local settings: nupp.util.Key<Settings> = nupp.util.newKey()
--- local registry = document.storeRegistry()
--- registry:register("settings", settings, serde.binding(Settings), 1, nil)
---
--- local store = nupp.util.newStore()
--- store:set(settings, new Settings(volume = 7))
--- local bytes = json.encode(document.storeBinding(), registry:save(store))
---
--- local restored = registry:load(json.decode(document.storeBinding(), bytes), "reject")
--- assert(assert(restored:get(settings)).volume == 7)
--- ```
export type StoreRegistry = persistence.Registry

--- Starts an empty [](StoreRegistry).
export const storeRegistry = persistence.registry

--- The saved entries of a store.
export type StoreSnapshot = persistence.Snapshot

export const StoreSnapshot = persistence.Snapshot

--- One saved store entry: its name, version, and document.
export type StoreEntry = persistence.Entry

export const StoreEntry = persistence.Entry

--- Upgrades a saved entry from an older version to the current one.
export type Migration = persistence.Migration

--- Returns the binding a codec writes and reads a [](StoreSnapshot) through.
export const storeBinding = persistence.binding
