module nupp.serde.internal.documentreader

local core = require("nupp.serde.internal.value")
local publication = require("nupp.serde.internal.publication")
local documents = require("nupp.serde.internal.document")

export record Reader is core.DocumentReader, nupp.Closeable
    @private @readonly value: documents.Document
    @private @readonly source: core.Context?
    @private used: boolean
    @private expired: boolean

    --- Drops the reader, after which every read raises.
    function close(takes self): nil
        self.expired = true
    end

    --- Checks that the reader's value was consumed.
    --- @raises string when the reader is closed or its value was not consumed
    function finish(borrows self): nil
        assert(not self.expired and self.used, "document adapter did not consume its value")
    end

    --- Checks that the reader can still be read.
    --- @raises string when the reader is closed
    --- @raises string when its value is already consumed
    function live(self): nil
        assert(not self.expired, "document reader scope has expired")
        assert(not self.used, "document value has already been consumed")
    end

    --- Returns the context of the value being read.
    --- @return the value's own context, else the enclosing reader's, or nil
    --- @raises string when the reader is closed or its value is consumed
    function context(self): core.Context?
        self:live()
        return self.source
    end

    --- Returns the kind of the value being read.
    --- @raises string when the reader is closed or its value is consumed
    function kind(self): core.Kind
        self:live()
        return self.value.kind
    end

    --- Marks the value consumed after checking its kind.
    --- @param kind the kind the value must have
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of `kind`
    function consume(exclusive self, kind: core.Kind): nil
        self:live()
        assert(self.value.kind == kind, "document kind mismatch")
        self.used = true
    end

    --- Consumes a `null` value.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `null`
    function readNull(exclusive self): nil
        self:consume("null")
    end

    --- Consumes a `boolean` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `boolean`
    function readBoolean(exclusive self): boolean
        self:consume("boolean")
        return self.value:boolean()
    end

    --- Consumes a `numberToken` value and returns its lexeme.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `numberToken`
    function readNumberToken(exclusive self): string
        self:consume("numberToken")
        return self.value:numberToken()
    end

    --- Consumes a `string` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `string`
    function readString(exclusive self): string
        self:consume("string")
        return self.value:string()
    end

    --- Consumes a `bytes` value and returns its binary data.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `bytes`
    function readBytes(exclusive self): string
        self:consume("bytes")
        return self.value:bytes()
    end

    --- Consumes a `timestamp` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `timestamp`
    function readTimestamp(exclusive self): core.Timestamp
        self:consume("timestamp")
        return self.value:timestamp()
    end

    --- Consumes an `integer` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `integer`
    function readInteger(exclusive self): core.Integer
        self:consume("integer")
        return self.value:integer()
    end

    --- Consumes a `decimal` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `decimal`
    function readDecimal(exclusive self): core.Decimal
        self:consume("decimal")
        return self.value:decimal()
    end

    --- Consumes a `float` value and returns it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `float`
    function readFloat(exclusive self): core.Float
        self:consume("float")
        return self.value:float()
    end

    --- Consumes a `bigInteger` value and returns its decimal text.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `bigInteger`
    function readBigInteger(exclusive self): string
        self:consume("bigInteger")
        return self.value:bigInteger()
    end

    --- Consumes an `atom` value and returns a snapshot of it.
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `atom`
    function readAtom(exclusive self): core.Atom
        self:consume("atom")
        return self.value:atom()
    end

    --- Consumes a `document` boundary and reads its contents.
    --- @param adapter the adapter that reads the contents
    --- @return the contents the adapter returns
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not a boundary
    --- @raises string when the adapter does not consume the contents
    function readDocument<D>(exclusive self, adapter: core.DocumentAdapter<D>): D
        self:consume("document")
        local value = self.value:document()
        local child = new Reader(value = value, source = value:context() or self.source, used = false, expired = false)
        local result = adapter:readContents(child)
        if not child.used then
            error(publication.failure(adapter, result, "document adapter did not consume its contents"), 0)
        end

        return result
    end

    --- Consumes a value of a sequence kind, handing each element to a consumer.
    ---
    --- Each element is read through a reader of its own.
    --- @param kind the kind the value must have
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each element's index and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of `kind`
    --- @raises string when the consumer does not consume an element
    function elements<S>(exclusive self, kind: core.Kind, exclusive state: S, consumer: core.DocumentElement<S>): nil
        self:consume(kind)
        for index = 1, self.value:size() do
            local value = self.value:at(index)
            local child = new Reader(
                value = value,
                source = value:context() or self.source,
                used = false,
                expired = false
            )
            consumer:apply(state, index, child)
            assert(child.used, "document callback did not consume its value")
        end
    end

    --- Consumes a `list` value, handing each element to a consumer.
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each element's index and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `list`
    --- @raises string when the consumer does not consume an element
    function readList<S>(exclusive self, exclusive state: S, consumer: core.DocumentElement<S>): nil
        self:elements("list", state, consumer)
    end

    --- Consumes a `tuple` value, handing each element to a consumer.
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each element's index and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `tuple`
    --- @raises string when the consumer does not consume an element
    function readTuple<S>(exclusive self, exclusive state: S, consumer: core.DocumentElement<S>): nil
        self:elements("tuple", state, consumer)
    end

    --- Consumes a value with named members, handing each member to a consumer.
    ---
    --- Each member is read through a reader of its own.
    --- @param kind the kind the value must have
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each member's name and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of `kind`
    --- @raises string when the consumer does not consume a member
    function members<S>(exclusive self, kind: core.Kind, exclusive state: S, consumer: core.DocumentMember<S>): nil
        self:consume(kind)
        for index = 1, self.value:size() do
            local field = self.value:field(index)
            local value = field.value
            local child = new Reader(
                value = value,
                source = value:context() or self.source,
                used = false,
                expired = false
            )
            consumer:apply(state, field.name, child)
            assert(child.used, "document callback did not consume its value")
        end
    end

    --- Consumes a `structure` value, handing each member to a consumer.
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each member's name and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `structure`
    --- @raises string when the consumer does not consume a member
    function readStruct<S>(exclusive self, exclusive state: S, consumer: core.DocumentMember<S>): nil
        self:members("structure", state, consumer)
    end

    --- Consumes a `union` value, handing each member to a consumer.
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each member's name and reader
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `union`
    --- @raises string when the consumer does not consume a member
    function readUnion<S>(exclusive self, exclusive state: S, consumer: core.DocumentMember<S>): nil
        self:members("union", state, consumer)
    end

    --- Consumes a `map` value, handing each entry to a consumer.
    --- @param state the state the consumer fills
    --- @param consumer the consumer called with each entry's key and value
    ---     readers
    --- @raises string when the reader is closed or its value is consumed
    --- @raises string when the value is not of kind `map`
    --- @raises string when the consumer does not consume both the key and the
    ---     value
    function readMap<S>(exclusive self, exclusive state: S, consumer: core.DocumentEntry<S>): nil
        self:consume("map")
        for index = 1, self.value:size() do
            local entry = self.value:entry(index)
            local key = new Reader(
                value = entry.key,
                source = entry.key:context() or self.source,
                used = false,
                expired = false
            )
            local value = new Reader(
                value = entry.value,
                source = entry.value:context() or self.source,
                used = false,
                expired = false
            )
            consumer:apply(state, key, value)
            assert(key.used and value.used, "document callback must consume both key and value")
        end
    end
end

export function reader(value: documents.Document): Reader
    return new Reader(value = value, source = value:context(), used = false, expired = false)
end

export function snapshot(value: documents.Document): documents.Document
    local input = reader(value)
    local result = documents.documentAdapter():readContents(input)
    input:finish()
    return result
end
