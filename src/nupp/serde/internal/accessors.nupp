module nupp.serde.internal.accessors

const assert2 = require("assert")

const reflect = require("types.reflect")

-- Neutral declaration operations. Protocols choose their own member handles;
-- these handles identify only readable storage and constructor parameters.

const carrier = require("nupp.serde.internal.carrier")

local cacheKey: table = {}
local create: function<T is own.Copyable>(target: Type<T>, info: types.reflect.Info, index: integer): Access<T>

local function fail(path: string, expected: string): nil
    error("nupp: " .. path .. " expects " .. expected, 3)
end

local function witness(info: types.reflect.Info, index: integer): any
    return (assert2(reflect.runtimetype(info, index), "runtime declaration is not available"))
end

local function checkValue(info: types.reflect.Info, index: integer, value: any, path: string, seen: any): boolean
    local node: any = info.types[index]
    local kind = node.kind
    if kind == "nil" then
        return value == nil
    elseif kind == "any" or kind == "unknown" then
        return true
    elseif kind == "string" or kind == "boolean" or kind == "table" then
        return type(value) == kind
    elseif kind == "number" then
        return type(value) == "number"
    elseif kind == "float32" then
        return type(value) == "number" and (value ~= value or math.f32.narrow(value) == value)
    elseif kind == "float64" then
        return type(value) == "number"
    elseif kind == "integer"
        or kind == "int32"
        or kind == "uint32"
        or kind == "int8"
        or kind == "uint8"
        or kind == "int16"
        or kind == "uint16"
    then
        if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge or value % 1 ~= 0 then
            return false
        end
        if kind == "integer" then
            return true
        end
        local width = assert2(tonumber(kind:match("%d+")))
        local signed = kind:sub(1, 1) == "i"
        local limit = 2 ^ (width - (signed and 1 or 0))
        return value >= (signed and -limit or 0) and value < limit
    elseif kind == "int64" or kind == "uint64" then
        return carrier.isInteger(kind, value)
    elseif kind == "literal" then
        return value == node.value
    elseif kind == "const" then
        return checkValue(info, node.element, value, path, seen)
    elseif kind == "record" then
        return type(value) == "table" and getmetatable(value) == witness(info, index)
    elseif kind == "struct" then
        return carrier.isStruct(witness(info, index), value)
    elseif kind == "union" then
        for _, member in ipairs(node.members) do
            if checkValue(info, member, value, path, seen) then
                return true
            end
        end
        return false
    elseif kind == "intersection" then
        for _, member in ipairs(node.members) do
            if not checkValue(info, member, value, path, seen) then
                return false
            end
        end
        return true
    end
    if type(value) ~= "table" then
        return false
    end
    local prior = seen[value]
    if prior and prior[index] then
        return true
    end
    if prior == nil then
        prior = {}
        seen[value] = prior
    end
    prior[index] = true
    local valid = true
    if kind == "array" then
        local count = 0
        for key, item in pairs(value) do
            if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
                valid = false
                break
            end
            count += 1
            if not checkValue(info, node.element, item, path, seen) then
                valid = false
                break
            end
        end
        if valid then
            for position = 1, count do
                if rawget(value, position) == nil then
                    valid = false
                    break
                end
            end
        end
    elseif kind == "tuple" then
        for position, member in ipairs(node.members) do
            if not checkValue(info, member, value[position], path, seen) then
                valid = false
                break
            end
        end
        for key in pairs(value) do
            if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > #node.members then
                valid = false
                break
            end
        end
    elseif kind == "map" then
        for key, item in pairs(value) do
            if not checkValue(info, node.readkey, key, path, seen)
                or not checkValue(info, node.readvalue, item, path, seen)
            then
                valid = false
                break
            end
        end
    elseif kind == "shape" then
        for _, field in ipairs(node.fields) do
            if not checkValue(info, field.read, value[field.name], path, seen) then
                valid = false
                break
            end
        end
    else
        valid = false
    end
    prior[index] = nil

    return valid
end

local function copyDefault(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = copyDefault(item)
    end

    return result
end

-- A function's signature and an owner's lifetime cannot be checked from an
-- erased value. Those cases use typed, application-supplied construction.
local function checkable(info: types.reflect.Info, index: integer, seen: {[integer]: boolean}): boolean
    if seen[index] then
        return true
    end
    seen[index] = true
    local node: any = info.types[index]
    local kind = node.kind
    if kind == "nil"
        or kind == "any"
        or kind == "unknown"
        or kind == "string"
        or kind == "boolean"
        or kind == "number"
        or kind == "float32"
        or kind == "float64"
        or kind == "integer"
        or kind == "literal"
        or kind == "table"
        or kind == "int8"
        or kind == "uint8"
        or kind == "int16"
        or kind == "uint16"
        or kind == "int32"
        or kind == "uint32"
        or kind == "int64"
        or kind == "uint64"
    then
        return true
    elseif kind == "record" or kind == "struct" then
        return #(node.typeparameters or {}) == 0
    elseif kind == "const" or kind == "array" then
        return checkable(info, node.element, seen)
    elseif kind == "map" then
        return node.readkey ~= nil
            and node.readvalue ~= nil
            and checkable(info, node.readkey, seen)
            and checkable(info, node.readvalue, seen)
    elseif kind == "tuple" or kind == "union" or kind == "intersection" then
        for _, member in ipairs(node.members) do
            if not checkable(info, member, seen) then
                return false
            end
        end
        return true
    elseif kind == "shape" then
        if node.index and next(node.index) ~= nil then
            return false
        end
        for _, field in ipairs(node.fields) do
            if field.read == nil or not checkable(info, field.read, seen) then
                return false
            end
        end
        return true
    end

    return false
end

--- A stored, readable field of a declaration, as an access lists it.
---
--- A field reads values only through the access that listed it.
export record Field
    --- The annotations declared on the field, empty when it has none.
    @readonly annotations: const{types.reflect.Annotation} = {}

    --- The field's declared name.
    @readonly name: string

    --- The field's position in the access's `fields`, from 1.
    @readonly index: integer

    --- The position of the field's read type in the access's `info.types`.
    @readonly typeindex: integer

    --- Whether the declaration gives the field a default.
    @readonly hasdefault: boolean

    @private @readonly owner: table
end

--- A parameter of a declaration's constructor, as an access lists it.
---
--- A parameter is set only on a builder from the access that listed it.
export record Parameter
    --- The parameter's name. A declaration binding sets it from the field of
    --- the same name.
    @readonly name: string

    --- The parameter's position in the access's `parameters` and in the
    --- constructor call, from 1.
    @readonly index: integer

    --- The position of the parameter's type in the access's `info.types`.
    @readonly typeindex: integer

    --- Whether construction may finish with the parameter unset.
    @readonly optional: boolean

    @private @readonly owner: table
end

--- Collects constructor arguments for one value of a declaration.
---
--- [](serde.Access.begin) opens one and
--- [](serde.Access.finish) takes it.
export record Builder<T is own.Copyable> is own.Closeable
    @private @readonly owner: table
    @private @readonly info: types.reflect.Info
    @private values: {unknown}
    @private present: {[integer]: boolean}
    @private closed: boolean = false
    @private @readonly _type: (function(value: T): T)?

    --- Sets one constructor argument.
    ---
    --- The value is checked against the parameter's declared type here, so a
    --- mismatch is reported at the parameter rather than at construction.
    ---
    --- @param parameter the parameter to set
    --- @param value the argument
    --- @raises string when the builder is closed, the parameter belongs to
    ---     another access or is already set, or the value does not fit the
    ---     parameter's type
    function set(exclusive self, parameter: const Parameter, value: unknown): nil
        assert2(not self.closed, "construction is closed")
        assert2(parameter.owner == self.owner, "foreign construction parameter")
        assert2(not self.present[parameter.index], "duplicate construction parameter")
        if not checkValue(self.info, parameter.typeindex, value, parameter.name, {}) then
            fail(parameter.name, self.info.types[parameter.typeindex].kind)
        end
        self.values[parameter.index] = value
        self.present[parameter.index] = true
    end

    --- Drops the arguments collected so far.
    ---
    --- A closed builder can neither be set nor finished.
    function close(takes self): nil
        self.closed = true
        self.values = {}
        self.present = {}
    end
end

export record Access<T is own.Copyable>
    --- The reflection graph the declaration was read from.
    @readonly info: types.reflect.Info

    --- The position of the declaration in `info.types`.
    @readonly typeindex: integer

    --- The declaration's stored, readable fields, in declaration order.
    @readonly fields: const{Field}

    --- The constructor's parameters, in call order.
    ---
    --- The list is empty when the declaration owns resources, is generic, or
    --- needs a factory; `constructionerror` then says why.
    @readonly parameters: const{Parameter}

    @private @readonly owner: table
    @private @readonly target: Type<T>
    @private @readonly defaults: {[string]: unknown}
    @private @readonly constructor: integer?
    @private @readonly constructionProblem: string?
    @private @readonly accessible: {[integer]: boolean}
    @private @readonly nestedCache: {[integer]: Access<unknown>}
    @private @readonly _type: (function(value: T): T)?

    --- Reads a field of a value, borrowed from it.
    ---
    --- @param value the value to read
    --- @param field one of this access's fields
    --- @return the field's value
    --- @raises string when the field belongs to another access
    function get(self, borrows value: T, field: const Field): unknown borrows (value)
        assert2(field.owner == self.owner, "foreign access field")
        return (value as {[string]: unknown})[field.name]
    end

    --- Starts constructing a value.
    ---
    --- The builder is an owner: pass it to `finish`, or drop it to discard
    --- the arguments.
    ---
    --- @return the builder
    --- @raises string when the declaration cannot be constructed; the message
    ---     is the one `constructionerror` returns
    function begin(self): Builder<T>
        assert2(self.constructionProblem == nil, self.constructionProblem)
        return Builder<T>(owner = self.owner, info = self.info, values = {}, present = {})
    end

    --- Returns why the declaration cannot be constructed through this access.
    ---
    --- The reported problems are an owning or generic declaration, a
    --- constructor that needs a factory, a parameter that is not plain or
    --- whose type cannot be checked at runtime, and metadata built by a
    --- compiler that predates ownership attestation. Each needs a
    --- construction adapter of its own, except the last, which needs a
    --- rebuild.
    ---
    --- @return the problem, or nil when `begin` succeeds
    function constructionerror(self): string?
        return self.constructionProblem
    end

    --- Returns the access for a record or struct the declaration's storage
    --- reaches.
    ---
    --- The access is cached, so asking twice for an index returns the same one.
    ---
    --- @param index the nested declaration's position in `info.types`
    --- @return the nested declaration's access
    --- @raises string when the type is not reachable through readable storage,
    ---     is not a record or struct, or has no runtime declaration
    function nested(self, index: integer): Access<unknown>
        assert2(self.accessible[index], "type is not reachable through readable storage")
        local cached = self.nestedCache[index]
        if cached ~= nil then
            return cached
        end
        local target = assert2(reflect.runtimetype(self.info, index), "nested declaration is not available")
        local result = create<unknown>(target, self.info, index)
        self.nestedCache[index] = result

        return result
    end

    --- Constructs the value from a builder and drops the builder.
    ---
    --- An unset optional parameter takes a copy of the field's default, if
    --- any, when the declaration has no constructor of its own, and nil when
    --- it does.
    --- The constructed value is checked against the declaration before it is
    --- returned.
    ---
    --- @param builder the builder from `begin`, transferred
    --- @return the value
    --- @raises string when the builder is closed or belongs to another access,
    ---     a required parameter is unset, or an argument or the result does
    ---     not fit its declared type
    function finish(self, takes builder: Builder<T>): T
        local state: Builder<T> = builder
        assert2(state.owner == self.owner, "foreign construction state")
        assert2(not state.closed, "construction is closed")
        local arguments: any = {}
        for _, parameter in ipairs(self.parameters) do
            if not state.present[parameter.index] and not parameter.optional then
                error("missing construction parameter: " .. parameter.name, 2)
            end
            local value: any = state.values[parameter.index]
            if not state.present[parameter.index] and self.constructor == nil then
                value = copyDefault(self.defaults[parameter.name])
            end
            if not checkValue(self.info, parameter.typeindex, value, parameter.name, {}) then
                fail(parameter.name, self.info.types[parameter.typeindex].kind)
            end
            arguments[parameter.index] = value
        end
        local target: any = self.target
        local value: any
        if self.constructor ~= nil then
            local construct = target["__nuppCtor" .. tostring(self.constructor)]
            value = construct(unpack(arguments, 1, #self.parameters))
        else
            value = self.info.types[self.typeindex].kind == "struct" and target() or setmetatable({}, target)
            for _, parameter in ipairs(self.parameters) do
                value[parameter.name] = arguments[parameter.index]
            end
        end
        if not checkValue(self.info, self.typeindex, value, self.info.name, {}) then
            fail(self.info.name, "a constructed " .. self.info.types[self.typeindex].kind)
        end
        state:close()

        return value as T
    end
end

create = function<T is own.Copyable>(target: Type<T>, info: types.reflect.Info, index: integer): Access<T>
    local root: any = info.types[index]
    assert2(root.kind == "record" or root.kind == "struct", "access requires a record or struct")
    local owner: table = {}
    local fields: {Field} = {}
    local parameters: {Parameter} = {}
    local defaults: {[string]: unknown} = {}
    for _, entry in ipairs(root.fields) do
        if entry.stored and entry.readable then
            fields[
                #fields + 1
            ] = Field(
                name = entry.name,
                annotations = entry.annotations or {},
                index = #fields + 1,
                typeindex = entry.read as integer,
                hasdefault = entry.hasdefault == true,
                owner = owner
            )
            if entry.hasdefault then
                defaults[entry.name] = entry.defaultvalue
            end
        end
    end
    local construction = root.construction
    local problem: string?
    if root.copyable == nil then
        problem = "declaration metadata has no ownership attestation; rebuild it with this compiler"
    elseif not root.copyable then
        problem = "an owning declaration requires an explicit construction and disposal adapter"
    elseif construction == nil or construction.requiresfactory then
        problem = "this declaration requires an explicit construction adapter"
    elseif #(root.typeparameters or {}) > 0 then
        problem = "a generic declaration requires a concrete construction adapter"
    else
        for index, entry in ipairs(construction.params) do
            if entry.mode ~= "plain" or not checkable(info, entry.type, {}) then
                problem = "parameter " .. entry.name .. " requires a typed construction adapter"
            end
            parameters[
                index
            ] = Parameter(
                name = entry.name,
                index = index,
                typeindex = entry.type,
                optional = entry.optional == true,
                owner = owner
            )
        end
    end
    local accessible: {[integer]: boolean} = {}

    local function visit(current: integer): nil
        if accessible[current] then
            return
        end
        accessible[current] = true
        local node: any = info.types[current]
        if node.kind == "record" or node.kind == "struct" or node.kind == "shape" then
            for _, field in ipairs(node.fields) do
                if field.read and (node.kind == "shape" or field.stored) then
                    visit(field.read)
                end
            end
        elseif node.kind == "const" or node.kind == "array" then
            visit(node.element)
        elseif node.kind == "tuple" or node.kind == "union" or node.kind == "intersection" then
            for _, member in ipairs(node.members) do
                visit(member)
            end
        elseif node.kind == "map" then
            if node.readkey then
                visit(node.readkey)
            end
            if node.readvalue then
                visit(node.readvalue)
            end
        end
    end

    visit(index)
    local result = Access<T>(
        info = info,
        typeindex = index,
        fields = fields,
        parameters = parameters,
        owner = owner,
        target = target,
        defaults = defaults,
        constructor = construction and construction.declared and construction.index or nil,
        constructionProblem = problem,
        accessible = accessible,
        nestedCache = {}
    )

    return result
end

export function of<T is own.Copyable>(target: Type<T>): Access<T>
    local info = reflect.runtime(target)
    local cached = rawget(info, cacheKey)
    if cached ~= nil then
        return cached as Access<T>
    end
    local result = create<T>(target, info, info.root)
    rawset(info, cacheKey, result)

    return result
end
