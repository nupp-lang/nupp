@!internal
module nupp.serde.internal.carrier

--[[The exact carriers of 64-bit integers and native structs, as the VM holds them.

A 64-bit integer is a number while a double holds it exactly and a boxed integer
otherwise; a struct value is a storage value of the type its declaration names.
]]

--- Every VM target carries 64-bit integers exactly.
export function require64(): nil
end

--- Whether a value is held by the exact carrier of a 64-bit integer kind.
--- @param kind `int64` or `uint64`
--- @param value the value
export function isInteger(kind: string, value: any): boolean
    if kind == "int64" then
        return value is int64
    end

    return value is uint64
end

--- Whether a value is a native value of a struct declaration.
--- @param witness the struct's declaration
--- @param value the value
export function isStruct(witness: any, value: any): boolean
    -- A struct's declaration answers `type` as "cdata", as a ctype does.
    local physical: any = witness ~= nil and witness["\0nupp:structType"] or nil

    return physical ~= nil and physical:isa(value)
end

--- Reads a decimal integer into its exact 64-bit carrier.
--- @param decimal the digits, with a leading `-` when negative
--- @param signed whether the carrier is `int64`
export function parse(decimal: string, signed: boolean): any
    local negative = decimal:sub(1, 1) == "-"
    if signed then
        local result: int64 = 0LL
        for position = negative and 2 or 1, #decimal do
            local digit = assert(decimal:byte(position)) - 48
            result = result * 10LL + (negative and -digit or digit)
        end
        return result
    end
    local result: uint64 = 0ULL
    for position = 1, #decimal do
        result = result * 10ULL + (assert(decimal:byte(position)) - 48)
    end

    return result
end

--- Writes an exact 64-bit integer as decimal digits.
--- @param value the integer
export function format(borrows value: unknown): string
    -- A boxed integer prints its digits; a double that holds one exactly may
    -- print in exponent form, and every digit `%.0f` writes for it is exact.
    local text = tostring(value)
    if text:find("[eE.]") then
        return ("%.0f"):format((value as number) + 0)
    end

    return text
end
