@!internal
module nupp.serde.internal.json.compiled

local core = require("nupp.serde.internal.value")
local plans = require("nupp.serde.internal.json.plan")
local lowering = require("nupp.serde.internal.json.lower")
local declarations = require("nupp.serde.internal.declaration")
local scalars = require("nupp.serde.internal.scalar")
local structures = require("nupp.serde.internal.structure")
local spi = require("nupp.spi")
local contracts = require("nupp.codec.json.spi")
local provider = spi.select(spi.load(contracts.Provider))
local errors = require("nupp.serde.internal.errors")
local diagnostic = require("nupp.serde.internal.json.diagnostic")
local json = require("nupp.codec.json")
local text = require("nupp.text")

local interface Assign<S is nupp.Closeable>
    apply: function(self, exclusive state: S, value: unknown): nil
end
local record Set<S is nupp.Closeable, V is nupp.Copyable> is Assign<S>
    @readonly set: structures.Set<S, V>
    function apply(self, exclusive state: S, value: unknown): nil
        -- The paired native recipe validates and constructs precisely V.
        self.set(state, value as V)
    end
end
local record Field<T, S is nupp.Closeable, M is core.Member> is structures.FieldConsumer<T, S, M, boolean>
    @readonly resolver: lowering.Resolver<M>
    @readonly plan: plans.Plan<M>
    @readonly path: string
    @readonly syntax: {any}
    @readonly setters: {Assign<S>}
    @readonly required: boolean
    function apply<V is nupp.Copyable>(
        self,
        member: M,
        has: structures.Has<T>,
        get: structures.Get<T, V>,
        set: structures.Set<S, V>,
        adapter: core.Adapter<V, M>,
        fallback: (function(): V)?
    ): boolean
        if self.plan:action(member) ~= "traverse" then
            return false
        end
        local child = self.plan:child(member)
        if child == nil then
            return false
        end
        local recipe = self.resolver:resolve(adapter, child, self.path .. "[" .. json.encode(member.name) .. "]")
        if recipe == nil then
            return false
        end
        self.syntax[
            #self.syntax + 1
        ] = {
            name = member.name,
            wire = assert(self.plan:wireName(member)),
            target = recipe.syntax,
            required = self.required,
            hasDefault = false
        }
        self.setters[#self.setters + 1] = new Set<S, V>(set = set)

        return true
    end
end
local record Construct<T, S is nupp.Closeable>
    @readonly construction: structures.Construction<T, S>
    @readonly setters: {Assign<S>}
    function apply(self, values: {unknown}): T
        local state = self.construction:begin()
        for index, setter in ipairs(self.setters) do
            local value = values[index]
            if value ~= nil then
                setter:apply(state, value)
            end
        end

        return self.construction:finish(state)
    end
end
local record Structure<T, M is core.Member> is structures.Consumer<T, M, lowering.Recipe<T>?>
    @readonly resolver: lowering.Resolver<M>
    @readonly plan: plans.Plan<M>
    @readonly path: string
    function apply<S is nupp.Closeable>(
        self,
        member: M,
        fields: const{structures.Field<T, S, M>},
        construction: structures.Construction<T, S>,
        unknown: core.UnknownConsumer<S>,
        additional: core.Members<M, T>?
    ): lowering.Recipe<T>?
        if additional ~= nil or not structures.rejectsUnknown(unknown) or #fields > 64 then
            return nil
        end
        local syntax: {any} = {}
        local setters: {Assign<S>} = {}
        for _, field in ipairs(fields) do
            if not field:accept(
                new Field<T, S, M>(
                    resolver = self.resolver,
                    plan = self.plan,
                    path = self.path,
                    syntax = syntax,
                    setters = setters,
                    required = field.required
                )
            ) then
                return nil
            end
        end
        local constructor = new Construct<T, S>(construction = construction, setters = setters)
        local invoke: function(values: {unknown}): T = function(values: {unknown}): T
            return constructor:apply(values)
        end

        return new lowering.Recipe<T>(syntax = {
            kind = "structure",
            access = "dynamic",
            fields = syntax,
            factory = function(values: {unknown}): T
                local ok, result = pcall(invoke, values)
                if not ok then
                    error(errors.wrap(result, self.path, nil), 0)
                end

                return result as T
            end
        })
    end
end
local record Resolver<M is core.Member> is lowering.Resolver<M>
    @readonly active: {[unknown]: boolean} = {}
    depth: integer = 0
    function resolve<T>(self, adapter: core.Adapter<T, M>, plan: plans.Plan<M>, path: string): lowering.Recipe<T>?
        if self.active[adapter] or plan.description.nullable or self.depth >= 128 then
            return nil
        end
        self.active[adapter] = true
        self.depth += 1
        local recipe = declarations.nativeRecipe(adapter, plan, self, path)
        if recipe == nil then
            local scalar = scalars.nativeScalar(adapter)
            if scalar ~= nil then
                recipe = new lowering.Recipe<T>(syntax = {kind = scalar})
            elseif structures.canDefer(adapter) then
                recipe = structures.inspect(adapter, new Structure<T, M>(resolver = self, plan = plan, path = path))
            end
        end
        self.active[adapter] = nil
        self.depth -= 1

        return recipe
    end
end

export interface Decoder<T>
    accepts: function(self, borrows bytes: string): boolean
    acceptsBuffer: function(self, exclusive input: text.Buffer): boolean
    decode: function(self, bytes: string): T
    decodeBuffer: function(self, exclusive input: text.Buffer): T
end
local record Native<T> is Decoder<T>
    @readonly schema: any
    @readonly syntax: any
    @readonly invoke: function(schema: any, bytes: string): (any?, string?)
    @readonly invokeBuffer: (function(schema: any, exclusive input: text.Buffer): (any?, string?))?
    function acceptsBuffer(self, exclusive input: text.Buffer): boolean
        return self.invokeBuffer ~= nil and #input <= 1000000
    end

    function decodeBuffer(self, exclusive input: text.Buffer): T
        assert(self:acceptsBuffer(input), "compiled buffer input exceeds its execution capability")
        local invoke = assert(self.invokeBuffer)
        local ok, value, problem = pcall(invoke, self.schema, input)
        if not ok then
            error(diagnostic.explain(self.syntax, input:tostring(), value), 0)
        end
        if problem ~= nil then
            error(diagnostic.explain(self.syntax, input:tostring(), problem), 0)
        end

        return value as T
    end

    function accepts(self, borrows bytes: string): boolean
        -- Below this bound, token and entry budgets cannot be exceeded. The
        -- finite recipe's depth is bounded during selection. Larger inputs use
        -- the visitor before any model operation runs.
        return #bytes <= 1000000
    end

    function decode(self, bytes: string): T
        assert(self:accepts(bytes), "compiled input exceeds its execution capability")
        local ok, value, problem = pcall(self.invoke, self.schema, bytes)
        if not ok then
            error(diagnostic.explain(self.syntax, bytes, value), 0)
        end
        if problem ~= nil then
            error(diagnostic.explain(self.syntax, bytes, problem), 0)
        end

        return value as T
    end
end

export function select<T, M is core.Member>(
    adapter: core.Adapter<T, M>,
    plan: plans.Plan<M>,
    backend: contracts.Provider?
): Decoder<T>?
    local selected = backend or provider
    if selected == nil then
        return nil
    end
    local compile, decode = selected.compileSerde, selected.decodeSerde
    if compile == nil or decode == nil then
        return nil
    end
    local recipe = (new Resolver<M>()):resolve(adapter, plan, "$")
    if recipe == nil then
        return nil
    end
    recipe.syntax.deferRoot = true
    local schema = compile(recipe.syntax, "reject")
    if not schema.complete then
        return nil
    end

    return new Native<T>(
        schema = schema,
        syntax = recipe.syntax,
        invoke = decode,
        invokeBuffer = selected.decodeSerdeBuffer
    )
end

-- Deterministic capability evidence does not require a native host provider.
export function supports<T, M is core.Member>(adapter: core.Adapter<T, M>, plan: plans.Plan<M>): boolean
    return (new Resolver<M>()):resolve(adapter, plan, "$") ~= nil
end
