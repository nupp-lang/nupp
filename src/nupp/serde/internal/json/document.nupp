module nupp.serde.internal.json.document

local core = require("nupp.serde.internal.value")
local publication = require("nupp.serde.internal.publication")
local syntax = require("nupp.serde.internal.json.syntax")

export record Name is core.WireField
    --- The member name from the JSON object, with its escapes decoded.
    @readonly name: string

    --- Returns the name, for messages such as an unknown member's.
    ---
    --- @return the member name
    function diagnosticlabel(self): string
        return self.name
    end
end

export function name(field: core.WireField): string
    if getmetatable(field) ~= Name then
        error("field identity is not a JSON name", 2)
    end
    return (field as Name).name
end

export record Contents is core.DocumentReader
    @private @readonly cursor: syntax.Cursor
    @private @readonly sourceContext: core.Context?
    @private expired: boolean

    function live(self): nil
        if self.expired then
            error("document reader scope has expired", 2)
        end
    end

    function context(self): core.Context?
        self:live()
        return self.sourceContext
    end

    function kind(self): core.Kind
        self:live()
        local token = self.cursor:peek()
        if token == "object" then
            return "structure"
        elseif token == "array" then
            return "list"
        elseif token == "number" then
            return "numbertoken"
        elseif token == "boolean" then
            return "bool"
        else
            return token
        end
    end

    function readnull(exclusive self): nil
        self:live()
        self.cursor:readNull()
    end

    function readbool(exclusive self): boolean
        self:live()
        return self.cursor:readBoolean()
    end

    function readnumbertoken(exclusive self): string
        self:live()
        return self.cursor:readNumber()
    end

    function readstring(exclusive self): string
        self:live()
        return self.cursor:readString()
    end

    function readbytes(exclusive self): string
        error("JSON bytes require model context", 2)
    end

    function readtimestamp(exclusive self): core.Timestamp
        error("JSON timestamps require model context", 2)
    end

    function readinteger(exclusive self): core.Integer
        error("JSON integer width requires model context", 2)
    end

    function readdecimal(exclusive self): core.Decimal
        error("JSON decimal interpretation requires model context", 2)
    end

    function readfloat(exclusive self): core.Float
        error("JSON float width requires model context", 2)
    end

    function readbiginteger(exclusive self): string
        error("JSON big integer interpretation requires model context", 2)
    end

    function readatom(exclusive self): core.Atom
        error("JSON atoms require model context", 2)
    end

    function readdocument<D>(exclusive self, adapter: core.DocumentAdapter<D>): D
        error("JSON document boundaries require model context", 2)
    end

    function readtuple<S>(exclusive self, exclusive state: S, consume: core.DocumentElement<S>): nil
        error("JSON tuples require model context", 2)
    end

    function readunion<S>(exclusive self, exclusive state: S, consume: core.DocumentMember<S>): nil
        error("JSON unions require model context", 2)
    end

    function readmap<S>(exclusive self, exclusive state: S, consume: core.DocumentEntry<S>): nil
        error("JSON typed maps require model context", 2)
    end

    function readlist<S>(exclusive self, exclusive state: S, consume: core.DocumentElement<S>): nil
        self:live()
        self.cursor:start("array")
        local index: integer = 0
        while self.cursor:nextElement() do
            index += 1
            local mark = self.cursor:mark()
            local child = Contents(cursor = self.cursor, sourceContext = self.sourceContext, expired = false)
            local ok, problem = pcall(consume.apply, consume, state, index, child)
            child.expired = true
            if not ok then
                error(problem, 0)
            end
            self.cursor:consumed(mark)
        end
    end

    function readstruct<S>(exclusive self, exclusive state: S, consume: core.DocumentMember<S>): nil
        self:live()
        self.cursor:start("object")
        while true do
            local key = self.cursor:nextKey()
            if key == nil then
                break
            end
            local mark = self.cursor:mark()
            local child = Contents(cursor = self.cursor, sourceContext = self.sourceContext, expired = false)
            local ok, problem = pcall(consume.apply, consume, state, key, child)
            child.expired = true
            if not ok then
                error(problem, 0)
            end
            self.cursor:consumed(mark)
        end
    end

    function expire(self): nil
        self.expired = true
    end
end

export record Unknown is core.UnknownReader
    @private @readonly cursor: syntax.Cursor
    @private @readonly sourceContext: core.Context?
    @private expired: boolean
    @private used: boolean

    function live(self): nil
        if self.expired then
            error("unknown reader scope has expired", 2)
        end
        if self.used then
            error("unknown value has already been consumed", 2)
        end
        self.used = true
    end

    function skipvalue(exclusive self): nil
        self:live()
        self.cursor:skipValue()
    end

    function capturevalue<D>(exclusive self, adapter: core.DocumentAdapter<D>): D
        self:live()
        local mark = self.cursor:mark()
        local child = Contents(cursor = self.cursor, sourceContext = self.sourceContext, expired = false)
        local ok, result = pcall(adapter.readcontents, adapter, child)
        child:expire()
        if not ok then
            error(result, 0)
        end
        local complete, problem = pcall(self.cursor.consumed, self.cursor, mark)
        if not complete then
            error(publication.failure(adapter, result as D, problem), 0)
        end

        return result as D
    end

    function expire(self): nil
        self.expired = true
    end
end

export function contents(cursor: syntax.Cursor, context: core.Context?): Contents
    return Contents(cursor = cursor, sourceContext = context, expired = false)
end

export function unknown(cursor: syntax.Cursor, context: core.Context?): Unknown
    return Unknown(cursor = cursor, sourceContext = context, expired = false, used = false)
end
