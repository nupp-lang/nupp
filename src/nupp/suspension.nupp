module nupp.suspension

local contract = require("nupp.runtime.services.suspension")
local cancellation = require("nupp.runtime.services.cancellation")
local provider = contract.service:assemble(function(): contract.Provider
    return contract.service:lookup("nupp.native") or contract.service:require("nupp.browser")
end)
local suspension = {}
type suspension.Source = contract.Source
type suspension.Context = contract.Context
type suspension.Waiting = contract.Waiting
type suspension.Handler = contract.Handler
type suspension.Installed = contract.Installed
suspension.Source = contract.Source
suspension.Context = contract.Context
suspension.Waiting = contract.Waiting
suspension.Handler = contract.Handler
suspension.Installed = contract.Installed
suspension.source = provider.source
suspension.poll = provider.poll
suspension.suspend = provider.suspend
suspension.install = provider.install
suspension.create = provider.create
suspension.handled = provider.handled
suspension.delegatedCanPark = provider.delegatedCanPark
suspension.delegatedPark = provider.delegatedPark
suspension.canSuspend = provider.canSuspend
suspension.destroyInstalled = contract.destroyInstalled
rawset(suspension, "__turnAvailable", (provider as any).__turnAvailable)
rawset(suspension, "__consumeTurn", (provider as any).__consumeTurn)
rawset(suspension, "__deferTurn", (provider as any).__deferTurn)
rawset(suspension, "__taskCancellation", cancellation.create)
rawset(suspension, "__isTaskCancellation", cancellation.is)
export = suspension
