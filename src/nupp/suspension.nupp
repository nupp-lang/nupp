--[[
Waiting, as an operation with an installable handler.

A library that must wait performs `suspend`, and does not decide how waiting
happens. Where a handler is installed -- a scheduler, a game frame -- the handler
answers; where none is, the built-in one blocks. One call site, no `async`
colouring, and no policy parameter threaded through an API that did not want it.

The shape is tecs's, whose `taskruntime` has done this by hand inside one library
for years: subscribe for a resumption, be resumed once, be cancellable. What is
different is that the seam is the language's, so every library gets it rather
than each re-implementing the dispatch or being unusable inside a frame.

Measured against tecs's own numbers (`bench/suspension-baseline.lua`), the row
that matters is the *ready* path -- an await whose subscription completes during
the call, which is most of the cost of waiting even when waiting really happens.
So the fast path here allocates no gate and no park state: one closure and its
upvalues, and an early return the moment the subscription has already answered.
A gate is built only when the call is actually going to wait.

See `plans/suspension.md`.
]]

local suspension = {}

--- What a host installs to answer suspensions.
---
--- `park` is the whole of the obligation: given an operation's name and a state the
--- runtime has already prepared, block or suspend until it is resumed, and answer what
--- it was resumed with. A handler that returns without the state being resumed is a
--- handler that broke its contract; `suspend` reports that rather than inventing a
--- value.
--- The state a park is resumed through. A handler waits until `resumed` is set and
--- reads `value`; the runtime writes both.
record suspension.Park
    resumed: boolean
    value: unknown
end

--- `park` is given the handler, the operation's name, a state to resume through, and
--- the subscription's cancellation when it has one. It returns once the state is
--- resumed; returning without that is a broken handler and `suspend` says so.
record suspension.Handler
    --- Waits until the park is resumed. The first argument is the handler itself, so a
    --- handler may be written with method syntax and carry its own state.
    park: function(suspension.Handler, string, suspension.Park, (function()?)): nil
end

-- The handler in force, per coroutine.
--
-- Weak-keyed so a finished coroutine's entry goes with it. The main thread has no
-- coroutine object in LuaJIT, so it gets its own slot rather than a sentinel key: one
-- branch, and no pretending the main thread is a coroutine.
local installed = setmetatable({}, {__mode = "k"})
local mainInstalled = nil

local running = coroutine.running

--- The handler that answers here, or nil for the blocking one.
---
--- One hash read and a branch. The baseline says a wait-mode check of this shape costs
--- about 1.5ns, which is why this is not where the design spends its care.
local function effective()
    local co = running()
    if co == nil then
        return mainInstalled
    end

    return installed[co]
end

--- The built-in handler: waits by driving the registered sources until something
--- settles.
---
--- This is what a CLI, a build and the compiler itself get, and it is deliberately not
--- a scheduler. It runs the pumps and re-checks; it does not decide what else could
--- have run instead, because in a process with no scheduler there is nothing else.
local sources = {}

local sourceOrder = {}

local function blockingPark(operation: string, state: suspension.Park): nil
    while not state.resumed do
        local settled = 0
        for index = 1, #sourceOrder do
            local source = sources[sourceOrder[index]]
            if source then
                settled = settled + (source.poll() or 0)
            end
        end
        if settled == 0 and not state.resumed then
            -- Nothing moved and nothing is going to. Returning here would hand back a
            -- value nobody produced, so this says so instead.
            error(("nupp: %s cannot complete: nothing is left to make progress"):format(operation), 0)
        end
    end
end

--- Registers a readiness pump the blocking handler drives.
---
--- A library with pending work retains one of these; a handler with no way to make
--- progress can only wait for something that will never happen. Priority orders the
--- pumps within one pass, lowest first, which is what lets a host put its own work
--- ahead of a library's.
---
--- @param name what this source is, used to replace or remove it
--- @param priority where in a pass it runs, lowest first
--- @param poll answers how many things it settled
function suspension.source(name: string, priority: integer, poll: function(): integer): nil
    sources[name] = {priority = priority, poll = poll}
    sourceOrder = {}
    for key in pairs(sources) do
        sourceOrder[#sourceOrder + 1] = key
    end
    table.sort(sourceOrder, function(a, b)
        local pa, pb = sources[a].priority, sources[b].priority
        if pa == pb then
            return a < b
        end

        return pa < pb
    end)
end

--- Removes a source. A library with nothing outstanding should not be polled.
---
--- @param name the source to remove
function suspension.removeSource(name: string): nil
    if sources[name] == nil then
        return
    end
    sources[name] = nil
    local kept = {}
    for _, key in ipairs(sourceOrder) do
        if key ~= name then
            kept[#kept + 1] = key
        end
    end
    sourceOrder = kept
end

--- Performs a suspension.
---
--- `subscribe` is handed a one-shot `resume` and answers a cancellation, or nil when
--- the
--- subscription already completed -- a subscription that resumed during the call has
--- nothing left to cancel, and requiring a closure for it would be requiring an
--- allocation for a case that never waits.
---
--- @param operation what is being waited for, which is what a stuck host reports
--- @param subscribe hands over the resumption and answers a cancellation
--- @return whatever `resume` was given
--- @raises when the subscription resumes twice, or a handler returns without resuming
function suspension.suspend<T>(operation: string, subscribe: function(function(T)): (function()?)): T
    -- The ready path's whole cost is here: one closure over three cells. No table, no
    -- metatable, no gate. A park allocates its state only once parking is certain.
    local resumed, value, park = false, nil, nil

    local function resume(answer: T): nil
        if resumed then
            error(("nupp: %s was resumed twice"):format(operation), 0)
        end
        resumed, value = true, answer
        -- Written through only when a park is waiting on it, which is the case the
        -- early return below exists to avoid reaching.
        if park then
            park.resumed, park.value = true, answer
        end
    end

    local cancel = subscribe(resume)
    if resumed then
        return value
    end

    -- Now it is going to wait, and only now is there anything to build.
    park = new suspension.Park {resumed = false, value = nil}
    local handler = effective()
    if handler then
        handler.park(handler, operation, park, cancel)
    else
        blockingPark(operation, park)
    end
    if not park.resumed then
        error(("nupp: %s: the handler returned without resuming it"):format(operation), 0)
    end

    return park.value as T
end

--- Runs `body` with `handler` answering every suspension inside it.
---
--- The extent is dynamic and per-coroutine: a suspension at any depth, through any
--- library, reaches the innermost handler installed on the coroutine performing it.
--- Restored on the way out whatever happened, since a handler left installed after an
--- error would answer for code that never asked for it.
---
--- @param handler what answers suspensions inside
--- @param body what to run
--- @return whatever `body` answered
--- @raises whatever `body` raises, after the previous handler is restored
function suspension.handle<T>(handler: suspension.Handler, body: function(): T): T
    local co = running()
    local previous
    if co == nil then
        previous, mainInstalled = mainInstalled, handler
    else
        previous, installed[co] = installed[co], handler
    end
    local ok, answer = pcall(body)
    if co == nil then
        mainInstalled = previous
    else
        installed[co] = previous
    end
    if not ok then
        error(answer, 0)
    end

    return answer as T
end

--- Whether a handler is installed here, which is what `blocking` versus `cooperative`
--- means to a caller that wants to know before it commits to waiting.
function suspension.handled(): boolean
    return effective() ~= nil
end

return suspension
