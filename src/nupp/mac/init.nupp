module nupp.mac

--[[
Keyed hashes, for bytes somebody could have tampered with.

Same shape as [](nupp.digest), plus a key.

```nupp
const mac = nupp.mac

print(mac.hexDigest("hmac-sha256", key, "hello"))

local running = mac.create("hmac-sha256", key)

running:update("hel")
running:update("lo")

print(running:hexDigest())
```

The key is raw bytes. Finalizing consumes the context.

## Built-in algorithms

| Name | Output | Construction |
| --- | ---: | --- |
| `hmac-sha256` | 32 bytes | HMAC over SHA-256 |

A host may supply its own catalog through [](nupp.mac.spi),
chosen by priority when this module initializes. It is read once, at load.
]]

local spi = require("nupp.spi")

const context = require("nupp.digest.internal.context")
const provider = require("nupp.mac.spi")

--- An owned keyed context with consuming digest finalization.
export type Mac = context.Digest

--- Immutable MAC metadata and a keyed context factory.
export record Algorithm
    --- Canonical authentication algorithm name.
    @readonly
    name: string

    --- Fixed authentication output size in bytes.
    @readonly
    digestSize: integer

    @private
    implementation: provider.Algorithm

    --- Creates independent owned state initialized with the raw-byte key.
    function create(self, key: string): Mac
        return context.wrap(self.implementation:create(key), self.name, self.digestSize)
    end
end

local standard = require("nupp.runtime.provider.mac")

local function validate(selected: provider.Provider): nil
    for name, implementation in pairs(selected.algorithms) do
        if type(name) ~= "string"
            or name == ""
            or type(implementation) ~= "table"
            or implementation.name ~= name
            or type(implementation.digestSize) ~= "number"
            or implementation.digestSize <= 0
            or implementation.digestSize % 1 ~= 0
            or type(implementation.create) ~= "function"
        then
            error("invalid mac algorithm descriptor " .. tostring(name), 2)
        end
        local expected = standard.algorithms[name]
        if expected ~= nil and implementation.digestSize ~= expected.digestSize then
            error("mac provider has the wrong digestSize for " .. name, 2)
        end
    end
end

local selected: provider.Provider = do
    local chosen: provider.Provider?
    local tied = false
    for candidate in spi.load(provider.Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.mac: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    yield standard
end
validate(selected)
local available: {[string]: Algorithm} = {}
for name, implementation in pairs(standard.algorithms) do
    available[
        name
    ] = new Algorithm(name = name, digestSize = implementation.digestSize, implementation = implementation)
end
for name, implementation in pairs(selected.algorithms) do
    available[
        name
    ] = new Algorithm(name = name, digestSize = implementation.digestSize, implementation = implementation)
end
local names: {string} = {}
for name in pairs(available) do
    names[#names + 1] = name
end
table.sort(names)

--- Looks up MAC metadata before initializing a keyed context.
--- @param name the canonical MAC algorithm name
--- @return the descriptor, or nil when unavailable
export function lookup(name: string): Algorithm?
    return available[name]
end

--- Requires an available MAC descriptor.
--- @param name the canonical MAC algorithm name
--- @return the selected descriptor
--- @raises string when the algorithm is unavailable
export function algorithm(name: string): Algorithm
    local found = lookup(name)
    if found == nil then
        error("unknown MAC algorithm " .. name, 2)
    end

    return found
end

--- Creates independent owned state initialized with a key.
--- @param name the canonical MAC algorithm name
--- @param key the raw-byte secret key
--- @return an unfinished keyed context
export function create(name: string, key: string): Mac
    return algorithm(name):create(key)
end

--- Lists available canonical MAC names in ascending order.
--- @return the available names
export function algorithms(): {string}
    local result: {string} = {}
    for index, name in ipairs(names) do
        result[index] = name
    end

    return result
end

--- Computes a raw message authentication code.
--- @param name the canonical MAC algorithm name
--- @param key the raw-byte secret key
--- @param bytes the message bytes
--- @return the raw fixed-size authentication code
export function digest(name: string, key: string, bytes: string): string
    local mac = create(name, key)
    mac:update(bytes)
    return mac:digest()
end

--- Computes a lowercase hexadecimal message authentication code.
--- @param name the canonical MAC algorithm name
--- @param key the raw-byte secret key
--- @param bytes the message bytes
--- @return the lowercase hexadecimal authentication code
export function hexDigest(name: string, key: string, bytes: string): string
    local mac = create(name, key)
    mac:update(bytes)
    return mac:hexDigest()
end
