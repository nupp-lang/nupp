module nupp.browser

--[[
Browser-only operations expose host facilities to a Nupp program.

Today that is one thing: `xorU32` hands a block of `uint32` values to WebGPU and
gets the xored block back.

```nupp
local browser = require("nupp.browser")

const masked = browser.xorU32({1, 2, 3}, 0xFF)
```

The work runs on a Worker, so the call suspends until the GPU reports it done,
and the result is copied back only then. Everything here raises on a host
without WebGPU rather than falling back to the CPU: a program that wants a
fallback writes the one it wants.
]]

local response = require("nupp.runtime.browser.response")
local json = require("nupp.codec.json.provider")
local browser = {}
const MAX_XOR_VALUES = 262144

local function isWord(value: any): boolean
    return type(value) == "number" and value == math.floor(value) and value >= 0 and value <= 4294967295
end

local function invalidValues(): never
    error("nupp: browser GPU xor needs a dense list of at most 262144 uint32 values", 3)
end

--- Xors every uint32 in `values` with `mask`, one WebGPU invocation per element.
---
--- The result is copied back only after the Worker observes completion.
--- @param values the words to xor, at most 262144 of them
--- @param mask the word every element is xored with
--- @return a fresh list of the xored words, in the order they were given
--- @raises string when an input is invalid, WebGPU is unavailable, or the host result
---     is malformed
function browser.xorU32(values: {uint32}, mask: uint32): {uint32}
    if not isWord(mask) then
        error("nupp: browser GPU xor mask must be uint32", 2)
    end
    if type(values) ~= "table" then
        invalidValues()
    end

    local input: {any} = json.asArray({})
    local count, highest = 0, 0
    for index, value in pairs(values) do
        if type(index) ~= "number"
            or index ~= math.floor(index)
            or index < 1
            or index > MAX_XOR_VALUES
            or not isWord(value)
        then
            invalidValues()
        end
        count = count + 1
        highest = math.max(highest, index)
        input[index] = value
    end
    if highest ~= count then
        invalidValues()
    elseif count == 0 then
        return {}
    end

    local answer = response.await("gpu", {operation = "xor-u32", values = input, mask = mask,})
    if type(answer) ~= "table" or type(answer.values) ~= "table" then
        error("nupp: browser GPU returned an invalid xor result", 2)
    end

    local output: {uint32} = {}
    local returned = 0
    for index, value in pairs(answer.values) do
        if type(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > count or not isWord(value) then
            error("nupp: browser GPU returned an invalid xor result", 2)
        end
        returned = returned + 1
        output[index] = nupp.math.u32.wrap(value)
    end
    if returned ~= count then
        error("nupp: browser GPU returned an invalid xor result", 2)
    end

    return output
end

export = browser
