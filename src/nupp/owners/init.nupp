module nupp.owners

--[[
Containers for owners whose count and types are known only while running.

`Set` discharges an arbitrary collection together in reverse order. `Store`
adds generation and type-policy checks so one owner can cross untyped storage
and later be recovered. Both live directly on `nupp.owners`.

## Sets

How many owners a set holds, and of what types, is known only while running, so the
proof of discharge cannot stay in the checker: it is carried into the entry as the
witness `adopt` is handed. Surrendering an owner to that storage is what `unsafe
release` is for, and the two `unsafe` blocks below are the whole of what this module
asks to be trusted about. `nupp ownership-audit` lists them.

This is the simple half of owner custody: entries are erased, discharge is LIFO, and
a borrow lives as long as the set.

```nupp
local owners = require("nupp.owners")

do
    local requests = owners.newSet("requests")
    local request = requests:adopt(beginRequest())
    request:send()
end -- discharges the request automatically
```

## Stores

`Store` adds generation and type-policy checks, so an individual owner can cross
untyped storage and be recovered. Taking it out invalidates every copy of its handle;
anything left in the store is discharged with the store.

```nupp
local owners = require("nupp.owners")

local store = owners.newStore()
local handle = store:put(openFile("notes.txt"))
local token = owners.erase(handle) -- safe to pass through untyped storage

local restored, recoveryProblem = owners.recover(token, FileState)
assert(recoveryProblem == nil)
if restored then
    local file, takeProblem = store:take(restored)
    assert(takeProblem == nil)
    if file then
        drop file
    end
end
drop store
```

See [ownership.md](docs/type-system/ownership.md) for the complete contract
reference, and [ownership.md](docs/concepts/ownership.md) for the annotations a
caller writes.
]]

local owners = {}

--- One adopted owner and the witness that discharges it.
---
--- Both are erased: the set is one table holding owners of types it never learns,
--- and the witness the call site reified is the only thing that knows what to do
--- with the value beside it.
local record Entry
    value: any
    cleanup: any
end

--- A container for as many owners as a program turns out to need.
---
--- `adopt` moves an owner in and returns a borrow tied to the set; `close` discharges
--- every registration in reverse, attempts all of them, and reports the first failure
--- with a count of the ones it suppressed.
---
--- @export
record owners.Set
    --- What the set is for, in diagnostics.
    label: string

    --- Adopted owners, in the order they arrived.
    _entries: {Entry}

    --- Whether `close` has already run.
    _closed: boolean

    --- Discharges every registration in reverse.
    ---
    --- Attempts all of them, so one failing cleanup cannot strand the rest, then
    --- reports the first failure with a count of the ones it suppressed. Idempotent.
    drop: nosuspend function(takes self: owners.Set)

    close: nosuspend function(takes self: owners.Set)

    --- Moves an owner in and returns a borrow tied to the owners.
    ---
    --- The second argument is the discharge witness. A caller never writes it: the
    --- checker reifies the adopted value's own cleanup contract at the call site, and
    --- asks for an explicit terminal consumer only where there is no contract to reify.
    ---
    --- @param value the owner the set takes responsibility for
    --- @param terminal what discharges an opaque owner, which carries no contract
    --- @return the adopted value, borrowed from the set
    --- @raises when the set is already closed, or adoption carries no witness
    function adopt<T>(self, takes value: T, terminal: function(takes value: T)?): T borrows (self)
        assert(not self._closed, "resource set is closed")
        local witness = terminal
        assert(type(witness) == "function", "resource adoption needs a discharge witness")
        self._entries[#self._entries + 1] = new Entry(value = unsafe release value, cleanup = witness)

        return self._entries[#self._entries].value as T
    end

    --- Deletes one registration and returns the original capability exactly once.
    ---
    --- @param value a value a previous `adopt` returned
    --- @return that value, owned by the caller again
    --- @raises when the value is not registered in this set, or the set is closed
    function remove<T>(self, borrows value: T): T
        assert(not self._closed, "resource set is closed")
        for index = #self._entries, 1, -1 do
            local entry = self._entries[index]
            if entry.value == value then
                table.remove(self._entries, index)
                return entry.value as T
            end
        end
        error("resource is not registered in this set", 2)
    end
end

--- Discharges every registration in reverse.
---
--- Attempts all of them, so one failing cleanup cannot strand the rest, then reports
--- the first failure with a count of the ones it suppressed. Idempotent.
---
--- @export
--- @param self the set, spent by this call
--- @raises when a registration's cleanup fails
function owners.Set.close(takes self)
    local first: any = nil
    local suppressed = 0
    if not self._closed then
        self._closed = true
        for index = #self._entries, 1, -1 do
            local entry = self._entries[index]
            local ok, reason = pcall(entry.cleanup, entry.value)
            if not ok then
                if first == nil then
                    first = reason
                else
                    suppressed = suppressed + 1
                end
            end
        end
        self._entries = {}
    end
    -- The set is spent either way, and saying so before raising keeps a failing
    -- cleanup from also reading as an undischarged owner.
    local _raw = unsafe release self
    if first ~= nil then
        if suppressed > 0 then
            error(tostring(first) .. " (suppressed " .. tostring(suppressed) .. " cleanup failure(s))", 0)
        end
        error(first, 0)
    end
end

function owners.Set.drop(takes self)
    self:close()
end

local function destroySet(takes value: owners.Set): nil
    value:drop()
end

--- Creates a set that owns whatever is adopted into it.
---
--- The set closes automatically at its lexical boundary, discharging what it still
--- holds.
---
--- @export
--- @param label what the set is for, in diagnostics; omitted names it "resource"
--- @return the empty set, owned by the caller
function owners.newSet(label: string?): affine(owners.Set, destroySet)
    return new owners.Set(label = label or "resource", _entries = {}, _closed = false)
end

local STORE_REGISTRY_KEY = "__nuppDynamicStores"
local stores: any = _G[STORE_REGISTRY_KEY]
if not stores then
    stores = setmetatable({}, {__mode = "k"})
    _G[STORE_REGISTRY_KEY] = stores
end

--- A structured static or runtime dynamic-custody failure.
--- @export
record owners.Error
    code: string
    message: string
end

local record StoreEntry
    value: any
    cleanup: any
    policy: string
    generation: integer
end

--- A copyable typed custody token.
---
--- Its representation is private and cannot be forged by checked code.
--- @export
record owners.Handle<T>
    private store: owners.StoreState
    private slot: integer
    private generation: integer
    private policy: string
end

--- The intentionally type-erased token accepted by untyped adapters.
--- @export
record owners.ErasedHandle
    private store: owners.StoreState
    private slot: integer
    private generation: integer
    private policy: string
end

--- Runtime state owned by `Store`.
--- @export
record owners.StoreState
    private entries: {[integer]: StoreEntry}
    private generations: {[integer]: integer}
    private nextSlot: integer
    private destroyed: boolean

    drop: nosuspend function(takes self: owners.StoreState): nil

    --- Compiler-lowered implementation of `put`; callers use `put` below.
    function _put<T>(exclusive self, takes value: T, cleanup: any, policy: string): owners.Handle<T>
        assert(not self.destroyed, "dynamic store is destroyed")
        local slot = self.nextSlot
        self.nextSlot = slot + 1
        local generation = self.generations[slot] or 1
        self.entries[
            slot
        ] = new StoreEntry(value = unsafe release value, cleanup = cleanup, policy = policy, generation = generation)

        return new owners.Handle(
            store = self,
            slot = slot,
            generation = generation,
            policy = policy
        ) as owners.Handle<T>
    end

    --- Enrolls one self-contained, droppable capability.
    ---
    --- The compiler replaces this body at the call site so the cleanup witness
    --- and stable type policy remain erased from direct checked values.
    --- @param value the capability transferred into the store
    --- @return the copyable handle naming its custody slot
    --- @raises if compiler lowering is unavailable
    function put<T>(exclusive self, takes value: T): owners.Handle<T>
        local _raw = unsafe release value
        error("owners.Store.put must be lowered by the compiler", 2)
    end

    --- Borrows a stored capability for one callback.
    function with<T, R>(
        exclusive self,
        handle: owners.Handle<T>,
        scoped callback: function(borrows value: T): R
    ): (R?, owners.Error?)
        local entry, problem = self:_entry(handle)
        if not entry then
            return nil, problem
        end

        return callback(entry.value as T), nil
    end

    --- Exclusively borrows a stored capability for one callback.
    function withExclusive<T, R>(
        exclusive self,
        handle: owners.Handle<T>,
        scoped callback: function(exclusive value: T): R
    ): (R?, owners.Error?)
        local entry, problem = self:_entry(handle)
        if not entry then
            return nil, problem
        end

        return callback(entry.value as T), nil
    end

    --- Removes a capability and transfers it back to the caller.
    function take<T>(exclusive self, handle: owners.Handle<T>): (T?, owners.Error?)
        local entry, problem = self:_entry(handle)
        if not entry then
            return nil, problem
        end
        self.entries[handle.slot] = nil
        self.generations[handle.slot] = entry.generation + 1

        return entry.value as T, nil
    end

    --- Removes and discharges a capability.
    function remove<T>(exclusive self, handle: owners.Handle<T>): owners.Error?
        local entry, problem = self:_entry(handle)
        if not entry then
            return problem
        end
        self.entries[handle.slot] = nil
        self.generations[handle.slot] = entry.generation + 1
        entry.cleanup(entry.value)

        return nil
    end

    function _entry<T>(borrows self, handle: owners.Handle<T>): (StoreEntry?, owners.Error?)
        if self.destroyed or handle.store ~= self then
            return nil, new owners.Error(
                code = "NUPP2614",
                message = "dynamic handle names a destroyed or different store"
            )
        end
        local entry = self.entries[handle.slot]
        if not entry or entry.generation ~= handle.generation then
            return nil, new owners.Error(code = "NUPP2614", message = "dynamic handle is stale")
        end
        if entry.policy ~= handle.policy then
            return nil, new owners.Error(code = "NUPP2613", message = "dynamic handle has the wrong type policy")
        end

        return entry, nil
    end
end

function owners.StoreState.drop(takes self)
    if self.destroyed then
        return
    end
    self.destroyed = true
    stores[self] = nil
    local first: any = nil
    local suppressed = 0
    for slot, entry in pairs(self.entries) do
        self.entries[slot] = nil
        self.generations[slot] = entry.generation + 1
        local ok, reason = pcall(entry.cleanup, entry.value)
        if not ok then
            if first == nil then
                first = reason
            else
                suppressed = suppressed + 1
            end
        end
    end
    local _raw = unsafe release self
    if first ~= nil then
        if suppressed > 0 then
            error(tostring(first) .. " (suppressed " .. tostring(suppressed) .. " cleanup failure(s))", 0)
        end
        error(first, 0)
    end
end

local function destroyStore(takes self: owners.StoreState): nil
    self:drop()
end

--- A generation-checked heterogeneous capability store.
--- @export
type owners.Store = affine(owners.StoreState, destroyStore)

--- Creates an empty dynamic owner store.
--- @return the store, owned by the caller
--- @export
function owners.newStore(): owners.Store
    local state = new owners.StoreState(entries = {}, generations = {}, nextSlot = 1, destroyed = false)
    stores[state] = true

    return state
end

--- Erases a typed handle for transport through untyped storage.
--- @param handle the typed handle to erase
--- @return the erased handle
--- @export
function owners.erase<T>(handle: owners.Handle<T>): owners.ErasedHandle
    return new owners.ErasedHandle(
        store = handle.store,
        slot = handle.slot,
        generation = handle.generation,
        policy = handle.policy
    )
end

--- Runtime half of checked recovery.
function owners._recover<T>(handle: owners.ErasedHandle, policy: string): (owners.Handle<T>?, owners.Error?)
    if handle.policy ~= policy then
        return nil, new owners.Error(code = "NUPP2613", message = "dynamic handle has the wrong type policy")
    end
    return (
        new owners.Handle(
            store = handle.store,
            slot = handle.slot,
            generation = handle.generation,
            policy = handle.policy
        ) as owners.Handle<T>
    ), nil
end

--- Recovers a typed handle after checking its representation witness.
---
--- The compiler replaces this body with the stable policy check.
--- @param handle the erased handle to recover
--- @param expected the exact capability type expected behind the handle
--- @return the typed handle, or nil when the policy does not match
--- @return the structured mismatch, when unsuccessful
--- @raises only if this intrinsic is invoked without compiler lowering
--- @export
function owners.recover<T>(handle: owners.ErasedHandle, expected: Type<T>): (owners.Handle<T>?, owners.Error?)
    error("owners.recover must be lowered by the compiler", 2)
end

-- The hot-reload runtime asks only whether a stable policy has live custody. Values,
-- cleanup functions, slots, and handles remain private to this module.
_G.__nuppDynamicPolicyCount = function(policy: string): integer
    local count: integer = 0
    for state in pairs(stores) do
        if not state.destroyed then
            for _, entry in pairs(state.entries) do
                if entry.policy == policy then
                    count = count + 1
                end
            end
        end
    end

    return count
end

export = owners
