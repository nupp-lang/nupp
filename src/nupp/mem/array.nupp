module nupp.mem.array

--[[
Managed contiguous arrays hold one scalar or struct type.
Their shared and writable views use the checked [](binary.span) interface.

```nupp
const array = nupp.mem.array

const values = array.scalar(array.uint32, 4)
const writable = values:write()

writable[1] = 42
own.drop(writable)

print(values:read()[1])
```

The array retains its storage through the managed allocator. It is not an
affine allocation and has no `close` operation; leaving a lexical scope does
not promise immediate reclamation. Views retain their backing storage, and
every index is checked against the count the view carries. For explicitly
owned malloc-backed storage, see [](nupp.mem.heap).
]]
const {type Span, type Writable, type ByteSpan} = require("binary.span")

-- Element witnesses name a representation without loading its allocator.
-- Species queries remain ordinary values even on hosts without native storage.
export record Scalar<T>
    @private _elementType: T?
    @private @readonly physical: string
end

--- A witness for an element the checker admits only in storage positions.
---
--- The element is named through a span type rather than written as the
--- witness's own argument: a span element is one of the places a narrow
--- width is meaningful, and the compiler this library is first built with
--- knows no other.
local function narrow<T>(kind: string, _shape: Span<T>): Scalar<T>
    return new Scalar(_elementType = nil as T, physical = kind)
end

export const uint8 = narrow("uint8", (nil as any) as Span<uint8>)
export const int8 = narrow("int8", (nil as any) as Span<int8>)
export const uint16 = narrow("uint16", (nil as any) as Span<uint16>)
export const int16 = narrow("int16", (nil as any) as Span<int16>)
export const uint32 = new Scalar(_elementType = nil as uint32, physical = "uint32")
export const int32 = new Scalar(_elementType = nil as int32, physical = "int32")
export const uint64 = new Scalar(_elementType = nil as uint64, physical = "uint64")
export const int64 = new Scalar(_elementType = nil as int64, physical = "int64")
export const float = new Scalar(_elementType = nil as float, physical = "float")
export const number = new Scalar(_elementType = nil as number, physical = "number")

export record Array<T>
    @private @readonly pointer: T[?]
    @readonly count: integer
    read: function(borrows self: Array<T>): Span<T> borrows (self)
    write: function(exclusive self: Array<T>): Writable<T> borrows (self)
end

function Array.read<T>(borrows self: Array<T>): Span<T> borrows (self)
    return require("binary.span").fromcarray(self.pointer, self.count)
end

function Array.write<T>(exclusive self: Array<T>): Writable<T> borrows (self)
    return require("binary.span").writecarray(self.pointer, self.count)
end

--- Allocates zeroed storage with the struct witness's physical layout.
--- @raises string when count is not a nonnegative integer or exceeds the
---     target's storage limit
export function newarray<T>(takes witness: T, count: integer): Array<T>
    local storage = require("nupp.runtime.storage")
    local raw = @unsafe own.release(witness)
    local element = storage.descriptor(raw)
    return new Array(pointer = storage.allocateArray(element, count) as T[?], count = count) as Array<T>
end

--- Allocates zeroed storage for the selected scalar element type.
--- @raises string when count is not a nonnegative integer or exceeds the
---     target's storage limit
export function scalar<T>(borrows witness: Scalar<T>, count: integer): Array<T>
    local storage = require("nupp.runtime.storage")
    return new Array(
        pointer = storage.allocateArray(storage.scalar(witness.physical), count) as T[?],
        count = count
    ) as Array<T>
end

--- Owned bytes, with the same checked view vocabulary as scalar arrays.
export record Bytes
    @private @readonly pointer: uint8[?]
    @readonly count: integer

    function read(borrows self): ByteSpan borrows (self)
        return require("binary.span").fromcarray(self.pointer, self.count)
    end

    function write(exclusive self): Writable<uint8> borrows (self)
        return require("binary.span").writecarray(self.pointer, self.count)
    end
end

--- Allocates zeroed bytes without treating the storage-only uint8 as a value type.
--- @raises string when count is not a nonnegative integer
export function bytes(count: integer): Bytes
    if count < 0 or count ~= math.floor(count) then
        error("nupp: byte array count must be a non-negative integer", 2)
    end
    return new Bytes(pointer = require("nupp.runtime.storage").allocateBytes(count), count = count)
end
