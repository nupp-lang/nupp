module nupp.mem.sharedbytes

--[[
Engine-owned immutable byte regions.

A region names an extent of one reference-counted engine block. It crosses
worker boundaries by reference, slices without copying, and is read in place
through a borrowed [](nupp.mem.span) byte view; converting it to a Lua string
is one explicit call.

```nupp
const sharedbytes = nupp.mem.sharedbytes

const region = sharedbytes.copy("hello, region")
const hello = region:slice(0, 5)
assert(hello:length() == 5 and hello:toString() == "hello")
```

A region is storage, so its positions are zero-based offsets and counts, as a
[](nupp.io.Buffer)'s are: `slice(offset, count)` and `view(offset, count)`
name `count` bytes starting `offset` bytes in.

A producer that has bytes only behind a pointer writes into builder storage
directly through a reserve-and-commit pair, with no intermediate chunk string:

```nupp
const sharedbytes = nupp.mem.sharedbytes

local builder = sharedbytes.newBuilder()
with writer = builder:reserve(5) do
    for index = 1, 5 do
        writer[index] = 64 + index
    end
end
builder:commit(5)
builder:append("!")
assert(builder:freeze():toString() == "ABCDE!")
```
]]

const {type Path} = require("nupp.io.files")

local span = require("nupp.mem.span")

local type Native = {
    fromString: @nosuspend function(string): (any?, integer?),
    readFile: @nosuspend function(string): (any?, any),
    text: @nosuspend function(any, integer, integer): string?,
    pointer: @nosuspend function(any): any,
    length: @nosuspend function(any): integer?,
    builderNew: @nosuspend function(): any,
    builderAppend: @nosuspend function(any, string): (boolean, string?),
    builderReserve: @nosuspend function(any, integer): (any?, string?),
    builderCommit: @nosuspend function(any, integer): boolean,
    builderFreeze: @nosuspend function(any): (any?, any),
    accounted: @nosuspend function(): integer
}
-- Regions are engine blocks, so without the engine host there is nothing for
-- this module to stand on; say that rather than which file a search missed.
local loadedNative, nativeModule = pcall(require, "nupp.mem.sharedbytes.native")
if not loadedNative then
    if tostring(nativeModule):find("module 'nupp.mem.sharedbytes.native' not found", 1, true) then
        error("nupp: nupp.mem.sharedbytes needs the Nupp engine host, which a stamped binary provides", 0)
    end
    error(nativeModule, 0)
end
local native = nativeModule as Native
local ffi = require("ffi")

local foreignByteSpan = rawget(
    span as table,
    "__foreignByteSpan"
) as @nosuspend function(any, any, integer, integer): span.ByteSpan
local foreignSpan = rawget(
    span as table,
    "__foreignSpan"
) as function<T>(any, borrows pointer: voidptr, integer, integer, ctype<T>): span.Span<T>

local sharedbytes = {}

--- An immutable extent of one engine-owned block. Crossing a worker boundary
--- moves a reference, never the bytes; reading happens in place through a
--- borrowed byte view, and `toString` is the one explicit copy into a Lua state.
record sharedbytes.Region
    @private
    _handle: any
    @private
    _first: integer
    @private
    _length: integer

    --- How many bytes the region holds.
    length: @nosuspend function(sharedbytes.Region): integer

    --- A zero-copy region over `count` bytes starting `offset` bytes into this one.
    slice: function(sharedbytes.Region, integer, integer): sharedbytes.Region

    --- A read-only borrowed view over `count` bytes starting `offset` bytes in,
    --- the whole region by default.
    view: function(borrows self: sharedbytes.Region, integer?, integer?): span.ByteSpan borrows (self)

    --- A checked zero-copy view of the complete region as physical elements.
    viewAs: function<T>(borrows self: sharedbytes.Region, ctype<T>): span.Span<T> borrows (self)

    --- The region's bytes copied and interned as an ordinary string.
    toString: @nosuspend function(sharedbytes.Region): string
end

local RegionMT: metatable<sharedbytes.Region> = {__index = sharedbytes.Region}

--- Two regions are equal when they name the same engine block, offset, and
--- length; equal bytes in separate blocks are not equal.
rawset(RegionMT as table, "__eq", function(left: any, right: any): boolean
    return native.pointer(left._handle) == native.pointer(right._handle)
        and left._first == right._first
        and left._length == right._length
end)

local function wrap(handle: any, first: integer, length: integer): sharedbytes.Region
    return setmetatable({_handle = handle, _first = first, _length = length}, RegionMT) as sharedbytes.Region
end

function sharedbytes.Region:length(): integer
    return self._length
end

-- Whether `count` bytes from `offset` lie inside `length`. A NaN fails every
-- comparison, so each bound is asked for what it must be rather than what it must
-- not be.
local function inside(length: integer, offset: integer, count: integer): boolean
    return offset % 1 == 0 and count % 1 == 0 and offset >= 0 and count >= 0 and offset + count <= length
end

--- @raises string when the extent falls outside the region
function sharedbytes.Region:slice(offset: integer, count: integer): sharedbytes.Region
    if not inside(self._length, offset, count) then
        error("nupp: a region slice is out of bounds", 2)
    end

    return wrap(self._handle, self._first + offset, count)
end

--- @raises string when the extent falls outside the region
function sharedbytes.Region:view(offset: integer?, count: integer?): span.ByteSpan
    local from = offset == nil and 0 or offset as integer
    local taking = count == nil and self._length - from or count as integer
    if not inside(self._length, from, taking) then
        error("nupp: a region view is out of bounds", 2)
    end

    return foreignByteSpan(self, native.pointer(self._handle), self._first - 1 + from, taking)
end

--- @raises string when the region is not aligned or is not a whole number of elements
function sharedbytes.Region:viewAs<T>(element: ctype<T>): span.Span<T>
    local width = ffi.sizeof(element) as integer
    local alignment = ffi.alignof(element) as integer
    local byteOffset = self._first - 1
    if width < 1 or self._length % width ~= 0 then
        error("nupp: a typed region view must contain complete elements", 2)
    end
    local pointer = native.pointer(self._handle)
    local address = tonumber(ffi.cast<uint64>(pointer)) as integer
    if self._length > 0 and (address + byteOffset) % alignment ~= 0 then
        error("nupp: a typed region view is not suitably aligned", 2)
    end

    local bytes = ffi.cast<uint8*>(pointer)
    @unsafe
    do
        local start = borrowFrom((bytes + byteOffset) as voidptr, self)
        return foreignSpan(self, start, 0, self._length // width, element)
    end
end

--- @raises string when the region's engine storage has been released
function sharedbytes.Region:toString(): string
    local text = native.text(self._handle, self._first, self._first + self._length - 1)
    if text == nil then
        error("nupp: a region's storage has been released", 2)
    end

    return text as string
end

--- Copies `text` once into an engine-owned region.
--- @raises string when the engine cannot allocate the region
function sharedbytes.copy(text: string): sharedbytes.Region
    local handle, length = native.fromString(text)
    if handle == nil then
        error("nupp: cannot allocate a region", 2)
    end

    return wrap(handle, 1, length as integer)
end

--- Reads a whole file directly into an engine-owned region, with no
--- intermediate Lua string for the payload.
--- @param path the file to read, as anything [](nupp.io.files) accepts
--- @return the region, or nil when the file cannot be opened, sized, or read
--- @return why it could not be read, when unsuccessful
function sharedbytes.readFile(path: Path): (sharedbytes.Region?, string?)
    local name = type(path) == "string" and path as string or (path as any):toString() as string
    local handle, problem = native.readFile(name)
    if handle == nil then
        return nil, tostring(problem)
    end

    return wrap(handle, 1, native.length(handle) as integer), nil
end

--- An affine accumulator of engine storage. Appending grows one private
--- allocation, and freezing transfers it into a region without copying.
interface sharedbytes.BuilderToken is nupp.Affine<self.drop>
    drop: @nosuspend function(takes self: sharedbytes.BuilderToken): nil
end

--- A growable engine allocation that becomes a region when frozen.
record sharedbytes.Builder is sharedbytes.BuilderToken
    @private
    _handle: any

    --- Appends the chunk's bytes to the builder's storage.
    append: @nosuspend function(sharedbytes.Builder, string): nil

    --- Grows the storage and lends a checked writer over exactly `count`
    --- uninitialized bytes past what is already committed. All growth happens
    --- here, before the writer exists, and the borrow keeps every other
    --- builder operation a compile error while the writer lives, so the lent
    --- pointer cannot be invalidated. One `commit` closes the reservation
    --- after the writer drops.
    reserve: function(exclusive self: sharedbytes.Builder, integer): span.Writable<uint8> borrows (self)

    --- Closes the open reservation, keeping its first `written` bytes as
    --- content; a short read commits what arrived, and the surplus returns to
    --- capacity for the next reservation.
    commit: @nosuspend function(sharedbytes.Builder, integer): nil

    --- Consumes the builder and transfers its allocation into a region.
    freeze: @nosuspend function(takes self: sharedbytes.Builder): sharedbytes.Region

    --- Releases an unfrozen builder's storage at scope exit.
    drop: @nosuspend function(takes self: sharedbytes.Builder): nil
end

local BuilderMT: metatable<sharedbytes.Builder> = {__index = sharedbytes.Builder}

--- @raises string when a reservation is open or the engine cannot grow the storage
function sharedbytes.Builder:append(chunk: string): nil
    local accepted, problem = native.builderAppend(self._handle, chunk)
    if not accepted then
        if problem == "open" then
            error("nupp: a region builder has an open reservation", 2)
        end
        error("nupp: cannot grow a region builder", 2)
    end
end

--- @raises string when count is not a nonnegative integer, a reservation is
---     already open, or the engine cannot grow the storage
function sharedbytes.Builder:reserve(count: integer): span.Writable<uint8>
    if count < 0 or count ~= math.floor(count) then
        error("nupp: a region reservation must be a nonnegative integer", 2)
    end
    local pointer, problem = native.builderReserve(self._handle, count)
    if pointer == nil then
        if problem == "open" then
            error("nupp: a region builder already has an open reservation", 2)
        end
        error("nupp: cannot grow a region builder", 2)
    end

    local typed = ffi.cast<uint8[?]>(pointer)

    return span.writeCarray(typed, count)
end

--- @raises string when `written` is not a nonnegative integer, no reservation
---     is open, or `written` exceeds it
function sharedbytes.Builder:commit(written: integer): nil
    if written < 0 or written ~= math.floor(written) then
        error("nupp: a region commit must be a nonnegative integer", 2)
    end
    if not native.builderCommit(self._handle, written) then
        error("nupp: a commit does not match the builder's open reservation", 2)
    end
end

--- @raises string when the builder was already frozen or a reservation is open,
---     because sealing would silently drop bytes a producer may have written
function sharedbytes.Builder.freeze(takes self: sharedbytes.Builder): sharedbytes.Region
    -- Sealing spends the builder: the engine hands its bytes to the region, and
    -- the builder's own terminal has nothing left to release.
    local builder = @unsafe nupp.release(self)
    local handle, length = native.builderFreeze(builder._handle)
    if handle == nil then
        if length == "open" then
            error("nupp: a region builder has an open reservation", 2)
        end
        error("nupp: a region builder was already frozen", 2)
    end

    return wrap(handle, 1, length as integer)
end

-- A provider built before the native module could release a builder leaves its
-- storage to the userdata's finalizer, as every provider once did.
local releaseBuilder = rawget(native as table, "builderRelease") as(@nosuspend function(any): nil)?

function sharedbytes.Builder.drop(takes self: sharedbytes.Builder): nil
    local builder = @unsafe nupp.release(self)
    if releaseBuilder ~= nil then
        releaseBuilder(builder._handle)
    end
end

--- Opens an empty builder.
--- @raises string when the engine cannot allocate the builder
function sharedbytes.newBuilder(): affine(sharedbytes.Builder)
    local handle = native.builderNew()
    if handle == nil then
        error("nupp: cannot allocate a region builder", 2)
    end

    return setmetatable({_handle = handle}, BuilderMT) as affine(sharedbytes.Builder)
end

-- Private hooks for the worker transport: recognizing a region as a transfer
-- leaf, reading its parts for a message's attachments, and rebuilding one
-- around a received handle. Kept off the authored surface.
rawset(_G.nupp, "__regionMetatable", RegionMT)
rawset(sharedbytes, "__regionParts", function(region: any): (any, integer, integer)
    return region._handle, region._first, region._length
end)
rawset(sharedbytes, "__regionFromParts", function(handle: any, first: integer, length: integer): any
    return wrap(handle, first, length)
end)

sharedbytes.Region = sharedbytes.Region
sharedbytes.Builder = sharedbytes.Builder
sharedbytes.BuilderToken = sharedbytes.BuilderToken

export = sharedbytes
