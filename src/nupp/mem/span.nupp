module nupp.mem.span

--[[
Bounds-carrying borrowed pointer views.

```nupp
local span = require("nupp.mem.span")

const bytes = span.fromString("hello")
assert(#bytes == 5 and bytes[1] == 104)
```

A shared span copies freely and reads. A writable span does neither: it is
affine, and its live token holds the source under an incompatible-borrow barrier
until `drop` or a scope boundary consumes it.

See [ownership.md](docs/type-system/ownership.md) for the borrow rules these views are written
against, and [c-interop.md](docs/concepts/c-interop.md) for what `ref` hands a C call.
]]

local span = {}

--- The consuming operation shared by every writable span representation.
sealed interface span.WriteToken
    drop: nosuspend function(takes self: WriteToken): nil
end

--- Ends a write range, which is what every writable span's contract names.
---
--- Nothing calls this by hand. It is the terminal consumer `affine` carries, so a
--- scope boundary or an explicit `drop` reaches it.
---
--- @param writable the write range, spent by this call
--- @export
function span.destroyWriteSpan<T is span.WriteToken>(takes writable: T): nil
    nosuspend do
        local _raw = unsafe release writable
    end
end

--- A checked, shared view over contiguous elements. Only this module can declare an
--- implementation, so the contract is proof that `ref()` and `count` agree.
--- @export
sealed interface span.Span<T>
    metamethod __len: function(self: Span<T>): integer
    metamethod __index: function(self: Span<T>, index: integer): T

    --- Answers a subspan, inclusive at both ends and borrowed from this one.
    ---
    --- Indexes are one-based. Omitting `last` runs through to the end, and
    --- `first, first - 1` is how an empty subspan is written.
    ---
    --- ```nupp
    --- const values = span.fromCarray(storage, 4)
    --- const middle = values:slice(2, 3)
    --- assert(#middle == 2)
    --- ```
    slice: function(self: Span<T>, first: integer, last: integer?): Span<T> borrows (self)

    --- Answers the checked range as a const pointer and count, for a native call.
    ---
    --- The pointer borrows this span, so it cannot outlive the view that proved
    --- its bounds. This is the one supported way out to C.
    ref: function(self: Span<T>): (const T[?] borrows (self), integer)
end

--- The sole runtime representation of a dynamic shared span.
local record SpanImpl<T> is span.Span<T>
    private readonly anchor: any
    private readonly pointer: const T[?] borrows (anchor)
    private readonly offset: integer
    readonly count: integer

    --- Returns one element after checking the one-based index.
    --- @raises when index is outside 1 through count
    function get(self: SpanImpl<T>, index: integer): T
        if index < 1 or index > self.count then
            error("span index out of bounds", 2)
        end
        unsafe do
            return self.pointer[self.offset + index - 1]
        end
    end

    --- Returns a checked subspan, inclusive at both ends.
    --- @raises when the requested range is outside this span
    function slice(self: SpanImpl<T>, first: integer, last: integer?): span.Span<T> borrows (self)
        local finish = last or self.count
        if first < 1 or finish < first - 1 or finish > self.count then
            error("span slice out of bounds", 2)
        end

        return new SpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset + first - 1,
            count = finish - first + 1
        ) as span.Span<T>
    end

    --- Exposes the checked range as a const pointer/count pair for a native call.
    function ref(self: SpanImpl<T>): (const T[?] borrows (self), integer)
        unsafe do
            local pointer = (self.pointer as const T*) + self.offset
            return borrowFrom(pointer as const T[?], self), self.count
        end
    end
end

--- A shared span whose exact element count is part of its static type. It refines the
--- dynamic contract, so APIs accepting `Span<T>` also accept a fixed span.
--- @export
sealed interface span.FixedSpan<T, const N: integer> is span.Span<T>
    metamethod __len: function(self: FixedSpan<T, N>): N
end

--- The sole runtime representation of a fixed shared span.
local record FixedSpanImpl<T, const N: integer> is span.FixedSpan<T, N>
    private readonly anchor: any
    private readonly pointer: const T[?] borrows (anchor)
    private readonly offset: integer
    readonly count: N

    function get(self: FixedSpanImpl<T, N>, index: integer): T
        if index < 1 or index > (self.count as integer) then
            error("span index out of bounds", 2)
        end
        unsafe do
            return self.pointer[self.offset + index - 1]
        end
    end

    function slice(self: FixedSpanImpl<T, N>, first: integer, last: integer?): span.Span<T> borrows (self)
        local finish = last or (self.count as integer)
        if first < 1 or finish < first - 1 or finish > (self.count as integer) then
            error("span slice out of bounds", 2)
        end

        return new SpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset + first - 1,
            count = finish - first + 1
        ) as span.Span<T>
    end

    function ref(self: FixedSpanImpl<T, N>): (const T[?] borrows (self), integer)
        unsafe do
            local pointer = (self.pointer as const T*) + self.offset
            return borrowFrom(pointer as const T[?], self), self.count as integer
        end
    end
end

--- Two sibling, non-overlapping writable regions borrowed from one parent writer.
--- The representation is private so only this module can assert how the children
--- relate to their anchor.
--- @export
record span.WriteSplit<T>
    private readonly anchor: any

    --- The first `mid` elements, writable independently of `right`.
    readonly left: span.WriteSpan<T> borrows (anchor)

    --- Everything after them, writable independently of `left`.
    readonly right: span.WriteSpan<T> borrows (anchor)
end

--- An affine checked write range. Its live token keeps the source under an
--- incompatible-borrow barrier until `drop` or scope exit consumes it. Only
--- this module can declare an implementation.
--- @export
sealed interface span.WriteSpan<T> is span.WriteToken
    metamethod __len: function(self: WriteSpan<T>): integer
    metamethod __index: function(borrows self: WriteSpan<T>, index: integer): T
    metamethod __newindex: function(exclusive self: WriteSpan<T>, index: integer, value: T): nil

    --- Ends this write range, releasing the barrier on its source.
    drop: nosuspend function(takes self: WriteSpan<T>): nil

    --- Answers the checked range as a mutable pointer and count, for a native call.
    ---
    --- The pointer borrows this range, so the barrier on the source outlives the
    --- call that was handed it.
    ref: function(exclusive self: WriteSpan<T>): (T[?] borrows (self), integer)

    --- Downgrades this writer to a shared view for the lifetime of the result.
    ---
    --- The writer is borrowed rather than spent, so it comes back when the shared
    --- view ends.
    shared: function(borrows self: WriteSpan<T>): span.Span<T> borrows (self)

    --- Answers an affine writable subrange, inclusive at both ends.
    ---
    --- The child borrows this range, so the parent is unusable until the child is
    --- dropped. Two disjoint children at once is what `splitAt` is for.
    slice: function(
        exclusive self: WriteSpan<T>,
        first: integer,
        last: integer?
    ): affine(span.WriteSpan<T>, span.destroyWriteSpan) borrows (self)

    --- Partitions this range at a zero-based boundary count.
    ---
    --- The two children are non-overlapping, so both are writable at once, which
    --- a pair of `slice` calls could not be. `mid` is how many elements go left.
    ---
    --- ```nupp
    --- do
    ---     local writable = values:write()
    ---     local split = writable:splitAt(2)
    ---     split.left[1] = 11 as int32
    ---     split.right[1] = 22 as int32
    --- end
    --- ```
    @partition(left, right)
    splitAt: function(exclusive self: WriteSpan<T>, mid: integer): span.WriteSplit<T> borrows (self)
end

--- A writable span whose exact element count is part of its static type.
--- @export
sealed interface span.FixedWriteSpan<T, const N: integer> is span.WriteSpan<T>
    metamethod __len: function(self: FixedWriteSpan<T, N>): N
    shared: function(borrows self: FixedWriteSpan<T, N>): span.FixedSpan<T, N> borrows (self)
end

--- An affine dynamic writable span.
--- @export
type span.Writable<T> = affine(span.WriteSpan<T>, span.destroyWriteSpan)

--- An affine fixed-width writable span.
--- @export
type span.FixedWritable<T, const N: integer> = affine(span.FixedWriteSpan<T, N>, span.destroyWriteSpan)

--- The sole runtime representation of a dynamic writable span.
local record WriteSpanImpl<T> is span.WriteSpan<T>
    private readonly anchor: any
    private readonly pointer: T[?] borrows (anchor)
    private readonly offset: integer
    readonly count: integer

    --- Ends this affine write range. It is also the automatic scope-exit drop.
    drop: nosuspend function(takes self: WriteSpanImpl<T>): nil

    --- Returns a checked mutable element reference tied to this write borrow.
    --- @raises when index is outside 1 through count
    function getMut(exclusive self: WriteSpanImpl<T>, index: integer): T* borrows (self)
        if index < 1 or index > self.count then
            error("write span index out of bounds", 2)
        end
        unsafe do
            local elementOffset = self.offset + index - 1
            local pointer = (self.pointer as T*) + elementOffset
            return borrowFrom(pointer, self)
        end
    end

    --- Private checked read used by generated operator fallback code.
    --- @raises when index is outside 1 through count
    function get(self: WriteSpanImpl<T>, index: integer): T
        if index < 1 or index > self.count then
            error("write span index out of bounds", 2)
        end
        unsafe do
            return self.pointer[self.offset + index - 1]
        end
    end

    function set(exclusive self: WriteSpanImpl<T>, index: integer, value: T): nil
        if index < 1 or index > self.count then
            error("write span index out of bounds", 2)
        end
        unsafe do
            self.pointer[self.offset + index - 1] = value
        end
    end

    --- Exposes the checked range as a mutable pointer/count pair for a native call.
    function ref(exclusive self: WriteSpanImpl<T>): (T[?] borrows (self), integer)
        unsafe do
            local pointer = (self.pointer as T*) + self.offset
            return borrowFrom(pointer as T[?], self), self.count
        end
    end

    --- Downgrades this writer to a shared view for the lifetime of the result.
    function shared(borrows self: WriteSpanImpl<T>): span.Span<T> borrows (self)
        return new SpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset,
            count = self.count
        ) as span.Span<T>
    end

    --- Returns an affine writable subspan, inclusive at both ends.
    --- @raises when the requested range is outside this span
    function slice(exclusive self: WriteSpanImpl<T>, first: integer, last: integer?): span.Writable<T> borrows (self)
        local finish = last or self.count
        if first < 1 or finish < first - 1 or finish > self.count then
            error("write span slice out of bounds", 2)
        end

        return new WriteSpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset + first - 1,
            count = finish - first + 1
        ) as span.WriteSpan<T>
    end

    --- Partitions this range at a zero-based boundary count.
    --- @raises when mid is negative or greater than count
    function splitAt(exclusive self: WriteSpanImpl<T>, mid: integer): span.WriteSplit<T> borrows (self)
        if mid < 0 or mid > self.count then
            error("write span split point out of bounds", 2)
        end
        unsafe do
            local left, right = nupp.partition(
                self,
                new WriteSpanImpl(
                    anchor = self,
                    pointer = self.pointer as any,
                    offset = self.offset,
                    count = mid
                ) as span.WriteSpan<T>,
                new WriteSpanImpl(
                    anchor = self,
                    pointer = self.pointer as any,
                    offset = self.offset + mid,
                    count = self.count - mid
                ) as span.WriteSpan<T>
            )
            return new span.WriteSplit(anchor = self, left = left, right = right) as span.WriteSplit<T>
        end
    end

end

--- The sole runtime representation of a fixed writable span.
local record FixedWriteSpanImpl<T, const N: integer> is span.FixedWriteSpan<T, N>
    private readonly anchor: any
    private readonly pointer: T[?] borrows (anchor)
    private readonly offset: integer
    readonly count: N

    drop: nosuspend function(takes self: FixedWriteSpanImpl<T, N>): nil

    function getMut(exclusive self: FixedWriteSpanImpl<T, N>, index: integer): T* borrows (self)
        if index < 1 or index > (self.count as integer) then
            error("write span index out of bounds", 2)
        end
        unsafe do
            local elementOffset = self.offset + index - 1
            local pointer = (self.pointer as T*) + elementOffset
            return borrowFrom(pointer, self)
        end
    end

    --- Private checked read used by generated operator fallback code.
    --- @raises when index is outside 1 through count
    function get(self: FixedWriteSpanImpl<T, N>, index: integer): T
        if index < 1 or index > (self.count as integer) then
            error("write span index out of bounds", 2)
        end
        unsafe do
            return self.pointer[self.offset + index - 1]
        end
    end

    function set(exclusive self: FixedWriteSpanImpl<T, N>, index: integer, value: T): nil
        if index < 1 or index > (self.count as integer) then
            error("write span index out of bounds", 2)
        end
        unsafe do
            self.pointer[self.offset + index - 1] = value
        end
    end

    function ref(exclusive self: FixedWriteSpanImpl<T, N>): (T[?] borrows (self), integer)
        unsafe do
            local pointer = (self.pointer as T*) + self.offset
            return borrowFrom(pointer as T[?], self), self.count as integer
        end
    end

    function shared(borrows self: FixedWriteSpanImpl<T, N>): span.FixedSpan<T, N> borrows (self)
        return new FixedSpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset,
            count = self.count
        ) as span.FixedSpan<T, N>
    end

    function slice(
        exclusive self: FixedWriteSpanImpl<T, N>,
        first: integer,
        last: integer?
    ): span.Writable<T> borrows (self)
        local finish = last or (self.count as integer)
        if first < 1 or finish < first - 1 or finish > (self.count as integer) then
            error("write span slice out of bounds", 2)
        end

        return new WriteSpanImpl(
            anchor = self,
            pointer = self.pointer as any,
            offset = self.offset + first - 1,
            count = finish - first + 1
        ) as span.WriteSpan<T>
    end

    function splitAt(exclusive self: FixedWriteSpanImpl<T, N>, mid: integer): span.WriteSplit<T> borrows (self)
        if mid < 0 or mid > (self.count as integer) then
            error("write span split point out of bounds", 2)
        end
        unsafe do
            local left, right = nupp.partition(
                self,
                new WriteSpanImpl(
                    anchor = self,
                    pointer = self.pointer as any,
                    offset = self.offset,
                    count = mid
                ) as span.WriteSpan<T>,
                new WriteSpanImpl(
                    anchor = self,
                    pointer = self.pointer as any,
                    offset = self.offset + mid,
                    count = (self.count as integer) - mid
                ) as span.WriteSpan<T>
            )
            return new span.WriteSplit(anchor = self, left = left, right = right) as span.WriteSplit<T>
        end
    end
end

function WriteSpanImpl.drop<T>(takes self: WriteSpanImpl<T>): nil
    nosuspend do
        local _raw = unsafe release self
    end
end

function FixedWriteSpanImpl.drop<T, const N: integer>(takes self: FixedWriteSpanImpl<T, N>): nil
    nosuspend do
        local _raw = unsafe release self
    end
end

--- The byte-specialized shared view, which is what `fromString` answers.
--- @export
type span.ByteSpan = span.Span<uint8>

--- The byte-specialized write range.
--- @export
type span.ByteWriteSpan = span.WriteSpan<uint8>

--- Creates a byte span over a Lua string and keeps that string rooted.
---
--- ```nupp
--- const bytes = span.fromString("hello")
--- assert(#bytes == 5 and bytes[1] == 104)
--- ```
---
--- @param source the string the view reads, rooted for the view's lifetime
--- @return the byte view, borrowed from the string
--- @export
function span.fromString(borrows source: string): span.ByteSpan borrows (source)
    local pointer = ffi.cast<const uint8[?]>(source)
    return (new SpanImpl(anchor = source, pointer = pointer as any, offset = 0, count = #source)) as span.ByteSpan
end

--- Creates a checked shared span over a C array and an explicit logical count.
---
--- The count is the caller's claim about the array, so it is the one number this
--- module cannot check for itself. Everything after it is checked against it.
---
--- ```nupp
--- const storage = carray(int32, 4)
--- const values = span.fromCarray(storage, 4)
--- assert(#values == 4)
--- ```
---
--- @param source the array the view reads, rooted for the view's lifetime
--- @param count how many elements the array holds
--- @return the view, borrowed from the array
--- @export
--- @raises when count is negative
function span.fromCarray<T>(borrows source: T[?], count: integer): span.Span<T> borrows (source)
    if count < 0 then
        error("span count cannot be negative", 2)
    end
    return (new SpanImpl(anchor = source, pointer = source as any, offset = 0, count = count)) as span.Span<T>
end

--- Creates a fixed shared span without a runtime length check.
---
--- The literal count is both the stored count and the proof that the source has
--- exactly `N` elements, so there is nothing left to check at run time.
---
--- @param source the array the view reads, rooted for the view's lifetime
--- @param count the literal count, which must be the source's `N`
--- @return the view, borrowed from the array
--- @export
function span.fromFixedCarray<T, const N: integer>(
    borrows source: T[N],
    count: N
): span.FixedSpan<T, N> borrows (source)
    return (
        new FixedSpanImpl(anchor = source, pointer = source as any, offset = 0, count = count)
    ) as span.FixedSpan<T, N>
end

--- Creates an affine write span over a C array and an explicit logical count.
---
--- The source is exclusive during construction, and the returned owner keeps it
--- under an incompatible-borrow barrier until `drop` or a scope boundary consumes
--- the token. Nothing else may read or write the array in between.
---
--- ```nupp
--- const storage = carray(int32, 4)
--- do
---     local writable = span.writeCarray(storage, 4)
---     writable[1] = 42 as int32
---     drop writable
--- end
--- const values = span.fromCarray(storage, 4)
--- assert(values[1] == 42)
--- ```
---
--- @param source the array the view writes, held exclusively for its lifetime
--- @param count how many elements the array holds
--- @return the affine writer, borrowed from the array
--- @export
--- @raises when count is negative
function span.writeCarray<T>(exclusive source: T[?], count: integer): span.Writable<T> borrows (source)
    if count < 0 then
        error("write span count cannot be negative", 2)
    end
    return (new WriteSpanImpl(anchor = source, pointer = source as any, offset = 0, count = count)) as span.WriteSpan<T>
end

--- Creates a fixed affine write span without a runtime length check.
---
--- The source array type and the literal count must name the same `N`, which is
--- what stands in for the bounds check.
---
--- @param source the array the view writes, held exclusively for its lifetime
--- @param count the literal count, which must be the source's `N`
--- @return the affine writer, borrowed from the array
--- @export
function span.writeFixedCarray<T, const N: integer>(
    exclusive source: T[N],
    count: N
): span.FixedWritable<T, N> borrows (source)
    return (
        new FixedWriteSpanImpl(anchor = source, pointer = source as any, offset = 0, count = count)
    ) as span.FixedWriteSpan<T, N>
end

export = span
