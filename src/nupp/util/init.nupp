module nupp.util

--[[
Small types that belong to no larger facility.

```nupp
local record Damage
    amount: integer
end

const set = new nupp.util.Bitset(128)
set:set(7)

const damage = nupp.util.newPool(Damage, 64)
damage:release(damage:acquire())

const store = nupp.util.newStore()
const theme: nupp.util.Key<string> = nupp.util.newKey("app.theme")
store:set(theme, "dark")

print(nupp.util.uuid4())
```

Each member is one type and the few functions that hand it out, reached by the
type's name rather than by a module of its own. [](Bitset) is a set of bit
positions, [](Store) is a bag of values indexed by typed [](Key)s, and [](Pool)
leases cleared record instances from a free list. [](uuid4) and [](uuid7)
generate identifiers, and [](fnv1a64) hashes bytes. [](pcallse) and [](xpcallse)
run a function protected and answer `(result, reason)`, which is the layout the
`or return` suffix reads and `pcall`'s own is not.

Unlike [](nupp.mem), which keeps every member a module of its own, these are
re-exported here, so reaching one loads them all -- affordable, because they are
small.

Nothing here holds state a program did not create itself. The one cost of
reaching any of it is the uuid service: [](uuid4) and [](uuid7) come from the
host, so loading this module resolves that provider and a built program declares
its ABI even when all it wanted was a bitset.
]]

local bitset = require("nupp.util.internal.bitset")
local hash = require("nupp.util.internal.hash")
local pool = require("nupp.util.internal.pool")
local uuid = require("nupp.util.internal.uuid")
local store = require("nupp.util.internal.store")
local protected = require("nupp.util.internal.protected")

--- A growable set of bit positions counting from 0.
export type Bitset = bitset.Bitset

export const Bitset = bitset.Bitset

--- The bits one word of a [](Bitset) holds.
export const WORD_BITS = bitset.WORD_BITS

--- A pool of instances stamped with one record declaration.
export type Pool<T is table> = pool.Pool<T>

export const Pool = pool.Pool

--- Creates a pool of instances of one record type.
export const newPool = pool.new

--- A typed identity for one value in a [](Store).
export type Key<T> = store.Key<T>

export const Key = store.Key

--- An independent typed bag indexed by keys.
export type Store = store.Store

--- Registers a new key, optionally under a name.
export const newKey = store.newKey

--- Creates an empty store.
export const newStore = store.newStore

--- Hashes bytes with FNV-1a over 64 bits, as sixteen hexadecimal digits.
export const fnv1a64 = hash.fnv1a64

--- Runs a function under `pcall`, answering `(result, raised)` rather than
--- `(ok, ...)`, which is the layout `or return` reads.
export const pcallse = protected.pcallse

--- The same for `xpcall`: the handler runs pre-unwind and its result is the reason.
export const xpcallse = protected.xpcallse

--- Generates a random version 4 UUID, hyphenated and lowercase.
export const uuid4: function(): string = uuid.uuid4

--- Generates a time-ordered version 7 UUID, hyphenated and lowercase.
export const uuid7: function(): string = uuid.uuid7
