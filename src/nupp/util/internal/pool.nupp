--[[
Reusable instances of one record or struct declaration.

A pool keeps its allocations and leases each instance to one caller at a time.

```nupp
local record Damage
    amount: integer
end

local damage = table.newpool(Damage, 64)
local hit = damage:acquire()
hit.amount = 12
damage:release(hit)
assert(damage:free() == 64)
```

The size passed to `newpool` warms that many instances and sets the growth
quantum. `capacity` reports retained instances; it grows when the free list
runs out. A released instance becomes reusable immediately. `reset` refuses
live leases, restarts the acquisition count, and retains every allocation.

Record instances are ordinary tables, cleared on release. Struct rows are
zero-filled on acquisition and occupy pages that never move. Record pools
work on every backend; struct pools require C storage.
]]
module nupp.util.internal.pool

--- Reusable instances of one record or struct declaration.
--- @export
export record Pool<T>
    @private @readonly witness: any
    @private @readonly growth: integer
    @private @readonly backend: any

    --- How many instances the pool retains, including live leases.
    @readonly capacity: integer

    @private available: {T}
    @private values: {T}
    @private freecount: integer
    @private livecount: integer
    @private usedcount: integer
    @private pagecount: integer
    @private leases: table

    acquire: function(exclusive self: Pool<T>): T
    release: function(exclusive self: Pool<T>, value: T): nil
    reserve: function(exclusive self: Pool<T>, count: integer): nil
    live: function(self: Pool<T>): integer
    free: function(self: Pool<T>): integer
    pages: function(self: Pool<T>): integer
    used: function(self: Pool<T>): integer
    reset: function(exclusive self: Pool<T>): nil
end

local setfield: function(exclusive destination: table, key: string, value: integer): nil = rawset as any

-- Whether a caller's count is a nonnegative integer. The value is read
-- untyped: integer-typed arithmetic refuses a fractional or non-finite
-- operand with its own error before this check could name the argument.
local function iscount(value: any): boolean
    return type(value) == "number" and value >= 0 and value % 1 == 0
end

-- Whether a witness is a struct declaration. Its physical type is reachable
-- from the declaration and from every value, and only a value is one.
local function isstruct(witness: any): boolean
    if type(witness) ~= "cdata" then
        return false
    end
    local physical: any = witness["\0nupp:structType"]

    return physical ~= nil and not physical:isa(witness)
end

local function addpage<T>(exclusive self: Pool<T>): nil
    local count = self.growth
    local created: {T}
    if self.backend == nil then
        created = {}
        for index = 1, count do
            created[index] = setmetatable({}, self.witness) as T
        end
    else
        created = self.backend.allocate(count) as {T}
    end
    local retained = self.capacity
    for index = 1, count do
        local value = created[index]
        self.values[retained + index] = value
        self.available[retained + index] = value
        rawset(self.leases, value as any, false)
    end
    local free = self.freecount
    for index = count, 1, -1 do
        free = free + 1
        self.available[free] = created[index]
    end
    self.freecount = free
    self.pagecount = self.pagecount + 1
    setfield(self, "capacity", retained + count)
end

--- Acquires an empty record or zero-filled struct row.
---
--- Growth retains another allocation batch without moving existing rows.
--- Once enough instances exist, acquisition and release allocate nothing.
---
--- @param self the pool
--- @return the instance, live until it is released
--- @export
function Pool.acquire<T>(exclusive self: Pool<T>): T
    if self.freecount == 0 then
        addpage(self)
    end
    local count = self.freecount
    local value = self.available[count]
    if self.backend ~= nil then
        self.backend.clear(value)
    end
    -- The unused suffix keeps its array slots allocated for a full release.
    self.freecount = count - 1
    self.livecount = self.livecount + 1
    self.usedcount = self.usedcount + 1
    rawset(self.leases, value as any, true)

    return value
end

--- Ends a lease and makes its instance reusable immediately.
---
--- Record fields are cleared before the instance returns to the free list.
--- Struct storage is zero-filled when the row is next acquired.
---
--- @param self the pool
--- @param value the instance whose lease ends
--- @raises string when value is not live in this pool
--- @export
function Pool.release<T>(exclusive self: Pool<T>, value: T): nil
    if self.livecount == 0 then
        error("nupp: pool release without a live lease", 2)
    end
    if self.backend == nil and getmetatable(value) ~= self.witness then
        error("nupp: pool release of a value the pool's declaration did not stamp", 2)
    end
    if rawget(self.leases, value as any) ~= true then
        error("nupp: pool release of a value not live in this pool", 2)
    end
    rawset(self.leases, value as any, false)
    self.livecount = self.livecount - 1
    if self.backend == nil then
        table.clear(value as any)
    end
    local count = self.freecount + 1
    self.available[count] = value
    self.freecount = count
end

--- Ensures at least `count` instances are free, growing in allocation batches.
--- @param self the pool
--- @param count how many free instances to have waiting
--- @raises string when count is not a nonnegative integer
--- @export
function Pool.reserve<T>(exclusive self: Pool<T>, count: integer): nil
    if not iscount(count) then
        error("nupp: pool reserve count must be a nonnegative integer", 2)
    end
    while self.freecount < count do
        addpage(self)
    end
end

--- Returns the number of live leases.
--- @param self the pool
--- @return the live count
--- @export
function Pool.live<T>(self: Pool<T>): integer
    return self.livecount
end

--- Returns the number of instances available for acquisition.
--- @param self the pool
--- @return the free count
--- @export
function Pool.free<T>(self: Pool<T>): integer
    return self.freecount
end

--- Returns the number of retained allocation batches.
--- @param self the pool
--- @return the batch count
--- @export
function Pool.pages<T>(self: Pool<T>): integer
    return self.pagecount
end

--- Returns the number of acquisitions since the last reset.
--- @param self the pool
--- @return the acquisition count
--- @export
function Pool.used<T>(self: Pool<T>): integer
    return self.usedcount
end

--- Restarts acquisition order and counters while retaining all allocations.
--- @param self the pool
--- @raises string when any lease is live
--- @export
function Pool.reset<T>(exclusive self: Pool<T>): nil
    if self.livecount > 0 then
        error("nupp: pool reset with " .. tostring(self.livecount) .. " live leases", 2)
    end
    local free: integer = 0
    for index = self.capacity, 1, -1 do
        free = free + 1
        self.available[free] = self.values[index]
    end
    self.freecount = free
    self.usedcount = 0
end

--- Creates a pool of instances of a record or struct declaration.
---
--- ```nupp:fragment
--- local record Tick
---     frame: integer
--- end
---
--- local ticks = table.newpool(Tick, 8)
--- assert(ticks:free() == 8)
--- ```
---
--- @param witness the record or struct declaration
--- @param size initial capacity and growth quantum, 32 when omitted
--- @return the warmed pool
--- @raises string when size is not a nonnegative integer or witness is not a
---     record or struct declaration
--- @export
export function new<T>(witness: Type<T>, size: integer?): Pool<T>
    local initial = size ?? 32
    if not iscount(initial) then
        error("nupp: pool size must be a nonnegative integer", 2)
    end
    local backend: any = nil
    if type(witness) ~= "table" or rawget(witness as any, "__index") ~= witness then
        if not isstruct(witness) then
            error("nupp: pool expects a record or struct declaration", 2)
        end
        local implementation = "nupp.util.internal.structpool"
        backend = _G.require(implementation).new(witness)
    end
    local created = new Pool(
        witness = witness,
        growth = math.max(1, initial),
        backend = backend,
        capacity = 0,
        available = {} as {T},
        values = {} as {T},
        freecount = 0,
        livecount = 0,
        usedcount = 0,
        pagecount = 0,
        leases = {}
    ) as Pool<T>
    created:reserve(initial)

    return created
end
