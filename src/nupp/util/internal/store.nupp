module nupp.util.internal.store

--[[
Typed keys and the stores they index.

A key is a phantom-typed identity: Nupp remembers `T`, the runtime holds an id
and an optional name. A store is one table indexed by id behind generic methods,
so `store:get(key)` reads `T?` and `store:set(key, value)` accepts `T`.

Names are opaque strings registered once per runtime state. Ids are allocated
in declaration order and identify a key inside this state only; the name is the
identity that persists.
]]

local nextId: integer = 1
local named: {[string]: any} = {}
local names: {[integer]: string} = {}

local function nextRegistered(_: any, after: integer): (integer?, string?)
    local id: integer = after + 1
    local last: integer = nextId - 1
    while id <= last do
        local name: string? = names[id]
        if name ~= nil then
            return id, name
        end
        id = id + 1
    end

    return nil, nil
end

--- A typed identity for one value in a [](nupp.util.Store).
---
--- `id` and `name` are all a key holds at runtime. `_valueType` is never
--- present: it mentions `T` in both positions so that keys are invariant, which
--- is what makes a wrong write through one a checker error rather than a
--- silent widening.
--- @export
export record Key<T>
    --- The step of [](nupp.util.Key.registered).
    ---
    --- Terminating on nil is the generic for's business, so the surface type
    --- promises what the loop delivers rather than what the last call returns.
    type Step = function(any, integer): (integer, string)

    @readonly
    id: integer
    @readonly
    name: string?
    @readonly
    _valueType: (function(value: T?): T?)?

    --- Finds a registered key by name.
    ---
    --- The registry knows the name's id and nothing about its type, so the
    --- result is `unknown` and the caller casts to the `Key<T>` it claims.
    --- @param name the registered name
    --- @return the key, or nil when the name is not registered
    function find(name: string): unknown
        return named[name]
    end

    --- Walks every registered name, ascending by id.
    ---
    --- The walk allocates nothing: the step is one shared function and the
    --- control variable is the id it last reported. The registry itself is
    --- never handed out, so nothing the loop is given can be used to reach or
    --- change it. An anonymous key registers no name and is not walked.
    --- @return the step the loop calls
    --- @return nothing to carry, since the ids are the whole state
    --- @return the id to resume after, 0 to start
    function registered(): (function(any, integer): (integer, string), any, integer)
        return nextRegistered as function(any, integer): (integer, string), nil, 0
    end
end

--- Creates a key.
---
--- The type argument comes from the annotation at the declaration. A named key
--- is registered for the runtime state's lifetime; an anonymous key is
--- retained by nothing but its holders.
--- @param name the opaque name to register, or nil for an anonymous key
--- @return the key
--- @raises string when the name is empty or already registered, before an id is used
--- @export
export function newKey<T>(name: string?): Key<T>
    if name ~= nil then
        if name == "" then
            error("nupp: a key name must not be empty", 2)
        elseif named[name] ~= nil then
            error("nupp: key " .. name .. " is already registered", 2)
        end
    end
    local key: Key<T> = new Key(id = nextId, name = name)
    nextId = nextId + 1
    if name ~= nil then
        named[name] = key
        names[key.id] = name
    end

    return key
end

--- An independent typed bag indexed by keys.
--- @export
export interface Store
    --- The step of [](nupp.util.Store.entries).
    ---
    --- Terminating on nil is the generic for's business, so the surface type
    --- promises what the loop delivers rather than what the last call returns.
    type Step = function(Store, integer): (integer, string?, string)

    --- Answers the value held under a key.
    get: function<T>(self: Store, key: Key<T>): T?

    --- Stores a non-nil value under a key.
    --- @raises string when value is nil; use [](nupp.util.Store.remove) to delete an
    ---     entry
    set: function<T>(self: Store, key: Key<T>, value: T): nil

    --- Removes the value held under a key.
    remove: function<T>(self: Store, key: Key<T>): nil

    --- Removes every value without touching key registration.
    clear: function(self: Store): nil

    --- Walks every occupied key ascending by id, without its value.
    entries: function(
        borrows self: Store
    ): (function(Store, integer): (integer, string?, string), Store borrows (self), integer)
end

local record Bag is Store
    @private
    values: {[integer]: any}
end

--- Creates an empty store.
--- @return the store
--- @export
export function newStore(): Store
    return new Bag(values = {})
end

function Bag.get<T>(self, key: Key<T>): T?
    return self.values[key.id] as T?
end

function Bag.set<T>(self, key: Key<T>, value: T): nil
    if value == nil then
        error("nupp: Store:set value must not be nil; use Store:remove", 2)
    end
    self.values[key.id] = value
end

function Bag.remove<T>(self, key: Key<T>): nil
    self.values[key.id] = nil
end

function Bag.clear(self): nil
    self.values = {}
end

--- The step the walk hands the generic for: the first occupied key after an id,
--- or nil once there is none.
--- @param store the store to read
--- @param after the id to resume after, 0 to start
--- @return the id, or nil once the walk is done
--- @return the key's name, nil for an anonymous key
--- @return the Lua type name of the value
local function step(store: Bag, after: integer): (integer?, string?, string?)
    local id: integer = after + 1
    local last: integer = nextId - 1
    while id <= last do
        local value: any = store.values[id]
        if value ~= nil then
            return id, names[id], type(value)
        end
        id = id + 1
    end

    return nil, nil, nil
end

--- Walks every occupied key of a store, ascending by id, without its values.
---
--- The walk allocates nothing: the step is one shared function, the state is
--- the store, and the control variable is the id it last reported. Ids are
--- dense and ascending, so the order is the sorted order without a sort. It
--- never yields a value, so a caller can list a store without holding what is
--- in it.
--- @param self the store to walk
--- @return the step the loop calls
--- @return the store it walks
--- @return the id to resume after, 0 to start
function Bag.entries(borrows self): (Store.Step, Store borrows (self), integer)
    return step as Store.Step, self, 0
end
