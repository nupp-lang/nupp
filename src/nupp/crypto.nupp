module nupp.crypto

--[[Cryptographically secure randomness from the provider retained at module load.

Setup may select nupp.runtime.services.contracts.crypto before requiring this
module. The default uses the native host or browser host. For repeatable seeded
sequences use nupp.random. Message digests and MACs live in nupp.digest and nupp.mac.
]]
local contracts = require("nupp.runtime.services.contracts")
local provider = contracts.crypto:assemble(function(): contracts.CryptoProvider
    local native = contracts.crypto:lookup("nupp.native")
    if native ~= nil then
        return native
    end

    return contracts.crypto:require("nupp.browser")
end)

--- Returns cryptographically secure random bytes from the selected host.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises when the count is invalid or the host cannot supply randomness
export const randomBytes = provider.randomBytes
