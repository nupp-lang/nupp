@!internal

--[[
Shared interfaces for structured worker implementations.

The build binds the worker implementation for the selected target.
A provider owns its lane scheduler, but uses the canonical Scope, Task, Status,
and submitted-signature types declared here. A task scope owns a provider scope
privately for pooled and dedicated children. Generic spawn must
preserve the exact argument and result packs of the sendable function.

Arguments and results cross isolated Lua states as copies. Only explicitly
supported engine-backed affine owners move; arbitrary closures, pointers,
coroutines, and Lua-owned affine resources cannot be copied as task arguments.
Runtime validation must also reject unsupported value graphs that static types
cannot exclude. A task's result count preserves embedded and trailing nil values.
`await` returns that exact pack or raises failure/cancellation; `isdone` reports
terminal settlement, `status` reports scheduler state, and `cancel` reports
whether it made the first cancellation request.

Scope cleanup settles all children, including those never awaited, before
propagating unobserved failure. A scope lists only what cleanup could still owe
something to: every unsettled child, and a settled one whose failure nothing
observed and no observer took, or whose result holds moved allocations nothing
consumed. Any other child leaves the list as it settles, after its observer has
heard of it, and keeps its outcome for whoever holds it. Cancellation uses
[](coroutine.sus.iscancellation). Blocking waits cooperate with the selected
suspension implementation and must not discover implementations during settlement.

Each lane uses the artifact's immutable SPI index and loads independent module
instances. Provider objects and Lua closures are never transferred between lanes.
]]
module nupp.workers.contracts

const types = require("types")

--- What may actually be submitted: a module member, or an outlined literal whose
--- effectively-final captures can be copied to another lane. Exported so a task scope
--- can hold its `work` to the same bound without linking this module.
export type Worker = @sendable function(...: any): any

--- Whether a value can move instead of being copied: an owned table.Array
--- of a fixed-width element. The storage lives in
--- neither Lua heap, so handing its pointer to another lane is sound, and the affine
--- layer consumes the sender's binding where the move is written. The element names
--- here must agree with the runtime tag map in `nupp.array`.
@comptime
local function movableOwner(T: type): boolean
    local representation = T
    if types.kind(representation) == "affine" then
        representation = types.elements(representation)[1]
    end
    local described = types.describe(representation) as {[string]: any}
    if described.kind ~= "reference" then
        return false
    end
    local nominal = described.nominal as {[string]: any}
    if nominal == nil or nominal.moduleName ~= "nupp.array" or nominal.name ~= "Array" then
        return false
    end
    local arguments = types.arguments(representation)
    if arguments[1] == nil then
        return false
    end
    local element = types.describe(arguments[1]) as {[string]: any}
    if element.kind ~= "primitive" then
        return false
    end
    local movable = {
        uint8 = true,
        int8 = true,
        uint16 = true,
        int16 = true,
        uint32 = true,
        int32 = true,
        uint64 = true,
        int64 = true,
        float = true,
        number = true,
    }

    return movable[element.name as string] == true
end

@comptime
local function channelEndpoint(T: type): boolean
    if types.kind(T) == "affine" then
        T = types.elements(T)[1]
    end
    local described = types.describe(T) as {[string]: any}
    if described.kind ~= "reference" then
        return false
    end
    local nominal = described.nominal as {[string]: any}

    return nominal ~= nil
        and nominal.moduleName == "nupp.workers.internal.channeltypes"
        and (nominal.name == "Sender" or nominal.name == "Receiver")
end

@comptime
local function endpointResult(T: type): boolean
    local pending = {T}
    local seen: {[type]: boolean} = {}
    local index: integer = 1
    while index <= #pending do
        local current = pending[index]
        index = index + 1
        if not seen[current] then
            seen[current] = true
            if channelEndpoint(current) then
                return true
            end
            local kind = types.kind(current)
            if kind == "affine"
                or kind == "borrowed"
                or kind == "pinned"
                or kind == "const"
                or kind == "union"
                or kind == "intersection"
                or kind == "tuple"
                or kind == "array"
            then
                for _, member in ipairs(types.elements(current)) do
                    pending[#pending + 1] = member
                end
            elseif kind == "shape" or kind == "reference" then
                local described = types.describe(current) as {[string]: any}
                local fields = kind == "shape" and described.fields
                    or described.nominal and described.nominal.fields
                    or {}
                for _, field in ipairs(fields) do
                    if field.read ~= nil and (kind == "shape" or field.stored) then
                        pending[#pending + 1] = field.read
                    end
                end
            end
        end
    end

    return false
end

--- Returns child arguments after checking that no owner or borrow is handed off.
@comptime
export function Parameters(F: type): typepack
    if types.kind(F) ~= "function" then
        return types.error("a task must name a function type")
    end
    local described = types.describe(types.parameters(F))
    for position, mode in ipairs(described.modes or {}) do
        if mode ~= "plain" then
            return types.error(
                "argument " .. tostring(position) .. " is an owner or a borrow, which a child cannot be handed"
            )
        end
    end

    for position, member in ipairs(types.describe(types.results(F)).head or {}) do
        if endpointResult(member) then
            return types.error(
                "result " .. tostring(
                    position
                ) .. " contains a channel endpoint; endpoints cannot leave through task results"
            )
        end
    end

    return types.parameters(F)
end

--- Why a declared type cannot cross an isolated-state boundary.
---
--- Arguments and results are copied between isolated Lua states, so a type no copy can
--- reproduce is a mistake in the signature rather than in a call. Only what can never
--- cross is named here. `any`, a bare `table`, and a record say nothing definite about
--- the value that will arrive, and identity -- a cycle, a repeated table, depth -- is a
--- property of values rather than of their types. Both stay with the copy itself.
---
--- The walk terminates on a self-referential type because the edge that would close the
--- loop is one the compile-time view of a type does not carry.
@comptime
local function unsendable(T: type, label: string): string?
    local named = {
        thread = "a thread",
        userdata = "userdata",
        cdata = "cdata",
        cstring = "a C string",
        voidptr = "a pointer",
    }
    local pending = {{at = T, path = label}}
    local index: integer = 1
    while index <= #pending do
        local item = pending[index]
        index = index + 1
        local kind = types.kind(item.at)
        if channelEndpoint(item.at) then
            return item.path .. " is a channel endpoint, which may move only as a direct worker startup argument"
        elseif kind == "primitive" then
            local why = named[types.describe(item.at).name]
            if why ~= nil then
                return item.path .. " is " .. why
            end
        elseif kind == "function" then
            return item.path .. " is a function"
        elseif kind == "affine" then
            -- An affine owner of engine-backed storage moves: the message carries its
            -- pointer, and the receiving lane becomes the one owner. Anything whose
            -- representation lives in a Lua heap keeps the refusal.
            local inner = types.elements(item.at)
            if inner == nil or not movableOwner(inner[1]) then
                return item.path .. " is an affine owner"
            end
        elseif kind == "ptr" or kind == "carray" then
            return item.path .. " is a C pointer"
        elseif kind == "array" then
            for _, element in ipairs(types.elements(item.at)) do
                pending[#pending + 1] = {at = element, path = item.path .. "[]"}
            end
        elseif kind == "tuple" then
            for position, member in ipairs(types.elements(item.at)) do
                pending[#pending + 1] = {at = member, path = item.path .. "[" .. tostring(position) .. "]"}
            end
        elseif kind == "union" or kind == "intersection" then
            for position, member in ipairs(types.elements(item.at)) do
                pending[#pending + 1] = {at = member, path = item.path .. " (alternative " .. tostring(position) .. ")"}
            end
        elseif kind == "const" or kind == "borrowed" or kind == "pinned" then
            for _, inner in ipairs(types.elements(item.at)) do
                pending[#pending + 1] = {at = inner, path = item.path}
            end
        elseif kind == "shape" then
            for _, field in ipairs(types.describe(item.at).fields or {}) do
                if field.read ~= nil then
                    pending[#pending + 1] = {at = field.read, path = item.path .. "." .. field.name}
                end
            end
        end
    end

    return nil
end

@comptime
export function ChannelMessage(T: type): type
    local problem = unsendable(T, "message")
    if problem ~= nil then
        return types.error(problem)
    end

    return T
end

-- Validate the payload without placing a deferred type call inside an endpoint.
@comptime
export function ChannelLimits(T: type): typepack
    local problem = unsendable(T, "message")
    if problem ~= nil then
        return types.error(problem)
    end

    return types.pack({types.integer, types.integer})
end

-- An any message carries copied values. Requiring an explicit owning payload
-- type prevents an owned argument from losing its obligation in an any result
-- when trysend returns it to the caller.
@comptime
export function MessageArguments(T: type): typepack
    local message = ChannelMessage(T)
    local dynamic = types.kind(T) == "primitive" and types.describe(T).name == "any"
    return types.pack({message}, nil, {dynamic and "plain" or "takes"})
end

--- The arguments a submitted function takes, once its whole signature is known to be
--- copyable. Reached only from `spawn`: naming `Task<F>` describes a handle rather than
--- a crossing, so a signature is held to this where it is submitted and nowhere else.
@comptime
export function Submitted(f: type): typepack
    if types.kind(f) ~= "function" then
        return types.error("a worker job must name a function type")
    end
    local packs = {{of = types.parameters(f), what = "argument"}, {of = types.results(f), what = "result"},}
    for _, one in ipairs(packs) do
        local described = types.describe(one.of)
        -- An ownership mode is a promise about one Lua heap: the caller's. Named before
        -- the types are walked, because a pack carrying one cannot be rebuilt at all
        -- and would otherwise report that instead of the reason.
        local headTypes = described.head as {any} or {}
        for position, mode in ipairs(described.modes or {}) do
            -- One exception: a `takes` parameter whose type is an engine-backed owner
            -- is a move rather than a copy, and the affine layer consumes the caller's
            -- binding at the spawn. Every other ownership mode keeps the refusal.
            local moved = mode == "takes"
                and one.what == "argument"
                and (movableOwner(headTypes[position]) or channelEndpoint(headTypes[position]))
            if mode ~= "plain" and not moved then
                return types.error(
                    one.what .. " " .. tostring(
                        position
                    ) .. " is an owner or a borrow, which cannot cross into another Lua state"
                )
            end
        end
        for position, member in ipairs(described.head or {}) do
            local endpoint = one.what == "argument"
                and described.modes
                and described.modes[position] == "takes"
                and channelEndpoint(member)
            local why = not endpoint and unsendable(member, one.what .. " " .. tostring(position)) or nil
            if why ~= nil then
                return types.error(why .. ", which cannot cross into another Lua state")
            end
        end
        if described.tail ~= nil then
            local why = unsendable(described.tail, "every extra " .. one.what)
            if why ~= nil then
                return types.error(why .. ", which cannot cross into another Lua state")
            end
        end
    end

    return types.parameters(f)
end

--- Where a task is: waiting to start, running, or settled one of three ways.
---
--- A closed union, so a `switch` over it needs no `else`. `coroutine` names it
--- `Status`.
export type Status = "queued" | "running" | "done" | "failed" | "cancelled"

@comptime
local function TaskType(F: type): type
    if types.kind(F) ~= "function" then
        return types.error("a task must name a function type")
    end
    return types.shape({
        --- Waits for settlement and returns the function's complete result pack.
        {name = "await", read = types.functiontype(types.pack({types.any}), types.results(F)),},

        --- Reports whether the task has settled without waiting.
        {name = "isdone", read = types.functiontype(types.pack({types.any}), types.pack({types.bool})),},

        --- Returns the task's current scheduling state.
        {
            name = "status",
            read = types.functiontype(
                types.pack({
                    types.any
                }),
                types.pack({
                    types.union({
                        types.literal("queued"),
                        types.literal("running"),
                        types.literal("done"),
                        types.literal("failed"),
                        types.literal("cancelled"),
                    })
                })
            ),
        },

        --- Requests cancellation and reports whether this is the first request.
        {
            name = "cancel",
            read = types.functiontype(
                types.pack({
                    types.any,
                    types.optional(types.string)
                }),
                types.pack({
                    types.bool
                })
            ),
        },
    })
end

--- The typed handle for a started function, which `coroutine` names `Task<F>`.
---
--- Its `await` result pack is the function's, which is why this is derived from
--- the function type rather than declared once over `any`. `status` returns a
--- [](coroutine.Status).
export type Task<F> = TaskType(F)

--- A family of parallel child tasks, owned by the task scope whose `work` opened it.
export record Scope
    _scheduler: any
    _dedicated: {any}
    _channelOwner: any?
    _first: any
    _last: any
    _registered: integer
    _closed: boolean
    _deadline: number?
    _observer: any

    -- Structured-task integration already guards the whole admission/handoff.
    -- Private provider callers keep using the guarded spawn and worker methods.
    _submit: (function(Scope, boolean, any, ...: any): any)?

    --- Starts a sendable function with copied arguments.
    spawn: function<F is Worker>(borrows self: Scope, F, ...: unpackof Submitted(F)): Task<F>

    -- Dedicated entries use the same transfer contract as pooled jobs.
    worker: function<F is Worker>(borrows self: Scope, F, ...: unpackof Submitted(F)): Task<F>

    --- Waits for every child, raising the first failure nothing observed. Idempotent.
    --- Under a suspension handler it parks until every child has settled, and without
    --- one it blocks.
    close: function(borrows self: Scope): nil

    _cancelAll: function(Scope, string?): nil

    --- Waits for the oldest child not yet settled, without observing it, and
    --- returns whether there was one.
    _settleOldest: function(Scope): boolean
end

--- Complete worker implementation protocol, including structured-task integration.
--- Implement generic spawn and ownership guarantees through the shared scope types.
export interface Provider
    @readonly channel: (function(owner: any, messages: integer, bytes: integer): (any, any))?
    @readonly closechannels: (function(borrows owner: any): nil)?
    @readonly ownsarguments: (function(...: any): boolean)?
    @readonly cleanuparguments: (function(...: any): nil)?

    --- Creates canonical scope state for task integration, with an optional
    --- monotonic deadline and observer.
    @readonly openscope: function(deadline: number?, observer: any): Scope

    --- Waits for a task and returns status, packed values, exact count, and problem.
    --- Status is done, failed, or cancelled; cancellation preserves its shared
    --- identity.
    @readonly settle: function(task: any): (string, {any}?, integer, any)

    --- Runs provider scheduler progress using its retained lane state.
    @readonly runscheduler: function(): nil

    --- Associates an executable function with its module/member identity.
    @readonly definesendable: function(modulename: string, member: string, fn: any): nil

    --- Describes a submitted function and captures for destination-lane execution.
    @readonly describesendable: function(fn: any, modulename: string, member: string, ...: any): any
end
