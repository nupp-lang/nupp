module nupp.workers

local contracts = require("nupp.runtime.services.workers")
local provider = assert(
    require("nupp.runtime.workersprovider").provider,
    "nupp.workers: no worker provider is available"
)
local workers = {}

local type Callable = function(...: any): any
type workers.Submittable = contracts.Submittable
type workers.Task<F is Callable> = contracts.Task<F>
type workers.ScopeToken = contracts.ScopeToken
type workers.Scope = contracts.PublicScope

--- Opens a family of isolated worker tasks with structured cleanup.
const workers.scope = provider.scope

rawset(workers, "__scope", provider.openScope)
rawset(workers, "__settle", provider.settle)
rawset(workers, "__parallelism", provider.parallelism)
rawset(workers, "__runScheduler", provider.runScheduler)
rawset(workers, "__defineSendable", provider.defineSendable)
rawset(workers, "__sendable", provider.describeSendable)

export = workers
