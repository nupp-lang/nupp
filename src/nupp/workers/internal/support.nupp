@!internal
module nupp.workers.internal.support

local {type Scope} = require("nupp.workers.contracts")

export type Packed = {
    values: {any},
    count: integer
}

export function pack(...: any): Packed
    return {values = {...}, count = select("#", ...)}
end

export function concatenate(captures: Packed, arguments: Packed): Packed
    if captures.count == 0 then
        return arguments
    end
    local submitted: Packed = {values = {}, count = captures.count + arguments.count}
    for index = 1, captures.count do
        submitted.values[index] = captures.values[index]
    end
    for index = 1, arguments.count do
        submitted.values[captures.count + index] = arguments.values[index]
    end

    return submitted
end

export function sendableKey(moduleName: string, member: string): string
    return moduleName .. "\0" .. member
end

export function callableAddress(
    fn: any,
    sendableDescriptors: {[any]: any},
    scannedAddresses: {[any]: {string}},
    loaded: {[any]: any}
): (string?, string?)
    local described = sendableDescriptors[fn]
    if described ~= nil then
        return described.module, described.member
    end
    local scanned = scannedAddresses[fn]
    if scanned ~= nil then
        return scanned[1], scanned[2]
    end
    local found: {string} = {}
    for moduleName, moduleValue in pairs(loaded) do
        if type(moduleName) == "string" and type(moduleValue) == "table" then
            for member, value in pairs(moduleValue as {[any]: any}) do
                if type(member) == "string" and value == fn then
                    found[#found + 1] = moduleName .. "\0" .. member
                end
            end
        end
    end
    table.sort(found)
    local address = found[1]
    if address == nil then
        return nil, nil
    end
    local moduleName, member = address:match("^(.-)%z(.*)$")
    scannedAddresses[fn] = {moduleName as string, member as string}

    return moduleName, member
end

export function resolve(moduleName: string, member: string, outlined: {[string]: any}, load: function(string): any): any
    local moduleValue = load(moduleName)
    local callable = outlined[sendableKey(moduleName, member)]
        or (type(moduleValue) == "table" and (moduleValue as {[string]: any})[member] or nil)
    if type(callable) ~= "function" then
        error(("%s.%s is not a registered sendable function"):format(moduleName, member), 0)
    end

    return callable
end

export function enlist(scope: any, task: any): nil
    local last = scope._last
    task._scope = scope
    task._listed = true
    task._before = last
    task._after = nil
    if last ~= nil then
        last._after = task
    else
        scope._first = task
    end
    scope._last = task
    scope._registered = scope._registered + 1
end

export function delist(task: any): nil
    if not task._listed then
        return
    end
    local scope = task._scope
    local before = task._before
    local after = task._after
    if before ~= nil then
        before._after = after
    else
        scope._first = after
    end
    if after ~= nil then
        after._before = before
    else
        scope._last = before
    end
    task._listed = false
    task._before = nil
    task._after = nil
    scope._registered = scope._registered - 1
end

export function listed(borrows scope: Scope): {any}
    local tasks: {any} = {}
    local task = scope._first
    while task ~= nil do
        tasks[#tasks + 1] = task
        task = task._after
    end

    return tasks
end
