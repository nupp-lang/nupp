module nupp.data.internal.store

--[[
Typed keys and the stores they index.

A key is a phantom-typed identity: Nupp remembers `T`, the runtime holds an id
and an optional name. A store is one table indexed by id behind two generic
metamethods, so `store[key]` reads `T?` and `store[key] = value` accepts `T?`.

Names are opaque strings registered once per runtime state. Ids are allocated
in declaration order and identify a key inside this state only; the name is the
identity that persists. [NEP 34](docs/neps/0034-typed-keys-and-stores.md)
records why the key is shaped the way it is.
]]

--- A typed identity for one value in a [](nupp.data.Store).
---
--- `id` and `name` are all a key holds at runtime. `_valueType` is never
--- present: it mentions `T` in both positions so that keys are invariant, which
--- is what makes a wrong write through one a checker error rather than a
--- silent widening.
--- @export
export interface Key<T>
    readonly id: integer
    readonly name: string?
    readonly _valueType: (function(value: T?): T?)?
end

--- An independent typed bag indexed by keys.
--- @export
export record Store
    private values: {[integer]: any}
    metamethod __index: function<T>(self, key: Key<T>): T?
    metamethod __newindex: function<T>(self, key: Key<T>, value: T?)
end

Store.__index = function<T>(self: Store, key: Key<T>): T?
    return self.values[key.id] as T?
end

Store.__newindex = function<T>(self: Store, key: Key<T>, value: T?): nil
    self.values[key.id] = value
end

local nextId: integer = 1
local named: {[string]: Key<any>} = {}
local names: {[integer]: string} = {}

--- Creates a key.
---
--- The type argument comes from the annotation at the declaration. A named key
--- is registered for the runtime state's lifetime; an anonymous key is
--- retained by nothing but its holders.
--- @param name the opaque name to register, or nil for an anonymous key
--- @return the key
--- @raises when the name is empty or already registered, before an id is used
--- @export
export function newKey<T>(name: string?): Key<T>
    if name ~= nil then
        if name == "" then
            error("nupp: a key name must not be empty", 2)
        elseif named[name] ~= nil then
            error("nupp: key " .. name .. " is already registered", 2)
        end
    end
    local key: Key<T> = {id = nextId, name = name}
    nextId = nextId + 1
    if name ~= nil then
        named[name] = key as Key<any>
        names[key.id] = name
    end

    return key
end

--- Finds a registered key by name.
---
--- The registry knows the name's id and nothing about its type, so the result
--- is `unknown` and the caller casts to the `Key<T>` it claims.
--- @param name the registered name
--- @return the key, or nil when the name is not registered
--- @export
export function findKey(name: string): unknown
    return named[name]
end

--- Returns a fresh table from every registered name to its id.
--- @return the caller-owned listing
--- @export
export function listKeys(): {[string]: integer}
    local result: {[string]: integer} = {}
    for name, key in pairs(named) do
        result[name] = key.id
    end

    return result
end

--- Creates an empty store.
--- @return the store
--- @export
export function new(): Store
    return new Store(values = {})
end

--- Removes every value from a store without touching any registration.
--- @param store the store to clear
--- @return nothing
--- @export
export function clear(store: Store): nil
    store.values = {}
end

--- The step of [](nupp.data.storeEntries).
---
--- Terminating on nil is the generic for's business, so the surface type
--- promises what the loop delivers rather than what the last call returns.
--- @export
export type StoreStep = function(Store, integer): (integer, string?, string)

--- Reports the first occupied key after an id, or nil when there is none.
---
--- This is the step [](entries) hands the generic for, exported for a caller
--- that holds the store as a borrow and so cannot pass it to the loop.
--- @param store the store to read
--- @param after the id to resume after, 0 to start
--- @return the id, or nil once the walk is done
--- @return the key's name, nil for an anonymous key
--- @return the Lua type name of the value
--- @export
export function nextEntry(borrows store: Store, after: integer): (integer?, string?, string?)
    local id: integer = after + 1
    local last: integer = nextId - 1
    while id <= last do
        local value: any = store.values[id]
        if value ~= nil then
            return id, names[id], type(value)
        end
        id = id + 1
    end

    return nil, nil, nil
end

--- Walks every occupied key of a store, ascending by id, without its values.
---
--- The walk allocates nothing: the step is one shared function, the state is
--- the store, and the control variable is the id it last reported. Ids are
--- dense and ascending, so the order is the sorted order without a sort. It
--- never yields a value, so a caller can list a store without holding what is
--- in it.
--- @param store the store to walk
--- @return the step the loop calls
--- @return the store it walks
--- @return the id to resume after, 0 to start
--- @export
export function entries(store: Store): (StoreStep, Store, integer)
    return nextEntry as StoreStep, store, 0
end
