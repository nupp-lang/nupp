@!internal

--[[
Declares the surface of the simdjson-backed host module that
[](nupp.data.json) re-exports.

Programs reach it as `nupp.data.json`, which loads this boundary and re-exports
it, so the shape is declared here and nowhere else.

`decodeAs`, `writeAs`, `writeRecord`, `encodeAs` and `encodeRecord` are not the
host's. The derive runtime installs them onto this table when a program derives JSON
for a type, and they raise when nothing was derived. They are declared with the rest
so a caller sees one API.
]]

--- The host module's surface, as `nupp.data.json` hands it out.
record json
    --- Values that write their JSON encoding through a checked writer.
    interface JSONEncodable
        writeJSON: function(self, exclusive out: Writer): nil
    end

    --- A checked incremental JSON writer.
    interface Writer
        --- Starts an array value.
        --- @param self this writer
        --- @return this writer
        startArray: function(exclusive self: Writer): Writer borrows (self)

        --- Starts an object value.
        --- @param self this writer
        --- @return this writer
        startObject: function(exclusive self: Writer): Writer borrows (self)

        --- Selects the next object member.
        --- @param self this writer
        --- @param name the next object member name
        --- @return this writer
        key: function(exclusive self: Writer, name: any): Writer borrows (self)

        --- Appends one complete Lua value.
        --- @param self this writer
        --- @param value the next complete JSON value
        --- @return this writer
        write: function(exclusive self: Writer, value: any): Writer borrows (self)

        --- Appends JSON null.
        --- @param self this writer
        --- @return this writer
        null: function(exclusive self: Writer): Writer borrows (self)

        --- Ends the current array.
        --- @param self this writer
        --- @return this writer
        endArray: function(exclusive self: Writer): Writer borrows (self)

        --- Ends the current object.
        --- @param self this writer
        --- @return this writer
        endObject: function(exclusive self: Writer): Writer borrows (self)

        --- Publishes staged bytes without ending the document.
        flush: nosuspend function(exclusive self: Writer): nil

        --- Verifies and publishes a complete root, then closes the writer.
        close: nosuspend function(exclusive self: Writer): nil
    end

    --- Decodes one JSON document.
    ---
    --- Null members are dropped unless a replacement value is supplied.
    ---
    --- ```nupp
    --- local value = nupp.data.json.decode('{"id": 41}')
    --- assert(value.id == 41)
    --- ```
    --- @param text the complete JSON document
    --- @param nullValue the value used for JSON null, or nil to drop nulls
    --- @return the decoded Lua value
    decode: function(text: string, nullValue: any?): any

    --- Materializes only the fields selected by an On-Demand pull shape.
    --- @param text the complete JSON document
    --- @param shape the fields and array members to materialize
    --- @param nullValue the value used for JSON null, or nil to drop nulls
    --- @return the selected Lua value
    pull: function(text: string, shape: any, nullValue: any?): any

    --- Applies one pull shape to every member of an array.
    --- @param shape the selection applied to each member, or every value when
    ---     omitted
    --- @return an array pull shape
    arrayOf: function(shape: any?): table

    --- Marks a Lua table as a JSON array, including while it is empty.
    --- @param value the table to mark
    --- @return the same table
    asArray: function<T is table>(takes value: T): T preserves value

    --- Marks a Lua table as a JSON object.
    --- @param value the table to mark
    --- @return the same table
    asObject: function<T is table>(takes value: T): T preserves value

    --- Serializes one Lua value as JSON.
    --- @param value the value to serialize
    --- @param nullValue an additional value treated as JSON null
    --- @return the JSON document
    encode: function(value: any, nullValue: any?): string

    --- Alias of `encode`.
    --- @param value the value to serialize
    --- @param nullValue an additional value treated as JSON null
    --- @return the JSON document
    serialize: function(value: any, nullValue: any?): string

    --- Encodes a reusable trusted JSON value.
    encoded: function(value: any, nullValue: any?): any

    --- Encodes and interns a reusable trusted JSON string.
    encodedString: function(value: string): any

    --- Validates existing bytes as one trusted JSON value.
    verified: function(text: string): any

    --- Validates and interns existing bytes as one trusted JSON string.
    verifiedString: function(text: string): any

    --- Creates an incremental JSON writer.
    ---
    --- Each call answers the writer again, so a document is built as one chain
    --- while bytes are appended directly to caller-owned storage.
    ---
    --- ```nupp
    --- local out = string.buffer.new()
    --- local writer = nupp.data.json.writer(out)
    --- writer:startObject():key("id"):write(41):endObject()
    --- writer:close()
    --- ```
    --- @param out the checked destination
    --- @param nullValue an additional value treated as JSON null
    --- @return a new writer
    writer: function(exclusive out: string.buffer.Buffer, nullValue: any?): Writer

    --- Compiles the immutable scalar structure plan used by prepared serde JSON.
    compileSerde: function(fields: {any}, unknownMembers: string): any

    --- Encodes a record or struct in one prepared native traversal.
    encodeSerdeRecord: function(schema: any, value: any): string

    --- Encodes indexed dynamic slots in one prepared native traversal.
    encodeSerdeSlots: function(schema: any, value: {any}): string

    --- Encodes a record or struct into reserved caller-owned storage.
    encodeSerdeRecordInto: function(schema: any, value: any, borrows destination: uint8[?], capacity: uint64): uint64

    --- Encodes indexed dynamic slots into reserved caller-owned storage.
    encodeSerdeSlotsInto: function(schema: any, value: {any}, borrows destination: uint8[?], capacity: uint64): uint64

    --- Copies the last encoding after its first reservation was too small.
    copySerdeEncoding: function(borrows destination: uint8[?], capacity: uint64): nil

    --- Decodes directly into a record or struct.
    decodeSerdeRecord: function(schema: any, text: string, type: any): any

    --- Decodes directly into indexed dynamic slots.
    decodeSerdeSlots: function(schema: any, text: string): {any}

    --- Decodes JSON into the nominal record named by its one type witness.
    --- @param type the record's type witness, naming what to decode into
    --- @param text the JSON document to decode
    --- @return the decoded record, or nil when the document does not fit it
    --- @return why it did not fit, when unsuccessful
    decodeAs: function<T>(type: Type<T>, text: string): (T?, string?)

    --- Appends a nominal record after explicitly supplying its type witness.
    --- @param type the record's type witness
    --- @param value the record to encode
    --- @param out the checked destination
    writeAs: function<T>(type: Type<T>, value: T, exclusive out: Writer): nil

    --- Appends a nominal record using the metatable its value already carries.
    --- @param value the record to encode
    --- @param out the caller-owned destination
    writeRecord: function<T>(value: T, exclusive out: Writer): nil

    --- Encodes a nominal record into a new string after supplying its type witness.
    --- @param type the record's type witness
    --- @param value the record to encode
    --- @return the encoded JSON document
    encodeAs: function<T>(type: Type<T>, value: T): string

    --- Encodes a nominal record into a new string using its own metatable.
    --- @param value the record to encode
    --- @return the encoded JSON document
    encodeRecord: function<T>(value: T): string

    --- Creates the schema-driven JSON codec.
    newCodec: function(options: any?): any

    --- Sentinel that decodes from and encodes as JSON null.
    NULL: any

    --- An explicit empty JSON array.
    EMPTY_ARRAY: table

    --- An explicit empty JSON object.
    EMPTY_OBJECT: table

end

--- @local
local value: json

return value
