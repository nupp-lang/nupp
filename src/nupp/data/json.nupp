module nupp.data.json

--[[
JSON encoding and decoding, and the values a Lua table cannot express by itself.

The work is simdjson's, reached through the `jsonNative` host boundary this module
loads. Nothing is reimplemented here: the module is the name a program uses and the
place the load is arranged, so a checked program never names the host.

`decodeAs`, `encodeAs` and `encodeRecord` are not the host's. They are installed onto
this table by the derive runtime when a program derives JSON for a type, because they
answer in terms of a derived entry rather than a document alone. They are declared
with the rest of the surface so a caller sees one API, and they raise when nothing
was derived.
]]

-- Normally the rock is on the path and this does nothing. A build that carries the
-- shared object without registering it names it in NUPP_JSON_LIBRARY instead, so the
-- boundary is opened directly rather than failing on a name Lua cannot find.
do
    local found = pcall(require, "jsonNative")
    if not found then
        local path = os.getenv("NUPP_JSON_LIBRARY")
        local open = path and package.loadlib(path, "luaopen_jsonNative") or nil
        if not open then
            error("nupp: JSON runtime is unavailable", 0)
        end
        package.loaded.jsonNative = (open as function(): any)()
    end
end

const native = require("jsonNative")

--- Values that can encode themselves as JSON text.
---
--- Declared here rather than aliased out of the host boundary, because this is the
--- name callers write: `derive.JSON` answers a contract in terms of it. `Writer` is
--- not declared here, because nothing names it as a type -- it is reached as a value
--- from `writer()`.
export interface JSONEncodable
    toJSON: function(self): string
end

export = native
