module nupp.bits

--[[
The word operations no operator spells.

```nupp
const bits = require("nupp.bits")

print(bits.tohex(bits.bswap(0x11223344))) -- 44332211
```

`&`, `|`, `~` and the shifts are operators, and each lowers to whatever the
target has, so a program writes the operator rather than naming an
implementation. Rotation, byte reversal, hexadecimal formatting and 32-bit
normalization have no operator, and this is where portable source reaches them.

Every operand is normalized to a signed 32-bit word first, so a wider integer
has to be split into limbs by whoever holds it.
]]
const bitops = require("nupp.runtime.bitops")

--- Normalizes a value to a signed 32-bit word.
--- @param value the operand to normalize
--- @return the operand as a signed 32-bit word
export const tobit: function(value: number): integer = bitops.tobit

--- Formats the low hexadecimal digits of a word.
--- @param value the word to format
--- @param digits how many digits to write, eight by default; a negative count writes
---     uppercase
--- @return the digits, lowercase unless the count was negative
export const tohex: function(value: number, digits: number?): string = bitops.tohex

--- Rotates a word left by the low five bits of a count.
--- @param value the word to rotate
--- @param count how far to rotate
--- @return the rotated word
export const rol: function(value: number, count: number): integer = bitops.rol

--- Rotates a word right by the low five bits of a count.
--- @param value the word to rotate
--- @param count how far to rotate
--- @return the rotated word
export const ror: function(value: number, count: number): integer = bitops.ror

--- Reverses the four bytes of a word.
--- @param value the word to reverse
--- @return the word with its byte order swapped
export const bswap: function(value: number): integer = bitops.bswap
