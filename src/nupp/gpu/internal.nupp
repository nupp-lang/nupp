@!internal
module nupp.gpu.internal

local api = require("nupp.gpu.api")
export type Kernel = api.Kernel
export type Binding = api.Binding
export type ArtifactSet = api.ArtifactSet
export const ArtifactSet = api.ArtifactSet
export function compileGenerated(
    borrows context: api.Context,
    artifacts: api.ArtifactSet,
    readonlyBuffers: integer,
    writableBuffers: integer,
    uniformBytes: integer,
    threads: integer?
): api.Kernel borrows (context)
    return (
        context as api.KernelContext
    ):compileGenerated(artifacts, readonlyBuffers, writableBuffers, uniformBytes, threads)
end

--- Binds a kernel for `count` elements through the context that compiled it.
export function bindKernel(borrows kernel: api.Kernel, count: integer): api.Binding borrows (kernel)
    return ((kernel as any)._anchor as api.KernelContext):bindKernel(kernel, count)
end
