@!internal
module nupp.gpu.operations

local api = require("nupp.gpu.api")
local types = require("nupp.gpu.types")
local tensorlayout = require("nupp.gpu.layout")
local layoutFacts = require("nupp.gpu.layoutfacts").layoutFacts
local {type Layout as TensorLayout} = require("nupp.gpu.layout")
local array = require("nupp.mem.array")
local gpu = {}

--- The storage kind each scalar array witness names.
const SCALAR_KINDS: {
    [any]: string
} = {
    [array.uint8] = "uint8",
    [array.int8] = "int8",
    [array.uint16] = "uint16",
    [array.int16] = "int16",
    [array.uint32] = "uint32",
    [array.int32] = "int32",
    [array.uint64] = "uint64",
    [array.int64] = "int64",
    [array.float] = "float",
    [array.number] = "number",
}

type gpu.Buffer<T> = types.Buffer<T>
gpu.Buffer = types.Buffer
type gpu.Kernel = types.Kernel
gpu.Kernel = types.Kernel
type gpu.Shared<T> = types.Shared<T>
gpu.Shared = types.Shared
type gpu.Phases = types.Phases
gpu.Phases = types.Phases
type gpu.Context = api.Context
gpu.PORTABLE_WORKGROUP_THREADS = types.PORTABLE_WORKGROUP_THREADS

local function copied(values: {integer}): {integer}
    local out: {integer} = {}
    for index, value in ipairs(values) do
        out[index] = value
    end

    return out
end

--- The element count, dense row-major strides and a copy of a tensor shape.
--- Errors name the caller of the method that asked.
--- @raises string when the shape has no elements or does not fit uint32
function gpu.denseShape(shape: {integer}): (integer, {integer}, {integer})
    if #shape < 1 or #shape > 4 then
        error("nupp: GPU tensors take one through four dimensions", 3)
    end
    local count: integer = 1
    local strides: {integer} = {}
    for index = #shape, 1, -1 do
        local dimension = shape[index]
        if type(dimension) ~= "number" or dimension % 1 ~= 0 or dimension < 1 or count > 4294967295 // dimension then
            error("nupp: GPU tensor dimensions must have 1 through 4294967295 elements", 3)
        end
        strides[index] = count
        count = count * dimension
    end

    return count, strides, copied(shape)
end

local function liveBuffer(state: {released: boolean}): nil
    if state.released then
        error("nupp: GPU buffer was released", 3)
    end
end

function gpu.Shared.get<T>(borrows self: gpu.Shared<T>, index: integer): T
    if type(index) ~= "number" or index % 1 ~= 0 or index < 0 or index >= self.count then
        error("nupp: GPU shared-scratch index out of bounds", 2)
    end
    return self._values[index + 1]
end

function gpu.Shared.set<T>(exclusive self: gpu.Shared<T>, index: integer, value: T): nil
    if type(index) ~= "number" or index % 1 ~= 0 or index < 0 or index >= self.count then
        error("nupp: GPU shared-scratch index out of bounds", 2)
    end
    self._values[index + 1] = value
end

local sharedType: any = types.Shared
local sharedMembers: any = rawget(sharedType, "__index")
local sharedGet: any = rawget(sharedType, "get")
local sharedSet: any = rawget(sharedType, "set")
rawset(sharedType, "__index", function(self: any, key: any): any
    if type(key) == "number" then
        return sharedGet(self, key)
    end

    return sharedMembers[key]
end)
rawset(sharedType, "__newindex", function(self: any, key: any, value: any): nil
    if type(key) == "number" then
        sharedSet(self, key, value)
        return
    end
    rawset(self, key, value)
end)

function gpu.Phases.scratch<T>(borrows self: gpu.Phases, initial: T, count: integer): gpu.Shared<T>
    if type(count) ~= "number" or count % 1 ~= 0 or count < 1 then
        error("nupp: GPU shared scratch must contain at least one element", 2)
    end
    local values: {T} = {}
    for index = 1, count do
        values[index] = initial
    end

    return new types.Shared(_values = values, count = count)
end

function gpu.Phases.run(borrows self: gpu.Phases, scoped stage: function(uint32): nil): nil
    for index = 0, self._size - 1 do
        stage(nupp.math.u32.wrap(index))
    end
end

function gpu.Phases.reduceSum(borrows self: gpu.Phases, exclusive valuesInput: api.Shared<float>): nil
    local values = valuesInput as gpu.Shared<float>
    if values.count ~= self._size or self._size < 1 or self._size & (self._size - 1) ~= 0 then
        error("nupp: fixed-tree reduction needs one power-of-two value per lane", 2)
    end
    local stride = self._size // 2
    while stride > 0 do
        local active = stride
        self:run(function(localIndex: uint32)
            local lane = localIndex as integer
            if lane < active then
                values[
                    lane
                ] = nupp.math.f32.add(nupp.math.f32.narrow(values[lane]), nupp.math.f32.narrow(values[lane + active]))
            end
        end)
        stride = stride // 2
    end
end

function gpu.Phases.inclusiveScan(
    borrows self: gpu.Phases,
    exclusive valuesInput: api.Shared<uint32>,
    exclusive temporaryInput: api.Shared<uint32>
): nil
    local values = valuesInput as gpu.Shared<uint32>
    local temporary = temporaryInput as gpu.Shared<uint32>
    if values.count ~= self._size
        or temporary.count ~= self._size
        or self._size < 1
        or self._size & (self._size - 1) ~= 0
    then
        error("nupp: fixed scan needs two power-of-two arrays with one value per lane", 2)
    end
    local offset: integer = 1
    local valuesAreSource = true
    while offset < self._size do
        local distance: integer = offset
        if valuesAreSource then
            self:run(function(localIndex: uint32)
                local lane = localIndex as integer
                local value = values[lane]
                if lane >= distance then
                    value = nupp.math.u32.add(
                        nupp.math.u32.wrap(value as integer),
                        nupp.math.u32.wrap(values[lane - distance] as integer)
                    )
                end
                temporary[lane] = value
            end)
        else
            self:run(function(localIndex: uint32)
                local lane = localIndex as integer
                local value = temporary[lane]
                if lane >= distance then
                    value = nupp.math.u32.add(
                        nupp.math.u32.wrap(value as integer),
                        nupp.math.u32.wrap(temporary[lane - distance] as integer)
                    )
                end
                values[lane] = value
            end)
        end
        valuesAreSource = not valuesAreSource
        offset = offset * 2
    end
    if not valuesAreSource then
        self:run(function(localIndex: uint32)
            local lane = localIndex as integer
            values[lane] = temporary[lane]
        end)
    end
end

--- Executes uniformly ordered workgroup phases on the CPU.
---
--- A GPU AOT body recognizes this call and its immediate callbacks as
--- structure: the controller does not escape, each `run` is a device barrier,
--- and each stage invocation becomes one local lane. It runs `groups`
--- groups, 0 through `groups - 1`, and the device runs the same ones: the
--- kernel's required `u32.div(#span, size)` never visits a partial group.
--- @export
--- @raises string when size is outside the portable workgroup limit
function gpu.workgroups(groups: uint32, size: uint32, scoped controller: function(uint32, gpu.Phases): nil): nil
    local groupCount = groups as integer
    local groupSize = size as integer
    if groupSize < 1 or groupSize > gpu.PORTABLE_WORKGROUP_THREADS then
        error("nupp: GPU workgroup size exceeds the portable limit", 2)
    end
    local phases = new types.Phases(_size = groupSize)
    for groupIndex = 0, groupCount - 1 do
        controller(nupp.math.u32.wrap(groupIndex), phases)
    end
end

--- The C type a buffer element names: the scalar an array witness stands for,
--- or a struct declaration, which is its own C type.
function gpu.elementType(element: any): any
    local kind = SCALAR_KINDS[element]
    if kind ~= nil then
        return require("nupp.runtime.storage").scalar(kind)
    end

    return element
end

function gpu.Buffer.dimensions<T>(borrows self: gpu.Buffer<T>): {integer}
    liveBuffer(self._state)
    return copied(self._shape)
end

function gpu.Buffer.strides<T>(borrows self: gpu.Buffer<T>): {integer}
    liveBuffer(self._state)
    return copied(self._strides)
end

--- Refuses an allocation bound for reading and for writing in the same binding.
---
--- WebGPU and wgpu track buffer usage per allocation rather than per range, so a read
--- slot and a write slot naming views of one root conflict however far apart the
--- views are, and the device drops the dispatch instead of running it. Refused where
--- it is bound, the same way by every provider.
---
--- @param bound the allocation states already bound on the other side of the binding
--- @param state the allocation state of the buffer being bound
--- @raises string where the buffer's allocation is already bound on the other side
function gpu.refuseReadWriteAlias(bound: {any}, state: any): nil
    for _, other in pairs(bound) do
        if rawequal(other, state) then
            error("nupp: a GPU buffer cannot be bound for both reading and writing in one dispatch", 3)
        end
    end
end

function gpu.Buffer.isDense<T>(borrows buffer: gpu.Buffer<T>): boolean
    liveBuffer(buffer._state)
    local _, _, dense = layoutFacts(buffer._shape, buffer._strides, 2)
    return dense
end

function gpu.Buffer.isInjective<T>(borrows buffer: gpu.Buffer<T>): boolean
    liveBuffer(buffer._state)
    local _, _, _, injective = layoutFacts(buffer._shape, buffer._strides, 2)
    return injective
end

function gpu.Buffer.layout<T>(borrows buffer: gpu.Buffer<T>): TensorLayout
    liveBuffer(buffer._state)
    return tensorlayout.new(buffer._shape, buffer._strides, buffer._offset)
end

function gpu.Buffer.view<T>(borrows buffer: gpu.Buffer<T>, layout: TensorLayout): affine(gpu.Buffer<T>) borrows (buffer)
    liveBuffer(buffer._state)
    local offset = layout:offset()
    local extent = layout:extent()
    if offset > buffer._capacity or extent > buffer._capacity - offset then
        error("nupp: GPU tensor view exceeds its allocation", 2)
    end

    return new types.Buffer<T>(
        _elementType = nil,
        _anchor = buffer,
        _context = buffer._context,
        _handle = buffer._handle,
        _width = buffer._width,
        _offset = offset,
        _capacity = buffer._capacity,
        _root = false,
        _state = buffer._state,
        _shape = layout:dimensions(),
        _strides = layout:strides(),
        count = layout.count
    )
end

function gpu.Buffer.subview<T>(
    borrows self: gpu.Buffer<T>,
    origin: {integer},
    shape: {integer}
): affine(gpu.Buffer<T>) borrows (self)
    liveBuffer(self._state)
    if #origin ~= #self._shape or #shape ~= #self._shape then
        error("nupp: GPU tensor subview rank does not match its buffer", 2)
    end
    local count, extent = layoutFacts(shape, self._strides, 2)
    local offset = self._offset
    for index = #shape, 1, -1 do
        local first = origin[index]
        local dimension = shape[index]
        if type(first) ~= "number"
            or first % 1 ~= 0
            or first < 0
            or first > self._shape[index]
            or dimension > self._shape[index] - first
        then
            error("nupp: GPU tensor subview is outside its buffer", 2)
        end
        offset = offset + first * self._strides[index]
    end
    if offset > self._capacity or extent > self._capacity - offset then
        error("nupp: GPU tensor subview exceeds its allocation", 2)
    end

    return new types.Buffer<T>(
        _elementType = nil,
        _anchor = self,
        _context = self._context,
        _handle = self._handle,
        _width = self._width,
        _offset = offset,
        _capacity = self._capacity,
        _root = false,
        _state = self._state,
        _shape = copied(shape),
        _strides = copied(self._strides),
        count = count
    )
end

export = gpu
