@!internal
module nupp.gpu.types

local {type Layout as TensorLayout} = require("nupp.gpu.layout")
local api = require("nupp.gpu.api")
local {type Span} = require("nupp.mem.span")
local gpu = {}

--- The provider's release of a root allocation or a compiled kernel's
--- handle. Each context carries its own, and none of them suspends.
local type Release = @nosuspend function(context: any, resource: any): nil

--- A checked logical tensor layout independent of its element and allocation.
--- @export
type gpu.Layout = TensorLayout

--- The portable floor reserved for a generated workgroup. Backends may
--- support more, but generated kernels deliberately do not depend on it.
--- @export
const gpu.PORTABLE_WORKGROUP_THREADS = 256

--- The portable workgroup-scratch floor in bytes. Generated kernels are
--- refused at compile time when their statically sized scratch exceeds it.
--- @export
const gpu.PORTABLE_SCRATCH_BYTES = 16384

--- A typed resident device range. A root buffer owns an allocation; a
--- subview shares it with a checked element offset. Storage is not
--- CPU-addressable, so upload and download explicitly cross that boundary.
--- @export
record gpu.Buffer<T> is api.Buffer<T>
    _elementType: Span<T>?
    @readonly _anchor: any
    @readonly _context: any
    @readonly _handle: any
    @readonly _width: integer
    @readonly _offset: integer
    @readonly _capacity: integer
    @readonly _state: {released: boolean}
    @readonly _root: boolean
    _shape: {integer}
    _strides: {integer}

    --- Number of logical elements in this buffer or view.
    @readonly count: integer

    --- Releases a root buffer's allocation through its context, or ends a
    --- view, without suspending. A buffer whose context already closed has
    --- nothing left to release.
    function close(takes self): nil
        local buffer = @unsafe nupp.release(self)
        if not buffer._root or buffer._state.released then
            return
        end
        buffer._state.released = true
        local context = buffer._context
        local release = context._releaseBuffer as Release
        release(context, buffer)
    end

    --- Logical tensor dimensions. The returned table is a copy.
    dimensions: function(borrows self: gpu.Buffer<T>): {integer}

    --- Physical element strides. The returned table is a copy.
    strides: function(borrows self: gpu.Buffer<T>): {integer}

    layout: function(borrows self: gpu.Buffer<T>): TensorLayout

    --- Reports whether this buffer or view occupies a dense element range.
    isDense: function(borrows self: gpu.Buffer<T>): boolean

    --- Reports whether every logical element maps to a distinct storage element.
    isInjective: function(borrows self: gpu.Buffer<T>): boolean

    view: function(borrows self: gpu.Buffer<T>, layout: TensorLayout): affine(gpu.Buffer<T>) borrows (self)

    --- Creates an allocation-free checked subview.
    subview: function(
        borrows self: gpu.Buffer<T>,
        origin: {integer},
        shape: {integer}
    ): affine(gpu.Buffer<T>) borrows (self)
end

--- A compiled compute entry owned by its context.
--- @internal
record gpu.Kernel is api.Kernel
    @readonly _anchor: any
    @readonly _handle: any
    @readonly _uniformBytes: integer
    @readonly _readonlyBuffers: integer
    @readonly _writableBuffers: integer
    @readonly _threads: integer
    _released: boolean

    --- Releases the compiled kernel through its context without suspending.
    --- Bindings that name it refuse to dispatch afterwards.
    function close(borrows self): nil
        if self._released then
            return
        end
        self._released = true
        local context = self._anchor
        local release = context._releaseKernel as Release
        release(context, self._handle)
    end
end

--- The canonical shader artifact emitted for a verified GPU kernel.
--- @internal
type gpu.ArtifactSet = api.ArtifactSet

gpu.ArtifactSet = api.ArtifactSet

--- Statically sized, zero-based storage shared by a CPU workgroup.
---
--- GPU AOT replaces this ordinary representation with workgroup address-space
--- storage. Keeping its indexing zero-based makes the interpreted CPU body and
--- the shader body use exactly the same authored indices.
--- @export
record gpu.Shared<T> is api.Shared<T>
    _values: {T}
    @readonly count: integer

    metamethod __len: function(borrows self: gpu.Shared<T>): integer
    metamethod __index: function(borrows self: gpu.Shared<T>, index: integer): T
    metamethod __newindex: function(exclusive self: gpu.Shared<T>, index: integer, value: T): nil
end

--- The ordered stages and scratch belonging to one workgroup.
--- @export
record gpu.Phases is api.Phases
    @readonly _size: integer

    --- Allocates fresh zero-based scratch for this workgroup.
    scratch: function<T>(borrows self: gpu.Phases, initial: T, count: integer): gpu.Shared<T>

    --- Runs a stage to completion in ascending local-index order.
    run: function(borrows self: gpu.Phases, scoped stage: function(uint32): nil): nil

    --- Reduces one power-of-two f32 workgroup in a fixed left-before-right
    --- tree. The sum is left in element zero.
    reduceSum: function(borrows self: gpu.Phases, exclusive values: api.Shared<float>): nil

    --- Computes a deterministic inclusive u32 prefix sum. `temporary` is a
    --- same-sized scratch array used for disjoint ping-pong stages; the result
    --- is left in `values`.
    inclusiveScan: function(
        borrows self: gpu.Phases,
        exclusive values: api.Shared<uint32>,
        exclusive temporary: api.Shared<uint32>
    ): nil
end

function gpu.markClosed(state: any): nil
    state._closed = true
end

export = gpu
