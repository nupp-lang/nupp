@!internal
module nupp.gpu.layout

local function copied(values: {integer}): {integer}
    local out: {integer} = {}
    for index, value in ipairs(values) do
        out[index] = value
    end

    return out
end

local facts = require("nupp.gpu.layoutfacts").layoutFacts

export record Layout
    --- Validates a layout and copies its shape and strides.
    --- @raises string when shape, strides, or offset do not describe a valid layout
    constructor(self, shape: {integer}, strides: {integer}, offset: integer?)
        offset = offset ?? 0
        if type(offset) ~= "number" or math.tointeger(offset) == nil or offset < 0 or offset > 4294967295 then
            error("nupp: GPU tensor layout offset exceeds uint32", 2)
        end
        local count, extent, dense, injective = facts(shape, strides, 2)
        self._offset = offset
        self._shape = copied(shape)
        self._strides = copied(strides)
        self._extent = extent
        self._dense = dense
        self._injective = injective
        self.count = count
    end

    @private @readonly _offset: integer
    @private _shape: {integer}
    @private _strides: {integer}
    @private @readonly _extent: integer
    @private @readonly _dense: boolean
    @private @readonly _injective: boolean

    @readonly count: integer

    --- The element offset of the layout's first element.
    function offset(borrows self): integer
        return self._offset
    end

    --- One more than the largest element offset the layout reaches, measured
    --- from its first element.
    function extent(borrows self): integer
        return self._extent
    end

    --- The logical shape. The returned table is a copy.
    function dimensions(borrows self): {integer}
        return copied(self._shape)
    end

    --- The element stride of each dimension. The returned table is a copy.
    function strides(borrows self): {integer}
        return copied(self._strides)
    end

    --- Reports whether the elements occupy a dense row-major range.
    function isdense(borrows self): boolean
        return self._dense
    end

    --- Reports whether the layout's strides prove that element offsets are distinct.
    ---
    --- A false result also covers layouts for which the bounded stride proof is
    --- inconclusive.
    function isinjective(borrows self): boolean
        return self._injective
    end

    function subview(borrows self, origin: {integer}, shape: {integer}): Layout
        if #origin ~= #self._shape or #shape ~= #self._shape then
            error("nupp: GPU tensor subview rank does not match", 2)
        end
        local offset = self._offset
        for index = #shape, 1, -1 do
            local first = origin[index]
            local dimension = shape[index]
            if type(first) ~= "number"
                or math.tointeger(first) == nil
                or first < 0
                or first > self._shape[index]
                or dimension > self._shape[index] - first
            then
                error("nupp: GPU tensor subview is outside its layout", 2)
            end
            offset = offset + first * self._strides[index]
        end

        return Layout(shape, self._strides, offset)
    end

    function transpose(borrows self, order: {integer}): Layout
        if #order ~= #self._shape then
            error("nupp: GPU tensor transpose rank does not match", 2)
        end
        local shape: {integer} = {}
        local strides: {integer} = {}
        local seen: {boolean} = {}
        for index, axis in ipairs(order) do
            if type(axis) ~= "number" or math.tointeger(axis) == nil or axis < 1 or axis > #order or seen[axis] then
                error("nupp: GPU tensor transpose must name every axis exactly once", 2)
            end
            seen[axis] = true
            shape[index] = self._shape[axis]
            strides[index] = self._strides[axis]
        end

        return Layout(shape, strides, self._offset)
    end

    function broadcast(borrows self, shape: {integer}): Layout
        if #shape < #self._shape or #shape > 4 then
            error("nupp: GPU tensor broadcast rank must contain the source rank", 2)
        end
        local strides: {integer} = {}
        local shift = #shape - #self._shape
        for index, dimension in ipairs(shape) do
            if index <= shift then
                strides[index] = 0
            else
                local source = self._shape[index - shift]
                if source ~= dimension and source ~= 1 then
                    error("nupp: GPU tensor broadcast dimensions are incompatible", 2)
                end
                strides[index] = source == 1 and dimension > 1 and 0 or self._strides[index - shift]
            end
        end
        local result = Layout(shape, strides, self._offset)
        if result._extent > self._extent then
            error("nupp: GPU tensor broadcast exceeds its source", 2)
        end

        return result
    end

    function asstrided(borrows self, shape: {integer}, strides: {integer}, relativeoffset: integer): Layout
        if type(relativeoffset) ~= "number"
            or math.tointeger(relativeoffset) == nil
            or relativeoffset < 0
            or self._offset > 4294967295 - relativeoffset
        then
            error("nupp: GPU strided layout offset exceeds uint32", 2)
        end
        local result = Layout(shape, strides, self._offset + relativeoffset)
        if result._extent > self._extent or relativeoffset > self._extent - result._extent then
            error("nupp: GPU strided layout exceeds its source", 2)
        end

        return result
    end
end
