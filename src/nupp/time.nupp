@!internal

--[[
`coroutine` schedules cooperative waits and wakeups. Deadlines use the
`os.monotonic` clock.

```nupp
const time = coroutine
time.sleep(50)
```
]]
module nupp.time

local provider = require("nupp.runtime.clocks").selected

--- Waits for a finite, non-negative interval through the suspension context.
---
--- @raises string when the interval is invalid or cannot be scheduled
export const sleep: function(milliseconds: number): nil = provider.sleep

--- Waits until a non-negative deadline in the [](os.monotonic) domain.
---
--- A deadline already past returns without waiting.
---
--- @raises string when the deadline is invalid or cannot be scheduled
export const sleepUntil: function(deadline: number): nil = provider.sleepuntil

--- Schedules a callback for a non-negative deadline in the [](os.monotonic) domain.
---
--- Returns a function that when called cancels the scheduled callback.
--- Registration itself does not suspend.
---
--- @raises string when the deadline is invalid or cannot be scheduled
export const wakeAt: function(deadline: number, resume: function(boolean): nil): function(): nil = provider.wakeat
