--[[
The subtyping relation over interned types.

`isA(a, b)` answers whether a value of type `a` may be used where `b` is
expected, as either true, or false plus a reason a person can read. Because
structural types are interned, identity settles reflexivity, and results cache on
identity pairs.

The doctrine is structural for shape and nominal for provenance. It is gradual:
`any` is compatible in both directions.
]]

local T = require("nupp.types")

local relations = {}

--- A type, as nupp.types builds them.
local type Type = T.Type

--- True when nil is a member of `t`: an optional, `any`, `unknown`, or nil itself. A
--- shape field of such a type need not be present at all. `never` admits nothing, nil
--- included: there is no value of that type to leave out.
local function admitsNil(t: Type): boolean
    if t == T.nil_ or t == T.any or t == T.unknown then
        return true
    end
    return t.tag == "union" and t.hasNil or false
end

-- Numeric widening: tag -> set of tags it silently widens to. Sized integers widen to
-- `integer` and `number`; float widens to number. (Real cdata coercion rules land with
-- reification; this is the checking approximation.)
local WIDENS: {[string]: {[string]: boolean}} = {}
local function widen(from: string, toList: {string})
    local into = WIDENS[from] or {}
    WIDENS[from] = into
    for _, to in ipairs(toList) do into[to] = true end
end
widen("integer", {"number"})
widen("float", {"number"})
for _, t in ipairs({"int8", "int16", "int32", "int64",
    "uint8", "uint16", "uint32", "uint64"}) do
    widen(t, {"integer", "number"})
end

local CDATA_NUM: {[string]: boolean} = {
    float = true, int8 = true, int16 = true, int32 = true, int64 = true,
    uint8 = true, uint16 = true, uint32 = true, uint64 = true,
}

local function runtimeCategory(t: Type): string?
    local tag = t.tag
    if tag == "literal" then return runtimeCategory(t.base) end
    if tag == "nil" or tag == "boolean" or tag == "string" then return tag end
    if tag == "number" or tag == "integer" or CDATA_NUM[tag] then return "number" end
    if tag == "array" or tag == "map" or tag == "tuple" or tag == "shape"
        or tag == "table" or tag == "metatable" then return "table" end
    if tag == "func" then return "function" end
    if tag == "thread" or tag == "protocolThread" then return "thread" end
    if tag == "userdata" then return "userdata" end
    if tag == "ptr" or tag == "carray" or tag == "cstring" or tag == "voidptr"
        or tag == "ctype" or tag == "cdata" then return "cdata" end
    return nil
end

local disjoint: function(a: Type, b: Type): string?

--- A finite proof that no value can inhabit both types. No answer means unknown, not
--- overlap: this deliberately does not use gradual compatibility.
disjoint = function(a: Type, b: Type): string?
    if a == T.never or b == T.never then return "one member is never" end
    if a == T.any or b == T.any or a == T.unknown or b == T.unknown
        or a.tag == "typevar" or b.tag == "typevar" then return nil end
    if a == b then return nil end
    if a.tag == "intersection" then
        for _, member in ipairs(a.members) do
            local why = disjoint(member, b)
            if why then return why end
        end
        return nil
    end
    if b.tag == "intersection" then return disjoint(b, a) end
    if a.tag == "union" then
        local witness = nil
        for _, member in ipairs(a.members) do
            local why = disjoint(member, b)
            if not why then return nil end
            witness = witness or why
        end
        return witness
    end
    if b.tag == "union" then return disjoint(b, a) end
    if a.tag == "literal" and b.tag == "literal" then
        if a.base == b.base and a.constant ~= b.constant then
            return "distinct literal values"
        end
        return disjoint(a.base, b.base)
    end
    if a.tag == "literal" then
        local ac, bc = runtimeCategory(a), runtimeCategory(b)
        if ac and bc and ac ~= bc then return "different runtime categories" end
        return nil
    end
    if b.tag == "literal" then return disjoint(b, a) end
    if a.tag == "nominal" and b.tag == "nominal" and a ~= b
        and a.declKind ~= "interface" and b.declKind ~= "interface" then
        return "distinct concrete nominal types"
    end
    local ac, bc = runtimeCategory(a), runtimeCategory(b)
    if ac and bc and ac ~= bc then return "different runtime categories" end
    local ar = (a.tag == "shape" or a.tag == "nominal") and a.byname or nil
    local br = (b.tag == "shape" or b.tag == "nominal") and b.byname or nil
    if ar and br then
        for name, at in pairs(ar) do
            local bt = br[name]
            if bt and not admitsNil(at) and not admitsNil(bt) then
                local why = disjoint(at, bt)
                if why then return ("required field %q has incompatible types"):format(name) end
            end
        end
    end
    return nil
end

relations.disjoint = disjoint

--- Answers already computed, keyed on the identity of both types. Weak keys, so an
--- interned type that goes away takes its answers with it.
local cache: {[Type]: {[Type]: boolean | string}} =
    setmetatable({}, {__mode = "k"})

local isA: function(a: Type, b: Type): (boolean, string?)

--- The plain form of a negative answer, when no detail helps.
local function fail(a: Type, b: Type): boolean, string?
    return false, ("%s is not a %s"):format(T.tostring(a), T.tostring(b))
end

--- Member function conformance ignores each declaration's receiver. The remaining
--- function still observes ordinary parameter/return variance.
local function memberIsA(have: Type, want: Type): boolean
    if have.tag == "func" and want.tag == "func"
        and #have.params >= 1 and #want.params >= 1 then
        local hp, wp = {}, {}
        for j = 2, #have.params do hp[#hp + 1] = have.params[j] end
        for j = 2, #want.params do wp[#wp + 1] = want.params[j] end
        local hm, wm = {}, {}
        for j = 2, #have.params do
            hm[#hm + 1] = have.paramModes and have.paramModes[j] or "plain"
        end
        for j = 2, #want.params do
            wm[#wm + 1] = want.paramModes and want.paramModes[j] or "plain"
        end
        return (isA(T.func(hp, have.rets, have.vararg, hm, nil, nil,
            nil, nil, nil, nil, nil, have.varargType, nil,
            T.pack(hp, have.paramPack.tail, hm), have.retPack,
            have.packParams, have.yieldPack, have.resumePack),
            T.func(wp, want.rets, want.vararg, wm, nil, nil,
            nil, nil, nil, nil, nil, want.varargType, nil,
            T.pack(wp, want.paramPack.tail, wm), want.retPack,
            want.packParams, want.yieldPack, want.resumePack)))
    end
    return (isA(have, want))
end

local function optionalIsA(a: Type?, b: Type?): boolean
    if not a or not b then
        return false
    end
    return (isA(a, b))
end

local function affine(t)
    if not t then
        return false
    end
    if t.tag == "owned" or t.tag == "pinned" then
        return true
    end
    if t.tag == "union" then
        for _, member in ipairs(t.members) do
            if affine(member) then
                return true
            end
        end
    end
    return false
end

--- Covariant compatibility between complete result packs.
function relations.packIsA(have: T.Pack, want: T.Pack): boolean, string?
    if have == want then
        return true
    end
    if have.alternatives then
        for _, arm in ipairs(have.alternatives) do
            local ok, why = relations.packIsA(arm, want)
            if not ok then
                return false, why
            end
        end
        return true
    end
    if want.alternatives then
        for _, arm in ipairs(want.alternatives) do
            if relations.packIsA(have, arm) then
                return true
            end
        end
        return false, ("pack %s fits no alternative of %s")
            :format(T.tostringPack(have), T.tostringPack(want))
    end
    for j, expected in ipairs(want.head) do
        local actual = T.packAt(have, j) or T.nil_
        if not isA(actual, expected) then
            return false, ("pack slot %d: %s is not a %s"):format(j,
                T.tostring(actual), T.tostring(expected))
        end
    end
    if want.tail and want.tail.kind == "homogeneous" then
        for j = #want.head + 1, #have.head do
            if not isA(have.head[j], want.tail.type) then
                return false, ("pack tail slot %d is not a %s"):format(j,
                    T.tostring(want.tail.type))
            end
        end
        if have.tail and have.tail.kind == "homogeneous"
            and not isA(have.tail.type, want.tail.type) then
            return false, "homogeneous pack tails are incompatible"
        end
    elseif want.tail and want.tail.kind == "generic" then
        if not have.tail or have.tail.kind ~= "generic"
            or have.tail.var ~= want.tail.var then
            return false, "generic pack tails are incompatible"
        end
    elseif not want.tail then
        for j = #want.head + 1, #have.head do
            if affine(have.head[j]) then
                return false, "an affine extra result would be truncated"
            end
        end
        if have.tail and (have.tail.kind == "generic" or affine(have.tail.type)) then
            return false, "a potentially affine result tail would be truncated"
        end
    end
    return true
end

local type PropertyType = T.Shape | T.Nominal

local function intersectionSurface(t: T.Intersection): T.Shape
    local byName = {}
    local readKeys, readValues, writeKeys, writeValues = {}, {}, {}, {}
    local function add(member: Type)
        if member.tag == "intersection" then
            for _, nested in ipairs(member.members) do add(nested) end
            return
        end
        if member.tag == "shape" or member.tag == "nominal" then
            for name, read in pairs(member.byname or {}) do
                local entry = byName[name] or {name = name, reads = {}, writes = {}}
                entry.reads[#entry.reads + 1] = read
                byName[name] = entry
            end
            for name, write in pairs(member.writeByname or {}) do
                local entry = byName[name] or {name = name, reads = {}, writes = {}}
                entry.writes[#entry.writes + 1] = write
                byName[name] = entry
            end
            if member.indexReadKey and member.indexReadValue then
                readKeys[#readKeys + 1] = member.indexReadKey
                readValues[#readValues + 1] = member.indexReadValue
            end
            if member.indexWriteKey and member.indexWriteValue then
                writeKeys[#writeKeys + 1] = member.indexWriteKey
                writeValues[#writeValues + 1] = member.indexWriteValue
            end
        end
    end
    add(t)
    local fields = {}
    for _, entry in pairs(byName) do
        fields[#fields + 1] = {name = entry.name,
            read = #entry.reads > 0 and T.intersection(entry.reads) or nil,
            write = #entry.writes > 0 and T.union(entry.writes) or nil}
    end
    return T.shape(fields, {
        readKey = #readKeys > 0 and T.union(readKeys) or nil,
        readValue = #readValues > 0 and T.intersection(readValues) or nil,
        writeKey = #writeKeys > 0 and T.union(writeKeys) or nil,
        writeValue = #writeValues > 0 and T.union(writeValues) or nil,
    }) as T.Shape
end

--- Read capabilities compare covariantly; write capabilities compare contravariantly.
--- Requiring both therefore makes an ordinary property invariant.
local function propertiesFit(a: PropertyType, b: PropertyType): boolean, string?
    local aReads = a.byname or {}
    local aWrites = a.writeByname or {}
    local fresh = a.tag == "shape" and a.fresh == true
    for name, want in pairs(b.byname or {}) do
        local have = aReads[name]
        if not have then
            if admitsNil(want) then
                goto nextRead
            end
            return false, ("%s is not a %s (no readable member %q)")
                :format(T.tostring(a), T.tostring(b), name)
        end
        if not memberIsA(have, want) then
            return false, ("%s is not a %s (read member %q does not match)")
                :format(T.tostring(a), T.tostring(b), name)
        end
        ::nextRead::
    end
    for name, want in pairs(b.writeByname or {}) do
        if fresh then
            goto nextWrite
        end
        local have = aWrites[name]
        if not have then
            return false, ("%s is not a %s (no writable member %q)")
                :format(T.tostring(a), T.tostring(b), name)
        end
        if not memberIsA(want, have) then
            return false, ("%s is not a %s (write member %q does not match)")
                :format(T.tostring(a), T.tostring(b), name)
        end
        ::nextWrite::
    end
    return true
end

local function sameCleanups(a: {string}?, b: {string}?): boolean
    local left: {string} = a or {}
    local right: {string} = b or {}
    if #left ~= #right then
        return false
    end
    for j, name in ipairs(left) do
        if name ~= right[j] then
            return false
        end
    end
    return true
end

--- Decides `isA` for one pair, without consulting the cache.
---
--- The order of the rules is the doctrine: ownership first, then unions, then the
--- numeric and C-boundary conversions, then structure.
local function check(a: Type, b: Type): boolean, string?
    if a == b then
        return true
    end
    local atag, btag = a.tag, b.tag
    if atag == "any" or btag == "any" then
        return true
    end
    -- `never` is uninhabited, so a value of it (there being none) fits anywhere.
    -- `unknown` is the reverse: everything fits into it, but it fits nowhere else on
    -- its own — narrow it or write `as` first. Neither is gradual like `any`: only one
    -- direction is free.
    if atag == "never" then
        return true
    end
    if btag == "unknown" then
        return true
    end
    -- Unsubstituted type parameters behave gradually (call-site instantiation replaces
    -- them before real checking).
    if atag == "typevar" then
        if a.bound then
            return isA(a.bound, b)
        end
        return true
    end
    if btag == "typevar" then
        return true
    end

    -- Ownership is affine metadata over pointer values. Owners and borrows erase to
    -- cdata. Pinned handles deliberately do not: their runtime table must cross C only
    -- through a declared FFI parameter mode.
    if atag == "owned" then
        if btag == "owned" then
            -- An empty expected list is an opaque, transfer-only owner. It may accept a
            -- more specific owner, but cannot manufacture cleanups for an opaque
            -- source.
            if #(b.cleanups or {}) > 0
                and not sameCleanups(a.cleanups, b.cleanups) then
                return fail(a, b)
            end
            return isA(a.inner, b.inner)
        end
        if btag == "borrowed" then
            return isA(a.inner, b.inner)
        end
        return isA(a.inner, b)
    end
    if atag == "borrowed" then
        if btag == "borrowed" then
            return isA(a.inner, b.inner)
        end
        if btag == "owned" then
            return fail(a, b)
        end
        return isA(a.inner, b)
    end
    if atag == "pinned" then
        if btag == "pinned" then
            return isA(a.inner, b.inner)
        end
        return fail(a, b)
    end
    if btag == "owned" or btag == "borrowed" or btag == "pinned" then
        return fail(a, b)
    end

    -- unions: every member of a must fit b; a non-union fits b if it fits any member.
    if atag == "union" then
        for _, m in ipairs(a.members) do
            local ok = isA(m, b)
            if not ok then
                return false, ("%s is not a %s (member %s does not fit)")
                    :format(T.tostring(a), T.tostring(b), T.tostring(m))
            end
        end
        return true
    end
    if btag == "union" then
        for _, m in ipairs(b.members) do
            if isA(a, m) then
                return true
            end
        end
        return fail(a, b)
    end

    -- An expected intersection requires every contract. A source intersection fits
    -- through any member that already proves the target, or through the composed
    -- structural surface when several members jointly provide it.
    if btag == "intersection" then
        for _, m in ipairs(b.members) do
            local ok, why = isA(a, m)
            if not ok then
                return false, ("%s is not a %s (intersection member %s: %s)")
                    :format(T.tostring(a), T.tostring(b), T.tostring(m), why or "")
            end
        end
        return true
    end
    if atag == "intersection" then
        for _, m in ipairs(a.members) do
            if isA(m, b) then return true end
        end
        if btag == "shape" or (btag == "nominal" and b.declKind == "interface") then
            return isA(intersectionSurface(a), b)
        end
        return fail(a, b)
    end

    -- A declared `is` edge is a trusted contract inclusion. Runtime registration may
    -- fill the inherited surface later (as tecs does for component and event type
    -- tables), so it is not re-proved structurally.
    if atag == "nominal" then
        for _, parent in ipairs(a.supertypes or {}) do
            if parent == b or isA(parent, b) then
                return true
            end
        end
    end

    -- numeric widening
    local widensFrom = WIDENS[atag]
    if widensFrom and widensFrom[btag] then
        return true
    end

    -- cdata numeric slots (float, sized ints) accept any numeric value — storing a Lua
    -- number into them converts, as in C. `integer` and `number` remain strict against
    -- each other.
    if CDATA_NUM[btag] and (atag == "number" or atag == "integer"
        or widensFrom) then
        return true
    end

    -- C boundary: nil is a valid NULL for any pointer-shaped parameter, and LuaJIT
    -- implicitly takes a struct's address for T* parameters. `nil` is NULL, and NULL
    -- belongs to a nullable pointer only: keeping it out of T* is the whole reason both
    -- spellings exist.
    if a == T.nil_ and (btag == "ptr" or btag == "voidptr"
        or btag == "cstring") then
        return false, ("nil is not a %s; write %s? for a pointer that may be "
            .. "NULL"):format(T.tostring(b), T.tostring(b))
    end
    if btag == "ptr" and atag == "nominal" and a.declKind == "struct"
        and b.elem == a then
        return true
    end

    -- C boundary: Lua strings convert to "const char *" arguments; any pointer degrades
    -- to void *. Neither converts back implicitly.
    if btag == "cstring" and a == T.string then
        return true
    end
    if btag == "voidptr" and (atag == "ptr" or atag == "cstring"
        or (atag == "nominal" and a.declKind == "struct")) then
        return true
    end

    -- Two applications of the same generic declaration compare by their arguments, so
    -- Box<integer> fits Box<number> exactly as integer fits number. Covariant, like the
    -- array rule above.
    if atag == "nominal" and btag == "nominal" and a.origin
        and a.origin == b.origin then
        if next(a.byname or {}) or next(a.writeByname or {})
            or a.indexReadValue or a.indexWriteValue then
            local ok, why = propertiesFit(a, b)
            if not ok then
                return false, why
            end
            if b.indexReadValue and (not a.indexReadValue
                or not optionalIsA(b.indexReadKey, a.indexReadKey)
                or not optionalIsA(a.indexReadValue, b.indexReadValue)) then
                return fail(a, b)
            end
            if b.indexWriteValue and (not a.indexWriteValue
                or not optionalIsA(b.indexWriteKey, a.indexWriteKey)
                or not optionalIsA(b.indexWriteValue, a.indexWriteValue)) then
                return fail(a, b)
            end
            return true
        end
        local aArgs = a.typeArgs or {}
        local bArgs = b.typeArgs or {}
        for j, at in ipairs(aArgs) do
            local bt = bArgs[j]
            if bt and not isA(at, bt) then
                return false, ("%s is not a %s (argument %d)")
                    :format(T.tostring(a), T.tostring(b), j)
            end
        end
        return true
    end

    -- Const is a promise not to write, so a mutable value satisfies a const one; the
    -- reverse discards the promise and does not.
    if btag == "const" then
        return isA(atag == "const" and a.inner or a, b.inner)
    end
    if atag == "const" then
        return false, ("%s is read-only; %s is not")
            :format(T.tostring(a), T.tostring(b))
    end

    -- every FFI value is a cdata; going the other way needs a cast
    if btag == "cdata" then
        if atag == "ptr" or atag == "carray" or atag == "cstring"
            or atag == "voidptr" or atag == "ctype"
            or (atag == "nominal" and a.declKind == "struct") then
            return true
        end
    end

    -- a string literal is a string; otherwise it behaves exactly as its base type does
    if atag == "literal" then
        if b == (a.base or T.string) then
            return true
        end
        return isA(a.base or T.string, b)
    end

    -- Interfaces conform structurally: a type satisfies one by carrying its members. A
    -- member function's receiver is not compared, since each implementation names
    -- itself there.
    if btag == "nominal" and b.declKind == "interface" and b.byname then
        if (atag == "nominal" or atag == "shape") and a.byname then
            local ok, why = propertiesFit(a, b)
            if not ok then
                return false, why
            end
            if b.indexReadValue then
                if not a.indexReadValue
                    or not optionalIsA(b.indexReadKey, a.indexReadKey)
                    or not optionalIsA(a.indexReadValue, b.indexReadValue) then
                    return false, ("%s is not a %s (read indexer does not match)")
                        :format(T.tostring(a), T.tostring(b))
                end
            end
            if b.indexWriteValue then
                if not a.indexWriteValue
                    or not optionalIsA(b.indexWriteKey, a.indexWriteKey)
                    or not optionalIsA(b.indexWriteValue, a.indexWriteValue) then
                    return false, ("%s is not a %s (write indexer does not match)")
                        :format(T.tostring(a), T.tostring(b))
                end
            end
            for name, want in pairs(b.metamethods or {}) do
                local have = atag == "nominal" and a.metamethods
                    and a.metamethods[name] or nil
                if not have then
                    return false, ("%s is not a %s (metamethod %q does not match)")
                        :format(T.tostring(a), T.tostring(b), name)
                end
                if not isA(have, want) then
                    return false, ("%s is not a %s (metamethod %q does not match)")
                        :format(T.tostring(a), T.tostring(b), name)
                end
            end
            return true
        end
    end

    if btag == "table" then
        -- every table-ish structure fits the plain `table` primitive
        if atag == "array" or atag == "map" or atag == "tuple"
            or atag == "shape"
            or atag == "metatable"
            or atag == "nominal" then
            return true
        end
        return fail(a, b)
    end

    -- `table` is gradual toward table-shaped types: an untyped table literal ({} infers
    -- as `table`) may initialize any table structure.
    if atag == "table" then
        if btag == "array" or btag == "map" or btag == "tuple"
            or btag == "shape"
            or btag == "metatable"
            or btag == "nominal" then
            return true
        end
        return fail(a, b)
    end

    if btag == "metatable" then
        -- Loose about which receiver, since a metatable is an ordinary table and
        -- nothing here proves whose it is. Not loose about a nominal, though: an
        -- instance is a table too, and admitting it would put back the confusion
        -- between a declaration and something it built.
        if atag == "shape" or atag == "map" or atag == "table"
            or atag == "metatable" then
            return true
        end
        return fail(a, b)
    end

    if atag == "array" and btag == "array" then
        local ok = isA(a.elem, b.elem)
        if ok then
            return true
        end
        return fail(a, b)
    end

    if atag == "tuple" and btag == "tuple" then
        if #a.elems ~= #b.elems then
            return fail(a, b)
        end
        for j, e in ipairs(a.elems) do
            if not isA(e, b.elems[j]) then
                return fail(a, b)
            end
        end
        return true
    end

    -- a homogeneous-enough tuple fits an array
    if atag == "tuple" and btag == "array" then
        for _, e in ipairs(a.elems) do
            if not isA(e, b.elem) then
                return fail(a, b)
            end
        end
        return true
    end

    -- A table written with string keys and one value type is a map of it: {float =
    -- true, int8 = true} fits {[string]: boolean}.
    if b.tag == "map" and a.tag == "shape" then
        if b.readable then
            if not isA(T.string, b.key) then
                return fail(a, b)
            end
            if a.indexReadValue then
                if not optionalIsA(b.key, a.indexReadKey)
                    or not optionalIsA(a.indexReadValue, b.value) then
                    return fail(a, b)
                end
            else
                for _, f in ipairs(a.fields) do
                    if f.read and not isA(f.read, b.value) then
                        return false, ("%s is not a %s (field %q: %s is not a %s)")
                            :format(T.tostring(a), T.tostring(b), f.name,
                            T.tostring(f.read), T.tostring(b.value))
                    end
                end
            end
        end
        if b.writeValue and a.indexWriteValue
            and (not optionalIsA(b.writeKey, a.indexWriteKey)
            or not optionalIsA(b.writeValue, a.indexWriteValue)) then
            return fail(a, b)
        elseif b.writeValue and not a.indexWriteValue
            and not optionalIsA(T.string, b.writeKey) then
            return fail(a, b)
        end
        return true
    end

    if atag == "map" and btag == "map" then
        if b.readable and (not a.readable
            or not isA(b.key, a.key)
            or not isA(a.value, b.value)) then
            return fail(a, b)
        end
        if b.writeValue and (not a.writeValue
            or not optionalIsA(b.writeKey, a.writeKey)
            or not optionalIsA(b.writeValue, a.writeValue)) then
            return fail(a, b)
        end
        return true
    end

    -- a record with an array part is a sequence of that element type, so it goes where
    -- {T} is wanted (ipairs, #, and the rest of the array world)
    local arrayPart = a.tag == "nominal" and a.arrayOf or nil
    if b.tag == "array" and arrayPart then
        if isA(arrayPart, b.elem) and isA(b.elem, arrayPart) then
            return true
        end
        return fail(a, b)
    end

    -- width subtyping into shapes: from shapes and from nominal records/
    -- structs/interfaces (nominal-to-structural erosion is allowed; the reverse never
    -- is).
    if btag == "shape" then
        if (atag == "shape" or atag == "nominal") and a.byname then
            local ok, why = propertiesFit(a, b)
            if not ok then
                return false, why
            end
            if b.indexReadValue and (not a.indexReadValue
                or not optionalIsA(b.indexReadKey, a.indexReadKey)
                or not optionalIsA(a.indexReadValue, b.indexReadValue)) then
                return fail(a, b)
            end
            if b.indexWriteValue and (not a.indexWriteValue
                or not optionalIsA(b.indexWriteKey, a.indexWriteKey)
                or not optionalIsA(b.indexWriteValue, a.indexWriteValue)) then
                return fail(a, b)
            end
            return true
        end
        return fail(a, b)
    end

    -- carrays match on their element type; a carray is also a pointer to its first
    -- element, which is how C passes one
    if atag == "carray" and btag == "carray" then
        -- a fixed-length array is usable where any length is accepted
        if a.elem == b.elem and (b.count == nil or a.count == b.count) then
            return true
        end
        return fail(a, b)
    end
    if atag == "carray" and btag == "voidptr" then
        return true
    end
    if atag == "carray" and btag == "ptr" and b.elem == a.elem then
        return true
    end

    if atag == "ptr" and btag == "ptr" then
        -- invariant pointee
        if isA(a.elem, b.elem) and isA(b.elem, a.elem) then
            return true
        end
        return fail(a, b)
    end

    if atag == "func" and btag == "func" then
        -- A generic function value is universally quantified: it can stand where one
        -- concrete instantiation is wanted. Infer that instantiation from the target's
        -- parameter pack, validate ordinary bounds, then compare the resulting
        -- monomorphic callable with the usual variance rules.
        if (#(a.typeParams or {}) > 0 or #(a.packParams or {}) > 0)
            and #(b.typeParams or {}) == 0 and #(b.packParams or {}) == 0 then
            local generic = require("nupp.generics")
            local map = {}
            generic.unifyPack(a.paramPack, b.paramPack, map)
            for j, tv in ipairs(a.typeParams or {}) do
                local bound = a.typeBounds and a.typeBounds[j]
                local actual = map[tv]
                if bound and actual
                    and not isA(actual, generic.subst(bound, map)) then
                    return false, ("type argument %s does not satisfy %s")
                        :format(T.tostring(actual), T.tostring(bound))
                end
            end
            local concrete = generic.instantiateFunction(a, map)
            return isA(concrete, b)
        end
        -- Ignoring arguments is ordinary Lua: a callback that takes the value and not
        -- the key is usable wherever both are passed. Wanting more than will ever be
        -- supplied is not, since the extra ones read as nil.
        if #a.params > #b.params and not b.vararg then
            return false, ("%s is not a %s (parameter count %d vs %d)")
                :format(T.tostring(a), T.tostring(b), #a.params, #b.params)
        end
        -- math.min would widen the count to number, and an index has to stay an integer
        local n = #a.params
        if #b.params < n then
            n = #b.params
        end
        for j = 1, n do
            local am = a.paramModes and a.paramModes[j] or "plain"
            local bm = b.paramModes and b.paramModes[j] or "plain"
            if am ~= bm then
                return false, ("%s is not a %s (parameter %d ownership mode)")
                    :format(T.tostring(a), T.tostring(b), j)
            end
            -- contravariant parameters
            if not isA(b.params[j], a.params[j]) then
                return false, ("%s is not a %s (parameter %d)")
                    :format(T.tostring(a), T.tostring(b), j)
            end
        end
        -- Never returning is a promise, so it may be kept where an ordinary function is
        -- wanted but not the other way round.
        if b.noreturn and not a.noreturn then
            return false, ("%s is not a %s (it can return)")
                :format(T.tostring(a), T.tostring(b))
        end
        -- The extra arguments are a parameter position too, so what a declared element
        -- accepts is compared contravariantly. An untyped `...` on either side accepts
        -- anything and says nothing.
        if a.varargType and b.varargType
            and not isA(b.varargType, a.varargType) then
            return false, ("%s is not a %s (extra arguments)")
                :format(T.tostring(a), T.tostring(b))
        end
        local rn = #a.rets
        if #b.rets < rn then
            rn = #b.rets
        end
        for j = 1, rn do
            -- covariant returns
            if not isA(a.rets[j], b.rets[j]) then
                return false, ("%s is not a %s (return %d)")
                    :format(T.tostring(a), T.tostring(b), j)
            end
        end
        local packsOk, packsWhy = relations.packIsA(a.retPack, b.retPack)
        if not packsOk then
            return false, ("%s is not a %s (%s)"):format(T.tostring(a),
                T.tostring(b), packsWhy)
        end
        if b.yieldPack then
            if not a.yieldPack then
                return false, ("%s is not a %s (missing yield protocol)")
                    :format(T.tostring(a), T.tostring(b))
            end
            local yieldOk = relations.packIsA(a.yieldPack, b.yieldPack)
            local resumeOk = a.resumePack and b.resumePack
                and relations.packIsA(b.resumePack, a.resumePack)
            if not yieldOk or not resumeOk then
                return false, ("%s is not a %s (coroutine protocol)")
                    :format(T.tostring(a), T.tostring(b))
            end
        end
        return true
    end

    if atag == "protocolThread" and btag == "thread" then
        return true
    end
    if atag == "protocolThread" and btag == "protocolThread" then
        return fail(a, b)
    end

    -- nominal vs nominal: identity only (interface conformance lands later)
    return fail(a, b)
end

--- May a value of type `a` be used where `b` is expected? Returns true, or false and a
--- reason a diagnostic can print.
---
--- Because structural types are interned, identity settles reflexivity and the answer
--- caches on the identity pair.
---
--- @param a the type a value has
--- @param b the type the position wants
isA = function(a: Type, b: Type): boolean, string?
    local perA = cache[a] or {}
    cache[a] = perA
    local hit = perA[b]
    if hit ~= nil then
        if hit == true then
            return true
        end
        return false, tostring(hit)
    end
    local ok, why = check(a, b)
    perA[b] = ok or why or false
    return ok, why
end

relations.isA = isA

return relations
