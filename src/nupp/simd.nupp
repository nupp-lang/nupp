module nupp.simd

--[[
Explicit SIMD, for an algorithm whose register is itself a data structure.

Nothing here names a width. A species is whatever the artifact tier chose --
sixteen bytes on the x86-64 baseline and on NEON, thirty-two on AVX2 -- and
`species.lanes` is what you loop by.

```nupp
local span = nupp.mem.span
local simd = nupp.simd

@aot(vectorize = false)
local function countQuotes(borrows source: span.Span<uint8>): uint32
    local species = simd.preferredU8()
    local cursor: integer = 0
    local found: uint32 = 0

    while cursor < #source do
        local bytes = species:load(source, cursor)
        local tail = species:tail(#source - cursor)
        local matches = bytes:equal(34)

        found = nupp.math.u32.add(found, matches:andBits(tail):count())
        cursor = cursor + species.lanes
    end

    return found
end
```

Loads are span-checked, inactive tail lanes read as zero, and `bits()` maps the
first logical lane to bit zero. A vector and a mask have no boxed Lua
representation, so neither can leave the kernel and calling `preferredU8` under
`aot = "off"` is a named checking error. Importing the module without
constructing a species is ordinary Lua.

Reach for this only where a scalar loop cannot say what you mean -- shuffles,
transposes, prefix scans, fixed-tree reductions, gathers, compress and expand.
A loop that merely wants to be vectorized should be `@simd` instead and let the
compiler do it. `simd.reducer` carries one contribution per logical iteration of
such a loop back into scalar code, and `simd.horizontal` reduces a vector to one
value.

See
[vectorization.md](docs/learn/performance/ahead-of-time/vectorization.md) for
the whole of it.
]]

const {type Span, type WriteSpan} = require("nupp.mem.span")

-- Packed operations use the target's AOT instructions inside compiled entries.
-- Ordinary calls use the scalar implementation.

local simd = {}
local provider = require("nupp.runtime.provider.scalarsimd")

--- Closed reduction values used to carry one contribution from each logical
--- iteration of an `@simd` loop back into scalar code.
--- @export
local reducer = {}

--- A floating-point sum committed in logical iteration order.
--- @export
record reducer.OrderedSum
    total: number

    function add(self, value: number): nil
        self.total = self.total + value
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point sum using the width-independent adjacent-pair tree.
--- @export
record reducer.PairwiseSum
    partials: {number?}
    count: integer

    function add(self, value: number): nil
        local carry = value
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = (self.partials[level] as number) + carry
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): number
        local result: number? = nil
        local level: integer = #self.partials
        while level >= 1 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = (result as number) + partial
                end
            end
            level = level - 1
        end

        return result as number
    end
end

--- A floating-point sum whose named contract permits reassociation.
---
--- Ordinary Lua has no lane width to exploit, so its executable reference uses
--- a left fold. Native lowering may use several accumulators.
--- @export
record reducer.AlgebraicSum
    total: number

    function add(self, value: number): nil
        self.total = self.total + value
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point sum carrying the rounding error each addition discards.
---
--- Ordered, pairwise and algebraic sums differ in how they associate, and each
--- discards the low bits of every addition it makes. This one keeps them:
--- the part that did not fit rides alongside the running total and is added
--- back at the end, which recovers the totals an ordered sum loses entirely --
--- `1 + 1e100 + 1 - 1e100` answers two here and zero there.
---
--- Compensating is not the same as exact. The answer is enormously closer to
--- the correctly rounded total than the other three, and like them it still
--- depends on the order the contributions arrived in, which is why its
--- contribution edges stay serial rather than being reassociated.
---
--- Neumaier's form rather than Kahan's: it compensates the larger operand as
--- well as the smaller, so a large value added to a small running total does
--- not lose its correction, which is the case plain Kahan gets wrong.
--- @export
record reducer.CompensatedSum
    total: number
    compensation: number

    function add(self, value: number): nil
        local sum = self.total + value
        if math.abs(self.total) >= math.abs(value) then
            self.compensation = self.compensation + ((self.total - sum) + value)
        else
            self.compensation = self.compensation + ((value - sum) + self.total)
        end
        self.total = sum
    end

    function value(self): number
        return self.total + self.compensation
    end
end

--- A floating-point product committed in logical iteration order.
--- @export
record reducer.OrderedProduct
    total: number

    function multiply(self, value: number): nil
        self.total = self.total * value
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point product using the width-independent adjacent-pair tree.
--- @export
record reducer.PairwiseProduct
    partials: {number?}
    count: integer

    function multiply(self, value: number): nil
        local carry = value
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = (self.partials[level] as number) * carry
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): number
        local result: number? = nil
        local level: integer = #self.partials
        while level >= 1 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = (result as number) * partial
                end
            end
            level = level - 1
        end

        return result as number
    end
end

--- A floating-point product whose named contract permits reassociation.
--- @export
record reducer.AlgebraicProduct
    total: number

    function multiply(self, value: number): nil
        self.total = self.total * value
    end

    function value(self): number
        return self.total
    end
end

--- A dot product committed in logical iteration order without contraction.
--- @export
record reducer.OrderedDot
    total: number

    function add(self, left: number, right: number): nil
        self.total = self.total + left * right
    end

    function value(self): number
        return self.total
    end
end

--- A non-contracting dot product using the adjacent-pair sum tree.
--- @export
record reducer.PairwiseDot
    sum: reducer.PairwiseSum

    function add(self, left: number, right: number): nil
        self.sum:add(left * right)
    end

    function value(self): number
        return self.sum:value()
    end
end

--- A dot product permitting reassociation and multiply-add contraction.
--- @export
record reducer.AlgebraicDot
    total: number

    function add(self, left: number, right: number): nil
        self.total = self.total + left * right
    end

    function value(self): number
        return self.total
    end
end

--- Constructs an ordered floating-point sum.
--- @export
function reducer.orderedSum(initial: number): reducer.OrderedSum
    return new reducer.OrderedSum(total = initial)
end

--- Constructs a width-independent pairwise floating-point sum.
--- @export
function reducer.pairwiseSum(initial: number): reducer.PairwiseSum
    local out = new reducer.PairwiseSum(partials = {}, count = 0)
    out:add(initial)

    return out
end

--- Constructs a reassociable floating-point sum.
--- @export
function reducer.algebraicSum(initial: number): reducer.AlgebraicSum
    return new reducer.AlgebraicSum(total = initial)
end

--- Constructs a compensated floating-point sum.
--- @export
function reducer.compensatedSum(initial: number): reducer.CompensatedSum
    return new reducer.CompensatedSum(total = initial, compensation = 0.0)
end

--- Constructs an ordered floating-point product.
--- @export
function reducer.orderedProduct(initial: number): reducer.OrderedProduct
    return new reducer.OrderedProduct(total = initial)
end

--- Constructs a width-independent pairwise floating-point product.
--- @export
function reducer.pairwiseProduct(initial: number): reducer.PairwiseProduct
    local out = new reducer.PairwiseProduct(partials = {}, count = 0)
    out:multiply(initial)

    return out
end

--- Constructs a reassociable floating-point product.
--- @export
function reducer.algebraicProduct(initial: number): reducer.AlgebraicProduct
    return new reducer.AlgebraicProduct(total = initial)
end

--- Constructs an ordered, non-contracting floating-point dot product.
--- @export
function reducer.orderedDot(initial: number): reducer.OrderedDot
    return new reducer.OrderedDot(total = initial)
end

--- Constructs a pairwise, non-contracting floating-point dot product.
--- @export
function reducer.pairwiseDot(initial: number): reducer.PairwiseDot
    return new reducer.PairwiseDot(sum = reducer.pairwiseSum(initial))
end

--- Constructs a reassociable, contractible floating-point dot product.
--- @export
function reducer.algebraicDot(initial: number): reducer.AlgebraicDot
    return new reducer.AlgebraicDot(total = initial)
end

simd.reducer = reducer

--- Target-selected native species identity.
--- @export
sealed interface simd.Preferred
end

--- A target-neutral fixed logical lane count.
--- @export
sealed interface simd.Fixed<const N: integer>
end

--- One predicate bit per lane of `Vector<T, S>`.
--- @export
sealed interface simd.Mask<T, S>
    metamethod __eq: function(left: simd.Mask<T, S>, right: simd.Mask<T, S>): simd.Mask<T, S>
    metamethod __unm: function(value: simd.Mask<T, S>): simd.Mask<T, S>

    select: function(
        borrows self: simd.Mask<T, S>,
        whenTrue: simd.Vector<T, S> | T,
        whenFalse: simd.Vector<T, S> | T
    ): simd.Vector<T, S>
    any: function(borrows self: simd.Mask<T, S>): boolean
    all: function(borrows self: simd.Mask<T, S>): boolean
    count: function(borrows self: simd.Mask<T, S>): uint32

    --- Returns the first set lane, or zero when the mask is empty.
    first: function(borrows self: simd.Mask<T, S>): integer

    bits: function(borrows self: simd.Mask<T, S>): simd.BitMask<T, S>
end

--- An immutable register-as-data value.
--- @export
sealed interface simd.Vector<T, S>
    metamethod __add: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __sub: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __mul: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __div: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __unm: function(value: simd.Vector<T, S>): simd.Vector<T, S>
    metamethod __eq: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>
    metamethod __lt: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>
    metamethod __le: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>

    --- The smaller of each lane pair, and the larger, under the contract the
    --- name selects. There is no unqualified `min`: the two disagree on every
    --- pair containing a NaN, and which one a program wanted is not
    --- recoverable from the call.
    ---
    --- `propagatingMin` answers the canonical NaN whenever either operand is
    --- NaN, which is `nupp.math.f32.min`'s contract and what makes a reduction
    --- built on it independent of which lane the NaN landed in and of how many
    --- lanes the target chose. `-0` is the smaller zero and `+0` the larger, so
    --- an equal pair of zeros answers by sign rather than by position. `-inf`
    --- and `+inf` are ordinary values at the ends of the order.
    propagatingMin: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    propagatingMax: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- `numberMin` answers the operand that is not NaN, and the canonical NaN
    --- only when both are, which is IEEE-754's `minNum`. It is the contract for
    --- a scan looking for the smallest real measurement in data that carries
    --- NaN for a missing one. Zeros and infinities behave as they do above.
    ---
    --- A reduction over it depends on how many lanes were NaN, which is the
    --- price of ignoring them and the reason it is not the default.
    ---
    --- An integer element has no NaN, so the two contracts coincide there and
    --- either spelling answers the same value.
    numberMin: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    numberMax: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- Lane indices are one-based.
    extract: function(borrows self: simd.Vector<T, S>, lane: integer): T

    insert: function(borrows self: simd.Vector<T, S>, lane: integer, value: T): simd.Vector<T, S>

    --- Reverses logical lane order.
    reverse: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>

    --- Rotates logical lanes. Counts are reduced modulo the species width.
    rotateLeft: function(borrows self: simd.Vector<T, S>, count: integer): simd.Vector<T, S>

    rotateRight: function(borrows self: simd.Vector<T, S>, count: integer): simd.Vector<T, S>

    --- Selects one species-width window from `previous .. self`. Offset zero
    --- returns `self`; positive offsets bring trailing lanes of `previous` into
    --- the beginning. The offset is compile-time constant.
    align: function(borrows self: simd.Vector<T, S>, previous: simd.Vector<T, S>, offset: integer): simd.Vector<T, S>

    --- Every lane read from another lane this vector names at run time.
    ---
    --- Lane `i` answers `self:extract(indices:extract(i))`, and zero where that
    --- index is outside `1..lanes`. Zero rather than a refusal because the
    --- native instructions answer zero for an out-of-range byte and a check per
    --- lane would cost more than the lookup.
    ---
    --- This is the table lookup: a table is a vector, so there is no table type
    --- and no constructor taking one entry per argument. A sixteen-entry byte
    --- table is a `Fixed<16>` vector of constants, or a preferred-width one
    --- with those sixteen entries repeated, and looking up in it is this.
    ---
    --- With `other`, the lanes of both are numbered in one run: an index in
    --- `1..lanes` reads `self` and one in `lanes+1..2*lanes` reads `other`.
    --- That is the shape `align` needs and one vector cannot reach, and it is
    --- what makes this one operation rather than a family of them. It is last
    --- and optional on the same terms `load`'s mask is.
    ---
    --- The indices are read as lane numbers, so the element must be an integer
    --- one. A float vector has no lane numbering to offer.
    swizzle: function(
        borrows self: simd.Vector<T, S>,
        indices: simd.Vector<T, S>,
        other: simd.Vector<T, S>?
    ): simd.Vector<T, S>

    --- Packs selected lanes toward lane one and zeroes the remainder.
    compress: function(borrows self: simd.Vector<T, S>, selected: simd.Mask<T, S>): simd.Vector<T, S>

    --- Distributes packed lanes into selected positions and zeroes the rest.
    expand: function(borrows self: simd.Vector<T, S>, selected: simd.Mask<T, S>): simd.Vector<T, S>

    --- Inclusive, logical-lane-order prefix operations.
    prefixSumOrdered: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>

    prefixXor: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>
end

--- Opaque lane bits for one mask species. Bit zero denotes lane one.
--- @export
sealed interface simd.BitMask<T, S>
    metamethod __eq: function(left: simd.BitMask<T, S>, right: simd.BitMask<T, S>): boolean

    any: function(borrows self: simd.BitMask<T, S>): boolean
    all: function(borrows self: simd.BitMask<T, S>): boolean
    count: function(borrows self: simd.BitMask<T, S>): uint32

    --- Returns the first set lane, or zero when the bitmask is empty.
    first: function(borrows self: simd.BitMask<T, S>): integer

    --- Returns this mask with its lowest set lane cleared.
    clearFirst: function(borrows self: simd.BitMask<T, S>): simd.BitMask<T, S>

    --- Inclusive prefix parity, optionally beginning under an existing carry.
    prefixXor: function(borrows self: simd.BitMask<T, S>, carry: boolean): simd.BitMask<T, S>

    --- The low and high halves of the opaque bits. Lanes beyond the species are
    --- always zero; fixed shapes wider than 64 lanes are rejected by `bits()`.
    lowBits: function(borrows self: simd.BitMask<T, S>): uint32

    highBits: function(borrows self: simd.BitMask<T, S>): uint32
end

--- Operations whose lane count is selected from `T` and `S` at AOT lowering.
--- @export
sealed interface simd.Species<T, S>
    readonly lanes: integer
    splat: function(borrows self: simd.Species<T, S>, value: T): simd.Vector<T, S>
    iota: function(borrows self: simd.Species<T, S>, first: T, step: T): simd.Vector<T, S>
    tail: function(borrows self: simd.Species<T, S>, active: integer): simd.Mask<T, S>
    load: function(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        offset: integer,
        active: simd.Mask<T, S>?
    ): simd.Vector<T, S>
    store: function(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        offset: integer,
        value: simd.Vector<T, S>,
        active: simd.Mask<T, S>?
    ): nil
end

--- Selects the preferred native species. `T` is inferred from the expected
--- result type.
--- @raises outside an AOT-compiled function
--- @export
function simd.preferred<T>(): simd.Species<T, simd.Preferred>
    error("simd.preferred is available only inside an AOT-compiled function", 2)
end

--- Selects a fixed logical species. Both parameters are inferred from the
--- expected result type.
--- @raises outside an AOT-compiled function
--- @export
function simd.fixed<T, const N: integer>(): simd.Species<T, simd.Fixed<N>>
    error("simd.fixed is available only inside an AOT-compiled function", 2)
end

--- Named horizontal operations over one explicit register value.
---
--- Ordered operations follow logical lane order. Pairwise operations use the
--- adjacent-pair tree. Algebraic operations permit reassociation; only
--- `algebraicDot` additionally permits multiply-add contraction.
--- @export
local horizontal = {}

--- @raises outside an AOT-compiled function
--- @export
function horizontal.orderedSum<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.orderedSum is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.pairwiseSum<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.pairwiseSum is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.algebraicSum<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.algebraicSum is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.orderedProduct<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.orderedProduct is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.pairwiseProduct<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.pairwiseProduct is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.algebraicProduct<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.algebraicProduct is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.orderedDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    error("simd.horizontal.orderedDot is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.pairwiseDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    error("simd.horizontal.pairwiseDot is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.algebraicDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    error("simd.horizontal.algebraicDot is available only inside an AOT-compiled function", 2)
end

--- The smallest lane, and the largest, under the contract the name selects.
---
--- These take no order where the sums and products above take three: min and
--- max round nothing, so every association of them answers the same value and
--- three names would have named one answer. What they do take is the NaN
--- contract, for the same reason `Vector.propagatingMin` and `Vector.numberMin`
--- are separate names -- and each is the elementwise operation of that name,
--- folded over the lanes.
---
--- `propagatingMin` answers the canonical NaN when any lane is NaN, so its
--- answer does not depend on how many lanes the target chose. `numberMin`
--- answers the smallest lane that is not NaN, and the canonical NaN only when
--- every lane is. `-0` is the smaller zero under both.
--- @raises outside an AOT-compiled function
--- @export
function horizontal.propagatingMin<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.propagatingMin is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.propagatingMax<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.propagatingMax is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.numberMin<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.numberMin is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.numberMax<T, S>(value: simd.Vector<T, S>): T
    error("simd.horizontal.numberMax is available only inside an AOT-compiled function", 2)
end

--- The one-based lane holding the matching reduction's answer.
---
--- The lowest such lane when several tie, which is the logical-index tie rule
--- every lane-selecting operation here uses. `propagatingArgMin` answers the
--- lowest NaN lane when any lane is NaN, because that is the lane whose element
--- is what `propagatingMin` answers; `numberArgMin` skips NaN lanes and answers
--- the lowest only when every lane is NaN. Either way the identity
--- `value:extract(horizontal.<name>ArgMin(value))` holds against the reduction
--- of the same name.
---
--- A lane index rather than a lane and its value, because an AOT expression
--- answers one value and `extract` already spells the pair.
--- @raises outside an AOT-compiled function
--- @export
function horizontal.propagatingArgMin<T, S>(value: simd.Vector<T, S>): integer
    error("simd.horizontal.propagatingArgMin is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.propagatingArgMax<T, S>(value: simd.Vector<T, S>): integer
    error("simd.horizontal.propagatingArgMax is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.numberArgMin<T, S>(value: simd.Vector<T, S>): integer
    error("simd.horizontal.numberArgMin is available only inside an AOT-compiled function", 2)
end

--- @raises outside an AOT-compiled function
--- @export
function horizontal.numberArgMax<T, S>(value: simd.Vector<T, S>): integer
    error("simd.horizontal.numberArgMax is available only inside an AOT-compiled function", 2)
end

simd.horizontal = horizontal

--- One immutable packed value for the preferred target species.
--- @export
sealed interface simd.VectorU8
    equal: function(borrows self: VectorU8, value: uint32): simd.MaskU8
    inRange: function(borrows self: VectorU8, low: uint32, high: uint32): simd.MaskU8
    andBits: function(borrows self: VectorU8, other: VectorU8): simd.VectorU8
    orBits: function(borrows self: VectorU8, other: VectorU8): simd.VectorU8
    xorBits: function(borrows self: VectorU8, other: VectorU8): simd.VectorU8
    notBits: function(borrows self: VectorU8): simd.VectorU8
    shiftRight: function(borrows self: VectorU8, count: uint32): simd.VectorU8
    shiftLeft: function(borrows self: VectorU8, count: uint32): simd.VectorU8

    --- Looks up every lane in one immutable 16-byte table. Indexes outside
    --- 0..15 produce zero, matching the native table instructions.
    lookup16: function(borrows self: VectorU8, table: simd.TableU8x16): simd.VectorU8

    --- Looks up every lane in four immutable 16-byte tables read as one
    --- 64-entry table. Indexes outside 0..63 produce zero.
    ---
    --- Four tables rather than a 64-entry type because that is the shape the
    --- instruction takes: aarch64 spends one `tbl` on it, and it is the lookup
    --- a six-bit alphabet wants. On x86 it is built from the nibble lookup and
    --- a blend, which is what AVX-512 VBMI's `vpermb` exists to replace.
    lookup64: function(
        borrows self: VectorU8,
        low: simd.TableU8x16,
        lowMid: simd.TableU8x16,
        highMid: simd.TableU8x16,
        high: simd.TableU8x16
    ): simd.VectorU8
end

--- One immutable 16-byte lookup table embedded in generated native code.
--- @export
sealed interface simd.TableU8x16
end

--- One predicate bit per logical vector lane.
--- @export
sealed interface simd.MaskU8
    andBits: function(borrows self: MaskU8, other: MaskU8): simd.MaskU8
    orBits: function(borrows self: MaskU8, other: MaskU8): simd.MaskU8
    xorBits: function(borrows self: MaskU8, other: MaskU8): simd.MaskU8
    notBits: function(borrows self: MaskU8): simd.MaskU8
    select: function(borrows self: MaskU8, whenTrue: simd.VectorU8, whenFalse: simd.VectorU8): simd.VectorU8
    any: function(borrows self: MaskU8): boolean
    all: function(borrows self: MaskU8): boolean
    count: function(borrows self: MaskU8): uint32
    bits: function(borrows self: MaskU8): uint32
end

--- A target-independent 64-bit predicate bitmap.
---
--- This is deliberately not a general `uint64`: ordinary Nupp numbers retain
--- their LuaJIT representation and exactness rules. The two uint32 halves let
--- scanners combine register masks, carry prefix state across them, and drain
--- events without boxing cdata.
--- @export
sealed interface simd.MaskBits64
    --- Adds with carry across the word boundary.
    ---
    --- Present because run-parity over a block is stated as an addition: adding
    --- a run's start bit to the run propagates a carry to the first bit past
    --- its end, which is how a scanner tells an odd run of escapes from an even
    --- one without walking the runs. Nothing else here carries between words.
    add: function(borrows self: MaskBits64, other: MaskBits64): simd.MaskBits64

    andBits: function(borrows self: MaskBits64, other: MaskBits64): simd.MaskBits64
    orBits: function(borrows self: MaskBits64, other: MaskBits64): simd.MaskBits64
    xorBits: function(borrows self: MaskBits64, other: MaskBits64): simd.MaskBits64
    notBits: function(borrows self: MaskBits64): simd.MaskBits64
    shiftLeft: function(borrows self: MaskBits64, count: uint32): simd.MaskBits64
    shiftRight: function(borrows self: MaskBits64, count: uint32): simd.MaskBits64
    prefixXor: function(borrows self: MaskBits64, carry: boolean): simd.MaskBits64
    lowBits: function(borrows self: MaskBits64): uint32
    highBits: function(borrows self: MaskBits64): uint32
    any: function(borrows self: MaskBits64): boolean
    count: function(borrows self: MaskBits64): uint32
    firstSet: function(borrows self: MaskBits64): uint32
    clearFirst: function(borrows self: MaskBits64): simd.MaskBits64
end

--- Four adjacent preferred-width registers covering exactly 64 bytes.
---
--- Block comparisons return one target-independent bitmap, so scanners can
--- classify a cache-line-sized unit without publishing intermediate register
--- masks through scalar Nupp values.
--- @export
sealed interface simd.BlockU8x64
    --- Applies one byte mask to every lane in all four registers.
    andByte: function(borrows self: BlockU8x64, value: uint32): simd.BlockU8x64

    andBits: function(borrows self: BlockU8x64, other: BlockU8x64): simd.BlockU8x64
    shiftRight: function(borrows self: BlockU8x64, count: uint32): simd.BlockU8x64

    --- Looks up every lane in the same immutable 16-byte table.
    lookup16: function(borrows self: BlockU8x64, table: simd.TableU8x16): simd.BlockU8x64

    --- Returns one bit for each lane having any bit in `value` set.
    anyBitsSet: function(borrows self: BlockU8x64, value: uint32): simd.MaskBits64

    --- Returns the final preferred-width register for cross-block carry.
    lastVector: function(borrows self: BlockU8x64): simd.VectorU8

    --- Applies the lookup4 UTF-8 validator across the whole block.
    ---
    --- `previous` is the final preferred-width register before this block. The
    --- three tables are the high and low nibble classes for byte one and the
    --- high nibble classes for byte two. Set result bits identify invalid byte
    --- positions in this block.
    utf8Errors: function(
        borrows self: BlockU8x64,
        previous: simd.VectorU8,
        byte1High: simd.TableU8x16,
        byte1Low: simd.TableU8x16,
        byte2High: simd.TableU8x16
    ): simd.MaskBits64

    equal: function(borrows self: BlockU8x64, value: uint32): simd.MaskBits64
    inRange: function(borrows self: BlockU8x64, low: uint32, high: uint32): simd.MaskBits64
    outsideRange: function(borrows self: BlockU8x64, low: uint32, high: uint32): simd.MaskBits64
end

--- The preferred register-sized operation set for one element type.
--- @export
sealed interface simd.SpeciesU8
    readonly lanes: integer

    --- Broadcasts the low byte of `value` to every lane.
    splat: function(borrows self: SpeciesU8, value: uint32): simd.VectorU8

    --- Loads at a zero-based offset. Inactive final lanes are zero and are
    --- excluded by `tail`; the implementation never reads beyond the span.
    load: function(borrows self: SpeciesU8, borrows source: Span<uint8>, offset: integer): simd.VectorU8

    --- Loads directly from a string rooted by a Lua-builder AOT entry. This is
    --- the VM-aware counterpart of `load`: storage remains owned and pinned by
    --- Lua for the duration of the native call.
    loadString: function(borrows self: SpeciesU8, source: string, offset: integer): simd.VectorU8

    --- Loads one lane of a three-byte interleaved group from a rooted string.
    ---
    --- `lane` selects which byte of each group is collected: 0 gathers bytes
    --- 0, 3, 6 and so on, 1 gathers 1, 4, 7, and 2 gathers 2, 5, 8. Three
    --- calls at the same offset therefore de-interleave `3 * lanes` bytes into
    --- three registers, which is the shape a codec over three-byte groups
    --- wants and the shape aarch64's `ld3` already produces.
    ---
    --- A group that would read past the string contributes zero, on the same
    --- defensive terms as the other loads here.
    loadStrided3: function(borrows self: SpeciesU8, source: string, offset: uint32, lane: uint32): simd.VectorU8

    --- A mask with the first `active` lanes set, clamped to this species.
    tail: function(borrows self: SpeciesU8, active: integer): simd.MaskU8
end

--- A rooted string split into complete blocks and one zero-padded
--- final block. The view exists only for the duration of its AOT entry.
--- @export
sealed interface simd.PaddedStringU8
    readonly length: uint32
    readonly fullLength: uint32
    readonly tailLength: uint32

    --- Loads a complete block. The offset must be below `fullLength` and
    --- aligned to the preferred species width.
    loadFull: function(borrows self: PaddedStringU8, offset: uint32): simd.VectorU8

    --- Loads the sole incomplete block, already copied and zero padded.
    loadTail: function(borrows self: PaddedStringU8): simd.VectorU8

    --- Loads 64 complete bytes at an aligned offset. An unavailable block is
    --- zero, on the same defensive terms as `loadFull`; scanners normally call
    --- this only after proving `offset + 64 <= length`.
    loadBlock64: function(borrows self: PaddedStringU8, offset: uint32): simd.BlockU8x64
end

--- Selects the artifact tier's preferred packed byte species.
--- @export
local preferredU8: function(): simd.SpeciesU8 = provider.preferredU8

const simd.preferredU8 = preferredU8

--- Combines low and high uint32 words into an 64-bit mask.
--- @export
local maskBits64: function(low: uint32, high: uint32): simd.MaskBits64 = provider.maskBits64

const simd.maskBits64 = maskBits64

--- Embeds one immutable 16-byte lookup table in an AOT entry.
--- @export
local tableU8x16: function(
    b0: uint32,
    b1: uint32,
    b2: uint32,
    b3: uint32,
    b4: uint32,
    b5: uint32,
    b6: uint32,
    b7: uint32,
    b8: uint32,
    b9: uint32,
    b10: uint32,
    b11: uint32,
    b12: uint32,
    b13: uint32,
    b14: uint32,
    b15: uint32
): simd.TableU8x16 = provider.tableU8x16

const simd.tableU8x16 = tableU8x16

--- Writes four registers interleaved into a byte scratch.
---
--- Lane `i` of each register lands at `offset + 4i` through `offset + 4i + 3`,
--- which is the inverse of the three-lane strided load and the shape a codec
--- emitting four-byte groups produces. aarch64 spends one `st4` on it.
---
--- Appends when `offset` is the scratch's current length and overwrites below
--- it, on the same terms as `nupp.codec.valuebuilder.setScratchBytes4`.
--- @raises outside an AOT-compiled function
--- @export
function simd.storeInterleaved4(
    scratch: any,
    offset: uint32,
    first: simd.VectorU8,
    second: simd.VectorU8,
    third: simd.VectorU8,
    fourth: simd.VectorU8
): nil
    error("nupp.simd values exist only inside an @aot function", 2)
end

--- Aligns `previous .. current`, bringing the last `offset` bytes of the
--- previous vector into the beginning of the result. Offsets 1..3 are
--- admitted because they are the cross-block lookback needed by UTF-8 scans.
--- @export
local alignBytes: function(
    previous: simd.VectorU8,
    current: simd.VectorU8,
    offset: uint32
): simd.VectorU8 = provider.alignBytes

const simd.alignBytes = alignBytes

--- Roots a Lua string and prepares its one incomplete preferred-width block.
--- @export
local paddedStringU8: function(source: string): simd.PaddedStringU8 = provider.paddedStringU8

const simd.paddedStringU8 = paddedStringU8

--- Roots either a Lua string or a borrowed string buffer for a padded read.
--- This union exists only at a Lua-builder AOT boundary.
--- @raises outside an AOT-compiled function
function simd.paddedBytesU8(borrows source: any): simd.PaddedStringU8
    error("nupp.simd values exist only inside an @aot function", 2)
end

export = simd
