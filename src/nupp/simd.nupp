module nupp.simd

--[[
Explicit SIMD support.

`simd.species` answers a species for an element: as wide as the running
code's vector registers, and one lane wide where there are none, so a kernel
is written once and `species:over` runs it a chunk at a time, the last chunk
under its tail mask:

```nupp
local array = require("nupp.mem.array")
local span = require("nupp.mem.span")
local simd = require("nupp.simd")

@aot
local function countQuotes(borrows source: span.Span<uint8>): uint32
    local species = simd.species(array.uint8)
    local found: uint32 = 0
    for at, active in species:over(#source) do
        found = found + ((species:load(source, at, active) == 34) & active):count()
    end
    return found
end
```

Loads are span-checked, inactive tail lanes read as zero, and `bits()` maps the
first logical lane to bit zero. A vector and a mask have no boxed Lua
representation in compiled code, where they are registers. In a body running
as ordinary Lua a preferred species is one lane wide, so a vector is a number
and a mask a boolean, and a fixed species `simd.species(array.float, 4)` is
its four lanes, so a vector is a table of four numbers and a mask of four
booleans. `simd.vectors` is the species where there are vector registers and
nil where there are none, for a kernel that keeps a hand-written scalar loop
of its own.

Use explicit vectors when SIMD execution is part of the algorithm: shuffles,
transposes, prefix scans, fixed-tree reductions, gathers, compress, expand, or
any loop that should run in vector lanes. `simd.reducer` accepts scalar contributions
or explicit vector-plus-mask contributions, and `simd.horizontal` reduces a
vector to one value.

See [simd.md](docs/learn/performance/ahead-of-time/simd.md) for the complete
SIMD contract.
]]

const {type Span, type WriteSpan} = require("nupp.mem.span")
const {
    type ReadView as SoaReadView,
    type WriteSpan as SoaWriteSpan,
    type WriteToken as SoaWriteToken
} = require("nupp.mem.soa")
const storageWitnesses = require("nupp.mem.array")
const {type Scalar as StorageWitness} = require("nupp.mem.array")

local simd = {}

----------------------------------------------------------------------------
-- Vectors as ordinary Lua
----------------------------------------------------------------------------

--[[
Where a kernel runs as ordinary Lua there are no vector registers, so a
preferred species is one lane wide: its vector is a plain number already
wrapped to its element and its mask a plain boolean. A fixed species names
the lane count the algorithm needs, and it is that wide here as it is on
every native tier: its vector is a table of N lanes under the marker
metatable below, each lane a value wrapped to the element, carrying its lane
count as `n` and its element's name as `element`; its mask is a table of N
booleans under the other marker, carrying the same two. The lane runtime
further down dispatches on the marker, so the operator and method calls the
generator emits serve both forms, and the preferred form costs what it did.
]]

--- The marker metatables of the N-lane forms. Neither has a metamethod: the
--- checker types every operator on a vector or a mask, and the generator
--- routes it through `simd.lane`, so nothing reaches Lua's own arithmetic.
local LANES_VECTOR: {[string]: any} = {}

local LANES_MASK: {[string]: any} = {}

--- The lane count of a value in an N-lane form, or nil for a scalar, a
--- preferred-species vector or a preferred-species mask.
local function lanesOf(value: any): integer?
    if type(value) ~= "table" then
        return nil
    end
    local mt = getmetatable(value)
    if mt == LANES_VECTOR or mt == LANES_MASK then
        return (value as {[string]: any}).n as integer
    end

    return nil
end

--- Lane `i` of a value: the lane of an N-lane form, or the value itself,
--- which is every lane of a scalar and the one lane of a preferred species.
local function laneAt(value: any, i: integer): any
    if lanesOf(value) ~= nil then
        return (value as {[integer]: any})[i]
    end

    return value
end

--- Whether lane `i` is selected by a mask argument; nil selects every lane.
local function activeAt(active: any, i: integer): boolean
    if active == nil then
        return true
    end

    return laneAt(active, i) == true
end

--- The element an N-lane form carries.
local function elementOf(value: any): string
    return (value as {[string]: any}).element as string
end

--- An N-lane vector of `element` over `lanes`, which it takes over.
local function vectorOf(element: string, n: integer, lanes: {[integer]: any}): any
    local value = lanes as {[any]: any}
    value.n = n
    value.element = element

    return setmetatable(value as any, LANES_VECTOR as any)
end

--- An N-lane mask over `lanes`, carrying the element of the species it
--- belongs to so that a select on it can wrap a scalar operand.
local function maskOf(element: string, n: integer, lanes: {[integer]: any}): any
    local value = lanes as {[any]: any}
    value.n = n
    value.element = element

    return setmetatable(value as any, LANES_MASK as any)
end

--- The lanes of an N-lane form copied into a fresh table.
local function copyLanes(value: any, n: integer): {[integer]: any}
    local lanes: {[integer]: any} = {}
    for i = 1, n do
        lanes[i] = laneAt(value, i)
    end

    return lanes
end

--- What every reducer shares: contributions go in through `add`, and `value`
--- answers the finished reduction as a `T`.
---
--- What `add` takes depends on the family -- one value, two for a dot
--- product, and an optional mask beside a vector -- so this names the member
--- without fixing its parameters. Contribute through the concrete reducer;
--- code that only finishes a reduction can take any `Reducer<T>`.
--- @export
interface simd.Reducer<T>
    --- Contributes to the reduction; the concrete reducer states its parameters.
    @readonly add: function(self: simd.Reducer<T>, value: never, ...: never): nil

    --- Answers the finished reduction.
    @readonly value: function(self: simd.Reducer<T>): T
end

--- `T` itself, written where an argument should not decide what `T` is: an
--- integer reducer's element witness names its type, and an initial literal
--- such as `0` is admitted into that type rather than joined with it.
@comptime
local function Given(T: type): type
    return T
end

--- Closed reduction values for scalar or explicit masked vector contributions.
---
--- One reducer takes scalar contributions and masked vector contributions in
--- any mix, in program order; every masked contribution belongs to one `do`
--- block, which is the reducer's region. A floating-point reducer is
--- constructed either from its initial value alone, which accumulates in
--- `number`, or from an element witness and the initial value --
--- `pairwiseSum(array.float, 0.0)` -- which accumulates in the `float` or
--- `number` the witness names. An integer reducer always names its element
--- with its witness, because an `int32` and a `uint32` are the same Lua
--- number.
--- @export
local reducer: {
    orderedSum: function(initial: number): simd.OrderedSum<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.OrderedSum<T>,
    pairwiseSum: function(initial: number): simd.PairwiseSum<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.PairwiseSum<T>,
    compensatedSum: function(initial: number): simd.CompensatedSum<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.CompensatedSum<T>,
    algebraicSum: function(initial: number): simd.AlgebraicSum<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.AlgebraicSum<T>,
    orderedProduct: function(initial: number): simd.OrderedProduct<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.OrderedProduct<T>,
    pairwiseProduct: function(initial: number): simd.PairwiseProduct<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.PairwiseProduct<T>,
    algebraicProduct: function(initial: number): simd.AlgebraicProduct<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.AlgebraicProduct<T>,
    orderedDot: function(initial: number): simd.OrderedDot<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.OrderedDot<T>,
    pairwiseDot: function(initial: number): simd.PairwiseDot<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.PairwiseDot<T>,
    algebraicDot: function(initial: number): simd.AlgebraicDot<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.AlgebraicDot<T>,
    wrappingSum: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.WrappingSum<T>,
    wrappingProduct: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.WrappingProduct<T>,
    andBits: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.AndBits<T>,
    orBits: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.OrBits<T>,
    xorBits: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.XorBits<T>,
    any: function(): simd.Any,
    all: function(): simd.All,
    count: function(): simd.Count,
    integerMin: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.IntegerMin<T>,
    integerMax: function<T is int32 | uint32 | int64 | uint64>(
        element: StorageWitness<T>,
        initial: Given(T)
    ): simd.IntegerMax<T>,
    integerArgMin: function<T is int32 | uint32 | int64 | uint64>(element: StorageWitness<T>): simd.IntegerArgMin<T>,
    integerArgMax: function<T is int32 | uint32 | int64 | uint64>(element: StorageWitness<T>): simd.IntegerArgMax<T>,
    propagatingMin: function(initial: number): simd.PropagatingMin<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.PropagatingMin<T>,
    propagatingMax: function(initial: number): simd.PropagatingMax<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.PropagatingMax<T>,
    propagatingArgMin: function(): simd.PropagatingArgMin<number>
    & function<T is float | number>(element: StorageWitness<T>): simd.PropagatingArgMin<T>,
    propagatingArgMax: function(): simd.PropagatingArgMax<number>
    & function<T is float | number>(element: StorageWitness<T>): simd.PropagatingArgMax<T>,
    numberMin: function(initial: number): simd.NumberMin<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.NumberMin<T>,
    numberMax: function(initial: number): simd.NumberMax<number>
    & function<T is float | number>(element: StorageWitness<T>, initial: number): simd.NumberMax<T>,
    numberArgMin: function(): simd.NumberArgMin<number>
    & function<T is float | number>(element: StorageWitness<T>): simd.NumberArgMin<T>,
    numberArgMax: function(): simd.NumberArgMax<number>
    & function<T is float | number>(element: StorageWitness<T>): simd.NumberArgMax<T>
} = {} as any

--- The value unchanged: what a `number` reducer rounds with.
local function keep(value: number): number
    return value
end

--- The rounding each floating-point element applies after every operation,
--- keyed by its storage witness: none for `number`, binary32 for `float`.
const ROUNDING: {
    [any]: function(number): number
} = {[storageWitnesses.number] = keep, [storageWitnesses.float] = nupp.math.f32.narrow,}

--- The rounding and the rounded seed a floating-point reducer was constructed
--- with: `(initial)` accumulates in `number`, and `(element, initial)` in the
--- `float` or `number` the witness names.
--- @raises string when the witness names no floating-point element
local function floating(first: any, second: any): (function(number): number, number)
    if second == nil then
        return keep, first as number
    end
    local round = ROUNDING[first]
    if round == nil then
        error("nupp: a floating-point reducer takes the float or number array witness", 3)
    end

    return round as function(number): number, (round as function(number): number)(second as number)
end

--- The rounding a seedless floating-point reducer was constructed with:
--- `()` is a `number` reducer and `(element)` names the element.
--- @raises string when the witness names no floating-point element
local function floatingElement(element: any): function(number): number
    if element == nil then
        return keep
    end
    local round = ROUNDING[element]
    if round == nil then
        error("nupp: a floating-point reducer takes the float or number array witness", 3)
    end

    return round as function(number): number
end

--- A floating-point sum committed in logical iteration order.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.OrderedSum<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        self.total = self.round(self.total + scalar)
    end

    function value(self): T
        return self.total as T
    end
end

--- A floating-point sum using the width-independent adjacent-pair tree.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.PairwiseSum<T is float | number> is simd.Reducer<T>
    @private partials: {number?}
    @private count: integer
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        local carry = scalar
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = self.round((self.partials[level] as number) + carry)
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): T
        local result: number? = nil
        -- The trailing partial is carried into the next larger left subtree.
        -- Folding largest-first would change the adjacent-pair tree whenever
        -- three or more partial levels remain occupied.
        local level: integer = 1
        local remaining = self.count
        while remaining > 0 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = self.round(partial + (result as number))
                end
            end
            level = level + 1
            remaining = (remaining // 2) as integer
        end

        return result as T
    end
end

--- A floating-point sum whose named contract permits reassociation.
---
--- Ordinary Lua has no lane width to exploit, so its executable reference uses
--- a left fold. Native lowering may use several accumulators.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.AlgebraicSum<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        self.total = self.round(self.total + scalar)
    end

    function value(self): T
        return self.total as T
    end
end

--- A floating-point sum carrying the rounding error each addition discards.
---
--- Ordered, pairwise and algebraic sums differ in how they associate, and each
--- discards the low bits of every addition it makes. This one keeps them:
--- the part that did not fit rides alongside the running total and is added
--- back at the end, which recovers the totals an ordered sum loses entirely --
--- `1 + 1e100 + 1 - 1e100` answers two here and zero there.
---
--- Compensating is not the same as exact. The answer is enormously closer to
--- the correctly rounded total than the other three, and like them it still
--- depends on the order the contributions arrived in, which is why its
--- contribution edges stay serial rather than being reassociated.
---
--- Neumaier's form rather than Kahan's: it compensates the larger operand as
--- well as the smaller, so a large value added to a small running total does
--- not lose its correction, which is the case plain Kahan gets wrong.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- A `float` reducer keeps its total and its compensation in binary32.
--- @export
record simd.CompensatedSum<T is float | number> is simd.Reducer<T>
    @private total: number
    @private compensation: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        local round = self.round
        local sum = round(self.total + scalar)
        if math.abs(self.total) >= math.abs(scalar) then
            self.compensation = round(self.compensation + round(round(self.total - sum) + scalar))
        else
            self.compensation = round(self.compensation + round(round(scalar - sum) + self.total))
        end
        self.total = sum
    end

    function value(self): T
        return self.round(self.total + self.compensation) as T
    end
end

--- A floating-point product committed in logical iteration order.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.OrderedProduct<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        self.total = self.round(self.total * scalar)
    end

    function value(self): T
        return self.total as T
    end
end

--- A floating-point product using the width-independent adjacent-pair tree.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.PairwiseProduct<T is float | number> is simd.Reducer<T>
    @private partials: {number?}
    @private count: integer
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        local carry = scalar
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = self.round((self.partials[level] as number) * carry)
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): T
        local result: number? = nil
        -- The trailing partial is carried into the next larger left subtree.
        -- Folding largest-first would change the adjacent-pair tree whenever
        -- three or more partial levels remain occupied.
        local level: integer = 1
        local remaining = self.count
        while remaining > 0 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = self.round(partial * (result as number))
                end
            end
            level = level + 1
            remaining = (remaining // 2) as integer
        end

        return result as T
    end
end

--- A floating-point product whose named contract permits reassociation.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- @export
record simd.AlgebraicProduct<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = self.round(value as number)
        self.total = self.round(self.total * scalar)
    end

    function value(self): T
        return self.total as T
    end
end

--- A dot product committed in logical iteration order without contraction.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- Each product rounds before it is added.
--- @export
record simd.OrderedDot<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, left: T | simd.Vector<T, S>, right: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(left) or lanesOf(right)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(left, i) as any, laneAt(right, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local leftValue, rightValue = self.round(left as number), self.round(right as number)
        self.total = self.round(self.total + self.round(leftValue * rightValue))
    end

    function value(self): T
        return self.total as T
    end
end

--- A non-contracting dot product using the adjacent-pair sum tree.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- Each product rounds before it joins the tree.
--- @export
record simd.PairwiseDot<T is float | number> is simd.Reducer<T>
    @private sum: simd.PairwiseSum<T>
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, left: T | simd.Vector<T, S>, right: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(left) or lanesOf(right)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(left, i) as any, laneAt(right, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local leftValue, rightValue = self.round(left as number), self.round(right as number)
        self.sum:add(self.round(leftValue * rightValue) as T)
    end

    function value(self): T
        return self.sum:value()
    end
end

--- A dot product permitting reassociation and multiply-add contraction.
---
--- `T` is the element it accumulates in: `number` is binary64, and `float`
--- is binary32, each contribution and every operation's result rounded as
--- `nupp.math.f32` rounds them.
--- Ordinary Lua rounds each product before adding it; native lowering may
--- fuse the two.
--- @export
record simd.AlgebraicDot<T is float | number> is simd.Reducer<T>
    @private total: number
    @private round: function(number): number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, left: T | simd.Vector<T, S>, right: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(left) or lanesOf(right)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(left, i) as any, laneAt(right, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local leftValue, rightValue = self.round(left as number), self.round(right as number)
        self.total = self.round(self.total + self.round(leftValue * rightValue))
    end

    function value(self): T
        return self.total as T
    end
end

--- Constructs an ordered floating-point sum.
---
--- `(orderedSum(initial))` accumulates in `number`; `(orderedSum(element, initial))`
--- in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.orderedSum = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.OrderedSum<number>(total = seed, round = round)
end) as any

--- Constructs a width-independent pairwise floating-point sum, the initial
--- value its first leaf.
---
--- `(pairwiseSum(initial))` accumulates in `number`; `(pairwiseSum(element, initial))`
--- in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.pairwiseSum = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    local out = new simd.PairwiseSum<number>(partials = {}, count = 0, round = round)
    out:add(seed as number)

    return out
end) as any

--- Constructs a reassociable floating-point sum.
---
--- `(algebraicSum(initial))` accumulates in `number`; `(algebraicSum(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.algebraicSum = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.AlgebraicSum<number>(total = seed, round = round)
end) as any

--- Constructs a compensated floating-point sum.
---
--- `(compensatedSum(initial))` accumulates in `number`; `(compensatedSum(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.compensatedSum = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.CompensatedSum<number>(total = seed, compensation = 0.0, round = round)
end) as any

--- Constructs an ordered floating-point product.
---
--- `(orderedProduct(initial))` accumulates in `number`; `(orderedProduct(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.orderedProduct = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.OrderedProduct<number>(total = seed, round = round)
end) as any

--- Constructs a width-independent pairwise floating-point product, the
--- initial value its first leaf.
---
--- `(pairwiseProduct(initial))` accumulates in `number`; `(pairwiseProduct(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.pairwiseProduct = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    local out = new simd.PairwiseProduct<number>(partials = {}, count = 0, round = round)
    out:add(seed as number)

    return out
end) as any

--- Constructs a reassociable floating-point product.
---
--- `(algebraicProduct(initial))` accumulates in `number`; `(algebraicProduct(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.algebraicProduct = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.AlgebraicProduct<number>(total = seed, round = round)
end) as any

--- Constructs an ordered, non-contracting floating-point dot product.
---
--- `(orderedDot(initial))` accumulates in `number`; `(orderedDot(element, initial))`
--- in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.orderedDot = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.OrderedDot<number>(total = seed, round = round)
end) as any

--- Constructs a pairwise, non-contracting floating-point dot product.
---
--- `(pairwiseDot(initial))` accumulates in `number`; `(pairwiseDot(element, initial))`
--- in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.pairwiseDot = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    local sum = new simd.PairwiseSum<number>(partials = {}, count = 0, round = round)
    sum:add(seed as number)

    return new simd.PairwiseDot<number>(sum = sum, round = round)
end) as any

--- Constructs a reassociable, contractible floating-point dot product.
---
--- `(algebraicDot(initial))` accumulates in `number`; `(algebraicDot(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.algebraicDot = (function(first: any, second: any): any
    local round, seed = floating(first, second)
    return new simd.AlgebraicDot<number>(total = seed, round = round)
end) as any

--- Fixed-width reducers name their element with its array witness, as a species
--- does. Their initial value participates in the fold. Narrow storage loads contribute
--- to i32 or u32; i64 and u64 never pass through a Lua double.
--- @export
record simd.WrappingSum<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private total: T
    @private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.WrappingProduct<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private total: T
    @private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.AndBits<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private total: T
    @private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.OrBits<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private total: T
    @private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.XorBits<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private total: T
    @private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

local function i64WrappingSum(a: int64, b: int64): int64
    return (a + b) as int64
end

local function i64WrappingProduct(a: int64, b: int64): int64
    return (a * b) as int64
end

local function i64AndBits(a: int64, b: int64): int64
    return (a & b) as int64
end

local function i64OrBits(a: int64, b: int64): int64
    return (a | b) as int64
end

local function i64XorBits(a: int64, b: int64): int64
    return (a ~ b) as int64
end

local function u64WrappingSum(a: uint64, b: uint64): uint64
    return (a + b) as uint64
end

local function u64WrappingProduct(a: uint64, b: uint64): uint64
    return (a * b) as uint64
end

local function u64AndBits(a: uint64, b: uint64): uint64
    return (a & b) as uint64
end

local function u64OrBits(a: uint64, b: uint64): uint64
    return (a | b) as uint64
end

local function u64XorBits(a: uint64, b: uint64): uint64
    return (a ~ b) as uint64
end

--- The exact operations of each integer element, keyed by its storage witness.
---
--- The element's width and signedness decide the operation, and an `int32`
--- and a `uint32` are the same Lua number, so the witness is what names it.
const EXACT: {
    [any]: {[string]: any}
} = {
    [
        storageWitnesses.int32
    ] = {
        sum = nupp.math.i32.add,
        product = nupp.math.i32.mul,
        andBits = nupp.math.i32.andBits,
        orBits = nupp.math.i32.orBits,
        xorBits = nupp.math.i32.xorBits,
    },
    [
        storageWitnesses.uint32
    ] = {
        sum = nupp.math.u32.add,
        product = nupp.math.u32.mul,
        andBits = nupp.math.u32.andBits,
        orBits = nupp.math.u32.orBits,
        xorBits = nupp.math.u32.xorBits,
    },
    [
        storageWitnesses.int64
    ] = {
        sum = i64WrappingSum,
        product = i64WrappingProduct,
        andBits = i64AndBits,
        orBits = i64OrBits,
        xorBits = i64XorBits,
    },
    [
        storageWitnesses.uint64
    ] = {
        sum = u64WrappingSum,
        product = u64WrappingProduct,
        andBits = u64AndBits,
        orBits = u64OrBits,
        xorBits = u64XorBits,
    },
}

--- The operation an exact reducer over `element` folds with.
--- @raises string when the witness names no integer element
local function exact<T>(element: StorageWitness<T>, operation: string): function(T, T): T
    local operations = EXACT[element]
    if operations == nil then
        error("nupp: an integer reducer takes the int32, uint32, int64 or uint64 array witness", 3)
    end

    return operations[operation] as function(T, T): T
end

--- Constructs a wrapping sum over `element`, including the supplied initial value.
--- @export
function reducer.wrappingSum<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.WrappingSum<T>
    return new simd.WrappingSum(total = initial as T, operation = exact(element, "sum")) as simd.WrappingSum<T>
end

--- Constructs a wrapping product over `element`, including the supplied initial value.
--- @export
function reducer.wrappingProduct<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.WrappingProduct<T>
    return new simd.WrappingProduct(
        total = initial as T,
        operation = exact(element, "product")
    ) as simd.WrappingProduct<T>
end

--- Constructs a bitwise and over `element`, including the supplied initial value.
--- @export
function reducer.andBits<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.AndBits<T>
    return new simd.AndBits(total = initial as T, operation = exact(element, "andBits")) as simd.AndBits<T>
end

--- Constructs a bitwise or over `element`, including the supplied initial value.
--- @export
function reducer.orBits<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.OrBits<T>
    return new simd.OrBits(total = initial as T, operation = exact(element, "orBits")) as simd.OrBits<T>
end

--- Constructs a bitwise exclusive or over `element`, including the supplied initial
--- value.
--- @export
function reducer.xorBits<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.XorBits<T>
    return new simd.XorBits(total = initial as T, operation = exact(element, "xorBits")) as simd.XorBits<T>
end

--- Whether any contribution is true; false for an empty loop.
--- @export
record simd.Any is simd.Reducer<boolean>
    @private total: boolean

    --- `active` selects the lanes of a mask that contribute, each lane's truth
    --- in lane order, as one masked contribution per iteration of the `do`
    --- block around it. As ordinary Lua a preferred species is one lane wide,
    --- so both masks are booleans; a fixed species contributes its lanes in
    --- order, each under its own lane of `active`.
    function add<T, S>(self, value: boolean | simd.Mask<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        self.total = self.total or (value as boolean)
    end

    function value(self): boolean
        return self.total
    end
end

--- Constructs an `any` reducer.
--- @export
function reducer.any(): simd.Any
    return new simd.Any(total = false)
end

--- Whether every contribution is true; true for an empty loop.
--- @export
record simd.All is simd.Reducer<boolean>
    @private total: boolean

    --- `active` selects the lanes of a mask that contribute, each lane's truth
    --- in lane order, as one masked contribution per iteration of the `do`
    --- block around it. As ordinary Lua a preferred species is one lane wide,
    --- so both masks are booleans; a fixed species contributes its lanes in
    --- order, each under its own lane of `active`.
    function add<T, S>(self, value: boolean | simd.Mask<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        self.total = self.total and (value as boolean)
    end

    function value(self): boolean
        return self.total
    end
end

--- Constructs an `all` reducer.
--- @export
function reducer.all(): simd.All
    return new simd.All(total = true)
end

--- Counts true contributions exactly, modulo 2^64.
--- @export
record simd.Count is simd.Reducer<uint64>
    @private total: uint64

    --- `active` selects the lanes of a mask that contribute, each lane's truth
    --- in lane order, as one masked contribution per iteration of the `do`
    --- block around it. As ordinary Lua a preferred species is one lane wide,
    --- so both masks are booleans; a fixed species contributes its lanes in
    --- order, each under its own lane of `active`.
    function add<T, S>(self, value: boolean | simd.Mask<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        self.total = self.total + ((value as boolean) and 1ULL or 0ULL)
    end

    function value(self): uint64
        return self.total
    end
end

--- Constructs a count reducer.
--- @export
function reducer.count(): simd.Count
    return new simd.Count(total = 0ULL)
end

local function integerLess(left: any, right: any): boolean
    return left < right
end

--- An integer extremum including its initial value.
--- @export
record simd.IntegerMin<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private best: T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        if integerLess(scalar, self.best) then
            self.best = scalar
        end
    end

    function value(self): T
        return self.best
    end
end

--- Constructs an integer min reducer.
--- @export
function reducer.integerMin<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.IntegerMin<T>
    exact(element, "sum")
    return new simd.IntegerMin(best = initial as T) as simd.IntegerMin<T>
end

--- First one-based logical position of the integer extremum; zero when empty.
--- @export
record simd.IntegerArgMin<T is int32 | uint32 | int64 | uint64> is simd.Reducer<integer>
    @private best: T?
    @private position: integer
    @private count: integer

    --- `active` selects the lanes of a vector that are candidates, in lane
    --- order, as one masked contribution per iteration of the `do` block
    --- around it. Lane `i` of the vector has logical position `base + i`, where
    --- `base` advances by the species' lane count for every vector contribution
    --- and by one for every scalar one, whether or not a lane was active. As
    --- ordinary Lua a preferred species is one lane wide, so the vector is that
    --- lane's value and the mask a boolean; a fixed species contributes its
    --- lanes in order, each taking a position.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        self.count = self.count + 1
        if (active as any) == false then
            return
        end
        local scalar = value as T
        if self.position == 0 or integerLess(scalar, self.best) then
            self.best = scalar
            self.position = self.count
        end
    end

    function value(self): integer
        return self.position
    end
end

--- Constructs an integer argmin reducer.
--- @export
function reducer.integerArgMin<T is int32 | uint32 | int64 | uint64>(element: StorageWitness<T>): simd.IntegerArgMin<T>
    exact(element, "sum")
    return new simd.IntegerArgMin(best = nil as any, position = 0, count = 0) as simd.IntegerArgMin<T>
end

--- An integer extremum including its initial value.
--- @export
record simd.IntegerMax<T is int32 | uint32 | int64 | uint64> is simd.Reducer<T>
    @private best: T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as T
        if integerLess(self.best, scalar) then
            self.best = scalar
        end
    end

    function value(self): T
        return self.best
    end
end

--- Constructs an integer max reducer.
--- @export
function reducer.integerMax<T is int32 | uint32 | int64 | uint64>(
    element: StorageWitness<T>,
    initial: Given(T)
): simd.IntegerMax<T>
    exact(element, "sum")
    return new simd.IntegerMax(best = initial as T) as simd.IntegerMax<T>
end

--- First one-based logical position of the integer extremum; zero when empty.
--- @export
record simd.IntegerArgMax<T is int32 | uint32 | int64 | uint64> is simd.Reducer<integer>
    @private best: T?
    @private position: integer
    @private count: integer

    --- `active` selects the lanes of a vector that are candidates, in lane
    --- order, as one masked contribution per iteration of the `do` block
    --- around it. Lane `i` of the vector has logical position `base + i`, where
    --- `base` advances by the species' lane count for every vector contribution
    --- and by one for every scalar one, whether or not a lane was active. As
    --- ordinary Lua a preferred species is one lane wide, so the vector is that
    --- lane's value and the mask a boolean; a fixed species contributes its
    --- lanes in order, each taking a position.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        self.count = self.count + 1
        if (active as any) == false then
            return
        end
        local scalar = value as T
        if self.position == 0 or integerLess(self.best, scalar) then
            self.best = scalar
            self.position = self.count
        end
    end

    function value(self): integer
        return self.position
    end
end

--- Constructs an integer argmax reducer.
--- @export
function reducer.integerArgMax<T is int32 | uint32 | int64 | uint64>(element: StorageWitness<T>): simd.IntegerArgMax<T>
    exact(element, "sum")
    return new simd.IntegerArgMax(best = nil as any, position = 0, count = 0) as simd.IntegerArgMax<T>
end

--- True when a candidate precedes the current floating extremum.
--- Signed zeros are ordered (-0 below +0), then equal values keep the first
--- logical position. Propagating contracts select the first NaN; number
--- contracts select a NaN only if no number was contributed.
local function extremumWins(candidate: number, best: number, maximum: boolean, propagate: boolean): boolean
    if candidate ~= candidate then
        return propagate and best == best
    elseif best ~= best then
        return not propagate
    elseif candidate == 0 and best == 0 then
        return maximum and 1 / candidate > 1 / best or not maximum and 1 / candidate < 1 / best
    end

    return maximum and candidate > best or not maximum and candidate < best
end

--- Floating extremum including the initial value; NaNs are canonicalized.
--- A NaN wins over every number. Signed zero follows -0 < +0.
---
--- `T` is the element: `number` or `float`. An extremum rounds nothing, so
--- the two differ only in what a vector contribution is a vector of.
--- @export
record simd.PropagatingMin<T is float | number> is simd.Reducer<T>
    @private best: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- As ordinary Lua a preferred species is one lane wide, so the vector is
    --- that lane's value and the mask a boolean; a fixed species contributes
    --- its lanes in order, each under its own lane of the mask.
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        local n = lanesOf(value)
        if n ~= nil then
            for i = 1, n as integer do
                self:add(laneAt(value, i) as any, activeAt(active, i) as any)
            end
            return
        end
        if (active as any) == false then
            return
        end
        local scalar = value as number
        if extremumWins(scalar, self.best, false, true) then
            self.best = scalar
        end
    end

    function value(self): T
        return (self.best ~= self.best and math.abs(0 / 0) or self.best) as T
    end
end

--- Constructs a propagatingMin reducer.
---
--- `(propagatingMin(initial))` accumulates in `number`; `(propagatingMin(element,
--- initial))` in the `float` or `number` the witness names, with the initial value
--- rounded to that element.
--- @export
reducer.propagatingMin = (function(first: any, second: any): any
    local _, seed = floating(first, second)
    return new simd.PropagatingMin<number>(best = seed)
end) as any

