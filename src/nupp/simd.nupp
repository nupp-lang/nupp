reducer.u64 = u64

--- Whether any contribution is true; false for an empty loop.
--- @export
record simd.Any
    private total: boolean

    function add(self, value: boolean): nil
        self.total = self.total or value
    end

    function value(self): boolean
        return self.total
    end
end

--- Constructs a any reducer.
--- @export
function reducer.any(): simd.Any
    return new simd.Any(total = false)
end

--- Whether every contribution is true; true for an empty loop.
--- @export
record simd.All
    private total: boolean

    function add(self, value: boolean): nil
        self.total = self.total and value
    end

    function value(self): boolean
        return self.total
    end
end

--- Constructs a all reducer.
--- @export
function reducer.all(): simd.All
    return new simd.All(total = true)
end

--- Counts true contributions exactly, modulo 2^64.
--- @export
record simd.Count
    private total: uint64

    function add(self, value: boolean): nil
        self.total = self.total + (value and 1ULL or 0ULL)
    end

    function value(self): uint64
        return self.total
    end
end

--- Constructs a count reducer.
--- @export
function reducer.count(): simd.Count
    return new simd.Count(total = 0ULL)
end

local function integerLess(left: any, right: any): boolean
    return left < right
end

--- An integer extremum including its initial value.
--- @export
record simd.IntegerMin<T is int32 | uint32 | int64 | uint64>
    private best: T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        if integerLess(scalar, self.best) then
            self.best = scalar
        end
    end

    function value(self): T
        return self.best
    end
end

--- Constructs an integer min reducer.
--- @export
function reducer.integerMin<T is int32 | uint32 | int64 | uint64>(initial: T): simd.IntegerMin<T>
    return new simd.IntegerMin(best = initial) as simd.IntegerMin<T>
end

--- First one-based logical position of the integer extremum; zero when empty.
--- @export
record simd.IntegerArgMin<T is int32 | uint32 | int64 | uint64>
    private best: T?
    private position: integer
    private count: integer

    function add(self, value: T): nil
        self.count = self.count + 1
        if self.position == 0 or integerLess(value, self.best) then
            self.best = value
            self.position = self.count
        end
    end

    function value(self): integer
        return self.position
    end
end

--- Constructs an integer argmin reducer.
--- @export
function reducer.integerArgMin<T is int32 | uint32 | int64 | uint64>(): simd.IntegerArgMin<T>
    return new simd.IntegerArgMin(best = nil as any, position = 0, count = 0) as simd.IntegerArgMin<T>
end

--- An integer extremum including its initial value.
--- @export
record simd.IntegerMax<T is int32 | uint32 | int64 | uint64>
    private best: T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        if integerLess(self.best, scalar) then
            self.best = scalar
        end
    end

    function value(self): T
        return self.best
    end
end

--- Constructs an integer max reducer.
--- @export
function reducer.integerMax<T is int32 | uint32 | int64 | uint64>(initial: T): simd.IntegerMax<T>
    return new simd.IntegerMax(best = initial) as simd.IntegerMax<T>
end

--- First one-based logical position of the integer extremum; zero when empty.
--- @export
record simd.IntegerArgMax<T is int32 | uint32 | int64 | uint64>
    private best: T?
    private position: integer
    private count: integer

    function add(self, value: T): nil
        self.count = self.count + 1
        if self.position == 0 or integerLess(self.best, value) then
            self.best = value
            self.position = self.count
        end
    end

    function value(self): integer
        return self.position
    end
end

--- Constructs an integer argmax reducer.
--- @export
function reducer.integerArgMax<T is int32 | uint32 | int64 | uint64>(): simd.IntegerArgMax<T>
    return new simd.IntegerArgMax(best = nil as any, position = 0, count = 0) as simd.IntegerArgMax<T>
end

--- True when a candidate precedes the current floating extremum.
--- Signed zeros are ordered (-0 below +0), then equal values keep the first
--- logical position. Propagating contracts select the first NaN; number
--- contracts select a NaN only if no number was contributed.
local function extremumWins(candidate: number, best: number, maximum: boolean, propagate: boolean): boolean
    if candidate ~= candidate then
        return propagate and best == best
    elseif best ~= best then
        return not propagate
    elseif candidate == 0 and best == 0 then
        return maximum and 1 / candidate > 1 / best or not maximum and 1 / candidate < 1 / best
    end

    return maximum and candidate > best or not maximum and candidate < best
end

--- Floating extremum including the initial value; NaNs are canonicalized.
--- A NaN wins over every number. Signed zero follows -0 < +0.
--- @export
record simd.PropagatingMin
    private best: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        if extremumWins(scalar, self.best, false, true) then
            self.best = scalar
        end
    end

    function value(self): number
        return self.best ~= self.best and math.abs(0 / 0) or self.best
    end
end

--- Constructs a propagatingMin reducer.
--- @export
function reducer.propagatingMin(initial: number): simd.PropagatingMin
    return new simd.PropagatingMin(best = initial)
end

--- First logical position, or zero when empty.
--- A NaN wins over every number. Signed zero follows -0 < +0.
--- @export
record simd.PropagatingArgMin
    private best: number
    private position: integer
    private count: integer

    function add(self, value: number): nil
        self.count = self.count + 1
        if self.position == 0 or extremumWins(value, self.best, false, true) then
            self.best = value
            self.position = self.count
        end
    end

    function value(self): integer
        return self.position
    end
end

--- Constructs a propagatingArgMin reducer.
--- @export
function reducer.propagatingArgMin(): simd.PropagatingArgMin
    return new simd.PropagatingArgMin(best = 0.0, position = 0, count = 0)
end

--- Floating extremum including the initial value; NaNs are canonicalized.
