module nupp.simd

--[[
Explicit SIMD support.

A preferred species uses the artifact tier's vector width.
`species.lanes` is what you loop by; a fixed species names its lane count.

```nupp
local array = nupp.mem.array
local span = nupp.mem.span
local simd = nupp.simd

@aot
local function countQuotes(borrows source: span.Span<uint8>): uint32
    local cursor: integer = 0
    local found: uint32 = 0
    if species = simd.species(array.uint8) then
        while cursor < #source do
            local bytes = species:load(source, cursor + 1)
            local tail = species:tail(#source - cursor)
            found = found + ((bytes == 34) & tail):count()
            cursor = cursor + species.lanes
        end
    end
    while cursor < #source do
        if source[cursor + 1] == 34 then
            found = found + 1
        end
        cursor = cursor + 1
    end
    return found
end
```

Loads are span-checked, inactive tail lanes read as zero, and `bits()` maps the
first logical lane to bit zero. A vector and a mask have no boxed Lua
representation, so neither can leave the kernel. `simd.species` answers `nil`
under `aot = "off"`; the scalar continuation above handles that case.

Reach for this only where a scalar loop cannot say what you mean -- shuffles,
transposes, prefix scans, fixed-tree reductions, gathers, compress and expand.
A loop that merely wants to be vectorized should be `@simd` instead and let the
compiler do it. `simd.reducer` carries one contribution per logical iteration of
such a loop back into scalar code, and `simd.horizontal` reduces a vector to one
value.

See
[vectorization.md](docs/learn/performance/ahead-of-time/vectorization.md) for
the whole of it.
]]

const {type Span, type WriteSpan} = require("nupp.mem.span")
const {type Scalar as StorageWitness} = require("nupp.mem.array")

local simd = {}

--- Closed reduction values used to carry one contribution from each logical
--- iteration of an `@simd` loop back into scalar code.
--- @export
local reducer: {
    orderedSum: function(initial: number): reducer.OrderedSum,
    pairwiseSum: function(initial: number): reducer.PairwiseSum,
    compensatedSum: function(initial: number): reducer.CompensatedSum,
    algebraicSum: function(initial: number): reducer.AlgebraicSum,
    orderedProduct: function(initial: number): reducer.OrderedProduct,
    pairwiseProduct: function(initial: number): reducer.PairwiseProduct,
    algebraicProduct: function(initial: number): reducer.AlgebraicProduct,
    orderedDot: function(initial: number): reducer.OrderedDot,
    pairwiseDot: function(initial: number): reducer.PairwiseDot,
    algebraicDot: function(initial: number): reducer.AlgebraicDot,
    i32: {
        wrappingSum: function(initial: int32): simd.WrappingSum<int32>,
        wrappingProduct: function(initial: int32): simd.WrappingProduct<int32>,
        andBits: function(initial: int32): simd.AndBits<int32>,
        orBits: function(initial: int32): simd.OrBits<int32>,
        xorBits: function(initial: int32): simd.XorBits<int32>
    },
    u32: {
        wrappingSum: function(initial: uint32): simd.WrappingSum<uint32>,
        wrappingProduct: function(initial: uint32): simd.WrappingProduct<uint32>,
        andBits: function(initial: uint32): simd.AndBits<uint32>,
        orBits: function(initial: uint32): simd.OrBits<uint32>,
        xorBits: function(initial: uint32): simd.XorBits<uint32>
    },
    i64: {
        wrappingSum: function(initial: int64): simd.WrappingSum<int64>,
        wrappingProduct: function(initial: int64): simd.WrappingProduct<int64>,
        andBits: function(initial: int64): simd.AndBits<int64>,
        orBits: function(initial: int64): simd.OrBits<int64>,
        xorBits: function(initial: int64): simd.XorBits<int64>
    },
    u64: {
        wrappingSum: function(initial: uint64): simd.WrappingSum<uint64>,
        wrappingProduct: function(initial: uint64): simd.WrappingProduct<uint64>,
        andBits: function(initial: uint64): simd.AndBits<uint64>,
        orBits: function(initial: uint64): simd.OrBits<uint64>,
        xorBits: function(initial: uint64): simd.XorBits<uint64>
    },
    any: function(): simd.Any,
    all: function(): simd.All,
    count: function(): simd.Count,
    integerMin: function<T is int32 | uint32 | int64 | uint64>(initial: T): simd.IntegerMin<T>,
    integerMax: function<T is int32 | uint32 | int64 | uint64>(initial: T): simd.IntegerMax<T>,
    integerArgMin: function<T is int32 | uint32 | int64 | uint64>(): simd.IntegerArgMin<T>,
    integerArgMax: function<T is int32 | uint32 | int64 | uint64>(): simd.IntegerArgMax<T>,
    propagatingMin: function(initial: number): simd.PropagatingMin,
    propagatingMax: function(initial: number): simd.PropagatingMax,
    propagatingArgMin: function(): simd.PropagatingArgMin,
    propagatingArgMax: function(): simd.PropagatingArgMax,
    numberMin: function(initial: number): simd.NumberMin,
    numberMax: function(initial: number): simd.NumberMax,
    numberArgMin: function(): simd.NumberArgMin,
    numberArgMax: function(): simd.NumberArgMax
} = {} as any

--- A floating-point sum committed in logical iteration order.
--- @export
record reducer.OrderedSum
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        self.total = self.total + scalar
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point sum using the width-independent adjacent-pair tree.
--- @export
record reducer.PairwiseSum
    partials: {number?}
    count: integer

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        local carry = scalar
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = (self.partials[level] as number) + carry
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): number
        local result: number? = nil
        -- The trailing partial is carried into the next larger left subtree.
        -- Folding largest-first would change the adjacent-pair tree whenever
        -- three or more partial levels remain occupied.
        local level: integer = 1
        local remaining = self.count
        while remaining > 0 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = partial + (result as number)
                end
            end
            level = level + 1
            remaining = (remaining // 2) as integer
        end

        return result as number
    end
end

--- A floating-point sum whose named contract permits reassociation.
---
--- Ordinary Lua has no lane width to exploit, so its executable reference uses
--- a left fold. Native lowering may use several accumulators.
--- @export
record reducer.AlgebraicSum
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        self.total = self.total + scalar
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point sum carrying the rounding error each addition discards.
---
--- Ordered, pairwise and algebraic sums differ in how they associate, and each
--- discards the low bits of every addition it makes. This one keeps them:
--- the part that did not fit rides alongside the running total and is added
--- back at the end, which recovers the totals an ordered sum loses entirely --
--- `1 + 1e100 + 1 - 1e100` answers two here and zero there.
---
--- Compensating is not the same as exact. The answer is enormously closer to
--- the correctly rounded total than the other three, and like them it still
--- depends on the order the contributions arrived in, which is why its
--- contribution edges stay serial rather than being reassociated.
---
--- Neumaier's form rather than Kahan's: it compensates the larger operand as
--- well as the smaller, so a large value added to a small running total does
--- not lose its correction, which is the case plain Kahan gets wrong.
--- @export
record reducer.CompensatedSum
    total: number
    compensation: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        local sum = self.total + scalar
        if math.abs(self.total) >= math.abs(scalar) then
            self.compensation = self.compensation + ((self.total - sum) + scalar)
        else
            self.compensation = self.compensation + ((scalar - sum) + self.total)
        end
        self.total = sum
    end

    function value(self): number
        return self.total + self.compensation
    end
end

--- A floating-point product committed in logical iteration order.
--- @export
record reducer.OrderedProduct
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function multiply<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        self.total = self.total * scalar
    end

    function value(self): number
        return self.total
    end
end

--- A floating-point product using the width-independent adjacent-pair tree.
--- @export
record reducer.PairwiseProduct
    partials: {number?}
    count: integer

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function multiply<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        local carry = scalar
        local occupied = self.count
        local level: integer = 1
        while occupied % 2 == 1 do
            carry = (self.partials[level] as number) * carry
            self.partials[level] = nil
            occupied = (occupied // 2) as integer
            level = level + 1
        end
        self.partials[level] = carry
        self.count = self.count + 1
    end

    function value(self): number
        local result: number? = nil
        -- The trailing partial is carried into the next larger left subtree.
        -- Folding largest-first would change the adjacent-pair tree whenever
        -- three or more partial levels remain occupied.
        local level: integer = 1
        local remaining = self.count
        while remaining > 0 do
            local partial = self.partials[level]
            if partial ~= nil then
                if result == nil then
                    result = partial
                else
                    result = partial * (result as number)
                end
            end
            level = level + 1
            remaining = (remaining // 2) as integer
        end

        return result as number
    end
end

--- A floating-point product whose named contract permits reassociation.
--- @export
record reducer.AlgebraicProduct
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function multiply<S>(self, value: number | simd.Vector<number, S>, active: simd.Mask<number, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as number
        self.total = self.total * scalar
    end

    function value(self): number
        return self.total
    end
end

--- A dot product committed in logical iteration order without contraction.
--- @export
record reducer.OrderedDot
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(
        self,
        left: number | simd.Vector<number, S>,
        right: number | simd.Vector<number, S>,
        active: simd.Mask<number, S>?
    ): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local leftValue, rightValue = left as number, right as number
        self.total = self.total + leftValue * rightValue
    end

    function value(self): number
        return self.total
    end
end

--- A non-contracting dot product using the adjacent-pair sum tree.
--- @export
record reducer.PairwiseDot
    sum: reducer.PairwiseSum

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(
        self,
        left: number | simd.Vector<number, S>,
        right: number | simd.Vector<number, S>,
        active: simd.Mask<number, S>?
    ): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local leftValue, rightValue = left as number, right as number
        self.sum:add(leftValue * rightValue)
    end

    function value(self): number
        return self.sum:value()
    end
end

--- A dot product permitting reassociation and multiply-add contraction.
--- @export
record reducer.AlgebraicDot
    total: number

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(
        self,
        left: number | simd.Vector<number, S>,
        right: number | simd.Vector<number, S>,
        active: simd.Mask<number, S>?
    ): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local leftValue, rightValue = left as number, right as number
        self.total = self.total + leftValue * rightValue
    end

    function value(self): number
        return self.total
    end
end

--- Constructs an ordered floating-point sum.
--- @export
function reducer.orderedSum(initial: number): reducer.OrderedSum
    return new reducer.OrderedSum(total = initial)
end

--- Constructs a width-independent pairwise floating-point sum.
--- @export
function reducer.pairwiseSum(initial: number): reducer.PairwiseSum
    local out = new reducer.PairwiseSum(partials = {}, count = 0)
    out:add(initial)

    return out
end

--- Constructs a reassociable floating-point sum.
--- @export
function reducer.algebraicSum(initial: number): reducer.AlgebraicSum
    return new reducer.AlgebraicSum(total = initial)
end

--- Constructs a compensated floating-point sum.
--- @export
function reducer.compensatedSum(initial: number): reducer.CompensatedSum
    return new reducer.CompensatedSum(total = initial, compensation = 0.0)
end

--- Constructs an ordered floating-point product.
--- @export
function reducer.orderedProduct(initial: number): reducer.OrderedProduct
    return new reducer.OrderedProduct(total = initial)
end

--- Constructs a width-independent pairwise floating-point product.
--- @export
function reducer.pairwiseProduct(initial: number): reducer.PairwiseProduct
    local out = new reducer.PairwiseProduct(partials = {}, count = 0)
    out:multiply(initial)

    return out
end

--- Constructs a reassociable floating-point product.
--- @export
function reducer.algebraicProduct(initial: number): reducer.AlgebraicProduct
    return new reducer.AlgebraicProduct(total = initial)
end

--- Constructs an ordered, non-contracting floating-point dot product.
--- @export
function reducer.orderedDot(initial: number): reducer.OrderedDot
    return new reducer.OrderedDot(total = initial)
end

--- Constructs a pairwise, non-contracting floating-point dot product.
--- @export
function reducer.pairwiseDot(initial: number): reducer.PairwiseDot
    return new reducer.PairwiseDot(sum = reducer.pairwiseSum(initial))
end

--- Constructs a reassociable, contractible floating-point dot product.
--- @export
function reducer.algebraicDot(initial: number): reducer.AlgebraicDot
    return new reducer.AlgebraicDot(total = initial)
end

--- Fixed-width reducers use the same namespaces as explicit scalar arithmetic.
--- Their initial value participates in the fold. Narrow storage loads contribute
--- to i32 or u32; i64 and u64 never pass through a Lua double.
--- @export
record simd.WrappingSum<T is int32 | uint32 | int64 | uint64>
    private total: T
    private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function add<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.WrappingProduct<T is int32 | uint32 | int64 | uint64>
    private total: T
    private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function multiply<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.AndBits<T is int32 | uint32 | int64 | uint64>
    private total: T
    private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function combine<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.OrBits<T is int32 | uint32 | int64 | uint64>
    private total: T
    private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function combine<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- @export
record simd.XorBits<T is int32 | uint32 | int64 | uint64>
    private total: T
    private operation: function(T, T): T

    --- `active` selects the lanes of a vector that contribute, in lane order,
    --- as one masked contribution per iteration of the `do` block around it.
    --- That form runs only in compiled code, where vectors exist.
    --- @raises when given a mask, as ordinary Lua
    function combine<S>(self, value: T | simd.Vector<T, S>, active: simd.Mask<T, S>?): nil
        if active ~= nil then
            error("a masked reducer contribution runs only in compiled code", 2)
        end
        local scalar = value as T
        self.total = self.operation(self.total, scalar)
    end

    function value(self): T
        return self.total
    end
end

--- int32 exact, wrapping reductions.
--- @export
local i32 = {}

--- Constructs a int32 wrappingSum fold, including the supplied initial value.
--- @export
function i32.wrappingSum(initial: int32): simd.WrappingSum<int32>
    return new simd.WrappingSum(total = initial, operation = nupp.math.i32.add)
end

--- Constructs a int32 wrappingProduct fold, including the supplied initial value.
--- @export
function i32.wrappingProduct(initial: int32): simd.WrappingProduct<int32>
    return new simd.WrappingProduct(total = initial, operation = nupp.math.i32.mul)
end

--- Constructs a int32 andBits fold, including the supplied initial value.
--- @export
function i32.andBits(initial: int32): simd.AndBits<int32>
    return new simd.AndBits(total = initial, operation = nupp.math.i32.andBits)
end

--- Constructs a int32 orBits fold, including the supplied initial value.
--- @export
function i32.orBits(initial: int32): simd.OrBits<int32>
    return new simd.OrBits(total = initial, operation = nupp.math.i32.orBits)
end

--- Constructs a int32 xorBits fold, including the supplied initial value.
--- @export
function i32.xorBits(initial: int32): simd.XorBits<int32>
    return new simd.XorBits(total = initial, operation = nupp.math.i32.xorBits)
end

reducer.i32 = i32

--- uint32 exact, wrapping reductions.
--- @export
local u32 = {}

--- Constructs a uint32 wrappingSum fold, including the supplied initial value.
--- @export
function u32.wrappingSum(initial: uint32): simd.WrappingSum<uint32>
    return new simd.WrappingSum(total = initial, operation = nupp.math.u32.add)
end

--- Constructs a uint32 wrappingProduct fold, including the supplied initial value.
--- @export
function u32.wrappingProduct(initial: uint32): simd.WrappingProduct<uint32>
    return new simd.WrappingProduct(total = initial, operation = nupp.math.u32.mul)
end

--- Constructs a uint32 andBits fold, including the supplied initial value.
--- @export
function u32.andBits(initial: uint32): simd.AndBits<uint32>
    return new simd.AndBits(total = initial, operation = nupp.math.u32.andBits)
end

--- Constructs a uint32 orBits fold, including the supplied initial value.
--- @export
function u32.orBits(initial: uint32): simd.OrBits<uint32>
    return new simd.OrBits(total = initial, operation = nupp.math.u32.orBits)
end

--- Constructs a uint32 xorBits fold, including the supplied initial value.
--- @export
function u32.xorBits(initial: uint32): simd.XorBits<uint32>
    return new simd.XorBits(total = initial, operation = nupp.math.u32.xorBits)
end

reducer.u32 = u32

--- int64 exact, wrapping reductions.
--- @export
local i64 = {}

local function i64WrappingSum(a: int64, b: int64): int64
    return (a + b) as int64
end

--- Constructs a int64 wrappingSum fold, including the supplied initial value.
--- @export
function i64.wrappingSum(initial: int64): simd.WrappingSum<int64>
    return new simd.WrappingSum(total = initial, operation = i64WrappingSum)
end

local function i64WrappingProduct(a: int64, b: int64): int64
    return (a * b) as int64
end

--- Constructs a int64 wrappingProduct fold, including the supplied initial value.
--- @export
function i64.wrappingProduct(initial: int64): simd.WrappingProduct<int64>
    return new simd.WrappingProduct(total = initial, operation = i64WrappingProduct)
end

local function i64AndBits(a: int64, b: int64): int64
    return (a & b) as int64
end

--- Constructs a int64 andBits fold, including the supplied initial value.
--- @export
function i64.andBits(initial: int64): simd.AndBits<int64>
    return new simd.AndBits(total = initial, operation = i64AndBits)
end

local function i64OrBits(a: int64, b: int64): int64
    return (a | b) as int64
end

--- Constructs a int64 orBits fold, including the supplied initial value.
--- @export
function i64.orBits(initial: int64): simd.OrBits<int64>
    return new simd.OrBits(total = initial, operation = i64OrBits)
end

local function i64XorBits(a: int64, b: int64): int64
    return (a ~ b) as int64
end

--- Constructs a int64 xorBits fold, including the supplied initial value.
--- @export
function i64.xorBits(initial: int64): simd.XorBits<int64>
    return new simd.XorBits(total = initial, operation = i64XorBits)
end

reducer.i64 = i64

--- uint64 exact, wrapping reductions.
--- @export
local u64 = {}

local function u64WrappingSum(a: uint64, b: uint64): uint64
    return (a + b) as uint64
end

