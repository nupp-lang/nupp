--- Constructs a propagatingArgMin reducer.
---
--- `propagatingArgMin()` takes `number` contributions; `propagatingArgMin(element)`
--- takes the `float` or `number` the witness names.
--- @export
reducer.propagatingArgMin = (function(element: any): any
    floatingElement(element)
    return new simd.PropagatingArgMin<number>(best = 0.0, position = 0, count = 0)
end) as any

