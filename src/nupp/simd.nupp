simd.reducer = reducer

--- Target-selected native species identity.
--- @export
sealed interface simd.Preferred
end

--- A target-neutral fixed logical lane count.
--- @export
sealed interface simd.Fixed<const N: integer>
end

--- One predicate bit per lane of `Vector<T, S>`.
--- @export
sealed interface simd.Mask<T, S>
    metamethod __eq: function(left: simd.Mask<T, S>, right: simd.Mask<T, S>): simd.Mask<T, S>
    metamethod __unm: function(value: simd.Mask<T, S>): simd.Mask<T, S>

    select: function(
        borrows self: simd.Mask<T, S>,
        whenTrue: simd.Vector<T, S> | T,
        whenFalse: simd.Vector<T, S> | T
    ): simd.Vector<T, S>
    any: function(borrows self: simd.Mask<T, S>): boolean
    all: function(borrows self: simd.Mask<T, S>): boolean
    count: function(borrows self: simd.Mask<T, S>): uint32

    --- Returns the first set lane, or zero when the mask is empty.
    first: function(borrows self: simd.Mask<T, S>): uint32

    --- Returns lane bits in a `uint64`; bit zero denotes lane one.
    bits: function(borrows self: simd.Mask<T, S>): uint64
end

--- An immutable register-as-data value.
--- @export
sealed interface simd.Vector<T, S>
    metamethod __add: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __sub: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __mul: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>
    metamethod __div: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- `%` and `//` are Lua's: the remainder takes the divisor's sign and the
    --- quotient rounds toward negative infinity, lane by lane, as `a - floor(a
    --- / b) * b` and `floor(a / b)` on a floating species and exactly on an
    --- integer one. An integer lane divided by zero answers zero, as `/`
    --- does, rather than trapping.
    metamethod __mod: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Vector<T, S>

    metamethod __unm: function(value: simd.Vector<T, S>): simd.Vector<T, S>
    metamethod __eq: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>
    metamethod __lt: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>
    metamethod __le: function(left: simd.Vector<T, S>, right: simd.Vector<T, S> | T): simd.Mask<T, S>

    --- The smaller of each lane pair, and the larger, under the contract the
    --- name selects. There is no unqualified `min`: the two disagree on every
    --- pair containing a NaN, and which one a program wanted is not
    --- recoverable from the call.
    ---
    --- `propagatingMin` answers the canonical NaN whenever either operand is
    --- NaN, which is `nupp.math.f32.min`'s contract and what makes a reduction
    --- built on it independent of which lane the NaN landed in and of how many
    --- lanes the target chose. `-0` is the smaller zero and `+0` the larger, so
    --- an equal pair of zeros answers by sign rather than by position. `-inf`
    --- and `+inf` are ordinary values at the ends of the order.
    propagatingMin: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    propagatingMax: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- `numberMin` answers the operand that is not NaN, and the canonical NaN
    --- only when both are, which is IEEE-754's `minNum`. It is the contract for
    --- a scan looking for the smallest real measurement in data that carries
    --- NaN for a missing one. Zeros and infinities behave as they do above.
    ---
    --- A reduction over it depends on how many lanes were NaN, which is the
    --- price of ignoring them and the reason it is not the default.
    ---
    --- An integer element has no NaN, so the two contracts coincide there and
    --- either spelling answers the same value.
    numberMin: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    numberMax: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- `self * multiplier + addend` with one rounding per lane: the product
    --- is exact and only the sum rounds, so the two-step form's second
    --- rounding, and its overflow in a product the sum would have brought
    --- back, do not happen. On a `float` species this is `nupp.math.f32.fma`'s
    --- contract, the binary64 fused operation on a `number` one, and a NaN
    --- lane answers the canonical NaN either way. A floating species only; an
    --- integer product has nothing to round.
    fma: function(
        borrows self: simd.Vector<T, S>,
        multiplier: simd.Vector<T, S> | T,
        addend: simd.Vector<T, S> | T
    ): simd.Vector<T, S>

    --- `self + other` and `self - other` clamped to the element's range
    --- rather than wrapped: a byte that would reach 300 answers 255, and an
    --- unsigned lane taken below zero answers zero. An integer species only.
    saturatingAdd: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    saturatingSub: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- The number of one bits in each lane's two's complement representation
    --- at the element's width, so `-1` on a signed byte answers 8. An integer
    --- species only.
    popcount: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>

    --- The high half of each lane's full-width product: the bits above the
    --- element's width of `self * other` taken at twice that width, signed
    --- or unsigned as the element is. `*` answers the low half, so the two
    --- together are the whole product; alone, this is the fixed-point
    --- multiply, `(a * b) >> bits`, that a scaled reciprocal turns a division
    --- into. An integer species only.
    mulHigh: function(borrows self: simd.Vector<T, S>, other: simd.Vector<T, S> | T): simd.Vector<T, S>

    --- Lane indices are one-based and decided when the function is lowered:
    --- a literal, the species' `lanes`, or `+`, `-` and `*` over those, so
    --- `lanes` names the last lane of any species and `lanes - 1` the one
    --- before it. An index past the lanes the tier gives the species is
    --- refused there.
    extract: function(borrows self: simd.Vector<T, S>, lane: integer): T

    insert: function(borrows self: simd.Vector<T, S>, lane: integer, value: T): simd.Vector<T, S>

    --- Reverses logical lane order.
    reverse: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>

    --- Alternates lanes from self and other, then splits that sequence into
    --- two species-width results. No lane bits are changed.
    interleave: function(
        borrows self: simd.Vector<T, S>,
        other: simd.Vector<T, S>
    ): (simd.Vector<T, S>, simd.Vector<T, S>)

    --- Returns the odd and even lanes of self followed by other. This is the
    --- inverse of interleave, including for odd logical lane counts.
    deinterleave: function(
        borrows self: simd.Vector<T, S>,
        other: simd.Vector<T, S>
    ): (simd.Vector<T, S>, simd.Vector<T, S>)

    --- Rotates logical lanes. Counts are reduced modulo the species width.
    rotateLeft: function(borrows self: simd.Vector<T, S>, count: integer): simd.Vector<T, S>

    rotateRight: function(borrows self: simd.Vector<T, S>, count: integer): simd.Vector<T, S>

    --- Selects a species-width window from `previous .. self`. Offset zero
    --- returns `self`; positive offsets bring trailing lanes of `previous` into
    --- the beginning. The offset is decided when the function is lowered, on
    --- the terms `extract`'s lane is, and one past the lanes answers
    --- `previous` whole.
    align: function(borrows self: simd.Vector<T, S>, previous: simd.Vector<T, S>, offset: integer): simd.Vector<T, S>

    --- Every lane read from another lane this vector names at run time.
    ---
    --- Lane `i` answers `self:extract(indices:extract(i))`, and zero where that
    --- index is outside `1..lanes`. Zero rather than a refusal because the
    --- native instructions answer zero for an out-of-range byte and a check per
    --- lane would cost more than the lookup.
    ---
    --- This is the table lookup: a table is a vector, so there is no table type
    --- and no constructor taking one entry per argument. A sixteen-entry byte
    --- table is a `Fixed<16>` vector of constants, or a preferred-width one
    --- with those sixteen entries repeated, and looking up in it is this.
    ---
    --- With `other`, the lanes of both are numbered in one run: an index in
    --- `1..lanes` reads `self` and one in `lanes+1..2*lanes` reads `other`.
    --- That is the shape `align` needs and one vector cannot reach, and it is
    --- what makes this one operation rather than a family of them. `third` and
    --- `fourth` continue the run to three and four tables, which is how a
    --- 64-entry byte table on a sixteen-lane species is one lookup. They are
    --- optional on the same terms `load`'s mask is. An index a lane cannot
    --- hold -- past 255 for bytes -- is not reachable.
    ---
    --- The indices are read as lane numbers, so the element must be an integer
    --- one. A float vector has no lane numbering to offer.
    swizzle: function(
        borrows self: simd.Vector<T, S>,
        indices: simd.Vector<T, S>,
        other: simd.Vector<T, S>?,
        third: simd.Vector<T, S>?,
        fourth: simd.Vector<T, S>?
    ): simd.Vector<T, S>

    --- Packs selected lanes toward lane one and zeroes the remainder.
    compress: function(borrows self: simd.Vector<T, S>, selected: simd.Mask<T, S>): simd.Vector<T, S>

    --- Distributes packed lanes into selected positions and zeroes the rest.
    expand: function(borrows self: simd.Vector<T, S>, selected: simd.Mask<T, S>): simd.Vector<T, S>

    --- Inclusive, logical-lane-order prefix operations. The ordered sum adds lanes
    --- from the first, the way `orderedSum` does.
    orderedPrefixSum: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>

    prefixXor: function(borrows self: simd.Vector<T, S>): simd.Vector<T, S>
end

--- Operations whose lane count is selected from `T` and `S` at AOT lowering.
--- @export
sealed interface simd.Species<T, S>
    @readonly lanes: uint32

    --- Converts each lane using LuaJIT FFI numeric conversion rules. Integer
    --- narrowing keeps low bits; float-to-integer truncates through int64,
    --- except uint64 which accepts the union of signed and unsigned ranges.
    --- Integer-to-float follows LuaJIT's double intermediate, including the
    --- possible double rounding when converting a 64-bit integer to float.
    --- NaN, infinities and out-of-range inputs have target-specific results,
    --- never undefined behavior. Both species must have the same lane count.
    convert: function<U>(borrows self: simd.Species<T, S>, value: simd.Vector<U, S>): simd.Vector<T, S>

    --- Preserves every lane's bits. Element widths and lane counts must match.
    reinterpret: function<U>(borrows self: simd.Species<T, S>, value: simd.Vector<U, S>): simd.Vector<T, S>

    --- The species of the next wider element of this one's family and
    --- signedness -- `uint8` to `uint16`, `int32` to `int64`, `float` to
    --- `number` -- with this species' logical lane count, named by the wider
    --- element's storage witness. A `Fixed<N>` species widens to the
    --- `Fixed<N>` species of that element. A `Preferred` one widens to a
    --- species holding as many lanes as its own register does, twice what the
    --- wider element's preferred species holds, so a widened vector occupies
    --- two native registers the way a `Fixed<N>` past one register does. It
    --- is the species a byte kernel converts into for a sum its bytes would
    --- overflow, without naming a register width:
    ---
    --- ```nupp:fragment
    --- local bytes = assert(simd.species(array.uint8))
    --- local wide = bytes:widen(array.uint16)
    --- local weighted = wide:convert(bytes:load(reds, at + 1)) * 77
    --- ```
    ---
    --- The widened species keeps the checker's species identity `S`, so it
    --- reads as `simd.Species<uint16, simd.Preferred>`, the type
    --- `simd.species(array.uint16)` also has. They are different species once
    --- the function is lowered, one with the lane count of a `uint8` register
    --- and the other with its own, and a vector of one meets a vector of the
    --- other only through `convert`, which is refused there when the counts
    --- differ. Nothing is wider than 64 bits: widening a 64-bit species is
    --- refused where the function is lowered, as is a witness that is not the
    --- next wider element.
    widen: function<W>(borrows self: simd.Species<T, S>, wider: StorageWitness<W>): simd.Species<W, S>

    --- The species of the next narrower element with this species' lane
    --- count, the inverse of `widen`: a widened species narrows back to the
    --- species it came from, and a `Preferred` species narrows to one holding
    --- half the lanes the narrower element's own register does. Nothing is
    --- narrower than 8 bits.
    narrow: function<W>(borrows self: simd.Species<T, S>, narrower: StorageWitness<W>): simd.Species<W, S>

    splat: function(borrows self: simd.Species<T, S>, value: T): simd.Vector<T, S>
    iota: function(borrows self: simd.Species<T, S>, first: T, step: T): simd.Vector<T, S>
    tail: function(borrows self: simd.Species<T, S>, active: integer): simd.Mask<T, S>

    --- A mask of this species: every lane from one boolean, or lane for lane
    --- from another species' mask with the same lane count, which is what
    --- carries a comparison of one element type to a select on another.
    mask: function(borrows self: simd.Species<T, S>, value: boolean): simd.Mask<T, S>
        & function<U>(borrows self: simd.Species<T, S>, value: simd.Mask<U, S>): simd.Mask<T, S>

    --- The chunks of a span of `count` elements, for a loop written once:
    --- `for at, active in species:over(#input) do ... end` visits every
    --- element from offset one, `lanes` at a time, binding `at` to the
    --- one-based offset of the chunk and `active` to its mask. Every chunk
    --- but the last is full, and an access under its mask is the unmasked
    --- one the loop's own bound proves; the last chunk's mask is the tail.
    --- Pass `active` to every load and store, and to every reducer
    --- contribution, and the loop is the whole strip-mined algorithm: no
    --- separate tail, no scalar continuation.
    over: function(borrows self: simd.Species<T, S>, count: integer): function(): (uint32?, simd.Mask<T, S>)

    --- A scalar operation on every lane: a closed-set math operation such as
    --- `math.sqrt` over a floating species, one of the corrected binary32
    --- operations `nupp.math.f32.fma`, `min` and `max` over a `float` species,
    --- or a pure helper of this element taking one argument per vector. The
    --- operands must be locals.
    map: function(
        borrows self: simd.Species<T, S>,
        operation: function(...: any): T | number,
        ...: simd.Vector<T, S>
    ): simd.Vector<T, S>

    --- The next lanes of a span from `offset`, or one named field of its rows.
    --- A field in a span of structs is strided; a SoA row field is contiguous.
    --- `active` limits the lanes. The vector retains no storage borrow.
    load: function(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        offset: integer,
        active: simd.Mask<T, S>?
    ): simd.Vector<T, S>
        & function<E>(
            borrows self: simd.Species<T, S>,
            borrows source: Span<E>,
            offset: integer,
            field: string,
            active: simd.Mask<T, S>?
        ): simd.Vector<T, S>

        & function(
            borrows self: simd.Species<T, S>,
            borrows source: WriteSpan<T>,
            offset: integer,
            active: simd.Mask<T, S>?
        ): simd.Vector<T, S>
        & function<E>(
            borrows self: simd.Species<T, S>,
            borrows source: WriteSpan<E>,
            offset: integer,
            field: string,
            active: simd.Mask<T, S>?
        ): simd.Vector<T, S>
        & function<E>(
            borrows self: simd.Species<T, S>,
            borrows source: SoaWriteToken & SoaWriteSpan<E>,
            offset: integer,
            field: string,
            active: simd.Mask<T, S>?
        ): simd.Vector<T, S>
        & function(
            borrows self: simd.Species<T, S>,
            borrows source: SoaReadView,
            offset: integer,
            field: string,
            active: simd.Mask<T, S>?
        ): simd.Vector<T, S>

    --- Writes the next lanes of a span or one named field of its rows.
    --- Other fields are unchanged.
    store: function(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        offset: integer,
        value: simd.Vector<T, S>,
        active: simd.Mask<T, S>?
    ): nil
        & function<E>(
            borrows self: simd.Species<T, S>,
            exclusive destination: WriteSpan<E>,
            offset: integer,
            field: string,
            value: simd.Vector<T, S>,
            active: simd.Mask<T, S>?
        ): nil
        & function<E>(
            borrows self: simd.Species<T, S>,
            exclusive destination: SoaWriteToken & SoaWriteSpan<E>,
            offset: integer,
            field: string,
            value: simd.Vector<T, S>,
            active: simd.Mask<T, S>?
        ): nil

    --- The next `2 * lanes` elements from `offset`, dealt out a lane at a
    --- time: the first vector holds the elements at odd positions of the run
    --- and the second those at even ones, so interleaved pairs arrive as two
    --- vectors of their halves. Elements past the span read zero. The
    --- results initialize locals, `local re, im = s:loadPairs(zs, at + 1)`.
    ---
    --- On NEON this is one `ld2`; `loadTriples` and `loadQuads` are `ld3` and
    --- `ld4`, which is what a three-byte or four-byte record costs to
    --- de-interleave there.
    loadPairs: function(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        offset: integer
    ): (simd.Vector<T, S>, simd.Vector<T, S>)
        & function(
            borrows self: simd.Species<T, S>,
            borrows source: WriteSpan<T>,
            offset: integer
        ): (simd.Vector<T, S>, simd.Vector<T, S>)

    --- The next `3 * lanes` elements, lane `i` of the `j`th vector reading
    --- element `3 * (i - 1) + j` of the run.
    loadTriples: function(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        offset: integer
    ): (simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>)
        & function(
            borrows self: simd.Species<T, S>,
            borrows source: WriteSpan<T>,
            offset: integer
        ): (simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>)

    --- The next `4 * lanes` elements, lane `i` of the `j`th vector reading
    --- element `4 * (i - 1) + j` of the run.
    loadQuads: function(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        offset: integer
    ): (simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>)
        & function(
            borrows self: simd.Species<T, S>,
            borrows source: WriteSpan<T>,
            offset: integer
        ): (simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>, simd.Vector<T, S>)

    --- The inverse of `loadPairs`: `2 * lanes` elements from `offset`,
    --- alternating a lane of `first` with the same lane of `second`. Elements
    --- past the span are not written.
    storePairs: function(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        offset: integer,
        first: simd.Vector<T, S>,
        second: simd.Vector<T, S>
    ): nil

    --- The inverse of `loadTriples`.
    storeTriples: function(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        offset: integer,
        first: simd.Vector<T, S>,
        second: simd.Vector<T, S>,
        third: simd.Vector<T, S>
    ): nil

    --- The inverse of `loadQuads`.
    storeQuads: function(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        offset: integer,
        first: simd.Vector<T, S>,
        second: simd.Vector<T, S>,
        third: simd.Vector<T, S>,
        fourth: simd.Vector<T, S>
    ): nil

    --- Reads one-based element indices. Inactive or out-of-range lanes return
    --- zero. Indices use int32, uint32, int64 or uint64 and must have the same
    --- logical lane count as this species at every emitted tier.
    gather: function<I>(
        borrows self: simd.Species<T, S>,
        borrows source: Span<T>,
        indices: simd.Vector<I, S>,
        active: simd.Mask<T, S>?
    ): simd.Vector<T, S>

    --- Writes one-based element indices, ignoring inactive or out-of-range
    --- lanes. The compiler must prove that indices are unique; currently a
    --- directly supplied constant, non-wrapping iota provides that proof.
    --- No runtime collision check is emitted.
    scatter: function<I>(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        indices: simd.Vector<I, S>,
        value: simd.Vector<T, S>,
        active: simd.Mask<T, S>?
    ): nil

    --- Asserts that all active indices are unique, without checking them.
    --- Duplicate active indices are undefined behavior, even if the values
    --- agree. This promises no winning lane or accumulation order and does
    --- not authorize collisions between separate scatter operations.
    --- Bounds and inactive lanes behave as in scatter.
    scatterUnchecked: function<I>(
        borrows self: simd.Species<T, S>,
        exclusive destination: WriteSpan<T>,
        indices: simd.Vector<I, S>,
        value: simd.Vector<T, S>,
        active: simd.Mask<T, S>?
    ): nil
end

----------------------------------------------------------------------------
-- The species as ordinary Lua
----------------------------------------------------------------------------

--[[
Where a kernel runs as ordinary Lua -- under `aot = "off"`, in the retained
body beside an emitted artifact, in a function that is not `@aot` -- the
species `simd.species` answers is the one below, and the code generator
routes every operator and method whose operand the checker typed as a vector
or a mask through `simd.lane`. A preferred species is one lane wide, since
there are no vector registers to be as wide as: its vector is a plain Lua
number already wrapped to its element, its mask a plain boolean, and the same
loop runs a lane at a time, which is how `v == needle` on a number and
`m:any()` on a boolean mean what they mean in lanes. A fixed species is the N
lanes it names, as it is on every native tier: its vector and its mask are
the N-lane tables described at the top of this module, and `species:over`
visits a span N lanes at a time under a real tail mask. The native lowering
never sees any of this: a tier with vector registers takes them, and one
without lowers a preferred species as one lane too.
]]

--- The element name each standard witness denotes.
local ELEMENT_OF: {
    [any]: string
} = {
    [storageWitnesses.uint8] = "uint8",
    [storageWitnesses.int8] = "int8",
    [storageWitnesses.uint16] = "uint16",
    [storageWitnesses.int16] = "int16",
    [storageWitnesses.uint32] = "uint32",
    [storageWitnesses.int32] = "int32",
    [storageWitnesses.uint64] = "uint64",
    [storageWitnesses.int64] = "int64",
    [storageWitnesses.float] = "float",
    [storageWitnesses.number] = "number",
}

const BITS: {
    [string]: number
} = {uint8 = 8, int8 = 8, uint16 = 16, int16 = 16, uint32 = 32, int32 = 32, uint64 = 64, int64 = 64,}

const SIGNED: {[string]: boolean} = {int8 = true, int16 = true, int32 = true, int64 = true,}

local function isFloat(element: string): boolean
    return element == "float" or element == "number"
end

--- Whether a value is a 64-bit box rather than a Lua number.
local function wide(value: any): boolean
    return type(value) == "cdata"
end

--- Division toward zero with the lanes' answer for a zero divisor.
local function truncate(value: number): number
    if value ~= value then
        return 0
    elseif value < 0 then
        return math.ceil(value)
    end

    return math.floor(value)
end

--- A value as its element: narrowed to binary32, wrapped to the integer
--- width, or passed as the 64-bit box it already is.
local function wrap(element: string, value: any): any
    if element == "number" then
        return value
    elseif element == "float" then
        return nupp.math.f32.narrow(value as number)
    elseif element == "uint32" then
        return nupp.math.u32.wrap(truncate(value as number) as integer)
    elseif element == "int32" then
        return nupp.math.i32.wrap(truncate(value as number) as integer)
    elseif element == "uint64" then
        return (0ULL + (value as any)) as any
    elseif element == "int64" then
        return (0LL + (value as any)) as any
    end
    local modulus = 2 ^ (BITS[element] as number)
    local unsigned = (value as number) % modulus
    if SIGNED[element] and unsigned >= modulus / 2 then
        return unsigned - modulus
    end

    return unsigned
end

--- A lane's bits as the unsigned 32-bit number of its width, established
--- for the bit library, for the bitwise operators of lanes up to 32 bits.
local function pattern(element: string, value: any): uint32
    local modulus = 2 ^ (BITS[element] as number)

    return nupp.math.u32.wrap(((value as number) % modulus) as integer)
end

local function integerDivide(element: string, a: any, b: any): any
    if wide(a) or wide(b) then
        if b == 0 then
            return wrap(element, 0)
        end
        return wrap(element, (a as any) / (b as any))
    end
    if (b as number) == 0 then
        return 0
    end

    return wrap(element, truncate((a as number) / (b as number)))
end

local function shiftCount(element: string, count: any): number
    return (tonumber(count) as number) % (BITS[element] as number)
end

local function bitwise(element: string, op: string, a: any, b: any): any
    if element == "number" or element == "float" then
        error("bitwise SIMD operators require an integer vector element", 3)
    end
    if BITS[element] == 64 then
        local left = (SIGNED[element] and (0LL + (a as any)) or (0ULL + (a as any))) as any
        local right = (SIGNED[element] and (0LL + (b as any)) or (0ULL + (b as any))) as any
        if op == "&" then
            return (left & right) as any
        elseif op == "|" then
            return (left | right) as any
        elseif op == "~" then
            return (left ~ right) as any
        elseif op == "<<" then
            return (left << shiftCount(element, b)) as any
        elseif op == ">>" then
            return ((0ULL + left) >> shiftCount(element, b)) as any
        end
        return (left ~>> shiftCount(element, b)) as any
    end
    local left = pattern(element, a)
    if op == "<<" then
        return wrap(element, (left as number) * 2 ^ shiftCount(element, b))
    elseif op == ">>" then
        return wrap(element, math.floor((left as number) / 2 ^ shiftCount(element, b)))
    elseif op == "~>>" then
        return wrap(element, math.floor((a as number) / 2 ^ shiftCount(element, b)))
    end
    -- Narrow lanes fit the 32-bit bit library exactly.
    local right = pattern(element, b)
    if op == "&" then
        return wrap(element, nupp.math.u32.andBits(left, right))
    elseif op == "|" then
        return wrap(element, nupp.math.u32.orBits(left, right))
    end

    return wrap(element, nupp.math.u32.xorBits(left, right))
end

local function isNaN(value: any): boolean
    return value ~= value
end

--- The lane extrema contracts of `simd.Vector`, for one pair.
local function extremum(a: any, b: any, minimum: boolean, propagating: boolean): any
    if isNaN(a) or isNaN(b) then
        if propagating then
            return 0 / 0
        elseif isNaN(a) and isNaN(b) then
            return 0 / 0
        end
        return isNaN(a) and b or a
    end
    if a == b and (a as number) == 0 then
        -- Signed zeros: -0 is the smaller.
        local negativeA = 1 / (a as number) < 0
        if minimum then
            return negativeA and a or b
        end
        return negativeA and b or a
    end
    if minimum then
        return (a as number) < (b as number) and a or b
    end

    return (a as number) > (b as number) and a or b
end

--- The lane operations, as the code generator calls them for a value the
--- checker typed as a vector or a mask: a binary operator, a unary one, and
--- a method. `element` is the element name, or "mask" for a mask. Each
--- answers an N-lane form lane by lane through the one-lane operation
--- beneath it.
--- @export
local lane = {}

--- A binary operator on one lane, or on a preferred-species vector or mask.
--- @raises string when the operator is not one the lanes have
local function binaryLane(op: string, element: string, a: any, b: any): any
    if element == "mask" then
        if op == "&" then
            return a and b
        elseif op == "|" then
            return a or b
        elseif op == "~" then
            return a ~= b
        elseif op == "==" then
            return a == b
        elseif op == "~=" then
            return a ~= b
        end
        error("operator " .. op .. " is not a mask intrinsic", 2)
    end
    if op == "+" then
        return wrap(element, (a as any) + (b as any))
    elseif op == "-" then
        return wrap(element, (a as any) - (b as any))
    elseif op == "*" then
        if BITS[element] == 32 then
            -- The low thirty-two bits of the product, which a double cannot
            -- hold whole, are the same bits whatever the signs.
            return wrap(element, nupp.math.u32.mul(pattern(element, a), pattern(element, b)))
        end
        return wrap(element, (a as any) * (b as any))
    elseif op == "/" then
        if isFloat(element) then
            return wrap(element, (a as number) / (b as number))
        end
        return integerDivide(element, a, b)
    elseif op == "%" then
        if isFloat(element) then
            return wrap(element, (a as number) % (b as number))
        elseif b == 0 then
            return wrap(element, 0)
        end
        return wrap(element, (a as any) % (b as any))
    elseif op == "//" then
        if isFloat(element) then
            return wrap(element, math.floor((a as number) / (b as number)))
        elseif b == 0 then
            return wrap(element, 0)
        end
        return wrap(element, math.floor((a as any) / (b as any)))
    elseif op == "==" then
        return a == b
    elseif op == "~=" then
        return a ~= b
    elseif op == "<" then
        return (a as number) < (b as number)
    elseif op == "<=" then
        return (a as number) <= (b as number)
    elseif op == ">" then
        return (a as number) > (b as number)
    elseif op == ">=" then
        return (a as number) >= (b as number)
    end

    return bitwise(element, op, a, b)
end

--- A unary operator on one lane.
local function unaryLane(op: string, element: string, a: any): any
    if element == "mask" then
        return not a
    end
    if op == "-" then
        return wrap(element, -(a as any))
    end
    if BITS[element] == 64 then
        return (~(0LL + (a as any))) as any
    elseif BITS[element] == 32 then
        return wrap(element, nupp.math.u32.notBits(pattern(element, a)))
    end

    return wrap(element, 2 ^ (BITS[element] as number) - 1 - pattern(element, a))
end

--- The operators whose answer is a mask whatever their operands are.
const COMPARISONS: {
    [string]: boolean
} = {["=="] = true, ["~="] = true, ["<"] = true, ["<="] = true, [">"] = true, [">="] = true,}

--- The element the value an operator answers carries: the N-lane operand's,
--- which for a mask operator is the element of the species the masks belong
--- to, and the operator's own element otherwise.
local function carriedElement(element: string, a: any, b: any): string
    if lanesOf(a) ~= nil then
        return elementOf(a)
    elseif lanesOf(b) ~= nil then
        return elementOf(b)
    end

    return element
end

--- @raises string when the operator is not one the lanes have
--- @export
function lane.binary(op: string, element: string, a: any, b: any): any
    local n = lanesOf(a) or lanesOf(b)
    if n == nil then
        return binaryLane(op, element, a, b)
    end
    local lanes: {[integer]: any} = {}
    for i = 1, n as integer do
        lanes[i] = binaryLane(op, element, laneAt(a, i), laneAt(b, i))
    end
    local carried = carriedElement(element, a, b)
    if element == "mask" or COMPARISONS[op] then
        return maskOf(carried, n as integer, lanes)
    end

    return vectorOf(carried, n as integer, lanes)
end

--- @export
function lane.unary(op: string, element: string, a: any): any
    local n = lanesOf(a)
    if n == nil then
        return unaryLane(op, element, a)
    end
    local lanes: {[integer]: any} = {}
    for i = 1, n as integer do
        lanes[i] = unaryLane(op, element, laneAt(a, i))
    end
    if element == "mask" then
        return maskOf(elementOf(a), n as integer, lanes)
    end

    return vectorOf(elementOf(a), n as integer, lanes)
end

local function saturate(element: string, value: number): number
    if isFloat(element) then
        return value
    end
    local bits = BITS[element] as number
    local low = SIGNED[element] and -(2 ^ (bits - 1)) or 0
    local high = SIGNED[element] and 2 ^ (bits - 1) - 1 or 2 ^ bits - 1

    return math.max(low, math.min(high, value))
end

local function popcount(element: string, value: any): any
    if BITS[element] == 64 then
        return nupp.math.u64.popcount((0ULL + (value as any)) as uint64)
    end

    return nupp.math.u32.popcount(pattern(element, value))
end

--- The methods on one lane, or on a preferred-species vector or mask. On an
--- N-lane form `lane.method` applies the lane-by-lane ones here to each
--- lane and takes the rest from `WIDE` below.
local METHODS: {[string]: function(string, any, ...: any): any} = {
    propagatingMin = function(_element: string, a: any, b: any): any
        return extremum(a, b, true, true)
    end,
    propagatingMax = function(_element: string, a: any, b: any): any
        return extremum(a, b, false, true)
    end,
    numberMin = function(_element: string, a: any, b: any): any
        return extremum(a, b, true, false)
    end,
    numberMax = function(_element: string, a: any, b: any): any
        return extremum(a, b, false, false)
    end,
    extract = function(_element: string, a: any, index: any): any
        if index ~= 1 then
            error("SIMD lane extraction index exceeds the logical species lanes", 3)
        end
        return a
    end,
    insert = function(element: string, _a: any, index: any, value: any): any
        if index ~= 1 then
            error("SIMD lane insertion index exceeds the logical species lanes", 3)
        end
        return wrap(element, value)
    end,
    reverse = function(_element: string, a: any): any
        return a
    end,
    interleave = function(_element: string, a: any, b: any): (any, any)
        return a, b
    end,
    deinterleave = function(_element: string, a: any, b: any): (any, any)
        return a, b
    end,
    rotateLeft = function(_element: string, a: any): any
        return a
    end,
    rotateRight = function(_element: string, a: any): any
        return a
    end,
    align = function(_element: string, a: any, previous: any, offset: any): any
        if offset == 0 then
            return a
        end
        return previous
    end,
    swizzle = function(_element: string, a: any, index: any, second: any, third: any, fourth: any): any
        if index == 1 then
            return a
        elseif index == 2 and second ~= nil then
            return second
        elseif index == 3 and third ~= nil then
            return third
        elseif index == 4 and fourth ~= nil then
            return fourth
        end

        return 0
    end,
    compress = function(_element: string, a: any, selected: any): any
        return selected and a or 0
    end,
    expand = function(_element: string, a: any, selected: any): any
        return selected and a or 0
    end,
    orderedPrefixSum = function(_element: string, a: any): any
        return a
    end,
    prefixXor = function(_element: string, a: any): any
        return a
    end,
    fma = function(element: string, a: any, b: any, c: any): any
        if element == "float" then
            return nupp.math.f32.fma(
                nupp.math.f32.narrow(a as number),
                nupp.math.f32.narrow(b as number),
                nupp.math.f32.narrow(c as number)
            )
        end

        return wrap(element, (a as number) * (b as number) + (c as number))
    end,
    saturatingAdd = function(element: string, a: any, b: any): any
        return wrap(element, saturate(element, (a as number) + (b as number)))
    end,
    saturatingSub = function(element: string, a: any, b: any): any
        return wrap(element, saturate(element, (a as number) - (b as number)))
    end,
    popcount = function(element: string, a: any): any
        return popcount(element, a)
    end,
    mulHigh = function(element: string, a: any, b: any): any
        local bits = BITS[element] as number
        if bits == 64 then
            error("mulHigh on a 64-bit lane is not available in the one-lane species", 3)
        end
        if bits <= 16 then
            return wrap(element, math.floor((a as number) * (b as number) / 2 ^ bits))
        end
        -- Sixteen-bit halves keep every partial product exact in a double.
        local left = pattern(element, a)
        local right = pattern(element, b)
        local lowA, highA = left % 65536, math.floor(left / 65536)
        local lowB, highB = right % 65536, math.floor(right / 65536)
        local low = lowA * lowB
        local cross = highA * lowB + lowA * highB + math.floor(low / 65536)
        local high = highA * highB + math.floor(cross / 65536)
        if SIGNED[element] then
            if (a as number) < 0 then
                high = high - right
            end
            if (b as number) < 0 then
                high = high - left
            end
        end

        return wrap(element, high)
    end,
    -- The closed math set applied directly to a float vector.
    sqrt = function(element: string, a: any): any
        return wrap(element, math.sqrt(a as number))
    end,
    abs = function(element: string, a: any): any
        return wrap(element, math.abs(a as number))
    end,
    floor = function(element: string, a: any): any
        return wrap(element, math.floor(a as number))
    end,
    ceil = function(element: string, a: any): any
        return wrap(element, math.ceil(a as number))
    end,
    -- Masks.
    select = function(_element: string, mask: any, yes: any, no: any): any
        if mask then
            return yes
        end
        return no
    end,
    any = function(_element: string, mask: any): any
        return mask == true
    end,
    all = function(_element: string, mask: any): any
        return mask == true
    end,
    count = function(_element: string, mask: any): any
        return mask and 1 or 0
    end,
    first = function(_element: string, mask: any): any
        return mask and 1 or 0
    end,
    bits = function(_element: string, mask: any): any
        return mask and 1ULL or 0ULL
    end,
}

--- A lane index argument as an integer within `1 .. n`.
--- @raises string when the index is outside the lanes
local function laneIndex(index: any, n: integer, what: string): integer
    local i = tonumber(index)
    if i == nil or i < 1 or i > n or i % 1 ~= 0 then
        error("SIMD lane " .. what .. " index exceeds the logical species lanes", 4)
    end

    return i as integer
end

--- The methods whose answer is not lane by lane: on an N-lane form they
--- rearrange, pack, scan or summarize its lanes. `n` is the lane count and
--- `element` the receiver's element; a mask method receives the mask.
local WIDE: {[string]: function(string, integer, any, ...: any): any} = {
    extract = function(_element: string, n: integer, a: any, index: any): any
        return laneAt(a, laneIndex(index, n, "extraction"))
    end,
    insert = function(element: string, n: integer, a: any, index: any, value: any): any
        local lanes = copyLanes(a, n)
        lanes[laneIndex(index, n, "insertion")] = wrap(element, value)

        return vectorOf(element, n, lanes)
    end,
    reverse = function(element: string, n: integer, a: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            lanes[i] = laneAt(a, n + 1 - i)
        end

        return vectorOf(element, n, lanes)
    end,
    interleave = function(element: string, n: integer, a: any, b: any): (any, any)
        local run: {[integer]: any} = {}
        for i = 1, n do
            run[2 * i - 1] = laneAt(a, i)
            run[2 * i] = laneAt(b, i)
        end
        local first: {[integer]: any} = {}
        local second: {[integer]: any} = {}
        for i = 1, n do
            first[i] = run[i]
            second[i] = run[n + i]
        end

        return vectorOf(element, n, first), vectorOf(element, n, second)
    end,
    deinterleave = function(element: string, n: integer, a: any, b: any): (any, any)
        local odd: {[integer]: any} = {}
        local even: {[integer]: any} = {}
        for run = 1, 2 * n do
            local value = run <= n and laneAt(a, run) or laneAt(b, run - n)
            if run % 2 == 1 then
                odd[((run + 1) / 2) as integer] = value
            else
                even[(run / 2) as integer] = value
            end
        end

        return vectorOf(element, n, odd), vectorOf(element, n, even)
    end,
    rotateLeft = function(element: string, n: integer, a: any, count: any): any
        local by = (tonumber(count) as number) % n
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            lanes[i] = laneAt(a, ((i - 1 + by) % n + 1) as integer)
        end

        return vectorOf(element, n, lanes)
    end,
    rotateRight = function(element: string, n: integer, a: any, count: any): any
        local by = (tonumber(count) as number) % n
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            lanes[i] = laneAt(a, ((i - 1 - by) % n + 1) as integer)
        end

        return vectorOf(element, n, lanes)
    end,
    align = function(element: string, n: integer, a: any, previous: any, offset: any): any
        local by = tonumber(offset)
        if by == nil or by < 0 or by > n or by % 1 ~= 0 then
            error("SIMD align offset exceeds the logical species lanes", 3)
        end
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            if i <= by then
                lanes[i] = laneAt(previous, (n - by + i) as integer)
            else
                lanes[i] = laneAt(a, (i - by) as integer)
            end
        end

        return vectorOf(element, n, lanes)
    end,
    swizzle = function(element: string, n: integer, a: any, indices: any, other: any, third: any, fourth: any): any
        local run = copyLanes(a, n)
        for _, more in ipairs({other, third, fourth}) do
            for i = 1, n do
                run[#run + 1] = laneAt(more, i)
            end
        end
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            local index = tonumber(laneAt(indices, i))
            if index ~= nil and index >= 1 and index <= #run and index % 1 == 0 then
                lanes[i] = run[index as integer]
            else
                lanes[i] = wrap(element, 0)
            end
        end

        return vectorOf(element, n, lanes)
    end,
    compress = function(element: string, n: integer, a: any, selected: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            if laneAt(selected, i) == true then
                lanes[#lanes + 1] = laneAt(a, i)
            end
        end
        for i = #lanes + 1, n do
            lanes[i] = wrap(element, 0)
        end

        return vectorOf(element, n, lanes)
    end,
    expand = function(element: string, n: integer, a: any, selected: any): any
        local lanes: {[integer]: any} = {}
        local packed: integer = 0
        for i = 1, n do
            if laneAt(selected, i) == true then
                packed = packed + 1
                lanes[i] = laneAt(a, packed)
            else
                lanes[i] = wrap(element, 0)
            end
        end

        return vectorOf(element, n, lanes)
    end,
    orderedPrefixSum = function(element: string, n: integer, a: any): any
        local lanes: {[integer]: any} = {}
        lanes[1] = laneAt(a, 1)
        for i = 2, n do
            lanes[i] = binaryLane("+", element, lanes[i - 1], laneAt(a, i))
        end

        return vectorOf(element, n, lanes)
    end,
    prefixXor = function(element: string, n: integer, a: any): any
        local lanes: {[integer]: any} = {}
        lanes[1] = laneAt(a, 1)
        for i = 2, n do
            lanes[i] = binaryLane("~", element, lanes[i - 1], laneAt(a, i))
        end

        return vectorOf(element, n, lanes)
    end,
    -- Masks: the receiver is the mask, which carries its species' element.
    select = function(_element: string, n: integer, mask: any, yes: any, no: any): any
        local element = carriedElement(elementOf(mask), yes, no)
        local lanes: {[integer]: any} = {}
        for i = 1, n do
            if laneAt(mask, i) == true then
                lanes[i] = wrap(element, laneAt(yes, i))
            else
                lanes[i] = wrap(element, laneAt(no, i))
            end
        end

        return vectorOf(element, n, lanes)
    end,
    any = function(_element: string, n: integer, mask: any): any
        for i = 1, n do
            if laneAt(mask, i) == true then
                return true
            end
        end

        return false
    end,
    all = function(_element: string, n: integer, mask: any): any
        for i = 1, n do
            if laneAt(mask, i) ~= true then
                return false
            end
        end

        return true
    end,
    count = function(_element: string, n: integer, mask: any): any
        local total = 0
        for i = 1, n do
            if laneAt(mask, i) == true then
                total = total + 1
            end
        end

        return total
    end,
    first = function(_element: string, n: integer, mask: any): any
        for i = 1, n do
            if laneAt(mask, i) == true then
                return i
            end
        end

        return 0
    end,
    bits = function(_element: string, n: integer, mask: any): any
        local total = 0ULL
        for i = 1, n do
            if laneAt(mask, i) == true then
                total = total + (2 ^ (i - 1)) as uint64
            end
        end

        return total
    end,
}

--- @raises string when the method is not one the lanes have
--- @export
function lane.method(name: string, element: string, receiver: any, ...: any): any
    local method = METHODS[name]
    if method == nil then
        error("method :" .. name .. " is not a SIMD lane operation", 2)
    end
    local n = lanesOf(receiver)
    if n == nil then
        return method(element, receiver, ...)
    end
    local wide = WIDE[name]
    if wide ~= nil then
        return wide(element, n as integer, receiver, ...)
    end
    -- Lane by lane, a scalar argument standing for every lane.
    local count = select("#", ...)
    local arguments = {...}
    local lanes: {[integer]: any} = {}
    for i = 1, n as integer do
        local own: {any} = {}
        for k = 1, count do
            own[k] = laneAt(arguments[k], i)
        end
        lanes[i] = method(element, laneAt(receiver, i), unpack<any>(own, 1, count))
    end

    return vectorOf(elementOf(receiver), n as integer, lanes)
end

const simd.lane = lane

--- The element count of a span. `#` on the span's static type is its
--- `count`, which an untyped runtime value has to read by name.
local function spanCount(source: any): number
    return (source as any).count as number
end

--- Reads an element, or one named field of it, from a span or view.
local function readAt(source: any, offset: any, field: string?): any
    local value = (source as any):get(offset)
    if field ~= nil then
        return (value as any)[field as string]
    end

    return value
end

local scalarSpecies: function(any, any): any

--- One lane converted to `element` under the FFI's numeric conversion rules.
local function convertLane(element: string, value: any): any
    if isFloat(element) then
        return wrap(element, tonumber(value))
    end
    local number = tonumber(value) as number
    if number ~= number then
        number = 0
    end

    return wrap(element, truncate(number))
end

--- One lane's bits read as `element`.
--- @raises string for a 64-bit element, whose bits a Lua number cannot carry
local function reinterpretLane(element: string, value: any): any
    if element == "float" then
        return nupp.math.f32.fromBits(pattern("uint32", value))
    elseif BITS[element] == 32 and type(value) == "number" and value % 1 ~= 0 then
        -- A fractional value can only have been a float lane.
        return wrap(element, nupp.math.f32.toBits(nupp.math.f32.narrow(value as number)))
    elseif element == "number" or BITS[element] == 64 then
        error("a 64-bit reinterpretation is not available as ordinary Lua", 3)
    end

    return wrap(element, value)
end

--- The species object as ordinary Lua: one lane wide for a preferred
--- species, N wide for a fixed one. Every method visits `lanes` lanes and
--- answers through `make`, so the two forms share one body.
local record LuaSpecies
    @readonly lanes: integer
    @readonly element: string

    --- A vector of this species from its lanes: the one lane itself for a
    --- preferred species, the N-lane form for a fixed one.
    function make(self, lanes: {[integer]: any}): any
        if self.lanes == 1 then
            return lanes[1]
        end

        return vectorOf(self.element, self.lanes, lanes)
    end

    function makeMask(self, lanes: {[integer]: any}): any
        if self.lanes == 1 then
            return lanes[1]
        end

        return maskOf(self.element, self.lanes, lanes)
    end

    --- Element `index` of a span, or zero outside it.
    function readOrZero(self, source: any, index: number): any
        if index < 1 or index > spanCount(source) then
            return wrap(self.element, 0)
        end

        return wrap(self.element, (source as any):get(index))
    end

    function load(self, source: any, offset: any, third: any, fourth: any): any
        local field: string? = nil
        local active = third
        if type(third) == "string" then
            field = third as string
            active = fourth
        end
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            if activeAt(active, i) then
                lanes[i] = wrap(self.element, readAt(source, (offset as number) + i - 1, field))
            else
                lanes[i] = wrap(self.element, 0)
            end
        end

        return self:make(lanes)
    end

    function store(self, destination: any, offset: any, third: any, fourth: any, fifth: any): nil
        local target = destination as any
        if type(third) == "string" then
            local field = third as string
            for i = 1, self.lanes do
                if activeAt(fifth, i) then
                    local at = (offset as number) + i - 1
                    local row = target:get(at) as {[string]: any}
                    row[field] = laneAt(fourth, i)
                    target:set(at, row)
                end
            end
            return
        end
        for i = 1, self.lanes do
            if activeAt(fourth, i) then
                target:set((offset as number) + i - 1, laneAt(third, i))
            end
        end
    end

    function gather(self, source: any, index: any, active: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            if activeAt(active, i) then
                lanes[i] = self:readOrZero(source, tonumber(laneAt(index, i)) as number)
            else
                lanes[i] = wrap(self.element, 0)
            end
        end

        return self:make(lanes)
    end

    function scatter(self, destination: any, index: any, value: any, active: any): nil
        local target = destination as any
        local limit = spanCount(destination)
        for i = 1, self.lanes do
            local at = tonumber(laneAt(index, i)) as number
            if activeAt(active, i) and at >= 1 and at <= limit then
                target:set(at, laneAt(value, i))
            end
        end
    end

    function scatterUnchecked(self, destination: any, index: any, value: any, active: any): nil
        self:scatter(destination, index, value, active)
    end

    function convert(self, value: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = convertLane(self.element, laneAt(value, i))
        end

        return self:make(lanes)
    end

    function reinterpret(self, value: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = reinterpretLane(self.element, laneAt(value, i))
        end

        return self:make(lanes)
    end

    --- Another element's species with this one's lane count.
    function widen(self, witness: any): any
        return scalarSpecies(witness, self.lanes > 1 and self.lanes or nil)
    end

    function narrow(self, witness: any): any
        return scalarSpecies(witness, self.lanes > 1 and self.lanes or nil)
    end

    function splat(self, value: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = wrap(self.element, value)
        end

        return self:make(lanes)
    end

    function iota(self, first: any, step: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = wrap(self.element, (first as any) + (i - 1) * (step as any))
        end

        return self:make(lanes)
    end

    function tail(self, active: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = i <= (active as number)
        end

        return self:makeMask(lanes)
    end

    function mask(self, value: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            lanes[i] = laneAt(value, i) == true
        end

        return self:makeMask(lanes)
    end

    function map(self, operation: any, ...: any): any
        local count = select("#", ...)
        local arguments = {...}
        local apply = operation as function(...: any): any
        local lanes: {[integer]: any} = {}
        for i = 1, self.lanes do
            local own: {any} = {}
            for k = 1, count do
                own[k] = laneAt(arguments[k], i)
            end
            lanes[i] = wrap(self.element, apply(unpack<any>(own, 1, count)))
        end

        return self:make(lanes)
    end

    function over(self, count: any): function(): (any, any)
        local n = self.lanes
        local limit = count as number
        local at = 1 - n
        local full = self:tail(n)

        return function(): (any, any)
            at = at + n
            if at > limit then
                return nil, nil
            end
            local room = limit - at + 1
            if room >= n then
                return at, full
            end

            return at, self:tail(room)
        end
    end

    --- `k` vectors dealt from the `k * lanes` elements at `offset`, lane `i`
    --- of the `j`th reading element `k * (i - 1) + j` of the run, and zero
    --- past the span.
    function loadRun(self, source: any, offset: any, k: integer): {[integer]: any}
        local vectors: {[integer]: any} = {}
        for j = 1, k do
            local lanes: {[integer]: any} = {}
            for i = 1, self.lanes do
                lanes[i] = self:readOrZero(source, (offset as number) + k * (i - 1) + (j - 1))
            end
            vectors[j] = self:make(lanes)
        end

        return vectors
    end

    --- The inverse of `loadRun`; elements past the span are not written.
    function storeRun(self, destination: any, offset: any, vectors: {[integer]: any}): nil
        local target = destination as any
        local limit = spanCount(destination)
        local k = #vectors
        for j = 1, k do
            for i = 1, self.lanes do
                local at = (offset as number) + k * (i - 1) + (j - 1)
                if at >= 1 and at <= limit then
                    target:set(at, laneAt(vectors[j], i))
                end
            end
        end
    end

    function loadPairs(self, source: any, offset: any): (any, any)
        local run = self:loadRun(source, offset, 2)

        return run[1], run[2]
    end

    function loadTriples(self, source: any, offset: any): (any, any, any)
        local run = self:loadRun(source, offset, 3)

        return run[1], run[2], run[3]
    end

    function loadQuads(self, source: any, offset: any): (any, any, any, any)
        local run = self:loadRun(source, offset, 4)

        return run[1], run[2], run[3], run[4]
    end

    function storePairs(self, destination: any, offset: any, first: any, second: any): nil
        self:storeRun(destination, offset, {first, second})
    end

    function storeTriples(self, destination: any, offset: any, first: any, second: any, third: any): nil
        self:storeRun(destination, offset, {first, second, third})
    end

    function storeQuads(self, destination: any, offset: any, first: any, second: any, third: any, fourth: any): nil
        self:storeRun(destination, offset, {first, second, third, fourth})
    end
end

local speciesCache: {[string]: LuaSpecies} = {}

scalarSpecies = function(element: any, lanes: any): any
    local name = ELEMENT_OF[element]
    if name == nil then
        error("simd.species takes one of the scalar witnesses in nupp.mem.array, such as array.uint32", 3)
    end
    if lanes ~= nil and (type(lanes) ~= "number" or lanes < 2 or lanes > 64 or lanes % 1 ~= 0) then
        error("simd.species takes a witness and, for a fixed shape, one literal lane count", 3)
    end
    local width: integer = 1
    if lanes ~= nil then
        width = lanes as integer
    end
    local key = (name as string) .. "/" .. tostring(width)
    local found = speciesCache[key]
    if found == nil then
        found = new LuaSpecies(lanes = width, element = name as string)
        speciesCache[key] = found
    end

    return found
end

--- The species for an element: `T` named by its storage witness, so
--- `array.uint32` is an `array.Scalar<uint32>` and `T` is inferred from an
--- ordinary argument. One argument asks for `Preferred`, the target's own
--- lane count; a second, a literal lane count, asks for `Fixed<N>`, which
--- names the count the algorithm needs without naming an instruction set and
--- may occupy several native registers to get it. Fixed counts must be
--- between 2 and 64.
---
--- There is always a species. Where the running code has vector registers
--- a preferred species is as wide as they are; where it has none -- the
--- scalar Wasm tier, or a body running as ordinary Lua under `aot = "off"`
--- -- it is one lane wide, and the same loop runs a lane at a time. A fixed
--- species is its N lanes wherever it runs. A species of another
--- element with the same lane count, whichever that is on the tier, is
--- `widen` or `narrow` of this one. So a kernel is written once:
---
--- ```nupp:fragment
--- local species = simd.species(array.float)
--- for at, active in species:over(#input) do
---     species:store(output, at, species:load(input, at, active) * factor, active)
--- end
--- ```
---
--- A kernel that wants a hand-written scalar loop instead, because a
--- species run as ordinary Lua is slower than plain Lua, asks
--- `simd.vectors` for the species, which is nil where there are none.
---
--- The lane count is decided when the enclosing `@aot` function is lowered,
--- once per artifact tier. The argument must be one of the standard
--- witnesses or an alias of one; the checker refuses any other expression.
--- @export
simd.species = (function(element: any, lanes: any): any
    return scalarSpecies(element, lanes)
end) as(
    function<T>(element: StorageWitness<T>): simd.Species<T, simd.Preferred>
    & function<T, const N: integer>(element: StorageWitness<T>, lanes: N): simd.Species<T, simd.Fixed<N>>
)

--- The species for an element where the running code has vectors, and nil
--- where it does not: the scalar Wasm tier, and a body running as ordinary
--- Lua, which takes this library body. It is `simd.species` for a kernel
--- that keeps a scalar continuation of its own, which it tests for:
---
--- ```nupp:fragment
--- if species = simd.vectors(array.uint32) then
---     while cursor + species.lanes <= #cps do
---         ...
---     end
--- end
--- while cursor < #cps and cps[cursor + 1] > 0xF do
---     cursor = cursor + 1
--- end
--- ```
---
--- Code that has no continuation asserts it, and on a tier without vectors
--- that assert is refused at compile time rather than left to fail at run
--- time; `simd.species` is the form that needs no assert.
--- @export
simd.vectors = (function(_element: any, _lanes: any): nil
    return nil
end) as(
    function<T>(element: StorageWitness<T>): simd.Species<T, simd.Preferred>?
    & function<T, const N: integer>(element: StorageWitness<T>, lanes: N): simd.Species<T, simd.Fixed<N>>?
)

@comptime
local function Transposed(Rows: typepack, Vector: type, Fixed: type): typepack
    const rows = nupp.types.elements(Rows)
    if #rows < 2 or #rows > 64 then
        return nupp.types.error("transpose needs between 2 and 64 fixed-width rows")
    end
    for i = 1, #rows do
        if not nupp.types.sameNominal(rows[i], Vector) then
            return nupp.types.error("transpose needs SIMD vector rows")
        end
        const args = nupp.types.arguments(rows[i])
        if not nupp.types.sameNominal(args[2], Fixed) then
            return nupp.types.error("transpose needs fixed-width rows")
        end
        if rows[i] ~= rows[1] then
            return nupp.types.error("transpose rows must have the same vector type")
        end
    end

    return Rows
end

--- Transposes a square tile of Fixed<N> row vectors into N column vectors.
--- All rows have the same element type; lane bits are preserved. Results are
--- separate native vectors, not a table, and cannot escape the AOT kernel.
--- @export
local transpose: function<Rows...>(
    ...: Rows...
): unpackof Transposed(Rows..., simd.Vector<uint32, simd.Fixed<2>>, simd.Fixed<2>) = function(...: any): any
    -- As ordinary Lua a preferred-species row is one lane, so the tile is
    -- its own transpose; fixed-species rows are transposed lane by lane.
    local first = ...
    local n = lanesOf(first)
    if n == nil then
        return ...
    end
    local count = select("#", ...)
    if count ~= n then
        error("transpose needs as many rows as the species has lanes", 2)
    end
    local rows = {...}
    local element = elementOf(first)
    local columns: {any} = {}
    for j = 1, n as integer do
        local lanes: {[integer]: any} = {}
        for i = 1, count do
            lanes[i] = laneAt(rows[i], j)
        end
        columns[j] = vectorOf(element, n as integer, lanes)
    end

    return unpack<any>(columns, 1, n as integer)
end

const simd.transpose = transpose

--- Named horizontal operations over an explicit register value.
---
--- Ordered operations follow logical lane order. Pairwise operations use the
--- adjacent-pair tree. Algebraic operations permit reassociation; only
--- `algebraicDot` additionally permits multiply-add contraction. Those three
--- orders are floating-point contracts, because addition rounds; the
--- wrapping, bitwise and integer extremum operations below are the integer
--- contracts, which answer the same under every association and so take one
--- name each.
--- @export
local horizontal = {}

--- The rounding an element's lanes fold under: binary32 for `float`, none
--- for `number`.
local function roundingOf(element: string): function(number): number
    if element == "float" then
        return nupp.math.f32.narrow
    end

    return keep
end

--- A named reduction over the lanes of an N-lane vector, in the order and
--- under the contract the name selects.
--- @raises string when the name is not a lane reduction
local function foldLanes(value: any, name: string): any
    local n = lanesOf(value) as integer
    local element = elementOf(value)
    local lanes = value as {[integer]: any}
    if name == "pairwiseSum" then
        local sum = new simd.PairwiseSum<number>(partials = {}, count = 0, round = roundingOf(element))
        for i = 1, n do
            sum:add(lanes[i] as number)
        end

        return sum:value()
    elseif name == "pairwiseProduct" then
        local product = new simd.PairwiseProduct<number>(partials = {}, count = 0, round = roundingOf(element))
        for i = 1, n do
            product:add(lanes[i] as number)
        end

        return product:value()
    end
    local total = lanes[1]
    for i = 2, n do
        local lane = lanes[i]
        if name == "orderedSum" or name == "algebraicSum" or name == "wrappingSum" then
            total = binaryLane("+", element, total, lane)
        elseif name == "orderedProduct" or name == "algebraicProduct" or name == "wrappingProduct" then
            total = binaryLane("*", element, total, lane)
        elseif name == "andBits" then
            total = binaryLane("&", element, total, lane)
        elseif name == "orBits" then
            total = binaryLane("|", element, total, lane)
        elseif name == "xorBits" then
            total = binaryLane("~", element, total, lane)
        elseif name == "propagatingMin" then
            total = extremum(total, lane, true, true)
        elseif name == "propagatingMax" then
            total = extremum(total, lane, false, true)
        elseif name == "numberMin" then
            total = extremum(total, lane, true, false)
        elseif name == "numberMax" then
            total = extremum(total, lane, false, false)
        elseif name == "integerMin" then
            total = integerLess(lane, total) and lane or total
        elseif name == "integerMax" then
            total = integerLess(total, lane) and lane or total
        else
            error("horizontal." .. name .. " is not a lane reduction", 3)
        end
    end

    return total
end

--- A named dot product over the lanes of two N-lane vectors.
local function foldDot(left: any, right: any, name: string): any
    local n = lanesOf(left) as integer
    local round = roundingOf(elementOf(left))
    if name == "pairwiseDot" then
        local sum = new simd.PairwiseSum<number>(partials = {}, count = 0, round = round)
        local dot = new simd.PairwiseDot<number>(sum = sum, round = round)
        for i = 1, n do
            dot:add(laneAt(left, i) as number, laneAt(right, i) as number)
        end

        return dot:value()
    end
    -- Ordered and algebraic alike: each product rounds, then joins the sum
    -- in lane order.
    local total = 0
    for i = 1, n do
        total = round(total + round((laneAt(left, i) as number) * (laneAt(right, i) as number)))
    end

    return total
end

--- The lowest lane holding the extremum the name selects, on the terms of
--- the reducer of that name.
local function argLane(value: any, name: string): integer
    local n = lanesOf(value) as integer
    local maximum = name == "propagatingArgMax" or name == "numberArgMax"
    local propagate = name == "propagatingArgMin" or name == "propagatingArgMax"
    local best = laneAt(value, 1) as number
    local position: integer = 1
    for i = 2, n do
        local candidate = laneAt(value, i) as number
        if extremumWins(candidate, best, maximum, propagate) then
            best = candidate
            position = i
        end
    end

    return position
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.orderedSum<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "orderedSum") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.pairwiseSum<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "pairwiseSum") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.algebraicSum<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "algebraicSum") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.orderedProduct<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "orderedProduct") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.pairwiseProduct<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "pairwiseProduct") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.algebraicProduct<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "algebraicProduct") as T
    end

    return value as T
end

--- As ordinary Lua the vectors are one lane each, which is the product.
--- @export
function horizontal.orderedDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    if lanesOf(left) ~= nil then
        return foldDot(left, right, "orderedDot") as T
    end
    return ((left as any) * (right as any)) as T
end

--- As ordinary Lua the vectors are one lane each, which is the product.
--- @export
function horizontal.pairwiseDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    if lanesOf(left) ~= nil then
        return foldDot(left, right, "pairwiseDot") as T
    end
    return ((left as any) * (right as any)) as T
end

--- As ordinary Lua the vectors are one lane each, which is the product.
--- @export
function horizontal.algebraicDot<T, S>(left: simd.Vector<T, S>, right: simd.Vector<T, S>): T
    if lanesOf(left) ~= nil then
        return foldDot(left, right, "algebraicDot") as T
    end
    return ((left as any) * (right as any)) as T
end

--- The smallest lane, and the largest, under the contract the name selects.
---
--- These take no order where the sums and products above take three: min and
--- max round nothing, so every association of them answers the same value and
--- three names would have named one answer. What they do take is the NaN
--- contract, for the same reason `Vector.propagatingMin` and `Vector.numberMin`
--- are separate names -- and each is the elementwise operation of that name,
--- folded over the lanes.
---
--- `propagatingMin` answers the canonical NaN when any lane is NaN, so its
--- answer does not depend on how many lanes the target chose. `numberMin`
--- answers the smallest lane that is not NaN, and the canonical NaN only when
--- every lane is. `-0` is the smaller zero under both.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.propagatingMin<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "propagatingMin") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.propagatingMax<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "propagatingMax") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.numberMin<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "numberMin") as T
    end

    return value as T
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.numberMax<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "numberMax") as T
    end

    return value as T
end

--- The one-based lane holding the matching reduction's answer.
---
--- The lowest such lane when several tie, which is the logical-index tie rule
--- every lane-selecting operation here uses. `propagatingArgMin` answers the
--- lowest NaN lane when any lane is NaN, because that is the lane whose element
--- is what `propagatingMin` answers; `numberArgMin` skips NaN lanes and answers
--- the lowest only when every lane is NaN. Either way the identity
--- `value:extract(horizontal.<name>ArgMin(value))` holds against the reduction
--- of the same name.
---
--- A lane index rather than a lane and its value, because an AOT expression
--- answers a value and `extract` already spells the pair.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- position; a fixed-species vector is searched.
--- @export
function horizontal.propagatingArgMin<T, S>(value: simd.Vector<T, S>): integer
    if lanesOf(value) ~= nil then
        return argLane(value, "propagatingArgMin")
    end

    return 1
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- position; a fixed-species vector is searched.
--- @export
function horizontal.propagatingArgMax<T, S>(value: simd.Vector<T, S>): integer
    if lanesOf(value) ~= nil then
        return argLane(value, "propagatingArgMax")
    end

    return 1
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- position; a fixed-species vector is searched.
--- @export
function horizontal.numberArgMin<T, S>(value: simd.Vector<T, S>): integer
    if lanesOf(value) ~= nil then
        return argLane(value, "numberArgMin")
    end

    return 1
end

--- As ordinary Lua a preferred-species vector is one lane, which is the
--- position; a fixed-species vector is searched.
--- @export
function horizontal.numberArgMax<T, S>(value: simd.Vector<T, S>): integer
    if lanesOf(value) ~= nil then
        return argLane(value, "numberArgMax")
    end

    return 1
end

--- The lanes of an integer vector summed, wrapping in the lane's own width: a
--- byte vector's sum wraps at a byte, as `simd.reducer.wrappingSum` wraps at
--- its element. Every association answers the same, so there is one name.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.wrappingSum<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "wrappingSum") as T
    end

    return value as T
end

--- The lanes of an integer vector multiplied, wrapping in the lane's width.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.wrappingProduct<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "wrappingProduct") as T
    end

    return value as T
end

--- The bitwise and of every lane of an integer vector.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.andBits<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "andBits") as T
    end

    return value as T
end

--- The bitwise or of every lane of an integer vector.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.orBits<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "orBits") as T
    end

    return value as T
end

--- The bitwise exclusive or of every lane of an integer vector.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.xorBits<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "xorBits") as T
    end

    return value as T
end

--- The smallest lane of an integer vector, by the element's signedness.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.integerMin<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "integerMin") as T
    end

    return value as T
end

--- The largest lane of an integer vector, by the element's signedness.
--- As ordinary Lua a preferred-species vector is one lane, which is the
--- reduction; a fixed-species vector is folded.
--- @export
function horizontal.integerMax<T, S>(value: simd.Vector<T, S>): T
    if lanesOf(value) ~= nil then
        return foldLanes(value, "integerMax") as T
    end

    return value as T
end

simd.horizontal = horizontal

export = simd
