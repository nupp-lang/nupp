@!internal

--[[
Implements the byte storage and reader/writer contracts exposed by [](io).
]]
module nupp.io

-- Public names are direct aliases; calls reach the implementation without
-- adapters.
const bytes = require("nupp.io.internal.bytes")

--- A forward-only byte source.
---
--- `io.Reader.of(source)` accepts a string, a byte queue, a buffer, or a view.
--- Buffers and views become independent snapshots; queues are drained as the
--- reader advances. A reader owns its close obligation and closes automatically
--- at the end of its scope unless `close()` consumes it earlier.
---
--- ```nupp
--- local reader = io.Reader.of("abcdef")
--- assert(reader:read(2) == "ab")
---
--- local destination = io.Buffer.create()
--- assert(reader:readinto(destination, 0, 3) == 3)
--- assert(destination:getstring() == "cde")
--- assert(reader:read(8) == "f")
--- assert(reader:read(8) == "") -- EOF
--- ```
---
--- `read(count)` requires a positive count and returns at most that many bytes.
--- It returns an empty string at EOF and nil with a reason after close.
--- `readspan(writable)` fills a positive-sized checked writable span.
--- `readinto(buffer, offset, count)` returns zero at EOF and reads 64 KiB when
--- given no count; an explicit count must be positive. A failed or EOF read
--- does not extend the destination. `transferto(writer)` copies the entire
--- remaining source and returns the byte count. `readall(maxbytes)` takes the
--- reader, closes it, and returns its remaining bytes as a string.
---
--- A read moves the reader's cursor as a write moves a writer's, so all four
--- take the reader exclusively. Two readers over one cursor, such as a stream
--- and a borrowed view of it, cannot both be reading at once; the checker
--- refuses the second while the first is live.
---
--- @export
export type Reader = bytes.Reader

--- @internal
export const Reader = bytes.readerdefaults

--- An appending byte sink implemented by buffers, files, and request bodies.
---
--- `io.Writer.of(buffer)` appends to the buffer through a forward-only writer
--- targeting it. A writer likewise closes automatically; `flush()` publishes
--- pending work without consuming that ownership. The writer holds its buffer
--- exclusively for as long as it is live, so the buffer is read once the writer
--- is gone:
---
--- ```nupp
--- local destination = io.Buffer.create()
--- do
---     local writer = io.Writer.of(destination)
---     assert(writer:write("prefix:"))
---
---     local payload = io.Buffer.create("body")
---     assert(writer:writespan(payload:readspan()) == 4)
---     assert(writer:flush())
--- end
--- assert(destination:getstring() == "prefix:body")
--- ```
---
--- `write` returns a boolean and `writespan` returns the byte count. Both
--- return a reason when the writer is closed or the destination was released.
--- The span is the common zero-copy input contract for buffers, views, files,
--- processes, and HTTP transfers; there is no unchecked raw-pointer writer
--- alongside it. `flush` does nothing for memory. It is part of the contract
--- because a file or socket buffers, and `flush` is where one reports a write
--- that failed to land: `close` returns nothing, so a caller that has to know
--- flushes first.
---
--- @export
export type Writer = bytes.Writer

--- @internal
export const Writer = bytes.writerdefaults

--- A FIFO byte source that a reader borrows without taking ownership.
---
--- A [](string.buffer) FIFO is a byte queue: `put` appends to the back and
--- `get` consumes from the front. `io.Reader.of(queue):scalar()` adapts one, so
--- bytes assembled there are read without copying everything in it first, and
--- the queue's own `get` stays usable over the same bytes.
---
--- ```nupp
--- local queue = string.buffer.new()
--- queue:put("header:")
--- queue:put("!")
---
--- local reader = io.Reader.of(queue):scalar()
--- assert(reader:readbytes(7) == "header:")
--- assert(queue:tostring() == "!")
--- assert(reader:readuint8() == 33)
--- ```
---
--- Reading drains the queue, and `remaining()` reports what it still holds.
--- `Reader.of` is the same bridge one layer down: it returns an ordinary
--- `Reader` over the queue, for `transferto`, `readinto`, and everything else
--- that contract already covers.
---
--- ```nupp
--- local destination = io.Buffer.create()
--- local queue = string.buffer.new()
--- queue:put("payload")
--- do
---     local reader = io.Reader.of(queue)
---     assert(reader:transferto(destination:writer()) == 7)
--- end
--- assert(destination:getstring() == "payload")
--- ```
---
--- Neither takes the queue over. Nothing here frees or closes it, and one read
--- to empty leaves an empty queue rather than a released one.
---
--- @export
export type ByteQueue = bytes.ByteQueue

--- An immutable snapshot of bytes.
---
--- A [](io.Buffer) creates one with `view(offset, count)`, and the snapshot
--- remains valid if the source changes or closes:
---
--- ```nupp
--- local buffer = io.Buffer.create("header-body")
--- local header = buffer:view(0, 6)
--- buffer:clear()
--- assert(header:getstring() == "header")
--- header:close()
--- ```
---
--- A view can make a smaller view, open its own snapshot reader, report its
--- byte length, copy to a string, borrow a checked span with `readspan()`, and
--- be closed. Its offsets are zero-based like a buffer's. The data and UTF-8
--- modules accept views, which is what keeps those APIs from being coupled to a
--- mutable buffer.
---
--- @export
export type ByteView = bytes.ByteView

--- An exclusive prepared region of a buffer. Its span may be written, then the
--- lease is committed with the number of bytes that actually landed. Dropping a
--- lease aborts it without changing the buffer's logical length.
--- @export
export type BufferWriteLease = bytes.BufferWriteLease

--- Growable byte storage.
---
--- Its pointer and logical length never escape separately. A buffer uses a
--- native array on LuaJIT or a rooted allocation in a Wasm application.
---
--- `Buffer.create()` creates an empty growable buffer. A string supplies initial
--- bytes; an integer reserves capacity without changing the length.
---
--- ```nupp
--- local bytes = io.Buffer.create("hello")
--- bytes:setstring("!", bytes:len())
--- assert(bytes:getstring() == "hello!")
--- ```
---
--- Buffer offsets are zero-based, as they are wherever a count is an offset
--- into storage rather than a position in a Lua string. See [Byte
--- positions](docs/learn/runtime/data/standard-library.md#byte-positions) for
--- the rule and where the other convention applies.
---
--- `getstring(offset, count)` copies a range. `setstring` overwrites from an
--- offset and grows the buffer as needed, filling any gap with zero bytes.
--- `clear` sets the length to zero without discarding capacity, and `resize`
--- truncates or zero-fills:
---
--- ```nupp
--- local bytes = io.Buffer.create("hello")
--- bytes:ensure(4096)
--- assert(bytes:capacity() >= 4096)
--- bytes:resize(3)
--- assert(bytes:getstring() == "hel")
--- ```
---
--- Capacity is the allocation, not a recorded number. Growing at least doubles
--- it, so appending through a writer costs amortized constant time per byte and
--- `capacity()` reports bytes that are actually held. `ensure` reserves at
--- least the minimum asked for.
---
--- `close()` releases the buffer's storage and returns nothing. Operations on a
--- released buffer raise.
---
--- `readspan()` borrows the initialized bytes without separating their pointer
--- from their length. Native producers write through `reservewrite(offset,
--- count)`; see [](io.BufferWriteLease) for committing or aborting a prepared
--- write.
---
--- @export
export type Buffer = bytes.Buffer

--- @internal
export const Buffer = bytes.Buffer

--- Why an io operation failed: a kind to branch on and a message to show.
---
--- It prints as its message, and joins text as its message does, so code that
--- treats a reason as text keeps working. Compare `kind` rather than matching
--- the message, which is the platform's own words and differs between them.
--- @export
export record Error
    --- What kind of failure an io operation met, the same on every platform.
    ---
    --- - `notfound`: the file, program, host or other name does not exist.
    --- - `permission`: the platform refused the operation to this process.
    --- - `timeout`: a deadline passed before the operation finished.
    --- - `refused`: the peer turned the connection away.
    --- - `closed`: the resource, or the far end of it, has already gone.
    --- - `invalid`: what was sent or received was not well formed.
    --- - `limit`: a size, count or capacity bound was reached.
    --- - `unsupported`: this platform or provider cannot do it at all.
    --- - `other`: anything else; the message says what.
    type Kind = "notfound"
        | "permission"
        | "timeout"
        | "refused"
        | "closed"
        | "invalid"
        | "limit"
        | "unsupported"
        | "other"

    --- Routes a child's standard error to a pipe, its parent, nothing, or stdout.
    type Mode = "pipe" | "inherit" | "null" | "stdout"

    --- What kind of failure it was.
    kind: Kind

    --- What happened, in the platform's or the module's words.
    message: string

    metamethod __tostring: function(self): string

    metamethod __concat: function(left: string | number | Error, right: string | number | Error): string
end

Error.__tostring = function(self: Error): string
    return self.message
end

Error.__concat = function(left: string | number | Error, right: string | number | Error): string
    return tostring(left) .. tostring(right)
end

-- The platform's words for each kind, most specific first. Matched against the
-- lowercased message, so the native providers' operating-system text, the
-- browser's DOMException names and this library's own reasons all land on the
-- same kind. The order matters where one message could match two: a refused
-- connection that timed out is a timeout.
local KIND_PATTERNS: {
    {string}
} = {
    {"timeout", "timed out"},
    {"timeout", "timeouterror"},
    {"timeout", "deadline"},
    {"notfound", "no such file"},
    {"notfound", "not found"},
    {"notfound", "notfounderror"},
    {"notfound", "cannot find"},
    {"notfound", "does not exist"},
    {"notfound", "no such host"},
    {"notfound", "failed to lookup address"},
    {"notfound", "name or service not known"},
    {"notfound", "nodename nor servname"},
    {"refused", "connection refused"},
    {"refused", "actively refused"},
    {"refused", "connectionrefused"},
    {"permission", "permission denied"},
    {"permission", "access is denied"},
    {"permission", "not permitted"},
    {"permission", "notallowederror"},
    {"permission", "securityerror"},
    {"closed", "broken pipe"},
    {"closed", "connection reset"},
    {"closed", "connection aborted"},
    {"closed", "is closed"},
    {"closed", "was closed"},
    {"closed", "no longer reading"},
    {"closed", "aborterror"},
    {"limit", "exceed"},
    {"limit", "too large"},
    {"limit", "too many"},
    {"limit", "too long"},
    {"limit", "quotaexceedederror"},
    {"limit", "no space"},
    {"limit", "capacity"},
    {"unsupported", "not supported"},
    {"unsupported", "unsupported"},
    {"unsupported", "notsupportederror"},
    {"invalid", "invalid"},
    {"invalid", "malformed"},
    {"invalid", "typemismatcherror"},
}

--- Returns the kind a failure message describes, or `other`.
---
--- For providers, which mostly have only a platform's text to go on.
--- @param message the platform's or the provider's words
--- @return the kind those words describe
--- @internal
export function classify(message: string): Error.Kind
    const lowered = message:lower()
    for _, entry in ipairs(KIND_PATTERNS) do
        if lowered:find(entry[2], 1, true) ~= nil then
            return entry[1] as Error.Kind
        end
    end

    return "other"
end

--- Makes an error from a provider's reason: an error as it is, text classified
--- by `classify` unless a kind is given, and nothing as nothing.
--- @param reason the provider's reason, if it gave one
--- @param kind the kind to use instead of classifying text
--- @return the error, or nil when there was no reason
--- @internal
export function toError(reason: string | Error | nil, kind: Error.Kind?): Error?
    if reason == nil then
        return nil
    end
    if reason is Error then
        return reason
    end
    const message = tostring(reason)

    return Error(kind = kind ?? classify(message), message = message)
end

--- Reads fixed-width numbers from a byte source.
---
--- `Reader:scalar()` takes a byte reader and adapts it; multi-byte values use
--- the machine's byte order.
---
--- ```nupp
--- local stored = io.Buffer.create()
--- do
---     local writer = stored:writer():scalar()
---     writer:writeuint32(1447383632):writefloat64(1.5)
--- end
--- local reader = stored:reader():scalar()
--- assert(reader:readuint32() == 1447383632)
--- assert(reader:readfloat64() == 1.5)
--- assert(reader:atend())
--- ```
---
--- Closing or dropping the adapter closes its byte reader. A short scalar read
--- raises.
---
--- #### Sources
---
--- Create a byte reader over a string, buffer, view, or queue, then adapt it:
---
--- ```nupp
--- local reader = io.Reader.of("\1\2\3\4"):scalar()
--- assert(reader:remaining() == 4)
--- ```
---
--- `remaining()` reports the bytes left in built-in string and queue readers,
--- including bytes buffered by the adapter. Open-ended readers return nil.
--- `atend()` checks whether a scalar reader has reached the end.
---
--- @export
export type ScalarReader = bytes.ScalarReader

--- Writes fixed-width numbers to a byte destination.
---
--- `Writer:scalar()` takes a byte writer and adapts it; multi-byte values use
--- the machine's byte order.
---
--- A scalar writer writes at its byte writer's current position. Creating a
--- buffer writer appends to the buffer; adapting that writer preserves its
--- position. The caller retains the buffer and reads it after the writer is
--- dropped:
---
--- ```nupp
--- local destination = io.Buffer.create()
--- do
---     local writer = destination:writer():scalar()
---     writer:writeuint8(33)
--- end
--- assert(destination:getstring() == "!")
--- ```
---
--- Closing or dropping the adapter closes its byte writer. Each write returns
--- the scalar writer so calls chain.
---
--- @export
export type ScalarWriter = bytes.ScalarWriter

--- Scalar reads and writes over one byte handle.
export type ScalarStream = bytes.ScalarStream

--- A reader that separates its source at `\n` and `\r\n`.
---
--- `Reader:lines(limit)` takes the source, and each `read()` returns a line
--- without its terminator.
---
--- ```nupp
--- local lines = io.Reader.of("one\r\ntwo\nlast"):lines()
--- assert(lines:read() == "one")
--- assert(lines:read() == "two")
--- assert(lines:read() == "last")
--- assert(lines:read() == nil) -- EOF
--- ```
---
--- The default limit is 64 KiB. An overlong line or source failure returns nil
--- with a reason. Closing or dropping the line reader closes the source it
--- took.
---
--- @export
export type Lines = bytes.Lines

--- Creates a buffer, optionally over starting bytes or a starting capacity.
---
--- The buffer is an owner, so it closes at its lexical boundary unless it is
--- transferred out of one. A number is a capacity to allocate rather than
--- content, and the buffer is still empty afterwards.
---
--- ```nupp
--- local buffer = io.Buffer.create("hello")
--- assert(buffer:len() == 5)
---
--- local sized = io.Buffer.create(4096)
--- assert(sized:len() == 0 and sized:capacity() == 4096)
--- ```
---
--- @param initial the starting bytes, a starting capacity, or nothing
--- @return the buffer, owned by the caller
--- @raises string when initial is neither bytes nor a capacity
--- @export
export const newBuffer = bytes.newBuffer

--- Opens a reader over bytes held as a string.
---
--- The reader is a `Reader` like any other, so a parser written against the
--- contract reads a string here and a file or a response body elsewhere without
--- changing:
---
--- ```nupp
---
--- local reader = io.Reader.of("hello")
--- assert(reader:read(5) == "hello")
--- assert(reader:read(1) == "")
--- ```
---
--- @param text the bytes to read
--- @return the reader, owned by the caller
--- @raises string when text is not a string
--- @export
export const newStringReader = bytes.newStringReader

--- Opens a byte reader over a string, queue, buffer, or view.
export const newReader = bytes.newReader

--- Opens a byte writer that appends and exclusively borrows a buffer.
export const newWriter = bytes.newWriter

--- Opens a reader over a byte queue, which it does not own.
---
--- Closing this reader leaves the queue behind it open, because the queue was
--- never transferred. A process stream and an HTTP response body are both byte
--- queues without naming this module.
---
--- @param source the queue to read from
--- @return the reader, owned by the caller
--- @raises string when source is not a byte queue
--- @export
export const newQueueReader = bytes.newQueueReader
