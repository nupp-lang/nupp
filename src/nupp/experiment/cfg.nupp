module nupp.experiment.cfg

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local envMod = require("nupp.compiler.project.env")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local cst = require("nupp.compiler.syntax.cst")
local lower = require("nupp.compiler.vm.lower")
local G = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")

-- The scalar fixture frontend: a closed subset of untyped functions lowered
-- to the production graph on value-class operations, so the graph image
-- carries constants, call windows, branches on values and park terminators.
-- Blocks explicitly pass every lexical binding; dead parameters are pruned
-- on the graph before either backend consumes it.
local ops = {["+"] = "Add", ["-"] = "Sub", ["*"] = "Mul", ["<"] = "Lt", ["<="] = "Le", ["=="] = "Eq"}

local function copy(t: any): any
    local out = {}
    for k, v in pairs(t) do
        out[k] = v
    end

    return out
end

local function qualified(n: any, base: string, member: string): boolean
    return n.kind == "dotIndex" and n.obj.kind == "name" and n.obj.token.text == base and n.name.text == member
end

local function reserved(name: string): nil
    assert(name ~= "string" and name ~= "coroutine", "intrinsic namespace shadowing is outside this experiment")
end

local function build(s: any): any
    assert(s.kind == "funcStmt" and not s.name.method, "plain exported function required")
    assert(#s.name == 3 and s.name.base.text == "m", "only m.name function declarations admitted")
    local body = s.body
    assert(
        not body.generics and #body.rets == 1 and cst.textOf(body.rets[1]):match("^%s*number%s*$"),
        "numeric non-generic result required"
    )
    local g = G.new(#body.params)
    g.name, g.module, g.sig, g.ret = "m." .. s.name[#s.name].text, "cfg.fixture", string.rep("v", #body.params), "v"
    local constants = {}

    local function constant(kind: string, value: any): integer
        local key = kind .. ":" .. tostring(value)
        local at = constants[key]
        if at == nil then
            g.constants[#g.constants + 1] = {kind = kind, value = value}
            at = #g.constants - 1
            constants[key] = at
        end

        return at
    end

    local b = G.block(g)
    b.names, b.env, b.held = {}, {}, {}

    local function emit(op: string, args: any, slot: integer?): integer
        return G.emit(g, b, op, args, nil, nil, slot) or 0
    end

    -- A name binds a value no other name holds, so block parameters on the
    -- same lexical slots never overlap.
    local function bind(name: string, v: integer): nil
        local held = b.held
        if (held[v] or 0) > 0 then
            v = emit("Move", {v})
        end
        held[v] = (held[v] or 0) + 1
        local old = b.env[name]
        if old then
            held[old] = held[old] - 1
        else
            b.names[#b.names + 1] = name
        end
        b.env[name] = v
    end

    local function unbind(name: string): nil
        local v = b.env[name]
        b.held[v] = b.held[v] - 1
        b.env[name] = nil
        assert(b.names[#b.names] == name)
        b.names[#b.names] = nil
    end

    local function newBlock(from: any, names: any): any
        local out = G.block(g)
        out.names, out.env, out.held = {}, {}, {}
        for i = 1, #names do
            local name = names[i]
            local source = from.env[name]
            local id = G.value(g, "v", g.slots[source])
            out.params[i] = id
            out.names[i] = name
            out.env[name] = id
            out.held[id] = 1
        end

        return out
    end

    local function edge(from: any, to: any): any
        local args = {}
        for i = 1, #to.names do
            args[i] = assert(from.env[to.names[i]], "missing edge binding")
        end

        return {target = to.id, args = args}
    end

    local function jump(from: any, to: any): nil
        from.term = {kind = "jump", edges = {edge(from, to)}}
    end

    local function branch(from: any, cond: integer, yes: any, no: any): nil
        from.term = {kind = "branch", value = cond, edges = {edge(from, yes), edge(from, no)}}
    end

    local types = {}
    for i, p in ipairs(body.params) do
        assert(not p.vararg and not p.modeTok, "plain parameters required")
        local spelling = cst.textOf(p.type):match("^%s*(.-)%s*$")
        assert(spelling == "number" or spelling == "string", "only number/string parameters admitted")
        reserved(p.name.text)
        bind(p.name.text, emit("Move", {i}))
        types[p.name.text] = spelling
    end

    local temporaries = 0

    local expr
    expr = function(n: any): (integer, string)
        if n.kind == "number" then
            local k = assert(tonumber(n.token.text), "unsupported numeric literal")
            return emit("K", {constant("num", k)}), "number"
        elseif n.kind == "name" then
            return assert(b.env[n.token.text], "unsupported free variable: " .. n.token.text), types[n.token.text]
        elseif n.kind == "paren" then
            return expr(n.expr)
        elseif n.kind == "unop" and n.op.text == "#" then
            local a, ty = expr(n.operand)
            assert(ty == "string", "only string length admitted")
            return emit("Len", {a}), "number"
        elseif n.kind == "binop" then
            -- This one normalized optional read keeps the subset scalar. It
            -- retains string.byte's one-based, negative and truncated indexes
            -- by calling the builtin through a window.
            local lhs = n.lhs
            if n.op.text == "or" and lhs.kind == "call" and qualified(lhs.obj, "string", "byte") then
                assert(n.rhs.kind == "number" and tonumber(n.rhs.token.text) == 0, "byte fallback must be zero")
                assert(#lhs.args.exprs == 2, "byte takes exactly two arguments")
                local a, aty = expr(lhs.args.exprs[1])
                local i, ity = expr(lhs.args.exprs[2])
                assert(aty == "string" and ity == "number", "byte argument types")
                local base: integer = g.counts.v
                g.counts.v = base + 4
                local callee = emit("K", {constant("builtin", "string.byte")}, base + 3)
                emit("Move", {a}, base + 1)
                emit("Move", {i}, base + 2)
                local r = emit("CallDyn", {callee, 2}, base)
                emit("PadResults", {base, 1})
                temporaries = temporaries + 1
                local name = "$byte" .. temporaries
                bind(name, r)
                local from = b
                local yes, no = newBlock(from, from.names), newBlock(from, from.names)
                branch(from, from.env[name], yes, no)
                b = no
                bind(name, emit("K", {constant("num", 0)}))
                local join = newBlock(yes, yes.names)
                from.region = {kind = "selection", merge = join.id}
                jump(yes, join)
                jump(no, join)
                b = join
                local out = b.env[name]
                unbind(name)
                return out, "number"
            end
            local op = assert(ops[n.op.text], "unsupported binary operator: " .. n.op.text)
            assert(not n.fixedArithmetic, "fixed-width arithmetic is outside this experiment")
            -- The right operand may move to a later block; the left one is
            -- read again there, through its name or a pinned temporary.
            local lhsName = n.lhs.kind == "name" and n.lhs.token.text or nil
            local a, aty = expr(n.lhs)
            local pinned: string? = nil
            if lhsName == nil then
                temporaries = temporaries + 1
                pinned = "$lhs" .. temporaries
                bind(pinned as string, a)
            end
            local rhs, rty = expr(n.rhs)
            if lhsName then
                a = b.env[lhsName]
            else
                a = b.env[pinned as string]
                unbind(pinned as string)
            end
            assert(aty == "number" and rty == "number", "numeric operands required")
            return emit(op, {a, rhs}), (op == "Add" or op == "Sub" or op == "Mul") and "number" or "boolean"
        end
        error("unsupported expression: " .. tostring(n.kind))
    end

    -- Evaluates a list of expressions, each pinned to a temporary while the
    -- rest are evaluated, so a later one moving to a new block does not
    -- strand an earlier value in its old block.
    local function values(exprs: any): (any, any)
        local ids, kinds, pins = {}, {}, {}
        for i, e in ipairs(exprs) do
            ids[i], kinds[i] = expr(e)
            temporaries = temporaries + 1
            pins[i] = "$value" .. temporaries
            bind(pins[i], ids[i])
        end
        for i = #exprs, 1, -1 do
            ids[i] = b.env[pins[i]]
            unbind(pins[i])
        end

        return ids, kinds
    end

    local statements
    statements = function(stats: any): nil
        for _, s in ipairs(stats) do
            assert(b, "unreachable statements are outside this experiment")
            if s.kind == "localStmt" then
                assert(not s.pattern and s.exprs and #s.exprs == #s.names, "one initializer per local required")
                local ids, kinds = values(s.exprs)
                for i, name in ipairs(s.names) do
                    reserved(name.text)
                    assert(b.env[name.text] == nil, "shadowing is outside this experiment")
                    bind(name.text, ids[i])
                    types[name.text] = kinds[i]
                end
            elseif s.kind == "assignStmt" then
                assert(#s.targets == #s.exprs, "parallel assignment arity")
                local ids, kinds = values(s.exprs)
                for i, target in ipairs(s.targets) do
                    assert(target.kind == "name" and b.env[target.token.text] ~= nil, "only local assignments admitted")
                    assert(types[target.token.text] == kinds[i], "changing local representation")
                    bind(target.token.text, ids[i])
                end
            elseif s.kind == "whileStmt" then
                local from = b
                local header = newBlock(from, from.names)
                jump(from, header)
                b = header
                local cond, cty = expr(s.cond)
                assert(cty == "boolean", "boolean loop condition required")
                assert(b == header, "loop condition must stay in the header")
                local loop, after = newBlock(header, header.names), newBlock(header, header.names)
                branch(header, cond, loop, after)
                b = loop
                statements(s.body.stats)
                assert(b, "loop body must fall through")
                local continuing = newBlock(b, header.names)
                jump(b, continuing)
                jump(continuing, header)
                header.region = {kind = "loop", merge = after.id, continuing = continuing.id}
                b = after
            elseif s.kind == "ifStmt" then
                assert(#s.clauses == 1 and not s.clauses[1].binding, "only one plain if clause admitted")
                local cond, cty = expr(s.clauses[1].cond)
                assert(cty == "boolean", "boolean branch condition required")
                local from = b
                local names = copy(from.names)
                local yes, no = newBlock(from, names), newBlock(from, names)
                branch(from, cond, yes, no)
                b = yes
                statements(s.clauses[1].body.stats)
                yes = b
                b = no
                if s.elseClause then
                    statements(s.elseClause.body.stats)
                end
                no = b
                if yes or no then
                    local join = newBlock(yes or no, names)
                    from.region = {kind = "selection", merge = join.id}
                    if yes then
                        jump(yes, join)
                    end
                    if no then
                        jump(no, join)
                    end
                    b = join
                else
                    b = nil
                end
            elseif s.kind == "returnStmt" then
                assert(#s.exprs == 1, "one result required")
                local v, ty = expr(s.exprs[1])
                assert(ty == "number", "numeric result required")
                b.term = {kind = "return", value = v, edges = {}}
                b = nil
            elseif s.kind == "callStmt" and s.expr.kind == "call" and qualified(s.expr.obj, "coroutine", "yield") then
                assert(#s.expr.args.exprs == 1, "one yielded value required")
                local v, ty = expr(s.expr.args.exprs[1])
                assert(ty == "number", "numeric yield required")
                local resume = newBlock(b, b.names)
                b.term = {kind = "park", value = v, edges = {edge(b, resume)}}
                b = resume
            else
                error("unsupported statement: " .. tostring(s.kind))
            end
        end
    end

    statements(body.body.stats)
    assert(not b, "function must return")
    G.prune(g)

    return g
end

local function graphsFrom(root: any): any
    local graphs = {}
    assert(#root.blocks == 1, "one syntax recovery region required")
    local stats = root.blocks[1].stats
    assert(#stats >= 3, "closed fixture module required")
    for i, s in ipairs(stats) do
        if i == 1 then
            assert(
                s.kind == "localStmt"
                and #s.names == 1
                and s.names[1].text == "m"
                and s.exprs
                and #s.exprs == 1
                and s.exprs[1].kind == "tableExpr"
                and #s.exprs[1].fields == 0,
                "module must start with local m = {}"
            )
        elseif i == #stats then
            assert(
                s.kind == "returnStmt" and #s.exprs == 1 and s.exprs[1].kind == "name" and s.exprs[1].token.text == "m",
                "module must end with return m"
            )
        else
            graphs[#graphs + 1] = build(s)
        end
    end

    return graphs
end

local driver = {}

function driver.main(argv: {string}): integer
    local input, output = assert(argv[1]), assert(argv[2])
    local f = assert(io.open(input, "rb"))
    local source = f:read("*a")
    f:close()
    trivia.installDefault(provider)
    local start = os.clock()
    local parsed = parser.parse(source, input)
    assert(#parsed.errors == 0, "input parse failed")
    local env = envMod.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
    local diagnostics = checker.check(parsed, input, env as any, {})
    for _, d in ipairs(diagnostics) do
        assert(d.severity and d.severity ~= "error", tostring(d.code) .. ": " .. tostring(d.msg))
    end
    local checked = os.clock()
    -- Admission tests run after the measured checker phase. Unsupported syntax
    -- must fail explicitly instead of silently falling back to old lowering.
    local rejected = {
        'local m = {} function m.bad(x: number): number return x .. "wrong" end return m',
        'local m = {} function m.bad(x: number): number return math.sqrt(x) end return m',
        'local m = {} function m.bad(string: number): number return string end return m',
        'local m = {} function m.bad(x: number): number if x < 0 then local x = 1 return x end return x end return m',
    }
    for _, bad in ipairs(rejected) do
        local tree = parser.parse(bad, "cfg-rejected.nupp")
        assert(#tree.errors == 0)
        local badEnv = envMod.new(".", {memoryOnly = true, cache = false, nativeCompilerServices = false})
        local diags = checker.check(tree, "cfg-rejected.nupp", badEnv as any, {})
        local failed = false
        for _, d in ipairs(diags) do
            failed = failed or not d.severity or d.severity == "error"
        end
        if not failed then
            local ok = pcall(graphsFrom, tree.root)
            assert(not ok, "unsupported source was admitted")
        end
    end

    local function old(): string
        return lower.emit(
            "cfg.fixture",
            {},
            function(name: string): string?
                return name == "cfg.fixture" and input or nil
            end,
            function(name: string, path: string): table
                assert(name == "cfg.fixture" and path == input)
                return parsed.root
            end
        )
    end

    local graphSamples, encodeSamples, oldSamples = {}, {}, {}
    local binary, image = "", ""
    for round = 1, 13 do
        local gTime, eTime, oTime = 0, 0, 0

        local function current(): nil
            local before = os.clock()
            local graphs = graphsFrom(parsed.root)
            local after = os.clock()
            local encoded = graphimage.encode({functions = graphs})
            local done = os.clock()
            assert(binary == "" or binary == encoded, "graph changed across identical lowerings")
            binary = encoded
            gTime, eTime = (after - before) * 1000, (done - after) * 1000
        end

        local function baseline(): nil
            local before = os.clock()
            local encoded = old()
            oTime = (os.clock() - before) * 1000
            assert(image == "" or image == encoded, "baseline image changed across identical lowerings")
            image = encoded
        end

        if round % 2 == 0 then
            current()
            baseline()
        else
            baseline()
            current()
        end
        if round > 2 then
            graphSamples[#graphSamples + 1] = gTime
            encodeSamples[#encodeSamples + 1] = eTime
            oldSamples[#oldSamples + 1] = oTime
        end
    end

    local function write(suffix: string, content: string): nil
        local file = assert(io.open(output .. suffix, "wb"))
        file:write(content)
        file:close()
    end

    write(".graph", binary)
    write(".image", image)
    -- `--replicate N`: a checker-sized image, the fixture's functions N
    -- times over under distinct names, for timing decode plus derive
    -- against the text parse of the compiler's own image.
    if argv[3] == "--replicate" then
        local copies = assert(tonumber(argv[4]), "replication count")
        local functions = {}
        for round = 1, copies do
            local graphs = graphsFrom(parsed.root)
            for _, g in ipairs(graphs) do
                g.name = g.name .. "_" .. round
                functions[#functions + 1] = g
            end
        end
        write("-replicated.graph", graphimage.encode({functions = functions}))
    end

    local function numbers(values: any): string
        local text = {}
        for _, v in ipairs(values) do
            text[#text + 1] = string.format("%.6f", v)
        end

        return "[" .. table.concat(text, ",") .. "]"
    end

    local report = string.format(
        '{"check_ms":%.6f,"graph_lower_ms":%s,"graph_encode_ms":%s,"existing_lower_and_text_ms":%s}',
        (checked - start) * 1000,
        numbers(graphSamples),
        numbers(encodeSamples),
        numbers(oldSamples)
    )
    write(".frontend.json", report)
    print(report)

    return 0
end

export = driver
