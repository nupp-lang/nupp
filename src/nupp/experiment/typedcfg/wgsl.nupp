module nupp.experiment.typedcfg.wgsl

local maps = require("nupp.compiler.vm.maps")
local regions = require("nupp.compiler.vm.regions")
local wgsl = {}
local VALUE_NAMES: {string} = {}

-- The graph is consumed directly, with the existing GPU buffer/uniform ABI.
-- Edges assign block parameters simultaneously; no slot hints are needed here.

function wgsl.emit(g: any, symbol: string, verified: any?): (string, any)
    local abi = verified or maps.verify(g)
    -- One flat buffer of pieces, joined once. A line is its indent, its
    -- text and a newline; nothing is concatenated per line.
    local parts, n, depth = {}, 0, 0
    local indents = {[0] = "", "    ", "        ", "            ", "                ", "                    "}

    local function line(s: string): nil
        parts[n + 1], parts[n + 2], parts[n + 3] = indents[depth] or string.rep("    ", depth), s, "\n"
        n = n + 3
    end

    -- Value names are fixed per id, so they are spelled once per process.
    local names = {}
    for id = 1, #g.types do
        assert(g.types[id] == "i", "uint32 map value class")
        local name = VALUE_NAMES[id]
        if not name then
            name = "v" .. id
            VALUE_NAMES[id] = name
        end
        names[id] = name
    end
    -- A parameter of a block with one incoming edge that is not a loop exit
    -- is its source value under another name: the source is bound in an
    -- enclosing scope of the target's text, so the parameter needs no
    -- variable and the edge no assignment. Loop exits leave the loop's
    -- scope, and joins have several sources, so those stay variables.
    local blocks = g.blocks
    local incoming, exitTarget, aliased = {}, {}, {}
    for i = 1, #blocks do
        local b = blocks[i]
        local edges = b.term.edges
        for j = 1, #edges do
            local t = edges[j].target
            incoming[t] = (incoming[t] or 0) + 1
        end
        if b.region and b.region.kind == "loop" then
            exitTarget[b.region.merge] = true
        end
    end
    for i = 1, #blocks do
        local edges = blocks[i].term.edges
        for j = 1, #edges do
            local e = edges[j]
            if incoming[e.target] == 1 and not exitTarget[e.target] then
                local params, args = blocks[e.target].params, e.args
                for k = 1, #params do
                    aliased[params[k]] = args[k]
                end
            end
        end
    end
    -- Resolved once all aliases are known, so chains end at a bound value.
    for id = 1, #g.types do
        local v = id
        while aliased[v] do
            v = aliased[v]
        end
        if v ~= id then
            names[id] = names[v]
        end
    end

    local function buffer(p: integer): string
        return "buffer_" .. p
    end

    local function count(p: integer): string
        return "uniforms.count_" .. p
    end

    local function offset(p: integer): string
        return "uniforms.offset_" .. p
    end

    line("struct Uniforms {")
    depth = 1
    line("count: u32,")
    for at47 = 1, #abi.spans do
        local p = abi.spans[at47]
        line("count_" .. p .. ": u32,")
    end
    for at48 = 1, #abi.spans do
        local p = abi.spans[at48]
        line("offset_" .. p .. ": u32,")
    end
    for at49 = 1, #abi.uniforms do
        local p = abi.uniforms[at49]
        line("param_" .. p .. ": u32,")
    end
    depth = 0
    line("}")
    for i = 1, #abi.spans do
        local p = abi.spans[i]
        line(
            string.format(
                "@group(0) @binding(%d) var<storage, %s> %s: array<u32>;",
                i - 1,
                g.parameters[p].write and "read_write" or "read",
                buffer(p)
            )
        )
    end
    line(
        string.format(
            "@group(0) @binding(%d) var<uniform> uniforms: Uniforms;\n@compute @workgroup_size(256)\nfn %s(@builtin(global_invocation_id) global_id: vec3<u32>, @builtin(num_workgroups) groups: vec3<u32>) {\n    let row_width = groups.x * 256u;\n    if (global_id.y > uniforms.count / row_width || (global_id.y == uniforms.count / row_width && global_id.x >= uniforms.count %% row_width)) { return; }\n    let dispatch_index = global_id.y * row_width + global_id.x;",
            #abi.spans,
            symbol
        )
    )
    depth = 1
    -- Retain the map's count preconditions on the device. The host remains
    -- responsible for validating storage extents and view offsets.
    for at51 = 1, #abi.spans do
        local p = abi.spans[at51]
        line("if (" .. count(p) .. " != uniforms.count) { return; }")
    end
    -- Only block parameters are assigned on edges, so only they are
    -- variables; every instruction result is bound once where it is defined.
    local declared, nd = {}, 0
    for i = 1, #blocks do
        local params = blocks[i].params
        for j = 1, #params do
            local p = params[j]
            if not aliased[p] then
                nd = nd + 1
                declared[nd] = names[p]
            end
        end
    end
    if nd > 0 then
        line("var " .. table.concat(declared, ": u32; var ") .. ": u32;")
    end

    -- An edge's arguments are values of its source block and its targets are
    -- parameters defined by the target block, so no target is ever a source
    -- of the same edge and the assignments need no temporaries.
    local function copies(e: any): nil
        local params = blocks[e.target].params
        if aliased[params[1]] then
            return
        end
        for i = 1, #e.args do
            line(names[params[i]] .. " = " .. names[e.args[i]] .. ";")
        end
    end

    local binary = {U32Add = "+", U32Sub = "-", IAnd = "&", IOr = "|"}
    local compare = {ICmpEq = "==", ICmpNe = "!=", ICmpLt = "<", ICmpLe = "<="}

    local function instructions(b: any): nil
        for i = 1, #b.op do
            local op = b.op[i]
            local a, result = b.args[i], nil
            if op == "IK" then
                result = tostring(a[1]) .. "u"
            elseif op == "IUnbox" then
                result = "uniforms.param_" .. a[1]
            elseif op == "SpanLen" then
                result = count(a[1])
            elseif op == "IMov" then
                result = names[a[1]]
            elseif op == "IAddK" then
                result = string.format("%s + %du", names[a[1]], a[2])
            elseif binary[op] then
                result = string.format("%s %s %s", names[a[1]], binary[op], names[a[2]])
            elseif compare[op] then
                result = string.format("select(0u, 1u, %s %s %s)", names[a[1]], compare[op], names[a[2]])
            elseif op == "U32Load" then
                result = string.format("%s[%s + %s]", buffer(a[1]), offset(a[1]), names[a[2]])
            elseif op == "U32Store" then
                line(string.format("%s[%s + %s] = %s;", buffer(a[1]), offset(a[1]), names[a[2]], names[a[3]]))
            elseif op == "SpanEqual" then
                line(string.format("if (%s != %s) { return; }", count(a[1]), count(a[2])))
            else
                error("unhandled map operation: " .. op)
            end
            if result then
                line(string.format("let %s = %s;", names[b.dst[i]], result))
            end
        end
    end

    local events = abi.events or regions.events(g)
    local kinds, eventBlocks, eventEdges = events.kinds, events.blocks, events.edges
    local header, continuing = g.map.header, g.map.continuing
    for i = 1, events.count do
        local event, b = kinds[i], eventBlocks[i]
        if event == "block" then
            if b.id ~= continuing then
                instructions(b)
            end
        elseif event == "edge" then
            if b.id ~= continuing then
                copies(eventEdges[i])
            end
        elseif event == "loop" then
            if b.id == header then
                line(names[g.map.index] .. " = dispatch_index;")
            else
                line("loop {");
                depth = depth + 1
            end
        elseif event == "exit" then
            line("if (" .. names[b.term.value] .. " == 0u) {");
            depth = depth + 1
            copies(eventEdges[i])
            line(b.id == header and "return;" or "break;")
            depth = depth - 1;
            line("}")
        elseif event == "endloop" then
            if b.id ~= header then
                depth = depth - 1;
                line("}")
            end
        elseif event == "if" then
            line("if (" .. names[b.term.value] .. " != 0u) {");
            depth = depth + 1
        elseif event == "else" then
            depth = depth - 1;
            line("} else {");
            depth = depth + 1
        elseif event == "endif" then
            depth = depth - 1;
            line("}")
        else
            line("return;")
        end
    end
    depth = 0;
    line("}")

    return table.concat(parts), abi
end

export = wgsl
