module nupp.experiment.typedcfg.graph

-- Closed blocks, with SSA value IDs distinct from physical slot hints. The
-- executable stream is a derived cache; edges remain explicit until layout.
local graph = {}
local signatures = {
    U32Load = "I#i",
    U32Store = "-#ii",
    U32Add = "Iii",
    U32Sub = "Iii",
    SpanEqual = "-###",
    IK = "I#",
    FK = "F#",
    IUnbox = "I#",
    FUnbox = "F#",
    SpanLen = "I##",
    IMov = "Ii",
    FMov = "Ff",
    VMov = "Xx",
    IToF = "Fi",
    FToI = "If",
    IMaskU32 = "Ii",
    IAdd = "Iii",
    IAddK = "Ii#",
    ISub = "Iii",
    IAnd = "Iii",
    IOr = "Iii",
    ICmpEq = "Iii",
    ICmpNe = "Iii",
    ICmpLt = "Iii",
    ICmpLe = "Iii",
    ICmpSLt = "Iii",
    ICmpSLe = "Iii",
    FAdd = "Fff",
    FSub = "Fff",
    FMul = "Fff",
    FDiv = "Fff",
    FNeg = "Ff",
    FCmpEq = "Iff",
    FCmpNe = "Iff",
    FCmpLt = "Iff",
    FCmpLe = "Iff",
    VSplatN = "Xf#",
    VSplatI = "Xi#",
    VExtractN = "Fx##",
    VAny = "Ix",
    VPrefix = "Xi###",
    VOp = "X##xxx",
    SpanBounds = "-#ii##",
    SpanLoad = "X#ii###",
    SpanStore = "-#ixi###"
}

function graph.new(nparams: integer): any
    return {nparams = nparams, blocks = {}, types = {}, slots = {}, counts = {i = 0, f = 0, x = 0}, constants = {}}
end

function graph.value(g: any, ty: string, slot: integer?): integer
    local id = #g.types + 1
    if slot == nil then
        slot = g.counts[ty]
        g.counts[ty] = (slot as integer) + 1
    end
    g.types[id], g.slots[id] = ty, slot

    return id
end

function graph.block(g: any): any
    local b = {id = #g.blocks + 1, params = {}, keys = {}, op = {}, dst = {}, args = {}}
    g.blocks[b.id] = b
    return b
end

function graph.emit(g: any, b: any, op: string, args: any): integer?
    local sig = assert(signatures[op], "unknown graph operation: " .. op)
    assert(#args == #sig - 1, "graph operation arity: " .. op)
    local class = sig:sub(1, 1)
    local id = class ~= "-" and graph.value(g, class:lower()) or nil
    local at = #b.op + 1
    b.op[at], b.dst[at], b.args[at] = op, id or 0, args

    return id
end

function graph.verify(g: any): nil
    assert(#g.blocks > 0 and #g.blocks <= 100000 and #g.types == #g.slots)
    assert(g.nparams >= 0 and g.nparams < 240)
    local defined = {}
    for index, b in ipairs(g.blocks) do
        assert(b.id == index and #b.op == #b.dst and #b.op == #b.args)
        local localValues, occupied = {}, {}

        local function define(v: integer): nil
            assert(g.types[v] and not defined[v], "duplicate graph definition")
            local ty, slot = g.types[v], g.slots[v]
            assert(g.counts[ty] and slot >= 0 and slot % 1 == 0 and slot < g.counts[ty])
            local key = ty .. slot
            assert(not occupied[key], "overlapping graph slot hints")
            occupied[key] = true
            defined[v], localValues[v] = true, true
        end

        local function use(v: integer, ty: string?): nil
            assert(localValues[v], "graph use outside its closed block")
            assert(not ty or g.types[v] == ty, "graph value class mismatch")
        end

        for _, v in ipairs(b.params) do
            define(v)
        end
        if index == 1 then
            assert(#b.params == 0, "entry parameters come from the frame")
        end
        for i, op in ipairs(b.op) do
            local sig = assert(signatures[op], "unknown graph operation")
            local args = b.args[i]
            assert(#args == #sig - 1, "graph operation arity")
            for j, v in ipairs(args) do
                local ty = sig:sub(j + 1, j + 1)
                if ty ~= "#" then
                    use(v, ty)
                end
            end
            if sig:sub(1, 1) ~= "-" then
                assert(g.types[b.dst[i]] == sig:sub(1, 1):lower())
                define(b.dst[i])
            else
                assert(b.dst[i] == 0)
            end
        end
        local t = assert(b.term, "unterminated graph block")
        assert(t.kind == "jump" or t.kind == "branch" or t.kind == "return" or t.kind == "raise")
        if t.kind == "branch" then
            use(t.value, "i")
        end
        if t.kind == "return" and t.value then
            use(t.value, "f")
        end
        assert(#t.edges == (t.kind == "branch" and 2 or t.kind == "jump" and 1 or 0))
        for _, e in ipairs(t.edges) do
            local target = assert(g.blocks[e.target], "bad graph target")
            assert(e.target ~= 1 and #e.args == #target.params, "bad graph edge arity")
            for i, v in ipairs(e.args) do
                use(v, g.types[target.params[i]])
            end
        end
    end
    for v = 1, #g.types do
        assert(defined[v], "undefined graph value")
    end
end

-- Remove unused transported state without introducing cross-block uses. Every
-- instruction remains, including operations whose bounds or conversion can fail.
function graph.prune(g: any): nil
    local incoming, used, work = {}, {}, {}

    local function mark(v: integer): nil
        if not used[v] then
            used[v] = true;
            work[#work + 1] = v
        end
    end

    for _, b in ipairs(g.blocks) do
        for i, op in ipairs(b.op) do
            local sig = signatures[op]
            for j, v in ipairs(b.args[i]) do
                if sig:sub(j + 1, j + 1) ~= "#" then
                    mark(v)
                end
            end
        end
        if b.term.value then
            mark(b.term.value)
        end
        for _, e in ipairs(b.term.edges) do
            for i, param in ipairs(g.blocks[e.target].params) do
                incoming[param] = incoming[param] or {}
                local inputs = incoming[param]
                inputs[#inputs + 1] = e.args[i]
            end
        end
    end
    local at = 1
    while at <= #work do
        for _, v in ipairs(incoming[work[at]] or {}) do
            mark(v)
        end
        at = at + 1
    end
    for _, b in ipairs(g.blocks) do
        for _, e in ipairs(b.term.edges) do
            local args = {}
            for i, param in ipairs(g.blocks[e.target].params) do
                if used[param] then
                    args[#args + 1] = e.args[i]
                end
            end
            e.args = args
        end
    end
    local remap, types, slots = {}, {}, {}

    local function keep(v: integer): integer
        local id = #types + 1
        remap[v], types[id], slots[id] = id, g.types[v], g.slots[v]
        return id
    end

    for _, b in ipairs(g.blocks) do
        local params = {}
        for _, v in ipairs(b.params) do
            if used[v] then
                params[#params + 1] = keep(v)
            end
        end
        b.params, b.keys = params, {}
        b.env, b.names, b.facts = nil, nil, nil
        for i, v in ipairs(b.dst) do
            if v ~= 0 then
                b.dst[i] = keep(v)
            end
        end
    end
    for _, b in ipairs(g.blocks) do
        for i, op in ipairs(b.op) do
            local sig = signatures[op]
            for j, v in ipairs(b.args[i]) do
                if sig:sub(j + 1, j + 1) ~= "#" then
                    b.args[i][j] = assert(remap[v])
                end
            end
        end
        if b.term.value then
            b.term.value = assert(remap[b.term.value])
        end
        for _, e in ipairs(b.term.edges) do
            for i, v in ipairs(e.args) do
                e.args[i] = assert(remap[v])
            end
        end
    end
    if g.map then
        g.map.index = assert(remap[g.map.index])
        g.map.count = assert(remap[g.map.count])
    end
    g.types, g.slots = types, slots
end

function graph.lower(g: any): any
    graph.verify(g)
    local code, starts, patches = {}, {}, {}
    local lengthSlots = {}
    for i, op in ipairs(g.blocks[1].op) do
        if op == "SpanLen" then
            lengthSlots[g.blocks[1].args[i][1]] = g.slots[g.blocks[1].dst[i]]
        end
    end

    local function emit(...: any): integer
        code[#code + 1] = {...}
        return #code
    end

    local function jump(target: integer): nil
        patches[#patches + 1] = {at = emit("Jmp", 0), target = target}
    end

    local function copies(e: any, fallthrough: number?): nil
        for _, ty in ipairs({"i", "f", "x"}) do
            local pending = {}
            for i, dst in ipairs(g.blocks[e.target].params) do
                local src = e.args[i]
                if g.types[dst] == ty and g.slots[dst] ~= g.slots[src] then
                    assert(pending[g.slots[dst]] == nil, "conflicting preferred slots")
                    pending[g.slots[dst]] = g.slots[src]
                end
            end
            local move = ty == "i" and "IMov" or ty == "f" and "FMov" or "VMov"
            while next(pending) ~= nil do
                local sources = {}
                for _, src in pairs(pending) do
                    sources[src] = true
                end
                local progress = false
                for dst, src in pairs(pending) do
                    if not sources[dst] then
                        emit(move, dst, src);
                        pending[dst] = nil;
                        progress = true
                    end
                end
                if not progress then
                    local dst = next(pending)
                    emit(move, g.counts[ty], dst)
                    for target, src in pairs(pending) do
                        if src == dst then
                            pending[target] = g.counts[ty]
                        end
                    end
                end
            end
        end
        if e.target ~= fallthrough then
            jump(e.target)
        end
    end

    for _, b in ipairs(g.blocks) do
        starts[b.id] = #code + 1
        for i, op in ipairs(b.op) do
            local sig, ins = signatures[op], {op == "VSplatI" and "VSplatN" or op}
            if b.dst[i] ~= 0 then
                ins[#ins + 1] = g.slots[b.dst[i]]
            end
            for j, arg in ipairs(b.args[i]) do
                ins[#ins + 1] = sig:sub(j + 1, j + 1) == "#" and arg or g.slots[arg]
            end
            -- VOp's VM order puts its opcode and element kind before dst.
            if op == "VOp" then
                ins[2], ins[3], ins[4] = ins[3], ins[4], ins[2]
            end
            if op == "U32Add" or op == "U32Sub" then
                emit(op == "U32Add" and "IAdd" or "ISub", ins[2], ins[3], ins[4])
                emit("IMaskU32", ins[2], ins[2])
            elseif op == "U32Load" or op == "U32Store" then
                local store = op == "U32Store"
                local param, index = ins[store and 2 or 3], ins[store and 3 or 4]
                local scratch, vector = g.counts.i, g.counts.x
                emit("IK", scratch, 1)
                emit("SpanBounds", param, index, scratch, 4, store and 1 or 0)
                if store then
                    emit("VSplatN", vector, ins[4], 4)
                    emit("SpanStore", param, index, vector, scratch, 4, 0, 1)
                else
                    emit("SpanLoad", vector, param, index, scratch, 4, 0, 1)
                    emit("VExtractN", ins[2], vector, 4, 0)
                end
            elseif op == "SpanEqual" then
                local scratch = g.counts.i
                emit("ICmpNe", scratch, assert(lengthSlots[ins[2]]), assert(lengthSlots[ins[3]]))
                emit("JmpIfIZero", scratch, 1)
                emit("Raise", ins[4])
            else
                code[#code + 1] = ins
            end
        end
        local t = b.term
        if t.kind == "jump" then
            copies(t.edges[1], b.id + 1)
        elseif t.kind == "branch" then
            local identity = true
            for i, dst in ipairs(g.blocks[t.edges[2].target].params) do
                identity = identity and g.slots[dst] == g.slots[t.edges[2].args[i]]
            end
            if identity then
                patches[
                    #patches + 1
                ] = {at = emit("JmpIfIZero", g.slots[t.value], 0), target = t.edges[2].target, field = 3}
                copies(t.edges[1], b.id + 1)
            else
                local branch = emit("JmpIfIZero", g.slots[t.value], 0)
                copies(t.edges[1])
                code[branch][3] = #code - branch
                copies(t.edges[2], b.id + 1)
            end
        elseif t.kind == "raise" then
            emit("Raise", t.constant)
        elseif t.value then
            emit("FBox", g.nparams + 1, g.slots[t.value]);
            emit("Ret", g.nparams + 1)
        else
            emit("RetNil")
        end
    end
    for _, p in ipairs(patches) do
        code[p.at][p.field or 2] = starts[p.target] - p.at - 1
    end
    assert(g.counts.i < 239 and g.counts.f < 239 and g.counts.x < 249, "graph register capacity")

    return {
        code = code,
        consts = g.constants,
        nregs = g.nparams + 2,
        nfregs = math.max(g.counts.i, g.counts.f) + (g.map and 2 or 1),
        nvregs = g.counts.x + 1,
        graph = g
    }
end

export = graph
