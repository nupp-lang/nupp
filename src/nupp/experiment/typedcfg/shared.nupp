module nupp.experiment.typedcfg.shared

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local envMod = require("nupp.compiler.project.env")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local frontend = require("nupp.compiler.vm.kernels")
local graph = require("nupp.compiler.vm.graph")
local maps = require("nupp.compiler.vm.maps")
local wgsl = require("nupp.compiler.gpu.wgsl")
local spirv = require("nupp.compiler.gpu.spirv")
local project = require("nupp.tools.vm.project")
local shared = {}

local function write(path: string, text: string): nil
    local file = assert(io.open(path, "wb"));
    file:write(text);
    file:close()
end

function shared.main(argv: {string}): integer
    local path, output = assert(argv[1]), assert(argv[2])
    if argv[3] == "emit" then
        write(output, project.emit(path, "nupp.tests.sharedcfg"))
        return 0
    end
    trivia.installDefault(provider)
    local root = assert(envMod.compilerRoot())
    local env = envMod.new(root, {cache = false, nativeCompilerServices = false})
    envMod.ensureProjectIndex(env)
    table.insert(assert(env.roots), 1, root .. "/native/crates/vm/lib")
    table.insert(assert(env.roots), 1, root .. "/native/crates/vm/decls")
    local file = assert(io.open(path, "rb"));
    local source = file:read("*a");
    file:close()
    local parsed = parser.parse(source, path)
    assert(#parsed.errors == 0)
    local diagnostics = checker.check(parsed, path, env as any, {})
    for _, d in ipairs(diagnostics) do
        assert(d.severity and d.severity ~= "error", tostring(d.code) .. ": " .. tostring(d.msg))
    end
    local bodies = {}

    local function walk(n: any): nil
        if n.kind == "localFuncStmt" then
            bodies[#bodies + 1] = {name = n.name.text, body = n.body};
            return
        end
        if n.kind == "funcbody" then
            return
        end
        if not n.text then
            for _, child in ipairs(n) do
                walk(child)
            end
        end
    end

    walk(parsed.root)
    assert(#bodies == 3)
    -- Per-phase accumulation for the current measured call, in microseconds.
    local phases: {[string]: number} = {}

    local function phase(name: string, started: number): nil
        phases[name] = (phases[name] or 0) + (os.clock() - started) * 1000000
    end

    local function direct(): any
        local results = {}
        for i, f in ipairs(bodies) do
            local started = os.clock()
            local g, problem = frontend.tryBuild(f.body, true)
            phase("direct_build", started)
            assert(g, f.name .. ": " .. tostring(problem))
            started = os.clock()
            local abi = maps.verify(g)
            phase("direct_verify", started)
            started = os.clock()
            local shader = wgsl.emit(g, f.name .. "_gpu", abi)
            phase("direct_wgsl", started)
            started = os.clock()
            local okSpirv, binary = xpcall(
                function(): string
                    return (spirv.emit(g, f.name .. "_gpu", abi))
                end,
                debug.traceback
            )
            assert(okSpirv, binary)
            phase("direct_spirv", started)
            results[i] = {graph = g, wgsl = shader, spirv = binary, abi = abi}
        end

        return results
    end

    local candidate = direct()
    local badSources = {
        source:gsub('assert%(#output == #input, "length mismatch"%)', '', 1),
        source:gsub('input%[i%]', 'input[1]', 1),
        source:gsub('for i = 1, #output do', 'for i = 1, #output, 2 do', 1),
        source:gsub('output%[i%] = input%[i%] %+ seed', 'return', 1),
        (
            source:gsub('for i = 1, #output do', 'local carried: uint32 = 0\n    for i = 1, #output do', 1)
                :gsub(
                    'output%[i%] = input%[i%] %+ seed',
                    'carried = carried + input[i]\n        output[i] = carried',
                    1
                )
        ),
    }

    local function firstBody(n: any): any
        if n.kind == "localFuncStmt" then
            return n.body
        end
        if not n.text then
            for _, child in ipairs(n) do
                local found = firstBody(child)
                if found then
                    return found
                end
            end
        end

        return nil
    end

    for i, text in ipairs(badSources) do
        local filename = path .. ".refusal" .. i .. ".nupp"
        local tree = parser.parse(text, filename)
        assert(#tree.errors == 0, "invalid refusal fixture")
        local ds = checker.check(tree, filename, env as any, {})
        for _, d in ipairs(ds) do
            assert(d.severity and d.severity ~= "error", tostring(d.msg))
        end
        local g = frontend.tryBuild(assert(firstBody(tree.root)), true)
        assert(not g or not pcall(maps.verify, g), "unsupported checked source admitted: " .. i)
    end
    print("checked source refusals", #badSources)

    local function reject(g: any, why: string): nil
        local ok = pcall(maps.verify, g)
        assert(not ok, "malformed graph accepted: " .. why)
    end

    for i, result in ipairs(candidate) do
        local name = bodies[i].name
        write(output .. "/" .. name .. ".wgsl", result.wgsl)
        write(output .. "/" .. name .. ".spv", result.spirv)
        result.cpu = graph.lower(result.graph)
        local g = result.graph
        local original = g.blocks[g.map.header].region.merge
        g.blocks[g.map.header].region.merge = 1;
        reject(g, "region merge");
        g.blocks[g.map.header].region.merge = original
        original = g.map.index
        g.map.index = g.map.count;
        reject(g, "cursor identity");
        g.map.index = original
        for _, b in ipairs(g.blocks) do
            for at, op in ipairs(b.op) do
                local a = b.args[at]
                if op == "U32Load" then
                    original = a[2];
                    a[2] = b.dst[at];
                    reject(g, "use before definition");
                    a[2] = original
                elseif op == "SpanEqual" then
                    original = a[2];
                    a[2] = a[1];
                    reject(g, "missing length guard");
                    a[2] = original
                end
            end
        end
        local header = g.blocks[g.map.header]
        local back = g.blocks[g.map.continuing].term.edges[1]
        local indexPosition, countPosition
        for at, p in ipairs(header.params) do
            if p == g.map.index then
                indexPosition = at
            end
            if p == g.map.count then
                countPosition = at
            end
        end
        original = back.args[countPosition]
        back.args[countPosition] = back.args[indexPosition]
        reject(g, "mutable state between map iterations")
        back.args[countPosition] = original
        local step = g.blocks[g.map.continuing].args[1]
        original = step[2];
        step[2] = 2;
        reject(g, "changed induction step");
        step[2] = original
        local continuing = g.blocks[g.map.continuing]
        graph.emit(g, continuing, "U32Store", {1, continuing.args[1][1], continuing.args[1][1]})
        reject(g, "observable work in the skipped GPU continue block")
        local last = #continuing.op
        continuing.op[last], continuing.dst[last], continuing.args[last] = nil, nil, nil
        continuing.pos[last], continuing.cert[last] = nil, nil
        maps.verify(g)
        print(name, #g.blocks, #g.types, #result.cpu.code, #result.wgsl)
    end
    local samples, phaseSamples = {}, {}
    local heap = 0

    local function measure(allocations: boolean): any
        collectgarbage("collect")
        if allocations then
            collectgarbage("stop")
        end
        local before = collectgarbage("count") * 1024
        phases = {}
        local start = os.clock()
        local results = direct()
        local us = (os.clock() - start) * 1000000
        local bytes = collectgarbage("count") * 1024 - before
        collectgarbage("restart")
        assert(#results == 3)

        return {us = us, bytes = bytes, phases = phases}
    end

    for round = 1, 7 do
        local row = measure(false)
        if round > 2 then
            samples[#samples + 1] = row.us
            for name, us in pairs(row.phases) do
                phaseSamples[name] = phaseSamples[name] or {}
                local l = phaseSamples[name];
                l[#l + 1] = us
            end
        end
    end
    local phaseText = {}
    for name, list in pairs(phaseSamples) do
        table.sort(list)
        phaseText[#phaseText + 1] = string.format('%q:%.1f', name, list[math.floor((#list + 1) / 2)])
    end
    table.sort(phaseText)
    heap = measure(true).bytes
    write(
        output .. "/metrics.json",
        '{"direct_us":[' .. table.concat(
            samples,
            ","
        ) .. '],"direct_heap":' .. heap .. ',"phase_median_us":{' .. table.concat(phaseText, ",") .. '}}\n'
    )

    return 0
end

export = shared
