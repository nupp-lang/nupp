module nupp.experiment.typedcfg.map

local G = require("nupp.experiment.typedcfg.graph")
local regions = require("nupp.experiment.typedcfg.regions")
local map = {}

-- The shared map legality check owns the parallelism and bounds argument.
-- Frontends emit checked accesses. Backends do not inspect source syntax.
function map.verify(g: any): any
    G.verify(g)
    regions.walk(g, function(event: string, block: any, edge: any): nil
    end)
    local m = assert(g.map, "not a map graph")
    local header, entry, continuing, merge = g.blocks[m.header], g.blocks[1], g.blocks[m.continuing], g.blocks[m.merge]
    assert(header.region.kind == "loop" and header.region.merge == m.merge and header.region.continuing == m.continuing)
    assert(
        header.term.edges[1].target == m.body and entry.term.kind == "jump" and entry.term.edges[1].target == header.id
    )
    assert(#header.op == 1 and header.op[1] == "ICmpLt" and header.dst[1] == header.term.value)
    assert(header.args[1][1] == m.index and header.args[1][2] == m.count, "map condition must bound its cursor")
    assert(#merge.op == 0 and merge.term.kind == "return" and not merge.term.value, "map has observable suffix")
    assert(#continuing.op == 1, "map continue block must contain only the induction step")
    local defs, incoming = {}, {}
    for _, b in ipairs(g.blocks) do
        for i, op in ipairs(b.op) do
            defs[b.dst[i]] = {op = op, args = b.args[i], block = b.id}
        end
        for _, e in ipairs(b.term.edges) do
            for i, p in ipairs(g.blocks[e.target].params) do
                incoming[p] = incoming[p] or {}
                local list = incoming[p];
                list[#list + 1] = e.args[i]
            end
        end
    end
    local headerParams = {}
    for _, p in ipairs(header.params) do
        headerParams[p] = true
    end
    assert(headerParams[m.index] and headerParams[m.count], "map state must be header parameters")

    -- Greatest fixed point of copy equalities, rooted at one header value.
    -- Every block is reachable in the verified region tree. Other definitions
    -- start false, so a changed value through any join destroys the equality.
    local function sameAs(root: integer): any
        local same, users, work = {}, {}, {}

        local function depends(v: integer, source: integer): nil
            users[source] = users[source] or {}
            local list = users[source];
            list[#list + 1] = v
        end

        for _, b in ipairs(g.blocks) do
            for _, p in ipairs(b.params) do
                same[p] = not headerParams[p] or p == root
                if not headerParams[p] then
                    for _, source in ipairs(incoming[p] or {}) do
                        depends(p, source)
                    end
                end
            end
            for i, op in ipairs(b.op) do
                local v = b.dst[i]
                if v ~= 0 then
                    same[v] = op == "IMov"
                    if op == "IMov" then
                        depends(v, b.args[i][1])
                    end
                end
            end
        end
        for v = 1, #g.types do
            if not same[v] then
                work[#work + 1] = v
            end
        end
        local at = 1
        while at <= #work do
            for _, v in ipairs(users[work[at]] or {}) do
                if same[v] and v ~= root then
                    same[v] = false;
                    work[#work + 1] = v
                end
            end
            at = at + 1
        end

        return same
    end

    local indexValues = sameAs(m.index)
    local back = continuing.term.edges[1]
    local initial = entry.term.edges[1]
    for i, p in ipairs(header.params) do
        local d = assert(defs[initial.args[i]], "map initial state must be defined in entry")
        assert(d.block == 1)
        if p == m.index then
            assert(d.op == "IK" and d.args[1] == 0, "map cursor must start at zero")
            local step = assert(defs[back.args[i]])
            assert(
                step.block == continuing.id and step.op == "IAddK" and step.args[2] == 1 and indexValues[step.args[1]],
                "map cursor must advance by one"
            )
        else
            assert(sameAs(p)[back.args[i]], "map iterations carry mutable state")
        end
        if p == m.count then
            assert(d.op == "SpanLen" and d.args[1] == m.span and d.args[2] == 4, "map count must come from its span")
        end
    end
    local parent, spans, readonly, writable, uniforms = {}, {}, {}, {}, {}
    for i, p in ipairs(g.parameters) do
        assert(p.kind == "span" or p.kind == "uniform")
        if p.kind == "span" then
            assert(p.element == 4)
            parent[i] = i
            local list = p.write and writable or readonly;
            list[#list + 1] = i
        else
            assert(p.type == "u32")
            uniforms[#uniforms + 1] = i
        end
    end
    assert(#g.parameters == g.nparams and #writable > 0 and parent[m.span])

    local function find(i: integer): integer
        assert(parent[i], "not a span parameter")
        while parent[i] ~= i do
            i = parent[i]
        end

        return i
    end

    for i, op in ipairs(entry.op) do
        if op == "SpanEqual" then
            local a = entry.args[i]
            assert(g.constants[a[3] + 1] and g.constants[a[3] + 1].kind == "str")
            parent[find(a[1])] = find(a[2])
        else
            local a = entry.args[i]
            assert(op == "SpanLen" or op == "IUnbox" or op == "IK", "map entry has observable work")
            if op == "SpanLen" then
                assert(parent[a[1]] and a[2] == 4, "invalid map span length")
            elseif op == "IUnbox" then
                assert(g.parameters[a[1]] and g.parameters[a[1]].kind == "uniform", "invalid map uniform")
            else
                assert(a[1] >= 0 and a[1] < 4294967296 and a[1] % 1 == 0, "invalid map constant")
            end
        end
    end
    for _, p in ipairs(readonly) do
        spans[#spans + 1] = p
    end
    for _, p in ipairs(writable) do
        spans[#spans + 1] = p
    end
    for _, p in ipairs(spans) do
        assert(find(p) == find(m.span), "map span lacks a length precondition")
    end
    local allowed = {
        IK = true,
        IMov = true,
        IAddK = true,
        U32Add = true,
        U32Sub = true,
        U32Load = true,
        U32Store = true,
        ICmpEq = true,
        ICmpNe = true,
        ICmpLt = true,
        ICmpLe = true,
        IAnd = true,
        IOr = true
    }
    for _, b in ipairs(g.blocks) do
        for i, op in ipairs(b.op) do
            if b.id ~= 1 then
                assert(allowed[op], "operation outside shared uint32 map: " .. op)
                local a = b.args[i]
                if op == "U32Load" or op == "U32Store" then
                    assert(indexValues[a[2]], "map access differs from the invocation index")
                    assert(
                        parent[a[1]] and (op ~= "U32Store" or g.parameters[a[1]].write),
                        "invalid map storage access"
                    )
                elseif op == "IAddK" then
                    assert(indexValues[a[1]] and a[2] == 1, "unbounded map integer arithmetic")
                elseif op == "IK" then
                    assert(a[1] >= 0 and a[1] < 4294967296 and a[1] % 1 == 0, "invalid uint32 literal")
                end
            end
        end
    end

    return {spans = spans, readonly = readonly, writable = writable, uniforms = uniforms, countSpan = m.span}
end

export = map
