module nupp.experiment.typedcfg.regions

-- Region annotations name existing blocks. Walking them never builds another
-- statement tree. Both validation and structured backends use this traversal.
local regions = {}

function regions.walk(g: any, visit: function(string, any, any): nil): nil
    local seen = {}
    local path
    path = function(id, stop)
        while id ~= stop do
            local b = assert(g.blocks[id], "invalid region block")
            assert(not seen[id], "region crosses another region or has an unmarked cycle")
            seen[id] = true
            local t, r = b.term, b.region
            if r and r.kind == "loop" then
                assert(t.kind == "branch" and t.edges[2].target == r.merge, "loop exit differs from its merge")
                local continuing = assert(g.blocks[r.continuing], "loop has no continue block")
                assert(
                    continuing.term.kind == "jump" and continuing.term.edges[1].target == id,
                    "invalid loop back edge"
                )
                visit("loop", b, nil)
                visit("block", b, nil)
                visit("exit", b, t.edges[2])
                visit("edge", b, t.edges[1])
                path(t.edges[1].target, continuing.id)
                assert(not seen[continuing.id], "continue block has another entry")
                seen[continuing.id] = true
                visit("block", continuing, nil)
                visit("edge", continuing, continuing.term.edges[1])
                visit("endloop", b, nil)
                id = r.merge
            elseif t.kind == "branch" then
                assert(r and r.kind == "selection" and g.blocks[r.merge], "selection has no merge")
                visit("block", b, nil)
                visit("if", b, nil)
                visit("edge", b, t.edges[1])
                path(t.edges[1].target, r.merge)
                visit("else", b, nil)
                visit("edge", b, t.edges[2])
                path(t.edges[2].target, r.merge)
                visit("endif", b, nil)
                id = r.merge
            else
                assert(not r, "region on a non-branch")
                visit("block", b, nil)
                if t.kind == "jump" then
                    visit("edge", b, t.edges[1])
                    id = t.edges[1].target
                else
                    assert(stop == 0 and t.kind == "return" and not t.value, "unexpected region exit")
                    visit("return", b, nil)
                    id = stop
                end
            end
        end
    end
    path(1, 0)
    for _, b in ipairs(g.blocks) do
        assert(seen[b.id], "block outside the region tree")
    end
end

export = regions
