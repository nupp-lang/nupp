module nupp.experiment.p4

--- The P4 gate's producer: emits a project's text image as today, converts
--- every function the lowering finished to its graph, and writes the graph
--- image beside the text, for `graph_gate image` to derive and compare.
local project = require("nupp.tools.vm.project")

local lower = require("nupp.compiler.vm.lower")
local convert = require("nupp.compiler.vm.convert")
local G = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")

local driver = {}

local function write(path: string, text: string): nil
    local file = assert(io.open(path, "wb"))
    file:write(text)
    file:close()
end

--- `root entry output [extras]`: writes `output.image` and `output.graph`;
--- `extras` names modules the image carries beside what the entry reaches.
function driver.main(argv: {string}): integer
    local root, entry, output = assert(argv[1]), assert(argv[2]), assert(argv[3])
    local extras = argv[4]
    local sink: {any} = {}
    local header: any = {}
    lower.graphSink = function(emitted: string, functions: {any}, given: table): nil
        -- A chunk loaded while the project emits is lowered on its own.
        if emitted == entry then
            sink, header = functions, given
        end
    end
    local started = os.clock()
    local text = project.emit(root, entry, extras)
    local emitted = os.clock()
    lower.graphSink = nil
    local graphs = {}
    local failures = 0
    for i = 1, #sink do
        local ok, result = pcall(function(): any
            local g = convert.graph(sink[i])
            G.verify(g)
            return g
        end)
        if ok then
            graphs[#graphs + 1] = result
        else
            failures = failures + 1
            if failures <= 10 then
                io.stderr:write(sink[i].name, ": ", tostring(result), "\n")
            end
        end
    end
    local converted = os.clock()
    local shapes = {}
    for i, shape in ipairs(header.shapes or {}) do
        local slots = {}
        for j, slot in ipairs(shape.slots) do
            local ty = slot.ty as string
            local record = ty:match("^rec:(%d+)$")
            slots[j] = {name = slot.name, type = record and "rec" or ty, record = record and tonumber(record) or nil}
        end
        local identity = shape.module and shape.module .. ":" .. shape.name
        if identity and not shape.physical and identity:find("^[%w_.]+:[%w_]+$") then
            shapes[i] = {name = shape.name, identity = identity, slots = slots}
        else
            shapes[i] = {name = shape.name, slots = slots}
        end
    end
    local encoded = graphimage.encode({
        functions = graphs,
        shapes = shapes,
        modules = header.modules,
        entry = header.entry
    })
    local done = os.clock()
    write(output .. ".image", text)
    write(output .. ".graph", encoded)
    print(
        (
            "functions %d converted %d failed %d; emit %.1f ms, convert %.1f ms, encode %.1f ms; text %d bytes, graph %d bytes"
        ):format(
            #sink,
            #graphs,
            failures,
            (emitted - started) * 1000,
            (converted - emitted) * 1000,
            (done - converted) * 1000,
            #text,
            #encoded
        )
    )

    return failures == 0 and 0 or 1
end

export = driver
