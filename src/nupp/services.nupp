module nupp.services

--[[
Typed service definitions and named implementations within one Lua state.

A declaration module owns one invariant Service<T> handle. Register checked
loaders or discover them through static package metadata; neither action executes
a provider. Setup selects names before requiring consuming facades. Each facade
assembles its implementation during top-level initialization and retains its
actual methods for direct calls.

```nupp
local services = require("nupp.services")
interface Codec
    readonly encode: function(value: string): string
end
local service: services.Service<Codec> = services.define("example.codec", 1)
service:register("plain", function(): Codec
    return {encode = function(value: string): string return value end}
end)
service:select("plain")
local codec = service:require()
assert(codec.encode("hello") == "hello")
```

The variable annotation supplies generic inference. Service<T> is invariant:
register accepts T while lookup returns T, so a handle cannot be reassigned to a
different provider interface. Import canonical handles rather than redefining an
existing ID. Provider exports may have extra members, but their required members,
generics, ownership, and suspension behavior must satisfy the declared contract.

Successful named loads are cached by name. Unnamed resolution fixes the default
selection, including optional absence. Failed loads are not cached as successful
values; diagnostics include provider identity and dependency cycles. Named lookup
does not itself select or freeze the default. All state is local to one Lua state.

Use assembly only while requiring a facade, then call retained operations.
Applications must not perform service lookups in hot calls or resource cleanup.
Worker configuration carries catalog names and setup modules, never provider
instances or captured closures. See
[Service Providers](docs/learn/projects/service-providers.md) for packaging and
setup module examples.
]]

const _DYNAMIC_PROVIDERS = "@requires-dynamically nupp.runtime.services.* @requires-dynamically nupp.runtime.provider.* @requires-dynamically nupp.runtime.browser.* @requires-dynamically nupp.codec.json.aot"
local builtin = require("nupp.runtime.services.catalog")
local catalog: any = {}
local foundCatalog, loadedCatalog = pcall(require, "nupp.runtime.services.artifact")
if foundCatalog then
    catalog = loadedCatalog
elseif not tostring(loadedCatalog):find("module 'nupp.runtime.services.artifact' not found", 1, true) then
    error("nupp.services: cannot read provider catalog: " .. tostring(loadedCatalog), 0)
end
local targetDialect: string = catalog.dialect or (rawget(_G, "jit") ~= nil and "luajit" or "lua51")

local definitions: {[string]: any} = {}
local loading: {string} = {}
local workerSetups: {string} = {}
local workerSetupNames: {[string]: boolean} = {}
local workerInitialization: string?

--- Runtime field-shape entry derived from a canonical provider interface.
--- Kinds use the reflected type vocabulary and may include nil for optional fields.
export interface Member
    name: string
    kinds: {string}
end

local function validate(id: string, members: {Member}?, value: any): nil
    if members == nil then
        return
    end
    if type(value) ~= "table" then
        error("nupp.services: " .. id .. " must return a provider table", 2)
    end
    for _, member in ipairs(members) do
        local actual = type(value[member.name])
        local accepted = false
        for _, kind in ipairs(member.kinds) do
            accepted = accepted
                or kind == "any"
                or kind == "unknown"
                or kind == actual
                or kind == "func"
                and actual == "function"
                or (
                kind == "interface"
                or kind == "record"
                or kind == "nominal"
                or kind == "shape"
                or kind == "map"
                or kind == "array"
            ) and actual == "table" or (
                kind == "integer" or kind == "fixedwidth" or kind == "literalnumber"
            ) and actual == "number"
        end
        if not accepted then
            error("nupp.services: " .. id .. "." .. member.name .. " has type " .. actual, 2)
        end
    end
end

--- A named, versioned contract with checked lazy loaders and cached values.
---
--- Define this once in a declaration module. Registration and selection are setup
--- operations; resolve during a facade's require-time initialization. The default
--- freezes after successful resolution, while named implementations retain their
--- independent cached identities.
export record Service<T>
    --- Stable service identity shared with catalog declarations.
    readonly id: string

    --- Positive contract API version required of every registered catalog entry.
    readonly api: integer

    private loaders: {[string]: function(): T}
    private values: {[string]: T}
    private active: {[string]: boolean}
    private selected: string?
    private resolved: boolean = false
    private resolving: boolean = false
    private value: T?
    private members: {Member}?
    private defaultLoader: (function(): T?)?
    private checkImplementation: (function(T): nil)?

    --- Registers a checked loader without executing it.
    ---
    --- Names are unique within this handle. Registration does not select a default.
    --- A successful named load runs the loader once and caches its result; a failed
    --- load may be retried. Additional registration cannot change a frozen default.
    --- @raises when the name is empty or already registered
    function register(self: Service<T>, name: string, loader: function(): T): nil
        if name == "" then
            error("nupp.services: empty provider name for " .. self.id, 2)
        end
        if self.loaders[name] ~= nil then
            error("nupp.services: duplicate provider " .. self.id .. "/" .. name, 2)
        end
        self.loaders[name] = loader
    end

    --- Chooses the name used by unnamed resolution.
    ---
    --- Selection may precede registration. An absent selected name fails when the
    --- facade resolves; it does not fall back to a built-in default. Before
    --- resolution, another select may replace the choice. Once resolution starts,
    --- reselection is rejected, including from a provider's own loader.
    --- @raises when the service is already resolving or resolved
    function select(self: Service<T>, name: string): nil
        if self.resolved or self.resolving then
            error("nupp.services: " .. self.id .. " is already resolved", 2)
        end
        if name == "" then
            error("nupp.services: empty provider name for " .. self.id, 2)
        end
        self.selected = name
    end

    --- Returns a fresh, sorted list of registered provider names.
    ---
    --- Listing executes no loader and does not select or freeze the default.
    --- The result includes catalog registrations even if none has been loaded.
    function list(self: Service<T>): {string}
        local names: {string} = {}
        for name in pairs(self.loaders) do
            names[#names + 1] = name
        end
        table.sort(names)

        return names
    end

    --- Loads a named implementation or resolves the unnamed default.
    ---
    --- A missing explicit name returns nil without freezing the default. An
    --- unnamed call uses the selected name or facade default, validates the value,
    --- and freezes that outcome, including nil. A selected name that is absent is
    --- an error. Cached successful values retain identity on subsequent lookups.
    ---
    --- Load and validation failures clear the in-progress state and may be retried.
    --- Runtime shape validation complements static typing; it cannot prove a Lua
    --- function's ownership, suspension, or behavioral guarantees.
    --- @raises when a selected provider is absent, cyclic, or fails to load
    function lookup(self: Service<T>, name: string?): T?
        if name ~= nil then
            local loaded = self.values[name]
            if loaded ~= nil then
                return loaded
            end
            local loader = self.loaders[name]
            if loader == nil then
                return nil
            end
            local identity = self.id .. "/" .. name
            if self.active[name] then
                error("nupp.services: provider cycle " .. table.concat(loading, " -> ") .. " -> " .. identity, 2)
            end
            self.active[name] = true
            loading[#loading + 1] = identity
            local function load(): T
                local value = loader()
                if value == nil then
                    error("provider returned nil", 2)
                end
                validate(identity, self.members, value)

                return value
            end

            local ok, value = pcall(load)
            loading[#loading] = nil
            self.active[name] = nil
            if not ok then
                error("nupp.services: cannot load " .. identity .. ": " .. tostring(value), 2)
            end
            self.values[name] = value
            return value
        end
        if self.resolved then
            return self.value
        end
        if self.resolving then
            error("nupp.services: default cycle " .. table.concat(loading, " -> ") .. " -> " .. self.id, 2)
        end
        self.resolving = true
        loading[#loading + 1] = self.id
        local function choose(): T?
            local selected = self.selected
            if selected ~= nil then
                local value = self:lookup(selected)
                if value == nil then
                    error("nupp.services: no provider " .. self.id .. "/" .. selected, 2)
                end
                return value
            end
            local defaultLoader = self.defaultLoader
            if defaultLoader ~= nil then
                return defaultLoader()
            end

            return nil
        end

        local function resolve(): T?
            local value = choose()
            if value ~= nil then
                validate(self.id, self.members, value)
                local checkImplementation = self.checkImplementation
                if checkImplementation ~= nil then
                    checkImplementation(value)
                end
            end

            return value
        end

        local ok, value = pcall(resolve)
        loading[#loading] = nil
        self.resolving = false
        if not ok then
            error(tostring(value), 2)
        end
        self.value = value
        self.resolved = true

        return value
    end

    --- Resolves a required facade with explicit selection taking precedence.
    ---
    --- Call once in module top-level code and retain the result. defaultLoader
    --- performs ordinary host checks and method assembly. checkImplementation
    --- validates representation or other semantic requirements before publication.
    --- A previously resolved value is checked against a newly supplied validator.
    --- @raises when the service cannot resolve an implementation
    function assemble(self: Service<T>, defaultLoader: function(): T, checkImplementation: (function(T): nil)?): T
        self:assembleOptional(defaultLoader, checkImplementation)
        return self:require()
    end

    --- Resolves an optional facade and freezes absence as well as presence.
    ---
    --- defaultLoader may return nil when this host has no implementation. Explicit
    --- selection still requires that named provider to exist. Later registration
    --- does not turn a successfully resolved absence into an implementation.
    function assembleOptional(
        self: Service<T>,
        defaultLoader: function(): T?,
        checkImplementation: (function(T): nil)?
    ): T?
        if not self.resolved and not self.resolving then
            self.defaultLoader = defaultLoader
            self.checkImplementation = checkImplementation
        elseif self.resolved and checkImplementation ~= nil and self.value ~= nil then
            checkImplementation(self.value)
        end

        return self:lookup()
    end

    --- Returns a cached or newly loaded implementation that must be present.
    ---
    --- Uses lookup's named/default rules, then rejects nil. Named require does not
    --- choose the default. Retain the result at module load time for direct calls.
    --- @raises when no implementation is available or its loader fails
    function require(self: Service<T>, name: string?): T
        local value = self:lookup(name)
        if value == nil then
            error("nupp.services: no provider for " .. self.id .. (name and "/" .. name or ""), 2)
        end

        return value
    end
end

--- Defines the unique handle owned by a service's declaration module.
---
--- id is nonempty and api is a positive integer. T is inferred from the receiving
--- Service<T> annotation or loader. defaultLoader is optional; a facade can supply
--- assembly later. members describes runtime field kinds derived from the canonical
--- interface. Extra provider members are permitted.
---
--- Matching catalog entries register loaders after checking service API and target
--- compatibility. Loading one verifies that its contract module exports this exact
--- handle. Definition itself never requires an implementation module.
--- @raises when the identity or API version is invalid or already defined
export function define<T>(id: string, api: integer, defaultLoader: (function(): T?)?, members: {Member}?): Service<T>
    if id == "" or api < 1 or api % 1 ~= 0 then
        error("nupp.services: a service requires an identity and positive API version", 2)
    end
    if definitions[id] ~= nil then
        error("nupp.services: duplicate contract " .. id, 2)
    end
    local service: Service<T> = new Service(
        id = id,
        api = api,
        loaders = {},
        values = {},
        active = {},
        defaultLoader = defaultLoader,
        members = members
    )
    local function add(entry: any): nil
        if entry.service ~= id or not builtin.supports(entry, targetDialect) then
            return
        end
        if entry.api ~= api then
            error("nupp.services: API mismatch for " .. id .. "/" .. entry.name, 2)
        end
        if service.members == nil and entry.members ~= nil then
            service.members = entry.members
        end
        service:register(entry.name, function(): T
            local declaration: any = require(entry.contract)
            if declaration[entry.export] ~= service then
                error("nupp.services: contract identity mismatch for " .. id .. "/" .. entry.name, 2)
            end
            local value: any = require(entry.entry)
            if entry.member ~= nil then
                value = value[entry.member]
            end

            return value as T
        end)
    end

    for _, entry in ipairs(foundCatalog and catalog.providers or builtin.entries) do
        add(entry)
    end
    definitions[id] = service

    return service
end

--- Returns the artifact's fixed target dialect.
---
--- Facades may use this for ordinary default assembly and representation checks.
--- Changing provider names cannot change the dialect or generated calling convention.
export function dialect(): string
    return targetDialect
end

--- Registers an ordinary setup module for every child worker state.
---
--- Include the module in the artifact's entry modules. It must register/select
--- providers before requiring their consumers. Repeated names are deduplicated in
--- registration order. Call before loading the workers facade, which captures and
--- freezes initialization. Runtime-only registrations must be recreated by setup.
--- @raises when the module name is invalid or worker initialization is fixed
export function setupWorkers(moduleName: string): nil
    if workerInitialization ~= nil then
        error("nupp.services: worker initialization is already fixed", 2)
    end
    if moduleName == "" or not moduleName:match("^[A-Za-z_][A-Za-z0-9_.]*$") then
        error("nupp.services: invalid worker setup module " .. moduleName, 2)
    end
    if not workerSetupNames[moduleName] then
        workerSetupNames[moduleName] = true
        workerSetups[#workerSetups + 1] = moduleName
    end
end

--- Captures child initialization as loadable setup and catalog selections.
---
--- This is the worker-provider integration point. The first call fixes the setup
--- list, then emits setup requires followed by catalog-backed named selections in
--- service-ID order. Each destination runs it before loading consumer modules.
--- Repeated calls return the same configuration; no provider objects or closures
--- cross the lane boundary. An explicit setup module must recreate runtime-only
--- selections that the artifact catalog cannot name.
--- @raises when a runtime-only selection has no explicit worker setup
export function workerConfiguration(): string
    if workerInitialization ~= nil then
        return workerInitialization
    end
    local lines: {string} = {}
    for _, moduleName in ipairs(workerSetups) do
        lines[#lines + 1] = ("require(%q)"):format(moduleName)
    end
    local identities: {string} = {}
    for id in pairs(definitions) do
        identities[#identities + 1] = id
    end
    table.sort(identities)
    for _, id in ipairs(identities) do
        local selected = definitions[id].selected
        if selected ~= nil then
            local found: any = nil
            for _, entries in ipairs({foundCatalog and catalog.providers or builtin.entries}) do
                for _, entry in ipairs(entries) do
                    if entry.service == id and entry.name == selected and builtin.supports(entry, targetDialect) then
                        found = entry
                    end
                end
            end
            if found ~= nil then
                lines[#lines + 1] = ("require(%q)[%q]:select(%q)"):format(found.contract, found.export, selected)
            elseif #workerSetups == 0 then
                error(
                    "nupp.services: runtime-only provider "
                    .. id
                    .. "/"
                    .. selected
                    .. " requires an explicit worker setup module",
                    2
                )
            end
        end
    end
    workerInitialization = table.concat(lines, "\n")

    return workerInitialization
end
