    -- `declarationFile` is the whole difference: a `.d.nupp` describes an interface it
    -- does not own, an implementation is checked as the module it is.
    local function loadBundled(name: string, file: string, declarationFile: boolean): any
        local bundledSrc = bundledSource(file)
        if not bundledSrc then
            return false
        end
        local result = parser.parse(bundledSrc, name)
        if #result.errors > 0 then
            return false
        end
        -- Keep the exports, not just the module value: a module names the types its API
        -- is written in, and code that passes those values around has to be able to
        -- name them too. For example: `local b: string.buffer.Buffer`. Explicitly not
        -- strict. Strictness
        -- is a project's judgement about its own source, and these are not its source
        -- -- they are shipped with the compiler. Left to inherit, `strict = true` made
        -- every consumer re-judge them, and one that does not pass was discarded below
        -- and became `unknown` at every use, with nothing said. `string.buffer` is such
        -- a declaration: `put` takes `...: any`, which strict reports on an exported
        -- function, so turning strictness on silently untyped every buffer in the
        -- project.
        local diags, moduleType, exports = check.check(result, name, env, {
            moduleName = name,
            declarationFile = declarationFile,
            strict = false,
        })
        -- Errors discard a declaration; warnings do not. A lint is a remark about
        -- source the project does not own, and letting one discard the module made it
        -- `unknown` at every use with nothing said -- which is the failure the
        -- strictness note above describes and only half escaped.
        local failed = false
        for _, diag in ipairs(diags) do
            failed = failed or diag.severity == "error"
        end
        if not failed and moduleType then
            if name == "lpeg" and exports then
                local pattern = exports.types.Pattern
                if pattern and pattern.tag == "nominal" then
                    pattern.lpegPattern = true
                end
                local moduleRecord = (
                    moduleType.tag == "metatable" or moduleType.tag == "typeobject"
                ) and moduleType.of or nil
                if moduleRecord and moduleRecord.tag == "nominal" then
                    moduleRecord.lpegLibrary = true
                    moduleRecord.lpegPatternOrigin = pattern as T.Nominal
                end
            end
            return {type = moduleType, exports = exports, declared = cst.declaredModule(result.root) ~= nil,}
        end

        return false
    end

    -- Loaded when something asks for one, not when an environment is made. Eager
    -- loading meant every check of every project parsed and checked all of these, which
    -- doubled the wall time of a small one for modules it never required. Both readers
    -- reach `env.bundled` by name, so this lives in one metatable rather than at each
    -- of them, and a miss is remembered as `false` so an ordinary unresolved name is
    -- not retried on every lookup.
    local PENDING: {[string]: {
        file: string,
        declaration: boolean
    }} = {}
    for name, file in pairs(BUNDLED) do
        PENDING[name] = {file = file, declaration = true}
    end
    for name, file in pairs(BUNDLED_SOURCE) do
        PENDING[name] = {file = file, declaration = false}
    end
    setmetatable(env.bundled, {
        __index = function(store: any, name: string): any
            local pending = PENDING[name]
            local loaded: any = false
            if pending then
                loaded = loadBundled(name, pending.file, pending.declaration)
            end
            rawset(store, name, loaded)

            return loaded
        end
    })

    return env
end

--- Whether the formatter should parenthesize a method call's sugar-form arguments by
--- default. A manifest turns that off project-wide with `fmt = { methodParens = false
--- }`; true otherwise.
function envMod.fmtMethodParensDefault(env: envMod.Env): boolean
    local fmtConfig = env.config.fmt
    return not (fmtConfig and fmtConfig.methodParens == false)
end

export = envMod
