module nupp.compiler.env

--[[
The environment a check happens in.

Created once per project or session and shared across every file checked in it,
so the prelude is parsed once and a module's type is computed once. It carries:

- the global bindings and types, from the prelude and any declaration files;
- the string library's shape, which is what makes `s:sub()` type;
- the cache of already-resolved modules, keyed by module name;
- the `require()` hook the checker calls to resolve a name to a type.

Project configuration comes from an `nupp.lua` file at the project root, which
returns a table, `{ include = { "src" } }` and the rest, and which is also
where the include roots that module resolution searches are named.
]]

local parser = require("nupp.compiler.parser")
local cst = require("nupp.compiler.cst")
local check = require("nupp.compiler.check")
local diagnostics = require("nupp.compiler.diagnostics")
local T = require("nupp.compiler.types")
local annotationMod = require("nupp.compiler.annotations")
local native = require("nupp.compiler.native")
local bundledMod = require("nupp.compiler.bundled")
local headerMod = require("nupp.compiler.header")

-- These are host services, not part of an in-memory compiler. The name is a
-- parameter so closure discovery correctly treats each eventual require as
-- computed; memory-only environments never execute them.
local function compilerPrivate(name: string): any
    return require("nupp.compiler." .. name)
end

local function buildPrivate(name: string): any
    return require("nupp.compiler.build." .. name)
end

local envMod = {}

----------------------------------------------------------------------------
-- What an environment holds
----------------------------------------------------------------------------

--- Where a declaration was written: enough for an editor to go there, and enough to
--- tell two declarations of one name apart.
type envMod.Definition = {
    filename: string,
    name: string,
    kind: string,

    --- The copied token, as `nupp.compiler.header` makes it.
    token: any,

    deprecated: any?,

    --- This type alias names compiler-only value types and is unavailable in a
    --- runtime annotation.
    comptimeOnly: boolean?
}

--- One exported declaration, as a file's header records it. Declared by
--- `nupp.compiler.header`, and named here because this is where its readers look.
type envMod.Declaration = headerMod.Declaration

--- What one file exports, in the form the project index is built from.
type envMod.Header = headerMod.Header

--- One declaration as the project index holds it: what the header said, plus the
--- declaration-site identity allocated for it.
type envMod.Entry = {
    name: string,
    path: string,
    moduleName: string?,
    visibility: string,
    kind: string,
    signature: string,
    definition: envMod.Definition,

    --- The nominal this declaration site stands for. A type alias has none: it names
    --- another type rather than declaring one.
    type: types.Type?
}

--- Every declaration the project's files export, indexed the ways they are asked for.
type envMod.Index = {
    byName: {[string]: {envMod.Entry}},
    byPath: {[string]: {envMod.Entry}},

    --- Module name to the file backing it.
    modules: {[string]: string},
    declaredModules: {[string]: boolean},
    moduleDefinitions: {[string]: envMod.Definition},
    registrationDiagnostics: {any},

    annotationsByName: {[string]: {envMod.Entry}},

    --- Final path segment to the modules that end in it.
    moduleBasenames: {[string]: {string}}
}

--- What a checked module publishes to whatever requires it: the types its API is
--- written in, where each was declared, and the values a construction reaches.
type envMod.Exports = {
    types: {[string]: types.Type},
    typeDefs: {[string]: envMod.Definition},
    values: {[string]: types.Type},
    valueDefs: {[string]: envMod.Definition},
    nominalEffectFingerprint: string?,
    comptimeFunctions: {[string]: any}?,
    comptimeFunctionFingerprint: string?,
    callGuarantees: {[string]: any}?
}

type envMod.CallGuarantees = {
    identity: string,
    noAllocate: boolean?,
    noRaise: boolean?
}

--- What this module needs of a `nupp.compiler.build.store` store. Named here rather
--- than
--- taken
--- from that module because the require reaching it is deliberately made at the point
--- of use, so there is no name for its type at the top of this file.
type envMod.Store = {
    get: function(key: string): any,
    put: function(key: string, value: any),
    save: function()
}

--- A compiler-private, already-checked standard prelude. Portable compiler
--- entries may provide one to avoid reconstructing the same immutable graph
--- in every fresh host. The ordinary compiler remains the source oracle.
export interface PreludeImageProvider
    new: function(): {
        annotationsByName: any,
        featureEffects: any,
        globalTypeDefs: any,
        globalTypes: any,
        globals: any,
        preludeComptimeFunctions: any,
        preludeRuntime: string,
        stringLib: any
    }
end

--- What `envMod.new` accepts beside the project root.
type envMod.Options = {
    --- Overrides the config `nupp.lua` would have supplied.
    config: any,

    --- False keeps everything this environment works out inside this process.
    cache: boolean?,
    memoryOnly: boolean?,
    dialect: string?,
    backendResolution: any?,
    capabilityResolution: any?,
    nativeCompilerServices: boolean?,
    compilerServices: any?,
    traceInspection: boolean?,
    preludeImage: PreludeImageProvider?,

    --- Where the stores live, so two environments can share a root without sharing a
    --- cache.
    cacheDir: string?,

    --- Installed rock directories searched for typed module declarations. They are
    --- deliberately not project roots: their files are dependencies, not source the
    --- project owns, formats, or builds.
    typeRoots: {string}?,

    --- Declaration trees whose LuaCATS files add globals and types, but can never
    --- resolve a runtime `require`.
    ambientTypeRoots: {string}?,

    --- Further folders to search, which is what a session opened on more than one
    --- folder amounts to.
    folders: {string}?,

    --- Read by what builds on an environment rather than by the environment itself,
    --- which takes strictness from the config.
    strict: boolean?
}

--- One declaration file in an ambient type root that could not be imported.
type envMod.AmbientTypeProblem = {
    --- The declaration file, which is a real path an editor can open.
    path: string,

    --- What stopped it: a read error, a parse error, or the checker's own message.
    msg: string,

    --- Where in that file, so the report points at the construct rather than at the
    --- top of somebody else's file.
    line: integer,
    col: integer
}

--- The environment a check happens in, shared by every file checked in it.
---
--- An interface rather than a record because it is an ordinary table: `envMod.new`
--- builds it with a literal, and nothing stamps a metatable on it.
---
--- The fields the constructor fills in after the literal are optional here, which is
--- what says they are not there yet while it is still being assembled.
interface envMod.Env
    --- Global value bindings, from the prelude and any declaration file.
    globals: {[string]: any}

    --- Global types, by name.
    globalTypes: {[string]: any}

    --- Comptime functions the prelude declares. The prelude is one declaration
    --- environment even when it is several files, so a helper declared beside the
    --- library it types stays resolvable in type position from the next file.
    preludeComptimeFunctions: {[string]: any}

    --- Where each of those was declared.
    globalTypeDefs: {[string]: any}

    --- The string library's shape, which is what makes `s:sub()` type.
    stringLib: any

    --- The registry an annotation application is checked against.
    annotations: any

    --- Prelude receiver types and field names mapped to compiler runtime effects.
    featureEffects: {[any]: {[string]: string}}?

    --- Checked and generated ordinary prelude bodies, embedded before each module.
    preludeRuntime: string?

    --- Modules already resolved, by module name.
    loaded: {[string]: any}

    --- The same records by the path backing them, so two names for one file resolve to
    --- one module rather than to two checks of it.
    loadedPaths: {[string]: any}

    --- Built-in module declarations, loaded on first lookup. Survives a reset of
    --- `loaded`, which is why it is a table of its own.
    bundled: {[string]: any}

    --- The project root: the search base, and where `nupp.lua` was read from.
    rootDir: string

    --- Every root module resolution searches, the project's own first.
    roots: {string}?

    --- Installed-rock module declarations, searched after project roots and excluded
    --- from the project's source/index walks.
    typeRoots: {string}?

    --- Checker-only declaration trees. Their contents are read once when the
    --- environment opens and contribute ambient globals; they are not module roots.
    ambientTypeRoots: {string}?

    --- The declaration files in those trees this checker could not take, and why. A
    --- foreign tree is read for what it does say rather than refused for what it does
    --- not, and this is how the part that was skipped is reported.
    ambientTypeProblems: {envMod.AmbientTypeProblem}?

    --- The extra folders a session was opened on, without the root among them.
    folders: {string}?

    --- What `nupp.lua` declared, which is a table this compiler did not write.
    config: any

    --- Explicit target triple for compiler-owned C layout facts. Absent means layout
    --- intrinsics are unavailable rather than silently measuring the compiler host.
    layoutTarget: string?

    resolveModule: function(env: envMod.Env, name: string): types.Type?
    resolveModuleExports: function(env: envMod.Env, name: string): envMod.Exports?
    observeCallGuarantee: function(
        env: envMod.Env,
        module: string,
        member: string,
        identity: string,
        guarantee: string
    ): boolean
    resolveCallGuarantees: function(env: envMod.Env, module: string, member: string): any
    resolveProjectType: function(
        env: envMod.Env,
        filename: string,
        name: string
    ): (types.Type?, envMod.Definition?, string?, string?, string?, {envMod.Entry}?)
    resolveProjectValue: function(
        env: envMod.Env,
        filename: string,
        name: string
    ): (types.Type?, envMod.Definition?, string?, string?, {envMod.Entry}?)

    --- One result rather than the two `envMod.resolveProjectAnnotation` has: a caller
    --- reaching it through here wants the definition, and the reason there is none is
    --- the resolver's own business.
    resolveProjectAnnotation: function(env: envMod.Env, filename: string, name: string): table?

    resolveQualifiedType: function(
        env: envMod.Env,
        filename: string,
        moduleName: string,
        typeName: string
    ): (types.Type?, envMod.Definition?, string?)
    exportedNominal: function(env: envMod.Env, moduleName: string, typeName: string): (types.Type?, envMod.Definition?)

    --- Interns an immutable derive envelope. Incremental environments replace this
    --- process-local implementation with the materializeDerives query.
    internDeriveRecipe: (function(env: envMod.Env, recipe: any): (any, boolean))?

    modulesNamed: function(env: envMod.Env, short: string): {string}?
    modulesExporting: function(env: envMod.Env, name: string): {string}
    declarationType: function(
        env: envMod.Env,
        filename: string,
        name: string,
        kind: string,
        visibility: string
    ): (types.Type?, envMod.Entry?)
    moduleNameForPath: function(env: envMod.Env, path: string): string?
    ensureProjectIndex: function(env: envMod.Env): envMod.Index

    --- Incremental environments replace these broad index reads with keyed queries.
    --- Ordinary command environments leave them absent and use `ensureProjectIndex`.
    projectEntries: (function(env: envMod.Env, name: string): {envMod.Entry})?

    projectPathEntries: (function(env: envMod.Env, path: string): {envMod.Entry})?
    projectModulePath: (function(env: envMod.Env, name: string): string?)?
    projectModuleBasenames: (function(env: envMod.Env, short: string): {string}?)?
    projectAnnotations: (function(env: envMod.Env, name: string): {envMod.Entry}?)?

    --- The session this environment answers for, when one is driving it.
    ---
    --- It reads whatever input has arrived without blocking, says whether the request
    --- the work belongs to has been cancelled since, and carries the value a cancelled
    --- computation raises. Long work consults it between the units it is made of: an
    --- isolated comptime evaluation while the checker waits on its worker, and each
    --- module and file header a session's query graph has to work out. A command-line
    --- run leaves it absent, and so is never interrupted.
    host: any

    --- Nothing this environment works out outlives the process.
    cacheDisabled: boolean?

    memoryOnly: boolean?
    dialect: string?
    backendResolution: any?
    capabilityResolution: any?
    nativeCompilerServices: boolean?
    compilerServices: any?

    --- Where the stores live, when something moved them off the build directory.
    cacheDir: string?

    --- The header store, opened on first use. Nil before that, and nil again when it
    --- could not be opened -- which is a miss rather than an error.
    headerStore: envMod.Store?

    --- Whether opening it has been attempted, which nil alone cannot say.
    headerStoreOpened: boolean?

    --- The same pair for the store of formatting verdicts, which is a file of its own
    --- because a project may format without checking or check without formatting.
    formatStore: envMod.Store?

    formatStoreOpened: boolean?

    --- Validated comptime type blueprints, keyed by sealed program and arguments.
    typeFunctionStore: envMod.Store?

    typeFunctionStoreOpened: boolean?

    openTypeFunctionStore: function(env: envMod.Env): envMod.Store?

    --- The digest of every annotation the project declares, once something asked. `any`
    --- rather than `string?` because `nupp.compiler.build.hash` does not yet say what
    --- `digest` returns, and a field filled from an untyped value keeps the type it was
    --- declared with rather than the one it now holds.
    annotationKeyMemo: any

    --- Every declaration the project exports, once something asked for it.
    projectIndex: envMod.Index?

    --- Set while the compiler's own prelude is being checked, which happens while the
    --- environment is being made and before any project declaration is in scope.
    bootstrapping: boolean?

    --- What the project index answers with while that is true. Kept rather than rebuilt
    --- so the bootstrap's repeated lookups share one empty index, and separate from
    --- `projectIndex` so the real one is still built the first time project code asks.
    bootstrapIndex: envMod.Index?

    --- The nominals the index's entries carry. Longer-lived than any one index, so a
    --- declaration site keeps its identity across a rebuild of it.
    projectNominals: {[string]: types.Type}?
end

----------------------------------------------------------------------------
-- Paths and directory walks
----------------------------------------------------------------------------

local modulePatterns = {
    "/%s.d.nupp",
    "/%s.nupp",
    "/%s.g.nupp",
    "/%s.lua",
    "/%s/init.nupp",
    "/%s/init.g.nupp",
    "/%s/init.lua",
}

-- The compiler's own declarations, wherever this build keeps them.
local bundledSource = bundledMod.source

--- Whether a prelude has been built in this process yet.
---
--- Only the first environment in a process may read a stored prelude, and every
--- one after it checks the prelude the way they all used to.
---
--- Because interning is process-wide while a nominal's identity is not. A second
--- environment that checks the prelude declares its own nominals, so the types it
--- builds from them have keys nothing has interned yet and it gets a graph of its
--- own. A second environment handed a stored prelude has the first environment's
--- keys, so `intern` answers with the first environment's types -- which point at
--- the first environment's nominals, while the rest of the second environment
--- points at its own copies. One environment, two objects for one nominal, and a
--- checker that cannot see an owned value being dropped.
---
--- Restoring per-environment nominal identity would mean rewriting the keys that
--- spell it, which is a larger change to how `nupp.compiler.types` hands out
--- identity than this is. Meanwhile a command builds one environment, which is
--- the case this exists for; a process that builds several is a test harness, and
--- it pays what it always paid.
local preludeServed = false

local runtimeModulePatterns = {"/%s.nupp", "/%s.g.nupp", "/%s.lua", "/%s/init.nupp", "/%s/init.g.nupp", "/%s/init.lua",}

local function moduleDir()
    local src = debug.getinfo(1, "S").source
    return src:match("^@(.*)[/\\]") or "."
end

--- The source checkout containing the running compiler, when it has one. A stamped
--- compiler deliberately returns nil: it can compile a project, but it cannot promise
--- Cargo source it did not carry inside its one-file payload.
function envMod.compilerRoot(): string?
    local dir = moduleDir():gsub("\\", "/")
    local hostOs: any = rawget(_G, "os")
    return dir:match("^(.*)/src/nupp/compiler$") or hostOs and hostOs.getenv("NUPP_COMPILER_ROOT") or nil
end

local function readFile(path)
    local f = io.open(path, "rb")
    if not f then
        return nil
    end
    local content = f:read("*a")
    f:close()

    return content
end

-- Parenthesized so the replacement count `gsub` also returns cannot ride along as a
-- stray second argument wherever a path is passed on.
local function normalizePath(path)
    path = path:gsub("\\", "/"):gsub("/+", "/")
    path = path:gsub("^%./", ""):gsub("/%./", "/")
    return (path:gsub("/$", ""))
end

local function isAbsolutePath(path)
    return path:sub(1, 1) == "/" or path:match("^[A-Za-z]:/") ~= nil
end

-- A project's own root is one of the roots searched, so this walks the whole checkout,
-- and a checkout holds a version-control store and possibly a nest of worktrees.
-- `isBookkeepingPath` throws those away afterwards, which is correct and much too late:
-- on this compiler the walk found eight hundred source files to keep a hundred, and
-- cost more than everything the command then did with them. Pruning is the same rule
-- applied one step earlier, at the directory rather than the path, so the answer is
-- unchanged.
--
-- The walk is `nupp.io.files`. It used to be `find` wherever there was a shell and the
-- native walk everywhere else, which spawned a process per listing and pruned nothing
-- on the platform that could least afford the walk.
--
-- A command lists more than once, because the project view and the source view are
-- different questions, so what a root answered is remembered on the environment. That
-- is the lifetime `env.projectIndex` already has: which files a project consists of is
-- settled when the environment is made. An editor session republishes its own view as
-- buffers open and close (`incremental.updateProjectFiles`) rather than re-reading the
-- tree, so nothing that was watching a directory loses sight of it here.
local listingsByEnv = setmetatable({}, {__mode = "k"})

local function skipBookkeepingDirectory(name)
    return name:sub(1, 1) == "."
end

local function listLjppFiles(env, root, withDeclarations)
    local listings = listingsByEnv[env]
    if not listings then
        listings = {}
        listingsByEnv[env] = listings
    end
    local key = (withDeclarations and "d\0" or "\0") .. root
    if listings[key] then
        return listings[key]
    end
    local files = {}
    local fs = compilerPrivate("fs")
    for _, path in ipairs(fs.listFiles(root, skipBookkeepingDirectory)) do
        if path:match("%.nupp$") and (withDeclarations or not path:match("%.d%.nupp$")) then
            files[#files + 1] = normalizePath(path)
        end
    end
    listings[key] = files

    return files
end

-- Generated output is not written by hand, and a dot-directory is somebody else's
-- bookkeeping: a VCS store, a nested worktree.
local function isBookkeepingPath(path, outDir, rootDir)
    local generated = path == outDir or path:sub(1, #outDir + 1) == outDir .. "/"
    -- Asked of the path below the project, not of the whole of it. A checkout
    -- can itself sit under a dot-directory -- a worktree in `.claude`, a source
    -- tree under `~/.local` -- and testing the absolute path called every file
    -- in it somebody else's bookkeeping, so the project had no sources at all.
    local relative = path
    if rootDir and rootDir ~= "" and rootDir ~= "." and path:sub(1, #rootDir + 1) == rootDir .. "/" then
        relative = path:sub(#rootDir + 2)
    end
    local hidden = ("/" .. relative):find("/%.") ~= nil

    return generated or hidden
end

----------------------------------------------------------------------------
-- The files a project consists of
----------------------------------------------------------------------------

local function outDirFor(env)
    local rootDir = env.rootDir or "."
    local build = (env.config or {}).build or {}
    return normalizePath(rootDir .. "/" .. (build.outDir or "build"))
end

--- Where this project's build output goes, which is also where anything cached between
--- commands belongs: it is already ignored by version control and already deleted by
--- `nupp clean`.
function envMod.outDir(env: envMod.Env): string
    return outDirFor(env)
end

function envMod.listProjectFiles(env: envMod.Env): {string}
    if env.memoryOnly then
        return {}
    end
    local files, seen = {}, {}
    local outDir = outDirFor(env)
    for _, root in ipairs(env.roots or {}) do
        for _, path in ipairs(listLjppFiles(env, root)) do
            if not seen[path] and not isBookkeepingPath(path, outDir, env.rootDir) then
                seen[path] = true
                files[#files + 1] = path
            end
        end
    end
    table.sort(files)

    return files
end

-- Every file the project is written in, declarations included.
--
-- Deliberately not the whole tree, and deliberately not the module list either.
--
-- Not the tree, because a tree also holds build output, a tracked bootstrap and test
-- fixtures, files nobody writes by hand, and a formatter that rewrites them breaks the
-- build to tidy something that was never untidy. The include roots are where a project
-- itself says its source lives, so they are what is taken; a project that declares none
-- is its own root.
--
-- Not the module list, because a declaration file is source: the formatter has a
-- doctrine for the typed layer a `.d.nupp` is entirely made of. Nothing requires one as
-- a module, which is why the module list drops them, but somebody wrote it and somebody
-- reads it.
--
-- `withDeclarations` false drops the `.d.nupp` files again, which is what a build
-- wants: they describe an interface somebody else implements, so there is nothing to
-- compile.
function envMod.listSourceFiles(env: envMod.Env, withDeclarations: boolean?): {string}
    if env.memoryOnly then
        return {}
    end
    if withDeclarations == nil then
        withDeclarations = true
    end
    local rootDir = env.rootDir or "."
    local roots = {}
    for _, dir in ipairs((env.config or {}).include or {}) do
        roots[#roots + 1] = rootDir .. "/" .. dir
    end
    if #roots == 0 then
        roots[1] = rootDir
    end
    local outDir = outDirFor(env)
    local files, seen = {}, {}
    for _, root in ipairs(roots) do
        for _, path in ipairs(listLjppFiles(env, root, withDeclarations)) do
            if not seen[path] and not isBookkeepingPath(path, outDir, env.rootDir) then
                seen[path] = true
                files[#files + 1] = path
            end
        end
    end
    table.sort(files)

    return files
end

--- Whether `path` is one of the files the project index is built from.
---
--- Answers from the path alone, which is the point: `listProjectFiles` shells out and
--- `ensureProjectIndex` parses everything it finds, so a caller that only wants to know
--- whether a file could be in the index should not have to build the index to be told
--- no. Declaration files count -- they are project source and they declare globals --
--- which is where this parts company with `moduleNameForPath`, whose answer is a module
--- name and so excludes them.
--- Where a project at `rootDir` looks for its own modules: the root itself, and each
--- directory the manifest includes.
---
--- Separate from `envMod.new` so a caller can ask whether a path is one of a project's
--- modules without building an environment to ask with. Deciding that is what tells
--- `nupp check FILE` whether to check the file through the project or on its own, and
--- building an environment to find out would mean building one for the answer "no".
--- An environment starts from these and may add more -- an editor's extra folders --
--- so a yes here is a yes there, and a no is worth asking the environment about only
--- once there is an environment.
function envMod.projectRoots(rootDir: string, config: {[string]: any}?): {string}
    local roots = {rootDir}
    for _, dir in ipairs((config or {}).include or {}) do
        roots[#roots + 1] = rootDir .. "/" .. dir
    end

    return roots
end

function envMod.isProjectPath(env: envMod.Env, path: string): boolean
    path = normalizePath(path)
    if not path:match("%.nupp$") then
        return false
    end
    if isBookkeepingPath(path, outDirFor(env), env.rootDir) then
        return false
    end
    for _, rawRoot in ipairs(env.roots or {}) do
        local root = normalizePath(rawRoot)
        if root == "." or root == "" then
            if not isAbsolutePath(path) then
                return true
            end
        elseif path:sub(1, #root + 1) == root .. "/" then
            return true
        end
    end

    return false
end

--- The module `path` would be, searched against include roots alone.
---
--- Separate from `moduleNameForPath` so a caller holding a manifest but no environment
--- can ask. That is what tells `nupp check FILE` whether the file is one of the
--- project's own modules, and so whether to check it through the project or on its own;
--- building an environment to find out would mean building one for the answer "no".
--- Roots are the only thing that decides this, and an environment's roots start as
--- `projectRoots` and only ever grow, so a name here is a name there.
function envMod.moduleNameInRoots(roots: {string}, path: string): string?
    path = normalizePath(path)
    local best = nil
    for _, rawRoot in ipairs(roots or {}) do
        local root = normalizePath(rawRoot)
        local rel = nil
        if root == "." or root == "" then
            if not isAbsolutePath(path) then
                rel = path
            end
        elseif path:sub(1, #root + 1) == root .. "/" then
            rel = path:sub(#root + 2)
        end
        if rel and rel:match("%.nupp$") and not rel:match("%.d%.nupp$") then
            rel = rel:gsub("%.g%.nupp$", ""):gsub("%.nupp$", "")
            rel = rel:gsub("/init$", "")
            local name = rel:gsub("/", ".")
            if name ~= "" and (not best or #name < #best) then
                best = name
            end
        end
    end

    return best
end

function envMod.moduleNameForPath(env: envMod.Env, path: string): string?
    path = normalizePath(path)

    -- A declaration or checked implementation installed with a rock is a module
    -- surface even though a `.d.nupp` in project source is not. Its path mirrors the
    -- runtime module beneath the package's `nupp` directory. Implementations are used
    -- by explicitly selected backends and compiled for the consuming target.
    for _, rawRoot in ipairs(env.typeRoots or {}) do
        local root = normalizePath(rawRoot)
        local rel = nil
        if path:sub(1, #root + 1) == root .. "/" then
            rel = path:sub(#root + 2)
        end
        if rel and rel:match("%.nupp$") then
            rel = rel:gsub("%.d%.nupp$", ""):gsub("%.g%.nupp$", ""):gsub("%.nupp$", ""):gsub("/init$", "")
            local name = rel:gsub("/", ".")
            if name ~= "" then
                return name
            end
        end
    end

    return envMod.moduleNameInRoots(env.roots or {}, path)
end

----------------------------------------------------------------------------
-- The project index
----------------------------------------------------------------------------

--- Extracts only project-index information from one overlay-aware parse.
---
--- The header itself is `nupp.compiler.header`'s, a much smaller module than this one
--- and the one a stored header is stamped against. Resolving a path to the module it
--- names is the part that needs an environment, so that happens here.
function envMod.projectHeader(env: envMod.Env, path: string, parsed: parser.ParseResult?): envMod.Header
    path = normalizePath(path)

    return headerMod.of(path, envMod.moduleNameForPath(env, path), parsed)
end

-- Builds the lookup tables from per-file headers. `nominals` is deliberately
-- longer-lived than an index revision so declaration-site identity survives overlay
-- edits and dependent query rechecks.
function envMod.buildProjectIndex(headers: {envMod.Header}?, nominals: {[string]: types.Type}?): envMod.Index
    local index = {
        byName = {},
        byPath = {},
        modules = {},
        annotationsByName = {},
        -- Final path segment -> the modules that end in it. Nothing resolves through
        -- this: a module is reached by requiring it. It exists so an unknown name that
        -- happens to name a module can say so, which is the one thing a reader loses by
        -- that name meaning nothing.
        moduleBasenames = {},
        declaredModules = {},
        moduleDefinitions = {},
        registrationDiagnostics = {},
    }
    nominals = nominals or {}
    local declaredHeaders = {}
    for _, header in ipairs(headers or {}) do
        local moduleName = header.moduleName
        if moduleName then
            local previous = declaredHeaders[moduleName]
            if previous and type(header.declaredModuleName) == "string" then
                index.registrationDiagnostics[
                    #index.registrationDiagnostics + 1
                ] = {
                    path = header.path,
                    token = header.moduleToken,
                    msg = ("module %q is declared by more than one file"):format(moduleName),
                    related = {
                        {
                            filename = previous.path,
                            line = previous.moduleToken and previous.moduleToken.line or 0,
                            col = previous.moduleToken and previous.moduleToken.col or 0,
                            msg = "the first declaration is here",
                        },
                    },
                }
            elseif type(header.declaredModuleName) == "string" then
                declaredHeaders[moduleName] = header
            end
            index.modules[moduleName] = header.path
            if type(header.declaredModuleName) == "string" then
                index.declaredModules[moduleName] = true
                index.moduleDefinitions[
                    moduleName
                ] = {filename = header.path, token = header.moduleToken, name = moduleName, kind = "module",}
            end
            local short = moduleName:match("([^.]+)$")
            local named = index.moduleBasenames[short] or {}
            named[#named + 1] = moduleName
            index.moduleBasenames[short] = named
        end
        local occurrences = {}
        for _, declaration in ipairs(header.declarations or {}) do
            local occurrenceKey = declaration.name .. "\0" .. declaration.kind .. "\0" .. declaration.visibility
            occurrences[occurrenceKey] = (occurrences[occurrenceKey] or 0) + 1
            local identityKey = header.path .. "\0" .. occurrenceKey .. "\0" .. tostring(occurrences[occurrenceKey])
            local entry = {
                name = declaration.name,
                path = header.path,
                moduleName = moduleName,
                visibility = declaration.visibility,
                kind = declaration.kind,
                signature = declaration.signature,
                definition = {
                    filename = header.path,
                    token = declaration.token,
                    name = declaration.name,
                    kind = declaration.kind == "record" and "type" or declaration.kind,
                    deprecated = declaration.deprecated,
                    comptimeOnly = declaration.comptimeOnly,
                },
            }
            if declaration.statKind == "recordDecl" then
                local nominal = nominals[identityKey]
                if not nominal then
                    nominal = T.nominal(entry.name, entry.kind)
                    nominals[identityKey] = nominal
                end
                entry.type = nominal
            end
            local named = index.byName[entry.name] or {}
            named[#named + 1] = entry
            index.byName[entry.name] = named
            local inFile = index.byPath[header.path] or {}
            inFile[#inFile + 1] = entry
            index.byPath[header.path] = inFile
            if declaration.isAnnotation then
                local definitions = index.annotationsByName[entry.name] or {}
                definitions[#definitions + 1] = entry
                index.annotationsByName[entry.name] = definitions
            end
        end
    end
    local reserved = {
        pin = true,
        borrow = true,
        borrowFrom = true,
        region = true,
        partition = true,
        attemptAll = true,
        sizeof = true,
        alignof = true,
        offsetof = true,
        types = true,
        reflect = true,
    }
    for moduleName, header in pairs(declaredHeaders) do
        local first = moduleName:match("^nupp%.([^.]+)")
        if first and reserved[first] then
            index.registrationDiagnostics[
                #index.registrationDiagnostics + 1
            ] = {
                path = header.path,
                token = header.moduleToken,
                msg = ("module %q collides with compiler-owned nupp.%s"):format(moduleName, first),
            }
        end
        local parent = moduleName:match("^(.*)%.[^.]+$")
        while parent do
            local parentHeader = declaredHeaders[parent]
            if parentHeader then
                local child = moduleName:sub(#parent + 2):match("^[^.]+")
                for _, declaration in ipairs(parentHeader.declarations or {}) do
                    if declaration.visibility == "module" and declaration.name == child then
                        index.registrationDiagnostics[
                            #index.registrationDiagnostics + 1
                        ] = {
                            path = header.path,
                            token = header.moduleToken,
                            msg = ("module %q collides with export %s.%s"):format(moduleName, parent, child),
                            related = {
                                {
                                    filename = parentHeader.path,
                                    line = declaration.token and declaration.token.line or 0,
                                    col = declaration.token and declaration.token.col or 0,
                                    msg = "the colliding export is here",
                                },
                            },
                        }
                    end
                end
            end
            parent = parent:match("^(.*)%.[^.]+$")
        end
        if moduleName == "nupp" then
            for _, declaration in ipairs(header.declarations or {}) do
                if declaration.visibility == "module" and reserved[declaration.name] then
                    index.registrationDiagnostics[
                        #index.registrationDiagnostics + 1
                    ] = {
                        path = header.path,
                        token = declaration.token,
                        msg = (
                            "export %q collides with compiler-owned nupp.%s"
                        ):format(declaration.name, declaration.name),
                    }
                end
            end
        end
    end
    for _, named in pairs(index.moduleBasenames) do
        table.sort(named)
    end

    return index
end

----------------------------------------------------------------------------
-- Stores kept between commands
----------------------------------------------------------------------------

--- The store of headers this project has already worked out, opened on first use.
---
--- Lazy because opening it costs a digest of the compiler tree, and most environments
--- never build a project index at all -- a check of one file outside a project, a test
--- fixture, the bundled declarations. The cost only makes sense against the parse of
--- every file in the project, so it is paid at the point that parse would otherwise
--- happen.
function envMod.headerStore(env: envMod.Env): envMod.Store?
    if env.headerStoreOpened then
        return env.headerStore
    end
    env.headerStoreOpened = true
    if env.cacheDisabled then
        return nil
    end
    local storeMod: any = buildPrivate("store")
    local cacheMod: any = buildPrivate("cache")
    -- The part of the compiler that computes a header, and nothing else. A stamp is
    -- all-or-nothing -- a store that does not match it is emptied -- so only what
    -- invalidates every entry at once belongs here, and for a header that is the parser
    -- and `nupp.compiler.header`. Stamping with the whole compiler, which is what this
    -- did, threw away every header in the project whenever any part of the compiler was
    -- edited, and the next command reparsed all of it. A build, a check of one named
    -- file, and an editor session each assemble a slightly different environment, and
    -- if that difference were in the stamp they would take turns discarding each
    -- other's work. It goes in the key instead, where the entries coexist.
    local cacheDir = env.cacheDir or (outDirFor(env) .. "/cache")
    env.headerStore = storeMod.open(
        cacheDir .. "/headers.buf",
        cacheMod.subsystemFingerprint({"nupp.compiler.header"}, cacheDir)
    )

    return env.headerStore
end

--- The key a file's header is stored under: everything the header was computed from
--- that the compiler's own identity does not cover.
---
--- That is the file, its bytes, and the module name the path resolves to -- the name
--- because a header carries it, and the include roots are what decide it.
---
--- The name rather than the roots that produced it. A build adds its generated
--- directory to the include list and nothing else does, so keying on the roots gave a
--- build and a plain environment two names for one answer: every entry a build wrote
--- missed for a check, an editor session, and every test that makes an environment of
--- its own. The name is what the header actually depends on, and a root that changes
--- no name now changes no key.
function envMod.headerKey(env: envMod.Env, path: string, text: string): string
    local hashMod: any = buildPrivate("hash")
    local name = envMod.moduleNameForPath(env, path)

    return hashMod.digest((name or "") .. "\0" .. normalizePath(path) .. "\0" .. text)
end

--- A digest of every annotation the project declares.
---
--- For a caller whose answer depends on annotations and on nothing else the project
--- holds -- the formatter, which omits a single-value annotation's member name and so
--- has to know which member that is. Keying on the whole project index would reformat
--- the world whenever any declaration anywhere moved; this moves only when an
--- annotation does.
---
--- The signature is the declaration's source text and `singleValue` is a mark on one of
--- its fields, so a signature that has not moved describes an annotation that behaves
--- the same.
function envMod.annotationKey(env: envMod.Env): string
    if env.annotationKeyMemo then
        return env.annotationKeyMemo
    end
    -- Not `projectIndexFor`, which is a local declared further down this file than this
    -- is. Same indirection: an overlay-aware session installs its own, and it has to
    -- win here too.
    local ensure = env.ensureProjectIndex or envMod.ensureProjectIndex
    local index = ensure(env)
    local parts = {}
    for name, entries in pairs(index.annotationsByName or {}) do
        for _, entry in ipairs(entries) do
            parts[#parts + 1] = name .. "\0" .. tostring(entry.path) .. "\0" .. tostring(entry.signature)
        end
    end
    table.sort(parts)
    local hashMod: any = buildPrivate("hash")
    env.annotationKeyMemo = hashMod.digest(table.concat(parts, "\1"))

    return env.annotationKeyMemo
end

--- The store of formatting verdicts, opened on first use.
---
--- Its own file rather than a corner of the header store, because a project may format
--- without checking or check without formatting, and one file per question keeps a run
--- that only does one from rewriting what it does not know about.
function envMod.formatStore(env: envMod.Env): envMod.Store?
    if env.formatStoreOpened then
        return env.formatStore
    end
    env.formatStoreOpened = true
    if env.cacheDisabled then
        return nil
    end
    local storeMod: any = buildPrivate("store")
    local cacheMod: any = buildPrivate("cache")
    local cacheDir = env.cacheDir or (outDirFor(env) .. "/cache")
    env.formatStore = storeMod.open(
        cacheDir .. "/format.buf",
        cacheMod.subsystemFingerprint({"nupp.compiler.fmt"}, cacheDir)
    )

    return env.formatStore
end

function envMod.typeFunctionStore(env: envMod.Env): envMod.Store?
    if env.typeFunctionStoreOpened then
        return env.typeFunctionStore
    end
    env.typeFunctionStoreOpened = true
    if env.cacheDisabled then
        return nil
    end
    local storeMod: any = buildPrivate("store")
    local cacheMod: any = buildPrivate("cache")
    local cacheDir = env.cacheDir or (outDirFor(env) .. "/cache")
    env.typeFunctionStore = storeMod.open(
        cacheDir .. "/type-functions.buf",
        cacheMod.subsystemFingerprint({"nupp.compiler.check"}, cacheDir)
    )

    return env.typeFunctionStore
end

--- Writes back what this environment worked out that the next command can reuse. Doing
--- nothing is always allowed; it only costs the next command.
function envMod.persist(env: envMod.Env): nil
    if env.headerStore then
        env.headerStore.save()
    end
    if env.formatStore then
        env.formatStore.save()
    end
    if env.typeFunctionStore then
        env.typeFunctionStore.save()
    end
end

----------------------------------------------------------------------------
-- Asking the index
----------------------------------------------------------------------------

-- Builds a declaration-header index without checking bodies. Nominal export skeletons
-- are allocated here, giving them stable declaration-site identity and allowing
-- mutually recursive project types to see one another.
function envMod.ensureProjectIndex(env: envMod.Env): envMod.Index
    -- The prelude is the compiler's own source, checked while the environment is being
    -- made and before the project has been looked at. A project declaration is not in
    -- scope for it: the names it resolves are its own, and one a project happens to
    -- spell the same way is a different name that the prelude must not pick up.
    --
    -- Answering those lookups from the project is also what made every environment read
    -- the whole project. A fragment a test checks needs the prelude and nothing else,
    -- and the index this forced cost more than everything else such a test did.
    if env.bootstrapping then
        env.bootstrapIndex = env.bootstrapIndex or envMod.buildProjectIndex({}, env.projectNominals)

        return env.bootstrapIndex
    end
    if env.projectIndex then
        return env.projectIndex
    end
    -- `any` because `key` is where the store's absence is already answered: it is
    -- truthy only when there is a store to key into, and that is a fact about two
    -- locals rather than about either one.
    local store: any = envMod.headerStore(env)
    local headers = {}
    for _, path in ipairs(envMod.listProjectFiles(env)) do
        local source = readFile(path)
        local header = nil
        local key = source and store and envMod.headerKey(env, path, source)
        if key then
            header = store.get(key)
        end
        if not header then
            header = envMod.projectHeader(env, path, source and parser.parse(source, path) or nil)
            if key then
                store.put(key, header)
            end
        end
        headers[#headers + 1] = header
    end
    env.projectNominals = env.projectNominals or {}
    env.projectIndex = envMod.buildProjectIndex(headers, env.projectNominals)

    return env.projectIndex
end

local function projectIndexFor(env)
    local ensure = env.ensureProjectIndex or envMod.ensureProjectIndex
    return ensure(env)
end

function envMod.declarationType(
    env: envMod.Env,
    filename: string,
    name: string,
    kind: string,
    visibility: string
): types.Type?, envMod.Entry?
    if visibility ~= "module" and visibility ~= "global" then
        return nil
    end
    -- The answer is an entry the index holds under this file. A file the index was not
    -- built from has no entries there, so the whole index would be built to look up a
    -- key it cannot contain -- and the bundled prelude, which is nothing but module-
    -- and global-visible declarations, made that happen on the way to every single
    -- command.
    if not envMod.isProjectPath(env, filename) then
        return nil
    end
    local path = normalizePath(filename)
    local entries = env.projectPathEntries and env.projectPathEntries(
        env,
        path
    ) or projectIndexFor(env).byPath[path] or {}
    for _, entry in ipairs(entries) do
        if entry.name == name and entry.kind == kind and entry.visibility == visibility then
            return entry.type, entry
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- Finding a module's file
----------------------------------------------------------------------------

local function findModulePath(env, name, patterns)
    if env.memoryOnly then
        return nil
    end
    local rel = name:gsub("%.", "/")
    for _, root in ipairs(env.roots) do
        for _, pattern in ipairs(patterns) do
            local candidate = root .. pattern:format(rel)
            local f = io.open(candidate, "rb")
            if f then
                f:close()
                return candidate
            end
        end
    end
    for _, root in ipairs(env.typeRoots or {}) do
        for _, pattern in ipairs(patterns) do
            local candidate = root .. pattern:format(rel)
            local f = io.open(candidate, "rb")
            if f then
                f:close()
                return candidate
            end
        end
    end

    return nil
end

function envMod.isDependencyTypePath(env: envMod.Env, path: string): boolean
    path = normalizePath(path)
    for _, rawRoot in ipairs(env.typeRoots or {}) do
        local root = normalizePath(rawRoot)
        if path:sub(1, #root + 1) == root .. "/" then
            return true
        end
    end
    for _, rawRoot in ipairs(env.ambientTypeRoots or {}) do
        local root = normalizePath(rawRoot)
        if path:sub(1, #root + 1) == root .. "/" then
            return true
        end
    end

    return false
end

--- Reads foreign type declarations as checker facts only. The parser and checker see
--- the comments and assignments which describe ambient tables, while the generator and
--- runtime loader never receive a path from this list.
---
--- A declaration tree is somebody else's source, pinned at a revision this project
--- chose but did not write. One file in it that this checker cannot read is a fact
--- about that file, so it is recorded against the file and the rest of the tree is
--- read: a project does not lose the whole of an API because one corner of it is
--- spelled in a way the importer has yet to learn. `env.ambientTypeProblems` is what
--- the caller reports, and it is what makes such a corner visible instead of silent.
local function loadAmbientTypeRoots(env: envMod.Env, roots: {string})
    if #roots == 0 then
        return
    end
    local listFiles = compilerPrivate("fs").listFiles
    local problems = env.ambientTypeProblems or {}
    env.ambientTypeProblems = problems
    -- One report per file. The reader's question is which file was skipped and what
    -- stopped it, and a file whose first construct the importer could not take usually
    -- has several; listing them all buries the answer under repetitions of it.
    local refused: {[string]: boolean} = {}
    local function refuse(path: string, why: string, line: integer?, col: integer?)
        if refused[path] then
            return
        end
        refused[path] = true
        problems[#problems + 1] = {path = path, msg = why, line = line or 1, col = col or 1}
    end

    for _, root in ipairs(roots) do
        local files = {}
        for _, path in ipairs(listFiles(root)) do
            if path:match("%.lua$") then
                files[#files + 1] = path
            end
        end
        table.sort(files)
        for _, path in ipairs(files) do
            local source, readErr = readFile(path)
            if not source then
                refuse(path, "cannot be read: " .. tostring(readErr))
            else
                local result = parser.parse(source, path)
                if #result.errors > 0 then
                    local problem = result.errors[1]
                    refuse(path, "cannot be parsed: " .. tostring(problem.msg))
                else
                    -- The check is what records the declarations, so its facts are kept
                    -- whatever it also reported. A fatal diagnostic names a construct
                    -- the importer could not take; the ones beside it were still taken.
                    local ok, diags = pcall(check.check, result, path, env as any, {
                        declareGlobals = true,
                        declarationFile = true,
                        strict = false,
                    })
                    if not ok then
                        refuse(path, "cannot be checked: " .. tostring(diags))
                    else
                        for _, diagnostic in ipairs(diags as {any}) do
                            if diagnostics.isFatal(diagnostic) then
                                refuse(
                                    path,
                                    tostring(diagnostic.code) .. " " .. tostring(diagnostic.msg),
                                    diagnostic.line,
                                    diagnostic.col
                                )
                            end
                        end
                    end
                end
            end
        end
    end
end

-- Finds the file backing module `name`, or nil. Shared by the batch resolver below and
-- the incremental engine.
function envMod.findModulePath(env: envMod.Env, name: string): string?
    return findModulePath(env, name, modulePatterns)
end

-- Runtime loading deliberately excludes declaration files, but includes plain Lua so
-- execution uses the same roots and precedence as type resolution. If no project module
-- exists, require() continues through Lua's remaining loaders.
function envMod.findRuntimeModulePath(env: envMod.Env, name: string): string?
    return findModulePath(env, name, runtimeModulePatterns)
end

----------------------------------------------------------------------------
-- Loading a module
----------------------------------------------------------------------------

local function seededExports(env, path)
    local exports = {types = {}, typeDefs = {}, values = {}, valueDefs = {}, comptimeFunctions = {}}
    path = normalizePath(path)
    local entries = env.projectPathEntries and env.projectPathEntries(
        env,
        path
    ) or projectIndexFor(env).byPath[path] or {}
    for _, entry in ipairs(entries) do
        if entry.visibility == "module" and entry.type then
            exports.types[entry.name] = entry.type
            exports.typeDefs[entry.name] = entry.definition
            if entry.kind == "struct" then
                exports.values[entry.name] = entry.type
            end
        end
    end

    return exports
end

--- The exact provider module a selected seam has standing in for this one.
---
--- A runtime seam may replace one complete public module, and every reader of that
--- module has to agree about it. Answering here rather than at each of them is what
--- keeps a record the provider declares from being one nominal where it is named as
--- a type and a different one where it is constructed.
---
--- @return the module the artifact will actually require, or the name it was given
local function suppliedModule(env: any, name: string): string
    for seamName, selected in pairs(env.backendResolution and env.backendResolution.seams or {}) do
        local contract = require("nupp.runtime.seam.registry").get(seamName)
        local member = contract.modules and contract.modules[name] or nil
        if member == "" and selected.runtimeModule ~= name then
            return selected.runtimeModule as string
        end
    end

    return name
end

local function loadModule(env, name)
    local cached = env.loaded[name]
    if cached then
        return cached
    end
    -- Type the module the artifact will actually require, not a native implementation
    -- that happens to share the public name.
    local supplied = suppliedModule(env, name)
    if supplied ~= name then
        local replacement = loadModule(env, supplied)
        if replacement then
            env.loaded[name] = replacement
        end

        return replacement
    end
    if env.memoryOnly then
        local bundled = env.bundled and env.bundled[name] or nil
        if bundled then
            env.loaded[name] = bundled
            return bundled
        end
    end
    local path = envMod.findModulePath(env, name)
    if not path then
        -- bundled declarations are the fallback, so a project may ship its own file for
        -- a bundled name and have it win
        local bundled = env.bundled and env.bundled[name]
        return bundled
    end
    path = normalizePath(path)
    local byPath = env.loadedPaths[path]
    if byPath then
        env.loaded[name] = byPath
        return byPath
    end
    local src = readFile(path)
    if not src then
        return nil
    end
    local result = parser.parse(src, path)
    local declaredModuleName = #result.errors == 0 and cst.declaredModule(result.root) or nil
    local record = {
        inProgress = true,
        path = path,
        exports = seededExports(env, path),
        declared = declaredModuleName ~= nil and cst.exportAssignment(result.root) == nil,
    }
    env.loaded[name] = record
    env.loadedPaths[path] = record
    if #result.errors == 0 then
        local _, moduleType, exports = check.check(result, path, env, {
            moduleName = name,
            initialExports = record.exports,
        })
        record.type = moduleType or T.any
        record.exports = exports or record.exports
    else
        record.type = T.any
    end
    record.inProgress = false

    return record
end

local function interfaceType(exports): types.Type
    local fields = {}
    for name, t in pairs(exports and exports.values or {}) do
        fields[#fields + 1] = {name = name, read = t}
    end
    table.sort(fields, function(a, b)
        return a.name < b.name
    end)

    return T.shape(fields)
end

-- Resolves `name` ("a.b.c") against the search roots; returns the module's runtime
-- value type, caching per path. Cycles yield any for the value layer.
function envMod.resolveModule(env: envMod.Env, name: string): types.Type?
    local record = loadModule(env, name)
    if not record then
        return nil
    end

    -- A recursive edge sees the stable interface entries already registered by the
    -- declaration hoist. Returning `any` here erased exactly the contracts grouped
    -- checking exists to preserve.

    return record.inProgress and (record.declared and interfaceType(record.exports) or T.any) or record.type
end

function envMod.resolveModuleExports(env: envMod.Env, name: string): envMod.Exports?
    local record = loadModule(env, name)
    return record and record.exports or nil
end

function envMod.moduleInitializing(env: envMod.Env, name: string): boolean
    local record = env.loaded and env.loaded[name] or nil
    return record and record.inProgress == true or false
end

function envMod.resolveCallGuarantees(env: envMod.Env, module: string, member: string): envMod.CallGuarantees?
    local exports = envMod.resolveModuleExports(env, module)
    return exports and exports.callGuarantees and exports.callGuarantees[member] or nil
end

function envMod.observeCallGuarantee(
    env: envMod.Env,
    module: string,
    member: string,
    identity: string,
    guarantee: string
): boolean
    local entry = envMod.resolveCallGuarantees(env, module, member)
    if not entry then
        return false
    end
    if guarantee == "noAllocate" then
        return entry.noAllocate == true
    elseif guarantee == "noRaise" then
        return entry.noRaise == true
    end

    return false
end

----------------------------------------------------------------------------
-- Resolving a name through the project
----------------------------------------------------------------------------

-- Only a global is reachable without saying where it comes from; a module member is
-- reached through the table it was declared on. Two globals of one name conflict
-- wherever they sit, so there is no nearest-wins rule to apply.
local function globalEntry(entries, kind)
    local found = nil
    local matches = {}
    for _, entry in ipairs(entries or {}) do
        if entry.visibility == "global" and (not kind or entry.kind == kind) then
            matches[#matches + 1] = entry
            found = entry
        end
    end
    if #matches > 1 then
        return nil, "ambiguous project type", matches
    end

    return found
end

-- Loading the declaring module is what fills the index entry's type in, so an
-- unqualified global resolves on the first reference to it.
local function loadedGlobal(env, entries, kind)
    local entry, err, conflicts = globalEntry(entries, kind)
    if not entry then
        return nil, err, conflicts
    end
    if entry.moduleName then
        env.resolveModuleExports(env, entry.moduleName)
    end

    return entry, nil
end

function envMod.resolveProjectType(
    env: envMod.Env,
    filename: string,
    name: string
): types.Type?, envMod.Definition?, string?, string?, string?, {envMod.Entry}?
    local entries = env.projectEntries and env.projectEntries(env, name) or projectIndexFor(env).byName[name]
    local entry, err, conflicts = loadedGlobal(env, entries)
    if not entry then
        return nil, nil, err, nil, nil, conflicts
    end

    return entry.type, entry.definition, nil, entry.moduleName, entry.visibility
end

-- The modules whose final path segment is `short`, for diagnostics only. A file of this
-- name existing is what makes a missing `require` worth mentioning rather than leaving
-- the name to mean nothing until it is run.
function envMod.modulesNamed(env: envMod.Env, short: string): {string}?
    if env.projectModuleBasenames then
        return env.projectModuleBasenames(env, short)
    end
    return projectIndexFor(env).moduleBasenames[short]
end

-- The modules exporting a type named `name`, for the fix that offers the qualified
-- spelling of an unqualified type nobody declared here. Reads the declaration-header
-- index only: a name being exported somewhere is a syntactic fact, and loading those
-- modules to say so would check the project to answer a question about a program that
-- does not compile.
function envMod.modulesExporting(env: envMod.Env, name: string): {string}
    local modules, seen = {}, {}
    local entries = env.projectEntries and env.projectEntries(env, name) or projectIndexFor(env).byName[name] or {}
    for _, entry in ipairs(entries) do
        if entry.visibility == "module" and entry.moduleName and not seen[entry.moduleName] then
            seen[entry.moduleName] = true
            modules[#modules + 1] = entry.moduleName
        end
    end
    table.sort(modules)

    return modules
end

function envMod.resolveProjectValue(
    env: envMod.Env,
    filename: string,
    name: string
): types.Type?, envMod.Definition?, string?, string?, {envMod.Entry}?
    local entries = env.projectEntries and env.projectEntries(env, name) or projectIndexFor(env).byName[name]
    local entry, err, conflicts = loadedGlobal(env, entries, "struct")
    if not entry then
        return nil, nil, err, nil, conflicts
    end

    return entry.type, entry.definition, nil, entry.moduleName
end

-- Resolves a project annotation lazily. Loading the module checks its
-- @annotation declaration, which installs the typed schema into this environment's
--     registry before the caller validates the application.
function envMod.resolveProjectAnnotation(env: envMod.Env, filename: string, name: string): table?, string?
    local entries = env.projectAnnotations and env.projectAnnotations(
        env,
        name
    ) or projectIndexFor(env).annotationsByName[name]
    if not entries or #entries == 0 then
        return nil
    end
    if #entries > 1 then
        return nil, "ambiguous project annotation @" .. name
    end
    local entry = entries[1]
    if normalizePath(entry.path) ~= normalizePath(filename) and entry.moduleName then
        env.resolveModuleExports(env, entry.moduleName)
    end

    return env.annotations:get(name), nil
end

function envMod.resolveQualifiedType(
    env: envMod.Env,
    filename: string,
    moduleName: string,
    typeName: string
): types.Type?, envMod.Definition?, string?
    -- The module interface deliberately fingerprints nominal identity without walking
    -- its members. Record the declaration surface separately so reflection and other
    -- readers of qualified nominals observe field and annotation changes.
    if env.projectEntries then
        env.projectEntries(env, typeName)
    end
    local names = {moduleName}
    local currentModule = envMod.moduleNameForPath(env, filename)
    local currentDir = currentModule and currentModule:match("^(.*)%.[^.]+$")
    if currentDir and not moduleName:find("%.", 1, false) then
        table.insert(names, 1, currentDir .. "." .. moduleName)
    end
    local self_ = normalizePath(filename)
    for _, candidate in ipairs(names) do
        -- A file's own declarations are already in scope, so resolving its module here
        -- would only re-enter the check that is running and cache the half-built
        -- exports it finds.
        local candidatePath = envMod.findModulePath(env, candidate)
        if not candidatePath or normalizePath(candidatePath) ~= self_ then
            -- `any` for the same reason as the store in `ensureProjectIndex`: `t` is
            -- truthy only when there were exports to read it out of.
            local exports: any = env.resolveModuleExports(env, candidate)
            local t = exports and exports.types[typeName] or nil
            if t then
                return t, exports.typeDefs[typeName], candidate
            end
        end
    end

    return nil
end

-- The nominal a module exports under `typeName`, for the value path: a record's runtime
-- table and a struct's ctype are values as well as types, and the module table they sit
-- on is inferred open, so this pairing is known nowhere else.
--
-- The project index decides first whether there is a declaration to find, which costs
-- no loading. Only then is the declaring module resolved, so an ordinary field access
-- on a required module never pulls that module in mid-check while a construction still
-- resolves whatever order the files are reached in.
function envMod.exportedNominal(env: envMod.Env, moduleName: string, typeName: string): types.Type?, envMod.Definition?
    local entry = nil
    local entries = env.projectEntries and env.projectEntries(
        env,
        typeName
    ) or projectIndexFor(env).byName[typeName] or {}
    for _, candidate in ipairs(entries) do
        if candidate.moduleName == moduleName and candidate.visibility == "module" and (
            candidate.kind == "record" or candidate.kind == "struct"
        ) then
            entry = candidate
            break
        end
    end
    if not entry then
        -- A selected seam may replace this whole module with an exact provider, and
        -- the type path already resolves through the provider. Constructing a record
        -- it declares has to reach that same declaration, or one written name means
        -- two nominals and the record is not the record it was annotated as. The
        -- module is one this check has loaded anyway, since naming its type is what
        -- loaded it.
        local supplied = suppliedModule(env, moduleName)
        if supplied ~= moduleName then
            local replaced: any = env.resolveModuleExports(env, supplied)
            local exported = replaced and replaced.types[typeName] or nil
            if exported and exported.tag == "nominal" and (
                exported.declKind == "record" or exported.declKind == "struct"
            ) then
                return exported, replaced.typeDefs[typeName]
            end

            return nil
        end
        -- The index covers the project, and a module the compiler ships is not in it.
        -- A project file still names shipped records -- a `nupp.io.process.Exit`
        -- rebuilt from a stored status, say -- and without this those constructions
        -- resolve to `any`, which reads as a declaration nobody declared rather than
        -- as one the index was never going to hold.
        local bundled: any = env.bundled and env.bundled[moduleName] or nil
        local exported = bundled and bundled.exports and bundled.exports.types[typeName] or nil
        if exported and exported.tag == "nominal" and (
            exported.declKind == "record" or exported.declKind == "struct"
        ) then
            return exported, bundled.exports.typeDefs[typeName]
        end

        return nil
    end
    if entry.type then
        return entry.type, entry.definition
    end
    local exports = env.resolveModuleExports(env, moduleName)

    return exports and exports.types[typeName] or entry.type, exports and exports.typeDefs[typeName] or entry.definition
end

----------------------------------------------------------------------------
-- Making an environment
----------------------------------------------------------------------------

-- The config `dir` declares, or an empty table. A folder with no `nupp.lua` is still a
-- folder of Nupp files; it just says nothing about how to read them.
local function configAt(dir)
    local loader: any = rawget(_G, "loadfile")
    local chunk = loader and loader(dir .. "/nupp.lua") or nil
    if not chunk then
        return {}
    end
    local ok, loaded = pcall(chunk)

    return ok and type(loaded) == "table" and loaded or {}
end

-- rootDir: project root (search base and nupp.lua location). opts.config may override
-- the loaded config table.
--
-- opts.folders are further roots to search, which is what an editor session opened on
-- more than one folder amounts to. Each brings the include paths its own `nupp.lua`
-- declares, because a folder whose sources sit under `src` is unreadable without them.
-- Everything else, lint levels and strictness and the language mode, still comes from
-- `rootDir`: the session was started against one project, and letting a second folder
-- redecide those would mean the same file checked differently depending on which window
-- opened it.
function envMod.new(rootDir: string?, opts: envMod.Options?): envMod.Env
    rootDir = rootDir or "."
    local memoryOnly = opts and opts.memoryOnly == true or false
    local cacheDir = opts and opts.cacheDir or nil
    if not cacheDir and not (opts and opts.cache == false) then
        local cache: any = buildPrivate("cache")
        cacheDir = cache.sharedCacheDir(nil)
    end
    local compilerServices = opts and opts.compilerServices or nil
    if not compilerServices and not memoryOnly and not (opts and opts.nativeCompilerServices == false) then
        compilerServices = compilerPrivate("hostservices")
    end
    local env = {
        globals = {},
        globalTypes = {},
        preludeComptimeFunctions = {},
        globalTypeDefs = {},
        annotations = annotationMod.new(),
        loaded = {},
        loadedPaths = {},
        bundled = {}, -- built-in module decls; survives loaded resets
        resolveModule = envMod.resolveModule,
        resolveModuleExports = envMod.resolveModuleExports,
        moduleInitializing = envMod.moduleInitializing,
        observeCallGuarantee = envMod.observeCallGuarantee,
        resolveCallGuarantees = envMod.resolveCallGuarantees,
        resolveProjectType = envMod.resolveProjectType,
        resolveProjectValue = envMod.resolveProjectValue,
        resolveProjectAnnotation = envMod.resolveProjectAnnotation,
        resolveQualifiedType = envMod.resolveQualifiedType,
        exportedNominal = envMod.exportedNominal,
        modulesNamed = envMod.modulesNamed,
        modulesExporting = envMod.modulesExporting,
        declarationType = envMod.declarationType,
        moduleNameForPath = envMod.moduleNameForPath,
        findModulePath = envMod.findModulePath,
        ensureProjectIndex = envMod.ensureProjectIndex,
        openTypeFunctionStore = envMod.typeFunctionStore,
        rootDir = rootDir,
        -- `cache = false` keeps everything in this process, which is what a test wants
        -- when it is measuring what the compiler does rather than what the last run
        -- left lying about. `cacheDir` moves the store, which is how two tests share a
        -- root without sharing a cache, and how a run over many small projects --
        -- `NUPP_CACHE_DIR` -- has them share one instead of each starting cold.
        cacheDisabled = opts and opts.cache == false or nil,
        memoryOnly = memoryOnly or nil,
        dialect = opts and opts.dialect or nil,
        backendResolution = opts and opts.backendResolution or nil,
        capabilityResolution = opts and opts.capabilityResolution or nil,
        nativeCompilerServices = not (opts and opts.nativeCompilerServices == false),
        compilerServices = compilerServices,
        -- A memory-only environment must not even load the persistent store closure.
        -- Keep the native cache lookup at its use site; the browser's instrumented
        -- require test proves this computed dependency is not reached there.
        cacheDir = cacheDir,
    }
    local deriveRecipes = {}
    env.internDeriveRecipe = function(_, recipe)
        local prior = deriveRecipes[recipe.fingerprint]
        if prior then
            return recipe, true
        end
        deriveRecipes[recipe.fingerprint] = true

        return recipe, false
    end
    annotationMod.hydrateBuiltins(env.annotations, T)

    local config = opts and opts.config or configAt(rootDir)
    env.config = config or {}
    local selectedTarget = env.config._target or buildPrivate("tasks").targetConfig(env.config)
    env.dialect = env.dialect or selectedTarget and selectedTarget.dialect or nil
    env.layoutTarget = selectedTarget and selectedTarget.layoutTarget or nil

    local typeRoots = opts and opts.typeRoots or nil
    if not typeRoots then
        -- An editor does not build dependencies when it opens a project, but an
        -- already-installed rock should be typed immediately. The path is derivable
        -- from the manifest's pinned version, so this is a read-only lookup.
        local depsMod: any = selectedTarget and buildPrivate("deps") or nil
        local rocks = depsMod and depsMod.rockPaths(rootDir, env.config, selectedTarget) or nil
        typeRoots = rocks and rocks.typeRoots or {}
    end
    env.typeRoots = {}
    for _, dir in ipairs(typeRoots or {}) do
        env.typeRoots[#env.typeRoots + 1] = normalizePath(dir)
    end
    local ambientTypeRoots = opts and opts.ambientTypeRoots or nil
    if not ambientTypeRoots and not memoryOnly then
        local depsMod: any = selectedTarget and buildPrivate("deps") or nil
        ambientTypeRoots = depsMod and depsMod.typeRoots(rootDir, env.config) or {}
    end
    env.ambientTypeRoots = {}
    for _, dir in ipairs(ambientTypeRoots or {}) do
        env.ambientTypeRoots[#env.ambientTypeRoots + 1] = normalizePath(dir)
    end

    env.roots = envMod.projectRoots(rootDir, env.config)
    local seenRoot = {}
    for _, root in ipairs(env.roots) do
        seenRoot[normalizePath(root)] = true
    end
    local function addRoot(dir)
        if seenRoot[normalizePath(dir)] then
            return
        end
        seenRoot[normalizePath(dir)] = true
        env.roots[#env.roots + 1] = dir
    end

    env.folders = {}
    for _, folder in ipairs(opts and opts.folders or {}) do
        if normalizePath(folder) ~= normalizePath(rootDir) then
            env.folders[#env.folders + 1] = normalizePath(folder)
            addRoot(folder)
            for _, dir in ipairs(configAt(folder).include or {}) do
                addRoot(folder .. "/" .. dir)
            end
        end
    end

    -- Bootstrap the stdlib prelude (real .d.nupp files checked by nupp itself). Lua's
    -- surface is declared first, because a Nupp declaration may name a Lua type such as
    -- `LuaFile`. Nothing needs to resolve the other way: the comptime helpers that type
    -- the string library, and the `nupp.Debug` protocol `format` names, are declared
    -- beside the library that reads them rather than beside the Nupp namespaces.
    local PRELUDE_FILES = {"/decls/lua.d.nupp", "/decls/prelude.d.nupp",}
    local preludeOrigin = "nupp:prelude.d.nupp"
    do
        local image = opts and opts.preludeImage and opts.preludeImage.new() or nil

        -- What the checked prelude depends on that the compiler's own identity does
        -- not already cover: the declaration sources, and the two settings that
        -- decide what they mean. `dialect` picks the surface the standard library
        -- is declared against and the code `preludeRuntime` is generated in;
        -- `layoutTarget` decides what an integer is. Anything else that changed the
        -- answer would be a change to the checker, which the store's stamp covers.
        local preludeKey = nil
        local cacheStore = nil
        if not image and not preludeServed and not env.cacheDisabled and os.getenv("NUPP_NO_PRELUDE_CACHE") == nil then
            local hashMod: any = buildPrivate("hash")
            local parts = {tostring(env.dialect or ""), tostring(env.layoutTarget or "")}
            -- Lint configuration too. The prelude is checked with options of its
            -- own and should not be reading a project's, but "should not" is not
            -- the same as "cannot", and a stored prelude checked under one lint
            -- table and believed under another is exactly the failure a key is
            -- for.
            local lints = (env.config or {}).lints
            if type(lints) == "table" then
                local named = {}
                for name, level in pairs(lints as {[string]: any}) do
                    named[#named + 1] = tostring(name) .. "=" .. tostring(level)
                end
                table.sort(named)
                parts[#parts + 1] = table.concat(named, ",")
            end
            for _, preludeFile in ipairs(PRELUDE_FILES) do
                parts[#parts + 1] = bundledSource(preludeFile) or ""
            end
            parts[#parts + 1] = bundledSource("/decls/prelude_impl.d.nupp") or ""
            preludeKey = hashMod.digest(table.concat(parts, "\0"))
            local remembered = nil
            if not memoryOnly then
                local storeMod: any = buildPrivate("store")
                local cacheMod: any = buildPrivate("cache")
                local storeDir = cacheDir or (outDirFor(env) .. "/cache")
                -- Fingerprinted from what makes the prelude and what reads it back.
                -- This module, because the bootstrap below is here; `preludecache`,
                -- because an image means whatever the code that wrote it meant. An
                -- earlier version left `preludecache` out, and images written before
                -- a change to it went on being believed after -- which is the one
                -- failure a content-keyed store exists to prevent.
                cacheStore = storeMod.open(
                    storeDir .. "/prelude.buf",
                    cacheMod.subsystemFingerprint({"nupp.compiler.env", "nupp.compiler.preludecache"}, storeDir)
                )
                remembered = cacheStore.get(preludeKey)
            end
            -- An image that will not decode is one this compiler did not write.
            -- Checking the prelude answers the question either way.
            if remembered ~= nil then
                image = compilerPrivate("preludecache").decode(remembered)
            end
        end

        if image then
            preludeServed = true
            env.globals = image.globals
            env.globalTypes = image.globalTypes
            env.preludeComptimeFunctions = image.preludeComptimeFunctions
            env.globalTypeDefs = image.globalTypeDefs
            env.annotations.byname = image.annotationsByName
            env.stringLib = image.stringLib
            env.featureEffects = image.featureEffects
            env.preludeRuntime = image.preludeRuntime
        else
            env.bootstrapping = true
            for _, preludeFile in ipairs(PRELUDE_FILES) do
                local src = bundledSource(preludeFile)
                -- Not optional. Without it every name in the standard library is
                -- unknown, and an ordinary check says nothing about that, since it only
                -- shows up under --strict, or as types quietly widening to any. A
                -- compiler that cannot find its own prelude is broken, not lenient.
                if not src then
                    error("internal error: cannot read the prelude at " .. moduleDir() .. preludeFile, 0)
                end
                local origin = "nupp:" .. (preludeFile:match("([^/]+)$") or preludeFile)
                local result = parser.parse(src, origin)
                assert(
                    #result.errors == 0,
                    "internal error: prelude has syntax errors: " .. (result.errors[1] and result.errors[1].msg or "?")
                )
                local diags = check.check(result, origin, env, {declareGlobals = true,})
                local fatal = nil
                for _, diagnostic in ipairs(diags) do
                    if diagnostics.isFatal(diagnostic) then
                        fatal = diagnostic
                        break
                    end
                end
                assert(
                    not fatal,
                    "internal error: prelude has type errors: " .. origin .. ":" .. tostring(
                        fatal and (fatal as any).line or "?"
                    ) .. ":" .. tostring(
                        fatal and (fatal as any).col or "?"
                    ) .. ": " .. tostring(fatal and (fatal as any).code or "?") .. " " .. (fatal and fatal.msg or "?")
                )
            end
            local implementationSource = bundledSource("/decls/prelude_impl.d.nupp")
            assert(implementationSource, "internal error: cannot read the prelude implementation")
            local function checkImplementation()
                local implementation = parser.parse(implementationSource, preludeOrigin)
                assert(
                    #implementation.errors == 0,
                    "internal error: prelude implementation has syntax errors: " .. (
                        implementation.errors[1] and implementation.errors[1].msg or "?"
                    )
                )
                -- The body unit completes declarations from the surface but owns its
                -- local definitions while it is checked. Hide same-spelled ambient
                -- values so a later terminal clause resolves to the body in this unit;
                -- restore the public declaration entries before checking user code.
                local hiddenGlobals = {}
                local hiddenTypes = {}
                for _, block in ipairs(implementation.root.blocks or {}) do
                    for _, stat in ipairs(block.stats or {}) do
                        if stat.kind == "localFuncStmt" and stat.name then
                            local name = stat.name.text
                            if env.globals[name] then
                                hiddenGlobals[name] = env.globals[name]
                                env.globals[name] = nil
                            end
                            if env.globalTypes[name] then
                                hiddenTypes[name] = env.globalTypes[name]
                                env.globalTypes[name] = nil
                            end
                        end
                    end
                end
                local implementationDiags = check.check(implementation, preludeOrigin, env, {
                    moduleName = "nupp.prelude",
                    strict = true,
                })
                for name, entry in pairs(hiddenGlobals) do
                    env.globals[name] = entry
                end
                for name, t in pairs(hiddenTypes) do
                    env.globalTypes[name] = t
                end
                local implementationFatal = nil
                for _, diagnostic in ipairs(implementationDiags) do
                    if diagnostics.isFatal(diagnostic) then
                        implementationFatal = diagnostic
                        break
                    end
                end
                assert(
                    not implementationFatal,
                    "internal error: prelude implementation has type errors: " .. (
                        implementationFatal and implementationFatal.msg or "?"
                    )
                )

                return implementation
            end

            local implementation = checkImplementation()
            local generated, generatedDiags = require("nupp.compiler.gen").generate(implementation, preludeOrigin)
            local generatedFatal = nil
            for _, diagnostic in ipairs(generatedDiags) do
                if diagnostics.isFatal(diagnostic) then
                    generatedFatal = diagnostic
                    break
                end
            end
            assert(
                not generatedFatal,
                "internal error: prelude does not generate: " .. (generatedFatal and generatedFatal.msg or "?")
            )
            env.preludeRuntime = generated
            annotationMod.bindBuiltinDeclarations(env.annotations, env.globalTypes, env.globalTypeDefs)
            local strlib = env.globals["string"]
            env.stringLib = strlib and strlib.t or nil
            env.featureEffects = native.decorateGlobals(env.globals)
            env.bootstrapping = nil
            preludeServed = true

            -- Kept for the next environment, in this process and the next command.
            -- Written straight away rather than at `persist`, because a command that
            -- never persists still paid for this and the one after it should not.
            if preludeKey ~= nil then
                local flattened = compilerPrivate("preludecache").encode({
                    annotationsByName = env.annotations.byname,
                    featureEffects = env.featureEffects,
                    globalTypeDefs = env.globalTypeDefs,
                    globalTypes = env.globalTypes,
                    globals = env.globals,
                    preludeComptimeFunctions = env.preludeComptimeFunctions,
                    preludeRuntime = env.preludeRuntime,
                    stringLib = env.stringLib,
                })
                -- Nil means the prelude holds something plain data cannot: a
                -- function, or an arena that would not answer for itself. Every
                -- command then computes it the way they all used to.
                if flattened ~= nil and cacheStore ~= nil then
                    cacheStore.put(preludeKey, flattened)
                    cacheStore.save()
                end
            end
        end
    end

    loadAmbientTypeRoots(env, env.ambientTypeRoots)

    -- Bundled module declarations (require("string.buffer") etc.). One relative path
    -- reaches them whether they are on disk beside the compiled modules or carried
    -- inside the stage-0 bundle.
    local BUNDLED = {
        ["string.buffer"] = "/decls/stringbuffer.d.nupp",
        ["bit"] = "/decls/bit.d.nupp",
        ["ffi"] = "/decls/ffi.d.nupp",
        ["lpeg"] = "/decls/lpeg.d.nupp",
        ["lua-utf8"] = "/decls/luautf8.d.nupp",
        ["re"] = "/decls/re.d.nupp",
        -- The jit.* submodules are require()-only: LuaJIT registers them under
        -- package.loaded without putting them on the `jit` table, so they are modules
        -- here rather than fields in the prelude.
        ["jit.util"] = "/decls/jit/util.d.nupp",
        ["jit.profile"] = "/decls/jit/profile.d.nupp",
        ["jit.zone"] = "/decls/jit/zone.d.nupp",
        ["jit.vmdef"] = "/decls/jit/vmdef.d.nupp",
        ["nupp.workers.native"] = "/nupp/workers/native.d.nupp",
    }
    -- The standard library, which is this compiler's own Nupp rather than a description
    -- of someone else's C. It is typed already, so there is nothing to declare a second
    -- time: the implementation is the surface, and a project outside this tree reads
    -- exactly the source that went into the binary it is running. A hand-written
    -- `.d.nupp` beside it would be a second copy with nothing holding the two together.
    local BUNDLED_SOURCE = {
        ["nupp.derive"] = "/nupp/derive.nupp",
        ["nupp.compiler.runtime.extensions"] = "/nupp/compiler/runtime/extensions.nupp",
        ["nupp.test"] = "/nupp/test.g.nupp",
        ["nupp.profile.zone"] = "/nupp/profile/zone.nupp",
        ["nupp.profile.trace"] = "/nupp/profile/trace.nupp",
        ["nupp.profile"] = "/nupp/profile/init.nupp",
        ["nupp.mem.indexed"] = "/nupp/mem/indexed.nupp",
        ["nupp.mem.span"] = "/nupp/mem/span.nupp",
        ["nupp.simd"] = "/nupp/simd.nupp",
        ["nupp.mem.heap"] = "/nupp/mem/heap.nupp",
        ["nupp.mem.sharedbytes"] = "/nupp/mem/sharedbytes.nupp",
        ["nupp.mem.soa"] = "/nupp/mem/soa.nupp",
        ["nupp.wasm"] = "/nupp/wasm.nupp",
        ["nupp.data.json"] = "/nupp/data/json.nupp",
        ["nupp.data.json.provider"] = "/nupp/data/json/provider.nupp",
        ["nupp.data.json.aot"] = "/nupp/data/json/aot.nupp",
        ["nupp.data.jsondecode"] = "/nupp/data/jsondecode.nupp",
        ["nupp.data.jsondecoder.fused"] = "/nupp/data/jsondecoder/fused.nupp",
        ["nupp.data.jsondecoder.eager"] = "/nupp/data/jsondecoder/eager.nupp",
        ["nupp.data.jsondecoder.serde"] = "/nupp/data/jsondecoder/serde.nupp",
        ["nupp.data.serde"] = "/nupp/data/serde.nupp",
        ["nupp.data.hmac"] = "/nupp/data/hmac.nupp",
