module nupp.compiler.runtimesurface

--[[
The ambient Lua identities that have one contract across the portable runtime
matrix.

The declaration prelude describes LuaJIT, because that remains the native
dialect. A portable check still resolves through those same definitions so
hover and field typing do not fork. This closed table is the second half of
that arrangement: it identifies the declarations whose runtime contract is
shared by Lua 5.1 through 5.4 and LuaJIT. Everything else fails closed.

Recognition is by the prelude definition, never by spelling. A local named
`setfenv`, or a field named `loaders` on an ordinary table, is application code
and does not belong to this table.
]]

local surface = {}

-- Positive rather than negative: extending lua.d.nupp never widens the
-- portable surface until the new identity is accounted for here.
local COMMON_ROOTS: {
    [string]: boolean
} = {
    _G = true,
    _VERSION = true,
    print = true,
    type = true,
    tostring = true,
    tonumber = true,
    pairs = true,
    ipairs = true,
    next = true,
    select = true,
    rawget = true,
    rawset = true,
    rawequal = true,
    setmetatable = true,
    getmetatable = true,
    assert = true,
    error = true,
    pcall = true,
    xpcall = true,
    require = true,
    dofile = true,
    loadfile = true,
    string = true,
    table = true,
    math = true,
    os = true,
    package = true,
    io = true,
    coroutine = true,
    debug = true,
}

-- Common contracts produced by a compiler-owned lexical binding.
local LOWERED_ROOTS: {[string]: boolean} = {unpack = true, loadstring = true,}

-- Library tables need the same fail-closed accounting at member granularity.
-- The portable table intrinsics are admitted because the generator lowers
-- them; none depends on a VM module.
local COMMON_MEMBERS: {
    [string]: {[string]: boolean}
} = {
    string = {
        byte = true,
        char = true,
        find = true,
        format = true,
        gmatch = true,
        gsub = true,
        len = true,
        lower = true,
        match = true,
        reverse = true,
        rep = true,
        sub = true,
        upper = true,
    },
    table = {concat = true, insert = true, remove = true, sort = true, new = true, clear = true, clone = true,},
    math = {
        abs = true,
        ceil = true,
        floor = true,
        sqrt = true,
        exp = true,
        log = true,
        pow = true,
        fmod = true,
        modf = true,
        sin = true,
        cos = true,
        tan = true,
        asin = true,
        acos = true,
        atan = true,
        deg = true,
        rad = true,
        min = true,
        max = true,
        random = true,
        randomseed = true,
        pi = true,
        huge = true,
        frexp = true,
    },
    os = {
        clock = true,
        date = true,
        difftime = true,
        execute = true,
        exit = true,
        getenv = true,
        remove = true,
        rename = true,
        time = true,
        tmpname = true,
    },
    package = {config = true, path = true, cpath = true, preload = true, loaded = true, loadlib = true,},
    io = {
        open = true,
        lines = true,
        read = true,
        write = true,
        close = true,
        type = true,
        input = true,
        output = true,
        popen = true,
        tmpfile = true,
        stdout = true,
        stderr = true,
        stdin = true,
    },
    coroutine = {create = true, resume = true, yield = true, status = true, wrap = true, running = true,},
    debug = {
        getinfo = true,
        traceback = true,
        sethook = true,
        gethook = true,
        getlocal = true,
        setlocal = true,
        getupvalue = true,
        setupvalue = true,
        getmetatable = true,
        setmetatable = true,
        getregistry = true,
    },
}

-- Modules supplied by LuaJIT rather than by the common Lua runtime surface.
-- Ordinary third-party modules are intentionally not listed: their runtime
-- check belongs to the package adapter that selected them.
local RUNTIME_MODULES: {
    [string]: boolean
} = {
    ffi = true,
    ["table.new"] = true,
    ["table.clear"] = true,
    ["string.buffer"] = true,
    ["jit.util"] = true,
    ["jit.profile"] = true,
    ["jit.zone"] = true,
    ["jit.vmdef"] = true,
    ["nupp.workers.native"] = true,
}

-- Stock 5.1 is a separate profile from the cross-version lowered surface.
local LUA51_ROOTS = {
    unpack = true,
    loadstring = true,
    load = true,
    getfenv = true,
    setfenv = true,
    gcinfo = true,
    collectgarbage = true,
    module = true,
}
local LUA51_MEMBERS = {}
for root, members in pairs(COMMON_MEMBERS) do
    local copy = {}
    for member in pairs(members) do
        copy[member] = true
    end
    LUA51_MEMBERS[root] = copy
end
LUA51_MEMBERS.table = {
    concat = true,
    insert = true,
    remove = true,
    sort = true,
    maxn = true,
    foreach = true,
    foreachi = true,
    getn = true,
    setn = true,
}
LUA51_MEMBERS.package.loaders = true
LUA51_MEMBERS.package.seeall = true
LUA51_MEMBERS.package.config = true
LUA51_MEMBERS.os.setlocale = true
for _, member in ipairs({"atan2", "cosh", "sinh", "tanh", "ldexp", "log10", "mod"}) do
    LUA51_MEMBERS.math[member] = true
end
LUA51_MEMBERS.string.dump = true
LUA51_MEMBERS.string.gfind = true
LUA51_MEMBERS.io.flush = true
local FILE_MEMBERS = {close = true, flush = true, lines = true, read = true, seek = true, setvbuf = true, write = true}
LUA51_MEMBERS["io.stdin"] = FILE_MEMBERS
LUA51_MEMBERS["io.stdout"] = FILE_MEMBERS
LUA51_MEMBERS["io.stderr"] = FILE_MEMBERS
LUA51_MEMBERS.debug.debug = true
LUA51_MEMBERS.debug.getfenv = true
LUA51_MEMBERS.debug.setfenv = true

--- Answers the exact bundled Lua-prelude root a token resolves to.
function surface.resolvedRoot(checker: any, token: any): string?
    if not token or not checker.env or not checker.env.globals then
        return nil
    end
    local global = checker.env.globals[token.text]
    local resolved = global ~= nil
        and token.definition ~= nil
        and token.definition == global.definition
        and token.definition.filename == "nupp:lua.d.nupp"

    return resolved and token.text or nil
end

--- Preserve prelude provenance through transparent casts and global-table reads.
function surface.identity(node: any): string?
    if not node then
        return nil
    end
    if node.runtimeSurfaceRoot then
        return node.runtimeSurfaceRoot
    end
    if node.kind == "castExpr" or node.kind == "paren" then
        return surface.identity(node.expr)
    end
    if node.kind == "dotIndex" or node.kind == "bracketIndex" then
        local root = surface.identity(node.obj)
        local key = node.expr
        local member = node.kind == "dotIndex"
            and node.name
            and node.name.text
            or key
            and key.kind == "string"
            and require(
                "nupp.compiler.lexer"
            ).stringValue(key.token.text)
        if root and member then
            return root == "_G" and member or root .. "." .. member
        end
    end
    if node.kind == "call" then
        local root = surface.identity(node.obj)
        if root == "getfenv" then
            return "_G"
        end
        local args = node.args and node.args.exprs
        if root == "rawget" and args and surface.identity(args[1]) == "_G" then
            local key = args[2]
            return key and key.kind == "string" and require("nupp.compiler.lexer").stringValue(key.token.text) or nil
        end
    end

    return nil
end

--- Keep the legacy cross-version contract while the new profile audits provenance.
function surface.tracked(checker: any, node: any): string?
    if checker.opts.compat == "lua51" then
        return surface.identity(node)
    end
    return node and node.runtimeSurfaceRoot
end

--- Reports a source read of a runtime-specific prelude identity.
function surface.requireIdentity(checker: any, root: string?, member: string?, at: any)
    if checker.opts.compat == "lua51" and root and not checker.declarationFile and (
        checker.comptimeDepth or 0
    ) == 0 then
        if root == "_G" and member then
            root, member = member, nil
        end
        if root and not member then
            local owner, field = root:match("^([^.]+)%.([^.]+)$")
            if owner then
                root, member = owner, field
            end
        end
        local members = LUA51_MEMBERS[root]
        local admitted = member and members and members[
            member
        ] or not member and (COMMON_ROOTS[root] or LUA51_ROOTS[root])
        if not admitted then
            checker.diag(
                "NUPP3014",
                at,
                (
                    'compat = "lua51" does not include runtime identity `%s`'
                ):format(member and root .. "." .. member or root),
                nil,
                {help = "use the stock Lua 5.1 API or an explicitly checked pure-Lua dependency"}
            )
        end
        return
    end
    if checker.opts.dialect ~= "lua51" or not root then
        return
    end
    local members = COMMON_MEMBERS[root]
    local unavailable = member and members and not members[
        member
    ] or not member and not (COMMON_ROOTS[root] or LOWERED_ROOTS[root])
    if not unavailable then
        return
    end
    local identity = member and root .. "." .. member or root
    -- The global is LuaJIT's, because a global cannot be supplied without writing to
    -- `_G`. The module of the same name is not, so say which spelling carries over
    -- rather than leaving a reader to find that out from the module list.
    local help = root == "bit"
        and 'require the module instead: `require("bit")` resolves on every dialect'
        or "use a portable module adapter or bind an application value with a different definition"
    checker.diag(
        "NUPP3010",
        at,
        ("the `lua51` runtime surface does not include prelude identity `%s`"):format(identity),
        nil,
        {help = help}
    )
end

--- Reports an exact prelude token, before any local alias carries its root.
function surface.requireRoot(checker: any, token: any, member: string?, at: any?)
    surface.requireIdentity(checker, surface.resolvedRoot(checker, token), member, at or token)
end

--- Reports a resolved require of a runtime-specific VM module.
function surface.requireModule(checker: any, name: string, at: any)
    if checker.opts.compat == "lua51" and not checker.declarationFile and (
        checker.comptimeDepth or 0
    ) == 0 and (RUNTIME_MODULES[name] or name == "bit" or name == "jit" or name:match("^jit%.")) then
        checker.diag("NUPP3014", at, ('compat = "lua51" does not include module `%s`'):format(name), nil, {
            help = "use an explicitly checked pure-Lua dependency; native modules are not substituted",
        })
        return
    end
    if checker.opts.dialect ~= "lua51" or not RUNTIME_MODULES[name] then
        return
    end
    checker.diag("NUPP3010", at, ("the `lua51` runtime surface does not include module `%s`"):format(name), nil, {
        help = "require a target-compatible typed adapter"
    })
end

export = surface
