        local pattern = value as string
        local parsed = __NuppPatternCaptures(pattern)
        if parsed.error then
            nupp.types.error("invalid Lua pattern: " .. parsed.error)
        end
    end

    return nupp.types.pack({nupp.types.string, nupp.types.integer})
end0
