module nupp.compiler.terminalhighlight

--[[
Nupp source and LuaJIT bytecode, coloured for a terminal.

`nupp bc` prints two languages at once: the source a reader wrote and the
instructions it became. Unhighlighted they are one wall of monospace, and the
question the listing exists to answer -- which instructions did this line cost
-- is answered by reading indentation. Colour separates the two without adding
a column.

The source colours are the website's, decided by `nupp.compiler.syntaxstyle` so
that a keyword is a keyword in both. The bytecode colours are the same palette
applied to opcodes by what they do, so a jump reads as control flow and a call
reads as a call, exactly as their source counterparts do a line above.

Nothing here decides whether to colour. A palette is asked for with the answer,
which the CLI takes from `nupp.cli`, so redirected output is plain by the same
rule every other command follows.
]]

local syntaxstyle = require("nupp.compiler.syntaxstyle")

local terminalhighlight = {}

--- Paints one run of text in one style.
type terminalhighlight.Paint = function(string): string

--- What a style name is painted with. A name the palette has no entry for is
--- left alone, which is what makes a plain palette an empty one.
type terminalhighlight.Palette = {[string]: terminalhighlight.Paint}

-- Deliberately unbold. A listing is mostly punctuation and short identifiers,
-- and bold at this density reads as emphasis nobody meant. Bright variants
-- carry the same distinctions legibly on either background.
local CODES = {
    comment = "90",
    keyword = "35",
    meta = "95",
    type = "36",
    ["function"] = "94",
    string = "32",
    number = "33",
    boolean = "33",
    warning = "33",
    error = "31",
}

local RESET = "\27[0m"

local function styler(code: string): terminalhighlight.Paint
    local prefix = "\27[" .. code .. "m"
    return function(text: string): string
        return prefix .. text .. RESET
    end
end

local COLORED: terminalhighlight.Palette = {}
for name, code in pairs(CODES) do
    COLORED[name] = styler(code)
end

local EMPTY: terminalhighlight.Palette = {}

--- The palette to paint with, given whether the destination takes escapes.
---
--- @param colored whether escapes should be written
--- @return a palette, empty when they should not
--- @raises never
function terminalhighlight.palette(colored: boolean): terminalhighlight.Palette
    return colored and COLORED or EMPTY
end

--- Paints text in one style, or returns it unchanged when the palette has no
--- colour for that style.
---
--- @param palette the palette to paint from
--- @param style the style name
--- @param text the text to paint
--- @return the painted text
--- @raises never
function terminalhighlight.paint(palette: terminalhighlight.Palette, style: string, text: string): string
    local paint = palette[style]
    -- Painting nothing still writes the escapes around it, which is how a
    -- listing acquires a colour change where it has no character to colour.
    if paint == nil or text == "" then
        return text
    end

    return paint(text)
end

--- Colours one Nupp source, a line at a time.
---
--- The whole source is classified at once because Nupp's syntax needs it: a
--- name is a type or a call by what surrounds it, and a long comment spans
--- lines. The result is indexed by source line so a caller echoing lines out of
--- order -- which a listing does -- can ask for one.
---
--- A source that does not parse is returned uncoloured rather than refused.
---
--- @param source the Nupp source to colour
--- @param palette the palette to paint from
--- @return one string per line of the source, without newlines
--- @raises never
function terminalhighlight.nuppLines(source: string, palette: terminalhighlight.Palette): {string}
    local lines: {string} = {""}

    local function append(text: string, style: string?): nil
        local start = 1
        while true do
            local finish = text:find("\n", start, true)
            local piece = finish and text:sub(start, finish - 1) or text:sub(start)
            if piece ~= "" then
                lines[#lines] = lines[#lines] .. (style and terminalhighlight.paint(palette, style, piece) or piece)
            end
            if not finish then
                break
            end
            lines[#lines + 1] = ""
            start = finish + 1
        end
    end

    local spans = syntaxstyle.spans(source, "bytecode-listing.nupp")
    if spans == nil then
        for line in (source .. "\n"):gmatch("(.-)\n") do
            lines[#lines] = line
            lines[#lines + 1] = ""
        end
        lines[#lines] = nil

        return lines
    end
    for _, span in ipairs(spans) do
        append(span.text, span.style)
    end

    return lines
end

--- The style an opcode is painted in, or nothing for the ones that are plain
--- work: moves, arithmetic and concatenation.
---
--- Grouped by what the instruction does rather than by LuaJIT's own ordering, so
--- that the colours line up with the source above them -- `FORL` is the colour
--- of `for`, `CALL` the colour of the call it came from, `KSTR` the colour of
--- the literal it loads.
local function opcodeStyle(op: string): string?
    if op:sub(
        1,
        2
    ) == "IS" or op:sub(
        1,
        3
    ) == "RET" or op == "JMP" or op == "UCLO" or op:find(
        "FOR",
        1,
        true
    ) or op:find("ITER", 1, true) or op:find("LOOP", 1, true) then
        return "keyword"
    end
    if op:sub(1, 4) == "CALL" or op:sub(1, 4) == "FUNC" or op == "FNEW" or op == "VARG" then
        return "function"
    end
    if op:sub(1, 1) == "K" then
        return "number"
    end
    if op:sub(1, 1) == "G" or op:sub(1, 1) == "T" or op:sub(1, 1) == "U" then
        return "type"
    end

    return nil
end

--- Colours one line of a bytecode listing.
---
--- The shape LuaJIT prints is fixed -- a program counter, an optional jump
--- marker, an opcode, its operands, and a trailing `;` hint naming whatever
--- constant or global the instruction reached for. Anything that does not have
--- that shape is left alone, because a listing is worth more plain than
--- rearranged by a pattern that did not match.
---
--- @param text one rendered instruction, without its newline
--- @param palette the palette to paint from
--- @return the instruction, coloured
--- @raises never
function terminalhighlight.bytecode(text: string, palette: terminalhighlight.Palette): string
    local counter, marker, gap, op, rest = text:match("^(%s*%d+%s*)(=?>?)(%s*)([A-Z][A-Z0-9]*)(.*)$")
    if counter == nil then
        return text
    end
    local paint = terminalhighlight.paint
    local operands, hint = (rest as string):match("^([^;]*)(;.*)$")
    if operands == nil then
        operands, hint = rest as string, ""
    end
    -- A jump's destination is the one operand that is not a register, and the
    -- only place a reader's eye has somewhere else to go.
    operands = (operands as string):gsub("(=> )(%d+)", function(arrow: string, target: string): string
        return arrow .. paint(palette, "keyword", target)
    end)
    local style = opcodeStyle(op as string)

    return paint(
        palette,
        "comment",
        counter as string
    ) .. paint(
        palette,
        "keyword",
        marker as string
    ) .. (
        gap as string
    ) .. (
        style and paint(palette, style, op as string) or (op as string)
    ) .. (operands as string) .. (hint ~= "" and paint(palette, "comment", hint as string) or "")
end

export = terminalhighlight
