--[[
Stable runtime names for statically selected method overloads.

An overloaded method is several functions in the type system and several
functions at runtime.  The member name cannot identify one of them, so the
parameter pack does.  The spelling minted here is shared by declarations and
calls, including calls through an interface, and deliberately excludes the
return pack: a return type cannot select an overload.
]]

local hash = require("nupp.compiler.build.hash")

local interface Methodslots
    member: function(name: string, ft: any): string
    parameters: function(ft: any): string
    unlabeledParameters: function(ft: any): string
end

local methodslots = {} as Methodslots

local function fingerprint(t: any, binders: any, active: any): string
    if not t then
        return "nil"
    end
    local binder = binders[t]
    if binder then
        return binder
    end
    if active[t] then
        return "@" .. (t.runtimePath or t.name or t.tag)
    end
    active[t] = true
    local tag = t.tag
    local out
    if tag == "nominal" then
        out = "nominal(" .. tostring(t.declKind) .. ":" .. tostring(t.runtimePath or t.name) .. ")"
    elseif tag == "array" or tag == "ptr" or tag == "const" then
        out = tag .. "(" .. fingerprint(t.elem or t.inner, binders, active) .. ")"
    elseif tag == "owned" or tag == "borrowed" or tag == "pinned" then
        out = tag .. "(" .. fingerprint(t.inner, binders, active) .. ")"
    elseif tag == "map" then
        out = "map(" .. fingerprint(
            t.key,
            binders,
            active
        ) .. ":" .. fingerprint(
            t.value,
            binders,
            active
        ) .. ":" .. fingerprint(t.writeKey, binders, active) .. ":" .. fingerprint(t.writeValue, binders, active) .. ")"
    elseif tag == "tuple" then
        local parts = {}
        for j, item in ipairs(t.elems or {}) do
            parts[j] = fingerprint(item, binders, active)
        end
        out = "tuple(" .. table.concat(parts, ",") .. ")"
    elseif tag == "union" or tag == "intersection" then
        local parts = {}
        for j, item in ipairs(t.members or {}) do
            parts[j] = fingerprint(item, binders, active)
        end
        table.sort(parts)
        out = tag .. "(" .. table.concat(parts, tag == "union" and "|" or "&") .. ")"
    elseif tag == "shape" then
        local parts = {}
        for _, field in ipairs(t.fields or {}) do
            parts[
                #parts + 1
            ] = field.name .. ":" .. fingerprint(
                field.read,
                binders,
                active
            ) .. ":" .. fingerprint(field.write, binders, active)
        end
        table.sort(parts)
        out = "shape(" .. table.concat(parts, ",") .. ")"
    elseif tag == "literal" then
        out = "literal(" .. tostring(t.constant) .. ":" .. fingerprint(t.base, binders, active) .. ")"
    elseif tag == "func" then
        local params = {}
        for j, param in ipairs(t.params or {}) do
            params[
                j
            ] = tostring(
                t.paramNames and t.paramNames[j] or ""
            ) .. "=" .. tostring(
                t.paramModes and t.paramModes[j] or "plain"
            ) .. ":" .. fingerprint(param, binders, active)
        end
        out = "fn(" .. table.concat(params, ",") .. ")"
    else
        out = tag or tostring(t)
    end
    active[t] = nil

    return out
end

local function packFingerprint(ft: any, includeLabels: boolean): string
    local binders = {}
    local generic = {}
    for j, tv in ipairs(ft.typeParams or {}) do
        binders[tv] = "$T" .. j
    end
    for j, pv in ipairs(ft.packParams or {}) do
        binders[pv] = "$P" .. j
    end
    for j, tv in ipairs(ft.typeParams or {}) do
        local bound = ft.typeBounds and ft.typeBounds[j] or nil
        generic[j] = binders[tv] .. "<:" .. fingerprint(bound, binders, {})
    end
    local parts = {}
    for j, param in ipairs(ft.paramPack.head or {}) do
        parts[
            j
        ] = tostring(
            includeLabels and ft.paramNames and ft.paramNames[j] or ""
        ) .. "=" .. tostring(
            ft.paramPack.modes and ft.paramPack.modes[j] or "plain"
        ) .. ":" .. fingerprint(param, binders, {})
    end
    local tail = ft.paramPack.tail
    if tail then
        if tail.kind == "homogeneous" then
            parts[#parts + 1] = "...:" .. fingerprint(tail.type, binders, {})
        elseif tail.kind == "generic" then
            parts[#parts + 1] = "...:" .. (binders[tail.var] or "$P")
        else
            parts[#parts + 1] = "...:unknown"
        end
    end

    return "<" .. table.concat(generic, ",") .. ">(" .. table.concat(parts, ",") .. ")"
end

--- The valid Lua identifier used as one overload's hidden runtime member. `ft` is the
--- callable as seen at a method call, with its receiver removed.
function methodslots.member(name: string, ft: any): string
    return "__nupp_m_" .. hash.digest(name .. ":" .. packFingerprint(ft, true))
end

--- The parameter-pack identity used to reject return-only overloads.
function methodslots.parameters(ft: any): string
    return packFingerprint(ft, true)
end

--- The positional identity used to match a labeled implementation to an inherited
--- contract that deliberately leaves its parameter labels unspecified.
function methodslots.unlabeledParameters(ft: any): string
    return packFingerprint(ft, false)
end

return methodslots
