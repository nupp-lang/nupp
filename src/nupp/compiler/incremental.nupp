--[[
The compiler's query graph.

Everything a session recomputes is a query over `nupp.compiler.query`: the text of a file,
its parse, the declarations that parse exports, the project's index of them, a
module's check result, and the interface and exports that result publishes.

Granularity is per file, with cutoff at the interface. Editing a function body
reparses and rechecks that file, and because a module's interface type is
content-address interned, its dependents validate against the identical object
and are not rechecked at all. Editing the type of an export changes the interned
interface, and then the dependents do recheck.

Exported nominal declarations use project-index skeletons keyed by their
declaration site, so a recheck preserves their identity.
]]

local query = require("nupp.compiler.query")
local parser = require("nupp.compiler.parser")
local check = require("nupp.compiler.check")
local envMod = require("nupp.compiler.env")
local storeMod = require("nupp.compiler.build.store")

local incremental = {}

--- One exported declaration, as a project header records it. Headers are compared field
--- by field to decide whether a reparse changed anything a dependent could see.
type incremental.Decl = {
    name: string,
    kind: string,
    statKind: string,
    visibility: string,
    signature: string,
    isAnnotation: boolean?,
    deprecated: any?,

    --- The token it was declared at; its offset keys the declaration site, which is
    --- what keeps a nominal type's identity across rechecks.
    token: any
}

--- What one file exports, in the form the project index takes.
type incremental.Header = {
    path: string,
    moduleName: string?,

    --- The local the file returns, which qualified declarations attach to. Part of the
    --- interface: changing it changes what the module exports.
    moduleLocal: string?,

    declarations: {incremental.Decl}
}

--- The result of checking one module.
---
--- `syntax` marks a parse that failed, `missing` a file that was not there; in both
--- cases there is nothing to say about the module's type.
type incremental.CheckResult = {
    --- Everything to report for this file, parse errors included.
    diags: {any},

    --- The module's exported type, interned, so dependents compare it by identity.
    --- Absent when the file did not get far enough to have one.
    moduleType: any,

    --- Compile-time types and runtime declarations the module publishes.
    exports: any,

    --- Set when the file did not parse.
    syntax: boolean?,

    --- Set when the file was not found.
    missing: boolean?,

    --- The parse this was checked from, kept so callers need not reparse.
    result: any
}

--- The compiler's query graph, with the editor and build entry points that read it.
record incremental.Inc
    --- Module resolution, project layout, bundled declarations.
    env: any

    --- The query database everything below goes through.
    q: query.Q

    --- Records an open editor buffer and its text, which takes precedence over what is
    --- on disk.
    openDocument: function(path: string, text: string)

    --- The same thing: an edit is just the newest text for a path.
    changeDocument: function(path: string, text: string)

    --- Drops the overlay, so the file on disk is authoritative again.
    closeDocument: function(path: string)

    --- Reacts to a file-watcher event. `changeType` is the LSP code, where 3 means the
    --- file was deleted.
    diskChanged: function(path: string, changeType: integer)

    --- Parse and check diagnostics for one file, plus the parse itself.
    checkFile: function(path: string): incremental.CheckResult

    --- The overlay-aware project declaration and module index.
    projectIndex: function(): any

    --- Every file in the project, on disk or open.
    projectFiles: function(): {string}

    --- The text one file's parse saw: its open overlay, or disk.
    fileText: function(path: string): string?

    --- The exported declaration header for one file.
    projectHeader: function(path: string): incremental.Header?

    --- Where a module name resolves to, or nil when nothing provides it.
    modulePath: function(name: string): string?

    --- The module names this file requires, sorted. Read from the recorded query edges,
    --- so the build planner need not know how memos are laid out.
    moduleDependencies: function(path: string): {string}

    --- Keyed project-index reads made while checking this module. Persisted by the
    --- build so a later process can reuse the module when unrelated declarations move.
    projectDependencies: function(path: string): {any}

    --- The current semantic digest of one keyed project-index answer.
    projectDependencyFingerprint: function(name: string, key: string): string?

    --- Writes back what this run worked out that the next one can reuse.
    ---
    --- Nothing depends on it being called: skipping it costs the next command the work
    --- this one did, and costs correctness nothing.
    persist: function()

    --- The header store, for tests that need to see hits and misses rather than infer
    --- them from a stopwatch.
    headerStore: any

    --- Derive planning executions, memo hits, equal cutoffs and module checks.
    deriveStats: function(): any
end

--- Builds a query graph rooted at `rootDir`.
---
--- @param rootDir the project root
--- @param opts an `envMod.Options`, passed through to the environment. Named as a
---     plain table because the default this applies -- `opts or {}` -- is an empty
---     literal, and the checker widens one of those to `table` whatever it is being
---     assigned to.
function incremental.new(rootDir: string, opts: table?): incremental.Inc
    opts = opts or {}
    local env = envMod.new(rootDir, opts)
    -- Left nil when nothing forced it, so each file's extension decides.
    local strict = opts.strict
    local q = query.new()
    local inc = new incremental.Inc(env = env, q = q)

    -- One store per environment, shared with whatever else reaches the same env: a
    -- check of one named file builds the project index through
    -- `envMod.ensureProjectIndex` rather than through this graph, and both want the
    -- same answers out of the same file.
    local headerStore = envMod.headerStore(env) or storeMod.open(nil, "")
    inc.headerStore = headerStore

    local diskPaths: {[string]: boolean} = {}
    local openPaths: {[string]: boolean} = {}
    for _, path in ipairs(envMod.listProjectFiles(env)) do
        diskPaths[path] = true
    end

    --- Republishes the project's file list from disk plus open buffers.
    local function updateProjectFiles()
        local files: {string} = {}
        local seen: {[string]: boolean} = {}
        for path in pairs(diskPaths) do
            seen[path] = true
            files[#files + 1] = path
        end
        for path in pairs(openPaths) do
            if not seen[path] then
                files[#files + 1] = path
            end
        end
        table.sort(files)
        q:setInput("projectFiles", "root", files)
    end

    updateProjectFiles()

    q:define("fileText", function(_, path)
        local f = io.open(path, "rb")
        if not f then
            return nil
        end
        local s = f:read("*a")
        f:close()

        return s
    end)

    q:define("parse", function(self, path)
        local text = self:get("fileText", path)
        if not text then
            return nil
        end

        return parser.parse(text, path)
    end)

    --- Whether two headers say the same thing, which is what decides that a reparse
    --- changed nothing a dependent could see.
    local function sameHeader(a: incremental.Header?, b: incremental.Header?): boolean
        if not a or not b then
            return false
        end
        if a.path ~= b.path
            or a.moduleName ~= b.moduleName
            or a.moduleLocal ~= b.moduleLocal
            or #a.declarations ~= #b.declarations
        then
            return false
        end
        for index, left in ipairs(a.declarations) do
            local right = b.declarations[index]
            if left.name ~= right.name
                or left.kind ~= right.kind
                or left.statKind ~= right.statKind
                or left.visibility ~= right.visibility
                or left.isAnnotation ~= right.isAnnotation
                or left.signature ~= right.signature
                or left.token.offset ~= right.token.offset
            then
                return false
            end
        end

        return true
    end

    -- Building the project index means having a header for every file in the project,
    -- and a header comes from a parse. Almost every command needs the index and almost
    -- no command needs most of those parses for anything else, so a command that
    -- touched one file was parsing a hundred to find out that the other ninety-nine
    -- still say what they said.
    --
    -- A header is a pure function of the file's bytes, so it can be looked up by them.
    -- The key is the path and the text; the store's stamp covers the compiler and the
    -- configuration. A key that matches is not a guess.
    q:define("projectHeader", function(self, path)
        local text = self:get("fileText", path)
        if text == nil then
            return envMod.projectHeader(env, path, nil)
        end
        local key = envMod.headerKey(env, path, text)
        local cached = headerStore.get(key)
        if cached then
            return cached
        end
        -- Depending on the parse only on a miss is the point: on a hit the header
        -- depends on the text alone, which is all it was ever computed from.
        local header = envMod.projectHeader(env, path, self:get("parse", path))
        headerStore.put(key, header)

        return header
    end, sameHeader)

    local projectNominals = env.projectNominals or {}
    env.projectNominals = projectNominals
    q:define("projectIndex", function(self)
        local headers = {}
        for _, path in ipairs(self:get("projectFiles", "root")) do
            headers[#headers + 1] = self:get("projectHeader", path)
        end

        return envMod.buildProjectIndex(headers, projectNominals)
    end)

    local hash = require("nupp.compiler.build.hash")
    local stable = require("nupp.compiler.build.cache").stable

    local function entrySurface(entry)
        return {
            name = entry.name,
            path = entry.path,
            moduleName = entry.moduleName,
            visibility = entry.visibility,
            kind = entry.kind,
            signature = entry.signature,
            isAnnotation = entry.isAnnotation,
            offset = entry.definition and entry.definition.token and entry.definition.token.offset or nil,
        }
    end

    local function entryListSurface(entries)
        local out = {}
        for _, entry in ipairs(entries or {}) do
            out[#out + 1] = entrySurface(entry)
        end

        return out
    end

    local function sameStable(a, b)
        return stable(a) == stable(b)
    end

    local function sameEntryLists(a, b)
        return sameStable(entryListSurface(a), entryListSurface(b))
    end

    q:define("projectEntries", function(self, name)
        return self:get("projectIndex", "root").byName[name] or {}
    end, sameEntryLists)

    q:define("projectPathEntries", function(self, path)
        return self:get("projectIndex", "root").byPath[path] or {}
    end, sameEntryLists)

    q:define("projectModulePath", function(self, name)
        return self:get("projectIndex", "root").modules[name]
    end)

    q:define("projectModuleBasenames", function(self, short)
        return self:get("projectIndex", "root").moduleBasenames[short]
    end, sameStable)

    q:define("projectAnnotations", function(self, name)
        return self:get("projectIndex", "root").annotationsByName[name]
    end, sameEntryLists)

    -- Environment lookup helpers call this function, including from inside a check
    -- query. q:get records the project-index dependency in that case.
    env.ensureProjectIndex = function()
        return q:get("projectIndex", "root")
    end

    --- Where a module name resolves to, preferring project files.
    local function modulePath(self: any, name: string): string?
        return self:get("projectModulePath", name) or envMod.findModulePath(env, name)
    end

    -- Plans are immutable semantic envelopes keyed by their behavior fingerprint.
    -- The checker still supplies source provenance separately on each run; this query
    -- owns only the canonical result and therefore safely interns it across edits.
    q:define("planDerives", function(_, fingerprint)
        return fingerprint
    end)
    local function internDerivePlan(self, plan)
        local executions = q.stats.planDerives or 0
        q:get("planDerives", plan.fingerprint)
        return plan, (q.stats.planDerives or 0) == executions
    end

    q:define("checkModule", function(self: any, path: any): incremental.CheckResult
        local result = self:get("parse", path)
        if not result then
            return {diags = {}, moduleType = nil, missing = true}
        end
        if #result.errors > 0 then
            return {diags = result.errors, moduleType = nil, syntax = true, result = result}
        end
        -- route require() through the query graph so dependencies record
        local qenv = setmetatable({resolveModule = function(_, name)
            local interface = self:get("moduleInterface", name)
            return interface and interface.type or nil
        end, resolveModuleExports = function(_, name)
            return self:get("moduleExports", name)
        end, projectEntries = function(_, name)
            return self:get("projectEntries", name)
        end, projectPathEntries = function(_, requestedPath)
            return self:get("projectPathEntries", requestedPath)
        end, projectModulePath = function(_, name)
            return self:get("projectModulePath", name)
        end, projectModuleBasenames = function(_, short)
            return self:get("projectModuleBasenames", short)
        end, projectAnnotations = function(_, name)
            return self:get("projectAnnotations", name)
        end, internDerivePlan = internDerivePlan,}, {__index = env})
        local external = envMod.isDependencyTypePath(env, path)
        local diags, moduleType, exports = check.check(result, path, qenv, {moduleName = envMod.moduleNameForPath(
            env,
            path
        ),
            -- A dependency owns the judgement of its declaration surface. A
            -- consumer's `--strict` must not reinterpret that foreign contract.
            strict = external and false or strict,})

        return {diags = diags, moduleType = moduleType, exports = exports, result = result}
    end)

    q:define("moduleInterface", function(self, name)
        local path = modulePath(self, name)
        if not path then
            -- project files shadow bundled declarations; see env.resolveModule
            local bundled = env.bundled and env.bundled[name]
            return bundled and {
                type = bundled.type,
                nominalEffectFingerprint = bundled.exports and bundled.exports.nominalEffectFingerprint,
                deriveInterfaceFingerprint = bundled.exports and bundled.exports.deriveInterfaceFingerprint,
            } or nil
        end
        -- nil on the re-entrant edge of a require cycle: the module is mid-check, so
        -- nothing is known about it yet
        local r = self:get("checkModule", path)

        return r and {
            type = r.moduleType,
            nominalEffectFingerprint = r.exports and r.exports.nominalEffectFingerprint,
            deriveInterfaceFingerprint = r.exports and r.exports.deriveInterfaceFingerprint,
        } or nil
    end, function(left, right)
        if left == nil or right == nil then
            return left == right
        end
        return left.type == right.type
            and left.nominalEffectFingerprint == right.nominalEffectFingerprint
            and left.deriveInterfaceFingerprint == right.deriveInterfaceFingerprint
    end)

    local function sameTypeMap(left, right)
        left, right = left or {}, right or {}
        for name, value in pairs(left) do
            if right[name] ~= value then
                return false
            end
        end
        for name, value in pairs(right) do
            if left[name] ~= value then
                return false
            end
        end

        return true
    end

    local function sameDeprecation(left, right)
        if left == nil or right == nil then
            return left == right
        end

        return left.reason == right.reason and left.replacement == right.replacement
    end

    local function sameDefinitionMap(left, right)
        left, right = left or {}, right or {}
        for name, definition in pairs(left) do
            local other = right[name]
            if not other or not sameDeprecation(definition.deprecated, other.deprecated) then
                return false
            end
        end
        for name in pairs(right) do
            if not left[name] then
                return false
            end
        end

        return true
    end

    local function sameExports(left, right)
        if left == nil or right == nil then
            return left == right
        end
        return left.nominalEffectFingerprint == right.nominalEffectFingerprint
            and left.deriveInterfaceFingerprint == right.deriveInterfaceFingerprint
            and sameTypeMap(
            left.types,
            right.types
        ) and sameTypeMap(
            left.values,
            right.values
        ) and sameDefinitionMap(left.typeDefs, right.typeDefs) and sameDefinitionMap(left.valueDefs, right.valueDefs)
    end

    q:define("moduleExports", function(self, name)
        local path = modulePath(self, name)
        if not path then
            -- Type-side lookups need the bundled declaration's exports just as the
            -- value side above needs its interface. Project files still shadow the
            -- declaration because this fallback is reached only when no path won.
            local bundled = env.bundled and env.bundled[name]
            return bundled and bundled.exports or nil
        end
        local r = self:get("checkModule", path)

        return r and r.exports or nil
    end, sameExports)

    -- Editor overlay management.
    function inc.openDocument(path: string, text: string)
        local wasOpen = openPaths[path]
        if envMod.moduleNameForPath(env, path) then
            openPaths[path] = true
        end
        if not wasOpen and openPaths[path] and not diskPaths[path] then
            updateProjectFiles()
        end
        q:setInput("fileText", path, text)
    end

    inc.changeDocument = inc.openDocument
    function inc.closeDocument(path: string)
        q:clearInput("fileText", path)
        if openPaths[path] then
            openPaths[path] = nil
            if not diskPaths[path] then
                updateProjectFiles()
            end
        end
    end

    -- Invalidate the disk fallback after an editor/file-watcher event. Open document
    -- overlays remain authoritative until didClose, but creates and deletes still
    -- update project membership underneath the overlay.
    function inc.diskChanged(path: string, changeType: integer)
        local existed = diskPaths[path] and true or false
        if changeType == 3 then
            diskPaths[path] = nil
        elseif envMod.moduleNameForPath(env, path) then
            diskPaths[path] = true
        end
        if not openPaths[path] then
            q:clearInput("fileText", path)
        end
        if existed ~= (diskPaths[path] and true or false) then
            updateProjectFiles()
        end
    end

    -- Full result for a file: parse + check diagnostics, parse result.
    function inc.checkFile(path: string): incremental.CheckResult
        return q:get("checkModule", path)
    end

    function inc.projectIndex(): any
        return q:get("projectIndex", "root")
    end

    function inc.projectFiles(): {string}
        return q:get("projectFiles", "root")
    end

    -- The text a file's parse actually saw: the open overlay when there is one, and
    -- otherwise disk. A caller mapping token offsets back to positions has to measure
    -- against this text and not re-read the file, or a change since the check would
    -- shift every offset it computes.
    function inc.fileText(path: string): string?
        return q:get("fileText", path)
    end

    function inc.projectHeader(path: string): incremental.Header?
        return q:get("projectHeader", path)
    end

    -- Build-system graph access. Checking a module records direct moduleInterface
    -- queries in its memo entry; expose those edges without making the build planner
    -- depend on query's internal table layout.
    function inc.modulePath(name: string): string?
        return modulePath(q, name)
    end

    function inc.moduleDependencies(path: string): {string}
        q:get("checkModule", path)
        local byPath = q.memo.checkModule
        local memo = byPath and byPath[path]
        local names: {string} = {}
        local seen: {[any]: boolean} = {}
        for _, dep in ipairs(memo and memo.deps or {}) do
            if dep.name == "moduleInterface" and not seen[dep.key] then
                seen[dep.key] = true
                names[#names + 1] = dep.key
            end
        end
        table.sort(names)

        return names
    end

    local PROJECT_QUERY = {
        projectEntries = true,
        projectPathEntries = true,
        projectModulePath = true,
        projectModuleBasenames = true,
        projectAnnotations = true,
    }

    local function projectFingerprint(name, key)
        local value = q:get(name, key)
        if name == "projectEntries" or name == "projectPathEntries" or name == "projectAnnotations" then
            value = entryListSurface(value)
        end

        return hash.digest(stable(value))
    end

    function inc.projectDependencies(path: string): {any}
        q:get("checkModule", path)
        local byPath = q.memo.checkModule
        local memo = byPath and byPath[path]
        local dependencies, seen = {}, {}
        for _, dep in ipairs(memo and memo.deps or {}) do
            if PROJECT_QUERY[dep.name] then
                local identity = dep.name .. "\0" .. tostring(dep.key)
                if not seen[identity] then
                    seen[identity] = true
                    dependencies[
                        #dependencies + 1
                    ] = {name = dep.name, key = dep.key, fingerprint = projectFingerprint(dep.name, dep.key),}
                end
            end
        end
        table.sort(dependencies, function(a, b)
            return a.name < b.name or (a.name == b.name and tostring(a.key) < tostring(b.key))
        end)

        return dependencies
    end

    function inc.projectDependencyFingerprint(name: string, key: string): string?
        if not PROJECT_QUERY[name] then
            return nil
        end
        return projectFingerprint(name, key)
    end

    function inc.persist()
        envMod.persist(env)
        headerStore.save()
    end

    function inc.deriveStats(): any
        return {
            executions = q.stats.planDerives or 0,
            cacheHits = q.hits.planDerives or 0,
            equalCutoffs = q.cutoffs.planDerives or 0,
            downstreamChecks = q.stats.checkModule or 0,
        }
    end

    return inc
end

return incremental
