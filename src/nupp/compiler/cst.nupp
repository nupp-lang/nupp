--- `...` in expression position.
record cst.Vararg is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'vararg'

    --- The `...`.
    token: lexer.Token?
end

--- A parenthesized expression, which also truncates a multi-value one.
record cst.Paren is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'paren'

    --- What is inside.
    expr: cst.Node?
end

--- `comptime do ... end`: an expression whose value is computed while compiling.
---
--- The block is an ordinary block and keeps every one of its tokens, so the formatter
--- and `cst.textOf` reproduce what was written. What evaluation produced is hung off
--- `comptimeValue` rather than spliced into the children, which is what lets syntax
--- tools keep seeing the source while `gen` emits the result.
record cst.ComptimeExpr is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'comptimeExpr'

    --- The block between `do` and `end`.
    body: cst.Node?
end

--- `new T(...)`, `new T {...}`: the only way to construct a record or a struct.
---
--- The construction is written as a call so that Lua's existing call sugar covers every
--- form, and so that a qualified name reaches its declaration through the same suffix
--- parsing everything else uses. `new` installs nothing at run time: it lowers to the
--- stamp or the ctype call directly, which is what leaves `__call` and `__new` to the
--- program.
record cst.NewExpr is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'newExpr'

    --- The call this constructs from, whose `obj` names the type.
    call: cst.Node?
end

--- `constructor(...) ... end` in a declaration body: what `new T(...)` runs.
---
--- It has no name and no return type. The instance is made before the body runs and
--- returned after it, so the body's whole job is to fill the fields in. `matches ...
--- end` in an interface body: the runtime test for `is`.
---
--- An interface has no table to stamp, so this is the only identity it can have. The
--- expression reads the declaration's own fields through `self`, in a subset small
--- enough to inline wherever `is` is written.
record cst.MatchesDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'matchesDecl'

    --- The test.
    expr: cst.Node?

    --- Annotations written above it.
    annotations: {cst.Node}?
end

record cst.ConstructorDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'constructorDecl'

    --- The parameter list and body.
    body: cst.Node?

    --- Annotations written above it.
    annotations: {cst.Node}?

    --- The runtime name the generator minted for it.
    constructorName: string?
end

--- An expression the parser could not make sense of.
record cst.ErrorExpr is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'errorExpr'

    --- The subject it had already parsed, when there was one.
    obj: cst.Node?
end

--- `obj.name`.
record cst.DotIndex is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'dotIndex'

    --- What is being indexed.
    obj: cst.Node?

    --- The member's name.
    name: lexer.Token?

    --- The type argument of an ffi intrinsic written `ffi.new<T>`.
    ffiTypeArg: cst.Node?
end

--- `obj[e]`.
record cst.BracketIndex is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'bracketIndex'

    --- What is being indexed.
    obj: cst.Node?

    --- The key.
    expr: cst.Node?
end

--- `obj:name(...)`, and its two safe-navigation spellings.
record cst.MethodCall is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'methodCall'

    --- The receiver.
    obj: cst.Node?

    --- The method's name.
    name: lexer.Token?

    --- The `?.` of `obj?.:name(...)`, which checks the receiver.
    safeObj: lexer.Token?

    --- The `?.` of `obj:name?.(...)`, which checks the method.
    safeMethod: lexer.Token?

    --- The argument list.
    args: cst.Node?

    --- Intersection-overload selection and its direct runtime target.
    overloadWinner: any

    overloadMember: string?
    methodEntry: any
end

--- `obj?.name`, which yields nil rather than raising on a nil receiver.
record cst.SafeIndex is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'safeIndex'

    --- What is being indexed.
    obj: cst.Node?

    --- The member's name.
    name: lexer.Token?
end

--- `obj?.[e]`.
record cst.SafeBracket is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'safeBracket'

    --- What is being indexed.
    obj: cst.Node?

    --- The key.
    expr: cst.Node?
end

--- `obj?.(...)`.
record cst.SafeCall is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'safeCall'

