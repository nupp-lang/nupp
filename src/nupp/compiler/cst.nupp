    --- The declared fields.
    fields: {cst.Node}
end

--- One field of a shape type.
record cst.TshapeField is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tshapeField'

    --- The field's name.
    name: lexer.Token?

    --- `readonly` or `writeonly` when only that capability is exposed.
    capability: lexer.Token?

    --- Its type.
    type: cst.Node?
end

--- `{T, U}`, a fixed sequence.
record cst.Ttuple is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'ttuple'

    --- The element types, in position order.
    types: {cst.Node}

    --- A computed tuple appended with `unpackof`, when present.
    tail: cst.Node?
end

--- A value sequence in type position, `(T, U, R...)`, `R...`, or `...T`.
record cst.Tpack is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tpack'

    --- Fixed head types.
    types: {cst.Node}

    --- A generic tail name, homogeneous tail type, or computed tuple/array type.
    tail: cst.Node?

    --- `generic`, `homogeneous`, or `computed` when a tail is present.
    tailKind: string?
end

--- Alternative complete value sequences, `(Pack | Pack)`.
record cst.TpackUnion is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tpackUnion'

    packs: {cst.Node}
end

--- `{T}`, a one-based Lua array.
record cst.Tarray is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tarray'

    --- The element type.
    element: cst.Node?
end

--- A function type.
record cst.Tfunc is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tfunc'

    --- Written `nosuspend function(...)`: calling it provably cannot suspend.
    ---
    --- A positive guarantee, so an unmarked function type stays conservatively
    --- may-yield. It is the one way to state the fact about something whose body this
    --- compiler never sees -- a declared host binding, a C function, a parameter -- and
    --- it is an ordinary part of the type, so it participates in identity, subtyping,
    --- aliasing, and substitution like everything else a type says.
    noSuspend: boolean?

    --- Its generic parameters, when it has any.
    generics: cst.Node?

    --- Its parameters.
    params: {cst.Node}

    --- Its return types, when they were written.
    rets: {cst.Node}?

    paramPack: cst.Node?

    returnPack: cst.Node?

    yieldPack: cst.Node?

    resumePack: cst.Node?

    --- Sources retained by the callable value rather than by one of its results.
    captureBorrows: cst.Node?
end

--- One parameter of a function type.
record cst.TfuncParam is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tfuncParam'

    --- Its ownership mode, when one was written.
    modeTok: lexer.Token?

    --- Its name, when it was named.
    name: lexer.Token?

    --- Its type.
    type: cst.Node?

    pack: boolean?
end

--- `T?`, which admits nil.
record cst.Topt is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'topt'

    --- The type it wraps.
    inner: cst.Node?
end

--- `T*`, a pointer.
record cst.Tptr is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tptr'

    --- The pointee type.
    inner: cst.Node?
end

--- `T[?]` and `T[N]`, contiguous zero-based C arrays.
record cst.Tcarray is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tcarray'

    --- The element type.
    element: cst.Node?

    --- The fixed length, absent for `T[?]`.
    count: cst.Node?
end

--- `T.[K]`, an indexed semantic member type.
record cst.Tmember is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tmember'

    object: cst.Node?

    key: cst.Node?
end

--- `{readonly [K in Keys]: Value}` or its write-only counterpart.
record cst.Tmapped is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tmapped'

    capability: lexer.Token?

    binder: lexer.Token?

    keys: cst.Node?

    remap: cst.Node?

    value: cst.Node?
end

--- `A | B`.
record cst.Tunion is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tunion'

    --- The members.
    types: {cst.Node}
end

--- `A & B`.
record cst.Tintersection is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tintersection'

    --- The members.
    types: {cst.Node}
end

--- A type the parser could not make sense of.
record cst.ErrorType is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'errorType'
end

--- `x is T` as a return type: calling it proves something about `x`.
record cst.Tpredicate is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tpredicate'

    --- The parameter it speaks about.
    param: lexer.Token?

    --- What it proves.
    type: cst.Node?
end

--- `T borrows p`: the result may not outlive its sources.
record cst.Tborrows is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tborrows'

    --- The borrowed type.
    type: cst.Node?

    --- Every parameter it borrows from.
    params: {lexer.Token}?

    --- The first of them, which is the whole list in the common case.
    param: lexer.Token?
end

--- `T preserves p`: the result is the same capability-bearing value passed as `p`,
--- with only its payload type changed by generic substitution or narrowing.
record cst.Tpreserves is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tpreserves'

    --- The result payload type.
    type: cst.Node?

    --- The parameter whose complete capability is transferred to this result slot.
    param: lexer.Token?
end

--- A node of the concrete syntax tree: one of the productions above, told apart by its
--- `kind`. Reading a field that belongs to another kind is an error, which is what
--- makes a dispatch loop check.
type cst.Node = cst.Chunk
    | cst.Block
    | cst.EmptyStmt
    | cst.HandleStmt
    | cst.IfStmt
    | cst.IfClause
    | cst.ElseifClause
    | cst.ElseClause
    | cst.WhileStmt
    | cst.DoStmt
    | cst.UnsafeStmt
    | cst.NoSuspendStmt
    | cst.FornumStmt
    | cst.ForinStmt
    | cst.RepeatStmt
    | cst.FuncStmt
    | cst.Funcname
    | cst.LocalFuncStmt
    | cst.LocalStmt
    | cst.LabelStmt
    | cst.GotoStmt
    | cst.BreakStmt
    | cst.ContinueStmt
    | cst.ReturnStmt
    | cst.CompoundAssign
    | cst.AssignStmt
    | cst.CallStmt
    | cst.ErrorStmt
    | cst.PragmaStmt
    | cst.AnnotationApply
    | cst.AnnotationArg
    | cst.AssociatedDecl
    | cst.TypeAlias
    | cst.RecordDecl
    | cst.WhereClause
    | cst.FieldDecl
    | cst.IndexerDecl
    | cst.ArrayPart
    | cst.InlineMethod
    | cst.MetamethodDecl
    | cst.CdefFunc
    | cst.CdefStruct
    | cst.Generics
    | cst.Param
    | cst.Funcbody
    | cst.CaptureClause
    | cst.NameExpr
    | cst.NumberLit
    | cst.StringLit
    | cst.DedentString
    | cst.NilExpr
    | cst.TrueExpr
    | cst.FalseExpr
    | cst.Vararg
    | cst.Paren
    | cst.ComptimeExpr
    | cst.NewExpr
    | cst.ConstructorDecl
    | cst.SatisfiesDecl
    | cst.ErrorExpr
    | cst.DotIndex
    | cst.BracketIndex
    | cst.MethodCall
    | cst.SafeIndex
    | cst.SafeBracket
    | cst.SafeCall
    | cst.Call
    | cst.Args
    | cst.NamedArg
    | cst.PluckArg
    | cst.TableExpr
    | cst.FieldBracket
    | cst.FieldNamed
    | cst.FieldItem
    | cst.Shortfn
    | cst.Istring
    | cst.FuncExpr
    | cst.Unop
    | cst.Binop
    | cst.CastExpr
    | cst.IsExpr
    | cst.Ternary
    | cst.Tconst
    | cst.Tkeyof
    | cst.Twriteof
    | cst.Tliteral
    | cst.Tname
    | cst.Ttypecall
    | cst.Tparen
    | cst.Tmap
    | cst.Tshape
    | cst.TshapeField
    | cst.Tmapped
    | cst.Ttuple
    | cst.Tarray
    | cst.Tfunc
    | cst.Tpack
    | cst.TpackUnion
    | cst.TfuncParam
    | cst.Topt
    | cst.Tptr
    | cst.Tcarray
    | cst.Tmember
    | cst.Tunion
    | cst.Tintersection
    | cst.ErrorType
    | cst.Tpredicate
    | cst.Tborrows
    | cst.Tpreserves

--- What a node holds: another node, or a token.
type cst.Child = cst.Node | lexer.Token

--- The two declaration forms, which share a visibility, a name and the tables the name
--- attaches to.
type cst.Declaration = cst.TypeAlias | cst.RecordDecl

--- What may take a generic parameter clause.
type cst.Generic = cst.Funcbody | cst.Tfunc | cst.TypeAlias | cst.RecordDecl

--- Statements and expressions whose nested block a pass walks into.
type cst.Bodied = cst.UnsafeStmt
    | cst.DoStmt
    | cst.WhileStmt
    | cst.RepeatStmt
    | cst.FornumStmt
    | cst.ForinStmt
    | cst.IfClause
    | cst.ElseifClause
    | cst.ElseClause
    | cst.Funcbody
    | cst.Shortfn

--- True when `x` is a token rather than a node, which narrows it for the caller. Tokens
--- are told apart by carrying trivia; this is the one place that test is asserted
--- rather than checked, which is what a predicate is for.
---
--- @param x the child to classify
local function isToken(x: cst.Child): x is lexer.Token
    return (x as lexer.Token).trivia ~= nil
end

cst.isToken = isToken

--- The ownership intrinsics, which the compiler implements rather than declares.
---
--- These are the only names Nupp itself puts at the top level, so each is also spelled
--- `nupp.`: a program that would rather say where a name comes from, or that has a
--- local
--- called `borrow`, needs a way to reach them anyway. The two spellings mean the same
--- thing and lower to the same code.
local OWNERSHIP_INTRINSICS: {
    [string]: boolean
} = {borrow = true, borrowFrom = true, drop = true, fromRaw = true, intoRaw = true, partition = true, pin = true,}

--- The ownership intrinsic a callee is written as, before anything asks what the names
--- in it resolve to. Answers nil for a callee of any other shape.
---
--- Whether a spelling is the intrinsic is the caller's question, and the two callers
--- ask
--- it differently: the checker holds scopes and can see a local shadowing the name,
--- while the pass reading parameter modes out of a body runs before any of that and has
--- only the spelling. Both need the spelling read the same way, which is what lives
--- here.
---
--- @param callee the expression being applied
--- @return the intrinsic's name, or nil
--- @return whether it was written qualified, which is what the base name has to be
---     checked for
function cst.ownershipIntrinsicSpelling(callee: cst.Node?): string?, boolean?
    if not callee then
        return nil
    end
    if callee.kind == "name" then
        local bare = callee.token and callee.token.text or ""
        return OWNERSHIP_INTRINSICS[bare] and bare or nil, false
    end
    if callee.kind ~= "dotIndex" then
        return nil
    end
    local base = callee.obj
    local member = callee.name and callee.name.text or ""
    if not base or base.kind ~= "name" or not OWNERSHIP_INTRINSICS[member] then
        return nil
    end
    local baseToken = base.token

    return baseToken and baseToken.text == "nupp" and member or nil, true
end

local COMPTIME_TYPE_INTRINSICS: {[string]: boolean} = {reflect = true, sizeof = true, alignof = true, offsetof = true,}

--- The compiler-provided type intrinsic a call spells before name resolution.
---
--- @param callee the expression being applied
--- @return the intrinsic's name, or nil
--- @return whether it was written on `nupp`
function cst.comptimeTypeIntrinsicSpelling(callee: cst.Node?): string?, boolean?
    if not callee then
        return nil
    end
    if callee.kind ~= "dotIndex" then
        return nil
    end
    local base = callee.obj
    local member = callee.name and callee.name.text or ""
    local baseToken = base and base.kind == "name" and base.token or nil
    if not baseToken or baseToken.text ~= "nupp" or not COMPTIME_TYPE_INTRINSICS[member] then
        return nil
    end

    return member, true
end

--- Appends a child to `n`'s array part and returns it, so a caller can consume a token
--- and record it in one expression. A nil child is ignored, which lets an optional part
--- be added unconditionally.
---
--- The child comes back with the type it went in with, optional or not: adding a token
--- the parser just consumed gives a token, and adding one that may be absent gives one
--- that may be absent. Making the result optional either way was what forced a check on
--- every `add(n, advance()).generic = true`.
---
--- @param n the node to append to
--- @param child the token or node to append, if there is one
function cst.add<T>(n: cst.Node, child: T): T
    if child ~= nil then
        n[#n + 1] = child as cst.Child
    end
    return child
end

--- Whether `name` can be written as a bare key or field, rather than in brackets.
---
--- A declaration's field names arrive from the parser, which already refused the
--- keywords; one reaching here from a declaration this compiler did not parse is
--- what the bracket form is for.
---
--- @param name the field or key to write
function cst.identifier(name: string): boolean
    return not lexer.KEYWORDS[name] and name:match("^[%a_][%w_]*$") ~= nil
end

--- The first token under `x`, which is where a diagnostic about it points. A node owns
--- its children in source order, so this is the leftmost leaf.
---
--- @param x the node or token to descend into
function cst.firstToken(x: cst.Child?): lexer.Token?
    local at = x
    while at and not isToken(at) do
        at = at[1]
    end

    return at as lexer.Token?
end

--- The last token under `x`, which is where an edit appending to it goes.
---
--- @param x the node or token to descend into
function cst.lastToken(x: cst.Child?): lexer.Token?
    local at = x
    while at and not isToken(at) do
        at = at[#at]
    end

    return at as lexer.Token?
end

--- Reconstructs the exact source text of a node or token, trivia included. This is the
--- round-trip identity: printing a parse yields its input.
---
--- @param x the node or token to print
function cst.textOf(x: cst.Child): string
    local parts: {string} = {}
    local function walk(y: cst.Child)
        if isToken(y) then
            for _, tr in ipairs(y.trivia) do
                parts[#parts + 1] = tr.text
            end
            parts[#parts + 1] = y.text
        else
            for _, child in ipairs(y) do
                walk(child)
            end
        end
    end

    walk(x)

    return table.concat(parts)
end

--- The name of the local a file returns, which is the table its qualified declarations
--- attach to. `return M` and `return setmetatable(M, ...)` both name `M`; anything else
--- has no single table to speak of and yields nil.
---
--- This reads syntax only, so the project index can key qualified declarations without
--- checking a body.
---
--- @param root the chunk node
--- @return the returned local's name, or nil
function cst.returnedLocal(root: cst.Chunk): string?
    local returned: cst.Node? = nil
    for _, block in ipairs(root.blocks) do
        if block.kind == "block" then
            for _, stat in ipairs(block.stats) do
                if stat.kind == "returnStmt" then
                    local exprs = stat.exprs
                    returned = #exprs == 1 and exprs[1] or nil
                end
            end
        end
    end
    if not returned then
        return nil
    end
    -- `setmetatable(M, mt)` returns its first argument, so the table it is wrapping is
    -- still the module.
    if returned.kind == "call" then
        local callee = returned.obj
        if not callee or callee.kind ~= "name" then
            return nil
        end
        local calleeName = callee.token
        if not calleeName or calleeName.text ~= "setmetatable" then
            return nil
        end
        local argsNode = returned.args
        local args = argsNode and argsNode.kind == "args" and argsNode.exprs or {}
        returned = args[1]
        if not returned then
            return nil
        end
    end
    if returned.kind ~= "name" then
        return nil
    end
    local token = returned.token
    if not token then
        return nil
    end

    return token.text
end

--- The effective visibility of a declaration, given the local its file returns. A
--- qualified name exports when it attaches to that local, the way `function M.f` does;
--- attaching to any other table keeps it to the file.
---
--- @param declaration the typeAlias or recordDecl node
--- @param moduleLocal the name from cst.returnedLocal, when the file has one
--- @return "local", "module", "global" or "nested"
function cst.declVisibility(declaration: cst.Declaration, moduleLocal: string?): string
    local written = declaration.visibility
    if written == "local" or written == "global" or written == "nested" then
        return written
    end
    local qualifiers = declaration.qualifiers
    if qualifiers then
        local only = #qualifiers == 1 and qualifiers[1] or nil
        if only and moduleLocal and only.text == moduleLocal then
            return "module"
        end
        return "local"
    end

    return written or "local"
end

--- Renders a node as a compact s-expression for tests and debugging: tokens print as
--- their text, missing tokens as «kind», nodes as (kind child...).
---
--- @param x the node or token to render
function cst.dump(x: cst.Child): string
    if isToken(x) then
        if x.missing then
            return "\194\171" .. x.kind .. "\194\187" -- «kind»
        end
        return x.text
    end
    local parts: {string} = {"(", x.kind}
    for _, child in ipairs(x) do
        parts[#parts + 1] = " "
        parts[#parts + 1] = cst.dump(child)
    end
    parts[#parts + 1] = ")"

    return table.concat(parts)
end

--- Renders a node as an indented outline for people reading parser output. Each node
--- occupies one line; tokens show their lexical kind and quoted source text.
---
--- @param x the node or token to render
function cst.pretty(x: cst.Child): string
    local lines: {string} = {}
    local function walk(y: cst.Child, depth: integer)
        local indent = string.rep("  ", depth)
        if isToken(y) then
            if y.missing then
                lines[#lines + 1] = indent .. y.kind .. " «missing»"
            else
                lines[#lines + 1] = indent .. y.kind .. " " .. ("%q"):format(y.text)
            end
            return
        end
        lines[#lines + 1] = indent .. y.kind
        for _, child in ipairs(y) do
            walk(child, depth + 1)
        end
    end

    walk(x, 0)

    return table.concat(lines, "\n")
end

return cst
