record cst.DedentString is cst.Hints
    {cst.Node | lexer.Token}

    kind: 'dedentString'

    --- The contextual `dedent` introducer.
    keyword: lexer.Token?

    --- The following Lua long-string token.
    token: lexer.Token?
end

