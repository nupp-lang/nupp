    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'errorType'
end

--- `x is T` as a return type: calling it proves something about `x`.
record cst.Tpredicate is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'tpredicate'

