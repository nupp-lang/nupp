--[[
The concrete syntax tree.

A node holds every token it consumed, in source order, in its array part, so
reprinting that array reproduces the source exactly. Nodes also carry named
fields — `n.cond`, `n.body` — that alias entries of the array part for structured
access; a named field never owns a token, so nothing is printed twice.

Tokens inserted by error recovery have empty text and are marked missing, so they
are invisible to reprinting.

There is one record per production and `Node` is their union, discriminated by
`kind`. A field means the same thing wherever it appears, and a field belonging
to another kind is not readable at all: a pass that dispatches on `kind` is
checked against the vocabulary rather than trusted with it.
]]

local lexer = require("nupp.compiler.lexer")

local cst = {}

--- What later passes leave on a node for the ones after them. The checker works out
--- what a name means; the generator needs the answer and must not work it out again.
--- These belong to no one kind, so they are declared once and included by every node
--- rather than repeated on each.
interface cst.Hints
    --- The complete Lua value sequence produced when this expression is in the final
    --- expanding position of a list. Parenthesized expressions deliberately omit it.
    valuePack: any

    --- The exact value sequence supplied to a checked call after Lua list adjustment.
    argumentPack: any

    --- Stable coroutine-library operation recognized by the checker.
    coroutineIntrinsic: string?

    --- Protocol carried from coroutine.wrap into the returned callable binding.
    wrappedProtocol: any

    --- Local thread whose phase a coroutine.status result describes.
    coroutineStatusName: string?

    --- Lua source replacing a primitive expression the optimizer proved constant.
    folded: string?

    --- Every edge from a const root to this expression is read-only.
    immutablePath: boolean?

    --- Generated local used instead of a proved immutable dotted callee.
    staticCallee: string?

    --- Hidden slot selected for an overloaded static declaration function.
    overloadMember: string?

    staticOverloadOwner: any
    staticOverloadName: string?

    --- This field access is immediately applied as a call, so overload selection can
    --- replace it with the chosen hidden runtime slot.
    callCallee: boolean?

    overloadWinner: any

    --- Immutable callees first bound immediately before this statement.
    callableBindings: any

    --- A branch whose preceding conditions the optimizer proved false.
    constantBranch: cst.Node?

    --- A `..` the checker resolved to Lua's primitive concatenation: no `__concat` was
    --- reached, and neither side was `any`. False or absent means a rewrite may not
    --- assume the operands are strings and numbers.
    plainConcat: boolean?

    --- A string accumulator lowered to a `string.buffer` by `OPT-5`.
    concatBuffer: any

    --- A bare `buffer` the checker resolved to the string.buffer module, which codegen
    --- emits as the binding it requires once per module.
    bufferIntrinsic: boolean?

    --- A `layoutof(T)` call, carrying the declaration's name, the field-to-C-type spec,
    --- and the nested struct ctypes the spec's `$` placeholders consume.
    layoutOf: any

    constantBranchNone: boolean?

    --- A loop whose constant bounds the optimizer proved admit no first iteration.
    constantLoopNone: boolean?

    --- The canonical literal a `comptime do ... end` block evaluated to, as source.
    --- Hung off the node rather than spliced into its children, so the block's own
    --- tokens still reprint and only `gen` reads the result.
    comptimeValue: string?

    --- A complete `@effects` contract, normalized by the checker.
    effectContract: any

    --- Observable guarantees an optimization may change at this declaration.
    relaxedGuarantees: any

    --- Conservative effect facts inferred for a visible function body.
    effectSummary: any

    --- A checker-recognized call to the stable prelude `ipairs` binding.
    builtinIpairs: any

    --- A call to a stable LuaJIT table builtin, lowered to one module-local binding.
    tableIntrinsic: string?

    --- The optimizer's proof and selected lowering for a numeric array loop.
    numericIpairs: any

    numericIpairsProof: any
    numericIpairsDeclined: any

    --- The runtime name of a reified struct's ctype.
    reified: string?

    --- The runtime table of a record, which is its identity.
    recordName: string?

    --- The runtime table of an interface, which exists only to hold the default bodies
    --- a declaration taking the contract references.
    interfaceName: string?

    --- The nominal a supertype node named, so its runtime spelling can be found again
    --- from the type.
    resolvedSupertype: any

    --- The defaults a declaration takes, as `{name, from}` pairs the generator turns
    --- into assignments.
    inheritedDefaultNames: any

    --- Set on an inline method emitted as a plain function rather than a method,
    --- because a default's receiver is the value it is later attached to.
    inlineDotted: boolean?

    --- Set on an inline function whose parameter list has no leading `self`. It is
    --- attached to the declaration table and never receives an instance.
    inlineStatic: boolean?

    --- The runtime test a `where` refinement named, attached by the checker so `is`
    --- compiles to it. A refinement travels as data, so nothing here has to be resolved
    --- a second time.
    wherePredicate: any

    --- Set on an `is` whose answer the subject's own type already settles.
    provenStatically: boolean?

    --- Set on an `is` the subject's own type settles the other way, so the test is
    --- false without running.
    refutedStatically: boolean?

    --- Whether that subject still admits nil, which is then the only question left to
    --- ask at run time.
    provenNeedsNil: boolean?

    --- Generator-owned runtime path for a nested record.
    recordRuntimeName: string?

    --- The runtime owner an inline method attaches to.
    inlineRuntimeOwner: string?

    --- The C name a cdef gave a type.
    cdefName: string?

    --- The function type at a call site, so a predicate can narrow.
    calleeType: any

    --- The resolved type of a call's callee or a declaration's signature.
    signatureType: any

    --- The type a declaration resolved to.
    resolvedType: any

    --- The nominal a pre-pass created for a declaration.
    hoistedType: any

    --- The alias a pre-pass bound for a `type` declaration.
    hoistedAlias: any

    --- The declaration entry a pre-pass hoisted.
    hoistedEntry: cst.Node?

    --- The module a `require` names, so an alias can name its types.
    requiredModule: string?

    --- What an index expression was indexing, so removal by nil can be allowed on a
    --- container and refused on a declared field.
    containerTag: string?

    --- Whether that container is a sequence.
    containerIsSequence: boolean?

    --- Inferred receiver of a dynamic `__index`/`__newindex` access.
    indexObjectType: any

    --- Inferred key of that access.
    indexKeyType: any

    --- Whether the access went through a declared contract.
    usesIndexContract: boolean?

    --- The metamethod a field access named on the receiver's own runtime table, which
    --- is the metatable its instances carry. Writing one installs it.
    metamethodName: string?

    --- The receiver whose contract that is, so the installed value can be held to it
    --- where the assignment is checked.
    metamethodReceiver: any

    --- Set while an assignment asks an index expression for its accepted write type.
    writeContext: boolean?

    --- Read type after a write through a distinct setter, or false for write-only.
    postWriteType: any

    --- Which ffi operation a call is.
    ffiIntrinsic: string?

    --- The type it was given, as written.
    ffiTypeName: string?

    --- The type node it was given.
    ffiTypeNode: any

    --- Logical C output parameters of the call.
    ffiOutContracts: any

    --- Element type of a C array construction.
    carrayElem: any

    --- Header declarations a cheader call brought in.
    cheaderCdef: any

    --- The library those declarations bind to.
    cheaderLib: any

    --- Set on a call that constructs a record.
    recordConstruct: string?

    --- Set on the call under a `new`, which is what makes it a construction rather than
    --- an ordinary call reaching `__call` or a ctype.
    isNew: boolean?

    --- The runtime path of a record whose declared constructor this call runs.
    constructorCall: string?

    --- The nominal a constructor body belongs to.
    ownerNominal: any

    --- Set once a `new` operand has been answered as a type, so the call does not
    --- answer for it a second time as a value.
    newReported: boolean?

    --- Set on a call that crosses into C.
    cdefCall: boolean?

    --- Which ownership intrinsic a call is.
    ownershipIntrinsic: string?

    --- What an owner promised to release.
    ownerCleanups: any

    --- The cleanup list `@owned` declared.
    ownCleanups: any

    --- Whether that owner is transfer-only.
    ownOpaque: boolean?

    --- Where `@owned` was written.
    ownTok: lexer.Token?

    --- Logical owned outputs of a C function.
    ownedOuts: any

    --- Logical borrowed outputs of a C function.
    borrowedOuts: any

    --- The owner a borrow came from.
    borrowOwner: any

    --- Every owner a borrow came from.
    borrowOwners: any

    --- The owners each returned borrow came from.
    returnBorrowOwners: any

    --- Whether a use-after-move was already reported here.
    ownershipUseReported: boolean?

    --- Whether the generator must pass the pinned pointer rather than the handle.
    passPinnedPointer: boolean?

    --- The type a `with` binding acquired.
    acquiredType: any

    --- The `with` binding a name resolved to.
    withBinding: any

    --- Whether a `with` body captures its enclosing scope.
    capturesEnclosing: boolean?

    --- Whether `@dispose` was written on this declaration.
    disposeContract: boolean?

    --- Whether that disposer is a method.
    disposeMethod: boolean?

    --- Where it was written.
    disposeTok: lexer.Token?

    --- Whether this declaration defines an annotation.
    isAnnotationDefinition: boolean?

    --- The definition an annotation application resolved to.
    annotationDefinition: any

    --- The type an `@ref` argument named.
    annotationReferenceType: any

    --- The struct an inline method belongs to.
    structOwner: any

    --- The member name a declaration entry publishes.
    memberName: string?

    --- Generator-owned label a `break` leaves through.
    breakExit: any

    --- Generator-owned label a `continue` leaves through.
    continueExit: any
end

--- A parsed file: its top-level blocks and the eof token that ends it.
record cst.Chunk is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'chunk'

    --- The top-level blocks, one per recovery region.
    blocks: {cst.Block}

    --- A leading `@!nofmt` inner annotation, which applies to this file only.
    formatDisabled: boolean?

    --- A leading `@!internal` inner annotation. Documentation hides this file; on an
    --- `init.nupp`, it also hides every module beneath that namespace.
    documentationInternal: boolean?

    --- The end-of-file token, which carries the trailing trivia.
    eof: lexer.Token?
end

--- A sequence of statements.
record cst.Block is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'block'

    --- The statements, in source order.
    stats: {cst.Node}
end

--- A lone `;`.
record cst.EmptyStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'emptyStmt'
end

--- An explicit resource scope, `with r = acquire() do ... end`.
record cst.WithStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'withStmt'

    --- The contextual `with`.
    withTok: lexer.Token?

    --- The acquisitions, left to right.
    bindings: {cst.WithBinding}

    --- The `do` opening the protected body.
    doTok: lexer.Token?

    --- The protected block.
    body: cst.Node?

    --- The `end` closing it.
    endTok: lexer.Token?
end

--- One acquisition of a `with` scope.
record cst.WithBinding is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'withBinding'

    --- The name the resource is bound to.
    name: lexer.Token?

    --- Its declared type, when one was written.
    type: cst.Node?

    --- The `=` before the acquisition.
    eq: lexer.Token?

    --- The expression that acquires the resource.
    expr: cst.Node?
end

--- An `if` and everything that belongs to it.
record cst.IfStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'ifStmt'

    --- The `if` clause and any `elseif` clauses, in order.
    clauses: {cst.IfClause | cst.ElseifClause}

    --- The `else`, when there is one.
    elseClause: cst.Node?
end

--- The leading `if cond then ...` arm.
record cst.IfClause is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'ifClause'

    --- The condition.
    cond: cst.Node?

    --- The block it guards.
    body: cst.Node?
end

--- An `elseif cond then ...` arm.
record cst.ElseifClause is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'elseifClause'

    --- The condition.
    cond: cst.Node?

    --- The block it guards.
    body: cst.Node?
end

--- The `else` arm.
record cst.ElseClause is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'elseClause'

    --- The block it guards.
    body: cst.Node?
end

--- `while cond do ... end`.
record cst.WhileStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'whileStmt'

    --- The condition, tested before each iteration.
    cond: cst.Node?

    --- The loop body.
    body: cst.Node?
end

--- A bare `do ... end` block.
record cst.DoStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'doStmt'

    --- The block.
    body: cst.Node?
end

--- `unsafe do ... end`, where raw pointer use is permitted.
--- `nosuspend do ... end`: a region in which suspending is a checked error.
---
--- Lexical and static. It erases to an ordinary `do` block, having no run-time
--- component at all: what it does is refuse, while compiling, any call that may yield.
record cst.NoSuspendStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'noSuspendStmt'

    --- The contextual `nosuspend`.
    keywordTok: lexer.Token?

    --- The `do`.
    doTok: lexer.Token?

    --- The block.
    body: cst.Node?

    --- The `end`.
    endTok: lexer.Token?
end

record cst.UnsafeStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'unsafeStmt'

    --- The contextual `unsafe`.
    unsafeTok: lexer.Token?

    --- The `do`.
    doTok: lexer.Token?

    --- The block.
    body: cst.Node?

    --- The `end`.
    endTok: lexer.Token?
end

--- A numeric `for`.
record cst.FornumStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'fornumStmt'

    --- The control variable.
    var: lexer.Token?

    --- The first value.
    start: cst.Node?

    --- The bound.
    stop: cst.Node?

    --- The step, when one was written.
    step: cst.Node?

    --- The loop body.
    body: cst.Node?
end

--- A generic `for ... in ...`.
record cst.ForinStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'forinStmt'

    --- The names the iterator binds.
    names: {lexer.Token}

    --- The iterator expression list.
    exprs: {cst.Node}

    --- The loop body.
    body: cst.Node?
end

--- `repeat ... until cond`.
record cst.RepeatStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'repeatStmt'

    --- The block, whose scope reaches the condition.
    body: cst.Node?

    --- The condition, tested after each iteration.
    cond: cst.Node?
end

--- `function a.b:c(...) ... end`.
record cst.FuncStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'funcStmt'

    --- The `funcname` naming what it attaches to.
    name: cst.Node?

    --- The parameters, returns and block.
    body: cst.Node?
end

--- The dotted, optionally method-qualified name of a function statement.
record cst.Funcname is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'funcname'

    --- The leading name.
    base: lexer.Token?

    --- The member after `:`, when the form is a method.
    method: lexer.Token?
end

--- `local function f(...) ... end`, and its `const` spelling.
record cst.LocalFuncStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'localFuncStmt'

    --- Whether it was written `const`.
    isConst: boolean?

    --- The name it binds.
    name: lexer.Token?

    --- The parameters, returns and block.
    body: cst.Node?
end

--- `local a, b: T = ...`, and its `const` spelling.
record cst.LocalStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'localStmt'

    --- Whether it was written `const`.
    isConst: boolean?

    --- The names it binds.
    names: {lexer.Token}

    --- Their annotations, indexed to match `names`; a slot is absent when that name was
    --- not annotated.
    types: {cst.Node}

    --- The initializers, when there are any.
    exprs: {cst.Node}?
end

--- `::name::`.
record cst.LabelStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'labelStmt'

    --- The label.
    name: lexer.Token?
end

--- `goto name`.
record cst.GotoStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'gotoStmt'

    --- The label it jumps to.
    name: lexer.Token?
end

--- `break`.
record cst.BreakStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'breakStmt'
end

--- `continue`.
record cst.ContinueStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'continueStmt'
end

--- `return` and its expression list.
record cst.ReturnStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'returnStmt'

    --- The returned expressions, empty for a bare return.
    exprs: {cst.Node}
end

--- `x += e` and the rest of the compound assignments.
record cst.CompoundAssign is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'compoundAssign'

    --- What is assigned to.
    target: cst.Node?

    --- The compound operator.
    op: lexer.Token?

    --- The right-hand side.
    value: cst.Node?
end

--- `a, b = e1, e2`.
record cst.AssignStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'assignStmt'

    --- Whether this establishes an immutable field binding.
    isConst: boolean?

    --- Whether every named field in its fresh table initializer is const.
    deepConst: boolean?

    --- What is assigned to.
    targets: {cst.Node}

    --- The values.
    exprs: {cst.Node}
end

--- A call in statement position.
record cst.CallStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'callStmt'

    --- The call.
    expr: cst.Node?
end

--- A statement the parser could not make sense of. It still owns its tokens.
record cst.ErrorStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'errorStmt'

    --- Annotations attached to it inside a declaration body.
    annotations: {cst.Node}?
end

--- `@name(...)` decorating the statement that follows it.
record cst.PragmaStmt is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'pragmaStmt'

    --- The annotation's name.
    name: lexer.Token?

    --- The `(` opening its arguments.
    open: lexer.Token?

    --- The arguments, one `annotationArg` each.
    annotationArgs: {cst.AnnotationArg}?

    --- The `)` closing them.
    close: lexer.Token?

    --- The statement it decorates.
    stat: cst.Node?
end

--- `@name(...)` attached to a declaration member rather than a statement.
record cst.AnnotationApply is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'annotationApply'

    --- The annotation's name.
    name: lexer.Token?

    --- The `(` opening its arguments.
    open: lexer.Token?

    --- The arguments, one `annotationArg` each.
    annotationArgs: {cst.AnnotationArg}?

    --- The `)` closing them.
    close: lexer.Token?
end

--- One argument of an annotation: `value` or `name = value`.
record cst.AnnotationArg is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'annotationArg'

    --- The member's name, when the argument is named.
    name: lexer.Token?

    --- The `=` between them.
    eq: lexer.Token?

    --- The value.
    expr: cst.Node?
end

--- `type Name = Type`.
record cst.TypeAlias is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'typeAlias'

    --- "local", "module", "global" or "nested".
    visibility: string?

    --- The contextual `type`.
    keyword: lexer.Token?

    --- The `local` or `global` before it, when one was written.
    modifier: lexer.Token?

    --- The declared name.
    name: lexer.Token?

    --- The tables it attaches to, outermost first.
    qualifiers: {lexer.Token}?

    --- Its generic parameters, when it has any.
    generics: cst.Node?

    --- The type it names.
    value: cst.Node?
end

--- A `record`, `interface` or `struct` declaration.
record cst.RecordDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'recordDecl'

    --- "local", "module", "global" or "nested".
    visibility: string?

    --- The contextual introducer.
    keyword: lexer.Token?

    --- The `local` or `global` before it, when one was written.
    modifier: lexer.Token?

    --- Which form: "record", "interface" or "struct".
    declKind: string?

    --- The declared name.
    name: lexer.Token?

    --- The tables it attaches to, outermost first.
    qualifiers: {lexer.Token}?

    --- Its generic parameters, when it has any.
    generics: cst.Node?

    --- The contracts named after `is`.
    supertypes: {cst.Node}?

    --- A `where` refinement, when one was written.
    whereClause: cst.Node?

    --- Its fields, methods, metamethods and nested declarations.
    entries: {cst.Node}
end

--- A declaration refinement introduced by `where`.
record cst.WhereClause is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'whereClause'

    --- The predicate.
    expr: cst.Node?
end

--- `name: T` inside a declaration body.
record cst.FieldDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'fieldDecl'

    --- The field's name.
    name: lexer.Token?

    --- `readonly` or `writeonly` when only that capability is granted.
    capability: lexer.Token?

    --- Its type.
    type: cst.Node?

    --- Annotations attached to it.
    annotations: {cst.Node}?
end

--- `[K]: V`, optionally prefixed by `readonly` or `writeonly`, in a declaration.
record cst.IndexerDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    kind: 'indexerDecl'

    capability: lexer.Token?

    key: cst.Node?

    value: cst.Node?

    annotations: {cst.Node}?
end

--- A record's array part, written as the array type it is.
record cst.ArrayPart is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'arrayPart'

    --- The array type.
    type: cst.Node?

    --- Annotations attached to it.
    annotations: {cst.Node}?
end

--- An ordinary method written inside a declaration body.
record cst.InlineMethod is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'inlineMethod'

    --- The method's name.
    name: lexer.Token?

    --- Its parameters, returns and block.
    body: cst.Node?

    --- Annotations attached to it.
    annotations: {cst.Node}?
end

--- A bodyless `metamethod __name: function(...)` contract.
record cst.MetamethodDecl is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'metamethodDecl'

    --- The metamethod's name.
    name: lexer.Token?

    --- Its declared function type.
    type: cst.Node?

    --- Annotations attached to it.
    annotations: {cst.Node}?
end

--- `cdef function f(...): T from "lib"`.
record cst.CdefFunc is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'cdefFunc'

    --- The C function's name.
    name: lexer.Token?

    --- Its parameters.
    params: {cst.Node}

    --- Whether it ends in C varargs.
    varargs: boolean?

    --- Its return type, when one was written.
    ret: cst.Node?

    --- The library named by a `from` clause.
    fromLib: lexer.Token?
end

--- `cdef struct Name ... end`.
record cst.CdefStruct is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'cdefStruct'

    --- The C struct's name.
    name: lexer.Token?

    --- Its fields.
    entries: {cst.Node}
end

--- A generic parameter clause, `<K, V is Bound>`.
record cst.Generics is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'generics'

    --- The parameters.
    names: {lexer.Token}

    --- Upper bounds, indexed to match `names`; an absent slot is unbounded.
    bounds: {cst.Node}

    --- Whether the aligned name is a generic pack binder, `A...`.
    packs: {boolean}
end

--- One parameter of a function body, a short function, or a cdef.
record cst.Param is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'param'

    --- Its ownership mode, when one was written.
    modeTok: lexer.Token?

    --- Its name; absent for a bare `...`.
    name: lexer.Token?

    --- Whether it is a named vararg, `...rest`.
    namedVararg: boolean?

    --- Its annotation, when one was written.
    type: cst.Node?
end

--- The parameters, return annotation and block of a function.
record cst.Funcbody is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'funcbody'

    --- Its generic parameters, when it has any.
    generics: cst.Node?

    --- Its parameters.
    params: {cst.Node}

    --- Its return annotations, when they were written.
    rets: {cst.Node}?

    returnPack: cst.Node?

    yieldPack: cst.Node?

    resumePack: cst.Node?

    --- The block.
    body: cst.Node?

    --- The named vararg parameter, when it has one.
    varargParam: cst.Node?
end

--- A reference to a name.
record cst.NameExpr is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'name'

    --- The identifier.
    token: lexer.Token?
end

--- A numeric literal.
record cst.NumberLit is
    cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
