record cst.TrueExpr is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'trueExpr'

    --- The keyword.
    token: lexer.Token?
end

--- `false`.
record cst.FalseExpr is cst.Hints
    {cst.Node | lexer.Token}

    --- Names the production this node stands for.
    kind: 'falseExpr'

