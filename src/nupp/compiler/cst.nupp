--- A node of the concrete syntax tree: one of the productions above, told apart by its
--- `kind`. Reading a field that belongs to another kind is an error, which is what
--- makes a dispatch loop check.
type cst.Node = cst.Chunk | cst.Block | cst.EmptyStmt | cst.WithStmt | cst.WithBinding | cst.IfStmt | cst.IfClause | cst.ElseifClause | cst.ElseClause | cst.WhileStmt | cst.DoStmt | cst.UnsafeStmt | cst.NoSuspendStmt | cst.FornumStmt | cst.ForinStmt | cst.RepeatStmt | cst.FuncStmt | cst.Funcname | cst.LocalFuncStmt | cst.LocalStmt | cst.LabelStmt | cst.GotoStmt | cst.BreakStmt | cst.ContinueStmt | cst.ReturnStmt | cst.CompoundAssign | cst.AssignStmt | cst.CallStmt | cst.ErrorStmt | cst.PragmaStmt | cst.AnnotationApply | cst.AnnotationArg | cst.TypeAlias | cst.RecordDecl | cst.WhereClause | cst.FieldDecl | cst.IndexerDecl | cst.ArrayPart | cst.InlineMethod | cst.MetamethodDecl | cst.CdefFunc | cst.CdefStruct | cst.Generics | cst.Param | cst.Funcbody | cst.NameExpr | cst.NumberLit | cst.StringLit | cst.NilExpr | cst.TrueExpr | cst.FalseExpr | cst.Vararg | cst.Paren | cst.ComptimeExpr | cst.NewExpr | cst.ConstructorDecl | cst.MatchesDecl | cst.ErrorExpr | cst.DotIndex | cst.BracketIndex | cst.MethodCall | cst.SafeIndex | cst.SafeBracket | cst.SafeCall | cst.Call | cst.Args | cst.TableExpr | cst.FieldBracket | cst.FieldNamed | cst.FieldItem | cst.Shortfn | cst.Istring | cst.FuncExpr | cst.Unop | cst.Binop | cst.CastExpr | cst.IsExpr | cst.Ternary | cst.Tconst | cst.Tliteral | cst.Tname | cst.Tparen | cst.Tmap | cst.Tshape | cst.TshapeField | cst.Ttuple | cst.Tarray | cst.Tfunc | cst.Tpack | cst.TpackUnion | cst.TfuncParam | cst.Topt | cst.Tptr | cst.Tcarray | cst.Tunion | cst.Tintersection | cst.ErrorType | cst.Tpredicate | cst.Tborrows

--- What a node holds: another node, or a token.
type cst.Child = cst.Node | lexer.Token

--- The two declaration forms, which share a visibility, a name and the tables the name
--- attaches to.
type cst.Declaration = cst.TypeAlias | cst.RecordDecl

--- What may take a generic parameter clause.
type cst.Generic = cst.Funcbody | cst.Tfunc | cst.TypeAlias | cst.RecordDecl

--- What a `with` scope, an `unsafe do` and the loops and blocks have in common: a body
--- block the pass walks into.
type cst.Bodied = cst.WithStmt | cst.UnsafeStmt | cst.DoStmt | cst.WhileStmt | cst.RepeatStmt | cst.FornumStmt | cst.ForinStmt | cst.IfClause | cst.ElseifClause | cst.ElseClause | cst.Funcbody | cst.Shortfn

--- True when `x` is a token rather than a node, which narrows it for the caller. Tokens
--- are told apart by carrying trivia; this is the one place that test is asserted
--- rather than checked, which is what a predicate is for.
---
--- @param x the child to classify
local function isToken(x: cst.Child): x is lexer.Token
    return (x as lexer.Token).trivia ~= nil
end

cst.isToken = isToken

--- The ownership intrinsics, which the compiler implements rather than declares.
---
--- These are the only names Nupp itself puts at the top level, so each is also spelled
--- `nupp.`: a program that would rather say where a name comes from, or that has a
--- local
--- called `borrow`, needs a way to reach them anyway. The two spellings mean the same
--- thing and lower to the same code.
local OWNERSHIP_INTRINSICS: {
    [string]: boolean
} = {borrow = true, borrowFrom = true, dispose = true, fromRaw = true, intoRaw = true, pin = true,}

--- The ownership intrinsic a callee is written as, before anything asks what the names
--- in it resolve to. Answers nil for a callee of any other shape.
---
--- Whether a spelling is the intrinsic is the caller's question, and the two callers
--- ask
--- it differently: the checker holds scopes and can see a local shadowing the name,
--- while the pass reading parameter modes out of a body runs before any of that and has
--- only the spelling. Both need the spelling read the same way, which is what lives
--- here.
---
--- @param callee the expression being applied
--- @return the intrinsic's name, or nil
--- @return whether it was written qualified, which is what the base name has to be
---     checked for
function cst.ownershipIntrinsicSpelling(callee: cst.Node?): string?, boolean?
    if not callee then
        return nil
    end
    if callee.kind == "name" then
        local bare = callee.token and callee.token.text or ""
        return OWNERSHIP_INTRINSICS[bare] and bare or nil, false
    end
    if callee.kind ~= "dotIndex" then
        return nil
    end
    local base = callee.obj
    local member = callee.name and callee.name.text or ""
    if not base or base.kind ~= "name" or not OWNERSHIP_INTRINSICS[member] then
        return nil
    end
    local baseToken = base.token

    return baseToken and baseToken.text == "nupp" and member or nil, true
end

--- Appends a child to `n`'s array part and returns it, so a caller can consume a token
--- and record it in one expression. A nil child is ignored, which lets an optional part
--- be added unconditionally.
---
--- The child comes back with the type it went in with, optional or not: adding a token
--- the parser just consumed gives a token, and adding one that may be absent gives one
--- that may be absent. Making the result optional either way was what forced a check on
--- every `add(n, advance()).generic = true`.
---
--- @param n the node to append to
--- @param child the token or node to append, if there is one
function cst.add<T>(n: cst.Node, child: T): T
    if child ~= nil then
        n[#n + 1] = child as cst.Child
    end
    return child
end

--- The first token under `x`, which is where a diagnostic about it points. A node owns
--- its children in source order, so this is the leftmost leaf.
---
--- @param x the node or token to descend into
function cst.firstToken(x: cst.Child?): lexer.Token?
    local at = x
    while at and not isToken(at) do
        at = at[1]
    end

    return at as lexer.Token?
end

--- The last token under `x`, which is where an edit appending to it goes.
---
--- @param x the node or token to descend into
function cst.lastToken(x: cst.Child?): lexer.Token?
    local at = x
    while at and not isToken(at) do
        at = at[#at]
    end

    return at as lexer.Token?
end

--- Reconstructs the exact source text of a node or token, trivia included. This is the
--- round-trip identity: printing a parse yields its input.
---
--- @param x the node or token to print
function cst.textOf(x: cst.Child): string
    local parts: {string} = {}
    local function walk(y: cst.Child)
        if isToken(y) then
            for _, tr in ipairs(y.trivia) do
                parts[#parts + 1] = tr.text
            end
            parts[#parts + 1] = y.text
        else
            for _, child in ipairs(y) do
                walk(child)
            end
        end
    end

    walk(x)

    return table.concat(parts)
end

--- The name of the local a file returns, which is the table its qualified declarations
--- attach to. `return M` and `return setmetatable(M, ...)` both name `M`; anything else
--- has no single table to speak of and yields nil.
---
--- This reads syntax only, so the project index can key qualified declarations without
--- checking a body.
---
--- @param root the chunk node
--- @return the returned local's name, or nil
function cst.returnedLocal(root: cst.Chunk): string?
    local returned: cst.Node? = nil
    for _, block in ipairs(root.blocks) do
        if block.kind == "block" then
            for _, stat in ipairs(block.stats) do
                if stat.kind == "returnStmt" then
                    local exprs = stat.exprs
                    returned = #exprs == 1 and exprs[1] or nil
                end
            end
        end
    end
    if not returned then
        return nil
    end
    -- `setmetatable(M, mt)` returns its first argument, so the table it is wrapping is
    -- still the module.
    if returned.kind == "call" then
        local callee = returned.obj
        if not callee or callee.kind ~= "name" then
            return nil
        end
        local calleeName = callee.token
        if not calleeName or calleeName.text ~= "setmetatable" then
            return nil
        end
        local argsNode = returned.args
        local args = argsNode and argsNode.kind == "args" and argsNode.exprs or {}
        returned = args[1]
        if not returned then
            return nil
        end
    end
    if returned.kind ~= "name" then
        return nil
    end
    local token = returned.token
    if not token then
        return nil
    end

    return token.text
end

--- The effective visibility of a declaration, given the local its file returns. A
--- qualified name exports when it attaches to that local, the way `function M.f` does;
--- attaching to any other table keeps it to the file.
---
--- @param declaration the typeAlias or recordDecl node
--- @param moduleLocal the name from cst.returnedLocal, when the file has one
--- @return "local", "module", "global" or "nested"
function cst.declVisibility(declaration: cst.Declaration, moduleLocal: string?): string
    local written = declaration.visibility
    if written == "local" or written == "global" or written == "nested" then
        return written
    end
    local qualifiers = declaration.qualifiers
    if qualifiers then
        local only = #qualifiers == 1 and qualifiers[1] or nil
        if only and moduleLocal and only.text == moduleLocal then
            return "module"
        end
        return "local"
    end

    return written or "local"
end

--- Renders a node as a compact s-expression for tests and debugging: tokens print as
--- their text, missing tokens as «kind», nodes as (kind child...).
---
--- @param x the node or token to render
function cst.dump(x: cst.Child): string
    if isToken(x) then
        if x.missing then
            return "\194\171" .. x.kind .. "\194\187" -- «kind»
        end
        return x.text
    end
    local parts: {string} = {"(", x.kind}
    for _, child in ipairs(x) do
        parts[#parts + 1] = " "
        parts[#parts + 1] = cst.dump(child)
    end
    parts[#parts + 1] = ")"

    return table.concat(parts)
end

--- Renders a node as an indented outline for people reading parser output. Each node
--- occupies one line; tokens show their lexical kind and quoted source text.
---
--- @param x the node or token to render
function cst.pretty(x: cst.Child): string
    local lines: {string} = {}
    local function walk(y: cst.Child, depth: integer)
        local indent = string.rep("  ", depth)
        if isToken(y) then
            if y.missing then
                lines[#lines + 1] = indent .. y.kind .. " «missing»"
            else
                lines[#lines + 1] = indent .. y.kind .. " " .. ("%q"):format(y.text)
            end
            return
        end
        lines[#lines + 1] = indent .. y.kind
        for _, child in ipairs(y) do
            walk(child, depth + 1)
        end
    end

    walk(x, 0)

    return table.concat(lines, "\n")
end

return cst
