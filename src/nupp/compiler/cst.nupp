record cst.Tpack is
    cst.Hints
    {cst.Node | lexer.Token}

    kind: 'tpack'

    --- Fixed head types.
    types: {cst.Node}

    --- A generic tail name or homogeneous tail type.
    tail: cst.Node?

    --- `generic` or `homogeneous` when a tail is present.
    tailKind: string?
end

