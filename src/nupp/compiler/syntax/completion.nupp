module nupp.compiler.syntax.completion

local cst = require("nupp.compiler.syntax.cst")

-- Source completion is shared by checking and target specialization.
export function neverReturns(call: any): boolean
    if not call then
        return false
    end
    local kind = call.kind
    if kind ~= "call" and kind ~= "methodCall" then
        return false
    end
    local signature = call.signatureType
    if (call as any).assertNever then
        return true
    end
    if signature and signature.tag == "func" and signature.noreturn then
        return true
    end
    if kind == "call" then
        local callee = call.obj
        if callee and callee.kind == "name" then
            local tok = callee.token
            if tok and tok.text == "error" then
                return true
            end
        end
    end

    return false
end

local function breaksOut(x: any): boolean
    if not x or cst.isToken(x) then
        return false
    end
    local kind = x.kind
    if kind == "breakStmt" or (kind == "orExitExpr" and (x as cst.OrExitExpr).exitKind == "break") then
        return true
    end
    if kind == "funcbody"
        or kind == "shortfn"
        or kind == "whileStmt"
        or kind == "repeatStmt"
        or kind == "fornumStmt"
        or kind == "forinStmt"
    then
        return false
    end
    for _, child in ipairs(x) do
        if not cst.isToken(child) and breaksOut(child) then
            return true
        end
    end

    return false
end

local completesNormally: function(any): boolean

-- Whether control can run off the end of this block: no statement on the way
-- always leaves, or a label lets a jump land past one that does. Where a
-- statement's exits cannot be told apart syntactically -- a loop whose condition
-- is not the literal `true`, an `if` chain the checker did not find exhaustive --
-- the block is taken to complete, so a function is only ever asked for a
-- `return` it may truly be missing rather than one it wrote another way.
--
-- @param block the body to judge
export function fallsThrough(block: any): boolean
    local stats = block and block.kind == "block" and block.stats or {}
    local reachable = true
    for _, stat in ipairs(stats) do
        if stat.kind == "labelStmt" then
            reachable = true
        elseif reachable and not completesNormally(stat) then
            reachable = false
        end
    end

    return reachable
end

-- Whether this statement can complete and hand control to the one after it.
--
-- @param stat the statement to judge
completesNormally = function(node: any): boolean
    local stat = node as any
    while stat and (stat.kind == "pragmaStmt" or stat.kind == "exportStmt") do
        stat = stat.stat
    end
    if not stat then
        return true
    end
    local kind = stat.kind
    if kind == "returnStmt"
        or kind == "yieldStmt"
        or kind == "breakStmt"
        or kind == "continueStmt"
        or kind == "gotoStmt"
    then
        return false
    elseif kind == "callStmt" then
        return not neverReturns(stat.expr)
    elseif kind == "doStmt" then
        return fallsThrough(stat.body)
    elseif kind == "ifStmt" then
        if not stat.elseClause then
            return not stat.exhaustiveDispatch
        end
        for _, clause in ipairs(stat.clauses) do
            if fallsThrough(clause.body) then
                return true
            end
        end
        return fallsThrough(stat.elseClause.body)
    elseif kind == "whileStmt" then
        local cond = stat.cond
        return not (cond and cond.kind == "trueExpr") or breaksOut(stat.body)
    elseif kind == "repeatStmt" then
        local cond = stat.cond
        return not (cond and cond.kind == "falseExpr") or breaksOut(stat.body)
    end

    return true
end
