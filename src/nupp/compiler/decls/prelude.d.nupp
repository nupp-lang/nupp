--[[
# Nupp standard-library prelude

The `nupp` namespace itself: the intrinsics the compiler owns, and the ambient
library namespaces reached without a `require`. `nupp` loads this file into every
check environment with `declare_globals`, after `lua.d.nupp`, so the declarations
below may name Lua types such as `io.File`.

## Conventions

- Library tables are closed shapes, so a misspelled member is `NUPP2004`.
- What needs machinery that has not landed yet falls back to `any`.
- Every declaration carries a `---` docblock.

This file is parsed and checked by `nupp` itself, as is its Lua counterpart.
]]

----------------------------------------------------------------------------
-- Resources and aliases
----------------------------------------------------------------------------

--- A value that carries neither an ownership obligation nor a scoped borrow.
--- Use this bound when a generic cache must return the same value repeatedly.
interface own.Copyable
end

--- Declares a consuming cleanup for an affine owner.
interface own.Affine<const cleanup: function>
end

--- A resource with a deterministic, consuming close operation.
---
--- Declaring `is own.Closeable` makes construction and bare type annotations carry the
--- close obligation automatically. A resource that publishes pending work declares
--- `flush` on its own contract; closing is the lifecycle common to all resources.
interface own.Closeable is own.Affine<self.close>
    close: function(takes self: own.Closeable): nil
end

--- A failed operation on a managed alias.
record own.AliasError
    code: string
    message: string
end

--- The unique owner of an independently allocated managed cell.
--- @internal
record own.Managed<T>
    alias: function(borrows self: own.Managed<T>): alias(T)
    close: @nosuspend function(takes self: own.Managed<T>): nil
end

--- A copyable, checked, non-owning reference to one managed cell.
--- @internal
record own.Alias<T>
    with: function<R>(
        self: own.Alias<T>,
        scoped callback: function(borrows value: T): R
    ): ((R, nil) | (nil, own.AliasError))
    withexclusive: function<R>(
        self: own.Alias<T>,
        scoped callback: function(exclusive value: T): R
    ): ((R, nil) | (nil, own.AliasError))
    take: @nosuspend function(self: own.Alias<T>): ((T, nil) | (nil, own.AliasError))
    close: @nosuspend function(self: own.Alias<T>): own.AliasError?
    downcast: function<U>(self: own.Alias<T>): ((alias(U), nil) | (nil, own.AliasError))
end

----------------------------------------------------------------------------
-- The compiler-provided namespace
----------------------------------------------------------------------------

--- Compiler-provided facilities. The namespace is always present; native members are
--- linked automatically when source reaches them.
---
--- @namespace nupp
local nupp: {

    --- Compiler-internal materialization conformance surface.
    --- @internal
    __materializationTest: nupp.__MaterializationTestAPI
}

--- Type inspection, construction, constraint validation, and target layout queries.
--- @namespace types
local types: {
    --- Admits a value into the constrained type the destination declares.
    ---
    --- The constrained type is taken from where the result goes -- an annotated
    --- binding, a declared result, a parameter -- so nothing names it twice. The
    --- value's own type has to be the constraint's base, because this admits a value
    --- into a narrower type and does not convert one.
    ---
    --- It raises when the constraint does not hold. `value is Type` is the same test
    --- without the raise, for a caller that wants to recover. A value the checker can
    --- already prove needs neither, and writing this around one is not an error.
    --- @param value the base-typed value to admit
    --- @return the same value, established as the destination's type
    --- @raises string when the value does not satisfy the constraint
    admit: function<T>(value: any): T,

    --- Returns the size in bytes under the build target's declared C ABI.
    --- Evaluates inside a comptime block with an explicit layoutTarget.
    sizeof: function(typename: any): integer,

    --- Returns the alignment in bytes under the build target's declared C ABI.
    --- Evaluates inside a comptime block with an explicit layoutTarget.
    alignof: function(typename: any): integer,

    --- Returns a field's byte offset under the build target's declared C ABI.
    --- Evaluates inside a comptime block with an explicit layoutTarget.
    offsetof: function(typename: any, fieldname: string): integer,

    --- The dynamic type; compatible with everything, checked at neither end.
    @readonly any: @comptime type,

    --- The top type; everything fits it, it fits nothing else.
    @readonly unknown: @comptime type,

    --- The bottom type; fits everything, nothing fits it.
    @readonly never: @comptime type,

    --- The nil singleton.
    @readonly niltype: @comptime type,

    --- `true` or `false`.
    @readonly bool: @comptime type,

    --- A Lua string.
    @readonly string: @comptime type,

    --- A LuaJIT double.
    @readonly number: @comptime type,

    --- A number known to be integral.
    @readonly integer: @comptime type,

    --- Any table shape, compatible with every table type in both directions,
    --- named separately from the standard library namespace.
    @readonly tabletype: @comptime type,

    --- A coroutine.
    @readonly thread: @comptime type,

    --- Userdata.
    @readonly userdata: @comptime type,

    --- An established binary32 Lua number; widens to `number`.
    @readonly float: @comptime type,

    --- Any cdata value.
    @readonly cdata: @comptime type,

    --- `const char *`.
    @readonly cstring: @comptime type,

    --- `void *`.
    @readonly voidptr: @comptime type,

    --- Signed physical storage; loads as `int32`.
    @readonly int8: @comptime type,

    --- Signed physical storage; loads as `int32`.
    @readonly int16: @comptime type,

    --- An established signed 32-bit Lua integer.
    @readonly int32: @comptime type,

    --- A boxed 64-bit signed cdata integer, as LuaJIT's `1LL`.
    @readonly int64: @comptime type,

    --- Unsigned physical storage; loads as `uint32`.
    @readonly uint8: @comptime type,

    --- Unsigned physical storage; loads as `uint32`.
    @readonly uint16: @comptime type,

    --- An established unsigned 32-bit Lua integer.
    @readonly uint32: @comptime type,

    --- A boxed 64-bit unsigned cdata integer, as LuaJIT's `1ULL`.
    @readonly uint64: @comptime type,

    --- The singleton type inhabited by a value.
    ---
    --- A number must be an exact integer, since a literal type names a value the
    --- checker compares for equality.
    --- @param value the inhabitant to lift into type position
    --- @return the type whose only value is `value`
    --- @raises string when the value is not a string, boolean, or exact integer
    @readonly literal: @comptime function(value: string | boolean | integer): type,

    --- The member that keeps a union open, so a switch over it stays inexhaustive.
    ---
    --- No name resolves to this type, so calling for it is the only way to place
    --- it in a union. That is what makes a non-exhaustive union a written decision
    --- rather than an inferred one. It may be written directly in a type as well
    --- as inside a generator.
    --- @return the open member
    --- @raises string when given any argument
    @readonly nonexhaustive: @comptime function(): type,

    --- `base` narrowed to the values from `min` through `max`, both included.
    ---
    --- A constrained type is a subtype of its base: it goes wherever the base goes.
    --- Entering one is admission rather than subtyping, so a value the checker
    --- cannot prove is refused and `types.admit` is how the program says it meant
    --- it. A literal is decided here and needs nothing written.
    ---
    --- The base is `integer`, `int32`, `uint32`, or a constrained alias of one,
    --- which narrows further by intersecting. Representation is unchanged: this
    --- converts nothing.
    --- @param base the type being narrowed
    --- @param min the lowest admitted value
    --- @param max the highest admitted value
    --- @return the constrained type
    --- @raises string when the base is unsupported or the bounds are empty or out
    ---     of range
    @readonly range: @comptime function(base: type, min: integer, max: integer): type,

    --- `base` narrowed to the byte lengths from `min` through `max`, both included.
    ---
    --- Bytes, matching Nupp's own string length: not code points, not graphemes. An
    --- embedded NUL counts like any other byte. The base is `string` or a
    --- constrained alias of it.
    --- @param base the type being narrowed
    --- @param min the shortest admitted length in bytes
    --- @param max the longest admitted length in bytes
    --- @return the constrained type
    --- @raises string when the base is not a string or the bounds are empty
    @readonly len: @comptime function(base: type, min: integer, max: integer): type,

    --- The Lua array `{element}`, with integer keys and no fixed length.
    --- @param element the element type
    --- @return the array type
    @readonly array: @comptime function(element: type): type,

    --- A fixed-length positional type, one slot per element in the order given.
    --- @param elements the slot types, in position order
    --- @return the tuple type
    @readonly tuple: @comptime function(elements: {type}): type,

    --- The union of its members, as a set.
    ---
    --- Nested unions are flattened, duplicates dropped, and the rest ordered
    --- canonically, so `union{A, union{A, B}}` and `union{A, B}` are one handle.
    --- @param members the member types, in any order
    --- @return the union type
    @readonly union: @comptime function(members: {type}): type,

    --- The intersection of its members, as a set, flattened and deduplicated the
    --- way `union` is. An intersection of function types is an overload set.
    --- @param members the member types, in any order
    --- @return the intersection type
    @readonly intersection: @comptime function(members: {type}): type,

    --- `inner | nil`.
    ---
    --- Built as a union, so it is idempotent: `optional(optional(T))` and
    --- `optional(T)` are one handle.
    --- @param inner the type to admit nil alongside
    --- @return the nilable type
    @readonly optional: @comptime function(inner: type): type,

    --- A pointer to `inner`.
    --- @param inner the pointee type
    --- @return the pointer type
    @readonly pointer: @comptime function(inner: type): type,

    --- `inner` behind a const capability, which permits reads and refuses writes.
    --- @param inner the type to make const
    --- @return the const type
    @readonly constof: @comptime function(inner: type): type,

    --- A borrow of `inner`, valid for the region that borrows it and not stored.
    --- @param inner the owned type being borrowed
    --- @return the borrowed type
    @readonly borrowed: @comptime function(inner: type): type,

    --- `inner` pinned to its address, so the collector may not move it.
    --- @param inner the type to pin
    --- @return the pinned type
    @readonly pinned: @comptime function(inner: type): type,

    --- An affine resource over `representation`: used at most once, and never
    --- copied.
    ---
    --- With a terminal, that const function is the operation consuming the
    --- resource, the way `close` consumes a file. Without one the resource is
    --- transfer-only, so ownership may move but nothing ends it.
    --- @param representation the underlying representation type
    --- @param terminal the const-function parameter that consumes it
    --- @return the affine type
    --- @raises string when the terminal is not a const-function parameter
    @readonly affine: @comptime function(representation: type): type
    & @comptime function(representation: type, const terminal: function): type,

    --- A C array of `element`, sized when `count` is given and unsized when it is
    --- not.
    --- @param element the element type
    --- @param count the fixed length, or nil for an unsized array
    --- @return the C array type
    --- @raises string when the count is not a non-negative exact integer
    @readonly carray: @comptime function(element: type, count: integer?): type,

    --- A type indexed by computed keys rather than by named fields.
    ---
    --- Each capability is a key/value pair: supply both halves or neither. At
    --- least one capability is required, and a read-only or write-only indexer is
    --- the point of taking them separately. `map` is the shorthand for the common
    --- case where both sides agree.
    --- @param readkey the key type reads accept
    --- @param readvalue the value type reads answer
    --- @param writekey the key type writes accept
    --- @param writevalue the value type writes accept
    --- @return the indexer type
    --- @raises string when a capability is missing half of its pair, or when
    ---     neither
    ---     capability is supplied
    @readonly indexer: @comptime function(readkey: type?, readvalue: type?, writekey: type?, writevalue: type?): type,

    --- An indexer whose write side mirrors its read side unless stated otherwise.
    ---
    --- Equivalent to `indexer(readkey, readvalue, writekey or readkey,
    --- writevalue or readvalue)`, and it returns a handle of kind
    --- `"indexer"`.
    --- @param readkey the key type reads accept
    --- @param readvalue the value type reads answer
    --- @param writekey the key type writes accept, defaulting to `readkey`
    --- @param writevalue the value type writes accept, defaulting to `readvalue`
    --- @return the indexer type
    @readonly map: @comptime function(readkey: type, readvalue: type, writekey: type?, writevalue: type?): type,

    --- A structural type with named fields, and optionally an indexer for the keys
    --- the names do not cover.
    ---
    --- Each descriptor needs a non-empty name unique within the shape, and at
    --- least one of `read` and `write`: a field with only `read` is readonly, one
    --- with only `write` is writeonly. Field order does not affect identity, so
    --- two shapes with the same fields are one handle however they were listed.
    --- @param fields the field descriptors
    --- @param indexer an indexer handle from `types.indexer` or
    ---     `types.map`
    --- @return the shape type
    --- @raises string when a name is empty or repeated, when a field declares
    ---     neither
    ---     capability, when the indexer did not come from an indexer builder, or
    ---     when there are more than 1000 fields
    @readonly shape: @comptime function(fields: const{{
        @readonly name: string,
        @readonly read: type?,
        @readonly write: type?
    }}, indexer: type?): type,

    --- A type pack: a fixed head of slots, then an optional tail standing for
    --- however many values remain.
    ---
    --- `modes` align with the head one for one and default to `"plain"`; the
    --- others are `"affine"`, `"borrowed"`, `"exclusive"`, and `"pinned"`.
    --- @param head the fixed slot types, in position order
    --- @param tail the type of the remaining values, or nil for a closed pack
    --- @param modes the ownership mode of each fixed slot
    --- @return the pack
    --- @raises string when there are more modes than slots, or a mode is not one of
    ---     the
    ---     five
    @readonly pack: @comptime function(head: {type}, tail: type?, modes: {string}?): typepack,

    --- Computes the arguments consumed by a literal Lua format string.
    ---
    --- A broad string produces an open `any` pack. `%?` is reserved for
    --- compiler-lowered formatting APIs.
    --- @param format the format-string type to inspect
    --- @return the argument pack consumed by its directives
    @readonly formatarguments: @comptime function(format: type): typepack,

    --- A function type from its parameter and result packs.
    --- @param parameters the parameter pack
    --- @param results the result pack
    --- @return the function type
    @readonly functiontype: @comptime function(parameters: typepack, results: typepack): type,

    --- The parameter pack of a function type.
    --- @param callable the function type to inspect
    --- @return its parameters
    --- @raises string when the handle is not a function type
    @readonly parameters: @comptime function(callable: type): typepack,

    --- The result pack of a function type.
    --- @param callable the function type to inspect
    --- @return its results
    --- @raises string when the handle is not a function type
    @readonly results: @comptime function(callable: type): typepack,

    --- What a handle is, as a string, which is the usual way to branch on one.
    ---
    --- The answer is the handle's own kind, not the builder that made it:
    --- `map` returns `"indexer"`, `optional` returns `"union"`, `pointer`
    --- returns `"ptr"`, and `constof` returns `"const"`. A nominal
    --- declaration returns `"reference"`, and `describe(T).declarationkind`
    --- says which category it declares.
    --- @param value the type or type pack to inspect
    --- @return the kind, such as `"literal"`, `"array"`, `"shape"`, or `"pack"`
    @readonly kind: @comptime function(value: type | typepack): string,

    --- Every fact about one handle at once, as a record whose members are
    --- populated according to its kind.
    ---
    --- Reach for it when a generator needs several facts about the same handle, or
    --- a fact no single accessor exposes, such as a pack's `tail` or a C array's
    --- `count`. A member that does not apply to the handle's kind is nil.
    --- @param value the type or type pack to inspect
    --- @return its descriptor
    @readonly describe: @comptime function(value: type | typepack): {
        @readonly kind: string,
        @readonly sourcekind: string?,

        --- Reports the nominal declaration category without expanding a reference.
        @readonly declarationkind: string?,
        @readonly name: string?,
        @readonly value: (string | boolean | integer)?,
        @readonly element: type?,
        @readonly members: {type}?,
        @readonly fields: {{
            @readonly name: string,
            @readonly read: type?,
            @readonly write: type?
        }}?,
        @readonly indexer: type?,
        @readonly readkey: type?,
        @readonly readvalue: type?,
        @readonly writekey: type?,
        @readonly writevalue: type?,
        @readonly nominal: boolean?,
        @readonly head: {type}?,
        @readonly tail: type?,
        @readonly modes: {string}?,
        @readonly count: integer?,
        @readonly parameters: typepack?,
        @readonly results: typepack?
    },

    --- The fixed elements of a composite type, or a pack's fixed head.
    --- @param value the type or type pack to take apart
    --- @return one handle per element, in declaration order
    @readonly elements: @comptime function(value: type | typepack): {type},

    --- The type arguments a generic declaration was applied to.
    ---
    --- Empty for a type that is not a generic application, so a caller may ask
    --- without knowing which it has.
    --- @param value the applied type to inspect
    --- @return one handle per argument, in declaration order
    @readonly arguments: @comptime function(value: type): {type},

    --- Whether two types name the same nominal declaration, ignoring its arguments.
    ---
    --- Aliases and ownership wrappers are transparent. Structural types and two
    --- different nominal declarations answer false even when their shapes match.
    @readonly samenominal: @comptime function(left: type, right: type): boolean,

    --- The parameters a record or struct is constructed with, as a pack whose
    --- slots carry their names.
    ---
    --- The one declared constructor's parameters, or the stored fields in
    --- declaration order when the declaration has no constructor; a field with a
    --- default, or one that admits nil, is an optional slot. Written as
    --- `...: unpackof types.construction(E)`, the pack is a parameter list a
    --- call binds by position or by name, the way it would for `new E(...)`.
    --- @param value the record or struct to inspect
    --- @return its construction contract
    --- @raises string when the declaration has several constructors, which is no
    ---     single
    ---     contract
    @readonly construction: @comptime function(value: type): typepack,

    --- The public fields of a shape or of a nominal record, interface, or struct.
    ---
    --- A nominal keeps its declaration identity: reading its fields does not
    --- expand it into a structural type. Each descriptor carries a `name` and
    --- whichever of `read` and `write` the field has. `describe(T).fields`
    --- reports the same descriptors.
    --- @param value the shape or nominal type to inspect
    --- @return one descriptor per field, in declaration order
    --- @raises string when the handle is neither a shape nor a nominal declaration
    @readonly fields: @comptime function(value: type): {{
        @readonly name: string,
        @readonly read: type?,
        @readonly write: type?
    }},

    --- Every key a type can be read at: one string literal per readable field,
    --- plus the indexer's read key when it has one.
    --- @param value the shape or indexer to inspect
    --- @return one handle per readable key
    --- @raises string when the handle is neither a shape nor an indexer
    @readonly readkeys: @comptime function(value: type): {type},

    --- Every key a type can be written at: one string literal per writable field,
    --- plus the indexer's write key when it has one.
    --- @param value the shape or indexer to inspect
    --- @return one handle per writable key
    --- @raises string when the handle is neither a shape nor an indexer
    @readonly writekeys: @comptime function(value: type): {type},

    --- The type read at a key: the named field when the key is a string literal
    --- naming a readable one, and otherwise the indexer's read value.
    --- @param value the type to project
    --- @param key the key to read at
    --- @return the value type at that key
    --- @raises string when the type has no read capability there, reported as
    ---     NUPP2420
    @readonly readat: @comptime function(value: type, key: type): type,

    --- The type written at a key: the named field when the key is a string
    --- literal naming a writable one, and otherwise the indexer's write value.
    --- @param value the type to project
    --- @param key the key to write at
    --- @return the value type at that key
    --- @raises string when the type has no write capability there, reported as
    ---     NUPP2420
    @readonly writeat: @comptime function(value: type, key: type): type,

    --- Rejects this type application deliberately, with an authored message.
    ---
    --- Distinct from an evaluator crash or a timeout: the message is
    --- reported at the application, with a bounded comptime call trace. It
    --- returns `never`, so a generator may call it in a branch that has no
    --- type to return.
    --- @param message what to report at the application
    --- @return nothing; the call does not come back
    @readonly error: @comptime function(message: string): never,

    --- Compiler-only derive inspection and closed forwarding recipes.
    derive: types.derive,

    --- Semantic reflection and reflection-driven field codecs.
    reflect: types.reflect
}

--- Checked ownership operations and managed cells.
--- @namespace own
local own: {
    --- Moves an exact affine obligation into an independently allocated cell.
    manage: function<T>(takes owner: T): managed(T),

    --- Recovers an erased alias from an untyped boundary after checking its brand.
    recoveralias: function(value: any): ((alias(unknown), nil) | (nil, own.AliasError))
}

----------------------------------------------------------------------------
-- Type-level computations
----------------------------------------------------------------------------

-- Public checked computations under the compiler-owned types namespace use this
-- implementation naming convention. Type-position resolution maps the public member
-- to the checked prelude body, while the declaration above remains the API callers
-- inspect and document.
@comptime
local function __NuppTypesFormatArguments(Format: type): typepack
    local info = types.describe(Format)
    local value = info.value
    if info.kind ~= "literal" or type(value) ~= "string" then
        return types.pack({}, types.any)
    end
    local source = value as string
    local arguments = {}
    local index = 1
    while index <= #source do
        if source:sub(index, index) ~= "%" then
            index = index + 1
        else
            index = index + 1
            local seen = ""
            local current = source:sub(index, index)
            if current == "%" then
                index = index + 1
            else
                while current ~= "" and string.find("-+ #0", current, 1, true) do
                    seen = seen .. current
                    index = index + 1
                    current = source:sub(index, index)
                end
                if current == "%" then
                    types.error('invalid string.format directive starting at "%' .. seen .. source:sub(index) .. '"')
                end

                local width = 0
                while current ~= "" and string.find("0123456789", current, 1, true) do
                    width = width + 1
                    seen = seen .. current
                    index = index + 1
                    current = source:sub(index, index)
                    if width > 2 then
                        types.error('invalid string.format directive starting at "%' .. seen .. '"')
                    end
                end

                if current == "." then
                    seen = seen .. current
                    index = index + 1
                    current = source:sub(index, index)
                    local precision = 0
                    while current ~= "" and string.find("0123456789", current, 1, true) do
                        precision = precision + 1
                        seen = seen .. current
                        index = index + 1
                        current = source:sub(index, index)
                        if precision > 2 then
                            types.error('invalid string.format directive starting at "%' .. seen .. '"')
                        end
                    end
                end

                if string.find("aAcdiouxXeEfgG", current, 1, true) then
                    arguments[#arguments + 1] = types.number
                elseif current == "?" then
                    types.error("%? is available only to compiler-lowered formatting APIs")
                elseif string.find("pqs", current, 1, true) then
                    arguments[#arguments + 1] = types.any
                else
                    types.error('invalid string.format directive starting at "%' .. seen .. source:sub(index) .. '"')
                end
                index = index + 1
            end
        end
    end

    return types.pack(arguments)
end

----------------------------------------------------------------------------
-- Materialization
----------------------------------------------------------------------------

--- A compile-time-only graph handle used by the compiler's materialization tests.
--- @internal
record nupp.__MaterializationBlueprint
    link: function(
        self: nupp.__MaterializationBlueprint,
        child: nupp.__MaterializationBlueprint
    ): nupp.__MaterializationBlueprint
end

--- A compile-time-only factory handle used by the compiler's conformance provider.
--- @internal
record nupp.__MaterializationFactoryBlueprint
end

--- The runtime value produced by the compiler's materialization test provider.
--- @internal
record nupp.__MaterializedTest
    value: integer
    nodes: integer
end

--- The ordinary runtime input accepted by the conformance provider's factory.
--- @internal
record nupp.__MaterializationTestInput
    value: integer
end

--- Compiler-internal constructors for the materialization conformance provider.
--- @internal
record nupp.__MaterializationTestAPI
    node: function(value: integer): nupp.__MaterializationBlueprint
    factory: function(): nupp.__MaterializationFactoryBlueprint
end

----------------------------------------------------------------------------
-- The derive namespace
----------------------------------------------------------------------------

--- Generates checked members on a declaration while that declaration is checked.
---
--- `@derive(Provider, ...)` names providers on a `record` or `struct`. Each one reads
--- an immutable semantic view of the declaration and returns a closed recipe; the
--- compiler generates members from that recipe and checks them the way it checks
--- written ones. This is a declaration-augmentation phase rather than a text macro. A
--- provider adds no imports, top-level declarations, modules, or independently
--- nameable types, and it observes no tokens, source positions, ordinary comments,
--- mutable syntax objects, or another provider's output. It does see normalized
--- declaration and field docblocks.
---
--- The shipped `Debug` provider crosses the same boundary as a package provider.
--- Serialization uses explicit bindings instead of derive recipes.
---
--- #### Derive the shipped providers
---
--- ```nupp
--- @derive(types.debug)
--- local record Settings
---     host: string = "localhost"
---     port: integer = 8080
--- end
---
--- local settings = new Settings()
--- assert(settings:debug() == 'Settings { host = "localhost", port = 8080 }')
--- ```
---
--- #### Write a package provider
---
--- A provider is an exported, nongeneric `@comptime function` whose signature names the
--- one interface it implements. `Info` describes the owner, `implement` returns the
--- recipe, and a consumer applies the resolved export rather than a runtime function
--- value. Applying it also claims that interface.
---
--- ```nupp:fragment:static
--- local M = {}
---
--- interface M.Named
---     named: function(self): string
--- end
---
--- function M.nameValue(value: string): string
---     return "name=" .. value
--- end
---
--- @comptime function M.derive(info: types.derive.Info): types.derive.Result<M.Named>
---     local field = info.fields[1]
---     if not field or field.name ~= "name" then
---         return types.derive.error("Named needs a first field named name", info.reference)
---     end
---
---     return types.derive.implement{
---         methods = {
---             named = types.derive.forward{
---                 helper = types.derive.helper(M, "nameValue"),
---                 arguments = {types.derive.field(field)},
---             },
---         },
---     }
--- end
---
--- @derive(M.derive)
--- record M.User
---     name: string
--- end
---
--- local user = new M.User(name = "ada")
--- assert(user:named() == "name=ada")
---
--- return M
--- ```
---
--- #### Recipe vocabulary
---
--- The interface owns every generated signature, so a recipe chooses only which runtime
--- function stands behind a requirement and which values reach it. `forward` names one
--- ordinary exported Nupp function and a closed argument list built from `receiver`,
--- `argument`, `field`, `constant`, and `array`. There are no nested calls, operators,
--- branches, loops, assignments, or provider-chosen signatures, so behavior stays in
--- ordinary type-checked Nupp rather than in a macro IR, and the generated call is
--- checked against the helper's declaration the way any other call is.
---
--- `forward.v1` fills only bodyless, unoverloaded callable requirements, and cannot
--- replace an interface default. A provider that refuses a declaration returns `error`
--- rather than raising.
---
--- Providers run inside the bounded comptime worker, once per owner rather than once
--- per generic instantiation, and a recipe is memoized on the `Info` fingerprint.
--- `claims` asks whether a type already writes or requests an interface, which lets
--- mutually recursive derives plan without depending on evaluation order.
record types.derive
    --- A comptime-only provider symbol accepted by `@derive`.
    ---
    --- A provider is the
    --- `@comptime function` a module exports. It does not survive into the program.
    record Provider
    end

    --- The checked shape of `@event`, written on a declaration deriving
    --- `events.event`.
    interface EventOptions
        --- The name the event registers under. The declaration's own name when
        --- omitted; written when the name is an external surface something pins.
        name: string?
    end

    --- The checked shape of `@debug`, written on a field.
    interface DebugOptions
        --- Removes the field from the rendered output entirely.
        skip: boolean?

        --- Keeps the field's name and renders its value as `<redacted>`.
        redact: boolean?
    end

    --- An opaque reference which a provider may attach to a diagnostic.
    ---
    --- Obtained from `Info.reference` for the declaration or `Field.reference` for one
    --- field, and accepted only by `error`. It carries no filename, line, or column: a
    --- provider says which part of the declaration is at fault and the compiler decides
    --- where to point.
    record Reference
    end

    --- A written stored field in the immutable derive input projection.
    ---
    --- Fields arrive in declaration order. A generated member never reaches one by
    --- name; pass this value to `field` to read it.
    record Field
        --- The name as written.
        @readonly name: string

        --- The field's `---` documentation text, with markers and tags removed.
        @readonly documentation: string?

        --- Whether the field can be read, and so whether `field` admits it.
        @readonly readable: boolean

        --- Whether the field can be written.
        @readonly writable: boolean

        --- A transported handle for the read type, or nil for a write-only field.

        @readonly readtype: any?

        --- A transported handle for the write type, or nil for a read-only field.

        @readonly writetype: any?

        --- Whether omission during construction supplies a declaration-owned default.

        @readonly hasdefault: boolean

        --- The source-free constant default value. Read only when `hasDefault` is true.

        @readonly defaultvalue: any

        --- The field's typed annotations in source order, `@debug` among
        --- them.
        @readonly annotations: {types.reflect.Annotation}

        --- Points this provider's `error` at this field.
        @readonly reference: Reference
    end

    --- The immutable semantic view passed to an `@comptime function` provider.
    ---
    --- An `Info` describes an owner for a provider, and is built before any
    --- provider's output is merged, so two providers on the same declaration see the
    --- same thing whichever order they run in. A generic owner is projected once rather
    --- than per instantiation, and a type parameter exposes its bound, or `unknown`, so
    --- a provider cannot specialize for arguments a later instantiation supplies.
    record Info
        --- The projection's schema version, currently 2.
        @readonly schema: integer

        --- What the owner was declared as: `record`, `struct`, or `interface`.
        @readonly kind: string

        --- The owner's declared name.
        @readonly name: string

        --- The declaration's module-qualified name, independent of filesystem paths.

        @readonly qualifiedname: string

        --- How the declaration is bound: `local`, `module`, `global`, or `nested`.
        @readonly visibility: string

        --- The declaration's `---` documentation text, with markers and tags removed.
        @readonly documentation: string?

        --- The stable identity of the provider being run.

        @readonly provideridentity: string

        --- The stable identity of the owning declaration.

        @readonly owneridentity: string

        --- A transported handle for the owner's type, accepted by `claims`.

        @readonly ownertype: any

        --- A transported handle for the one interface this provider implements.

        @readonly interfacetype: any

        --- The written stored fields, in declaration order.
        @readonly fields: {Field}

        --- The owner's own typed annotations, in source order.
        @readonly annotations: {types.reflect.Annotation}

        --- Whether the declaration writes a constructor.

        @readonly hasconstructor: boolean

        --- Points this provider's `error` at the declaration as a whole.
        @readonly reference: Reference

        --- A digest of everything above. Two owners with one fingerprint share one
        --- evaluation, so a provider must decide from `Info` and nothing else.
        @readonly fingerprint: string
    end

    --- A value a generated call passes.
    ---
    --- Built by `receiver`, `entry`, `argument`, `field`, `constant`, `witness`,
    --- or `array`.
    --- The compiler owns it: a provider may hold one and place it in an argument
    --- list, and nothing else.
    record Argument
    end

    --- An ordinary exported Nupp function a generated member calls, from `helper`.
    ---
    --- The module owning it becomes a runtime dependency of the consumer, even when the
    --- comptime provider itself erases.
    record RuntimeHelper
    end

    --- A requirement's implementation, from `forward`, to be placed in `implement`
    --- under the name of the requirement it fills.
    record Forward
    end

    --- A generated member with a comptime-built function signature and forward
    --- recipe. Use this when the provider declares a member that is not already an
    --- interface requirement.
    record Member
    end

    --- What a provider returns: the recipe implementing interface `I`.
    ---
    --- `I` is the interface the provider implements, or `any` when every generated
    --- member supplies its own signature. Writing an interface in the return type is
    --- how `@derive` knows which contract applying the provider claims. Produce one
    --- with `implement`, or refuse the declaration with `error`. The compiler owns it
    --- and there is nothing on it to read: what it carries crosses the comptime
    --- boundary as a versioned recipe the compiler validates.
    ---
    --- @typearg I the interface this provider implements, or `any`
    record Result<I>
    end

    --- Returns forwarding implementations. `methods` fills instance members and
    --- `statics` fills static members.
    ---
    --- Both are keyed by member name. A `Forward` fills a bodyless, unoverloaded
    --- callable requirement on the provider's interface; a `Member` supplies a new
    --- member's function signature and forwarding recipe. Generating a member that
    --- another provider on the same owner already generates is refused.
    ---
    --- @param specification a table with optional `methods` and `statics` maps
    --- @return the recipe, as this provider's `Result<I>`
    implement: function(specification: any): any

    --- Reads an immutable filesystem input admitted to this provider invocation.
    ---
    --- The path must be a string literal in the provider's checked source. It resolves
    --- from the consumer project root, becomes an incremental query dependency, and is
    --- included in the provider recipe fingerprint. Watch mode therefore observes the
    --- file and rechecks only modules that consume the provider.
    ---
    --- @param path project-relative path written as a literal
    --- @return the file's bytes
    file: function(path: string): string

    --- Refuses the declaration with a diagnostic instead of returning a recipe.
    ---
    --- The reference decides what the diagnostic points at: `Info.reference` for the
    --- declaration, or the `Field.reference` of the field that made the recipe
    --- impossible. Returning this is how a provider fails; raising is a provider fault.
    ---
    --- @param message what the consumer is told
    --- @param reference which part of the declaration is at fault
    --- @param code the diagnostic code, defaulting to `NUPP2810`
    --- @return the refusal, as this provider's `Result<I>`
    error: function(message: string, reference: Reference?, code: string?): any

    --- Implements a requirement by calling a runtime helper.
    ---
    --- `helper` names the function and `arguments` is the closed list it receives, in
    --- order. The interface owns the resulting signature, and the generated call is
    --- checked against the helper's declaration for types, ownership, effects, and its
    --- suspension contract.
    ---
    --- @param specification a table with `helper` and `arguments`
    --- @return the implementation, to place in `implement`
    forward: function(specification: any): Forward

    --- Declares a generated member's function signature and forwarding recipe.
    --- Parameter names are non-empty and unique.
    ---
    --- @param specification a table with `signature`, optional parameter names, and
    --- a `forward` recipe
    --- @return the member recipe, to place in `implement`
    member: function(specification: any): Member

    --- Names an ordinary exported Nupp function to forward to.
    ---
    --- Runtime behavior stays in the language: helpers are checked at their own
    --- declarations, and a generic helper is refused by `forward.v1`.
    ---
    --- @param module the module value holding the function
    --- @param name the name it is exported under
    --- @return the helper handle
    helper: function(module: any, name: string): RuntimeHelper

    --- Passes the generated method's receiver.
    ---
    --- @return the argument recipe
    receiver: function(): Argument

    --- Passes the record's registered derive entry.
    ---
    --- @return the argument recipe
    entry: function(): Argument

    --- Passes a parameter of the generated method, under the name the interface
    --- requirement declares for it.
    ---
    --- @param name the parameter's declared name
    --- @return the argument recipe
    argument: function(name: string): Argument

    --- Reads a stored field of the receiver directly. The field must be readable.
    ---
    --- @param field one of `Info.fields`
    --- @return the argument recipe
    field: function(field: Field): Argument

    --- Embeds a bounded quotable value.
    ---
    --- A table-shaped constant is rebuilt for every call, so mutation by one invocation
    --- cannot reach the next.
    ---
    --- @param value the value to embed
    --- @return the argument recipe
    constant: function(value: any): Argument

    --- Resolves a `@ref` annotation argument to its transported type handle.
    ---
    --- The argument must come from `Info.annotations` or one of its fields. The
    --- returned handle can be inspected with `types` and passed to `witness`.
    ---
    --- @param argument a reflected annotation argument whose kind is `type`
    --- @return the referenced type handle
    annotationtype: function(argument: types.reflect.AnnotationArgument): any

    --- Passes a named record's first-class `Type<T>` witness to the runtime helper.
    ---
    --- @param subject a transported nominal type handle
    --- @return the argument recipe
    witness: function(subject: any): Argument

    --- Builds a fresh array from argument recipes, once per call.
    ---
    --- @param arguments the element recipes, in order
    --- @return the argument recipe
    array: function(arguments: {Argument}): Argument

    --- Asks whether a type writes or requests an interface.
    ---
    --- The answer does not depend on whether that type's own providers have run, so
    --- mutually recursive derives can plan against one another.
    ---
    --- @param subject a type handle, such as a `Field.readtype`
    --- @param interface a type handle, such as `Info.interfacetype`
    --- @return whether `subject` claims `interface`
    claims: function(subject: any, interface: any): boolean
end

----------------------------------------------------------------------------
-- The reflect namespace
----------------------------------------------------------------------------

--- Semantic type reflection and reflection-driven field codecs.
---
--- Call the namespace with a concrete type inside `comptime` to obtain an immutable,
--- target-independent descriptor. `fieldcodec` materializes the stored fields of a
--- reflected record into a keyed runtime codec.
---
--- The root's common facts are projected onto `Info`, so the usual inspection does
--- not need to walk the graph:
---
--- ```nupp
--- local record User
---     id: integer
---     name: string = "anonymous"
--- end
---
--- const UserSummary: string = comptime do
---     local info = types.reflect(User)
---     assert(info.kind == "record")
---     assert(info.fields[2].hasdefault)
---     return info.fields[1].name .. ":" .. info.fields[1].kind
--- end
---
--- assert(UserSummary == "id:integer")
--- ```
---
--- Use `root`, `types`, and the integer edges between them when a generator needs the
--- complete semantic type rather than the root projection. The graph remains finite
--- even when the declaration is recursive:
---
--- ```nupp
--- local record Node
---     value: string
---     next: Node?
--- end
---
--- const NextKind: string = comptime do
---     local info = types.reflect(Node)
---     local edge = info.fields[2].type as integer
---     return info.types[edge].kind
--- end
---
--- assert(NextKind == "union")
--- ```
record types.reflect
    --- A typed identity for data derived lazily from a reflection descriptor,
    --- schema, or binding.
    ---
    --- It has the shape of `types.Key<T>`, declared here because the prelude
    --- is read before any module is. `_valueType` is never present; it mentions
    --- `T` in both positions so that keys are invariant.
    interface ExtensionKey<T>
        @readonly id: integer
        @readonly name: string?
        @readonly _valueType: (function(value: T?): T?)?
    end

    --- A checked member supplied to a reflected typed annotation.
    ---
    --- `value` is present for `kind = "value"`; `type` is an index into the owning
    --- `Info.types` graph for `kind = "type"`. `kind = "nil"` preserves an explicitly
    --- supplied nil without pretending an absent table field contains it.
    ---
    --- ```nupp
    --- @annotation(targets = {"field"})
    --- local record serialized
    ---     name: string?
    ---     @ref
    ---     codec: any
    --- end
    ---
    --- local record StringCodec
    --- end
    ---
    --- local record User
    ---     @serialized(name = "user_id", codec = StringCodec)
    ---     id: integer
    --- end
    ---
    --- const Serialization: string = comptime do
    ---     local info = types.reflect(User)
    ---     local arguments = info.fields[1].annotations[1].arguments
    ---     assert(arguments[1].kind == "value")
    ---     assert(arguments[2].kind == "type")
    ---     local codec = info.types[arguments[2].type as integer]
    ---     return (arguments[1].value as string) .. ":" .. (codec.name as string)
    --- end
    ---
    --- assert(Serialization == "user_id:StringCodec")
    --- ```
    record AnnotationArgument
        @readonly name: string
        @readonly kind: "value" | "nil" | "type"
        @readonly value: any?
        @readonly type: integer?
    end

    --- A typed annotation application, retaining source order.
    record Annotation
        @readonly name: string
        @readonly arguments: {AnnotationArgument}
    end

    --- A visible field projected directly from the reflected root type.
    ---
    --- The projection preserves declaration order, access capabilities, defaults, and
    --- annotations without requiring a lookup in `Info.types`. `stored` distinguishes
    --- stored fields, including callbacks, from methods.
    ---
    --- ```nupp
    --- local record Options
    ---     format: string = "compact"
    ---     retries: integer
    --- end
    ---
    --- const DefaultFormat: string = comptime do
    ---     local field = types.reflect(Options).fields[1]
    ---     assert(field.name == "format" and field.hasdefault)
    ---     assert(field.readable and field.writable)
    ---     return field.defaultvalue as string
    --- end
    ---
    --- assert(DefaultFormat == "compact")
    --- ```
    record Field
        @readonly name: string
        @readonly kind: string
        @readonly typename: string?
        @readonly type: integer?
        @readonly stored: boolean
        @readonly readable: boolean
        @readonly writable: boolean
        @readonly hasdefault: boolean
        @readonly defaultvalue: any
        @readonly annotations: {Annotation}
    end

    --- A named or positional edge in the indexed semantic type graph.
    record Entry
        @readonly name: string?
        @readonly type: integer?
        @readonly read: integer?
        @readonly write: integer?
        @readonly stored: boolean?
        @readonly readable: boolean?
        @readonly writable: boolean?
        @readonly hasdefault: boolean?
        @readonly defaultvalue: any
        @readonly mode: string?
        @readonly bound: integer?
        @readonly answer: integer?
        @readonly default: boolean?
        @readonly annotations: {Annotation}?
        @readonly [string]: any
    end

    --- A node in an `Info` semantic type graph.
    ---
    --- Fields, parameters, results, union members, generic arguments, and wrappers
    --- point to other nodes by their integer index. Resolve only the edges relevant to
    --- the node's `kind`.
    ---
    --- ```nupp
    --- local type Handler = function(message: string, attempts: integer): boolean
    ---
    --- const HandlerShape: string = comptime do
    ---     local info = types.reflect(Handler)
    ---     local handler = info.types[info.root]
    ---     assert(handler.kind == "func")
    ---     local first = (handler.parameters as {types.reflect.Entry})[1]
    ---     local input = info.types[first.type as integer]
    ---     local output = info.types[(handler.returns as {integer})[1]]
    ---     return (first.name as string) .. ":" .. input.kind .. "->" .. output.kind
    --- end
    ---
    --- assert(HandlerShape == "message:string->boolean")
    --- ```
    record Node
        --- Whether a nominal value has no ownership obligation or scoped borrow.
        @readonly copyable: boolean?

        @readonly kind: string
        -- Public descriptor aliases accepted before canonical source adoption.
        @readonly modulename: string?
        @readonly derivekey: string?
        @readonly arrayof: integer?
        @readonly varargtype: integer?
        @readonly borrowedfrom: integer?
        @readonly borrowedfrommany: {integer}?
        @readonly borrowedresult: integer?
        @readonly parameterpack: integer?
        @readonly returnpack: integer?
        @readonly yieldpack: integer?
        @readonly resumepack: integer?
        @readonly startpack: integer?
        @readonly resultkind: string?
        @readonly transferonly: boolean?
        @readonly countterm: integer?
        @readonly readkey: integer?
        @readonly readvalue: integer?
        @readonly writekey: integer?
        @readonly writevalue: integer?
        @readonly index: const{
            @readonly readkey: integer?,
            @readonly readvalue: integer?,
            @readonly writekey: integer?,
            @readonly writevalue: integer?
        }?
        @readonly construction: const{
            @readonly requiresfactory: boolean?,
            @readonly [string]: any
        }?
        @readonly cleanups: {const{
            @readonly functiontype: integer?,
            @readonly [string]: any
        }}?
        @readonly name: string?
        @readonly nominal: boolean?
        @readonly annotations: {Annotation}?
        @readonly fields: {Entry}?
        @readonly staticfields: {Entry}?
        @readonly metamethods: {Entry}?
        @readonly nestedtypes: {Entry}?
        @readonly associatedtypes: {Entry}?
        @readonly members: {integer}?
        @readonly parameters: {Entry}?
        @readonly returns: {integer}?
        @readonly typeparameters: {integer}?
        @readonly typebounds: {integer}?
        @readonly packparameters: {integer}?
        @readonly constparameters: {integer}?
        @readonly parameterkinds: {string}?
        @readonly typearguments: {integer}?
        @readonly packarguments: {integer}?
        @readonly constarguments: {integer}?
        @readonly supertypes: {integer}?
        @readonly element: integer?
        @readonly body: integer?
        @readonly of: integer?
        @readonly origin: integer?
        @readonly noreturn: boolean?
        @readonly noyield: boolean?
        @readonly [string]: any
    end

    --- A top-level stored struct field available as a SoA column.
    record SoAField
        @readonly name: string
        @readonly identity: string
        @readonly ordinal: integer
        @readonly type: integer?
        @readonly ctype: string?
        @readonly eligible: boolean
    end

    --- Target-independent semantic inputs to SoA storage derivation.
    ---
    --- This says whether the declaration can be split into columns and identifies
    --- those columns. It deliberately does not contain target sizes or offsets; use
    --- `nupp.mem.soa.layoutof` for those.
    ---
    --- ```nupp
    --- local struct Particle
    ---     x: float
    ---     y: float
    --- end
    ---
    --- const ParticleColumns: string = comptime do
    ---     local soa = types.reflect(Particle).soa
    ---     assert(soa.eligible and #soa.fields == 2)
    ---     assert(soa.fields[1].ordinal == 1)
    ---     return soa.fields[1].name .. "," .. soa.fields[2].name
    --- end
    ---
    --- assert(ParticleColumns == "x,y")
    --- ```
    record SoAInfo
        @readonly schema: integer
        @readonly eligible: boolean
        @readonly reason: string?
        @readonly fields: {SoAField}
    end

    --- An immutable compile-time description of a resolved semantic type.
    ---
    --- `Info` can cross typed comptime helper boundaries. Its fingerprint is suitable
    --- for cache keys because it changes with the canonical type graph, defaults, and
    --- checked annotations rather than with compiler-local identities.
    ---
    --- ```nupp
    --- local record Pair
    ---     left: string
    ---     right: integer
    --- end
    ---
    --- @comptime local function describe(info: types.reflect.Info): string
    ---     return info.fingerprint .. ":" .. tostring(#info.fields)
    --- end
    ---
    --- const PairDescription: string = comptime do
    ---     return describe(types.reflect(Pair))
    --- end
    ---
    --- assert(PairDescription:match(":2$") ~= nil)
    --- ```
    record Info
        @readonly schema: integer
        @readonly root: integer
        @readonly types: const{Node}
        @readonly kind: string
        @readonly name: string
        @readonly qualifiedname: string
        @readonly fields: const{Field}
        @readonly annotations: const{Annotation}
        @readonly soa: const SoAInfo
        @readonly fingerprint: string
    end

    --- An opaque field-codec recipe returned inside `comptime`.
    record FieldCodecBlueprint
    end

    --- A keyed runtime codec materialized from a reflected record.
    ---
    --- `encode` copies present declared fields into a plain keyed table. `decode`
    --- selects the same fields from a keyed table and restores the record's runtime
    --- identity. Both operations are shallow. The stable fingerprint records the
    --- field names in declaration order.
    ---
    --- ```nupp
    --- local record Position
    ---     x: number
    ---     y: number
    --- end
    ---
    --- const PositionCodec: types.reflect.FieldCodec<Position> = comptime do
    ---     return types.reflect.fieldcodec(types.reflect(Position))
    --- end
    ---
    --- local encoded = PositionCodec:encode(new Position(x = 3, y = 4))
    --- assert(encoded.x == 3 and encoded.y == 4)
    --- assert(PositionCodec.fingerprint == "t:x,y")
    --- ```
    record FieldCodec<T>
        encode: function(self, value: T): {[string]: any}
        decode: function(self, value: {[string]: any}): (T?, string?)
        fingerprint: string
    end

    --- Creates an identity for a lazily derived metadata value.
    ---
    --- A descriptor, schema, or binding builds a key's value once, then returns
    --- the same value from its private cache. Key identities and their slot
    --- numbers are process-local and must not be persisted.
    extensionkey: function<T>(build: function(host: any): T): ExtensionKey<T>

    --- Reads the semantic description carried by a first-class type witness.
    --- Generic consumers use the same descriptor as concrete callers.
    runtime: function<T>(typeobject: Type<T>): Info

    --- Reads an available nominal witness reachable through stored fields or
    --- constructor parameters. An unresolved forward declaration returns nil.
    runtimetype: function(info: Info, index: integer): Type<unknown>?

    --- Reflects a concrete type for use inside a `comptime` block.
    ---
    --- ```nupp
    --- local record Point
    ---     x: number
    ---     y: number
    --- end
    ---
    --- @comptime local function fieldCount(info: types.reflect.Info): integer
    ---     return #info.fields
    --- end
    ---
    --- const PointFieldCount: integer = comptime do
    ---     return fieldCount(types.reflect(Point))
    --- end
    --- assert(PointFieldCount == 2)
    --- ```
    metamethod __call: @comptime function(self, typename: any): Info

    --- Builds a keyed field-codec recipe from a reflected record.
    ---
    --- The opaque recipe must directly initialize a matching
    --- `FieldCodec<Record>` declaration. It may pass through typed comptime helpers
    --- on the way to that materialization boundary.
    ---
    --- ```nupp
    --- local record Message
    ---     id: integer
    ---     text: string
    --- end
    ---
    --- @comptime local function keyed(
    ---     info: types.reflect.Info
    --- ): types.reflect.FieldCodecBlueprint
    ---     return types.reflect.fieldcodec(info)
    --- end
    ---
    --- const MessageCodec: types.reflect.FieldCodec<Message> = comptime do
    ---     return keyed(types.reflect(Message))
    --- end
    ---
    --- local encoded = MessageCodec:encode(new Message(id = 1, text = "hello"))
    --- assert(encoded.id == 1 and encoded.text == "hello")
    --- ```
    fieldcodec: @comptime function(info: Info): FieldCodecBlueprint
end

----------------------------------------------------------------------------
-- Annotations
----------------------------------------------------------------------------

--- Internal typed schema for the compiler-owned @deprecated annotation.
--- @internal
interface nupp.__DeprecatedAnnotation
    --- Why callers should stop using the API.
    reason: string?

    --- The API name callers should migrate to.
    replacement: string?
end

----------------------------------------------------------------------------
-- Math libraries
----------------------------------------------------------------------------

--- Two-dimensional vector operations on number pairs.
--- @internal
record nupp.Vec2Library
    --- Adds two vectors.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the sum's x component
    --- @return the sum's y component
    add: function(ax: number, ay: number, bx: number, by: number): (number, number)

    --- Subtracts the second vector from the first.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the difference's x component
    --- @return the difference's y component
    sub: function(ax: number, ay: number, bx: number, by: number): (number, number)

    --- Multiplies a vector by a scalar.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @param factor the scale factor
    --- @return the scaled x component
    --- @return the scaled y component
    scale: function(x: number, y: number, factor: number): (number, number)

    --- Computes the dot product of two vectors.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the dot product
    dot: function(ax: number, ay: number, bx: number, by: number): number

    --- Computes the signed scalar cross product of two vectors.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the scalar cross product
    cross: function(ax: number, ay: number, bx: number, by: number): number

    --- Computes a vector's squared magnitude without a square root.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @return the squared magnitude
    lengthsquared: function(x: number, y: number): number

    --- Computes a vector's magnitude.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @return the magnitude
    len: function(x: number, y: number): number

    --- Computes the squared distance between two points without a square root.
    --- @param ax the first point's x coordinate
    --- @param ay the first point's y coordinate
    --- @param bx the second point's x coordinate
    --- @param by the second point's y coordinate
    --- @return the squared distance
    distancesquared: function(ax: number, ay: number, bx: number, by: number): number

    --- Computes the distance between two points.
    --- @param ax the first point's x coordinate
    --- @param ay the first point's y coordinate
    --- @param bx the second point's x coordinate
    --- @param by the second point's y coordinate
    --- @return the distance
    dist: function(ax: number, ay: number, bx: number, by: number): number

    --- Returns a unit vector in the same direction, or `(0, 0)` for zero.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @return the normalized x component
    --- @return the normalized y component
    normalize: function(x: number, y: number): (number, number)

    --- Linearly interpolates or extrapolates between two vectors.
    --- @param ax the starting x component
    --- @param ay the starting y component
    --- @param bx the ending x component
    --- @param by the ending y component
    --- @param t the unclamped interpolation factor
    --- @return the interpolated x component
    --- @return the interpolated y component
    lerp: function(ax: number, ay: number, bx: number, by: number, t: number): (number, number)

    --- Moves toward a target by at most a distance, without overshooting.
    --- @param ax the starting x component
    --- @param ay the starting y component
    --- @param bx the target x component
    --- @param by the target y component
    --- @param distance the maximum step; nonpositive values leave the start unchanged
    --- @return the resulting x component
    --- @return the resulting y component
    movetowards: function(ax: number, ay: number, bx: number, by: number, distance: number): (number, number)

    --- Rotates a vector around the origin.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @param radians the signed rotation in radians
    --- @return the rotated x component
    --- @return the rotated y component
    rotate: function(x: number, y: number, radians: number): (number, number)

    --- Computes a vector's signed direction from the positive x-axis.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @return the angle in radians, or zero for the zero vector
    angle: function(x: number, y: number): number

    --- Computes the smallest unsigned angle between two vectors.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the angle from zero through pi, or zero for a zero vector
    anglebetween: function(ax: number, ay: number, bx: number, by: number): number

    --- Computes the smallest signed angle from the first vector to the second.
    --- @param ax the first vector's x component
    --- @param ay the first vector's y component
    --- @param bx the second vector's x component
    --- @param by the second vector's y component
    --- @return the angle in `[-pi, pi)`, or zero for a zero vector
    signedanglebetween: function(ax: number, ay: number, bx: number, by: number): number

    --- Projects a vector onto another vector.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @param ontoX the projection axis's x component
    --- @param ontoY the projection axis's y component
    --- @return the projected x component, or zero for a zero axis
    --- @return the projected y component, or zero for a zero axis
    project: function(x: number, y: number, ontoX: number, ontoY: number): (number, number)

    --- Reflects a vector across a normal.
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @param normalX the normal's x component
    --- @param normalY the normal's y component
    --- @return the reflected x component, or the input x for a zero normal
    --- @return the reflected y component, or the input y for a zero normal
    reflect: function(x: number, y: number, normalX: number, normalY: number): (number, number)
end

--- Three-dimensional rotation operations on `(x, y, z, w)` number quadruples.
--- @internal
record nupp.QuatLibrary
    --- Returns the rotation that turns nothing.
    --- @return the identity x component, zero
    --- @return the identity y component, zero
    --- @return the identity z component, zero
    --- @return the identity w component, one
    identity: function(): (number, number, number, number)

    --- Adds two rotations componentwise.
    --- @param ax the first rotation's x component
    --- @param ay the first rotation's y component
    --- @param az the first rotation's z component
    --- @param aw the first rotation's w component
    --- @param bx the second rotation's x component
    --- @param by the second rotation's y component
    --- @param bz the second rotation's z component
    --- @param bw the second rotation's w component
    --- @return the sum's x component
    --- @return the sum's y component
    --- @return the sum's z component
    --- @return the sum's w component
    add: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number
    ): (number, number, number, number)

    --- Subtracts the second rotation from the first componentwise.
    --- @param ax the first rotation's x component
    --- @param ay the first rotation's y component
    --- @param az the first rotation's z component
    --- @param aw the first rotation's w component
    --- @param bx the second rotation's x component
    --- @param by the second rotation's y component
    --- @param bz the second rotation's z component
    --- @param bw the second rotation's w component
    --- @return the difference's x component
    --- @return the difference's y component
    --- @return the difference's z component
    --- @return the difference's w component
    sub: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number
    ): (number, number, number, number)

    --- Multiplies every component by a factor.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @param factor the scaling factor
    --- @return the scaled x component
    --- @return the scaled y component
    --- @return the scaled z component
    --- @return the scaled w component
    scale: function(x: number, y: number, z: number, w: number, factor: number): (number, number, number, number)

    --- Returns the four-component dot product, the cosine of half the angle between
    --- two unit rotations.
    --- @param ax the first rotation's x component
    --- @param ay the first rotation's y component
    --- @param az the first rotation's z component
    --- @param aw the first rotation's w component
    --- @param bx the second rotation's x component
    --- @param by the second rotation's y component
    --- @param bz the second rotation's z component
    --- @param bw the second rotation's w component
    --- @return the dot product
    dot: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number
    ): number

    --- Returns the squared length, which is one for a unit rotation.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the squared length
    lengthsquared: function(x: number, y: number, z: number, w: number): number

    --- Returns the length, which is one for a unit rotation.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the length
    len: function(x: number, y: number, z: number, w: number): number

    --- Returns a unit rotation in the same direction, or the identity for zero.
    ---
    --- The sign is left alone: `q` and `-q` are the same rotation, and which one
    --- arrived is not canonicalized away.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the normalized x component, or zero for a zero rotation
    --- @return the normalized y component, or zero for a zero rotation
    --- @return the normalized z component, or zero for a zero rotation
    --- @return the normalized w component, or one for a zero rotation
    normalize: function(x: number, y: number, z: number, w: number): (number, number, number, number)

    --- Returns the rotation undoing a unit one.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the conjugate's x component
    --- @return the conjugate's y component
    --- @return the conjugate's z component
    --- @return the conjugate's w component
    conjugate: function(x: number, y: number, z: number, w: number): (number, number, number, number)

    --- Returns the rotation undoing any non-zero one, or the identity for zero.
    ---
    --- `conjugate` is this for a unit rotation and is cheaper; this one is also
    --- correct for a rotation whose length has drifted from one.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the inverse's x component, or zero for a zero rotation
    --- @return the inverse's y component, or zero for a zero rotation
    --- @return the inverse's z component, or zero for a zero rotation
    --- @return the inverse's w component, or one for a zero rotation
    inverse: function(x: number, y: number, z: number, w: number): (number, number, number, number)

    --- Composes two rotations, applying the second one first.
    ---
    --- The order matches column-major matrix multiplication, so the matrix of
    --- `mul(a, b)` is the matrix of `a` times the matrix of `b`.
    --- @param ax the second-applied rotation's x component
    --- @param ay the second-applied rotation's y component
    --- @param az the second-applied rotation's z component
    --- @param aw the second-applied rotation's w component
    --- @param bx the first-applied rotation's x component
    --- @param by the first-applied rotation's y component
    --- @param bz the first-applied rotation's z component
    --- @param bw the first-applied rotation's w component
    --- @return the composition's x component
    --- @return the composition's y component
    --- @return the composition's z component
    --- @return the composition's w component
    mul: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number
    ): (number, number, number, number)

    --- Turns a vector by a unit rotation.
    ---
    --- Cheaper than building a matrix for a handful of vectors and dearer for many,
    --- where `basis` amortizes its nine products across every vector after the first.
    --- @param qx the rotation's x component
    --- @param qy the rotation's y component
    --- @param qz the rotation's z component
    --- @param qw the rotation's w component
    --- @param x the vector's x component
    --- @param y the vector's y component
    --- @param z the vector's z component
    --- @return the turned x component
    --- @return the turned y component
    --- @return the turned z component
    rotate: function(
        qx: number,
        qy: number,
        qz: number,
        qw: number,
        x: number,
        y: number,
        z: number
    ): (number, number, number)

    --- Builds a rotation of an angle about an axis.
    ---
    --- The axis is normalized here, so it need not arrive as a unit vector.
    --- @param x the axis's x component
    --- @param y the axis's y component
    --- @param z the axis's z component
    --- @param radians the turn about the axis, counter-clockwise looking down it
    --- @return the rotation's x component, or zero for a zero axis
    --- @return the rotation's y component, or zero for a zero axis
    --- @return the rotation's z component, or zero for a zero axis
    --- @return the rotation's w component, or one for a zero axis
    fromaxisangle: function(x: number, y: number, z: number, radians: number): (number, number, number, number)

    --- Recovers the axis and angle of a unit rotation.
    ---
    --- The angle lands in `[0, 2pi]` rather than being folded into `[0, pi]`, so `q`
    --- and `-q` answer the two opposite ways around the same rotation.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the axis's x component, or one for the identity
    --- @return the axis's y component, or zero for the identity
    --- @return the axis's z component, or zero for the identity
    --- @return the turn about the axis in radians, zero for positive identity or `2pi`
    ---     for negative identity
    toaxisangle: function(x: number, y: number, z: number, w: number): (number, number, number, number)

    --- Returns the shortest rotation carrying a direction onto another.
    ---
    --- Neither direction has to be a unit vector. Opposed directions have no shortest
    --- rotation, so one half turn across them is chosen.
    --- @param ax the starting direction's x component
    --- @param ay the starting direction's y component
    --- @param az the starting direction's z component
    --- @param bx the target direction's x component
    --- @param by the target direction's y component
    --- @param bz the target direction's z component
    --- @return the rotation's x component, or zero for a zero direction
    --- @return the rotation's y component, or zero for a zero direction
    --- @return the rotation's z component, or zero for a zero direction
    --- @return the rotation's w component, or one for a zero direction
    fromto: function(
        ax: number,
        ay: number,
        az: number,
        bx: number,
        by: number,
        bz: number
    ): (number, number, number, number)

    --- Interpolates between two unit rotations the short way around, blending
    --- components rather than the arc.
    ---
    --- Cheaper than `slerp` and not constant in angular speed. If the short route ends
    --- at `-b`, that endpoint form is kept through `t == 1` so the four components stay
    --- continuous.
    --- @param ax the starting rotation's x component
    --- @param ay the starting rotation's y component
    --- @param az the starting rotation's z component
    --- @param aw the starting rotation's w component
    --- @param bx the ending rotation's x component
    --- @param by the ending rotation's y component
    --- @param bz the ending rotation's z component
    --- @param bw the ending rotation's w component
    --- @param t the interpolation factor
    --- @return the interpolated x component
    --- @return the interpolated y component
    --- @return the interpolated z component
    --- @return the interpolated w component
    nlerp: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number,
        t: number
    ): (number, number, number, number)

    --- Interpolates between two unit rotations the short way around at a constant
    --- angular speed.
    ---
    --- Nearly parallel endpoints fall back to `nlerp`, whose answer they agree on
    --- where the arc the spherical form divides by has vanished. If the short route
    --- ends at `-b`, that endpoint form is kept through `t == 1` so the four components
    --- stay continuous.
    --- @param ax the starting rotation's x component
    --- @param ay the starting rotation's y component
    --- @param az the starting rotation's z component
    --- @param aw the starting rotation's w component
    --- @param bx the ending rotation's x component
    --- @param by the ending rotation's y component
    --- @param bz the ending rotation's z component
    --- @param bw the ending rotation's w component
    --- @param t the interpolation factor
    --- @return the interpolated x component
    --- @return the interpolated y component
    --- @return the interpolated z component
    --- @return the interpolated w component
    slerp: function(
        ax: number,
        ay: number,
        az: number,
        aw: number,
        bx: number,
        by: number,
        bz: number,
        bw: number,
        t: number
    ): (number, number, number, number)

    --- Returns a unit rotation's three-by-three matrix in column-major order.
    ---
    --- Answered rather than written, for the caller folding a rotation into something
    --- larger. `tomatrix` is the form for storage.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @return the first column's x component
    --- @return the first column's y component
    --- @return the first column's z component
    --- @return the second column's x component
    --- @return the second column's y component
    --- @return the second column's z component
    --- @return the third column's x component
    --- @return the third column's y component
    --- @return the third column's z component
    basis: function(
        x: number,
        y: number,
        z: number,
        w: number
    ): (number, number, number, number, number, number, number, number, number)

    --- Writes a unit rotation as a four-by-four column-major matrix without
    --- translation.
    ---
    --- The sixteen numbers start at `offset`, which indexes the first of them. The
    --- layout is the one a GPU expects, so an uploaded destination is written in place
    --- rather than repacked.
    --- @param x the rotation's x component
    --- @param y the rotation's y component
    --- @param z the rotation's z component
    --- @param w the rotation's w component
    --- @param out the destination the sixteen numbers are written to
    --- @param offset the index the first number is written at
    --- @return The operation returns no value.
    tomatrix: function(x: number, y: number, z: number, w: number, out: {number}, offset: integer): nil
end

--- Scalar angle helpers and two-dimensional vector operations.
--- @internal
--- Explicit wrapping signed 32-bit arithmetic and bit operations.
--- @internal
record nupp.I32MathLibrary
    wrap: @nosuspend function(value: integer): int32
    add: @nosuspend function(a: int32, b: int32): int32
    sub: @nosuspend function(a: int32, b: int32): int32
    mul: @nosuspend function(a: int32, b: int32): int32
    andbits: @nosuspend function(a: int32, b: int32): int32
    orbits: @nosuspend function(a: int32, b: int32): int32
    xorbits: @nosuspend function(a: int32, b: int32): int32
    notbits: @nosuspend function(a: int32): int32
    shiftleft: @nosuspend function(a: int32, count: integer): int32
    shiftrightarithmetic: @nosuspend function(a: int32, count: integer): int32
    rotateleft: @nosuspend function(a: int32, count: integer): int32
    rotateright: @nosuspend function(a: int32, count: integer): int32
    lessthan: @nosuspend function(a: int32, b: int32): boolean
    lessorequal: @nosuspend function(a: int32, b: int32): boolean
    fromu32: @nosuspend function(a: uint32): int32
    tou32: @nosuspend function(a: int32): uint32
end

--- Explicit wrapping unsigned 32-bit arithmetic and bit operations.
--- @internal
record nupp.U32MathLibrary
    wrap: @nosuspend function(value: integer): uint32
    add: @nosuspend function(a: uint32, b: uint32): uint32
    sub: @nosuspend function(a: uint32, b: uint32): uint32
    mul: @nosuspend function(a: uint32, b: uint32): uint32

    --- Unsigned quotient, or zero when the divisor is zero.
    div: @nosuspend function(a: uint32, b: uint32): uint32

    --- Unsigned remainder, or zero when the divisor is zero.
    mod: @nosuspend function(a: uint32, b: uint32): uint32

    andbits: @nosuspend function(a: uint32, b: uint32): uint32
    orbits: @nosuspend function(a: uint32, b: uint32): uint32
    xorbits: @nosuspend function(a: uint32, b: uint32): uint32
    notbits: @nosuspend function(a: uint32): uint32
    shiftleft: @nosuspend function(a: uint32, count: integer): uint32
    shiftrightlogical: @nosuspend function(a: uint32, count: integer): uint32
    rotateleft: @nosuspend function(a: uint32, count: integer): uint32
    rotateright: @nosuspend function(a: uint32, count: integer): uint32
    lessthan: @nosuspend function(a: uint32, b: uint32): boolean
    lessorequal: @nosuspend function(a: uint32, b: uint32): boolean
    fromi32: @nosuspend function(a: int32): uint32
    toi32: @nosuspend function(a: uint32): int32
    popcount: @nosuspend function(a: uint32): uint32
    trailingzeros: @nosuspend function(a: uint32): uint32
    leadingzeros: @nosuspend function(a: uint32): uint32
end

--- Unsigned 64-bit rotations, bit counts and prefix parity.
--- @internal
record nupp.U64MathLibrary
    andbits: @nosuspend function(a: uint64, b: uint64): uint64
    sub: @nosuspend function(a: uint64, b: uint64): uint64
    rotateleft: @nosuspend function(a: uint64, count: integer): uint64
    rotateright: @nosuspend function(a: uint64, count: integer): uint64
    popcount: @nosuspend function(a: uint64): uint32
    trailingzeros: @nosuspend function(a: uint64): uint32
    leadingzeros: @nosuspend function(a: uint64): uint32
    prefixxor: @nosuspend function(a: uint64): uint64
end

--- Explicit IEEE-754 binary32 arithmetic. Every input and output is rounded to
--- nearest, ties-to-even; NaNs use the canonical quiet payload 0x7fc00000.
--- @internal
record nupp.F32MathLibrary
    narrow: @nosuspend function(value: number): float
    round: @nosuspend function(value: number): float
    add: @nosuspend function(a: float, b: float): float
    sub: @nosuspend function(a: float, b: float): float
    mul: @nosuspend function(a: float, b: float): float
    div: @nosuspend function(a: float, b: float): float
    sqrt: @nosuspend function(value: float): float
    min: @nosuspend function(a: float, b: float): float
    max: @nosuspend function(a: float, b: float): float
    fma: @nosuspend function(a: float, b: float, c: float): float

    --- A deterministic polynomial exponential, clamped to `[-104, 88]`.
    --- The specified binary32 operation sequence is shared by CPU and GPU AOT.
    exp: @nosuspend function(value: float): float

    frombits: @nosuspend function(bits: uint32): float
    tobits: @nosuspend function(value: float): uint32

    --- Widens IEEE binary16 storage bits to binary32, canonicalizing NaN.
    fromf16bits: @nosuspend function(bits: uint32): float

    --- Rounds binary32 to IEEE binary16 storage bits, ties to even.
    tof16bits: @nosuspend function(value: float): uint32

    --- Widens the low sixteen IEEE bfloat16 storage bits to binary32.
    frombf16bits: @nosuspend function(bits: uint32): float

    --- Rounds binary32 to IEEE bfloat16 storage bits, ties to even.
    tobf16bits: @nosuspend function(value: float): uint32
end

--- Scalar, fixed-width, and vector operations on the standard `math` table.
--- Use a width-specific namespace when rounding or wrapping is part of the contract.
--- @internal
--- @namespace math
record nupp.MathLibrary
    --- Two-dimensional vector operations over `(x, y)` number pairs.
    --- @namespace
    vec2: nupp.Vec2Library

    --- Three-dimensional rotation operations over `(x, y, z, w)` number quadruples.
    --- @namespace
    quat: nupp.QuatLibrary

    --- Signed 32-bit wrapping arithmetic.
    --- @namespace
    i32: nupp.I32MathLibrary

    --- Unsigned 32-bit wrapping arithmetic.
    --- @namespace
    u32: nupp.U32MathLibrary

    --- Unsigned 64-bit bit counts and prefix parity.
    --- @namespace
    u64: nupp.U64MathLibrary

    --- IEEE-754 binary32 arithmetic with explicit rounding.
    --- @namespace
    f32: nupp.F32MathLibrary

    --- Linearly interpolates between two numbers without clamping the factor.
    --- @param from the value returned when `t` is zero
    --- @param to the value returned when `t` is one
    --- @param t the interpolation factor
    --- @return `from + (to - from) * t`
    lerp: function(from: number, to: number, t: number): number

    --- Wraps an angle to the equivalent value in `[-pi, pi)`.
    --- @param radians the angle in radians
    --- @return the wrapped angle
    wrapangle: function(radians: number): number

    --- Computes the shortest signed rotation from one angle to another.
    --- @param from the starting angle in radians
    --- @param to the target angle in radians
    --- @return the signed rotation in `[-pi, pi)`
    dtangle: function(from: number, to: number): number
end
