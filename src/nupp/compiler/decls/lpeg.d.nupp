--[[
Typed declaration for the native LPeg 1.1 module bundled by Nupp.

Each Pattern<C> carries C as a tuple describing its capture values. `{never}` is
the empty capture sequence, a tuple keeps heterogeneous positions, and an array
represents an open homogeneous sequence. Matching adds the usual next-position
result when a pattern has no captures and makes every result optional because a
match can fail.
]]

local type __LpegEmpty = {never}

@comptime
local function __LpegMatch(Captures: type): typepack
    local info = nupp.types.describe(Captures)
    if info.kind == "array" then
        if nupp.types.kind(info.element) == "never" then
            return nupp.types.pack({nupp.types.optional(nupp.types.integer)})
        end
        return nupp.types.pack({}, nupp.types.optional(info.element))
    elseif info.kind == "tuple" then
        local optional = {}
        for _, capture in ipairs(info.members) do
            optional[#optional + 1] = nupp.types.optional(capture)
        end
        return nupp.types.pack(optional)
    end

    return nupp.types.pack({}, nupp.types.any)
end

--- A composable LPeg pattern carrying the values it captures.
record Pattern<Captures>
    -- Operator result specialization is compiler-provided so applying a generic
    -- Pattern does not recursively instantiate its own algebra. These contracts keep
    -- the erased runtime protocol visible to structural consumers.
    metamethod __mul: function(left: any, right: any): Pattern<{any}>
    metamethod __add: function(left: any, right: any): Pattern<{any}>
    metamethod __sub: function(left: any, right: any): Pattern<{any}>
    metamethod __unm: function(self): Pattern<{any}>
    metamethod __len: function(self): Pattern<{any}>
    metamethod __pow: function(self, exponent: integer): Pattern<{any}>
    metamethod __div: function(self, replacement: any): Pattern<{any}>
    metamethod __mod: function(self, accumulator: function(...: any): any): Pattern<{any}>
    metamethod __tostring: function(self): string

    --- Matches at `init`, returning captures or the next byte position, and nil on
    --- failure.
    match: function(any, subject: string, init: integer?, ...: any): unpackof __LpegMatch(Captures)
end

local record Locale
    alnum: Pattern<__LpegEmpty>
    alpha: Pattern<__LpegEmpty>
    cntrl: Pattern<__LpegEmpty>
    digit: Pattern<__LpegEmpty>
    graph: Pattern<__LpegEmpty>
    lower: Pattern<__LpegEmpty>
    print: Pattern<__LpegEmpty>
    punct: Pattern<__LpegEmpty>
    space: Pattern<__LpegEmpty>
    upper: Pattern<__LpegEmpty>
    xdigit: Pattern<__LpegEmpty>
end

local record lpeg
    P: function(value: any): Pattern<{any}>

    S: function(characters: string): Pattern<__LpegEmpty>
    R: function(...: string): Pattern<__LpegEmpty>
    utfR: function(first: integer, last: integer): Pattern<__LpegEmpty>
    V: function(key: any): Pattern<{any}>
    B: function<Captures>(pattern: Pattern<Captures>): Pattern<__LpegEmpty>

    C: function<Captures>(pattern: Pattern<Captures>): Pattern<{string, unpackof Captures}>
        & function(pattern: string | number | boolean): Pattern<{string,}>
    Cp: function(): Pattern<{integer,}>
    Cc: function(): Pattern<__LpegEmpty> & function<Value>(first: Value, ...: Value): Pattern<{Value}>
    Ct: function<Captures>(pattern: Pattern<Captures>): Pattern<{Captures,}>
    Cg: function<Captures>(pattern: Pattern<Captures>): Pattern<Captures>
        & function<Captures>(pattern: Pattern<Captures>, key: any): Pattern<__LpegEmpty>
    Cb: function(key: any): Pattern<{any}>
    Cs: function<Captures>(pattern: Pattern<Captures>): Pattern<{string,}>
    Cmt: function<Captures, Result>(
        pattern: Pattern<Captures>,
        callback: function(string, integer, ...: unpackof Captures): (integer | boolean,...Result)
    ): Pattern<{Result}>
    Cf: function<Captures, Result>(pattern: Pattern<Captures>, callback: function(any, any): Result): Pattern<{Result,}>
    Carg: function(index: integer): Pattern<{any,}>

    match: function<Captures>(
        pattern: Pattern<Captures>,
        subject: string,
        init: integer?,
        ...: any
    ): unpackof __LpegMatch(Captures)
    type: function(value: any): "pattern"?
    locale: function(target: table?): Locale
    setmaxstack: function(maximum: integer): nil
    version: string
end

return lpeg
