module nupp.compiler.reflection

-- Versioned, target-independent semantic type descriptors for comptime and derive.

local hash = require("nupp.compiler.hash")
local stable = require("nupp.compiler.stable")
local members = require("nupp.compiler.types.members")
local T = require("nupp.compiler.types")

local record reflection
    SCHEMA: integer
    describe: function(any, string?, boolean?): any
end

reflection.SCHEMA = 4

local function sortedNames(values)
    local names = {}
    for name in pairs(values or {}) do
        names[#names + 1] = name
    end
    table.sort(names)

    return names
end

--- Converts the checker's interned, possibly recursive graph into plain acyclic data.
--- Every type appears once in `types`; edges are integer indices, so recursive
--- declarations survive JSON transport without exposing checker objects or identities.
--- Whether a stored field may be left out of a construction: nil fits its type.
local function admitsNil(t: any): boolean
    if t == T.nil_ or t == T.any or t == T.unknown then
        return true
    end
    if t.tag == "union" then
        for _, member in ipairs(t.members or {}) do
            if member == T.nil_ then
                return true
            end
        end
    end

    return false
end

function reflection.describe(
    root: any,
    qualifiedName: string?,
    includeSources: boolean?,
    sourcesOnly: boolean?,
    nominalReference: (function(any): boolean)?,
    typeReference: (function(any): any?)?
): any
    local indices = {}
    local types: {any} = {}
    local sources = {}

    local intern

    local reflectedCleanup

    reflectedCleanup = function(cleanup)
        return cleanup
            and {
                kind = cleanup.kind,
                key = cleanup.key,
                name = cleanup.name,
                field = cleanup.field,
                functionType = intern(cleanup.functionType),
                constTerm = intern(cleanup.constTerm),
                cleanup = reflectedCleanup(cleanup.cleanup),
            }
            or nil
    end

    local function reflectedAnnotations(applications)
        local out = {}
        for _, application in ipairs(applications or {}) do
            local reflected = {name = application.name, arguments = {}}
            for _, argument in ipairs(application.arguments or {}) do
                local encoded = {name = argument.name, kind = argument.kind}
                if argument.kind == "type" then
                    encoded.type = intern(argument.type)
                elseif argument.kind == "value" then
                    encoded.value = argument.value
                end
                reflected.arguments[#reflected.arguments + 1] = encoded
            end
            out[#out + 1] = reflected
        end

        return out
    end

    intern = function(t): integer?
        if not t then
            return nil
        end
        local prior = indices[t]
        if prior then
            return prior
        end
        local index = #types + 1
        indices[t] = index
        sources[index] = t
        local out = {kind = t.tag}
        types[index] = out
        local tag = t.tag
        local reference = typeReference and typeReference(t) or nil

        if reference ~= nil then
            out.kind = "external"
            out.arena = reference.arena
            out.node = reference.node
        elseif tag == "nominal" and nominalReference and nominalReference(t) then
            out.kind = t.declKind
            out.name = t.name
            out.declarationKey = t.declarationKey
            out.nominal = true
            out.external = true
        elseif tag == "nominal" then
            out.kind = t.declKind
            out.name = t.name
            out.declarationKey = t.declarationKey
            out.moduleName = ((t as any).origin or t as any).moduleName
            out.nominal = true
            out.deriveKey = t.deriveKey
            out.annotations = reflectedAnnotations(t.annotations)
            out.fields = {}
            local view = members.view(t)
            for _, field in ipairs(view.ordered) do
                if not (t.privateFields and t.privateFields[field.name]) then
                    local read, write = field.readType, field.writeType
                    out.fields[
                        #out.fields + 1
                    ] = {
                        name = field.name,
                        read = intern(read),
                        write = intern(write),
                        readable = read ~= nil,
                        writable = write ~= nil,
                        hasDefault = t.fieldDefaults and t.fieldDefaults[field.name] ~= nil or false,
                        defaultValue = t.fieldDefaults
                        and t.fieldDefaults[field.name]
                        and t.fieldDefaults[field.name].value,
                        annotations = reflectedAnnotations(field.annotations),
                    }
                end
            end
            out.staticFields = {}
            for _, name in ipairs(sortedNames(t.staticByname)) do
                out.staticFields[
                    #out.staticFields + 1
                ] = {name = name, read = intern(t.staticByname[name]), write = intern(t.staticWriteByname[name]),}
            end
            out.index = {
                readKey = intern(view.readIndexer and view.readIndexer.keyType),
                readValue = intern(view.readIndexer and view.readIndexer.valueType),
                writeKey = intern(view.writeIndexer and view.writeIndexer.keyType),
                writeValue = intern(view.writeIndexer and view.writeIndexer.valueType),
            }
            out.metamethods = {}
            for _, name in ipairs(sortedNames(t.metamethods)) do
                out.metamethods[#out.metamethods + 1] = {name = name, type = intern(t.metamethods[name])}
            end
            out.nestedTypes = {}
            for _, name in ipairs(sortedNames(t.nestedTypes)) do
                out.nestedTypes[#out.nestedTypes + 1] = {name = name, type = intern(t.nestedTypes[name])}
            end
            out.associatedTypes = {}
            for _, requirement in ipairs(t.associatedRequirements or {}) do
                local name = requirement.name
                local answer = t.associatedAnswers and t.associatedAnswers[name] or nil
                out.associatedTypes[
                    #out.associatedTypes + 1
                ] = {
                    name = name,
                    bound = intern(requirement.bound),
                    answer = intern(answer and answer.type),
                    default = answer ~= nil and answer.kind == "default" or false,
                }
            end
            out.hasAssociatedRequirements = t.associatedRequirements ~= nil
            out.associatedRequirements = {}
            for position, requirement in ipairs(t.associatedRequirements or {}) do
                out.associatedRequirements[
                    position
                ] = {
                    name = requirement.name,
                    bound = intern(requirement.bound),
                    selfBinder = intern(requirement.selfBinder),
                }
            end
            out.hasAssociatedAnswers = t.associatedAnswers ~= nil
            out.associatedAnswers = {}
            for _, name in ipairs(sortedNames(t.associatedAnswers)) do
                local answer = t.associatedAnswers[name]
                out.associatedAnswers[
                    #out.associatedAnswers + 1
                ] = {
                    name = name,
                    type = intern(answer.type),
                    selfBinder = intern(answer.selfBinder),
                    answerKind = answer.kind,
                }
            end
            out.supertypes = {}
            for _, supertype in ipairs(t.supertypes or {}) do
                out.supertypes[#out.supertypes + 1] = intern(supertype)
            end
            -- The construction contract: the one declared constructor's parameters,
            -- or the stored fields in declaration order when there is none. A slot
            -- is optional when the field has a default or already admits nil; a
            -- declaration with several constructors has no single contract and says
            -- so, which is what `nupp.types.construction` refuses.
            local entries = t.constructorEntries or {}
            if #entries > 1 then
                out.construction = {overloaded = true, params = {}}
            elseif #entries == 1 then
                local signature = entries[1].signature
                local names = signature.paramNames or {}
                local declared = signature.params or {}
                local params = {}
                -- The receiver is not an argument of `new`, however the signature
                -- happens to carry it: beside the parameters, or ahead of them.
                local offset = (#names == #declared + 1 and names[1] == "self") and 1 or 0
                local start = (offset == 0 and names[1] == "self") and 2 or 1
                for position = start, #declared do
                    params[
                        #params + 1
                    ] = {
                        name = names[position + offset] or "",
                        type = intern(declared[position]),
                        optional = false,
                        mode = signature.paramModes and signature.paramModes[position] or "plain",
                    }
                end
                out.construction = {declared = true, params = params}
            elseif t.declKind == "record" or t.declKind == "struct" then
                local params = {}
                for _, name in ipairs(t.fieldOrder or {}) do
                    local fieldType = t.byname and t.byname[name] or nil
                    local stored = fieldType ~= nil
                        and fieldType.tag ~= "func"
                        and fieldType.tag ~= "typeobject"
                        and not (t.nestedTypes and t.nestedTypes[name])
                        and not (t.privateFields and t.privateFields[name])
                    if stored then
                        local hasDefault = t.fieldDefaults ~= nil and t.fieldDefaults[name] ~= nil
                        params[
                            #params + 1
                        ] = {
                            name = name,
                            type = intern(fieldType),
                            optional = hasDefault or admitsNil(fieldType),
                            mode = "plain",
                        }
                    end
                end
                out.construction = {declared = false, params = params}
            end
            out.arrayOf = intern(t.arrayOf)
            out.hasTypeParameters = t.typeParams ~= nil
            out.hasTypeBounds = t.typeBounds ~= nil
            out.hasPackParameters = t.packParams ~= nil
            out.hasConstParameters = t.constParams ~= nil
            out.hasParameterKinds = t.paramKinds ~= nil
            out.typeParameters, out.typeBounds, out.packParameters, out.constParameters = {}, {}, {}, {}
            for position, parameter in ipairs(t.typeParams or {}) do
                out.typeParameters[position] = intern(parameter)
                out.typeBounds[position] = intern(t.typeBounds and t.typeBounds[position]) or 0
            end
            for position, parameter in ipairs(t.packParams or {}) do
                out.packParameters[position] = intern(parameter)
            end
            for position, parameter in ipairs(t.constParams or {}) do
                out.constParameters[position] = intern(parameter)
            end
            out.parameterKinds = t.paramKinds or {}
            out.hasTypeArguments = t.typeArgs ~= nil
            out.hasPackArguments = t.packArgs ~= nil
            out.hasConstArguments = t.constArgs ~= nil
            out.typeArguments = {}
            for _, argument in ipairs(t.typeArgs or {}) do
                out.typeArguments[#out.typeArguments + 1] = intern(argument)
            end
            out.packArguments = {}
            for _, argument in ipairs(t.packArgs or {}) do
                out.packArguments[#out.packArguments + 1] = intern(argument)
            end
            out.constArguments = {}
            for _, argument in ipairs(t.constArgs or {}) do
                out.constArguments[#out.constArguments + 1] = intern(argument)
            end
            out.origin = intern(t.origin)
            out.selfType = intern(t.selfType)
            out.predicate = t.predicate
            out.hasParamDefaults = t.paramDefaults ~= nil
            out.paramDefaults = {}
            for position, value in ipairs(t.paramDefaults or {}) do
                if type(value) == "table" and value.tag == "pack" then
                    out.paramDefaults[position] = {kind = "typepack", value = intern(value)}
                elseif type(value) == "table"
                    and (value.tag == "constLiteral" or value.tag == "constVar" or value.tag == "constOp")
                then
                    out.paramDefaults[position] = {kind = "const", value = intern(value)}
                elseif type(value) == "table" and value.tag then
                    out.paramDefaults[position] = {kind = "type", value = intern(value)}
                end
            end
            out.hasInheritedDefaults = t.inheritedDefaults ~= nil
            out.inheritedDefaults = {}
            for _, name in ipairs(sortedNames(t.inheritedDefaults)) do
                out.inheritedDefaults[
                    #out.inheritedDefaults + 1
                ] = {name = name, owner = intern(t.inheritedDefaults[name])}
            end
            out.hasDefaults = t.defaults ~= nil
            out.hasPrivateFields = t.privateFields ~= nil
            out.hasFieldDefaults = t.fieldDefaults ~= nil
            out.hasFieldBorrowSources = t.fieldBorrowSources ~= nil
            out.hasBorrowedRootFields = t.borrowedRootFields ~= nil
            out.hasAffineFields = t.affineFields ~= nil
            out.defaults = t.defaults or {}
            out.privateFields = t.privateFields or {}
            out.fieldBorrowSources = t.fieldBorrowSources or {}
            out.borrowedRootFields = t.borrowedRootFields or {}
            out.affineFields = t.affineFields or {}
            out.inherentCleanup = reflectedCleanup(t.inherentCleanup)
            out.sealedModule = t.sealedModule
            out.terminalMethod = t.terminalMethod
            out.intrinsicAffine = t.intrinsicAffine == true
            out.intrinsicAffineClaim = t.intrinsicAffineClaim == true
            out.managedCell = t.managedCell == true
            out.managedAlias = t.managedAlias == true
            out.lpegPattern = t.lpegPattern == true
            out.lpegLibrary = t.lpegLibrary == true
            out.lpegPatternOrigin = intern(t.lpegPatternOrigin)
            out.runtimePath = t.runtimePath
            out.cdefName = t.cdefName
            out.cdefKind = t.cdefKind
            out.cdefIdentity = t.cdefIdentity
            out.constructors = {}
            for position, constructor in ipairs(t.constructors or {}) do
                out.constructors[position] = intern(constructor)
            end
            out.constructorResults = {}
            for position, entry in ipairs(t.constructorEntries or {}) do
                out.constructorResults[
                    position
                ] = {
                    result = intern(entry.result),
                    index = entry.index,
                    escapesSelf = entry.escapesSelf == true,
                    movesOwner = entry.movesOwner == true,
                }
            end
        elseif tag == "shape" then
            out.fresh = t.fresh == true
            out.closed = t.closed == true
            out.fields = {}
            local view = members.view(t)
            for _, field in ipairs(view.ordered) do
                out.fields[
                    #out.fields + 1
                ] = {
                    name = field.name,
                    read = intern(field.readType),
                    write = intern(field.writeType),
                    readable = field.readType ~= nil,
                    writable = field.writeType ~= nil,
                }
            end
            out.index = {
                readKey = intern(view.readIndexer and view.readIndexer.keyType),
                readValue = intern(view.readIndexer and view.readIndexer.valueType),
                writeKey = intern(view.writeIndexer and view.writeIndexer.keyType),
                writeValue = intern(view.writeIndexer and view.writeIndexer.valueType),
            }
        elseif tag == "func" then
            out.parameters, out.returns = {}, {}
            for position, parameter in ipairs(t.params or {}) do
                out.parameters[
                    position
                ] = {
                    name = t.paramNames and t.paramNames[position] or "",
                    mode = t.paramModes and t.paramModes[position] or "plain",
                    type = intern(parameter),
                }
            end
            for position, returned in ipairs(t.rets or {}) do
                out.returns[position] = intern(returned)
            end
            out.vararg = t.vararg or false
            out.varargType = intern(t.varargType)
            out.noReturn = t.noreturn or false
            out.noYield = t.noYield or false
            out.sendable = t.sendable or false
            out.comptimeOnly = t.comptimeOnly or false
            out.foreign = t.foreign or false
            out.borrowsSelf = t.borrowsSelf or false
            out.borrowedFrom = t.borrowsParam
            out.hasBorrowedFromMany = t.borrowsParams ~= nil
            out.borrowedFromMany = t.borrowsParams or {}
            out.borrowedResult = t.borrowsResult or 1
            out.hasPreservesResults = t.preservesResults ~= nil
            out.hasExplicitPreserves = t.explicitPreserves ~= nil
            out.hasPartitionResults = t.partitionResults ~= nil
            out.preservesResults = t.preservesResults or {}
            out.explicitPreserves = t.explicitPreserves or {}
            out.preservesPaths = t.preservesPaths or {}
            out.partitionResults = t.partitionResults or {}
            if t.predicate then
                out.predicate = {param = t.predicate.param, type = intern(t.predicate.type)}
            end
            out.hasTypeParameters = t.typeParams ~= nil
            out.hasTypeBounds = t.typeBounds ~= nil
            out.hasPackParameters = t.packParams ~= nil
            out.hasConstParameters = t.constParams ~= nil
            out.hasParameterKinds = t.paramKinds ~= nil
            out.typeParameters, out.typeBounds, out.packParameters = {}, {}, {}
            for position, parameter in ipairs(t.typeParams or {}) do
                out.typeParameters[position] = intern(parameter)
                out.typeBounds[position] = intern(t.typeBounds and t.typeBounds[position]) or 0
            end
            for position, parameter in ipairs(t.packParams or {}) do
                out.packParameters[position] = intern(parameter)
            end
            out.constParameters = {}
            for position, parameter in ipairs(t.constParams or {}) do
                out.constParameters[position] = intern(parameter)
            end
            out.parameterKinds = t.paramKinds or {}
            out.parameterPack = intern(t.paramPack)
            out.returnPack = intern(t.retPack)
            out.yieldPack = intern(t.yieldPack)
            out.resumePack = intern(t.resumePack)
            out.ffiOut = {}
            for position, output in ipairs(t.ffiOut or {}) do
                local cleanups = {}
                for cleanupPosition, cleanup in ipairs(output.cleanups or {}) do
                    cleanups[cleanupPosition] = reflectedCleanup(cleanup)
                end
                out.ffiOut[
                    position
                ] = {
                    kind = output.kind,
                    name = output.name,
                    cleanups = cleanups,
                    transferOnly = output.transferOnly == true,
                    valueType = intern(output.valueType),
                    cIndex = output.cIndex,
                    hasStatus = output.hasStatus == true,
                    success = output.success,
                    sourceParams = output.sourceParams or {},
                    returnIndex = output.returnIndex,
                }
            end
        elseif tag == "map" then
            out.readKey = t.readable and intern(t.key) or nil
            out.readValue = t.readable and intern(t.value) or nil
            out.writeKey = intern(t.writeKey)
            out.writeValue = intern(t.writeValue)
        elseif tag == "tuple" then
            out.members = {}
            for position, member in ipairs(t.elems or {}) do
                out.members[position] = intern(member)
            end
        elseif tag == "union" or tag == "intersection" then
            out.members = {}
            for position, member in ipairs(t.members or {}) do
                out.members[position] = intern(member)
            end
        elseif tag == "pack" then
            out.head = {}
            for position, member in ipairs(t.head or {}) do
                out.head[
                    position
                ] = {
                    type = intern(member),
                    mode = t.modes and t.modes[position] or "plain",
                    name = t.names and t.names[position] or "",
                }
            end
            local tail = t.tail
            out.tail = tail
                and {kind = tail.kind, type = intern(tail.type), variable = intern(tail.var), mode = tail.mode,}
                or nil
            out.alternatives = {}
            for position, alternative in ipairs(t.alternatives or {}) do
                out.alternatives[position] = intern(alternative)
            end
        elseif tag == "protocolThread" then
            out.startPack = intern(t.startPack)
            out.resumePack = intern(t.resumePack)
            out.yieldPack = intern(t.yieldPack)
            out.returnPack = intern(t.returnPack)
        elseif tag == "genericAlias" then
            out.name = t.name
            out.body = intern(t.body)
            out.typeParameters, out.typeBounds, out.packParameters, out.constParameters = {}, {}, {}, {}
            for position, parameter in ipairs(t.typeParams or {}) do
                out.typeParameters[position] = intern(parameter)
                out.typeBounds[position] = intern(t.typeBounds and t.typeBounds[position]) or 0
            end
            for position, parameter in ipairs(t.packParams or {}) do
                out.packParameters[position] = intern(parameter)
            end
            for position, parameter in ipairs(t.constParams or {}) do
                out.constParameters[position] = intern(parameter)
            end
            out.parameterKinds = t.paramKinds or {}
            out.parameterDefaults = {}
            for position, value in ipairs(t.paramDefaults or {}) do
                if type(value) == "table" and value.tag == "pack" then
                    out.parameterDefaults[position] = {kind = "typepack", value = intern(value)}
                elseif type(value) == "table"
                    and (value.tag == "constLiteral" or value.tag == "constVar" or value.tag == "constOp")
                then
                    out.parameterDefaults[position] = {kind = "const", value = intern(value)}
                elseif type(value) == "table" and value.tag then
                    out.parameterDefaults[position] = {kind = "type", value = intern(value)}
                end
            end
        elseif tag == "neutral" then
            out.operation = t.op
            if t.op == "comptimeCall" then
                out.identity = t.comptimeIdentity
                local program = t.comptimeHelper
                out.program = program
                    and {
                        sealedTypeFunction = program.sealedTypeFunction == true,
                        identity = program.identity,
                        main = program.main,
                        serializedHelpers = program.serializedHelpers,
                    }
                    or nil
                out.arguments = {}
                for position, argument in ipairs(t.comptimeArguments or {}) do
                    if argument.kind == "type" then
                        out.arguments[position] = {kind = "type", type = intern(argument.value)}
                    elseif argument.kind == "typepack" then
                        out.arguments[position] = {kind = "typepack", pack = intern(argument.value)}
                    else
                        out.arguments[position] = {kind = "const", term = intern(argument.value),}
                    end
                end
                out.bound = intern(t.comptimeBound)
                out.resultKind = t.comptimeResultPack and "typepack" or "type"
            else
                out.subject = intern(t.subject)
                out.key = intern(t.key)
                out.capability = t.capability
                out.binder = intern(t.binder)
                out.keys = intern(t.keys)
                out.value = intern(t.value)
                out.remap = intern(t.remap)
                out.constTerm = intern(t.constTerm)
                out.templateParts = {}
                for position, part in ipairs(t.templateParts or {}) do
                    out.templateParts[position] = type(part) == "string" and {literal = part} or {type = intern(part)}
                end
            end
        elseif tag == "literal" then
            out.value = t.constant
            out.base = intern(t.base)
        elseif tag == "typevar" then
            out.name = t.name
            out.identity = t.identity
            out.bound = intern(t.bound)
            out.default = intern(t.default)
        elseif tag == "typeHandle" then
            out.bound = intern(t.bound)
        elseif tag == "packResult" then
            out.pack = intern(t.pack)
        elseif tag == "packvar" then
            out.name = t.name
            out.identity = t.identity
        elseif tag == "constLiteral" then
            out.domain = t.domain
            out.value = t.value
        elseif tag == "constVar" then
            out.name = t.name
            out.domain = t.domain
            out.identity = t.identity
        elseif tag == "constOp" then
            out.operation = t.operation
            out.operands = {}
            for position, operand in ipairs(t.operands or {}) do
                out.operands[position] = intern(operand)
            end
        elseif tag == "projection" then
            out.of = intern(t.of)
            out.name = t.name
        elseif tag == "array"
            or tag == "ptr"
            or tag == "affine"
            or tag == "borrowed"
            or tag == "pinned"
            or tag == "const"
        then
            out.element = intern(t.elem or t.inner)
            if tag == "array" then
                out.fresh = t.fresh == true
                out.elements = {}
                for position, element in ipairs(t.elems or {}) do
                    out.elements[position] = intern(element)
                end
            elseif tag == "affine" then
                out.transferOnly = t.transferOnly == true
                out.cleanups = {}
                for position, cleanup in ipairs(t.cleanups or {}) do
                    out.cleanups[position] = reflectedCleanup(cleanup)
                end
            end
        elseif tag == "carray" then
            out.element = intern(t.elem)
            out.count = t.count
            out.countTerm = intern(t.countTerm)
        elseif tag == "ctype" or tag == "metatable" or tag == "typeobject" then
            out.of = intern(t.of)
        elseif tag == "constrained" then
            out.base = intern(t.base)
            out.predicate = t.predicate
            out.constraintKey = t.constraintKey
            out.label = t.label
        end

        return index
    end

    local rootIndex = intern(root)
    local descriptor = {schema = reflection.SCHEMA, root = rootIndex, types = types, qualifiedName = qualifiedName,}
    local rootType = types[rootIndex or 0] or {}
    descriptor.kind = rootType.kind
    descriptor.name = rootType.name or qualifiedName
    descriptor.annotations = rootType.annotations or {}
    descriptor.fields = {}
    for _, field in ipairs(rootType.fields or {}) do
        local fieldType = types[field.read or field.write or 0] or {}
        descriptor.fields[
            #descriptor.fields + 1
        ] = {
            name = field.name,
            kind = fieldType.kind,
            typeName = fieldType.name,
            type = field.read or field.write,
            readable = field.readable,
            writable = field.writable,
            hasDefault = field.hasDefault or false,
            defaultValue = field.defaultValue,
            annotations = field.annotations or {},
        }
    end
    descriptor.soa = {schema = 1, eligible = false, reason = nil as string?, fields = {}}
    if root and root.tag == "nominal" and root.declKind == "struct" then
        descriptor.soa.eligible = #(root.fieldOrder or {}) > 0
        if not descriptor.soa.eligible then
            descriptor.soa.reason = "the struct declares no stored fields"
        end
        local reflectedByName = {}
        for _, field in ipairs(rootType.fields or {}) do
            reflectedByName[field.name] = field
        end
        for ordinal, name in ipairs(root.fieldOrder or {}) do
            local fieldType = root.byname and root.byname[name] or nil
            local definition = root.fieldDefs and root.fieldDefs[name] or nil
            local ctype = fieldType and T.cName(fieldType) or nil
            local eligible = ctype ~= nil and not (definition and definition.bitWidth)
            if not eligible and descriptor.soa.eligible then
                descriptor.soa.eligible = false
                descriptor.soa.reason = definition and definition.bitWidth and ("field %q is a bitfield"):format(name)
                    or ("field %q has no fixed C storage type"):format(name)
            end
            local reflected = reflectedByName[name] or {}
            descriptor.soa.fields[
                #descriptor.soa.fields + 1
            ] = {
                name = name,
                ordinal = ordinal,
                type = reflected.read or reflected.write,
                ctype = ctype,
                eligible = eligible,
                identity = (qualifiedName or root.name) .. "." .. name,
            }
        end
    elseif root and root.tag == "nominal" then
        descriptor.soa.reason = ("%s is not a struct"):format(root.declKind)
    else
        descriptor.soa.reason = "the reflected type is not a nominal struct"
    end
    if not sourcesOnly then
        descriptor.fingerprint = hash.sha256(
            "nupp.reflect\0v" .. tostring(reflection.SCHEMA) .. "\0" .. stable(descriptor)
        )
    end
    if includeSources or sourcesOnly then
        -- The side table is parent-only and deliberately added after fingerprinting.
        -- Worker transport receives the plain semantic graph, while the parent keeps
        -- the exact permitted nominal identities each graph node came from.
        descriptor.sources = sources
    end
    if includeSources then
        for index, node in ipairs(types) do
            if node.nominal then
                node.referenceFingerprint = reflection.describe(sources[index]).fingerprint
                local declaration = sources[index]
                while declaration and declaration.tag == "nominal" and declaration.origin do
                    declaration = declaration.origin
                end
                -- This token crosses only the sealed type-function boundary and is
                -- never part of the public descriptor or its stable fingerprint. It
                -- lets comptime ask whether two applications came from the same
                -- declaration without learning or forging the declaration itself.
                node.nominalIdentity = declaration and declaration.id or nil
            end
        end
    end

    return descriptor
end

export = reflection
