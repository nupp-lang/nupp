module nupp.compiler.project.store

--[[
A keyed blob of results that survives between commands.

Every command starts a fresh process, and most of what the last one worked out
is still true. This is where that work is left: one file per kind of entry,
keyed by a digest of everything the entry was computed from, so a key that
matches is an answer that is still correct rather than one that is probably
still correct.

Nothing here is executable. `string.buffer` serializes plain data and the
decoder produces plain data. A file that cannot be decoded or whose format or
stamp differs is a cache miss. That is what lets the store sit in the project's
own build directory instead of a user-private one -- a store of code could not.

What it will not do is answer a question it was not asked exactly. There is no
partial matching, no "close enough", and no version migration: a stamp that
does not match discards the file. Recomputing is always available and always
correct, so every failure here has the same answer.

Decoding is not the same as being intact. Most single flipped bytes in an
encoded file still decode, into a table with a renamed field or a changed
message, and a hit is never rewritten -- so one damaged byte was a diagnostic
misquoted on every run, or a check that crashed on every run, until somebody
deleted the file by hand. The body is sealed with a digest of itself, and a
body that does not match its seal is a miss like any other.
]]

local loaded, nativeBuffer = pcall(require, "string.buffer")

local function unavailable(): never
    error("binary cache serialization is unavailable on this host")
end

local buffer = loaded and nativeBuffer or {encode = unavailable, decode = unavailable}
local fs = require("nupp.compiler.fs")

local store = {}

-- Bumped when an entry's shape changes and old entries would decode into something the
-- reader no longer understands.
local FORMAT = 3

--- How many stamps one file holds bodies for, newest first.
---
--- One was the obvious number and the wrong one. Two compilers used on one project --
--- `bin/nupp` and the binary it builds, whose stamps differ because one is a tree
--- of modules and the other a bundle -- each found the other's stamp, discarded the
--- file and wrote its own, so alternating them redid the whole project every time.
--- Two covers that; the file costs a second body on disk, and a reader decodes only
--- the envelope of a body that is not its own.
local KEEP_STAMPS = 2

--- The digest a body is sealed with, or nil where the host has no native one.
---
--- Native only. The portable digest is byte for byte the same answer but costs most of
--- a second over a prelude image, which is far more than the store saves; a host
--- without the native one writes no seal and reads without checking, which is what the
--- store did before it had seals. Named indirectly for the same reason
--- `fingerprint.contentDigest` is: a portable bundle should not carry host services
--- in for a branch it never takes.
local sealMemo: any = nil

local function sealDigest(): any
    if sealMemo == nil then
        local ok, services = pcall(require, "nupp.compiler." .. "hostservices")
        local digest = ok and services and services.hash and services.hash.digest or nil
        -- A host whose library is missing fails on the first call, not on require.
        sealMemo = digest and pcall(digest, "") and digest or false
    end

    return sealMemo or nil
end

--- The slots a cache file holds, newest first, or an empty list when it holds none
--- this reader understands.
local function slotsIn(path: string): {any}
    local text = fs.readFile(path)
    if not text then
        return {}
    end
    -- A cache file is data somebody else wrote. Everything from here is guarded, and
    -- every way it can go wrong lands on the same answer: nothing, recompute,
    -- overwrite.
    local ok, envelope = pcall(buffer.decode, text)
    if not ok or type(envelope) ~= "table" or envelope.format ~= FORMAT or type(envelope.slots) ~= "table" then
        return {}
    end
    local slots: {any} = {}
    for _, slot in ipairs(envelope.slots) do
        if type(slot) == "table" and type(slot.stamp) == "string" and type(slot.body) == "string" then
            slots[#slots + 1] = slot
        end
    end

    return slots
end

--- Encodes `body`, seals it under `stamp`, and writes it to `path` ahead of the
--- bodies other stamps left there. Nothing is written when it cannot be encoded.
---
--- The file is read again here rather than remembered from when the store was
--- opened, so a body another compiler wrote in between is kept rather than lost.
local function writeSealed(path: string, stamp: string, body: any): nil
    local ok, inner = pcall(buffer.encode, body)
    if not ok then
        return
    end
    local digest = sealDigest()
    local slots: {any} = {{stamp = stamp, seal = digest and digest(inner) or nil, body = inner}}
    for _, slot in ipairs(slotsIn(path)) do
        if #slots >= KEEP_STAMPS then
            break
        end
        if slot.stamp ~= stamp then
            slots[#slots + 1] = slot
        end
    end
    local encoded, text = pcall(buffer.encode, {format = FORMAT, slots = slots})
    -- A store that cannot be encoded or written is a store that misses next time,
    -- which is what happens when there is no store at all.
    if encoded then
        pcall(fs.writeFile, path, text)
    end
end

--- The body `path` holds under `stamp` when it is intact, else nil.
---
--- The stamp is compared before the body is digested, so a body some other compiler
--- wrote costs a decode of its envelope and nothing more.
local function unseal(path: string, stamp: string): any
    for _, slot in ipairs(slotsIn(path)) do
        if slot.stamp == stamp then
            local digest = sealDigest()
            if digest and slot.seal ~= digest(slot.body) then
                return nil
            end
            local decodedOk, body = pcall(buffer.decode, slot.body)

            return decodedOk and body or nil
        end
    end

    return nil
end

--- Keeps this many entries beyond the ones the current run touched.
---
--- The cost of an unused entry is bytes on disk and microseconds of decode; the benefit
--- is that moving between two branches, or undoing an edit, still hits. Zero would make
--- the store exactly the current tree and nothing else, which is the shape that misses
--- every time somebody switches back.
local KEEP_COLD = 2048

--- A kind of entry, and the file it lives in.
record store.Store
    --- Where the file is. Nil when the store could not be opened, which is not an
    --- error: every method still works and every lookup misses.
    path: string?

    --- What the entries were computed by. An entry outlives the run that wrote it but
    --- not a compiler that would compute it differently.
    stamp: string

    --- The answer for `key`, or nil. A hit is also a promise to keep the entry when the
    --- store is saved.
    get: function(key: string): any

    --- Records the answer for `key`.
    put: function(key: string, value: any)

    --- Writes the file, if anything changed. Cheap and safe to call when nothing did.
    save: function()

    --- How many entries were asked for, hit, and written. For tests, which otherwise
    --- can only observe that something got faster.
    stats: {[string]: integer}
end

--- Opens the store at `path`, or an always-missing one when it cannot be read.
---
--- `stamp` identifies everything outside the key that the entries depend on -- the
--- compiler and the project's configuration. A file stamped differently is discarded
--- rather than merged, because there is no way to tell which of its entries the
--- difference would have changed.
---
--- @param path the file to keep entries in
--- @param stamp what the entries were computed by
function store.open(path: string?, stamp: string): store.Store
    local entries: {[string]: any} = {}
    local order: {string} = {}
    local live: {[string]: boolean} = {}
    local dirty = false
    local stats: {[string]: integer} = {gets = 0, hits = 0, puts = 0}

    if path then
        local decoded = unseal(path, stamp)
        if type(decoded) == "table" and type(decoded.order) == "table" and type(decoded.entries) == "table" then
            entries = decoded.entries
            for _, key in ipairs(decoded.order) do
                if entries[key] ~= nil then
                    order[#order + 1] = key
                end
            end
        end
    end

    local function get(key: string): any
        stats.gets = (stats.gets or 0) + 1
        local value = entries[key]
        if value == nil then
            return nil
        end
        stats.hits = (stats.hits or 0) + 1
        live[key] = true

        return value
    end

    local function put(key: string, value: any)
        stats.puts = (stats.puts or 0) + 1
        if entries[key] == nil then
            order[#order + 1] = key
        end
        entries[key] = value
        live[key] = true
        dirty = true
    end

    local function save()
        if not path or not dirty then
            return
        end
        -- Live entries first and in the order they were reached, so the next run's file
        -- is the shape of this run's project. What is left fills the remainder newest
        -- first, which is what makes going back to a branch cheap without letting the
        -- file grow forever.
        local keptOrder: {string} = {}
        local keptEntries: {[string]: any} = {}
        for _, key in ipairs(order) do
            if live[key] then
                keptOrder[#keptOrder + 1] = key
                keptEntries[key] = entries[key]
            end
        end
        local cold = 0
        for index = #order, 1, -1 do
            local key = order[index]
            if not live[key] and cold < KEEP_COLD then
                cold = cold + 1
                keptOrder[#keptOrder + 1] = key
                keptEntries[key] = entries[key]
            end
        end
        writeSealed(path as string, stamp, {order = keptOrder, entries = keptEntries})
        dirty = false
    end

    return new store.Store(path = path, stamp = stamp, stats = stats, get = get, put = put, save = save)
end

--- A value, kept in a file, under the same guards as a keyed store.
---
--- For state that is looked up by name rather than by content: the check results are
--- keyed by module name, because comparing this run's interface against the last run's
--- is the whole point and a content key would have thrown the last run's away.
record store.Value
    --- What is in the file, or nil when there is nothing valid in it.
    value: any

    --- Records a new value, to be written by `save`.
    set: function(value: any)

    --- Writes the file if `set` was called.
    save: function()
end

--- Opens the single-value store at `path`, or an empty one.
function store.openValue(path: string?, stamp: string): store.Value
    local self: store.Value?
    local initial: any
    local dirty = false
    if path then
        local decoded = unseal(path, stamp)
        if type(decoded) == "table" then
            initial = decoded.value
        end
    end

    local function set(value: any)
        assert(self).value = value
        dirty = true
    end

    local function save()
        if not path or not dirty then
            return
        end
        writeSealed(path as string, stamp, {value = assert(self).value})
        dirty = false
    end

    self = new store.Value(value = initial, set = set, save = save)

    return self
end

export = store
