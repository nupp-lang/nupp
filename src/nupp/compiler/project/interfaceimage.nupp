@!internal

module nupp.compiler.project.interfaceimage

--[[
Versioned module interfaces for semantic workers.

An image contains stable declaration and binder slots plus an acyclic semantic type
descriptor. Loading never adopts a producer's type ids. It allocates nominal and
binder placeholders first, rebuilds every structural node through `types`, and only
then patches declaration surfaces. The receiving checker therefore interns an
imported structural type exactly as it would have built that type itself.
]]

local digest = require("nupp.compiler.project.fingerprint").contentDigest(true)
local reflection = require("nupp.compiler.reflection")
local stable = require("nupp.compiler.stable")
local T = require("nupp.compiler.types")

local interfaceimage = {}

interfaceimage.SCHEMA = 2

local PRIMITIVES: {
    [string]: any
} = {
    any = T.any,
    unknown = T.unknown,
    never = T.never,
    open = T.open,
    ["nil"] = T.nil_,
    boolean = T.boolean,
    string = T.string,
    number = T.number,
    integer = T.integer,
    ["table"] = T.table_,
    thread = T.thread,
    userdata = T.userdata,
    float = T.float,
    cdata = T.cdata,
    cstring = T.cstring,
    voidptr = T.voidptr,
    int8 = T.int8,
    int16 = T.int16,
    int32 = T.int32,
    int64 = T.int64,
    uint8 = T.uint8,
    uint16 = T.uint16,
    uint32 = T.uint32,
    uint64 = T.uint64,
    type = T.type_,
    typepack = T.typepack,
    functionconst = T.functionConst,
}

local function sortedNames(values: any): {string}
    local names: {string} = {}
    for name in pairs(values or {}) do
        names[#names + 1] = name
    end
    table.sort(names)

    return names
end

local function copyToken(token: any): any?
    if type(token) ~= "table" then
        return nil
    end

    return {
        kind = token.kind,
        text = token.text,
        offset = token.offset,
        line = token.line,
        col = token.col,
        missing = token.missing == true or nil,
    }
end

local function copyDefinition(definition: any): any?
    if type(definition) ~= "table" then
        return nil
    end
    local copied = {
        filename = definition.filename,
        name = definition.name,
        kind = definition.kind,
        token = copyToken(definition.token),
        deprecated = definition.deprecated,
        comptimeOnly = definition.comptimeOnly,
        moduleName = definition.moduleName,
        namespacePath = definition.namespacePath,
        scalarIntrinsic = definition.scalarIntrinsic,
        associated = definition.associated,
        cdefIdentity = definition.cdefIdentity,
    }
    local exact = definition.exactCallExport
    if type(exact) == "table" then
        copied.exactCallExport = {module = exact.module, member = exact.member, identity = exact.identity,}
    end

    return copied
end

local function copyDefinitions(values: any): {any}
    local copied: {any} = {}
    for _, name in ipairs(sortedNames(values)) do
        copied[#copied + 1] = {name = name, definition = copyDefinition(values[name]),}
    end

    return copied
end

local function restoreDefinitions(values: any): {[string]: any}
    local restored: {[string]: any} = {}
    for _, entry in ipairs(values or {}) do
        restored[entry.name] = entry.definition
    end

    return restored
end

--- Encodes a set of completed module semantics as one shared type arena.
function interfaceimage.encode(
    semantics: {[string]: any},
    origins: {[any]: any}?,
    arenas: {[string]: {any}}?
): (any?, string?)
    local roots: {any} = {}
    local entries: {any} = {}
    local ownedPaths: {[string]: boolean} = {}
    local projectPaths: {[string]: boolean} = {}

    local function addRoot(t: any): integer
        roots[#roots + 1] = t

        return #roots
    end

    for _, moduleName in ipairs(sortedNames(semantics)) do
        local semantic = semantics[moduleName]
        local exports = semantic.exports or {}
        if semantic.path then
            ownedPaths[semantic.path] = true
        end
        for _, path in ipairs(semantic.projectPaths or {}) do
            projectPaths[path] = true
        end
        local entry = {
            name = moduleName,
            interface = addRoot(semantic.interface and semantic.interface.type or T.unknown),
            types = {},
            values = {},
            typeDefs = copyDefinitions(exports.typeDefs),
            valueDefs = copyDefinitions(exports.valueDefs),
            nominalEffectFingerprint = exports.nominalEffectFingerprint,
            deriveInterfaceFingerprint = exports.deriveInterfaceFingerprint,
            comptimeFunctionFingerprint = exports.comptimeFunctionFingerprint,
            callGuarantees = exports.callGuarantees,
            comptimeFunctions = {},
            diags = semantic.diags or {},
            source = semantic.source,
        }
        for _, name in ipairs(sortedNames(exports.types)) do
            entry.types[#entry.types + 1] = {name = name, root = addRoot(exports.types[name]),}
        end
        for _, name in ipairs(sortedNames(exports.values)) do
            entry.values[#entry.values + 1] = {name = name, root = addRoot(exports.values[name]),}
        end
        for _, name in ipairs(sortedNames(exports.comptimeFunctions)) do
            local program = exports.comptimeFunctions[name]
            entry.comptimeFunctions[
                #entry.comptimeFunctions + 1
            ] = {
                name = name,
                sealedTypeFunction = program.sealedTypeFunction == true,
                identity = program.identity,
                main = program.main,
                serializedHelpers = program.serializedHelpers,
                signature = program.signature and addRoot(program.signature) or nil,
                definition = copyDefinition(program.definition),
                bodyFingerprint = program.bodyFingerprint,
                deriveProvider = program.deriveProvider == true,
                deriveInterface = program.deriveInterface and addRoot(program.deriveInterface) or nil,
                providerModule = program.providerModule,
                providerModuleLocal = program.providerModuleLocal,
                runtimeHelpers = program.runtimeHelpers,
            }
        end
        entries[#entries + 1] = entry
    end

    local function externalNominal(source: any): boolean
        if source.tag ~= "nominal" or source.origin ~= nil or source.declarationKey == nil then
            return false
        end
        local separator = source.declarationKey:find("\0", 1, true)
        local declarationPath = separator and source.declarationKey:sub(1, separator - 1) or nil
        local indexedDeclaration = source.declarationKey:find("\0module\0", 1, true) ~= nil
            or source.declarationKey:find("\0global\0", 1, true) ~= nil
        if declarationPath == nil or not indexedDeclaration or not projectPaths[declarationPath] then
            return false
        end
        for path in pairs(ownedPaths) do
            if source.declarationKey:sub(1, #path + 1) == path .. "\0" then
                return false
            end
        end

        return true
    end

    local rootTuple = T.tuple(roots)
    local descriptor = reflection.describe(rootTuple, "<module-interfaces>", false, true, externalNominal, function(
        source: any
    ): any?
        return source ~= rootTuple and origins and origins[source] or nil
    end)
    local sourceIndices: {[any]: integer} = {}
    for index, source in ipairs(descriptor.sources or {}) do
        sourceIndices[source] = index
    end

    local function encodeMethodEntry(entry: any): any
        local signature = sourceIndices[entry.signature]
        if signature == nil then
            error("module interface omitted an overload signature", 0)
        end

        return {
            signature = signature,
            member = entry.member,
            parameterKey = entry.parameterKey,
            definition = copyDefinition(entry.definition),
        }
    end

    local function encodeMethodGroups(groups: any): {any}
        local encoded: {any} = {}
        for _, name in ipairs(sortedNames(groups)) do
            local entries: {any} = {}
            for _, entry in ipairs(groups[name] or {}) do
                entries[#entries + 1] = encodeMethodEntry(entry)
            end
            encoded[#encoded + 1] = {name = name, entries = entries,}
        end

        return encoded
    end

    local function encodeDefaults(defaults: any): {any}
        local encoded: {any} = {}
        for _, slot in ipairs(sortedNames(defaults)) do
            local entry = defaults[slot]
            encoded[
                #encoded + 1
            ] = {
                slot = slot,
                name = entry.name,
                member = entry.member,
                runtimeSlot = entry.slot,
                entry = entry.entry and encodeMethodEntry(entry.entry) or nil,
            }
        end

        return encoded
    end

    for index, source in ipairs(descriptor.sources or {}) do
        local node = descriptor.types[index]
        if source.tag == "nominal" and node and not node.external and node.kind ~= "external" then
            node.fieldDefinitions = copyDefinitions(source.fieldDefs)
            node.writeFieldDefinitions = copyDefinitions(source.writeFieldDefs)
            node.staticFieldDefinitions = copyDefinitions(source.staticFieldDefs)
            node.staticWriteFieldDefinitions = copyDefinitions(source.staticWriteFieldDefs)
            node.methodEntries = encodeMethodGroups(source.methodEntries)
            node.methodDispatchEntries = encodeMethodGroups(source.methodDispatchEntries)
            node.staticEntries = encodeMethodGroups(source.staticEntries)
            node.overloadedMethods = sortedNames(source.overloadedMethods)
            node.overloadedStatics = sortedNames(source.overloadedStatics)
            node.defaultEntries = encodeDefaults(source.defaultEntries)
            node.associatedRequirementDefinitions = {}
            for position, requirement in ipairs(source.associatedRequirements or {}) do
                node.associatedRequirementDefinitions[position] = copyDefinition(requirement.definition)
            end
            node.associatedAnswerDefinitions = {}
            for _, name in ipairs(sortedNames(source.associatedAnswers)) do
                node.associatedAnswerDefinitions[
                    #node.associatedAnswerDefinitions + 1
                ] = {name = name, definition = copyDefinition(source.associatedAnswers[name].definition),}
            end
        end
    end
    local descriptorSources = descriptor.sources or {}
    descriptor.sources = nil
    local tuple = descriptor.types[descriptor.root]
    if type(tuple) ~= "table" or tuple.kind ~= "tuple" or type(tuple.members) ~= "table" then
        return nil, "module interface root is not a tuple"
    end
    for _, entry in ipairs(entries) do
        entry.interface = tuple.members[entry.interface]
        for _, exported in ipairs(entry.types) do
            exported.root = tuple.members[exported.root]
        end
        for _, exported in ipairs(entry.values) do
            exported.root = tuple.members[exported.root]
        end
        for _, program in ipairs(entry.comptimeFunctions) do
            program.signature = program.signature and tuple.members[program.signature] or nil
            program.deriveInterface = program.deriveInterface and tuple.members[program.deriveInterface] or nil
        end
    end
    local image = {schema = interfaceimage.SCHEMA, descriptor = descriptor, modules = entries,}
    image.fingerprint = digest("nupp.module-interface\0v2\0" .. stable(image))
    if origins ~= nil and arenas ~= nil then
        local arena: {any} = {}
        arenas[image.fingerprint] = arena
        for index, source in ipairs(descriptorSources) do
            arena[index] = source
            if origins[source] == nil then
                origins[source] = {arena = image.fingerprint, node = index}
            end
        end
    end

    return image, nil
end

local function exactInteger(value: any): boolean
    return type(value) == "number" and value == math.floor(value) and value > 0
end

--- Loads an interface arena through local type constructors.
function interfaceimage.decode(
    image: any,
    nominals: {[string]: any}?,
    arenas: {[string]: {any}}?,
    origins: {[any]: any}?,
    trusted: boolean?
): (any?, {[string]: any}?, string?)
    if type(image) ~= "table"
        or image.schema ~= interfaceimage.SCHEMA
        or type(image.descriptor) ~= "table"
        or type(image.descriptor.types) ~= "table"
        or type(image.modules) ~= "table"
        or type(image.fingerprint) ~= "string"
    then
        return nil, nil, "the module interface image is malformed"
    end
    local fingerprint = image.fingerprint
    if not trusted then
        image.fingerprint = nil
        local expected = digest("nupp.module-interface\0v2\0" .. stable(image))
        image.fingerprint = fingerprint
        if fingerprint ~= expected then
            local names: {string} = {}
            for _, entry in ipairs(image.modules) do
                names[#names + 1] = tostring(entry.name)
            end

            return nil, nil, "the module interface fingerprint does not match for " .. table.concat(
                names,
                ", "
            ) .. " (expected " .. expected .. ", got " .. fingerprint .. ")"
        end
    end

    local descriptor = image.descriptor
    local nodes = descriptor.types
    local namespace = "interface\0" .. fingerprint .. "\0"
    local built: {any} = {}
    local active: {[integer]: boolean} = {}
    local nominalMap = nominals or {}
    local arenaMap = arenas or {}
    local populate: {[integer]: boolean} = {}

    -- Recursive declarations and binders are slots. Allocate every slot before a
    -- structural constructor sees an edge to it.
    for index, node in ipairs(nodes) do
        if type(node) ~= "table" or type(node.kind) ~= "string" then
            return nil, nil, "the module interface has a malformed type node"
        end
        if node.kind == "external" then
            local arena = type(node.arena) == "string" and arenaMap[node.arena] or nil
            if arena == nil or not exactInteger(node.node) or arena[node.node] == nil then
                return nil, nil, "the module interface references unavailable arena " .. tostring(
                    node.arena
                ) .. " node " .. tostring(node.node)
            end
            built[index] = arena[node.node]
        elseif node.nominal then
            local key = type(node.declarationKey) == "string" and node.declarationKey
                or namespace .. "nominal\0" .. tostring(index)
            local nominal = nominalMap[key]
            if node.external and (nominal == nil or nominal.selfType == nil) then
                return nil, nil, "the module interface references unavailable declaration " .. tostring(
                    node.name
                ) .. " (" .. tostring(key) .. ")"
            end
            if nominal == nil then
                nominal = T.nominal(node.name or "?", node.kind, key)
                nominalMap[key] = nominal
            end
            built[index] = nominal
            if not node.external then
                populate[index] = true
            end
        elseif node.kind == "typevar" then
            built[index] = T.typevar(node.name or "T", node.identity or namespace .. "type\0" .. tostring(index))
        elseif node.kind == "packvar" then
            built[index] = T.packvar(node.name or "P", node.identity or namespace .. "pack\0" .. tostring(index))
        elseif node.kind == "constVar" then
            built[
                index
            ] = T.constvar(
                node.name or "C",
                node.domain or "unknown",
                node.identity or namespace .. "const\0" .. tostring(index)
            )
        end
    end

    local build

    local function edge(index: any): any
        if not exactInteger(index) or index > #nodes then
            error("module interface has an invalid type edge", 0)
        end

        return build(index)
    end

    local function optional(index: any): any?
        return index ~= nil and edge(index) or nil
    end

    local function edgeArray(indices: any): {any}
        local values: {any} = {}
        for position, index in ipairs(indices or {}) do
            if index ~= 0 then
                values[position] = edge(index)
            end
        end

        return values
    end

    local function optionalEdgeArray(indices: any, present: boolean?): {any}?
        if not present and #(indices or {}) == 0 then
            return nil
        end

        return edgeArray(indices)
    end

    local function cleanupOf(cleanup: any): any
        local functionType = optional(cleanup.functionType)
        local term = optional(cleanup.constTerm)
        if cleanup.kind == "function" then
            if term then
                return T.constFunctionCleanup(term, cleanup.name, functionType)
            end
            return T.functionCleanup(cleanup.key or cleanup.name or "?", cleanup.name or "?", functionType)
        elseif cleanup.kind == "closure" then
            return T.closureCleanup()
        elseif cleanup.kind == "method" then
            return T.methodCleanup(cleanup.name or "?")
        elseif cleanup.kind == "dropfield" then
            return T.dropFieldCleanup(cleanup.field or "?")
        elseif cleanup.kind == "field" then
            return T.fieldCleanup(cleanup.field or "?", cleanupOf(cleanup.cleanup or {}))
        end
        error("module interface has an unknown cleanup kind", 0)
    end

    build = function(index)
        local known = built[index]
        local node = nodes[index]
        if known ~= nil and not populate[index] then
            if node.kind == "typevar" then
                known.bound = optional(node.bound)
                known.default = optional(node.default)
            end
            return known
        end
        if node.nominal then
            return known
        end
        if active[index] then
            error("module interface has a structural type cycle", 0)
        end
        active[index] = true
        local kind = node.kind
        local made = PRIMITIVES[kind]
        if made then
            -- Primitive table above is the complete mapping.
        elseif kind == "literal" then
            made = T.literal(node.value, edge(node.base))
        elseif kind == "constrained" then
            made = T.constrained(edge(node.base), node.predicate, node.constraintKey, node.label)
        elseif kind == "array" then
            local elements = node.elements
            made = T.array(
                edge(node.element),
                elements and #elements > 0 and edgeArray(elements) or nil,
                node.fresh == true
            )
        elseif kind == "map" then
            made = T.indexer(
                optional(node.readKey),
                optional(node.readValue),
                optional(node.writeKey),
                optional(node.writeValue)
            )
        elseif kind == "tuple" then
            made = T.tuple(edgeArray(node.members))
        elseif kind == "shape" then
            local fields: {any} = {}
            for _, field in ipairs(node.fields or {}) do
                fields[#fields + 1] = {name = field.name, read = optional(field.read), write = optional(field.write),}
            end
            local indexer = node.index or {}
            made = T.shape(
                fields,
                {
                    readKey = optional(indexer.readKey),
                    readValue = optional(indexer.readValue),
                    writeKey = optional(indexer.writeKey),
                    writeValue = optional(indexer.writeValue),
                },
                node.fresh == true,
                node.closed == true
            )
        elseif kind == "union" then
            made = T.union(edgeArray(node.members))
        elseif kind == "intersection" then
            made = T.intersection(edgeArray(node.members))
        elseif kind == "ptr" then
            made = T.ptr(edge(node.element))
        elseif kind == "carray" then
            made = T.carray(edge(node.element), node.count, optional(node.countTerm))
        elseif kind == "const" then
            made = T.constOf(edge(node.element))
        elseif kind == "borrowed" then
            made = T.borrowed(edge(node.element))
        elseif kind == "pinned" then
            made = T.pinned(edge(node.element))
        elseif kind == "affine" then
            local cleanups: {any} = {}
            for _, cleanup in ipairs(node.cleanups or {}) do
                cleanups[#cleanups + 1] = cleanupOf(cleanup)
            end
            made = T.affine(edge(node.element), cleanups, node.transferOnly == true)
        elseif kind == "ctype" then
            made = T.ctype(edge(node.of))
        elseif kind == "metatable" then
            made = T.metatable(edge(node.of))
        elseif kind == "typeobject" then
            made = T.typeObject(edge(node.of))
        elseif kind == "projection" then
            made = T.projection(edge(node.of), node.name)
        elseif kind == "pack" then
            local head, modes, names = {}, {}, {}
            for position, member in ipairs(node.head or {}) do
                head[position] = edge(member.type)
                modes[position] = member.mode or "plain"
                names[position] = member.name or ""
            end
            local tail = node.tail
            local builtTail = tail
                and {
                    kind = tail.kind,
                    type = optional(tail.type),
                    var = optional(tail.variable),
                    mode = tail.mode,
                    id = tail.id,
                }
                or nil
            made = T.pack(head, builtTail, modes, names)
            if #(node.alternatives or {}) > 0 then
                made = T.packUnion(edgeArray(node.alternatives))
            end
        elseif kind == "protocolThread" then
            made = T.protocolThread(
                edge(node.startPack),
                edge(node.resumePack),
                edge(node.yieldPack),
                edge(node.returnPack)
            )
        elseif kind == "function" or kind == "func" then
            local params, modes, names = {}, {}, {}
            for position, parameter in ipairs(node.parameters or {}) do
                params[position] = edge(parameter.type)
                modes[position] = parameter.mode or "plain"
                names[position] = parameter.name or ""
            end
            local predicate = node.predicate and {param = node.predicate.param, type = edge(node.predicate.type),}
                or nil
            local ffiOut: {any} = {}
            for position, output in ipairs(node.ffiOut or {}) do
                local cleanups: {any} = {}
                for cleanupPosition, cleanup in ipairs(output.cleanups or {}) do
                    cleanups[cleanupPosition] = cleanupOf(cleanup)
                end
                ffiOut[
                    position
                ] = {
                    kind = output.kind,
                    name = output.name,
                    cleanups = cleanups,
                    transferOnly = output.transferOnly == true,
                    valueType = optional(output.valueType),
                    cIndex = output.cIndex,
                    hasStatus = output.hasStatus == true,
                    success = output.success,
                    sourceParams = output.sourceParams or {},
                    returnIndex = output.returnIndex,
                }
            end
            made = T.func(
                params,
                edgeArray(node.returns),
                node.vararg == true,
                modes,
                predicate,
                optionalEdgeArray(node.typeParameters, node.hasTypeParameters),
                optionalEdgeArray(node.typeBounds, node.hasTypeBounds),
                node.borrowedFrom,
                node.borrowsSelf == true,
                node.hasBorrowedFromMany and node.borrowedFromMany or nil,
                ffiOut,
                optional(node.varargType),
                node.noReturn == true,
                optional(node.parameterPack),
                optional(node.returnPack),
                optionalEdgeArray(node.packParameters, node.hasPackParameters),
                optional(node.yieldPack),
                optional(node.resumePack),
                node.noYield == true,
                names,
                node.hasPreservesResults and node.preservesResults or nil,
                node.foreign == true,
                optionalEdgeArray(node.constParameters, node.hasConstParameters),
                node.hasParameterKinds and node.parameterKinds or nil,
                node.hasPartitionResults and node.partitionResults or nil,
                node.comptimeOnly == true,
                node.hasExplicitPreserves and node.explicitPreserves or nil,
                node.sendable == true,
                node.borrowedResult
            )
        elseif kind == "genericAlias" then
            local defaults: {any} = {}
            for position, value in ipairs(node.parameterDefaults or {}) do
                defaults[position] = optional(value.value)
            end
            made = T.genericAlias(
                node.name,
                edge(node.body),
                edgeArray(node.typeParameters),
                edgeArray(node.typeBounds),
                edgeArray(node.packParameters),
                edgeArray(node.constParameters),
                node.parameterKinds,
                defaults
            )
        elseif kind == "typevar" or kind == "packvar" or kind == "constVar" then
            made = known
        elseif kind == "typeHandle" then
            made = T.typeHandle(edge(node.bound))
        elseif kind == "packResult" then
            made = T.packResult(edge(node.pack))
        elseif kind == "constLiteral" then
            made = T.constLiteral(node.domain, node.value)
        elseif kind == "constOp" then
            made = T.constOp(node.operation, edgeArray(node.operands))
        elseif kind == "neutral" then
            if node.operation == "comptimeCall" then
                local arguments: {any} = {}
                for position, argument in ipairs(node.arguments or {}) do
                    arguments[position] = argument.kind == "type" and {kind = "type", value = edge(argument.type),}
                        or argument.kind == "typepack" and {kind = "typepack", value = edge(argument.pack),}
                        or {kind = "const", value = edge(argument.term),}
                end
                made = T.comptimeCall(
                    node.identity,
                    node.program,
                    arguments,
                    optional(node.bound),
                    node.resultKind == "typepack"
                )
            else
                local parts: {any} = {}
                for position, part in ipairs(node.templateParts or {}) do
                    parts[position] = part.literal ~= nil and part.literal or edge(part.type)
                end
                made = T.neutral(
                    node.operation,
                    optional(node.subject),
                    optional(node.key),
                    node.capability,
                    optional(node.binder),
                    optional(node.keys),
                    optional(node.value),
                    optional(node.remap),
                    optional(node.constTerm),
                    parts
                )
            end
        else
            error("module interface uses unsupported semantic kind " .. tostring(kind), 0)
        end
        if made == nil then
            error("module interface could not build semantic kind " .. tostring(kind), 0)
        end
        active[index] = nil
        built[index] = made

        return made
    end

    local function decodeAnnotations(applications: any): {any}
        local decoded: {any} = {}
        for _, application in ipairs(applications or {}) do
            local arguments: {any} = {}
            for _, argument in ipairs(application.arguments or {}) do
                arguments[
                    #arguments + 1
                ] = {
                    name = argument.name,
                    kind = argument.kind,
                    type = optional(argument.type),
                    value = argument.value,
                }
            end
            decoded[#decoded + 1] = {name = application.name, arguments = arguments,}
        end

        return decoded
    end

    local function populateNominal(index: integer): nil
        local node = nodes[index]
        local nominal = built[index]
        nominal.name = node.name
        nominal.declKind = node.kind
        nominal.declarationKey = node.declarationKey
        nominal.moduleName = node.moduleName
        nominal.deriveKey = node.deriveKey
        nominal.annotations = decodeAnnotations(node.annotations)
        nominal.fieldDefs = restoreDefinitions(node.fieldDefinitions)
        nominal.writeFieldDefs = restoreDefinitions(node.writeFieldDefinitions)
        nominal.staticFieldDefs = restoreDefinitions(node.staticFieldDefinitions)
        nominal.staticWriteFieldDefs = restoreDefinitions(node.staticWriteFieldDefinitions)
        nominal.byname, nominal.writeByname = {}, {}
        nominal.fieldDefaults = node.hasFieldDefaults and {} or nil
        nominal.fieldOrder = {}
        for _, field in ipairs(node.fields or {}) do
            if field.read then
                nominal.byname[field.name] = edge(field.read)
            end
            if field.write then
                nominal.writeByname[field.name] = edge(field.write)
            end
            if field.hasDefault then
                (nominal.fieldDefaults as {[string]: any})[field.name] = {value = field.defaultValue}
            end
            nominal.fieldOrder[#nominal.fieldOrder + 1] = field.name
            local definition = nominal.fieldDefs[field.name]
            if definition ~= nil then
                definition.annotations = decodeAnnotations(field.annotations)
            end
        end
        nominal.staticByname, nominal.staticWriteByname = {}, {}
        for _, field in ipairs(node.staticFields or {}) do
            if field.read then
                nominal.staticByname[field.name] = edge(field.read)
            end
            if field.write then
                nominal.staticWriteByname[field.name] = edge(field.write)
            end
        end
        nominal.indexReadKey = node.index and optional(node.index.readKey) or nil
        nominal.indexReadValue = node.index and optional(node.index.readValue) or nil
        nominal.indexWriteKey = node.index and optional(node.index.writeKey) or nil
        nominal.indexWriteValue = node.index and optional(node.index.writeValue) or nil
        nominal.metamethods = {}
        for _, metamethod in ipairs(node.metamethods or {}) do
            nominal.metamethods[metamethod.name] = edge(metamethod.type)
        end
        nominal.nestedTypes = {}
        for _, nested in ipairs(node.nestedTypes or {}) do
            nominal.nestedTypes[nested.name] = edge(nested.type)
        end
        nominal.associatedRequirements = node.hasAssociatedRequirements and {} or nil
        for position, requirement in ipairs(node.associatedRequirements or {}) do
            (
                nominal.associatedRequirements as {any}
            )[
                position
            ] = new T.AssociatedRequirement(
                name = requirement.name,
                bound = optional(requirement.bound),
                selfBinder = optional(requirement.selfBinder),
                definition = (node.associatedRequirementDefinitions or {})[position]
            )
        end
        nominal.associatedAnswers = node.hasAssociatedAnswers and {} or nil
        local answerDefinitions: {[string]: any} = {}
        for _, entry in ipairs(node.associatedAnswerDefinitions or {}) do
            answerDefinitions[entry.name] = entry.definition
        end
        for _, answer in ipairs(node.associatedAnswers or {}) do
            (
                nominal.associatedAnswers as {[string]: any}
            )[
                answer.name
            ] = new T.AssociatedAnswer(
                type = edge(answer.type),
                selfBinder = optional(answer.selfBinder),
                kind = answer.answerKind or "answer",
                definition = answerDefinitions[answer.name]
            )
        end
        nominal.supertypes = edgeArray(node.supertypes)
        nominal.arrayOf = optional(node.arrayOf)
        nominal.typeParams = optionalEdgeArray(node.typeParameters, node.hasTypeParameters)
        nominal.typeBounds = optionalEdgeArray(node.typeBounds, node.hasTypeBounds)
        nominal.packParams = optionalEdgeArray(node.packParameters, node.hasPackParameters)
        nominal.constParams = optionalEdgeArray(node.constParameters, node.hasConstParameters)
        nominal.paramKinds = node.hasParameterKinds and node.parameterKinds or nil
        nominal.typeArgs = optionalEdgeArray(node.typeArguments, node.hasTypeArguments)
        nominal.packArgs = optionalEdgeArray(node.packArguments, node.hasPackArguments)
        nominal.constArgs = optionalEdgeArray(node.constArguments, node.hasConstArguments)
        nominal.origin = optional(node.origin)
        nominal.selfType = optional(node.selfType)
        nominal.predicate = node.predicate
        nominal.paramDefaults = node.hasParamDefaults and {} or nil
        for position, value in ipairs(node.paramDefaults or {}) do
            (nominal.paramDefaults as {any})[position] = optional(value.value)
        end
        nominal.inheritedDefaults = node.hasInheritedDefaults and {} or nil
        for _, entry in ipairs(node.inheritedDefaults or {}) do
            (nominal.inheritedDefaults as {[string]: any})[entry.name] = edge(entry.owner)
        end
        nominal.defaults = node.hasDefaults and node.defaults or nil
        nominal.privateFields = node.hasPrivateFields and node.privateFields or nil
        nominal.fieldBorrowSources = node.hasFieldBorrowSources and node.fieldBorrowSources or nil
        nominal.borrowedRootFields = node.hasBorrowedRootFields and node.borrowedRootFields or nil
        nominal.affineFields = node.hasAffineFields and node.affineFields or nil
        nominal.inherentCleanup = node.inherentCleanup and cleanupOf(node.inherentCleanup) or nil
        nominal.sealedModule = node.sealedModule
        nominal.terminalMethod = node.terminalMethod
        nominal.intrinsicAffine = node.intrinsicAffine == true or nil
        nominal.intrinsicAffineClaim = node.intrinsicAffineClaim == true or nil
        nominal.managedCell = node.managedCell == true or nil
        nominal.managedAlias = node.managedAlias == true or nil
        nominal.lpegPattern = node.lpegPattern == true or nil
        nominal.lpegLibrary = node.lpegLibrary == true or nil
        nominal.lpegPatternOrigin = optional(node.lpegPatternOrigin)
        nominal.runtimePath = node.runtimePath
        nominal.cdefName = node.cdefName
        nominal.cdefKind = node.cdefKind
        nominal.cdefIdentity = node.cdefIdentity
        nominal.constructors = edgeArray(node.constructors)
        nominal.constructorEntries = {}
        for position, result in ipairs(node.constructorResults or {}) do
            nominal.constructorEntries[
                position
            ] = {
                signature = nominal.constructors[position],
                result = optional(result.result),
                index = result.index or position,
                escapesSelf = result.escapesSelf == true,
                movesOwner = result.movesOwner == true,
            }
        end

        local function decodeMethodEntry(entry: any): any
            return {
                signature = edge(entry.signature),
                declaration = nil,
                member = entry.member,
                parameterKey = entry.parameterKey,
                definition = entry.definition,
            }
        end

        local function decodeMethodGroups(groups: any): {[string]: {any}}
            local decoded: {[string]: {any}} = {}
            for _, group in ipairs(groups or {}) do
                local entries: {any} = {}
                for _, entry in ipairs(group.entries or {}) do
                    entries[#entries + 1] = decodeMethodEntry(entry)
                end
                decoded[group.name] = entries
            end

            return decoded
        end

        nominal.methodEntries = decodeMethodGroups(node.methodEntries)
        nominal.methodDispatchEntries = decodeMethodGroups(node.methodDispatchEntries)
        nominal.staticEntries = decodeMethodGroups(node.staticEntries)
        nominal.overloadedMethods = {}
        for _, name in ipairs(node.overloadedMethods or {}) do
            nominal.overloadedMethods[name] = true
        end
        nominal.overloadedStatics = {}
        for _, name in ipairs(node.overloadedStatics or {}) do
            nominal.overloadedStatics[name] = true
        end
        nominal.defaultEntries = {}
        for _, entry in ipairs(node.defaultEntries or {}) do
            nominal.defaultEntries[
                entry.slot
            ] = {
                name = entry.name,
                member = entry.member,
                slot = entry.runtimeSlot,
                entry = entry.entry and decodeMethodEntry(entry.entry) or nil,
            }
        end
        populate[index] = nil
    end

    local ok, problem = pcall(function(): nil
        for index in pairs(populate) do
            populateNominal(index)
        end
        for index = 1, #nodes do
            build(index)
        end
    end)
    if not ok then
        return nil, nil, tostring(problem)
    end
    arenaMap[fingerprint] = built
    if origins ~= nil then
        for index, value in ipairs(built) do
            if origins[value] == nil then
                origins[value] = {arena = fingerprint, node = index}
            end
        end
    end

    local semantics: {[string]: any} = {}
    for _, entry in ipairs(image.modules) do
        local exports = {
            types = {},
            typeDefs = restoreDefinitions(entry.typeDefs),
            values = {},
            valueDefs = restoreDefinitions(entry.valueDefs),
            comptimeFunctions = {},
            nominalEffectFingerprint = entry.nominalEffectFingerprint,
            deriveInterfaceFingerprint = entry.deriveInterfaceFingerprint,
            comptimeFunctionFingerprint = entry.comptimeFunctionFingerprint,
            callGuarantees = entry.callGuarantees,
        }
        for _, exported in ipairs(entry.types or {}) do
            exports.types[exported.name] = build(exported.root)
        end
        for _, exported in ipairs(entry.values or {}) do
            exports.values[exported.name] = build(exported.root)
        end
        for _, encoded in ipairs(entry.comptimeFunctions or {}) do
            local deriveInterface = encoded.deriveInterface and build(encoded.deriveInterface) or nil
            exports.comptimeFunctions[
                encoded.name
            ] = {
                sealedTypeFunction = encoded.sealedTypeFunction == true,
                identity = encoded.identity,
                main = encoded.main,
                serializedHelpers = encoded.serializedHelpers,
                signature = encoded.signature and build(encoded.signature) or nil,
                definition = encoded.definition,
                bodyFingerprint = encoded.bodyFingerprint,
                deriveProvider = encoded.deriveProvider == true,
                deriveInterface = deriveInterface,
                deriveInterfaceIdentity = deriveInterface and deriveInterface.id or nil,
                providerModule = encoded.providerModule,
                providerModuleLocal = encoded.providerModuleLocal,
                runtimeHelpers = encoded.runtimeHelpers,
            }
        end
        semantics[
            entry.name
        ] = {
            interface = {
                type = build(entry.interface),
                nominalEffectFingerprint = entry.nominalEffectFingerprint,
                deriveInterfaceFingerprint = entry.deriveInterfaceFingerprint,
            },
            exports = exports,
            diags = entry.diags or {},
            source = entry.source,
        }
    end

    return semantics, nominalMap, nil
end

export = interfaceimage
