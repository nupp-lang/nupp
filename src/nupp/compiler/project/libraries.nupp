module nupp.compiler.project.libraries

local fs = require("nupp.compiler.fs")
local files = require("io.internal.files")
local targetLayout = require("nupp.compiler.targetlayout")

export type Binding = {
    name: string,
    reference: string,
    path: string?,
    error: string?,
    dependencies: {string},
    override: string?,
    notices: {string}?
}

export type Plan = {bindings: {[string]: Binding}}

local function rooted(root: string, path: string): string
    if path:match("^[/\\]") or path:match("^%a:[/\\]") then
        return fs.absolute(path)
    end
    return fs.absolute(fs.join(root, path))
end

--- Returns the shared-library filename for a target triple or the current host.
export function filename(name: string, target: string?): string
    local platform = (target or targetLayout.hostKey() or ""):lower()
    if platform:find("windows", 1, true) then
        return name .. ".dll"
    elseif platform:find("darwin", 1, true) or platform == "osx" then
        return "lib" .. name .. ".dylib"
    end

    return "lib" .. name .. ".so"
end

--- The pinned C libraries the standard library binds by logical name. Each is
--- bound to the shared library its environment variable names, or else, from
--- a source checkout, to the one `scripts/c-library-paths` provisions once per
--- machine: on the first use of the name, so a program that binds neither
--- builds neither. A project's own `libraries` entry for one of these names
--- replaces it, and the compiler's own image (`_standardLibraries = false`)
--- binds none, so no building machine's path is part of it.
---
--- `pins` are the `scripts/toolchain.pins` prefixes a provisioned one is built
--- from, and `notices` the license files its artifact carries under
--- `notices/`, which a package stages beside the library and nowhere else.
export const STANDARD: {[string]: {
    name: string,
    env: string,
    pins: {string},
    notices: {string}
}} = {
    nuppzlib = {name = "z", env = "NUPP_ZLIB_LIBRARY", pins = {"ZLIB_"}, notices = {"zlib-LICENSE.txt"}},
    nuppcrc = {
        name = "nupp_crc",
        env = "NUPP_CRC_LIBRARY",
        pins = {"ISAL_"},
        notices = {"ISA-L-LICENSE.txt", "ISA-L-CRC-LICENSE.txt"}
    },
}

-- The path `scripts/c-library-paths` printed for a variable, or why it named
-- none, by script and variable, once per process. Each variable is asked for
-- alone, so building one library never builds another, and one that fails
-- leaves the others to be asked for.
local type Provisioned = {
    path: string?,
    problem: string?
}
local provisioned: {[string]: Provisioned} = {}

local function checkoutScript(): string?
    local envMod: any = require("nupp.compiler.project.env")
    local root = envMod.compilerRoot()
    if root == nil then
        return nil
    end
    local script = fs.join(root, "scripts/c-library-paths")

    return files.stat(script) == "file" and script or nil
end

-- Builds one of the checkout's pinned C libraries, or finds it built, and
-- answers its path, or why there is none.
local function provision(script: string, variable: string): (string?, string?)
    local key = script .. "\0" .. variable
    local known = provisioned[key]
    if known ~= nil then
        return known.path, known.problem
    end
    local process: any = require("nupp.compiler.process")
    local windows = package.config:sub(1, 1) == "\\"
    local code, text = process.capture({windows and "sh.exe" or "sh", script, variable})
    local path: string? = nil
    for name, value in text:gmatch("(NUPP_[%w_]+_LIBRARY)=([^\r\n]+)") do
        if name == variable then
            path = value
        end
    end
    local problem: string? = nil
    if code ~= 0 then
        path, problem = nil, "cannot build the pinned C library " .. variable .. ":\n" .. text
    elseif path == nil then
        problem = "scripts/c-library-paths named no " .. variable
    end
    provisioned[key] = {path = path, problem = problem}

    return path, problem
end

-- The notice files of a standard library at `path`: those its artifact keeps
-- beside `lib` or `bin`, else the checkout's copies. A notice found in
-- neither is left out.
local function standardNotices(name: string, path: string): {string}
    local found: {string} = {}
    local library = STANDARD[name]
    if library == nil then
        return found
    end
    local artifact = fs.dirname(fs.dirname(path))
    local envMod: any = require("nupp.compiler.project.env")
    local checkout = envMod.compilerRoot()
    for _, notice in ipairs(library.notices) do
        local candidates = {fs.join(artifact, "notices/" .. notice)}
        if checkout ~= nil then
            candidates[#candidates + 1] = fs.join(checkout as string, "notices/" .. notice)
        end
        for _, candidate in ipairs(candidates) do
            if files.stat(candidate) == "file" then
                found[#found + 1] = candidate
                break
            end
        end
    end

    return found
end

-- Bindings resolved on first use, by the bindings table they belong to, with
-- what their resolution depends on for `fingerprint`.
local LAZY: {[any]: string} = setmetatable({}, {__mode = "k"})

local function regularFile(path: string): boolean
    return files.stat(path) == "file"
end

local function completedDependencies(root: string, outDir: string): {[string]: any}
    local text = fs.readFile(rooted(root, fs.join(outDir, ".nupp-state.json")))
    if not text then
        return {}
    end
    local json = require("serde.json")
    local state, invalid = json.decodevalue(text, json.NULL)
    if invalid ~= nil or type(state) ~= "table" or type(state.dependencies) ~= "table" then
        return {}
    end

    return state.dependencies
end

--- Resolves project library inputs without building or copying them.
---
--- Missing files remain on their bindings until a target actually uses them.
export function resolve(root: string, config: any, options: any?): Plan
    options = options or {}
    local target = options.target
    local hostTarget = targetLayout.hostKey()
    local getenv = options.getenv or os.getenv
    local outDir = options.outDir or (config.build or {}).outDir or "build"
    local configured: {[string]: any} = {}
    local deferred: {[string]: boolean} = {}
    if config._standardLibraries ~= false then
        for name, library in pairs(STANDARD) do
            local path = getenv(library.env)
            if path ~= nil and path ~= "" then
                configured[name] = library
            else
                deferred[name] = true
            end
        end
    end
    for name, library in pairs(config.libraries or {}) do
        configured[name] = library
    end
    local native = {}
    for name, dependency in pairs(config.dependencies or {}) do
        if dependency.kind == "c" or dependency.kind == "cargo" then
            native[name] = dependency
        end
    end
    local records = options.dependencies
    if records == nil and next(native) ~= nil then
        records = completedDependencies(root, outDir)
    end
    records = records or {}
    local bindings: {[string]: Binding} = {}

    local function reference(path: string): string
        return options.packaged and "@lib/" .. fs.basename(path) or path
    end

    for name, library in pairs(configured) do
        local base = library.name or name
        local expected = filename(base, target)
        local override = library.env and getenv(library.env) or nil
        local binding: Binding = {
            name = name,
            reference = name,
            dependencies = library.dependencies or {},
            override = override,
        }
        local tried: {string} = {}
        if override ~= nil and override ~= "" then
            local path = rooted(root, override)
            tried[#tried + 1] = library.env .. "=" .. path
            if regularFile(path) then
                binding.path, binding.reference = path, reference(path)
                binding.notices = standardNotices(name, path)
            end
        else
            for _, directory in ipairs(library.search or {}) do
                local path = rooted(root, fs.join(directory, expected))
                tried[#tried + 1] = path
                if regularFile(path) then
                    binding.path, binding.reference = path, reference(path)
                    break
                end
            end
        end
        if binding.path == nil then
            binding.error = (
                "cannot resolve native library %q (%s); searched %s"
            ):format(name, expected, #tried > 0 and table.concat(tried, ", ") or "no configured search directories")
        end
        bindings[name] = binding
    end

    for name, dependency in pairs(native) do
        local record = records[name]
        if record and record.usage ~= nil and record.usage ~= "target" then
            record = nil
        end
        local binding: Binding = {name = name, reference = name, dependencies = {}}
        for _, child in ipairs(dependency.dependencies or {}) do
            local childRecord = records[child]
            local childDependency = native[child]
            if childDependency
                and childRecord
                and (childRecord.usage == nil or childRecord.usage == "target")
                and (childRecord.runtimeOutput or childRecord.staticOutput == nil and childRecord.output)
            then
                binding.dependencies[#binding.dependencies + 1] = child
            end
        end
        local path = record and (record.runtimeOutput or (record.staticOutput == nil and record.output)) or nil
        if record and record.staticOutput and options.standalone then
            binding.reference = "<default>"
        elseif record and record.reference and record.reference:sub(1, 1) ~= "@" then
            binding.reference = record.reference
        elseif path ~= nil then
            path = rooted(root, path)
            if regularFile(path) then
                binding.path, binding.reference = path, reference(path)
            else
                binding.error = ("native library %q has no built shared file at %s"):format(name, path)
            end
        elseif record and record.staticOutput then
            binding.error = (
                "native library %q provides only static linkage; use a standalone binary or a shared dependency"
            ):format(name)
        else
            local base = dependency.library or name
            base = base:gsub("%-", "_")
            local produced = dependency.output or fs.join(outDir, "lib/" .. filename(base, target))
            local at = rooted(root, produced)
            if regularFile(at) then
                binding.path, binding.reference = at, reference(at)
            else
                binding.error = ("native library %q has not been built; expected %s"):format(name, at)
            end
        end
        if dependency.kind == "cargo" and target ~= nil then
            local actual = dependency.target or hostTarget
            local sameWindowsAbi = actual ~= nil
                and actual:match("^[^-]+") == target:match("^[^-]+")
                and actual:find("windows", 1, true)
                and target:find("windows", 1, true)
            if actual ~= nil and actual ~= target and not sameWindowsAbi then
                binding.error = (
                    "native Cargo library %q targets %s, not %s; set dependencies.%s.target explicitly"
                ):format(name, actual, target, name)
            end
        end
        bindings[name] = binding
    end

    local ownErrors: {[string]: string} = {}
    for name, binding in pairs(bindings) do
        if binding.error then
            ownErrors[name] = binding.error
        end
    end
    local dependencyProblem: function(string, {[string]: boolean}): string?
    dependencyProblem = function(name: string, visiting: {[string]: boolean}): string?
        local binding = bindings[name]
        if binding == nil then
            return "unknown native library " .. name
        end
        if ownErrors[name] then
            return ownErrors[name]
        end
        if visiting[name] then
            return nil
        end
        visiting[name] = true
        for _, child in ipairs(binding.dependencies) do
            local problem = dependencyProblem(child, visiting)
            if problem then
                visiting[name] = nil
                return ("native library %q requires %q: %s"):format(name, child, problem)
            end
        end
        visiting[name] = nil

        return nil
    end
    for name, binding in pairs(bindings) do
        binding.error = dependencyProblem(name, {})
    end

    -- A standard library the environment does not name is provisioned from
    -- the checkout when a module first binds it.
    for name in pairs(config.libraries or {}) do
        deferred[name] = nil
    end
    local script = options.script or checkoutScript()
    if next(deferred) ~= nil and script ~= nil then
        local pins = fs.readFile(fs.join(fs.dirname(script as string), "toolchain.pins")) or ""
        local prefixes: {string} = {}
        for name in pairs(deferred) do
            for _, prefix in ipairs(assert(STANDARD[name]).pins) do
                prefixes[#prefixes + 1] = prefix
            end
        end
        local inputs: {string} = {}
        for line in pins:gmatch("[^\r\n]+") do
            for _, prefix in ipairs(prefixes) do
                if line:sub(1, #prefix) == prefix then
                    inputs[#inputs + 1] = line
                    break
                end
            end
        end
        table.sort(inputs)
        LAZY[bindings] = table.concat(inputs, "\0")
        setmetatable(bindings as any, {
            __index = function(table: any, name: string): Binding?
                if not deferred[name] then
                    return nil
                end
                deferred[name] = nil
                local binding: Binding = {name = name, reference = name, dependencies = {}}
                local path, problem = provision(script as string, assert(STANDARD[name]).env)
                if path ~= nil and regularFile(path) then
                    binding.path, binding.reference = path, reference(path)
                    binding.notices = standardNotices(name, path)
                else
                    binding.error = (
                        "cannot resolve native library %q: %s"
                    ):format(name, problem or "no file at " .. tostring(path))
                end
                rawset(table, name, binding)

                return binding
            end,
        })
    end

    return {bindings = bindings}
end

--- Returns the stable resolution facts that a cached check depends on.
export function fingerprint(bindings: {[string]: Binding}): string
    local parts: {string} = {}
    for name, binding in pairs(bindings) do
        parts[#parts + 1] = name .. "\0" .. binding.reference .. "\0" .. (binding.error or "")
    end
    table.sort(parts)
    -- What a binding resolved on first use will depend on.
    local lazy = LAZY[bindings]
    if lazy ~= nil then
        parts[#parts + 1] = "standard\0" .. lazy
    end

    return table.concat(parts, "\0")
end
