--- Returns every carried file named by either map, sorted.
---
--- @return the files, by the spelling `nupp.compiler.bundled` reads
export function files(): {string}
    local found: {string} = {}
    for _, file in pairs(declarations) do
        found[#found + 1] = file
    end
    for _, file in pairs(implementations) do
        found[#found + 1] = file
    end
    table.sort(found)

    return found
end
