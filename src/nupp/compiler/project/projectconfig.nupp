module nupp.compiler.project.projectconfig

--[[
What the compiler reads from a project's manifest before it checks a line: the
target a command selected, and where the declarations the project's
dependencies installed are.

The build owns the manifest -- it validates it (`nupp.tools.build.manifest`)
and fetches and builds what it names (`nupp.tools.build.deps`) -- and an
environment asks it only these read-only questions. None of them fetches,
installs or builds anything: an editor has to be able to open a project whose
dependencies nobody has built, and still type an already-installed rock.

The manifest's shapes are the build's, and the compiler does not depend on the
build, so they are `any` here; the build hands in tables it has already
validated and types what comes back (`nupp.tools.build.tasks`).
]]

local fs = require("nupp.compiler.fs")
local process = require("nupp.compiler.process")

local normalize, join = fs.normalize, fs.join
local readFile, exists = fs.readFile, fs.exists

local projectconfig = {}

local type Config = any
local type Target = any
local type Dependency = any
local type DependencyRecord = any

local function targetConfig(config: Config, requested: string?): Target?, string?
    local build = (config.build or {}) as any
    if build.targets then
        local name = requested or build.default
        if not name then
            local names = {}
            for candidate in pairs(build.targets) do
                names[#names + 1] = candidate
            end
            table.sort(names)
            name = names[1]
        end
        local target = (name and build.targets[name]) as Target
        if type(target) ~= "table" then
            return nil, "unknown build target " .. tostring(name)
        end
        local merged: Target = {}
        for key, value in pairs(build) do
            if key ~= "targets" and key ~= "default" then
                merged[key] = value
            end
        end
        for key, value in pairs(target) do
            merged[key] = value
        end
        if merged.kind == "docs" then
            merged.targetName = name
        else
            merged.name = name
        end
        return merged
    end
    -- A build section that names no targets is the target, which is what the manifest
    -- means by leaving them out.

    return build as Target
end

--- Explicit dependency edges retain the target role throughout their closure.
function projectconfig.targetNames(config: Config, target: Target?): {string}
    local selected: {[string]: boolean} = {}

    local function visit(name: string): nil
        if selected[name] then
            return
        end
        selected[name] = true
        local dependency = (config.dependencies or {})[name]
        for _, child in ipairs(dependency and dependency.dependencies or {}) do
            visit(child)
        end
    end

    for _, name in ipairs(target and target.dependencies or {}) do
        visit(name)
    end
    local names: {string} = {}
    for name in pairs(selected) do
        names[#names + 1] = name
    end
    table.sort(names)

    return names
end

--- The search-path entries one rock tree adds.
type projectconfig.RockPaths = {
    path: string,
    cpath: string,

    --- Installed package directories containing module-shaped `.d.nupp` files.
    typeRoots: {string}
}

local ROCK_LUA_VERSION = "5.1"
local ROCK_TREE = ".rocks"

local windows = package.config:sub(1, 1) == "\\"

local currentDirectory = nil

local function absolute(path)
    path = normalize(path or "")
    if path:sub(1, 1) == "/" or path:match("^%a:") then
        return path
    end
    if not currentDirectory then
        local _, printed = process.capture(windows and {"cmd", "/d", "/c", "cd"} or {"pwd"})
        currentDirectory = normalize(((printed or "."):gsub("%s+$", "")))
    end
    if path == "" or path == "." then
        return currentDirectory
    end

    return join(currentDirectory, path)
end

local function treePaths(tree, luaVersion)
    local share = tree .. "/share/lua/" .. luaVersion
    return {
        path = share .. "/?.lua;" .. share .. "/?/init.lua",
        cpath = tree .. "/lib/lua/" .. luaVersion .. (windows and "/?.dll" or "/?.so"),
    }
end

local function rockTypeRoot(tree, luaVersion, rock, version)
    if not version or version == "installed" then
        return nil
    end
    return join(tree, "lib/luarocks/rocks-" .. luaVersion .. "/" .. rock .. "/" .. version .. "/nupp")
end

local function rockTree(root, dep)
    return absolute(join(root, dep.tree or ROCK_TREE)), dep.luaVersion or ROCK_LUA_VERSION
end

--- A rockspec's literal string field -- `package = "name"` on a line of its own --
--- or nil when it is not declared as one. The rock publisher reads rockspecs the
--- same way, through this, so the two cannot disagree on what a declaration is.
function projectconfig.rockspecField(text: string, field: string): string?
    return text:match("[\r\n]" .. field .. "%s*=%s*[\"']([^\"']+)[\"']")
        or text:match("^" .. field .. "%s*=%s*[\"']([^\"']+)[\"']")
end

local function declaredVersion(rockspec)
    local text = rockspec and readFile(rockspec)
    if not text then
        return nil
    end

    return projectconfig.rockspecField(text, "version")
end

local function declaredPackage(rockspec): string?
    local text = rockspec and readFile(rockspec)
    if not text then
        return nil
    end

    return projectconfig.rockspecField(text, "package")
end

-- The rock a dependency is, and its version: the completed record is
-- authoritative, then the manifest, then what the rockspec declares, and the
-- dependency's own name is the last word on the package.
local function rockIdentity(record, dep, rockspec, name): (string, string?)
    return record and record.rock
        or dep.rock
        or declaredPackage(rockspec)
        or name, record and record.version
        or dep.version
        or declaredVersion(rockspec)
end

--- The search-path entries the rocks a target depends on are installed under.
---
--- A build installs into a tree that belongs to the project, so a program the toolchain
--- starts afterwards -- the project test command above all -- has to be told where
--- that tree is; inside this process the provider has already said so. Returns nil when
--- the target depends on no rocks.
local function rockPaths(
    root: string,
    config: Config,
    target: Target?,
    records: {[string]: DependencyRecord}?
): projectconfig.RockPaths?
    local paths, cpaths, typeRoots, seen = {}, {}, {}, {}
    for _, name in ipairs(projectconfig.targetNames(config, target)) do
        local dep = (config.dependencies or {})[name] as Dependency
        if type(dep) == "table" and dep.kind == "luarocks" then
            local tree, luaVersion = rockTree(root, dep)
            local id = tree .. "\0" .. luaVersion
            if not seen[id] then
                seen[id] = true
                local entries = treePaths(tree, luaVersion)
                paths[#paths + 1] = entries.path
                cpaths[#cpaths + 1] = entries.cpath
            end
            local record = records and records[name] or nil
            -- A manifest dependency name is only a local key. The installed rock may
            -- have a different package name, and the completed dependency record is
            -- authoritative even when the manifest omitted `rock` and named a
            -- rockspec whose package field supplied it.
            local rockspec = dep.rockspec and absolute(join(root, dep.rockspec)) or nil
            local rock, version = rockIdentity(record, dep, rockspec, name)
            local typeRoot = record and record.typeRoot or rockTypeRoot(tree, luaVersion, rock, version)
            if typeRoot then
                typeRoots[#typeRoots + 1] = typeRoot
            end
        end
    end
    if #paths == 0 then
        return nil
    end

    return {path = table.concat(paths, ";"), cpath = table.concat(cpaths, ";"), typeRoots = typeRoots,}
end

local function scopeKey(name: string, usage: string): string
    if usage == "target" then
        return name
    end
    return usage .. ":" .. name
end

local function dependencyRecord(records, name, usage)
    return records and records[scopeKey(name, usage or "target")] or nil
end

--- The checked-only declaration roots configured by the project. This lookup never
--- fetches: editors can use a previous checkout immediately, while build/check resolve
--- the pinned revision through `buildDependencies` first.
local function typeRoots(root: string, config: Config, records: {[string]: DependencyRecord}?): {string}
    local roots = {}
    local target = config._target or {}
    local names = target.compileDependencies
    if names == nil then
        names = {}
        for name, dep in pairs(config.dependencies or {}) do
            if dep.kind == "types" then
                names[#names + 1] = name
            end
        end
    end
    local selected: {[string]: boolean} = {}
    for _, name in ipairs(names) do
        selected[name] = true
    end
    for _, name in ipairs(projectconfig.targetNames(config, target)) do
        selected[name] = true
    end
    for name in pairs(selected) do
        local dep = (config.dependencies or {})[name]
        if dep then
            local record = dependencyRecord(records, name, "compile") or dependencyRecord(records, name, "target")
            local checkout = join(root, ".nupp/deps/" .. name)
            local path = record and (record.typesRoot or record.typeRoot)
                or dep.kind == "types" and join(checkout, dep.path or ".")
                or nil
            if path and exists(path) then
                roots[#roots + 1] = path as string
            end
        end
    end
    table.sort(roots)

    return roots
end

projectconfig.targetConfig = targetConfig
projectconfig.absolute = absolute
projectconfig.treePaths = treePaths
projectconfig.rockTypeRoot = rockTypeRoot
projectconfig.rockTree = rockTree
projectconfig.rockIdentity = rockIdentity
projectconfig.declaredVersion = declaredVersion
projectconfig.declaredPackage = declaredPackage
projectconfig.rockPaths = rockPaths
projectconfig.scopeKey = scopeKey
projectconfig.record = dependencyRecord
projectconfig.typeRoots = typeRoots

export = projectconfig
