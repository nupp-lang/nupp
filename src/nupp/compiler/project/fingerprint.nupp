module nupp.compiler.project.fingerprint

--[[
What the running compiler is, as a digest.

Every store the toolchain keeps between commands is stamped with the code that
computed what it holds, so an answer is believed only while that code is
unchanged. This is where those stamps come from: the digest of the whole
toolchain (`toolFingerprint`), of the part of it one answer came from
(`subsystemFingerprint`), and of the declarations it carries
(`declarationFingerprint`).

Reading and digesting a whole compiler tree costs about five milliseconds
(`nupp.compiler.hash`), which is why there is no modification-time shortcut here
and no need for one. A shortcut would only be able to make this cheaper by
making it wrong.
]]

local hash = require("nupp.compiler.hash")
local fs = require("nupp.compiler.fs")

local join = fs.join
local dirname = fs.dirname
local readFile = fs.readFile
local listFiles = fs.listFiles

local fingerprint = {}

--- The content digest to use for cache keys, native where the host has one.
---
--- Byte for byte the answer `nupp.compiler.hash.digest` gives --
--- `tests/projecttest.lua` holds the two implementations to that -- and about two
--- thousand times faster, because the portable one emulates XXH64's 64-bit
--- arithmetic over `uint32` halves and this one does not have to. A build puts
--- every source, every compiler file and every memoized value through it, so the
--- difference is seconds a command rather than a micro-optimisation.
---
--- Resolved once. The running compiler cannot grow or lose an FFI while it runs,
--- and a portable `lua51` session has none to load: `native` false is how a
--- caller that knows it is building for one says so, and the `pcall` is for a
--- native host whose library is missing rather than for that.
local nativeDigestMemo: any = nil

function fingerprint.contentDigest(native: boolean?): function(string): string
    if native == false then
        return hash.digest
    end
    if nativeDigestMemo == nil then
        -- Named indirectly, so a portable bundle does not carry host services in
        -- for the sake of a branch it never takes.
        local ok, services = pcall(require, "nupp.compiler." .. "hostservices")
        local resolved = ok and services and services.hash and services.hash.digest or nil
        nativeDigestMemo = resolved or false
    end

    return nativeDigestMemo or hash.digest
end

local function hashFile(path: string, contentDigest: (function(string): string)?): string?
    local text = readFile(path)
    local digest = contentDigest or hash.digest

    return text and digest(text) or nil
end

local function hashFiles(files: {string}): string
    local parts = {}
    for _, path in ipairs(files) do
        parts[#parts + 1] = path .. "\0" .. (hashFile(path, hash.digest) or "missing")
    end

    return hash.digest(table.concat(parts, "\0"))
end

--- The compiler's own directory, `<root>/nupp/compiler`: this file sits in `project/`
--- below it.
local function compilerDir(): string
    local source = debug.getinfo(1, "S").source
    return dirname(source:match("^@(.*)[/\\]") or ".")
end

--- Whether the running compiler is one bundled file rather than a tree of modules.
---
--- Asked of this module's own chunk name: compiled to a tree it is `fingerprint.lua`,
--- and inside a bundle it is whatever the bundle was loaded as -- the stage-zero
--- compiler's own file, or the module's name for a chunk a binary dumped. Neither has a
--- module tree beside it to read, which is the only thing callers want to know.
---
--- Asked this way rather than by recognizing a directory, because where a stage zero
--- is kept is `scripts/toolchain`'s business and it has moved once already.
local function bundled(): boolean
    local source = debug.getinfo(1, "S").source
    return (source:match("[^/\\]*$") or "") ~= "fingerprint.lua"
end

-- The running compiler cannot change while it is running, so the answer is computed
-- once. Listing the tree shells out to `find`, and a build that asks twice was paying
-- for a second process to be told the same thing.
local toolFingerprintMemo = nil

local function toolFingerprint(contentDigest: (function(string): string)?): string
    if toolFingerprintMemo then
        return toolFingerprintMemo
    end
    local digest = contentDigest or hash.digest
    -- The toolchain is two trees, the compiler and the tools built on it, and both
    -- decide what a build writes: `nupp.tools.build` is where an artifact is put
    -- together. Named from the directory holding both.
    local dir = dirname(compilerDir())
    local files: {string} = {}
    if bundled() then
        files = {(debug.getinfo(1, "S").source:gsub("^@", ""))}
    else
        for _, tree in ipairs({"compiler", "tools"}) do
            for _, path in ipairs(listFiles(join(dir, tree))) do
                if path:match("%.lua$") then
                    files[#files + 1] = path
                end
            end
        end
    end
    -- Named relative to that directory, so the answer describes the compiler rather
    -- than where it was found. `compilerDir` reports whatever
    -- `package.path` was written as, and the launcher writes an absolute path where a
    -- test harness writes a relative one -- so hashing the paths as given made one
    -- compiler fingerprint two ways depending on how it was started, and anything keyed
    -- on it threw away the other's work every time the two alternated.
    local parts = {}
    for _, path in ipairs(files) do
        local relative = path
        if path:sub(1, #dir + 1) == dir .. "/" then
            relative = path:sub(#dir + 2)
        end
        parts[#parts + 1] = relative .. "\0" .. (hashFile(path, digest) or "missing")
    end
    table.sort(parts)
    toolFingerprintMemo = digest(table.concat(parts, "\0"))

    return toolFingerprintMemo
end

--- What the compiler's own modules are, and which of them each one requires.
---
--- Read off the built tree by the compiler's own lexer, so a `require` written inside a
--- string -- `explain` and `gen` both compose source text containing one -- is a string
--- and not an edge. A `require` whose argument is not a literal cannot be followed, so
--- its module is marked incomplete. Only a subsystem that reaches that module falls
--- back to the whole compiler: an unrelated runtime plugin must not erase every narrow
--- compiler stamp.
type fingerprint.ModuleGraph = {
    --- Module name -> the file it lives in, relative to the tree root.
    files: {[string]: string},

    --- Module name -> the modules it requires.
    edges: {[string]: {string}},

    --- Module name -> the digest of its file.
    digests: {[string]: string},

    --- Modules containing a computed require the static graph cannot follow.
    unknown: {[string]: boolean}
}

--- Bumped when an entry stops decoding into what the reader expects.
local GRAPH_STAMP = "modules/2"

local graphMemo: fingerprint.ModuleGraph? = nil

--- Whether this process has read or computed the graph, and which stores have
--- been given it. A caller with nowhere to write computes it in this process,
--- which must not stop the next caller that has somewhere from keeping it for
--- the next command; keyed by directory so every store asked for gets it once.
local graphAttempted = false

local graphStoredIn: {[string]: boolean} = {}

--- The module name a file under `root` provides: the path, without its extension, with
--- the separators spelled as dots. `init` is how a directory names itself.
local function moduleNameOf(root: string, path: string): string?
    if path:sub(1, #root + 1) ~= root .. "/" then
        return nil
    end
    local relative = path:sub(#root + 2):gsub("%.lua$", "")
    local name = relative:gsub("/", ".")
    name = name:gsub("%.init$", "")

    return name ~= "" and name or nil
end

--- The modules `text` requires, what it may require dynamically, and whether it
--- requires something this cannot name at all.
---
--- The shapes are `require "m"`, `require("m")`, and `pcall(require, "m")`, which is
--- how an optional library is reached. `_G.require` names the same global operation.
--- A `require` that is a field of anything else -- the
--- checker looks up `env.globals.require` -- is a different name that happens to be
--- spelled the same, and is not one of these.
---
--- A `require` whose argument is not a literal is one this cannot follow, and a module
--- holding one could depend on anything, so the stamp covering it has to cover the
--- whole compiler. A module that knows better says so:
---
---     --@requires-dynamically nupp.runtime.provider.*
---     --@requires-dynamically nothing
---
--- The first names what it may load -- a trailing `.*` is every module under that
--- prefix -- and the second says the name it resolves is not code it is defined by.
--- Both are claims the module makes and this cannot check, which is why they are
--- written where the `require` is rather than inferred from it. Nupp source carries
--- these markers in a const string so they survive generation; ordinary comments
--- are removed before this graph reads the compiled Lua.
local function requiredBy(text: string, path: string): {string}, boolean, {string}
    local lexer = require("nupp.compiler.syntax.lexer")
    local tokens = lexer.lex(text, path)
    local names: {string} = {}
    local declared: {string} = {}
    local reflective = false
    for pattern in text:gmatch("@requires%-dynamically%s+([%w%.%*%-_]+)") do
        if pattern == "nothing" then
            reflective = true
        else
            declared[#declared + 1] = pattern
        end
    end
    for index = 1, #tokens do
        local token = tokens[index]
        local previous = tokens[index - 1]
        local following = tokens[index + 1]
        local globalRequire = previous
            and previous.text == "."
            and tokens[index - 2]
            and tokens[index - 2].text == "_G"
            and not (tokens[index - 3] and (tokens[index - 3].text == "." or tokens[index - 3].text == ":"))
        local callPrefix = globalRequire and tokens[index - 3] or previous
        if token.kind == "name"
            and token.text == "require"
            and (globalRequire or not (previous and (previous.text == "." or previous.text == ":")))
            and not (previous and previous.text == "function")
            and not (following and following.text == "=")
        then
            local literal = nil
            if following and following.kind == "string" then
                literal = following
            elseif following and following.text == "(" and tokens[index + 2] and tokens[index + 2].kind == "string" then
                literal = tokens[index + 2]
            elseif following
                and following.text == ","
                and callPrefix
                and callPrefix.text == "("
                and tokens[index + 2]
                and tokens[index + 2].kind == "string"
            then
                literal = tokens[index + 2]
            end
            if not literal then
                return names, not (reflective or #declared > 0), declared
            end
            -- On its own line: `chunk and pcall(chunk)` is one value, the way any
            -- call inside a larger expression is, so the string would arrive as nil.
            local chunk = loadstring("return " .. literal.text)
            if not chunk then
                return names, not (reflective or #declared > 0), declared
            end
            local ok, value = pcall(chunk)
            if not ok or type(value) ~= "string" then
                return names, not (reflective or #declared > 0), declared
            end
            names[#names + 1] = value as string
        end
    end

    return names, false, declared
end

--- Reads the graph of the running compiler, or nil when it cannot be had.
---
--- `cacheDir` is where the answer is kept between commands. Computing it lexes the
--- whole built tree, which is a tenth of a second and far too much to spend on every
--- command; the store makes it once per compiler. Passing no directory computes it in
--- this process, which is what a caller with nowhere to write does.
local function moduleGraph(cacheDir: string?, digest: function(string): string): fingerprint.ModuleGraph?
    if graphAttempted and (graphMemo == nil or cacheDir == nil or graphStoredIn[cacheDir]) then
        return graphMemo
    end
    graphAttempted = true
    local dir = compilerDir()
    -- A bundled compiler is one file with every module inside it, so there is no
    -- graph to read and nothing narrower than the whole of it to stamp with.
    if bundled() then
        return nil
    end
    -- `<root>/nupp/compiler` is where this file is, so the tree the module names are
    -- relative to is two directories above it.
    local root = dirname(dirname(dir))
    local store = nil
    if cacheDir then
        graphStoredIn[cacheDir] = true
        store = require(
            "nupp.compiler.project.store"
        ).openValue(join(cacheDir, "modulegraph.buf"), GRAPH_STAMP .. "\0" .. toolFingerprint(digest))
        local stored = store.value
        if type(stored) == "table" then
            graphMemo = stored as fingerprint.ModuleGraph

            return graphMemo
        end
        -- Computed already by a caller with nowhere to keep it.
        if graphMemo ~= nil then
            store.set(graphMemo)
            store.save()

            return graphMemo
        end
    end
    local graph: fingerprint.ModuleGraph = {files = {}, edges = {}, digests = {}, unknown = {}}
    local sources: {[string]: string} = {}
    -- Under `nupp/` rather than the whole tree the compiler was found in. Every module
    -- here is a `nupp.*` one, and listing the root meant whatever else happened to sit
    -- beside the compiler -- a project's own build output, in a development checkout --
    -- was read and digested for a graph it is not part of.
    for _, path in ipairs(listFiles(join(root, "nupp"))) do
        if path:match("%.lua$") then
            local name = moduleNameOf(root, path)
            local text = name and readFile(path) or nil
            if name and text then
                graph.files[name] = path
                graph.digests[name] = digest(text)
                sources[name] = text
            end
        end
    end
    for name, text in pairs(sources) do
        local required, unknown, declared = requiredBy(text, graph.files[name] or name)
        graph.unknown[name] = unknown
        local edges: {string} = {}
        local added: {[string]: boolean} = {}
        for _, required_name in ipairs(required) do
            if graph.files[required_name] and not added[required_name] then
                added[required_name] = true
                edges[#edges + 1] = required_name
            end
        end
        -- What a module said it may load, resolved against the tree the same way a
        -- literal is. A pattern naming nothing that exists has no local dependencies.
        for _, pattern in ipairs(declared) do
            local prefix = pattern:match("^(.+)%.%*$")
            if prefix then
                for candidate in pairs(graph.files) do
                    if candidate:sub(1, #prefix + 1) == prefix .. "." and not added[candidate] then
                        added[candidate] = true
                        edges[#edges + 1] = candidate
                    end
                end
            elseif graph.files[pattern] and not added[pattern] then
                added[pattern] = true
                edges[#edges + 1] = pattern
            end
        end
        table.sort(edges)
        graph.edges[name] = edges
    end
    graphMemo = graph
    if store then
        store.set(graph)
        store.save()
    end

    return graphMemo
end

--- Where the stores that answer about content rather than about a project belong.
---
--- Every entry in them is keyed by what it was computed from and stamped with the code
--- that computed it, so two projects sharing one directory can only hit each other's
--- entries when the answer is the same answer. `NUPP_CACHE_DIR` is how a run that makes
--- many small projects -- the test suite makes one per case -- says to keep them
--- together, rather than having each pay for what the last one worked out.
---
--- The build state is not one of these and is not moved: its records are keyed by
--- module name, so two projects sharing them would read each other's modules.
function fingerprint.sharedCacheDir(fallback: string?): string?
    local named = os.getenv("NUPP_CACHE_DIR")
    if named and named ~= "" then
        return named
    end

    return fallback
end

local subsystemMemo: {[string]: string} = {}

--- The digest of one part of the compiler: the named modules, and everything they
--- require, and nothing else.
---
--- What a stamp is for is saying that an answer kept from last time was computed by
--- code that has not changed. `toolFingerprint` answers that for the whole compiler,
--- which is true and far too strong: a header is the parser's answer, so editing the
--- code generator threw away every header in the project and made the next command
--- reparse all of it. This says which code an answer actually came from.
---
--- Falls back to the whole compiler whenever the graph cannot be read, whenever a named
--- module is not in it, and for a bundled compiler, which is one file. Every fallback
--- costs work that turns out to have been unnecessary and none of them changes an
--- answer.
function fingerprint.subsystemFingerprint(
    roots: {string},
    cacheDir: string?,
    contentDigest: (function(string): string)?
): string
    local digest = contentDigest or hash.digest
    local ordered: {string} = {}
    for index, name in ipairs(roots) do
        ordered[index] = name
    end
    table.sort(ordered)
    local memoKey = table.concat(ordered, "\0")
    local remembered = subsystemMemo[memoKey]
    if remembered then
        return remembered
    end
    local graph = moduleGraph(cacheDir, digest)
    local answer = nil
    if graph then
        local reached: {[string]: boolean} = {}
        local pending = {}
        for _, name in ipairs(ordered) do
            pending[#pending + 1] = name
        end
        local complete = true
        while #pending > 0 do
            local name = table.remove(pending)
            if not reached[name] then
                if not graph.digests[name] then
                    complete = false
                    break
                end
                if graph.unknown[name] then
                    complete = false
                    break
                end
                reached[name] = true
                for _, required in ipairs(graph.edges[name] or {}) do
                    pending[#pending + 1] = required
                end
            end
        end
        if complete then
            local parts = {}
            for name in pairs(reached) do
                parts[#parts + 1] = name .. "\0" .. (graph.digests[name] or "missing")
            end
            table.sort(parts)
            answer = digest(table.concat(parts, "\0"))
        end
    end
    answer = answer or toolFingerprint(digest)
    subsystemMemo[memoKey] = answer

    return answer as string
end

local declarationMemo: string? = nil

--- The digest of the declarations the compiler carries under `decls/`: the prelude,
--- the Lua surface, and the FFI and library declarations beside them.
---
--- A module is checked against these as much as against the checker, and they are
--- not modules, so no subsystem fingerprint reaches them. Stamped with the code
--- alone, a module's stored diagnostics went on being believed after the
--- declaration they were computed against had changed: every module in the project
--- kept reporting an argument that no longer failed to fit `table.sort`, while a
--- fresh file checked clean, until the store was deleted by hand.
---
--- The readers are parameters so a test can hand in declarations of its own; a
--- caller passing none reads what this compiler carries, once per process.
---
--- @param contentDigest the digest to stamp with, or the build's own
--- @param listDeclarations lists the carried files under a prefix, or the compiler's
--- @param readDeclaration reads one carried file by that spelling, or the compiler's
--- @return the digest of every carried declaration and its content
function fingerprint.declarationFingerprint(
    contentDigest: (function(string): string)?,
    listDeclarations: (function(string): {string})?,
    readDeclaration: (function(string): string?)?
): string
    local own = contentDigest == nil and listDeclarations == nil and readDeclaration == nil
    if own and declarationMemo ~= nil then
        return declarationMemo as string
    end
    local digest = contentDigest or hash.digest
    local list = listDeclarations or require("nupp.compiler.bundledlist").list
    local read = readDeclaration or require("nupp.compiler.bundled").source
    local parts = {}
    for _, relative in ipairs(list("/decls")) do
        parts[#parts + 1] = relative .. "\0" .. (read(relative) or "missing")
    end
    table.sort(parts)
    local answer = digest(table.concat(parts, "\0"))
    if own then
        declarationMemo = answer
    end

    return answer
end

fingerprint.hashFile = hashFile
fingerprint.hashFiles = hashFiles
fingerprint.toolFingerprint = toolFingerprint

export = fingerprint
