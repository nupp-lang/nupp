--[[
What the running compiler is, as a digest.

Every store the toolchain keeps between commands is stamped with the code that
computed what it holds, so an answer is believed only while that code is
unchanged. This is where those stamps come from: the digest of the whole
toolchain (`toolFingerprint`), of the part of it one answer came from
(`subsystemFingerprint`), and of the declarations it carries
(`declarationFingerprint`).

Reading and digesting a whole compiler tree costs about five milliseconds
(`nupp.compiler.hash`), which is why there is no modification-time shortcut here
and no need for one. A shortcut would only be able to make this cheaper by
making it wrong.
]]
module nupp.compiler.project.fingerprint

local hash = require("nupp.compiler.hash")
local fs = require("nupp.compiler.fs")

local join = fs.join
local dirname = fs.dirname
local readFile = fs.readFile
local listFiles = fs.listFiles

local fingerprint = {}

--- The content digest to use for cache keys, native where the host has one.
---
--- Byte for byte the answer `nupp.compiler.hash.digest` gives --
--- `tests/compiler/project/projecttest.lua` holds the two implementations to that --
--- and about two thousand times faster, because the portable one emulates XXH64's
--- 64-bit arithmetic over `uint32` halves and this one does not have to. A build puts
--- every source, every compiler file and every memoized value through it, so the
--- difference is seconds a command rather than a micro-optimization.
---
--- Resolved once. The running compiler cannot grow or lose an FFI while it runs,
--- and a portable `lua51` session has none to load: `native` false is how a
--- caller that knows it is building for one says so, and the `pcall` is for a
--- native host whose library is missing rather than for that.
local nativeDigestMemo: any = nil

function fingerprint.contentDigest(native: boolean?): function(string): string
    if native == false then
        return hash.digest
    end
    if nativeDigestMemo == nil then
        -- Named indirectly, so a portable bundle does not carry host services in
        -- for the sake of a branch it never takes.
        local ok, services = pcall(require, "nupp.compiler." .. "hostservices")
        local resolved = ok and services and services.hash and services.hash.digest or nil
        nativeDigestMemo = resolved or false
    end

    return nativeDigestMemo or hash.digest
end

local function hashFile(path: string, contentDigest: (function(string): string)?): string?
    local text = readFile(path)
    local digest = contentDigest or hash.digest

    return text and digest(text) or nil
end

local function hashFiles(files: {string}): string
    local parts = {}
    for _, path in ipairs(files) do
        parts[#parts + 1] = path .. "\0" .. (hashFile(path, hash.digest) or "missing")
    end

    return hash.digest(table.concat(parts, "\0"))
end

--- The compiler's own directory, `<root>/nupp/compiler`: this file sits in `project/`
--- below it.
local function compilerDir(): string
    local source = debug.getinfo(1, "S").source
    return dirname(source:match("^@(.*)[/\\]") or ".")
end

--- Whether the running compiler is one bundled file rather than a tree of modules.
---
--- Asked of this module's own chunk name: compiled to a tree it is `fingerprint.lua`,
--- and inside a bundle it is whatever the bundle was loaded as -- the stage-zero
--- compiler's own file, or the module's name for a chunk a binary dumped. Neither has a
--- module tree beside it to read, which is the only thing callers want to know.
---
--- Asked this way rather than by recognizing a directory, because where a stage zero
--- is kept is `scripts/toolchain`'s business and it has moved once already.
local function bundled(): boolean
    local source = debug.getinfo(1, "S").source
    return (source:match("[^/\\]*$") or "") ~= "fingerprint.lua"
end

-- The running compiler cannot change while it is running, so the answer is computed
-- once. Listing the tree shells out to `find`, and a build that asks twice was paying
-- for a second process to be told the same thing.
local toolFingerprintMemo = nil

local treeFilesMemo: {string}? = nil

local compiledFilesMemo: {string}? = nil
local compiledFiles: function(string): {string}
local moduleSources: {[string]: string} = {}
local moduleRequirements: {[string]: any} = {}

-- Every Lua file under the directory holding the compiler and the tools, listed
-- once: both fingerprints below read from it.
local function treeFiles(dir: string): {string}
    if treeFilesMemo == nil then
        local files: {string} = {}
        for _, path in ipairs(listFiles(dir)) do
            if path:match("%.lua$") then
                files[#files + 1] = path
            end
        end
        treeFilesMemo = files
    end

    return treeFilesMemo as {string}
end

local function relativeTo(dir: string, path: string): string
    if path:sub(1, #dir + 1) == dir .. "/" then
        return path:sub(#dir + 2)
    end

    return path
end

--- The identity of the VM image the compiler is running from, or nil when it is
--- not running from one.
---
--- An image is one artifact the way a bundle is, but its chunk names are the
--- source files it was lowered from rather than itself, so hashing "the bundle"
--- hashed this module's source and nothing else: every stamp on the VM named
--- one file, and an image rebuilt from an edited checker went on believing what
--- the old one had stored. Nor would the sources be the right answer -- an image
--- is installed explicitly and may be older than the checkout beside it. What
--- computed an answer is the image, so the stamp is the image's digest, which
--- the runtime answers for the image it started from.
---
--- A runtime too old to answer gets a stamp no other process shares: every
--- store misses, which costs time and never an answer.
local function vmImageIdentity(): string?
    if rawget(_G, "__nupp_load_image") == nil then
        return nil
    end
    local identify: any = rawget(_G, "__nupp_image_identity")
    local ok: boolean = false
    local identity: any = nil
    if identify ~= nil then
        ok, identity = pcall(identify)
    end
    if ok and type(identity) == "string" and identity ~= "" then
        return "image\0" .. identity
    end

    return table.concat(
        {"unidentified", tostring(fs.processId() or 0), tostring(os.time()), tostring(os.clock()), tostring({})},
        "\0"
    )
end

local function runtimeParts(root: string, files: {string}, digest: function(string): string): {string}
    local parts = {}
    for _, path in ipairs(files) do
        local relative = relativeTo(root, path)
        if not relative:match("^nupp/compiler/") and not relative:match("^nupp/tools/") then
            parts[#parts + 1] = relative .. "\0" .. (hashFile(path, digest) or "missing")
        end
    end
    table.sort(parts)

    return parts
end

local function toolFingerprint(contentDigest: (function(string): string)?): string
    if toolFingerprintMemo then
        return toolFingerprintMemo
    end
    local digest = contentDigest or hash.digest
    local image = bundled() and vmImageIdentity() or nil
    if image ~= nil then
        toolFingerprintMemo = digest("nupp-vm\0" .. image)

        return toolFingerprintMemo
    end
    -- The toolchain is two trees, the compiler and the tools built on it, and both
    -- decide what a build writes: `nupp.tools.build` is where an artifact is put
    -- together. Named from the directory holding both.
    local dir = dirname(compilerDir())
    local files: {string} = {}
    if bundled() then
        files = {(debug.getinfo(1, "S").source:gsub("^@", ""))}
    else
        for _, path in ipairs(treeFiles(dir)) do
            local relative = relativeTo(dir, path)
            if relative:match("^compiler/") or relative:match("^tools/") then
                files[#files + 1] = path
            end
        end
    end
    -- Named relative to that directory, so the answer describes the compiler rather
    -- than where it was found. `compilerDir` reports whatever
    -- `package.path` was written as, and the launcher writes an absolute path where a
    -- test harness writes a relative one -- so hashing the paths as given made one
    -- compiler fingerprint two ways depending on how it was started, and anything keyed
    -- on it threw away the other's work every time the two alternated.
    local parts = {}
    for _, path in ipairs(files) do
        local relative = path
        if path:sub(1, #dir + 1) == dir .. "/" then
            relative = path:sub(#dir + 2)
        end
        parts[#parts + 1] = relative .. "\0" .. (hashFile(path, digest) or "missing")
    end
    table.sort(parts)
    toolFingerprintMemo = digest(table.concat(parts, "\0"))

    return toolFingerprintMemo
end

local besideToolMemo: string? = nil

-- The graph's index can be reused while its compiler-owned seed files match.
-- Public files and resolutions are validated from the kept graph before reuse.
local function privateGraphFingerprint(digest: function(string): string): string
    local dir = dirname(compilerDir())
    local root = dirname(dir)
    local parts = runtimeParts(root, treeFiles(dir), digest)

    return digest(toolFingerprint(digest) .. "\0" .. digest(table.concat(parts, "\0")))
end

--- The digest of the runtime dependencies the module graph also covers.
--- This includes public modules outside the `nupp` directory.
---
--- The graph used to be stamped with `toolFingerprint` alone, which reads only the
--- compiler and the tools. An edit to the runtime then kept serving the graph from
--- before it, with the old file's digest, and every subsystem stamp reaching that
--- module described code that was no longer there.
local function besideToolFingerprint(digest: function(string): string): string
    if besideToolMemo then
        return besideToolMemo as string
    end
    local dir = dirname(compilerDir())
    local root = dirname(dir)
    local parts = runtimeParts(root, compiledFiles(dir), digest)
    besideToolMemo = digest(table.concat(parts, "\0"))

    return besideToolMemo as string
end

--- The compiler, its tools, and their resolved implementation dependencies.
--- A subsystem whose dependencies cannot be narrowed falls back to this digest.
local function graphFingerprint(contentDigest: (function(string): string)?): string
    local digest = contentDigest or hash.digest
    if bundled() then
        return toolFingerprint(digest)
    end

    return digest(toolFingerprint(digest) .. "\0" .. besideToolFingerprint(digest))
end

--- What the compiler's own modules are, and which of them each one requires.
---
--- Read off the built tree by the compiler's own lexer, so a `require` written inside a
--- string -- `explain` and `gen` both compose source text containing one -- is a string
--- and not an edge. A `require` whose argument is not a literal cannot be followed, so
--- its module is marked incomplete. Only a subsystem that reaches that module falls
--- back to the whole compiler: an unrelated runtime plugin must not erase every narrow
--- compiler stamp.
type fingerprint.ModuleGraph = {
    root: string,

    --- Module name -> the file it lives in, relative to the tree root; on the VM,
    --- where the modules live in one image, the module's own name.
    files: {[string]: string},
    requirements: {[string]: {
        required: {string},
        declared: {string}
    }},

    --- Module name -> the modules it requires.
    edges: {[string]: {string}},

    --- Module name -> the digest of its file.
    digests: {[string]: string},

    --- Modules containing a computed require the static graph cannot follow.
    unknown: {[string]: boolean}
}

--- Bumped when an entry stops decoding into what the reader expects.
local GRAPH_STAMP = "modules/4"

local graphMemo: fingerprint.ModuleGraph? = nil

--- Whether this process has read or computed the graph, and which stores have
--- been given it. A caller with nowhere to write computes it in this process,
--- which must not stop the next caller that has somewhere from keeping it for
--- the next command; keyed by directory so every store asked for gets it once.
local graphAttempted = false

local graphStoredIn: {[string]: boolean} = {}

--- Whether a decoded graph has the complete shape traversal relies on.
---
--- The value store verifies its envelope, but its payload is still cache data.
--- A decodable table with a missing map or a broken edge is a cache miss, not a
--- reason for a check or build to fail while traversing it.
local function stringList(value: any): boolean
    if type(value) ~= "table" then
        return false
    end
    local count: integer = 0
    for index, item in pairs(value) do
        if type(index) ~= "number" or index < 1 or index ~= math.floor(index) or type(item) ~= "string" then
            return false
        end
        count = count + 1
    end
    for index = 1, count do
        if type(value[index]) ~= "string" then
            return false
        end
    end

    return true
end

local function validGraph(value: any): boolean
    if type(value) ~= "table"
        or type(value.root) ~= "string"
        or type(value.requirements) ~= "table"
        or type(value.files) ~= "table"
        or type(value.edges) ~= "table"
        or type(value.digests) ~= "table"
        or type(value.unknown) ~= "table"
    then
        return false
    end
    for name, path in pairs(value.files) do
        if type(name) ~= "string"
            or type(path) ~= "string"
            or type(value.digests[name]) ~= "string"
            or type(value.edges[name]) ~= "table"
            or type(value.unknown[name]) ~= "boolean"
            or type(value.requirements[name]) ~= "table"
            or not stringList(value.requirements[name].required)
            or not stringList(value.requirements[name].declared)
        then
            return false
        end
        local count = 0
        for index, required in pairs(value.edges[name]) do
            if type(index) ~= "number"
                or index < 1
                or index ~= math.floor(index)
                or type(required) ~= "string"
                or type(value.files[required]) ~= "string"
            then
                return false
            end
            count = count + 1
        end
        for index = 1, count do
            if type(value.edges[name][index]) ~= "string" then
                return false
            end
        end
    end
    for name in pairs(value.digests) do
        if type(name) ~= "string" or type(value.files[name]) ~= "string" then
            return false
        end
    end
    for name in pairs(value.edges) do
        if type(name) ~= "string" or type(value.files[name]) ~= "string" then
            return false
        end
    end
    for name in pairs(value.requirements) do
        if type(name) ~= "string" or type(value.files[name]) ~= "string" then
            return false
        end
    end
    for name in pairs(value.unknown) do
        if type(name) ~= "string" or type(value.files[name]) ~= "string" then
            return false
        end
    end

    return true
end

--- The module name a file under `root` provides: the path, without its extension, with
--- the separators spelled as dots. `init` is how a directory names itself.
local function moduleNameOf(root: string, path: string): string?
    if path:sub(1, #root + 1) ~= root .. "/" then
        return nil
    end
    local relative = path:sub(#root + 2):gsub("%.lua$", "")
    local name = relative:gsub("/", ".")
    name = name:gsub("%.init$", "")

    return name ~= "" and name or nil
end

--- The modules `text` requires, what it may require dynamically, and whether it
--- requires something this cannot name at all.
---
--- The shapes are `require "m"`, `require("m")`, and `pcall(require, "m")`, which is
--- how an optional library is reached. `_G.require` names the same global operation.
--- A `require` that is a field of anything else -- the
--- checker looks up `env.globals.require` -- is a different name that happens to be
--- spelled the same, and is not one of these.
---
--- A `require` whose argument is not a literal is one this cannot follow, and a module
--- holding one could depend on anything, so the stamp covering it has to cover the
--- whole compiler. A module that knows better says so:
---
---     --@requires-dynamically nupp.runtime.provider.*
---     --@requires-dynamically nothing
---
--- The first names what it may load -- a trailing `.*` is every module under that
--- prefix -- and the second says the name it resolves is not code it is defined by.
--- Both are claims the module makes and this cannot check, which is why they are
--- written where the `require` is rather than inferred from it. Nupp source carries
--- these markers in a const string so they survive generation; ordinary comments
--- are removed before this graph reads the compiled Lua.
local function requiredBy(text: string, path: string): {string}, boolean, {string}
    local lexer = require("nupp.compiler.syntax.lexer")
    -- This generated startup guard initializes a service; it is not an import
    -- from the compiler subsystem being fingerprinted. Authored imports remain.
    local guard = 'if not package.loaded["debug.log"] then require("debug.log") end;'
    local prelude = text:find("local __nupp=_G.nupp or ", 1, true)
    if prelude then
        local start = text:find(guard, prelude, true)
        local newline = text:find("\n", 1, true)
        if start and (not newline or start < newline) then
            text = text:sub(1, start - 1) .. text:sub(start + #guard)
        end
    end
    local tokens = lexer.lex(text, path)
    local names: {string} = {}
    local declared: {string} = {}
    local reflective = false
    local unknown = false
    for pattern in text:gmatch("@requires%-dynamically%s+([%w%.%*%-_]+)") do
        if pattern == "nothing" then
            reflective = true
        else
            declared[#declared + 1] = pattern
        end
    end
    for index = 1, #tokens do
        local token = tokens[index]
        local previous = tokens[index - 1]
        local following = tokens[index + 1]
        local globalRequire = previous
            and previous.text == "."
            and tokens[index - 2]
            and tokens[index - 2].text == "_G"
            and not (tokens[index - 3] and (tokens[index - 3].text == "." or tokens[index - 3].text == ":"))
        local callPrefix = globalRequire and tokens[index - 3] or previous
        if token.kind == "name"
            and token.text == "require"
            and (globalRequire or not (previous and (previous.text == "." or previous.text == ":")))
            and not (previous and previous.text == "function")
            and not (following and following.text == "=")
        then
            local literal = nil
            if following and following.kind == "string" then
                literal = following
            elseif following and following.text == "(" and tokens[index + 2] and tokens[index + 2].kind == "string" then
                literal = tokens[index + 2]
            elseif following
                and following.text == ","
                and callPrefix
                and callPrefix.text == "("
                and tokens[index + 2]
                and tokens[index + 2].kind == "string"
            then
                literal = tokens[index + 2]
            end
            if not literal then
                unknown = unknown or not (reflective or #declared > 0)
            else
                -- On its own line: `chunk and pcall(chunk)` is one value, the way any
                -- call inside a larger expression is, so the string would arrive as
                -- nil.
                local chunk = loadstring("return " .. literal.text)
                if not chunk then
                    unknown = unknown or not (reflective or #declared > 0)
                else
                    local ok, value = pcall(chunk)
                    if not ok or type(value) ~= "string" then
                        unknown = unknown or not (reflective or #declared > 0)
                    else
                        names[#names + 1] = value as string
                    end
                end
            end
        end
    end

    return names, unknown, declared
end

local function validName(name: string): boolean
    return name:match("^[%w_%.%-]+$") ~= nil
        and not name:find("..", 1, true)
        and name:sub(1, 1) ~= "."
        and name:sub(-1) ~= "."
end

local function resolveModule(root: string, name: string): (string?, string?)
    if not validName(name) then
        return nil
    end
    local relative = name:gsub("%.", "/")
    for _, suffix in ipairs({".lua", "/init.lua"}) do
        local path = join(root, relative .. suffix)
        local source = moduleSources[path] or readFile(path)
        if source ~= nil then
            return path, source
        end
    end

    return nil
end

-- Start in the compiler-owned namespace, then follow resolved dependencies. A
-- recursive walk of the output root would also collect application builds and caches.
compiledFiles = function(dir: string): {string}
    if compiledFilesMemo ~= nil then
        return compiledFilesMemo as {string}
    end
    local root = dirname(dir)
    local files: {string} = {}
    local seen: {[string]: boolean} = {}

    local function add(name: string): nil
        if seen[name] then
            return
        end
        local path, source = resolveModule(root, name)
        if path ~= nil and source ~= nil then
            seen[name] = true
            moduleSources[path] = source
            files[#files + 1] = path
        end
    end

    for _, path in ipairs(treeFiles(dir)) do
        local name = moduleNameOf(root, path)
        if name then
            add(name)
        end
    end
    local cursor: integer = 1
    while cursor <= #files do
        local path = files[cursor]
        cursor = cursor + 1
        local required, unknown, declared = requiredBy(moduleSources[path] as string, path)
        moduleRequirements[path] = {required = required, unknown = unknown, declared = declared}
        for _, name in ipairs(required) do
            add(name)
        end
        for _, pattern in ipairs(declared) do
            local prefix = pattern:match("^(.+)%.%*$")
            if prefix and validName(prefix) then
                local directory = join(root, (prefix:gsub("%.", "/")))
                for _, child in ipairs(listFiles(directory)) do
                    if child:match("%.lua$") then
                        local name = moduleNameOf(root, child)
                        if name then
                            add(name)
                        end
                    end
                end
            else
                add(pattern)
            end
        end
    end
    table.sort(files)
    compiledFilesMemo = files

    return files
end

-- Reuse the recorded discovery index without lexing unchanged modules. Resolving
-- the recorded imports also detects newly available files and namespace members.
local function currentGraph(graph: fingerprint.ModuleGraph, root: string, digest: function(string): string): boolean
    local paths: {string} = {}
    local resolved: {[string]: string} = {}
    for name, previous in pairs(graph.files) do
        local path, source = resolveModule(root, name)
        if path == nil
            or source == nil
            or relativeTo(root, path) ~= relativeTo(graph.root, previous)
            or digest(source) ~= graph.digests[name]
        then
            return false
        end
        resolved[name] = path
        moduleSources[path] = source
        paths[#paths + 1] = path
    end
    for _, metadata in pairs(graph.requirements) do
        for _, name in ipairs(metadata.required) do
            local path = resolveModule(root, name)
            if path ~= nil and graph.files[name] == nil then
                return false
            end
        end
        for _, pattern in ipairs(metadata.declared) do
            local prefix = pattern:match("^(.+)%.%*$")
            if prefix and validName(prefix) then
                local directory = join(root, (prefix:gsub("%.", "/")))
                for _, path in ipairs(listFiles(directory)) do
                    if path:match("%.lua$") then
                        local name = moduleNameOf(root, path)
                        if name ~= nil and graph.files[name] == nil then
                            return false
                        end
                    end
                end
            elseif not prefix then
                local path = resolveModule(root, pattern)
                if path ~= nil and graph.files[pattern] == nil then
                    return false
                end
            end
        end
    end
    for name, path in pairs(resolved) do
        local metadata = graph.requirements[name] as {
            required: {string},
            declared: {string}
        }
        moduleRequirements[
            path
        ] = {required = metadata.required, declared = metadata.declared, unknown = graph.unknown[name]}
    end
    table.sort(paths)
    graph.files, graph.root = resolved, root
    compiledFilesMemo = paths

    return true
end

--- The graph of the VM image the compiler is running from, as the runtime
--- describes it, or nil when the runtime cannot.
---
--- Read off the image rather than the sources beside it, for the reason
--- `vmImageIdentity` gives: an installed image may be older than the checkout,
--- and a stamp computed from newer sources would have that image trust, and
--- write, answers under the new code's name. Each module's digest is of its
--- lowered code with every image-wide index made stable, so an edit to one
--- module moves no other module's digest. Its edges are its literal requires,
--- the modules whose code it names, and what an `@requires-dynamically` marker
--- declares, and a computed require is accounted the way `requiredBy` accounts
--- one, so the two graphs follow one rule.
---
--- A runtime without the description answers nil, and every subsystem falls
--- back to the image's identity.
local function vmModuleGraph(): fingerprint.ModuleGraph?
    local describe: any = rawget(_G, "__nupp_image_modules")
    if describe == nil then
        return nil
    end
    local ok, described = pcall(describe)
    if not ok
        or type(described) ~= "table"
        or type(described.digests) ~= "table"
        or type(described.edges) ~= "table"
        or type(described.unknown) ~= "table"
    then
        return nil
    end
    local graph: fingerprint.ModuleGraph = {
        root = "",
        files = {},
        requirements = {},
        edges = {},
        digests = {},
        unknown = {}
    }
    for name, digest in pairs(described.digests) do
        if type(name) == "string" and type(digest) == "string" then
            graph.files[name] = name
            graph.digests[name] = digest
            graph.unknown[name] = described.unknown[name] == true
            local edges: {string} = {}
            local listed: any = described.edges[name]
            if type(listed) == "table" then
                for index, required in ipairs(listed) do
                    edges[index] = required
                end
            end
            graph.edges[name] = edges
            graph.requirements[name] = {required = edges, declared = {}}
        end
    end

    return validGraph(graph) and graph or nil
end

--- The graph of the built tree under `root`: every module's file, its digest, and
--- what `requiredBy` reads it to require.
local function treeModuleGraph(root: string, digest: function(string): string): fingerprint.ModuleGraph
    local graph: fingerprint.ModuleGraph = {
        root = root,
        files = {},
        requirements = {},
        edges = {},
        digests = {},
        unknown = {}
    }
    local sources: {[string]: string} = {}
    -- Public dependencies share this graph without making unrelated output trees
    -- part of the compiler. The same resolved closure stamps the kept graph.
    for _, path in ipairs(compiledFiles(join(root, "nupp"))) do
        if path:match("%.lua$") then
            local name = moduleNameOf(root, path)
            local text = name and moduleSources[path] or nil
            if name and text then
                graph.files[name] = path
                graph.digests[name] = digest(text)
                sources[name] = text
            end
        end
    end
    for name, text in pairs(sources) do
        local metadata = moduleRequirements[graph.files[name] as string]
        local required, declared = metadata.required, metadata.declared
        graph.requirements[name] = {required = required, declared = declared}
        graph.unknown[name] = metadata.unknown
        local edges: {string} = {}
        local added: {[string]: boolean} = {}
        for _, required_name in ipairs(required) do
            if graph.files[required_name] and not added[required_name] then
                added[required_name] = true
                edges[#edges + 1] = required_name
            end
        end
        -- What a module said it may load, resolved against the tree the same way a
        -- literal is. A pattern naming nothing that exists has no local dependencies.
        for _, pattern in ipairs(declared) do
            local prefix = pattern:match("^(.+)%.%*$")
            if prefix then
                for candidate in pairs(graph.files) do
                    if candidate:sub(1, #prefix + 1) == prefix .. "." and not added[candidate] then
                        added[candidate] = true
                        edges[#edges + 1] = candidate
                    end
                end
            elseif graph.files[pattern] and not added[pattern] then
                added[pattern] = true
                edges[#edges + 1] = pattern
            end
        end
        table.sort(edges)
        graph.edges[name] = edges
    end

    return graph
end

--- Reads the graph of the running compiler, or nil when it cannot be had.
---
--- `cacheDir` is where the answer is kept between commands. Computing it lexes the
--- whole built tree, which is a tenth of a second and far too much to spend on every
--- command; the store makes it once per compiler. Passing no directory computes it in
--- this process, which is what a caller with nowhere to write does. `readOnly` reads
--- a kept graph but never writes one, for a process that must not publish to stores
--- another process owns.
local function moduleGraph(
    cacheDir: string?,
    digest: function(string): string,
    readOnly: boolean?
): fingerprint.ModuleGraph?
    if graphAttempted and (graphMemo == nil or cacheDir == nil or graphStoredIn[cacheDir]) then
        return graphMemo
    end
    graphAttempted = true
    local dir = compilerDir()
    -- A bundled compiler is one file with every module inside it, so there is no
    -- graph to read and nothing narrower than the whole of it to stamp with --
    -- unless it is a VM image whose runtime can describe the modules it holds.
    local image = bundled() and vmImageIdentity() ~= nil
    if bundled() and not (image and rawget(_G, "__nupp_image_modules") ~= nil) then
        return nil
    end
    -- `<root>/nupp/compiler` is where this file is, so the tree the module names are
    -- relative to is two directories above it.
    local root = dirname(dirname(dir))
    local store = nil
    if cacheDir then
        if not readOnly then
            graphStoredIn[cacheDir] = true
        end
        store = require(
            "nupp.compiler.project.store"
        ).openValue(
            join(cacheDir, "modulegraph.buf"),
            GRAPH_STAMP .. "\0" .. (image and graphFingerprint(digest) or privateGraphFingerprint(digest))
        )
        local stored = store.value
        if validGraph(stored) and (image or currentGraph(stored as fingerprint.ModuleGraph, root, digest)) then
            graphMemo = stored as fingerprint.ModuleGraph

            return graphMemo
        end
        -- Computed already by a caller with nowhere to keep it.
        if graphMemo ~= nil then
            if not readOnly then
                store.set(graphMemo)
                store.save()
            end

            return graphMemo
        end
    end
    local graph: fingerprint.ModuleGraph? = nil
    if image then
        graph = vmModuleGraph()
    else
        graph = treeModuleGraph(root, digest)
    end
    if graph == nil then
        return nil
    end
    graphMemo = graph
    if store and not readOnly then
        store.set(graph)
        store.save()
    end

    return graphMemo
end

--- Where the stores that answer about content rather than about a project belong.
---
--- Every entry in them is keyed by what it was computed from and stamped with the code
--- that computed it, so two projects sharing one directory can only hit each other's
--- entries when the answer is the same answer. `NUPP_CACHE_DIR` is how a run that makes
--- many small projects -- the test suite makes one per case -- says to keep them
--- together, rather than having each pay for what the last one worked out.
---
--- The build state is not one of these and is not moved: its records are keyed by
--- module name, so two projects sharing them would read each other's modules.
function fingerprint.sharedCacheDir(fallback: string?): string?
    local named = os.getenv("NUPP_CACHE_DIR")
    if named and named ~= "" then
        return named
    end

    return fallback
end

local subsystemMemo: {[string]: string} = {}

--- The digest of a part of the compiler: the named modules, and everything they
--- require, and nothing else.
---
--- What a stamp is for is saying that an answer kept from last time was
--- computed by code that has not changed. `toolFingerprint` returns that for
--- the whole compiler, which is true and far too strong: a header is the
--- parser's answer, so editing the code generator threw away every header in
--- the project and made the next command reparse all of it. This says which
--- code an answer actually came from.
---
--- Falls back to the whole compiler whenever the graph cannot be read, whenever a named
--- module is not in it, and for a bundled compiler, which is one file. On the VM the
--- graph is the running image's, and the whole compiler is that image. Every fallback
--- costs work that turns out to have been unnecessary and none of them changes an
--- answer.
---
--- `readOnly` reads the kept module graph without writing one back.
function fingerprint.subsystemFingerprint(
    roots: {string},
    cacheDir: string?,
    contentDigest: (function(string): string)?,
    readOnly: boolean?
): string
    local digest = contentDigest or hash.digest
    local ordered: {string} = {}
    for index, name in ipairs(roots) do
        ordered[index] = name
    end
    table.sort(ordered)
    local memoKey = table.concat(ordered, "\0")
    local remembered = subsystemMemo[memoKey]
    if remembered then
        return remembered
    end
    local graph = moduleGraph(cacheDir, digest, readOnly)
    local answer = nil
    if graph then
        local reached: {[string]: boolean} = {}
        local pending = {}
        for _, name in ipairs(ordered) do
            pending[#pending + 1] = name
        end
        local complete = true
        while #pending > 0 do
            local name = table.remove(pending)
            if not reached[name] then
                if not graph.digests[name] then
                    complete = false
                    break
                end
                if graph.unknown[name] then
                    complete = false
                    break
                end
                reached[name] = true
                for _, required in ipairs(graph.edges[name] or {}) do
                    pending[#pending + 1] = required
                end
            end
        end
        if complete then
            local parts = {}
            for name in pairs(reached) do
                parts[#parts + 1] = name .. "\0" .. (graph.digests[name] or "missing")
            end
            table.sort(parts)
            answer = digest(table.concat(parts, "\0"))
        end
    end
    -- The whole of what the graph covers, when it cannot say which part: the
    -- compiler and tools alone would miss an edit to the runtime beside them.
    answer = answer or graphFingerprint(digest)
    subsystemMemo[memoKey] = answer

    return answer as string
end

local declarationMemo: string? = nil

--- The digest of the declarations the compiler carries under `decls/`: the prelude,
--- the Lua surface, and the FFI and library declarations beside them.
---
--- A module is checked against these as much as against the checker, and they are
--- not modules, so no subsystem fingerprint reaches them. Stamped with the code
--- alone, a module's stored diagnostics went on being believed after the
--- declaration they were computed against had changed: every module in the project
--- kept reporting an argument that no longer failed to fit `table.sort`, while a
--- fresh file checked clean, until the store was deleted by hand.
---
--- The readers are parameters so a test can hand in declarations of its own; a
--- caller passing none reads what this compiler carries, once per process.
---
--- @param contentDigest the digest to stamp with, or the build's own
--- @param listDeclarations lists the carried files under a prefix, or the compiler's
--- @param readDeclaration reads one carried file by that spelling, or the compiler's
--- @return the digest of every carried declaration and its content
function fingerprint.declarationFingerprint(
    contentDigest: (function(string): string)?,
    listDeclarations: (function(string): {string})?,
    readDeclaration: (function(string): string?)?
): string
    local own = contentDigest == nil and listDeclarations == nil and readDeclaration == nil
    if own and declarationMemo ~= nil then
        return declarationMemo as string
    end
    local digest = contentDigest or hash.digest
    local list = listDeclarations or require("nupp.compiler.bundledlist").list
    local read = readDeclaration or require("nupp.compiler.bundled").source
    local parts = {}
    for _, relative in ipairs(list("/decls")) do
        parts[#parts + 1] = relative .. "\0" .. (read(relative) or "missing")
    end
    table.sort(parts)
    local answer = digest(table.concat(parts, "\0"))
    if own then
        declarationMemo = answer
    end

    return answer
end

--- The variable naming the interpreter a VM compiler runs on.
const RUNTIME_IDENTITY_VARIABLE = "NUPP_VM_RUNTIME_ID"

--- The identity of the interpreter running this compiler, or "" when nothing
--- named one.
---
--- What a lowering comes out as is decided by the code that lowers, which an
--- image's digests name, and by the interpreter executing that code: the
--- Nupp-authored core moves under the same image. The running process cannot
--- digest its own runtime the way it names its image, and the one it would
--- digest is the wrong answer anyway -- linking a generation's compiled code
--- into its runtime changes the bytes and not what it computes. So the caller
--- that chose the runtime names it: `bin/nupp` from the installed generation,
--- and `scripts/vm-cli` for each emit it starts.
function fingerprint.runtimeidentity(): string
    return os.getenv(RUNTIME_IDENTITY_VARIABLE) or ""
end

fingerprint.hashFile = hashFile
fingerprint.hashFiles = hashFiles
fingerprint.toolFingerprint = toolFingerprint
fingerprint.graphFingerprint = graphFingerprint

export = fingerprint
