--[[
The sealed standard indexed-view families, described once for checking, proofs and
generation. Source metamethod names type the operators; this descriptor is the
stronger compiler-owned fact connecting length, indexing and physical storage.
]]
module nupp.compiler.types.indexedviews

local T = require("nupp.compiler.types")

local type Type = T.Type

export record Descriptor
    adapter: 'span' | 'soa'
    element: Type
    writable: boolean
    fixedCount: Type?
    nominal: Type
end

export record Producer
    kind: 'carray' | 'fixed-carray' | 'string' | 'heap' | 'soa' | 'buffer'
    descriptor: Descriptor
end

export function describe(t: Type): Descriptor?
    local raw = T.unwrapOwnership(t)
    if raw.tag == "intersection" then
        for _, member in ipairs(raw.members) do
            local found = describe(member)
            if found then
                return found
            end
        end
        return nil
    end
    if raw.tag ~= "nominal" then
        return nil
    end

    local nominal = raw as T.Nominal
    local origin = (nominal.origin or nominal) as T.Nominal
    local moduleName = origin.moduleName or nominal.moduleName or origin.sealedModule
    local name = origin.name
    local args = nominal.typeArgs or {}
    local element = args[1]
    if not element then
        return nil
    end

    if (moduleName == "nupp.mem.span")
        and (name == "Span" or name == "FixedSpan" or name == "WriteSpan" or name == "FixedWriteSpan")
    then
        local layout = nominal.constArgs and nominal.constArgs[1] or nil
        if (name == "Span" or name == "WriteSpan")
            and layout
            and (layout.tag ~= "constLiteral" or (layout.value ~= "packed" and layout.value ~= "columnar"))
        then
            return nil
        end
        return Descriptor(
            adapter = (name == "Span" or name == "WriteSpan")
            and layout
            and layout.tag == "constLiteral"
            and layout.value == "columnar"
            and "soa"
            or "span",
            element = element,
            writable = name == "WriteSpan" or name == "FixedWriteSpan",
            fixedCount = (name == "FixedSpan" or name == "FixedWriteSpan") and args[2] or nil,
            nominal = nominal
        )
    end

    return nil
end

--- The element type of a `bytes.span` Span, FixedSpan, WriteSpan or
--- FixedWriteSpan nominal, and nil for anything else. Strict where `describe`
--- is permissive: no ownership unwrapping, no intersection walk, and only the
--- span module's own families answer.
export function spanElement(t: Type): Type?
    if t.tag ~= "nominal" then
        return nil
    end
    local nominal = t as T.Nominal
    local origin = (nominal.origin or nominal) as T.Nominal
    if origin.moduleName ~= "nupp.mem.span" then
        return nil
    end
    if origin.name ~= "Span"
        and origin.name ~= "FixedSpan"
        and origin.name ~= "WriteSpan"
        and origin.name ~= "FixedWriteSpan"
    then
        return nil
    end

    local descriptor = describe(t)

    return descriptor and descriptor.adapter == "span" and descriptor.element or nil
end

local SPAN_PRODUCERS: {
    [string]: 'carray' | 'fixed-carray' | 'string'
} = {
    fromCarray = "carray",
    writeCarray = "carray",
    fromcarray = "carray",
    writecarray = "carray",
    fromFixedCarray = "fixed-carray",
    writeFixedCarray = "fixed-carray",
    fromfixedcarray = "fixed-carray",
    writefixedcarray = "fixed-carray",
    fromString = "string",
    fromstring = "string",
}

--- Describes a sealed standard module function which creates a root view.
--- The call checker supplies the already-resolved export identity. A matching
--- source name alone is deliberately insufficient.
export function exportProducer(moduleName: string, member: string, result: Type): Producer?
    if moduleName ~= "nupp.mem.span" and moduleName ~= "bytes.span" then
        return nil
    end
    local descriptor = describe(result)
    if not descriptor then
        return nil
    end
    local kind = SPAN_PRODUCERS[member]
    if not kind then
        return nil
    end

    return Producer(kind = kind, descriptor = descriptor)
end

--- Describes root views borrowed from the sealed standard owners. Returning a
--- standard view is not enough: both the owner module and member identity are
--- required before generation may reach the private physical representation.
export function methodProducer(receiver: Type, member: string, result: Type): Producer?
    local raw = T.unwrapOwnership(receiver)
    if raw.tag ~= "nominal" then
        return nil
    end
    local nominal = raw as T.Nominal
    local origin = (nominal.origin or nominal) as T.Nominal
    local moduleName = origin.moduleName or nominal.moduleName or origin.sealedModule
    local kind: 'carray' | 'fixed-carray' | 'string' | 'heap' | 'soa' | 'buffer'
    if moduleName == "nupp.io.internal.bytes" and origin.name == "Buffer" and member == "span" then
        kind = "buffer"
    elseif origin.name == "Array" and (member == "read" or member == "write") then
        if moduleName == "nupp.array" then
            local view = describe(result)
            if not view then
                return nil
            end
            kind = view.adapter == "soa" and "soa" or "heap"
        else
            return nil
        end
    else
        return nil
    end
    local descriptor = describe(result)
    if not descriptor then
        return nil
    end

    return Producer(kind = kind, descriptor = descriptor)
end

--- A layout parameter must be concrete before an indexed operation can select its ABI.
export function unknownLayout(t: Type): boolean
    local raw = T.unwrapOwnership(t)
    if raw.tag ~= "nominal" then
        return false
    end
    local nominal = raw as T.Nominal
    local origin = (nominal.origin or nominal) as T.Nominal
    if origin.moduleName ~= "nupp.mem.span" or (origin.name ~= "Span" and origin.name ~= "WriteSpan") then
        return false
    end

    return describe(t) == nil
end
