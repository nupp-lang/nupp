module nupp.compiler.types.predicate

--[[
A `where` refinement, as data rather than as a source spelling.

A declaration's `where` clause names the runtime test that decides whether a
value is one of these. Two very different readers need it: the checker, which
validates it against the declaration's own fields, and the generator, which
compiles `x is T` into it. Handing the generator an expression tree, or worse a
piece of source text to resolve again, is how a spelling ends up being resolved
twice and disagreeing, the mistake `TODO.md` records for cleanups.

So the clause is read once, into a small tree of plain data whose only free
variable is the subject. Nothing in it needs a scope: a path is a list of field
names, a literal is a Lua literal, and the operators are the handful that a
runtime test is built from. That travels between modules on the nominal, the way
metamethod contracts already do, and renders to Lua without knowing anything
about where it came from.

The subset is deliberately small. A predicate has to be evaluable wherever `is`
is written, cheap enough to inline, and free of side effects, which rules out
calls, arithmetic and anything reaching outside the subject.
]]

local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")

local predicate = {}

--- One node of a refinement. `op` says which of the shapes this is; the fields a shape
--- does not use are absent.
record predicate.Node
    --- `and`, `or`, `not`, `len`, `integral`, `cmp`, `truthy`, `typeis`, or `const`.
    op: string

    --- Operands, for `and`, `or`, `not` and `len`.
    ---
    --- `len` has one, and applies it to the byte length of what its path names rather
    --- than to the value there. It is the one accessor in the subset, admitted because
    --- `#` on a string is total, allocation-free and as cheap to inline as a
    --- comparison -- the three properties that keep `is` free wherever it is written.
    a: predicate.Node?

    b: predicate.Node?

    --- The comparison, for `cmp`: one of `==`, `~=`, `<`, `<=`, `>`, `>=`.
    cmp: string?

    --- Field names from the subject, outermost first. Empty means the subject.
    path: {string}?

    --- The right-hand literal, already written the way Lua spells it.
    literal: string?

    --- The same literal as a value, so a declared literal type can be compared against
    --- it without parsing the spelling back.
    constant: any

    --- What `type()` must answer, for `typeis`.
    luaType: string?

    --- The value, for `const`.
    value: boolean?
end

local COMPARISONS = {
    ["=="] = true,
    ["~="] = true,
    ["<"] = true,
    ["<="] = true,
    [">"] = true,
    [">="] = true,
} as {[string]: boolean}

--- The same comparison read from the other side, for a test written with its literal
--- first. `64 >= #self` and `#self <= 64` are one refinement, so they normalize to one.
local FLIPPED = {
    ["=="] = "==",
    ["~="] = "~=",
    ["<"] = ">",
    ["<="] = ">=",
    [">"] = "<",
    [">="] = "<=",
} as {[string]: string}

--- The Lua type names `type()` can answer, so a comparison against one is a test rather
--- than a string comparison that can never hold.
local LUA_TYPES = {
    ["nil"] = true,
    boolean = true,
    number = true,
    string = true,
    table = true,
    ["function"] = true,
    thread = true,
    userdata = true,
    cdata = true,
} as {[string]: boolean}

--- Strips the parentheses a reader wrote for grouping. They change nothing about what
--- the test means, and keeping them would mean every shape below had to look through
--- them.
local function unwrap(node: cst.Node?): cst.Node?
    while node and node.kind == "paren" do
        node = node.expr
    end
    return node
end

--- The field path `node` names, when it is rooted at `self` and reaches it only through
--- named fields. Anything computed, a bracket index or a call, has no path, because the
--- test has to mean the same thing every time it runs.
local function pathOf(node: cst.Node?): {string}?
    node = unwrap(node)
    if not node then
        return nil
    end
    if node.kind == "name" then
        if node.token and node.token.text == "self" then
            return {}
        end
        return nil
    end
    if node.kind == "dotIndex" then
        local base = pathOf(node.obj)
        if not base or not node.name then
            return nil
        end
        local out = {}
        for j, segment in ipairs(base) do
            out[j] = segment
        end
        out[#out + 1] = node.name.text
        return out
    end

    return nil
end

--- The Lua spelling of `node` when it is a literal this subset admits, and the value it
--- stands for. A number written with a C suffix is a real number to the checker and not
--- a Lua literal, so it is refused rather than rendered wrong.
local function literalOf(node: cst.Node?): string?, any
    node = unwrap(node)
    if not node then
        return nil
    end
    local kind = node.kind
    if kind == "string" and node.token then
        local text = node.token.text
        local quote = text:sub(1, 1)
        if quote ~= '"' and quote ~= "'" then
            return nil
        end -- a long string
        return text, lexer.stringValue(text) or text:sub(2, -2)
    elseif kind == "number" and node.token then
        local text = node.token.text
        if not text:match("^%d+$") and not text:match("^%d+%.%d+$") then
            return nil
        end
        return text, tonumber(text)
    elseif kind == "trueExpr" then
        return "true", true
    elseif kind == "falseExpr" then
        return "false", false
    elseif kind == "nilExpr" then
        return "nil", nil
    end

    return nil
end

--- The path whose byte length `node` takes, when it is `#` applied to one.
---
--- `#` is the one accessor the subset admits. It reads a value and answers an integer
--- without allocating, calling, or reaching outside the subject, which is the bar
--- everything else here is held to.
local function lengthPath(node: cst.Node?): {string}?
    node = unwrap(node)
    if not node or node.kind ~= "unop" then
        return nil
    end
    if not node.op or node.op.kind ~= "#" then
        return nil
    end

    return pathOf(node.operand)
end

--- `type(x)` applied to a path, when that is what `node` is.
local function typeCallPath(node: cst.Node?): {string}?
    node = unwrap(node)
    if not node or node.kind ~= "call" then
        return nil
    end
    local callee = unwrap(node.obj)
    if not callee or callee.kind ~= "name" then
        return nil
    end
    if not callee.token or callee.token.text ~= "type" then
        return nil
    end
    local call = node as cst.Call
    local args = call.args and (call.args as cst.Args).exprs or nil
    if not args or #args ~= 1 then
        return nil
    end

    return pathOf(args[1])
end

--- Reads one expression into a refinement node, or says why it cannot.
---
--- The failure is a sentence naming what was found, because "not supported" sends a
--- reader looking for a list that does not exist, while "a call" tells them what to
--- take out.
---
--- @param node the expression the `where` clause carries
--- @return the refinement, or nil and the reason
function predicate.build(node: cst.Node?): predicate.Node?, string?
    node = unwrap(node)
    if not node then
        return nil, "an empty refinement"
    end
    local kind = node.kind

    if kind == "trueExpr" or kind == "falseExpr" then
        return new predicate.Node(op = "const", value = kind == "trueExpr")
    end

    if kind == "unop" and node.op and node.op.kind == "not" then
        local inner, why = predicate.build(node.operand)
        if not inner then
            return nil, why
        end
        return new predicate.Node(op = "not", a = inner)
    end

    if kind == "binop" and node.op then
        local op = node.op.kind
        if op == "and" or op == "or" then
            local left, why = predicate.build(node.lhs)
            if not left then
                return nil, why
            end
            local right, why2 = predicate.build(node.rhs)
            if not right then
                return nil, why2
            end
            return new predicate.Node(op = op, a = left, b = right)
        end
        if COMPARISONS[op] then
            -- `type(self.x) == "table"` is a type test rather than a string comparison,
            -- and is the one call the subset admits.
            local typePath = typeCallPath(node.lhs) or typeCallPath(node.rhs)
            if typePath then
                local other = typeCallPath(node.lhs) and node.rhs or node.lhs
                local text, value = literalOf(other)
                if not text or type(value) ~= "string" then
                    return nil, "a type() test compared with something other " .. "than a type name"
                end
                if not LUA_TYPES[value as string] then
                    return nil, ("%q, which type() never answers"):format(value)
                end
                if op ~= "==" and op ~= "~=" then
                    return nil, "a type() test ordered rather than compared"
                end
                local test = new predicate.Node(op = "typeis", path = typePath, luaType = value as string)
                if op == "~=" then
                    return new predicate.Node(op = "not", a = test)
                end
                return test
            end
            -- `#self <= 64` is a comparison of a length, so it reads as one: the
            -- accessor is the node and the comparison is what it applies.
            local lenPath = lengthPath(node.lhs) or lengthPath(node.rhs)
            if lenPath then
                local flipped = lengthPath(node.rhs) ~= nil and lengthPath(node.lhs) == nil
                local text, value = literalOf(flipped and node.lhs or node.rhs)
                if not text or type(value) ~= "number" then
                    return nil, "a length compared against something that is not a number"
                end
                local inner = new predicate.Node(
                    op = "cmp",
                    cmp = flipped and FLIPPED[op] or op,
                    path = {},
                    literal = text,
                    constant = value
                )
                return new predicate.Node(op = "len", path = lenPath, a = inner)
            end
            -- otherwise: a field of the subject against a literal, either way round
            local path = pathOf(node.lhs)
            local other = node.rhs
            if not path then
                path, other = pathOf(node.rhs), node.lhs
            end
            if not path then
                -- Name what was actually written. "not a field" sends a reader looking
                -- at their fields; "a call" tells them what to remove.
                for _, side in ipairs({unwrap(node.lhs), unwrap(node.rhs)}) do
                    local sideKind = side and side.kind
                    if sideKind == "call" or sideKind == "methodCall" or sideKind == "safeCall" then
                        return nil, "a call"
                    end
                    if sideKind == "binop" then
                        return nil, "arithmetic"
                    end
                end
                return nil, "a comparison of two things that are not the " .. "declaration's own fields"
            end
            local text, value = literalOf(other)
            if not text then
                return nil, "a comparison against something that is not a literal"
            end
            return new predicate.Node(op = "cmp", cmp = op, path = path, literal = text, constant = value)
        end
        return nil, ("the %s operator"):format(op)
    end

    -- a bare field, which is a truthiness test
    local path = pathOf(node)
    if path then
        if #path == 0 then
            return nil, "the subject itself"
        end
        return new predicate.Node(op = "truthy", path = path)
    end

    if kind == "call" or kind == "methodCall" or kind == "safeCall" then
        return nil, "a call"
    end
    if kind == "string" or kind == "number" or kind == "nilExpr" then
        return nil, "a literal"
    end

    return nil, "this expression"
end

--- A refinement testing that `path` holds exactly `constant`.
---
--- This is how a declaration's own literal-typed field becomes its test without anyone
--- writing one: the field's type already says the value is that and nothing else, so
--- the test is arithmetic on what was declared. Nil when the value is not one this
--- subset can spell.
---
--- @param path the field names, outermost first
--- @param constant the value the field's literal type admits
function predicate.equals(path: {string}, constant: string | number | boolean): predicate.Node?
    local kind = type(constant)
    local text = nil
    if kind == "string" then
        text = ("%q"):format(constant)
    elseif kind == "number" then
        text = tostring(constant)
    elseif kind == "boolean" then
        text = constant and "true" or "false"
    end
    if not text then
        return nil
    end

    return new predicate.Node(op = "cmp", cmp = "==", path = path, literal = text, constant = constant)
end

--- Both refinements, as one.
function predicate.both(a: predicate.Node?, b: predicate.Node?): predicate.Node?
    if not a then
        return b
    end
    if not b then
        return a
    end

    return new predicate.Node(op = "and", a = a, b = b)
end

--- Every field path the refinement reads, so the checker can hold each one to the
--- declaration it belongs to.
function predicate.paths(node: predicate.Node?, out: {{string}}?): {{string}}
    out = out or {}
    if not node then
        return out
    end
    if node.path then
        out[#out + 1] = node.path
    end
    predicate.paths(node.a, out)
    predicate.paths(node.b, out)

    return out
end

--- What `type()` answers for a value of each primitive, where that is one answer.
--- A `types.Prim` carries its name as its tag, so this is keyed by tag.
local PRIMITIVE_LUA_TYPE: {
    [string]: string
} = {
    string = "string",
    cstring = "string",
    number = "number",
    integer = "number",
    float = "number",
    boolean = "boolean",
    table = "table",
    thread = "thread",
    userdata = "userdata",
}

--- What `type()` answers for a value of `t`, when that is decided by the type.
---
--- Only the tags whose runtime answer is fixed. A union, a type parameter, and `any`
--- are all several answers, so they are no answer at all.
local function luaTypeOf(t: any): string?
    if type(t) ~= "table" then
        return nil
    end
    local tag = t.tag
    if tag == "literal" then
        return luaTypeOf(t.base)
    end
    local primitive = PRIMITIVE_LUA_TYPE[tag]
    if primitive then
        return primitive
    end
    if tag == "nominal" then
        if t.declKind == "struct" then
            return "cdata"
        end
        if t.declKind == "record" or t.declKind == "interface" then
            return "table"
        end
        return nil
    end
    if tag == "shape" or tag == "map" or tag == "array" or tag == "tuple" then
        return "table"
    end
    if tag == "func" then
        return "function"
    end

    return nil
end

--- Whether a value of `t` is always truthy, always falsy, or either.
---
--- Lua is falsy on `nil` and `false` and nothing else, so a type that admits neither
--- is always truthy and one that is exactly one of them is always falsy. `boolean`, a
--- union that admits nil, and the gradual types are undecided.
local function truthinessOf(t: any): boolean?
    if type(t) ~= "table" then
        return nil
    end
    local tag = t.tag
    if tag == "nil" then
        return false
    elseif tag == "literal" then
        if t.constant == false then
            return false
        end
        if t.constant == true then
            return true
        end
        return truthinessOf(t.base)
    elseif tag == "boolean" or tag == "any" or tag == "unknown" or tag == "union" or tag == "typevar" then
        return nil
    elseif luaTypeOf(t) ~= nil or tag == "affine" or tag == "borrowed" or tag == "pinned" or tag == "const" then
        return true
    end

    return nil
end

--- One comparison between two values the subset can spell, or nothing when the pair is
--- not ordered by Lua's own rules. Mixed types compare only for equality: `3 < "3"`
--- raises at run time rather than answering, so it is not something to answer here.
local function compare(cmp: string?, left: any, right: any): boolean?
    if cmp == "==" then
        return left == right
    elseif cmp == "~=" then
        return left ~= right
    end
    local kind = type(left)
    if kind ~= type(right) or kind ~= "number" and kind ~= "string" then
        return nil
    end
    if cmp == "<" then
        return left < right
    elseif cmp == "<=" then
        return left <= right
    elseif cmp == ">" then
        return left > right
    elseif cmp == ">=" then
        return left >= right
    end

    return nil
end

--- Whether `value` satisfies the refinement, fails it, or cannot be decided.
---
--- This is the same three-valued question `satisfiedBy` asks, against a value instead
--- of a declaration's field types. It is what decides a literal at its admission: a
--- value the compiler holds is either proved to fit the constraint, proved not to, or
--- -- for a refinement reading fields the caller did not supply -- neither.
---
--- Reaching a field of a non-table answers nil rather than raising, because this runs
--- over values that are not of the type yet. That is the whole point of asking.
function predicate.satisfiedByValue(node: predicate.Node?, value: any): boolean?
    if not node then
        return nil
    end
    local op = node.op

    if op == "const" then
        return node.value
    elseif op == "not" then
        local inner = predicate.satisfiedByValue(node.a, value)
        if inner == nil then
            return nil
        end
        return not inner
    elseif op == "and" or op == "or" then
        local left = predicate.satisfiedByValue(node.a, value)
        local right = predicate.satisfiedByValue(node.b, value)
        if op == "and" then
            if left == false or right == false then
                return false
            end
            if left == true and right == true then
                return true
            end
            return nil
        end
        if left == true or right == true then
            return true
        end
        if left == false and right == false then
            return false
        end
        return nil
    end

    local at = value
    for _, segment in ipairs(node.path or {}) do
        if type(at) ~= "table" then
            return nil
        end
        at = (at as {[string]: any})[segment]
    end

    if op == "len" then
        local kind = type(at)
        if kind ~= "string" and kind ~= "table" then
            return nil
        end
        return predicate.satisfiedByValue(node.a, #(at as string))
    elseif op == "integral" then
        if type(at) ~= "number" then
            return false
        end
        return (at as number) % 1 == 0
    elseif op == "typeis" then
        return type(at) == node.luaType
    elseif op == "truthy" then
        return at ~= nil and at ~= false
    elseif op == "cmp" then
        return compare(node.cmp, at, node.constant)
    end

    return nil
end

--- Whether a declaration whose fields `fieldAt` reports must satisfy the refinement,
--- must fail it, or cannot be told either way.
---
--- Three-valued on purpose. A declaration that provably fails an interface's own test
--- is a contradiction worth reporting, since the checker would prove it conforms while
--- `is` answered no. An answer that merely cannot be computed is not evidence of
--- anything, so it stays silent.
---
--- @param node the refinement
--- @param fieldAt the declared type at a field path, or nil when there is none
--- @return true, false, or nil when undecided
function predicate.satisfiedBy(node: predicate.Node?, fieldAt: function(path: {string}): any): boolean?
    if not node then
        return nil
    end
    local op = node.op

    if op == "const" then
        return node.value

    elseif op == "not" then
        local inner = predicate.satisfiedBy(node.a, fieldAt)
        if inner == nil then
            return nil
        end
        return not inner
    end
    if op == "and" or op == "or" then
        local left = predicate.satisfiedBy(node.a, fieldAt)
        local right = predicate.satisfiedBy(node.b, fieldAt)
        if op == "and" then
            -- one false settles it, whatever the other side turns out to be
            if left == false or right == false then
                return false
            end
            if left == true and right == true then
                return true
            end
            return nil
        end
        if left == true or right == true then
            return true
        end
        if left == false and right == false then
            return false
        end
        return nil
    end

    local t = fieldAt(node.path or {})
    if t == nil then
        return nil
    end

    if op == "len" then
        -- A length is known when the value is: a literal string type admits exactly one
        -- string, so it admits exactly one length.
        if type(t) ~= "table" or t.tag ~= "literal" or type(t.constant) ~= "string" then
            return nil
        end
        return predicate.satisfiedByValue(node.a, #(t.constant as string))
    end

    if op == "typeis" then
        local answer = luaTypeOf(t)
        if answer == nil then
            return nil
        end
        return answer == node.luaType
    elseif op == "truthy" then
        return truthinessOf(t)
    elseif op == "cmp" and (node.cmp == "==" or node.cmp == "~=") then
        -- Only a literal-typed field settles a comparison: it admits exactly one value,
        -- so the answer is known without running anything.
        if type(t) ~= "table" or t.tag ~= "literal" then
            return nil
        end
        local same = t.constant == node.constant
        if node.cmp == "~=" then
            return not same
        else
            return same
        end
    end

    return nil
end

--- What the refinement always answers, when it answers the same thing every time.
---
--- A refinement that reads nothing decides nothing: always-true makes `is` say yes to
--- every value, always-false makes the type uninhabited. Both are worth saying rather
--- than compiling.
function predicate.constant(node: predicate.Node?): boolean?
    if not node then
        return nil
    end
    if node.op == "const" then
        return node.value
    end
    if node.op == "not" then
        local inner = predicate.constant(node.a)
        if inner == nil then
            return nil
        end
        return not inner
    end
    if node.op == "and" or node.op == "or" then
        local left, right = predicate.constant(node.a), predicate.constant(node.b)
        if left == nil or right == nil then
            return nil
        end
        if node.op == "and" then
            return left and right
        else
            return left or right
        end
    end

    return nil
end

--- The refinement's canonical spelling, which is what decides whether two constraints
--- are one.
---
--- A small s-expression rather than the Lua the generator emits: it has to be stable
--- under the orders a reader may write a conjunction in, and it has to survive being a
--- cache key and part of a type fingerprint, neither of which wants Lua's precedence
--- or spacing in it.
---
--- `and` and `or` sort their operands by their own keys, so `a and b` and `b and a`
--- key alike. That is the whole of the normalization: nothing here rewrites a
--- comparison into another, intersects two bounds, or decides an implication. Those
--- are the prover's, and it is allowed to give up where this is not.
function predicate.key(node: predicate.Node?): string
    if not node then
        return "#any"
    end
    local op = node.op

    if op == "const" then
        return node.value and "#t" or "#f"
    elseif op == "not" then
        return "(not " .. predicate.key(node.a) .. ")"
    elseif op == "and" or op == "or" then
        local parts: {predicate.Node} = {}
        predicate.flatten(node, op, parts)
        local keys: {string} = {}
        for j, part in ipairs(parts) do
            keys[j] = predicate.key(part)
        end
        table.sort(keys)
        -- A conjunct written twice is one conjunct: the test is the same either way and
        -- the second reading of it decides nothing the first did not.
        local unique, seen = {}, {} as {[string]: boolean}
        for _, one in ipairs(keys) do
            if not seen[one] then
                seen[one] = true
                unique[#unique + 1] = one
            end
        end
        if #unique == 1 then
            return unique[1]
        end
        return "(" .. op .. " " .. table.concat(unique, " ") .. ")"
    end

    local path = "." .. table.concat(node.path or {}, ".")
    if op == "cmp" then
        return ("(cmp %s %s %s)"):format(node.cmp or "==", path, node.literal or "nil")
    elseif op == "typeis" then
        return ("(typeis %s %s)"):format(path, node.luaType or "nil")
    elseif op == "len" then
        return ("(len %s %s)"):format(path, predicate.key(node.a))
    elseif op == "integral" then
        return ("(integral %s)"):format(path)
    end

    return ("(truthy %s)"):format(path)
end

--- Every operand of one nested run of `op`, so `(a and b) and c` and `a and (b and c)`
--- present the same three.
function predicate.flatten(node: predicate.Node?, op: string, out: {predicate.Node}): {predicate.Node}
    if not node then
        return out
    end
    if node.op == op then
        predicate.flatten(node.a, op, out)
        predicate.flatten(node.b, op, out)
        return out
    end
    out[#out + 1] = node

    return out
end

--- The same refinement with its conjunctions and disjunctions in canonical order, so
--- the node a type stores is the one its key describes.
---
--- Rebuilt right-leaning, which is the shape `build` produces and the one `render`
--- parenthesises most readably.
function predicate.normalize(node: predicate.Node?): predicate.Node?
    if not node then
        return nil
    end
    local op = node.op
    if op == "not" then
        return new predicate.Node(op = "not", a = predicate.normalize(node.a))
    elseif op == "len" then
        return new predicate.Node(op = "len", path = node.path, a = predicate.normalize(node.a))
    elseif op ~= "and" and op ~= "or" then
        return node
    end

    local parts: {predicate.Node} = {}
    predicate.flatten(node, op, parts)
    local keyed: {{
        key: string,
        rank: integer,
        node: predicate.Node
    }} = {}
    for _, part in ipairs(parts) do
        local one = predicate.normalize(part)
        if one then
            -- A test of what the subject is comes before anything that reads it. `and`
            -- stops at the first false, so this is the difference between a refinement
            -- that answers no for a string and one that raises comparing it to a
            -- number. Ordering is evaluation, not identity: `key` stays alphabetical,
            -- so two conjunctions written either way round still key alike.
            local bare = #(one.path or {}) == 0
            local rank = bare and one.op == "typeis" and 0 or bare and one.op == "integral" and 1 or 2
            keyed[#keyed + 1] = {key = predicate.key(one), rank = rank, node = one}
        end
    end
    table.sort(keyed, function(a, b): boolean
        if a.rank ~= b.rank then
            return a.rank < b.rank
        end
        return a.key < b.key
    end)
    local out: predicate.Node?, seen = nil, {} as {[string]: boolean}
    for j = #keyed, 1, -1 do
        local entry = keyed[j]
        if not seen[entry.key] then
            seen[entry.key] = true
            if out then
                out = new predicate.Node(op = op, a = entry.node, b = out)
            else
                out = entry.node
            end
        end
    end

    return out
end

--- What a refinement over the subject says about its value and its length, and what
--- it says that this cannot read.
---
--- Bounds are inclusive, and absent means unbounded on that side. `others` holds every
--- conjunct the bounds do not account for, keyed canonically, so an implication can ask
--- whether one refinement's leftovers are among another's without reading them.
---
--- Nil for anything that is not a conjunction of things it understands. A disjunction
--- or a negation is not wrong, it is simply not an interval, and a caller that cannot
--- prove an implication keeps whatever it would have removed.
record predicate.Decomposition
    min: number?
    max: number?
    minLength: number?
    maxLength: number?
    others: {[string]: boolean}
end

--- Applies one comparison against `value` to the bounds in `into`, under `field`
--- (`min`/`max`) naming the pair. Returns false when the comparison is not one that
--- moves a bound.
local function narrowBound(
    into: predicate.Decomposition,
    low: string,
    high: string,
    cmp: string?,
    value: number
): boolean
    local fields = into as {[string]: any}
    -- A strict bound over the integers is the next one in, but this does not know the
    -- base is integral, so it declines rather than assuming. The leftover keeps it.
    if cmp ~= ">=" and cmp ~= "<=" and cmp ~= "==" then
        return false
    end
    if cmp == ">=" or cmp == "==" then
        local currentLow = fields[low] as number?
        if not currentLow or value > currentLow then
            fields[low] = value
        end
    end
    if cmp == "<=" or cmp == "==" then
        local currentHigh = fields[high] as number?
        if not currentHigh or value < currentHigh then
            fields[high] = value
        end
    end

    return true
end

--- The bounds and leftovers of a refinement over the subject itself.
---
--- Only the subject: a refinement reaching a field is describing a shape rather than a
--- scalar, and this is what a scalar constraint is read with.
function predicate.decompose(node: predicate.Node?): predicate.Decomposition?
    if not node then
        return nil
    end
    local parts: {predicate.Node} = {}
    predicate.flatten(node, "and", parts)
    local out = new predicate.Decomposition(others = {})
    for _, part in ipairs(parts) do
        local op = part.op
        local taken = false
        if op == "cmp" and #(part.path or {}) == 0 and type(part.constant) == "number" then
            taken = narrowBound(out, "min", "max", part.cmp, part.constant as number)
        elseif op == "len" and #(part.path or {}) == 0 then
            local inner = part.a
            if inner and inner.op == "cmp" and #(inner.path or {}) == 0 and type(inner.constant) == "number" then
                taken = narrowBound(out, "minLength", "maxLength", inner.cmp, inner.constant as number)
            end
        elseif op == "and" or op == "or" then
            -- `flatten` already took the conjunctions apart, so this is a disjunction,
            -- which no interval describes.
            return nil
        end
        -- Everything else, `integral` and a type test included, is a leftover: it is
        -- not a bound, and an implication has to find it on the narrower side too.
        if not taken then
            out.others[predicate.key(part)] = true
        end
    end

    return out
end

--- Whether every value `a` admits `b` admits too, as far as this can tell.
---
--- Interval containment and leftover containment, and nothing else: no rewriting of
--- one comparison into another, no arithmetic on the base's own domain, and no attempt
--- at general implication. Undecided answers false, because the caller's fallback is to
--- keep a check, and keeping one it did not need costs less than removing one it did.
function predicate.implies(a: predicate.Node?, b: predicate.Node?): boolean
    if predicate.key(a) == predicate.key(b) then
        return true
    end
    local wide = predicate.decompose(b)
    if not wide then
        return false
    end
    local narrow = predicate.decompose(a)
    if not narrow then
        return false
    end
    if wide.min and (not narrow.min or narrow.min < wide.min) then
        return false
    end
    if wide.max and (not narrow.max or narrow.max > wide.max) then
        return false
    end
    if wide.minLength and (not narrow.minLength or narrow.minLength < wide.minLength) then
        return false
    end
    if wide.maxLength and (not narrow.maxLength or narrow.maxLength > wide.maxLength) then
        return false
    end
    for key in pairs(wide.others) do
        if not narrow.others[key] then
            return false
        end
    end

    return true
end

--- Whether two refinements admit nothing in common, which makes a conversion between
--- them one that always fails and a conjunction of them uninhabited.
function predicate.disjoint(a: predicate.Node?, b: predicate.Node?): boolean
    local left, right = predicate.decompose(a), predicate.decompose(b)
    if not left or not right then
        return false
    end
    if left.min and right.max and left.min > right.max then
        return true
    end
    if right.min and left.max and right.min > left.max then
        return true
    end
    if left.minLength and right.maxLength and left.minLength > right.maxLength then
        return true
    end
    if right.minLength and left.maxLength and right.minLength > left.maxLength then
        return true
    end

    return false
end

--- The refinement as a Lua expression testing `subject`.
---
--- `subject` is substituted rather than bound, so the caller has already decided that
--- evaluating it more than once is safe, meaning a plain name or a temporary it
--- hoisted. Reaching through a field guards the step before it, because the test runs
--- against values that are not of the type yet; that is what it is for.
function predicate.render(node: predicate.Node?, subject: string): string
    if not node then
        return "true"
    end
    local op = node.op

    if op == "const" then
        return node.value and "true" or "false"

    elseif op == "not" then
        return "not (" .. predicate.render(node.a, subject) .. ")"
    end
    if op == "and" or op == "or" then
        return "(" .. predicate.render(node.a, subject) .. " " .. op .. " " .. predicate.render(node.b, subject) .. ")"
    end
    if op == "len" then
        -- The accessor reaches its path, then the comparison it carries applies to the
        -- length rather than to the value. The inner node's own path is empty, so
        -- rendering it against this subject is what substitutes the length in.
        local target = subject
        for j, segment in ipairs(node.path or {}) do
            target = target .. (j > 1 and "?." or ".") .. segment
        end
        return predicate.render(node.a, "#" .. target)
    end

    -- Reaching through a field guards the step before it, because the test runs against
    -- values that are not of the type yet, which is what it is for. `?.` is the
    -- runtime's own answer to exactly that, and it reads each step once where a
    -- written-out guard reads it twice.
    local access = subject
    for j, segment in ipairs(node.path or {}) do
        access = access .. (j > 1 and "?." or ".") .. segment
    end

    if op == "cmp" then
        return access .. " " .. (node.cmp or "==") .. " " .. (node.literal or "nil")
    elseif op == "integral" then
        -- `type(x) == "number"` is the whole of what Lua can say about a number, and
        -- an integer is less than that. A NaN and an infinity both answer NaN to `% 1`,
        -- and NaN is not 0, so one test rejects the three values a pair of bounds
        -- would otherwise let through.
        return ("%s %% 1 == 0"):format(access)
    elseif op == "typeis" then
        return ("type(%s) == %q"):format(access, node.luaType or "nil")
    end

    -- a bare field is a truthiness test, which is what the access itself answers

    return access
end

--- Whether the refinement already decides what `subject` is before reading into it.
---
--- A conjunction carrying a `type()` test on the subject guards its own reads, because
--- `and` stops at the first false. One that does not needs the table check `test` adds,
--- and a disjunction never counts: either arm may be the one that runs.
function predicate.guardsType(node: predicate.Node?): boolean
    if not node then
        return false
    end
    if node.op == "typeis" and #(node.path or {}) == 0 then
        return true
    end
    if node.op ~= "and" then
        return false
    end

    return predicate.guardsType(node.a) or predicate.guardsType(node.b)
end

--- The whole test for `subject`, table check included.
---
--- A refinement reads fields, and `is` is asked about values that may be anything at
--- all, so the table test is part of the predicate rather than something every caller
--- has to remember.
function predicate.test(node: predicate.Node?, subject: string): string
    local body = predicate.render(node, subject)
    if predicate.constant(node) ~= nil or predicate.guardsType(node) then
        return body
    end

    return ("(type(%s) == \"table\" and %s)"):format(subject, body)
end

export = predicate
