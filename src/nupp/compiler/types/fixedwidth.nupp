--[[
The fixed-width vocabulary has two roles that must not be conflated.

`float`, `int32`, and `uint32` are unboxed value refinements. The narrower
integer names describe physical storage only. This module owns that division,
the projection from a storage load to a value type, and the literal membership
test used by the checker. It deliberately owns no flow state: establishment is
a fact about one expression or binding, recorded by the checking run.
]]
module nupp.compiler.types.fixedwidth

local apiidentity = require("nupp.compiler.apiidentity")
local T = require("nupp.compiler.types")
local floatparts = require("nupp.compiler.floatparts")

local VALUE = {float32 = true, int32 = true, uint32 = true}
local STORAGE_ONLY = {int8 = true, int16 = true, uint8 = true, uint16 = true}
local PHYSICAL = {
    float64 = true,
    float32 = true,
    int8 = true,
    int16 = true,
    int32 = true,
    int64 = true,
    uint8 = true,
    uint16 = true,
    uint32 = true,
    uint64 = true,
}

export function isValue(t: T.Type?): boolean
    return t ~= nil and VALUE[T.unwrapOwnership(t).tag] == true
end

export function isStorageOnly(t: T.Type?): boolean
    return t ~= nil and STORAGE_ONLY[T.unwrapOwnership(t).tag] == true
end

--- The tags `fixed.storageOnlyValue` looks inside.
local COMPOSITE: {
    [string]: boolean
} = {
    nominal = true,
    func = true,
    array = true,
    map = true,
    tuple = true,
    union = true,
    intersection = true,
    shape = true,
}

--- Finds a storage-only width that escaped into a value-shaped type. Pointers,
--- C arrays, structs, and standard span element positions are the physical leaves
--- where those names are meaningful and deliberately stop the walk.
export function storageOnlyValue(t: T.Type?, seen: {[string]: boolean}?): T.Type?
    if not t then
        return nil
    end
    local raw = T.unwrapOwnership(t)
    if STORAGE_ONLY[raw.tag] then
        return raw
    end
    if raw.tag == "ptr" or raw.tag == "carray" or raw.tag == "ctype" or raw.tag == "const" then
        return nil
    end
    -- Only these hold other types; anything else has nothing to look inside, and
    -- needs no visited set to say so.
    if not COMPOSITE[raw.tag] then
        return nil
    end
    seen = seen or {}
    if seen[raw.id] then
        return nil
    end
    seen[raw.id] = true
    if raw.tag == "nominal" then
        local origin = (raw.origin or raw) as T.Nominal
        if raw.declKind == "struct"
            or origin.moduleName == "nupp.mem.span"
            or apiidentity.canonical(origin.moduleName or "") == "simd"
            or apiidentity.canonical(origin.sealedModule or "") == "simd"
        then
            return nil
        end
        for _, name in ipairs(raw.fieldOrder or {}) do
            local found = storageOnlyValue(raw.byname and raw.byname[name], seen)
            if found then
                return found
            end
        end
    elseif raw.tag == "func" then
        for _, value in ipairs(raw.params or {}) do
            local found = storageOnlyValue(value, seen)
            if found then
                return found
            end
        end
        for _, value in ipairs(raw.rets or {}) do
            local found = storageOnlyValue(value, seen)
            if found then
                return found
            end
        end
    elseif raw.tag == "array" then
        return storageOnlyValue(raw.elem, seen)
    elseif raw.tag == "map" then
        return storageOnlyValue(raw.value, seen) or storageOnlyValue(raw.writeValue, seen)
    elseif raw.tag == "tuple" then
        for _, value in ipairs(raw.elems or {}) do
            local found = storageOnlyValue(value, seen)
            if found then
                return found
            end
        end
    elseif raw.tag == "union" or raw.tag == "intersection" then
        for _, value in ipairs(raw.members or {}) do
            local found = storageOnlyValue(value, seen)
            if found then
                return found
            end
        end
    elseif raw.tag == "shape" then
        for _, field in ipairs(raw.fields or {}) do
            local found = storageOnlyValue(field.read, seen)
                or storageOnlyValue(field.write, seen)
                or storageOnlyValue(field.type, seen)
            if found then
                return found
            end
        end
        return storageOnlyValue(raw.indexReadKey, seen)
            or storageOnlyValue(raw.indexReadValue, seen)
            or storageOnlyValue(raw.indexWriteKey, seen)
            or storageOnlyValue(raw.indexWriteValue, seen)
    end

    return nil
end

export function isPhysical(t: T.Type?): boolean
    return t ~= nil and PHYSICAL[T.unwrapOwnership(t).tag] == true
end

--- Whether trusting this checked value also means trusting fixed-width facts held
--- inside a table-backed record. This is kept separate from physical structs: their
--- loads establish values at the slot, rather than relying on table mutation history.
export function requiresTrust(t: T.Type?, seen: {[string]: boolean}?): boolean
    if not t then
        return false
    end
    local raw = T.unwrapOwnership(t)
    if raw.tag ~= "nominal" or raw.declKind ~= "record" then
        return false
    end
    seen = seen or {}
    if seen[raw.id] then
        return false
    end
    seen[raw.id] = true
    for _, name in ipairs(raw.fieldOrder or {}) do
        local field = raw.byname and raw.byname[name] or nil
        if isValue(field) or requiresTrust(field, seen) then
            return true
        end
    end

    return false
end

--- The value produced by loading one physical scalar slot.
export function loaded(t: T.Type): T.Type
    local raw = T.unwrapOwnership(t)
    if raw.tag == "int8" or raw.tag == "int16" then
        return T.int32
    elseif raw.tag == "uint8" or raw.tag == "uint16" then
        return T.uint32
    end

    return raw
end

local function numeric(t: T.Type): boolean
    local raw = T.unwrapOwnership(t)
    if raw == T.any then
        return true
    end
    if raw.tag == "literal" then
        return numeric(raw.base)
    end
    if raw.tag == "union" then
        for _, member in ipairs(raw.members) do
            if not numeric(member) then
                return false
            end
        end
        return true
    end

    return raw.tag == "number" or raw.tag == "integer" or PHYSICAL[raw.tag] == true
end

--- Whether a real C/FFI store accepts `source` for the physical scalar `target`.
--- Returns nil when the target is not one of those slots, so the caller asks the
--- ordinary subtype relation instead.
export function physicalStoreAccepts(source: T.Type, target: T.Type): boolean?
    local rawTarget = T.unwrapOwnership(target)
    if not PHYSICAL[rawTarget.tag] then
        return nil
    end

    return numeric(source)
end

local MIN_NORMAL_F32 = 2 ^ -126
local MIN_SUBNORMAL_F32 = 2 ^ -149

local function exactFloat(value: number): boolean
    if value ~= value or value == math.huge or value == -math.huge or value == 0 then
        return true
    end
    local magnitude = math.abs(value)
    if magnitude < MIN_NORMAL_F32 then
        local units = magnitude / MIN_SUBNORMAL_F32
        return units >= 1 and units <= 8388607 and units % 1 == 0
    end
    local significand, exponent = floatparts.frexp(magnitude)
    if exponent > 128 then
        return false
    end
    local units = significand * 16777216

    return units % 1 == 0
end

--- Whether an existing Lua numeric literal is already a member of the named value
--- refinement. This never performs a conversion.
export function literalFits(value: number, target: T.Type): boolean
    local tag = T.unwrapOwnership(target).tag
    if tag == "float32" then
        return exactFloat(value)
    elseif tag == "int32" then
        return value % 1 == 0 and value >= -2147483648 and value < 2147483648
    elseif tag == "uint32" then
        return value % 1 == 0 and value >= 0 and value < 4294967296
    elseif tag == "int64" then
        -- A Lua number is a double, so only a value it represents exactly may
        -- stand for the box: an integral value within 2^53 of zero.
        return value % 1 == 0 and value >= -9007199254740992 and value <= 9007199254740992
    elseif tag == "uint64" then
        return value % 1 == 0 and value >= 0 and value <= 9007199254740992
    else
        return false
    end
end

local MAX_F32 = 3.4028234663852886e38

local INTEGER_RANGE: {
    [string]: {number}
} = {
    int8 = {-128, 127},
    int16 = {-32768, 32767},
    int32 = {-2147483648, 2147483647},
    uint8 = {0, 255},
    uint16 = {0, 65535},
    uint32 = {0, 4294967295},
}

--- Whether a Lua numeric literal survives the conversion a physical store performs
--- into `target`. The store narrows a wider source, so an inexact float is fine
--- where it is finite in binary32; an integer slot takes only a whole number in
--- its range, since anything else is truncated or wrapped into a different value.
export function physicalLiteralFits(value: number, target: T.Type): boolean
    local tag = T.unwrapOwnership(target).tag
    -- Binary64 rounds `2^63 - 1` to `2^63`, and likewise at 64 unsigned
    -- bits. Test those upper bounds exclusively instead of storing rounded
    -- inclusive maxima in `INTEGER_RANGE`.
    if tag == "int64" or tag == "uint64" then
        local lower = tag == "int64" and -2 ^ 63 or 0
        local upper = tag == "int64" and 2 ^ 63 or 2 ^ 64
        return value % 1 == 0 and value >= lower and value < upper
    end
    local range = INTEGER_RANGE[tag]
    if range then
        return value % 1 == 0 and value >= range[1] and value <= range[2]
    end

    return tag ~= "float32" or value ~= value or math.abs(value) <= MAX_F32
end

export function widenedName(t: T.Type): string?
    local tag = T.unwrapOwnership(t).tag
    if tag == "float32" then
        return "float64"
    elseif tag == "int32" or tag == "uint32" then
        return "integer"
    else
        return nil
    end
end

export function conversionPath(t: T.Type): string?
    local tag = T.unwrapOwnership(t).tag
    if tag == "float32" then
        return "math.f32.narrow"
    elseif tag == "int32" then
        return "math.i32.wrap"
    elseif tag == "uint32" then
        return "math.u32.wrap"
    else
        return nil
    end
end
