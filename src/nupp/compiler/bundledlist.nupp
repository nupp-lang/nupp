module nupp.compiler.bundledlist

-- Directory traversal for carried resources. Kept outside `bundled` so the
-- in-memory compiler can read embedded declarations without importing host I/O.

local bundled = require("nupp.compiler.bundled")
const files = require("io.internal.files")
local resource: any = {source = bundled.source,}

function resource.list(prefix: string): {string}
    local embedded = package.preload["nupp.embedded"]
    if embedded then
        local found = bundled.embeddedUnder(embedded(), prefix)
        -- Only when it answered. A table carrying some of what the compiler carries
        -- is not proof that it carries all of it: the test binary embeds the modules
        -- and not the templates, and reading "no entries under this prefix" as "there
        -- are none" made the templates disappear from a worker that ran inside it and
        -- not from a process that did not. `source` falls through the same way for
        -- the same reason.
        if #found > 0 then
            table.sort(found)
            return found
        end
    end
    local found, pending = {}, {prefix}
    while #pending > 0 do
        local relative = table.remove(pending) as string
        local entries = files.list(bundled.moduleDir() .. relative)
        if entries then
            for name, kind in entries do
                local child = relative .. "/" .. name
                if kind == "directory" then
                    pending[#pending + 1] = child
                elseif kind == "file" then
                    found[#found + 1] = child
                end
            end
        end
    end
    table.sort(found)

    return found
end

export = resource
