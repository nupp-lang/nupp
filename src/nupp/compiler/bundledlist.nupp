module nupp.compiler.bundledlist

-- Directory traversal for carried resources. Kept outside `bundled` so the
-- in-memory compiler can read embedded declarations without importing host I/O.

local bundled = require("nupp.compiler.bundled")
const files = require("io.internal.files")
local resource: any = {source = bundled.source,}

-- The files under `directory`, spelled as `prefix` and the path below it.
local function walk(directory: string, prefix: string): {string}
    local found, pending = {}, {""}
    while #pending > 0 do
        local below = table.remove(pending) as string
        local entries = files.list(directory .. below)
        if entries then
            for name, kind in entries do
                local child = below .. "/" .. name
                if kind == "directory" then
                    pending[#pending + 1] = child
                elseif kind == "file" then
                    found[#found + 1] = prefix .. child
                end
            end
        end
    end

    return found
end

function resource.list(prefix: string): {string}
    local embedded = package.preload["nupp.embedded"]
    -- A preload may answer nothing: the command line's root installs one that
    -- does on a host that carries no resources.
    local carried = embedded and embedded()
    -- Only when it answered. A table carrying some of what the compiler carries
    -- is not proof that it carries all of it: the test binary embeds the modules
    -- and not the templates, and reading "no entries under this prefix" as "there
    -- are none" made the templates disappear from a worker that ran inside it and
    -- not from a process that did not. `source` falls through the same way for
    -- the same reason.
    local base = prefix:gsub("/$", "")
    local found = carried and bundled.embeddedUnder(carried, prefix) or {}
    if #found == 0 then
        found = walk(bundled.moduleDir() .. base, base)
    end
    -- Nothing beside the modules, as for a compiler running from an image or
    -- the native core: the checkout's copy, which `source` also reads.
    local directory = #found == 0 and bundled.sourceDirectory(prefix) or nil
    if directory ~= nil then
        found = walk(directory, base)
    end
    table.sort(found)

    return found
end

export = resource
