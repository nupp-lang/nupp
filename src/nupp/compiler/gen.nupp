--[[
Type erasure: a checked CST, lowered to LuaJIT 2.1 Lua.

The invariant is that generated code never changes the line count. Tokens are
emitted at their source lines, where a cursor inserts newlines to catch up and
never goes back, so an `@file.nupp` chunkname gives correct stack traces with no
sourcemap machinery at all.

Erased outright: type annotations, type declarations, generics, `as` casts, and
`@` annotations, though the statement an annotation decorated remains.

Most of the syntax Nupp takes from LuaJIT 3.0 is written out unchanged, because
LuaJIT 2.1 backported it: the bit operators, the customary spellings, `?:`,
`?.`, `??`, compound assignment, `continue`, `const`, short functions and
underscores in numerals. Passing them through is not only shorter code, it is
better code, since a native `?.` is one branch where the equivalent lowering was a
closure call.

Lowered, because this runtime does not have them:

- `a // b` and `a //= b`, floor division, which 2.1 did not backport;
- `...name`, the named vararg, which 2.1 did not backport either, to the
  `{ n = select("#", ...), ... }` table it stands for;
- `a ??= b`, which is a Nupp extension LuaJIT declined;
- an interpolated string, a Nupp extension, to a concatenation through
  `tostring`;
- `e is T` to a `type()` comparison, with nil compared directly.

The floor of what runs generated output is therefore LuaJIT 2.1.1784535649,
the first build with the backported operators.

Code generation reports `NUPP3xxx` when a checked construct cannot be
represented.
]]

local cst = require("nupp.compiler.cst")
local predicate = require("nupp.compiler.predicate")
local switchplan = require("nupp.compiler.switchplan")
local stdlib = require("nupp.compiler.stdlib")
local cabi = require("nupp.compiler.cabi")

local gen = {}

-- These are the nodes a block may execute directly. Coverage deliberately stays at
-- statement boundaries: putting a probe in every expression is both less useful to a
-- reader and much harder to prove preserves Lua's evaluation order.
local COVERAGE_STATEMENTS = {
    localStmt = true,
    assignStmt = true,
    compoundAssign = true,
    callStmt = true,
    ifStmt = true,
    whileStmt = true,
    fornumStmt = true,
    forinStmt = true,
    repeatStmt = true,
    doStmt = true,
    funcStmt = true,
    returnStmt = true,
    breakStmt = true,
    continueStmt = true,
    gotoStmt = true,
    withStmt = true,
    unsafeStmt = true,
    noSuspendStmt = true,
    effectRegionStmt = true,
    switchYieldStmt = true,
}

-- Node kinds that exist only in the type layer: emitted as nothing.
local TYPE_KINDS = {
    tname = true,
    topt = true,
    tptr = true,
    tunion = true,
    tintersection = true,
    tarray = true,
    tmap = true,
    ttuple = true,
    tshape = true,
    tshapeField = true,
    tfunc = true,
    tfuncParam = true,
    tparen = true,
    errorType = true,
    tpredicate = true,
    tborrows = true,
    tpreserves = true,
    tliteral = true,
    tconst = true,
    tcarray = true,
    generics = true,
    -- A pack reaches here whole when it has a tail -- `...integer`, `T...` -- since
    -- only tailless packs are spliced. Its `...` is as much type material as the type
    -- beside it, and without this the token was emitted into the function's body.
    tpack = true,
    tpackUnion = true,
    captureClause = true,
    -- A comptime call in type position, `local v: Optional(string)`. It reduced while
    -- the program was checked and names no runtime function, so its call parentheses
    -- are type material; without this they were emitted as `local v ( ) = nil`.
    ttypecall = true,
}

-- Erased declarations. recordDecl is conditional: declKind == "struct" reifies to
-- ffi.typeof instead (M3).
local DECL_KINDS = {recordDecl = true, typeAlias = true,}

-- C type names for reifiable primitive fields.
local CP -- assigned to C_PRIM below (cdefCType is defined first)

-- Maps a syntactic type node to a C type string for cdef emission. Uses checker hints
-- (cdefName) for named C structs. Returns nil when the type has no C spelling.
local function cdefCType(t)
    if t.resolvedType then
        local rendered = cabi.declaration(t.resolvedType, "", "ffi")
        if rendered then
            return rendered
        end
    end
    if t.kind == "topt" then
        t = t.inner
    end
    if t.kind == "tname" then
        local name = t.base.text
        if name == "cstring" then
            return "const char *"

        elseif name == "voidptr" then
            return "void *"
        end
        -- Status wrappers say when a C result is valid and do not change the ABI.
        if (name == "Success" or name == "Failure") and t.typeArgs and t.typeArgs[1] then
            return cdefCType(t.typeArgs[1])
        end
        if t.cdefName then
            return (t.cdefKind or "struct") .. " " .. t.cdefName
        end
        return CP[name]
    elseif t.kind == "tconst" then
        local inner = cdefCType(t.inner)
        if inner then
            return "const " .. inner
        end
    elseif t.kind == "tcarray" then
        -- `T[?]` and `T[N]` spell as C writes them. A cast is the exception, and the
        -- caller below handles it: LuaJIT has no cast to a variable-length array, and a
        -- pointer is what viewing memory as one means anyway.
        local element = cdefCType(t.element)
        if element then
            return element .. "[" .. (t.count and cst.textOf(t.count) or "?") .. "]"
        end
    elseif t.kind == "tptr" then
        local inner = cdefCType(t.inner)
        if inner then
            return inner .. " *"
        end
    elseif t.kind == "tfunc" then
        local params = {}
        for _, param in ipairs(t.params or {}) do
            if param.type then
                local rendered = cdefCType(param.type)
                if not rendered then
                    return nil
                end
                params[#params + 1] = rendered
            elseif param.vararg or param[1] and cst.isToken(param[1]) and param[1].kind == "..." then
                params[#params + 1] = "..."
            end
        end
        local ret = "void"
        if t.rets and #t.rets > 0 then
            if #t.rets > 1 then
                return nil
            end
            ret = cdefCType(t.rets[1])
            if not ret then
                return nil
            end
        end
        return ("%s (*)(%s)"):format(ret, #params > 0 and table.concat(params, ", ") or "void")
    end

    return nil
end

local C_PRIM = {
    number = "double",
    float = "float",
    boolean = "bool",
    integer = "int32_t",
    int8 = "int8_t",
    int16 = "int16_t",
    int32 = "int32_t",
    int64 = "int64_t",
    uint8 = "uint8_t",
    uint16 = "uint16_t",
    uint32 = "uint32_t",
    uint64 = "uint64_t",
}
CP = C_PRIM

-- The two compound assignments this runtime does not have. Every other one is written
-- out as it was read.
local LOWERED_COMPOUND = {["//="] = true, ["??="] = true}

-- Where a constructor lands on a record's runtime table. It has to be reachable from a
-- call in another module, and that table is the one thing about a record that already
-- crosses; a registry keyed by name would be a link step the language does not have.
-- The prefix keeps it out of the way of declared fields.
local CONSTRUCTOR_MEMBER = "__nuppCtor"

local function constructorMember(index)
    return CONSTRUCTOR_MEMBER .. tostring(index or 1)
end

-- `is` targets checkable with type(); sized numerics approximate to number.
local IS_TYPE = {
    string = "string",
    number = "number",
    boolean = "boolean",
    table = "table",
    thread = "thread",
    userdata = "userdata",
    integer = "number",
    float = "number",
    int8 = "number",
    int16 = "number",
    int32 = "number",
    int64 = "number",
    uint8 = "number",
    uint16 = "number",
    uint32 = "number",
    uint64 = "number",
    ["function"] = "function", -- spelled via tfunc, handled separately
}

-- Converts an interpolated-string literal chunk to a quoted Lua string. Source escapes
-- (\n, \t, ...) pass through; \` and \$ lose their backslash (Lua doesn't know them);
-- bare " and raw newlines get escaped.
local literal = {}

function literal.quote(s)
    s = s:gsub("\\([`$])", "%1")
    s = s:gsub('"', '\\"')
    s = s:gsub("\n", "\\n")
    return '"' .. s .. '"'
end

--- A long-string token's runtime bytes after `dedent` removes incidental indentation.
--- The closing delimiter's indentation is the margin when it is on its own line;
--- otherwise the longest common content indentation is used. Lua already ignores the
--- first newline after a long-string opener; this mirrors that rule before stripping
--- the margin and renders the result as a normal quoted Lua literal.
local function dedentLongString(text)
    local equals = text:match("^%[(=*)%[")
    if equals == nil then
        return text
    end
    local delimiterLength = #equals + 2
    local body = text:sub(delimiterLength + 1, #text - delimiterLength)
    body = body:gsub("\r\n", "\n"):gsub("\r", "\n")
    if body:sub(1, 1) == "\n" then
        body = body:sub(2)
    end
    local margin = body:match("\n([ \t]*)$")
    if margin then
        body = body:sub(1, #body - #margin)
    else
        --- The common byte prefix keeps mixed tabs and spaces unambiguous: only the
        --- indentation text every nonblank line actually shares is removed.
        for line in (body .. "\n"):gmatch("([^\n]*)\n") do
            if line:find("[^ \t]") then
                local indent = line:match("^[ \t]*") or ""
                if margin == nil then
                    margin = indent
                else
                    local length = math.min(#margin, #indent)
                    local shared = 0
                    while shared < length and margin:sub(
                        shared + 1,
                        shared + 1
                    ) == indent:sub(shared + 1, shared + 1) do
                        shared = shared + 1
                    end
                    margin = margin:sub(1, shared)
                end
            end
        end
    end
    if margin and #margin > 0 then
        local function strip(line)
            if line:sub(1, #margin) == margin then
                return line:sub(#margin + 1)
            end
            return line
        end

        local first = body:match("^[^\n]*") or ""
        body = strip(first) .. body:sub(#first + 1):gsub("\n([^\n]+)", function(line)
            return "\n" .. strip(line)
        end)
    end

    return body
end

--- Renders closed compiler-owned data as one Lua expression. Keys are sorted so equal
--- values produce byte-identical output regardless of table iteration.
--- @raises when the value contains a non-data value or a cycle
function literal.renderData(value: any): string
    local recipeCodec = require("nupp.compiler.materialize.codec")
    local rendered, why = recipeCodec.render(value)
    if not rendered then
        error("invalid closed compiler data: " .. tostring(why))
    end

    return rendered
end

-- The runtime name of a declaration written with a qualified name, which is an ordinary
-- field assignment: `record M.Point` lands on `M.Point`. Unqualified declarations have
-- no path and keep their storage decided by visibility.
local function declPath(x)
    if not x.qualifiers then
        return nil
    end
    local parts = {}
    for _, token in ipairs(x.qualifiers) do
        parts[#parts + 1] = token.text
    end
    parts[#parts + 1] = x.name.text

    return table.concat(parts, ".")
end

--- What `generate` lowers: a parse the checker has already been over. The side effects
--- are the checker's rather than the parser's, which is why this is not
--- `parser.ParseResult`, since a generator that took one would be claiming it runs
--- before checking, which it never does.
type gen.Checked = {
    readonly root: cst.Chunk,
    readonly tokens: {any}?,
    readonly implicitSideEffects: {[string]: any}?,

    --- What the checker resolved this file to, and the native features it recorded.
    readonly moduleName: string?,
    readonly effects: {[string]: any}?,
    readonly preludeRuntime: string?
}

--- How a coverage build is asked for: `true` to instrument and name the file after
--- `filename`, or a table naming the path the report should attribute sites to.
type gen.CoverageRequest = {path: string?}

--- What a coverage build needs back: where the file was, and every site it may report
--- having reached.
type gen.Coverage = {
    path: string?,
    sites: {any}
}

--- Development-only generation selected explicitly by the watch compiler.
--- Ordinary generation never constructs one, which keeps its emitter path and
--- generated bytes unchanged.
type gen.HotRequest = {
    mode: 'initial' | 'patch',
    module: string?,
    baseGeneration: integer?,
    only: {[string]: boolean}?,
    libraries: {[string]: string}?
}

type gen.HotMetadata = {
    module: string,
    mode: string,
    baseGeneration: integer?,
    functions: {any},
    structure: string
}

--- Lowers a checked parse to LuaJIT source, with the diagnostics lowering produced.
---
--- `coverage` is an internal build setting: absent on ordinary compiles, so the normal
--- emission path remains byte-for-byte what it was before coverage existed. In coverage
--- mode the third return is the source-site manifest. The fourth return is the exact
--- runtime-feature set observed while writing the generated body.
function gen.generate(
    result: gen.Checked,
    filename: string?,
    coverage: (boolean | gen.CoverageRequest)?,
    hot: gen.HotRequest?
): string, {any}, gen.Coverage?, {[string]: boolean}, gen.HotMetadata?
    local out = {}
    local curLine = 1
    local atLineStart = true
    local diags = {}
    -- Runtime features follow generated code, not the checker's source-level
    -- inventory. `emit` may erase a comptime block, a folded branch, or another
    -- checked construct before any of its children reach the output. Recording a
    -- feature at the point its consumer is written keeps the prologue equal to what
    -- the generated body actually needs.
    local emittedFeatureEffects: {[string]: boolean} = {}
    local function needRuntimeEffect(effect: string): nil
        emittedFeatureEffects[effect] = true
    end

    local tempCounter = 0
    local usedNames = {}
    for _, tok in ipairs(result.tokens or {}) do
        if tok.kind == "name" then
            usedNames[tok.text] = true
        end
    end
    local function nextTemp()
        local name
        repeat
            tempCounter = tempCounter + 1
            name = "__nuppT" .. tempCounter
        until not usedNames[name]
        usedNames[name] = true

        return name
    end

    local needsMetatypeOnce = false
    local metatypeOnceName
    -- Structs that have to be emitted as a named C tag rather than an anonymous ctype,
    -- keyed by declaration name. See `planStructTags`.
    local structTag = {}
    local structTagOrder = {}

    -- Which structs cannot be anonymous.
    --
    -- A nested struct is spelled by substituting its ctype into an anonymous one:
    -- `ffi.typeof("struct { $ *next; }", Node)`. That works only when the ctype already
    -- exists, so a struct pointing at itself, or at one declared below it, passed nil
    -- and the module died at load -- which is every linked list and tree.
    --
    -- C names the struct and forward-declares the tag, and so does this. Only the
    -- targets that need it are named, and only pointers to them change spelling, so a
    -- program without a forward or self reference generates exactly what it did.
    local function planStructTags()
        local structs, indexOf = {}, {}
        local function collect(node)
            if not node or cst.isToken(node) then
                return
            end
            if node.kind == "recordDecl" and node.declKind == "struct" and node.name then
                structs[#structs + 1] = node
                indexOf[node.name.text] = #structs
            end
            for _, child in ipairs(node) do
                collect(child)
            end
        end

        collect(result.root)
        -- A C tag is process-global and `ffi.cdef` refuses to redefine one, so the tag
        -- has to be unique per declaration -- two modules each with a `Node` would
        -- otherwise collide, the second `cdef` would be swallowed by its pcall, and the
        -- second module would silently get the first one's layout.
        --
        -- Derived from the module, the name, and the declaration's own field spelling,
        -- so it is stable across rebuilds (which `fixpoint` requires) and differs
        -- whenever the layout does. Two identical declarations sharing a tag is
        -- correct: same body, same layout.
        local moduleTag = (result.moduleName or filename or ""):gsub("[^%w]", "_")
        local function digest(text)
            local h = 2166136261
            for i = 1, #text do
                h = bit.bxor(h, text:byte(i))
                h = bit.band(h * 16777619, 0xffffffff)
            end

            return ("%08x"):format(bit.band(h, 0x7fffffff))
        end

        local function tagFor(name)
            if structTag[name] then
                return structTag[name]
            end
            local decl = structs[indexOf[name]]
            local shape = {}
            for _, entry in ipairs(decl and decl.entries or {}) do
                if entry.kind == "fieldDecl" and entry.name then
                    shape[#shape + 1] = entry.name.text
                end
            end
            local tag = "__nuppS_" .. name .. "_" .. digest(moduleTag .. "|" .. name .. "|" .. table.concat(shape, ","))
            structTag[name] = tag
            structTagOrder[#structTagOrder + 1] = tag

            return tag
        end

        -- The struct a field names, whether it is held by value or by pointer.
        local function referent(entry)
            local t = entry.type
            if not t then
                return nil
            end
            if t.kind == "topt" then
                t = t.inner
            end
            if t.kind == "tptr" then
                t = t.inner
            end
            local leaf = t and t.kind == "tname" and cst.lastName(t) or nil
            if leaf and indexOf[leaf] then
                return leaf
            end

            return nil
        end

        -- Seed: a pointer that reaches at or after itself. A pointer backwards reaches
        -- a ctype that already exists and keeps today's spelling.
        for at, decl in ipairs(structs) do
            for _, entry in ipairs(decl.entries or {}) do
                if entry.kind == "fieldDecl" and entry.type then
                    local t = entry.type
                    if t.kind == "topt" then
                        t = t.inner
                    end
                    if t.kind == "tptr" and t.inner and t.inner.kind == "tname" then
                        local target = cst.lastName(t.inner)
                        local targetAt = target and indexOf[target] or nil
                        if targetAt and targetAt >= at then
                            tagFor(target as string)
                        end
                    end
                end
            end
        end

        -- Then close over it. A named struct is written with `ffi.cdef`, which has no
        -- `$` substitution -- that is a `ffi.typeof` feature -- so every struct a
        -- tagged one names has to be spellable as a tag too, by value or by pointer.
        -- Iterating to a fixed point costs one pass per newly tagged struct.
        local changed = true
        while changed do
            changed = false
            for _, decl in ipairs(structs) do
                if structTag[decl.name.text] then
                    for _, entry in ipairs(decl.entries or {}) do
                        local target = entry.kind == "fieldDecl" and referent(entry)
                        if target and not structTag[target] then
                            tagFor(target)
                            changed = true
                        end
                    end
                end
            end
        end
    end

    local needsFfi = false
    local needsArrayCache = false
    local needsCArrayIndex = false
    local carrayIndexName
    local needsLibs = false
    local needsNewTab = false
    local needsClearTab = false
    local needsCloneTab = false
    local compilerModules: {[string]: string} = {}
    local compilerModuleOrder: {string} = {}
    local needsLayout = false
    local layoutName
    local needsSuspension = false
    local suspensionName
    local needsCleanupRegistry = false
    local cleanupRegistryName
    local cleanupResolvers = {}
    local cleanupResolverOrder = {}
    local newTabName, clearTabName, cloneTabName
    local needsCleanupRegions = false
    local cleanupPackName, cleanupIdName, cleanupFailureName
    -- Generated cleanup regions call library functions by name, so those names are
    -- bound
    -- as locals on the hoisted first line: a user local called `unpack` or `error`
    -- would otherwise shadow them at the point of use.
    local cleanupGlobals
    -- One table holds every shareable region, each site owning an index, so the count
    -- of cleanup sites in a file cannot exhaust Lua's limit on locals per function.
    local cleanupCacheName
    local cleanupCacheSites = 0
    local cleanupStack = {}
    local emitDepth = {loop = 0, fn = 0}
    local coverageOn = coverage == true or type(coverage) == "table"
    local coveragePath = coverageOn and (
        type(coverage) == "table" and (coverage as gen.CoverageRequest).path or filename
    ) or nil
    local coverageSites: {any}? = nil
    local coverageSiteCount = 0
    local coverageName
    -- One table behind one upvalue: the main emitter is already close to LuaJIT's
    -- 60-upvalue ceiling when coverage is present.
    local hotState: any = hot and {
        mode = hot.mode,
        module = hot.module or result.moduleName or filename or "<chunk>",
        baseGeneration = hot.baseGeneration,
        functions = {},
        byNode = setmetatable({}, {__mode = "k"}),
        allByNode = setmetatable({}, {__mode = "k"}),
        captures = {},
        only = hot.only,
        structure = {},
        policies = {},
        libraries = hot.libraries or {},
    } or nil

    local function reservedName(preferred)
        if not usedNames[preferred] then
            usedNames[preferred] = true
            return preferred
        end

        return nextTemp()
    end

    local function compactSource(node): string
        if not node then
            return ""
        end
        return (cst.textOf(node):gsub("%s+", ""))
    end

    local function hotSignature(body, implicitSelf): string
        local parts: {string} = {implicitSelf and "method(" or "function("}
        for index, param in ipairs(body and body.params or {}) do
            if index > 1 then
                parts[#parts + 1] = ","
            end
            parts[#parts + 1] = compactSource(param)
        end
        parts[#parts + 1] = "):"
        parts[#parts + 1] = compactSource(body and body.returnPack)

        return table.concat(parts)
    end

    local function hotFunctionName(node): string?
        if node.kind == "localFuncStmt" and node.name then
            return node.name.text
        elseif node.kind == "funcStmt" and node.name then
            return compactSource(node.name)
        elseif node.kind == "inlineMethod" and node.name then
            return node.overloadMember or node.name.text
        end

        return nil
    end

    local function hotSelfReference(node): boolean
        local definition = node.kind == "localFuncStmt" and node.name and node.name.definition or nil
        if not definition then
            return false
        end
        local found = false
        local function walk(child)
            if found or not child or cst.isToken(child) then
                return
            end
            if child.kind == "name" and child.token and child.token.definition == definition then
                found = true
                return
            end
            for _, nested in ipairs(child) do
                walk(nested)
            end
        end

        walk(node.body and node.body.body)

        return found
    end

    local function hotOuterCaptures(node): {string}
        local captures = {}
        local first = cst.firstToken(node)
        local last = cst.lastToken(node)
        local firstOffset = first and first.offset or 0
        local lastOffset = last and last.offset or firstOffset
        local own = node.kind == "localFuncStmt" and node.name and node.name.definition or nil
        local function walk(child)
            if not child or cst.isToken(child) then
                return
            end
            if child.kind == "name" and child.token and child.token.definition then
                local definition = child.token.definition
                local token = definition.token
                if definition ~= own and token and token.line ~= 0 and (
                    token.offset < firstOffset or token.offset > lastOffset
                ) then
                    captures[token.text] = true
                end
            end
            for _, nested in ipairs(child) do
                walk(nested)
            end
        end

        walk(node.body)
        local names = {}
        for name in pairs(captures) do
            names[#names + 1] = name
        end
        table.sort(names)

        return names
    end

    --- Keyed C uses belonging to one retained implementation. Checked direct C
    --- declarations carry an identity; any foreign call the checker cannot join to
    --- one deliberately selects the module-wide fallback in the session.
    local function hotCUses(node): ({string}, boolean)
        local used, unknown = {}, false
        local function walk(child)
            if not child or cst.isToken(child) then
                return
            end
            if child.cdefIdentity then
                used[child.cdefIdentity] = true
            elseif child.kind == "name"
                and child.token
                and child.token.definition
                and child.token.definition.cdefIdentity
            then
                used[child.token.definition.cdefIdentity] = true
            elseif child.cdefCall or child.cdefDeclarationBlock or child.cheaderCdef then
                unknown = true
            end
            if (child.kind == "cdefFunc" or child.kind == "cdefStruct") and child.cdefIdentity then
                used[child.cdefIdentity] = true
            end
            for _, nested in ipairs(child) do
                walk(nested)
            end
        end

        walk(node.body)
        local identities = {}
        for identity in pairs(used) do
            identities[#identities + 1] = identity
        end
        table.sort(identities)

        return identities, unknown
    end

    local function planHotFunction(node, owner): nil
        if not hotState or not node.body or hotState.allByNode[node] then
            return
        end
        local name = hotFunctionName(node)
        if not name then
            return
        end
        local implicitSelf = node.kind == "funcStmt"
            and node.name
            and node.name.method ~= nil
            or node.kind == "inlineMethod"
            and not node.inlineStatic
        local slot = #hotState.functions + 1
        local kind = node.kind == "localFuncStmt" and "local" or node.kind == "inlineMethod" and "inline" or "field"
        local id = table.concat({hotState.module, owner or "module", kind, name}, "/")
        local captures = hotOuterCaptures(node)
        local affine = node.affineInitializer ~= nil or node.body and #(node.body.takenCaptures or {}) > 0
        local affineCapture = affine and node.body and node.body.takenCaptures and node.body.takenCaptures[
            1
        ] and node.body.takenCaptures[1].name or nil
        local cUses, cUnknown = hotCUses(node)
        local planned = {
            node = node,
            slot = slot,
            id = id,
            name = node.hotRuntimeName or name,
            authoredName = name,
            selfName = node.kind == "localFuncStmt" and name or nil,
            selfRecursive = hotSelfReference(node),
            signature = hotSignature(node.body, implicitSelf),
            implicitSelf = implicitSelf,
            captures = captures,
            implementation = compactSource(node.body and node.body.body),
            patchable = not affine,
            affineCapture = affineCapture,
            cUses = cUses,
            cUnknown = cUnknown,
        }
        hotState.functions[slot] = planned
        hotState.allByNode[node] = planned
        if planned.patchable then
            hotState.byNode[node] = planned
        end
        for _, capture in ipairs(captures) do
            hotState.captures[capture] = true
        end
    end

    local function planHotRoot(): nil
        if not hotState then
            return
        end
        local function rootStatement(node)
            if node and node.kind == "pragmaStmt" then
                node = node.stat
            end
            if node and (node.kind == "localFuncStmt" or node.kind == "funcStmt") then
                if node.kind == "funcStmt" and node.structOwner and node.memberName then
                    node.hotRuntimeName = "__nuppMt_" .. node.structOwner .. ".__index" .. (
                        node.name and node.name.method and ":" or "."
                    ) .. node.memberName
                end
                planHotFunction(node, "module")
            elseif node and node.kind == "recordDecl" then
                local runtimeOwner = declPath(node) or node.name and node.name.text
                if node.declKind == "struct" then
                    runtimeOwner = "__nuppMt_" .. node.name.text .. ".__index"
                end
                for _, entry in ipairs(node.entries or {}) do
                    if entry.kind == "inlineMethod" then
                        local member = entry.overloadMember or entry.name.text
                        entry.hotRuntimeName = runtimeOwner .. (entry.inlineStatic and "." or ":") .. member
                        planHotFunction(entry, "record:" .. tostring(runtimeOwner))
                    end
                end
            end
        end

        for _, node in ipairs(result.root) do
            if not cst.isToken(node) then
                if node.kind == "block" then
                    for _, statement in ipairs(node.stats or node) do
                        if not cst.isToken(statement) then
                            rootStatement(statement)
                        end
                    end
                else
                    rootStatement(node)
                end
            end
        end
        for _, node in ipairs(result.root) do
            if not cst.isToken(node) then
                local statements = node.kind == "block" and (node.stats or node) or {node}
                for _, statement in ipairs(statements) do
                    if not cst.isToken(statement) then
                        local actual = statement.kind == "pragmaStmt" and statement.stat or statement
                        local planned = actual and hotState.allByNode[actual]
                        local structural = actual
                        while structural and structural.kind == "pragmaStmt" do
                            structural = structural.stat
                        end
                        if planned then
                            hotState.structure[#hotState.structure + 1] = "function\0" .. planned.id
                        elseif structural and (structural.kind == "cdefFunc" or structural.kind == "cdefStruct") then
                            -- Keyed checked C metadata owns declaration presence,
                            -- semantics, and runtime-binding compatibility. Keeping
                            -- source spelling in the structural stream would turn a
                            -- harmless reorder into a restart before that comparison.
                        else
                            local shape = compactSource(statement)
                            local first, last = cst.firstToken(statement), cst.lastToken(statement)
                            for _, nested in ipairs(hotState.functions) do
                                local nestedFirst, nestedLast = cst.firstToken(nested.node), cst.lastToken(nested.node)
                                if first
                                    and last
                                    and nestedFirst
                                    and nestedLast
                                    and nestedFirst.offset >= first.offset
                                    and nestedLast.offset <= last.offset
                                    and nested.implementation ~= ""
                                then
                                    local pattern = nested.implementation:gsub("([^%w])", "%%%1")
                                    shape = shape:gsub(pattern, "<body>", 1)
                                end
                            end
                            hotState.structure[#hotState.structure + 1] = shape
                        end
                    end
                end
            end
        end
        hotState.slotsExpr = reservedName("__nuppHotSlots")
    end

    planHotRoot()

    local helpers = {byBody = {}, order = {}}
    -- Switch maps are closed compiler data, declared once on the generated prologue's
    -- one physical line. A bounded number receive direct locals. Later maps share one
    -- indexed table, so a source file with many switches does not turn each map into a
    -- new captured name in every function that reads one.
    local PROLOGUE_CONSTANT_LOCALS = 32
    local constants = {byBody = {}, order = {}, spilled = {}, spillName = nil}

    -- A function the generated module declares once, for work that would otherwise be
    -- written as a function where it is used.
    --
    -- LuaJIT does not record `FNEW`. A loop containing one aborts recording, is
    -- blacklisted after enough attempts, and then never compiles at all -- so a
    -- function
    -- built per evaluation costs the whole enclosing loop its trace, not only its own
    -- allocation. Declared once, it is a call instead, which a trace inlines.
    --
    -- Only for a body that depends on nothing but its parameters. A site that assigns
    -- to
    -- one of its own locals -- the ownership lowering's `active` flags do -- cannot
    -- share
    -- one, because Lua gives no way to hand another function's local over to be
    -- written.
    --
    -- Bodies that render alike share a declaration, which is what makes this cheap to
    -- reach for: two sites doing the same thing cost one function between them.
    local function declareHelper(prefix: string, params: string, body: string): string
        local key = params .. "|" .. body
        local name = helpers.byBody[key]
        if not name then
            name = reservedName(prefix .. tostring(#helpers.order + 1))
            helpers.byBody[key] = name
            helpers.order[#helpers.order + 1] = {name = name, params = params, body = body}
        end

        return name
    end

    local function declareConstant(prefix: string, body: string): string
        local found = constants.byBody[body]
        if found then
            return found
        end
        local name
        if #constants.order < PROLOGUE_CONSTANT_LOCALS then
            name = reservedName(prefix .. tostring(#constants.order + 1))
            constants.order[#constants.order + 1] = {name = name, body = body}
        else
            constants.spillName = constants.spillName or reservedName("__nuppSwitchConstants")
            local index = #constants.spilled + 1
            constants.spilled[index] = body
            name = constants.spillName .. "[" .. tostring(index) .. "]"
        end
        constants.byBody[body] = name

        return name
    end

    -- A module projected through a builtin namespace is required once per generated
    -- module. Reserved rather than assumed, so a user local with the preferred name
    -- does not collide with it. OPT-5 reaches string.buffer through the same registry.

    local function compilerModuleName(moduleName: string): string
        if moduleName == "nupp.log" then
            -- Intrinsic logging lowering may consume the original field access before
            -- it reaches ordinary node emission. Requesting the generated module view
            -- is the surviving operation that needs the ambient logging installer.
            needRuntimeEffect("stdlib.log")
        end
        local name = compilerModules[moduleName]
        if not name then
            local preferred = moduleName == "string.buffer" and "__nuppBuffer" or "__nuppModule"
            name = reservedName(preferred)
            compilerModules[moduleName] = name
            compilerModuleOrder[#compilerModuleOrder + 1] = moduleName
        end

        return name as string
    end

    local function metatypeHelper()
        needsMetatypeOnce = true
        metatypeOnceName = metatypeOnceName or reservedName("__nuppMetatype")
        return metatypeOnceName
    end

    local function concatBufferName()
        return compilerModuleName("string.buffer")
    end

    -- The suspension runtime, bound once per module that installs a handler, the way
    -- `string.buffer` is. A file that never writes `handle suspension` requires
    -- nothing.
    local function suspensionModule()
        needsSuspension = true
        needRuntimeEffect("runtime.suspension")
        suspensionName = suspensionName or reservedName("__nuppSuspension")

        return suspensionName
    end

    local function tableIntrinsicName(name)
        if name == "new" then
            needsNewTab = true
            newTabName = newTabName or reservedName("__nuppNew")

            return newTabName
        elseif name == "clone" then
            needsCloneTab = true
            cloneTabName = cloneTabName or reservedName("__nuppClone")

            return cloneTabName
        end
        needsClearTab = true
        clearTabName = clearTabName or reservedName("__nuppClear")

        return clearTabName
    end

    local function cleanupRegistry()
        needsCleanupRegistry = true
        cleanupRegistryName = cleanupRegistryName or reservedName("__nuppCleanups")

        return cleanupRegistryName
    end

    local function cleanupFunctionName(cleanup)
        local found = cleanupResolvers[cleanup.id]
        if found then
            return found
        end
        local name = reservedName("__nuppCleanup" .. tostring(#cleanupResolverOrder + 1))
        cleanupResolvers[cleanup.id] = name
        cleanupResolverOrder[#cleanupResolverOrder + 1] = {cleanup = cleanup, name = name}
        cleanupRegistry()

        return name
    end

    local function cleanupCall(cleanup, value)
        if cleanup.kind == "function" then
            return cleanupFunctionName(cleanup) .. "(" .. value .. ")"
        elseif cleanup.kind == "closure" then
            return value .. ":__nuppRelease()"
        elseif cleanup.kind == "method" then
            return value .. ":" .. cleanup.name .. "()"
        elseif cleanup.kind == "field" then
            return cleanupCall(cleanup.cleanup, value .. "." .. cleanup.field)
        end

        return nil
    end

    -- The names the emitted cleanup runtime is reached through. A file gets them from
    -- whichever construct needs them first -- a cleanup region, or an `attemptAll` in a
    -- file with no region at all -- and every later one reuses the same set.
    local function ensureCleanupRuntime()
        needsCleanupRegions = true
        if cleanupPackName then
            return
        end
        cleanupPackName = nextTemp()
        cleanupIdName = nextTemp()
        cleanupFailureName = nextTemp()
        cleanupCacheName = nextTemp()
        cleanupGlobals = {}
        for _, name in ipairs({"pcall", "xpcall", "error", "unpack", "select", "setmetatable", "tostring", "ipairs"}) do
            cleanupGlobals[name] = nextTemp()
        end
    end

    local function protectedCleanupCall(cleanup, value, pcallName)
        if cleanup.kind == "function" then
            return pcallName .. "(" .. cleanupFunctionName(cleanup) .. "," .. value .. ")"
        elseif cleanup.kind == "closure" then
            local caller = declareHelper("__nuppClosureCleanup", "__nuppV", "return __nuppV:__nuppRelease()")
            return pcallName .. "(" .. caller .. "," .. value .. ")"
        elseif cleanup.kind == "method" then
            -- `pcall(v.m, v)` would read the subject twice, and a field path is one of
            -- the
            -- spellings that reaches here. One declared function keeps it to once
            -- without
            -- building a function per cleanup.
            local caller = declareHelper("__nuppCleanup", "__nuppV", ("return __nuppV:%s()"):format(cleanup.name))
            return pcallName .. "(" .. caller .. "," .. value .. ")"
        elseif cleanup.kind == "field" then
            return protectedCleanupCall(cleanup.cleanup, value .. "." .. cleanup.field, pcallName)
        end

        return nil
    end

    local function diag(tok, code, msg, help)
        diags[
            #diags + 1
        ] = {
            code = code,
            msg = msg,
            filename = filename,
            help = help,
            line = tok and tok.line or 0,
            col = tok and tok.col or 0,
            offset = tok and tok.offset or 0,
            length = tok and #tok.text or 0
        }
    end

    -- Raw append with newline accounting.
    local function raw(s)
        out[#out + 1] = s
        local _, n = s:gsub("\n", "")
        if n > 0 then
            curLine = curLine + n
            atLineStart = s:sub(-1) == "\n"
        elseif #s > 0 then
            atLineStart = false
        end
    end

    -- Advance the cursor to `line` (never backward).
    local function sync(line)
        while line and curLine < line do
            local tail = out[#out]
            if tail then
                out[#out] = tail:gsub("[ \t]+$", "")
            end
            raw("\n")
        end
    end

    -- Emit one piece of code attributed to a source line.
    local function e(text, line)
        sync(line)
        if not atLineStart then
            raw(" ")
        end
        raw(text)
    end

    -- Emits a function this compiler wrote, rather than one the source did.
    --
    -- LuaJIT has no recording for the bytecode that builds a function. A loop
    -- containing
    -- one aborts trace recording, is blacklisted after enough attempts, and then never
    -- compiles at all -- so a lowering that builds a function inside a loop costs that
    -- whole loop its trace, however hot it gets and whatever else is in it. Nothing
    -- observes it: the answers stay right and every test passes. Six lowerings had it
    -- wrong before anyone looked, and `nupp bc --check` found them by reading the
    -- bytecode afterwards. This is that rule enforced before the bytecode exists.
    --
    -- So a lowering building a function inside a loop has to say why it cannot be
    -- declared once instead. Every reason passed today is the same one: the body
    -- assigns
    -- a local belonging to its own site, and Lua gives no way to hand another
    -- function's
    -- local over to be written. A lowering with any other reason does not have one --
    -- declare it for the module with `pluck.declareHelper` and call it.
    --
    -- Saying nothing from inside a loop is a compiler bug and reports itself as one,
    -- because the alternative is emitting code that is correct and never compiles.
    local function loweredFunction(text, line, reason)
        if emitDepth.loop > 0 and not reason then
            error(
                "gen: a lowering built a function inside a loop without saying why. "
                .. "LuaJIT cannot record that, so the loop will never compile. Declare it "
                .. "once with pluck.declareHelper and call it, or pass a reason when the "
                .. "body assigns one of its own site's locals. Emitted: "
                .. tostring(
                    text
                ),
                0
            )
        end
        e(text, line)
    end

    -- OPT-5 finishes where its loop closes: the accumulator becomes the string it would
    -- have been. Every branch that emits a loop has to call this, because two passes
    -- may claim one loop -- OPT-2 rewrites a generic `for` into a numeric one and emits
    -- it somewhere else entirely. Forgetting it in one branch does not fail to
    -- optimize, it leaves the accumulator empty.
    local function finishConcatBuffer(x, line)
        if x.concatBuffer then
            e(("%s = %s:tostring()"):format(x.concatBuffer.target, x.concatBuffer.name), line)
        end
    end

    local function emitDerivedMembers(x, runtimeName)
        local recipe = x.deriveRecipe
        if not recipe then
            return
        end
        for effect in pairs(recipe.effects or {}) do
            needRuntimeEffect(effect)
        end
        local recipeCodec = require("nupp.compiler.materialize.codec")
        local renderedRecipe, renderError = recipeCodec.render(recipe, {limit = recipeCodec.MAX_OUTPUT_BYTES,})
        if not renderedRecipe then
            diag(
                x.name,
                "NUPP2808",
                renderError == "limit" and (
                    "derive output exceeds %d rendered bytes"
                ):format(recipeCodec.MAX_OUTPUT_BYTES) or "derive output recipe is invalid",
                "split the record or write the generated behavior explicitly"
            )
            return
        end
        needRuntimeEffect("stdlib.derives")
        e(";do local __nuppDerived=" .. renderedRecipe)
        e((";local __nuppDerivedEntry=_G.nupp.__derive.register(%q,%s,__nuppDerived)"):format(recipe.key, runtimeName))

        local function forwardingArgument(argument, parameters)
            if argument.kind == "receiver" then
                return "self"
            elseif argument.kind == "entry" then
                return "__nuppDerivedEntry"
            elseif argument.kind == "argument" then
                return parameters[argument.name] or error("invalid derived member argument " .. tostring(argument.name))
            elseif argument.kind == "field" then
                return ("self[%q]"):format(argument.name)
            elseif argument.kind == "constant" then
                local rendered, why = recipeCodec.render(argument.value, {limit = recipeCodec.MAX_OUTPUT_BYTES,})
                if not rendered then
                    error("invalid derived constant: " .. tostring(why))
                end
                return rendered
            elseif argument.kind == "array" then
                local children = {}
                for index, child in ipairs(argument.values or {}) do
                    children[index] = forwardingArgument(child, parameters)
                end
                return "{" .. table.concat(children, ",") .. "}"
            end
            error("unknown derived forwarding argument " .. tostring(argument.kind))
        end

        for _, member in ipairs(recipe.members or {}) do
            if member.operation == "forward.v1" then
                local names, parameters = {}, {}
                local first = 1
                if member.namespace == "instance" then
                    names[1] = "self"
                    first = 2
                end
                for index = first, #(member.paramNames or {}) do
                    local declared = member.paramNames[index]
                    local runtimeParameter = declared ~= "" and declared or ("argument" .. tostring(index - first + 1))
                    names[#names + 1] = runtimeParameter
                    if declared ~= "" then
                        parameters[declared] = runtimeParameter
                    end
                end
                local arguments = {}
                for index, argument in ipairs(member.arguments or {}) do
                    arguments[index] = forwardingArgument(argument, parameters)
                end
                local helper = member.helper.localPath or (
                    "_G.require(" .. string.format(
                        "%q",
                        member.helper.module
                    ) .. ")[" .. string.format("%q", member.helper.member) .. "]"
                )
                e(
                    (
                        ";%s[%q]=function(%s)return %s(%s)end"
                    ):format(runtimeName, member.name, table.concat(names, ","), helper, table.concat(arguments, ","))
                )
            else
                error("unknown derived member operation " .. tostring(member.operation))
            end
        end
        e(" end")
    end

    local emit
    local function sourceLine(node)
        if not node then
            return nil
        end
        if cst.isToken(node) then
            return node.line
        end
        for _, child in ipairs(node) do
            local line = sourceLine(child)
            if line then
                return line
            end
        end

        return nil
    end

    local function soaFieldTarget(target)
        if not target or target.kind ~= "dotIndex" then
            return nil, nil
        end
        local row = target.obj
        if not row or not row.soaRow then
            return nil, nil
        end
        if target.soaField then
            return row, target.soaField.ordinal
        end
        local element = row.soaRow.element
        local wanted = target.name and target.name.text
        if element and element.tag == "nominal" and wanted then
            for ordinal, name in ipairs(element.fieldOrder or {}) do
                if name == wanted then
                    return row, ordinal
                end
            end
        end

        return nil, nil
    end

    --- A numeric `for i = 1, #rows` proves every `rows[i]` access in its
    --- body in bounds. Recording the two source bindings lets generated hot loops
    --- address the already-offset column directly, while every other expression
    --- keeps its checked access and once-only evaluation rules.
    local function soaUncheckedRow(row): boolean
        return row ~= nil and row.indexedDirectAccess == true
    end

    local function soaSlot(view: string, ordinal: integer, index: string, unchecked: boolean): string
        if unchecked then
            return ("%s.columns[%d][%s.offset+%s-1]"):format(view, ordinal, view, index)
        end
        return ("%s.columns[%d][%s:checkedIndex(%s)]"):format(view, ordinal, view, index)
    end

    -- One captured lowering service keeps `emit` under Lua's 60-upvalue ceiling.
    emitDepth.soa = {unchecked = soaUncheckedRow, slot = soaSlot,}

    local function virtualView(node)
        return node
            and node.kind == "name"
            and node.token
            and node.token.definition
            and node.token.definition.virtualIndexedView
            or nil
    end

    local function emitViewRoot(node)
        local view = virtualView(node)
        if view then
            if view.kind == "root" and view.anchorName then
                e(view.anchorName)
            else
                emitViewRoot(view.source)
            end
        else
            emit(node)
        end
    end

    local function emitViewCount(node)
        local view = virtualView(node)
        if view then
            if view.kind == "root" then
                if view.countName then
                    e(view.countName)
                else
                    emit(node)
                end
            elseif view.kind == "slice" then
                e("(")
                emit(node)
                e("-")
                emit(view.first)
                e("+1)")
            else
                emit(node)
            end
        else
            emit(node)
            e(".count")
        end
    end

    local function emitViewOffset(node)
        local view = virtualView(node)
        if view then
            if view.kind == "root" then
                e(view.offsetName or "0")
            else
                emitViewOffset(view.source)
            end
            if view.kind == "slice" then
                e("+")
                e(view.firstName)
                e("-1")
            end
        else
            emit(node)
            e(".offset")
        end
    end

    local function projectedView(node)
        local view = virtualView(node)
        if not view then
            return nil
        end
        if view.kind == "field" then
            return view
        end

        return projectedView(view.source)
    end

    local function rootView(node)
        local view = virtualView(node)
        if not view then
            return nil
        end
        if view.kind == "root" then
            return view
        end

        return rootView(view.source)
    end

    local function emitIndex(index)
        if type(index) == "string" then
            e(index)
        else
            emit(index)
        end
    end

    local function emitCheckedViewIndex(view, index)
        local descriptor = virtualView(view).descriptor
        local message = descriptor.adapter == "soa"
            and "SoA row index out of bounds"
            or descriptor.writable
            and "write span index out of bounds"
            or "span index out of bounds"
        e(compilerModuleName("nupp.mem.indexed") .. "._checkedIndex(")
        emitViewCount(view)
        e(",")
        emitIndex(index)
        e((",%q)"):format(message))
    end

    local function emitSpanSlot(view, index, field, checked)
        local projection = projectedView(view)
        if projection then
            emitViewRoot(projection.source)
            e((".columns[%d]["):format(projection.ordinal))
        else
            local root = rootView(view)
            local producerKind = root and root.producer and root.producer.kind or nil
            if producerKind == "string" then
                needsFfi = true
                e("__nuppFfi.cast(\"const uint8_t *\",")
                emitViewRoot(view)
                e(")[")
            else
                emitViewRoot(view)
                if producerKind ~= "carray" and producerKind ~= "fixed-carray" then
                    e(".pointer")
                end
                e("[")
            end
        end
        emitViewOffset(view)
        e("+")
        if checked then
            emitCheckedViewIndex(view, index)
        else
            emitIndex(index)
        end
        e("-1]")
        if field then
            e("." .. field)
        end
    end

    local function emitSoaSlot(view, ordinal, index, checked)
        emitViewRoot(view)
        e((".columns[%d]["):format(ordinal))
        emitViewOffset(view)
        e("+")
        if checked then
            emitCheckedViewIndex(view, index)
        else
            emitIndex(index)
        end
        e("-1]")
    end

    emitDepth.view = {
        info = virtualView,
        root = emitViewRoot,
        count = emitViewCount,
        offset = emitViewOffset,
        spanSlot = emitSpanSlot,
        soaSlot = emitSoaSlot,
    }

    local function emitRuntimeLayout(spec, line, emitCtype)
        needsLayout = true
        layoutName = layoutName or reservedName("__nuppLayout")
        e(("%s("):format(layoutName), line)
        emitCtype()
        e((", %q, %q, %q"):format(spec.name, spec.spec, spec.printed))
        for _, nestedName in ipairs(spec.nested or {}) do
            e((", %s"):format(nestedName))
        end
        e(")")
    end

    -- Plucking promises that a dotted operand is evaluated once. Calls in
    -- statement-root position receive reusable path bindings as ordinary generated
    -- locals; calls nested in another expression use a local wrapper at their exact
    -- evaluation point. Projected leaves remain in the call because each is read once.
    -- Keep the emitter's plucking dependencies behind one upvalue. LuaJIT caps a
    -- function at 60 upvalues, and this generator deliberately sits close to that
    -- boundary because emit handles every syntax kind.
    -- `declareHelper` rides along here rather than being reached by name, for the
    -- reason
    -- this table exists at all: `emit` was already at exactly 60 upvalues, so one more
    -- name reached from it is one too many. A coverage build finds that first, because
    -- it
    -- instruments the largest function in the compiler and the module then will not
    -- load.
    local pluck = {
        plans = {},
        statementActive = {},
        helpers = helpers,
        declareHelper = declareHelper,
        loweredFunction = loweredFunction,
        emitDerivedMembers = emitDerivedMembers,
        quote = literal.quote,
        renderData = literal.renderData,
        hotLibraries = hot and hot.libraries or {},
        -- Why each lowering that still builds a function inside a loop cannot be
        -- declared once for the module instead. Every one is the same shape: the body
        -- writes a local belonging to its own site, and Lua gives no way to hand
        -- another
        -- function's local over to be written. Anything else has no reason and belongs
        -- in
        -- `declareHelper`.
        --
        -- Named here rather than written at each site so the set can be read in one
        -- place, and carried on this table because `emit` sits at exactly 60 upvalues
        -- and
        -- reaching one more name from it will not load.
        reasons = {
            capture = "the body sets this site's own capture flags",
            reinit = "the body sets this site's own reinit flag",
            move = "the body clears this site's own move flag",
            cheader = "a C header is declared once where it is imported",
            region = "the protected body reads and writes this region's own owners and flags",
        },
    }

    local function dottedPathParts(node): string?, {string}?
        if not node or cst.isToken(node) then
            return nil, nil
        end
        if node.kind == "name" then
            return node.token and node.token.text or nil, {}
        end
        if node.kind ~= "dotIndex" or not node.name then
            return nil, nil
        end
        local root, parts = dottedPathParts(node.obj)
        if not root or not parts then
            return nil, nil
        end
        parts[#parts + 1] = node.name.text

        return root, parts
    end

    local function pluckableCall(call): boolean
        if call.kind == "methodCall" then
            return call.obj ~= nil and call.name ~= nil
        end

        if call.kind ~= "call" and call.kind ~= "safeCall" then
            return false
        end
        if call.kind == "safeCall" then
            return not call.tableIntrinsic
                and not call.ffiOutContracts
                and not call.ownershipIntrinsic
                and not call.ffiIntrinsic
                and not call.carrayElem
                and not call.cheaderCdef
                and not call.constructorCall
                and not call.recordConstruct
                and not call.layoutOf
                and not call.passPinnedPointer
        end

        return not call.ownershipIntrinsic
            and not call.ffiIntrinsic
            and not call.carrayElem
            and not call.cheaderCdef
            and not call.recordConstruct
            and not call.layoutOf
            and not call.passPinnedPointer
    end

    function pluck.callPlan(call): any
        if not pluckableCall(call) or not call.obj or not call.args or not call.args.loweredArgs then
            return nil
        end
        local hasDotted = false
        for _, argument in ipairs(call.args.loweredArgs) do
            if argument.generatedKind == "field" and argument.source and argument.source.kind == "dotIndex" then
                hasDotted = true
                break
            end
        end
        if not hasDotted then
            return nil
        end

        local plan = {
            call = call,
            setupSteps = {},
            afterReceiverSteps = {},
            steps = {},
            pathAliases = {},
            argAliases = {},
            argFields = {},
        }
        plan.delegate = call.staticCallee or call.tableIntrinsic or call.ffiOutContracts or call.constructorCall
        if call.kind == "methodCall" then
            plan.receiverAlias = nextTemp()
            plan.setupSteps[
                #plan.setupSteps + 1
            ] = {kind = "expr", name = plan.receiverAlias, expr = call.obj, at = call.obj}
            plan.methodName = call.overloadMember or call.name.text
            plan.safeReceiver = call.safeObj ~= nil
            if call.safeMethod then
                plan.methodAlias = nextTemp()
                plan.afterReceiverSteps[
                    #plan.afterReceiverSteps + 1
                ] = {
                    kind = "field",
                    name = plan.methodAlias,
                    base = plan.receiverAlias,
                    field = plan.methodName,
                    at = call,
                }
                plan.safeMethod = true
            end
            plan.isSafe = plan.safeReceiver or plan.safeMethod
        elseif call.kind == "safeCall" then
            plan.calleeAlias = nextTemp()
            plan.setupSteps[
                #plan.setupSteps + 1
            ] = {kind = "expr", name = plan.calleeAlias, expr = call.obj, at = call.obj}
            plan.safeCallee = true
            plan.isSafe = true
        elseif call.obj.kind ~= "name" then
            -- A name is already a one-use leaf in the final call. More involved
            -- callees are captured before path bindings so their evaluation point does
            -- not move.
            plan.calleeAlias = nextTemp()
            plan.setupSteps[
                #plan.setupSteps + 1
            ] = {kind = "expr", name = plan.calleeAlias, expr = call.obj, at = call.obj}
        end

        local function bindPath(source): string?
            local root, parts = dottedPathParts(source)
            if not root or not parts then
                return nil
            end
            local base = root
            local key = root
            for _, field in ipairs(parts) do
                key = key .. "\0" .. field
                local alias = plan.pathAliases[key]
                if not alias then
                    alias = nextTemp()
                    plan.pathAliases[key] = alias
                    plan.steps[
                        #plan.steps + 1
                    ] = {kind = "field", name = alias, base = base, field = field, at = source}
                end
                base = alias
            end

            return base
        end

        local lastDotted = 0
        for index, argument in ipairs(call.args.loweredArgs) do
            if argument.generatedKind == "field" and argument.source and argument.source.kind == "dotIndex" then
                lastDotted = index
            end
        end

        for index, argument in ipairs(call.args.loweredArgs) do
            if argument.generatedKind == "field" then
                local base
                if argument.source and argument.source.kind == "name" then
                    base = argument.source.token and argument.source.token.text or nil
                else
                    base = bindPath(argument.source)
                end
                if base then
                    plan.argFields[argument] = {base = base, field = argument.name}
                end
            elseif argument.generatedKind == "expr" and not argument.pack and index < lastDotted then
                -- Only arguments that must stay ahead of a later path binding need a
                -- temporary. The suffix can remain directly in the positional call.
                local alias = nextTemp()
                plan.argAliases[argument] = alias
                plan.steps[#plan.steps + 1] = {kind = "expr", name = alias, expr = argument.expr, at = argument.expr}
            end
        end

        return plan
    end

    function pluck.emitSteps(steps)
        for _, step in ipairs(steps) do
            e("const " .. step.name .. "=", sourceLine(step.at))
            if step.kind == "field" then
                e(step.base .. "." .. step.field)
            else
                emit(step.expr)
            end
            e(";")
        end
    end

    function pluck.directCall(statement)
        local kind = statement.kind
        local direct
        if kind == "callStmt" then
            direct = statement.expr
        elseif (
            kind == "returnStmt" or kind == "localStmt" or kind == "assignStmt"
        ) and statement.exprs and #statement.exprs == 1 then
            direct = statement.exprs[1]
        end

        -- `new` is erased around its constructor call, so it can use the containing
        -- statement's bindings without an expression wrapper too.
        if direct and direct.kind == "newExpr" then
            return direct.call
        end

        return direct
    end

    function pluck.emitArgument(argument, owner)
        local alias = pluck.argumentAliases and pluck.argumentAliases[argument]
        local field = pluck.argumentFields and pluck.argumentFields[argument]
        if alias then
            e(alias, sourceLine(argument.expr or argument.source or owner))
        elseif field then
            e(field.base .. "." .. field.field, sourceLine(argument.source or owner))
        elseif argument.generatedKind == "field" then
            emit(argument.source)
            e("." .. argument.name, sourceLine(argument.source))
        elseif argument.generatedKind == "nil" then
            e("nil", sourceLine(owner))
        else
            emit(argument.expr)
        end
    end

    function pluck.emitArgs(args)
        for j, argument in ipairs(args.loweredArgs or {}) do
            if j > 1 then
                e(",")
            end
            pluck.emitArgument(argument, args)
        end
    end

    function pluck.formatHelper(plan): string
        local params, arguments = {}, {}
        for index, debug in ipairs(plan.debugArguments or {}) do
            local name = "__nuppA" .. tostring(index)
            params[index] = name
            arguments[index] = debug and name .. ":debug()" or name
        end
        local body = (
            "return string.format(%q%s)"
        ):format(plan.format, #arguments > 0 and "," .. table.concat(arguments, ",") or "")

        return pluck.declareHelper("__nuppFormat", table.concat(params, ","), body)
    end

    function pluck.activate(plan): any
        local prior = {aliases = pluck.argumentAliases, fields = pluck.argumentFields,}
        pluck.argumentAliases = plan.argAliases
        pluck.argumentFields = plan.argFields
        pluck.plans[plan.call] = plan

        return prior
    end

    function pluck.restore(plan, prior)
        pluck.plans[plan.call] = nil
        pluck.argumentAliases = prior.aliases
        pluck.argumentFields = prior.fields
    end

    function pluck.emitCall(call, plan)
        if plan.methodAlias then
            e(plan.methodAlias .. "(" .. plan.receiverAlias, sourceLine(call))
            if call.args and #(call.args.loweredArgs or {}) > 0 then
                e(",")
                pluck.emitArgs(call.args)
            end
            e(")")
        elseif plan.receiverAlias then
            e(plan.receiverAlias .. ":" .. plan.methodName, sourceLine(call))
            emit(call.args)
        else
            if plan.calleeAlias then
                e(plan.calleeAlias, sourceLine(call))
            else
                emit(call.obj)
            end
            emit(call.args)
        end
    end

    function pluck.emitStatement(statement, call, plan)
        pluck.emitSteps(plan.setupSteps)
        local guards = 0
        if plan.safeReceiver then
            e("if " .. plan.receiverAlias .. "~=nil then")
            guards = guards + 1
        end
        pluck.emitSteps(plan.afterReceiverSteps)
        if plan.safeCallee then
            e("if " .. plan.calleeAlias .. "~=nil then")
            guards = guards + 1
        end
        if plan.safeMethod then
            e("if " .. plan.methodAlias .. "~=nil then")
            guards = guards + 1
        end
        pluck.emitSteps(plan.steps)
        local prior = pluck.activate(plan)
        emit(statement)
        pluck.restore(plan, prior)
        for _ = 1, guards do
            e("end")
        end
    end

    function pluck.emitReturn(statement, plan)
        pluck.emitSteps(plan.setupSteps)
        if plan.safeReceiver then
            e("if " .. plan.receiverAlias .. "==nil then return nil end;")
        end
        pluck.emitSteps(plan.afterReceiverSteps)
        if plan.safeCallee then
            e("if " .. plan.calleeAlias .. "==nil then return nil end;")
        end
        if plan.safeMethod then
            e("if " .. plan.methodAlias .. "==nil then return nil end;")
        end
        pluck.emitSteps(plan.steps)
        local prior = pluck.activate(plan)
        emit(statement)
        pluck.restore(plan, prior)
    end

    local function coverageRuntime()
        coverageName = coverageName or reservedName("__nuppCoverage")
        return coverageName
    end

    local function coverageSite(kind, node)
        coverageSiteCount = coverageSiteCount + 1
        local id = coverageSiteCount
        local sites = coverageSites or {}
        coverageSites = sites
        sites[#sites + 1] = {id = id, kind = kind, line = sourceLine(node) or 0}

        return id
    end

    local function coverageHit(kind, node)
        if not coverageOn then
            return
        end
        local id = coverageSite(kind, node)
        e(("%s.hit(%q,%d);"):format(coverageRuntime(), coveragePath, id), sourceLine(node))
    end

    local function coverageStatement(node)
        if not node or cst.isToken(node) then
            return false
        end
        if node.kind == "recordDecl" then
            return node.declKind == "record" or node.declKind == "struct"
        end

        return COVERAGE_STATEMENTS[node.kind] == true
    end

    local function hotEmitImplementation(planned): nil
        local body = planned.node.body
        local names = {}
        if planned.implicitSelf then
            names[#names + 1] = "self"
        end
        for index, param in ipairs(body.params or {}) do
            if not (planned.implicitSelf and index == 1 and param.name and param.name.text == "self") then
                if param.namedVararg then
                    names[#names + 1] = "..."
                elseif param.name then
                    names[#names + 1] = param.name.text
                elseif param[1] and cst.isToken(param[1]) and param[1].kind == "..." then
                    names[#names + 1] = "..."
                end
            end
        end
        local line = sourceLine(planned.node)
        e("function(" .. table.concat(names, ",") .. ")", line)
        if body.varargParam then
            e(("const %s={n=select(\"#\",...),...}"):format(body.varargParam.name.text))
        end
        emitDepth.fn = emitDepth.fn + 1
        if coverageOn then
            coverageHit("function", body)
        end
        if body.body then
            emit(body.body)
        end
        emitDepth.fn = emitDepth.fn - 1
        local endToken
        for index = #body, 1, -1 do
            local child = body[index]
            if cst.isToken(child) and child.kind == "end" then
                endToken = child
                break
            end
        end
        e("end", endToken and endToken.line or nil)
    end

    local function hotDefinePrefix(planned): string
        return (
            "_G.__nuppHotReload.define(%s,%d,%q,%q,%s,"
        ):format(
            hotState.slotsExpr,
            planned.slot,
            planned.id,
            planned.signature,
            planned.selfName and string.format("%q", planned.selfName) or "nil"
        )
    end

    local function hotEmitFunction(planned): nil
        local node = planned.node
        local line = sourceLine(node)
        if node.kind == "localFuncStmt" then
            if hotState.mode == "initial" or planned.selfRecursive then
                e("local " .. planned.name .. ";", line)
            end
            e(hotDefinePrefix(planned), line)
            hotEmitImplementation(planned)
            e(")")
            if hotState.mode == "initial" then
                e((";%s=function(...) return %s[%d](...) end"):format(planned.name, hotState.slotsExpr, planned.slot))
            end
        else
            e(hotDefinePrefix(planned), line)
            hotEmitImplementation(planned)
            e(")")
            if hotState.mode == "initial" then
                local forwarded = planned.implicitSelf and "self,..." or "..."
                e(
                    (
                        ";function %s(...) return %s[%d](%s) end"
                    ):format(planned.name, hotState.slotsExpr, planned.slot, forwarded)
                )
            end
        end
    end

    local function hotSelected(planned): boolean
        return planned.patchable and (not hotState.only or hotState.only[planned.id] == true)
    end

    -- The recursive emitter already captures `pluck`. Keep watch dispatch on that
    -- table too, so enabling this optional mode does not add an upvalue to a function
    -- that coverage generation holds at LuaJIT's 60-upvalue ceiling.
    if hotState then
        pluck.hotDispatch = {byNode = hotState.byNode, emit = hotEmitFunction}
    end

    local emitAutomaticBlock
    local function emitChildren(n)
        if n.kind == "suspensionInstallExpr" then
            e(suspensionModule() .. ".install(", sourceLine(n))
            emit(n.handler)
            e(")")
            return
        end
        if n.kind == "block" and n.automaticOwners and #n.automaticOwners > 0 then
            emitAutomaticBlock(n)
            return
        end
        for _, child in ipairs(n) do
            emit(child)
        end
    end

    emitDepth.switchTemps = setmetatable({}, {__mode = "k"})
    emitDepth.switchValueTemps = setmetatable({}, {__mode = "k"})
    emitDepth.switchResult = nil
    emitDepth.switchStatementActive = nil
    emitDepth.diag = diag

    local function switchContains(node): boolean
        if not node or cst.isToken(node) then
            return false
        end
        if node.kind == "switchExpr" then
            return true
        end
        if node.kind == "funcExpr" or node.kind == "shortfn" or node.kind == "funcbody" then
            return false
        end
        for _, child in ipairs(node) do
            if switchContains(child) then
                return true
            end
        end

        return false
    end

    -- Emits the runtime predicate used by a switch type case. This deliberately shares
    -- the same representations as `is`; the checker has already attached nominal,
    -- refinement and reified identities to the type node.
    emitDepth.switchTest = function(t, subject, line, recordIdentity, recordIdentitySafe)
        if t.kind == "tname" and t.base.kind == "nil" then
            e("(" .. subject .. "==nil)", line)
        elseif t.kind == "tname" and #t == 1 and IS_TYPE[t.base.text] then
            e(('(type(%s)==%q)'):format(subject, IS_TYPE[t.base.text]), line)
        elseif t.kind == "tfunc" then
            e(('(type(%s)=="function")'):format(subject), line)
        elseif t.wherePredicate then
            e("(" .. predicate.test(t.wherePredicate, subject) .. ")", line)
        elseif t.recordName and recordIdentity then
            e(("(%s==%s)"):format(recordIdentity, t.recordName), line)
        elseif t.recordName and recordIdentitySafe then
            e(("(getmetatable(%s).__index==%s)"):format(subject, t.recordName), line)
        elseif t.recordName then
            e(("(getmetatable(%s)?.__index==%s)"):format(subject, t.recordName), line)
        elseif t.reified then
            needsFfi = true
            e(("__nuppFfi.istype(%s,%s)"):format(t.reified, subject), line)
        else
            local at = cst.firstToken(t)
            diag(
                at,
                "NUPP3001",
                "this switch type case has no runtime identity to test",
                "use a record, struct, primitive, or a refined interface"
            )
            e("true", line)
        end
    end

    local lowerSwitch
    local planSwitchStatement
    local function switchOperands(node): {cst.Node}?
        local kind = node.kind
        if kind == "paren" or kind == "castExpr" or kind == "isExpr" or kind == "unsafeOwnershipExpr" then
            return node.expr and {node.expr} or {}
        elseif kind == "unop" then
            return node.operand and {node.operand} or {}
        elseif kind == "newExpr" then
            return node.call and {node.call} or {}
        elseif kind == "binop" then
            return {node.lhs, node.rhs}
        elseif kind == "dotIndex" then
            return node.obj and {node.obj} or {}
        elseif kind == "bracketIndex" then
            return {node.obj, node.expr}
        elseif kind == "call" or kind == "methodCall" then
            local values = {node.obj}
            local args = node.args
            if args then
                for _, value in ipairs(args.exprs or {}) do
                    if value.kind == "namedArg" or value.kind == "pluckArg" then
                        values[#values + 1] = value.value
                    else
                        values[#values + 1] = value
                    end
                end
                if args.table then
                    values[#values + 1] = args.table
                end
            end
            return values
        elseif kind == "tableExpr" then
            local values = {}
            for _, field in ipairs(node.fields or {}) do
                if field.kind == "fieldBracket" then
                    values[#values + 1] = field.key
                end
                values[#values + 1] = field.value
            end
            return values
        elseif kind == "istring" then
            return node.parts or {}
        end

        return nil
    end

    local function captureSwitchPrefix(node)
        if not node or emitDepth.switchValueTemps[node] then
            return
        end
        local temporary = nextTemp()
        e(("local %s="):format(temporary), sourceLine(node))
        emit(node)
        e(";")
        emitDepth.switchValueTemps[node] = temporary
    end

    local function lowerSwitches(node, lazy: boolean?)
        if not node or cst.isToken(node) then
            return
        end
        local kind = node.kind
        if kind == "funcExpr" or kind == "shortfn" or kind == "funcbody" then
            return
        end
        if kind == "switchExpr" then
            if lazy then
                emitDepth.diag(
                    cst.firstToken(node),
                    "NUPP2142",
                    "a switch in this conditionally evaluated position is not supported yet",
                    "move the switch to a local before this expression"
                )
            end
            lowerSwitch(node)
            return
        end
        if kind == "binop" and node.op and (node.op.kind == "and" or node.op.kind == "or" or node.op.kind == "??") then
            lowerSwitches(node.lhs, lazy)
            lowerSwitches(node.rhs, true)
            return
        elseif kind == "ternary" then
            lowerSwitches(node.cond, lazy)
            lowerSwitches(node.ifTrue, true)
            lowerSwitches(node.ifFalse, true)
            return
        elseif kind == "safeCall" or kind == "safeIndex" or kind == "safeBracket" then
            -- Work after the safe receiver is conditional.
            if node.obj then
                lowerSwitches(node.obj, lazy)
            end
            for _, child in ipairs(node) do
                if child ~= node.obj then
                    lowerSwitches(child, true)
                end
            end
            return
        end

        local operands = switchOperands(node)
        if not operands then
            local descended = false
            for _, child in ipairs(node) do
                if not cst.isToken(child) and switchContains(child) then
                    descended = true
                    if emitDepth.switchStatementRoot and emitDepth.switchStatementRoot[child.kind] then
                        planSwitchStatement(child)
                    elseif child.kind == "block"
                        or child.kind == "ifClause"
                        or child.kind == "elseifClause"
                        or child.kind == "elseClause"
                        or child.kind == "doStmt"
                        or child.kind == "withStmt"
                        or child.kind == "handleStmt"
                        or child.kind == "unsafeStmt"
                        or child.kind == "noSuspendStmt"
                        or child.kind == "effectRegionStmt"
                        or child.kind == "pragmaStmt"
                    then
                        lowerSwitches(child, lazy)
                    else
                        diag(
                            cst.firstToken(child),
                            "NUPP2142",
                            "a switch in this expression placement is not supported yet",
                            "move the switch to a local before this expression"
                        )
                    end
                end
            end
            if not descended and switchContains(node) then
                diag(cst.firstToken(node), "NUPP2142", "this switch expression cannot be lifted from its placement")
            end
            return
        end

        local pending = {}
        for _, operand in ipairs(operands) do
            if operand and switchContains(operand) then
                -- Everything to the left has already run in Lua's eager evaluation
                -- order. Materialize it before lifting this switch so an arm cannot
                -- move a call, lookup, or even a mutable name read past the branch.
                for _, prefix in ipairs(pending) do
                    captureSwitchPrefix(prefix)
                end
                pending = {}
                lowerSwitches(operand, lazy)
            elseif operand then
                pending[#pending + 1] = operand
            end
        end
    end

    local function renderSwitchScalar(value): string
        if value.kind == "nil" then
            return "nil"
        end
        return literal.renderData(value.value)
    end

    local function switchMap(node, plan, selectorName, resultName): nil
        local facts = plan.facts
        local sentinel = facts.nilResult and declareConstant("__nuppSwitchNil", "{}") or nil
        local function renderedResult(value): string
            if value.kind == "nil" then
                return sentinel or "nil"
            end
            return renderSwitchScalar(value)
        end

        local entries = {}
        local selector = selectorName
        if plan.tag == "DenseIntegerMap" then
            local byIndex = {}
            for _, entry in ipairs(facts.entries) do
                local index = (entry.key.value - facts.minimum) + 1
                byIndex[index] = renderedResult(entry.value)
            end
            for index = 1, facts.span do
                entries[index] = byIndex[index] or "nil"
            end
            local offset = facts.minimum == 0 and "+1" or (
                "-(%s)+1"
            ):format(renderSwitchScalar(new switchplan.Scalar(kind = "number", value = facts.minimum)))
            selector = selectorName .. offset
        else
            for _, entry in ipairs(facts.entries) do
                entries[#entries + 1] = "[" .. renderSwitchScalar(entry.key) .. "]=" .. renderedResult(entry.value)
            end
        end
        local map = declareConstant("__nuppSwitchMap", "{" .. table.concat(entries, ",") .. "}")
        e(resultName .. "=" .. map .. "[" .. selector .. "];", sourceLine(node))
        local fallback = renderSwitchScalar(facts.fallback)
        if sentinel then
            e("if " .. resultName .. "==nil then " .. resultName .. "=" .. fallback)
            e(" elseif " .. resultName .. "==" .. sentinel .. " then " .. resultName .. "=nil end;")
        elseif facts.fallback.kind ~= "nil" then
            e("if " .. resultName .. "==nil then " .. resultName .. "=" .. fallback .. " end;")
        end
    end

    lowerSwitch = function(node)
        if emitDepth.switchTemps[node] then
            return
        end
        lowerSwitches(node.selector)
        local selectorName, resultName = nextTemp(), nextTemp()
        emitDepth.switchTemps[node] = resultName
        local line = sourceLine(node)
        e(("local %s="):format(selectorName), line)
        emit(node.selector)
        e((";local %s;"):format(resultName))

        local dispatch = switchplan.regular(node, coverageOn)
        node.switchPlanTag = dispatch.tag
        node.switchPlanReason = dispatch.reason
        local mapped = dispatch.tag == "DenseIntegerMap"
            or dispatch.tag == "SparseIntegerMap"
            or dispatch.tag == "StringMap"
        if mapped then
            switchMap(node, dispatch, selectorName, resultName)
            return
        end

        -- A leading run of record cases over a checker-proved record-only residue may
        -- share the identity read. The proof is stronger than non-nil: a primitive can
        -- be non-nil and still have no metatable.
        local recordRun = 0
        for _, arm in ipairs(node.cases or {}) do
            if arm.patternKind == "type" and arm.type and arm.type.recordName and arm.switchRecordIdentitySafe then
                recordRun = recordRun + 1
            else
                break
            end
        end
        local recordIdentity
        if recordRun >= 2 then
            recordIdentity = nextTemp()
            e(("local %s=getmetatable(%s).__index;"):format(recordIdentity, selectorName), line)
        end

        local first = true
        for armIndex, arm in ipairs(node.cases or {}) do
            e(first and "if " or "elseif ", sourceLine(arm))
            first = false
            if coverageOn then
                local branch = coverageSite("branch", arm)
                e(("%s.branch(%q,%d,"):format(coverageRuntime(), coveragePath, branch), sourceLine(arm))
            end
            if arm.patternKind == "static" then
                for index, value in ipairs(arm.values or {}) do
                    if index > 1 then
                        e(" or ")
                    end
                    e(selectorName .. "==")
                    emit(value)
                end
            else
                emitDepth.switchTest(
                    arm.type,
                    selectorName,
                    sourceLine(arm),
                    armIndex <= recordRun and recordIdentity or nil,
                    arm.switchRecordIdentitySafe
                )
            end
            if coverageOn then
                e(")")
            end
            e(" then ")
            coverageHit("statement", arm)
            if arm.binding then
                e(("local %s=%s;"):format(arm.binding.text, selectorName))
            end
            for _, field in ipairs(arm.fields or {}) do
                local name = field.name and field.name.text or ""
                local binding = field.alias and field.alias.text or name
                e(("local %s=%s.%s;"):format(binding, selectorName, name))
            end
            if arm.expr then
                lowerSwitches(arm.expr)
                e(resultName .. "=")
                emit(arm.expr)
            elseif arm.body then
                local prior = emitDepth.switchResult
                emitDepth.switchResult = resultName
                emit(arm.body)
                emitDepth.switchResult = prior
            end
        end
        if node.elseCase then
            e(first and "if true then " or "else ", sourceLine(node.elseCase))
            first = false
            local arm = node.elseCase
            coverageHit("statement", arm)
            if arm.expr then
                lowerSwitches(arm.expr)
                e(resultName .. "=")
                emit(arm.expr)
            elseif arm.body then
                local prior = emitDepth.switchResult
                emitDepth.switchResult = resultName
                emit(arm.body)
                emitDepth.switchResult = prior
            end
        end
        if not first then
            e("end;", node.endTok and node.endTok.line or nil)
        end
    end

    local function preserveAssignmentTarget(target)
        if not target then
            return
        end
        if target.kind == "dotIndex" then
            captureSwitchPrefix(target.obj)
        elseif target.kind == "bracketIndex" then
            captureSwitchPrefix(target.obj)
            captureSwitchPrefix(target.expr)
        end
    end

    planSwitchStatement = function(stat)
        if stat.kind == "callStmt" then
            lowerSwitches(stat.expr)
            return
        end
        local exprs = stat.exprs or {}
        if #exprs ~= 1 then
            diag(
                cst.firstToken(stat),
                "NUPP2142",
                "a switch statement root must contain exactly one value expression",
                "assign the switch to a local before this statement"
            )
            return
        end
        if stat.kind == "assignStmt" then
            local targets = stat.targets or {}
            if #targets ~= 1 then
                diag(
                    cst.firstToken(stat),
                    "NUPP2142",
                    "an assignment containing a switch must have exactly one target",
                    "assign the switch to a local before this assignment"
                )
                return
            end
            local target = targets[1]
            lowerSwitches(target)
            if switchContains(exprs[1]) then
                preserveAssignmentTarget(target)
            end
        end
        lowerSwitches(exprs[1])
    end

    local SWITCH_STATEMENT_ROOT = {localStmt = true, assignStmt = true, returnStmt = true, callStmt = true}
    emitDepth.switchStatementRoot = SWITCH_STATEMENT_ROOT
    emitDepth.switchContains = switchContains
    emitDepth.lowerSwitches = lowerSwitches
    emitDepth.planSwitchStatement = planSwitchStatement

    --- Points a declaration's table at the default bodies it takes.
    ---
    --- A reference rather than a copy: the body's source lines are in the interface's
    --- file, and this file has none to attribute a duplicate to. That is also why the
    --- interface has to be reachable, through a `require` when it lives in another
    --- module, which is what the checker resolved the name to.
    local function emitInheritedDefaults(x, runtimeName)
        local taken = x.inheritedDefaultNames
        if not taken or #taken == 0 then
            return
        end
        local line = sourceLine(x)
        local parts = {}
        for _, one in ipairs(taken) do
            parts[
                #parts + 1
            ] = (
                "%s.%s = %s.%s"
            ):format(runtimeName, one.member or one.name, one.from, one.fromMember or one.member or one.name)
        end
        e(table.concat(parts, " "), line)
    end

    local function labelsIn(block)
        local labels = {}
        local function walk(n)
            if not n or cst.isToken(n) then
                return
            end
            if n.kind == "funcbody" then
                return
            end
            if n.kind == "cleanupRegion" then
                return
            end
            if n.kind == "labelStmt" and n.name then
                labels[n.name.text] = true
            end
            for _, child in ipairs(n) do
                walk(child)
            end
        end

        walk(block)

        return labels
    end

    -- `...` cannot cross the protected region's function boundary, so a body that reads
    -- it makes the region variadic and the varargs are forwarded through xpcall. Nested
    -- Nested cleanup bodies are searched too, so an inner region's varargs are
    -- forwarded down
    -- through every enclosing region; nested functions are not, because they bind their
    -- own `...`.
    local function usesVararg(block)
        local found = false
        local function walk(n)
            if found or not n or cst.isToken(n) then
                return
            end
            if n.kind == "funcbody" or n.kind == "shortfn" then
                return
            end
            if n.kind == "vararg" then
                found = true
                return
            end
            for _, child in ipairs(n) do
                walk(child)
            end
        end

        walk(block)

        return found
    end

    -- The locals the module's own outermost block declares.
    --
    -- A cached region function is built once and reused, so an upvalue it takes stays
    -- bound to the instance the first entry saw. That is safe only where the variable
    -- has one instance for as long as the cache does, and only a local the chunk's
    -- outermost block declares qualifies. A local inside a function, a nested block or
    -- a loop is a fresh instance per entry, and a reused closure would read the one
    -- the first entry captured -- including a chunk-level loop variable, which is
    -- outside every function and still changes every iteration.
    --
    -- Computed on the first region rather than up front: a module with no owned
    -- binding never walks its own root for this.
    local chunkLocals: {[any]: boolean}?
    local function isChunkLocal(definition): boolean
        if not chunkLocals then
            local found = {}
            local function declare(stat)
                if cst.isToken(stat) then
                    return
                end
                -- The parse hands back the chunk's statements either directly or under
                -- one block node, and a pragma wraps the statement it applies to.
                if stat.kind == "block" then
                    for _, inner in ipairs(stat.stats or stat) do
                        declare(inner)
                    end

                    return
                end
                if stat.kind == "pragmaStmt" and stat.stat then
                    declare(stat.stat)

                    return
                end
                if stat.kind ~= "localStmt" and stat.kind ~= "localFuncStmt" then
                    return
                end
                for _, name in ipairs(stat.names or (stat.name and {stat.name}) or {}) do
                    if name.definition then
                        found[name.definition] = true
                    end
                end
            end

            for _, stat in ipairs(result.root or {}) do
                declare(stat)
            end
            chunkLocals = found
        end

        return chunkLocals[definition] == true
    end

    -- Whether this body would hold a region function to one execution.
    --
    -- The cached function is emitted where it is written and only its instance is
    -- parked in the module table, so scope is not what decides this: every name the
    -- body resolves is in scope either way. What decides it is whether reusing one
    -- instance would read a variable belonging to an earlier execution. A name the
    -- chunk's outermost block declares would not -- which is every module-level
    -- function, so a body whose only outside reference is a call it makes still
    -- shares. A name from an enclosing function, block or loop would, and that body
    -- keeps its own function.
    local function automaticCaptures(block, bindings)
        local localBindings = {}
        local firstOffset
        for _, binding in ipairs(bindings or {}) do
            localBindings[binding.name and binding.name.definition] = true
            local offset = binding.name and binding.name.offset
            if offset and (not firstOffset or offset < firstOffset) then
                firstOffset = offset
            end
        end
        local captured = false
        local function walk(node)
            if captured or not node or cst.isToken(node) then
                return
            end
            if node.kind == "name" and node.token and node.token.definition then
                local definition = node.token.definition
                local token = definition.token
                if not localBindings[
                    definition
                ] and token and firstOffset and token.offset < firstOffset and token.line ~= 0 and not isChunkLocal(
                    definition
                ) then
                    captured = true
                    return
                end
            end
            for _, child in ipairs(node) do
                walk(child)
            end
        end

        walk(block)

        return captured
    end

    -- Turns the owner declarations in one lexical block into a semantic cleanup region.
    -- The checker supplied the exact cleanup entries; this pass never
    -- guesses from a type name or a method spelling. Activations retain their source
    -- positions inside the protected body, so staggered acquisitions fuse without
    -- moving intervening work or extending an inner block's lifetime.
    emitAutomaticBlock = function(block)
        local stats = block.stats or {}
        if block.automaticDirect then
            for _, stat in ipairs(stats) do
                emit(stat)
            end
            local owner = block.automaticDirect
            for _, cleanup in ipairs(owner.cleanups or {}) do
                local call = cleanupCall(cleanup, owner.name)
                if call then
                    e(call .. ";", owner.boundary and owner.boundary.line or nil)
                end
            end
            return
        end
        local first
        for index, stat in ipairs(stats) do
            if stat.automaticOwners and #stat.automaticOwners > 0 then
                first = index
                break
            end
        end
        if not first then
            for _, child in ipairs(block) do
                emit(child)
            end
            return
        end
        for index = 1, first - 1 do
            emit(stats[index])
        end
        local bindings, sequence, bodyStats = {}, {}, {}
        for index = first, #stats do
            local stat = stats[index]
            local owners = stat.automaticOwners or {}
            local ownerCount = 0
            local ownerNames = stat.names or (stat.name and {stat.name}) or {}
            for j = 1, #ownerNames do
                if owners[j] and owners[j].lowerable then
                    ownerCount = ownerCount + 1
                end
            end
            if (
                stat.kind == "localStmt" or stat.kind == "localFuncStmt" and stat.affineInitializer
            ) and ownerCount > 0 then
                local group = {}
                local names = stat.names or (stat.name and {stat.name}) or {}
                local exprs = stat.exprs or (stat.affineInitializer and {stat.affineInitializer}) or {}
                for j = 1, #names do
                    local owner = owners[j]
                    if owner and owner.lowerable then
                        local expr = exprs[j] or exprs[#exprs]
                        local binding = {
                            kind = "cleanupBinding",
                            name = names[j],
                            expr = expr,
                            declarationIndex = j,
                            ownerCleanups = owner.cleanups,
                            automaticOwner = owner,
                            isConst = stat.isConst,
                        }
                        bindings[#bindings + 1] = binding
                        group[#group + 1] = binding
                    end
                end
                local simple = #names == 1 and #exprs == 1
                sequence[#sequence + 1] = simple and {bindings = group} or {declaration = stat, bindings = group}
            else
                sequence[#sequence + 1] = {stat = stat}
                bodyStats[#bodyStats + 1] = stat
            end
        end
        if #bindings == 0 then
            -- The checker keeps unsupported declaration shapes diagnosed rather than
            -- allowing an owner the generator cannot protect. Reaching this branch is
            -- therefore recovery-only; preserve the original source emission.
            for _, item in ipairs(sequence) do
                emit(item.stat)
            end
            return
        end
        local body: any = {kind = "block", stats = bodyStats}
        for _, stat in ipairs(bodyStats) do
            body[#body + 1] = stat
        end
        local region: any = {
            kind = "cleanupRegion",
            startTok = bindings[1].name,
            doTok = bindings[1].name,
            endTok = cst.lastToken(block),
            bindings = bindings,
            body = body,
            automaticRegion = true,
            automaticSequence = sequence,
        }
        region.automaticComplex = #bindings == 1 and sequence[1] and sequence[1].declaration ~= nil
        region.capturesEnclosing = automaticCaptures(body, bindings)
        emit(region)
    end

    local function activeWith(move)
        local owner = move and (move.owner or move) or nil
        for index = #cleanupStack, 1, -1 do
            local ctx = cleanupStack[index]
            if ctx.functionDepth == emitDepth.fn then
                if owner then
                    local state = ctx.automaticMap and ctx.automaticMap[owner]
                    if state then
                        if move.field and state.fields then
                            return state.fields[move.field]
                        end
                        return state.whole
                    end
                else
                    return ctx
                end
            elseif not owner then
                break
            end
        end

        return nil
    end

    local function ownershipMoveOf(expr)
        while expr and (expr.kind == "paren" or expr.kind == "castExpr") do
            expr = expr.expr
        end
        return expr and expr.automaticOwnerMove or nil
    end

    local function automaticSlot(move)
        local owner = move and (move.owner or move) or nil
        if not owner then
            return nil
        end
        for index = #cleanupStack, 1, -1 do
            local ctx = cleanupStack[index]
            if ctx.functionDepth == emitDepth.fn then
                local state = ctx.automaticMap and ctx.automaticMap[owner]
                if state then
                    return state.slot
                end
            end
        end

        return nil
    end

    -- `emit` is already near LuaJIT's upvalue limit under coverage
    -- instrumentation. Keep this emitter on state it already captures instead of
    -- adding one more direct upvalue to the main dispatch closure.
    emitDepth.affineFunction = function(x)
        local body = x.body
        local captures = body and body.takenCaptures or {}
        local active = nextTemp()
        local callable = nextTemp()
        local wrapper = nextTemp()
        local line = sourceLine(x)
        local names = {}
        for _, capture in ipairs(captures) do
            names[#names + 1] = capture.name
        end
        pluck.loweredFunction(
            ("(function(%s) local %s=true; "):format(table.concat(names, ","), active),
            line,
            pluck.reasons.capture
        )
        for _, capture in ipairs(captures) do
            local outerActive = activeWith(capture.move)
            if outerActive then
                e(("%s=false; "):format(outerActive))
            end
        end
        e(("local %s=function"):format(callable))
        local enclosingCleanupStack = cleanupStack
        cleanupStack = {}
        emit(body)
        cleanupStack = enclosingCleanupStack
        e(("; local %s={}; "):format(wrapper))
        e(("%s.__nuppRelease=function() if not %s then return end; %s=false; "):format(wrapper, active, active))
        local errors = nextTemp()
        local errorCount = nextTemp()
        e(("local %s={}; local %s=0; "):format(errors, errorCount))
        for captureIndex = #captures, 1, -1 do
            local capture = captures[captureIndex]
            for _, cleanup in ipairs(capture.type.cleanups or {}) do
                local call = protectedCleanupCall(cleanup, capture.name, cleanupGlobals.pcall)
                if call then
                    local ok, reason = nextTemp(), nextTemp()
                    e(
                        (
                            "local %s,%s=%s; if not %s then %s=%s+1; %s[%s]=%s end; "
                        ):format(ok, reason, call, ok, errorCount, errorCount, errors, errorCount, reason)
                    )
                end
            end
        end
        e(
            (
                "if %s>0 then if %s>1 then %s(%s(%s[1],%s,2),0) " .. "else %s(%s[1],0) end end end; "
            ):format(
                errorCount,
                errorCount,
                cleanupGlobals.error,
                cleanupFailureName,
                errors,
                errors,
                cleanupGlobals.error,
                errors
            )
        )
        e(
            (
                "return setmetatable(%s,{__call=function(_,...) if not %s then %s(%q,2) end; "
            ):format(wrapper, active, cleanupGlobals.error, "nupp: affine closure was already called or dropped")
        )
        e(("%s=false; return %s(...) end}) end)("):format(active, callable))
        for j, capture in ipairs(captures) do
            if j > 1 then
                e(",")
            end
            e(capture.name, capture.token and capture.token.line or line)
        end
        e(")")
    end

    local function emitPackedReturn(ctx, x)
        local actives, seen = {}, {}
        for _, expr in ipairs(x.exprs or {}) do
            local move = expr.automaticOwnerMove
            local active = move and activeWith(move) or nil
            if active and not seen[active] then
                seen[active] = true
                actives[#actives + 1] = active
            end
        end
        local packed = #actives > 0 and nextTemp() or nil
        if packed then
            e(("do const %s=%s("):format(packed, cleanupPackName), sourceLine(x))
        else
            e(("return \"return\",%s("):format(cleanupPackName), sourceLine(x))
        end
        for j, expr in ipairs(x.exprs or {}) do
            if j > 1 then
                e(",")
            end
            emit(expr)
        end
        e(")")
        if packed then
            for _, active in ipairs(actives) do
                e(("; %s=false"):format(active))
            end
            e(("; return \"return\",%s end"):format(packed))
        end
    end

    emit = function(x)
        if cst.isToken(x) then
            if x.missing or x.kind == "eof" then
                return
            end
            if x.typeColon or x.typeSeparator or x.typeBracket then
                return
            end
            local text = x.text
            if x.kind == "string" and text:sub(1, 1) == "`" then
                -- backtick string without interpolation -> quoted string
                text = pluck.quote(text:sub(2, -2))
            end
            e(text, x.line)
            return
        end

        local kind = x.kind
        local switchValueTemporary = emitDepth.switchValueTemps[x]
        if switchValueTemporary then
            e(switchValueTemporary, sourceLine(x))
            return
        end
        if emitDepth.switchStatementRoot[
            kind
        ] and emitDepth.switchStatementActive ~= x and emitDepth.switchContains(x) then
            local priorSwitchStatement = emitDepth.switchStatementActive
            emitDepth.switchStatementActive = true
            emitDepth.planSwitchStatement(x)
            emitDepth.switchStatementActive = x
            emit(x)
            emitDepth.switchStatementActive = priorSwitchStatement
            return
        elseif kind == "switchExpr" then
            local temporary = emitDepth.switchTemps[x]
            if temporary then
                e(temporary, sourceLine(x))
            else
                emitDepth.diag(
                    cst.firstToken(x),
                    "NUPP2142",
                    "this switch expression cannot be lifted from its placement",
                    "assign it to a local in a statement before using it here"
                )
                e("nil", sourceLine(x))
            end
            return
        elseif kind == "switchYieldStmt" then
            local resultName = emitDepth.switchResult
            if resultName and x.value then
                emitDepth.lowerSwitches(x.value)
                e(resultName .. "=", sourceLine(x))
                emit(x.value)
            else
                e("nil", sourceLine(x))
            end
            return
        end
        if kind == "assignStmt" and #(x.targets or {}) == 1 and #(x.exprs or {}) == 1 then
            local target = x.targets[1]
            if target
                and target.kind == "dotIndex"
                and target.indexedField
                and target.indexedField.adapter == "span"
                and target.obj
                and target.obj.indexedAccess
            then
                local access = target.obj
                local direct = access.indexedDirectAccess == true
                if emitDepth.view.info(access.obj) then
                    emitDepth.view.spanSlot(access.obj, access.expr, target.name.text, not direct)
                    e("=", sourceLine(target))
                    emit(x.exprs[1])
                    return
                elseif direct then
                    emit(access.obj)
                    e(".pointer[")
                    emit(access.obj)
                    e(".offset+")
                    emit(access.expr)
                    e("-1]")
                else
                    emit(access.obj)
                    e(":getMut(")
                    emit(access.expr)
                    e(")")
                end
                e("." .. target.name.text .. "=", sourceLine(target))
                emit(x.exprs[1])
                return
            elseif target
                and target.kind == "bracketIndex"
                and target.indexedAccess
                and target.indexedAccess.adapter == "span"
            then
                if emitDepth.view.info(target.obj) then
                    emitDepth.view.spanSlot(target.obj, target.expr, nil, not target.indexedDirectAccess)
                    e("=", sourceLine(target))
                    emit(x.exprs[1])
                    return
                else
                    emit(target.obj)
                end
                if target.indexedDirectAccess and not emitDepth.view.info(target.obj) then
                    e(".pointer[")
                    emit(target.obj)
                    e(".offset+")
                    emit(target.expr)
                    e("-1]=", sourceLine(target))
                    emit(x.exprs[1])
                else
                    e(":set(", sourceLine(target))
                    emit(target.expr)
                    e(",")
                    emit(x.exprs[1])
                    e(")")
                end
                return
            end
            local row, ordinal = soaFieldTarget(target)
            if row and ordinal then
                if emitDepth.view.info(row.obj) then
                    emitDepth.view.soaSlot(row.obj, ordinal, row.expr, not emitDepth.soa.unchecked(row))
                    e("=", sourceLine(x))
                    emit(x.exprs[1])
                else
                    local viewName, indexName = nextTemp(), nextTemp()
                    e(("do const %s="):format(viewName), sourceLine(x))
                    emit(row.obj)
                    e(("; const %s="):format(indexName))
                    emit(row.expr)
                    e(("; %s="):format(emitDepth.soa.slot(viewName, ordinal, indexName, emitDepth.soa.unchecked(row))))
                    emit(x.exprs[1])
                    e(" end")
                end
                return
            elseif target and target.soaRow then
                if target.indexedDirectAccess and target.soaRow.element and target.soaRow.element.tag == "nominal" then
                    local viewName, indexName, valueName = nextTemp(), nextTemp(), nextTemp()
                    e("do", sourceLine(x))
                    if not emitDepth.view.info(target.obj) then
                        e((" const %s="):format(viewName))
                        emit(target.obj)
                        e(("; const %s="):format(indexName))
                        emit(target.expr)
                    end
                    e(((emitDepth.view.info(target.obj) and " const %s=" or "; const %s="):format(valueName)))
                    emit(x.exprs[1])
                    for ordinal, field in ipairs(target.soaRow.element.fieldOrder or {}) do
                        e(";")
                        if emitDepth.view.info(target.obj) then
                            emitDepth.view.soaSlot(target.obj, ordinal, target.expr)
                            e(("=%s.%s"):format(valueName, field))
                        else
                            e(
                                (
                                    " %s.columns[%d][%s.offset+%s-1]=%s.%s"
                                ):format(viewName, ordinal, viewName, indexName, valueName, field)
                            )
                        end
                    end
                    e(" end")
                else
                    emit(target.obj)
                    e(":set(", sourceLine(x))
                    emit(target.expr)
                    e(",")
                    emit(x.exprs[1])
                    e(")")
                end
                return
            end
        elseif kind == "compoundAssign" and x.target then
            if x.target.kind == "bracketIndex"
                and x.target.indexedAccess
                and x.target.indexedAccess.adapter == "span"
            then
                e("do ", sourceLine(x))
                if emitDepth.view.info(x.target.obj) then
                    local indexName = nextTemp()
                    e(("const %s="):format(indexName))
                    emit(x.target.expr)
                    e(";")
                    emitDepth.view.spanSlot(x.target.obj, indexName, nil, not x.target.indexedDirectAccess)
                    e("=")
                    emitDepth.view.spanSlot(x.target.obj, indexName, nil, not x.target.indexedDirectAccess)
                    e((" %s "):format(x.op.kind:sub(1, -2)), x.op.line)
                    emit(x.value)
                elseif x.target.indexedDirectAccess then
                    if emitDepth.view.info(x.target.obj) then
                        emitDepth.view.spanSlot(x.target.obj, x.target.expr)
                        e("=")
                        emitDepth.view.spanSlot(x.target.obj, x.target.expr)
                    else
                        emit(x.target.obj)
                        e(".pointer[")
                        emit(x.target.obj)
                        e(".offset+")
                        emit(x.target.expr)
                        e("-1]=")
                        emit(x.target.obj)
                        e(".pointer[")
                        emit(x.target.obj)
                        e(".offset+")
                        emit(x.target.expr)
                        e("-1]")
                    end
                    e((" %s "):format(x.op.kind:sub(1, -2)), x.op.line)
                    emit(x.value)
                else
                    local viewName, indexName = nextTemp(), nextTemp()
                    e(("const %s="):format(viewName))
                    emit(x.target.obj)
                    e((";const %s="):format(indexName))
                    emit(x.target.expr)
                    e(
                        (
                            ";%s:set(%s,%s:get(%s) %s "
                        ):format(viewName, indexName, viewName, indexName, x.op.kind:sub(1, -2))
                    )
                    emit(x.value)
                    e(")")
                end
                e(" end")
                return
            elseif x.target.kind == "dotIndex"
                and x.target.indexedField
                and x.target.indexedField.adapter == "span"
                and x.target.obj
                and x.target.obj.indexedAccess
            then
                local target = x.target
                local access = target.obj
                if emitDepth.view.info(access.obj) then
                    e("do ", sourceLine(x))
                    local indexName = nextTemp()
                    e(("const %s="):format(indexName))
                    emit(access.expr)
                    e(";")
                    emitDepth.view.spanSlot(access.obj, indexName, target.name.text, not access.indexedDirectAccess)
                    e((" %s "):format(x.op.kind), x.op.line)
                    emit(x.value)
                    e(" end")
                    return
                end
                local viewName, indexName = nextTemp(), nextTemp()
                e(("do const %s="):format(viewName), sourceLine(x))
                emit(access.obj)
                e(("; const %s="):format(indexName))
                emit(access.expr)
                local slot
                if access.indexedDirectAccess then
                    slot = ("%s.pointer[%s.offset+%s-1].%s"):format(viewName, viewName, indexName, target.name.text)
                else
                    slot = ("%s:getMut(%s).%s"):format(viewName, indexName, target.name.text)
                end
                e(("; %s %s "):format(slot, x.op.kind), x.op.line)
                emit(x.value)
                e(" end")
                return
            end
            local row, ordinal = soaFieldTarget(x.target)
            if row and ordinal then
                if emitDepth.view.info(row.obj) then
                    e("do ", sourceLine(x))
                    local indexName = nextTemp()
                    e(("const %s="):format(indexName))
                    emit(row.expr)
                    e(";")
                    emitDepth.view.soaSlot(row.obj, ordinal, indexName, not emitDepth.soa.unchecked(row))
                    e((" %s "):format(x.op.kind), x.op.line)
                    emit(x.value)
                    e(" end")
                    return
                end
                local viewName, indexName = nextTemp(), nextTemp()
                e(("do const %s="):format(viewName), sourceLine(x))
                emit(row.obj)
                e(("; const %s="):format(indexName))
                emit(row.expr)
                local slot = emitDepth.soa.slot(viewName, ordinal, indexName, emitDepth.soa.unchecked(row))
                e(("; %s %s "):format(slot, x.op.kind), x.op.line)
                emit(x.value)
                e(" end")
                return
            end
        end
        if kind == "block" and x.automaticOwners and #x.automaticOwners > 0 then
            emitChildren(x)
            return
        end
        if kind == "dedentString" then
            e(string.format("%q", dedentLongString(x.token and x.token.text or "")), sourceLine(x))
            return
        end
        if coverageOn and kind == "block" then
            for _, child in ipairs(x) do
                if coverageStatement(child) then
                    coverageHit("statement", child)
                end
                emit(child)
            end
            return
        end
        if kind == "assignStmt" and x.presizedIntoConstructor and not coverageOn then
            -- Its target and value were emitted as a constructor field. Return before
            -- statement-root call and ownership lowering: the value already went
            -- through their expression paths while the constructor was emitted.
            return
        end
        if x.automaticOwnerReinit then
            local active = activeWith(x.automaticOwnerReinit)
            if active then
                local reinit = x.automaticOwnerReinit
                local slot = not reinit.field and automaticSlot(reinit) or nil
                x.automaticOwnerReinit = nil
                pluck.loweredFunction("(function(__p) ", sourceLine(x), pluck.reasons.reinit)
                if slot then
                    e(slot .. "=__p; ")
                end
                e(active .. "=true; return __p end)(")
                emit(x)
                e(")")
                x.automaticOwnerReinit = reinit
                return
            end
        end
        if kind == "recordDecl" and x.isAnnotationDefinition then
            -- Annotation schemas are compile-time model metadata, even when written
            -- with `record` or `struct`; they have no runtime value or FFI layout of
            -- their own.
            return
        end
        if not pluck.statementActive[x] then
            local direct = pluck.directCall(x)
            local plan = direct and pluck.callPlan(direct) or nil
            if plan and (not plan.isSafe or kind == "callStmt" or kind == "returnStmt") then
                pluck.statementActive[x] = true
                if plan.isSafe and kind == "returnStmt" then
                    pluck.emitReturn(x, plan)
                else
                    pluck.emitStatement(x, direct, plan)
                end
                pluck.statementActive[x] = nil
                return
            end
        end
        if kind == "call" or kind == "safeCall" or kind == "methodCall" then
            local activePlan = pluck.plans[x]
            if activePlan and not activePlan.delegate then
                pluck.emitCall(x, activePlan)
                return
            end
        end
        if kind == "args" and x.loweredArgs then
            e("(", sourceLine(x))
            pluck.emitArgs(x)
            e(")")
            return
        end
        if x.passPinnedPointer then
            x.passPinnedPointer = nil
            e("(", sourceLine(x))
            emit(x)
            e(").pointer")
            x.passPinnedPointer = true
            return
        end
        if x.comptimeValue then
            -- Nothing of the block's body is emitted; the work happened while
            -- compiling.
            -- Its lines are simply left empty, because `sync` only moves forward, so
            -- whatever follows the `end` still lands on the line it was written on and
            -- the file keeps its line count.
            e(x.comptimeValue, sourceLine(x))
            return
        end
        if x.materializedIR then
            local materializeIR = require("nupp.compiler.materialize.ir")
            local rendered, failure = materializeIR.render(x.materializedIR)
            if not rendered then
                error("checked materialization IR failed during generation: " .. tostring(failure and failure.message))
            end
            e(rendered, sourceLine(x))
            local observation = x.materializationObservation
            for _, effect in ipairs(observation and observation.runtimeFeatures or {}) do
                needRuntimeEffect(effect)
            end
            return
        end
        if x.folded then
            e(x.folded, sourceLine(x))
            return
        end
        if kind == "unop" and x.indexedLength and x.operand then
            emitDepth.view.count(x.operand)
            return
        end
        if kind == "dotIndex"
            and x.indexedField
            and x.indexedField.adapter == "span"
            and x.obj
            and x.obj.indexedAccess
        then
            local access = x.obj
            if emitDepth.view.info(access.obj) then
                emitDepth.view.spanSlot(
                    access.obj,
                    access.expr,
                    x.name and x.name.text or nil,
                    not access.indexedDirectAccess
                )
                return
            end
            emit(access.obj)
            if access.indexedDirectAccess then
                e(".pointer[")
                emit(access.obj)
                e(".offset+")
                emit(access.expr)
                e("-1]")
            else
                e(":get(")
                emit(access.expr)
                e(")")
            end
            if x.name then
                e("." .. x.name.text, sourceLine(x))
            end
            return
        end
        if kind == "bracketIndex" and x.indexedAccess and x.indexedAccess.adapter == "span" then
            if emitDepth.view.info(x.obj) then
                emitDepth.view.spanSlot(x.obj, x.expr, nil, not x.indexedDirectAccess)
                return
            end
            emit(x.obj)
            if x.indexedDirectAccess then
                e(".pointer[")
                emit(x.obj)
                e(".offset+")
                emit(x.expr)
                e("-1]")
            else
                e(":get(", sourceLine(x))
                emit(x.expr)
                e(")")
            end
            return
        end
        if x.compilerFeatureEffect then
            needRuntimeEffect(x.compilerFeatureEffect)
        end
        for _, effect in ipairs(x.compilerFeatureEffects or {}) do
            needRuntimeEffect(effect)
        end
        if kind == "dotIndex" and x.overloadMember then
            emit(x.obj)
            e("." .. x.overloadMember, sourceLine(x))
            return
        end
        if x.callableBindings then
            for _, binding in ipairs(x.callableBindings) do
                e("const " .. binding.name .. "=", sourceLine(x))
                emit(binding.value)
                e(";")
            end
        end
        if (kind == "call" or kind == "methodCall") and x.formatIntrinsic then
            local plan = x.formatIntrinsic
            local arguments = x.args and x.args.exprs or {}
            e(pluck.formatHelper(plan) .. "(", sourceLine(x))
            for index = (plan.argumentOffset or 0) + 1, #arguments do
                if index > (plan.argumentOffset or 0) + 1 then
                    e(",")
                end
                emit(arguments[index])
            end
            e(")")
            return
        end
        if kind == "call" and x.ffiLoadLib and pluck.hotLibraries[x.ffiLoadLib] then
            emit(x.obj)
            e("(" .. ("%q"):format(pluck.hotLibraries[x.ffiLoadLib]))
            local arguments = x.args and x.args.exprs or {}
            for index = 2, #arguments do
                e(",")
                emit(arguments[index])
            end
            e(")")
            return
        end
        if kind == "call" and x.indexedRangeCall then
            local arguments = x.args and x.args.exprs or {}
            local virtual = false
            for index = 3, #arguments do
                virtual = virtual or emitDepth.view.info(arguments[index]) ~= nil
            end
            if virtual then
                e(compilerModuleName("nupp.mem.indexed") .. "._rangeCounts(", sourceLine(x))
                for index, argument in ipairs(arguments) do
                    if index > 1 then
                        e(",")
                    end
                    if index >= 3 then
                        emitDepth.view.count(argument)
                    else
                        emit(argument)
                    end
                end
                e(")")
                return
            end
        end
        if kind == "call" and x.indexedViewParameterTransport then
            local plan = x.indexedViewParameterTransport
            emit(x.obj)
            e("(", sourceLine(x))
            for index, argument in ipairs(x.args and x.args.exprs or {}) do
                if index > 1 then
                    e(",")
                end
                if plan.params[index] then
                    emitDepth.view.root(argument)
                    e(",")
                    emitDepth.view.offset(argument)
                    e(",")
                    emitDepth.view.count(argument)
                else
                    emit(argument)
                end
            end
            e(")")
            return
        end
        if kind == "call" and x.staticCallee then
            e(x.staticCallee, sourceLine(x))
            if x.args then
                emit(x.args)
            end
            return
        end
        if kind == "bracketIndex" and x.carrayBound then
            needsCArrayIndex = true
            carrayIndexName = carrayIndexName or reservedName("__nuppCArrayIndex")
            emit(x.obj)
            e("[")
            e(carrayIndexName .. "(")
            emit(x.expr)
            e("," .. tostring(x.carrayBound) .. ")]")
            return
        end
        if kind == "call" and x.tableIntrinsic then
            e(tableIntrinsicName(x.tableIntrinsic), sourceLine(x))
            if x.args then
                emit(x.args)
            end
            return
        end
        if kind == "localStmt" and x.pattern then
            local sourceName = nextTemp()
            e(("const %s="):format(sourceName), sourceLine(x))
            emit(x.patternSource)
            e(";")
            e(x.isConst and "const " or "local ")
            for index, entry in ipairs(x.pattern) do
                if index > 1 then
                    e(",")
                end
                local name = entry.alias or entry.sourceName
                e(name and name.text or "__nuppMissing")
            end
            e("=")
            for index, entry in ipairs(x.pattern) do
                if index > 1 then
                    e(",")
                end
                e(sourceName .. "." .. (entry.sourceName and entry.sourceName.text or "__nuppMissing"))
            end
            return
        end
        if kind == "assignStmt" and x.isConst then
            for i, target in ipairs(x.targets or {}) do
                if i > 1 then
                    e(",")
                end
                emit(target)
            end
            e("=")
            for i, value in ipairs(x.exprs or {}) do
                if i > 1 then
                    e(",")
                end
                emit(value)
            end
            return
        end
        if kind == "fieldNamed" and x.isConst then
            if x.name then
                emit(x.name)
            end
            e("=")
            if x.value then
                emit(x.value)
            end
            return
        end
        if x.constantLoopNone then
            -- OPT-3: the loop's constant bounds admit no first iteration. An empty `do`
            -- block holds the opening and closing lines so that everything after the
            -- loop keeps its own, and LuaJIT compiles it away to nothing.
            e("do", sourceLine(x))
            local endTok
            for i = #x, 1, -1 do
                local child = x[i]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("end", endTok and endTok.line or nil)
            return
        end
        if kind == "ifStmt" and (x.constantBranch or x.constantBranchNone) then
            -- OPT-3: every condition was a primitive constant. A `do` block preserves
            -- the selected arm's local scope while the source lines of the omitted arms
            -- remain blank.
            e("do", sourceLine(x))
            if x.constantBranch then
                emit(x.constantBranch)
            end
            local endTok
            for i = #x, 1, -1 do
                local child = x[i]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("end", endTok and endTok.line or nil)
            return
        end
        if coverageOn and (kind == "ifClause" or kind == "elseifClause") then
            -- A branch probe wraps only the condition. It receives and returns the
            -- original value, preserving Lua truthiness while counting both outcomes.
            local branch = coverageSite("branch", x.cond)
            for _, child in ipairs(x) do
                if child == x.cond then
                    e(("%s.branch(%q,%d,"):format(coverageRuntime(), coveragePath, branch), sourceLine(child))
                    emit(child)
                    e(")")
                else
                    emit(child)
                end
            end
            return
        end
        if kind == "recordDecl" and x.declKind == "record" then
            -- Records keep a runtime table: `function R:m()` attaches to it and
            -- `R{...}` stamps it as the instance metatable, which is what gives a
            -- record its identity at run time.
            local line = sourceLine(x)
            local path = declPath(x)
            local runtimeName = x.recordRuntimeName or path or x.name.text
            local attached = x.recordRuntimeName or path
            local storage = attached and "" or x.visibility == "global" and "" or "const "
            local expr = ("%s%s = {} %s.__index = %s"):format(storage, runtimeName, runtimeName, runtimeName)
            e(expr, line)
            local nominal = x.resolvedType
            local jsonDerive = x.deriveRecipe and x.deriveRecipe.data and x.deriveRecipe.data.json
            if nominal and (nominal.runtimeReflectionNeeded or jsonDerive) then
                needRuntimeEffect("stdlib.reflection")
                -- Required here rather than beside the other modules: `emit` is one
                -- function and it was one name short of the sixty upvalues a Lua
                -- closure can hold, which coverage instrumentation then pushed it
                -- over. A record needing reflection is rare and `require` is cached,
                -- so the lookup costs nothing the emitter notices.
                local reflection = require("nupp.compiler.reflection")
                local descriptor = reflection.describe(nominal, runtimeName)
                e(";_G.nupp.__reflect.register(" .. runtimeName .. "," .. pluck.renderData(descriptor) .. ")")
            end
            for _, entry in ipairs(x.entries or {}) do
                if entry.kind == "recordDecl" and entry.declKind == "record" then
                    entry.recordRuntimeName = runtimeName .. "." .. entry.name.text
                    emit(entry)
                elseif entry.kind == "inlineMethod" then
                    entry.inlineRuntimeOwner = runtimeName
                    entry.inlineDotted = entry.inlineStatic
                    emit(entry)
                elseif entry.kind == "constructorDecl" then
                    entry.inlineRuntimeOwner = runtimeName
                    emit(entry)
                end
            end
            emitInheritedDefaults(x, runtimeName)
            pluck.emitDerivedMembers(x, runtimeName)
            return
        end

        if kind == "recordDecl" and x.declKind == "interface" then
            -- An interface is erased unless it implements something. A default body has
            -- to live somewhere a declaration in another module can reach, and the
            -- interface's own table is the only place that travels; an interface that
            -- declares only signatures still emits nothing at all.
            local defaults = {}
            for _, entry in ipairs(x.entries or {}) do
                if entry.kind == "inlineMethod" then
                    defaults[#defaults + 1] = entry
                end
            end
            local inherits = false
            for _, super in ipairs(x.supertypes or {}) do
                if super.interfaceName then
                    inherits = true
                end
            end
            local nominal = x.resolvedType
            local hasStatics = nominal and nominal.staticByname and next(nominal.staticByname) ~= nil
            if #defaults == 0 and not inherits and not hasStatics then
                return
            end
            local line = sourceLine(x)
            local path = declPath(x)
            local runtimeName = x.recordRuntimeName or path or x.name.text
            local attached = x.recordRuntimeName or path
            local storage = attached and "" or x.visibility == "global" and "" or "const "
            e(("%s%s = {}"):format(storage, runtimeName), line)
            for _, entry in ipairs(defaults) do
                entry.inlineRuntimeOwner = runtimeName
                entry.inlineDotted = true
                emit(entry)
            end
            emitInheritedDefaults(x, runtimeName)
            return
        end

        if kind == "recordDecl" and x.declKind == "struct" then
            -- struct S { a: float, b: OtherStruct, p: S* } lowers to const S =
            -- __nuppFfi.typeof("struct { float a; $ b; $ *p; }", OtherStruct,
            -- S_is_forward_error)
            needsFfi = true
            local cdecl, params = {}, {}
            for _, entry in ipairs(x.entries) do
                if entry.kind == "fieldDecl" then
                    local fname = entry.name.text
                    local t = entry.type
                    -- A declared bit width is the C bitfield it lowers to, and C allows
                    -- one only on a scalar. The cases below that are not scalars ignore
                    -- it, which the field rule has already refused by the time this
                    -- runs.
                    local width = entry.bitWidth and (" : " .. entry.bitWidth.text) or ""
                    -- unwrap optional wrapper (S*? has the same representation)
                    if t.kind == "topt" then
                        t = t.inner
                    end
                    if t.kind == "tname" and C_PRIM[t.base.text] then
                        cdecl[#cdecl + 1] = C_PRIM[t.base.text] .. " " .. fname .. width .. ";"
                    elseif t.kind == "tname" and structTag[cst.lastName(t) or ""] then
                        cdecl[#cdecl + 1] = "struct " .. structTag[cst.lastName(t) as string] .. " " .. fname .. ";"
                    elseif t.kind == "tname" then
                        cdecl[#cdecl + 1] = "$ " .. fname .. ";"
                        params[#params + 1] = (t.reified or cst.textOf(t)) as string
                    elseif t.kind == "tcarray" and t.count then
                        -- `T[N]` sits inline: the elements are the struct's own bytes.
                        -- `T[?]` has no size and never reaches here, since the field
                        -- rule refuses it.
                        local element = t.element
                        local spelling = element and element.kind == "tname" and C_PRIM[element.base.text] or nil
                        if spelling then
                            cdecl[#cdecl + 1] = spelling .. " " .. fname .. "[" .. cst.textOf(t.count) .. "];"
                        elseif element and element.kind == "tname" and structTag[cst.lastName(element) or ""] then
                            cdecl[
                                #cdecl + 1
                            ] = "struct " .. structTag[
                                cst.lastName(element) as string
                            ] .. " " .. fname .. "[" .. cst.textOf(t.count) .. "];"
                        elseif element and element.kind == "tname" then
                            cdecl[#cdecl + 1] = "$ " .. fname .. "[" .. cst.textOf(t.count) .. "];"
                            params[#params + 1] = (element.reified or cst.textOf(element)) as string
                        else
                            emitDepth.diag(entry.name, "NUPP3002", "cannot reify this array element type")
                        end
                    elseif t.kind == "tptr" then
                        local inner = t.inner
                        if inner.kind == "tname" and C_PRIM[inner.base.text] then
                            cdecl[#cdecl + 1] = C_PRIM[inner.base.text] .. " *" .. fname .. ";"
                        elseif inner.kind == "tname" and structTag[cst.lastName(inner) or ""] then
                            -- Forward-declared above, so the tag resolves even though
                            -- the body may not have been emitted yet.
                            cdecl[
                                #cdecl + 1
                            ] = "struct " .. structTag[cst.lastName(inner) as string] .. " *" .. fname .. ";"
                        elseif inner.kind == "tname" then
                            cdecl[#cdecl + 1] = "$ *" .. fname .. ";"
                            params[#params + 1] = (inner.reified or cst.textOf(inner)) as string
                        else
                            emitDepth.diag(entry.name, "NUPP3002", "cannot reify this pointer field type")
                        end
                    else
                        emitDepth.diag(entry.name, "NUPP3002", "cannot reify this field type")
                    end
                end
            end
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            local path = declPath(x)
            local storage = path and "" or x.visibility == "global" and "" or "const "
            -- The metatable is created up front so members declared later (function
            -- S:m()) have somewhere to attach; ffi.metatype hands back the ctype, which
            -- stays callable as the constructor.
            local mt = "__nuppMt_" .. x.name.text
            local tag = structTag[x.name.text]
            local expr
            if tag then
                -- Named, so the body may refer to the tag it is defining. pcall because
                -- the forward declaration above already introduced it, and because a
                -- module may be loaded twice in one process.
                expr = (
                    "pcall(__nuppFfi.cdef, \"struct %s { %s };\") "
                ):format(
                    tag,
                    table.concat(cdecl, " ")
                ) .. "const " .. mt .. " = {__index = {}} " .. storage .. (
                    path or x.name.text
                ) .. (" = %s(__nuppFfi.typeof(\"struct %s\"), %s)"):format(metatypeHelper(), tag, mt)
            else
                expr = "const " .. mt .. " = {__index = {}} " .. storage .. (
                    path or x.name.text
                ) .. " = __nuppFfi.metatype(__nuppFfi.typeof(\"struct { " .. table.concat(cdecl, " ") .. " }\""
                if #params > 0 then
                    expr = expr .. ", " .. table.concat(params, ", ")
                end
                expr = expr .. "), " .. mt .. ")"
            end
            e(expr, line)
            for _, entry in ipairs(x.entries or {}) do
                if entry.kind == "inlineMethod" then
                    entry.inlineRuntimeOwner = mt .. ".__index"
                    emit(entry)
                end
            end
            -- A struct's members hang off the metatype's index table rather than the
            -- ctype, so a default it takes lands there too. Reading an unknown name on
            -- cdata routes through exactly that table, which is what makes the call
            -- work at all.
            emitInheritedDefaults(x, mt .. ".__index")
            return
        end

        if kind == "cdefStruct" then
            needsFfi = true
            local fields = {}
            for _, entry in ipairs(x.entries) do
                if entry.kind == "fieldDecl" then
                    -- A field name is part of a C declarator, not always a suffix.
                    -- Function pointers and arrays put it inside `(*name)(...)` or
                    -- before `[N]` respectively.
                    local ct = entry.type.resolvedType and require(
                        "nupp.compiler.cabi"
                    ).declaration(entry.type.resolvedType, entry.name.text, "ffi")
                    if not ct then
                        local bare = cdefCType(entry.type)
                        ct = bare and (bare .. " " .. entry.name.text) or nil
                    end
                    if ct then
                        local width = entry.bitWidth and " : " .. entry.bitWidth.text or ""
                        fields[#fields + 1] = ct .. width .. ";"
                    else
                        emitDepth.diag(entry.name, "NUPP3003", "cdef field type has no C spelling")
                    end
                end
            end
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            -- pcall tolerates re-declaration when two modules cdef one struct
            e(
                (
                    'pcall(__nuppFfi.cdef, "%s %s { %s };") const %s = __nuppFfi.typeof("%s %s")'
                ):format(
                    x.aggregateKind or "struct",
                    x.name.text,
                    table.concat(fields, " "),
                    x.name.text,
                    x.aggregateKind or "struct",
                    x.name.text
                ),
                line
            )
            return

        elseif kind == "cdefFunc" then
            needsFfi = true
            local name = x.name.text
            -- `emit` already closes over `require` for materialization. Resolve the
            -- canonical renderer through that same name instead of capturing another
            -- module local; coverage instrumentation needs one capture slot of its own.
            local sig, signatureWhy = require("nupp.compiler.cabi").prototype(x.cAbiSignature, true)
            if not sig then
                emitDepth.diag(x.name, "NUPP3003", "cdef signature has no C spelling: " .. tostring(signatureWhy))
                sig = "void " .. name .. "(void);"
            end
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            -- symbols come from the default namespace unless a library is named, in
            -- which case they resolve through a cached ffi.load
            local ns = "__nuppFfi.C"
            if x.fromLib then
                needsLibs = true
                local authored = x.fromLib.text:match('^"(.*)"$') or x.fromLib.text:match("^'(.*)'$")
                local mapped = authored and pluck.hotLibraries[authored] or nil
                ns = mapped and ("__nuppLib(%q)"):format(mapped) or ("__nuppLib(%s)"):format(x.fromLib.text)
            end
            if x.countedAbi then
                local rawName = nextTemp()
                e(('pcall(__nuppFfi.cdef, %q) const %s = %s.%s'):format(sig, rawName, ns, name), line)
                e((" const %s=function(%s) "):format(name, table.concat(x.countedAbi.logicalNames or {}, ",")))
                local groups = {}
                for _, mapping in ipairs(x.countedAbi.mappings or {}) do
                    local group = groups[mapping.countIndex] or {}
                    group[#group + 1] = mapping
                    groups[mapping.countIndex] = group
                end
                local countIndexes = {}
                for countIndex in pairs(groups) do
                    countIndexes[#countIndexes + 1] = countIndex
                end
                table.sort(countIndexes)
                for _, countIndex in ipairs(countIndexes) do
                    local group = groups[countIndex]
                    local first = group[1]
                    for j = 2, #group do
                        e(
                            (
                                "if %s.count~=%s.count then error(%q,2) end "
                            ):format(
                                first.pointerName,
                                group[j].pointerName,
                                "spans counted by " .. first.countName .. " must have equal lengths"
                            )
                        )
                    end
                end
                local pointerValues, countValues = {}, {}
                for _, mapping in ipairs(x.countedAbi.mappings or {}) do
                    local pointerValue = nextTemp()
                    local countValue = countValues[mapping.countIndex]
                    if not countValue then
                        countValue = nextTemp()
                        countValues[mapping.countIndex] = countValue
                        e(("const %s,%s=%s:ref() "):format(pointerValue, countValue, mapping.pointerName))
                    else
                        local ignoredCount = nextTemp()
                        e(("const %s,%s=%s:ref() "):format(pointerValue, ignoredCount, mapping.pointerName))
                    end
                    pointerValues[mapping.pointerIndex] = pointerValue
                end
                e("return " .. rawName .. "(")
                for physicalIndex, physicalName in ipairs(x.countedAbi.physicalNames or {}) do
                    if physicalIndex > 1 then
                        e(",")
                    end
                    e(pointerValues[physicalIndex] or countValues[physicalIndex] or physicalName)
                end
                e(") end")
            else
                e(('pcall(__nuppFfi.cdef, %q) const %s = %s.%s'):format(sig, name, ns, name), line)
            end
            for _, registration in ipairs(x.name.cleanupRegistrations or {}) do
                local cleanup = registration.cleanup
                e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), line)
            end
            return
        end

        if TYPE_KINDS[kind] or DECL_KINDS[kind] then
            -- Types erase, but a closed affine terminal is an ordinary declaration
            -- reference and must publish that function under its declaration identity.
            -- The assignment is metadata only; the affine value itself stays fully
            -- transparent and allocates nothing.
            for _, registration in ipairs(x.cleanupRegistrations or {}) do
                local cleanup = registration.cleanup
                e(("%s[%q]=%s;"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
            end
            return

        elseif kind == "castExpr" then
            emit(x.expr) -- `as T` vanishes; the operand keeps its grouping

        elseif kind == "unsafeOwnershipExpr" then
            local move = x.expr and x.expr.automaticOwnerMove or nil
            local movedActive = move and activeWith(move) or nil
            if x.operation == "release" and movedActive then
                pluck.loweredFunction(
                    ("(function() %s=false; return "):format(movedActive),
                    sourceLine(x),
                    pluck.reasons.move
                )
                emit(x.expr)
                e(" end)()")
            elseif x.expr then
                emit(x.expr)
            else
                e("nil", sourceLine(x))
            end

        elseif kind == "isExpr" then
            local t = x.type
            local firstTok = x[1] and (cst.isToken(x[1]) and x[1] or x[1][1])
            if x.provenStatically then
                -- The subject's own type already answers this, so there is nothing to
                -- test. The checker only marks a subject that is a path, so dropping it
                -- drops no effect; when the type admits nil, that is the one question
                -- left.
                if x.provenNeedsNil then
                    e("(", firstTok and firstTok.line)
                    emit(x.expr)
                    e("~= nil )")
                else
                    e("( true )", firstTok and firstTok.line)
                end
            elseif x.refutedStatically then
                -- Settled the other way, and by the same reasoning: the subject is a
                -- path, so nothing is lost by not evaluating it.
                e("( false )", firstTok and firstTok.line)
            elseif t.kind == "tname" and t.base.kind == "nil" then
                e("(", firstTok and firstTok.line)
                emit(x.expr)
                e("== nil )")
            elseif t.kind == "tname" and #t == 1 and IS_TYPE[t.base.text] then
                e("( type(", firstTok and firstTok.line)
                emit(x.expr)
                e(') == "' .. IS_TYPE[t.base.text] .. '" )')
            elseif t.kind == "tfunc" then
                e("( type(", firstTok and firstTok.line)
                emit(x.expr)
                e(') == "function" )')
            elseif t.wherePredicate then
                -- A `where` refinement is the declaration's own answer to `is`, and it
                -- comes first: a type carrying one is saying that being stamped here is
                -- not what makes a value one of these. It is also the only answer an
                -- interface can have.
                local line = firstTok and firstTok.line
                local subject = x.expr and x.expr.kind == "name" and x.expr.token and x.expr.token.text or nil
                if subject then
                    -- A name is read as many times as the test names it, and reading a
                    -- name twice is reading the same value twice.
                    e("( " .. predicate.test(t.wherePredicate, subject) .. " )", line)
                else
                    -- Anything else is evaluated once and handed to the test, because a
                    -- refinement may read the subject more than once and the expression
                    -- may not be free to run twice. The test it is handed to is
                    -- declared
                    -- once for the module rather than built here; see `refinement`.
                    local name = pluck.declareHelper(
                        "__nuppIs",
                        "__nuppV",
                        "return " .. predicate.test(t.wherePredicate, "__nuppV")
                    )
                    e(("%s("):format(name), line)
                    emit(x.expr)
                    e(")")
                end
            elseif t.recordName then
                -- A record is nominal: the question is whether the value came from this
                -- declaration. `new R{...}` stamps the record itself, but a constructor
                -- that links back rather than stamping directly is an ordinary Lua
                -- shape. tecs builds its event instances that way, with a per-instance
                -- metatable whose `__index` is the record, and those are instances
                -- too.
                --
                -- Reaching the record through `__index` answers both, because the
                -- record is its own prototype: `R.__index = R` is emitted with it, so a
                -- directly stamped instance arrives at `R` by the same step a linked
                -- one does. The subject is read once, and a value with no metatable at
                -- all falls out as false rather than raising.
                e("( getmetatable(", firstTok and firstTok.line)
                emit(x.expr)
                e(")?.__index == " .. t.recordName .. " )")
            elseif t.reified then
                -- struct target: real runtime identity via ffi.istype
                needsFfi = true
                e("__nuppFfi.istype(" .. t.reified .. ",", firstTok and firstTok.line)
                emit(x.expr)
                e(")")
            else
                -- An interface is not missing a feature here: it has no runtime table
                -- by design, because it is conformance rather than provenance. Three
                -- things can answer for one, so the message names them rather than
                -- implying a fourth is coming.
                local at = t[1] and (cst.isToken(t[1]) and t[1] or nil)
                if t.interfaceName then
                    emitDepth.diag(
                        at,
                        "NUPP3001",
                        "an interface has no runtime identity of its own, so " .. "this `is` has nothing to test",
                        "give it a literal-typed field and the tag becomes the "
                        .. "test; or a `matches` block, which says the test "
                        .. "outright; or test a subject whose own type declares "
                        .. "the interface, which needs no test at all"
                    )
                else
                    emitDepth.diag(
                        at,
                        "NUPP3001",
                        "this type has no runtime identity, so `is` has " .. "nothing to test",
                        "test against a record, a struct, or an interface that " .. "can say what it is"
                    )
                end
                e("true")
            end

        elseif kind == "funcExpr" and x.body and #(x.body.takenCaptures or {}) > 0 then
            emitDepth.affineFunction(x)
            return

        elseif kind == "shortfn" then
            -- The pipes and the arrow survive; only the parameter annotations go. A
            -- named vararg does not: the runtime has no `...name`, so that one form
            -- still becomes an ordinary function expression around the table it stands
            -- for.
            local first = x[1]
            local line = first and (cst.isToken(first) and first.line or (first[1] and first[1].line))
            if not x.varargParam then
                local names = {}
                for _, p in ipairs(x.params) do
                    names[#names + 1] = p.name.text
                end
                e("|" .. table.concat(names, ", ") .. "| ->", line)
                emitDepth.fn = emitDepth.fn + 1
                if x.expr then
                    -- Parentheses force the expression form to return exactly one
                    -- result, as LuaJIT 3.0 specifies it; the 2.1 backport passes a
                    -- multi-return body through.
                    e("(")
                    emit(x.expr)
                    e(")")
                else
                    e("do")
                    emit(x.body)
                    e("end")
                end
                emitDepth.fn = emitDepth.fn - 1
                return
            end
            local names = {}
            for _, p in ipairs(x.params) do
                names[#names + 1] = p.namedVararg and "..." or p.name.text
            end
            e("function(" .. table.concat(names, ", ") .. ")", line)
            emitDepth.fn = emitDepth.fn + 1
            e(("const %s = { n = select(\"#\", ...), ... }"):format(x.varargParam.name.text))
            if x.expr then
                -- Parentheses force the expression form to return exactly one result,
                -- even when its body is a multi-return call.
                e("return (")
                emit(x.expr)
                e(")")
            else
                emit(x.body)
            end
            emitDepth.fn = emitDepth.fn - 1
            e("end")

        elseif kind == "funcbody" and x.varargParam then
            emitDepth.fn = emitDepth.fn + 1
            for _, child in ipairs(x) do
                if child == x.body then
                    e(("const %s = { n = select(\"#\", ...), ... }"):format(x.varargParam.name.text))
                end
                emit(child)
            end
            emitDepth.fn = emitDepth.fn - 1

        elseif kind == "istring" then
            local piecesOpen = false
            local line = x[1] and x[1].line
            e("(", line)
            for _, child in ipairs(x) do
                if cst.isToken(child) then
                    local text = child.text
                    local chunk
                    if child.kind == "istringOpen" then
                        chunk = text:sub(2, -3)
                    elseif child.kind == "istringMid" then
                        chunk = text:sub(2, -3)
                    elseif child.kind == "istringClose" then
                        chunk = text:sub(2, -2)
                    end
                    if chunk and #chunk > 0 then
                        if piecesOpen then
                            e("..")
                        end
                        e(pluck.quote(chunk), child.line)
                        piecesOpen = true
                    end
                else
                    if piecesOpen then
                        e("..")
                    end
                    e("tostring(")
                    emit(child)
                    e(")")
                    piecesOpen = true
                end
            end
            if not piecesOpen then
                e('""')
            end
            e(")")

        elseif kind == "binop" and x.op.kind == "//" then
            e("math.floor((", x.op.line)
            emit(x.lhs)
            e(") / (")
            emit(x.rhs)
            e("))")

        elseif kind == "compoundAssign" and LOWERED_COMPOUND[x.op.kind] then
            -- Only the two the runtime lacks are lowered. Both read the target and then
            -- write it, so an indexed target's prefix and key are bound to temporaries
            -- first: `obj.f //= v` must not re-run whatever produced obj.
            local base = x.op.kind:sub(1, -2)
            local target = x.target
            local first = target[1]
            local line = first and cst.isToken(first) and first.line or (cst.isToken(target) and target.line or nil)
            -- Writes the assignment for a target already reduced to a slot expression
            -- that is cheap and safe to name twice. A `?.` slot suppresses both the
            -- read and the write on a nil receiver, which is what the operator
            -- promises.
            local function assignTo(slot, at)
                if base == "??" then
                    e(("if %s == nil then %s = "):format(slot, slot), at)
                    emit(x.value)
                    e(" end")
                else
                    e(("%s = math.floor((%s) / ("):format(slot, slot), at)
                    emit(x.value)
                    e("))")
                end
            end

            local tkind = target.kind
            if tkind == "name" then
                assignTo(target.token.text, line)
                return
            end
            local safe = tkind == "safeIndex" or tkind == "safeBracket"
            local dotted = tkind == "dotIndex" or tkind == "safeIndex"
            local prefix = nextTemp()
            e(("do const %s = "):format(prefix), line)
            emit(target.obj)
            e("; ")
            local reach = safe and "?." or "."
            if dotted then
                assignTo(("%s%s%s"):format(prefix, reach, target.name.text))
            else
                local key = nextTemp()
                e(("const %s = "):format(key))
                emit(target.expr)
                e("; ")
                assignTo(("%s%s[%s]"):format(prefix, safe and "?." or "", key))
            end
            e(" end")
            return

        elseif kind == "compoundAssign" and x.target and x.target.soaField then
            local target = x.target
            local row = target.obj
            local view = row and row.obj
            if view and row.expr then
                local viewName, indexName = nextTemp(), nextTemp()
                e(("do const %s="):format(viewName), sourceLine(x))
                emit(view)
                e(("; const %s="):format(indexName))
                emit(row.expr)
                local slot = emitDepth.soa.slot(
                    viewName,
                    target.soaField.ordinal,
                    indexName,
                    emitDepth.soa.unchecked(row)
                )
                e(("; %s %s "):format(slot, x.op.kind), x.op.line)
                emit(x.value)
                e(" end")
            else
                emitChildren(x)
            end
            return

        elseif kind == "callStmt" and x.expr and x.expr.logIntrinsic then
            -- The level test stands at the site rather than inside the call, so a
            -- filtered line evaluates none of its arguments -- which is the whole
            -- reason this is an intrinsic and not a library. The module and the line
            -- are constants because the compiler already knows both.
            local call = x.expr
            local severity = call.logIntrinsic
            local line = sourceLine(call)
            local exprs = call.args and call.args.exprs or {}
            -- Reached through the compiler-module registry rather than a binding of its
            -- own, because `emit` sits at Lua's 60-upvalue ceiling and an instrumented
            -- build spends one more. The name it answers is bound to a view that
            -- already
            -- knows the module, so a site carries only its severity and its line.
            local logName = compilerModuleName("nupp.log")
            e(("if %s.on[%d] then %s.emit(%d,%d,"):format(logName, severity, logName, severity, line), line)
            local formatPlan = call.logFormatIntrinsic
            if formatPlan then
                e(pluck.formatHelper(formatPlan) .. "(")
            elseif #exprs > 1 then
                e("string.format(")
            end
            local first = formatPlan and 2 or 1
            for index = first, #exprs do
                if index > first then
                    e(",")
                end
                emit(exprs[index])
            end
            if formatPlan or #exprs > 1 then
                e(")")
            end
            e(") end")
            return

        elseif kind == "callStmt" and x.expr and x.expr.zoneIntrinsic then
            -- The active test and the stack write stand at the site instead of behind a
            -- call, on a receiver the checker proved is exactly the module
            -- `nupp.profile.zone` returns -- a zone marker being a call at all is the
            -- cost `nupp/profile/zone.nupp`'s own comment marks a hot path against. The
            -- receiver is bound once so an expression more elaborate than a bare name
            -- (still possible: the checker only requires a name, not that it stays
            -- simple) is not evaluated twice.
            local call = x.expr
            local op = call.zoneIntrinsic
            local line = sourceLine(call)
            local receiver = call.obj and call.obj.obj
            local zoneName = nextTemp()
            e(("do const %s = "):format(zoneName), line)
            emit(receiver)
            e("; ")
            if op == "push" then
                local depthName = nextTemp()
                e(
                    (
                        "if %s.__nuppActive then const %s=%s.__nuppDepth+1;%s.__nuppDepth=%s;%s.__nuppStack[%s]="
                    ):format(zoneName, depthName, zoneName, zoneName, depthName, zoneName, depthName)
                )
                local exprs = call.args and call.args.exprs or {}
                emit(exprs[1])
                e((";%s.__nuppVersion=%s.__nuppVersion+1 end"):format(zoneName, zoneName))
            else
                local depthName = nextTemp()
                e(
                    (
                        "if %s.__nuppActive and %s.__nuppDepth>0 then const %s=%s.__nuppDepth;"
                        .. "%s.__nuppStack[%s]=nil;%s.__nuppDepth=%s-1;%s.__nuppVersion=%s.__nuppVersion+1 end"
                    ):format(
                        zoneName,
                        zoneName,
                        depthName,
                        zoneName,
                        zoneName,
                        depthName,
                        zoneName,
                        depthName,
                        zoneName,
                        zoneName
                    )
                )
            end
            e(" end")
            return

        elseif kind == "callStmt" and x.expr and x.expr.ownershipIntrinsic == "drop" then
            -- `drop` yields nothing, so the block is all the statement needs. It is
            -- also
            -- what lets the move be marked without a wrapper: this is statement root,
            -- so
            -- the clear is a statement ahead of the value rather than a function built
            -- round it, in the same order.
            local inner = x.expr
            local innerArgs = inner.args and inner.args.exprs or {}
            local innerMove = ownershipMoveOf(innerArgs[1])
            local innerActive = innerMove and activeWith(innerMove) or nil
            e("do", sourceLine(x))
            if innerActive then
                e(("%s=false;"):format(innerActive))
                inner.ownershipMoveCleared = true
            end
            local virtualDrop = innerArgs[1] and emitDepth.view.info(innerArgs[1])
            if not virtualDrop then
                emit(inner)
            end
            inner.ownershipMoveCleared = nil
            e("end")
            return

        elseif kind == "callStmt" and x.expr and x.expr.ownershipIntrinsic == "attemptAll" then
            -- The operations this names are published here, because the call is the
            -- only place they are declared to the runtime. The assignments precede the
            -- call, so the registry holds them by the time the helper reads it.
            local inner = x.expr
            for _, registration in ipairs(inner.cleanupRegistrations or {}) do
                if not registration.after then
                    local cleanup = registration.cleanup
                    e(("%s[%q]=%s;"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
                end
            end
            e("do ", sourceLine(x))
            e("local " .. nextTemp() .. "=")
            emit(inner)
            e(" end")
            return

        elseif kind == "callStmt" and x.expr and x.expr.ownershipIntrinsic then
            -- Every helper intrinsic lowers to a value. Written for the assertion
            -- rather than the value -- surrendering an owner the caller is finished
            -- with -- that leaves an expression where Lua wants a statement, and a file
            -- that checks and builds but will not load. Binding the value keeps
            -- whatever computing it does and lets the block discard it.
            --
            -- The block is also what lets the move be marked without a wrapper: this is
            -- statement root, so the clear is a statement ahead of the value rather
            -- than a
            -- function built round it. The order it needs is the same one.
            local inner = x.expr
            local innerArgs = inner.args and inner.args.exprs or {}
            local innerMove = ownershipMoveOf(innerArgs[1])
            local innerActive = innerMove and activeWith(innerMove) or nil
            e("do ", sourceLine(x))
            if innerActive and inner.ownershipIntrinsic == "drop" then
                e(("%s=false; "):format(innerActive))
                inner.ownershipMoveCleared = true
            end
            e("local " .. nextTemp() .. "=")
            emit(inner)
            inner.ownershipMoveCleared = nil
            e(" end")
            return

        elseif kind == "callStmt" and x.expr and (x.expr.automaticOwnerMoves or x.expr.dynamicPutCleanups) then
            -- A consuming call lowers to an immediately-invoked wrapper. At the start
            -- of a statement its leading `(` can continue the call on the previous
            -- line, because Lua newlines are whitespace: `print(x)\n(function...)()`
            -- is one ambiguous statement. A block makes the expression unambiguously
            -- statement-level without changing nested consuming expressions.
            e("do", sourceLine(x))
            emit(x.expr)
            e("end")
            return

        elseif kind == "call" and x.ffiOutContracts then
            -- An out parameter is a cell the callee writes and the caller reads back,
            -- so
            -- the lowering allocates one, passes it, and unpacks it. None of that
            -- depends
            -- on anything but the C signature: the same declaration lowers to the same
            -- sequence every time, and the callee and the ordinary arguments are the
            -- only
            -- things that vary. So the sequence is declared once and they are handed to
            -- it, rather than a function being built around them per call.
            --
            -- This is the shape that most wanted it. Calling out with an out parameter
            -- in
            -- a loop is what the FFI support is for, and a function built per call
            -- meant
            -- that loop never compiled.
            needsFfi = true
            local line = sourceLine(x)
            local loweredArgs = x.args and x.args.loweredArgs or nil
            local args = loweredArgs or (x.args and x.args.exprs or {})
            local status = x.ffiOutContracts[1].hasStatus and "__nuppS" or nil

            local holders, outputAt, body = {}, {}, {}
            for j, output in ipairs(x.ffiOutContracts) do
                holders[j] = "__nuppH" .. tostring(j)
                outputAt[output.cIndex] = holders[j]
                local spelling = cdefCType(output.typeNode) or "void **"
                spelling = spelling:gsub("%s*%*$", "") .. "[1]"
                body[#body + 1] = ("const %s=__nuppFfi.new(%q); "):format(holders[j], spelling)
            end

            -- The C positions the caller fills become parameters; the rest are the
            -- cells.
            local params, callArguments, inputs = {"__nuppFn"}, {}, 0
            for cIndex = 1, #args + #holders do
                if outputAt[cIndex] then
                    callArguments[#callArguments + 1] = outputAt[cIndex]
                else
                    inputs = inputs + 1
                    params[#params + 1] = "__nuppA" .. tostring(inputs)
                    callArguments[#callArguments + 1] = params[#params]
                end
            end
            body[
                #body + 1
            ] = (
                status and ("const %s="):format(status) or ""
            ) .. ("__nuppFn(%s); return "):format(table.concat(callArguments, ","))

            local results = {}
            if status then
                results[#results + 1] = status
            end
            for j, output in ipairs(x.ffiOutContracts) do
                if output.success == "zero" then
                    results[#results + 1] = ("(%s==0 and %s[0] or nil)"):format(status, holders[j])
                elseif output.success == "nonzero" then
                    results[#results + 1] = ("(%s~=0 and %s[0] or nil)"):format(status, holders[j])
                elseif output.success:match("^notequals:") then
                    local literal = output.success:sub(#"notequals:" + 1)
                    results[#results + 1] = ("(%s~=%s and %s[0] or nil)"):format(status, literal, holders[j])
                elseif output.success:match("^equals:") then
                    local literal = output.success:sub(#"equals:" + 1)
                    results[#results + 1] = ("(%s==%s and %s[0] or nil)"):format(status, literal, holders[j])
                else
                    results[#results + 1] = holders[j] .. "[0]"
                end
            end
            body[#body + 1] = table.concat(results, ",")

            e(pluck.declareHelper("__nuppOut", table.concat(params, ","), table.concat(body)) .. "(", line)
            emit(x.obj)
            for j = 1, inputs do
                e(",")
                if loweredArgs then
                    pluck.emitArgument(args[j], x.args)
                else
                    emit(args[j])
                end
            end
            e(")")
            return

        elseif kind == "call" and x.ownershipIntrinsic then
            local args = x.args and x.args.exprs or {}
            local line = sourceLine(x)
            local move = ownershipMoveOf(args[1])
            local movedActive = move and activeWith(move) or nil
            -- The move has to be marked before the value is produced: if producing it
            -- raises, the region must already know the owner left, or unwinding frees
            -- it a
            -- second time. A statement can say that, and at statement root the caller
            -- already has; here, in the middle of an expression, only a wrapper can,
            -- and
            -- that wrapper is a function built every time this runs.
            local wrapsMove = movedActive ~= nil and not x.ownershipMoveCleared and x.ownershipIntrinsic == "drop"
            if wrapsMove then
                pluck.loweredFunction(("(function() %s=false; return "):format(movedActive), line, pluck.reasons.move)
            end
            if x.ownershipIntrinsic == "borrow" then
                if args[1] then
                    emit(args[1])
                else
                    e("nil", line)
                end
            elseif x.ownershipIntrinsic == "borrowFrom" then
                if args[1] then
                    emit(args[1])
                else
                    e("nil", line)
                end
            elseif x.ownershipIntrinsic == "partition" then
                e("(function() return ", line)
                if args[2] then
                    emit(args[2])
                else
                    e("nil")
                end
                e(",")
                if args[3] then
                    emit(args[3])
                else
                    e("nil")
                end
                e(" end)()")
            elseif x.ownershipIntrinsic == "region" then
                if args[2] then
                    emit(args[2])
                else
                    e("nil", line)
                end
            elseif x.ownershipIntrinsic == "pin" then
                e("{pointer=", line)
                if args[1] then
                    emit(args[1])
                else
                    e("nil")
                end
                e(",anchor=")
                if args[2] then
                    emit(args[2])
                else
                    e("nil")
                end
                e("}")
            elseif x.ownershipIntrinsic == "attemptAll" then
                -- Every step is attempted, and the first failure is the primary one.
                -- The body reads its parameter and nothing else, so this is one
                -- function per operation list rather than one per call site.
                ensureCleanupRuntime()
                local statements = {"if __nuppV == nil then return end local __errs,__n={},0; "}
                for _, cleanup in ipairs(x.ownerCleanups or {}) do
                    local call = protectedCleanupCall(cleanup, "__nuppV", cleanupGlobals.pcall)
                    if call then
                        statements[
                            #statements + 1
                        ] = "do local __ok,__reason="
                            .. call
                            .. "; if not __ok then __n=__n+1; __errs[__n]=__reason end end; "
                    end
                end
                statements[
                    #statements + 1
                ] = (
                    "if __n>0 then if __n>1 then %s(%s(__errs[1],__errs,2),0) else %s(__errs[1],0) end end"
                ):format(cleanupGlobals.error, cleanupFailureName, cleanupGlobals.error)
                e(pluck.declareHelper("__nuppAttemptAll", "__nuppV", table.concat(statements)) .. "(", line)
                if args[1] then
                    emit(args[1])
                else
                    e("nil")
                end
                e(")")
            else -- drop
                -- The body reads its parameter and nothing else, so the cleanups a
                -- `drop`
                -- runs are the same function every time it runs them.
                local statements = {"if __nuppV == nil then return end "}
                for _, cleanup in ipairs(x.ownerCleanups or {}) do
                    local call = cleanupCall(cleanup, "__nuppV")
                    if call then
                        statements[#statements + 1] = call .. "; "
                    end
                end
                e(pluck.declareHelper("__nuppDrop", "__nuppV", table.concat(statements)) .. "(", line)
                if args[1] then
                    emit(args[1])
                else
                    e("nil")
                end
                e(")")
            end
            if wrapsMove then
                e(" end)()")
            end
            return

        elseif kind == "call" and x.ffiIntrinsic then
            -- the type argument becomes the ctype value the FFI expects
            needsFfi = true
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            -- a declared struct is already a ctype value; anything else is named by its
            -- C spelling
            local ctypeExpr = x.ffiTypeName
            if not ctypeExpr then
                local typeNode = x.ffiTypeNode
                -- Viewing memory as a C array is a pointer cast. LuaJIT refuses a cast
                -- to `T[?]` outright, and for `T[N]` it would mean a pointer to the
                -- whole array rather than to its first element, which is not what
                -- indexing the result expects.
                if x.ffiIntrinsic == "cast" and typeNode and typeNode.kind == "tcarray" then
                    typeNode = typeNode.element
                    local element = typeNode and cdefCType(typeNode)
                    if element then
                        e(("__nuppFfi.cast(%q"):format(element .. " *"), line)
                        for _, arg in ipairs(x.args and x.args.exprs or {}) do
                            e(",")
                            emit(arg)
                        end
                        e(")")
                        return
                    end
                end
                local spelling = x.ffiTypeNode and cdefCType(x.ffiTypeNode)
                if not spelling then
                    emitDepth.diag(
                        x.name or (x[1] and cst.isToken(x[1]) and x[1]),
                        "NUPP3004",
                        "this type has no C spelling for an ffi operation"
                    )
                    spelling = "void *"
                end
                ctypeExpr = ("%q"):format(spelling)
            end
            e(("__nuppFfi.%s(%s"):format(x.ffiIntrinsic, ctypeExpr), line)
            for _, arg in ipairs(x.args and x.args.exprs or {}) do
                e(",")
                emit(arg)
            end
            e(")")
            return

        elseif kind == "call" and x.carrayElem then
            -- one array ctype per element type, built once and reused
            needsFfi = true
            needsArrayCache = true
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            e("__nuppArray(", line)
            emit(x.carrayElem)
            e(")(")
            local args = x.args and x.args.exprs or {}
            if args[2] then
                emit(args[2])
            end
            e(")")
            return

        elseif kind == "call" and x.cheaderCdef then
            -- the declarations go in, and the library namespace comes out; indexing it
            -- resolves each symbol
            needsFfi = true
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            local library = x.cheaderLib and (pluck.hotLibraries[x.cheaderLib] or x.cheaderLib) or nil
            local ns = library and ("__nuppFfi.load(%q)"):format(library) or "__nuppFfi.C"
            -- pcall: a header may be declared twice in one process, and redeclaring a
            -- type is an error rather than a no-op
            pluck.loweredFunction(
                ("(function() pcall(__nuppFfi.cdef, %q) return %s end)()"):format(x.cheaderCdef, ns),
                line,
                pluck.reasons.cheader
            )
            return

        elseif kind == "newExpr" then
            -- `new` is a compile-time word: it decides which lowering the call
            -- underneath gets and then leaves, so a construction emits exactly the
            -- stamp or the ctype call it always did.
            if x.call then
                emit(x.call)
            end
            return

        elseif kind == "call" and x.dynamicRecoverPolicy then
            -- The type witness is compile-time-only. Recovery receives the exact same
            -- representation-and-cleanup key injected at `put`, so runtime code never
            -- guesses from a display name or invokes cleanup through the requested
            -- type before validating it.
            local callee = x.obj
            if callee and callee.kind == "dotIndex" and callee.obj then
                emit(callee.obj)
                e("._recover(")
                local args = x.args and x.args.exprs or {}
                if args[1] then
                    emit(args[1])
                else
                    e("nil")
                end
                e((",%q)"):format(x.dynamicRecoverPolicy))
                return
            end

        elseif (
            kind == "call" or kind == "methodCall"
        ) and x.automaticOwnerMoves and not x.resourceAdoptCleanups and not x.dynamicPutCleanups then
            -- Evaluate the complete callee/receiver and argument list before ending
            -- the caller's cleanup responsibility. Once the wrapper body begins the
            -- callee is about to receive every `takes` value, so a raise belongs to
            -- the callee's terminal contract rather than this lexical region.
            local activeNames, seen = {}, {}
            for _, move in ipairs(x.automaticOwnerMoves or {}) do
                local activeName = activeWith(move)
                if activeName and not seen[activeName] then
                    seen[activeName] = true
                    activeNames[#activeNames + 1] = activeName
                end
            end
            local callable = nextTemp()
            pluck.loweredFunction(("(function(%s,...) "):format(callable), sourceLine(x), pluck.reasons.move)
            for _, activeName in ipairs(activeNames) do
                e(("%s=false; "):format(activeName))
            end
            if kind == "methodCall" then
                e(("return %s:%s(...)"):format(callable, x.overloadMember or x.name.text))
            else
                e(("return %s(...)"):format(callable))
            end
            e(" end)(")
            emit(x.obj)
            local args = x.args
            local values = args and args.exprs or {}
            if args and args.table then
                values = {args.table}
            end
            if args and args.string then
                values = {args.string}
            end
            if args and args.loweredArgs then
                if #args.loweredArgs > 0 then
                    e(",")
                    pluck.emitArgs(args)
                end
            else
                for _, value in ipairs(values) do
                    e(",")
                    emit(value)
                end
            end
            e(")")
            return

        elseif kind == "methodCall" and x.dynamicPutCleanups then
            if hotState and x.dynamicTypePolicy then
                hotState.policies[x.dynamicTypePolicy] = true
            end
            local line = sourceLine(x)
            local args = x.args and x.args.exprs or {}
            local activeNames, seen = {}, {}
            for _, move in ipairs(x.automaticOwnerMoves or {}) do
                local activeName = activeWith(move)
                if activeName and not seen[activeName] then
                    seen[activeName] = true
                    activeNames[#activeNames + 1] = activeName
                end
            end
            local object, value = nextTemp(), nextTemp()
            pluck.loweredFunction(("(function(%s,%s) "):format(object, value), line, pluck.reasons.move)
            for _, activeName in ipairs(activeNames) do
                e(("%s=false; "):format(activeName))
            end
            local body = {"local __first,__suppressed=nil,0; "}
            for _, cleanup in ipairs(x.dynamicPutCleanups) do
                local call = protectedCleanupCall(cleanup, "__nuppV", "pcall")
                if call then
                    body[
                        #body + 1
                    ] = "do local __ok,__reason="
                        .. call
                        .. "; if not __ok then if __first==nil then __first=__reason "
                        .. "else __suppressed=__suppressed+1 end end end; "
                end
            end
            body[
                #body + 1
            ] = "if __first~=nil then if __suppressed>0 then "
                .. "error(tostring(__first)..\" (suppressed \"..tostring(__suppressed)"
                .. "..\" cleanup failure(s))\",0) else error(__first,0) end end"
            e(
                (
                    "return %s:_put(%s,%s,%q)"
                ):format(
                    object,
                    value,
                    pluck.declareHelper("__nuppDynamicCleanup", "__nuppV", table.concat(body)),
                    x.dynamicTypePolicy or ""
                )
            )
            e(" end)(")
            emit(x.obj)
            e(",")
            if args[1] then
                emit(args[1])
            else
                e("nil")
            end
            e(")")
            return

        elseif kind == "methodCall" and x.resourceAdoptCleanups then
            local line = sourceLine(x)
            local args = x.args and x.args.exprs or {}
            local activeNames, seen = {}, {}
            for _, move in ipairs(x.automaticOwnerMoves or {}) do
                local activeName = activeWith(move)
                if activeName and not seen[activeName] then
                    seen[activeName] = true
                    activeNames[#activeNames + 1] = activeName
                end
            end
            local object, value = nextTemp(), nextTemp()
            pluck.loweredFunction(("(function(%s,%s) "):format(object, value), line, pluck.reasons.move)
            for _, activeName in ipairs(activeNames) do
                e(("%s=false; "):format(activeName))
            end
            -- The cleanup this hands to `adopt` reads its parameter and nothing else,
            -- so
            -- it is one function for the module rather than one per adoption. The
            -- wrapper
            -- around it stays where it is: that one clears this site's own `active`
            -- flags,
            -- which no shared function could reach.
            local body = {"local __first,__suppressed=nil,0; "}
            for _, cleanup in ipairs(x.resourceAdoptCleanups) do
                local call = protectedCleanupCall(cleanup, "__nuppV", "pcall")
                if call then
                    body[
                        #body + 1
                    ] = "do local __ok,__reason="
                        .. call
                        .. "; if not __ok then if __first==nil then __first=__reason "
                        .. "else __suppressed=__suppressed+1 end end end; "
                end
            end
            body[
                #body + 1
            ] = "if __first~=nil then if __suppressed>0 then "
                .. "error(tostring(__first)..\" (suppressed \"..tostring(__suppressed)"
                .. "..\" cleanup failure(s))\",0) else error(__first,0) end end"
            e(
                (
                    "return %s:adopt(%s,%s)"
                ):format(object, value, pluck.declareHelper("__nuppAdopt", "__nuppV", table.concat(body)))
            )
            e(" end)(")
            emit(x.obj)
            e(",")
            if args[1] then
                emit(args[1])
            else
                e("nil")
            end
            e(")")
            return

        elseif kind == "methodCall" and x.overloadMember then
            -- The checker selected one overload statically. Its hidden member is a real
            -- Lua method, so colon syntax evaluates the receiver once and calls that
            -- exact body without a dispatcher.
            local line = sourceLine(x)
            emit(x.obj)
            if x.safeObj then
                e("?.:" .. x.overloadMember, line)
            else
                e(":" .. x.overloadMember, line)
            end
            if x.safeMethod then
                e("?.")
            end
            if x.args then
                emit(x.args)
            end
            return

        elseif (kind == "call" or kind == "safeCall") and x.constructorCall then
            -- A declared constructor is a direct call to the function minted for it,
            -- resolved here rather than dispatched at run time.
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            e(x.constructorCall .. "." .. constructorMember(x.constructorIndex), line)
            if x.args then
                emit(x.args)
            end
            return

        elseif (kind == "call" or kind == "safeCall") and x.structConstruct then
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            e(x.structConstruct .. "(", line)
            for index, binding in ipairs(x.recordFields or {}) do
                if index > 1 then
                    e(", ")
                end
                if binding.isDefault then
                    e(pluck.renderData(binding.defaultValue))
                else
                    emit(binding.node)
                end
            end
            e(")")
            return

        elseif (kind == "call" or kind == "safeCall") and x.recordConstruct then
            -- `new R(...)` builds an ordinary table carrying R as its metatable. The
            -- table is written here rather than taken from the call, so a construction
            -- allocates the instance and nothing besides it.
            --
            -- The fields come out in the order they were written, whether the call
            -- named them or left them to the declaration's order, because that is
            -- where the source put the evaluation of their values.
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            e("setmetatable({", line)
            for index, binding in ipairs(x.recordFields or {}) do
                if index > 1 then
                    e(", ")
                end
                e(cst.identifier(binding.name) and (binding.name .. " = ") or ("[%q] = "):format(binding.name))
                if binding.isDefault then
                    e(pluck.renderData(binding.defaultValue))
                else
                    emit(binding.node)
                end
            end
            e("}, " .. x.recordConstruct .. ")")
            return

        elseif kind == "constructorDecl" and x.inlineRuntimeOwner then
            -- The instance is made before the body runs and returned after it, so the
            -- body only fills fields in. Both halves sit on the lines the `constructor`
            -- and its `end` already occupy, which is what keeps the generated file's
            -- line count equal to the source's.
            local body = x.body
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            local names = {}
            for index, p in ipairs(body.params or {}) do
                -- The receiver is written out the way a method's is, and is no more an
                -- argument here than it is there: the instance is made below, so a
                -- parameter of that name would shadow it with whatever the caller
                -- happened to pass first.
                if index == 1 and p.name and p.name.text == "self" then
                    -- skipped
                elseif p.namedVararg then
                    names[#names + 1] = "..."
                elseif p.name then
                    names[#names + 1] = p.name.text
                elseif p.vararg or p[1] and cst.isToken(p[1]) and p[1].kind == "..." then
                    names[#names + 1] = "..."
                end
            end
            local owner = x.inlineRuntimeOwner
            local seeded = {}
            local nominal = x.ownerNominal
            for _, field in ipairs(nominal and nominal.fieldOrder or {}) do
                local default = nominal.fieldDefaults and nominal.fieldDefaults[field] or nil
                if default then
                    seeded[
                        #seeded + 1
                    ] = (
                        cst.identifier(field) and (field .. " = ") or ("[%q] = "):format(field)
                    ) .. pluck.renderData(default.value)
                end
            end
            e(
                (
                    "function %s.%s(%s) local self = setmetatable({%s}, %s)"
                ):format(
                    owner,
                    constructorMember(x.constructorIndex),
                    table.concat(names, ", "),
                    table.concat(seeded, ", "),
                    owner
                ),
                line
            )
            if body.varargParam then
                e(("const %s = { n = select(\"#\", ...), ... }"):format(body.varargParam.name.text))
            end
            emitDepth.fn = emitDepth.fn + 1
            if body.body then
                emit(body.body)
            end
            emitDepth.fn = emitDepth.fn - 1
            local endTok
            for j = #body, 1, -1 do
                local child = body[j]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("return self end", endTok and endTok.line or nil)
            return

        elseif kind == "inlineMethod" and x.inlineRuntimeOwner then
            local dispatch = pluck.hotDispatch
            local planned = dispatch and dispatch.byNode[x] or nil
            if dispatch and planned then
                dispatch.emit(planned)
                for _, registration in ipairs(x.name and x.name.cleanupRegistrations or {}) do
                    local cleanup = registration.cleanup
                    e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
                end
                return
            end
            local body = x.body
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            local names = {}
            for _, p in ipairs(body.params or {}) do
                if p.namedVararg then
                    names[#names + 1] = "..."
                elseif p.name then
                    names[#names + 1] = p.name.text
                elseif p.vararg or p[1] and cst.isToken(p[1]) and p[1].kind == "..." then
                    names[#names + 1] = "..."
                end
            end
            if x.inlineDotted then
                -- Defaults and statics are plain functions on a declaration table.
                -- A default's explicitly written `self` remains its first parameter;
                -- a static has no receiver to add.
                e(
                    (
                        "function %s.%s(%s)"
                    ):format(x.inlineRuntimeOwner, x.overloadMember or x.name.text, table.concat(names, ", ")),
                    line
                )
            else
                -- A method may write its receiver out, and the checker reads it as the
                -- receiver either way. The colon already binds one, so emitting the
                -- declared name beside it would declare `self` twice: the inner one
                -- shadows the receiver with the first actual argument, which for
                -- `obj:m()` is nil. Drop it here, and the two spellings generate the
                -- same function.
                if names[1] == "self" then
                    table.remove(names, 1)
                end
                e(
                    (
                        "function %s:%s(%s)"
                    ):format(x.inlineRuntimeOwner, x.overloadMember or x.name.text, table.concat(names, ", ")),
                    line
                )
            end
            if body.varargParam then
                e(("const %s = { n = select(\"#\", ...), ... }"):format(body.varargParam.name.text))
            end
            emitDepth.fn = emitDepth.fn + 1
            if body.body then
                emit(body.body)
            end
            emitDepth.fn = emitDepth.fn - 1
            local endTok
            for j = #body, 1, -1 do
                local child = body[j]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("end", endTok and endTok.line or nil)
            for _, registration in ipairs(x.name and x.name.cleanupRegistrations or {}) do
                local cleanup = registration.cleanup
                e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
            end
            return

        elseif kind == "funcStmt" and x.structOwner and x.memberName then
            local dispatch = pluck.hotDispatch
            local planned = dispatch and dispatch.byNode[x] or nil
            if dispatch and planned then
                dispatch.emit(planned)
                return
            end
            needsFfi = true
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or nil
            local names = {}
            if x.name.method then
                names[1] = "self"
            end
            for _, p in ipairs(x.body.params or {}) do
                if p.namedVararg then
                    names[#names + 1] = "..."
                elseif p.name then
                    names[#names + 1] = p.name.text
                elseif p.vararg or p[1] and cst.isToken(p[1]) and p[1].kind == "..." then
                    names[#names + 1] = "..."
                end
            end
            e(
                (
                    "__nuppMt_%s.__index.%s = function(%s)"
                ):format(x.structOwner, x.memberName, table.concat(names, ", ")),
                line
            )
            if x.body.varargParam then
                e(("const %s = { n = select(\"#\", ...), ... }"):format(x.body.varargParam.name.text))
            end
            emitDepth.fn = emitDepth.fn + 1
            if x.body.body then
                emit(x.body.body)
            end
            emitDepth.fn = emitDepth.fn - 1
            -- close on the source's own `end` so the line count is unchanged
            local endTok
            for j = #x.body, 1, -1 do
                local child = x.body[j]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("end", endTok and endTok.line or nil)
            return

        elseif kind == "handleStmt" then
            -- A handled extent is an ordinary owned cleanup region whose acquisition
            -- happens to be compiler-provided. Reusing the same lowering is what lets
            -- return, loop control and goto cross the protected closure while release
            -- still runs exactly once and combines its failure with a body failure.
            local name = nextTemp()
            local definition = {}
            local binding: any = {
                kind = "cleanupBinding",
                name = {
                    kind = "name",
                    text = name,
                    line = x.handleTok and x.handleTok.line or sourceLine(x),
                    offset = x.handleTok and x.handleTok.offset or 0,
                    definition = definition,
                },
                expr = {
                    kind = "suspensionInstallExpr",
                    handler = x.handler,
                    line = x.handleTok and x.handleTok.line or sourceLine(x),
                },
                ownerCleanups = {{kind = "method", name = "release", id = "method:release"}},
            }
            local region: any = {
                kind = "cleanupRegion",
                startTok = x.handleTok,
                doTok = x.doTok,
                endTok = x.endTok,
                bindings = {binding},
                body = x.body,
            }
            region.capturesEnclosing = automaticCaptures(x.body, region.bindings)
            emit(region)

        elseif kind == "cleanupRegion" or kind == "withStmt" then
            local virtualBinding = kind == "withStmt" and x.bindings and x.bindings[
                1
            ] and x.bindings[1].virtualIndexedView or nil
            if virtualBinding then
                local binding = x.bindings[1]
                virtualBinding.anchorName = virtualBinding.anchorName or nextTemp()
                e("do const " .. virtualBinding.anchorName .. "=", x.withTok and x.withTok.line or sourceLine(x))
                emit(virtualBinding.source)
                e("; const " .. binding.name.text .. "=", sourceLine(binding.expr))
                emit(binding.expr)
                e("; do")
                if x.body then
                    emit(x.body)
                end
                e("end end", x.endTok and x.endTok.line or nil)
                return
            elseif kind == "withStmt" and x.directCleanup then
                local binding = x.bindings[1]
                e("do const ", x.withTok and x.withTok.line or sourceLine(x))
                e(binding.name.text .. "=", sourceLine(binding.expr))
                local move = binding.expr and binding.expr.automaticOwnerMove or nil
                local movedActive = move and activeWith(move) or nil
                emit(binding.expr)
                if movedActive then
                    e(("; %s=false"):format(movedActive))
                end
                e("; do")
                if x.body then
                    emit(x.body)
                end
                e("end;")
                for _, cleanup in ipairs(binding.ownerCleanups or {}) do
                    local call = cleanupCall(cleanup, binding.name.text)
                    if call then
                        e(call .. ";", x.endTok and x.endTok.line or nil)
                    end
                end
                e("end")
                return
            end
            ensureCleanupRuntime()
            local count = nextTemp()
            local ok = nextTemp()
            -- On success this holds the completion tag; on failure, the error.
            local tag = nextTemp()
            local payload = nextTemp()
            local cleanupError = nextTemp()
            local hasCleanupError = nextTemp()
            local owners = {}
            local active = {}
            local fieldActive = {}
            local fieldActiveOrder = {}
            local automaticMap = {}
            for j = 1, #(x.bindings or {}) do
                owners[j] = nextTemp()
                local automatic = x.bindings[j].automaticOwner
                if automatic and (automatic.conditional or automatic.moved or automatic.movedFields) then
                    active[j] = nextTemp()
                    fieldActive[j] = {}
                    fieldActiveOrder[j] = {}
                    for field in pairs(automatic.movedFields or {}) do
                        fieldActiveOrder[j][#fieldActiveOrder[j] + 1] = field
                    end
                    table.sort(fieldActiveOrder[j])
                    for _, field in ipairs(fieldActiveOrder[j]) do
                        fieldActive[j][field] = nextTemp()
                    end
                    automaticMap[automatic] = {whole = active[j], fields = fieldActive[j], slot = owners[j],}
                end
            end
            local variadic = usesVararg(x.body)
            local ctx = {
                entryLoopDepth = emitDepth.loop,
                functionDepth = emitDepth.fn,
                labels = labelsIn(x.body),
                gotos = {},
                automaticMap = automaticMap,
            }
            -- A body that would read no earlier execution's variables can be served by
            -- one region function for the whole module. That is what lets a loop around
            -- an automatic owner compile at all: building a closure per execution is
            -- `NYI: bytecode FNEW` and aborts the enclosing trace whether or not it
            -- captures. Acquisition moves out of the protected region because a lone
            -- binding that fails to acquire leaves nothing to clean up.
            local shared = not x.capturesEnclosing and #(
                x.bindings or {}
            ) == 1 and not active[1] and not x.automaticComplex
            if shared then
                cleanupCacheSites = cleanupCacheSites + 1
                local slot = cleanupCacheSites
                local region = nextTemp()
                local binding = x.bindings[1]
                e("do const ", (x.startTok or x.withTok) and (x.startTok or x.withTok).line or sourceLine(x))
                e(("%s="):format(owners[1]), sourceLine(binding.expr))
                local move = binding.expr and binding.expr.automaticOwnerMove or nil
                local movedActive = move and activeWith(move) or nil
                emit(binding.expr)
                if movedActive then
                    -- Marked after the binding rather than around it. This is already a
                    -- statement, so the clear can be one too, and nothing runs between
                    -- the
                    -- two that could tell the difference -- where wrapping it meant a
                    -- function built on every acquisition, which is one a loop cannot
                    -- record.
                    e(("; %s=false"):format(movedActive))
                end
                e(
                    (
                        "; local %s=%s[%d]; if not %s then %s=function(%s%s)"
                    ):format(
                        region,
                        cleanupCacheName,
                        slot,
                        region,
                        region,
                        binding.name.text,
                        variadic and ",..." or ""
                    )
                )
                cleanupStack[#cleanupStack + 1] = ctx
                e("do")
                if x.body then
                    emit(x.body)
                end
                e(("end; return \"normal\" end; %s[%d]=%s end;"):format(cleanupCacheName, slot, region))
                e(
                    (
                        "const %s,%s,%s=%s(%s,%s,%s%s);"
                    ):format(
                        ok,
                        tag,
                        payload,
                        cleanupGlobals.xpcall,
                        region,
                        cleanupIdName,
                        owners[1],
                        variadic and ",..." or ""
                    )
                )
                cleanupStack[#cleanupStack] = nil
                e(("const %s=1;"):format(count))
            else
                e(
                    ("do local %s=0; local "):format(count),
                    (x.startTok or x.withTok) and (x.startTok or x.withTok).line or sourceLine(x)
                )
                e(table.concat(owners, ","))
                for j = 1, #(x.bindings or {}) do
                    if active[j] then
                        e(("; local %s=false"):format(active[j]))
                    end
                    for _, field in ipairs(fieldActiveOrder[j] or {}) do
                        e(("; local %s=false"):format(fieldActive[j][field]))
                    end
                end
                pluck.loweredFunction(
                    (
                        "; const %s,%s,%s=%s(function(%s)"
                    ):format(ok, tag, payload, cleanupGlobals.xpcall, variadic and "..." or ""),
                    nil,
                    pluck.reasons.region
                )
                cleanupStack[#cleanupStack + 1] = ctx
                -- Emits the acquisition and hands back the flag its move clears, if it
                -- has
                -- one. Every caller is finishing a statement, so the clear can be one
                -- too:
                -- nothing runs between the acquisition and it that could tell the
                -- difference, where wrapping it meant a function built per acquisition,
                -- which is one a loop cannot record.
                local function emitAcquired(binding, expr): string?
                    emit(expr)
                    local move = expr and expr.automaticOwnerMove or nil

                    return move and activeWith(move) or nil
                end

                local function activateValue(j, binding, value)
                    e(("%s="):format(owners[j]), sourceLine(binding.expr))
                    e(value)
                    e(("; %s=%d;"):format(count, j))
                    if active[j] then
                        e((" %s=true;"):format(active[j]))
                    end
                    for _, field in ipairs(fieldActiveOrder[j] or {}) do
                        e((" %s=true;"):format(fieldActive[j][field]))
                    end
                end

                local function activationCondition(binding)
                    local alternatives = binding.automaticOwner and binding.automaticOwner.activation or nil
                    if not alternatives then
                        return nil
                    end
                    local clauses = {}
                    for _, tests in ipairs(alternatives) do
                        local parts = {}
                        for _, test in ipairs(tests) do
                            local name = binding.automaticOwner.correlation.names[test.index]
                            local constant = test.constant
                            local literal = type(
                                constant
                            ) == "string" and ("%q"):format(constant) or constant == nil and "nil" or tostring(constant)
                            parts[#parts + 1] = ("%s==%s"):format(name, literal)
                        end
                        clauses[#clauses + 1] = "(" .. table.concat(parts, " and ") .. ")"
                    end

                    return table.concat(clauses, " or ")
                end

                local function activate(j, binding, deferName)
                    local value = nextTemp()
                    e(("const %s="):format(value), sourceLine(binding.expr))
                    local cleared = emitAcquired(binding, binding.expr)
                    e(";")
                    if cleared then
                        e((" %s=false;"):format(cleared))
                    end
                    activateValue(j, binding, value)
                    if not deferName then
                        e((" %s %s=%s;"):format(binding.isConst and "const" or "local", binding.name.text, owners[j]))
                    end
                end

                if x.automaticSequence then
                    local bindingIndex = {}
                    for j, binding in ipairs(x.bindings or {}) do
                        bindingIndex[binding] = j
                    end
                    e("do")
                    for _, item in ipairs(x.automaticSequence) do
                        if item.declaration then
                            local stat = item.declaration
                            local names, exprs = stat.names or {}, stat.exprs or {}
                            local bySlot = {}
                            for _, binding in ipairs(item.bindings) do
                                bySlot[binding.declarationIndex] = binding
                            end
                            local staged = {}
                            for exprIndex, expr in ipairs(exprs) do
                                if exprIndex == #exprs and #names > #exprs then
                                    local packed = nextTemp()
                                    e(("const %s=%s("):format(packed, cleanupPackName), sourceLine(expr))
                                    local cleared = emitAcquired(bySlot[exprIndex], expr)
                                    e(");")
                                    if cleared then
                                        e((" %s=false;"):format(cleared))
                                    end
                                    for nameIndex = exprIndex, #names do
                                        staged[nameIndex] = ("%s[%d]"):format(packed, nameIndex - exprIndex + 1)
                                    end
                                else
                                    local value = nextTemp()
                                    e(("const %s="):format(value), sourceLine(expr))
                                    local cleared = emitAcquired(bySlot[exprIndex], expr)
                                    e(";")
                                    if cleared then
                                        e((" %s=false;"):format(cleared))
                                    end
                                    staged[exprIndex] = value
                                end
                                if exprIndex < #exprs then
                                    local binding = bySlot[exprIndex]
                                    if binding then
                                        activateValue(bindingIndex[binding], binding, staged[exprIndex])
                                    end
                                end
                            end
                            for nameIndex = #exprs, #names do
                                local binding = bySlot[nameIndex]
                                if binding and not binding.automaticOwner.conditional then
                                    activateValue(bindingIndex[binding], binding, staged[nameIndex])
                                end
                            end
                            e(stat.isConst and " const " or " local ")
                            for nameIndex, name in ipairs(names) do
                                if nameIndex > 1 then
                                    e(",")
                                end
                                e(name.text)
                            end
                            e("=")
                            for nameIndex = 1, #names do
                                if nameIndex > 1 then
                                    e(",")
                                end
                                e(staged[nameIndex] or "nil")
                            end
                            e(";")
                            for _, binding in ipairs(item.bindings) do
                                if binding.automaticOwner.conditional then
                                    local j = bindingIndex[binding]
                                    activateValue(j, binding, staged[binding.declarationIndex])
                                    if active[j] then
                                        e((" %s=%s;"):format(active[j], activationCondition(binding) or "false"))
                                    end
                                end
                            end
                        elseif item.bindings then
                            -- Evaluate and register every initializer before exposing
                            -- any of this declaration's names, matching Lua's local
                            -- declaration visibility while still protecting a prefix
                            -- when a later initializer raises.
                            for _, binding in ipairs(item.bindings) do
                                activate(bindingIndex[binding], binding, true)
                            end
                            for _, binding in ipairs(item.bindings) do
                                e(
                                    (
                                        " %s %s=%s;"
                                    ):format(
                                        binding.isConst and "const" or "local",
                                        binding.name.text,
                                        owners[bindingIndex[binding]]
                                    )
                                )
                            end
                        elseif item.stat then
                            emit(item.stat)
                        end
                    end
                else
                    for j, binding in ipairs(x.bindings or {}) do
                        activate(j, binding)
                    end
                    e("do")
                    if x.body then
                        emit(x.body)
                    end
                end
                e(("end; return \"normal\" end,%s%s);"):format(cleanupIdName, variadic and ",..." or ""))
                cleanupStack[#cleanupStack] = nil
            end
            e(("const %s={}; local %s=0;"):format(cleanupError, hasCleanupError), x.endTok and x.endTok.line or nil)
            for j = #(x.bindings or {}), 1, -1 do
                local binding = x.bindings[j]
                local present = binding.automaticOwner and binding.automaticOwner.optional
                if active[j] then
                    e(
                        (
                            "if %s>=%d and %s%s then "
                        ):format(count, j, active[j], present and (" and " .. owners[j] .. "~=nil") or "")
                    )
                else
                    e(("if %s>=%d%s then "):format(count, j, present and (" and " .. owners[j] .. "~=nil") or ""))
                end
                for _, cleanup in ipairs(binding.ownerCleanups or {}) do
                    local fieldName = cleanup.kind == "field" and fieldActive[
                        j
                    ] and fieldActive[j][cleanup.field] or nil
                    if fieldName then
                        e(("if %s then "):format(fieldName))
                    end
                    local call = protectedCleanupCall(cleanup, owners[j], cleanupGlobals.pcall)
                    if call then
                        local cok, cerr = nextTemp(), nextTemp()
                        e(("const %s,%s=%s;"):format(cok, cerr, call))
                        e(
                            (
                                " if not %s then %s=%s+1; %s[%s]=%s end;"
                            ):format(cok, hasCleanupError, hasCleanupError, cleanupError, hasCleanupError, cerr)
                        )
                    end
                    if fieldName then
                        e("end;")
                    end
                end
                e("end;")
            end
            e(
                (
                    "if not %s then if %s>0 then %s(%s(%s,%s,1),0) else %s(%s,0) end end;"
                ):format(
                    ok,
                    hasCleanupError,
                    cleanupGlobals.error,
                    cleanupFailureName,
                    tag,
                    cleanupError,
                    cleanupGlobals.error,
                    tag
                )
            )
            e(
                (
                    "if %s>0 then if %s>1 then %s(%s(%s[1],%s,2),0) else %s(%s[1],0) end end;"
                ):format(
                    hasCleanupError,
                    hasCleanupError,
                    cleanupGlobals.error,
                    cleanupFailureName,
                    cleanupError,
                    cleanupError,
                    cleanupGlobals.error,
                    cleanupError
                )
            )
            local parent = cleanupStack[#cleanupStack]
            e(("if %s==\"return\" then "):format(tag))
            if parent then
                e(("return \"return\",%s"):format(payload))
            else
                e(("return %s(%s,1,%s.n)"):format(cleanupGlobals.unpack, payload, payload))
            end
            e(" end;")
            if ctx.breakExit then
                e(("if %s==\"break\" then "):format(tag))
                if parent and ctx.entryLoopDepth <= parent.entryLoopDepth then
                    parent.breakExit = true
                    e("return \"break\"")
                else
                    e("break")
                end
                e(" end;")
            end
            if ctx.continueExit then
                e(("if %s==\"continue\" then "):format(tag))
                if parent and ctx.entryLoopDepth <= parent.entryLoopDepth then
                    parent.continueExit = true
                    e("return \"continue\"")
                else
                    e("continue")
                end
                e(" end;")
            end
            local gotoTargets = {}
            for target in pairs(ctx.gotos) do
                gotoTargets[#gotoTargets + 1] = target
            end
            table.sort(gotoTargets)
            for _, target in ipairs(gotoTargets) do
                e(("if %s==%q then "):format(tag, "goto:" .. target))
                if parent and not parent.labels[target] then
                    parent.gotos[target] = true
                    e(("return %q"):format("goto:" .. target))
                else
                    e("goto " .. target)
                end
                e(" end;")
            end
            e("end")

        elseif kind == "returnStmt" and x.indexedViewReturnTransport then
            local producer = x.indexedViewReturnTransport.producer
            local root = producer.producer
            local producerKind = root and root.kind
            e("return ", sourceLine(x))
            emit(producer.source)
            e(",0,")
            if producerKind == "string" then
                e("#")
                emit(producer.source)
            elseif producerKind == "fixed-carray" then
                emit(producer.count)
            elseif producerKind == "heap" or producerKind == "soa" then
                emit(producer.source)
                e(".count")
            else
                e(compilerModuleName("nupp.mem.indexed") .. "._rootCount(")
                emit(producer.count)
                local message = root.descriptor
                    and root.descriptor.writable
                    and "write span count cannot be negative"
                    or "span count cannot be negative"
                e((",%q)"):format(message))
            end

        elseif kind == "returnStmt" and activeWith() then
            emitPackedReturn(activeWith(), x)

        elseif (
            kind == "breakStmt" or kind == "continueStmt"
        ) and activeWith() and emitDepth.loop <= activeWith().entryLoopDepth then
            local completion = kind == "breakStmt" and "break" or "continue"
            activeWith()[completion .. "Exit"] = true
            e(("return %q"):format(completion), sourceLine(x))

        elseif kind == "gotoStmt" and activeWith() and not activeWith().labels[x.name.text] then
            local ctx = activeWith()
            ctx.gotos[x.name.text] = true
            e(("return %q"):format("goto:" .. x.name.text), sourceLine(x))

        elseif kind == "forinStmt" and x.numericIpairs then
            local operand = x.numericIpairs.operand
            local names = x.names or {}
            -- The first generic-for binding already is the numeric index. Use it as the
            -- control variable instead of introducing a temporary and copying it into
            -- the source binding on every iteration.
            local index = names[1] and names[1].text or nextTemp()
            local first = x[1]
            local line = first and cst.isToken(first) and first.line or sourceLine(x)
            e(("for %s=1,%d do"):format(index, x.numericIpairs.length), line)
            if names[2] then
                e(("local %s="):format(names[2].text))
                emit(operand)
                e(("[%s];"):format(index))
            end
            for j = 3, #names do
                e(("local %s=nil;"):format(names[j].text))
            end
            emitDepth.loop = emitDepth.loop + 1
            if x.body then
                emit(x.body)
            end
            emitDepth.loop = emitDepth.loop - 1
            local endTok
            for j = #x, 1, -1 do
                local child = x[j]
                if cst.isToken(child) and child.kind == "end" then
                    endTok = child
                    break
                end
            end
            e("end", endTok and endTok.line or nil)
            finishConcatBuffer(x, endTok and endTok.line or nil)

        elseif kind == "whileStmt" or kind == "fornumStmt" or kind == "forinStmt" or kind == "repeatStmt" then
            local lastLine = nil
            for _, child in ipairs(x) do
                if child == x.body then
                    emitDepth.loop = emitDepth.loop + 1
                    emit(child)
                    emitDepth.loop = emitDepth.loop - 1
                else
                    emit(child)
                end
                if cst.isToken(child) then
                    lastLine = child.line
                end
            end
            -- On the line the loop closes on. That line already belongs to this
            -- statement, so nothing moves and the line count is unchanged.
            finishConcatBuffer(x, lastLine)

        elseif kind == "funcbody" then
            emitDepth.fn = emitDepth.fn + 1
            if x.varargParam then
                for _, child in ipairs(x) do
                    if child == x.body then
                        if coverageOn then
                            coverageHit("function", x)
                        end
                        e(("const %s = { n = select(\"#\", ...), ... }"):format(x.varargParam.name.text))
                    end
                    emit(child)
                end
            else
                for _, child in ipairs(x) do
                    if child == x.body then
                        if coverageOn then
                            coverageHit("function", x)
                        end
                    end
                    emit(child)
                end
            end
            emitDepth.fn = emitDepth.fn - 1

        elseif kind == "localFuncStmt" then
            if x.comptimeFunction or x.comptimeTok then
                return
            end
            local dispatch = pluck.hotDispatch
            local planned = dispatch and dispatch.byNode[x] or nil
            if dispatch and planned then
                dispatch.emit(planned)
            else
                emitChildren(x)
            end
            for _, registration in ipairs(x.name and x.name.cleanupRegistrations or {}) do
                local cleanup = registration.cleanup
                e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
            end

        elseif kind == "funcStmt" then
            if x.comptimeFunction or x.comptimeTok then
                return
            end
            local dispatch = pluck.hotDispatch
            local planned = dispatch and dispatch.byNode[x] or nil
            if dispatch and planned then
                dispatch.emit(planned)
            else
                emitChildren(x)
            end
            -- A qualified declaration's definition token is its final member, while
            -- `funcname.base` is the root table. Inspect every written name token so
            -- `function module.close()` can publish a terminal just like a local
            -- function declaration can.
            for _, name in ipairs(x.name or {}) do
                for _, registration in ipairs(name.cleanupRegistrations or {}) do
                    local cleanup = registration.cleanup
                    e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
                end
            end

        elseif kind == "pragmaStmt" then
            for _, registration in ipairs(x.cleanupRegistrations or {}) do
                if not registration.after then
                    local cleanup = registration.cleanup
                    e(("%s[%q]=%s;"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
                end
            end
            if x.stat then
                emit(x.stat)
            end
            for _, registration in ipairs(x.cleanupRegistrations or {}) do
                if registration.after then
                    local cleanup = registration.cleanup
                    e((";%s[%q]=%s"):format(cleanupRegistry(), cleanup.key, cleanup.name), sourceLine(x))
                end
            end

        elseif kind == "noSuspendStmt" then
            -- Erases to an ordinary block. The region is a promise the checker held the
            -- program to; there is nothing left to enforce once it has.
            e("do", x.keywordTok and x.keywordTok.line or nil)
            if x.body then
                emit(x.body)
            end
            e("end", x.endTok and x.endTok.line or nil)

        elseif kind == "effectRegionStmt" then
            -- Like `nosuspend`, checked effect regions erase to an ordinary block.
            e("do", x.keywordTok and x.keywordTok.line or nil)
            if x.body then
                emit(x.body)
            end
            e("end", x.endTok and x.endTok.line or nil)

        elseif kind == "unsafeStmt" then
            e("do", x.unsafeTok and x.unsafeTok.line or nil)
            if x.body then
                emit(x.body)
            end
            e("end", x.endTok and x.endTok.line or nil)

        elseif kind == "tableExpr" and x.presizeFields and not coverageOn then
            -- OPT-1: a consecutive run of named writes can be the constructor itself.
            -- Each value stays on the assignment's source line for stack traces; the
            -- assignment nodes below emit nothing on an ordinary build.
            e("{", sourceLine(x))
            for _, field in ipairs(x.presizeFields) do
                e(field.name.text .. "=", sourceLine(field.stat))
                emit(field.value)
                e(",")
            end
            e("}")

        elseif kind == "tableExpr" and x.presize then
            -- OPT-1: `{}` sized for the fields the optimizer counted. The call replaces
            -- the constructor where it stands, so the line it is attributed to does not
            -- move. Coverage builds retain this form so the following writes remain
            -- independently instrumentable statements.
            local name = tableIntrinsicName("new")
            e(("%s(%d,%d)"):format(name, x.presize.narr, x.presize.nhash), sourceLine(x))

        elseif kind == "param" then
            -- name (or '...'); annotation tokens skip via the token rule
            if x.indexedViewParameterTransport then
                local view = x.indexedViewParameterTransport
                view.anchorName = view.anchorName or nextTemp()
                view.offsetName = view.offsetName or nextTemp()
                view.countName = view.countName or nextTemp()
                e(("%s,%s,%s"):format(view.anchorName, view.offsetName, view.countName), sourceLine(x))
            elseif x.vararg then
                e("...", sourceLine(x))
            elseif x.name then
                emit(x.name)
            else
                emitChildren(x)
            end

        elseif kind == "call" and x.soaLayout and x.soaOperation then
            local moduleName = compilerModuleName("nupp.mem.soa")
            local args = x.args and x.args.exprs or {}
            local line = sourceLine(x)
            if x.soaOperation == "allocate" then
                local elementName, countName = nextTemp(), nextTemp()
                e(
                    (
                        "(function(%s,%s)return %s._allocate(%s,%s,"
                    ):format(elementName, countName, moduleName, elementName, countName),
                    line
                )
                emitRuntimeLayout(x.soaLayout, line, function()
                    e(elementName)
                end)
                e(")end)(")
                if args[1] then
                    emit(args[1])
                else
                    e("nil")
                end
                e(",")
                if args[2] then
                    emit(args[2])
                else
                    e("nil")
                end
                e(")")
            else
                e(moduleName .. "._layout(", line)
                emitRuntimeLayout(x.soaLayout, line, function()
                    if args[1] then
                        emit(args[1])
                    else
                        e("nil")
                    end
                end)
                e(")")
            end
            return

        elseif kind == "call" and x.virtualIndexedView and x.virtualIndexedView.kind == "root" then
            local view = x.virtualIndexedView
            if view.transport then
                if not view.transportEmission then
                    error("transported indexed view was emitted outside its binding")
                end
                emitChildren(x)
                return
            end
            local producerKind = view.producer and view.producer.kind
            local moduleName = compilerModuleName("nupp.mem.indexed")
            if producerKind == "string" then
                e("#" .. view.anchorName, sourceLine(x))
            elseif producerKind == "fixed-carray" then
                emit(view.count)
            else
                e(moduleName .. "._rootCount(", sourceLine(x))
                emit(view.count)
                local message = view.descriptor
                    and view.descriptor.writable
                    and "write span count cannot be negative"
                    or "span count cannot be negative"
                e((",%q)"):format(message))
            end
            return

        elseif kind == "methodCall" and x.soaFieldProjection and not x.virtualIndexedView then
            emit(x.obj)
            e((":fieldBySlot(%d)"):format(x.soaFieldProjection.ordinal), sourceLine(x))
            return

        elseif kind == "methodCall" and x.virtualIndexedView then
            local view = x.virtualIndexedView
            if view.kind == "root" then
                e(view.anchorName .. ".count", sourceLine(x))
            elseif view.kind == "slice" then
                local moduleName = compilerModuleName("nupp.mem.indexed")
                e(moduleName .. "._sliceFinish(", sourceLine(x))
                emitDepth.view.count(view.source)
                e(",")
                e(view.firstName)
                e(",")
                if view.last then
                    emit(view.last)
                else
                    e("nil")
                end
                local adapter = view.descriptor and view.descriptor.adapter or "span"
                local writable = view.descriptor and view.descriptor.writable
                local message = adapter == "soa"
                    and "SoA slice out of bounds"
                    or writable
                    and "write span slice out of bounds"
                    or "span slice out of bounds"
                e((",%q)"):format(message))
            else
                emitDepth.view.count(view.source)
            end
            return

        elseif kind == "dotIndex" and x.soaField then
            local row = x.obj
            local view = row and row.obj
            if view and row.expr then
                if emitDepth.view.info(view) then
                    emitDepth.view.soaSlot(view, x.soaField.ordinal, row.expr, not emitDepth.soa.unchecked(row))
                elseif view.kind == "name" then
                    -- Keep the common loop form as a plain column load. A name is
                    -- stable to evaluate twice. A canonical count-bounded loop uses
                    -- its already-proved physical index; other expressions retain the
                    -- checked access. Complex receivers use the wrapper below to
                    -- preserve source evaluation order.
                    emit(view)
                    e((".columns[%d]["):format(x.soaField.ordinal), sourceLine(x))
                    if emitDepth.soa.unchecked(row) then
                        emit(view)
                        e(".offset+")
                        emit(row.expr)
                        e("-1]")
                    else
                        emit(view)
                        e(":checkedIndex(")
                        emit(row.expr)
                        e(")]")
                    end
                else
                    local viewName, indexName = nextTemp(), nextTemp()
                    e(
                        (
                            "(function(%s,%s)return %s.columns[%d][%s:checkedIndex(%s)] end)("
                        ):format(viewName, indexName, viewName, x.soaField.ordinal, viewName, indexName),
                        sourceLine(x)
                    )
                    emit(view)
                    e(",")
                    emit(row.expr)
                    e(")")
                end
            else
                emitChildren(x)
            end
            return

        elseif kind == "bracketIndex" and x.soaRow then
            local view = emitDepth.view.info(x.obj)
            local element = x.soaRow.element
            if view and x.indexedDirectAccess and element and element.tag == "nominal" then
                emitDepth.view.root(x.obj)
                e(".element({", sourceLine(x))
                for ordinal, field in ipairs(element.fieldOrder or {}) do
                    if ordinal > 1 then
                        e(",")
                    end
                    e(field .. "=")
                    emitDepth.view.soaSlot(x.obj, ordinal, x.expr)
                end
                e("})")
            else
                emit(x.obj)
                e(":get(", sourceLine(x))
                emit(x.expr)
                e(")")
            end
            return

        elseif kind == "assignStmt" and #(
            x.targets or {}
        ) == 1 and x.targets[1] and x.targets[1].soaField and #(x.exprs or {}) == 1 then
            local target = x.targets[1]
            local row = target.obj
            local view = row and row.obj
            if view and row.expr then
                local viewName, indexName = nextTemp(), nextTemp()
                e(("do const %s="):format(viewName), sourceLine(x))
                emit(view)
                e(("; const %s="):format(indexName))
                emit(row.expr)
                e(
                    (
                        "; %s="
                    ):format(
                        emitDepth.soa.slot(viewName, target.soaField.ordinal, indexName, emitDepth.soa.unchecked(row))
                    )
                )
                emit(x.exprs[1])
                e(" end")
            else
                emitChildren(x)
            end
            return

        elseif kind == "assignStmt" and #(
            x.targets or {}
        ) == 1 and x.targets[1] and x.targets[1].soaRow and #(x.exprs or {}) == 1 then
            local target = x.targets[1]
            emit(target.obj)
            e(":set(", sourceLine(x))
            emit(target.expr)
            e(",")
            emit(x.exprs[1])
            e(")")
            return

        elseif kind == "call" and x.layoutOf then
            -- The compiler knows the name and the field spellings; sizes, offsets and
            -- padding are this platform's, so the helper asks the FFI at run time and
            -- caches per ctype. Emitted at the call site, so a program that never asks
            -- carries nothing.
            local line = sourceLine(x)
            emitRuntimeLayout(x.layoutOf, line, function()
                emit(x.args and x.args.exprs and x.args.exprs[1] or x.obj)
            end)
            return

        elseif kind == "dotIndex" and x.compilerModule then
            -- The module the checker projected through a builtin namespace. OPT-5
            -- shares this binding when the module is string.buffer.
            e(compilerModuleName(x.compilerModule), sourceLine(x))

        elseif kind == "localStmt" and #(
            x.names or {}
        ) == 1 and #(
            x.exprs or {}
        ) == 1 and x.names[
            1
        ].definition and x.names[
            1
        ].definition.virtualIndexedView and x.names[1].definition.virtualIndexedView.kind == "alias" then
            local view = x.names[1].definition.virtualIndexedView
            e((x.isConst and "const " or "local ") .. x.names[1].text .. "=", sourceLine(x))
            emitDepth.view.count(view.source)

        elseif kind == "localStmt" and #(
            x.names or {}
        ) == 1 and #(
            x.exprs or {}
        ) == 1 and x.exprs[1].virtualIndexedView and x.exprs[1].virtualIndexedView.kind == "root" then
            local view = x.exprs[1].virtualIndexedView
            view.anchorName = view.anchorName or nextTemp()
            if view.transport then
                view.offsetName = view.offsetName or nextTemp()
                e(("const %s,%s,%s="):format(view.anchorName, view.offsetName, x.names[1].text), sourceLine(x))
                view.transportEmission = true
                emit(x.exprs[1])
                view.transportEmission = nil
            else
                e("const " .. view.anchorName .. "=", sourceLine(x))
                emit(view.source)
                e(";")
                emitChildren(x)
            end

        elseif kind == "localStmt" and #(
            x.names or {}
        ) == 1 and #(
            x.exprs or {}
        ) == 1 and x.exprs[1].virtualIndexedView and x.exprs[1].virtualIndexedView.kind == "slice" then
            local view = x.exprs[1].virtualIndexedView
            view.firstName = view.firstName or nextTemp()
            e("const " .. view.firstName .. "=", sourceLine(x))
            emit(view.first)
            e(";")
            emitChildren(x)

        elseif kind == "localStmt" and x.concatBuffer then
            -- The accumulator keeps its declaration, so anything reading it after the
            -- loop reads a string and needs no rewriting. The buffer is opened beside
            -- it, on the same line.
            emitChildren(x)
            e(("local %s = %s.new()"):format(x.concatBuffer.name, concatBufferName()), sourceLine(x))

        elseif kind == "assignStmt" and x.concatBuffer then
            -- `s = s .. a .. b` becomes `buf:put(a, b)`. Lua's `..` is
            -- right-associative, so the pieces arrive already in the order they are
            -- concatenated, and appending them one after another builds the same
            -- string. Only reached for a concatenation the checker proved primitive: a
            -- `__concat` would not be run by `put`.
            e(("%s:put("):format(x.concatBuffer.name), sourceLine(x))
            for j, piece in ipairs(x.concatBuffer.pieces) do
                if j > 1 then
                    e(",")
                end
                emit(piece)
            end
            e(")")

        else
            emitChildren(x)
        end
    end

    planStructTags()
    if hotState and hotState.mode == "patch" then
        local captured = {}
        for _, planned in ipairs(hotState.functions) do
            if hotSelected(planned) then
                for _, name in ipairs(planned.captures) do
                    captured[name] = true
                end
            end
        end
        local captures = {}
        for name in pairs(captured) do
            captures[#captures + 1] = name
        end
        table.sort(captures)
        if #captures > 0 then
            e("local " .. table.concat(captures, ",") .. ";", 1)
        end
        for _, planned in ipairs(hotState.functions) do
            if hotSelected(planned) then
                hotEmitFunction(planned)
            end
        end
    else
        for _, child in ipairs(result.root) do
            emit(child)
        end
    end
    raw("\n")

    local code = table.concat(out)
    -- Declared first here so they end up last in the prologue: every block below
    -- prepends
    -- ahead of this one, which leaves these sitting directly on top of the module body
    -- with the whole prologue already in scope. A helper that calls a cleanup resolver
    -- needs exactly that -- resolvers are `local`, so a declaration written above them
    -- reads the name as a global and finds nil. They still share the prologue's one
    -- line,
    -- so no source line moves.
    if #pluck.helpers.order > 0 then
        local declarations = {}
        for _, helper in ipairs(pluck.helpers.order) do
            declarations[
                #declarations + 1
            ] = ("const %s = function(%s) %s end;"):format(helper.name, helper.params, helper.body)
        end
        code = table.concat(declarations) .. code
    end
    if #constants.order > 0 or #constants.spilled > 0 then
        local declarations = {}
        for _, constant in ipairs(constants.order) do
            declarations[#declarations + 1] = ("const %s=%s;"):format(constant.name, constant.body)
        end
        if #constants.spilled > 0 then
            declarations[#declarations + 1] = ("const %s={};"):format(constants.spillName)
            for index, body in ipairs(constants.spilled) do
                declarations[#declarations + 1] = ("%s[%d]=%s;"):format(constants.spillName, index, body)
            end
        end
        code = table.concat(declarations) .. code
    end
    if needsCleanupRegistry then
        local linked = {
            ("local %s=_G.__nuppCleanupRegistry;"):format(cleanupRegistryName),
            (
                "if %s==nil then %s={};_G.__nuppCleanupRegistry=%s end;"
            ):format(cleanupRegistryName, cleanupRegistryName, cleanupRegistryName),
        }
        for _, resolver in ipairs(cleanupResolverOrder) do
            local cleanup = resolver.cleanup
            assert(
                cleanup.key,
                "unresolved affine terminal reached lowering in " .. (
                    filename or "<source>"
                ) .. ": " .. cleanup.id .. " (" .. cleanup.name .. ")"
            )
            linked[
                #linked + 1
            ] = (
                "local %s;%s=function(value) local cleanup=%s[%q];"
            ):format(
                resolver.name,
                resolver.name,
                cleanupRegistryName,
                cleanup.key
            ) .. (
                "if cleanup==nil then return _G.error(%q) end;"
            ):format(
                "Nupp cleanup provider is not loaded: " .. cleanup.key
            ) .. ("%s=cleanup;return cleanup(value) end;"):format(resolver.name)
        end
        code = table.concat(linked) .. code
    end
    -- `nupp` is an ambient namespace, not a module the application must require. A
    -- feature only adds its bootstrap in modules that resolved it.
    local runtimeEffects = emittedFeatureEffects
    -- Bound here rather than with the required modules below, because those are
    -- independent of the bootstrap and this one is not: it reads the table the
    -- installer publishes, so it has to land after it rather than before.
    if compilerModules["nupp.log"] then
        code = (
            "const %s = _G.nupp.log.forModule(%q); "
        ):format(compilerModules["nupp.log"], result.moduleName or filename or "?") .. code
    end
    local nativeBootstrap = stdlib.bootstrap(runtimeEffects, hotState ~= nil)
    if nativeBootstrap ~= "" then
        code = nativeBootstrap .. code
    else
        code = "_G.nupp=_G.nupp or {};" .. code
    end
    if needsCleanupRegions then
        local names, values = {}, {}
        for _, name in ipairs({"pcall", "xpcall", "error", "unpack", "select", "setmetatable", "tostring", "ipairs"}) do
            names[#names + 1] = cleanupGlobals[name]
            values[#values + 1] = name
        end
        code = (
            "const %s={}; "
        ):format(
            cleanupCacheName
        ) .. (
            "const %s=%s; "
        ):format(
            table.concat(names, ","),
            table.concat(values, ",")
        ) .. (
            "const function %s(...) return "
        ):format(
            cleanupPackName
        ) .. (
            "{n=%s(\"#\",...),...} end; "
        ):format(
            cleanupGlobals.select
        ) .. (
            "const function %s(value) return value end; "
        ):format(
            cleanupIdName
        ) .. (
            "const function %s(primary,errors,start) "
        ):format(
            cleanupFailureName
        ) .. "const secondary={} for i=start,#errors do " .. (
            "secondary[#secondary+1]=errors[i] end return %s("
        ):format(
            cleanupGlobals.setmetatable
        ) .. "{primary=primary,suppressed=secondary},{__tostring=function(v) " .. (
            "local text=%s(v.primary) for _,reason in %s("
        ):format(
            cleanupGlobals.tostring,
            cleanupGlobals.ipairs
        ) .. (
            "v.suppressed) do text=text..\"\\ncleanup: \"..%s(reason) "
        ):format(cleanupGlobals.tostring) .. "end return text end}) end; " .. code
    end
    -- A project global is created by the module that declares it, so naming one means
    -- that module has to have been loaded. Nothing is bound: the declaration assigned
    -- the global itself.
    if result.implicitSideEffects and next(result.implicitSideEffects) then
        local effects = {}
        for moduleName in pairs(result.implicitSideEffects) do
            effects[#effects + 1] = moduleName
        end
        table.sort(effects)
        for j, moduleName in ipairs(effects) do
            effects[j] = ("require(%q); "):format(moduleName)
        end
        code = table.concat(effects) .. code
    end
    if needsArrayCache then
        code = "const __nuppArrayCache = {}; const function __nuppArray(ct) "
            .. "local a = __nuppArrayCache[ct] if not a then "
            .. 'a = __nuppFfi.typeof("$[?]", ct) __nuppArrayCache[ct] = a end '
            .. "return a end; "
            .. code
    end
    if needsCArrayIndex then
        code = (
            "local function %s(i,n) if i%%1~=0 or i<0 or i>=n then "
        ):format(carrayIndexName) .. "error('C array index out of bounds',2) end return i end; " .. code
    end
    if needsLibs then
        -- A name beginning with `@` is a path to a library shipped with the
        -- code, resolved against the chunk this is compiled into rather than
        -- against the working directory. That is what makes such a library
        -- relocatable: whatever path the loader used to open this module is a
        -- path that works from wherever the program was started, so a sibling
        -- of it does too. A build-time absolute path would pin the output to
        -- one machine, and a build-time relative one to one directory.
        --
        -- Resolution walks up from the chunk, because the same module is loaded
        -- at whatever depth its name puts it and inlined at the root by a
        -- bundle, and the library sits in one place either way. The walk is
        -- bounded: a miss is a load error naming what was looked for, not a
        -- climb to the filesystem root.
        --
        -- Anything without the `@` is a library name for the platform loader to
        -- find, which is what an ordinary `cdef ... from` means and is left
        -- exactly as it was.
        code = "const __nuppLibCache = {}; "
            .. "const __nuppLibRoots = rawget(_G, '__nuppLibraryRoots') or {}; "
            .. "rawset(_G, '__nuppLibraryRoots', __nuppLibRoots); "
            .. "const function __nuppLib(n) "
            .. "local l = __nuppLibCache[n] if not l then "
            .. "local rel = n:match('^@(.+)$') "
            .. "if rel then "
            .. "local here = debug.getinfo(1, 'S').source:match('^@(.*)$') "
            .. "local dir = here and here:match('^(.*)[/\\\\]') or '.' "
            .. "local from = dir "
            .. "for _ = 0, 8 do "
            .. "local at = dir .. '/' .. rel "
            .. "local probe = io.open(at, 'rb') "
            .. "if probe then probe:close() l = __nuppFfi.load(at) break end "
            .. "dir = dir .. '/..' "
            .. "end "
            .. "if not l then error('cannot find ' .. rel .. ' at or above ' .. from"
            .. " .. '; the compiled library has to travel with the module that calls it', 0) end "
            .. "else l = __nuppFfi.load(n) end "
            .. "__nuppLibCache[n] = l __nuppLibRoots[l] = true end return l end; "
            .. code
    end
    if needsCloneTab then
        -- `next` rather than `pairs`, and a metatable carried across by hand, because a
        -- clone has to reproduce what the table itself holds: an `__index` that answers
        -- for absent keys belongs to the copy the same way it belonged to the original,
        -- not flattened into it. A `__metatable` field makes `getmetatable` answer with
        -- a stand-in rather than a table, and that is left where it is.
        code = (
            "const function %s(t) const out = {} "
        ):format(
            cloneTabName
        )
            .. "for k, v in next, t do out[k] = v end "
            .. "const mt = getmetatable(t) "
            .. "if type(mt) == \"table\" then setmetatable(out, mt) end "
            .. "return out end; "
            .. code
    end
    if needsClearTab then
        code = ("const %s = require(\"table.clear\"); "):format(clearTabName) .. code
    end
    if needsNewTab then
        code = ("const %s = require(\"table.new\"); "):format(newTabName) .. code
    end
    if needsMetatypeOnce then
        -- `ffi.metatype` claims a ctype once per process. A named struct's tag encodes
        -- its body, so a second claim means the same declaration reached this process
        -- twice and the ctype already carries the right metatable.
        code = (
            "const %s = function(ct, mt) const ok, got = pcall("
        ):format(metatypeOnceName) .. "__nuppFfi.metatype, ct, mt) if ok then return got end return ct end; " .. code
        needsFfi = true
    end
    if #structTagOrder > 0 then
        -- Tags first, so a struct body and an anonymous ctype alike may point at one
        -- whose body has not been emitted yet. `ffi.typeof` will not declare a tag
        -- implicitly the way `ffi.cdef` does, so the declaration has to be explicit.
        local forwards = {}
        for _, tag in ipairs(structTagOrder) do
            forwards[#forwards + 1] = ("pcall(__nuppFfi.cdef, \"struct %s;\"); "):format(tag)
        end
        code = table.concat(forwards) .. code
        needsFfi = true
    end
    if needsLayout then
        -- One layout per ctype, built on first ask. Weak keys so a ctype nothing else
        -- holds is still collectable. `$` in the spec consumes the next ctype argument,
        -- the way ffi.typeof spells a nested struct, because nupp emits anonymous
        -- structs and a nested field's size cannot be resolved from a name.
        code = (
            "const %s = (function() const cache = setmetatable({}, {__mode = \"k\"}) "
            .. "return function(ct, name, spec, printed, ...) "
            .. "local hit = cache[ct] if hit then return hit end "
            .. "const nested = {...} local at = 0 "
            .. "const fields = {} "
            .. "for fname, ctype in spec:gmatch(\"([^:,]+):([^,]+)\") do "
            .. "local own local fieldType local shown = ctype "
            .. "if ctype:sub(1, 1) == \"$\" then at = at + 1 own = nested[at] "
            .. "shown = ctype:sub(2) "
            .. "const repeats = shown:match(\"%%[(%%d+)%%]$\") "
            .. "if repeats then fieldType = __nuppFfi.typeof(\"$ [\" .. repeats .. \"]\", own) "
            .. "else fieldType = __nuppFfi.typeof(own) end "
            .. "elseif ctype:sub(-1) == \"*\" then own = \"void *\" "
            .. "else own = ctype end "
            .. "if not fieldType then fieldType = __nuppFfi.typeof(own) end "
            .. "fields[#fields + 1] = {name = fname, ctype = shown, "
            .. "offset = __nuppFfi.offsetof(ct, fname), size = __nuppFfi.sizeof(fieldType), "
            .. "alignment = __nuppFfi.alignof(fieldType), pointerType = __nuppFfi.typeof(\"$ *\", fieldType)} "
            .. "end "
            .. "const size = __nuppFfi.sizeof(ct) "
            .. "for i = 1, #fields do "
            .. "const after = fields[i + 1] and fields[i + 1].offset or size "
            .. "fields[i].padding = after - fields[i].offset - fields[i].size end "
            .. "const layout = {name = name, size = size, alignment = __nuppFfi.alignof(ct), fields = fields, "
            .. "fingerprint = printed .. \"|\" .. size} "
            .. "cache[ct] = layout return layout end end)(); "
        ):format(layoutName) .. code
        needsFfi = true
    end
    if needsSuspension then
        code = ("const %s = require(\"nupp.suspension\"); "):format(suspensionName) .. code
    end
    for _, moduleName in ipairs(compilerModuleOrder) do
        -- The logging view is not a module to require, and it is bound above, beside
        -- the bootstrap it depends on.
        if moduleName ~= "nupp.log" then
            code = ("const %s = require(%q); "):format(compilerModules[moduleName], moduleName) .. code
        end
    end
    if needsFfi then
        -- joins line 1 without adding a line (the invariant holds)
        code = 'const __nuppFfi = require("ffi"); ' .. code
    end
    if coverageOn and coverageName then
        -- The recorder is self-contained so an instrumented application does not need
        -- the compiler installed at runtime. Its plain table is intentionally public: a
        -- custom runner may flush it just as this repository's runner does.
        code = (
            "local %s=_G.__nuppCoverage;if not %s then %s={hits={}};"
            .. "function %s.hit(p,i)local f=%s.hits[p]or{};%s.hits[p]=f;"
            .. "local k=tostring(i);f[k]=(f[k]or 0)+1 end;function %s.branch(p,i,v)local f=%s.hits[p]"
            .. "or{};%s.hits[p]=f;local k=tostring(i)..(v and ':true'or ':false');"
            .. "f[k]=(f[k]or 0)+1;return v end;_G.__nuppCoverage=%s end; "
        ):format(
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName,
            coverageName
        ) .. code
    end
    if hotState then
        local policies = {}
        for policy in pairs(hotState.policies) do
            policies[#policies + 1] = policy
        end
        table.sort(policies)
        for j, policy in ipairs(policies) do
            policies[j] = ("_G.__nuppHotReload.policy(%s,%q); "):format(hotState.slotsExpr, policy)
        end
        code = (
            "local %s=_G.__nuppHotReload.module(%q); "
        ):format(hotState.slotsExpr, hotState.module) .. table.concat(policies) .. code
    end
    local metadata = coverageOn and {path = coveragePath, sites = (coverageSites or {}) as {any}} or nil
    local hotMetadata = nil
    if hotState then
        local functions = {}
        for _, planned in ipairs(hotState.functions) do
            functions[
                #functions + 1
            ] = {
                slot = planned.slot,
                id = planned.id,
                name = planned.name,
                signature = planned.signature,
                selfName = planned.selfName,
                captures = planned.captures,
                implementation = planned.implementation,
                patchable = planned.patchable,
                affineCapture = planned.affineCapture,
                cUses = planned.cUses,
                cUnknown = planned.cUnknown,
            }
        end
        hotMetadata = {
            module = hotState.module,
            mode = hotState.mode,
            baseGeneration = hotState.baseGeneration,
            functions = functions,
            structure = table.concat(hotState.structure, "\1"),
        }
    end

    -- Prelude implementation bodies are ordinary checked and generated Nupp. Execute
    -- their generated chunk before this module on one physical line so authored source
    -- line numbers remain aligned with the module body.
    if result.preludeRuntime and result.preludeRuntime ~= "" then
        -- Lua's `%q` spells a newline as a backslash followed by a physical newline.
        -- That is loadable, but it adds one generated line per prelude line and shifts
        -- every source position. Turn those continuations into `\n` escapes so the
        -- ordinary prelude implementation remains on the generated preamble line.
        local quotedPrelude = ("%q"):format(result.preludeRuntime):gsub("\n", "n")
        code = ("_G.assert(_G.loadstring(%s,%q))();"):format(quotedPrelude, "@nupp-prelude") .. code
    end

    -- Generated Lua that will not load is a bug in this file, and it should say so here
    -- rather than wherever the module is first required.
    --
    -- LuaJIT caps a function at 60 upvalues and refuses to parse one that exceeds it,
    -- so
    -- the count cannot be read back -- the refusal is the only signal there is. Which
    -- makes this the general check rather than a count: parse what was just written,
    -- and
    -- report anything that will not parse. The upvalue cap is one way to trip it and
    -- any
    -- other malformed emission is another, and both used to surface as a load error
    -- from
    -- a generated line, in whichever command happened to require the module first. A
    -- coverage build found the last one, because it instruments the largest function in
    -- the compiler and tips it over.
    --
    -- Line numbers survive generation one to one, so the line LuaJIT names is the line
    -- that was written.
    if loadstring then
        local chunk, reason = loadstring(code, "@" .. tostring(filename or "generated"))
        if not chunk then
            local text = tostring(reason)
            -- The upvalue refusal names the function's own line; a syntax error names
            -- where it gave up. Prefer the former, which is the thing to change.
            local line = tonumber(text:match("function at line (%d+)")) or tonumber(text:match("^[^:]*:(%d+):")) or 0
            -- Two different failures reach here and they are not the same news.
            -- Capturing
            -- past the cap is this file's own doing and has a way out; anything else is
            -- this compiler emitting Lua it should not have.
            local cap = text:match("more than (%d+) upvalues")
            local message, help
            if cap then
                message = (
                    "this function captures more than %s names from around it, "
                    .. "which is more than a Lua function can hold"
                ):format(cap)
                help = "pass some of them as arguments, or gather what it reads into one " .. "value and capture that"
            else
                message = "generated code does not load: " .. (text:gsub("^[^:]*:%d+:%s*", ""))
                help = "this is a bug in the compiler rather than in this file; `nupp bc " .. tostring(
                    filename or ""
                ) .. "` shows what it generated"
            end
            diag({line = line, col = 1, offset = 0, text = ""}, "NUPP3005", message, help)
        end
    end

    return code, diags, metadata, emittedFeatureEffects, hotMetadata
end

return gen
