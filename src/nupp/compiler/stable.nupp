module nupp.compiler.stable

-- Canonical compiler memoization text, independent of persistent build storage.

local function stable(value: unknown, seen: {[unknown]: boolean}?): string
    local kind = type(value)
    @allow("exhaustiveness")
    if kind == "nil" then
        return "nil"
    end
    if kind == "boolean" or kind == "number" then
        return tostring(value)
    end
    @allow("exhaustiveness")
    if kind == "string" then
        return ("%q"):format(value)
    end
    @allow("exhaustiveness")
    if kind ~= "table" then
        return "<" .. kind .. ">"
    end
    local entries = value as {[unknown]: unknown}
    seen = seen or {}
    if seen[value] then
        return "<cycle>"
    end
    seen[value] = true
    local parts = {}
    for key in pairs(entries) do
        parts[#parts + 1] = stable(key, seen) .. "=" .. stable(entries[key], seen)
    end
    table.sort(parts)
    seen[value] = nil

    return "{" .. table.concat(parts, ",") .. "}"
end

export = stable
