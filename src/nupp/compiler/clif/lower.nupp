module nupp.compiler.clif.lower

--[[
Lowers ordinary typed Nupp to Cranelift's textual IR (CLIF): the scalar types,
mutable locals, branches, loops, direct calls, struct fields through raw
pointers at the compiler's own layout offsets, and the memory intrinsics, with
nothing managed underneath. The ordinary parser and checker validate the
source. Admitted integer handlers pass through the existing Nupp graph and its
mechanical CLIF emitter. The temporary direct path uses `nupp.compiler.clif.ssa`
for functions whose graph operations are not yet implemented. The runtime's
glue parses and compiles the text.

A set of modules compiles to one CLIF file. A module's `export function`s
are what the others call, through a `const` require of it; a require of the
intrinsics declaration is the only other module-level statement.

Handler mode compiles the native interpreter core. A handler takes six pointer
registers and answers a word; its sixth register is the dispatch table and its
frame is derived from the boxed window. Helpers are inlined where a handler
tail-calls them, or where a statement calls one answering nothing, so every
handler stays one frameless function. A helper named `...Slow` is a support
function: compiled on its own and tail-called with the pc, the context, up to
five words of its own and the table, so the fast path stays frameless while the
slow path calls the Rust helpers.
]]

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local fs = require("nupp.compiler.fs")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local targetLayout = require("nupp.compiler.targetlayout")
local nativelayout = require("nupp.compiler.vm.nativelayout")
local ssa = require("nupp.compiler.clif.ssa")
local json = require("nupp.codec.json")
local helpercontract = require("nupp.compiler.vm.helpercontract")
local slotcontract = require("nupp.compiler.vm.slotcontract")
local framecontract = require("nupp.compiler.vm.framecontract")
local programcontract = require("nupp.compiler.vm.programcontract")
local specializationcontract = require("nupp.compiler.vm.specializationcontract")
local graph = require("nupp.compiler.vm.graph")
local nativegraph = require("nupp.compiler.vm.nativegraph")
local clifgraph = require("nupp.compiler.clif.graph")

local lower = {}

--- The intrinsics declaration the runtime sources are written against.
lower.INTRINSICS = "nupp.runtime.vm.intrinsics"

-- Logical frame accesses retain their contract in Nupp until machine emission.
lower.SLOTS = "nupp.runtime.vm.slots"
lower.FRAMES = "nupp.runtime.vm.frames"

-- Frozen code bytes retain their owning body lifetime through the Nupp graph.
lower.PROGRAM = "nupp.runtime.vm.program"

-- Ordinary implementations carry the semantic specialization contracts.
lower.SPECIALIZATION = "nupp.runtime.vm.specialization"

--- The atomics declaration: loads, stores, exchanges and fences on words the
--- lowering emits as Cranelift's sequentially consistent atomic instructions.
lower.ATOMICS = "nupp.runtime.vm.atomic"

--- The declarations of what the runtime exports to native code, by C ABI,
--- and the symbol prefix each declares under: a member `name` of the module
--- is the symbol `<prefix><name in snake case>`, with the kinds its declared
--- signature says. `helpers` are the interpreter's Rust helpers; `os` the
--- operating-system edges (pages, threads, files).
lower.HELPER_MODULES = {
    ["nupp.runtime.vm.helpers"] = "nupp_rt_",
    ["nupp.runtime.vm.bytehelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.recordhelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.simdhelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.modulehelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.statehelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.numerichelpers"] = "nupp_rt_",
    ["nupp.runtime.vm.os"] = "nupp_os_"
}

-- The allocator currently uses the remaining checked native lowering. P1b
-- moves these functions to the common graph along with the other support code.
local function allocatorModule(name: string): boolean
    return name == "nupp.runtime.vm.arena"
        or name == "nupp.runtime.vm.heap"
        or name == "nupp.runtime.vm.allocator"
        or name == "nupp.runtime.vm.marking"
        or name == "nupp.runtime.vm.weakentries"
        or name == "nupp.runtime.vm.gcweak"
        or name == "nupp.runtime.vm.valuearray"
        or name == "nupp.runtime.vm.bytearray"
        or name == "nupp.runtime.vm.shapeowned"
        or name == "nupp.runtime.vm.shapemethods"
        or name == "nupp.runtime.vm.backing"
        or name == "nupp.runtime.vm.weakindex"
        or name == "nupp.runtime.vm.objecttable"
        or name == "nupp.runtime.vm.recordbody"
        or name == "nupp.runtime.vm.childwalk"
        or name == "nupp.runtime.vm.objectwalk"
end

--- The native core's modules, in the order they compile, relative to the
--- repository root.
lower.RUNTIME_MODULES = {
    "src/nupp/runtime/vm/values.nupp",
    "src/nupp/runtime/vm/objecthash.nupp",
    "src/nupp/runtime/vm/objectshape.nupp",
    "src/nupp/runtime/vm/objecttable.nupp",
    "src/nupp/runtime/vm/objectweak.nupp",
    "src/nupp/runtime/vm/objectconstruct.nupp",
    "src/nupp/runtime/vm/arena.nupp",
    "src/nupp/runtime/vm/heap.nupp",
    "src/nupp/runtime/vm/allocator.nupp",
    "src/nupp/runtime/vm/marking.nupp",
    "src/nupp/runtime/vm/weakentries.nupp",
    "src/nupp/runtime/vm/gcweak.nupp",
    "src/nupp/runtime/vm/valuearray.nupp",
    "src/nupp/runtime/vm/bytearray.nupp",
    "src/nupp/runtime/vm/shapeowned.nupp",
    "src/nupp/runtime/vm/shapemethods.nupp",
    "src/nupp/runtime/vm/backing.nupp",
    "src/nupp/runtime/vm/weakindex.nupp",
    "src/nupp/runtime/vm/recordbody.nupp",
    "src/nupp/runtime/vm/childwalk.nupp",
    "src/nupp/runtime/vm/objectwalk.nupp",
    "src/nupp/runtime/vm/core.nupp",
    "src/nupp/runtime/vm/calls.nupp",
    "src/nupp/runtime/vm/protocol.nupp",
    "src/nupp/runtime/vm/lookup.nupp",
    "src/nupp/runtime/vm/boxing.nupp",
    "src/nupp/runtime/vm/strings.nupp",
    "src/nupp/runtime/vm/tables.nupp",
    "src/nupp/runtime/vm/closures.nupp",
    "src/nupp/runtime/vm/control.nupp",
    "src/nupp/runtime/vm/records.nupp",
    "src/nupp/runtime/vm/simd.nupp",
    "src/nupp/runtime/vm/modules.nupp",
    "src/nupp/runtime/vm/numeric.nupp",
    "src/nupp/runtime/vm/state.nupp",
    "src/nupp/runtime/vm/byteops.nupp"
}

local INTRINSICS = lower.INTRINSICS
local ATOMICS = lower.ATOMICS
local HELPER_MODULES: {[string]: string} = lower.HELPER_MODULES

-- `getIndexNum` under `nupp_rt_` is `nupp_rt_get_index_num`.
local function helperSymbol(prefix: string, member: string): string
    return prefix .. member:gsub("%u", function(letter: string): string
        return "_" .. letter:lower()
    end)
end

local function need(ok: any, message: string): any
    assert(ok, "lower: " .. message)
    return ok
end

-- A number literal as CLIF spells it: without the width suffix.
local function literalText(n: any): string
    return (n.token.text:gsub("[Uu]?[Ll][Ll]$", ""))
end

-- A nullable pointer is a union with nil; the pointer is the representation.
local function nonnil(t: any): any
    if t and t.tag == "union" and t.hasNil then
        local rest = nil
        for _, member in ipairs(t.members) do
            if member.tag ~= "nil" then
                if rest then
                    return t
                end
                rest = member
            end
        end
        return rest or t
    end

    return t
end

-- Wrappers that change what the checker knows, not the representation.
local wrappers = {literal = "base", const = "inner", borrowed = "inner", pinned = "inner", affine = "inner"}

-- The pointer members of a union, when every member but nil is one: such a
-- union is one pointer at run time whichever member it holds.
local function pointerMembers(t: any): {any}?
    if not t or t.tag ~= "union" then
        return nil
    end
    local members = {}
    for _, member in ipairs(t.members) do
        local m = member
        while m and wrappers[m.tag] do
            m = m[wrappers[m.tag]]
        end
        if m.tag == "ptr" or m.tag == "voidptr" then
            members[#members + 1] = m
        elseif m.tag ~= "nil" then
            return nil
        end
    end

    return #members > 0 and members or nil
end

local function tag(t: any): string
    t = nonnil(t)
    while t and wrappers[t.tag] do
        t = nonnil(t[wrappers[t.tag]])
    end
    if pointerMembers(t) then
        return "ptr"
    end
    if t and t.tag == "nominal" and t.declKind == "struct" then
        -- A struct value is its address: memory in a stack slot or inline in
        -- its parent, never a register.
        return "struct"
    end
    local kind = t and t.tag or "missing"
    -- Physical kinds retain exact width and signedness through emission.

    return kind
end

-- The type under literal and const wrappers.
local function raw(t: any): any
    t = nonnil(t)
    while t and wrappers[t.tag] do
        t = nonnil(t[wrappers[t.tag]])
    end

    return t
end

-- The struct a pointer type points at, when it does.
local function pointee(t: any): any
    t = raw(t)
    if t and t.tag == "ptr" then
        local elem = raw(t.elem)
        if elem and elem.tag == "nominal" and elem.declKind == "struct" then
            return elem
        end
    end

    return nil
end

-- The function type a pointer to a function names, or a function type itself:
-- what a call through a function pointer is typed by.
local function functionPointee(t: any): any
    local r = raw(t)
    if r and r.tag == "ptr" then
        r = raw(r.elem)
    end
    if r and r.tag == "func" then
        return r
    end

    return nil
end

-- Field offsets come from the compiler's own layout model for the host.
local layoutKey = targetLayout.hostKey() or "aarch64-apple-darwin"
local fieldCache = {}

-- The size and alignment of an aggregate type under the host layout.
local function sizeOf(t: any): (number, number)
    local measured, reason = targetLayout.of(raw(t), layoutKey)
    need(measured ~= nil, "layout: " .. tostring(reason))

    return measured.size, measured.alignment
end

-- The scalar kind a struct field is loaded and stored as. A tag field (an
-- integer literal type) occupies the `int32` a C enumerator does. Ordinary
-- integer fields use their canonical signed64 representation.
local function fieldKind(t: any): string
    local r = raw(t)
    if r and (r.tag == "literal" and type(r.constant) == "number") then
        return "int32"
    end

    return tag(t)
end

local function fieldOf(struct: any, member: string): any
    local fields = fieldCache[struct]
    if not fields then
        local measured, reason = targetLayout.of(struct, layoutKey)
        need(measured ~= nil, "struct layout: " .. tostring(reason))
        fields = {}
        for _, field in ipairs(measured.fields) do
            fields[field.name] = field
        end
        fieldCache[struct] = fields
    end
    local field = need(fields[member], "unknown field " .. member)
    need(not field.bitWidth, "bitfields")

    return {offset = field.offset, kind = fieldKind(struct.byname[member]), type = struct.byname[member]}
end

-- A field reached through a pointer type: a struct pointer's field, or a field
-- every member of a union of struct pointers places at one offset with one
-- kind, which is what a tag field is and what makes comparing it narrow the
-- union.
local function fieldThrough(t: any, member: string): any
    local struct = pointee(t)
    local value = raw(t)
    if not struct and value and value.tag == "nominal" and value.declKind == "struct" then
        struct = value
    end
    if struct then
        return fieldOf(struct, member)
    end
    local members = need(pointerMembers(raw(t)), "field access needs a struct pointer")
    local common = nil
    for _, m in ipairs(members) do
        local each = need(pointee(m), "field access needs a struct pointer")
        local field = fieldOf(each, member)
        if common then
            need(
                field.offset == common.offset and field.kind == common.kind,
                "field " .. member .. " is not laid out alike in every member of the union"
            )
        else
            common = field
        end
    end

    return common
end

-- The machine type of a scalar Nupp type.
local function machine(kind: string): string
    if kind == "int64"
        or kind == "uint64"
        or kind == "voidptr"
        or kind == "ptr"
        or kind == "int32"
        or kind == "uint32"
        or kind == "int8"
        or kind == "uint8"
        or kind == "int16"
        or kind == "uint16"
        or kind == "struct"
        or kind == "carray"
    then
        return "i64"
    elseif kind == "float64" then
        return "f64"
    elseif kind == "boolean" then
        return "i8"
    end
    error("lower: unsupported type " .. kind, 0)
end

-- A double as CLIF spells it: a hexadecimal significand and a binary exponent.
local function hexFloat(x: float64): string
    if x ~= x then
        return "NaN"
    elseif x == math.huge then
        return "Inf"
    elseif x == -math.huge then
        return "-Inf"
    elseif x == 0 then
        return (1 / x < 0) and "-0.0" or "0.0"
    end
    local sign = ""
    if x < 0 then
        sign = "-"
        x = -x
    end
    local m, e = math.frexp(x)
    local significand = m * 9007199254740992 -- 2^53, exact
    local digits = {}
    for _ = 1, 14 do
        local digit = significand % 16
        digits[#digits + 1] = ("0123456789abcdef"):sub(digit + 1, digit + 1)
        significand = (significand - digit) / 16
    end
    -- The leading digit of a normalized significand is 1; the radix point
    -- after it is what makes the text a float to the reader.
    local text = {}
    for index = #digits - 1, 1, -1 do
        text[#text + 1] = digits[index]
    end

    return sign .. "0x" .. digits[#digits] .. "." .. table.concat(text) .. "p" .. tostring(e - 1)
end

local compareSigned = {["<"] = "slt", ["<="] = "sle", [">"] = "sgt", [">="] = "sge", ["=="] = "eq", ["~="] = "ne"}
local compareUnsigned = {["<"] = "ult", ["<="] = "ule", [">"] = "ugt", [">="] = "uge", ["=="] = "eq", ["~="] = "ne"}
local compareFloat = {["<"] = "lt", ["<="] = "le", [">"] = "gt", [">="] = "ge", ["=="] = "eq", ["~="] = "ne"}
local integerOps = {
    ["+"] = "iadd",
    ["-"] = "isub",
    ["*"] = "imul",
    ["&"] = "band",
    ["|"] = "bor",
    ["~"] = "bxor",
    ["<<"] = "ishl"
}
local floatOps = {["+"] = "fadd", ["-"] = "fsub", ["*"] = "fmul", ["/"] = "fdiv"}
-- The read-modify-write atomics, by the declaration's member name.
local ATOMIC_RMW: {
    [string]: string
} = {add = "add", sub = "sub", exchange = "xchg", bitAnd = "and", bitOr = "or", bitXor = "xor"}

-- The private memory intrinsics the handler modules are written against, so
-- that profile is a subset of this one.
local intrinsicLoads = {
    load8 = "uload8.i64",
    load16 = "uload16.i64",
    load32 = "sload32.i64",
    load64 = "load.i64",
    loadIndex = "load.i64",
    loadPointer = "load.i64",
    loadFloat = "load.f64"
}
local intrinsicKinds = {
    load8 = "int64",
    load16 = "int64",
    load32 = "int64",
    load64 = "uint64",
    loadIndex = "int64",
    loadPointer = "voidptr",
    loadFloat = "float64"
}
local intrinsicStores = {
    store8 = "istore8",
    store16 = "istore16",
    store64 = "store",
    storeIndex = "store",
    storePointer = "store",
    storeFloat = "store",
    store32 = "istore32"
}
local intrinsicStoreKinds = {
    store8 = "uint64",
    store16 = "uint64",
    store64 = "uint64",
    storeIndex = "int64",
    storePointer = "voidptr",
    storeFloat = "float64",
    store32 = "int64"
}
local intrinsicUnary = {
    bits = {"bitcast.i64", "float64", "uint64"},
    fromBits = {"bitcast.f64", "uint64", "float64"},
    floor = {"floor", "float64", "float64"},
    sqrt = {"sqrt", "float64", "float64"},
    ceil = {"ceil", "float64", "float64"},
    popcount = {"popcnt", "uint64", "uint64"},
    neg = {"fneg", "float64", "float64"},
    toFloat = {"fcvt_from_sint.f64", "int64", "float64"},
    toInt = {"fcvt_to_sint_sat.i64", "float64", "int64"},
    unsignedFloat = {"fcvt_from_uint.f64", "uint64", "float64"},
    unsignedInt = {"fcvt_to_uint_sat.i64", "float64", "uint64"},
    asWord = {"uextend.i64", "boolean", "uint64"}
}
local intrinsicIdentity = {
    pointer = {"uint64", "voidptr"},
    address = {"voidptr", "uint64"},
    word = {"int64", "uint64"},
    index = {"uint64", "int64"}
}

-- A function of a module: its node, its kinds, and the module it belongs to,
-- whose functions its body names.
local record Fn
    name: string
    node: any
    body: any
    scope: any
    paramKinds: {string}
    paramTypes: {string}
    resultKind: string?
    resultType: string?
    result: any
    isHandler: boolean
    isSupport: boolean
end

-- A module of the set: its functions by name, the exported ones by member,
-- and its numeric constants (`const NAME = <literal>`), by the checker's
-- definition of the name for the module's own code and by member for the
-- exported ones.
local record Scope
    name: string
    path: string
    functions: {[string]: Fn}
    exports: {[string]: Fn}
    constants: {[any]: string}
    exportedConstants: {[string]: string}
    order: {string}
end

-- Whether a call names a module function: a local function of the module
-- the code was written in, or a member of another module's export table.
local function resolveCallee(call: any, scope: Scope, modules: {[string]: Scope}): Fn?
    if call.kind ~= "call" then
        return nil
    end
    local target = call.obj
    if target.kind == "name" then
        return scope.functions[target.token.text]
    elseif target.kind == "dotIndex" and target.obj.kind == "name" then
        local definition = target.obj.token.definition
        local required = definition and definition.requiredModule
        local other = required and modules[required]
        if other then
            return need(other.exports[target.name.text], "module " .. required .. " exports no " .. target.name.text)
        end
    end

    return nil
end

-- Temporary checked-syntax path for functions not yet admitted to the graph.
-- P1b removes it as the remaining native operations gain graph contracts.
local function compileDirectFunction(fn: Fn, options: any): string
    local body = fn.body
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain function required")
    local name = fn.name
    local modules: {[string]: Scope} = options.modules
    -- The module whose functions a name resolves in: the function's own, or
    -- the helper's while a helper from another module is inlined.
    local scope: Scope = fn.scope
    local handlers = options.handlers == true
    local isHandler = fn.isHandler
    local isSupport = fn.isSupport
    local tableValue: string? = nil
    local inlining = {}
    local paramKinds, paramTypes = fn.paramKinds, fn.paramTypes
    local resultKind, resultType = fn.resultKind, fn.resultType

    local b = ssa.new()
    local emit, effect, constant = b.emit, b.effect, b.constant
    local newBlock, addParam, seal = b.newBlock, b.addParam, b.seal
    local readVariable, writeVariable = b.read, b.write
    local varDecl = {}
    local declaredKinds: any = {}
    -- Temporary direct-path lowering of scalar helper calls. Checked lexical
    -- definitions keep their identity; an activation maps them to fresh SSA
    -- variables so repeated inlining cannot reuse a previous call's locals.
    local inlineBindings: any = nil
    local scalarReturn: any = nil
    local inlineScalar

    local function declare(token: any, kind: string, declared: any): any
        local variable = token.definition or token.text
        if inlineBindings ~= nil then
            local original = variable
            if inlineBindings[original] == nil then
                inlineBindings[original] = {}
            end
            variable = inlineBindings[original]
        end
        need(kind ~= "union", "local " .. token.text .. " has unsupported union type")
        b.declare(variable, machine(kind))
        varDecl[variable] = declared
        declaredKinds[variable] = kind

        return variable
    end

    local function variableOf(token: any): any
        local variable = token.definition or token.text
        if inlineBindings ~= nil and inlineBindings[variable] ~= nil then
            variable = inlineBindings[variable]
        end
        need(b.typeOf(variable), "unknown variable " .. tostring(token.text))

        return variable
    end

    -- The scalar kind a variable's machine type reads back as when the
    -- checker's type says nothing more.
    local function kindOfVariable(variable: any): string
        local t = b.typeOf(variable)
        return t == "f64" and "float64" or (t == "i8" and "boolean" or "int64")
    end

    -- The affine values `with` statements hold at this point, innermost last,
    -- each with the function that releases it. A return runs them all; a
    -- break or continue runs those opened inside the loop it leaves.
    local cleanups = {}

    -- Callees and signatures are declared once per function in the preamble.
    -- `sig0` is the handler signature in handler mode, so numbering starts
    -- after it there.
    local callees, preamble = {}, {}
    local signatures = {}
    local sigCount = handlers and 1 or 0
    local fnCount = 0

    local function declareSignature(text: string): string
        local known = signatures[text]
        if known then
            return known
        end
        local sig = "sig" .. tostring(sigCount)
        sigCount = sigCount + 1
        preamble[#preamble + 1] = sig .. " = " .. text
        signatures[text] = sig

        return sig
    end

    local function declareFunction(symbol: string, sig: string): string
        local ref = "fn" .. tostring(fnCount)
        fnCount = fnCount + 1
        preamble[#preamble + 1] = ref .. " = %" .. symbol .. " " .. sig

        return ref
    end

    -- A stack slot for a struct value built in this function.
    local slotCount = 0

    local function declareSlot(size: number, alignment: number): string
        need(not handlers or isSupport, "a handler keeps no struct values")
        local slot = "ss" .. tostring(slotCount)
        slotCount = slotCount + 1
        preamble[#preamble + 1] = slot .. " = explicit_slot " .. tostring(size) .. ", align = " .. tostring(alignment)

        return slot
    end

    -- The CLIF signature of a function type: its parameters and result as the
    -- machine types their kinds lower to.
    local function signatureOf(fnType: any): string
        local types = {}
        for index, param in ipairs(fnType.params or {}) do
            types[index] = machine(tag(param))
        end
        local text = "(" .. table.concat(types, ", ") .. ")"
        local rets = fnType.rets or {}
        need(#rets <= 1, "at most one result")
        local resultKind = #rets == 1 and tag(rets[1]) or nil
        if resultKind and resultKind ~= "nil" then
            text = text .. " -> " .. machine(resultKind)
        end

        return text
    end

    local function callee(target: Fn): any
        local known = callees[target]
        if known then
            return known
        end
        need(not handlers, "a handler module's functions are tail-called: `return " .. target.name .. "(...)`")
        local signature = "(" .. table.concat(target.paramTypes, ", ") .. ")"
        if target.resultType then
            signature = signature .. " -> " .. target.resultType
        end
        if nativegraph.isLeaf(target) or options.allocator and allocatorModule(target.scope.name) then
            signature = signature .. " tail"
        end
        local ref = declareFunction(target.name, declareSignature(signature))
        known = {ref = ref, target = target}
        callees[target] = known

        return known
    end

    -- Expressions answer a typed value, or a literal still free to take the
    -- type its context asks for.
    local expression
    local scalarIntrinsic

    -- The kind a narrow field's value has once loaded: the thirty-two bit width
    -- of its signedness, as the checker types it.
    local function loadedKind(kind: string): string
        if kind == "int8" or kind == "int16" then
            return "int32"
        elseif kind == "uint8" or kind == "uint16" then
            return "uint32"
        end

        return kind
    end

    -- A word holding a thirty-two bit value in canonical form: the low thirty-two
    -- bits sign- or zero-extended, so a `uint32` reads as its value and an
    -- `int32` as its signed one. Every fixed-width operation ends here, which is
    -- what makes the arithmetic wrap.
    local function wrap32(kind: string, value: string): string
        local narrow = emit("ireduce.i32 " .. value)
        if kind == "uint32" then
            return emit("uextend.i64 " .. narrow)
        end

        return emit("sextend.i64 " .. narrow)
    end

    local function isFixed32(kind: string): boolean
        return kind == "int32" or kind == "uint32"
    end

    local function materialize(e: any, kind: string): string
        if e.literal then
            if kind == "float64" then
                return emit("f64const " .. hexFloat((tonumber(e.literal) as number) * 1.0))
            elseif kind == "boolean" then
                error("lower: a number is not a boolean", 0)
            end
            return constant("i64", e.literal)
        end
        if kind == "float64" and (isFixed32(e.kind) or e.kind == "int64" or e.kind == "uint64") then
            -- Convert the checked integer operand at a binary64 operation boundary.
            local unsigned = e.kind == "uint32" or e.kind == "uint64"
            return emit((unsigned and "fcvt_from_uint.f64 " or "fcvt_from_sint.f64 ") .. e.value)
        end
        need(
            e.kind == kind or (machine(e.kind) == machine(kind)),
            "expected " .. kind .. ", found " .. tostring(e.kind)
        )

        return e.value
    end

    -- A memory access of one field or intrinsic width.
    local function load(kind: string, address: string): string
        if kind == "float64" then
            return emit("load.f64 notrap " .. address)
        elseif kind == "boolean" then
            return emit("load.i8 notrap " .. address)
        elseif kind == "int32" then
            return emit("sload32.i64 notrap " .. address)
        elseif kind == "uint32" then
            return emit("uload32.i64 notrap " .. address)
        elseif kind == "int8" then
            return emit("sload8.i64 notrap " .. address)
        elseif kind == "uint8" then
            return emit("uload8.i64 notrap " .. address)
        elseif kind == "int16" then
            return emit("sload16.i64 notrap " .. address)
        elseif kind == "uint16" then
            return emit("uload16.i64 notrap " .. address)
        end

        return emit("load.i64 notrap " .. address)
    end

    local function store(kind: string, value: string, address: string): nil
        if kind == "int32" or kind == "uint32" then
            effect("istore32 notrap " .. value .. ", " .. address)
        elseif kind == "int8" or kind == "uint8" then
            effect("istore8 notrap " .. value .. ", " .. address)
        elseif kind == "int16" or kind == "uint16" then
            effect("istore16 notrap " .. value .. ", " .. address)
        else
            effect("store notrap " .. value .. ", " .. address)
        end
    end

    local WIDTHS = {8, 4, 2, 1}
    local LOADS = {[8] = "load.i64", [4] = "load.i32", [2] = "load.i16", [1] = "load.i8"}
    local STORES = {[8] = "store", [4] = "istore32", [2] = "istore16", [1] = "istore8"}

    -- Copies `size` bytes from one address to another, in words and then the
    -- tail, which is how a struct or fixed array is stored by value.
    local function copyBytes(to: string, from: string, size: number): nil
        local offset = 0
        for _, width in ipairs(WIDTHS) do
            while size - offset >= width do
                local at = constant("i64", tostring(offset))
                local source = emit("iadd " .. from .. ", " .. at)
                local target = emit("iadd " .. to .. ", " .. at)
                local word = emit(LOADS[width] .. " notrap " .. source)
                effect("store notrap " .. word .. ", " .. target)
                offset = offset + width
            end
        end
    end

    -- Zeroes `size` bytes at an address.
    local function zeroBytes(to: string, size: number): nil
        local offset = 0
        local zero = constant("i64", "0")
        for _, width in ipairs(WIDTHS) do
            while size - offset >= width do
                local target = emit("iadd " .. to .. ", " .. constant("i64", tostring(offset)))
                effect(STORES[width] .. " notrap " .. zero .. ", " .. target)
                offset = offset + width
            end
        end
    end

    -- Stores a value of `kind` into a slot: a scalar as itself, a struct or
    -- fixed array by copying its bytes.
    local function storeInto(kind: string, fieldType: any, value: any, address: string): nil
        if kind == "struct" or kind == "carray" then
            copyBytes(address, materialize(value, kind), (sizeOf(fieldType)))
        else
            store(kind, materialize(value, kind), address)
        end
    end

    local fieldAddress

    local function kindOf(n: any, e: any, other: any): string
        if not e.literal then
            return e.kind
        elseif other and not other.literal then
            return other.kind
        end
        local inferred = tag(n.inferredType)

        return inferred == "missing" and "float64" or inferred
    end

    local function condition(n: any): string
        return materialize(expression(n), "boolean")
    end

    -- A condition in branch position: `and`, `or`, `not` and the `both` and
    -- `either` intrinsics branch directly through their operands, so the
    -- common path pays one compare and one branch per operand rather than
    -- materializing every flag.
    local branchOn

    -- The module a call reaches into through a required binding, if any.
    local function calledModule(n: any): string?
        if n.kind == "call"
            and n.obj.kind == "dotIndex"
            and n.obj.obj.kind == "name"
            and n.obj.obj.token.definition ~= nil
        then
            return n.obj.obj.token.definition.requiredModule
        end

        return nil
    end

    local function isIntrinsicCall(n: any): boolean
        return calledModule(n) == INTRINSICS
    end

    -- An atomic operation on a word or a thirty-two bit half of one, at a byte
    -- offset from a base: Cranelift's sequentially consistent instructions,
    -- which is the strongest ordering and what every call here promises.
    local function atomic(operation: string, args: any): any
        local function arg(index: number, kind: string): string
            return materialize(expression(need(args[index], operation .. ": argument " .. tostring(index))), kind)
        end

        if operation == "fence" then
            effect("fence")
            return {kind = "nil", value = ""}
        end
        local narrow = operation:sub(-2) == "32"
        local name = narrow and operation:sub(1, -3) or operation
        local kind = narrow and "uint32" or "uint64"
        local width = narrow and "i32" or "i64"
        local address = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))

        local function operand(index: number): string
            local word = arg(index, kind)
            return narrow and emit("ireduce.i32 " .. word) or word
        end

        local function answer(value: string): any
            return {kind = kind, value = narrow and emit("uextend.i64 " .. value) or value}
        end

        if name == "load" then
            return answer(emit("atomic_load." .. width .. " " .. address))
        elseif name == "store" then
            effect("atomic_store " .. operand(3) .. ", " .. address)
            return {kind = "nil", value = ""}
        elseif name == "compareAndSwap" then
            return answer(emit("atomic_cas " .. address .. ", " .. operand(3) .. ", " .. operand(4)))
        end
        local rmw = need(ATOMIC_RMW[name], "unsupported atomic operation " .. operation) as string

        return answer(emit("atomic_rmw." .. width .. " " .. rmw .. " " .. address .. ", " .. operand(3)))
    end

    local function isIntrinsic(n: any, intrinsicName: string): boolean
        return isIntrinsicCall(n) and n.obj.name.text == intrinsicName and #(n.args.exprs or {}) == 2
    end

    branchOn = function(n: any, yes: ssa.Block, no: ssa.Block): nil
        if n.kind == "paren" then
            branchOn(n.expr, yes, no)
        elseif (n.kind == "binop" and n.op.text == "and") or isIntrinsic(n, "both") then
            local lhs = n.kind == "binop" and n.lhs or n.args.exprs[1]
            local rhs = n.kind == "binop" and n.rhs or n.args.exprs[2]
            local rest = newBlock()
            branchOn(lhs, rest, no)
            b.current = rest
            seal(rest)
            branchOn(rhs, yes, no)
        elseif (n.kind == "binop" and n.op.text == "or") or isIntrinsic(n, "either") then
            local lhs = n.kind == "binop" and n.lhs or n.args.exprs[1]
            local rhs = n.kind == "binop" and n.rhs or n.args.exprs[2]
            local rest = newBlock()
            branchOn(lhs, yes, rest)
            b.current = rest
            seal(rest)
            branchOn(rhs, yes, no)
        elseif n.kind == "unop" and n.op.text == "not" then
            branchOn(n.operand, no, yes)
        else
            b.branch(condition(n), yes, no)
        end
    end

    local function arithmetic(n: any, op: string, kind: string, lhs: any, rhs: any): any
        local a, c = materialize(lhs, kind), materialize(rhs, kind)
        if kind == "float64" then
            if op == "%" then
                local quotient = emit("fdiv " .. a .. ", " .. c)
                local floored = emit("floor " .. quotient)
                local product = emit("fmul " .. floored .. ", " .. c)
                return {kind = kind, value = emit("fsub " .. a .. ", " .. product)}
            end
            local opName = need(floatOps[op], "unsupported float operator " .. op)
            return {kind = kind, value = emit(opName .. " " .. a .. ", " .. c)}
        end
        local unsigned = kind == "uint64" or kind == "uint32"
        if isFixed32(kind) then
            -- Thirty-two bit arithmetic: computed on the words and wrapped to the
            -- width, which is the reference's `+`, `-` and `*` modulo 2^32. A
            -- shift count is masked by 31; `>>` shifts zeros into the thirty-two
            -- bit pattern and `~>>` copies its sign.
            if op == "<<" or op == ">>" or op == "~>>" then
                local count = emit("band " .. c .. ", " .. constant("i64", "31"))
                if op == "<<" then
                    return {kind = kind, value = wrap32(kind, emit("ishl " .. a .. ", " .. count))}
                elseif op == ">>" then
                    local pattern = emit("uextend.i64 " .. emit("ireduce.i32 " .. a))
                    return {kind = kind, value = wrap32(kind, emit("ushr " .. pattern .. ", " .. count))}
                else
                    local pattern = emit("sextend.i64 " .. emit("ireduce.i32 " .. a))
                    return {kind = kind, value = wrap32(kind, emit("sshr " .. pattern .. ", " .. count))}
                end
            elseif op == "//" then
                return {kind = kind, value = emit((unsigned and "udiv " or "sdiv ") .. a .. ", " .. c)}
            elseif op == "%" then
                return {kind = kind, value = emit((unsigned and "urem " or "srem ") .. a .. ", " .. c)}
            end
            local opName = need(integerOps[op], "unsupported integer operator " .. op)
            return {kind = kind, value = wrap32(kind, emit(opName .. " " .. a .. ", " .. c))}
        end
        if op == ">>" then
            return {kind = kind, value = emit("ushr " .. a .. ", " .. c)}
        elseif op == "~>>" then
            return {kind = kind, value = emit("sshr " .. a .. ", " .. c)}
        elseif op == "//" then
            if unsigned then
                return {kind = kind, value = emit("udiv " .. a .. ", " .. c)}
            end
            -- Floored division: the truncated quotient, less one when the
            -- remainder is nonzero and disagrees in sign with the divisor.
            local quotient = emit("sdiv " .. a .. ", " .. c)
            local remainder = emit("srem " .. a .. ", " .. c)
            local zero = constant("i64", "0")
            local nonzero = emit("icmp ne " .. remainder .. ", " .. zero)
            local mixed = emit("bxor " .. remainder .. ", " .. c)
            local negative = emit("icmp slt " .. mixed .. ", " .. zero)
            local adjust = emit("band " .. nonzero .. ", " .. negative)
            local wide = emit("uextend.i64 " .. adjust)
            return {kind = kind, value = emit("isub " .. quotient .. ", " .. wide)}
        elseif op == "%" then
            if unsigned then
                return {kind = kind, value = emit("urem " .. a .. ", " .. c)}
            end
            local remainder = emit("srem " .. a .. ", " .. c)
            local zero = constant("i64", "0")
            local nonzero = emit("icmp ne " .. remainder .. ", " .. zero)
            local mixed = emit("bxor " .. remainder .. ", " .. c)
            local negative = emit("icmp slt " .. mixed .. ", " .. zero)
            local adjust = emit("band " .. nonzero .. ", " .. negative)
            local wide = emit("uextend.i64 " .. adjust)
            local mask = emit("ineg " .. wide)
            local addend = emit("band " .. c .. ", " .. mask)
            return {kind = kind, value = emit("iadd " .. remainder .. ", " .. addend)}
        end
        local opName = need(integerOps[op], "unsupported integer operator " .. op)

        return {kind = kind, value = emit(opName .. " " .. a .. ", " .. c)}
    end

    local function compare(n: any, op: string, lhs: any, rhs: any): any
        local kind = kindOf(n.lhs, lhs, rhs)
        local a, c = materialize(lhs, kind), materialize(rhs, kind)
        local text: string
        if kind == "float64" then
            text = "fcmp " .. compareFloat[op]
        elseif kind == "uint64" or kind == "uint32" or kind == "voidptr" or kind == "ptr" then
            text = "icmp " .. compareUnsigned[op]
        elseif kind == "boolean" then
            need(op == "==" or op == "~=", "ordered comparison of booleans")
            text = "icmp " .. compareSigned[op]
        else
            text = "icmp " .. compareSigned[op]
        end

        return {kind = "boolean", value = emit(text .. " " .. a .. ", " .. c)}
    end

    local function shortCircuit(n: any, isAnd: boolean): any
        local left = condition(n.lhs)
        local rest, join = newBlock(), newBlock()
        local result = addParam(join, "i8")
        local from = b.here()
        if isAnd then
            b.branch(left, rest, join)
        else
            b.branch(left, join, rest)
        end
        -- The short-circuit edge carries the left operand.
        for _, target in ipairs(from.term.targets) do
            if target.block == join then
                target.args[1] = left
            end
        end
        b.current = rest
        seal(rest)
        local right = condition(n.rhs)
        b.jump(join, {right})
        b.current = join
        seal(join)

        return {kind = "boolean", value = result}
    end

    fieldAddress = function(n: any): any
        local base = expression(n.obj)
        local field = fieldThrough(base.type, n.name.text)
        local address = emit("iadd " .. materialize(base, "ptr") .. ", " .. constant("i64", tostring(field.offset)))

        return {address = address, field = field}
    end

    -- An element of a fixed array or of what a pointer names: its address,
    -- the kind it loads as, and its type. An index into a `T[N]` the checker
    -- did not prove in bounds, outside `@unsafe`, is checked here and traps.
    local function elementAddress(n: any): any
        local base = expression(n.obj)
        local container = raw(base.type)
        need(
            container and (container.tag == "carray" or container.tag == "ptr"),
            "indexing needs a fixed array or a pointer"
        )
        local elem = container.elem
        local measured, reason = targetLayout.of(raw(elem), layoutKey)
        need(measured ~= nil, "element layout: " .. tostring(reason))
        local index = materialize(expression(n.expr), "int64")
        if n.carrayBound and not n.unsafeOwnershipOperation then
            local outside = emit("icmp uge " .. index .. ", " .. constant("i64", tostring(n.carrayBound)))
            effect("trapnz " .. outside .. ", user1")
        end
        local scaled = emit("imul " .. index .. ", " .. constant("i64", tostring(measured.size)))
        local address = emit("iadd " .. materialize(base, "ptr") .. ", " .. scaled)

        return {address = address, kind = fieldKind(elem), type = elem}
    end

    local imported = {}

    -- A Rust helper, declared once per caller with the signature the helpers
    -- declaration gives it.
    local function importHelper(symbol: string, paramKinds: {string}, resultKind: string?): string
        local known = imported[symbol]
        if known then
            return known
        end
        local types = {}
        for i, kind in ipairs(paramKinds) do
            types[i] = machine(kind)
        end
        local signature = "(" .. table.concat(types, ", ") .. ")"
        if resultKind then
            signature = signature .. " -> " .. machine(resultKind)
        end
        local ref = declareFunction(symbol, declareSignature(signature))
        imported[symbol] = ref

        return ref
    end

    -- A call into the helpers declaration: a C ABI call to the exported
    -- symbol, with the kinds the declared signature says.
    local function helperCall(n: any, prefix: string): any
        need(handlers or prefix == "nupp_os_", "Rust helpers belong to handler modules")
        local member = n.obj.name.text
        local signature = raw(n.obj.inferredType)
        need(signature and signature.tag == "func", "helper " .. member .. " has no declared signature")
        helpercontract.read(n.obj.name.definition, member)
        local args = n.args.exprs or {}
        need(#args == #signature.params, member .. ": argument count")
        local paramKinds, words = {}, {}
        for index, param in ipairs(signature.params) do
            paramKinds[index] = tag(param)
            words[index] = materialize(expression(args[index]), paramKinds[index])
        end
        local resultKind = #signature.rets == 1 and tag(signature.rets[1]) or nil
        if resultKind == "nil" then
            resultKind = nil
        end
        local symbol = helperSymbol(prefix, member)
        local text = "call " .. importHelper(symbol, paramKinds, resultKind) .. "(" .. table.concat(words, ", ") .. ")"
        if resultKind then
            return {kind = resultKind, value = emit(text)}
        end
        effect(text)

        return {kind = "nil", value = ""}
    end

    local function frameCall(n: any): any
        need(options.layout, "frame access requires layouts")
        local access = framecontract.read(n.obj.name.definition, n.obj.name.text)
        local signature = raw(n.obj.inferredType)
        local args = n.args.exprs or {}
        local count = access.kind == "window" and 2 or 1
        need(
            signature and signature.tag == "func" and #signature.params == count and #args == count,
            "frame access argument count"
        )
        local words = {}
        for index, parameter in ipairs(signature.params) do
            need(tag(parameter) == "voidptr", "frame access argument kind")
            words[index] = materialize(expression(args[index]), "voidptr")
        end
        local result = access.kind == "status" and "int64" or "voidptr"
        need(#signature.rets == 1 and tag(signature.rets[1]) == result, "frame access result kind")
        if access.kind == "status" then
            local address = emit("iadd " .. words[1] .. ", " .. constant("i64", tostring(options.layout("status"))))
            return {kind = result, value = emit("sload32.i64 notrap " .. address)}
        elseif access.kind == "recover" then
            local stack = load(
                "voidptr",
                emit("iadd " .. words[1] .. ", " .. constant("i64", tostring(options.layout("stack"))))
            )
            local cur = load(
                "uint64",
                emit("iadd " .. words[1] .. ", " .. constant("i64", tostring(options.layout("cur"))))
            )
            local offset = emit("imul " .. cur .. ", " .. constant("i64", "8"))
            return {kind = result, value = emit("iadd " .. stack .. ", " .. offset)}
        elseif access.class == "v" then
            return {kind = result, value = emit("iadd " .. words[2] .. ", " .. constant("i64", "32"))}
        end
        local fid = emit("band " .. load("uint64", words[2]) .. ", " .. constant("i64", "4294967295"))
        local funcs = load(
            "voidptr",
            emit("iadd " .. words[1] .. ", " .. constant("i64", tostring(options.layout("funcs"))))
        )
        local info = emit(
            "iadd " .. funcs .. ", " .. emit(
                "imul " .. fid .. ", " .. constant("i64", tostring(options.layout("FuncInfo.size")))
            )
        )
        local property = access.class == "i" and "FuncInfo.off_i" or "FuncInfo.off_f"
        local off = emit(
            "sload32.i64 notrap " .. emit(
                "iadd " .. info .. ", " .. constant("i64", tostring(options.layout(property)))
            )
        )

        return {
            kind = result,
            value = emit("iadd " .. words[2] .. ", " .. emit("imul " .. off .. ", " .. constant("i64", "8")))
        }
    end

    -- The temporary direct path only assigns an address to the Nupp contract.
    -- Slot promotion, alias reasoning and publication belong to the Nupp graph.
    local function slotCall(n: any): any
        local member = n.obj.name.text
        local access = slotcontract.read(n.obj.name.definition, member)
        local signature = raw(n.obj.inferredType)
        local args = n.args.exprs or {}
        local vararg = access.class == "vararg"
        local count = vararg and 2 or (access.write and 4 or 3)
        need(
            signature and signature.tag == "func" and #signature.params == count and #args == count,
            member .. ": slot argument count"
        )
        local kinds = vararg and {"voidptr", "int64"} or {"voidptr", "voidptr", "int64", access.kind}
        local words = {}
        for index, param in ipairs(signature.params) do
            need(tag(param) == kinds[index], member .. ": slot argument kind")
            words[index] = materialize(expression(args[index]), kinds[index])
        end
        local resultKind = access.write and "nil" or access.kind
        need(#signature.rets == 1 and tag(signature.rets[1]) == resultKind, member .. ": slot result kind")
        if vararg then
            local packed = emit("load.i64 notrap " .. words[1] .. "+24")
            local length = emit("ushr " .. packed .. ", " .. constant("i64", "49"))
            local slot = emit("isub " .. words[2] .. ", " .. length)
            local offset = emit("imul " .. slot .. ", " .. constant("i64", tostring(access.width)))
            return {kind = access.kind, value = load(access.kind, emit("iadd " .. words[1] .. ", " .. offset))}
        end
        local offset = emit("imul " .. words[3] .. ", " .. constant("i64", tostring(access.width)))
        local address = emit("iadd " .. words[2] .. ", " .. offset)
        if access.offset ~= nil and access.offset ~= 0 then
            address = emit("iadd " .. address .. ", " .. constant("i64", tostring(access.offset)))
        end
        if access.write then
            store(access.kind, words[4], address)
            return {kind = "nil", value = ""}
        end

        return {kind = access.kind, value = load(access.kind, address)}
    end

    -- Emission preserves ordinary loads. Version and lifetime reasoning stays
    -- in Nupp; no machine readonly flag promises process-wide immutability.
    local function programCall(n: any): any
        local member = n.obj.name.text
        local access = programcontract.read(n.obj.name.definition, member)
        local signature = raw(n.obj.inferredType)
        local args = n.args.exprs or {}
        need(
            signature and signature.tag == "func" and #signature.params == 2 and #args == 2,
            member .. ": program argument count"
        )
        need(
            tag(signature.params[1]) == "voidptr" and tag(signature.params[2]) == "int64",
            member .. ": program argument kind"
        )
        need(#signature.rets == 1 and tag(signature.rets[1]) == access.result, member .. ": program result kind")
        local base = materialize(expression(args[1]), "voidptr")
        local offset = materialize(expression(args[2]), "int64")
        local address = emit("iadd " .. base .. ", " .. offset)
        if access.kind == "uint8" then
            return {kind = access.result, value = emit("uload8.i64 notrap " .. address)}
        elseif access.kind == "int32" then
            return {kind = access.result, value = emit("sload32.i64 notrap " .. address)}
        end

        return {kind = access.result, value = load(access.result, address)}
    end

    -- This path emits only ordinary interpreter meanings. Deriving variants,
    -- proving constants and balancing contexts belong to the Nupp graph.
    local function specializationCall(n: any): any
        local member = n.obj.name.text
        local operation = specializationcontract.read(n.obj.name.definition, member)
        local signature = raw(n.obj.inferredType)
        local args = n.args.exprs or {}
        local counts = {assertConstant = 1, specializeValue = 3, pushContext = 1, popContext = 0, inInterpreter = 0}
        local count = counts[operation]
        need(
            signature and signature.tag == "func" and #signature.params == count and #args == count,
            member .. ": specialization argument count"
        )
        need(#signature.rets == 1, member .. ": specialization result count")
        local resultKind = tag(n.inferredType)
        if operation == "assertConstant" then
            local kind = tag(args[1].inferredType)
            need(kind == resultKind, member .. ": specialization result kind")
            machine(kind)
            return expression(args[1])
        elseif operation == "specializeValue" then
            for _, param in ipairs(signature.params) do
                need(tag(param) == "int64", member .. ": specialization argument kind")
            end
            need(resultKind == "int64", member .. ": specialization result kind")
            local value = expression(args[1])
            local low, high = expression(args[2]), expression(args[3])
            need(low.literal and high.literal, member .. ": specialization bounds must be constant")
            specializationcontract.domain(low.literal, high.literal, options.specializationVariantCap)
            return value
        elseif operation == "pushContext" then
            need(tag(signature.params[1]) == "int64", member .. ": specialization argument kind")
            need(resultKind == "nil", member .. ": specialization result kind")
            -- Evaluate the key once even though its ordinary result is unused.
            expression(args[1])
        elseif operation == "inInterpreter" then
            need(resultKind == "boolean", member .. ": specialization result kind")
            return {kind = "boolean", value = constant("i8", "1")}
        else
            need(resultKind == "nil", member .. ": specialization result kind")
        end

        return {kind = "nil", value = ""}
    end

    local function intrinsic(intrinsicName: string, args: any, call: any): any
        local function arg(index: number, kind: string): string
            return materialize(expression(need(args[index], intrinsicName .. ": argument " .. tostring(index))), kind)
        end

        if intrinsicName == "sizeOf" or intrinsicName == "alignmentOf" then
            local property = intrinsicName == "sizeOf" and "size" or "alignment"
            return {kind = "uint64", value = constant("i64", nativelayout.constant(call, property))}
        elseif intrinsicName == "fieldOffset" then
            return {kind = "int64", value = constant("i64", nativelayout.fieldOffset(call))}
        elseif intrinsicLoads[intrinsicName] then
            local address = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))
            return {
                kind = intrinsicKinds[intrinsicName],
                value = emit(intrinsicLoads[intrinsicName] .. " notrap " .. address)
            }
        elseif intrinsicStores[intrinsicName] then
            local address = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))
            effect(
                intrinsicStores[
                    intrinsicName
                ] .. " notrap " .. arg(3, intrinsicStoreKinds[intrinsicName]) .. ", " .. address
            )
            return {kind = "nil", value = ""}
        elseif intrinsicUnary[intrinsicName] then
            local spec = intrinsicUnary[intrinsicName]
            return {kind = spec[3], value = emit(spec[1] .. " " .. arg(1, spec[2]))}
        elseif intrinsicIdentity[intrinsicName] then
            local spec = intrinsicIdentity[intrinsicName]
            return {kind = spec[2], value = arg(1, spec[1])}
        elseif intrinsicName == "stackBytes" then
            need(isSupport, "stack scratch belongs to a support function")
            local size = expression(args[1])
            need(size.literal ~= nil, "stack scratch size must be literal")
            local bytes = tonumber(size.literal)
            need(bytes and bytes > 0 and bytes <= 4096 and bytes % 1 == 0, "stack scratch size out of range")
            return {kind = "voidptr", value = emit("stack_addr.i64 " .. declareSlot(bytes as number, 16))}
        elseif intrinsicName == "floatBits" then
            local narrow = emit("fdemote.f32 " .. arg(1, "float64"))
            return {kind = "uint64", value = emit("uextend.i64 " .. emit("bitcast.i32 " .. narrow))}
        elseif intrinsicName == "floatFromBits" then
            local narrow = emit("ireduce.i32 " .. arg(1, "uint64"))
            return {kind = "float64", value = emit("fpromote.f64 " .. emit("bitcast.f32 " .. narrow))}
        elseif intrinsicName == "roundFloat" or intrinsicName == "sqrtFloat" then
            local narrow = emit("fdemote.f32 " .. arg(1, "float64"))
            if intrinsicName == "sqrtFloat" then
                narrow = emit("sqrt " .. narrow)
            end
            return {kind = "float64", value = emit("fpromote.f64 " .. narrow)}
        elseif intrinsicName == "fma" or intrinsicName == "fmaFloat" then
            local a, c, d = arg(1, "float64"), arg(2, "float64"), arg(3, "float64")
            if intrinsicName == "fmaFloat" then
                a, c, d = emit("fdemote.f32 " .. a), emit("fdemote.f32 " .. c), emit("fdemote.f32 " .. d)
            end
            local v = emit("fma " .. a .. ", " .. c .. ", " .. d)
            if intrinsicName == "fmaFloat" then
                v = emit("fpromote.f64 " .. v)
            end
            return {kind = "float64", value = v}
        elseif intrinsicName == "unsignedMulHigh"
            or intrinsicName == "signedMulHigh"
            or intrinsicName == "signedQuotient"
        then
            local unsigned = intrinsicName == "unsignedMulHigh"
            local kind = unsigned and "uint64" or "int64"
            local op = intrinsicName == "signedQuotient" and "sdiv " or (unsigned and "umulhi " or "smulhi ")
            return {
                kind = intrinsicName == "signedQuotient" and "int64" or "uint64",
                value = emit(op .. arg(1, kind) .. ", " .. arg(2, kind))
            }
        elseif intrinsicName == "offset" then
            return {kind = "voidptr", value = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))}
        elseif intrinsicName == "layout" then
            need(handlers and options.layout, "layouts belong to handler modules")
            local field = need(args[1], "layout field")
            need(field.kind == "string", "literal layout field required")
            local text = field.token.value or field.token.text:sub(2, -2)
            return {kind = "int64", value = constant("i64", tostring(options.layout(text)))}
        elseif intrinsicName == "dispatch" or intrinsicName == "reenter" or intrinsicName == "fail" then
            error("lower: " .. intrinsicName .. " is a transfer: `return native." .. intrinsicName .. "(...)`", 0)
        elseif intrinsicName == "both" or intrinsicName == "either" then
            local op = intrinsicName == "both" and "band " or "bor "
            return {kind = "boolean", value = emit(op .. arg(1, "boolean") .. ", " .. arg(2, "boolean"))}
        elseif intrinsicName == "chooseWord" or intrinsicName == "chooseIndex" then
            local kind = intrinsicName == "chooseWord" and "uint64" or "int64"
            return {
                kind = kind,
                value = emit("select " .. arg(1, "boolean") .. ", " .. arg(2, kind) .. ", " .. arg(3, kind))
            }
        end
        error("lower: intrinsic " .. intrinsicName .. " is not part of ordinary code", 0)
    end

    -- A fixed-width identity of `nupp.math`: `i32.wrap` and its siblings, each
    -- one or two operations on the thirty-two bit pattern, and the `u64` bit
    -- counts on the word.
    scalarIntrinsic = function(identity: string, args: any): any
        local family, operation = identity:match("^(%w+)%.(.+)$")
        local kind = family == "u32" and "uint32" or (family == "i32" and "int32" or "uint64")
        need(family == "i32" or family == "u32" or family == "u64", "unsupported scalar intrinsic " .. identity)

        -- An integer argument as a word: an `integer` is a number here, truncated
        -- toward zero as the wrap of a number is.
        local function word(index: number): string
            local e = expression(need(args[index], identity .. ": argument " .. tostring(index)))
            if e.literal then
                return constant("i64", e.literal)
            elseif e.kind == "float64" then
                return emit("fcvt_to_sint_sat.i64 " .. e.value)
            end
            need(machine(e.kind) == "i64", identity .. ": integer argument required")

            return e.value
        end

        if operation == "wrap"
            or operation == "fromU32"
            or operation == "toU32"
            or operation == "fromI32"
            or operation == "toI32"
        then
            local result = kind
            if operation == "toU32" or operation == "fromI32" then
                result = "uint32"
            elseif operation == "toI32" or operation == "fromU32" then
                result = "int32"
            end
            return {kind = result, value = wrap32(result, word(1))}
        elseif operation == "rotateLeft" or operation == "rotateRight" then
            local opName = operation == "rotateLeft" and "rotl " or "rotr "
            if family == "u64" then
                return {kind = kind, value = emit(opName .. word(1) .. ", " .. word(2))}
            end
            local narrow = emit("ireduce.i32 " .. word(1))
            local count = emit("ireduce.i32 " .. word(2))
            return {kind = kind, value = wrap32(kind, emit("uextend.i64 " .. emit(opName .. narrow .. ", " .. count)))}
        elseif operation == "popcount" or operation == "trailingZeros" or operation == "leadingZeros" then
            local opName = operation == "popcount" and "popcnt " or (operation == "trailingZeros" and "ctz " or "clz ")
            if family == "u64" then
                return {kind = "uint64", value = emit(opName .. word(1))}
            end
            local narrow = emit("ireduce.i32 " .. word(1))
            return {kind = "uint32", value = emit("uextend.i64 " .. emit(opName .. narrow))}
        elseif (operation == "div" or operation == "mod") and family == "u32" then
            -- Zero for a zero divisor, as the namespace promises.
            local a, c = word(1), word(2)
            local zero = constant("i64", "0")
            local safe = emit(
                "select " .. emit("icmp eq " .. c .. ", " .. zero) .. ", " .. constant("i64", "1") .. ", " .. c
            )
            local quotient = emit((operation == "div" and "udiv " or "urem ") .. a .. ", " .. safe)
            return {
                kind = "uint32",
                value = emit("select " .. emit("icmp eq " .. c .. ", " .. zero) .. ", " .. zero .. ", " .. quotient)
            }
        end
        error("lower: unsupported scalar intrinsic " .. identity, 0)
    end

    expression = function(n: any): any
        if n.kind == "paren" then
            return expression(n.expr)
        elseif n.kind == "number" then
            return {literal = literalText(n)}
        elseif n.kind == "trueExpr" then
            return {kind = "boolean", value = constant("i8", "1")}
        elseif n.kind == "falseExpr" then
            return {kind = "boolean", value = constant("i8", "0")}
        elseif n.kind == "nilExpr" then
            return {literal = "0"}
        elseif n.kind == "name" and scope.constants[n.token.definition or n.token.text] ~= nil then
            return {literal = scope.constants[n.token.definition or n.token.text]}
        elseif n.kind == "name" then
            local named = n.token.definition or n.token.text
            if inlineBindings ~= nil and inlineBindings[named] ~= nil then
                named = inlineBindings[named]
            end
            if not b.typeOf(named) and scope.functions[n.token.text] then
                -- A module function's name is its address: a function pointer.
                local known = callee(scope.functions[n.token.text] as Fn)
                return {kind = "ptr", value = emit("func_addr.i64 " .. known.ref), type = n.inferredType}
            end
            local variable = variableOf(n.token)
            local value = readVariable(variable, b.here())
            local kind = tag(n.inferredType)
            -- Literal unions introduced by narrowing retain the scalar
            -- representation assigned to this checked declaration.
            if kind == "union" then
                kind = declaredKinds[variable]
            end
            if kind == "missing" or machine(kind) ~= b.typeOf(variable) then
                kind = kindOfVariable(variable)
            end
            -- The checker's type at this read is the narrowed one; the declared
            -- type stands in where a read carries none.
            return {kind = kind, value = value, type = n.inferredType or varDecl[variable]}
        elseif n.kind == "dotIndex"
            and n.obj.kind == "name"
            and n.obj.token.definition ~= nil
            and n.obj.token.definition.requiredModule ~= nil
            and modules[n.obj.token.definition.requiredModule] ~= nil
        then
            local other = modules[n.obj.token.definition.requiredModule] as Scope
            local text = other.exportedConstants[n.name.text]
            need(text ~= nil, "module " .. other.name .. " exports no constant " .. n.name.text)
            return {literal = text}
        elseif n.kind == "dotIndex" then
            local access = fieldAddress(n)
            if access.field.kind == "carray" or access.field.kind == "struct" then
                -- An inline aggregate is its address: a fixed array as a C array
                -- decays, a struct as the memory it is.
                return {kind = access.field.kind, value = access.address, type = access.field.type}
            end
            return {
                kind = loadedKind(access.field.kind),
                value = load(access.field.kind, access.address),
                type = access.field.type
            }
        elseif n.kind == "bracketIndex" then
            local element = elementAddress(n)
            if element.kind == "carray" or element.kind == "struct" then
                return {kind = element.kind, value = element.address, type = element.type}
            end
            return {kind = loadedKind(element.kind), value = load(element.kind, element.address), type = element.type}
        elseif n.kind == "newExpr" then
            -- A struct value: a stack slot of its layout, zeroed, with the fields
            -- the construction names stored into it.
            local call = n.call
            local struct = raw(n.inferredType or call.inferredType or call.signatureType)
            need(struct and struct.tag == "nominal" and struct.declKind == "struct", "new builds a struct here")
            local size, alignment = sizeOf(struct)
            local address = emit("stack_addr.i64 " .. declareSlot(size, alignment))
            zeroBytes(address, size)
            for _, binding in ipairs(call.recordFields or {}) do
                local field = fieldOf(struct, binding.name)
                local initializer = binding.node or binding.defaultValue
                if initializer then
                    local at = emit("iadd " .. address .. ", " .. constant("i64", tostring(field.offset)))
                    storeInto(field.kind, field.type, expression(initializer), at)
                end
            end
            return {kind = "struct", value = address, type = n.inferredType}
        elseif n.kind == "castExpr" then
            -- An erased assertion between types of one representation.
            local inner = expression(n.expr)
            local kind = tag(n.inferredType)
            if inner.literal then
                return {kind = kind, value = materialize(inner, kind), type = n.inferredType}
            end
            if kind == "float64" and isFixed32(inner.kind) then
                return {kind = kind, value = materialize(inner, kind), type = n.inferredType}
            end
            need(machine(inner.kind) == machine(kind), "a cast cannot change representation")
            return {kind = kind, value = inner.value, type = n.inferredType}
        elseif n.kind == "unop" then
            local op = n.op.text
            if op == "-" then
                local operand = expression(n.operand)
                if operand.literal then
                    return {literal = "-" .. operand.literal}
                end
                local opName = operand.kind == "float64" and "fneg" or "ineg"
                local negated = emit(opName .. " " .. operand.value)
                if isFixed32(operand.kind) then
                    negated = wrap32(operand.kind, negated)
                end
                return {kind = operand.kind, value = negated}
            elseif op == "not" then
                local value = condition(n.operand)
                local zero = constant("i8", "0")
                return {kind = "boolean", value = emit("icmp eq " .. value .. ", " .. zero)}
            elseif op == "~" then
                local operand = expression(n.operand)
                local kind = kindOf(n.operand, operand, nil)
                local inverted = emit("bnot " .. materialize(operand, kind))
                if isFixed32(kind) then
                    inverted = wrap32(kind, inverted)
                end
                return {kind = kind, value = inverted}
            end
            error("lower: unsupported unary operator " .. op, 0)
        elseif n.kind == "binop" then
            local op = n.op.text
            if op == "and" or op == "or" then
                return shortCircuit(n, op == "and")
            end
            local lhs = expression(n.lhs)
            local rhs = expression(n.rhs)
            if compareSigned[op] then
                return compare(n, op, lhs, rhs)
            end
            local kind = tag(n.inferredType) == "float64" and "float64" or kindOf(n, lhs, rhs)
            if lhs.literal and rhs.literal then
                kind = tag(n.inferredType) == "missing" and "float64" or tag(n.inferredType)
            end
            return arithmetic(n, op, kind, lhs, rhs)
        elseif isIntrinsicCall(n) then
            return intrinsic(n.obj.name.text, n.args.exprs or {}, n)
        elseif calledModule(n) == lower.PROGRAM then
            return programCall(n)
        elseif calledModule(n) == lower.FRAMES then
            return frameCall(n)
        elseif calledModule(n) == lower.SLOTS then
            return slotCall(n)
        elseif calledModule(n) == lower.SPECIALIZATION then
            return specializationCall(n)
        elseif calledModule(n) == ATOMICS then
            return atomic(n.obj.name.text, n.args.exprs or {})
        elseif calledModule(n) ~= nil and HELPER_MODULES[calledModule(n) as string] ~= nil then
            return helperCall(n, HELPER_MODULES[calledModule(n) as string] as string)
        elseif n.kind == "call" and type(n.scalarIntrinsic) == "string" then
            return scalarIntrinsic(n.scalarIntrinsic, n.args.exprs or {})
        elseif n.kind == "call"
            and n.obj.kind == "dotIndex"
            and n.obj.obj.kind == "name"
            and n.obj.obj.token.text == "math"
            and n.obj.name.text == "floor"
            and not b.typeOf(n.obj.obj.token.definition or "math")
        then
            local argument = need(n.args.exprs and n.args.exprs[1], "math.floor takes a number")
            local operand = expression(argument)
            local kind = kindOf(argument, operand, nil)
            if kind == "int64"
                or kind == "uint64"
                or isFixed32(kind)
                or kind == "int8"
                or kind == "uint8"
                or kind == "int16"
                or kind == "uint16"
            then
                return {kind = kind, value = materialize(operand, kind)}
            end
            need(kind == "float64", "math.floor requires a proven integer or float")
            return {kind = "float64", value = emit("floor " .. materialize(operand, "float64"))}
        elseif n.kind == "call" then
            local target = resolveCallee(n, scope, modules)
            local exprs = n.args.exprs or {}
            if n.ownershipIntrinsic == "borrowFrom" then
                -- The borrow is the checker's fact; the pointer is the value.
                return expression(need(exprs[1], "borrowFrom takes the pointer first"))
            elseif not target
                and n.obj.kind == "name"
                and n.obj.token.text == "error"
                and not b.typeOf(n.obj.token.definition or n.obj.token.text)
            then
                -- `error(...)` ends the function: a trap, since native code has
                -- nothing to raise to. The message is not evaluated.
                need(not handlers, "a handler leaves through native.fail()")
                b.terminate("trap user2")
                return {kind = "nil", value = ""}
            end
            if not target then
                -- A call through a function pointer: the callee is a value, and
                -- the pointer's type says what it takes and answers.
                need(not handlers, "only direct calls to module functions in a handler module")
                local pointer = expression(n.obj)
                local fnType = need(
                    functionPointee(pointer.type),
                    "only direct calls to module functions, or calls through a function pointer"
                )
                need(#exprs == #(fnType.params or {}), "argument count")
                local args = {}
                for index, arg in ipairs(exprs) do
                    args[index] = materialize(expression(arg), tag(fnType.params[index]))
                end
                local sig = declareSignature(signatureOf(fnType))
                local text = "call_indirect " .. sig .. ", " .. materialize(
                    pointer,
                    "ptr"
                ) .. "(" .. table.concat(args, ", ") .. ")"
                local rets = fnType.rets or {}
                local resultKind = #rets == 1 and tag(rets[1]) or nil
                if resultKind and resultKind ~= "nil" then
                    return {kind = resultKind, value = emit(text), type = rets[1]}
                end
                effect(text)
                return {kind = "nil", value = ""}
            end
            if handlers then
                return inlineScalar(target as Fn, n)
            end
            local known = callee(target as Fn)
            local args = {}
            need(#exprs == #target.paramKinds, "argument count")
            for index, arg in ipairs(exprs) do
                args[index] = materialize(expression(arg), target.paramKinds[index])
            end
            local text = "call " .. known.ref .. "(" .. table.concat(args, ", ") .. ")"
            if target.resultKind then
                return {kind = target.resultKind, value = emit(text), type = target.result}
            end
            effect(text)
            return {kind = "nil", value = ""}
        end
        error("lower: unsupported expression " .. tostring(n.kind), 0)
    end

    -- A support function, declared once per caller.
    local supports = {}

    local function supportRef(target: Fn): string
        local known = supports[target]
        if known then
            return known
        end
        local types = {}
        for i, kind in ipairs(target.paramKinds) do
            types[i] = machine(kind)
        end
        types[#types + 1] = "i64"
        local ref = declareFunction(target.name, declareSignature("(" .. table.concat(types, ", ") .. ") -> i64 tail"))
        supports[target] = ref

        return ref
    end

    -- A handler dispatches through the table or returns control to the task
    -- driver after a frame transition or failure.
    local function transfer(transferName: string, args: any): nil
        need(handlers, "transfers belong to handler modules")
        need(b.current, "transfer outside a block")
        if transferName == "reenter" then
            need(#args == 0, "reenter takes no arguments")
            b.finish({constant("i64", "1")})
        elseif transferName == "fail" then
            need(#args == 0, "fail takes no arguments")
            b.finish({constant("i64", "0")})
        else
            need(#args == 6, "dispatch takes the six handler arguments")
            local words = {}
            for index = 1, 5 do
                words[index] = materialize(expression(args[index]), "voidptr")
            end
            local opcode = emit("uload8.i64 notrap " .. words[1])
            local shifted = emit("ishl " .. opcode .. ", " .. constant("i64", "3"))
            local slot = emit("iadd " .. (tableValue as string) .. ", " .. shifted)
            local target = emit("load.i64 notrap " .. slot)
            words[6] = tableValue as string
            b.terminate("return_call_indirect sig0, " .. target .. "(" .. table.concat(words, ", ") .. ")")
        end
    end

    -- Statements. `b.current` is nil after a terminator; code after it in the
    -- same block is unreachable and is refused.
    local loops = {}
    local statements
    local block

    -- A helper is inlined: its parameters become locals bound to the
    -- arguments and its body continues in this function, naming the functions
    -- of the module it was written in.
    local function inlineHelper(target: Fn, call: any): nil
        local helperName = target.name
        need(not inlining[target], "recursive helper " .. helperName)
        local exprs = call.args.exprs or {}
        need(#exprs == #target.paramKinds, "argument count")
        local values = {}
        for index, arg in ipairs(exprs) do
            values[index] = materialize(expression(arg), target.paramKinds[index])
        end
        for index, param in ipairs(target.body.params) do
            local variable = declare(param.name, target.paramKinds[index], param.type and param.type.resolvedType)
            writeVariable(variable, b.here(), values[index])
        end
        inlining[target] = true
        local outer = scope
        scope = target.scope
        block(target.body.body.stats)
        scope = outer
        inlining[target] = nil
    end

    block = function(stats: any): nil
        for _, stat in ipairs(stats) do
            if stat.kind ~= "emptyStmt" then
                need(b.current ~= nil, "unreachable statement")
                statements(stat)
            end
        end
    end

    local function assign(token: any, e: any): nil
        local variable = variableOf(token)
        local kind = kindOfVariable(variable)
        if not e.literal and not (kind == "float64" and isFixed32(e.kind)) then
            need(machine(e.kind) == b.typeOf(variable), "assignment changes representation")
            kind = e.kind
        end
        writeVariable(variable, b.here(), materialize(e, kind))
    end

    -- The function a cleanup names: a function of the module the affine type
    -- was declared in, or, when the key names no module of the set, the one
    -- function of that name any module exports.
    local function cleanupFunction(cleanup: any): Fn
        need(cleanup.kind == "function", "a with-scope cleanup is a module function")
        local origin = cleanup.key and cleanup.key:match("^(.-)#") or nil
        local home = origin and modules[origin] or nil
        local found = home and (home.functions[cleanup.name] or home.exports[cleanup.name]) or nil
        if not found then
            found = scope.functions[cleanup.name]
        end
        if not found then
            for _, other in pairs(modules) do
                local export = other.exports[cleanup.name]
                need(not (found and export), "cleanup " .. tostring(cleanup.name) .. " is exported by two modules")
                found = found or export
            end
        end

        return need(found, "cleanup " .. tostring(cleanup.name) .. " is not a function of the set") as Fn
    end

    -- Releases every `with` value held above `depth`, innermost first, in the
    -- current block.
    local function runCleanups(depth: number): nil
        for index = #cleanups, depth + 1, -1 do
            local held = cleanups[index]
            local fn = cleanupFunction(held.cleanup)
            need(#fn.paramKinds == 1, "a cleanup takes the value it releases")
            local value = materialize(
                {kind = held.kind, value = readVariable(held.variable, b.here())},
                fn.paramKinds[1]
            )
            effect("call " .. callee(fn).ref .. "(" .. value .. ")")
        end
    end

    local function loopBody(bodyBlock: ssa.Block, exit: ssa.Block, continueTo: ssa.Block, stats: any): nil
        loops[#loops + 1] = {exit = exit, continueTo = continueTo, cleanupDepth = #cleanups}
        b.current = bodyBlock
        seal(bodyBlock)
        block(stats)
        loops[#loops] = nil
    end

    -- P1b deletes this checked-syntax path as helper calls become graph
    -- operations. This is only call lowering: no effect or value proof is
    -- inferred here, and the source retains every branch and lane operation.
    inlineScalar = function(target: Fn, call: any): any
        need(not target.isHandler and not target.isSupport, "a handler or support function is tail-called")
        need(not inlining[target], "recursive helper " .. target.name)
        local exprs = call.args.exprs or {}
        need(#exprs == #target.paramKinds, "argument count")
        local arguments = {}
        for index, arg in ipairs(exprs) do
            arguments[index] = materialize(expression(arg), target.paramKinds[index])
        end
        local outerBindings, outerReturn, outerScope = inlineBindings, scalarReturn, scope
        inlineBindings = {}
        local join = newBlock()
        local value = ""
        if target.resultType ~= nil then
            value = addParam(join, target.resultType as string)
        end
        scalarReturn = {join = join, kind = target.resultKind, cleanupDepth = #cleanups}
        scope = target.scope
        inlining[target] = true
        for index, param in ipairs(target.body.params) do
            local variable = declare(param.name, target.paramKinds[index], param.type and param.type.resolvedType)
            writeVariable(variable, b.here(), arguments[index])
        end
        block(target.body.body.stats)
        if b.current ~= nil then
            need(target.resultKind == nil, "scalar helper " .. target.name .. " may not fall through")
            b.jump(join, {})
        end
        inlining[target] = nil
        inlineBindings, scalarReturn, scope = outerBindings, outerReturn, outerScope
        seal(join)
        b.current = join

        return {kind = target.resultKind or "nil", value = value, type = target.result}
    end

    statements = function(stat: any): nil
        local kind = stat.kind
        if kind == "localStmt" then
            local exprs = stat.exprs or {}
            for index, token in ipairs(stat.names) do
                local e = expression(need(exprs[index], "local needs an initializer"))
                local declared = tag(token.inferredType)
                if declared == "missing" then
                    declared = e.literal and "float64" or e.kind
                end
                local variable = declare(token, declared, token.inferredType or e.type)
                writeVariable(variable, b.here(), materialize(e, declared))
            end
        elseif kind == "assignStmt" then
            local values = {}
            for index, e in ipairs(stat.exprs) do
                values[index] = expression(e)
            end
            for index, target in ipairs(stat.targets) do
                local value = need(values[index], "assignment needs a value")
                if target.kind == "dotIndex" then
                    local access = fieldAddress(target)
                    storeInto(access.field.kind, access.field.type, value, access.address)
                elseif target.kind == "bracketIndex" then
                    local element = elementAddress(target)
                    storeInto(element.kind, element.type, value, element.address)
                else
                    need(target.kind == "name", "assignment to a local, a field or an element")
                    assign(target.token, value)
                end
            end
        elseif kind == "compoundAssign" then
            need(stat.target.kind == "name", "compound assignment to a local")
            local op = stat.op.text:sub(1, -2)
            local lhs = expression(stat.target)
            local rhs = expression(stat.value)
            assign(stat.target.token, arithmetic(stat, op, kindOf(stat.target, lhs, rhs), lhs, rhs))
        elseif kind == "callStmt" then
            local call = stat.expr
            local helper = handlers and resolveCallee(call, scope, modules) or nil
            if helper then
                -- A helper answering nothing is inlined where it is called and
                -- continues into the statements after it.
                need(not helper.isHandler and not helper.isSupport, "a handler or slow path is tail-called")
                need(helper.resultKind == nil, "a helper with a result is tail-called")
                inlineScalar(helper, call)
                need(b.current ~= nil, "helper " .. helper.name .. " must continue")
            else
                expression(call)
            end
        elseif kind == "returnStmt" then
            if scalarReturn ~= nil then
                local continuation = scalarReturn
                local results = {}
                if continuation.kind ~= nil then
                    need(#stat.exprs == 1, "scalar helper returns one result")
                    results[1] = materialize(expression(stat.exprs[1]), continuation.kind)
                else
                    need(#stat.exprs == 0, "statement helper returns no result")
                end
                runCleanups(continuation.cleanupDepth)
                b.jump(continuation.join, results)
                return
            end
            local value = stat.exprs[1]
            local transferName = handlers and #stat.exprs == 1 and isIntrinsicCall(value) and value.obj.name.text or nil
            local helper = handlers and #stat.exprs == 1 and resolveCallee(value, scope, modules) or nil
            if transferName == "dispatch" or transferName == "reenter" or transferName == "fail" then
                transfer(transferName, value.args.exprs or {})
            elseif helper and helper.isSupport then
                -- A slow path is its own tail-called function, so the fast
                -- path stays frameless: the Rust helper call lives there.
                local exprs = value.args.exprs or {}
                need(#exprs == #helper.paramKinds, "argument count")
                local words = {}
                for index, arg in ipairs(exprs) do
                    words[index] = materialize(expression(arg), helper.paramKinds[index])
                end
                words[#words + 1] = tableValue as string
                b.terminate("return_call " .. supportRef(helper) .. "(" .. table.concat(words, ", ") .. ")")
            elseif helper then
                need(not helper.isHandler, "a handler is dispatched to, not called")
                inlineHelper(helper, value)
                need(b.current == nil, "helper " .. helper.name .. " may not fall through")
            elseif #stat.exprs == 0 then
                need(resultKind == nil, "result required")
                runCleanups(0)
                b.finish({})
            else
                need(#stat.exprs == 1 and resultKind ~= nil, "one result")
                -- The value is computed before what it may have read is released.
                local value = materialize(expression(stat.exprs[1]), resultKind as string)
                runCleanups(0)
                b.finish({value})
            end
        elseif kind == "doStmt" then
            block(stat.body.stats)
        elseif kind == "ifStmt" then
            local merge = newBlock()
            for _, clause in ipairs(stat.clauses) do
                need(not clause.binding, "binding clauses")
                local taken, otherwise = newBlock(), newBlock()
                branchOn(clause.cond, taken, otherwise)
                b.current = taken
                seal(taken)
                block(clause.body.stats)
                if b.current then
                    b.jump(merge, {})
                end
                b.current = otherwise
                seal(otherwise)
            end
            if stat.elseClause then
                block(stat.elseClause.body.stats)
            end
            if b.current then
                b.jump(merge, {})
            end
            b.current = merge
            seal(merge)
            if #merge.preds == 0 then
                b.current = nil
            end
        elseif kind == "whileStmt" then
            local header, bodyBlock, exit = newBlock(), newBlock(), newBlock()
            b.jump(header, {})
            b.current = header
            branchOn(stat.cond, bodyBlock, exit)
            loopBody(bodyBlock, exit, header, stat.body.stats)
            if b.current then
                b.jump(header, {})
            end
            seal(header)
            b.current = exit
            seal(exit)
        elseif kind == "repeatStmt" then
            local bodyBlock, exit = newBlock(), newBlock()
            b.jump(bodyBlock, {})
            loops[#loops + 1] = {exit = exit, continueTo = bodyBlock, cleanupDepth = #cleanups}
            b.current = bodyBlock
            block(stat.body.stats)
            loops[#loops] = nil
            if b.current then
                branchOn(stat.cond, exit, bodyBlock)
            end
            seal(bodyBlock)
            b.current = exit
            seal(exit)
        elseif kind == "fornumStmt" then
            local var = stat.var
            local loopKind = tag(var.inferredType)
            local start = expression(stat.start)
            local stop = expression(stat.stop)
            if loopKind == "missing" then
                loopKind = kindOf(stat.start, start, stop)
            end
            local step = "1"
            local descending = false
            if stat.step then
                local s = expression(stat.step)
                need(s.literal, "loop step must be a literal")
                step = s.literal
                descending = step:sub(1, 1) == "-"
            end
            local counter = {}
            b.declare(counter, machine(loopKind))
            local iterator = declare(var, loopKind, var.inferredType)
            writeVariable(counter, b.here(), materialize(start, loopKind))
            local limit = materialize(stop, loopKind)
            local header, bodyBlock, advance, exit = newBlock(), newBlock(), newBlock(), newBlock()
            b.jump(header, {})
            b.current = header
            local value = readVariable(counter, header)
            local op = descending and ">=" or "<="
            local cond = compare({lhs = stat.start}, op, {kind = loopKind, value = value}, {
                kind = loopKind,
                value = limit
            })
            b.branch(cond.value, bodyBlock, exit)
            b.current = bodyBlock
            seal(bodyBlock)
            writeVariable(iterator, bodyBlock, readVariable(counter, bodyBlock))
            loops[#loops + 1] = {exit = exit, continueTo = advance, cleanupDepth = #cleanups}
            block(stat.body.stats)
            loops[#loops] = nil
            if b.current then
                b.jump(advance, {})
            end
            b.current = advance
            seal(advance)
            local next = arithmetic(stat, "+", loopKind, {kind = loopKind, value = readVariable(counter, advance)}, {
                literal = step
            })
            writeVariable(counter, advance, next.value)
            b.jump(header, {})
            seal(header)
            b.current = exit
            seal(exit)
        elseif kind == "pragmaStmt" then
            -- `@unsafe` and its kin are the checker's business; the statement
            -- underneath lowers as itself.
            if stat.stat then
                statements(stat.stat)
            end
        elseif kind == "breakStmt" then
            local loop = need(loops[#loops], "break outside a loop")
            runCleanups(loop.cleanupDepth)
            b.jump(loop.exit, {})
        elseif kind == "continueStmt" then
            local loop = need(loops[#loops], "continue outside a loop")
            runCleanups(loop.cleanupDepth)
            b.jump(loop.continueTo, {})
        elseif kind == "withStmt" then
            -- Each acquisition is held for the body and released at every way
            -- out of it, right to left.
            local depth = #cleanups
            for _, binding in ipairs(stat.bindings or {}) do
                local acquired = expression(binding.expr)
                local held = tag(binding.acquiredType)
                local variable = declare(binding.name, held, binding.acquiredType)
                writeVariable(variable, b.here(), materialize(acquired, held))
                for index = #(binding.ownerCleanups or {}), 1, -1 do
                    cleanups[#cleanups + 1] = {variable = variable, kind = held, cleanup = binding.ownerCleanups[index]}
                end
            end
            block(stat.body.stats)
            if b.current then
                runCleanups(depth)
            end
            while #cleanups > depth do
                cleanups[#cleanups] = nil
            end
        else
            error("lower: unsupported statement " .. tostring(kind), 0)
        end
    end

    local values = {}
    local entry = b.here()
    need(not handlers or isHandler or isSupport, "a helper is compiled where it is tail-called")
    for index, param in ipairs(body.params) do
        local value = addParam(entry, paramTypes[index])
        local variable = declare(param.name, paramKinds[index], param.type and param.type.resolvedType)
        if isHandler and index == 6 then
            -- The sixth register carries the dispatch table; the frame is
            -- thirty-two bytes below the boxed window.
            tableValue = value
            value = emit("iadd " .. values[2] .. ", " .. constant("i64", "-32"))
        end
        values[index] = value
        writeVariable(variable, entry, value)
    end
    if isSupport then
        -- A support function carries the dispatch table after its own
        -- parameters.
        tableValue = addParam(entry, "i64")
    end
    block(body.body.stats)
    if b.current then
        need(resultKind == nil, "function " .. name .. " may fall through without a result")
        b.finish({})
    end

    local signature = "(" .. table.concat(paramTypes, ", ") .. ")"
    if resultType then
        signature = signature .. " -> " .. resultType
    end
    if isSupport then
        local types = {}
        for i, t in ipairs(paramTypes) do
            types[i] = t
        end
        types[#types + 1] = "i64"
        signature = "(" .. table.concat(types, ", ") .. ") -> i64"
    end
    if options.allocator then
        signature = signature .. " tail"
    end
    if isHandler or isSupport then
        signature = signature .. " tail"
        table.insert(preamble, 1, "sig0 = (i64, i64, i64, i64, i64, i64) -> i64 tail")
    end

    return b.print(name, signature, preamble)
end

-- The structure offsets a handler names come from the runtime's glue
-- (`nupp-vm native layouts`), which measures the layouts it links against.
local function layouts(path: string): function(string): number
    local offsets: any = json.decode(assert(fs.readFile(path)))
    return function(field: string): number
        local offset = offsets[field]
        need(type(offset) == "number", "unknown context field " .. field)
        return offset as number
    end
end

-- The function record of one `local function` or exported function.
local function describe(fnName: string, node: any, body: any, scope: Scope, handlers: boolean): Fn
    local paramKinds, paramTypes = {}, {}
    for index, param in ipairs(body.params) do
        paramKinds[index] = tag(param.type and param.type.resolvedType)
        paramTypes[index] = machine(paramKinds[index])
    end
    local rets = body.signatureType and body.signatureType.rets or {}
    need(#rets <= 1, "at most one result")
    local resultKind = #rets == 1 and tag(rets[1]) or nil
    if resultKind == "nil" then
        resultKind = nil
    end
    need(resultKind ~= "struct", fnName .. ": a struct value lives where it was built; answer a pointer to it")
    local isHandler = handlers and #paramKinds == 6 and resultKind == "uint64"
    for _, kind in ipairs(paramKinds) do
        if kind ~= "voidptr" then
            isHandler = false
        end
    end
    -- A helper named `...Slow` is a support function: compiled on its own and
    -- tail-called, so the handlers that reach it stay frameless while it
    -- calls Rust.
    local isSupport = handlers and not isHandler and fnName:match("Slow$") ~= nil
    if isSupport then
        -- Its parameters are the pc, the context and its own, so a tail call
        -- to it fits in argument registers; it derives its windows from the
        -- context when it continues.
        need(
            #paramKinds >= 2 and paramKinds[1] == "voidptr" and paramKinds[2] == "voidptr" and resultKind == "uint64",
            "a slow path takes the pc and the context first"
        )
    end

    return new Fn(
        name = fnName,
        node = node,
        body = body,
        scope = scope,
        paramKinds = paramKinds,
        paramTypes = paramTypes,
        resultKind = resultKind,
        resultType = resultKind and machine(resultKind) or nil,
        result = rets[1],
        isHandler = isHandler,
        isSupport = isSupport
    )
end

-- One module's functions, from its checked tree. Requires are validated once
-- every module of the set is known.
local function describeModule(parsed: any, path: string, handlers: boolean): (Scope, {any})
    local scope = new Scope(
        name = "",
        path = path,
        functions = {},
        exports = {},
        constants = {},
        exportedConstants = {},
        order = {}
    )
    local requires = {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local node: any = stat
            if node.kind == "moduleStmt" then
                local names = {}
                for index, token in ipairs(node.names) do
                    names[index] = token.text
                end
                scope.name = table.concat(names, ".")
            elseif node.kind == "localStmt"
                and node.isConst
                and #node.names == 1
                and #node.exprs == 1
                and node.exprs[1].kind == "number"
            then
                -- A named constant: every use is the literal.
                scope.constants[node.names[1].definition or node.names[1].text] = literalText(node.exprs[1])
            elseif node.kind == "exportStmt" and node.stat ~= nil and node.stat.kind == "localStmt" then
                local declared = node.stat
                need(
                    declared.isConst
                    and #declared.names == 1
                    and #declared.exprs == 1
                    and declared.exprs[1].kind == "number",
                    "an exported module-level value is a numeric constant"
                )
                local text = literalText(declared.exprs[1])
                scope.constants[declared.names[1].definition or declared.names[1].text] = text
                scope.exportedConstants[declared.names[1].text] = text
            elseif node.kind == "exportStmt"
                and node.stat ~= nil
                and (node.stat.kind == "recordDecl" or node.stat.kind == "typeAlias")
            then
                -- An exported struct or type is the checker's business; nothing of
                -- it is native code.
            elseif node.kind == "localFuncStmt" or node.kind == "exportStmt" then
                local declared = node.kind == "exportStmt" and node.stat or node
                local exported = node.kind == "exportStmt"
                need(
                    declared ~= nil
                    and (
                        declared.kind == "localFuncStmt"
                        or (declared.kind == "funcStmt" and declared.name.base ~= nil and #declared.name == 1)
                    ),
                    "a module-level declaration is a function"
                )
                local fnName: string = declared.kind == "funcStmt" and declared.name.base.text or declared.name.text
                need(scope.functions[fnName] == nil, "function " .. fnName .. " defined twice")
                local fn = describe(
                    fnName,
                    declared,
                    declared.body,
                    scope,
                    handlers and not allocatorModule(scope.name)
                )
                scope.functions[fnName] = fn
                if exported then
                    scope.exports[fnName] = fn
                end
                scope.order[#scope.order + 1] = fnName
            elseif node.kind == "localStmt" then
                need(
                    #node.names == 1 and #node.exprs == 1 and node.isConst,
                    "a module-level local is a `const` require or a numeric constant"
                )
                local definition = node.names[1].definition
                need(definition and definition.requiredModule, "module initialization is not native code")
                requires[#requires + 1] = definition.requiredModule
            elseif node.kind ~= "emptyStmt" and node.kind ~= "recordDecl" and node.kind ~= "typeAlias" then
                error("lower: unsupported top-level statement " .. tostring(node.kind), 0)
            end
        end
    end
    need(scope.name ~= "", "module statement required in " .. path)

    return scope, requires
end

--- Compiles a set of modules to one CLIF file.
---
--- `root` is the project root; `options.include` names its include roots
--- (`{"src"}` by default). In handler mode (`options.handlers`), every
--- handler and support function compiles; `options.layouts` names the glue's
--- layout file. Otherwise every function compiles.
--- @raises string when the source does not check or the lowering refuses it.
function lower.compile(root: string, paths: {string}, options: any?): string
    local settings: any = options or {}
    local variantCap = settings.specializationVariantCap
    if variantCap == nil then
        variantCap = 256
    end
    -- Validate the configured limit even in a module without a bounded call.
    specializationcontract.domain("0", "0", variantCap)
    local handlers = settings.handlers == true
    need(not handlers or settings.layouts ~= nil, "handler modules need the glue's layout file")
    trivia.installDefault(provider)
    local env = environment.new(root, {cache = false, config = {include = settings.include or {"src"}}})
    local modules: {[string]: Scope} = {}
    local scopes: {Scope} = {}
    local pending = {}
    for _, path in ipairs(paths) do
        local parsed = parser.parse(assert(fs.readFile(path)), path)
        need(#parsed.errors == 0, "parse failed: " .. path)
        local diagnostics = checker.check(parsed, path, env as any, {})
        for _, diagnostic in ipairs(diagnostics) do
            if diagnostic.severity == "error" or not diagnostic.severity then
                error(tostring(diagnostic.code) .. ": " .. tostring(diagnostic.msg), 0)
            end
        end
        local scope, requires = describeModule(parsed, path, handlers)
        need(modules[scope.name] == nil, "module " .. scope.name .. " compiled twice")
        modules[scope.name] = scope
        scopes[#scopes + 1] = scope
        pending[#pending + 1] = {scope = scope, requires = requires}
    end
    for _, entry in ipairs(pending) do
        for _, required in ipairs(entry.requires) do
            need(
                required == INTRINSICS
                or required == lower.PROGRAM
                or required == lower.SLOTS
                or required == lower.FRAMES
                or required == lower.SPECIALIZATION
                or required == ATOMICS
                or HELPER_MODULES[required] ~= nil
                or modules[required] ~= nil,
                entry.scope.name .. " requires " .. required .. ", which is not native code"
            )
        end
    end
    -- Every compiled function is one CLIF function, so the names of what
    -- compiles must be unique across the set.
    local compiled: {Fn} = {}
    local seen = {}
    for _, scope in ipairs(scopes) do
        for _, fnName in ipairs(scope.order) do
            local fn = scope.functions[fnName] as Fn
            if not handlers
                or allocatorModule(scope.name)
                or fn.isHandler
                or fn.isSupport
                or nativegraph.admits(fn)
            then
                need(seen[fnName] == nil, "function " .. fnName .. " compiled from two modules")
                seen[fnName] = true
                compiled[#compiled + 1] = fn
            end
        end
    end
    need(#compiled > 0, "no functions")
    local functionOptions = {
        handlers = handlers,
        layout = handlers and layouts(settings.layouts as string) or nil,
        specializationVariantCap = variantCap,
        modules = modules,
        helperModules = lower.HELPER_MODULES
    }
    local text = {}
    local allocatorNames = {}
    for index, fn in ipairs(compiled) do
        if (handlers or nativegraph.isLeaf(fn)) and nativegraph.admits(fn) then
            local g = nativegraph.compile(fn, functionOptions)
            graph.verify(g)
            graph.prune(g)
            graph.verify(g)
            text[index] = clifgraph.emit(g, {
                name = fn.name,
                layout = functionOptions.layout,
                helperModules = functionOptions.helperModules,
                modules = functionOptions.modules
            })
        elseif handlers and allocatorModule(fn.scope.name) then
            allocatorNames[#allocatorNames + 1] = fn.name
            text[index] = compileDirectFunction(fn, {
                handlers = false,
                allocator = true,
                modules = modules,
                helperModules = lower.HELPER_MODULES,
                specializationVariantCap = variantCap
            })
        else
            text[index] = compileDirectFunction(fn, functionOptions)
        end
    end

    local simd = modules["nupp.runtime.vm.simd"]
    local abi = handlers and simd and simd.exportedConstants.OPERATION_ABI
    local prefix = abi and "; Nupp SIMD ABI: " .. abi .. "\n" or ""

    if #allocatorNames > 0 then
        prefix = "; Nupp allocator support: " .. table.concat(allocatorNames, ",") .. "\n" .. prefix
    end

    return prefix .. table.concat(text, "\n")
end

--- Compiles the native core: the runtime modules in handler mode against the
--- glue's layout file, answering the CLIF text.
--- @raises string when the source does not check or the lowering refuses it.
function lower.compileRuntime(root: string, layoutsPath: string): string
    local paths = {}
    for index, relative in ipairs(lower.RUNTIME_MODULES) do
        paths[index] = fs.join(root, relative)
    end

    return lower.compile(root, paths, {handlers = true, layouts = layoutsPath, include = {"src"}})
end

export = lower
