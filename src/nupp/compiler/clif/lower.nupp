module nupp.compiler.clif.lower

--[[
Lowers ordinary typed Nupp to Cranelift's textual IR (CLIF): the scalar types,
mutable locals, branches, loops, direct calls, struct fields through raw
pointers at the compiler's own layout offsets, and the memory intrinsics, with
nothing managed underneath. The ordinary parser and checker validate the
source; this module turns the checked tree into CLIF, building SSA form through
`nupp.compiler.clif.ssa`, and the runtime's glue parses and compiles the text.

A set of modules compiles to one CLIF file. A module's `export function`s
are what the others call, through a `const` require of it; a require of the
intrinsics declaration is the only other module-level statement.

Handler mode compiles the native interpreter core. A handler takes six pointer
registers and answers a word; its sixth register is the dispatch table and its
frame is derived from the boxed window. Helpers are inlined where a handler
tail-calls them, or where a statement calls one answering nothing, so every
handler stays one frameless function. A helper named `...Slow` is a support
function: compiled on its own and tail-called with the pc, the context, up to
five words of its own and the table, so the fast path stays frameless while the
slow path calls the Rust helpers.
]]

local parser = require("nupp.compiler.syntax.parser")
local checker = require("nupp.compiler.check")
local environment = require("nupp.compiler.project.env")
local fs = require("nupp.compiler.fs")
local trivia = require("nupp.compiler.syntax.triviaarena")
local provider = require("nupp.compiler.syntax.triviaarena.table")
local targetLayout = require("nupp.compiler.targetlayout")
local ssa = require("nupp.compiler.clif.ssa")
local json = require("nupp.codec.json")

local lower = {}

--- The intrinsics declaration the runtime sources are written against.
lower.INTRINSICS = "nupp.runtime.vm.intrinsics"

--- The declarations of what the runtime exports to native code, by C ABI,
--- and the symbol prefix each declares under: a member `name` of the module
--- is the symbol `<prefix><name in snake case>`, with the kinds its declared
--- signature says. `helpers` are the interpreter's Rust helpers; `os` the
--- operating-system edges (pages, threads, files).
lower.HELPER_MODULES = {["nupp.runtime.vm.helpers"] = "nupp_rt_", ["nupp.runtime.vm.os"] = "nupp_os_"}

--- The native core's modules, in the order they compile, relative to the
--- repository root.
lower.RUNTIME_MODULES = {
    "src/nupp/runtime/vm/core.nupp",
    "src/nupp/runtime/vm/calls.nupp",
    "src/nupp/runtime/vm/protocol.nupp",
    "src/nupp/runtime/vm/lookup.nupp",
    "src/nupp/runtime/vm/boxing.nupp"
}

local INTRINSICS = lower.INTRINSICS
local HELPER_MODULES: {[string]: string} = lower.HELPER_MODULES

-- `getIndexNum` under `nupp_rt_` is `nupp_rt_get_index_num`.
local function helperSymbol(prefix: string, member: string): string
    return prefix .. member:gsub("%u", function(letter: string): string
        return "_" .. letter:lower()
    end)
end

local function need(ok: any, message: string): any
    assert(ok, "lower: " .. message)
    return ok
end

-- A nullable pointer is a union with nil; the pointer is the representation.
local function nonnil(t: any): any
    if t and t.tag == "union" and t.hasNil then
        local rest = nil
        for _, member in ipairs(t.members) do
            if member.tag ~= "nil" then
                if rest then
                    return t
                end
                rest = member
            end
        end
        return rest or t
    end

    return t
end

-- Wrappers that change what the checker knows, not the representation.
local wrappers = {literal = "base", const = "inner", borrowed = "inner", pinned = "inner", affine = "inner"}

local function tag(t: any): string
    t = nonnil(t)
    while t and wrappers[t.tag] do
        t = nonnil(t[wrappers[t.tag]])
    end
    local kind = t and t.tag or "missing"
    -- An integer-valued number is a number here: the refinement changes no
    -- representation.

    return kind == "integer" and "number" or kind
end

-- The type under literal and const wrappers.
local function raw(t: any): any
    t = nonnil(t)
    while t and wrappers[t.tag] do
        t = nonnil(t[wrappers[t.tag]])
    end

    return t
end

-- The struct a pointer type points at, when it does.
local function pointee(t: any): any
    t = raw(t)
    if t and t.tag == "ptr" then
        local elem = raw(t.elem)
        if elem and elem.tag == "nominal" and elem.declKind == "struct" then
            return elem
        end
    end

    return nil
end

-- Field offsets come from the compiler's own layout model for the host.
local layoutKey = targetLayout.hostKey() or "aarch64-apple-darwin"
local fieldCache = {}

local function fieldOf(struct: any, member: string): any
    local fields = fieldCache[struct]
    if not fields then
        local measured, reason = targetLayout.of(struct, layoutKey)
        need(measured ~= nil, "struct layout: " .. tostring(reason))
        fields = {}
        for _, field in ipairs(measured.fields) do
            fields[field.name] = field
        end
        fieldCache[struct] = fields
    end
    local field = need(fields[member], "unknown field " .. member)
    need(not field.bitWidth, "bitfields")

    return {offset = field.offset, kind = tag(struct.byname[member]), type = struct.byname[member]}
end

-- The machine type of a scalar Nupp type.
local function machine(kind: string): string
    if kind == "int64"
        or kind == "uint64"
        or kind == "voidptr"
        or kind == "ptr"
        or kind == "int32"
        or kind == "uint32"
    then
        return "i64"
    elseif kind == "number" then
        return "f64"
    elseif kind == "boolean" then
        return "i8"
    end
    error("lower: unsupported type " .. kind, 0)
end

-- A double as CLIF spells it: a hexadecimal significand and a binary exponent.
local function hexFloat(x: number): string
    if x ~= x then
        return "NaN"
    elseif x == math.huge then
        return "Inf"
    elseif x == -math.huge then
        return "-Inf"
    elseif x == 0 then
        return (1 / x < 0) and "-0.0" or "0.0"
    end
    local sign = ""
    if x < 0 then
        sign = "-"
        x = -x
    end
    local m, e = math.frexp(x)
    local significand = m * 9007199254740992 -- 2^53, exact
    local digits = {}
    for _ = 1, 14 do
        local digit = significand % 16
        digits[#digits + 1] = ("0123456789abcdef"):sub(digit + 1, digit + 1)
        significand = (significand - digit) / 16
    end
    -- The leading digit of a normalized significand is 1; the radix point
    -- after it is what makes the text a float to the reader.
    local text = {}
    for index = #digits - 1, 1, -1 do
        text[#text + 1] = digits[index]
    end

    return sign .. "0x" .. digits[#digits] .. "." .. table.concat(text) .. "p" .. tostring(e - 1)
end

local compareSigned = {["<"] = "slt", ["<="] = "sle", [">"] = "sgt", [">="] = "sge", ["=="] = "eq", ["~="] = "ne"}
local compareUnsigned = {["<"] = "ult", ["<="] = "ule", [">"] = "ugt", [">="] = "uge", ["=="] = "eq", ["~="] = "ne"}
local compareFloat = {["<"] = "lt", ["<="] = "le", [">"] = "gt", [">="] = "ge", ["=="] = "eq", ["~="] = "ne"}
local integerOps = {
    ["+"] = "iadd",
    ["-"] = "isub",
    ["*"] = "imul",
    ["&"] = "band",
    ["|"] = "bor",
    ["~"] = "bxor",
    ["<<"] = "ishl"
}
local floatOps = {["+"] = "fadd", ["-"] = "fsub", ["*"] = "fmul", ["/"] = "fdiv"}

-- The private memory intrinsics the handler modules are written against, so
-- that profile is a subset of this one.
local intrinsicLoads = {
    load8 = "uload8.i64",
    load32 = "sload32.i64",
    load64 = "load.i64",
    loadIndex = "load.i64",
    loadPointer = "load.i64",
    loadFloat = "load.f64"
}
local intrinsicKinds = {
    load8 = "int64",
    load32 = "int64",
    load64 = "uint64",
    loadIndex = "int64",
    loadPointer = "voidptr",
    loadFloat = "number"
}
local intrinsicStores = {
    store64 = "store",
    storeIndex = "store",
    storePointer = "store",
    storeFloat = "store",
    store32 = "istore32"
}
local intrinsicStoreKinds = {
    store64 = "uint64",
    storeIndex = "int64",
    storePointer = "voidptr",
    storeFloat = "number",
    store32 = "int64"
}
local intrinsicUnary = {
    bits = {"bitcast.i64", "number", "uint64"},
    fromBits = {"bitcast.f64", "uint64", "number"},
    floor = {"floor", "number", "number"},
    neg = {"fneg", "number", "number"},
    toFloat = {"fcvt_from_sint.f64", "int64", "number"},
    toInt = {"fcvt_to_sint_sat.i64", "number", "int64"},
    unsignedFloat = {"fcvt_from_uint.f64", "uint64", "number"},
    unsignedInt = {"fcvt_to_uint_sat.i64", "number", "uint64"},
    asWord = {"uextend.i64", "boolean", "uint64"}
}
local intrinsicIdentity = {
    pointer = {"uint64", "voidptr"},
    address = {"voidptr", "uint64"},
    word = {"int64", "uint64"},
    index = {"uint64", "int64"}
}

-- A function of a module: its node, its kinds, and the module it belongs to,
-- whose functions its body names.
local record Fn
    name: string
    node: any
    body: any
    scope: any
    paramKinds: {string}
    paramTypes: {string}
    resultKind: string?
    resultType: string?
    isHandler: boolean
    isSupport: boolean
end

-- A module of the set: its functions by name, the exported ones by member.
local record Scope
    name: string
    path: string
    functions: {[string]: Fn}
    exports: {[string]: Fn}
    order: {string}
end

-- Whether a call names a module function: a local function of the module
-- the code was written in, or a member of another module's export table.
local function resolveCallee(call: any, scope: Scope, modules: {[string]: Scope}): Fn?
    if call.kind ~= "call" then
        return nil
    end
    local target = call.obj
    if target.kind == "name" then
        return scope.functions[target.token.text]
    elseif target.kind == "dotIndex" and target.obj.kind == "name" then
        local definition = target.obj.token.definition
        local required = definition and definition.requiredModule
        local other = required and modules[required]
        if other then
            return need(other.exports[target.name.text], "module " .. required .. " exports no " .. target.name.text)
        end
    end

    return nil
end

local function compileFunction(fn: Fn, options: any): string
    local body = fn.body
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain function required")
    local name = fn.name
    local modules: {[string]: Scope} = options.modules
    -- The module whose functions a name resolves in: the function's own, or
    -- the helper's while a helper from another module is inlined.
    local scope: Scope = fn.scope
    local handlers = options.handlers == true
    local isHandler = fn.isHandler
    local isSupport = fn.isSupport
    local tableValue: string? = nil
    local inlining = {}
    local paramKinds, paramTypes = fn.paramKinds, fn.paramTypes
    local resultKind, resultType = fn.resultKind, fn.resultType

    local b = ssa.new()
    local emit, effect, constant = b.emit, b.effect, b.constant
    local newBlock, addParam, seal = b.newBlock, b.addParam, b.seal
    local readVariable, writeVariable = b.read, b.write
    local varDecl = {}

    local function declare(token: any, kind: string, declared: any): any
        local variable = token.definition or token.text
        b.declare(variable, machine(kind))
        varDecl[variable] = declared
        return variable
    end

    local function variableOf(token: any): any
        local variable = token.definition or token.text
        need(b.typeOf(variable), "unknown variable " .. tostring(token.text))
        return variable
    end

    -- The scalar kind a variable's machine type reads back as when the
    -- checker's type says nothing more.
    local function kindOfVariable(variable: any): string
        local t = b.typeOf(variable)
        return t == "f64" and "number" or (t == "i8" and "boolean" or "int64")
    end

    -- Callees are declared once per function in the preamble.
    local callees, preamble = {}, {}

    local function callee(target: Fn): any
        local known = callees[target]
        if known then
            return known
        end
        need(not handlers, "a handler module's functions are tail-called: `return " .. target.name .. "(...)`")
        local index = #preamble / 2
        local sig = "sig" .. tostring(index)
        local ref = "fn" .. tostring(index)
        local signature = "(" .. table.concat(target.paramTypes, ", ") .. ")"
        if target.resultType then
            signature = signature .. " -> " .. target.resultType
        end
        preamble[#preamble + 1] = sig .. " = " .. signature
        preamble[#preamble + 1] = ref .. " = %" .. target.name .. " " .. sig
        known = {ref = ref, target = target}
        callees[target] = known

        return known
    end

    -- Expressions answer a typed value, or a literal still free to take the
    -- type its context asks for.
    local expression

    local function literalText(n: any): string
        return (n.token.text:gsub("[Uu]?[Ll][Ll]$", ""))
    end

    local function materialize(e: any, kind: string): string
        if e.literal then
            if kind == "number" then
                return emit("f64const " .. hexFloat(tonumber(e.literal) as number))
            elseif kind == "boolean" then
                error("lower: a number is not a boolean", 0)
            end
            return constant("i64", e.literal)
        end
        need(
            e.kind == kind or (machine(e.kind) == machine(kind)),
            "expected " .. kind .. ", found " .. tostring(e.kind)
        )

        return e.value
    end

    -- A memory access of one field or intrinsic width.
    local function load(kind: string, address: string): string
        if kind == "number" then
            return emit("load.f64 notrap " .. address)
        elseif kind == "boolean" then
            return emit("load.i8 notrap " .. address)
        elseif kind == "int32" then
            return emit("sload32.i64 notrap " .. address)
        elseif kind == "uint32" then
            return emit("uload32.i64 notrap " .. address)
        end

        return emit("load.i64 notrap " .. address)
    end

    local function store(kind: string, value: string, address: string): nil
        if kind == "int32" or kind == "uint32" then
            effect("istore32 notrap " .. value .. ", " .. address)
        else
            effect("store notrap " .. value .. ", " .. address)
        end
    end

    local fieldAddress

    local function kindOf(n: any, e: any, other: any): string
        if not e.literal then
            return e.kind
        elseif other and not other.literal then
            return other.kind
        end
        local inferred = tag(n.inferredType)

        return inferred == "missing" and "number" or inferred
    end

    local function condition(n: any): string
        return materialize(expression(n), "boolean")
    end

    -- A condition in branch position: `and`, `or`, `not` and the `both` and
    -- `either` intrinsics branch directly through their operands, so the
    -- common path pays one compare and one branch per operand rather than
    -- materializing every flag.
    local branchOn

    -- The module a call reaches into through a required binding, if any.
    local function calledModule(n: any): string?
        if n.kind == "call"
            and n.obj.kind == "dotIndex"
            and n.obj.obj.kind == "name"
            and n.obj.obj.token.definition ~= nil
        then
            return n.obj.obj.token.definition.requiredModule
        end

        return nil
    end

    local function isIntrinsicCall(n: any): boolean
        return calledModule(n) == INTRINSICS
    end

    local function isIntrinsic(n: any, intrinsicName: string): boolean
        return isIntrinsicCall(n) and n.obj.name.text == intrinsicName and #(n.args.exprs or {}) == 2
    end

    branchOn = function(n: any, yes: ssa.Block, no: ssa.Block): nil
        if n.kind == "paren" then
            branchOn(n.expr, yes, no)
        elseif (n.kind == "binop" and n.op.text == "and") or isIntrinsic(n, "both") then
            local lhs = n.kind == "binop" and n.lhs or n.args.exprs[1]
            local rhs = n.kind == "binop" and n.rhs or n.args.exprs[2]
            local rest = newBlock()
            branchOn(lhs, rest, no)
            b.current = rest
            seal(rest)
            branchOn(rhs, yes, no)
        elseif (n.kind == "binop" and n.op.text == "or") or isIntrinsic(n, "either") then
            local lhs = n.kind == "binop" and n.lhs or n.args.exprs[1]
            local rhs = n.kind == "binop" and n.rhs or n.args.exprs[2]
            local rest = newBlock()
            branchOn(lhs, yes, rest)
            b.current = rest
            seal(rest)
            branchOn(rhs, yes, no)
        elseif n.kind == "unop" and n.op.text == "not" then
            branchOn(n.operand, no, yes)
        else
            b.branch(condition(n), yes, no)
        end
    end

    local function arithmetic(n: any, op: string, kind: string, lhs: any, rhs: any): any
        local a, c = materialize(lhs, kind), materialize(rhs, kind)
        if kind == "number" then
            if op == "%" then
                local quotient = emit("fdiv " .. a .. ", " .. c)
                local floored = emit("floor " .. quotient)
                local product = emit("fmul " .. floored .. ", " .. c)
                return {kind = kind, value = emit("fsub " .. a .. ", " .. product)}
            end
            local opName = need(floatOps[op], "unsupported float operator " .. op)
            return {kind = kind, value = emit(opName .. " " .. a .. ", " .. c)}
        end
        local unsigned = kind == "uint64"
        if op == ">>" then
            return {kind = kind, value = emit("ushr " .. a .. ", " .. c)}
        elseif op == "~>>" then
            return {kind = kind, value = emit("sshr " .. a .. ", " .. c)}
        elseif op == "//" then
            if unsigned then
                return {kind = kind, value = emit("udiv " .. a .. ", " .. c)}
            end
            -- Floored division: the truncated quotient, less one when the
            -- remainder is nonzero and disagrees in sign with the divisor.
            local quotient = emit("sdiv " .. a .. ", " .. c)
            local remainder = emit("srem " .. a .. ", " .. c)
            local zero = constant("i64", "0")
            local nonzero = emit("icmp ne " .. remainder .. ", " .. zero)
            local mixed = emit("bxor " .. remainder .. ", " .. c)
            local negative = emit("icmp slt " .. mixed .. ", " .. zero)
            local adjust = emit("band " .. nonzero .. ", " .. negative)
            local wide = emit("uextend.i64 " .. adjust)
            return {kind = kind, value = emit("isub " .. quotient .. ", " .. wide)}
        elseif op == "%" then
            if unsigned then
                return {kind = kind, value = emit("urem " .. a .. ", " .. c)}
            end
            local remainder = emit("srem " .. a .. ", " .. c)
            local zero = constant("i64", "0")
            local nonzero = emit("icmp ne " .. remainder .. ", " .. zero)
            local mixed = emit("bxor " .. remainder .. ", " .. c)
            local negative = emit("icmp slt " .. mixed .. ", " .. zero)
            local adjust = emit("band " .. nonzero .. ", " .. negative)
            local wide = emit("uextend.i64 " .. adjust)
            local mask = emit("ineg " .. wide)
            local addend = emit("band " .. c .. ", " .. mask)
            return {kind = kind, value = emit("iadd " .. remainder .. ", " .. addend)}
        end
        local opName = need(integerOps[op], "unsupported integer operator " .. op)

        return {kind = kind, value = emit(opName .. " " .. a .. ", " .. c)}
    end

    local function compare(n: any, op: string, lhs: any, rhs: any): any
        local kind = kindOf(n.lhs, lhs, rhs)
        local a, c = materialize(lhs, kind), materialize(rhs, kind)
        local text: string
        if kind == "number" then
            text = "fcmp " .. compareFloat[op]
        elseif kind == "uint64" or kind == "uint32" or kind == "voidptr" or kind == "ptr" then
            text = "icmp " .. compareUnsigned[op]
        elseif kind == "boolean" then
            need(op == "==" or op == "~=", "ordered comparison of booleans")
            text = "icmp " .. compareSigned[op]
        else
            text = "icmp " .. compareSigned[op]
        end

        return {kind = "boolean", value = emit(text .. " " .. a .. ", " .. c)}
    end

    local function shortCircuit(n: any, isAnd: boolean): any
        local left = condition(n.lhs)
        local rest, join = newBlock(), newBlock()
        local result = addParam(join, "i8")
        local from = b.here()
        if isAnd then
            b.branch(left, rest, join)
        else
            b.branch(left, join, rest)
        end
        -- The short-circuit edge carries the left operand.
        for _, target in ipairs(from.term.targets) do
            if target.block == join then
                target.args[1] = left
            end
        end
        b.current = rest
        seal(rest)
        local right = condition(n.rhs)
        b.jump(join, {right})
        b.current = join
        seal(join)

        return {kind = "boolean", value = result}
    end

    fieldAddress = function(n: any): any
        local base = expression(n.obj)
        local struct = need(pointee(base.type), "field access needs a struct pointer")
        local field = fieldOf(struct, n.name.text)
        local address = emit("iadd " .. materialize(base, "ptr") .. ", " .. constant("i64", tostring(field.offset)))

        return {address = address, field = field}
    end

    local imported = {}

    -- A Rust helper, declared once per caller with the signature the helpers
    -- declaration gives it.
    local function importHelper(symbol: string, paramKinds: {string}, resultKind: string?): string
        local known = imported[symbol]
        if known then
            return known
        end
        local index = #preamble / 2
        local sig = "sig" .. tostring(index + 1)
        local ref = "fn" .. tostring(index)
        local types = {}
        for i, kind in ipairs(paramKinds) do
            types[i] = machine(kind)
        end
        local signature = "(" .. table.concat(types, ", ") .. ")"
        if resultKind then
            signature = signature .. " -> " .. machine(resultKind)
        end
        preamble[#preamble + 1] = sig .. " = " .. signature
        preamble[#preamble + 1] = ref .. " = %" .. symbol .. " " .. sig
        imported[symbol] = ref

        return ref
    end

    -- A call into the helpers declaration: a C ABI call to the exported
    -- symbol, with the kinds the declared signature says.
    local function helperCall(n: any, prefix: string): any
        need(handlers, "Rust helpers belong to handler modules")
        local member = n.obj.name.text
        local signature = raw(n.obj.inferredType)
        need(signature and signature.tag == "func", "helper " .. member .. " has no declared signature")
        local args = n.args.exprs or {}
        need(#args == #signature.params, member .. ": argument count")
        local paramKinds, words = {}, {}
        for index, param in ipairs(signature.params) do
            paramKinds[index] = tag(param)
            words[index] = materialize(expression(args[index]), paramKinds[index])
        end
        local resultKind = #signature.rets == 1 and tag(signature.rets[1]) or nil
        if resultKind == "nil" then
            resultKind = nil
        end
        local text = "call " .. importHelper(
            helperSymbol(member),
            paramKinds,
            resultKind
        ) .. "(" .. table.concat(words, ", ") .. ")"
        if resultKind then
            return {kind = resultKind, value = emit(text)}
        end
        effect(text)

        return {kind = "nil", value = ""}
    end

    local function intrinsic(intrinsicName: string, args: any): any
        local function arg(index: number, kind: string): string
            return materialize(expression(need(args[index], intrinsicName .. ": argument " .. tostring(index))), kind)
        end

        if intrinsicLoads[intrinsicName] then
            local address = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))
            return {
                kind = intrinsicKinds[intrinsicName],
                value = emit(intrinsicLoads[intrinsicName] .. " notrap " .. address)
            }
        elseif intrinsicStores[intrinsicName] then
            local address = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))
            effect(
                intrinsicStores[
                    intrinsicName
                ] .. " notrap " .. arg(3, intrinsicStoreKinds[intrinsicName]) .. ", " .. address
            )
            return {kind = "nil", value = ""}
        elseif intrinsicUnary[intrinsicName] then
            local spec = intrinsicUnary[intrinsicName]
            return {kind = spec[3], value = emit(spec[1] .. " " .. arg(1, spec[2]))}
        elseif intrinsicIdentity[intrinsicName] then
            local spec = intrinsicIdentity[intrinsicName]
            return {kind = spec[2], value = arg(1, spec[1])}
        elseif intrinsicName == "offset" then
            return {kind = "voidptr", value = emit("iadd " .. arg(1, "voidptr") .. ", " .. arg(2, "int64"))}
        elseif intrinsicName == "layout" then
            need(handlers and options.layout, "layouts belong to handler modules")
            local field = need(args[1], "layout field")
            need(field.kind == "string", "literal layout field required")
            local text = field.token.value or field.token.text:sub(2, -2)
            return {kind = "int64", value = constant("i64", tostring(options.layout(text)))}
        elseif intrinsicName == "dispatch"
            or intrinsicName == "slow"
            or intrinsicName == "reenter"
            or intrinsicName == "fail"
        then
            error("lower: " .. intrinsicName .. " is a transfer: `return native." .. intrinsicName .. "(...)`", 0)
        elseif intrinsicName == "both" or intrinsicName == "either" then
            local op = intrinsicName == "both" and "band " or "bor "
            return {kind = "boolean", value = emit(op .. arg(1, "boolean") .. ", " .. arg(2, "boolean"))}
        elseif intrinsicName == "chooseWord" or intrinsicName == "chooseIndex" then
            local kind = intrinsicName == "chooseWord" and "uint64" or "int64"
            return {
                kind = kind,
                value = emit("select " .. arg(1, "boolean") .. ", " .. arg(2, kind) .. ", " .. arg(3, kind))
            }
        end
        error("lower: intrinsic " .. intrinsicName .. " is not part of ordinary code", 0)
    end

    expression = function(n: any): any
        if n.kind == "paren" then
            return expression(n.expr)
        elseif n.kind == "number" then
            return {literal = literalText(n)}
        elseif n.kind == "trueExpr" then
            return {kind = "boolean", value = constant("i8", "1")}
        elseif n.kind == "falseExpr" then
            return {kind = "boolean", value = constant("i8", "0")}
        elseif n.kind == "nilExpr" then
            return {literal = "0"}
        elseif n.kind == "name" then
            local variable = variableOf(n.token)
            local value = readVariable(variable, b.here())
            local kind = tag(n.inferredType)
            if kind == "missing" or machine(kind) ~= b.typeOf(variable) then
                kind = kindOfVariable(variable)
            end
            return {kind = kind, value = value, type = varDecl[variable] or n.inferredType}
        elseif n.kind == "dotIndex" then
            local access = fieldAddress(n)
            return {kind = access.field.kind, value = load(access.field.kind, access.address), type = access.field.type}
        elseif n.kind == "castExpr" then
            -- An erased assertion between types of one representation.
            local inner = expression(n.expr)
            local kind = tag(n.inferredType)
            if inner.literal then
                return {kind = kind, value = materialize(inner, kind), type = n.inferredType}
            end
            need(machine(inner.kind) == machine(kind), "a cast cannot change representation")
            return {kind = kind, value = inner.value, type = n.inferredType}
        elseif n.kind == "unop" then
            local op = n.op.text
            if op == "-" then
                local operand = expression(n.operand)
                if operand.literal then
                    return {literal = "-" .. operand.literal}
                end
                local opName = operand.kind == "number" and "fneg" or "ineg"
                return {kind = operand.kind, value = emit(opName .. " " .. operand.value)}
            elseif op == "not" then
                local value = condition(n.operand)
                local zero = constant("i8", "0")
                return {kind = "boolean", value = emit("icmp eq " .. value .. ", " .. zero)}
            elseif op == "~" then
                local operand = expression(n.operand)
                local kind = kindOf(n.operand, operand, nil)
                return {kind = kind, value = emit("bnot " .. materialize(operand, kind))}
            end
            error("lower: unsupported unary operator " .. op, 0)
        elseif n.kind == "binop" then
            local op = n.op.text
            if op == "and" or op == "or" then
                return shortCircuit(n, op == "and")
            end
            local lhs = expression(n.lhs)
            local rhs = expression(n.rhs)
            if compareSigned[op] then
                return compare(n, op, lhs, rhs)
            end
            local kind = kindOf(n, lhs, rhs)
            if lhs.literal and rhs.literal then
                kind = tag(n.inferredType) == "missing" and "number" or tag(n.inferredType)
            end
            return arithmetic(n, op, kind, lhs, rhs)
        elseif isIntrinsicCall(n) then
            return intrinsic(n.obj.name.text, n.args.exprs or {})
        elseif calledModule(n) ~= nil and HELPER_MODULES[calledModule(n) as string] ~= nil then
            return helperCall(n, HELPER_MODULES[calledModule(n) as string] as string)
        elseif n.kind == "call" then
            local target = need(resolveCallee(n, scope, modules), "only direct calls to module functions") as Fn
            local known = callee(target)
            local args = {}
            local exprs = n.args.exprs or {}
            need(#exprs == #target.paramKinds, "argument count")
            for index, arg in ipairs(exprs) do
                args[index] = materialize(expression(arg), target.paramKinds[index])
            end
            local text = "call " .. known.ref .. "(" .. table.concat(args, ", ") .. ")"
            if target.resultKind then
                return {kind = target.resultKind, value = emit(text)}
            end
            effect(text)
            return {kind = "nil", value = ""}
        end
        error("lower: unsupported expression " .. tostring(n.kind), 0)
    end

    -- A support function, declared once per caller.
    local supports = {}

    local function supportRef(target: Fn): string
        local known = supports[target]
        if known then
            return known
        end
        local index = #preamble / 2
        local sig = "sig" .. tostring(index + 1)
        local ref = "fn" .. tostring(index)
        local types = {}
        for i, kind in ipairs(target.paramKinds) do
            types[i] = machine(kind)
        end
        types[#types + 1] = "i64"
        preamble[#preamble + 1] = sig .. " = (" .. table.concat(types, ", ") .. ") -> i64 tail"
        preamble[#preamble + 1] = ref .. " = %" .. target.name .. " " .. sig
        supports[target] = ref

        return ref
    end

    -- A handler's transfers: dispatch through the table, hand the instruction
    -- to Rust at its own pc, or ask for the frame driver.
    local function transfer(transferName: string, args: any): nil
        need(handlers, "transfers belong to handler modules")
        need(b.current, "transfer outside a block")
        if transferName == "reenter" then
            need(#args == 0, "reenter takes no arguments")
            b.finish({constant("i64", "1")})
        elseif transferName == "fail" then
            need(#args == 0, "fail takes no arguments")
            b.finish({constant("i64", "0")})
        elseif transferName == "slow" then
            need(#args == 6, "slow takes the six handler arguments")
            b.finish({materialize(expression(args[1]), "voidptr")})
        else
            need(#args == 6, "dispatch takes the six handler arguments")
            local words = {}
            for index = 1, 5 do
                words[index] = materialize(expression(args[index]), "voidptr")
            end
            local opcode = emit("uload8.i64 notrap " .. words[1])
            local shifted = emit("ishl " .. opcode .. ", " .. constant("i64", "3"))
            local slot = emit("iadd " .. (tableValue as string) .. ", " .. shifted)
            local target = emit("load.i64 notrap " .. slot)
            words[6] = tableValue as string
            b.terminate("return_call_indirect sig0, " .. target .. "(" .. table.concat(words, ", ") .. ")")
        end
    end

    -- Statements. `b.current` is nil after a terminator; code after it in the
    -- same block is unreachable and is refused.
    local loops = {}
    local statements
    local block

    -- A helper is inlined: its parameters become locals bound to the
    -- arguments and its body continues in this function, naming the functions
    -- of the module it was written in.
    local function inlineHelper(target: Fn, call: any): nil
        local helperName = target.name
        need(not inlining[target], "recursive helper " .. helperName)
        local exprs = call.args.exprs or {}
        need(#exprs == #target.paramKinds, "argument count")
        local values = {}
        for index, arg in ipairs(exprs) do
            values[index] = materialize(expression(arg), target.paramKinds[index])
        end
        for index, param in ipairs(target.body.params) do
            local variable = declare(param.name, target.paramKinds[index], param.type and param.type.resolvedType)
            writeVariable(variable, b.here(), values[index])
        end
        inlining[target] = true
        local outer = scope
        scope = target.scope
        block(target.body.body.stats)
        scope = outer
        inlining[target] = nil
    end

    block = function(stats: any): nil
        for _, stat in ipairs(stats) do
            if stat.kind ~= "emptyStmt" then
                need(b.current ~= nil, "unreachable statement")
                statements(stat)
            end
        end
    end

    local function assign(token: any, e: any): nil
        local variable = variableOf(token)
        local kind = kindOfVariable(variable)
        if not e.literal then
            need(machine(e.kind) == b.typeOf(variable), "assignment changes representation")
            kind = e.kind
        end
        writeVariable(variable, b.here(), materialize(e, kind))
    end

    local function loopBody(bodyBlock: ssa.Block, exit: ssa.Block, continueTo: ssa.Block, stats: any): nil
        loops[#loops + 1] = {exit = exit, continueTo = continueTo}
        b.current = bodyBlock
        seal(bodyBlock)
        block(stats)
        loops[#loops] = nil
    end

    statements = function(stat: any): nil
        local kind = stat.kind
        if kind == "localStmt" then
            local exprs = stat.exprs or {}
            for index, token in ipairs(stat.names) do
                local e = expression(need(exprs[index], "local needs an initializer"))
                local declared = tag(token.inferredType)
                if declared == "missing" then
                    declared = e.literal and "number" or e.kind
                end
                local variable = declare(token, declared, token.inferredType or e.type)
                writeVariable(variable, b.here(), materialize(e, declared))
            end
        elseif kind == "assignStmt" then
            local values = {}
            for index, e in ipairs(stat.exprs) do
                values[index] = expression(e)
            end
            for index, target in ipairs(stat.targets) do
                local value = need(values[index], "assignment needs a value")
                if target.kind == "dotIndex" then
                    local access = fieldAddress(target)
                    store(access.field.kind, materialize(value, access.field.kind), access.address)
                else
                    need(target.kind == "name", "assignment to a local or a field")
                    assign(target.token, value)
                end
            end
        elseif kind == "compoundAssign" then
            need(stat.target.kind == "name", "compound assignment to a local")
            local op = stat.op.text:sub(1, -2)
            local lhs = expression(stat.target)
            local rhs = expression(stat.value)
            assign(stat.target.token, arithmetic(stat, op, kindOf(stat.target, lhs, rhs), lhs, rhs))
        elseif kind == "callStmt" then
            local call = stat.expr
            local helper = handlers and resolveCallee(call, scope, modules) or nil
            if helper then
                -- A helper answering nothing is inlined where it is called and
                -- continues into the statements after it.
                need(not helper.isHandler and not helper.isSupport, "a handler or slow path is tail-called")
                need(helper.resultKind == nil, "a helper with a result is tail-called")
                inlineHelper(helper, call)
                need(b.current ~= nil, "helper " .. helper.name .. " must continue")
            else
                expression(call)
            end
        elseif kind == "returnStmt" then
            local value = stat.exprs[1]
            local transferName = handlers and #stat.exprs == 1 and isIntrinsicCall(value) and value.obj.name.text or nil
            local helper = handlers and #stat.exprs == 1 and resolveCallee(value, scope, modules) or nil
            if transferName == "dispatch"
                or transferName == "slow"
                or transferName == "reenter"
                or transferName == "fail"
            then
                transfer(transferName, value.args.exprs or {})
            elseif helper and helper.isSupport then
                -- A slow path is its own tail-called function, so the fast
                -- path stays frameless: the Rust helper call lives there.
                local exprs = value.args.exprs or {}
                need(#exprs == #helper.paramKinds, "argument count")
                local words = {}
                for index, arg in ipairs(exprs) do
                    words[index] = materialize(expression(arg), helper.paramKinds[index])
                end
                words[#words + 1] = tableValue as string
                b.terminate("return_call " .. supportRef(helper) .. "(" .. table.concat(words, ", ") .. ")")
            elseif helper then
                need(not helper.isHandler, "a handler is dispatched to, not called")
                inlineHelper(helper, value)
                need(b.current == nil, "helper " .. helper.name .. " may not fall through")
            elseif #stat.exprs == 0 then
                need(resultKind == nil, "result required")
                b.finish({})
            else
                need(#stat.exprs == 1 and resultKind ~= nil, "one result")
                b.finish({materialize(expression(stat.exprs[1]), resultKind as string)})
            end
        elseif kind == "doStmt" then
            block(stat.body.stats)
        elseif kind == "ifStmt" then
            local merge = newBlock()
            for _, clause in ipairs(stat.clauses) do
                need(not clause.binding, "binding clauses")
                local taken, otherwise = newBlock(), newBlock()
                branchOn(clause.cond, taken, otherwise)
                b.current = taken
                seal(taken)
                block(clause.body.stats)
                if b.current then
                    b.jump(merge, {})
                end
                b.current = otherwise
                seal(otherwise)
            end
            if stat.elseClause then
                block(stat.elseClause.body.stats)
            end
            if b.current then
                b.jump(merge, {})
            end
            b.current = merge
            seal(merge)
            if #merge.preds == 0 then
                b.current = nil
            end
        elseif kind == "whileStmt" then
            local header, bodyBlock, exit = newBlock(), newBlock(), newBlock()
            b.jump(header, {})
            b.current = header
            branchOn(stat.cond, bodyBlock, exit)
            loopBody(bodyBlock, exit, header, stat.body.stats)
            if b.current then
                b.jump(header, {})
            end
            seal(header)
            b.current = exit
            seal(exit)
        elseif kind == "repeatStmt" then
            local bodyBlock, exit = newBlock(), newBlock()
            b.jump(bodyBlock, {})
            loops[#loops + 1] = {exit = exit, continueTo = bodyBlock}
            b.current = bodyBlock
            block(stat.body.stats)
            loops[#loops] = nil
            if b.current then
                branchOn(stat.cond, exit, bodyBlock)
            end
            seal(bodyBlock)
            b.current = exit
            seal(exit)
        elseif kind == "fornumStmt" then
            local var = stat.var
            local loopKind = tag(var.inferredType)
            local start = expression(stat.start)
            local stop = expression(stat.stop)
            if loopKind == "missing" then
                loopKind = kindOf(stat.start, start, stop)
            end
            local step = "1"
            local descending = false
            if stat.step then
                local s = expression(stat.step)
                need(s.literal, "loop step must be a literal")
                step = s.literal
                descending = step:sub(1, 1) == "-"
            end
            local counter = {}
            b.declare(counter, machine(loopKind))
            b.declare(var.definition or var.text, machine(loopKind))
            writeVariable(counter, b.here(), materialize(start, loopKind))
            local limit = materialize(stop, loopKind)
            local header, bodyBlock, advance, exit = newBlock(), newBlock(), newBlock(), newBlock()
            b.jump(header, {})
            b.current = header
            local value = readVariable(counter, header)
            local op = descending and ">=" or "<="
            local cond = compare({lhs = stat.start}, op, {kind = loopKind, value = value}, {
                kind = loopKind,
                value = limit
            })
            b.branch(cond.value, bodyBlock, exit)
            b.current = bodyBlock
            seal(bodyBlock)
            writeVariable(var.definition or var.text, bodyBlock, readVariable(counter, bodyBlock))
            loops[#loops + 1] = {exit = exit, continueTo = advance}
            block(stat.body.stats)
            loops[#loops] = nil
            if b.current then
                b.jump(advance, {})
            end
            b.current = advance
            seal(advance)
            local next = arithmetic(stat, "+", loopKind, {kind = loopKind, value = readVariable(counter, advance)}, {
                literal = step
            })
            writeVariable(counter, advance, next.value)
            b.jump(header, {})
            seal(header)
            b.current = exit
            seal(exit)
        elseif kind == "pragmaStmt" then
            -- `@unsafe` and its kin are the checker's business; the statement
            -- underneath lowers as itself.
            if stat.stat then
                statements(stat.stat)
            end
        elseif kind == "breakStmt" then
            local loop = need(loops[#loops], "break outside a loop")
            b.jump(loop.exit, {})
        elseif kind == "continueStmt" then
            local loop = need(loops[#loops], "continue outside a loop")
            b.jump(loop.continueTo, {})
        else
            error("lower: unsupported statement " .. tostring(kind), 0)
        end
    end

    local values = {}
    local entry = b.here()
    need(not handlers or isHandler or isSupport, "a helper is compiled where it is tail-called")
    for index, param in ipairs(body.params) do
        local value = addParam(entry, paramTypes[index])
        local variable = declare(param.name, paramKinds[index], param.type and param.type.resolvedType)
        if isHandler and index == 6 then
            -- The sixth register carries the dispatch table; the frame is
            -- thirty-two bytes below the boxed window.
            tableValue = value
            value = emit("iadd " .. values[2] .. ", " .. constant("i64", "-32"))
        end
        values[index] = value
        writeVariable(variable, entry, value)
    end
    if isSupport then
        -- A support function carries the dispatch table after its own
        -- parameters.
        tableValue = addParam(entry, "i64")
    end
    block(body.body.stats)
    if b.current then
        need(resultKind == nil, "function " .. name .. " may fall through without a result")
        b.finish({})
    end

    local signature = "(" .. table.concat(paramTypes, ", ") .. ")"
    if resultType then
        signature = signature .. " -> " .. resultType
    end
    if isSupport then
        local types = {}
        for i, t in ipairs(paramTypes) do
            types[i] = t
        end
        types[#types + 1] = "i64"
        signature = "(" .. table.concat(types, ", ") .. ") -> i64"
    end
    if isHandler or isSupport then
        signature = signature .. " tail"
        table.insert(preamble, 1, "sig0 = (i64, i64, i64, i64, i64, i64) -> i64 tail")
    end

    return b.print(name, signature, preamble)
end

-- The structure offsets a handler names come from the runtime's glue
-- (`nupp-vm native layouts`), which measures the layouts it links against.
local function layouts(path: string): function(string): number
    local offsets: any = json.decode(assert(fs.readFile(path)))
    return function(field: string): number
        local offset = offsets[field]
        need(type(offset) == "number", "unknown context field " .. field)
        return offset as number
    end
end

-- The function record of one `local function` or exported function.
local function describe(fnName: string, node: any, body: any, scope: Scope, handlers: boolean): Fn
    local paramKinds, paramTypes = {}, {}
    for index, param in ipairs(body.params) do
        paramKinds[index] = tag(param.type and param.type.resolvedType)
        paramTypes[index] = machine(paramKinds[index])
    end
    local rets = body.signatureType and body.signatureType.rets or {}
    need(#rets <= 1, "at most one result")
    local resultKind = #rets == 1 and tag(rets[1]) or nil
    if resultKind == "nil" then
        resultKind = nil
    end
    local isHandler = handlers and #paramKinds == 6 and resultKind == "uint64"
    for _, kind in ipairs(paramKinds) do
        if kind ~= "voidptr" then
            isHandler = false
        end
    end
    -- A helper named `...Slow` is a support function: compiled on its own and
    -- tail-called, so the handlers that reach it stay frameless while it
    -- calls Rust.
    local isSupport = handlers and not isHandler and fnName:match("Slow$") ~= nil
    if isSupport then
        -- Its parameters are the pc, the context and its own, so a tail call
        -- to it fits in argument registers; it derives its windows from the
        -- context when it continues.
        need(
            #paramKinds >= 2 and paramKinds[1] == "voidptr" and paramKinds[2] == "voidptr" and resultKind == "uint64",
            "a slow path takes the pc and the context first"
        )
    end

    return new Fn(
        name = fnName,
        node = node,
        body = body,
        scope = scope,
        paramKinds = paramKinds,
        paramTypes = paramTypes,
        resultKind = resultKind,
        resultType = resultKind and machine(resultKind) or nil,
        isHandler = isHandler,
        isSupport = isSupport
    )
end

-- One module's functions, from its checked tree. Requires are validated once
-- every module of the set is known.
local function describeModule(parsed: any, path: string, handlers: boolean): (Scope, {any})
    local scope = new Scope(name = "", path = path, functions = {}, exports = {}, order = {})
    local requires = {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local node: any = stat
            if node.kind == "moduleStmt" then
                local names = {}
                for index, token in ipairs(node.names) do
                    names[index] = token.text
                end
                scope.name = table.concat(names, ".")
            elseif node.kind == "localFuncStmt" or node.kind == "exportStmt" then
                local declared = node.kind == "exportStmt" and node.stat or node
                local exported = node.kind == "exportStmt"
                need(
                    declared ~= nil
                    and (
                        declared.kind == "localFuncStmt"
                        or (declared.kind == "funcStmt" and declared.name.base ~= nil and #declared.name == 1)
                    ),
                    "a module-level declaration is a function"
                )
                local fnName: string = declared.kind == "funcStmt" and declared.name.base.text or declared.name.text
                need(scope.functions[fnName] == nil, "function " .. fnName .. " defined twice")
                local fn = describe(fnName, declared, declared.body, scope, handlers)
                scope.functions[fnName] = fn
                if exported then
                    scope.exports[fnName] = fn
                end
                scope.order[#scope.order + 1] = fnName
            elseif node.kind == "localStmt" then
                need(
                    #node.names == 1 and #node.exprs == 1 and node.isConst,
                    "a module-level local is a `const` require"
                )
                local definition = node.names[1].definition
                need(definition and definition.requiredModule, "module initialization is not native code")
                requires[#requires + 1] = definition.requiredModule
            elseif node.kind ~= "emptyStmt" and node.kind ~= "recordDecl" then
                error("lower: unsupported top-level statement " .. tostring(node.kind), 0)
            end
        end
    end
    need(scope.name ~= "", "module statement required in " .. path)

    return scope, requires
end

--- Compiles a set of modules to one CLIF file.
---
--- `root` is the project root; `options.include` names its include roots
--- (`{"src"}` by default). In handler mode (`options.handlers`), every
--- handler and support function compiles; `options.layouts` names the glue's
--- layout file. Otherwise every function compiles.
--- @raises string when the source does not check or the lowering refuses it.
function lower.compile(root: string, paths: {string}, options: any?): string
    local settings: any = options or {}
    local handlers = settings.handlers == true
    need(not handlers or settings.layouts ~= nil, "handler modules need the glue's layout file")
    trivia.installDefault(provider)
    local env = environment.new(root, {cache = false, config = {include = settings.include or {"src"}}})
    local modules: {[string]: Scope} = {}
    local scopes: {Scope} = {}
    local pending = {}
    for _, path in ipairs(paths) do
        local parsed = parser.parse(assert(fs.readFile(path)), path)
        need(#parsed.errors == 0, "parse failed: " .. path)
        local diagnostics = checker.check(parsed, path, env as any, {})
        for _, diagnostic in ipairs(diagnostics) do
            if diagnostic.severity == "error" or not diagnostic.severity then
                error(tostring(diagnostic.code) .. ": " .. tostring(diagnostic.msg), 0)
            end
        end
        local scope, requires = describeModule(parsed, path, handlers)
        need(modules[scope.name] == nil, "module " .. scope.name .. " compiled twice")
        modules[scope.name] = scope
        scopes[#scopes + 1] = scope
        pending[#pending + 1] = {scope = scope, requires = requires}
    end
    for _, entry in ipairs(pending) do
        for _, required in ipairs(entry.requires) do
            need(
                required == INTRINSICS or HELPER_MODULES[required] ~= nil or modules[required] ~= nil,
                entry.scope.name .. " requires " .. required .. ", which is not native code"
            )
        end
    end
    -- Every compiled function is one CLIF function, so the names of what
    -- compiles must be unique across the set.
    local compiled: {Fn} = {}
    local seen = {}
    for _, scope in ipairs(scopes) do
        for _, fnName in ipairs(scope.order) do
            local fn = scope.functions[fnName] as Fn
            if not handlers or fn.isHandler or fn.isSupport then
                need(seen[fnName] == nil, "function " .. fnName .. " compiled from two modules")
                seen[fnName] = true
                compiled[#compiled + 1] = fn
            end
        end
    end
    need(#compiled > 0, "no functions")
    local functionOptions = {
        handlers = handlers,
        layout = handlers and layouts(settings.layouts as string) or nil,
        modules = modules
    }
    local text = {}
    for index, fn in ipairs(compiled) do
        text[index] = compileFunction(fn, functionOptions)
    end

    return table.concat(text, "\n")
end

--- Compiles the native core: the runtime modules in handler mode against the
--- glue's layout file, answering the CLIF text.
--- @raises string when the source does not check or the lowering refuses it.
function lower.compileRuntime(root: string, layoutsPath: string): string
    local paths = {}
    for index, relative in ipairs(lower.RUNTIME_MODULES) do
        paths[index] = fs.join(root, relative)
    end

    return lower.compile(root, paths, {handlers = true, layouts = layoutsPath, include = {"src"}})
end

export = lower
