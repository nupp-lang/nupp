module nupp.compiler.docblock

--[[
The `---` run above a declaration, read as its tags.

Two readers ask this the same question and have to get the same answer.
Documentation renders the tags, and the checker asks whether a function that
raises said so. Parsing the run in one place is what keeps `@raises` meaning one
thing in `nupp doc` and in `undocumented-raise`.

Nothing here consults the checker. Which run belongs to a declaration, and what
its tags are, is answered by the parse alone: a `@raises` type is recorded as the
word it was spelled with, and whether that word names anything is the checker's
question, asked once the file's declarations are all in.
]]

local cst = require("nupp.compiler.cst")
local lexer = require("nupp.compiler.lexer")
local syntax = require("nupp.compiler.docsyntax")

local docblock = {}

--- One `@raises` entry: what a function raises, and when.
---
--- A raise is written `@raises Type when the condition holds`. The type is the value
--- `error` is called with, so a caller reading the page knows what a `pcall` around
--- the call will hand back, not only that something can come back.
record docblock.Raise
    --- The type, exactly as it was spelled. Empty when the line named none.
    type: string

    --- What makes it raise. Empty when the line was only a type.
    text: string
end

--- One `---` run, read as its prose and its tags.
record docblock.Doc
    --- The prose, with every tag line taken out of it.
    text: string

    --- `@param name description`, by the parameter it names.
    params: {[string]: string}

    --- `@return`, one entry per occurrence, in the order written.
    returns: {string}

    --- `@raises`, one entry per occurrence, in the order written.
    raises: {docblock.Raise}

    --- `@field name description`, by the field it names.
    fields: {[string]: string}

    --- `@typearg name description`, by the type parameter it names.
    typeargs: {[string]: string}

    --- Every other tag, by name, holding its value or `true` when it had none.
    tags: {[string]: any}
end

local function trim(text: string): string
    return (text:gsub("^%s+", ""):gsub("%s+$", ""))
end

-- `@raises Type the condition`, split where the type ends. The type is one word
-- because a raise names a declaration rather than writing a type expression: a union
-- of two is two lines, which is also how the page wants to list them. A line with no
-- words at all keeps both halves empty and lets the checker say so.
local function splitRaise(text: string): docblock.Raise
    local written = trim(text)
    local name, rest = written:match("^(%S+)%s*(.*)$")

    return new docblock.Raise(type = name or "", text = trim(rest or ""))
end

-- The first token under a node, trying every child rather than only the first, so a
-- node whose leading child carries no token still finds the one that follows it.
local function firstToken(node: cst.Child?)
    if not node then
        return nil
    end
    if cst.isToken(node) then
        return node
    end
    for _, child in ipairs(node) do
        local token = firstToken(child)
        if token then
            return token
        end
    end

    return nil
end

--- The `---` run attached to a node, one line per entry with the marker stripped.
---
--- Only the final adjacent run counts. An ordinary comment or a blank line is a hard
--- boundary, so a copyright header cannot become the documentation of the first
--- declaration under it.
---
--- @param node the node whose leading trivia to read
--- @return the run's lines, empty when the node carries no documentation
function docblock.linesOf(node: cst.Child?): {string}
    local token = firstToken(node)
    local lines: {string} = {}
    local pending: {string} = {}
    for index = 1, token and token.triviaCount or 0 do
        local kind = lexer.triviaKind(token, index)
        local text = lexer.triviaText(token, index)
        local body = kind == "comment" and syntax.docComment:match(text) or nil
        if body ~= nil then
            pending[#pending + 1] = body:gsub("\r$", "")
        elseif kind == "comment" then
            pending = {}
        elseif kind == "whitespace" then
            local _, newlines = text:gsub("\n", "")
            if newlines > 1 then
                pending = {}
            end
        end
    end
    for _, line in ipairs(pending) do
        lines[#lines + 1] = line
    end

    return lines
end

--- One `---` run read as its prose and its tags.
---
--- A line opening with `@name` starts a tag and runs until the next tag or the next
--- unindented line, so a description may be wrapped across as many lines as it needs.
--- Anything outside a tag is prose, and everything inside a fenced block is prose
--- whatever it opens with, so an example may show an annotation.
---
--- @param lines the run's lines, as `linesOf` returns them
--- @return what the run said
function docblock.parse(lines: {string}): docblock.Doc
    local params: {[string]: string} = {}
    local fields: {[string]: string} = {}
    local typeargs: {[string]: string} = {}
    local returns: {string} = {}
    local raises: {docblock.Raise} = {}
    local tags: {[string]: any} = {}
    -- A tag is routed by where its value goes rather than by its own name, so the
    -- three shapes a tag can have each have one table: named, listed, and the raises
    -- that carry a type ahead of their text.
    local named: {[string]: {[string]: string}} = {param = params, field = fields, typearg = typeargs}
    local listed: {[string]: {string}} = {["return"] = returns, returns = returns}

    local body: {string} = {}
    local active: string? = nil
    local activeName: string? = nil
    -- A fenced block is prose whatever it holds. An example opening a line with
    -- `@derive` is showing an annotation rather than writing a tag, and reading it as
    -- one would both invent a tag and delete the line from the example it documents.
    local fence: string? = nil
    for _, line in ipairs(lines) do
        local marker, rest
        fence, marker, rest = syntax.fenceState(line, fence)
        local tag, value = nil, nil
        if not marker and not fence then
            tag, value = syntax.tag:match(line)
        end
        if marker then
            active, activeName = nil, nil
            body[#body + 1] = line
        elseif fence then
            active, activeName = nil, nil
            body[#body + 1] = line
        elseif tag then
            local text = value or ""
            active, activeName = tag, nil
            local into, list = named[tag], listed[tag]
            if tag == "raises" then
                raises[#raises + 1] = splitRaise(text)
            elseif into then
                local name, description = syntax.nameValue:match(text)
                -- `name?` is how LuaCATS, EmmyLua and typed LuaDoc spell an optional
                -- parameter or field. The marker belongs to the type, which the
                -- annotation importer reads separately; what a docblock records is
                -- the name, so a run written in one of those dialects describes the
                -- parameter it names rather than one spelled with a question mark.
                if name and #name > 1 and name:sub(-1) == "?" then
                    name = name:sub(1, -2)
                end
                if name then
                    activeName = name
                    into[name] = description or ""
                end
            elseif list then
                list[#list + 1] = text
            else
                tags[tag] = text ~= "" and text or true
            end
        elseif active and syntax.indented:match(line) then
            local continuation = trim(line)
            local into, list = named[active], listed[active]
            if active == "raises" then
                -- A wrapped raise continues its condition. The type was the first word
                -- of the first line and is settled by the time a continuation arrives,
                -- so a run that wrapped before writing one stays typeless rather than
                -- borrowing the next line's first word.
                local raise = raises[#raises]
                if raise then
                    if raise.type == "" then
                        raises[#raises] = splitRaise(continuation)
                    else
                        raise.text = trim(raise.text .. " " .. continuation)
                    end
                end
            elseif list then
                local index = #list
                list[index] = trim((list[index] or "") .. " " .. continuation)
            elseif into and activeName then
                into[activeName] = trim((into[activeName] or "") .. " " .. continuation)
            else
                body[#body + 1] = line
            end
        else
            active, activeName = nil, nil
            body[#body + 1] = line
        end
    end
    while #body > 0 and trim(body[1]) == "" do
        table.remove(body, 1)
    end
    while #body > 0 and trim(body[#body]) == "" do
        table.remove(body)
    end

    return new docblock.Doc(
        text = table.concat(body, "\n"),
        params = params,
        returns = returns,
        raises = raises,
        fields = fields,
        typeargs = typeargs,
        tags = tags
    )
end

--- The tags of the run attached to a node, in one call.
---
--- @param node the node whose leading trivia to read
--- @return what the run said
--- @return whether the node carried a run at all, which is how a caller tells an
---     empty docblock from an absent one
function docblock.of(node: cst.Child?): docblock.Doc, boolean
    local lines = docblock.linesOf(node)
    return docblock.parse(lines), #lines > 0
end

export = docblock
