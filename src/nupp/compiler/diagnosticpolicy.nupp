module nupp.compiler.diagnosticpolicy

local REPORTED = {note = "note", warning = "warning"}

--- Whether a diagnostic stops a build. A note and a warning are reported and stepped
--- over; everything else is an error, including a diagnostic with no severity, since
--- everything that predates severities was one.
export function isFatal(e: {@readonly severity: string?}): boolean
    return REPORTED[e.severity] == nil
end

--- The severity a diagnostic is reported under: its own when it is one of the two
--- that are stepped over, and `error` for everything else, by the same rule.
export function severityOf(e: {@readonly severity: string?}): string
    return REPORTED[e.severity] or "error"
end
