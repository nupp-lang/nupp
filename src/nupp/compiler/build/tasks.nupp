module nupp.compiler.build.tasks

--[[
What a project can be asked to do, and how it is described.

`nupp build` with no target, `nupp test`, and the task list an editor shows are
the same question asked three ways: which targets does this manifest define,
which is the default, and what does each one produce. Nothing here builds
anything -- it answers about the manifest.
]]

local json = nupp.data.json
local cache = require("nupp.compiler.build.cache")
local manifest = require("nupp.compiler.build.manifest")
local dialects = require("nupp.compiler.dialects")

local jsonArray = cache.jsonArray

local tasks = {}

-- An editor reads this, so what an empty table means is part of the answer rather than
-- a detail of whichever JSON runtime the interpreter loaded. The task list is marked
-- with `jsonArray` and stays `[]` when empty; an unmarked empty table is an object.
-- Nothing here is a measurement, so a NaN would be a fault rather than a value.

--- One thing a project can be asked to do.
---
--- A build target, or one of the actions a manifest configures beside them. The fields
--- past the first four depend on which: a docs target has `sources` where a bundle has
--- `entries`, and the test action has `argv`. `nupp tasks` prints the ones that are
--- there, which is what makes the output say what kind of task it is.
type tasks.Task = {
    name: string,

    --- Whether a build with no target named would run this one.
    default: boolean,

    --- "build" for a target, "project" for a configured action.
    category: string,

    kind: string,
    description: string?,

    --- What to type to run it.
    command: {string},

    [string]: any
}

--- What `describe` answers with.
---
--- Asking by name gets that one task; asking for none gets every task under `tasks`,
--- with `default` naming which would run. Both arrive through one return, and the
--- caller already knows which it asked for.
type tasks.Description = {[string]: any}

local function targetConfig(config: manifest.Config, requested: string?): manifest.Target?, string?
    local build = (config.build or {}) as manifest.Build
    if build.targets then
        local name = requested or build.default
        if not name then
            local names = {}
            for candidate in pairs(build.targets) do
                names[#names + 1] = candidate
            end
            table.sort(names)
            name = names[1]
        end
        local target = (name and build.targets[name]) as manifest.Target
        if type(target) ~= "table" then
            return nil, "unknown build target " .. tostring(name)
        end
        local merged: manifest.Target = {}
        for key, value in pairs(build) do
            if key ~= "targets" and key ~= "default" then
                merged[key] = value
            end
        end
        for key, value in pairs(target) do
            merged[key] = value
        end
        if merged.kind == "docs" then
            merged.targetName = name
        else
            merged.name = name
        end
        return merged
    end
    -- A build section that names no targets is the target, which is what the manifest
    -- means by leaving them out.

    return build as manifest.Target
end

local function copyStrings(items)
    local copied = jsonArray({})
    for _, item in ipairs(items or {}) do
        copied[#copied + 1] = item
    end

    return copied
end

local function copyResources(items)
    local copied = jsonArray({})
    for _, item in ipairs(items or {}) do
        if type(item) == "table" then
            local resource = item as manifest.Resource
            copied[#copied + 1] = resource.source .. " -> " .. resource.output
        else
            copied[#copied + 1] = item
        end
    end

    return copied
end

-- A docs target that names no `outDir` does not land in the manifest's default
-- directory, since the generator has one of its own, and it is the generator that
-- decides where a build goes. Asking it beats keeping a second copy of the answer here,
-- which is how the two came to disagree.
local function outDirOf(target)
    if target.outDir then
        return target.outDir
    end
    if target.kind == "docs" then
        return require("nupp.compiler.doc").defaultOutDir(target.format or "site")
    end

    return "build"
end

local function taskDescription(config, name, isDefault)
    local requested = config.build.targets and name or nil
    local target, err = targetConfig(config, requested)
    if not target then
        return nil, err
    end

    return {
        name = name,
        default = isDefault,
        category = "build",
        description = target.description,
        kind = target.kind or "modules",
        outDir = outDirOf(target),
        entries = copyStrings(target.entries),
        sources = copyStrings(target.sources),
        format = target.format,
        title = target.title,
        -- Two settings, and neither is the other: `all` takes in declarations that are
        -- not part of the public surface, `includePrivate` takes in the ones named as
        -- private. Reporting one under the other's name told a reader the opposite of
        -- what they had configured.
        all = target.all,
        includePrivate = target.includePrivate,
        resources = copyResources(target.resources),
        dependencies = copyStrings(target.dependencies),
        nativeFeatures = target.nativeFeatures,
        dialect = target.dialect or dialects.DEFAULT,
        backends = copyStrings(target.backends),
        layoutTarget = target.layoutTarget,
        platforms = copyStrings(target.platforms),
        command = jsonArray({"nupp", "build", "--target", name}),
    }
end

local function configuredTasks(config: manifest.Config, buildOnly: boolean?): {tasks.Task}, string?
    -- Every caller has already refused a manifest with no build section, which is what
    -- makes this the config's own answer rather than a guess at one.
    local build = config.build as manifest.Build
    local names, defaultName = {}, nil
    if build.targets then
        for name in pairs(build.targets) do
            names[#names + 1] = name
        end
        table.sort(names)
        defaultName = build.default or names[1]
    else
        names[1], defaultName = "default", "default"
    end
    local tasks, used = {}, {}
    for _, name in ipairs(names) do
        local task = assert(taskDescription(config, name, name == defaultName))
        tasks[#tasks + 1], used[name] = task, true
    end
    local function actionName(name)
        while used[name] do
            name = "command:" .. name
        end
        return name
    end

    if not buildOnly then
        local test = manifest.testConfig(config)
        local name = actionName("test")
        tasks[
            #tasks + 1
        ] = {
            name = name,
            default = false,
            category = "project",
            description = "Build and run project tests",
            kind = "test",
            buildTarget = test.build,
            argv = copyStrings(test.argv),
            env = test.env,
            command = jsonArray({"nupp", "test"}),
        }
        used[name] = true
    end
    if not buildOnly and config.selfHost then
        local name = actionName("fixpoint")
        tasks[
            #tasks + 1
        ] = {
            name = name,
            default = false,
            category = "project",
            description = "Verify the self-hosting compiler rebuild",
            kind = "self-host",
            buildTarget = config.selfHost.target,
            bootstrap = config.selfHost.bootstrap,
            command = jsonArray({"nupp", "fixpoint"}),
        }
        used[name] = true
    end
    if not buildOnly and config.tasks then
        local customNames = {}
        for customName in pairs(config.tasks) do
            customNames[#customNames + 1] = customName
        end
        table.sort(customNames)
        for _, customName in ipairs(customNames) do
            -- The names came from iterating the same table, so every one of them
            -- indexes back to a task; the map's optional result is not a real maybe.
            local custom = (config.tasks or {})[customName] as manifest.Task
            local name = actionName(customName)
            tasks[
                #tasks + 1
            ] = {
                name = name,
                default = false,
                category = "task",
                description = custom.description,
                kind = "task",
                buildTarget = custom.build,
                argv = copyStrings(custom.argv),
                env = custom.env,
                command = jsonArray({"nupp", "task", customName}),
            }
            used[name] = true
        end
    end
    table.sort(tasks, function(left, right)
        return left.name < right.name
    end)

    return tasks, defaultName
end

--- What the manifest at `root` defines, or one named task of it.
---
--- @param root the project directory, "." by default
--- @param requested one task's name, or nil for all of them
--- @param opts `buildOnly` leaves out the test and self-host actions
--- @return the task, or the whole list
--- @return why not, ready to print
function tasks.describe(root: string?, requested: string?, opts: {buildOnly: boolean?}?): tasks.Description?, string?
    local config, err = manifest.load(root or ".")
    if not config then
        return nil, err
    end
    local build = config.build
    if not build then
        return nil, "nupp: build is not configured"
    end
    local tasks, defaultName = configuredTasks(config, opts and opts.buildOnly)
    if requested then
        for _, task in ipairs(tasks) do
            if task.name == requested then
                return task
            end
        end
        return nil, "nupp: unknown project task " .. requested
    end

    return {default = defaultName, tasks = jsonArray(tasks)}
end

function tasks.encode(value: unknown): string
    return json.encode(value)
end

tasks.targetConfig = targetConfig

export = tasks
