--[[
Staging compiler-provided native features.

This consumes effects recorded by the checker.  It deliberately does not read
the manifest: project dependencies and compiler-native features have different
owners and must not be conflated.
]]

local envMod = require("nupp.compiler.env")
local native = require("nupp.compiler.native")
local fs = require("nupp.compiler.fs")
local process = require("nupp.compiler.build.process")
local deps = require("nupp.compiler.build.deps")

local stage = {}

local join = fs.join

--- Where cargo keeps what it built for the compiler's own crates.
---
--- Not under the project's output directory, which is where this used to be. The crates
--- belong to the compiler rather than to the project, and a target directory per
--- project meant every project that reached a native facility compiled `url`, `glob`,
--- `icu`, and for the http provider the whole of `reqwest`, `rustls` and `tokio`, from
--- nothing. A test suite that makes a project per case paid that per case.
---
--- One directory per crate and feature set rather than one for everything. Cargo names
--- what it uplifts after the crate, not after the features it was built with, so two
--- feature sets sharing a directory take turns overwriting one another's library and a
--- build stages whichever ran last. `bin/nupp` keeps its development provider apart for
--- the same reason and says so.
---
--- `NUPP_NATIVE_CACHE_DIR` names the root; `bin/nupp` sets it to one the repository's
--- worktrees share. Without it the root sits beside the compiler's own source, which is
--- the tree these crates come from.
local function cargoTargetDir(compilerRoot: string, crate: string, features: {string}): string
    local named = os.getenv("NUPP_NATIVE_CACHE_DIR")
    local root = (named and named ~= "") and named or join(compilerRoot, ".nupp-cache")
    local name = crate
    if #features > 0 then
        name = name .. "-" .. table.concat(features, "-")
    end

    return join(root, name)
end

--- Adds effects found in the Lua modules selected from rock dependencies.
function stage.dependencyEffects(
    root: string,
    config: nupp.compiler.build.manifest.Config,
    target: nupp.compiler.build.manifest.Target?,
    effects: {[string]: any}?
): {[string]: any}
    local resolved = {}
    for effect in pairs(effects or {}) do
        resolved[effect] = true
    end
    local env = envMod.new(root, {config = config})
    for _, module in ipairs(deps.rockModules(root, config, target)) do
        local source = fs.readFile(module.path)
        if source then
            for effect in pairs(native.sourceEffects(source, module.path, env as {[string]: any})) do
                resolved[effect] = true
            end
        end
    end

    return resolved
end

function stage.resolve(effects: {[string]: any}?, overrides: {[string]: boolean}?): {[string]: boolean}
    return native.resolve(effects, overrides)
end

--- Builds the compiler-owned binary host with exactly the host features in the resolved
--- effect set. A path-valued third-party stub remains its owner's artifact.
function stage.hostStub(
    root: string,
    outDir: string,
    target: nupp.compiler.build.manifest.Target,
    effects: {[string]: any}?
): string?, string?
    if target.stub ~= "nupp" then
        return target.stub
    end
    if target.platforms then
        local required = {}
        for _, feature in ipairs(native.features(effects)) do
            if feature.host then
                required[#required + 1] = feature.host
            end
        end
        table.sort(required)
        local stubs = require("nupp.compiler.build.stubs")
        local record, recordErr = target._stubRecord, nil
        if not record then
            record, recordErr = stubs.record(assert(target.layoutTarget))
        end
        if not record then
            return nil, recordErr
        end
        return stubs.acquire(root, record, required)
    end
    local compilerRoot = envMod.compilerRoot()
    if not compilerRoot then
        return nil, "the compiler-owned Nupp stub needs compiler source; "
            .. "use a source checkout or name a prebuilt stub path"
    end
    local featureNames = {}
    for _, feature in ipairs(native.features(effects)) do
        if feature.host then
            featureNames[#featureNames + 1] = feature.host
        end
    end
    table.sort(featureNames)
    local targetDir = cargoTargetDir(compilerRoot, "host", featureNames)
    local argv = {
        "cargo",
        "build",
        "--release",
        "--no-default-features",
        "--manifest-path",
        join(compilerRoot, "host/Cargo.toml"),
        "--target-dir",
        targetDir
    }
    if #featureNames > 0 then
        argv[#argv + 1] = "--features"
        argv[#argv + 1] = table.concat(featureNames, ",")
    end
    local code, text = process.capture(argv)
    if code ~= 0 then
        return nil, "cannot build the compiler-owned Nupp host:\n" .. text
    end
    local executable = jit.os == "Windows" and "nupp-host.exe" or "nupp-host"

    return join(targetDir, join("release", executable))
end

local function libraryFile(name: string): string
    if jit.os == "Windows" then
        return name .. ".dll"
    end
    if jit.os == "OSX" then
        return "lib" .. name .. ".dylib"
    end

    return "lib" .. name .. ".so"
end

--- Builds and stages every native feature in `effects`, returning its files.
function stage.build(
    root: string,
    outDir: string,
    effects: {[string]: any}?,
    selectedPlatform: string?
): {[string]: boolean}?, string?
    local outputs = {}
    local providers: {[string]: {
        cargo: string,
        library: string,
        names: {string},
        cargoFeatures: {string}
    }} = {}
    local providerKeys = {}
    for _, feature in ipairs(native.features(effects)) do
        if feature.cargo then
            if selectedPlatform and feature.host then
                -- The compiler-owned catalog stub carries this implementation. A
                -- current-machine sidecar beside a foreign executable is invalid.
                goto continue
            end
            if selectedPlatform and not feature.host then
                return nil, (
                    "binary target %s needs sidecar-only native feature %s; no %s provider artifact exists"
                ):format(tostring(selectedPlatform), feature.name, tostring(selectedPlatform))
            end
            local libraryName = feature.library as string
            local key = feature.cargo .. "\0" .. libraryName
            local provider = providers[key]
            if not provider then
                provider = {cargo = feature.cargo, library = libraryName, names = {}, cargoFeatures = {}}
                providers[key] = provider
                providerKeys[#providerKeys + 1] = key
            end
            provider.names[#provider.names + 1] = feature.name
            if feature.cargoFeature then
                provider.cargoFeatures[#provider.cargoFeatures + 1] = feature.cargoFeature
            end
        end
        ::continue::
    end
    local compilerRoot = envMod.compilerRoot()
    table.sort(providerKeys)
    for _, key in ipairs(providerKeys) do
        local provider = assert(providers[key])
        if not compilerRoot then
            return nil, "native facilities need compiler source; use a source checkout to build this target"
        end
        table.sort(provider.names)
        table.sort(provider.cargoFeatures)
        local targetDir = cargoTargetDir(compilerRoot, provider.library, provider.cargoFeatures)
        local argv = {
            "cargo",
            "build",
            "--release",
            "--manifest-path",
            join(compilerRoot, provider.cargo),
            "--target-dir",
            targetDir
        }
        if #provider.cargoFeatures > 0 then
            argv[#argv + 1] = "--no-default-features"
            argv[#argv + 1] = "--features"
            argv[#argv + 1] = table.concat(provider.cargoFeatures, ",")
        end
        local code, captured = process.capture(argv)
        if code ~= 0 then
            return nil, ("cannot build native facilities %s:\n%s"):format(table.concat(provider.names, ", "), captured)
        end
        local filename = libraryFile(provider.library)
        local built = join(targetDir, join("release", filename))
        -- The sidecar has one public name on POSIX. Windows' loader appends
        -- `.dll` to an extensionless path, so keep that suffix there while
        -- leaving the provider name stable everywhere else.
        local staged = jit.os == "Windows" and filename or provider.library
        local output = join(root, join(outDir, join("lib", staged)))
        local copied, err = fs.copyFile(built, output)
        if not copied then
            return nil, (
                "cannot stage native facilities %s: %s"
            ):format(table.concat(provider.names, ", "), tostring(err))
        end
        outputs[output] = true
    end

    -- A compiler-provided Nupp module a facility needs at run time. The compiler
    -- has already compiled it for itself, so what is staged is that build's
    -- output rather than a second compilation of the same source.
    for _, feature in ipairs(native.features(effects)) do
        local moduleName = feature.runtimeModule
        if moduleName then
            if not compilerRoot then
                return nil, (
                    "the %s runtime needs compiler source; use a source checkout to build this target"
                ):format(feature.name)
            end
            local relative = (moduleName:gsub("%.", "/")) .. ".lua"
            local built = join(compilerRoot, join("build", relative))
            local output = join(root, join(outDir, relative))
            local copied, err = fs.copyFile(built, output)
            if not copied then
                return nil, ("cannot stage the %s runtime: %s"):format(feature.name, tostring(err))
            end
            outputs[output] = true
        end
    end

    return outputs
end

return stage
