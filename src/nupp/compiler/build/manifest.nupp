module nupp.compiler.build.manifest

--[[
Reading `nupp.lua`, and refusing to build from a bad one.

The manifest is a Lua file that returns a table, so anything can be in it. This
validates the whole of it before a build starts rather than failing partway
through on the first field that turns out to be the wrong shape, and every
message names the path to what was wrong -- `build.targets.nupp.compiler.entries[2]`
-- because that is what the author has to go and edit.
]]

local aotTargets = require("nupp.compiler.aot.target")
local check = require("nupp.compiler.check")
local fs = require("nupp.compiler.fs")
local native = require("nupp.compiler.native")
local backends = require("nupp.compiler.backends")
local dialects = require("nupp.compiler.dialects")

local join = fs.join

local manifest = {}

--[[
The manifest's shape, as the checks below hold it to.

Every one of these carries an open indexer, and that is not a shrug. A manifest key
means something to whatever reads it, and the docs targets alone take a dozen the build
never looks at; the closed lists further down are where a key is refused, because a
misspelling has to be caught by name and by suggestion rather than by a type error at a
call site nobody is standing at. What the fields here say is the part the build itself
reads, so a consumer that asks for one gets an answer rather than `any`.
]]

--- One build target: what it compiles and what it produces.
---
--- Everything is optional because a target inherits the `build` table's keys and
--- overrides the ones it names, so the merged result is what has to be complete.
type manifest.Target = {
    --- "modules", "bundle", "binary", "component" or "docs"; absent means "modules".
    kind: string?,

    description: string?,
    outDir: string?,
    output: string?,

    --- The portable Lua source payload assembled before a `binary` target is
    --- compiled for its current host and stamped into the executable.
    payloadOutput: string?,

    --- The prebuilt host a `binary` target's payload is stamped into.
    stub: string?,

    --- Relink the compiler-owned host with static AOT and FFI archives before
    --- stamping the payload, producing an executable with no native sidecars.
    standalone: boolean?,

    --- How linked AOT code reaches its consumer. Static archives are consumed
    --- by a standalone host or by an embedding application, never mapped by
    --- the generated component.
    aotLinkage: string?,

    --- Compiler-owned distribution platforms. Their public spellings are target
    --- triples; only triples with cataloged native stubs are accepted.
    platforms: {string}?,
    platformOutputs: {[string]: string}?,

    entries: {string}?,

    --- The optimization level this target builds at when the command line does
    --- not say. Deliverable kinds default to 2; an explicit `-O` always wins.
    optimize: integer?,

    --- Dotted module functions published by a component target.
    exports: {string}?,
    sources: {string}?,
    resources: {string | manifest.Resource}?,
    dependencies: {string}?,

    --- Target triple used by compile-time C layout intrinsics. It is deliberately
    --- separate from the machine running the compiler and from a dependency's native
    --- build target.
    layoutTarget: string?,
    dialect: string?,
    backends: {string}?,
    format: string?,
    title: string?,

    --- The target's own name, filled in by `nupp.compiler.build.tasks` when it merges
    --- the build's keys with the target's. A docs target takes `targetName` instead,
    --- because `name` is already the site's.
    name: string?,
    targetName: string?,

    [string]: any
}

--- One resource copied to an explicit target-relative path. The string shorthand keeps
--- deriving its destination from the source path.
type manifest.Resource = {
    source: string,
    output: string
}

--- What a project depends on but did not write.
---
--- Only `kind` and `dependencies` are common to all of them: what a C build takes and
--- what a rock takes have nothing else in common, and each provider in
--- `nupp.compiler.build.deps` reads its own.
type manifest.Dependency = {
    --- "c", "cargo", "rust", "luarocks" or "types".
    kind: string?,

    dependencies: {string}?,

    [string]: any
}

--- The build section: either one target inline, or several by name.
type manifest.Build = {
    outDir: string?,
    targets: {[string]: manifest.Target}?,
    default: string?,
    [string]: any
}

--- The command `nupp test` runs, and what it runs with.
type manifest.Test = {
    --- Required: a test section that names no command configures nothing.
    argv: {string},

    --- Which target to build first.
    build: string?,

    env: {[string]: string}?,
    [string]: any
}

--- Which target rebuilds the compiler, and where its stage zero lives.
type manifest.SelfHost = {
    target: string?,

    --- A separately composed target used only to regenerate the tracked stage zero.
    bootstrapTarget: string?,
    bootstrap: string?,

    --- The `binary` target `nupp fixpoint --binary` stamps twice.
    binary: string?,

    [string]: any
}

--- One named `tasks` entry: a command the project runs by hand often enough to want a
--- name for, and optionally a target to build before it.
type manifest.Task = {
    description: string?,
    argv: {string}?,
    build: string?,
    env: {[string]: string}?,

    [string]: any
}

--- A whole `nupp.lua`.
---
--- The underscored keys are not written by hand: `nupp.compiler.build.project` folds
--- the options a command was given into the config before it is hashed, so changing one
--- invalidates the artifacts built under the old value.
type manifest.Config = {
    include: {string}?,
    fmt: {methodParens: boolean?}?,
    lints: {[string]: string}?,
    dependencies: {[string]: manifest.Dependency}?,
    build: manifest.Build?,
    test: manifest.Test?,
    tasks: {[string]: manifest.Task}?,
    selfHost: manifest.SelfHost?,
    [string]: any
}

local function validateArray(value, label, itemType, required)
    if value == nil then
        if required then
            return nil, label .. " is required"
        end
        return true
    end
    if type(value) ~= "table" then
        return nil, label .. " must be an array"
    end
    local count, highest = 0, 0
    for key, item in pairs(value) do
        if type(key) ~= "number" or key < 1 or key ~= math.floor(key) then
            return nil, label .. " must be an array"
        end
        count = count + 1
        if key > highest then
            highest = key
        end
        if itemType and type(item) ~= itemType then
            return nil, label .. "[" .. key .. "] must be a " .. itemType
        end
    end
    if count ~= highest then
        return nil, label .. " must not contain gaps"
    end
    if required and count == 0 then
        return nil, label .. " must not be empty"
    end

    return true
end

local function validateString(value, label)
    if type(value) ~= "string" or value == "" then
        return nil, label .. " must be a non-empty string"
    end
    return true
end

-- A docs target is the one place a manifest key is read by something other than the
-- build: the generator takes a dozen of its own, none of which the checks below know
-- about, so a misspelling used to configure nothing and say nothing. `custmCss`
-- rendered a site with the default theme and a clean exit.
--
-- The lists are closed on purpose: a manifest is a small enough thing to be exact
-- about. They cover what the generator reads plus what any build target takes, because
-- a docs target is still one of those, and this project's declares `dependencies`,
-- which is how `nupp doc` gets the rocks it renders with.
local DOCS_KEYS = {
    -- read by nupp.compiler.doc
    "sources",
    "format",
    "outDir",
    "title",
    "name",
    "description",
    "github",
    "logo",
    "favicon",
    "public",
    "customCss",
    "lexers",
    "includePrivate",
    "all",
    "pages",
    "constructorPattern",
    "diagnostics",
    "stdlib",
    -- taken by any build target
    "kind",
    "dependencies",
    "entries",
    "exports",
    "resources",
    "output",
    "payloadOutput",
    "stub",
    "standalone",
    "platforms",
    "platformOutputs",
    "nativeFeatures",
    "dialect",
    "backends",
    "layoutTarget",
}

local PAGE_KEYS = {
    "path",
    "title",
    "source",
    -- Names a directory of markdown instead of a single `source`. The entry then
    -- stands for every document in it, and for the index generated at `path`.
    "directory",
    -- Names the files instead of the routes. The entry stands for every markdown file
    -- the pattern matches, each published where it sits; `base` is the directory routes
    -- are named from and `exclude` drops what the tree holds and the site does not
    -- publish. What a path cannot say, the page says in its own front matter.
    "glob",
    "base",
    "exclude",
    "layout",
    "redirects",
}

-- The two generated indexes are configured the same way: where the page goes, what to
-- call it, the routes it answers to under its former names, and the handwritten file
-- whose prose it opens with.
local GENERATED_KEYS = {"path", "redirects", "source", "title"}

local TASK_KEYS = {"description", "argv", "build", "env"}

-- The rest of the manifest, closed for the same reason the docs target is: a key
-- nothing reads takes effect silently, and `dependencie` or `entires` is a build that
-- does something other than what its author wrote down. Every name here is read
-- somewhere -- the sections by the checks below, a target's by
-- `nupp.compiler.build.project`, a dependency's by its provider in
-- `nupp.compiler.build.deps` -- so this list is also the inventory of what a manifest
-- can say.
local CONFIG_KEYS = {"name", "include", "fmt", "lints", "dependencies", "build", "test", "tasks", "selfHost", "docs"}

-- What any build target takes, whatever its kind. A docs target is checked against
-- DOCS_KEYS instead, which spells out these same keys plus the generator's own.
local TARGET_KEYS = {
    "kind",
    "optimize",
    "aot",
    "aotLinkage",
    "aotFeatures",
    "aotTarget",
    "aotCflags",
    "description",
    "outDir",
    "output",
    "payloadOutput",
    "stub",
    "standalone",
    "platforms",
    "platformOutputs",
    "entries",
    "exports",
    "sources",
    "resources",
    "dependencies",
    "nativeFeatures",
    "dialect",
    "backends",
    "layoutTarget",
    "format",
    "title",
    "name",
    "targetName"
}

-- The build section itself, which is either one target inline or the table the named
-- ones hang off. A target inherits every key here that is not one of the two.
local BUILD_KEYS = {"targets", "default"}

for _, key in ipairs(TARGET_KEYS) do
    BUILD_KEYS[#BUILD_KEYS + 1] = key
end

local TEST_KEYS = {"argv", "build", "env"}
local SELF_HOST_KEYS = {"target", "bootstrapTarget", "bootstrap", "binary"}

-- A dependency's keys are its provider's, and the providers have almost nothing in
-- common: what a C build takes and what a rock takes overlap in `path` and nothing
-- else. So each kind is closed against what its own provider reads.
-- `rust` and `cargo` name the same provider, so they take the same keys.
local CARGO_KEYS = {
    "kind",
    "dependencies",
    "manifest",
    "path",
    "cargo",
    "target",
    "targetDir",
    "profile",
    "library",
    "artifactPath",
    "features",
    "locked",
    "offline",
    "out",
    "load",
    "header",
    "bindings",
    "cc",
    "cppflags"
}

local DEPENDENCY_KEYS: {
    [string]: {string}
} = {
    c = {
        "kind",
        "dependencies",
        "source",
        "path",
        "sources",
        "headers",
        "includeDirs",
        "cc",
        "cflags",
        "cppflags",
        "ldflags",
        "pkgConfig",
        "linkage",
        "out",
        "staticOut",
        "artifacts",
        "load",
        "header",
        "bindings"
    },
    cargo = CARGO_KEYS,
    rust = CARGO_KEYS,
    luarocks = {
        "kind",
        "dependencies",
        "rock",
        "version",
        "rockspec",
        "path",
        "tree",
        "luaVersion",
        "server",
        "luaDir",
        "luarocks",
        "rockDependencies",
        "bundle"
    },
    types = {"kind", "format", "source", "path"},
}

-- The generated FFI binding a C or Cargo dependency asks for by naming a header.
local BINDING_KEYS = {"header", "library", "out", "bridge", "macros", "cbindgen", "command", "ownership"}
local NATIVE_ARTIFACT_KEYS = {"path", "sha256", "size"}
local NATIVE_ARTIFACT_SET_KEYS = {"shared", "static"}

local function validateKeys(value, known, label)
    if type(value) ~= "table" then
        return true
    end
    local allowed = {}
    for _, name in ipairs(known) do
        allowed[name] = true
    end
    local unknown = {}
    for key in pairs(value) do
        -- An underscored key is the build's own: `nupp.compiler.build.project` folds
        -- the options a command was given into the config it hashes, so a validated
        -- manifest is not the only table these checks ever see.
        if type(key) == "string" and not allowed[key] and key:sub(1, 1) ~= "_" then
            unknown[#unknown + 1] = key
        end
    end
    table.sort(unknown)
    local key = unknown[1]
    if not key then
        return true
    end
    local suggestion = require("nupp.compiler.check.fixits").nearest(key, known)
    if suggestion then
        return nil, ("%s has no key %q; did you mean %q?"):format(label, key, suggestion)
    end

    return nil, ("%s has no key %q"):format(label, key)
end

local function validSymbol(value)
    return type(value) == "string" and value:match("^[A-Za-z_][A-Za-z0-9_]*$") ~= nil
end

local function validateOwnership(value, label)
    if value == nil then
        return true
    end
    if type(value) ~= "table" then
        return nil, label .. " must be a table"
    end
    local valid, err = validateKeys(value, {"returns", "takes"}, label)
    if not valid then
        return nil, err
    end
    for functionName, cleanup in pairs(value.returns or {}) do
        if not validSymbol(functionName) or not validSymbol(cleanup) then
            return nil, label .. ".returns must map C symbols to cleanup C symbols"
        end
    end
    for functionName, positions in pairs(value.takes or {}) do
        if not validSymbol(functionName) then
            return nil, label .. ".takes must be keyed by C symbols"
        end
        valid, err = validateArray(positions, label .. ".takes." .. functionName, "number")
        if not valid then
            return nil, err
        end
        for _, position in ipairs(positions) do
            if position < 1 or position % 1 ~= 0 then
                return nil, label .. ".takes." .. functionName .. " must contain positive parameter positions"
            end
        end
    end

    return true
end

local function validateDocsTarget(target, label)
    local valid, err = validateKeys(target, DOCS_KEYS, label)
    if not valid then
        return nil, err
    end
    if target.pages ~= nil and type(target.pages) ~= "table" then
        return nil, label .. ".pages must be an array of page tables"
    end
    for _, generated in ipairs({"diagnostics", "stdlib"}) do
        local configured = target[generated]
        if configured ~= nil then
            if type(configured) ~= "table" then
                return nil, label .. "." .. generated .. " must be a table"
            end
            valid, err = validateKeys(configured, GENERATED_KEYS, label .. "." .. generated)
            if not valid then
                return nil, err
            end
        end
    end
    for index, page in ipairs(target.pages or {}) do
        local pageLabel = ("%s.pages[%d]"):format(label, index)
        if type(page) ~= "table" then
            return nil, pageLabel .. " must be a table"
        end
        valid, err = validateKeys(page, PAGE_KEYS, pageLabel)
        if not valid then
            return nil, err
        end
        -- One of the two ways a page entry names what it publishes: a route it writes,
        -- or a pattern the files answer for themselves.
        if page.glob ~= nil then
            if type(page.glob) ~= "string" then
                valid, err = validateArray(page.glob, pageLabel .. ".glob", "string", true)
                if not valid then
                    return nil, err
                end
            end
            valid, err = validateArray(page.exclude, pageLabel .. ".exclude", "string", false)
            if not valid then
                return nil, err
            end
        elseif type(page.path) ~= "string" then
            return nil, pageLabel .. ".path must be a string"
        end
    end

    return true
end

local function validateTarget(target, label, dependencies)
    if type(target) ~= "table" then
        return nil, label .. " must be a table"
    end
    local kind = target.kind or "modules"
    if kind ~= "modules" and kind ~= "docs" and kind ~= "bundle" and kind ~= "binary" and kind ~= "component" then
        return nil, label .. ".kind must be \"modules\", \"bundle\", \"binary\", \"component\", or \"docs\""
    end
    if kind ~= "docs" then
        local valid, err = validateKeys(target, TARGET_KEYS, label)
        if not valid then
            return nil, err
        end
    end
    if target.optimize ~= nil and (
        type(target.optimize) ~= "number" or (target.optimize ~= 0 and target.optimize ~= 1 and target.optimize ~= 2)
    ) then
        return nil, label .. ".optimize must be 0, 1, or 2"
    end
    if kind == "binary" and target.stub == nil then
        return nil, label
            .. ".stub is required for a binary target: it names "
            .. "the executable the payload is stamped into"
    end
    if target.stub ~= nil then
        local valid, err = validateString(target.stub, label .. ".stub")
        if not valid then
            return nil, err
        end
    end
    if target.standalone ~= nil and type(target.standalone) ~= "boolean" then
        return nil, label .. ".standalone must be a boolean"
    end
    if target.standalone then
        if kind ~= "binary" then
            return nil, label .. ".standalone is only valid for a binary target"
        end
        if target.stub ~= "nupp" then
            return nil, label .. ".standalone requires the compiler-owned stub = \"nupp\""
        end
    end
    if target.platforms ~= nil then
        if kind ~= "binary" then
            return nil, label .. ".platforms is only valid for a binary target"
        end
        if target.stub ~= "nupp" then
            return nil, label .. ".platforms requires the compiler-owned stub = \"nupp\""
        end
        local valid, err = validateArray(target.platforms, label .. ".platforms", "string", true)
        if not valid then
            return nil, err
        end
        local distribution = require("nupp.compiler.build.platform")
        local layouts = require("nupp.compiler.targetlayout")
        local seen = {}
        for index, name in ipairs(target.platforms) do
            if seen[name] then
                return nil, label .. ".platforms[" .. index .. "] duplicates " .. name
            end
            seen[name] = true
            if not distribution.has(name) then
                return nil, label
                    .. ".platforms names unsupported binary platform "
                    .. name
                    .. "; supported platforms: "
                    .. table.concat(
                    distribution.keys(),
                    ", "
                )
            end
            if not layouts.has(name) then
                return nil, label .. ".platforms names a platform with no C layout model " .. name
            end
        end
        if target.layoutTarget ~= nil and (#target.platforms ~= 1 or target.layoutTarget ~= target.platforms[1]) then
            return nil, label .. ".layoutTarget must equal the selected binary platform; omit it for platform selection"
        end
        if #target.platforms > 1 and target.output ~= nil then
            return nil, label .. ".output cannot name several platform binaries; use platformOutputs"
        end
    end
    if target.platformOutputs ~= nil then
        if target.platforms == nil then
            return nil, label .. ".platformOutputs requires platforms"
        end
        if type(target.platformOutputs) ~= "table" then
            return nil, label .. ".platformOutputs must be a table"
        end
        local configured = {}
        local outputs = {}
        for _, name in ipairs(target.platforms) do
            configured[name] = true
        end
        for name, output in pairs(target.platformOutputs) do
            if type(name) ~= "string" or not configured[name] then
                return nil, label .. ".platformOutputs names unconfigured platform " .. tostring(name)
            end
            local valid, err = validateString(output, label .. ".platformOutputs." .. name)
            if not valid then
                return nil, err
            end
            if outputs[output] then
                return nil, label .. ".platformOutputs maps several platforms to " .. output
            end
            outputs[output] = true
        end
    end
    if target.description ~= nil and type(target.description) ~= "string" then
        return nil, label .. ".description must be a string"
    end
    if target.layoutTarget ~= nil then
        local valid, err = validateString(target.layoutTarget, label .. ".layoutTarget")
        if not valid then
            return nil, err
        end
        local layouts = require("nupp.compiler.targetlayout")
        if not layouts.has(target.layoutTarget) then
            return nil, label
                .. ".layoutTarget names unsupported target "
                .. target.layoutTarget
                .. "; supported targets: "
                .. table.concat(
                layouts.keys(),
                ", "
            )
        end
    end
    if target.nativeFeatures ~= nil then
        if type(target.nativeFeatures) ~= "table" then
            return nil, label .. ".nativeFeatures must be a table"
        end
        local known = {}
        for _, name in ipairs(native.featureNames()) do
            known[name] = true
        end
        for name, enabled in pairs(target.nativeFeatures) do
            if type(name) ~= "string" or not known[name] then
                return nil, label .. ".nativeFeatures names no feature " .. tostring(name)
            end
            if type(enabled) ~= "boolean" then
                return nil, label .. ".nativeFeatures." .. name .. " must be true or false"
            end
        end
    end
    local _, dialectErr = dialects.resolve(target.dialect, label .. ".dialect")
    if dialectErr then
        return nil, dialectErr
    end
    local validBackends, backendErr = backends.validate(target.backends, label .. ".backends")
    if not validBackends then
        return nil, backendErr
    end
    if target.outDir ~= nil then
        local valid, err = validateString(target.outDir, label .. ".outDir")
        if not valid then
            return nil, err
        end
    end
    if target.aot ~= nil then
        -- One policy per artifact, chosen before any `@aot` body is looked at.
        -- Selecting `require` is how a project accepts a C compiler as a
        -- dependency, which is why it is never the default.
        local valid, err = validateString(target.aot, label .. ".aot")
        if not valid then
            return nil, err
        end
        if target.aot ~= "off"
            and target.aot ~= "emit-c"
            and target.aot ~= "require"
            and target.aot ~= "emit-wasm"
            and target.aot ~= "require-wasm"
        then
            return nil, label .. ".aot must be \"off\", \"emit-c\", \"require\", \"emit-wasm\" or \"require-wasm\""
        end
        if (target.aot == "emit-wasm" or target.aot == "require-wasm") and target.dialect ~= "lua51" then
            return nil, label .. ".aot = \"" .. target.aot .. "\" requires dialect = \"lua51\""
        end
        if (
            target.aot == "emit-wasm" or target.aot == "require-wasm"
        ) and target.aotTarget ~= nil and target.aotTarget ~= "wasm32-unknown-emscripten" then
            return nil, label .. ".aot = \"" .. target.aot .. "\" fixes aotTarget to wasm32-unknown-emscripten"
        end
    end
    if target.aotLinkage ~= nil then
        local valid, err = validateString(target.aotLinkage, label .. ".aotLinkage")
        if not valid then
            return nil, err
        end
        if target.aotLinkage ~= "shared" and target.aotLinkage ~= "static" then
            return nil, label .. ".aotLinkage must be \"shared\" or \"static\""
        end
        if target.aotLinkage == "static" and kind ~= "component" and not target.standalone then
            return nil, label .. ".aotLinkage = \"static\" requires a component or standalone binary target"
        end
        if target.aotLinkage == "shared" and target.standalone then
            return nil, label .. ".standalone requires aotLinkage = \"static\""
        end
    end
    if target.aotTarget ~= nil then
        -- Which machine the compiled code is for. Separate from the target's own
        -- `platforms`, which says where the Lua runs: an artifact can be built
        -- on one machine for another, and the C compiler has to be told so.
        local valid, err = validateString(target.aotTarget, label .. ".aotTarget")
        if not valid then
            return nil, err
        end
        local _, targetErr = aotTargets.select(target.aotTarget as string, nil)
        if targetErr ~= nil then
            return nil, label .. ".aotTarget: " .. tostring(targetErr)
        end
    end
    if target.aotCflags ~= nil then
        -- Whatever the generated C needs that the backend cannot know: a
        -- sysroot, an include path, a vendor flag. Appended after the fixed
        -- flags, and part of what the library is keyed on, because a flag that
        -- changes the output has to be.
        local valid, err = validateArray(target.aotCflags, label .. ".aotCflags", "string")
        if not valid then
            return nil, err
        end
    end
    if target.aotFeatures ~= nil then
        -- The widest optional tier an x86-64 build carries. Baseline remains in
        -- the library and the destination chooses at load; other architectures
        -- retain their one selected tier.
        local valid, err = validateString(target.aotFeatures, label .. ".aotFeatures")
        if not valid then
            return nil, err
        end
        local featureTarget = (
            target.aot == "emit-wasm" or target.aot == "require-wasm"
        ) and "wasm32-unknown-emscripten" or target.aotTarget as string?
        local _, tierErr = aotTargets.select(featureTarget, target.aotFeatures as string)
        if tierErr ~= nil then
            return nil, label .. ".aotFeatures: " .. tostring(tierErr)
        end
    end
    local valid, err = validateArray(
        target.entries,
        label .. ".entries",
        "string",
        kind == "modules" or kind == "bundle" or kind == "binary" or kind == "component"
    )
    if not valid then
        return nil, err
    end
    if target.output ~= nil then
        valid, err = validateString(target.output, label .. ".output")
        if not valid then
            return nil, err
        end
    end
    if target.payloadOutput ~= nil then
        if kind ~= "binary" then
            return nil, label .. ".payloadOutput is only valid for a binary target"
        end
        valid, err = validateString(target.payloadOutput, label .. ".payloadOutput")
        if not valid then
            return nil, err
        end
        if target.payloadOutput == target.output then
            return nil, label .. ".payloadOutput must differ from output"
        end
        if target.platforms ~= nil and #target.platforms > 1 then
            return nil, label .. ".payloadOutput cannot name several platform payloads"
        end
    end
    valid, err = validateArray(target.exports, label .. ".exports", "string")
    if not valid then
        return nil, err
    end
    if target.exports ~= nil and kind ~= "component" then
        return nil, label .. ".exports is only valid for a component target"
    end
    local seenExports = {}
    for index, export in ipairs(target.exports or {}) do
        if not export:match("^[%a_][%w_%.]*%.[%a_][%w_]*$") then
            return nil, label .. ".exports[" .. index .. "] must name a dotted module function"
        end
        if seenExports[export] then
            return nil, label .. ".exports[" .. index .. "] duplicates " .. export
        end
        seenExports[export] = true
    end
    valid, err = validateArray(target.sources, label .. ".sources", "string", kind == "docs")
    if not valid then
        return nil, err
    end
    if target.format ~= nil and target.format ~= "site" and target.format ~= "markdown" and target.format ~= "both" then
        return nil, label .. ".format must be \"site\", \"markdown\", or \"both\""
    end
    if target.title ~= nil and type(target.title) ~= "string" then
        return nil, label .. ".title must be a string"
    end
    if target.resources ~= nil then
        if type(target.resources) ~= "table" then
            return nil, label .. ".resources must be an array"
        end
        for index, resource in ipairs(target.resources) do
            if type(resource) == "string" then
                valid, err = validateString(resource, label .. ".resources[" .. index .. "]")
            elseif type(resource) == "table" then
                valid, err = validateString(resource.source, label .. ".resources[" .. index .. "].source")
                if valid then
                    valid, err = validateString(resource.output, label .. ".resources[" .. index .. "].output")
                end
                if valid and (
                    resource.output:sub(1, 1) == "/" or ("/" .. resource.output .. "/"):find("/../", 1, true)
                ) then
                    valid, err = nil, label .. ".resources[" .. index .. "].output must stay inside the target"
                end
            else
                valid, err = nil, label .. ".resources[" .. index .. "] must be a string or resource table"
            end
            if not valid then
                return nil, err
            end
        end
    end
    valid, err = validateArray(target.dependencies, label .. ".dependencies", "string")
    if not valid then
        return nil, err
    end
    for _, name in ipairs(target.dependencies or {}) do
        if type(dependencies[name]) ~= "table" then
            return nil, label .. ".dependencies references unknown dependency " .. name
        end
    end
    if kind == "docs" then
        valid, err = validateDocsTarget(target, label)
        if not valid then
            return nil, err
        end
    end

    return true
end

-- A rock has to say which rock, at which version. LuaRocks will happily install
-- whatever is newest when a version is left out, and a dependency that resolves to
-- whatever is newest is a build that means something different tomorrow -- so a rock is
-- pinned to a version, to a rockspec, or to a directory that is already in the tree,
-- and a manifest that pins none of the three is refused.
local ROCK_STRINGS = {"rock", "version", "rockspec", "path", "tree", "luaVersion", "server", "luaDir", "luarocks"}

local function validateRock(dep, label)
    for _, field in ipairs(ROCK_STRINGS) do
        if dep[field] ~= nil then
            local valid, err = validateString(dep[field], label .. "." .. field)
            if not valid then
                return nil, err
            end
        end
    end
    if dep.version == nil and dep.rockspec == nil and dep.path == nil then
        return nil, label .. " must pin the rock: give a version, a rockspec, " .. "or a path to build it from"
    end
    -- What a bundle carries of this rock, as globs over the tree it installs into. A
    -- rock tree is mostly things a program never asks for, so this is a list rather
    -- than a switch.
    local valid, err = validateArray(dep.bundle, label .. ".bundle", "string")
    if not valid then
        return nil, err
    end
    if dep.rockDependencies ~= nil and type(dep.rockDependencies) ~= "boolean" then
        return nil, label .. ".rockDependencies must be a boolean"
    end
    -- LuaRocks resolves what a rock needs. Letting one name a dependency here would
    -- read as declaring that and mean nothing, which is the one way a configuration
    -- file can lie to the person who wrote it.
    if #(dep.dependencies or {}) > 0 then
        return nil, label .. ".dependencies is not for a rock: LuaRocks " .. "resolves what a rock depends on"
    end

    return true
end

local LINT_LEVELS = {off = true, note = true, warning = true, error = true}

-- Room for other formatter settings to land beside `methodParens` without a top-level
-- key of their own.
local FMT_KEYS = {"methodParens"}

-- test.build, tasks.<name>.build, and the selfHost targets all name a build target the
-- same way: a non-empty string naming a target the build section declares.
local function validateTargetReference(build, value, label)
    local valid, err = validateString(value, label)
    if not valid then
        return nil, err
    end
    if not build or not build.targets then
        return nil, label .. " requires build.targets"
    end
    if type(build.targets[value]) ~= "table" then
        return nil, label .. " references unknown target " .. value
    end

    return true
end

local function validateManifest(config: manifest.Config): boolean?, string?
    local valid, err = validateArray(config.include, "include", "string")
    if not valid then
        return nil, err
    end
    -- A key nothing reads takes effect silently, which is the one way a configuration
    -- file can lie to the person who wrote it. `strict` used to set the floor for a
    -- whole project; a file's extension answers that now, so a manifest still carrying
    -- it is describing a build that no longer happens.
    if config.strict ~= nil then
        return nil, "strict is no longer a manifest key: a file's extension "
            .. "decides its floor, so `.nupp` is strict and `.g.nupp` is not. "
            .. "Rename the files that are not ready, or pass --strict to hold "
            .. "every file to it regardless"
    end
    -- After `strict`, so the key that was retired by name keeps saying what replaced it
    -- rather than being answered with a guess at the nearest spelling.
    valid, err = validateKeys(config, CONFIG_KEYS, "nupp.lua")
    if not valid then
        return nil, err
    end

    if config.fmt ~= nil then
        if type(config.fmt) ~= "table" then
            return nil, "fmt must be a table"
        end
        valid, err = validateKeys(config.fmt, FMT_KEYS, "fmt")
        if not valid then
            return nil, err
        end
        if config.fmt.methodParens ~= nil and type(config.fmt.methodParens) ~= "boolean" then
            return nil, "fmt.methodParens must be a boolean"
        end
    end

    -- A typo here would silently leave a lint at its default, which is the one way a
    -- configuration file can lie to the person who wrote it.
    if config.lints ~= nil then
        if type(config.lints) ~= "table" then
            return nil, "lints must be a table"
        end
        for key, level in pairs(config.lints) do
            if type(key) ~= "string" or key == "" then
                return nil, "lint names must be non-empty strings"
            end
            if not LINT_LEVELS[level] then
                return nil, ("lints.%s must be off, note, warning or error"):format(key)
            end
            if not check.lintFor(key) and not check.lintCategories[key] then
                return nil, ("lints.%s names no lint or category; " .. "see `nupp lints`"):format(key)
            end
        end
    end

    local dependencies = config.dependencies or {}
    if type(dependencies) ~= "table" then
        return nil, "dependencies must be a table"
    end
    for name, dep in pairs(dependencies) do
        if type(name) ~= "string" or name == "" then
            return nil, "dependency names must be non-empty strings"
        end
        if type(dep) ~= "table" then
            return nil, "dependencies." .. name .. " must be a table"
        end
        local kind = dep.kind or ""
        if kind ~= "c" and kind ~= "cargo" and kind ~= "rust" and kind ~= "luarocks" and kind ~= "types" then
            return nil, "dependencies."
                .. name
                .. ".kind must be \"c\", \"cargo\", \"rust\", \"luarocks\", or \"types\""
        end
        valid, err = validateKeys(dep, DEPENDENCY_KEYS[kind], "dependencies." .. name)
        if not valid then
            return nil, err
        end
        if dep.bindings ~= nil then
            if type(dep.bindings) ~= "table" then
                return nil, "dependencies." .. name .. ".bindings must be a table"
            end
            valid, err = validateKeys(dep.bindings, BINDING_KEYS, "dependencies." .. name .. ".bindings")
            if not valid then
                return nil, err
            end
            if dep.bindings.bridge ~= nil and type(dep.bindings.bridge) ~= "boolean" then
                return nil, "dependencies." .. name .. ".bindings.bridge must be a boolean"
            end
            if dep.bindings.cbindgen ~= nil and type(dep.bindings.cbindgen) ~= "boolean" then
                return nil, "dependencies." .. name .. ".bindings.cbindgen must be a boolean"
            end
            if dep.bindings.command ~= nil and (
                type(dep.bindings.command) ~= "string" or dep.bindings.command == ""
            ) then
                return nil, "dependencies." .. name .. ".bindings.command must be a non-empty string"
            end
            valid, err = validateOwnership(dep.bindings.ownership, "dependencies." .. name .. ".bindings.ownership")
            if not valid then
                return nil, err
            end
            if dep.bindings.macros ~= nil then
                if type(dep.bindings.macros) ~= "table" then
                    return nil, "dependencies." .. name .. ".bindings.macros must be a table"
                end
                for macro, recipe in pairs(dep.bindings.macros) do
                    local prefix = "dependencies." .. name .. ".bindings.macros." .. tostring(macro)
                    if type(macro) ~= "string" or macro == "" or type(recipe) ~= "table" then
                        return nil, prefix .. " must name a signature table"
                    end
                    valid, err = validateKeys(recipe, {"parameters", "result"}, prefix)
                    if not valid then
                        return nil, err
                    end
                    if type(recipe.parameters) ~= "table" then
                        return nil, prefix .. ".parameters must be an array of strings"
                    end
                    valid, err = validateArray(recipe.parameters, prefix .. ".parameters", "string")
                    if not valid then
                        return nil, err
                    end
                    if recipe.result ~= nil and type(recipe.result) ~= "string" then
                        return nil, prefix .. ".result must be a string"
                    end
                end
            end
        end
        valid, err = validateArray(dep.dependencies, "dependencies." .. name .. ".dependencies", "string")
        if not valid then
            return nil, err
        end
        if dep.kind == "luarocks" then
            valid, err = validateRock(dep, "dependencies." .. name)
            if not valid then
                return nil, err
            end
        end
        if dep.kind == "types" then
            if dep.format ~= "luacats" then
                return nil, "dependencies." .. name .. ".format must be \"luacats\""
            end
            if type(dep.source) ~= "table" or type(dep.source.git) ~= "string" or dep.source.git == "" then
                return nil, "dependencies." .. name .. ".source.git must be a non-empty string"
            end
            if type(
                dep.source.rev
            ) ~= "string" or not dep.source.rev:match("^[0-9a-fA-F]+$") or #dep.source.rev < 40 then
                return nil, "dependencies." .. name .. ".source.rev must be a full Git commit id"
            end
            if dep.path ~= nil and (type(dep.path) ~= "string" or dep.path == "") then
                return nil, "dependencies." .. name .. ".path must be a non-empty string"
            end
        end
        for _, child in ipairs(dep.dependencies or {}) do
            if type(dependencies[child]) ~= "table" then
                return nil, "dependencies." .. name .. ".dependencies references unknown dependency " .. child
            end
        end
        if dep.pkgConfig ~= nil then
            if type(dep.pkgConfig) == "string" then
                if dep.pkgConfig == "" then
                    return nil, "dependencies." .. name .. ".pkgConfig must not be empty"
                end
            elseif type(dep.pkgConfig) == "table" then
                local label = "dependencies." .. name .. ".pkgConfig"
                valid, err = validateArray(dep.pkgConfig, label, "string", true)
                if not valid then
                    return nil, err
                end
                for index, packageName in ipairs(dep.pkgConfig) do
                    if packageName == "" then
                        return nil, ("dependencies.%s.pkgConfig[%d] must be a non-empty string"):format(name, index)
                    end
                end
            else
                return nil, "dependencies." .. name .. ".pkgConfig must be a string or array of strings"
            end
        end
        if dep.kind == "c"
            and dep.linkage ~= nil
            and dep.linkage ~= "shared"
            and dep.linkage ~= "static"
            and dep.linkage ~= "both"
        then
            return nil, "dependencies." .. name .. ".linkage must be \"shared\", \"static\", or \"both\""
        end
        if dep.kind == "c" and dep.staticOut ~= nil then
            if type(dep.staticOut) ~= "string" or dep.staticOut == "" then
                return nil, "dependencies." .. name .. ".staticOut must be a non-empty string"
            end
            if dep.linkage ~= "static" and dep.linkage ~= "both" then
                return nil, "dependencies." .. name .. ".staticOut requires linkage = \"static\" or \"both\""
            end
        end
        if dep.kind == "c" and dep.artifacts ~= nil then
            local artifactLabel = "dependencies." .. name .. ".artifacts"
            if type(dep.artifacts) ~= "table" then
                return nil, artifactLabel .. " must be a table keyed by target triple"
            end
            local layouts = require("nupp.compiler.targetlayout")
            for triple, artifactSet in pairs(dep.artifacts) do
                local setLabel = artifactLabel .. "." .. tostring(triple)
                if type(triple) ~= "string" or not layouts.has(triple) then
                    return nil, artifactLabel .. " names unknown target " .. tostring(triple)
                end
                if type(artifactSet) ~= "table" then
                    return nil, setLabel .. " must be a table"
                end
                valid, err = validateKeys(artifactSet, NATIVE_ARTIFACT_SET_KEYS, setLabel)
                if not valid then
                    return nil, err
                end
                if artifactSet.shared == nil and artifactSet.static == nil then
                    return nil, setLabel .. " must provide shared, static, or both"
                end
                for _, artifactKind in ipairs({"shared", "static"}) do
                    local artifact = artifactSet[artifactKind]
                    if artifact ~= nil then
                        local oneLabel = setLabel .. "." .. artifactKind
                        if type(artifact) ~= "table" then
                            return nil, oneLabel .. " must be a table"
                        end
                        valid, err = validateKeys(artifact, NATIVE_ARTIFACT_KEYS, oneLabel)
                        if not valid then
                            return nil, err
                        end
                        if type(artifact.path) ~= "string" or artifact.path == "" then
                            return nil, oneLabel .. ".path must be a non-empty string"
                        end
                        if type(
                            artifact.sha256
                        ) ~= "string" or not artifact.sha256:match("^[0-9a-f][0-9a-f]+$") or #artifact.sha256 ~= 64 then
                            return nil, oneLabel .. ".sha256 must be a lowercase SHA-256"
                        end
                        if type(
                            artifact.size
                        ) ~= "number" or artifact.size < 1 or artifact.size ~= math.floor(artifact.size) then
                            return nil, oneLabel .. ".size must be a positive integer"
                        end
                    end
                end
            end
        end
    end

    local visiting, visited = {}, {}
    local function visit(name)
        if visiting[name] then
            return nil, "dependency cycle involving " .. name
        end
        if visited[name] then
            return true
        end
        visiting[name] = true
        for _, child in ipairs((dependencies[name] as manifest.Dependency).dependencies or {}) do
            local ok, cycleErr = visit(child)
            if not ok then
                return nil, cycleErr
            end
        end
        visiting[name], visited[name] = nil, true

        return true
    end

    for name in pairs(dependencies) do
        valid, err = visit(name)
        if not valid then
            return nil, err
        end
    end

    if config.build ~= nil and type(config.build) ~= "table" then
        return nil, "build must be a table"
    end
    local build = config.build
    if build then
        -- Only when the targets are named: a `build` that is one target inline is
        -- checked as that target, and against the target keys, further down.
        if build.targets ~= nil then
            valid, err = validateKeys(build, BUILD_KEYS, "build")
            if not valid then
                return nil, err
            end
        end
        if build.outDir ~= nil then
            valid, err = validateString(build.outDir, "build.outDir")
            if not valid then
                return nil, err
            end
        end
        if build.targets ~= nil then
            if type(build.targets) ~= "table" then
                return nil, "build.targets must be a table"
            end
            local targetCount = 0
            for name, target in pairs(build.targets) do
                targetCount = targetCount + 1
                if type(name) ~= "string" or name == "" then
                    return nil, "build target names must be non-empty strings"
                end
                if type(target) ~= "table" then
                    return nil, "build.targets." .. name .. " must be a table"
                end
                local effective = {}
                for key, value in pairs(build) do
                    if key ~= "targets" and key ~= "default" then
                        effective[key] = value
                    end
                end
                for key, value in pairs(target) do
                    effective[key] = value
                end
                valid, err = validateTarget(effective, "build.targets." .. name, dependencies)
                if not valid then
                    return nil, err
                end
            end
            if targetCount == 0 then
                return nil, "build.targets must not be empty"
            end
            if build.default ~= nil then
                valid, err = validateString(build.default, "build.default")
                if not valid then
                    return nil, err
                end
                if type(build.targets[build.default]) ~= "table" then
                    return nil, "build.default references unknown target " .. build.default
                end
            end
        else
            if build.default ~= nil then
                return nil, "build.default requires build.targets"
            end
            valid, err = validateTarget(build, "build", dependencies)
            if not valid then
                return nil, err
            end
        end
    end

    if config.test ~= nil then
        if type(config.test) ~= "table" then
            return nil, "test must be a table"
        end
        if not build then
            return nil, "test requires build configuration"
        end
        valid, err = validateKeys(config.test, TEST_KEYS, "test")
        if not valid then
            return nil, err
        end
        valid, err = validateArray(config.test.argv, "test.argv", "string", true)
        if not valid then
            return nil, err
        end
        if config.test.build ~= nil then
            valid, err = validateTargetReference(build, config.test.build, "test.build")
            if not valid then
                return nil, err
            end
        end
        if config.test.env ~= nil then
            if type(config.test.env) ~= "table" then
                return nil, "test.env must be a table"
            end
            for key, value in pairs(config.test.env) do
                if type(key) ~= "string" or type(value) ~= "string" then
                    return nil, "test.env keys and values must be strings"
                end
            end
        end
    end
    if config.tasks ~= nil then
        if type(config.tasks) ~= "table" then
            return nil, "tasks must be a table"
        end
        for name, task in pairs(config.tasks) do
            if type(name) ~= "string" or name == "" then
                return nil, "task names must be non-empty strings"
            end
            local label = "tasks." .. name
            if type(task) ~= "table" then
                return nil, label .. " must be a table"
            end
            valid, err = validateKeys(task, TASK_KEYS, label)
            if not valid then
                return nil, err
            end
            valid, err = validateArray(task.argv, label .. ".argv", "string", true)
            if not valid then
                return nil, err
            end
            if task.description ~= nil then
                valid, err = validateString(task.description, label .. ".description")
                if not valid then
                    return nil, err
                end
            end
            -- Unlike test.build, this doesn't require build configuration to exist at
            -- all: most tasks won't name one (nupp task itself doesn't build anything
            -- by default, see nupp.compiler.build.project.runTask), and a manifest with
            -- no build section is still a manifest a task can be defined in.
            if task.build ~= nil then
                valid, err = validateTargetReference(build, task.build, label .. ".build")
                if not valid then
                    return nil, err
                end
            end
            if task.env ~= nil then
                if type(task.env) ~= "table" then
                    return nil, label .. ".env must be a table"
                end
                for key, value in pairs(task.env) do
                    if type(key) ~= "string" or type(value) ~= "string" then
                        return nil, label .. ".env keys and values must be strings"
                    end
                end
            end
        end
    end
    if config.selfHost ~= nil then
        if type(config.selfHost) ~= "table" then
            return nil, "selfHost must be a table"
        end
        if not build then
            return nil, "selfHost requires build configuration"
        end
        valid, err = validateKeys(config.selfHost, SELF_HOST_KEYS, "selfHost")
        if not valid then
            return nil, err
        end
        if config.selfHost.target ~= nil then
            valid, err = validateTargetReference(build, config.selfHost.target, "selfHost.target")
            if not valid then
                return nil, err
            end
        end
        if config.selfHost.bootstrapTarget ~= nil then
            valid, err = validateTargetReference(build, config.selfHost.bootstrapTarget, "selfHost.bootstrapTarget")
            if not valid then
                return nil, err
            end
        end
        if config.selfHost.bootstrap ~= nil then
            valid, err = validateString(config.selfHost.bootstrap, "selfHost.bootstrap")
            if not valid then
                return nil, err
            end
        end
    end

    return true
end

--- Reads `root/nupp.lua` and validates the whole of it.
---
--- @param root the project directory, "." by default
--- @return the manifest, or nil when it could not be read or does not check out
--- @return why, ready to print
function manifest.load(root: string?): manifest.Config?, string?
    root = root or "."
    local path = join(root, "nupp.lua")
    local chunk, loadErr = loadfile(path)
    if not chunk then
        return nil, "nupp: cannot load " .. path .. ": " .. tostring(loadErr)
    end
    local ok, config = pcall(chunk)
    if not ok then
        return nil, "nupp: " .. path .. ": " .. tostring(config)
    end
    if type(config) ~= "table" then
        return nil, "nupp: " .. path .. " must return a table"
    end
    local valid, err = validateManifest(config)
    if not valid then
        return nil, "nupp: " .. tostring(err)
    end

    return config
end

export = manifest
