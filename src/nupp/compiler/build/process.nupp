--[[
Running a subprocess, given its argument vector.

There is no `exec` to reach for: a program is started by handing a single string
to the system shell, which means every argument has to be quoted for the shell
that will read it. Windows and POSIX disagree about how, so quoting is the whole
of this module, and callers pass an argv and never build a command line.
]]

local process = {}

--- Where a command runs and what it runs with.
---
--- Both are folded into the command line rather than handed to a spawn call, because
--- there is no spawn call to hand them to: `cd` and the shell's own assignment syntax
--- are what a single string can say.
type process.Options = {
    cwd: string?,
    env: {[string]: string}?,
    timeoutMs: integer?,

    --- POSIX child address-space ceiling. Used for compiler workers whose inputs may
    --- ask for large allocations; absent for ordinary subprocesses.
    memoryMb: integer?,

    --- Work the host may service while an isolated child is quiet, and a request
    --- cancellation predicate checked after each service pass.
    pump: (function(): nil)?,
    cancelled: (function(): boolean)?
}

type process.IsolatedProcess = {
    stdin: any,
    stdout: any,
    backend: any,
    handle: any,
    isRunning: function(any): boolean,
    kill: function(any, boolean?): (boolean, string?),
    close: function(any): (boolean, string?)
}

local windows = package.config:sub(1, 1) == "\\"

-- The Windows test host runs its shell-facing cases through MSYS, whose
-- `tmpname` wrapper answers `/c/...`. Product commands still run under cmd.exe,
-- so their redirection path must be returned to the native spelling first.
local function nativePath(path)
    if windows then
        return (path:gsub("^/([A-Za-z])(/)", "%1:%2"))
    end
    return path
end

local function quote(arg)
    arg = tostring(arg)
    if windows then
        if not arg:find('[%s"]') then
            return arg
        end
        return '"' .. arg:gsub('(\\*)"', '%1%1\\"'):gsub('(\\+)$', '%1%1') .. '"'
    end

    return "'" .. arg:gsub("'", "'\\''") .. "'"
end

local function launchArgs(argv: {string}): {string}
    local testBash = windows and (
        rawget(_G, "__NUPP_TEST_BASH") or os.getenv("NUPP_TEST_BASH")
    ) or nil
    if not testBash or not tostring(argv[1]):gsub("\\", "/"):match("/bin/nupp$") then
        return argv
    end

    local launched = {testBash}
    for _, arg in ipairs(argv) do
        launched[#launched + 1] = arg
    end
    return launched
end

local function exists(path: string): boolean
    local file = io.open(path, "rb")
    if not file then
        return false
    end
    file:close()

    return true
end

-- MSYS cannot replace itself with a native executable, so killing a Bash-wrapped
-- worker leaves its LuaJIT child alive with the capture pipe open. The launcher
-- normally has this entry built before the compiler can reach here, so start it
-- directly and let the handle being timed out or cancelled be the worker itself.
--
-- The first build of a clean checkout is the exception: nothing has built that entry
-- yet, and `bin/nupp` would fall back to the bootstrap compiler rather than run a
-- file that is not there. Fall back the same way, or every comptime evaluation in
-- the build that produces the compiler fails for want of a worker.
local function isolatedArgs(argv: {string}): {string}
    if windows then
        local executable = tostring(argv[1]):gsub("\\", "/")
        local root = executable:match("^(.*)/bin/nupp$")
        if root then
            local built = root .. "/build/nupp/compiler/main.lua"
            local path = ("package.path=%q .. package.path")
                :format(root .. "/build/?.lua;")
            local launched = {
                "luajit", "-e", path, exists(built) and built or root .. "/bootstrap/nupp.lua"
            }
            for index = 2, #argv do
                launched[#launched + 1] = argv[index]
            end
            return launched
        end
    end

    return launchArgs(argv)
end

function process.command(argv: {string}, opts: process.Options?): string
    assert(type(argv) == "table" and #argv > 0, "argv must not be empty")
    opts = (opts or {}) as process.Options
    argv = launchArgs(argv)
    local parts = {}
    if opts.env then
        local names = {}
        for name in pairs(opts.env) do
            names[#names + 1] = name
        end
        table.sort(names)
        for _, name in ipairs(names) do
            assert(name:match("^[%a_][%w_]*$"), "invalid environment name")
            if windows then
                -- The closing quote, rather than whitespace before `&&`, ends
                -- the value. `set NAME=value &&` stores that space in NAME.
                parts[#parts + 1] = 'set "' .. name .. "=" .. tostring(opts.env[name]) .. '"'
                parts[#parts + 1] = "&&"
            else
                parts[#parts + 1] = name .. "=" .. quote(opts.env[name])
            end
        end
    end
    for _, arg in ipairs(argv) do
        parts[#parts + 1] = quote(arg)
    end
    local command = table.concat(parts, " ")
    if opts.cwd then
        command = windows and (
            "cd /d " .. quote(opts.cwd) .. " && " .. command
        ) or ("cd " .. quote(opts.cwd) .. " && " .. command)
    end

    -- The Windows test runner keeps legacy handwritten shell tests in Bash,
    -- but argv-based product commands must retain cmd.exe semantics. The
    -- runner strips this out-of-band marker before handing this command to the
    -- native shell.
    local testMarker = windows and rawget(_G, "__NUPP_TEST_CMD_MARKER") or nil
    return testMarker and (testMarker .. command) or command
end

function process.mkdirCommand(path: string, forWindows: boolean?): {string}
    path = tostring(path)
    if forWindows == nil then
        forWindows = windows
    end
    if forWindows then
        -- cmd.exe's mkdir does not accept normalized forward-slash paths and, unlike
        -- mkdir -p, reports an error when the directory already exists.
        path = path:gsub("/", "\\")
        return {"cmd", "/d", "/c", "if", "not", "exist", path, "mkdir", path}
    end

    return {"mkdir", "-p", path}
end

local function exitCode(status)
    if status == true then
        return 0
    end
    if type(status) ~= "number" then
        return 1
    end
    if status > 255 then
        return math.floor(status / 256)
    end

    return status
end

function process.run(argv: {string}, opts: process.Options?): integer
    return exitCode(os.execute(process.command(argv, opts)))
end

function process.capture(argv: {string}, opts: process.Options?): integer, string
    opts = (opts or {}) as process.Options
    local tmp = nativePath(os.tmpname())
    local command = process.command(argv, opts) .. " >" .. quote(tmp) .. " 2>&1"
    local code = exitCode(os.execute(command))
    local f = io.open(tmp, "rb")
    local output = f and f:read("*a") or ""
    if f then
        f:close()
    end
    os.remove(tmp)

    return code, output
end

--- Runs one command in its own process and bounds how long the caller waits. Output is
--- drained through the portable process provider, leaving the caller free to service
--- protocol input and cancel the child on every quiet wait.
function process.captureIsolated(argv: {string}, opts: process.Options?): integer, string
    opts = (opts or {}) as process.Options
    local args = isolatedArgs(argv)
    if opts.memoryMb and not windows then
        local kilobytes = math.max(1, math.floor(opts.memoryMb * 1024))
        args = {
            "/bin/sh",
            "-c",
            "ulimit -v " .. tostring(kilobytes) .. " 2>/dev/null || true; exec "
                .. process.command(argv),
        }
    end
    local native = require("nupp.io.process")
    local child, problem = native.new({
        args = args,
        cwd = opts.cwd,
        env = opts.env,
        stdin = "null",
        stdout = "pipe",
        stderr = "stdout",
        timeoutMs = opts.timeoutMs,
    })
    if not child then
        return 1, tostring(problem or "the worker could not be started")
    end
    local reader = assert(child.stdout)
    reader:setTimeout(5)
    local chunks = {}
    local cancelled = false
    while true do
        local moved = false
        while true do
            local chunk = reader:poll()
            if chunk == nil then
                break
            end
            if #chunk == 0 then
                break
            end
            chunks[#chunks + 1] = chunk
            moved = true
        end
        if opts.pump then
            opts.pump()
        end
        if not cancelled and opts.cancelled and opts.cancelled() then
            cancelled = true
            child:kill(true)
        end
        local running = child:isRunning()
        if not running and reader:isEOF() then
            break
        end
        if not moved and not reader:isEOF() then
            local chunk, reason = reader:read(65536)
            if chunk and #chunk > 0 then
                chunks[#chunks + 1] = chunk
            elseif reason and not reason:find("timed out", 1, true) then
                child:kill(true)
                chunks[#chunks + 1] = reason
            end
        end
    end
    local exit = child:wait()
    child:close()
    if cancelled then
        return 125, table.concat(chunks)
    end
    if exit.timedOut then
        return 124, table.concat(chunks)
    end

    return exit.exitCode, table.concat(chunks)
end

--- Starts the same bounded child used by `captureIsolated`, but leaves its framed
--- stdin/stdout open for a session service. The caller owns and must close it.
@owned(opaque = true)
function process.startIsolated(argv: {string}, opts: process.Options?): (process.IsolatedProcess?, string?)
    opts = (opts or {}) as process.Options
    local args = isolatedArgs(argv)
    if opts.memoryMb and not windows then
        local kilobytes = math.max(1, math.floor(opts.memoryMb * 1024))
        args = {
            "/bin/sh",
            "-c",
            "ulimit -v " .. tostring(kilobytes) .. " 2>/dev/null || true; exec "
                .. process.command(argv),
        }
    end
    local native = require("nupp.io.process")
    return native.new({
        args = args,
        cwd = opts.cwd,
        env = opts.env,
        stdin = "pipe",
        stdout = "pipe",
        stderr = "stdout",
    })
end

return process
