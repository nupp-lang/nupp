--[[
Running a subprocess, given its argument vector.

There is no `exec` to reach for: a program is started by handing a single string
to the system shell, which means every argument has to be quoted for the shell
that will read it. Windows and POSIX disagree about how, so quoting is the whole
of this module, and callers pass an argv and never build a command line.
]]

local process = {}

--- Where a command runs and what it runs with.
---
--- Both are folded into the command line rather than handed to a spawn call, because
--- there is no spawn call to hand them to: `cd` and the shell's own assignment syntax
--- are what a single string can say.
type process.Options = {
    cwd: string?,
    env: {[string]: string}?,
    timeoutMs: integer?,

    --- POSIX child address-space ceiling. Used for compiler workers whose inputs may
    --- ask for large allocations; absent for ordinary subprocesses.
    memoryMb: integer?
}

local windows = package.config:sub(1, 1) == "\\"

local function quote(arg)
    arg = tostring(arg)
    if windows then
        if not arg:find('[%s"]') then
            return arg
        end
        return '"' .. arg:gsub('(\\*)"', '%1%1\\"'):gsub('(\\+)$', '%1%1') .. '"'
    end

    return "'" .. arg:gsub("'", "'\\''") .. "'"
end

function process.command(argv: {string}, opts: process.Options?): string
    assert(type(argv) == "table" and #argv > 0, "argv must not be empty")
    opts = (opts or {}) as process.Options
    local parts = {}
    if opts.env then
        local names = {}
        for name in pairs(opts.env) do
            names[#names + 1] = name
        end
        table.sort(names)
        for _, name in ipairs(names) do
            assert(name:match("^[%a_][%w_]*$"), "invalid environment name")
            if windows then
                parts[#parts + 1] = "set " .. name .. "=" .. tostring(opts.env[name])
                parts[#parts + 1] = "&&"
            else
                parts[#parts + 1] = name .. "=" .. quote(opts.env[name])
            end
        end
    end
    for _, arg in ipairs(argv) do
        parts[#parts + 1] = quote(arg)
    end
    local command = table.concat(parts, " ")
    if opts.cwd then
        command = windows and (
            "cd /d " .. quote(opts.cwd) .. " && " .. command
        ) or ("cd " .. quote(opts.cwd) .. " && " .. command)
    end

    return command
end

function process.mkdirCommand(path: string, forWindows: boolean?): {string}
    path = tostring(path)
    if forWindows == nil then
        forWindows = windows
    end
    if forWindows then
        -- cmd.exe's mkdir does not accept normalized forward-slash paths and, unlike
        -- mkdir -p, reports an error when the directory already exists.
        path = path:gsub("/", "\\")
        return {"cmd", "/d", "/c", "if", "not", "exist", path, "mkdir", path}
    end

    return {"mkdir", "-p", path}
end

local function exitCode(status)
    if status == true then
        return 0
    end
    if type(status) ~= "number" then
        return 1
    end
    if status > 255 then
        return math.floor(status / 256)
    end

    return status
end

function process.run(argv: {string}, opts: process.Options?): integer
    return exitCode(os.execute(process.command(argv, opts)))
end

function process.capture(argv: {string}, opts: process.Options?): integer, string
    opts = (opts or {}) as process.Options
    local tmp = os.tmpname()
    local command = process.command(argv, opts) .. " >" .. quote(tmp) .. " 2>&1"
    local code = exitCode(os.execute(command))
    local f = io.open(tmp, "rb")
    local output = f and f:read("*a") or ""
    if f then
        f:close()
    end
    os.remove(tmp)

    return code, output
end

--- Runs one command in its own process and bounds how long the caller waits.
---
--- This is the minimum process primitive the comptime worker needs. The command writes
--- only to its private output file, so a crash cannot corrupt a protocol stream. On
--- POSIX the asynchronous command's pid is killed when the wall-clock limit expires.
--- Windows retains the synchronous fallback until the native process host supplies the
--- same primitive there; the evaluator's deterministic step budget still bounds Nupp
--- execution on that path.
function process.captureIsolated(argv: {string}, opts: process.Options?): integer, string
    opts = (opts or {}) as process.Options
    if windows or not opts.timeoutMs then
        return process.capture(argv, opts)
    end

    local ffi = require("ffi")
    local hasTimeval = pcall(ffi.typeof, "struct nupp_timeval[1]")
    if not hasTimeval then
        local micros = ffi.os == "Linux" and "long" or "int"
        assert(loadstring(([=[local ffi = require("ffi"); ffi.cdef[[
            struct nupp_timeval { long tv_sec; %s tv_usec; };
            int gettimeofday(struct nupp_timeval *timeval, void *timezone);
        ]]]=]):format(micros), "=nupp-process-cdef"))()
    end
    assert(loadstring([=[local ffi = require("ffi"); ffi.cdef[[
        int kill(int pid, int signal);
        int usleep(unsigned int microseconds);
    ]]]=], "=nupp-process-control-cdef"))()
    local C: any = ffi.C
    local timevalType: any = "struct nupp_timeval[1]"
    local function now(): number
        local value: any = ffi.new(timevalType)
        C.gettimeofday(value, nil)
        return assert(tonumber(value[0].tv_sec)) + assert(tonumber(value[0].tv_usec)) / 1000000
    end

    local outputPath, pidPath = os.tmpname(), os.tmpname()
    os.remove(pidPath)
    local command = process.command(argv, opts)
    if opts.memoryMb then
        local kilobytes = math.max(1, math.floor(opts.memoryMb * 1024))
        command = "(ulimit -v " .. tostring(kilobytes)
            .. " 2>/dev/null || true; " .. command .. ")"
    end
    command = command .. " >" .. quote(outputPath) .. " 2>&1 & echo $! >" .. quote(pidPath)
    local launched = exitCode(os.execute(command))
    if launched ~= 0 then
        os.remove(outputPath)
        os.remove(pidPath)
        return launched, ""
    end

    local pid
    for _ = 1, 100 do
        local file = io.open(pidPath, "rb")
        if file then
            pid = tonumber(file:read("*a"))
            file:close()
            if pid then
                break
            end
        end
        C.usleep(1000)
    end
    if not pid then
        os.remove(outputPath)
        os.remove(pidPath)
        return 1, "the worker did not publish its process id"
    end

    local deadline = now() + opts.timeoutMs / 1000
    local timedOut = false
    while C.kill(pid, 0) == 0 do
        if now() >= deadline then
            timedOut = true
            C.kill(pid, 9)
            break
        end
        C.usleep(5000)
    end
    local file = io.open(outputPath, "rb")
    local output = file and file:read("*a") or ""
    if file then
        file:close()
    end
    os.remove(outputPath)
    os.remove(pidPath)

    return timedOut and 124 or 0, output
end

return process
