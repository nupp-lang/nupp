module nupp.compiler.build.aot

--[[
The build's ahead-of-time policy.

A build selects one policy before it looks at any `@aot` body, and an artifact
records the one it was built under. There is deliberately no mode that quietly
mixes compiled functions with ordinary fallbacks: disabling compilation changes
performance and packaging, never an answer, and a build that had silently done
half of each would be a build whose speed nobody could reason about.

- `off` does not look for `@aot` at all. It is the default, so a project that
  has not asked for native code never depends on a C compiler.
- `emit-c` verifies the IR and writes the C beside the build, without compiling
  it. A platform build can hand that to its own vendor compiler, and a reviewer
  can read what the backend actually produced.
- `require` compiles that C into the project's own shared library, and fails the
  build when it cannot. Choosing it is how a project accepts a C compiler as a
  dependency; nothing else in Nupp makes a project depend on one.

Code is linked, never mapped at run time. An ordinary build loads one shared
library; a standalone binary links the same objects from an archive into its
host. Neither route needs a W^X policy, `MAP_JIT`, an executable-memory budget,
or code retirement. Those return if and when direct machine-code emission does.

This pass finds its work by reading sources rather than the module build's
bookkeeping, so it cannot be wrong about which source produced which artifact.
What it lowers is the checked tree of each of those sources, taken from the same
query graph the module build then uses: a parse says how a parameter, a call
target or an annotation was spelled, and only a check says what each resolved
to.
]]

local bindingRules = require("nupp.compiler.aot.binding")
local gpuBinding = require("nupp.compiler.aot.gpubinding")
local wasmBinding = require("nupp.compiler.aot.wasmbinding")
local wasmEmitter = require("nupp.compiler.aot.wasmemit")
local compile = require("nupp.compiler.aot.compile")
local constspecialize = require("nupp.compiler.constspecialize")
local emitter = require("nupp.compiler.aot.emit")
local diagnosticMod = require("nupp.compiler.diagnostics")
local fs = require("nupp.compiler.fs")
local envMod = require("nupp.compiler.env")
local cache = require("nupp.compiler.build.cache")
local hash = require("nupp.compiler.build.hash")
local process = require("nupp.compiler.build.process")
local scalarIR = require("nupp.compiler.aot.scalar")
local targets = require("nupp.compiler.aot.target")
local profiles = require("nupp.compiler.targetprofile")

local isFatal = diagnosticMod.isFatal

local aot = {}

--- The policies a target may select.
const aot.POLICIES = {
    ["off"] = true,
    ["emit-c"] = true,
    ["require"] = true,
    ["emit-wasm"] = true,
    ["require-wasm"] = true,
}

--- Whether a policy has to produce native code to succeed.
function aot.linksNative(policy: string?): boolean
    return policy == "require"
end

function aot.linksWasm(policy: string?): boolean
    return policy == "emit-wasm" or policy == "require-wasm"
end

--- A C toolchain this backend can use.
record aot.Toolchain
    --- The command that runs it.
    command: string

    --- The first line it printed when asked. This is what pins an artifact to
    --- it: the same `cc` is two compilers on two machines, and one compiler
    --- answers to several names, so the name alone says nothing.
    version: string

    --- Whose warning vocabulary it speaks, which decides the dialect flags.
    dialect: string

    --- Pack-owned tools and target/sysroot flags. Absent for an ambient compiler.
    archiver: string?

    packCompileFlags: {string}?
    packLinkFlags: {string}?
end

--- What the generated C needs from a compiler.
---
--- `vector_size` and `__builtin_convertvector` are in GCC 9 and later and in
--- every Clang. MSVC has neither.
---
--- That is a statement about a compiler rather than about a platform. Windows is
--- an ordinary target here: Clang and MinGW GCC both run there and both have the
--- two extensions, and a Windows project that has one needs nothing further. A
--- project whose only compiler is MSVC selects `emit-c` and hands the C to it --
--- which is what `emit-c` is for -- or installs one of the two.
const aot.NEEDS = "__attribute__((vector_size)) and __builtin_convertvector"

--- The oldest GCC that has them.
const aot.OLDEST_GCC = 9

--- How the generated C is compiled.
---
--- `-Werror` because this is compiler-generated C: a warning in it is a defect
--- in the backend, not a style opinion about someone's source. The one that
--- matters most is `-Wpsabi`, which is how a vector with no register class
--- announces itself, and silencing it would make the target model pointless.
---
--- `-ffp-contract=off` and `-fno-fast-math` are the numeric contract. A body
--- that asked for contraction carries its own pragma, so the flag is a floor
--- rather than a ceiling.
const aot.CFLAGS = {"-std=c11", "-O3", "-ffp-contract=off", "-fno-fast-math", "-Wall", "-Wextra", "-Werror",}

--- Warnings only one dialect knows the name of.
const aot.DIALECT_FLAGS = {["clang"] = {"-Wno-parentheses-equality"}, ["gcc"] = {}}

--- The flag that gives a feature tier its instructions.
---
--- A tier with no entry compiles for the architecture's baseline. That is not
--- an oversight: `target` already decided whether a gang exists, and a flag
--- here that decided it a second time could disagree with the code it is
--- compiling.
const aot.TIER_FLAGS = {["avx2"] = "-mavx2", ["avx512f"] = "-mavx512f", ["simd128"] = "-msimd128"}

--- Which backend produced an artifact.
---
--- Part of the key because two backends can lower one IR to two correct
--- answers, and an artifact from either must not be mistaken for the other's.
const aot.BACKEND = "generated-c"

--- The key one artifact was built under.
---
--- Everything that can change the bytes: the verified IR, the vocabulary it is
--- written in, what its arithmetic means, the target it was chosen for, the
--- backend that lowered it, and the compiler that did all of that.
---
--- Deliberately not the source text. Two sources that lower to one IR produce
--- one artifact, and a comment edit is not a rebuild.
---
--- Deliberately not the C toolchain either. The C is the same C whoever
--- compiles it; what the toolchain changes is the library, which
--- `aot.libraryKey` covers.
function aot.key(irText: string, selected: targets.Target): string
    return hash.digest(
        cache.stable({
            ir = irText,
            irVersion = scalarIR.VERSION,
            numericContract = scalarIR.NUMERIC_CONTRACT,
            triple = selected.triple,
            tier = selected.tier,
            backend = aot.BACKEND,
            compiler = cache.toolFingerprint(),
        })
    )
end

--- Every flag the generated C is compiled with, in the order it is given them.
---
--- One function so the flags that are compiled with and the flags that are
--- keyed on cannot come apart. A relink that used a flag the key never saw
--- would produce a library the build could not account for.
function aot.compileFlags(selected: targets.Target, chain: aot.Toolchain, extra: {string}?): {string}
    local flags: {string} = {}
    for _, flag in ipairs(aot.CFLAGS) do
        flags[#flags + 1] = flag
    end
    -- Only when the triple is not this machine's. Clang cross-compiles from one
    -- installation and takes `-target`; GCC does not, and passing it a flag it
    -- has never heard of to say "produce what you already produce" would refuse
    -- every ordinary build to serve the uncommon one.
    if selected.triple ~= targets.hostTriple() and chain.dialect == "clang" then
        flags[#flags + 1] = "-target"
        flags[#flags + 1] = selected.triple
    end
    if targets.system(selected.triple) ~= "windows" then
        flags[#flags + 1] = "-fPIC"
    end
    for _, flag in ipairs(chain.packCompileFlags or {}) do
        flags[#flags + 1] = flag
    end
    -- Last, so a project can override what is above it, and part of what the
    -- library is keyed on because a flag that changes the output has to.
    for _, flag in ipairs(extra or {}) do
        flags[#flags + 1] = flag
    end
    for _, flag in ipairs(aot.DIALECT_FLAGS[chain.dialect] or {}) do
        flags[#flags + 1] = flag
    end
    local tier = aot.TIER_FLAGS[selected.tier]
    if tier ~= nil then
        flags[#flags + 1] = tier as string
    end

    return flags
end

--- Rejects project flags that could make the baseline unit non-baseline.
---
--- Tier flags belong to the compiler once several objects share a library.
--- Allowing `-march=native` or LTO to cross those object boundaries would make
--- the fallback carry instructions its name says it does not. Sysroots,
--- include paths, deployment targets and ordinary vendor flags remain valid.
function aot.multiversionFlagError(extra: {string}?): string?
    for _, flag in ipairs(extra or {}) do
        local lower = flag:lower()
        if lower:match(
            "^%-march"
        ) ~= nil or lower:match(
            "^%-mcpu"
        ) ~= nil or lower:match(
            "^%-mtune"
        ) ~= nil or lower:match(
            "^%-mavx"
        ) ~= nil or lower:match(
            "^%-mno%-avx"
        ) ~= nil or lower:match(
            "^%-msse"
        ) ~= nil or lower:match("^%-mfma") ~= nil or lower:match("^%-flto") ~= nil or lower:match("^/arch:") ~= nil then
            return "aotCflags entry " .. flag .. " changes the CPU tier; multiversion builds own ISA and LTO flags"
        end
    end

    return nil
end

--- Flags used only while linking already tiered objects.
function aot.linkFlags(selected: targets.Target, chain: aot.Toolchain, extra: {string}?): {string}
    local flags: {string} = {}
    if selected.triple ~= targets.hostTriple() and chain.dialect == "clang" then
        flags[#flags + 1] = "-target"
        flags[#flags + 1] = selected.triple
    end
    for _, flag in ipairs(chain.packLinkFlags or {}) do
        flags[#flags + 1] = flag
    end
    for _, flag in ipairs(extra or {}) do
        flags[#flags + 1] = flag
    end

    return flags
end

--- The key the linked library was built under.
---
--- The artifact keys it was built from, plus what turned them into a library:
--- the compiler that ran, the flags it ran with, and the platform whose linkage
--- was asked for. The artifact keys already carry the IR and the target, so
--- this does not repeat them.
function aot.libraryKey(keys: {string}, chain: aot.Toolchain, flags: {string}, linkage: {string}): string
    local ordered: {string} = {}
    for _, one in ipairs(keys) do
        ordered[#ordered + 1] = one
    end
    -- Sorted because the order sources are discovered in is the file system's,
    -- and a library that relinked when a directory listing changed order would
    -- be a cache that never hit.
    table.sort(ordered)

    return hash.digest(
        cache.stable({
            artifacts = ordered,
            toolchain = chain.version,
            flags = flags,
            linkage = linkage,
        })
    )
end

--- What one source produced.
record aot.Emitted
    --- The source it came from.
    source: string

    --- The feature tier this translation unit was lowered and compiled for.
    tier: string

    --- The stable state key, distinct for every `(source, tier)` pair.
    cacheKey: string

    --- Where the C was written.
    output: string

    --- The key it was built under, which the next build compares against.
    key: string

    --- The compiled object, when the policy links rather than only emitting C.
    object: string?

    --- True for a compiler-owned unit, which came from no source and so has
    --- no artifacts behind it: the baseline feature detector, and the archive
    --- probe a static link needs.
    detector: boolean?

    --- Which compiler-owned unit this is, for a manifest consumer that has to
    --- tell them apart.
    role: string?

    --- The side-module C and Wasm artifact when a Wasm policy selected them.
    wasmSource: string?

    wasm: string?
    registrar: string?
    unit: string?
end

--- The commands to try, in order, when nothing named one.
---
--- Clang first because the emitter's contraction pragma is Clang's, so a body
--- that asked for contraction gets it. GCC compiles the same C correctly and
--- declines to contract, which is slower and never wrong.
const aot.CANDIDATES = {"clang", "cc", "gcc"}

--- The same list where Clang is not the one to reach for first.
---
--- On Windows a plain `clang` targets MSVC and links with `link.exe`, which
--- cannot read the GNU import library that a MinGW build of LuaJIT leaves --
--- and a MinGW build is what Nupp provisions for itself. The entry has to be
--- linked by a toolchain that can bind to the interpreter about to open it, so
--- the interpreter's own toolchain goes first. `NUPP_NATIVE_CC` still names
--- whichever one a machine with an MSVC LuaJIT wants.
const aot.WINDOWS_CANDIDATES = {"gcc", "cc", "clang"}

--- What a compiler said about itself, read as a dialect and a version.
---
--- Parsed from `--version` rather than from the command name, because a `cc`
--- that is Clang and a `clang` that is a GCC wrapper are both ordinary.
function aot.identify(text: string): (string?, integer?)
    local first = text:match("^[^\n]*") or ""
    if first:lower():find("clang", 1, true) ~= nil then
        return "clang", tonumber(first:match("version (%d+)")) as integer?
    end
    -- GCC puts its version after the distribution's parenthetical, and what
    -- comes after that varies: Debian stops there, Red Hat adds a build date and
    -- a second parenthetical. Reading the number that follows the first `)` gets
    -- all of them, where matching the end of the line only gets some -- and
    -- failing to read a version is refusing a compiler that works.
    if first:lower():find("gcc", 1, true) ~= nil or first:find("Free Software Foundation") ~= nil then
        local after = first:match("%)%s*(%d+)%.%d+")
        return "gcc", tonumber(after or first:match("(%d+)%.%d+")) as integer?
    end

    return nil, nil
end

--- Finds a C compiler that can build the generated C.
---
--- `NUPP_NATIVE_CC` names one outright, and naming one that cannot build this C
--- is an error rather than a reason to look elsewhere: a build that quietly
--- used a different compiler than it was told to would produce an artifact
--- nobody could account for.
---
--- @return the toolchain, or nothing and why there is none
function aot.toolchain(targetTriple: string?): (aot.Toolchain?, string?)
    local named = os.getenv("NUPP_NATIVE_CC")
    local pack, packErr = require("nupp.compiler.build.compilerpacks").resolve(targetTriple or targets.hostTriple())
    if packErr ~= nil and named == nil then
        return nil, packErr
    end
    local onWindows = (jit and jit.os or ""):lower() == "windows"
    local preferred = onWindows and aot.WINDOWS_CANDIDATES or aot.CANDIDATES
    local candidates = named ~= nil and {named as string} or pack ~= nil and {(pack as any).cc} or preferred
    local refusals: {string} = {}
    for _, command in ipairs(candidates) do
        local code, text = process.capture({command, "--version"})
        if code ~= 0 then
            refusals[#refusals + 1] = command .. " could not be run"
        else
            local dialect, version = aot.identify(text)
            if dialect == nil then
                refusals[
                    #refusals + 1
                ] = ("%s is not GCC or Clang, and %s needs %s"):format(command, "the generated C", aot.NEEDS)
            elseif dialect == "gcc" and (version or 0) < aot.OLDEST_GCC then
                refusals[
                    #refusals + 1
                ] = ("%s is GCC %s; %s arrived in GCC %d"):format(command, tostring(version), aot.NEEDS, aot.OLDEST_GCC)
            else
                return new aot.Toolchain(
                    command = command,
                    version = pack and (
                        (pack as any).version .. ":" .. (text:match("^[^\n]*") or command)
                    ) or (text:match("^[^\n]*") or command) as string,
                    dialect = dialect as string,
                    archiver = pack and (pack as any).ar or nil,
                    packCompileFlags = pack and (pack as any).compileFlags or nil,
                    packLinkFlags = pack and (pack as any).linkFlags or nil
                ), nil
            end
        end
    end

    return nil, "aot = \"require\" needs a C compiler: " .. table.concat(
        refusals,
        "; "
    ) .. ". Name one with NUPP_NATIVE_CC, or select aot = \"emit-c\" to write the C without building it"
end

--- Whether a source is worth parsing for `@aot` at all.
---
--- A substring test rather than a parse. It is allowed to say yes wrongly -- a
--- comment mentioning the annotation costs one parse that finds nothing -- and
--- it must never say no wrongly, which is why it looks for the bare word rather
--- than trying to tell an annotation from prose.
local function mentionsAot(text: string): boolean
    return text:find("@aot", 1, true) ~= nil
end

--- Whether source may need the compiler-carried GPU runtime while it is checked.
--- Allowed to answer yes for a comment or string, like `mentionsAot`; a false
--- positive stages one unused source file, while a false negative makes a real GPU
--- declaration impossible to type.
local function mentionsGpuTarget(text: string): boolean
    return mentionsAot(text) and text:match("target%s*=%s*[\"']gpu[\"']") ~= nil
end

--- One source's checked tree, or nothing when there is no sound one to lower.
---
--- The tree the checker produced rather than a fresh parse of the same bytes.
--- What the backend needs from a parameter, a call target or an annotation is
--- what each of those resolved to, and only a checked tree carries that; a parse
--- carries the spelling and leaves the backend to guess the rest.
---
--- Nothing, rather than an error, when the source does not check. The module
--- build checks the same file through the same graph a moment later and reports
--- it there, in the one place a source error is reported. Lowering it here would
--- either say the same thing twice or describe a program the checker has already
--- refused.
---
--- The exception is `unused-binding`, which is returned rather than dropped. A
--- linking policy replaces each `@aot` declaration with its wrapper before the
--- module build checks the file, so by then the removed body is not there to be
--- the reader of anything, and that lint would report a binding the author can
--- see being used. This check is the one that read the file as written, so its
--- verdict is the answer, and it is carried to the module build to report in
--- place of the rewritten source's.
---
--- @return the checked tree, and what it said about bindings nothing reads
local function checkedTree(
    session: nupp.compiler.build.modules.Session,
    source: string
): (nupp.compiler.parser.ParseResult?, {any})
    local checked = session.inc.checkFile(source)
    if checked.missing == true or checked.syntax == true or checked.result == nil then
        return nil, {}
    end
    local authored: {any} = {}
    for _, diagnostic in ipairs(checked.diags or {}) do
        if isFatal(diagnostic) then
            return nil, {}
        end
        if (diagnostic as any).code == "NUPP2507" then
            authored[#authored + 1] = diagnostic
        end
    end

    return checked.result as nupp.compiler.parser.ParseResult, authored
end

--- The Lua import library a Windows link needs, or nothing.
---
--- An entry that drives the VM calls `lua_*`. POSIX leaves those undefined in a
--- shared library and the loader binds them to the host that opened it, so
--- nothing has to be found. Windows resolves every symbol at link time, so the
--- same entry needs the import library of the interpreter that will open it --
--- and one from a different Lua would link and then call into the wrong VM.
---
--- Named directly by NUPP_LUA_LIB. Otherwise taken from beside the `luajit` on
--- PATH, which is the interpreter about to load this, and where LuaJIT's own
--- MSVC build leaves `lua51.lib`.
function aot.luaImportLibrary(): string?
    local named = os.getenv("NUPP_LUA_LIB")
    if named ~= nil and named ~= "" then
        return named as string
    end
    -- The interpreter Nupp provisioned for itself, when it did. That is exactly
    -- the one about to open this entry, and it is not on PATH: the launcher runs
    -- it by name rather than putting its directory there, so a search of PATH
    -- looked past the only LuaJIT that mattered.
    local provisioned = os.getenv("NUPP_TOOLCHAIN_LUAJIT")
    if provisioned ~= nil and provisioned ~= "" then
        local root = (tostring(provisioned):gsub("\\", "/"):gsub("/+$", ""))
        for _, name in ipairs({"lib/liblua51.a", "lib/libluajit-5.1.dll.a", "bin/lua51.lib", "lib/lua51.lib",}) do
            if fs.exists(root .. "/" .. name) then
                return root .. "/" .. name
            end
        end
    end

    -- Two spellings, because two toolchains build LuaJIT on this platform and
    -- each writes the one its own linker reads. MSVC leaves `lua51.lib` beside
    -- the interpreter; MinGW leaves `liblua51.a` in a sibling `lib`, which is
    -- where Nupp's own provisioning puts it. Looking for only the first found
    -- nothing on a machine that had the second, and the link then failed on
    -- every `lua_*` the entry calls.
    for entry in (tostring(os.getenv("PATH") or "") .. ";"):gmatch("([^;]*);") do
        local directory = (entry:gsub("\\", "/"):gsub("/+$", ""))
        if directory ~= "" then
            local beside = {
                directory .. "/lua51.lib",
                directory .. "/luajit.lib",
                directory .. "/../lib/liblua51.a",
                directory .. "/../lib/libluajit-5.1.dll.a",
            }
            for _, candidate in ipairs(beside) do
                if fs.exists(candidate) then
                    return candidate
                end
            end
        end
    end

    return nil
end

--- How this host spells a shared library, and what it takes to produce one.
---
--- The host's rather than the selected target's: `require` builds something
--- this build's own loader will open. Cross-compiling to a target whose objects
--- this machine cannot load is `emit-c`, which is what it is for.
---
--- @return the flags a shared object is linked with
--- @return the suffix its file takes
--- @return a library to name after the objects, when the platform needs one
function aot.linkage(selected: targets.Target, needsLua: boolean?): ({string}, string, string?)
    local system = targets.system(selected.triple)
    if system == "darwin" then
        if needsLua then
            return {"-dynamiclib", "-undefined", "dynamic_lookup"}, ".dylib"
        end
        return {"-dynamiclib"}, ".dylib"
    elseif system == "windows" then
        -- No `-lm`: the math functions are in the C runtime there rather than in
        -- a library to link, and asking for one that does not exist is an error
        -- rather than a no-op.
        local flags: {string} = {"-shared"}
        -- The import library is returned to be put after the objects rather than
        -- added here. GNU ld resolves a link line left to right and takes from a
        -- library only what something to its left already wanted, so one named
        -- before the objects that call `lua_*` is read while nothing wants
        -- anything and then dropped. MSVC's linker does not care about the
        -- order, which is why this stayed hidden until a MinGW toolchain was
        -- preferred here.
        return flags, ".dll", needsLua and aot.luaImportLibrary() or nil
    end

    -- `-lm` because the emitted C calls `sqrt`, `fabs` and friends, which glibc
    -- keeps outside libc proper.

    return {"-shared", "-fPIC", "-lm"}, ".so"
end

--- The source with every `@aot` declaration replaced by its wrapper.
---
--- Substitution rather than a companion module, because a companion only
--- reaches callers who know to ask for it. A function replaced where it was
--- written is reached by every call in the file and by every importer, which is
--- what `@aot` says happens.
---
--- Back to front, so replacing one declaration does not move the next one's
--- offsets. Nothing is inserted anywhere else: the wrapper's `cdef` and layout
--- checks go where the function was, which is necessarily after the struct it
--- reifies was declared.
---
--- @param sites where each program was written, in the same order
--- @param archive what a statically linked module checks the process image
---   against, which a shared-library build does not have and does not need
--- @return the rewritten source
function aot.dispatch(
    source: string,
    programs: {scalarIR.Program},
    sites: {compile.Site},
    gpuArtifacts: {[string]: any},
    library: string?,
    tiers: {string}?,
    constFamilies: {any}?,
    browser: boolean?,
    archive: nupp.compiler.aot.binding.Archive?
): string
    local rewritten = source
    local replacements: {any} = {}
    local detectorAt: integer? = nil
    for position, site in ipairs(sites) do
        if programs[position] ~= nil and programs[position].executionTarget ~= "gpu" then
            detectorAt = detectorAt == nil and site.from or math.min(detectorAt as integer, site.from)
        end
    end
    for _, family in ipairs(constFamilies or {}) do
        detectorAt = detectorAt == nil and family.site.from or math.min(detectorAt as integer, family.site.from)
    end
    for _, family in ipairs(constFamilies or {}) do
        replacements[
            #replacements + 1
        ] = {
            site = family.site,
            text = bindingRules.familyReplacement(family, library, tiers, family.site.from == detectorAt, archive),
        }
    end
    for position = 1, #programs do
        local site = sites[position]
        if site ~= nil then
            local program = programs[position]
            local replacement: string
            if program.executionTarget == "gpu" then
                local artifact = gpuArtifacts[program.symbol]
                assert(artifact ~= nil, "GPU program has no emitted shader")
                replacement = gpuBinding.replacement(program, artifact, browser)
            else
                replacement = bindingRules.replacement(program, library, tiers, site.from == detectorAt, archive)
            end
            replacements[#replacements + 1] = {site = site, text = replacement,}
        end
    end
    table.sort(replacements, function(a, b): boolean
        return a.site.from > b.site.from
    end)
    for _, replacement in ipairs(replacements) do
        local site = replacement.site
        rewritten = rewritten:sub(1, site.from - 1) .. replacement.text .. rewritten:sub(site.to + 1)
    end

    return rewritten
end

--- The source with Wasm CPU declarations replaced by registry closures and
--- GPU declarations replaced by the browser-safe generated binding.
function aot.wasmDispatch(
    source: string,
    programs: {scalarIR.Program},
    sites: {compile.Site},
    unit: string,
    gpuArtifacts: {[string]: any}
): string
    local rewritten = source
    for position = #programs, 1, -1 do
        local site = sites[position]
        if site ~= nil then
            local program = programs[position]
            local replacement = program.executionTarget == "gpu" and gpuBinding.replacement(
                program,
                gpuArtifacts[program.symbol],
                true
            ) or wasmBinding.replacement(program, unit)
            rewritten = rewritten:sub(1, site.from - 1) .. replacement .. rewritten:sub(site.to + 1)
        end
    end

    return rewritten
end

--- Locates the pinned Emscripten compiler used for side modules.
function aot.wasmToolchain(): (string?, string?)
    local command = os.getenv("NUPP_WASM_CC") or "emcc"
    local code, printed = process.capture({command, "--version"})
    if code ~= 0 then
        return nil, "Wasm AOT needs Emscripten emcc; name it with NUPP_WASM_CC"
    end
    local first = printed:match("^[^\n]*") or ""
    if first:lower():find("emscripten", 1, true) == nil then
        return nil, tostring(command) .. " is not Emscripten"
    end
    local release = first:match("(%d+%.%d+%.%d+)")
    if release ~= "6.0.8" then
        return nil, "Wasm AOT requires Emscripten 6.0.8, found " .. tostring(release or "unknown")
    end

    return command, first
end

--- Compiles each emitted source as one independently cacheable side module.
function aot.compileWasm(
    emitted: {aot.Emitted},
    produced: {[string]: compile.Artifacts},
    extra: {string}?
): ({string}?, string?, string?, string?)
    local command, version = aot.wasmToolchain()
    if command == nil then
        return nil, version, nil, nil
    end
    local outputs: {string} = {}
    local keys: {string} = {version as string}
    for _, one in ipairs(emitted) do
        if one.detector ~= true then
            local artifacts = produced[one.cacheKey]
            if artifacts == nil then
                return nil, "missing Wasm AOT artifacts for " .. one.source, nil, nil
            end
            local validation = wasmEmitter.validate((artifacts as compile.Artifacts).programs)
            if validation ~= nil then
                return nil, validation, nil, nil
            end
            local unit = "u" .. one.key:sub(1, 16)
            local registrar = "nupp_wasm_register_" .. unit
            local source = one.output:gsub("%.c$", ".side.c")
            local bytes = (
                artifacts as compile.Artifacts
            ).c .. wasmEmitter.registrar((artifacts as compile.Artifacts).programs, unit, one.tier)
            if fs.readFile(source) ~= bytes then
                local wrote, writeErr = fs.writeFile(source, bytes)
                if not wrote then
                    return nil, tostring(writeErr), nil, nil
                end
            end
            local argv: {
                string
            } = {
                command as string,
                source,
                "-std=c11",
                "-O3",
                "-ffp-contract=off",
                "-fno-fast-math",
                "-Wall",
                "-Wextra",
                "-Werror",
                "-Wno-parentheses-equality",
                "-sSIDE_MODULE=2",
                "-sFILESYSTEM=0",
            }
            local tierFlag = aot.TIER_FLAGS[one.tier]
            if tierFlag ~= nil then
                argv[#argv + 1] = tierFlag as string
            end
            for _, flag in ipairs(extra or {}) do
                argv[#argv + 1] = flag
            end
            local staged = one.output:gsub("%.c$", ".wasm.tmp")
            argv[#argv + 1] = "-o"
            argv[#argv + 1] = staged
            os.remove(staged)
            local code, printed = process.capture(argv)
            if code ~= 0 then
                os.remove(staged)
                return nil, "compiling Wasm AOT side module failed:\n" .. printed, nil, nil
            end
            local wasm, readErr = fs.readFile(staged)
            os.remove(staged)
            if wasm == nil then
                return nil, tostring(readErr), nil, nil
            end
            local wasmDigest = hash.digest(wasm as string)
            local output = one.output:gsub("%.c$", "." .. wasmDigest:sub(1, 16) .. ".wasm")
            if fs.readFile(output) ~= wasm then
                local wrote, writeErr = fs.writeFile(output, wasm as string)
                if not wrote then
                    return nil, tostring(writeErr), nil, nil
                end
            end
            one.wasmSource = source
            one.wasm = output
            one.registrar = registrar
            one.unit = unit
            outputs[#outputs + 1] = source
            outputs[#outputs + 1] = output
            keys[#keys + 1] = one.key
            keys[#keys + 1] = wasmDigest
        end
    end

    return outputs, nil, hash.digest(table.concat(keys, "\0")), version
end

--- What the compiled library is called, without saying where it is.
function aot.libraryFile(name: string, suffix: string): string
    local stem = name:gsub("[^%w_]", "_")
    if suffix == ".dll" then
        return stem .. "_aot" .. suffix
    end

    return "lib" .. stem .. "_aot" .. suffix
end

--- Where a project's compiled `@aot` code goes.
function aot.libraryPath(outDir: string, name: string, suffix: string): string
    return outDir .. "/lib/" .. aot.libraryFile(name, suffix)
end

--- How the generated wrapper names that library.
---
--- Relative to the module that loads it and marked with `@`, so the runtime
--- resolves it against the chunk rather than handing it to the platform loader.
---
--- A path decided at build time would be relative to where the build ran, which
--- ships a program that only runs from one directory, or absolute, which ships
--- one that only runs on one machine. Neither is something to hand to anyone.
---
--- No directory depth in it. The runtime walks up from the module, so one
--- spelling serves a module at whatever nesting its name gives it and the same
--- module inlined at the root of a bundle.
function aot.libraryReference(name: string, suffix: string): string
    return "@lib/" .. aot.libraryFile(name, suffix)
end

--- Compiles the emitted C into one shared library.
---
--- One library for the project rather than one per source, because the loader
--- opens it once and the wrappers all name the same object. Sources are sorted
--- so two builds of one project produce the same command line.
---
--- Written through a staged path and installed only after the compiler
--- succeeded, so a failed link leaves the previous library in place rather than
--- a truncated one the loader would happily open.
---
--- @param emitted the tiered C translation units the emitter wrote
--- @param output where the library goes
--- @return nothing, or what went wrong
function aot.link(
    chain: aot.Toolchain,
    selected: targets.Target,
    emitted: {aot.Emitted},
    output: string,
    extra: {string}?,
    needsLua: boolean?,
    static: boolean?
): string?
    if not fs.mkdir(fs.dirname(output)) then
        return "could not create " .. fs.dirname(output)
    end

    local objects: {string} = {}
    for _, one in ipairs(emitted) do
        local tierTarget, tierErr = targets.select(selected.triple, one.tier)
        if tierTarget == nil then
            return tostring(tierErr)
        end
        local object = one.output:gsub("%.c$", ".o")
        local stagedObject = object .. ".tmp"
        local argv: {string} = {chain.command}
        for _, flag in ipairs(aot.compileFlags(tierTarget as targets.Target, chain, extra)) do
            argv[#argv + 1] = flag
        end
        argv[#argv + 1] = "-c"
        argv[#argv + 1] = one.output
        argv[#argv + 1] = "-o"
        argv[#argv + 1] = stagedObject
        os.remove(stagedObject)
        local code, text = process.capture(argv)
        if code ~= 0 then
            os.remove(stagedObject)
            local hint = ""
            if selected.triple ~= targets.hostTriple() then
                hint = (
                    "\ncompiling for %s on %s needs that target's headers and libraries: "
                ):format(
                    selected.triple,
                    tostring(targets.hostTriple())
                ) .. "give the sysroot through aotCflags, or select aot = \"emit-c\" and build the C where it runs"
            end

            return "compiling the generated " .. one.tier .. " C failed:\n" .. text .. hint
        end
        local objectBytes, objectErr = fs.readFile(stagedObject)
        os.remove(stagedObject)
        if objectBytes == nil then
            return tostring(objectErr)
        end
        local wrote, writeErr = fs.writeFile(object, objectBytes as string)
        if not wrote then
            return tostring(writeErr)
        end
        one.object = object
        objects[#objects + 1] = object
    end
    table.sort(objects)

    if static then
        local probeCode, probed = process.capture({chain.command, "-print-prog-name=ar"})
        local archiver = chain.archiver or (probeCode == 0 and probed:match("^%s*(.-)%s*$") or nil)
        if archiver == nil or archiver == "" then
            archiver = "ar"
        end
        local staged = output .. ".tmp"
        os.remove(staged)
        local argv: {string} = {archiver as string, "rcs", staged}
        for _, object in ipairs(objects) do
            argv[#argv + 1] = object
        end
        local code, text = process.capture(argv)
        if code ~= 0 then
            os.remove(staged)
            return "archiving the generated C failed:\n" .. text
        end
        local binary, readErr = fs.readFile(staged)
        os.remove(staged)
        if binary == nil then
            return tostring(readErr)
        end
        local ok, writeErr = fs.writeFile(output, binary as string)
        if not ok then
            return tostring(writeErr)
        end

        return nil
    end

    local shared, _, trailing = aot.linkage(selected, needsLua)
    local argv: {string} = {chain.command}
    for _, flag in ipairs(shared) do
        argv[#argv + 1] = flag
    end
    for _, flag in ipairs(aot.linkFlags(selected, chain, extra)) do
        argv[#argv + 1] = flag
    end
    argv[#argv + 1] = "-o"
    local staged = output .. ".tmp"
    argv[#argv + 1] = staged
    for _, object in ipairs(objects) do
        argv[#argv + 1] = object
    end
    if trailing ~= nil then
        argv[#argv + 1] = trailing as string
    end
    os.remove(staged)
    local code, text = process.capture(argv)
    if code ~= 0 then
        os.remove(staged)
        local hint = ""
        if needsLua and targets.system(selected.triple) == "windows" and aot.luaImportLibrary() == nil then
            hint = "\nthis entry drives the Lua VM, and a Windows library resolves every "
                .. "symbol as it links: name the interpreter's import library through "
                .. "NUPP_LUA_LIB, or put the `luajit` this will run under on PATH"
        end

        return "linking the generated C failed:\n" .. text .. hint
    end

    local binary, readErr = fs.readFile(staged)
    os.remove(staged)
    if binary == nil then
        return tostring(readErr)
    end
    local ok, writeErr = fs.writeFile(output, binary as string)
    if not ok then
        return tostring(writeErr)
    end

    return nil
end

--- The assembly one generated translation unit compiles to.
---
--- The same C an artifact is built from, given the same flags, stopped one step
--- before the assembler encodes it. That is deliberately not a disassembly of
--- the built library: the two say the same thing about a body, and only this one
--- needs no second tool installed and produces no addresses for two runs to
--- differ by.
---
--- Nothing is cached. This compiles for a person reading the answer, not for a
--- build, so it costs one compilation of one file and leaves nothing behind that
--- a later build could mistake for its own.
---
--- @param c the generated translation unit
--- @param extra project flags, which are part of what the artifact was compiled
---   with wherever a target names them
--- @return the assembly, or nothing and what the compiler said
--- @raises never; a compiler that refused the C is reported, not thrown
function aot.assemble(chain: aot.Toolchain, selected: targets.Target, c: string, extra: {string}?): (string?, string?)
    local base = os.tmpname()
    os.remove(base)
    local source = base .. ".c"
    local output = base .. ".s"
    local wrote, writeErr = fs.writeFile(source, c)
    if not wrote then
        return nil, tostring(writeErr)
    end

    local argv: {string} = {chain.command}
    for _, flag in ipairs(aot.compileFlags(selected, chain, extra)) do
        argv[#argv + 1] = flag
    end
    argv[#argv + 1] = "-S"
    argv[#argv + 1] = source
    argv[#argv + 1] = "-o"
    argv[#argv + 1] = output
    local code, text = process.capture(argv)
    os.remove(source)
    if code ~= 0 then
        os.remove(output)

        return nil, "compiling the generated " .. selected.tier .. " C failed:\n" .. text
    end
    local assembly, readErr = fs.readFile(output)
    os.remove(output)
    if assembly == nil then
        return nil, tostring(readErr)
    end

    return assembly as string, nil
end

--- Writes the C for every `@aot` function the project builds.
---
--- Scoped by the project's module roots rather than by the target's entries,
--- because an entry is a module name and an `@aot` function is in a file. Every
--- module the project could build is a module the policy applies to.
---
--- @param roots the project's include directories
--- @param outDir where the build is writing, which the C goes beside
--- @param session the graph the sources are checked through, shared with the
---   module build that follows so each import is answered once
--- @return what was written, or nothing and the first reason it could not be
--- @raises never; a source the subset refuses is reported, not thrown
function aot.emitC(
    root: string,
    outDir: string,
    roots: {string},
    previous: {[string]: string},
    session: nupp.compiler.build.modules.Session,
    features: string?,
    triple: string?,
    staticLinkage: boolean?
): ({aot.Emitted}?, string?, {[string]: compile.Artifacts}, {[string]: {any}}, any?, {string})
    local produced: {[string]: compile.Artifacts} = {}
    local gpuSources: {string} = {}
    -- Kept for every source read here, and used only for the ones that end up
    -- rewritten, since only those are checked again as something else.
    local authoredUnused: {[string]: {any}} = {}
    local selected, targetErr = targets.buildTiers(triple, features)
    if selected == nil then
        return nil, tostring(targetErr), produced, authoredUnused, nil, gpuSources
    end

    local emitted: {aot.Emitted} = {}
    local seen: {[string]: boolean} = {}
    local sources: {string} = {}
    local sourceText: {[string]: string} = {}
    local sourceDirectory: {[string]: string} = {}
    local checkedBySource: {[string]: nupp.compiler.parser.ParseResult} = {}
    local checkedModules: {any} = {}
    for _, directory in ipairs(roots) do
        for _, source in ipairs(fs.listFiles(fs.join(root, directory))) do
            if not seen[source] and source:match("%.nupp$") ~= nil then
                seen[source] = true
                local text = fs.readFile(source)
                if text ~= nil then
                    sources[#sources + 1] = source
                    sourceText[source] = text as string
                    sourceDirectory[source] = directory
                end
            end
        end
    end
    table.sort(sources)
    local selectedPolicy = session.inc.env.config._target and session.inc.env.config._target.aot or nil
    if selectedPolicy == "require" then
        for _, source in ipairs(sources) do
            if mentionsGpuTarget(sourceText[source] as string) then
                session.stageBundled("nupp.gpulayout")
                session.stageBundled("nupp.runtime.nativev2")
                session.stageBundled("nupp.runtime.provider.nativegpu")
                session.stageBundled("nupp.gpu")
                break
            end
        end
    elseif selectedPolicy == "require-wasm" then
        for _, source in ipairs(sources) do
            if mentionsGpuTarget(sourceText[source] as string) then
                session.stageBundled("nupp.runtime.provider.browserwebgpu")
                break
            end
        end
    end
    local checkedSources: {string} = {}
    for _, source in ipairs(sources) do
        local checkedSource, unusedHere = checkedTree(session, source)
        if checkedSource ~= nil then
            checkedSources[#checkedSources + 1] = source
            checkedBySource[source] = checkedSource as nupp.compiler.parser.ParseResult
            checkedModules[
                #checkedModules + 1
            ] = {filename = source, module = envMod.moduleNameForPath(session.inc.env, source), result = checkedSource,}
            if mentionsAot(sourceText[source] as string) then
                authoredUnused[source] = unusedHere
            end
        end
    end
    sources = checkedSources
    local constPlans = constspecialize.collectGraph(checkedModules)
    local acceptedConst, declinedConst = constspecialize.selectGraph(constPlans)
    local constSelection = {accepted = acceptedConst, declined = declinedConst, plans = constPlans,}
    for _, source in ipairs(sources) do
        local text = sourceText[source] as string
        local tree = checkedBySource[source] as nupp.compiler.parser.ParseResult
        local directory = sourceDirectory[source] as string
        if mentionsAot(text) then
            for tierPosition, tierTarget in ipairs(selected as {targets.Target}) do
                local artifacts, diagnostics = compile.artifacts(
                    text,
                    source,
                    tree,
                    "<object>",
                    tierTarget,
                    tierTarget.tier,
                    constPlans,
                    staticLinkage
                )
                if artifacts == nil then
                    -- A file that only mentioned the annotation is not
                    -- an error. Every tier lowers from the same checked
                    -- source, so only the first can discover that case.
                    local first = diagnostics[1]
                    if first ~= nil and first.message ~= "no @aot function was found" then
                        return nil, compile.renderDiagnostic(
                            first
                        ), produced, authoredUnused, constSelection, gpuSources
                    end
                    break
                else
                    local cpuFunctions: integer = 0
                    for _, program in ipairs((artifacts as compile.Artifacts).programs) do
                        if program.executionTarget ~= "gpu" then
                            cpuFunctions = cpuFunctions + 1
                        end
                    end
                    if tierPosition == 1 then
                        produced[source] = artifacts as compile.Artifacts
                        if next((artifacts as compile.Artifacts).gpu) ~= nil then
                            gpuSources[#gpuSources + 1] = source
                        end
                    end
                    if cpuFunctions == 0 then
                        break
                    end
                    -- Where the generated C goes, which has to be
                    -- under `outDir` for every source the project
                    -- reaches, including the ones it reaches by
                    -- including a directory outside itself.
                    --
                    -- This used to strip the project root off the
                    -- source with a pattern, and `root` is usually
                    -- ".", whose pattern `^%./?` matches the first
                    -- dot of a leading "..". A source two directories
                    -- up came back as "./../src/x" and landed inside
                    -- the build directory by luck; three up came back
                    -- as "./../../src/x" and landed in the project's
                    -- own source tree. Taking the path apart at the
                    -- include directory it was listed under answers
                    -- both: the traversal is spelled out rather than
                    -- joined, so nothing escapes, and the directory
                    -- stays in the name, so two includes offering the
                    -- same module path cannot land on one file.
                    -- Both sides without a leading "./", because
                    -- `fs.join` writes one for a root of "." and the
                    -- listed source does not carry it.
                    local base = fs.join(root, directory):gsub("^%./", "")
                    local listed = source:gsub("^%./", "")
                    local relative = listed
                    if listed:sub(1, #base + 1) == base .. "/" then
                        relative = listed:sub(#base + 2)
                    end
                    local prefix = directory:gsub("^%./", ""):gsub("%.%./", "up/"):gsub("/$", "")
                    local stem = (prefix == "" and relative or prefix .. "/" .. relative):gsub("%.nupp$", "")
                    local output = outDir .. "/aot/" .. stem .. "." .. tierTarget.tier .. ".c"
                    local cacheKey = source .. "#" .. tierTarget.tier
                    local key = aot.key(artifacts.irText, tierTarget)

                    -- The state is evidence, not authority: the bytes
                    -- still have to be the ones this compiler emitted.
                    local reused = previous[cacheKey] == key and fs.readFile(output) == artifacts.c
                    if not reused then
                        local ok, err = fs.writeFile(output, artifacts.c)
                        if not ok then
                            return nil, tostring(err), produced, authoredUnused, constSelection, gpuSources
                        end
                    end
                    emitted[
                        #emitted + 1
                    ] = new aot.Emitted(
                        source = source,
                        tier = tierTarget.tier,
                        cacheKey = cacheKey,
                        output = output,
                        key = key
                    )
                    produced[cacheKey] = artifacts as compile.Artifacts
                end
            end
        end
    end

    -- One compiler-owned baseline unit asks which optional x86-64 state the
    -- destination enabled. It exists only when there is something to select.
    if #emitted > 0 and #(selected as {targets.Target}) > 1 then
        local detector = emitter.featureDetector()
        local output = outDir .. "/aot/features.c"
        local cacheKey = "@feature-detector"
        local key = hash.digest(
            cache.stable({
                c = detector,
                triple = (selected as {targets.Target})[1].triple,
                compiler = cache.toolFingerprint(),
            })
        )
        if previous[cacheKey] ~= key or fs.readFile(output) ~= detector then
            local ok, err = fs.writeFile(output, detector)
            if not ok then
                return nil, tostring(err), produced, authoredUnused, constSelection, gpuSources
            end
        end
        emitted[
            #emitted + 1
        ] = new aot.Emitted(
            source = "<feature-detector>",
            tier = "baseline",
            cacheKey = cacheKey,
            output = output,
            key = key,
            detector = true,
            role = "feature-detector"
        )
    end

    return emitted, nil, produced, authoredUnused, constSelection, gpuSources
end

--- What one build of the policy produced.
record aot.Result
    --- The C, one entry per source that carried an `@aot` function.
    emitted: {aot.Emitted}

    --- Logical const-specialized families, counted once before target tiers.
    specializedBodies: integer

    --- The shared library or standalone static archive, when the policy asked for one.
    library: string?

    --- The key that library was linked under.
    libraryKey: string?

    --- The compiler that linked it, for a build that wants to say so.
    toolchain: string?

    --- Machine-readable instructions for compiling the emitted tiered units.
    manifest: string?

    --- Source path -> that source with its `@aot` functions replaced by the
    --- wrappers that call the compiled code. Empty unless the policy links, so
    --- `emit-c` leaves every module exactly as it was written.
    dispatch: {[string]: string}

    --- Source path -> what reading that source as written said about bindings
    --- nothing uses. The module build reports these instead of what the
    --- rewritten source says, which cannot see the readers the wrapper replaced.
    authoredUnused: {[string]: {any}}?

    --- Internal whole-deliverable selection reused by ordinary Lua emission.
    constSelection: any?

    --- Side-module C and Wasm paths, in deterministic source order.
    wasmModules: {string}?

    --- Whether an authored GPU kernel needs the selected compute backend at runtime.
    gpu: boolean?

    --- Sources with authored GPU kernels, for generated runtime-effect selection.
    gpuSources: {string}?
end

--- The component identity every symbol in a static archive carries.
---
--- A shared object has a linker namespace of its own; an archive linked into an
--- executable has the one namespace that executable has. Two components whose
--- source functions happen to share a name must not export the same symbol, and
--- neither may collide with the host's own, so identity has to be in the
--- symbols rather than in the file they arrived in.
function aot.archiveIdentity(name: string): string
    return hash.digest(name):sub(1, 16)
end

--- What one archive's contents come to.
---
--- Over the units' content keys rather than over the linked file, so an
--- `emit-c` consumer that compiles and archives the C itself arrives at the
--- same number the generated wrapper was given. Forty-eight bits, because the
--- wrapper compares it as a Lua number.
function aot.archiveFingerprint(emitted: {aot.Emitted}): integer
    local keys: {string} = {}
    for _, one in ipairs(emitted) do
        keys[#keys + 1] = one.cacheKey .. "\0" .. one.key
    end
    table.sort(keys)

    return tonumber(hash.digest(table.concat(keys, "\n")):sub(1, 12), 16) as integer
end

--- Writes the compiler-owned unit that says which archive this is.
---
--- Emitted last and keyed like any other unit, so it takes part in the link
--- cache and in the archive it describes without describing itself.
function aot.writeArchiveProbe(
    outDir: string,
    name: string,
    selected: targets.Target,
    emitted: {aot.Emitted}
): (aot.Emitted?, nupp.compiler.aot.binding.Archive?, string?)
    local symbol = "ks_aot_archive_" .. aot.archiveIdentity(name)
    local fingerprint = aot.archiveFingerprint(emitted)
    local unit = emitter.archiveProbe(symbol, fingerprint)
    local output = outDir .. "/aot/archive.c"
    if fs.readFile(output) ~= unit then
        local ok, err = fs.writeFile(output, unit)
        if not ok then
            return nil, nil, tostring(err)
        end
    end

    return new aot.Emitted(
        source = "<archive-probe>",
        tier = selected.tier,
        cacheKey = "@archive-probe",
        output = output,
        key = hash.digest(cache.stable({c = unit, triple = selected.triple, compiler = cache.toolFingerprint(),})),
        detector = true,
        role = "archive-probe"
    ), new bindingRules.Archive(symbol = symbol, fingerprint = fingerprint), nil
end

--- Writes the portable handoff for an `emit-c` consumer.
function aot.writeUnitsManifest(outDir: string, triple: string, emitted: {aot.Emitted}): (string?, string?)
    if #emitted == 0 then
        return nil, nil
    end
    local units: {unknown} = {}
    local prefix = outDir .. "/aot/"
    for _, one in ipairs(emitted) do
        local flags: {string} = {}
        local tierFlag = aot.TIER_FLAGS[one.tier]
        if tierFlag ~= nil and one.detector ~= true then
            flags[#flags + 1] = tierFlag as string
        end
        units[
            #units + 1
        ] = {
            source = one.output:gsub("^" .. prefix:gsub("%p", "%%%0"), ""),
            tier = one.tier,
            cflags = nupp.data.json.asArray(flags),
            detector = one.role == "feature-detector",
            role = one.role,
            wasm = one.wasm and (one.wasm as string):gsub("^" .. prefix:gsub("%p", "%%%0"), "") or nil,
            registrar = one.registrar,
            unit = one.unit,
        }
    end
    local document = nupp.data.json.encode({
        schemaVersion = 3,
        target = triple,
        units = nupp.data.json.asArray(units),
    }) .. "\n"
    local output = outDir .. "/aot/units.json"
    if fs.readFile(output) ~= document then
        local ok, err = fs.writeFile(output, document)
        if not ok then
            return nil, tostring(err)
        end
    end

    return output, nil
end

--- What a host has to be told about one static archive.
---
--- The C units manifest says how to compile the archive; this says what to do
--- with it afterwards, which is the part an FFI declaration cannot express. An
--- FFI lookup creates no undefined C reference, so a linker that reads the
--- archive normally extracts nothing from it, and every symbol below then fails
--- to resolve at load with no indication that a link option was the cause.
---
--- `<archive>` in the retain flags stands for the archive's path, which the host
--- knows and this build does not: the file this describes may be copied into a
--- vendor tree before it is ever linked. A profile with no retain flags is
--- describing a target that has no linker to tell -- a console static symbol
--- registry, for which `symbols` is the list that registry must contain.
function aot.writeLinkManifest(
    outDir: string,
    name: string,
    profile: profiles.Profile,
    archive: nupp.compiler.aot.binding.Archive,
    library: string?,
    emitted: {aot.Emitted},
    produced: {[string]: compile.Artifacts},
    tiers: {string}
): (string?, string?)
    local kernels: {string} = {}
    local registrars: {string} = {}
    local builders: {unknown} = {}
    local builderSymbols: {[string]: {string}} = {}
    local builderEntries: {[string]: string} = {}
    local builderOrder: {string} = {}
    for _, one in ipairs(emitted) do
        local artifacts = produced[one.cacheKey]
        for _, program in ipairs(artifacts ~= nil and (artifacts as compile.Artifacts).programs or {}) do
            if program.executionTarget ~= "gpu" then
                kernels[#kernels + 1] = targets.symbol(program.symbol, one.tier)
                local registrar = program.registrar
                if registrar ~= nil then
                    -- The key is the unsuffixed registrar, which is what the
                    -- generated wrapper looks the returned table up under; the
                    -- symbols are the tier spellings, which is what the host
                    -- actually calls. They differ, so both are named.
                    local key = registrar as string
                    local symbol = targets.symbol(key, one.tier)
                    registrars[#registrars + 1] = symbol
                    if builderSymbols[key] == nil then
                        builderSymbols[key] = {}
                        builderEntries[key] = program.name
                        builderOrder[#builderOrder + 1] = key
                    end
                    local symbols = builderSymbols[key] as {string}
                    symbols[#symbols + 1] = symbol
                end
            end
        end
    end
    table.sort(kernels)
    table.sort(registrars)
    table.sort(builderOrder)
    for _, key in ipairs(builderOrder) do
        builders[
            #builders + 1
        ] = {key = key, entry = builderEntries[key], symbols = nupp.data.json.asArray(builderSymbols[key] as {string}),}
    end
    local document = nupp.data.json.encode({
        schemaVersion = 1,
        component = name,
        target = profile.target,
        os = profile.os,
        archive = library ~= nil and (library as string):gsub("^" .. outDir:gsub("%p", "%%%0") .. "/", "") or nil,
        fingerprint = {symbol = archive.symbol, value = archive.fingerprint,},
        symbols = {
            probe = archive.symbol,
            kernels = nupp.data.json.asArray(kernels),
            registrars = nupp.data.json.asArray(registrars),
        },
        builders = nupp.data.json.asArray(builders),
        retain = {
            forceLoad = nupp.data.json.asArray(profile.forceLoad),
            export = nupp.data.json.asArray(profile.export),
        },
        tiers = nupp.data.json.asArray(tiers),
    }) .. "\n"
    local output = outDir .. "/aot/link.json"
    if fs.readFile(output) ~= document then
        local ok, err = fs.writeFile(output, document)
        if not ok then
            return nil, tostring(err)
        end
    end

    return output, nil
end

--- Applies a target's ahead-of-time policy.
---
--- `emit-c` stops after writing the C. `require` goes on to compile it, and a
--- project that selected `require` and has no `@aot` function anywhere gets a
--- successful build with no library rather than an empty one: the policy says
--- what to do with `@aot` code, not that there must be some.
---
--- @param policy the target's `aot` value
--- @param name the target's name, which the library is named after
--- @return what was produced, or nothing and the first reason it could not be
function aot.apply(
    policy: string,
    root: string,
    outDir: string,
    roots: {string},
    name: string,
    previous: {[string]: string},
    previousLibraryKey: string?,
    session: nupp.compiler.build.modules.Session,
    features: string?,
    triple: string?,
    cflags: {string}?,
    linkage: string?
): (aot.Result?, string?)
    local wasmPolicy = aot.linksWasm(policy)
    if wasmPolicy then
        triple = "wasm32-unknown-emscripten"
        features = features or "scalar"
    end
    local emitted, emitErr, produced, authoredUnused, constSelection, gpuSources = aot.emitC(
        root,
        outDir,
        roots,
        previous,
        session,
        features,
        triple,
        linkage == "static"
    )
    if emitted == nil then
        return nil, emitErr
    end
    local specializedBodies: integer = 0
    local countedSources: {[string]: boolean} = {}
    for _, one in ipairs(emitted as {aot.Emitted}) do
        local artifacts = produced[one.source]
        if not countedSources[one.source] and artifacts ~= nil then
            countedSources[one.source] = true
            for _, family in ipairs((artifacts as compile.Artifacts).constFamilies or {}) do
                specializedBodies = specializedBodies + #family.programs
            end
        end
    end
    local selectedForManifest, selectedErr = targets.buildTiers(triple, features)
    if selectedForManifest == nil then
        return nil, tostring(selectedErr)
    end
    if #(selectedForManifest as {targets.Target}) > 1 then
        local flagErr = aot.multiversionFlagError(cflags)
        if flagErr ~= nil then
            return nil, flagErr
        end
    end
    local selectedTriple = (selectedForManifest as {targets.Target})[1].triple
    local tierNames: {string} = {}
    for _, tierTarget in ipairs(selectedForManifest as {targets.Target}) do
        tierNames[#tierNames + 1] = tierTarget.tier
    end

    -- Static linkage is a claim about the destination, so the destination has
    -- to have been described. Refusing here rather than at load keeps a build
    -- from producing an archive for a VM that cannot resolve a symbol out of
    -- one, which is a failure with no useful runtime symptom.
    local archive: nupp.compiler.aot.binding.Archive? = nil
    local staticProfile: profiles.Profile? = nil
    if linkage == "static" then
        local profile, profileErr = require("nupp.compiler.build.compilerpacks").profile(selectedTriple)
        if profile == nil then
            return nil, tostring(profileErr)
        end
        staticProfile = profile
        local described = profile as profiles.Profile
        if not described.staticAot then
            return nil, "aotLinkage = \"static\" needs a target that produces static AOT archives; "
                .. described.target
                .. " ("
                .. described.origin
                .. ") does not"
        end
        if not described.staticSymbolResolver then
            return nil, "aotLinkage = \"static\" needs a target whose VM resolves default-namespace "
                .. "symbols from the process image; "
                .. described.target
                .. " ("
                .. described.origin
                .. ") does not"
        end
        if #(emitted as {aot.Emitted}) > 0 then
            local unit, probed, probeErr = aot.writeArchiveProbe(
                outDir,
                name,
                (selectedForManifest as {targets.Target})[1],
                emitted as {aot.Emitted}
            )
            if unit == nil then
                return nil, tostring(probeErr)
            end
            local units = emitted as {aot.Emitted}
            units[#units + 1] = unit as aot.Emitted
            archive = probed
        end
    end
    local manifest, manifestErr = aot.writeUnitsManifest(outDir, selectedTriple, emitted as {aot.Emitted})
    if manifestErr ~= nil then
        return nil, manifestErr
    end
    if archive ~= nil then
        local _, linkErr = aot.writeLinkManifest(
            outDir,
            name,
            staticProfile as profiles.Profile,
            archive as nupp.compiler.aot.binding.Archive,
            aot.libraryPath(outDir, name, ".a"),
            emitted as {aot.Emitted},
            produced,
            tierNames
        )
        if linkErr ~= nil then
            return nil, linkErr
        end
    end
    if wasmPolicy then
        local wasmModules, wasmErr, wasmKey, wasmToolchain = aot.compileWasm(emitted as {aot.Emitted}, produced, cflags)
        if wasmModules == nil then
            return nil, wasmErr
        end
        manifest, manifestErr = aot.writeUnitsManifest(
            outDir,
            (selectedForManifest as {targets.Target})[1].triple,
            emitted as {aot.Emitted}
        )
        if manifestErr ~= nil then
            return nil, manifestErr
        end
        local dispatch: {[string]: string} = {}
        if policy == "require-wasm" then
            for _, one in ipairs(emitted as {aot.Emitted}) do
                local artifacts = produced[one.source]
                local source = fs.readFile(one.source)
                if one.detector ~= true and artifacts ~= nil and source ~= nil then
                    dispatch[
                        one.source
                    ] = aot.wasmDispatch(
                        source as string,
                        (artifacts as compile.Artifacts).programs,
                        (artifacts as compile.Artifacts).sites,
                        one.unit as string,
                        (artifacts as compile.Artifacts).gpu
                    )
                end
            end
            for _, sourcePath in ipairs(gpuSources) do
                if dispatch[sourcePath] == nil then
                    local artifacts = produced[sourcePath]
                    local source = fs.readFile(sourcePath)
                    if artifacts ~= nil and source ~= nil then
                        dispatch[
                            sourcePath
                        ] = aot.wasmDispatch(
                            source as string,
                            (artifacts as compile.Artifacts).programs,
                            (artifacts as compile.Artifacts).sites,
                            "",
                            (artifacts as compile.Artifacts).gpu
                        )
                    end
                end
            end
        end
        return new aot.Result(
            emitted = emitted as {aot.Emitted},
            libraryKey = wasmKey,
            toolchain = wasmToolchain,
            manifest = manifest,
            dispatch = dispatch,
            authoredUnused = authoredUnused,
            wasmModules = wasmModules,
            gpu = #gpuSources > 0,
            gpuSources = gpuSources,
            specializedBodies = specializedBodies,
            constSelection = constSelection
        ), nil
    end
    if not aot.linksNative(policy) then
        return new aot.Result(
            emitted = emitted as {aot.Emitted},
            manifest = manifest,
            dispatch = {},
            gpu = #gpuSources > 0,
            gpuSources = gpuSources,
            specializedBodies = specializedBodies,
            constSelection = constSelection
        ), nil
    end
    if #(emitted as {aot.Emitted}) == 0 then
        local dispatch: {[string]: string} = {}
        for _, sourcePath in ipairs(gpuSources) do
            local artifacts = produced[sourcePath]
            local source = fs.readFile(sourcePath)
            if artifacts ~= nil and source ~= nil then
                dispatch[
                    sourcePath
                ] = aot.dispatch(
                    source as string,
                    (artifacts as compile.Artifacts).programs,
                    (artifacts as compile.Artifacts).sites,
                    (artifacts as compile.Artifacts).gpu,
                    nil,
                    nil,
                    (artifacts as compile.Artifacts).constFamilies,
                    wasmPolicy
                )
            end
        end
        return new aot.Result(
            emitted = emitted as {aot.Emitted},
            manifest = manifest,
            dispatch = dispatch,
            authoredUnused = authoredUnused,
            gpu = #gpuSources > 0,
            gpuSources = gpuSources,
            specializedBodies = specializedBodies,
            constSelection = constSelection
        ), nil
    end

    local selected = (selectedForManifest as {targets.Target})[1]
    local chain, chainErr = aot.toolchain(selected.triple)
    if chain == nil then
        return nil, tostring(chainErr)
    end
    local keys: {string} = {}
    local needsLua = false
    for _, one in ipairs(emitted as {aot.Emitted}) do
        keys[#keys + 1] = one.key
        local artifact = produced[one.cacheKey]
        for _, program in ipairs(artifact ~= nil and (artifact as compile.Artifacts).programs or {}) do
            needsLua = needsLua or program.entryMode == "lua-builder"
        end
    end

    local static = linkage == "static"
    local shared, suffix = aot.linkage(selected, needsLua)
    if static then
        shared, suffix = {"static"}, ".a"
    end
    local library = aot.libraryPath(outDir, name, suffix)
    local reference = nil
    if not static then
        reference = aot.libraryReference(name, suffix)
    end
    local keyedFlags: {string} = {}
    for _, one in ipairs(emitted as {aot.Emitted}) do
        local tierTarget = targets.select(selected.triple, one.tier)
        keyedFlags[#keyedFlags + 1] = "tier=" .. one.tier
        for _, flag in ipairs(aot.compileFlags(tierTarget as targets.Target, chain as aot.Toolchain, cflags)) do
            keyedFlags[#keyedFlags + 1] = flag
        end
    end
    keyedFlags[#keyedFlags + 1] = "link"
    for _, flag in ipairs(aot.linkFlags(selected, chain as aot.Toolchain, cflags)) do
        keyedFlags[#keyedFlags + 1] = flag
    end
    local key = aot.libraryKey(keys, chain as aot.Toolchain, keyedFlags, shared)

    -- Same rule the C artifacts follow: the key is compared, and then the
    -- library it describes has to still be there. A relink costs seconds; a
    -- stale library loaded because a digest agreed costs a wrong answer.
    if previousLibraryKey ~= key or not fs.exists(library) then
        local linkErr = aot.link(
            chain as aot.Toolchain,
            selected,
            emitted as {aot.Emitted},
            library,
            cflags,
            needsLua,
            static
        )
        if linkErr ~= nil then
            return nil, tostring(linkErr)
        end
    end

    -- Written after the library exists rather than before, so a build that
    -- failed to link never leaves modules rewritten to call an object that is
    -- not there.
    local dispatch: {[string]: string} = {}
    local dispatched: {[string]: boolean} = {}
    local dispatchSources: {string} = {}
    for _, one in ipairs(emitted as {aot.Emitted}) do
        if not dispatched[one.source] then
            dispatched[one.source] = true
            dispatchSources[#dispatchSources + 1] = one.source
        end
    end
    for _, sourcePath in ipairs(gpuSources) do
        if not dispatched[sourcePath] then
            dispatched[sourcePath] = true
            dispatchSources[#dispatchSources + 1] = sourcePath
        end
    end
    table.sort(dispatchSources)
    for _, sourcePath in ipairs(dispatchSources) do
        local artifacts = produced[sourcePath]
        local source = fs.readFile(sourcePath)
        if artifacts ~= nil and source ~= nil then
            dispatch[
                sourcePath
            ] = aot.dispatch(
                source as string,
                (artifacts as compile.Artifacts).programs,
                (artifacts as compile.Artifacts).sites,
                (artifacts as compile.Artifacts).gpu,
                reference,
                tierNames,
                (artifacts as compile.Artifacts).constFamilies,
                wasmPolicy,
                archive
            )
        end
    end

    return new aot.Result(
        emitted = emitted as {aot.Emitted},
        library = library,
        libraryKey = key,
        toolchain = (chain as aot.Toolchain).version,
        manifest = manifest,
        dispatch = dispatch,
        authoredUnused = authoredUnused,
        gpu = #gpuSources > 0,
        gpuSources = gpuSources,
        specializedBodies = specializedBodies,
        constSelection = constSelection
    ), nil
end

export = aot
