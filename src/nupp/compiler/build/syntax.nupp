-- The three tiny languages emitted or consumed by native builds.

local GlobTokens = nupp.peg.compile([[
    {| { '**/' / '**' / '*' / '?' / (!'*' !'?' .)+ }* |} !.
]])

local ShellWords = nupp.peg.compile(
    [[
    start <- {| %s* (word (%s+ word)*)? %s* |} !.
    word <- {~ piece+ ~}
    piece <- "'" -> '' (!"'" .)* "'" -> ''
           / '"' -> '' (%backslash -> '' { . } / !'"' !%backslash .)* '"' -> ''
           / %backslash -> '' { . }
           / !%s !%backslash !"'" !'"' .
]],
    {definitions = {backslash = "\\"}}
)

local Depfile = nupp.peg.compile(
    [[
    start <- target ':' space* {| (word space*)* |} ('#' (!%nl .)* %nl?)? !.
    target <- (%backslash . / !':' .)*
    space <- %s+ / %backslash %cr? %nl
    word <- {~ (%backslash -> '' { !%nl . } / !%s !%backslash !'#' .)+ ~}
]],
    {definitions = {backslash = "\\", cr = "\r"}}
)

local globCache = setmetatable({}, {__mode = "v"})

--- Compile a path glob. `*` and `?` stay within one path segment, while `**/`
--- also matches zero directories, as it does in Git and common glob tools.
local function compileGlob(glob: string): nupp.peg.Peg<...any>
    local cached = globCache[glob]
    if cached then
        return cached
    end
    local definitions, source = {}, {"start <- part1 !."}
    local tokens = assert(GlobTokens(glob))
    for index, token in ipairs(tokens) do
        local current, nextPart = "part" .. index, "part" .. (index + 1)
        if token == "**/" then
            source[#source + 1] = current .. " <- " .. nextPart .. " / [^/]+ '/' " .. current
        elseif token == "**" then
            source[#source + 1] = current .. " <- " .. nextPart .. " / . " .. current
        elseif token == "*" then
            source[#source + 1] = current .. " <- " .. nextPart .. " / [^/] " .. current
        elseif token == "?" then
            source[#source + 1] = current .. " <- [^/] " .. nextPart
        else
            definitions[current] = token
            source[#source + 1] = current .. " <- %" .. current .. " " .. nextPart
        end
    end
    source[#source + 1] = "part" .. (#tokens + 1) .. " <- ''"
    local pattern = nupp.peg.compile(table.concat(source, "\n"), {definitions = definitions})
    globCache[glob] = pattern

    return pattern
end

return {glob = compileGlob, shellWords = ShellWords, depfile = Depfile}
