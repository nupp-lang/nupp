module nupp.compiler.lsp.wire

--[[
The shapes the protocol expects on the wire.

An empty Lua table defaults to an object, while the protocol cares which containers
are lists. Everything the server sends back as a list is marked here.
]]

local json = nupp.data.json

local wire = {}

--- The codec the server encodes and decodes with, configured so an empty object stays
--- an object and a NaN never crosses the wire.
wire.json = json

--- Marks `items` as a JSON array, so an empty one encodes as `[]` rather than `{}`.
---
--- @param items the list to mark
function wire.array<T is table>(takes items: T): T preserves items
    return json.asArray(items)
end

export = wire
