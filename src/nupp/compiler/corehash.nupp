@!internal

--[[
The core's answer to `nupp.compiler.nativehash`, the compiler's host digest:
the same 32 hex digits as `nupp.compiler.hash.portabledigest`, computed by the
core over the string's bytes (hashcalls, guesthash). Guest code runs the
portable XXH64, which emulates 64-bit arithmetic over 32-bit halves, at a few
kilobytes a second.
]]
module nupp.compiler.corehash

const hashcalls = require("nupp.runtime.hashcalls")

--- The same 32 lowercase hex digits as `nupp.compiler.hash.digest`.
export function digest(input: string): string
    return hashcalls.digest(input)
end
