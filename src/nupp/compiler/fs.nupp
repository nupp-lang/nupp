--[[
Paths and the filesystem.

One home for what three parts of the compiler were each carrying a copy of. A
path here is normalized and forward-slashed whatever the platform wrote it as,
so the same file compares equal however it was named, and a write is atomic:
content goes to a temporary beside the destination and is renamed over it, which
is the only way a build interrupted halfway leaves no half-written module behind.

Listing a directory goes through [`nupp.io.files`](../../../docs/files.md), which
is why the compiler is the first program that cannot be built without its native
provider. It used to spawn `find` or `dir` per source tree, which was a process
per listing and no answer at all on a platform without a shell.

Reading and writing stay on `io.open`. A whole-file transfer settles on a worker
thread, and a build reads thousands of small files, so the handoff would cost
more than the read.
]]

local fs = {}

local function normalize(path: string): string
    path = path:gsub("\\", "/"):gsub("/+", "/")
    path = path:gsub("^%./", ""):gsub("/%./", "/")
    return (path:gsub("/$", ""))
end

local function join(left: string?, right: string): string
    if not right then
        return normalize(left or "")
    end
    right = normalize(right)
    if not left or left == "" or left == "." then
        return right
    end
    if not right or right == "" then
        return normalize(left)
    end
    if right:sub(1, 1) == "/" or right:match("^[A-Za-z]:/") then
        return right
    end

    return normalize(left .. "/" .. right)
end

local function dirname(path: string): string
    return normalize(path):match("^(.*)/[^/]+$") or "."
end

local function basename(path: string): string
    return normalize(path):match("([^/]+)$") or path
end

--- An absolute, lexically normalized spelling. Unlike `canonical`, this also
--- answers for a path that does not exist yet, which is required when a watcher
--- retains a deleted input.
local function absolute(path: string): string
    path = normalize(path)
    if path:sub(1, 1) ~= "/" and not path:match("^[A-Za-z]:/") then
        local cwd = nupp.io.files.currentDirectory()
        path = join(cwd or ".", path)
    end
    local prefix = path:match("^([A-Za-z]:)/") or (path:sub(1, 1) == "/" and "/" or "")
    local rest = prefix == "/" and path:sub(2) or path:gsub("^[A-Za-z]:/", "")
    local parts = {}
    for part in rest:gmatch("[^/]+") do
        if part == ".." then
            if #parts > 0 then
                table.remove(parts)
            end
        elseif part ~= "." and part ~= "" then
            parts[#parts + 1] = part
        end
    end
    local separator = prefix == "/" and "" or (#parts > 0 and "/" or "")

    return prefix .. separator .. table.concat(parts, "/")
end

--- The filesystem identity of an existing path, following symbolic links. A
--- missing path keeps its absolute spelling so it remains observable.
local function canonical(path: string): string
    local fallback = absolute(path)
    if package.config:sub(1, 1) ~= "\\" then
        local code, output = require("nupp.compiler.build.process").capture({"realpath", fallback})
        if code == 0 then
            local resolved = output:match("([^\r\n]+)")
            if resolved then
                return normalize(resolved)
            end
        end
    end

    return fallback
end

local function readFile(path: string): string?, string?
    local f, err = io.open(path, "rb")
    if not f then
        -- A directory fails to open outright on Windows, with an OS message that
        -- says nothing about why; POSIX opens it and then reads as nothing instead.
        -- Either way, say what happened rather than the raw OS error: a caller that
        -- reports it printed a permissions complaint where the path belonged, saying
        -- neither what it tried to read nor the actual reason.
        if nupp.io.files.isDirectory(path) then
            return nil, path .. " is a directory"
        end

        return nil, err
    end
    local text = f:read("*a")
    f:close()
    if not text then
        if nupp.io.files.isDirectory(path) then
            return nil, path .. " is a directory"
        end

        return nil, path .. " cannot be read"
    end

    return text
end

local function exists(path: string): boolean
    local f = io.open(path, "rb")
    if not f then
        return false
    end
    f:close()

    return true
end

local function mkdir(path: string): boolean
    if path == "" or path == "." then
        return true
    end

    return (nupp.io.files.createDirectory(path))
end

local function writeFile(path: string, text: string): boolean?, string?
    if not mkdir(dirname(path)) then
        return nil, "cannot create " .. dirname(path)
    end
    local tmp = path .. ".tmp"
    local f, err = io.open(tmp, "wb")
    if not f then
        return nil, err
    end
    f:write(text)
    f:close()
    local ok, renameErr = os.rename(tmp, path)
    if not ok and exists(path) then
        local backup = path .. ".old"
        os.remove(backup)
        local moved, moveErr = os.rename(path, backup)
        if not moved then
            os.remove(tmp);
            return nil, moveErr
        end
        ok, renameErr = os.rename(tmp, path)
        if ok then
            os.remove(backup)
        else
            os.rename(backup, path)
        end
    end
    if not ok then
        os.remove(tmp);
        return nil, renameErr
    end

    return true
end

local function copyFile(source: string, destination: string): boolean?, string?
    local text, err = readFile(source)
    if not text then
        return nil, err
    end

    return writeFile(destination, text)
end

--- Every regular file at or under `path`, normalized and sorted.
---
--- A symbolic link is resolved rather than reported as one, so a source tree
--- assembled out of links reads the same as one that was copied. That is what
--- `find` did and what the callers were written against.
---
--- A directory that cannot be read contributes nothing rather than failing: a
--- project may name an include root it has not created yet, and the shell-out
--- this replaced answered the same way.
---
--- `skipDirectory` is asked about each directory's own name before the walk
--- descends into it, and a true answer prunes it and everything under it. A
--- caller that discards those files afterwards gets the same answer either way,
--- and discarding them afterwards means having walked them first: on this
--- compiler the unpruned walk found eight hundred files to keep a hundred,
--- because a checkout's own root holds a version-control store and possibly a
--- nest of worktrees.
local function listFiles(path: string, skipDirectory: (function(name: string): boolean?)?): {string}
    local files: {string} = {}
    local pending = {path}
    while #pending > 0 do
        local directory = table.remove(pending) as string
        for _, entry in ipairs(nupp.io.files.list(directory) or {}) do
            local child = join(directory, entry.name)
            local kind = entry.kind
            if kind == "symlink" then
                local resolved = nupp.io.files.info(child)
                kind = resolved and resolved.kind or "other"
            end
            if kind == "directory" then
                if not (skipDirectory and skipDirectory(entry.name)) then
                    pending[#pending + 1] = child
                end
            elseif kind == "file" then
                files[#files + 1] = normalize(child)
            end
        end
    end
    table.sort(files)

    return files
end

--- Writes only when the contents would differ, so a file that did not change keeps its
--- modification time and anything watching it stays quiet.
local function writeFileIfChanged(path: string, text: string): boolean?, string?
    if readFile(path) == text then
        return true
    end
    return writeFile(path, text)
end

fs.normalize = normalize
fs.join = join
fs.dirname = dirname
fs.basename = basename
fs.absolute = absolute
fs.canonical = canonical
fs.readFile = readFile
fs.exists = exists
fs.mkdir = mkdir
fs.writeFile = writeFile
fs.writeFileIfChanged = writeFileIfChanged
fs.copyFile = copyFile
fs.listFiles = listFiles

return fs
