module nupp.compiler.materialize.peg

--[[
The sealed PEG materializer.

The evaluator side builds identity-bearing pattern handles. Finalization resolves named
rules, proves the graph safe, and emits a canonical flat blueprint. The compiler side
validates that untrusted envelope again and preserves its canonical graph for native
LPeg lowering. It may additionally select a proven straight-line matcher kernel from
that graph. No live handle, source fragment, or lexical binding crosses the worker.
]]

local hash = require("nupp.compiler.hash")
local T = require("nupp.compiler.types")
local generics = require("nupp.compiler.generics")
local pegRe = require("nupp.compiler.materialize.pegre")

----------------------------------------------------------------------------
-- What a pattern is held as
----------------------------------------------------------------------------

type peg.Failure = {
    readonly code: string,
    readonly message: string,
    readonly help: string?
}

local record peg
    installEvaluator: function(any, any, any, any)
    method: function(any, any, string, any, any): (any, peg.Failure?)
    operator: function(any, string, any, any, any): (any, peg.Failure?)
    finalize: function(any, any): (any, peg.Failure?)
    lower: function(any, any, any): (any, peg.Failure?, any, T.Type?)
    inferSourceResult: function(string, T.Type?): (T.Pack?, peg.Failure?)
end

local MAX_NODES = 4096
local MAX_LITERAL_BYTES = 256 * 1024
local sourceResultCache = {}

local function failure(code, message, help)
    return {code = code, message = message, help = help} as peg.Failure
end

local function sortedBytes(text)
    local seen, bytes = {}, {}
    for index = 1, #text do
        local byte = text:byte(index)
        if not seen[byte] then
            seen[byte] = true
            bytes[#bytes + 1] = byte
        end
    end
    table.sort(bytes)
    local parts = {}
    for _, byte in ipairs(bytes) do
        parts[#parts + 1] = string.char(byte)
    end

    return table.concat(parts)
end

local function canonical(value)
    local kind = type(value)
    if value == nil then
        return "n"
    elseif kind == "boolean" then
        return value and "t" or "f"
    elseif kind == "number" then
        return "d" .. ("%.17g"):format(value) .. ";"
    elseif kind == "string" then
        return "s" .. #value .. ":" .. value
    elseif kind ~= "table" then
        error("non-data in PEG blueprint", 0)
    end
    local out = {"["}
    for index = 1, #value do
        out[#out + 1] = canonical(value[index])
    end
    out[#out + 1] = "]"

    return table.concat(out)
end

local function patternEntry(state, value)
    local entry = state.opaque[value]
    if entry and entry.provider == "peg" and entry.family == "Pattern" then
        return entry
    end

    return nil
end

local function definitionEntry(state, value)
    local entry = state.opaque[value]
    if entry and entry.provider == "peg" and entry.family == "Definition" then
        return entry
    end

    return nil
end

----------------------------------------------------------------------------
-- Building a pattern
----------------------------------------------------------------------------

function peg.installEvaluator(state: any, env: any, newOpaque: any, provenance: any)
    local library = {}

    -- The token is the identity the evaluator matches on, so each intrinsic needs an
    -- object of its own and this builds one. A table rather than a closure, because
    -- Lua 5.3 answers an upvalue-free `function() end` with one shared closure however
    -- often it is evaluated, which would collapse every intrinsic here onto whichever
    -- was registered last.
    local function intrinsic(name, callback)
        local token = {}
        state.intrinsics[token] = function(at, args)
            return callback(args, at)
        end
        library[name] = token
    end

    local function node(op, children, data, at)
        return newOpaque(
            "peg",
            "Pattern",
            {op = op, children = children or {}, data = data,},
            provenance(at, "nupp.peg." .. op)
        )
    end

    intrinsic("rePattern", function(args, at)
        if (args.n ~= 1 and args.n ~= 2) or type(args[1]) ~= "string" then
            return nil, failure("NUPP2417", "nupp.peg.compile needs one grammar string")
        end
        local options = args[2]
        if options ~= nil and type(options) ~= "table" then
            return nil, failure("NUPP2417", "nupp.peg.compile options must be a table")
        end
        local backend = options and options.backend or "auto"
        if backend ~= "auto" and backend ~= "lpeg" then
            return nil, failure("NUPP2417", "nupp.peg.compile backend must be 'auto' or 'lpeg'")
        end
        if options and (options.actions ~= nil or options.definitions ~= nil) then
            return nil, failure("NUPP2417", "comptime PEG actions are supplied to the materialized matcher factory")
        end
        local function simpleTableCapture(pattern, seen)
            local entry = patternEntry(state, pattern)
            if not entry then
                return false
            end
            seen = seen or {}
            if seen[pattern] then
                return false
            end
            seen[pattern] = true
            local payload = entry.payload
            local op = payload.op
            if op == "group"
                or op == "tableCapture"
                or op == "substitution"
                or op == "backReference"
                or op == "external"
                or op == "transform"
                or op == "matchTime"
                or op == "accumulate"
                or op == "fold"
                or op == "reference"
            then
                return false
            end
            for _, child in ipairs(payload.children or {}) do
                if not simpleTableCapture(child, seen) then
                    return false
                end
            end
            seen[pattern] = nil

            return true
        end

        local make = {
            literal = function(text)
                return node("literal", nil, text, at)
            end,
            set = function(text)
                return node("set", nil, sortedBytes(text), at)
            end,
            anyByte = function()
                return node("any", nil, nil, at)
            end,
            sequence = function(children)
                return node("sequence", children, nil, at)
            end,
            choice = function(children)
                return node("choice", children, nil, at)
            end,
            zeroOrMore = function(pattern)
                return node("zeroOrMore", {pattern}, nil, at)
            end,
            oneOrMore = function(pattern)
                return node("oneOrMore", {pattern}, nil, at)
            end,
            optional = function(pattern)
                return node("optional", {pattern}, nil, at)
            end,
            andPredicate = function(pattern)
                return node("and", {pattern}, nil, at)
            end,
            notPredicate = function(pattern)
                local entry = patternEntry(state, pattern)
                if entry and entry.payload.op == "any" then
                    return node("eof", nil, nil, at)
                end

                return node("not", {pattern}, nil, at)
            end,
            capture = function(pattern)
                return node("capture", {pattern}, nil, at)
            end,
            collect = function(pattern)
                return node("collect", {pattern}, nil, at)
            end,
            tableCapture = function(pattern)
                return node(simpleTableCapture(pattern) and "collect" or "tableCapture", {pattern}, nil, at)
            end,
            group = function(pattern, name)
                return node("group", {pattern}, name, at)
            end,
            substitution = function(pattern)
                return node("substitution", {pattern}, nil, at)
            end,
            backReference = function(name)
                return node("backReference", nil, name, at)
            end,
            external = function(name)
                return node("external", nil, name, at)
            end,
            transform = function(pattern, kind, value)
                return node("transform", {pattern}, {kind, value}, at)
            end,
            matchTime = function(pattern, name)
                return node("matchTime", {pattern}, name, at)
            end,
            accumulate = function(pattern, name)
                return node("accumulate", {pattern}, name, at)
            end,
            fold = function(pattern, name)
                return node("fold", {pattern}, name, at)
            end,
            position = function()
                return node("position", nil, nil, at)
            end,
            action = function(pattern, name)
                return node("action", {pattern}, name, at)
            end,
            reference = function(name)
                return node("reference", nil, name, at)
            end,
            define = function(name, pattern)
                return newOpaque(
                    "peg",
                    "Definition",
                    {name = name, pattern = pattern},
                    provenance(at, "nupp.peg.compile")
                )
            end,
            grammar = function(start, definitions)
                return node("grammar", definitions, start, at)
            end,
        }
        local pattern, why = pegRe.parse(args[1], make)
        if not pattern then
            return nil, failure("NUPP2417", why and why.message or "invalid PEG re grammar")
        end

        return newOpaque("peg", "Blueprint", {pattern = pattern, backend = backend}, provenance(at, "nupp.peg.compile"))
    end)

    env.nupp = env.nupp or {}
    env.nupp.peg = {compile = library.rePattern}
end

--- Reports method use on a PEG handle. The only PEG values user code can hold
--- are blueprints from `nupp.peg.compile`, and those have no comptime methods;
--- providers dispatch here so the refusal names what happened.
function peg.method(state: any, handle: any, name: string, args: any, at: any): any, peg.Failure?
    return nil, failure("NUPP2417", "this PEG value has no pattern methods")
end

--- Reports operator use on a PEG handle, for the same reason as `peg.method`.
function peg.operator(state: any, op: string, left: any, right: any, at: any): any, peg.Failure?
    return nil, failure("NUPP2417", "the PEG operator's left operand is not a pattern")
end

----------------------------------------------------------------------------
-- Analysing the graph
----------------------------------------------------------------------------

local function sameSignature(a, b)
    if #a ~= #b then
        return false
    end
    for index = 1, #a do
        if a[index] ~= b[index] then
            return false
        end
    end

    return true
end

local function nullableNodes(nodes)
    local nullable = {}
    for _ = 1, #nodes + 1 do
        local changed = false
        for index, node in ipairs(nodes) do
            local op = node[1]
            local value = false
            if op == "literal" then
                value = node[2] == ""
            elseif op == "eof"
                or op == "position"
                or op == "zeroOrMore"
                or op == "optional"
                or op == "and"
                or op == "not"
            then
                value = true
            elseif op == "sequence" then
                value = true
                for child = 2, #node do
                    if not nullable[node[child]] then
                        value = false
                        break
                    end
                end
            elseif op == "choice" then
                for child = 2, #node do
                    if nullable[node[child]] then
                        value = true
                        break
                    end
                end
            elseif op == "difference" then
                value = nullable[node[2]] == true
            elseif op == "oneOrMore"
                or op == "capture"
                or op == "collect"
                or op == "tableCapture"
                or op == "group"
                or op == "substitution"
                or op == "transform"
                or op == "matchTime"
                or op == "accumulate"
                or op == "fold"
                or op == "action"
            then
                value = nullable[node[2]] == true
            elseif op == "reference" then
                value = nullable[node[2]] == true
            end
            if value and not nullable[index] then
                nullable[index], changed = true, true
            end
        end
        if not changed then
            break
        end
    end

    return nullable
end

local function analyze(nodes, root, ruleRoots)
    local nullable = nullableNodes(nodes)
    for index, node in ipairs(nodes) do
        if (node[1] == "zeroOrMore" or node[1] == "oneOrMore") and nullable[node[2]] then
            return nil, failure(
                "NUPP2417",
                ("PEG repetition at blueprint node %d can match without consuming input"):format(index)
            )
        end
    end

    local function leading(index, active)
        local node = nodes[index]
        local op = node[1]
        if op == "reference" then
            local target = node[2]
            if active[target] then
                return false, target
            end
            active[target] = true
            local ok, cycle = leading(target, active)
            active[target] = nil
            return ok, cycle
        elseif op == "sequence" then
            for child = 2, #node do
                local ok, cycle = leading(node[child], active)
                if not ok then
                    return false, cycle
                end
                if not nullable[node[child]] then
                    break
                end
            end
        elseif op == "choice" then
            for child = 2, #node do
                local ok, cycle = leading(node[child], active)
                if not ok then
                    return false, cycle
                end
            end
        elseif op == "difference" then
            for child = 2, 3 do
                local ok, cycle = leading(node[child], active)
                if not ok then
                    return false, cycle
                end
            end
        elseif op == "zeroOrMore"
            or op == "oneOrMore"
            or op == "optional"
            or op == "and"
            or op == "not"
            or op == "capture"
            or op == "collect"
            or op == "tableCapture"
            or op == "group"
            or op == "substitution"
            or op == "transform"
            or op == "matchTime"
            or op == "accumulate"
            or op == "fold"
            or op == "action"
        then
            return leading(node[2], active)
        end

        return true
    end

    for _, ruleRoot in ipairs(ruleRoots) do
        local ok = leading(ruleRoot, {[ruleRoot] = true})
        if not ok then
            return nil, failure("NUPP2417", "PEG grammar contains left recursion")
        end
    end

    local memo, visiting = {}, {}
    for _, node in ipairs(nodes) do
        local op = node[1]
        if op == "tableCapture"
            or op == "group"
            or op == "substitution"
            or op == "backReference"
            or op == "external"
            or op == "transform"
            or op == "matchTime"
            or op == "accumulate"
            or op == "fold"
        then
            return "any", nil, true
        end
    end
    local signature
    signature = function(index, collected)
        if memo[index] and not collected then
            return memo[index]
        end
        if visiting[index] then
            return {}
        end
        visiting[index] = true
        local node, answer = nodes[index], {}
        local op = node[1]
        if op == "capture" then
            answer = {"string"}
            local inner, why = signature(node[2], collected)
            if not inner then
                visiting[index] = nil
                return nil, why
            end
            for _, item in ipairs(inner) do
                answer[#answer + 1] = item
            end
        elseif op == "action" then
            answer = {"action:" .. node[3]}
        elseif op == "position" then
            answer = {"integer"}
        elseif op == "collect" then
            local inner, why = signature(node[2], true)
            if not inner then
                visiting[index] = nil
                return nil, why
            end
            local element = inner[1]
            for offset = 2, #inner do
                if inner[offset] ~= element then
                    element = "any"
                end
            end
            answer = {"array:" .. tostring(element or "any")}
        elseif op == "sequence" then
            for child = 2, #node do
                local got, why = signature(node[child], collected)
                if not got then
                    visiting[index] = nil
                    return nil, why
                end
                for _, item in ipairs(got) do
                    answer[#answer + 1] = item
                end
            end
        elseif op == "choice" then
            local first, firstWhy = signature(node[2], collected)
            if not first then
                visiting[index] = nil
                return nil, firstWhy
            end
            answer = first
            for child = 3, #node do
                local got, why = signature(node[child], collected)
                if not got then
                    visiting[index] = nil
                    return nil, why
                end
                if not sameSignature(answer, got) then
                    visiting[index] = nil
                    return nil, failure("NUPP2417", "PEG choice alternatives produce different capture shapes")
                end
            end
        elseif op == "difference" then
            local got, why = signature(node[2], collected)
            if not got then
                visiting[index] = nil
                return nil, why
            end
            answer = got
        elseif op == "zeroOrMore" or op == "oneOrMore" or op == "optional" then
            local got, why = signature(node[2], collected)
            if not got then
                visiting[index] = nil
                return nil, why
            end
            if #got > 0 and not collected then
                visiting[index] = nil
                return nil, failure("NUPP2417", "capture-producing repetition must be wrapped in {| ... |}")
            end
            answer = got
        elseif op == "reference" then
            local got, why = signature(node[2], collected)
            if not got then
                visiting[index] = nil
                return nil, why
            end
            answer = got
        end
        visiting[index] = nil
        if not collected then
            memo[index] = answer
        end

        return answer
    end
    local result, why = signature(root, false)
    if not result then
        return nil, why
    end

    return #result > 0 and result or {"integer"}, nil, false
end

local function finalizeGraph(state, rootHandle, backend)
    local rootEntry = patternEntry(state, rootHandle)
    if not rootEntry then
        return nil, failure("NUPP2417", "PEG blueprint root is not a pattern")
    end
    local definitions, startName = {}, nil
    local grammarHandle
    local function discoverGrammar(handle, seen)
        if seen[handle] then
            return true
        end
        seen[handle] = true
        local entry = patternEntry(state, handle)
        if not entry then
            return nil, failure("NUPP2417", "PEG graph contains a foreign value")
        end
        if entry.payload.op == "grammar" then
            if grammarHandle and grammarHandle ~= handle then
                return nil, failure("NUPP2417", "one PEG blueprint cannot combine two grammar scopes")
            end
            grammarHandle = handle

            return true
        end
        for _, child in ipairs(entry.payload.children or {}) do
            local ok, why = discoverGrammar(child, seen)
            if not ok then
                return nil, why
            end
        end

        return true
    end

    local discovered, discoverFailure = discoverGrammar(rootHandle, {})
    if not discovered then
        return nil, discoverFailure
    end
    if grammarHandle then
        local grammar = patternEntry(state, grammarHandle)
        startName = grammar.payload.data
        for _, handle in ipairs(grammar.payload.children) do
            local definition = definitionEntry(state, handle)
            if not definition then
                return nil, failure("NUPP2417", "PEG grammar contains an invalid definition")
            end
            local name = definition.payload.name
            if definitions[name] then
                return nil, failure("NUPP2417", "PEG rule " .. name .. " is defined twice")
            end
            definitions[name] = definition.payload.pattern
        end
        if not definitions[startName] then
            return nil, failure("NUPP2417", "PEG start rule " .. startName .. " is not defined")
        end
    end

    local nodes, origins, indices, literalBytes = {}, {}, {}, 0
    local visit
    visit = function(handle)
        if indices[handle] then
            return indices[handle]
        end
        local entry = patternEntry(state, handle)
        if not entry then
            return nil, failure("NUPP2417", "PEG graph contains a foreign value")
        end
        if entry.payload.op == "grammar" then
            return visit(definitions[entry.payload.data])
        end
        if #nodes >= MAX_NODES then
            return nil, failure("NUPP2416", "PEG blueprint exceeds its 4096-node limit")
        end
        local index = #nodes + 1
        indices[handle], nodes[index], origins[index] = index, false, entry.provenance
        local op, output = entry.payload.op, {entry.payload.op}
        if op == "literal" or op == "set" then
            literalBytes = literalBytes + #entry.payload.data
            if literalBytes > MAX_LITERAL_BYTES then
                return nil, failure("NUPP2416", "PEG blueprint exceeds its 262144-byte literal limit")
            end
            output[2] = entry.payload.data
        elseif op == "reference" then
            local target = definitions[entry.payload.data]
            if not target then
                return nil, failure("NUPP2417", "PEG rule " .. entry.payload.data .. " is not defined")
            end
            local targetIndex, why = visit(target)
            if not targetIndex then
                return nil, why
            end
            output[2] = targetIndex
        elseif op == "action"
            or op == "group"
            or op == "transform"
            or op == "matchTime"
            or op == "accumulate"
            or op == "fold"
        then
            local childIndex, why = visit(entry.payload.children[1])
            if not childIndex then
                return nil, why
            end
            output[2], output[3] = childIndex, entry.payload.data
        elseif op == "backReference" or op == "external" then
            output[2] = entry.payload.data
        else
            for _, child in ipairs(entry.payload.children or {}) do
                local childIndex, why = visit(child)
                if not childIndex then
                    return nil, why
                end
                output[#output + 1] = childIndex
            end
        end
        nodes[index] = output

        return index
    end
    local root, why = visit(rootHandle)
    if not root then
        return nil, why
    end
    local ruleNames = {}
    for name in pairs(definitions) do
        ruleNames[#ruleNames + 1] = name
    end
    table.sort(ruleNames)
    local ruleRoots = {}
    for _, name in ipairs(ruleNames) do
        local index, ruleWhy = visit(definitions[name])
        if not index then
            return nil, ruleWhy
        end
        ruleRoots[#ruleRoots + 1] = index
    end
    local result, analysisFailure, general = analyze(nodes, root, ruleRoots)
    if not result then
        return nil, analysisFailure
    end
    local slotSet = {}
    for _, node in ipairs(nodes) do
        if node[
            1
        ] == "action" or node[
            1
        ] == "matchTime" or node[
            1
        ] == "accumulate" or node[
            1
        ] == "fold" or node[1] == "external" or (node[1] == "transform" and node[3][1] == "definition") then
            local name = node[1] == "external" and node[2] or node[1] == "transform" and node[3][2] or node[3]
            slotSet[name] = true
        end
    end
    local slots = {}
    for name in pairs(slotSet) do
        slots[#slots + 1] = name
    end
    table.sort(slots)
    local payload = {nodes, root, result, #ruleRoots, slots, backend or "auto", general == true}
    local fingerprint = hash.sha256("nupp.peg\0v5\0" .. canonical(payload))
    local family = #slots > 0 and "FactoryBlueprint" or "Blueprint"

    return {
        kind = "materialized",
        provider = "peg",
        schema = 5,
        family = family,
        payload = payload,
        provenance = origins,
        fingerprint = fingerprint,
        summary = (
            "%d-node PEG, %d rules, %d actions, %d results"
        ):format(#nodes, #ruleRoots, #slots, result == "any" and -1 or #result),
    }, nil
end

----------------------------------------------------------------------------
-- Finishing a pattern
----------------------------------------------------------------------------

function peg.finalize(state: any, value: any): any, peg.Failure?
    local entry = state.opaque[value]
    if not entry or entry.provider ~= "peg" or entry.family ~= "Blueprint" then
        return nil, failure("NUPP2415", "the value is not a PEG blueprint")
    end

    return finalizeGraph(state, entry.payload.pattern, entry.payload.backend)
end

local function validateEnvelope(envelope)
    if envelope.schema ~= 5 or (
        envelope.family ~= "Blueprint" and envelope.family ~= "FactoryBlueprint"
    ) or type(envelope.payload) ~= "table" then
        return nil, "PEG blueprint has the wrong schema"
    end
    local nodes, root, result, ruleCount, slots, backend, general = unpack(envelope.payload)
    if type(
        nodes
    ) ~= "table" or #nodes == 0 or #nodes > MAX_NODES or type(
        root
    ) ~= "number" or root < 1 or root > #nodes or type(
        result
    ) ~= "table" and result ~= "any" or type(
        ruleCount
    ) ~= "number" or type(
        slots
    ) ~= "table" or (backend ~= "auto" and backend ~= "lpeg") or type(general) ~= "boolean" then
        return nil, "PEG blueprint header is malformed"
    end
    if result ~= "any" then
        for _, descriptor in ipairs(result) do
            if type(descriptor) ~= "string" then
                return nil, "PEG blueprint result pack is malformed"
            end
        end
    end
    local slotSet, previous = {}, nil
    for _, name in ipairs(slots) do
        if type(name) ~= "string" or not name:find("^[%a_][%w_]*$") or (previous and previous >= name) then
            return nil, "PEG blueprint action slots are malformed"
        end
        slotSet[name], previous = true, name
    end
    if (envelope.family == "FactoryBlueprint") ~= (#slots > 0) then
        return nil, "PEG blueprint family does not match its action slots"
    end
    local literalBytes = 0
    local arities = {
        literal = -1,
        set = -1,
        any = 1,
        eof = 1,
        position = 1,
        difference = 3,
        zeroOrMore = 2,
        oneOrMore = 2,
        optional = 2,
        ["and"] = 2,
        ["not"] = 2,
        capture = 2,
        collect = 2,
        tableCapture = 2,
        substitution = 2,
        reference = 2,
    }
    for _, node in ipairs(nodes) do
        if type(node) ~= "table" or type(node[1]) ~= "string" then
            return nil, "PEG blueprint contains a malformed instruction"
        end
        local op = node[1]
        if op == "literal" or op == "set" then
            if #node ~= 2 or type(node[2]) ~= "string" then
                return nil, "PEG literal instruction is malformed"
            end
            literalBytes = literalBytes + #node[2]
        elseif op == "sequence" or op == "choice" then
            if #node < 3 then
                return nil, "PEG variadic instruction has too few children"
            end
        elseif op == "action" or op == "matchTime" or op == "accumulate" or op == "fold" then
            if #node ~= 3 or type(node[2]) ~= "number" or not slotSet[node[3]] then
                return nil, "PEG action instruction is malformed"
            end
        elseif op == "group" then
            if (
                #node ~= 2 and #node ~= 3
            ) or type(node[2]) ~= "number" or (node[3] ~= nil and type(node[3]) ~= "string") then
                return nil, "PEG group capture instruction is malformed"
            end
        elseif op == "transform" then
            local transform = node[3]
            if #node ~= 3 or type(
                node[2]
            ) ~= "number" or type(
                transform
            ) ~= "table" or (
                transform[1] ~= "string" and transform[1] ~= "number" and transform[1] ~= "definition"
            ) or (
                transform[1] == "string" and type(transform[2]) ~= "string"
            ) or (
                transform[1] == "number" and type(transform[2]) ~= "number"
            ) or (transform[1] == "definition" and not slotSet[transform[2]]) then
                return nil, "PEG transform instruction is malformed"
            end
        elseif op == "backReference" or op == "external" then
            if #node ~= 2 or type(node[2]) ~= "string" or (op == "external" and not slotSet[node[2]]) then
                return nil, "PEG definition instruction is malformed"
            end
        elseif not arities[op] or (arities[op] > 0 and #node ~= arities[op]) then
            return nil, "PEG blueprint contains an unknown or malformed instruction"
        end
        if op ~= "literal"
            and op ~= "set"
            and op ~= "any"
            and op ~= "eof"
            and op ~= "position"
            and op ~= "backReference"
            and op ~= "external"
        then
            local last = (
                op == "action"
                or op == "group"
                or op == "transform"
                or op == "matchTime"
                or op == "accumulate"
                or op == "fold"
            ) and 2 or #node
            for index = 2, last do
                if type(node[index]) ~= "number" or node[index] < 1 or node[index] > #nodes then
                    return nil, "PEG instruction points outside the blueprint"
                end
            end
        end
    end
    if literalBytes > MAX_LITERAL_BYTES then
        return nil, "PEG blueprint exceeds its literal limit"
    end
    local fingerprint = hash.sha256("nupp.peg\0v5\0" .. canonical(envelope.payload))
    if envelope.fingerprint ~= fingerprint then
        return nil, "PEG blueprint fingerprint does not match its payload"
    end

    return {nodes = nodes, root = root, result = result, slots = slots, backend = backend, general = general,}, nil
end

----------------------------------------------------------------------------
-- The types a match produces
----------------------------------------------------------------------------

local function descriptorType(descriptor, actionReturns): T.Type?
    if descriptor == "integer" then
        return T.integer
    elseif descriptor == "string" then
        return T.string
    end
    local element = descriptor:match("^array:(.+)$")
    if element then
        if element == "string" then
            return T.array(T.string)
        elseif element == "integer" then
            return T.array(T.integer)
        elseif element == "any" then
            return T.array(T.any)
        end
        local actionName = element:match("^action:(.+)$")
        local actionPack = actionName and actionReturns and actionReturns[actionName]
        local actionType = actionPack and T.packAt(actionPack, 1)
        if actionType and not T.packAt(actionPack, 2) then
            return T.array(actionType)
        end
    end

    return nil
end

--- Turns the canonical capture descriptors produced by `analyze` into the native
--- result pack seen by a matcher caller. Action descriptors splice their whole return
--- pack into the surrounding captures; no tuple type is introduced.
local function packOfResult(result, actionReturns): T.Pack?
    if result == "any" then
        return T.pack({}, {kind = "unknown", type = T.any})
    end
    local function concatenate(left: T.Pack, right: T.Pack): T.Pack?
        local products = {}
        for _, leftArm in ipairs(left.alternatives or {left}) do
            for _, rightArm in ipairs(right.alternatives or {right}) do
                if leftArm.tail then
                    return nil
                end
                local head, modes = {}, {}
                for index, member in ipairs(leftArm.head) do
                    head[#head + 1], modes[#modes + 1] = member, leftArm.modes[index]
                end
                for index, member in ipairs(rightArm.head) do
                    head[#head + 1], modes[#modes + 1] = member, rightArm.modes[index]
                end
                products[#products + 1] = T.pack(head, rightArm.tail, modes)
            end
        end

        return T.packUnion(products)
    end

    local output = T.pack({})
    for _, descriptor in ipairs(result) do
        local action = descriptor:match("^action:(.+)$")
        local contribution
        if action then
            contribution = actionReturns and actionReturns[action]
            if not contribution then
                return nil
            end
        else
            local member = descriptorType(descriptor, actionReturns)
            if not member then
                return nil
            end
            contribution = T.pack({member})
        end
        output = concatenate(output, contribution)
        if not output then
            return nil
        end
    end

    return output
end

local function resultFits(result, resultPack, actionReturns)
    if result == "any" then
        return resultPack ~= nil
    end
    local actual = packOfResult(result, actionReturns)

    return actual ~= nil and resultPack ~= nil and actual.id == resultPack.id
end

local function matcherResult(candidate, matcher)
    if not candidate or not matcher or (
        candidate.origin or candidate
    ) ~= matcher or not candidate.packArgs or #candidate.packArgs ~= 1 then
        return nil
    end

    return candidate.packArgs[1]
end

local function actionReturnTypes(slots, actions)
    if not actions or (
        actions.tag ~= "nominal" and actions.tag ~= "shape"
    ) or actions.indexReadKey or actions.indexWriteKey then
        return nil, "PEG action factory input must be a closed record or shape"
    end
    local byname, count = actions.byname or {}, 0
    for _ in pairs(byname) do
        count = count + 1
    end
    if count ~= #slots then
        return nil, "PEG action factory input must declare exactly the blueprint's action slots"
    end
    local returns = {}
    for _, name in ipairs(slots) do
        local callback = byname[name]
        if not callback or callback.tag ~= "func" or #callback.params ~= 1 or callback.params[
            1
        ] ~= T.string or callback.vararg then
            return nil, ("PEG action %s must be function(string): R..."):format(name)
        end
        returns[name] = callback.retPack or T.pack(callback.rets)
    end

    return returns
end

local function generalDefinitionTypes(slots, definitions)
    if not definitions or (
        definitions.tag ~= "nominal" and definitions.tag ~= "shape"
    ) or definitions.indexReadKey or definitions.indexWriteKey then
        return nil, "PEG definition factory input must be a closed record or shape"
    end
    local byname, count = definitions.byname or {}, 0
    for _ in pairs(byname) do
        count = count + 1
    end
    if count ~= #slots then
        return nil, "PEG definition factory input must declare exactly the grammar's definition slots"
    end
    for _, name in ipairs(slots) do
        if not byname[name] then
            return nil, "PEG definition factory input is missing " .. name
        end
    end

    return {}, nil
end

--- Infers the result of a literal runtime grammar through the exact evaluator,
--- parser, finalizer, and analyzer used by `comptime`. A malformed grammar is returned
--- as a miss: runtime compilation still owns when and whether its error is raised.
--- Callers may therefore use this for precision without changing runtime semantics.
function peg.inferSourceResult(source: string, actions: T.Type?): T.Pack?, peg.Failure?
    local cacheKey = source .. "\0" .. (actions and actions.id or "-")
    local cached = sourceResultCache[cacheKey]
    if cached then
        return cached.result, cached.failure
    end
    local function finish(result, why)
        sourceResultCache[cacheKey] = {result = result, failure = why}

        return result, why
    end

    local state = {opaque = {}, intrinsics = {}}
    local scratch = {}
    local function newOpaque(provider, family, payload, at)
        local handle = {}
        state.opaque[handle] = {provider = provider, family = family, payload = payload, provenance = at,}

        return handle
    end

    peg.installEvaluator(state, scratch, newOpaque, function(_, operation)
        return {operation = operation, line = 1, column = 1}
    end)
    local compile = scratch.nupp and scratch.nupp.peg and scratch.nupp.peg.compile
    local invoke = compile and state.intrinsics[compile]
    if not invoke then
        return finish(nil, failure("NUPP2415", "the PEG literal inference frontend is unavailable"))
    end
    local value, invokeFailure = invoke(nil, {[1] = source, n = 1})
    if not value then
        return finish(nil, invokeFailure)
    end
    local envelope, finalizeFailure = peg.finalize(state, value)
    if not envelope then
        return finish(nil, finalizeFailure)
    end
    local validated, why = validateEnvelope(envelope)
    if not validated then
        return finish(nil, failure("NUPP2415", why as string))
    end
    local returns
    if #validated.slots > 0 then
        local actionWhy
        if validated.general then
            returns, actionWhy = generalDefinitionTypes(validated.slots, actions)
        else
            returns, actionWhy = actionReturnTypes(validated.slots, actions)
        end
        if not returns then
            return finish(nil, failure("NUPP2415", actionWhy as string))
        end
    end

    return finish(packOfResult(validated.result, returns), nil)
end

----------------------------------------------------------------------------
-- Planning a search
----------------------------------------------------------------------------

local function singleResult(result, descriptor): boolean
    return result ~= "any" and #result == 1 and result[1] == descriptor
end

local function searchPlan(validated)
    local nodes, root = validated.nodes, validated.root
    local nullable = nullableNodes(nodes)
    if nullable[root] then
        return nil
    end

    local function collect(index, bytes, active)
        if active[index] then
            return false
        end
        active[index] = true
        local node = nodes[index]
        local op = node[1]
        local known = true
        if op == "literal" then
            if node[2] ~= "" then
                bytes[node[2]:byte(1)] = true
            end
        elseif op == "set" then
            for offset = 1, #node[2] do
                bytes[node[2]:byte(offset)] = true
            end
        elseif op == "any" then
            known = false
        elseif op == "eof" or op == "position" or op == "and" or op == "not" then
            -- These nodes consume no byte. A surrounding sequence contributes the
            -- first consuming node that follows them.
        elseif op == "sequence" then
            for child = 2, #node do
                if not collect(node[child], bytes, active) then
                    known = false
                    break
                end
                if not nullable[node[child]] then
                    break
                end
            end
        elseif op == "choice" then
            for child = 2, #node do
                if not collect(node[child], bytes, active) then
                    known = false
                    break
                end
            end
        elseif op == "difference" then
            known = collect(node[2], bytes, active)
        elseif op == "zeroOrMore"
            or op == "oneOrMore"
            or op == "optional"
            or op == "capture"
            or op == "collect"
            or op == "action"
            or op == "reference"
        then
            known = collect(node[2], bytes, active)
        else
            known = false
        end
        active[index] = nil

        return known
    end

    local present = {}
    if not collect(root, present, {}) then
        return nil
    end
    local bytes = {}
    for byte = 0, 255 do
        if present[byte] then
            bytes[#bytes + 1] = byte
        end
    end
    local function classPattern(value)
        local pattern = {"["}
        for offset = 1, #value do
            local byte = value:byte(offset)
            if byte == 0 then
                pattern[#pattern + 1] = "%z"
            else
                local character = string.char(byte)
                if character == "%" or character == "-" or character == "]" or character == "^" then
                    pattern[#pattern + 1] = "%"
                end
                pattern[#pattern + 1] = character
            end
        end
        pattern[#pattern + 1] = "]"

        return table.concat(pattern)
    end

    local candidate: string
    local plain: boolean
    if #bytes == 0 or #bytes == 256 then
        return nil
    elseif #bytes == 1 then
        candidate, plain = string.char(bytes[1]), true
    else
        local value = {}
        for _, byte in ipairs(bytes) do
            value[#value + 1] = string.char(byte)
        end
        candidate, plain = classPattern(table.concat(value)), false
    end
    local plan = {
        value = candidate,
        plain = plain,
        direct = nil as string?,
        directPlain = nil as boolean?,
        result = nil as string?,
    }

    local function dereference(index)
        local active = {}
        while nodes[index][1] == "reference" and not active[index] do
            active[index], index = true, nodes[index][2]
        end

        return index
    end

    local function literalPattern(value)
        local pattern = {}
        for offset = 1, #value do
            local byte = value:byte(offset)
            if byte == 0 then
                pattern[#pattern + 1] = "%z"
            else
                local character = string.char(byte)
                if string.find("^$()%.[]*+-?", character, 1, true) then
                    pattern[#pattern + 1] = "%"
                end
                pattern[#pattern + 1] = character
            end
        end

        return table.concat(pattern)
    end

    local function atomPattern(index)
        local node = nodes[dereference(index)]
        if node[1] == "literal" and #node[2] == 1 then
            return literalPattern(node[2])
        elseif node[1] == "set" then
            return classPattern(node[2])
        elseif node[1] == "any" then
            return "."
        end

        return nil
    end

    local fixedPattern
    fixedPattern = function(index, allowRepeat)
        index = dereference(index)
        local node = nodes[index]
        if node[1] == "literal" then
            return literalPattern(node[2])
        elseif node[1] == "set" then
            return classPattern(node[2])
        elseif node[1] == "any" then
            return "."
        elseif node[1] == "eof" then
            return "$"
        elseif node[1] == "sequence" then
            local parts = {}
            for child = 2, #node do
                local childNode = nodes[dereference(node[child])]
                local lastConsuming = child == #node or (
                    child == #node - 1 and nodes[dereference(node[#node])][1] == "eof"
                )
                local part
                if childNode[1] == "oneOrMore" and lastConsuming then
                    local atom = atomPattern(childNode[2])
                    part = atom and (atom .. "+") or nil
                else
                    part = fixedPattern(node[child], false)
                end
                if not part then
                    return nil
                end
                parts[#parts + 1] = part
            end

            return table.concat(parts)
        elseif node[1] == "oneOrMore" and allowRepeat then
            local atom = atomPattern(node[2])
            return atom and (atom .. "+") or nil
        end

        return nil
    end

    local directRoot = dereference(root)
    local directResult
    local function hasCaptures(index, seen)
        index = dereference(index)
        if seen[index] then
            return false
        end
        seen[index] = true
        local node = nodes[index]
        local op = node[1]
        if op == "capture" or op == "collect" or op == "action" or op == "position" then
            return true
        elseif op == "sequence" or op == "choice" or op == "difference" then
            for child = 2, #node do
                if hasCaptures(node[child], seen) then
                    return true
                end
            end
        elseif op == "zeroOrMore" or op == "oneOrMore" or op == "optional" or op == "and" or op == "not" then
            return hasCaptures(node[2], seen)
        end

        return false
    end

    if singleResult(validated.result, "integer") and not hasCaptures(root, {}) then
        directResult = "integer"
    elseif singleResult(validated.result, "string") and nodes[directRoot][1] == "capture" then
        directRoot = nodes[directRoot][2]
        directResult = "string"
    end
    if directResult then
        local directNode = nodes[dereference(directRoot)]
        if directNode[1] == "literal" and directNode[2] ~= "" then
            plan.direct, plan.directPlain, plan.result = directNode[2], true, directResult
        else
            local direct = fixedPattern(directRoot, true)
            if direct and direct ~= "" and direct ~= "$" then
                plan.direct, plan.directPlain, plan.result = direct, false, directResult
            end
        end
    end

    return plan
end

-- Preserve the canonical PEG graph as the general execution plan and derive
-- only the small, proven straight-line kernels that Nupp can beat LPeg on.
-- Nothing below constructs or interprets a second instruction language.
local function compilePlan(validated)
    if validated.general then
        return {graph = {nodes = validated.nodes, root = validated.root}, actions = validated.slots, captureful = true,}
    end

    local nodes, sets, setIndices = validated.nodes, {}, {}
    local function class(bytes)
        if #bytes == 1 then
            return nil, bytes:byte(1)
        end
        local index = setIndices[bytes]
        if not index then
            local included, bitmap = {}, {}
            for offset = 1, #bytes do
                included[bytes:byte(offset)] = true
            end
            for byte = 0, 255 do
                bitmap[#bitmap + 1] = included[byte] and "\1" or "\0"
            end
            index = #sets + 1
            sets[index], setIndices[bytes] = table.concat(bitmap), index
        end

        return index, nil
    end

    local function fixedSequence(index, out)
        local node, op = nodes[index], nodes[index][1]
        if op == "literal" then
            if #out + #node[2] > 64 then
                return nil
            end
            for offset = 1, #node[2] do
                out[#out + 1] = node[2]:byte(offset)
            end
        elseif op == "set" then
            if #out >= 64 then
                return nil
            end
            local setIndex, byte = class(node[2])
            out[#out + 1] = byte or (setIndex + 255)
        elseif op == "sequence" then
            for child = 2, #node do
                if not fixedSequence(node[child], out) then
                    return nil
                end
            end
        elseif op == "choice" then
            local members = {}
            for child = 2, #node do
                local candidate = {}
                if not fixedSequence(node[child], candidate) or #candidate ~= 1 then
                    return nil
                end
                local encoded = candidate[1]
                if encoded < 256 then
                    members[encoded] = true
                else
                    local bitmap = sets[encoded - 255]
                    for byte = 0, 255 do
                        if bitmap:byte(byte + 1) ~= 0 then
                            members[byte] = true
                        end
                    end
                end
            end
            local bytes = {}
            for byte = 0, 255 do
                if members[byte] then
                    bytes[#bytes + 1] = string.char(byte)
                end
            end
            local setIndex, byte = class(table.concat(bytes))
            out[#out + 1] = byte or (setIndex + 255)
        else
            return nil
        end

        return out
    end

    local parts = {}
    local function flatten(index)
        local node = nodes[index]
        if node[1] == "sequence" then
            for child = 2, #node do
                flatten(node[child])
            end
        else
            parts[#parts + 1] = index
        end
    end

    flatten(validated.root)

    local fastFixed
    if singleResult(validated.result, "integer") and #parts > 1 and nodes[parts[#parts]][1] == "eof" then
        local checks = {}
        for index = 1, #parts - 1 do
            if not fixedSequence(parts[index], checks) then
                checks = nil
                break
            end
        end
        if checks and #checks >= 4 then
            fastFixed = checks
        end
    end

    local fastScan
    if singleResult(validated.result, "integer") and #parts >= 5 and nodes[parts[#parts]][1] == "eof" then
        local prefix, separator, repetition = nodes[parts[1]], nodes[parts[2]], nodes[parts[3]]
        if prefix[
            1
        ] == "choice" and separator[
            1
        ] == "literal" and separator[2] ~= "" and (repetition[1] == "zeroOrMore" or repetition[1] == "oneOrMore") then
            local prefixes, prefixFree, maximum = {}, true, 0
            local function collectPrefixes(index)
                local candidate = nodes[index]
                if candidate[1] == "choice" then
                    for child = 2, #candidate do
                        if not collectPrefixes(candidate[child]) then
                            return nil
                        end
                    end
                elseif candidate[1] == "literal" and candidate[2] ~= "" then
                    prefixes[#prefixes + 1] = candidate[2]
                    maximum = math.max(maximum, #candidate[2])
                else
                    return nil
                end

                return true
            end

            if not collectPrefixes(parts[1]) then
                prefixFree = false
            end
            for left = 1, #prefixes do
                for right = 1, #prefixes do
                    if left ~= right and prefixes[right]:sub(1, #prefixes[left]) == prefixes[left] then
                        prefixFree = false
                    end
                end
                if prefixes[left]:find(separator[2]:sub(1, 1), 1, true) then
                    prefixFree = false
                end
            end
            local scan = fixedSequence(repetition[2], {})
            local suffix = {}
            for index = 4, #parts - 1 do
                if not fixedSequence(parts[index], suffix) then
                    suffix = nil
                    break
                end
            end
            if prefixFree and scan and #scan == 1 and suffix and #suffix > 0 and #suffix <= 16 then
                local keys, packedKeys, lengths = {}, {}, {}
                local canPack = maximum <= 6 and #prefixes <= 8 and #separator[2] == 1
                for index, text in ipairs(prefixes) do
                    local key, packed = 1, 0
                    for offset = 1, #text do
                        key = key * 257 + text:byte(offset)
                        if canPack then
                            packed = packed * 256 + text:byte(offset)
                        end
                    end
                    keys[index], lengths[index] = key, #text
                    if canPack then
                        packedKeys[index] = packed * 8 + #text
                    end
                end
                fastScan = {
                    keys = keys,
                    packedKeys = canPack and packedKeys or nil,
                    lengths = lengths,
                    maximum = maximum,
                    separator = separator[2],
                    scan = scan[1],
                    minimum = repetition[1] == "oneOrMore" and 1 or 0,
                    suffix = suffix,
                }
            end
        end
    end

    local fastRepeat
    do
        local root, result = validated.root, "integer"
        if singleResult(validated.result, "string") and nodes[root][1] == "capture" then
            root, result = nodes[root][2], "string"
        elseif not singleResult(validated.result, "integer") then
            root = nil
        end
        if root then
            local repeatParts = {}
            local function flattenRepeat(index)
                local node = nodes[index]
                if node[1] == "sequence" then
                    for child = 2, #node do
                        flattenRepeat(node[child])
                    end
                else
                    repeatParts[#repeatParts + 1] = index
                end
            end

            flattenRepeat(root)
            local eof = #repeatParts > 1 and nodes[repeatParts[#repeatParts]][1] == "eof"
            if eof then
                table.remove(repeatParts)
            end
            local head, tail
            if #repeatParts == 1 and nodes[repeatParts[1]][1] == "oneOrMore" then
                local check = fixedSequence(nodes[repeatParts[1]][2], {})
                if check and #check == 1 then
                    head, tail = check[1], check[1]
                end
            elseif #repeatParts == 2 and nodes[repeatParts[2]][1] == "zeroOrMore" then
                local first = fixedSequence(repeatParts[1], {})
                local rest = fixedSequence(nodes[repeatParts[2]][2], {})
                if first and #first == 1 and rest and #rest == 1 then
                    head, tail = first[1], rest[1]
                end
            end
            if head then
                fastRepeat = {head = head, tail = tail, eof = eof, result = result}
            end
        end
    end

    local function hasCaptures(index, seen)
        if seen[index] then
            return false
        end
        seen[index] = true
        local node, op = nodes[index], nodes[index][1]
        if op == "capture" or op == "collect" or op == "action" or op == "position" then
            return true
        elseif op == "sequence" or op == "choice" or op == "difference" then
            for child = 2, #node do
                if hasCaptures(node[child], seen) then
                    return true
                end
            end
        elseif op == "zeroOrMore" or op == "oneOrMore" or op == "optional" or op == "and" or op == "not" then
            return hasCaptures(node[2], seen)
        end

        return false
    end

    return {
        graph = {nodes = nodes, root = validated.root},
        sets = sets,
        fastFixed = fastFixed,
        fastScan = fastScan,
        fastRepeat = fastRepeat,
        search = searchPlan(validated),
        actions = validated.slots,
        captureful = hasCaptures(validated.root, {}),
    }
end

----------------------------------------------------------------------------
-- Lowering
----------------------------------------------------------------------------

local function dataIR(value)
    if type(value) ~= "table" then
        return {tag = "literal", value = value}
    end
    local array, fields, names = {}, {}, {}
    for index = 1, #value do
        array[index] = dataIR(value[index])
    end
    for name in pairs(value) do
        if type(name) == "string" then
            names[#names + 1] = name
        end
    end
    table.sort(names)
    for _, name in ipairs(names) do
        fields[#fields + 1] = {name = name, value = dataIR(value[name])}
    end

    return {tag = "table", array = array, fields = fields}
end

function peg.lower(envelope: any, expected: any, env: any): any, peg.Failure?, any, T.Type?
    local validated, why = validateEnvelope(envelope)
    if not validated then
        return nil, failure("NUPP2415", why as string)
    end
    local pegTypes = env and env.globalTypes and env.globalTypes["nupp.peg"]
    local matcher = pegTypes and pegTypes.nestedTypes and pegTypes.nestedTypes.Peg
    local resultPack, actionReturns
    local inferredTarget
    if #validated.slots == 0 then
        if expected then
            resultPack = matcherResult(expected, matcher)
            if not resultPack then
                return nil, failure(
                    "NUPP2415",
                    "a comptime PEG must be declared as nupp.peg.Peg<R...>",
                    "declare the constant as nupp.peg.Peg<R...> or leave the type to be inferred"
                )
            end
        else
            resultPack = packOfResult(validated.result, nil)
        end
        local binder = matcher and matcher.packParams and matcher.packParams[1]
        if not expected and matcher and binder and resultPack then
            inferredTarget = generics.instantiate(matcher, {[binder] = resultPack})
        end
    elseif not expected then
        return nil, failure(
            "NUPP2414",
            "a comptime PEG with actions needs a declared matcher factory type",
            "declare function(Actions): nupp.peg.Peg<R> so each action slot and result can be checked"
        )
    elseif expected
        and expected.tag == "func"
        and #expected.params == 1
        and #expected.rets == 1
        and not expected.vararg
    then
        resultPack = matcherResult(expected.rets[1], matcher)
        local actionWhy
        if validated.general then
            actionReturns, actionWhy = generalDefinitionTypes(validated.slots, expected.params[1])
        else
            actionReturns, actionWhy = actionReturnTypes(validated.slots, expected.params[1])
        end
        if not actionReturns then
            return nil, failure("NUPP2415", actionWhy as string)
        end
    end
    if not resultPack or not resultFits(validated.result, resultPack, actionReturns) then
        return nil, failure("NUPP2415", "PEG blueprint result pack does not match the declared matcher type")
    end
    local backend = validated.backend == "auto" and "nupp.peg.codegen" or "nupp.peg.lpeg"
    local machine = {tag = "call", callee = {tag = "helper", name = backend}, args = {dataIR(compilePlan(validated))},}
    if #validated.slots == 0 then
        return machine, nil, {
            backend = validated.backend,
            emitterAbi = 7,
            helperAbi = 9,
            runtimeFeatures = {"stdlib.peg"},
        }, inferredTarget
    end
    machine.args[2] = {tag = "local", id = 1}

    return {
        tag = "function",
        params = {1},
        body = {{tag = "return", value = machine}},
    }, nil, {backend = validated.backend, emitterAbi = 7, helperAbi = 9, runtimeFeatures = {"stdlib.peg"},}
end

export = peg
