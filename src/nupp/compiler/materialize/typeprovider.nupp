module nupp.compiler.materialize.typeprovider

--[[
The worker-side provider for compiler-only type and type-pack handles.

Handles contain only immutable blueprint nodes. They never contain checker objects,
nominal allocation identities, scopes or CST nodes. The parent validates and interns
the finalized graph through `nupp.compiler.typeblueprint`.
]]

local hash = require("nupp.compiler.hash")
local stable = require("nupp.compiler.stable")

----------------------------------------------------------------------------
-- Handles and failures
----------------------------------------------------------------------------

type typeprovider.Failure = {
    readonly code: string,
    readonly message: string,
    readonly help: string?
}

local record typeprovider
    SCHEMA: integer
    MAX_NODES: integer
    MAX_MEMBERS: integer
    installEvaluator: function(any, any, any, any)
    opaqueKind: function(any, any): string?
    operator: function(any, string, any, any): (any, typeprovider.Failure?)
    finalize: function(any, any): (any, typeprovider.Failure?)
    importDescriptor: function(any, any, any?, string?): (any, typeprovider.Failure?)
    importFunctionConst: function(any, string): any
end

typeprovider.SCHEMA = 1
typeprovider.MAX_NODES = 10000
typeprovider.MAX_MEMBERS = 1000

local PRIMITIVES = {
    any = true,
    unknown = true,
    never = true,
    ["nil"] = true,
    boolean = true,
    string = true,
    number = true,
    integer = true,
    ["table"] = true,
    thread = true,
    userdata = true,
    float = true,
    cdata = true,
    cstring = true,
    voidptr = true,
    int8 = true,
    int16 = true,
    int32 = true,
    int64 = true,
    uint8 = true,
    uint16 = true,
    uint32 = true,
    uint64 = true,
}

local function failure(code, message, help)
    return {code = code, message = message, help = help} as typeprovider.Failure
end

local function entry(state, value, family)
    local found = state.opaque[value]
    if not found or found.provider ~= "types" or family and found.family ~= family then
        return nil
    end

    return found
end

local function memberArray(state, values, family, label)
    if type(values) ~= "table" then
        return nil, failure("NUPP2415", label .. " needs an array")
    end
    if #values > typeprovider.MAX_MEMBERS then
        return nil, failure("NUPP2416", label .. " exceeds the 1000-member type limit")
    end
    local out = {}
    for index, value in ipairs(values) do
        local found = entry(state, value, family)
        if not found then
            return nil, failure("NUPP2415", label .. " contains a foreign handle at " .. tostring(index))
        end
        out[index] = value
    end

    return out, nil
end

local function keyOf(state, handle)
    local found = entry(state, handle)
    return found and found.payload and found.payload.key or nil
end

-- Every structural key names its kind and length-prefixes its parts, so a part that
-- itself contains a key cannot be read as two: `indexer(union(nil, number), integer)`
-- and `union(nil, indexer(number, integer))` spell different strings however their
-- members are joined.
local function composeKey(kind, parts)
    local out = {kind, "("}
    for _, part in ipairs(parts) do
        out[#out + 1] = tostring(#part) .. ":" .. part
    end
    out[#out + 1] = ")"

    return table.concat(out)
end

local function withIndexer(keys, indexKey)
    keys[#keys + 1] = indexKey

    return keys
end

local function make(state, opaque, family, payload, at)
    local key = family .. ":" .. payload.key
    local prior = state.typeHandles[key]
    if prior then
        return prior
    end
    local made = opaque("types", family, payload, at)
    state.typeHandles[key] = made

    return made
end

local function installIntrinsic(state, library, name, implementation)
    -- A fresh table, not a closure: the evaluator matches intrinsics by object
    -- identity, and Lua 5.3 answers an upvalue-free `function() end` with one
    -- shared closure however often it is evaluated.
    local token = {}
    state.intrinsics[token] = implementation
    library[name] = token
end

----------------------------------------------------------------------------
-- The evaluator
----------------------------------------------------------------------------

function typeprovider.installEvaluator(state, env, opaque, provenance)
    state.typeHandles = {}
    state.typeNominalFamilies = {}
    state.typeOpaque = opaque
    local library = {}

    local function primitive(name)
        return make(
            state,
            opaque,
            "Type",
            {
                kind = "primitive",
                name = name,
                key = composeKey("primitive", {
                    name
                })
            },
            nil
        )
    end

    for name in pairs(PRIMITIVES) do
        library[name == "nil" and "nil_" or name == "table" and "table_" or name] = primitive(name)
    end

    -- Not in `PRIMITIVES`, so `nupp.types.open` is not a handle anybody can read. The
    -- only way to place the open member in a union is to call for it, which is what
    -- makes a non-exhaustive union a written decision rather than an inferred one.
    installIntrinsic(state, library, "nonExhaustive", function(at, args)
        if args[1] ~= nil then
            return nil, failure("NUPP2415", "nupp.types.nonExhaustive takes no arguments")
        end

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "primitive",
                name = "open",
                key = composeKey("primitive", {
                    "open"
                })
            },
            provenance(at, "nonExhaustive")
        )
    end)

    installIntrinsic(state, library, "literal", function(at, args)
        local value = args[1]
        local valueKind = type(value)
        if valueKind ~= "string" and valueKind ~= "boolean" and (
            valueKind ~= "number" or value ~= math.floor(value)
        ) then
            return nil, failure("NUPP2415", "nupp.types.literal needs a string, boolean, or exact integer")
        end
        local base = valueKind == "string"
            and library.string
            or valueKind == "boolean"
            and library.boolean
            or library.integer
        local encoded = composeKey("literal", {valueKind, tostring(value)})

        return make(
            state,
            opaque,
            "Type",
            {kind = "literal", value = value, base = base, key = encoded},
            provenance(at, "literal")
        )
    end)

    installIntrinsic(state, library, "array", function(at, args)
        local element = entry(state, args[1], "Type")
        if not element then
            return nil, failure("NUPP2415", "nupp.types.array needs one type handle")
        end

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "array",
                element = args[1],
                key = composeKey("array", {
                    element.payload.key
                })
            },
            provenance(at, "array")
        )
    end)

    installIntrinsic(state, library, "tuple", function(at, args)
        local members, why = memberArray(state, args[1], "Type", "nupp.types.tuple")
        if not members then
            return nil, why
        end
        local keys = {}
        for index, member in ipairs(members) do
            keys[index] = keyOf(state, member)
        end

        return make(
            state,
            opaque,
            "Type",
            {kind = "tuple", members = members, key = composeKey("tuple", keys)},
            provenance(at, "tuple")
        )
    end)

    -- A union or intersection is a set: nested members of the same kind are opened
    -- up, duplicates dropped, and the rest ordered by key, so `optional(optional(T))`
    -- and `optional(T)` are one handle, as are `optional(A | B)` and `A | B | nil`.
    local function setLikeHandle(at, kind, origin, members)
        local byKey = {}
        local function add(member)
            local found = entry(state, member, "Type")
            if found.payload.kind == kind then
                for _, nested in ipairs(found.payload.members) do
                    add(nested)
                end
            else
                byKey[found.payload.key] = member
            end
        end

        for _, member in ipairs(members) do
            add(member)
        end
        local keys = {}
        for key in pairs(byKey) do
            keys[#keys + 1] = key
        end
        table.sort(keys)
        local canonical = {}
        for index, key in ipairs(keys) do
            canonical[index] = byKey[key]
        end

        return make(
            state,
            opaque,
            "Type",
            {kind = kind, members = canonical, key = composeKey(kind, keys)},
            provenance(at, origin)
        )
    end

    local function setLike(name, kind)
        installIntrinsic(state, library, name, function(at, args)
            local members, why = memberArray(state, args[1], "Type", "nupp.types." .. name)
            if not members then
                return nil, why
            end

            return setLikeHandle(at, kind, kind, members)
        end)
    end

    setLike("union", "union")
    setLike("intersection", "intersection")

    installIntrinsic(state, library, "optional", function(at, args)
        local inner = entry(state, args[1], "Type")
        if not inner then
            return nil, failure("NUPP2415", "nupp.types.optional needs one type handle")
        end

        return setLikeHandle(at, "union", "optional", {args[1], library.nil_})
    end)

    -- The parameters a declaration is constructed with, as a pack whose slots are
    -- named, so `...: unpackof nupp.types.construction(E)` binds named arguments
    -- and admits an omitted slot the declaration defaults. A slot with a default
    -- is optional here rather than filled: the initializer that runs against
    -- acquired storage applies the default when it sees nil, which is the one
    -- place that can, since a positional call never passes through this check.
    installIntrinsic(state, library, "construction", function(at, args)
        local found = entry(state, args[1], "Type")
        local nominal = found and found.payload.kind == "reference" and found.payload.nominal or nil
        local construction = nominal and nominal.construction or nil
        if not construction then
            return nil, failure("NUPP2415", "nupp.types.construction needs a record or struct handle")
        end
        if construction.overloaded then
            return nil, failure(
                "NUPP2415",
                "nupp.types.construction needs a declaration with one constructor, and " .. tostring(
                    nominal.name
                ) .. " declares several"
            )
        end
        local head, names, modes, keys = {}, {}, {}, {}
        for position, parameter in ipairs(construction.params or {}) do
            local member = parameter.type
            if not member then
                return nil, failure("NUPP2415", "nupp.types.construction found a parameter without a type")
            end
            if parameter.optional then
                member = setLikeHandle(at, "union", "optional", {member, library.nil_})
            end
            local mode = parameter.mode == "borrows" and "borrowed" or parameter.mode or "plain"
            head[position], names[position], modes[position] = member, parameter.name or "", mode
            keys[position] = composeKey(mode, {keyOf(state, member), names[position]})
        end
        keys[#keys + 1] = "-"

        return make(
            state,
            opaque,
            "Pack",
            {kind = "pack", head = head, modes = modes, names = names, key = composeKey("pack", keys),},
            provenance(at, "construction")
        )
    end)

    local function unary(name, kind)
        installIntrinsic(state, library, name, function(at, args)
            local inner = entry(state, args[1], "Type")
            if not inner then
                return nil, failure("NUPP2415", "nupp.types." .. name .. " needs one type handle")
            end

            return make(
                state,
                opaque,
                "Type",
                {
                    kind = kind,
                    inner = args[1],
                    key = composeKey(kind, {
                        inner.payload.key
                    })
                },
                provenance(at, kind)
            )
        end)
    end

    unary("pointer", "ptr")
    unary("constof", "const")
    unary("borrowed", "borrowed")
    unary("pinned", "pinned")
    installIntrinsic(state, library, "affine", function(at, args)
        local inner = entry(state, args[1], "Type")
        if not inner then
            return nil, failure("NUPP2415", "nupp.types.affine needs a representation type handle")
        end
        local terminal = args[2] and entry(state, args[2], "FunctionConst") or nil
        if args[2] ~= nil and not terminal then
            return nil, failure("NUPP2415", "nupp.types.affine terminal must be a const-function parameter")
        end
        local terminalKey = terminal and terminal.payload.key or nil

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "affine",
                inner = args[1],
                terminal = terminalKey,
                transferOnly = terminal == nil,
                key = composeKey("affine", {inner.payload.key, terminalKey or "transfer"})
            },
            provenance(at, "affine")
        )
    end)

    installIntrinsic(state, library, "carray", function(at, args)
        local element = entry(state, args[1], "Type")
        local count = args[2]
        if not element then
            return nil, failure("NUPP2415", "nupp.types.carray needs an element type")
        end
        if count ~= nil and (type(count) ~= "number" or count ~= math.floor(count) or count < 0) then
            return nil, failure("NUPP2415", "nupp.types.carray count must be a non-negative exact integer")
        end

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "carray",
                element = args[1],
                count = count,
                key = composeKey("carray", {
                    element.payload.key,
                    tostring(count)
                })
            },
            provenance(at, "carray")
        )
    end)

    installIntrinsic(state, library, "indexer", function(at, args)
        local names = {"read key", "read value", "write key", "write value"}
        for index = 1, 4 do
            if args[index] ~= nil and not entry(state, args[index], "Type") then
                return nil, failure("NUPP2415", "nupp.types.indexer " .. names[index] .. " must be a type handle")
            end
        end
        if (args[1] == nil) ~= (args[2] == nil) or (args[3] == nil) ~= (args[4] == nil) then
            return nil, failure("NUPP2415", "nupp.types.indexer capabilities need key/value pairs")
        end
        if args[1] == nil and args[3] == nil then
            return nil, failure("NUPP2415", "nupp.types.indexer needs a read or write capability")
        end
        local keys = {}
        for index = 1, 4 do
            keys[index] = args[index] and keyOf(state, args[index]) or "-"
        end

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "indexer",
                readKey = args[1],
                readValue = args[2],
                writeKey = args[3],
                writeValue = args[4],
                key = composeKey("indexer", keys)
            },
            provenance(at, "indexer")
        )
    end)

    installIntrinsic(state, library, "map", function(at, args)
        local readKey, readValue = entry(state, args[1], "Type"), entry(state, args[2], "Type")
        -- An omitted write side mirrors the read side; a supplied one must be a
        -- handle, so a stray value fails here rather than silently reading as omitted.
        local writeKey, writeValue = readKey, readValue
        if args[3] ~= nil then
            writeKey = entry(state, args[3], "Type")
        end
        if args[4] ~= nil then
            writeValue = entry(state, args[4], "Type")
        end
        if not readKey or not readValue or not writeKey or not writeValue then
            return nil, failure(
                "NUPP2415",
                "nupp.types.map needs read key/value handles and optional write key/value handles"
            )
        end
        local keys = {readKey.payload.key, readValue.payload.key, writeKey.payload.key, writeValue.payload.key}

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "indexer",
                readKey = args[1],
                readValue = args[2],
                writeKey = args[3] or args[1],
                writeValue = args[4] or args[2],
                key = composeKey("indexer", keys)
            },
            provenance(at, "map")
        )
    end)

    installIntrinsic(state, library, "shape", function(at, args)
        local supplied, indexer = args[1], args[2]
        if type(supplied) ~= "table" or #supplied > typeprovider.MAX_MEMBERS then
            return nil, failure("NUPP2415", "nupp.types.shape needs at most 1000 field descriptors")
        end
        if indexer ~= nil then
            local found = entry(state, indexer, "Type")
            if not found or found.payload.kind ~= "indexer" then
                return nil, failure("NUPP2415", "nupp.types.shape indexer must come from nupp.types.indexer")
            end
        end
        local fields, seen = {}, {}
        for position, field in ipairs(supplied) do
            if type(field) ~= "table" or type(field.name) ~= "string" or field.name == "" or seen[field.name] then
                return nil, failure(
                    "NUPP2415",
                    "nupp.types.shape has an invalid or repeated field at " .. tostring(position)
                )
            end
            local read, write = field.read, field.write
            if read == nil and write == nil or read ~= nil and not entry(
                state,
                read,
                "Type"
            ) or write ~= nil and not entry(state, write, "Type") then
                return nil, failure(
                    "NUPP2415",
                    "nupp.types.shape field " .. field.name .. " needs a read or write type"
                )
            end
            seen[field.name] = true
            fields[#fields + 1] = {name = field.name, read = read, write = write}
        end
        table.sort(fields, function(left, right)
            return left.name < right.name
        end)
        local keys = {}
        for position, field in ipairs(fields) do
            keys[position] = composeKey("field", {
                field.name,
                field.read and keyOf(state, field.read) or "-",
                field.write and keyOf(state, field.write) or "-",
            })
        end
        keys[#keys + 1] = indexer and keyOf(state, indexer) or "-"

        return make(
            state,
            opaque,
            "Type",
            {kind = "shape", fields = fields, indexer = indexer, key = composeKey("shape", keys)},
            provenance(at, "shape")
        )
    end)

    installIntrinsic(state, library, "pack", function(at, args)
        local head, why = memberArray(state, args[1] or {}, "Type", "nupp.types.pack")
        if not head then
            return nil, why
        end
        local tail = args[2]
        if tail ~= nil and not entry(state, tail, "Type") then
            return nil, failure("NUPP2415", "nupp.types.pack tail must be a type handle")
        end
        local modes = args[3] or {}
        if type(modes) ~= "table" or #modes > #head then
            return nil, failure("NUPP2415", "nupp.types.pack modes must align with its fixed head")
        end
        local keys, copiedModes = {}, {}
        for index, member in ipairs(head) do
            local mode = modes[index] or "plain"
            if mode ~= "plain"
                and mode ~= "affine"
                and mode ~= "borrowed"
                and mode ~= "exclusive"
                and mode ~= "pinned"
            then
                return nil, failure("NUPP2415", "nupp.types.pack has an invalid mode at " .. tostring(index))
            end
            copiedModes[index] = mode
            keys[index] = composeKey(mode, {keyOf(state, member)})
        end
        keys[#keys + 1] = tail and keyOf(state, tail) or "-"

        return make(
            state,
            opaque,
            "Pack",
            {kind = "pack", head = head, tail = tail, modes = copiedModes, key = composeKey("pack", keys)},
            provenance(at, "pack")
        )
    end)

    installIntrinsic(state, library, "function_", function(at, args)
        local parameters, results = entry(state, args[1], "Pack"), entry(state, args[2], "Pack")
        if not parameters or not results then
            return nil, failure("NUPP2415", "nupp.types.function_ needs parameter and result type packs")
        end

        return make(
            state,
            opaque,
            "Type",
            {
                kind = "function",
                parameters = args[1],
                results = args[2],
                key = composeKey("function", {
                    parameters.payload.key,
                    results.payload.key
                })
            },
            provenance(at, "function")
        )
    end)

    installIntrinsic(state, library, "parameters", function(_, args)
        local found = entry(state, args[1], "Type")
        if not found or found.payload.kind ~= "function" then
            return nil, failure("NUPP2415", "nupp.types.parameters needs a function type")
        end

        return found.payload.parameters
    end)

    installIntrinsic(state, library, "results", function(_, args)
        local found = entry(state, args[1], "Type")
        if not found or found.payload.kind ~= "function" then
            return nil, failure("NUPP2415", "nupp.types.results needs a function type")
        end

        return found.payload.results
    end)

    installIntrinsic(state, library, "kind", function(_, args)
        local found = entry(state, args[1])
        if not found then
            return nil, failure("NUPP2415", "nupp.types.kind needs a type or type-pack handle")
        end

        return found.payload.kind
    end)

    installIntrinsic(state, library, "describe", function(_, args)
        local found = entry(state, args[1])
        if not found then
            return nil, failure("NUPP2415", "nupp.types.describe needs a type or type-pack handle")
        end
        local payload = found.payload

        return {
            kind = payload.kind,
            sourceKind = payload.sourceKind,
            name = payload.name,
            value = payload.value,
            element = payload.element,
            members = payload.members,
            fields = payload.fields,
            indexer = payload.indexer,
            readKey = payload.readKey,
            readValue = payload.readValue,
            writeKey = payload.writeKey,
            writeValue = payload.writeValue,
            nominal = payload.nominal,
            head = payload.head,
            tail = payload.tail,
            modes = payload.modes,
            count = payload.count,
            parameters = payload.parameters,
            results = payload.results,
        }
    end)

    installIntrinsic(state, library, "elements", function(_, args)
        local found = entry(state, args[1])
        if not found then
            return nil, failure("NUPP2415", "nupp.types.elements needs a type or type-pack handle")
        end
        local payload = found.payload
        -- A pack's elements are its fixed head. A tail is a separate question, since it
        -- stands for however many values are left rather than for one of them, and
        -- `describe` is where a caller asks about it.
        if found.family == "Pack" then
            local head = {}
            for position, member in ipairs(payload.head or {}) do
                head[position] = member
            end

            return head
        end
        if payload.kind == "array" or payload.kind == "carray" then
            return {payload.element}
        end
        if payload.kind == "ptr"
            or payload.kind == "const"
            or payload.kind == "borrowed"
            or payload.kind == "pinned"
            or payload.kind == "affine"
        then
            return {payload.inner}
        end
        if payload.kind == "tuple" or payload.kind == "union" or payload.kind == "intersection" then
            return payload.members
        end

        return nil, failure("NUPP2415", "nupp.types.elements cannot inspect " .. tostring(payload.kind))
    end)

    installIntrinsic(state, library, "arguments", function(_, args)
        local found = entry(state, args[1], "Type")
        if not found then
            return nil, failure("NUPP2415", "nupp.types.arguments needs a type handle")
        end
        local nominal = found.payload.nominal
        local supplied = type(nominal) == "table" and nominal.arguments or nil
        local out = {}
        for position, argument in ipairs(supplied or {}) do
            out[position] = argument
        end

        return out
    end)

    installIntrinsic(state, library, "sameNominal", function(_, args)
        if not entry(state, args[1], "Type") or not entry(state, args[2], "Type") then
            return nil, failure("NUPP2415", "nupp.types.sameNominal needs two type handles")
        end
        local function nominal(value)
            local found = entry(state, value, "Type")
            while found and (
                found.payload.kind == "const"
                or found.payload.kind == "borrowed"
                or found.payload.kind == "pinned"
                or found.payload.kind == "affine"
            ) do
                found = entry(state, found.payload.inner, "Type")
            end

            return found and found.payload.nominal or nil
        end

        local left, right = nominal(args[1]), nominal(args[2])
        if not left or not right then
            return false
        end

        return left.family == right.family
    end)

    installIntrinsic(state, library, "fields", function(_, args)
        local found = entry(state, args[1], "Type")
        if not found or found.payload.kind ~= "shape" and not (
            found.payload.kind == "reference" and found.payload.nominal
        ) then
            return nil, failure("NUPP2415", "nupp.types.fields needs a shape or nominal handle")
        end
        local fields = {}
        for position, field in ipairs(found.payload.fields or {}) do
            fields[position] = {name = field.name, read = field.read, write = field.write}
        end

        return fields
    end)

    local function keysFor(args, capability)
        local found = entry(state, args[1], "Type")
        if not found or found.payload.kind ~= "shape" and found.payload.kind ~= "indexer" then
            return nil, failure("NUPP2415", "nupp.types." .. capability .. "Keys needs a shape or indexer handle")
        end
        local keys = {}
        for _, field in ipairs(found.payload.fields or {}) do
            if field[capability] then
                local value = field.name
                keys[
                    #keys + 1
                ] = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "literal",
                        value = value,
                        base = library.string,
                        key = composeKey("literal", {
                            "string",
                            value
                        }),
                    },
                    nil
                )
            end
        end
        local indexer = found.payload.kind == "indexer" and found or entry(state, found.payload.indexer, "Type")
        local indexKey = indexer and indexer.payload[capability .. "Key"] or nil
        if indexKey then
            keys[#keys + 1] = indexKey
        end

        return keys
    end

    installIntrinsic(state, library, "readKeys", function(_, args)
        return keysFor(args, "read")
    end)
    installIntrinsic(state, library, "writeKeys", function(_, args)
        return keysFor(args, "write")
    end)

    local function atFor(args, capability)
        local found, key = entry(state, args[1], "Type"), entry(state, args[2], "Type")
        if not found or not key then
            return nil, failure("NUPP2415", "nupp.types." .. capability .. "At needs type handles")
        end
        if key.payload.kind == "literal" and type(key.payload.value) == "string" then
            for _, field in ipairs(found.payload.fields or {}) do
                if field.name == key.payload.value and field[capability] then
                    return field[capability]
                end
            end
        end
        local indexer = found.payload.kind == "indexer" and found or entry(state, found.payload.indexer, "Type")
        if indexer and indexer.payload[capability .. "Value"] then
            return indexer.payload[capability .. "Value"]
        end

        return nil, failure("NUPP2420", "type has no " .. capability .. " capability at the requested key")
    end

    installIntrinsic(state, library, "readAt", function(_, args)
        return atFor(args, "read")
    end)
    installIntrinsic(state, library, "writeAt", function(_, args)
        return atFor(args, "write")
    end)

    installIntrinsic(state, library, "error", function(_, args)
        if type(args[1]) ~= "string" then
            return nil, failure("NUPP2415", "nupp.types.error needs a string message")
        end
        return nil, failure("NUPP2420", args[1])
    end)

    env.nupp = env.nupp or {}
    env.nupp.types = library
end

----------------------------------------------------------------------------
-- Imported descriptors
----------------------------------------------------------------------------

--- Imports one closed const-function identity as a worker-opaque handle. Only the
--- compiler can mint the handle; provider code can pass it to affine construction but
--- cannot recover or forge its registry key.
function typeprovider.importFunctionConst(state: any, key: string): any
    local opaque = state.typeOpaque
    if not opaque or type(key) ~= "string" then
        return nil
    end

    return make(state, opaque, "FunctionConst", {key = key}, nil)
end

function typeprovider.importDescriptor(
    state: any,
    descriptor: any,
    source: any?,
    referencePrefix: string?
): any, typeprovider.Failure?
    if type(
        descriptor
    ) ~= "table" or type(descriptor.types) ~= "table" or type(descriptor.root) ~= "number" or not state.typeHandles then
        return nil, failure("NUPP2415", "type-function input has a malformed semantic descriptor")
    end
    local nodes, built, active = descriptor.types, {}, {}
    local opaque = state.typeOpaque
    if not opaque then
        return nil, failure("NUPP2415", "the type provider is not installed")
    end
    local import
    local function list(indices, label)
        if type(indices) ~= "table" or #indices > typeprovider.MAX_MEMBERS then
            return nil, failure("NUPP2415", label .. " has an invalid member list")
        end
        local values = {}
        for position, index in ipairs(indices) do
            values[position] = import(index)
            if not values[position] then
                return nil, failure("NUPP2415", label .. " has an invalid edge")
            end
        end

        return values, nil
    end

    import = function(index)
        if built[index] then
            return built[index]
        end
        if active[index] or type(index) ~= "number" or type(nodes[index]) ~= "table" then
            return nil
        end
        active[index] = true
        local node = nodes[index]
        local kind = node.kind
        local made
        local referencedSource = descriptor.sources and descriptor.sources[
            index
        ] or index == descriptor.root and source or nil
        if node.nominal and (referencedSource or referencePrefix) then
            local referenceFingerprint = node.referenceFingerprint or referencedSource and require(
                "nupp.compiler.reflection"
            ).describe(referencedSource).fingerprint or nil
            if type(referenceFingerprint) ~= "string" then
                return nil
            end
            local payload = {
                kind = "reference",
                source = referencedSource,
                referenceId = referencePrefix and referencePrefix .. ":" .. tostring(index) or nil,
                fingerprint = referenceFingerprint,
                key = "reference:" .. (
                    referencePrefix and referencePrefix .. ":" .. tostring(index) or referenceFingerprint
                ),
            }
            made = make(state, opaque, "Type", payload, nil)
            built[index] = made
            local reflected = {
                kind = node.kind,
                name = node.name,
                moduleName = node.moduleName,
                deriveKey = node.deriveKey,
                annotations = node.annotations or {},
                fields = {},
                supertypes = {},
            }
            payload.nominal = reflected
            local familySource = referencedSource
            while familySource and familySource.tag == "nominal" and familySource.origin do
                familySource = familySource.origin
            end
            local family = familySource and state.typeNominalFamilies[familySource] or nil
            if familySource and not family then
                family = {}
                state.typeNominalFamilies[familySource] = family
            end
            if not family and node.origin then
                local origin = import(node.origin)
                local originEntry = origin and entry(state, origin, "Type") or nil
                family = originEntry and originEntry.payload.nominal and originEntry.payload.nominal.family or nil
            end
            -- A source accompanies every ordinary type-function argument. The local
            -- token is only the conservative fallback for an imported descriptor that
            -- deliberately omitted its parent-side nominal identities: it can cause a
            -- false negative across two such descriptors, never make distinct
            -- declarations compare equal.
            reflected.family = node.nominalIdentity or family or {}
            for position, field in ipairs(node.fields or {}) do
                reflected.fields[
                    position
                ] = {
                    name = field.name,
                    read = field.read and import(field.read) or nil,
                    write = field.write and import(field.write) or nil,
                    readable = field.readable,
                    writable = field.writable,
                    hasDefault = field.hasDefault or false,
                    defaultValue = field.defaultValue,
                    annotations = field.annotations or {},
                }
            end
            -- Nominal identity remains a sealed reference, while its public field
            -- surface is ordinary immutable semantic data. Keeping the same array on
            -- the payload makes `describe` and `fields` agree without minting a
            -- structural replacement for the declaration.
            payload.fields = reflected.fields
            for position, supertype in ipairs(node.supertypes or {}) do
                reflected.supertypes[position] = import(supertype)
            end
            -- What the declaration was applied to, so a type function can take a
            -- `Component<Position>` apart the way the source wrote it.
            reflected.arguments = {}
            for position, argument in ipairs(node.typeArguments or {}) do
                reflected.arguments[position] = import(argument)
            end
            -- How the declaration is constructed: its one constructor's parameters,
            -- or its stored fields when it declares none. `nupp.types.construction`
            -- answers this as a pack whose slots carry the names a call binds by.
            if node.construction then
                local construction = {
                    declared = node.construction.declared == true,
                    overloaded = node.construction.overloaded == true,
                    params = {},
                }
                for position, parameter in ipairs(node.construction.params or {}) do
                    construction.params[
                        position
                    ] = {
                        name = parameter.name,
                        type = parameter.type and import(parameter.type) or nil,
                        optional = parameter.optional == true,
                        mode = parameter.mode or "plain",
                    }
                end
                reflected.construction = construction
            end
        elseif PRIMITIVES[kind] then
            made = make(
                state,
                opaque,
                "Type",
                {
                    kind = "primitive",
                    name = kind,
                    key = composeKey("primitive", {
                        kind
                    })
                },
                nil
            )
        elseif kind == "literal" then
            local base = import(node.base)
            if base then
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "literal",
                        value = node.value,
                        base = base,
                        key = composeKey("literal", {
                            type(node.value),
                            tostring(node.value)
                        }),
                    },
                    nil
                )
            end
        elseif kind == "typevar" or kind == "typeHandle" then
            made = import(node.bound)
        elseif kind == "array" then
            local element = import(node.element)
            if element then
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "array",
                        element = element,
                        key = composeKey("array", {
                            keyOf(state, element)
                        })
                    },
                    nil
                )
            end
        elseif kind == "map" then
            local readKey = node.readKey and import(node.readKey) or nil
            local readValue = node.readValue and import(node.readValue) or nil
            local writeKey = node.writeKey and import(node.writeKey) or nil
            local writeValue = node.writeValue and import(node.writeValue) or nil
            if (
                readKey == nil
            ) == (readValue == nil) and (writeKey == nil) == (writeValue == nil) and (readKey or writeKey) then
                local keys = {
                    readKey and keyOf(state, readKey) or "-",
                    readValue and keyOf(state, readValue) or "-",
                    writeKey and keyOf(state, writeKey) or "-",
                    writeValue and keyOf(state, writeValue) or "-",
                }
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "indexer",
                        readKey = readKey,
                        readValue = readValue,
                        writeKey = writeKey,
                        writeValue = writeValue,
                        sourceKind = "map",
                        key = composeKey("indexer", keys),
                    },
                    nil
                )
            end
        elseif kind == "shape" then
            local fields, keys = {}, {}
            for position, field in ipairs(node.fields or {}) do
                local read = field.read and import(field.read) or nil
                local write = field.write and import(field.write) or nil
                if not read and not write then
                    return nil
                end
                fields[position] = {name = field.name, read = read, write = write}
                keys[position] = composeKey("field", {
                    field.name,
                    read and keyOf(state, read) or "-",
                    write and keyOf(state, write) or "-"
                })
            end
            local reflected = node.index or {}
            local readKey = reflected.readKey and import(reflected.readKey) or nil
            local readValue = reflected.readValue and import(reflected.readValue) or nil
            local writeKey = reflected.writeKey and import(reflected.writeKey) or nil
            local writeValue = reflected.writeValue and import(reflected.writeValue) or nil
            local indexer
            if readKey or writeKey then
                local indexKeys = {
                    readKey and keyOf(state, readKey) or "-",
                    readValue and keyOf(state, readValue) or "-",
                    writeKey and keyOf(state, writeKey) or "-",
                    writeValue and keyOf(state, writeValue) or "-",
                }
                indexer = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "indexer",
                        readKey = readKey,
                        readValue = readValue,
                        writeKey = writeKey,
                        writeValue = writeValue,
                        key = composeKey("indexer", indexKeys),
                    },
                    nil
                )
            end
            made = make(
                state,
                opaque,
                "Type",
                {
                    kind = "shape",
                    fields = fields,
                    indexer = indexer,
                    key = composeKey("shape", withIndexer(keys, indexer and keyOf(state, indexer) or "-")),
                },
                nil
            )
        elseif kind == "tuple" or kind == "union" or kind == "intersection" then
            local members = list(node.members, kind)
            if members then
                local keys = {}
                for position, member in ipairs(members) do
                    keys[position] = keyOf(state, member)
                end
                made = make(state, opaque, "Type", {kind = kind, members = members, key = composeKey(kind, keys)}, nil)
            end
        elseif kind == "ptr" or kind == "const" or kind == "borrowed" or kind == "pinned" or kind == "affine" then
            local inner = import(node.element)
            if inner then
                local transferOnly = kind == "affine" and node.transferOnly == true
                local terminal = kind == "affine" and not transferOnly and node.cleanups and node.cleanups[
                    1
                ] and node.cleanups[1].key or nil
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = kind,
                        inner = inner,
                        transferOnly = transferOnly,
                        terminal = terminal,
                        key = kind == "affine" and composeKey(kind, {
                            keyOf(state, inner),
                            transferOnly and "transfer" or terminal or "-"
                        }) or composeKey(kind, {keyOf(state, inner)}),
                    },
                    nil
                )
            end
        elseif kind == "carray" then
            local element = import(node.element)
            if element then
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "carray",
                        element = element,
                        count = node.count,
                        key = composeKey("carray", {
                            keyOf(state, element),
                            tostring(node.count)
                        }),
                    },
                    nil
                )
            end
        elseif kind == "pack" then
            local headIndices, modes, names = {}, {}, {}
            for position, member in ipairs(node.head or {}) do
                headIndices[position] = member.type
                modes[position] = member.mode or "plain"
                names[position] = member.name or ""
            end
            local head = list(headIndices, "pack")
            local tail = node.tail and node.tail.type and import(node.tail.type) or nil
            if head then
                local keys = {}
                for position, member in ipairs(head) do
                    keys[position] = composeKey(modes[position], {keyOf(state, member), names[position]})
                end
                keys[#keys + 1] = tail and keyOf(state, tail) or "-"
                made = make(
                    state,
                    opaque,
                    "Pack",
                    {
                        kind = "pack",
                        head = head,
                        modes = modes,
                        names = names,
                        tail = tail,
                        key = composeKey("pack", keys),
                    },
                    nil
                )
            end
        elseif kind == "func" then
            local parameters = node.parameterPack and import(node.parameterPack)
            local results = node.returnPack and import(node.returnPack)
            if parameters and results then
                made = make(
                    state,
                    opaque,
                    "Type",
                    {
                        kind = "function",
                        parameters = parameters,
                        results = results,
                        key = composeKey("function", {
                            keyOf(state, parameters),
                            keyOf(state, results)
                        }),
                    },
                    nil
                )
            end
        end
        active[index] = nil
        built[index] = made

        return made
    end
    local root = import(descriptor.root)
    if not root then
        return nil, failure("NUPP2415", "type-function input uses a semantic kind the type provider cannot import")
    end

    return root, nil
end

----------------------------------------------------------------------------
-- Operators
----------------------------------------------------------------------------

function typeprovider.opaqueKind(state, value): string?
    local found = entry(state, value)
    if not found then
        return nil
    end

    return found.family == "Pack" and "typepack" or "type"
end

function typeprovider.operator(state, op, left, right): any, typeprovider.Failure?
    local found = entry(state, left)
    if not found or op ~= "==" and op ~= "~=" then
        return nil, failure("NUPP2411", "this operator is unavailable for type handles")
    end
    local other = entry(state, right)
    local equal = other ~= nil and found.family == other.family and found.payload.key == other.payload.key
    if op == "==" then
        return equal, nil
    end

    return not equal, nil
end

----------------------------------------------------------------------------
-- Finishing the graph
----------------------------------------------------------------------------

local function finalizeGraph(state, root)
    local indices, nodes, origins, references = {}, {}, {}, {}
    local failed

    local function intern(handle)
        local prior = indices[handle]
        if prior then
            return prior
        end
        if #nodes >= typeprovider.MAX_NODES then
            failed = failure("NUPP2416", "type blueprint exceeds the 10000-node limit")
            return 0
        end
        local found = entry(state, handle)
        if not found then
            failed = failure("NUPP2415", "type blueprint contains a foreign handle")
            return 0
        end
        local index = #nodes + 1
        indices[handle] = index
        local payload = found.payload
        local node = {kind = payload.kind}
        nodes[index], origins[index] = node, found.provenance
        if payload.kind == "primitive" then
            node.name = payload.name
        elseif payload.kind == "reference" then
            node.reference = #references + 1
            node.referenceId = payload.referenceId
            node.fingerprint = payload.fingerprint
            references[
                node.reference
            ] = {source = payload.source, referenceId = payload.referenceId, fingerprint = payload.fingerprint,}
        elseif payload.kind == "literal" then
            node.value = payload.value
            node.base = intern(payload.base)
        elseif payload.kind == "array" or payload.kind == "carray" then
            node.element = intern(payload.element)
            node.count = payload.count
        elseif payload.kind == "ptr"
            or payload.kind == "const"
            or payload.kind == "borrowed"
            or payload.kind == "pinned"
            or payload.kind == "affine"
        then
            node.inner = intern(payload.inner)
            if payload.kind == "affine" then
                node.transferOnly = payload.transferOnly == true
                node.terminal = payload.terminal
            end
        elseif payload.kind == "tuple" or payload.kind == "union" or payload.kind == "intersection" then
            node.members = {}
            for position, member in ipairs(payload.members or {}) do
                node.members[position] = intern(member)
            end
        elseif payload.kind == "indexer" then
            node.readKey = payload.readKey and intern(payload.readKey) or nil
            node.readValue = payload.readValue and intern(payload.readValue) or nil
            node.writeKey = payload.writeKey and intern(payload.writeKey) or nil
            node.writeValue = payload.writeValue and intern(payload.writeValue) or nil
        elseif payload.kind == "shape" then
            node.fields = {}
            for position, field in ipairs(payload.fields or {}) do
                node.fields[
                    position
                ] = {
                    name = field.name,
                    read = field.read and intern(field.read) or nil,
                    write = field.write and intern(field.write) or nil,
                }
            end
            node.indexer = payload.indexer and intern(payload.indexer) or nil
        elseif payload.kind == "function" then
            node.parameters = intern(payload.parameters)
            node.results = intern(payload.results)
        elseif payload.kind == "pack" then
            node.head, node.modes, node.names = {}, payload.modes, payload.names
            for position, member in ipairs(payload.head or {}) do
                node.head[position] = intern(member)
            end
            node.tail = payload.tail and intern(payload.tail) or nil
        else
            failed = failure("NUPP2415", "type blueprint uses unsupported kind " .. tostring(payload.kind))
        end

        return index
    end

    local rootIndex = intern(root)
    if failed then
        return nil, failed
    end
    local payload = {root = rootIndex, nodes = nodes}
    local fingerprint = hash.sha256("nupp.types\0v1\0" .. stable(payload))

    return {
        kind = "type-blueprint",
        provider = "types",
        schema = typeprovider.SCHEMA,
        family = entry(state, root).family,
        payload = payload,
        references = references,
        provenance = origins,
        fingerprint = fingerprint,
        summary = ("%d-node %s blueprint"):format(#nodes, entry(state, root).family:lower()),
    }, nil
end

function typeprovider.finalize(state, value): any, typeprovider.Failure?
    if not entry(state, value) then
        return nil, failure("NUPP2415", "the value is not a type handle")
    end
    return finalizeGraph(state, value)
end

export = typeprovider
