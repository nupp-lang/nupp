module nupp.compiler.hostpid

cdef function getpid(): int32
cdef function _getpid(): int32

local windows = package.config:sub(1, 1) == "\\"

local function processId(): int32
    return windows and _getpid() or getpid()
end

-- The VM supplies the same interface directly.
export function get(): number?
    local ok, pid = pcall(processId)

    return ok and pid or nil
end
