module nupp.compiler.backends

--[[
Static backend descriptors and generated backend selection.

A manifest names checked modules, never individual provider strings. A backend
module exports one constant declaration: a name, and the provider module that
answers each seam contract it selects. This reader takes that value after the
ordinary checker has typed it; it never executes the backend or requires the
third-party modules it names.
]]

local backends = {}

local registry = require("nupp.runtime.seam.registry")

--- The Lua value of a string literal node, or nil for anything else.
local function literalString(node: any): string?
    local token = node and node.kind == "string" and node.token or nil
    if not token then
        return nil
    end
    local chunk = loadstring("return " .. token.text)
    if not chunk then
        return nil
    end
    local ok, value = pcall(chunk)

    return ok and type(value) == "string" and value or nil
end

--- Reads `{["key"] = "value", ...}` as a constant map, or says why it is not one.
---
--- This is the whole of what reading a backend takes now. It used to be a
--- restricted-syntax matcher over calls -- const `require` bindings collected
--- into a local-name table, one `Backend.new`, positional constructor calls
--- resolved back to compiler-owned factory modules -- roughly a hundred and
--- fifty lines interpreting the shape of code the compiler then refused to run.
--- A declaration has a value, so the compiler reads the value.
local function constantMap(node: any, label: string): {[string]: string}?, string?
    if not node or node.kind ~= "tableExpr" then
        return nil, label .. " must be a table of constant entries"
    end
    local entries = {}
    for _, field in ipairs(node.fields or {}) do
        local key: string? = nil
        if field.kind == "fieldBracket" then
            key = literalString(field.key)
        elseif field.kind == "fieldNamed" and field.name then
            key = field.name.text
        end
        if not key then
            return nil, label .. " must name each entry with a constant string key"
        end
        if entries[key] ~= nil then
            return nil, label .. " names " .. key .. " more than once"
        end
        local value = literalString(field.value)
        if not value or value == "" then
            return nil, label .. " entry " .. key .. " must be a non-empty constant string"
        end
        entries[key] = value
    end

    return entries
end

local function fingerprint(descriptor: any): string
    local parts = {descriptor.name}
    for _, seam in ipairs(descriptor.seams) do
        parts[
            #parts + 1
        ] = table.concat(
            {seam.name, tostring(seam.version), seam.effect, seam.binding or "runtime", seam.runtimeModule},
            "\0"
        )
    end

    return table.concat(parts, "\0")
end

--- Builds the descriptor one already-read declaration resolves to.
---
--- Shared with `nupp.compiler.browser`, which has the browser backend's
--- declaration in hand rather than its source, so the host and a build agree on
--- what that backend is by construction instead of by two lists matching.
function backends.describe(name: string, seams: {[string]: string}, moduleName: string?): any?, string?
    if name == "" then
        return nil, "a backend must have a non-empty name"
    end
    local ordered = {}
    for contractName in pairs(seams) do
        if registry.find(contractName) == nil then
            return nil, "backend " .. name .. " selects unknown seam " .. contractName
        end
        ordered[#ordered + 1] = contractName
    end
    if #ordered == 0 then
        return nil, "backend " .. name .. " must select at least one seam"
    end
    -- A declaration is a map, so the order it is read in is not a fact about the
    -- backend. Sorting here is what keeps the fingerprint -- and the build cache
    -- key that carries it -- from moving when only the source order does.
    table.sort(ordered)

    local descriptor = {name = name, module = moduleName, seams = {},}
    for _, contractName in ipairs(ordered) do
        const contract = registry.get(contractName)
        descriptor.seams[
            #descriptor.seams + 1
        ] = {
            name = contract.name,
            version = contract.version,
            effect = contract.effect,
            effects = contract.effects,
            modules = contract.modules,
            implementationModules = contract.implementationModules,
            exports = contract.exports,
            binding = contract.binding,
            suiteModule = contract.suiteModule,
            runtimeModule = seams[contractName],
        }
    end
    descriptor.fingerprint = fingerprint(descriptor)
    descriptor.digest = require("nupp.compiler.hash").digest(descriptor.fingerprint)

    return descriptor
end

--- Reads a backend declaration. A non-backend module returns no problem.
---
--- The declaration is a value, not a call: the compiler reads what the module
--- exports rather than matching the shape of a constructor it will not execute.
function backends.inspect(root: any, moduleName: string?): any?, string?
    local exported = require("nupp.compiler.cst").exportAssignment(root)
    local value = exported and exported.value or nil
    if not value or value.kind ~= "tableExpr" then
        return nil
    end
    local name: string? = nil
    local seamField: any = nil
    for _, field in ipairs(value.fields or {}) do
        local key = field.kind == "fieldNamed" and field.name and field.name.text or nil
        if key == "name" then
            name = literalString(field.value)
        elseif key == "seams" then
            seamField = field.value
        end
    end
    -- Neither half present is an ordinary module that happens to export a table,
    -- not a malformed backend. One half is a backend somebody got wrong.
    if name == nil and seamField == nil then
        return nil
    end
    if name == nil or name == "" then
        return nil, "a backend declaration must give a non-empty constant name"
    end
    if seamField == nil then
        return nil, "backend " .. name .. " must declare its seams"
    end
    local seams, problem = constantMap(seamField, "backend " .. name .. " seams")
    if not seams then
        return nil, problem
    end

    return backends.describe(name, seams, moduleName)
end

--- Validates the manifest's ordered collection of backend module names.
function backends.validate(selected: any, label: string): boolean?, string?
    if selected == nil then
        return true
    end
    if type(selected) ~= "table" then
        return nil, label .. " must be an array of module names"
    end
    local seen = {}
    for index, moduleName in ipairs(selected) do
        if type(moduleName) ~= "string" or moduleName == "" then
            return nil, label .. "[" .. index .. "] must be a non-empty module name"
        end
        if seen[moduleName] then
            return nil, label .. " names backend module " .. moduleName .. " more than once"
        end
        seen[moduleName] = true
    end
    for key in pairs(selected) do
        if type(key) ~= "number" or key < 1 or key > #selected or key % 1 ~= 0 then
            return nil, label .. " must be an array of module names"
        end
    end

    return true
end

--- Resolves checked backend modules from their static interface metadata.
function backends.resolve(inc: any, selected: {string}?): any?, string?, any?
    local resolved = {modules = {}, seams = {}, byEffect = {},}
    local fingerprints = {}
    for _, moduleName in ipairs(selected or {}) do
        local path = inc.modulePath(moduleName)
        if not path then
            return nil, "backend module not found: " .. moduleName, {module = moduleName}
        end
        local checked = inc.checkFile(path)
        local descriptor = checked and checked.backend or nil
        local problem = checked and checked.backendProblem or nil
        if not descriptor then
            return nil, "backend module " .. moduleName .. ": " .. (
                problem or "must export one constant backend declaration"
            ), {module = moduleName, path = path}
        end
        descriptor.module = moduleName
        local fs: any = require("nupp.compiler." .. "fs")
        local source = fs.readFile(path)
        if source ~= nil then
            descriptor.digest = require("nupp.compiler.hash").digest(source)
        end
        resolved.modules[#resolved.modules + 1] = descriptor
        fingerprints[#fingerprints + 1] = moduleName .. "\0" .. descriptor.digest
        for _, seam in ipairs(descriptor.seams) do
            local prior = resolved.seams[seam.name]
            if prior then
                return nil, "backend seam conflict for "
                    .. seam.name
                    .. ": "
                    .. prior.module
                    .. " and "
                    .. moduleName, {
                    module = moduleName,
                    path = path,
                }
            end
            local selectedSeam = {
                name = seam.name,
                version = seam.version,
                effect = seam.effect,
                binding = seam.binding or "runtime",
                suiteModule = seam.suiteModule,
                modules = seam.modules,
                implementationModules = seam.implementationModules,
                exports = seam.exports,
                runtimeModule = seam.runtimeModule,
                backend = descriptor.name,
                module = moduleName,
            }
            resolved.seams[seam.name] = selectedSeam
            for _, effect in ipairs(seam.effects or {seam.effect}) do
                resolved.byEffect[effect] = moduleName
            end
        end
    end
    local storage = resolved.seams["representation.cstorage"]
    local structs = resolved.seams["representation.structvalue"]
    if storage and (not structs or storage.runtimeModule ~= structs.runtimeModule) then
        return nil, "representation.cstorage and representation.structvalue must select the same physical provider", {
            module = storage.module
        }
    end
    if storage and storage.runtimeModule == "nupp.runtime.provider.wasmstorage" then
        local wide = resolved.seams["numeric.int64"]
        if not wide or wide.runtimeModule ~= "nupp.runtime.provider.wasmint64" then
            return nil, "Wasm storage requires its exact numeric.int64 provider", {module = storage.module}
        end
    end
    resolved.fingerprint = table.concat(fingerprints, "\0")

    return resolved
end

--- Returns the exact reached seam records written into a generated artifact.
function backends.reached(effects: {[string]: any}?, resolved: any?): {any}
    local reached = {}
    local seen = {}
    for effect in pairs(effects or {}) do
        local moduleName = resolved and resolved.byEffect[effect] or nil
        if moduleName then
            for _, descriptor in ipairs(resolved.modules or {}) do
                if descriptor.module == moduleName then
                    for _, seam in ipairs(descriptor.seams or {}) do
                        local matches = false
                        for _, candidate in ipairs(seam.effects or {seam.effect}) do
                            matches = matches or candidate == effect
                        end
                        if matches and not seen[seam.name] then
                            seen[seam.name] = true
                            reached[
                                #reached + 1
                            ] = {
                                name = seam.name,
                                version = seam.version,
                                binding = seam.binding or "runtime",
                                backend = moduleName,
                                backendDigest = descriptor.digest or require(
                                    "nupp.compiler.hash"
                                ).digest(descriptor.fingerprint or ""),
                                runtimeModule = seam.runtimeModule,
                                runtimeDependency = seam.runtimeDependency,
                            }
                        end
                    end
                end
            end
        end
    end
    table.sort(reached, function(a, b)
        return a.name < b.name
    end)

    return reached
end

local function artifactField(value: any): string
    local escaped = tostring(value):gsub("%%", "%%25")
    escaped = escaped:gsub("|", "%%7C")
    escaped = escaped:gsub(";", "%%3B")

    return escaped
end

local function artifactValue(value: string): string
    local decoded = value:gsub("%%3[Bb]", ";")
    decoded = decoded:gsub("%%7[Cc]", "|")
    decoded = decoded:gsub("%%25", "%%")

    return decoded
end

--- Emits a data-only audit comment. It asserts resolution, never certification.
function backends.artifact(effects: {[string]: any}?, resolved: any?): string
    local parts = {}
    for _, seam in ipairs(backends.reached(effects, resolved)) do
        local owner = seam.runtimeDependency
        local fields = {
            seam.name,
            seam.version,
            seam.binding,
            seam.backend,
            seam.backendDigest,
            seam.runtimeModule,
            owner and owner.package or "",
            owner and owner.version or "",
        }
        for index, value in ipairs(fields) do
            fields[index] = artifactField(value)
        end
        parts[#parts + 1] = table.concat(fields, "|")
    end
    if #parts == 0 then
        return ""
    end

    return "--[[nupp-backends: resolved=" .. table.concat(parts, ";") .. "]]"
end

--- Runtime provider modules named by a generated artifact's resolution record.
---
--- Provider selection is data: the backend declaration gives `install` a module
--- name, so there is deliberately no literal `require` for the generated-module walk
--- to find. The artifact record is the exact build-time resolution and travels with
--- compiler-carried generated Lua, which makes it the authoritative second half of
--- that module's runtime closure.
function backends.artifactProviders(code: string): {string}
    local found: {[string]: boolean} = {}
    for resolved in code:gmatch("%-%-%[%[nupp%-backends: resolved=(.-)%]%]") do
        for entry in (resolved .. ";"):gmatch("(.-);") do
            local index = 0
            for value in (entry .. "|"):gmatch("(.-)|") do
                index = index + 1
                if index == 6 and value ~= "" then
                    found[artifactValue(value)] = true
                    break
                end
            end
        end
    end
    local providers = {}
    for name in pairs(found) do
        providers[#providers + 1] = name
    end
    table.sort(providers)

    return providers
end

--- The public module name a resolved seam has one module standing in for.
---
--- A seam may replace a complete public module with an exact provider module, and a
--- rule the compiler states about the public module is a rule about whichever module
--- supplies it. Answers the name it was given wherever nothing replaces one.
function backends.publicModule(resolved: any?, moduleName: string?): string?
    if moduleName == nil then
        return nil
    end
    for _, seam in pairs(resolved and resolved.seams or {}) do
        if seam.runtimeModule == moduleName then
            for target, member in pairs(seam.modules or {}) do
                if member == "" then
                    return target
                end
            end
        end
    end

    return moduleName
end

--- Removes native features replaced by selected backend seams.
function backends.withoutNative(effects: {[string]: boolean}, resolved: any?): {[string]: boolean}
    for effect in pairs(resolved and resolved.byEffect or {}) do
        effects[effect] = nil
    end

    return effects
end

--- Emits only installation of selected backend modules reached by this output.
function backends.bootstrap(effects: {[string]: any}?, resolved: any?): string
    local selected, seen = {}, {}
    for effect in pairs(effects or {}) do
        local moduleName = resolved and resolved.byEffect[effect] or nil
        if moduleName and not seen[moduleName] then
            selected[#selected + 1] = moduleName
            seen[moduleName] = true
        end
    end
    table.sort(selected)
    local out = {}
    for _, moduleName in ipairs(selected) do
        -- A backend is data, so installing one is the runtime module's business
        -- rather than a method the declaration carries.
        out[#out + 1] = ("require(\"nupp.runtime.backend\").install(require(%q));"):format(moduleName)
    end

    return table.concat(out)
end

export = backends
