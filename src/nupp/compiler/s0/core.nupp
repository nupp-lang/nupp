module nupp.compiler.s0.core

local ir = require("nupp.compiler.s0.ir")
local reader = require("nupp.compiler.s0.reader")
local allocate = require("nupp.compiler.s0.allocate")
local selector = require("nupp.compiler.s0.select")
local arm = require("nupp.compiler.s0.arm64")
local bound = require("nupp.compiler.s0.corebound")
local core = {}

function core.bundle(corpus: string, metadata: string, directory: string, digest: string): string
    local input = assert(io.open(corpus, "rb"))
    local functions = reader.read(assert(input:read("*a")));
    input:close()
    local names: {[string]: integer} = {}
    local offsets: {[string]: integer} = {}
    local codes: {selector.Code} = {}
    local frames: {integer} = {}
    for index, f in ipairs(functions) do
        names[f.name] = index
        codes[index] = selector.run(f, allocate.run(f, selector.target()))
        frames[index] = codes[index].frameBytes
    end
    local exported: {integer} = {}
    local exports: {string} = {}
    local bodies: {string} = {}
    local handlers: {integer} = {}
    for op = 1, 256 do
        handlers[op] = 0
    end
    local file = assert(io.open(metadata, "rb"))
    for line in file:lines() do
        local name, body, arity, results = line:match("^export\t([%w_]+)\t([%w_@]+)\t(%d+)\t(%d+)$")
        if name then
            exports[#exports + 1], bodies[#bodies + 1] = name, assert(body)
            if body:sub(1, 1) ~= "@" then
                local index = assert(names[body], "S0 core: export body " .. body)
                exported[#exported + 1] = index
                local f = functions[index]
                assert(
                    #f.signature.params == tonumber(arity) and #f.signature.results == tonumber(results),
                    "S0 core: export signature " .. name
                )
                for _, kind in ipairs(f.signature.params) do
                    assert(kind == ir.I64, "S0 core: word export arguments")
                end
                for _, kind in ipairs(f.signature.results) do
                    assert(kind == ir.I64, "S0 core: word export result")
                end
            end
        else
            local handler, opcode = line:match("^opcode\t([%w_]+)\t(%d+)$")
            assert(handler and opcode, "S0 core: malformed metadata")
            local op = assert(tonumber(opcode)) as integer
            assert(op >= 0 and op < 256, "S0 core: opcode range")
            handlers[op + 1] = names[handler] or 0
            if handlers[op + 1] ~= 0 then
                local signature = functions[handlers[op + 1]].signature
                assert(
                    #signature.params == 6 and #signature.results == 1 and signature.results[1] == ir.I64,
                    "S0 core: dispatch signature"
                )
                for _, kind in ipairs(signature.params) do
                    assert(kind == ir.I64, "S0 core: dispatch arguments")
                end
            end
        end
    end
    file:close()
    assert(#exports == 105, "S0 core: export inventory")
    for at = 2, #exports do
        assert(exports[at - 1] < exports[at], "S0 core: export order")
    end
    local arena = bound.extent(functions, frames, handlers, exported)
    local words: {integer} = {}
    local imports: {string} = {}
    local imported: {[string]: integer} = {}
    local fixAt: {integer} = {}
    local fixName: {string} = {}
    local fixKind: {integer} = {}
    local fixReg: {integer} = {}
    local fixAdd: {integer} = {}

    local function emit(word: integer): nil
        words[#words + 1] = word
    end

    local function label(name: string): nil
        assert(not offsets[name]);
        offsets[name] = #words + 1
    end

    local function fix(name: string, kind: integer, reg: integer, add: integer): nil
        fixAt[#fixAt + 1], fixName[#fixName + 1], fixKind[#fixKind + 1] = #words + 1, name, kind
        fixReg[#fixReg + 1], fixAdd[#fixAdd + 1] = reg, add;
        emit(0)
    end

    local function constant(reg: integer, value: integer): nil
        emit(arm.movz(64, reg, value & 65535, 0))
        if value >> 16 ~= 0 then
            emit(arm.movk(64, reg, (value >> 16) & 65535, 1))
        end
    end

    local function host(name: string): nil
        if not imported[name] then
            imports[#imports + 1] = name;
            imported[name] = #imports
        end
        emit(arm.ldr(8, 16, 22, (assert(imported[name]) - 1) * 8));
        emit(arm.blr(16))
    end

    local function preserve(load: boolean): nil
        local integerPair = load and arm.ldp or arm.stp
        local floatPair = load and arm.ldp_fp or arm.stp_fp
        for reg = 19, 29, 2 do
            emit(integerPair(64, reg, reg + 1, 31, (reg - 19) * 8, 0))
        end
        for reg = 8, 14, 2 do
            emit(floatPair(64, reg, reg + 1, 31, 96 + (reg - 8) * 8, 0))
        end
    end

    -- The loader calls setup once, before publication to any runtime consumer.
    label("@setup")
    emit(arm.ldr(8, 16, 0, 0));
    emit(arm.cmp_imm(64, 16, 1, 0));
    fix("@trap", 4, 1, 0)
    emit(arm.ldr(8, 16, 0, 72));
    emit(arm.cmp_imm(64, 16, 105, 0));
    fix("@trap", 4, 1, 0)
    for index, name in ipairs(exports) do
        fix(name, 3, 16, 0);
        emit(arm.str(8, 16, 1, (index - 1) * 8))
    end
    emit(arm.ret(30))
    for index, name in ipairs(exports) do
        label(name);
        fix(bodies[index], 3, 16, 0);
        fix("@enter", 1, 0, 0)
    end
    label("@enter")
    emit(arm.sub_imm(64, 31, 31, 256, 0));
    preserve(false)
    for reg = 0, 6, 2 do
        emit(arm.stp(64, reg, reg + 1, 31, 160 + reg * 8, 0))
    end
    emit(arm.str(8, 16, 31, 224));
    fix("@imports", 3, 22, 0)
    fix("@acquire", 2, 0, 0)
    emit(arm.str(8, 0, 31, 232));
    emit(arm.mov_reg(64, 23, 1));
    emit(arm.add_imm(64, 21, 0, 3, 1))
    for reg = 0, 6, 2 do
        emit(arm.ldp(64, reg, reg + 1, 31, 160 + reg * 8, 0))
    end
    emit(arm.ldr(8, 16, 31, 224));
    emit(arm.blr(16))
    emit(arm.ldr(8, 16, 31, 232));
    emit(arm.ldr(8, 17, 16, 0));
    emit(arm.sub_imm(64, 17, 17, 1, 0));
    emit(arm.str(8, 17, 16, 0))
    preserve(true);
    emit(arm.add_imm(64, 31, 31, 256, 0));
    emit(arm.ret(30))
    -- All mappings and the cache belong to Nupp. Host calls below cannot reenter.
    label("@acquire")
    emit(arm.mov_reg(64, 28, 30));
    host("nupp_raw_thread_slot");
    emit(arm.mov_reg(64, 27, 0))
    emit(arm.ldr(8, 24, 27, 0));
    fix("@cached", 6, 24, 0)
    constant(0, 16384);
    host("nupp_os_map_pages");
    fix("@trap", 5, 0, 0)
    emit(arm.mov_reg(64, 24, 0))
    fix("@dispatchOffsets", 3, 9, 0);
    fix("@setup", 3, 10, 0);
    fix("@leave", 3, 11, 0)
    emit(arm.add_imm(64, 12, 24, 3, 1));
    emit(arm.add_imm(64, 13, 12, 2048, 0));
    constant(14, 256)
    label("@tables")
    emit(arm.ldr(4, 15, 9, 0));
    emit(arm.add_reg(64, 15, 10, 15, 0));
    emit(arm.str(8, 15, 12, 0));
    emit(arm.str(8, 11, 13, 0))
    emit(arm.add_imm(64, 9, 9, 4, 0));
    emit(arm.add_imm(64, 12, 12, 8, 0));
    emit(arm.add_imm(64, 13, 13, 8, 0))
    emit(arm.sub_imm(64, 14, 14, 1, 0));
    fix("@tables", 6, 14, 0)
    emit(arm.str(8, 24, 27, 0));
    fix("@finalize", 3, 0, 0);
    host("nupp_raw_thread_finalizer")
    label("@cached")
    emit(arm.ldr(8, 25, 24, 0));
    emit(arm.cmp_imm(64, 25, 1024, 0));
    fix("@trap", 4, 2, 0)
    emit(arm.add_reg(64, 26, 24, 25, 3));
    emit(arm.add_imm(64, 26, 26, 16, 0));
    emit(arm.ldr(8, 1, 26, 0));
    fix("@segment", 6, 1, 0)
    constant(0, arena);
    host("nupp_os_map_pages");
    fix("@trap", 5, 0, 0);
    emit(arm.str(8, 0, 26, 0));
    emit(arm.mov_reg(64, 1, 0))
    label("@segment")
    emit(arm.add_imm(64, 25, 25, 1, 0));
    emit(arm.str(8, 25, 24, 0));
    emit(arm.mov_reg(64, 0, 24));
    emit(arm.mov_reg(64, 30, 28));
    emit(arm.ret(30))
    -- Thread teardown invokes this directly, without consulting TLS again.
    label("@finalize")
    emit(arm.sub_imm(64, 31, 31, 48, 0));
    emit(arm.stp(64, 22, 24, 31, 0, 0));
    emit(arm.stp(64, 25, 26, 31, 16, 0));
    emit(arm.stp(64, 27, 30, 31, 32, 0))
    fix("@imports", 3, 22, 0);
    emit(arm.mov_reg(64, 24, 0));
    fix("@finalized", 5, 24, 0)
    emit(arm.add_imm(64, 25, 24, 16, 0));
    emit(arm.add_imm(64, 26, 25, 2, 1))
    label("@unmap")
    emit(arm.ldr(8, 0, 25, 0));
    fix("@nextSegment", 5, 0, 0);
    constant(1, arena);
    host("nupp_os_unmap_pages")
    label("@nextSegment")
    emit(arm.add_imm(64, 25, 25, 8, 0));
    emit(arm.cmp_reg(64, 25, 26));
    fix("@unmap", 4, 1, 0)
    emit(arm.mov_reg(64, 0, 24));
    constant(1, 16384);
    host("nupp_os_unmap_pages")
    label("@finalized")
    emit(arm.ldp(64, 22, 24, 31, 0, 0));
    emit(arm.ldp(64, 25, 26, 31, 16, 0));
    emit(arm.ldp(64, 27, 30, 31, 32, 0));
    emit(arm.add_imm(64, 31, 31, 48, 0));
    emit(arm.ret(30))
    label("@trap");
    emit(arm.brk(0x530))
    label("@leave");
    emit(arm.ret(30))
    for _, name in ipairs({"@entry", "@step"}) do
        label(name)
        if name == "@entry" then
            emit(arm.sub_imm(64, 16, 1, 32, 0));
            emit(arm.cmp_reg(64, 16, 5));
            fix("@leave", 4, 1, 0)
        end
        emit(arm.mov_reg(64, 19, 4));
        emit(arm.mov_reg(64, 20, 5))
        emit(arm.ldr(1, 16, 0, 0));
        emit(arm.add_reg(64, 16, 21, 16, 3));
        emit(arm.ldr(8, 16, 16, 0))
        if name == "@step" then
            emit(arm.add_imm(64, 5, 21, 2048, 0))
        else
            emit(arm.mov_reg(64, 5, 21))
        end
        emit(arm.br(16))
    end
    label("@resume")
    emit(arm.mov_reg(64, 19, 0));
    emit(arm.ldr(8, 20, 0, 16));
    emit(arm.ldr(8, 16, 0, 32));
    emit(arm.add_reg(64, 20, 20, 16, 3))
    emit(arm.mov_reg(64, 1, 0));
    constant(0, 0);
    emit(arm.mov_reg(64, 2, 21));
    fix("resumeSlow", 1, 0, 0)
    for index, code in ipairs(codes) do
        label(functions[index].name)
        for _, word in ipairs(code.words) do
            emit(word)
        end
        for fixup, word in ipairs(code.fixupWord) do
            local at = assert(offsets[functions[index].name]) + word - 1
            local name = code.fixupName[fixup]
            if code.fixupKind[fixup] == selector.IMPORT_LOAD then
                assert(not names[name], "S0 core: internal host import")
                if not imported[name] then
                    imports[#imports + 1] = name;
                    imported[name] = #imports
                end
                words[at] = arm.ldr(8, 16, 22, (assert(imported[name]) - 1) * 8)
            else
                fixAt[#fixAt + 1], fixName[#fixName + 1], fixKind[#fixKind + 1] = at, name, code.fixupKind[fixup]
                fixReg[#fixReg + 1], fixAdd[#fixAdd + 1] = 0, code.fixupAddend[fixup]
            end
        end
    end
    label("@dispatchOffsets")
    for _, handler in ipairs(handlers) do
        emit((assert(offsets[handler == 0 and "@leave" or functions[handler].name]) - 1) * 4)
    end
    if #words % 2 ~= 0 then
        emit(0)
    end
    label("@imports")
    local importOffset = #words * 4
    for _ = 1, #imports * 2 do
        emit(0)
    end
    for index, at in ipairs(fixAt) do
        local delta = (
            assert(offsets[fixName[index]], "S0 core: unresolved " .. fixName[index]) - at
        ) * 4 + fixAdd[index]
        local kind, reg = fixKind[index], fixReg[index]
        words[at] = switch kind do
            case 1 -> arm.b(delta)
            case 2 -> arm.bl(delta)
            case 3 -> arm.adr(reg, delta)
            case 4 -> arm.b_cond(reg, delta)
            case 5 -> arm.cbz(64, reg, delta)
            else -> arm.cbnz(64, reg, delta)
        end
    end
    local bytes: {string} = {}
    for _, word in ipairs(words) do
        bytes[#bytes + 1] = string.char(word & 255, (word >> 8) & 255, (word >> 16) & 255, (word >> 24) & 255)
    end
    local code = assert(io.open(directory .. "/code.bin", "wb"));
    code:write(table.concat(bytes));
    code:close()
    local data = assert(io.open(directory .. "/data.bin", "wb"));
    data:close()
    local quoted: {string} = {}
    for _, name in ipairs(imports) do
        assert(name:match("^[%w_]+$"));
        quoted[#quoted + 1] = '"' .. name .. '"'
    end
    assert(digest:match("^[%da-f]+$") and #digest == 64)
    local manifest = assert(io.open(directory .. "/bundle.json", "wb"))
    manifest:write(
        (
            '{"version":2,"architecture":"aarch64","layoutDigest":"%s","entry":0,'
            .. '"code":"code.bin","data":"data.bin","imports":[%s],"outputWords":105,"importOffset":%d}\n'
        ):format(digest, table.concat(quoted, ","), importOffset)
    );
    manifest:close()

    return (
        "%d functions; %d words; %d arena bytes; 1024 nested entries; 105 exports"
    ):format(#functions, #words, arena)
end

export = core
