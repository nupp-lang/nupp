module nupp.compiler.s0.select

local ir = require("nupp.compiler.s0.ir")
local allocate = require("nupp.compiler.s0.allocate")
local arm = require("nupp.compiler.s0.arm64")
local target = require("nupp.compiler.s0.arm64target")
local selector = {}

const BORROW_ICMP: 20 = ir.OP_ICMP as 20
const BORROW_FCMP: 21 = ir.OP_FCMP as 21
const BORROW_SELECT: 22 = ir.OP_SELECT as 22
const BORROW_LOAD: 23 = ir.OP_LOAD as 23
const BORROW_SLOAD: 24 = ir.OP_SLOAD as 24
const BORROW_STACK_ADDR: 46 = ir.OP_STACK_ADDR as 46
local integerConditions = {0, 1, 11, 13, 12, 10, 3, 9, 8, 2}
-- Flags (NZCV) under which each condition code (EQ 0 through LE 13) holds:
-- what a conditional compare sets when it does not compare.
local holdingFlags = {[0] = 4, 0, 2, 0, 8, 0, 1, 0, 2, 0, 0, 8, 0, 4}
local floatConditions: {
    [integer]: integer
} = {[1] = 0, [2] = 1, [11] = 7, [12] = 6, [13] = 4, [14] = 9, [15] = 12, [16] = 10, [19] = 6}
local SIGNED_LT, SIGNED_GE = ir.condition("slt"), ir.condition("sge")
local UNORDERED_EQ, ORDERED_NE, LESS_GREATER = ir.condition("ueq"), ir.condition("one"), ir.condition("ltgt")

selector.B26, selector.BL26, selector.IMPORT_LOAD = 1, 2, 3
-- A foreign symbol's table word: the linker adds the slot to the scaled offset.
selector.FOREIGN_CELL = 4
-- An import naming a foreign symbol to resolve, which the sink spells as
-- "foreign", the table, dlopen and dlsym slots, the library and the symbol.
const FOREIGN_PREFIX: string = "foreign\0"
-- dlopen's RTLD_NOW, the same on macOS and Linux.
const LOAD_NOW: integer = 2
-- The trap a call of a foreign symbol that did not resolve takes.
const MISSING_SYMBOL: integer = 0xf0
const PROCESS_LIBRARY: string = "library\0"
const LOADER_ERROR: string = "symbol\0\0dlerror"
-- shortcut: anchored kernel paths fit the OS's 4 KiB path extent; use dynamic
-- storage if a supported loader accepts longer complete paths.
const ARTIFACT_PATH_BYTES: integer = 4096
-- The routines the sink names rather than imports (nativeos): the generic
-- foreign call, and the address of the bridge's symbol table, whose import
-- slot follows the prefix.
const ROUTINE_CALL: string = "routine\0call"
const ROUTINE_CELLS: string = "routine\0cells\0"
const ROUTINE_ATOMIC_LOAD: string = "routine\0atomicload"
const ROUTINE_ATOMIC_CAS: string = "routine\0atomiccas"
const ROUTINE_COLLECTOR: string = "routine\0collector"
-- The generic foreign call's scalar fast path: the function, then the
-- arguments, which all go in registers, as a call's own operands.
const ROUTINE_REGISTERS: string = "routine\0call\0registers"
-- The static kernel foreign call's block of words (nativeos.foreignBlock):
-- the function, then x0-x7, d0-d7, the first words of the C stack and the
-- address x8 passes for a result returned in memory. The call answers x0 and
-- leaves the registers a result comes back in at their words: x0 and x1,
-- for a composite of up to 16 bytes, and d0-d3, for one of floats.
const CALL_FUNCTION: integer = 0
const CALL_INTEGERS: integer = 1
const CALL_FLOATS: integer = 9
const CALL_STACK: integer = 17
const CALL_STACK_WORDS: integer = 16
const CALL_REGISTERS: integer = 8
const CALL_RESULT_ADDRESS: integer = CALL_STACK + CALL_STACK_WORDS
const CALL_RESULT_INTEGERS: integer = 2
const CALL_RESULT_FLOATS: integer = 4
-- AAPCS64 indirect result location register.
const INDIRECT_RESULT: integer = 8
-- The byte offsets of the collector's record's words (hostcalls.collector):
-- where it keeps what it is shown, how many it has kept, how many fit, and
-- the words each takes; and what it answers a C visitor's caller, to go on or to stop.
const COLLECT_BASE_AT: integer = 0
const COLLECT_COUNT_AT: integer = 8
const COLLECT_LIMIT_AT: integer = 16
const COLLECT_WORDS_AT: integer = 24
const VISIT_CONTINUE: integer = 1
const VISIT_BREAK: integer = 0
-- ARM64's unsigned higher-or-same condition and the zero register.
const HIGHER_SAME: integer = 2
const ZERO: integer = 31
const LINK: integer = 30
-- Below the stack words, the block's address is kept across the call.
const CALL_SAVED: integer = 16

record selector.Code
    words: {integer}
    fixupWord: {integer}
    fixupKind: {integer}
    fixupName: {string}
    fixupAddend: {integer}
    blockWord: {integer}
    frameBytes: integer
    stackOffsets: {integer}
    opWords: {integer}
    opCounts: {integer}
end

function selector.target(): allocate.Target
    local internal: {boolean} = {}
    local c: {boolean} = {}
    for p = 1, 96 do
        internal[p], c[p] = false, false
    end
    for _, p in ipairs(target.cIntegerPreserved) do
        c[p] = true
    end
    for _, p in ipairs(target.cFloatPreserved) do
        c[p] = true
    end

    return allocate.Target(
        integerRegisters = target.integerRegisters,
        floatRegisters = target.floatRegisters,
        preservedInternal = internal,
        preservedC = c,
        scratchInt = 17,
        scratchFloat = 96,
        saveAcrossCalls = true,
        integerArguments = target.cIntegerArguments,
        floatArguments = target.cFloatArguments
    )
end

local function bits(kind: integer): integer
    return kind == ir.I8 and 8 or kind == ir.I16 and 16 or (kind == ir.I32 or kind == ir.F32) and 32 or 64
end

local function machine(kind: integer): integer
    return bits(kind) <= 32 and 32 or 64
end

local function align(value: integer, boundary: integer): integer
    assert(boundary > 0 and (boundary & (boundary - 1)) == 0, "S0 select: invalid alignment")
    return (value + boundary - 1) & -boundary
end

-- Return raw logical-immediate fields; the encoder validates their shape.
local function logical(value: integer, width: integer): (integer, integer, integer)
    local mask = width == 64 and -1 or 0xffffffff
    value = value & mask
    if value == 0 or value == mask then
        return -1, 0, 0
    end
    for length = 1, width == 64 and 6 or 5 do
        local size = 1 << length
        local elementMask = size == 64 and -1 or (1 << size) - 1
        local element = value & elementMask
        local repeated = element
        local shift = size
        while shift < width do
            repeated = repeated | (element << shift)
            shift = shift + size
        end
        if repeated == value then
            for rotation = 0, size - 1 do
                local rotated = rotation == 0 and element
                    or ((element >> rotation) | (element << (size - rotation))) & elementMask
                if rotated ~= 0 and rotated ~= elementMask and (rotated & (rotated + 1)) == 0 then
                    local ones = 0
                    while rotated ~= 0 do
                        rotated, ones = rotated >> 1, ones + 1
                    end
                    local n = size == 64 and 1 or 0
                    local imms = ((~(size - 1) << 1) | (ones - 1)) & 63
                    return n, (size - rotation) % size, imms
                end
            end
        end
    end

    return -1, 0, 0
end

local function stackBorrowed(f: ir.Function): {boolean}
    local borrowed: {boolean} = {}
    if #f.stackBytes == 0 then
        return borrowed
    end
    for v = 1, #f.valueKinds do
        borrowed[v] = false
    end
    local changed = true
    while changed do
        changed = false
        for at, opid in ipairs(f.op) do
            local value, op = f.result[at], opid
            if value ~= 0 and not borrowed[value] then
                local derives = op == BORROW_STACK_ADDR
                if op ~= BORROW_LOAD and op ~= BORROW_SLOAD and op ~= BORROW_ICMP and op ~= BORROW_FCMP then
                    for p = f.firstArg[at], f.firstArg[at] + f.nargs[at] - 1 do
                        if (op ~= BORROW_SELECT or p ~= f.firstArg[at]) and borrowed[f.args[p]] then
                            derives = true
                        end
                    end
                end
                if derives then
                    borrowed[value], changed = true, true
                end
            end
            local second = f.result2[at]
            if second ~= 0 and borrowed[value] and not borrowed[second] then
                borrowed[second], changed = true, true
            end
        end
        for edge, block in ipairs(f.edgeTarget) do
            for p = 0, f.edgeNargs[edge] - 1 do
                local value, parameter = f.edgeArgs[f.edgeFirstArg[edge] + p], f.params[f.firstParam[block] + p]
                if borrowed[value] and not borrowed[parameter] then
                    borrowed[parameter], changed = true, true
                end
            end
        end
    end

    return borrowed
end

const ICONST: 1 = ir.OP_ICONST as 1
const FCONST: 2 = ir.OP_FCONST as 2
const IADD: 3 = ir.OP_IADD as 3
const ISUB: 4 = ir.OP_ISUB as 4
const IMUL: 5 = ir.OP_IMUL as 5
const UDIV: 6 = ir.OP_UDIV as 6
const SDIV: 7 = ir.OP_SDIV as 7
const UREM: 8 = ir.OP_UREM as 8
const SREM: 9 = ir.OP_SREM as 9
const UMULHI: 10 = ir.OP_UMULHI as 10
const SMULHI: 11 = ir.OP_SMULHI as 11
const BAND: 12 = ir.OP_BAND as 12
const BOR: 13 = ir.OP_BOR as 13
const BXOR: 14 = ir.OP_BXOR as 14
const BNOT: 15 = ir.OP_BNOT as 15
const ISHL: 16 = ir.OP_ISHL as 16
const USHR: 17 = ir.OP_USHR as 17
const SSHR: 18 = ir.OP_SSHR as 18
const POPCNT: 19 = ir.OP_POPCNT as 19
const ICMP: 20 = ir.OP_ICMP as 20
const FCMP: 21 = ir.OP_FCMP as 21
const SELECT: 22 = ir.OP_SELECT as 22
const LOAD: 23 = ir.OP_LOAD as 23
const SLOAD: 24 = ir.OP_SLOAD as 24
const STORE: 25 = ir.OP_STORE as 25
const IREDUCE: 26 = ir.OP_IREDUCE as 26
const UEXTEND: 27 = ir.OP_UEXTEND as 27
const SEXTEND: 28 = ir.OP_SEXTEND as 28
const BITCAST: 29 = ir.OP_BITCAST as 29
const FPROMOTE: 30 = ir.OP_FPROMOTE as 30
const FDEMOTE: 31 = ir.OP_FDEMOTE as 31
const FADD: 32 = ir.OP_FADD as 32
const FSUB: 33 = ir.OP_FSUB as 33
const FMUL: 34 = ir.OP_FMUL as 34
const FDIV: 35 = ir.OP_FDIV as 35
const FNEG: 36 = ir.OP_FNEG as 36
const FABS: 37 = ir.OP_FABS as 37
const SQRT: 38 = ir.OP_SQRT as 38
const FLOOR: 39 = ir.OP_FLOOR as 39
const CEIL: 40 = ir.OP_CEIL as 40
const FMA: 41 = ir.OP_FMA as 41
const FCVT_FROM_SINT: 42 = ir.OP_FCVT_FROM_SINT as 42
const FCVT_FROM_UINT: 43 = ir.OP_FCVT_FROM_UINT as 43
const FCVT_TO_SINT_SAT: 44 = ir.OP_FCVT_TO_SINT_SAT as 44
const FCVT_TO_UINT_SAT: 45 = ir.OP_FCVT_TO_UINT_SAT as 45
const STACK_ADDR: 46 = ir.OP_STACK_ADDR as 46
const CALL: 47 = ir.OP_CALL as 47
const CALL_INDIRECT: 48 = ir.OP_CALL_INDIRECT as 48
const RETURN_CALL: 49 = ir.OP_RETURN_CALL as 49
const RETURN_CALL_INDIRECT: 50 = ir.OP_RETURN_CALL_INDIRECT as 50
const JUMP: 51 = ir.OP_JUMP as 51
const BRIF: 52 = ir.OP_BRIF as 52
const RETURN: 53 = ir.OP_RETURN as 53
const TRAP: 54 = ir.OP_TRAP as 54

-- Selection's helpers, in one table: every local of the module is a slot of
-- its chunk's frame on the core, which holds fewer than 250.
local helpers = {}

-- Whether the instructions between `producer` and `consumer` leave the
-- producer's operands where they are: each selects as nothing, or computes a
-- value without an effect into a register none of the operands is in.
function helpers.transparent(
    f: ir.Function,
    location: {integer},
    dead: {[integer]: boolean},
    omitted: {[integer]: boolean},
    producer: integer,
    consumer: integer
): boolean
    for at = producer + 1, consumer - 1 do
        local op, result = f.op[at], f.result[at]
        local quiet = dead[at] or omitted[at] and op == ICONST
        if not quiet then
            local pure = op <= IMUL or op >= UMULHI and op <= SELECT or op >= IREDUCE and op <= STACK_ADDR
            if not (pure or op == LOAD or op == SLOAD)
                or result == 0
                or f.result2[at] ~= 0
                or location[result] <= 0
            then
                return false
            end
            -- A literal folded into the producer is in no register.
            for p = f.firstArg[producer], f.firstArg[producer] + f.nargs[producer] - 1 do
                local operand = f.args[p]
                local definition = f.definitions[operand]
                local folded = definition > 0 and omitted[definition] == true and f.op[definition] == ICONST
                if not folded and location[operand] == location[result] then
                    return false
                end
            end
        end
    end

    return true
end

-- What selection decides before it emits anything: each value's uses, the
-- operations it drops, the literals it folds into an instruction and the
-- instruction pairs it fuses (recipes).
local function prepare(
    f: ir.Function,
    used: {boolean},
    location: {integer},
    reached: {[integer]: boolean}
): ({integer}, {[integer]: integer}, {[integer]: integer}, {[integer]: boolean}, {[integer]: {integer}})
    local colArgs = f.args
    local colAux = f.aux
    local colDefinitions = f.definitions
    local colFirstArg = f.firstArg
    local colImm = f.imm
    local colKind = f.kind
    local colOp = f.op
    local colValueKinds = f.valueKinds
    -- Edge arguments count as uses too: a branch may both test a boolean and
    -- carry it into a successor. Only its sole adjacent test can use flags.
    local uses: {integer} = {}
    for value = 1, #colValueKinds do
        uses[value] = 0
    end
    -- Only what a branch reaches uses anything (helpers.emittedBlocks).
    local reaching: {boolean} = {}
    for block, start in ipairs(f.blockStart) do
        for at = start, f.blockEnd[block] do
            reaching[at] = reached[block] == true
        end
    end
    for at = 1, #colOp do
        for p = colFirstArg[at], reaching[at] and colFirstArg[at] + f.nargs[at] - 1 or colFirstArg[at] - 1 do
            uses[colArgs[p]] = uses[colArgs[p]] + 1
        end
    end
    -- An edge no instruction names (a threaded jump's, allocate.simplify) is
    -- never taken.
    for at = 1, #colOp do
        for e = f.firstEdge[at], reaching[at] and f.firstEdge[at] + f.nedges[at] - 1 or f.firstEdge[at] - 1 do
            local parameters = f.firstParam[f.edgeTarget[e]]
            for p = 0, f.edgeNargs[e] - 1 do
                if used[f.params[parameters + p]] ~= false then
                    local value = f.edgeArgs[f.edgeFirstArg[e] + p]
                    uses[value] = uses[value] + 1
                end
            end
        end
    end
    -- Operations without effects whose results nothing reads, which
    -- simplification leaves behind (allocate.simplify), are not selected.
    -- Uses of their operands do not count.
    local dead: {[integer]: boolean} = {}
    local changed = true
    while changed do
        changed = false
        for at = #colOp, 1, -1 do
            local op, result = colOp[at], f.result[at]
            local pure = op <= IMUL or op >= UMULHI and op <= SELECT or op >= IREDUCE and op <= STACK_ADDR
            if pure and not dead[at] and result ~= 0 and f.result2[at] == 0 and uses[result] == 0 then
                dead[at], changed = true, true
                for p = colFirstArg[at], colFirstArg[at] + f.nargs[at] - 1 do
                    uses[colArgs[p]] = uses[colArgs[p]] - 1
                end
            end
        end
    end
    -- Decide folds before emission so a sole-use literal has no machine result.
    local immediates: {[integer]: integer} = {}
    local immediateArgs: {[integer]: integer} = {}
    local omitted: {[integer]: boolean} = {}
    -- How many of each literal's uses take it as an immediate: one that
    -- every use does is not made at all.
    local folded: {[integer]: integer} = {}
    for at, opid in ipairs(colOp) do
        local op = (dead[at] or f.nargs[at] ~= 2) and 0 or opid
        local shift = op == ISHL or op == USHR or op == SSHR
        local arithmetic = op == IADD or op == ISUB
        local bitwise = op == BAND or op == BOR or op == BXOR
        if bitwise or op == IMUL then
            -- A mask the logical immediates encode, or a multiplier that is
            -- a power of two, which becomes a shift; either operand may be it.
            local width = machine(colKind[at])
            for position = 2, 1, -1 do
                local value = colArgs[colFirstArg[at] + position - 1]
                local definition = colDefinitions[value]
                if immediates[at] == nil
                    and definition > 0
                    and colOp[definition] == ICONST
                    and bits(colValueKinds[value]) >= 32
                then
                    local literal = colImm[definition] & (width == 64 and -1 or 0xffffffff)
                    local amount: integer = -1
                    if bitwise and logical(literal, width) >= 0 then
                        amount = literal
                    elseif op == IMUL and literal > 1 and (literal & (literal - 1)) == 0 then
                        amount = 0
                        while (1 << amount) ~= literal do
                            amount = amount + 1
                        end
                    end
                    if amount >= 0 then
                        immediates[at], immediateArgs[at] = amount, position
                        folded[definition] = (folded[definition] or 0) + 1
                    end
                end
            end
        end
        if shift or arithmetic or op == ICMP then
            local position: integer = 2
            local value = colArgs[colFirstArg[at] + 1]
            local definition = colDefinitions[value]
            if op == IADD and (definition <= 0 or colOp[definition] ~= ICONST) then
                position, value = 1, colArgs[colFirstArg[at]]
                definition = colDefinitions[value]
            end
            local width = bits(colValueKinds[value])
            if definition > 0 and colOp[definition] == ICONST and width >= 32 then
                local literal = colImm[definition]
                if width == 32 then
                    literal = literal & 0xffffffff
                    if arithmetic and literal >= 0x80000000 then
                        literal = literal - 0x100000000
                    end
                end
                if shift then
                    literal = literal & (width - 1)
                end
                if shift
                    or (
                        literal >= (arithmetic and -16773120 or 0)
                        and literal <= 16773120
                        and (math.abs(literal) < 4096 or literal % 4096 == 0)
                    )
                then
                    immediates[at], immediateArgs[at] = literal, position
                    folded[definition] = (folded[definition] or 0) + 1
                end
            end
        end
    end
    for definition, count in pairs(folded) do
        if count == uses[f.result[definition]] then
            omitted[definition] = true
        end
    end
    -- Recipes contain producer opcode, encoding fields, then expanded operands.
    -- Only adjacency (or an omitted literal gap) preserves allocated lifetimes.
    local recipes: {[integer]: {integer}} = {}
    for block, start in ipairs(f.blockStart) do
        for at = start + 1, f.blockEnd[block] do
            local op, first = colOp[at], colFirstArg[at]
            if dead[at] then
                op = 0
            end
            local memory = op == LOAD or op == SLOAD or op == STORE
            local arithmetic = op == IADD or op == ISUB
            local previous = at - 1
            if op == BAND and colOp[previous] == ICONST then
                previous = previous - 1
            end
            -- What selects as nothing keeps the producer's operands in place.
            while previous > start and (dead[previous] or omitted[previous] and colOp[previous] == ICONST) do
                previous = previous - 1
            end
            -- So does a producer further back, when nothing between writes
            -- where its operands are or has an effect (transparent). Only a
            -- producer the consumer can fuse is sought: an add for an
            -- address, a multiply or shift for an add, a shift for a mask.
            -- A load or store fuses only its address: a store's value,
            -- though made nearer, is no address.
            local fusable = memory and IADD or arithmetic and IMUL or op == BAND and USHR or 0
            local fusableShift = arithmetic and ISHL or fusable
            local adjacent = previous >= start
                and (colOp[previous] == fusable or colOp[previous] == fusableShift)
                and (
                    f.result[previous] == colArgs[first]
                    or f.nargs[at] >= 2 and f.result[previous] == colArgs[first + 1]
                )
            if fusable ~= 0 and f.nargs[at] >= 1 and not adjacent then
                local address = op == STORE and 2 or 1
                for position = memory and address or 1, memory and address or math.min(f.nargs[at], 2) do
                    local definition = colDefinitions[colArgs[first + position - 1]]
                    if definition >= start
                        and definition < previous
                        and (colOp[definition] == fusable or colOp[definition] == fusableShift)
                        and helpers.transparent(f, location, dead, omitted, definition, at)
                    then
                        previous = definition
                    end
                end
            end
            if previous >= start and (memory or (arithmetic or op == BAND) and not recipes[previous]) then
                local value, producer = f.result[previous], colOp[previous]
                local position = (op == STORE or op == ISUB) and 2 or 1
                if op == IADD and colArgs[first] ~= value then
                    position = 2
                end
                local width = bits(colKind[previous])
                if value ~= 0 and uses[value] == 1 and colArgs[first + position - 1] == value and width >= 32 then
                    local left, right = colArgs[colFirstArg[previous]], colArgs[colFirstArg[previous] + 1]
                    local amount = immediates[previous]
                    local recipe: {integer}? = nil
                    if memory and producer == IADD and width == 64 then
                        local kind = op == STORE and colValueKinds[colArgs[first]] or colKind[at]
                        local bytes = (colAux[at] ~= 0 and colAux[at] or bits(kind)) // 8
                        local mul = recipes[previous]
                        local indexed = kind == ir.I64 and bytes == 8 and op ~= SLOAD and colImm[at] == 0
                        if mul and mul[1] == ISHL and mul[2] == 3 and indexed then
                            recipe = op == STORE and {IMUL, 0, 0, colArgs[first], mul[4], mul[5]}
                                or {IMUL, 0, 0, mul[4], mul[5]}
                        elseif mul and mul[1] == IMUL and indexed then
                            local index, scale = mul[4], mul[5]
                            local definition = colDefinitions[scale]
                            if definition > 0 and colOp[definition] == ICONST and colImm[definition] == 8 then
                                recipe = op == STORE and {IMUL, 0, 0, colArgs[first], mul[6], index}
                                    or {IMUL, 0, 0, mul[6], index}
                                omitted[definition] = uses[scale] == 1 or omitted[definition] == true
                            end
                        elseif amount ~= nil then
                            local offset = amount + colImm[at]
                            local base = immediateArgs[previous] == 1 and right or left
                            if offset >= 0 and offset % bytes == 0 and offset // bytes < 4096 then
                                recipe = op == STORE and {producer, offset, 0, colArgs[first], base}
                                    or {producer, offset, 0, base}
                            end
                        end
                    elseif arithmetic and width == bits(colKind[at]) and immediates[at] == nil then
                        local other = colArgs[first + 2 - position]
                        if producer == IMUL and amount == nil then
                            recipe = {producer, 0, 0, left, right, other}
                        elseif producer == IMUL then
                            local base: integer = immediateArgs[previous] == 1 and right or left
                            recipe = {ISHL, amount as integer, 0, other, base}
                        elseif producer == ISHL and amount ~= nil then
                            recipe = {producer, amount, 0, other, left}
                        end
                    elseif op == BAND and producer == USHR and amount ~= nil and width == bits(colKind[at]) then
                        local maskValue = colArgs[first + 1]
                        local definition = colDefinitions[maskValue]
                        if definition > 0
                            and colOp[definition] == ICONST
                            and (previous == at - 1 or definition == at - 1 and uses[maskValue] == 1)
                        then
                            local mask = colImm[definition] & (width == 64 and -1 or 0xffffffff)
                            local n, _, last = logical(mask, width)
                            if mask > 0 and (mask & (mask + 1)) == 0 and n >= 0 and last + amount < width then
                                recipe = {producer, amount, last + amount, left}
                                if uses[maskValue] == 1 then
                                    omitted[definition] = true
                                end
                            end
                        end
                    end
                    if recipe then
                        recipes[at], omitted[previous] = recipe, true
                    end
                end
            end
        end
    end

    -- A dropped operation is selected as an omitted literal is: as nothing.
    for at in pairs(dead) do
        omitted[at] = true
    end

    return uses, immediates, immediateArgs, omitted, recipes
end

-- Reloads what edge `e` moves into a parameter that is read, with `hold`.
function helpers.holdEdge(
    f: ir.Function,
    a: allocate.Allocation,
    hold: function(integer, boolean): nil,
    e: integer
): nil
    local first = f.firstParam[f.edgeTarget[e]]
    for p = 0, f.edgeNargs[e] - 1 do
        if a.used[f.params[first + p]] ~= false then
            hold(f.edgeArgs[f.edgeFirstArg[e] + p], false)
        end
    end
end

-- Saving lazily, reloads with `hold` what is live out of `block` that a call
-- left stale.
function helpers.holdLive(
    a: allocate.Allocation,
    lazy: boolean,
    hold: function(integer, boolean): nil,
    block: integer
): nil
    if lazy then
        for _, value in ipairs(a.liveOut[block]) do
            hold(value, false)
        end
    end
end

-- The blocks of the allocation's order that a branch reaches from the entry:
-- a jump threaded past a block (allocate.simplify) may leave none that does.
function helpers.emittedBlocks(f: ir.Function, a: allocate.Allocation): ({integer}, {[integer]: boolean})
    local reached: {boolean} = {true}
    local pending: {integer} = {1}
    while #pending > 0 do
        local b = table.remove(pending) as integer
        for i = f.blockStart[b], f.blockEnd[b] do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                local target = f.edgeTarget[e]
                if not reached[target] then
                    reached[target] = true
                    pending[#pending + 1] = target
                end
            end
        end
    end
    local emitted: {integer} = {}
    for _, b in ipairs(a.blockOrder) do
        if reached[b] then
            emitted[#emitted + 1] = b
        end
    end

    return emitted, reached
end

-- Whether the 64-bit load of `rt` from `rn` plus `offset` joined the load
-- emitted last in `words` as one load pair: that one reads the word beside
-- it from the same base, which it does not replace, and it is in this block
-- (the words from `first`), so no branch lands between the two.
function helpers.paired(words: {integer}, first: integer, rt: integer, rn: integer, offset: integer): boolean
    local last = #words
    local word = last >= first and words[last] or 0
    if word & 0xffc00000 ~= 0xf9400000 then
        return false
    end
    local before, base, at = word & 31, (word >> 5) & 31, ((word >> 10) & 0xfff) * 8
    if base ~= rn or before == rn or before == rt or rt == 31 or before == 31 then
        return false
    end
    if offset == at + 8 and at <= 504 then
        words[last] = arm.ldp(64, before, rt, rn, at, 0)
        return true
    elseif offset == at - 8 and offset >= 0 then
        words[last] = arm.ldp(64, rt, before, rn, offset, 0)
        return true
    end

    return false
end

-- How many edges an instruction in a reached block names into each block.
function helpers.namedPredecessors(f: ir.Function, reached: {[integer]: boolean}): {integer}
    local counts: {integer} = {}
    for b = 1, #f.blockStart do
        counts[b] = 0
    end
    for b, start in ipairs(f.blockStart) do
        if reached[b] then
            for i = start, f.blockEnd[b] do
                for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                    counts[f.edgeTarget[e]] = counts[f.edgeTarget[e]] + 1
                end
            end
        end
    end

    return counts
end

-- Each block's predecessor blocks.
function helpers.predecessorsOf(f: ir.Function): {{integer}}
    local predecessors: {{integer}} = {}
    local blockOf: {integer} = {}
    for b, start in ipairs(f.blockStart) do
        predecessors[b] = {}
        for i = start, f.blockEnd[b] do
            blockOf[i] = b
        end
    end
    for e, to in ipairs(f.edgeTarget) do
        local list = predecessors[to]
        list[#list + 1] = blockOf[f.edgeFrom[e]]
    end

    return predecessors
end

-- The saved values current on entry to a block whose predecessors are
-- `list`: those every predecessor leaves current, or none when one of them
-- (a back edge) is not selected yet.
function helpers.entryState(list: {integer}, exits: {[integer]: {[integer]: boolean}}): {[integer]: boolean}
    local entering: {[integer]: boolean} = {}
    for _, predecessor in ipairs(list) do
        if exits[predecessor] == nil then
            return entering
        end
    end
    if #list == 0 then
        return entering
    end
    local firstExit = exits[list[1]] as {[integer]: boolean}
    for value in pairs(firstExit) do
        local everywhere = true
        for k = 2, #list do
            local other = exits[list[k]] as {[integer]: boolean}
            everywhere = everywhere and other[value] == true
        end
        if everywhere then
            entering[value] = true
        end
    end

    return entering
end

-- Scratch the selection of one function reuses throughout, kept here rather
-- than as locals of selector.run: every local of a function is a slot of the
-- core's frame, which holds fewer than 250. Selection is not reentrant.
local regs: {integer} = {}
local transportSources: {integer} = {}
local transportDestinations: {integer} = {}
local transportKinds: {integer} = {}
local abiRegisters: {integer} = {}
-- Where abi puts what the registers do not hold, and the registers a
-- staged call restores.
local abiOffsets: {integer}, abiSizes: {integer}, stagedRegisters: {integer} = {}, {}, {}
-- The fast path's argument kinds, past its function, by signature.
local registerParams: {[any]: {integer}} = setmetatable({}, {__mode = "k"})

function selector.run(f: ir.Function, a: allocate.Allocation): selector.Code
    local code = selector.Code(
        words = {},
        fixupWord = {},
        fixupKind = {},
        fixupName = {},
        fixupAddend = {},
        blockWord = {},
        frameBytes = 0,
        stackOffsets = {},
        opWords = {},
        opCounts = {}
    )
    local cursor: integer = 16 + a.spillSlots * 8
    for slot, bytes in ipairs(f.stackBytes) do
        cursor = align(cursor, f.stackAlign[slot])
        code.stackOffsets[slot], cursor = cursor, cursor + bytes
    end
    local scratchBase = align(cursor, 8)
    local stageBase = scratchBase + 64
    code.frameBytes = align(stageBase + 17 * 8, 16)
    assert(code.frameBytes < 16777216, "S0 select: arena frame exceeds address increment range")
    for op = 1, #ir.opNames do
        code.opWords[op], code.opCounts[op] = 0, 0
    end
    local localWord: {integer} = {}
    -- A local branch's block, and above bit 32 its condition plus one (zero
    -- for an unconditional branch).
    local localBlock: {integer} = {}
    local borrowed: {integer} = {}
    local occupied: {integer} = {}
    local used: {integer} = {}
    for physical = 1, 96 do
        occupied[physical], used[physical] = 0, 0
    end
    local occupiedStamp: integer = 0
    local usedStamp: integer = 0
    local borrowedCount: integer = 0
    local moveTarget = selector.target()
    local moveWorkspace = allocate.workspace()

    local function emit(word: integer): nil
        assert(word >= 0 and word <= 0xffffffff, "S0 select: codeword range")
        code.words[#code.words + 1] = word
    end

    local function constant(rd: integer, value: integer, width: integer): nil
        local halves = width // 16
        local nonzero, nonones = 0, 0
        for half = 0, halves - 1 do
            local part = (value >> (half * 16)) & 65535
            if part ~= 0 then
                nonzero = nonzero + 1
            end
            if part ~= 65535 then
                nonones = nonones + 1
            end
        end
        if math.min(nonzero, nonones) > 1 then
            local n, r, last = logical(value, width)
            if n >= 0 then
                emit(arm.orr_imm(width, rd, 31, n, r, last))
                return
            end
        end
        local invert = nonones < nonzero
        local first = true
        for half = 0, halves - 1 do
            local part = (value >> (half * 16)) & 65535
            if (invert and part ~= 65535) or (not invert and part ~= 0) then
                if first then
                    emit(invert and arm.movn(width, rd, (~part) & 65535, half) or arm.movz(width, rd, part, half))
                    first = false
                else
                    emit(arm.movk(width, rd, part, half))
                end
            end
        end
        if first then
            emit(invert and arm.movn(width, rd, 0, 0) or arm.movz(width, rd, 0, 0))
        end
    end

    local function addOffset(rd: integer, rn: integer, amount: integer): nil
        assert(amount >= 0 and amount < 16777216, "S0 select: address increment range")
        local high, low = amount >> 12, amount & 4095
        if high ~= 0 then
            emit(arm.add_imm(64, rd, rn, high, 1));
            rn = rd
        end
        if low ~= 0 or high == 0 then
            emit(arm.add_imm(64, rd, rn, low, 0))
        end
    end

    local function spillOffset(location: integer): integer
        assert(location < 0 and -location <= a.spillSlots, "S0 select: invalid spill")
        return 16 + (-location - 1) * 8
    end

    -- The selector's arena header holds LR at +0 and a temporary GPR at +8.
    -- These words are independent of logical guest Frame storage.
    local function memory(reg: integer, offset: integer, store: boolean): nil
        assert(offset >= 0 and offset % 8 == 0 and offset <= code.frameBytes - 8, "S0 select: arena access range")
        local base: integer = 23
        if offset > 32760 then
            base = reg == 17 and 17 or 16
            emit(arm.str(8, base, 23, 8))
            addOffset(base, 23, offset & -4096)
            offset = offset & 4095
        end
        if reg >= 65 then
            emit(store and arm.str_fp(64, reg - 65, base, offset) or arm.ldr_fp(64, reg - 65, base, offset))
        else
            emit(store and arm.str(8, reg - 1, base, offset) or arm.ldr(8, reg - 1, base, offset))
        end
        if base ~= 23 then
            emit(arm.ldr(8, base, 23, 8))
        end
    end

    local function save(reg: integer, offset: integer): nil
        memory(reg, offset, true)
    end

    local function restore(reg: integer, offset: integer): nil
        memory(reg, offset, false)
    end

    -- A value with a save slot keeps its register: it is written to the slot
    -- where it is defined, a call that clobbers the register marks it stale,
    -- and its next use reloads it (Allocation.saveSlot). `current` holds the
    -- values whose register is known to hold them here.
    -- `saved` lists the values with a save slot, and `exits` what each
    -- selected block leaves current.
    -- One table: every local of this function is a slot of the core's frame.
    local track = {
        current = {} as {[integer]: boolean},
        saved = {} as {integer},
        exits = {} as {[integer]: {[integer]: boolean}},
        predecessors = {} as {{integer}},
        -- Whether the instruction selected last left its narrow result
        -- zero-extended already.
        extended = false,
        -- The call arguments made in their registers after the moves.
        late = {} as {integer},
        -- A function that dispatches (a tail call) saves lazily: a value is
        -- stored before a call it is live across, unless this block stored
        -- it already, and every block ends with what is live out of it in
        -- its registers. Its paths that call nothing touch no save slot.
        lazy = false,
        stored = {} as {[integer]: boolean},
        -- Each value's uses (prepare).
        uses = {} as {integer},
        -- The blocks selected, in order, and which those are (emittedBlocks).
        emitted = {} as {integer},
        reached = {} as {[integer]: boolean},
        -- How many named edges enter each block (namedPredecessors).
        named = {} as {integer},
        -- The word a conditional compare was selected at, until its block's
        -- branch: nothing may come between them.
        chained = 0
    }
    for _, op in ipairs(f.op) do
        track.lazy = track.lazy or op == RETURN_CALL or op == RETURN_CALL_INDIRECT
    end
    for value, slot in ipairs(a.saveSlot) do
        if slot ~= 0 then
            track.saved[#track.saved + 1] = value
        end
    end

    -- Writes a saved value to its slot where it is `defining` it, and
    -- otherwise reloads it if a call left its register stale.
    local function hold(value: integer, defining: boolean): nil
        if a.saveSlot[value] ~= 0 and (defining or not track.current[value]) then
            if not (defining and track.lazy) then
                memory(a.location[value], spillOffset(-a.saveSlot[value]), defining)
            end
            track.current[value] = true
        end
    end

    local function temporary(floating: boolean): integer
        local first, last = floating and 96 or 18, floating and 65 or 1
        for p = first, last, -1 do
            local allowed = floating or p == 17 or p == 18 or p <= 16
            if allowed and used[p] ~= usedStamp and occupied[p] ~= occupiedStamp then
                used[p] = usedStamp
                if p ~= 17 and p ~= 18 and p ~= 96 then
                    assert(borrowedCount < 8, "S0 select: scratch capacity")
                    save(p, scratchBase + borrowedCount * 8)
                    borrowedCount = borrowedCount + 1
                    borrowed[borrowedCount] = p
                end
                return target.register(p)
            end
        end
        error("S0 select: no scratch register")
    end

    local function source(value: integer): integer
        local location, kind = a.location[value], f.valueKinds[value]
        assert(location ~= 0, "S0 select: unallocated source")
        if location > 0 then
            hold(value, false)
            return target.register(location)
        end
        local reg = temporary(ir.isFloat(kind))
        local remat = a.rematerialize[value]
        if remat ~= 0 and f.op[remat] == ICONST then
            constant(reg, f.imm[remat], machine(kind))
        elseif remat ~= 0 and f.op[remat] == STACK_ADDR then
            addOffset(reg, 23, code.stackOffsets[f.aux[remat]] + f.imm[remat])
        else
            restore(ir.isFloat(kind) and reg + 65 or reg + 1, spillOffset(location))
        end

        return reg
    end

    local function destination(value: integer): integer
        local location = a.location[value]
        assert(location ~= 0, "S0 select: unallocated result")
        return location > 0 and target.register(location) or temporary(ir.isFloat(f.valueKinds[value]))
    end

    -- `extended`: the instruction already left a narrow result zero-extended.
    local function finish(value: integer, reg: integer, extended: boolean?): nil
        if value ~= 0 then
            local kind = f.valueKinds[value]
            if (kind == ir.I8 or kind == ir.I16) and not extended then
                emit(arm.ubfm(32, reg, reg, 0, bits(kind) - 1))
            end
            if a.location[value] < 0 then
                save(ir.isFloat(kind) and reg + 65 or reg + 1, spillOffset(a.location[value]))
            else
                hold(value, true)
            end
        end
        for p = borrowedCount, 1, -1 do
            restore(borrowed[p], scratchBase + (p - 1) * 8)
        end
        borrowedCount, usedStamp = 0, usedStamp + 1
    end

    local function move(sourceLoc: integer, destinationLoc: integer, kind: integer): nil
        if sourceLoc == destinationLoc then
            return
        end
        if sourceLoc < 0 and destinationLoc < 0 then
            restore(18, spillOffset(sourceLoc))
            save(18, spillOffset(destinationLoc))
        elseif sourceLoc < 0 then
            restore(destinationLoc, spillOffset(sourceLoc))
        elseif destinationLoc < 0 then
            save(sourceLoc, spillOffset(destinationLoc))
        elseif ir.isFloat(kind) then
            emit(arm.fmov(bits(kind), target.register(destinationLoc), target.register(sourceLoc)))
        else
            emit(arm.mov_reg(machine(kind), target.register(destinationLoc), target.register(sourceLoc)))
        end
    end

    local function transport(count: integer): nil
        local sources, destinations, kinds = transportSources, transportDestinations, transportKinds
        for p = #sources, count + 1, -1 do
            sources[p], destinations[p], kinds[p] = nil, nil, nil
        end
        local first = #a.moveSource + 1
        allocate.parallel(sources, destinations, kinds, moveTarget, a, moveWorkspace)
        for p = first, #a.moveSource do
            move(a.moveSource[p], a.moveTarget[p], a.moveKind[p])
        end
        -- Preserve the allocator's edge-move arrays after temporary scheduling.
        for p = #a.moveSource, first, -1 do
            a.moveSource[p], a.moveTarget[p], a.moveKind[p] = nil, nil, nil
        end
    end

    local function edge(e: integer, nextBlock: integer): nil
        local first, last = a.firstMove[e], a.firstMove[e] + a.nmoves[e] - 1
        local scratchFree = true
        for p = first, last do
            scratchFree = scratchFree and a.moveSource[p] ~= 17 and a.moveTarget[p] ~= 17
        end
        local p = first
        while p <= last do
            local source, destination = a.moveSource[p], a.moveTarget[p]
            -- Spill copies retain all 64 bits. Exclude a write feeding the next
            -- read, and protect x16 when the parallel schedule uses its scratch.
            if scratchFree
                and p < last
                and source < 0
                and destination < 0
                and a.moveSource[p + 1] == source - 1
                and a.moveTarget[p + 1] == destination - 1
                and destination ~= source - 1
                and source >= -62
                and destination >= -62
            then
                emit(arm.ldp(64, 16, 17, 23, spillOffset(source), 0))
                emit(arm.stp(64, 16, 17, 23, spillOffset(destination), 0))
                p = p + 2
            else
                move(source, destination, a.moveKind[p])
                p = p + 1
            end
        end
        if f.edgeTarget[e] ~= nextBlock then
            localWord[#localWord + 1], localBlock[#localBlock + 1] = #code.words + 1, f.edgeTarget[e]
            emit(arm.b(0))
        end
    end

    local function symbolic(kind: integer, name: string): nil
        code.fixupWord[#code.fixupWord + 1], code.fixupKind[#code.fixupKind + 1] = #code.words + 1, kind
        code.fixupName[#code.fixupName + 1], code.fixupAddend[#code.fixupAddend + 1] = name, 0
        emit(kind == selector.B26 and arm.b(0) or kind == selector.BL26 and arm.bl(0) or arm.ldr(8, 16, 22, 0))
    end

    -- A foreign symbol's cached address, at its table slot (`nupp.core.link`).
    local function cell(word: integer, key: string): nil
        code.fixupWord[
            #code.fixupWord + 1
        ], code.fixupKind[#code.fixupKind + 1] = #code.words + 1, selector.FOREIGN_CELL
        code.fixupName[#code.fixupName + 1], code.fixupAddend[#code.fixupAddend + 1] = key, 0
        emit(word)
    end

    -- Writes `text` and a NUL below sp: the bytes it took.
    local function pushText(text: string): integer
        local bytes = align(#text + 1, 16)
        assert(bytes < 4096, "S0 select: foreign name length")
        emit(arm.sub_imm(64, 31, 31, bytes, 0))
        for offset = 0, bytes - 8, 8 do
            local word: integer = 0
            for index = 1, 8 do
                word = word | ((text:byte(offset + index) or 0) << ((index - 1) * 8))
            end
            constant(17, word, 64)
            emit(arm.str(8, 17, 31, offset))
        end

        return bytes
    end

    -- Gives back `bytes` of the C stack below sp.
    local function popStack(bytes: integer): nil
        if bytes > 0 then
            emit(arm.add_imm(64, 31, 31, bytes, 0))
        end
    end

    -- Calls the import at `slot` (a numeral) of x22's table.
    local function callSlot(slot: string): nil
        emit(arm.ldr(8, 16, 22, (tonumber(slot) as integer) * 8))
        emit(arm.blr(16))
    end

    -- Calls the loader import at `slot`, gives back the `bytes` its name took
    -- below sp, and keeps what it answered (x0) in the table word `key` names;
    -- the table is import `tableAt`.
    local function load(slot: string, bytes: integer, tableAt: integer, key: string): nil
        callSlot(slot)
        popStack(bytes)
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.str(8, 0, 16, 0), key)
    end

    -- The process namespace owns its loader reference for the generated code's
    -- lifetime, just like every named library cached below.
    local function processLibrary(tableAt: integer, openSlot: string): nil
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.ldr(8, 0, 16, 0), PROCESS_LIBRARY)
        local kept = #code.words + 1
        emit(arm.cbnz(64, 0, 0))
        constant(0, 0, 64)
        constant(1, LOAD_NOW, 64)
        load(openSlot, 0, tableAt, PROCESS_LIBRARY)
        code.words[kept] = arm.cbnz(64, 0, (#code.words + 1 - kept) * 4)
        emit(arm.cbnz(64, 0, 8))
        emit(arm.brk(MISSING_SYMBOL))
    end

    -- Bootstrap dlerror through the supplied dlsym, without adding an ABI slot.
    -- The same cached function clears before a lookup and reads its error after.
    local function loaderError(tableAt: integer, openSlot: string, symbolSlot: string): nil
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.ldr(8, 0, 16, 0), LOADER_ERROR)
        local kept = #code.words + 1
        emit(arm.cbnz(64, 0, 0))
        processLibrary(tableAt, openSlot)
        local bytes = pushText("dlerror")
        emit(arm.add_imm(64, 1, 31, 0, 0))
        load(symbolSlot, bytes, tableAt, LOADER_ERROR)
        emit(arm.cbnz(64, 0, 8))
        emit(arm.brk(MISSING_SYMBOL))
        code.words[kept] = arm.cbnz(64, 0, (#code.words + 1 - kept) * 4)
        emit(arm.blr(0))
    end

    local function lookup(tableAt: integer, openSlot: string, symbolSlot: string, libraryKey: string, name: string): nil
        loaderError(tableAt, openSlot, symbolSlot)
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.ldr(8, 0, 16, 0), libraryKey)
        local bytes = pushText(name)
        emit(arm.add_imm(64, 1, 31, 0, 0))
        callSlot(symbolSlot)
        popStack(bytes)
        emit(arm.sub_imm(64, 31, 31, 16, 0))
        emit(arm.str(8, 0, 31, 0))
        loaderError(tableAt, openSlot, symbolSlot)
        emit(arm.cmp_imm(64, 0, 0, 0))
        emit(arm.ldr(8, 0, 31, 0))
        emit(arm.csel(64, 0, 0, 31, target.EQ))
        popStack(16)
    end

    -- Raw kernel cdefs have no managed frame to construct a path in. Copy the
    -- C startup's immutable artifact directory and the literal suffix on the C
    -- stack. No cwd change, heap allocation, provider wrapper or ABI change.
    local function openArtifact(library: string, tableAt: integer, openSlot: string, symbolSlot: string): nil
        processLibrary(tableAt, openSlot)
        lookup(tableAt, openSlot, symbolSlot, PROCESS_LIBRARY, "nupp_core_artifact_directory")
        local absent = #code.words + 1
        emit(arm.cbz(64, 0, 0))
        emit(arm.ldr(8, 9, 0, 0))
        local unset = #code.words + 1
        emit(arm.cbz(64, 9, 0))
        local relative = library:sub(2):gsub("^/+", "")
        local bytes = pushText(relative)
        emit(arm.sub_imm(64, 31, 31, ARTIFACT_PATH_BYTES >> 12, 1))
        emit(arm.add_imm(64, 10, 31, 0, 0))
        constant(11, ARTIFACT_PATH_BYTES - #relative - 2, 64)
        local copyRoot = #code.words + 1
        emit(arm.ldr(1, 12, 9, 0))
        local ended = #code.words + 1
        emit(arm.cbz(32, 12, 0))
        local full = #code.words + 1
        emit(arm.cbz(64, 11, 0))
        emit(arm.str(1, 12, 10, 0))
        emit(arm.add_imm(64, 9, 9, 1, 0))
        emit(arm.add_imm(64, 10, 10, 1, 0))
        emit(arm.sub_imm(64, 11, 11, 1, 0))
        emit(arm.b((copyRoot - #code.words - 1) * 4))
        code.words[ended] = arm.cbz(32, 12, (#code.words + 1 - ended) * 4)
        constant(12, 0x2f, 32)
        emit(arm.str(1, 12, 10, 0))
        emit(arm.add_imm(64, 10, 10, 1, 0))
        emit(arm.add_imm(64, 13, 31, ARTIFACT_PATH_BYTES >> 12, 1))
        local copySuffix = #code.words + 1
        emit(arm.ldr(1, 12, 13, 0))
        emit(arm.str(1, 12, 10, 0))
        emit(arm.add_imm(64, 13, 13, 1, 0))
        emit(arm.add_imm(64, 10, 10, 1, 0))
        emit(arm.cbnz(32, 12, (copySuffix - #code.words - 1) * 4))
        emit(arm.add_imm(64, 0, 31, 0, 0))
        constant(1, LOAD_NOW, 64)
        callSlot(openSlot)
        local loaded = #code.words + 1
        emit(arm.b(0))
        code.words[full] = arm.cbz(64, 11, (#code.words + 1 - full) * 4)
        constant(0, 0, 64)
        code.words[loaded] = arm.b((#code.words + 1 - loaded) * 4)
        emit(arm.add_imm(64, 31, 31, ARTIFACT_PATH_BYTES >> 12, 1))
        popStack(bytes)
        local done = #code.words + 1
        emit(arm.b(0))
        local fallback = #code.words + 1
        code.words[absent] = arm.cbz(64, 0, (fallback - absent) * 4)
        code.words[unset] = arm.cbz(64, 9, (fallback - unset) * 4)
        -- The frozen reference transport's existing import anchors @ itself.
        bytes = pushText(library)
        emit(arm.add_imm(64, 0, 31, 0, 0))
        constant(1, LOAD_NOW, 64)
        callSlot(openSlot)
        popStack(bytes)
        code.words[done] = arm.b((#code.words + 1 - done) * 4)
    end

    -- A foreign call's symbol in x0, as a C call answers it. The bridge's
    -- table (x22's import `table`) keeps each symbol and library once
    -- resolved; the first call loads the library with dlopen, the program
    -- itself for "", and finds the symbol with dlsym. A symbol that is not
    -- there traps rather than being called.
    local function resolve(name: string): nil
        local tableSlot, openSlot, symbolSlot, library, symbol = name:match(
            "^foreign\0(%d+)\0(%d+)\0(%d+)\0(.-)\0(.*)$"
        )
        assert(symbol ~= nil, "S0 select: foreign import name")
        local tableAt = (tonumber(tableSlot) as integer) * 8
        local symbolKey, libraryKey = "symbol\0" .. library .. "\0" .. symbol, "library\0" .. library
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.ldr(8, 0, 16, 0), symbolKey)
        local cached = #code.words + 1
        emit(arm.cbnz(64, 0, 0))
        cell(arm.ldr(8, 1, 16, 0), libraryKey)
        local opened = #code.words + 1
        emit(arm.cbnz(64, 1, 0))
        local bytes: integer = 0
        if library:sub(1, 1) == "@" then
            openArtifact(library, tableAt, openSlot, symbolSlot)
            emit(arm.ldr(8, 16, 22, tableAt))
            cell(arm.str(8, 0, 16, 0), libraryKey)
        elseif library == "" then
            emit(arm.movz(64, 0, 0, 0))
            constant(1, LOAD_NOW, 64)
            load(openSlot, 0, tableAt, libraryKey)
        else
            bytes = pushText(library)
            emit(arm.add_imm(64, 0, 31, 0, 0))
            constant(1, LOAD_NOW, 64)
            load(openSlot, bytes, tableAt, libraryKey)
        end
        emit(arm.mov_reg(64, 1, 0))
        code.words[opened] = arm.cbnz(64, 1, (#code.words + 1 - opened) * 4)
        -- A library that did not load leaves x0 zero.
        local missing = #code.words + 1
        emit(arm.cbz(64, 1, 0))
        lookup(tableAt, openSlot, symbolSlot, libraryKey, symbol)
        emit(arm.ldr(8, 16, 22, tableAt))
        cell(arm.str(8, 0, 16, 0), symbolKey)
        local done = #code.words + 1
        code.words[cached] = arm.cbnz(64, 0, (done - cached) * 4)
        code.words[missing] = arm.cbz(64, 1, (done - missing) * 4)
        emit(arm.cbnz(64, 0, 8))
        emit(arm.brk(MISSING_SYMBOL))
    end

    -- The generic foreign call: x0 holds its block. The first `words` stack
    -- words are copied onto the C stack, then `floats` float and `integers`
    -- integer registers are loaded, x0 last, and the function is called. A
    -- guest's call (`all`), whose signature is known only as it runs, takes
    -- every register and stack word, passes x8 and keeps x0, x1 and d0-d3
    -- in the block; a kernel's names what its signature fills
    -- (nativeos.foreignRoutine) and its result stays in x0 or d0, where the
    -- call's own kind reads it.
    local function foreignCall(integers: integer, floats: integer, words: integer, all: boolean): nil
        local bytes = (words * 8 + 15) // 16 * 16
        local saved = all and CALL_SAVED or 0
        if bytes + saved > 0 then
            emit(arm.sub_imm(64, 31, 31, bytes + saved, 0))
        end
        if all then
            emit(arm.str(8, 0, 31, bytes))
        end
        for word = 0, words - 1 do
            emit(arm.ldr(8, 17, 0, (CALL_STACK + word) * 8))
            emit(arm.str(8, 17, 31, word * 8))
        end
        for reg = 0, floats - 1 do
            emit(arm.ldr_fp(64, reg, 0, (CALL_FLOATS + reg) * 8))
        end
        emit(arm.ldr(8, 16, 0, CALL_FUNCTION * 8))
        if all then
            emit(arm.ldr(8, INDIRECT_RESULT, 0, CALL_RESULT_ADDRESS * 8))
        end
        for reg = integers - 1, 0, -1 do
            emit(arm.ldr(8, reg, 0, (CALL_INTEGERS + reg) * 8))
        end
        emit(arm.blr(16))
        if all then
            emit(arm.ldr(8, 17, 31, bytes))
            for reg = 0, CALL_RESULT_INTEGERS - 1 do
                emit(arm.str(8, reg, 17, (CALL_INTEGERS + reg) * 8))
            end
            for reg = 0, CALL_RESULT_FLOATS - 1 do
                emit(arm.str_fp(64, reg, 17, (CALL_FLOATS + reg) * 8))
            end
        end
        if bytes + saved > 0 then
            emit(arm.add_imm(64, 31, 31, bytes + saved, 0))
        end
    end

    -- One fixed libffi handler: void(cif, result, void **args, userdata).
    -- libffi owns every user-signature ABI entry. This leaf copies raw C
    -- words only: no managed entry, allocation, parking or unwind. Userdata
    -- offsets are foreignabi.CLOSURE_*; its entry owner frees after quiescence.
    local function foreignCollector(): nil
        local function hole(): integer
            emit(0)
            return #code.words
        end

        emit(arm.adr(0, 8))
        local skip = hole()
        emit(arm.sub_imm(64, 31, 31, 32, 0))
        emit(arm.str(8, LINK, 31, 0))
        emit(arm.str(8, 1, 31, 8))
        emit(arm.str(8, 2, 31, 16))
        emit(arm.str(8, 3, 31, 24))
        -- Refuse another OS thread before dereferencing caller-owned data.
        emit(arm.ldr(8, 16, 3, 32))
        emit(arm.blr(16))
        emit(arm.ldr(8, 3, 31, 24))
        emit(arm.ldr(8, 10, 3, 24))
        emit(arm.cmp_reg(64, 0, 10))
        local wrongThread = hole()
        emit(arm.ldr(8, 2, 31, 16))
        emit(arm.ldr(8, 0, 2, 0)) -- args[0] points at item bytes
        emit(arm.ldr(8, 2, 2, 16))
        emit(arm.ldr(8, 2, 2, 0)) -- *(void **)args[2] is the record
        emit(arm.cmp_imm(64, 2, 0, 0))
        local nullRecord = hole()
        emit(arm.ldr(8, 11, 2, COLLECT_WORDS_AT))
        emit(arm.ldr(8, 10, 3, 40))
        emit(arm.cmp_reg(64, 11, 10))
        local wrongShape = hole()
        emit(arm.ldr(8, 9, 2, COLLECT_COUNT_AT))
        emit(arm.ldr(8, 10, 2, COLLECT_LIMIT_AT))
        emit(arm.cmp_reg(64, 9, 10))
        local full = hole()
        emit(arm.ldr(8, 12, 2, COLLECT_BASE_AT))
        emit(arm.madd(64, 13, 9, 11, ZERO))
        emit(arm.add_reg(64, 12, 12, 13, 3))
        emit(arm.movz(64, 13, 0, 0))
        local loop = #code.words + 1
        emit(arm.cmp_reg(64, 13, 11))
        local copied = hole()
        emit(arm.memory64(false, 14, 0, 13))
        emit(arm.memory64(true, 14, 12, 13))
        emit(arm.add_imm(64, 13, 13, 1, 0))
        emit(arm.b((loop - (#code.words + 1)) * 4))
        code.words[copied] = arm.b_cond(HIGHER_SAME, (#code.words + 1 - copied) * 4)
        emit(arm.add_imm(64, 9, 9, 1, 0))
        emit(arm.str(8, 9, 2, COLLECT_COUNT_AT))
        emit(arm.movz(64, 0, VISIT_CONTINUE, 0))
        local success = hole()
        local bad = #code.words + 1
        emit(arm.movz(64, 10, 1, 0))
        emit(arm.str(8, 10, 3, 48)) -- owning Nupp boundary raises later
        local stop = #code.words + 1
        emit(arm.movz(64, 0, VISIT_BREAK, 0))
        local done = #code.words + 1
        emit(arm.ldr(8, 1, 31, 8))
        emit(arm.str(8, 0, 1, 0)) -- libffi requires ffi_arg for a narrow result
        emit(arm.ldr(8, LINK, 31, 0))
        emit(arm.add_imm(64, 31, 31, 32, 0))
        emit(arm.ret(LINK))
        code.words[wrongThread] = arm.b_cond(1, (bad - wrongThread) * 4)
        code.words[nullRecord] = arm.b_cond(0, (bad - nullRecord) * 4)
        code.words[wrongShape] = arm.b_cond(1, (bad - wrongShape) * 4)
        code.words[full] = arm.b_cond(HIGHER_SAME, (stop - full) * 4)
        code.words[success] = arm.b((done - success) * 4)
        code.words[skip] = arm.b((#code.words + 1 - skip) * 4)
    end

    -- Where each argument goes: abiRegisters holds its register, or 0 for
    -- one on the C stack at abiOffsets (abiSizes bytes); the answer is the
    -- stack's extent. Past the registers, and for each variadic argument,
    -- this is Apple's arm64 convention: a named argument at its own
    -- alignment, a variadic one in an 8-byte slot.

    local function abi(kinds: {integer}, fixed: integer?): integer
        local ints: integer = 0
        local floats: integer = 0
        local registers = abiRegisters
        local offset: integer = 0
        for p, kind in ipairs(kinds) do
            local named = fixed == nil or p <= fixed
            local floating = ir.isFloat(kind)
            if named and floating and floats < 8 then
                registers[p], floats = 65 + floats, floats + 1
            elseif named and not floating and ints < 8 then
                registers[p], ints = 1 + ints, ints + 1
            else
                local size = named and bits(kind) // 8 or 8
                offset = align(offset, size)
                registers[p], abiOffsets[p], abiSizes[p] = 0, offset, size
                offset = offset + size
            end
        end
        for p = #registers, #kinds + 1, -1 do
            registers[p] = nil
        end

        return align(offset, 16)
    end

    assert(abi(f.signature.params, nil) == 0, "S0 select: stack ABI parameters unsupported")
    local incoming, incomingLocations = abiRegisters, transportDestinations
    for p, physical in ipairs(incoming) do
        transportSources[p], transportKinds[p] = physical, f.signature.params[p]
        incomingLocations[p] = a.location[f.params[f.firstParam[1] + p - 1]]
    end
    transport(#incoming)

    -- Keep operation IDs and the columns the selection loop reads most local
    -- to it. The rest are read from `f`: every local is a slot of the frame,
    -- and the native core holds a function to fewer than 250.
    local colArgs = f.args
    local colImm = f.imm
    local colOp = f.op
    local colValueKinds = f.valueKinds
    local allocationLocation = a.location

    -- Selects call instruction `at`, whose operation is `op` and whose
    -- operands are `nargs` of `args` from `firstArg`. Its own function: the
    -- selection loop's locals are slots of the core's frame, fewer than 250.
    local function selectCall(at: integer, op: integer, args: {integer}, firstArg: integer, nargs: integer): nil
        local result, kind, second = f.result[at], f.kind[at], f.result2[at]
        local rd: integer = 0
        local indirect = op == CALL_INDIRECT or op == RETURN_CALL_INDIRECT
        local tail = op == RETURN_CALL or op == RETURN_CALL_INDIRECT
        -- Saving lazily, what is live across the call goes to its slot first,
        -- while its register still holds it: the argument moves may not.
        for _, value in ipairs(track.lazy and not tail and a.callLive[at] or {}) do
            if a.saveSlot[value] ~= 0 and not track.stored[value] then
                assert(track.current[value], "S0 select: a lazily saved value is stale before its store")
                memory(a.location[value], spillOffset(-a.saveSlot[value]), true)
                track.stored[value] = true
            end
        end
        local signature = f.signatures[indirect and f.aux[at] or f.importSignatures[f.aux[at]]]
        local name = not indirect and f.importNames[f.aux[at]] or ""
        -- The fast path's first operand is the function, which goes
        -- where an indirect call's target does.
        local registered = name:sub(1, #ROUTINE_REGISTERS) == ROUTINE_REGISTERS
        local params = signature.params
        if registered then
            params = registerParams[signature] or table.move(params, 2, #params, 1, {})
            registerParams[signature] = params
        end
        local stackBytes = abi(params, signature.fixed)
        assert(
            stackBytes == 0 or signature.convention == ir.C and not tail,
            "S0 select: stack ABI arguments need a C call"
        )
        local registers = abiRegisters
        local shift = (indirect or registered) and 1 or 0
        assert(nargs == #registers + shift, "S0 select: call arity")
        if stackBytes > 0 then
            -- What the registers do not hold goes on the C stack
            -- below sp, which Nupp code leaves aligned.
            assert(stackBytes < 4096, "S0 select: C stack argument extent")
            emit(arm.sub_imm(64, 31, 31, stackBytes, 0))
            for p, physical in ipairs(registers) do
                if physical == 0 then
                    local value = args[firstArg + shift + p - 1]
                    local valueKind = colValueKinds[value]
                    local reg = source(value)
                    emit(
                        ir.isFloat(valueKind) and arm.str_fp(bits(valueKind), reg, 31, abiOffsets[p])
                        or arm.str(abiSizes[p], reg, 31, abiOffsets[p])
                    )
                    finish(0, 0)
                end
            end
        end
        local parallel = true
        local count: integer = 0
        -- A literal or frame address that is not in a register
        -- is made in its argument register once the moves are done.
        local late = track.late as {integer}
        for p = #late, 1, -1 do
            late[p] = nil
        end
        for p = 1, nargs do
            local value = args[firstArg + p - 1]
            assert(not tail or not stackBorrowed(f)[value], "S0 select: tail call retains stack address")
            local physical = p <= shift and 17 or registers[p - shift]
            if physical ~= 0 then
                local location, remat = allocationLocation[value], a.rematerialize[value]
                parallel = parallel and location ~= 0
                hold(value, false)
                if location < 0 and remat ~= 0 and (colOp[remat] == ICONST or colOp[remat] == STACK_ADDR) then
                    late[#late + 1] = p
                else
                    parallel = parallel and (location > 0 or remat == 0)
                    count = count + 1
                    transportSources[
                        count
                    ], transportDestinations[count], transportKinds[count] = location, physical, colValueKinds[value]
                end
            end
        end
        if parallel then
            -- An indirect target loaded just before, for this call alone, is
            -- loaded into x16 itself.
            local callee = shift == 1 and args[firstArg] or 0
            local word = #code.words > 0 and code.words[#code.words] or 0
            if indirect
                and transportDestinations[1] == 17
                and transportSources[1] > 0
                and transportSources[1] <= 32
                and track.uses[callee] == 1
                and word & 31 == target.register(transportSources[1])
                and ((word >> 22) == 0x3e5 or (word & 0xffe00c00) == 0xf8600800)
            then
                code.words[#code.words] = (word & -32) | 16
                transportSources[1] = 17
            end
            -- x16 holds the indirect target; call destinations never
            -- include spills.
            moveTarget.scratchInt = 18
            transport(count)
            moveTarget.scratchInt = 17
            for _, p in ipairs(late) do
                local remat = a.rematerialize[args[firstArg + p - 1]]
                local reg = target.register(p <= shift and 17 or registers[p - shift])
                if colOp[remat] == ICONST then
                    constant(reg, colImm[remat], machine(colValueKinds[args[firstArg + p - 1]]))
                else
                    addOffset(reg, 23, code.stackOffsets[f.aux[remat]] + colImm[remat])
                end
            end
        else
            local staged: integer = 0
            for p = 1, nargs do
                local physical = p <= shift and 17 or registers[p - shift]
                if physical ~= 0 then
                    local value = args[firstArg + p - 1]
                    local reg = source(value)
                    save(ir.isFloat(colValueKinds[value]) and reg + 65 or reg + 1, stageBase + staged * 8)
                    finish(0, 0)
                    stagedRegisters[staged + 1] = physical
                    staged = staged + 1
                end
            end
            for p = 1, staged do
                restore(stagedRegisters[p], stageBase + (p - 1) * 8)
            end
        end
        -- LR is saved around each call, which then leaves it as
        -- it was: a function's paths that call nothing touch no
        -- memory for it.
        if not tail then
            emit(arm.str(8, 30, 23, 0))
        end
        if signature.convention == ir.INTERNAL then
            if not tail then
                addOffset(23, 23, code.frameBytes)
            end
            if indirect then
                emit(tail and arm.br(16) or arm.blr(16))
            else
                symbolic(tail and selector.B26 or selector.BL26, name)
            end
            if not tail then
                local high, low = code.frameBytes >> 12, code.frameBytes & 4095
                if high ~= 0 then
                    emit(arm.sub_imm(64, 23, 23, high, 1))
                end
                if low ~= 0 then
                    emit(arm.sub_imm(64, 23, 23, low, 0))
                end
            end
        elseif name:sub(1, #FOREIGN_PREFIX) == FOREIGN_PREFIX then
            assert(not tail and nargs == 0, "S0 select: foreign resolution takes nothing")
            resolve(name)
        elseif registered then
            assert(not tail and stackBytes == 0, "S0 select: the fast path passes registers alone")
            emit(arm.blr(16))
        elseif name == ROUTINE_CALL then
            assert(not tail and nargs == 1, "S0 select: a foreign call takes its block")
            foreignCall(CALL_REGISTERS, CALL_REGISTERS, CALL_STACK_WORDS, true)
        elseif name:sub(1, #ROUTINE_CALL + 1) == ROUTINE_CALL .. "\0" then
            local integers, floats, words, answer = name:match("^routine\0call\0(%d+)\0(%d+)\0(%d+)\0(%w+)$")
            assert(not tail and nargs <= 1 and answer ~= nil, "S0 select: a foreign call takes its block")
            local counted = {tonumber(integers) as integer, tonumber(floats) as integer, tonumber(words) as integer}
            assert(
                counted[1] <= CALL_REGISTERS and counted[2] <= CALL_REGISTERS and counted[3] <= CALL_STACK_WORDS,
                "S0 select: a foreign call's shape"
            )
            foreignCall(counted[1], counted[2], counted[3], false)
        elseif name == ROUTINE_COLLECTOR then
            assert(not tail and nargs == 0, "S0 select: the collector takes nothing")
            foreignCollector()
        elseif name == ROUTINE_ATOMIC_LOAD then
            -- The sequentially consistent word at base (x0) plus
            -- offset (x1).
            assert(not tail and nargs == 2, "S0 select: an atomic load takes base and offset")
            emit(arm.add_reg(64, 16, 0, 1, 0))
            emit(arm.ldar(0, 16))
        elseif name == ROUTINE_ATOMIC_CAS then
            -- Base (x0) plus offset (x1): replaced by x3 when it
            -- is x2; x0 answers the word it was.
            assert(not tail and nargs == 4, "S0 select: a compare-and-swap takes four words")
            emit(arm.add_reg(64, 16, 0, 1, 0))
            emit(arm.mov_reg(64, 0, 2))
            emit(arm.casal(0, 3, 16))
        elseif name:sub(1, #ROUTINE_CELLS) == ROUTINE_CELLS then
            assert(not tail and nargs == 0, "S0 select: the symbol table takes nothing")
            emit(arm.ldr(8, 0, 22, (tonumber(name:sub(#ROUTINE_CELLS + 1)) as integer) * 8))
        else
            if not indirect then
                symbolic(selector.IMPORT_LOAD, name)
            end
            emit(tail and arm.br(16) or arm.blr(16))
        end
        popStack(stackBytes)
        if not tail then
            emit(arm.ldr(8, 30, 23, 0))
        end
        -- What the call may clobber is stale.
        for _, value in ipairs(tail and {} or track.saved) do
            if signature.convention == ir.INTERNAL or not moveTarget.preservedC[allocationLocation[value]] then
                track.current[value] = nil
            end
        end
        if not tail and second ~= 0 then
            assert(
                result ~= 0 and not ir.isFloat(kind) and not ir.isFloat(f.kind2[at]),
                "S0 select: paired call requires integers"
            )
            save(1, stageBase);
            save(2, stageBase + 8)
            for p = 1, 2 do
                local value = p == 1 and result or second
                rd = destination(value)
                restore(rd + 1, stageBase + (p - 1) * 8)
                finish(value, rd)
            end
        elseif not tail and result ~= 0 then
            rd = destination(result)
            -- Nupp code answers a narrow result extended, as finish leaves
            -- it.
            local internal = signature.convention == ir.INTERNAL
            if rd ~= 0 or not internal then
                emit(ir.isFloat(kind) and arm.fmov(bits(kind), rd, 0) or arm.mov_reg(machine(kind), rd, 0))
            end
            finish(result, rd, internal)
        end
    end

    track.emitted, track.reached = helpers.emittedBlocks(f, a)
    local uses, immediates, immediateArgs, omitted, recipes = prepare(f, a.used, a.location, track.reached)
    track.uses = uses
    track.named = helpers.namedPredecessors(f, track.reached)
    -- Which saved values each block leaves current (`current`): a block
    -- starts with what all its predecessors leave (entryState).
    track.predecessors = #track.saved > 0 and helpers.predecessorsOf(f) or {}
    for order, block in ipairs(track.emitted) do
        local nextBlock = track.emitted[order + 1] or 0
        local fusedCondition: integer = -1
        code.blockWord[block] = #code.words + 1
        if #track.saved > 0 and track.lazy then
            -- Every predecessor left what is live here in its registers.
            track.current, track.stored = {}, {}
            for _, value in ipairs(track.saved) do
                track.current[value] = true
            end
        elseif #track.saved > 0 then
            track.current = helpers.entryState(track.predecessors[block], track.exits)
            for p = f.firstParam[block], f.firstParam[block] + f.nparams[block] - 1 do
                if a.used[f.params[p]] ~= false then
                    hold(f.params[p], true)
                end
            end
        end
        for at = f.blockStart[block], f.blockEnd[block] do
            local before = #code.words
            local op, result, kind = colOp[at], f.result[at], f.kind[at]
            local recipe = recipes[at]
            local args = recipe or colArgs
            local firstArg, nargs = recipe and 4 or f.firstArg[at], recipe and #recipe - 3 or f.nargs[at]
            if omitted[at] then
                op, nargs = ICONST, 0
            end
            local immediate, immediateArg = immediates[at], immediateArgs[at] or 0
            local fused = op == ICMP
                and at < f.blockEnd[block]
                and colOp[at + 1] == BRIF
                and colArgs[f.firstArg[at + 1]] == result
                and uses[result] == 1
            borrowedCount, occupiedStamp, usedStamp = 0, occupiedStamp + 1, usedStamp + 1
            for p = firstArg, firstArg + nargs - 1 do
                local value = args[p]
                if allocationLocation[value] > 0 then
                    occupied[allocationLocation[value]] = occupiedStamp
                end
            end
            if result ~= 0 and allocationLocation[result] > 0 then
                occupied[allocationLocation[result]] = occupiedStamp
            end
            local second = f.result2[at]
            if second ~= 0 and allocationLocation[second] > 0 then
                occupied[allocationLocation[second]] = occupiedStamp
            end
            local rd: integer = 0
            local _ = switch op do
                case JUMP -> do
                    helpers.holdLive(a, track.lazy, hold, block)
                    helpers.holdEdge(f, a, hold, f.firstEdge[at])
                    edge(f.firstEdge[at], nextBlock)
                    yield true
                end
                case BRIF -> do
                    local condition = fusedCondition
                    if condition < 0 then
                        local value = source(colArgs[firstArg])
                        emit(arm.cmp_imm(32, value, 0, 0))
                        condition = target.NE
                        finish(0, 0)
                    end
                    -- Only loads restore borrowed scratch after CMP; flags survive.
                    -- The final edge can fall through, after its own parallel moves.
                    local first, last = f.firstEdge[at], f.firstEdge[at] + 1
                    helpers.holdLive(a, track.lazy, hold, block)
                    helpers.holdEdge(f, a, hold, first)
                    helpers.holdEdge(f, a, hold, last)
                    -- A chained compare's flags reach its branch directly:
                    -- a reload between would run on the chained path too.
                    assert(
                        track.chained == 0 or track.chained == #code.words,
                        "S0 select: a reload between a conditional compare and its branch"
                    )
                    track.chained = 0
                    local skip = condition ~ 1
                    if f.edgeTarget[first] == nextBlock and f.edgeTarget[last] ~= nextBlock then
                        first, last, skip = last, first, condition
                    end
                    -- An edge that moves nothing is a conditional branch.
                    if a.nmoves[last] == 0 and a.nmoves[first] ~= 0 and f.edgeTarget[last] ~= nextBlock then
                        first, last, skip = last, first, skip ~ 1
                    end
                    if a.nmoves[first] == 0 then
                        localWord[#localWord + 1] = #code.words + 1
                        localBlock[#localBlock + 1] = f.edgeTarget[first] | (((skip ~ 1) + 1) << 32)
                        emit(arm.b_cond(skip ~ 1, 0))
                        edge(last, nextBlock)
                    else
                        local branch = #code.words + 1
                        emit(arm.b_cond(skip, 0))
                        edge(first, 0)
                        code.words[branch] = arm.b_cond(skip, (#code.words + 1 - branch) * 4)
                        edge(last, nextBlock)
                    end
                    fusedCondition = -1
                    yield true
                end
                case RETURN -> do
                    assert(nargs <= 2, "S0 select: multiple return values")
                    local sources, destinations, kinds = transportSources, transportDestinations, transportKinds
                    for p = 1, nargs do
                        local value = args[firstArg + p - 1]
                        assert(
                            nargs == 1 or not ir.isFloat(colValueKinds[value]),
                            "S0 select: paired return requires integers"
                        )
                        sources[
                            p
                        ], destinations[p], kinds[p] = allocationLocation[value], ir.isFloat(colValueKinds[value])
                            and 65
                            or p, colValueKinds[value]
                    end
                    for p = 1, nargs do
                        hold(args[firstArg + p - 1], false)
                    end
                    transport(nargs)
                    emit(arm.ret(30))
                    yield true
                end
                case TRAP -> emit(arm.brk(colImm[at]))
                case CALL, CALL_INDIRECT, RETURN_CALL, RETURN_CALL_INDIRECT -> selectCall(at, op, args, firstArg, nargs)
                else -> do
                    for p = 1, nargs do
                        local value = args[firstArg + p - 1]
                        regs[p] = p == immediateArg and 0 or source(value)
                    end
                    if result ~= 0 and not fused and not omitted[at] then
                        rd = destination(result)
                    end
                    local width = machine(kind)
                    track.extended = false
                    local x, y, z = nargs >= 1 and regs[1]
                        or 0, nargs >= 2 and regs[2]
                        or 0, nargs >= 3 and regs[3]
                        or 0
                    local _ = switch op do
                        case ICONST -> do
                            if not omitted[at] then
                                constant(
                                    rd,
                                    colImm[at] & ((1 << bits(kind)) - 1 | (bits(kind) == 64 and -1 or 0)),
                                    width
                                )
                                track.extended = true
                            end
                            yield true
                        end
                        case FCONST -> do
                            local temp = temporary(false)
                            constant(temp, colImm[at], bits(kind));
                            emit(arm.fmov_from_int(bits(kind), rd, temp))
                            yield true
                        end
                        case STACK_ADDR -> addOffset(rd, 23, code.stackOffsets[f.aux[at]] + colImm[at])
                        case IADD, ISUB -> do
                            if recipe and recipe[1] == IMUL then
                                emit(op == IADD and arm.madd(width, rd, x, y, z) or arm.msub(width, rd, x, y, z))
                            elseif immediate ~= nil then
                                local amount = immediate < 0 and -immediate or immediate
                                local shifted = amount > 4095 and 1 or 0
                                local encoded = shifted == 1 and amount >> 12 or amount
                                local base = immediateArg == 1 and y or x
                                emit(
                                    (op == ISUB) ~= (immediate < 0) and arm.sub_imm(width, rd, base, encoded, shifted)
                                    or arm.add_imm(width, rd, base, encoded, shifted)
                                )
                            else
                                emit(
                                    op == IADD and arm.add_reg(width, rd, x, y, recipe and recipe[2] or 0)
                                    or arm.sub_reg(width, rd, x, y, recipe and recipe[2] or 0)
                                )
                            end
                            yield true
                        end
                        case IMUL -> do
                            if immediate ~= nil then
                                local base = immediateArg == 1 and y or x
                                emit(arm.ubfm(width, rd, base, -immediate & (width - 1), width - 1 - immediate))
                            else
                                emit(arm.madd(width, rd, x, y, 31))
                            end
                            yield true
                        end
                        case UMULHI, SMULHI -> do
                            assert(width == 64, "S0 select: narrow multiply-high unsupported")
                            emit(op == UMULHI and arm.umulh(rd, x, y) or arm.smulh(rd, x, y))
                            yield true
                        end
                        case BAND, BOR, BXOR -> do
                            if recipe then
                                emit(arm.ubfm(width, rd, x, recipe[2], recipe[3]))
                                yield true
                            end
                            local n: integer = -1
                            local r: integer = 0
                            local s: integer = 0
                            local operand = immediateArg == 1 and y or x
                            if immediate ~= nil then
                                n, r, s = logical(immediate, width)
                            end
                            if n >= 0 then
                                emit(
                                    op == BAND and arm.and_imm(width, rd, operand, n, r, s)
                                    or op == BOR and arm.orr_imm(width, rd, operand, n, r, s)
                                    or arm.eor_imm(width, rd, operand, n, r, s)
                                )
                            else
                                emit(
                                    op == BAND and arm.and_reg(width, rd, x, y)
                                    or op == BOR and arm.orr_reg(width, rd, x, y)
                                    or arm.eor_reg(width, rd, x, y)
                                )
                            end
                            yield true
                        end
                        case BNOT -> emit(arm.mvn(width, rd, x))
                        case ISHL, USHR, SSHR -> do
                            if bits(kind) < 32 then
                                local temp = temporary(false)
                                emit(arm.ubfm(32, temp, y, 0, kind == ir.I8 and 2 or 3));
                                y = temp
                                if op == SSHR then
                                    local signed = temporary(false);
                                    emit(arm.sbfm(32, signed, x, 0, bits(kind) - 1));
                                    x = signed
                                end
                            end
                            if immediate ~= nil then
                                local rotation = op == ISHL and (-immediate & (width - 1)) or immediate
                                local last = op == ISHL and width - 1 - immediate or width - 1
                                emit(
                                    op == SSHR and arm.sbfm(width, rd, x, rotation, last)
                                    or arm.ubfm(width, rd, x, rotation, last)
                                )
                            else
                                emit(
                                    op == ISHL and arm.lslv(width, rd, x, y)
                                    or op == USHR and arm.lsrv(width, rd, x, y)
                                    or arm.asrv(width, rd, x, y)
                                )
                            end
                            yield true
                        end
                        case POPCNT -> do
                            local t = temporary(false)
                            emit(arm.ubfm(width, t, x, 1, width - 1))
                            emit(arm.and_imm(width, t, t, 0, 0, 60))
                            emit(arm.sub_reg(width, rd, x, t, 0))
                            emit(arm.ubfm(width, t, rd, 2, width - 1))
                            emit(arm.and_imm(width, t, t, 0, 0, 57))
                            emit(arm.and_imm(width, rd, rd, 0, 0, 57))
                            emit(arm.add_reg(width, rd, rd, t, 0))
                            emit(arm.ubfm(width, t, rd, 4, width - 1))
                            emit(arm.add_reg(width, rd, rd, t, 0))
                            emit(arm.and_imm(width, rd, rd, 0, 0, 51))
                            constant(t, width == 64 and 0x0101010101010101 or 0x01010101, width)
                            emit(arm.madd(width, rd, rd, t, 31));
                            emit(arm.ubfm(width, rd, rd, width - 8, width - 1))
                            yield true
                        end
                        case UDIV, SDIV, UREM, SREM -> do
                            local signed = op == SDIV or op == SREM
                            if signed and bits(kind) < 32 then
                                local tx, ty = temporary(false), temporary(false)
                                emit(arm.sbfm(32, tx, x, 0, bits(kind) - 1));
                                emit(arm.sbfm(32, ty, y, 0, bits(kind) - 1));
                                x, y = tx, ty
                            end
                            emit(arm.cbnz(width, y, 8));
                            emit(arm.brk(1))
                            if op == SDIV then
                                local t = temporary(false)
                                constant(t, 1 << (bits(kind) - 1), width)
                                if bits(kind) < 32 then
                                    emit(arm.sbfm(32, t, t, 0, bits(kind) - 1))
                                end
                                emit(arm.cmp_reg(width, x, t));
                                local skip = #code.words + 1;
                                emit(arm.b_cond(target.NE, 0))
                                constant(t, -1, width);
                                emit(arm.cmp_reg(width, y, t));
                                emit(arm.b_cond(target.NE, 8));
                                emit(arm.brk(2))
                                code.words[skip] = arm.b_cond(target.NE, (#code.words + 1 - skip) * 4)
                            end
                            local quotient = (op == UREM or op == SREM) and temporary(false) or rd
                            emit(signed and arm.sdiv(width, quotient, x, y) or arm.udiv(width, quotient, x, y))
                            if quotient ~= rd then
                                emit(arm.msub(width, rd, quotient, y, x))
                            end
                            yield true
                        end
                        case ICMP -> do
                            local condition = f.aux[at]
                            local operandKind = colValueKinds[colArgs[firstArg]]
                            local w = machine(operandKind)
                            if condition >= SIGNED_LT and condition <= SIGNED_GE and bits(operandKind) < 32 then
                                local tx, ty = temporary(false), temporary(false)
                                emit(arm.sbfm(32, tx, x, 0, bits(operandKind) - 1));
                                emit(arm.sbfm(32, ty, y, 0, bits(operandKind) - 1));
                                x, y = tx, ty
                            end
                            local cc = assert(integerConditions[condition], "S0 select: integer comparison")
                            -- A block whose first act is this test, entered
                            -- only by falling through from a branch to where
                            -- this test may branch too, chains it: that branch
                            -- goes, and this compares only when it would not
                            -- have been taken, else sets flags that go there.
                            -- Blocks that selected nothing between (a jump
                            -- that falls through) are passed through, each
                            -- entered by that fall alone.
                            local pending = #localBlock > 0 and localBlock[#localBlock] or 0
                            local toTaken: integer = 0
                            local alone = true
                            local back = order
                            while back >= 1 and code.blockWord[track.emitted[back]] == #code.words + 1 do
                                alone = alone and track.named[track.emitted[back]] == 1
                                back = back - 1
                            end
                            if fused
                                and alone
                                and code.blockWord[block] == #code.words + 1
                                and localWord[#localWord] == #code.words
                                and (pending >> 32) > 0
                                and (immediate == nil or immediate >= 0 and immediate < 32)
                            then
                                local edges = f.firstEdge[at + 1]
                                local into = pending & 0xffffffff
                                if f.edgeTarget[edges] == into and f.edgeTarget[edges + 1] ~= into then
                                    toTaken = edges
                                elseif f.edgeTarget[edges + 1] == into and f.edgeTarget[edges] ~= into then
                                    toTaken = edges + 1
                                end
                                if toTaken ~= 0 and a.nmoves[toTaken] ~= 0 then
                                    toTaken = 0
                                end
                            end
                            if toTaken ~= 0 then
                                local unless = ((pending >> 32) - 1) ~ 1
                                local flags = holdingFlags[toTaken == f.firstEdge[at + 1] and cc or cc ~ 1]
                                code.words[#code.words] = nil
                                localWord[#localWord], localBlock[#localBlock] = nil, nil
                                code.blockWord[block] = #code.words + 1
                                emit(
                                    immediate ~= nil and arm.ccmp_imm(w, x, immediate, flags, unless)
                                    or arm.ccmp_reg(w, x, y, flags, unless)
                                )
                                track.chained = #code.words
                            elseif immediate ~= nil then
                                emit(
                                    arm.cmp_imm(
                                        w,
                                        x,
                                        immediate > 4095 and immediate >> 12 or immediate,
                                        immediate > 4095 and 1 or 0
                                    )
                                )
                            else
                                emit(arm.cmp_reg(w, x, y))
                            end
                            if fused then
                                fusedCondition = cc
                            else
                                emit(arm.cset(32, rd, cc))
                                track.extended = true
                            end
                            yield true
                        end
                        case FCMP -> do
                            local condition = f.aux[at]
                            emit(arm.fcmp(bits(colValueKinds[colArgs[firstArg]]), x, y))
                            local cc = floatConditions[condition]
                            track.extended = true
                            if cc ~= nil then
                                emit(arm.cset(32, rd, cc))
                            elseif condition == UNORDERED_EQ then
                                local t = temporary(false)
                                emit(arm.cset(32, t, target.VS));
                                emit(arm.cset(32, rd, target.EQ));
                                emit(arm.orr_reg(32, rd, rd, t))
                            elseif condition == ORDERED_NE or condition == LESS_GREATER then
                                emit(arm.cset(32, rd, target.NE));
                                emit(arm.csel(32, rd, rd, 31, target.VC))
                            else
                                error("S0 select: float comparison")
                            end
                            yield true
                        end
                        case SELECT -> do
                            emit(arm.cmp_imm(32, x, 0, 0))
                            emit(
                                ir.isFloat(kind) and arm.fcsel(bits(kind), rd, y, z, target.NE)
                                or arm.csel(width, rd, y, z, target.NE)
                            )
                            yield true
                        end
                        case IREDUCE, UEXTEND, SEXTEND -> do
                            local from = bits(colValueKinds[colArgs[firstArg]])
                            local retained = math.min(from, bits(kind))
                            emit(
                                op == SEXTEND and arm.sbfm(width, rd, x, 0, retained - 1)
                                or arm.ubfm(width, rd, x, 0, retained - 1)
                            )
                            track.extended = op ~= SEXTEND
                            yield true
                        end
                        case BITCAST -> do
                            local from = colValueKinds[colArgs[firstArg]]
                            assert(bits(from) == bits(kind), "S0 select: bitcast width")
                            if ir.isFloat(kind) == ir.isFloat(from) then
                                emit(ir.isFloat(kind) and arm.fmov(bits(kind), rd, x) or arm.mov_reg(width, rd, x))
                            else
                                emit(
                                    ir.isFloat(kind) and arm.fmov_from_int(bits(kind), rd, x)
                                    or arm.fmov_to_int(bits(kind), rd, x)
                                )
                            end
                            yield true
                        end
                        case FPROMOTE, FDEMOTE -> emit(
                            arm.fcvt(bits(kind), bits(colValueKinds[colArgs[firstArg]]), rd, x)
                        )
                        case FADD -> emit(arm.fadd(bits(kind), rd, x, y))
                        case FSUB -> emit(arm.fsub(bits(kind), rd, x, y))
                        case FMUL -> emit(arm.fmul(bits(kind), rd, x, y))
                        case FDIV -> emit(arm.fdiv(bits(kind), rd, x, y))
                        case FNEG -> emit(arm.fneg(bits(kind), rd, x))
                        case FABS -> emit(arm.fabs(bits(kind), rd, x))
                        case SQRT -> emit(arm.fsqrt(bits(kind), rd, x))
                        case FLOOR -> emit(arm.frintm(bits(kind), rd, x))
                        case CEIL -> emit(arm.frintp(bits(kind), rd, x))
                        case FMA -> emit(arm.fmadd(bits(kind), rd, x, y, z))
                        case FCVT_FROM_SINT, FCVT_FROM_UINT -> do
                            local from = colValueKinds[colArgs[firstArg]]
                            if op == FCVT_FROM_SINT and bits(from) < 32 then
                                local t = temporary(false);
                                emit(arm.sbfm(32, t, x, 0, bits(from) - 1));
                                x = t
                            end
                            local convert = op == FCVT_FROM_SINT and arm.scvtf or arm.ucvtf
                            emit(convert(bits(kind), machine(from), rd, x))
                            yield true
                        end
                        case FCVT_TO_SINT_SAT, FCVT_TO_UINT_SAT -> do
                            assert(bits(kind) >= 32, "S0 select: narrow saturating conversion unsupported")
                            local convert = op == FCVT_TO_SINT_SAT and arm.fcvtzs or arm.fcvtzu
                            emit(convert(bits(colValueKinds[colArgs[firstArg]]), width, rd, x))
                            yield true
                        end
                        case LOAD, SLOAD, STORE -> do
                            local store = op == STORE
                            local valueKind = store and colValueKinds[args[firstArg]] or kind
                            local bytes = (f.aux[at] ~= 0 and f.aux[at] or bits(valueKind)) // 8
                            local address, value = store and y or x, store and x or rd
                            local offset = recipe and recipe[2] or colImm[at]
                            if offset < 0 or offset % bytes ~= 0 or offset // bytes >= 4096 then
                                local temp = temporary(false)
                                constant(temp, offset, 64);
                                emit(arm.add_reg(64, temp, address, temp, 0));
                                address, offset = temp, 0
                            end
                            if recipe and recipe[1] == IMUL then
                                emit(arm.memory64(store, value, address, store and z or y))
                            elseif ir.isFloat(valueKind) then
                                local memory = store and arm.str_fp or arm.ldr_fp
                                emit(memory(bits(valueKind), value, address, offset))
                            elseif store then
                                emit(arm.str(bytes, value, address, offset))
                            elseif op == SLOAD and bytes == 4 and machine(valueKind) == 64 then
                                emit(arm.ldrsw(value, address, offset))
                            elseif op == LOAD
                                and bytes == 8
                                and helpers.paired(code.words, code.blockWord[block], value, address, offset)
                            then
                                track.extended = true
                            else
                                emit(arm.ldr(bytes, value, address, offset))
                                if op == SLOAD then
                                    emit(arm.sbfm(machine(valueKind), value, value, 0, bytes * 8 - 1))
                                else
                                    track.extended = bytes * 8 <= bits(valueKind)
                                end
                            end
                            yield true
                        end
                        else -> error("S0 select: unsupported operation " .. tostring(ir.opNames[op]))
                    end
                    finish((fused or omitted[at]) and 0 or result, rd, track.extended)
                    yield true
                end
            end
            code.opCounts[colOp[at]] = code.opCounts[colOp[at]] + 1
            code.opWords[colOp[at]] = code.opWords[colOp[at]] + #code.words - before
        end
        track.exits[block] = track.current
    end
    local redirects: {[integer]: integer} = {}
    -- A block that only jumps on, moving nothing, is skipped: branches to it
    -- go where it goes. One that stores its parameters on entry is not.
    for order = #track.emitted, 1, -1 do
        local block = track.emitted[order]
        local at = f.blockStart[block]
        local edge = f.firstEdge[at]
        local after = order < #track.emitted and code.blockWord[track.emitted[order + 1]] or #code.words + 1
        if at == f.blockEnd[block]
            and colOp[at] == JUMP
            and a.nmoves[edge] == 0
            and (
                after == code.blockWord[block]
                or after == code.blockWord[block] + 1 and code.words[code.blockWord[block]] & 0xfc000000 == 0x14000000
            )
        then
            local targetBlock = f.edgeTarget[edge]
            redirects[block] = redirects[targetBlock] or targetBlock
        end
    end
    for p, word in ipairs(localWord) do
        local block, condition = localBlock[p] & 0xffffffff, (localBlock[p] >> 32) - 1
        local offset = (code.blockWord[redirects[block] or block] - word) * 4
        code.words[word] = condition < 0 and arm.b(offset) or arm.b_cond(condition, offset)
    end

    return code
end

export = selector
