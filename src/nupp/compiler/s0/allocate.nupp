module nupp.compiler.s0.allocate

local ir = require("nupp.compiler.s0.ir")
local allocate = {}

record allocate.Target
    integerRegisters: {integer}
    floatRegisters: {integer}
    preservedInternal: {boolean}
    preservedC: {boolean}
    scratchInt: integer
    scratchFloat: integer
    -- A value live across a call that clobbers its register keeps that
    -- register and a save slot (Allocation.saveSlot), which the selector
    -- writes at its definition and reloads after such a call; without this,
    -- the value is spilled for its whole life.
    saveAcrossCalls: boolean?
    -- Where each argument of the convention goes (allocator IDs), to hint
    -- the values that a call takes, a function receives or a return gives.
    integerArguments: {integer}?
    floatArguments: {integer}?
end

record allocate.Allocation
    start: {integer}
    finish: {integer}
    location: {integer}
    acrossInternal: {boolean}
    acrossC: {boolean}
    rematerialize: {integer}
    instructionPosition: {integer}
    blockEntry: {integer}
    blockExit: {integer}
    blockOrder: {integer}
    firstMove: {integer}
    nmoves: {integer}
    moveSource: {integer}
    moveTarget: {integer}
    moveKind: {integer}
    spillKinds: {integer}
    spillValues: {integer}
    spillSlots: integer
    -- A register-allocated value's save slot (spill numbering), or 0.
    saveSlot: {integer}
    -- Whether a block parameter is read anywhere; an edge does not move a
    -- value into one that is not.
    used: {boolean}
    -- The values live across each call, by its instruction, and live at the
    -- end of each block: where a value with a save slot is stored and
    -- reloaded when the selector saves it lazily.
    callLive: {[integer]: {integer}}
    liveOut: {{integer}}
    -- Where each value is live, by dataflow (crossings): pairs of first and
    -- last positions, in no order. Saving, values whose ranges do not meet
    -- share a register, holes in an interval included.
    ranges: {{integer}}
    conservativeBlocks: integer
    conservativeValues: integer
end

local CALL, INDIRECT = ir.opcode("call"), ir.opcode("call_indirect")
local ICONST, FCONST, ADDRESS = ir.opcode("iconst"), ir.opcode("fconst"), ir.opcode("stack_addr")

local function zeros(n: integer): {integer}
    local result: {integer} = {}
    for i = 1, n do
        result[i] = 0
    end

    return result
end

local function newAllocation(f: ir.Function): allocate.Allocation
    return allocate.Allocation(
        start = zeros(#f.valueKinds),
        finish = zeros(#f.valueKinds),
        location = zeros(#f.valueKinds),
        acrossInternal = {},
        acrossC = {},
        rematerialize = zeros(#f.valueKinds),
        instructionPosition = zeros(#f.op),
        blockEntry = zeros(#f.blockStart),
        blockExit = zeros(#f.blockStart),
        blockOrder = {},
        firstMove = {},
        nmoves = {},
        moveSource = {},
        moveTarget = {},
        moveKind = {},
        spillKinds = {},
        spillValues = {},
        conservativeBlocks = 0,
        conservativeValues = 0,
        spillSlots = 0,
        saveSlot = zeros(#f.valueKinds),
        used = {},
        callLive = {},
        liveOut = {},
        ranges = {}
    )
end

local function dominates(parent: {integer}, ancestor: integer, block: integer): boolean
    while block > ancestor do
        block = parent[block]
    end
    return block == ancestor
end

-- RPO is allocation order only: MIR instruction and block IDs never change.
-- A one-pass candidate dominator tree is checked against every CFG edge before
-- it is used. Irreducible regions conservatively overlap their live values.
local function order(f: ir.Function, a: allocate.Allocation): ({integer}, {integer}, {integer}, {integer}, {integer})
    local n = #f.blockStart
    assert(n > 0, "S0 allocation: no blocks")
    local blockOf, head, nextEdge, predecessors, nextPred = zeros(
        #f.op
    ), zeros(n), zeros(#f.edgeTarget), zeros(n), zeros(#f.edgeTarget)
    for b = 1, n do
        assert(f.blockStart[b] <= f.blockEnd[b], "S0 allocation: empty block")
        for i = f.blockStart[b], f.blockEnd[b] do
            blockOf[i] = b
        end
    end
    for e = #f.edgeTarget, 1, -1 do
        local from, to = blockOf[f.edgeFrom[e]], f.edgeTarget[e]
        assert(from > 0 and to > 0 and to <= n, "S0 allocation: invalid edge")
        nextEdge[e], head[from] = head[from], e
        nextPred[e], predecessors[to] = predecessors[to], e
    end
    local seen, post, stack, cursor = zeros(n), {}, {}, {}
    seen[1], stack[1], cursor[1] = 1, 1, head[1]
    while #stack > 0 do
        local depth, b = #stack, stack[#stack]
        local e = cursor[depth]
        if e == 0 then
            post[#post + 1] = b
            stack[depth], cursor[depth] = nil, nil
        else
            cursor[depth] = nextEdge[e]
            local to = f.edgeTarget[e]
            if seen[to] == 0 then
                seen[to] = 1
                stack[depth + 1], cursor[depth + 1] = to, head[to]
            end
        end
    end
    assert(#post == n, "S0 allocation: unreachable blocks require removal")
    local rank, parent, loopEnd = zeros(n), zeros(n), zeros(n)
    local position: integer = 0
    for r = 1, n do
        local b = post[n - r + 1]
        a.blockOrder[r], rank[b] = b, r
        a.blockEntry[b] = 2 * (position + 1) - 1
        for i = f.blockStart[b], f.blockEnd[b] do
            position = position + 1
            a.instructionPosition[i] = position
        end
        a.blockExit[b] = 2 * position
    end
    for r = 2, n do
        local candidate: integer = 0
        local e = predecessors[a.blockOrder[r]]
        while e ~= 0 do
            local p = rank[blockOf[f.edgeFrom[e]]]
            if p < r then
                if candidate == 0 then
                    candidate = p
                else
                    while candidate ~= p do
                        if candidate > p then
                            candidate = parent[candidate]
                        else
                            p = parent[p]
                        end
                    end
                end
            end
            e = nextPred[e]
        end
        assert(candidate > 0, "S0 allocation: invalid RPO")
        parent[r] = candidate
    end
    local reach, bad = zeros(n), zeros(n)
    for e = 1, #f.edgeTarget do
        local from, to = blockOf[f.edgeFrom[e]], f.edgeTarget[e]
        local r, t = rank[from], rank[to]
        if t <= r then
            reach[t] = math.max(reach[t], r)
            loopEnd[to] = math.max(loopEnd[to], a.blockExit[from])
            if not dominates(parent, t, r) then
                bad[t] = 1
            end
        end
        if t ~= 1 and not dominates(parent, parent[t], r) then
            local first, last = math.min(r, t), math.max(r, t)
            reach[first], bad[first] = math.max(reach[first], last), 1
        end
    end
    -- Merge overlapping backward-edge spans. Only spans containing an
    -- irreducible edge become conservative; natural loops keep precise ranges.
    local regionStart, regionEnd = zeros(n), zeros(n)
    local first: integer = 1
    while first <= n do
        local last: integer = math.max(first, reach[first])
        local affected = false
        local cursor: integer = first
        while cursor <= last do
            last = math.max(last, reach[cursor])
            affected = affected or bad[cursor] ~= 0
            cursor = cursor + 1
        end
        if affected then
            for r = first, last do
                local b = a.blockOrder[r]
                regionStart[b], regionEnd[b] = a.blockEntry[a.blockOrder[first]], a.blockExit[a.blockOrder[last]]
                a.conservativeBlocks = a.conservativeBlocks + 1
            end
        end
        first = last + 1
    end

    return rank, loopEnd, regionStart, regionEnd, blockOf
end

-- Sparse live-in lists share flat storage. The current block uses a stamp set;
-- there is no per-instruction object and no iterative production dataflow.
local function intervals(f: ir.Function, a: allocate.Allocation): nil
    local rank, loopEnd, regionStart, regionEnd, blockOf = order(f, a)
    local definedRegion = zeros(#f.valueKinds)
    for v = 1, #f.valueKinds do
        if f.valueKinds[v] ~= 0 then
            local d = f.definitions[v]
            a.start[v] = d < 0 and a.blockEntry[-d] or 2 * a.instructionPosition[d] + 1
            a.finish[v] = a.start[v]
            local block = d < 0 and -d or blockOf[d]
            if regionStart[block] ~= 0 then
                a.start[v], a.finish[v], definedRegion[v] = regionStart[block], regionEnd[block], regionStart[block]
                a.conservativeValues = a.conservativeValues + 1
            end
            if d > 0 and (f.op[d] == ICONST or f.op[d] == FCONST or f.op[d] == ADDRESS) then
                a.rematerialize[v] = d
            end
        end
    end
    local liveFirst, liveCount, liveValues = zeros(#f.blockStart), zeros(#f.blockStart), {}
    local stamp, present, members = zeros(#f.valueKinds), zeros(#f.valueKinds), {}
    for r = #a.blockOrder, 1, -1 do
        local b, generation = a.blockOrder[r], r
        members = {}

        local function add(v: integer, at: integer): nil
            assert(v > 0 and f.valueKinds[v] ~= 0, "S0 allocation: undefined use")
            assert(a.start[v] <= at, "S0 allocation: use precedes definition")
            a.finish[v] = math.max(a.finish[v], at, regionEnd[b])
            if stamp[v] ~= generation then
                stamp[v] = generation
                members[#members + 1] = v
            end
            present[v] = generation
        end

        for i = f.blockStart[b], f.blockEnd[b] do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                local target = f.edgeTarget[e]
                assert(f.edgeNargs[e] == f.nparams[target], "S0 allocation: edge arity")
                if rank[target] > r then
                    for p = liveFirst[target], liveFirst[target] + liveCount[target] - 1 do
                        add(liveValues[p], a.blockExit[b])
                    end
                end
                for p = 0, f.edgeNargs[e] - 1 do
                    local v, parameter = f.edgeArgs[f.edgeFirstArg[e] + p], f.params[f.firstParam[target] + p]
                    assert(f.valueKinds[v] == f.valueKinds[parameter], "S0 allocation: edge type")
                    if a.used[parameter] ~= false then
                        add(v, 2 * a.instructionPosition[i])
                    end
                end
            end
        end
        for i = f.blockEnd[b], f.blockStart[b], -1 do
            local result = f.result[i]
            if result ~= 0 then
                present[result] = 0
            end
            if f.result2[i] ~= 0 then
                present[f.result2[i]] = 0
            end
            for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                add(f.args[p], 2 * a.instructionPosition[i])
            end
        end
        for p = f.firstParam[b], f.firstParam[b] + f.nparams[b] - 1 do
            present[f.params[p]] = 0
        end
        liveFirst[b] = #liveValues + 1
        for _, v in ipairs(members) do
            local internal = regionStart[b] ~= 0
                and a.blockEntry[b] == regionStart[b]
                and definedRegion[v] == regionStart[b]
            if present[v] == generation and not internal then
                assert(a.start[v] < a.blockEntry[b], "S0 allocation: non-dominating definition")
                a.finish[v] = math.max(a.finish[v], loopEnd[b])
                liveValues[#liveValues + 1] = v
            end
        end
        liveCount[b] = #liveValues + 1 - liveFirst[b]
    end
    assert(liveCount[1] == 0, "S0 allocation: unbound entry value")
    local internal, external = zeros(2 * #f.op + 2), zeros(2 * #f.op + 2)
    internal[0], external[0] = 0, 0
    local internalCount: integer = 0
    local externalCount: integer = 0
    for _, b in ipairs(a.blockOrder) do
        for i = f.blockStart[b], f.blockEnd[b] do
            local p = 2 * a.instructionPosition[i]
            internal[p - 1], external[p - 1] = internalCount, externalCount
            if f.op[i] == CALL or f.op[i] == INDIRECT then
                local signature = f.op[i] == CALL and f.importSignatures[f.aux[i]] or f.aux[i]
                if f.signatures[signature].convention == ir.INTERNAL then
                    internalCount = internalCount + 1
                else
                    externalCount = externalCount + 1
                end
            end
            internal[p], internal[p + 1] = internalCount, internalCount
            external[p], external[p + 1] = externalCount, externalCount
        end
    end
    for v = 1, #f.valueKinds do
        a.acrossInternal[v] = f.valueKinds[v] ~= 0 and internal[a.finish[v] - 1] > internal[a.start[v]]
        a.acrossC[v] = f.valueKinds[v] ~= 0 and external[a.finish[v] - 1] > external[a.start[v]]
    end
end

local function spill(f: ir.Function, a: allocate.Allocation, v: integer): nil
    a.spillSlots = a.spillSlots + 1
    a.location[v], a.spillKinds[a.spillSlots] = -a.spillSlots, f.valueKinds[v]
    a.spillValues[a.spillSlots] = v
end

-- The registers a convention places `kinds` in, in order, for hinting:
-- 0 for one it does not place in a register.
local function placed(kinds: {integer}, target: allocate.Target, shift: integer): {integer}
    local result: {integer} = {}
    local integers, floats = target.integerArguments or {}, target.floatArguments or {}
    local ints: integer = 0
    local fps: integer = 0
    for p, kind in ipairs(kinds) do
        if ir.isFloat(kind) then
            fps = fps + 1
            result[p + shift] = floats[fps] or 0
        else
            ints = ints + 1
            result[p + shift] = integers[ints] or 0
        end
    end

    return result
end

-- Where the convention would put each value at the definitions and uses a
-- call, entry or return fixes: a register that, when free, saves a move.
local function placements(f: ir.Function, target: allocate.Target): {integer}
    local fixed = zeros(#f.valueKinds)
    if target.integerArguments == nil then
        return fixed
    end
    local entry = placed(f.signature.params, target, 0)
    for p = 0, f.nparams[1] - 1 do
        fixed[f.params[f.firstParam[1] + p]] = entry[p + 1] or 0
    end
    local integers, floats = target.integerArguments or {}, target.floatArguments or {}
    local RETURN = ir.opcode("return")
    local TAIL, TAIL_INDIRECT = ir.opcode("return_call"), ir.opcode("return_call_indirect")
    for i, op in ipairs(f.op) do
        local first = f.firstArg[i]
        if op == CALL or op == INDIRECT or op == TAIL or op == TAIL_INDIRECT then
            local indirect = op == INDIRECT or op == TAIL_INDIRECT
            local signature = f.signatures[indirect and f.aux[i] or f.importSignatures[f.aux[i]]]
            if signature.convention == ir.INTERNAL then
                local shift = indirect and 1 or 0
                local places = placed(signature.params, target, shift)
                for p = 1 + shift, f.nargs[i] do
                    local value = f.args[first + p - 1]
                    if fixed[value] == 0 then
                        fixed[value] = places[p] or 0
                    end
                end
            end
            local result = f.result[i]
            if result ~= 0 and f.result2[i] == 0 then
                fixed[result] = ir.isFloat(f.valueKinds[result]) and (floats[1] or 0) or (integers[1] or 0)
            end
        elseif op == RETURN then
            for p = 1, f.nargs[i] do
                local value = f.args[first + p - 1]
                if fixed[value] == 0 then
                    fixed[value] = ir.isFloat(f.valueKinds[value]) and (floats[1] or 0) or (integers[p] or 0)
                end
            end
        end
    end

    return fixed
end

-- Whether values `v` and `w` are live at once anywhere (Allocation.ranges).
local function overlap(a: allocate.Allocation, v: integer, w: integer): boolean
    if a.finish[w] < a.start[v] or a.finish[v] < a.start[w] then
        return false
    end
    local rv, rw = a.ranges[v], a.ranges[w]
    for i = 1, #rv, 2 do
        for j = 1, #rw, 2 do
            if rv[i] <= rw[j + 1] and rw[j] <= rv[i + 1] then
                return true
            end
        end
    end

    return false
end

-- Saving, assigns registers by where values are live rather than by
-- interval: a register holds every value whose ranges do not meet. A value
-- no register is free for takes one held by a single value that lasts
-- longer, which is spilled, or is spilled itself. Values only C calls
-- cross prefer registers they preserve; then the convention's register for
-- them (`fixed`) and the one the value they copy is in (`hint`).
local function shared(
    f: ir.Function,
    a: allocate.Allocation,
    target: allocate.Target,
    values: {integer},
    hint: {integer},
    fixed: {integer}
): nil
    local held: {[integer]: {integer}} = {}
    for _, v in ipairs(values) do
        local list = ir.isFloat(f.valueKinds[v]) and target.floatRegisters or target.integerRegisters
        local copied = hint[v] ~= 0 and a.location[hint[v]] or 0
        local keep = a.acrossC[v] and not a.acrossInternal[v]
        local selected: integer = 0
        local rank: integer = 0
        local victimRegister: integer = 0
        local victim: integer = 0
        for _, reg in ipairs(list) do
            local holders = held[reg] or {}
            held[reg] = holders
            -- What ended before this value starts never meets a later one.
            local kept: integer = 0
            for _, w in ipairs(holders) do
                if a.finish[w] >= a.start[v] and a.location[w] == reg then
                    kept = kept + 1
                    holders[kept] = w
                end
            end
            for p = #holders, kept + 1, -1 do
                holders[p] = nil
            end
            local conflict: integer = 0
            local conflicts: integer = 0
            for _, w in ipairs(holders) do
                if overlap(a, v, w) then
                    conflict, conflicts = w, conflicts + 1
                end
            end
            if conflicts == 0 then
                local score: integer = 1
                if keep and target.preservedC[reg] then
                    score = 4
                elseif reg == fixed[v] then
                    score = 3
                elseif reg == copied then
                    score = 2
                end
                if score > rank then
                    selected, rank = reg, score
                end
            elseif conflicts == 1 and (victim == 0 or a.finish[conflict] > a.finish[victim]) then
                victimRegister, victim = reg, conflict
            end
        end
        if selected == 0 and victim ~= 0 and a.finish[victim] > a.finish[v] then
            selected = victimRegister
            spill(f, a, victim)
        end
        if selected == 0 then
            spill(f, a, v)
        else
            a.location[v] = selected
            local holders = held[selected] as {integer}
            holders[#holders + 1] = v
        end
    end
end

local function registers(f: ir.Function, a: allocate.Allocation, target: allocate.Target): nil
    local valid, values = zeros(96), {}
    for class = 1, 2 do
        local list = class == 1 and target.integerRegisters or target.floatRegisters
        for _, reg in ipairs(list) do
            assert(
                reg > 0 and reg <= 96 and (class == 1 and reg <= 31 or class == 2 and reg >= 65),
                "S0 allocation: register class"
            )
            assert(
                valid[reg] == 0 and reg ~= target.scratchInt and reg ~= target.scratchFloat,
                "S0 allocation: duplicate or scratch register"
            )
            valid[reg] = 1
        end
    end
    assert(
        target.scratchInt >= 1 and target.scratchInt <= 31 and target.scratchFloat >= 65 and target.scratchFloat <= 96,
        "S0 allocation: scratch class"
    )
    local saving = target.saveAcrossCalls == true
    local hint = zeros(#f.valueKinds)
    for e = 1, #f.edgeTarget do
        local b = f.edgeTarget[e]
        for p = 0, f.edgeNargs[e] - 1 do
            local source, dest = f.edgeArgs[f.edgeFirstArg[e] + p], f.params[f.firstParam[b] + p]
            if hint[dest] == 0 then
                hint[dest] = source
            end
        end
    end
    for i = 1, #f.op do
        if f.result[i] ~= 0 and f.nargs[i] > 0 then
            hint[f.result[i]] = f.args[f.firstArg[i]]
        end
    end
    local fixed = placements(f, target)
    for v = 1, #f.valueKinds do
        if f.valueKinds[v] ~= 0 then
            values[#values + 1] = v
        end
    end
    table.sort(values, function(x: integer, y: integer): boolean
        return a.start[x] < a.start[y] or a.start[x] == a.start[y] and x < y
    end)
    if saving then
        shared(f, a, target, values, hint, fixed)
    end
    local occupied = zeros(96)
    for _, v in ipairs(saving and {} or values) do
        local list = ir.isFloat(f.valueKinds[v]) and target.floatRegisters or target.integerRegisters
        local selected: integer = 0
        local victim: integer = 0
        local copied = hint[v] ~= 0 and a.location[hint[v]] or 0
        local placedAt = fixed[v]
        -- Saving, a value that only C calls cross keeps a register they
        -- preserve when one is free, and needs no save then.
        local keep = saving and a.acrossC[v] and not a.acrossInternal[v]
        local rank: integer = 0
        for _, reg in ipairs(list) do
            local old = occupied[reg]
            if old ~= 0 and a.finish[old] < a.start[v] then
                occupied[reg], old = 0, 0
            end
            if saving
                or (not a.acrossInternal[v] or target.preservedInternal[reg])
                and (not a.acrossC[v] or target.preservedC[reg])
            then
                if old == 0 then
                    local score: integer = 1
                    if keep and target.preservedC[reg] then
                        score = 4
                    elseif reg == placedAt then
                        score = 3
                    elseif reg == copied then
                        score = 2
                    end
                    if score > rank then
                        selected, rank = reg, score
                    end
                elseif victim == 0 or a.finish[old] > a.finish[victim] then
                    victim = old
                end
            end
        end
        if selected == 0 and victim ~= 0 and a.finish[victim] > a.finish[v] then
            selected = a.location[victim]
            spill(f, a, victim)
        end
        if selected == 0 then
            spill(f, a, v)
        else
            a.location[v], occupied[selected] = selected, v
        end
    end
    if saving then
        for _, v in ipairs(values) do
            local location = a.location[v]
            if location > 0
                and (
                    a.acrossInternal[v] and not target.preservedInternal[location]
                    or a.acrossC[v] and not target.preservedC[location]
                )
            then
                a.spillSlots = a.spillSlots + 1
                a.spillKinds[a.spillSlots], a.spillValues[a.spillSlots] = f.valueKinds[v], v
                a.saveSlot[v] = a.spillSlots
            end
        end
    end
end

local function slot(location: integer): integer
    return location > 0 and location or 96 - location
end

record allocate.MoveWorkspace
    counts: {integer}
    writer: {integer}
    pending: {boolean}
    queue: {integer}
    readers: {integer}
    nextReader: {integer}
end

function allocate.workspace(): allocate.MoveWorkspace
    return allocate.MoveWorkspace(counts = {}, writer = {}, pending = {}, queue = {}, readers = {}, nextReader = {})
end

local function appendMove(a: allocate.Allocation, source: integer, destination: integer, kind: integer): nil
    a.moveSource[
        #a.moveSource + 1
    ], a.moveTarget[#a.moveTarget + 1], a.moveKind[#a.moveKind + 1] = source, destination, kind
end

-- Inputs and outputs are parallel assignments. A destination becomes ready when
-- no pending assignment reads it. Breaking a cycle saves one source in scratch.
function allocate.parallel(
    source: {integer},
    destination: {integer},
    kinds: {integer},
    target: allocate.Target,
    a: allocate.Allocation,
    workspace: allocate.MoveWorkspace?
): nil
    local counts: {integer}
    local writer: {integer}
    local pending: {boolean}
    local queue: {integer}
    local readers: {integer}
    local nextReader: {integer}
    if workspace ~= nil then
        counts, writer, pending, queue = workspace.counts, workspace.writer, workspace.pending, workspace.queue
        readers, nextReader = workspace.readers, workspace.nextReader
    else
        counts, writer, pending, queue, readers, nextReader = {}, {}, {}, {}, {}, {}
    end
    -- Only current source/destination locations and scratch can be inspected.
    -- Reset their entries; all other backing capacity remains reusable.
    for i = 1, #source do
        local s, d = slot(source[i]), slot(destination[i])
        counts[s], counts[d], writer[s], writer[d], readers[s], readers[d], pending[i] = 0, 0, 0, 0, 0, 0, false
    end
    for class = 1, 2 do
        local scratch = slot(class == 1 and target.scratchInt or target.scratchFloat)
        counts[scratch], writer[scratch], readers[scratch] = 0, 0, 0
    end
    local queued: integer = 0
    local remaining = 0
    for i = 1, #source do
        assert(source[i] ~= 0 and destination[i] ~= 0, "S0 allocation: invalid move location")
        if source[i] ~= destination[i] then
            local s, d = slot(source[i]), slot(destination[i])
            assert(writer[d] == 0, "S0 allocation: duplicate move destination")
            counts[s], writer[d], pending[i] = counts[s] + 1, i, true
            nextReader[i], readers[s] = readers[s], i
            remaining = remaining + 1
        end
    end
    for i = 1, #source do
        if pending[i] and counts[slot(destination[i])] == 0 then
            queued = queued + 1
            queue[queued] = i
        end
    end
    local read: integer = 1
    local first: integer = 1

    while remaining > 0 do
        if read <= queued then
            local i = queue[read]
            read = read + 1
            if pending[i] then
                appendMove(a, source[i], destination[i], kinds[i])
                pending[i], remaining = false, remaining - 1
                local s = slot(source[i])
                counts[s] = counts[s] - 1
                local dependent = writer[s]
                if counts[s] == 0 and dependent ~= 0 and pending[dependent] then
                    queued = queued + 1
                    queue[queued] = dependent
                end
            end
        else
            while not pending[first] do
                first = first + 1
            end
            local saved = source[first]
            local scratch = ir.isFloat(kinds[first]) and target.scratchFloat or target.scratchInt
            appendMove(a, saved, scratch, kinds[first])
            local i = readers[slot(saved)]
            while i ~= 0 do
                if pending[i] then
                    source[i] = scratch
                end
                i = nextReader[i]
            end
            counts[slot(scratch)], counts[slot(saved)] = counts[slot(saved)], 0
            local dependent = writer[slot(saved)]
            assert(dependent ~= 0 and pending[dependent], "S0 allocation: invalid move cycle")
            queued = queued + 1
            queue[queued] = dependent
        end
    end
end

-- Whether each block parameter is read: by an instruction, or by an edge
-- into a parameter that is. False marks one nothing reads.
local function usedParameters(f: ir.Function): {boolean}
    local used: {boolean} = {}
    for i = 1, #f.op do
        for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
            used[f.args[p]] = true
        end
    end
    local changed = true
    while changed do
        changed = false
        for e = 1, #f.edgeTarget do
            local first = f.firstParam[f.edgeTarget[e]]
            for p = 0, f.edgeNargs[e] - 1 do
                local value = f.edgeArgs[f.edgeFirstArg[e] + p]
                if used[f.params[first + p]] and not used[value] then
                    used[value], changed = true, true
                end
            end
        end
    end
    local result: {boolean} = {}
    for _, parameter in ipairs(f.params) do
        result[parameter] = used[parameter] == true
    end

    return result
end

local IADD, ISUB, IMUL = ir.opcode("iadd"), ir.opcode("isub"), ir.opcode("imul")
local BAND, BOR, BXOR = ir.opcode("band"), ir.opcode("bor"), ir.opcode("bxor")
local ISHL, USHR, SSHR = ir.opcode("ishl"), ir.opcode("ushr"), ir.opcode("sshr")

local BRIF, JUMP = ir.opcode("brif"), ir.opcode("jump")

-- Threads edges through blocks that only branch on one of their parameters
-- (`and`/`or` conditions merge that way): an edge carrying the branch it
-- leaves by's own condition into such a block knows where it goes, and goes
-- there; a jump into one becomes the branch itself. `resolved` names values
-- through the aliases made so far. A jump's old edge stays in the columns,
-- named by no instruction.
local function thread(f: ir.Function, resolved: function(integer): integer): nil
    local blockOf: {integer} = {}
    for b, start in ipairs(f.blockStart) do
        for i = start, f.blockEnd[b] do
            blockOf[i] = b
        end
    end

    -- The parameter position block `b` branches on, if that is all it does.
    local function tested(b: integer): integer
        local i = f.blockStart[b]
        if i ~= f.blockEnd[b] or f.op[i] ~= BRIF or b == 1 then
            return -1
        end
        local condition = resolved(f.args[f.firstArg[i]])
        for p = 0, f.nparams[b] - 1 do
            if f.params[f.firstParam[b] + p] == condition then
                return p
            end
        end

        return -1
    end

    -- Appends the arguments of block `m`'s edge `taken` as edge `e` (into
    -- `m`) supplies them: `m`'s parameters become what `e` passes for them.
    local function compose(e: integer, m: integer, taken: integer): (integer, integer)
        local first = #f.edgeArgs + 1
        for p = 0, f.edgeNargs[taken] - 1 do
            local value = resolved(f.edgeArgs[f.edgeFirstArg[taken] + p])
            for q = 0, f.nparams[m] - 1 do
                if f.params[f.firstParam[m] + q] == value then
                    value = resolved(f.edgeArgs[f.edgeFirstArg[e] + q])
                end
            end
            f.edgeArgs[#f.edgeArgs + 1] = value
        end

        return first, f.edgeNargs[taken]
    end

    local changed = true
    local rounds: integer = 0
    while changed and rounds < 8 do
        changed, rounds = false, rounds + 1
        for i, op in ipairs(f.op) do
            if op == BRIF then
                local condition = resolved(f.args[f.firstArg[i]])
                for side = 0, 1 do
                    local e = f.firstEdge[i] + side
                    local m = f.edgeTarget[e]
                    local position = tested(m)
                    if m ~= blockOf[i]
                        and position >= 0
                        and resolved(f.edgeArgs[f.edgeFirstArg[e] + position]) == condition
                    then
                        -- The condition holds on the first edge and fails on the
                        -- second.
                        local taken = f.firstEdge[f.blockStart[m]] + side
                        local first, count = compose(e, m, taken)
                        f.edgeTarget[e], f.edgeFirstArg[e], f.edgeNargs[e] = f.edgeTarget[taken], first, count
                        changed = true
                    end
                end
            elseif op == JUMP then
                local e = f.firstEdge[i]
                local m = f.edgeTarget[e]
                local position = tested(m)
                if m ~= blockOf[i] and position >= 0 then
                    local branch = f.blockStart[m]
                    local edges = #f.edgeTarget + 1
                    for side = 0, 1 do
                        local first, count = compose(e, m, f.firstEdge[branch] + side)
                        local at = edges + side
                        f.edgeFrom[at], f.edgeTarget[at] = i, f.edgeTarget[f.firstEdge[branch] + side]
                        f.edgeFirstArg[at], f.edgeNargs[at] = first, count
                    end
                    f.args[#f.args + 1] = resolved(f.edgeArgs[f.edgeFirstArg[e] + position])
                    f.op[i], f.firstArg[i], f.nargs[i] = BRIF, #f.args, 1
                    f.firstEdge[i], f.nedges[i] = edges, 2
                    changed = true
                end
            end
        end
    end
end

-- Forwards the operand of an operation that leaves it unchanged (adding
-- zero, multiplying by one, masking with all ones) to every use of its
-- result, and leaves the operation with no operands for the selector to drop.
function allocate.simplify(f: ir.Function): nil
    local alias: {[integer]: integer} = {}

    local function resolved(value: integer): integer
        local seen: integer = 0
        while alias[value] ~= nil do
            value, seen = alias[value] as integer, seen + 1
            assert(seen <= #f.valueKinds, "S0 allocation: alias cycle")
        end

        return value
    end

    local function literal(value: integer, width: integer): integer?
        local definition = f.definitions[value]
        if definition > 0 and f.op[definition] == ICONST then
            return f.imm[definition] & (width == 64 and -1 or 0xffffffff)
        end

        return nil
    end

    for at, op in ipairs(f.op) do
        local result = f.result[at]
        local kind = f.kind[at]
        if result ~= 0
            and f.nargs[at] == 2
            and f.result2[at] == 0
            and (kind == ir.I32 or kind == ir.I64)
            and f.valueKinds[result] == kind
        then
            local first = f.firstArg[at]
            local x, y = resolved(f.args[first]), resolved(f.args[first + 1])
            local width = kind == ir.I64 and 64 or 32
            local ones = width == 64 and -1 or 0xffffffff
            local lx, ly = literal(x, width), literal(y, width)
            local kept: integer = 0
            if op == IADD or op == BOR or op == BXOR then
                kept = ly == 0 and x or lx == 0 and y or 0
            elseif op == ISUB then
                kept = ly == 0 and x or 0
            elseif op == ISHL or op == USHR or op == SSHR then
                kept = ly ~= nil and ((ly as integer) & (width - 1)) == 0 and x or 0
            elseif op == BAND then
                kept = ly == ones and x or lx == ones and y or 0
            elseif op == IMUL then
                kept = ly == 1 and x or lx == 1 and y or 0
            end
            if kept ~= 0 and f.valueKinds[kept] == kind then
                alias[result] = kept
                f.nargs[at] = 0
            end
        end
    end
    thread(f, resolved)
    -- A block parameter every edge sets to one other value (or to itself)
    -- is that value, which then dominates the block: SSA construction passes
    -- each live value through every block this way.
    local changed = true
    while changed do
        changed = false
        local same: {[integer]: integer} = {}
        for e, block in ipairs(f.edgeTarget) do
            if block ~= 1 then
                for p = 0, f.edgeNargs[e] - 1 do
                    local parameter = f.params[f.firstParam[block] + p]
                    local value = resolved(f.edgeArgs[f.edgeFirstArg[e] + p])
                    local seen = same[parameter]
                    if alias[parameter] == nil and value ~= parameter and seen ~= -1 then
                        same[parameter] = (seen == nil or seen == value) and value or -1
                    end
                end
            end
        end
        for parameter, value in pairs(same) do
            if value > 0 then
                alias[parameter], changed = value, true
            end
        end
    end
    if next(alias) == nil then
        return
    end
    for p, value in ipairs(f.args) do
        f.args[p] = resolved(value)
    end
    for p, value in ipairs(f.edgeArgs) do
        f.edgeArgs[p] = resolved(value)
    end
end

-- Liveness by dataflow. It extends each interval over every block its value
-- is live out of, and finds which values a call crosses while they are live:
-- an interval spans every call between its ends, on paths that never read
-- the value again too. Saving, only these need a save slot.
local function crossings(f: ir.Function, a: allocate.Allocation): nil
    local count = #f.blockStart
    local liveIn: {{[integer]: boolean}} = {}
    local sizes: {integer} = {}
    for b = 1, count do
        liveIn[b], sizes[b] = {}, 0
    end

    -- What is live at the end of block `b`.
    local function liveOut(b: integer): {[integer]: boolean}
        local live: {[integer]: boolean} = {}
        for i = f.blockStart[b], f.blockEnd[b] do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                local target = f.edgeTarget[e]
                for v in pairs(liveIn[target]) do
                    live[v] = true
                end
                for p = 0, f.edgeNargs[e] - 1 do
                    if a.used[f.params[f.firstParam[target] + p]] ~= false then
                        live[f.edgeArgs[f.edgeFirstArg[e] + p]] = true
                    end
                end
            end
        end

        return live
    end

    -- Walks block `b` backwards from what is live at its end; `call` sees
    -- what is live across each call.
    local function walk(b: integer, call: (function(integer, {[integer]: boolean}): nil)?): {[integer]: boolean}
        local live = liveOut(b)
        for i = f.blockEnd[b], f.blockStart[b], -1 do
            if f.result[i] ~= 0 then
                live[f.result[i]] = nil
            end
            if f.result2[i] ~= 0 then
                live[f.result2[i]] = nil
            end
            if call ~= nil and (f.op[i] == CALL or f.op[i] == INDIRECT) then
                call(i, live)
            end
            for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                live[f.args[p]] = true
            end
        end
        for p = f.firstParam[b], f.firstParam[b] + f.nparams[b] - 1 do
            live[f.params[p]] = nil
        end

        return live
    end

    local changed = true
    while changed do
        changed = false
        for b = count, 1, -1 do
            local live = walk(b, nil)
            local size: integer = 0
            for _ in pairs(live) do
                size = size + 1
            end
            if size ~= sizes[b] then
                liveIn[b], sizes[b], changed = live, size, true
            end
        end
    end
    -- An interval spans its value's whole liveness: in reverse postorder a
    -- loop's blocks need not follow one another, so the latest back edge
    -- does not bound where a value live around the loop is still needed.
    for b = 1, count do
        local out: {integer} = {}
        for v in pairs(liveOut(b)) do
            out[#out + 1] = v
            if a.finish[v] < a.blockExit[b] then
                a.finish[v] = a.blockExit[b]
            end
        end
        table.sort(out)
        a.liveOut[b] = out
    end
    for v = 1, #f.valueKinds do
        a.ranges[v] = {}
    end

    local function range(v: integer, first: integer, last: integer): nil
        local list = a.ranges[v]
        list[#list + 1], list[#list + 2] = first, last
    end

    for b = 1, count do
        local ends: {[integer]: integer} = {}
        for v in pairs(liveOut(b)) do
            ends[v] = a.blockExit[b]
        end
        for i = f.blockEnd[b], f.blockStart[b], -1 do
            local at = 2 * a.instructionPosition[i]
            for _, result in ipairs({f.result[i], f.result2[i]}) do
                if result ~= 0 then
                    range(result, at + 1, ends[result] or at + 1)
                    ends[result] = nil
                end
            end
            for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                if ends[f.args[p]] == nil then
                    ends[f.args[p]] = at
                end
            end
        end
        local entry = a.blockEntry[b]
        for p = f.firstParam[b], f.firstParam[b] + f.nparams[b] - 1 do
            local parameter = f.params[p]
            range(parameter, entry, ends[parameter] or entry)
            ends[parameter] = nil
        end
        for v, last in pairs(ends) do
            range(v, entry, last)
        end
    end
    for v = 1, #f.valueKinds do
        a.acrossInternal[v], a.acrossC[v] = false, false
    end
    for b = 1, count do
        walk(b, function(i: integer, live: {[integer]: boolean}): nil
            local signature = f.op[i] == CALL and f.importSignatures[f.aux[i]] or f.aux[i]
            local internal = f.signatures[signature].convention == ir.INTERNAL
            local across: {integer} = {}
            a.callLive[i] = across
            for v in pairs(live) do
                across[#across + 1] = v
                if internal then
                    a.acrossInternal[v] = true
                else
                    a.acrossC[v] = true
                end
            end
            table.sort(across)
        end)
    end
end

local OP_ICMP_DECIDED = ir.opcode("icmp")
local OP_ICONST_DECIDED = ir.opcode("iconst")

-- Whether `x` is below `y` as unsigned 64-bit integers: flipping the sign
-- bit orders them as signed comparison does.
local function unsignedBelow(x: integer, y: integer): boolean
    return (x ~ math.mininteger) < (y ~ math.mininteger)
end

-- Whether 64-bit integer comparison `condition` holds of `x` and `y`, or nil
-- for a condition this does not decide.
local function holds(condition: integer, x: integer, y: integer): boolean?
    local name = ir.conditionNames[condition]
    if name == "eq" then
        return x == y
    elseif name == "ne" then
        return x ~= y
    elseif name == "slt" then
        return x < y
    elseif name == "sle" then
        return x <= y
    elseif name == "sgt" then
        return x > y
    elseif name == "sge" then
        return x >= y
    elseif name == "ult" then
        return unsignedBelow(x, y)
    elseif name == "ule" then
        return x == y or unsignedBelow(x, y)
    elseif name == "ugt" then
        return unsignedBelow(y, x)
    elseif name == "uge" then
        return x == y or unsignedBelow(y, x)
    end

    return nil
end

-- Has instruction `i` name, in place of its edge `replaced`, an edge to
-- `target` passing `args`. Its old edges stay in the columns, named by no
-- instruction (as a threaded jump's do).
local function replaceEdge(f: ir.Function, i: integer, replaced: integer, target: integer, args: {integer}): nil
    local first = #f.edgeTarget + 1
    for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
        local at = #f.edgeTarget + 1
        f.edgeFrom[at] = i
        if e == replaced then
            f.edgeTarget[at], f.edgeFirstArg[at], f.edgeNargs[at] = target, #f.edgeArgs + 1, #args
            for _, value in ipairs(args) do
                f.edgeArgs[#f.edgeArgs + 1] = value
            end
        else
            f.edgeTarget[at], f.edgeFirstArg[at], f.edgeNargs[at] = f.edgeTarget[e], f.edgeFirstArg[e], f.edgeNargs[e]
        end
    end
    f.firstEdge[i] = first
end

-- Sends edges past blocks that decide nothing for them: an edge passing a
-- literal into a block that only compares that parameter with a literal and
-- branches goes where the branch would, and an edge into a block that only
-- jumps goes where it jumps. An inlined check's failure (returning zero) then
-- reaches the caller's failing path without testing the zero again. A block
-- whose values are read beyond it is passed by only when every such reader
-- is under the successor the edge no longer reaches, which it alone enters.
local function decided(f: ir.Function): nil
    local count = #f.blockStart
    local blockOf: {integer} = {}
    for b, start in ipairs(f.blockStart) do
        for i = start, f.blockEnd[b] do
            blockOf[i] = b
        end
    end

    -- The block that makes `value` (a parameter's is its block).
    local function maker(value: integer): integer
        local definition = f.definitions[value]
        return definition > 0 and blockOf[definition] or -definition
    end

    -- What the edges named now imply, made again after each redirect:
    -- each value's readers and the blocks reading it beyond its maker,
    -- each block's entries and immediate dominator.
    local readers: {integer} = {}
    local outside: {[integer]: {[integer]: boolean}} = {}
    local into: {integer} = {}
    local used: {boolean} = {}
    local dominator: {integer} = {}

    local function analyze(): nil
        readers, outside, into = zeros(#f.valueKinds), {}, zeros(count)
        used = usedParameters(f)

        local function read(value: integer, block: integer): nil
            readers[value] = readers[value] + 1
            if maker(value) ~= block then
                local blocks = outside[value] or {}
                blocks[block], outside[value] = true, blocks
            end
        end

        local successors: {{integer}} = {}
        for b = 1, count do
            successors[b] = {}
        end
        for i = 1, #f.op do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                local list = successors[blockOf[i]]
                list[#list + 1] = f.edgeTarget[e]
            end
        end
        -- Dominators by the iterative method over reverse postorder.
        local post: {integer} = {}
        local seen: {boolean} = {true}
        local stack: {integer} = {1}
        local cursor: {integer} = {1}
        while #stack > 0 do
            local b = stack[#stack]
            local next = successors[b][cursor[#cursor]]
            if next == nil then
                post[#post + 1] = b
                stack[#stack], cursor[#cursor] = nil, nil
            else
                cursor[#cursor] = cursor[#cursor] + 1
                if not seen[next] then
                    seen[next] = true
                    stack[#stack + 1], cursor[#cursor + 1] = next, 1
                end
            end
        end
        local rank: {integer} = zeros(count)
        for r, b in ipairs(post) do
            rank[b] = r
        end
        -- Only blocks a path reaches read anything or enter anything: one
        -- threading passed by still names its edges.
        for i = 1, #f.op do
            if seen[blockOf[i]] then
                for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                    read(f.args[p], blockOf[i])
                end
                for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                    into[f.edgeTarget[e]] = into[f.edgeTarget[e]] + 1
                    for p = 0, f.edgeNargs[e] - 1 do
                        -- What an unread parameter is passed is not read.
                        if used[f.params[f.firstParam[f.edgeTarget[e]] + p]] then
                            read(f.edgeArgs[f.edgeFirstArg[e] + p], blockOf[i])
                        end
                    end
                end
            end
        end
        local predecessors: {{integer}} = {}
        for b = 1, count do
            predecessors[b] = {}
        end
        for b = 1, count do
            for _, s in ipairs(seen[b] and successors[b] or {}) do
                local list = predecessors[s]
                list[#list + 1] = b
            end
        end
        dominator = zeros(count)
        dominator[1] = 1
        local changed = true
        while changed do
            changed = false
            for r = #post - 1, 1, -1 do
                local b = post[r]
                local chosen: integer = 0
                for _, p in ipairs(predecessors[b]) do
                    if dominator[p] ~= 0 then
                        if chosen == 0 then
                            chosen = p
                        else
                            local x, y = p, chosen
                            while x ~= y do
                                while rank[x] < rank[y] do
                                    x = dominator[x]
                                end
                                while rank[y] < rank[x] do
                                    y = dominator[y]
                                end
                            end
                            chosen = x
                        end
                    end
                end
                if chosen ~= 0 and dominator[b] ~= chosen then
                    dominator[b], changed = chosen, true
                end
            end
        end
    end

    -- Whether block `n` dominates block `b`.
    local function dominates(n: integer, b: integer): boolean
        while b ~= n and dominator[b] ~= 0 and dominator[b] ~= b do
            b = dominator[b]
        end

        return b == n
    end

    -- Whether block `m` makes a value (a parameter or a result) read beyond
    -- it other than under block `allowed` (zero allows none).
    local function escapes(m: integer, allowed: integer): boolean
        local function beyond(value: integer): boolean
            for block in pairs(outside[value] or {}) do
                if allowed == 0 or not dominates(allowed, block) then
                    return true
                end
            end

            return false
        end

        for p = f.firstParam[m], f.firstParam[m] + f.nparams[m] - 1 do
            if beyond(f.params[p]) then
                return true
            end
        end
        for i = f.blockStart[m], f.blockEnd[m] do
            if f.result[i] ~= 0 and beyond(f.result[i]) then
                return true
            end
        end

        return false
    end

    -- The literal value `value` is, if it is one.
    local function literal(value: integer): integer?
        local definition = f.definitions[value]
        if definition > 0 and f.op[definition] == OP_ICONST_DECIDED and f.valueKinds[value] == ir.I64 then
            return f.imm[definition]
        end

        return nil
    end

    -- Whether what block `m`'s edge `e` passes (to parameters read) is there
    -- without `m`.
    local function passable(m: integer, e: integer): boolean
        for p = 0, f.edgeNargs[e] - 1 do
            local value = f.edgeArgs[f.edgeFirstArg[e] + p]
            local read = used[f.params[f.firstParam[f.edgeTarget[e]] + p]]
            if read and f.definitions[value] > 0 and maker(value) == m then
                return false
            end
        end

        return true
    end

    -- For block `m`, when it only compares a parameter with a literal and
    -- branches on that: the comparison, the parameter's position and
    -- whether it is compared first.
    local function test(m: integer): (integer, integer, boolean)
        local branch = f.blockEnd[m]
        if m == 1 or f.op[branch] ~= BRIF then
            return 0, -1, false
        end
        local compare: integer = 0
        for i = f.blockStart[m], branch - 1 do
            if f.op[i] == OP_ICMP_DECIDED and compare == 0 then
                compare = i
            elseif f.op[i] ~= OP_ICONST_DECIDED then
                return 0, -1, false
            end
        end
        if compare == 0
            or f.args[f.firstArg[branch]] ~= f.result[compare]
            or readers[f.result[compare]] ~= 1
            or not passable(m, f.firstEdge[branch])
            or not passable(m, f.firstEdge[branch] + 1)
        then
            return 0, -1, false
        end
        local x, y = f.args[f.firstArg[compare]], f.args[f.firstArg[compare] + 1]
        for p = 0, f.nparams[m] - 1 do
            local parameter = f.params[f.firstParam[m] + p]
            if parameter == x and literal(y) ~= nil then
                return compare, p, true
            elseif parameter == y and literal(x) ~= nil then
                return compare, p, false
            end
        end

        return 0, -1, false
    end

    -- For block `m`, when it only jumps (making literals nothing beyond it
    -- reads): its jump's edge.
    local function forwards(m: integer): integer
        local jump = f.blockEnd[m]
        if m == 1
            or f.op[jump] ~= JUMP
            or f.edgeTarget[f.firstEdge[jump]] == m
            or not passable(m, f.firstEdge[jump])
            or escapes(m, 0)
        then
            return 0
        end
        for i = f.blockStart[m], jump - 1 do
            if f.op[i] ~= OP_ICONST_DECIDED then
                return 0
            end
        end

        return f.firstEdge[jump]
    end

    -- The arguments block `m`'s edge `taken` passes, its parameters being
    -- what edge `e` into it passes for them.
    local function composed(e: integer, m: integer, taken: integer): {integer}
        local args: {integer} = {}
        for p = 0, f.edgeNargs[taken] - 1 do
            local value = f.edgeArgs[f.edgeFirstArg[taken] + p]
            for q = 0, f.nparams[m] - 1 do
                if f.params[f.firstParam[m] + q] == value then
                    value = f.edgeArgs[f.edgeFirstArg[e] + q]
                end
            end
            args[#args + 1] = value
        end

        return args
    end

    -- Where edge `e` (into `m`) goes instead, or zero.
    local function instead(e: integer, m: integer): integer
        local compare, position, first = test(m)
        local passed = position >= 0 and literal(f.edgeArgs[f.edgeFirstArg[e] + position]) or nil
        if passed == nil then
            return forwards(m)
        end
        local fixed = literal(f.args[f.firstArg[compare] + (first and 1 or 0)]) as integer
        local outcome: boolean? = nil
        if first then
            outcome = holds(f.aux[compare], passed, fixed)
        else
            outcome = holds(f.aux[compare], fixed, passed)
        end
        if outcome == nil then
            return 0
        end
        local branch = f.blockEnd[m]
        local taken = f.firstEdge[branch] + (outcome and 0 or 1)
        local other = f.edgeTarget[f.firstEdge[branch] + (outcome and 1 or 0)]
        local alone = into[other] == 1 and other ~= f.edgeTarget[taken] and other or 0

        return escapes(m, alone) and 0 or taken
    end

    local instructions = #f.op
    local changed = true
    local rounds: integer = 0
    -- One redirect a round; each passes a block by, and the blocks bound
    -- how many there can be (a cycle of empty blocks would not end).
    while changed and rounds < 4 * count do
        changed, rounds = false, rounds + 1
        analyze()
        for i = 1, instructions do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                local m = f.edgeTarget[e]
                local taken = blockOf[i] ~= m and instead(e, m) or 0
                if taken ~= 0 and f.edgeTarget[taken] ~= m then
                    replaceEdge(f, i, e, f.edgeTarget[taken], composed(e, m, taken))
                    changed = true
                    -- What the analysis says holds no longer: start again.
                    break
                end
            end
            if changed then
                break
            end
        end
    end
end

-- Sends every edge into a block to an identical one instead, so the copies
-- (each check's failing path, as lowering makes one per check) are selected
-- once and branches to them can share a target. Blocks are identical when
-- neither reads a parameter and their instructions match, a block's own
-- values named by position, with edges to the same blocks passing the same
-- values to what those blocks read. An edge redirected to a block with fewer
-- parameters, all unread and of the kinds it passes first, passes only those.
local function merge(f: ir.Function): nil
    local used = usedParameters(f)
    local count = #f.blockStart
    local blockOf: {integer} = {}
    for b, start in ipairs(f.blockStart) do
        for i = start, f.blockEnd[b] do
            blockOf[i] = b
        end
    end
    local representative: {integer} = {}
    local unread: {boolean} = {}
    for b = 1, count do
        representative[b], unread[b] = b, b ~= 1
        for p = f.firstParam[b], f.firstParam[b] + f.nparams[b] - 1 do
            if used[f.params[p]] then
                unread[b] = false
            end
        end
    end

    -- A value as block `b` names it: by position when `b` makes it.
    local function named(b: integer, value: integer): string
        local definition = f.definitions[value]
        if definition > 0 and blockOf[definition] == b then
            return (value == f.result2[definition] and "S" or "L") .. tostring(definition - f.blockStart[b])
        end

        return "V" .. tostring(value)
    end

    -- Whether edges into `keep` may carry what edges into `drop` passed.
    local function fits(keep: integer, drop: integer): boolean
        if f.nparams[keep] > f.nparams[drop] then
            return false
        end
        for p = 0, f.nparams[keep] - 1 do
            if f.valueKinds[f.params[f.firstParam[keep] + p]] ~= f.valueKinds[f.params[f.firstParam[drop] + p]] then
                return false
            end
        end

        return true
    end

    local changed = true
    local rounds: integer = 0
    while changed and rounds < 8 do
        changed, rounds = false, rounds + 1
        local byKey: {[string]: integer} = {}
        for b = 2, count do
            if unread[b] and representative[b] == b then
                local parts: {string} = {}
                for i = f.blockStart[b], f.blockEnd[b] do
                    local fields: {
                        string
                    } = {
                        tostring(f.op[i]),
                        tostring(f.kind[i]),
                        tostring(f.kind2[i]),
                        tostring(f.imm[i]),
                        tostring(f.aux[i]),
                        f.result[i] ~= 0 and "r" or "-",
                        f.result2[i] ~= 0 and "r" or "-"
                    }
                    for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                        fields[#fields + 1] = named(b, f.args[p])
                    end
                    for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                        local into = representative[f.edgeTarget[e]]
                        fields[#fields + 1] = "->" .. tostring(into)
                        for p = 0, f.nparams[into] - 1 do
                            local read = used[f.params[f.firstParam[into] + p]]
                            fields[#fields + 1] = read and named(b, f.edgeArgs[f.edgeFirstArg[e] + p]) or "_"
                        end
                    end
                    parts[#parts + 1] = table.concat(fields, " ")
                end
                local key = table.concat(parts, "|")
                local kept = byKey[key]
                if kept == nil then
                    byKey[key] = b
                elseif fits(kept, b) or fits(b, kept) then
                    local keep, drop = kept, b
                    if not fits(kept, b) then
                        keep, drop, byKey[key] = b, kept, b
                    end
                    representative[drop], changed = keep, true
                end
            end
        end
        -- An instruction branching to a dropped block names new edges; its
        -- old ones stay in the columns, named by no instruction (as a
        -- threaded jump's do), and keep the dropped block ordered.
        for i = 1, #f.op do
            local redirected = false
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                redirected = redirected or representative[f.edgeTarget[e]] ~= f.edgeTarget[e]
            end
            if redirected then
                local first = #f.edgeTarget + 1
                for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                    local keep = representative[f.edgeTarget[e]]
                    local at = #f.edgeTarget + 1
                    f.edgeFrom[at], f.edgeTarget[at] = i, keep
                    f.edgeFirstArg[at] = f.edgeFirstArg[e]
                    f.edgeNargs[at] = keep == f.edgeTarget[e] and f.edgeNargs[e] or f.nparams[keep]
                end
                f.firstEdge[i] = first
            end
        end
    end
end

local OP_IMUL, OP_UMULHI, OP_SELECT = ir.opcode("imul"), ir.opcode("umulhi"), ir.opcode("select")
local OP_IREDUCE, OP_LAST_CONVERSION = ir.opcode("ireduce"), ir.opcode("fcvt_to_uint_sat")
local OP_IADD = ir.opcode("iadd")
local OP_ICONST = ir.opcode("iconst")
local OP_CALL, OP_CALL_INDIRECT = ir.opcode("call"), ir.opcode("call_indirect")

-- Computes each pure operation once along a run of blocks each entered from
-- the one before alone (so what the first computed dominates the rest): a
-- repeat with the same operands takes the first's result, and is left with
-- no operands for the selector to drop. Literals and stack addresses are
-- left alone; each is remade where it is used.
-- Nothing computed before a call is
-- reused after it: across the call it would cost a save and a reload.
local function common(f: ir.Function): nil
    local count = #f.blockStart
    -- Entries by named edges from blocks a path reaches: a block threading
    -- passed by still names its edges, though nothing enters it.
    local reached: {boolean} = {true}
    local pending: {integer} = {1}
    while #pending > 0 do
        local b = pending[#pending]
        pending[#pending] = nil
        for i = f.blockStart[b], f.blockEnd[b] do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                if not reached[f.edgeTarget[e]] then
                    reached[f.edgeTarget[e]] = true
                    pending[#pending + 1] = f.edgeTarget[e]
                end
            end
        end
    end
    local named: {integer} = zeros(count)
    for b = 1, count do
        for i = reached[b] and f.blockStart[b] or 1, reached[b] and f.blockEnd[b] or 0 do
            for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                named[f.edgeTarget[e]] = named[f.edgeTarget[e]] + 1
            end
        end
    end
    local alias: {[integer]: integer} = {}

    local function resolved(value: integer): integer
        while alias[value] ~= nil do
            value = alias[value] as integer
        end

        return value
    end

    local visited: {boolean} = {}
    local blocks: {integer} = {1}
    local tables: {{[string]: integer}} = {{}}
    while #blocks > 0 do
        local b, inherited = blocks[#blocks], tables[#tables]
        blocks[#blocks], tables[#tables] = nil, nil
        if not visited[b] then
            visited[b] = true
            local available: {[string]: integer} = {}
            for key, value in pairs(inherited) do
                available[key] = value
            end
            for i = f.blockStart[b], f.blockEnd[b] do
                local op = f.op[i]
                if op == OP_CALL or op == OP_CALL_INDIRECT then
                    available = {}
                end
                local pure = op >= OP_IADD and op <= OP_IMUL
                    or op >= OP_UMULHI and op <= OP_SELECT
                    or op >= OP_IREDUCE and op <= OP_LAST_CONVERSION
                if pure and f.result[i] ~= 0 and f.result2[i] == 0 and f.nargs[i] > 0 then
                    local fields: {string} = {tostring(op), tostring(f.kind[i]), tostring(f.imm[i]), tostring(f.aux[i])}
                    -- A literal operand is named by its value: each use
                    -- of a literal may make its own.
                    for p = f.firstArg[i], f.firstArg[i] + f.nargs[i] - 1 do
                        local value = resolved(f.args[p])
                        local definition = f.definitions[value]
                        fields[#fields + 1] = definition > 0
                            and f.op[definition] == OP_ICONST
                            and "#" .. tostring(f.valueKinds[value]) .. ":" .. tostring(f.imm[definition])
                            or tostring(value)
                    end
                    local key = table.concat(fields, " ")
                    local first = available[key]
                    if first ~= nil then
                        alias[f.result[i]] = first
                        f.nargs[i] = 0
                    else
                        available[key] = f.result[i]
                    end
                end
                for e = f.firstEdge[i], f.firstEdge[i] + f.nedges[i] - 1 do
                    local into = f.edgeTarget[e]
                    blocks[#blocks + 1] = into
                    tables[#tables + 1] = named[into] == 1 and into ~= 1 and available or {}
                end
            end
        end
    end
    if next(alias) == nil then
        return
    end
    for p, value in ipairs(f.args) do
        f.args[p] = resolved(value)
    end
    for p, value in ipairs(f.edgeArgs) do
        f.edgeArgs[p] = resolved(value)
    end
end

function allocate.run(f: ir.Function, target: allocate.Target): allocate.Allocation
    if target.saveAcrossCalls == true then
        allocate.simplify(f)
        common(f)
        decided(f)
        merge(f)
    end
    local a = newAllocation(f)
    if target.saveAcrossCalls == true then
        a.used = usedParameters(f)
    end
    intervals(f, a)
    if target.saveAcrossCalls == true then
        crossings(f, a)
    end
    registers(f, a, target)
    local source: {integer} = {}
    local destination: {integer} = {}
    local kinds: {integer} = {}
    local workspace = allocate.workspace()
    for e = 1, #f.edgeTarget do
        local b = f.edgeTarget[e]
        for p = #source, f.edgeNargs[e] + 1, -1 do
            source[p], destination[p], kinds[p] = nil, nil, nil
        end
        local count: integer = 0
        for p = 0, f.edgeNargs[e] - 1 do
            local v, parameter = f.edgeArgs[f.edgeFirstArg[e] + p], f.params[f.firstParam[b] + p]
            if a.used[parameter] ~= false then
                count = count + 1
                source[
                    count
                ], destination[count], kinds[count] = a.location[v], a.location[parameter], f.valueKinds[parameter]
            end
        end
        for p = #source, count + 1, -1 do
            source[p], destination[p], kinds[p] = nil, nil, nil
        end
        a.firstMove[e] = #a.moveSource + 1
        allocate.parallel(source, destination, kinds, target, a, workspace)
        a.nmoves[e] = #a.moveSource + 1 - a.firstMove[e]
    end

    return a
end

export = allocate
