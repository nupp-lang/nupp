module s0.selectionidentity

local reader = require("s0.reader")
local allocate = require("s0.allocate")
local selector = require("s0.select")

export function dump(path: string, destination: string): string
    local input = assert(io.open(path, "rb"))
    local functions = reader.read(assert(input:read("*a")))
    input:close()
    local output = assert(io.open(destination, "wb"))
    local count: integer = 0

    local function numbers(values: {integer}): nil
        output:write(tostring(#values), ":")
        for _, value in ipairs(values) do
            output:write(tostring(value), ",")
        end
        output:write("\n")
    end

    for _, f in ipairs(functions) do
        local code = selector.run(f, allocate.run(f, selector.target()))
        output:write(f.name, "\n", tostring(code.frameBytes), "\n")
        numbers(code.words)
        numbers(code.fixupWord)
        numbers(code.fixupKind)
        numbers(code.fixupAddend)
        for _, name in ipairs(code.fixupName) do
            output:write(name, "\n")
        end
        numbers(code.blockWord)
        numbers(code.stackOffsets)
        numbers(code.opWords)
        numbers(code.opCounts)
        count = count + #code.words
    end
    output:close()

    return ("%d functions, %d codewords and all selection metadata dumped"):format(#functions, count)
end
