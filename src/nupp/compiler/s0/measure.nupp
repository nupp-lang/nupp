module nupp.compiler.s0.measure

local reader = require("nupp.compiler.s0.reader")
local allocate = require("nupp.compiler.s0.allocate")
local selector = require("nupp.compiler.s0.select")

export function compileCorpus(path: string, repeatText: string): string
    local repeats = assert(math.tointeger(tonumber(repeatText)))
    assert(repeats >= 1 and repeats <= 100, "S0 measure: repetition limit")
    local file = assert(io.open(path, "rb"))
    local functions = reader.read(assert(file:read("*a")))
    file:close()
    local target = selector.target()
    local rows: {string} = {}
    collectgarbage("collect")
    for round = 1, repeats do
        for index, f in ipairs(functions) do
            local started = os.clock()
            local code = selector.run(f, allocate.run(f, target))
            local elapsed = os.clock() - started
            rows[
                #rows + 1
            ] = (
                '{"round":%d,"function":%d,"instructions":%d,"codeBytes":%d,"backendNs":%.0f}'
            ):format(round, index, #f.op, #code.words * 4, elapsed * 1000000000)
        end
    end

    return '{"scope":"allocation and selection; parsing, image loading, linking and JSON excluded",'
        .. '"functions":'
        .. tostring(
            #functions
        ) .. ',"rows":[' .. table.concat(rows, ",") .. ']}'
end
