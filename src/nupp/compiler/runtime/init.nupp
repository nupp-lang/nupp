module nupp.compiler.runtime

--[[
Loading a `.nupp` module at run time.

A loader installed into `package.loaders`, after `package.preload` and before the
ordinary Lua loader. It compiles `.nupp` sources and loads plain Lua from the
same project roots, so a Nupp program can `require` either without knowing which
it is getting. Declaration files are never executed, and a name this loader
cannot resolve, most often a C module, continues through Lua's normal loader
chain untouched.
]]

local envMod = require("nupp.compiler.project.env")

local runtime = {}

-- Installs a loader backed by the project's checker environment. `compile` receives
-- (path, env, module name) and returns compiled code or nil plus an error: Lua
-- source, or what `loadCompiled` turns into the module's chunk when it is given
-- (a VM image on the VM). The returned function removes this exact loader, even
-- if other loaders were added while the program was running.
function runtime.install(
    env: envMod.Env,
    compile: function(path: string, env: envMod.Env, name: string): (string?, string?),
    loaded: function(name: string, path: string, ok: boolean)?,
    checkPlain: function(path: string, env: envMod.Env): boolean?,
    preparing: (function(active: boolean): nil)?,
    loadCompiled: (function(code: string, path: string): (any, string?))?
): function(): nil
    local loaders = package.loaders
    assert(loaders, "this Lua runtime does not expose package loaders")
    assert(type(compile) == "function", "compile callback must be a function")

    local function pack(...)
        return {n = select("#", ...), ...}
    end

    local unpackAny = unpack as function(table, integer?, integer?): ...any

    -- The compiler lazily requires pieces of itself while `compile` runs, and in a
    -- project whose source is the compiler's own, those names resolve here too.
    -- Recursing into a fresh compile of the checker mid-check reports the module
    -- being computed as having no exports at all, so while a compile is in progress
    -- this loader stands aside and the chain behind it serves the running compiler.
    local compiling = false

    local function loadPath(name: string, path: string, moduleEnv: envMod.Env?): any
        local env = moduleEnv or env
        local chunk, loadErr
        if path:match("%.nupp$") then
            compiling = true
            local ok, code, compileErr = pcall(compile, path, env, name)
            compiling = false
            if not ok then
                error(code, 0)
            end
            if not code then
                error(
                    (
                        "error compiling nupp module '%s' from '%s': %s"
                    ):format(name, path, compileErr or "compilation failed"),
                    0
                )
            end
            if loadCompiled then
                chunk, loadErr = loadCompiled(code, path)
            else
                chunk, loadErr = loadstring(code, "@" .. path)
            end
        else
            -- A plain Lua module runs as written, but what its annotations claim is
            -- what a typed caller was checked against, so a body that breaks its own
            -- contract is refused the way a `.nupp` module with an error is. Without
            -- this a `.lua` dependency could hand strict code a value of the wrong
            -- type, which `nupp build` refuses and `nupp run` used to let through.
            if checkPlain and not checkPlain(path, env) then
                error(("error checking lua module '%s' from '%s': type errors"):format(name, path), 0)
            end
            chunk, loadErr = loadfile(path)
        end
        if not chunk then
            error(("error loading project module '%s' " .. "from '%s': %s"):format(name, path, tostring(loadErr)), 0)
        end

        if not loaded or not path:match("%.nupp$") then
            return chunk
        end

        -- Watch modules become patch targets only after top level completed. Keep this
        -- wrapper out of ordinary runs: besides being unnecessary there, pcall would
        -- be an observable stack-frame change.

        return function(...)
            local args: {any} & {n: integer} = {n = select("#", ...), ...}
            local result
            local ok, failure = pcall(function()
                result = pack(chunk(unpackAny(args, 1, args.n)))
            end)
            loaded(name, path, ok)
            if not ok then
                error(failure, 0)
            end

            return unpack(result, 1, result.n)
        end
    end

    -- The VM's own implementation of a standard module, where it has one: it
    -- replaces the checkout's LuaJIT spelling wherever that would be found.
    local function vmOverride(name: string): string?
        local root = envMod.compilerRoot()
        if not root or name:sub(1, 5) ~= "nupp." or not rawget(_G, "__nupp_load_image") then
            return nil
        end
        local path = root .. "/native/crates/vm/lib/" .. name:gsub("%.", "/") .. ".nupp"
        local file = io.open(path, "rb")
        if not file then
            return nil
        end
        file:close()

        return path
    end

    -- The VM's own modules are written over primitives only the VM declares, so
    -- they are checked where those declarations and their sibling VM modules
    -- resolve first, as the image builder checks them.
    local vmEnv: envMod.Env? = nil

    local function vmModuleEnv(): envMod.Env
        local made = vmEnv
        if made == nil then
            local root = assert(envMod.compilerRoot(), "compiler source root unavailable")
            made = envMod.new(root)
            local roots = assert((made as any).roots) as {string}
            table.insert(roots, 1, root .. "/native/crates/vm/lib")
            table.insert(roots, 1, root .. "/native/crates/vm/decls")
            vmEnv = made
        end

        return made
    end

    local function loadLjppModule(name)
        if compiling then
            return
        end
        local override = vmOverride(name)
        if override then
            return loadPath(name, override, vmModuleEnv())
        end
        local path = envMod.findRuntimeModulePath(env, name)
        if not path then
            return ("\n\tno nupp source for module '%s'"):format(name)
        end

        return loadPath(name, path)
    end

    -- The standard library of the compiler's own checkout. LuaJIT finds its
    -- compiled copies on `package.path`, ahead of this; the VM has no such path,
    -- so a `nupp.` module the compiler image does not carry compiles from source,
    -- checked as the checkout's own module rather than as the project's.
    local standardEnv: envMod.Env? = nil

    local function loadStandardModule(name)
        local root = envMod.compilerRoot()
        if compiling or name:sub(1, 5) ~= "nupp." or not root then
            return
        end
        local rel = name:gsub("%.", "/")
        local candidates = {root .. "/src/" .. rel .. ".nupp", root .. "/src/" .. rel .. "/init.nupp"}
        local override = vmOverride(name)
        if override then
            return loadPath(name, override, vmModuleEnv())
        end
        for _, path in ipairs(candidates) do
            local file = io.open(path, "rb")
            if file then
                file:close()
                standardEnv = standardEnv or envMod.new(root)
                return loadPath(name, path, standardEnv)
            end
        end

        return ("\n\tno standard library source for module '%s'"):format(name)
    end

    -- Profiling excludes resolution and loading as well as compilation. The
    -- returned chunk runs after this wrapper has restored the measured window.
    local installedLoader = loadLjppModule
    if preparing then
        installedLoader = function(name)
            preparing(true)
            local ok, result = pcall(loadLjppModule, name)
            preparing(false)
            if not ok then
                error(result, 0)
            end

            return result
        end
    end
    -- package.preload remains authoritative, matching Lua's normal semantics,
    -- and on the VM so does the running image, which carries the VM's own
    -- implementations of standard modules the checkout spells for LuaJIT.
    table.insert(loaders, rawget(_G, "__nupp_load_image") and 3 or 2, installedLoader)
    loaders[#loaders + 1] = loadStandardModule

    local installed = true

    return function()
        if not installed then
            return
        end
        installed = false
        for _, removed in ipairs({installedLoader, loadStandardModule}) do
            for j, loader in ipairs(loaders) do
                if loader == removed then
                    table.remove(loaders, j)
                    break
                end
            end
        end
    end
end

export = runtime
