@!internal

module nupp.compiler.runtime.reflect

-- Runtime witnesses resolve application declarations. These are dependencies
-- of the compiled application, not of the compiler implementation.
@allow("unused-binding")
const _DYNAMIC_REQUIRES = "@requires-dynamically nothing"

--[[
Reflection as it exists at run time.

The compiler does the describing. A type that is reflected on carries a blueprint the
checker built from its declaration, and generated code hands that blueprint over with
`_G.nupp.__reflect.register`. What is left for run time is holding the blueprints,
answering `reflect()` from one, and running the extensions a program layers on top.
Separately, it holds the keyed codec a materialized `nupp.reflect.fieldCodec`
calls.

A descriptor is separate from the declaration table. A record's declaration owns
its cached descriptor under an opaque key; the descriptor retains its type. Weak
side tables index that pair without keeping an unused local declaration alive.
The descriptor is an empty table whose metatable reads its private state, so
ordinary writes cannot replace a descriptor field.

See [reflection.md](docs/learn/language/reflection.md) for what a program does with a descriptor.
]]

local reflectruntime = {}
local extensions = require("nupp.compiler.runtime.extensions")

--- Reads a namespace member, installing a default when nothing is there yet.
---
--- Two programs can share one process and one `_G.nupp`, and either may have been
--- built by a compiler old enough to install these namespaces itself. Filling in what
--- is missing rather than replacing what is there leaves whichever arrived first
--- holding the descriptors both then use.
local function claim(namespace: any, name: string, fresh: any): any
    local present = rawget(namespace, name)
    if present ~= nil then
        return present
    end
    rawset(namespace, name, fresh)

    return fresh
end

--- Installs the keyed field codec.
---
--- A materialized codec calls this with the field names the compiler settled on and
--- the fingerprint it checked them under. Encoding and decoding copy the named fields
--- and nothing else, and decoding restores the record's metatable. A field that is
--- absent stays absent rather than becoming an explicit nil, which is what makes the
--- result round-trip.
--- @export
function reflectruntime.installFieldCodec(namespace: any): nil
    local fieldcodec = claim(namespace, "fieldcodec", {})
    fieldcodec.keyed = function(fields: {string}, fingerprint: string, recordType: any): any
        local Codec: any = {}
        Codec.__index = Codec
        function Codec:encode(value: any): any
            if type(value) ~= "table" then
                error("nupp: keyed codec value must be a table", 2)
            end
            local out: any = {}
            for _, name in ipairs(fields) do
                local field = rawget(value, name)
                if field ~= nil then
                    out[name] = field
                end
            end

            return out
        end

        function Codec:decode(value: any): (any, string?)
            if type(value) ~= "table" then
                return nil, "$: expected keyed table"
            end
            local out: any = {}
            for _, name in ipairs(fields) do
                local field = rawget(value, name)
                if field ~= nil then
                    out[name] = field
                end
            end

            return setmetatable(out, recordType), nil
        end

        return setmetatable({fingerprint = fingerprint}, Codec)
    end
end

--- Installs the reflection registry and the descriptor protocol.
--- @export
function reflectruntime.install(namespace: any): nil
    require("nupp.compiler.runtime.typewitness").install(namespace)
    local api = claim(namespace, "reflect", {})
    api.extensionKey = extensions.key
    local reflect = claim(namespace, "__reflect", {})
    local blueprints = reflect.blueprints or setmetatable({}, {__mode = "k"})
    local infos = claim(reflect, "valueInfos", setmetatable({}, {__mode = "kv"}))
    local states = claim(reflect, "valueStates", setmetatable({}, {__mode = "kv"}))
    local infoKey = claim(reflect, "infoKey", {})
    local ctypeInfos = claim(reflect, "ctypeInfos", setmetatable({}, {__mode = "k"}))
    local references = claim(reflect, "references", setmetatable({}, {__mode = "k"}))
    local targetsKey = reflect.targetsKey
    local ctypeTargets = reflect.ctypeTargets

    local Info: any = {}

    --- Builds an extension over a descriptor, or returns the one already built.
    ---
    --- An extension is memoized under the extension itself rather than a name, so two
    --- extensions that happen to describe the same thing stay separate. The
    --- in-progress state is kept as well as the finished one: an extension whose
    --- `build` reflects its way back to the descriptor it is being built for would
    --- otherwise recur until the stack ran out, and a build that failed once is
    --- reported the same way every time rather than retried.
    ---
    --- @raises string when the descriptor is not one of ours, when the extension is
    ---     already being built, or when its `build` did not succeed
    function Info:extension<T>(extension: nupp.reflect.ExtensionKey<T>): T
        local state = states[self]
        if not state then
            error("nupp: foreign reflection descriptor", 2)
        end

        return extensions.resolve(self, extension)
    end

    -- The descriptor is an empty table, so every read arrives here and is answered
    -- from the side state. That is what keeps a blueprint from being reachable as a
    -- field somebody could write over, and why `__newindex` has nothing to allow.
    Info.read = function(state: any, key: string): any
        if key == "extension" then
            return Info.extension
        elseif key == "type" then
            return state and state.type
        end

        return state and state.blueprint[key]
    end

    Info.__newindex = function(): nil
        error("nupp: reflection descriptors are immutable", 2)
    end

    function reflect.get(typeObject: any): any
        local prior = infos[typeObject] or ctypeInfos[typeObject]
        if prior then
            return prior
        end
        local declared = blueprints[typeObject]
        if not declared then
            error("nupp: type has no reflection blueprint", 2)
        end
        local state: any = {type = typeObject, blueprint = declared}
        local info = setmetatable({}, {
            __index = function(_: any, key: string): any
                return Info.read(state, key)
            end,
            __newindex = Info.__newindex,
        })
        infos[typeObject] = info
        states[info] = state
        -- Keep the cache on its owner. A weak-key table whose value reaches the
        -- key would otherwise retain every reflected local record on LuaJIT.
        if type(typeObject) == "table" then
            rawset(typeObject, infoKey, info)
        else
            ctypeInfos[typeObject] = info
        end
        extensions.host(info)

        return info
    end

    api.runtime = reflect.get

    function api.runtimeType(info: nupp.reflect.Info, index: integer): Type<unknown>?
        local state = states[info]
        if state == nil then
            error("nupp: foreign reflection descriptor", 2)
        end
        if index == state.blueprint.root then
            return state.type
        end
        local keys = references[state.type]
        local wanted = keys and keys[tostring(index)]
        if wanted == nil then
            return nil
        end
        local visited = {}

        local function search(typeObject: any): any
            if visited[typeObject] then
                return nil
            end
            visited[typeObject] = true
            local targets = type(typeObject) == "table" and rawget(typeObject, targetsKey) or ctypeTargets[typeObject]
            if targets == nil then
                return nil
            end
            local direct = targets[wanted]
            if direct ~= nil then
                if direct[1] == nil and direct.module then
                    require(direct.module)
                end
                return direct[1]
            end
            for _, cell in pairs(targets) do
                if cell[1] == nil and cell.module then
                    require(cell.module)
                end
                if cell[1] ~= nil then
                    local answer = search(cell[1])
                    if answer ~= nil then
                        return answer
                    end
                end
            end

            return nil
        end

        return search(state.type)
    end

end

export = reflectruntime
