module nupp.compiler.cli.bench

--[[
`nupp bench`: discover benchmark programs, isolate each named case, and merge
their records.

The measured code still owns its loop through `nupp.bench`. This command owns
the process boundary around it: listing cases, selecting one per child, applying
deadlines, comparing baselines, and retaining machine-readable history.
]]

local usageError = require("nupp.compiler.cli.error").forCommand("bench")
local cliModule = require("nupp.cli")
local root = require("nupp.compiler.cli.root")

local REPORT_SCHEMA = {
    type = "object",
    description = "One benchmark-set run, with every fork of every selected benchmark.",
    properties = {
        schema = {type = "integer"},
        recordedAt = {type = "string"},
        label = {type = "string"},
        forks = {type = "integer", description = "Processes each benchmark was run in."},
        seed = {type = "integer", description = "Seed for the per-round permutation, so an order can be reproduced."},
        margin = {type = "number", description = "Equivalence margin for duration verdicts, as a fraction."},
        machineKey = {
            type = "string",
            description = "Stable identity of the machine. Durations are only compared across records sharing it.",
        },
        hostProfile = {
            type = "object",
            description = "Platform facts. These identify a class of machine, not a machine; machineKey does that.",
        },
        comparison = {
            type = "string",
            description = "interleaved for a paired causal comparison, observational for one against a stored record.",
        },
        benchmarks = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    case = {type = "string", description = "Benchmark program path."},
                    name = {type = "string", description = "Selected benchmark name."},
                    forks = {
                        type = "array",
                        description = "One entry per process, in execution order, each keeping its own ordered samples.",
                        items = {
                            type = "object",
                            properties = {
                                index = {type = "integer"},
                                measurement = {type = "object", description = "That fork's whole measurement."},
                            },
                            required = {"index", "measurement"},
                        },
                    },
                    summary = {
                        type = "object",
                        description = "The merged measurement: fork summaries, the interval or why it was withheld, "
                        .. "and the unanimous abort sites.",
                    },
                },
                required = {"case", "name", "forks", "summary"},
            },
        },
    },
    required = {"schema", "recordedAt", "benchmarks"},
}

local function invalidPattern(patterns: {string}?): string?
    for _, pattern in ipairs(patterns or {}) do
        local ok = pcall(function(): any
            return (""):match(pattern)
        end)
        if not ok then
            return pattern
        end
    end

    return nil
end

local function run(options: any): integer
    local positional: {string} = {}
    if #positional > 0 then
        return usageError("unexpected argument " .. positional[1])
    end
    local values = options
    if values.accept and not values.baseline then
        return usageError("--accept needs --baseline PATH")
    end
    if values.list and (
        values.json
        or values.baseline
        or values.accept
        or values.history
        or values.label
        or values.geo
        or values.profile
        or values.profileIntervalMs
        or values.profileZone
        or values.forks
        or values.margin
        or values.pilot
        or values.against
    ) then
        return usageError("--list cannot be combined with result, baseline, history, or profile options")
    end
    local forks: integer? = nil
    if values.forks then
        local given = tonumber(values.forks)
        if not given or given < 1 or given ~= math.floor(given) then
            return usageError("--forks needs a positive whole number")
        end
        forks = math.floor(given)
    end
    local margin: number? = nil
    if values.margin then
        local given = tonumber(values.margin)
        if not given or given <= 0 then
            return usageError("--margin needs a positive percentage")
        end
        margin = given / 100.0
    end
    if values.margin and not values.baseline and not values.against then
        return usageError("--margin needs --baseline PATH or --against PATH to compare against")
    end
    if values.against and not values.margin then
        return usageError("--against needs --margin PERCENT, the margin its verdicts are judged against")
    end
    if values.pilot and (values.forks or values.baseline or values.margin or values.against) then
        return usageError("--pilot runs its own forks and reports no result, so it takes no forks, baseline or margin")
    end
    local timeoutMs: integer? = nil
    if values.timeoutMs then
        local given = tonumber(values.timeoutMs)
        if not given or given < 1 or given ~= math.floor(given) then
            return usageError("--timeout-ms needs a positive whole number")
        end
        timeoutMs = math.floor(given)
    end
    local profileIntervalMs: integer? = nil
    if values.profileIntervalMs then
        local given = tonumber(values.profileIntervalMs)
        if not given or given < 1 or given ~= math.floor(given) then
            return usageError("--profile-interval-ms needs a positive whole number")
        end
        profileIntervalMs = math.floor(given)
    end
    if (values.profileIntervalMs or values.profileZone) and not values.profile then
        return usageError("--profile-interval-ms and --profile-zone need --profile DIR")
    end
    for _, entry in ipairs({
        {name = "--case", patterns = values.case},
        {name = "--parameter", patterns = values.parameter},
        {name = "--variant", patterns = values.variant},
    }) do
        local invalid = invalidPattern(entry.patterns)
        if invalid then
            return usageError(entry.name .. " has an invalid Lua pattern: " .. invalid)
        end
    end
    local compilerRoot = os.getenv("NUPP_COMPILER_ROOT")
    local hosted = rawget(_G, "__NUPP_EXECUTABLE")
    local executable = compilerRoot and compilerRoot .. "/bin/nupp" or type(
        hosted
    ) == "string" and hosted or tostring(arg[0] or "nupp")
    const {type Options} = require("nupp.compiler.benchrunner")
    local runner = require("nupp.compiler.benchrunner")

    return runner.run(
        {
            executable = executable,
            baseline = values.baseline,
            accept = values.accept,
            json = values.json,
            geo = values.geo,
            casePatterns = values.case,
            parameterPatterns = values.parameter,
            variantPatterns = values.variant,
            file = values.file,
            history = values.history,
            label = values.label,
            timeoutMs = timeoutMs,
            list = values.list,
            profileDir = values.profile,
            profileIntervalMs = profileIntervalMs,
            profileZone = values.profileZone,
            forks = forks,
            seed = values.seed,
            margin = margin,
            pilot = values.pilot,
            against = values.against,
        } as Options
    )
end

--- Run isolated benchmark programs.
---
--- Selectors are Lua string patterns. Repeated patterns within one dimension
--- are alternatives; the command interprets and validates those strings.
@cli(name = "bench", parent = root.Root)
@derive(cliModule.Command)
local record Bench
    --- List benchmark names and source files without running.
    list: boolean = false

    --- Inspect and run only one benchmark program.
    @cli(value = "PATH")
    file: string?

    --- Run logical case names matching a Lua pattern.
    @cli(name = "case", value = "PATTERN")
    caseGmatch: {string} = {}

    --- Run parameter text matching a Lua pattern.
    @cli(value = "PATTERN")
    parameter: {string} = {}

    --- Run variant names matching a Lua pattern.
    @cli(value = "PATTERN")
    variant: {string} = {}

    --- Include geometric-mean variant comparisons.
    geo: boolean = false

    --- Processes to run each benchmark in.
    @cli(value = "INTEGER")
    forks: integer?

    --- Seed for the per-round permutation.
    @cli(value = "INTEGER")
    seed: integer?

    --- Practical equivalence margin, as a percentage, for duration verdicts.
    @cli(value = "PERCENT")
    margin: number?

    --- Estimate variance and report the forks a precision would need.
    pilot: boolean = false

    --- Another nupp executable to measure beside this one, interleaved and paired.
    @cli(value = "PATH")
    against: string?

    --- Child deadline in milliseconds.
    @cli(value = "INTEGER")
    timeoutMs: integer?

    --- Write one collapsed-stack profile per case under this directory.
    @cli(value = "DIR")
    profile: string?

    --- Sampling interval in milliseconds.
    @cli(value = "INTEGER")
    profileIntervalMs: integer?

    --- Keep profile samples under this zone subtree.
    @cli(value = "PREFIX")
    profileZone: string?

    --- Compare deterministic counters with this baseline.
    @cli(value = "PATH")
    baseline: string?

    --- Replace the named baseline after a complete run.
    accept: boolean = false

    --- Append the complete record as one NDJSON line.
    @cli(value = "PATH")
    history: string?

    --- Attach a label to the record and history entry.
    @cli(value = "TEXT")
    label: string?

    --- Write only the merged JSON record to stdout.
    json: boolean = false

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    function run(self): integer
        return run(self)
    end
end

export = {commandType = Bench, schema = REPORT_SCHEMA}
