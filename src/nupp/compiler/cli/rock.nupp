module nupp.compiler.cli.rock

-- `nupp rock`: package and clean-install Nupp libraries with LuaRocks.
--
-- Starting one is `nupp init lib`, which writes the layout this validates.

local cliModule = require("nupp.cli")

local function operate(name: string, rockspec: string?): integer
    local library = require("nupp.compiler.rock")
    local packed, err
    if name == "pack" then
        packed, err = library.pack(".", rockspec)
    else
        packed, err = library.test(".", rockspec)
    end
    if not packed then
        io.stderr:write("nupp: " .. tostring(err) .. "\n")
        return 1
    end
    io.write((name == "pack" and "Packed " or "Checked ") .. packed .. "\n")

    return 0
end

--- Package and check typed LuaRocks libraries.
---
--- A Nupp rock installs runtime Lua normally and carries matching public
--- declarations in its versioned `nupp/` directory. `pack` validates and
--- builds that layout; `test` installs the result into a fresh tree and checks
--- a fresh consumer. `nupp init lib <name>` writes a project in that shape.
---
--- Examples:
---
---     nupp rock pack
---     nupp rock test
@cli(name = "rock", group = true)
@derive(cliModule.Command)
local record Rock
end

--- Build and pack the current Nupp library.
---
--- With no path, uses the one rockspec in the current directory.
---
--- Examples:
---
---     nupp rock pack
---     nupp rock pack mylib-1.0.0-1.rockspec
@cli("pack")
@derive(cliModule.Command)
local record Pack
    --- Rockspec to package.
    @cli(positional = "ROCKSPEC")
    rockspec: string?

    function run(self): integer
        return operate("pack", self.rockspec)
    end
end

--- Install and check the rock from a clean consumer.
---
--- Packs first, installs into a temporary tree, and checks every declared module.
---
--- Examples:
---
---     nupp rock test
---     nupp rock test mylib-1.0.0-1.rockspec
@cli("test")
@derive(cliModule.Command)
local record Test
    --- Rockspec to test.
    @cli(positional = "ROCKSPEC")
    rockspec: string?

    function run(self): integer
        return operate("test", self.rockspec)
    end
end

function Rock.subcommands(): {cliModule.CommandType}
    return {Pack, Test}
end

export = {commandType = Rock}
