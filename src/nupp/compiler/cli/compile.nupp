module nupp.compiler.cli.compile

--[[
Parse, check, optimize, generate: the sequence `build` and `run` both need.

The compiler's own settings used to be four variables at the top of the command
line that option parsing assigned to and compilation read back, which worked only
because one command runs per process. Here they are a value, read out of a parse
and passed down, so what a compile was asked for is visible at the call rather
than in whatever the argument loop happened to leave behind.
]]

local diagnosticMod = require("nupp.compiler.diagnostics")
local fs = require("nupp.compiler.fs")

local compile = {}

--- What the compiler was asked for.
record compile.Settings
    --- Whether strict checker rules are errors. Nil lets the manifest decide, which is
    --- not the same as false.
    strict: boolean?

    --- The resolved source-lowering dialect.
    dialect: string

    --- 0 is the promise that -O0 rewrites nothing. Optimization is opt-in until a
    --- benchmark says which passes have earned being on by default.
    --- Absent when the command line said nothing, so a target's own level can win.
    optLevel: integer?

    --- Report what the optimizer did and what it declined to do.
    remarks: boolean

    --- Passes turned off by -Zno-opt, keyed by their stable code.
    disabled: {[string]: boolean}

    --- Where diagnostics go when the caller is reporting them itself. Present for
    --- `--json`, which has to put them in a document rather than let each one say
    --- itself as it is found. Same favour `nupp.compiler.build.project` already does.
    diagnostics: {any}?

    --- Public materialization observations collected while checking this command.
    materializations: {any}?

    --- Public derive recipe observations collected for JSON build output.
    derives: {any}?

    --- Private const bodies OPT-8 emitted, totalled across the files this command
    --- reached. Nil when the caller does not report them.
    specializedBodies: integer?

    --- Whether generated code carries coverage probes. No command has an option for
    --- it; `NUPP_COVERAGE=1` in the environment asks for it, which is how the coverage
    --- runner reaches the compiles it starts, and every other compile leaves it off.
    coverage: boolean

    --- A command-only literal emitted between generated preamble and authored code.
    --- Absent from ordinary builds and machine bytecode reports.
    bytecodeBoundary: string?
end

-- The level arrives as the digit the option captured. The grammar has already refused
-- anything that is not one of these, so a lookup is both the conversion and the proof
-- that it was in range.
local LEVELS: {[string]: integer} = {["0"] = 0, ["1"] = 1, ["2"] = 2}

--- Reads the settings out of a parse. Every command that compiles takes the same
--- options, so every one of them reads them the same way.
function compile.settings(values: {[string]: any}, collected: {any}?): compile.Settings
    return new compile.Settings(
        strict = values.strict,
        dialect = assert(require("nupp.compiler.dialects").resolve(values.dialect)),
        optLevel = LEVELS[values.optLevel],
        remarks = values.remarks and true or false,
        disabled = values.disabled or {},
        diagnostics = collected,
        coverage = os.getenv("NUPP_COVERAGE") == "1",
        bytecodeBoundary = nil
    )
end

--- Reads, parses and checks one file, reporting every diagnostic the way the text
--- form reports them. Returns the parse and the source it came from, or nil once
--- what stopped it has been said: a command that inspects a checked tree rather than
--- compiling it starts here, so that it sees the same tree a build would.
function compile.check(path: string, env: table, opts: {[string]: any}?): (any?, string?)
    local source, readErr = fs.readFile(path)
    if not source then
        io.stderr:write("nupp: " .. tostring(readErr) .. "\n")
        return nil
    end
    local result = require("nupp.compiler.parser").parse(source, path)
    if #result.errors > 0 then
        diagnosticMod.report(result.errors)
        return nil
    end
    local diags = require("nupp.compiler.check").check(result, path, env, opts)
    if diagnosticMod.report(diags) then
        return nil
    end

    return result, source
end

--- Compiles one file to Lua source. Returns the generated code, or nil and a short
--- reason after having reported the diagnostics that stopped it.
function compile.module(path: string, env: table, settings: compile.Settings): string?, string?
    local collected = settings.diagnostics
    -- Says each diagnostic, or puts it by for the caller to say later, and either way
    -- answers whether an error was among them.
    local function say(values: {any}): boolean
        if not collected then
            return diagnosticMod.report(values)
        end
        local fatal = false
        for _, diagnostic in ipairs(values) do
            collected[#collected + 1] = diagnostic
            if diagnosticMod.isFatal(diagnostic) then
                fatal = true
            end
        end

        return fatal
    end

    local source, readErr = fs.readFile(path)
    if not source then
        require(
            "nupp.compiler.cli.report"
        ).fileFailure(path, readErr, "check that the path exists and is readable", collected)
        return nil, readErr
    end
    local parser = require("nupp.compiler.parser")
    local result = parser.parse(source, path)
    if #result.errors > 0 then
        say(result.errors)
        return nil, "syntax errors"
    end
    local check = require("nupp.compiler.check")
    local diags = check.check(result, path, env, {strict = settings.strict, dialect = settings.dialect,})
    if settings.materializations then
        local observations = require(
            "nupp.compiler.materialize.observe"
        ).public(require("nupp.compiler.materialize.observe").collect(result.root, path))
        for _, observation in ipairs(observations) do
            settings.materializations[#settings.materializations + 1] = observation
        end
    end
    if settings.derives then
        for _, observation in ipairs(result.deriveObservations or {}) do
            settings.derives[#settings.derives + 1] = observation
        end
    end
    if say(diags) then
        return nil, "type errors"
    end
    local remarks, specializedBodies = require("nupp.compiler.optimize").run(result, {
        level = settings.optLevel or 0,
        filename = path,
        disabled = settings.disabled
    })
    -- The file shape reaches its modules one at a time and has no module graph to
    -- total, so the count is accumulated here the way materializations are.
    if settings.specializedBodies ~= nil then
        settings.specializedBodies = (settings.specializedBodies as integer) + specializedBodies
    end
    if settings.remarks then
        say(remarks)
    end
    local gen = require("nupp.compiler.gen")
    local code, genDiags = gen.generate(
        result,
        path,
        settings.coverage and {path = path} or nil,
        nil,
        nil,
        nil,
        settings.bytecodeBoundary
    )
    if #genDiags > 0 then
        say(genDiags)
        return nil, "code generation errors"
    end

    return code
end

export = compile
