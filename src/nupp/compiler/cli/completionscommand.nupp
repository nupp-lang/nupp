module nupp.compiler.cli.completionscommand

-- `nupp completions`: print shell completion generated from the CLI schema.

local cliModule = require("nupp.cli")
local root = require("nupp.compiler.cli.root")

--- Print a shell completion script.
@cli(name = "completions", parent = root.Root)
@derive(cliModule.Command)
local record Completions
    --- Shell whose completion script to print.
    @cli(positional = "SHELL")
    shell: "bash" | "zsh" | "fish"

    function run(self): integer
        local compilerCLI = require("nupp.compiler.cli") as {completion: function(string): string}
        io.write(compilerCLI.completion(self.shell))
        return 0
    end
end

export = {commandType = Completions}
