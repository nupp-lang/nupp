module nupp.compiler.cli.report

--[[
Diagnostics as JSON, for the reader that is a program.

The text form lives in `nupp.compiler.diagnostics`, where the build and the command line
share it. This is the other reader: `--json` promises line, column, and offset for
every range, including the ranges inside fixes and related locations, and a
diagnostic carries only a byte offset, so each file it mentions is read once and
walked to turn offsets into positions.

See `docs/reference/diagnostics.md` for what the fields mean.
]]

local fs = require("nupp.compiler.fs")
local explain = require("nupp.compiler.explain")
local diagnosticMod = require("nupp.compiler.diagnostics")

local report = {}

--- Walks a source to the line and column an offset falls on. Positions are 1-based byte
--- counts, matching what the text form prints.
local function positionAtByte(source: string?, offset: number?): any
    if not source or not offset or offset < 1 then
        return {line = 0, column = 0, offset = offset or 0}
    end
    local line: integer, lineStart: integer, cursor: integer = 1, 1, 1
    while cursor < offset and cursor <= #source do
        if source:byte(cursor) == 10 then
            line, lineStart = line + 1, cursor + 1
        end
        cursor = cursor + 1
    end

    return {line = line, column = offset - lineStart + 1, offset = offset}
end

--- Reads each file at most once, however many diagnostics point into it.
local function sourceReader(): function(string?): string?
    local sources: {[string]: any} = {}
    return function(path: string?): string?
        if not path then
            return nil
        end
        if sources[path] == nil then
            sources[path] = fs.readFile(path) or false
        end

        return sources[path] or nil
    end
end

local function rangeAt(source: string?, offset: number?, length: number?): any
    local start = positionAtByte(source, offset or 1)
    local span = length or 0
    if source then
        return {start = start, ["end"] = positionAtByte(source, math.min(#source + 1, (offset or 1) + span))}
    end

    return {
        start = start,
        ["end"] = {line = start.line, column = start.column + (length or 1), offset = start.offset + (length or 1)}
    }
end

local function withArrayEmpties(value: unknown, seen: {[unknown]: any}?): unknown
    if type(value) ~= "table" then
        return value
    end
    seen = seen or {}
    if seen[value] then
        return seen[value]
    end
    local copied: {[any]: any} = {}
    seen[value] = copied
    for key, item in pairs(value as table) do
        copied[key] = withArrayEmpties(item, seen)
    end
    if next(copied) == nil then
        return nupp.data.json.asArray(copied)
    end

    return copied
end

--- Encodes a value the way every `--json` command encodes one. Every empty field in
--- this reporting model is a list, so the copy marks those lists explicitly without
--- mutating the compiler data it was handed.
function report.encode(value: unknown): string
    local encoder = nupp.data.json
    return encoder.encode(withArrayEmpties(value))
end

--- Writes one line of JSON to stdout. Never coloured: the reader is a program, and an
--- escape code in a JSON string is a bug in whatever printed it.
function report.write(value: unknown): nil
    io.write(report.encode(value) .. "\n")
end

--- The diagnostics as `--json` promises them: every range resolved to line, column and
--- offset, including the ranges inside fixes and related locations.
function report.diagnosticValues(diagnostics: {any}): {any}
    local read = sourceReader()
    local values: {any} = {}
    for _, e in ipairs(diagnostics) do
        local source = read(e.filename)
        local fixes: {any} = {}
        for _, fix in ipairs(e.fixes or {}) do
            local edits: {any} = {}
            for _, edit in ipairs(fix.edits or {}) do
                edits[
                    #edits + 1
                ] = {
                    file = e.filename,
                    range = {
                        start = positionAtByte(source, edit.offset),
                        ["end"] = positionAtByte(source, edit.offset + edit.length)
                    },
                    newText = edit.newText,
                }
            end
            fixes[#fixes + 1] = {title = fix.title, edits = edits}
        end
        local related: {any} = {}
        for _, item in ipairs(e.related or {}) do
            local relatedFile = item.filename or e.filename
            related[
                #related + 1
            ] = {
                file = relatedFile,
                message = item.message,
                range = rangeAt(read(relatedFile), item.offset, item.length)
            }
        end
        values[#values + 1] = {
            file = e.filename,
            severity = diagnosticMod.severityOf(e),
            code = e.code,
            lint = e.lint,
            -- Derived from the code rather than carried on every diagnostic: one code
            -- always means one section, so storing it at each of the hundreds of places
            -- a diagnostic is raised would only be a way for them to disagree.
            docs = explain.anchor(e.code),
            message = e.msg,
            range = rangeAt(source, e.offset, e.length),
            fixes = fixes,
            help = e.help,
            notes = e.notes or {},
            related = related,
        }
    end

    return values
end

--- A diagnostic about a file rather than a place in it: a path that could not be read
--- or written has no position, so the range fields are zero and the code is the one
--- every command reports for a file the run never got inside.
function report.fileDiagnostic(path: string, msg: string?, help: string): {[string]: any}
    return {filename = path, line = 0, col = 0, offset = 0, length = 0, code = "NUPP0001", msg = msg, help = help}
end

--- Says that a file could not be read or written, the way every command says it: as a
--- diagnostic appended to `collected` when the run is gathering them for `--json`, and
--- as one line on stderr when it is not. Returns the diagnostic either way.
function report.fileFailure(path: string, err: string?, help: string, collected: {any}?): {[string]: any}
    local diagnostic = report.fileDiagnostic(path, err, help)
    if collected then
        collected[#collected + 1] = diagnostic
    else
        io.stderr:write("nupp: " .. tostring(err) .. "\n")
    end

    return diagnostic
end

-- The schema of what the writers above produce, kept beside them for the same reason
-- help is kept beside the option grammar: two descriptions of one thing, in two places,
-- is how they come to disagree. `--schema` prints this, and a test parses real output
-- back against it.
local POSITION = {
    type = "object",
    description = "A 1-based byte position.",
    properties = {line = {type = "integer"}, column = {type = "integer"}, offset = {type = "integer"},},
    required = {"line", "column", "offset"},
}

local RANGE = {type = "object", properties = {start = POSITION, ["end"] = POSITION}, required = {"start", "end"},}

--- A 1-based byte position, and a span of them. Shared so that everything which reports
--- a source location reports it in the same shape.
report.RANGE = RANGE

--- A range in a named file, which is what the semantic operations return.
report.LOCATION = {
    type = "object",
    properties = {file = {type = "string"}, range = RANGE},
    required = {"file", "range"},
}

local EDIT = {
    type = "object",
    properties = {file = {type = "string"}, range = RANGE, newText = {type = "string"},},
    required = {"range", "newText"},
}

--- One diagnostic, as `--json` reports it.
report.DIAGNOSTIC = {
    type = "object",
    properties = {
        file = {type = "string"},
        severity = {type = "string", enum = {"error", "warning", "note"}},
        code = {
            type = "string",
            description = "A stable code such as NUPP2004, or OPT-n for an " .. "optimizer remark."
        },
        lint = {
            type = "string",
            description = "The lint name, when the diagnostic came from one. "
            .. "This is what an @allow suppression writes."
        },
        docs = {
            type = "string",
            description = "The reference section covering this code, as a path "
            .. "and anchor. 'nupp explain <code>' says more."
        },
        message = {type = "string"},
        range = RANGE,
        help = {type = "string", description = "A concrete repair direction."},
        notes = {type = "array", items = {type = "string"}},
        related = {
            type = "array",
            items = {
                type = "object",
                properties = {file = {type = "string"}, message = {type = "string"}, range = RANGE},
                required = {"range"},
            },
        },
        fixes = {
            type = "array",
            description = "Machine-applicable repairs. A fix is all-or-nothing: " .. "apply every edit in it or none.",
            items = {
                type = "object",
                properties = {title = {type = "string"}, edits = {type = "array", items = EDIT}},
                required = {"title", "edits"},
            },
        },
    },
    required = {"severity", "message", "range", "fixes", "notes", "related"},
}

--- The array-of-diagnostics property every command that reports them carries, under
--- that name, so one reader handles all of them.
report.DIAGNOSTICS = {type = "array", items = report.DIAGNOSTIC}

export = report
