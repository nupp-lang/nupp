module nupp.compiler.cli.run

--[[
`nupp run`: compile a program and run it.

The one command whose argument list has two halves. Everything up to the file
name is the compiler's; everything after it belongs to the program, which is why
this grammar stops at the first argument that is not an option. `--profile` and
`--jit-aborts` carry their values attached rather than in the next argument for
the same reason: bare, they must not swallow the file name behind them.

The reports cover the program and not the compiler. The session opens once the
file has compiled and closes when it returns, so the work of getting there stays
out of what is measured, and a program that fails still writes what was collected
before it did.
]]
const {type Session} = require("nupp.compiler.cli.watch")

local usageError = require("nupp.compiler.cli.error").forCommand("run")
local report = require("nupp.compiler.cli.report")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    description = "Normalized LuaJIT trace aborts observed while one program ran.",
    properties = {
        durationSec = {type = "number"},
        totalAborts = {type = "integer"},
        blacklisted = {type = "integer"},
        traceProfile = {
            type = "object",
            properties = {
                id = {type = "string"},
                luajitRevision = {type = "string"},
                luajitVersion = {type = "integer"},
                architecture = {type = "string"},
                operatingSystem = {type = "string"},
                enabledRecorderFeatures = {type = "array", items = {type = "string"}},
                bytecodeSchema = {type = "string"},
                supported = {type = "boolean"},
            },
            required = {"id", "luajitRevision", "architecture", "operatingSystem", "bytecodeSchema"},
        },
        reasonCatalog = {
            type = "object",
            properties = {id = {type = "string"}, version = {type = "integer"}},
            required = {"id", "version"},
        },
        sites = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    severity = {type = "string", enum = {"blacklist", "warn", "info"}},
                    count = {type = "integer"},
                    reason = {type = "string"},
                    reasonId = {type = "string"},
                    class = {type = "string", enum = {"blocker", "risk", "stop"}},
                    rawReason = {type = "string"},
                    location = {type = "string"},
                    rootLocation = {type = "string"},
                    zone = {type = "string"},
                },
                required = {"severity", "count", "reason", "reasonId", "class", "rawReason", "location", "zone"},
            },
        },
    },
    required = {"durationSec", "totalAborts", "blacklisted", "traceProfile", "reasonCatalog", "sites"},
}

local DEFAULT_INTERVAL_MS: integer = 10

local function configureGpuCosts(path: string?): (boolean, string?)
    local ok, problem = pcall(require("nupp.runtime.provider.nativegpu").costsOutput, path)
    return ok, not ok and tostring(problem) or nil
end

local function run(options: any): integer
    local positional: {string} = {options.file}
    for _, value in ipairs(options.arguments) do
        positional[#positional + 1] = value
    end
    local values = options
    local profiling = values.profile ~= nil
    if values.gpuCosts == "" then
        return usageError("--gpu-costs needs an output path")
    end
    local intervalMs: integer = DEFAULT_INTERVAL_MS
    if type(values.profile) == "string" then
        local given = tonumber(values.profile)
        if not given or given < 1 or given ~= math.floor(given) then
            return usageError("--profile takes a whole number of " .. "milliseconds, not " .. values.profile)
        end
        intervalMs = math.floor(given)
    end
    -- Naming where a report should go reads as asking for the report. Saying which flag
    -- is missing beats accepting it quietly and leaving someone waiting on a file that
    -- was never going to be written.
    if values.profileOut and not profiling then
        return usageError("--profile-out names where --profile writes, " .. "which was not asked for")
    end
    local profileOut = values.profileOut or "profile.out"
    local tracingAborts = values.jitAborts ~= nil
    if values.json and not tracingAborts then
        return usageError("--json describes --jit-aborts, which was not asked for")
    end
    if values.jitAborts == "" then
        return usageError("--jit-aborts= requires a file name")
    end
    local abortsOut = values.jitAborts == "\0" and (values.json and "jit-aborts.json" or "jit-aborts.csv")
        or values.jitAborts as string

    local path = positional[1]
    if not path then
        return usageError("a program file is required")
    end
    local watching = values.watch == true
    if watching and not path:find("%.nupp$") then
        return usageError("--watch requires a .nupp program")
    end
    if watching and values.optLevel and values.optLevel ~= "0" then
        return usageError("--watch supports -O0 only; run a normal optimized build before release")
    end
    local programArgs: {string} = {}
    for index = 2, #positional do
        programArgs[#programArgs + 1] = positional[index]
    end

    local compile = require("nupp.compiler.cli.compile")
    local settings = compile.settings(values)
    local sampledRemarks = profiling and settings.remarks
    if sampledRemarks then
        settings.remarks = false
    end
    local projectEnv = require("nupp.compiler.env").new(".")
    local chunk, err
    local watch: Session? = nil
    if watching then
        local session, diagnostics = require("nupp.compiler.cli.watch").open(path, settings.strict)
        if not session then
            require("nupp.compiler.diagnostics").report(diagnostics or {})
            return 1
        end
        watch = session
        chunk, err = loadstring(session.entryCode, "@" .. path)
    elseif path:find("%.nupp$") then
        local code = compile.module(path, projectEnv, settings)
        if not code then
            return 1
        end
        chunk, err = loadstring(code, "@" .. path)
    else
        chunk, err = loadfile(path)
    end
    if not chunk then
        io.stderr:write("nupp: " .. tostring(err) .. "\n")
        return 1
    end

    -- Written before the program starts, because the program is what reads it: a
    -- benchmark reports the optimization level and declined passes it was compiled
    -- under alongside what it measured. At this point it accounts for the entry alone;
    -- it is written again below, once every module the program required has been
    -- compiled, which is the complete account a reader of the file gets.
    compile.writeRemarks(settings)

    local sampling, tracing = nil, nil
    local runtime = require("nupp.compiler.runtime")
    local compileLoaded, loaded
    if watch then
        compileLoaded, loaded = watch.compileLoaded, watch.loaded
    else
        compileLoaded = function(modulePath: string, env: any): string?, string?
            return compile.module(modulePath, env, settings)
        end
    end
    local checkPlain = function(modulePath: string, env: any): boolean
        return compile.check(modulePath, env, {strict = settings.strict, dialect = settings.dialect}) ~= nil
    end
    local preparationDepth = 0

    local function preparing(active: boolean): nil
        preparationDepth = preparationDepth + (active and 1 or -1)
        if preparationDepth > 0 then
            if tracing then
                tracing:pause()
            end
            if sampling then
                sampling:pause()
            end
        else
            if sampling then
                sampling:resume()
            end
            if tracing then
                tracing:resume()
            end
        end
    end

    if values.gpuCosts ~= nil then
        local directory = require("nupp.compiler.fs").dirname(values.gpuCosts)
        local made, makeErr = require("nupp.io.files").createDirectory(directory)
        if not made then
            io.stderr:write("nupp: " .. tostring(makeErr) .. "\n")
            return 1
        end
        local configured, configureErr = configureGpuCosts(values.gpuCosts)
        if not configured then
            io.stderr:write("nupp: " .. tostring(configureErr) .. "\n")
            return 1
        end
    end
    local removeLoader
    if profiling or tracingAborts then
        removeLoader = runtime.install(projectEnv, compileLoaded, loaded, checkPlain, preparing)
    else
        removeLoader = runtime.install(projectEnv, compileLoaded, loaded, checkPlain)
    end
    -- The artifact path is fixed, but an artifact left by an earlier run may still be
    -- present. Tell a library in this run whether this invocation wrote it, without
    -- making the path another piece of program configuration.
    local previousRemarksAvailable = _G.__nuppRemarksAvailable
    _G.__nuppRemarksAvailable = settings.remarksOut ~= nil
    -- Opened here rather than around the compile, so what the report describes is the
    -- program that was asked for and not the compiler that got it ready.
    if profiling or tracingAborts then
        local profile = require("nupp.profile")
        if profiling then
            -- The chunk was named after the file, so that is what its frames say;
            -- everything under them is this command getting there.
            sampling = profile.sample({intervalMs = intervalMs, root = path})
        end
        if tracingAborts then
            tracing = profile.trace({includeBenign = true})
        end
    end

    local ok, runErr = pcall(chunk, unpack(programArgs))
    if tracing then
        tracing:pause()
    end
    if sampling then
        sampling:pause()
    end
    local gpuCostsError: string? = nil
    if values.gpuCosts ~= nil then
        local closed, closeErr = configureGpuCosts(nil)
        if not closed then
            gpuCostsError = closeErr
        end
    end
    _G.__nuppRemarksAvailable = previousRemarksAvailable
    removeLoader()
    if watch then
        watch.finish(ok)
    end

    -- Before the program's own failure is reported: a run that ended badly is the one
    -- whose profile is most worth having, and stopping first keeps the reporting out of
    -- the samples.
    if sampling then
        local summary = sampling:stop(profileOut)
        compile.attachSamples(settings, summary.sourceSamples, summary.samples, summary.intervalMs)
        if sampledRemarks then
            require(
                "nupp.compiler.diagnostics"
            ).report(compile.selectRemarks(settings.collectedRemarks or {}, settings.remarksFile))
        end
        io.stderr:write(
            (
                "nupp: %d samples on %d stacks every %dms, written to " .. "%s\n"
            ):format(summary.samples, summary.stacks, summary.intervalMs, profileOut)
        )
    end
    -- Complete after lazy loading and sampling, so the artifact carries runtime heat.
    compile.writeRemarks(settings)
    if tracing then
        -- Stop collecting before any report serialization or filesystem work. Both
        -- formats then use the checked atomic writer below, so a failed CSV write is
        -- handled the same way as JSON rather than raising out of TraceSession:stop.
        local summary = tracing:stop()
        local content: string
        if values.json then
            local sites = {}
            for _, site in ipairs(summary.sites) do
                sites[
                    #sites + 1
                ] = {
                    severity = site.severity,
                    count = site.count,
                    reason = site.reason,
                    reasonId = site.reasonId,
                    class = site.reasonClass,
                    rawReason = site.rawReason,
                    location = site.location,
                    rootLocation = site.rootLocation,
                    zone = site.zonePath,
                }
            end
            local document = {
                durationSec = summary.durationSec,
                totalAborts = summary.totalAborts,
                blacklisted = summary.blacklisted,
                traceProfile = summary.traceProfile,
                reasonCatalog = {id = summary.reasonCatalogId, version = summary.reasonCatalogVersion,},
                sites = sites,
            }
            -- `NaN` and `Infinity` are not JSON, so a document carrying one is one a
            -- strict reader rejects whole. Refusing to write it says which run produced
            -- the bad duration instead of leaving that to whatever reads the file.
            content = report.encode(document) .. "\n"
        else
            content = tostring(summary)
        end
        local wrote, writeErr = require("nupp.compiler.fs").writeFile(abortsOut, content)
        if not wrote then
            io.stderr:write("nupp: " .. tostring(writeErr) .. "\n")
            -- The program's own failure still gets reported: losing the trace
            -- report is no reason to also lose the error the run ended on.
            if not ok then
                io.stderr:write("nupp: " .. tostring(runErr) .. "\n")
            end

            return 1
        end
        io.stderr:write(
            (
                "nupp: %d trace aborts, %d blacklisted, written to " .. "%s\n"
            ):format(summary.totalAborts, summary.blacklisted, abortsOut)
        )
    end

    if gpuCostsError ~= nil then
        io.stderr:write("nupp: " .. tostring(gpuCostsError) .. "\n")
    end
    if not ok then
        io.stderr:write("nupp: " .. tostring(runErr) .. "\n")
        return 1
    end

    return gpuCostsError ~= nil and 1 or 0
end

--- Compile and run a Nupp or Lua program.
---
--- The program path divides compiler options from arguments passed to the
--- loaded chunk. Profiling and trace-abort reports cover the program only.
--- Use `--` before a program path beginning with a dash. `--profile` writes
--- collapsed-stack samples, while `--jit-aborts` records where LuaJIT stopped
--- tracing. `--watch` is development-only, uses `-O0`, and applies valid
--- changed-body patches at cooperative poll boundaries.
---
--- Examples:
---
---     nupp run src/main.nupp
---     nupp run src/main.nupp first second
---     nupp run --profile=2 --profile-out hot.txt src/main.nupp
---     nupp run --jit-aborts=jit-aborts.csv src/main.nupp
@cli(name = "run", stopAtFirstArgument = true)
@derive(cliModule.Command)
local record Run
    --- Check the program under the strict floor.
    strict: boolean = false

    --- Optimization level.
    @cli(
        name = "O",
        long = false,
        pattern = "^%-O([0-2])$",
        choices = {"0", "1", "2"},
        display = "-O0, -O1, -O2",
        value = "LEVEL"
    )
    optLevel: string?

    --- Report what the optimizer did and what it declined to do.
    remarks: boolean = false

    --- Only report optimizer decisions for this source file.
    @cli(value = "PATH")
    remarksFile: string?

    --- Write the optimizer account to build/remarks.json.
    remarksOut: boolean = false

    --- Turn off one optimizer pass by stable code.
    @cli(short = "Zno-opt", long = false, arity = "attachedOnly", value = "CODE")
    disabled: {[string]: boolean} = {}

    --- Keep named function identities patchable at poll points.
    watch: boolean = false

    --- Sample the program, optionally with an attached interval.
    @cli(arity = "optionalAttached", constant = "10", value = "MS")
    profile: string?

    --- File which receives profiling samples.
    @cli(value = "PATH")
    profileOut: string?

    --- Write GPU operation costs and device timestamps to this JSONL file.
    @cli(value = "PATH")
    gpuCosts: string?

    --- Record JIT aborts, optionally naming an attached output path.
    @cli(arity = "optionalAttached", constant = "\0", value = "PATH")
    jitAborts: string?

    --- Write JIT aborts as JSON rather than CSV.
    json: boolean = false

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Program to compile and run.
    @cli(positional = "FILE")
    file: string

    --- Arguments passed to the program.
    @cli(remainder = true, value = "ARG")
    arguments: {string} = {}

    function run(self): integer
        return run(self)
    end
end

function Run.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Run}
