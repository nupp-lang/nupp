module nupp.compiler.cli.run

--[[
`nupp run`: compile a program and run it.

The one command whose argument list has two halves. Everything up to the file
name is the compiler's; everything after it belongs to the program, which is why
this grammar stops at the first argument that is not an option. `--profile` and
`--jit-aborts` carry their values attached rather than in the next argument for
the same reason: bare, they must not swallow the file name behind them.

The reports cover the program and not the compiler. The session opens once the
file has compiled and closes when it returns, so the work of getting there stays
out of what is measured, and a program that fails still writes what was collected
before it did.
]]

local spec = require("nupp.compiler.cli.spec")
local optionsMod = require("nupp.compiler.cli.options")
local report = require("nupp.compiler.cli.report")

local command = spec.command{
    name = "run",
    summary = "Compile and run a Nupp or Lua program",
    usage = {
        "nupp run [--strict] [-O<n>] [--watch] [--profile[=MS]] [--profile-out PATH]",
        "         [--jit-aborts[=PATH]] [--json] <file> [args...]",
    },
    stopAtPositional = true,
    options = optionsMod.join(
        optionsMod.strict,
        optionsMod.optimize(),
        {name = "--watch", help = "Keep named function identities patchable at cooperative poll points"},
        {
            name = "--profile",
            value = "MS",
            form = "optional",
            help = "Sample the program every MS milliseconds (default 10)"
        },
        {name = "--profile-out", value = "PATH", help = "Where the samples go (default profile.out)"},
        {
            name = "--jit-aborts",
            value = "PATH",
            form = "optional",
            help = "Record where the JIT gave up (default jit-aborts.csv)"
        },
        {name = "--json", help = "Write --jit-aborts as structured JSON instead of CSV"}
    ),
    schema = {
        type = "object",
        description = "Normalized LuaJIT trace aborts observed while one program ran.",
        properties = {
            durationSec = {type = "number"},
            totalAborts = {type = "integer"},
            blacklisted = {type = "integer"},
            traceProfile = {
                type = "object",
                properties = {
                    id = {type = "string"},
                    luajitRevision = {type = "string"},
                    luajitVersion = {type = "integer"},
                    architecture = {type = "string"},
                    operatingSystem = {type = "string"},
                    enabledRecorderFeatures = {type = "array", items = {type = "string"}},
                    bytecodeSchema = {type = "string"},
                    supported = {type = "boolean"},
                },
                required = {"id", "luajitRevision", "architecture", "operatingSystem", "bytecodeSchema"},
            },
            reasonCatalog = {
                type = "object",
                properties = {id = {type = "string"}, version = {type = "integer"}},
                required = {"id", "version"},
            },
            sites = {
                type = "array",
                items = {
                    type = "object",
                    properties = {
                        severity = {type = "string", enum = {"blacklist", "warn", "info"}},
                        count = {type = "integer"},
                        reason = {type = "string"},
                        reasonId = {type = "string"},
                        class = {type = "string", enum = {"blocker", "risk", "stop"}},
                        rawReason = {type = "string"},
                        location = {type = "string"},
                        zone = {type = "string"},
                    },
                    required = {"severity", "count", "reason", "reasonId", "class", "rawReason", "location", "zone"},
                },
            },
        },
        required = {"durationSec", "totalAborts", "blacklisted", "traceProfile", "reasonCatalog", "sites"},
    },
    detail = [[Program arguments are passed to the loaded chunk. Use '--' before a file name
that starts with a dash.

--profile writes collapsed-stack text: one line per stack, frames separated by
semicolons, then the sample count. speedscope.app, FlameGraph.pl and inferno
all read it directly. Frames are prefixed by the zone path that was open, so a
program that calls nupp.profile.zone reports itself in its own terms, and the leaf
carries the VM state most of its samples were in: N compiled, I interpreted,
C in a C function, G collecting, J compiling.

--jit-aborts answers the question a sampler cannot: whether the hot code was
compiled at all. It writes CSV, one row per place the compiler gave up, with a
blacklisted trace, permanently demoted to the interpreter, ranked first.

Both cover the program only: the session opens once the file has compiled and
closes when it returns, so the compiler's own work stays out of the report. A
program that fails still writes what was collected before it did. Each reports
a summary line on stderr.

--watch is development-only and always uses -O0. A long-running program calls
nupp.hotreload.poll() at a safe loop or request boundary.
The poll scans inputs, stages a valid changed-body patch, commits it,
and leaves the last good generation running after diagnostics or a required
restart. Programs that never return to such a boundary cannot reload
cooperatively.]],
}

local DEFAULT_INTERVAL_MS: integer = 10

local function run(parsed: any): integer
    local values = parsed.values
    local positional: {string} = parsed.positional
    local profiling = values.profile ~= nil
    local intervalMs: integer = DEFAULT_INTERVAL_MS
    if type(values.profile) == "string" then
        local given = tonumber(values.profile)
        if not given or given < 1 or given ~= math.floor(given) then
            return command:usageError("--profile takes a whole number of " .. "milliseconds, not " .. values.profile)
        end
        intervalMs = math.floor(given)
    end
    -- Naming where a report should go reads as asking for the report. Saying which flag
    -- is missing beats accepting it quietly and leaving someone waiting on a file that
    -- was never going to be written.
    if values.profileOut and not profiling then
        return command:usageError("--profile-out names where --profile writes, " .. "which was not asked for")
    end
    local profileOut = values.profileOut or "profile.out"
    local tracingAborts = values.jitAborts ~= nil
    if values.json and not tracingAborts then
        return command:usageError("--json describes --jit-aborts, which was not asked for")
    end
    if values.jitAborts == "" then
        return command:usageError("--jit-aborts= requires a file name")
    end
    local abortsOut = type(
        values.jitAborts
    ) == "string" and values.jitAborts or values.json and "jit-aborts.json" or "jit-aborts.csv"

    local path = positional[1]
    if not path then
        return command:usageError("a program file is required")
    end
    local watching = values.watch == true
    if watching and not path:find("%.nupp$") then
        return command:usageError("--watch requires a .nupp program")
    end
    if watching and values.optLevel and values.optLevel ~= "0" then
        return command:usageError("--watch supports -O0 only; run a normal optimized build before release")
    end
    local programArgs: {string} = {}
    for index = 2, #positional do
        programArgs[#programArgs + 1] = positional[index]
    end

    local compile = require("nupp.compiler.cli.compile")
    local settings = compile.settings(values)
    local projectEnv = require("nupp.compiler.env").new(".")
    local chunk, err
    local watch: nupp.compiler.cli.watch.Session? = nil
    if watching then
        local session, diagnostics = require("nupp.compiler.cli.watch").open(path, settings.strict)
        if not session then
            require("nupp.compiler.diagnostics").report(diagnostics or {})
            return 1
        end
        watch = session
        chunk, err = loadstring(session.entryCode, "@" .. path)
    elseif path:find("%.nupp$") then
        local code = compile.module(path, projectEnv, settings)
        if not code then
            return 1
        end
        chunk, err = loadstring(code, "@" .. path)
    else
        chunk, err = loadfile(path)
    end
    if not chunk then
        io.stderr:write("nupp: " .. tostring(err) .. "\n")
        return 1
    end

    -- Opened here rather than around the compile, so what the report describes is the
    -- program that was asked for and not the compiler that got it ready.
    local sampling, tracing = nil, nil
    if profiling or tracingAborts then
        local profile = require("nupp.profile")
        if profiling then
            -- The chunk was named after the file, so that is what its frames say;
            -- everything under them is this command getting there.
            sampling = profile.sample({intervalMs = intervalMs, root = path})
        end
        if tracingAborts then
            tracing = profile.trace()
        end
    end

    local runtime = require("nupp.compiler.runtime")
    local compileLoaded, loaded
    if watch then
        compileLoaded, loaded = watch.compileLoaded, watch.loaded
    else
        compileLoaded = function(modulePath: string, env: any): string?, string?
            return compile.module(modulePath, env, settings)
        end
    end
    local removeLoader = runtime.install(projectEnv, compileLoaded, loaded)
    local ok, runErr = pcall(chunk, unpack(programArgs))
    removeLoader()
    if watch then
        watch.finish(ok)
    end

    -- Before the program's own failure is reported: a run that ended badly is the one
    -- whose profile is most worth having, and stopping first keeps the reporting out of
    -- the samples.
    if sampling then
        local summary = sampling:stop(profileOut)
        io.stderr:write(
            (
                "nupp: %d samples on %d stacks every %dms, written to " .. "%s\n"
            ):format(summary.samples, summary.stacks, summary.intervalMs, profileOut)
        )
    end
    if tracing then
        -- Stop collecting before any report serialization or filesystem work. Both
        -- formats then use the checked atomic writer below, so a failed CSV write is
        -- handled the same way as JSON rather than raising out of TraceSession:stop.
        local summary = tracing:stop()
        local content: string
        if values.json then
            local sites = {}
            for _, site in ipairs(summary.sites) do
                sites[
                    #sites + 1
                ] = {
                    severity = site.severity,
                    count = site.count,
                    reason = site.reason,
                    reasonId = site.reasonId,
                    class = site.reasonClass,
                    rawReason = site.rawReason,
                    location = site.location,
                    zone = site.zonePath,
                }
            end
            local document = {
                durationSec = summary.durationSec,
                totalAborts = summary.totalAborts,
                blacklisted = summary.blacklisted,
                traceProfile = summary.traceProfile,
                reasonCatalog = {id = summary.reasonCatalogId, version = summary.reasonCatalogVersion,},
                sites = sites,
            }
            -- `NaN` and `Infinity` are not JSON, so a document carrying one is one a
            -- strict reader rejects whole. Refusing to write it says which run produced
            -- the bad duration instead of leaving that to whatever reads the file.
            content = report.encode(document) .. "\n"
        else
            content = tostring(summary)
        end
        local wrote, writeErr = require("nupp.compiler.fs").writeFile(abortsOut, content)
        if not wrote then
            io.stderr:write("nupp: " .. tostring(writeErr) .. "\n")
            -- The program's own failure still gets reported: losing the trace
            -- report is no reason to also lose the error the run ended on.
            if not ok then
                io.stderr:write("nupp: " .. tostring(runErr) .. "\n")
            end

            return 1
        end
        io.stderr:write(
            (
                "nupp: %d trace aborts, %d blacklisted, written to " .. "%s\n"
            ):format(summary.totalAborts, summary.blacklisted, abortsOut)
        )
    end

    if not ok then
        io.stderr:write("nupp: " .. tostring(runErr) .. "\n")
        return 1
    end

    return 0
end

export = new spec.Handler(spec = command, run = run)
