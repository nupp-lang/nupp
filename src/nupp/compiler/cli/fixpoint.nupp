module nupp.compiler.cli.fixpoint

--[[
`nupp fixpoint`: the claim that the compiler reproduces itself.

Two claims, really. The default one is about the compiler: starting from the
stage zero a checkout is pinned to, it compiles itself three times and the last
two results must agree. `--binary` is about packaging: the stamped binary must
stamp another identical to itself, which is what the payload format's
determinism rests on.
]]

local spec = require("nupp.compiler.cli.spec")

local command = spec.command{
    name = "fixpoint",
    summary = "Verify a byte-identical self-hosting rebuild",
    usage = {"nupp fixpoint [--emit-stage0 PATH] [--format text|json]", "nupp fixpoint --binary [--format text|json]",},
    intro = [[By default the stage-zero compiler builds stage one, stage one builds
stage two, stage two builds stage three, and stages two and three must be byte
identical. Stage zero is a published release rather than a file in the tree, so
it is meant to differ from the current compiler and nothing compares it with one;
the first stage is what absorbs that difference.

--emit-stage0 writes the stage-zero bundle the verified compiler composes, which
is the artifact a release publishes for the next checkout to start from.

--binary makes the same claim about packaging: the target named by
selfHost.binary is stamped, and the binary that comes out stamps another
identical to itself. It is what the payload format's determinism rests on.]],
    options = require(
        "nupp.compiler.cli.options"
    ).join(
        {name = "--emit-stage0", value = "PATH", help = "Write the verified stage-zero bundle here"},
        {name = "--binary", help = "Verify the packaged binary instead of the compiler"},
        require("nupp.compiler.cli.options").format()
    ),
    schema = {
        type = "object",
        properties = {
            ok = {type = "boolean", description = "Whether the rebuild reproduced itself."},
            kind = {
                type = "string",
                enum = {"compiler", "binary"},
                description = "Which claim was checked: the compiler compiling "
                .. "itself from stage zero, or the packaged binary stamping another."
            },
            target = {type = "string", description = "The manifest target that was verified."},
            stage0 = {type = "string", description = "The stage-zero compiler the run started from."},
            emittedStage0 = {type = "string", description = "Where the stage-zero bundle was written, if anywhere."},
            bytes = {type = "integer", description = "The size of the verified binary, for --binary."},
            reason = {type = "string", description = "Why it failed. Absent when ok is true."},
        },
        required = {"ok", "kind"},
    },
}

local function run(parsed: any): integer
    local positional: {string} = parsed.positional
    if #positional > 0 then
        return command:usageError("unexpected argument " .. positional[1])
    end
    local values = parsed.values
    if values.binary and values.emitStage0 then
        return command:usageError("--binary verifies the packaged binary and composes no stage zero")
    end
    local asJson = values.format == "json"
    local project = require("nupp.compiler.build.project")
    -- The collector doubles as the request to stay quiet: what it fills is what gets
    -- said, so the human line does not land in front of the document.
    local result: {[string]: any} = {}
    local code: integer
    if values.binary then
        code = project.binaryFixpoint(".", {result = asJson and result or nil})
    else
        code = project.fixpoint(".", {emitStage0 = values.emitStage0, result = asJson and result or nil})
    end
    if asJson then
        result.ok = code == 0
        result.kind = values.binary and "binary" or "compiler"
        require("nupp.compiler.cli.report").write(result)
    end

    return code
end

export = new spec.Handler(spec = command, run = run)
