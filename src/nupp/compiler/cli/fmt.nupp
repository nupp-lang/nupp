module nupp.compiler.cli.fmt

--[[
`nupp fmt`: formatting, as a filter or as a question.

Naming files makes it a filter: each is formatted to stdout, or rewritten with
--write. Naming none makes the project the subject, and a filter is then the
wrong shape, since printing forty files to stdout answers nothing anybody asked, so
what comes back is the list of files that are not formatted, and a non-zero
status a build can gate on.

--check asks that same question of whatever it was given, so a build can gate on
the files a change touched rather than on the whole tree.
]]

local usageError = require("nupp.compiler.cli.error").forCommand("fmt")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    description = "Which files are not formatted, and what was done about it.",
    properties = {
        unformatted = {
            type = "array",
            items = {type = "string"},
            description = "Files whose formatting differs from the "
            .. "formatter's. Under --write these are the files that "
            .. "were rewritten."
        },
        written = {
            type = "boolean",
            description = "Whether the files listed were rewritten rather " .. "than merely reported."
        },
        failed = {
            type = "array",
            description = "Files that could not be formatted at all, which "
            .. "is a different answer from being unformatted.",
            items = {
                type = "object",
                properties = {file = {type = "string"}, diagnostics = require("nupp.compiler.cli.report").DIAGNOSTICS},
                required = {"file", "diagnostics"},
            },
        },
        ok = {type = "boolean", description = "True when nothing was left unformatted and " .. "nothing failed."},
    },
    required = {"ok", "unformatted", "written", "failed"},
}

local function run(options: any): integer
    local positional: {string} = options.files
    local values = options
    local write, asking = values.write, values.check
    if write and asking then
        return usageError(
            "--write and --check ask for opposite things: one fixes the " .. "formatting, the other reports it"
        )
    end
    local width: integer = 120
    if values.width then
        local given = tonumber(values.width)
        if not given or given < 20 or given ~= math.floor(given) then
            return usageError("--width takes a whole number of columns, at least 20, not " .. values.width)
        end
        width = math.floor(given)
    end
    local fs = require("nupp.compiler.fs")
    local fmt = require("nupp.compiler.fmt")
    local envMod = require("nupp.compiler.env")
    local diagnosticMod = require("nupp.compiler.diagnostics")
    local reportMod = require("nupp.compiler.cli.report")
    local asJson = values.format == "json"
    local env = envMod.new(".")
    -- The manifest's default, unless --no-method-parens overrides it for this run;
    -- there is no flag to force it back on over a manifest that turned it off, the same
    -- one-way shape as --no-color over --color.
    local methodParens = not values.noMethodParens and envMod.fmtMethodParensDefault(env)
    -- One instance, resolved once and reused for every file: `resolveAnnotation` closes
    -- over `currentPath` rather than a fixed path, since the same formatter answers for
    -- whichever file is being formatted right now.
    local currentPath = ""
    local formatter = fmt.new({
        environment = env,
        annotations = env.annotations,
        resolveAnnotation = function(name: string): any
            return env.resolveProjectAnnotation(env, currentPath, name)
        end,
        methodParens = methodParens,
        width = width,
    })
    local paths: {string} = positional
    local wholeProject = #paths == 0
    -- The project form and --check both ask rather than transform, so both report a
    -- list; naming files without --check stays the filter it has always been. Asking
    -- for JSON is asking for the answer, so it reports whatever it was given.
    local reporting = asking or wholeProject or asJson
    local failures: {any} = {}

    local function finish(code: integer, unformatted: {string}): integer
        if asJson then
            reportMod.write({
                ok = code == 0,
                written = write and true or false,
                unformatted = unformatted,
                failed = failures
            })
        end

        return code
    end

    if wholeProject then
        paths = envMod.listSourceFiles(env)
        if #paths == 0 then
            io.stderr:write("nupp: no source files found under the project's " .. "include roots\n")
            return finish(1, {})
        end
    end
    -- Whether a file already formats to itself is a pure function of its bytes, the
    -- options, and the annotations the project declares -- so the answer keeps, and
    -- `nupp fmt --check` over an unchanged project is the gate a build runs on every
    -- commit.
    --
    -- Both answers are stored, not just "already formatted". A project that is largely
    -- unformatted is the ordinary case for a gate, and it is exactly the case where
    -- every run would otherwise format every file to rediscover what the last run
    -- discovered.
    --
    -- Only a run that needs no text can act on a stored answer. `--write` needs the
    -- formatted bytes for a file that is not formatted, so a negative verdict tells it
    -- nothing it can use; the filter form needs them for every file, and is excluded
    -- entirely.
    local settled = reporting and envMod.formatStore(env) or nil
    local textNeeded = write and true or false
    local hashMod = require("nupp.compiler.build.hash")
    local digest = env.compilerServices
        and env.compilerServices.hash
        and env.compilerServices.hash.digest
        or hashMod.digest
    local optionsKey = nil

    local function verdictKey(path: string, source: string): string
        if not optionsKey then
            optionsKey = digest(
                tostring(
                    methodParens
                ) .. "\0" .. tostring(width) .. "\0" .. envMod.annotationKey(env) .. "\0" .. fmt.importsKey(env)
            )
        end

        return digest(optionsKey .. "\0" .. path .. "\0" .. source)
    end

    local failed = false
    local unformatted: {string} = {}

    -- A file that could not be read or written is a failure of its own, listed under
    -- its path with the one diagnostic that says so.
    local function fileFailure(path: string, err: string?, help: string): nil
        local collected = asJson and {} or nil
        reportMod.fileFailure(path, err, help, collected)
        if collected then
            failures[#failures + 1] = {file = path, diagnostics = reportMod.diagnosticValues(collected)}
        end
    end

    for _, path in ipairs(paths) do
        local source, err = fs.readFile(path)
        -- Looked up once above the chain: the key digests the whole file, so an arm
        -- that asked for itself would hash the file again.
        local verdict = source and settled and settled.get(verdictKey(path, source)) or nil
        if not source then
            fileFailure(path, err, "check that the path exists and is readable")
            failed = true
        elseif verdict == "same" then
            -- Known to format to itself: nothing to report and nothing to rewrite.
            -- Parsing the file and laying it out is the whole cost of finding that out,
            -- which is why it is worth not doing twice.
        elseif not textNeeded and verdict == "differs" then
            unformatted[#unformatted + 1] = path
        else
            currentPath = path
            local formatted, errors = formatter:format(source, path)
            -- A file that could not be formatted at all is not recorded: that is a
            -- diagnostic about the file rather than a verdict on its layout, and the
            -- next run has to say it again.
            if settled and #errors == 0 then
                settled.put(verdictKey(path, source), formatted == source and "same" or "differs")
            end
            if #errors > 0 then
                -- Could not be formatted, which is a different answer from being
                -- unformatted, and the list form cannot tell them apart.
                if asJson then
                    failures[#failures + 1] = {file = path, diagnostics = reportMod.diagnosticValues(errors)}
                else
                    diagnosticMod.report(errors)
                end
                failed = true
            elseif write then
                if formatted ~= source then
                    -- Staged and renamed with the result checked, so a full disk
                    -- truncates a temporary file rather than the user's source, and
                    -- a failed rewrite is a reported failure rather than a raised
                    -- one that abandons the remaining files.
                    local wrote, writeErr = fs.writeFile(path, formatted)
                    if not wrote then
                        fileFailure(path, tostring(writeErr), "check that the path is writable")
                        failed = true
                    else
                        unformatted[#unformatted + 1] = path
                    end
                end
            elseif reporting then
                if formatted ~= source then
                    unformatted[#unformatted + 1] = path
                end
            else
                -- A named file is written out whether or not it changed: this is the
                -- filter form, and a filter that sometimes emits nothing is a filter
                -- that sometimes empties a file.
                io.write(formatted)
            end
        end
    end
    envMod.persist(env)
    if reporting then
        if #unformatted > 0 and not asJson then
            io.write(table.concat(unformatted, "\n"), "\n")
        end
        -- Rewriting them answered the question, so only the form that merely asked it
        -- reports a failure.
        if not write and #unformatted > 0 then
            failed = true
        end
    end

    return finish(failed and 1 or 0, unformatted)
end

--- Format Nupp source.
---
--- With named files, formats each to stdout or rewrites it. With none, reports
--- files in the project which are not formatted.
---
--- Examples:
---
---     nupp fmt --check
---     nupp fmt --write src/main.nupp
---     nupp fmt --width 100 src/main.nupp
@cli("fmt")
@derive(cliModule.Command)
local record Fmt
    --- Rewrite files in place instead of writing to stdout.
    @cli(short = "w")
    write: boolean = false

    --- Report files which are not formatted and write nothing.
    check: boolean = false

    --- Preserve method-call sugar without parentheses.
    noMethodParens: boolean = false

    --- Code column after which a line may break.
    @cli(value = "N", invalid = "width must be a whole number")
    width: integer?

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source files to format.
    @cli(positional = "FILE")
    files: {string} = {}

    function run(self): integer
        return run(self)
    end
end

function Fmt.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Fmt}
