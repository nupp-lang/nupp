module nupp.compiler.cli.watch

--[[
`nupp run --watch`: the entry built once, and every module after it kept live.

`run` installs a loader that compiles a module the first time the program asks for
it. Under `--watch` that loader has to do more: record what each module depended
on, hand the program a `nupp.hotreload.poll` that notices those inputs changing
and commits a new generation, and seal or abort each module as it finishes
loading. This is that wiring, apart from `run`, so `run` sees the same two loader
callbacks whether it is watching or not and one finishing step when it is.
]]

local watch = {}

--- Watching a session's inputs, staging what changed, and publishing it.
---
--- The half of a watch that does not depend on how the running modules got there:
--- `run --watch` compiles and loads them itself, and an embedding host attaches to
--- a component that already loaded its own, but from here on both watch the same
--- inputs and commit the same way.
type watch.Driver = {
    --- Stages a patch without changing anything that is running.
    prepare: function(): any,

    --- Publishes what `prepare` staged. `poll` is the two together, which is what
    --- a watching command wants; a host that compiles away from its safe point
    --- wants them apart.
    apply: function(): any,
    poll: function(): any,

    --- Re-reads every input the session now watches, so what follows is compared
    --- against what is on disk rather than against what was there before a module
    --- joined the session.
    resetInputs: function(): nil
}

--- What `run` gets back from opening a watch: the entry's code to load, the two
--- loader callbacks in place of the plain compile, and the step that seals or
--- abandons the entry once its chunk returns.
type watch.Session = {
    entryCode: string,
    compileLoaded: function(modulePath: string, env: any): (string?, string?),
    loaded: function(module: string, modulePath: string, ok: boolean): nil,
    finish: function(ok: boolean): nil,
    prepare: function(): any,
    apply: function(): any,
    poll: function(): any
}

--- Reports what a session noticed it could not pin, once per loader name.
local function reportWatchNotices(ack: any): nil
    for _, name in ipairs(ack and ack.unverifiedLibraries or {}) do
        if name == "<dynamic ffi.load>" then
            io.stderr:write("nupp: dynamic ffi.load is not tracked in watch mode\n")
        else
            io.stderr:write(
                ("nupp: C declarations for %q are checked; its binary identity is unverified\n"):format(name)
            )
        end
    end
end

watch.reportNotices = reportWatchNotices

--- Opens the watching half around a session whose modules are already accounted
--- for.
---
--- `settle` runs before every prepare. `run --watch` uses it to acknowledge an entry
--- whose chunk may never return, since a cooperative boundary is the proof that
--- initialization reached a safe point; a host that attached has nothing to settle.
function watch.driver(watchSession: any, settle: (function(): nil)?): watch.Driver
    local hotRuntime = require("nupp.runtime.hotreload")
    local fs = require("nupp.compiler.fs")
    local seen: {[string]: any} = {}

    local function watchFingerprint(input: any): string
        local bytes = fs.readFile(input.path)
        local content = bytes and ("present\0" .. bytes) or "missing"
        if input.kind == "native-artifact" then
            return fs.canonical(input.path) .. "\0" .. content
        end

        return content
    end

    local function resetInputs(): nil
        seen = {}
        for _, input in ipairs(watchSession:watchedInputs()) do
            seen[input.path] = {kind = input.kind, fingerprint = watchFingerprint(input)}
        end
    end

    local function changedInputs(): {string}
        local changed: {string} = {}
        local current: {[string]: boolean} = {}
        for _, input in ipairs(watchSession:watchedInputs()) do
            current[input.path] = true
            local fingerprint = watchFingerprint(input)
            local prior = seen[input.path]
            if not prior or prior.kind ~= input.kind or prior.fingerprint ~= fingerprint then
                seen[input.path] = {kind = input.kind, fingerprint = fingerprint}
                watchSession:diskChanged(input.path, fs.readFile(input.path) == nil and 3 or 2)
                changed[#changed + 1] = input.path
            end
        end
        for watchedPath in pairs(seen) do
            if not current[watchedPath] then
                seen[watchedPath] = nil
                watchSession:diskChanged(watchedPath, 3)
                changed[#changed + 1] = watchedPath
            end
        end

        return changed
    end

    -- A staged patch: everything fallible about it has already happened, and
    -- nothing in the running process has changed. It waits here until a commit
    -- publishes it, or until a later `prepare` supersedes it.
    local pending: any = nil

    local function prepare(): any
        if settle then
            settle()
        end
        local changed = changedInputs()
        if #changed == 0 then
            return {kind = "no-change", generation = watchSession.generation}
        end
        pending = nil
        local result = watchSession:prepare(changed)
        if result.kind == "prepared" then
            local staged, reason = hotRuntime.stage(result.patch, result.baseGeneration)
            if not staged then
                resetInputs()

                return {kind = "diagnostics", diagnostics = {{msg = reason}}}
            end
            pending = staged
        elseif result.diagnostics then
            require("nupp.compiler.diagnostics").report(result.diagnostics)
            io.stderr:write(("nupp: generation %d remains running\n"):format(watchSession.generation))
        end
        resetInputs()

        return result
    end

    local function apply(): any
        if not pending then
            return {kind = "no-change", generation = watchSession.generation}
        end
        local staged = pending
        pending = nil
        local generation, commitError = hotRuntime.commit(staged)
        if not generation then
            return {kind = "diagnostics", diagnostics = {{msg = commitError}}}
        end
        reportWatchNotices(watchSession:committed(generation))
        io.stderr:write(("nupp: committed hot generation %d\n"):format(generation))

        return {kind = "prepared", generation = generation}
    end

    local function poll(): any
        local result = prepare()
        if result.kind ~= "prepared" then
            return result
        end

        return apply()
    end

    resetInputs()

    return {prepare = prepare, apply = apply, poll = poll, resetInputs = resetInputs}
end

--- Builds the entry once and opens the session around it. Returns nil and the
--- diagnostics that stopped the initial build when there is nothing to run.
---
--- `root` is the project the session compiles against. `run` leaves it out and gets
--- the directory it was invoked from; an embedding host names the project it is
--- watching, because the process it belongs to was not started there.
function watch.open(path: string, strict: boolean?, root: string?): (watch.Session?, {any}?)
    local hotRuntime = require("nupp.runtime.hotreload")
    -- Gradual, as it was in `run`: the session's results are unions the poll below
    -- reads by the fields each kind carries.
    local watchSession: any = require("nupp.compiler.hotsession").new(root or ".", {strict = strict})
    local initialBuild = watchSession:initial({path})
    if initialBuild.kind ~= "initial" then
        return nil, initialBuild.diagnostics or {}
    end
    local entryManifest = initialBuild.entryManifest
    local pendingManifests: {[string]: any} = {}
    local entryAcknowledged = false
    local driver: watch.Driver? = nil

    local function compileLoaded(modulePath: string, env: any): string?, string?
        local module = require("nupp.compiler.env").moduleNameForPath(watchSession.inc.env, modulePath) or modulePath
        local built, failure = watchSession:compile(modulePath, "initial", module)
        if not built then
            require("nupp.compiler.diagnostics").report(failure.diagnostics or {})
            return nil, failure.kind
        end
        pendingManifests[module] = built.manifest

        return built.code
    end

    local function loaded(module: string, modulePath: string, ok: boolean): nil
        local manifest = pendingManifests[module]
        pendingManifests[module] = nil
        if ok then
            hotRuntime.seal(module)
            reportWatchNotices(watchSession:loaded(module, watchSession.generation, manifest))
            if driver then
                driver.resetInputs()
            end
        else
            hotRuntime.abort(module)
        end
    end

    local function ensureEntryLoaded(): nil
        if entryAcknowledged then
            return
        end
        hotRuntime.seal(entryManifest.module)
        reportWatchNotices(watchSession:loaded(entryManifest.module, watchSession.generation, entryManifest))
        entryAcknowledged = true
        if driver then
            driver.resetInputs()
        end
    end

    driver = watch.driver(watchSession, ensureEntryLoaded)
    local watching: watch.Driver = driver as watch.Driver

    local function finish(ok: boolean): nil
        if ok then
            if not entryAcknowledged then
                hotRuntime.seal(entryManifest.module)
                reportWatchNotices(watchSession:loaded(entryManifest.module, watchSession.generation, entryManifest))
            end
        else
            hotRuntime.abort(entryManifest.module)
        end
        watchSession:persist()
    end

    _G.nupp = _G.nupp or {}
    _G.nupp.hotreload = {
        generation = function(): integer
            return hotRuntime.generation()
        end,
        poll = watching.poll,
    }

    return {
        entryCode = initialBuild.entryCode,
        compileLoaded = compileLoaded,
        loaded = loaded,
        finish = finish,
        prepare = watching.prepare,
        apply = watching.apply,
        poll = watching.poll,
    }
end

export = watch
