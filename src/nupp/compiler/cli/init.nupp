module nupp.compiler.cli

--[[
The command line: which commands exist, and what happens to an argument list.

Every subcommand is a file under `nupp/cli`, and every one of them is the same
two things: a grammar, declared with `nupp.compiler.cli.spec`, and a function that does
the work once the arguments have been taken apart. Nothing here knows what any
of them do.

What is here is the part they share: finding the command, parsing against its
grammar, honouring `--help` and `--color` before either can matter, and turning
a parse failure into the conventional status 2. A command therefore never sees a
malformed argument list, and never has to remember to check for `--help`.

A command's module is loaded when it is named. A command file holds its grammar
and requires the compiler it needs inside its `run`, so listing every command in
`nupp help` costs thirteen small files rather than the whole compiler, and
running one loads only what that one needs.
]]

local specMod = require("nupp.compiler.cli.spec")
local optionsMod = require("nupp.compiler.cli.options")
local ansi = require("nupp.compiler.ansi")

local cli = {}

local type Loader = function(): specMod.Handler

-- The commands, in the order `nupp help` lists them. Each is loaded through a function
-- holding a literal `require`, which keeps the dependency visible to the build while
-- still only loading what a run actually reaches.
local REGISTRY: {{
    name: string,
    load: Loader
}} = {
    {
        name = "init",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.initcommand")
        end
    },
    {
        name = "ast",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.ast")
        end
    },
    {
        name = "aot",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.aot")
        end
    },
    {
        name = "bc",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.bc")
        end
    },
    {
        name = "check",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.check")
        end
    },
    {
        name = "fmt",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.fmt")
        end
    },
    {
        name = "build",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.build")
        end
    },
    {
        name = "backend",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.backend")
        end
    },
    {
        name = "clean",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.clean")
        end
    },
    {
        name = "tasks",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.tasks")
        end
    },
    {
        name = "lints",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.lints")
        end
    },
    {
        name = "ownership-audit",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.ownershipaudit")
        end
    },
    {
        name = "explain",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.explain")
        end
    },
    {
        name = "reference",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.reference")
        end
    },
    {
        name = "completions",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.completionscommand")
        end
    },
    {
        name = "test",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.test")
        end
    },
    {
        name = "test-runner",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.testrunner")
        end
    },
    {
        name = "coverage",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.coverage")
        end
    },
    {
        name = "task",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.task")
        end
    },
    {
        name = "doc",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.doc")
        end
    },
    {
        name = "fixpoint",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.fixpoint")
        end
    },
    {
        name = "run",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.run")
        end
    },
    {
        name = "import-c",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.importc")
        end
    },
    {
        name = "migrate",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.migrate")
        end
