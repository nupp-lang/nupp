--[[
The command line: which commands exist, and what happens to an argument list.

Every subcommand is a file under `nupp/cli`, and every one of them is the same
two things — a grammar, declared with `nupp.compiler.cli.spec`, and a function that does
the work once the arguments have been taken apart. Nothing here knows what any
of them do.

What is here is the part they share: finding the command, parsing against its
grammar, honouring `--help` and `--color` before either can matter, and turning
a parse failure into the conventional status 2. A command therefore never sees a
malformed argument list, and never has to remember to check for `--help`.

A command's module is loaded when it is named. A command file holds its grammar
and requires the compiler it needs inside its `run`, so listing every command in
`nupp help` costs thirteen small files rather than the whole compiler, and
running one loads only what that one needs.
]]

local specMod = require("nupp.compiler.cli.spec")
local optionsMod = require("nupp.compiler.cli.options")
local ansi = require("nupp.compiler.ansi")

local cli = {}

local type Loader = function(): specMod.Handler

-- The commands, in the order `nupp help` lists them. Each is loaded through a function
-- holding a literal `require`, which keeps the dependency visible to the build while
-- still only loading what a run actually reaches.
local REGISTRY: {{
    name: string,
    load: Loader
}} = {{name = "ast", load = function(): specMod.Handler
    return require("nupp.compiler.cli.ast")
end}, {name = "check", load = function(): specMod.Handler
    return require("nupp.compiler.cli.check")
end}, {name = "fmt", load = function(): specMod.Handler
    return require("nupp.compiler.cli.fmt")
end}, {name = "build", load = function(): specMod.Handler
    return require("nupp.compiler.cli.build")
end}, {name = "clean", load = function(): specMod.Handler
    return require("nupp.compiler.cli.clean")
end}, {name = "tasks", load = function(): specMod.Handler
    return require("nupp.compiler.cli.tasks")
end}, {name = "lints", load = function(): specMod.Handler
    return require("nupp.compiler.cli.lints")
end}, {name = "ownership-audit", load = function(): specMod.Handler
    return require("nupp.compiler.cli.ownership_audit")
end}, {name = "explain", load = function(): specMod.Handler
    return require("nupp.compiler.cli.explain")
end}, {name = "reference", load = function(): specMod.Handler
    return require("nupp.compiler.cli.reference")
end}, {name = "completions", load = function(): specMod.Handler
    return require("nupp.compiler.cli.completions_command")
end}, {name = "test", load = function(): specMod.Handler
    return require("nupp.compiler.cli.test")
end}, {name = "coverage", load = function(): specMod.Handler
    return require("nupp.compiler.cli.coverage")
end}, {name = "task", load = function(): specMod.Handler
    return require("nupp.compiler.cli.task")
end}, {name = "doc", load = function(): specMod.Handler
    return require("nupp.compiler.cli.doc")
end}, {name = "fixpoint", load = function(): specMod.Handler
    return require("nupp.compiler.cli.fixpoint")
end}, {name = "run", load = function(): specMod.Handler
    return require("nupp.compiler.cli.run")
end}, {name = "import-c", load = function(): specMod.Handler
    return require("nupp.compiler.cli.importc")
end}, {name = "rock", load = function(): specMod.Handler
    return require("nupp.compiler.cli.rock")
end}, {name = "lsp", load = function(): specMod.Handler
    return require("nupp.compiler.cli.lsp")
end},}

-- `help` is a command in the list and in the help, but there is no work behind it, so
-- it is answered here rather than being a file of its own.
local HELP_COMMAND = specMod.command{
    name = "help",
    summary = "Show general or command-specific help",
    usage = {"nupp help [command]"},
    detail = "With no command, prints the command list.",
}

local byName: {[string]: Loader} = {}
for _, entry in ipairs(REGISTRY) do
    byName[entry.name] = entry.load
end

--- The named command, or nil when nothing is spelled that way.
local function lookup(name: string): specMod.Handler?
    local load = byName[name]
    return load and load() or nil
end

--- The command list, which is the one place every command's grammar is loaded. Only
--- `nupp help` reaches it.
local function mainHelp(): string
    local style = ansi.style(io.stdout)
    local out: {
        string
    } = {
        "Nupp compiler and project tool",
        "",
        style.strong("Usage:"),
        "  nupp <command> [options]",
        "  nupp help [command]",
        "",
        style.strong("Commands:"),
    }
    local width: integer = #"import-c"
    local summaries: {{
        name: string,
        summary: string
    }} = {}
    for _, entry in ipairs(REGISTRY) do
        summaries[#summaries + 1] = {name = entry.name, summary = entry.load().spec.summary}
        if #entry.name > width then
            width = #entry.name
        end
    end
    summaries[#summaries + 1] = {name = HELP_COMMAND.name, summary = HELP_COMMAND.summary}
    local paint = ansi.forSeverity(style, "note")
    for _, entry in ipairs(summaries) do
        out[#out + 1] = "  " .. paint(entry.name) .. (" "):rep(width - #entry.name + 2) .. entry.summary
    end
    out[#out + 1] = ""
    out[#out + 1] = "Run 'nupp help <command>' for command-specific options."

    return table.concat(out, "\n") .. "\n"
end

local function fail(message: string, hint: string): integer
    local style = ansi.style(io.stderr)
    io.stderr:write(ansi.forSeverity(style, "error")("nupp:") .. " " .. message .. "\n" .. hint .. "\n")
    return 2
end

--- Answers `nupp help [command]`.
local function runHelp(args: {string}): integer
    local name = args[1]
    if args[2] then
        return fail("help accepts at most one command name", "Try 'nupp help' for a list of commands.")
    end
    if not name then
        io.write(mainHelp())
        return 0
    end
    if name == "-h" or name == "--help" then
        io.write(HELP_COMMAND:help())
        return 0
    end
    if name == "help" then
        io.write(HELP_COMMAND:help())
        return 0
    end
    local command = lookup(name)
    if not command then
        return fail("unknown command " .. name, "Try 'nupp help' for a list of commands.")
    end
    io.write(command.spec:help())

    return 0
end

--- Applies `--color` and `--no-color` before anything is written. Both land on one key,
--- so whichever was given is the answer and giving both is refused by the parser rather
--- than silently resolved here.
local function applyColor(values: {[string]: any})
    local wanted = values.color
    if type(wanted) == "string" then
        ansi.setMode(wanted)
    end
end

--- Runs one command line and returns the process exit status.
function cli.main(argv: {string}): integer
    local name = argv[1]
    if not name or name == "-h" or name == "--help" then
        -- `--color` cannot have been parsed yet, so the help is styled by whatever the
        -- environment and the terminal already said.
        io.write(mainHelp())
        return 0
    end
    if name == "__comptime-worker" then
        local rest: {string} = {}
        for index = 2, #argv do
            rest[#rest + 1] = argv[index]
        end

        local worker = require("nupp.compiler.comptime_worker") as {
            main: function({string}): integer
        }

        return worker.main(rest)
    elseif name == "__lsp-reader" then
        local server = require("nupp.compiler.lsp.init") as {
            readerMain: function(): integer
        }

        return server.readerMain()
    end
    local rest: {string} = {}
    for index = 2, #argv do
        rest[#rest + 1] = argv[index]
    end
    if name == "help" then
        return runHelp(rest)
    end
    local command = lookup(name)
    if not command then
        return fail("unknown command " .. name, "Try 'nupp help' for a list of commands.")
    end
    if command.raw then
        -- A raw command's arguments are not this parser's to read, so these are only
        -- honoured where they cannot already mean something else.
        if rest[1] == "-h" or rest[1] == "--help" then
            io.write(command.spec:help())
            return 0
        end
        if rest[1] == "--schema" and command.spec.schema then
            require("nupp.compiler.cli.report").write(command.spec.schema)
            return 0
        end
        return command.run(rest)
    end
    local parsed, err = command.spec:parse(rest)
    if not parsed then
        return command.spec:usageError(err)
    end
    applyColor(parsed.values)
    if parsed.values.help then
        io.write(command.spec:help())
        return 0
    end
    if parsed.values.schema then
        -- Answered here rather than in the command, so what is printed is the schema
        -- the grammar carries and not something the command composed on its way past.
        require("nupp.compiler.cli.report").write(command.spec.schema)
        return 0
    end

    return command.run(parsed)
end

cli.spec = specMod
cli.options = optionsMod

--- Every command's name, for the tests that check the list is complete.
function cli.names(): {string}
    local names: {string} = {}
    for _, entry in ipairs(REGISTRY) do
        names[#names + 1] = entry.name
    end
    names[#names + 1] = "help"

    return names
end

--- The complete public command grammar, for schema-derived integrations such as shell
--- completion. Loading the handlers here is deliberate: the one invocation that needs
--- every command's grammar is also the one that turns it into another interface.
function cli.commands(): {any}
    local commands: {any} = {}
    for _, entry in ipairs(REGISTRY) do
        commands[#commands + 1] = {name = entry.name, spec = entry.load().spec}
    end
    commands[#commands + 1] = {name = HELP_COMMAND.name, spec = HELP_COMMAND}

    return commands
end

return cli
