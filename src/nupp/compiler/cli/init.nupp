    {
        name = "export-c",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.exportc")
        end
    },
    {
        name = "rock",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.rock")
        end
    },
    {
        name = "lsp",
        load = function(): specMod.Handler
            return require("nupp.compiler.cli.lsp")
        end
    },
}

-- `help` is a command in the list and in the help, but there is no work behind it, so
-- it is answered here rather than being a file of its own.
local HELP_COMMAND = specMod.command{
    name = "help",
    summary = "Show general or command-specific help",
    usage = {"nupp help [command]"},
    detail = "With no command, prints the command list.",
}

local byName: {[string]: Loader} = {}
for _, entry in ipairs(REGISTRY) do
    byName[entry.name] = entry.load
end

--- The named command, or nil when nothing is spelled that way.
local function lookup(name: string): specMod.Handler?
    local load = byName[name]
    return load and load() or nil
end

--- The command list, which is the one place every command's grammar is loaded. Only
--- `nupp help` reaches it.
local function mainHelp(): string
    local style = ansi.style(io.stdout)
    local out: {
        string
    } = {
        "Nupp compiler and project tool",
        "",
        style.strong("Usage:"),
        "  nupp <command> [options]",
        "  nupp help [command]",
        "",
        style.strong("Commands:"),
    }
    local width: integer = #"import-c"
    local summaries: {{
        name: string,
        summary: string
    }} = {}
    for _, entry in ipairs(REGISTRY) do
        summaries[#summaries + 1] = {name = entry.name, summary = entry.load().spec.summary}
        if #entry.name > width then
            width = #entry.name
        end
    end
    summaries[#summaries + 1] = {name = HELP_COMMAND.name, summary = HELP_COMMAND.summary}
    local paint = ansi.forSeverity(style, "note")
    for _, entry in ipairs(summaries) do
        out[#out + 1] = "  " .. paint(entry.name) .. (" "):rep(width - #entry.name + 2) .. entry.summary
    end
    out[#out + 1] = ""
    out[#out + 1] = "Run 'nupp help <command>' for command-specific options."

    return table.concat(out, "\n") .. "\n"
end

local function fail(message: string, hint: string): integer
    local style = ansi.style(io.stderr)
    io.stderr:write(ansi.forSeverity(style, "error")("nupp:") .. " " .. message .. "\n" .. hint .. "\n")
    return 2
end

--- Warns when the compiler is checking against declarations its checkout has moved on
--- from.
---
--- The declarations a build copies beside the compiled modules are what the checker
--- resolves the prelude and bundled source against. Editing one in `src` does
--- not reach that copy until a build copies it again, so until then every command
--- describes today's source against yesterday's interface -- and it surfaces as an
--- ordinary type error about a field that is plainly there in the file, or a contract
--- that is plainly an interface. Neither error can mention the reason, because by the
--- time it is raised the stale declaration is simply what the compiler knows.
---
--- The build that fails this way has already copied the new declarations before it
--- reported anything, so running it again is the whole fix. Saying so is the point of
--- this: the answer is one command, and nothing else in the output suggests it.
local function warnStaleDeclarations(): nil
    local stale = require("nupp.compiler.bundled").staleDeclarations()
    if #stale == 0 then
        return
    end
    local style = ansi.style(io.stderr)
    local lines = {
        ansi.forSeverity(style, "warning")("nupp:") .. " the compiler is using declarations older than this checkout:",
    }
    for _, relative in ipairs(stale) do
        lines[#lines + 1] = "  " .. relative
    end
    lines[#lines + 1] = "A diagnostic above may describe an interface src/ no longer has."
    lines[#lines + 1] = "Run the build again; it has already refreshed them."
    io.stderr:write(table.concat(lines, "\n") .. "\n")
end

--- Answers `nupp help [command]`.
local function runHelp(args: {string}): integer
    local name = args[1]
    if args[2] then
        return fail("help accepts at most one command name", "Try 'nupp help' for a list of commands.")
    end
    if not name then
        io.write(mainHelp())
        return 0
    end
    if name == "-h" or name == "--help" then
        io.write(HELP_COMMAND:help())
        return 0
    end
    if name == "help" then
        io.write(HELP_COMMAND:help())
        return 0
    end
    local command = lookup(name)
    if not command then
        return fail("unknown command " .. name, "Try 'nupp help' for a list of commands.")
    end
    io.write(command.spec:help())

    return 0
end

--- Applies `--color` and `--no-color` before anything is written. Both land on one key,
--- so whichever was given is the answer and giving both is refused by the parser rather
--- than silently resolved here.
local function applyColor(values: {[string]: any})
    local wanted = values.color
    if type(wanted) == "string" then
        ansi.setMode(wanted)
    end
end

--- Runs one command line and returns the process exit status.
-- Commands that keep LuaJIT's own thresholds.
--
-- `lsp` is resident: its traces amortize across every edit of a session, so refusing
-- side traces would give up what it spends the first file paying for. `run` and `task`
-- execute a program that is not this one, and nothing here knows its shape.
const JIT_DEFAULT_COMMANDS = {lsp = true, run = true, task = true}

-- Everything else is a compiler run: it walks a large program roughly once and exits.
--
-- LuaJIT compiles a side trace for every guard that fails often enough, and a compiler
-- is branches -- node kinds, token kinds, type tags -- so the tail of that distribution
-- never ends. Half of a cold self-build was the trace compiler rather than compiled
-- code, and raising the exit threshold is what stops it chasing the tail:
--
--     default                    16.1s
--     hotexit=200                 9.0s
--     hotexit=200, hotloop=1000   9.1s
--
-- Both curves turn back up past their peak -- `hotexit=1000` gives back most of the
-- win -- because eventually the refused traces are ones that would have paid. Re-run
-- `bench/jit-thresholds.lua` on a quiet machine before moving these.
--
-- `NUPP_JIT_DEFAULT` turns it off and `NUPP_JIT_TUNE` replaces it with a
-- comma-separated flag list, which is how `bench/jit-thresholds.lua` compares settings
-- without rebuilding the compiler between them.
local function tuneJitFor(name: string)
    if JIT_DEFAULT_COMMANDS[name] or os.getenv("NUPP_JIT_DEFAULT") then
        return
    end
    local override = os.getenv("NUPP_JIT_TUNE")
    -- A LuaJIT built without the JIT, or a future one that renames a flag, is not a
    -- reason to refuse to run.
    if not override then
        pcall(jit.opt.start, "hotexit=200", "hotloop=1000")

        return
    end
    local flags: {string} = {}
    for flag in override:gmatch("[^,]+") do
        flags[#flags + 1] = flag
    end
    pcall(function()
        jit.opt.start(unpack(flags))
    end)
end

function cli.main(argv: {string}): integer
    local name = argv[1]
    if not name or name == "-h" or name == "--help" then
        -- `--color` cannot have been parsed yet, so the help is styled by whatever the
        -- environment and the terminal already said.
        io.write(mainHelp())
        return 0
    end
    if name == "__comptime-worker" then
        local rest: {string} = {}
        for index = 2, #argv do
            rest[#rest + 1] = argv[index]
        end

        local worker = require("nupp.compiler.comptimeworker") as {main: function({string}): integer}

        return worker.main(rest)
    elseif name == "__comptime-worker-service" then
        local worker = require("nupp.compiler.comptimeworker") as {serviceMain: function(): integer}

        return worker.serviceMain()
    elseif name == "__lsp-reader" then
        local server = require("nupp.compiler.lsp") as {readerMain: function(): integer}

        return server.readerMain()
    end
    local rest: {string} = {}
    for index = 2, #argv do
        rest[#rest + 1] = argv[index]
    end
    if name == "help" then
        return runHelp(rest)
    end
    tuneJitFor(name)
    local command = lookup(name)
    if not command then
        return fail("unknown command " .. name, "Try 'nupp help' for a list of commands.")
    end
    if command.raw then
        -- A raw command's arguments are not this parser's to read, so these are only
        -- honoured where they cannot already mean something else.
        if rest[1] == "-h" or rest[1] == "--help" then
            io.write(command.spec:help())
            return 0
        end
        if rest[1] == "--schema" and command.spec.schema then
            require("nupp.compiler.cli.report").write(command.spec.schema)
            return 0
        end
        local status = command.run(rest)
        warnStaleDeclarations()

        return status
    end
    local parsed, err = command.spec:parse(rest)
    if not parsed then
        return command.spec:usageError(err)
    end
    applyColor(parsed.values)
    if parsed.values.help then
        io.write(command.spec:help())
        return 0
    end
    if parsed.values.schema then
        -- Answered here rather than in the command, so what is printed is the schema
        -- the grammar carries and not something the command composed on its way past.
        require("nupp.compiler.cli.report").write(command.spec.schema)
        return 0
    end

    local status = command.run(parsed)
    warnStaleDeclarations()

    return status
end

cli.spec = specMod
cli.options = optionsMod

--- Every command's name, for the tests that check the list is complete.
function cli.names(): {string}
    local names: {string} = {}
    for _, entry in ipairs(REGISTRY) do
        names[#names + 1] = entry.name
    end
    names[#names + 1] = "help"

    return names
end

--- The complete public command grammar, for schema-derived integrations such as shell
--- completion. Loading the handlers here is deliberate: the one invocation that needs
--- every command's grammar is also the one that turns it into another interface.
function cli.commands(): {any}
    local commands: {any} = {}
    for _, entry in ipairs(REGISTRY) do
        commands[#commands + 1] = {name = entry.name, spec = entry.load().spec}
    end
    commands[#commands + 1] = {name = HELP_COMMAND.name, spec = HELP_COMMAND}

    return commands
end

export = cli
