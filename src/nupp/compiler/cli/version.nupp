module nupp.compiler.cli.version

--[[
`nupp version`, and the `nupp --version` that is the same question spelled the way
everything else asks it.

The text form is one line and stays one line: an install script reads it, a
packaging recipe reads it, and both break when a second line appears. What else
is worth knowing about a particular compiler -- which interpreter it runs on --
is under `--json`, where a reader is a program that asked for a shape.

The number itself is `nupp.compiler.version`, which is a string and nothing else,
so this answers without loading the compiler it is the version of.
]]

local usageError = require("nupp.compiler.cli.error").forCommand("version")
local versionMod = require("nupp.compiler.version")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        version = {
            type = "string",
            description = "The release, without a leading \"v\"; a -dev suffix " .. "is a checkout between releases."
        },
        runtime = {type = "string", description = "The LuaJIT interpreter underneath this compiler."},
    },
    required = {"version", "runtime"},
}

local function run(options: any): integer
    local positional: {string} = {}
    if #positional > 0 then
        return usageError("unexpected argument " .. positional[1])
    end
    if options.format == "json" then
        require("nupp.compiler.cli.report").write({version = versionMod.VERSION, runtime = versionMod.runtime()})

        return 0
    end
    io.write(versionMod.line() .. "\n")

    return 0
end

--- Print the compiler version.
---
--- The text form is the single line `nupp VERSION`, which is what an install
--- script should read. `nupp --version` prints the same line.
---
--- Examples:
---
---     nupp version
---     nupp --version
---     nupp version --json
@cli("version")
@derive(cliModule.Command)
local record Version
    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    function run(self): integer
        return run(self)
    end
end

function Version.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Version}
