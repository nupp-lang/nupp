module nupp.compiler.cli.test

--[[
`nupp test`: build, then run the bundled runner or the project's test command,
optionally against a separate instrumented coverage build.

The one command whose arguments are mostly not its own. Everything after the
name is appended to `test.argv` from nupp.lua and belongs to the program that
ends up running. Colour is the exception: it governs both the build this command
performs and the configured runner, so it is read here and still passed along.
]]

local spec = require("nupp.compiler.cli.spec")
local ansi = require("nupp.compiler.ansi")

--- What one phase of a parallel run was predicted to cost, which the report puts
--- beside what its busiest lane actually cost. Written once and used for both
--- phases: two copies of a shape are two chances for them to drift apart.
local phasePrediction = {
    type = "object",
    properties = {
        planned = {type = "number", description = "Predicted milliseconds of work in the phase."},
        lanes = {type = "integer", description = "How many workers it was packed for."},
        heaviest = {
            type = "number",
            description = "The single heaviest piece. A piece longer than the "
            .. "fair share is the phase's floor however many lanes there are."
        },
        floor = {type = "number", description = "The larger of the fair share and the heaviest piece."},
    },
    required = {"planned", "lanes", "heaviest", "floor"},
}

local command = spec.command{
    name = "test",
    summary = "Build and run project tests",
    usage = {
        "nupp test [args...]",
        "nupp test --coverage [--coverage-out DIR] [args...]",
        "nupp test --coverage --report-json [--coverage-out DIR]",
    },
    universal = false,
    options = {
        {name = "--json", help = "Ask the test command for one JSON document instead of " .. "progress text"},
        {name = "--verbose", help = "Ask the test command to show output from passing tests"},
        {name = "--jobs", value = "N", help = "Ask the bundled runner to use N parallel workers"},
        {name = "--coverage", help = "Run against a separate instrumented build and write a coverage report"},
        {name = "--coverage-out", value = "DIR", help = "Write coverage HTML, JSON, and LCOV files under DIR"},
        {name = "--report-json", help = "Print an existing full coverage report without running tests"},
        {
            name = "--color",
            value = "WHEN",
            form = "optional",
            help = "Color both compiler and test output: always, never, or auto"
        },
        {name = "--no-color", help = "Never color compiler or test output"},
        {
            name = "--timings",
            help = "Ask the test command for its whole timing report rather than "
            .. "the slowest few. `--timings=N` asks for N rows, and `--timings=0` for none"
        },
        {
            name = "--group",
            value = "NAME",
            help = "Run the suites a named group covers. Repeatable, and "
            .. "comma-separated. `--list-groups` names them"
        },
        {
            name = "--exclude",
            value = "SUITE",
            help = "Leave these suites out, which is how a later broad run "
            .. "stops repeating what an earlier focused one already ran"
        },
        {name = "--exclude-group", value = "NAME", help = "Leave every suite a named group covers out"},
        {
            name = "--lane",
            value = "WHICH",
            help = "Keep only one execution lane: `shared` is what a Nupp "
            .. "worker can run beside other suites in one process, `shell` uses "
            .. "a reusable process worker, and `isolated` needs process-global isolation"
        },
        {name = "--list-suites", help = "Print the suites this selection would run, and run none of them"},
        {name = "--list-groups", help = "Print every named group and the suites it covers"},
        spec.helpOption,
    },
    schema = {
        type = "object",
        description = "One run: the totals, and a record per test. This is what "
        .. "the bundled runner writes; a project that configures a "
        .. "different test command is the one answering for its --json. "
        .. "`--coverage --report-json` answers with `#/definitions/coverageReport` "
        .. "instead, which is a report rather than a run.",
        properties = {
            ok = {type = "boolean"},
            total = {type = "integer"},
            passed = {type = "integer"},
            skipped = {type = "integer"},
            failed = {type = "integer"},
            durationMs = {type = "number", description = "Wall-clock milliseconds for the whole run."},
            tests = {
                type = "array",
                items = {
                    type = "object",
                    properties = {
                        suite = {type = "string", description = "The test file, without its extension."},
                        name = {type = "string"},
                        status = {type = "string", enum = {"passed", "skipped", "failed"}},
                        durationMs = {type = "number"},
                        file = {type = "string", description = "Where the test is defined."},
                        line = {type = "integer", description = "1-based, as everywhere else."},
                        failure = {
                            type = "object",
                            description = "Absent when the test passed.",
                            properties = {
                                message = {type = "string"},
                                file = {
                                    type = "string",
                                    description = "Where the error came from, "
                                    .. "which is often not where the test "
                                    .. "is defined."
                                },
                                line = {
                                    type = "integer",
                                    description = "1-based. A Lua error carries " .. "no column, so none is reported."
                                },
                            },
                            required = {"message"},
                        },
                        output = {
                            type = "object",
                            description = "Captured output from a failed test.",
                            properties = {stdout = {type = "string"}, stderr = {type = "string"},},
                            required = {"stdout", "stderr"},
                        },
                        skip = {
                            type = "object",
                            description = "Present when the test was skipped.",
                            properties = {reason = {type = "string"}},
                            required = {"reason"},
                        },
                    },
                    required = {"suite", "name", "status", "durationMs"},
                },
            },
            suites = {
                type = "array",
                description = "One record per suite the run loaded, which is "
                .. "where the time a run waits for actually goes: a suite costs "
                .. "its cases plus what loading it and its lifecycle hooks cost, "
                .. "and neither of those belongs to any case.",
                items = {
                    type = "object",
                    properties = {
                        suite = {type = "string"},
                        durationMs = {
                            type = "number",
                            description = "Wall-clock milliseconds for the whole suite, loading included."
                        },
                        loadMs = {
                            type = "number",
                            description = "Compiling a Nupp suite, or running a Lua suite's top level."
                        },
                        hooksMs = {
                            type = "number",
                            description = "beforeAll and afterAll. beforeEach and afterEach are counted with the case they ran for."
                        },
                        casesMs = {type = "number"},
                        tests = {type = "integer"},
                        slowestCase = {type = "string"},
                        slowestCaseMs = {type = "number"},
                        shard = {type = "integer", description = "Which shard ran it, absent when the run was serial."},
                        alone = {
                            type = "boolean",
                            description = "Ran on a process worker rather than on a Nupp worker."
                        },
                        executionLane = {type = "string", enum = {"shared", "shell", "isolated"}},
                    },
                    required = {"suite", "durationMs"},
                },
            },
            shards = {
                type = "array",
                description = "One record per worker lane, empty when the run "
                .. "was serial. Within an execution lane, the busiest shard is "
                .. "the floor more workers cannot lower.",
                items = {
                    type = "object",
                    properties = {
                        index = {type = "integer"},
                        specs = {
                            type = "array",
                            description = "What it was asked to run: a suite name, or 'name#index/count' for one slice of one.",
                            items = {type = "string"},
                        },
                        alone = {
                            type = "boolean",
                            description = "Ran on a process worker rather than on a Nupp worker."
                        },
                        executionLane = {type = "string", enum = {"shared", "shell", "isolated"}},
                        durationMs = {type = "number"},
                        startedAt = {type = "number", description = "Milliseconds into the run when it was started."},
                        collectedAt = {
                            type = "number",
                            description = "Milliseconds into the run when the parent finished reading it. Pipes are read in order, so this says more about read order than about the shard."
                        },
                        tests = {type = "integer"},
                    },
                    required = {"index", "durationMs", "executionLane"},
                },
            },
            prediction = {
                type = "object",
                description = "What the packer said each phase could not finish "
                .. "under, from the timings the last run recorded. Absent when "
                .. "the run was serial. A phase whose busiest shard came out far "
                .. "above its floor was packed from stale timings or starved a "
                .. "lane; one that came out at its floor is as short as that much "
                .. "work gets, and only less work shortens it.",
                properties = {processIsolated = phasePrediction, shared = phasePrediction, shell = phasePrediction},
            },
        },
        required = {"ok", "total", "passed", "skipped", "failed", "tests"},
        definitions = {
            coverageMetric = {
                type = "object",
                properties = {
                    covered = {type = "integer"},
                    total = {type = "integer"},
                    percent = {type = "number"},
                    missing = {type = "array", items = {type = "string"}},
                },
            },
            coverageSite = {
                type = "object",
                description = "One place the instrumented program counts reaching.",
                properties = {
                    id = {type = "integer"},
                    kind = {type = "string", enum = {"statement", "function", "branch"}},
                    line = {type = "integer"},
                    count = {type = "integer", description = "Times this site was reached."},
                    name = {
                        type = "string",
                        description = "A function site's declared name, absent when it is anonymous.",
                    },
                    endLine = {type = "integer", description = "The last line of a function site's declaration."},
                    trueCount = {type = "integer", description = "Branch sites only: times the condition held."},
                    falseCount = {type = "integer", description = "Branch sites only: times it did not."},
                },
                required = {"id", "kind", "line", "count"},
            },
            coverageReport = {
                type = "object",
                description = "What `--coverage --report-json` prints: the report "
                .. "already written, rather than a run. An editor reads this to "
                .. "draw a gutter, so a site says where it is, how often it was "
                .. "reached, and -- for a branch -- which way it went.",
                properties = {
                    version = {type = "integer"},
                    warnings = {type = "array", items = {type = "string"}},
                    summary = {type = "object"},
                    files = {
                        type = "array",
                        items = {
                            type = "object",
                            properties = {
                                path = {type = "string"},
                                status = {
                                    type = "string",
                                    enum = {"covered", "partial", "uncovered", "non-executable"},
                                },
                                lines = {["$ref"] = "#/definitions/coverageMetric"},
                                functions = {["$ref"] = "#/definitions/coverageMetric"},
                                branches = {["$ref"] = "#/definitions/coverageMetric"},
                                sites = {type = "array", items = {["$ref"] = "#/definitions/coverageSite"}},
                            },
                            required = {"path", "sites"},
                        },
                    },
                },
                required = {"version", "files", "summary"},
            },
        },
    },
    detail = [[Additional arguments are appended to the bundled runner or test.argv from
nupp.lua. `--coverage`, `--coverage-out`, and `--report-json` belong to Nupp;
use `--` before a test argument with one of those names.

--json is passed along to the test command rather than interpreted here, since
the arguments past this point are that command's. --schema describes what the
bundled runner writes for it.

Coverage uses build/coverage without changing an ordinary build or its cache,
and writes its report under build/reports/coverage by default. --report-json
reads that report without rebuilding or rerunning tests.]],
}

local type TestArguments = {
    coverage: boolean,
    coverageOut: string?,
    reportJson: boolean,
    forwarded: {string}
}

--- Takes out the three options `test` owns. Everything else still belongs to the
--- configured command, and `--` protects even one of these names from being read here.
local function parseTestArguments(args: {string}): TestArguments, string?
    local parsed = {coverage = false, coverageOut = nil, reportJson = false, forwarded = {},} as TestArguments
    local literal = false
    local index: integer = 1
    while index <= #args do
        local argument = args[index]
        if literal then
            parsed.forwarded[#parsed.forwarded + 1] = argument
        elseif argument == "--" then
            literal = true
        elseif argument == "--coverage" then
            if parsed.coverage then
                return parsed, "option --coverage was specified more than once"
            end
            parsed.coverage = true
        elseif argument == "--report-json" then
            if parsed.reportJson then
                return parsed, "option --report-json was specified more than once"
            end
            parsed.reportJson = true
        elseif argument == "--coverage-out" then
            if parsed.coverageOut ~= nil then
                return parsed, "option --coverage-out was specified more than once"
            end
            index = index + 1
            if args[index] == nil then
                return parsed, "option --coverage-out needs DIR"
            end
            parsed.coverageOut = args[index]
        else
            local out = argument:match("^%-%-coverage%-out=(.*)$")
            if out ~= nil then
                if parsed.coverageOut ~= nil then
                    return parsed, "option --coverage-out was specified more than once"
                end
                parsed.coverageOut = out
            else
                parsed.forwarded[#parsed.forwarded + 1] = argument
            end
        end
        index = index + 1
    end
    if parsed.coverageOut ~= nil and not parsed.coverage then
        return parsed, "--coverage-out requires --coverage"
    end
    if parsed.reportJson and not parsed.coverage then
        return parsed, "--report-json requires --coverage"
    end
    if parsed.reportJson and #parsed.forwarded > 0 then
        return parsed, "--report-json does not run tests or accept test arguments"
    end

    return parsed
end

local function asksForJson(args: {string}): boolean
    for _, argument in ipairs(args) do
        if argument == "--json" then
            return true
        end
    end

    return false
end

local function applyTestColor(args: {string}): integer?
    local color: string? = nil
    for _, argument in ipairs(args) do
        local asked = argument == "--color" and "always" or argument == "--no-color" and "never" or argument:match(
            "^%-%-color=(.*)$"
        )
        if asked ~= nil then
            if asked ~= "always" and asked ~= "never" and asked ~= "auto" then
                io.stderr:write("nupp: --color must be always, never, or auto\n")
                return 2
            end
            if color ~= nil and color ~= asked then
                io.stderr:write("nupp: color was both asked for and refused\n")
                return 2
            end
            color = asked
        end
    end
    if color ~= nil then
        ansi.setMode(color)
    end

    return nil
end

local function runCoverage(parsed: TestArguments): integer
    local fs = require("nupp.compiler.fs")
    local outDir = parsed.coverageOut or "build/reports/coverage"
    if parsed.reportJson then
        local existing, err = fs.readFile(outDir .. "/coverage.json")
        if not existing then
            io.stderr:write(
                "nupp: cannot read coverage report " .. outDir .. "/coverage.json: " .. tostring(err) .. "\n"
            )
            return 1
        end
        io.write(existing)
        if existing:sub(-1) ~= "\n" then
            io.write("\n")
        end
        return 0
    end
    local buildDir = "build/coverage"
    local raw = outDir .. "/raw.json"
    if not fs.mkdir(outDir) then
        io.stderr:write("nupp: cannot create coverage output " .. outDir .. "\n")
        return 1
    end
    local project = require("nupp.compiler.build.project")
    local testCode = project.test(".", parsed.forwarded, {
        coverage = true,
        outDir = buildDir,
        env = {NUPP_COVERAGE = "1", NUPP_COVERAGE_BUILD = buildDir, NUPP_COVERAGE_FILE = raw}
    })
    local report = require("nupp.compiler.coverage")
    local model = report.collect(buildDir .. "/.nupp-state.json", raw)
    local summary = report.write(model, outDir)
    local output = asksForJson(parsed.forwarded) and io.stderr or io.stdout
    output:write(
        (
            "coverage: lines %.2f%%, functions %.2f%%, branches %.2f%%\n"
        ):format(summary.lines.percent, summary.functions.percent, summary.branches.percent)
    )
    output:write("coverage: report written to " .. outDir .. "/index.html\n")
    if #model.warnings > 0 and testCode == 0 then
        io.stderr:write("nupp: coverage data is incomplete\n")
        return 1
    end

    return testCode
end

local function run(args: any): integer
    if args[1] == "--internal-runner" then
        table.remove(args, 1)
        return require("nupp.compiler.cli.testrunner").run(args)
    end
    local parsed, problem = parseTestArguments(args)
    if problem ~= nil then
        return command:usageError(problem)
    end
    local colorCode = applyTestColor(parsed.forwarded)
    if colorCode ~= nil then
        return colorCode
    end
    if parsed.coverage then
        return runCoverage(parsed)
    end
    local project = require("nupp.compiler.build.project")

    return project.test(".", parsed.forwarded)
end

export = new spec.Handler(spec = command, raw = true, run = run)
