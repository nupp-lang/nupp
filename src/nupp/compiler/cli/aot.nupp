--- Every `@simd` loop in source order.
---
--- A map-shaped program carries the mark on its one loop and its rewritten body
--- on the program; a structured body carries both on each marked region.
--- Reported alike, so a reader asks one question of either.
local function simdRegions(program: any): {any}
    local answer: {any} = {}

    local function reducers(value: any, found: {any}, seen: {[string]: boolean}): nil
        if type(value) ~= "table" then
            return
        end
        if value.op == "simd_region" then
            for _, reducer in ipairs(value.reducers or {}) do
                local key = tostring(
                    reducer.name
                ) .. ":" .. tostring(reducer.order) .. ":" .. tostring(reducer.operation)
                if not seen[key] then
                    seen[key] = true
                    found[
                        #found + 1
                    ] = {
                        binding = reducer.name,
                        order = reducer.order,
                        operation = reducer.operation,
                        serialized = reducer.order ~= "algebraic" and reducer.order ~= "exact",
                    }
                end
            end
        end
        for key, child in pairs(value) do
            if key ~= "source" then
                reducers(child, found, seen)
            end
        end
    end

    --- The species the rewrite chose, read back off the types it wrote.
    ---
    --- The lane count is the same in every one of them by construction -- a
    --- lane is a logical iteration, so a region carries one species per element
    --- at one width -- and the elements are whatever the body touched.
    local function gangOf(statements: any): any
        local species: {[string]: string} = {}
        local lanes: integer? = nil

        local function walk(value: any): nil
            if type(value) ~= "table" then
                return
            end
            local named = value.type
            if type(named) == "string" then
                local family, element, width = (named as string):match("^simd_(%a+)_([fiu]%d+)_fixed(%d+)$")
                if width ~= nil then
                    lanes = lanes or tonumber(width) as integer
                    if family == "vector" then
                        species[element as string] = named as string
                    end
                end
            end
            for key, child in pairs(value) do
                if key ~= "source" then
                    walk(child)
                end
            end
        end

        walk(statements)
        if lanes == nil then
            return nil
        end

        return {lanes = lanes, species = species}
    end

    local function visit(statements: {any}): nil
        for _, statement in ipairs(statements) do
            if statement.op == "fornum" then
                if statement.simdRequired == true then
                    local reduced: {any} = {}
                    reducers(statement.vector or {}, reduced, {})
                    answer[
                        #answer + 1
                    ] = {
                        ordinal = #answer + 1,
                        line = statement.source and statement.source.line or 1,
                        column = statement.source and statement.source.column or 1,
                        bounds = {
                            first = statement.from and statement.from.op or "unknown",
                            last = statement.to and statement.to.op or "unknown",
                            step = "positive-unit",
                        },
                        gang = statement.vector and gangOf(statement.vector) or nil,
                        tail = "masked",
                        reducers = reduced,
                    }
                else
                    visit(statement.body or {})
                end
            elseif statement.op == "if" then
                for _, clause in ipairs(statement.clauses or {}) do
                    visit(clause.body or {})
                end
                visit(statement.elseBody or {})
            elseif statement.op == "while" or statement.op == "block" then
                visit(statement.body or {})
            end
        end
    end

    if program.loop ~= nil and program.simdRequired == true then
        local loop = program.loop
        local reduced: {any} = {}
        reducers(program.vector or {}, reduced, {})
        answer[
            1
        ] = {
            ordinal = 1,
            line = loop.source and loop.source.line or 1,
            column = loop.source and loop.source.column or 1,
            bounds = {first = tostring(loop.first), last = tostring(loop.last), step = "positive-unit"},
            gang = program.vector and gangOf(program.vector) or nil,
            tail = "masked",
            reducers = reduced,
        }
    end
    visit(program.body or {})

    return answer
end

--- One line saying what happened, for a person.
local function summarise(path: string, program: any, artifacts: any): string
    local gpu = artifacts and artifacts.gpu and artifacts.gpu[program.symbol] ~= nil
    local regions = simdRegions(program)
    local what: string
    if gpu then
        what = "gpu, one iteration per GPU invocation"
    elseif #regions > 0 then
        local gangs: {string} = {}
        for index, region in ipairs(regions) do
            local gang = region.gang
            gangs[index] = "Fixed<" .. tostring(gang.lanes) .. ">, " .. tostring(gang.lanes) .. " lanes"
        end
        if #regions == 1 then
            what = gangs[1]
        else
            what = tostring(#regions) .. " @simd regions: " .. table.concat(gangs, "; ")
        end
    elseif program.usesSimd == true then
        what = "explicit simd"
    elseif program.entryMode == "lua-builder" then
        what = "scalar, lanes do not apply to a lua-builder entry"
    else
        what = "scalar"
    end

    return ("%s: %s, %s, %s"):format(path, program.name, program.entryMode, what)
end

--- Source annotations are inspection-only; production bytes remain unchanged.
local function inspectionC(artifacts: any, sourceFile: string): string
    local programs = {}
    for _, program in ipairs(artifacts.programs) do
        if program.executionTarget ~= "gpu" then
            programs[#programs + 1] = program
        end
    end

    return require("nupp.compiler.aot.emit").program(programs, nil, sourceFile)
end

--- What every symbol in the generated C compiled to.
---
--- Everything here is the build's: the toolchain it would have used, the flags
--- it would have used for this tier, and the C it would have compiled. A
--- listing produced any other way would answer a question about this command
--- rather than about the artifact.
---
--- @param wanted one function, named as the source or the symbol spells it
--- @return the report, or nothing and what stopped it
local function assembly(artifacts: any, selected: Target, wanted: string?, sourceFile: string): (any?, string?)
    local buildAot = require("nupp.compiler.build.aot")
    local instructionsMod = require("nupp.compiler.aot.instructions")
    local targets = require("nupp.compiler.aot.target")
    if not instructionsMod.reads(selected.architecture) then
        return nil, (
            "there are no instruction rules for %s; --emit asm reads %s"
        ):format(selected.architecture, table.concat(instructionsMod.ARCHITECTURES, " and "))
    end

    local chain, chainErr = buildAot.toolchain()
    if chain == nil then
        return nil, tostring(chainErr)
    end
    local selectedChain = chain as Toolchain
    local mapped = inspectionC(artifacts, sourceFile)
    local debugFlags: {string} = {selectedChain.dialect == "clang" and "-gline-tables-only" or "-g"}
    local text, assembleErr = buildAot.assemble(selectedChain, selected, mapped, debugFlags)
    if text == nil then
        return nil, tostring(assembleErr)
    end

    local listings = instructionsMod.parse(text as string, selected.architecture, targets.system(selected.triple))
    -- Which body a symbol is, rather than only what it is called. The oracle is
    -- the forced-scalar twin the lane body is diffed against, and reading a
    -- listing without knowing which of the two is in front of you is how a
    -- vectorised kernel gets mistaken for one that was not.
    local claims: {[string]: Claim} = {}
    for _, program in ipairs(artifacts.programs) do
        claims[program.symbol] = new instructionsMod.Claim(name = program.name, role = "kernel")
        claims[program.symbol .. "_forced_scalar"] = new instructionsMod.Claim(name = program.name, role = "oracle")
        claims[program.symbol .. "_lua"] = new instructionsMod.Claim(name = program.name, role = "wrapper")
        if program.registrar ~= nil then
            claims[tostring(program.registrar)] = new instructionsMod.Claim(name = program.name, role = "registrar")
        end
    end
    instructionsMod.claim(listings, claims)

    for _, listing in ipairs(listings) do
        for index, program in ipairs(artifacts.programs) do
            if listing.name == program.name then
                for _, instruction in ipairs(listing.instructions) do
                    local file = instruction.sourceFile
                    local line = instruction.sourceLine
                    if file ~= nil and line ~= nil and file:sub(-#sourceFile) == sourceFile then
                        local ids: {integer} = {}
                        for _, loop in ipairs(artifacts.loops[index] or {}) do
                            if line >= loop.line and line <= loop.lastLine then
                                ids[#ids + 1] = loop.id
                            end
                        end
                        instruction.loopIds = ids
                    end
                end
            end
        end
    end
    local shown = instructionsMod.order(listings)
    if wanted ~= nil then
        -- Narrowed from the ordered listings rather than the emitted ones, so
        -- naming a function whose two bodies are both here shows them in the
        -- same order asking for the whole file would have.
        shown = instructionsMod.select(shown, wanted as string)
        if #shown == 0 then
            return nil, (
                "no function named %s was compiled here; this file has %s"
            ):format(wanted as string, table.concat(instructionsMod.names(listings), ", "))
        end
    end

    return {
        toolchain = {
            command = selectedChain.command,
            version = selectedChain.version,
            dialect = selectedChain.dialect,
        },
        flags = buildAot.compileFlags(selected, selectedChain, debugFlags),
        functions = shown,
    }, nil
end

--- One symbol's listing, for a person.
local function writeListing(listing: Listing): nil
    local counts = listing.counts
    io.write(
        (
            "-- %s%s, %s: %d instructions, %d vector, %d loads, %d stores, %d branches, %d calls, %d stack\n"
        ):format(
            listing.symbol,
            listing.name ~= nil and (" (" .. tostring(listing.name) .. ")") or "",
            listing.role,
            counts.total,
            counts.vector,
            counts.loads,
            counts.stores,
            counts.branches,
            counts.calls,
            counts.stack
        )
    )
    for _, one in ipairs(listing.instructions) do
        if one.label ~= nil then
            io.write(tostring(one.label) .. ":\n")
        end
        -- Padded only when there is something to pad away from, so a listing
        -- carries no trailing space for a diff to trip over.
        io.write(
            one.operands ~= "" and ("      %-7s %s\n"):format(one.mnemonic, one.operands)
            or ("      " .. one.mnemonic .. "\n")
        )
    end
    io.write("\n")
end

local function run(options: any): integer
    local positional: {string} = {options.file}
    local aot = require("nupp.compiler.aot.compile")
    local targets = require("nupp.compiler.aot.target")
    local paths: {string} = positional
    if #paths ~= 1 then
        return usageError("exactly one source file is required")
    end

    local path = paths[1]
    -- A placeholder rather than a guess: where the object lands is a build
    -- decision this command does not make, and a binding printed for reading
    -- says so rather than naming a path nobody will produce.
    local selected, targetErr = targets.select(options.target, options.features, options.dialect)
    if selected == nil then
        io.stderr:write("nupp: " .. tostring(targetErr) .. "\n")

        return 1
    end

    -- Inspection lowers the same checked tree a production build does. Parsing
    -- here would make `nupp aot` disagree with `nupp build` precisely on the
    -- aliases, ownership modes, effects and resolved layouts it exists to show.
    local envMod = require("nupp.compiler.env")
    local fs = require("nupp.compiler.fs")
    local root = fs.dirname(fs.absolute(path))
    while not fs.exists(fs.join(root, "nupp.lua")) do
        local parent = fs.dirname(root)
        if parent == root then
            root = "."
            break
        end
        root = parent
    end
    local environment = envMod.new(root, {dialect = options.dialect})
    -- The command is an inspection of AOT output even when the manifest's
    -- build policy is off. Keep every other project setting and make only that
    -- question explicit while checking target-specific operations.
    environment.config._target = environment.config._target or {}
    environment.config._target.aot = "emit-c"
    local tree, source = require("nupp.compiler.cli.compile").check(path, environment as {[string]: any}, {
        dialect = options.dialect
    })
    if tree == nil then
        return 1
    end

    local library = options.library or "<object>"
    local artifacts, diagnostics = aot.artifacts(source as string, path, tree, library, selected as targets.Target)
    if artifacts == nil then
        for _, problem in ipairs(diagnostics) do
            io.stderr:write(aot.renderDiagnostic(problem) .. "\n")
        end

        return 1
    end

    local emit = options.emit
    local spirvParts: {string} = {}
    local wgslParts: {string} = {}
    for _, program in ipairs(artifacts.programs) do
        local artifact = artifacts.gpu[program.symbol]
        local selectedFunction = options.functionName
        if artifact ~= nil
            and (selectedFunction == nil or selectedFunction == program.name or selectedFunction == program.symbol)
        then
            spirvParts[#spirvParts + 1] = artifact.spirv
            if artifact.wgsl ~= nil then
                wgslParts[#wgslParts + 1] = artifact.wgsl as string
            end
        end
    end
    local wgsl = table.concat(wgslParts, "\n")
    local spirvHex: string? = nil
    if emit == "spirv" and #spirvParts == 1 and options.format == "json" then
        local bytes: {string} = {}
        for index = 1, #spirvParts[1] do
            bytes[index] = ("%02x"):format(spirvParts[1]:byte(index))
        end
        spirvHex = table.concat(bytes)
    end
    if emit == "wgsl" and #wgslParts == 0 then
        io.stderr:write("nupp: no GPU function matched --emit wgsl with the webgpu-int32 profile\n")
        return 1
    end
    if emit == "spirv" and #spirvParts ~= 1 then
        io.stderr:write(
            #spirvParts == 0 and "nupp: no GPU function matched --emit spirv\n"
            or "nupp: --emit spirv needs one GPU function; select it with --function\n"
        )
        return 1
    end
    -- Compiled once, before either branch prints: producing it runs a C
    -- compiler, so it happens when it was asked for and never as a side effect
    -- of choosing an output format.
    local instructionReport: any = nil
    if emit == "asm" then
        local built, instructionErr = assembly(artifacts, selected as targets.Target, options.functionName, path)
        if built == nil then
            io.stderr:write("nupp: " .. tostring(instructionErr) .. "\n")

            return 1
        end
        instructionReport = built
    end
    -- The rewrite is printed from the verified IR and has no lowering of its
    -- own, so a construct it cannot say is a gap in the surface rather than a
    -- bad file: it is reported as itself rather than as a compile failure.
    local simdText: string? = nil
    if emit == "simd" then
        local textMod = require("nupp.compiler.aot.text")
        local ok, printed = pcall(textMod.explicitPrograms, artifacts.programs)
        if not ok then
            io.stderr:write("nupp: --emit simd: " .. tostring(printed) .. "\n")

            return 1
        end
        if printed == "" then
            io.stderr:write("nupp: no @simd loop in " .. path .. " was vectorized, so there is nothing to print\n")

            return 1
        end
        simdText = printed as string
    end
    if options.format == "json" then
        -- Lane counts and widths are integers the backend settled on, so a NaN
        -- here would be a fault rather than a measurement.
        local functions: {any} = {}
        for position, program in ipairs(artifacts.programs) do
            local shader = artifacts.gpu[program.symbol]
            local gpu = shader ~= nil
                and {
                    artifactId = shader.artifactId,
                    sourceFile = shader.sourceFile,
                    sourceLine = shader.sourceLine,
                    sourceColumn = shader.sourceColumn,
                    entrypoint = shader.entrypoint,
                    threads = shader.threads,
                }
                or nil
            functions[
                position
            ] = {
                name = program.name,
                gpu = gpu,
                symbol = program.symbol,
                entryMode = program.entryMode,
                builderMode = program.builderMode,
                runtimeAbi = program.runtimeAbi,
                registrar = program.registrar,
                optimization = artifacts.optimizations[position],
                loops = artifacts.loops[position],
                regions = simdRegions(program),
            }
        end
        io.write(
            report.encode({
                file = path,
                target = {
                    triple = (selected as targets.Target).triple,
                    architecture = (selected as targets.Target).architecture,
                    tier = (selected as targets.Target).tier,
                },
                functions = functions,
                ir = (emit == nil or emit == "ir") and artifacts.irText or nil,
                c = (emit == nil or emit == "c")
                and (options.sourceLocations and inspectionC(artifacts, path) or artifacts.c)
                or nil,
                simd = simdText,
                spirv = spirvHex,
                wgsl = emit == "wgsl" and wgsl or nil,
                binding = (emit == nil or emit == "binding") and artifacts.binding or nil,
                asm = instructionReport,
            }) .. "\n"
        )
    elseif emit == "ir" then
        io.write(artifacts.irText)
    elseif emit == "c" then
        io.write(options.sourceLocations and inspectionC(artifacts, path) or artifacts.c)
    elseif emit == "simd" then
        io.write(simdText as string)
    elseif emit == "spirv" then
        io.write(spirvParts[1])
    elseif emit == "wgsl" then
        io.write(wgsl)
    elseif emit == "asm" then
        io.write(
            (
                "-- %s, %s, %s, %s\n"
            ):format(
                path,
                (selected as targets.Target).triple,
                (selected as targets.Target).tier,
                instructionReport.toolchain.version
            )
        )
        for _, listing in ipairs(instructionReport.functions) do
            writeListing(listing)
        end
    elseif emit == "binding" then
        io.write(artifacts.binding)
    else
        for _, program in ipairs(artifacts.programs) do
            io.write(summarise(path, program, artifacts) .. "\n")
        end
    end

    return 0
end

--- Show what the @aot functions in a file compile to.
---
--- With no artifact, reports what each function lowered to: the species every
--- `@simd` loop runs in, or that it runs scalar. Select verified IR, generated
--- C, the `@simd` rewrite as Nupp, native GPU SPIR-V, browser GPU WGSL, native
--- assembly, or the generated Nupp binding with `--emit`.
---
--- Examples:
---
---     nupp aot bench/kernel-subset-spike/mandelbrot.nupp
---     nupp aot --emit ir src/kernel.nupp
---     nupp aot --emit c src/kernel.nupp
---     nupp aot --emit simd bench/kernel-subset-spike/mandelbrot.nupp
---     nupp aot --emit asm --function scale src/kernel.nupp
---     nupp aot --emit wgsl --function transform src/gpu.nupp
---     nupp aot --format json src/kernel.nupp
@cli("aot")
@derive(cliModule.Command)
local record Aot
    --- Artifact to print: ir, c, simd, spirv, wgsl, asm, or binding.
    @cli(value = "ARTIFACT", choices = {"ir", "c", "simd", "spirv", "wgsl", "asm", "binding"})
    emit: string?

    --- Include authored #line locations in emitted C (assembly always carries them).
    sourceLocations: boolean = false

    --- Show only this function.
    @cli(name = "function", value = "NAME")
    functionName: string?

    --- Target triple to compile for.
    @cli(value = "TRIPLE")
    target: string?

    --- CPU feature tier to promise.
    @cli(value = "TIER")
    features: string?

    --- Calling Lua VM and source-checking dialect.
    @cli(value = "DIALECT", choices = {"luajit", "lua51"})
    dialect: string?

    --- Compiled object path used by a generated binding.
    @cli(value = "PATH")
    library: string?

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source file to inspect.
    @cli(positional = "FILE")
    file: string

    function run(self): integer
        return run(self)
    end
end

function Aot.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Aot}
