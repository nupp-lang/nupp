-- `nupp completions`: print shell completion generated from the CLI schema.

local spec = require("nupp.compiler.cli.spec")

local command = spec.command{
    name = "completions",
    summary = "Print a shell completion script",
    usage = {"nupp completions <bash|zsh|fish>"},
    positionals = {{name = "shell", choices = {"bash", "zsh", "fish"}}},
    options = {},
}

local function run(parsed: any): integer
    local shell = parsed.positional[1]
    if not shell or parsed.positional[2] then
        return command:usageError("completions requires exactly one shell")
    end
    if shell ~= "bash" and shell ~= "zsh" and shell ~= "fish" then
        return command:usageError("unknown shell " .. shell .. "; expected bash, zsh, or fish")
    end
    local cli = require("nupp.compiler.cli") as {commands: function(): {any}}
    io.write(require("nupp.compiler.cli.completions").render(shell, cli.commands()))

    return 0
end

return new spec.Handler(spec = command, run = run)
