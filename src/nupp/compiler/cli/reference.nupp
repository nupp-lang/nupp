module nupp.compiler.cli.reference

--[[
`nupp reference`: Nupp, small enough to hand to a reader in one piece.

The reference is compiled into the binary rather than fetched, so what prints
belongs to the compiler being run. That is the whole reason this is a command and
not a file on a website: a reader holding a reference from a different version is
worse off than one holding none, because they cannot tell.

Three renderings of one document. `markdown` is the document; `skill` wraps it in
the frontmatter an agent harness loads it by; `json` hands over the chapters and
sections themselves, for a consumer that would rather render its own.
]]

local usageError = require("nupp.compiler.cli.error").forCommand("reference")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        title = {type = "string"},
        sections = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    title = {type = "string", description = "The heading, and its anchor."},
                    body = {type = "string", description = "What the construct is for, as markdown."},
                    example = {
                        type = "string",
                        description = "A complete module using it. Every one "
                        .. "is compiled by the compiler's own tests."
                    },
                    codes = {
                        type = "array",
                        items = {type = "string"},
                        description = "The codes that report getting it " .. "wrong. 'nupp explain <code>' says more."
                    },
                },
                required = {"title", "body", "codes"},
            },
        },
        chapters = {
            type = "array",
            description = "Top-level reference chapters, each containing sections.",
            items = {type = "object"},
        },
        tooling = {type = "string", description = "How to drive the toolchain, as markdown."},
        markdown = {type = "string", description = "The whole document, as `--format markdown` writes it."},
    },
    required = {"title", "sections", "chapters", "tooling", "markdown"},
}

--- Writes `-o` output with the result checked, so a full disk is a failed
--- command rather than a truncated file reported as success.
local function writeOutput(path: string, content: string): integer
    local wrote, err = require("nupp.compiler.fs").writeFile(path, content .. "\n")
    if not wrote then
        io.stderr:write("nupp: " .. tostring(err) .. "\n")
        return 1
    end

    return 0
end

local function run(options: any): integer
    local positional: {string} = {}
    if options.chapter ~= nil then
        positional[1] = options.chapter
    end
    local reference = require("nupp.compiler.reference")
    if (options.skill and options.json) or (options.skill or options.json) and options.format ~= nil then
        return usageError("output format was specified more than once")
    end
    local format = options.skill and "skill" or options.json and "json" or options.format or "markdown"
    if #positional > 1 then
        return usageError("at most one reference chapter is required")
    end
    local topic = positional[1]
    local wantedSection = options.section
    local wantedCode = options.forCode
    if wantedSection and wantedCode then
        return usageError("--section and --for name the same thing two ways")
    end
    if (wantedSection or wantedCode) and topic then
        return usageError("--section and --for already say which part to print")
    end

    -- One section, or the sections covering one code. Both answer the question a
    -- reader actually arrived with, rather than handing over the chapter it lives in.
    if wantedSection or wantedCode then
        local chosen: {any} = {}
        if wantedSection then
            local section, chapter = reference.findSection(wantedSection)
            if not section then
                return usageError("no reference section named " .. wantedSection .. "; `nupp reference` lists them")
            end
            chosen[1] = {section = section, chapter = chapter}
        else
            for _, found in ipairs(reference.sectionsFor(wantedCode)) do
                chosen[#chosen + 1] = found
            end
            if #chosen == 0 then
                -- The code may still be real and simply not be what any section is
                -- about; `explain` is where a code always answers.
                return usageError(
                    "no reference section covers " .. wantedCode .. "; try `nupp explain " .. wantedCode .. "`"
                )
            end
        end
        local parts: {string} = {}
        for _, found in ipairs(chosen) do
            parts[#parts + 1] = reference.sectionMarkdown(found.section, found.chapter)
        end
        local rendered = table.concat(parts, "\n\n")
        if format == "skill" then
            rendered = reference.sectionSkill(chosen)
        elseif format == "json" then
            local sections: {any} = {}
            for _, found in ipairs(chosen) do
                sections[
                    #sections + 1
                ] = {
                    title = found.section.title,
                    body = found.section.body,
                    example = found.section.example,
                    codes = found.section.codes,
                }
            end
            local payload = {
                title = sections[1].title,
                sections = sections,
                chapters = {},
                tooling = reference.tooling,
                markdown = rendered,
            }
            if options.output then
                return writeOutput(options.output, require("nupp.compiler.cli.report").encode(payload))
            end
            require("nupp.compiler.cli.report").write(payload)
            return 0
        end
        if options.output then
            return writeOutput(options.output, rendered)
        end
        io.write(rendered, "\n")

        return 0
    end

    if not topic and not options.format and not options.output then
        io.write(reference.catalog(), "\n")
        return 0
    end
    local chapter = topic and topic ~= "all" and reference.chapter(topic) or nil
    if topic and topic ~= "all" and not chapter then
        return usageError("unknown reference chapter " .. topic)
    end
    local text
    if format == "skill" then
        text = reference.skill(chapter)
    elseif chapter then
        text = reference.chapterMarkdown(chapter)
    else
        text = reference.markdown()
    end

    if format == "json" then
        -- The whole document's sections are the chapters' sections, which carry
        -- the appended language material; `reference.sections` is only the raw
        -- language table and would leave the payload's `sections` disagreeing
        -- with its own `markdown` and `chapters`.
        local listed: {any} = {}
        if chapter then
            listed = chapter.sections
        else
            for _, one in ipairs(reference.chapters) do
                for _, section in ipairs(one.sections) do
                    listed[#listed + 1] = section
                end
            end
        end
        local sections: {any} = {}
        for _, section in ipairs(listed) do
            sections[
                #sections + 1
            ] = {title = section.title, body = section.body, example = section.example, codes = section.codes,}
        end
        local payload = {
            title = chapter and "Nupp " .. chapter.title .. " reference" or "Nupp reference",
            sections = sections,
            chapters = chapter and {chapter} or reference.chapters,
            tooling = reference.tooling,
            markdown = text,
        }
        if chapter then
            payload.chapter = chapter
        end
        if options.output then
            return writeOutput(options.output, require("nupp.compiler.cli.report").encode(payload))
        end
        require("nupp.compiler.cli.report").write(payload)
        return 0
    end

    if options.output then
        return writeOutput(options.output, text)
    end
    io.write(text, "\n")

    return 0
end

--- List or print a focused Nupp reference chapter.
---
--- With no chapter, lists the focused references and their sections. A
--- chapter is compiled into the executable and belongs to this compiler.
--- `--section` prints one section by heading or documentation pointer, and
--- `--for` prints the sections which explain one diagnostic code. Skill output
--- puts its short description in the always-loaded frontmatter and the full
--- reference in the lazily loaded body.
---
--- Examples:
---
---     nupp reference cli
---     nupp reference language
---     nupp reference --section affine-resources
---     nupp reference --section docs/learn/language/modules.md#modules
---     nupp reference --for NUPP2004
---     nupp reference cli --format skill -o .agents/skills/nupp-cli/SKILL.md
---     nupp reference performance --format skill -o .agents/skills/nupp-performance/SKILL.md
---     nupp reference --format skill -o .agents/skills/nupp/SKILL.md
@cli("reference")
@derive(cliModule.Command)
local record Reference
    --- Output format.
    @cli(value = "FORMAT", choices = {"markdown", "skill", "json"})
    format: string?

    --- Shorthand for --format skill.
    skill: boolean = false

    --- Shorthand for --format json.
    json: boolean = false

    --- Print one section, by heading or documentation pointer.
    @cli(value = "NAME")
    section: string?

    --- Print sections which explain a diagnostic code.
    @cli(name = "for", value = "CODE")
    forCode: string?

    --- Write to this file instead of standard output.
    @cli(short = "o", value = "PATH")
    output: string?

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Reference chapter to print.
    @cli(positional = "CHAPTER", choices = {"language", "cli", "performance", "all"})
    chapter: string?

    function run(self): integer
        return run(self)
    end
end

function Reference.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Reference}
