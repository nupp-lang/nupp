module nupp.compiler.cli.task

--[[
`nupp task`: build, then run one of `nupp.lua`'s named `tasks` entries.

The general case `test` is one fixed instance of: a task names an argv, an
optional build target to build first, and optional environment. Unlike
`test`, which always means the project's test command, this takes which task
by name, so a project can have any number of them -- a dev server, a release
script, whatever it runs by hand often enough to want a name for it rather
than a comment saying what to type.

Like `test`, arguments past the task's name are not this command's to read:
they are appended to the task's own argv and belong to whatever ends up
running.
]]

local spec = require("nupp.compiler.cli.spec")

local command = spec.command{
    name = "task",
    summary = "Build, then run a named task from nupp.lua",
    usage = {"nupp task <name> [args...]"},
    universal = false,
    options = {spec.helpOption},
    detail = [[Runs tasks.<name> from nupp.lua: builds tasks.<name>.build first if it names
one, then execs tasks.<name>.argv with any arguments after <name> appended.
See `nupp tasks` for the configured list.]],
}

local function run(args: any): integer
    -- A leading `--` was how the caller said the rest is the task's, including a first
    -- argument named --help that would otherwise have been answered here.
    if args[1] == "--" then
        table.remove(args, 1)
    end
    local name = table.remove(args, 1)
    if not name or name == "" then
        return command:usageError("a task name is required; see `nupp tasks`")
    end
    local project = require("nupp.compiler.build.project")

    return project.runTask(".", name, args)
end

export = new spec.Handler(spec = command, raw = true, run = run)
