module nupp.compiler.cli.task

--[[
`nupp task`: build, then run one of `nupp.lua`'s named `tasks` entries.

The general case `test` is one fixed instance of: a task names an argv, an
optional build target to build first, an optional working directory, and optional
environment. Unlike
`test`, which always means the project's test command, this takes which task
by name, so a project can have any number of them -- a dev server, a release
script, whatever it runs by hand often enough to want a name for it rather
than a comment saying what to type.

Like `test`, arguments past the task's name are not this command's to read:
they are appended to the task's own argv and belong to whatever ends up
running.
]]

local cliModule = require("nupp.cli")
local root = require("nupp.compiler.cli.root")

--- Build, then run a named task from nupp.lua.
---
--- Runs `tasks.<name>` from nupp.lua: builds `tasks.<name>.build` first when
--- it names one, then executes `tasks.<name>.argv` from `tasks.<name>.cwd`
--- (the project root by default) with every trailing argument appended. See
--- `nupp tasks` for the configured list.
@cli(name = "task", parent = root.Root, stopAtFirstArgument = true)
@derive(cliModule.Command)
local record Task
    --- Configured task name.
    @cli(positional = "NAME")
    name: string

    --- Arguments appended to the configured command.
    @cli(remainder = true, value = "ARG")
    arguments: {string} = {}

    function run(self): integer
        return require("nupp.compiler.build.project").runTask(".", self.name, self.arguments)
    end
end

export = {commandType = Task}
