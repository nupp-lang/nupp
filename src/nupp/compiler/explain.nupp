    code = "NUPP5001",
    summary = "A running program cannot apply a change without a restart",
    rule = "Hot reload replaces a watched module's callable bodies in place, but cannot rebind top-level executable statements or initializers, add, remove, rename or move a named declaration, change a callable's signature or capture set, change a record, struct, native or component layout, or repatch a function that took ownership of a cleanup-bearing capture. Loaded FFI declarations, native libraries, and values already built from them are likewise fixed for the life of the process. Any such edit is rejected with NUPP5001 and the previous generation keeps running until the process restarts.",
    related = {},
    docs = "docs/guides/hot-reload.md#changes-that-require-restart",
}

local byCode: {[string]: any} = {}
for _, entry in ipairs(ENTRIES) do
    byCode[entry.code] = entry
end

-- The lint registry already knows each lint's name, category and one-line summary, so a
-- lint's entry is filled in from there rather than said twice.
local function lintFor(code: string): any
    local lints = require("nupp.compiler.lints")
    for _, lint in ipairs(lints.all) do
        if lint.code == code then
            return lint
        end
    end

    return nil
end

local function familyFor(code: string): any
    for _, family in ipairs(FAMILIES) do
        if code:sub(1, #family.prefix) == family.prefix then
            return family
        end
    end

    return nil
end

--- Where the reference covers a code, for the `docs` field on a diagnostic. Returns nil
--- for a code from no family at all, which should not happen and is not worth inventing
--- an answer for.
function explain.anchor(code: string?): string?
    if not code then
        return nil
    end
    local entry = byCode[code]
    if entry then
        return entry.docs
    end
    local family = familyFor(code)

    return family and family.docs or nil
end

--- Everything known about a code, or nil when it belongs to no family.
function explain.lookup(code: string): explain.Entry?
    local entry = byCode[code]
    local family = familyFor(code)
    if not entry and not family then
        return nil
    end
    local lint = lintFor(code)
    if entry then
        return new explain.Entry(
            code = code,
            summary = entry.summary,
            rule = entry.rule,
            wrong = entry.wrong,
            right = entry.right,
            strict = entry.strict and true or false,
            related = entry.related or {},
            docs = entry.docs,
            family = false
        )
    end

    return new explain.Entry(
        code = code,
        summary = lint and lint.summary or family.summary,
        rule = lint and (
            "A lint, reported at "
            .. lint.level
            .. " by default and configurable by name or by category. "
            .. family.rule
        ) or family.rule,
        wrong = nil,
        right = nil,
        strict = false,
        related = {},
        docs = lint and "docs/reference/lints.md" or family.docs,
        family = true
    )
end

--- What the family a code belongs to is called, for grouping codes under a heading.
--- Returns nil for a code from no family at all.
function explain.familyTitle(code: string): string?
    local family = familyFor(code)

    return family and family.title or nil
end

--- Every code a page can be written for, sorted: the codes with entries of their own,
--- and every lint's code. A code that resolves only through its family is left out,
--- because the family answers for all of them at once and a page would repeat it under
--- a number that adds nothing.
function explain.documented(): {string}
    local codes: {string} = {}
    local seen: {[string]: boolean} = {}
    for _, entry in ipairs(ENTRIES) do
        if not seen[entry.code] then
            seen[entry.code], codes[#codes + 1] = true, entry.code
        end
    end
    local lints = require("nupp.compiler.lints")
    for _, lint in ipairs(lints.all) do
        if not seen[lint.code] then
            seen[lint.code], codes[#codes + 1] = true, lint.code
        end
    end
    table.sort(codes)

    return codes
end

--- Every code with an entry of its own, sorted. What `nupp explain` lists when it is
--- not given a code.
function explain.codes(): {string}
    local codes: {string} = {}
    for _, entry in ipairs(ENTRIES) do
        codes[#codes + 1] = entry.code
    end
    table.sort(codes)

    return codes
end

--- The entries with examples, for the test that compiles each one.
explain.entries = ENTRIES

export = explain
