--[[
What a diagnostic code means, at more length than a diagnostic has room for.

A diagnostic says what is wrong with one program. This says what the rule is,
shows a program that breaks it and the same program fixed, and points at the
reference section that covers the area. `nupp explain NUPP2119` is the command;
`docs` is also attached to every diagnostic `--json` writes, so a reader that
has a diagnostic in hand can get here without being told how.

The examples are not decoration. A test compiles every `wrong` and asserts it
really does report the code it is filed under, so an example cannot quietly stop
demonstrating the thing it was written to demonstrate.

A code with no entry of its own still resolves, through its family: the rule and
the reference are the family's, and what is missing is the pair of examples. That
is honest about what is known rather than inventing a program to fit a code.
]]

local explain = {}

--- What is known about one diagnostic code.
record explain.Entry
    code: string

    --- One line: what the diagnostic is about.
    summary: string

    --- The general statement the code enforces, in a sentence or two.
    rule: string

    --- A program that reports it. Absent when only the family is known.
    wrong: string?

    --- The same program, corrected.
    right: string?

    --- Whether the rule only applies under `--strict`. Worth knowing before wondering
    --- why a program the reference calls wrong checks clean.
    strict: boolean

    --- Codes worth reading beside it.
    related: {string}

    --- The reference section that covers it, as a path and anchor.
    docs: string

    --- Whether this came from the code's own entry or from its family.
    family: boolean
end

-- The families, from docs/diagnostics.md. Every code falls in one, so every code can be
-- explained at least this far.
local FAMILIES = {
    {
        prefix = "NUPP0",
        title = "Input",
        summary = "Source input could not be read",
        rule = "The compiler was given a path it could not read. This is about "
        .. "the file system rather than the program: the path does not "
        .. "exist, or is not readable.",
        docs = "docs/diagnostics.md#code-families"
    },
    {
        prefix = "NUPP1",
        title = "Syntax",
        summary = "The source is not syntactically valid",
        rule = "The parser could not read the file as Nupp. Recovery continues "
        .. "past the first error, so several of these often describe one "
        .. "mistake.",
        docs = "docs/diagnostics.md#code-families"
    },
    {
        prefix = "NUPP2",
        title = "Types, declarations, and rules",
        summary = "A type, declaration, lint, FFI or ownership rule",
        rule = "The program parses but does not mean something the checker can "
        .. "accept, or means something its author probably did not intend.",
        docs = "docs/diagnostics.md#code-families"
    },
    {
        prefix = "NUPP3",
        title = "Code generation",
        summary = "Code generation cannot represent the construct",
        rule = "The program checked, but the generator cannot lower it to Lua. "
        .. "This is a limit of the backend rather than a mistake in the "
        .. "program's typing.",
        docs = "docs/diagnostics.md#code-families"
    },
    {
        prefix = "NUPP4",
        title = "Formatting",
        summary = "Formatting could not safely produce the result",
        rule = "The formatter declines to rewrite source it cannot prove it "
        .. "would preserve. Formatting is never allowed to change meaning.",
        docs = "docs/diagnostics.md#code-families"
    },
    {
        prefix = "OPT",
        title = "Optimizer remarks",
        summary = "An optimizer remark",
        rule = "Not a problem. A pass saying what it rewrote, or what it looked "
        .. "at and declined to rewrite. Always a note, and never fails a "
        .. "build.",
        docs = "plans/optimizations.md"
    },
}

-- Codes with examples. `wrong` reports the code; `right` does not.
local ENTRIES: {
    any
} = {{
    code = "NUPP0001",
    summary = "A source file could not be read",
    rule = "The path named on the command line, or reached from a require, "
    .. "could not be opened. Check the spelling and that the file is "
