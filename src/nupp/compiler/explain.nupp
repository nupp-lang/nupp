    related = {"NUPP2506"},
    docs = "docs/reference.md#docblocks",
}, {
    code = "NUPP1006",
    summary = "The typed layer appears in a plain Lua file",
    rule = "A `.lua` file is Lua. The toolchain will require, build and run "
