module nupp.compiler.builtinextensions

-- Existing host tables retain their identity. Checked private modules supply
-- additional members and publish that same table as their internal value.
local T = require("nupp.compiler.types")
local members = require("nupp.compiler.types.members")
local native = require("nupp.compiler.native")
local extensions = {}

local ROOTS = {
    warn = {module = "warn", direct = true},
    assert = {module = "assert", direct = true},
    table = {module = "nupp.runtime.standardtable", members = {move = true, Pool = true, newpool = true}},
    io = {
        module = "nupp.runtime.standardio",
        replace = {popen = true, open = true, lines = true, input = true, output = true},
        members = {
            newpath = true,
            cwd = true,
            sep = true,
            open = true,
            lines = true,
            input = true,
            output = true,
            Error = true,
            popen = true,
            processexit = true,
            newbuffer = true,
            newlines = true,
            newreader = true,
            newwriter = true,
            newsreader = true,
            newswriter = true,
            readall = true,
        }
    },
    coroutine = {
        module = "nupp.runtime.standardcoroutine",
        members = {
            Cancellation = true,
            Scope = true,
            scope = true,
            checkpoint = true,
            deadline = true,
            gather = true,
            race = true,
            run = true,
            iscancelled = true,
            sleep = true,
            sleepuntil = true,
            wakeat = true,
        }
    },
    os = {
        module = "nupp.runtime.standardos",
        members = {info = true, uuid4 = true, uuid7 = true, monotonic = true, walltime = true, randombytes = true,}
    },
}

function extensions.has(root: string): boolean
    return ROOTS[root] ~= nil
end

function extensions.member(root: string, name: string): boolean
    local specification = ROOTS[root]
    return specification ~= nil and (specification.direct == true or specification.members[name] == true)
end

local function firstUse(c: any, root: string): boolean
    local observed = c.builtinExtensionUses
    if not observed then
        observed = {}
        c.builtinExtensionUses = observed
    end
    if observed[root] then
        return false
    end
    observed[root] = true

    return true
end

-- Select a declared implementation without loading it or mutating builtin maps.
function extensions.implementation(env: any, root: string): string?
    local specification = ROOTS[root]
    if not specification or not env or env.bootstrapping then
        return nil
    end
    local index = env.ensureProjectIndex and env.ensureProjectIndex(env)
    local declared = index and index.declaredModules[specification.module]
    if not declared then
        local path = env.findModulePath and env.findModulePath(env, specification.module)
        if path and not (env.isStagedBundledSource and env.isStagedBundledSource(env, specification.module, path)) then
            return nil
        end
        local bundled = env.bundled and env.bundled[specification.module]
        if not bundled or bundled.declared ~= true then
            return nil
        end
    end

    return specification.module
end

-- Compile an extension at most once per environment, outside the prelude and
-- outside its own dependency cycle. Missing modules are normal in the accepting
-- seed, before their source adoption.
function extensions.type(c: any, root: string): any
    local specification = ROOTS[root]
    local env = c.env
    if not specification or not env or env.bootstrapping then
        return nil
    end
    local pending = env.builtinExtensions
    if not pending then
        pending = {};
        env.builtinExtensions = pending
    end
    if pending[root] ~= nil then
        if pending[root] and firstUse(c, root) then
            -- Query-local environments can inherit the canonical extension cache.
            -- Each check still observes its module and owns its member-effect view.
            if env.resolveModule then
                env.resolveModule(env, specification.module)
            end
            env.featureEffects = native.decorateGlobals(env.globals)
        end
        return pending[root] or nil
    end
    pending[root] = false
    -- An implicit Lua helper can share a builtin's name without implementing it.
    if not extensions.implementation(env, root) then
        return nil
    end
    local extension = env.resolveModule and env.resolveModule(env, specification.module)
    local original = env.globals and env.globals[root]
    if not extension or not original or not specification.direct and original.t.tag ~= "shape" then
        return nil
    end
    local view = members.view(extension)
    local fields, seen, replaced = {}, {}, {}
    for _, field in ipairs(not specification.direct and original.t.fields or {}) do
        if specification.replace and specification.replace[field.name] and view.byname[field.name] then
            replaced[field.name] = field
        else
            fields[#fields + 1] = field
            seen[field.name] = true
        end
    end
    for _, field in ipairs(view.ordered) do
        if not specification.direct and specification.members[field.name] and not seen[field.name] then
            local preceding = replaced[field.name]
            fields[
                #fields + 1
            ] = {
                name = field.name,
                read = field.readType,
                write = field.writeType or preceding and preceding.write and field.readType,
            }
        end
    end
    local merged = specification.direct and extension
        or T.shape(
            fields,
            {
                readKey = original.t.indexReadKey,
                readValue = original.t.indexReadValue,
                writeKey = original.t.indexWriteKey,
                writeValue = original.t.indexWriteValue,
            },
            original.t.fresh,
            original.t.closed
        )
    -- Prelude views may be shared by other environments. Each extension owns
    -- only this environment's maps while retaining the declaration objects.
    if not env.ownsBuiltinExtensionMaps then
        local globals, types, definitions = {}, {}, {}
        for key, value in pairs(env.globals) do
            globals[key] = value
        end
        for key, value in pairs(env.globalTypes) do
            types[key] = value
        end
        for key, value in pairs(env.globalTypeDefs) do
            definitions[key] = value
        end
        env.globals, env.globalTypes, env.globalTypeDefs = globals, types, definitions
        env.ownsBuiltinExtensionMaps = true
    end
    local entry = {}
    for key, value in pairs(original) do
        entry[key] = value
    end
    entry.t = merged
    env.globals[root] = entry
    env.featureEffects = native.decorateGlobals(env.globals)
    local exports = env.resolveModuleExports and env.resolveModuleExports(env, specification.module)
    local published = env.builtinExtensionExports or {}
    env.builtinExtensionExports = published
    published[root] = exports
    for name, value in pairs(exports and exports.types or {}) do
        env.globalTypes[root .. "." .. name] = value
        if exports.typeDefs then
            env.globalTypeDefs[root .. "." .. name] = exports.typeDefs[name]
        end
    end
    pending[root] = merged
    firstUse(c, root)

    return merged
end

local function project(node: any, root: string): nil
    node.standardRoot = root
    node.qualifiedModule = ROOTS[root].module
    node.qualifiedMembers = ROOTS[root].direct and {} or {"value"}
    if ROOTS[root].direct then
        node.requiredModule = root
    end
    node.namespacePath = root
end

function extensions.read(c: any, node: any, root: string, entry: any): any
    if node.skipBuiltinExtension then
        return nil
    end
    local builtin = c.env and c.env.globals and c.env.globals[root]
    if not builtin or not entry or entry.definition ~= builtin.definition then
        return nil
    end
    local t = extensions.type(c, root)
    if t then
        project(node, root)
    end

    return t
end

function extensions.require(c: any, node: any, root: string): any
    local t = extensions.type(c, root)
    if t then
        project(node, root)
    end

    return t
end

export = extensions
