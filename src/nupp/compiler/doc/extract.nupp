module nupp.compiler.doc.extract

--[[
The CST of one file, read as its documented declarations.

Every question this asks is answered by the parse alone: what a declaration is
called, what it is spelled like, which `---` run belongs to it. That is why
documentation never invokes the checker.
]]

local cst = require("nupp.compiler.cst")
local lexer = require("nupp.compiler.lexer")
local parser = require("nupp.compiler.parser")
local docblock = require("nupp.compiler.docblock")
local formatter = require("nupp.compiler.fmt")
local stringsMod = require("nupp.compiler.doc.strings")
local filesMod = require("nupp.compiler.doc.files")

local trim = stringsMod.trim
local normalize, join = filesMod.normalize, filesMod.join

local extract = {}

----------------------------------------------------------------------------
-- What extraction produces
----------------------------------------------------------------------------

--- One argument: its name and type as the source spelled them, and what `@param` said.
type extract.Param = {
    name: string,
    type: string,
    mode: string?,
    text: string
}

--- One result: a type and a description, with no name to hang them on.
type extract.Result = {
    type: string,
    text: string
}

--- One type parameter, and what `@typearg` said about it.
type extract.TypeArg = {
    name: string,
    text: string
}

--- A field, method, nested type, or metamethod of a record, interface, or struct. A
--- function-typed one carries its own arguments and results, which is what tells a
--- method apart from a field; a nested type carries its own members recursively,
--- which is what tells it apart from both. A record, not a `type` alias, because a
--- nested type's own members recur through this same shape.
record extract.Member
    name: string
    type: string
    text: string
    path: string
    params: {extract.Param}
    returns: {extract.Result}
    raises: {string}
    isFunction: boolean?
    isMetamethod: boolean?
    isType: boolean?
    members: {Member}?

    --- The compiler-only value kind, when this member exists only during comptime.
    comptimeKind: string?

    --- What it was annotated with, as written, such as `@derive(nupp.derive.JSON)`.
    annotations: {string}?
end

--- One documented declaration: what it is called, how it is spelled, and everything its
--- `---` run said about it.
type extract.Item = {
    name: string,
    kind: string,
    signature: string,
    aliasSource: string?,
    doc: docblock.Doc,
    path: string,
    module: string?,
    line: integer,
    members: {extract.Member},
    params: {extract.Param},
    returns: {extract.Result},
    raises: {string},
    typeargs: {extract.TypeArg},
    annotations: {string}?,

    --- The compiler-only value kind, when this declaration exists only during
    --- comptime. Kept apart from `kind`, so functions retain their ordinary API
    --- grouping while renderers can distinguish when they are callable.
    comptimeKind: string?
}

--- One source file, read as its documented declarations.
type extract.Module = {
    name: string,
    path: string?,
    text: string,
    items: {extract.Item},
    documentationInternal: boolean?,
    imports: {[string]: string}?,
    moduleLocal: string?,

    --- Set on a name that only holds other modules. There is no file behind one and
    --- nothing to require by that name, so it has no source and no declarations.
    namespace: boolean?
}

--- What a caller wants included beyond the public surface a module hands out.
---
--- `shapesAsModules` is for a file whose declarations are globals rather than a
--- module's
--- exports: every shape-typed global comes back as a module of its own name, holding
--- the
--- shape's fields, and the file's remaining declarations stay items of the file itself.
--- That is `string`, `table` and the rest of the LuaJIT standard library, which a
--- reader
--- meets as `string.format` and never as a member of the file that declares it. A
--- global
--- carrying `@namespace` is left out entirely under this option: it names modules of
--- its
--- own, which an ordinary run documents already.
type extract.Options = {
    includeAll: boolean?,
    includePrivate: boolean?,
    shapesAsModules: boolean?
}

----------------------------------------------------------------------------
-- Text and visibility
----------------------------------------------------------------------------

local function firstToken(node)
    if not node then
        return nil
    end
    if cst.isToken(node) then
        return node
    end
    for _, child in ipairs(node) do
        local token = firstToken(child)
        if token then
            return token
        end
    end

    return nil
end

-- Source text carries the indentation of wherever it was written, and every use of it
-- here renders at the left edge of a code block instead. Trimming puts the first line
-- on that edge and leaves the rest stepped by a margin that is no longer there, so a
-- declaration written eight columns in reads as though its arguments were indented
-- twelve. Taking away what the continuation lines have in common restores the shape
-- the author wrote without flattening what they nested inside it.
local function dedent(text: string): string
    if not text:find("\n", 1, true) then
        return text
    end
    local margin, found = "", false
    for line in text:gmatch("\n([^\n]*)") do
        if not line:match("^[ \t]*$") then
            local indent = line:match("^[ \t]*") or ""
            if not found or #indent < #margin then
                margin, found = indent, true
            end
        end
    end
    if margin == "" then
        return text
    end

    return (text:gsub("\n" .. margin, "\n"))
end

-- The `---` run and its tags are read by nupp.compiler.docblock, because the checker
-- reads
-- the
-- same run to ask whether a function that raises documented it.
local docLines, parseDoc = docblock.linesOf, docblock.parse

-- Where a record entry's `---` run actually sits. An annotation is parsed before the
-- entry it modifies, so the run written above `@derive` attaches to the `@` rather than
-- to the declaration underneath it, and asking the entry answers nothing. The first
-- annotation is the top of what the author wrote, the same way a `pragmaStmt` wrapper
-- is for a top-level statement.
local function documentedNode(entry)
    local annotations = entry and entry.annotations
    return annotations and annotations[1] or entry
end

local function entryDoc(entry)
    return parseDoc(docLines(documentedNode(entry)))
end

-- A declaration file is public by construction: it has no implementation to hide, and
-- `local` there does not mean private. The prelude's bindings are checked with
-- declare_globals and become every program's globals, and a bundled module's locals are
-- what its `return` hands out. Documentation stops after parsing, so it cannot see
-- either and would otherwise drop the one kind of file that is nothing but public
-- surface. `@local` still opts a declaration out.
local function privateName(name)
    local tail = tostring(name or ""):match("([^%.:]+)$") or ""
    tail = tail:gsub("^[\"']", "")
    return tail:sub(1, 1) == "_"
end

-- A cleanup whose own declaration documentation leaves out has no business appearing in
-- a signature documentation publishes. The prelude's `__nuppDestroyReader` is the
-- clearest case: it is the library's terminal, a reader neither calls it nor writes it
-- down, and printing it in every `nupp.io` signature says otherwise.
--
-- Dropping the argument would be worse than printing it, because `affine(T)` is not
-- `affine(T, cleanup)` with the cleanup left off. It is a different type:
-- transfer-only, with deliberately no terminal at all. So the argument is replaced
-- rather than removed. `_` keeps the type honest -- this value carries a cleanup
-- obligation -- while saying the name behind it is not the reader's to name.
local function withoutHiddenTerminals(text: string): string
    local pieces: {string} = {}
    local index = 1
    while true do
        local start, open = text:find("affine[ \t\n]*%(", index)
        if start == nil or open == nil then
            break
        end
        -- `affine` has to be the whole word. A field or function whose name merely ends
        -- in it, `myAffine(x, _y)`, is somebody else's call and is left alone.
        local before = start > 1 and text:sub(start - 1, start - 1) or ""
        if before:match("[%w_%.:]") ~= nil then
            pieces[#pieces + 1] = text:sub(index, open)
            index = open + 1
        else
            local depth, cursor, comma = 1, open + 1, nil
            while cursor <= #text and depth > 0 do
                local char = text:sub(cursor, cursor)
                if char == "(" or char == "[" or char == "{" then
                    depth = depth + 1
                elseif char == ")" or char == "]" or char == "}" then
                    depth = depth - 1
                elseif char == "," and depth == 1 and comma == nil then
                    comma = cursor
                end
                cursor = cursor + 1
            end
            local closeAt = cursor - 1
            local cleanup = comma ~= nil and depth == 0 and trim(text:sub(comma + 1, closeAt - 1)) or ""
            if cleanup ~= "" and cleanup:match("^[%w_%.:]+$") ~= nil and privateName(cleanup) then
                pieces[#pieces + 1] = text:sub(index, comma)
                pieces[#pieces + 1] = " _"
                index = closeAt
            else
                pieces[#pieces + 1] = text:sub(index, open)
                index = open + 1
            end
        end
    end
    pieces[#pieces + 1] = text:sub(index)

    return table.concat(pieces)
end

local function syntax(node)
    return withoutHiddenTerminals(dedent(trim(cst.textOf(node))))
end

-- A module whose name has an `internal` segment is private the same way a file below an
-- `internal/` directory is. The rule is on the name rather than on the path so that a
-- namespace an `@namespace` declaration implies, which has no file behind it, answers
-- it
-- too.
local function internalModuleName(name: string?): boolean
    return ("." .. tostring(name or "") .. "."):find(".internal.", 1, true) ~= nil
end

-- The entries of a record, interface, or struct that documentation leaves out: a name
-- starting with `_`, and anything tagged `@internal`. A metamethod is exempt from the
-- name rule rather than an exception to it, since a metamethod is named for the Lua
-- operation
-- it implements, so `__index` says which operator this is and never says private.
local function hiddenEntry(entry, includePrivate)
    if includePrivate then
        return false
    end
    if entry.privacy or entryDoc(entry).tags.internal then
        return true
    end

    return entry.kind ~= "metamethodDecl" and privateName(entry.name and entry.name.text or "")
end

-- Every node a signature must leave out to leave one entry out. An entry is not the
-- whole of what was written for it: an annotation is parsed before the entry it
-- modifies and attached to the enclosing structure, so dropping only the entry strands
-- its annotations in the block above the next visible one. Collecting the set up front
-- also keeps the walk from asking about nodes that are not entries at all, since it
-- reaches parameters, type references and expressions too, and any of those can be
-- named `_x` without that saying anything about what a reader may see.
local function hiddenNodes(node, includePrivate)
    local dropped = {}
    local function mark(current)
        if cst.isToken(current) then
            return
        end
        for _, entry in ipairs(current.entries or current.fields or {}) do
            if hiddenEntry(entry, includePrivate) then
                dropped[entry] = true
                for _, annotation in ipairs(entry.annotations or {}) do
                    dropped[annotation] = true
                end
            end
        end
        for _, child in ipairs(current) do
            mark(child)
        end
    end

    mark(node)

    return dropped
end

-- A structure's signature is its complete declaration, not only its opening line.
-- Documentation is rendered beside the code block, so omit `---` trivia and executable
-- function blocks while preserving ordinary comments and every declaration token, then
-- let the language's own formatter decide indentation and line breaks. Keeping the
-- function's closing `end` leaves the complete structure parseable for highlighting and
-- member links without publishing an interface default, method, or constructor body.
local function structureSignature(node, includePrivate)
    local parts: {string} = {}
    local dropped = hiddenNodes(node, includePrivate)
    -- Leading trivia belongs to whatever the declaration follows rather than to the
    -- declaration, so a signature starts at its own first token. A file's header
    -- comment
    -- is the case that shows: it sits on the first token of the first statement, and a
    -- structure declared there would otherwise carry the whole header into its code
    -- block, where the page has already rendered it as the module's prose.
    local leading = true
    local function walk(child)
        if cst.isToken(child) then
            local triviaParts: {string} = {}
            local removedDocumentation = false
            for index = 1, leading and 0 or child.triviaCount do
                local text = lexer.triviaText(child, index)
                if lexer.triviaKind(child, index) == "comment" and text:match("^%-%-%-") then
                    removedDocumentation = true
                else
                    triviaParts[#triviaParts + 1] = text
                end
            end
            local triviaText = table.concat(triviaParts)
            if removedDocumentation then
                if triviaText:match("^%s*$") then
                    triviaText = "\n"
                else
                    repeat
                        local collapsed, count = triviaText:gsub("\n[ \t]*\n[ \t]*", "\n")
                        triviaText = collapsed
                    until count == 0
                end
            end
            parts[#parts + 1] = triviaText
            parts[#parts + 1] = child.text
            leading = false
        else
            -- A hidden node leaves with the trivia its first token owns, which is the
            -- blank line and the `---` run written above it, so removing one from the
            -- block reads as though it had never been written there.
            if dropped[child] then
                return
            end
            for _, nested in ipairs(child) do
                if child.kind ~= "funcbody" or nested ~= child.body then
                    walk(nested)
                end
            end
        end
    end

    walk(node)
    local source = trim(table.concat(parts))
    local formatted, errors = formatter.format(source, "documentation-signature.nupp")
    if #errors > 0 then
        return withoutHiddenTerminals(source)
    end

    -- Formatter style normally places every block's `end` on its own line. A
    -- documentation signature has already removed function bodies, so keeping that
    -- empty block on one line makes records with several methods materially tighter.
    local lines: {string} = {}
    local inFunction = false
    local justClosed = false
    for line in (trim(formatted) .. "\n"):gmatch("([^\n]*)\n") do
        if line:match("^%s*function%s") or line:match("^%s*constructor[%s%(]") then
            inFunction = true
        end
        if inFunction and line:match("^%s*end%s*$") then
            lines[#lines] = (lines[#lines] or "") .. " end"
            inFunction = false
            justClosed = true
        else
            if justClosed then
                if line == "" then
                    justClosed = false
                elseif not line:match("^%s*end%s*$") then
                    lines[#lines + 1] = ""
                    justClosed = false
                else
                    justClosed = false
                end
            end
            lines[#lines + 1] = line
        end
    end

    return withoutHiddenTerminals(trim(table.concat(lines, "\n")))
end

----------------------------------------------------------------------------
-- Annotations
----------------------------------------------------------------------------

-- Every token under one annotation argument, in order. A separate function rather than
-- one written inside the loop over the arguments, because a function built inside a
-- loop is one LuaJIT never compiles.
local function annotationTokens(child, parts: {string}): nil
    if cst.isToken(child) then
        parts[#parts + 1] = child.text
    else
        for _, nested in ipairs(child) do
            annotationTokens(nested, parts)
        end
    end
end

-- One annotation as it was written. Built from the name and its arguments rather than
-- from the node's text, because a node carries its leading trivia and that trivia is
-- the
-- `---` run the annotation was written under.
local function annotationText(node): string?
    local name = node and node.name and node.name.text
    if not name then
        return nil
    end
    local args = {}
    for _, arg in ipairs(node.annotationArgs or {}) do
        local parts: {string} = {}
        annotationTokens(arg, parts)
        args[#args + 1] = trim(table.concat(parts))
    end
    if #args == 0 then
        return "@" .. name
    end

    return "@" .. name .. "(" .. table.concat(args, ", ") .. ")"
end

-- What a record entry or shape field was annotated with.
local function annotationsOf(entry): {string}?
    local applied = entry and entry.annotations
    if not applied or #applied == 0 then
        return nil
    end
    local names = {}
    for _, node in ipairs(applied) do
        local text = annotationText(node)
        if text then
            names[#names + 1] = text
        end
    end

    return #names > 0 and names or nil
end

----------------------------------------------------------------------------
-- Signatures
----------------------------------------------------------------------------

-- A declaration's name as it was written, table and all. Readers reach a member as
-- `cst.Node`, so that is what the signature has to show.
local function declaredName(stat)
    local name = stat.name.text
    if not stat.qualifiers then
        return name
    end
    local parts = {}
    for j, token in ipairs(stat.qualifiers) do
        parts[j] = token.text
    end
    parts[#parts + 1] = name

    return table.concat(parts, ".")
end

local function genericText(node)
    return node and node.generics and syntax(node.generics) or ""
end

-- The arguments table records which values a call borrows. Repeating a returned
-- borrow's sources in the signature and result table adds no useful API information,
-- so documentation shows the returned value's type alone. This is presentation only:
-- the source declaration keeps the `borrows (...)` contract the checker needs to
-- prove that the result cannot outlive its root.
local function documentedResultType(value)
    if value and value.kind == "tborrows" then
        return syntax(value.type)
    end

    return syntax(value)
end

local function functionSignature(stat, name)
    local body = stat.body
    local params = {}
    for _, param in ipairs(body and body.params or {}) do
        local piece
        if param[1] and param[1].kind == "..." then
            piece = "..." .. (param.name and param.name.text or "")
        else
            piece = (param.modeTok and (param.modeTok.text .. " ") or "") .. (param.name and param.name.text or "?")
        end
        if param.type then
            piece = piece .. ": " .. syntax(param.type)
        end
        params[#params + 1] = piece
    end
    local returns = {}
    for _, value in ipairs(body and body.rets or {}) do
        returns[#returns + 1] = documentedResultType(value)
    end
    local prefix
    if stat.kind == "localFuncStmt" then
        prefix = (stat.isConst and "const " or "local ") .. (stat.comptimeTok and "comptime " or "") .. "function "
    else
        prefix = (stat.comptimeTok and "comptime " or "") .. "function "
    end
    local result = prefix .. name .. genericText(body) .. "(" .. table.concat(params, ", ") .. ")"
    if #returns > 0 then
        result = result .. ": " .. table.concat(returns, ", ")
    end

    return result
end

local function cdefSignature(stat)
    local params = {}
    for _, param in ipairs(stat.params or {}) do
        if param[1] and param[1].kind == "..." then
            params[#params + 1] = "..."
        else
            local value = (
                param.modeTok and (param.modeTok.text .. " ") or ""
            ) .. (param.name and param.name.text or "?") .. ": " .. (param.type and syntax(param.type) or "any")
            params[#params + 1] = value
        end
    end
    local result = "cdef function " .. stat.name.text .. "(" .. table.concat(params, ", ") .. ")"
    if stat.ret then
        result = result .. ": " .. syntax(stat.ret)
    end
    if stat.fromLib then
        result = result .. " from " .. stat.fromLib.text
    end

    return result
end

local function functionDetails(stat, info)
    local details = {params = {}, returns = {}}
    for _, param in ipairs(stat.body and stat.body.params or stat.params or {}) do
        local name = param.name and param.name.text or "..."
        details.params[
            #details.params + 1
        ] = {
            name = name,
            type = param.type and syntax(param.type) or "any",
            mode = param.modeTok and param.modeTok.text or nil,
            text = info.params[name] or "",
        }
    end
    local returns = stat.body and stat.body.rets or (stat.ret and {stat.ret} or {})
    for index, value in ipairs(returns or {}) do
        details.returns[#details.returns + 1] = {type = documentedResultType(value), text = info.returns[index] or "",}
    end

    return details
end

-- A declaration file writes its functions as typed bindings, as in `local ipairs:
-- function<V>(t: {V}): ...`, and a record writes its methods as fields, so the
-- parameters and results live in a `tfunc` type node instead of a function body. They
-- carry the same annotations and document the same way.
--
-- An overloaded binding writes an intersection of those nodes rather than one, and it
-- is still a function to whoever calls it. The widest overload speaks for the set: a
-- doc block names every parameter any overload takes, so choosing a narrower one would
-- leave some of them with nowhere to attach. The rendered signature still shows every
-- overload, because that comes from the whole written type.
local function typeFunction(node)
    if not node then
        return nil
    end
    if node.kind == "tfunc" then
        return node
    end
    if node.kind ~= "tintersection" then
        return nil
    end
    local widest = nil
    for _, member in ipairs(node.types or {}) do
        if member.kind ~= "tfunc" then
            return nil
        end
        if not widest or #(member.params or {}) > #(widest.params or {}) then
            widest = member
        end
    end

    return widest
end

-- Compiler-only function and type handles retain their ordinary declaration kind for
-- sorting and grouping. This is the phase-qualified kind a renderer puts on the
-- badge instead.
local function comptimeKind(node): string?
    local fn = typeFunction(node)
    if fn then
        for _, overload in ipairs(node.kind == "tintersection" and node.types or {node}) do
            if not overload.comptimeOnly then
                return nil
            end
        end
        return "function"
    end
    if node and node.comptimeOnly then
        return "type"
    end

    return nil
end

local function typeFunctionDetails(node, info)
    local details = {params = {}, returns = {}}
    for _, param in ipairs(node.params or {}) do
        local name = param.name and param.name.text or (param[1] and param[1].kind == "..." and "...") or "?"
        details.params[
            #details.params + 1
        ] = {
            name = name,
            type = param.type and syntax(param.type) or "any",
            mode = param.modeTok and param.modeTok.text or nil,
            text = info.params[name] or "",
        }
    end
    for index, value in ipairs(node.rets or {}) do
        details.returns[#details.returns + 1] = {type = syntax(value), text = info.returns[index] or "",}
    end

    return details
end

----------------------------------------------------------------------------
-- Fields and shapes
----------------------------------------------------------------------------

-- One field of a shape type or a record, read as the top-level item a synthesized
-- namespace module holds it as. Shares its shape with `declarationItem`'s own field and
-- record-entry handling, but produces a full `extract.Item` rather than a lighter
-- `extract.Member`: a synthesized module's fields are what a reader scrolls to, the
-- same
-- as an ordinary module's functions and values.
local function fieldItem(field, childModuleName, includePrivate)
    local name = field.name.text
    local info = entryDoc(field)
    if hiddenEntry(field, includePrivate) then
        return nil
    end
    local item = {
        name = name,
        kind = "variable",
        signature = "local " .. name .. ": " .. syntax(field.type),
        doc = info,
        path = childModuleName .. "." .. name,
        line = firstToken(field) and firstToken(field).line or 1,
        members = {},
        params = {},
        returns = {},
        raises = info.raises,
        typeargs = {},
        annotations = annotationsOf(field),
        comptimeKind = comptimeKind(field.type),
    }
    local fn = typeFunction(field.type)
    if fn then
        item.kind = "function"
        local details = typeFunctionDetails(fn, info)
        item.params, item.returns = details.params, details.returns
        for _, generic in ipairs(fn.generics and fn.generics.names or {}) do
            item.typeargs[#item.typeargs + 1] = {name = generic.text, text = info.typeargs[generic.text] or "",}
        end
    end

    return item
end

-- A named type this file also declares, for a field spelled by reference rather than
-- inline, as `math: nupp.MathLibrary` beside `record nupp.MathLibrary ... end`.
-- Documenting
-- never resolves a type the way the checker does, so the only reference this can follow
-- is one this same file answers itself.
--
-- Tried first as a full path from a top-level declaration, which is how a field outside
-- the record it names has to spell it. Failing that, as a bare reference to a type
-- nested somewhere in this file, as `files: Files.Library` inside `record nupp.io`,
-- which answers to its own simple name the same as any other nested reference does
-- inside the body it sits in, so resolving it has to search every record's own nested
-- types too, not just the top-level ones a full path starts from.
local function recordNamed(blocks, targetName)
    local function find(stat, prefix)
        if stat.kind ~= "recordDecl" then
            return nil
        end
        local name = prefix and prefix .. "." .. stat.name.text or declaredName(stat)
        if name == targetName then
            return stat
        end
        if targetName:sub(1, #name + 1) == name .. "." then
            for _, entry in ipairs(stat.entries or {}) do
                local found = find(entry, name)
                if found then
                    return found
                end
            end
        end

        return nil
    end

    for _, block in ipairs(blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            local found = find(stat, nil)
            if found then
                return found
            end
        end
    end

    local segments = {}
    for segment in targetName:gmatch("[^.]+") do
        segments[#segments + 1] = segment
    end

    local function walk(stat, index)
        if index > #segments then
            return stat
        end
        for _, entry in ipairs(stat.entries or {}) do
            if entry.kind == "recordDecl" and entry.name and entry.name.text == segments[index] then
                local found = walk(entry, index + 1)
                if found then
                    return found
                end
            end
        end

        return nil
    end

    local function findRelative(entries)
        for _, entry in ipairs(entries or {}) do
            if entry.kind == "recordDecl" then
                if entry.name and entry.name.text == segments[1] then
                    local found = walk(entry, 2)
                    if found then
                        return found
                    end
                end
                local nested = findRelative(entry.entries)
                if nested then
                    return nested
                end
            end
        end

        return nil
    end

    for _, block in ipairs(blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "recordDecl" then
                if stat.name and stat.name.text == segments[1] then
                    local found = walk(stat, 2)
                    if found then
                        return found
                    end
                end
                local nested = findRelative(stat.entries)
                if nested then
                    return nested
                end
            end
        end
    end

    return nil
end

local function byKindThenName(left, right)
    if left.kind == right.kind then
        return left.name < right.name
    end
    return left.kind < right.kind
end

local declarationItem: function(any, string, boolean, boolean, boolean, {[string]: boolean}?): extract.Item?

-- What a shape-typed thing holds: an inline shape's own fields, or the fields of the
-- record a field spelled as a name refers to, when the same file declares one. A field
-- answering to neither is left out rather than guessed at.
local function shapeEntries(field, blocks)
    if field.type and field.type.kind == "tshape" then
        return field.type.fields
    elseif field.type and field.type.kind == "tname" then
        local record = recordNamed(blocks, syntax(field.type))
        return record and record.entries
    end

    return nil
end

-- One module read out of a shape's entries, appended to `modules`. `expanding` is the
-- set of shapes above it, so a shape that reaches itself stops rather than recurring
-- forever.
local function shapeModule(name, entries, text, path, blocks, includePrivate, expanding, modules)
    if not entries or expanding[entries] then
        return
    end
    if not includePrivate and internalModuleName(name) then
        return
    end
    expanding[entries] = true
    local items = {}
    for _, entry in ipairs(entries) do
        if entry.kind == "fieldDecl" or entry.kind == "tshapeField" then
            local info = entryDoc(entry)
            local nested = shapeEntries(entry, blocks)
            if info.tags.namespace and nested then
                shapeModule(
                    name .. "." .. entry.name.text,
                    nested,
                    info.text,
                    path,
                    blocks,
                    includePrivate,
                    expanding,
                    modules
                )
            else
                local item = fieldItem(entry, name, includePrivate)
                if item then
                    items[#items + 1] = item
                end
            end
        elseif entry.kind == "typeAlias" or entry.kind == "recordDecl" then
            local info = entryDoc(entry)
            if entry.kind == "recordDecl" and info.tags.namespace then
                -- A nested declaration is usually a type this module holds. Tagged
                -- `@namespace` it is a namespace instead -- its statics are what a
                -- caller reaches through it -- so it becomes a module of its own, the
                -- same as a `@namespace` field does, and the types nested inside it
                -- travel along as that module's items.
                shapeModule(
                    name .. "." .. entry.name.text,
                    entry.entries,
                    info.text,
                    path,
                    blocks,
                    includePrivate,
                    expanding,
                    modules
                )
            else
                local item = declarationItem(entry, name, true, true, includePrivate)
                if item then
                    -- This declaration is an item of the namespace module, not an
                    -- independently qualified module declaration to route again.
                    item.module = nil
                    item.path = name .. "." .. item.name
                    for _, member in ipairs(item.members) do
                        member.path = item.path .. "." .. member.name
                    end
                    items[#items + 1] = item
                end
            end
        end
    end
    table.sort(items, byKindThenName)
    modules[#modules + 1] = {name = name, path = path, text = text, items = items}
    expanding[entries] = nil
end

-- The modules `@namespace` implies: one per field of the tagged shape, named
-- `prefix.field`, holding that field's own fields as top-level items. A field inside
-- one of those modules may carry `@namespace` itself, which moves it from the parent's
-- values into a child module by the same rule.
local function namespaceChildren(shape, prefix, path, blocks, includePrivate)
    local modules = {}
    local expanding: {[any]: boolean} = {}
    for _, field in ipairs(shape.fields or {}) do
        if field.kind == "tshapeField" and not hiddenEntry(field, includePrivate) then
            shapeModule(
                prefix .. "." .. field.name.text,
                shapeEntries(field, blocks),
                entryDoc(field).text,
                path,
                blocks,
                includePrivate,
                expanding,
                modules
            )
        end
    end

    return modules
end

-- The module a shape-typed global itself is: its own name, holding the shape's fields
-- as items. A global's name is the whole name a caller writes -- `string.format`, never
-- `<file>.string.format` -- so nothing goes in front of it.
local function globalModules(name, shape, text, path, blocks, includePrivate)
    local modules = {}
    shapeModule(name, shape.fields, text, path, blocks, includePrivate, {}, modules)

    return modules
end

-- A field, method, metamethod, or nested type of a record, interface, or struct, read
-- recursively: a nested `record`/`interface`/`struct` becomes a member carrying its own
-- members rather than a row flattened to its raw AST kind, so its fields and methods
-- stay reachable instead of disappearing into the parent's Fields table.
local function buildMembers(
    entries: {any}?,
    basePath: string,
    includePrivate: boolean,
    fieldTextOverrides: {[string]: string}?
): {extract.Member}
    local members = {}
    for _, entry in ipairs(entries or {}) do
        local entryInfo = entryDoc(entry)
        local entryVisible = not hiddenEntry(entry, includePrivate)
        if (entry.kind == "fieldDecl" or entry.kind == "metamethodDecl") and entryVisible then
            local fieldInfo = entryInfo
            local member = new extract.Member(
                name = entry.name.text,
                type = syntax(entry.type),
                text = fieldInfo.text ~= "" and fieldInfo.text or (
                    fieldTextOverrides and fieldTextOverrides[entry.name.text]
                ) or "",
                path = basePath .. "." .. entry.name.text,
                params = {},
                returns = {},
                raises = fieldInfo.raises,
                annotations = annotationsOf(entry),
                comptimeKind = comptimeKind(entry.type)
            )
            local fieldFunction = typeFunction(entry.type)
            if fieldFunction then
                local details = typeFunctionDetails(fieldFunction, fieldInfo)
                member.params, member.returns = details.params, details.returns
                member.isFunction = true
            end
            if entry.kind == "metamethodDecl" then
                member.isMetamethod = true
            end
            members[#members + 1] = member
        elseif entry.kind == "inlineMethod" and entryVisible then
            local methodInfo = entryInfo
            local details = functionDetails(entry, methodInfo)
            members[
                #members + 1
            ] = new extract.Member(
                name = entry.name.text,
                type = functionSignature(entry, entry.name.text),
                text = methodInfo.text,
                path = basePath .. "." .. entry.name.text,
                params = details.params,
                returns = details.returns,
                raises = methodInfo.raises,
                isFunction = true,
                annotations = annotationsOf(entry)
            )
        elseif entry.kind == "constructorDecl" and entryVisible then
            -- A constructor has no name of its own, because a caller does not write
            -- one: `new T(...)` is the spelling. It documents under the keyword, so
            -- what it says about its parameters has somewhere to be read.
            local constructorInfo = entryInfo
            local details = functionDetails(entry, constructorInfo)
            members[
                #members + 1
            ] = new extract.Member(
                name = "constructor",
                type = functionSignature(entry, "constructor"),
                text = constructorInfo.text,
                path = basePath .. ".constructor",
                params = details.params,
                returns = details.returns,
                raises = constructorInfo.raises,
                isFunction = true,
                annotations = annotationsOf(entry)
            )
        elseif entry.kind == "recordDecl" and entryVisible then
            local nestedPath = basePath .. "." .. entry.name.text
            members[
                #members + 1
            ] = new extract.Member(
                name = entry.name.text,
                type = entry.declKind or "record",
                text = entryInfo.text,
                path = nestedPath,
                params = {},
                returns = {},
                raises = {},
                isType = true,
                members = buildMembers(entry.entries, nestedPath, includePrivate, entryInfo.fields),
                annotations = annotationsOf(entry)
            )
        elseif entry.name and entryVisible then
            members[
                #members + 1
            ] = new extract.Member(
                name = entry.name.text,
                type = entry.kind,
                text = entryInfo.text,
                path = basePath .. "." .. entry.name.text,
                params = {},
                returns = {},
                raises = {},
                annotations = annotationsOf(entry)
            )
        end
    end

    return members
end

----------------------------------------------------------------------------
-- One declaration as an item
----------------------------------------------------------------------------

-- What a file publishes by name in a legacy returned table or a declared module's
-- `export =` table. `function m.thing()` says where it lands in its own spelling and
-- needs no such list; a `cdef` does not, so the table boundary is all that separates a
-- published binding from plumbing a module happens to call C for.
local function returnedNames(root): {[string]: boolean}
    local names: {[string]: boolean} = {}
    local function record(value)
        if value and value.kind == "name" and value.token then
            names[value.token.text] = true
        end
    end

    for _, block in ipairs(root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "returnStmt" then
                for _, expr in ipairs(stat.exprs or {}) do
                    if expr.kind == "tableExpr" then
                        for _, field in ipairs(expr.fields or {}) do
                            record(field.value)
                        end
                    end
                end
            elseif stat.kind == "exportStmt" and stat.value and stat.value.kind == "tableExpr" then
                for _, field in ipairs(stat.value.fields or {}) do
                    record(field.value)
                end
            end
        end
    end

    return names
end

-- Statement annotations wrap the declaration they modify in `pragmaStmt` nodes. The
-- wrapper owns the leading trivia, so documentation comes from the outside while the
-- name, signature and visibility come from the declaration at the centre. Following
-- every wrapper also handles stacked annotations.
declarationItem = function(stat, moduleName, includeAll, declarationFile, includePrivate, published)
    local documented = stat
    local applied = {}
    while stat.kind == "pragmaStmt" and stat.stat do
        local text = annotationText(stat)
        if text then
            applied[#applied + 1] = text
        end
        stat = stat.stat
    end
    local explicitlyExported = stat.kind == "exportStmt" and stat.stat ~= nil
    if explicitlyExported then
        stat = stat.stat
    end
    local lines = docLines(documented)
    local info = parseDoc(lines)
    local public = includeAll or declarationFile or explicitlyExported or info.tags.export or info.tags.public
    local kind, name, signature, itemComptimeKind
    if stat.kind == "funcStmt" or stat.kind == "localFuncStmt" then
        name = stat.kind == "funcStmt" and syntax(stat.name) or stat.name.text
        public = public or stat.kind == "funcStmt"
        kind = stat.name and stat.name.method and "method" or "function"
        signature = functionSignature(stat, name)
        itemComptimeKind = stat.comptimeTok and "function" or nil
    elseif stat.kind == "cdefFunc" then
        -- A `cdef` binds a bare name in this file, the way a `local` does. It is
        -- public when a declaration file says the whole file is, when the author
        -- exports it, or when the module hands it back by name; a module that merely
        -- calls C for its own reasons publishes the functions it wrote, not `malloc`.
        name, kind = stat.name.text, "function"
        public = public or (published or {})[name] == true
        signature = cdefSignature(stat)
    elseif stat.kind == "typeAlias" then
        name, kind = stat.name.text, "type"
        public = public or stat.visibility == "module" or stat.visibility == "global"
        signature = (
            stat.visibility == "global" and "global " or stat.visibility == "local" and "local " or ""
        ) .. "type " .. declaredName(stat) .. genericText(stat) .. " = " .. syntax(stat.value)
    elseif stat.kind == "recordDecl" then
        name, kind = stat.name.text, stat.declKind
        public = public or stat.visibility == "module" or stat.visibility == "global"
        signature = structureSignature(stat, includePrivate)
    elseif stat.kind == "cdefStruct" then
        name, kind = stat.name.text, "struct"
        public = public or (published or {})[name] == true
        signature = "cdef struct " .. name
    elseif stat.kind == "localStmt" then
        if #(stat.names or {}) ~= 1 then
            return nil
        end
        name, kind = stat.names[1].text, "variable"
        signature = (stat.isConst and "const " or "local ") .. name
        if stat.types[1] then
            signature = signature .. ": " .. syntax(stat.types[1])
        end
        if typeFunction(stat.types[1]) then
            kind = "function"
        end
        itemComptimeKind = comptimeKind(stat.types[1])
    else
        return nil
    end
    if info.tags["local"] then
        public = includeAll
    end
    if info.tags.internal and not includePrivate then
        public = false
    end
    -- The leading underscore means private wherever it appears, not only on a
    -- method: a module function, type, or variable named `_thing` is as much an
    -- implementation detail as `Record._thing`, and the generated runtime helpers
    -- the compiler calls by name are exactly that.
    if privateName(name) and not includePrivate then
        public = false
    end
    if not public then
        return nil
    end
    local itemPath = moduleName .. "." .. name
    local itemModule = nil
    if stat.kind == "typeAlias" or stat.kind == "recordDecl" then
        local qualified = declaredName(stat)
        itemModule = qualified:match("^(.*)%.[^.]+$")
    end
    local moduleTail = moduleName:match("([^.]+)$") or moduleName
    if not itemModule and name:sub(1, #moduleTail + 1) == moduleTail .. "." then
        itemPath = moduleName .. name:sub(#moduleTail + 1)
    end
    local item = {
        name = name,
        kind = kind,
        signature = signature,
        aliasSource = stat.kind == "localStmt" and stat.exprs and stat.exprs[1] and syntax(stat.exprs[1]) or nil,
        doc = info,
        path = itemPath,
        module = itemModule,
        line = firstToken(stat) and firstToken(stat).line or 1,
        members = {},
        params = {},
        returns = {},
        raises = info.raises,
        typeargs = {},
        annotations = #applied > 0 and applied or nil,
        comptimeKind = itemComptimeKind,
    }
    local declaredFunction = stat.kind == "localStmt" and typeFunction(stat.types and stat.types[1]) or nil
    local generics = stat.generics or (
        stat.body and stat.body.generics
    ) or (declaredFunction and declaredFunction.generics)
    for _, generic in ipairs(generics and generics.names or {}) do
        item.typeargs[#item.typeargs + 1] = {name = generic.text, text = info.typeargs[generic.text] or "",}
    end
    if stat.kind == "funcStmt" or stat.kind == "localFuncStmt" or stat.kind == "cdefFunc" then
        local details = functionDetails(stat, info)
        item.params, item.returns = details.params, details.returns
    elseif declaredFunction then
        local details = typeFunctionDetails(declaredFunction, info)
        item.params, item.returns = details.params, details.returns
    elseif stat.kind == "recordDecl" or stat.kind == "cdefStruct" then
        item.members = buildMembers(stat.entries, item.path, includePrivate, info.fields)
    end

    return item
end

-- Every type this file declares, whether or not it is documented. Folding an
-- out-of-line method needs to tell a type held back from the listing apart from one
-- this file never mentions, and only the visibility-blind walk can say which.
local function declaredTypePath(stat, moduleName: string): string?
    while stat.kind == "pragmaStmt" and stat.stat do
        stat = stat.stat
    end
    if stat.kind == "exportStmt" and stat.stat then
        stat = stat.stat
    end
    local declaresType = stat.kind == "recordDecl" or stat.kind == "typeAlias" or stat.kind == "cdefStruct"
    if not declaresType or not stat.name then
        return nil
    end

    return moduleName .. "." .. stat.name.text
end

----------------------------------------------------------------------------
-- Folding methods onto their type
----------------------------------------------------------------------------

-- A method is written twice over: the record declares `send: function(Worker, any)` and
-- the implementation follows it as `function Worker:send(value)`, or with an explicit
-- receiver as `function Worker.send(self, value)`. Both spell one method, and a
-- module's function listing is the functions a reader calls through the module, not
-- the ones reached through a type it happens to declare. Folding the implementation
-- into that type puts it where the reader looks for it and lets it supply what the
-- declaration left out. A method whose type this file never declares has nowhere to
-- fold into and stays a listed function rather than disappearing; one whose type this
-- file declares but does not document goes wherever its type went, which is nowhere.
local function memberNamed(item: extract.Item, name: string): extract.Member?
    for _, member in ipairs(item.members) do
        if member.name == name then
            return member
        end
    end

    return nil
end

local function foldMethods(
    items: {extract.Item},
    declaredTypes: {[string]: boolean},
    hiddenMembers: {[string]: boolean}
): {extract.Item}
    local types: {[string]: extract.Item} = {}
    for _, item in ipairs(items) do
        if item.kind ~= "function" and item.kind ~= "method" and item.kind ~= "variable" then
            types[item.path] = item
        end
    end
    local kept: {extract.Item} = {}
    for _, item in ipairs(items) do
        local callable = item.kind == "method" or item.kind == "function"
        local ownerPath = callable and item.path:match("^(.*)[.:][^.:]+$") or nil
        local owner = ownerPath and types[ownerPath] or nil
        local memberName = item.name:match("([^.:]+)$") or item.name
        if ownerPath and hiddenMembers[ownerPath .. "." .. memberName] then
            -- An out-of-line implementation cannot republish a private field.
        elseif not owner and ownerPath and declaredTypes[ownerPath] then
            -- Its type is private, so it is too: the reader has no way to hold one.
        elseif owner then
            local name = item.name:match("([^.:]+)$") or item.name
            local declared = memberNamed(owner, name)
            if declared then
                if declared.text == "" then
                    declared.text = item.doc.text
                end
                if #declared.raises == 0 then
                    declared.raises = item.raises
                end
            else
                owner.members[
                    #owner.members + 1
                ] = new extract.Member(
                    name = name,
                    type = item.signature,
                    text = item.doc.text,
                    path = owner.path .. "." .. name,
                    params = item.params,
                    returns = item.returns,
                    raises = item.raises,
                    isFunction = true,
                    annotations = item.annotations,
                    comptimeKind = item.comptimeKind
                )
            end
        else
            kept[#kept + 1] = item
        end
    end

    return kept
end

----------------------------------------------------------------------------
-- Whole modules
----------------------------------------------------------------------------

local function moduleName(path: string, root: string, includes: {string}?): string
    path, root = normalize(path), normalize(root)
    local relative = path
    if root ~= "." and path:sub(1, #root + 1) == root .. "/" then
        relative = path:sub(#root + 2)
    end
    local best = relative
    for _, include in ipairs(includes or {}) do
        local prefix = normalize(join(root, include))
        if path:sub(1, #prefix + 1) == prefix .. "/" then
            local candidate = path:sub(#prefix + 2)
            if #candidate < #best then
                best = candidate
            end
        end
    end
    best = best:gsub("%.d%.nupp$", ""):gsub("%.g%.nupp$", ""):gsub("%.nupp$", "")
    best = best:gsub("/init$", ""):gsub("/", ".")

    return best
end

-- A long comment at the top of a file, or immediately after its `module` declaration,
-- is its module documentation. It belongs to the file rather than to the declaration
-- that follows and survives as markdown untouched. An ordinary `--` header stays a
-- plain implementation note, and an explicit `@module` docblock still wins over both.
local function headerDoc(root, tokens)
    local token = firstToken(root)
    local _, moduleNode = cst.declaredModule(root)
    if moduleNode then
        local following = nil
        local found = false
        for _, block in ipairs(root.blocks or {}) do
            for index, stat in ipairs(block.stats or {}) do
                if stat == moduleNode then
                    following = block.stats[index + 1]
                    found = true
                    break
                end
            end
            if found then
                break
            end
        end
        if following then
            token = firstToken(following)
        elseif found and tokens and #tokens > 0 then
            -- A module that declares nothing still documents itself. Its header is the
            -- last trivia in the file rather than the leading trivia of a statement
            -- below it, so there is nothing under the module line to read it from.
            token = tokens[#tokens]
        end
    end
    for index = 1, token and token.triviaCount or 0 do
        local text = lexer.triviaText(token, index)
        if lexer.triviaKind(token, index) ~= "comment" then
            -- keep looking: only whitespace may precede the header
        elseif text:match("^%-%-%[=*%[") then
            return trim((text:gsub("^%-%-%[=*%[", ""):gsub("%]=*%]$", "")))
        else
            return nil
        end
    end

    return nil
end

function extract.extract(
    source: string,
    path: string?,
    name: string,
    opts: extract.Options?
): extract.Module?, {nupp.compiler.lexer.LexError}, {extract.Module}?
    opts = opts or {} as extract.Options
    local parsed = parser.parse(source, path)
    if #parsed.errors > 0 then
        return nil, parsed.errors
    end
    local result = {
        name = name,
        path = path,
        text = "",
        items = {},
        documentationInternal = parsed.root.documentationInternal,
        imports = {},
        moduleLocal = cst.exportedLocal(parsed.root),
    }
    for _, block in ipairs(parsed.root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "localStmt" then
                for index, binding in ipairs(stat.names or {}) do
                    local value = stat.exprs and stat.exprs[index]
                    if value
                        and value.kind == "call"
                        and value.obj
                        and value.obj.kind == "name"
                        and value.obj.token
                        and value.obj.token.text == "require"
                    then
                        local args = value.args as cst.Args?
                        local argument = args and args.exprs and args.exprs[1]
                        if argument and argument.kind == "string" and argument.token then
                            local literal = argument.token.text
                            local imported = literal:match('^"(.*)"$') or literal:match("^'(.*)'$")
                            if imported then
                                result.imports[binding.text] = imported
                            end
                        end
                    end
                end
            end
        end
    end
    result.text = headerDoc(parsed.root, parsed.tokens) or ""
    local declarationFile = path ~= nil and path:match("%.d%.nupp$") ~= nil
    local extraModules = {}
    local declaredTypes: {[string]: boolean} = {}
    local hiddenMembers: {[string]: boolean} = {}
    local published = returnedNames(parsed.root)
    for _, block in ipairs(parsed.root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            local typePath = declaredTypePath(stat, name)
            if typePath then
                declaredTypes[typePath] = true
                local declaration: any = stat
                while declaration.kind == "pragmaStmt" or declaration.kind == "exportStmt" do
                    declaration = declaration.stat
                end
                for _, entry in ipairs(declaration.entries or {}) do
                    if entry.name and hiddenEntry(entry, opts.includePrivate) then
                        hiddenMembers[typePath .. "." .. entry.name.text] = true
                    end
                end
            end
            local info = parseDoc(docLines(stat))
            if info.tags.module then
                result.text = type(info.tags.module) == "string" and info.tags.module or info.text
            end
            -- `@namespace` replaces one declaration with the modules its own fields
            -- imply, for a shape with no file of its own to be documented from. The
            -- prelude's ambient globals, not an ordinary declaration. Public by the
            -- same
            -- rule as any other declaration, so a private `local` stays out unless
            -- `--all` asks for it too.
            local shape = stat.kind == "localStmt" and #(
                stat.names or {}
            ) == 1 and stat.types[1] and stat.types[1].kind == "tshape" and stat.types[1] or nil
            local shapeName = shape and stat.kind == "localStmt" and stat.names[1].text or nil
            local shapePublic = opts.includeAll or declarationFile or info.tags.export or info.tags.public
            if info.tags["local"] then
                shapePublic = opts.includeAll
            end
            if info.tags.internal and not opts.includePrivate then
                shapePublic = false
            end
            if shape and info.tags.namespace and shapePublic then
                if not opts.shapesAsModules then
                    local prefix = info.tags.namespace == true and name or info.tags.namespace
                    for _, module in ipairs(
                        namespaceChildren(shape, prefix, path, parsed.root.blocks, opts.includePrivate)
                    ) do
                        extraModules[#extraModules + 1] = module
                    end
                end
            elseif shape and opts.shapesAsModules and shapePublic then
                for _, module in ipairs(
                    globalModules(shapeName, shape, info.text, path, parsed.root.blocks, opts.includePrivate)
                ) do
                    extraModules[#extraModules + 1] = module
                end
            else
                local item = declarationItem(
                    stat,
                    name,
                    opts.includeAll,
                    declarationFile,
                    opts.includePrivate,
                    published
                )
                if item then
                    result.items[#result.items + 1] = item
                end
            end
        end
    end
    result.items = foldMethods(result.items, declaredTypes, hiddenMembers)
    table.sort(result.items, byKindThenName)

    return result, {}, extraModules
end

-- Function-typed members document like the functions they are, with their own arguments
-- and results, and a nested type documents like a declaration in its own right, with
-- its
-- own members, so both are listed apart from the data fields rather than flattened into
-- one table that has nowhere to put either.
local function splitMembers(members: {extract.Member}?): {extract.Member}, {extract.Member}, {extract.Member}
    local fields, methods, types = {}, {}, {}
    for _, member in ipairs(members or {}) do
        local into = member.isType and types or member.isFunction and methods or fields
        into[#into + 1] = member
    end

    return fields, methods, types
end

--- The modules one module's page is responsible for listing: every module nested under
--- its name whose nearest documented ancestor is that module.
---
--- The nearest ancestor decides, rather than the immediate one, so that no module goes
--- unlisted when a name between it and the root documents nothing. A site fills those
--- names in with [](nupp.compiler.doc.extract.namespaces) and the two rules agree, but
--- a
--- caller reaching this directly with the modules it happens to hold gets the same
--- guarantee without having to.
---
--- @param modules every module the run documented, which is what says who is documented
--- @param name the module whose children are wanted
--- @return the children, in the order they were given
function extract.children(modules: {extract.Module}, name: string): {extract.Module}
    local documented = {}
    for _, module in ipairs(modules) do
        documented[module.name] = true
    end
    local prefix, children = name .. ".", {}
    for _, module in ipairs(modules) do
        if module.name:sub(1, #prefix) == prefix then
            local nearest, walked = name, name
            for segment in module.name:sub(#prefix + 1):gmatch("[^.]+") do
                walked = walked .. "." .. segment
                if walked ~= module.name and documented[walked] then
                    nearest = walked
                end
            end
            if nearest == name then
                children[#children + 1] = module
            end
        end
    end

    return children
end

--- The namespaces a set of modules implies: every dotted prefix that holds modules but
--- is not one itself, as a module with no declarations.
---
--- A directory with no `init.nupp` is still a name a reader meets, in a require path,
--- in the sidebar, and in the name of every module under it, and without this it is the
--- one name that leads nowhere. `nupp.compiler.build` is that name in this project's
--- own documentation. Answering with a module rather than a special case is what lets
--- the page, the navigation, the search index, and the markdown treat it like any
--- other.
---
--- @param modules the documented modules, which is what says which names are taken
--- @return the implied namespaces, outermost first
function extract.namespaces(modules: {extract.Module}): {extract.Module}
    local taken = {}
    for _, module in ipairs(modules) do
        taken[module.name] = true
    end
    local namespaces = {}
    for _, module in ipairs(modules) do
        local walked = nil
        for segment in module.name:gmatch("[^.]+") do
            walked = walked and walked .. "." .. segment or segment
            if walked ~= module.name and not taken[walked] then
                taken[walked] = true
                namespaces[#namespaces + 1] = {name = walked, text = "", items = {}, namespace = true}
            end
        end
    end

    return namespaces
end

extract.internalModuleName = internalModuleName
extract.moduleName = moduleName
extract.splitMembers = splitMembers

export = extract
