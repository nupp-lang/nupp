--[[
Markdown as HTML.

The markdown itself is lunamark's, which is a PEG grammar rather than a pile of
patterns, and so gets the things patterns get wrong: nested emphasis, escapes,
a link whose URL contains a bracket, a `*` inside a code span.

What is not lunamark's is the fenced blocks and `:::` containers. A fence here
carries more than a language — an optional `[caption]`, `:line-numbers` with an
optional start — and a `::: code-group` gathers several fences into one tabbed
widget. Note, info, tip, warning, and danger containers become admonitions whose
bodies are still rendered by lunamark. A `nupp` fence embeds the editor, so the
block checks once the reader engages with it; `playground` remains the explicit
spelling for an empty editor or example picker. `:static` keeps a Nupp excerpt
as highlighted text when editing would not make sense. Rather than teach a
markdown grammar about any of that, every custom region is lifted out before
lunamark sees the document and an HTML comment is left in its place; markdown
does not touch a comment, so the rendered block goes back exactly where it came
from afterwards.
Reading the fences here also avoids the trap of reading them back out of the
output, where the whole info string has been folded into one class attribute
and `lua [caption]` no longer matches `lua`.

Headings are the other thing kept: the id is Nupp's own slug, and each carries
the anchor link the site's stylesheet expects.
]]

local stringsMod = require("nupp.compiler.doc.strings")
local highlightMod = require("nupp.compiler.doc.highlight")
local urlsMod = require("nupp.compiler.doc.urls")

local trim, htmlEscape = stringsMod.trim, stringsMod.htmlEscape
local headingId = stringsMod.headingId
local rewriteSymbolLinks = urlsMod.rewriteSymbolLinks
local codeHtml = highlightMod.codeHtml

-- Where scripts/docs-serve.mjs mounts editors/playground/dist, and where the home
-- page's own "Playground" hero action already points. Absolute, so a ```playground
-- fence renders the same wherever in the route tree the page holding it sits.
const PLAYGROUND_EMBED = "/playground/embed.html"

local html = {}

--- One heading of a rendered document: the slug it is reachable at, the text as it
--- reads once its markup is stripped, and how deep it sits.
type html.Heading = {
    path: string,
    name: string,
    level: integer
}

local function tableHtml(headers: {string}, rows: {{string}}): string
    local out = {"<table><thead><tr>"}
    for _, header in ipairs(headers) do
        out[#out + 1] = "<th>" .. header .. "</th>"
    end
    out[#out + 1] = "</tr></thead><tbody>"
    for _, row in ipairs(rows) do
        out[#out + 1] = "<tr>"
        for _, cell in ipairs(row) do
            out[#out + 1] = "<td>" .. cell .. "</td>"
        end
        out[#out + 1] = "</tr>"
    end
    out[#out + 1] = "</tbody></table>"

    return table.concat(out)
end

local function markdownOutline(text: string?): {html.Heading}
    local out, fenced = {}, false
    for line in (tostring(text or "") .. "\n"):gmatch("(.-)\n") do
        if line:match("^```") then
            fenced = not fenced
        elseif not fenced then
            local hashes, heading = line:match("^(#+)%s+(.+)$")
            if hashes and #hashes <= 3 then
                out[#out + 1] = {path = headingId(heading), name = heading:gsub("[`*_]", ""), level = #hashes}
            end
        end
    end

    return out
end

local codeGroupIndex = 0
local markdownHtml: (function(text: string?, links: nupp.compiler.doc.urls.Links?, headingShift: integer?): string)

local ADMONITION_TITLES = {note = "Note", info = "Info", tip = "Tip", warning = "Warning", danger = "Danger",}

-- `:line-numbers` on the fence, optionally `:line-numbers=12` when the excerpt starts
-- somewhere other than the top of a file.
local function lineNumberStart(options)
    if not options or not options:find(":line-numbers", 1, true) then
        return nil
    end
    return tonumber(options:match(":line%-numbers=(%d+)")) or 1
end

-- A gutter beside the code rather than numbers woven into it: a highlighted token can
-- span lines, and splitting the markup to number each one would cut it in half.
local function lineNumbersHtml(source, start)
    local out, number = {'<span class="nuppdoc-line-numbers" aria-hidden="true">'}, start
    for _ in (source .. "\n"):gmatch("(.-)\n") do
        out[#out + 1] = "<span>" .. tostring(number) .. "</span>"
        number = number + 1
    end
    out[#out + 1] = "</span>"

    return table.concat(out)
end

local function codeBlockHtml(source, language, links, firstLine)
    language = language ~= "" and language or "text"
    return '<div class="nuppdoc-code-block' .. (
        firstLine and " has-line-numbers" or ""
    ) .. '" data-lang="' .. htmlEscape(
        language
    ) .. '"><pre>' .. (
        firstLine and lineNumbersHtml(source, firstLine) or ""
    ) .. '<code class="language-' .. htmlEscape(
        language
    ) .. '">' .. codeHtml(source, language, links) .. "</code></pre></div>"
end

-- A ```playground fence: the editor from editors/playground, in an iframe, checking
-- with the real compiler as the reader types. An empty fence opens on the editor's own
-- example menu; a fence with a body opens on that program instead, which is what makes
-- a snippet on a page runnable rather than only readable.
--
-- The body travels in the URL fragment rather than a query, so it stays a client-side
-- detail: no server sees a reader's edits, and the embed page reads it the same way
-- whether the site is served by scripts/docs-serve.mjs or anything else. Percent
-- encoding, not base64, because the decoder on the other side is decodeURIComponent and
-- needs no code at all.
local function urlFragmentEscape(text: string): string
    return (text:gsub("[^%w%-%._~]", function(c: string): string
        return ("%%%02X"):format(c:byte())
    end))
end

local function playgroundHeight(source: string): number
    local lines = 1
    for _ in source:gmatch("\n") do
        lines = lines + 1
    end
    -- The embedded editor has a 2rem control row; output stays hidden until Run.
    -- The remaining .85rem covers the border and the deliberately asymmetric
    -- editor padding: breathing room above the first line, only a small gap
    -- below the last. Each source line is 18.2px at the embed's 13px font.
    -- The cap keeps a long program scrolling instead of swallowing the page.
    return math.min(30, 2.85 + lines * 1.15)
end

local function playgroundHtml(source: string, caption: string?, compact: boolean?): string
    local trimmed = trim(source)
    local title = caption or "Nupp playground: an editor that checks as you type"
    return '<iframe class="nuppdoc-playground" title="' .. htmlEscape(
        title
    ) .. '" loading="lazy"' .. (
        compact and (' style="height:' .. tostring(playgroundHeight(trimmed)) .. 'rem"') or ""
    ) .. ' src="' .. PLAYGROUND_EMBED .. (
        trimmed ~= "" and "#source=" .. urlFragmentEscape(trimmed) or ""
    ) .. '"></iframe>'
end

local function renderedCodeBlockHtml(block, links)
    if block.language == "playground" then
        return playgroundHtml(block.source, block.caption)
    end
    if block.language == "nupp" and not block.static and not block.firstLine then
        return playgroundHtml(block.source, block.caption, true)
    end
    return codeBlockHtml(block.source, block.language, links, block.firstLine)
end

local function codeGroupHtml(blocks, links)
    local labeled = {}
    for _, block in ipairs(blocks) do
        if block.caption then
            labeled[#labeled + 1] = block
        end
    end
    if #labeled == 0 then
        local out = {'<div class="nuppdoc-code-group" role="group">'}
        for _, block in ipairs(blocks) do
            out[#out + 1] = renderedCodeBlockHtml(block, links)
        end
        out[#out + 1] = "</div>"
        return table.concat(out)
    end
    codeGroupIndex = codeGroupIndex + 1
    local name = "nuppdoc-code-group-" .. tostring(codeGroupIndex)
    local out = {'<div class="nuppdoc-code-group" role="radiogroup"' .. ' aria-label="Code examples">'}
    for index, block in ipairs(labeled) do
        local id = name .. "-" .. tostring(index)
        out[
            #out + 1
        ] = '<input class="nuppdoc-code-tab-input" type="radio"' .. ' name="' .. name .. '" id="' .. id .. '"' .. (
            index == 1 and " checked" or ""
        ) .. '><label class="nuppdoc-code-tab" for="' .. id .. '">' .. htmlEscape(
            block.caption
        ) .. '</label><figure class="nuppdoc-code-panel">' .. renderedCodeBlockHtml(
            block,
            links
        ) .. '</figure>'
    end
    out[#out + 1] = "</div>"

    return table.concat(out)
end

local function admonitionHtml(kind, title, source, links)
    title = title ~= "" and title or ADMONITION_TITLES[kind]
    return '<aside class="nuppdoc-admonition nuppdoc-admonition-' .. htmlEscape(
        kind
    ) .. '" aria-label="' .. htmlEscape(
        title
    ) .. '">' .. '<p class="nuppdoc-admonition-title">' .. htmlEscape(
        title
    ) .. "</p>" .. '<div class="nuppdoc-admonition-body">' .. markdownHtml(source, links) .. "</div></aside>"
end

-- Reads one fence, starting at its opening line, and returns the block it describes
-- plus the index of the line after its closer.
--
-- The closer has to be at least as long as the opener, which is how a page shows a
-- fenced block: four backticks around three. Closing on any run of three instead ends
-- the outer block at the inner one's first line and leaves its closer opening a block
-- that swallows the rest of the page.
local function readFence(lines, index)
    local fence, language, options = lines[index]:match("^(```+)%s*([%w_+-]*)%s*(.-)%s*$")
    if not fence then
        return nil, index
    end
    local function closes(line)
        local closer = line:match("^(```+)%s*$")
        return closer ~= nil and #closer >= #fence
    end
    local code = {}
    index = index + 1
    while index <= #lines and not closes(lines[index]) do
        code[#code + 1] = lines[index]
        index = index + 1
    end

    return {
        language = language ~= "" and language or "text",
        caption = options:match("%[([^%]]+)%]"),
        firstLine = lineNumberStart(options),
        static = options:find(":static", 1, true) ~= nil,
        source = table.concat(code, "\n"),
    }, index + 1
end

-- Reads a `:::` region while respecting nested containers and fenced code. The inner
-- source is handed back to markdownHtml, so an admonition does not create a second,
-- less capable Markdown dialect.
local function readContainer(lines, index)
    local body, depth, fenced = {}, 1, false
    index = index + 1
    while index <= #lines do
        local line = lines[index]
        if line:match("^```") then
            fenced = not fenced
        elseif not fenced then
            local marker = trim(line)
            if marker == ":::" then
                depth = depth - 1
                if depth == 0 then
                    return table.concat(body, "\n"), index + 1
                end
            elseif marker:match("^:::%s+[%w-]+") then
                depth = depth + 1
            end
        end
        body[#body + 1] = line
        index = index + 1
    end

    return nil, index
end

-- Lifts every fenced region out of the document, rendering each and leaving a comment
-- in its place. Markdown has nothing to say about a comment, so it arrives in the
-- output untouched and is swapped back for the block.
local function extractBlocks(text, links, rendered)
    local lines, out, index = {}, {}, 1
    for line in (text .. "\n"):gmatch("(.-)\n") do
        lines[#lines + 1] = line
    end
    local function placeholder(markup)
        rendered[#rendered + 1] = markup
        out[#out + 1] = ""
        out[#out + 1] = ("<!--nuppdoc-block-%d-->"):format(#rendered)
        out[#out + 1] = ""
    end

    while index <= #lines do
        local line = lines[index]
        local marker = trim(line)
        local directive, title = marker:match("^:::%s+([%w-]+)%s*(.-)%s*$")
        if marker == "::: code-group" then
            local blocks = {}
            index = index + 1
            while index <= #lines and trim(lines[index]) ~= ":::" do
                local block, after = readFence(lines, index)
                if block then
                    blocks[#blocks + 1] = block
                    index = after
                else
                    index = index + 1
                end
            end
            placeholder(codeGroupHtml(blocks, links))
        elseif directive and ADMONITION_TITLES[directive] then
            local body, after = readContainer(lines, index)
            if body then
                index = after - 1
                placeholder(admonitionHtml(directive, title, body, links))
            else
                out[#out + 1] = line
            end
        elseif lines[index]:match("^```") then
            local block, after = readFence(lines, index)
            index = after - 1
            local interactive = block.language == "playground" or (
                block.language == "nupp" and not block.static and not block.firstLine
            )
            if interactive then
                placeholder(renderedCodeBlockHtml(block, links))
            else
                local markup = renderedCodeBlockHtml(block, links)
                if block.caption then
                    markup = '<figure class="nuppdoc-labeled-code"><figcaption>' .. htmlEscape(
                        block.caption
                    ) .. '</figcaption>' .. markup .. '</figure>'
                end
                placeholder(markup)
            end
        else
            out[#out + 1] = line
        end
        index = index + 1
    end

    return table.concat(out, "\n")
end

-- The slug of each heading, in the order they appear. lunamark hands the writer a
-- heading's rendered content, which is HTML by then; the id has to come from the source
-- text, so it is computed here and matched up by position.
local function headingSlugs(text)
    local slugs = {}
    for line in (text .. "\n"):gmatch("(.-)\n") do
        local hashes, heading = line:match("^(#+)%s+(.+)$")
        if hashes then
            slugs[#slugs + 1] = {id = headingId(heading), text = heading}
        end
    end

    return slugs
end

-- One parser, built once: lunamark compiles a PEG grammar, which is not something to do
-- per doc comment. The heading state it reads is reset by every call into markdownHtml,
-- which is the only caller.
local parse, headings, headingIndex, headingShiftBy = nil, {}, 0, 1

local function buildParser()
    local ok, lunamark = pcall(require, "lunamark")
    if not ok then
        return nil, lunamark
    end
    local writer = lunamark.writer.html.new()
    writer.header = function(content, level)
        headingIndex = headingIndex + 1
        local heading = headings[headingIndex]
        local id = heading and heading.id or "section"
        local label = heading and heading.text or ""
        level = math.min(level + headingShiftBy, 6)

        return {
            "<h",
            level,
            ' id="',
            htmlEscape(id),
            '">',
            content,
            '<a class="nuppdoc-header-anchor" href="#',
            htmlEscape(id),
            '" aria-label="Link to ',
            htmlEscape(label),
            '">#</a></h',
            level,
            ">"
        }
    end

    return lunamark.reader.markdown.new(
        writer,
        {fenced_code_blocks = true, header_attributes = true, pipe_tables = true,}
    )
end

markdownHtml = function(text: string?, links: nupp.compiler.doc.urls.Links?, headingShift: integer?): string
    -- A Windows checkout hands the page to us with CRLF endings. The grammar is
    -- line-oriented, and the fenced-block pass rebuilds its input with LF, so
    -- normalize before either one sees a stray carriage return.
    text = tostring(text or ""):gsub("\r\n?", "\n")
    if text == "" then
        return ""
    end
    if not parse then
        local built, err = buildParser()
        if not built then
            error(
                "nupp doc needs lunamark; declare it as a luarocks "
                .. "dependency of the docs target and it is installed with "
                .. "the build ("
                .. tostring(
                    err
                ) .. ")",
                0
            )
        end
        parse = built
    end
    local rendered = {}
    -- The trailing blank line is not decoration: without one lunamark reads the last
    -- block as a bare run of inline text rather than a paragraph, and a doc comment
    -- almost never ends with one. Every block then wraps the same way, which is what a
    -- table cell full of them depends on.
    local prepared = extractBlocks(text .. "\n", links, rendered)
    -- After the fences are lifted out, so that a link written inside a code block is
    -- code rather than a reference, and before lunamark, so that what it reads is an
    -- ordinary markdown link by then.
    if links then
        prepared = rewriteSymbolLinks(prepared, function(name: string): string?
            return links[name]
        end)
    end
    headings, headingIndex = headingSlugs(prepared), 0
    headingShiftBy = headingShift == nil and 1 or headingShift
    -- Annotated because the parser is reached through an untyped rock: without this the
    -- rendered document arrives as `any` and the replacement pass below narrows it to
    -- whatever `gsub` handed back second.
    local out: string = parse(prepared .. "\n")
    out = out:gsub("<!%-%-nuppdoc%-block%-(%d+)%-%->", function(index)
        -- A block's markup is returned by a function so that a `%` in it is never read
        -- as a capture reference.
        return rendered[tonumber(index)] or ""
    end)

    return trim(out)
end

-- The same renderer where a paragraph would be in the way: a summary in a table cell is
-- a sentence, not a block. Only a document that is exactly one paragraph is unwrapped,
-- so anything longer keeps its structure.
local function inlineHtml(text: string?, links: nupp.compiler.doc.urls.Links?): string
    local out = markdownHtml(text, links)
    local inner = out:match("^<p>(.*)</p>$")
    if inner and not inner:find("<p>", 1, true) then
        return inner
    end

    return out
end

--- Percent-encodes text for a URL fragment. What a link carrying a program to the
--- playground needs, so a page that shows one can offer to open it there.
html.urlFragmentEscape = urlFragmentEscape

html.tableHtml = tableHtml
html.markdownHtml = markdownHtml
html.inlineHtml = inlineHtml
html.markdownOutline = markdownOutline

return html
