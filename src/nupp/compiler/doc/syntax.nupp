-- The line grammars shared by documentation extraction, rendering, and formatting.

local lpeg = require("lpeg")
local P, R, S, C, Cc, Ct = lpeg.P, lpeg.R, lpeg.S, lpeg.C, lpeg.Cc, lpeg.Ct
local hspace, byte = S(" \t"), P(1)
local marker = P("`") ^ 3 * P("`") ^ 0 + P("~") ^ 3 * P("~") ^ 0
local word = (R("az", "AZ", "09") + S("_-")) ^ 1
local optionByte = R("az", "AZ", "09") + S("_-")
local caption = P("[") * C((byte - P("]")) ^ 1) * P("]")
local lineNumber = P(":line-numbers") * (P("=") * C(R("09") ^ 1) + Cc("1")) * -optionByte
local playground = P(":playground") * -optionByte

local syntax: {
    [string]: any
} = {
    fence = C(hspace ^ 0) * C(marker) * C(byte ^ 0) * -byte,
    markdownFence = C(P(" ") ^ -3) * C(marker) * C(byte ^ 0) * -byte,
    tag = P("@") * C(word) * hspace ^ 0 * C(byte ^ 0) * -byte,
    heading = C(P("#") ^ 1) * hspace ^ 1 * C(byte ^ 1) * -byte,
    directive = hspace ^ 0 * P(":::") * hspace ^ 1 * C(word) * hspace ^ 0 * C(byte ^ 0) * -byte,
    comment = P("--") * P("-") ^ 0 * P(" ") ^ -1 * C(byte ^ 0) * -byte,
    docComment = P("---") * P(" ") ^ -1 * C(byte ^ 0) * -byte,
    nameValue = C((byte - hspace) ^ 1) * hspace ^ 0 * C(byte ^ 0) * -byte,
    blank = hspace ^ 0 * -byte,
    indented = hspace,
    codeIndented = P("    ") * (byte - S(" \t\r\n")),
    fenceInfo = hspace ^ 0 * C((R("az", "AZ", "09") + S("_+-")) ^ 0) * hspace ^ 0 * C(byte ^ 0) * -byte,
    caption = (-#caption * byte) ^ 0 * caption,
    lineNumber = (-#lineNumber * byte) ^ 0 * lineNumber,
    playground = (-#playground * byte) ^ 0 * playground,
    lines = Ct((C((byte - P("\n")) ^ 0) * P("\n")) ^ 0 * C((byte - P("\n")) ^ 0) * -byte),
}

function syntax.closes(opened: string, marker: string?, rest: string?): boolean
    return marker ~= nil and marker:sub(1, 1) == opened:sub(1, 1)
        and #marker >= #opened and syntax.blank:match(rest or "") ~= nil
end

function syntax.fenceState(line: string, opened: string?, markdown: boolean?): (string?, string?, string?)
    local _, marker, rest = (markdown and syntax.markdownFence or syntax.fence):match(line)
    if marker and not opened then
        opened = marker
    elseif marker and syntax.closes(opened as string, marker, rest) then
        opened = nil
    end
    return opened, marker, rest
end

return syntax
