module nupp.compiler.optimize

--[[
Rewrites the checked tree before it is generated.

`check` annotates and `gen` erases; neither may change what a program does. This
is the phase that may. A pass hangs directives on nodes for `gen` to read, and
returns remarks describing both what it did and what it declined to do, because
a language whose premise is that types make code faster owes the user an answer
when a declared intention did not reach the generated code.

Every pass carries a stable code, `OPT-n`, assigned when it lands and never
reused. Names change when a pass is split, merged, or renamed; the code in a
bug report or a `-Zno-opt` does not.

The constraint is line attribution, not line count: a rewrite may make a line as
long as it needs to be, but may not move code to a line it was not on. The
passes here rewrite where they stand, so attribution is unchanged.

See `docs/guides/performance.md`.
]]

local cst = require("nupp.compiler.cst")
local constspecialize = require("nupp.compiler.constspecialize")
local indexedViews = require("nupp.compiler.indexedviews")

local optimize = {}

local isToken = cst.isToken
local firstToken = cst.firstToken

----------------------------------------------------------------------------
-- The pass registry
----------------------------------------------------------------------------

--- The passes, by stable code: the name a person uses, the lowest `-O` level that runs
--- the pass, and one line saying what it is for.
optimize.passes = {
    ["OPT-1"] = {name = "presize", level = 1, summary = "size a table built field by field when it is created",},
    [
        "OPT-2"
    ] = {name = "numeric-ipairs", level = 1, summary = "iterate a stable declared array with a numeric for loop",},
    [
        "OPT-3"
    ] = {
        name = "constant-fold",
        level = 1,
        summary = "fold exact primitive expressions, drop dead branches and loops, and propagate const bindings",
    },
    [
        "OPT-4"
    ] = {name = "static-callable", level = 1, summary = "bind repeated immutable dotted callees at their first use",},
    [
        "OPT-5"
    ] = {name = "concat-buffer", level = 1, summary = "build a string accumulated round a loop with a string.buffer",},
    [
        "OPT-6"
    ] = {
        name = "indexed-range",
        level = 1,
        summary = "lower proved trusted indexed-view accesses through their physical adapters",
    },
    [
        "OPT-7"
    ] = {
        name = "inline-return-helper",
        level = 1,
        summary = "inline a module's own single-return local helpers where they are called",
    },
    [
        "OPT-8"
    ] = {
        name = "const-monomorphize",
        level = 1,
        summary = "emit bounded private bodies for closed scalar const applications",
    },
}

----------------------------------------------------------------------------
-- OPT-1 presize
----------------------------------------------------------------------------

-- Presizing pays from two fields up. An empty table grows its hash part by rehashing,
-- so a single field costs one rehash, and replacing the constructor with a call to buy
-- that back is not a trade worth making.
local PRESIZE_MIN = 2

-- The identifier a bare-name expression names.
local function nameText(node)
    if not node or isToken(node) then
        return nil
    end
    if node.kind ~= "name" then
        return nil
    end

    return node.token and node.token.text or nil
end

-- How many times `name` is mentioned anywhere in the subtree. Counting rather than
-- testing is what lets a statement be judged: a write to a field mentions the local
-- exactly once, so a statement whose only mentions are the ones being counted as writes
-- has not let the table go anywhere else.
local function occurrences(node, name)
    if not node then
        return 0
    end
    if isToken(node) then
        return (node.kind == "name" and node.text == name) and 1 or 0
    end
    local total = 0
    for _, child in ipairs(node) do
        total = total + occurrences(child, name)
    end

    return total
end

-- The local whose field an assignment target writes. `t.x` and `t[k]` answer "t"; a
-- bare `t`, a deeper path like `t.a.b`, and anything else answer nil, because only a
-- one-level write leaves the table binding itself alone.
local function fieldTargetBase(target)
    if not target or isToken(target) then
        return nil
    end
    if target.kind ~= "dotIndex" and target.kind ~= "bracketIndex" then
        return nil
    end

    return nameText(target.obj)
end

-- The key a write adds, as a kind and a value: a name or a string literal is a hash key
-- that can be told apart from other hash keys, a positive integer literal claims an
-- array slot, and anything else is one hash slot of unknown identity.
local function writtenKey(target)
    if target.kind == "dotIndex" then
        return "hash", target.name and target.name.text or nil
    end
    local key = target.expr
    if key and not isToken(key) then
        if key.kind == "string" then
            local token = firstToken(key)
            return "hash", token and token.text or nil
        end
        if key.kind == "number" then
            local token = firstToken(key)
            local value = token and tonumber(token.text) or nil
            if value and value >= 1 and value == math.floor(value) then
                return "array", value
            end
        end
    end

    return "opaque", nil
end

-- The writes to `name` a statement makes as one-level field assignments.
local function fieldWrites(stat, name)
    if stat.kind ~= "assignStmt" then
        return {}
    end
    local writes = {}
    for _, target in ipairs(stat.targets or {}) do
        if fieldTargetBase(target) == name then
            writes[#writes + 1] = target
        end
    end

    return writes
end

-- A simple named field write that a table constructor can perform directly. The
-- assignment has to stand alone: list adjustment, computed keys and immutable-field
-- syntax each have semantics that need more than moving one value expression.
local function constructorField(stat, name, keys)
    if stat.kind ~= "assignStmt"
        or stat.isConst
        or stat.automaticOwner
        or stat.automaticOwnerMove
        or stat.automaticOwnerMoves
        or stat.automaticOwnerReinit
        or #(
        stat.targets or {}
    ) ~= 1 or #(stat.exprs or {}) ~= 1 then
        return nil
    end
    local target = stat.targets[1]
    if not target or isToken(target) or target.kind ~= "dotIndex" or fieldTargetBase(target) ~= name then
        return nil
    end
    local key = target.name and target.name.text or nil
    if not key or keys[key] then
        return nil
    end
    keys[key] = true

    return {name = target.name, value = stat.exprs[1], stat = stat}
end

-- Reads the run of statements that follow a `local t = {}` and decides how big the
-- table wants to be. A consecutive prefix of distinct named writes is also returned
-- when the constructor can perform every write itself.
--
-- The scan walks forward until the local is mentioned by something other than a write
-- to one of its fields, which is where the count stops being a count and starts being a
-- guess. A statement that does not mention the local at all is stepped over: until the
-- table escapes, nothing else can reach it.
--
-- Over-counting is safe, since a table sized for more than it receives wastes a little
-- memory and nothing else, so a conditional write is counted, an opaque key is counted
-- as one slot, and a run that is cut short simply keeps what it had. Under-counting is
-- safe too. Capacity is not observable, which is what makes this pass free of any
-- promise about behaviour.
local function planPresize(stats, at, name)
    local hashKeys, opaque, array = {}, 0, 0
    local hashCount, writeCount = 0, 0
    local stoppedAt = nil
    local constructorFields, constructorKeys = {}, {}
    local constructorGap, constructorRejected = false, false
    for j = at + 1, #stats do
        local stat = stats[j]
        local writes = fieldWrites(stat, name)
        if occurrences(stat, name) ~= #writes then
            stoppedAt = stat
            break
        end
        if #writes == 0 then
            constructorGap = true
        elseif constructorGap then
            constructorRejected = true
        end
        if #writes > 0 and not constructorRejected then
            local field = constructorField(stat, name, constructorKeys)
            if field then
                constructorFields[#constructorFields + 1] = field
            else
                constructorRejected = true
            end
        end
        writeCount = writeCount + #writes
        for _, target in ipairs(writes) do
            local kind, value = writtenKey(target)
            if kind == "array" then
                if value > array then
                    array = value
                end
            elseif kind == "hash" and value then
                if not hashKeys[value] then
                    hashKeys[value] = true
                    hashCount = hashCount + 1
                end
            else
                opaque = opaque + 1
            end
        end
    end

    if constructorRejected or #constructorFields ~= writeCount then
        constructorFields = nil
    end

    return array, hashCount + opaque, stoppedAt, constructorFields
end

-- Whether an expression is `{}` written with no entries at all. A constructor with
-- entries is already sized by LuaJIT from the constructor itself, so only the empty one
-- is left needing help.
local function isEmptyTable(node)
    return node and not isToken(node) and node.kind == "tableExpr" and #(node.fields or {}) == 0
end

local function remark(remarks, node, code, message, related)
    local token = firstToken(node)
    remarks[
        #remarks + 1
    ] = {
        code = code,
        severity = "note",
        msg = message,
        line = token and token.line or 0,
        col = token and token.col or 0,
        offset = token and token.offset or 0,
        length = token and #token.text or 1,
        related = related,
    }
end

local function presizeBlock(stats, remarks)
    for i, stat in ipairs(stats) do
        if not isToken(
            stat
        )
            and stat.kind == "localStmt"
            and stat.names
            and #stat.names == 1
            and stat.exprs
            and #stat.exprs == 1
            and isEmptyTable(
            stat.exprs[1]
        ) then
            local name = stat.names[1].text
            local constructor = stat.exprs[1]
            local array, hash, stoppedAt, constructorFields = planPresize(stats, i, name)
            if array + hash >= PRESIZE_MIN then
                constructor.presize = {narr = array, nhash = hash}
                if constructorFields then
                    constructor.presizeFields = constructorFields
                    for _, field in ipairs(constructorFields) do
                        field.stat.presizedIntoConstructor = true
                    end
                end
                local message
                if constructorFields then
                    message = ("presize: %s is created with %d named fields"):format(name, #constructorFields)
                else
                    message = (
                        "presize: %s is created with room for %d array and %d hash entries"
                    ):format(name, array, hash)
                end
                remark(remarks, constructor, "OPT-1", message)
            elseif stoppedAt then
                local token = firstToken(stoppedAt)
                remark(
                    remarks,
                    constructor,
                    "OPT-1",
                    (
                        "presize: %s is not presized, because it is used for "
                        .. "something other than a field assignment before its "
                        .. "fields are known"
                    ):format(name),
                    token and {
                        {
                            line = token.line,
                            col = token.col,
                            offset = token.offset,
                            length = #token.text,
                            message = "used here",
                        }
                    } or nil
                )
            end
        end
    end
end

local function walk(node, remarks)
    if not node or isToken(node) then
        return
    end
    if node.stats then
        presizeBlock(node.stats, remarks)
    end
    for _, child in ipairs(node) do
        walk(child, remarks)
    end
end

----------------------------------------------------------------------------
-- OPT-2 numeric-ipairs
----------------------------------------------------------------------------

-- Nodes that own their own body, which this pass does not follow into: a loop written
-- inside a function written inside this body is that function's body's question.
local NESTED_FUNCTION = {localFuncStmt = true, funcStmt = true, inlineMethod = true, funcExpr = true, shortfn = true,}

-- A dense table literal is the only bound this pass accepts, and how long it is is
-- policy rather than a fact about effects: another pass could take its bound from a
-- declared C array without changing what `nupp.compiler.analysis` knows. So it is
-- collected
-- here, beside the decision it serves.
local function denseLiteralLengths(body)
    local lengths = {}
    local function collect(node)
        if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
            return
        end
        if node.kind == "localStmt" then
            for j, name in ipairs(node.names or {}) do
                local value = node.exprs and node.exprs[j]
                if value and value.kind == "tableExpr" then
                    local length, dense = 0, true
                    for _, field in ipairs(value.fields or {}) do
                        if field.kind == "fieldItem" then
                            length = length + 1
                        else
                            dense = false
                        end
                    end
                    if dense and name.definition then
                        lengths[name.definition] = length
                    end
                end
            end
        end
        for _, child in ipairs(node) do
            collect(child)
        end
    end

    collect(body)

    return lengths
end

--- Proves the loops in one body, and rewrites the ones that hold.
---
--- The proof used to live in `nupp.compiler.analysis`, which meant the analysis knew
--- what
--- this
--- pass wanted. It asks now instead: the shape question goes to the query surface, and
--- what stays here is the part that is this pass's opinion -- that a dense literal is
--- an acceptable bound, and that a second mention of the array is reason enough to
--- stop.
local function numericIpairsBody(body, facts, remarks)
    local asked = facts.body(body)
    local lengths = denseLiteralLengths(body)
    local function walk(node)
        if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
            return
        end
        if node.kind == "forinStmt" and node.builtinIpairs then
            local operand = node.builtinIpairs.operand
            local token = operand.token
            local length = token and lengths[token.definition] or nil
            local ok, reason, related = true, nil, nil
            if length == nil then
                ok, reason, related = false, "the array's dense entry length is not statically known", operand
            elseif asked.uses(token.definition) > 2 then
                ok, reason, related = false, "the literal array has another use that may alias or expose it", operand
            else
                -- The literal establishes density. Asking about the whole containing
                -- body, not just the loop, rules out a hole or an append before entry
                -- as well as a changing bound during traversal. The loop's own header
                -- is skipped, or its `ipairs` call answers the question against itself.
                ok, reason, related = asked.shapeStable(body, asked.aliasOf(token), function(value)
                    return value == node and node.body or nil
                end)
            end
            if ok then
                node.numericIpairs = {operand = operand, length = length}
                remark(
                    remarks,
                    node,
                    "OPT-2",
                    "numeric-ipairs: the declared array has a stable shape in this " .. "loop"
                )
            else
                local at = related and firstToken(related) or nil
                remark(
                    remarks,
                    node,
                    "OPT-2",
                    "numeric-ipairs: not rewritten because " .. reason,
                    at and {
                        {
                            line = at.line,
                            col = at.col,
                            offset = at.offset,
                            length = #at.text,
                            message = "proof stopped here",
                        }
                    } or nil
                )
            end
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end

    walk(body)
end

----------------------------------------------------------------------------
-- OPT-5 concat-buffer
----------------------------------------------------------------------------

-- The loops a string may be accumulated round. `repeat` is included: what matters is
-- that the body runs an unknown number of times, not how it decides to stop.
local LOOPS = {fornumStmt = true, forinStmt = true, whileStmt = true, repeatStmt = true,}

-- An empty string literal, which is the only initialiser this pass accepts. A non-empty
-- one would have to be put into the buffer before the loop to survive zero iterations,
-- which is easy and is not what makes the pass worth having.
local function emptyString(node)
    if not node or isToken(node) or node.kind ~= "string" then
        return false
    end
    local token = firstToken(node)
    local text = token and token.text or ""

    return text == "\"\"" or text == "''" or text == "[[]]"
end

-- `s .. a .. b` parses right-associatively, so the accumulator is the outermost node's
-- left operand and everything appended is down its right spine. Returns the pieces in
-- the order they are concatenated, or nil when the shape is not an accumulation of
-- `definition` -- including when any link is a concatenation the checker could not
-- prove primitive, since `string.buffer` will not run somebody's `__concat`.
local function appendedPieces(expr, definition)
    if not expr or isToken(expr) or expr.kind ~= "binop" then
        return nil
    end
    if not expr.op or expr.op.text ~= ".." or not expr.plainConcat then
        return nil
    end
    local left = expr.lhs
    if not left or isToken(left) or left.kind ~= "name" or not left.token or left.token.definition ~= definition then
        return nil
    end
    local pieces = {}
    local rest = expr.rhs
    while rest and not isToken(rest) and rest.kind == "binop" and rest.op and rest.op.text == ".." do
        if not rest.plainConcat then
            return nil
        end
        pieces[#pieces + 1] = rest.lhs
        rest = rest.rhs
    end
    if not rest then
        return nil
    end
    pieces[#pieces + 1] = rest

    return pieces
end

-- The one `s = s .. ...` in a loop, when that is every mention of `s` the loop makes.
-- Anything else -- a second accumulation, a read, a capture by a function written in
-- the loop -- means the value is observed mid-build and the rewrite is off.
local function soleAccumulation(loop, definition, asked)
    local found, other = nil, false
    local function walk(node)
        if not node or isToken(node) or other then
            return
        end
        if node.kind == "assignStmt" and #(node.targets or {}) == 1 and #(node.exprs or {}) == 1 then
            local target = node.targets[1]
            if target and not isToken(
                target
            ) and target.kind == "name" and target.token and target.token.definition == definition then
                local pieces = appendedPieces(node.exprs[1], definition)
                if pieces and not found then
                    found = {stat = node, pieces = pieces}
                    -- Its own two mentions are accounted for; anything the pieces
                    -- mention is not, and is caught by the count below.
                    for _, piece in ipairs(pieces) do
                        if asked.uses(definition, piece) > 0 then
                            other = true
                        end
                    end
                    return
                end
                other = true
                return
            end
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end

    walk(loop)
    if other or not found then
        return nil
    end
    -- Every remaining mention would be a read of a half-built string.
    if asked.uses(definition, loop) ~= 2 then
        return nil
    end

    return found
end

-- One node of a body, and every node under it. `counter` numbers the buffers a whole
-- run creates, so it is carried in and handed back rather than kept in a name this
-- would have to be written inside the loop to reach -- and a function written inside a
-- loop is one LuaJIT never compiles.
local function concatBufferBlocks(node, asked, remarks, counter: integer): integer
    -- A function written in this body is its own body in `bodies`, and walking
    -- into it here would judge the same statement twice.
    if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
        return counter
    end
    local stats = node.kind == "block" and node.stats or nil
    for i, stat in ipairs(stats or {}) do
        if stat.kind == "localStmt" and #(
            stat.names or {}
        ) == 1 and #(stat.exprs or {}) == 1 and emptyString(stat.exprs[1]) and stat.names[1].definition then
            local definition = stat.names[1].definition
            -- The loop this accumulator is built by, if the statements in
            -- between leave it alone. One that is read or reassigned before the
            -- loop is not an accumulator being started here.
            local loop, untouched = nil, true
            for j = i + 1, #stats do
                local next = stats[j]
                if LOOPS[next.kind] then
                    loop = next
                    break
                end
                if asked.uses(definition, next) > 0 then
                    untouched = false
                    break
                end
            end
            local accumulation = untouched and loop and soleAccumulation(loop, definition, asked) or nil
            if accumulation then
                counter = counter + 1
                local name = ("__nuppBuf_%d"):format(counter)
                stat.concatBuffer = {name = name}
                accumulation.stat.concatBuffer = {name = name, pieces = accumulation.pieces}
                loop.concatBuffer = {name = name, target = stat.names[1].text}
                remark(
                    remarks,
                    stat,
                    "OPT-5",
                    (
                        "concat-buffer: %s is built with a string.buffer, " .. "which appends instead of rebuilding"
                    ):format(stat.names[1].text)
                )
            end
        end
    end
    for _, child in ipairs(node) do
        counter = concatBufferBlocks(child, asked, remarks, counter)
    end

    return counter
end

----------------------------------------------------------------------------
-- Driving the body passes
----------------------------------------------------------------------------

--- Lowers a string accumulated round a loop to a `string.buffer`.
---
--- `s = s .. piece` in a loop is O(n^2): each round allocates a string holding
--- everything so far and interns it, so the work grows with the length rather than with
--- the count. A trace compiler makes each of those steps fast and cannot make there be
--- fewer of them, which is what separates this from the lookups the JIT already folds.
--- `bench/concat.lua` measures it.
---
--- The buffer is created where the accumulator was and dropped after, rather than
--- pooled at module scope. Pooling is faster throughout and is only correct where the
--- site cannot be re-entered -- recursion, a yield in the body, or any call reaching
--- the same function all break it -- and there is no deoptimization to recover from
--- being wrong. That upgrade wants a re-entry query; this does not need one, because
--- every mention of the accumulator is accounted for, so nothing else can reach it.
local function concatBufferWalk(result, remarks)
    local facts = require("nupp.compiler.analysis").queries(result.analysis)
    if not facts then
        return
    end
    local counter: integer = 0
    for _, body in ipairs(result.analysis.bodies or {}) do
        counter = concatBufferBlocks(body, facts.body(body), remarks, counter)
    end
end

local function numericIpairsWalk(result, remarks)
    local facts = require("nupp.compiler.analysis").queries(result.analysis)
    if not facts then
        return -- nothing was analysed, so nothing can be proved
    end
    for _, body in ipairs(result.analysis.bodies or {}) do
        numericIpairsBody(body, facts, remarks)
    end
end

----------------------------------------------------------------------------
-- OPT-3 constant-fold
----------------------------------------------------------------------------

-- A folded value is deliberately smaller than Lua's constant vocabulary. In particular,
-- cdata literals, floats, and calls are left alone: their target representation,
-- identity, rounding, or errors are not a source rewrite's business. Integers in the
-- exact double range and primitive values have the same result when emitted back as Lua
-- source.
local MAX_EXACT_INTEGER = 9007199254740991
local scalarIntrinsics = require("nupp.compiler.scalarintrinsics")
local bit = require("nupp.compiler.bitops")

-- BitOp is the declared semantics of `&`, `|`, `~`, `<<`, `>>` and `~>>` rather than a
-- coincidence about them (`decls/prelude.d.nupp`): operands normalize to 32 bits and
-- results come back signed, so `1 << 32` is 1 and `-8 >> 1` is 2147483644. Folding
-- through `bit` is therefore running the operator's own primitive rather than a
-- reimplementation that could disagree with it, and
-- `foldsBitwiseOperatorsAsTheRuntimeDoes` sweeps the pairing rather than trusting it.
local BITOPS = {
    ["&"] = bit.band,
    ["|"] = bit.bor,
    ["~"] = bit.bxor,
    ["<<"] = bit.lshift,
    [">>"] = bit.rshift,
    ["~>>"] = bit.arshift,
}

local function literal(kind, value, code)
    return {kind = kind, value = value, code = code}
end

local function integerLiteral(node)
    if not node.token then
        return nil
    end
    local text = node.token.text
    local lower = text:lower()
    if lower:find("ll", 1, true) or lower:sub(-1) == "i" then
        return nil
    end
    local value = tonumber((text:gsub("_", "")))
    if not value or value ~= value or value == math.huge or value == -math.huge or value ~= math.floor(
        value
    ) or math.abs(value) > MAX_EXACT_INTEGER then
        return nil
    end

    return literal("number", value, ("%.0f"):format(value))
end

local function stringLiteral(node)
    if not node.token then
        return nil
    end
    local chunk = loadstring("return " .. node.token.text)
    if not chunk then
        return nil
    end
    local ok, value = pcall(chunk)
    if not ok or type(value) ~= "string" then
        return nil
    end

    return literal("string", value, string.format("%q", value))
end

-- A comptime result is already canonical Lua source, not source supplied by the
-- program. Re-read the scalar forms `quoteValue` emits so an immutable binding to a
-- comptime result participates in the same propagation as one initialized by an
-- ordinary literal. Tables intentionally remain out: recreating one at each use would
-- change its identity.
local function comptimeLiteral(node)
    local code = node and node.comptimeValue
    if code == "nil" then
        return literal("nil", nil, "nil")
    elseif code == "true" or code == "false" then
        return literal("boolean", code == "true", code)
    elseif code and code:match("^-?%d+$") then
        local value = tonumber(code)
        if value and math.abs(value) <= MAX_EXACT_INTEGER then
            return literal("number", value, code)
        end
    elseif code and code:sub(1, 1) == '"' then
        local chunk = loadstring("return " .. code)
        if chunk then
            local ok, value = pcall(chunk)
            if ok and type(value) == "string" then
                return literal("string", value, string.format("%q", value))
            end
        end
    end

    return nil
end

local function truthy(value)
    return value.kind ~= "nil" and not (value.kind == "boolean" and not value.value)
end

local function scope(parent)
    return {parent = parent, constants = {}, paths = {}}
end

local function lookupConstant(current, name)
    while current do
        local found = current.constants[name]
        if found ~= nil then
            return found or nil
        end
        current = current.parent
    end

    return nil
end

local function textPath(node)
    if not node or isToken(node) then
        return nil
    end
    if node.kind == "name" and node.token then
        return node.token.text
    end
    if node.kind == "dotIndex" and node.name then
        local base = textPath(node.obj)
        return base and (base .. "." .. node.name.text) or nil
    end

    return nil
end

local function lookupPath(current, path)
    -- `textPath` answers nil for anything that is not a dotted run of names, so
    -- `make().x` and `t[k].y` arrive here with nothing to look up. There is no constant
    -- path to find, and indexing the nil crashed the compiler on an expression as
    -- ordinary as indexing a call's result.
    if not path then
        return nil
    end
    local root = path:match("^[^.]+")
    while current do
        -- A declaration in an inner scope can shadow the root of an outer constant path
        -- even if it does not itself have the same suffix. `local M = {}` must
        -- therefore hide an outer `M.bar`, not let that unrelated value leak into the
        -- proof.
        local found = current.paths[path]
        if found ~= nil then
            return found or nil
        end
        if root and current.paths[root] == false then
            return nil
        end
        current = current.parent
    end

    return nil
end

local function bindPath(current, path, value)
    if not path then
        return
    end
    -- Replacing `M` also replaces every path below it; keeping an old `M.bar.BAZ` fact
    -- would make a later read fold through a new table.
    local prefix = path .. "."
    for known in pairs(current.paths) do
        if known == path or known:sub(1, #prefix) == prefix then
            current.paths[known] = false
        end
    end
    current.paths[path] = value or false
end

local function bindObjectFields(current, path, value)
    bindPath(current, path, value)
    if not value or value.kind ~= "table" then
        return
    end
    for name, field in pairs(value.fields) do
        bindObjectFields(current, path .. "." .. name, field)
    end
end

local function resolvedLiteral(node)
    local t = node and node.resolvedType
    if not node or not node.immutablePath or not t or t.tag ~= "literal" then
        return nil
    end
    if t.base and (
        t.base.tag == "number" or t.base.tag == "integer"
    ) and type(
        t.constant
    ) == "number" and t.constant == math.floor(t.constant) and math.abs(t.constant) <= MAX_EXACT_INTEGER then
        return literal("number", t.constant, ("%.0f"):format(t.constant))
    elseif t.base and t.base.tag == "string" and type(t.constant) == "string" then
        return literal("string", t.constant, string.format("%q", t.constant))
    elseif t.base and t.base.tag == "boolean" and type(t.constant) == "boolean" then
        return literal("boolean", t.constant, tostring(t.constant))
    end

    return nil
end

local foldBlock, foldFunction

-- Lua's grammar takes only a name, a parenthesized expression, or another suffixed
-- expression as the prefix of a call or an index, and every text this folder puts in
-- place of an expression is a scalar literal. So a fold that reaches a prefix has to
-- write the parentheses back, whether the source had them -- `("abc"):find("b")` --
-- or never did, as in a const binding read as `GREETING:upper()`. Emitting the bare
-- literal there produces Lua that does not parse, which `gen` then reports as
-- NUPP3005 against a program that was fine.
local function parenthesizeFoldedPrefix(node)
    if node and not isToken(node) and node.folded then
        node.folded = "(" .. node.folded .. ")"
    end
end

local function foldExpr(node, current)
    if not node or isToken(node) then
        return nil
    end
    local kind = node.kind
    if kind == "number" then
        local value = integerLiteral(node)
        if value then
            node.folded = value.code
        end
        return value
    elseif kind == "string" then
        local value = stringLiteral(node)
        if value then
            node.folded = value.code
        end
        return value
    elseif kind == "nilExpr" then
        node.folded = "nil"
        return literal("nil", nil, "nil")
    elseif kind == "trueExpr" or kind == "falseExpr" then
        local value = kind == "trueExpr"
        node.folded = tostring(value)
        return literal("boolean", value, node.folded)
    elseif kind == "comptimeExpr" then
        return comptimeLiteral(node)
    elseif kind == "name" and node.token then
        local value = lookupConstant(current, node.token.text)
        if value then
            node.folded = value.code
        end
        return value or lookupPath(current, node.token.text)
    elseif kind == "paren" or kind == "castExpr" then
        local value = foldExpr(node.expr, current)
        if value then
            node.folded = value.code
        end
        return value
    elseif kind == "unop" then
        local value = foldExpr(node.operand, current)
        if not value or not node.op then
            return nil
        end
        local op = node.op.kind
        if op == "not" then
            local answer = literal("boolean", not truthy(value), tostring(not truthy(value)))
            node.folded = answer.code
            return answer
        elseif op == "-" and value.kind == "number" and value.value ~= 0 then
            local answer = -value.value
            if math.abs(answer) <= MAX_EXACT_INTEGER then
                local folded = literal("number", answer, ("%.0f"):format(answer))
                node.folded = folded.code
                return folded
            end
        elseif op == "#" and value.kind == "string" then
            local folded = literal("number", #value.value, tostring(#value.value))
            node.folded = folded.code
            return folded
        elseif op == "~" and value.kind == "number" then
            local answer = bit.bnot(value.value)
            local folded = literal("number", answer, ("%.0f"):format(answer))
            node.folded = folded.code
            return folded
        end
        return nil
    elseif kind == "binop" then
        local left, right = foldExpr(node.lhs, current), foldExpr(node.rhs, current)
        if not left or not right or not node.op then
            return nil
        end
        local op = node.op.kind
        if op == "and" then
            local folded = truthy(left) and right or left
            node.folded = folded.code
            return folded
        elseif op == "or" then
            local folded = truthy(left) and left or right
            node.folded = folded.code
            return folded
        elseif op == "??" then
            local folded = left.kind == "nil" and right or left
            node.folded = folded.code
            return folded
        elseif left.kind == "number" and right.kind == "number" then
            local answer
            if op == "+" then
                answer = left.value + right.value
            elseif op == "-" then
                answer = left.value - right.value
            elseif op == "*" then
                answer = left.value * right.value
            elseif op == "%" and right.value ~= 0 then
                answer = left.value % right.value
            elseif op == "//" and right.value ~= 0 then
                -- `gen` lowers `//` to `math.floor((a) / (b))`, so the fold performs
                -- that
                -- expression rather than an integer division that would disagree with
                -- it
                -- where the quotient is not exactly representable.
                answer = math.floor(left.value / right.value)
            elseif BITOPS[op] then
                answer = BITOPS[op](left.value, right.value)
            end
            if answer and math.abs(answer) <= MAX_EXACT_INTEGER then
                local folded = literal("number", answer, ("%.0f"):format(answer))
                node.folded = folded.code
                return folded
            end
        elseif op == ".." and left.kind == "string" and right.kind == "string" then
            local folded = literal("string", left.value .. right.value, string.format("%q", left.value .. right.value))
            node.folded = folded.code
            return folded
        end
        local comparable = left.kind == right.kind or (left.kind == "nil" or right.kind == "nil")
        if comparable and (op == "==" or op == "~=") then
            local equal = left.value == right.value
            local folded = literal(
                "boolean",
                op == "==" and equal or not equal,
                tostring(op == "==" and equal or not equal)
            )
            node.folded = folded.code
            return folded
        end
        if left.kind == right.kind and (
            left.kind == "number" or left.kind == "string"
        ) and (op == "<" or op == ">" or op == "<=" or op == ">=") then
            local answer
            if op == "<" then
                answer = left.value < right.value
            elseif op == ">" then
                answer = left.value > right.value
            elseif op == "<=" then
                answer = left.value <= right.value
            else
                answer = left.value >= right.value
            end
            local folded = literal("boolean", answer, tostring(answer))
            node.folded = folded.code
            return folded
        end
        return nil
    elseif kind == "call" or kind == "safeCall" then
        foldExpr(node.obj, current)
        parenthesizeFoldedPrefix(node.obj)
        local arguments, allNumbers = {}, true
        for _, arg in ipairs(node.args and node.args.exprs or {}) do
            local value = foldExpr(arg, current)
            arguments[#arguments + 1] = value and value.value or nil
            allNumbers = allNumbers and value ~= nil and value.kind == "number"
        end
        if node.scalarIntrinsic and allNumbers then
            local answer = scalarIntrinsics.fold(node.scalarIntrinsic, arguments)
            if type(answer) == "number" and math.abs(answer as number) <= MAX_EXACT_INTEGER then
                local numeric = answer as number
                local folded = literal("number", numeric, ("%.0f"):format(numeric))
                node.folded = folded.code
                return folded
            elseif type(answer) == "boolean" then
                local folded = literal("boolean", answer, tostring(answer))
                node.folded = folded.code
                return folded
            end
        end
    elseif kind == "methodCall" then
        foldExpr(node.obj, current)
        parenthesizeFoldedPrefix(node.obj)
        for _, arg in ipairs(node.args and node.args.exprs or {}) do
            foldExpr(arg, current)
        end
    elseif kind == "dotIndex" or kind == "safeIndex" then
        foldExpr(node.obj, current)
        parenthesizeFoldedPrefix(node.obj)
        local value = resolvedLiteral(node) or lookupPath(current, textPath(node))
        if value and value.kind ~= "table" then
            node.folded = value.code
        end
        return value
    elseif kind == "bracketIndex" or kind == "safeBracket" then
        foldExpr(node.obj, current)
        parenthesizeFoldedPrefix(node.obj)
        foldExpr(node.expr, current)
    elseif kind == "tableExpr" then
        local fields = {}
        for _, field in ipairs(node.fields or {}) do
            foldExpr(field.key, current)
            local value = foldExpr(field.value, current)
            if field.kind == "fieldNamed" and field.isConst and field.name and value then
                fields[field.name.text] = value
            end
        end
        if next(fields) then
            return {kind = "table", fields = fields}
        end
    elseif kind == "istring" then
        for _, part in ipairs(node.parts or {}) do
            foldExpr(part, current)
        end
    elseif kind == "switchExpr" then
        foldExpr(node.selector, current)
        for _, arm in ipairs(node.cases or {}) do
            local inner = scope(current)
            for _, value in ipairs(arm.values or {}) do
                foldExpr(value, current)
            end
            if arm.expr then
                foldExpr(arm.expr, inner)
            elseif arm.body then
                foldBlock(arm.body, inner)
            end
        end
        if node.elseCase then
            local inner = scope(current)
            if node.elseCase.expr then
                foldExpr(node.elseCase.expr, inner)
            elseif node.elseCase.body then
                foldBlock(node.elseCase.body, inner)
            end
        end
    elseif kind == "funcExpr" then
        if node.body then
            foldFunction(node.body, current)
        end
    elseif kind == "shortfn" then
        local inner = scope(current)
        for _, param in ipairs(node.params or {}) do
            if param.name then
                inner.constants[param.name.text] = false
            end
        end
        if node.expr then
            foldExpr(node.expr, inner)
        end
        if node.body then
            foldBlock(node.body, inner)
        end
    end

    return nil
end

foldFunction = function(body, current)
    local inner = scope(current)
    for _, param in ipairs(body.params or {}) do
        if param.name then
            inner.constants[param.name.text] = false
        end
    end
    if body.body then
        foldBlock(body.body, inner)
    end
end

local function foldStatement(stat, current)
    local kind = stat.kind
    if kind == "localStmt" then
        local values = {}
        for i, expr in ipairs(stat.exprs or {}) do
            values[i] = foldExpr(expr, current)
        end
        for i, name in ipairs(stat.names or {}) do
            current.constants[name.text] = stat.isConst and values[i] or false
            if stat.isConst and values[i] and values[i].kind == "table" then
                bindObjectFields(current, name.text, values[i])
            else
                bindPath(current, name.text, nil)
            end
        end
    elseif kind == "assignStmt" then
        for _, expr in ipairs(stat.exprs or {}) do
            foldExpr(expr, current)
        end
        for i, target in ipairs(stat.targets or {}) do
            local path = textPath(target)
            if target.kind == "name" and target.token then
                current.constants[target.token.text] = false
                bindPath(current, target.token.text, nil)
            else
                foldExpr(target, current)
                if stat.isConst and path then
                    local value = foldExpr((stat.exprs or {})[i], current)
                    if value and value.kind == "table" then
                        bindObjectFields(current, path, value)
                    end
                elseif path then
                    bindPath(current, path, nil)
                end
            end
        end
    elseif kind == "returnStmt" then
        for _, expr in ipairs(stat.exprs or {}) do
            foldExpr(expr, current)
        end
    elseif kind == "callStmt" then
        foldExpr(stat.expr, current)
    elseif kind == "compoundAssign" then
        foldExpr(stat.target, current)
        foldExpr(stat.value, current)
        if stat.target and stat.target.kind == "name" and stat.target.token then
            current.constants[stat.target.token.text] = false
        end
    elseif kind == "switchYieldStmt" then
        foldExpr(stat.value, current)
    elseif kind == "ifStmt" then
        local selected, allConstant = nil, true
        for _, clause in ipairs(stat.clauses or {}) do
            local condition = foldExpr(clause.cond, current)
            if not condition then
                allConstant = false
            elseif not selected and truthy(condition) then
                selected = clause.body
            end
            if clause.body then
                foldBlock(clause.body, scope(current))
            end
        end
        if stat.elseClause and stat.elseClause.body then
            foldBlock(stat.elseClause.body, scope(current))
        end
        if allConstant then
            stat.constantBranch = selected or (stat.elseClause and stat.elseClause.body)
            stat.constantBranchNone = stat.constantBranch == nil
        end
    elseif kind == "whileStmt" then
        local condition = foldExpr(stat.cond, current)
        if stat.body then
            foldBlock(stat.body, scope(current))
        end
        -- A loop whose test is a constant falsehood never runs its body once. The body
        -- is still checked, still formatted, and still reported on; what it is not is
        -- emitted.
        if condition and not truthy(condition) then
            stat.constantLoopNone = true
        end
    elseif kind == "repeatStmt" then
        local inner = scope(current)
        if stat.body then
            foldBlock(stat.body, inner)
        end
        foldExpr(stat.cond, inner)
    elseif kind == "doStmt" or kind == "unsafeStmt" then
        if stat.body then
            foldBlock(stat.body, scope(current))
        end
    elseif kind == "fornumStmt" then
        local from, to = foldExpr(stat.start, current), foldExpr(stat.stop, current)
        -- An absent step is 1; a step that is present but not constant leaves `by` nil,
        -- which declines below. Defaulting it to 1 instead would read `for i = 1, 0, k`
        -- as having no iterations, when a negative `k` gives it one.
        local by = literal("number", 1, "1")
        if stat.step then
            by = foldExpr(stat.step, current)
        end
        -- A numeric loop whose three constant bounds do not admit a first iteration is
        -- the `while false` case wearing different syntax. A zero step is left alone
        -- rather than reasoned about: that loop does not terminate, and deleting a
        -- program's hang is a change to what it does.
        local function known(value)
            return value ~= nil and value.kind == "number"
        end

        if known(from) and known(to) and known(by) and by.value ~= 0 then
            local runs = by.value > 0 and from.value <= to.value or by.value < 0 and from.value >= to.value
            if not runs then
                stat.constantLoopNone = true
            end
        end
        local inner = scope(current)
        if stat.var then
            inner.constants[stat.var.text] = false
        end
        if stat.body then
            foldBlock(stat.body, inner)
        end
    elseif kind == "forinStmt" then
        for _, expr in ipairs(stat.exprs or {}) do
            foldExpr(expr, current)
        end
        local inner = scope(current)
        for _, name in ipairs(stat.names or {}) do
            inner.constants[name.text] = false
        end
        if stat.body then
            foldBlock(stat.body, inner)
        end
    elseif kind == "localFuncStmt" then
        if stat.name then
            current.constants[stat.name.text] = false
        end
        if stat.body then
            foldFunction(stat.body, current)
        end
    elseif kind == "funcStmt" or kind == "inlineMethod" then
        if stat.body then
            foldFunction(stat.body, current)
        end
    elseif kind == "pragmaStmt" and stat.stat then
        foldStatement(stat.stat, current)
    end
end

foldBlock = function(block, current)
    for _, stat in ipairs(block.stats or {}) do
        foldStatement(stat, current)
    end
end

local function constantFoldWalk(node)
    if not node or isToken(node) then
        return
    end
    if node.kind == "block" then
        foldBlock(node, scope(nil))
        return
    end
    for _, child in ipairs(node) do
        constantFoldWalk(child)
    end
end

----------------------------------------------------------------------------
-- OPT-4 static-callable
----------------------------------------------------------------------------

local function hasJumpScope(block)
    for _, stat in ipairs(block.stats or {}) do
        if stat.kind == "gotoStmt" or stat.kind == "labelStmt" then
            return true
        end
    end

    return false
end

local function directImmutableCall(stat)
    if stat.kind ~= "callStmt" then
        return nil
    end
    local call = stat.expr
    if not call or call.kind ~= "call" then
        return nil
    end
    if call.ffiOutContracts
        or call.ffiIntrinsic
        or call.carrayElem
        or call.cheaderCdef
        or call.recordConstruct
        or call.ownershipIntrinsic
        or call.cdefCall
        or call.tableIntrinsic
    then
        return nil
    end
    -- Plucking owns the call's evaluation plan: it binds dotted operands and their
    -- shared prefixes in source order. Letting OPT-4 claim the call first would make
    -- its generated callee alias a dependency of that plan.
    for _, argument in ipairs(call.args and call.args.loweredArgs or {}) do
        if argument.generatedKind == "field" and argument.source and argument.source.kind == "dotIndex" then
            return nil
        end
    end
    local callee = call.obj
    local t = callee and callee.resolvedType
    if not callee or callee.kind ~= "dotIndex" or not callee.immutablePath or not t or t.tag ~= "func" then
        return nil
    end

    return textPath(callee), call, callee
end

local function collectNames(node, names)
    if not node then
        return
    end
    if isToken(node) then
        if node.kind == "name" then
            names[node.text] = true
        end
        return
    end
    for _, child in ipairs(node) do
        collectNames(child, names)
    end
end

local function staticCallableWalk(root, remarks)
    local usedNames = {}
    collectNames(root, usedNames)
    local nextAlias = 0
    local function aliasName()
        repeat
            nextAlias = nextAlias + 1
        until not usedNames["__nupp_call_" .. nextAlias]
        local name = "__nupp_call_" .. nextAlias
        usedNames[name] = true

        return name
    end

    local visit
    visit = function(node)
        if not node or isToken(node) then
            return
        end
        if node.kind == "block" and not hasJumpScope(node) then
            local counts = {}
            for _, stat in ipairs(node.stats or {}) do
                local path = directImmutableCall(stat)
                if path then
                    counts[path] = (counts[path] or 0) + 1
                end
            end
            local aliases = {}
            for _, stat in ipairs(node.stats or {}) do
                local path, call, callee = directImmutableCall(stat)
                if path and counts[path] and counts[path] >= 2 then
                    local alias = aliases[path]
                    if not alias then
                        alias = aliasName()
                        aliases[path] = alias
                        stat.callableBindings = {{name = alias, value = callee}}
                        remark(
                            remarks,
                            callee,
                            "OPT-4",
                            ("static-callable: binds immutable callee %s once"):format(path)
                        )
                    end
                    call.staticCallee = alias
                end
            end
        end
        for _, child in ipairs(node) do
            visit(child)
        end
    end
    visit(root)
end

----------------------------------------------------------------------------
-- OPT-6 indexed-range
----------------------------------------------------------------------------

-- Checking has already attached one representation-independent proof to each
-- admitted access. Optimization merely selects the direct adapter; it does not
-- rediscover length, receiver or induction relationships from source spelling.
local function indexedRangeWalk(result, remarks)
    for _, body in ipairs(result.analysis and result.analysis.bodies or {}) do
        local loops, ordered = {}, {}
        local function collect(node)
            if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
                return
            end
            if node.kind == "bracketIndex" and node.rangeProvenNoRaise and node.indexedRangeAccess then
                local proof = node.indexedRangeAccess
                local loop = proof and proof.loop
                if loop then
                    local entry = loops[loop]
                    if not entry then
                        entry = {loop = loop, accesses = {}}
                        loops[loop] = entry
                        ordered[#ordered + 1] = entry
                    end
                    entry.accesses[#entry.accesses + 1] = node
                end
            end
            for _, child in ipairs(node) do
                collect(child)
            end
        end

        collect(body)

        for _, entry in ipairs(ordered) do
            local adapters = {}
            for _, access in ipairs(entry.accesses) do
                access.indexedDirectAccess = true
                local adapter = access.indexedAccess and access.indexedAccess.adapter or "indexed"
                adapters[adapter] = (adapters[adapter] or 0) + 1
            end
            local parts = {}
            for adapter, count in pairs(adapters) do
                parts[#parts + 1] = ("%d %s access%s"):format(count, adapter, count == 1 and "" or "es")
            end
            table.sort(parts)
            remark(remarks, entry.loop, "OPT-6", "indexed-range: lowers " .. table.concat(parts, ", "))
        end

        -- A standard root or derived view used only by proved indexed operations can
        -- carry one count/finish scalar instead of allocating a wrapper. Generation
        -- composes its physical adapter from the checked producer and semantic chain.
        -- Any unclassified use keeps the ordinary safe object.
        local candidates, byConstructor = {}, {}

        local function findCandidates(node)
            if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
                return
            end
            if node.kind == "localStmt" and #(node.names or {}) == 1 and #(node.exprs or {}) == 1 then
                local constructor = node.exprs[1]
                local producer = constructor and constructor.indexedViewProducer
                if not producer and constructor and constructor.kind == "call" then
                    local exact = constructor.obj and constructor.obj.exactCallExport
                    local resultName = node.names[1]
                    local resultDefinition = resultName and resultName.definition
                    local resultType = resultName and resultName.inferredType or resultDefinition and (
                        resultDefinition.inferredType or resultDefinition.type
                    )
                    local root = exact and resultType and indexedViews.exportProducer(
                        exact.module,
                        exact.member,
                        resultType
                    ) or nil
                    local producerArgs = constructor.args and constructor.args.exprs or {}
                    if root then
                        producer = {producer = root, source = producerArgs[1], count = producerArgs[2],}
                        constructor.indexedViewProducer = producer
                    end
                end
                local source = producer and producer.source or (constructor and constructor.obj)
                local operation = constructor and constructor.indexedViewOperation
                if producer then
                    operation = {
                        kind = "root",
                        descriptor = producer.producer.descriptor,
                        producer = producer.producer,
                    }
                end
                if not operation
                    and constructor
                    and constructor.kind == "methodCall"
                    and constructor.name
                    and source
                    and source.kind == "name"
                    and source.token
                then
                    local descriptor = indexedViews.describe(source.token.inferredType)
                    if descriptor and constructor.name.text == "slice" then
                        operation = {kind = "slice", descriptor = descriptor,}
                    elseif descriptor and constructor.name.text == "shared" then
                        operation = {kind = "shared", descriptor = descriptor,}
                    end
                end
                if not operation and node.isConst and constructor and constructor.kind == "name" then
                    local token = constructor.token
                    local descriptor = indexedViews.describe(
                        token and (token.inferredType or token.definition and token.definition.type)
                    )
                    if descriptor then
                        operation = {kind = "alias", descriptor = descriptor,}
                        source = constructor
                    end
                end
                local args = constructor and constructor.args and constructor.args.exprs or {}
                local definition = node.names[1] and node.names[1].definition
                if operation and (
                    operation.kind == "root"
                    or operation.kind == "slice"
                    or operation.kind == "shared"
                    or operation.kind == "alias"
                    or operation.kind == "field"
                ) and (
                    producer
                    and producer.transport
                    or source
                    and source.kind == "name"
                    and source.token
                    and source.token.definition
                ) and (
                    operation.kind ~= "slice" or args[1]
                ) and (node.isConst or operation.kind == "root" and operation.descriptor.writable) and definition then
                    local candidate = {
                        kind = operation.kind,
                        definition = definition,
                        constructor = constructor,
                        source = source,
                        sourceDefinition = source and source.token and source.token.definition or nil,
                        first = args[1],
                        last = args[2],
                        descriptor = operation.descriptor,
                        producer = operation.producer,
                        count = producer and producer.count or nil,
                        transport = producer and producer.transport or nil,
                        ordinal = operation.ordinal,
                        stat = node,
                        admitted = true,
                        dependencies = {},
                    }
                    candidates[definition] = candidate
                    byConstructor[constructor] = candidate
                end
            elseif node.kind == "withStmt" and #(node.bindings or {}) == 1 then
                local binding = node.bindings[1]
                local constructor = binding.expr
                local producer = constructor and constructor.indexedViewProducer
                local source = producer and producer.source
                local definition = binding.name and binding.name.definition
                if producer
                    and producer.producer.descriptor.writable
                    and source
                    and source.kind == "name"
                    and source.token
                    and source.token.definition
                    and definition
                then
                    local candidate = {
                        kind = "root",
                        definition = definition,
                        constructor = constructor,
                        source = source,
                        sourceDefinition = source.token.definition,
                        descriptor = producer.producer.descriptor,
                        producer = producer.producer,
                        count = producer.count,
                        stat = node,
                        withBinding = binding,
                        admitted = true,
                        dependencies = {},
                    }
                    candidates[definition] = candidate
                    byConstructor[constructor] = candidate
                end
            end
            for _, child in ipairs(node) do
                findCandidates(child)
            end
        end

        findCandidates(body)

        local function classify(node, parent, ancestors)
            if not node or isToken(node) or NESTED_FUNCTION[node.kind] then
                return
            end
            if node.kind == "name" and node.token and candidates[node.token.definition] then
                local candidate = candidates[node.token.definition]
                local allowed = parent and parent.kind == "unop" and parent.indexedLength and parent.operand == node
                allowed = allowed
                    or parent
                    and parent.kind == "bracketIndex"
                    and parent.obj == node
                    and parent.indexedAccess ~= nil
                    and (
                    not parent.soaRow or parent.indexedDirectAccess == true
                )
                allowed = allowed
                    or parent
                    and parent.kind == "localStmt"
                    and parent.isConst
                    and parent.exprs
                    and parent.exprs[
                    1
                ] == node
                if parent and parent.kind == "methodCall" and parent.obj == node and parent.indexedViewOperation then
                    local child = byConstructor[parent]
                    if child then
                        candidate.dependencies[child.definition] = true
                        allowed = true
                    end
                end
                for _, ancestor in ipairs(ancestors) do
                    if ancestor.kind == "call" and ancestor.ownershipSyntax == "drop" then
                        allowed = true
                    end
                    local transport = ancestor.kind == "call" and ancestor.indexedViewParameterTransport or nil
                    if transport then
                        for index in pairs(transport.params) do
                            if ancestor.args and ancestor.args.exprs and ancestor.args.exprs[index] == node then
                                allowed = true
                            end
                        end
                    end
                    if ancestor.kind == "call" and ancestor.indexedRangeCall then
                        for index = 3, #(ancestor.args and ancestor.args.exprs or {}) do
                            if ancestor.args.exprs[index] == node then
                                allowed = true
                            end
                        end
                    end
                end
                if parent and parent.kind == "callStmt" and parent.expr and parent.expr.ownershipSyntax == "drop" then
                    allowed = true
                end
                if not allowed then
                    candidate.admitted = false
                    candidate.decline = parent and parent.kind or "escape"
                end
            end
            ancestors[#ancestors + 1] = node
            for _, child in ipairs(node) do
                classify(child, node, ancestors)
            end
            ancestors[#ancestors] = nil
        end

        classify(body, nil, {})

        local changed = true
        while changed do
            changed = false
            for _, candidate in pairs(candidates) do
                if candidate.admitted then
                    for dependency in pairs(candidate.dependencies) do
                        if not candidates[dependency] or not candidates[dependency].admitted then
                            candidate.admitted = false
                            changed = true
                            break
                        end
                    end
                end
            end
        end
        for definition, candidate in pairs(candidates) do
            if candidate.admitted then
                definition.virtualIndexedView = candidate
                if candidate.kind ~= "alias" then
                    candidate.constructor.virtualIndexedView = candidate
                end
                if candidate.withBinding then
                    candidate.withBinding.virtualIndexedView = candidate
                end
                local owner = candidate.stat.automaticOwners and candidate.stat.automaticOwners[1]
                if owner then
                    owner.lowerable = false
                end
                remark(
                    remarks,
                    candidate.constructor,
                    "OPT-6",
                    "view-scalar-replacement: virtualizes one " .. candidate.kind .. (
                        candidate.kind == "root" and " (anchor=rooted-access)" or ""
                    )
                )
            else
                remark(
                    remarks,
                    candidate.constructor,
                    "OPT-6",
                    "view-scalar-replacement: declines "
                    .. candidate.kind
                    .. " (unsupported-view-operation: "
                    .. tostring(
                        candidate.decline or "dependent-view-escapes"
                    ) .. ")"
                )
            end
        end
    end
end

local function declineRecursiveViewTransports(functions, ordered)
    local state, stack, position = {}, {}, {}
    local function visit(definition)
        local plan = functions[definition]
        if not plan or state[definition] == 2 then
            return
        end
        if state[definition] == 1 then
            for index = position[definition], #stack do
                local recursive = functions[stack[index]]
                recursive.admitted = false
                recursive.decline = "recursive-call"
            end
            return
        end
        state[definition] = 1
        stack[#stack + 1] = definition
        position[definition] = #stack
        for callee in pairs(plan.callees) do
            visit(callee)
        end
        position[definition] = nil
        stack[#stack] = nil
        state[definition] = 2
    end

    for _, plan in ipairs(ordered) do
        visit(plan.node.name.definition)
    end
end

--- Marks every reference to a planned transport function against its plan: a
--- static call records the caller's callee edge, a self-call declines the plan
--- as recursive, and any other use declines it as a dynamic call boundary.
local function collectTransportReferences(root, functions)
    local function references(node, parent, currentFunction)
        if not node or isToken(node) then
            return
        end
        local enclosing = currentFunction
        if node.kind == "localFuncStmt" then
            enclosing = node
        end
        if node.kind == "name" and node.token then
            local plan = functions[node.token.definition]
            if plan then
                if parent and parent.kind == "call" and parent.obj == node then
                    local callerDefinition = enclosing and enclosing.name and enclosing.name.definition or nil
                    local caller = functions[callerDefinition]
                    if caller then
                        caller.callees[node.token.definition] = true
                    end
                    if enclosing == plan.node then
                        plan.admitted = false
                        plan.decline = "recursive-call"
                    else
                        plan.calls[#plan.calls + 1] = parent
                    end
                else
                    plan.admitted = false
                    plan.decline = "dynamic-call-boundary"
                end
            end
        end
        for _, child in ipairs(node) do
            references(child, node, enclosing)
        end
    end

    references(root, nil, nil)
end

-- Transports a sealed root through the narrowest useful internal ABI: a local,
-- nonrecursive function whose terminal return is that root and whose function value
-- is never observed. The checked source signature remains a view; generation returns
-- anchor, offset and count scalars only to these statically resolved calls.
local function indexedViewReturnTransportWalk(result, remarks)
    local functions, ordered = {}, {}
    local function collect(node)
        if not node or isToken(node) then
            return
        end
        if node.kind == "localFuncStmt" and node.name and node.body and node.body.body then
            local stats = node.body.body.stats or {}
            local terminal = stats[#stats]
            local value = terminal and terminal.kind == "returnStmt" and #(
                terminal.exprs or {}
            ) == 1 and terminal.exprs[1] or nil
            local producer = value and value.indexedViewProducer or nil
            if producer
                and producer.source
                and producer.source.kind == "name"
                and producer.source.token
                and producer.source.token.definition
            then
                local plan = {
                    node = node,
                    terminal = terminal,
                    value = value,
                    producer = producer,
                    calls = {},
                    callees = {},
                    admitted = true,
                }
                functions[node.name.definition] = plan
                ordered[#ordered + 1] = plan
            end
        end
        for _, child in ipairs(node) do
            collect(child)
        end
    end

    collect(result.root)

    collectTransportReferences(result.root, functions)
    declineRecursiveViewTransports(functions, ordered)

    for _, plan in ipairs(ordered) do
        if plan.admitted and #plan.calls > 0 then
            plan.node.indexedViewReturnTransport = plan
            plan.terminal.indexedViewReturnTransport = plan
            for _, call in ipairs(plan.calls) do
                call.indexedViewReturnTransport = plan
                call.indexedViewProducer = {producer = plan.producer.producer, transport = true,}
                remark(remarks, call, "OPT-6", "view-scalar-replacement: transports view through static call")
            end
        else
            remark(
                remarks,
                plan.value,
                "OPT-6",
                "view-scalar-replacement: declines static return (" .. tostring(
                    plan.decline or "no-static-caller"
                ) .. ")"
            )
        end
    end
end

local function indexedViewParameterTransportPlan(result, remarks)
    local bindings = {}
    local functions, ordered = {}, {}
    local function collect(node)
        if not node or isToken(node) then
            return
        end
        if node.kind == "localStmt" and #(node.names or {}) == 1 and #(node.exprs or {}) == 1 then
            local value = node.exprs[1]
            local producer = value.indexedViewProducer
            local operation = value.indexedViewOperation
            if producer or operation then
                bindings[
                    node.names[1].definition
                ] = {
                    producer = producer and producer.producer or nil,
                    source = producer and producer.source or value.obj,
                }
            end
        elseif node.kind == "localFuncStmt" and node.name and node.body and not node.indexedViewReturnTransport then
            local params = {}
            for index, param in ipairs(node.body.params or {}) do
                local name = param.name
                local descriptor = name and indexedViews.describe(
                    name.inferredType or name.definition and name.definition.type
                )
                if descriptor then
                    params[index] = {param = param, descriptor = descriptor,}
                end
            end
            if next(params) then
                local plan = {node = node, params = params, calls = {}, callees = {}, admitted = true,}
                functions[node.name.definition] = plan
                ordered[#ordered + 1] = plan
            end
        end
        for _, child in ipairs(node) do
            collect(child)
        end
    end

    collect(result.root)

    local function rootProducer(definition, seen)
        if not definition or seen[definition] then
            return nil
        end
        seen[definition] = true
        local binding = bindings[definition]
        if not binding then
            return nil
        end
        if binding.producer then
            return binding.producer
        end
        local source = binding.source

        return source and source.kind == "name" and source.token and rootProducer(source.token.definition, seen) or nil
    end

    collectTransportReferences(result.root, functions)
    declineRecursiveViewTransports(functions, ordered)

    local planned = {}
    for _, plan in ipairs(ordered) do
        local parameterDefinitions = {}
        for _, paramPlan in pairs(plan.params) do
            parameterDefinitions[paramPlan.param.name.definition] = true
        end
        local function validateUses(node, parent)
            if not node or isToken(node) or node ~= plan.node and NESTED_FUNCTION[node.kind] then
                return
            end
            if node.kind == "name" and node.token and parameterDefinitions[node.token.definition] then
                local allowed = parent and parent.kind == "unop" and parent.indexedLength and parent.operand == node
                allowed = allowed
                    or parent
                    and parent.kind == "bracketIndex"
                    and parent.obj == node
                    and parent.indexedAccess ~= nil
                    and (
                    not parent.soaRow or parent.indexedDirectAccess == true
                )
                allowed = allowed
                    or parent
                    and parent.kind == "methodCall"
                    and parent.obj == node
                    and parent.indexedViewOperation ~= nil
                allowed = allowed
                    or parent
                    and parent.kind == "localStmt"
                    and parent.isConst
                    and parent.exprs
                    and parent.exprs[
                    1
                ] == node
                if not allowed then
                    plan.admitted = false
                    plan.decline = "unsupported-view-operation"
                end
            end
            for _, child in ipairs(node) do
                validateUses(child, node)
            end
        end

        validateUses(plan.node, nil)
        if plan.admitted and #plan.calls > 0 then
            for index, paramPlan in pairs(plan.params) do
                local selected
                for _, call in ipairs(plan.calls) do
                    local argument = call.args and call.args.exprs and call.args.exprs[index]
                    local producer = argument and argument.kind == "name" and argument.token and rootProducer(
                        argument.token.definition,
                        {}
                    ) or nil
                    if not producer
                        or producer.descriptor.adapter ~= paramPlan.descriptor.adapter
                        or producer.descriptor.writable ~= paramPlan.descriptor.writable
                        or selected
                        and selected.kind ~= producer.kind
                    then
                        plan.admitted = false
                        plan.decline = "incompatible-view-abi"
                        break
                    end
                    selected = selected or producer
                end
                paramPlan.producer = selected
                if not plan.admitted then
                    break
                end
            end
        else
            plan.admitted = false
            plan.decline = plan.decline or "no-static-caller"
        end
        if plan.admitted then
            for _, paramPlan in pairs(plan.params) do
                local definition = paramPlan.param.name.definition
                local view = {
                    kind = "root",
                    descriptor = paramPlan.descriptor,
                    producer = paramPlan.producer,
                    parameterTransport = true,
                }
                definition.virtualIndexedView = view
                paramPlan.param.indexedViewParameterTransport = view
            end
            for _, call in ipairs(plan.calls) do
                call.indexedViewParameterTransport = plan
            end
            planned[#planned + 1] = plan
        else
            remark(
                remarks,
                plan.node,
                "OPT-6",
                "view-scalar-replacement: declines static parameter (" .. tostring(plan.decline) .. ")"
            )
        end
    end

    return planned
end

local function finalizeIndexedViewParameterTransport(plans, remarks)
    for _, plan in ipairs(plans) do
        local admitted = true
        for index in pairs(plan.params) do
            for _, call in ipairs(plan.calls) do
                local argument = call.args and call.args.exprs and call.args.exprs[index]
                local definition = argument
                    and argument.kind == "name"
                    and argument.token
                    and argument.token.definition
                    or nil
                if not definition or not definition.virtualIndexedView then
                    admitted = false
                end
            end
        end
        if admitted then
            for _, call in ipairs(plan.calls) do
                remark(remarks, call, "OPT-6", "view-scalar-replacement: transports view through static call")
            end
        else
            for _, paramPlan in pairs(plan.params) do
                paramPlan.param.name.definition.virtualIndexedView = nil
                paramPlan.param.indexedViewParameterTransport = nil
            end
            for _, call in ipairs(plan.calls) do
                call.indexedViewParameterTransport = nil
            end
            remark(
                remarks,
                plan.node,
                "OPT-6",
                "view-scalar-replacement: declines static parameter (dependent-view-escapes)"
            )
        end
    end
end

----------------------------------------------------------------------------
-- OPT-7 inline-return-helper
----------------------------------------------------------------------------

-- OPT-7: a module's own single-return local helpers, inlined where they are called.
--
-- `@aot` already inlines exactly these into a compiled body, so before this the two
-- routes did not see the same source: the annotated body got the helper's expression
-- and the ordinary one got a call. The condition `@aot` proves -- one return list --
-- is the condition an ordinary inliner needs, which is what makes this the same rule
-- rather than a second one.
--
-- The call becomes the helper's expression as a tree rather than as text. Text was
-- tried and is wrong here: a helper body is Nupp and a generated line is Lua, so a
-- cast erases, `new T(...)` is not a call, and `nupp.math.i32.add(a, b)` generates as
-- `__nuppBitTobit((a)+(b))`. Splicing nodes lets `gen` decide all of that exactly as
-- it would have at the helper's own site.
--
-- What makes the substitution sound is checked rather than assumed: exact arity,
-- arguments that are names or literals so duplicating or dropping one cannot be
-- observed, a binding nothing reassigns, no recursion, no generics, and no free name
-- of the body either shadowed where the call stands or declared twice at module level.

-- The field-name tokens in a subtree. `t.x`, `t:m()`, and `{x = 1}` each hold a name
-- token that refers to nothing, so a parameter must not be read out of one.
local function fieldNameTokens(node, found)
    if not node or isToken(node) then
        return found
    end
    local kind = node.kind
    if (kind == "dotIndex" or kind == "methodCall" or kind == "fieldNamed") and node.name then
        found[node.name] = true
    end
    for _, child in ipairs(node) do
        fieldNameTokens(child, found)
    end

    return found
end

-- Every name a subtree reads, ignoring field names.
local function referencedNames(node, found, fields)
    if not node then
        return found
    end
    if isToken(node) then
        if node.kind == "name" and not fields[node] then
            found[node.text] = true
        end

        return found
    end
    for _, child in ipairs(node) do
        referencedNames(child, found, fields)
    end

    return found
end

-- One node copied, with each parameter read replaced by a copy of its argument.
--
-- Copied tokens take the call's position. The tokens came from the helper, but the
-- code is being generated where the call was written, and this pass may not move a
-- line to somewhere it was not.
local spliceCopy
spliceCopy = function(node, subs, at)
    if isToken(node) then
        local copied = {}
        for key, value in pairs(node) do
            copied[key] = value
        end
        copied.line = at.line
        copied.col = at.col
        copied.offset = at.offset

        return copied
    end
    if node.kind == "name" and node.token and subs[node.token.text] then
        return spliceCopy(subs[node.token.text], {}, at)
    end

    local copied, mapped = {}, {}
    for index, child in ipairs(node) do
        local fresh = spliceCopy(child, subs, at)
        copied[index] = fresh
        mapped[child] = fresh
    end
    -- A named field usually aliases one of the array children, so it has to name the
    -- copy. Leaving it on the original is how a rewritten tree keeps generating the
    -- tree it replaced.
    --
    -- Usually, not always: a field can hold a node the array part does not, and then
    -- there is no copy to name and the original has to be spliced in its own right.
    -- Handing back the original there is worse than leaving a stale alias, because the
    -- original still reads the helper's parameters -- the substitution simply does not
    -- reach it, and the parameter survives into the caller as a free name.
    for key, value in pairs(node) do
        if type(key) ~= "number" then
            if mapped[value] then
                copied[key] = mapped[value]
            elseif type(value) == "table" and not isToken(value) and (value as any).kind ~= nil then
                copied[key] = spliceCopy(value, subs, at)
            elseif type(value) == "table" and not isToken(value) and #value > 0 then
                local list = {}
                for index, entry in ipairs(value) do
                    if mapped[entry] then
                        list[index] = mapped[entry]
                    elseif type(entry) == "table" then
                        list[index] = spliceCopy(entry as any, subs, at)
                    else
                        list[index] = entry
                    end
                end
                copied[key] = list
            else
                copied[key] = value
            end
        end
    end

    return copied
end

-- Which parameters are read in a prefix position: the object of `x.f`, `x[k]`, `x:m()`
-- or `x(...)`. Lua's grammar takes only a name or a parenthesized expression there, so
-- a literal substituted into one does not parse -- `[=[text]=]:gsub(...)` is a syntax
-- error where `source:gsub(...)` was fine. Such a parameter takes a name and nothing
-- else.
local function prefixParameters(node, params, found)
    if not node or isToken(node) then
        return found
    end
    local kind = node.kind
    if kind == "dotIndex" or kind == "methodCall" or kind == "bracketIndex" or kind == "call" then
        local base = node.obj
        local name = base and not isToken(base) and base.kind == "name" and base.token and base.token.text or nil
        if name and params[name] then
            found[name] = true
        end
    end
    for _, child in ipairs(node) do
        prefixParameters(child, params, found)
    end

    return found
end

-- Whether an argument may be substituted. Names and literals can be duplicated or
-- dropped. An expression made only out of those and non-allocating operators has the
-- same property: the checked operands have no metamethod dispatch or other observable
-- evaluation, so `x * 3` can travel into two reads of a parameter without turning one
-- effect into two. Calls, indexing, concatenation, and length remain outside this set.
local function substitutableArgument(node)
    if not node or isToken(node) then
        return false
    end
    local kind = node.kind

    if kind == "name"
        and node.token ~= nil
        or kind == "number"
        or kind == "string"
        or kind == "nilExpr"
        or kind == "trueExpr"
        or kind == "falseExpr"
    then
        return true
    elseif kind == "paren" or kind == "castExpr" then
        return substitutableArgument(node.expr)
    elseif kind == "unop" then
        return node.op ~= nil and node.op.kind ~= "#" and substitutableArgument(node.operand)
    elseif kind == "binop" then
        return node.op ~= nil and node.op.kind ~= ".." and substitutableArgument(
            node.lhs
        ) and substitutableArgument(node.rhs)
    end

    return false
end

-- The parentheses a call already carries, reused so nothing has to be synthesized.
local function callParens(args)
    local open, close = nil, nil
    for _, child in ipairs(args or {}) do
        if isToken(child) and child.text == "(" and not open then
            open = child
        elseif isToken(child) and child.text == ")" then
            close = child
        end
    end

    return open, close
end

-- The helpers a chunk declares that this pass may inline, by name.
local function inlinableHelpers(root)
    local found = {}
    for _, block in ipairs(root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "localFuncStmt" and stat.name and stat.body then
                local body = stat.body
                local stats = body.body and body.body.stats or {}
                local returned = stats[1]
                local single = #stats == 1
                    and returned
                    and returned.kind == "returnStmt"
                    and returned.exprs
                    and #returned.exprs == 1
                if single and not body.varargParam and not body.generics then
                    local params, ok = {}, true
                    for _, param in ipairs(body.params or {}) do
                        local name = param.name and param.name.text or nil
                        if not name or param.modeTok or param.vararg or param.constTok then
                            ok = false
                        else
                            params[#params + 1] = name
                        end
                    end
                    local expr = returned.exprs[1]
                    local free = referencedNames(expr, {}, fieldNameTokens(expr, {}))
                    for _, name in ipairs(params) do
                        free[name] = nil
                    end
                    -- A helper naming itself is recursive, and substituting one into
                    -- its own call site does not terminate.
                    if ok and expr and not free[stat.name.text] then
                        local named = {}
                        for _, name in ipairs(params) do
                            named[name] = true
                        end
                        found[
                            stat.name.text
                        ] = {params = params, expr = expr, free = free, prefix = prefixParameters(expr, named, {}),}
                    end
                end
            end
        end
    end

    return found
end

-- Drops any candidate the chunk assigns to, whose body is therefore not the body a
-- call reaches.
local function dropReassigned(node, candidates)
    if not node or isToken(node) then
        return
    end
    if node.kind == "assignStmt" then
        for _, target in ipairs(node.targets or {}) do
            local name = nameText(target)
            if name then
                candidates[name] = nil
            end
        end
    end
    for _, child in ipairs(node) do
        dropReassigned(child, candidates)
    end
end

-- Drops any candidate whose body reads a name the chunk declares twice at its own
-- level. Lua rebinds rather than refusing, so the body's name and the same name at a
-- later call site can be two different bindings.
local function dropRebound(root, candidates)
    local declared = {}
    for _, block in ipairs(root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "localStmt" then
                for _, name in ipairs(stat.names or {}) do
                    declared[name.text] = (declared[name.text] or 0) + 1
                end
            elseif stat.kind == "localFuncStmt" and stat.name then
                declared[stat.name.text] = (declared[stat.name.text] or 0) + 1
            end
        end
    end
    for name, helper in pairs(candidates) do
        if (declared[name] or 0) > 1 then
            candidates[name] = nil
        else
            for free in pairs(helper.free) do
                if (declared[free] or 0) > 1 then
                    candidates[name] = nil
                end
            end
        end
    end
end

-- The pass. One walk carrying the names bound in scopes inside the enclosing top-level
-- statement, which is what says whether a free name of a helper body would mean
-- something else where the call stands.
local function inlineReturnHelperWalk(result, remarks)
    local root = result.root
    local candidates = inlinableHelpers(root)
    if not next(candidates) then
        return
    end
    dropReassigned(root, candidates)
    dropRebound(root, candidates)
    if not next(candidates) then
        return
    end

    local shadowed = {}
    -- A call in statement position is a statement, and a parenthesized expression is
    -- not one. `f(x)` alone on a line has nowhere to become `(body)`, so it stays a
    -- call however inlinable the helper is.
    local statementCalls = {}
    local walkNode

    local function shadow(name)
        if name then
            shadowed[name] = (shadowed[name] or 0) + 1
        end
    end

    local function unshadow(name)
        if name and shadowed[name] then
            shadowed[name] = shadowed[name] > 1 and shadowed[name] - 1 or nil
        end
    end

    -- Whether this call may become its helper's expression.
    local function helperFor(node)
        if node.kind ~= "call" or not node.obj or not node.args or statementCalls[node] then
            return nil
        end
        -- A call the checker gave a meaning of its own is not an ordinary call to a
        -- Nupp function, whatever it is spelled like.
        if node.ffiOutContracts
            or node.ffiIntrinsic
            or node.carrayElem
            or node.cheaderCdef
            or node.recordConstruct
            or node.ownershipIntrinsic
            or node.cdefCall
            or node.tableIntrinsic
            or node.requiredModule
        then
            return nil
        end
        local name = nameText(node.obj)
        local helper = name and candidates[name] or nil
        if not helper or shadowed[name] then
            return nil
        end
        for free in pairs(helper.free) do
            if shadowed[free] then
                return nil
            end
        end
        local args = node.args.exprs
        if not args or #args ~= #helper.params or node.args.table or node.args.str or node.args.typeArg then
            return nil
        end
        local subs = {}
        for position, param in ipairs(helper.params) do
            local argument = args[position]
            if not substitutableArgument(argument) then
                return nil
            end
            if helper.prefix[param] and argument.kind ~= "name" then
                return nil
            end
            subs[param] = argument
        end

        return helper, subs, name
    end

    -- The call node becomes the parenthesized expression in place, so every array
    -- entry and named field already pointing at it still points at the right node.
    local function inlineInto(node, helper, subs)
        local open, close = callParens(node.args)
        if not open or not close then
            return false
        end
        local at = firstToken(node)
        if not at then
            return false
        end
        local spliced = spliceCopy(helper.expr, subs, at)
        local inferred, resolved = node.inferredType, node.resolvedType
        for key in pairs(node) do
            node[key] = nil
        end
        node[1], node[2], node[3] = open, spliced, close
        node.kind = "paren"
        node.expr = spliced
        node.inferredType = inferred
        node.resolvedType = resolved

        return true
    end

    walkNode = function(node)
        if not node or isToken(node) then
            return
        end
        local kind = node.kind
        if kind == "callStmt" then
            if node.expr then
                statementCalls[node.expr] = true
            end
            for _, child in ipairs(node) do
                walkNode(child)
            end

            return
        elseif kind == "call" then
            for _, child in ipairs(node) do
                walkNode(child)
            end
            local helper, subs, name = helperFor(node)
            if helper and inlineInto(node, helper, subs) then
                remark(remarks, node, "OPT-7", ("inline-return-helper: inlines %s"):format(name))
            end

            return
        elseif kind == "funcbody" then
            local names = {}
            for _, param in ipairs(node.params or {}) do
                local text = param.name and param.name.text or nil
                names[#names + 1] = text
                shadow(text)
            end
            for _, child in ipairs(node) do
                walkNode(child)
            end
            for _, text in ipairs(names) do
                unshadow(text)
            end

            return
        elseif kind == "block" then
            local introduced = {}
            for _, stat in ipairs(node.stats or {}) do
                walkNode(stat)
                if stat.kind == "localStmt" then
                    for _, declared in ipairs(stat.names or {}) do
                        introduced[#introduced + 1] = declared.text
                        shadow(declared.text)
                    end
                elseif stat.kind == "localFuncStmt" and stat.name then
                    introduced[#introduced + 1] = stat.name.text
                    shadow(stat.name.text)
                end
            end
            for _, text in ipairs(introduced) do
                unshadow(text)
            end

            return
        end
        for _, child in ipairs(node) do
            walkNode(child)
        end
    end

    -- The chunk's own statements. A helper is declared at this level, so its name
    -- being bound here is what makes the call resolvable rather than what stops it.
    for _, block in ipairs(root.blocks or {}) do
        for _, stat in ipairs(block.stats or {}) do
            walkNode(stat)
        end
    end
end

----------------------------------------------------------------------------
-- OPT-8 const-monomorphize
----------------------------------------------------------------------------

-- OPT-8 consumes the checked const tuple before erasure.  It does not copy the CST:
-- generation re-emits the one checked body under a substitution environment, which
-- keeps ownership/effect annotations and semantic definitions attached to the exact
-- nodes the checker proved.
local function constMonomorphizeWalk(result, remarks, selection: any?, selectedFilename: string?)
    -- One name for the module, resolved before collection rather than beside it.
    -- The caller owns that name: parse results do not, and accepting a second
    -- source made collection and remark attribution capable of disagreeing.
    local filename = selectedFilename or "<source>"
    local accepted, declined
    if selection ~= nil then
        accepted, declined = selection.accepted, selection.declined
    else
        local plans = constspecialize.collect(result, filename)
        accepted, declined = constspecialize.select(plans)
    end
    local acceptedByOwner = {}
    local aliasesByOwner = {}
    for _, specialization in ipairs(accepted) do
        local owner = specialization.owner
        if owner.filename == filename then
            local aliases = aliasesByOwner[owner]
            if aliases == nil then
                aliases = {}
                aliasesByOwner[owner] = aliases
            end
            aliases[#aliases + 1] = specialization
            if specialization.physical == specialization then
                local bodies = acceptedByOwner[owner]
                if bodies == nil then
                    bodies = {}
                    acceptedByOwner[owner] = bodies
                end
                bodies[#bodies + 1] = specialization
            end
        end
        for _, call in ipairs(specialization.calls) do
            if specialization.callFiles[call] == filename then
                call.constSpecialization = specialization
                call.constSpecializationExternal = owner.filename ~= filename
                remark(remarks, call, "OPT-8", "const-monomorphize: calls private " .. specialization.name)
            end
        end
    end
    local function byConstKey(a, b): boolean
        return a.key < b.key
    end

    -- What this module actually emitted, which is the count a build reports. Only
    -- the physical representatives are bodies; coalesced keys share one.
    local emittedBodies: integer = 0
    for owner, bodies in pairs(acceptedByOwner) do
        table.sort(bodies, byConstKey)
        owner.declaration.constSpecializations = bodies
        owner.declaration.constSpecializationAliases = aliasesByOwner[owner]
        emittedBodies = emittedBodies + #bodies
    end
    for _, specialization in ipairs(declined) do
        for _, call in ipairs(specialization.calls) do
            if specialization.callFiles[call] == filename then
                remark(
                    remarks,
                    call,
                    "OPT-8",
                    (
                        "const-monomorphize: declines body because this module already selected %d body classes"
                    ):format(constspecialize.maxBodiesPerModule)
                )
            end
        end
    end

    return emittedBodies
end

----------------------------------------------------------------------------
-- Running the passes
----------------------------------------------------------------------------

--- What a pass works on: the tree it rewrites in place and the analysis the checker
--- left beside it.
type optimize.Checked = {
    readonly root: cst.Chunk,
    readonly analysis: any?
}

--- What the passes were asked for.
type optimize.Options = {
    readonly level: integer?,

    --- The sole source name used for ownership and remark attribution. Parse results
    --- deliberately do not carry a competing name.
    readonly filename: string?,
    readonly disabled: {[string]: boolean}?,
    readonly relaxed: {[string]: boolean}?,

    --- The dialect the result is generated for. `OPT-5` lowers to `string.buffer`,
    --- which is LuaJIT's, so a Lua 5.1 target does not get that pass.
    readonly dialect: string?,

    --- Whole-deliverable const body selection, when a project build supplied it.
    readonly constSelection: any?
}

--- Runs the passes a level asks for over a parsed and checked file, annotating it in
--- place.
---
--- @param result the parse result, whose `root` is rewritten
--- @param opts `level` is the `-O` level; `disabled` is a set of codes to skip
--- @return the remarks the passes produced, in source order
--- @return how many private const bodies OPT-8 emitted for this module, which a
---   caller with no module graph of its own has no other way to count
function optimize.run(result: optimize.Checked, opts: optimize.Options?): ({any}, integer)
    opts = opts or {} as optimize.Options
    local level = opts.level or 0
    local disabled = opts.disabled or {}
    local remarks = {}
    if level >= optimize.passes["OPT-1"].level and not disabled["OPT-1"] then
        walk(result.root, remarks)
    end
    if level >= optimize.passes["OPT-2"].level and not disabled["OPT-2"] then
        numericIpairsWalk(result, remarks)
    end
    if level >= optimize.passes["OPT-3"].level and not disabled["OPT-3"] then
        constantFoldWalk(result.root)
    end
    if level >= optimize.passes["OPT-4"].level and not disabled["OPT-4"] then
        staticCallableWalk(result.root, remarks)
    end
    -- Not for Lua 5.1: this pass lowers a string accumulator to `string.buffer`,
    -- and the module then requires it where it loads. That module is LuaJIT's, so
    -- a stock 5.1 host could not load what it produced -- which is the host the
    -- portable compiler is for, and which stopped loading it at all once this
    -- level became the default.
    if level >= optimize.passes["OPT-5"].level and not disabled["OPT-5"] and opts.dialect ~= "lua51" then
        concatBufferWalk(result, remarks)
    end
    if level >= optimize.passes["OPT-6"].level and not disabled["OPT-6"] then
        indexedViewReturnTransportWalk(result, remarks)
        local parameterTransports = indexedViewParameterTransportPlan(result, remarks)
        indexedRangeWalk(result, remarks)
        finalizeIndexedViewParameterTransport(parameterTransports, remarks)
    end
    if level >= optimize.passes["OPT-7"].level and not disabled["OPT-7"] then
        inlineReturnHelperWalk(result, remarks)
    end
    local specializedBodies: integer = 0
    if level >= optimize.passes["OPT-8"].level and not disabled["OPT-8"] then
        specializedBodies = constMonomorphizeWalk(result, remarks, opts.constSelection, opts.filename)
    end
    for _, entry in ipairs(remarks) do
        entry.filename = opts.filename
    end

    return remarks, specializedBodies
end

--- Recomputes compiler runtime effects from the tree that generation will emit.
--- Constant-folded branches and loops are deliberately skipped, so their providers
--- disappear along with their code.
function optimize.liveEffects(result: optimize.Checked): {[string]: boolean}
    local effects = {}
    local function visit(node)
        if not node or isToken(node) then
            return
        end
        if node.constantLoopNone then
            return
        end
        if node.kind == "ifStmt" and (node.constantBranch or node.constantBranchNone) then
            if node.constantBranch then
                visit(node.constantBranch)
            end
            return
        end
        if node.materializedIR then
            for _, effect in ipairs(
                node.materializationObservation and node.materializationObservation.runtimeFeatures or {}
            ) do
                effects[effect] = true
            end
            return
        end
        if node.comptimeValue or node.folded then
            return
        end
        if node.compilerFeatureEffect then
            effects[node.compilerFeatureEffect] = true
        end
        for _, effect in ipairs(node.compilerFeatureEffects or {}) do
            effects[effect] = true
        end
        for _, child in ipairs(node) do
            visit(child)
        end
    end

    visit(result.root)

    return effects
end

export = optimize
