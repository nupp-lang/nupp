module nupp.compiler.bitops

-- Typed compiler-private access to the target-selected BitOp-compatible module.

local raw: any = require("nupp.runtime.bitops")

export function tobit(value: number): integer
    return raw.tobit(value)
end

export function tohex(value: number, digits: number?): string
    return raw.tohex(value, digits)
end

export function bnot(value: number): integer
    return raw.bnot(value)
end

export function band(first: number, ...: number): integer
    return raw.band(first, ...)
end

export function bor(first: number, ...: number): integer
    return raw.bor(first, ...)
end

export function bxor(first: number, ...: number): integer
    return raw.bxor(first, ...)
end

export function lshift(value: number, count: number): integer
    return raw.lshift(value, count)
end

export function rshift(value: number, count: number): integer
    return raw.rshift(value, count)
end

export function arshift(value: number, count: number): integer
    return raw.arshift(value, count)
end

export function rol(value: number, count: number): integer
    return raw.rol(value, count)
end

export function ror(value: number, count: number): integer
    return raw.ror(value, count)
end

export function bswap(value: number): integer
    return raw.bswap(value)
end
