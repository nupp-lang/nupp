function json.asObject(value)if type(value)~="table"then error("json.asObject needs a table",2)end;return setmetatable(value,OBJECT_MARKER)end
function json.arrayOf(shape)local out={};out[ARRAY_SHAPE]=shape==nil and true or shape;return out end
local ESCAPES={["\""]="\\\"",["\\"]="\\\\",["\b"]="\\b",["\f"]="\\f",["\n"]="\\n",["\r"]="\\r",["\t"]="\\t"}
local function quote(value)return'"'..value:gsub('[%z\1-\31\\"]',function(ch)return ESCAPES[ch]or("\\u%04x"):format(ch:byte())end)..'"'end
local function classify(value)local marker=getmetatable(value);local numbers,strings,highest,count=false,false,0,0;for key in pairs(value)do count=count+1;if type(key)=="number"and key>=1 and key%1==0 then numbers=true;if key>highest then highest=key end elseif type(key)=="string"then strings=true else error("JSON object keys must be strings and array indexes must be positive integers",0)end end;if numbers and strings then error("a JSON container cannot mix array indexes and object keys",0)end;if marker==ARRAY_MARKER and strings then error("an array-marked table cannot contain object keys",0)end;if marker==OBJECT_MARKER and numbers then error("an object-marked table cannot contain array indexes",0)end;if numbers then if count~=highest then error("JSON arrays cannot contain holes",0)end;return"array",highest end;if marker==ARRAY_MARKER then return"array",0 end;return"object",count end
local function encodeValue(value,out,nullValue,visiting)if value==json.NULL or nullValue~=nil and value==nullValue then out[#out+1]="null";return end;if value==json.EMPTY_ARRAY then out[#out+1]="[]";return end;if value==json.EMPTY_OBJECT then out[#out+1]="{}";return end;local kind=type(value);if kind=="string"then out[#out+1]=quote(value)elseif kind=="number"then if value~=value or value==math.huge or value==-math.huge then error("JSON numbers must be finite",0)end;out[#out+1]=tostring(value)elseif kind=="boolean"then out[#out+1]=tostring(value)elseif kind=="table"then if visiting[value]then error("cannot serialize a cyclic Lua table",0)end;visiting[value]=true;local container,length=classify(value);out[#out+1]=container=="array"and"["or"{";if container=="array"then for index=1,length do if index>1 then out[#out+1]=","end;encodeValue(value[index],out,nullValue,visiting)end else local keys={};for key in pairs(value)do keys[#keys+1]=key end;table.sort(keys);for index,key in ipairs(keys)do if index>1 then out[#out+1]=","end;out[#out+1]=quote(key);out[#out+1]=":";encodeValue(value[key],out,nullValue,visiting)end end;out[#out+1]=container=="array"and"]"or"}";visiting[value]=nil else error(kind.." has no JSON representation",0)end end
function json.encode(value,nullValue)local out={};encodeValue(value,out,nullValue,{});return table.concat(out)end;json.serialize=json.encode
local function utf8(codepoint)if codepoint<0x80 then return string.char(codepoint)elseif codepoint<0x800 then return string.char(0xC0+math.floor(codepoint/0x40),0x80+codepoint%0x40)elseif codepoint<0x10000 then return string.char(0xE0+math.floor(codepoint/0x1000),0x80+math.floor(codepoint/0x40)%0x40,0x80+codepoint%0x40)end;return string.char(0xF0+math.floor(codepoint/0x40000),0x80+math.floor(codepoint/0x1000)%0x40,0x80+math.floor(codepoint/0x40)%0x40,0x80+codepoint%0x40)end
function json.decode(text,nullValue)if type(text)~="string"then error("JSON input must be a string",2)end;local at,length=1,#text;local function fail(message)error("JSON decode at byte "..at..": "..message,0)end;local function space()local stop=text:find("[^ \n\r\t]",at);at=stop or length+1 end;local parseValue;local function parseString()at=at+1;local out,start={},at;while at<=length do local byte=text:byte(at);if byte==34 then out[#out+1]=text:sub(start,at-1);at=at+1;return table.concat(out)elseif byte==92 then out[#out+1]=text:sub(start,at-1);local escape=text:sub(at+1,at+1);local simple={['"']='"',["\\"]="\\",["/"]="/",b="\b",f="\f",n="\n",r="\r",t="\t"};if simple[escape]then out[#out+1]=simple[escape];at=at+2 elseif escape=="u"then local hex=text:sub(at+2,at+5);if not hex:match("^%x%x%x%x$")then fail("invalid Unicode escape")end;local codepoint=tonumber(hex,16);at=at+6;if codepoint>=0xD800 and codepoint<=0xDBFF then if text:sub(at,at+1)~="\\u"then fail("missing low surrogate")end;local low=tonumber(text:sub(at+2,at+5),16);if not low or low<0xDC00 or low>0xDFFF then fail("invalid low surrogate")end;codepoint=0x10000+(codepoint-0xD800)*0x400+low-0xDC00;at=at+6 elseif codepoint>=0xDC00 and codepoint<=0xDFFF then fail("unexpected low surrogate")end;out[#out+1]=utf8(codepoint)else fail("invalid escape")end;start=at elseif byte<32 then fail("control character in string")else at=at+1 end end;fail("unterminated string")end;local function parseNumber()local start=at;if text:sub(at,at)=="-"then at=at+1 end;if text:sub(at,at)=="0"then at=at+1 elseif text:sub(at,at):match("[1-9]")then repeat at=at+1 until not text:sub(at,at):match("%d")else fail("invalid number")end;if text:sub(at,at)=="."then at=at+1;if not text:sub(at,at):match("%d")then fail("invalid fraction")end;repeat at=at+1 until not text:sub(at,at):match("%d")end;if text:sub(at,at):match("[eE]")then at=at+1;if text:sub(at,at):match("[+-]")then at=at+1 end;if not text:sub(at,at):match("%d")then fail("invalid exponent")end;repeat at=at+1 until not text:sub(at,at):match("%d")end;local value=tonumber(text:sub(start,at-1));if not value or value==math.huge or value==-math.huge then fail("number is out of range")end;return value end;parseValue=function(depth)if depth>1024 then fail("nesting is too deep")end;space();local ch=text:sub(at,at);if ch=='"'then return parseString()elseif ch=="["then at=at+1;space();local out=json.asArray({});if text:sub(at,at)=="]"then at=at+1;return out end;while true do local value=parseValue(depth+1);if value~=NULL_TOKEN or nullValue~=nil then out[#out+1]=value==NULL_TOKEN and nullValue or value end;space();ch=text:sub(at,at);if ch=="]"then at=at+1;return out elseif ch~=","then fail("expected ',' or ']'")end;at=at+1 end elseif ch=="{"then at=at+1;space();local out=json.asObject({});if text:sub(at,at)=="}"then at=at+1;return out end;while true do space();if text:sub(at,at)~='"'then fail("expected an object key")end;local key=parseString();space();if text:sub(at,at)~=":"then fail("expected ':'")end;at=at+1;local value=parseValue(depth+1);if value~=NULL_TOKEN or nullValue~=nil then out[key]=value==NULL_TOKEN and nullValue or value end;space();ch=text:sub(at,at);if ch=="}"then at=at+1;return out elseif ch~=","then fail("expected ',' or '}'")end;at=at+1 end elseif text:sub(at,at+3)=="true"then at=at+4;return true elseif text:sub(at,at+4)=="false"then at=at+5;return false elseif text:sub(at,at+3)=="null"then at=at+4;return NULL_TOKEN elseif ch=="-"or ch:match("%d")then return parseNumber()else fail("expected a JSON value")end end;local value=parseValue(0);space();if at<=length then fail("trailing content")end;if value==NULL_TOKEN then return nullValue end;return value end
local function project(value,shape)if shape==true then return value end;if type(shape)~="table"then error("pull shape entries must be true, object shapes, or array shapes",0)end;local itemShape=shape[ARRAY_SHAPE];if itemShape~=nil then if type(value)~="table"then error("pull array shape matched a non-array value",0)end;local out=json.asArray({});for _,item in ipairs(value)do out[#out+1]=project(item,itemShape)end;return out end;if type(value)~="table"then error("pull object shape matched a non-object value",0)end;local out=json.asObject({});for key,childShape in pairs(shape)do if value[key]~=nil then out[key]=project(value[key],childShape)end end;return out end
function json.pull(text,shape,nullValue)return project(json.decode(text,nullValue),shape)end
