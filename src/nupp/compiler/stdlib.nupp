--[[
Runtime installers for compiler-provided standard facilities.

They are kept as readable Lua here and compacted to one physical output line so
prepending one never moves an application's source positions.
]]
module nupp.compiler.stdlib

local function compact(source: string): string
    return (source:gsub("[\r\n]+%s*", " "):gsub("%s+$", ""))
end

local BASE = compact(
    [=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
local function __nuppCloseFile(handle)if io.type(handle)=="closed file"then return end;local ok,reason=handle:close();if not ok then error(reason or "the file could not be closed",0)end end
local __nuppCleanups=_G.__nuppCleanupRegistry or {};_G.__nuppCleanupRegistry=__nuppCleanups;__nuppCleanups["nupp:lua.d.nupp#__nuppCloseFile"]=__nuppCloseFile
]=]
)

-- Watch modules spend one top-level local on their private implementation
-- array. Addressing the cleanup registry through its global recovers that local
-- and keeps the authored-function ceiling equal to normal.
local HOT_BASE = compact(
    [=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
local function __nuppCloseFile(handle)if io.type(handle)=="closed file"then return end;local ok,reason=handle:close();if not ok then error(reason or "the file could not be closed",0)end end
_G.__nuppCleanupRegistry=_G.__nuppCleanupRegistry or {};_G.__nuppCleanupRegistry["nupp:lua.d.nupp#__nuppCloseFile"]=__nuppCloseFile
]=]
)

-- The compiler lowers qualified math paths to operations where possible. The
-- runtime fills the host table with the shared implementations of other reads.
local MATH = compact(
    [=[
local __nuppMathRuntime=require("nupp.compiler.runtime.math")
__nuppMathRuntime.install(_G.math)
]=]
)

-- The keyed codec a materialized `types.reflect.fieldcodec` calls, and the
-- registry behind `reflect()`, are both an ordinary checked module. What stays
-- here is which of the two a program's feature set asked for.
local FIELDCODEC = compact([=[
require("nupp.compiler.runtime.reflect").installFieldCodec(__nupp)
]=])

local REFLECTION = compact([=[
require("nupp.compiler.runtime.reflect").install(__nupp)
]=])

-- What a derived member does when it runs is `types.derive` itself, the same
-- module whose comptime half decided what to write. This installs its runtime
-- under the namespace generated code addresses, and nothing shadows the module:
-- a program that requires `types.derive` gets the one that is really there.
local DERIVES = compact([=[
require("nupp.derive").install(__nupp)
]=])

export function bootstrap(effects: {[string]: any}?, watch: boolean?, installingManaged: boolean?): string
    local out = {watch and HOT_BASE or BASE}
    if not installingManaged then
        out[#out + 1] = 'require("nupp.runtime.managed").install(__nupp,_G);'
    end
    effects = effects or {}
    if effects["runtime.warn"] then
        out[#out + 1] = 'if not package.loaded["debug.log"] then require("debug.log") end;'
    end
    if effects["stdlib.packages"] then
        out[#out + 1] = 'require("nupp.runtime.packages");'
    end
    if effects["stdlib.math"] then
        out[#out + 1] = MATH
    end
    if effects["stdlib.fieldcodec"] then
        out[#out + 1] = FIELDCODEC
    end
    if effects["stdlib.typewitness"] or effects["stdlib.reflection"] then
        out[#out + 1] = 'require("nupp.compiler.runtime.typewitness").install(__nupp);'
    end
    if effects["stdlib.reflection"] then
        out[#out + 1] = REFLECTION
    end
    if effects["stdlib.derives"] then
        out[#out + 1] = DERIVES
    end
    local code = table.concat(out, " ")

    return code:sub(-1) == ";" and code or code .. ";"
end

--- The installers for library features a VM image installs itself: the keyed
--- field codec. The VM has its own math, managed runtime, reflection and
--- derives, so the base and those pieces are left out; what remains binds the
--- `__nupp` local the pieces address.
export function vmInstallers(effects: {[string]: any}): string?
    if not effects["stdlib.fieldcodec"] then
        return nil
    end

    return "local __nupp=_G.nupp or {};_G.nupp=__nupp " .. FIELDCODEC
end
