module nupp.compiler.stdlib

--[[
Runtime installers for compiler-provided standard facilities.

They are kept as readable Lua here and compacted to one physical output line so
prepending one never moves an application's source positions.
]]

local stdlib = {}

local function compact(source: string): string
    return (source:gsub("[\r\n]+%s*", " "):gsub("%s+$", ""))
end

local BASE = compact(
    [=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
local __nuppMath=rawget(__nupp,"math")or{};rawset(__nupp,"math",__nuppMath)
]=]
)

-- Watch modules spend one top-level local on their private implementation array. The
-- ordinary bootstrap always reserves a math namespace local even when math is unused;
-- addressing that namespace through nupp in the development-only artifact recovers
-- exactly one local and keeps watch's authored-function ceiling equal to normal.
local HOT_BASE = compact([=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
rawset(__nupp,"math",rawget(__nupp,"math")or{})
]=])

local LAZY = compact(
    [=[
local function __nuppLazy(target,name,loader)local meta=getmetatable(target)or{};local loaders=meta.__nuppLoaders;if not loaders then loaders={};local prior=meta.__index;meta.__nuppLoaders=loaders;meta.__index=function(t,k)local load=loaders[k];if load then local value=load(k);loaders[k]=nil;if value==nil then value=rawget(t,k)else rawset(t,k,value)end;return value end;if type(prior)=="function"then return prior(t,k)elseif prior then return prior[k]end end;setmetatable(target,meta)end;if name~=nil and rawget(target,name)==nil and loaders[name]==nil then loaders[name]=loader end end
]=]
)

-- A stage-zero bundle can be copied into a tree with no compiled dependencies. Its
-- private fallback is deliberately self-contained and installed only by
-- `updateBootstrap`; normal generated programs never carry it.
local JSON_FALLBACK = compact(
    [=[
local json={};local ARRAY_MARKER,OBJECT_MARKER,ARRAY_SHAPE={},{},{};local NULL_TOKEN={};json.NULL={};json.EMPTY_ARRAY=setmetatable({},ARRAY_MARKER);json.EMPTY_OBJECT=setmetatable({},OBJECT_MARKER)
