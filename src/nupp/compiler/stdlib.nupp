local PEG = compact(
    [=[
local __nuppPeg=rawget(__nupp,"peg")or{};rawset(__nupp,"peg",__nuppPeg)
local function __nuppPegMachine(program)
local Matcher={};Matcher.__index=Matcher
local function rollback(captures,count)for index=#captures,count+1,-1 do captures[index]=nil end end
local function parse(program,index,subject,position,captures,depth)
