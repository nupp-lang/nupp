module nupp.compiler.stdlib

--[[
Runtime installers for compiler-provided standard facilities.

They are kept as readable Lua here and compacted to one physical output line so
prepending one never moves an application's source positions.
]]

local stdlib = {}

local function compact(source: string): string
    return (source:gsub("[\r\n]+%s*", " "):gsub("%s+$", ""))
end

local BASE = compact(
    [=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
local __nuppMath=rawget(__nupp,"math")or{};rawset(__nupp,"math",__nuppMath)
local function __nuppCloseFile(handle)if io.type(handle)=="closed file"then return end;local ok,reason=handle:close();if not ok then error(reason or "the file could not be closed",0)end end
]=]
)

-- Watch modules spend one top-level local on their private implementation array. The
-- ordinary bootstrap always reserves a math namespace local even when math is unused;
-- addressing that namespace through nupp in the development-only artifact recovers
-- exactly one local and keeps watch's authored-function ceiling equal to normal.
local HOT_BASE = compact(
    [=[
local __nupp=_G.nupp or {};_G.nupp=__nupp
rawset(__nupp,"math",rawget(__nupp,"math")or{})
local function __nuppCloseFile(handle)if io.type(handle)=="closed file"then return end;local ok,reason=handle:close();if not ok then error(reason or "the file could not be closed",0)end end
]=]
)

local LAZY = compact(
    [=[
local function __nuppLazy(target,name,loader)local meta=getmetatable(target)or{};local loaders=meta.__nuppLoaders;if not loaders then loaders={};local prior=meta.__index;meta.__nuppLoaders=loaders;meta.__index=function(t,k)local load=loaders[k];if load then local value=load(k);loaders[k]=nil;if value==nil then value=rawget(t,k)else rawset(t,k,value)end;return value end;if type(prior)=="function"then return prior(t,k)elseif prior then return prior[k]end end;setmetatable(target,meta)end;if name~=nil and rawget(target,name)==nil and loaders[name]==nil then loaders[name]=loader end end
]=]
)

-- A stage-zero bundle can be copied into a tree with no compiled dependencies. Its
-- private fallback is deliberately self-contained and installed only by
-- `updateBootstrap`; normal generated programs never carry it.
local JSON_FALLBACK = compact(
    [=[
local json={};local ARRAY_MARKER,OBJECT_MARKER,ARRAY_SHAPE={},{},{};local NULL_TOKEN={};json.NULL={};json.EMPTY_ARRAY=setmetatable({},ARRAY_MARKER);json.EMPTY_OBJECT=setmetatable({},OBJECT_MARKER)
function json.asArray(value)if type(value)~="table"then error("json.asArray needs a table",2)end;return setmetatable(value,ARRAY_MARKER)end
function json.asObject(value)if type(value)~="table"then error("json.asObject needs a table",2)end;return setmetatable(value,OBJECT_MARKER)end
function json.arrayOf(shape)local out={};out[ARRAY_SHAPE]=shape==nil and true or shape;return out end
local ESCAPES={["\""]="\\\"",["\\"]="\\\\",["\b"]="\\b",["\f"]="\\f",["\n"]="\\n",["\r"]="\\r",["\t"]="\\t"}
local function quote(value)return'"'..value:gsub('[%z\1-\31\\"]',function(ch)return ESCAPES[ch]or("\\u%04x"):format(ch:byte())end)..'"'end
local function classify(value)local marker=getmetatable(value);local numbers,strings,highest,count=false,false,0,0;for key in pairs(value)do count=count+1;if type(key)=="number"and key>=1 and key%1==0 then numbers=true;if key>highest then highest=key end elseif type(key)=="string"then strings=true else error("JSON object keys must be strings and array indexes must be positive integers",0)end end;if numbers and strings then error("a JSON container cannot mix array indexes and object keys",0)end;if marker==ARRAY_MARKER and strings then error("an array-marked table cannot contain object keys",0)end;if marker==OBJECT_MARKER and numbers then error("an object-marked table cannot contain array indexes",0)end;if numbers then if count~=highest then error("JSON arrays cannot contain holes",0)end;return"array",highest end;if marker==ARRAY_MARKER then return"array",0 end;return"object",count end
local function encodeValue(value,out,nullValue,visiting)if value==json.NULL or nullValue~=nil and value==nullValue then out[#out+1]="null";return end;if value==json.EMPTY_ARRAY then out[#out+1]="[]";return end;if value==json.EMPTY_OBJECT then out[#out+1]="{}";return end;local kind=type(value);if kind=="string"then out[#out+1]=quote(value)elseif kind=="number"then if value~=value or value==math.huge or value==-math.huge then error("JSON numbers must be finite",0)end;out[#out+1]=tostring(value)elseif kind=="boolean"then out[#out+1]=tostring(value)elseif kind=="table"then if visiting[value]then error("cannot serialize a cyclic Lua table",0)end;visiting[value]=true;local container,length=classify(value);out[#out+1]=container=="array"and"["or"{";if container=="array"then for index=1,length do if index>1 then out[#out+1]=","end;encodeValue(value[index],out,nullValue,visiting)end else local keys={};for key in pairs(value)do keys[#keys+1]=key end;table.sort(keys);for index,key in ipairs(keys)do if index>1 then out[#out+1]=","end;out[#out+1]=quote(key);out[#out+1]=":";encodeValue(value[key],out,nullValue,visiting)end end;out[#out+1]=container=="array"and"]"or"}";visiting[value]=nil else error(kind.." has no JSON representation",0)end end
function json.encode(value,nullValue)local out={};encodeValue(value,out,nullValue,{});return table.concat(out)end;json.serialize=json.encode
local function utf8(codepoint)if codepoint<0x80 then return string.char(codepoint)elseif codepoint<0x800 then return string.char(0xC0+math.floor(codepoint/0x40),0x80+codepoint%0x40)elseif codepoint<0x10000 then return string.char(0xE0+math.floor(codepoint/0x1000),0x80+math.floor(codepoint/0x40)%0x40,0x80+codepoint%0x40)end;return string.char(0xF0+math.floor(codepoint/0x40000),0x80+math.floor(codepoint/0x1000)%0x40,0x80+math.floor(codepoint/0x40)%0x40,0x80+codepoint%0x40)end
function json.decode(text,nullValue)if type(text)~="string"then error("JSON input must be a string",2)end;local at,length=1,#text;local function fail(message)error("JSON decode at byte "..at..": "..message,0)end;local function space()local stop=text:find("[^ \n\r\t]",at);at=stop or length+1 end;local parseValue;local function parseString()at=at+1;local out,start={},at;while at<=length do local byte=text:byte(at);if byte==34 then out[#out+1]=text:sub(start,at-1);at=at+1;return table.concat(out)elseif byte==92 then out[#out+1]=text:sub(start,at-1);local escape=text:sub(at+1,at+1);local simple={['"']='"',["\\"]="\\",["/"]="/",b="\b",f="\f",n="\n",r="\r",t="\t"};if simple[escape]then out[#out+1]=simple[escape];at=at+2 elseif escape=="u"then local hex=text:sub(at+2,at+5);if not hex:match("^%x%x%x%x$")then fail("invalid Unicode escape")end;local codepoint=tonumber(hex,16);at=at+6;if codepoint>=0xD800 and codepoint<=0xDBFF then if text:sub(at,at+1)~="\\u"then fail("missing low surrogate")end;local low=tonumber(text:sub(at+2,at+5),16);if not low or low<0xDC00 or low>0xDFFF then fail("invalid low surrogate")end;codepoint=0x10000+(codepoint-0xD800)*0x400+low-0xDC00;at=at+6 elseif codepoint>=0xDC00 and codepoint<=0xDFFF then fail("unexpected low surrogate")end;out[#out+1]=utf8(codepoint)else fail("invalid escape")end;start=at elseif byte<32 then fail("control character in string")else at=at+1 end end;fail("unterminated string")end;local function parseNumber()local start=at;if text:sub(at,at)=="-"then at=at+1 end;if text:sub(at,at)=="0"then at=at+1 elseif text:sub(at,at):match("[1-9]")then repeat at=at+1 until not text:sub(at,at):match("%d")else fail("invalid number")end;if text:sub(at,at)=="."then at=at+1;if not text:sub(at,at):match("%d")then fail("invalid fraction")end;repeat at=at+1 until not text:sub(at,at):match("%d")end;if text:sub(at,at):match("[eE]")then at=at+1;if text:sub(at,at):match("[+-]")then at=at+1 end;if not text:sub(at,at):match("%d")then fail("invalid exponent")end;repeat at=at+1 until not text:sub(at,at):match("%d")end;local value=tonumber(text:sub(start,at-1));if not value or value==math.huge or value==-math.huge then fail("number is out of range")end;return value end;parseValue=function(depth)if depth>1024 then fail("nesting is too deep")end;space();local ch=text:sub(at,at);if ch=='"'then return parseString()elseif ch=="["then at=at+1;space();local out=json.asArray({});if text:sub(at,at)=="]"then at=at+1;return out end;while true do local value=parseValue(depth+1);if value~=NULL_TOKEN or nullValue~=nil then out[#out+1]=value==NULL_TOKEN and nullValue or value end;space();ch=text:sub(at,at);if ch=="]"then at=at+1;return out elseif ch~=","then fail("expected ',' or ']'")end;at=at+1 end elseif ch=="{"then at=at+1;space();local out=json.asObject({});if text:sub(at,at)=="}"then at=at+1;return out end;while true do space();if text:sub(at,at)~='"'then fail("expected an object key")end;local key=parseString();space();if text:sub(at,at)~=":"then fail("expected ':'")end;at=at+1;local value=parseValue(depth+1);if value~=NULL_TOKEN or nullValue~=nil then out[key]=value==NULL_TOKEN and nullValue or value end;space();ch=text:sub(at,at);if ch=="}"then at=at+1;return out elseif ch~=","then fail("expected ',' or '}'")end;at=at+1 end elseif text:sub(at,at+3)=="true"then at=at+4;return true elseif text:sub(at,at+4)=="false"then at=at+5;return false elseif text:sub(at,at+3)=="null"then at=at+4;return NULL_TOKEN elseif ch=="-"or ch:match("%d")then return parseNumber()else fail("expected a JSON value")end end;local value=parseValue(0);space();if at<=length then fail("trailing content")end;if value==NULL_TOKEN then return nullValue end;return value end
local function project(value,shape)if shape==true then return value end;if type(shape)~="table"then error("pull shape entries must be true, object shapes, or array shapes",0)end;local itemShape=shape[ARRAY_SHAPE];if itemShape~=nil then if type(value)~="table"then error("pull array shape matched a non-array value",0)end;local out=json.asArray({});for _,item in ipairs(value)do out[#out+1]=project(item,itemShape)end;return out end;if type(value)~="table"then error("pull object shape matched a non-object value",0)end;local out=json.asObject({});for key,childShape in pairs(shape)do if value[key]~=nil then out[key]=project(value[key],childShape)end end;return out end
function json.pull(text,shape,nullValue)return project(json.decode(text,nullValue),shape)end
local ENCODED_VALUE,ENCODED_STRING={},{};local encodedStrings,verifiedStrings={},{}
function json.encoded(value,nullValue)return setmetatable({bytes=json.encode(value,nullValue)},ENCODED_VALUE)end
function json.encodedString(value)local found=encodedStrings[value];if found then return found end;local encoded=setmetatable({bytes=quote(value)},ENCODED_STRING);encodedStrings[value]=encoded;return encoded end
function json.verified(text)json.decode(text,json.NULL);return setmetatable({bytes=text},ENCODED_VALUE)end
function json.verifiedString(text)local value=json.decode(text,json.NULL);if type(value)~="string"then error("simdjson verify: a JSON string is required",2)end;local found=verifiedStrings[text];if found then return found end;local encoded=setmetatable({bytes=text},ENCODED_STRING);verifiedStrings[text]=encoded;return encoded end
function json.writer(out,nullValue)local parts,stack,root={}, {},false;local writer={};local function prepare()if #stack==0 then if root then error("writer already has a root value",2)end;root=true;return end;local frame=stack[#stack];if frame.kind=="array"then if not frame.first then parts[#parts+1]=","end;frame.first=false elseif not frame.value then error("an object value must follow key()",2)else frame.value=false end end;function writer:startArray()prepare();parts[#parts+1]="[";stack[#stack+1]={kind="array",first=true};return self end;function writer:startObject()prepare();parts[#parts+1]="{";stack[#stack+1]={kind="object",first=true,value=false};return self end;function writer:key(name)local frame=stack[#stack];if not frame or frame.kind~="object"or frame.value then error("key() requires an open object with no pending key",2)end;if not frame.first then parts[#parts+1]=","end;frame.first=false;parts[#parts+1]=getmetatable(name)==ENCODED_STRING and name.bytes or quote(name);parts[#parts+1]=":";frame.value=true;return self end;function writer:write(value)prepare();local marker=getmetatable(value);parts[#parts+1]=(marker==ENCODED_VALUE or marker==ENCODED_STRING)and value.bytes or json.encode(value,nullValue);return self end;function writer:null()prepare();parts[#parts+1]="null";return self end;function writer:close()local frame=stack[#stack];if not frame or frame.value then error("close() requires a complete open container",2)end;stack[#stack]=nil;parts[#parts+1]=frame.kind=="array"and"]"or"}";return self end;function writer:finish()if not root or #stack>0 then error("finish() requires one complete root value",2)end;out:put(table.concat(parts))end;return writer end
return json
]=]
)

-- `nupp.math` is mostly answered by the compiler, which lowers the qualified paths to
-- operations and never reaches a function at all. What this installs is the module
-- that answers the reads it could not lower, filling in the namespace the base
-- reserved rather than replacing it, because generated code already addresses that
-- table through a local of its own.
local MATH = compact([=[
require("nupp.mathruntime").install(rawget(__nupp,"math"))
]=])

-- The matcher shell, the graph lowering and the specializations are an ordinary
-- checked module. What stays here is the binding: the namespace the prelude's
-- `nupp.peg` declaration promises, and the two helper names materialized grammars are
-- generated against, which have to be locals of the chunk that carries them.
--
-- The stack limit is raised here rather than in the module because it belongs to the
-- program. A module raises it once, when it is first required; a program that runs
-- beside another one holding a different LPeg handle would then inherit whichever
-- limit was set first, which is not a decision either program made.
local PEG_RUNTIME = compact(
    [=[
local __nuppPegRuntime=require("nupp.pegruntime")
require("lpeg").setmaxstack(10000)
local __nuppPeg=rawget(__nupp,"peg")or{};rawset(__nupp,"peg",__nuppPeg)
local __nuppPegCodegen,__nuppPegLpeg=__nuppPegRuntime.codegen,__nuppPegRuntime.lpegBackend
]=]
)

-- LPeg's `re` module is the reference implementation shipped with LPeg 1.1.
-- Install it into preload so a generated program does not depend on a separately
-- installed Lua rock.
local LPEG_RE = compact(
    [=[
package.loaded.re=nil
package.preload.re=function()
local tonumber,type,print,error=tonumber,type,print,error
local setmetatable=setmetatable
local m=require"lpeg"
local mm=m
local mt=getmetatable(mm.P(0))
local version=_VERSION
local any=m.P(1)
local Predef={nl=m.P"\n"}
local mem;local fmem;local gmem
local function updatelocale()
mm.locale(Predef)
Predef.a=Predef.alpha;Predef.c=Predef.cntrl;Predef.d=Predef.digit
Predef.g=Predef.graph;Predef.l=Predef.lower;Predef.p=Predef.punct
Predef.s=Predef.space;Predef.u=Predef.upper;Predef.w=Predef.alnum
Predef.x=Predef.xdigit
Predef.A=any-Predef.a;Predef.C=any-Predef.c;Predef.D=any-Predef.d
Predef.G=any-Predef.g;Predef.L=any-Predef.l;Predef.P=any-Predef.p
Predef.S=any-Predef.s;Predef.U=any-Predef.u;Predef.W=any-Predef.w
Predef.X=any-Predef.x
mem={};fmem={};gmem={};local weak={__mode="v"}
setmetatable(mem,weak);setmetatable(fmem,weak);setmetatable(gmem,weak)
end
updatelocale()
local function patt_error(s,i)local msg=(#s<i+20)and s:sub(i)or s:sub(i,i+20).."...";error(("pattern error near '%s'"):format(msg),2)end
local function mult(p,n)local np=mm.P(true);while n>=1 do if n%2>=1 then np=np*p end;p=p*p;n=n/2 end;return np end
local function equalcap(s,i,c)if type(c)~="string"then return nil end;local e=#c+i;if s:sub(i,e-1)==c then return e end;return nil end
local S=(Predef.space+"--"*(any-Predef.nl)^0)^0
local name=m.R("AZ","az","__")*m.R("AZ","az","__","09")^0
local arrow=S*"<-"
local seq_follow=m.P"/"+")"+"}"+":}"+"~}"+"|}"+(name*arrow)+-1
name=m.C(name)
local Def=name*m.Carg(1)
local function getdef(id,defs)local c=defs and defs[id];if not c then error("undefined name: "..id)end;return c end
local function defwithfunc(f)return m.Cg(Def/getdef*m.Cc(f))end
local num=m.C(m.R"09"^1)*S/tonumber
local String="'"*m.C((any-"'")^0)*"'"+'"'*m.C((any-'"')^0)*'"'
local defined="%"*Def/function(c,Defs)local cat=Defs and Defs[c]or Predef[c];if not cat then error("name '"..c.."' undefined")end;return cat end
local Range=m.Cs(any*(m.P"-"/"")*(any-"]"))/mm.R
local item=(defined+Range+m.C(any))/m.P
local Class="["*(m.C(m.P"^"^-1))*(item*((item%mt.__add)-"]")^0)/function(c,p)return c=="^"and any-p or p end*"]"
local function adddef(t,k,exp)if t[k]then error("'"..k.."' already defined as a rule")else t[k]=exp end;return t end
local function firstdef(n,r)return adddef({n},n,r)end
local function NT(n,b)if not b then error("rule '"..n.."' used outside a grammar")else return mm.V(n)end end
local exp=m.P{"Exp",
Exp=S*(m.V"Grammar"+m.V"Seq"*("/"*S*m.V"Seq"%mt.__add)^0),
Seq=(m.Cc(m.P"")*(m.V"Prefix"%mt.__mul)^0)*(#seq_follow+patt_error),
Prefix="&"*S*m.V"Prefix"/mt.__len+"!"*S*m.V"Prefix"/mt.__unm+m.V"Suffix",
Suffix=m.V"Primary"*S*((m.P"+"*m.Cc(1,mt.__pow)+m.P"*"*m.Cc(0,mt.__pow)+m.P"?"*m.Cc(-1,mt.__pow)+"^"*(m.Cg(num*m.Cc(mult))+m.Cg(m.C(m.S"+-"*m.R"09"^1)*m.Cc(mt.__pow)))+"->"*S*(m.Cg((String+num)*m.Cc(mt.__div))+m.P"{}"*m.Cc(nil,m.Ct)+defwithfunc(mt.__div))+"=>"*S*defwithfunc(mm.Cmt)+">>"*S*defwithfunc(mt.__mod)+"~>"*S*defwithfunc(mm.Cf))%function(a,b,f)return f(a,b)end*S)^0,
Primary="("*m.V"Exp"*")"+String/mm.P+Class+defined+"{:"*(name*":"+m.Cc(nil))*m.V"Exp"*":}"/function(n,p)return mm.Cg(p,n)end+"="*name/function(n)return mm.Cmt(mm.Cb(n),equalcap)end+m.P"{}"/mm.Cp+"{~"*m.V"Exp"*"~}"/mm.Cs+"{|"*m.V"Exp"*"|}"/mm.Ct+"{"*m.V"Exp"*"}"/mm.C+m.P"."*m.Cc(any)+(name*-arrow+"<"*name*">")*m.Cb("G")/NT,
Definition=name*arrow*m.V"Exp",
Grammar=m.Cg(m.Cc(true),"G")*((m.V"Definition"/firstdef)*(m.V"Definition"%adddef)^0)/mm.P
}
local pattern=S*m.Cg(m.Cc(false),"G")*exp/mm.P*(-any+patt_error)
local function compile(p,defs)if mm.type(p)=="pattern"then return p end;local cp=pattern:match(p,1,defs);if not cp then error("incorrect pattern",3)end;return cp end
local function match(s,p,i)local cp=mem[p];if not cp then cp=compile(p);mem[p]=cp end;return cp:match(s,i or 1)end
local function find(s,p,i)local cp=fmem[p];if not cp then cp=compile(p)/0;cp=mm.P{mm.Cp()*cp*mm.Cp()+1*mm.V(1)};fmem[p]=cp end;local first,ending=cp:match(s,i or 1);if first then return first,ending-1 end;return first end
local function gsub(s,p,rep)local g=gmem[p]or{};gmem[p]=g;local cp=g[rep];if not cp then cp=compile(p);cp=mm.Cs((cp/rep+1)^0);g[rep]=cp end;return cp:match(s)end
local re={compile=compile,match=match,find=find,gsub=gsub,updatelocale=updatelocale}
if version=="Lua 5.1"then _G.re=re end
return re
end
]=]
)

local PEG_COMPILE = compact([=[
__nuppPeg.compile=__nuppPegRuntime.compile
]=])

-- The keyed codec a materialized `nupp.reflect.fieldCodec` calls, and the registry
-- behind `reflect()`, are both an ordinary checked module. What stays here is which
-- of the two a program's feature set asked for.
local FIELDCODEC = compact([=[
require("nupp.reflectruntime").installFieldCodec(__nupp)
]=])

local REFLECTION = compact([=[
require("nupp.reflectruntime").install(__nupp)
]=])

-- What a derived member does when it runs is `nupp.derive` itself, the same module
-- whose comptime half decided what to write. This installs its runtime under the
-- namespace generated code addresses, and nothing shadows the module: a program that
-- requires `nupp.derive` gets the one that is really there.
local DERIVES = compact([=[
require("nupp.derive").install(__nupp)
]=])

--- Installs the private JSON implementation used only by the tracked stage-zero
--- compiler before it can build jsonNative.
function stdlib.bootstrapJsonFallback(): string
    return 'package.preload["jsonNative"]=function()\n' .. JSON_FALLBACK .. "\nend\n"
end

function stdlib.bootstrap(effects: {[string]: any}?, watch: boolean?): string
    local out = {watch and HOT_BASE or BASE}
    if effects and next(effects) then
        out[#out + 1] = LAZY
    end
    effects = effects or {}
    if effects["stdlib.math"] then
        out[#out + 1] = MATH
    end
    if effects["stdlib.peg"] or effects["stdlib.peg.compile"] then
        out[#out + 1] = PEG_RUNTIME
    end
    if effects["stdlib.lpeg.re"] or effects["stdlib.peg.compile"] then
        out[#out + 1] = LPEG_RE
    end
    if effects["stdlib.peg.compile"] then
        out[#out + 1] = PEG_COMPILE
    end
    if effects["stdlib.fieldcodec"] then
        out[#out + 1] = FIELDCODEC
    end
    if effects["stdlib.reflection"] then
        out[#out + 1] = REFLECTION
    end
    if effects["stdlib.derives"] then
        out[#out + 1] = DERIVES
    end
    local code = table.concat(out, " ")

    return code:sub(-1) == ";" and code or code .. ";"
end

export = stdlib
