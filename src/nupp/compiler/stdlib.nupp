elseif op=="any"then if position<=#subject then return position+1 end
elseif op=="eof"then if position==#subject+1 then return position end
elseif op=="set"then local byte=subject:sub(position,position);if byte~=""and node[2]:find(byte,1,true)then return position+1 end
elseif op=="sequence"then local at=position;for child=2,#node do at=parse(program,node[child],subject,at,captures,depth+1);if not at then rollback(captures,before);return nil end end;return at
elseif op=="choice"then for child=2,#node do local at=parse(program,node[child],subject,position,captures,depth+1);if at then return at end;rollback(captures,before)end
elseif op=="difference"then local scratch={};if parse(program,node[3],subject,position,scratch,depth+1)then return nil end;return parse(program,node[2],subject,position,captures,depth+1)
elseif op=="zeroOrMore"or op=="oneOrMore"then local at,count=position,0;while true do local checkpoint=#captures;local nextAt=parse(program,node[2],subject,at,captures,depth+1);if not nextAt then rollback(captures,checkpoint);break end;if nextAt==at then error("nupp: nullable PEG repetition reached runtime",3)end;at=nextAt;count=count+1 end;if op=="oneOrMore"and count==0 then rollback(captures,before);return nil end;return at
elseif op=="optional"then local at=parse(program,node[2],subject,position,captures,depth+1);if at then return at end;rollback(captures,before);return position
elseif op=="and"then local scratch={};if parse(program,node[2],subject,position,scratch,depth+1)then return position end
elseif op=="not"then local scratch={};if not parse(program,node[2],subject,position,scratch,depth+1)then return position end
elseif op=="capture"then local scratch={};local at=parse(program,node[2],subject,position,scratch,depth+1);if at then captures[#captures+1]=subject:sub(position,at-1);return at end
elseif op=="position"then captures[#captures+1]=position;return position
elseif op=="collect"then local scratch={};local at=parse(program,node[2],subject,position,scratch,depth+1);if at then captures[#captures+1]=scratch;return at end
elseif op=="reference"then return parse(program,node[2],subject,position,captures,depth+1)
else error("nupp: unknown PEG instruction "..tostring(op),3)end
rollback(captures,before);return nil end
function Matcher:match(subject,init)if type(subject)~="string"then error("nupp: PEG subject must be a string",2)end;if init==nil then init=1 elseif type(init)~="number"or init~=math.floor(init)then error("nupp: PEG init must be an integer",2)elseif init<0 then init=#subject+init+1 end;if init<1 then init=1 end;if init>#subject+1 then return nil end;local captures={};local position=parse(self._program,self._program.root,subject,init,captures,0);if not position then return nil end;if #captures==0 then return position elseif #captures==1 then return captures[1]end;error("nupp: invalid PEG result arity",2)end
Matcher.__call=Matcher.match
return setmetatable({_program=program},Matcher)end
__nuppPeg.machine=__nuppPegMachine;
]=]
)

