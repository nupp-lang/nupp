local PEG = compact(
    [=[
local __nuppPeg=rawget(__nupp,"peg")or{};rawset(__nupp,"peg",__nuppPeg)
local function __nuppPegVM(program,actions)
local Matcher={};Matcher.__index=Matcher;local ACTION={}
