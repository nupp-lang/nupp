    ["nupp.text.utf8"] = {kind = "common"},
    ["nupp.derive"] = facility("runtime", "runtime.text_buffer"),
    ["nupp.cli"] = {kind = "common"},
    ["nupp.cli.internal.optparser"] = {kind = "common"},
    ["nupp.cli.internal.decode"] = {kind = "common"},
