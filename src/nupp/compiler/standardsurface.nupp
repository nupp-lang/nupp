module nupp.compiler.standardsurface

--[[Closed portable classification for public standard-library facilities.]]

local surface = {}
local seamRegistry = require("nupp.runtime.seam.registry")

local function selected(kind: string, name: string, allDialects: boolean?): any
    local seam = seamRegistry.get(name)

    return {kind = kind, seam = seam.name, effect = seam.effect, allDialects = allDialects,}
end

-- This registry is deliberately positive. Adding a public module requires an
-- explicit classification before `lua51` can claim it is portable.
local MODULES = {
    ["nupp"] = {kind = "common"},
    ["nupp.data"] = {kind = "members"},
    ["nupp.data.json"] = selected("runtime", "data.json"),
    ["nupp.data.hmac"] = selected("runtime", "crypto.hmac_sha256", true),
    ["nupp.data.serde"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.data.utf8"] = selected("runtime", "data.utf8"),
    ["nupp.derive"] = {kind = "compiler"},
    ["nupp.hotreload"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io"] = selected("runtime", "io.bytes"),
    ["nupp.io.files"] = selected("host", "host.files"),
    ["nupp.io.http"] = selected("host", "host.http"),
    ["nupp.io.path"] = selected("runtime", "io.path"),
    ["nupp.io.process"] = selected("host", "host.process"),
    ["nupp.io.uri"] = selected("runtime", "io.uri"),
    ["nupp.log"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mathruntime"] = {kind = "compiler"},
    ["nupp.mem"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.heap"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.indexed"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.soa"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.span"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.native"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.owners"] = {kind = "common"},
    ["nupp.pegruntime"] = selected("runtime", "peg"),
    ["nupp.profile"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.trace"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.zone"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.reflectruntime"] = {kind = "compiler"},
    ["nupp.simd"] = selected("compile", "numeric.simd"),
    ["nupp.suspension"] = {kind = "common"},
    ["nupp.workers"] = selected("host", "host.workers"),
}

local FACILITIES = {
    ["data.hash"] = selected("runtime", "data.hash"),
    ["data.sha256"] = selected("runtime", "data.sha256"),
    ["data.uuid"] = selected("runtime", "data.uuid"),
    ["data.bitset"] = selected("runtime", "data.bitset"),
}

local MODULE_MEMBERS = {
    [
        "nupp.data"
    ] = {
        Bitset = "data.bitset",
        WORD_BITS = "data.bitset",
        crc32 = "data.hash",
        fnv1a64 = "data.hash",
        sha256 = "data.sha256",
        uuid4 = "data.uuid",
        uuid7 = "data.uuid",
    },
}

function surface.classify(moduleName: string): any?
    return MODULES[moduleName]
end

function surface.all(): {[string]: any}
    local copy = {}
    for name, classification in pairs(MODULES) do
        copy[name] = classification
    end

    return copy
end

function surface.facilities(): {[string]: any}
    local copy = {}
    for name, classification in pairs(FACILITIES) do
        copy[name] = classification
    end

    return copy
end

function surface.requireModule(checker: any, moduleName: string, at: any): string?
    local classification = MODULES[moduleName]
    if checker.opts.dialect ~= "lua51" and not (classification and classification.allDialects) then
        return nil
    end
    if classification == nil
        or classification.kind == "common"
        or classification.kind == "compiler"
        or classification.kind == "members"
    then
        return nil
    end
    if classification.kind == "unavailable" then
        require("nupp.compiler.capabilities").require(checker, classification.capability, at)
        return nil
    end
    local selected = checker.opts.backendResolution
        and checker.opts.backendResolution.seams
        and checker.opts.backendResolution.seams[
        classification.seam
    ]
    if selected == nil then
        checker.diag(
            "NUPP3012",
            at,
            (
                "the `%s` dialect needs standard seam `%s` to reach module `%s`"
            ):format(checker.opts.dialect, classification.seam, moduleName),
            nil,
            {help = "select a checked backend whose exact runtime module implements the complete contract"}
        )
        return nil
    end

    return classification.effect
end

--- Requires the seam owning one member of a mixed standard module.
function surface.requireMember(checker: any, moduleName: string, member: string, at: any): string?
    if checker.opts.dialect ~= "lua51" then
        return nil
    end
    local facilityName = MODULE_MEMBERS[moduleName] and MODULE_MEMBERS[moduleName][member] or nil
    if not facilityName then
        return nil
    end
    local classification = FACILITIES[facilityName]
    local selected = checker.opts.backendResolution
        and checker.opts.backendResolution.seams
        and checker.opts.backendResolution.seams[
        classification.seam
    ]
    if selected == nil then
        checker.diag(
            "NUPP3012",
            at,
            (
                "the `%s` dialect needs standard seam `%s` to reach `%s.%s`"
            ):format(checker.opts.dialect, classification.seam, moduleName, member),
            nil,
            {help = "select a checked backend whose exact runtime module implements the complete contract"}
        )
        return nil
    end

    return classification.effect
end

export = surface
