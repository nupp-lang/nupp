local FACILITIES = {["task.deadline"] = facility("host", "runtime.time")}

local MODULE_MEMBERS = {["nupp.tasks"] = {runFor = "task.deadline",},}

local BROWSER_IMPLEMENTATIONS = {
    ["nupp.runtime.browser.system"] = true,
    ["nupp.runtime.browser.webgpu.internal"] = true,
    ["nupp.runtime.browser.http"] = true,
    ["nupp.runtime.browser.files"] = true,
    ["nupp.runtime.browser.workers"] = true,
    ["nupp.runtime.browser.crypto"] = true,
    ["nupp.runtime.browser.suspension"] = true,
    ["nupp.runtime.browser.uri"] = true,
    ["nupp.runtime.browser.path"] = true,
    ["nupp.runtime.browser.time"] = true,
}

--- Whether this implementation module belongs to the artifact's runtime.
function surface.supports(moduleName: string, dialect: string, host: string?): boolean
    local selectedHost = host or (dialect == "lua51" and "browser" or "native")
    if BROWSER_IMPLEMENTATIONS[moduleName] or moduleName == "nupp.runtime.browser.memory" then
        return selectedHost == "browser"
    end
    if moduleName == "nupp.runtime.provider.wasmstorage" then
        return dialect == "lua51"
    end
    if moduleName == "nupp.runtime.provider.nativebuffer"
        or moduleName == "nupp.runtime.provider.nativestorage"
        or moduleName == "bit"
    then
        return dialect ~= "lua51"
    end
    if moduleName:match("^nupp%.runtime%.provider%.native")
        or moduleName == "nupp.runtime.provider.workers"
        or moduleName == "nupp.runtime.provider.suspension"
        or moduleName == "nupp.codec.json.aot"
    then
        return dialect ~= "lua51" and selectedHost == "native"
    end

    return true
end

function surface.classify(moduleName: string): any?
    return MODULES[moduleName]
end

function surface.all(): {[string]: any}
    local copy = {}
    for name, classification in pairs(MODULES) do
        copy[name] = classification
    end

    return copy
end

local function gate(checker: any, moduleName: string): any
    local classification = MODULES[moduleName]
    if checker.opts.dialect ~= "lua51" and not (classification and classification.allDialects) then
        return nil
    end
    if classification == nil
        or classification.kind == "common"
        or classification.kind == "compiler"
        or classification.kind == "members"
    then
        return nil
    end

    return classification
end

local function reach(checker: any, moduleName: string, at: any?): boolean
    if not surface.supports(
        moduleName,
        checker.opts.dialect or "luajit",
        checker.env and checker.env.config and checker.env.config._target and checker.env.config._target.host
    ) then
        if at ~= nil then
            checker.diag(
                "NUPP3006",
                at,
                ("module %q does not support dialect %q"):format(moduleName, checker.opts.dialect)
            )
        end
        return false
    end
    local classification = gate(checker, moduleName)
    if classification == nil then
        return true
    end
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if at then
            return capabilities.require(checker, classification.capability, at)
        end

        return capabilities.available(checker, classification.capability)
    end

    return true
end

function surface.reachable(checker: any, moduleName: string): boolean
    return reach(checker, moduleName, nil)
end

function surface.accelerators(moduleName: string): {string}?
    local classification = MODULES[moduleName]

    return classification and classification.accelerators or nil
end

function surface.requireModule(checker: any, moduleName: string, at: any): string?
    if not reach(checker, moduleName, at) then
        return nil
    end
    local classification = gate(checker, moduleName)

    return classification and classification.kind ~= "unavailable" and classification.effect or nil
end

function surface.requireMember(checker: any, moduleName: string, member: string, at: any): string?
    if checker.opts.dialect ~= "lua51" then
        return nil
    end
    local facilityName = MODULE_MEMBERS[moduleName] and MODULE_MEMBERS[moduleName][member] or nil
    if not facilityName then
        return nil
    end
    local classification = FACILITIES[facilityName]
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if capabilities.require(checker, classification.capability, at) then
            local resolved = capabilities.resolve(checker.opts.dialect)
            return classification.effect or capabilities.get(resolved, classification.capability).effect
        end
        return nil
    end

    return classification.effect
end

export = surface
