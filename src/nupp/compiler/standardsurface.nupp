module nupp.compiler.standardsurface

--[[Closed portable classification for public standard-library facilities.]]

local surface = {}
local seamRegistry = require("nupp.runtime.seam.registry")

local function selected(kind: string, name: string, allDialects: boolean?, accelerators: {string}?): any
    local seam = seamRegistry.get(name)

    return {
        kind = kind,
        seam = seam.name,
        effect = seam.effect,
        allDialects = allDialects,
        accelerators = accelerators,
    }
end

-- This registry is deliberately positive. Adding a public module requires an
-- explicit classification before `lua51` can claim it is portable.
local MODULES = {
    ["bit"] = selected("runtime", "numeric.bitops"),
    ["string.buffer"] = selected("runtime", "text.buffer"),
    ["nupp.data.json.provider"] = selected("runtime", "data.json"),
    ["nupp"] = {kind = "common"},
    ["nupp.test"] = {kind = "common"},
    ["nupp.data.crypto"] = selected("host", "host.crypto", true),
    ["nupp.io.storage"] = selected("host", "host.storage", true),
    ["nupp.data"] = {kind = "members"},
    ["nupp.data.internal.bitset"] = {kind = "unavailable", capability = "cstorage"},
    -- Tables, integers, and one metatable: nothing a dialect could lack.
    ["nupp.data.internal.store"] = {kind = "common"},
    ["nupp.data.json"] = selected("runtime", "data.json"),
    -- Two seams, and only the first stands between a target and this module.
    -- `numeric.bitops` is what the digests are written against and a `lua51`
    -- target has to select. `crypto.hmac_sha256` is an accelerator the one-shot
    -- HMAC prefers where a backend installs one, so it is recorded as reached
    -- -- a target that names such a backend gets it installed -- and never
    -- gated on, because the module answers without it.
    ["nupp.data.hash"] = selected("runtime", "numeric.bitops", nil, {
        "runtime.hmac_sha256"
    }),
    ["nupp.data.serde"] = selected("runtime", "text.buffer"),
    -- Scalars out of ordinary strings, in ordinary Lua. This was gated on a
    -- `data.utf8` seam nothing ever implemented, which made a portable module
    -- refusable on a target that could have run it as written.
    ["nupp.data.utf8"] = {kind = "common"},
    -- Portable given a buffer, which is the only thing in either of these that a
    -- `lua51` target could not answer: both build their output by appending into
    -- one. Classified through the seam that supplies it rather than as portable
    -- outright, so a program that reaches them without selecting a provider is told
    -- which seam it is missing, on the line that reached them.
    ["nupp.derive"] = selected("runtime", "text.buffer"),
    ["nupp.gpu"] = selected("runtime", "compute.gpu"),
    ["nupp.gpu.internal"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.gpu.layoutfacts"] = {kind = "common"},
    ["nupp.gpu.layout"] = {kind = "common"},
    ["nupp.runtime.hotreload"] = {kind = "unavailable", capability = "cinterop"},
    -- The core byte types are cdata: a view is a pointer and a length, and no
    -- table stands in for one. A dialect without C storage cannot have them,
    -- which is what this says now that no seam claims otherwise.
    ["nupp.runtime.storage"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.bytes"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.ownedreader"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.scalars"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.lines"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.http.internal.transport"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.path.provider"] = selected("host", "host.path"),
    ["nupp.io.path.pathtext"] = {kind = "common"},
    ["nupp.io.files"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.http"] = selected("host", "host.http"),
    ["nupp.io.path"] = {kind = "common"},
    ["nupp.data.base64"] = {kind = "common"},
    ["nupp.data.binary"] = {kind = "common"},
    ["nupp.data.valuebuilder"] = {kind = "common"},
    ["nupp.io.net"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.process"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.tls"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.uri"] = selected("runtime", "host.uri"),
    ["nupp.io.uri.provider"] = selected("runtime", "host.uri"),
    ["nupp.log"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.compiler.runtime.extensions"] = {kind = "compiler"},
    ["nupp.compiler.runtime.math"] = {kind = "compiler"},
    ["nupp.compiler.runtime.peg"] = selected("runtime", "peg"),
    ["nupp.compiler.runtime.reflect"] = {kind = "compiler"},
    ["nupp.mem"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.heap"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.indexed"] = {kind = "unavailable", capability = "cstorage"},
    -- Engine-backed shared storage, not the worker scheduler. It shares the native
    -- host feature, but a `lua51` target reaching it needs the storage capability
    -- rather than whichever module implements `host.workers` there.
    ["nupp.mem.sharedbytes"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.soa"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.span"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.runtime.native"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.trace"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.zone"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.data.random"] = {kind = "common"},
    ["nupp.simd"] = selected("compile", "numeric.simd"),
    ["nupp.suspension"] = {kind = "common"},
    ["nupp.tasks"] = {kind = "common"},
    ["nupp.time"] = selected("host", "host.time"),
    ["nupp.workers"] = selected("host", "host.workers"),
    ["nupp.mem.array"] = {kind = "unavailable", capability = "cstorage"},
    -- Ordinary tables stamped with a record's metatable, so every backend has it.
    ["nupp.mem.pool"] = {kind = "common"},
    -- Pages are `S[?]` arrays reached through the storage seam.
    ["nupp.mem.arena"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.events"] = {kind = "unavailable", capability = "cstorage"},
}

local FACILITIES = {
    ["task.deadline"] = selected("host", "host.time"),
    -- The digests `nupp.data.hash` computes, projected onto `nupp.data`. They
    -- are written against bit operations and nothing else, so that is what a
    -- portable target has to select for them.
    ["data.hash"] = selected("runtime", "numeric.bitops"),
    ["data.sha256"] = selected("runtime", "data.sha256"),
    ["data.uuid"] = selected("runtime", "data.uuid"),
    -- A bitset is a `uint32[?]`, so it needs C storage rather than a provider.
    ["data.bitset"] = {kind = "unavailable", capability = "cstorage", effect = "runtime.bitset"},
}

local MODULE_MEMBERS = {
    ["nupp.tasks"] = {runFor = "task.deadline",},
    [
        "nupp.data"
    ] = {
        Bitset = "data.bitset",
        WORD_BITS = "data.bitset",
        crc32 = "data.hash",
        fnv1a64 = "data.hash",
        sha256 = "data.sha256",
        uuid4 = "data.uuid",
        uuid7 = "data.uuid",
    },
}

function surface.classify(moduleName: string): any?
    return MODULES[moduleName]
end

function surface.all(): {[string]: any}
    local copy = {}
    for name, classification in pairs(MODULES) do
        copy[name] = classification
    end

    return copy
end

--- The classification standing between this target and a module, or nil when
--- nothing does: a module every dialect reaches, one this dialect reaches anyway, and
--- one the compiler itself supplies are all open.
local function gate(checker: any, moduleName: string): any
    local classification = MODULES[moduleName]
    if checker.opts.dialect ~= "lua51" and not (classification and classification.allDialects) then
        return nil
    end
    if classification == nil
        or classification.kind == "common"
        or classification.kind == "compiler"
        or classification.kind == "members"
    then
        return nil
    end

    return classification
end

--- Whether the target reaches a module, reporting at `at` when it does not and `at`
--- was given. One ladder for both questions, so that what is reported is exactly what
--- was answered.
local function reach(checker: any, moduleName: string, at: any?): boolean
    local classification = gate(checker, moduleName)
    if classification == nil then
        return true
    end
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if at then
            return capabilities.require(checker, classification.capability, at)
        end

        return capabilities.available(checker, classification.capability)
    end
    local selected = checker.opts.backendResolution
        and checker.opts.backendResolution.seams
        and checker.opts.backendResolution.seams[
        classification.seam
    ]
    if selected == nil and at then
        checker.diag(
            "NUPP3012",
            at,
            (
                "the `%s` dialect needs standard seam `%s` to reach module `%s`"
            ):format(checker.opts.dialect, classification.seam, moduleName),
            nil,
            {help = "select a checked backend whose exact runtime module implements the complete contract"}
        )
    end

    return selected ~= nil
end

--- Whether a target can reach a public standard module at all.
---
--- The same question `requireModule` answers by reporting, asked without reporting,
--- for a caller that has to decide what to do next rather than only what to say. A
--- module resolution is checking is one it will report about itself; asking first
--- is what keeps the report on the line that asked for the module.
function surface.reachable(checker: any, moduleName: string): boolean
    return reach(checker, moduleName, nil)
end

--- The accelerator seams a module prefers but does not need, or nil.
---
--- Reaching the module is what reaches them: a program that requires it may
--- call the member a provider would answer, and the build has to install the
--- backend the target named for that to be true. Nothing is gated on them, so
--- an accelerator no backend supplies costs a reached effect with no provider
--- behind it, which is what an optional seam is.
---
--- The caller attaches these to the requiring node rather than recording them
--- on the checker, because generation is the last word on reachability: it
--- rebuilds the effect set from the nodes that survived, and an effect no node
--- carries is one packaging is right to drop.
function surface.accelerators(moduleName: string): {string}?
    local classification = MODULES[moduleName]

    return classification and classification.accelerators or nil
end

--- Requires a module for the target, reporting at `at` what stands in the way, and
--- answers the effect a seam-supplied module carries once it is reached.
function surface.requireModule(checker: any, moduleName: string, at: any): string?
    if not reach(checker, moduleName, at) then
        return nil
    end
    local classification = gate(checker, moduleName)

    return classification and classification.kind ~= "unavailable" and classification.effect or nil
end

--- Requires the seam owning one member of a mixed standard module.
function surface.requireMember(checker: any, moduleName: string, member: string, at: any): string?
    if checker.opts.dialect ~= "lua51" then
        return nil
    end
    local facilityName = MODULE_MEMBERS[moduleName] and MODULE_MEMBERS[moduleName][member] or nil
    if not facilityName then
        return nil
    end
    local classification = FACILITIES[facilityName]
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if capabilities.require(checker, classification.capability, at) then
            local resolved = capabilities.resolve(checker.opts.dialect, checker.opts.backendResolution)
            return classification.effect or capabilities.get(resolved, classification.capability).effect
        end
        return nil
    end
    local selected = checker.opts.backendResolution
        and checker.opts.backendResolution.seams
        and checker.opts.backendResolution.seams[
        classification.seam
    ]
    if selected == nil then
        checker.diag(
            "NUPP3012",
            at,
            (
                "the `%s` dialect needs standard seam `%s` to reach `%s.%s`"
            ):format(checker.opts.dialect, classification.seam, moduleName, member),
            nil,
            {help = "select a checked backend whose exact runtime module implements the complete contract"}
        )
        return nil
    end

    return classification.effect
end

export = surface
