module nupp.compiler.standardsurface

local surface = {}

local function facility(kind: string, effect: string, allDialects: boolean?, accelerators: {string}?): any
    return {kind = kind, effect = effect, allDialects = allDialects, accelerators = accelerators}
end

local MODULES = {
    ["bit"] = facility("runtime", "runtime.bitops"),
    ["nupp.text.buffer"] = facility("runtime", "runtime.text_buffer"),
    ["nupp.codec.json.provider"] = facility("runtime", "native.json"),
    ["nupp"] = {kind = "common"},
    ["nupp.test"] = {kind = "common"},
    ["nupp.crypto"] = facility("host", "runtime.crypto"),
    ["nupp.system"] = facility("host", "runtime.system"),
    ["nupp.services"] = {kind = "common"},
    ["nupp.codec.hex"] = {kind = "common"},
    ["nupp.digest"] = facility("runtime", "runtime.bitops"),
    ["nupp.runtime.services.mac"] = {kind = "common"},
    ["nupp.runtime.services.system"] = {kind = "common"},
    ["nupp.runtime.services.digest"] = {kind = "common"},
    ["nupp.digest.internal.context"] = {kind = "common"},
    ["nupp.digest.internal.builtin"] = facility("runtime", "runtime.bitops"),
    ["nupp.digest.internal.words"] = facility("runtime", "runtime.bitops"),
    ["nupp.digest.internal.constants"] = {kind = "common"},
    ["nupp.checksum"] = facility("runtime", "runtime.bitops"),
    ["nupp.runtime.services.checksum"] = {kind = "common"},
    ["nupp.checksum.internal.builtin"] = facility("runtime", "runtime.bitops"),
    ["nupp.mac"] = facility("runtime", "runtime.bitops"),
    ["nupp.hash"] = facility("runtime", "runtime.bitops"),
    ["nupp.uuid"] = facility("runtime", "runtime.uuid"),
    ["nupp.io.storage"] = facility("host", "runtime.storage", true),
    ["nupp.bitset"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.store"] = {kind = "common"},
    ["nupp.codec.json"] = facility("runtime", "native.json"),
    ["nupp.serde"] = facility("runtime", "runtime.text_buffer"),
    ["nupp.text.utf8"] = {kind = "common"},
    ["nupp.derive"] = facility("runtime", "runtime.text_buffer"),
    ["nupp.gpu"] = facility("runtime", "runtime.gpu"),
    ["nupp.browser.gpu"] = facility("runtime", "runtime.browser_gpu"),
    ["nupp.gpu.internal"] = {kind = "common"},
    ["nupp.digest.internal.streaming"] = facility("runtime", "runtime.bitops"),
    ["nupp.gpu.layoutfacts"] = {kind = "common"},
    ["nupp.gpu.layout"] = {kind = "common"},
    ["nupp.runtime.hotreload"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.runtime.storage"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.bytes"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.ownedreader"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.scalars"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.internal.lines"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.io.http.internal.transport"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.path.provider"] = facility("host", "runtime.path_provider"),
    ["nupp.io.path.pathtext"] = {kind = "common"},
    ["nupp.io.files"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.io.http"] = facility("host", "runtime.http"),
    ["nupp.io.path"] = {kind = "common"},
    ["nupp.codec.base64"] = {kind = "common"},
    ["nupp.codec.valuebuilder"] = {kind = "common"},
    ["nupp.io.net"] = facility("host", "runtime.net"),
    ["nupp.io.process"] = facility("host", "runtime.process"),
    ["nupp.io.tls"] = facility("host", "runtime.tls"),
    ["nupp.io.uri"] = facility("runtime", "runtime.uri_provider"),
    ["nupp.io.uri.provider"] = facility("runtime", "runtime.uri_provider"),
    ["nupp.log"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.compiler.runtime.extensions"] = {kind = "compiler"},
    ["nupp.compiler.runtime.math"] = {kind = "compiler"},
    ["nupp.compiler.runtime.peg"] = facility("runtime", "native.lpeg"),
    ["nupp.compiler.runtime.reflect"] = {kind = "compiler"},
    ["nupp.mem"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.heap"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.indexed"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.sharedbytes"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.soa"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.mem.span"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.runtime.native"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.trace"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.profile.zone"] = {kind = "unavailable", capability = "cinterop"},
    ["nupp.random"] = {kind = "common"},
    ["nupp.simd"] = facility("compile", "runtime.simd"),
    ["nupp.suspension"] = {kind = "common"},
    ["nupp.tasks"] = {kind = "common"},
    ["nupp.time"] = facility("host", "runtime.time"),
    ["nupp.workers"] = facility("host", "runtime.workers"),
    ["nupp.mem.array"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.mem.pool"] = {kind = "common"},
    ["nupp.mem.arena"] = {kind = "unavailable", capability = "cstorage"},
    ["nupp.events"] = {kind = "unavailable", capability = "cstorage"},
}

local FACILITIES = {["task.deadline"] = facility("host", "runtime.time")}

local MODULE_MEMBERS = {["nupp.tasks"] = {runFor = "task.deadline",},}

function surface.classify(moduleName: string): any?
    return MODULES[moduleName]
end

function surface.all(): {[string]: any}
    local copy = {}
    for name, classification in pairs(MODULES) do
        copy[name] = classification
    end

    return copy
end

local function gate(checker: any, moduleName: string): any
    local classification = MODULES[moduleName]
    if checker.opts.dialect ~= "lua51" and not (classification and classification.allDialects) then
        return nil
    end
    if classification == nil
        or classification.kind == "common"
        or classification.kind == "compiler"
        or classification.kind == "members"
    then
        return nil
    end

    return classification
end

local function reach(checker: any, moduleName: string, at: any?): boolean
    local catalog = require("nupp.runtime.services.catalog")
    local declared, compatible = false, false
    for _, provider in ipairs(catalog.entries) do
        if provider.entry == moduleName then
            declared = true
            compatible = compatible or catalog.supports(provider, checker.opts.dialect or "luajit")
        end
    end
    if declared and not compatible then
        if at ~= nil then
            checker.diag(
                "NUPP3006",
                at,
                ("provider module %q does not support dialect %q"):format(moduleName, checker.opts.dialect)
            )
        end
        return false
    end
    local classification = gate(checker, moduleName)
    if classification == nil then
        return true
    end
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if at then
            return capabilities.require(checker, classification.capability, at)
        end

        return capabilities.available(checker, classification.capability)
    end

    return true
end

function surface.reachable(checker: any, moduleName: string): boolean
    return reach(checker, moduleName, nil)
end

function surface.accelerators(moduleName: string): {string}?
    local classification = MODULES[moduleName]

    return classification and classification.accelerators or nil
end

function surface.requireModule(checker: any, moduleName: string, at: any): string?
    if not reach(checker, moduleName, at) then
        return nil
    end
    local classification = gate(checker, moduleName)

    return classification and classification.kind ~= "unavailable" and classification.effect or nil
end

function surface.requireMember(checker: any, moduleName: string, member: string, at: any): string?
    if checker.opts.dialect ~= "lua51" then
        return nil
    end
    local facilityName = MODULE_MEMBERS[moduleName] and MODULE_MEMBERS[moduleName][member] or nil
    if not facilityName then
        return nil
    end
    local classification = FACILITIES[facilityName]
    if classification.kind == "unavailable" then
        local capabilities = require("nupp.compiler.capabilities")
        if capabilities.require(checker, classification.capability, at) then
            local resolved = capabilities.resolve(checker.opts.dialect)
            return classification.effect or capabilities.get(resolved, classification.capability).effect
        end
        return nil
    end

    return classification.effect
end

export = surface
