module nupp.compiler.aot.simdcast

local shape = require("nupp.compiler.aot.simdshape")

local cast = {}

--- The lane element types a conversion may take a vector between.
const ELEMENTS = {
    f32 = true,
    f64 = true,
    i8 = true,
    u8 = true,
    i16 = true,
    u16 = true,
    i32 = true,
    u32 = true,
    i64 = true,
    u64 = true,
}

--- A conversion preserves logical lanes at every selectable tier. A preferred
--- species therefore changes element width only into the species `widen` or
--- `narrow` derived from it, which keeps its lane count; a Fixed<N> species
--- converts to any Fixed<N>. A reinterpretation also keeps the element width.
function cast.matches(source: string, destination: string, reinterpret: boolean): boolean
    local fromFamily, from = shape.parts(source)
    local toFamily, to = shape.parts(destination)
    if fromFamily ~= "vector"
        or toFamily ~= "vector"
        or ELEMENTS[from as string] == nil
        or ELEMENTS[to as string] == nil
    then
        return false
    end
    if not shape.sameLanes(source, destination) then
        return false
    end

    return not reinterpret or (from as string):sub(2) == (to as string):sub(2)
end

export = cast
