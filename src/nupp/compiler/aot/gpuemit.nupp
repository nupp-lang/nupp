module nupp.compiler.aot.gpuemit

--[[
Metal source emission for the checked GPU map-kernel subset.

The source shader and the host binding are both consumers of `scalarIR.Program`.
Neither reparses the authored function, which keeps buffer order, element
layouts, uniform layout and entrypoint identity as one compiler-owned fact.
]]

local scalarIR = require("nupp.compiler.aot.scalar")

local gpuemit = {}

record gpuemit.Artifact
    source: string
    entrypoint: string
    readonly: {scalarIR.Param}
    writable: {scalarIR.Param}
    uniforms: {scalarIR.Param}
    uniformBytes: integer
    threads: integer

    --- The span whose length bounds the dispatch.
    countSpan: string

    --- Spans the kernel addresses by the dispatch index or a length guard
    --- promises equal, so the host binding must hold their buffers to the
    --- dispatch length. A span reached only through proved cursors is absent:
    --- its bound check travels inside the shader.
    exactCounts: {[string]: boolean}

    --- Whether declaration replacements may publish their generated nominal
    --- surfaces from a declared module.
    exportTypes: boolean?
end

const METAL_TYPE: {[string]: string} = {f32 = "float", i32 = "int", u32 = "uint", bool = "bool",}

const BINARY: {
    [string]: string
} = {
    add = "+",
    sub = "-",
    mul = "*",
    div = "/",
    mod = "%",
    lt = "<",
    le = "<=",
    gt = ">",
    ge = ">=",
    eq = "==",
    ne = "!=",
    ["and"] = "&&",
    ["or"] = "||",
    band = "&",
    bor = "|",
    bxor = "^",
    lshift = "<<",
    rshift = ">>",
    arshift = ">>",
}

const FIXED: {
    [string]: string
} = {
    f32_add = "+",
    f32_sub = "-",
    f32_mul = "*",
    f32_div = "/",
    i32_add = "+",
    i32_sub = "-",
    i32_mul = "*",
    u32_add = "+",
    u32_sub = "-",
    u32_mul = "*",
    u32_and = "&",
    u32_or = "|",
    u32_xor = "^",
    u32_shl = "<<",
    u32_shr = ">>",
}

local function identifier(value: string): string
    return (value:gsub("[^%w_]", "_"))
end

local function metalType(value: string): string?
    return value:match("^struct:(.+)$") or METAL_TYPE[value]
end

--- Emits one verified GPU program, or raises with the subset rule it violates.
--- @raises when verified IR is outside the GPU map-kernel subset
function gpuemit.program(program: scalarIR.Program): gpuemit.Artifact
    assert(program.executionTarget == "gpu", "GPU emission requires @aot(target = \"gpu\")")
    assert(program.entryMode == "kernel" and program.loop ~= nil, "GPU entry must be a map kernel")
    local loop = program.loop as scalarIR.Loop
    assert(loop.first == 1 and loop.last == loop.count, "GPU entry must dispatch one complete span")

    -- A span addressed by the dispatch index needs its length equal to the
    -- dispatch length: the loop bound proves the primary, and a length guard
    -- proves the rest host-side. A proved cursor carries its own dominating
    -- bound check into the shader, so its span may be any length.
    local exactCounts: {[string]: boolean} = {[loop.count] = true}
    for _, guard in ipairs(program.guards) do
        exactCounts[guard.left] = true
        exactCounts[guard.right] = true
    end
    local function provenSpanIndex(value: any): string
        if value.cursor ~= nil then
            return "[" .. identifier(value.cursorCName) .. "]"
        end
        assert(value.index == loop.index, "only the dispatch index or a proved cursor may address a GPU span")
        assert(
            exactCounts[value.span as string] == true,
            "a dispatch-indexed GPU span must be the loop bound or guarded equal to it: " .. tostring(value.span)
        )
        return "[dispatch_index]"
    end

    local expression: function(any): string
    expression = function(value: any): string
        local op = value.op
        if op == "local" or op == "helper_param" then
            return identifier(value.cName or value.name)
        elseif op == "uniform" then
            return "uniforms." .. identifier(value.name)
        elseif op == "load" then
            return identifier(value.span) .. provenSpanIndex(value)
        elseif op == "element_ref" then
            return "&" .. identifier(value.span) .. provenSpanIndex(value)
        elseif op == "span_count" then
            return "uniforms." .. identifier(value.span) .. "_count"
        elseif op == "int_to_f64" then
            -- Comparisons and exact-integer narrows agree between an integer
            -- register and the binary64 it widens to, so the value passes
            -- through. Binary64 arithmetic that could round is refused below.
            return expression(value.value)
        elseif op == "field_load" then
            return "(" .. expression(value.object) .. ")->" .. identifier(value.field)
        elseif op == "constant" or op == "constant_i32" then
            return value.value
        elseif op == "bool" then
            return value.value and "true" or "false"
        elseif FIXED[op] ~= nil or BINARY[op] ~= nil then
            -- An integer that passed through `int_to_f64` divides differently
            -- in an integer register than in binary64, where every 32-bit
            -- quotient is computed exactly and then rounded.
            assert(
                not ((op == "div" or op == "mod")
                    and (value.left.op == "int_to_f64" or value.right.op == "int_to_f64")),
                "GPU subset does not emit binary64 division of integers"
            )
            local token = FIXED[op] or BINARY[op]
            return "(" .. expression(value.left) .. " " .. tostring(token) .. " " .. expression(value.right) .. ")"
        elseif op == "neg" then
            return "(-" .. expression(value.value) .. ")"
        elseif op == "not" then
            return "(!" .. expression(value.value) .. ")"
        elseif op == "bnot" or op == "u32_not" then
            return "(~" .. expression(value.value) .. ")"
        elseif op == "narrow_f64_f32" then
            return "float(" .. expression(value.value) .. ")"
        elseif op == "widen_f32_f64" then
            return expression(value.value)
        elseif op == "numeric_cast" then
            local converted = metalType(value.type)
            assert(converted ~= nil, "GPU cast needs a fixed-width result")
            return (converted as string) .. "(" .. expression(value.value) .. ")"
        elseif op == "f32_sqrt" then
            return "sqrt(" .. expression(value.value) .. ")"
        end
        error("GPU subset does not emit expression " .. tostring(op), 0)
    end

    local lines: {string} = {}
    local function line(depth: integer, value: string): nil
        lines[#lines + 1] = string.rep("    ", depth) .. value
    end

    local statements: function({any}, integer): nil
    statements = function(values: {any}, depth: integer): nil
        for _, statement in ipairs(values) do
            local op = statement.op
            if op == "let" then
                local reference = statement.type:match("^ref:(.+)$")
                if reference ~= nil then
                    assert(statement.value.op == "element_ref", "GPU references must point into spans")
                    local qualifier = statement.value.mutable and "device " or "device const "
                    line(
                        depth,
                        qualifier .. reference .. "* " .. identifier(
                            statement.cName
                        ) .. " = " .. expression(statement.value) .. ";"
                    )
                else
                    local declared = metalType(statement.type)
                    assert(declared ~= nil, "GPU local must have fixed width: " .. tostring(statement.type))
                    line(
                        depth,
                        (
                            declared as string
                        ) .. " " .. identifier(statement.cName) .. " = " .. expression(statement.value) .. ";"
                    )
                end
            elseif op == "assign" then
                assert(#statement.values == 1, "GPU subset does not emit parallel assignment")
                local assignment = statement.values[1]
                local target: string
                if assignment.target.kind == "local" then
                    target = identifier(assignment.target.cName or assignment.target.name)
                elseif assignment.target.kind == "field" then
                    target = "(" .. expression(assignment.target.object) .. ")->" .. identifier(assignment.target.field)
                else
                    error("GPU subset does not emit assignment target " .. tostring(assignment.target.kind), 0)
                end
                line(depth, target .. " = " .. expression(assignment.value) .. ";")
            elseif op == "store" then
                line(
                    depth,
                    identifier(statement.span) .. provenSpanIndex(statement) .. " = "
                        .. expression(statement.value) .. ";"
                )
            elseif op == "while" then
                line(depth, "while (" .. expression(statement.condition) .. ") {")
                statements(statement.body, depth + 1)
                line(depth, "}")
            elseif op == "if" then
                for index, clause in ipairs(statement.clauses) do
                    line(depth, (index == 1 and "if (" or "else if (") .. expression(clause.condition) .. ") {")
                    statements(clause.body, depth + 1)
                    line(depth, "}")
                end
                if statement.elseBody ~= nil then
                    line(depth, "else {")
                    statements(statement.elseBody, depth + 1)
                    line(depth, "}")
                end
            elseif op == "break" or op == "continue" then
                line(depth, op .. ";")
            elseif op == "block" then
                line(depth, "{")
                statements(statement.body, depth + 1)
                line(depth, "}")
            else
                error("GPU subset does not emit statement " .. tostring(op), 0)
            end
        end
    end

    local readonly: {scalarIR.Param} = {}
    local writable: {scalarIR.Param} = {}
    local uniforms: {scalarIR.Param} = {}
    for _, param in ipairs(program.params) do
        if param.kind == "read_span" then
            assert(metalType(param.type) ~= nil, "GPU span must have fixed-width elements")
            readonly[#readonly + 1] = param
        elseif param.kind == "write_span" then
            assert(metalType(param.type) ~= nil, "GPU span must have fixed-width elements")
            writable[#writable + 1] = param
        elseif param.kind == "uniform" then
            assert(param.type ~= "bool", "GPU boolean uniforms are not yet supported")
            assert(metalType(param.type) ~= nil, "GPU uniform must have fixed width")
            uniforms[#uniforms + 1] = param
        else
            error("GPU subset does not admit scalar ABI parameters", 0)
        end
    end
    assert(#writable >= 1, "GPU kernels require a writable span")

    -- Every span's length rides in the uniform block, in binding order, so an
    -- in-body `#span` bound check compares against the same count the host
    -- validated. The dispatch bound comes first, then span counts, then the
    -- authored scalars.
    local spans: {scalarIR.Param} = {}
    for _, param in ipairs(readonly) do
        spans[#spans + 1] = param
    end
    for _, param in ipairs(writable) do
        spans[#spans + 1] = param
    end
    for _, param in ipairs(uniforms) do
        for _, span in ipairs(spans) do
            assert(
                param.name ~= span.name .. "_count",
                "GPU uniform name collides with a span count: " .. param.name
            )
        end
    end
    local uniformBytes = 4 * (1 + #spans + #uniforms)
    assert(uniformBytes <= 128, "GPU uniform block exceeds 128 bytes")

    line(0, "#include <metal_stdlib>")
    line(0, "using namespace metal;")
    line(0, "#pragma clang fp contract(off)")
    line(0, "")
    for _, layout in ipairs(program.layouts or {}) do
        line(0, "struct " .. identifier(layout.name) .. " {")
        for _, field in ipairs(layout.fields) do
            local declared = metalType(field.type)
            assert(declared ~= nil, "GPU struct field must have fixed width")
            line(1, (declared as string) .. " " .. identifier(field.name) .. ";")
        end
        line(0, "};")
        line(0, "")
    end
    line(0, "struct NuppUniforms {")
    line(1, "uint count;")
    for _, param in ipairs(spans) do
        line(1, "uint " .. identifier(param.name) .. "_count;")
    end
    for _, param in ipairs(uniforms) do
        line(1, tostring(metalType(param.type)) .. " " .. identifier(param.name) .. ";")
    end
    line(0, "};")
    line(0, "")
    line(0, "kernel void " .. identifier(program.symbol) .. "_gpu(")
    local arguments: {string} = {"constant NuppUniforms& uniforms [[buffer(0)]]"}
    local at = 1
    for _, param in ipairs(readonly) do
        arguments[
            #arguments + 1
        ] = "device const " .. tostring(
            metalType(param.type)
        ) .. "* " .. identifier(param.name) .. " [[buffer(" .. tostring(at) .. ")]]"
        at = at + 1
    end
    for _, param in ipairs(writable) do
        arguments[
            #arguments + 1
        ] = "device " .. tostring(
            metalType(param.type)
        ) .. "* " .. identifier(param.name) .. " [[buffer(" .. tostring(at) .. ")]]"
        at = at + 1
    end
    arguments[#arguments + 1] = "uint dispatch_index [[thread_position_in_grid]]"
    for index, argument in ipairs(arguments) do
        line(1, argument .. (index < #arguments and "," or ""))
    end
    line(0, ") {")
    line(1, "if (dispatch_index >= uniforms.count) return;")
    statements(loop.statements, 1)
    line(0, "}")

    return new gpuemit.Artifact(
        source = table.concat(lines, "\n") .. "\n",
        entrypoint = identifier(program.symbol) .. "_gpu",
        readonly = readonly,
        writable = writable,
        uniforms = uniforms,
        uniformBytes = uniformBytes,
        threads = 256,
        countSpan = loop.count,
        exactCounts = exactCounts
    )
end

export = gpuemit
