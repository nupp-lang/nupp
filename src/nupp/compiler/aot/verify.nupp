module nupp.compiler.aot.verify

--[[
What makes AOT IR well formed.

Generated C is a backend representation and not the safety boundary. Every span
access, region relationship, conversion, and lane operation has to exist here,
verified, before anything is emitted -- so a rewrite that produced something this
rejects is a compiler bug caught before it becomes a miscompilation, and the
spike's own tests deliberately corrupt IR to prove these rules fire.

Four rules do most of the work and are worth stating separately from the code.

An index is the loop counter or it is refused. Every load, every store, every
element reference names `loop.index` and nothing else, which is the whole of the
licence to run several iterations at once and the whole of the argument that a
span access is in bounds.

A width changes only at a conversion. `float`, `int32` and `uint32` are storage
and establishment facts, so an operator never quietly rounds one; a narrowing
that is not written down is one that cannot happen.

A lane operation names its own vector type -- `vadd.f64x4`, `vlt.f32x8` -- so
there is no operation whose operand width has to be inferred. A mismatched pair
is a malformed opcode rather than a check somebody has to remember to write.

A gang names the vectors it uses, and membership is checked against that gang
rather than against a list of every width the backend knows. A vector one shape
admits is not silently valid in another, which is what keeps a binary64 value
from entering a 32-bit gang that would change its answers.
]]

local admit = require("nupp.compiler.aot.admit")
local effects = require("nupp.compiler.aot.effects")
local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")
local visit = require("nupp.compiler.aot.visit")

local verify = {}

----------------------------------------------------------------------------
-- What a rule is verified against
----------------------------------------------------------------------------

--- What every rule needs to know about the function being verified.
---
--- Passed rather than reached for, so a rule cannot quietly depend on more of
--- the program than it says it does.
record verify.Scope
    --- Span and uniform parameters by name.
    spans: {[string]: scalarIR.Param}

    --- Reified struct layouts by name.
    layouts: {[string]: scalarIR.Layout}

    --- Visible pure helpers by name.
    helpers: {[string]: scalarIR.Helper}

    --- Which spans may be written, which follows from which were declared
    --- exclusive.
    writes: {[string]: boolean}

    --- The loop counter currently proving an access, and the span whose count
    --- bounds it. A legacy map loop sets `mapIndex`, because its wrapper proved
    --- every span has the primary output's count.
    index: string?

    boundSpan: string?
    mapIndex: boolean?

    --- Spans a map loop's index provably addresses: the loop bound and every
    --- span a length guard holds to its count. A GPU program may leave a span
    --- out of its guard when the body only reaches it through proved cursors,
    --- so an index access is only sound against this set.
    indexSpans: {[string]: boolean}?

    --- Zero-based uint32 cursors authorized by dominating count checks.
    cursorBounds: {[string]: string}

    resultTypes: {scalarIR.Type}

    entryMode: scalarIR.EntryMode

    builderMode: ('eager' | 'pull' | 'serde')?

    workgroup: boolean?
    inPhase: boolean?
    shared: {[string]: scalarIR.Type}?
    sharedCounts: {[string]: integer}?
    localReadLimit: integer?
    localReadMinimum: integer?
end

--- What the lane rules need beyond the scope.
record verify.Context
    --- The gang this body was lowered to.
    shape: lane.Shape

    scope: verify.Scope

    --- What the gang admits, derived from `shape` once for the whole body
    --- rather than again at every expression.
    admitted: {[string]: boolean}

    binaries: {[string]: any}

    unaries: {[string]: any}
end

--- A scope for a nested block: this one, with `overrides` applied.
---
--- Every nested block sees what its parent saw except for the few facts the
--- construct changes -- what proves an index, which cursors are bounded, how
--- far a workgroup's local index may read. Written once so a field added to
--- the scope reaches every nested block rather than the ones somebody
--- remembered to copy it into.
local function derive(scope: verify.Scope, overrides: {[string]: any}): verify.Scope
    local nested = new verify.Scope(
        spans = scope.spans,
        layouts = scope.layouts,
        helpers = scope.helpers,
        writes = scope.writes,
        index = scope.index,
        boundSpan = scope.boundSpan,
        mapIndex = scope.mapIndex,
        indexSpans = scope.indexSpans,
        cursorBounds = scope.cursorBounds,
        resultTypes = scope.resultTypes,
        entryMode = scope.entryMode,
        builderMode = scope.builderMode,
        workgroup = scope.workgroup,
        inPhase = scope.inPhase,
        shared = scope.shared,
        sharedCounts = scope.sharedCounts,
        localReadLimit = scope.localReadLimit,
        localReadMinimum = scope.localReadMinimum
    )
    for field, value in pairs(overrides) do
        (nested as any)[field] = value
    end

    return nested
end

----------------------------------------------------------------------------
-- Refusing
----------------------------------------------------------------------------

--- Reports IR that cannot mean anything.
---
--- Raised rather than returned: reaching one is a compiler bug and there is no
--- partial answer worth carrying on with.
---
--- @raises always, with what was wrong
local function refuse(why: string): nil
    error(why, 0)
end

--- Asserts one rule.
---
--- @raises when the rule does not hold
local function holds(condition: boolean, why: string): nil
    if not condition then
        refuse(why)
    end
end

--- Asserts one rule about lane IR, which names itself in the report.
local function laneHolds(condition: boolean, why: string): nil
    holds(condition, "invalid lane IR: " .. why)
end

----------------------------------------------------------------------------
-- The opcode vocabulary
----------------------------------------------------------------------------

--- The types an arithmetic comparison may relate.
const verify.NUMERIC = {["f64"] = true, ["f32"] = true, ["i32"] = true, ["u32"] = true, ["i64"] = true, ["u64"] = true}

local function storageSource(valueType: string, sourceType: string?): string
    return sourceType or tostring(admit.CANONICAL_SOURCE[valueType])
end

local function validStorage(valueType: string, sourceType: string?): boolean
    return admit.STORAGE[storageSource(valueType, sourceType)] == valueType
end

--- The arity of each bitwise verb. `not` is the only unary one.
const verify.BITWISE_ARITY = {["and"] = 2, ["or"] = 2, ["xor"] = 2, ["shl"] = 2, ["shr"] = 2, ["sar"] = 2, ["not"] = 1,}

--- The correcting binary32 helpers, and how many operands each takes.
const verify.CORRECTED_ARITY = {["nupp_f32_min"] = 2, ["nupp_f32_max"] = 2, ["nupp_f32_fma"] = 3,}

--- The element each explicitly fixed-width binary operation works in.
const verify.FIXED_BINARY = {
    ["f32_add"] = "f32",
    ["f32_sub"] = "f32",
    ["f32_mul"] = "f32",
    ["f32_div"] = "f32",
    ["i32_add"] = "i32",
    ["i32_sub"] = "i32",
    ["i32_mul"] = "i32",
    ["u32_add"] = "u32",
    ["u32_sub"] = "u32",
    ["u32_mul"] = "u32",
    ["u32_div"] = "u32",
    ["u32_mod"] = "u32",
    ["u32_and"] = "u32",
    ["u32_or"] = "u32",
    ["u32_xor"] = "u32",
    ["u32_shl"] = "u32",
    ["u32_shr"] = "u32",
    ["u64_add"] = "u64",
    ["u64_sub"] = "u64",
    ["u64_mul"] = "u64",
    ["i64_add"] = "i64",
    ["i64_sub"] = "i64",
    ["i64_mul"] = "i64",
}

--- The opcodes that convert between representations, which is where -- and
--- only where -- a width changes.
const verify.CONVERSIONS = {
    ["narrow_f64_f32"] = true,
    ["widen_f32_f64"] = true,
    ["int_to_f64"] = true,
    ["numeric_cast"] = true,
    ["f16_to_f32"] = true,
    ["f32_to_f16"] = true,
    ["bf16_to_f32"] = true,
    ["f32_to_bf16"] = true,
}

--- Every binary64 operation, comparison, and bitwise operation.
const verify.BINARY_OPCODES = {
    ["add"] = true,
    ["sub"] = true,
    ["mul"] = true,
    ["div"] = true,
    ["mod"] = true,
    ["pow"] = true,
    ["band"] = true,
    ["bor"] = true,
    ["bxor"] = true,
    ["lshift"] = true,
    ["rshift"] = true,
    ["arshift"] = true,
    ["lt"] = true,
    ["le"] = true,
    ["gt"] = true,
    ["ge"] = true,
    ["eq"] = true,
    ["ne"] = true,
    ["and"] = true,
    ["or"] = true,
}

--- The element and arity of each corrected binary32 operation.
const verify.FIXED_CORRECTED = {
    ["f32_min"] = {element = "f32", arity = 2},
    ["f32_max"] = {element = "f32", arity = 2},
    ["f32_fma"] = {element = "f32", arity = 3},
}

--- The closed math set a body may call, by name: exactly what `admit` reads a
--- call into, so the verifier cannot admit a call the lowerer never makes.
---
--- One table for both halves, because a lane math operation is emitted as one
--- scalar call per lane: anything the scalar rules admit is admissible in lanes
--- by construction, and a second list would only be a chance for the two to
--- disagree.
local MATH: {[string]: boolean} = (function(): {[string]: boolean}
    local names: {[string]: boolean} = {}
    for _, entry in pairs(admit.MATH) do
        names[entry.name] = true
    end

    return names
end)()

--- Every lane opcode this vocabulary knows, beside the arithmetic and
--- comparison ones a shape generates.
const verify.LANE_OPCODES = {
    ["local"] = true,
    ["vsplat"] = true,
    ["vbool_splat"] = true,
    ["vfield_load"] = true,
    ["vspan_load"] = true,
    ["vmask"] = true,
    ["vshort"] = true,
    ["vselect"] = true,
    ["vmath"] = true,
    ["vcorrected"] = true,
    ["vbinary"] = true,
    ["vunary"] = true,
    ["vbitwise"] = true,
    ["vbits"] = true,
    ["vround"] = true,
    ["vconvert"] = true,
    ["vmask_cast"] = true,
}

--- The two halves of one walk, declared before either is written. They are
--- local because the lane half calls the scalar one: a module function has to
--- carry its types where it is defined, which a mutually recursive pair cannot
--- do for the other.
local scalarWalk: function(scalarIR.Expr, {[string]: string}, verify.Scope): nil

local laneWalk: function(lane.Expr, {[string]: string}, verify.Context): nil

----------------------------------------------------------------------------
-- Expressions
----------------------------------------------------------------------------

local bitOperand = admit.bitOperand

--- Whether a direct read at `index` is proved by a cursor: the index is that
--- very cursor local -- by name and by the C name the emitter addresses -- the
--- cursor is a uint32, and a dominating check bounded it against `root`.
---
--- One rule for every read that names a cursor, so the scratch read and the
--- rooted byte read cannot come to require different proofs.
local function cursorRead(
    index: scalarIR.Expr,
    cursor: string?,
    cursorCName: string?,
    root: string,
    values: {[string]: string},
    scope: verify.Scope
): boolean
    if cursor == nil or cursorCName == nil or index.op ~= "local" then
        return false
    end
    local named = index as scalarIR.Name

    return named.name == cursor and named.cName == cursorCName and values[
        cursor as string
    ] == "u32" and scope.cursorBounds[cursor as string] == root
end

--- The prefix a fixed word buffer's width is recorded under, in the same map
--- the binding is. A local's name cannot contain a space, so nothing else can
--- be written here.
const FIXED_WIDTH = "fixed width "

const SCRATCH_LENGTH = "scratch length "

--- The `values` key under which a uint32 local initialized from one rooted
--- string's length remembers that string. Kept in `values` beside the binding,
--- as `SCRATCH_LENGTH` is, so the fact is established by the `let` the verifier
--- saw and retired by the assignment that changes the local -- rather than read
--- off a `Name`'s own metadata, which a lowerer could carry into a scope where
--- it no longer holds.
const LENGTH_OF = "length of "

local function scratchLengthSource(value: scalarIR.Expr, values: {[string]: string}): string?
    if value.op == "lua_scratch_u32_length" or value.op == "lua_scratch_u32_escape_length" then
        return ((value as scalarIR.LuaScratchU32Length).scratch as scalarIR.Name).name
    elseif value.op == "lua_scratch_u32_append_bits"
        or value.op == "lua_scratch_u32_append_bits_eager"
        or value.op == "lua_scratch_u32_append_string_bits"
    then
        return ((value as any).scratch as scalarIR.Name).name
    elseif value.op == "local" then
        return values[SCRATCH_LENGTH .. (value as scalarIR.Name).name]
    elseif value.op == "u32_and" then
        local pair = value as scalarIR.Fixed
        local function mask(other: scalarIR.Expr): boolean
            return other.op == "constant_i32" and tonumber((other as scalarIR.IntConstant).value) == 0x7fffffff
        end

        if mask(pair.right) then
            return scratchLengthSource(pair.left, values)
        elseif mask(pair.left) then
            return scratchLengthSource(pair.right, values)
        end
    end

    return nil
end

--- Whether an access's bound is the one its buffer was declared with.
---
--- The emitter writes this bound as a literal, so it is what the generated C
--- refuses an index against. If it were ever some other buffer's width the
--- check would pass indexes past the end of the one being read, so the two are
--- compared here rather than assumed to have been kept in step. Both absent is
--- the appending buffer, which is checked against a length instead.
local function fixedWidthAgrees(bound: integer?, values: {[string]: string}, name: string?): boolean
    local declared = name ~= nil and values[FIXED_WIDTH .. name] or nil
    if bound == nil then
        return declared == nil
    end

    return declared == tostring(bound)
end

--- Checks a conversion, which is the only place a width changes.
local function convert(node: scalarIR.Convert, values: {[string]: string}, scope: verify.Scope): nil
    local from = node.value.type
    if node.op == "narrow_f64_f32" then
        holds(node.type == "f32" and from == "f64", "invalid narrowing conversion")
    elseif node.op == "widen_f32_f64" then
        holds(node.type == "f64" and from == "f32", "invalid widening conversion")
    elseif node.op == "int_to_f64" then
        holds(
            node.type == "f64" and (from == "i32" or from == "u32" or from == "i64" or from == "u64"),
            "invalid integer promotion"
        )
    elseif node.op == "f16_to_f32" then
        holds(node.type == "f32" and from == "u32", "invalid binary16 load conversion")
    elseif node.op == "f32_to_f16" then
        holds(node.type == "u32" and from == "f32", "invalid binary16 store conversion")
    elseif node.op == "bf16_to_f32" then
        holds(node.type == "f32" and from == "u32", "invalid bfloat16 load conversion")
    elseif node.op == "f32_to_bf16" then
        holds(node.type == "u32" and from == "f32", "invalid bfloat16 store conversion")
    else
        holds(
            (
                node.type == "i32" or node.type == "u32" or node.type == "i64" or node.type == "u64"
            ) and (from == "f64" or from == "i32" or from == "u32" or from == "i64" or from == "u64"),
            "invalid numeric cast"
        )
    end
    scalarWalk(node.value, values, scope)
end

--- Checks a read of one scalar element.
local function load(node: scalarIR.Load, values: {[string]: string}, scope: verify.Scope): nil
    local root = scope.spans[node.span]
    holds(root ~= nil, "invalid load root")

    local span = root as scalarIR.Param
    holds(
        (
            span.kind == "read_span" or span.kind == "write_span"
        ) and node.type == span.type and node.sourceType == span.sourceType and node.type:match("^struct:") == nil,
        "invalid load root"
    )
    if node.cursor ~= nil then
        holds(
            node.index == "" and values[
                node.cursor as string
            ] == "u32" and scope.cursorBounds[node.cursor as string] == node.span and node.cursorCName ~= nil,
            "unbounded cursor load"
        )
    else
        holds(
            node.index == scope.index and (
                scope.mapIndex == true and (
                    scope.indexSpans as {[string]: boolean}
                )[node.span] == true or node.span == scope.boundSpan
            ),
            "unbounded load index"
        )
    end
end

--- Checks a pointer to one struct element.
---
--- Whether it may be written is not this expression's claim to make: it follows
--- from whether the span was declared exclusive, and disagreeing with that is
--- how a shared borrow would become a write.
local function elementRef(node: scalarIR.ElementRef, values: {[string]: string}, scope: verify.Scope): nil
    local root = scope.spans[node.span]
    local layoutName = node.type:match("^ref:(.+)$")
    holds(root ~= nil and layoutName ~= nil, "invalid struct element root")

    local span = root as scalarIR.Param
    holds(
        span.type == "struct:" .. tostring(layoutName) and scope.layouts[tostring(layoutName)] ~= nil,
        "invalid struct element root"
    )
    local bounded = node.cursor ~= nil and node.index == "" and values[
        node.cursor as string
    ] == "u32" and scope.cursorBounds[
        node.cursor as string
    ] == node.span and node.cursorCName ~= nil or node.cursor == nil and node.index == scope.index and (
        scope.mapIndex == true and (
            scope.indexSpans as {[string]: boolean}
        )[node.span] == true or node.span == scope.boundSpan
    )
    holds(node.mutable == (span.kind == "write_span") and bounded, "invalid struct element access")
end

--- Checks a corrected binary32 operation, whose operands live in `args` or in
--- `left` and `right` depending on how many there are.
local function corrected(node: scalarIR.Corrected, values: {[string]: string}, scope: verify.Scope): nil
    local rule = verify.FIXED_CORRECTED[tostring(node.op)]
    local element = rule.element
    if rule.arity == 3 then
        local args = node.args or {}
        holds(node.type == element and #args == 3, "invalid fused operation")
        for _, argument in ipairs(args) do
            holds(argument.type == element, "invalid fused operand")
            scalarWalk(argument, values, scope)
        end

        return
    end

    local left, right = node.left, node.right
    holds(
        node.type == element and left ~= nil and left.type == element and right ~= nil and right.type == element,
        "invalid corrected binary operation"
    )
    scalarWalk(left as scalarIR.Expr, values, scope)
    scalarWalk(right as scalarIR.Expr, values, scope)
end

--- Checks one binary64 operation, comparison, or bitwise operation.
local function binary(node: scalarIR.Binary, values: {[string]: string}, scope: verify.Scope): nil
    local op = node.op
    if op == "add" or op == "sub" or op == "mul" or op == "div" or op == "mod" or op == "pow" then
        holds(node.type == "f64" and node.left.type == "f64" and node.right.type == "f64", "invalid arithmetic")
    elseif op == "band" or op == "bor" or op == "bxor" or op == "lshift" or op == "rshift" or op == "arshift" then
        holds(node.type == "i32" and bitOperand(node.left) and bitOperand(node.right), "invalid bitwise operation")
    elseif op == "lt" or op == "le" or op == "gt" or op == "ge" or op == "eq" or op == "ne" then
        local mixed = verify.NUMERIC[node.left.type] == true and verify.NUMERIC[node.right.type] == true
        holds(node.type == "bool" and (node.left.type == node.right.type or mixed), "invalid comparison")
    else
        holds(
            node.type == "bool" and node.left.type == "bool" and node.right.type == "bool",
            "invalid boolean operation"
        )
    end
    scalarWalk(node.left, values, scope)
    local rightScope = scope
    if (op == "and" or op == "or") and (node.left.op == "lt" or node.left.op == "ge") then
        local comparison = node.left as scalarIR.Binary
        local cursor = comparison.left.op == "local" and (comparison.left as scalarIR.Name).name or nil
        local scratch = comparison.right.op == "local" and scratchLengthSource(comparison.right, values) or nil
        if cursor ~= nil and scratch ~= nil and (
            op == "and" and node.left.op == "lt" or op == "or" and node.left.op == "ge"
        ) then
            local cursorBounds: {[string]: string} = {}
            for name, root in pairs(scope.cursorBounds) do
                cursorBounds[name] = root
            end
            cursorBounds[cursor as string] = scratch as string
            rightScope = derive(scope, {cursorBounds = cursorBounds})
        end
    end
    scalarWalk(node.right, values, rightScope)
end

scalarWalk = function(node: scalarIR.Expr, values: {[string]: string}, scope: verify.Scope): nil
    holds(node ~= nil and node.type ~= nil, "untyped IR expression")

    -- Several operations share one record, so a branch that admits a family
    -- names the record its opcodes all denote. A single-tag branch narrows on
    -- its own and says nothing extra.
    local op = node.op
    if verify.CONVERSIONS[tostring(op)] == true then
        convert(node as scalarIR.Convert, values, scope)
    elseif op == "load" then
        load(node, values, scope)
    elseif op == "element_ref" then
        elementRef(node, values, scope)
    elseif op == "field_load" then
        local layout = scope.layouts[node.layout]
        holds(
            layout ~= nil and (
                layout.fieldTypes or {}
            )[
                node.field
            ] == node.type and (layout.fieldSourceTypes or {})[node.field] == storageSource(node.type, node.sourceType),
            "invalid struct field load"
        )
        scalarWalk(node.object, values, scope)
    elseif op == "uniform" then
        local param = scope.spans[node.name]
        holds(param ~= nil, "invalid uniform")
        holds(
            (param as scalarIR.Param).kind == "uniform" and node.type == (param as scalarIR.Param).type,
            "invalid uniform"
        )
    elseif op == "span_count" then
        local span = scope.spans[node.span]
        holds(span ~= nil and (span as scalarIR.Param).region ~= nil and node.type == "f64", "invalid span count")
    elseif op == "loop_index" then
        holds(scope.mapIndex == true and node.type == "f64", "loop index outside a map body")
    elseif op == "workgroup_index" or op == "local_index" then
        holds(
            scope.workgroup == true and node.type == "u32" and (op ~= "local_index" or scope.inPhase == true),
            "workgroup coordinate outside its structural body"
        )
    elseif op == "shared_load" then
        local load = node as scalarIR.SharedLoad
        local shared = scope.shared or {}
        local counts = scope.sharedCounts or {}
        holds(
            scope.workgroup == true and scope.inPhase == true and shared[load.shared] == load.type,
            "invalid workgroup scratch read"
        )
        holds(load.index.type == "u32", "workgroup scratch index is not uint32")
        local function indexRange(value: scalarIR.Expr): (number?, number?)
            local operation = value.op
            if operation == "constant" or operation == "constant_i32" then
                local constant = tonumber((value as any).value)
                if constant ~= nil and constant == math.floor(constant as number) and constant >= 0 then
                    return constant, constant
                end
            elseif operation == "local_index" then
                local count = counts[load.shared]
                if count ~= nil then
                    return 0, count - 1
                end
            elseif operation == "numeric_cast" or operation == "int_to_f64" then
                return indexRange((value as scalarIR.Convert).value)
            elseif operation == "u32_add" or operation == "u32_mul" then
                local pair = value as scalarIR.Fixed
                local leftMin, leftMax = indexRange(pair.left)
                local rightMin, rightMax = indexRange(pair.right)
                if leftMin ~= nil and leftMax ~= nil and rightMin ~= nil and rightMax ~= nil then
                    local low = operation == "u32_add" and (
                        leftMin as number
                    ) + (rightMin as number) or (leftMin as number) * (rightMin as number)
                    local high = operation == "u32_add" and (
                        leftMax as number
                    ) + (rightMax as number) or (leftMax as number) * (rightMax as number)
                    if high <= 4294967295 then
                        return low, high
                    end
                end
            elseif operation == "u32_div" or operation == "u32_mod" then
                local pair = value as scalarIR.Fixed
                local leftMin, leftMax = indexRange(pair.left)
                local rightMin, rightMax = indexRange(pair.right)
                if leftMin ~= nil and leftMax ~= nil and rightMin ~= nil and rightMin == rightMax and rightMin > 0 then
                    if operation == "u32_div" then
                        return math.floor(
                            (leftMin as number) / (rightMin as number)
                        ), math.floor((leftMax as number) / (rightMin as number))
                    end
                    return 0, math.min(leftMax as number, (rightMin as number) - 1)
                end
            end

            return nil, nil
        end

        local minimum, maximum = indexRange(load.index)
        local constant = load.index.op == "constant_i32" and tonumber((load.index as scalarIR.IntConstant).value) or nil
        local offset: number? = nil
        local back: number? = nil
        if load.index.op == "u32_add" then
            local added = load.index as scalarIR.Fixed
            if added.left.op == "local_index" and added.right.op == "constant_i32" then
                offset = tonumber((added.right as scalarIR.IntConstant).value)
            end
        elseif load.index.op == "u32_sub" then
            local subtracted = load.index as scalarIR.Fixed
            if subtracted.left.op == "local_index" and subtracted.right.op == "constant_i32" then
                back = tonumber((subtracted.right as scalarIR.IntConstant).value)
            end
        end
        holds(
            load.index.op == "local_index" or constant ~= nil and constant >= 0 and constant < counts[
                load.shared
            ] or minimum ~= nil and maximum ~= nil and minimum >= 0 and maximum < counts[
                load.shared
            ] or offset ~= nil and scope.localReadLimit ~= nil and offset >= 0 and (
                scope.localReadLimit as integer
            ) + offset <= counts[
                load.shared
            ] or back ~= nil and scope.localReadMinimum ~= nil and back >= 0 and (
                scope.localReadMinimum as integer
            ) >= back,
            "workgroup scratch read is not proved in bounds"
        )
        scalarWalk(load.index, values, scope)
    elseif op == "local" or op == "helper_param" then
        local named = node as scalarIR.Name
        holds(values[named.name] == node.type, "invalid local value")
        if named.lengthOf ~= nil then
            local bytes = scope.spans[named.lengthOf as string]
            holds(
                bytes ~= nil and (
                    (bytes as scalarIR.Param).type == "lua_string" or (bytes as scalarIR.Param).type == "lua_bytes"
                ) and values[LENGTH_OF .. named.name] == named.lengthOf,
                "invalid rooted length alias"
            )
        end
    elseif tostring(op):match("^simd_") ~= nil then
        local simd = node as scalarIR.Simd
        local args = simd.args
        local signatures = {
            simd_species_u8 = {result = "simd_species_u8", operands = {}},
            simd_lanes = {result = "u32", operands = {"simd_species_u8"}},
            simd_load_u8 = {result = "simd_vector_u8", operands = {"simd_species_u8", "u32"}},
            simd_load_string_u8 = {result = "simd_vector_u8", operands = {"simd_species_u8", "lua_string", "u32"},},
            simd_load_stride3_u8 = {
                result = "simd_vector_u8",
                operands = {"simd_species_u8", "lua_string", "u32", "u32"},
            },
            simd_splat_u8 = {result = "simd_vector_u8", operands = {"simd_species_u8", "u32"}},
            simd_shr_u8 = {result = "simd_vector_u8", operands = {"simd_vector_u8", "u32"}},
            simd_shl_u8 = {result = "simd_vector_u8", operands = {"simd_vector_u8", "u32"}},
            simd_table_u8x16 = {
                result = "simd_table_u8x16",
                operands = {
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32",
                    "u32"
                },
            },
            simd_lookup16_u8 = {result = "simd_vector_u8", operands = {"simd_vector_u8", "simd_table_u8x16"}},
            simd_lookup64_u8 = {
                result = "simd_vector_u8",
                operands = {
                    "simd_vector_u8",
                    "simd_table_u8x16",
                    "simd_table_u8x16",
                    "simd_table_u8x16",
                    "simd_table_u8x16"
                }
            },
            simd_align_bytes_u8 = {result = "simd_vector_u8", operands = {"simd_vector_u8", "simd_vector_u8", "u32"}},
            simd_padded_string_u8 = {result = "simd_padded_string_u8", operands = {"lua_string"}},
            simd_padded_length = {result = "u32", operands = {"simd_padded_string_u8"}},
            simd_padded_full_length = {result = "u32", operands = {"simd_padded_string_u8"}},
            simd_padded_tail_length = {result = "u32", operands = {"simd_padded_string_u8"}},
            simd_padded_load_full_u8 = {result = "simd_vector_u8", operands = {"simd_padded_string_u8", "u32"}},
            simd_padded_load_tail_u8 = {result = "simd_vector_u8", operands = {"simd_padded_string_u8"}},
            simd_block64_load_u8 = {result = "simd_block_u8x64", operands = {"simd_padded_string_u8", "u32"}},
            simd_block64_and_byte_u8 = {result = "simd_block_u8x64", operands = {"simd_block_u8x64", "u32"}},
            simd_block64_and_u8 = {result = "simd_block_u8x64", operands = {"simd_block_u8x64", "simd_block_u8x64"},},
            simd_block64_shr_u8 = {result = "simd_block_u8x64", operands = {"simd_block_u8x64", "u32"}},
            simd_block64_lookup16_u8 = {
                result = "simd_block_u8x64",
                operands = {"simd_block_u8x64", "simd_table_u8x16"},
            },
            simd_block64_any_bits_u8 = {result = "simd_mask_bits64", operands = {"simd_block_u8x64", "u32"}},
            simd_block64_last_u8 = {result = "simd_vector_u8", operands = {"simd_block_u8x64"}},
            simd_block64_utf8_errors_u8 = {
                result = "simd_mask_bits64",
                operands = {
                    "simd_block_u8x64",
                    "simd_vector_u8",
                    "simd_table_u8x16",
                    "simd_table_u8x16",
                    "simd_table_u8x16",
                },
            },
            simd_block64_eq_u8 = {result = "simd_mask_bits64", operands = {"simd_block_u8x64", "u32"}},
            simd_block64_eq_any6_u8 = {
                result = "simd_mask_bits64",
                operands = {"simd_block_u8x64", "u32", "u32", "u32", "u32", "u32", "u32"},
            },
            simd_block64_range_u8 = {result = "simd_mask_bits64", operands = {"simd_block_u8x64", "u32", "u32"},},
            simd_block64_outside_range_u8 = {
                result = "simd_mask_bits64",
                operands = {"simd_block_u8x64", "u32", "u32"},
            },
            simd_tail_u8 = {result = "simd_mask_u8", operands = {"simd_species_u8", "u32"}},
            simd_eq_u8 = {result = "simd_mask_u8", operands = {"simd_vector_u8", "u32"}},
            simd_range_u8 = {result = "simd_mask_u8", operands = {"simd_vector_u8", "u32", "u32"}},
            simd_vec_and = {result = "simd_vector_u8", operands = {"simd_vector_u8", "simd_vector_u8"}},
            simd_vec_or = {result = "simd_vector_u8", operands = {"simd_vector_u8", "simd_vector_u8"}},
            simd_vec_xor = {result = "simd_vector_u8", operands = {"simd_vector_u8", "simd_vector_u8"}},
            simd_vec_not = {result = "simd_vector_u8", operands = {"simd_vector_u8"}},
            simd_mask_and = {result = "simd_mask_u8", operands = {"simd_mask_u8", "simd_mask_u8"}},
            simd_mask_or = {result = "simd_mask_u8", operands = {"simd_mask_u8", "simd_mask_u8"}},
            simd_mask_xor = {result = "simd_mask_u8", operands = {"simd_mask_u8", "simd_mask_u8"}},
            simd_mask_not = {result = "simd_mask_u8", operands = {"simd_mask_u8"}},
            simd_select_u8 = {
                result = "simd_vector_u8",
                operands = {"simd_mask_u8", "simd_vector_u8", "simd_vector_u8"},
            },
            simd_any = {result = "bool", operands = {"simd_mask_u8"}},
            simd_all = {result = "bool", operands = {"simd_mask_u8"}},
            simd_count = {result = "u32", operands = {"simd_mask_u8"}},
            simd_bits = {result = "u32", operands = {"simd_mask_u8"}},
            simd_mask64 = {result = "simd_mask_bits64", operands = {"u32", "u32"}},
            simd_mask64_and = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "simd_mask_bits64"}},
            simd_mask64_or = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "simd_mask_bits64"}},
            simd_mask64_xor = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "simd_mask_bits64"}},
            simd_mask64_add = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "simd_mask_bits64"}},
            simd_mask64_not = {result = "simd_mask_bits64", operands = {"simd_mask_bits64"}},
            simd_mask64_shl = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "u32"}},
            simd_mask64_shr = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "u32"}},
            simd_mask64_prefix_xor = {result = "simd_mask_bits64", operands = {"simd_mask_bits64", "bool"}},
            simd_mask64_low = {result = "u32", operands = {"simd_mask_bits64"}},
            simd_mask64_high = {result = "u32", operands = {"simd_mask_bits64"}},
            simd_mask64_any = {result = "bool", operands = {"simd_mask_bits64"}},
            simd_mask64_count = {result = "u32", operands = {"simd_mask_bits64"}},
            simd_mask64_first = {result = "u32", operands = {"simd_mask_bits64"}},
            simd_mask64_clear_first = {result = "simd_mask_bits64", operands = {"simd_mask_bits64"}},
        }
        local signature = signatures[tostring(op)]
        holds(
            signature ~= nil and node.type == signature.result and #args == #signature.operands,
            "invalid SIMD operation"
        )
        for position, argument in ipairs(args) do
            holds(
                argument.type == signature.operands[
                    position
                ] or op == "simd_padded_string_u8" and position == 1 and argument.type == "lua_bytes",
                "invalid SIMD operand"
            )
            scalarWalk(argument, values, scope)
        end
        if op == "simd_load_u8" then
            local span = simd.span ~= nil and scope.spans[simd.span as string] or nil
            holds(
                span ~= nil and (
                    span as scalarIR.Param
                ).kind == "read_span" and (span as scalarIR.Param).sourceType == "uint8",
                "invalid SIMD load root"
            )
        elseif op == "simd_load_string_u8" or op == "simd_padded_string_u8" then
            local rootIndex = op == "simd_load_string_u8" and 2 or 1
            local rooted = args[rootIndex] as scalarIR.Name
            local param = scope.spans[rooted.name]
            holds(
                scope.entryMode == "lua-builder" and args[
                    rootIndex
                ].op == "local" and rooted.cName ~= nil and param ~= nil and (
                    param as scalarIR.Param
                ).kind == "scalar" and (
                    param as scalarIR.Param
                ).type == args[
                    rootIndex
                ].type and (
                    args[rootIndex].type == "lua_string" or args[rootIndex].type == "lua_bytes"
                ) and rooted.cName == (param as scalarIR.Param).cName,
                "invalid SIMD rooted-string operation"
            )
            holds(simd.span == nil, "unexpected SIMD rooted-string span")
        else
            holds(simd.span == nil, "unexpected SIMD span root")
        end
    elseif verify.FIXED_BINARY[tostring(op)] ~= nil then
        local element = verify.FIXED_BINARY[tostring(op)]
        local pair = node as scalarIR.Fixed
        holds(
            node.type == element and pair.left.type == element and pair.right.type == element,
            "invalid fixed-width binary operation"
        )
        scalarWalk(pair.left, values, scope)
        scalarWalk(pair.right, values, scope)
    elseif op == "f32_sqrt" or op == "f32_exp" then
        local unary = node as scalarIR.FixedUnary
        holds(node.type == "f32" and unary.value.type == "f32", "invalid binary32 unary operation")
        scalarWalk(unary.value, values, scope)
    elseif op == "u32_not" or op == "u32_popcount" or op == "u32_ctz" or op == "u32_clz" then
        local counted = node as scalarIR.FixedUnary
        holds(node.type == "u32" and counted.value.type == "u32", "invalid uint32 bit count")
        scalarWalk(counted.value, values, scope)
    elseif verify.FIXED_CORRECTED[tostring(op)] ~= nil then
        corrected(node as scalarIR.Corrected, values, scope)
    elseif op == "constant_i32" then
        holds(node.type == "i32" or node.type == "u32", "integer constant type")
    elseif op == "constant_i64" then
        holds(node.type == "i64" or node.type == "u64", "wide integer constant type")
    elseif op == "constant" then
        holds(node.type == "f64" and tonumber(node.value) ~= nil, "invalid constant")
    elseif op == "bool" then
        holds(node.type == "bool" and type(node.value) == "boolean", "invalid boolean")
    elseif op == "lua_nil" then
        holds(scope.entryMode == "lua-builder" and node.type == "lua_nil", "Lua nil outside a builder")
    elseif op == "lua_string" then
        holds(
            scope.entryMode == "lua-builder" and node.type == "lua_string" and type(node.value) == "string",
            "Lua string outside a builder"
        )
    elseif op == "lua_concat" then
        local joined = node as scalarIR.LuaConcat
        holds(scope.entryMode == "lua-builder" and node.type == "lua_string", "Lua concat outside a builder")
        holds(joined.left.type == "lua_string" and joined.right.type == "lua_string", "non-string Lua concat")
        scalarWalk(joined.left, values, scope)
        scalarWalk(joined.right, values, scope)
    elseif op == "lua_substring" then
        local sliced = node as scalarIR.LuaSubstring
        holds(scope.entryMode == "lua-builder" and node.type == "lua_string", "Lua substring outside a builder")
        holds(sliced.bytes.type == "lua_string" and sliced.bytes.op == "local", "substring input is not rooted")
        holds(
            sliced.first.type == "f64" and (sliced.last == nil or (sliced.last as scalarIR.Expr).type == "f64"),
            "substring bounds are not numeric"
        )
        scalarWalk(sliced.bytes, values, scope)
        scalarWalk(sliced.first, values, scope)
        if sliced.last ~= nil then
            scalarWalk(sliced.last as scalarIR.Expr, values, scope)
        end
    elseif op == "lua_string_byte_lua" then
        local loaded = node as scalarIR.LuaStringByte
        holds(scope.entryMode == "lua-builder" and node.type == "f64", "Lua string byte outside a builder")
        holds(loaded.bytes.type == "lua_string" and loaded.bytes.op == "local", "string.byte input is not rooted")
        holds(loaded.index.type == "f64", "string.byte index is not numeric")
        scalarWalk(loaded.bytes, values, scope)
        scalarWalk(loaded.index, values, scope)
    elseif op == "lua_table_get_index" then
        local loaded = node as scalarIR.LuaTableGet
        holds(scope.entryMode == "lua-builder" and node.type == "f64", "Lua table read outside a builder")
        holds(loaded.table.type == "lua_table" and loaded.table.op == "local", "Lua table read is not rooted")
        holds(verify.NUMERIC[loaded.key.type] == true, "Lua table index is not numeric")
        scalarWalk(loaded.table, values, scope)
        scalarWalk(loaded.key, values, scope)
    elseif op == "lua_string_buffer" then
        local buffer = node as scalarIR.LuaStringBuffer
        holds(scope.entryMode == "lua-builder" and node.type == "lua_string_buffer", "string buffer outside a builder")
        holds(buffer.initial.type == "lua_string", "string buffer initial value is not a string")
        scalarWalk(buffer.initial, values, scope)
    elseif op == "lua_string_buffer_finish" then
        local finished = node as scalarIR.LuaStringBufferFinish
        holds(scope.entryMode == "lua-builder" and node.type == "lua_string", "string buffer finish outside a builder")
        holds(
            finished.buffer.type == "lua_string_buffer" and finished.buffer.op == "local",
            "string buffer finish has no local buffer"
        )
        scalarWalk(finished.buffer, values, scope)
    elseif op == "lua_new_table" then
        local created = node as scalarIR.LuaNewTable
        holds(scope.entryMode == "lua-builder" and node.type == "lua_table", "Lua allocation outside a builder")
        for _, capacity in ipairs({created.arrayCapacity, created.hashCapacity}) do
            holds(verify.NUMERIC[capacity.type] == true, "non-numeric Lua table capacity")
            scalarWalk(capacity, values, scope)
        end
        for _, field in ipairs(created.fields or {}) do
            scalarWalk(field.key, values, scope)
            scalarWalk(field.value, values, scope)
            holds(
                verify.NUMERIC[field.key.type] == true or field.key.type == "lua_string",
                "unsupported fresh-table literal key"
            )
            holds(
                verify.NUMERIC[
                    field.value.type
                ] == true
                or field.value.type == "bool"
                or field.value.type == "lua_nil"
                or field.value.type == "lua_string"
                or field.value.type == "lua_table",
                "unsupported fresh-table literal value"
            )
        end
    elseif op == "lua_builder" then
        local builder = node as scalarIR.LuaBuilder
        holds(scope.entryMode == "lua-builder" and node.type == "lua_builder", "value stream outside a builder")
        holds(
            (
                builder.mode == "eager" or builder.mode == "pull" or builder.mode == "serde"
            ) and scope.builderMode == builder.mode,
            "unknown or inconsistent value stream mode"
        )
        holds(
            builder.nullValue.type == "lua_value" and builder.nullValue.op == "local",
            "value stream null is not rooted"
        )
        scalarWalk(builder.nullValue, values, scope)
        if builder.maxDepth ~= nil or builder.stringCapacity ~= nil then
            holds(
                builder.maxDepth ~= nil and (
                    builder.maxDepth as scalarIR.Expr
                ).type == "u32" and builder.stringCapacity ~= nil and (
                    builder.stringCapacity as scalarIR.Expr
                ).type == "u32",
                "sized value stream has invalid bounds"
            )
            scalarWalk(builder.maxDepth as scalarIR.Expr, values, scope)
            scalarWalk(builder.stringCapacity as scalarIR.Expr, values, scope)
        end
        if builder.arrayMarker ~= nil or builder.objectMarker ~= nil then
            holds(
                builder.arrayMarker ~= nil and builder.objectMarker ~= nil and (
                    builder.arrayMarker as scalarIR.Expr
                ).type == "lua_value" and (builder.objectMarker as scalarIR.Expr).type == "lua_value",
                "value stream container markers are not rooted"
            )
            scalarWalk(builder.arrayMarker as scalarIR.Expr, values, scope)
            scalarWalk(builder.objectMarker as scalarIR.Expr, values, scope)
        end
        if builder.selectionShape ~= nil or builder.arrayShapeMarker ~= nil or builder.serdeMarkers ~= nil then
            holds(
                builder.selectionShape ~= nil and builder.arrayShapeMarker ~= nil and (
                    builder.selectionShape as scalarIR.Expr
                ).type == "lua_value" and (
                    builder.selectionShape as scalarIR.Expr
                ).op == "local" and (
                    builder.arrayShapeMarker as scalarIR.Expr
                ).type == "lua_value" and (
                    builder.arrayShapeMarker as scalarIR.Expr
                ).op == "local" and builder.serdeMarkers ~= nil and (
                    builder.serdeMarkers as scalarIR.Expr
                ).type == "lua_value" and (builder.serdeMarkers as scalarIR.Expr).op == "local",
                "pull value stream selection is not rooted"
            )
            scalarWalk(builder.selectionShape as scalarIR.Expr, values, scope)
            scalarWalk(builder.arrayShapeMarker as scalarIR.Expr, values, scope)
            scalarWalk(builder.serdeMarkers as scalarIR.Expr, values, scope)
        end
    elseif op == "lua_scratch_u32" then
        local scratch = node as scalarIR.LuaScratchU32
        holds(scope.entryMode == "lua-builder" and node.type == "lua_scratch_u32", "scratch outside a builder")
        holds(scratch.capacity.type == "u32", "scratch capacity is not uint32")
        scalarWalk(scratch.capacity, values, scope)
    elseif op == "lua_scratch_u32_get" or op == "lua_scratch_u32_escape_get" then
        local loaded = node as scalarIR.LuaScratchU32Get
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "scratch read outside a builder")
        holds(
            loaded.scratch.type == "lua_scratch_u32" and loaded.scratch.op == "local",
            "scratch read has no local buffer"
        )
        holds(loaded.index.type == "u32", "scratch read index is not uint32")
        holds(
            loaded.cursor == nil and loaded.cursorCName == nil or cursorRead(
                loaded.index,
                loaded.cursor,
                loaded.cursorCName,
                (loaded.scratch as scalarIR.Name).name,
                values,
                scope
            ),
            "direct scratch read lacks a dominating length proof"
        )
        holds(
            fixedWidthAgrees(loaded.fixedBound, values, (loaded.scratch as scalarIR.Name).name),
            "scratch read bound is not the width of the buffer it reads"
        )
        scalarWalk(loaded.scratch, values, scope)
        scalarWalk(loaded.index, values, scope)
    elseif op == "lua_scratch_u32_length" or op == "lua_scratch_u32_escape_length" then
        local loaded = node as scalarIR.LuaScratchU32Length
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "scratch length outside a builder")
        holds(
            loaded.scratch.type == "lua_scratch_u32" and loaded.scratch.op == "local",
            "scratch length has no local buffer"
        )
        scalarWalk(loaded.scratch, values, scope)
    elseif op == "lua_scratch_u32_append_bits" or op == "lua_scratch_u32_append_bits_eager" then
        local appended = node as scalarIR.LuaScratchU32AppendBits
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "scratch bit append outside a builder")
        holds(
            appended.scratch.type == "lua_scratch_u32" and appended.scratch.op == "local",
            "scratch bit append has no local buffer"
        )
        holds(
            appended.index.type == "u32" and appended.base.type == "u32" and appended.bits.type == "simd_mask_bits64",
            "invalid scratch bit append"
        )
        scalarWalk(appended.scratch, values, scope)
        scalarWalk(appended.index, values, scope)
        scalarWalk(appended.base, values, scope)
        scalarWalk(appended.bits, values, scope)
    elseif op == "lua_scratch_u32_append_string_bits" then
        local appended = node as scalarIR.LuaScratchU32AppendStringBits
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "scratch string bit append outside a builder")
        holds(
            appended.scratch.type == "lua_scratch_u32" and appended.scratch.op == "local",
            "scratch string bit append has no local buffer"
        )
        if appended.escapeScratch ~= nil then
            holds(
                (
                    appended.escapeScratch as scalarIR.Expr
                ).type == "lua_scratch_u32" and (appended.escapeScratch as scalarIR.Expr).op == "local",
                "scratch string bit append has no escape buffer"
            )
        end
        holds(
            appended.index.type == "u32"
            and appended.base.type == "u32"
            and appended.events.type == "simd_mask_bits64"
            and appended.quotes.type == "simd_mask_bits64"
            and appended.slashes.type == "simd_mask_bits64"
            and (
                appended.escapeScratch == nil or appended.slashCarry ~= nil and (
                    appended.slashCarry as scalarIR.Expr
                ).type == "bool" and appended.slashOdd ~= nil and (appended.slashOdd as scalarIR.Expr).type == "bool"
            ) and appended.inString.type == "bool" and appended.stringEscaped.type == "bool",
            "invalid scratch string bit append"
        )
        scalarWalk(appended.scratch, values, scope)
        if appended.escapeScratch ~= nil then
            scalarWalk(appended.escapeScratch as scalarIR.Expr, values, scope)
        end
        scalarWalk(appended.index, values, scope)
        scalarWalk(appended.base, values, scope)
        scalarWalk(appended.events, values, scope)
        scalarWalk(appended.quotes, values, scope)
        scalarWalk(appended.slashes, values, scope)
        if appended.slashCarry ~= nil then
            scalarWalk(appended.slashCarry as scalarIR.Expr, values, scope)
            scalarWalk(appended.slashOdd as scalarIR.Expr, values, scope)
        end
        scalarWalk(appended.inString, values, scope)
        scalarWalk(appended.stringEscaped, values, scope)
    elseif op == "lua_scratch_u8" then
        local scratch = node as scalarIR.LuaScratchU8
        holds(scope.entryMode == "lua-builder" and node.type == "lua_scratch_u8", "byte scratch outside a builder")
        holds(scratch.capacity.type == "u32", "byte scratch capacity is not uint32")
        scalarWalk(scratch.capacity, values, scope)
    elseif op == "lua_scratch_u8_get" then
        local loaded = node as scalarIR.LuaScratchU8Get
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "byte scratch read outside a builder")
        holds(
            loaded.scratch.type == "lua_scratch_u8" and loaded.scratch.op == "local",
            "byte scratch read has no local buffer"
        )
        holds(loaded.index.type == "u32", "byte scratch read index is not uint32")
        holds(
            fixedWidthAgrees(loaded.fixedBound, values, (loaded.scratch as scalarIR.Name).name),
            "byte scratch read bound is not the width of the buffer it reads"
        )
        scalarWalk(loaded.scratch, values, scope)
        scalarWalk(loaded.index, values, scope)
    elseif op == "lua_string_byte"
        or op == "lua_string_byte_at"
        or op == "lua_string_u32"
        or op == "lua_string_length"
    then
        local bytes = node as scalarIR.LuaBytes
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "rooted byte read outside a builder")
        holds(
            (bytes.bytes.type == "lua_string" or bytes.bytes.type == "lua_bytes") and bytes.bytes.op == "local",
            "byte input is not a rooted string or buffer"
        )
        scalarWalk(bytes.bytes, values, scope)
        if op == "lua_string_length" then
            holds(bytes.index == nil, "string length carried an index")
        else
            holds(bytes.index ~= nil and (bytes.index as scalarIR.Expr).type == "u32", "byte read index is not uint32")
            scalarWalk(bytes.index as scalarIR.Expr, values, scope)
            if op == "lua_string_byte_at" then
                local rooted = bytes.bytes as scalarIR.Name
                holds(
                    cursorRead(
                        bytes.index as scalarIR.Expr,
                        bytes.cursor,
                        bytes.cursorCName,
                        rooted.name,
                        values,
                        scope
                    ),
                    "direct rooted byte read lacks a bounds proof"
                )
            end
        end
    elseif op == "lua_builder_finish" then
        local finished = node as scalarIR.LuaBuilderFinish
        holds(scope.entryMode == "lua-builder" and node.type == "lua_value", "value stream finish outside a builder")
        holds(
            finished.builder.type == "lua_builder" and finished.builder.op == "local",
            "finished value stream is not local"
        )
        scalarWalk(finished.builder, values, scope)
        holds(
            (
                finished.mode == "eager" or finished.mode == "pull" or finished.mode == "serde"
            ) and scope.builderMode == finished.mode,
            "unknown or inconsistent finished value stream mode"
        )
    elseif op == "lua_builder_depth"
        or op == "lua_builder_kind"
        or op == "lua_builder_count"
        or op == "lua_builder_state"
    then
        local query = node as scalarIR.LuaBuilderQuery
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "value stream query outside a builder")
        holds(
            query.builder.type == "lua_builder" and query.builder.op == "local",
            "value stream query has no local builder"
        )
        scalarWalk(query.builder, values, scope)
        holds(
            (
                query.mode == "eager" or query.mode == "pull" or query.mode == "serde"
            ) and scope.builderMode == query.mode,
            "unknown or inconsistent queried value stream mode"
        )
    elseif op == "lua_builder_number_token" then
        local number = node as scalarIR.LuaBuilderNumberToken
        holds(scope.entryMode == "lua-builder" and node.type == "u32", "number token outside a builder")
        holds(
            number.builder.type == "lua_builder" and number.builder.op == "local",
            "number token has no local builder"
        )
        holds(
            (
                number.sourceBytes.type == "lua_string" or number.sourceBytes.type == "lua_bytes"
            ) and number.sourceBytes.op == "local",
            "number token input is not rooted bytes"
        )
        holds(number.start.type == "u32" and number.limit.type == "u32", "number token bounds are not uint32")
        holds(
            (
                number.mode == "eager" or number.mode == "pull" or number.mode == "serde"
            ) and scope.builderMode == number.mode,
            "unknown or inconsistent number token mode"
        )
        scalarWalk(number.builder, values, scope)
        scalarWalk(number.sourceBytes, values, scope)
        scalarWalk(number.start, values, scope)
        scalarWalk(number.limit, values, scope)
    elseif op == "neg" or op == "not" or op == "bnot" then
        local operand = (node as scalarIR.Unary).value
        scalarWalk(operand, values, scope)
        local expected = op == "neg" and "f64" or op == "not" and "bool" or "i32"
        holds(node.type == expected, "invalid unary result")
        if op == "bnot" then
            holds(bitOperand(operand), "invalid bitwise operand")
        end
    elseif op == "math" then
        holds(node.type == "f64", "invalid math result")
        holds(MATH[node.intrinsic] == true, "unknown math intrinsic")
        for _, argument in ipairs(node.args) do
            holds(argument.type == "f64", "invalid math argument")
            scalarWalk(argument, values, scope)
        end
    elseif op == "helper_call" then
        local found = scope.helpers[node.helper]
        holds(found ~= nil, "invalid helper call")

        local helper = found as scalarIR.Helper
        holds(
            #node.args == #helper.params and (node.type == helper.resultType or node.type == "multi"),
            "invalid helper call"
        )
        for position, argument in ipairs(node.args) do
            holds(argument.type == helper.params[position].type, "invalid helper argument")
            scalarWalk(argument, values, scope)
        end
    elseif verify.BINARY_OPCODES[tostring(op)] == true then
        binary(node as scalarIR.Binary, values, scope)
    else
        refuse("unknown expression opcode " .. tostring(op))
    end
end

----------------------------------------------------------------------------
-- Lane expressions
----------------------------------------------------------------------------

--- Every vector this gang may mention, so an opcode naming one that belongs to
--- a different shape is caught rather than quietly accepted.
local function laneTypes(shape: lane.Shape): {[string]: boolean}
    local admitted: {[string]: boolean} = {}
    admitted[shape.mask] = true
    admitted[shape.bits] = true
    for _, vector in pairs(shape.vectorFor) do
        admitted[vector] = true
    end
    -- The masks a comparison produces before it is brought to the gang's own,
    -- which exist only where the gang carries more than one width. Leaving them
    -- out does not refuse them: a type this does not admit is read as a scalar,
    -- and the scalar walk then reports a lane opcode it has never heard of.
    for _, mask in pairs(shape.maskFor or {}) do
        admitted[mask] = true
    end
    for _, vector in pairs(shape.rounding or {}) do
        admitted[vector] = true
    end

    return admitted
end

--- Builds the arithmetic and comparison signatures this gang admits.
---
--- Derived from the shape rather than written out, so an opcode for a width the
--- gang does not carry simply has no entry and fails to match.
local function laneSignatures(shape: lane.Shape): ({[string]: any}, {[string]: any})
    local binaries: {[string]: any} = {}
    local unaries: {[string]: any} = {}
    for element, vector in pairs(shape.vectorFor) do
        if vector ~= shape.mask then
            for _, verb in ipairs({"add", "sub", "mul", "div"}) do
                binaries[verb .. "." .. element] = {result = vector, operand = vector}
            end
            -- A comparison's result is a mask as wide as what it compared,
            -- which is the gang's own only where the gang carries one width.
            local produced = (shape.maskFor or {})[element] or shape.mask
            for _, verb in ipairs({"lt", "le", "gt", "ge", "eq", "ne"}) do
                binaries[verb .. "." .. element] = {result = produced, operand = vector}
            end
            unaries["neg." .. element] = {result = vector, operand = vector}
            unaries["sqrt." .. element] = {result = vector, operand = vector}
        end
    end

    return binaries, unaries
end

--- Checks a short-circuit mask.
---
--- Its own function because narrowing needs one tag compared at a time, and both
--- spellings share every rule.
local function shortCircuit(node: lane.ShortCircuit, values: {[string]: string}, context: verify.Context): nil
    -- Both sides run for every lane, so eager evaluation needs the proof rather
    -- than the shape of the expression.
    laneHolds(node.effect == "pure_total", "a short-circuit mask without its effect proof")
    laneHolds(
        #node.args == 2 and node.args[
            1
        ].type == context.shape.mask and node.args[2].type == context.shape.mask and node.type == context.shape.mask,
        "a short-circuit mask over something that is not a mask"
    )
    laneWalk(node.args[1], values, context)
    laneWalk(node.args[2], values, context)
end

--- Checks the operands of an operation that takes a vector of one width.
local function operands(
    args: {lane.Expr},
    want: string,
    count: integer,
    values: {[string]: string},
    context: verify.Context,
    why: string
): nil
    laneHolds(#args == count, why)
    for _, argument in ipairs(args) do
        laneHolds(argument.type == want, why)
        laneWalk(argument, values, context)
    end
end

laneWalk = function(node: lane.Expr, values: {[string]: string}, context: verify.Context): nil
    local shape = context.shape
    local admitted, binaries, unaries = context.admitted, context.binaries, context.unaries
    local mask = shape.mask

    laneHolds(node ~= nil and node.type ~= nil, "an expression with no type")

    -- The tag is checked before anything narrows on it. `node` is declared to be
    -- one of these records, but it arrives across a boundary that does not
    -- enforce that, and the checker is entitled to prove the last `is` in a
    -- chain over an exhausted union statically true -- which would make the
    -- branch that rejects an unknown opcode dead code, in the one function whose
    -- whole purpose is rejecting what it does not know.
    if not admitted[node.type] then
        -- A uniform scalar inside a lane expression. Its type is not one this
        -- gang carries, which is exactly what makes it a scalar, so the scalar
        -- rules are the ones that apply.
        scalarWalk(node as scalarIR.Expr, values, context.scope)

        return
    end

    laneHolds(
        verify.LANE_OPCODES[tostring(node.op)] == true,
        "an operation this vocabulary has no rule for: " .. tostring(node.op)
    )

    -- Narrowed by record rather than by opcode. The tags are literal, so `is`
    -- proves which record this is and the fields it carries follow from that;
    -- comparing thirty enumerated opcodes by hand would prove the same thing
    -- and read like a table.
    if node.op == "local" then
        laneHolds(values[node.name] == node.type, "a lane local of the wrong type")
    elseif node.op == "vsplat" then
        laneHolds(
            #node.args == 1 and node.type ~= mask and shape.vectorFor[node.element] == node.type,
            "a splat that does not carry its element"
        )
        scalarWalk(node.args[1], values, context.scope)
    elseif node.op == "vbool_splat" then
        laneHolds(node.type == mask and #node.args == 1, "a boolean splat that is not a mask")
        scalarWalk(node.args[1], values, context.scope)
    elseif node.op == "vfield_load" then
        local root = context.scope.spans[node.span]
        local layout = context.scope.layouts[node.layout]
        laneHolds(
            root ~= nil and root.type == "struct:" .. tostring(
                node.layout
            ) and layout ~= nil and (
                layout.fieldTypes or {}
            )[
                node.field
            ] == node.scalarType and (
                layout.fieldSourceTypes or {}
            )[
                node.field
            ] == storageSource(
                node.scalarType,
                node.sourceType
            ) and validStorage(
                node.scalarType,
                node.sourceType
            ) and node.lanes == shape.lanes and node.type == shape.vectorFor[node.scalarType],
            "a lane load that does not match its span, field, or width"
        )
    elseif node.op == "vspan_load" then
        local root = context.scope.spans[node.span]
        laneHolds(
            root ~= nil and (
                root.kind == "read_span" or root.kind == "write_span"
            ) and root.type == node.scalarType and storageSource(
                root.type,
                root.sourceType
            ) == storageSource(
                node.scalarType,
                node.sourceType
            ) and validStorage(
                node.scalarType,
                node.sourceType
            ) and node.lanes == shape.lanes and node.type == shape.vectorFor[node.scalarType],
            "a lane load that does not match its span or width"
        )
    elseif node.op == "vbinary" then
        local signature = binaries[node.verb .. "." .. tostring(node.element)]
        laneHolds(signature ~= nil and node.type == signature.result, "a binary operation this gang does not admit")
        operands(
            node.args,
            signature.operand,
            2,
            values,
            context,
            "a binary operation whose operands are not its own width"
        )
    elseif node.op == "vunary" then
        local signature = unaries[node.verb .. "." .. tostring(node.element)]
        laneHolds(signature ~= nil and node.type == signature.result, "a unary operation this gang does not admit")
        operands(
            node.args,
            signature.operand,
            1,
            values,
            context,
            "a unary operation whose operand is not its own width"
        )
    elseif node.op == "vmask" then
        local count = node.verb == "not" and 1 or 2
        operands(node.args, mask, count, values, context, "a mask operation over something that is not a mask")
        laneHolds(node.type == mask, "a mask operation that does not produce a mask")
    elseif node.op == "vshort" then
        shortCircuit(node, values, context)
    elseif node.op == "vselect" then
        -- The condition is a mask as wide as the lanes it chooses between, which
        -- is the gang's own where it carries one width and the element's where
        -- it carries several. A select is bitwise, so a narrower or wider mask
        -- would select the wrong bits rather than fail to compile.
        local selectMask = mask
        for element, carried in pairs(shape.vectorFor) do
            if carried == node.type then
                selectMask = ((shape.maskFor or {})[element] or mask) as string
            end
        end
        laneHolds(
            #node.args == 3 and node.args[
                1
            ].type == selectMask and node.args[2].type == node.type and node.args[3].type == node.type,
            "a select whose arms disagree, or whose condition is not a mask of their width"
        )
        laneWalk(node.args[1], values, context)
        laneWalk(node.args[2], values, context)
        laneWalk(node.args[3], values, context)
    elseif node.op == "vmath" then
        laneHolds(
            node.type == shape.vectorFor["f64"] and MATH[node.intrinsic] == true,
            "a math operation outside the closed set, or not in binary64 lanes"
        )
        operands(node.args, node.type, #node.args, values, context, "a math argument of the wrong width")
    elseif node.op == "vcorrected" then
        -- Whatever binary32 lanes this gang carries, which is eight of them
        -- only in a 32-byte one. A 16-byte gang has four, and naming a width
        -- here rather than asking the shape refused every x86-64 baseline
        -- build -- the tier most machines get -- for IR that was correct.
        laneHolds(
            node.type == shape.vectorFor["f32"] and verify.CORRECTED_ARITY[node.helper] == #node.args,
            "a corrected operation with the wrong helper or arity"
        )
        operands(node.args, node.type, #node.args, values, context, "a corrected operand of the wrong width")
    elseif node.op == "vbitwise" then
        local verb = node.verb
        laneHolds(
            node.type == shape.bits and verify.BITWISE_ARITY[verb] ~= nil,
            "a bitwise operation outside the gang's bit vector"
        )
        operands(
            node.args,
            shape.bits,
            verify.BITWISE_ARITY[verb],
            values,
            context,
            "a bitwise operand outside the bit vector"
        )
    elseif node.op == "vround" then
        -- The vector does not change: a rounding narrows the value and carries
        -- it on where it was. A gang that carries the element exactly has
        -- nothing to round, so asking is a malformed opcode rather than a
        -- no-op.
        laneHolds(
            (shape.rounding or {})[node.element] == node.narrow and node.type == shape.vectorFor[node.element],
            "a rounding this gang does not need or cannot do"
        )
        operands(node.args, node.type, 1, values, context, "a rounding of something that is not its own width")
    elseif node.op == "vconvert" then
        laneHolds(
            admitted[
                node.type
            ] == true and #node.args == 1 and admitted[node.args[1].type] == true and node.args[1].type ~= node.type,
            "a conversion that does not change vector"
        )
        laneWalk(node.args[1], values, context)
    elseif node.op == "vmask_cast" then
        -- Between two of this gang's own masks, and never to the one it already
        -- is. A cast that changed nothing would be an instruction the IR asked
        -- for and could not account for.
        local masks: {[string]: boolean} = {[shape.mask] = true}
        for _, mask in pairs(shape.maskFor or {}) do
            masks[mask] = true
        end
        laneHolds(
            masks[
                node.type
            ] == true and #node.args == 1 and masks[node.args[1].type] == true and node.args[1].type ~= node.type,
            "a mask conversion outside this gang's masks"
        )
        laneWalk(node.args[1], values, context)
    elseif node.op == "vbits" then
        laneHolds(
            admitted[
                node.type
            ] == true and #node.args == 1 and admitted[node.args[1].type] == true and node.args[1].type ~= node.type,
            "a bit conversion that does not change vector"
        )
        laneWalk(node.args[1], values, context)
    else
        refuse("invalid lane IR: an operation this vocabulary has no rule for")
    end
end

----------------------------------------------------------------------------
-- Statements
----------------------------------------------------------------------------

--- An environment with the same entries, so a nested scope cannot leak the
--- names it introduces back out of itself.
local function inherit(values: {[string]: string}): {[string]: string}
    local copied: {[string]: string} = {}
    for name, entry in pairs(values) do
        copied[name] = entry
    end

    return copied
end

--- Checks one assignment target and the value going into it.
local function assignment(
    entry: scalarIR.Assignment,
    values: {[string]: string},
    scope: verify.Scope,
    stored: {[string]: boolean}
): nil
    local target = entry.target
    if target.kind == "local" then
        holds(values[tostring(target.name)] == target.type, "invalid local assignment target")
    elseif target.kind == "field" then
        local layout = scope.layouts[tostring(target.layout)]
        local object = target.object
        holds(
            object ~= nil and (
                object as scalarIR.ElementRef
            ).mutable == true and layout ~= nil and (
                layout as scalarIR.Layout
            ).fieldTypes ~= nil and (
                (layout as scalarIR.Layout).fieldTypes or {}
            )[
                tostring(target.field)
            ] == target.type and (
                (layout as scalarIR.Layout).fieldSourceTypes or {}
            )[tostring(target.field)] == storageSource(tostring(target.type), target.sourceType),
            "invalid field assignment target"
        )
        scalarWalk(object as scalarIR.Expr, values, scope)
    else
        refuse("invalid scalar assignment target")
    end
    holds(entry.value.type == target.type, "assignment type mismatch")
    scalarWalk(entry.value, values, scope)
end

--- Whether a true condition itself proves one zero-based cursor is below one
--- span count. Cursor metadata narrows the verifier's search; it does not get
--- to manufacture a bounds fact independently of the checked expression.
local function provesCursorBound(
    condition: scalarIR.Expr,
    cursor: string,
    spanName: string,
    values: {[string]: string}
): boolean
    if condition.op == "and" then
        local binary = condition as scalarIR.Binary
        return provesCursorBound(
            binary.left,
            cursor,
            spanName,
            values
        ) or provesCursorBound(binary.right, cursor, spanName, values)
    elseif condition.op == "lt" then
        local comparison = condition as scalarIR.Binary
        local right = comparison.right
        return comparison.left.op == "local" and (
            comparison.left as scalarIR.Name
        ).name == cursor and (
            right.op == "span_count" and (
                right as scalarIR.SpanCount
            ).span == spanName or right.op == "local" and (
                values[
                    LENGTH_OF .. (right as scalarIR.Name).name
                ] == spanName or values[SCRATCH_LENGTH .. (right as scalarIR.Name).name] == spanName
            )
        )
    else
        return false
    end
end

--- The locals a statement list assigns anywhere inside it.
local function assignedLocals(statements: {scalarIR.Statement}, out: {[string]: boolean}): {[string]: boolean}
    for _, statement in ipairs(statements) do
        if statement.op == "assign" then
            for _, entry in ipairs(statement.values) do
                if entry.target.kind == "local" and entry.target.name ~= nil then
                    out[entry.target.name as string] = true
                end
            end
        elseif statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                assignedLocals(clause.body, out)
            end
            assignedLocals(statement.elseBody or {}, out)
        elseif (statement as any).body ~= nil then
            assignedLocals((statement as any).body as {scalarIR.Statement}, out)
        end
    end

    return out
end

--- The cursor bounds a block runs under: the enclosing ones, less any a loop
--- body reassigns, plus those `condition` proves.
---
--- A cursor the loop body assigns is bounded by the enclosing proof on the
--- first iteration only; from the second it holds whatever the body left in
--- it, which nothing checked. So under a loop such a cursor keeps a bound only
--- when the loop's own condition re-proves it every time round. `declared` is
--- what the lowerer claims the condition proves; each claim is held against
--- the condition itself, because cursor metadata narrows the search and does
--- not get to manufacture a bounds fact on its own.
local function proveCursorBounds(
    condition: scalarIR.Expr,
    declared: {[string]: string}?,
    values: {[string]: string},
    scope: verify.Scope,
    body: {scalarIR.Statement}?,
    why: string
): {[string]: string}
    local reassigned = body ~= nil and assignedLocals(body as {scalarIR.Statement}, {}) or {}
    local cursorBounds: {[string]: string} = {}
    for name, spanName in pairs(scope.cursorBounds) do
        if reassigned[name] ~= true then
            cursorBounds[name] = spanName
        end
    end
    for name, spanName in pairs(declared or {}) do
        local root = scope.spans[spanName]
        holds(
            values[
                name
            ] == "u32" and (
                root ~= nil and (
                    (
                        root as scalarIR.Param
                    ).region ~= nil or (
                        root as scalarIR.Param
                    ).type == "lua_string" or (root as scalarIR.Param).type == "lua_bytes"
                ) or values[spanName] == "lua_scratch_u32"
            ) and provesCursorBound(condition, name, spanName, values),
            why .. " for " .. name .. " against " .. spanName
        )
        cursorBounds[name] = spanName
    end

    return cursorBounds
end

--- Flattens an `or` chain into the conditions it joins, in order.
local function disjuncts(condition: scalarIR.Expr, out: {scalarIR.Expr}): {scalarIR.Expr}
    if condition.op == "or" then
        local pair = condition as scalarIR.Binary
        disjuncts(pair.left, out)
        disjuncts(pair.right, out)
    else
        out[#out + 1] = condition
    end

    return out
end

--- Holds a native switch to the branch chain it stands in for.
---
--- The emitter dispatches on the switch wherever one is present and never
--- reads the clause conditions, so the two have to say one thing: an arm per
--- clause, and each clause's condition exactly `selector == label` over that
--- arm's labels in order, joined by `or`.
local function nativeSwitch(statement: scalarIR.If, values: {[string]: string}, scope: verify.Scope): nil
    local switch = statement.nativeSwitch as scalarIR.NativeSwitch
    scalarWalk(switch.selector, values, scope)
    holds(
        switch.selector.op == "local" and (switch.selector.type == "i32" or switch.selector.type == "u32"),
        "native switch selector is not a fixed-width local"
    )
    holds(#switch.arms == #statement.clauses, "native switch arms do not match the branch clauses")
    local selector = switch.selector as scalarIR.Name
    for position, arm in ipairs(switch.arms) do
        local tests = disjuncts(statement.clauses[position].condition, {})
        holds(#arm.labels > 0 and #tests == #arm.labels, "native switch arm does not match its clause")
        for index, label in ipairs(arm.labels) do
            local test = tests[index]
            local equal = test.op == "eq" and test as scalarIR.Binary or nil
            local left = equal ~= nil and equal.left.op == "local" and equal.left as scalarIR.Name or nil
            local right = equal ~= nil
                and equal.right.op == "constant_i32"
                and equal.right as scalarIR.IntConstant
                or nil
            holds(
                label.type == selector.type
                and left ~= nil
                and left.name == selector.name
                and left.cName == selector.cName
                and right ~= nil
                and right.type == label.type
                and right.value == label.value,
                "native switch label does not match its clause condition"
            )
        end
    end
end

--- Retires from `scope` every cursor bound the nested block retired.
local function invalidateCursors(scope: verify.Scope, nested: verify.Scope): nil
    local invalidated: {string} = {}
    for name in pairs(scope.cursorBounds) do
        if nested.cursorBounds[name] == nil then
            invalidated[#invalidated + 1] = name
        end
    end
    for _, name in ipairs(invalidated) do
        scope.cursorBounds[name] = nil
    end
end

--- Checks one block of scalar statements, and everything under it.
---
--- `stored` accumulates which outputs were written, because a kernel whose
--- output is never assigned is a kernel that silently did nothing.
local function block(
    statements: {scalarIR.Statement},
    inherited: {[string]: string},
    scope: verify.Scope,
    stored: {[string]: boolean},
    sameScope: boolean?
): nil
    local values = sameScope == true and inherited or inherit(inherited)
    for _, statement in ipairs(statements) do
        effects.statement(tostring(statement.op))
        if statement.op == "let" then
            holds(values[statement.name] == nil and statement.type == statement.value.type, "invalid local declaration")
            scalarWalk(statement.value, values, scope)
            values[statement.name] = statement.type
            if statement.value.op == "lua_string_length" then
                values[
                    LENGTH_OF .. statement.name
                ] = ((statement.value as scalarIR.LuaBytes).bytes as scalarIR.Name).name
            else
                values[LENGTH_OF .. statement.name] = nil
            end
            local scratchLength = scratchLengthSource(statement.value, values)
            if scratchLength ~= nil then
                values[SCRATCH_LENGTH .. statement.name] = scratchLength as string
            else
                values[SCRATCH_LENGTH .. statement.name] = nil
            end
            -- A fixed buffer's width, kept beside the binding rather than in the
            -- scope, so it is inherited and discarded exactly as the name is.
            -- Nothing clears it: a block gets its own copy, and redeclaring a
            -- name that is still live is refused, so an entry cannot outlive the
            -- buffer it describes. That is what makes this worth checking -- a
            -- lowerer that let one leak would disagree with this map, and a
            -- bound belonging to another buffer is a read past the end of this
            -- one. The key cannot collide with a local's: a name has no spaces.
            if statement.type == "lua_scratch_u32" then
                local allocated = statement.value as scalarIR.LuaScratchU32
                if allocated.fixed ~= nil then
                    values[FIXED_WIDTH .. statement.name] = tostring(allocated.fixed)
                end
            elseif statement.type == "lua_scratch_u8" then
                local allocatedBytes = statement.value as scalarIR.LuaScratchU8
                if allocatedBytes.fixed ~= nil then
                    values[FIXED_WIDTH .. statement.name] = tostring(allocatedBytes.fixed)
                end
            end
        elseif statement.op == "multi_let" then
            scalarWalk(statement.call, values, scope)

            local resultTypes = statement.call.resultTypes or {}
            holds(
                statement.call.type == "multi" and #statement.bindings == #resultTypes,
                "invalid multiple-result declaration"
            )
            for position, bound in ipairs(statement.bindings) do
                holds(
                    values[bound.name] == nil and bound.type == resultTypes[position],
                    "invalid multiple-result binding"
                )
                values[bound.name] = bound.type
            end
        elseif statement.op == "store" then
            local bounded = statement.cursor ~= nil and statement.index == "" and values[
                statement.cursor as string
            ] == "u32" and scope.cursorBounds[
                statement.cursor as string
            ] == statement.span
                and statement.cursorCName ~= nil
                or statement.cursor == nil
                and statement.index == scope.index
                and (
                scope.mapIndex == true and (
                    scope.indexSpans as {[string]: boolean}
                )[statement.span] == true or statement.span == scope.boundSpan
            )
            holds(scope.writes[statement.span] == true and bounded, "invalid store root")
            scalarWalk(statement.value, values, scope)
            holds(statement.value.type == (scope.spans[statement.span] as scalarIR.Param).type, "store type mismatch")
            stored[statement.span] = true
        elseif statement.op == "shared_store" then
            local write = statement as scalarIR.SharedStore
            local shared = scope.shared or {}
            holds(
                scope.workgroup == true and scope.inPhase == true and shared[
                    write.shared
                ] == write.value.type and write.index.op == "local_index" and write.index.type == "u32",
                "invalid structurally disjoint workgroup scratch write"
            )
            scalarWalk(write.index, values, scope)
            scalarWalk(write.value, values, scope)
        elseif statement.op == "phase" then
            holds(scope.workgroup == true and scope.inPhase ~= true, "nested workgroup phase")
            local phase = statement as scalarIR.Phase
            local written: {[string]: boolean} = {}
            local crossRead: {[string]: boolean} = {}
            local inspectExpression: function(scalarIR.Expr): nil
            inspectExpression = function(value: scalarIR.Expr): nil
                if value.op == "shared_load" then
                    local load = value as scalarIR.SharedLoad
                    if load.index.op ~= "local_index" then
                        crossRead[load.shared] = true
                    end
                end
                visit.expressionChildren(value, function(child: scalarIR.Expr): scalarIR.Expr
                    inspectExpression(child)
                    return child
                end)
            end
            local inspectBlock: function({scalarIR.Statement}): nil
            inspectBlock = function(body: {scalarIR.Statement}): nil
                for _, nested in ipairs(body) do
                    if nested.op == "shared_store" then
                        written[(nested as scalarIR.SharedStore).shared] = true
                    end
                    visit.statementExpressions(nested, function(value: scalarIR.Expr): scalarIR.Expr
                        inspectExpression(value)
                        return value
                    end)
                    if nested.op == "if" then
                        for _, clause in ipairs((nested as scalarIR.If).clauses) do
                            inspectBlock(clause.body)
                        end
                        inspectBlock((nested as scalarIR.If).elseBody or {})
                    elseif nested.op == "while" or nested.op == "fornum" or nested.op == "block" then
                        inspectBlock((nested as any).body as {scalarIR.Statement})
                    end
                end
            end
            inspectBlock(phase.body)

            local function fixedTreeShared(): string?
                if #phase.body ~= 1 or phase.body[1].op ~= "if" then
                    return nil
                end
                local branch = phase.body[1] as scalarIR.If
                if #branch.clauses ~= 1 or branch.elseBody ~= nil or #branch.clauses[1].body ~= 1 then
                    return nil
                end
                local condition = branch.clauses[1].condition
                local write = branch.clauses[1].body[1]
                if condition.op ~= "lt" or write.op ~= "shared_store" then
                    return nil
                end
                local compared = condition as scalarIR.Binary
                local storedValue = write as scalarIR.SharedStore
                if compared.left.op ~= "local_index"
                    or compared.right.op ~= "constant_i32"
                    or storedValue.index.op ~= "local_index"
                    or storedValue.value.op ~= "f32_add"
                then
                    return nil
                end
                local stride = (compared.right as scalarIR.IntConstant).value
                local sum = storedValue.value as scalarIR.Fixed
                if sum.left.op ~= "shared_load" or sum.right.op ~= "shared_load" then
                    return nil
                end
                local left = sum.left as scalarIR.SharedLoad
                local right = sum.right as scalarIR.SharedLoad
                if left.shared ~= storedValue.shared
                    or right.shared ~= storedValue.shared
                    or left.index.op ~= "local_index"
                    or right.index.op ~= "u32_add"
                then
                    return nil
                end
                local added = right.index as scalarIR.Fixed
                if added.left.op ~= "local_index" or added.right.op ~= "constant_i32" or (
                    added.right as scalarIR.IntConstant
                ).value ~= stride then
                    return nil
                end

                return storedValue.shared
            end

            local collective = fixedTreeShared()
            for name in pairs(written) do
                holds(
                    crossRead[name] ~= true or collective == name,
                    "ordinary workgroup phase has a cross-lane scratch race"
                )
            end
            block(phase.body, values, derive(scope, {cursorBounds = {}, workgroup = true, inPhase = true}), stored)
        elseif statement.op == "lua_set_index" or statement.op == "lua_set_key" then
            local write = statement as scalarIR.LuaSet
            holds(scope.entryMode == "lua-builder", "Lua write outside a builder")
            holds(write.table.type == "lua_table", "Lua write target is not a fresh table handle")
            scalarWalk(write.table, values, scope)
            scalarWalk(write.key, values, scope)
            scalarWalk(write.value, values, scope)
            holds(verify.NUMERIC[write.key.type] == true or write.key.type == "lua_string", "unsupported Lua table key")
            holds(
                verify.NUMERIC[
                    write.value.type
                ] == true
                or write.value.type == "bool"
                or write.value.type == "lua_table"
                or write.value.type == "lua_string"
                or write.value.type == "lua_nil",
                "unsupported Lua table value"
            )
        elseif statement.op == "lua_string_buffer_append" then
            local appended = statement as scalarIR.LuaStringBufferAppend
            holds(scope.entryMode == "lua-builder", "string buffer append outside a builder")
            holds(
                appended.buffer.type == "lua_string_buffer" and appended.buffer.op == "local",
                "string append has no local buffer"
            )
            holds(appended.value.type == "lua_string", "string buffer appended a non-string")
            scalarWalk(appended.buffer, values, scope)
            scalarWalk(appended.value, values, scope)
        elseif statement.op == "simd_store4_u8" then
            local store = statement as scalarIR.Simd
            holds(
                scope.entryMode == "lua-builder" and store.type == "lua_effect",
                "SIMD interleaved store outside a builder"
            )
            holds(#store.args == 6, "invalid SIMD interleaved store")
            holds(
                store.args[1].type == "lua_scratch_u8" and store.args[1].op == "local",
                "SIMD interleaved store has no local buffer"
            )
            holds(store.args[2].type == "u32", "invalid SIMD interleaved store offset")
            for index = 3, 6 do
                holds(store.args[index].type == "simd_vector_u8", "invalid SIMD interleaved store operand")
            end
            for _, argument in ipairs(store.args) do
                scalarWalk(argument, values, scope)
            end
        elseif statement.op == "lua_scratch_u32_set" then
            local write = statement as scalarIR.LuaScratchU32Set
            holds(scope.entryMode == "lua-builder" and write.type == "lua_effect", "scratch write outside a builder")
            holds(
                fixedWidthAgrees(write.fixedBound, values, (write.scratch as scalarIR.Name).name),
                "scratch write bound is not the width of the buffer it writes"
            )
            holds(
                write.scratch.type == "lua_scratch_u32" and write.scratch.op == "local",
                "scratch write has no local buffer"
            )
            holds(write.index.type == "u32" and write.value.type == "u32", "invalid scratch write")
            scalarWalk(write.scratch, values, scope)
            scalarWalk(write.index, values, scope)
            scalarWalk(write.value, values, scope)
        elseif statement.op == "lua_scratch_u8_set"
            or statement.op == "lua_scratch_u8_set4"
            or statement.op == "lua_scratch_u8_reset"
        then
            local write = statement as scalarIR.LuaScratchU8Set
            holds(
                scope.entryMode == "lua-builder" and write.type == "lua_effect",
                "byte scratch write outside a builder"
            )
            holds(
                write.scratch.type == "lua_scratch_u8" and write.scratch.op == "local",
                "byte scratch write has no local buffer"
            )
            scalarWalk(write.scratch, values, scope)
            holds(
                statement.op ~= "lua_scratch_u8_reset" or values[
                    FIXED_WIDTH .. tostring((write.scratch as scalarIR.Name).name)
                ] == nil,
                "a fixed byte scratch cannot be reset"
            )
            if statement.op == "lua_scratch_u8_set" or statement.op == "lua_scratch_u8_set4" then
                holds(
                    write.index ~= nil and (
                        write.index as scalarIR.Expr
                    ).type == "u32" and write.value ~= nil and (write.value as scalarIR.Expr).type == "u32",
                    "invalid byte scratch write"
                )
                holds(
                    fixedWidthAgrees(write.fixedBound, values, (write.scratch as scalarIR.Name).name),
                    "byte scratch write bound is not the width of the buffer it writes"
                )
                scalarWalk(write.index as scalarIR.Expr, values, scope)
                scalarWalk(write.value as scalarIR.Expr, values, scope)
            else
                holds(write.index == nil and write.value == nil, "byte scratch reset carried operands")
            end
        elseif tostring(statement.op):match("^lua_builder_") ~= nil then
            local event = statement as scalarIR.LuaBuild
            holds(
                scope.entryMode == "lua-builder" and event.type == "lua_effect",
                "value stream event outside a builder"
            )
            holds(
                event.builder.type == "lua_builder" and event.builder.op == "local",
                "value stream event has no local builder"
            )
            scalarWalk(event.builder, values, scope)
            holds(
                (
                    event.mode == "eager" or event.mode == "pull" or event.mode == "serde"
                ) and scope.builderMode == event.mode,
                "unknown or inconsistent value stream event mode"
            )
            if event.op == "lua_builder_open_array" or event.op == "lua_builder_open_object" then
                holds(
                    event.capacity ~= nil and (event.capacity as scalarIR.Expr).type == "u32",
                    "invalid value stream capacity"
                )
                scalarWalk(event.capacity as scalarIR.Expr, values, scope)
            elseif event.op == "lua_builder_key" or event.op == "lua_builder_string" then
                holds(
                    event.sourceBytes ~= nil and (
                        (
                            event.sourceBytes as scalarIR.Expr
                        ).type == "lua_string" or (event.sourceBytes as scalarIR.Expr).type == "lua_bytes"
                    ) and event.start ~= nil and (
                        event.start as scalarIR.Expr
                    ).type == "u32" and event.length ~= nil and (
                        event.length as scalarIR.Expr
                    ).type == "u32" and event.escaped ~= nil and (event.escaped as scalarIR.Expr).type == "bool",
                    "invalid value stream string event"
                )
                for _, value in ipairs({event.sourceBytes, event.start, event.length, event.escaped}) do
                    scalarWalk(value as scalarIR.Expr, values, scope)
                end
            elseif event.op == "lua_builder_number_slice" or event.op == "lua_builder_integer_slice" then
                holds(
                    event.sourceBytes ~= nil and (
                        (
                            event.sourceBytes as scalarIR.Expr
                        ).type == "lua_string" or (event.sourceBytes as scalarIR.Expr).type == "lua_bytes"
                    ) and event.start ~= nil and (
                        event.start as scalarIR.Expr
                    ).type == "u32" and event.length ~= nil and (event.length as scalarIR.Expr).type == "u32",
                    "invalid value stream number slice"
                )
                for _, value in ipairs({event.sourceBytes, event.start, event.length}) do
                    scalarWalk(value as scalarIR.Expr, values, scope)
                end
            elseif event.op == "lua_builder_key_scratch" or event.op == "lua_builder_string_scratch" then
                holds(
                    event.scratch ~= nil and (
                        event.scratch as scalarIR.Expr
                    ).type == "lua_scratch_u8" and event.start ~= nil and (
                        event.start as scalarIR.Expr
                    ).type == "u32" and event.length ~= nil and (event.length as scalarIR.Expr).type == "u32",
                    "invalid value stream scratch string event"
                )
                scalarWalk(event.scratch as scalarIR.Expr, values, scope)
                scalarWalk(event.start as scalarIR.Expr, values, scope)
                scalarWalk(event.length as scalarIR.Expr, values, scope)
            elseif event.op == "lua_builder_key_escapes" or event.op == "lua_builder_string_escapes" then
                holds(
                    event.sourceBytes ~= nil and (
                        (
                            event.sourceBytes as scalarIR.Expr
                        ).type == "lua_string" or (event.sourceBytes as scalarIR.Expr).type == "lua_bytes"
                    ) and event.start ~= nil and (
                        event.start as scalarIR.Expr
                    ).type == "u32" and event.length ~= nil and (
                        event.length as scalarIR.Expr
                    ).type == "u32" and event.escapeScratch ~= nil and (
                        event.escapeScratch as scalarIR.Expr
                    ).type == "lua_scratch_u32" and event.escapeIndex ~= nil and (
                        event.escapeIndex as scalarIR.Expr
                    ).type == "u32" and event.escapeCount ~= nil and (event.escapeCount as scalarIR.Expr).type == "u32",
                    "invalid value stream indexed escape event"
                )
                for _, value in ipairs({
                    event.sourceBytes,
                    event.start,
                    event.length,
                    event.escapeScratch,
                    event.escapeIndex,
                    event.escapeCount,
                }) do
                    scalarWalk(value as scalarIR.Expr, values, scope)
                end
            elseif event.op == "lua_builder_number" then
                holds(event.value ~= nil and (event.value as scalarIR.Expr).type == "f64", "invalid streamed number")
                scalarWalk(event.value as scalarIR.Expr, values, scope)
            elseif event.op == "lua_builder_integer64" then
                holds(
                    event.value ~= nil and (
                        event.value as scalarIR.Expr
                    ).type == "u64" and event.negative ~= nil and (event.negative as scalarIR.Expr).type == "bool",
                    "invalid streamed uint64 integer"
                )
                scalarWalk(event.value as scalarIR.Expr, values, scope)
                scalarWalk(event.negative as scalarIR.Expr, values, scope)
            elseif event.op == "lua_builder_decimal64" then
                holds(
                    event.sourceBytes ~= nil and (
                        (
                            event.sourceBytes as scalarIR.Expr
                        ).type == "lua_string" or (event.sourceBytes as scalarIR.Expr).type == "lua_bytes"
                    ) and event.start ~= nil and (
                        event.start as scalarIR.Expr
                    ).type == "u32" and event.length ~= nil and (
                        event.length as scalarIR.Expr
                    ).type == "u32" and event.value ~= nil and (
                        event.value as scalarIR.Expr
                    ).type == "u64" and event.exponent ~= nil and (
                        event.exponent as scalarIR.Expr
                    ).type == "i32" and event.negative ~= nil and (
                        event.negative as scalarIR.Expr
                    ).type == "bool" and event.exact ~= nil and (event.exact as scalarIR.Expr).type == "bool",
                    "invalid streamed decimal64"
                )
                for _, value in ipairs({
                    event.sourceBytes,
                    event.start,
                    event.length,
                    event.value,
                    event.exponent,
                    event.negative,
                    event.exact,
                }) do
                    scalarWalk(value as scalarIR.Expr, values, scope)
                end
            elseif event.op == "lua_builder_boolean" then
                holds(event.value ~= nil and (event.value as scalarIR.Expr).type == "bool", "invalid streamed boolean")
                scalarWalk(event.value as scalarIR.Expr, values, scope)
            else
                holds(event.op == "lua_builder_null" or event.op == "lua_builder_close", "unknown value stream event")
            end
        elseif statement.op == "assign" then
            for _, entry in ipairs(statement.values) do
                assignment(entry, values, scope, stored)
            end
            for _, entry in ipairs(statement.values) do
                local target = entry.target
                if target.kind == "local" and target.name ~= nil then
                    scope.cursorBounds[target.name as string] = nil
                    values[LENGTH_OF .. (target.name as string)] = nil
                    local scratchLength = scratchLengthSource(entry.value, values)
                    if scratchLength ~= nil then
                        values[SCRATCH_LENGTH .. (target.name as string)] = scratchLength as string
                    else
                        values[SCRATCH_LENGTH .. (target.name as string)] = nil
                    end
                end
            end
        elseif statement.op == "if" then
            local invalidated: {[string]: boolean} = {}
            if statement.nativeSwitch ~= nil then
                nativeSwitch(statement, values, scope)
            end
            for _, clause in ipairs(statement.clauses) do
                holds(clause.condition.type == "bool", "non-boolean branch")
                scalarWalk(clause.condition, values, scope)
                local nestedScope = derive(scope, {
                    cursorBounds = proveCursorBounds(
                        clause.condition,
                        clause.cursorBounds,
                        values,
                        scope,
                        nil,
                        "invalid cursor bounds proof"
                    ),
                    localReadLimit = (function(): integer?
                        local condition = clause.condition
                        if condition.op == "lt" then
                            local comparison = condition as scalarIR.Binary
                            if comparison.left.op == "local_index" and comparison.right.op == "constant_i32" then
                                return tonumber((comparison.right as scalarIR.IntConstant).value) as integer?
                            end
                        end

                        return scope.localReadLimit
                    end)(),
                    localReadMinimum = (function(): integer?
                        local condition = clause.condition
                        if condition.op == "ge" then
                            local comparison = condition as scalarIR.Binary
                            if comparison.left.op == "local_index" and comparison.right.op == "constant_i32" then
                                return tonumber((comparison.right as scalarIR.IntConstant).value) as integer?
                            end
                        end

                        return scope.localReadMinimum
                    end)(),
                })
                block(clause.body, values, nestedScope, stored)
                for name in pairs(scope.cursorBounds) do
                    if nestedScope.cursorBounds[name] == nil then
                        invalidated[name] = true
                    end
                end
            end
            if statement.elseBody ~= nil then
                block(statement.elseBody or {}, values, scope, stored)
            end
            for name in pairs(invalidated) do
                scope.cursorBounds[name] = nil
            end
        elseif statement.op == "fornum" then
            for _, bound in ipairs({statement.from, statement.to}) do
                holds(bound.type == "i32" or bound.type == "u32" or bound.type == "f64", "non-numeric for bound")
                scalarWalk(bound, values, scope)
            end
            holds(statement.binding.type == "i32", "for induction variable type")

            local inner = inherit(values)
            inner[statement.binding.name] = "i32"
            -- Only this loop's own bound proves an index under it, so the map's
            -- guarded spans do not carry in.
            local nestedScope = derive(scope, {
                index = statement.binding.name,
                boundSpan = statement.boundSpan,
                mapIndex = false,
                cursorBounds = proveCursorBounds(
                    statement.from,
                    nil,
                    values,
                    scope,
                    statement.body,
                    "invalid loop cursor bounds proof"
                ),
            })
            nestedScope.indexSpans = nil
            if statement.boundSpan ~= nil then
                holds(
                    statement.from.op == "constant_i32" and (
                        statement.from as scalarIR.IntConstant
                    ).value == "1" and statement.to.op == "span_count" and (
                        statement.to as scalarIR.SpanCount
                    ).span == statement.boundSpan,
                    "invalid counted span loop proof"
                )
            end
            block(statement.body, inner, nestedScope, stored)
            invalidateCursors(scope, nestedScope)
        elseif statement.op == "while" then
            holds(statement.condition.type == "bool", "non-boolean loop condition")
            scalarWalk(statement.condition, values, scope)
            local nestedScope = derive(scope, {
                cursorBounds = proveCursorBounds(
                    statement.condition,
                    statement.cursorBounds,
                    values,
                    scope,
                    statement.body,
                    "invalid loop cursor bounds proof"
                ),
            })
            block(statement.body, values, nestedScope, stored)
            invalidateCursors(scope, nestedScope)
        elseif statement.op == "block" then
            block(statement.body, values, scope, stored)
        elseif statement.op == "return" then
            holds(#statement.values == #scope.resultTypes, "invalid AOT return count")
            for position, value in ipairs(statement.values) do
                holds(value.type == scope.resultTypes[position], "invalid AOT return type")
                scalarWalk(value, values, scope)
            end
        else
            holds(statement.op == "break" or statement.op == "continue", "unknown statement opcode")
        end
    end
end

--- Checks one block of lane statements, and everything under it.
---
--- `loopContext` is the lane loop this block is inside, or nothing at the top.
--- A `break` or `continue` names the masks it retires from, and they have to be
--- that loop's: retiring from a loop this statement is not in would be control
--- flow that no mask expresses. `direct` says whether this block is that
--- loop's own body rather than one nested under a uniform loop inside it,
--- which is the only place the emitter honours an exit-when-empty break.
local function validImmediateExit(statements: {any}): boolean
    local hasImmediateExit = false
    for _, statement in ipairs(statements) do
        hasImmediateExit = hasImmediateExit or (statement.op == "vbreak" and statement.exitWhenEmpty == true)
    end
    if not hasImmediateExit then
        return true
    end

    local marked = false
    local prefixSafe = true
    for _, statement in ipairs(statements) do
        if statement.op == "vbreak" and statement.exitWhenEmpty == true then
            if marked or not prefixSafe then
                return false
            end
            marked = true
        elseif statement.op == "vcontinue" then
            return false
        elseif not marked then
            if statement.op == "let" then
                -- Lane expressions are pure.
            elseif statement.op == "vassign" then
                for _, assignment in ipairs(statement.values) do
                    if assignment.target.kind ~= "local" then
                        prefixSafe = false
                    end
                end
            else
                prefixSafe = false
            end
        end
    end

    return true
end

local function laneBlock(
    statements: {any},
    inherited: {[string]: string},
    context: verify.Context,
    loopContext: any,
    direct: boolean
): nil
    local mask = context.shape.mask
    local values = inherit(inherited)
    for _, statement in ipairs(statements) do
        if statement.op == "let" then
            laneHolds(
                values[statement.name] == nil and statement.type == statement.value.type,
                "invalid lane local declaration"
            )
            laneWalk(statement.value, values, context)
            values[statement.name] = statement.type
        elseif statement.op == "multi_let" then
            -- A uniform call, left as the statement it was. Nothing about it is
            -- lane-typed, so the scalar rules are the ones that apply.
            scalarWalk(statement.call, values, context.scope)

            local resultTypes = statement.call.resultTypes or {}
            laneHolds(
                statement.call.type == "multi" and #statement.bindings == #resultTypes,
                "a uniform lane-body multiple binding that does not match its call"
            )
            for position, bound in ipairs(statement.bindings) do
                laneHolds(
                    values[bound.name] == nil and bound.type == resultTypes[position],
                    "an invalid uniform lane-body multiple binding"
                )
                values[bound.name] = bound.type
            end
        elseif statement.op == "vassign" then
            for _, entry in ipairs(statement.values) do
                local target = entry.target
                laneWalk(entry.value, values, context)
                if target.kind == "local" then
                    laneHolds(values[target.name] == entry.value.type, "invalid lane local assignment")
                elseif target.kind == "vfield" then
                    local root = context.scope.spans[target.span]
                    local layout = context.scope.layouts[target.layout]
                    laneHolds(
                        root ~= nil and root.kind == "write_span" and root.type == "struct:" .. tostring(
                            target.layout
                        ) and layout ~= nil and (
                            layout.fieldTypes or {}
                        )[
                            target.field
                        ] == target.scalarType and (
                            layout.fieldSourceTypes or {}
                        )[
                            target.field
                        ] == storageSource(
                            target.scalarType,
                            target.sourceType
                        ) and validStorage(
                            target.scalarType,
                            target.sourceType
                        ) and entry.value.type == context.shape.vectorFor[target.scalarType],
                        "invalid lane field assignment"
                    )
                elseif target.kind == "vspan" then
                    local root = context.scope.spans[target.span]
                    laneHolds(
                        root ~= nil and root.kind == "write_span" and root.type == target.scalarType and storageSource(
                            root.type,
                            root.sourceType
                        ) == storageSource(
                            target.scalarType,
                            target.sourceType
                        ) and validStorage(
                            target.scalarType,
                            target.sourceType
                        ) and entry.value.type == context.shape.vectorFor[target.scalarType],
                        "invalid lane span assignment"
                    )
                else
                    refuse("invalid lane IR: an unknown assignment target")
                end
            end
        elseif statement.op == "vwhile" then
            laneHolds(
                statement.live.type == mask
                and statement.executing.type == mask
                and statement.live.name ~= statement.executing.name
                and values[
                    statement.live.name
                ] == nil and values[statement.executing.name] == nil,
                "invalid lane-loop mask bindings"
            )
            laneWalk(statement.initial, values, context)
            laneWalk(statement.condition, values, context)
            laneHolds(
                statement.initial.type == mask and statement.condition.type == mask,
                "invalid lane-loop condition"
            )
            laneHolds(validImmediateExit(statement.body), "invalid immediate lane-loop exit")

            local inner = inherit(values)
            inner[statement.live.name] = mask
            inner[statement.executing.name] = mask
            laneBlock(statement.body, inner, context, statement, true)
        elseif statement.op == "vwhile_uniform" then
            -- No masks, because there is nothing for them to say: the condition
            -- is an ordinary scalar and every lane runs the loop the same
            -- number of times. It is checked as one, against the scalar rules.
            scalarWalk(statement.condition, values, context.scope)
            laneHolds(statement.condition.type == "bool", "a uniform lane loop without a boolean condition")
            -- Not a direct child of the lane loop: a break that exits when the
            -- gang empties is only emitted at the loop body's own level.
            laneBlock(statement.body, values, context, loopContext, false)
        elseif statement.op == "vbreak" or statement.op == "vcontinue" then
            laneHolds(
                loopContext ~= nil
                and statement.live.name == loopContext.live.name
                and statement.executing.name == loopContext.executing.name,
                "lane loop control escaped its loop"
            )
            laneWalk(statement.mask, values, context)
            laneHolds(statement.mask.type == mask, "lane loop control needs a mask")
            laneHolds(
                statement.exitWhenEmpty == nil
                or statement.op == "vbreak"
                and statement.exitWhenEmpty == true
                and direct == true,
                "invalid immediate lane-loop exit"
            )
        else
            refuse("unknown lane statement opcode " .. tostring(statement.op))
        end
    end
end

----------------------------------------------------------------------------
-- Whole programs
----------------------------------------------------------------------------

--- Indexes the layouts, filling in each one's fields by name.
local function layoutsByName(program: scalarIR.Program): {[string]: scalarIR.Layout}
    local layouts: {[string]: scalarIR.Layout} = {}
    for _, layout in ipairs(program.layouts or {}) do
        holds(layouts[layout.name] == nil and layout.cName ~= nil and #layout.fields > 0, "invalid native layout")

        local fields: {[string]: scalarIR.Type} = {}
        local sources: {[string]: string} = {}
        for _, field in ipairs(layout.fields) do
            holds(
                fields[field.name] == nil and validStorage(field.type, field.sourceType),
                "invalid native layout field"
            )
            fields[field.name] = field.type
            sources[field.name] = storageSource(field.type, field.sourceType)
        end
        layout.fieldTypes = fields
        layout.fieldSourceTypes = sources
        layouts[layout.name] = layout
    end

    return layouts
end

--- What the signature says, checked against itself.
---
--- Returns the parameters by name, the regions by name, which spans may be
--- written, and the primary output the loop is bounded by.
local function signature(
    program: scalarIR.Program,
    layouts: {[string]: scalarIR.Layout}
): ({[string]: scalarIR.Param}, {[string]: scalarIR.Param}, {[string]: boolean}, scalarIR.Param?)
    local byName: {[string]: scalarIR.Param} = {}
    local byRegion: {[string]: scalarIR.Param} = {}
    local writes: {[string]: boolean} = {}
    local primary: scalarIR.Param? = nil
    for _, param in ipairs(program.params) do
        holds(byName[param.name] == nil, "duplicate IR parameter")
        holds(
            param.kind == "write_span"
            or param.kind == "read_span"
            or param.kind == "uniform"
            or param.kind == "scalar",
            "unknown IR parameter kind"
        )
        if param.kind == "uniform" then
            holds(
                (verify.NUMERIC[param.type] == true or param.type == "bool") and param.region == nil,
                "invalid IR uniform"
            )
        elseif param.kind == "scalar" then
            holds(
                program.entryMode == "lua-builder" and (
                    param.type == "lua_string" or param.type == "lua_bytes" or param.type == "lua_value"
                ) and param.region == nil,
                "invalid Lua builder scalar"
            )
        else
            local structName = param.type:match("^struct:(.+)$")
            local element = structName == nil and validStorage(
                param.type,
                param.sourceType
            ) or structName ~= nil and param.sourceType == nil and layouts[tostring(structName)] ~= nil
            holds(element and param.region ~= nil and byRegion[tostring(param.region)] == nil, "invalid IR span")
            holds(param.access == (param.kind == "write_span" and "readwrite" or "read"), "invalid IR region access")
            byRegion[tostring(param.region)] = param
            if param.kind == "write_span" then
                writes[param.name] = true
                primary = primary or param
            end
        end
        byName[param.name] = param
    end
    if program.loop ~= nil then
        holds(
            primary ~= nil and (program.loop as scalarIR.Loop).count == (primary as scalarIR.Param).name,
            "loop is not bounded by its primary output"
        )
    end

    return byName, byRegion, writes, primary
end

--- The regions and the alias facts over them.
---
--- The matrix is required to be complete rather than merely consistent: a pair
--- with no fact would be a pair whose `restrict` nobody justified, and the
--- count is what catches that.
local function regions(program: scalarIR.Program, byRegion: {[string]: scalarIR.Param}): nil
    local declared: {[string]: boolean} = {}
    for _, region in ipairs(program.regions) do
        local param = byRegion[region.id]
        holds(param ~= nil and declared[region.id] == nil, "invalid or duplicate region declaration")

        local span = param as scalarIR.Param
        holds(region.param == span.name and region.access == span.access, "region declaration mismatch")
        holds(region.proof == tostring(span.ownership) .. "_borrow", "invalid region proof")
        declared[region.id] = true
    end

    local count = 0
    for id in pairs(byRegion) do
        holds(declared[id] == true, "undeclared parameter region")
        count = count + 1
    end

    local seen: {[string]: boolean} = {}
    for _, fact in ipairs(program.aliasFacts) do
        holds(
            byRegion[fact.left] ~= nil and byRegion[fact.right] ~= nil and fact.left ~= fact.right,
            "alias fact references an invalid region"
        )

        local key = fact.left < fact.right and fact.left .. ":" .. fact.right or fact.right .. ":" .. fact.left
        holds(seen[key] == nil, "duplicate alias fact")

        local hasWrite = (
            byRegion[fact.left] as scalarIR.Param
        ).kind == "write_span" or (byRegion[fact.right] as scalarIR.Param).kind == "write_span"
        holds(fact.relation == (hasWrite and "disjoint" or "may_alias"), "invalid alias relationship")
        holds(fact.proof == (hasWrite and "exclusive_borrow" or "shared_borrows"), "invalid alias proof")
        seen[key] = true
    end
    holds(#program.aliasFacts == count * (count - 1) / 2, "incomplete alias matrix")
end

--- The loop's bounds, and the length agreements that make them cover every
--- span rather than only the one they were written against.
local function bounds(program: scalarIR.Program, byName: {[string]: scalarIR.Param}, primary: scalarIR.Param?): nil
    if program.loop == nil then
        holds(program.rangeGuard == nil and #program.guards == 0, "a block kernel carried map-loop bounds")
        return
    end
    local loop = program.loop as scalarIR.Loop
    holds(primary ~= nil, "a map loop has no primary output")
    local primary_ = primary as scalarIR.Param
    local rangeGuard = program.rangeGuard
    if rangeGuard ~= nil then
        local guard = rangeGuard as scalarIR.RangeGuard
        holds(
            loop.first == guard.first and loop.last == guard.last and guard.count == primary_.name,
            "loop range proof mismatch"
        )
        holds(
            byName[
                guard.first
            ] ~= nil and (
                byName[guard.first] as scalarIR.Param
            ).sourceType == "integer" and byName[
                guard.last
            ] ~= nil and (byName[guard.last] as scalarIR.Param).sourceType == "integer",
            "range proof does not use integer uniforms"
        )
    else
        holds(loop.first == 1 and loop.last == primary_.name, "invalid full-span loop")
    end

    local guarded: {[string]: boolean} = {}
    for _, guard in ipairs(program.guards) do
        holds(guard.op == "equal_count" and guard.left == primary_.name, "invalid IR guard")
        holds(byName[guard.right] ~= nil and (byName[guard.right] as scalarIR.Param).region ~= nil, "guarded non-span")
        holds(guarded[guard.right] == nil, "duplicate IR guard")
        guarded[guard.right] = true
    end
    -- A map kernel may relate spans no equality can spell, so a span may go
    -- unguarded. What keeps that sound is the access rule: the body walk accepts
    -- the loop index only against `indexSpans`, so an unguarded span is
    -- reachable through proved cursors alone.
end

--- The helper bodies, each of which is one return list and nothing else.
local function helperBodies(program: scalarIR.Program, scope: verify.Scope): nil
    for _, helper in ipairs(program.helpers or {}) do
        -- A native call names another compiled entry, so there is no body here to
        -- check: what it means is that entry's own verified program.
        if helper.native == true then
            holds(#helper.values == 0, "a native call carries a body")
            holds(#helper.resultTypes == 1, "a native call returns one value")
        end
        local values: {[string]: string} = {}
        for _, param in ipairs(helper.params) do
            holds(values[param.name] == nil, "duplicate helper parameter")
            values[param.name] = param.type
        end
        -- A compile-time byte table is file-scope static data in the emitted
        -- translation unit, so a helper body reads one exactly as the entry
        -- body does. The entry's scope already carries them; a helper's did
        -- not, which made an ordinary `const` read inside a helper fail this
        -- invariant rather than compile.
        for _, constant in ipairs(program.constants or {}) do
            holds(values[constant.cName] == nil, "an IR constant table shadows a helper parameter")
            values[constant.cName] = "lua_string"
        end
        holds(
            helper.native == true or #helper.values == #helper.resultTypes and helper.resultType == helper.resultTypes[
                1
            ],
            "helper result mismatch"
        )
        for position, value in ipairs(helper.values) do
            holds(value.type == helper.resultTypes[position], "helper result type mismatch")
            scalarWalk(value, values, scope)
        end
    end
end

--- Conservative Lua stack demand and whether an expression allocates a table.
local function constructionExpression(node: scalarIR.Expr): (integer, boolean)
    if node.op == "lua_concat" then
        local joined = node as scalarIR.LuaConcat
        local left = constructionExpression(joined.left)
        local right = constructionExpression(joined.right)
        return math.max(left, 1 + right) as integer, false
    elseif node.op == "lua_substring" or node.op == "lua_table_get_index" then
        return 1, false
    elseif node.op ~= "lua_new_table" then
        return 0, false
    end
    local depth = 1
    for _, field in ipairs((node as scalarIR.LuaNewTable).fields or {}) do
        for _, value in ipairs({field.key, field.value}) do
            local nested = constructionExpression(value)
            depth = math.max(depth, 1 + nested) as integer
        end
    end

    return depth as integer, true
end

--- Computes a conservative entry stack reservation.
---
--- A table local inside a loop would retain one VM stack root per iteration in
--- the current physical assignment, so it is rejected rather than relying on
--- an unbounded stack. Nested literals consumed directly by raw-set are bounded
--- by their authored depth and are included in the reservation.
local function constructionStack(statements: {scalarIR.Statement}, inLoop: boolean): (integer, integer)
    local roots, depth = 0, 0
    for _, statement in ipairs(statements) do
        if statement.op == "let" then
            local nested, allocates = constructionExpression(statement.value)
            holds(not (inLoop and allocates), "fresh Lua table allocation inside a loop is not stack bounded")
            holds(
                not (inLoop and statement.type == "lua_builder"),
                "value stream creation inside a loop is not stack bounded"
            )
            holds(
                not (inLoop and statement.type == "lua_scratch_u32"),
                "scratch allocation inside a loop is not stack bounded"
            )
            holds(
                not (inLoop and statement.type == "lua_scratch_u8"),
                "byte scratch allocation inside a loop is not stack bounded"
            )
            holds(
                not (inLoop and statement.type == "lua_string_buffer"),
                "string accumulation inside a loop is not stack bounded"
            )
            depth = math.max(depth, nested)
            if statement.type == "lua_table"
                or statement.type == "lua_string"
                or statement.type == "lua_nil"
                or statement.type == "lua_value"
                or statement.type == "lua_scratch_u32"
                or statement.type == "lua_scratch_u8"
            then
                roots = roots + 1
            elseif statement.type == "lua_builder" then
                -- Frames are rooted immediately. Transformed-byte scratch is
                -- allocated lazily and inserted beside it on first use.
                roots = roots + 2
            end
        elseif statement.op == "lua_set_index" or statement.op == "lua_set_key" then
            local write = statement as scalarIR.LuaSet
            local keyDepth = constructionExpression(write.key)
            local valueDepth, allocates = constructionExpression(write.value)
            holds(not (inLoop and allocates), "fresh Lua table allocation inside a loop is not stack bounded")
            depth = math.max(depth, keyDepth, valueDepth) as integer
        elseif statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                local nestedRoots, nestedDepth = constructionStack(clause.body, inLoop)
                roots = roots + nestedRoots
                depth = math.max(depth, nestedDepth) as integer
            end
            local nestedRoots, nestedDepth = constructionStack(statement.elseBody or {}, inLoop)
            roots = roots + nestedRoots
            depth = math.max(depth, nestedDepth) as integer
        elseif statement.op == "fornum" or statement.op == "while" then
            local nestedRoots, nestedDepth = constructionStack(statement.body, true)
            roots = roots + nestedRoots
            depth = math.max(depth, nestedDepth) as integer
        elseif statement.op == "block" then
            local nestedRoots, nestedDepth = constructionStack(statement.body, inLoop)
            roots = roots + nestedRoots
            depth = math.max(depth, nestedDepth) as integer
        end
    end

    return roots as integer, depth as integer
end

--- Counts stream-builder declarations through every authored branch.
---
--- One stream owns the dynamic top of the Lua stack. Interleaving two would
--- make a close from one consume the other's unfinished table, so the current
--- physical assignment admits at most one per entry.
local function streamBuilders(statements: {scalarIR.Statement}): number
    local count = 0
    for _, statement in ipairs(statements) do
        if statement.op == "let" and statement.type == "lua_builder" then
            count = count + 1
        elseif statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                count = count + streamBuilders(clause.body)
            end
            count = count + streamBuilders(statement.elseBody or {})
        elseif statement.op == "fornum" or statement.op == "while" or statement.op == "block" then
            count = count + streamBuilders(statement.body)
        end
    end

    return count
end

local BUFFER_BLOCKING_ROOTS: {
    [string]: boolean
} = {
    lua_table = true,
    lua_string = true,
    lua_nil = true,
    lua_value = true,
    lua_builder = true,
    lua_scratch_u32 = true,
    lua_scratch_u8 = true,
}

--- Ensures the auxiliary-library buffer owns the top of the Lua stack.
---
--- `luaL_Buffer` may retain completed chunks there. Balanced VM reads and
--- writes can run above them, but a later persistent root would become part of
--- the buffer's eventual concat. The conservative lexical walk also admits at
--- most one such buffer per entry.
local function stringBufferOrder(statements: {scalarIR.Statement}, seen: boolean): (boolean, integer)
    local count: integer = 0
    for _, statement in ipairs(statements) do
        if statement.op == "let" and statement.type == "lua_string_buffer" then
            seen = true
            count = count + 1
        elseif statement.op == "let" and seen and BUFFER_BLOCKING_ROOTS[tostring(statement.type)] then
            holds(false, "a persistent Lua root follows a string accumulator")
        elseif statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                local nestedSeen, nestedCount = stringBufferOrder(clause.body, seen)
                seen = seen or nestedSeen
                count = (count + nestedCount) as integer
            end
            local nestedSeen, nestedCount = stringBufferOrder(statement.elseBody or {}, seen)
            seen = seen or nestedSeen
            count = (count + nestedCount) as integer
        elseif statement.op == "fornum" or statement.op == "while" or statement.op == "block" then
            local nestedSeen, nestedCount = stringBufferOrder(statement.body, seen)
            seen = seen or nestedSeen
            count = (count + nestedCount) as integer
        end
    end

    return seen, count
end

--- Checks one whole AOT program, and everything under it.
---
--- @param program the lowered function
--- @return the same program, so a caller may verify and use it in one step
--- @raises when anything about it is not well formed
function verify.program(program: scalarIR.Program): scalarIR.Program
    holds(program.version == scalarIR.VERSION, "unknown native C IR version")
    holds(program.symbol == scalarIR.privateSymbol(program.name), "private symbol does not match function identity")
    holds(program.entryMode == "kernel" or program.entryMode == "lua-builder", "invalid AOT entry mode")
    if program.entryMode == "lua-builder" then
        holds(
            program.runtimeAbi == "lua-5.1" and program.registrar ~= nil and (
                program.registrar as string
            ):match("^ks_register_[0-9a-f]+$") ~= nil,
            "invalid Lua builder registration ABI"
        )
        for _, param in ipairs(program.params) do
            holds(param.kind == "uniform" or param.kind == "scalar", "Lua builder parameter needs a VM-stack ABI")
        end
        local roots, depth = constructionStack(program.body or {}, false)
        holds(
            program.builderMode == nil
            or program.builderMode == "eager"
            or program.builderMode == "pull"
            or program.builderMode == "serde",
            "invalid program value stream mode"
        )
        holds(streamBuilders(program.body or {}) <= 1, "a Lua builder entry has more than one value stream")
        local _, stringBufferCount = stringBufferOrder(program.body or {}, false)
        holds(stringBufferCount <= 1, "a Lua builder entry has more than one string accumulator")
        local needed = roots + depth + 4
        holds(needed <= 256, "Lua builder exceeds the 256-slot construction limit")
        holds(program.maxStack == nil or program.maxStack == needed, "Lua builder stack bound changed")
        program.maxStack = needed
    else
        holds(
            program.runtimeAbi == nil
            and program.registrar == nil
            and program.maxStack == nil
            and program.builderMode == nil,
            "kernel carried a Lua runtime ABI"
        )
    end

    local layouts = layoutsByName(program)
    local byName, byRegion, writes, primary = signature(program, layouts)
    bounds(program, byName, primary)
    regions(program, byRegion)

    local helpers: {[string]: scalarIR.Helper} = {}
    for _, helper in ipairs(program.helpers or {}) do
        holds(helpers[helper.name] == nil, "duplicate IR helper")
        helpers[helper.name] = helper
    end

    local loop = program.loop
    local body = program.body
    local workgroup = program.workgroup
    local forms = (loop ~= nil and 1 or 0) + (body ~= nil and 1 or 0) + (workgroup ~= nil and 1 or 0)
    holds(
        forms == 1,
        "an AOT program needs exactly one body form: " .. tostring(
            loop ~= nil
        ) .. "/" .. tostring(body ~= nil) .. "/" .. tostring(workgroup ~= nil)
    )
    local sharedTypes: {[string]: scalarIR.Type}? = nil
    local sharedCounts: {[string]: integer}? = nil
    if workgroup ~= nil then
        local phased = workgroup as scalarIR.Workgroup
        holds(
            program.executionTarget == "gpu"
            and program.entryMode == "kernel"
            and phased.size >= 1
            and phased.size <= 256
            and phased.groups.type == "u32"
            and byName[
                phased.dispatchSpan
            ] ~= nil,
            "invalid GPU workgroup contract"
        )
        local scratchTypes: {[string]: scalarIR.Type} = {}
        local scratchCounts: {[string]: integer} = {}
        sharedTypes = scratchTypes
        sharedCounts = scratchCounts
        local scratchBytes = 0
        for _, scratch in ipairs(phased.shared) do
            local unique = scratchTypes[scratch.name] == nil
            local physical = scratch.element == "f32" or scratch.element == "i32" or scratch.element == "u32"
            local initialized = scratch.initial.type == scratch.element
            holds(
                unique and physical and initialized and scratch.count == phased.size,
                "invalid workgroup scratch declaration"
            )
            scratchTypes[scratch.name] = scratch.element
            scratchCounts[scratch.name] = scratch.count
            scratchBytes = scratchBytes + scratch.count * 4
        end
        holds(scratchBytes <= 16384, "workgroup scratch exceeds the portable limit")
    end
    local resultTypes = program.resultTypes or {}
    local sourceResults = program.resultSourceTypes or {}
    holds(#resultTypes == #sourceResults and #resultTypes <= 4, "invalid AOT entry results")
    for _, resultType in ipairs(resultTypes) do
        holds(
            verify.NUMERIC[
                resultType
            ] == true or resultType == "bool" or program.entryMode == "lua-builder" and (
                resultType == "lua_table"
                or resultType == "lua_string"
                or resultType == "lua_nil"
                or resultType == "lua_value"
            ),
            "invalid AOT entry result type"
        )
    end
    if program.usesSimd == true then
        holds(body ~= nil and loop == nil and workgroup == nil, "explicit SIMD requires a block kernel")
        holds(program.simdWidth == nil or program.simdWidth == 16 or program.simdWidth == 32, "invalid SIMD width")
    else
        holds(program.simdWidth == nil, "a scalar program carries a SIMD width")
    end

    local indexSpans: {[string]: boolean}? = nil
    if loop ~= nil then
        local provable: {[string]: boolean} = {[(loop as scalarIR.Loop).count] = true}
        for _, guard in ipairs(program.guards) do
            provable[guard.left] = true
            provable[guard.right] = true
        end
        indexSpans = provable
    end
    local scope = new verify.Scope(
        spans = byName,
        layouts = layouts,
        helpers = helpers,
        writes = writes,
        index = loop ~= nil and (loop as scalarIR.Loop).index or nil,
        boundSpan = loop ~= nil and (loop as scalarIR.Loop).count or nil,
        mapIndex = loop ~= nil,
        indexSpans = indexSpans,
        cursorBounds = {},
        resultTypes = resultTypes,
        entryMode = program.entryMode,
        builderMode = program.builderMode,
        workgroup = workgroup ~= nil,
        inPhase = false,
        shared = sharedTypes,
        sharedCounts = sharedCounts
    )
    helperBodies(program, scope)

    local uniforms: {[string]: string} = {}
    for _, param in ipairs(program.params) do
        if param.kind == "uniform" or param.kind == "scalar" then
            uniforms[param.name] = param.type
        end
    end
    -- A compile-time byte table reads exactly as a rooted string argument does,
    -- so it enters the body's scope the same way. Its bytes are the emitter's
    -- business; what has to hold here is that nothing declares a name over one
    -- and that every reader finds it typed.
    local constantNames: {[string]: boolean} = {}
    for _, constant in ipairs(program.constants or {}) do
        holds(constantNames[constant.cName] == nil, "duplicate IR constant table")
        holds(uniforms[constant.cName] == nil, "an IR constant table shadows a parameter")
        constantNames[constant.cName] = true
        uniforms[constant.cName] = "lua_string"
    end

    -- The reuse claim, re-derived rather than trusted. A program carrying a
    -- scratch name it did not earn would share a live buffer between two
    -- calls, so the fact is checked here and not left to the backend that
    -- acts on it.
    holds(
        program.reusableScratch == visit.reusableScratch(program),
        "the recorded reusable byte scratch is not the one this program proves"
    )

    local stored: {[string]: boolean} = {}
    if workgroup ~= nil then
        local phased = workgroup as scalarIR.Workgroup
        block(phased.prelude, uniforms, scope, stored, true)
        scalarWalk(phased.groups, uniforms, scope)
        for _, scratch in ipairs(phased.shared) do
            scalarWalk(scratch.initial, uniforms, scope)
        end
        block(phased.statements, uniforms, scope, stored, true)
    else
        block(loop ~= nil and (loop as scalarIR.Loop).statements or body or {}, uniforms, scope, stored)
    end
    if loop ~= nil or workgroup ~= nil then
        for output in pairs(writes) do
            if (byName[output] as scalarIR.Param).type:match("^struct:") == nil then
                holds(stored[output] == true, "scalar IR output is never stored")
            end
        end
    end

    local lanes = program.lanes
    if lanes ~= nil then
        holds(loop ~= nil, "a general block kernel carried scalar-source lanes")
        local body = lanes as scalarIR.LaneBody
        local shape = lane.SHAPE_BY_NAME[body.shape]
        holds(
            program.vectorizeAttempted == true and shape ~= nil and body.lanes == (shape as lane.Shape).lanes,
            "invalid lane width or missing SIMD contract"
        )
        local binaries, unaries = laneSignatures(shape as lane.Shape)
        laneBlock(
            body.statements,
            uniforms,
            new verify.Context(
                shape = shape as lane.Shape,
                scope = scope,
                admitted = laneTypes(shape as lane.Shape),
                binaries = binaries,
                unaries = unaries
            ),
            nil,
            false
        )
    end

    return program
end

export = verify
