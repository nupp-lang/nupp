                    context.reject(
                        lower.site(node),
                        "valuebuilder.decimal64 takes a source slice, uint64 magnitude, int32 exponent, sign, and exactness"
                    )
                end
                event.sourceBytes, event.start, event.length = args[2], args[3], args[4]
                event.value, event.exponent, event.negative, event.exact = args[5], args[6], args[7], args[8]
            elseif action == "boolean" then
                if #args ~= 2 or args[2].type ~= "bool" then
                    context.reject(lower.site(node), "valuebuilder.boolean takes one boolean")
                end
                event.value = args[2]
            elseif #args ~= 1 then
                context.reject(lower.site(node), "valuebuilder event takes only its builder")
            end
            markLua(kernel, lower.site(node))
            return event
        end
    end
    if identity == "table.new"
        or path == "table.new"
        and kernel.modules.table == "@prelude.table"
        and environment.table == nil
    then
        if #args ~= 2 then
            context.reject(lower.site(node), "table.new in an AOT builder takes array and hash capacities")
        end
        for _, capacity in ipairs(args) do
            if capacity.type ~= "f64" and capacity.type ~= "i32" and capacity.type ~= "u32" then
                context.reject(lower.site(node), "table.new capacities must be numeric")
            end
        end
        markLua(kernel, lower.site(node))

        return new scalarIR.LuaNewTable(
            op = "lua_new_table",
            arrayCapacity = args[1],
            hashCapacity = args[2],
            type = "lua_table",
            source = lower.site(node)
        )
    end
    -- The checker follows definitions through local aliases and publishes the
    -- canonical fixed-width identity on the call. A spelling lookup remains
    -- only for the standalone parser harness; production lowering must not
    -- turn `local add = nupp.math.u32.add` into an unrelated helper call.
    local fixedIdentity = (node as any).scalarIntrinsic
    local fixed = fixedIdentity ~= nil and admit.FIXED[
        fixedIdentity as string
    ] or not context.checked and path ~= nil and admit.fixed(path as string) or nil
    if fixed ~= nil then
        return fixedCall(node, path or tostring(fixedIdentity), fixed as admit.Fixed, args, kernel)
    end

    local intrinsic = path ~= nil and admit.math(path as string) or nil
    if intrinsic ~= nil then
        return mathCall(node, path as string, intrinsic as admit.Math, args, kernel)
    end

    local helperName = lower.nameOf(node.obj)
    if helperName == nil then
        context.reject(lower.site(node), "call target " .. tostring(path) .. " is not an admitted intrinsic or helper")
    end

    local helper = lower.helper(helperName as string, node, kernel)
    if #args ~= #helper.params then
        context.reject(lower.site(node), "native helper argument count does not match")
    end
    for position, argument in ipairs(args) do
        args[position] = lower.helperArgument(argument, helper.params[position].type, lower.site(node), context)
    end

    return new scalarIR.HelperCall(
        op = "helper_call",
        helper = helper.name,
        cName = helper.cName,
        args = args,
        type = #helper.resultTypes == 1 and helper.resultType or "multi",
        resultTypes = helper.resultTypes,
        source = lower.site(node)
    )
end

--- One operation on a source-visible AOT-only SIMD value.
local function simdMethod(
    node: cst.MethodCall,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr?
    local receiverName = lower.nameOf(node.obj)
    local binding = receiverName ~= nil and environment[receiverName as string] or nil
    local receiver: scalarIR.Expr? = nil
    local receiverType = binding ~= nil and binding.type or ""
    if binding == nil and node.obj ~= nil and node.obj.kind == "methodCall" then
        receiver = lower.expression(node.obj as cst.Node, environment, activeIndex, kernel)
        receiverType = (receiver as scalarIR.Expr).type
    end
    if not tostring(receiverType):match("^simd_") then
        return nil
    end

    local method = node.name ~= nil and (node.name as lexer.Token).text or ""
    local raw = node.args ~= nil and (node.args as cst.Args).exprs or {}
    receiver = receiver or lower.expression(node.obj as cst.Node, environment, activeIndex, kernel)
    local args: {scalarIR.Expr} = {receiver as scalarIR.Expr}
    local source = lower.site(node)
    kernel.usesSimd = true

    if receiverType == "simd_mask_bits64" then
        local binary64 = {
            add = "simd_mask64_add",
            andBits = "simd_mask64_and",
            orBits = "simd_mask64_or",
            xorBits = "simd_mask64_xor",
        }
        local binaryOp = binary64[method]
        if binaryOp ~= nil and #raw == 1 then
            local other = lower.expression(raw[1], environment, activeIndex, kernel)
            if other.type ~= "simd_mask_bits64" then
                kernel.context.reject(source, "64-bit mask operands need the same type")
            end
            args[2] = other
            return new scalarIR.Simd(op = binaryOp as any, args = args, type = "simd_mask_bits64", source = source)
        elseif method == "notBits" and #raw == 0 then
            return new scalarIR.Simd(op = "simd_mask64_not", args = args, type = "simd_mask_bits64", source = source)
        elseif (method == "shiftLeft" or method == "shiftRight") and #raw == 1 then
            args[
                2
            ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
            return new scalarIR.Simd(
                op = method == "shiftLeft" and "simd_mask64_shl" or "simd_mask64_shr",
                args = args,
                type = "simd_mask_bits64",
                source = source
            )
        elseif method == "prefixXor" and #raw == 1 then
            local carry = lower.expression(raw[1], environment, activeIndex, kernel)
            if carry.type ~= "bool" then
                kernel.context.reject(source, "64-bit mask prefixXor takes one boolean carry")
            end
            args[2] = carry
            return new scalarIR.Simd(
                op = "simd_mask64_prefix_xor",
                args = args,
                type = "simd_mask_bits64",
                source = source
            )
        elseif #raw == 0 then
            local reductions = {
                lowBits = {op = "simd_mask64_low", type = "u32"},
                highBits = {op = "simd_mask64_high", type = "u32"},
                any = {op = "simd_mask64_any", type = "bool"},
                count = {op = "simd_mask64_count", type = "u32"},
                firstSet = {op = "simd_mask64_first", type = "u32"},
                clearFirst = {op = "simd_mask64_clear_first", type = "simd_mask_bits64"},
            }
            local reduction = reductions[method]
            if reduction ~= nil then
                return new scalarIR.Simd(op = reduction.op as any, args = args, type = reduction.type, source = source)
            end
        end
        kernel.context.reject(
            source,
            "SIMD operation " .. method .. " with " .. tostring(
                #raw
            ) .. " arguments is not admitted for " .. receiverType
        )
    elseif receiverType == "simd_padded_string_u8" then
        if method == "loadFull" and #raw == 1 then
            args[
                2
            ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
            return new scalarIR.Simd(
                op = "simd_padded_load_full_u8",
                args = args,
                type = "simd_vector_u8",
                source = source
            )
        elseif method == "loadTail" and #raw == 0 then
            return new scalarIR.Simd(
                op = "simd_padded_load_tail_u8",
                args = args,
                type = "simd_vector_u8",
                source = source
            )
        elseif method == "loadBlock64" and #raw == 1 then
            args[
                2
            ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
            return new scalarIR.Simd(
                op = "simd_block64_load_u8",
                args = args,
                type = "simd_block_u8x64",
                source = source
            )
        end
        kernel.context.reject(
            source,
            "SIMD operation " .. method .. " with " .. tostring(
                #raw
            ) .. " arguments is not admitted for " .. receiverType
        )
    elseif receiverType == "simd_block_u8x64" and method == "lastVector" and #raw == 0 then
        return new scalarIR.Simd(op = "simd_block64_last_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_block_u8x64" and method == "utf8Errors" and #raw == 4 then
        local previous = lower.expression(raw[1], environment, activeIndex, kernel)
        if previous.type ~= "simd_vector_u8" then
            kernel.context.reject(source, "SIMD block utf8Errors takes one previous VectorU8")
        end
        args[2] = previous
        for index = 2, 4 do
            local table16 = lower.expression(raw[index], environment, activeIndex, kernel)
            if table16.type ~= "simd_table_u8x16" then
                kernel.context.reject(source, "SIMD block utf8Errors takes three TableU8x16 values")
            end
            args[#args + 1] = table16
        end
        return new scalarIR.Simd(
            op = "simd_block64_utf8_errors_u8",
            args = args,
            type = "simd_mask_bits64",
            source = source
        )
    elseif receiverType == "simd_block_u8x64" and method == "andBits" and #raw == 1 then
        local other = lower.expression(raw[1], environment, activeIndex, kernel)
        if other.type ~= "simd_block_u8x64" then
            kernel.context.reject(source, "SIMD block andBits takes another BlockU8x64")
        end
        args[2] = other
        return new scalarIR.Simd(op = "simd_block64_and_u8", args = args, type = "simd_block_u8x64", source = source)
    elseif receiverType == "simd_block_u8x64" and method == "lookup16" and #raw == 1 then
        local table16 = lower.expression(raw[1], environment, activeIndex, kernel)
        if table16.type ~= "simd_table_u8x16" then
            kernel.context.reject(source, "SIMD block lookup16 takes one TableU8x16")
        end
        args[2] = table16
        return new scalarIR.Simd(
            op = "simd_block64_lookup16_u8",
            args = args,
            type = "simd_block_u8x64",
            source = source
        )
    elseif receiverType == "simd_block_u8x64" and (
        method == "andByte" or method == "shiftRight" or method == "anyBitsSet"
    ) and #raw == 1 then
        args[
            2
        ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
        return new scalarIR.Simd(
            op = method == "andByte"
            and "simd_block64_and_byte_u8"
            or method == "shiftRight"
            and "simd_block64_shr_u8"
            or "simd_block64_any_bits_u8",
            args = args,
            type = method == "anyBitsSet" and "simd_mask_bits64" or "simd_block_u8x64",
            source = source
        )
    elseif receiverType == "simd_block_u8x64" and (
        method == "equal" or method == "equalAny6" or method == "inRange" or method == "outsideRange"
    ) then
        local expected = method == "equal" and 1 or method == "equalAny6" and 6 or 2
        if #raw ~= expected then
            kernel.context.reject(source, "SIMD block " .. method .. " has an unsupported argument count")
        end
        for _, argument in ipairs(raw) do
            args[
                #args + 1
            ] = lower.convert(
                lower.expression(argument, environment, activeIndex, kernel),
                "u32",
                source,
                kernel.context
            )
        end
        return new scalarIR.Simd(
            op = method == "equal"
            and "simd_block64_eq_u8"
            or method == "equalAny6"
            and "simd_block64_eq_any6_u8"
            or method == "inRange"
            and "simd_block64_range_u8"
            or "simd_block64_outside_range_u8",
            args = args,
            type = "simd_mask_bits64",
            source = source
        )
    elseif receiverType == "simd_species_u8" and method == "splat" and #raw == 1 then
        args[
            2
        ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
        return new scalarIR.Simd(op = "simd_splat_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_species_u8" and method == "load" then
        if #raw ~= 2 then
            kernel.context.reject(source, "SIMD byte loads take a source and offset")
        end
        local spanName = #raw == 2 and lower.nameOf(raw[1]) or nil
        local span = spanName ~= nil and kernel.params[spanName as string] or nil
        if span == nil or span.kind ~= "read_span" or span.sourceType ~= "uint8" then
            kernel.context.reject(source, "SIMD byte loads require a borrowed Span<uint8>")
        end
        args[
            2
        ] = lower.convert(lower.expression(raw[2], environment, activeIndex, kernel), "u32", source, kernel.context)

        return new scalarIR.Simd(
            op = "simd_load_u8",
            args = args,
            span = spanName,
            type = "simd_vector_u8",
            source = source
        )
    elseif receiverType == "simd_species_u8" and method == "loadStrided3" then
        if #raw ~= 3 then
            kernel.context.reject(source, "SIMD strided loads take a source, offset and lane")
        end
        local strideBytes = lower.expression(raw[1], environment, activeIndex, kernel)
        local strideRooted = strideBytes.op == "local" and strideBytes as scalarIR.Name or nil
        local strideParam = strideRooted ~= nil and kernel.params[(strideRooted as scalarIR.Name).name] or nil
        if strideBytes.type ~= "lua_string"
            and strideBytes.type ~= "lua_bytes"
            or strideRooted == nil
            or strideParam == nil
            or strideParam.kind ~= "scalar"
            or strideParam.type ~= "lua_string"
            and strideParam.type ~= "lua_bytes"
            or (
            strideRooted as scalarIR.Name
        ).cName ~= strideParam.cName then
            kernel.context.reject(source, "SIMD rooted-string loads require a rooted string parameter")
        end
        args[2] = strideBytes
        args[
            3
        ] = lower.convert(lower.expression(raw[2], environment, activeIndex, kernel), "u32", source, kernel.context)
        args[
            4
        ] = lower.convert(lower.expression(raw[3], environment, activeIndex, kernel), "u32", source, kernel.context)
        markLua(kernel, source)
        return new scalarIR.Simd(op = "simd_load_stride3_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_species_u8" and method == "loadString" then
        if #raw ~= 2 then
            kernel.context.reject(source, "SIMD rooted-string loads take a source and offset")
        end
        local bytes = lower.expression(raw[1], environment, activeIndex, kernel)
        local rooted = bytes.op == "local" and bytes as scalarIR.Name or nil
        local param = rooted ~= nil and kernel.params[(rooted as scalarIR.Name).name] or nil
        if bytes.type ~= "lua_string"
            and bytes.type ~= "lua_bytes"
            or rooted == nil
            or param == nil
            or param.kind ~= "scalar"
            or param.type ~= "lua_string"
            and param.type ~= "lua_bytes"
            or (
            rooted as scalarIR.Name
        ).cName ~= param.cName then
            kernel.context.reject(source, "SIMD rooted-string loads require a rooted string parameter")
        end
        args[2] = bytes
        args[
            3
        ] = lower.convert(lower.expression(raw[2], environment, activeIndex, kernel), "u32", source, kernel.context)
        markLua(kernel, source)
        return new scalarIR.Simd(op = "simd_load_string_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_species_u8" and method == "tail" and #raw == 1 then
        args[
            2
        ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
        return new scalarIR.Simd(op = "simd_tail_u8", args = args, type = "simd_mask_u8", source = source)
    elseif receiverType == "simd_vector_u8" and (method == "equal" or method == "inRange") then
        local expected = method == "equal" and 1 or 2
        if #raw ~= expected then
            kernel.context.reject(source, "SIMD " .. method .. " has an unsupported argument count")
        end
        for _, argument in ipairs(raw) do
            args[
                #args + 1
            ] = lower.convert(
                lower.expression(argument, environment, activeIndex, kernel),
                "u32",
                source,
                kernel.context
            )
        end
        return new scalarIR.Simd(
            op = method == "equal" and "simd_eq_u8" or "simd_range_u8",
            args = args,
            type = "simd_mask_u8",
            source = source
        )
    elseif receiverType == "simd_vector_u8" and method == "shiftRight" and #raw == 1 then
        args[
            2
        ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
        return new scalarIR.Simd(op = "simd_shr_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_vector_u8" and method == "shiftLeft" and #raw == 1 then
        args[
            2
        ] = lower.convert(lower.expression(raw[1], environment, activeIndex, kernel), "u32", source, kernel.context)
        return new scalarIR.Simd(op = "simd_shl_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_vector_u8" and method == "lookup64" and #raw == 4 then
        for index = 1, 4 do
            local tableValue = lower.expression(raw[index], environment, activeIndex, kernel)
            if tableValue.type ~= "simd_table_u8x16" then
                kernel.context.reject(source, "SIMD lookup64 takes four TableU8x16 values")
            end
            args[index + 1] = tableValue
        end
        return new scalarIR.Simd(op = "simd_lookup64_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_vector_u8" and method == "lookup16" and #raw == 1 then
        local tableValue = lower.expression(raw[1], environment, activeIndex, kernel)
        if tableValue.type ~= "simd_table_u8x16" then
            kernel.context.reject(source, "SIMD lookup16 takes one TableU8x16")
        end
        args[2] = tableValue
        return new scalarIR.Simd(op = "simd_lookup16_u8", args = args, type = "simd_vector_u8", source = source)
    end

    local binary = {andBits = "and", orBits = "or", xorBits = "xor"}
    local verb = binary[method]
    if verb ~= nil and #raw == 1 then
        local other = lower.expression(raw[1], environment, activeIndex, kernel)
        if other.type ~= receiverType then
            kernel.context.reject(source, "SIMD bitwise operands need the same type")
        end
        args[2] = other
        local family = receiverType == "simd_vector_u8" and "simd_vec_" or "simd_mask_"
        return new scalarIR.Simd(op = (family .. verb) as any, args = args, type = receiverType, source = source)
    elseif method == "notBits" and #raw == 0 then
        local op = receiverType == "simd_vector_u8" and "simd_vec_not" or "simd_mask_not"
        return new scalarIR.Simd(op = op as any, args = args, type = receiverType, source = source)
    elseif receiverType == "simd_mask_u8" and method == "select" and #raw == 2 then
        for _, argument in ipairs(raw) do
            local value = lower.expression(argument, environment, activeIndex, kernel)
            if value.type ~= "simd_vector_u8" then
                kernel.context.reject(source, "SIMD select values must be byte vectors")
            end
            args[#args + 1] = value
        end
        return new scalarIR.Simd(op = "simd_select_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_mask_u8" and #raw == 0 then
        local reductions = {
            any = {op = "simd_any", type = "bool"},
            all = {op = "simd_all", type = "bool"},
            count = {op = "simd_count", type = "u32"},
            bits = {op = "simd_bits", type = "u32"},
        }
        local reduction = reductions[method]
        if reduction ~= nil then
            return new scalarIR.Simd(op = reduction.op as any, args = args, type = reduction.type, source = source)
        end
    end

    kernel.context.reject(source, "SIMD operation " .. method .. " is not admitted for " .. receiverType)

    return nil
end

--- One unary operator.
local function unary(node: cst.Unop, value: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local written = (node.op as lexer.Token).text
    local source = lower.site(node)
    if written == "-" and value.type == "f64" then
        return new scalarIR.Unary(op = "neg", value = value, type = "f64", source = source)
    elseif written == "not" and value.type == "bool" then
        return new scalarIR.Unary(op = "not", value = value, type = "bool", source = source)
    elseif written == "~" and bitOperand(value) then
        return new scalarIR.Unary(op = "bnot", value = value, type = "i32", source = source)
    end

    kernel.context.reject(source, "unary operator " .. tostring(written) .. " is not admitted for this type")

    return value
end

----------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------

--- The word count an expression names, where it is an exact non-negative
--- integer constant, and nil otherwise.
function lower.constantWidth(value: scalarIR.Expr): integer?
    local raw = value as any
    -- Through a width conversion, because that is how a literal capacity is
    -- written: `u32(64)` is `nupp.math.u32.wrap(64)`, which lowers to a cast of
    -- the constant. Casting an exact in-range integer answers that integer, so
    -- looking through the cast reads the same number the source wrote.
    while raw.op == "numeric_cast" or raw.op == "int_to_f64" do
        raw = raw.value
        if raw == nil then
            return nil
        end
    end
    if raw.op ~= "constant" and raw.op ~= "constant_i32" then
        return nil
    end
    local number = tonumber(raw.value)
    if number == nil or number % 1 ~= 0 or number < 0 or number > lower.UINT32_MAX then
        return nil
    end

    return number as integer
end

--- The bytes a name is bound to, where it is a `const` holding a string
--- literal, and nil otherwise.
---
--- Read off the checker's own answer rather than the optimizer's: folding is a
--- property of the optimization level, and whether a table can be a table is
--- not something that should move with `-O`.
---
--- A literal's constant is the string it denotes rather than the source that
--- spells it, so the bytes placed in static data are the bytes the program would
--- have read and this reader has nothing to decode.
function lower.constantString(node: cst.Node): string?
    local resolved = (node as any).inferredType
    if resolved == nil or resolved.tag ~= "literal" or (node as any).immutablePath ~= true then
        return nil
    end
    local base = resolved.base
    if base == nil or base.tag ~= "string" or type(resolved.constant) ~= "string" then
        return nil
    end

    return resolved.constant as string
end

--- A module-local immutable numeric literal, where the checker resolved one.
function lower.constantNumber(node: cst.Node): string?
    local resolved = (node as any).inferredType
    if resolved == nil or resolved.tag ~= "literal" or (node as any).immutablePath ~= true then
        return nil
    end
    local base = resolved.base
    if base == nil or base.tag ~= "number" or type(resolved.constant) ~= "number" then
        return nil
    end

    return tostring(resolved.constant)
end

--- One compile-time byte table, as the rooted-string name its readers expect.
function lower.constantBytes(value: string, kernel: lower.Kernel, source: scalarIR.Source?): scalarIR.Expr
    local shared = kernel.context.constantNames[value]
    if shared == nil then
        kernel.context.constantValues[#kernel.context.constantValues + 1] = value
        shared = ("konst_%d"):format(#kernel.context.constantValues - 1)
        kernel.context.constantNames[value] = shared
    end
    local existing = kernel.constantNames[value]
    if existing == nil then
        existing = shared as string
        kernel.constantNames[value] = existing
        kernel.constantOrder[
            #kernel.constantOrder + 1
        ] = new scalarIR.ConstantBytes(cName = existing as string, value = value)
    end

    return new scalarIR.Name(
        op = "local",
        name = existing as string,
        cName = existing as string,
        type = "lua_string",
        source = source
    )
end

----------------------------------------------------------------------------
-- Lowering one expression
----------------------------------------------------------------------------

--- A short-circuit left operand whose truth value proves the right operand's
--- scratch cursor in bounds.
local function scratchShortCircuitBound(
    connective: string,
    left: cst.Node?,
    environment: {[string]: any},
    kernel: lower.Kernel
): (string?, string?)
    if left == nil or left.kind ~= "binop" then
        return nil, nil
    end
    local comparison = left as cst.Binop
    local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
    if not (connective == "and" and written == "<" or connective == "or" and written == ">=") then
        return nil, nil
    end
    local cursor = lower.nameOf(comparison.lhs)
    local lengthName = lower.nameOf(comparison.rhs)
    local scratchName = lengthName ~= nil and kernel.scratchLengthBounds[lengthName as string] or nil
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    local scratchBinding = scratchName ~= nil and environment[scratchName as string] or nil
    if cursorBinding ~= nil
        and cursorBinding.type == "u32"
        and scratchBinding ~= nil
        and scratchBinding.type == "lua_scratch_u32"
    then
        return cursor, scratchName
    end

    return nil, nil
end

--- One admitted expression, and everything under it.
---
--- @param environment the names in scope, by name
--- @param activeIndex the loop counter, where one is in scope
function lower.expression(
    node: cst.Node,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    if node == nil then
        context.reject(kernel.loopSource, "an expression is missing")
    end
    node = node as cst.Node

    local kind = node.kind
    -- Parentheses and a cast carry no operation: the tree already has the
    -- grouping, and a cast the checker admitted has already been proved.
    if kind == "paren" or kind == "castExpr" then
        local inner = kind == "paren" and (node as cst.Paren).expr or (node as cst.CastExpr).expr

        return lower.expression(inner as cst.Node, environment, activeIndex, kernel)
    elseif kind == "name" then
        local name = lower.nameOf(node)
        local bound = name ~= nil and environment[name as string] or nil
        if bound == nil then
            if activeIndex ~= nil and name == activeIndex and kernel.mapEntry then
                return new scalarIR.LoopIndex(op = "loop_index", type = "f64", source = lower.site(node))
            end
            -- A `const` bound to a string literal is a byte table the emitter
            -- can write out as static data. The checker already resolved it to
            -- a literal type carrying its value, so nothing has to be folded or
            -- looked up: what it answers with is a rooted-string name like any
            -- other, and every reader between here and the emitted load is
            -- unchanged.
            local constant = lower.constantString(node)
            if constant ~= nil then
                return lower.constantBytes(constant as string, kernel, lower.site(node))
            end
            local number = kernel.constantNumbers[tostring(name)] or lower.constantNumber(node)
            if number ~= nil then
                return new scalarIR.Constant(
                    op = "constant",
                    value = number as string,
                    type = "f64",
                    source = lower.site(node)
                )
            end
            context.reject(lower.site(node), "value " .. tostring(name) .. " is not available in native code")
        end

        -- A specialization binds its const carriers to IR values rather than
        -- to runtime parameters. Keep those values as values: turning one back
        -- into a Name below would discard the tuple before optimization sees it.
        if bound.op == "constant"
            or bound.op == "constant_i32"
            or bound.op == "bool"
            or bound.op == "workgroup_index"
            or bound.op == "local_index"
        then
            return bound as scalarIR.Expr
        elseif bound.op == "lua_string" then
            markLua(kernel, lower.site(node))
            return bound as scalarIR.Expr
        end

        -- A name keeps whatever refinement its binding holds. Only a physical
        -- load widens eagerly, because that is where ordinary Nupp turns storage
        -- into a number; widening here as well would make an established `float`
        -- local unreadable as one.
        -- A helper's parameters are bound as the IR nodes themselves, which carry
        -- `op` where an ordinary binding carries `kind`. Reading only `kind` made
        -- every reference to a helper parameter lower as an ordinary local. C
        -- emission cannot tell the two apart so nothing looked wrong, but the lane
        -- rewriter decides what varies by exactly this distinction, so an inlined
        -- helper body read as uniform and the loop lost its lanes.
        local op = bound.kind == "uniform" and "uniform" or (
            bound.kind == "helper_param" or bound.op == "helper_param"
        ) and "helper_param" or "local"

        return new scalarIR.Name(
            op = op as any,
            name = name as string,
            type = bound.type,
            cName = bound.cName,
            mutable = bound.mutable,
            lengthOf = bound.lengthOf,
            builderMode = bound.builderMode,
            source = lower.site(node)
        )
    elseif kind == "number" then
        local token = (node as cst.NumberLit).token
        local value = token ~= nil and (token as lexer.Token).text or ""
        if tonumber(value) == nil then
            context.reject(lower.site(node), "the kernel needs a finite decimal numeric literal")
        end

        return new scalarIR.Constant(op = "constant", value = value, type = "f64", source = lower.site(node))
    elseif kind == "trueExpr" or kind == "falseExpr" then
        return new scalarIR.Bool(op = "bool", value = kind == "trueExpr", type = "bool", source = lower.site(node))
    elseif kind == "nilExpr" then
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaNil(op = "lua_nil", type = "lua_nil", source = lower.site(node))
    elseif kind == "string" then
        local token = (node as cst.StringLit).token
        local written = token ~= nil and (token as lexer.Token).text or "\"\""
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaString(
            op = "lua_string",
            value = stringBytes(written),
            type = "lua_string",
            source = lower.site(node)
        )
    elseif kind == "tableExpr" then
        local literal = node as cst.TableExpr
        local fields: {scalarIR.LuaField} = {}
        local arrayCapacity, hashCapacity = 0, 0
        for _, raw in ipairs(literal.fields or {}) do
            local key: scalarIR.Expr
            local value: scalarIR.Expr
            local indexed = false
            if raw.kind == "fieldItem" then
                arrayCapacity = arrayCapacity + 1
                indexed = true
                key = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = tostring(arrayCapacity),
                    type = "i32",
                    source = lower.site(raw)
                )
                value = lower.expression((raw as cst.FieldItem).value as cst.Node, environment, activeIndex, kernel)
            elseif raw.kind == "fieldNamed" then
                hashCapacity = hashCapacity + 1
                local named = raw as cst.FieldNamed
                key = new scalarIR.LuaString(
                    op = "lua_string",
                    value = named.name ~= nil and (named.name as lexer.Token).text or "",
                    type = "lua_string",
                    source = lower.site(raw)
                )
                value = lower.expression(named.value as cst.Node, environment, activeIndex, kernel)
            else
                hashCapacity = hashCapacity + 1
                local bracket = raw as cst.FieldBracket
                key = lower.expression(bracket.key as cst.Node, environment, activeIndex, kernel)
                value = lower.expression(bracket.value as cst.Node, environment, activeIndex, kernel)
            end
            fields[
                #fields + 1
            ] = new scalarIR.LuaField(key = key, value = value, indexed = indexed, source = lower.site(raw))
        end
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaNewTable(
            op = "lua_new_table",
            arrayCapacity = new scalarIR.Constant(
                op = "constant",
                value = tostring(arrayCapacity),
                type = "f64",
                source = lower.site(node)
            ),
            hashCapacity = new scalarIR.Constant(
                op = "constant",
                value = tostring(hashCapacity),
                type = "f64",
                source = lower.site(node)
            ),
            fields = fields,
            type = "lua_table",
            source = lower.site(node)
        )
    elseif kind == "unop" and (node as cst.Unop).op ~= nil then
        local operator = node as cst.Unop
        local counted = lower.dotCount(operator)
        local shared = counted ~= nil and environment[counted as string] or nil
        if shared ~= nil and shared.kind == "workgroup_shared" then
            return new scalarIR.Constant(
                op = "constant",
                value = tostring(shared.count),
                type = "f64",
                source = lower.site(node)
            )
        end
        local spanParam = counted ~= nil and kernel.params[counted as string] or nil
        if spanParam ~= nil and spanParam.region ~= nil then
            return new scalarIR.SpanCount(
                op = "span_count",
                span = counted as string,
                type = "f64",
                source = lower.site(node)
            )
        end
        local stringBinding = counted ~= nil and environment[counted as string] or nil
        if stringBinding ~= nil and stringBinding.type == "lua_string" then
            local bytes = lower.expression(operator.operand as cst.Node, environment, activeIndex, kernel)
            markLua(kernel, lower.site(node))
            return new scalarIR.LuaBytes(
                op = "lua_string_length",
                bytes = bytes,
                type = "u32",
                source = lower.site(node)
            )
        end

        return unary(operator, lower.expression(operator.operand as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "methodCall" then
        local simd = simdMethod(node as cst.MethodCall, environment, activeIndex, kernel)
        if simd ~= nil then
            return simd
        end
        context.reject(lower.site(node), "method call is not an admitted SIMD operation")
    elseif kind == "bracketIndex" then
        local indexed = node as cst.BracketIndex
        local tableName = lower.nameOf(indexed.obj)
        local tableBinding = tableName ~= nil and environment[tableName as string] or nil
        if tableBinding ~= nil and tableBinding.kind == "workgroup_shared" then
            if kernel.inPhase ~= true then
                context.reject(lower.site(node), "workgroup scratch is read only inside phases:run")
            end
            local index = lower.expression(indexed.expr as cst.Node, environment, activeIndex, kernel)
            local function indexRange(value: scalarIR.Expr): (number?, number?)
                local op = value.op
                if op == "constant" or op == "constant_i32" then
                    local constant = tonumber((value as any).value)
                    if constant ~= nil and constant == math.floor(constant as number) and constant >= 0 then
                        return constant, constant
                    end
                elseif op == "local_index" then
                    return 0, (kernel.workgroupSize as integer) - 1
                elseif op == "numeric_cast" or op == "int_to_f64" then
                    return indexRange((value as scalarIR.Convert).value)
                elseif op == "u32_add" or op == "u32_mul" then
                    local pair = value as scalarIR.Fixed
                    local leftMin, leftMax = indexRange(pair.left)
                    local rightMin, rightMax = indexRange(pair.right)
                    if leftMin ~= nil and leftMax ~= nil and rightMin ~= nil and rightMax ~= nil then
                        local low = op == "u32_add" and (
                            leftMin as number
                        ) + (rightMin as number) or (leftMin as number) * (rightMin as number)
                        local high = op == "u32_add" and (
                            leftMax as number
                        ) + (rightMax as number) or (leftMax as number) * (rightMax as number)
                        if high <= 4294967295 then
                            return low, high
                        end
                    end
                elseif op == "u32_div" or op == "u32_mod" then
                    local pair = value as scalarIR.Fixed
                    local leftMin, leftMax = indexRange(pair.left)
                    local rightMin, rightMax = indexRange(pair.right)
                    if leftMin ~= nil
                        and leftMax ~= nil
                        and rightMin ~= nil
                        and rightMin == rightMax
                        and rightMin > 0
                    then
                        if op == "u32_div" then
                            return math.floor(
                                (leftMin as number) / (rightMin as number)
                            ), math.floor((leftMax as number) / (rightMin as number))
                        end
                        return 0, math.min(leftMax as number, (rightMin as number) - 1)
                    end
                end

                return nil, nil
            end

            local minimum, maximum = indexRange(index)
            if minimum == nil or maximum == nil or minimum < 0 or maximum >= tableBinding.count then
                context.reject(lower.site(indexed.expr), "shared scratch read is not statically proved in bounds")
            end
            if index.op == "constant" then
                index = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = tostring(minimum),
                    type = "u32",
                    source = lower.site(indexed.expr)
                )
            end
            return widenLoad(
                new scalarIR.SharedLoad(
                    op = "shared_load",
                    shared = tableName as string,
                    index = index,
                    type = tableBinding.element,
                    source = lower.site(node)
                ),
                lower.site(node)
            )
        end
        if tableBinding ~= nil and tableBinding.type == "lua_table" then
            local key = lower.expression(indexed.expr as cst.Node, environment, activeIndex, kernel)
            if key.type ~= "f64" and key.type ~= "i32" and key.type ~= "u32" then
                context.reject(lower.site(indexed.expr), "fresh numeric table reads need a numeric key")
            end
            markLua(kernel, lower.site(node))
            return new scalarIR.LuaTableGet(
                op = "lua_table_get_index",
                table = lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel),
                key = key,
                type = "f64",
                source = lower.site(node)
            )
        end
        return spanRead(indexed, environment, activeIndex, kernel)
    elseif kind == "dotIndex" and (node as cst.DotIndex).name ~= nil then
        local indexed = node as cst.DotIndex
        local counted = lower.dotCount(indexed)
        local spanParam = counted ~= nil and kernel.params[counted as string] or nil
        if spanParam ~= nil and spanParam.region ~= nil then
            return new scalarIR.SpanCount(
                op = "span_count",
                span = counted as string,
                type = "f64",
                source = lower.site(node)
            )
        end
        local objectName = lower.nameOf(indexed.obj)
        local object = objectName ~= nil and environment[objectName as string] or nil
        if object ~= nil and object.type == "simd_species_u8" and (indexed.name as lexer.Token).text == "lanes" then
            kernel.usesSimd = true
            return new scalarIR.Simd(
                op = "simd_lanes",
                args = {lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel)},
                type = "u32",
                source = lower.site(node)
            )
        elseif object ~= nil and object.type == "simd_padded_string_u8" then
            local property = (indexed.name as lexer.Token).text
            local operations = {
                length = "simd_padded_length",
                fullLength = "simd_padded_full_length",
                tailLength = "simd_padded_tail_length",
            }
            local operation = operations[property]
            if operation ~= nil then
                kernel.usesSimd = true
                return new scalarIR.Simd(
                    op = operation as any,
                    args = {lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel)},
                    type = "u32",
                    source = lower.site(node)
                )
            end
        end

        return fieldRead(indexed, lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "binop" and (node as cst.Binop).op ~= nil then
        local operator = node as cst.Binop
        local written = (operator.op as lexer.Token).text
        local left = lower.expression(operator.lhs as cst.Node, environment, activeIndex, kernel)
        local cursor, scratchName = scratchShortCircuitBound(written, operator.lhs, environment, kernel)
        local previous = kernel.cursorBounds
        if cursor ~= nil then
            local bounds: {[string]: string} = {}
            for name, root in pairs(previous) do
                bounds[name] = root
            end
            bounds[cursor as string] = scratchName as string
            kernel.cursorBounds = bounds
        end
        local right = lower.expression(operator.rhs as cst.Node, environment, activeIndex, kernel)
        kernel.cursorBounds = previous

        return binary(operator, left, right, kernel)
    elseif kind == "call" then
        return call(node as cst.Call, environment, activeIndex, kernel)
    end

    context.reject(lower.site(node), "expression kind " .. tostring(kind) .. " is not admitted")

    return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(node))
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

--- The IR type one helper signature spelling denotes.
---
--- A helper takes and returns ordinary Nupp values, so `float` here is binary64
--- rather than an establishment: a helper that wanted binary32 would have to say
--- so in a way this subset does not yet have.
function lower.helperValueType(spelling: string): scalarIR.Type?
    if spelling == "boolean" then
        return "bool"
    elseif spelling == "number" or spelling == "float" or spelling == "integer" then
        return "f64"
    elseif spelling == "uint32" then
        return "u32"
    elseif spelling == "int32" then
        return "i32"
    elseif spelling == "uint64" then
        return "u64"
    elseif spelling == "int64" then
        return "i64"
    elseif spelling:match("%.VectorU8$") ~= nil then
        return "simd_vector_u8"
    elseif spelling:match("%.MaskU8$") ~= nil then
        return "simd_mask_u8"
    elseif spelling:match("%.MaskBits64$") ~= nil then
        return "simd_mask_bits64"
    elseif spelling:match("%.SpeciesU8$") ~= nil then
        return "simd_species_u8"
    elseif spelling:match("%.TableU8x16$") ~= nil then
        return "simd_table_u8x16"
    elseif spelling:match("%.PaddedStringU8$") ~= nil then
        return "simd_padded_string_u8"
    end

    return nil
end

--- Lowers one visible pure helper, on first reach.
---
--- A helper is a parameter list and one return list over those parameters, and
--- nothing else. That is what makes inlining it into a lane body substitution
--- rather than a transformation.
function lower.helper(name: string, at: cst.Node?, kernel: lower.Kernel): scalarIR.Helper
    local context = kernel.context
    if kernel.helperState[name] == "lowering" then
        context.reject(lower.site(at), "recursive native helpers are not admitted")
    end

    local known = kernel.helpers[name]
    if known ~= nil then
        return known as scalarIR.Helper
    end

    local declaration = kernel.helperDecls[name]
    -- Another `@aot` declaration in the same file is a call rather than a body to
    -- inline: it is compiled once, keeps its own contract, and the caller reaches
    -- it through its own symbol. Its parameters and result still have to be values
    -- this IR carries, which the checks below are already the statement of.
    local native = false
    if declaration == nil and kernel.entryDecls[name] ~= nil then
        declaration = kernel.entryDecls[name]
        native = true
    end
    if declaration == nil then
        context.reject(lower.site(at), "call target " .. name .. " is not a visible pure helper")
    end
    kernel.helperState[name] = "lowering"

    local body = declaration.body
    if body == nil
        or body.generics ~= nil
        or body.varargParam ~= nil
        or body.captureTakes ~= nil
        or body.captureBorrows ~= nil
    then
        context.reject(lower.site(declaration), "native helpers must be non-generic, non-variadic, and non-capturing")
    end

    local checkedSignature = context.checked and body.signatureType or nil
    if context.checked and checkedSignature == nil then
        context.reject(lower.site(body), "the checker did not publish this native helper signature")
    end
    if context.checked then
        local effects = body.effectSummary
        if effects == nil then
            context.reject(lower.site(body), "the checker did not publish this native helper effect summary")
        end
        -- Positive effects are authoritative refusals. `top` alone is not:
        -- AOT-only SIMD interfaces deliberately have no runtime body whose
        -- ordinary effect analysis could summarize. Their calls still pass
        -- through the closed AOT operation vocabulary below, and no unknown
        -- call can reach IR or emission.
        if effects.allocates == true
            or effects.yields == true
            or effects.raises == true
            or effects.external == true
            or next(
            effects.writes or {}
        ) ~= nil or next(
            effects.shapes or {}
        ) ~= nil or next(effects.metatables or {}) ~= nil or next(effects.escapes or {}) ~= nil then
            context.reject(lower.site(body), "the checker reports side effects in this native helper")
        end
    end

    local resultTypes: {scalarIR.Type} = {}
    for position, result in ipairs(body.rets or {}) do
        local resultType = context.checked and semanticValueType(
            checkedSignature.rets[position],
            true
        ) or lower.helperValueType(lower.compactType(result))
        if resultType == nil then
            context.reject(lower.site(result), "native helper results are scalar or SIMD values")
        end
        resultTypes[#resultTypes + 1] = resultType as scalarIR.Type
    end
    if #resultTypes == 0 then
        context.reject(lower.site(body), "native helpers need at least one result")
    end

    local params: {scalarIR.Name} = {}
    local environment: {[string]: any} = {}
    for position, raw in ipairs(body.params or {}) do
        local paramName = raw.name ~= nil and (raw.name as lexer.Token).text or nil
        local paramType = context.checked and semanticValueType(
            checkedSignature.params[position],
            true
        ) or lower.helperValueType(lower.compactType(raw.type))
        local mode = context.checked and checkedSignature.paramModes[
            position
        ] or raw.modeTok ~= nil and (raw.modeTok as lexer.Token).text or nil
        if paramName == nil or paramType == nil or mode ~= nil and mode ~= "plain" then
            context.reject(lower.site(raw), "native helper parameters are unowned scalar or SIMD values")
        end
        if environment[paramName as string] ~= nil then
            context.reject(lower.site(raw), "duplicate helper parameter " .. (paramName as string))
        end

        local param = new scalarIR.Name(
            op = "helper_param",
            name = paramName as string,
            type = paramType as scalarIR.Type,
            cName = scalarIR.cIdentifier("a", paramName as string),
            source = lower.site(raw)
        )
        params[#params + 1] = param
        environment[paramName as string] = param
    end

    if native and #resultTypes ~= 1 then
        context.reject(lower.site(declaration), "a compiled entry called from another returns one value")
    end
    if native then
        local called = new scalarIR.Helper(
            name = name,
            cName = scalarIR.privateSymbol(name),
            params = params,
            values = {},
            resultType = resultTypes[1],
            resultTypes = resultTypes,
            native = true,
            source = lower.site(declaration)
        )
        kernel.helpers[name] = called
        kernel.helperState[name] = "done"
        kernel.helperOrder[#kernel.helperOrder + 1] = called

        return called
    end

    local statements = body.body ~= nil and (body.body as cst.Block).stats or {}
    local returned = statements[1]
    local single = #statements == 1 and returned ~= nil and returned.kind == "returnStmt" and #(
        (returned as cst.ReturnStmt).exprs or {}
    ) == #resultTypes
    if not single then
        context.reject(lower.site(body.body or body), "a native helper body is one matching return list")
    end

    local helper = new scalarIR.Helper(
        name = name,
        cName = kernel.symbol .. "_helper_" .. scalarIR.privateSymbol(name):sub(4),
        params = params,
        values = {},
        resultType = resultTypes[1],
        resultTypes = resultTypes,
        source = lower.site(declaration)
    )
    kernel.helpers[name] = helper

    for position, result in ipairs((returned as cst.ReturnStmt).exprs or {}) do
        local value = lower.expression(result, environment, nil, kernel)
        if value.type ~= resultTypes[position] then
            context.reject(lower.site(returned), "native helper result type does not match")
        end
        helper.values[position] = value
    end
    kernel.helperState[name] = "done"
    kernel.helperOrder[#kernel.helperOrder + 1] = helper

    return helper
end

----------------------------------------------------------------------------
-- Scopes and statements
----------------------------------------------------------------------------

--- An environment with the same entries, so a nested block cannot leak the
--- names it introduces back out of itself.
local function inherit(environment: {[string]: any}): {[string]: any}
    local copied: {[string]: any} = {}
    for name, bound in pairs(environment) do
        copied[name] = bound
    end

    return copied
end

--- Introduces one local, refusing a name already in scope.
---
--- Shadowing is refused rather than renamed: the generated C has no scope to
--- tell two bindings of one name apart, and quietly renaming would make the
--- source and the C disagree about which one a later read meant.
local function bind(
    name: string,
    valueType: scalarIR.Type,
    mutable: boolean?,
    at: cst.Node?,
    environment: {[string]: any},
    kernel: lower.Kernel
): scalarIR.Binding
    if environment[name] ~= nil then
        kernel.context.reject(lower.site(at), "native locals may not shadow " .. name)
    end
    kernel.serial = kernel.serial + 1

    local binding = new scalarIR.Binding(
        kind = "local",
        name = name,
        type = valueType,
        mutable = mutable,
        cName = scalarIR.cIdentifier("v" .. tostring(kernel.serial), name),
        source = lower.site(at)
    )
    environment[name] = binding

    return binding
end

--- The scratch whose initialized length an expression preserves.
local function scratchLengthSource(value: scalarIR.Expr, kernel: lower.Kernel): string?
    if value.op == "lua_scratch_u32_length" or value.op == "lua_scratch_u32_escape_length" then
        return ((value as scalarIR.LuaScratchU32Length).scratch as scalarIR.Name).name
    elseif value.op == "lua_scratch_u32_append_bits"
        or value.op == "lua_scratch_u32_append_bits_eager"
        or value.op == "lua_scratch_u32_append_string_bits"
    then
        return ((value as any).scratch as scalarIR.Name).name
    elseif value.op == "local" then
        return kernel.scratchLengthBounds[(value as scalarIR.Name).name]
    elseif value.op == "u32_and" then
        local pair = value as scalarIR.Fixed
        local function mask(other: scalarIR.Expr): boolean
            return other.op == "constant_i32" and tonumber((other as scalarIR.IntConstant).value) == 0x7fffffff
        end

        if mask(pair.right) then
            return scratchLengthSource(pair.left, kernel)
        elseif mask(pair.left) then
            return scratchLengthSource(pair.right, kernel)
        end
    end

    return nil
end

--- The binding bookkeeping every local initializer keeps: events on a builder
--- read its mode from the binding, and length and scratch accesses read their
--- bounds from it.
---
--- A fixed buffer's width belongs to the name it was bound to, because that is
--- what an access names. One map for words and bytes: a name holds one binding
--- at a time, and an access carries the type that says which kind it is
--- reading. Cleared before it is set, and on every binding rather than only on
--- a buffer's: shadowing is refused, but two disjoint scopes may each bind one
--- name, and a later appending buffer inheriting an earlier fixed one's width
--- would be checked against a bound the buffer it names does not have -- which
--- is a read past the end of it rather than a refusal.
local function noteBinding(name: string, value: scalarIR.Expr, binding: scalarIR.Binding, kernel: lower.Kernel): nil
    if value.op == "lua_string_length" then
        local bytes = (value as scalarIR.LuaBytes).bytes as scalarIR.Name
        binding.lengthOf = bytes.name
        kernel.lengthBounds[name] = bytes.name
    end
    local scratchLength = scratchLengthSource(value, kernel)
    if scratchLength ~= nil then
        kernel.scratchLengthBounds[name] = scratchLength as string
    else
        kernel.scratchLengthBounds[name] = nil
    end
    kernel.scratchBounds[name] = nil
    if value.op == "lua_scratch_u32" and (value as scalarIR.LuaScratchU32).fixed ~= nil then
        kernel.scratchBounds[name] = (value as scalarIR.LuaScratchU32).fixed as integer
    elseif value.op == "lua_scratch_u8" and (value as scalarIR.LuaScratchU8).fixed ~= nil then
        kernel.scratchBounds[name] = (value as scalarIR.LuaScratchU8).fixed as integer
    end
    if value.op == "lua_builder" then
        binding.builderMode = (value as scalarIR.LuaBuilder).mode
    end
end

--- The statically known truth of a lowered condition, or nil when it can
--- vary. A const-monomorphized carrier lowers as a constant, so a branch
--- comparing one selects its arm here, before the untaken arms are lowered
--- at all -- which is what lets one const-generic body hold per-variant
--- constructs the other variants' specializations must never contain.
local function staticTruth(value: scalarIR.Expr): boolean?
    if value.op == "bool" then
        return (value as scalarIR.Bool).value
    end
    if value.op ~= "eq"
        and value.op ~= "ne"
        and value.op ~= "lt"
        and value.op ~= "le"
        and value.op ~= "gt"
        and value.op ~= "ge"
    then
        return nil
    end
    local binary = value as scalarIR.Binary
    local left = fold.exactInteger(binary.left)
    local right = fold.exactInteger(binary.right)
    if left == nil or right == nil then
        return nil
    end
    local leftValue = left as number
    local rightValue = right as number

    return switch binary.op do
        case "eq" -> leftValue == rightValue
        case "ne" -> leftValue ~= rightValue
        case "lt" -> leftValue < rightValue
        case "le" -> leftValue <= rightValue
        case "gt" -> leftValue > rightValue
        else -> leftValue >= rightValue
    end
end

--- The static integer a switch case names, or nil when the case is not one.
local function switchCaseNumber(caseValue: cst.Node): number?
    local exact = caseValue.switchStaticValue
    if exact and exact.tag == "literal" and type(exact.constant) == "number" then
        return exact.constant
    end
    local value = caseValue
    while value.kind == "paren" and value.expr do
        value = value.expr
    end
    if value.kind == "number" and value.token then
        return tonumber((value.token.text:gsub("_", "")))
    elseif value.kind == "unop"
        and value.op
        and value.op.kind == "-"
        and value.operand
        and value.operand.kind == "number"
        and value.operand.token
    then
        local parsed = tonumber((value.operand.token.text:gsub("_", "")))
        return parsed and -parsed or nil
    end

    return nil
end

--- Lowers the AOT subset of a switch initializer. Native switches admit numeric
--- integer-valued static cases and expression arms; strings, type patterns, block
--- arms, and early arm returns stay explicit subset boundaries. A selector that
--- is itself a constant -- a const carrier under monomorphization -- selects its
--- arm statically, and only that arm is lowered.
local function switchLocal(
    stat: cst.LocalStmt,
    node: cst.SwitchExpr,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local names = stat.names or {}
    if #names ~= 1 or #(stat.exprs or {}) ~= 1 then
        context.reject(lower.site(stat), "a native switch initializes exactly one local")
    end
    if #(node.cases or {}) == 0 and node.elseCase == nil then
        context.reject(lower.site(node), "a native numeric switch requires an arm")
    end

    local selector = lower.expression(node.selector as cst.Node, environment, kernel.index, kernel)
    if selector.type ~= "f64" and selector.type ~= "i32" and selector.type ~= "u32" then
        context.reject(lower.site(node.selector), "a native switch selector must be numeric")
    end

    local staticSelector = fold.exactInteger(selector)
    if staticSelector ~= nil then
        -- The selector is a constant -- a monomorphized const carrier -- so
        -- the arm is decided here and the untaken arms are never lowered.
        local chosen: cst.Node? = nil
        for _, arm in ipairs(node.cases or {}) do
            if arm.patternKind ~= "static" then
                context.reject(lower.site(arm), "native switches do not admit type cases")
            elseif arm.body ~= nil or arm.expr == nil then
                context.reject(lower.site(arm), "native switches require expression arms")
            end
            for _, caseValue in ipairs(arm.values or {}) do
                local constant = switchCaseNumber(caseValue)
                if constant == nil or constant ~= math.floor(constant as number) then
                    context.reject(lower.site(caseValue), "native switch cases must be integer-valued numbers")
                end
                if chosen == nil and constant == staticSelector then
                    chosen = arm.expr
                end
            end
        end
        local otherwiseArm = node.elseCase
        if otherwiseArm and (otherwiseArm.body ~= nil or otherwiseArm.expr == nil) then
            context.reject(lower.site(otherwiseArm), "native switches require expression arms")
        end
        if chosen == nil and otherwiseArm ~= nil then
            chosen = otherwiseArm.expr
        end
        if chosen == nil then
            context.reject(lower.site(node), "a constant switch selector matches no arm")
        end
        local chosenValue = lower.expression(chosen as cst.Node, environment, kernel.index, kernel)
        local annotation = stat.types ~= nil and (stat.types as {cst.Node})[1] or nil
        local resultType = annotatedValueType(annotation, context) or chosenValue.type
        if resultType == nil or resultType == "multi" or resultType:match("^ref:") then
            context.reject(lower.site(stat), "native switch results must be scalar")
        end
        resultType = resultType as scalarIR.Type
        local resultBinding = bind(names[1].text, resultType, false, stat, environment, kernel)
        local converted = lower.convert(chosenValue, resultType, lower.site(node), context)
        noteBinding(names[1].text, converted, resultBinding, kernel)
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = names[1].text,
            cName = resultBinding.cName,
            value = converted,
            type = resultType,
            source = lower.site(stat)
        )
        return
    end

    local selectorName = "__nupp_switch_selector_" .. tostring(kernel.serial + 1)
    local selectorBinding = bind(selectorName, selector.type, false, node, environment, kernel)
    out[
        #out + 1
    ] = new scalarIR.Let(
        op = "let",
        name = selectorName,
        cName = selectorBinding.cName,
        value = selector,
        type = selector.type,
        source = lower.site(node.selector)
    )
    local selectorRef = new scalarIR.Name(
        op = "local",
        name = selectorName,
        cName = selectorBinding.cName,
        type = selector.type,
        source = lower.site(node.selector)
    )

    local arms = {}
    for _, arm in ipairs(node.cases or {}) do
        if arm.patternKind ~= "static" then
            context.reject(lower.site(arm), "native switches do not admit type cases")
        elseif arm.body ~= nil or arm.expr == nil then
            context.reject(lower.site(arm), "native switches require expression arms")
        end
        arms[
            #arms + 1
        ] = {case = arm, value = lower.expression(arm.expr as cst.Node, environment, kernel.index, kernel)}
    end
    local otherwise = node.elseCase
    if otherwise and (otherwise.body ~= nil or otherwise.expr == nil) then
        context.reject(lower.site(otherwise), "native switches require expression arms")
    end
    local elseValue = otherwise and lower.expression(
        otherwise.expr as cst.Node,
        environment,
        kernel.index,
        kernel
    ) or nil
    local annotation = stat.types ~= nil and (stat.types as {cst.Node})[1] or nil
    local inferredResult = elseValue and elseValue.type or arms[1] and arms[1].value.type or nil
    local resultType = annotatedValueType(annotation, context) or inferredResult
    if resultType == nil or resultType == "multi" or resultType:match("^ref:") then
        context.reject(lower.site(stat), "native switch results must be scalar")
    end
    resultType = resultType as scalarIR.Type

    local resultBinding = bind(names[1].text, resultType, false, stat, environment, kernel)
    local zero: scalarIR.Expr
    if resultType == "bool" then
        zero = new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(stat))
    elseif resultType == "i32" or resultType == "u32" then
        zero = new scalarIR.IntConstant(op = "constant_i32", value = "0", type = resultType, source = lower.site(stat))
    else
        zero = new scalarIR.Constant(op = "constant", value = "0", type = "f64", source = lower.site(stat))
    end
    out[
        #out + 1
    ] = new scalarIR.Let(
        op = "let",
        name = names[1].text,
        cName = resultBinding.cName,
        value = zero,
        type = resultType,
        source = lower.site(stat)
    )

    local target = new scalarIR.Target(
        kind = "local",
        name = resultBinding.name,
        cName = resultBinding.cName,
        type = resultType
    )
    local clauses: {scalarIR.Clause} = {}
    local nativePlan = switchplan.native(selector.type)
    local nativeArms: {scalarIR.SwitchArm} = {}
    for _, lowered in ipairs(arms) do
        local condition: scalarIR.Expr? = nil
        local nativeLabels: {scalarIR.SwitchLabel} = {}
        for _, caseValue in ipairs(lowered.case.values or {}) do
            local constant = switchCaseNumber(caseValue)
            if constant == nil then
                context.reject(lower.site(caseValue), "native switch cases must be integer-valued numbers")
            end
            local number = constant or 0
            if number ~= math.floor(number) then
                context.reject(lower.site(caseValue), "native switch cases must be integer-valued numbers")
            end
            local right: scalarIR.Expr
            if nativePlan.tag == "NativeIntegerSwitch" then
                if selector.type == "i32" and (number < -2147483648 or number > 2147483647) then
                    context.reject(lower.site(caseValue), "native switch case is outside int32")
                elseif selector.type == "u32" and (number < 0 or number > 4294967295) then
                    context.reject(lower.site(caseValue), "native switch case is outside uint32")
                end
                local spelling = ("%.0f"):format(number)
                right = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = spelling,
                    type = selector.type,
                    source = lower.site(caseValue)
                )
                nativeLabels[
                    #nativeLabels + 1
                ] = new scalarIR.SwitchLabel(
                    value = spelling,
                    type = selector.type as any,
                    source = lower.site(caseValue)
                )
            else
                right = lower.expression(caseValue, environment, kernel.index, kernel)
            end
            local equal = new scalarIR.Binary(
                op = "eq",
                left = selectorRef,
                right = right,
                type = "bool",
                source = lower.site(caseValue)
            )
            condition = condition ~= nil and new scalarIR.Binary(
                op = "or",
                left = condition as scalarIR.Expr,
                right = equal,
                type = "bool",
                source = lower.site(caseValue)
            ) or equal
        end
        local assignment = new scalarIR.Assignment(
            target = target,
            value = lower.convert(lowered.value, resultType, lower.site(lowered.case), context)
        )
        clauses[
            #clauses + 1
        ] = new scalarIR.Clause(
            condition = condition as scalarIR.Expr,
            body = {new scalarIR.Assign(op = "assign", values = {assignment}, source = lower.site(lowered.case))},
            source = lower.site(lowered.case)
        )
        if nativePlan.tag == "NativeIntegerSwitch" then
            nativeArms[#nativeArms + 1] = new scalarIR.SwitchArm(labels = nativeLabels)
        end
    end
    local elseBody: {scalarIR.Statement}? = nil
    if otherwise and elseValue then
        local elseAssignment = new scalarIR.Assignment(
            target = target,
            value = lower.convert(elseValue, resultType, lower.site(otherwise), context)
        )
        elseBody = {new scalarIR.Assign(op = "assign", values = {elseAssignment}, source = lower.site(otherwise))}
    end
    local nativeSwitch = nativePlan.tag == "NativeIntegerSwitch" and new scalarIR.NativeSwitch(
        selector = selectorRef,
        arms = nativeArms
    ) or nil
    out[
        #out + 1
    ] = new scalarIR.If(
        op = "if",
        clauses = clauses,
        elseBody = elseBody,
        source = lower.site(node),
        nativeSwitch = nativeSwitch
    )
    environment[selectorName] = nil
end

--- Flattens `name = name .. ...` into the appended string expressions.
local function stringAppendPieces(node: cst.Node?, name: string): {cst.Node}?
    if node == nil then
        return nil
    end
    if node.kind == "name" and lower.nameOf(node) == name then
        return {}
    end
    if node.kind ~= "binop" then
        return nil
    end
    local joined = node as cst.Binop
    if joined.op == nil or (joined.op as lexer.Token).text ~= ".." then
        return nil
    end
    local pieces = stringAppendPieces(joined.lhs, name)
    if pieces == nil then
        return nil
    end
    pieces[#pieces + 1] = joined.rhs as cst.Node

    return pieces
end

--- Finds ordinary locals used only through self-appending assignments and a
--- direct return. Any other use reaches normal lowering and is refused rather
--- than being silently assigned accumulator semantics.
function lower.stringAccumulators(statements: {cst.Node}): {[string]: boolean}
    local declared, appended, returned, invalid = {}, {}, {}, {}
    local function walk(node: cst.Node?): nil
        if node == nil then
            return
        end
        if node.kind == "localStmt" then
            local stat = node as cst.LocalStmt
            if #(stat.names or {}) == 1 and #(stat.exprs or {}) == 1 then
                local name = (stat.names or {})[1].text
                if declared[name] then
                    invalid[name] = true
                else
                    declared[name] = true
                end
            end
        elseif node.kind == "assignStmt" then
            local stat = node as cst.AssignStmt
            local targets, exprs = stat.targets or {}, stat.exprs or {}
            if #targets == 1 and #exprs == 1 and targets[1].kind == "name" then
                local name = tostring(lower.nameOf(targets[1]))
                if stringAppendPieces(exprs[1], name) ~= nil then
                    appended[name] = true
                else
                    invalid[name] = true
                end
            end
        elseif node.kind == "returnStmt" then
            for _, value in ipairs((node as cst.ReturnStmt).exprs or {}) do
                local name = lower.nameOf(value)
                if name ~= nil then
                    returned[name as string] = true
                end
            end
        end
        for _, child in ipairs(node as {any}) do
            walk(child)
        end
    end

    for _, statement in ipairs(statements) do
        walk(statement)
    end
    local found: {[string]: boolean} = {}
    for name in pairs(declared) do
        if appended[name] and returned[name] and not invalid[name] then
            found[name] = true
        end
    end

    return found
end

--- One `local` declaration, which may bind several names from one call.
local function localStmt(
    stat: cst.LocalStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local names = stat.names or {}
    local exprs = stat.exprs or {}
    if #names == 0 or #exprs == 0 then
        context.reject(lower.site(stat), "native locals must be initialized")
    end
    if kernel.phasesName ~= nil and #names == 1 and #exprs == 1 and exprs[1].kind == "methodCall" then
        local call = exprs[1] as cst.MethodCall
        local args = call.args ~= nil and ((call.args as cst.Args).exprs or {}) or {}
        if lower.nameOf(
            call.obj
        ) == kernel.phasesName and call.name ~= nil and (call.name as lexer.Token).text == "scratch" then
            if #args ~= 2 then
                context.reject(lower.site(call), "phases:scratch takes an initial value and a static count")
            end
            local token = cst.firstToken(args[2])
            local count = token ~= nil and tonumber((token as lexer.Token).text) or nil
            if count == nil or count ~= math.floor(count as number) or count < 1 then
                context.reject(lower.site(args[2]), "workgroup scratch count must be a positive integer literal")
            end
            local initial = lower.expression(args[1], environment, kernel.index, kernel)
            if initial.type ~= "f32" and initial.type ~= "i32" and initial.type ~= "u32" then
                context.reject(lower.site(args[1]), "workgroup scratch elements must be f32, int32, or uint32")
            end
            local shared = new scalarIR.Shared(
                name = names[1].text,
                element = initial.type,
                count = count as integer,
                initial = initial,
                source = lower.site(stat)
            )
            local byName = kernel.shared as {[string]: scalarIR.Shared}
            if byName[names[1].text] ~= nil then
                context.reject(lower.site(stat), "workgroup scratch names may not be shadowed")
            end
            byName[names[1].text] = shared
            local ordered = kernel.sharedOrder as {scalarIR.Shared}
            ordered[#ordered + 1] = shared
            environment[names[1].text] = {kind = "workgroup_shared", element = initial.type, count = count,}
            return
        end
    end
    if #names == 1 and #exprs == 1 and kernel.stringAccumulators[names[1].text] then
        local initial = lower.expression(exprs[1], environment, kernel.index, kernel)
        if initial.type ~= "lua_string" then
            context.reject(lower.site(exprs[1]), "a string accumulator must start with a string")
        end
        local binding = bind(names[1].text, "lua_string_buffer", nil, stat, environment, kernel)
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = names[1].text,
            cName = binding.cName,
            type = "lua_string_buffer",
            value = new scalarIR.LuaStringBuffer(
                op = "lua_string_buffer",
                initial = initial,
                type = "lua_string_buffer",
                source = lower.site(exprs[1])
            ),
            source = lower.site(stat)
        )
        markLua(kernel, lower.site(stat))
        return
    end
    if #exprs == 1 and exprs[1].kind == "switchExpr" then
        return switchLocal(stat, exprs[1] as cst.SwitchExpr, out, environment, kernel)
    end

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        if only.type == "multi" then
            -- One call, several results. The names are bound together because
            -- the call happens once, whatever it is later inlined into.
            local call = only as scalarIR.HelperCall
            local resultTypes = call.resultTypes or {}
            if #resultTypes ~= #names then
                context.reject(lower.site(stat), "multiple-result helper count does not match local names")
            end

            local bindings: {scalarIR.Binding} = {}
            for position, token in ipairs(names) do
                local annotated = annotatedValueType(
                    stat.types ~= nil and (stat.types as {cst.Node})[position] or nil,
                    context
                )
                local valueType = resultTypes[position]
                if annotated ~= nil and annotated ~= valueType then
                    context.reject(lower.site(stat), "native local annotation does not match")
                end
                bindings[position] = bind(token.text, valueType, nil, stat, environment, kernel)
            end
            out[
                #out + 1
            ] = new scalarIR.MultiLet(op = "multi_let", call = call, bindings = bindings, source = lower.site(stat))

            return
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            local value = lower.expression(expression, environment, kernel.index, kernel)
            if value.type == "multi" then
                context.reject(lower.site(expression), "a multiple-result call must be the only initializer")
            end
            values[#values + 1] = value
        end
    end

    if #values ~= #names then
        context.reject(lower.site(stat), "native local initializer count must match names")
    end
    for position, token in ipairs(names) do
        local annotation = stat.types ~= nil and (stat.types as {cst.Node})[position] or nil
        local expected = annotatedValueType(annotation, context) or values[position].type
        if expected == nil then
            context.reject(
                lower.site(stat),
                "native local annotation " .. lower.compactType(annotation) .. " is not admitted"
            )
        end

        local value = lower.convert(values[position], expected as scalarIR.Type, lower.site(stat), context)
        local binding = bind(
            token.text,
            expected as scalarIR.Type,
            (value as scalarIR.ElementRef).mutable,
            stat,
            environment,
            kernel
        )
        noteBinding(token.text, value, binding, kernel)
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = token.text,
            cName = binding.cName,
            type = expected as scalarIR.Type,
            value = value,
            source = lower.site(stat)
        )
    end
end

--- Where one assignment puts its value.
local function assignTarget(target: cst.Node, environment: {[string]: any}, kernel: lower.Kernel): scalarIR.Target
    local context = kernel.context
    if target.kind == "name" then
        local binding = environment[tostring(lower.nameOf(target))]
        if binding == nil or binding.kind ~= "local" then
            context.reject(lower.site(target), "native assignment target must be a local")
        end
        if tostring(binding.type):match("^lua_") ~= nil and binding.type ~= "lua_string" then
            context.reject(lower.site(target), "Lua construction handles cannot be reassigned")
        end

        return new scalarIR.Target(kind = "local", name = binding.name, cName = binding.cName, type = binding.type)
    end

    local indexed = target as cst.DotIndex
    if target.kind ~= "dotIndex" or indexed.name == nil then
        context.reject(lower.site(target), "native assignment targets are locals or mutable struct fields")
    end

    local object = lower.expression(indexed.obj as cst.Node, environment, kernel.index, kernel)
    local layoutName = object.type:match("^ref:(.+)$")
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if layout == nil or (object as scalarIR.ElementRef).mutable ~= true then
        context.reject(lower.site(target), "native field assignment needs getMut(index)")
    end

    local wanted = (indexed.name as lexer.Token).text
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == wanted then
            field = candidate
        end
    end
    if field == nil then
        context.reject(lower.site(target), "unknown native struct field " .. wanted)
    end

    return new scalarIR.Target(
        kind = "field",
        object = object,
        layout = layoutName as string,
        field = (field as scalarIR.Field).name,
        type = (field as scalarIR.Field).type,
        sourceType = (field as scalarIR.Field).sourceType
    )
end

--- One assignment, which may write several targets at once.
local function assignStmt(
    stat: cst.AssignStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local exprs = stat.exprs or {}
    local targets = stat.targets or {}

    if #targets == 1 and #exprs == 1 and targets[1].kind == "name" then
        local name = tostring(lower.nameOf(targets[1]))
        local binding = environment[name]
        if binding ~= nil and binding.type == "lua_string_buffer" then
            local pieces = stringAppendPieces(exprs[1], name)
            if pieces == nil then
                context.reject(lower.site(stat), "a lowered string accumulator is append-only")
            end
            for _, piece in ipairs(pieces as {cst.Node}) do
                local value = lower.expression(piece, environment, kernel.index, kernel)
                if value.type ~= "lua_string" then
                    context.reject(lower.site(piece), "a string accumulator appends only strings")
                end
                out[
                    #out + 1
                ] = new scalarIR.LuaStringBufferAppend(
                    op = "lua_string_buffer_append",
                    buffer = new scalarIR.Name(
                        op = "local",
                        name = binding.name,
                        cName = binding.cName,
                        type = "lua_string_buffer",
                        source = lower.site(targets[1])
                    ),
                    value = value,
                    source = lower.site(stat)
                )
            end
            markLua(kernel, lower.site(stat))
            return
        end
    end

    if #targets ~= 1 or #exprs ~= 1 then
        for _, target in ipairs(targets) do
            local name = lower.nameOf(target)
            local binding = name ~= nil and environment[name as string] or nil
            if binding ~= nil and binding.type == "lua_string" then
                context.reject(lower.site(stat), "AOT Lua string reassignment must have one target and one value")
            end
        end
    end

    if #targets == 1 and #exprs == 1 and targets[1].kind == "dotIndex" then
        local target = targets[1] as cst.DotIndex
        local tableName = lower.nameOf(target.obj)
        local tableBinding = tableName ~= nil and environment[tableName as string] or nil
        if tableBinding ~= nil and tableBinding.type == "lua_table" and target.name ~= nil then
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            out[
                #out + 1
            ] = new scalarIR.LuaSet(
                op = "lua_set_key",
                table = new scalarIR.Name(
                    op = "local",
                    name = tableBinding.name,
                    cName = tableBinding.cName,
                    type = "lua_table",
                    source = lower.site(target.obj)
                ),
                key = new scalarIR.LuaString(
                    op = "lua_string",
                    value = (target.name as lexer.Token).text,
                    type = "lua_string",
                    source = lower.site(target.name)
                ),
                value = value,
                source = lower.site(stat)
            )
            markLua(kernel, lower.site(stat))
            return
        end
    end

    if #targets == 1 and #exprs == 1 and targets[1].kind == "bracketIndex" then
        local target = targets[1] as cst.BracketIndex
        local spanName = lower.nameOf(target.obj)
        local output = spanName ~= nil and kernel.params[spanName as string] or nil
        local tableBinding = spanName ~= nil and environment[spanName as string] or nil
        if tableBinding ~= nil and tableBinding.kind == "workgroup_shared" then
            if kernel.inPhase ~= true then
                context.reject(lower.site(target), "workgroup scratch is written only inside phases:run")
            end
            local index = lower.expression(target.expr as cst.Node, environment, kernel.index, kernel)
            if index.op ~= "local_index" then
                context.reject(lower.site(target.expr), "shared scratch writes must use exactly localIndex")
            end
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            out[
                #out + 1
            ] = new scalarIR.SharedStore(
                op = "shared_store",
                shared = spanName as string,
                index = index,
                value = lower.convert(value, tableBinding.element, lower.site(stat), context),
                source = lower.site(stat)
            )
            return
        end
        if tableBinding ~= nil and tableBinding.type == "lua_table" then
            local key = lower.expression(target.expr as cst.Node, environment, kernel.index, kernel)
            if key.type ~= "f64" and key.type ~= "i32" and key.type ~= "u32" and key.type ~= "lua_string" then
                context.reject(lower.site(target.expr), "fresh table keys must be numeric or strings")
            end
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            if value.type ~= "f64"
                and value.type ~= "f32"
                and value.type ~= "i32"
                and value.type ~= "u32"
                and value.type ~= "bool"
                and value.type ~= "lua_table"
                and value.type ~= "lua_string"
                and value.type ~= "lua_nil"
            then
                context.reject(lower.site(exprs[1]), "fresh table values must be admitted Lua primitives or tables")
            end
            out[
                #out + 1
            ] = new scalarIR.LuaSet(
                op = (key.type == "lua_string" and "lua_set_key" or "lua_set_index") as any,
                table = new scalarIR.Name(
                    op = "local",
                    name = tableBinding.name,
                    cName = tableBinding.cName,
                    type = "lua_table",
                    source = lower.site(target.obj)
                ),
                key = key,
                value = value,
                source = lower.site(stat)
            )
            markLua(kernel, lower.site(stat))
            return
        end
        if output == nil or output.kind ~= "write_span" then
            context.reject(lower.site(target), "native indexed stores require a writable span")
        end
        local indexArg = lower.unwrapped(target.expr)
        local direct = lower.nameOf(indexArg)
        local cursor = provedCursor(indexArg, spanName, kernel)
        if not (kernel.index ~= "" and direct == kernel.index) and cursor == nil then
            context.reject(
                lower.site(target),
                "span stores need a counted-loop index or cursor + 1 under cursor < #span"
            )
        end
        provenIndex(spanName as string, cursor, target, kernel)
        local value = lower.expression(exprs[1], environment, kernel.index, kernel)
        local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
        out[
            #out + 1
        ] = new scalarIR.Store(
            op = "store",
            span = spanName as string,
            index = cursor == nil and kernel.index or "",
            indexCName = cursor == nil and kernel.indexCName or nil,
            cursor = cursor,
            cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil,
            value = lower.convert(value, output.element.type, lower.site(stat), context),
            source = lower.site(stat)
        )
        return
    end

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        if only.type == "multi" then
            context.reject(
                lower.site(stat),
                "multiple-result helpers initialize locals; ordinary multiple assignment uses explicit values"
            )
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            values[#values + 1] = lower.expression(expression, environment, kernel.index, kernel)
        end
    end
    if #values ~= #targets then
        context.reject(lower.site(stat), "native assignment counts must match")
    end

    local assignments: {scalarIR.Assignment} = {}
    for position, target in ipairs(targets) do
        local lowered = assignTarget(target, environment, kernel)
        assignments[
            position
        ] = new scalarIR.Assignment(
            target = lowered,
            value = lower.convert(values[position], lowered.type as scalarIR.Type, lower.site(stat), context)
        )
    end
    out[#out + 1] = new scalarIR.Assign(op = "assign", values = assignments, source = lower.site(stat))
    for _, entry in ipairs(assignments) do
        local target = entry.target
        if target.kind == "local" and target.name ~= nil then
            kernel.cursorBounds[target.name as string] = nil
            kernel.lengthBounds[target.name as string] = nil
            kernel.scratchBounds[target.name as string] = nil
            local scratchLength = scratchLengthSource(entry.value, kernel)
            if scratchLength ~= nil then
                kernel.scratchLengthBounds[target.name as string] = scratchLength as string
            else
                kernel.scratchLengthBounds[target.name as string] = nil
            end
        end
    end
end

--- One numeric `for` bound.
---
--- An integer literal stays an integer rather than being written as a double
--- for the emitter to cast back.
local function forBound(bound: scalarIR.Expr, at: cst.Node?, kernel: lower.Kernel): scalarIR.Expr
    if bound.op == "constant" then
        local number = tonumber((bound as scalarIR.Constant).value)
        if number ~= nil and number == math.floor(number as number) then
            -- The C loop counts in int32, so a literal the counter cannot reach
            -- is refused here rather than narrowed into a bound that means
            -- something else. Spelled with %.0f: tostring writes 2^53 as
            -- 9.007e+15, which is not a C integer.
            local spelling = ("%.0f"):format(number as number)
            if number < lower.INT32_MIN or number > lower.INT32_MAX then
                kernel.context.reject(lower.site(at), "native for bound " .. spelling .. " is outside int32")
            end
            return new scalarIR.IntConstant(op = "constant_i32", value = spelling, type = "i32", source = bound.source)
        end
    end
    if bound.type ~= "i32" and bound.type ~= "u32" and bound.type ~= "f64" then
        kernel.context.reject(lower.site(at), "native for bounds must be numeric")
    end

    return bound
end

--- Finds a scratch array that one ordinary phase both writes and reads through
--- another lane's index. That is a race without a compiler-owned collective
--- shape. Reads from an earlier phase and same-lane read-modify-write remain
--- valid.
local function sharedPhaseCollision(statements: {scalarIR.Statement}): string?
    local written: {[string]: boolean} = {}
    local crossRead: {[string]: boolean} = {}
    local inspectExpression: function(scalarIR.Expr): nil
    inspectExpression = function(value: scalarIR.Expr): nil
        if value.op == "shared_load" then
            local load = value as scalarIR.SharedLoad
            if load.index.op ~= "local_index" then
                crossRead[load.shared] = true
            end
        end
        visit.expressionChildren(value, function(child: scalarIR.Expr): scalarIR.Expr
            inspectExpression(child)
            return child
        end)
    end
    local inspectBlock: function({scalarIR.Statement}): nil
    inspectBlock = function(block: {scalarIR.Statement}): nil
        for _, statement in ipairs(block) do
            if statement.op == "shared_store" then
                written[(statement as scalarIR.SharedStore).shared] = true
            end
            visit.statementExpressions(statement, function(value: scalarIR.Expr): scalarIR.Expr
                inspectExpression(value)
                return value
            end)
            if statement.op == "if" then
                for _, clause in ipairs((statement as scalarIR.If).clauses) do
                    inspectBlock(clause.body)
                end
                inspectBlock((statement as scalarIR.If).elseBody or {})
            elseif statement.op == "while" or statement.op == "fornum" or statement.op == "block" then
                inspectBlock((statement as any).body as {scalarIR.Statement})
            end
        end
    end
    inspectBlock(statements)
    for name in pairs(written) do
        if crossRead[name] == true then
            return name
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- Lowering a block
----------------------------------------------------------------------------

--- One block of admitted statements, and everything under it.
function lower.block(statements: {cst.Node}, environment: {[string]: any}, kernel: lower.Kernel): {scalarIR.Statement}
    local context = kernel.context
    local out: {scalarIR.Statement} = {}

    --- One nested block, under its own scope.
    local function nested(body: cst.Node?): {scalarIR.Statement}
        local block = body as cst.Block?

        return lower.block(block ~= nil and (block as cst.Block).stats or {}, inherit(environment), kernel)
    end

    --- A positive `uint32 cursor < #span` fact authorizes exactly
    --- `span[cursor + 1]` in that arm.
    local function cursorBound(condition: cst.Node?): (string?, string?)
        if condition == nil or condition.kind ~= "binop" then
            return nil, nil
        end
        local comparison = condition as cst.Binop
        local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
        if written == "and" then
            local cursor, spanName = cursorBound(comparison.lhs)
            if cursor ~= nil then
                return cursor, spanName
            end

            return cursorBound(comparison.rhs)
        end
        local cursor = lower.nameOf(comparison.lhs)
        local spanName = lower.dotCount(comparison.rhs)
        local binding = cursor ~= nil and environment[cursor as string] or nil
        local param = spanName ~= nil and kernel.params[spanName as string] or nil
        if written == "<" and binding ~= nil and binding.type == "u32" and param ~= nil and param.region ~= nil then
            return cursor, spanName
        end
        local lengthName = lower.nameOf(comparison.rhs)
        local bytesName = lengthName ~= nil and kernel.lengthBounds[lengthName as string] or nil
        local bytes = bytesName ~= nil and kernel.params[bytesName as string] or nil
        if written == "<" and binding ~= nil and binding.type == "u32" and bytes ~= nil and bytes.kind == "scalar" and (
            bytes.type == "lua_string" or bytes.type == "lua_bytes"
        ) then
            return cursor, bytesName
        end
        local scratchName = lengthName ~= nil and kernel.scratchLengthBounds[lengthName as string] or nil
        local scratch = scratchName ~= nil and environment[scratchName as string] or nil
        if written == "<"
            and binding ~= nil
            and binding.type == "u32"
            and scratch ~= nil
            and scratch.type == "lua_scratch_u32"
        then
            return cursor, scratchName
        end

        return nil, nil
    end

    local function nestedWithCursor(body: cst.Node?, cursor: string?, spanName: string?): {scalarIR.Statement}
        if cursor == nil or spanName == nil then
            return nested(body)
        end
        local previous = kernel.cursorBounds
        local bounds: {[string]: string} = {}
        for name, span in pairs(previous) do
            bounds[name] = span
        end
        bounds[cursor as string] = spanName as string
        kernel.cursorBounds = bounds
        local lowered = nested(body)
        local invalidated: {string} = {}
        for name in pairs(previous) do
            if bounds[name] == nil then
                invalidated[#invalidated + 1] = name
            end
        end
        for _, name in ipairs(invalidated) do
            previous[name] = nil
        end
        kernel.cursorBounds = previous

        return lowered
    end

    for _, stat in ipairs(statements) do
        local kind = stat.kind
        if kind == "localStmt" then
            localStmt(stat as cst.LocalStmt, out, environment, kernel)
        elseif kind == "callStmt" then
            local statement = stat as cst.CallStmt
            local method = statement.expr ~= nil
                and statement.expr.kind == "methodCall"
                and statement.expr as cst.MethodCall
                or nil
            local phaseMethod = method ~= nil and kernel.phasesName ~= nil and lower.nameOf(
                (method as cst.MethodCall).obj
            ) == kernel.phasesName and (
                method as cst.MethodCall
            ).name ~= nil and ((method as cst.MethodCall).name as lexer.Token).text or nil
            if method ~= nil and phaseMethod == "reduceSumF32" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                local sharedName = #args == 1 and lower.nameOf(args[1]) or nil
                local shared = sharedName ~= nil and environment[sharedName as string] or nil
                local size = kernel.workgroupSize
                if shared == nil or shared.kind ~= "workgroup_shared" or shared.element ~= "f32" then
                    context.reject(lower.site(method), "phases:reduceSumF32 takes one f32 scratch array")
                end
                if size == nil or size < 1 or size & (size - 1) ~= 0 then
                    context.reject(lower.site(method), "fixed-tree reduction needs a power-of-two workgroup size")
                end
                local stride = (size as integer) // 2
                while stride > 0 do
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    local offset = new scalarIR.IntConstant(
                        op = "constant_i32",
                        value = tostring(stride),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local rightIndex = new scalarIR.Fixed(
                        op = "u32_add",
                        left = lane,
                        right = offset,
                        type = "u32",
                        source = lower.site(method)
                    )
                    local left = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sharedName as string,
                        index = lane,
                        type = "f32",
                        source = lower.site(method)
                    )
                    local right = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sharedName as string,
                        index = rightIndex,
                        type = "f32",
                        source = lower.site(method)
                    )
                    local write = new scalarIR.SharedStore(
                        op = "shared_store",
                        shared = sharedName as string,
                        index = lane,
                        value = new scalarIR.Fixed(
                            op = "f32_add",
                            left = left,
                            right = right,
                            type = "f32",
                            source = lower.site(method)
                        ),
                        source = lower.site(method)
                    )
                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.If(
                                op = "if",
                                clauses = {
                                    new scalarIR.Clause(
                                        condition = new scalarIR.Binary(
                                            op = "lt",
                                            left = lane,
                                            right = offset,
                                            type = "bool",
                                            source = lower.site(method)
                                        ),
                                        body = {write},
                                        source = lower.site(method)
                                    ),
                                },
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                    stride = stride // 2
                end
            elseif method ~= nil and phaseMethod == "inclusiveScanU32" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                local valuesName = #args == 2 and lower.nameOf(args[1]) or nil
                local temporaryName = #args == 2 and lower.nameOf(args[2]) or nil
                local values = valuesName ~= nil and environment[valuesName as string] or nil
                local temporary = temporaryName ~= nil and environment[temporaryName as string] or nil
                local size = kernel.workgroupSize
                if values == nil
                    or temporary == nil
                    or values.kind ~= "workgroup_shared"
                    or temporary.kind ~= "workgroup_shared"
                    or values.element ~= "u32"
                    or temporary.element ~= "u32"
                    or valuesName == temporaryName
                then
                    context.reject(lower.site(method), "phases:inclusiveScanU32 takes two distinct u32 scratch arrays")
                end
                if size == nil or size < 1 or size & (
                    size - 1
                ) ~= 0 or values.count ~= size or temporary.count ~= size then
                    context.reject(
                        lower.site(method),
                        "fixed scan needs two power-of-two arrays with one value per lane"
                    )
                end

                local sourceName = valuesName as string
                local targetName = temporaryName as string
                local offset = 1
                while offset < (size as integer) do
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    local distance = new scalarIR.IntConstant(
                        op = "constant_i32",
                        value = tostring(offset),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local current = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sourceName,
                        index = lane,
                        type = "u32",
                        source = lower.site(method)
                    )
                    local previous = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sourceName,
                        index = new scalarIR.Fixed(
                            op = "u32_sub",
                            left = lane,
                            right = distance,
                            type = "u32",
                            source = lower.site(method)
                        ),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local accumulated = new scalarIR.Fixed(
                        op = "u32_add",
                        left = current,
                        right = previous,
                        type = "u32",
                        source = lower.site(method)
                    )
                    local function store(value: scalarIR.Expr): scalarIR.SharedStore
                        return new scalarIR.SharedStore(
                            op = "shared_store",
                            shared = targetName,
                            index = lane,
                            value = value,
                            source = lower.site(method)
                        )
                    end

                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.If(
                                op = "if",
                                clauses = {
                                    new scalarIR.Clause(
                                        condition = new scalarIR.Binary(
                                            op = "ge",
                                            left = lane,
                                            right = distance,
                                            type = "bool",
                                            source = lower.site(method)
                                        ),
                                        body = {store(accumulated)},
                                        source = lower.site(method)
                                    ),
                                },
                                elseBody = {store(current)},
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                    sourceName, targetName = targetName, sourceName
                    offset = offset * 2
                end
                if sourceName ~= valuesName then
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.SharedStore(
                                op = "shared_store",
                                shared = valuesName as string,
                                index = lane,
                                value = new scalarIR.SharedLoad(
                                    op = "shared_load",
                                    shared = sourceName,
                                    index = lane,
                                    type = "u32",
                                    source = lower.site(method)
                                ),
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                end
            elseif method ~= nil and phaseMethod == "run" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                if #args ~= 1 or args[1].kind ~= "funcExpr" then
                    context.reject(lower.site(method), "phases:run takes one immediate function")
                end
                local callback = (args[1] as cst.FuncExpr).body as cst.Funcbody?
                local params = callback ~= nil and (callback as cst.Funcbody).params or {}
                if callback == nil or #params ~= 1 or (params[1] as cst.Param).name == nil then
                    context.reject(lower.site(args[1]), "a phase callback takes exactly one localIndex parameter")
                end
                local localName = ((params[1] as cst.Param).name as lexer.Token).text
                local inner = inherit(environment)
                inner[
                    localName
                ] = new scalarIR.WorkgroupIndex(op = "local_index", type = "u32", source = lower.site(params[1]))
                local previousPhase, previousLocal = kernel.inPhase, kernel.localIndexName
                kernel.inPhase = true
                kernel.localIndexName = localName
                local callbackBlock = (callback as cst.Funcbody).body as cst.Block?
                local lowered = lower.block(
                    callbackBlock ~= nil and (callbackBlock as cst.Block).stats or {},
                    inner,
                    kernel
                )
                kernel.inPhase = previousPhase
                kernel.localIndexName = previousLocal
                if #lowered == 0 then
                    context.reject(lower.site(args[1]), "a workgroup phase may not be empty")
                end
                if sharedPhaseCollision(lowered) ~= nil then
                    context.reject(lower.site(args[1]), "a phase cannot read another lane from scratch it also writes")
                end
                out[#out + 1] = new scalarIR.Phase(op = "phase", body = lowered, source = lower.site(stat))
            else
                local effect = lower.expression(statement.expr as cst.Node, environment, kernel.index, kernel)
                if effect.type ~= "lua_effect"
                    or tostring(effect.op):match("^lua_builder_") == nil
                    and effect.op ~= "lua_scratch_u32_set"
                    and effect.op ~= "lua_scratch_u8_set"
                    and effect.op ~= "lua_scratch_u8_set4"
                    and effect.op ~= "simd_store4_u8"
                    and effect.op ~= "lua_scratch_u8_reset" then
                    context.reject(lower.site(stat), "native element stores use output[index] = value")
                end
                out[#out + 1] = effect as scalarIR.Statement
            end
        elseif kind == "assignStmt" then
            assignStmt(stat as cst.AssignStmt, out, environment, kernel)
        elseif kind == "ifStmt" then
            local branch = stat as cst.IfStmt
            local clauses: {scalarIR.Clause} = {}
            -- A condition that is statically false -- a monomorphized const
            -- carrier comparison -- drops its clause without lowering the
            -- body; a statically true one absorbs everything after it.
            local decided = false
            for _, arm in ipairs(branch.clauses or {}) do
                if not decided then
                    local condition = lower.expression(arm.cond as cst.Node, environment, kernel.index, kernel)
                    if condition.type ~= "bool" then
                        context.reject(lower.site(arm.cond), "native branch conditions must be boolean")
                    end
                    local known = staticTruth(condition)
                    if known ~= false then
                        local cursor, spanName = cursorBound(arm.cond)
                        local cursorBounds: {[string]: string}? = nil
                        if cursor ~= nil and spanName ~= nil then
                            cursorBounds = {[cursor as string] = spanName as string}
                        end
                        clauses[
                            #clauses + 1
                        ] = new scalarIR.Clause(
                            condition = condition,
                            body = nestedWithCursor(arm.body, cursor, spanName),
                            cursorBounds = cursorBounds,
                            source = lower.site(arm)
                        )
                        if known == true then
                            decided = true
                        end
                    end
                end
            end

            local elseClause = branch.elseClause
            local elseBody = not decided and elseClause ~= nil and nested((elseClause as cst.ElseClause).body) or nil
            if #clauses == 0 and elseBody ~= nil then
                -- Every condition was statically false: the else is the
                -- whole statement, kept as one always-taken clause so block
                -- scoping and emission stay on the ordinary path.
                clauses[
                    1
                ] = new scalarIR.Clause(
                    condition = new scalarIR.Bool(op = "bool", value = true, type = "bool", source = lower.site(stat)),
                    body = elseBody,
                    source = lower.site(stat)
                )
                elseBody = nil
            end
            if #clauses > 0 then
                out[
                    #out + 1
                ] = new scalarIR.If(op = "if", clauses = clauses, elseBody = elseBody, source = lower.site(stat))
            end
        elseif kind == "fornumStmt" then
            -- A bounded nested loop with an integer induction variable. The
            -- outer row loop already counts in an integer; a `while` over a
            -- number local does the same job with a double, which is a worse
            -- lowering of the same intent.
            local loop = stat as cst.FornumStmt
            if loop.step ~= nil then
                context.reject(lower.site(stat), "a native nested for loop takes no explicit step")
            end

            local from = forBound(
                lower.expression(loop.start as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            local to = forBound(
                lower.expression(loop.stop as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            if loop.var == nil then
                context.reject(lower.site(stat), "a native for loop needs an induction variable")
            end

            local inner = inherit(environment)
            local binding = bind((loop.var as lexer.Token).text, "i32", nil, stat, inner, kernel)
            local bounding = from.op == "constant_i32" and (
                from as scalarIR.IntConstant
            ).value == "1" and to.op == "span_count" and (to as scalarIR.SpanCount).span or nil
            local previousIndex, previousCName = kernel.index, kernel.indexCName
            local previousBound = kernel.boundSpan
            kernel.index = binding.name
            kernel.indexCName = binding.cName
            kernel.boundSpan = bounding
            local loopBody = lower.block(loop.body ~= nil and (loop.body as cst.Block).stats or {}, inner, kernel)
            kernel.index = previousIndex
            kernel.indexCName = previousCName
            kernel.boundSpan = previousBound
            out[
                #out + 1
            ] = new scalarIR.Fornum(
                op = "fornum",
                binding = binding,
                from = from,
                to = to,
                body = loopBody,
                boundSpan = bounding,
                source = lower.site(stat)
            )
        elseif kind == "whileStmt" then
            -- A nested loop the kernel controls itself, as distinct from the
            -- outer row loop the prototype supplies. Nothing here bounds its
            -- trip count: the condition is ordinary Nupp and termination is the
            -- source's business, exactly as it is when the same function runs as
            -- ordinary Nupp. That is a real difference from the outer loop,
            -- whose bounds the IR carries and the verifier checks.
            local loop = stat as cst.WhileStmt
            local condition = lower.expression(loop.cond as cst.Node, environment, kernel.index, kernel)
            if condition.type ~= "bool" then
                context.reject(lower.site(loop.cond), "native loop conditions must be boolean")
            end
            local cursor, spanName = cursorBound(loop.cond)
            out[
                #out + 1
            ] = new scalarIR.While(
                op = "while",
                condition = condition,
                body = nestedWithCursor(loop.body, cursor, spanName),
                cursorBounds = cursor ~= nil and {[cursor as string] = spanName as string} or nil,
                source = lower.site(stat)
            )
        elseif kind == "doStmt" then
            out[
                #out + 1
            ] = new scalarIR.Block(op = "block", body = nested((stat as cst.DoStmt).body), source = lower.site(stat))
        elseif kind == "breakStmt" then
            out[#out + 1] = new scalarIR.Break(op = "break", source = lower.site(stat))
        elseif kind == "continueStmt" then
            out[#out + 1] = new scalarIR.Continue(op = "continue", source = lower.site(stat))
        elseif kind == "returnStmt" then
            local returned = stat as cst.ReturnStmt
            local exprs = returned.exprs or {}
            if #exprs ~= #kernel.resultTypes then
                context.reject(lower.site(stat), "native return count does not match the function result")
            end
            local values: {scalarIR.Expr} = {}
            for position, expression in ipairs(exprs) do
                local returnedName = lower.nameOf(expression)
                local returnedBinding = returnedName ~= nil and environment[returnedName as string] or nil
                if returnedBinding ~= nil and returnedBinding.type == "lua_string_buffer" then
                    values[
                        position
                    ] = new scalarIR.LuaStringBufferFinish(
                        op = "lua_string_buffer_finish",
                        buffer = new scalarIR.Name(
                            op = "local",
                            name = returnedBinding.name,
                            cName = returnedBinding.cName,
                            type = "lua_string_buffer",
                            source = lower.site(expression)
                        ),
                        type = "lua_string",
                        source = lower.site(expression)
                    )
                else
                    values[
                        position
                    ] = lower.convert(
                        lower.expression(expression, environment, kernel.index ~= "" and kernel.index or nil, kernel),
                        kernel.resultTypes[position],
                        lower.site(expression),
                        context
                    )
                end
            end
            out[#out + 1] = new scalarIR.Return(op = "return", values = values, source = lower.site(stat))
        else
            context.reject(
                lower.site(stat),
                "statement kind " .. tostring(kind) .. " is not admitted in the native loop"
            )
        end
    end

    return out
end

----------------------------------------------------------------------------
-- Parameters and regions
----------------------------------------------------------------------------

--- The span one `#x` names, if the node is that.
function lower.dotCount(node: cst.Node?): string?
    if node == nil or node.kind ~= "unop" then
        return nil
    end
    local length = node as cst.Unop
    if length.op == nil or (length.op as lexer.Token).text ~= "#" then
        return nil
    end

    return lower.nameOf(length.operand)
end

--- What the kernel prototype declares.
record lower.Signature
    --- Every parameter, in order.
    params: {scalarIR.Param}

    --- The same, by name.
    byName: {[string]: scalarIR.Param}

    --- Only the spans, in order, which is the order their regions are numbered.
    spans: {scalarIR.Param}

    --- The writable spans. The first is the primary output, whose length bounds
    --- the loop.
    writes: {scalarIR.Param}

    --- The readable spans.
    reads: {scalarIR.Param}
end

--- Admits the kernel prototype's parameters.
---
--- Ownership is not inferred from use: a writable span has to be written
--- `exclusive` and a readable one `borrows`, because the alias facts the
--- generated C rests on are those borrows restated, and a mode this had to guess
--- would be a `restrict` nobody proved.
function lower.parameters(
    raws: {cst.Param},
    checkedSignature: any?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context,
    useSignatureTypes: boolean?,
    omitted: {[integer]: boolean}?
): lower.Signature
    local signature = new lower.Signature(params = {}, byName = {}, spans = {}, writes = {}, reads = {})
    for position, raw in ipairs(raws) do
        if omitted ~= nil and omitted[position] == true then
            goto continue
        end
        local name = raw.name ~= nil and (raw.name as lexer.Token).text or nil
        if name == nil then
            context.reject(lower.site(raw), "every kernel parameter must be named")
        end
        if signature.byName[name as string] ~= nil then
            context.reject(lower.site(raw), "duplicate kernel parameter " .. (name as string))
        end

        local spelling = lower.compactType(raw.type)
        local resolved = useSignatureTypes == true and checkedSignature ~= nil and checkedSignature.params[
            position
        ] or checkedType(raw.type, context)
        local mode = context.checked and checkedSignature ~= nil and checkedSignature.paramModes[
            position
        ] or raw.modeTok ~= nil and (raw.modeTok as lexer.Token).text or nil
        local sourceType = context.checked and sourceSpelling(resolved) or spelling
        local valueType = context.checked and semanticValueType(resolved) or lower.sourceValueType(spelling)
        local at = raw.type or raw
        local writeElement = lower.spanElement(spelling, resolved, "WriteSpan", at, declarations, layouts, context)
        local readElement = lower.spanElement(spelling, resolved, "Span", at, declarations, layouts, context)
        local region = "r" .. tostring(#signature.spans)

        local param: scalarIR.Param
        if writeElement ~= nil then
            if mode ~= "exclusive" then
                context.reject(lower.site(raw), "a writable native span must be declared exclusive")
            end
            param = new scalarIR.Param(
                kind = "write_span",
                name = name as string,
                type = (writeElement as lower.Element).type,
                sourceType = (writeElement as lower.Element).sourceType,
                spanModule = (writeElement as lower.Element).spanModule,
                region = region,
                access = "readwrite",
                ownership = "exclusive",
                source = lower.site(raw)
            )
            param.element = writeElement
            signature.writes[#signature.writes + 1] = param
            signature.spans[#signature.spans + 1] = param
        elseif readElement ~= nil then
            if mode ~= "borrows" then
                context.reject(lower.site(raw), "a readable native span must be declared borrows")
            end
            param = new scalarIR.Param(
                kind = "read_span",
                name = name as string,
                type = (readElement as lower.Element).type,
                sourceType = (readElement as lower.Element).sourceType,
                spanModule = (readElement as lower.Element).spanModule,
                region = region,
                access = "read",
                ownership = "shared",
                source = lower.site(raw)
            )
            param.element = readElement
            signature.reads[#signature.reads + 1] = param
            signature.spans[#signature.spans + 1] = param
        elseif valueType == "f32" or valueType == "f64" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a uniform float parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "u32" or valueType == "i32" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a uniform integer parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "bool" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a boolean parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = "bool",
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "lua_string" or valueType == "lua_bytes" then
            if valueType == "lua_string" and mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a string parameter has no ownership mode")
            elseif valueType == "lua_bytes" and mode ~= "borrows" then
                context.reject(lower.site(raw), "a string-or-buffer parameter must be declared borrows")
            end
            param = new scalarIR.Param(
                kind = "scalar",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "lua_value" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "an opaque Lua value parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "scalar",
                name = name as string,
                type = "lua_value",
                sourceType = sourceType,
                source = lower.site(raw)
            )
        else
            context.reject(lower.site(at), "parameter type " .. sourceType .. " is not admitted")
            param = new scalarIR.Param(kind = "uniform", name = name as string, type = "f64")
        end

        signature.params[#signature.params + 1] = param
        signature.byName[name as string] = param
        ::continue::
    end

    return signature
end

--- The borrow regions, and the complete alias matrix over them.
---
--- Every pair carries a fact rather than only the interesting ones: a pair with
--- no fact is a `restrict` nobody justified, and the verifier checks the count.
function lower.regions(spans: {scalarIR.Param}): ({scalarIR.Region}, {scalarIR.AliasFact})
    local regions: {scalarIR.Region} = {}
    for position, param in ipairs(spans) do
        regions[
            position
        ] = new scalarIR.Region(
            id = param.region as string,
            param = param.name,
            access = param.access as any,
            proof = tostring(param.ownership) .. "_borrow"
        )
    end

    local facts: {scalarIR.AliasFact} = {}
    for left = 1, #spans do
        for right = left + 1, #spans do
            local hasWrite = spans[left].kind == "write_span" or spans[right].kind == "write_span"
            facts[
                #facts + 1
            ] = new scalarIR.AliasFact(
                relation = hasWrite and "disjoint" or "may_alias",
                left = spans[left].region as string,
                right = spans[right].region as string,
                proof = hasWrite and "exclusive_borrow" or "shared_borrows"
            )
        end
    end

    return regions, facts
end

----------------------------------------------------------------------------
-- Guards
----------------------------------------------------------------------------

--- The one clause of a guard that does nothing but call `error`.
---
--- Both guards have this shape, and it is the shape that makes them checkable:
--- a guard whose body did something else would be a guard whose failure the
--- backend could not reason about.
function lower.isGuardStatement(stat: cst.Node?): boolean
    if stat == nil then
        return false
    end
    if stat.kind == "ifStmt" then
        return true
    end
    local called = stat.kind == "callStmt" and (stat as cst.CallStmt).expr or nil

    return called ~= nil and called.kind == "call" and lower.nameOf((called as cst.Call).obj) == "assert"
end

--- One precondition, in either spelling.
function lower.guardClause(stat: cst.Node?, shapeWhy: string, bodyWhy: string, context: lower.Context): lower.GuardForm
    local asserted = stat ~= nil and stat.kind == "callStmt" and (stat as cst.CallStmt).expr or nil
    if asserted ~= nil and asserted.kind == "call" and lower.nameOf((asserted as cst.Call).obj) == "assert" then
        local args = (asserted as cst.Call).args
        local exprs = args ~= nil and args.kind == "args" and ((args as cst.Args).exprs or {}) or {}
        if #exprs < 1 or #exprs > 2 then
            context.reject(lower.site(stat), "an assert guard takes its condition and an optional message")
        end

        return new lower.GuardForm(cond = exprs[1], asserted = true)
    end

    local branch = stat as cst.IfStmt
    if stat == nil or stat.kind ~= "ifStmt" or #(branch.clauses or {}) ~= 1 or branch.elseClause ~= nil then
        context.reject(lower.site(stat), shapeWhy)
    end

    local clause = (branch.clauses as {cst.IfClause})[1]
    local body = clause.body ~= nil and (clause.body as cst.Block).stats or {}
    local first = body[1]
    local call = first ~= nil and first.kind == "callStmt" and (first as cst.CallStmt).expr or nil
    if #body ~= 1 or call == nil or call.kind ~= "call" or lower.nameOf((call as cst.Call).obj) ~= "error" then
        context.reject(lower.site(stat), bodyWhy)
    end

    return new lower.GuardForm(cond = clause.cond, asserted = false)
end

--- The length agreements one guard proves.
---
--- Every span addressed by the loop index has to be covered, because a shorter
--- one would be read past its end. Spans reached only through proved cursors do
--- not need an equality the algorithm may be unable to state.
function lower.lengthGuards(
    stat: cst.Node,
    form: lower.GuardForm,
    signature: lower.Signature,
    context: lower.Context,
    partial: boolean?
): {scalarIR.Guard}
    local primary = signature.writes[1]
    local guarded: {[string]: scalarIR.Source} = {}
    local joiner = form.asserted and "and" or "or"
    local comparison = form.asserted and "==" or "~="

    --- One comparison, or a chain of them joined by the spelling's connective.
    local function collect(expr: cst.Node?): nil
        local operator = expr as cst.Binop
        if expr ~= nil and expr.kind == "binop" and operator.op ~= nil and (
            operator.op as lexer.Token
        ).text == joiner then
            collect(operator.lhs)
            collect(operator.rhs)

            return
        end
        if expr == nil or expr.kind ~= "binop" or operator.op == nil or (
            operator.op as lexer.Token
        ).text ~= comparison then
            context.reject(lower.site(expr or stat), "the guard may only compare span counts with " .. comparison)
        end

        local left, right = lower.dotCount(operator.lhs), lower.dotCount(operator.rhs)
        local other: string? = nil
        if left == primary.name then
            other = right
        elseif right == primary.name then
            other = left
        end

        local named = other ~= nil and signature.byName[other as string] or nil
        if named == nil or named.region == nil or other == primary.name then
            context.reject(lower.site(expr), "each guard comparison must compare the primary output with another span")
        end
        if guarded[other as string] ~= nil then
            context.reject(lower.site(expr), "duplicate length guard for " .. (other as string))
        end
        guarded[other as string] = lower.site(expr)
    end

    collect(form.cond)

    local guards: {scalarIR.Guard} = {}
    for _, span in ipairs(signature.spans) do
        if span.name ~= primary.name then
            -- A map entry may leave a span out of the guard when the body only
            -- reaches it through proved cursors; lowering checks that any
            -- loop-index access names a guarded span, so the omission cannot
            -- widen what the kernel may touch on either execution target.
            if guarded[span.name] == nil and partial ~= true then
                context.reject(lower.site(stat), "the length guard does not cover span " .. span.name)
            end
            if guarded[span.name] ~= nil then
                guards[
                    #guards + 1
                ] = new scalarIR.Guard(
                    op = "equal_count",
                    left = primary.name,
                    right = span.name,
                    source = guarded[span.name]
                )
            end
        end
    end

    return guards
end

--- The range one optional second guard proves.
---
--- Matched against its exact written form rather than interpreted. The generated
--- loop reads these bounds without comparing them, so what makes that sound is
--- that this guard was checked -- and a guard the backend only approximately
--- understood would not be a check.
function lower.rangeGuard(
    stat: cst.Node,
    form: lower.GuardForm,
    signature: lower.Signature,
    context: lower.Context
): scalarIR.RangeGuard
    local primary = signature.writes[1]
    local written = lower.compactType(form.cond)
    local pattern = form.asserted
        and "^([%a_][%w_]*)>=1and([%a_][%w_]*)<=#([%a_][%w_]*)and"
        or "^([%a_][%w_]*)<1or([%a_][%w_]*)>#([%a_][%w_]*)or"
    local firstName, lastName, countName = written:match(pattern)
    local expected = ""
    if firstName ~= nil then
        if form.asserted then
            expected = tostring(
                firstName
            ) .. ">=1and" .. tostring(
                lastName
            ) .. "<=#" .. primary.name .. "and" .. tostring(firstName) .. "<=" .. tostring(lastName) .. "+1"
        else
            expected = tostring(
                firstName
            ) .. "<1or" .. tostring(
                lastName
            ) .. ">#" .. primary.name .. "or" .. tostring(firstName) .. ">" .. tostring(lastName) .. "+1"
        end
    end
    if written ~= expected or countName ~= primary.name then
        context.reject(
            lower.site(form.cond),
            form.asserted
            and "range guard must be `first >= 1 and last <= #output and first <= last + 1`"
            or "range guard must be `first < 1 or last > #output or first > last + 1`"
        )
    end

    local first = signature.byName[tostring(firstName)]
    local last = signature.byName[tostring(lastName)]
    if first == nil
        or last == nil
        or first.kind ~= "uniform"
        or last.kind ~= "uniform"
        or first.sourceType ~= "integer"
        or last.sourceType ~= "integer"
    then
        context.reject(lower.site(form.cond), "range bounds must be uniform integer parameters")
    end

    return new scalarIR.RangeGuard(
        first = tostring(firstName),
        last = tostring(lastName),
        count = primary.name,
        source = lower.site(stat)
    )
end

--- Admits the outer loop, and answers what it counts with.
---
--- Its bounds have to be the ones a guard proved, written the same way. The IR
--- carries them and the verifier checks them, which is what lets the generated
--- loop read them rather than checking them again per element.
function lower.loopIndex(
    loop: cst.Node,
    rangeGuard: scalarIR.RangeGuard?,
    signature: lower.Signature,
    context: lower.Context
): string
    local primary = signature.writes[1]
    if loop.kind ~= "fornumStmt" then
        context.reject(lower.site(loop), "the final statement must be a numeric for loop")
    end

    local counted = loop as cst.FornumStmt
    local start = counted.start
    local literal = start ~= nil and start.kind == "number" and (start as cst.NumberLit).token or nil
    local first = lower.nameOf(start) or (literal ~= nil and (literal as lexer.Token).text or nil)
    if first ~= (rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).first or "1") then
        context.reject(lower.site(start or loop), "kernel loop start must match its verified range")
    end
    if counted.step ~= nil then
        context.reject(lower.site(counted.step), "the first subset does not admit an explicit loop step")
    end

    local stop = lower.nameOf(counted.stop) or lower.dotCount(counted.stop)
    local wanted = rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).last or primary.name
    if stop ~= wanted then
        context.reject(lower.site(counted.stop or loop), "the loop bound must match its verified range")
    end
    if counted.var == nil then
        context.reject(lower.site(loop), "the kernel loop needs an index variable")
    end

    return (counted.var as lexer.Token).text
end

----------------------------------------------------------------------------
-- Scanning a module into a program
----------------------------------------------------------------------------

--- One `@aot` application: the annotation chain, and what it decorates.
record lower.Application
    --- The annotations, outermost first. They stack, so `@aot` may be written
    --- above or below `@relax` and both orders mean the same thing.
    chain: {cst.PragmaStmt}

    --- The statement at the end of the chain.
    tail: cst.Node?

    --- The outermost annotation, for a diagnostic that has to name the whole
    --- application.
    at: cst.PragmaStmt
end

--- One checked const-generic application lowered as its own native body.
--- Discovery and budgeting happen once for the deliverable; this carries the
--- selected private ABI and constant environment into ordinary AOT lowering.
record lower.Specialization
    name: string
    signature: any
    values: {[string]: scalarIR.Expr}
    omitted: {[integer]: boolean}
end

--- What one module offers this backend.
record lower.Declarations
    applications: {lower.Application}

    --- Visible local functions, which is where a pure helper comes from.
    helpers: {[string]: cst.LocalFuncStmt}

    --- The file's own `@aot` declarations, by name. A call from one compiled
    --- body to another is a real call to that entry's own symbol rather than an
    --- inlined helper, so the callee is compiled once and keeps its contract.
    entries: {[string]: cst.LocalFuncStmt}

    --- Visible local structs, which is what a span may hold.
    structs: {[string]: cst.RecordDecl}

    --- Module values and exact compiler intrinsics visible to every function.
    modules: {[string]: string}

    intrinsicAliases: {[string]: string}

    constantNumbers: {[string]: string}
end

--- Finds the `@aot` functions, and what they may call and hold.
---
--- @param checked whether the tree came from the real checker, which records
---   `@aot` as a fact on the body rather than leaving it to be read off the
---   annotation
function lower.scan(chunk: cst.Chunk, checked: boolean): lower.Declarations
    local found = new lower.Declarations(
        applications = {},
        helpers = {},
        entries = {},
        structs = {},
        modules = {table = "@prelude.table", string = "@prelude.string"},
        intrinsicAliases = {},
        constantNumbers = {}
    )
    for _, block in ipairs(chunk.blocks or {}) do
        for _, stat in ipairs((block as cst.Block).stats or {}) do
            if stat.kind == "localStmt" then
                local declaration = stat as cst.LocalStmt
                local names, exprs = declaration.names or {}, declaration.exprs or {}
                for _, declared in ipairs(names) do
                    if declared.text == "table" then
                        found.modules.table = "@shadowed.table"
                    elseif declared.text == "string" then
                        found.modules.string = "@shadowed.string"
                    end
                end
                if #names == 1 and #exprs == 1 and exprs[1].kind == "call" then
                    local required = (exprs[1] as any).requiredModule
                    local called = exprs[1] as cst.Call
                    if required == nil and lower.nameOf(called.obj) == "require" and called.args ~= nil then
                        local arguments = (called.args as cst.Args).exprs or {}
                        local literal = #arguments == 1 and arguments[
                            1
                        ].kind == "string" and (arguments[1] as cst.StringLit).token or nil
                        local written = literal ~= nil and (literal as lexer.Token).text or ""
                        required = written:match('^"(.*)"$') or written:match("^'(.*)'$")
                    end
                    if required ~= nil then
                        found.modules[names[1].text] = required
                    end
                end
                if declaration.isConst and #names == 1 and #exprs == 1 and exprs[1].kind == "number" then
                    local token = (exprs[1] as cst.NumberLit).token
                    if token ~= nil and tonumber((token as lexer.Token).text) ~= nil then
                        found.constantNumbers[names[1].text] = (token as lexer.Token).text
                    end
                end
            end
            if stat.kind == "pragmaStmt" then
                local chain: {cst.PragmaStmt} = {}
                local cursor: cst.Node? = stat
                while cursor ~= nil and cursor.kind == "pragmaStmt" do
                    chain[#chain + 1] = cursor as cst.PragmaStmt
                    cursor = (cursor as cst.PragmaStmt).stat
                end

                local isAot = false
                for _, link in ipairs(chain) do
                    if link.name ~= nil and (link.name as lexer.Token).text == "aot" then
                        isAot = true
                    end
                end
                if checked then
                    -- The checker accepts only a local declaration. Keep that
                    -- boundary explicit here as well: a partial producer or a tree
                    -- built by a lowering harness must not turn a qualified function's
                    -- absent local-name token into a nil table key below.
                    local decorated = cursor ~= nil and cursor.kind == "localFuncStmt" and (
                        cursor as cst.LocalFuncStmt
                    ) or nil
                    isAot = decorated ~= nil and (
                        decorated as cst.LocalFuncStmt
                    ).body ~= nil and ((decorated as cst.LocalFuncStmt).body as cst.Funcbody).aotRequired == true
                end
                if isAot then
                    found.applications[
                        #found.applications + 1
                    ] = new lower.Application(chain = chain, tail = cursor, at = stat as cst.PragmaStmt)
                    local named = cursor ~= nil and cursor.kind == "localFuncStmt" and (
                        cursor as cst.LocalFuncStmt
                    ) or nil
                    if named ~= nil and (named as cst.LocalFuncStmt).name ~= nil then
                        found.entries[((named as cst.LocalFuncStmt).name as lexer.Token).text] = named
                    end
                end
            elseif stat.kind == "localFuncStmt" and (stat as cst.LocalFuncStmt).name ~= nil then
                local declaration = stat as cst.LocalFuncStmt
                found.helpers[(declaration.name as lexer.Token).text] = declaration
            elseif stat.kind == "recordDecl" then
                local declaration = stat as cst.RecordDecl
                if declaration.declKind == "struct" and declaration.name ~= nil then
                    found.structs[(declaration.name as lexer.Token).text] = declaration
                end
            end
        end
    end

    -- A function export may be given a local alias before an AOT body uses it.
    -- Resolve that alias through the module binding rather than through spelling.
    for _, block in ipairs(chunk.blocks or {}) do
        for _, stat in ipairs((block as cst.Block).stats or {}) do
            if stat.kind == "localStmt" then
                local declaration = stat as cst.LocalStmt
                local names, exprs = declaration.names or {}, declaration.exprs or {}
                if #names == 1 and #exprs == 1 and exprs[1].kind == "dotIndex" then
                    local indexed = exprs[1] as cst.DotIndex
                    local root = lower.nameOf(indexed.obj)
                    local moduleName = root ~= nil and found.modules[root as string] or nil
                    if moduleName ~= nil and indexed.name ~= nil then
                        found.intrinsicAliases[names[1].text] = moduleName .. "." .. indexed.name.text
                    end
                end
            end
        end
    end

    return found
end

--- What one `@aot` application asks the backend for.
record lower.Contract
    --- Which execution family consumes this program.
    target: 'cpu' | 'gpu'

    --- Whether a multiply and an add may be fused into one rounding. Per
    --- function and carried in the IR, because it decides what the function
    --- answers rather than only how fast it gets there.
    fpContract: boolean

    --- Whether fixed-width transcendentals may select a native implementation.
    fpTranscendentals: boolean

    --- Whether lane lowering is attempted at all.
    wantsLanes: boolean

    --- Whether it is taken whatever the arithmetic-intensity estimate says.
    lanesRequired: boolean
end

--- Reads one application's contract.
---
--- From the checked body where there is one, because the checker resolved the
--- annotations; from the written annotations otherwise, which is what lets the
--- spike run on a tree the checker never saw.
function lower.contract(
    application: lower.Application,
    body: cst.Funcbody,
    checked: boolean,
    context: lower.Context
): lower.Contract
    local relaxed = body.relaxedGuarantees
    local contract = new lower.Contract(
        target = body.aotTarget == "gpu" and "gpu" or "cpu",
        fpContract = relaxed ~= nil and relaxed["fp-contract"] == true,
        fpTranscendentals = relaxed ~= nil and relaxed["fp-transcendentals"] == true,
        wantsLanes = body.lanesDeclined ~= true,
        lanesRequired = body.lanesRequired == true
    )
    if checked then
        return contract
    end

    for _, link in ipairs(application.chain) do
        local written = link.name ~= nil and (link.name as lexer.Token).text or nil
        if written == "aot" then
            for _, argument in ipairs(link.annotationArgs or {}) do
                local name = argument.name ~= nil and (argument.name as lexer.Token).text or nil
                if name ~= "lanes" and name ~= "target" then
                    context.reject(
                        lower.site(link),
                        "@aot takes target = \"cpu\", target = \"gpu\", a lanes override, or nothing"
                    )
                end

                local value = argument.expr
                if name == "target" then
                    local token = value ~= nil and cst.firstToken(value as cst.Node) or nil
                    local requested = token ~= nil and (token as lexer.Token).text or ""
                    if requested == "\"gpu\"" or requested == "'gpu'" then
                        contract.target = "gpu"
                        contract.wantsLanes = false
                    elseif requested ~= "\"cpu\"" and requested ~= "'cpu'" then
                        context.reject(lower.site(argument), "@aot target must be \"cpu\" or \"gpu\"")
                    end
                elseif value ~= nil and value.kind == "falseExpr" then
                    contract.wantsLanes = false
                end
                if name == "lanes" and value ~= nil and value.kind == "trueExpr" then
                    contract.lanesRequired = true
                end
            end
        elseif written == "relax" then
            for _, argument in ipairs(link.annotationArgs or {}) do
                local token = argument.expr ~= nil and cst.firstToken(argument.expr as cst.Node) or nil
                local text = token ~= nil and (token as lexer.Token).text or ""
                if text:sub(1, 1) == "\"" or text:sub(1, 1) == "'" then
                    text = text:sub(2, -2)
                end
                if text == "fp-contract" then
                    contract.fpContract = true
                elseif text == "fp-transcendentals" then
                    contract.fpTranscendentals = true
                end
            end
        end
    end

    return contract
end

--- The one `@aot` function this backend compiles, and its body.
function lower.kernelBody(
    application: lower.Application,
    context: lower.Context,
    specialization: lower.Specialization?
): (cst.LocalFuncStmt, cst.Funcbody)
    local fn = application.tail
    if fn == nil or fn.kind ~= "localFuncStmt" then
        context.reject(lower.site(fn or application.at), "@aot must decorate a local function with a visible body")
    end

    local declaration = fn as cst.LocalFuncStmt
    local body = declaration.body as cst.Funcbody?
    if body == nil
        or body.generics ~= nil
        and specialization == nil
        or body.varargParam ~= nil
        or body.captureTakes ~= nil
        or body.captureBorrows ~= nil
    then
        context.reject(lower.site(body or fn), "generic, variadic, and capturing kernels are not admitted")
    end

    return declaration, body as cst.Funcbody
end

--- The lowering environment either entry shape starts from: the
--- specialization's carriers, then the uniform and scalar parameters, each
--- scalar carrying its positional C name.
local function loweringEnvironment(signature: lower.Signature, specialization: lower.Specialization?): {[string]: any}
    local environment: {[string]: any} = {}
    if specialization ~= nil then
        for carrier, value in pairs((specialization as lower.Specialization).values) do
            environment[carrier] = value
        end
    end
    for position, param in ipairs(signature.params) do
        if param.kind == "uniform" or param.kind == "scalar" then
            if param.kind == "scalar" then
                (param as any).cName = tostring(position)
            end
            environment[
                param.name
            ] = specialization ~= nil and (specialization as lower.Specialization).values[param.name] or param
        end
    end

    return environment
end

--- Lowers one whole `@aot` function to AOT IR.
---
--- The IR is what everything downstream is written from -- the verifier, the C,
--- the wrapper -- so this is where the source stops being consulted. What the
--- function is has been decided by the time this returns.
function lower.program(
    declarations: lower.Declarations,
    application: lower.Application,
    checked: boolean,
    context: lower.Context,
    specialization: lower.Specialization?
): scalarIR.Program
    local fn, body = lower.kernelBody(application, context, specialization)
    local contract = lower.contract(application, body, checked, context)

    local layouts = new lower.Layouts(ordered = {}, byName = {})
    local checkedSignature = context.checked and (
        specialization ~= nil and (specialization as lower.Specialization).signature or body.signatureType
    ) or nil
    if context.checked and checkedSignature == nil then
        context.reject(lower.site(body), "the checker did not publish this AOT signature")
    end
    local signature = lower.parameters(
        (body.params or {}) as {cst.Param},
        checkedSignature,
        declarations.structs,
        layouts,
        context,
        specialization ~= nil,
        specialization ~= nil and (specialization as lower.Specialization).omitted or nil
    )
    local regions, aliasFacts = lower.regions(signature.spans)
    local sourceName = (fn.name as lexer.Token).text
    local name = specialization ~= nil and (specialization as lower.Specialization).name or sourceName
    local symbol = scalarIR.privateSymbol(name)

    local resultTypes: {scalarIR.Type} = {}
    local resultSourceTypes: {string} = {}
    local rets = body.rets or {}
    local resolvedResults = checkedSignature ~= nil and checkedSignature.rets or nil
    if #rets == 1 and (
        context.checked and resolvedResults[
            1
        ] ~= nil and semanticRaw(
            resolvedResults[1]
        ).tag == "nil" or not context.checked and lower.compactType(rets[1]) == "nil"
    ) then
        rets = {}
    end
    if #rets > 4 then
        context.reject(lower.site(body), "general AOT entries currently return at most four scalar values")
    end
    for position, result in ipairs(rets) do
        local resolved = context.checked and resolvedResults[position] or nil
        local sourceType = context.checked and sourceSpelling(resolved) or lower.compactType(result)
        local resultType = context.checked and semanticValueType(resolved, true) or lower.helperValueType(sourceType)
        if not context.checked then
            if resultType == nil and sourceType == "string" then
                resultType = "lua_string"
            elseif resultType == nil and sourceType == "any" then
                resultType = "lua_value"
            elseif resultType == nil and sourceType == "nil" then
                resultType = "lua_nil"
            elseif resultType == nil and (sourceType:sub(1, 1) == "{" or sourceType == "table") then
                resultType = "lua_table"
            end
        end
        if resultType == nil then
            context.reject(lower.site(result), "AOT entry results are admitted scalar values or fresh tables")
        end
        resultTypes[position] = resultType as scalarIR.Type
        resultSourceTypes[position] = sourceType
    end

    local statements = body.body ~= nil and (body.body as cst.Block).stats or {}
    local workgroupCall: cst.Call? = nil
    if contract.target == "gpu" and #statements >= 1 and statements[#statements].kind == "callStmt" then
        local expression = (statements[#statements] as cst.CallStmt).expr
        if expression ~= nil and expression.kind == "call" then
            local candidate = expression as cst.Call
            local path = lower.dottedName(candidate.obj)
            local root = path ~= nil and (path as string):match("^([^.]+)%.workgroups$") or nil
            if root ~= nil and declarations.modules[root as string] == "nupp.gpu" then
                workgroupCall = candidate
            end
        end
    end

    if workgroupCall ~= nil then
        for index = 1, #statements - 1 do
            if statements[index].kind ~= "localStmt" then
                context.reject(
                    lower.site(statements[index]),
                    "only initialized scalar locals may precede gpu.workgroups"
                )
            end
        end
        if #resultTypes ~= 0 or #signature.writes == 0 then
            context.reject(lower.site(body), "a GPU workgroup entry returns nil and takes a writable span")
        end
        local args = (
            workgroupCall as cst.Call
        ).args ~= nil and ((((workgroupCall as cst.Call).args as cst.Args).exprs or {})) or {}
        if #args ~= 3 or args[3].kind ~= "funcExpr" then
            context.reject(
                lower.site(workgroupCall),
                "gpu.workgroups takes groups, a static size, and an immediate function"
            )
        end
        local sizeToken = cst.firstToken(args[2])
        local size = sizeToken ~= nil and tonumber((sizeToken as lexer.Token).text) or nil
        if size == nil or size ~= math.floor(size as number) or size < 1 or size > 256 then
            context.reject(lower.site(args[2]), "GPU workgroup size must be an integer literal from 1 through 256")
        end
        local controller = (args[3] as cst.FuncExpr).body as cst.Funcbody?
        local controllerParams = controller ~= nil and (controller as cst.Funcbody).params or {}
        if controller == nil or #controllerParams ~= 2 or (
            controllerParams[1] as cst.Param
        ).name == nil or (controllerParams[2] as cst.Param).name == nil then
            context.reject(lower.site(args[3]), "a workgroup controller takes groupIndex and phases")
        end
        local groupName = ((controllerParams[1] as cst.Param).name as lexer.Token).text
        local phasesName = ((controllerParams[2] as cst.Param).name as lexer.Token).text
        local kernel = new lower.Kernel(
            params = signature.byName,
            layouts = layouts,
            helperDecls = declarations.helpers,
            entryDecls = declarations.entries,
            helpers = {},
            helperOrder = {},
            constantNames = {},
            scratchBounds = {},
            constantOrder = {},
            constantNumbers = declarations.constantNumbers,
            helperState = {},
            modules = declarations.modules,
            intrinsicAliases = declarations.intrinsicAliases,
            stringAccumulators = {},
            symbol = symbol,
            loopSource = lower.site(workgroupCall),
            index = "",
            indexCName = "",
            mapEntry = false,
            resultTypes = {},
            cursorBounds = {},
            lengthBounds = {},
            scratchLengthBounds = {},
            phasesName = phasesName,
            workgroupSize = size as integer,
            shared = {},
            sharedOrder = {},
            usesSimd = false,
            usesNumberToken = false,
            usesLua = false,
            serial = 0,
            context = context
        )
        local environment: {[string]: any} = {}
        for position, param in ipairs(signature.params) do
            if param.kind == "uniform" or param.kind == "scalar" then
                if param.kind == "scalar" then
                    (param as any).cName = tostring(position)
                end
                environment[param.name] = param
            end
        end
        local prefix: {cst.Node} = {}
        for index = 1, #statements - 1 do
            prefix[index] = statements[index]
        end
        local prelude = lower.block(prefix, environment, kernel)
        local groups = lower.expression(args[1], environment, nil, kernel)
        if groups.op == "local" then
            for index = #prelude, 1, -1 do
                local statement = prelude[index]
                if statement.op == "let" and statement.cName == (groups as scalarIR.Name).cName then
                    groups = (statement as scalarIR.Let).value
                    break
                end
            end
        end
        if groups.type ~= "u32" then
            context.reject(lower.site(args[1]), "GPU workgroup count must be uint32")
        end
        local numerator = groups.op == "u32_div" and (groups as scalarIR.Fixed).left or nil
        local divisor = groups.op == "u32_div" and (groups as scalarIR.Fixed).right or nil
        while numerator ~= nil and (numerator.op == "numeric_cast" or numerator.op == "int_to_f64") do
            numerator = (numerator as scalarIR.Convert).value
        end
        while divisor ~= nil and (divisor.op == "numeric_cast" or divisor.op == "int_to_f64") do
            divisor = (divisor as scalarIR.Convert).value
        end
        local divisorValue = divisor ~= nil and (
            divisor.op == "constant" or divisor.op == "constant_i32"
        ) and tonumber((divisor as any).value) or nil
        if numerator == nil or numerator.op ~= "span_count" or divisorValue ~= size then
            context.reject(lower.site(args[1]), "GPU workgroup count must be u32.div(u32.wrap(#span), workgroupSize)")
        end
        local dispatchSpan = (numerator as scalarIR.SpanCount).span
        local groupBinding = bind(groupName, "u32", nil, controllerParams[1], environment, kernel)
        local groupValue = new scalarIR.WorkgroupIndex(
            op = "workgroup_index",
            type = "u32",
            source = lower.site(controllerParams[1])
        )
        local controllerBlock = (controller as cst.Funcbody).body as cst.Block?
        local controllerBody = lower.block(
            controllerBlock ~= nil and (controllerBlock as cst.Block).stats or {},
            environment,
            kernel
        )
        local lowered: {
            scalarIR.Statement
        } = {
            new scalarIR.Let(
                op = "let",
                name = groupName,
                cName = groupBinding.cName,
                type = "u32",
                value = groupValue,
                source = lower.site(controllerParams[1])
            ),
        }
        for _, statement in ipairs(controllerBody) do
            lowered[#lowered + 1] = statement
        end
        local phaseCount = 0
        local function countPhases(block: {scalarIR.Statement}): nil
            for _, statement in ipairs(block) do
                if statement.op == "phase" then
                    phaseCount = phaseCount + 1
                elseif statement.op == "if" then
                    for _, clause in ipairs((statement as scalarIR.If).clauses) do
                        countPhases(clause.body)
                    end
                    countPhases((statement as scalarIR.If).elseBody or {})
                elseif statement.op == "fornum" or statement.op == "while" or statement.op == "block" then
                    countPhases((statement as any).body as {scalarIR.Statement})
                end
            end
        end

        countPhases(lowered)
        if phaseCount == 0 then
            context.reject(lower.site(args[3]), "a workgroup controller must run at least one phase")
        end
        local scratchBytes = 0
        for _, shared in ipairs(kernel.sharedOrder as {scalarIR.Shared}) do
            if shared.count ~= size then
                context.reject(
                    shared.source,
                    "workgroup scratch count must equal the workgroup size in the initial portable subset"
                )
            end
            scratchBytes = scratchBytes + shared.count * 4
        end
        if scratchBytes > 16384 then
            context.reject(lower.site(args[3]), "workgroup scratch exceeds the portable 16384-byte limit")
        end
        if kernel.usesLua or kernel.usesSimd then
            context.reject(lower.site(args[3]), "workgroup phases admit fixed-width scalar operations only")
        end

        return new scalarIR.Program(
            version = scalarIR.VERSION,
            name = name,
            symbol = symbol,
            entryMode = "kernel",
            executionTarget = "gpu",
            fpContract = contract.fpContract,
            fpTranscendentals = contract.fpTranscendentals,
            wantsLanes = false,
            lanesRequired = false,
            params = signature.params,
            layouts = layouts.ordered,
            regions = regions,
            aliasFacts = aliasFacts,
            guards = {},
            helpers = kernel.helperOrder,
            constants = kernel.constantOrder,
            resultTypes = {},
            resultSourceTypes = {},
            usesSimd = false,
            usesNumberToken = false,
            workgroup = new scalarIR.Workgroup(
                prelude = prelude,
                groups = groups,
                dispatchSpan = dispatchSpan,
                size = size as integer,
                groupIndex = groupName,
                localIndex = "localIndex",
                shared = kernel.sharedOrder as {scalarIR.Shared},
                statements = lowered,
                source = lower.site(workgroupCall)
            ),
            source = lower.site(fn)
        )
    end

    local mapShape = #resultTypes == 0 and #signature.writes > 0 and #signature.reads > 0 and (
        #statements == 2 or #statements == 3
    ) and lower.isGuardStatement(statements[1]) and statements[#statements].kind == "fornumStmt"
    -- A map may relate spans of different lengths -- a matrix product reads
    -- dimensions no equality guard can spell -- so its length guard is
    -- optional. What replaces the proof is per-access: a span the body touches
    -- at the loop index must still be the primary or guarded equal to it, while
    -- a cursor access carries its dominating bound check into either backend.
    local guardlessLoop = #statements == 1 and statements[
        1
    ].kind == "fornumStmt" and statements[1] as cst.FornumStmt or nil
    if #resultTypes == 0 and #signature.writes > 0 and #signature.reads > 0 and guardlessLoop ~= nil and lower.dotCount(
        (guardlessLoop as cst.FornumStmt).stop
    ) == signature.writes[1].name then
        mapShape = true
    end

    if not mapShape then
        if contract.lanesRequired then
            context.reject(lower.site(body), "required scalar-source lanes need the admitted map-loop shape")
        end

        local kernel = new lower.Kernel(
            params = signature.byName,
            layouts = layouts,
            helperDecls = declarations.helpers,
            entryDecls = declarations.entries,
            helpers = {},
            helperOrder = {},
            constantNames = {},
            scratchBounds = {},
            constantOrder = {},
            constantNumbers = declarations.constantNumbers,
            helperState = {},
            modules = declarations.modules,
            intrinsicAliases = declarations.intrinsicAliases,
            stringAccumulators = lower.stringAccumulators(statements),
            symbol = symbol,
            loopSource = lower.site(body.body or body),
            index = "",
            mapEntry = false,
            indexCName = "",
            resultTypes = resultTypes,
            cursorBounds = {},
            lengthBounds = {},
            scratchLengthBounds = {},
            usesSimd = false,
            usesNumberToken = false,
            usesLua = (function(): boolean
                for _, resultType in ipairs(resultTypes) do
                    if resultType == "lua_table"
                    or resultType == "lua_string"
                    or resultType == "lua_nil"
                    or resultType == "lua_value"
                    then
                        return true
                    end
                end

                return false
            end)(),
            serial = 0,
            context = context
        )
        local environment = loweringEnvironment(signature, specialization)
        local lowered = lower.block(statements, environment, kernel)
        if #lowered == 0 then
            context.reject(lower.site(body.body or body), "an AOT block body may not be empty")
        end

        local entryMode = kernel.usesLua and "lua-builder" or "kernel"
        local blockProgram = new scalarIR.Program(
            version = scalarIR.VERSION,
            name = name,
            symbol = symbol,
            entryMode = entryMode as any,
            executionTarget = contract.target,
            builderMode = kernel.builderMode,
            runtimeAbi = kernel.usesLua and "lua-5.1" or nil,
            registrar = kernel.usesLua and symbol .. "_register" or nil,
            fpContract = contract.fpContract,
            fpTranscendentals = contract.fpTranscendentals,
            wantsLanes = false,
            lanesRequired = false,
            params = signature.params,
            layouts = layouts.ordered,
            regions = regions,
            aliasFacts = aliasFacts,
            guards = {},
            helpers = kernel.helperOrder,
            constants = kernel.constantOrder,
            body = lowered,
            resultTypes = resultTypes,
            resultSourceTypes = resultSourceTypes,
            usesSimd = kernel.usesSimd,
            usesNumberToken = kernel.usesNumberToken,
            source = lower.site(fn)
        )

        -- Proved here rather than decided by the backend that consumes it: a
        -- reused buffer is shared, and what makes sharing sound is a fact about
        -- this program. `verify` re-runs the same derivation.
        blockProgram.reusableScratch = visit.reusableScratch(blockProgram)

        return blockProgram
    end

    local primary = signature.writes[1]

    local guards: {scalarIR.Guard} = {}
    if #statements > 1 then
        guards = lower.lengthGuards(
            statements[1],
            lower.guardClause(
                statements[1],
                "the first statement must be a single length-mismatch guard",
                "a length guard must call error or assert directly",
                context
            ),
            signature,
            context,
            true
        )
    end

    local rangeGuard: scalarIR.RangeGuard? = nil
    if #statements == 3 then
        rangeGuard = lower.rangeGuard(
            statements[2],
            lower.guardClause(
                statements[2],
                "the optional second statement must be a range guard",
                "a range guard must call error or assert directly",
                context
            ),
            signature,
            context
        )
    end

    local loop = statements[#statements]
    local index = lower.loopIndex(loop, rangeGuard, signature, context)
    local kernel = new lower.Kernel(
        params = signature.byName,
        layouts = layouts,
        helperDecls = declarations.helpers,
        entryDecls = declarations.entries,
        helpers = {},
        helperOrder = {},
        constantNames = {},
        scratchBounds = {},
        constantOrder = {},
        constantNumbers = declarations.constantNumbers,
        helperState = {},
        modules = declarations.modules,
        intrinsicAliases = declarations.intrinsicAliases,
        stringAccumulators = {},
        symbol = symbol,
        loopSource = lower.site(loop),
        index = index,
        indexCName = "i",
        mapEntry = true,
        boundSpan = primary.name,
        indexSpans = (function(): {[string]: boolean}
            local provable: {[string]: boolean} = {[primary.name] = true}
            for _, guard in ipairs(guards) do
                provable[guard.right] = true
            end

            return provable
        end)(),
        resultTypes = {},
        cursorBounds = {},
        lengthBounds = {},
        scratchLengthBounds = {},
        usesSimd = false,
        usesNumberToken = false,
        usesLua = false,
        serial = 0,
        context = context
    )

    local environment = loweringEnvironment(signature, specialization)

    local counted = loop as cst.FornumStmt
    local body_ = lower.block(counted.body ~= nil and (counted.body as cst.Block).stats or {}, environment, kernel)
    if #body_ == 0 then
        context.reject(lower.site(counted.body or loop), "the native loop body may not be empty")
    end
    -- A counted native loop runs per element, and entering it is what the loop is
    -- for -- so it is compiled with no VM to allocate against and enters as
    -- `kernel` rather than as a builder, whatever it reached. A block body that
    -- reaches a Lua value becomes a builder instead; this shape has no such door,
    -- and saying so here is the difference between a refusal naming the line and
    -- an IR verifier assertion escaping as a traceback with no source at all.
    if kernel.usesLua then
        context.reject(
            kernel.luaSource or lower.site(counted.body or loop),
            "a value only the VM can hold is not admitted in a counted native loop"
        )
    end

    return new scalarIR.Program(
        version = scalarIR.VERSION,
        name = name,
        symbol = symbol,
        entryMode = "kernel",
        executionTarget = contract.target,
        fpContract = contract.fpContract,
        fpTranscendentals = contract.fpTranscendentals,
        wantsLanes = contract.wantsLanes,
        lanesRequired = contract.lanesRequired,
        params = signature.params,
        layouts = layouts.ordered,
        regions = regions,
        aliasFacts = aliasFacts,
        guards = guards,
        rangeGuard = rangeGuard,
        helpers = kernel.helperOrder,
        constants = kernel.constantOrder,
        resultTypes = {},
        resultSourceTypes = {},
        usesSimd = kernel.usesSimd,
        usesNumberToken = kernel.usesNumberToken,
        loop = new scalarIR.Loop(
            index = index,
            first = rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).first or 1,
            last = rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).last or primary.name,
            count = primary.name,
            statements = body_,
            source = lower.site(loop)
        ),
        source = lower.site(fn)
    )
end

export = lower
