module nupp.compiler.aot.lower

--[[
Turning admitted source into AOT IR.

The front end of the AOT backend: it reads the checked syntax tree and produces
the IR the verifier proves and the emitter prints. Everything here is about what
the source said; nothing here decides what the IR means.

The one rule worth stating separately is where a width may change. Ordinary Nupp
arithmetic is binary64, and `float`, `int32` and `uint32` are establishment facts
rather than arithmetic types -- so a value crosses between them only at a
conversion this module writes down, never as a side effect of an operator. A
narrowing that is not in the IR is a narrowing that did not happen.
]]

local admit = require("nupp.compiler.aot.admit")
local carriedFacts = require("nupp.compiler.aot.carried")
local reducers = require("nupp.compiler.aot.reducers")
local fold = require("nupp.compiler.aot.fold")
local simdindices = require("nupp.compiler.aot.simdindices")
local simdcast = require("nupp.compiler.aot.simdcast")
local lexer = require("nupp.compiler.lexer")
local cst = require("nupp.compiler.cst")
local relations = require("nupp.compiler.aot.relations")
local scalarIR = require("nupp.compiler.aot.scalar")
local visit = require("nupp.compiler.aot.visit")
local switchplan = require("nupp.compiler.switchplan")
local T = require("nupp.compiler.types")

local lower = {}

--- What lowering needs from the caller.
record lower.Context
    --- Temporary values of expressions whose only exits leave their context.
    --- This lowering-only fact lets unreachable consumers use any scalar type.
    unreachableValues: {[any]: boolean} = {}

    --- Reports a construct the subset does not admit, naming where it was
    --- written. Does not return.
    reject: function(scalarIR.Source?, string): nil

    --- Whether the source came from the checker. A checked tree must carry the
    --- semantic facts below; source spellings remain only for the standalone
    --- parser harness which deliberately exercises lowering in isolation.
    checked: boolean

    --- Whether the selected tier has vector registers. This is the one fact
    --- `simd.species` answers from: a species where there are vectors, nil
    --- where there are none, decided here so the branch that tested it is
    --- pruned rather than compiled.
    vectors: boolean = true

    --- Compile-time byte tables named so far, by their contents.
    ---
    --- Shared by every entry in the file rather than held per entry, because
    --- the emitter writes these at file scope: two entries numbering their own
    --- tables from zero give one translation unit two different `konst_0`. One
    --- table used by two entries is named once here and emitted once there.
    constantNames: {[string]: string} = {}

    --- Those tables in the order they were first reached, for numbering.
    constantValues: {string} = {}
end

----------------------------------------------------------------------------
-- Types and conversions
----------------------------------------------------------------------------

--- The IR type one source spelling denotes, or nothing when it denotes none.
---
--- `integer` lowers to binary64 rather than to a 32-bit type: it is Nupp's
--- ordinary number with a range refinement, and giving it an integer
--- representation here would change what arithmetic on it answers.
function lower.sourceValueType(spelling: string): scalarIR.Type?
    if spelling == "boolean" then
        return "bool"
    elseif spelling == "number" or spelling == "integer" then
        return "f64"
    elseif spelling == "float" then
        return "f32"
    elseif spelling == "uint32" then
        return "u32"
    elseif spelling == "int32" then
        return "i32"
    elseif spelling == "uint64" then
        return "u64"
    elseif spelling == "int64" then
        return "i64"
    elseif spelling == "string" then
        return "lua_string"
    elseif spelling:sub(1, 1) == "{" or spelling == "table" then
        return "lua_table"
    end

    return nil
end

--- The conversion that takes `value` to `targetType`, if one exists.
---
--- Written into the IR rather than left implicit, because these are the only
--- places a width changes and an emitter that inferred them could infer a
--- different set.
function lower.conversion(value: scalarIR.Expr, targetType: scalarIR.Type, source: scalarIR.Source?): scalarIR.Expr?
    if value.type == targetType then
        return value
    end

    local op: string? = nil
    if targetType == "f64" and (
        value.type == "i32" or value.type == "u32" or value.type == "i64" or value.type == "u64"
    ) then
        op = "int_to_f64"
    elseif targetType == "f64" and value.type == "f32" then
        op = "widen_f32_f64"
    elseif targetType == "f32" and value.type == "f64" then
        op = "narrow_f64_f32"
    elseif (
        targetType == "i32" or targetType == "u32" or targetType == "i64" or targetType == "u64"
    ) and (
        value.type == "f64" or value.type == "i32" or value.type == "u32" or value.type == "i64" or value.type == "u64"
    ) then
        op = "numeric_cast"
    end
    if op == nil then
        return nil
    end

    return new scalarIR.Convert(op = op as any, value = value, type = targetType, source = source)
end

--- The same, refusing what has no conversion.
function lower.convert(
    value: scalarIR.Expr,
    targetType: scalarIR.Type,
    source: scalarIR.Source?,
    context: lower.Context
): scalarIR.Expr
    if context.unreachableValues[value] then
        return lower.zeroValue(targetType, source, context)
    end
    local converted = lower.conversion(value, targetType, source)
    if converted == nil then
        context.reject(
            source,
            "native value cannot convert from " .. tostring(value.type) .. " to " .. tostring(targetType)
        )
    end

    return converted as scalarIR.Expr
end

--- An exact integer literal that a fixed-width parameter can take as written.
---
--- The checker already counts one as established at every width it fits, so a
--- helper declared over `int32` accepts `7` from the source. Lowering an
--- ordinary literal produces a binary64 constant, and rejecting that here would
--- refuse what the checker admitted, over a value whose whole content is that
--- it is exactly this integer. Same rule the bitwise operands carry.
local function exactWidthConstant(value: scalarIR.Expr, wanted: scalarIR.Type): scalarIR.Expr?
    if wanted ~= "i32" and wanted ~= "u32" then
        return nil
    end
    local raw = value as any
    if raw.op ~= "constant" or value.type ~= "f64" then
        return nil
    end
    local number = tonumber(raw.value)
    local low = wanted == "u32" and 0 or lower.INT32_MIN
    local high = wanted == "u32" and lower.UINT32_MAX or lower.INT32_MAX
    if number == nil or number % 1 ~= 0 or number < low or number > high then
        return nil
    end

    return new scalarIR.IntConstant(
        op = "constant_i32",
        value = raw.value as string,
        type = wanted,
        source = value.source
    )
end

--- One argument brought to the type a helper parameter takes.
---
--- A helper takes ordinary Nupp values, so a fixed-width argument widens into it
--- exactly as it would at any other binary64 operator. Nothing narrows: a helper
--- that wanted binary32 would have to say so, and passing one silently would
--- change the answer.
function lower.helperArgument(
    value: scalarIR.Expr,
    wanted: scalarIR.Type,
    source: scalarIR.Source?,
    context: lower.Context
): scalarIR.Expr
    if value.type == wanted then
        return value
    end
    local exact = exactWidthConstant(value, wanted)
    if exact ~= nil then
        return exact
    end
    if wanted ~= "f64" then
        context.reject(source, "native helper argument type does not match")
    end

    local widened = lower.conversion(value, "f64", value.source)
    if widened == nil then
        context.reject(source, "native helper argument type does not match")
    end

    return widened as scalarIR.Expr
end

--- Where a node was written, for a diagnostic or an IR node that has to name it.
---
--- A construct with no token of its own reads as the start of the file rather
--- than as no position, because every IR node carries one and an absent
--- position would have to be handled everywhere downstream.
function lower.site(node: cst.Child?): scalarIR.Source
    local token = node ~= nil and cst.firstToken(node) or nil
    if token == nil then
        return new scalarIR.Source(line = 1, column = 1)
    end

    return new scalarIR.Source(line = (token as lexer.Token).line, column = (token as lexer.Token).col)
end

--- One written type, with its whitespace removed, so two spellings of the same
--- type compare equal.
function lower.compactType(node: cst.Child?): string
    if node == nil then
        return ""
    end

    return (cst.textOf(node as cst.Child):gsub("%s+", ""))
end

--- The semantic type the checker published on one type node.
---
--- A checked lowering never falls back to source text. Absence here is a broken
--- producer/consumer contract, and treating the spelling as an answer would
--- hide it until an alias or qualified type made the two disagree.
local function checkedType(node: cst.Child?, context: lower.Context): any?
    if not context.checked then
        return nil
    end
    local resolved = node ~= nil and (node as any).resolvedType or nil
    if resolved == nil then
        context.reject(lower.site(node), "the checker did not publish this AOT type")
    end

    return resolved
end

--- The alias-expanded semantic value beneath ownership wrappers.
---
--- A local alias with no parameters may still be represented by the checker's
--- generic-alias node. Its body is the resolved type; consuming that body is
--- semantic expansion, not another parse of the alias's written declaration.
local function semanticRaw(t: any?): any?
    local raw = t ~= nil and T.unwrapOwnership(t) or nil
    while raw ~= nil and raw.tag == "genericAlias" and #(raw.paramKinds or {}) == 0 do
        raw = T.unwrapOwnership(raw.body)
    end

    return raw
end

--- The nominal declaration behind an instantiated semantic type.
local function nominal(t: any?): (any?, any?)
    local raw = semanticRaw(t)
    if raw == nil or raw.tag ~= "nominal" then
        return nil, nil
    end

    return raw, raw.origin or raw
end

--- The target-neutral identity carried by one generic SIMD application.
---
--- Element and species are encoded in the IR type because legalization happens
--- after semantic lowering. This is derived from nominal identities and const
--- terms, never from source text.
local function genericSimdType(t: any?): scalarIR.Type?
    local raw, origin = nominal(t)
    if raw == nil or origin == nil or origin.moduleName ~= "nupp.simd" then
        return nil
    end
    local family = origin.name
    if family ~= "Vector" and family ~= "Mask" and family ~= "Species" then
        return nil
    end
    local arguments = raw.typeArgs or {}
    local element = semanticRaw(arguments[1])
    local elementNames: {
        [string]: string
    } = {
        number = "f64",
        integer = "f64",
        float = "f32",
        int8 = "i8",
        uint8 = "u8",
        int16 = "i16",
        uint16 = "u16",
        int32 = "i32",
        uint32 = "u32",
        int64 = "i64",
        uint64 = "u64",
    }
    local elementName = element ~= nil and elementNames[element.tag] or nil
    local species, speciesOrigin = nominal(arguments[2])
    local shape: string? = nil
    if speciesOrigin ~= nil and speciesOrigin.moduleName == "nupp.simd" and speciesOrigin.name == "Preferred" then
        shape = "preferred"
    elseif species ~= nil
        and speciesOrigin ~= nil
        and speciesOrigin.moduleName == "nupp.simd"
        and speciesOrigin.name == "Fixed"
    then
        local count = (species.constArgs or {})[1]
        if count ~= nil and count.tag == "constLiteral" and count.domain == "integer" then
            shape = "fixed" .. tostring(count.value)
        end
    end
    if elementName == nil or shape == nil then
        return nil
    end

    return "simd_" .. family:lower() .. "_" .. elementName .. "_" .. shape
end

--- The canonical source spelling of a checked type.
---
--- Used only in the generated wrapper, never to decide admission. The wrapper
--- lives at the declaration site, so a local nominal's simple name is the most
--- direct spelling; all other types use the checker's own renderer.
local function sourceSpelling(t: any): string
    local raw = semanticRaw(t)
    if raw.tag == "nominal" then
        local _, origin = nominal(raw)
        if origin ~= nil and origin.moduleName == nil then
            return origin.name
        end
    end

    return T.tostring(raw)
end

--- The IR scalar one checked value type denotes.
---
--- `helper` preserves the established backend contract that helper `float`
--- signatures carry ordinary binary64 values. Top-level parameters and locals
--- retain their explicit binary32 establishment.
local function semanticValueType(t: any?, helper: boolean?): scalarIR.Type?
    if t == nil then
        return nil
    end
    local raw = semanticRaw(t)
    local tag = raw.tag
    if tag == "literal" then
        return semanticValueType(raw.base, helper)
    elseif tag == "boolean" then
        return "bool"
    elseif tag == "number" or tag == "integer" then
        return "f64"
    elseif tag == "float" then
        return helper and "f64" or "f32"
    elseif tag == "uint32" then
        return "u32"
    elseif tag == "int32" then
        return "i32"
    elseif tag == "uint64" then
        return "u64"
    elseif tag == "int64" then
        return "i64"
    elseif tag == "string" then
        return "lua_string"
    elseif tag == "union" then
        local hasString, hasBuffer = false, false
        for _, member in ipairs(raw.members or {}) do
            local item = semanticRaw(member)
            local _, origin = nominal(item)
            hasString = hasString or item.tag == "string"
            hasBuffer = hasBuffer or origin ~= nil and origin.name == "Buffer"
        end
        if hasString and hasBuffer and #(raw.members or {}) == 2 then
            return "lua_bytes"
        end
    elseif tag == "nil" then
        return "lua_nil"
    elseif tag == "any" then
        return "lua_value"
    elseif tag == "table" or tag == "array" or tag == "map" or tag == "tuple" or tag == "shape" then
        return "lua_table"
    end

    local _, origin = nominal(raw)
    if origin == nil or origin.moduleName ~= "nupp.simd" then
        return nil
    end
    local generic = genericSimdType(raw)
    if generic ~= nil then
        return generic
    end
    for _, contract in pairs(reducers.CONSTRUCTORS) do
        if origin.name == contract.recordName then
            local argument = semanticRaw((raw.typeArgs or {})[1])
            local element: string? = contract.element
            if contract.order == "integer" or contract.order == "exact" and contract.element ~= "bool" then
                element = argument ~= nil and admit.STORAGE[argument.tag] or nil
            end
            if element ~= nil and reducers.valid(contract.order, contract.operation, element) then
                return reducers.typeName(contract.order, contract.operation, element)
            end
        end
    end
    local simdTypes: {
        [string]: scalarIR.Type
    } = {
        VectorU8 = "simd_vector_u8",
        MaskU8 = "simd_mask_u8",
        MaskBits64 = "simd_mask_bits64",
        SpeciesU8 = "simd_species_u8",
        TableU8x16 = "simd_table_u8x16",
        OrderedSum = "simd_reducer_ordered_sum",
        PairwiseSum = "simd_reducer_pairwise_sum",
        CompensatedSum = "simd_reducer_compensated_sum",
        AlgebraicSum = "simd_reducer_algebraic_sum",
        OrderedProduct = "simd_reducer_ordered_product",
        PairwiseProduct = "simd_reducer_pairwise_product",
        AlgebraicProduct = "simd_reducer_algebraic_product",
        OrderedDot = "simd_reducer_ordered_dot",
        PairwiseDot = "simd_reducer_pairwise_dot",
        AlgebraicDot = "simd_reducer_algebraic_dot",
    }

    return simdTypes[origin.name]
end

--- The storage scalar one checked physical type denotes.
local function semanticStorageType(t: any?): scalarIR.Type?
    local raw = semanticRaw(t)

    return raw ~= nil and admit.STORAGE[raw.tag] or nil
end

--- The admitted value type attached to an optional type annotation.
local function annotatedValueType(node: cst.Child?, context: lower.Context, helper: boolean?): scalarIR.Type?
    if node == nil then
        return nil
    end
    if context.checked then
        return semanticValueType(checkedType(node, context), helper)
    end
    local spelling = lower.compactType(node)

    return helper and lower.helperValueType(spelling) or lower.sourceValueType(spelling)
end

--- The bytes one source string token denotes.
---
--- The bytes, not the spelling: a quoted literal's escapes are the program's, so
--- `"\1"` is the one byte the running program would have pushed. A long bracket
--- assigns no escapes and carries its equality level in both delimiters, so it is
--- its own contents.
local function stringBytes(written: string): string
    local decoded = lexer.stringValue(written)
    if decoded ~= nil then
        return decoded as string
    end
    local equals = written:match("^%[(=*)%[")
    if equals ~= nil then
        local width = #(equals as string) + 2
        return written:sub(width + 1, -width - 1)
    end

    return written
end

--- Removes source-only grouping and checked casts from an expression shape.
function lower.unwrapped(node: cst.Node?): cst.Node?
    local current = node
    while current ~= nil and (current.kind == "paren" or current.kind == "castExpr") do
        current = current.kind == "paren" and (current as cst.Paren).expr or (current as cst.CastExpr).expr
    end

    return current
end

----------------------------------------------------------------------------
-- Layouts and span elements
----------------------------------------------------------------------------

--- The layouts one kernel reifies, in the order they were first reached.
---
--- Order matters: it is the order the generated C declares the structs in, and
--- a set would not have one.
record lower.Layouts
    ordered: {scalarIR.Layout}
    byName: {[string]: scalarIR.Layout}
end

--- Admits one local struct as a span element layout.
---
--- Reifying a struct is a claim about memory, so the shape is deliberately
--- small: no generics, no supertypes, stored fields only, and every field type
--- one this backend has a storage width for. Anything else would be a layout
--- Nupp and C could disagree about.
function lower.layout(
    name: string,
    resolved: any?,
    at: cst.Child?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context
): scalarIR.Layout
    local semantic, origin = nominal(resolved)
    if context.checked then
        if semantic == nil or origin == nil or origin.declKind ~= "struct" then
            context.reject(lower.site(at), "span elements with fields must resolve to a struct")
        end
        name = origin.name
    end
    local known = layouts.byName[name]
    if known ~= nil then
        return known as scalarIR.Layout
    end

    local found = declarations[name]
    if found == nil then
        context.reject(lower.site(at), "span element " .. name .. " is not a visible local struct")
    end

    local declaration = found as cst.RecordDecl
    if context.checked then
        local declared = declaration.resolvedType
        local _, declaredOrigin = nominal(declared)
        if declaredOrigin == nil or declaredOrigin.id ~= origin.id then
            context.reject(lower.site(at), "span element " .. name .. " is not the visible local struct of that name")
        end
    elseif declaration.generics ~= nil or #(declaration.supertypes or {}) > 0 then
        context.reject(lower.site(declaration), "native structs must be non-generic and have no supertypes")
    end

    local layout = new scalarIR.Layout(name = name, cName = "Ks" .. name, fields = {}, source = lower.site(declaration))
    if context.checked then
        if #(origin.typeParams or {}) > 0 or #(origin.supertypes or {}) > 0 then
            context.reject(lower.site(declaration), "native structs must be non-generic and have no supertypes")
        end
        local fields = origin.fieldOrder or {}
        for _, fieldName in ipairs(fields) do
            local fieldType = origin.byname and origin.byname[fieldName] or nil
            local storage = semanticStorageType(fieldType)
            if storage == nil then
                context.reject(
                    lower.site(origin.fieldDefs and origin.fieldDefs[fieldName] or declaration),
                    "native struct field type " .. tostring(
                        fieldType ~= nil and T.tostring(fieldType) or "unknown"
                    ) .. " is not admitted"
                )
            end
            layout.fields[
                #layout.fields + 1
            ] = new scalarIR.Field(
                name = fieldName,
                type = storage as string,
                sourceType = sourceSpelling(fieldType),
                source = lower.site(origin.fieldDefs and origin.fieldDefs[fieldName] or declaration)
            )
        end
        if #layout.fields == 0 then
            context.reject(lower.site(declaration), "native structs need at least one field")
        end
        layouts.byName[name] = layout
        layouts.ordered[#layouts.ordered + 1] = layout

        return layout
    end

    local seen: {[string]: boolean} = {}
    for _, entry in ipairs(declaration.entries) do
        local field = entry as cst.FieldDecl
        if entry.kind ~= "fieldDecl" or field.name == nil then
            context.reject(lower.site(entry), "native structs initially contain only stored fields")
        end

        local fieldName = (field.name as lexer.Token).text
        local spelling = lower.compactType(field.type)
        local fieldType = admit.STORAGE[spelling]
        if fieldType == nil then
            context.reject(
                lower.site(field.type or entry),
                "native struct field type " .. spelling .. " is not admitted"
            )
        end
        if seen[fieldName] then
            context.reject(lower.site(entry), "duplicate native struct field " .. fieldName)
        end
        seen[fieldName] = true
        layout.fields[
            #layout.fields + 1
        ] = new scalarIR.Field(
            name = fieldName,
            type = fieldType as string,
            sourceType = spelling,
            source = lower.site(entry)
        )
    end
    if #layout.fields == 0 then
        context.reject(lower.site(declaration), "native structs need at least one field")
    end

    layouts.byName[name] = layout
    layouts.ordered[#layouts.ordered + 1] = layout

    return layout
end

--- What one span parameter holds.
record lower.Element
    kind: 'scalar' | 'struct'

    --- The IR type of one element.
    type: string

    --- How the source spelled it, for a scalar element.
    sourceType: string?

    --- The reified layout, for a struct element.
    layout: scalarIR.Layout?

    --- The sealed span contract that proved the pointer/count pair.
    spanModule: string
end

--- The element type a span spelling names, or nothing when it is not that span.
---
--- @param expected the resolved span declaration name
function lower.spanElement(
    spelling: string,
    resolved: any?,
    expected: string,
    at: cst.Child?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context
): lower.Element?
    if context.checked then
        local span, origin = nominal(resolved)
        if span == nil or origin == nil or (
            origin.moduleName ~= "nupp.mem.span"
        ) or origin.name ~= expected or span.typeArgs == nil or span.typeArgs[1] == nil then
            return nil
        end
        local elementType = span.typeArgs[1]
        local storage = semanticStorageType(elementType)
        if storage ~= nil then
            return new lower.Element(
                kind = "scalar",
                type = storage as string,
                sourceType = sourceSpelling(elementType),
                spanModule = origin.moduleName
            )
        end
        local _, elementOrigin = nominal(elementType)
        if elementOrigin == nil or elementOrigin.declKind ~= "struct" then
            context.reject(
                lower.site(at),
                "span element " .. T.tostring(elementType) .. " has no admitted physical layout"
            )
        end

        return new lower.Element(
            kind = "struct",
            type = "struct:" .. elementOrigin.name,
            layout = lower.layout(elementOrigin.name, elementType, at, declarations, layouts, context),
            spanModule = origin.moduleName
        )
    end

    local suffix = expected == "WriteSpan" and "WriteSpan" or "Span"
    local _module, element = spelling:match("^(span)%." .. suffix .. "<(.+)>$")
    if element == nil then
        return nil
    end

    local storage = admit.STORAGE[element as string]
    if storage ~= nil then
        return new lower.Element(
            kind = "scalar",
            type = storage as string,
            sourceType = element as string,
            spanModule = "nupp.mem.span"
        )
    end

    return new lower.Element(
        kind = "struct",
        type = "struct:" .. (element as string),
        layout = lower.layout(element as string, nil, at, declarations, layouts, context),
        spanModule = "nupp.mem.span"
    )
end

----------------------------------------------------------------------------
-- Reading names out of the tree
----------------------------------------------------------------------------

--- The name one node writes, if it is a bare name.
function lower.nameOf(node: cst.Node?): string?
    if node == nil or node.kind ~= "name" then
        return nil
    end

    local token = (node as cst.NameExpr).token

    return token ~= nil and (token as lexer.Token).text or nil
end

--- The dotted path one node writes, if it is a chain of names.
---
--- `math.sqrt` and `nupp.math.f32.add` are how the admitted intrinsics are
--- written, and anything with a call or an index in it is not one of them.
function lower.dottedName(node: cst.Node?): string?
    if node == nil then
        return nil
    end
    if node.kind == "name" then
        return lower.nameOf(node)
    end
    if node.kind == "dotIndex" then
        local indexed = node as cst.DotIndex
        if indexed.name == nil then
            return nil
        end

        local base = lower.dottedName(indexed.obj)

        return base ~= nil and (base as string) .. "." .. (indexed.name as lexer.Token).text or nil
    end

    return nil
end

--- The checked export identity of one call target, including a local alias.
---
--- The checker propagates this sidecar by definition, so lowering never treats
--- a shadowing local named `simd` as the compiler-owned module and does not lose
--- the intrinsic when its exported function is first bound to another name.
function lower.callIdentity(node: cst.Node?): string?
    if node == nil then
        return nil
    end
    local direct = (node as any).exactCallExport
    if direct ~= nil then
        return direct.identity
    end
    if node.kind == "dotIndex" then
        local indexed = node as cst.DotIndex
        local base = indexed.obj
        local token = base ~= nil and base.kind == "name" and (base as cst.NameExpr).token or nil
        local definition = token ~= nil and (token as any).definition or nil
        local moduleName = definition ~= nil and definition.requiredModule or nil
        if moduleName ~= nil and indexed.name ~= nil then
            return moduleName .. "." .. (indexed.name as lexer.Token).text
        end
    end
    if node.kind == "name" then
        local token = (node as cst.NameExpr).token
        local definition = token ~= nil and (token as any).definition or nil
        local aliased = definition ~= nil and definition.exactCallExport or nil
        if aliased ~= nil then
            return aliased.identity
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- The lowering environment
----------------------------------------------------------------------------

--- One name in scope, as the environment records it.
record lower.Bound
    kind: 'local' | 'uniform' | 'helper_param'
    name: string
    type: scalarIR.Type
    cName: string?
    mutable: boolean?
    lengthOf: string?
    builderMode: ('eager' | 'pull' | 'serde')?
    source: scalarIR.Source?
end

--- One admitted precondition, and the polarity it was written in.
---
--- `if not ok then error(m) end` states what must not happen; `assert(ok, m)`
--- states what must hold. They carry the same fact, so lowering reads either
--- and remembers which form it saw to know how to match the condition.
record lower.GuardForm
    cond: cst.Node?
    asserted: boolean

    --- A non-literal argument consumption would discard, when one was written.
    discarded: cst.Node?
end

--- The compile-time lifecycle of one source-visible reducer binding.
---
--- Reducers are region capabilities, not ordinary copyable values: one binding
--- belongs to one authored SIMD loop and is consumed by one finalization after
--- that loop. The IR still carries the binding so the scalar and lane lowerings
--- can implement the selected arithmetic contract independently.
record lower.ReducerState
    name: string
    cName: string
    region: integer?
    finalized: boolean
    source: scalarIR.Source
end

--- One `do` block that masked reducer contributions may turn into an
--- explicit SIMD region: its identity, and the reducers contributed so far.
record lower.SimdDo
    region: integer
    reducers: {scalarIR.SimdRegionReducer}
    byName: {[string]: boolean}
end

--- What lowering one kernel's body needs to know.
record lower.ExpressionFrame
    output: {scalarIR.Statement}
    operands: {scalarIR.Expr} = {}
    replacements: {[any]: scalarIR.Expr} = {}
end

record lower.ValueFrame
    result: scalarIR.Name?
    assignments: {scalarIR.Assignment} = {}
    done: scalarIR.Name
    yields: integer = 0
end

record lower.Kernel
    pending: {scalarIR.Statement} = {}
    expressionFrame: lower.ExpressionFrame?
    valueFrame: lower.ValueFrame?
    expectedType: scalarIR.Type?

    --- Span and uniform parameters by name, as the signature admitted them.
    params: {[string]: any}

    --- The layouts reified so far.
    layouts: lower.Layouts

    --- Visible pure helper declarations by name.
    helperDecls: {[string]: any}

    --- The file's other `@aot` declarations, which a body may call natively.
    entryDecls: {[string]: any}

    --- Helpers lowered so far, by name and in the order they were reached.
    helpers: {[string]: scalarIR.Helper}

    helperOrder: {scalarIR.Helper}

    --- Which helpers are part way through lowering, so a cycle is caught rather
    --- than followed.
    helperState: {[string]: string}

    --- Fixed word buffers by the name they were bound to, and how many words
    --- each holds. An access reads its bound from here, so the comparison the
    --- emitter writes names a constant rather than a field.
    scratchBounds: {[string]: integer}

    --- Compile-time byte tables the body reads, by their bytes, and in the
    --- order they were reached. Keyed by content so a table named twice is
    --- emitted once.
    constantNames: {[string]: string}

    constantOrder: {scalarIR.ConstantBytes}

    --- Module-local immutable numeric literals visible to every AOT body.
    constantNumbers: {[string]: string}

    --- Checked top-level require bindings and aliases of compiler intrinsics.
    modules: {[string]: string}

    intrinsicAliases: {[string]: string}

    --- Whether source is currently inside an authored outer SIMD region.
    simdSource: boolean?

    --- Identity of that authored region. Unmarked nested loops deliberately
    --- clear it, which keeps reducer contributions directly in the region body.
    simdRegion: integer?

    nextSimdRegion: integer

    --- The innermost `do` block being lowered, which becomes an explicit
    --- SIMD region when a masked reducer contribution lands inside it.
    simdDo: lower.SimdDo?

    --- Reducer lifecycle state, keyed by the compiler-owned local identity.
    reducers: {[string]: lower.ReducerState}

    reducerOrder: {lower.ReducerState}

    --- Ordinary local strings proven to be append-only accumulators.
    stringAccumulators: {[string]: boolean}

    --- The kernel's exported symbol, which its helpers are named after.
    symbol: string

    --- Where the kernel loop was written, for a refusal that has no node of its
    --- own to name.
    loopSource: scalarIR.Source?

    --- The loop counter, which is the only index a span access may use.
    index: string

    indexCName: string

    --- In a block body, the span whose count bounds the enclosing counted loop.
    --- Set only where the loop was written as `for i = 1, #span`, and only in a
    --- block kernel: a map-loop entry proves every span's length in its guard
    --- prologue instead. A read of a different span under this index has nothing
    --- proving it in bounds, and refusing it here is the difference between a
    --- refusal naming the line and an IR verifier assertion escaping as a
    --- traceback.
    boundSpan: string?

    --- Whether this kernel is the admitted map-loop shape, whose guard prologue
    --- proves every span has the primary output's count. A map entry needs no
    --- `boundSpan`, because the guard already relates every span to the index;
    --- a block body has only what its enclosing counted loop says, which is why
    --- the two cannot be told apart by `boundSpan` being unset.
    mapEntry: boolean

    --- Spans a map entry's loop index provably addresses: the loop's own bound
    --- and every span the guard prologue holds to it. A GPU map's guard may be
    --- partial, so an index access outside this set is refused at its line.
    indexSpans: {[string]: boolean}?

    --- Results the top-level AOT entry promises. Helpers keep their own result
    --- list; this is only for `return` statements in a general block body.
    resultTypes: {scalarIR.Type}

    --- Zero-based uint32 cursors proved safe by enclosing branches, by cursor
    --- and then by the span whose checked count bounds it: the room recorded is
    --- `scalarIR.ONE_ELEMENT` for `cursor + 1`, or the species type whose whole
    --- vector fits at `cursor + 1`.
    cursorBounds: scalarIR.CursorBounds

    --- Immutable uint32 locals initialized from one rooted string's length.
    lengthBounds: {[string]: string}

    --- Uint32 locals known to equal one scratch buffer's initialized length.
    scratchLengthBounds: {[string]: string}

    --- Present while lowering the compiler-recognized `gpu.workgroups`
    --- controller. Scratch names are structural bindings rather than runtime
    --- values; phase callbacks lower their local index to a dedicated IR value.
    phasesName: string?

    localIndexName: string?
    shared: {[string]: scalarIR.Shared}?
    sharedOrder: {scalarIR.Shared}?
    inPhase: boolean?
    workgroupSize: integer?

    usesSimd: boolean

    usesNumberToken: boolean

    --- Whether lowering reached an operation that requires the VM-aware ABI.
    usesLua: boolean

    --- The one direct value-stream mode used by this entry.
    builderMode: ('eager' | 'pull' | 'serde')?

    --- Where it first did. A block body that reaches a Lua value is a builder and
    --- wants no site; a counted native loop cannot become one, so this is what its
    --- refusal points at. Kept because the shape is only known once the whole body
    --- is lowered, by which time the expression that caused it is out of reach.
    luaSource: scalarIR.Source?

    --- How many locals have been named, so two source scopes using one name get
    --- two C names.
    serial: integer

    context: lower.Context
end

----------------------------------------------------------------------------
-- Reads, operators and calls
----------------------------------------------------------------------------

--- Notes that lowering reached a value only the VM can hold, and where.
---
--- Every site that produces one calls this rather than setting the flag, so the
--- first one is remembered whatever kind it was. What is done about it depends on
--- the shape being lowered, which is decided later.
local function markLua(kernel: lower.Kernel, source: scalarIR.Source): nil
    kernel.usesLua = true
    if kernel.luaSource == nil then
        kernel.luaSource = source
    end
end

--- The fixed-width bounds, which `admit` owns so the verifier reads the same ones.
const lower.UINT32_MAX = admit.UINT32_MAX

const lower.INT32_MIN = admit.INT32_MIN

const lower.INT32_MAX = admit.INT32_MAX

local bitOperand = admit.bitOperand

--- One operand of ordinary arithmetic, which is binary64.
---
--- A fixed-width value widens here, which is the same thing ordinary Nupp does:
--- an operator is binary64 and a narrower value entering one is a conversion,
--- not a narrower operation.
local function promote(value: scalarIR.Expr, at: cst.Node?, context: lower.Context): scalarIR.Expr
    local widened = lower.conversion(value, "f64", value.source)
    if widened == nil then
        context.reject(lower.site(at), "arithmetic operands must both be numeric")
    end

    return widened as scalarIR.Expr
end

--- A load that a physical narrow width widens out of.
---
--- This is where storage becomes an ordinary Nupp number, and the only place a
--- widening happens without the source asking. Reading a `float` field gives a
--- number, exactly as it does through the Lua body.
local function widenLoad(loaded: scalarIR.Expr, source: scalarIR.Source?): scalarIR.Expr
    if loaded.type ~= "f32" then
        return loaded
    end

    return new scalarIR.Convert(op = "widen_f32_f64", value = loaded, type = "f64", source = source)
end

--- Refuses a span access whose index nothing proves is in range.
---
--- Shared by the load and the store, which had drifted: the load checked that
--- the counted loop bounded the span it read, the store checked nothing at all,
--- and neither noticed a loop whose bound was not a span count in the first
--- place. All three reached the IR verifier instead, which raises rather than
--- reports, so a program the backend was right to refuse came back as a
--- traceback with no line in it.
---
--- Says nothing about a cursor access, whose bound is the dominating
--- `cursor < #span` check rather than the loop, or about a map entry, whose
--- guard prologue relates every span to the index before the loop starts.
--- A GPU map may leave that prologue partial, so there the index only proves
--- the spans the guard actually names beside the loop's own bound.
local function provenIndex(spanName: string, cursor: string?, node: cst.Node, kernel: lower.Kernel): nil
    if cursor ~= nil then
        return
    end
    if kernel.mapEntry then
        local provable = kernel.indexSpans
        if provable ~= nil and (provable as {[string]: boolean})[spanName] ~= true then
            kernel.context.reject(
                lower.site(node),
                (
                    "nothing proves %s is that long; a map-indexed span must be the loop bound or guarded equal to it; "
                    .. "guard with assert(#%s == #%s) or reach it through a proved cursor"
                ):format(spanName, tostring(kernel.boundSpan), spanName)
            )
        end
        return
    end
    local context = kernel.context
    if kernel.boundSpan == nil then
        context.reject(
            lower.site(node),
            (
                "the loop's bound is not a span count, so nothing proves %s is that long; count the loop with for i = 1, #%s"
            ):format(spanName, spanName)
        )
    end
    if spanName ~= kernel.boundSpan then
        context.reject(
            lower.site(node),
            (
                "the loop counts %s, so nothing proves %s is that long; guard it with assert(#%s == #%s)"
            ):format(kernel.boundSpan as string, spanName, kernel.boundSpan as string, spanName)
        )
    end
end

--- Whether `value` names a rooted string or byte parameter of this kernel,
--- as the SIMD loads that read one directly require: the local itself, and
--- not a copy or a slice, so the C name the load addresses is the parameter's.
local function rootedBytesParam(value: scalarIR.Expr, kernel: lower.Kernel): boolean
    if value.op ~= "local" or value.type ~= "lua_string" and value.type ~= "lua_bytes" then
        return false
    end
    local rooted = value as scalarIR.Name
    local param = kernel.params[rooted.name]

    return param ~= nil and param.kind == "scalar" and param.type == value.type and rooted.cName == param.cName
end

--- The names a block assigns anywhere inside it, so a loop knows which cursor
--- proofs its body retires.
local function assignedNames(body: cst.Node?, out: {[string]: boolean}): {[string]: boolean}
    if body == nil then
        return out
    end
    local node = body as cst.Node
    if node.kind == "funcExpr" or node.kind == "shortfn" or node.kind == "localFuncStmt" then
        return out
    end
    if node.kind == "assignStmt" then
        for _, target in ipairs((node as cst.AssignStmt).targets or {}) do
            local name = lower.nameOf(target)
            if name ~= nil then
                out[name as string] = true
            end
        end
    end
    for _, child in ipairs(node as any) do
        if type(child) == "table" then
            assignedNames(child as cst.Node, out)
        end
    end

    return out
end

--- The room a cursor is proved to have below a root's count: nil when no
--- dominating check bounded it against that root.
local function boundRoom(bounds: scalarIR.CursorBounds, cursor: string?, root: string?): string?
    local spans = cursor ~= nil and bounds[cursor as string] or nil

    return spans ~= nil and root ~= nil and spans[root as string] or nil
end

--- Records one bound in a map of cursor bounds. The inner table is replaced
--- rather than written, because an enclosing scope's map shares it. A vector's
--- room implies an element's, so an element bound never narrows one.
local function withBound(bounds: scalarIR.CursorBounds, cursor: string, root: string, room: string): nil
    local spans: {[string]: string} = {}
    for name, held in pairs(bounds[cursor] or {}) do
        spans[name] = held
    end
    if spans[root] == nil or room ~= scalarIR.ONE_ELEMENT then
        spans[root] = room
    end
    bounds[cursor] = spans
end

--- Whether a recorded room covers the whole vector an access of `species`
--- reads: its own species, or another one of the same lane count, because the
--- guard compared the count and every `Fixed<N>` species counts the same
--- lanes. A region that loads `float` fields under a `number` guard is the
--- ordinary case, and the verifier reads the proof the same way.
local function sameRoom(held: string, species: string): boolean
    if held == species then
        return true
    end
    local lanes = held:match("_fixed(%d+)$")

    return lanes ~= nil and species:match("_fixed(%d+)$") == lanes
end

--- The cursor a `candidate + 1` index names, when a dominating check bounded
--- that cursor against this span: with any room, or with room for a whole
--- vector of `room`'s lane count when one is asked for, which is how a vector
--- access asks for its whole width.
---
--- Shared by the load and the store for the same reason `provenIndex` is: two
--- spellings of one proof drift apart.
local function provedCursor(indexArg: cst.Node?, spanName: string?, kernel: lower.Kernel, room: string?): string?
    if indexArg == nil or indexArg.kind ~= "binop" then
        return nil
    end
    local index = indexArg as cst.Binop
    local written = index.op ~= nil and (index.op as lexer.Token).text or ""
    local token = index.rhs ~= nil and index.rhs.kind == "number" and (index.rhs as cst.NumberLit).token or nil
    local offset = token ~= nil and tonumber((token as lexer.Token).text) or nil
    local candidate = lower.nameOf(index.lhs)
    local held = boundRoom(kernel.cursorBounds, candidate, spanName)
    if written == "+" and offset == 1 and held ~= nil and (room == nil or sameRoom(held as string, room as string)) then
        return candidate
    end

    return nil
end

--- The whole-vector bound one comparison establishes: `cursor + s.lanes <=
--- #span`, for a `uint32` cursor and a species `s`, proves the cursor has room
--- for one of `s`'s vectors below the span's count. Returns the cursor, the
--- span, and the species type, whose lane count is the room.
---
--- The sum is exact here, not the wrapping `uint32` addition the operator
--- otherwise means: past 2^32 - 1 the guard is false. Read as wrapping it
--- would restart the loop from the top of the span, which no program means,
--- and it is the exact reading the proof needs.
local function laneBound(
    comparison: cst.Binop,
    environment: {[string]: any},
    kernel: lower.Kernel
): (string?, string?, string?)
    local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
    local sum, counted = comparison.lhs, comparison.rhs
    if written == ">=" then
        sum, counted = comparison.rhs, comparison.lhs
    elseif written ~= "<=" then
        return nil, nil, nil
    end
    if sum == nil or sum.kind ~= "binop" then
        return nil, nil, nil
    end
    local added = sum as cst.Binop
    if added.op == nil or (added.op as lexer.Token).text ~= "+" or added.rhs == nil or added.rhs.kind ~= "dotIndex" then
        return nil, nil, nil
    end
    local cursor = lower.nameOf(added.lhs)
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    local lanes = added.rhs as cst.DotIndex
    local speciesName = lanes.name ~= nil and (
        lanes.name as lexer.Token
    ).text == "lanes" and lower.nameOf(lanes.obj) or nil
    local species = speciesName ~= nil and environment[speciesName as string] or nil
    local speciesType = species ~= nil and tostring(species.type) or ""
    local generic = cursorBinding ~= nil and cursorBinding.type == "u32" and speciesType:match(
        "^simd_species_"
    ) ~= nil and speciesType ~= "simd_species_u8"
    if not generic then
        return nil, nil, nil
    end
    local spanName = lower.dotCount(counted)
    local param = spanName ~= nil and kernel.params[spanName as string] or nil
    if param ~= nil and param.region ~= nil then
        return cursor, spanName, speciesType
    end
    -- A rooted string or buffer parameter counts the same way, through the
    -- local its length was taken into: the root of the proof is the parameter,
    -- which is what a load through a view over it carries.
    local lengthName = lower.nameOf(counted)
    local bytesName = lengthName ~= nil and kernel.lengthBounds[lengthName as string] or nil
    local bytes = bytesName ~= nil and kernel.params[bytesName as string] or nil
    if bytes ~= nil and bytes.kind == "scalar" and (bytes.type == "lua_string" or bytes.type == "lua_bytes") then
        return cursor, bytesName, speciesType
    end

    return nil, nil, nil
end

--- One indexed span read.
---
--- The index has to be the loop's own, exactly. Consecutive access is the whole
--- of the licence to run several iterations at once, and an index this backend
--- cannot prove consecutive is one it will not admit.
local function spanRead(
    node: cst.BracketIndex,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local spanName = lower.nameOf(node.obj)
    local param = spanName ~= nil and kernel.params[spanName as string] or nil
    local readable = param ~= nil and (param.kind == "read_span" or param.kind == "write_span")
    if not readable then
        context.reject(lower.site(node), "span reads use input[index] or output[index]")
    end
    local indexArg = lower.unwrapped(node.expr)
    local direct = lower.nameOf(indexArg)
    local cursor = provedCursor(indexArg, spanName, kernel)
    if not (activeIndex ~= nil and direct == activeIndex) and cursor == nil then
        context.reject(lower.site(node), "span loads need a counted-loop index or cursor + 1 under cursor < #span")
    end
    provenIndex(spanName as string, cursor, node, kernel)

    local element = param.element
    local index = cursor == nil and activeIndex as string or ""
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    if element.kind == "struct" then
        return new scalarIR.ElementRef(
            op = "element_ref",
            span = spanName as string,
            index = index,
            indexCName = cursor == nil and kernel.indexCName or nil,
            cursor = cursor,
            cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil,
            layout = element.layout.name,
            mutable = param.kind == "write_span",
            type = "ref:" .. element.layout.name,
            source = lower.site(node)
        )
    end

    return widenLoad(
        new scalarIR.Load(
            op = "load",
            span = spanName as string,
            index = index,
            indexCName = cursor == nil and kernel.indexCName or nil,
            cursor = cursor,
            cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil,
            type = element.type,
            sourceType = param.sourceType,
            source = lower.site(node)
        ),
        lower.site(node)
    )
end

--- One field of a struct element.
local function fieldRead(node: cst.DotIndex, object: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local context = kernel.context
    local layoutName = object.type:match("^ref:(.+)$")
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if layout == nil then
        context.reject(lower.site(node), "native field access needs a reified struct element")
    end

    local wanted = (node.name as lexer.Token).text
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == wanted then
            field = candidate
        end
    end
    if field == nil then
        context.reject(lower.site(node), "struct " .. tostring(layoutName) .. " has no field " .. wanted)
    end

    return widenLoad(
        new scalarIR.FieldLoad(
            op = "field_load",
            object = object,
            layout = layoutName as string,
            field = (field as scalarIR.Field).name,
            type = (field as scalarIR.Field).type,
            sourceType = (field as scalarIR.Field).sourceType,
            source = lower.site(node)
        ),
        lower.site(node)
    )
end

--- Family, element, and species encoded in one generic SIMD IR type.
local function genericSimdParts(typeName: string): (string?, scalarIR.Type?, string?)
    local family, element, shape = typeName:match("^simd_(%a+)_([fiu]%d+)_(.+)$")

    return family, element as scalarIR.Type?, shape
end

--- The scalar value carrier for one packed element. Narrow integers remain
--- physical widths inside vectors while ordinary Nupp values use their
--- established 32-bit carrier.
local function genericSimdScalar(element: scalarIR.Type?): scalarIR.Type?
    if element == "u8" or element == "u16" then
        return "u32"
    elseif element == "i8" or element == "i16" then
        return "i32"
    end

    return element
end

--- The packed element identity of one span parameter. Narrow storage retains
--- its physical width here even though an ordinary scalar load widens it.
local function genericSimdSpanElement(param: scalarIR.Param): string
    local physical: {
        [string]: string
    } = {
        int8 = "i8",
        uint8 = "u8",
        int16 = "i16",
        uint16 = "u16",
        float = "f32",
        int32 = "i32",
        uint32 = "u32",
        int64 = "i64",
        uint64 = "u64",
        number = "f64",
    }

    return physical[param.sourceType or ""] or param.type
end

--- Makes one scalar operand lane-shaped for an intrinsic operator.
local function simdOperand(
    value: scalarIR.Expr,
    vectorType: string,
    source: scalarIR.Source,
    kernel: lower.Kernel
): scalarIR.Expr
    if value.type == vectorType then
        return value
    end
    local _, element = genericSimdParts(vectorType)
    if element == nil then
        kernel.context.reject(source, "explicit SIMD operator has no element type")
    end
    local scalar = lower.convert(value, genericSimdScalar(element) as scalarIR.Type, source, kernel.context)

    return new scalarIR.Simd(
        op = "simd_splat",
        args = {scalar},
        intrinsic = "splat",
        type = vectorType,
        source = source
    )
end

--- The elementwise extrema, by the method that names their NaN contract.
---
--- There is no unqualified `min`: the two disagree on every pair containing a
--- NaN, and the call site is the only place that difference can be recorded.
const VECTOR_EXTREMA = {
    propagatingMin = "propagating_min",
    propagatingMax = "propagating_max",
    numberMin = "number_min",
    numberMax = "number_max",
}

--- The standard scalar witnesses `simd.species` accepts, by their field
--- name in `nupp.mem.array`.
const SPECIES_WITNESSES: {
    [string]: boolean
} = {
    uint8 = true,
    int8 = true,
    uint16 = true,
    int16 = true,
    uint32 = true,
    int32 = true,
    uint64 = true,
    int64 = true,
    float = true,
    number = true,
}

--- What a call names, once module aliases and intrinsic aliases are followed.
local function calledIdentity(node: cst.Call, kernel: lower.Kernel): string?
    local path = lower.dottedName(node.obj)
    local identity = lower.callIdentity(node.obj)
    if identity == nil and path ~= nil then
        local root, rest = (path as string):match("^([^.]+)%.(.+)$")
        local moduleName = root ~= nil and kernel.modules[root as string] or nil
        if moduleName ~= nil then
            identity = moduleName .. "." .. tostring(rest)
        else
            identity = kernel.intrinsicAliases[path as string]
        end
    end

    return identity
end

--- Checks a `simd.species(witness[, lanes])` call's shape and where it sits.
local function admitSpecies(node: cst.Call, kernel: lower.Kernel): nil
    local context = kernel.context
    local site = lower.site(node)
    local arguments = node.args ~= nil and (node.args as cst.Args).exprs or {}
    local witness = #arguments >= 1 and lower.dottedName(arguments[1]) or nil
    local root: string? = nil
    local field: string? = nil
    if witness ~= nil then
        root, field = (witness as string):match("^([^.]+)%.([^.]+)$")
    end
    if root == nil or kernel.modules[root as string] ~= "nupp.mem.array" or not SPECIES_WITNESSES[field as string] then
        context.reject(site, "simd.species takes one of the scalar witnesses in nupp.mem.array, such as array.uint32")
    end
    if #arguments > 2 or #arguments == 2 and arguments[2].kind ~= "number" then
        context.reject(site, "simd.species takes a witness and, for a fixed shape, one literal lane count")
    end
    if kernel.workgroupSize ~= nil or kernel.phasesName ~= nil then
        context.reject(site, "simd.species has no answer inside a GPU kernel; it is for @aot CPU functions")
    end
end

--- `simd.species(witness[, lanes])`: the species for the witness's element
--- where the tier has vectors, and nil where it does not.
---
--- The answer is decided here, per tier, rather than at run time: a tier with
--- vectors gets the species constructor, and one without gets nothing at all
--- -- the local it initializes is bound as absent by `localStmt`, and the
--- `~= nil` test that guards the vector path folds to false so the path is
--- pruned rather than compiled. An `assert` of it is the one place the
--- expression form is admitted on a tier without vectors, and there it is
--- refused: the assert would fail on every call. The Lua path is the
--- library's own answer and never reaches here.
local function species(node: cst.Call, kernel: lower.Kernel, asserted: boolean): scalarIR.Expr
    local context = kernel.context
    local site = lower.site(node)
    admitSpecies(node, kernel)
    if not context.vectors then
        context.reject(
            site,
            asserted
            and "this tier has no vectors, so simd.species is nil here and the assert would always fail; "
            .. "test it against nil and keep the vector path inside that branch"
            or "simd.species answers nil on this tier, so it must initialize a local that is tested against nil"
        )
    end
    local inferred = semanticRaw((node as any).inferredType)
    local resolved: scalarIR.Type? = nil
    if inferred ~= nil and inferred.tag == "union" then
        for _, member in ipairs(inferred.members or {}) do
            if semanticRaw(member).tag ~= "nil" then
                resolved = resolved or semanticValueType(member)
            end
        end
    else
        resolved = semanticValueType(inferred)
    end
    if resolved == nil or not tostring(resolved):match("^simd_species_") then
        context.reject(site, "simd.species needs the checker to resolve its species from the witness")
    end
    kernel.usesSimd = true

    return new scalarIR.Simd(
        op = "simd_species",
        args = {},
        -- The resolved type already carries the shape --
        -- `simd_species_f32_preferred` beside `simd_species_f32_fixed8` -- and
        -- every consumer reads it from there, so there is nothing for a second
        -- spelling to record.
        intrinsic = "species",
        type = resolved as scalarIR.Type,
        source = site
    )
end

--- The `simd.species(...)` call an `assert(...)` requires, or nothing.
local function assertedSpecies(node: cst.Call, kernel: lower.Kernel): cst.Call?
    if (node as any).aotGuardBuiltin ~= "assert" then
        return nil
    end
    local arguments = node.args ~= nil and (node.args as cst.Args).exprs or {}
    local first = arguments[1]
    if first == nil or first.kind ~= "call" or calledIdentity(first as cst.Call, kernel) ~= "nupp.simd.species" then
        return nil
    end
    if #arguments > 2 or #arguments == 2 and arguments[2].kind ~= "string" then
        kernel.context.reject(lower.site(node), "assert(simd.species(...)) takes at most a literal message")
    end

    return first as cst.Call
end

--- Whether a comparison against nil is answered statically: a species from
--- `simd.species` is never nil where the tier has vectors, and always nil
--- where it does not. Nothing else in the subset compares with nil.
local function speciesNilTest(written: string, lhs: cst.Node, rhs: cst.Node, environment: {[string]: any}): boolean?
    if written ~= "==" and written ~= "~=" then
        return nil
    end
    local named = lhs.kind == "nilExpr" and rhs or rhs.kind == "nilExpr" and lhs or nil
    if named == nil or (named as cst.Node).kind == "nilExpr" then
        return nil
    end
    local name = lower.nameOf(named as cst.Node)
    local bound = name ~= nil and environment[name as string] or nil
    if bound == nil then
        return nil
    end
    if bound.kind == "absent_species" then
        return written == "=="
    elseif bound.kind == "local" and tostring(bound.type):match("^simd_species_") ~= nil then
        return written == "~="
    end

    return nil
end

--- `cursor + s.lanes` widened to an exact 64-bit sum, when `sum` is that
--- wrapping 32-bit addition of a local cursor and a species' lane count;
--- anything else comes back as it was.
local function exactLaneSum(sum: scalarIR.Expr, source: scalarIR.Source?): scalarIR.Expr
    if sum.op ~= "u32_add" then
        return sum
    end
    local added = sum as scalarIR.Fixed
    if added.left.op ~= "local" or added.left.type ~= "u32" or added.right.op ~= "simd_lanes_generic" then
        return sum
    end

    return new scalarIR.Fixed(
        op = "u64_add",
        left = new scalarIR.Convert(op = "numeric_cast", value = added.left, type = "u64", source = source),
        right = new scalarIR.Convert(op = "numeric_cast", value = added.right, type = "u64", source = source),
        type = "u64",
        source = source
    )
end

--- One binary operator.
local function binary(node: cst.Binop, left: scalarIR.Expr, right: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local context = kernel.context
    local written = (node.op as lexer.Token).text
    local source = lower.site(node)

    local leftFamily, leftElement, leftShape = genericSimdParts(left.type)
    if leftFamily == "vector" then
        local rightFamily, rightElement, rightShape = genericSimdParts(right.type)
        if rightFamily == "vector" and (rightElement ~= leftElement or rightShape ~= leftShape) then
            context.reject(source, "explicit SIMD operands have different element or species identities")
        end
        right = simdOperand(right, left.type, source, kernel)
        local arithmeticOps = {['+'] = "add", ['-'] = "sub", ['*'] = "mul", ['/'] = "div"}
        local bitOps = {['&'] = "and", ['|'] = "or", ['~'] = "xor", ['<<'] = "shl", ['>>'] = "shr"}
        local comparisonOps = {['<'] = "lt", ['<='] = "le", ['>'] = "gt", ['>='] = "ge", ['=='] = "eq", ['~='] = "ne",}
        local intrinsic = arithmeticOps[written] or bitOps[written] or comparisonOps[written]
        if intrinsic == nil then
            context.reject(source, "operator " .. written .. " is not an explicit SIMD intrinsic")
        end
        local compared = comparisonOps[written] ~= nil
        return new scalarIR.Simd(
            op = compared and "simd_compare" or "simd_binary",
            args = {left, right},
            intrinsic = intrinsic,
            type = compared and "simd_mask_" .. tostring(leftElement) .. "_" .. tostring(leftShape) or left.type,
            source = source
        )
    elseif leftFamily == "mask" then
        local rightFamily = genericSimdParts(right.type)
        if rightFamily ~= "mask" or right.type ~= left.type then
            context.reject(source, "explicit SIMD mask operands need the same species")
        end
        local intrinsic = ({['&'] = "and", ['|'] = "or", ['~'] = "xor", ['=='] = "eq", ['~='] = "ne",})[written]
        if intrinsic == nil then
            context.reject(source, "operator " .. written .. " is not a mask intrinsic")
        end
        return new scalarIR.Simd(
            op = (written == "==" or written == "~=") and "simd_compare" or "simd_binary",
            args = {left, right},
            intrinsic = intrinsic,
            type = left.type,
            source = source
        )
    end

    local arithmetic = admit.ARITHMETIC[written]
    if arithmetic ~= nil then
        local wide = left.type == "u64"
            and "u64"
            or left.type == "i64"
            and "i64"
            or right.type == "u64"
            and "u64"
            or right.type == "i64"
            and "i64"
            or nil
        if wide ~= nil and (written == "+" or written == "-" or written == "*") then
            left = lower.convert(left, wide as scalarIR.Type, source, context)
            right = lower.convert(right, wide as scalarIR.Type, source, context)
            return new scalarIR.Fixed(
                op = (
                    (
                        wide == "u64" and "u64_" or "i64_"
                    ) .. (written == "+" and "add" or written == "-" and "sub" or "mul")
                ) as scalarIR.FixedOp,
                left = left,
                right = right,
                type = wide as scalarIR.Type,
                source = source
            )
        end
        if written == "+" or written == "-" or written == "*" then
            -- Established thirty-two bit operands stay at their width, as the
            -- checker decided when it typed the operator: `cursor + 1` on a
            -- `uint32` cursor is a `u32_add`, not a binary64 sum narrowed at
            -- the next store. A literal beside the operand is read at its width
            -- where it is exact there, so the constant does not widen the sum.
            local narrowedLeft = exactWidthConstant(left, right.type) or left
            local narrowedRight = exactWidthConstant(right, left.type) or right
            local width = narrowedLeft.type == narrowedRight.type and (
                narrowedLeft.type == "u32" or narrowedLeft.type == "i32"
            ) and narrowedLeft.type or nil
            if width ~= nil and (not context.checked or node.fixedArithmetic ~= nil) then
                return new scalarIR.Fixed(
                    op = (
                        tostring(width) .. "_" .. (written == "+" and "add" or written == "-" and "sub" or "mul")
                    ) as scalarIR.FixedOp,
                    left = narrowedLeft,
                    right = narrowedRight,
                    type = width as scalarIR.Type,
                    source = source
                )
            end
        end
        return new scalarIR.Binary(
            op = arithmetic,
            left = promote(left, node, context),
            right = promote(right, node, context),
            type = "f64",
            source = source
        )
    end

    local bitwise = admit.BITWISE[written]
    if bitwise ~= nil then
        -- A 64-bit operand keeps its width rather than being narrowed to the
        -- 32-bit pattern used by the ordinary bitwise family.
        local wide = left.type == "u64" or right.type == "u64"
        if wide and written ~= "~>>" then
            local u64Ops: {
                [string]: string
            } = {["&"] = "u64_and", ["|"] = "u64_or", ["~"] = "u64_xor", ["<<"] = "u64_shl", [">>"] = "u64_shr",}

            return new scalarIR.Fixed(
                op = u64Ops[written] as scalarIR.FixedOp,
                left = lower.convert(left, "u64", source, context),
                -- A shift count is converted to the operand width and masked to
                -- 63 in the backend, as the 32-bit pair masks its count to 31.
                right = lower.convert(right, "u64", source, context),
                type = "u64",
                source = source
            )
        end
        if not bitOperand(left) or not bitOperand(right) then
            context.reject(source, "bitwise operands must be fixed 32-bit values or nonnegative uint32 literals")
        end

        return new scalarIR.Binary(op = bitwise, left = left, right = right, type = "i32", source = source)
    end

    local comparison = admit.COMPARISON[written]
    if comparison ~= nil then
        local numeric = {["f64"] = true, ["f32"] = true, ["i32"] = true, ["u32"] = true, ["i64"] = true, ["u64"] = true}
        if left.type ~= right.type and not (numeric[left.type] and numeric[right.type]) then
            context.reject(source, "comparison operands must have compatible types")
        end

        -- A cursor compared against its bound is the commonest comparison in an
        -- admitted body, and the bound is written as an ordinary literal. Left
        -- alone the constant stays binary64 and C widens the cursor to meet it,
        -- so a counted loop converts and compares in floating point once an
        -- iteration to answer a question about two integers. Narrowing the
        -- constant where it is exactly representable at the other side's width
        -- answers the same question in the width it was asked about.
        local narrowedLeft = exactWidthConstant(left, right.type) or left
        local narrowedRight = exactWidthConstant(right, left.type) or right
        -- A whole-vector cursor guard, `cursor + s.lanes <= #span`, is taken
        -- exactly: the sum is widened to 64 bits rather than wrapped at 32,
        -- so past 2^32 - 1 the guard is false. Wrapped it would restart the
        -- loop from the top of the span, which no program means, and only the
        -- exact sum proves the vector access under it. See `laneBound`.
        -- A rooted string or buffer parameter's length is the same bound, held
        -- in the local its length was taken into rather than read off a span.
        local countedRight = right.op == "span_count" or right.op == "local" and (
            right as scalarIR.Name
        ).lengthOf ~= nil
        local countedLeft = left.op == "span_count" or left.op == "local" and (left as scalarIR.Name).lengthOf ~= nil
        if written == "<=" and countedRight then
            narrowedLeft = exactLaneSum(left, source)
        elseif written == ">=" and countedLeft then
            narrowedRight = exactLaneSum(right, source)
        end

        return new scalarIR.Binary(
            op = comparison,
            left = narrowedLeft,
            right = narrowedRight,
            type = "bool",
            source = source
        )
    end

    if written == "and" or written == "or" then
        if left.type ~= "bool" or right.type ~= "bool" then
            context.reject(source, "native and/or operands must both be boolean")
        end

        return new scalarIR.Binary(
            op = written as scalarIR.BinaryOp,
            left = left,
            right = right,
            type = "bool",
            source = source
        )
    end

    if written == ".." then
        if left.type ~= "lua_string" or right.type ~= "lua_string" then
            context.reject(source, "primitive concatenation needs two strings")
        end
        markLua(kernel, source)
        return new scalarIR.LuaConcat(
            op = "lua_concat",
            left = left,
            right = right,
            type = "lua_string",
            source = source
        )
    end

    context.reject(source, "operator " .. tostring(written) .. " is not admitted")

    return left
end

--- The unary fixed-width operations, which lower to `FixedUnary`; every other
--- unary entry in the set is a conversion. Mirrors `scalarIR.FixedUnaryOp`.
const FIXED_UNARY: {
    [string]: boolean
} = {
    ["f32_sqrt"] = true,
    ["f32_exp"] = true,
    ["u32_not"] = true,
    ["u32_popcount"] = true,
    ["u32_ctz"] = true,
    ["u32_clz"] = true,
    ["u64_not"] = true,
    ["u64_popcount"] = true,
    ["u64_ctz"] = true,
    ["u64_clz"] = true,
    ["u64_prefix_xor"] = true,
}

--- One call to a fixed-width intrinsic.
---
--- This is where the front end refuses to invent establishment the source never
--- performed: an operand has to already carry the refinement, or be an exact
--- literal, which establishes one by being written.
local function fixedCall(
    node: cst.Node,
    path: string,
    fixed: admit.Fixed,
    args: {scalarIR.Expr},
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    if #args ~= fixed.arity then
        context.reject(source, path .. " has an unsupported argument count")
    end

    for position, argument in ipairs(args) do
        if argument.op == "constant" and fixed.operand ~= "f64" then
            local literal = argument as scalarIR.Constant
            local number = tonumber(literal.value)
            if fixed.operand == "i32" or fixed.operand == "u32" then
                local exact = number ~= nil and number % 1 == 0 and number >= (
                    fixed.operand == "u32" and 0 or lower.INT32_MIN
                ) and number <= (fixed.operand == "u32" and lower.UINT32_MAX or lower.INT32_MAX)
                if not exact then
                    context.reject(source, path .. " needs an exact " .. fixed.operand .. " literal")
                end
                args[
                    position
                ] = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = literal.value,
                    type = fixed.operand,
                    source = literal.source
                )
            elseif fixed.operand == "i64" or fixed.operand == "u64" then
                if number == nil or number % 1 ~= 0 or number > 9007199254740992 or number < (
                    fixed.operand == "u64" and 0 or -9007199254740992
                ) then
                    context.reject(source, path .. " needs an exact " .. fixed.operand .. " literal")
                end
                args[
                    position
                ] = new scalarIR.Int64Constant(
                    op = "constant_i64",
                    value = ("%.0f"):format(number as number),
                    type = fixed.operand,
                    source = literal.source
                )
            else
                args[
                    position
                ] = new scalarIR.Convert(
                    op = "narrow_f64_f32",
                    value = argument,
                    type = "f32",
                    source = argument.source
                )
            end
        elseif fixed.operand == "f64" and (argument.type == "i32" or argument.type == "u32") then
            -- Widening, which is the one direction that invents nothing. Every
            -- 32-bit integer is exactly a binary64, so promoting one to reach an
            -- entry conversion loses no value and establishes no refinement --
            -- the conversion this is an argument to is what does that.
            --
            -- Without it `u32.wrap(i)` over a counted-loop index is refused,
            -- which is `wrap`'s declared `integer` argument arriving as the
            -- integer the loop index is.
            args[position] = lower.convert(argument, "f64", argument.source, context)
        elseif argument.type ~= fixed.operand then
            context.reject(
                source,
                path .. " argument " .. tostring(
                    position
                ) .. " is " .. tostring(argument.type) .. " and was never established as " .. fixed.operand
            )
        end
    end

    if fixed.arity == 1 then
        if FIXED_UNARY[tostring(fixed.op)] == true then
            return new scalarIR.FixedUnary(
                op = fixed.op as scalarIR.FixedUnaryOp,
                value = args[1],
                type = fixed.result,
                source = source
            )
        end

        return new scalarIR.Convert(
            op = fixed.op as scalarIR.ConvertOp,
            value = args[1],
            type = fixed.result,
            source = source
        )
    end
    if fixed.arity == 3 then
        return new scalarIR.Corrected(
            op = fixed.op as scalarIR.CorrectedOp,
            args = args,
            type = fixed.result,
            source = source
        )
    end
    if fixed.op == "f32_min" or fixed.op == "f32_max" then
        return new scalarIR.Corrected(
            op = fixed.op as scalarIR.CorrectedOp,
            left = args[1],
            right = args[2],
            type = fixed.result,
            source = source
        )
    end

    return new scalarIR.Fixed(
        op = fixed.op as scalarIR.FixedOp,
        left = args[1],
        right = args[2],
        type = fixed.result,
        source = source
    )
end

--- One call into the closed math set, whose operands are all binary64.
local function mathCall(
    node: cst.Node,
    path: string,
    intrinsic: admit.Math,
    args: {scalarIR.Expr},
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    if #args < intrinsic.min or intrinsic.max ~= nil and #args > (intrinsic.max as integer) then
        context.reject(source, path .. " has an unsupported argument count")
    end
    for position, argument in ipairs(args) do
        local widened = lower.conversion(argument, "f64", argument.source)
        if widened == nil then
            context.reject(source, path .. " arguments must be numeric")
        end
        args[position] = widened as scalarIR.Expr
    end

    return new scalarIR.Math(op = "math", intrinsic = intrinsic.name, args = args, type = "f64", source = source)
end

--- Multiple vector results use the existing pure-helper return convention.
--- Parameters capture each operand once, even when several outputs read it.
function lower.rearrange(
    operation: string,
    args: {scalarIR.Expr},
    source: scalarIR.Source,
    kernel: lower.Kernel
): scalarIR.Expr
    if args[1] == nil then
        kernel.context.reject(source, operation .. " needs matching SIMD vectors")
    end
    local family, _, shape = genericSimdParts(args[1].type)
    local count = operation == "transpose" and #args or 2
    if family ~= "vector" or #args ~= count then
        kernel.context.reject(source, operation .. " needs matching SIMD vectors")
    end
    for _, arg in ipairs(args) do
        if arg.type ~= args[1].type then
            kernel.context.reject(source, operation .. " needs matching SIMD vectors")
        end
    end
    if operation == "transpose" and (count < 2 or count > 64 or shape ~= "fixed" .. tostring(count)) then
        kernel.context.reject(source, "transpose needs a square tile of fixed-width vectors")
    end
    local key = "rearrange_" .. operation .. "_" .. args[1].type
    local helper = kernel.helpers["$" .. key]
    if helper == nil then
        local params: {scalarIR.Name} = {}
        local values: {scalarIR.Expr} = {}
        local resultTypes: {scalarIR.Type} = {}
        for i, arg in ipairs(args) do
            params[
                i
            ] = new scalarIR.Name(
                op = "helper_param",
                name = "row" .. tostring(i),
                cName = "row" .. tostring(i),
                type = arg.type,
                source = source
            )
        end
        for i = 1, count do
            local operands: {scalarIR.Expr} = {}
            for _, param in ipairs(params) do
                operands[#operands + 1] = param
            end
            operands[
                #operands + 1
            ] = new scalarIR.Constant(op = "constant", value = tostring(i - 1), type = "f64", source = source)
            values[
                i
            ] = new scalarIR.Simd(
                op = "simd_permute",
                intrinsic = operation,
                args = operands,
                type = args[1].type,
                source = source
            )
            resultTypes[i] = args[1].type
        end
        helper = new scalarIR.Helper(
            name = "$" .. key,
            cName = kernel.symbol .. "_" .. key,
            params = params,
            values = values,
            resultType = args[1].type,
            resultTypes = resultTypes,
            source = source
        )
        kernel.helpers["$" .. key] = helper
        kernel.helperOrder[#kernel.helperOrder + 1] = helper as scalarIR.Helper
    end
    kernel.usesSimd = true

    return new scalarIR.HelperCall(
        op = "helper_call",
        helper = (helper as scalarIR.Helper).name,
        cName = (helper as scalarIR.Helper).cName,
        args = args,
        type = "multi",
        resultTypes = (helper as scalarIR.Helper).resultTypes,
        source = source
    )
end

--- One call, which is an intrinsic or a visible pure helper and nothing else.
local function call(
    node: cst.Call,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local path = lower.dottedName(node.obj)
    local identity = calledIdentity(node, kernel)
    if identity == "nupp.simd.species" then
        -- Answered before the arguments lower: the witness is a library value,
        -- not something native code can hold.
        return species(node, kernel, false)
    end
    local required = assertedSpecies(node, kernel)
    if required ~= nil then
        return species(required as cst.Call, kernel, true)
    end

    local args: {scalarIR.Expr} = {}
    for _, argument in ipairs(node.args ~= nil and (node.args as cst.Args).exprs or {}) do
        args[#args + 1] = lower.expression(argument, environment, activeIndex, kernel)
    end
    -- A spelling is only the prelude's when nothing between here and the
    -- prelude has rebound `string`, which is the same test `table.new` makes.
    local preludeString = kernel.modules.string == "@prelude.string" and environment.string == nil
    if identity == "string.byte" or identity == "@prelude.string.byte" or path == "string.byte" and preludeString then
        if #args ~= 2 or args[1].type ~= "lua_string" or args[1].op ~= "local" or args[2].type ~= "f64" then
            context.reject(lower.site(node), "string.byte in AOT takes one rooted string and one numeric index")
        end
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaStringByte(
            op = "lua_string_byte_lua",
            bytes = args[1],
            index = args[2],
            type = "f64",
            source = lower.site(node)
        )
    elseif identity == "string.sub" or identity == "@prelude.string.sub" or path == "string.sub" and preludeString then
        if (
            #args ~= 2 and #args ~= 3
        ) or args[
            1
        ].type ~= "lua_string" or args[
            1
        ].op ~= "local" or args[2].type ~= "f64" or args[3] ~= nil and args[3].type ~= "f64" then
            context.reject(lower.site(node), "string.sub in AOT takes a rooted string and numeric bounds")
        end
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaSubstring(
            op = "lua_substring",
            bytes = args[1],
            first = args[2],
            last = args[3],
            type = "lua_string",
            source = lower.site(node)
        )
    elseif identity ~= nil and reducers.CONSTRUCTORS[identity] ~= nil then
        local contract = reducers.CONSTRUCTORS[identity] as reducers.Contract
        local resolved = semanticValueType((node as any).inferredType)
        local order, operation, element = reducers.parse(resolved or "")
        if element == nil or #args ~= (contract.seeded and 1 or 0) then
            context.reject(
                lower.site(node),
                "an exact reducer needs a concrete element type and its declared initial value"
            )
        end
        local initial: scalarIR.Expr = element == "bool" and new scalarIR.Bool(
            op = "bool",
            value = operation == "all",
            type = "bool",
            source = lower.site(node)
        ) or lower.convert(
            new scalarIR.Constant(op = "constant", value = "0", type = "f64", source = lower.site(node)),
            element as string,
            lower.site(node),
            context
