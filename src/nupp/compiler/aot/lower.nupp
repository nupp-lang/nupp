--[[
Turning admitted source into AOT IR.

The front end of the AOT backend: it reads the checked syntax tree and produces
the IR the verifier proves and the emitter prints. Everything here is about what
the source said; nothing here decides what the IR means.

The one rule worth stating separately is where a width may change. Ordinary Nupp
arithmetic is binary64, and `float`, `int32` and `uint32` are establishment facts
rather than arithmetic types -- so a value crosses between them only at a
conversion this module writes down, never as a side effect of an operator. A
narrowing that is not in the IR is a narrowing that did not happen.
]]

local admit = require("nupp.compiler.aot.admit")
local lexer = require("nupp.compiler.lexer")
local cst = require("nupp.compiler.cst")
local scalarIR = require("nupp.compiler.aot.scalar")

local lower = {}

--- What lowering needs from the caller.
record lower.Context
    --- Reports a construct the subset does not admit, naming where it was
    --- written. Does not return.
    reject: function(scalarIR.Source?, string): nil
end

--- The IR type one source spelling denotes, or nothing when it denotes none.
---
--- `integer` lowers to binary64 rather than to a 32-bit type: it is Nupp's
--- ordinary number with a range refinement, and giving it an integer
--- representation here would change what arithmetic on it answers.
function lower.sourceValueType(spelling: string): scalarIR.Type?
    if spelling == "boolean" then
        return "bool"
    elseif spelling == "number" or spelling == "integer" then
        return "f64"
    elseif spelling == "float" then
        return "f32"
    elseif spelling == "uint32" then
        return "u32"
    elseif spelling == "int32" then
        return "i32"
    end

    return nil
end

--- The conversion that takes `value` to `targetType`, if one exists.
---
--- Written into the IR rather than left implicit, because these are the only
--- places a width changes and an emitter that inferred them could infer a
--- different set.
function lower.conversion(value: scalarIR.Expr, targetType: scalarIR.Type, source: scalarIR.Source?): scalarIR.Expr?
    if value.type == targetType then
        return value
    end

    local op: string? = nil
    if targetType == "f64" and (value.type == "i32" or value.type == "u32") then
        op = "int_to_f64"
    elseif targetType == "f64" and value.type == "f32" then
        op = "widen_f32_f64"
    elseif targetType == "f32" and value.type == "f64" then
        op = "narrow_f64_f32"
    elseif (
        targetType == "i32" or targetType == "u32"
    ) and (value.type == "f64" or value.type == "i32" or value.type == "u32") then
        op = "numeric_cast"
    end
    if op == nil then
        return nil
    end

    return new scalarIR.Convert(op = op as any, value = value, type = targetType, source = source)
end

--- The same, refusing what has no conversion.
function lower.convert(
    value: scalarIR.Expr,
    targetType: scalarIR.Type,
    source: scalarIR.Source?,
    context: lower.Context
): scalarIR.Expr
    local converted = lower.conversion(value, targetType, source)
    if converted == nil then
        context.reject(
            source,
            "native value cannot convert from " .. tostring(value.type) .. " to " .. tostring(targetType)
        )
    end

    return converted as scalarIR.Expr
end

--- One argument brought to the type a helper parameter takes.
---
--- A helper takes ordinary Nupp values, so a fixed-width argument widens into it
--- exactly as it would at any other binary64 operator. Nothing narrows: a helper
--- that wanted binary32 would have to say so, and passing one silently would
--- change the answer.
function lower.helperArgument(
    value: scalarIR.Expr,
    wanted: scalarIR.Type,
    source: scalarIR.Source?,
    context: lower.Context
): scalarIR.Expr
    if value.type == wanted then
        return value
    end
    if wanted ~= "f64" then
        context.reject(source, "native helper argument type does not match")
    end

    local widened = lower.conversion(value, "f64", value.source)
    if widened == nil then
        context.reject(source, "native helper argument type does not match")
    end

    return widened as scalarIR.Expr
end

--- Where a node was written, for a diagnostic or an IR node that has to name it.
---
--- A construct with no token of its own reads as the start of the file rather
--- than as no position, because every IR node carries one and an absent
--- position would have to be handled everywhere downstream.
function lower.site(node: cst.Child?): scalarIR.Source
    local token = node ~= nil and cst.firstToken(node) or nil
    if token == nil then
        return new scalarIR.Source(line = 1, column = 1)
    end

    return new scalarIR.Source(line = (token as lexer.Token).line, column = (token as lexer.Token).col)
end

--- One written type, with its whitespace removed, so two spellings of the same
--- type compare equal.
function lower.compactType(node: cst.Child?): string
    if node == nil then
        return ""
    end

    return (cst.textOf(node as cst.Child):gsub("%s+", ""))
end

--- The layouts one kernel reifies, in the order they were first reached.
---
--- Order matters: it is the order the generated C declares the structs in, and
--- a set would not have one.
record lower.Layouts
    ordered: {scalarIR.Layout}
    byName: {[string]: scalarIR.Layout}
end

--- Admits one local struct as a span element layout.
---
--- Reifying a struct is a claim about memory, so the shape is deliberately
--- small: no generics, no supertypes, stored fields only, and every field type
--- one this backend has a storage width for. Anything else would be a layout
--- Nupp and C could disagree about.
function lower.layout(
    name: string,
    at: cst.Child?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context
): scalarIR.Layout
    local known = layouts.byName[name]
    if known ~= nil then
        return known as scalarIR.Layout
    end

    local found = declarations[name]
    if found == nil then
        context.reject(lower.site(at), "span element " .. name .. " is not a visible local struct")
    end

    local declaration = found as cst.RecordDecl
    if declaration.generics ~= nil or #(declaration.supertypes or {}) > 0 then
        context.reject(lower.site(declaration), "native structs must be non-generic and have no supertypes")
    end

    local layout = new scalarIR.Layout(name = name, cName = "Ks" .. name, fields = {}, source = lower.site(declaration))
    local seen: {[string]: boolean} = {}
    for _, entry in ipairs(declaration.entries) do
        local field = entry as cst.FieldDecl
        if entry.kind ~= "fieldDecl" or field.name == nil then
            context.reject(lower.site(entry), "native structs initially contain only stored fields")
        end

        local fieldName = (field.name as lexer.Token).text
        local spelling = lower.compactType(field.type)
        local fieldType = admit.STORAGE[spelling]
        if fieldType == nil then
            context.reject(
                lower.site(field.type or entry),
                "native struct field type " .. spelling .. " is not admitted"
            )
        end
        if seen[fieldName] then
            context.reject(lower.site(entry), "duplicate native struct field " .. fieldName)
        end
        seen[fieldName] = true
        layout.fields[
            #layout.fields + 1
        ] = new scalarIR.Field(name = fieldName, type = fieldType as string, source = lower.site(entry))
    end
    if #layout.fields == 0 then
        context.reject(lower.site(declaration), "native structs need at least one field")
    end

    layouts.byName[name] = layout
    layouts.ordered[#layouts.ordered + 1] = layout

    return layout
end

--- What one span parameter holds.
record lower.Element
    kind: 'scalar' | 'struct'

    --- The IR type of one element.
    type: string

    --- How the source spelled it, for a scalar element.
    sourceType: string?

    --- The reified layout, for a struct element.
    layout: scalarIR.Layout?
end

--- The element type a span spelling names, or nothing when it is not that span.
---
--- @param prefix the span type to match, as a Lua pattern
function lower.spanElement(
    spelling: string,
    prefix: string,
    at: cst.Child?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context
): lower.Element?
    local element = spelling:match("^" .. prefix .. "<(.+)>$")
    if element == nil then
        return nil
    end

    local storage = admit.STORAGE[element as string]
    if storage ~= nil then
        return new lower.Element(kind = "scalar", type = storage as string, sourceType = element as string)
    end

    return new lower.Element(
        kind = "struct",
        type = "struct:" .. (element as string),
        layout = lower.layout(element as string, at, declarations, layouts, context)
    )
end

--- The name one node writes, if it is a bare name.
function lower.nameOf(node: cst.Node?): string?
    if node == nil or node.kind ~= "name" then
        return nil
    end

    local token = (node as cst.NameExpr).token

    return token ~= nil and (token as lexer.Token).text or nil
end

--- The dotted path one node writes, if it is a chain of names.
---
--- `math.sqrt` and `nupp.math.f32.add` are how the admitted intrinsics are
--- written, and anything with a call or an index in it is not one of them.
function lower.dottedName(node: cst.Node?): string?
    if node == nil then
        return nil
    end
    if node.kind == "name" then
        return lower.nameOf(node)
    end
    if node.kind == "dotIndex" then
        local indexed = node as cst.DotIndex
        if indexed.name == nil then
            return nil
        end

        local base = lower.dottedName(indexed.obj)

        return base ~= nil and (base as string) .. "." .. (indexed.name as lexer.Token).text or nil
    end

    return nil
end

--- One name in scope, as the environment records it.
record lower.Bound
    kind: 'local' | 'uniform' | 'helper_param'
    name: string
    type: scalarIR.Type
    cName: string?
    mutable: boolean?
    source: scalarIR.Source?
end

--- What lowering one kernel's body needs to know.
record lower.Kernel
    --- Span and uniform parameters by name, as the signature admitted them.
    params: {[string]: any}

    --- The layouts reified so far.
    layouts: lower.Layouts

    --- Visible pure helper declarations by name.
    helperDecls: {[string]: any}

    --- Helpers lowered so far, by name and in the order they were reached.
    helpers: {[string]: scalarIR.Helper}

    helperOrder: {scalarIR.Helper}

    --- Which helpers are part way through lowering, so a cycle is caught rather
    --- than followed.
    helperState: {[string]: string}

    --- The kernel's exported symbol, which its helpers are named after.
    symbol: string

    --- Where the kernel loop was written, for a refusal that has no node of its
    --- own to name.
    loopSource: scalarIR.Source?

    --- The loop counter, which is the only index a span access may use.
    index: string

    --- How many locals have been named, so two source scopes using one name get
    --- two C names.
    serial: integer

    context: lower.Context
end

--- The largest 32-bit pattern, for a literal standing in for one.
const lower.UINT32_MAX = 4294967295

--- The bounds of int32, for a literal that has to be exactly representable.
const lower.INT32_MIN = -2147483648

const lower.INT32_MAX = 2147483647

--- Whether a value may take part in a bitwise operation.
---
--- A value established as 32-bit may. So may an exact nonnegative literal that
--- already denotes a 32-bit pattern, which is how a mask is written without a
--- cast.
local function bitOperand(value: scalarIR.Expr): boolean
    if value.type == "i32" or value.type == "u32" then
        return true
    end
    if value.op ~= "constant" then
        return false
    end

    local number = tonumber((value as scalarIR.Constant).value)

    return number ~= nil and number >= 0 and number <= lower.UINT32_MAX and number % 1 == 0
end

--- One operand of ordinary arithmetic, which is binary64.
---
--- A fixed-width value widens here, which is the same thing ordinary Nupp does:
--- an operator is binary64 and a narrower value entering one is a conversion,
--- not a narrower operation.
local function promote(value: scalarIR.Expr, at: cst.Node?, context: lower.Context): scalarIR.Expr
    local widened = lower.conversion(value, "f64", value.source)
    if widened == nil then
        context.reject(lower.site(at), "arithmetic operands must both be numeric")
    end

    return widened as scalarIR.Expr
end

--- A load that a physical narrow width widens out of.
---
--- This is where storage becomes an ordinary Nupp number, and the only place a
--- widening happens without the source asking. Reading a `float` field gives a
--- number, exactly as it does through the Lua body.
local function widenLoad(loaded: scalarIR.Expr, source: scalarIR.Source?): scalarIR.Expr
    if loaded.type ~= "f32" then
        return loaded
    end

    return new scalarIR.Convert(op = "widen_f32_f64", value = loaded, type = "f64", source = source)
end

--- One `span:get(i)` or `span:getMut(i)`.
---
--- The index has to be the loop's own, exactly. Consecutive access is the whole
--- of the licence to run several iterations at once, and an index this backend
--- cannot prove consecutive is one it will not admit.
local function spanRead(node: cst.MethodCall, activeIndex: string?, kernel: lower.Kernel): scalarIR.Expr
    local context = kernel.context
    local spanName = lower.nameOf(node.obj)
    local param = spanName ~= nil and kernel.params[spanName as string] or nil
    local args = node.args ~= nil and (node.args as cst.Args).exprs or {}
    local method = node.name ~= nil and (node.name as lexer.Token).text or ""
    local readable = param ~= nil and (
        param.kind == "read_span" and method == "get" or param.kind == "write_span" and method == "getMut"
    )
    if not readable then
        context.reject(lower.site(node), "span reads use input:get(index) or output:getMut(index)")
    end
    if activeIndex == nil or #args ~= 1 or lower.nameOf(args[1]) ~= activeIndex then
        context.reject(lower.site(node), "span loads must use the active loop index exactly")
    end

    local element = param.element
    local index = activeIndex as string
    if element.kind == "struct" then
        return new scalarIR.ElementRef(
            op = "element_ref",
            span = spanName as string,
            index = index,
            layout = element.layout.name,
            mutable = param.kind == "write_span",
            type = "ref:" .. element.layout.name,
            source = lower.site(node)
        )
    end

    return widenLoad(
        new scalarIR.Load(
            op = "load",
            span = spanName as string,
            index = index,
            type = element.type,
            source = lower.site(node)
        ),
        lower.site(node)
    )
end

--- One field of a struct element.
local function fieldRead(node: cst.DotIndex, object: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local context = kernel.context
    local layoutName = object.type:match("^ref:(.+)$")
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if layout == nil then
        context.reject(lower.site(node), "native field access needs a reified struct element")
    end

    local wanted = (node.name as lexer.Token).text
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == wanted then
            field = candidate
        end
    end
    if field == nil then
        context.reject(lower.site(node), "struct " .. tostring(layoutName) .. " has no field " .. wanted)
    end

    return widenLoad(
        new scalarIR.FieldLoad(
            op = "field_load",
            object = object,
            layout = layoutName as string,
            field = (field as scalarIR.Field).name,
            type = (field as scalarIR.Field).type,
            source = lower.site(node)
        ),
        lower.site(node)
    )
end

--- One binary operator.
local function binary(node: cst.Binop, left: scalarIR.Expr, right: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local context = kernel.context
    local written = (node.op as lexer.Token).text
    local source = lower.site(node)

    local arithmetic = admit.ARITHMETIC[written]
    if arithmetic ~= nil then
        return new scalarIR.Binary(
            op = arithmetic as any,
            left = promote(left, node, context),
            right = promote(right, node, context),
            type = "f64",
            source = source
        )
    end

    local bitwise = admit.BITWISE[written]
    if bitwise ~= nil then
        if not bitOperand(left) or not bitOperand(right) then
            context.reject(source, "bitwise operands must be fixed 32-bit values or nonnegative uint32 literals")
        end

        return new scalarIR.Binary(op = bitwise as any, left = left, right = right, type = "i32", source = source)
    end

    local comparison = admit.COMPARISON[written]
    if comparison ~= nil then
        local numeric = {["f64"] = true, ["f32"] = true, ["i32"] = true, ["u32"] = true}
        if left.type ~= right.type and not (numeric[left.type] and numeric[right.type]) then
            context.reject(source, "comparison operands must have compatible types")
        end

        return new scalarIR.Binary(op = comparison as any, left = left, right = right, type = "bool", source = source)
    end

    if written == "and" or written == "or" then
        if left.type ~= "bool" or right.type ~= "bool" then
            context.reject(source, "native and/or operands must both be boolean")
        end

        return new scalarIR.Binary(op = written as any, left = left, right = right, type = "bool", source = source)
    end

    context.reject(source, "operator " .. tostring(written) .. " is not admitted")

    return left
end

--- One call to a fixed-width intrinsic.
---
--- This is where the front end refuses to invent establishment the source never
--- performed: an operand has to already carry the refinement, or be an exact
--- literal, which establishes one by being written.
local function fixedCall(
    node: cst.Node,
    path: string,
    fixed: admit.Fixed,
    args: {scalarIR.Expr},
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    if #args ~= fixed.arity then
        context.reject(source, path .. " has an unsupported argument count")
    end

    for position, argument in ipairs(args) do
        if argument.op == "constant" and fixed.operand ~= "f64" then
            local literal = argument as scalarIR.Constant
            local number = tonumber(literal.value)
            if fixed.operand == "i32" then
                local exact = number ~= nil
                    and number % 1 == 0
                    and number >= lower.INT32_MIN
                    and number <= lower.INT32_MAX
                if not exact then
                    context.reject(source, path .. " needs an exact int32 literal")
                end
                args[
                    position
                ] = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = literal.value,
                    type = "i32",
                    source = literal.source
                )
            else
                args[
                    position
                ] = new scalarIR.Convert(
                    op = "narrow_f64_f32",
                    value = argument,
                    type = "f32",
                    source = argument.source
                )
            end
        elseif argument.type ~= fixed.operand then
            context.reject(
                source,
                path .. " argument " .. tostring(
                    position
                ) .. " is " .. tostring(argument.type) .. " and was never established as " .. fixed.operand
            )
        end
    end

    if fixed.arity == 1 then
        if fixed.op == "f32_sqrt" then
            return new scalarIR.FixedUnary(op = "f32_sqrt", value = args[1], type = fixed.result, source = source)
        end

        return new scalarIR.Convert(op = fixed.op as any, value = args[1], type = fixed.result, source = source)
    end
    if fixed.arity == 3 then
        return new scalarIR.Corrected(op = fixed.op as any, args = args, type = fixed.result, source = source)
    end
    if fixed.op == "f32_min" or fixed.op == "f32_max" then
        return new scalarIR.Corrected(
            op = fixed.op as any,
            left = args[1],
            right = args[2],
            type = fixed.result,
            source = source
        )
    end

    return new scalarIR.Fixed(
        op = fixed.op as any,
        left = args[1],
        right = args[2],
        type = fixed.result,
        source = source
    )
end

--- One call into the closed math set, whose operands are all binary64.
local function mathCall(
    node: cst.Node,
    path: string,
    intrinsic: admit.Math,
    args: {scalarIR.Expr},
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    if #args < intrinsic.min or intrinsic.max ~= nil and #args > (intrinsic.max as integer) then
        context.reject(source, path .. " has an unsupported argument count")
    end
    for position, argument in ipairs(args) do
        local widened = lower.conversion(argument, "f64", argument.source)
        if widened == nil then
            context.reject(source, path .. " arguments must be numeric")
        end
        args[position] = widened as scalarIR.Expr
    end

    return new scalarIR.Math(op = "math", intrinsic = intrinsic.name, args = args, type = "f64", source = source)
end

--- One call, which is an intrinsic or a visible pure helper and nothing else.
local function call(
    node: cst.Call,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local args: {scalarIR.Expr} = {}
    for _, argument in ipairs(node.args ~= nil and (node.args as cst.Args).exprs or {}) do
        args[#args + 1] = lower.expression(argument, environment, activeIndex, kernel)
    end

    local path = lower.dottedName(node.obj)
    local fixed = path ~= nil and admit.fixed(path as string) or nil
    if fixed ~= nil then
        return fixedCall(node, path as string, fixed as admit.Fixed, args, kernel)
    end

    local intrinsic = path ~= nil and admit.math(path as string) or nil
    if intrinsic ~= nil then
        return mathCall(node, path as string, intrinsic as admit.Math, args, kernel)
    end

    local helperName = lower.nameOf(node.obj)
    if helperName == nil then
        context.reject(lower.site(node), "call target " .. tostring(path) .. " is not an admitted intrinsic or helper")
    end

    local helper = lower.helper(helperName as string, node, kernel)
    if #args ~= #helper.params then
        context.reject(lower.site(node), "native helper argument count does not match")
    end
    for position, argument in ipairs(args) do
        args[position] = lower.helperArgument(argument, helper.params[position].type, lower.site(node), context)
    end

    return new scalarIR.HelperCall(
        op = "helper_call",
        helper = helper.name,
        cName = helper.cName,
        args = args,
        type = #helper.resultTypes == 1 and helper.resultType or "multi",
        resultTypes = helper.resultTypes,
        source = lower.site(node)
    )
end

--- One unary operator.
local function unary(node: cst.Unop, value: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local written = (node.op as lexer.Token).text
    local source = lower.site(node)
    if written == "-" and value.type == "f64" then
        return new scalarIR.Unary(op = "neg", value = value, type = "f64", source = source)
    elseif written == "not" and value.type == "bool" then
        return new scalarIR.Unary(op = "not", value = value, type = "bool", source = source)
    elseif written == "~" and bitOperand(value) then
        return new scalarIR.Unary(op = "bnot", value = value, type = "i32", source = source)
    end

    kernel.context.reject(source, "unary operator " .. tostring(written) .. " is not admitted for this type")

    return value
end

--- One admitted expression, and everything under it.
---
--- @param environment the names in scope, by name
--- @param activeIndex the loop counter, where one is in scope
function lower.expression(
    node: cst.Node,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    if node == nil then
        context.reject(kernel.loopSource, "an expression is missing")
    end
    node = node as cst.Node

    local kind = node.kind
    -- Parentheses and a cast carry no operation: the tree already has the
    -- grouping, and a cast the checker admitted has already been proved.
    if kind == "paren" or kind == "castExpr" then
        local inner = kind == "paren" and (node as cst.Paren).expr or (node as cst.CastExpr).expr

        return lower.expression(inner as cst.Node, environment, activeIndex, kernel)
    elseif kind == "name" then
        local name = lower.nameOf(node)
        local bound = name ~= nil and environment[name as string] or nil
        if bound == nil then
            context.reject(lower.site(node), "value " .. tostring(name) .. " is not available in native code")
        end

        -- A name keeps whatever refinement its binding holds. Only a physical
        -- load widens eagerly, because that is where ordinary Nupp turns storage
        -- into a number; widening here as well would make an established `float`
        -- local unreadable as one.
        local op = bound.kind == "uniform" and "uniform" or bound.kind == "helper_param" and "helper_param" or "local"

        return new scalarIR.Name(
            op = op as any,
            name = name as string,
            type = bound.type,
            cName = bound.cName,
            mutable = bound.mutable,
            source = lower.site(node)
        )
    elseif kind == "number" then
        local token = (node as cst.NumberLit).token
        local value = token ~= nil and (token as lexer.Token).text or ""
        if tonumber(value) == nil then
            context.reject(lower.site(node), "the kernel needs a finite decimal numeric literal")
        end

        return new scalarIR.Constant(op = "constant", value = value, type = "f64", source = lower.site(node))
    elseif kind == "trueExpr" or kind == "falseExpr" then
        return new scalarIR.Bool(op = "bool", value = kind == "trueExpr", type = "bool", source = lower.site(node))
    elseif kind == "unop" and (node as cst.Unop).op ~= nil then
        local operator = node as cst.Unop

        return unary(operator, lower.expression(operator.operand as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "methodCall" then
        return spanRead(node as cst.MethodCall, activeIndex, kernel)
    elseif kind == "dotIndex" and (node as cst.DotIndex).name ~= nil then
        local indexed = node as cst.DotIndex

        return fieldRead(indexed, lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "binop" and (node as cst.Binop).op ~= nil then
        local operator = node as cst.Binop

        return binary(
            operator,
            lower.expression(operator.lhs as cst.Node, environment, activeIndex, kernel),
            lower.expression(operator.rhs as cst.Node, environment, activeIndex, kernel),
            kernel
        )
    elseif kind == "call" then
        return call(node as cst.Call, environment, activeIndex, kernel)
    end

    context.reject(lower.site(node), "expression kind " .. tostring(kind) .. " is not admitted")

    return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(node))
end

--- The IR type one helper signature spelling denotes.
---
--- A helper takes and returns ordinary Nupp values, so `float` here is binary64
--- rather than an establishment: a helper that wanted binary32 would have to say
--- so in a way this subset does not yet have.
function lower.helperValueType(spelling: string): scalarIR.Type?
    if spelling == "boolean" then
        return "bool"
    elseif spelling == "number" or spelling == "float" or spelling == "integer" then
        return "f64"
    elseif spelling == "uint32" then
        return "u32"
    elseif spelling == "int32" then
        return "i32"
    end

    return nil
end

--- Lowers one visible pure helper, on first reach.
---
--- A helper is a parameter list and one return list over those parameters, and
--- nothing else. That is what makes inlining it into a lane body substitution
--- rather than a transformation.
function lower.helper(name: string, at: cst.Node?, kernel: lower.Kernel): scalarIR.Helper
    local context = kernel.context
    if kernel.helperState[name] == "lowering" then
        context.reject(lower.site(at), "recursive native helpers are not admitted")
    end

    local known = kernel.helpers[name]
    if known ~= nil then
        return known as scalarIR.Helper
    end

    local declaration = kernel.helperDecls[name]
    if declaration == nil then
        context.reject(lower.site(at), "call target " .. name .. " is not a visible pure helper")
    end
    kernel.helperState[name] = "lowering"

    local body = declaration.body
    if body == nil
        or body.generics ~= nil
        or body.varargParam ~= nil
        or body.captureTakes ~= nil
        or body.captureBorrows ~= nil
    then
        context.reject(lower.site(declaration), "native helpers must be non-generic, non-variadic, and non-capturing")
    end

    local resultTypes: {scalarIR.Type} = {}
    for _, result in ipairs(body.rets or {}) do
        local resultType = lower.helperValueType(lower.compactType(result))
        if resultType == nil then
            context.reject(lower.site(result), "native helper results are numeric or boolean values")
        end
        resultTypes[#resultTypes + 1] = resultType as scalarIR.Type
    end
    if #resultTypes == 0 then
        context.reject(lower.site(body), "native helpers need at least one result")
    end

    local params: {scalarIR.Name} = {}
    local environment: {[string]: any} = {}
    for _, raw in ipairs(body.params or {}) do
        local paramName = raw.name ~= nil and (raw.name as lexer.Token).text or nil
        local paramType = lower.helperValueType(lower.compactType(raw.type))
        if paramName == nil or paramType == nil or raw.modeTok ~= nil then
            context.reject(lower.site(raw), "native helper parameters are unowned numeric or boolean values")
        end
        if environment[paramName as string] ~= nil then
            context.reject(lower.site(raw), "duplicate helper parameter " .. (paramName as string))
        end

        local param = new scalarIR.Name(
            op = "helper_param",
            name = paramName as string,
            type = paramType as scalarIR.Type,
            cName = scalarIR.cIdentifier("a", paramName as string),
            source = lower.site(raw)
        )
        params[#params + 1] = param
        environment[paramName as string] = param
    end

    local statements = body.body ~= nil and (body.body as cst.Block).stats or {}
    local returned = statements[1]
    local single = #statements == 1 and returned ~= nil and returned.kind == "returnStmt" and #(
        (returned as cst.ReturnStmt).exprs or {}
    ) == #resultTypes
    if not single then
        context.reject(lower.site(body.body or body), "a native helper body is one matching return list")
    end

    local helper = new scalarIR.Helper(
        name = name,
        cName = kernel.symbol .. "_helper_" .. scalarIR.privateSymbol(name):sub(4),
        params = params,
        values = {},
        resultType = resultTypes[1],
        resultTypes = resultTypes,
        source = lower.site(declaration)
    )
    kernel.helpers[name] = helper

    for position, result in ipairs((returned as cst.ReturnStmt).exprs or {}) do
        local value = lower.expression(result, environment, nil, kernel)
        if value.type ~= resultTypes[position] then
            context.reject(lower.site(returned), "native helper result type does not match")
        end
        helper.values[position] = value
    end
    kernel.helperState[name] = "done"
    kernel.helperOrder[#kernel.helperOrder + 1] = helper

    return helper
end

--- An environment with the same entries, so a nested block cannot leak the
--- names it introduces back out of itself.
local function inherit(environment: {[string]: any}): {[string]: any}
    local copied: {[string]: any} = {}
    for name, bound in pairs(environment) do
        copied[name] = bound
    end

    return copied
end

--- Introduces one local, refusing a name already in scope.
---
--- Shadowing is refused rather than renamed: the generated C has no scope to
--- tell two bindings of one name apart, and quietly renaming would make the
--- source and the C disagree about which one a later read meant.
local function bind(
    name: string,
    valueType: scalarIR.Type,
    mutable: boolean?,
    at: cst.Node?,
    environment: {[string]: any},
    kernel: lower.Kernel
): scalarIR.Binding
    if environment[name] ~= nil then
        kernel.context.reject(lower.site(at), "native locals may not shadow " .. name)
    end
    kernel.serial = kernel.serial + 1

    local binding = new scalarIR.Binding(
        kind = "local",
        name = name,
        type = valueType,
        mutable = mutable,
        cName = scalarIR.cIdentifier("v" .. tostring(kernel.serial), name),
        source = lower.site(at)
    )
    environment[name] = binding

    return binding
end

--- One `local` declaration, which may bind several names from one call.
local function localStmt(
    stat: cst.LocalStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local names = stat.names or {}
    local exprs = stat.exprs or {}
    if #names == 0 or #exprs == 0 then
        context.reject(lower.site(stat), "native locals must be initialized")
    end

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        if only.type == "multi" then
            -- One call, several results. The names are bound together because
            -- the call happens once, whatever it is later inlined into.
            local call = only as scalarIR.HelperCall
            local resultTypes = call.resultTypes or {}
            if #resultTypes ~= #names then
                context.reject(lower.site(stat), "multiple-result helper count does not match local names")
            end

            local bindings: {scalarIR.Binding} = {}
            for position, token in ipairs(names) do
                local annotated = lower.sourceValueType(
                    lower.compactType(stat.types ~= nil and (stat.types as {cst.Node})[position] or nil)
                )
                local valueType = resultTypes[position]
                if annotated ~= nil and annotated ~= valueType then
                    context.reject(lower.site(stat), "native local annotation does not match")
                end
                bindings[position] = bind(token.text, valueType, nil, stat, environment, kernel)
            end
            out[
                #out + 1
            ] = new scalarIR.MultiLet(op = "multi_let", call = call, bindings = bindings, source = lower.site(stat))

            return
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            local value = lower.expression(expression, environment, kernel.index, kernel)
            if value.type == "multi" then
                context.reject(lower.site(expression), "a multiple-result call must be the only initializer")
            end
            values[#values + 1] = value
        end
    end

    if #values ~= #names then
        context.reject(lower.site(stat), "native local initializer count must match names")
    end
    for position, token in ipairs(names) do
        local spelling = lower.compactType(stat.types ~= nil and (stat.types as {cst.Node})[position] or nil)
        local expected = spelling ~= "" and lower.sourceValueType(spelling) or values[position].type
        if expected == nil then
            context.reject(lower.site(stat), "native local annotation " .. spelling .. " is not admitted")
        end

        local value = lower.convert(values[position], expected as scalarIR.Type, lower.site(stat), context)
        local binding = bind(
            token.text,
            expected as scalarIR.Type,
            (value as scalarIR.ElementRef).mutable,
            stat,
            environment,
            kernel
        )
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = token.text,
            cName = binding.cName,
            type = expected as scalarIR.Type,
            value = value,
            source = lower.site(stat)
        )
    end
end

--- One `output:set(index, value)`, which is the only call statement admitted.
local function callStmt(
    stat: cst.CallStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local call = stat.expr
    local spanName = call ~= nil and call.kind == "methodCall" and lower.nameOf((call as cst.MethodCall).obj) or nil
    local output = spanName ~= nil and kernel.params[spanName as string] or nil
    local method = call ~= nil and call.kind == "methodCall" and (call as cst.MethodCall).name or nil
    local args = call ~= nil and call.kind == "methodCall" and (
        call as cst.MethodCall
    ).args ~= nil and ((call as cst.MethodCall).args as cst.Args).exprs or {}
    if output == nil or output.kind ~= "write_span" or method == nil or (method as lexer.Token).text ~= "set" then
        context.reject(lower.site(stat), "a native call statement must be output:set(index, value)")
    end
    if #args ~= 2 or lower.nameOf(args[1]) ~= kernel.index then
        context.reject(lower.site(call), "span stores must use the active loop index exactly")
    end

    local value = lower.expression(args[2], environment, kernel.index, kernel)
    out[
        #out + 1
    ] = new scalarIR.Store(
        op = "store",
        span = spanName as string,
        index = kernel.index,
        value = lower.convert(value, output.element.type, lower.site(call), context),
        source = lower.site(call)
    )
end

--- Where one assignment puts its value.
local function assignTarget(target: cst.Node, environment: {[string]: any}, kernel: lower.Kernel): scalarIR.Target
    local context = kernel.context
    if target.kind == "name" then
        local binding = environment[tostring(lower.nameOf(target))]
        if binding == nil or binding.kind ~= "local" then
            context.reject(lower.site(target), "native assignment target must be a local")
        end

        return new scalarIR.Target(kind = "local", name = binding.name, cName = binding.cName, type = binding.type)
    end

    local indexed = target as cst.DotIndex
    if target.kind ~= "dotIndex" or indexed.name == nil then
        context.reject(lower.site(target), "native assignment targets are locals or mutable struct fields")
    end

    local object = lower.expression(indexed.obj as cst.Node, environment, kernel.index, kernel)
    local layoutName = object.type:match("^ref:(.+)$")
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if layout == nil or (object as scalarIR.ElementRef).mutable ~= true then
        context.reject(lower.site(target), "native field assignment needs getMut(index)")
    end

    local wanted = (indexed.name as lexer.Token).text
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == wanted then
            field = candidate
        end
    end
    if field == nil then
        context.reject(lower.site(target), "unknown native struct field " .. wanted)
    end

    return new scalarIR.Target(
        kind = "field",
        object = object,
        layout = layoutName as string,
        field = (field as scalarIR.Field).name,
        type = (field as scalarIR.Field).type
    )
end

--- One assignment, which may write several targets at once.
local function assignStmt(
    stat: cst.AssignStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local exprs = stat.exprs or {}
    local targets = stat.targets or {}

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        if only.type == "multi" then
            context.reject(
                lower.site(stat),
                "multiple-result helpers initialize locals; ordinary multiple assignment uses explicit values"
            )
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            values[#values + 1] = lower.expression(expression, environment, kernel.index, kernel)
        end
    end
    if #values ~= #targets then
        context.reject(lower.site(stat), "native assignment counts must match")
    end

    local assignments: {scalarIR.Assignment} = {}
    for position, target in ipairs(targets) do
        local lowered = assignTarget(target, environment, kernel)
        assignments[
            position
        ] = new scalarIR.Assignment(
            target = lowered,
            value = lower.convert(values[position], lowered.type as scalarIR.Type, lower.site(stat), context)
        )
    end
    out[#out + 1] = new scalarIR.Assign(op = "assign", values = assignments, source = lower.site(stat))
end

--- One numeric `for` bound.
---
--- An integer literal stays an integer rather than being written as a double
--- for the emitter to cast back.
local function forBound(bound: scalarIR.Expr, at: cst.Node?, kernel: lower.Kernel): scalarIR.Expr
    if bound.op == "constant" then
        local number = tonumber((bound as scalarIR.Constant).value)
        if number ~= nil and number == math.floor(number as number) then
            return new scalarIR.IntConstant(
                op = "constant_i32",
                value = tostring(number),
                type = "i32",
                source = bound.source
            )
        end
    end
    if bound.type ~= "i32" and bound.type ~= "u32" and bound.type ~= "f64" then
        kernel.context.reject(lower.site(at), "native for bounds must be numeric")
    end

    return bound
end

--- One block of admitted statements, and everything under it.
function lower.block(statements: {cst.Node}, environment: {[string]: any}, kernel: lower.Kernel): {scalarIR.Statement}
    local context = kernel.context
    local out: {scalarIR.Statement} = {}

    --- One nested block, under its own scope.
    local function nested(body: cst.Node?): {scalarIR.Statement}
        local block = body as cst.Block?

        return lower.block(block ~= nil and (block as cst.Block).stats or {}, inherit(environment), kernel)
    end

    for _, stat in ipairs(statements) do
        local kind = stat.kind
        if kind == "localStmt" then
            localStmt(stat as cst.LocalStmt, out, environment, kernel)
        elseif kind == "callStmt" then
            callStmt(stat as cst.CallStmt, out, environment, kernel)
        elseif kind == "assignStmt" then
            assignStmt(stat as cst.AssignStmt, out, environment, kernel)
        elseif kind == "ifStmt" then
            local branch = stat as cst.IfStmt
            local clauses: {scalarIR.Clause} = {}
            for _, arm in ipairs(branch.clauses or {}) do
                local condition = lower.expression(arm.cond as cst.Node, environment, kernel.index, kernel)
                if condition.type ~= "bool" then
                    context.reject(lower.site(arm.cond), "native branch conditions must be boolean")
                end
                clauses[
                    #clauses + 1
                ] = new scalarIR.Clause(condition = condition, body = nested(arm.body), source = lower.site(arm))
            end

            local elseClause = branch.elseClause
            out[
                #out + 1
            ] = new scalarIR.If(
                op = "if",
                clauses = clauses,
                elseBody = elseClause ~= nil and nested((elseClause as cst.ElseClause).body) or nil,
                source = lower.site(stat)
            )
        elseif kind == "fornumStmt" then
            -- A bounded nested loop with an integer induction variable. The
            -- outer row loop already counts in an integer; a `while` over a
            -- number local does the same job with a double, which is a worse
            -- lowering of the same intent.
            local loop = stat as cst.FornumStmt
            if loop.step ~= nil then
                context.reject(lower.site(stat), "a native nested for loop takes no explicit step")
            end

            local from = forBound(
                lower.expression(loop.start as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            local to = forBound(
                lower.expression(loop.stop as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            if loop.var == nil then
                context.reject(lower.site(stat), "a native for loop needs an induction variable")
            end

            local inner = inherit(environment)
            local binding = bind((loop.var as lexer.Token).text, "i32", nil, stat, inner, kernel)
            out[
                #out + 1
            ] = new scalarIR.Fornum(
                op = "fornum",
                binding = binding,
                from = from,
                to = to,
                body = lower.block(loop.body ~= nil and (loop.body as cst.Block).stats or {}, inner, kernel),
                source = lower.site(stat)
            )
        elseif kind == "whileStmt" then
            -- A nested loop the kernel controls itself, as distinct from the
            -- outer row loop the prototype supplies. Nothing here bounds its
            -- trip count: the condition is ordinary Nupp and termination is the
            -- source's business, exactly as it is when the same function runs as
            -- ordinary Nupp. That is a real difference from the outer loop,
            -- whose bounds the IR carries and the verifier checks.
            local loop = stat as cst.WhileStmt
            local condition = lower.expression(loop.cond as cst.Node, environment, kernel.index, kernel)
            if condition.type ~= "bool" then
                context.reject(lower.site(loop.cond), "native loop conditions must be boolean")
            end
            out[
                #out + 1
            ] = new scalarIR.While(
                op = "while",
                condition = condition,
                body = nested(loop.body),
                source = lower.site(stat)
            )
        elseif kind == "doStmt" then
            out[
                #out + 1
            ] = new scalarIR.Block(op = "block", body = nested((stat as cst.DoStmt).body), source = lower.site(stat))
        elseif kind == "breakStmt" then
            out[#out + 1] = new scalarIR.Break(op = "break", source = lower.site(stat))
        elseif kind == "continueStmt" then
            out[#out + 1] = new scalarIR.Continue(op = "continue", source = lower.site(stat))
        else
            context.reject(
                lower.site(stat),
                "statement kind " .. tostring(kind) .. " is not admitted in the native loop"
            )
        end
    end

    return out
end

return lower
