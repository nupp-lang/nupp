            2
        ].type ~= "lua_string" and args[
            2
        ].type ~= "lua_bytes" or args[2].op ~= "local" or args[3].type ~= "u32" or args[4].type ~= "u32" then
            context.reject(
                lower.site(node),
                "valuebuilder.numberToken takes a local builder, rooted bytes, uint32 start, and uint32 limit"
            )
        end
        markLua(kernel, lower.site(node))
        kernel.usesNumberToken = true
        return new scalarIR.LuaBuilderNumberToken(
            op = "lua_builder_number_token",
            builder = args[1],
            mode = (args[1] as scalarIR.Name).builderMode as any,
            sourceBytes = args[2],
            start = args[3],
            limit = args[4],
            type = "u32",
            source = lower.site(node)
        )
    elseif identity ~= nil and identity:match("^nupp%.codec%.valuebuilder%.") ~= nil then
        local action = tostring(identity):match("^nupp%.codec%.valuebuilder%.(.+)$")
        local operations: {
            [string]: string
        } = {
            openArray = "lua_builder_open_array",
            openObject = "lua_builder_open_object",
            key = "lua_builder_key",
            string = "lua_builder_string",
            number = "lua_builder_number",
            numberSlice = "lua_builder_number_slice",
            integerSlice = "lua_builder_integer_slice",
            integer64 = "lua_builder_integer64",
            decimal64 = "lua_builder_decimal64",
            boolean = "lua_builder_boolean",
            null = "lua_builder_null",
            close = "lua_builder_close",
            keyScratch = "lua_builder_key_scratch",
            stringScratch = "lua_builder_string_scratch",
            keyEscapes = "lua_builder_key_escapes",
            stringEscapes = "lua_builder_string_escapes",
        }
        local operation = operations[tostring(action)]
        if operation ~= nil then
            if #args < 1 or args[1].type ~= "lua_builder" or args[1].op ~= "local" then
                context.reject(lower.site(node), "valuebuilder event needs one local builder")
            end
            local event = new scalarIR.LuaBuild(
                op = operation as any,
                builder = args[1],
                mode = (args[1] as scalarIR.Name).builderMode as any,
                type = "lua_effect",
                source = lower.site(node)
            )
            if action == "openArray" or action == "openObject" then
                if #args ~= 2 or args[2].type ~= "u32" then
                    context.reject(lower.site(node), "valuebuilder container opening needs a uint32 capacity")
                end
                event.capacity = args[2]
            elseif action == "key" or action == "string" then
                if #args ~= 5 or args[
                    2
                ].type ~= "lua_string" and args[
                    2
                ].type ~= "lua_bytes" or args[
                    2
                ].op ~= "local" or args[3].type ~= "u32" or args[4].type ~= "u32" or args[5].type ~= "bool" then
                    context.reject(lower.site(node), "valuebuilder string event has invalid arguments")
                end
                event.sourceBytes, event.start, event.length, event.escaped = args[2], args[3], args[4], args[5]
            elseif action == "keyScratch" or action == "stringScratch" then
                if #args ~= 4 or args[
                    2
                ].type ~= "lua_scratch_u8" or args[
                    2
                ].op ~= "local" or args[3].type ~= "u32" or args[4].type ~= "u32" then
                    context.reject(lower.site(node), "valuebuilder scratch string event has invalid arguments")
                end
                event.scratch, event.start, event.length = args[2], args[3], args[4]
            elseif action == "keyEscapes" or action == "stringEscapes" then
                if #args ~= 7 or args[
                    2
                ].type ~= "lua_string" and args[
                    2
                ].type ~= "lua_bytes" or args[
                    2
                ].op ~= "local" or args[
                    3
                ].type ~= "u32" or args[
                    4
                ].type ~= "u32" or args[
                    5
                ].type ~= "lua_scratch_u32" or args[
                    5
                ].op ~= "local" or args[6].type ~= "u32" or args[7].type ~= "u32" then
                    context.reject(lower.site(node), "valuebuilder indexed escape event has invalid arguments")
                end
                event.sourceBytes, event.start, event.length = args[2], args[3], args[4]
                event.escapeScratch, event.escapeIndex, event.escapeCount = args[5], args[6], args[7]
            elseif action == "numberSlice" or action == "integerSlice" then
                if #args ~= 4 or args[
                    2
                ].type ~= "lua_string" and args[
                    2
                ].type ~= "lua_bytes" or args[2].op ~= "local" or args[3].type ~= "u32" or args[4].type ~= "u32" then
                    context.reject(lower.site(node), "valuebuilder number slice has invalid arguments")
                end
                event.sourceBytes, event.start, event.length = args[2], args[3], args[4]
            elseif action == "number" then
                if #args ~= 2 or args[2].type ~= "f64" then
                    context.reject(lower.site(node), "valuebuilder.number takes one number")
                end
                event.value = args[2]
            elseif action == "integer64" then
                if #args ~= 3 or args[2].type ~= "u64" or args[3].type ~= "bool" then
                    context.reject(lower.site(node), "valuebuilder.integer64 takes a uint64 magnitude and sign")
                end
                event.value, event.negative = args[2], args[3]
            elseif action == "decimal64" then
                if #args ~= 8 or args[
                    2
                ].type ~= "lua_string" and args[
                    2
                ].type ~= "lua_bytes" or args[
                    2
                ].op ~= "local" or args[
                    3
                ].type ~= "u32" or args[
                    4
                ].type ~= "u32" or args[
                    5
                ].type ~= "u64" or args[6].type ~= "i32" or args[7].type ~= "bool" or args[8].type ~= "bool" then
                    context.reject(
                        lower.site(node),
                        "valuebuilder.decimal64 takes a source slice, uint64 magnitude, int32 exponent, sign, and exactness"
                    )
                end
                event.sourceBytes, event.start, event.length = args[2], args[3], args[4]
                event.value, event.exponent, event.negative, event.exact = args[5], args[6], args[7], args[8]
            elseif action == "boolean" then
                if #args ~= 2 or args[2].type ~= "bool" then
                    context.reject(lower.site(node), "valuebuilder.boolean takes one boolean")
                end
                event.value = args[2]
            elseif #args ~= 1 then
                context.reject(lower.site(node), "valuebuilder event takes only its builder")
            end
            markLua(kernel, lower.site(node))
            return event
        end
    end
    if identity == "table.new"
        or path == "table.new"
        and kernel.modules.table == "@prelude.table"
        and environment.table == nil
    then
        if #args ~= 2 then
            context.reject(lower.site(node), "table.new in an AOT builder takes array and hash capacities")
        end
        for _, capacity in ipairs(args) do
            if capacity.type ~= "f64" and capacity.type ~= "i32" and capacity.type ~= "u32" then
                context.reject(lower.site(node), "table.new capacities must be numeric")
            end
        end
        markLua(kernel, lower.site(node))

        return new scalarIR.LuaNewTable(
            op = "lua_new_table",
            arrayCapacity = args[1],
            hashCapacity = args[2],
            type = "lua_table",
            source = lower.site(node)
        )
    end
    -- The checker follows definitions through local aliases and publishes the
    -- canonical fixed-width identity on the call. A spelling lookup remains
    -- only for the standalone parser harness; production lowering must not
    -- turn `local add = nupp.math.u32.add` into an unrelated helper call.
    local fixedIdentity = (node as any).scalarIntrinsic
    local fixed = fixedIdentity ~= nil and admit.FIXED[
        fixedIdentity as string
    ] or not context.checked and path ~= nil and admit.fixed(path as string) or nil
    if fixed ~= nil then
        return fixedCall(node, path or tostring(fixedIdentity), fixed as admit.Fixed, args, kernel)
    end

    local intrinsic = path ~= nil and admit.math(path as string) or nil
    if intrinsic ~= nil then
        return mathCall(node, path as string, intrinsic as admit.Math, args, kernel)
    end

    local helperName = lower.nameOf(node.obj)
    if helperName == nil then
        context.reject(lower.site(node), "call target " .. tostring(path) .. " is not an admitted intrinsic or helper")
    end

    local helper = lower.helper(helperName as string, node, kernel)
    if #args ~= #helper.params then
        context.reject(lower.site(node), "native helper argument count does not match")
    end
    for position, argument in ipairs(args) do
        args[position] = lower.helperArgument(argument, helper.params[position].type, lower.site(node), context)
    end

    return new scalarIR.HelperCall(
        op = "helper_call",
        helper = helper.name,
        cName = helper.cName,
        args = args,
        type = #helper.resultTypes == 1 and helper.resultType or "multi",
        resultTypes = helper.resultTypes,
        source = lower.site(node)
    )
end

--- The packed element identity of one struct field, as `genericSimdSpanElement`
--- gives it for a span: narrow storage keeps its physical width.
local function genericSimdFieldElement(field: scalarIR.Field): string
    local physical: {
        [string]: string
    } = {
        int8 = "i8",
        uint8 = "u8",
        int16 = "i16",
        uint16 = "u16",
        float = "f32",
        int32 = "i32",
        uint32 = "u32",
        int64 = "i64",
        uint64 = "u64",
        number = "f64",
    }

    return physical[field.sourceType or ""] or field.type
end

--- A masked reducer contribution: `fold:add(v, m)` inside a `do` block,
--- which becomes the region accumulating the reducer. Every active lane of
--- `v` contributes in ascending lane order.
local function maskedContribution(
    node: cst.MethodCall,
    receiver: scalarIR.Expr,
    reducerState: lower.ReducerState,
    reducerOrder: string,
    reducerOperation: string,
    reducerElement: string?,
    raw: {cst.Node},
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    local scope = kernel.simdDo
    if scope == nil or kernel.simdSource == true then
        context.reject(source, "a masked reducer contribution belongs inside a do block, which is its region")
    end
    local region = (scope as lower.SimdDo).region
    if reducerState.finalized then
        context.reject(source, "a finalized reducer cannot receive another contribution")
    end
    if reducerState.region ~= nil and reducerState.region ~= region then
        context.reject(source, "a reducer is scoped to exactly one region")
    end
    local value = lower.expression(raw[1], environment, activeIndex, kernel)
    local family, element, shape = genericSimdParts(value.type)
    local scalar = reducerElement or "f64"
    if family ~= "vector" or genericSimdScalar(element) ~= scalar then
        context.reject(source, "a masked reducer contribution takes a vector whose element the reducer accumulates")
    end
    local maskType = "simd_mask_" .. tostring(element) .. "_" .. tostring(shape)
    local right: scalarIR.Expr? = nil
    if reducerOperation == "dot" then
        right = lower.expression(raw[2], environment, activeIndex, kernel)
        if (right as scalarIR.Expr).type ~= value.type then
            context.reject(source, "a masked dot contribution takes two vectors of one species")
        end
    end
    local mask = lower.expression(raw[#raw], environment, activeIndex, kernel)
    if mask.type ~= maskType then
        context.reject(source, "a masked reducer contribution takes the mask of its vector's species")
    end
    reducerState.region = region
    local byName = (scope as lower.SimdDo).byName
    if byName[reducerState.name] ~= true then
        byName[reducerState.name] = true
        local reducers = (scope as lower.SimdDo).reducers
        reducers[
            #reducers + 1
        ] = new scalarIR.SimdRegionReducer(
            name = reducerState.name,
            cName = reducerState.cName,
            order = reducerOrder as any,
            operation = reducerOperation as any,
            element = reducerElement,
            vectorType = value.type
        )
    end

    return new scalarIR.SimdReducerAdd(
        op = "simd_reducer_add",
        reducer = receiver,
        value = value,
        mask = mask,
        right = right,
        order = reducerOrder as any,
        operation = reducerOperation as any,
        element = reducerElement,
        type = "lua_effect",
        source = source
    )
end

--- The binary32 operations the prelude corrects lane by lane rather than
--- computing in binary64, and how many operands each takes. The verifier reads
--- a `simd_call` naming one of these as carrying no compiled helper.
const CORRECTED_LANES = {["f32_min"] = 2, ["f32_max"] = 2, ["f32_fma"] = 3,}

--- `s:map(f, v...)`: one scalar call per lane over vector locals: a closed-set
--- math operation, a binary32 correction, or a pure helper of the element's
--- scalar type.
local function laneWiseMap(
    node: cst.MethodCall,
    raw: {cst.Node},
    vectorType: string,
    element: scalarIR.Type,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    local scalar = genericSimdScalar(element)
    local args: {scalarIR.Expr} = {}
    for position = 2, #raw do
        local operand = lower.expression(raw[position], environment, activeIndex, kernel)
        if operand.op ~= "local" or operand.type ~= vectorType then
            context.reject(source, "SIMD map operands must be locals of the species")
        end
        args[#args + 1] = operand
    end
    local path = lower.dottedName(raw[1])
    local intrinsic = path ~= nil and admit.math(path as string) or nil
    if intrinsic ~= nil then
        local math = intrinsic as admit.Math
        if element ~= "f32" and element ~= "f64" then
            context.reject(source, "SIMD map applies a math operation to a floating species")
        end
        if #args < math.min or math.max ~= nil and #args > (math.max as integer) then
            context.reject(source, tostring(path) .. " has an unsupported argument count")
        end
        return new scalarIR.Simd(
            op = "simd_math",
            args = args,
            intrinsic = math.name,
            type = vectorType,
            source = source
        )
    end
    -- The three binary32 operations the prelude corrects rather than computes
    -- in binary64: they are already applied one lane at a time when the `@simd`
    -- rewrite reaches one, so the same spelling names them here.
    local corrected = path ~= nil and admit.fixed(path as string) or nil
    if corrected ~= nil and CORRECTED_LANES[tostring((corrected as admit.Fixed).op)] ~= nil then
        local fixed = corrected as admit.Fixed
        if element ~= "f32" then
            context.reject(source, "SIMD map applies a binary32 correction to a binary32 species")
        end
        if #args ~= fixed.arity then
            context.reject(source, tostring(path) .. " has an unsupported argument count")
        end

        return new scalarIR.Simd(
            op = "simd_call",
            args = args,
            intrinsic = tostring(fixed.op),
            type = vectorType,
            source = source
        )
    end
    local helperName = lower.nameOf(raw[1])
    if helperName == nil then
        context.reject(source, "SIMD map applies a math operation, a binary32 correction, or a visible pure helper")
    end
    local helper = lower.helper(helperName as string, node, kernel)
    -- A helper takes and returns ordinary Nupp values, so a float species
    -- calls one over binary64 and narrows what comes back.
    local carrier = scalar == "f32" and "f64" or scalar
    if #helper.params ~= #args or #helper.resultTypes ~= 1 or helper.resultType ~= carrier then
        context.reject(source, "SIMD map needs a helper over the species' scalar taking one argument per vector")
    end
    for _, param in ipairs(helper.params) do
        if param.type ~= carrier then
            context.reject(source, "SIMD map needs a helper over the species' scalar taking one argument per vector")
        end
    end

    return new scalarIR.Simd(
        op = "simd_call",
        args = args,
        intrinsic = "map",
        helper = helper.name,
        type = vectorType,
        source = source
    )
end

--- `s:load(span, i, "field"[, m])` and `s:store(span, i, "field", v[, m])`:
--- one field of every struct in a run of the span, strided by the struct.
local function fieldAccess(
    node: cst.MethodCall,
    receiver: scalarIR.Expr,
    reading: boolean,
    spanName: string?,
    span: scalarIR.Param?,
    raw: {cst.Node},
    vectorType: string,
    maskType: string,
    element: scalarIR.Type,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    local method = reading and "load" or "store"
    local wantedKind = reading and "read_span" or "write_span"
    local layoutName = span ~= nil and span.type:match("^struct:(.+)$") or nil
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if span == nil or span.kind ~= wantedKind or layout == nil then
        context.reject(
            source,
            "SIMD field " .. method .. " needs a matching " .. (
                reading and "borrowed Span" or "exclusive WriteSpan"
            ) .. " of a reified struct"
        )
    end
    local expected = reading and (#raw == 3 or #raw == 4) or not reading and (#raw == 4 or #raw == 5)
    if not expected then
        context.reject(source, "SIMD field " .. method .. " has an unsupported argument count")
    end
    local token = (raw[3] as cst.StringLit).token
    local written = token ~= nil and (token as lexer.Token).text or ""
    local fieldName = written:match('^"(.*)"$') or written:match("^'(.*)'$") or ""
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == fieldName then
            field = candidate
        end
    end
    if field == nil then
        context.reject(source, "struct " .. tostring(layoutName) .. " has no field " .. fieldName)
    end
    if genericSimdFieldElement(field as scalarIR.Field) ~= element then
        context.reject(source, "SIMD field " .. method .. " needs a field of the species' element")
    end
    local offset = lower.convert(lower.expression(raw[2], environment, activeIndex, kernel), "f64", source, context)
    local maskPosition = reading and 4 or 5
    local masked = raw[maskPosition] ~= nil
    local cursor = not masked and provedCursor(lower.unwrapped(raw[2]), spanName, kernel, receiver.type) or nil
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    local cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil
    local args: {scalarIR.Expr} = {receiver, offset}
    if not reading then
        local stored = lower.expression(raw[4], environment, activeIndex, kernel)
        if stored.type ~= vectorType then
            context.reject(source, "SIMD store value has a different element or species type")
        end
        args[#args + 1] = stored
    end
    if masked then
        local active = lower.expression(raw[maskPosition], environment, activeIndex, kernel)
        if active.type ~= maskType then
            context.reject(source, "SIMD " .. method .. " mask has a different species")
        end
        args[#args + 1] = active
    end

    return new scalarIR.Simd(
        op = reading and "simd_field_load" or "simd_field_store",
        args = args,
        span = spanName,
        layout = layoutName as string,
        field = fieldName,
        intrinsic = "field",
        cursor = cursor,
        cursorCName = cursorCName,
        type = reading and vectorType or "lua_effect",
        source = source
    )
end

--- `s:load(bytes, i[, m])` where `bytes` is `valuebuilder.bytes(source)`: the
--- same vector load, addressed through the pointer and length a rooted string
--- or buffer parameter already arrives with.
---
--- The view is not a value, so there is nothing to check about it here; what
--- is checked is the parameter it views, exactly as a rooted byte read checks
--- one. That parameter is what the node carries as its root, so the bounds
--- proof is the proof that guards `valuebuilder.byteAt` on the same bytes,
--- read a whole vector wide instead of one byte wide. Without that proof the
--- load keeps its count and clamps, which is what an ordinary span load
--- without a cursor does.
local function rootedLoad(
    node: cst.MethodCall,
    receiver: scalarIR.Expr,
    method: string,
    bytesName: string,
    raw: {cst.Node},
    vectorType: string,
    maskType: string,
    element: scalarIR.Type,
    receiverType: string,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    local source = lower.site(node)
    if method ~= "load" then
        context.reject(source, "a rooted byte view is read-only, so only a load may name one")
    end
    if element ~= "u8" then
        context.reject(source, "a rooted byte view carries bytes, so only a uint8 species may load from it")
    end
    -- The binding named the parameter, and only `localStmt` writes one, but the
    -- load addresses the C names read back here rather than the ones that were
    -- checked there, so they are read off the parameter again.
    local param = kernel.params[bytesName]
    if param == nil or param.kind ~= "scalar" or param.type ~= "lua_string" and param.type ~= "lua_bytes" then
        context.reject(source, "SIMD rooted loads require a rooted string parameter")
    end
    local rooted = new scalarIR.Name(
        op = "local",
        name = bytesName,
        type = param.type,
        cName = param.cName,
        source = source
    )
    local offset = lower.convert(lower.expression(raw[2], environment, activeIndex, kernel), "f64", source, context)
    local masked = raw[3] ~= nil
    local cursor = not masked and provedCursor(lower.unwrapped(raw[2]), bytesName, kernel, receiverType) or nil
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    local args: {scalarIR.Expr} = {receiver, offset}
    if masked then
        local active = lower.expression(raw[3], environment, activeIndex, kernel)
        if active.type ~= maskType then
            context.reject(source, "SIMD load mask has a different species")
        end
        args[#args + 1] = active
    end
    markLua(kernel, source)

    return new scalarIR.Simd(
        op = "simd_load",
        args = args,
        span = bytesName,
        rooted = rooted as scalarIR.Name,
        intrinsic = "load",
        cursor = cursor,
        cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil,
        type = vectorType,
        source = source
    )
end

--- One operation on a source-visible AOT-only SIMD value.
local function simdMethod(
    node: cst.MethodCall,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr?
    local receiverName = lower.nameOf(node.obj)
    local binding = receiverName ~= nil and environment[receiverName as string] or nil
    local receiver: scalarIR.Expr? = nil
    local receiverType = binding ~= nil and binding.type or ""
    if binding == nil and node.obj ~= nil then
        receiver = lower.expression(node.obj as cst.Node, environment, activeIndex, kernel)
        receiverType = (receiver as scalarIR.Expr).type
    end
    if not tostring(receiverType):match("^simd_") then
        return nil
    end

    local method = node.name ~= nil and (node.name as lexer.Token).text or ""
    local raw = node.args ~= nil and (node.args as cst.Args).exprs or {}
    receiver = receiver or lower.expression(node.obj as cst.Node, environment, activeIndex, kernel)
    local args: {scalarIR.Expr} = {receiver as scalarIR.Expr}
    local source = lower.site(node)
    kernel.usesSimd = true

    local reducerOrder, reducerOperation = tostring(receiverType):match("^simd_reducer_(%a+)_(%a+)$")
    local exactOrder, exactOperation, reducerElement = reducers.parse(tostring(receiverType))
    if exactOrder ~= nil then
        reducerOrder, reducerOperation = exactOrder, exactOperation
    end
    if reducerOrder ~= nil and (
        reducerElement ~= nil or reducerOperation == "sum" or reducerOperation == "product" or reducerOperation == "dot"
    ) then
        if receiver == nil or (receiver as scalarIR.Expr).op ~= "local" then
            kernel.context.reject(source, "a reducer operation must name its scoped reducer binding")
        end
        local reducerName = (receiver as scalarIR.Name).cName
        if reducerName == nil then
            kernel.context.reject(source, "a reducer operation must name its scoped reducer binding")
        end
        local reducerState = kernel.reducers[reducerName as string]
        if reducerState == nil then
            kernel.context.reject(source, "a reducer cannot be copied or passed through another value")
        end
        local contributionMethod = reducers.method(reducerOperation as string)
        local argumentCount = reducerOperation == "dot" and 2 or 1
        if method == contributionMethod and #raw == argumentCount + 1 then
            return maskedContribution(
                node,
                receiver as scalarIR.Expr,
                reducerState as lower.ReducerState,
                reducerOrder as string,
                reducerOperation as string,
                reducerElement,
                raw,
                environment,
                activeIndex,
                kernel
            )
        elseif method == contributionMethod and #raw == argumentCount then
            if kernel.simdSource ~= true or kernel.simdRegion == nil then
                kernel.context.reject(source, "a reducer contribution belongs directly inside one @simd loop")
            end
            if (reducerState as lower.ReducerState).finalized then
                kernel.context.reject(source, "a finalized reducer cannot receive another contribution")
            end
            local region = (reducerState as lower.ReducerState).region
            if region ~= nil and region ~= kernel.simdRegion then
                kernel.context.reject(source, "a reducer is scoped to exactly one @simd loop")
            end
            (reducerState as lower.ReducerState).region = kernel.simdRegion
            local right: scalarIR.Expr? = nil
            if reducerOperation == "dot" then
                right = lower.convert(
                    lower.expression(raw[2], environment, activeIndex, kernel),
                    reducerElement or "f64",
                    source,
                    kernel.context
                )
            end
            return new scalarIR.ReducerAdd(
                op = "reducer_add",
                reducer = receiver as scalarIR.Expr,
                value = lower.convert(
                    lower.expression(raw[1], environment, activeIndex, kernel),
                    reducerElement or "f64",
                    source,
                    kernel.context
                ),
                right = right,
                order = reducerOrder as any,
                operation = reducerOperation as any,
                type = "lua_effect",
                source = source
            )
        elseif method == "value" and #raw == 0 then
            if kernel.simdSource == true then
                kernel.context.reject(source, "a reducer is finalized after its @simd loop")
            end
            if (reducerState as lower.ReducerState).region == nil then
                kernel.context.reject(source, "a reducer must receive its contribution before it is finalized")
            end
            if (reducerState as lower.ReducerState).finalized then
                kernel.context.reject(source, "a reducer is finalized exactly once")
            end
            (reducerState as lower.ReducerState).finalized = true
            return new scalarIR.ReducerValue(
                op = "reducer_value",
                reducer = receiver as scalarIR.Expr,
                order = reducerOrder as any,
                operation = reducerOperation as any,
                type = reducerElement ~= nil and reducers.result(reducerOperation as string, reducerElement) or "f64",
                source = source
            )
        end
        kernel.context.reject(source, reducerOperation .. " reducer operation " .. method .. " is not admitted")
    end

    local genericFamily, genericElement, genericShape = genericSimdParts(receiverType)
    if genericFamily ~= nil then
        local vectorType = "simd_vector_" .. tostring(genericElement) .. "_" .. tostring(genericShape)
        local maskType = "simd_mask_" .. tostring(genericElement) .. "_" .. tostring(genericShape)
        if genericFamily == "species" and method == "mask" and #raw == 1 then
            -- A boolean broadcasts to every lane; another species' mask
            -- converts lane for lane, which needs the same lane count.
            local value = lower.expression(raw[1], environment, activeIndex, kernel)
            if value.type == "bool" then
                return new scalarIR.Simd(
                    op = "simd_mask_splat",
                    args = {value},
                    intrinsic = "mask",
                    type = maskType,
                    source = source
                )
            end
            local fromFamily, fromElement, fromShape = genericSimdParts(value.type)
            if fromFamily ~= "mask" then
                kernel.context.reject(source, "SIMD mask takes a boolean or a mask of another species")
            end
            if fromShape ~= genericShape
                or fromShape == "preferred"
                and tostring(fromElement):match("%d+") ~= tostring(genericElement):match("%d+") then
                kernel.context.reject(source, "SIMD mask conversion requires matching logical lane counts")
            end
            return new scalarIR.Simd(
                op = "simd_mask_convert",
                args = {value},
                intrinsic = "mask",
                type = maskType,
                source = source
            )
        elseif genericFamily == "species" and method == "map" and #raw >= 2 then
            return laneWiseMap(node, raw, vectorType, genericElement as scalarIR.Type, environment, activeIndex, kernel)
        elseif genericFamily == "species" and method == "splat" and #raw == 1 then
            local value = lower.convert(
                lower.expression(raw[1], environment, activeIndex, kernel),
                genericSimdScalar(genericElement) as scalarIR.Type,
                source,
                kernel.context
            )
            return new scalarIR.Simd(
                op = "simd_splat",
                args = {value},
                intrinsic = "splat",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "species" and (method == "convert" or method == "reinterpret") and #raw == 1 then
            local value = lower.expression(raw[1], environment, activeIndex, kernel)
            if not simdcast.matches(value.type, vectorType, method == "reinterpret") then
                kernel.context.reject(
                    source,
                    "SIMD " .. method .. " requires matching logical lane counts" .. (
                        method == "reinterpret"
                        and " and equal element widths"
                        or "; use Fixed<N> when changing element width"
                    )
                )
            end
            return new scalarIR.Simd(
                op = method == "convert" and "simd_convert" or "simd_reinterpret",
                args = {value},
                intrinsic = method,
                type = vectorType,
                source = source
            )
        elseif genericFamily == "species" and method == "iota" and #raw == 2 then
            for _, argument in ipairs(raw) do
                args[
                    #args + 1
                ] = lower.convert(
                    lower.expression(argument, environment, activeIndex, kernel),
                    genericSimdScalar(genericElement) as scalarIR.Type,
                    source,
                    kernel.context
                )
            end
            return new scalarIR.Simd(
                op = "simd_iota",
                args = {args[2], args[3]},
                intrinsic = "iota",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "species" and method == "tail" and #raw == 1 then
            local active = lower.convert(
                lower.expression(raw[1], environment, activeIndex, kernel),
                "u32",
                source,
                kernel.context
            )
            return new scalarIR.Simd(
                op = "simd_tail",
                args = {active},
                intrinsic = "tail",
                type = maskType,
                source = source
            )
        elseif genericFamily == "species" and (
            method == "load"
            or method == "store"
            or method == "gather"
            or method == "scatter"
            or method == "scatterUnchecked"
        ) then
            local reading = method == "load" or method == "gather"
            local indexed = method == "gather" or method == "scatter" or method == "scatterUnchecked"
            local named = not indexed and raw[3] ~= nil and raw[3].kind == "string"
            local expected = reading and (#raw == 2 or #raw == 3) or not reading and (#raw == 3 or #raw == 4)
            if named then
                expected = reading and (#raw == 3 or #raw == 4) or not reading and (#raw == 4 or #raw == 5)
            end
            if not expected then
                kernel.context.reject(source, "SIMD " .. method .. " has an unsupported argument count")
            end
            local spanName = lower.nameOf(raw[1])
            local rootedBinding = spanName ~= nil and environment[spanName as string] or nil
            if rootedBinding ~= nil and rootedBinding.kind == "rooted_span" then
                return rootedLoad(
                    node,
                    receiver as scalarIR.Expr,
                    method,
                    tostring(rootedBinding.bytes),
                    raw,
                    vectorType,
                    maskType,
                    genericElement as scalarIR.Type,
                    receiverType,
                    environment,
                    activeIndex,
                    kernel
                )
            end
            local span = spanName ~= nil and kernel.params[spanName as string] or nil
            local wantedKind = reading and "read_span" or "write_span"
            if named then
                return fieldAccess(
                    node,
                    receiver as scalarIR.Expr,
                    reading,
                    spanName,
                    span as scalarIR.Param?,
                    raw,
                    vectorType,
                    maskType,
                    genericElement as scalarIR.Type,
                    environment,
                    activeIndex,
                    kernel
                )
            end
            if span == nil or span.kind ~= wantedKind or genericSimdSpanElement(
                span as scalarIR.Param
            ) ~= genericElement then
                kernel.context.reject(
                    source,
                    "SIMD " .. method .. " needs a matching " .. (reading and "borrowed Span" or "exclusive WriteSpan")
                )
            end
            local offset = lower.expression(raw[2], environment, activeIndex, kernel)
            if indexed then
                if not simdindices.matches(offset.type, receiverType) then
                    kernel.context.reject(
                        source,
                        "SIMD indexed memory needs 32-bit or 64-bit integer indices with the same logical lane count"
                    )
                end
                if not reading and kernel.simdSource == true then
                    kernel.context.reject(
                        source,
                        "SIMD scatter does not prove disjoint destinations between @simd iterations"
                    )
                end
                if method == "scatter" and not simdindices.unique(offset) then
                    kernel.context.reject(
                        source,
                        "SIMD scatter needs provably unique indices; scatterUnchecked explicitly asserts uniqueness without a runtime check"
                    )
                end
            else
                offset = lower.convert(offset, "f64", source, kernel.context)
            end
            -- An unmasked access at `cursor + 1` under a dominating `cursor +
            -- s.lanes <= #span` is a whole vector inside the span: it carries
            -- the cursor so the verifier can hold that and the emitter can
            -- copy without checking any lane. A masked one keeps its mask.
            local masked = raw[reading and 3 or 4] ~= nil
            local cursor = not indexed and not masked and provedCursor(
                lower.unwrapped(raw[2]),
                spanName,
                kernel,
                tostring(receiverType)
            ) or nil
            local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
            local cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil
            if reading then
                local loadArgs: {scalarIR.Expr} = {receiver as scalarIR.Expr, offset}
                if raw[3] ~= nil then
                    local active = lower.expression(raw[3], environment, activeIndex, kernel)
                    if active.type ~= maskType then
                        kernel.context.reject(source, "SIMD load mask has a different species")
                    end
                    loadArgs[#loadArgs + 1] = active
                end
                return new scalarIR.Simd(
                    op = "simd_load",
                    args = loadArgs,
                    span = spanName,
                    intrinsic = method,
                    cursor = cursor,
                    cursorCName = cursorCName,
                    type = vectorType,
                    source = source
                )
            else
                local stored = lower.expression(raw[3], environment, activeIndex, kernel)
                if stored.type ~= vectorType then
                    kernel.context.reject(source, "SIMD store value has a different element or species type")
                end
                local storeArgs: {scalarIR.Expr} = {receiver as scalarIR.Expr, offset, stored}
                if raw[4] ~= nil then
                    local active = lower.expression(raw[4], environment, activeIndex, kernel)
                    if active.type ~= maskType then
                        kernel.context.reject(source, "SIMD store mask has a different species")
                    end
                    storeArgs[#storeArgs + 1] = active
                end
                return new scalarIR.Simd(
                    op = "simd_store",
                    args = storeArgs,
                    span = spanName,
                    intrinsic = method,
                    cursor = cursor,
                    cursorCName = cursorCName,
                    type = "lua_effect",
                    source = source
                )
            end
        elseif genericFamily == "mask" and method == "select" and #raw == 2 then
            local trueValue = simdOperand(
                lower.expression(raw[1], environment, activeIndex, kernel),
                vectorType,
                source,
                kernel
            )
            local falseValue = simdOperand(
                lower.expression(raw[2], environment, activeIndex, kernel),
                vectorType,
                source,
                kernel
            )
            return new scalarIR.Simd(
                op = "simd_select",
                args = {receiver as scalarIR.Expr, trueValue, falseValue},
                intrinsic = "select",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and method == "extract" and #raw == 1 then
            local laneIndex = lower.convert(
                lower.expression(raw[1], environment, activeIndex, kernel),
                "f64",
                source,
                kernel.context
            )
            local constantLane = laneIndex.op == "constant" and tonumber((laneIndex as scalarIR.Constant).value) or nil
            if constantLane == nil or constantLane < 1 or constantLane % 1 ~= 0 then
                kernel.context.reject(source, "SIMD lane extraction needs a positive compile-time lane index")
            end
            return new scalarIR.Simd(
                op = "simd_extract",
                args = {receiver as scalarIR.Expr, laneIndex},
                intrinsic = "extract",
                type = genericSimdScalar(genericElement) as scalarIR.Type,
                source = source
            )
        elseif genericFamily == "vector" and method == "insert" and #raw == 2 then
            local laneIndex = lower.convert(
                lower.expression(raw[1], environment, activeIndex, kernel),
                "f64",
                source,
                kernel.context
            )
            local constantLane = laneIndex.op == "constant" and tonumber((laneIndex as scalarIR.Constant).value) or nil
            if constantLane == nil or constantLane < 1 or constantLane % 1 ~= 0 then
                kernel.context.reject(source, "SIMD lane insertion needs a positive compile-time lane index")
            end
            return new scalarIR.Simd(
                op = "simd_insert",
                args = {
                    receiver as scalarIR.Expr,
                    laneIndex,
                    lower.convert(
                        lower.expression(raw[2], environment, activeIndex, kernel),
                        genericSimdScalar(genericElement) as scalarIR.Type,
                        source,
                        kernel.context
                    ),
                },
                intrinsic = "insert",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and (method == "interleave" or method == "deinterleave") and #raw == 1 then
            return lower.rearrange(
                method,
                {receiver as scalarIR.Expr, lower.expression(raw[1], environment, activeIndex, kernel)},
                source,
                kernel
            )
        elseif genericFamily == "vector" and method == "reverse" and #raw == 0 then
            return new scalarIR.Simd(
                op = "simd_permute",
                args = {receiver as scalarIR.Expr},
                intrinsic = "reverse",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and (method == "rotateLeft" or method == "rotateRight") and #raw == 1 then
            local count = lower.convert(
                lower.expression(raw[1], environment, activeIndex, kernel),
                "f64",
                source,
                kernel.context
            )
            local constant = count.op == "constant" and tonumber((count as scalarIR.Constant).value) or nil
            if constant == nil or constant < 0 or constant % 1 ~= 0 then
                kernel.context.reject(source, "SIMD rotation needs a nonnegative compile-time lane count")
            end
            return new scalarIR.Simd(
                op = "simd_permute",
                args = {receiver as scalarIR.Expr, count},
                intrinsic = method == "rotateLeft" and "rotate_left" or "rotate_right",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and method == "align" and #raw == 2 then
            local previous = lower.expression(raw[1], environment, activeIndex, kernel)
            if previous.type ~= vectorType then
                kernel.context.reject(source, "SIMD align operands need the same element and species")
            end
            local count = lower.convert(
                lower.expression(raw[2], environment, activeIndex, kernel),
                "f64",
                source,
                kernel.context
            )
            local constant = count.op == "constant" and tonumber((count as scalarIR.Constant).value) or nil
            if constant == nil or constant < 0 or constant % 1 ~= 0 then
                kernel.context.reject(source, "SIMD alignment needs a nonnegative compile-time lane count")
            end
            return new scalarIR.Simd(
                op = "simd_permute",
                args = {previous, receiver as scalarIR.Expr, count},
                intrinsic = "align",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and VECTOR_EXTREMA[method] ~= nil and #raw == 1 then
            local other = lower.expression(raw[1], environment, activeIndex, kernel)
            local otherFamily, otherElement, otherShape = genericSimdParts(other.type)
            if otherFamily == "vector" and (otherElement ~= genericElement or otherShape ~= genericShape) then
                kernel.context.reject(source, "explicit SIMD operands have different element or species identities")
            end
            return new scalarIR.Simd(
                op = "simd_binary",
                args = {receiver as scalarIR.Expr, simdOperand(other, vectorType, source, kernel)},
                intrinsic = VECTOR_EXTREMA[method],
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and method == "swizzle" and (#raw == 1 or #raw == 2) then
            local indices = lower.expression(raw[1], environment, activeIndex, kernel)
            if indices.type ~= vectorType then
                kernel.context.reject(source, "SIMD swizzle indices have a different element or species")
            end
            if tostring(genericElement):sub(1, 1) == "f" then
                kernel.context.reject(
                    source,
                    "SIMD swizzle reads its indices as lane numbers and needs an integer vector"
                )
            end
            local args: {scalarIR.Expr} = {receiver as scalarIR.Expr, indices}
            if #raw == 2 then
                local other = lower.expression(raw[2], environment, activeIndex, kernel)
                if other.type ~= vectorType then
                    kernel.context.reject(source, "SIMD swizzle operands have a different element or species")
                end
                args[3] = other
            end
            return new scalarIR.Simd(
                op = "simd_permute",
                args = args,
                intrinsic = #raw == 2 and "swizzle_pair" or "swizzle",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and (method == "compress" or method == "expand") and #raw == 1 then
            local selected = lower.expression(raw[1], environment, activeIndex, kernel)
            if selected.type ~= maskType then
                kernel.context.reject(source, "SIMD " .. method .. " mask has a different species")
            end
            return new scalarIR.Simd(
                op = method == "compress" and "simd_compress" or "simd_expand",
                args = {receiver as scalarIR.Expr, selected},
                intrinsic = method,
                type = vectorType,
                source = source
            )
        elseif genericFamily == "vector" and (method == "prefixSumOrdered" or method == "prefixXor") and #raw == 0 then
            if method == "prefixXor" and tostring(genericElement):sub(1, 1) == "f" then
                kernel.context.reject(source, "SIMD prefixXor requires an integer vector element")
            end
            return new scalarIR.Simd(
                op = "simd_prefix",
                args = {receiver as scalarIR.Expr},
                intrinsic = method == "prefixXor" and "prefix_xor" or "prefix_sum_ordered",
                type = vectorType,
                source = source
            )
        elseif genericFamily == "mask" and #raw == 0 then
            local reductions = {
                any = {op = "simd_mask_any", type = "bool"},
                all = {op = "simd_mask_all", type = "bool"},
                count = {op = "simd_mask_count", type = "u32"},
                first = {op = "simd_mask_first", type = "u32"},
                bits = {op = "simd_mask_bits", type = "u64"},
            }
            local reduction = reductions[method]
            if reduction ~= nil then
                return new scalarIR.Simd(
                    op = reduction.op as any,
                    args = {receiver as scalarIR.Expr},
                    intrinsic = method,
                    type = reduction.type,
                    source = source
                )
            end
        end
        kernel.context.reject(source, "SIMD operation " .. method .. " is not admitted for " .. receiverType)
    end

    --- The written argument at `position`, established as uint32.
    local function u32Arg(position: integer): scalarIR.Expr
        return lower.convert(
            lower.expression(raw[position], environment, activeIndex, kernel),
            "u32",
            source,
            kernel.context
        )
    end

    if receiverType == "simd_mask_bits64" then
        local binary64 = {
            add = "simd_mask64_add",
            andBits = "simd_mask64_and",
            orBits = "simd_mask64_or",
            xorBits = "simd_mask64_xor",
        }
        local binaryOp = binary64[method]
        if binaryOp ~= nil and #raw == 1 then
            local other = lower.expression(raw[1], environment, activeIndex, kernel)
            if other.type ~= "simd_mask_bits64" then
                kernel.context.reject(source, "64-bit mask operands need the same type")
            end
            args[2] = other
            return new scalarIR.Simd(op = binaryOp as any, args = args, type = "simd_mask_bits64", source = source)
        elseif method == "notBits" and #raw == 0 then
            return new scalarIR.Simd(op = "simd_mask64_not", args = args, type = "simd_mask_bits64", source = source)
        elseif (method == "shiftLeft" or method == "shiftRight") and #raw == 1 then
            args[2] = u32Arg(1)
            return new scalarIR.Simd(
                op = method == "shiftLeft" and "simd_mask64_shl" or "simd_mask64_shr",
                args = args,
                type = "simd_mask_bits64",
                source = source
            )
        elseif method == "prefixXor" and #raw == 1 then
            local carry = lower.expression(raw[1], environment, activeIndex, kernel)
            if carry.type ~= "bool" then
                kernel.context.reject(source, "64-bit mask prefixXor takes one boolean carry")
            end
            args[2] = carry
            return new scalarIR.Simd(
                op = "simd_mask64_prefix_xor",
                args = args,
                type = "simd_mask_bits64",
                source = source
            )
        elseif #raw == 0 then
            local reductions = {
                lowBits = {op = "simd_mask64_low", type = "u32"},
                highBits = {op = "simd_mask64_high", type = "u32"},
                any = {op = "simd_mask64_any", type = "bool"},
                count = {op = "simd_mask64_count", type = "u32"},
                firstSet = {op = "simd_mask64_first", type = "u32"},
                clearFirst = {op = "simd_mask64_clear_first", type = "simd_mask_bits64"},
            }
            local reduction = reductions[method]
            if reduction ~= nil then
                return new scalarIR.Simd(op = reduction.op as any, args = args, type = reduction.type, source = source)
            end
        end
        kernel.context.reject(
            source,
            "SIMD operation " .. method .. " with " .. tostring(
                #raw
            ) .. " arguments is not admitted for " .. receiverType
        )
    elseif receiverType == "simd_species_u8" and method == "splat" and #raw == 1 then
        args[2] = u32Arg(1)
        return new scalarIR.Simd(op = "simd_splat_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_species_u8" and method == "load" then
        if #raw ~= 2 then
            kernel.context.reject(source, "SIMD byte loads take a source and offset")
        end
        local spanName = #raw == 2 and lower.nameOf(raw[1]) or nil
        local span = spanName ~= nil and kernel.params[spanName as string] or nil
        if span == nil or span.kind ~= "read_span" or span.sourceType ~= "uint8" then
            kernel.context.reject(source, "SIMD byte loads require a borrowed Span<uint8>")
        end
        args[2] = u32Arg(2)

        return new scalarIR.Simd(
            op = "simd_load_u8",
            args = args,
            span = spanName,
            type = "simd_vector_u8",
            source = source
        )
    elseif receiverType == "simd_species_u8" and method == "loadString" then
        if #raw ~= 2 then
            kernel.context.reject(source, "SIMD rooted-string loads take a source and offset")
        end
        local bytes = lower.expression(raw[1], environment, activeIndex, kernel)
        if not rootedBytesParam(bytes, kernel) then
            kernel.context.reject(source, "SIMD rooted-string loads require a rooted string parameter")
        end
        args[2] = bytes
        args[3] = u32Arg(2)
        markLua(kernel, source)
        return new scalarIR.Simd(op = "simd_load_string_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_species_u8" and method == "tail" and #raw == 1 then
        args[2] = u32Arg(1)
        return new scalarIR.Simd(op = "simd_tail_u8", args = args, type = "simd_mask_u8", source = source)
    elseif receiverType == "simd_vector_u8" and (method == "equal" or method == "inRange") then
        local expected = method == "equal" and 1 or 2
        if #raw ~= expected then
            kernel.context.reject(source, "SIMD " .. method .. " has an unsupported argument count")
        end
        for _, argument in ipairs(raw) do
            args[
                #args + 1
            ] = lower.convert(
                lower.expression(argument, environment, activeIndex, kernel),
                "u32",
                source,
                kernel.context
            )
        end
        return new scalarIR.Simd(
            op = method == "equal" and "simd_eq_u8" or "simd_range_u8",
            args = args,
            type = "simd_mask_u8",
            source = source
        )
    elseif receiverType == "simd_vector_u8" and method == "shiftRight" and #raw == 1 then
        args[2] = u32Arg(1)
        return new scalarIR.Simd(op = "simd_shr_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_vector_u8" and method == "shiftLeft" and #raw == 1 then
        args[2] = u32Arg(1)
        return new scalarIR.Simd(op = "simd_shl_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_vector_u8" and method == "lookup16" and #raw == 1 then
        local tableValue = lower.expression(raw[1], environment, activeIndex, kernel)
        if tableValue.type ~= "simd_table_u8x16" then
            kernel.context.reject(source, "SIMD lookup16 takes one TableU8x16")
        end
        args[2] = tableValue
        return new scalarIR.Simd(op = "simd_lookup16_u8", args = args, type = "simd_vector_u8", source = source)
    end

    local binary = {andBits = "and", orBits = "or", xorBits = "xor"}
    local verb = binary[method]
    if verb ~= nil and #raw == 1 then
        local other = lower.expression(raw[1], environment, activeIndex, kernel)
        if other.type ~= receiverType then
            kernel.context.reject(source, "SIMD bitwise operands need the same type")
        end
        args[2] = other
        local family = receiverType == "simd_vector_u8" and "simd_vec_" or "simd_mask_"
        return new scalarIR.Simd(op = (family .. verb) as any, args = args, type = receiverType, source = source)
    elseif method == "notBits" and #raw == 0 then
        local op = receiverType == "simd_vector_u8" and "simd_vec_not" or "simd_mask_not"
        return new scalarIR.Simd(op = op as any, args = args, type = receiverType, source = source)
    elseif receiverType == "simd_mask_u8" and method == "select" and #raw == 2 then
        for _, argument in ipairs(raw) do
            local value = lower.expression(argument, environment, activeIndex, kernel)
            if value.type ~= "simd_vector_u8" then
                kernel.context.reject(source, "SIMD select values must be byte vectors")
            end
            args[#args + 1] = value
        end
        return new scalarIR.Simd(op = "simd_select_u8", args = args, type = "simd_vector_u8", source = source)
    elseif receiverType == "simd_mask_u8" and #raw == 0 then
        local reductions = {
            any = {op = "simd_any", type = "bool"},
            all = {op = "simd_all", type = "bool"},
            count = {op = "simd_count", type = "u32"},
            bits = {op = "simd_bits", type = "u32"},
        }
        local reduction = reductions[method]
        if reduction ~= nil then
            return new scalarIR.Simd(op = reduction.op as any, args = args, type = reduction.type, source = source)
        end
    end

    kernel.context.reject(source, "SIMD operation " .. method .. " is not admitted for " .. receiverType)

    return nil
end

--- One unary operator.
local function unary(node: cst.Unop, value: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    local written = (node.op as lexer.Token).text
    local source = lower.site(node)
    local family = genericSimdParts(value.type)
    if family == "vector" and (written == "-" or written == "~") or family == "mask" and written == "~" then
        return new scalarIR.Simd(
            op = "simd_unary",
            args = {value},
            intrinsic = written == "-" and "neg" or "not",
            type = value.type,
            source = source
        )
    end
    -- Negation is binary64 arithmetic like the binary operators, so a fixed-width
    -- or binary32 operand widens into it the same way `binary` promotes one.
    local negated = written == "-" and lower.conversion(value, "f64", value.source) or nil
    if negated ~= nil then
        return new scalarIR.Unary(op = "neg", value = negated as scalarIR.Expr, type = "f64", source = source)
    elseif written == "not" and value.type == "bool" then
        return new scalarIR.Unary(op = "not", value = value, type = "bool", source = source)
    elseif written == "~" and value.type == "u64" then
        return new scalarIR.FixedUnary(op = "u64_not", value = value, type = "u64", source = source)
    elseif written == "~" and bitOperand(value) then
        return new scalarIR.Unary(op = "bnot", value = value, type = "i32", source = source)
    end

    kernel.context.reject(source, "unary operator " .. tostring(written) .. " is not admitted for this type")

    return value
end

----------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------

--- The word count an expression names, where it is an exact non-negative
--- integer constant, and nil otherwise.
function lower.constantWidth(value: scalarIR.Expr): integer?
    local raw = value as any
    -- Through a width conversion, because that is how a literal capacity is
    -- written: `u32(64)` is `nupp.math.u32.wrap(64)`, which lowers to a cast of
    -- the constant. Casting an exact in-range integer answers that integer, so
    -- looking through the cast reads the same number the source wrote.
    while raw.op == "numeric_cast" or raw.op == "int_to_f64" do
        raw = raw.value
        if raw == nil then
            return nil
        end
    end
    if raw.op ~= "constant" and raw.op ~= "constant_i32" then
        return nil
    end
    local number = tonumber(raw.value)
    if number == nil or number % 1 ~= 0 or number < 0 or number > lower.UINT32_MAX then
        return nil
    end

    return number as integer
end

--- The bytes a name is bound to, where it is a `const` holding a string
--- literal, and nil otherwise.
---
--- Read off the checker's own answer rather than the optimizer's: folding is a
--- property of the optimization level, and whether a table can be a table is
--- not something that should move with `-O`.
---
--- A literal's constant is the string it denotes rather than the source that
--- spells it, so the bytes placed in static data are the bytes the program would
--- have read and this reader has nothing to decode.
function lower.constantString(node: cst.Node): string?
    local resolved = (node as any).inferredType
    if resolved == nil or resolved.tag ~= "literal" or (node as any).immutablePath ~= true then
        return nil
    end
    local base = resolved.base
    if base == nil or base.tag ~= "string" or type(resolved.constant) ~= "string" then
        return nil
    end

    return resolved.constant as string
end

--- A module-local immutable numeric literal, where the checker resolved one.
function lower.constantNumber(node: cst.Node): string?
    local resolved = (node as any).inferredType
    if resolved == nil or resolved.tag ~= "literal" or (node as any).immutablePath ~= true then
        return nil
    end
    local base = resolved.base
    if base == nil or base.tag ~= "number" or type(resolved.constant) ~= "number" then
        return nil
    end

    return tostring(resolved.constant)
end

--- One compile-time byte table, as the rooted-string name its readers expect.
function lower.constantBytes(value: string, kernel: lower.Kernel, source: scalarIR.Source?): scalarIR.Expr
    local shared = kernel.context.constantNames[value]
    if shared == nil then
        kernel.context.constantValues[#kernel.context.constantValues + 1] = value
        shared = ("konst_%d"):format(#kernel.context.constantValues - 1)
        kernel.context.constantNames[value] = shared
    end
    local existing = kernel.constantNames[value]
    if existing == nil then
        existing = shared as string
        kernel.constantNames[value] = existing
        kernel.constantOrder[
            #kernel.constantOrder + 1
        ] = new scalarIR.ConstantBytes(cName = existing as string, value = value)
    end

    return new scalarIR.Name(
        op = "local",
        name = existing as string,
        cName = existing as string,
        type = "lua_string",
        source = source
    )
end

----------------------------------------------------------------------------
-- Lowering one expression
----------------------------------------------------------------------------

--- A short-circuit left operand whose truth value proves the right operand's
--- cursor in bounds: `cursor < #span and span[cursor + 1] ...`, or the same
--- against a scratch's initialized length, and either turned around under
--- `or`; or `cursor + s.lanes <= #span and s:load(span, cursor + 1) ...`,
--- which proves a whole vector's room. The right operand only runs when the
--- left held, so what the left proves is what the right may rely on -- the
--- same fact a branch gets from its condition, reaching the one place a
--- condition is itself the consumer. Returns the cursor, the root it is
--- bounded against, and the room.
local function shortCircuitBound(
    connective: string,
    left: cst.Node?,
    environment: {[string]: any},
    kernel: lower.Kernel
): (string?, string?, string?)
    if left == nil or left.kind ~= "binop" then
        return nil, nil, nil
    end
    local comparison = left as cst.Binop
    if connective == "and" then
        local vectorCursor, vectorSpan, speciesType = laneBound(comparison, environment, kernel)
        if vectorCursor ~= nil then
            return vectorCursor, vectorSpan, speciesType
        end
    end
    local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
    if not (connective == "and" and written == "<" or connective == "or" and written == ">=") then
        return nil, nil, nil
    end
    local cursor = lower.nameOf(comparison.lhs)
    local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
    if cursorBinding == nil or cursorBinding.type ~= "u32" then
        return nil, nil, nil
    end
    local spanName = lower.dotCount(comparison.rhs)
    local param = spanName ~= nil and kernel.params[spanName as string] or nil
    if param ~= nil and param.region ~= nil then
        return cursor, spanName, scalarIR.ONE_ELEMENT
    end
    local lengthName = lower.nameOf(comparison.rhs)
    local scratchName = lengthName ~= nil and kernel.scratchLengthBounds[lengthName as string] or nil
    local scratchBinding = scratchName ~= nil and environment[scratchName as string] or nil
    if scratchBinding ~= nil and scratchBinding.type == "lua_scratch_u32" then
        return cursor, scratchName, scalarIR.ONE_ELEMENT
    end

    return nil, nil, nil
end

--- A compiler temporary is an ordinary IR local, visible to all later passes.
local function temporary(value: scalarIR.Expr, kernel: lower.Kernel, out: {scalarIR.Statement}): scalarIR.Name
    kernel.serial = kernel.serial + 1
    local name = "$value_" .. tostring(kernel.serial)
    local cName = "__nupp_value_" .. tostring(kernel.serial)
    local ref = new scalarIR.Name(op = "local", name = name, cName = cName, type = value.type, source = value.source)
    out[
        #out + 1
    ] = new scalarIR.Let(
        op = "let",
        name = name,
        cName = cName,
        type = value.type,
        value = value,
        source = value.source
    )

    return ref
end

--- Value blocks and switch arms consume exactly the first result.
local function firstValue(value: scalarIR.Expr, kernel: lower.Kernel, out: {scalarIR.Statement}): scalarIR.Expr
    if value.type ~= "multi" then
        return value
    end
    local call = value as scalarIR.HelperCall
    local bindings: {scalarIR.Binding} = {}
    for position, valueType in ipairs(call.resultTypes or {}) do
        if position > 1 then
            break
        end
        kernel.serial = kernel.serial + 1
        local suffix = tostring(kernel.serial)
        bindings[
            #bindings + 1
        ] = new scalarIR.Binding(
            kind = "local",
            name = "$first_" .. suffix,
            cName = "__nupp_first_" .. suffix,
            type = valueType
        )
    end
    if #bindings == 0 then
        kernel.context.reject(value.source, "a value expression needs at least one result")
    end
    out[#out + 1] = new scalarIR.MultiLet(op = "multi_let", call = call, bindings = bindings, source = value.source)
    local first = bindings[1]

    return new scalarIR.Name(
        op = "local",
        name = first.name,
        cName = first.cName,
        type = first.type,
        source = value.source
    )
end

local function joinedType(
    left: scalarIR.Type?,
    right: scalarIR.Type,
    at: scalarIR.Source?,
    context: lower.Context
): scalarIR.Type
    if left == nil or left == right then
        return right
    end
    local ordinary = {f64 = true, f32 = true, i32 = true, u32 = true}
    if ordinary[left as string] and ordinary[right] then
        return "f64"
    end
    context.reject(at, "native expression results need a common scalar representation")

    return right
end

local function neverExpression(node: cst.Node): boolean
    local inferred = semanticRaw((node as any).inferredType)
    return inferred ~= nil and inferred.tag == "never"
end

local function assignValue(target: scalarIR.Name, value: scalarIR.Expr): scalarIR.Assign
    return new scalarIR.Assign(
        op = "assign",
        values = {
            new scalarIR.Assignment(
                target = new scalarIR.Target(
                    kind = "local",
                    name = target.name,
                    cName = target.cName,
                    type = target.type
                ),
                value = value
            )
        },
        source = value.source
    )
end

local function booleanValue(value: scalarIR.Expr, kernel: lower.Kernel): scalarIR.Expr
    if kernel.context.unreachableValues[value] then
        return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = value.source)
    end
    return value
end

local function negate(value: scalarIR.Expr): scalarIR.Expr
    return new scalarIR.Unary(op = "not", value = value, type = "bool", source = value.source)
end

local function guarded(condition: scalarIR.Expr, body: {scalarIR.Statement}): scalarIR.If
    return new scalarIR.If(
        op = "if",
        clauses = {new scalarIR.Clause(condition = condition, body = body)},
        source = condition.source
    )
end

--- Capture setup where the expression is evaluated, including lazy operands.
function lower.capture(
    node: cst.Node,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): (scalarIR.Expr, {scalarIR.Statement})
    local previous, parent = kernel.pending, kernel.expressionFrame
    kernel.pending, kernel.expressionFrame = {}, nil
    local value = lower.expression(node, environment, activeIndex, kernel)
    local setup = kernel.pending
    kernel.pending, kernel.expressionFrame = previous, parent

    return value, setup
end

local function expressionRaw(
    node: cst.Node,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local context = kernel.context
    if node == nil then
        context.reject(kernel.loopSource, "an expression is missing")
    end
    node = node as cst.Node

    local kind = node.kind
    -- Parentheses and a cast carry no operation: the tree already has the
    -- grouping, and a cast the checker admitted has already been proved.
    if kind == "paren" or kind == "castExpr" then
        local inner = kind == "paren" and (node as cst.Paren).expr or (node as cst.CastExpr).expr

        return lower.expression(inner as cst.Node, environment, activeIndex, kernel)
    elseif kind == "doExpr" then
        return lower.doExpression(node as cst.DoExpr, environment, kernel)
    elseif kind == "switchExpr" then
        return lower.switchExpression(node as cst.SwitchExpr, environment, kernel)
    elseif kind == "ternary" then
        local choice = node as cst.Ternary
        local condition = booleanValue(
            lower.expression(choice.cond as cst.Node, environment, activeIndex, kernel),
            kernel
        )
        if condition.type ~= "bool" then
            context.reject(lower.site(node), "native conditional expressions require a boolean condition")
        end
        local yes, yesBody = lower.capture(choice.ifTrue as cst.Node, environment, activeIndex, kernel)
        local no, noBody = lower.capture(choice.ifFalse as cst.Node, environment, activeIndex, kernel)
        local yesNever = neverExpression(choice.ifTrue as cst.Node)
        local noNever = neverExpression(choice.ifFalse as cst.Node)
        local resultType = not yesNever and yes.type or nil
        if not noNever then
            resultType = joinedType(resultType, no.type, lower.site(node), context)
        end
        resultType = resultType or yes.type
        local result = temporary(lower.zeroValue(resultType, lower.site(node), context), kernel, kernel.pending)
        if not yesNever then
            yesBody[#yesBody + 1] = assignValue(result, lower.convert(yes, resultType, lower.site(node), context))
        end
        if not noNever then
            noBody[#noBody + 1] = assignValue(result, lower.convert(no, resultType, lower.site(node), context))
        end
        local branch = guarded(condition, yesBody)
        branch.elseBody = noBody
        kernel.pending[#kernel.pending + 1] = branch
        return result
    elseif kind == "name" then
        local name = lower.nameOf(node)
        local bound = name ~= nil and environment[name as string] or nil
        if bound == nil then
            if activeIndex ~= nil and name == activeIndex and kernel.mapEntry then
                return new scalarIR.LoopIndex(op = "loop_index", type = "f64", source = lower.site(node))
            end
            -- A `const` bound to a string literal is a byte table the emitter
            -- can write out as static data. The checker already resolved it to
            -- a literal type carrying its value, so nothing has to be folded or
            -- looked up: what it answers with is a rooted-string name like any
            -- other, and every reader between here and the emitted load is
            -- unchanged.
            local constant = lower.constantString(node)
            if constant ~= nil then
                return lower.constantBytes(constant as string, kernel, lower.site(node))
            end
            local number = kernel.constantNumbers[tostring(name)] or lower.constantNumber(node)
            if number ~= nil then
                return new scalarIR.Constant(
                    op = "constant",
                    value = number as string,
                    type = "f64",
                    source = lower.site(node)
                )
            end
            context.reject(lower.site(node), "value " .. tostring(name) .. " is not available in native code")
        end
        if bound.kind == "absent_species" then
            context.reject(
                lower.site(node),
                "this tier has no vectors, so " .. tostring(
                    name
                ) .. " is nil here; keep the vector path inside the branch that tested it against nil"
            )
        end
        if bound.kind == "rooted_span" then
            context.reject(
                lower.site(node),
                tostring(
                    name
                )
                .. " is a view over a rooted parameter rather than a value; a vector load may read it and nothing else"
            )
        end

        -- A specialization binds its const carriers to IR values rather than
        -- to runtime parameters. Keep those values as values: turning one back
        -- into a Name below would discard the tuple before optimization sees it.
        if bound.op == "constant"
            or bound.op == "constant_i32"
            or bound.op == "bool"
            or bound.op == "workgroup_index"
            or bound.op == "local_index"
        then
            return bound as scalarIR.Expr
        elseif bound.op == "lua_string" then
            markLua(kernel, lower.site(node))
            return bound as scalarIR.Expr
        end

        -- A name keeps whatever refinement its binding holds. Only a physical
        -- load widens eagerly, because that is where ordinary Nupp turns storage
        -- into a number; widening here as well would make an established `float`
        -- local unreadable as one.
        -- A helper's parameters are bound as the IR nodes themselves, which carry
        -- `op` where an ordinary binding carries `kind`. Reading only `kind` made
        -- every reference to a helper parameter lower as an ordinary local. C
        -- emission cannot tell the two apart so nothing looked wrong, but the lane
        -- rewriter decides what varies by exactly this distinction, so an inlined
        -- helper body read as uniform and the loop lost its lanes.
        local op = bound.kind == "uniform" and "uniform" or (
            bound.kind == "helper_param" or bound.op == "helper_param"
        ) and "helper_param" or "local"

        return new scalarIR.Name(
            op = op as any,
            name = name as string,
            type = bound.type,
            cName = bound.cName,
            mutable = bound.mutable,
            lengthOf = bound.lengthOf,
            builderMode = bound.builderMode,
            source = lower.site(node)
        )
    elseif kind == "number" then
        local token = (node as cst.NumberLit).token
        local value = token ~= nil and (token as lexer.Token).text or ""
        local wide = value:lower():match("ull$") and "u64" or value:lower():match("ll$") and "i64" or nil
        if wide ~= nil then
            return new scalarIR.Int64Constant(
                op = "constant_i64",
                value = value:sub(1, wide == "u64" and -4 or -3),
                type = wide as any,
                source = lower.site(node)
            )
        end
        if tonumber(value) == nil then
            context.reject(lower.site(node), "the kernel needs a finite decimal numeric literal")
        end

        return new scalarIR.Constant(op = "constant", value = value, type = "f64", source = lower.site(node))
    elseif kind == "trueExpr" or kind == "falseExpr" then
        return new scalarIR.Bool(op = "bool", value = kind == "trueExpr", type = "bool", source = lower.site(node))
    elseif kind == "nilExpr" then
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaNil(op = "lua_nil", type = "lua_nil", source = lower.site(node))
    elseif kind == "string" then
        local token = (node as cst.StringLit).token
        local written = token ~= nil and (token as lexer.Token).text or "\"\""
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaString(
            op = "lua_string",
            value = stringBytes(written),
            type = "lua_string",
            source = lower.site(node)
        )
    elseif kind == "tableExpr" then
        local literal = node as cst.TableExpr
        local fields: {scalarIR.LuaField} = {}
        local arrayCapacity, hashCapacity = 0, 0
        for _, raw in ipairs(literal.fields or {}) do
            local key: scalarIR.Expr
            local value: scalarIR.Expr
            local indexed = false
            if raw.kind == "fieldItem" then
                arrayCapacity = arrayCapacity + 1
                indexed = true
                key = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = tostring(arrayCapacity),
                    type = "i32",
                    source = lower.site(raw)
                )
                value = lower.expression((raw as cst.FieldItem).value as cst.Node, environment, activeIndex, kernel)
            elseif raw.kind == "fieldNamed" then
                hashCapacity = hashCapacity + 1
                local named = raw as cst.FieldNamed
                key = new scalarIR.LuaString(
                    op = "lua_string",
                    value = named.name ~= nil and (named.name as lexer.Token).text or "",
                    type = "lua_string",
                    source = lower.site(raw)
                )
                value = lower.expression(named.value as cst.Node, environment, activeIndex, kernel)
            else
                hashCapacity = hashCapacity + 1
                local bracket = raw as cst.FieldBracket
                key = lower.expression(bracket.key as cst.Node, environment, activeIndex, kernel)
                value = lower.expression(bracket.value as cst.Node, environment, activeIndex, kernel)
            end
            fields[
                #fields + 1
            ] = new scalarIR.LuaField(key = key, value = value, indexed = indexed, source = lower.site(raw))
        end
        markLua(kernel, lower.site(node))
        return new scalarIR.LuaNewTable(
            op = "lua_new_table",
            arrayCapacity = new scalarIR.Constant(
                op = "constant",
                value = tostring(arrayCapacity),
                type = "f64",
                source = lower.site(node)
            ),
            hashCapacity = new scalarIR.Constant(
                op = "constant",
                value = tostring(hashCapacity),
                type = "f64",
                source = lower.site(node)
            ),
            fields = fields,
            type = "lua_table",
            source = lower.site(node)
        )
    elseif kind == "unop" and (node as cst.Unop).op ~= nil then
        local operator = node as cst.Unop
        local counted = lower.dotCount(operator)
        local shared = counted ~= nil and environment[counted as string] or nil
        if shared ~= nil and shared.kind == "workgroup_shared" then
            return new scalarIR.Constant(
                op = "constant",
                value = tostring(shared.count),
                type = "f64",
                source = lower.site(node)
            )
        end
        local spanParam = counted ~= nil and kernel.params[counted as string] or nil
        if spanParam ~= nil and spanParam.region ~= nil then
            return new scalarIR.SpanCount(
                op = "span_count",
                span = counted as string,
                type = "f64",
                source = lower.site(node)
            )
        end
        local stringBinding = counted ~= nil and environment[counted as string] or nil
        if stringBinding ~= nil and stringBinding.type == "lua_string" then
            local bytes = lower.expression(operator.operand as cst.Node, environment, activeIndex, kernel)
            markLua(kernel, lower.site(node))
            return new scalarIR.LuaBytes(
                op = "lua_string_length",
                bytes = bytes,
                type = "u32",
                source = lower.site(node)
            )
        end

        return unary(operator, lower.expression(operator.operand as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "methodCall" then
        local simd = simdMethod(node as cst.MethodCall, environment, activeIndex, kernel)
        if simd ~= nil then
            return simd
        end
        context.reject(lower.site(node), "method call is not an admitted SIMD operation")
    elseif kind == "bracketIndex" then
        local indexed = node as cst.BracketIndex
        local tableName = lower.nameOf(indexed.obj)
        local tableBinding = tableName ~= nil and environment[tableName as string] or nil
        if tableBinding ~= nil and tableBinding.kind == "workgroup_shared" then
            if kernel.inPhase ~= true then
                context.reject(lower.site(node), "workgroup scratch is read only inside phases:run")
            end
            local index = lower.expression(indexed.expr as cst.Node, environment, activeIndex, kernel)

            local function indexRange(value: scalarIR.Expr): (number?, number?)
                local op = value.op
                if op == "constant" or op == "constant_i32" then
                    local constant = tonumber((value as any).value)
                    if constant ~= nil and constant == math.floor(constant as number) and constant >= 0 then
                        return constant, constant
                    end
                elseif op == "local_index" then
                    return 0, (kernel.workgroupSize as integer) - 1
                elseif op == "numeric_cast" or op == "int_to_f64" then
                    return indexRange((value as scalarIR.Convert).value)
                elseif op == "u32_add" or op == "u32_mul" then
                    local pair = value as scalarIR.Fixed
                    local leftMin, leftMax = indexRange(pair.left)
                    local rightMin, rightMax = indexRange(pair.right)
                    if leftMin ~= nil and leftMax ~= nil and rightMin ~= nil and rightMax ~= nil then
                        local low = op == "u32_add" and (
                            leftMin as number
                        ) + (rightMin as number) or (leftMin as number) * (rightMin as number)
                        local high = op == "u32_add" and (
                            leftMax as number
                        ) + (rightMax as number) or (leftMax as number) * (rightMax as number)
                        if high <= 4294967295 then
                            return low, high
                        end
                    end
                elseif op == "u32_div" or op == "u32_mod" then
                    local pair = value as scalarIR.Fixed
                    local leftMin, leftMax = indexRange(pair.left)
                    local rightMin, rightMax = indexRange(pair.right)
                    if leftMin ~= nil
                        and leftMax ~= nil
                        and rightMin ~= nil
                        and rightMin == rightMax
                        and rightMin > 0
                    then
                        if op == "u32_div" then
                            return math.floor(
                                (leftMin as number) / (rightMin as number)
                            ), math.floor((leftMax as number) / (rightMin as number))
                        end
                        return 0, math.min(leftMax as number, (rightMin as number) - 1)
                    end
                end

                return nil, nil
            end

            local minimum, maximum = indexRange(index)
            if minimum == nil or maximum == nil or minimum < 0 or maximum >= tableBinding.count then
                context.reject(lower.site(indexed.expr), "shared scratch read is not statically proved in bounds")
            end
            if index.op == "constant" then
                index = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = tostring(minimum),
                    type = "u32",
                    source = lower.site(indexed.expr)
                )
            end
            return widenLoad(
                new scalarIR.SharedLoad(
                    op = "shared_load",
                    shared = tableName as string,
                    index = index,
                    type = tableBinding.element,
                    source = lower.site(node)
                ),
                lower.site(node)
            )
        end
        if tableBinding ~= nil and tableBinding.type == "lua_table" then
            local key = lower.expression(indexed.expr as cst.Node, environment, activeIndex, kernel)
            if key.type ~= "f64" and key.type ~= "i32" and key.type ~= "u32" then
                context.reject(lower.site(indexed.expr), "fresh numeric table reads need a numeric key")
            end
            markLua(kernel, lower.site(node))
            return new scalarIR.LuaTableGet(
                op = "lua_table_get_index",
                table = lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel),
                key = key,
                type = "f64",
                source = lower.site(node)
            )
        end
        return spanRead(indexed, environment, activeIndex, kernel)
    elseif kind == "dotIndex" and (node as cst.DotIndex).name ~= nil then
        local indexed = node as cst.DotIndex
        local counted = lower.dotCount(indexed)
        local spanParam = counted ~= nil and kernel.params[counted as string] or nil
        if spanParam ~= nil and spanParam.region ~= nil then
            return new scalarIR.SpanCount(
                op = "span_count",
                span = counted as string,
                type = "f64",
                source = lower.site(node)
            )
        end
        local objectName = lower.nameOf(indexed.obj)
        local object = objectName ~= nil and environment[objectName as string] or nil
        if object ~= nil
            and tostring(object.type):match("^simd_species_")
            and object.type ~= "simd_species_u8"
            and (indexed.name as lexer.Token).text == "lanes" then
            kernel.usesSimd = true
            return new scalarIR.Simd(
                op = "simd_lanes_generic",
                args = {lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel)},
                intrinsic = "lanes",
                type = "u32",
                source = lower.site(node)
            )
        elseif object ~= nil and object.type == "simd_species_u8" and (indexed.name as lexer.Token).text == "lanes" then
            kernel.usesSimd = true
            return new scalarIR.Simd(
                op = "simd_lanes",
                args = {lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel)},
                type = "u32",
                source = lower.site(node)
            )
        end

        return fieldRead(indexed, lower.expression(indexed.obj as cst.Node, environment, activeIndex, kernel), kernel)
    elseif kind == "binop" and (node as cst.Binop).op ~= nil then
        local operator = node as cst.Binop
        local written = (operator.op as lexer.Token).text
        local decided = speciesNilTest(written, operator.lhs as cst.Node, operator.rhs as cst.Node, environment)
        if decided ~= nil then
            return new scalarIR.Bool(op = "bool", value = decided as boolean, type = "bool", source = lower.site(node))
        end
        local left = lower.expression(operator.lhs as cst.Node, environment, activeIndex, kernel)
        local cursor, boundName, room = shortCircuitBound(written, operator.lhs, environment, kernel)
        local previous = kernel.cursorBounds
        if cursor ~= nil then
            local bounds: scalarIR.CursorBounds = {}
            for name, spans in pairs(previous) do
                bounds[name] = spans
            end
            withBound(bounds, cursor as string, boundName as string, room as string)
            kernel.cursorBounds = bounds
        end
        local right, setup = lower.capture(operator.rhs as cst.Node, environment, activeIndex, kernel)
        kernel.cursorBounds = previous
        if written == "and" or written == "or" then
            left, right = booleanValue(left, kernel), booleanValue(right, kernel)
        else
            if context.unreachableValues[left] then
                left = lower.zeroValue(right.type, lower.site(node), context)
            end
            if context.unreachableValues[right] then
                right = lower.zeroValue(left.type, lower.site(node), context)
            end
        end
        if #setup > 0 and (written == "and" or written == "or") then
            if left.type ~= "bool" or right.type ~= "bool" then
                context.reject(lower.site(node), "native logical operands must be boolean")
            end
            local result = temporary(left, kernel, kernel.pending)
            setup[#setup + 1] = assignValue(result, right)
            kernel.pending[#kernel.pending + 1] = guarded(written == "and" and result or negate(result), setup)
            return result
        end
        if #setup > 0 then
            left = temporary(left, kernel, kernel.pending)
            for _, statement in ipairs(setup) do
                kernel.pending[#kernel.pending + 1] = statement
            end
        end
        return binary(operator, left, right, kernel)
    elseif kind == "call" then
        return call(node as cst.Call, environment, activeIndex, kernel)
    end

    context.reject(lower.site(node), "expression kind " .. tostring(kind) .. " is not admitted")

    return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(node))
end

--- Keep earlier operands ahead of statementful later operands. The original
--- expression stays intact when no operand needs setup.
function lower.expression(
    node: cst.Node,
    environment: {[string]: any},
    activeIndex: string?,
    kernel: lower.Kernel
): scalarIR.Expr
    local parent, previous = kernel.expressionFrame, kernel.pending
    local frame = new lower.ExpressionFrame(output = {})
    kernel.expressionFrame, kernel.pending = frame, frame.output
    local value = expressionRaw(node, environment, activeIndex, kernel)

    local function rewrite(child: scalarIR.Expr): scalarIR.Expr
        local replacement = frame.replacements[child]
        if replacement ~= nil then
            return replacement
        end
        local copy: {[string]: any} = {}
        for key, entry in pairs(child as any) do
            copy[key] = entry
        end
        visit.expressionChildren(copy as any, rewrite)

        return copy as any
    end

    if next(frame.replacements) ~= nil then
        value = rewrite(value)
    end
    if neverExpression(node) then
        kernel.context.unreachableValues[value] = true
    end
    kernel.expressionFrame, kernel.pending = parent, previous
    if #frame.output > 0 and parent ~= nil then
        for _, operand in ipairs(parent.operands) do
            if parent.replacements[
                operand
            ] == nil
                and operand.op ~= "constant"
                and operand.op ~= "constant_i32"
                and operand.op ~= "constant_i64"
                and operand.op ~= "bool" then
                parent.replacements[operand] = temporary(operand, kernel, previous)
            end
        end
    end
    for _, statement in ipairs(frame.output) do
        previous[#previous + 1] = statement
    end
    if parent ~= nil then
        parent.operands[#parent.operands + 1] = value
    end

    return value
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

--- The IR type one helper signature spelling denotes.
---
--- A helper takes and returns ordinary Nupp values, so `float` here is binary64
--- rather than an establishment: a helper that wanted binary32 would have to say
--- so in a way this subset does not yet have.
function lower.helperValueType(spelling: string): scalarIR.Type?
    if spelling == "boolean" then
        return "bool"
    elseif spelling == "number" or spelling == "float" or spelling == "integer" then
        return "f64"
    elseif spelling == "uint32" then
        return "u32"
    elseif spelling == "int32" then
        return "i32"
    elseif spelling == "uint64" then
        return "u64"
    elseif spelling == "int64" then
        return "i64"
    elseif spelling:match("%.VectorU8$") ~= nil then
        return "simd_vector_u8"
    elseif spelling:match("%.MaskU8$") ~= nil then
        return "simd_mask_u8"
    elseif spelling:match("%.MaskBits64$") ~= nil then
        return "simd_mask_bits64"
    elseif spelling:match("%.SpeciesU8$") ~= nil then
        return "simd_species_u8"
    elseif spelling:match("%.TableU8x16$") ~= nil then
        return "simd_table_u8x16"
    end

    return nil
end

--- Lowers one visible pure helper, on first reach.
---
--- A helper is a parameter list and one return list over those parameters, and
--- nothing else. That is what makes inlining it into a lane body substitution
--- rather than a transformation.
function lower.helper(name: string, at: cst.Node?, kernel: lower.Kernel): scalarIR.Helper
    local context = kernel.context
    if kernel.helperState[name] == "lowering" then
        context.reject(lower.site(at), "recursive native helpers are not admitted")
    end

    local declaration = kernel.helperDecls[name]
    -- Another `@aot` declaration in the same file is a call rather than a body to
    -- inline: it is compiled once, keeps its own contract, and the caller reaches
    -- it through its own symbol. Its parameters and result still have to be values
    -- this IR carries, which the checks below are already the statement of.
    local native = false
    if declaration == nil and kernel.entryDecls[name] ~= nil then
        declaration = kernel.entryDecls[name]
        native = true
    end
    if declaration == nil then
        context.reject(lower.site(at), "call target " .. name .. " is not a visible pure helper")
    end
    kernel.helperState[name] = "lowering"

    local body = declaration.body
    if body == nil or body.varargParam ~= nil or body.captureTakes ~= nil or body.captureBorrows ~= nil then
        context.reject(lower.site(declaration), "native helpers must be non-variadic and non-capturing")
    end

    local generic = body.generics ~= nil
    local checkedSignature = context.checked and (
        generic and at ~= nil and (at as any).signatureType or body.signatureType
    ) or nil
    if context.checked and checkedSignature == nil then
        context.reject(lower.site(body), "the checker did not publish this native helper signature")
    end
    if context.checked then
        local effects = body.effectSummary
        if effects == nil then
            context.reject(lower.site(body), "the checker did not publish this native helper effect summary")
        end
        -- Positive effects are authoritative refusals. `top` alone is not:
        -- AOT-only SIMD interfaces deliberately have no runtime body whose
        -- ordinary effect analysis could summarize. Their calls still pass
        -- through the closed AOT operation vocabulary below, and no unknown
        -- call can reach IR or emission.
        if effects.allocates == true
            or effects.yields == true
            or effects.raises == true
            or effects.external == true
            or next(
                effects.writes or {}
            ) ~= nil or next(
                effects.shapes or {}
            ) ~= nil or next(effects.metatables or {}) ~= nil or next(effects.escapes or {}) ~= nil then
            context.reject(lower.site(body), "the checker reports side effects in this native helper")
        end
    end

    local resultTypes: {scalarIR.Type} = {}
    for position, result in ipairs(body.rets or {}) do
        local resultType = context.checked and semanticValueType(
            checkedSignature.rets[position],
            true
        ) or lower.helperValueType(lower.compactType(result))
        if resultType == nil then
            context.reject(lower.site(result), "native helper results are scalar or SIMD values")
        end
        if tostring(resultType):match("^simd_reducer_") ~= nil then
            context.reject(lower.site(result), "reducers cannot cross a native helper result boundary")
        end
        resultTypes[#resultTypes + 1] = resultType as scalarIR.Type
    end
    if #resultTypes == 0 then
        context.reject(lower.site(body), "native helpers need at least one result")
    end

    local params: {scalarIR.Name} = {}
    local environment: {[string]: any} = {}
    for position, raw in ipairs(body.params or {}) do
        local paramName = raw.name ~= nil and (raw.name as lexer.Token).text or nil
        local paramType = context.checked and semanticValueType(
            checkedSignature.params[position],
            true
        ) or lower.helperValueType(lower.compactType(raw.type))
        local mode = context.checked and checkedSignature.paramModes[
            position
        ] or raw.modeTok ~= nil and (raw.modeTok as lexer.Token).text or nil
        if paramName == nil or paramType == nil or mode ~= nil and mode ~= "plain" then
            context.reject(lower.site(raw), "native helper parameters are unowned scalar or SIMD values")
        end
        if tostring(paramType):match("^simd_reducer_") ~= nil then
            context.reject(lower.site(raw), "reducers cannot cross a native helper parameter boundary")
        end
        if environment[paramName as string] ~= nil then
            context.reject(lower.site(raw), "duplicate helper parameter " .. (paramName as string))
        end

        local param = new scalarIR.Name(
            op = "helper_param",
            name = paramName as string,
            type = paramType as scalarIR.Type,
            cName = scalarIR.cIdentifier("a", paramName as string),
            source = lower.site(raw)
        )
        params[#params + 1] = param
        environment[paramName as string] = param
    end

    local keyParts: {string} = {name}
    for _, param in ipairs(params) do
        keyParts[#keyParts + 1] = param.type
    end
    keyParts[#keyParts + 1] = "returns"
    for _, result in ipairs(resultTypes) do
        keyParts[#keyParts + 1] = result
    end
    local helperKey = generic and table.concat(keyParts, "_") or name
    local known = kernel.helpers[helperKey]
    if known ~= nil then
        kernel.helperState[name] = "done"
        return known as scalarIR.Helper
    end

    if native and #resultTypes ~= 1 then
        context.reject(lower.site(declaration), "a compiled entry called from another returns one value")
    end
    if native then
        local called = new scalarIR.Helper(
            name = name,
            cName = scalarIR.privateSymbol(name),
            params = params,
            values = {},
            resultType = resultTypes[1],
            resultTypes = resultTypes,
            native = true,
            source = lower.site(declaration)
        )
        kernel.helpers[helperKey] = called
        kernel.helperState[name] = "done"
        kernel.helperOrder[#kernel.helperOrder + 1] = called

        return called
    end

    local statements = body.body ~= nil and (body.body as cst.Block).stats or {}
    local returned = statements[1]
    local single = #statements == 1 and returned ~= nil and returned.kind == "returnStmt" and #(
        (returned as cst.ReturnStmt).exprs or {}
    ) == #resultTypes
    if not single then
        context.reject(lower.site(body.body or body), "a native helper body is one matching return list")
    end

    local helper = new scalarIR.Helper(
        name = helperKey,
        cName = kernel.symbol .. "_helper_" .. scalarIR.privateSymbol(helperKey):sub(4),
        params = params,
        values = {},
        resultType = resultTypes[1],
        resultTypes = resultTypes,
        source = lower.site(declaration)
    )
    kernel.helpers[helperKey] = helper

    for position, result in ipairs((returned as cst.ReturnStmt).exprs or {}) do
        local value, setup = lower.capture(result, environment, nil, kernel)
        if #setup > 0 then
            context.reject(lower.site(result), "a statementful helper must be declared @aot")
        end
        if value.type ~= resultTypes[position] then
            context.reject(lower.site(returned), "native helper result type does not match")
        end
        helper.values[position] = value
    end
    kernel.helperState[name] = "done"
    kernel.helperOrder[#kernel.helperOrder + 1] = helper

    return helper
end

----------------------------------------------------------------------------
-- Scopes and statements
----------------------------------------------------------------------------

--- An environment with the same entries, so a nested block cannot leak the
--- names it introduces back out of itself.
local function inherit(environment: {[string]: any}): {[string]: any}
    local copied: {[string]: any} = {}
    for name, bound in pairs(environment) do
        copied[name] = bound
    end

    return copied
end

--- Introduces one local, refusing a name already in scope.
---
--- Shadowing is refused rather than renamed: the generated C has no scope to
--- tell two bindings of one name apart, and quietly renaming would make the
--- source and the C disagree about which one a later read meant.
local function bind(
    name: string,
    valueType: scalarIR.Type,
    mutable: boolean?,
    at: cst.Node?,
    environment: {[string]: any},
    kernel: lower.Kernel
): scalarIR.Binding
    if environment[name] ~= nil then
        kernel.context.reject(lower.site(at), "native locals may not shadow " .. name)
    end
    kernel.serial = kernel.serial + 1

    local binding = new scalarIR.Binding(
        kind = "local",
        name = name,
        type = valueType,
        mutable = mutable,
        cName = scalarIR.cIdentifier("v" .. tostring(kernel.serial), name),
        source = lower.site(at)
    )
    environment[name] = binding

    return binding
end

--- The scratch whose initialized length an expression preserves.
local function scratchLengthSource(value: scalarIR.Expr, kernel: lower.Kernel): string?
    if value.op == "lua_scratch_u32_length" or value.op == "lua_scratch_u32_escape_length" then
        return ((value as scalarIR.LuaScratchU32Length).scratch as scalarIR.Name).name
    elseif value.op == "lua_scratch_u32_append_bits"
        or value.op == "lua_scratch_u32_append_bits_eager"
        or value.op == "lua_scratch_u32_append_string_bits"
    then
        return ((value as any).scratch as scalarIR.Name).name
    elseif value.op == "local" then
        return kernel.scratchLengthBounds[(value as scalarIR.Name).name]
    elseif value.op == "u32_and" then
        local pair = value as scalarIR.Fixed

        local function mask(other: scalarIR.Expr): boolean
            return other.op == "constant_i32" and tonumber((other as scalarIR.IntConstant).value) == 0x7fffffff
        end

        if mask(pair.right) then
            return scratchLengthSource(pair.left, kernel)
        elseif mask(pair.left) then
            return scratchLengthSource(pair.right, kernel)
        end
    end

    return nil
end

--- The binding bookkeeping every local initializer keeps: events on a builder
--- read its mode from the binding, and length and scratch accesses read their
--- bounds from it.
---
--- A fixed buffer's width belongs to the name it was bound to, because that is
--- what an access names. One map for words and bytes: a name holds one binding
--- at a time, and an access carries the type that says which kind it is
--- reading. Cleared before it is set, and on every binding rather than only on
--- a buffer's: shadowing is refused, but two disjoint scopes may each bind one
--- name, and a later appending buffer inheriting an earlier fixed one's width
--- would be checked against a bound the buffer it names does not have -- which
--- is a read past the end of it rather than a refusal.
local function noteBinding(name: string, value: scalarIR.Expr, binding: scalarIR.Binding, kernel: lower.Kernel): nil
    kernel.lengthBounds[name] = nil
    if value.op == "lua_string_length" then
        local bytes = (value as scalarIR.LuaBytes).bytes as scalarIR.Name
        binding.lengthOf = bytes.name
        kernel.lengthBounds[name] = bytes.name
    end
    local scratchLength = scratchLengthSource(value, kernel)
    if scratchLength ~= nil then
        kernel.scratchLengthBounds[name] = scratchLength as string
    else
        kernel.scratchLengthBounds[name] = nil
    end
    kernel.scratchBounds[name] = nil
    if value.op == "lua_scratch_u32" and (value as scalarIR.LuaScratchU32).fixed ~= nil then
        kernel.scratchBounds[name] = (value as scalarIR.LuaScratchU32).fixed as integer
    elseif value.op == "lua_scratch_u8" and (value as scalarIR.LuaScratchU8).fixed ~= nil then
        kernel.scratchBounds[name] = (value as scalarIR.LuaScratchU8).fixed as integer
    end
    if value.op == "lua_builder" then
        binding.builderMode = (value as scalarIR.LuaBuilder).mode
    end
end

--- The statically known truth of a lowered condition, or nil when it can
--- vary. A const-monomorphized carrier lowers as a constant, so a branch
--- comparing one selects its arm here, before the untaken arms are lowered
--- at all -- which is what lets one const-generic body hold per-variant
--- constructs the other variants' specializations must never contain.
local function staticTruth(value: scalarIR.Expr): boolean?
    if value.op == "bool" then
        return (value as scalarIR.Bool).value
    end
    if value.op ~= "eq"
        and value.op ~= "ne"
        and value.op ~= "lt"
        and value.op ~= "le"
        and value.op ~= "gt"
        and value.op ~= "ge"
    then
        return nil
    end
    local binary = value as scalarIR.Binary
    local left = fold.exactInteger(binary.left)
    local right = fold.exactInteger(binary.right)
    if left == nil or right == nil then
        return nil
    end
    local leftValue = left as number
    local rightValue = right as number

    return switch binary.op do
        case "eq" -> leftValue == rightValue
        case "ne" -> leftValue ~= rightValue
        case "lt" -> leftValue < rightValue
        case "le" -> leftValue <= rightValue
        case "gt" -> leftValue > rightValue
        else -> leftValue >= rightValue
    end
end

--- Checker-normalized primitive cases, with the same literal fallback used
--- by the standalone parser harness. Cases never run source expressions.
local function switchCaseValue(node: cst.Node, kernel: lower.Kernel): scalarIR.Expr
    local exact = (node as any).switchStaticValue
    local value: any = nil
    local kind: string? = nil
    if exact ~= nil then
        kind = exact.tag == "literal" and type(exact.constant) or "nil"
        value = exact.constant
    else
        local raw = node as any
        while raw.kind == "paren" do
            raw = raw.expr
        end
        if raw.kind == "number" then
            kind, value = "number", tonumber((raw.token.text:gsub("_", "")))
        elseif raw.kind == "unop" and raw.op.text == "-" and raw.operand.kind == "number" then
            kind, value = "number", -(tonumber((raw.operand.token.text:gsub("_", ""))) as number)
        elseif raw.kind == "string" then
            kind, value = "string", stringBytes(raw.token.text)
        elseif raw.kind == "trueExpr" or raw.kind == "falseExpr" then
            kind, value = "boolean", raw.kind == "trueExpr"
        elseif raw.kind == "nilExpr" then
            kind = "nil"
        end
    end
    local source = lower.site(node)
    if kind == "number" and value ~= nil then
        return new scalarIR.Constant(op = "constant", value = ("%.17g"):format(value), type = "f64", source = source)
    elseif kind == "string" then
        return new scalarIR.LuaString(op = "lua_string", value = value, type = "lua_string", source = source)
    elseif kind == "boolean" then
        return new scalarIR.Bool(op = "bool", value = value, type = "bool", source = source)
    elseif kind == "nil" then
        return new scalarIR.LuaNil(op = "lua_nil", type = "lua_nil", source = source)
    end
    kernel.context.reject(source, "native switch cases must be static primitive values")

    return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = source)
end

--- Lower a switch to a result binding and ordered branches. Constant selectors
--- prune untaken arms before lowering, including noncopyable intrinsic builders.
local function switchLocal(
    stat: cst.LocalStmt,
    node: cst.SwitchExpr,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local names = stat.names or {}
    if #names ~= 1 or #(stat.exprs or {}) ~= 1 then
        context.reject(lower.site(stat), "a native switch initializes exactly one local")
    end
    if #(node.cases or {}) == 0 and node.elseCase == nil then
        context.reject(lower.site(node), "a native numeric switch requires an arm")
    end

    -- Captured immutable strings otherwise lower to native byte tables, not
    -- Lua stack slots. Keep their known value for constant arm selection.
    local constantString = lower.constantString(lower.unwrapped(node.selector) as cst.Node)
    local selector: scalarIR.Expr
    if constantString ~= nil then
        selector = new scalarIR.LuaString(
            op = "lua_string",
            value = constantString,
            type = "lua_string",
            source = lower.site(node.selector)
        )
    else
        selector = lower.expression(node.selector as cst.Node, environment, kernel.index, kernel)
    end
    local numeric = selector.type == "f64" or selector.type == "f32" or selector.type == "i32" or selector.type == "u32"
    if not numeric and selector.type ~= "bool" and selector.type ~= "lua_nil" and selector.type ~= "lua_string" then
        context.reject(lower.site(node.selector), "a native switch selector needs a supported primitive representation")
    end
    if selector.type == "lua_nil" or selector.type == "lua_string" then
        markLua(kernel, lower.site(node))
    end
    local nativeLabelsFit = selector.type == "i32" or selector.type == "u32"

    -- Validate every case before constant selection prunes untaken arms.
    for _, arm in ipairs(node.cases or {}) do
        if arm.patternKind ~= "static" then
            context.reject(lower.site(arm), "native switches do not admit type cases")
        elseif arm.guard ~= nil then
            -- Both paths below answer from the case label alone: the jump table has
            -- nowhere to put a predicate, and constant selection would commit to an
            -- arm whose guard it never evaluated. Refusing is the only sound answer
            -- until the native switch grows a fallthrough.
            context.reject(lower.site(arm), "native switches do not admit a `where` guard")
        elseif arm.body ~= nil or arm.expr == nil then
            context.reject(lower.site(arm), "native switches require expression arms")
        end
        for _, caseValue in ipairs(arm.values or {}) do
            local constant = switchCaseValue(caseValue, kernel)
            local number = constant.op == "constant" and tonumber((constant as scalarIR.Constant).value) or nil
            nativeLabelsFit = nativeLabelsFit and number ~= nil and number == math.floor(
                number as number
            ) and (
                selector.type == "i32"
                and number >= -2147483648
                and number <= 2147483647
                or selector.type == "u32"
                and number >= 0
                and number <= 4294967295
            )
        end
    end
    local otherwise = node.elseCase
    if otherwise and (otherwise.body ~= nil or otherwise.expr == nil) then
        context.reject(lower.site(otherwise), "native switches require expression arms")
    end

    local staticSelector = fold.exactInteger(selector)
    local staticPrimitive = selector.op == "bool" or selector.type == "lua_nil" or selector.op == "lua_string"
    if staticSelector ~= nil or staticPrimitive then
        -- The selector is a constant -- a monomorphized const carrier -- so
        -- the arm is decided here and the untaken arms are never lowered.
        local chosen: cst.Node? = nil
        for _, arm in ipairs(node.cases or {}) do
            for _, caseValue in ipairs(arm.values or {}) do
                local label = switchCaseValue(caseValue, kernel)
                local matched = staticSelector ~= nil and label.op == "constant" and tonumber(
                    (label as scalarIR.Constant).value
                ) == staticSelector or staticPrimitive and label.type == selector.type and (
                    selector.type == "lua_nil" or (label as any).value == (selector as any).value
                )
                if chosen == nil and matched then
                    chosen = arm.expr
                end
            end
        end
        if chosen == nil and otherwise ~= nil then
            chosen = otherwise.expr
        end
        if chosen == nil then
            context.reject(lower.site(node), "a constant switch selector matches no arm")
        end
        local chosenValue = firstValue(
            lower.expression(chosen as cst.Node, environment, kernel.index, kernel),
            kernel,
            out
        )
        local annotation = stat.types ~= nil and (stat.types as {cst.Node})[1] or nil
        local resultType = annotatedValueType(annotation, context) or kernel.expectedType or chosenValue.type
        if resultType == nil or resultType == "multi" or resultType:match("^ref:") then
            context.reject(lower.site(stat), "native switch results must be scalar")
        end
        resultType = resultType as scalarIR.Type
        local resultBinding = bind(names[1].text, resultType, false, stat, environment, kernel)
        local converted = lower.convert(chosenValue, resultType, lower.site(node), context)
        noteBinding(names[1].text, converted, resultBinding, kernel)
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = names[1].text,
            cName = resultBinding.cName,
            value = converted,
            type = resultType,
            source = lower.site(stat)
        )
        return
    end

    local selectorName = "$switch_selector_" .. tostring(kernel.serial + 1)
    local selectorBinding = bind(selectorName, selector.type, false, node, environment, kernel)
    out[
        #out + 1
    ] = new scalarIR.Let(
        op = "let",
        name = selectorName,
        cName = selectorBinding.cName,
        value = selector,
        type = selector.type,
        source = lower.site(node.selector)
    )
    local selectorRef = new scalarIR.Name(
        op = "local",
        name = selectorName,
        cName = selectorBinding.cName,
        type = selector.type,
        source = lower.site(node.selector)
    )

    local arms = {}
    for _, arm in ipairs(node.cases or {}) do
        local value, setup = lower.capture(arm.expr as cst.Node, environment, kernel.index, kernel)
        value = firstValue(value, kernel, setup)
        arms[#arms + 1] = {case = arm, value = value, setup = setup, never = neverExpression(arm.expr as cst.Node)}
    end
    local elseValue: scalarIR.Expr? = nil
    local elseSetup: {scalarIR.Statement} = {}
    if otherwise ~= nil then
        local value, setup = lower.capture(otherwise.expr as cst.Node, environment, kernel.index, kernel)
        elseValue, elseSetup = firstValue(value, kernel, setup), setup
    end
    local annotation = stat.types ~= nil and (stat.types as {cst.Node})[1] or nil
    local inferredResult: scalarIR.Type? = nil
    for _, arm in ipairs(arms) do
        if not arm.never then
            inferredResult = joinedType(inferredResult, arm.value.type, lower.site(arm.case), context)
        end
    end
    local elseNever = otherwise ~= nil and neverExpression(otherwise.expr as cst.Node)
    if elseValue ~= nil and not elseNever then
        inferredResult = joinedType(inferredResult, elseValue.type, lower.site(otherwise), context)
    end
    inferredResult = inferredResult or "f64"
    local resultType = annotatedValueType(
        annotation,
        context
    ) or kernel.expectedType or semanticValueType((node as any).inferredType) or inferredResult
    if resultType == nil or resultType == "multi" or resultType:match("^ref:") then
        context.reject(lower.site(stat), "native switch results must be scalar")
    end
    resultType = resultType as scalarIR.Type

    local resultBinding = bind(names[1].text, resultType, false, stat, environment, kernel)
    local zero = lower.zeroValue(resultType, lower.site(stat), context)
    out[
        #out + 1
    ] = new scalarIR.Let(
        op = "let",
        name = names[1].text,
        cName = resultBinding.cName,
        value = zero,
        type = resultType,
        source = lower.site(stat)
    )

    local target = new scalarIR.Target(
        kind = "local",
        name = resultBinding.name,
        cName = resultBinding.cName,
        type = resultType
    )
    local clauses: {scalarIR.Clause} = {}
    local nativePlan = switchplan.native(nativeLabelsFit and selector.type or "f64")
    local nativeArms: {scalarIR.SwitchArm} = {}
    for _, lowered in ipairs(arms) do
        local condition: scalarIR.Expr? = nil
        local nativeLabels: {scalarIR.SwitchLabel} = {}
        for _, caseValue in ipairs(lowered.case.values or {}) do
            local label = switchCaseValue(caseValue, kernel)
            local number = label.op == "constant" and tonumber((label as scalarIR.Constant).value) or nil
            local right: scalarIR.Expr
            if nativePlan.tag == "NativeIntegerSwitch" then
                local number = number as number
                if selector.type == "i32" and (number < -2147483648 or number > 2147483647) then
                    context.reject(lower.site(caseValue), "native switch case is outside int32")
                elseif selector.type == "u32" and (number < 0 or number > 4294967295) then
                    context.reject(lower.site(caseValue), "native switch case is outside uint32")
                end
                local spelling = ("%.0f"):format(number)
                right = new scalarIR.IntConstant(
                    op = "constant_i32",
                    value = spelling,
                    type = selector.type,
                    source = lower.site(caseValue)
                )
                nativeLabels[
                    #nativeLabels + 1
                ] = new scalarIR.SwitchLabel(
                    value = spelling,
                    type = selector.type as any,
                    source = lower.site(caseValue)
                )
            else
                right = label
            end
            local equal: scalarIR.Expr
            local comparable = right.type == selector.type or numeric and right.type == "f64"
            if not comparable then
                equal = new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(caseValue))
            elseif right.type == "lua_string" then
                equal = new scalarIR.LuaStringMatch(
                    op = "lua_string_match",
                    bytes = selectorRef,
                    value = (right as scalarIR.LuaString).value,
                    type = "bool",
                    source = lower.site(caseValue)
                )
            elseif right.type == "lua_nil" then
                equal = new scalarIR.Bool(op = "bool", value = true, type = "bool", source = lower.site(caseValue))
            else
                equal = new scalarIR.Binary(
                    op = "eq",
                    left = selectorRef,
                    right = right,
                    type = "bool",
                    source = lower.site(caseValue)
                )
            end
            condition = condition ~= nil and new scalarIR.Binary(
                op = "or",
                left = condition as scalarIR.Expr,
                right = equal,
                type = "bool",
                source = lower.site(caseValue)
            ) or equal
        end
        if not lowered.never then
            local assignment = new scalarIR.Assignment(
                target = target,
                value = lower.convert(lowered.value, resultType, lower.site(lowered.case), context)
            )
            lowered.setup[
                #lowered.setup + 1
            ] = new scalarIR.Assign(op = "assign", values = {assignment}, source = lower.site(lowered.case))
        end
        clauses[
            #clauses + 1
        ] = new scalarIR.Clause(
            condition = condition as scalarIR.Expr,
            body = lowered.setup,
            source = lower.site(lowered.case)
        )
        if nativePlan.tag == "NativeIntegerSwitch" then
            nativeArms[#nativeArms + 1] = new scalarIR.SwitchArm(labels = nativeLabels)
        end
    end
    local elseBody: {scalarIR.Statement}? = nil
    if otherwise and elseValue and not elseNever then
        local elseAssignment = new scalarIR.Assignment(
            target = target,
            value = lower.convert(elseValue, resultType, lower.site(otherwise), context)
        )
        elseSetup[
            #elseSetup + 1
        ] = new scalarIR.Assign(op = "assign", values = {elseAssignment}, source = lower.site(otherwise))
        elseBody = elseSetup
    end
    if elseNever then
        elseBody = elseSetup
    end
    local expressionArms = #elseSetup <= 1
    for _, arm in ipairs(arms) do
        expressionArms = expressionArms and #arm.setup == 1
    end
    local nativeSwitch = expressionArms and nativePlan.tag == "NativeIntegerSwitch" and new scalarIR.NativeSwitch(
        selector = selectorRef,
        arms = nativeArms
    ) or nil
    out[
        #out + 1
    ] = new scalarIR.If(
        op = "if",
        clauses = clauses,
        elseBody = elseBody,
        source = lower.site(node),
        nativeSwitch = nativeSwitch
    )
    environment[selectorName] = nil
end

function lower.zeroValue(valueType: scalarIR.Type, source: scalarIR.Source?, context: lower.Context): scalarIR.Expr
    if valueType == "bool" then
        return new scalarIR.Bool(op = "bool", value = false, type = "bool", source = source)
    elseif valueType == "i32" or valueType == "u32" then
        return new scalarIR.IntConstant(op = "constant_i32", value = "0", type = valueType, source = source)
    elseif valueType == "i64" or valueType == "u64" then
        return new scalarIR.Int64Constant(op = "constant_i64", value = "0", type = valueType, source = source)
    elseif valueType == "f64" or valueType == "f32" then
        return lower.convert(
            new scalarIR.Constant(op = "constant", value = "0", type = "f64", source = source),
            valueType,
            source,
            context
        )
    elseif valueType == "lua_nil" then
        return new scalarIR.LuaNil(op = "lua_nil", type = "lua_nil", source = source)
    elseif valueType == "lua_string" then
        return new scalarIR.LuaString(op = "lua_string", value = "", type = "lua_string", source = source)
    end
    context.reject(source, "native expression blocks require an admitted scalar result")

    return new scalarIR.Bool(op = "bool", value = false, type = "bool")
end

--- Yields use a completion flag, leaving authored loop control untouched.
--- Every loop crossed by a yield exits before its next condition or iteration.
local function exitValueLoops(body: {scalarIR.Statement}, done: scalarIR.Name): nil
    for _, statement in ipairs(body) do
        if statement.op == "if" then
            local branch = statement as scalarIR.If
            -- A source break inside a block arm targets a loop, not C's switch.
            branch.nativeSwitch = nil
            for _, clause in ipairs(branch.clauses) do
                exitValueLoops(clause.body, done)
            end
            if branch.elseBody ~= nil then
                exitValueLoops(branch.elseBody, done)
            end
        elseif statement.op == "block" then
            exitValueLoops((statement as scalarIR.Block).body, done)
        elseif statement.op == "fornum" or statement.op == "while" or statement.op == "repeat" then
            local loop = statement as any
            exitValueLoops(loop.body, done)
            if loop.conditionBody ~= nil then
                exitValueLoops(loop.conditionBody, done)
                loop.condition = new scalarIR.Binary(
                    op = loop.op == "repeat" and "or" or "and",
                    left = loop.op == "repeat" and done or negate(done),
                    right = loop.condition,
                    type = "bool"
                )
            end
            loop.body[#loop.body + 1] = guarded(done, {new scalarIR.Break(op = "break")})
        end
    end
end

function lower.doExpression(node: cst.DoExpr, environment: {[string]: any}, kernel: lower.Kernel): scalarIR.Expr
    local output = kernel.pending
    local done = temporary(
        new scalarIR.Bool(op = "bool", value = false, type = "bool", source = lower.site(node)),
        kernel,
        output
    )
    local previous = kernel.valueFrame
    local frame = new lower.ValueFrame(done = done)
    kernel.valueFrame = frame
    local body = lower.block(node.body ~= nil and (node.body as cst.Block).stats or {}, inherit(environment), kernel)
    kernel.valueFrame = previous
    local result = frame.result
    if result == nil then
        -- Only nonlocal exits remain. No completion flag or result local is
        -- read on any reachable path.
        output[#output] = nil
        output[#output + 1] = new scalarIR.Block(op = "block", body = body, source = lower.site(node))
        return lower.zeroValue(kernel.expectedType or kernel.resultTypes[1] or "f64", lower.site(node), kernel.context)
    end
    local inferred: scalarIR.Type? = nil
    for _, assignment in ipairs(frame.assignments) do
        inferred = joinedType(inferred, assignment.value.type, lower.site(node), kernel.context)
    end
    local valueType = semanticValueType(
        (node as any).inferredType
    ) or inferred or kernel.expectedType or kernel.resultTypes[1] or result.type
    result.type = valueType
    for _, assignment in ipairs(frame.assignments) do
        assignment.target.type = valueType
        assignment.value = lower.convert(assignment.value, valueType, lower.site(node), kernel.context)
    end
    output[
        #output + 1
    ] = new scalarIR.Let(
        op = "let",
        name = result.name,
        cName = result.cName as string,
        type = result.type,
        value = lower.zeroValue(result.type, lower.site(node), kernel.context),
        source = lower.site(node)
    )
    exitValueLoops(body, done)
    output[#output + 1] = new scalarIR.Block(op = "block", body = body, source = lower.site(node))

    return result
end

function lower.switchExpression(node: cst.SwitchExpr, environment: {[string]: any}, kernel: lower.Kernel): scalarIR.Expr
    local name = "$switch_value_" .. tostring(kernel.serial + 1)
    local stat = new cst.LocalStmt(
        kind = "localStmt",
        names = {
            (
                {
                    kind = "name",
                    text = name,
                    line = 1,
                    col = 1,
                    offset = 1,
                    trivia = lexer.arena(""),
                    triviaCount = 0,
                    triviaFirst = 0
                } as lexer.Token
            )
        },
        exprs = {node},
        types = {}
    )
    stat[1] = node
    local inner = inherit(environment)
    switchLocal(stat, node, kernel.pending, inner, kernel)
    local bound = inner[name]

    return new scalarIR.Name(
        op = "local",
        name = bound.name,
        cName = bound.cName,
        type = bound.type,
        source = lower.site(node)
    )
end

--- Flattens `name = name .. ...` into the appended string expressions.
local function stringAppendPieces(node: cst.Node?, name: string): {cst.Node}?
    if node == nil then
        return nil
    end
    if node.kind == "name" and lower.nameOf(node) == name then
        return {}
    end
    if node.kind ~= "binop" then
        return nil
    end
    local joined = node as cst.Binop
    if joined.op == nil or (joined.op as lexer.Token).text ~= ".." then
        return nil
    end
    local pieces = stringAppendPieces(joined.lhs, name)
    if pieces == nil then
        return nil
    end
    pieces[#pieces + 1] = joined.rhs as cst.Node

    return pieces
end

--- Finds ordinary locals used only through self-appending assignments and a
--- direct return. Any other use reaches normal lowering and is refused rather
--- than being silently assigned accumulator semantics.
function lower.stringAccumulators(statements: {cst.Node}): {[string]: boolean}
    local declared, appended, returned, invalid = {}, {}, {}, {}

    local function walk(node: cst.Node?): nil
        if node == nil then
            return
        end
        if node.kind == "localStmt" then
            local stat = node as cst.LocalStmt
            if #(stat.names or {}) == 1 and #(stat.exprs or {}) == 1 then
                local name = (stat.names or {})[1].text
                if declared[name] then
                    invalid[name] = true
                else
                    declared[name] = true
                end
            end
        elseif node.kind == "assignStmt" then
            local stat = node as cst.AssignStmt
            local targets, exprs = stat.targets or {}, stat.exprs or {}
            if #targets == 1 and #exprs == 1 and targets[1].kind == "name" then
                local name = tostring(lower.nameOf(targets[1]))
                if stringAppendPieces(exprs[1], name) ~= nil then
                    appended[name] = true
                else
                    invalid[name] = true
                end
            end
        elseif node.kind == "returnStmt" then
            for _, value in ipairs((node as cst.ReturnStmt).exprs or {}) do
                local name = lower.nameOf(value)
                if name ~= nil then
                    returned[name as string] = true
                end
            end
        end
        for _, child in ipairs(node as {any}) do
            walk(child)
        end
    end

    for _, statement in ipairs(statements) do
        walk(statement)
    end
    local found: {[string]: boolean} = {}
    for name in pairs(declared) do
        if appended[name] and returned[name] and not invalid[name] then
            found[name] = true
        end
    end

    return found
end

--- One `local` declaration, which may bind several names from one call.
local function localStmt(
    stat: cst.LocalStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local names = stat.names or {}
    local exprs = stat.exprs or {}
    if #names == 0 or #exprs == 0 then
        context.reject(lower.site(stat), "native locals must be initialized")
    end
    if kernel.phasesName ~= nil and #names == 1 and #exprs == 1 and exprs[1].kind == "methodCall" then
        local call = exprs[1] as cst.MethodCall
        local args = call.args ~= nil and ((call.args as cst.Args).exprs or {}) or {}
        if lower.nameOf(
            call.obj
        ) == kernel.phasesName and call.name ~= nil and (call.name as lexer.Token).text == "scratch" then
            if #args ~= 2 then
                context.reject(lower.site(call), "phases:scratch takes an initial value and a static count")
            end
            local token = cst.firstToken(args[2])
            local count = token ~= nil and tonumber((token as lexer.Token).text) or nil
            if count == nil or count ~= math.floor(count as number) or count < 1 then
                context.reject(lower.site(args[2]), "workgroup scratch count must be a positive integer literal")
            end
            local initial = lower.expression(args[1], environment, kernel.index, kernel)
            if initial.type ~= "f32" and initial.type ~= "i32" and initial.type ~= "u32" then
                context.reject(lower.site(args[1]), "workgroup scratch elements must be f32, int32, or uint32")
            end
            local shared = new scalarIR.Shared(
                name = names[1].text,
                element = initial.type,
                count = count as integer,
                initial = initial,
                source = lower.site(stat)
            )
            local byName = kernel.shared as {[string]: scalarIR.Shared}
            if byName[names[1].text] ~= nil then
                context.reject(lower.site(stat), "workgroup scratch names may not be shadowed")
            end
            byName[names[1].text] = shared
            local ordered = kernel.sharedOrder as {scalarIR.Shared}
            ordered[#ordered + 1] = shared
            environment[names[1].text] = {kind = "workgroup_shared", element = initial.type, count = count,}
            return
        end
    end
    if #names == 1 and #exprs == 1 and kernel.stringAccumulators[names[1].text] then
        local initial = lower.expression(exprs[1], environment, kernel.index, kernel)
        if initial.type ~= "lua_string" then
            context.reject(lower.site(exprs[1]), "a string accumulator must start with a string")
        end
        local binding = bind(names[1].text, "lua_string_buffer", nil, stat, environment, kernel)
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = names[1].text,
            cName = binding.cName,
            type = "lua_string_buffer",
            value = new scalarIR.LuaStringBuffer(
                op = "lua_string_buffer",
                initial = initial,
                type = "lua_string_buffer",
                source = lower.site(exprs[1])
            ),
            source = lower.site(stat)
        )
        markLua(kernel, lower.site(stat))
        return
    end

    if #exprs == 1 and #names == 1 and exprs[1].kind == "switchExpr" then
        return switchLocal(stat, exprs[1] as cst.SwitchExpr, out, environment, kernel)
    end

    if #exprs == 1 and exprs[
        1
    ].kind == "call" and not context.vectors and calledIdentity(
        exprs[1] as cst.Call,
        kernel
    ) == "nupp.simd.species" then
        -- `simd.species` on a tier without vectors: the name is bound to
        -- nothing, and the branch that tests it against nil prunes.
        admitSpecies(exprs[1] as cst.Call, kernel)
        if #names ~= 1 then
            context.reject(lower.site(stat), "native local initializer count must match names")
        end
        if environment[names[1].text] ~= nil then
            context.reject(lower.site(stat), "native locals may not shadow " .. names[1].text)
        end
        environment[names[1].text] = {kind = "absent_species"}
        return
    end

    if #exprs == 1 and exprs[
        1
    ].kind == "call" and calledIdentity(exprs[1] as cst.Call, kernel) == "nupp.codec.valuebuilder.bytes" then
        -- `valuebuilder.bytes(source)`: the span over a rooted parameter's own
        -- bytes. It is a name for a pointer and a count the entry already has,
        -- so nothing is constructed and no local is emitted -- the binding
        -- records which parameter a load through it addresses, and the loads
        -- carry that parameter as their root. Everything the verifier is told
        -- about such a load it re-derives from that parameter, so this binding
        -- cannot manufacture a bounds fact.
        local call = exprs[1] as cst.Call
        local arguments = call.args ~= nil and ((call.args as cst.Args).exprs or {}) or {}
        if #names ~= 1 or #arguments ~= 1 then
            context.reject(lower.site(stat), "valuebuilder.bytes takes one rooted string parameter")
        end
        local rooted = lower.expression(arguments[1], environment, kernel.index, kernel)
        if not rootedBytesParam(rooted, kernel) then
            context.reject(lower.site(call), "valuebuilder.bytes needs a rooted string parameter")
        end
        if environment[names[1].text] ~= nil then
            context.reject(lower.site(stat), "native locals may not shadow " .. names[1].text)
        end
        environment[names[1].text] = {kind = "rooted_span", bytes = (rooted as scalarIR.Name).name}
        return
    end

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local previousType = kernel.expectedType
        kernel.expectedType = annotatedValueType(stat.types ~= nil and (stat.types as {cst.Node})[1] or nil, context)
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        kernel.expectedType = previousType
        if only.type == "multi" then
            -- One call, several results. The names are bound together because
            -- the call happens once, whatever it is later inlined into.
            local call = only as scalarIR.HelperCall
            local resultTypes = call.resultTypes or {}
            if #resultTypes < #names then
                context.reject(lower.site(stat), "multiple-result helper count does not match local names")
            end

            local bindings: {scalarIR.Binding} = {}
            for position, token in ipairs(names) do
                local annotated = annotatedValueType(
                    stat.types ~= nil and (stat.types as {cst.Node})[position] or nil,
                    context
                )
                local valueType = resultTypes[position]
                if annotated ~= nil and annotated ~= valueType then
                    context.reject(lower.site(stat), "native local annotation does not match")
                end
                bindings[position] = bind(token.text, valueType, nil, stat, environment, kernel)
            end
            out[
                #out + 1
            ] = new scalarIR.MultiLet(op = "multi_let", call = call, bindings = bindings, source = lower.site(stat))

            return
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            local value = lower.expression(expression, environment, kernel.index, kernel)
            if value.type == "multi" then
                context.reject(lower.site(expression), "a multiple-result call must be the only initializer")
            end
            values[#values + 1] = value
        end
    end

    if #values ~= #names then
        context.reject(lower.site(stat), "native local initializer count must match names")
    end
    for position, token in ipairs(names) do
        local annotation = stat.types ~= nil and (stat.types as {cst.Node})[position] or nil
        local expected = annotatedValueType(annotation, context) or values[position].type
        if expected == nil then
            context.reject(
                lower.site(stat),
                "native local annotation " .. lower.compactType(annotation) .. " is not admitted"
            )
        end

        local value = lower.convert(values[position], expected as scalarIR.Type, lower.site(stat), context)
        if tostring(expected):match("^simd_reducer_") ~= nil and value.op ~= "reducer_init" then
            context.reject(lower.site(stat), "a reducer cannot be copied or passed through another value")
        end
        local binding = bind(
            token.text,
            expected as scalarIR.Type,
            (value as scalarIR.ElementRef).mutable,
            stat,
            environment,
            kernel
        )
        noteBinding(token.text, value, binding, kernel)
        if value.op == "reducer_init" then
            if kernel.simdSource == true then
                context.reject(lower.site(stat), "a reducer is created before its @simd loop")
            end
            local state = new lower.ReducerState(
                name = token.text,
                cName = binding.cName,
                finalized = false,
                source = lower.site(stat)
            )
            kernel.reducers[binding.cName] = state
            kernel.reducerOrder[#kernel.reducerOrder + 1] = state
        end
        out[
            #out + 1
        ] = new scalarIR.Let(
            op = "let",
            name = token.text,
            cName = binding.cName,
            type = expected as scalarIR.Type,
            value = value,
            source = lower.site(stat)
        )
    end
end

--- Where one assignment puts its value.
local function assignTarget(target: cst.Node, environment: {[string]: any}, kernel: lower.Kernel): scalarIR.Target
    local context = kernel.context
    if target.kind == "name" then
        local binding = environment[tostring(lower.nameOf(target))]
        if binding == nil or binding.kind ~= "local" then
            context.reject(lower.site(target), "native assignment target must be a local")
        end
        if tostring(binding.type):match("^lua_") ~= nil and binding.type ~= "lua_string" then
            context.reject(lower.site(target), "Lua construction handles cannot be reassigned")
        end
        if tostring(binding.type):match("^simd_reducer_") ~= nil then
            context.reject(lower.site(target), "a reducer binding cannot be reassigned")
        end

        return new scalarIR.Target(kind = "local", name = binding.name, cName = binding.cName, type = binding.type)
    end

    local indexed = target as cst.DotIndex
    if target.kind ~= "dotIndex" or indexed.name == nil then
        context.reject(lower.site(target), "native assignment targets are locals or mutable struct fields")
    end

    local object = lower.expression(indexed.obj as cst.Node, environment, kernel.index, kernel)
    local layoutName = object.type:match("^ref:(.+)$")
    local layout = layoutName ~= nil and kernel.layouts.byName[layoutName as string] or nil
    if layout == nil or (object as scalarIR.ElementRef).mutable ~= true then
        context.reject(lower.site(target), "native field assignment needs getMut(index)")
    end

    local wanted = (indexed.name as lexer.Token).text
    local field: scalarIR.Field? = nil
    for _, candidate in ipairs((layout as scalarIR.Layout).fields) do
        if candidate.name == wanted then
            field = candidate
        end
    end
    if field == nil then
        context.reject(lower.site(target), "unknown native struct field " .. wanted)
    end

    return new scalarIR.Target(
        kind = "field",
        object = object,
        layout = layoutName as string,
        field = (field as scalarIR.Field).name,
        type = (field as scalarIR.Field).type,
        sourceType = (field as scalarIR.Field).sourceType
    )
end

--- One assignment, which may write several targets at once.
local function assignStmt(
    stat: cst.AssignStmt,
    out: {scalarIR.Statement},
    environment: {[string]: any},
    kernel: lower.Kernel
): nil
    local context = kernel.context
    local exprs = stat.exprs or {}
    local targets = stat.targets or {}

    if #targets == 1 and #exprs == 1 and targets[1].kind == "name" then
        local name = tostring(lower.nameOf(targets[1]))
        local binding = environment[name]
        if binding ~= nil and binding.type == "lua_string_buffer" then
            local pieces = stringAppendPieces(exprs[1], name)
            if pieces == nil then
                context.reject(lower.site(stat), "a lowered string accumulator is append-only")
            end
            for _, piece in ipairs(pieces as {cst.Node}) do
                local value = lower.expression(piece, environment, kernel.index, kernel)
                if value.type ~= "lua_string" then
                    context.reject(lower.site(piece), "a string accumulator appends only strings")
                end
                out[
                    #out + 1
                ] = new scalarIR.LuaStringBufferAppend(
                    op = "lua_string_buffer_append",
                    buffer = new scalarIR.Name(
                        op = "local",
                        name = binding.name,
                        cName = binding.cName,
                        type = "lua_string_buffer",
                        source = lower.site(targets[1])
                    ),
                    value = value,
                    source = lower.site(stat)
                )
            end
            markLua(kernel, lower.site(stat))
            return
        end
    end

    if #targets ~= 1 or #exprs ~= 1 then
        for _, target in ipairs(targets) do
            local name = lower.nameOf(target)
            local binding = name ~= nil and environment[name as string] or nil
            if binding ~= nil and binding.type == "lua_string" then
                context.reject(lower.site(stat), "AOT Lua string reassignment must have one target and one value")
            end
        end
    end

    if #targets == 1 and #exprs == 1 and targets[1].kind == "dotIndex" then
        local target = targets[1] as cst.DotIndex
        local tableName = lower.nameOf(target.obj)
        local tableBinding = tableName ~= nil and environment[tableName as string] or nil
        if tableBinding ~= nil and tableBinding.type == "lua_table" and target.name ~= nil then
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            out[
                #out + 1
            ] = new scalarIR.LuaSet(
                op = "lua_set_key",
                table = new scalarIR.Name(
                    op = "local",
                    name = tableBinding.name,
                    cName = tableBinding.cName,
                    type = "lua_table",
                    source = lower.site(target.obj)
                ),
                key = new scalarIR.LuaString(
                    op = "lua_string",
                    value = (target.name as lexer.Token).text,
                    type = "lua_string",
                    source = lower.site(target.name)
                ),
                value = value,
                source = lower.site(stat)
            )
            markLua(kernel, lower.site(stat))
            return
        end
    end

    if #targets == 1 and #exprs == 1 and targets[1].kind == "bracketIndex" then
        local target = targets[1] as cst.BracketIndex
        local spanName = lower.nameOf(target.obj)
        local output = spanName ~= nil and kernel.params[spanName as string] or nil
        local tableBinding = spanName ~= nil and environment[spanName as string] or nil
        if tableBinding ~= nil and tableBinding.kind == "workgroup_shared" then
            if kernel.inPhase ~= true then
                context.reject(lower.site(target), "workgroup scratch is written only inside phases:run")
            end
            local index = lower.expression(target.expr as cst.Node, environment, kernel.index, kernel)
            if index.op ~= "local_index" then
                context.reject(lower.site(target.expr), "shared scratch writes must use exactly localIndex")
            end
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            out[
                #out + 1
            ] = new scalarIR.SharedStore(
                op = "shared_store",
                shared = spanName as string,
                index = index,
                value = lower.convert(value, tableBinding.element, lower.site(stat), context),
                source = lower.site(stat)
            )
            return
        end
        if tableBinding ~= nil and tableBinding.type == "lua_table" then
            local key = lower.expression(target.expr as cst.Node, environment, kernel.index, kernel)
            if key.type ~= "f64" and key.type ~= "i32" and key.type ~= "u32" and key.type ~= "lua_string" then
                context.reject(lower.site(target.expr), "fresh table keys must be numeric or strings")
            end
            local value = lower.expression(exprs[1], environment, kernel.index, kernel)
            if value.type ~= "f64"
                and value.type ~= "f32"
                and value.type ~= "i32"
                and value.type ~= "u32"
                and value.type ~= "bool"
                and value.type ~= "lua_table"
                and value.type ~= "lua_string"
                and value.type ~= "lua_nil"
            then
                context.reject(lower.site(exprs[1]), "fresh table values must be admitted Lua primitives or tables")
            end
            out[
                #out + 1
            ] = new scalarIR.LuaSet(
                op = (key.type == "lua_string" and "lua_set_key" or "lua_set_index") as any,
                table = new scalarIR.Name(
                    op = "local",
                    name = tableBinding.name,
                    cName = tableBinding.cName,
                    type = "lua_table",
                    source = lower.site(target.obj)
                ),
                key = key,
                value = value,
                source = lower.site(stat)
            )
            markLua(kernel, lower.site(stat))
            return
        end
        if output == nil or output.kind ~= "write_span" then
            context.reject(lower.site(target), "native indexed stores require a writable span")
        end
        local indexArg = lower.unwrapped(target.expr)
        local direct = lower.nameOf(indexArg)
        local cursor = provedCursor(indexArg, spanName, kernel)
        if not (kernel.index ~= "" and direct == kernel.index) and cursor == nil then
            context.reject(
                lower.site(target),
                "span stores need a counted-loop index or cursor + 1 under cursor < #span"
            )
        end
        provenIndex(spanName as string, cursor, target, kernel)
        local value = lower.expression(exprs[1], environment, kernel.index, kernel)
        local cursorBinding = cursor ~= nil and environment[cursor as string] or nil
        out[
            #out + 1
        ] = new scalarIR.Store(
            op = "store",
            span = spanName as string,
            index = cursor == nil and kernel.index or "",
            indexCName = cursor == nil and kernel.indexCName or nil,
            cursor = cursor,
            cursorCName = cursorBinding ~= nil and cursorBinding.cName or nil,
            value = lower.convert(value, output.element.type, lower.site(stat), context),
            source = lower.site(stat)
        )
        return
    end

    local values: {scalarIR.Expr} = {}
    if #exprs == 1 then
        local only = lower.expression(exprs[1], environment, kernel.index, kernel)
        if only.type == "multi" then
            context.reject(
                lower.site(stat),
                "multiple-result helpers initialize locals; ordinary multiple assignment uses explicit values"
            )
        end
        values[1] = only
    else
        for _, expression in ipairs(exprs) do
            values[#values + 1] = lower.expression(expression, environment, kernel.index, kernel)
        end
    end
    if #values ~= #targets then
        context.reject(lower.site(stat), "native assignment counts must match")
    end

    local assignments: {scalarIR.Assignment} = {}
    for position, target in ipairs(targets) do
        local lowered = assignTarget(target, environment, kernel)
        assignments[
            position
        ] = new scalarIR.Assignment(
            target = lowered,
            value = lower.convert(values[position], lowered.type as scalarIR.Type, lower.site(stat), context)
        )
    end
    out[#out + 1] = new scalarIR.Assign(op = "assign", values = assignments, source = lower.site(stat))
    for _, entry in ipairs(assignments) do
        local target = entry.target
        if target.kind == "local" and target.name ~= nil then
            kernel.cursorBounds[target.name as string] = nil
            kernel.lengthBounds[target.name as string] = nil
            kernel.scratchBounds[target.name as string] = nil
            local scratchLength = scratchLengthSource(entry.value, kernel)
            if scratchLength ~= nil then
                kernel.scratchLengthBounds[target.name as string] = scratchLength as string
            else
                kernel.scratchLengthBounds[target.name as string] = nil
            end
        end
    end
end

--- One numeric `for` bound.
---
--- An integer literal stays an integer rather than being written as a double
--- for the emitter to cast back.
local function forBound(bound: scalarIR.Expr, at: cst.Node?, kernel: lower.Kernel): scalarIR.Expr
    if bound.op == "constant" then
        local number = tonumber((bound as scalarIR.Constant).value)
        if number ~= nil and number == math.floor(number as number) then
            -- The C loop counts in int32, so a literal the counter cannot reach
            -- is refused here rather than narrowed into a bound that means
            -- something else. Spelled with %.0f: tostring writes 2^53 as
            -- 9.007e+15, which is not a C integer.
            local spelling = ("%.0f"):format(number as number)
            if number < lower.INT32_MIN or number > lower.INT32_MAX then
                kernel.context.reject(lower.site(at), "native for bound " .. spelling .. " is outside int32")
            end
            return new scalarIR.IntConstant(op = "constant_i32", value = spelling, type = "i32", source = bound.source)
        end
    end
    if bound.type ~= "i32" and bound.type ~= "u32" and bound.type ~= "f64" then
        kernel.context.reject(lower.site(at), "native for bounds must be numeric")
    end

    return bound
end

--- Finds a scratch array that one ordinary phase both writes and reads through
--- another lane's index. That is a race without a compiler-owned collective
--- shape. Reads from an earlier phase and same-lane read-modify-write remain
--- valid.
local function sharedPhaseCollision(statements: {scalarIR.Statement}): string?
    local written: {[string]: boolean} = {}
    local crossRead: {[string]: boolean} = {}
    local inspectExpression: function(scalarIR.Expr): nil
    inspectExpression = function(value: scalarIR.Expr): nil
        if value.op == "shared_load" then
            local load = value as scalarIR.SharedLoad
            if load.index.op ~= "local_index" then
                crossRead[load.shared] = true
            end
        end
        visit.expressionChildren(value, function(child: scalarIR.Expr): scalarIR.Expr
            inspectExpression(child)
            return child
        end)
    end
    local inspectBlock: function({scalarIR.Statement}): nil
    inspectBlock = function(block: {scalarIR.Statement}): nil
        for _, statement in ipairs(block) do
            if statement.op == "shared_store" then
                written[(statement as scalarIR.SharedStore).shared] = true
            end
            visit.statementExpressions(statement, function(value: scalarIR.Expr): scalarIR.Expr
                inspectExpression(value)
                return value
            end)
            if statement.op == "if" then
                for _, clause in ipairs((statement as scalarIR.If).clauses) do
                    inspectBlock(clause.body)
                end
                inspectBlock((statement as scalarIR.If).elseBody or {})
            elseif statement.op == "while"
                or statement.op == "repeat"
                or statement.op == "fornum"
                or statement.op == "block"
            then
                inspectBlock((statement as any).body as {scalarIR.Statement})
            end
        end
    end
    inspectBlock(statements)
    for name in pairs(written) do
        if crossRead[name] == true then
            return name
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- Lowering a block
----------------------------------------------------------------------------

--- One block of admitted statements, and everything under it.
function lower.block(statements: {cst.Node}, environment: {[string]: any}, kernel: lower.Kernel): {scalarIR.Statement}
    local context = kernel.context
    local out: {scalarIR.Statement} = {}
    local root = out
    local previous, parent = kernel.pending, kernel.expressionFrame
    kernel.pending, kernel.expressionFrame = out, nil

    --- One nested block, under its own scope.
    local function nested(body: cst.Node?): {scalarIR.Statement}
        local block = body as cst.Block?

        return lower.block(block ~= nil and (block as cst.Block).stats or {}, inherit(environment), kernel)
    end

    --- The bounds one comparison establishes: a positive `uint32 cursor <
    --- #span` fact authorizes exactly `span[cursor + 1]` in that arm, and
    --- `cursor + s.lanes <= #span` authorizes `s:load(span, cursor + 1)` as
    --- well. Returns the cursor, the root it is bounded against, and the room.
    local function comparedBound(comparison: cst.Binop): (string?, string?, string?)
        local vectorCursor, vectorSpan, speciesType = laneBound(comparison, environment, kernel)
        if vectorCursor ~= nil then
            return vectorCursor, vectorSpan, speciesType
        end
        local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
        local cursor = lower.nameOf(comparison.lhs)
        local spanName = lower.dotCount(comparison.rhs)
        local binding = cursor ~= nil and environment[cursor as string] or nil
        local param = spanName ~= nil and kernel.params[spanName as string] or nil
        if written == "<" and binding ~= nil and binding.type == "u32" and param ~= nil and param.region ~= nil then
            return cursor, spanName, scalarIR.ONE_ELEMENT
        end
        local lengthName = lower.nameOf(comparison.rhs)
        local bytesName = lengthName ~= nil and kernel.lengthBounds[lengthName as string] or nil
        local bytes = bytesName ~= nil and kernel.params[bytesName as string] or nil
        if written == "<" and binding ~= nil and binding.type == "u32" and bytes ~= nil and bytes.kind == "scalar" and (
            bytes.type == "lua_string" or bytes.type == "lua_bytes"
        ) then
            return cursor, bytesName, scalarIR.ONE_ELEMENT
        end
        local scratchName = lengthName ~= nil and kernel.scratchLengthBounds[lengthName as string] or nil
        local scratch = scratchName ~= nil and environment[scratchName as string] or nil
        if written == "<"
            and binding ~= nil
            and binding.type == "u32"
            and scratch ~= nil
            and scratch.type == "lua_scratch_u32"
        then
            return cursor, scratchName, scalarIR.ONE_ELEMENT
        end

        return nil, nil, nil
    end

    --- Every bound a condition proves when it holds: each comparison it
    --- conjoins with `and` that `comparedBound` reads. Nil when there is none.
    local function cursorBound(condition: cst.Node?, into: scalarIR.CursorBounds?): scalarIR.CursorBounds?
        if condition == nil or condition.kind ~= "binop" then
            return into
        end
        local comparison = condition as cst.Binop
        local written = comparison.op ~= nil and (comparison.op as lexer.Token).text or ""
        if written == "and" then
            return cursorBound(comparison.rhs, cursorBound(comparison.lhs, into))
        end
        local cursor, root, room = comparedBound(comparison)
        if cursor == nil then
            return into
        end
        local bounds = into or {}
        withBound(bounds as scalarIR.CursorBounds, cursor as string, root as string, room as string)

        return bounds
    end

    --- Lowers a nested block under the cursor bounds it runs with: the
    --- enclosing ones, less any a loop body reassigns, plus those its own
    --- condition proves.
    ---
    --- A cursor the loop body assigns is bounded by the enclosing proof on the
    --- first iteration only; from the second it holds whatever the body left in
    --- it. So under a loop such a cursor keeps a bound only when the loop's own
    --- condition re-proves it every time round, which is the same rule the
    --- verifier applies -- refused here so the refusal names the read.
    local function nestedWithCursor(
        body: cst.Node?,
        proved: scalarIR.CursorBounds?,
        loop: boolean?
    ): {scalarIR.Statement}
        if loop ~= true and proved == nil then
            return nested(body)
        end
        local previous = kernel.cursorBounds
        local reassigned = loop == true and assignedNames(body, {}) or {}
        local bounds: scalarIR.CursorBounds = {}
        for name, spans in pairs(previous) do
            if reassigned[name] ~= true then
                bounds[name] = spans
            end
        end
        for name, spans in pairs(proved or {}) do
            for root, room in pairs(spans) do
                withBound(bounds, name, root, room)
            end
        end
        kernel.cursorBounds = bounds
        local lowered = nested(body)
        local invalidated: {string} = {}
        for name in pairs(previous) do
            if bounds[name] == nil then
                invalidated[#invalidated + 1] = name
            end
        end
        for _, name in ipairs(invalidated) do
            previous[name] = nil
        end
        kernel.cursorBounds = previous

        return lowered
    end

    for _, authored in ipairs(statements) do
        local stat = authored
        local simdRequired = false
        while stat.kind == "pragmaStmt" do
            local pragma = stat as cst.PragmaStmt
            simdRequired = simdRequired or pragma.name ~= nil and (
                pragma.name as lexer.Token
            ).text == "simd" or (pragma.stat as any).simdRequired == true
            stat = pragma.stat as cst.Node
        end
        local expressionFrame = new lower.ExpressionFrame(output = out)
        kernel.expressionFrame = expressionFrame
        local firstStatement = #out + 1
        local frame = kernel.valueFrame
        local before = frame ~= nil and frame.yields or 0
        local kind = stat.kind
        if kind == "yieldStmt" then
            if frame == nil then
                context.reject(lower.site(stat), "yield requires an enclosing do expression")
            end
            local frame = frame as lower.ValueFrame
            local value = firstValue(
                lower.expression((stat as cst.YieldStmt).value as cst.Node, environment, kernel.index, kernel),
                kernel,
                out
            )
            local target = (frame as lower.ValueFrame).result
            if target == nil then
                target = new scalarIR.Name(
                    op = "local",
                    name = frame.done.name .. "_result",
                    cName = tostring(frame.done.cName) .. "_result",
                    type = value.type,
                    source = lower.site(stat)
                )
                frame.result = target
            end
            local assigned = assignValue(target as scalarIR.Name, value)
            frame.assignments[#frame.assignments + 1] = assigned.values[1]
            out[#out + 1] = assigned
            out[#out + 1] = assignValue(frame.done, new scalarIR.Bool(op = "bool", value = true, type = "bool"))
            frame.yields = frame.yields + 1
        elseif kind == "localStmt" then
            localStmt(stat as cst.LocalStmt, out, environment, kernel)
        elseif kind == "callStmt" then
            local statement = stat as cst.CallStmt
            local method = statement.expr ~= nil
                and statement.expr.kind == "methodCall"
                and statement.expr as cst.MethodCall
                or nil
            local phaseMethod = method ~= nil and kernel.phasesName ~= nil and lower.nameOf(
                (method as cst.MethodCall).obj
            ) == kernel.phasesName and (
                method as cst.MethodCall
            ).name ~= nil and ((method as cst.MethodCall).name as lexer.Token).text or nil
            if method ~= nil and phaseMethod == "reduceSumF32" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                local sharedName = #args == 1 and lower.nameOf(args[1]) or nil
                local shared = sharedName ~= nil and environment[sharedName as string] or nil
                local size = kernel.workgroupSize
                if shared == nil or shared.kind ~= "workgroup_shared" or shared.element ~= "f32" then
                    context.reject(lower.site(method), "phases:reduceSumF32 takes one f32 scratch array")
                end
                if size == nil or size < 1 or size & (size - 1) ~= 0 then
                    context.reject(lower.site(method), "fixed-tree reduction needs a power-of-two workgroup size")
                end
                local stride = (size as integer) // 2
                while stride > 0 do
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    local offset = new scalarIR.IntConstant(
                        op = "constant_i32",
                        value = tostring(stride),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local rightIndex = new scalarIR.Fixed(
                        op = "u32_add",
                        left = lane,
                        right = offset,
                        type = "u32",
                        source = lower.site(method)
                    )
                    local left = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sharedName as string,
                        index = lane,
                        type = "f32",
                        source = lower.site(method)
                    )
                    local right = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sharedName as string,
                        index = rightIndex,
                        type = "f32",
                        source = lower.site(method)
                    )
                    local write = new scalarIR.SharedStore(
                        op = "shared_store",
                        shared = sharedName as string,
                        index = lane,
                        value = new scalarIR.Fixed(
                            op = "f32_add",
                            left = left,
                            right = right,
                            type = "f32",
                            source = lower.site(method)
                        ),
                        source = lower.site(method)
                    )
                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.If(
                                op = "if",
                                clauses = {
                                    new scalarIR.Clause(
                                        condition = new scalarIR.Binary(
                                            op = "lt",
                                            left = lane,
                                            right = offset,
                                            type = "bool",
                                            source = lower.site(method)
                                        ),
                                        body = {write},
                                        source = lower.site(method)
                                    ),
                                },
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                    stride = stride // 2
                end
            elseif method ~= nil and phaseMethod == "inclusiveScanU32" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                local valuesName = #args == 2 and lower.nameOf(args[1]) or nil
                local temporaryName = #args == 2 and lower.nameOf(args[2]) or nil
                local values = valuesName ~= nil and environment[valuesName as string] or nil
                local temporary = temporaryName ~= nil and environment[temporaryName as string] or nil
                local size = kernel.workgroupSize
                if values == nil
                    or temporary == nil
                    or values.kind ~= "workgroup_shared"
                    or temporary.kind ~= "workgroup_shared"
                    or values.element ~= "u32"
                    or temporary.element ~= "u32"
                    or valuesName == temporaryName
                then
                    context.reject(lower.site(method), "phases:inclusiveScanU32 takes two distinct u32 scratch arrays")
                end
                if size == nil or size < 1 or size & (
                    size - 1
                ) ~= 0 or values.count ~= size or temporary.count ~= size then
                    context.reject(
                        lower.site(method),
                        "fixed scan needs two power-of-two arrays with one value per lane"
                    )
                end

                local sourceName = valuesName as string
                local targetName = temporaryName as string
                local offset = 1
                while offset < (size as integer) do
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    local distance = new scalarIR.IntConstant(
                        op = "constant_i32",
                        value = tostring(offset),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local current = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sourceName,
                        index = lane,
                        type = "u32",
                        source = lower.site(method)
                    )
                    local previous = new scalarIR.SharedLoad(
                        op = "shared_load",
                        shared = sourceName,
                        index = new scalarIR.Fixed(
                            op = "u32_sub",
                            left = lane,
                            right = distance,
                            type = "u32",
                            source = lower.site(method)
                        ),
                        type = "u32",
                        source = lower.site(method)
                    )
                    local accumulated = new scalarIR.Fixed(
                        op = "u32_add",
                        left = current,
                        right = previous,
                        type = "u32",
                        source = lower.site(method)
                    )

                    local function store(value: scalarIR.Expr): scalarIR.SharedStore
                        return new scalarIR.SharedStore(
                            op = "shared_store",
                            shared = targetName,
                            index = lane,
                            value = value,
                            source = lower.site(method)
                        )
                    end

                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.If(
                                op = "if",
                                clauses = {
                                    new scalarIR.Clause(
                                        condition = new scalarIR.Binary(
                                            op = "ge",
                                            left = lane,
                                            right = distance,
                                            type = "bool",
                                            source = lower.site(method)
                                        ),
                                        body = {store(accumulated)},
                                        source = lower.site(method)
                                    ),
                                },
                                elseBody = {store(current)},
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                    sourceName, targetName = targetName, sourceName
                    offset = offset * 2
                end
                if sourceName ~= valuesName then
                    local lane = new scalarIR.WorkgroupIndex(
                        op = "local_index",
                        type = "u32",
                        source = lower.site(method)
                    )
                    out[
                        #out + 1
                    ] = new scalarIR.Phase(
                        op = "phase",
                        body = {
                            new scalarIR.SharedStore(
                                op = "shared_store",
                                shared = valuesName as string,
                                index = lane,
                                value = new scalarIR.SharedLoad(
                                    op = "shared_load",
                                    shared = sourceName,
                                    index = lane,
                                    type = "u32",
                                    source = lower.site(method)
                                ),
                                source = lower.site(method)
                            ),
                        },
                        source = lower.site(stat)
                    )
                end
            elseif method ~= nil and phaseMethod == "run" then
                local args = (
                    method as cst.MethodCall
                ).args ~= nil and ((((method as cst.MethodCall).args as cst.Args).exprs or {})) or {}
                if #args ~= 1 or args[1].kind ~= "funcExpr" then
                    context.reject(lower.site(method), "phases:run takes one immediate function")
                end
                local callback = (args[1] as cst.FuncExpr).body as cst.Funcbody?
                local params = callback ~= nil and (callback as cst.Funcbody).params or {}
                if callback == nil or #params ~= 1 or (params[1] as cst.Param).name == nil then
                    context.reject(lower.site(args[1]), "a phase callback takes exactly one localIndex parameter")
                end
                local localName = ((params[1] as cst.Param).name as lexer.Token).text
                local inner = inherit(environment)
                inner[
                    localName
                ] = new scalarIR.WorkgroupIndex(op = "local_index", type = "u32", source = lower.site(params[1]))
                local previousPhase, previousLocal = kernel.inPhase, kernel.localIndexName
                kernel.inPhase = true
                kernel.localIndexName = localName
                local callbackBlock = (callback as cst.Funcbody).body as cst.Block?
                local lowered = lower.block(
                    callbackBlock ~= nil and (callbackBlock as cst.Block).stats or {},
                    inner,
                    kernel
                )
                kernel.inPhase = previousPhase
                kernel.localIndexName = previousLocal
                if #lowered == 0 then
                    context.reject(lower.site(args[1]), "a workgroup phase may not be empty")
                end
                if sharedPhaseCollision(lowered) ~= nil then
                    context.reject(lower.site(args[1]), "a phase cannot read another lane from scratch it also writes")
                end
                out[#out + 1] = new scalarIR.Phase(op = "phase", body = lowered, source = lower.site(stat))
            else
                local effect = lower.expression(statement.expr as cst.Node, environment, kernel.index, kernel)
                if effect.type ~= "lua_effect"
                    or tostring(effect.op):match("^lua_builder_") == nil
                    and effect.op ~= "lua_scratch_u32_set"
                    and effect.op ~= "lua_scratch_u8_set"
                    and effect.op ~= "lua_scratch_u8_set4"
                    and effect.op ~= "simd_store"
                    and effect.op ~= "simd_field_store"
                    and effect.op ~= "reducer_add"
                    and effect.op ~= "simd_reducer_add"
                    and effect.op ~= "lua_scratch_u8_reset" then
                    context.reject(lower.site(stat), "native element stores use output[index] = value")
                end
                out[#out + 1] = effect as scalarIR.Statement
            end
        elseif kind == "assignStmt" then
            assignStmt(stat as cst.AssignStmt, out, environment, kernel)
        elseif kind == "ifStmt" then
            local branch = stat as cst.IfStmt
            local clauses: {scalarIR.Clause} = {}
            local setups: {{scalarIR.Statement}} = {}
            -- A condition that is statically false -- a monomorphized const
            -- carrier comparison -- drops its clause without lowering the
            -- body; a statically true one absorbs everything after it.
            local decided = false
            for _, arm in ipairs(branch.clauses or {}) do
                local bindingToken = arm.binding
                if not decided and bindingToken ~= nil then
                    -- `if NAME = simd.species(...) then` is decided per tier:
                    -- a tier with vectors takes the arm with NAME bound to the
                    -- species, and one without drops the arm without lowering
                    -- it. Nothing else lowers to a nil-tested native value.
                    local bound = arm.cond as cst.Node
                    if bound.kind ~= "call" or calledIdentity(bound as cst.Call, kernel) ~= "nupp.simd.species" then
                        context.reject(lower.site(bound), "a native if binding takes simd.species only")
                    end
                    if context.vectors then
                        local value = lower.expression(bound, environment, kernel.index, kernel)
                        local inner = inherit(environment)
                        local binding = bind((bindingToken as lexer.Token).text, value.type, nil, arm, inner, kernel)
                        noteBinding((bindingToken as lexer.Token).text, value, binding, kernel)
                        local body: {
                            scalarIR.Statement
                        } = {
                            new scalarIR.Let(
                                op = "let",
                                name = binding.name,
                                cName = binding.cName,
                                type = value.type,
                                value = value,
                                source = lower.site(arm)
                            ),
                        }
                        local block = arm.body as cst.Block?
                        local stats = block ~= nil and (block as cst.Block).stats or {}
                        for _, lowered in ipairs(lower.block(stats, inner, kernel)) do
                            body[#body + 1] = lowered
                        end
                        clauses[
                            #clauses + 1
                        ] = new scalarIR.Clause(
                            condition = new scalarIR.Bool(
                                op = "bool",
                                value = true,
                                type = "bool",
                                source = lower.site(arm)
                            ),
                            body = body,
                            source = lower.site(arm)
                        )
                        decided = true
                    else
                        admitSpecies(bound as cst.Call, kernel)
                    end
                elseif not decided then
                    local condition, setup = lower.capture(arm.cond as cst.Node, environment, kernel.index, kernel)
                    condition = booleanValue(condition, kernel)
                    setups[#clauses + 1] = setup
                    if condition.type ~= "bool" then
                        context.reject(lower.site(arm.cond), "native branch conditions must be boolean")
                    end
                    local known = staticTruth(condition)
                    if known ~= false then
                        local cursorBounds = cursorBound(arm.cond, nil)
                        clauses[
                            #clauses + 1
                        ] = new scalarIR.Clause(
                            condition = condition,
                            body = nestedWithCursor(arm.body, cursorBounds),
                            cursorBounds = cursorBounds,
                            source = lower.site(arm)
                        )
                        if known == true then
                            decided = true
                        end
                    end
                end
            end

            local elseClause = branch.elseClause
            local elseBody = not decided and elseClause ~= nil and nested((elseClause as cst.ElseClause).body) or nil
            if #clauses == 0 and elseBody ~= nil then
                -- Every condition was statically false: the else is the
                -- whole statement, kept as one always-taken clause so block
                -- scoping and emission stay on the ordinary path.
                clauses[
                    1
                ] = new scalarIR.Clause(
                    condition = new scalarIR.Bool(op = "bool", value = true, type = "bool", source = lower.site(stat)),
                    body = elseBody,
                    source = lower.site(stat)
                )
                elseBody = nil
            end
            if #clauses > 0 then
                local hasSetup = false
                for _, setup in pairs(setups) do
                    hasSetup = hasSetup or #setup > 0
                end
                if hasSetup then
                    local tail = elseBody
                    for position = #clauses, 1, -1 do
                        local setup = setups[position] or {}
                        setup[
                            #setup + 1
                        ] = new scalarIR.If(
                            op = "if",
                            clauses = {clauses[position]},
                            elseBody = tail,
                            source = lower.site(stat)
                        )
                        tail = setup
                    end
                    for _, statement in ipairs(tail or {}) do
                        out[#out + 1] = statement
                    end
                else
                    out[
                        #out + 1
                    ] = new scalarIR.If(op = "if", clauses = clauses, elseBody = elseBody, source = lower.site(stat))
                end
            end
        elseif kind == "fornumStmt" then
            -- A bounded nested loop with an integer induction variable. The
            -- outer row loop already counts in an integer; a `while` over a
            -- number local does the same job with a double, which is a worse
            -- lowering of the same intent.
            local loop = stat as cst.FornumStmt
            if loop.step ~= nil then
                context.reject(lower.site(stat), "a native nested for loop takes no explicit step")
            end

            local from = forBound(
                lower.expression(loop.start as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            local to = forBound(
                lower.expression(loop.stop as cst.Node, environment, kernel.index, kernel),
                stat,
                kernel
            )
            if loop.var == nil then
                context.reject(lower.site(stat), "a native for loop needs an induction variable")
            end

            local inner = inherit(environment)
            local binding = bind((loop.var as lexer.Token).text, "i32", nil, stat, inner, kernel)
            local bounding = from.op == "constant_i32" and (
                tonumber((from as scalarIR.IntConstant).value) or 0
            ) >= 1 and to.op == "span_count" and (to as scalarIR.SpanCount).span or nil
            -- Inside the nested loop only its own bound proves an index access,
            -- whatever the enclosing map's guard prologue related to the map
            -- index: the verifier admits exactly `boundSpan` under a nested
            -- `fornum`, so lowering proves the same thing and refuses the rest
            -- at its line.
            local previousIndex, previousCName = kernel.index, kernel.indexCName
            local previousBound, previousMapEntry = kernel.boundSpan, kernel.mapEntry
            kernel.index = binding.name
            kernel.indexCName = binding.cName
            kernel.boundSpan = bounding
            kernel.mapEntry = false
            local previousBounds = kernel.cursorBounds
            local reassigned = assignedNames(loop.body, {})
            local loopBounds: scalarIR.CursorBounds = {}
            for name, spans in pairs(previousBounds) do
                if reassigned[name] ~= true then
                    loopBounds[name] = spans
                end
            end
            kernel.cursorBounds = loopBounds
            local previousSimdSource = kernel.simdSource
            local previousSimdRegion = kernel.simdRegion
            local authoredSimd = simdRequired or (loop as any).simdRequired == true
            if authoredSimd and previousSimdSource == true then
                context.reject(lower.site(stat), "an @simd loop cannot be nested in another @simd loop")
            end
            kernel.simdSource = authoredSimd
            if authoredSimd then
                kernel.nextSimdRegion = kernel.nextSimdRegion + 1
                kernel.simdRegion = kernel.nextSimdRegion
            else
                kernel.simdRegion = nil
            end
            local loopBody = lower.block(loop.body ~= nil and (loop.body as cst.Block).stats or {}, inner, kernel)
            kernel.simdSource = previousSimdSource
            kernel.simdRegion = previousSimdRegion
            for name in pairs(previousBounds) do
                if loopBounds[name] == nil then
                    previousBounds[name] = nil
                end
            end
            kernel.cursorBounds = previousBounds
            kernel.index = previousIndex
            kernel.indexCName = previousCName
            kernel.boundSpan = previousBound
            kernel.mapEntry = previousMapEntry
            out[
                #out + 1
            ] = new scalarIR.Fornum(
                op = "fornum",
                binding = binding,
                from = from,
                to = to,
                body = loopBody,
                carried = {},
                boundSpan = bounding,
                simdRequired = authoredSimd,
                source = lower.site(stat)
            )
        elseif kind == "whileStmt" then
            -- A nested loop the kernel controls itself, as distinct from the
            -- outer row loop the prototype supplies. Nothing here bounds its
            -- trip count: the condition is ordinary Nupp and termination is the
            -- source's business, exactly as it is when the same function runs as
            -- ordinary Nupp. That is a real difference from the outer loop,
            -- whose bounds the IR carries and the verifier checks.
            local loop = stat as cst.WhileStmt
            local condition, conditionBody = lower.capture(loop.cond as cst.Node, environment, kernel.index, kernel)
            condition = booleanValue(condition, kernel)
            if condition.type ~= "bool" then
                context.reject(lower.site(loop.cond), "native loop conditions must be boolean")
            end
            local cursorBounds = cursorBound(loop.cond, nil)
            out[
                #out + 1
            ] = new scalarIR.While(
                op = "while",
                condition = condition,
                conditionBody = #conditionBody > 0 and conditionBody or nil,
                body = nestedWithCursor(loop.body, cursorBounds, true),
                carried = {},
                cursorBounds = cursorBounds,
                source = lower.site(stat)
            )
        elseif kind == "repeatStmt" then
            -- A repeat body and its condition share one lexical scope: locals
            -- declared by the body are visible to the trailing `until`.
            local loop = stat as cst.RepeatStmt
            local inner = inherit(environment)
            local body = loop.body as cst.Block?
            local lowered = lower.block(body ~= nil and (body as cst.Block).stats or {}, inner, kernel)
            local condition, conditionBody = lower.capture(loop.cond as cst.Node, inner, kernel.index, kernel)
            condition = booleanValue(condition, kernel)
            if condition.type ~= "bool" then
                context.reject(lower.site(loop.cond), "native repeat conditions must be boolean")
            end
            out[
                #out + 1
            ] = new scalarIR.Repeat(
                op = "repeat",
                condition = condition,
                conditionBody = #conditionBody > 0 and conditionBody or nil,
                body = lowered,
                carried = {},
                source = lower.site(stat)
            )
        elseif kind == "doStmt" then
            -- A `do` block is the scope of an explicit SIMD region: masked
            -- reducer contributions inside it accumulate from its entry and
            -- fold into their reducers at its exit.
            local previousDo = kernel.simdDo
            kernel.nextSimdRegion = kernel.nextSimdRegion + 1
            local scope = new lower.SimdDo(region = kernel.nextSimdRegion, reducers = {}, byName = {})
            kernel.simdDo = scope
            local body = nested((stat as cst.DoStmt).body)
            kernel.simdDo = previousDo
            if #scope.reducers > 0 then
                out[
                    #out + 1
                ] = new scalarIR.SimdRegion(
                    op = "simd_region",
                    body = body,
                    reducers = scope.reducers,
                    source = lower.site(stat)
                )
            else
                out[#out + 1] = new scalarIR.Block(op = "block", body = body, source = lower.site(stat))
            end
        elseif kind == "breakStmt" then
            out[#out + 1] = new scalarIR.Break(op = "break", source = lower.site(stat))
        elseif kind == "continueStmt" then
            out[#out + 1] = new scalarIR.Continue(op = "continue", source = lower.site(stat))
        elseif kind == "returnStmt" then
            local returned = stat as cst.ReturnStmt
            local exprs = returned.exprs or {}
            if #exprs ~= #kernel.resultTypes then
                context.reject(lower.site(stat), "native return count does not match the function result")
            end
            local values: {scalarIR.Expr} = {}
            for position, expression in ipairs(exprs) do
                local returnedName = lower.nameOf(expression)
                local returnedBinding = returnedName ~= nil and environment[returnedName as string] or nil
                if returnedBinding ~= nil and returnedBinding.type == "lua_string_buffer" then
                    values[
                        position
                    ] = new scalarIR.LuaStringBufferFinish(
                        op = "lua_string_buffer_finish",
                        buffer = new scalarIR.Name(
                            op = "local",
                            name = returnedBinding.name,
                            cName = returnedBinding.cName,
                            type = "lua_string_buffer",
                            source = lower.site(expression)
                        ),
                        type = "lua_string",
                        source = lower.site(expression)
                    )
                else
                    values[
                        position
                    ] = lower.convert(
                        lower.expression(expression, environment, kernel.index ~= "" and kernel.index or nil, kernel),
                        kernel.resultTypes[position],
                        lower.site(expression),
                        context
                    )
                end
            end
            out[#out + 1] = new scalarIR.Return(op = "return", values = values, source = lower.site(stat))
        else
            context.reject(
                lower.site(stat),
                "statement kind " .. tostring(kind) .. " is not admitted in the native loop"
            )
        end
        if next(expressionFrame.replacements) ~= nil then
            local function rewrite(child: scalarIR.Expr): scalarIR.Expr
                local replacement = expressionFrame.replacements[child]
                if replacement ~= nil then
                    return replacement
                end
                local copy: {[string]: any} = {}
                for key, value in pairs(child as any) do
                    copy[key] = value
                end
                visit.expressionChildren(copy as any, rewrite)

                return copy as any
            end

            for position = firstStatement, #out do
                local statement = out[position]
                local captured = statement.op == "let" and expressionFrame.replacements[statement.value] or nil
                if captured == nil or (captured as scalarIR.Name).cName ~= (statement as any).cName then
                    visit.statementExpressions(statement, rewrite)
                end
            end
        end
        kernel.expressionFrame = nil
        if frame ~= nil and frame.yields > before then
            local rest: {scalarIR.Statement} = {}
            out[#out + 1] = guarded(negate(frame.done), rest)
            out = rest
            kernel.pending = out
        end
    end
    kernel.pending, kernel.expressionFrame = previous, parent

    return root
end

----------------------------------------------------------------------------
-- Parameters and regions
----------------------------------------------------------------------------

--- The span one `#x` names, if the node is that.
function lower.dotCount(node: cst.Node?): string?
    if node == nil or node.kind ~= "unop" then
        return nil
    end
    local length = node as cst.Unop
    if length.op == nil or (length.op as lexer.Token).text ~= "#" then
        return nil
    end

    return lower.nameOf(length.operand)
end

--- What the kernel prototype declares.
record lower.Signature
    --- Every parameter, in order.
    params: {scalarIR.Param}

    --- The same, by name.
    byName: {[string]: scalarIR.Param}

    --- Only the spans, in order, which is the order their regions are numbered.
    spans: {scalarIR.Param}

    --- The writable spans. The first is the primary output, whose length bounds
    --- the loop.
    writes: {scalarIR.Param}

    --- The readable spans.
    reads: {scalarIR.Param}
end

--- Admits the kernel prototype's parameters.
---
--- Ownership is not inferred from use: a writable span has to be written
--- `exclusive` and a readable one `borrows`, because the alias facts the
--- generated C rests on are those borrows restated, and a mode this had to guess
--- would be a `restrict` nobody proved.
function lower.parameters(
    raws: {cst.Param},
    checkedSignature: any?,
    declarations: {[string]: cst.RecordDecl},
    layouts: lower.Layouts,
    context: lower.Context,
    useSignatureTypes: boolean?,
    omitted: {[integer]: boolean}?
): lower.Signature
    local signature = new lower.Signature(params = {}, byName = {}, spans = {}, writes = {}, reads = {})
    for position, raw in ipairs(raws) do
        if omitted ~= nil and omitted[position] == true then
            goto continue
        end
        local name = raw.name ~= nil and (raw.name as lexer.Token).text or nil
        if name == nil then
            context.reject(lower.site(raw), "every kernel parameter must be named")
        end
        if signature.byName[name as string] ~= nil then
            context.reject(lower.site(raw), "duplicate kernel parameter " .. (name as string))
        end

        local spelling = lower.compactType(raw.type)
        local resolved = useSignatureTypes == true and checkedSignature ~= nil and checkedSignature.params[
            position
        ] or checkedType(raw.type, context)
        local mode = context.checked and checkedSignature ~= nil and checkedSignature.paramModes[
            position
        ] or raw.modeTok ~= nil and (raw.modeTok as lexer.Token).text or nil
        local sourceType = context.checked and sourceSpelling(resolved) or spelling
        local valueType = context.checked and semanticValueType(resolved) or lower.sourceValueType(spelling)
        local at = raw.type or raw
        local writeElement = lower.spanElement(spelling, resolved, "WriteSpan", at, declarations, layouts, context)
        local readElement = lower.spanElement(spelling, resolved, "Span", at, declarations, layouts, context)
        if writeElement ~= nil
            and tostring((writeElement as lower.Element).type):match("^simd_") ~= nil
            or readElement ~= nil
            and tostring((readElement as lower.Element).type):match("^simd_") ~= nil then
            context.reject(lower.site(raw), "explicit SIMD values cannot be stored in an AOT entry span")
        end
        local region = "r" .. tostring(#signature.spans)

        local param: scalarIR.Param
        if writeElement ~= nil then
            if mode ~= "exclusive" then
                context.reject(lower.site(raw), "a writable native span must be declared exclusive")
            end
            param = new scalarIR.Param(
                kind = "write_span",
                name = name as string,
                type = (writeElement as lower.Element).type,
                sourceType = (writeElement as lower.Element).sourceType,
                spanModule = (writeElement as lower.Element).spanModule,
                region = region,
                access = "readwrite",
                ownership = "exclusive",
                source = lower.site(raw)
            )
            param.element = writeElement
            signature.writes[#signature.writes + 1] = param
            signature.spans[#signature.spans + 1] = param
        elseif readElement ~= nil then
            if mode ~= "borrows" then
                context.reject(lower.site(raw), "a readable native span must be declared borrows")
            end
            param = new scalarIR.Param(
                kind = "read_span",
                name = name as string,
                type = (readElement as lower.Element).type,
                sourceType = (readElement as lower.Element).sourceType,
                spanModule = (readElement as lower.Element).spanModule,
                region = region,
                access = "read",
                ownership = "shared",
                source = lower.site(raw)
            )
            param.element = readElement
            signature.reads[#signature.reads + 1] = param
            signature.spans[#signature.spans + 1] = param
        elseif valueType == "f32" or valueType == "f64" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a uniform float parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "u32" or valueType == "i32" or valueType == "u64" or valueType == "i64" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a uniform integer parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "bool" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a boolean parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "uniform",
                name = name as string,
                type = "bool",
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "lua_string" or valueType == "lua_bytes" then
            if valueType == "lua_string" and mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "a string parameter has no ownership mode")
            elseif valueType == "lua_bytes" and mode ~= "borrows" then
                context.reject(lower.site(raw), "a string-or-buffer parameter must be declared borrows")
            end
            param = new scalarIR.Param(
                kind = "scalar",
                name = name as string,
                type = valueType,
                sourceType = sourceType,
                source = lower.site(raw)
            )
        elseif valueType == "lua_value" then
            if mode ~= nil and mode ~= "plain" then
                context.reject(lower.site(raw), "an opaque Lua value parameter has no ownership mode")
            end
            param = new scalarIR.Param(
                kind = "scalar",
                name = name as string,
                type = "lua_value",
                sourceType = sourceType,
                source = lower.site(raw)
            )
        else
            context.reject(lower.site(at), "parameter type " .. sourceType .. " is not admitted")
            param = new scalarIR.Param(kind = "uniform", name = name as string, type = "f64")
        end

        signature.params[#signature.params + 1] = param
        signature.byName[name as string] = param
        ::continue::
    end

    return signature
end

--- The borrow regions, and the complete alias matrix over them.
---
--- Every pair carries a fact rather than only the interesting ones: a pair with
--- no fact is a `restrict` nobody justified, and the verifier checks the count.
function lower.regions(spans: {scalarIR.Param}): ({scalarIR.Region}, {scalarIR.AliasFact})
    local regions: {scalarIR.Region} = {}
    for position, param in ipairs(spans) do
        regions[
            position
        ] = new scalarIR.Region(
            id = param.region as string,
            param = param.name,
            access = param.access as any,
            proof = tostring(param.ownership) .. "_borrow"
        )
    end

    local facts: {scalarIR.AliasFact} = {}
    for left = 1, #spans do
        for right = left + 1, #spans do
            local hasWrite = spans[left].kind == "write_span" or spans[right].kind == "write_span"
            facts[
                #facts + 1
            ] = new scalarIR.AliasFact(
                relation = hasWrite and "disjoint" or "may_alias",
                left = spans[left].region as string,
                right = spans[right].region as string,
                proof = hasWrite and "exclusive_borrow" or "shared_borrows"
            )
        end
    end

    return regions, facts
end

----------------------------------------------------------------------------
-- Guards
----------------------------------------------------------------------------

--- The one clause of a guard that does nothing but call `error`.
---
--- Both source forms have this shape, and it is the shape that makes a guard
--- readable: the polarity its condition holds in on fallthrough is only known
--- because the branch that does not fall through cannot return.
function lower.isGuardStatement(stat: cst.Node?): boolean
    if stat == nil then
        return false
    end
    if stat.kind == "ifStmt" then
        return true
    end
    local called = stat.kind == "callStmt" and (stat as cst.CallStmt).expr or nil

    return called ~= nil and called.kind == "call" and (called as cst.Call).aotGuardBuiltin == "assert"
end

--- Whether dropping one already-evaluated guard argument changes no behavior.
local function inertGuardArgument(node: cst.Node?): boolean
    if node == nil then
        return true
    end
    if node.kind == "paren" then
        return inertGuardArgument((node as cst.Paren).expr)
    end

    return node.kind == "string"
        or node.kind == "number"
        or node.kind == "nilExpr"
        or node.kind == "trueExpr"
        or node.kind == "falseExpr"
end

--- One precondition and the polarity it was written in, or nothing.
---
--- Nothing rather than a refusal. A statement that is not a guard is how a
--- function says it is not a map kernel, and lowering answers that by compiling
--- it as an ordinary block, which compiles the statement rather than consuming
--- it as a fact. Only a kernel that commits to the map shape is refused.
function lower.guardForm(stat: cst.Node?): lower.GuardForm?
    if stat == nil then
        return nil
    end
    local asserted = stat.kind == "callStmt" and (stat as cst.CallStmt).expr or nil
    if asserted ~= nil and asserted.kind == "call" and (asserted as cst.Call).aotGuardBuiltin == "assert" then
        local args = (asserted as cst.Call).args
        local exprs = args ~= nil and args.kind == "args" and ((args as cst.Args).exprs or {}) or {}
        if #exprs < 1 or #exprs > 2 or exprs[1] == nil then
            return nil
        end

        return new lower.GuardForm(
            cond = exprs[1],
            asserted = true,
            discarded = exprs[2] ~= nil and not inertGuardArgument(exprs[2]) and exprs[2] or nil
        )
    end
    if stat.kind ~= "ifStmt" then
        return nil
    end

    local branch = stat as cst.IfStmt
    if #(branch.clauses or {}) ~= 1 or branch.elseClause ~= nil then
        return nil
    end

    local clause = (branch.clauses as {cst.IfClause})[1]
    local body = clause.body ~= nil and (clause.body as cst.Block).stats or {}
    local first = body[1]
    local call = first ~= nil and first.kind == "callStmt" and (first as cst.CallStmt).expr or nil
    if #body ~= 1 or call == nil or call.kind ~= "call" or (
        call as cst.Call
    ).aotGuardBuiltin ~= "error" or clause.cond == nil then
        return nil
    end

    local args = (call as cst.Call).args
    local exprs = args ~= nil and args.kind == "args" and ((args as cst.Args).exprs or {}) or {}
    local discarded: cst.Node? = nil
    for _, argument in ipairs(exprs) do
        if not inertGuardArgument(argument) then
            discarded = argument
            break
        end
    end

    return new lower.GuardForm(cond = clause.cond, asserted = false, discarded = discarded)
end

--- One written clause as a diagnostic quotes it: on one line, spaced as it was.
local function quoted(node: cst.Node?): string
    if node == nil then
        return ""
    end
    local collapsed = cst.textOf(node as cst.Child):gsub("%s+", " ")

    return (collapsed:match("^%s*(.-)%s*$") or collapsed) as string
end

--- One integer literal, as a guard may offset a term by it.
local function guardLiteral(node: cst.Node?): integer?
    if node == nil then
        return nil
    end
    if node.kind == "unop" then
        local unary = node as cst.Unop
        local operator = unary.op ~= nil and (unary.op as lexer.Token).text or ""
        if operator ~= "-" then
            return nil
        end
        local magnitude = guardLiteral(unary.operand)
        return magnitude ~= nil and -(magnitude as integer) or nil
    end
    if node.kind ~= "number" then
        return nil
    end
    local token = (node as cst.NumberLit).token
    local text = token ~= nil and (token as lexer.Token).text or ""
    if text:match("^%d[%d_]*$") == nil and text:match("^0[xX][%da-fA-F_]+$") == nil then
        return nil
    end
    local value = tonumber((text:gsub("_", "")))
    if value == nil or (value as number) > relations.MAX_OFFSET then
        return nil
    end

    return (value as number) as integer
end

--- The atom and constant one guard operand is, or nothing when it is not one.
---
--- Total over what it admits and silent about everything else. A field path, a
--- call, a product of two names -- each returns nothing here, and the caller
--- names the clause it came from rather than reading it as a weaker fact.
function lower.guardTerm(node: cst.Node?, signature: lower.Signature): (scalarIR.Term?, integer)
    if node == nil then
        return nil, 0
    end
    if node.kind == "paren" then
        return lower.guardTerm((node as cst.Paren).expr, signature)
    end

    local literal = guardLiteral(node)
    if literal ~= nil then
        return relations.zero(), literal as integer
    end
    if node.kind == "name" then
        local name = lower.nameOf(node)
        local param = name ~= nil and signature.byName[name as string] or nil
        if param == nil or (param as scalarIR.Param).kind ~= "uniform" then
            return nil, 0
        end
        -- Every rewrite below turns a strict comparison into a non-strict one by
        -- moving one, which is true on the integers and false on `number`. That
        -- is why the domain is the integral parameters and nothing else.
        local sourceType = (param as scalarIR.Param).sourceType
        if sourceType ~= "integer" and sourceType ~= "int32" and sourceType ~= "uint32" then
            return nil, 0
        end

        return relations.uniform(name as string), 0
    end

    local counted = lower.dotCount(node)
    if counted ~= nil then
        local param = signature.byName[counted as string]
        if param == nil or (param as scalarIR.Param).region == nil then
            return nil, 0
        end

        return relations.count(counted as string), 0
    end
    if node.kind ~= "binop" then
        return nil, 0
    end

    local operator = node as cst.Binop
    local text = operator.op ~= nil and (operator.op as lexer.Token).text or ""
    if text ~= "+" and text ~= "-" then
        return nil, 0
    end

    local leftTerm, leftConstant = lower.guardTerm(operator.lhs, signature)
    local rightTerm, rightConstant = lower.guardTerm(operator.rhs, signature)
    if leftTerm == nil or rightTerm == nil then
        return nil, 0
    end
    local signed = text == "+" and rightConstant or -rightConstant
    if (rightTerm as scalarIR.Term).kind == "zero" then
        return leftTerm, leftConstant + signed
    end
    if (leftTerm as scalarIR.Term).kind == "zero" and text == "+" then
        return rightTerm, leftConstant + rightConstant
    end

    return nil, 0
end

--- What one comparison means once the polarity it sits under is applied.
local NEGATED: {
    [string]: string
} = {["<="] = ">", ["<"] = ">=", [">="] = "<", [">"] = "<=", ["=="] = "~=", ["~="] = "=="}

--- The relations one admitted comparison states, or nothing.
---
--- On integers `a < b` is `a <= b - 1` and `a > b` is `b <= a - 1`, so every
--- admitted operator normalizes without weakening. `~=` states no bound in
--- either direction and is therefore not admitted.
local function guardComparison(
    node: cst.Node,
    polarity: boolean,
    signature: lower.Signature,
    out: {scalarIR.Relation}
): boolean
    local operator = node as cst.Binop
    local written = operator.op ~= nil and (operator.op as lexer.Token).text or ""
    local text = polarity and written or NEGATED[written] or ""
    if text == "" or text == "~=" then
        return false
    end

    local leftTerm, leftConstant = lower.guardTerm(operator.lhs, signature)
    local rightTerm, rightConstant = lower.guardTerm(operator.rhs, signature)
    if leftTerm == nil or rightTerm == nil then
        return false
    end
    local left, right = leftTerm as scalarIR.Term, rightTerm as scalarIR.Term
    local source = lower.site(node)
    local forward = rightConstant - leftConstant
    local backward = leftConstant - rightConstant
    local firstOffset: integer
    local secondOffset: integer? = nil
    if text == "<=" then
        firstOffset = forward
    elseif text == "<" then
        firstOffset = forward - 1
    elseif text == ">=" then
        firstOffset = backward
        left, right = right, left
    elseif text == ">" then
        firstOffset = backward - 1
        left, right = right, left
    elseif text == "==" then
        firstOffset = forward
        secondOffset = backward
    else
        return false
    end
    if firstOffset > relations.MAX_OFFSET or firstOffset < -relations.MAX_OFFSET then
        return false
    end
    if secondOffset ~= nil and (
        (secondOffset as integer) > relations.MAX_OFFSET or (secondOffset as integer) < -relations.MAX_OFFSET
    ) then
        return false
    end
    out[#out + 1] = relations.relation(left, right, firstOffset, source)
    if secondOffset ~= nil then
        out[#out + 1] = relations.relation(right, left, secondOffset as integer, source)
    end

    return true
end

--- Every fact one condition states, under the polarity it is known in.
---
--- Total or nothing: the clause that cannot be read is returned, and the caller
--- answers that rather than admitting a kernel whose wrapper would silently drop
--- the precondition that clause was.
function lower.guardFacts(
    node: cst.Node?,
    polarity: boolean,
    signature: lower.Signature,
    out: {scalarIR.Relation}
): cst.Node?
    if node == nil then
        return node
    end
    if node.kind == "paren" then
        return lower.guardFacts((node as cst.Paren).expr, polarity, signature, out)
    end
    if node.kind == "unop" then
        local unary = node as cst.Unop
        if unary.op ~= nil and (unary.op as lexer.Token).text == "not" then
            return lower.guardFacts(unary.operand, not polarity, signature, out)
        end

        return node
    end
    if node.kind == "binop" then
        local operator = node as cst.Binop
        local text = operator.op ~= nil and (operator.op as lexer.Token).text or ""
        -- A known-true `and` says both sides hold and a known-false `or` says
        -- neither does. The other two say only that one side did, which is not a
        -- fact about either, so a clause in that position is one that cannot be
        -- read rather than one that may be skipped.
        if text == (polarity and "and" or "or") then
            return lower.guardFacts(
                operator.lhs,
                polarity,
                signature,
                out
            ) or lower.guardFacts(operator.rhs, polarity, signature, out)
        end
        if NEGATED[text] ~= nil then
            if guardComparison(node, polarity, signature, out) then
                return nil
            end

            return node
        end
    end

    return node
end

--- What reading a kernel's guard prefix produced.
record lower.GuardReading
    --- The facts, canonical and deduplicated, when every clause was read.
    relations: {scalarIR.Relation}

    --- Why the prefix could not be read as facts, when it could not be.
    reason: string?

    --- Where that was, when it was one clause rather than the whole prefix.
    at: scalarIR.Source?

    --- Whether the body had committed to being a map kernel by the time the
    --- reading stopped.
    ---
    --- A statement that is not a guard at all says the body is something else,
    --- and lowering answers that by compiling it as a block. A guard whose
    --- clause cannot be read says the body meant to be a map kernel and its
    --- precondition would be dropped, and the block path admits neither
    --- `assert` nor `error` -- so there is nothing to fall back to, and the
    --- refusal that names the clause is the useful answer.
    committed: boolean = false
end

--- The facts a kernel's leading guard statements state.
function lower.readGuards(statements: {cst.Node}, upTo: integer, signature: lower.Signature): lower.GuardReading
    local pool: {scalarIR.Relation} = {}
    local committed = false
    for position = 1, upTo do
        local form = lower.guardForm(statements[position])
        if form == nil then
            return new lower.GuardReading(
                relations = {},
                reason = "a guard must be `assert(...)` or `if ... then error(...) end`",
                at = lower.site(statements[position])
            )
        end
        committed = true
        if (form as lower.GuardForm).discarded ~= nil then
            local discarded = (form as lower.GuardForm).discarded
            return new lower.GuardReading(
                relations = {},
                reason = "`" .. quoted(
                    discarded
                ) .. "` cannot be discarded from a guard; its message and level arguments must be literals",
                at = lower.site(discarded),
                committed = true
            )
        end
        local failed = lower.guardFacts(
            (form as lower.GuardForm).cond,
            (form as lower.GuardForm).asserted,
            signature,
            pool
        )
        if failed ~= nil then
            return new lower.GuardReading(
                relations = {},
                reason = "`" .. quoted(
                    failed
                )
                .. "` cannot be read as a guard: a guard compares integer parameters, integer literals and span lengths, offset by a literal",
                at = lower.site(failed),
                committed = true
            )
        end
        if #pool > relations.BUDGET then
            return new lower.GuardReading(
                relations = {},
                reason = "a kernel's guards may state at most " .. tostring(relations.BUDGET) .. " relations",
                at = lower.site(statements[position]),
                committed = true
            )
        end
    end

    return new lower.GuardReading(relations = relations.canonical(pool), committed = committed)
end

--- Every term a kernel's signature can state a relation about.
function lower.guardTerms(signature: lower.Signature): {scalarIR.Term}
    local terms: {scalarIR.Term} = {relations.zero()}
    for _, param in ipairs(signature.params) do
        if param.region ~= nil then
            terms[#terms + 1] = relations.count(param.name)
        elseif param.kind == "uniform" then
            terms[#terms + 1] = relations.uniform(param.name)
        end
    end

    return terms
end

--- The shape of an admitted map loop, before anything about it is proved.
record lower.LoopShape
    index: string

    --- The uniform it starts at, or nothing when it starts at `1`.
    first: string?

    --- The uniform it stops at, or nothing when it stops at a span's length.
    last: string?

    --- The span whose length it stops at, when it stops at one.
    stopSpan: string?
end

--- The statement beneath any source annotations. The checker has already
--- validated those applications and attached their semantic facts to this
--- innermost statement; the wrappers have no AOT operation of their own.
local function annotatedStatement(node: cst.Node?): cst.Node?
    while node ~= nil and node.kind == "pragmaStmt" do
        node = (node as cst.PragmaStmt).stat
    end

    return node
end

--- The loop one map kernel is, if the final statement is one.
---
--- Two admitted forms: the whole of a span, and a range named by two uniforms.
--- Anything else -- a step, a mixed pair of bounds, a bound that is neither --
--- is not this shape, which is a fact about the loop rather than a failed proof
--- and so declines the map path rather than refusing the kernel.
function lower.loopShape(loop: cst.Node?, signature: lower.Signature): lower.LoopShape?
    loop = annotatedStatement(loop)
    if loop == nil or loop.kind ~= "fornumStmt" then
        return nil
    end
    local counted = loop as cst.FornumStmt
    if counted.step ~= nil or counted.var == nil then
        return nil
    end

    local index = (counted.var as lexer.Token).text
    local startName = lower.nameOf(counted.start)
    local startLiteral = guardLiteral(counted.start)
    local stopName = lower.nameOf(counted.stop)
    local stopSpan = lower.dotCount(counted.stop)
    if startLiteral == 1 and stopSpan ~= nil then
        local param = signature.byName[stopSpan as string]
        if param == nil or (param as scalarIR.Param).region == nil then
            return nil
        end

        return new lower.LoopShape(index = index, stopSpan = stopSpan)
    end
    if startName == nil or stopName == nil then
        return nil
    end
    -- The IR carries these two as names the emitted C reads directly, and the
    -- verifier holds them to `integer`, so a narrower integral uniform may state
    -- a relation without being admitted as a bound.
    local from = signature.byName[startName as string]
    local to = signature.byName[stopName as string]
    if from == nil or to == nil or (
        from as scalarIR.Param
    ).kind ~= "uniform" or (
        to as scalarIR.Param
    ).kind ~= "uniform" or (
        from as scalarIR.Param
    ).sourceType ~= "integer" or (to as scalarIR.Param).sourceType ~= "integer" then
        return nil
    end

    return new lower.LoopShape(index = index, first = startName, last = stopName)
end

--- One bound a map loop needs, and the relation that would establish it.
record lower.Obligation
    --- What the diagnostic calls it, in the source's own terms.
    needed: string

    left: scalarIR.Term
    right: scalarIR.Term
    offset: integer
end

--- What a loop over `primary` obliges its guards to have proved.
---
--- The loop names the range; the guards name nothing. Asking which two of a
--- pool of facts are the bounds has no answer the loop does not already give,
--- so the obligations come from here and the facts are only asked whether they
--- imply them.
function lower.loopObligations(shape: lower.LoopShape, primary: string): {lower.Obligation}
    local count = relations.count(primary)
    if shape.first == nil then
        local span = shape.stopSpan as string
        if span == primary then
            return {}
        end
        local other = relations.count(span)

        return {
            new lower.Obligation(needed = "#" .. span .. " <= #" .. primary, left = other, right = count, offset = 0),
            new lower.Obligation(needed = "#" .. primary .. " <= #" .. span, left = count, right = other, offset = 0),
        }
    end

    local first = relations.uniform(shape.first as string)
    local last = relations.uniform(shape.last as string)

    return {
        new lower.Obligation(
            needed = "1 <= " .. tostring(shape.first),
            left = relations.zero(),
            right = first,
            offset = -1
        ),
        new lower.Obligation(
            needed = tostring(shape.last) .. " <= #" .. primary,
            left = last,
            right = count,
            offset = 0
        ),
        new lower.Obligation(
            needed = tostring(shape.first) .. " <= " .. tostring(shape.last) .. " + 1",
            left = first,
            right = last,
            offset = 1
        ),
    }
end

--- Whether one body is a map kernel, and everything deciding it took.
---
--- Three outcomes, and the difference between the last two is the whole of the
--- admission policy. Admitted: the facts imply the loop's bounds. Declined: the
--- body is not this shape, or states something that cannot be read as a fact,
--- so it compiles as an ordinary block -- which compiles the guards rather than
--- consuming them, and is therefore sound whatever they said. Refused: the body
--- committed to the range form and the facts do not imply its bounds, which is
--- the one case where the programmer wrote a map kernel and it does not hold.
record lower.MapAdmission
    --- The loop, when the body was admitted.
    shape: lower.LoopShape?

    --- The facts the guard prefix stated, which the wrapper will enforce.
    relations: {scalarIR.Relation}

    --- The length agreements those facts prove against the primary output.
    guards: {scalarIR.Guard}

    --- The range the loop named, when it named one.
    rangeGuard: scalarIR.RangeGuard?

    --- Why the map shape was declined, when it was.
    declined: string?

    declinedAt: scalarIR.Source?

    --- Whether the body had committed to the map shape when it was declined,
    --- which is what decides between compiling it as a block and refusing it.
    committed: boolean = false

    --- The bound the facts did not imply, when the kernel committed and one was
    --- not proved.
    unproved: lower.Obligation?

    --- What was read out of the guards, for the diagnostic that has to say what
    --- it did understand as well as what it needed.
    understood: {scalarIR.Relation}
end

--- The span names a signature declares, in order.
local function spanNames(signature: lower.Signature): {string}
    local names: {string} = {}
    for _, span in ipairs(signature.spans) do
        names[#names + 1] = span.name
    end

    return names
end

function lower.admitMap(statements: {cst.Node}, signature: lower.Signature): lower.MapAdmission
    local primary = signature.writes[1]
    local shape = lower.loopShape(statements[#statements], signature)
    if shape == nil then
        return new lower.MapAdmission(
            relations = {},
            guards = {},
            understood = {},
            declined = "a map kernel is a guard prefix and one counted loop over a span or a uniform range",
            declinedAt = lower.site(statements[#statements])
        )
    end

    local reading = lower.readGuards(statements, #statements - 1, signature)
    if reading.reason ~= nil then
        return new lower.MapAdmission(
            relations = {},
            guards = {},
            understood = {},
            declined = reading.reason,
            declinedAt = reading.at,
            committed = reading.committed
        )
    end

    local closure = relations.solve(reading.relations, spanNames(signature), lower.guardTerms(signature))
    if closure.contradiction ~= nil then
        -- Everything follows from a contradiction, including the loop's bounds,
        -- so admitting one would admit a kernel whose guards can never pass.
        return new lower.MapAdmission(
            relations = {},
            guards = {},
            understood = reading.relations,
            declined = "these guards cannot all hold at once, so nothing follows from them",
            declinedAt = lower.site(statements[1]),
            committed = reading.committed
        )
    end

    local loop = shape as lower.LoopShape
    for _, obligation in ipairs(lower.loopObligations(loop, primary.name)) do
        if relations.proves(closure, obligation.left, obligation.right, obligation.offset) == nil then
            if loop.first == nil then
                -- A loop over a span nothing relates to the primary output is
                -- not a map over that output. A fact about the loop rather than
                -- a failed proof, so it declines rather than refusing.
                return new lower.MapAdmission(
                    relations = {},
                    guards = {},
                    understood = reading.relations,
                    declined = "the loop does not run over the primary output's length",
                    declinedAt = lower.site(statements[#statements]),
                    committed = reading.committed
                )
            end

            return new lower.MapAdmission(
                relations = reading.relations,
                guards = {},
                understood = reading.relations,
                unproved = obligation
            )
        end
    end

    -- Discovered rather than obliged. The set of spans the body may index at the
    -- loop counter is seeded from these, so the required set cannot be known
    -- before the guards are read -- deriving it from lowering and then checking
    -- the guards against it would be circular. Building the closure first and
    -- reading the agreements out of it is not.
    local guards: {scalarIR.Guard} = {}
    for _, span in ipairs(signature.spans) do
        if span.name ~= primary.name and relations.equalCounts(closure, primary.name, span.name) then
            local proof = relations.proves(closure, relations.count(span.name), relations.count(primary.name), 0)
            local contributing = proof ~= nil and proof as {scalarIR.Relation} or {}
            guards[
                #guards + 1
            ] = new scalarIR.Guard(
                op = "equal_count",
                left = primary.name,
                right = span.name,
                source = #contributing > 0 and contributing[1].source or nil
            )
        end
    end

    local rangeGuard: scalarIR.RangeGuard? = nil
    if loop.first ~= nil then
        rangeGuard = new scalarIR.RangeGuard(
            first = loop.first as string,
            last = loop.last as string,
            count = primary.name,
            source = lower.site(statements[#statements])
        )
    end

    return new lower.MapAdmission(
        shape = shape,
        relations = reading.relations,
        guards = guards,
        rangeGuard = rangeGuard,
        understood = reading.relations
    )
end

--- The refusal a committed map kernel whose bounds are not proved reports.
---
--- Says what was needed and what was read, rather than a form to copy: the two
--- together are the gap in the argument, and a fixed source form would not be.
function lower.unprovedMessage(admission: lower.MapAdmission): string
    local understood: {string} = {}
    for _, relation in ipairs(admission.understood) do
        local at = relation.source
        understood[
            #understood + 1
        ] = "`" .. relations.text(
            relation
        ) .. "`" .. (
            at ~= nil and (
                " (" .. tostring((at as scalarIR.Source).line) .. ":" .. tostring((at as scalarIR.Source).column) .. ")"
            ) or ""
        )
    end

    return "the loop range is not proved: needed `" .. (
        admission.unproved as lower.Obligation
    ).needed .. "`, understood " .. (#understood > 0 and table.concat(understood, ", ") or "nothing")
end

----------------------------------------------------------------------------
-- Scanning a module into a program
----------------------------------------------------------------------------

--- One `@aot` application: the annotation chain, and what it decorates.
record lower.Application
    --- The annotations, outermost first. They stack, so `@aot` may be written
    --- above or below `@relax` and both orders mean the same thing.
    chain: {cst.PragmaStmt}

    --- The statement at the end of the chain.
    tail: cst.Node?

    --- The outermost annotation, for a diagnostic that has to name the whole
    --- application.
    at: cst.PragmaStmt
end

--- One checked const-generic application lowered as its own native body.
--- Discovery and budgeting happen once for the deliverable; this carries the
--- selected private ABI and constant environment into ordinary AOT lowering.
record lower.Specialization
    name: string
    signature: any
    values: {[string]: scalarIR.Expr}
    omitted: {[integer]: boolean}
end

--- What one module offers this backend.
record lower.Declarations
    applications: {lower.Application}

    --- Visible local functions, which is where a pure helper comes from.
    helpers: {[string]: cst.LocalFuncStmt}

    --- The file's own `@aot` declarations, by name. A call from one compiled
    --- body to another is a real call to that entry's own symbol rather than an
    --- inlined helper, so the callee is compiled once and keeps its contract.
    entries: {[string]: cst.LocalFuncStmt}

    --- Visible local structs, which is what a span may hold.
    structs: {[string]: cst.RecordDecl}

    --- Module values and exact compiler intrinsics visible to every function.
    modules: {[string]: string}

    intrinsicAliases: {[string]: string}

    constantNumbers: {[string]: string}
end

--- Finds the `@aot` functions, and what they may call and hold.
---
--- @param checked whether the tree came from the real checker, which records
---   `@aot` as a fact on the body rather than leaving it to be read off the
---   annotation
function lower.scan(chunk: cst.Chunk, checked: boolean): lower.Declarations
    local found = new lower.Declarations(
        applications = {},
        helpers = {},
        entries = {},
        structs = {},
        modules = {table = "@prelude.table", string = "@prelude.string"},
        intrinsicAliases = {},
        constantNumbers = {}
    )
    for _, block in ipairs(chunk.blocks or {}) do
        for _, stat in ipairs((block as cst.Block).stats or {}) do
            if stat.kind == "localStmt" then
                local declaration = stat as cst.LocalStmt
                local names, exprs = declaration.names or {}, declaration.exprs or {}
                for _, declared in ipairs(names) do
                    if declared.text == "table" then
                        found.modules.table = "@shadowed.table"
                    elseif declared.text == "string" then
                        found.modules.string = "@shadowed.string"
                    end
                end
                if #names == 1 and #exprs == 1 and exprs[1].kind == "call" then
                    local required = (exprs[1] as any).requiredModule
                    local called = exprs[1] as cst.Call
                    if required == nil and lower.nameOf(called.obj) == "require" and called.args ~= nil then
                        local arguments = (called.args as cst.Args).exprs or {}
                        local literal = #arguments == 1 and arguments[
                            1
                        ].kind == "string" and (arguments[1] as cst.StringLit).token or nil
                        local written = literal ~= nil and (literal as lexer.Token).text or ""
                        required = written:match('^"(.*)"$') or written:match("^'(.*)'$")
                    end
                    if required ~= nil then
                        found.modules[names[1].text] = required
                    end
                end
                if declaration.isConst and #names == 1 and #exprs == 1 and exprs[1].kind == "number" then
                    local token = (exprs[1] as cst.NumberLit).token
                    if token ~= nil and tonumber((token as lexer.Token).text) ~= nil then
                        found.constantNumbers[names[1].text] = (token as lexer.Token).text
                    end
                end
            end
            if stat.kind == "pragmaStmt" then
                local chain: {cst.PragmaStmt} = {}
                local cursor: cst.Node? = stat
                while cursor ~= nil and cursor.kind == "pragmaStmt" do
                    chain[#chain + 1] = cursor as cst.PragmaStmt
                    cursor = (cursor as cst.PragmaStmt).stat
                end

                local isAot = false
                for _, link in ipairs(chain) do
                    if link.name ~= nil and (link.name as lexer.Token).text == "aot" then
                        isAot = true
                    end
                end
                if checked then
                    -- The checker accepts only a local declaration. Keep that
                    -- boundary explicit here as well: a partial producer or a tree
                    -- built by a lowering harness must not turn a qualified function's
                    -- absent local-name token into a nil table key below.
                    local decorated = cursor ~= nil and cursor.kind == "localFuncStmt" and (
                        cursor as cst.LocalFuncStmt
                    ) or nil
                    isAot = decorated ~= nil and (
                        decorated as cst.LocalFuncStmt
                    ).body ~= nil and ((decorated as cst.LocalFuncStmt).body as cst.Funcbody).aotRequired == true
                end
                if isAot then
                    found.applications[
                        #found.applications + 1
                    ] = new lower.Application(chain = chain, tail = cursor, at = stat as cst.PragmaStmt)
                    local named = cursor ~= nil and cursor.kind == "localFuncStmt" and (
                        cursor as cst.LocalFuncStmt
                    ) or nil
                    if named ~= nil and (named as cst.LocalFuncStmt).name ~= nil then
                        found.entries[((named as cst.LocalFuncStmt).name as lexer.Token).text] = named
                    end
                end
            elseif stat.kind == "localFuncStmt" and (stat as cst.LocalFuncStmt).name ~= nil then
                local declaration = stat as cst.LocalFuncStmt
                found.helpers[(declaration.name as lexer.Token).text] = declaration
            elseif stat.kind == "recordDecl" then
                local declaration = stat as cst.RecordDecl
                if declaration.declKind == "struct" and declaration.name ~= nil then
                    found.structs[(declaration.name as lexer.Token).text] = declaration
                end
            end
        end
    end

    -- A function export may be given a local alias before an AOT body uses it.
    -- Resolve that alias through the module binding rather than through spelling.
    for _, block in ipairs(chunk.blocks or {}) do
        for _, stat in ipairs((block as cst.Block).stats or {}) do
            if stat.kind == "localStmt" then
                local declaration = stat as cst.LocalStmt
                local names, exprs = declaration.names or {}, declaration.exprs or {}
                if #names == 1 and #exprs == 1 and exprs[1].kind == "dotIndex" then
                    local indexed = exprs[1] as cst.DotIndex
                    local root = lower.nameOf(indexed.obj)
                    local moduleName = root ~= nil and found.modules[root as string] or nil
                    if moduleName ~= nil and indexed.name ~= nil then
                        found.intrinsicAliases[names[1].text] = moduleName .. "." .. indexed.name.text
                    end
                end
            end
        end
    end

    return found
end

--- What one `@aot` application asks the backend for.
record lower.Contract
    --- Which execution family consumes this program.
    target: 'cpu' | 'gpu'

    --- Whether a multiply and an add may be fused into one rounding. Per
    --- function and carried in the IR, because it decides what the function
    --- answers rather than only how fast it gets there.
    fpContract: boolean

    --- Whether fixed-width transcendentals may select a native implementation.
    fpTranscendentals: boolean

    --- Whether the source requires lane lowering for an authored loop.
    simdRequired: boolean
end

--- Reads one application's contract.
---
--- From the checked body where there is one, because the checker resolved the
--- annotations; from the written annotations otherwise, which is what lets the
--- spike run on a tree the checker never saw.
function lower.contract(
    application: lower.Application,
    body: cst.Funcbody,
    checked: boolean,
    context: lower.Context
): lower.Contract
    local relaxed = body.relaxedGuarantees
    local contract = new lower.Contract(
        target = body.aotTarget == "gpu" and "gpu" or "cpu",
        fpContract = relaxed ~= nil and relaxed["fp-contract"] == true,
        fpTranscendentals = relaxed ~= nil and relaxed["fp-transcendentals"] == true,
        simdRequired = body.simdRequired == true
    )
    if checked then
        return contract
    end

    for _, link in ipairs(application.chain) do
        local written = link.name ~= nil and (link.name as lexer.Token).text or nil
        if written == "aot" then
            for _, argument in ipairs(link.annotationArgs or {}) do
                local name = argument.name ~= nil and (argument.name as lexer.Token).text or nil
                if name ~= "target" then
                    context.reject(lower.site(link), "@aot takes target = \"cpu\", target = \"gpu\", or nothing")
                end

                local value = argument.expr
                if name == "target" then
                    local token = value ~= nil and cst.firstToken(value as cst.Node) or nil
                    local requested = token ~= nil and (token as lexer.Token).text or ""
                    if requested == "\"gpu\"" or requested == "'gpu'" then
                        contract.target = "gpu"
                    elseif requested ~= "\"cpu\"" and requested ~= "'cpu'" then
                        context.reject(lower.site(argument), "@aot target must be \"cpu\" or \"gpu\"")
                    end
                end
            end
        elseif written == "relax" then
            for _, argument in ipairs(link.annotationArgs or {}) do
                local token = argument.expr ~= nil and cst.firstToken(argument.expr as cst.Node) or nil
                local text = token ~= nil and (token as lexer.Token).text or ""
                if text:sub(1, 1) == "\"" or text:sub(1, 1) == "'" then
                    text = text:sub(2, -2)
                end
                if text == "fp-contract" then
                    contract.fpContract = true
                elseif text == "fp-transcendentals" then
                    contract.fpTranscendentals = true
                end
            end
        end
    end

    return contract
end

--- The one `@aot` function this backend compiles, and its body.
function lower.kernelBody(
    application: lower.Application,
    context: lower.Context,
    specialization: lower.Specialization?
): (cst.LocalFuncStmt, cst.Funcbody)
    local fn = application.tail
    if fn == nil or fn.kind ~= "localFuncStmt" then
        context.reject(lower.site(fn or application.at), "@aot must decorate a local function with a visible body")
    end

    local declaration = fn as cst.LocalFuncStmt
    local body = declaration.body as cst.Funcbody?
    if body == nil
        or body.generics ~= nil
        and specialization == nil
        or body.varargParam ~= nil
        or body.captureTakes ~= nil
        or body.captureBorrows ~= nil
    then
        context.reject(lower.site(body or fn), "generic, variadic, and capturing kernels are not admitted")
    end

    return declaration, body as cst.Funcbody
end

--- The lowering environment either entry shape starts from: the
--- specialization's carriers, then the uniform and scalar parameters, each
--- scalar carrying its positional C name.
local function loweringEnvironment(signature: lower.Signature, specialization: lower.Specialization?): {[string]: any}
    local environment: {[string]: any} = {}
    if specialization ~= nil then
        for carrier, value in pairs((specialization as lower.Specialization).values) do
            environment[carrier] = value
        end
    end
    for position, param in ipairs(signature.params) do
        if param.kind == "uniform" or param.kind == "scalar" then
            if param.kind == "scalar" then
                (param as any).cName = tostring(position)
            end
            environment[
                param.name
            ] = specialization ~= nil and (specialization as lower.Specialization).values[param.name] or param
        end
    end

    return environment
end

--- A kernel with nothing lowered into it yet.
---
--- The three entry shapes differ in a handful of fields -- where the loop was
--- written, what proves an index, what the entry returns -- and `overrides`
--- carries exactly those, so the bookkeeping every shape starts empty is
--- written once.
local function newKernel(
    signature: lower.Signature,
    declarations: lower.Declarations,
    layouts: lower.Layouts,
    symbol: string,
    context: lower.Context,
    overrides: {[string]: any}
): lower.Kernel
    local kernel = new lower.Kernel(
        params = signature.byName,
        layouts = layouts,
        helperDecls = declarations.helpers,
        entryDecls = declarations.entries,
        helpers = {},
        helperOrder = {},
        constantNames = {},
        scratchBounds = {},
        constantOrder = {},
        constantNumbers = declarations.constantNumbers,
        helperState = {},
        modules = declarations.modules,
        intrinsicAliases = declarations.intrinsicAliases,
        stringAccumulators = {},
        reducers = {},
        reducerOrder = {},
        nextSimdRegion = 0,
        symbol = symbol,
        index = "",
        indexCName = "",
        mapEntry = false,
        resultTypes = {},
        cursorBounds = {},
        lengthBounds = {},
        scratchLengthBounds = {},
        usesSimd = false,
        usesNumberToken = false,
        usesLua = false,
        serial = 0,
        context = context
    )
    for field, value in pairs(overrides) do
        (kernel as any)[field] = value
    end

    return kernel
end

--- Reject incomplete reducer capabilities after the whole entry has lowered.
--- Source order establishes contribution-before-finalization; the region id
--- establishes that no second authored loop can reuse the binding.
local function validateReducers(kernel: lower.Kernel): nil
    for _, reducer in ipairs(kernel.reducerOrder) do
        if reducer.region == nil then
            kernel.context.reject(
                reducer.source,
                "a reducer belongs to exactly one @simd loop and must receive one contribution"
            )
        end
        if not reducer.finalized then
            kernel.context.reject(reducer.source, "a reducer is finalized exactly once after its @simd loop")
        end
    end
end

--- Lowers one whole `@aot` function to AOT IR.
---
--- The IR is what everything downstream is written from -- the verifier, the C,
--- the wrapper -- so this is where the source stops being consulted. What the
--- function is has been decided by the time this returns.
function lower.program(
    declarations: lower.Declarations,
    application: lower.Application,
    checked: boolean,
    context: lower.Context,
    specialization: lower.Specialization?
): scalarIR.Program
    local fn, body = lower.kernelBody(application, context, specialization)
    local contract = lower.contract(application, body, checked, context)

    local layouts = new lower.Layouts(ordered = {}, byName = {})
    local checkedSignature = context.checked and (
        specialization ~= nil and (specialization as lower.Specialization).signature or body.signatureType
    ) or nil
    if context.checked and checkedSignature == nil then
        context.reject(lower.site(body), "the checker did not publish this AOT signature")
    end
    local signature = lower.parameters(
        (body.params or {}) as {cst.Param},
        checkedSignature,
        declarations.structs,
        layouts,
        context,
        specialization ~= nil,
        specialization ~= nil and (specialization as lower.Specialization).omitted or nil
    )
    local regions, aliasFacts = lower.regions(signature.spans)
    local sourceName = (fn.name as lexer.Token).text
    local name = specialization ~= nil and (specialization as lower.Specialization).name or sourceName
    local symbol = scalarIR.privateSymbol(name)

    local resultTypes: {scalarIR.Type} = {}
    local resultSourceTypes: {string} = {}
    local rets = body.rets or {}
    local resolvedResults = checkedSignature ~= nil and checkedSignature.rets or nil
    if #rets == 1 and (
        context.checked and resolvedResults[
            1
        ] ~= nil and semanticRaw(
            resolvedResults[1]
        ).tag == "nil" or not context.checked and lower.compactType(rets[1]) == "nil"
    ) then
        rets = {}
    end
    if #rets > 4 then
        context.reject(lower.site(body), "general AOT entries currently return at most four scalar values")
    end
    for position, result in ipairs(rets) do
        local resolved = context.checked and resolvedResults[position] or nil
        local sourceType = context.checked and sourceSpelling(resolved) or lower.compactType(result)
        local resultType = context.checked and semanticValueType(resolved, true) or lower.helperValueType(sourceType)
        if not context.checked then
            if resultType == nil and sourceType == "string" then
                resultType = "lua_string"
            elseif resultType == nil and sourceType == "any" then
                resultType = "lua_value"
            elseif resultType == nil and sourceType == "nil" then
                resultType = "lua_nil"
            elseif resultType == nil and (sourceType:sub(1, 1) == "{" or sourceType == "table") then
                resultType = "lua_table"
            end
        end
        if resultType == nil then
            context.reject(lower.site(result), "AOT entry results are admitted scalar values or fresh tables")
        end
        if tostring(resultType):match("^simd_") ~= nil then
            context.reject(lower.site(result), "explicit SIMD values cannot cross an AOT entry result ABI")
        end
        resultTypes[position] = resultType as scalarIR.Type
        resultSourceTypes[position] = sourceType
    end

    local statements = body.body ~= nil and (body.body as cst.Block).stats or {}
    local workgroupCall: cst.Call? = nil
    if contract.target == "gpu" and #statements >= 1 and statements[#statements].kind == "callStmt" then
        local expression = (statements[#statements] as cst.CallStmt).expr
        if expression ~= nil and expression.kind == "call" then
            local candidate = expression as cst.Call
            local path = lower.dottedName(candidate.obj)
            local root = path ~= nil and (path as string):match("^([^.]+)%.workgroups$") or nil
            if root ~= nil and declarations.modules[root as string] == "nupp.gpu" then
                workgroupCall = candidate
            end
        end
    end

    if workgroupCall ~= nil then
        for index = 1, #statements - 1 do
            if statements[index].kind ~= "localStmt" then
                context.reject(
                    lower.site(statements[index]),
                    "only initialized scalar locals may precede gpu.workgroups"
                )
            end
        end
        if #resultTypes ~= 0 or #signature.writes == 0 then
            context.reject(lower.site(body), "a GPU workgroup entry returns nil and takes a writable span")
        end
        local args = (
            workgroupCall as cst.Call
        ).args ~= nil and ((((workgroupCall as cst.Call).args as cst.Args).exprs or {})) or {}
        if #args ~= 3 or args[3].kind ~= "funcExpr" then
            context.reject(
                lower.site(workgroupCall),
                "gpu.workgroups takes groups, a static size, and an immediate function"
            )
        end
        local sizeToken = cst.firstToken(args[2])
        local size = sizeToken ~= nil and tonumber((sizeToken as lexer.Token).text) or nil
        if size == nil or size ~= math.floor(size as number) or size < 1 or size > 256 then
            context.reject(lower.site(args[2]), "GPU workgroup size must be an integer literal from 1 through 256")
        end
        local controller = (args[3] as cst.FuncExpr).body as cst.Funcbody?
        local controllerParams = controller ~= nil and (controller as cst.Funcbody).params or {}
        if controller == nil or #controllerParams ~= 2 or (
            controllerParams[1] as cst.Param
        ).name == nil or (controllerParams[2] as cst.Param).name == nil then
            context.reject(lower.site(args[3]), "a workgroup controller takes groupIndex and phases")
        end
        local groupName = ((controllerParams[1] as cst.Param).name as lexer.Token).text
        local phasesName = ((controllerParams[2] as cst.Param).name as lexer.Token).text
        local kernel = newKernel(signature, declarations, layouts, symbol, context, {
            loopSource = lower.site(workgroupCall),
            phasesName = phasesName,
            workgroupSize = size as integer,
            shared = {},
            sharedOrder = {},
        })
        local environment = loweringEnvironment(signature, specialization)
        local prefix: {cst.Node} = {}
        for index = 1, #statements - 1 do
            prefix[index] = statements[index]
        end
        local prelude = lower.block(prefix, environment, kernel)
        local groups = lower.expression(args[1], environment, nil, kernel)
        if groups.op == "local" then
            for index = #prelude, 1, -1 do
                local statement = prelude[index]
                if statement.op == "let" and statement.cName == (groups as scalarIR.Name).cName then
                    groups = (statement as scalarIR.Let).value
                    break
                end
            end
        end
        if groups.type ~= "u32" then
            context.reject(lower.site(args[1]), "GPU workgroup count must be uint32")
        end
        local numerator = groups.op == "u32_div" and (groups as scalarIR.Fixed).left or nil
        local divisor = groups.op == "u32_div" and (groups as scalarIR.Fixed).right or nil
        while numerator ~= nil and (numerator.op == "numeric_cast" or numerator.op == "int_to_f64") do
            numerator = (numerator as scalarIR.Convert).value
        end
        while divisor ~= nil and (divisor.op == "numeric_cast" or divisor.op == "int_to_f64") do
            divisor = (divisor as scalarIR.Convert).value
        end
        local divisorValue = divisor ~= nil and (
            divisor.op == "constant" or divisor.op == "constant_i32"
        ) and tonumber((divisor as any).value) or nil
        if numerator == nil or numerator.op ~= "span_count" or divisorValue ~= size then
            context.reject(lower.site(args[1]), "GPU workgroup count must be u32.div(u32.wrap(#span), workgroupSize)")
        end
        local dispatchSpan = (numerator as scalarIR.SpanCount).span
        local groupBinding = bind(groupName, "u32", nil, controllerParams[1], environment, kernel)
        local groupValue = new scalarIR.WorkgroupIndex(
            op = "workgroup_index",
            type = "u32",
            source = lower.site(controllerParams[1])
        )
        local controllerBlock = (controller as cst.Funcbody).body as cst.Block?
        local controllerBody = lower.block(
            controllerBlock ~= nil and (controllerBlock as cst.Block).stats or {},
            environment,
            kernel
        )
        local lowered: {
            scalarIR.Statement
        } = {
            new scalarIR.Let(
                op = "let",
                name = groupName,
                cName = groupBinding.cName,
                type = "u32",
                value = groupValue,
                source = lower.site(controllerParams[1])
            ),
        }
        for _, statement in ipairs(controllerBody) do
            lowered[#lowered + 1] = statement
        end
        local phaseCount = 0

        local function countPhases(block: {scalarIR.Statement}): nil
            for _, statement in ipairs(block) do
                if statement.op == "phase" then
                    phaseCount = phaseCount + 1
                elseif statement.op == "if" then
                    for _, clause in ipairs((statement as scalarIR.If).clauses) do
                        countPhases(clause.body)
                    end
                    countPhases((statement as scalarIR.If).elseBody or {})
                elseif statement.op == "fornum"
                    or statement.op == "while"
                    or statement.op == "repeat"
                    or statement.op == "block"
                then
                    countPhases((statement as any).body as {scalarIR.Statement})
                end
            end
        end

        countPhases(lowered)
        if phaseCount == 0 then
            context.reject(lower.site(args[3]), "a workgroup controller must run at least one phase")
        end
        local scratchBytes = 0
        for _, shared in ipairs(kernel.sharedOrder as {scalarIR.Shared}) do
            if shared.count ~= size then
                context.reject(
                    shared.source,
                    "workgroup scratch count must equal the workgroup size in the initial portable subset"
                )
            end
            scratchBytes = scratchBytes + shared.count * 4
        end
        if scratchBytes > 16384 then
            context.reject(lower.site(args[3]), "workgroup scratch exceeds the portable 16384-byte limit")
        end
        if kernel.usesLua or kernel.usesSimd then
            context.reject(lower.site(args[3]), "workgroup phases admit fixed-width scalar operations only")
        end

        return carriedFacts.program(
            new scalarIR.Program(
                version = scalarIR.VERSION,
                name = name,
                symbol = symbol,
                entryMode = "kernel",
                executionTarget = "gpu",
                fpContract = contract.fpContract,
                fpTranscendentals = contract.fpTranscendentals,
                params = signature.params,
                layouts = layouts.ordered,
                regions = regions,
                aliasFacts = aliasFacts,
                guards = {},
                helpers = kernel.helperOrder,
                constants = kernel.constantOrder,
                resultTypes = {},
                resultSourceTypes = {},
                usesSimd = false,
                usesNumberToken = false,
                workgroup = new scalarIR.Workgroup(
                    prelude = prelude,
                    groups = groups,
                    dispatchSpan = dispatchSpan,
                    size = size as integer,
                    groupIndex = groupName,
                    localIndex = "localIndex",
                    shared = kernel.sharedOrder as {scalarIR.Shared},
                    statements = lowered,
                    source = lower.site(workgroupCall)
                ),
                source = lower.site(fn)
            )
        )
    end

    -- A map kernel is a guard prefix and then one counted loop. The guards state facts,
    -- the loop states obligations, and admission is whether the first imply the second
    -- -- so a precondition stronger than the loop needs is carried rather than refused,
    -- and one the loop does need is proved from any equivalent source form. A map may
    -- still relate spans of different lengths, because a length agreement is discovered
    -- from the facts rather than required of them: what replaces the proof is
    -- per-access, where a span the body touches at the loop counter must be the primary
    -- or proved equal to it, while a cursor access carries its dominating bound check
    -- into either backend.
    local candidate = #resultTypes == 0 and #signature.writes > 0 and #signature.reads > 0 and #statements > 0
    local admission = candidate and lower.admitMap(
        statements,
        signature
    ) or new lower.MapAdmission(
        relations = {},
        guards = {},
        understood = {},
        declined = "a map kernel writes a span and reads one, and returns nothing",
        declinedAt = lower.site(body)
    )
    if admission.unproved ~= nil then
        context.reject(lower.site(statements[#statements]), lower.unprovedMessage(admission))
    end
    if admission.declined ~= nil and admission.committed then
        context.reject(admission.declinedAt, tostring(admission.declined))
    end
    if contract.target == "gpu" then
        -- The host binding can enforce relations among the span counts it owns,
        -- but a dispatch has no wrapper for relations involving scalar uniforms.
        -- Anything else would be a precondition the source wrote and this target
        -- silently dropped.
        for _, relation in ipairs(admission.relations) do
            if relation.left.kind ~= "count" or relation.right.kind ~= "count" then
                context.reject(
                    relation.source,
                    "a GPU kernel's guards may only relate span lengths, and nothing enforces `" .. relations.text(
                        relation
                    ) .. "` on a dispatch"
                )
            end
        end
    end
    local mapShape = admission.shape ~= nil

    if not mapShape then
        local kernel = newKernel(signature, declarations, layouts, symbol, context, {
            stringAccumulators = lower.stringAccumulators(statements),
            loopSource = lower.site(body.body or body),
            resultTypes = resultTypes,
            usesLua = (function(): boolean
                for _, resultType in ipairs(resultTypes) do
                    if resultType == "lua_table"
                    or resultType == "lua_string"
                    or resultType == "lua_nil"
                    or resultType == "lua_value"
                    then
                        return true
                    end
                end

                return false
            end)(),
        })
        local environment = loweringEnvironment(signature, specialization)
        local lowered = lower.block(statements, environment, kernel)
        validateReducers(kernel)
        if #lowered == 0 then
            context.reject(lower.site(body.body or body), "an AOT block body may not be empty")
        end

        local entryMode = kernel.usesLua and "lua-builder" or "kernel"
        local blockProgram = new scalarIR.Program(
            version = scalarIR.VERSION,
            name = name,
            symbol = symbol,
            entryMode = entryMode as any,
            executionTarget = contract.target,
            builderMode = kernel.builderMode,
            runtimeAbi = kernel.usesLua and "lua-5.1" or nil,
            registrar = kernel.usesLua and symbol .. "_register" or nil,
            fpContract = contract.fpContract,
            fpTranscendentals = contract.fpTranscendentals,
            simdRequired = contract.simdRequired,
            params = signature.params,
            layouts = layouts.ordered,
            regions = regions,
            aliasFacts = aliasFacts,
            guards = {},
            helpers = kernel.helperOrder,
            constants = kernel.constantOrder,
            body = lowered,
            resultTypes = resultTypes,
            resultSourceTypes = resultSourceTypes,
            usesSimd = kernel.usesSimd,
            usesNumberToken = kernel.usesNumberToken,
            source = lower.site(fn)
        )

        -- Proved here rather than decided by the backend that consumes it: a
        -- reused buffer is shared, and what makes sharing sound is a fact about
        -- this program. `verify` re-runs the same derivation.
        blockProgram.reusableScratch = visit.reusableScratch(blockProgram)

        return carriedFacts.program(blockProgram)
    end

    local primary = signature.writes[1]

    local guards = admission.guards
    local rangeGuard = admission.rangeGuard
    local loop = annotatedStatement(statements[#statements]) as cst.Node
    local index = (admission.shape as lower.LoopShape).index
    local kernel = newKernel(signature, declarations, layouts, symbol, context, {
        loopSource = lower.site(loop),
        index = index,
        indexCName = "i",
        mapEntry = true,
        boundSpan = primary.name,
        indexSpans = (function(): {[string]: boolean}
            local provable: {[string]: boolean} = {[primary.name] = true}
            for _, guard in ipairs(guards) do
                provable[guard.right] = true
            end

            return provable
        end)(),
    })

    local environment = loweringEnvironment(signature, specialization)

    local counted = loop as cst.FornumStmt
    local body_ = lower.block(counted.body ~= nil and (counted.body as cst.Block).stats or {}, environment, kernel)
    if #body_ == 0 then
        context.reject(lower.site(counted.body or loop), "the native loop body may not be empty")
    end
    -- A counted native loop runs per element, and entering it is what the loop is
    -- for -- so it is compiled with no VM to allocate against and enters as
    -- `kernel` rather than as a builder, whatever it reached. A block body that
    -- reaches a Lua value becomes a builder instead; this shape has no such door,
    -- and saying so here is the difference between a refusal naming the line and
    -- an IR verifier assertion escaping as a traceback with no source at all.
    if kernel.usesLua then
        context.reject(
            kernel.luaSource or lower.site(counted.body or loop),
            "a value only the VM can hold is not admitted in a counted native loop"
        )
    end

    return carriedFacts.program(
        new scalarIR.Program(
            version = scalarIR.VERSION,
            name = name,
            symbol = symbol,
            entryMode = "kernel",
            executionTarget = contract.target,
            fpContract = contract.fpContract,
            fpTranscendentals = contract.fpTranscendentals,
            simdRequired = contract.simdRequired,
            params = signature.params,
            layouts = layouts.ordered,
            regions = regions,
            aliasFacts = aliasFacts,
            relations = admission.relations,
            guards = guards,
            rangeGuard = rangeGuard,
            helpers = kernel.helperOrder,
            constants = kernel.constantOrder,
            resultTypes = {},
            resultSourceTypes = {},
            usesSimd = kernel.usesSimd,
            usesNumberToken = kernel.usesNumberToken,
            loop = new scalarIR.Loop(
                index = index,
                first = rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).first or 1,
                last = rangeGuard ~= nil and (rangeGuard as scalarIR.RangeGuard).last or primary.name,
                count = primary.name,
                statements = body_,
                source = lower.site(loop)
            ),
            source = lower.site(fn)
        )
    )
end

export = lower
