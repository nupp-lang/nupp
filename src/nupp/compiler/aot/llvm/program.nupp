module nupp.compiler.aot.llvm.program

--[[
One compilation unit's programs as one LLVM module.

Each kernel entry keeps exactly the private C ABI the generated wrapper calls:
span pointers, then uniforms, then the span counts as `size_t`, and the scalar
result. What the IR proved about those parameters is stated on them rather than
dropped: a span disjoint from every span that is written is `noalias`, a span
the body only reads is `readonly`, and none of them escape.

`llvmProgram.module` answers the module text, or raises; an error beginning with
`expressions.UNSUPPORTED` means the unit uses something this backend does not
emit yet.
]]

local builder = require("nupp.compiler.aot.llvm.builder")
local context = require("nupp.compiler.aot.llvm.context")
local countRules = require("nupp.compiler.aot.counts")
local dwarf = require("nupp.compiler.aot.llvm.dwarf")
local expressions = require("nupp.compiler.aot.llvm.expressions")
local memory = require("nupp.compiler.aot.llvm.simd.memory")
local rearrange = require("nupp.compiler.aot.llvm.simd.rearrange")
local reduce = require("nupp.compiler.aot.llvm.simd.reduce")
local simdReducers = require("nupp.compiler.aot.llvm.simd.reducers")
local vectors = require("nupp.compiler.aot.llvm.simd.vectors")
local facts = require("nupp.compiler.aot.llvm.facts")
local luaEntry = require("nupp.compiler.aot.llvm.lua.entry")
local luaStatements = require("nupp.compiler.aot.llvm.lua.statements")
local luaValues = require("nupp.compiler.aot.llvm.lua.values")
local profile = require("nupp.compiler.aot.llvm.profile")
local scalarIR = require("nupp.compiler.aot.scalar")
local statements = require("nupp.compiler.aot.llvm.statements")
local target = require("nupp.compiler.aot.target")
local types = require("nupp.compiler.aot.llvm.types")

local llvmProgram = {}

-- The lowerings outside the scalar core, installed where the expression and
-- statement emitters look them up.
for _, lowering in ipairs({
    vectors.EXPRESSIONS,
    rearrange.EXPRESSIONS,
    reduce.EXPRESSIONS,
    memory.EXPRESSIONS,
    simdReducers.EXPRESSIONS,
    luaValues.EXPRESSIONS
}) do
    for operation, lower in pairs(lowering) do
        expressions.handlers[operation] = lower
    end
end
for _, lowering in ipairs({memory.STATEMENTS, simdReducers.STATEMENTS}) do
    for operation, lower in pairs(lowering) do
        statements.handlers[operation] = lower
    end
end
for operation, bind in pairs(simdReducers.BINDERS) do
    statements.binders[operation] = bind
end
for operation, lower in pairs(luaStatements.STATEMENTS) do
    statements.builderHandlers[operation] = lower
end

--- What every function of one module is emitted against.
record llvmProgram.Unit
    module: builder.Module

    --- The tier whose symbols the entries take, or nil for logical symbols.
    tier: string?

    --- Whether the tier compiled for has masked vector moves.
    maskedMemory: boolean

    --- The tier compiled for.
    codegenTier: string

    target: profile.Profile
    facts: facts.Facts

    --- The compile unit locations belong to, when the unit has line tables.
    lines: dwarf.Unit?

    --- Functions already defined or declared, by LLVM name.
    defined: {[string]: boolean}
end

--- @raises string always
local function unsupported(what: string): never
    error(expressions.UNSUPPORTED .. what, 0)
end

local function physical(symbol: string, tier: string?): string
    return tier ~= nil and target.symbol(symbol, tier as string) or symbol
end

local function isSpan(param: scalarIR.Param): boolean
    return param.kind == "write_span" or param.kind == "read_span"
end

--- Whether every alias fact between `param`'s region and a written span's
--- region says disjoint: then accesses through it never meet a store through
--- another pointer, which is what `noalias` promises.
local function disjointFromWrites(program: scalarIR.Program, param: scalarIR.Param): boolean
    local regionOf: {[string]: scalarIR.Param} = {}
    for _, other in ipairs(program.params) do
        if other.region ~= nil then
            regionOf[other.region as string] = other
        end
    end
    local disjoint: {[string]: boolean} = {}
    for _, fact in ipairs(program.aliasFacts) do
        if fact.relation == "disjoint" then
            disjoint[fact.left .. " " .. fact.right] = true
            disjoint[fact.right .. " " .. fact.left] = true
        end
    end
    for _, other in ipairs(program.params) do
        if other ~= param and isSpan(other) and other.kind == "write_span" then
            if param.region == nil or other.region == nil then
                return false
            end
            if not disjoint[tostring(param.region) .. " " .. tostring(other.region)] then
                return false
            end
        end
    end
    if param.kind == "write_span" then
        -- A written span must also be disjoint from every span read.
        for _, other in ipairs(program.params) do
            if other ~= param and isSpan(other) then
                if param.region == nil or other.region == nil then
                    return false
                end
                if not disjoint[tostring(param.region) .. " " .. tostring(other.region)] then
                    return false
                end
            end
        end
    end

    return true
end

--- The spelling of one span parameter with its proved attributes.
local function spanParameter(unit: llvmProgram.Unit, program: scalarIR.Program, param: scalarIR.Param): string
    local attributes: {string} = {"ptr"}
    if unit.facts.alias and disjointFromWrites(program, param) then
        attributes[#attributes + 1] = "noalias"
    end
    if unit.facts.access then
        attributes[#attributes + 1] = "captures(none)"
        if param.kind == "read_span" then
            attributes[#attributes + 1] = "readonly"
        end
    end
    attributes[#attributes + 1] = "%p_" .. param.name

    return table.concat(attributes, " ")
end

--- The function attributes every entry and helper of this module carries.
local function functionAttributes(selected: profile.Profile, program: scalarIR.Program, extra: string?): string
    local parts: {string} = {"nounwind", "uwtable"}
    if selected.functionAttributes ~= "" then
        parts[#parts + 1] = selected.functionAttributes
    end
    if program.fpContract == true then
        parts[#parts + 1] = "\"nupp-fp-contract\""
    end
    if extra ~= nil then
        parts[#parts + 1] = extra as string
    end

    return table.concat(parts, " ")
end

--- Defines the program's pure helpers as internal functions, and declares
--- the native entries it calls.
local function helpers(unit: llvmProgram.Unit, ctx: context.Context, program: scalarIR.Program): nil
    local module = unit.module
    for _, helper in ipairs(program.helpers or {}) do
        local name = "@" .. helper.cName
        local params: {string} = {}
        local paramTypes: {string} = {}
        for _, param in ipairs(helper.params) do
            local named = context.species(ctx, tostring(param.type))
            -- A species parameter is a compile-time lane count: dropped.
            if named == nil or (named as any).family ~= "species" then
                local t = context.llvmType(ctx, tostring(param.type))
                paramTypes[#paramTypes + 1] = t
                params[#params + 1] = t .. " %h_" .. tostring(param.cName)
            end
        end
        local result = expressions.helperResult(ctx, helper.resultTypes)
        ctx.helpers[helper.name] = name
        if unit.defined[name] then
            -- The oracle twin shares its kernel's helpers.
        elseif helper.native == true then
            unit.defined[name] = true
            builder.declare(module, name, ("declare %s %s(%s)"):format(result, name, table.concat(paramTypes, ", ")))
        else
            unit.defined[name] = true
            local attrs = builder.attributes(module, "alwaysinline " .. functionAttributes(unit.target, program))
            local f = builder.func(
                module,
                ("define internal %s %s(%s) %s {"):format(result, name, table.concat(params, ", "), attrs)
            )
            local inner = context.new(module, f, program, unit.facts)
            inner.helpers = ctx.helpers
            for _, param in ipairs(helper.params) do
                inner.helperParams[tostring(param.cName)] = "%h_" .. tostring(param.cName)
            end
            local returned = "undef"
            for position, resultType in ipairs(helper.resultTypes) do
                local value, t = expressions.value(inner, helper.values[position])
                local converted = expressions.convert(inner, value, t, tostring(resultType))
                returned = #helper.resultTypes == 1 and converted
                    or builder.value(
                        f,
                        (
                            "insertvalue %s %s, %s %s, %d"
                        ):format(
                            result,
                            returned,
                            context.llvmType(inner, tostring(resultType)),
                            converted,
                            position - 1
                        )
                    )
            end
            builder.finish(f, ("ret %s %s"):format(result, returned))
        end
    end
end

--- What the compiled object says about one struct's layout: its size, and
--- each field's offset and size, as `size_t` functions the generated wrapper
--- compares against what Nupp believes. The answers are LLVM's own layout of
--- the struct, the one the kernel indexes with.
local function layoutReporters(unit: llvmProgram.Unit, program: scalarIR.Program, layout: scalarIR.Layout): nil
    local module = unit.module
    local symbol = physical(program.symbol, unit.tier)
    local attrs = builder.attributes(module, functionAttributes(unit.target, program))
    local size = unit.target.sizeType
    local ctx = context.new(module, builder.func(module, ""), program, unit.facts)
    local structType = expressions.layoutType(ctx, layout.name)

    local function reporter(name: string, address: string): nil
        local f = builder.func(module, ("define %s @%s() %s {"):format(size, name, attrs))
        builder.finish(f, ("ret %s ptrtoint (ptr %s to %s)"):format(size, address, size))
    end

    local prefix = symbol .. "_layout_" .. layout.name
    reporter(prefix .. "_size", ("getelementptr (%s, ptr null, i32 1)"):format(structType))
    for position, field in ipairs(layout.fields) do
        reporter(
            prefix .. "_offset_" .. field.name,
            ("getelementptr (%s, ptr null, i32 0, i32 %d)"):format(structType, position - 1)
        )
        reporter(
            prefix .. "_size_" .. field.name,
            ("getelementptr (%s, ptr null, i32 1)"):format(types.storage(field.type, field.sourceType))
        )
    end
end

--- The first authored line of a program, where its subprogram starts.
local function firstLine(program: scalarIR.Program): integer
    local loop = program.loop
    if loop ~= nil and loop.source ~= nil then
        return (loop.source as scalarIR.Source).line
    end
    for _, statement in ipairs(program.body or {}) do
        local source = (statement as any).source as scalarIR.Source?
        if source ~= nil then
            return (source as scalarIR.Source).line
        end
    end

    return 1
end

--- A context for a function of `program` in `unit`, with what its vector
--- code is emitted for.
local function prepared(unit: llvmProgram.Unit, f: builder.Function, program: scalarIR.Program): context.Context
    local ctx = context.new(unit.module, f, program, unit.facts)
    ctx.maskedMemory = unit.maskedMemory
    ctx.tier = unit.codegenTier
    local architecture = unit.target.llvmTriple:match("^([^-]+)")
    ctx.vectorRegister = (architecture == "arm64" or architecture == "aarch64") and "w"
        or (architecture == "x86_64" or architecture == "i686") and "x"
        or ""

    return ctx
end

--- The attributes of a function Lua calls: it unwinds, and a frame holding
--- a value stream's state and a string accumulator spans several pages, so
--- its stack is probed.
local function luaAttributes(selected: profile.Profile): string
    local parts: {string} = {"uwtable", "\"probe-stack\"=\"inline-asm\""}
    if selected.functionAttributes ~= "" then
        parts[#parts + 1] = selected.functionAttributes
    end

    return table.concat(parts, " ")
end

--- One Lua-builder entry, as the `lua_CFunction` its registrar registers.
local function builderEntry(unit: llvmProgram.Unit, program: scalarIR.Program): luaEntry.Registered
    local name = "@" .. physical(program.symbol, unit.tier) .. "_lua"
    local attrs = builder.attributes(unit.module, luaAttributes(unit.target))
    local scope: string? = nil
    if unit.lines ~= nil then
        scope = dwarf.subprogram(unit.module, unit.lines as dwarf.Unit, program.name, firstLine(program))
        attrs = attrs .. " !dbg " .. tostring(scope)
    end
    local f = builder.func(unit.module, ("define internal i32 %s(ptr %%L) %s {"):format(name, attrs))
    local ctx = prepared(unit, f, program)
    ctx.scope = scope
    ctx.lua = new context.Lua(
        state = "%L",
        runtime = "null",
        size = unit.target.sizeType,
        eager = program.builderMode == "eager",
        handles = {},
        bytes = {},
        blocks = {},
        reusableScratch = program.reusableScratch
    )
    helpers(unit, ctx, program)
    luaEntry.body(ctx, program)

    return new luaEntry.Registered(name = program.name, fn = name)
end

--- One kernel entry.
local function kernel(unit: llvmProgram.Unit, program: scalarIR.Program, oracle: boolean): nil
    local module = unit.module
    local selected = unit.target
    local results = program.resultTypes or {}
    if program.workgroup ~= nil then
        unsupported("workgroup entries")
    end
    local independent = scalarIR.independentCounts(program)
    local roots = countRules.roots(program)
    local aliases = countRules.equal(program, roots)
    local parameters: {string} = {}
    local narrowCounts = selected.sizeType ~= "i64"
    local countSuffix = narrowCounts and ".arg" or ""
    for _, param in ipairs(program.params) do
        if isSpan(param) then
            parameters[#parameters + 1] = spanParameter(unit, program, param)
        elseif param.kind == "uniform" then
            parameters[#parameters + 1] = types.parameter(tostring(param.type)) .. " %p_" .. param.name
        else
            unsupported("scalar parameters of kind " .. param.kind)
        end
    end
    if independent then
        for _, param in ipairs(program.params) do
            if isSpan(param) and (param.soa == nil or param.soa.ordinal == 1) then
                parameters[#parameters + 1] = selected.sizeType .. " %count_" .. param.name .. countSuffix
            end
        end
    else
        parameters[#parameters + 1] = selected.sizeType .. " %count" .. countSuffix
    end
    local resultStruct: string? = nil
    if #results > 1 then
        local fields: {string} = {}
        for position, resultType in ipairs(results) do
            fields[position] = types.field(tostring(resultType))
        end
        resultStruct = "{ " .. table.concat(fields, ", ") .. " }"
        parameters[#parameters + 1] = unit.facts.access and "ptr noalias captures(none) writeonly %ks_result"
            or "ptr %ks_result"
    end
    local result = #results ~= 1 and "void" or types.result(tostring(results[1]))
    local symbol = physical(program.symbol .. (oracle and "_forced_scalar" or ""), unit.tier)
    -- A kernel frees nothing and synchronizes with nothing; what it reads and
    -- writes is settled once the unit is complete (`llvmProgram.module`). The
    -- oracle is the same body left as written.
    local effects = unit.facts.effects and "nofree nosync " or ""
    local inlining = oracle and "noinline optnone " or "noinline "
    -- Copies stay loops: a libc `memcpy` is nothing a kernel may call.
    inlining = inlining .. "\"no-builtin-memcpy\" \"no-builtin-memset\" "
    local attrs = builder.attributes(module, inlining .. effects .. functionAttributes(selected, program))
    local scope: string? = nil
    if unit.lines ~= nil then
        scope = dwarf.subprogram(module, unit.lines as dwarf.Unit, program.name, firstLine(program))
        attrs = attrs .. " !dbg " .. tostring(scope)
    end
    local f = builder.func(
        module,
        ("define %s @%s(%s) %s {"):format(result, symbol, table.concat(parameters, ", "), attrs)
    )

    -- Counts arrive as `size_t` and are used as i64 throughout.
    local function count(name: string): nil
        if narrowCounts then
            builder.emit(f, ("%s = zext %s %s.arg to i64"):format(name, selected.sizeType, name))
        end
    end

    if independent then
        for _, param in ipairs(program.params) do
            if isSpan(param) and (param.soa == nil or param.soa.ordinal == 1) then
                count("%count_" .. param.name)
            end
        end
    else
        count("%count")
    end
    local ctx = prepared(unit, f, program)
    ctx.scope = scope
    ctx.oracle = oracle
    if resultStruct ~= nil then
        ctx.resultBlock = "%ks_result"
        ctx.resultStruct = resultStruct
    end
    for _, param in ipairs(program.params) do
        if isSpan(param) then
            ctx.spans[param.name] = new context.Span(pointer = "%p_" .. param.name, param = param)
            ctx.counts[param.name] = independent
                and "%count_" .. (roots[param.name] or aliases[param.name] or param.name)
                or "%count"
        elseif param.kind == "uniform" then
            ctx.uniforms[param.name] = "%p_" .. param.name
            -- A body may assign its parameters, which C spells `p_<name>`:
            -- each one gets a slot, promoted back to a register by SROA.
            local slot = statements.slot(ctx, "p_" .. param.name, tostring(param.type))
            builder.emit(
                f,
                (
                    "store %s %%p_%s, ptr %s"
                ):format(context.llvmType(ctx, tostring(param.type)), param.name, slot.pointer)
            )
        end
    end
    helpers(unit, ctx, program)

    if program.body ~= nil then
        statements.block(ctx, program.body as {scalarIR.Statement})
        builder.finish(f, #results == 1 and "unreachable" or "ret void")
        return
    end

    -- The map form: `for (i = first; i < last; ++i)` over zero-based indices.
    local loopShape = program.loop as scalarIR.Loop
    dwarf.at(f, scope, loopShape.source)
    local first = "0"
    local last = "%count"
    local guard = program.rangeGuard
    if guard ~= nil then
        local from = builder.value(f, ("fsub double %%p_%s, 1.0"):format((guard as scalarIR.RangeGuard).first))
        first = expressions.convert(ctx, from, "f64", "u64")
        last = expressions.convert(ctx, "%p_" .. (guard as scalarIR.RangeGuard).last, "f64", "u64")
    elseif independent then
        last = independent and "%count_" .. (roots[loopShape.count] or aliases[loopShape.count] or loopShape.count)
            or "%count"
    end
    local index = builder.alloca(f, "i64", 8)
    builder.emit(f, ("store i64 %s, ptr %s"):format(first, index))
    local head = builder.label(f, "map.head")
    local body = builder.label(f, "map.body")
    local latch = builder.label(f, "map.next")
    local exit = builder.label(f, "map.end")
    builder.start(f, head)
    local current = builder.value(f, ("load i64, ptr %s"):format(index))
    local more = builder.value(f, ("icmp ult i64 %s, %s"):format(current, last))
    builder.terminate(f, ("br i1 %s, label %%%s, label %%%s"):format(more, body, exit))
    builder.start(f, body)
    ctx.mapIndex = current
    ctx.loops[#ctx.loops + 1] = new context.Loop(breakLabel = exit, continueLabel = latch)
    statements.block(ctx, loopShape.statements)
    ctx.loops[#ctx.loops] = nil
    ctx.mapIndex = nil
    builder.start(f, latch)
    local stepped = builder.value(f, ("add nuw i64 %s, 1"):format(current))
    builder.emit(f, ("store i64 %s, ptr %s"):format(stepped, index))
    builder.jump(f, head)
    builder.start(f, exit)
    builder.finish(f, "ret void")
end

--- The module for `programs` at feature tier `tier` on `selected`, stating
--- the `stated` facts (all of them when nil), with line tables into
--- `sourceFile` when one is given; `logical` keeps each entry's logical
--- symbol rather than the tier's.
--- @raises string when a program uses what this backend does not emit
function llvmProgram.module(
    programs: {scalarIR.Program},
    tier: string,
    selected: profile.Profile,
    stated: facts.Facts?,
    sourceFile: string?,
    logical: boolean?
): string
    local module = builder.module()
    local unit = new llvmProgram.Unit(
        module = module,
        tier = logical ~= true and tier or nil,
        maskedMemory = tier == "avx2" or tier == "avx512f",
        codegenTier = tier,
        target = selected,
        facts = stated or facts.all(),
        lines = sourceFile ~= nil and dwarf.unit(module, sourceFile as string, selected.format == "macho" and 4 or 5)
        or nil,
        defined = {}
    )
    local kernels: {[integer]: boolean} = {}
    local registered: {luaEntry.Registered} = {}
    local registrar: string? = nil
    local registrarProgram: scalarIR.Program? = nil
    for _, program in ipairs(programs) do
        if program.executionTarget == "gpu" then
            -- Shader programs have their own artifacts.
        elseif program.entryMode == "lua-builder" then
            registrar = registrar or program.registrar
            if registrar ~= program.registrar then
                error("one translation unit carried multiple Lua registrars", 0)
            end
            registrarProgram = registrarProgram or program
            registered[#registered + 1] = builderEntry(unit, program)
        else
            -- A SIMD kernel has an unoptimized twin the differential tests
            -- compare it against, emitted first as the C lowering did.
            if program.usesSimd == true then
                kernel(unit, program, true)
                kernels[#module.functions] = true
            end
            kernel(unit, program, false)
            kernels[#module.functions] = true
            for _, layout in ipairs(program.layouts or {}) do
                layoutReporters(unit, program, layout)
            end
        end
    end

    if registrar ~= nil then
        luaEntry.registrar(
            module,
            physical(registrar as string, unit.tier),
            builder.attributes(module, luaAttributes(selected)),
            selected.sizeType,
            registered,
            registrarProgram as scalarIR.Program
        )
    end

    -- A kernel touches only memory its span arguments reach, unless the unit
    -- calls something outside it: a libm function may set `errno` until the
    -- runtime's math says otherwise.
    -- Constant tables are globals, which a kernel may also read.
    local opaque = false
    local globals = false
    for _, key in ipairs(module.order) do
        local piece = module.pieces[key] as string
        -- The Lua API is only a builder entry's to call.
        local name = piece:match("^declare [^@]*@([%w_.]+)")
        if name ~= nil and name:match("^llvm%.") == nil and name:match("^luaL?_") == nil then
            opaque = true
        elseif piece:match("^@") ~= nil then
            globals = true
        end
    end
    if unit.facts.effects and not opaque then
        local reach = globals and "memory(read, argmem: readwrite)" or "memory(argmem: readwrite)"
        for index in pairs(kernels) do
            module.functions[index] = (module.functions[index]:gsub("^(define [^\n]-%)) #", "%1 " .. reach .. " #", 1))
        end
    end

    return builder.render(module)
end

--- Whether `err` is this backend saying "not yet" rather than "wrong".
function llvmProgram.isUnsupported(err: any): boolean
    return type(err) == "string" and (err as string):sub(1, #expressions.UNSUPPORTED) == expressions.UNSUPPORTED
end

export = llvmProgram
