--[[
Which proved facts the LLVM lowering states.

Every fact the lowering hands LLVM comes from a proof, and every family of them
can be turned off, so a differential run can compile with a family off and
compare: a fact that changes a result is a bug in its proof.

- `alias`: `noalias` on spans proved disjoint from every written span.
- `access`: `readonly`, `writeonly` and `captures(none)` on spans.
- `effects`: `nofree`, `nosync` and `memory(...)` on kernels.
- `bounds`: `inbounds nuw` addressing and `nuw` index arithmetic.
- `relations`: the guard relations the wrapper checks before every call, as
  `llvm.assume` at entry, and span counts' range (at most 2^53).
- `extents`: each span readable for its count's elements and aligned to its
  element, as `dereferenceable` and `align` assumptions at entry.

Two facts are stated without a family, because nothing about them can be
wrong in a way a differential would catch:

- Per-access `!alias.scope` and `!noalias` would restate `noalias`. Every pair
  of regions that involves a written span is disjoint by construction, so every
  span parameter already carries `noalias`, and LLVM's inliner turns those
  into scopes on the accesses it inlines.
- A call from one entry to another of its file reaches the callee's own
  definition in the same module, so LLVM sees the callee's attributes, and can
  inline it, rather than a bare declaration.
]]
module nupp.compiler.aot.llvm.facts

export const FAMILIES = {"alias", "access", "effects", "bounds", "relations", "extents"}

--- The set of families stated.
export record Facts
    alias: boolean
    access: boolean
    effects: boolean
    bounds: boolean
    relations: boolean
    extents: boolean
end

export function all(): Facts
    return new Facts(alias = true, access = true, effects = true, bounds = true, relations = true, extents = true)
end

export function none(): Facts
    return new Facts(alias = false, access = false, effects = false, bounds = false, relations = false, extents = false)
end

--- `all`, `none`, or a comma-separated list of families, or nil and why not.
export function parse(text: string): (Facts?, string?)
    if text == "" or text == "all" then
        return all(), nil
    elseif text == "none" then
        return none(), nil
    end
    local selected = none()
    for name in text:gmatch("[^,%s]+") do
        if name == "alias" then
            selected.alias = true
        elseif name == "access" then
            selected.access = true
        elseif name == "effects" then
            selected.effects = true
        elseif name == "bounds" then
            selected.bounds = true
        elseif name == "relations" then
            selected.relations = true
        elseif name == "extents" then
            selected.extents = true
        else
            return nil, "unknown AOT fact family " .. name .. "; the families are " .. table.concat(FAMILIES, ", ")
        end
    end

    return selected, nil
end

--- The selection as stable text, for a cache key.
export function key(selected: Facts): string
    local names: {string} = {}
    for _, name in ipairs(FAMILIES) do
        if (selected as any)[name] == true then
            names[#names + 1] = name
        end
    end

    return #names == #FAMILIES and "all" or #names == 0 and "none" or table.concat(names, ",")
end
