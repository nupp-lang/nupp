module nupp.compiler.aot.llvm.context

--[[
What emitting one function needs to know about the program around it.

A `Context` is one function definition's state: the builder it writes into, the
program it is a rendering of, where each local lives, which LLVM value each
parameter and count is, and the break and continue targets of the loops around
the statement being emitted. Expressions and statements read it; only the entry
and statement emitters change it.
]]

local builder = require("nupp.compiler.aot.llvm.builder")
local facts = require("nupp.compiler.aot.llvm.facts")
local scalarIR = require("nupp.compiler.aot.scalar")
local species = require("nupp.compiler.aot.llvm.simd.species")
local states = require("nupp.compiler.aot.llvm.simd.states")
local types = require("nupp.compiler.aot.llvm.types")

local context = {}

--- One local: the stack slot it lives in and its IR type.
record context.Slot
    pointer: string
    type: string

    --- Whether the value is reassigned after its binding, and so carried
    --- around a loop.
    carried: boolean
end

--- One span parameter as the function receives it.
record context.Span
    pointer: string
    param: scalarIR.Param
end

--- A reducer a region accumulates lane-wise in a vector, folded into the
--- reducer's state when the region ends.
record context.Accumulator
    --- The vector slot.
    pointer: string

    --- Its LLVM vector type.
    vector: string
end

--- The targets `break` and `continue` jump to inside one loop.
record context.Loop
    breakLabel: string
    continueLabel: string
end

record context.Context
    f: builder.Function
    module: builder.Module
    program: scalarIR.Program

    locals: {[string]: context.Slot}
    uniforms: {[string]: string}
    spans: {[string]: context.Span}

    --- The count each span's bounds use, as an i64 value.
    counts: {[string]: string}

    --- The map loop's zero-based iteration, as an i64 value, inside it.
    mapIndex: string?

    --- Each visible helper's LLVM function, by IR name.
    helpers: {[string]: string}

    --- Helper parameters' values while a helper body is emitted, by C name.
    helperParams: {[string]: string}

    --- Reified layouts by IR name.
    layouts: {[string]: scalarIR.Layout}

    loops: {context.Loop}

    --- Lua 5.1 rather than LuaJIT min/max tie-breaking.
    lua51Math: boolean

    --- Whether ordinary binary64 arithmetic may contract (`@relax`).
    contract: boolean

    --- The result block a multi-result entry writes, and its LLVM struct type.
    resultBlock: string?

    resultStruct: string?

    --- The proved facts this unit states.
    facts: facts.Facts

    --- The subprogram locations are scoped to, when the unit has line tables.
    scope: string?

    --- Whether the tier has masked vector moves (AVX2, AVX-512), which a
    --- partial access then uses instead of a lane loop.
    maskedMemory: boolean

    --- The feature tier compiled for.
    tier: string

    --- The inline-asm constraint of one vector register on this target
    --- (`w` on AArch64, `x` on x86), or empty where there is none to use.
    vectorRegister: string

    --- The i64 counters of numeric `for` loops over a span, by the C name of
    --- their binding: an access through the binding indexes from these.
    spanCounters: {[string]: string}

    --- The lane counts of masks bound once to `species:tail(n)`, by C name:
    --- such a mask is exactly the first `n` lanes, as an i32 value.
    tailCounts: {[string]: string}

    --- Whether every span a proved cursor access in scope reaches is known
    --- to hold at most `UINT32_MAX` elements, so no cursor offset can wrap
    --- and a proof needs no check.
    wideCursors: boolean

    --- Whether this body is the unoptimized scalar oracle, which folds every
    --- reducer contribution lane by lane.
    oracle: boolean

    --- The vector accumulators of the reducer region being emitted, by
    --- reducer name.
    accumulators: {[string]: context.Accumulator}
end

--- A fresh context for one function of `program`.
function context.new(
    module: builder.Module,
    f: builder.Function,
    program: scalarIR.Program,
    stated: facts.Facts?
): context.Context
    local layouts: {[string]: scalarIR.Layout} = {}
    for _, layout in ipairs(program.layouts or {}) do
        layouts[layout.name] = layout
    end

    return new context.Context(
        f = f,
        module = module,
        program = program,
        locals = {},
        uniforms = {},
        spans = {},
        counts = {},
        mapIndex = nil,
        helpers = {},
        helperParams = {},
        layouts = layouts,
        loops = {},
        lua51Math = program.numericForRuntime == "lua51",
        contract = program.fpContract == true,
        facts = stated or facts.all(),
        scope = nil,
        maskedMemory = false,
        tier = "",
        vectorRegister = "",
        oracle = false,
        wideCursors = false,
        tailCounts = {},
        spanCounters = {},
        accumulators = {}
    )
end

--- The i64 count bounding `span`.
--- @raises string when the entry received no count for it
function context.count(ctx: context.Context, span: string): string
    local found = ctx.counts[span]
    if found == nil then
        error("no count for span " .. span, 0)
    end

    return found as string
end

--- The bytes one register holds for the program's explicit SIMD species.
function context.width(ctx: context.Context): integer
    return ctx.program.simdWidth or 16
end

--- The explicit SIMD species an IR type names, if it names one.
function context.species(ctx: context.Context, typeName: string): species.Species?
    return species.of(context.width(ctx), typeName)
end

--- The LLVM type a value of IR type `typeName` is carried in: a scalar's,
--- a vector or mask's, or a reducer's state. A species has no runtime value;
--- it answers `i32`, the type its lane count is spelled in.
--- @raises string when nothing carries the type
function context.llvmType(ctx: context.Context, typeName: string): string
    local scalar = types.value(typeName)
    if scalar ~= nil then
        return scalar as string
    end
    local found = context.species(ctx, typeName)
    if found ~= nil then
        return species.carrier(found as species.Species) or "i32"
    end
    local state = states.type(typeName)
    if state ~= nil then
        return state as string
    end
    error("no LLVM type for " .. typeName, 0)
end

--- The LLVM type a local of IR type `typeName` is kept in. A mask the body
--- reassigns is kept as wide as its lanes -- all ones or all zeros, the form
--- a vector compare produces -- except on AVX-512, whose mask registers are
--- one bit a lane: a loop carrying `<N x i1>` elsewhere narrows and widens
--- it every pass. A mask bound once stays `<N x i1>`, which folds.
function context.slotType(ctx: context.Context, typeName: string, carried: boolean): string
    local found = context.species(ctx, typeName)
    if carried and found ~= nil and (found as species.Species).family == "mask" and ctx.tier ~= "avx512f" then
        local mask = found as species.Species
        return "<" .. tostring(mask.lanes) .. " x i" .. tostring(mask.bits) .. ">"
    end

    return context.llvmType(ctx, typeName)
end

--- `value` passed through an empty inline asm, one register at a time, so
--- the optimizer cannot see what produced it. A lane-wide mask needs this:
--- otherwise LLVM folds the widening back through the loop's phi and
--- carries `<N x i1>` again, as the C lowering's `keep_mask` also found.
function context.opaque(ctx: context.Context, value: string, vector: string): string
    local register = ctx.vectorRegister
    if register == "" then
        return value
    end
    local lanes, element = vector:match("^<(%d+) x i(%d+)>$")
    if lanes == nil then
        return value
    end
    local count = tonumber(lanes) as integer
    local bits = tonumber(element) as integer
    local perRegister = math.floor(context.width(ctx) * 8 / bits) as integer
    if perRegister < 1 or count % perRegister ~= 0 then
        return value
    end
    local chunk = "<" .. tostring(perRegister) .. " x i" .. tostring(bits) .. ">"
    local pieces: {string} = {}
    for start = 0, count - perRegister, perRegister do
        local picks: {string} = {}
        for lane = start, start + perRegister - 1 do
            picks[#picks + 1] = "i32 " .. tostring(lane)
        end
        local piece = count == perRegister and value
            or builder.value(
                ctx.f,
                (
                    "shufflevector %s %s, %s poison, %s <%s>"
                ):format(vector, value, vector, "<" .. tostring(perRegister) .. " x i32>", table.concat(picks, ", "))
            )
        pieces[
            #pieces + 1
        ] = builder.value(ctx.f, ("call %s asm \"\", \"=%s,0\"(%s %s)"):format(chunk, register, chunk, piece))
    end
    -- Reassemble the registers pairwise.
    local width = perRegister
    while #pieces > 1 do
        local joined: {string} = {}
        local type = "<" .. tostring(width) .. " x i" .. tostring(bits) .. ">"
        for index = 1, #pieces, 2 do
            local picks: {string} = {}
            for lane = 0, 2 * width - 1 do
                picks[#picks + 1] = "i32 " .. tostring(lane)
            end
            joined[
                #joined + 1
            ] = builder.value(
                ctx.f,
                (
                    "shufflevector %s %s, %s %s, <%d x i32> <%s>"
                ):format(type, pieces[index], type, pieces[index + 1] or "poison", 2 * width, table.concat(picks, ", "))
            )
        end
        pieces = joined
        width = width * 2
    end

    return pieces[1]
end

--- Reads a local's value from its slot.
function context.loadSlot(ctx: context.Context, slot: context.Slot): string
    local kept = context.slotType(ctx, slot.type, slot.carried)
    local loaded = builder.value(ctx.f, ("load %s, ptr %s"):format(kept, slot.pointer))
    if kept == context.llvmType(ctx, slot.type) then
        return loaded
    end

    return builder.value(ctx.f, ("icmp ne %s %s, zeroinitializer"):format(kept, loaded))
end

--- Writes a local's value (of its LLVM type) to its slot.
function context.storeSlot(ctx: context.Context, slot: context.Slot, value: string): nil
    local kept = context.slotType(ctx, slot.type, slot.carried)
    local carried = context.llvmType(ctx, slot.type)
    local stored = value
    if kept ~= carried then
        stored = builder.value(ctx.f, ("sext %s %s to %s"):format(carried, value, kept))
        stored = context.opaque(ctx, stored, kept)
    end
    builder.emit(ctx.f, ("store %s %s, ptr %s"):format(kept, stored, slot.pointer))
end

--- The innermost enclosing loop.
--- @raises string outside every loop
function context.loop(ctx: context.Context): context.Loop
    local found = ctx.loops[#ctx.loops]
    if found == nil then
        error("break or continue outside a loop", 0)
    end

    return found as context.Loop
end

export = context
