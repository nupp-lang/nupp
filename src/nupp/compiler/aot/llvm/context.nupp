module nupp.compiler.aot.llvm.context

--[[
What emitting one function needs to know about the program around it.

A `Context` is one function definition's state: the builder it writes into, the
program it is a rendering of, where each local lives, which LLVM value each
parameter and count is, and the break and continue targets of the loops around
the statement being emitted. Expressions and statements read it; only the entry
and statement emitters change it.
]]

local builder = require("nupp.compiler.aot.llvm.builder")
local facts = require("nupp.compiler.aot.llvm.facts")
local scalarIR = require("nupp.compiler.aot.scalar")
local species = require("nupp.compiler.aot.llvm.simd.species")
local states = require("nupp.compiler.aot.llvm.simd.states")
local types = require("nupp.compiler.aot.llvm.types")

local context = {}

--- One local: the stack slot it lives in and its IR type.
record context.Slot
    pointer: string
    type: string
end

--- One span parameter as the function receives it.
record context.Span
    pointer: string
    param: scalarIR.Param
end

--- A reducer a region accumulates lane-wise in a vector, folded into the
--- reducer's state when the region ends.
record context.Accumulator
    --- The vector slot.
    pointer: string

    --- Its LLVM vector type.
    vector: string
end

--- The targets `break` and `continue` jump to inside one loop.
record context.Loop
    breakLabel: string
    continueLabel: string
end

record context.Context
    f: builder.Function
    module: builder.Module
    program: scalarIR.Program

    locals: {[string]: context.Slot}
    uniforms: {[string]: string}
    spans: {[string]: context.Span}

    --- The count each span's bounds use, as an i64 value.
    counts: {[string]: string}

    --- The map loop's zero-based iteration, as an i64 value, inside it.
    mapIndex: string?

    --- Each visible helper's LLVM function, by IR name.
    helpers: {[string]: string}

    --- Helper parameters' values while a helper body is emitted, by C name.
    helperParams: {[string]: string}

    --- Reified layouts by IR name.
    layouts: {[string]: scalarIR.Layout}

    loops: {context.Loop}

    --- Lua 5.1 rather than LuaJIT min/max tie-breaking.
    lua51Math: boolean

    --- Whether ordinary binary64 arithmetic may contract (`@relax`).
    contract: boolean

    --- The result block a multi-result entry writes, and its LLVM struct type.
    resultBlock: string?

    resultStruct: string?

    --- The proved facts this unit states.
    facts: facts.Facts

    --- The subprogram locations are scoped to, when the unit has line tables.
    scope: string?

    --- Whether the tier has masked vector moves (AVX2, AVX-512), which a
    --- partial access then uses instead of a lane loop.
    maskedMemory: boolean

    --- Whether this body is the unoptimized scalar oracle, which folds every
    --- reducer contribution lane by lane.
    oracle: boolean

    --- The vector accumulators of the reducer region being emitted, by
    --- reducer name.
    accumulators: {[string]: context.Accumulator}
end

--- A fresh context for one function of `program`.
function context.new(
    module: builder.Module,
    f: builder.Function,
    program: scalarIR.Program,
    stated: facts.Facts?
): context.Context
    local layouts: {[string]: scalarIR.Layout} = {}
    for _, layout in ipairs(program.layouts or {}) do
        layouts[layout.name] = layout
    end

    return new context.Context(
        f = f,
        module = module,
        program = program,
        locals = {},
        uniforms = {},
        spans = {},
        counts = {},
        mapIndex = nil,
        helpers = {},
        helperParams = {},
        layouts = layouts,
        loops = {},
        lua51Math = program.numericForRuntime == "lua51",
        contract = program.fpContract == true,
        facts = stated or facts.all(),
        scope = nil,
        maskedMemory = false,
        oracle = false,
        accumulators = {}
    )
end

--- The i64 count bounding `span`.
--- @raises string when the entry received no count for it
function context.count(ctx: context.Context, span: string): string
    local found = ctx.counts[span]
    if found == nil then
        error("no count for span " .. span, 0)
    end

    return found as string
end

--- The bytes one register holds for the program's explicit SIMD species.
function context.width(ctx: context.Context): integer
    return ctx.program.simdWidth or 16
end

--- The explicit SIMD species an IR type names, if it names one.
function context.species(ctx: context.Context, typeName: string): species.Species?
    return species.of(context.width(ctx), typeName)
end

--- The LLVM type a value of IR type `typeName` is carried in: a scalar's,
--- a vector or mask's, or a reducer's state. A species has no runtime value;
--- it answers `i32`, the type its lane count is spelled in.
--- @raises string when nothing carries the type
function context.llvmType(ctx: context.Context, typeName: string): string
    local scalar = types.value(typeName)
    if scalar ~= nil then
        return scalar as string
    end
    local found = context.species(ctx, typeName)
    if found ~= nil then
        return species.carrier(found as species.Species) or "i32"
    end
    local state = states.type(typeName)
    if state ~= nil then
        return state as string
    end
    error("no LLVM type for " .. typeName, 0)
end

--- The innermost enclosing loop.
--- @raises string outside every loop
function context.loop(ctx: context.Context): context.Loop
    local found = ctx.loops[#ctx.loops]
    if found == nil then
        error("break or continue outside a loop", 0)
    end

    return found as context.Loop
end

export = context
