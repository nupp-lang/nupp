module nupp.compiler.aot.llvm.simd.memory

--[[
Vector loads and stores against spans.

Every access is clamped rather than faulting. A vector at 1-based `offset`
starts at element `first = offset - 1`, and an offset that is not a positive
integer becomes an unreachable `first`. Then `room = min(count - first, N)`
lanes are in the span (none when `first >= count`). A load reads the in-bounds
lanes and answers 0 for the rest; a store writes only the in-bounds lanes; a
mask narrows either further, and an inactive lane of a load reads as 0.

The whole-vector case is one plain load or store, and only a partial vector
takes the masked form. Gathers, scatters and struct-field accesses use lane
pointers, and disabled lanes address element 0 so no pointer leaves its span.
]]

local builder = require("nupp.compiler.aot.llvm.builder")
local context = require("nupp.compiler.aot.llvm.context")
local expressions = require("nupp.compiler.aot.llvm.expressions")
local lanes = require("nupp.compiler.aot.llvm.simd.lanes")
local prelude = require("nupp.compiler.aot.llvm.prelude")
local scalarIR = require("nupp.compiler.aot.scalar")
local simdbounds = require("nupp.compiler.aot.simdbounds")
local species = require("nupp.compiler.aot.llvm.simd.species")
local types = require("nupp.compiler.aot.llvm.types")

local memory = {}

--- @raises string always
local function unsupported(what: string): never
    error(expressions.UNSUPPORTED .. what, 0)
end

local function e(ctx: context.Context, instruction: string): string
    return lanes.emit(ctx, instruction)
end

local function operand(ctx: context.Context, node: scalarIR.Expr): string
    local value = expressions.value(ctx, node)

    return value
end

--- The zero-based first element a 1-based offset names, as an i64, or
--- all ones when the offset names no element.
function memory.first(ctx: context.Context, offset: scalarIR.Expr): string
    if offset.op == "int_to_f64" then
        local inner = (offset as scalarIR.Convert).value
        local value, t = expressions.value(ctx, inner)
        local wide = expressions.convert(ctx, value, t, types.signed(t) and "i64" or "u64")
        local positive = types.signed(t) and e(ctx, ("icmp sgt i64 %s, 0"):format(wide))
            or e(ctx, ("icmp ne i64 %s, 0"):format(wide))
        local less = e(ctx, ("sub i64 %s, 1"):format(wide))

        return e(ctx, ("select i1 %s, i64 %s, i64 -1"):format(positive, less))
    end
    local value, t = expressions.value(ctx, offset)
    local x = expressions.convert(ctx, value, t, "f64")
    local floor = prelude.intrinsic(ctx.module, "llvm.floor.f64", "double @NAME(double)")
    local atLeastOne = e(ctx, ("fcmp oge double %s, 1.0"):format(x))
    local floored = e(ctx, ("call double %s(double %s)"):format(floor, x))
    local integral = e(ctx, ("fcmp oeq double %s, %s"):format(x, floored))
    local less = e(ctx, ("fsub double %s, 1.0"):format(x))
    -- (double)SIZE_MAX rounds to 2^64.
    local small = e(ctx, ("fcmp olt double %s, 0x43F0000000000000"):format(less))
    local both = e(ctx, ("and i1 %s, %s"):format(atLeastOne, integral))
    local valid = e(ctx, ("and i1 %s, %s"):format(both, small))
    local converted = e(ctx, ("fptoui double %s to i64"):format(less))

    return e(ctx, ("select i1 %s, i64 %s, i64 -1"):format(valid, converted))
end

--- Where an access starts and how much of it is in the span.
record memory.Window
    --- The first element's address (the span's start when nothing is in
    --- bounds, so it never points outside).
    address: string

    --- How many lanes are in bounds, as an i32 in [0, lanes].
    room: string

    --- The first element, as an i64.
    first: string

    --- Whether `first` is inside the span.
    inside: string
end

--- The window `lanes` elements wide at `first` in span `name` of `storage`.
--- @raises string when the entry has no span by that name
function memory.window(
    ctx: context.Context,
    name: string,
    first: string,
    width: integer,
    storage: string
): memory.Window
    local span = ctx.spans[name]
    if span == nil then
        error("no span " .. name, 0)
    end
    local count = context.count(ctx, name)
    local inside = e(ctx, ("icmp ult i64 %s, %s"):format(first, count))
    local left = e(ctx, ("sub i64 %s, %s"):format(count, first))
    local capped = e(
        ctx,
        ("select i1 %s, i64 %s, i64 %d"):format(e(ctx, ("icmp ult i64 %s, %d"):format(left, width)), left, width)
    )
    local room64 = e(ctx, ("select i1 %s, i64 %s, i64 0"):format(inside, capped))
    local room = e(ctx, ("trunc i64 %s to i32"):format(room64))
    local start = e(ctx, ("select i1 %s, i64 %s, i64 0"):format(inside, first))
    local address = e(
        ctx,
        ("getelementptr inbounds %s, ptr %s, i64 %s"):format(storage, (span as context.Span).pointer, start)
    )

    return new memory.Window(address = address, room = room, first = first, inside = inside)
end

--- The lanes below `room` of a `count`-lane access.
local function roomMask(ctx: context.Context, count: integer, room: string): string
    local bound = lanes.splat(ctx, count, "i32", room)

    return e(ctx, ("icmp ult %s, %s"):format(lanes.indices(count, "i32"), bound))
end

--- Runs `whole` when all `count` lanes are in the window and `partial`
--- otherwise, joining the vectors they answer (or nothing, for stores).
local function split(
    ctx: context.Context,
    window: memory.Window,
    count: integer,
    resultType: string?,
    whole: function(): string?,
    partial: function(): string?
): string?
    local f = ctx.f
    local full = e(ctx, ("icmp eq i32 %s, %d"):format(window.room, count))
    local wholeLabel = builder.label(f, "simd.whole")
    local partLabel = builder.label(f, "simd.part")
    local joinLabel = builder.label(f, "simd.join")
    builder.terminate(f, ("br i1 %s, label %%%s, label %%%s"):format(full, wholeLabel, partLabel))
    builder.start(f, wholeLabel)
    local a = whole()
    local aEnd = f.current
    builder.jump(f, joinLabel)
    builder.start(f, partLabel)
    local b = partial()
    local bEnd = f.current
    builder.start(f, joinLabel)
    if resultType == nil then
        return nil
    end

    return e(
        ctx,
        ("phi %s [ %s, %%%s ], [ %s, %%%s ]"):format(resultType as string, tostring(a), aEnd, tostring(b), bEnd)
    )
end

local function maskedLoad(
    ctx: context.Context,
    vector: string,
    suffix: string,
    address: string,
    align: integer,
    mask: string,
    count: integer
): string
    local callee = prelude.intrinsic(
        ctx.module,
        "llvm.masked.load." .. suffix .. ".p0",
        ("%s @NAME(ptr, <%d x i1>, %s)"):format(vector, count, vector)
    )

    return e(
        ctx,
        (
            "call %s %s(ptr align %d %s, <%d x i1> %s, %s zeroinitializer)"
        ):format(vector, callee, align, address, count, mask, vector)
    )
end

local function maskedStore(
    ctx: context.Context,
    vector: string,
    suffix: string,
    value: string,
    address: string,
    align: integer,
    mask: string,
    count: integer
): nil
    local callee = prelude.intrinsic(
        ctx.module,
        "llvm.masked.store." .. suffix .. ".p0",
        ("void @NAME(%s, ptr, <%d x i1>)"):format(vector, count)
    )
    builder.emit(
        ctx.f,
        (
            "call void %s(%s %s, ptr align %d %s, <%d x i1> %s)"
        ):format(callee, vector, value, align, address, count, mask)
    )
end

--- One partial access's shape: `count` lanes of `scalar` at `address`.
record memory.Access
    vector: string
    scalar: string
    count: integer
    address: string
    align: integer
end

local function access(scalar: string, count: integer, address: string, align: integer): memory.Access
    return new memory.Access(
        vector = "<" .. tostring(count) .. " x " .. scalar .. ">",
        scalar = scalar,
        count = count,
        address = address,
        align = align
    )
end

--- Whether a partial access of this element width is one masked
--- instruction on this tier. Only AVX2 and AVX-512 have masked moves, and
--- only of 32- and 64-bit lanes; elsewhere LLVM would expand the masked
--- intrinsic into a branch per lane, which is what the lane loop below does
--- in far less code.
local function hardwareMasks(ctx: context.Context, a: memory.Access): boolean
    return ctx.maskedMemory and (a.align == 4 or a.align == 8)
end

--- A loop over lanes `0 .. room - 1`, `step` emitting one lane's work.
--- With `carryType`, a value starts at `initial`, `step` answers its next
--- value, and the loop answers the last.
local function laneLoop(
    ctx: context.Context,
    room: string,
    carryType: string?,
    initial: string?,
    step: function(lane: string, carry: string?): string?
): string?
    local f = ctx.f
    local before = f.current
    local head = builder.label(f, "lanes.head")
    local body = builder.label(f, "lanes.body")
    local latch = builder.label(f, "lanes.latch")
    local done = builder.label(f, "lanes.done")
    local lane = builder.temp(f)
    local nextLane = builder.temp(f)
    local carry: string? = carryType ~= nil and builder.temp(f) or nil
    builder.start(f, head)
    builder.emit(f, ("%s = phi i32 [ 0, %%%s ], [ %s, %%%s ]"):format(lane, before, nextLane, latch))
    local carrySlot: integer = 0
    if carry ~= nil then
        builder.emit(f, "")
        carrySlot = #f.lines
    end
    local more = e(ctx, ("icmp ult i32 %s, %s"):format(lane, room))
    builder.terminate(f, ("br i1 %s, label %%%s, label %%%s"):format(more, body, done))
    builder.start(f, body)
    local produced = step(lane, carry)
    builder.start(f, latch)
    builder.emit(f, ("%s = add nuw i32 %s, 1"):format(nextLane, lane))
    builder.terminate(f, "br label %" .. head)
    builder.start(f, done)
    if carry == nil then
        return nil
    end
    f.lines[
        carrySlot
    ] = (
        "  %s = phi %s [ %s, %%%s ], [ %s, %%%s ]"
    ):format(carry as string, carryType as string, initial as string, before, tostring(produced), latch)

    return carry
end

--- Copies element `lane` between two arrays of `a.scalar`, `from[lane]`
--- to `to[lane]`, when `active` (a mask, or nil for always) has it on.
local function copyLane(
    ctx: context.Context,
    a: memory.Access,
    from: string,
    to: string,
    lane: string,
    active: string?
): nil
    local f = ctx.f
    local skip: string? = nil
    if active ~= nil then
        local on = e(ctx, ("extractelement <%d x i1> %s, i32 %s"):format(a.count, active as string, lane))
        local write = builder.label(f, "lanes.write")
        skip = builder.label(f, "lanes.skip")
        builder.terminate(f, ("br i1 %s, label %%%s, label %%%s"):format(on, write, skip as string))
        builder.start(f, write)
    end
    local at = e(ctx, ("zext i32 %s to i64"):format(lane))
    local source = e(ctx, ("getelementptr inbounds %s, ptr %s, i64 %s"):format(a.scalar, from, at))
    local target = e(ctx, ("getelementptr inbounds %s, ptr %s, i64 %s"):format(a.scalar, to, at))
    local value = e(ctx, ("load %s, ptr %s, align %d"):format(a.scalar, source, a.align))
    builder.emit(f, ("store %s %s, ptr %s, align %d"):format(a.scalar, value, target, a.align))
    if skip ~= nil then
        builder.start(f, skip as string)
    end
end

--- A stack buffer one vector of `a` wide.
local function buffer(ctx: context.Context, a: memory.Access): string
    return builder.alloca(ctx.f, a.vector, 16)
end

--- The first `room` lanes read, the rest 0, and with `active` the inactive
--- lanes 0 too: the in-bounds elements copied into a zeroed buffer, which is
--- then one vector load.
local function partialLoad(ctx: context.Context, a: memory.Access, room: string, active: string?): string
    local lanesMask = "<" .. tostring(a.count) .. " x i1>"
    if hardwareMasks(ctx, a) then
        local mask = roomMask(ctx, a.count, room)
        if active ~= nil then
            mask = e(ctx, ("and %s %s, %s"):format(lanesMask, mask, active as string))
        end
        return maskedLoad(ctx, a.vector, lanes.suffix(a.count, a.scalar), a.address, a.align, mask, a.count)
    end
    local staging = buffer(ctx, a)
    builder.emit(ctx.f, ("store %s zeroinitializer, ptr %s, align 16"):format(a.vector, staging))
    laneLoop(ctx, room, nil, nil, function(lane: string, _: string?): string?
        copyLane(ctx, a, a.address, staging, lane, active)
        return nil
    end)

    return e(ctx, ("load %s, ptr %s, align 16"):format(a.vector, staging))
end

--- The first `room` lanes of `value` written, and with `active` only the
--- active ones among them: the vector stored to a buffer and the elements
--- copied out.
local function partialStore(ctx: context.Context, a: memory.Access, value: string, room: string, active: string?): nil
    local lanesMask = "<" .. tostring(a.count) .. " x i1>"
    if hardwareMasks(ctx, a) then
        local mask = roomMask(ctx, a.count, room)
        if active ~= nil then
            mask = e(ctx, ("and %s %s, %s"):format(lanesMask, mask, active as string))
        end
        maskedStore(ctx, a.vector, lanes.suffix(a.count, a.scalar), value, a.address, a.align, mask, a.count)
        return
    end
    local staging = buffer(ctx, a)
    builder.emit(ctx.f, ("store %s %s, ptr %s, align 16"):format(a.vector, value, staging))
    laneLoop(ctx, room, nil, nil, function(lane: string, _: string?): string?
        copyLane(ctx, a, staging, a.address, lane, active)
        return nil
    end)
end

--- A contiguous load of `found` at `first`, optionally masked.
local function contiguousLoad(
    ctx: context.Context,
    found: species.Species,
    span: string,
    first: string,
    active: string?
): string
    local align = math.floor(found.bits / 8) as integer
    local window = memory.window(ctx, span, first, found.lanes, found.scalar)

    return split(
        ctx,
        window,
        found.lanes,
        found.vector,
        function(): string?
            local loaded = e(ctx, ("load %s, ptr %s, align %d"):format(found.vector, window.address, align))
            if active == nil then
                return loaded
            end

            return e(
                ctx,
                (
                    "select %s %s, %s %s, %s zeroinitializer"
                ):format(found.mask, active, found.vector, loaded, found.vector)
            )
        end,
        function(): string?
            return partialLoad(ctx, access(found.scalar, found.lanes, window.address, align), window.room, active)
        end
    ) as string
end

--- Lane `i` of result `part` is element `first + i * ways + part`: the
--- `ways * N` elements from `first` read as one wide vector (lanes past the
--- span 0) and the part's lanes picked out of it. The pick sits beside each
--- load rather than after the join, which is what lets LLVM make the whole
--- run one de-interleaving load (NEON's `ld2`..`ld4`).
local function interleavedLoad(ctx: context.Context, found: species.Species, simd: scalarIR.Simd, first: string): string
    local ways = simdbounds.ways(simd.intrinsic)
    local width = ways * found.lanes
    local wide = "<" .. tostring(width) .. " x " .. found.scalar .. ">"
    local align = math.floor(found.bits / 8) as integer
    local window = memory.window(ctx, tostring(simd.span), first, width, found.scalar)
    local part = simd.part or 0
    local picks: {string} = {}
    for index = 0, found.lanes - 1 do
        picks[#picks + 1] = "i32 " .. tostring(index * ways + part)
    end

    local function pick(value: string): string
        return e(
            ctx,
            (
                "shufflevector %s %s, %s poison, <%d x i32> <%s>"
            ):format(wide, value, wide, found.lanes, table.concat(picks, ", "))
        )
    end

    return split(
        ctx,
        window,
        width,
        found.vector,
        function(): string?
            return pick(e(ctx, ("load %s, ptr %s, align %d"):format(wide, window.address, align)))
        end,
        function(): string?
            return pick(partialLoad(ctx, access(found.scalar, width, window.address, align), window.room, nil))
        end
    ) as string
end

--- The lanes a gather or scatter may touch, and where each points: element
--- `index - 1` for an active index in [1, count], element 0 otherwise.
local function lanePointers(
    ctx: context.Context,
    found: species.Species,
    span: string,
    indexNode: scalarIR.Expr,
    active: string?
): (string, string)
    local indexSpecies = lanes.of(ctx, tostring(indexNode.type))
    local indices = operand(ctx, indexNode)
    local count = found.lanes
    local i64s = "<" .. tostring(count) .. " x i64>"
    local wide = indices
    if indexSpecies.bits < 64 then
        wide = e(
            ctx,
            ("%s %s %s to %s"):format(indexSpecies.signed and "sext" or "zext", indexSpecies.vector, indices, i64s)
        )
    end
    local positive = indexSpecies.signed and e(ctx, ("icmp sgt %s %s, zeroinitializer"):format(i64s, wide))
        or e(ctx, ("icmp ne %s %s, zeroinitializer"):format(i64s, wide))
    local spanCount = lanes.splat(ctx, count, "i64", context.count(ctx, span))
    local within = e(ctx, ("icmp ule %s %s, %s"):format(i64s, wide, spanCount))
    local enable = e(ctx, ("and %s %s, %s"):format(found.mask, positive, within))
    if active ~= nil then
        enable = e(ctx, ("and %s %s, %s"):format(found.mask, enable, active as string))
    end
    local less = e(ctx, ("sub %s %s, splat (i64 1)"):format(i64s, wide))
    local safe = e(ctx, ("select %s %s, %s %s, %s zeroinitializer"):format(found.mask, enable, i64s, less, i64s))
    local base = (ctx.spans[span] as context.Span).pointer
    local pointers = e(ctx, ("getelementptr %s, ptr %s, %s %s"):format(found.scalar, base, i64s, safe))

    return pointers, enable
end

--- How many lanes a gather or scatter of `found` is issued as. AVX-512F
--- without VL has only 512-bit gathers, so fewer than eight 32- or 64-bit
--- lanes are padded to eight disabled ones, as the C lowering batched them;
--- LLVM would otherwise walk the lanes.
local function issued(ctx: context.Context, found: species.Species): integer
    if ctx.tier == "avx512f" and found.bits >= 32 and found.lanes < 8 then
        return 8
    end

    return found.lanes
end

--- `value` (a `count`-lane vector of `scalar`) as `width` lanes, the added
--- ones taken from `fill`'s lanes (a constant of the same type).
local function pad(
    ctx: context.Context,
    value: string,
    count: integer,
    scalar: string,
    width: integer,
    fill: string
): string
    if width == count then
        return value
    end
    local picks: {string} = {}
    for lane = 0, width - 1 do
        picks[#picks + 1] = "i32 " .. tostring(lane < count and lane or count)
    end
    local vector = "<" .. tostring(count) .. " x " .. scalar .. ">"

    return e(
        ctx,
        (
            "shufflevector %s %s, %s %s, <%d x i32> <%s>"
        ):format(vector, value, vector, fill, width, table.concat(picks, ", "))
    )
end

local function gather(ctx: context.Context, found: species.Species, pointers: string, enable: string): string
    local width = issued(ctx, found)
    local align = math.floor(found.bits / 8) as integer
    local ptrs = "<" .. tostring(width) .. " x ptr>"
    local vector = "<" .. tostring(width) .. " x " .. found.scalar .. ">"
    local mask = "<" .. tostring(width) .. " x i1>"
    -- Added lanes repeat lane 0's address and are disabled.
    local wideEnable = pad(ctx, enable, found.lanes, "i1", width, "zeroinitializer")
    local widePointers = pad(ctx, pointers, found.lanes, "ptr", width, pointers)
    local callee = prelude.intrinsic(
        ctx.module,
        "llvm.masked.gather." .. lanes.suffix(width, found.scalar) .. ".v" .. tostring(width) .. "p0",
        ("%s @NAME(%s, %s, %s)"):format(vector, ptrs, mask, vector)
    )
    local gathered = e(
        ctx,
        (
            "call %s %s(%s align %d %s, %s %s, %s zeroinitializer)"
        ):format(vector, callee, ptrs, align, widePointers, mask, wideEnable, vector)
    )
    if width == found.lanes then
        return gathered
    end
    local picks: {string} = {}
    for lane = 0, found.lanes - 1 do
        picks[#picks + 1] = "i32 " .. tostring(lane)
    end

    return e(
        ctx,
        (
            "shufflevector %s %s, %s poison, <%d x i32> <%s>"
        ):format(vector, gathered, vector, found.lanes, table.concat(picks, ", "))
    )
end

local function scatter(
    ctx: context.Context,
    found: species.Species,
    value: string,
    pointers: string,
    enable: string
): nil
    local width = issued(ctx, found)
    local align = math.floor(found.bits / 8) as integer
    local ptrs = "<" .. tostring(width) .. " x ptr>"
    local vector = "<" .. tostring(width) .. " x " .. found.scalar .. ">"
    local mask = "<" .. tostring(width) .. " x i1>"
    local wideEnable = pad(ctx, enable, found.lanes, "i1", width, "zeroinitializer")
    local widePointers = pad(ctx, pointers, found.lanes, "ptr", width, pointers)
    local wideValue = pad(ctx, value, found.lanes, found.scalar, width, "zeroinitializer")
    local callee = prelude.intrinsic(
        ctx.module,
        "llvm.masked.scatter." .. lanes.suffix(width, found.scalar) .. ".v" .. tostring(width) .. "p0",
        ("void @NAME(%s, %s, %s)"):format(vector, ptrs, mask)
    )
    builder.emit(
        ctx.f,
        (
            "call void %s(%s %s, %s align %d %s, %s %s)"
        ):format(callee, vector, wideValue, ptrs, align, widePointers, mask, wideEnable)
    )
end

--- The pointers to field `field` of elements `first .. first + N - 1` of a
--- struct span, and the lanes in bounds and active.
local function fieldPointers(
    ctx: context.Context,
    found: species.Species,
    simd: scalarIR.Simd,
    first: string,
    active: string?
): (string, string)
    local layoutName = tostring(simd.layout)
    local structType = expressions.layoutType(ctx, layoutName)
    local layout = ctx.layouts[layoutName] as scalarIR.Layout
    local fieldIndex = 0
    for position, candidate in ipairs(layout.fields) do
        if candidate.name == simd.field then
            fieldIndex = position - 1
        end
    end
    local window = memory.window(ctx, tostring(simd.span), first, found.lanes, structType)
    local enable = roomMask(ctx, found.lanes, window.room)
    if active ~= nil then
        enable = e(ctx, ("and %s %s, %s"):format(found.mask, enable, active as string))
    end
    local i64s = "<" .. tostring(found.lanes) .. " x i64>"
    local offsets = e(
        ctx,
        ("select %s %s, %s, %s zeroinitializer"):format(found.mask, enable, lanes.indices(found.lanes, "i64"), i64s)
    )
    local pointers = e(
        ctx,
        ("getelementptr %s, ptr %s, %s %s, i32 %d"):format(structType, window.address, i64s, offsets, fieldIndex)
    )

    return pointers, enable
end

--- A vector load, by its intrinsic.
local function load(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local simd = node as scalarIR.Simd
    local typeName = tostring(simd.type)
    local found = lanes.of(ctx, typeName)
    if simd.rooted ~= nil then
        unsupported("rooted byte-view loads")
    end
    local intrinsic = tostring(simd.intrinsic)
    if intrinsic == "gather" then
        local active = simd.args[3] ~= nil and operand(ctx, simd.args[3] as scalarIR.Expr) or nil
        local pointers, enable = lanePointers(ctx, found, tostring(simd.span), simd.args[2], active)
        return gather(ctx, found, pointers, enable), typeName
    end
    local first = memory.first(ctx, simd.args[2])
    if simdbounds.interleaved(intrinsic) then
        return interleavedLoad(ctx, found, simd, first), typeName
    end
    local active = simd.args[3] ~= nil and operand(ctx, simd.args[3] as scalarIR.Expr) or nil

    return contiguousLoad(ctx, found, tostring(simd.span), first, active), typeName
end

local function fieldLoad(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local simd = node as scalarIR.Simd
    local typeName = tostring(simd.type)
    local found = lanes.of(ctx, typeName)
    local first = memory.first(ctx, simd.args[2])
    local active = simd.args[3] ~= nil and operand(ctx, simd.args[3] as scalarIR.Expr) or nil
    local pointers, enable = fieldPointers(ctx, found, simd, first, active)

    return gather(ctx, found, pointers, enable), typeName
end

--- The vectors of an interleaved store laid out as one `ways * N` run: one
--- shuffle of two halves (each vector, or a pair concatenated), the shape
--- LLVM recognizes as an interleaving store.
local function interleave(ctx: context.Context, found: species.Species, values: {string}): (string, string)
    local n = found.lanes
    local ways = #values
    local vector = found.vector

    local function concat(first: string, second: string?): string
        local picks: {string} = {}
        for lane = 0, 2 * n - 1 do
            picks[#picks + 1] = "i32 " .. tostring(lane)
        end

        return e(
            ctx,
            (
                "shufflevector %s %s, %s %s, <%d x i32> <%s>"
            ):format(vector, first, vector, second or "poison", 2 * n, table.concat(picks, ", "))
        )
    end

    local left, right, half = values[1], values[2], vector
    if ways > 2 then
        left = concat(values[1], values[2])
        right = concat(values[3], values[4])
        half = "<" .. tostring(2 * n) .. " x " .. found.scalar .. ">"
    end
    -- Element `lane * ways + way` is lane `lane` of vector `way`, which sits
    -- at `way * n + lane` in the two halves laid end to end.
    local picks: {string} = {}
    for lane = 0, n - 1 do
        for way = 0, ways - 1 do
            picks[lane * ways + way + 1] = "i32 " .. tostring(way * n + lane)
        end
    end
    local wide = "<" .. tostring(n * ways) .. " x " .. found.scalar .. ">"

    return e(
        ctx,
        (
            "shufflevector %s %s, %s %s, <%d x i32> <%s>"
        ):format(half, left, half, right, n * ways, table.concat(picks, ", "))
    ), wide
end

local function store(ctx: context.Context, node: scalarIR.Statement): nil
    local simd = node as scalarIR.Simd
    local intrinsic = tostring(simd.intrinsic)
    local found = lanes.of(ctx, tostring(simd.args[3].type))
    local span = tostring(simd.span)
    if intrinsic == "scatter" or intrinsic == "scatterUnchecked" then
        local value = operand(ctx, simd.args[3])
        local active = simd.args[4] ~= nil and operand(ctx, simd.args[4] as scalarIR.Expr) or nil
        local pointers, enable = lanePointers(ctx, found, span, simd.args[2], active)
        scatter(ctx, found, value, pointers, enable)
        return
    end
    local first = memory.first(ctx, simd.args[2])
    local align = math.floor(found.bits / 8) as integer
    if simdbounds.interleaved(intrinsic) then
        local values: {string} = {}
        for position = 3, #simd.args do
            values[#values + 1] = operand(ctx, simd.args[position])
        end
        local width = found.lanes * #values
        local window = memory.window(ctx, span, first, width, found.scalar)
        -- Interleaved beside each store, so LLVM sees one interleaving store
        -- (NEON's `st2`..`st4`).
        split(
            ctx,
            window,
            width,
            nil,
            function(): string?
                local wide, wideType = interleave(ctx, found, values)
                builder.emit(ctx.f, ("store %s %s, ptr %s, align %d"):format(wideType, wide, window.address, align))
                return nil
            end,
            function(): string?
                -- The vectors staged side by side and each element of the run
                -- copied from its own vector and lane, so this path shares no
                -- shuffle with the whole one.
                local staged = access(found.scalar, width, window.address, align)
                local staging = buffer(ctx, staged)
                for way, value in ipairs(values) do
                    local slot = e(
                        ctx,
                        (
                            "getelementptr inbounds %s, ptr %s, i64 %d"
                        ):format(found.scalar, staging, (way - 1) * found.lanes)
                    )
                    builder.emit(ctx.f, ("store %s %s, ptr %s, align %d"):format(found.vector, value, slot, align))
                end
                laneLoop(ctx, window.room, nil, nil, function(element: string, _: string?): string?
                    local way = e(ctx, ("urem i32 %s, %d"):format(element, #values))
                    local lane = e(ctx, ("udiv i32 %s, %d"):format(element, #values))
                    local base = e(ctx, ("mul nuw i32 %s, %d"):format(way, found.lanes))
                    local from = e(ctx, ("add nuw i32 %s, %s"):format(base, lane))
                    local fromWide = e(ctx, ("zext i32 %s to i64"):format(from))
                    local toWide = e(ctx, ("zext i32 %s to i64"):format(element))
                    local source = e(
                        ctx,
                        ("getelementptr inbounds %s, ptr %s, i64 %s"):format(found.scalar, staging, fromWide)
                    )
                    local target = e(
                        ctx,
                        ("getelementptr inbounds %s, ptr %s, i64 %s"):format(found.scalar, window.address, toWide)
                    )
                    local value = e(ctx, ("load %s, ptr %s, align %d"):format(found.scalar, source, align))
                    builder.emit(ctx.f, ("store %s %s, ptr %s, align %d"):format(found.scalar, value, target, align))

                    return nil
                end)

                return nil
            end
        )
        return
    end
    local value = operand(ctx, simd.args[3])
    local active = simd.args[4] ~= nil and operand(ctx, simd.args[4] as scalarIR.Expr) or nil
    local window = memory.window(ctx, span, first, found.lanes, found.scalar)
    local shape = access(found.scalar, found.lanes, window.address, align)
    if active ~= nil then
        partialStore(ctx, shape, value, window.room, active)
        return
    end
    split(
        ctx,
        window,
        found.lanes,
        nil,
        function(): string?
            builder.emit(ctx.f, ("store %s %s, ptr %s, align %d"):format(found.vector, value, window.address, align))
            return nil
        end,
        function(): string?
            partialStore(ctx, shape, value, window.room, nil)

            return nil
        end
    )
end

local function fieldStore(ctx: context.Context, node: scalarIR.Statement): nil
    local simd = node as scalarIR.Simd
    local found = lanes.of(ctx, tostring(simd.args[3].type))
    local first = memory.first(ctx, simd.args[2])
    local value = operand(ctx, simd.args[3])
    local active = simd.args[4] ~= nil and operand(ctx, simd.args[4] as scalarIR.Expr) or nil
    local pointers, enable = fieldPointers(ctx, found, simd, first, active)
    scatter(ctx, found, value, pointers, enable)
end

memory.EXPRESSIONS = {
    ["simd_load"] = load,
    ["simd_field_load"] = fieldLoad,
} as {[string]: function(ctx: context.Context, node: scalarIR.Expr): (string, string)}

memory.STATEMENTS = {
    ["simd_store"] = store,
    ["simd_field_store"] = fieldStore,
} as {[string]: function(ctx: context.Context, node: scalarIR.Statement): nil}

export = memory
