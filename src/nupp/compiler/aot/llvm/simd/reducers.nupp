module nupp.compiler.aot.llvm.simd.reducers

--[[
`nupp.simd.reducer` states: creating one, contributing to it, and reading it.

A contribution means what its contract says, one value at a time in source
order; a masked vector contribution is its active lanes in ascending order.
Inside a reducer region, a contract whose operation is associative in its
order (`exact` integers; `algebraic`, which permits reassociation) may instead
keep a lane-wise vector accumulator and fold it into the state once the region
ends, the scheme the C lowering used, except in the scalar oracle, which folds
lane by lane.
]]

local builder = require("nupp.compiler.aot.llvm.builder")
local context = require("nupp.compiler.aot.llvm.context")
local expressions = require("nupp.compiler.aot.llvm.expressions")
local lanes = require("nupp.compiler.aot.llvm.simd.lanes")
local reducerRules = require("nupp.compiler.aot.reducers")
local scalarIR = require("nupp.compiler.aot.scalar")
local species = require("nupp.compiler.aot.llvm.simd.species")
local states = require("nupp.compiler.aot.llvm.simd.states")
local statements = require("nupp.compiler.aot.llvm.statements")

local reducers = {}

local function e(ctx: context.Context, instruction: string): string
    return lanes.emit(ctx, instruction)
end

--- The IR type a contract's contributions are passed as.
local function inputType(order: string, element: string?): string
    if states.bare(order) or order == "pairwise" or order == "compensated" then
        return "f64"
    end

    return tostring(element)
end

--- The stack slot of reducer local `node`.
--- @raises string when the reducer was never bound
local function slotOf(ctx: context.Context, node: scalarIR.Expr): context.Slot
    local named = node as scalarIR.Name
    local slot = ctx.locals[tostring(named.cName)]
    if slot == nil then
        error("no reducer " .. tostring(named.cName), 0)
    end

    return slot as context.Slot
end

--- One scalar contribution `value` (of IR type `valueType`) to the state in
--- `slot`.
local function contribute(
    ctx: context.Context,
    slot: context.Slot,
    order: string,
    operation: string,
    element: string?,
    value: string,
    valueType: string
): nil
    local input = inputType(order, element)
    local converted = expressions.convert(ctx, value, valueType, input)
    local operations = states.operations(ctx.module, order, operation, element)
    if operations == nil then
        local current = e(ctx, ("load double, ptr %s"):format(slot.pointer))
        local flags = ctx.contract and " contract" or ""
        local instruction = operation == "product" and "fmul" or "fadd"
        local next = e(ctx, ("%s%s double %s, %s"):format(instruction, flags, current, converted))
        builder.emit(ctx.f, ("store double %s, ptr %s"):format(next, slot.pointer))
        return
    end
    local ops = operations as states.Operations
    builder.emit(ctx.f, ("call void %s(ptr %s, %s %s)"):format(ops.add, slot.pointer, ops.input, converted))
end

--- `let r = reducer.<contract>(initial)`: the state initialized in place.
local function init(ctx: context.Context, slot: context.Slot, node: scalarIR.Expr): nil
    local created = node as scalarIR.ReducerInit
    local _, _, element = reducerRules.parse(tostring(created.type))
    local value, t = expressions.value(ctx, created.initial)
    local input = inputType(created.order, element)
    local converted = expressions.convert(ctx, value, t, input)
    local operations = states.operations(ctx.module, created.order, created.operation, element)
    if operations == nil then
        builder.emit(ctx.f, ("store double %s, ptr %s"):format(converted, slot.pointer))
        return
    end
    local ops = operations as states.Operations
    builder.emit(ctx.f, ("call void %s(ptr %s, %s %s)"):format(ops.init, slot.pointer, ops.input, converted))
end

--- `r:add(x)`, or `r:add(a, b)` for a dot: the product rounded first.
local function add(ctx: context.Context, node: scalarIR.Statement): nil
    local contribution = node as scalarIR.ReducerAdd
    local slot = slotOf(ctx, contribution.reducer)
    local value, t = expressions.value(ctx, contribution.value)
    if contribution.right ~= nil then
        local right, rightType = expressions.value(ctx, contribution.right as scalarIR.Expr)
        local a = expressions.convert(ctx, value, t, "f64")
        local b = expressions.convert(ctx, right, rightType, "f64")
        local flags = ctx.contract and " contract" or ""
        value = e(ctx, ("fmul%s double %s, %s"):format(flags, a, b))
        t = "f64"
    end
    local _, _, element = reducerRules.parse(slot.type)
    contribute(ctx, slot, contribution.order, contribution.operation, element, value, t)
end

--- A masked vector contribution: into the region's accumulator when it has
--- one, otherwise each active lane in order.
local function vectorAdd(ctx: context.Context, node: scalarIR.Statement): nil
    local contribution = node as scalarIR.VectorReducerAdd
    local named = contribution.reducer as scalarIR.Name
    local slot = slotOf(ctx, contribution.reducer)
    local found = lanes.of(ctx, tostring(contribution.value.type))
    local value = expressions.value(ctx, contribution.value)
    local right: string? = nil
    if contribution.right ~= nil then
        right = expressions.value(ctx, contribution.right as scalarIR.Expr)
    end
    local mask = expressions.value(ctx, contribution.mask)
    local accumulator = ctx.accumulators[named.name]
    if accumulator ~= nil then
        local acc = accumulator as context.Accumulator
        local combined = value
        if right ~= nil then
            local flags = ctx.contract and " contract" or ""
            combined = e(ctx, ("fmul%s %s %s, %s"):format(flags, found.vector, value, right as string))
        end
        local accType = acc.vector
        if accType ~= found.vector then
            -- An exact accumulator is as wide as the reducer's element.
            combined = e(
                ctx,
                ("%s %s %s to %s"):format(found.signed and "sext" or "zext", found.vector, combined, accType)
            )
        end
        local current = e(ctx, ("load %s, ptr %s"):format(accType, acc.pointer))
        local instruction: string
        if contribution.order == "exact" then
            instruction = ({
                sum = "add",
                product = "mul",
                ["and"] = "and",
                ["or"] = "or",
                xor = "xor"
            })[contribution.operation] as string
        else
            local flags = ctx.contract and " contract" or ""
            instruction = (contribution.operation == "product" and "fmul" or "fadd") .. flags
        end
        local next = e(ctx, ("%s %s %s, %s"):format(instruction, accType, current, combined))
        local kept = e(ctx, ("select %s %s, %s %s, %s %s"):format(found.mask, mask, accType, next, accType, current))
        builder.emit(ctx.f, ("store %s %s, ptr %s"):format(accType, kept, acc.pointer))
        return
    end
    local f = ctx.f
    local element = contribution.element
    for index = 0, found.lanes - 1 do
        local active = e(ctx, ("extractelement %s %s, i32 %d"):format(found.mask, mask, index))
        local takeLabel = builder.label(f, "reduce.lane")
        local nextLabel = builder.label(f, "reduce.next")
        builder.terminate(f, ("br i1 %s, label %%%s, label %%%s"):format(active, takeLabel, nextLabel))
        builder.start(f, takeLabel)
        local laneValue: string
        local laneType: string
        if element == "bool" then
            -- A predicate's lanes are the mask's own truths.
            laneValue = e(ctx, ("extractelement %s %s, i32 %d"):format(found.mask, value, index))
            laneType = "bool"
        else
            local raw = lanes.extract(ctx, found, value, index)
            if right ~= nil then
                local other = lanes.extract(ctx, found, right as string, index)
                local flags = ctx.contract and " contract" or ""
                raw = e(ctx, ("fmul%s %s %s, %s"):format(flags, found.scalar, raw, other))
            end
            laneValue, laneType = lanes.fromLane(ctx, found, raw)
        end
        contribute(ctx, slot, contribution.order, contribution.operation, element, laneValue, laneType)
        builder.start(f, nextLabel)
    end
end

--- Whether a `Fixed<N>` species was an aggregate of registers in the C
--- lowering, which accumulated lane by lane there; kept so the two backends
--- choose the same association while both exist.
local function composite(ctx: context.Context, found: species.Species): boolean
    local width = context.width(ctx)
    local native = math.floor(width * 8 / found.bits)

    return found.shape ~= "preferred"
        and found.lanes ~= native
        and not (
            found.float and found.lanes * found.bits == 256 and width >= 32 and (ctx.program.vectorCeiling or 0) == 0
        )
end

local function region(ctx: context.Context, node: scalarIR.Statement): nil
    local block = node as scalarIR.ReducerRegion
    local saved = ctx.accumulators
    local accumulators: {[string]: context.Accumulator} = {}
    local parallel: {scalarIR.ReducerRegionAccumulator} = {}
    if not ctx.oracle then
        for _, reducer in ipairs(block.reducers) do
            local found = lanes.of(ctx, tostring(reducer.vectorType))
            if reducerRules.parallel(reducer.order) and not composite(ctx, found) and reducer.element ~= "bool" then
                local vector = found.vector
                local identity: string
                if reducer.order == "exact" then
                    local wide = reducer.element == "i64" or reducer.element == "u64"
                    vector = "<" .. tostring(found.lanes) .. " x " .. (wide and "i64" or "i32") .. ">"
                    identity = ({
                        sum = "0",
                        product = "1",
                        ["and"] = "-1",
                        ["or"] = "0",
                        xor = "0"
                    })[reducer.operation] as string
                else
                    -- -0 keeps both zero signs under addition.
                    identity = reducer.operation == "product" and "1.0" or "-0.0"
                end
                local scalar = vector:match("x ([%w]+)>$") as string
                local pointer = builder.alloca(ctx.f, vector, 16)
                builder.emit(ctx.f, ("store %s %s, ptr %s"):format(vector, lanes.splatOf(scalar, identity), pointer))
                accumulators[reducer.name] = new context.Accumulator(pointer = pointer, vector = vector)
                parallel[#parallel + 1] = reducer
            end
        end
    end
    ctx.accumulators = accumulators
    statements.block(ctx, block.body)
    ctx.accumulators = saved
    for _, reducer in ipairs(parallel) do
        local acc = accumulators[reducer.name] as context.Accumulator
        local slot = ctx.locals[reducer.cName] as context.Slot
        local vector = acc.vector
        local final = e(ctx, ("load %s, ptr %s"):format(vector, acc.pointer))
        local count = tonumber(vector:match("^<(%d+) x")) as integer
        local scalar = vector:match("x ([%w]+)>$") as string
        for index = 0, count - 1 do
            local lane = e(ctx, ("extractelement %s %s, i32 %d"):format(vector, final, index))
            if reducer.order == "exact" then
                local laneType = scalar == "i64" and (tostring(reducer.element) == "u64" and "u64" or "i64")
                    or (tostring(reducer.element) == "u32" and "u32" or "i32")
                contribute(ctx, slot, reducer.order, reducer.operation, reducer.element, lane, laneType)
            else
                local wide = scalar == "double" and lane or e(ctx, ("fpext %s %s to double"):format(scalar, lane))
                contribute(ctx, slot, reducer.order, reducer.operation, reducer.element, wide, "f64")
            end
        end
    end
end

--- `r:value()`.
local function value(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local read = node as scalarIR.ReducerValue
    local slot = slotOf(ctx, read.reducer)
    local _, _, element = reducerRules.parse(slot.type)
    local operations = states.operations(ctx.module, read.order, read.operation, element)
    if operations == nil then
        return e(ctx, ("load double, ptr %s"):format(slot.pointer)), "f64"
    end
    local ops = operations as states.Operations

    return e(ctx, ("call %s %s(ptr %s)"):format(ops.result, ops.value, slot.pointer)), tostring(read.type)
end

reducers.EXPRESSIONS = {
    ["reducer_value"] = value,
} as {[string]: function(ctx: context.Context, node: scalarIR.Expr): (string, string)}

reducers.STATEMENTS = {
    ["reducer_add"] = add,
    ["simd_reducer_add"] = vectorAdd,
    ["reducer_region"] = region,
} as {[string]: function(ctx: context.Context, node: scalarIR.Statement): nil}

reducers.BINDERS = {
    ["reducer_init"] = init,
} as {[string]: function(ctx: context.Context, slot: context.Slot, value: scalarIR.Expr): nil}

export = reducers
