--[[
What every SIMD lowering shares: constants, splats, moving a scalar into a lane
and back, and the NaN-canonical extreme every min and max contract is.

A narrow integer lane is carried outside its vector as the 32-bit integer of
its signedness, so a lane leaving a vector is sign- or zero-extended and a
scalar entering one is truncated. Floats keep their type.
]]
module nupp.compiler.aot.llvm.simd.lanes

local context = require("nupp.compiler.aot.llvm.context")
local expressions = require("nupp.compiler.aot.llvm.expressions")
local prelude = require("nupp.compiler.aot.llvm.prelude")
local species = require("nupp.compiler.aot.llvm.simd.species")

--- The canonical quiet NaN of each float element, as LLVM spells it.
export const NAN = "0x7FF8000000000000"

--- The species an IR type names.
--- @raises string when it names none
export function of(ctx: context.Context, typeName: string): species.Species
    return species.require(context.width(ctx), typeName)
end

--- The LLVM intrinsic suffix of a vector of `count` lanes of `scalar`:
--- `v4f32`, `v16i8`, `v8i1`.
export function suffix(count: integer, scalar: string): string
    local short = scalar == "double" and "f64" or scalar == "float" and "f32" or scalar

    return "v" .. tostring(count) .. short
end

--- The integer type of a float element's bits (`i32` for `float`).
export function bitsType(found: species.Species): string
    return "i" .. tostring(found.bits)
end

--- `<N x T> splat (T value)`.
export function splatConstant(vector: string, scalar: string, value: string): string
    return vector .. " splat (" .. scalar .. " " .. value .. ")"
end

--- `splat (T value)`, a constant vector operand whose type is written
--- beside it.
export function splatOf(scalar: string, value: string): string
    return "splat (" .. scalar .. " " .. value .. ")"
end

--- The constant vector `<0, 1, ..., N-1>` of element type `scalar`, as a
--- typed operand.
export function indices(count: integer, scalar: string): string
    local parts: {string} = {}
    local float = scalar == "float" or scalar == "double"
    for index = 0, count - 1 do
        parts[#parts + 1] = scalar .. " " .. (float and tostring(index) .. ".0" or tostring(index))
    end

    return "<" .. tostring(count) .. " x " .. scalar .. "> <" .. table.concat(parts, ", ") .. ">"
end

--- A vector of `count` lanes all `value`, built from a runtime scalar.
export function splat(ctx: context.Context, count: integer, scalar: string, value: string): string
    local vector = "<" .. tostring(count) .. " x " .. scalar .. ">"
    local one = context.value(ctx, ("insertelement %s poison, %s %s, i64 0"):format(vector, scalar, value))

    return context.value(
        ctx,
        ("shufflevector %s %s, %s poison, <%d x i32> zeroinitializer"):format(vector, one, vector, count)
    )
end

--- A scalar of IR type `valueType` as a lane of `found`: floats converted
--- to the element, integers to the carrier and then truncated to the lane.
export function toLane(ctx: context.Context, found: species.Species, value: string, valueType: string): string
    if found.float then
        return expressions.convert(ctx, value, valueType, found.element)
    end
    local carrier = species.laneType(found)
    local carried = expressions.convert(ctx, value, valueType, carrier)
    if found.bits < 32 then
        return context.value(ctx, ("trunc i32 %s to %s"):format(carried, found.scalar))
    end

    return carried
end

--- A lane value leaving the vector, as the IR scalar it is carried as.
export function fromLane(ctx: context.Context, found: species.Species, value: string): (string, string)
    local carrier = species.laneType(found)
    if not found.float and found.bits < 32 then
        local extend = found.signed and "sext" or "zext"
        return context.value(ctx, ("%s %s %s to i32"):format(extend, found.scalar, value)), carrier
    end

    return value, carrier
end

--- Lane `index` (zero-based) of `vector`.
export function extract(ctx: context.Context, found: species.Species, vector: string, index: integer | string): string
    return context.value(ctx, ("extractelement %s %s, i32 %s"):format(found.vector, vector, tostring(index)))
end

--- `vector` with lane `index` replaced by `value`.
export function insert(
    ctx: context.Context,
    found: species.Species,
    vector: string,
    value: string,
    index: integer | string
): string
    return context.value(
        ctx,
        ("insertelement %s %s, %s %s, i32 %s"):format(found.vector, vector, found.scalar, value, tostring(index))
    )
end

--- The types a lane-wise operation works in: the value type `t` (a
--- scalar or a vector), its comparison result, the integer of its bits, and
--- the intrinsic suffix (`f32`, `v4f32`).
export record Shape
    t: string
    i1: string
    ints: string
    suffix: string

    --- The element: `float`, `i8`, ...
    scalar: string

    --- The integer the element's bits are: `i32` for `float`.
    bits: string
end

--- The shape of a whole vector of `found`.
export function vectorShape(found: species.Species): Shape
    local count = tostring(found.lanes)

    return Shape(
        t = found.vector,
        i1 = found.mask,
        ints = "<" .. count .. " x " .. bitsType(found) .. ">",
        suffix = suffix(found.lanes, found.scalar),
        scalar = found.scalar,
        bits = bitsType(found)
    )
end

--- The shape of a lane of `found`.
export function scalarShape(found: species.Species): Shape
    local short = found.scalar == "double" and "f64" or found.scalar == "float" and "f32" or found.scalar

    return Shape(
        t = found.scalar,
        i1 = "i1",
        ints = bitsType(found),
        suffix = short,
        scalar = found.scalar,
        bits = bitsType(found)
    )
end

--- A constant of the shape: a splat for a vector, the value for a scalar.
export function constant(shape: Shape, scalar: string, value: string): string
    if shape.t:sub(1, 1) == "<" then
        return "splat (" .. scalar .. " " .. value .. ")"
    end

    return value
end

--- Two float operands of `shape` under the Nupp extreme contract: a NaN operand
--- returns the canonical NaN (`propagating`) or the other operand (`number`,
--- the canonical NaN only when both are), -0 is less than +0, and otherwise the
--- plain comparison.
export function floatExtreme(
    ctx: context.Context,
    shape: Shape,
    left: string,
    right: string,
    minimum: boolean,
    propagating: boolean
): string
    local t, i1 = shape.t, shape.i1
    local nan = constant(shape, shape.scalar, NAN)

    local unordered = context.value(ctx, ("fcmp uno %s %s, %s"):format(t, left, right))
    local equal = context.value(ctx, ("fcmp oeq %s %s, %s"):format(t, left, right))
    local leftBits = context.value(ctx, ("bitcast %s %s to %s"):format(t, left, shape.ints))
    local negative = context.value(
        ctx,
        ("icmp slt %s %s, %s"):format(shape.ints, leftBits, constant(shape, shape.bits, "0"))
    )
    -- Equal operands differ only when they are zeros of opposite sign.
    local tie = minimum and context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, negative, t, left, t, right))
        or context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, negative, t, right, t, left))
    local strict = context.value(ctx, ("fcmp %s %s %s, %s"):format(minimum and "olt" or "ogt", t, left, right))
    local picked = context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, strict, t, left, t, right))
    local ordered = context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, equal, t, tie, t, picked))
    local result = context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, unordered, t, nan, t, ordered))
    if propagating then
        return result
    end
    local leftNan = context.value(ctx, ("fcmp uno %s %s, %s"):format(t, left, left))
    local rightNan = context.value(ctx, ("fcmp uno %s %s, %s"):format(t, right, right))
    local whenLeftNan = context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, rightNan, t, nan, t, right))
    local whenRightNan = context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, rightNan, t, left, t, result))

    return context.value(ctx, ("select %s %s, %s %s, %s %s"):format(i1, leftNan, t, whenLeftNan, t, whenRightNan))
end

--- An integer extreme of `shape` by signedness.
export function integerExtreme(
    ctx: context.Context,
    shape: Shape,
    left: string,
    right: string,
    minimum: boolean,
    signed: boolean
): string
    local name = "llvm." .. (signed and "s" or "u") .. (minimum and "min" or "max") .. "." .. shape.suffix
    local t = shape.t
    local callee = prelude.intrinsic(ctx.module, name, ("%s @NAME(%s, %s)"):format(t, t, t))

    return context.value(ctx, ("call %s %s(%s %s, %s %s)"):format(t, callee, t, left, t, right))
end
