module nupp.compiler.aot.llvm.simd.reduce

--[[
Folding a vector's lanes: mask queries, prefix scans and horizontal reductions.

A horizontal reduction names its association, and the answer depends on it,
so each order is the exact tree its contract states over the lanes in logical
order: `ordered` left to right from the identity, `pairwise` the balanced tree
carrying an odd lane up unchanged, `algebraic` even and odd lanes apart then
joined, its dot fused. None of them is `reassoc`, which would let LLVM pick
the tree. Extremes answer the same whatever the order; their `arg` forms keep
the lowest lane among equals under the zero-sign and NaN rules.
]]

local context = require("nupp.compiler.aot.llvm.context")
local expressions = require("nupp.compiler.aot.llvm.expressions")
local lanes = require("nupp.compiler.aot.llvm.simd.lanes")
local prelude = require("nupp.compiler.aot.llvm.prelude")
local scalarIR = require("nupp.compiler.aot.scalar")
local species = require("nupp.compiler.aot.llvm.simd.species")

local reduce = {}

--- @raises string always
local function unsupported(what: string): never
    error(expressions.UNSUPPORTED .. what, 0)
end

local registerTest: function(
    ctx: context.Context,
    widened: string,
    count: integer,
    element: string,
    total: integer,
    any: boolean
): string

local function e(ctx: context.Context, instruction: string): string
    return lanes.emit(ctx, instruction)
end

local function operand(ctx: context.Context, node: scalarIR.Expr): string
    local value = expressions.value(ctx, node)

    return value
end

--- The mask as an integer of N bits, lane i at bit i, zero-extended to i64.
function reduce.bits(ctx: context.Context, found: species.Species, mask: string): string
    local packed = e(ctx, ("bitcast %s %s to i%d"):format(found.mask, mask, found.lanes))
    if found.lanes == 64 then
        return packed
    end

    return e(ctx, ("zext i%d %s to i64"):format(found.lanes, packed))
end

--- Whether any (or every) lane of a lane-wide mask is set, asked the way
--- the target asks it: the 128-bit registers OR-ed (AND-ed) together, then
--- NEON's `umaxv`/`uminv` or x86's `pmovmskb`. The target-neutral
--- reductions are canonicalized back into an i1 reduction that NEON narrows.
registerTest = function(
    ctx: context.Context,
    widened: string,
    count: integer,
    element: string,
    total: integer,
    any: boolean
): string
    local vector = "<" .. tostring(count) .. " x " .. element .. ">"
    local registers = math.floor(total / 128) as integer
    local x86 = ctx.vectorRegister == "x"
    local piece = x86 and "<16 x i8>" or "<4 x i32>"
    local pieces = x86 and 16 or 4
    local whole = "<" .. tostring(registers * pieces) .. " x " .. (x86 and "i8" or "i32") .. ">"
    local cast = e(ctx, ("bitcast %s %s to %s"):format(vector, widened, whole))
    local combined: string? = nil
    for register = 0, registers - 1 do
        local picks: {string} = {}
        for lane = 0, pieces - 1 do
            picks[#picks + 1] = "i32 " .. tostring(register * pieces + lane)
        end
        local one = e(
            ctx,
            (
                "shufflevector %s %s, %s poison, <%d x i32> <%s>"
            ):format(whole, cast, whole, pieces, table.concat(picks, ", "))
        )
        combined = combined == nil and one
            or e(ctx, ("%s %s %s, %s"):format(any and "or" or "and", piece, combined as string, one))
    end
    if x86 then
        local movemask = prelude.intrinsic(ctx.module, "llvm.x86.sse2.pmovmskb.128", "i32 @NAME(<16 x i8>)")
        local bits = e(ctx, ("call i32 %s(<16 x i8> %s)"):format(movemask, tostring(combined)))
        return e(ctx, ("icmp %s i32 %s, %s"):format(any and "ne" or "eq", bits, any and "0" or "65535"))
    end
    -- A pairwise max (min) folds the register into its low 64 bits, which
    -- are then tested whole: shorter than `umaxv`, as the C lowering found.
    local name = any and "llvm.aarch64.neon.umaxp.v4i32" or "llvm.aarch64.neon.uminp.v4i32"
    local pairwise = prelude.intrinsic(ctx.module, name, "<4 x i32> @NAME(<4 x i32>, <4 x i32>)")
    local folded = e(
        ctx,
        ("call <4 x i32> %s(<4 x i32> %s, <4 x i32> %s)"):format(pairwise, tostring(combined), tostring(combined))
    )
    local halves = e(ctx, ("bitcast <4 x i32> %s to <2 x i64>"):format(folded))
    local low = e(ctx, ("extractelement <2 x i64> %s, i32 0"):format(halves))

    return e(ctx, ("icmp %s i64 %s, %s"):format(any and "ne" or "eq", low, any and "0" or "-1"))
end

const SWAPPED = {["ge"] = "le", ["le"] = "ge", ["gt"] = "lt", ["lt"] = "gt", ["ne"] = "ne", ["eq"] = "eq",}

--- `(x OP splat(s)):any()` over one NEON register of integers, answered
--- without forming the mask: whether any lane is at least `s` is whether the
--- largest is (`umaxv`/`smaxv`), and whether any is nonzero is whether the
--- largest is. The C lowering's `anyCompare`. Nil for any other shape.
local function anyCompare(ctx: context.Context, mask: scalarIR.Expr): string?
    if ctx.vectorRegister ~= "w" or mask.op ~= "simd_compare" then
        return nil
    end
    local compare = mask as scalarIR.Simd
    local found = context.species(ctx, tostring(compare.args[1].type))
    if found == nil
        or (found as species.Species).float
        or (found as species.Species).lanes * (found as species.Species).bits ~= 128
    then
        return nil
    end
    local lanesOf = found as species.Species
    local named = tostring(compare.intrinsic)
    local value, bound = compare.args[1], compare.args[2]
    if value.op == "simd_splat" and bound.op ~= "simd_splat" then
        value, bound = bound, value
        named = SWAPPED[named] as string
    end
    if bound.op ~= "simd_splat" or named == "eq" then
        return nil
    end
    local vector = operand(ctx, value)
    local scalar, scalarType = expressions.value(ctx, (bound as scalarIR.Simd).args[1])
    local lane = lanes.toLane(ctx, lanesOf, scalar, scalarType)
    local wideLane = lanesOf.bits < 32
        and e(ctx, ("%s %s %s to i32"):format(lanesOf.signed and "sext" or "zext", lanesOf.scalar, lane))
        or lane
    local suffix = lanes.suffix(lanesOf.lanes, lanesOf.scalar)

    local function reduced(kind: string): string
        local name = ("llvm.aarch64.neon.%s%sv.i32.%s"):format(lanesOf.signed and "s" or "u", kind, suffix)
        local callee = prelude.intrinsic(ctx.module, name, ("i32 @NAME(%s)"):format(lanesOf.vector))
        local result = e(ctx, ("call i32 %s(%s %s)"):format(callee, lanesOf.vector, vector))
        if lanesOf.bits == 32 then
            return result
        end
        -- Only the lane's own bits are the answer; extend them as the lane.
        local narrow = e(ctx, ("trunc i32 %s to %s"):format(result, lanesOf.scalar))

        return e(ctx, ("%s %s %s to i32"):format(lanesOf.signed and "sext" or "zext", lanesOf.scalar, narrow))
    end

    if lanesOf.bits > 32 then
        return nil
    end
    if named == "ne" then
        -- Any lane differs from `s`: the largest or the smallest does.
        local largest, smallest = reduced("max"), reduced("min")
        local high = e(ctx, ("icmp ne i32 %s, %s"):format(largest, wideLane))
        local low = e(ctx, ("icmp ne i32 %s, %s"):format(smallest, wideLane))
        return e(ctx, ("or i1 %s, %s"):format(high, low))
    end
    local greater = named == "ge" or named == "gt"
    local extreme = reduced(greater and "max" or "min")
    local predicate = (lanesOf.signed and "s" or "u") .. named

    return e(ctx, ("icmp %s i32 %s, %s"):format(predicate, extreme, wideLane))
end

local function maskQuery(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local simd = node as scalarIR.Simd
    local found = lanes.of(ctx, tostring(simd.args[1].type))
    local query = tostring(simd.op)
    if query == "simd_mask_any" then
        local shortcut = anyCompare(ctx, simd.args[1])
        if shortcut ~= nil then
            return shortcut as string, "bool"
        end
    end
    local wide = "<" .. tostring(found.lanes) .. " x i" .. tostring(found.bits) .. ">"
    local laneWide = (query == "simd_mask_any" or query == "simd_mask_all") and ctx.tier ~= "avx512f"
    -- A mask local a loop carries is already lane-wide in its slot: read that
    -- register itself rather than compare it back to i1 and widen it again.
    local carried: string? = nil
    if laneWide and simd.args[1].op == "local" then
        local slot = ctx.locals[tostring((simd.args[1] as scalarIR.Name).cName)]
        if slot ~= nil and (slot as context.Slot).carried then
            carried = e(ctx, ("load %s, ptr %s"):format(wide, (slot as context.Slot).pointer))
        end
    end
    local mask = carried == nil and operand(ctx, simd.args[1]) or ""
    local suffix = lanes.suffix(found.lanes, "i1")
    if laneWide then
        -- Reduced as lanes as wide as the mask's, the register a vector
        -- compare fills; reducing `<N x i1>` narrows it first on NEON.
        -- Opaque, or LLVM folds the widening back into an i1 reduction.
        local widened = carried
            or context.opaque(ctx, e(ctx, ("sext %s %s to %s"):format(found.mask, mask, wide)), wide)
        local any = query == "simd_mask_any"
        local total = found.lanes * found.bits
        local element = "i" .. tostring(found.bits)
        local reduced = widened
        local verb = any and "or" or "and"
        if total % 128 == 0 and ctx.vectorRegister ~= "" then
            return registerTest(ctx, widened, found.lanes, element, total, any), "bool"
        end
        local callee = prelude.intrinsic(
            ctx.module,
            "llvm.vector.reduce." .. verb .. "." .. lanes.suffix(found.lanes, element),
            ("%s @NAME(%s)"):format(element, wide)
        )
        local folded = e(ctx, ("call %s %s(%s %s)"):format(element, callee, wide, reduced))
        return e(ctx, ("icmp %s %s %s, %s"):format(any and "ne" or "eq", element, folded, any and "0" or "-1")), "bool"
    end
    if query == "simd_mask_any" or query == "simd_mask_all" then
        local verb = query == "simd_mask_any" and "or" or "and"
        local callee = prelude.intrinsic(
            ctx.module,
            "llvm.vector.reduce." .. verb .. "." .. suffix,
            ("i1 @NAME(%s)"):format(found.mask)
        )
        return e(ctx, ("call i1 %s(%s %s)"):format(callee, found.mask, mask)), "bool"
    end
    local bits = reduce.bits(ctx, found, mask)
    if query == "simd_mask_bits" then
        return bits, "u64"
    elseif query == "simd_mask_count" then
        local ctpop = prelude.intrinsic(ctx.module, "llvm.ctpop.i64", "i64 @NAME(i64)")
        local count = e(ctx, ("call i64 %s(i64 %s)"):format(ctpop, bits))
        return e(ctx, ("trunc i64 %s to i32"):format(count)), "u32"
    end
    -- `first`: the 1-based lowest active lane, 0 when none is.
    local cttz = prelude.intrinsic(ctx.module, "llvm.cttz.i64", "i64 @NAME(i64, i1)")
    local zeros = e(ctx, ("call i64 %s(i64 %s, i1 false)"):format(cttz, bits))
    local lane = e(ctx, ("add i64 %s, 1"):format(zeros))
    local none = e(ctx, ("icmp eq i64 %s, 0"):format(bits))
    local picked = e(ctx, ("select i1 %s, i64 0, i64 %s"):format(none, lane))

    return e(ctx, ("trunc i64 %s to i32"):format(picked)), "u32"
end

--- Every lane of `vector` as a scalar, in order.
local function unpack(ctx: context.Context, found: species.Species, vector: string): {string}
    local values: {string} = {}
    for index = 0, found.lanes - 1 do
        values[#values + 1] = lanes.extract(ctx, found, vector, index)
    end

    return values
end

--- The inclusive scan in lane order.
local function prefix(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local simd = node as scalarIR.Simd
    local typeName = tostring(simd.type)
    local found = lanes.of(ctx, typeName)
    local vector = operand(ctx, simd.args[1])
    local instruction = simd.intrinsic == "prefix_xor" and "xor" or found.float and "fadd" or "add"
    if not found.float then
        -- Integer sums wrap and xor is exact, so any association answers the
        -- same: log2(N) steps, each adding the vector shifted up by `d` lanes.
        local running = vector
        local distance = 1
        while distance < found.lanes do
            local picks: {string} = {}
            for lane = 0, found.lanes - 1 do
                -- Lanes below `d` take 0 (lane 0 of the zero vector); the rest
                -- take lane `lane - d` of the running vector.
                picks[#picks + 1] = "i32 " .. tostring(lane < distance and 0 or found.lanes + lane - distance)
            end
            local shifted = e(
                ctx,
                (
                    "shufflevector %s zeroinitializer, %s %s, <%d x i32> <%s>"
                ):format(found.vector, found.vector, running, found.lanes, table.concat(picks, ", "))
            )
            running = e(ctx, ("%s %s %s, %s"):format(instruction, found.vector, running, shifted))
            distance = distance * 2
        end
        return running, typeName
    end
    local values = unpack(ctx, found, vector)
    local out = lanes.insert(ctx, found, "poison", values[1], 0)
    local running = values[1]
    for index = 2, #values do
        running = e(ctx, ("%s %s %s, %s"):format(instruction, found.scalar, running, values[index]))
        out = lanes.insert(ctx, found, out, running, index - 1)
    end

    return out, typeName
end

--- `op` over two lane scalars.
local function combine(ctx: context.Context, found: species.Species, operation: string, a: string, b: string): string
    local instruction = operation == "product" and (found.float and "fmul" or "mul")
        or (found.float and "fadd" or "add")

    return e(ctx, ("%s %s %s, %s"):format(instruction, found.scalar, a, b))
end

--- The balanced pairwise tree: neighbours joined level by level, an odd
--- last value carried up unchanged.
local function pairwise(ctx: context.Context, found: species.Species, operation: string, values: {string}): string
    local level = values
    while #level > 1 do
        local next: {string} = {}
        local index: integer = 1
        while index + 1 <= #level do
            next[#next + 1] = combine(ctx, found, operation, level[index], level[index + 1])
            index = index + 2
        end
        if index <= #level then
            next[#next + 1] = level[index]
        end
        level = next
    end

    return level[1]
end

--- The lane-wise products of two vectors, each rounded.
local function products(ctx: context.Context, found: species.Species, a: {string}, b: {string}): {string}
    local out: {string} = {}
    for index = 1, #a do
        out[index] = combine(ctx, found, "product", a[index], b[index])
    end

    return out
end

--- The fused `a * b + c` of one lane.
local function fused(ctx: context.Context, found: species.Species, a: string, b: string, c: string): string
    local t = found.scalar
    local fma = prelude.intrinsic(
        ctx.module,
        "llvm.fma." .. (t == "double" and "f64" or "f32"),
        ("%s @NAME(%s, %s, %s)"):format(t, t, t, t)
    )

    return e(ctx, ("call %s %s(%s %s, %s %s, %s %s)"):format(t, fma, t, a, t, b, t, c))
end

--- Whether lane value `v` replaces `best` in an arg fold.
local function argBetter(
    ctx: context.Context,
    found: species.Species,
    v: string,
    best: string,
    minimum: boolean,
    propagating: boolean
): string
    local t = found.scalar
    if not found.float then
        local predicate = (found.signed and "s" or "u") .. (minimum and "lt" or "gt")
        return e(ctx, ("icmp %s %s %s, %s"):format(predicate, t, v, best))
    end
    local bitsType = lanes.bitsType(found)
    local vNan = e(ctx, ("fcmp uno %s %s, %s"):format(t, v, v))
    local bestNan = e(ctx, ("fcmp uno %s %s, %s"):format(t, best, best))
    local strict = e(ctx, ("fcmp %s %s %s, %s"):format(minimum and "olt" or "ogt", t, v, best))
    local equal = e(ctx, ("fcmp oeq %s %s, %s"):format(t, v, best))
    local vBits = e(ctx, ("bitcast %s %s to %s"):format(t, v, bitsType))
    local bestBits = e(ctx, ("bitcast %s %s to %s"):format(t, best, bitsType))
    local vSign = e(ctx, ("icmp slt %s %s, 0"):format(bitsType, vBits))
    local bestSign = e(ctx, ("icmp slt %s %s, 0"):format(bitsType, bestBits))
    -- On an equal pair of zeros, -0 wins a minimum and +0 a maximum.
    local winner = minimum and vSign or bestSign
    local loser = minimum and bestSign or vSign
    local loserClear = e(ctx, ("xor i1 %s, true"):format(loser))
    local signs = e(ctx, ("and i1 %s, %s"):format(winner, loserClear))
    local tie = e(ctx, ("and i1 %s, %s"):format(equal, signs))
    local ordered = e(ctx, ("or i1 %s, %s"):format(strict, tie))
    if propagating then
        local either = e(ctx, ("or i1 %s, %s"):format(vNan, ordered))
        local bestNumber = e(ctx, ("xor i1 %s, true"):format(bestNan))
        return e(ctx, ("and i1 %s, %s"):format(bestNumber, either))
    end
    local either = e(ctx, ("or i1 %s, %s"):format(bestNan, ordered))
    local vNumber = e(ctx, ("xor i1 %s, true"):format(vNan))

    return e(ctx, ("and i1 %s, %s"):format(vNumber, either))
end

local function horizontal(ctx: context.Context, node: scalarIR.Expr): (string, string)
    local simd = node as scalarIR.Simd
    local found = lanes.of(ctx, tostring(simd.args[1].type))
    local intrinsic = tostring(simd.intrinsic)
    local order, kind = intrinsic:match("^(%a+)_(.+)$")
    local values = unpack(ctx, found, operand(ctx, simd.args[1]))
    local t = found.scalar
    local zero = found.float and "0.0" or "0"
    local one = found.float and "1.0" or "1"

    if kind == "sum" or kind == "product" or kind == "dot" then
        local operation = kind == "product" and "product" or "sum"
        local identity = kind == "product" and one or zero
        local leaves = values
        if kind == "dot" then
            local right = unpack(ctx, found, operand(ctx, simd.args[2]))
            if order == "algebraic" then
                -- Even and odd lanes fused into their own partials.
                local even, odd = zero, zero
                local index: integer = 1
                while index + 1 <= #values do
                    even = fused(ctx, found, values[index], right[index], even)
                    odd = fused(ctx, found, values[index + 1], right[index + 1], odd)
                    index = index + 2
                end
                if index <= #values then
                    even = fused(ctx, found, values[index], right[index], even)
                end
                return lanes.fromLane(ctx, found, combine(ctx, found, "sum", even, odd))
            end
            leaves = products(ctx, found, values, right)
        end
        local result: string
        if order == "ordered" then
            result = identity
            for _, value in ipairs(leaves) do
                result = combine(ctx, found, operation, result, value)
            end
        elseif order == "pairwise" then
            result = pairwise(ctx, found, operation, leaves)
        elseif order == "algebraic" then
            local even, odd = identity, identity
            local index: integer = 1
            while index + 1 <= #leaves do
                even = combine(ctx, found, operation, even, leaves[index])
                odd = combine(ctx, found, operation, odd, leaves[index + 1])
                index = index + 2
            end
            if index <= #leaves then
                even = combine(ctx, found, operation, even, leaves[index])
            end
            result = combine(ctx, found, operation, even, odd)
        else
            unsupported("horizontal order " .. tostring(order))
        end
        return lanes.fromLane(ctx, found, result)
    end

    local propagating = order == "propagating"
    if kind == "min" or kind == "max" then
        local shape = lanes.scalarShape(found)
        local result = values[1]
        for index = 2, #values do
            result = found.float and lanes.floatExtreme(ctx, shape, result, values[index], kind == "min", propagating)
                or lanes.integerExtreme(ctx, shape, result, values[index], kind == "min", found.signed)
        end
        return lanes.fromLane(ctx, found, result)
    elseif kind == "arg_min" or kind == "arg_max" then
        local minimum = kind == "arg_min"
        local best = values[1]
        local at = "0"
        for index = 2, #values do
            local take = argBetter(ctx, found, values[index], best, minimum, propagating)
            best = e(ctx, ("select i1 %s, %s %s, %s %s"):format(take, t, values[index], t, best))
            at = e(ctx, ("select i1 %s, i32 %d, i32 %s"):format(take, index - 1, at))
        end
        local lane = e(ctx, ("add i32 %s, 1"):format(at))
        return e(ctx, ("uitofp i32 %s to double"):format(lane)), "f64"
    end

    unsupported("horizontal operation " .. intrinsic)
end

reduce.EXPRESSIONS = {
    ["simd_mask_any"] = maskQuery,
    ["simd_mask_all"] = maskQuery,
    ["simd_mask_count"] = maskQuery,
    ["simd_mask_first"] = maskQuery,
    ["simd_mask_bits"] = maskQuery,
    ["simd_prefix"] = prefix,
    ["simd_horizontal"] = horizontal,
} as {[string]: function(ctx: context.Context, node: scalarIR.Expr): (string, string)}

export = reduce
