module nupp.compiler.aot.optimize

--[[
Semantics-preserving scalar AOT optimisation.

The IR is structured and name based, so this pass stays structured and name
based. Every expression and statement is first admitted by the closed effect
vocabulary. Rewrites are intentionally local: constant folding under the
binary64 contract, dead pure declarations, statically selected branches,
derivation of proven break-result flags, small literal loop expansion, and
unreachable statement tails. A bounded repeat exposes declarations made dead
by an earlier removal without turning this into an open-ended fixpoint.

Expression rewriting is one fused walk -- root propagation, child descent,
fold saturation, then helper specialization -- scheduled here and answered by
`propagate`, `fold`, and `specialize`, which own no optimizer state. One walk
was chosen over sequential whole-tree phases so a replacement is finished the
moment it is made and the interleaving the rule catalog was written against
cannot drift; room for a future analysis is a new mode on the walk, not a
pass manager.
]]

local effects = require("nupp.compiler.aot.effects")
local fold = require("nupp.compiler.aot.fold")
local propagate = require("nupp.compiler.aot.propagate")
local scalarIR = require("nupp.compiler.aot.scalar")
local specialize = require("nupp.compiler.aot.specialize")
local visit = require("nupp.compiler.aot.visit")

local optimize = {}

record optimize.RuleApplication
    id: string
    count: integer
end

record optimize.Stats
    beforeNodes: integer
    afterNodes: integer
    folds: integer
    propagatedConstants: integer
    specializedHelperCalls: integer
    unrolledLoops: integer
    unrolledIterations: integer
    removedStatements: integer
    iterations: integer
    ruleApplications: {optimize.RuleApplication}
end

record optimize.State
    statementFolds: integer
    specializationBudget: integer
    unrollBudget: integer
    helpers: {[string]: scalarIR.Helper}
    foldContext: fold.Context
    specializeContext: specialize.Context
    ruleApplications: {[string]: integer}
    unrolledLoops: integer
    unrolledIterations: integer
    removedStatements: integer
    changed: boolean
end

--- Which stages of the fused walk one entrypoint runs.
record optimize.RewriteMode
    propagation: boolean
    specialization: boolean
end

local function countRule(state: optimize.State, id: string): nil
    state.ruleApplications[id] = (state.ruleApplications[id] or 0) + 1
end

--- Fixed-count expansion stays deliberately small. Four is the measured `mix`
--- shape and 96 additional IR nodes is enough for that body without allowing a
--- collection of literal loops to multiply one entry without bound.
const optimize.MAX_UNROLL_TRIPS = 4

const optimize.MAX_UNROLL_GROWTH = 96

local function containsLoopExit(value: any): boolean
    if type(value) ~= "table" then
        return false
    end
    if value.op == "break" or value.op == "continue" then
        return true
    end
    for key, child in pairs(value) do
        if key ~= "source" and containsLoopExit(child) then
            return true
        end
    end

    return false
end

--- Body expressions: substitute from the block environment, fold, specialize.
local BODY_REWRITE = new optimize.RewriteMode(propagation = true, specialization = true)

--- Every other entrypoint -- helper values, fold-created children, specialized
--- replacements, statement-path folding -- folds and specializes with no
--- constant environment.
local FOLD_REWRITE = new optimize.RewriteMode(propagation = false, specialization = true)

local rewriteExpression: function(
    scalarIR.Expr,
    propagate.Constants?,
    optimize.RewriteMode,
    optimize.State
): scalarIR.Expr

--- Rewrites one expression tree in a single fused walk.
---
--- The ordering is the contract: an optional root substitution, one descent
--- rewriting every child in the same mode, fold saturation at the root with
--- each replacement's children rewritten fold-only, then one specialization
--- attempt whose accepted body is reprocessed fold-only. A substituted local
--- returns immediately -- the environment admits only leaf literals, so there
--- is nothing beneath the replacement to rewrite and no rule matches a bare
--- literal root. The effect lookup is the whitelist in front of everything: a
--- new operation cannot reach a rewrite until its root behaviour has been
--- classified.
rewriteExpression = function(
    node: scalarIR.Expr,
    constants: propagate.Constants?,
    mode: optimize.RewriteMode,
    state: optimize.State
): scalarIR.Expr
    effects.expression(tostring(node.op))
    if mode.propagation and constants ~= nil then
        local substituted, ruleID = propagate.apply(node, constants as propagate.Constants)
        if substituted ~= nil then
            countRule(state, ruleID as string)
            state.changed = true
            return substituted as scalarIR.Expr
        end
    end
    visit.expressionChildren(node, function(child: scalarIR.Expr): scalarIR.Expr
        return rewriteExpression(child, constants, mode, state)
    end)

    local fuel = 16
    local history: {string} = {}
    local function refoldChild(child: scalarIR.Expr): scalarIR.Expr
        return rewriteExpression(child, nil, FOLD_REWRITE, state)
    end

    while true do
        local replacement, ruleID = fold.apply(node, state.foldContext)
        if replacement == nil then
            break
        end
        if fuel == 0 then
            error("AOT fold fuel exhausted after " .. table.concat(history, ", "), 0)
        end
        fuel = fuel - 1
        history[#history + 1] = ruleID as string
        countRule(state, ruleID as string)
        state.changed = true
        node = replacement as scalarIR.Expr
        effects.expression(tostring(node.op))
        visit.expressionChildren(node, refoldChild)
    end

    if mode.specialization and node.op == "helper_call" then
        local candidate = specialize.propose(node, state.specializeContext)
        if candidate ~= nil and (candidate as specialize.Candidate).growth <= state.specializationBudget then
            local accepted = candidate as specialize.Candidate
            state.specializationBudget = state.specializationBudget - math.max(accepted.growth, 0)
            countRule(state, accepted.ruleID)
            state.changed = true
            return rewriteExpression(accepted.replacement, nil, FOLD_REWRITE, state)
        end
    end

    return node
end

local function foldStatementExpressions(statement: scalarIR.Statement, state: optimize.State): nil
    effects.statement(tostring(statement.op))
    visit.statementExpressions(statement, function(child: scalarIR.Expr): scalarIR.Expr
        return rewriteExpression(child, nil, FOLD_REWRITE, state)
    end)
end

local optimizeBlock: function({scalarIR.Statement}, optimize.State): {scalarIR.Statement}

--- Whether evaluating a value again can observe anything new.
---
--- A loop condition was already evaluated with these operands before a break,
--- but deriving a result evaluates it once more after the loop. Native and Lua
--- reads are excluded even when they cannot raise: memory is not a value proof.
local function repeatable(value: scalarIR.Expr): boolean
    -- A call is only as repeatable as its helper body. This local proof does
    -- not carry the helper graph, so decline rather than treating the call's
    -- pure root classification as a proof about its implementation.
    if value.op == "helper_call" then
        return false
    end
    local root = effects.expression(tostring(value.op))
    if root.observable
        or root.mayRaise
        or root.readsNative
        or root.writesNative
        or root.usesLua
        or root.allocatesLua
    then
        return false
    end

    local safe = true
    visit.expressionChildren(value, function(child: scalarIR.Expr): scalarIR.Expr
        if not repeatable(child) then
            safe = false
        end
        return child
    end)

    return safe
end

local function localIdentity(value: any): string
    return tostring(value.cName or value.name)
end

local function sameLiteral(left: scalarIR.Expr, right: scalarIR.Expr): boolean
    return left.op == right.op and left.type == right.type and (left as any).value == (right as any).value
end

--- Reads and writes of one local anywhere in a structured value.
local function localActivity(value: any, identity: string): (integer, integer)
    if type(value) ~= "table" then
        return 0, 0
    end

    local reads: integer = value.op == "local" and localIdentity(value) == identity and 1 or 0
    local writes: integer = 0
    if value.op == "assign" then
        for _, assignment in ipairs(value.values or {}) do
            if assignment.target.kind == "local" and localIdentity(assignment.target) == identity then
                writes = writes + 1
            end
        end
    end
    for key, child in pairs(value) do
        if key ~= "source" then
            local childReads, childWrites = localActivity(child, identity)
            reads = (reads + childReads) as integer
            writes = (writes + childWrites) as integer
        end
    end

    return reads, writes
end

--- The locals a repeatable condition depends on.
local function conditionLocals(value: any, names: {[string]: boolean}): nil
    if type(value) ~= "table" then
        return nil
    end
    if value.op == "local" then
        names[localIdentity(value)] = true
    end
    for key, child in pairs(value) do
        if key ~= "source" then
            conditionLocals(child, names)
        end
    end

    return nil
end

local function writesAny(value: any, names: {[string]: boolean}): boolean
    if type(value) ~= "table" then
        return false
    end
    if value.op == "assign" then
        for _, assignment in ipairs(value.values or {}) do
            if assignment.target.kind == "local" and names[localIdentity(assignment.target)] then
                return true
            end
        end
    end
    for key, child in pairs(value) do
        if key ~= "source" and writesAny(child, names) then
            return true
        end
    end

    return false
end

local function containsBreak(value: any): boolean
    if type(value) ~= "table" then
        return false
    end
    if value.op == "break" then
        return true
    elseif value.op == "while" or value.op == "fornum" then
        return false
    end
    for key, child in pairs(value) do
        if key ~= "source" and containsBreak(child) then
            return true
        end
    end

    return false
end

--- Collects a single literal local write immediately before every break.
--- Nested loops and continue are declined: their exits have a different owner
--- or retain the current loop, respectively.
local function pairedBreaks(statements: {scalarIR.Statement}, found: any): boolean
    for position, statement in ipairs(statements) do
        if statement.op == "break" then
            local previous = statements[position - 1]
            if previous == nil or previous.op ~= "assign" or #previous.values ~= 1 then
                return false
            end
            local assignment = previous.values[1]
            if assignment.target.kind ~= "local" or not fold.isLiteral(assignment.value) then
                return false
            end
            local identity = localIdentity(assignment.target)
            if found.identity == nil then
                found.identity = identity
                found.target = assignment.target
                found.value = assignment.value
                found.source = previous.source
            elseif found.identity ~= identity or not sameLiteral(found.value, assignment.value) then
                return false
            end
            found.breaks = found.breaks + 1
        elseif statement.op == "continue" or statement.op == "while" or statement.op == "fornum" then
            return false
        elseif statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                if not pairedBreaks(clause.body, found) then
                    return false
                end
            end
            if statement.elseBody ~= nil and not pairedBreaks(statement.elseBody, found) then
                return false
            end
        elseif statement.op == "block" and not pairedBreaks(statement.body, found) then
            return false
        end
    end

    return true
end

local function matchingBreakWrite(
    statement: scalarIR.Statement,
    nextStatement: scalarIR.Statement?,
    found: any
): boolean
    if nextStatement == nil or nextStatement.op ~= "break" or statement.op ~= "assign" or #statement.values ~= 1 then
        return false
    end
    local assignment = statement.values[1]

    return assignment.target.kind == "local" and localIdentity(
        assignment.target
    ) == found.identity and sameLiteral(assignment.value, found.value)
end

--- Removes the writes whose value the post-loop condition now derives.
local function removeBreakWrites(statements: {scalarIR.Statement}, found: any): {scalarIR.Statement}
    local kept: {scalarIR.Statement} = {}
    for position, statement in ipairs(statements) do
        if not matchingBreakWrite(statement, statements[position + 1], found) then
            if statement.op == "if" then
                for _, clause in ipairs(statement.clauses) do
                    clause.body = removeBreakWrites(clause.body, found)
                end
                if statement.elseBody ~= nil then
                    statement.elseBody = removeBreakWrites(statement.elseBody, found)
                end
            elseif statement.op == "block" then
                statement.body = removeBreakWrites(statement.body, found)
            end
            kept[#kept + 1] = statement
        end
    end

    return kept
end

--- Finds a loop-carried break flag whose final value is the final condition.
local function breakResult(statements: {scalarIR.Statement}, position: integer, loop: scalarIR.While): any
    if not repeatable(loop.condition) then
        return nil
    end

    local found = {breaks = 0,}
    if not pairedBreaks(loop.body, found) or found.breaks == 0 then
        return nil
    end
    local identity = found.identity as string
    local reads, writes = localActivity(loop.body, identity)
    if reads ~= 0 or writes ~= found.breaks then
        return nil
    end

    -- A break must see the same condition operands the loop header did. The
    -- check is deliberately top-level and conservative: any dependency write
    -- before the last statement capable of breaking declines the rewrite.
    local dependencies: {[string]: boolean} = {}
    conditionLocals(loop.condition, dependencies)
    local lastBreak: integer = 0
    for bodyPosition, statement in ipairs(loop.body) do
        if containsBreak(statement) then
            lastBreak = bodyPosition
        end
    end
    for bodyPosition, bodyStatement in ipairs(loop.body) do
        if bodyPosition <= lastBreak and writesAny(bodyStatement, dependencies) then
            return nil
        end
    end

    local declaration
    local declarationPosition = 0
    for before = position - 1, 1, -1 do
        local statement = statements[before]
        if statement.op == "let" and localIdentity(statement) == identity then
            declaration = statement
            declarationPosition = before
            break
        end
    end
    if declaration == nil or not fold.isLiteral(
        declaration.value
    ) or declaration.type ~= found.value.type or sameLiteral(declaration.value, found.value) then
        return nil
    end
    for between, intervening in ipairs(statements) do
        if between > declarationPosition and between < position then
            local _, interveningWrites = localActivity(intervening, identity)
            if interveningWrites ~= 0 then
                return nil
            end
        end
    end

    local usedAfter: integer = 0
    for after, later in ipairs(statements) do
        if after > position then
            local laterReads = localActivity(later, identity)
            usedAfter = usedAfter + laterReads
        end
    end
    if usedAfter == 0 then
        return nil
    end

    return found
end

--- Derives a qualifying break result once after its loop rather than carrying
--- and selecting it through every iteration.
local function deriveBreakResults(statements: {scalarIR.Statement}, state: optimize.State): {scalarIR.Statement}
    local rewritten: {scalarIR.Statement} = {}
    for position, statement in ipairs(statements) do
        rewritten[#rewritten + 1] = statement
        if statement.op == "while" then
            local loop = statement as scalarIR.While
            local found = breakResult(statements, position, loop)
            if found ~= nil then
                loop.body = removeBreakWrites(loop.body, found)
                local assignment = new scalarIR.Assignment(
                    target = specialize.copy(found.target, {}),
                    value = specialize.copy(found.value, {})
                )
                rewritten[
                    #rewritten + 1
                ] = new scalarIR.If(
                    op = "if",
                    clauses = {
                        new scalarIR.Clause(
                            condition = specialize.copy(loop.condition, {}),
                            body = {new scalarIR.Assign(op = "assign", values = {assignment}, source = found.source),},
                            source = loop.source
                        ),
                    },
                    source = loop.source
                )
                countRule(state, "derive.break-result")
                state.changed = true
            end
        end
    end

    return rewritten
end

local function inheritConstants(values: {[string]: scalarIR.Expr}): {[string]: scalarIR.Expr}
    local copied: {[string]: scalarIR.Expr} = {}
    for name, value in pairs(values) do
        copied[name] = value
    end

    return copied
end

local function mutatedLocals(value: any, mutated: {[string]: boolean}): nil
    if type(value) ~= "table" then
        return
    end
    if value.op == "assign" then
        for _, assignment in ipairs(value.values or {}) do
            if assignment.target.kind == "local" and assignment.target.cName ~= nil then
                mutated[tostring(assignment.target.cName)] = true
            end
        end
    end
    -- A proof names the local whose value the dominating comparison checked.
    -- Replacing that occurrence with a literal would leave valid source code
    -- attached to an unverifiable (and misleading) proof identity.
    for name in pairs(value.cursorBounds or {}) do
        mutated[name] = true
    end
    for key, child in pairs(value) do
        if key ~= "source" then
            mutatedLocals(child, mutated)
        end
    end
end

local propagateBlock: function(
    {scalarIR.Statement},
    {[string]: scalarIR.Expr},
    {[string]: boolean},
    optimize.State
): nil

propagateBlock = function(
    statements: {scalarIR.Statement},
    inherited: {[string]: scalarIR.Expr},
    mutated: {[string]: boolean},
    state: optimize.State
): nil
    local constants = inheritConstants(inherited)
    local function rewrite(child: scalarIR.Expr): scalarIR.Expr
        return rewriteExpression(child, constants, BODY_REWRITE, state)
    end

    for _, statement in ipairs(statements) do
        effects.statement(tostring(statement.op))
        local value = statement as any
        visit.statementExpressions(statement, rewrite)
        if statement.op == "let" and mutated[
            statement.cName
        ] ~= true and mutated[statement.name] ~= true and fold.isLiteral(statement.value) then
            constants[statement.cName] = statement.value
        elseif statement.op == "if" then
            -- The statement walk above already rewrote every clause condition
            -- and the native switch selector; only the nested blocks remain.
            for _, clause in ipairs(statement.clauses) do
                propagateBlock(clause.body, constants, mutated, state)
            end
            if statement.elseBody ~= nil then
                propagateBlock(statement.elseBody as {scalarIR.Statement}, constants, mutated, state)
            end
        elseif statement.op == "fornum" or statement.op == "while" or statement.op == "block" then
            propagateBlock(value.body as {scalarIR.Statement}, constants, mutated, state)
        end
    end
end

optimizeBlock = function(statements: {scalarIR.Statement}, state: optimize.State): {scalarIR.Statement}
    local rewritten: {scalarIR.Statement} = {}
    local terminated = false
    for _, statement in ipairs(statements) do
        if terminated then
            state.removedStatements = state.removedStatements + 1
            state.changed = true
        else
            foldStatementExpressions(statement, state)
            if statement.op == "if" then
                -- Conditions and the selector were folded by the statement
                -- walk above; only the nested blocks remain.
                local branch = statement as scalarIR.If
                for _, clause in ipairs(branch.clauses) do
                    clause.body = optimizeBlock(clause.body, state)
                end
                if branch.elseBody ~= nil then
                    branch.elseBody = optimizeBlock(branch.elseBody as {scalarIR.Statement}, state)
                end
                local selected: {scalarIR.Statement}?
                local known = true
                for _, clause in ipairs(branch.clauses) do
                    if clause.condition.op ~= "bool" then
                        known = false
                        break
                    elseif (clause.condition as scalarIR.Bool).value then
                        selected = clause.body
                        break
                    end
                end
                if known then
                    selected = selected or branch.elseBody or {}
                    rewritten[
                        #rewritten + 1
                    ] = new scalarIR.Block(op = "block", body = selected, source = branch.source)
                    state.statementFolds = state.statementFolds + 1
                    state.changed = true
                else
                    rewritten[#rewritten + 1] = statement
                end
            elseif statement.op == "while" then
                local loop = statement as scalarIR.While
                loop.body = optimizeBlock(loop.body, state)
                if loop.condition.op == "bool" and not (loop.condition as scalarIR.Bool).value then
                    state.removedStatements = state.removedStatements + 1
                    state.changed = true
                else
                    rewritten[#rewritten + 1] = statement
                end
            elseif statement.op == "fornum" then
                local loop = statement as scalarIR.Fornum
                loop.body = optimizeBlock(loop.body, state)
                local first = fold.exactInteger(loop.from)
                local last = fold.exactInteger(loop.to)
                local trips = first ~= nil and last ~= nil and math.max(
                    (last as number) - (first as number) + 1,
                    0
                ) or nil
                if trips ~= nil and trips <= optimize.MAX_UNROLL_TRIPS and not containsLoopExit(loop.body) then
                    local expanded: {scalarIR.Statement} = {}
                    local growth = -specialize.nodes(loop)
                    for offset = 0, (trips as number) - 1 do
                        local value = fold.integerConstant((first as number) + offset, loop.binding.type, loop)
                        local body = specialize.copy(loop.body, {}) as {scalarIR.Statement}
                        local iterationBody: {
                            scalarIR.Statement
                        } = {
                            new scalarIR.Let(
                                op = "let",
                                name = loop.binding.name,
                                cName = loop.binding.cName,
                                value = value,
                                type = loop.binding.type,
                                source = loop.source
                            ),
                        }
                        for _, inner in ipairs(body) do
                            iterationBody[#iterationBody + 1] = inner
                        end
                        local iteration = new scalarIR.Block(op = "block", body = iterationBody, source = loop.source)
                        expanded[#expanded + 1] = iteration
                        growth = growth + specialize.nodes(iteration)
                    end
                    if growth <= state.unrollBudget then
                        for _, iteration in ipairs(expanded) do
                            rewritten[#rewritten + 1] = iteration
                        end
                        state.unrollBudget = state.unrollBudget - math.max(growth, 0)
                        state.unrolledLoops = state.unrolledLoops + 1
                        state.unrolledIterations = state.unrolledIterations + (trips as integer)
                        state.changed = true
                    else
                        rewritten[#rewritten + 1] = statement
                    end
                else
                    rewritten[#rewritten + 1] = statement
                end
            elseif statement.op == "block" then
                local value = statement as any
                value.body = optimizeBlock(value.body as {scalarIR.Statement}, state)
                rewritten[#rewritten + 1] = statement
            else
                rewritten[#rewritten + 1] = statement
            end

            terminated = statement.op == "return" or statement.op == "break" or statement.op == "continue"
        end
    end

    return deriveBreakResults(rewritten, state)
end

local function countUses(value: any, uses: {[string]: integer}): nil
    if type(value) ~= "table" then
        return
    end
    if value.op == "local" then
        local identity = tostring(value.cName or value.name)
        uses[identity] = (uses[identity] or 0) + 1
    end
    if value.op == "assign" then
        for _, assignment in ipairs(value.values or {}) do
            if assignment.target.kind == "local" and assignment.target.cName ~= nil then
                local identity = tostring(assignment.target.cName)
                uses[identity] = (uses[identity] or 0) + 1
            end
        end
    end
    for key, child in pairs(value) do
        if key ~= "source" and key ~= "cName" and key ~= "name" and key ~= "cursorCName" and key ~= "indexCName" then
            countUses(child, uses)
        end
    end
end

local function removeDead(statements: {scalarIR.Statement}, state: optimize.State): {scalarIR.Statement}
    local uses: {[string]: integer} = {}
    countUses(statements, uses)
    local kept: {scalarIR.Statement} = {}
    for _, statement in ipairs(statements) do
        if statement.op == "if" then
            for _, clause in ipairs(statement.clauses) do
                clause.body = removeDead(clause.body, state)
            end
            if statement.elseBody ~= nil then
                statement.elseBody = removeDead(statement.elseBody as {scalarIR.Statement}, state)
            end
        elseif statement.op == "fornum" or statement.op == "while" or statement.op == "block" then
            (statement as any).body = removeDead((statement as any).body as {scalarIR.Statement}, state)
        end

        if statement.op == "let" and uses[
            statement.cName
        ] == nil and fold.discardable(statement.value, state.foldContext) then
            state.removedStatements = state.removedStatements + 1
            state.changed = true
        else
            kept[#kept + 1] = statement
        end
    end

    return kept
end

local function markHelperUses(value: any, used: {[string]: boolean}, helpers: {[string]: scalarIR.Helper}): nil
    if type(value) ~= "table" then
        return
    end
    if value.op == "helper_call" then
        local name = tostring(value.helper)
        if not used[name] then
            used[name] = true
            local helper = helpers[name]
            if helper ~= nil then
                markHelperUses((helper as scalarIR.Helper).values, used, helpers)
            end
        end
    end
    for key, child in pairs(value) do
        if key ~= "source" then
            markHelperUses(child, used, helpers)
        end
    end
end

local function removeUnusedHelpers(program: scalarIR.Program, helpers: {[string]: scalarIR.Helper}): nil
    local used: {[string]: boolean} = {}
    markHelperUses(
        program.loop ~= nil and (
            program.loop as scalarIR.Loop
        ).statements or program.workgroup ~= nil and (
            program.workgroup as scalarIR.Workgroup
        ).statements or program.body or {},
        used,
        helpers
    )
    local kept: {scalarIR.Helper} = {}
    for _, helper in ipairs(program.helpers or {}) do
        if used[helper.name] then
            kept[#kept + 1] = helper
        end
    end
    program.helpers = kept
end

--- Optimises one verified program in place.
--- @return counters describing the actual rewrite
--- @raises when an IR opcode has no effect classification
function optimize.program(program: scalarIR.Program): optimize.Stats
    local before = specialize.nodes(program)
    local helpers: {[string]: scalarIR.Helper} = {}
    for _, helper in ipairs(program.helpers or {}) do
        helpers[helper.name] = helper
    end
    local state = new optimize.State(
        statementFolds = 0,
        specializationBudget = math.max(math.floor(before / 10), 1),
        unrollBudget = optimize.MAX_UNROLL_GROWTH,
        helpers = helpers,
        foldContext = new fold.Context(helpers = helpers),
        specializeContext = new specialize.Context(helpers = helpers),
        ruleApplications = {},
        unrolledLoops = 0,
        unrolledIterations = 0,
        removedStatements = 0,
        changed = false
    )
    local mutated: {[string]: boolean} = {}
    mutatedLocals(program, mutated)
    local iterations = 0
    repeat
        iterations = iterations + 1
        state.changed = false
        for _, helper in ipairs(program.helpers or {}) do
            for position, value in ipairs(helper.values) do
                helper.values[position] = rewriteExpression(value, nil, FOLD_REWRITE, state)
            end
        end
        if program.loop ~= nil then
            local loop = program.loop as scalarIR.Loop
            propagateBlock(loop.statements, {}, mutated, state)
            loop.statements = optimizeBlock(loop.statements, state)
            loop.statements = removeDead(loop.statements, state)
        elseif program.workgroup ~= nil then
            -- Phase boundaries are scheduling semantics, not ordinary control
            -- statements. Preserve the verified controller until phase-aware
            -- rewrites can prove they neither remove nor cross a barrier.
        else
            propagateBlock(program.body or {}, {}, mutated, state)
            program.body = optimizeBlock(program.body or {}, state)
            program.body = removeDead(program.body or {}, state)
        end
    until not state.changed or iterations == 4

    removeUnusedHelpers(program, helpers)

    -- Verification owns this derived fact. Clearing it makes the second verify
    -- recompute the bound instead of merely agreeing with the first pass.
    program.maxStack = nil

    local applications: {optimize.RuleApplication} = {}
    local expressionFolds: integer = 0
    for id, count in pairs(state.ruleApplications) do
        applications[#applications + 1] = new optimize.RuleApplication(id = id, count = count)
        if id ~= "propagate.local-constant" and id ~= "specialize.helper-constant" then
            expressionFolds = expressionFolds + count
        end
    end
    table.sort(applications, function(left: optimize.RuleApplication, right: optimize.RuleApplication): boolean
        return left.id < right.id
    end)

    return new optimize.Stats(
        beforeNodes = before,
        afterNodes = specialize.nodes(program),
        folds = expressionFolds + state.statementFolds,
        propagatedConstants = state.ruleApplications["propagate.local-constant"] or 0,
        specializedHelperCalls = state.ruleApplications["specialize.helper-constant"] or 0,
        unrolledLoops = state.unrolledLoops,
        unrolledIterations = state.unrolledIterations,
        removedStatements = state.removedStatements,
        iterations = iterations as integer,
        ruleApplications = applications
    )
end

export = optimize
