module nupp.compiler.aot.compile

--[[
Compiling one `@aot` function, end to end. The source is lowered, verified,
optimized, and emitted. Explicit vector values are legalized for the selected
target before emission.
]]

local bindingRules = require("nupp.compiler.aot.binding")
local hash = require("nupp.compiler.hash")
local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local gpuartifact = require("nupp.compiler.aot.gpuartifact")
local gpuBinding = require("nupp.compiler.aot.gpubinding")
local lower = require("nupp.compiler.aot.lower")
local loopAnalysis = require("nupp.compiler.aot.loops")
local aotOptimize = require("nupp.compiler.aot.optimize")
local parser = require("nupp.compiler.syntax.parser")
local scalarIR = require("nupp.compiler.aot.scalar")
local targets = require("nupp.compiler.aot.target")
local text = require("nupp.compiler.aot.text")
local types = require("nupp.compiler.types")
local verify = require("nupp.compiler.aot.verify")
local visit = require("nupp.compiler.aot.visit")

local compile = {}

--- One reason a source was not admitted, at the position it was written.
record compile.Diagnostic
    file: string
    line: integer
    column: integer
    message: string
end

--- Where one `@aot` declaration sits in the source it came from.
---
--- The whole declaration: the annotations and the function they decorate, from
--- the first byte of the outermost `@aot` to the last byte of its `end`.
---
--- Deliberately beside the IR rather than in it. The IR is what an artifact is
--- keyed on, and an offset moves when a comment above it is edited, so carrying
--- one inside would make every comment a rebuild.
record compile.Site
    --- Byte offset of the first character, 1-based.
    from: integer

    --- Byte offset of the last character, 1-based and inclusive.
    to: integer
end

--- Everything compiling one function produces.
record compile.Artifacts
    --- The verified IR of every `@aot` function in the file, in source order,
    --- which is what the other three were written from.
    programs: {scalarIR.Program}

    --- One optimizer report per program, in the same order.
    optimizations: {aotOptimize.Stats}

    --- Per-program loop reports, in source order within each program.
    loops: {{loopAnalysis.Report}}

    --- The IR's readable form.
    irText: string

    --- The Nupp module that stands in front of the compiled code.
    binding: string

    --- Shader artifacts by logical program symbol. CPU programs have no entry.
    gpu: {[string]: gpuartifact.Artifact}

    --- Where each source-declared program was written, in `programs` order.
    --- Const specializations are appended to `programs` after these and have
    --- no entry here: their several programs share one declaration, which
    --- `constFamilies` records.
    sites: {compile.Site}

    --- Const-generic declarations whose several programs share one source site.
    constFamilies: {any}?
end

--- One diagnostic, as a line a person reads.
function compile.renderDiagnostic(problem: compile.Diagnostic): string
    return ("%s:%d:%d: aot: %s"):format(problem.file, problem.line, problem.column, problem.message)
end

--- The sentinel a refusal unwinds with, so it is told apart from a real error
--- rather than swallowing one.
local REFUSED = {}

--- Every emitted symbol lives in the process-wide C namespace when an archive
--- is linked statically. Qualify by source before either shared or static
--- linkage is selected, so code generation and its cache have one identity.
local function qualifySymbols(programs: {scalarIR.Program}, filename: string): nil
    local identity = hash.digest(filename):sub(1, 16)
    local registrars: {[string]: string} = {}
    local prefix = "ks_" .. identity .. "_"
    for _, program in ipairs(programs) do
        program.symbol = prefix .. program.symbol:sub(4)
        -- A call to another entry of this file names that entry's symbol.
        for _, helper in ipairs(program.helpers or {}) do
            if helper.native == true and helper.cName:sub(1, #prefix) ~= prefix then
                helper.cName = prefix .. helper.cName:sub(4)
            end
        end
        if program.registrar ~= nil then
            local registrar = program.registrar as string
            local qualified = registrars[registrar]
            if qualified == nil then
                qualified = "ks_register_" .. identity .. "_" .. registrar:sub(#"ks_register_" + 1)
                registrars[registrar] = qualified
            end
            program.registrar = qualified
        end
    end
end

--- Where one `@aot` declaration was written, as byte offsets.
---
--- From the first annotation rather than from the function, because replacing
--- the declaration means replacing the annotations that decorate it too. A
--- wrapper that kept `@aot` above it would ask the checker to compile the body
--- it is standing in for.
function compile.site(application: lower.Application): compile.Site
    local first = cst.firstToken(application.at as cst.Child?)
    local last = cst.lastToken(application.tail as cst.Child?)
    local from = first ~= nil and (first as lexer.Token).offset or 1
    local to = last ~= nil and ((last as lexer.Token).offset + #(last as lexer.Token).text - 1) or from

    return new compile.Site(from = from, to = to)
end

local function sitePosition(source: string, offset: integer): (integer, integer)
    local before = source:sub(1, offset - 1)
    local _, newlines = before:gsub("\n", "")
    local lineStart = before:match(".*\n()") or 1
    return newlines + 1, offset - lineStart + 1
end

--- A refusal recorder for `lower.Context`: the reason lands in `diagnostics`
--- against `filename`, and lowering unwinds to the enclosing pcall.
local function rejection(filename: string, diagnostics: {compile.Diagnostic}): function(scalarIR.Source?, string): nil
    return function(at: scalarIR.Source?, message: string): nil
        diagnostics[
            #diagnostics + 1
        ] = new compile.Diagnostic(
            file = filename,
            line = at ~= nil and (at as scalarIR.Source).line or 1,
            column = at ~= nil and (at as scalarIR.Source).column or 1,
            message = message
        )
        error(REFUSED, 0)
    end
end

--- Gives every Lua builder in a module the one registrar they share, named
--- after all of their symbols so two modules cannot collide.
local function nameRegistrar(programs: {scalarIR.Program}): nil
    local builderSymbols: {string} = {}
    for _, program in ipairs(programs) do
        if program.entryMode == "lua-builder" then
            builderSymbols[#builderSymbols + 1] = program.symbol
        end
    end
    if #builderSymbols == 0 then
        return
    end
    local registrar = "ks_register_" .. hash.digest(table.concat(builderSymbols, "\0")):sub(1, 16)
    for _, program in ipairs(programs) do
        if program.entryMode == "lua-builder" then
            program.registrar = registrar
        end
    end
end

--- Whether a target has vector registers, which is what `simd.species`
--- answers. No target means the standalone harness, which has always assumed
--- them.
function compile.vectors(selected: targets.Target?): boolean
    return selected == nil or (targets.TIERS[(selected as targets.Target).tier] or 0) > 0
end

--- Lowers one source to verified scalar IR.
---
--- @param source the text, used when `parsed` is not supplied
--- @param filename what diagnostics name
--- @param parsed an already-parsed tree, which is how the checker hands one over
--- @param selected the target, which decides whether `simd.species` answers
---   with a species or with nil; absent, vectors are assumed
--- @return the IR, the reasons it was refused, and where each program was
---   written
--- @raises string when the IR the source lowered to is not well formed, which is a
---   compiler bug rather than something about the source
function compile.lower(
    source: string,
    filename: string,
    parsed: parser.ParseResult?,
    selected: targets.Target?
): ({scalarIR.Program}, {compile.Diagnostic}, {compile.Site})
    local tree = parsed or parser.parse(source, filename)
    local diagnostics: {compile.Diagnostic} = {}
    if #tree.errors > 0 then
        for _, problem in ipairs(tree.errors) do
            diagnostics[
                #diagnostics + 1
            ] = new compile.Diagnostic(
                file = filename,
                line = problem.line or 1,
                column = problem.col or 1,
                message = "syntax error: " .. problem.msg
            )
        end

        return {}, diagnostics, {}
    end

    local context = new lower.Context(
        checked = parsed ~= nil,
        vectors = compile.vectors(selected),
        nativeCpu = selected == nil or selected.architecture ~= "wasm32",
        constantNames = {},
        constantValues = {},
        reject = rejection(filename, diagnostics)
    )

    -- The checker records `@aot` as a fact on the body; without it the
    -- annotation is read off the tree, which is what lets this run on a tree the
    -- checker never saw.
    local wasChecked = parsed ~= nil
    local sites: {compile.Site} = {}
    local ok, lowered = pcall(function(): {scalarIR.Program}
        local found = lower.scan(tree.root, wasChecked)
        if #found.applications == 0 then
            context.reject(nil, "no @aot function was found")
        end

        local programs: {scalarIR.Program} = {}
        for _, application in ipairs(found.applications) do
            local declaration = application.tail as cst.LocalFuncStmt?
            local body = declaration ~= nil and declaration.body or nil
            if body == nil or (body as cst.Funcbody).generics == nil then
                programs[#programs + 1] = lower.program(found, application, wasChecked, context)
                sites[#sites + 1] = compile.site(application)
            end
        end

        nameRegistrar(programs)
        for position, program in ipairs(programs) do
            programs[position] = verify.program(program)
        end

        return programs
    end)

    if not ok then
        if lowered ~= REFUSED then
            error(lowered, 0)
        end

        return {}, diagnostics, {}
    end

    return lowered as {scalarIR.Program}, diagnostics, sites
end

local function numericForRuntime(program: scalarIR.Program, selected: targets.Target): nil
    program.numericForRuntime = targets.numericForRuntime(selected)
    if program.numericForRuntimeRequired == nil then
        local counted = program.loop ~= nil
        visit.program(
            program,
            new visit.Visitor(scalarStatement = function(statement: scalarIR.Statement): nil
                counted = counted or statement.op == "fornum"
            end)
        )
        program.numericForRuntimeRequired = counted
    end
end

--- Lowers the closed const tuples collected for generic `@aot` declarations.
---
--- The deliverable planner supplies semantic demands from every checked module.
--- Carrier parameters disappear from the private ABI, their values seed the IR
--- environment, and the ordinary optimizer and lane pass consume the result.
--- The single-source fallback remains for the retained backend harness.
--- @raises string when lowering or verification exposes a compiler bug rather than an
---   authored specialization refusal
function compile.constSpecializations(
    source: string,
    filename: string,
    parsed: parser.ParseResult,
    selected: targets.Target,
    symbolTier: string?,
    plans: {any}?
): (compile.Artifacts?, {compile.Diagnostic})
    const maxPerModule = 8
    local diagnostics: {compile.Diagnostic} = {}
    local laneRefusals: {compile.Diagnostic}? = nil
    local context = new lower.Context(
        checked = true,
        vectors = compile.vectors(selected),
        nativeCpu = selected.architecture ~= "wasm32",
        reject = rejection(filename, diagnostics)
    )

    -- Returned rather than rejected: `reject` unwinds to the pcall below, and
    -- there is none yet.
    if #parsed.errors > 0 then
        return nil, {
            new compile.Diagnostic(
                file = filename,
                line = 1,
                column = 1,
                message = "const specialization needs a checked source"
            ),
        }
    end

    local found = lower.scan(parsed.root, true)
    local candidates: {[string]: any} = {}
    local candidatesByDefinition: {[any]: any} = {}
    for _, application in ipairs(found.applications) do
        local declaration = application.tail
        local body = declaration ~= nil
            and declaration.kind == "localFuncStmt"
            and (declaration as cst.LocalFuncStmt).body
            or nil
        local generics = body ~= nil and (body as cst.Funcbody).generics or nil
        if generics ~= nil then
            local clause = generics as cst.Generics
            local binders: {any} = {}
            local onlyConst = #clause.names > 0
            for position, token in ipairs(clause.names) do
                onlyConst = onlyConst and clause.consts[position] == true
                if clause.consts[position] == true then
                    binders[
                        #binders + 1
                    ] = {
                        name = token.text,
                        domain = clause.domains[position] ~= nil and clause.domains[position].text or "",
                        carriers = {},
                    }
                end
            end
            if onlyConst and #binders > 0 then
                local byBinder: {[string]: any} = {}
                for _, binder in ipairs(binders) do
                    byBinder[binder.name] = binder
                end
                for position, raw in ipairs((body as cst.Funcbody).params or {}) do
                    local param = raw as cst.Param
                    local annotation = param.type
                    local binder = annotation ~= nil
                        and annotation.kind == "tname"
                        and (annotation as cst.Tname).typeArgs == nil
                        and (annotation as cst.Tname).base ~= nil
                        and byBinder[((annotation as cst.Tname).base as lexer.Token).text]
                        or nil
                    if binder ~= nil and param.name ~= nil then
                        binder.carriers[#binder.carriers + 1] = {position = position, name = param.name.text,}
                    end
                end
                local complete = true
                for _, binder in ipairs(binders) do
                    complete = complete and #binder.carriers > 0
                end
                local name = (declaration as cst.LocalFuncStmt).name
                if complete and name ~= nil then
                    local candidate = {
                        application = application,
                        definition = name.definition,
                        binders = binders,
                        seen = {},
                        specializations = {},
                        dispatches = {},
                        classIndex = {},
                    }
                    candidates[name.text] = candidate
                    candidatesByDefinition[name.definition] = candidate
                end
            end
        end
    end

    local function literal(parameter: any, source: scalarIR.Source?): (string?, scalarIR.Expr?)
        if parameter == nil or parameter.tag ~= "literal" or parameter.base == nil then
            return nil, nil
        end
        local domain = parameter.base.tag
        if domain == "integer" then
            local written = tostring(parameter.constant)
            return "integer:" .. written, new scalarIR.Constant(
                op = "constant",
                value = written,
                type = "f64",
                source = source
            )
        elseif domain == "boolean" then
            local value = parameter.constant == true
            return "boolean:" .. tostring(
                value
            ), new scalarIR.Bool(op = "bool", value = value, type = "bool", source = source)
        elseif domain == "string" then
            local value = tostring(parameter.constant)
            return "string:" .. tostring(
                #value
            ) .. ":" .. value, new scalarIR.LuaString(
                op = "lua_string",
                value = value,
                type = "lua_string",
                source = source
            )
        end

        return nil, nil
    end

    local specializationLines: {integer} = {}
    local specializationSites: {any} = {}

    local function walk(node: any): nil
        if node == nil or cst.isToken(node) then
            return
        end
        if node.kind == "call" then
            local call = node as cst.Call
            local callee = call.obj
            local token = callee ~= nil and callee.kind == "name" and (callee as cst.NameExpr).token or nil
            local candidate = token ~= nil and candidates[(token as lexer.Token).text] or nil
            if candidate ~= nil and (token as lexer.Token).definition == candidate.definition then
                local signature = (call as any).signatureType
                local values: {[string]: scalarIR.Expr} = {}
                local omitted: {[integer]: boolean} = {}
                local tuple: {string} = {}
                local sourceSite = lower.site(call)
                local complete = signature ~= nil and signature.tag == "func"
                for _, binder in ipairs(candidate.binders) do
                    local binderKey: string? = nil
                    for _, carrier in ipairs(binder.carriers) do
                        local key: string? = nil
                        local value: scalarIR.Expr? = nil
                        if complete then
                            key, value = literal(signature.params[carrier.position], sourceSite)
                        end
                        if key == nil or value == nil or binderKey ~= nil and binderKey ~= key then
                            complete = false
                            break
                        end
                        binderKey = key
                        values[carrier.name] = value
                        omitted[carrier.position] = true
                    end
                    if not complete or binderKey == nil then
                        break
                    end
                    tuple[#tuple + 1] = binder.domain .. ":" .. binder.name .. "=" .. binderKey
                end
                if complete then
                    local canonical = filename .. "\0" .. (
                        token as lexer.Token
                    ).text .. "\0" .. types.tostring(signature) .. "\0" .. table.concat(tuple, "\0")
                    local key = hash.digest(canonical)
                    if not candidate.seen[key] then
                        candidate.seen[key] = true
                        specializationLines[#specializationLines + 1] = sourceSite.line
                        specializationSites[#specializationSites + 1] = {file = filename, line = sourceSite.line,}
                        local lowered = new lower.Specialization(
                            name = "__nuppConst_" .. (
                                token as lexer.Token
                            ).text:gsub("[^%w_]", "_") .. "_" .. key:sub(1, 16),
                            signature = signature,
                            values = values,
                            omitted = omitted
                        )
                        candidate.specializations[#candidate.specializations + 1] = lowered
                        candidate.dispatches[
                            #candidate.dispatches + 1
                        ] = {specialization = lowered, index = #candidate.specializations,}
                    end
                end
            end
        end
        for _, child in ipairs(node as {any}) do
            walk(child)
        end
    end

    if plans ~= nil then
        for _, plan in ipairs(plans as {any}) do
            local candidate = candidatesByDefinition[plan.definition]
            if candidate ~= nil then
                for _, specialization in ipairs(plan.specializations) do
                    if not candidate.seen[specialization.key] then
                        candidate.seen[specialization.key] = true
                        local values: {[string]: scalarIR.Expr} = {}
                        local complete = true
                        for _, binder in ipairs(candidate.binders) do
                            for _, carrier in ipairs(binder.carriers) do
                                local _, value = literal(specialization.signature.params[carrier.position], nil)
                                if value == nil then
                                    complete = false
                                    break
                                end
                                values[carrier.name] = value
                            end
                            if not complete then
                                break
                            end
                        end
                        if complete then
                            local physical = specialization.physical or specialization
                            local lowered = new lower.Specialization(
                                name = physical.name,
                                signature = specialization.signature,
                                values = values,
                                omitted = specialization.omitted
                            )
                            local class = specialization.bodyClass or specialization.key
                            local index = candidate.classIndex[class]
                            if index == nil then
                                candidate.specializations[#candidate.specializations + 1] = lowered
                                index = #candidate.specializations
                                candidate.classIndex[class] = index
                            end
                            candidate.dispatches[#candidate.dispatches + 1] = {specialization = lowered, index = index,}
                            for _, call in ipairs(specialization.calls) do
                                local line = lower.site(call).line
                                specializationLines[#specializationLines + 1] = line
                                specializationSites[
                                    #specializationSites + 1
                                ] = {file = specialization.callFiles[call] or filename, line = line,}
                            end
                        end
                    end
                end
            end
        end
    else
        walk(parsed.root)
    end

    local function bySpecializationName(a, b): boolean
        return a.name < b.name
    end

    for _, candidate in pairs(candidates) do
        if plans == nil then
            table.sort(candidate.specializations, bySpecializationName)
            candidate.dispatches = {}
            for index, specialization in ipairs(candidate.specializations) do
                candidate.dispatches[#candidate.dispatches + 1] = {specialization = specialization, index = index,}
            end
        end
    end

    local specializationCount = 0
    for _, candidate in pairs(candidates) do
        specializationCount = specializationCount + #candidate.specializations
    end
    if specializationCount > maxPerModule then
        local sites: {string} = {}
        for _, site in ipairs(specializationSites) do
            sites[#sites + 1] = site.file .. ":" .. tostring(site.line)
        end
        diagnostics[
            #diagnostics + 1
        ] = new compile.Diagnostic(
            file = filename,
            line = specializationLines[maxPerModule + 1] or specializationLines[1] or 1,
            column = 1,
            message = (
                "const specialization requires %d body classes in this module, over the cap of %d; demanding call sites: %s"
            ):format(specializationCount, maxPerModule, table.concat(sites, ", "))
        )
        return nil, diagnostics
    end

    local ok, answer = pcall(function(): compile.Artifacts
        local programs: {scalarIR.Program} = {}
        local families: {any} = {}
        for _, application in ipairs(found.applications) do
            local declaration = application.tail as cst.LocalFuncStmt?
            local name = declaration ~= nil and declaration.name ~= nil and declaration.name.text or ""
            local candidate = candidates[name]
            local familyPrograms: {scalarIR.Program} = {}
            local familySpecializations: {lower.Specialization} = {}
            local familyDispatchPrograms: {scalarIR.Program} = {}
            for _, specialization in ipairs(candidate ~= nil and candidate.specializations or {}) do
                -- Verified below, after lua-builder registrars are named:
                -- a builder-mode specialization needs the same shared
                -- registrar rewrite compile.artifacts applies.
                local program = lower.program(found, application, true, context, specialization)
                programs[#programs + 1] = program
                familyPrograms[#familyPrograms + 1] = program
            end
            for _, dispatch in ipairs(candidate ~= nil and candidate.dispatches or {}) do
                familySpecializations[#familySpecializations + 1] = dispatch.specialization
                familyDispatchPrograms[#familyDispatchPrograms + 1] = familyPrograms[dispatch.index]
            end
            if #familyPrograms > 0 and declaration ~= nil and declaration.body ~= nil then
                local first = cst.firstToken(declaration)
                local bodyFirst = cst.firstToken((declaration.body as cst.Funcbody).body)
                local headerFrom = first ~= nil and first.offset or 1
                local headerTo = bodyFirst ~= nil and bodyFirst.offset - 1 or headerFrom
                families[
                    #families + 1
                ] = {
                    site = compile.site(application),
                    header = source:sub(headerFrom, headerTo),
                    name = name,
                    binders = candidate.binders,
                    programs = familyPrograms,
                    specializations = familySpecializations,
                    dispatchPrograms = familyDispatchPrograms,
                }
            end
        end
        if #programs == 0 then
            context.reject(nil, "no closed const-generic AOT applications were found")
        end

        nameRegistrar(programs)
        for _, program in ipairs(programs) do
            verify.program(program)
        end

        local optimizations: {aotOptimize.Stats} = {}
        local loopReports: {{loopAnalysis.Report}} = {}
        for position, program in ipairs(programs) do
            numericForRuntime(program, selected)
            optimizations[position] = aotOptimize.program(program)
            verify.program(program)
            local refusals = compile.legalizeVectors(program, filename, selected)
            if refusals ~= nil then
                laneRefusals = refusals
                error(REFUSED, 0)
            end
            loopReports[position] = loopAnalysis.program(program)
        end

        return new compile.Artifacts(
            programs = programs,
            optimizations = optimizations,
            loops = loopReports,
            irText = text.programs(programs),
            binding = "",
            gpu = {},
            sites = {},
            constFamilies = families
        )
    end)
    if not ok then
        if answer ~= REFUSED then
            error(answer, 0)
        end
        return nil, laneRefusals or diagnostics
    end

    return answer as compile.Artifacts, diagnostics
end

--- Resolves explicit vector widths and validates constant lane indices.
function compile.legalizeVectors(
    program: scalarIR.Program,
    filename: string,
    selected: targets.Target
): {compile.Diagnostic}?
    numericForRuntime(program, selected)
    local resolvedWidth = targets.simdWidth(selected)
    local indexRefusals: {compile.Diagnostic} = {}
    if program.usesSimd == true then
        visit.program(
            program,
            new visit.Visitor(scalarExpression = function(node: scalarIR.Expr): nil
                if node.op == "simd_extract" or node.op == "simd_insert" then
                    local operation = node as scalarIR.Simd
                    local element = operation.args[1].type:match("^simd_vector_([fiu]%d+)_preferred$")
                    local index = operation.args[2]
                    if element ~= nil and index.op == "constant" then
                        local bits = tonumber((element as string):match("%d+")) or 0
                        local lane = tonumber((index as scalarIR.Constant).value) or 0
                        if bits > 0 and lane > math.floor(resolvedWidth * 8 / bits) then
                            local at = node.source
                            indexRefusals[
                                #indexRefusals + 1
                            ] = new compile.Diagnostic(
                                file = filename,
                                line = at ~= nil and (at as scalarIR.Source).line or 1,
                                column = at ~= nil and (at as scalarIR.Source).column or 1,
                                message = "SIMD lane index exceeds the logical species lanes for the selected tier"
                            )
                        end
                    end
                end
            end)
        )
    end
    if #indexRefusals > 0 then
        return indexRefusals
    end
    if program.usesSimd == true then
        program.simdWidth = targets.simdWidth(selected)
        program.vectorCeiling = targets.vectorCeiling(selected)
    end

    return nil
end

--- Compiles one source to everything a build would need from it.
---
--- @param library where the compiled object will be found, which the generated
---   module loads
--- @param selected the target, which decides how wide a vector may be
--- @param at named with each step this takes as it reaches it, for a build
---   accounting for where its time went. A plain function rather than the
---   build's reporter, because what compiles one `@aot` body should not have to
---   know what a progress line is.
--- @return the artifacts, or nothing and the reasons the source was refused
function compile.artifacts(
    source: string,
    filename: string,
    parsed: parser.ParseResult?,
    library: string,
    selected: targets.Target,
    symbolTier: string?,
    constPlans: {any}?,
    qualifyLinkage: boolean?,
    at: (function(step: string): nil)?
): (compile.Artifacts?, {compile.Diagnostic})
    local step = at or function(_: string): nil
    end
    step("lower")
    local programs, diagnostics, sites = compile.lower(source, filename, parsed, selected)
    if #diagnostics > 0 then
        return nil, diagnostics
    end
    local constArtifacts: compile.Artifacts? = nil
    if parsed ~= nil then
        local specialized, specializationDiagnostics = compile.constSpecializations(
            source,
            filename,
            parsed as parser.ParseResult,
            selected,
            symbolTier,
            constPlans
        )
        if specialized ~= nil then
            constArtifacts = specialized
        elseif specializationDiagnostics[1] ~= nil
            and specializationDiagnostics[1].message ~= "no closed const-generic AOT applications were found"
        then
            return nil, specializationDiagnostics
        end
    end
    if #programs == 0 and constArtifacts == nil then
        return nil, {
            new compile.Diagnostic(file = filename, line = 1, column = 1, message = "no @aot function was found")
        }
    end

    local optimizations: {aotOptimize.Stats} = {}
    local loopReports: {{loopAnalysis.Report}} = {}
    local gpu: {[string]: gpuartifact.Artifact} = {}
    local cpuPrograms: {scalarIR.Program} = {}
    local declaredModule = parsed ~= nil and cst.declaredModule((parsed as parser.ParseResult).root) ~= nil
    local browser = selected.triple:match("^wasm") ~= nil
    step("optimize")
    for position, program in ipairs(programs) do
        numericForRuntime(program, selected)
        optimizations[position] = aotOptimize.program(program)
        -- Every optimized body is checked before any artifact is built from it.
        verify.program(program)
        if program.executionTarget == "gpu" then
            local artifact, rule = gpuartifact.program(program, browser)
            if artifact == nil then
                local site = sites[position]
                local line, column = sitePosition(source, site ~= nil and (site as compile.Site).from or 1)
                return nil, {
                    new compile.Diagnostic(file = filename, line = line, column = column, message = rule as string)
                }
            end
            local checkedArtifact = artifact as gpuartifact.Artifact
            checkedArtifact.exportTypes = declaredModule
            local site = sites[position]
            local line, column = sitePosition(source, site ~= nil and (site as compile.Site).from or 1)
            checkedArtifact.sourceFile = require("nupp.compiler.fs").absolute(filename)
            checkedArtifact.sourceLine = line
            checkedArtifact.sourceColumn = column
            checkedArtifact.artifactId = hash.digest(checkedArtifact.spirv)
            gpu[program.symbol] = artifact as gpuartifact.Artifact
        else
            local refusals = compile.legalizeVectors(program, filename, selected)
            if refusals ~= nil then
                return nil, refusals
            end
            cpuPrograms[#cpuPrograms + 1] = program
        end
        loopReports[position] = loopAnalysis.program(program)
    end
    if constArtifacts ~= nil then
        for position, program in ipairs((constArtifacts as compile.Artifacts).programs) do
            if program.executionTarget == "gpu" then
                return nil, {
                    new compile.Diagnostic(
                        file = filename,
                        line = 1,
                        column = 1,
                        message = "const-specialized GPU kernels are not yet supported"
                    )
                }
            end
            programs[#programs + 1] = program
            cpuPrograms[#cpuPrograms + 1] = program
            optimizations[#optimizations + 1] = (constArtifacts as compile.Artifacts).optimizations[position]
            loopReports[#loopReports + 1] = (constArtifacts as compile.Artifacts).loops[position]
        end
    end

    -- Logical names survive lowering and verification. A project can then
    -- link several source files into one library or archive, so both forms
    -- need distinct C symbols for identically named private declarations.
    -- Inspection artifacts retain readable names unless linkage asks for
    -- qualification; the generated code and binding always change together.
    if qualifyLinkage then
        qualifySymbols(cpuPrograms, filename)
    end

    -- A file with no CPU program has no binding module to stand in front of
    -- compiled code, so the GPU replacements are the whole binding. Beside CPU
    -- programs they are not part of it: the build rewrites each GPU declaration
    -- in place from `gpu` instead.
    step("emit")
    local generatedBinding = bindingRules.module(cpuPrograms, library)
    if #cpuPrograms == 0 then
        local generatedGpuBindings: {string} = {}
        for _, program in ipairs(programs) do
            local artifact = gpu[program.symbol]
            if artifact ~= nil then
                generatedGpuBindings[#generatedGpuBindings + 1] = gpuBinding.replacement(program, artifact, browser)
            end
        end
        if #generatedGpuBindings > 0 then
            generatedBinding = table.concat(generatedGpuBindings, "\n\n") .. "\n"
        end
    end

    return new compile.Artifacts(
        programs = programs,
        optimizations = optimizations,
        loops = loopReports,
        irText = text.programs(programs),
        binding = generatedBinding,
        gpu = gpu,
        sites = sites,
        constFamilies = constArtifacts ~= nil and (constArtifacts as compile.Artifacts).constFamilies or nil
    ), diagnostics
end

export = compile
