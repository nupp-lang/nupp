module nupp.compiler.aot.hoist

-- Binds the operands of a per-lane operation to lane locals.
--
-- A `vmath`, a `vcorrected` and a `vunary` square root are emitted one lane
-- at a time, each lane taking one element of every operand. Rendering an
-- operand expression into every lane slot would recompute it once per lane,
-- so the emitter used to bind each operand inside a GNU statement expression
-- of its own. The binding is IR now: after the lane rewrite every such
-- operand is a name, declared by a `let` before the statement that reads it,
-- and the emitter only has to spell it. The verifier sees the same body the
-- emitter does, and the IR text says what is evaluated once.
local lane = require("nupp.compiler.aot.lane")
local hoist = {}

record hoist.State
    --- Fresh names for the bindings this pass introduces.
    serial: integer
end

--- The operations emitted one lane at a time, whose operands are bound.
local PER_LANE: {[string]: boolean} = {["vmath"] = true, ["vcorrected"] = true,}

--- The operations whose `args` are lane expressions, and so are walked.
local LANE_ARGS: {
    [string]: boolean
} = {
    ["vbinary"] = true,
    ["vunary"] = true,
    ["vmask"] = true,
    ["vshort"] = true,
    ["vselect"] = true,
    ["vmath"] = true,
    ["vcorrected"] = true,
    ["vbitwise"] = true,
    ["vbits"] = true,
    ["vround"] = true,
    ["vmask_cast"] = true,
    ["vconvert"] = true,
}

local function perLane(node: any): boolean
    if node.op == "vunary" then
        return (node as lane.Unary).verb == "sqrt"
    end

    return PER_LANE[tostring(node.op)] == true
end

--- Rewrites one expression, appending the bindings it needs to `bound`, in
--- the order they are read: an operand's own operands are bound before it is.
---
--- Returns a copy where anything changed and the node itself where nothing
--- did. The rewrite shares one expression between two readers -- a lane
--- loop's entry mask and its retest are the same node -- and each reader
--- binds its operands in its own place, so rewriting the node in place would
--- leave the second reading the first's binding.
local function expression(node: any, bound: {any}, state: hoist.State): any
    if LANE_ARGS[tostring(node.op)] ~= true then
        -- A leaf, a broadcast scalar or a uniform: nothing under it varies.
        return node
    end
    local args: {any} = {}
    local changed = false
    for position, argument in ipairs(node.args as {any}) do
        args[position] = expression(argument, bound, state)
        changed = changed or args[position] ~= argument
    end
    local binds = perLane(node)
    if binds then
        for _, argument in ipairs(args) do
            changed = changed or argument.op ~= "local"
        end
    end
    if not changed then
        return node
    end
    local copied: {[string]: any} = {}
    for key, value in pairs(node as {[string]: any}) do
        copied[key] = value
    end
    copied.args = args
    if not binds then
        return copied
    end
    for position, argument in ipairs(args) do
        if argument.op ~= "local" then
            state.serial = state.serial + 1
            local serial = tostring(state.serial)
            bound[
                #bound + 1
            ] = new lane.Let(
                op = "let",
                name = "$lt" .. serial,
                cName = "lt" .. serial,
                value = argument,
                type = argument.type as string,
                source = argument.source
            )
            args[
                position
            ] = new lane.Local(
                op = "local",
                name = "$lt" .. serial,
                cName = "lt" .. serial,
                type = argument.type as string,
                source = argument.source
            )
        end
    end

    return copied
end

local block: function({any}, hoist.State): {any}

--- Rewrites the expressions one statement reads, returning what to bind
--- before it.
local function statement(node: any, state: hoist.State): {any}
    local bound: {any} = {}
    local op = node.op
    if op == "let" then
        node.value = expression(node.value, bound, state)
    elseif op == "vassign" then
        for _, entry in ipairs(node.values as {any}) do
            entry.value = expression(entry.value, bound, state)
        end
    elseif op == "vreducer_add" then
        node.value = expression(node.value, bound, state)
        if node.right ~= nil then
            node.right = expression(node.right, bound, state)
        end
        if node.mask ~= nil then
            node.mask = expression(node.mask, bound, state)
        end
    elseif op == "vbreak" or op == "vcontinue" then
        node.mask = expression(node.mask, bound, state)
    elseif op == "vwhile" then
        -- The entry mask is evaluated before the loop, and the condition at
        -- the bottom of each iteration, so what the condition reads is bound
        -- at the end of the body, after everything the body binds.
        node.initial = expression(node.initial, bound, state)
        local body = block(node.body as {any}, state)
        local atBottom: {any} = {}
        node.condition = expression(node.condition, atBottom, state)
        for _, binding in ipairs(atBottom) do
            body[#body + 1] = binding
        end
        node.body = body
    elseif op == "vwhile_uniform" or op == "fornum" then
        node.body = block(node.body as {any}, state)
    end

    return bound
end

block = function(statements: {any}, state: hoist.State): {any}
    local rewritten: {any} = {}
    for _, node in ipairs(statements) do
        for _, binding in ipairs(statement(node, state)) do
            rewritten[#rewritten + 1] = binding
        end
        rewritten[#rewritten + 1] = node
    end

    return rewritten
end

--- One lane body with every per-lane operand bound.
---
--- @param serial the last serial the lane rewrite gave a name, so the names
---   this pass adds continue the sequence rather than restart it
function hoist.body(statements: {any}, serial: integer): {any}
    return block(statements, new hoist.State(serial = serial))
end

export = hoist
