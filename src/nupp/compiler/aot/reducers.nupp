@!internal
module nupp.compiler.aot.reducers

--- The closed exact and extremum reducer contracts. The older floating order
--- contracts keep their existing IR identities; these append the input element
--- so neither lowering nor verification can lose an integer's width.
local reducers = {}

record reducers.Contract
    recordName: string
    order: string
    operation: string
    element: string

    --- Whether the first argument is the element's array witness.
    witnessed: boolean

    seeded: boolean
    result: string
end

const constructors: {
    [string]: reducers.Contract
} = {
    [
        "nupp.simd.reducer.wrappingSum"
    ] = new reducers.Contract(
        recordName = "WrappingSum",
        order = "exact",
        operation = "sum",
        element = "",
        witnessed = true,
        seeded = true,
        result = ""
    ),
    [
        "nupp.simd.reducer.wrappingProduct"
    ] = new reducers.Contract(
        recordName = "WrappingProduct",
        order = "exact",
        operation = "product",
        element = "",
