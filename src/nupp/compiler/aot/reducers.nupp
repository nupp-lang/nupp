reducers.CONSTRUCTORS = constructors

function reducers.typeName(order: string, operation: string, element: string): string
    return "simd_reducer_" .. order .. "_" .. operation .. "_" .. element
end

function reducers.parse(name: string): (string?, string?, string?)
    return name:match("^simd_reducer_(%a+)_(%a+)_(%w+)$")
end

function reducers.valid(order: string, operation: string, element: string): boolean
    local integer = element == "i32" or element == "u32" or element == "i64" or element == "u64"
    if order == "exact" then
        return integer and (
            operation == "sum"
            or operation == "product"
            or operation == "and"
            or operation == "or"
            or operation == "xor"
        ) or element == "bool" and (operation == "any" or operation == "all" or operation == "count")
    end

    return (
        order == "integer" and integer or (order == "number" or order == "propagating") and element == "f64"
    ) and (operation == "min" or operation == "max" or operation == "argmin" or operation == "argmax")
end

function reducers.result(operation: string, element: string): string
    return operation == "count" and "u64" or (operation == "argmin" or operation == "argmax") and "f64" or element
end

--- Verifies a contract against the exact scoped binding identity.
function reducers.input(name: string, order: string, operation: string): string?
    local namedOrder, namedOperation, element = reducers.parse(name)
    if element ~= nil then
        if namedOrder == order and namedOperation == operation and reducers.valid(order, operation, element) then
            return element
        end
        return nil
    end
    if name == "simd_reducer_" .. order .. "_" .. operation and (
        (
            order == "ordered" or order == "pairwise" or order == "algebraic"
        ) and (
            operation == "sum" or operation == "product" or operation == "dot"
        ) or order == "compensated" and operation == "sum"
    ) then
        return "f64"
    end

    return nil
end

function reducers.method(operation: string): string
    return operation == "product" and "multiply" or (
        operation == "and" or operation == "or" or operation == "xor"
    ) and "combine" or "add"
end

function reducers.helper(order: string, operation: string, element: string): string
    return "ks_reduce_" .. order .. "_" .. operation .. "_" .. element .. "_"
end

--- Associative exact operations keep one accumulator per lane. Float extrema
--- and indexed extrema currently commit in logical order to retain their tie
--- and NaN rules; they make no reassociation promise.
function reducers.parallel(order: string): boolean
    return order == "algebraic" or order == "exact"
end

function reducers.accumulatorType(order: string, element: string, carrier: string): string
    if order == "exact" and element ~= "bool" then
        return "u" .. element:sub(2) .. "x" .. tostring(carrier:match("x(%d+)$"))
    end
    return carrier
end

function reducers.identity(operation: string): string
    return operation == "product" and "1" or (operation == "and" or operation == "all") and "-1" or "0"
end

function reducers.accumulate(
    operation: string,
    element: string,
    carrier: string,
    accumulator: string,
    value: string
): string
    local vector = reducers.accumulatorType("exact", element, carrier)
    if element ~= "bool" then
        -- Mixed gangs carry int32 exactly in binary64. A negative floating
        -- value cannot convert directly to uint32: recover its signed value
        -- first, then use the defined modulo signed-to-unsigned conversion.
        if element == "i32" and carrier:match("^f64x") ~= nil then
            value = "__builtin_convertvector(" .. value .. ", ks_i32x" .. tostring(carrier:match("x(%d+)$")) .. ")"
        end
        value = "__builtin_convertvector(" .. value .. ", ks_" .. vector .. ")"
    elseif operation == "count" then
        value = "(" .. value .. " & 1)"
    end
    local operator = ({
        sum = "+",
        product = "*",
        ["and"] = "&",
        ["or"] = "|",
        xor = "^",
        any = "|",
        all = "&",
        count = "+"
    })[operation]

    return accumulator .. " " .. tostring(operator) .. "= " .. value .. ";"
end

function reducers.finish(operation: string, element: string, reducerName: string, laneValue: string): string
    if operation == "count" then
        return reducerName .. ".count += (uint64_t)" .. laneValue .. ";"
    end
    if element == "i32" or element == "i64" then
        laneValue = "ks_reduce_" .. element .. "_bits(" .. laneValue .. ")"
    elseif element == "bool" then
        laneValue = "(" .. laneValue .. " != 0)"
    end

    return reducers.helper("exact", operation, element) .. "add(&" .. reducerName .. ", " .. laneValue .. ");"
end

--- Native scalar states are also the oracle used by scalar-source C. All
--- signed wrapping operations run in unsigned arithmetic and transfer bits,
--- avoiding signed-overflow UB and implementation-defined narrowing.
function reducers.cHelpers(): {string}
    local types: {
        [string]: string
    } = {i32 = "int32_t", u32 = "uint32_t", i64 = "int64_t", u64 = "uint64_t", bool = "bool", f64 = "double"}
    local elements = {"i32", "u32", "i64", "u64", "bool", "f64"}
    local lines: {string} = {}
    local unused = "static inline __attribute__((unused)) "
    lines[
        #lines + 1
    ] = unused
        .. "int32_t ks_reduce_i32_bits(uint32_t bits) { int32_t out; memcpy(&out, &bits, sizeof out); return out; }"
    lines[
        #lines + 1
    ] = unused
        .. "int64_t ks_reduce_i64_bits(uint64_t bits) { int64_t out; memcpy(&out, &bits, sizeof out); return out; }"
    for _, element in ipairs(elements) do
        lines[
            #lines + 1
        ] = "typedef struct { " .. tostring(
            types[element]
        ) .. " total; uint64_t count; uint64_t position; } KsReduce_" .. element .. ";"
    end
    lines[
        #lines + 1
    ] = unused
        .. "double ks_reduce_nan(void) { uint64_t bits = UINT64_C(0x7ff8000000000000); double result; memcpy(&result, &bits, sizeof result); return result; }"
    for _, element in ipairs(elements) do
        for _, order in ipairs({"exact", "integer", "propagating", "number"}) do
            for _, operation in ipairs({
                "sum",
                "product",
                "and",
                "or",
                "xor",
                "any",
                "all",
                "count",
                "min",
                "max",
                "argmin",
                "argmax"
            }) do
                if not reducers.valid(order, operation, element) then
                    continue
                end
                local ctype = types[element] as string
                local state = "KsReduce_" .. element
                local helper = reducers.helper(order, operation, element)
                lines[
                    #lines + 1
                ] = unused
                    .. state
                    .. " "
                    .. helper
                    .. "init("
                    .. ctype
                    .. " initial) { "
                    .. state
                    .. " out = {initial, 0, 0}; return out; }"
                lines[
                    #lines + 1
                ] = unused .. "void " .. helper .. "add(" .. state .. " *state, " .. ctype .. " value) {"
                if order == "exact" then
                    if element == "bool" then
                        if operation == "count" then
                            lines[#lines + 1] = "    state->count += value ? UINT64_C(1) : UINT64_C(0);"
                        else
                            lines[
                                #lines + 1
                            ] = "    state->total = state->total " .. (operation == "any" and "||" or "&&") .. " value;"
                        end
                    else
                        local operator = ({sum = "+", product = "*", ["and"] = "&", ["or"] = "|", xor = "^"})[operation]
                        local unsigned = element:sub(2) == "64" and "uint64_t" or "uint32_t"
                        lines[
                            #lines + 1
                        ] = "    "
                            .. unsigned
                            .. " bits = ("
                            .. unsigned
                            .. ")state->total "
                            .. operator
                            .. " ("
                            .. unsigned
                            .. ")value; memcpy(&state->total, &bits, sizeof bits);"
                    end
                else
                    local arg = operation == "argmin" or operation == "argmax"
                    local maximum = operation == "max" or operation == "argmax"
                    local comparison = "value " .. (maximum and ">" or "<") .. " state->total"
                    if element == "f64" then
                        local zero = maximum
                            and "(!signbit(value) && signbit(state->total))"
                            or "(signbit(value) && !signbit(state->total))"
                        comparison = "(" .. comparison .. " || (value == 0.0 && state->total == 0.0 && " .. zero .. "))"
                        comparison = order == "propagating"
                            and "(!isnan(state->total) && (isnan(value) || "
                            .. comparison
                            .. "))"
                            or "(!isnan(value) && (isnan(state->total) || "
                            .. comparison
                            .. "))"
                    end
                    if arg then
                        lines[#lines + 1] = "    ++state->count;"
                        comparison = "state->position == 0 || " .. comparison
                    end
                    lines[
                        #lines + 1
                    ] = "    if (" .. comparison .. ") { state->total = value;" .. (
                        arg and " state->position = state->count;" or ""
                    ) .. " }"
                end
                lines[#lines + 1] = "}"
                local result = operation == "count" and "state.count" or (
                    operation == "argmin" or operation == "argmax"
                )
                    and "(double)state.position"
                    or element == "f64"
                    and "(isnan(state.total) ? ks_reduce_nan() : state.total)"
                    or "state.total"
                lines[
                    #lines + 1
                ] = unused .. tostring(
                    types[reducers.result(operation, element)]
                ) .. " " .. helper .. "value(" .. state .. " state) { return " .. result .. "; }"
            end
        end
    end

    return lines
end

export = reducers
