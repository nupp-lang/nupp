--[[
Rendering verified AOT IR as C.

Generated C is a backend representation and not the safety boundary. Everything
this prints was proved before it ran -- span bounds, region relationships,
conversions, lane widths -- so nothing here decides anything, and a rule that
looks like it belongs in this file almost certainly belongs in the verifier
instead.

Two things it does owe. Numeric meaning has to survive: an ordinary operator is
binary64 and is not contracted or reassociated unless the source asked, a
physical store narrows and a physical load widens, and the explicitly
fixed-width operations round where the source said they would. And the same IR
has to render the same text every time, because an artifact cache keyed by it
would otherwise miss on every build and a fingerprint would call two identical
programs different.
]]

local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")

local emit = {}

--- The C spelling of each ordinary binary operator.
---
--- Comparisons are here too: in C they produce `int` rather than a boolean, but
--- every use this subset admits is a condition, and the IR has already typed
--- the result.
const emit.BINARY = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "!=",
    ["and"] = "&&",
    ["or"] = "||",
}

--- The C spelling of each elementwise lane verb.
---
--- Vector extensions give these their elementwise meaning, so a lane operation
--- is written as though it were scalar and the width comes from the operand
--- types rather than from the operator.
const emit.LANE_VERB = {
    ["add"] = " + ",
    ["sub"] = " - ",
    ["mul"] = " * ",
    ["div"] = " / ",
    ["lt"] = " < ",
    ["le"] = " <= ",
    ["gt"] = " > ",
    ["ge"] = " >= ",
    ["eq"] = " == ",
    ["ne"] = " != ",
}

--- The C spelling of each bitwise verb, on the gang's bit vector.
---
--- `sar` is absent: an arithmetic shift needs the operand reinterpreted as
--- signed first, so it is not one operator.
const emit.BITWISE = {["and"] = " & ", ["or"] = " | ", ["xor"] = " ^ ", ["shl"] = " << ", ["shr"] = " >> ",}

--- The C type each IR type is spelled as.
const emit.SCALAR_C = {
    ["bool"] = "bool",
    ["f64"] = "double",
    ["f32"] = "float",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
}

--- The C element type behind each vector.
const emit.VECTOR_ELEMENT_C = {["f64"] = "double", ["f32"] = "float", ["i32"] = "int32_t", ["u32"] = "uint32_t",}

--- The C type of one IR type.
---
--- A vector renders as the typedef the prelude emitted for it, and a pointer to
--- a reified struct as that struct's own C name.
---
--- @raises when the IR names a type this backend has no spelling for
function emit.cType(typeName: string): string
    local scalar = emit.SCALAR_C[typeName]
    if scalar ~= nil then
        return scalar as string
    end
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return "Ks" .. (layout as string) .. " *"
    end
    if typeName:match("^[fmiu]%d+x%d+$") ~= nil then
        return "ks_" .. typeName
    end

    error("no C type for " .. tostring(typeName), 0)
end

--- The element and lane count a vector name states.
---
--- The name is the authority rather than a table beside it, because the two
--- would otherwise be able to disagree about what `f32x8` means.
---
--- @raises when the name is not a vector type
function emit.vectorParts(vector: string): (string, integer)
    local element = vector:match("^(%a%d+)x")
    local lanes = tonumber(vector:match("x(%d+)$"))
    if element == nil or lanes == nil then
        error("not a vector type: " .. tostring(vector), 0)
    end

    return element as string, lanes as integer
end

--- A binary64 literal, spelled so C reads back exactly what Nupp meant.
---
--- A whole number needs its point, or C makes it an `int` and integer division
--- silently replaces the binary64 the source wrote.
function emit.doubleLiteral(value: string): string
    if value:match("^-?%d+$") ~= nil then
        return value .. ".0"
    end

    return value
end

--- One scalar expression, as a C expression.
---
--- Parenthesised generously: the IR carries the tree, C would reparse it by
--- precedence, and the two do not have to agree for this to be right.
function emit.scalar(node: scalarIR.Expr): string
    local operation = node.op

    if operation == "constant" then
        return emit.doubleLiteral((node as scalarIR.Constant).value)
    elseif operation == "constant_i32" then
        local integer = node as scalarIR.IntConstant
        local number = tonumber(integer.value) or 0
        if integer.type == "u32" then
            return "UINT32_C(" .. ("%.0f"):format(number) .. ")"
        elseif number == -2147483648 then
            return "(-INT32_C(2147483647) - INT32_C(1))"
        elseif number < 0 then
            return "(-INT32_C(" .. ("%.0f"):format(-number) .. "))"
        end

        return "INT32_C(" .. ("%.0f"):format(number) .. ")"
    elseif operation == "bool" then
        return (node as scalarIR.Bool).value and "true" or "false"
    elseif operation == "uniform" then
        return "p_" .. (node as scalarIR.Name).name
    elseif operation == "local" or operation == "helper_param" then
        return (node as scalarIR.Name).cName or ""
    elseif operation == "load" then
        return "p_" .. (node as scalarIR.Load).span .. "[i]"
    elseif operation == "element_ref" then
        return "(&p_" .. (node as scalarIR.ElementRef).span .. "[i])"
    elseif operation == "field_load" then
        local field = node as scalarIR.FieldLoad

        return "(" .. emit.scalar(field.object) .. "->" .. field.field .. ")"
    elseif operation == "neg" then
        return "(-(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "not" then
        return "(!(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "narrow_f64_f32" then
        return "(float)(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "widen_f32_f64" or operation == "int_to_f64" then
        return "((double)" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "numeric_cast" then
        local target = node.type == "u32" and "uint32_t" or "int32_t"

        return "((" .. target .. ")" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    end

    local operator = emit.BINARY[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "(" .. emit.scalar(binary.left) .. " " .. (operator as string) .. " " .. emit.scalar(binary.right) .. ")"
    end

    return emit.scalarCall(node)
end

--- The scalar forms that render as a call rather than an operator: the closed
--- math set, the fixed-width operations, and the corrected three.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarCall(node: scalarIR.Expr): string
    local operation = node.op

    -- C float arithmetic is single-rounded -- it does not promote to double --
    -- so this is the binary32 operation the source asked for, and the casts say
    -- so rather than relying on the operands already being float.
    local fixed = {["f32_add"] = "+", ["f32_sub"] = "-", ["f32_mul"] = "*", ["f32_div"] = "/",}
    local operator = fixed[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "((float)(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " (float)(" .. emit.scalar(binary.right) .. "))"
    end

    -- Wrapping happens in unsigned, where overflow is defined, and comes back.
    local wrapping = {["i32_add"] = "+", ["i32_sub"] = "-", ["i32_mul"] = "*"}
    operator = wrapping[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    if operation == "f32_sqrt" then
        return "sqrtf(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    end

    local corrected = {["f32_min"] = "nupp_f32_min", ["f32_max"] = "nupp_f32_max", ["f32_fma"] = "nupp_f32_fma",}
    local helper = corrected[operation]
    if helper ~= nil then
        local parts: {string} = {}
        local three = node as scalarIR.Corrected
        if three.args ~= nil then
            for position, argument in ipairs(three.args as {scalarIR.Expr}) do
                parts[position] = emit.scalar(argument)
            end
        else
            local binary = node as scalarIR.Binary
            parts[1] = emit.scalar(binary.left)
            parts[2] = emit.scalar(binary.right)
        end

        return (helper as string) .. "(" .. table.concat(parts, ", ") .. ")"
    end

    return emit.scalarBits(node)
end

--- The bitwise family, the closed math set, and a helper call.
---
--- Bitwise work happens in unsigned, where overflow and shifts are defined, and
--- comes back as int32. Shift counts are masked to 31 the way `nupp.math.i32`
--- masks them, and an arithmetic shift goes through a helper because C's `>>`
--- on a negative signed value is implementation-defined.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarBits(node: scalarIR.Expr): string
    local operation = node.op
    local binary = node as scalarIR.Binary

    if operation == "bnot" then
        return "((int32_t)(~nupp_u32(" .. emit.scalar((node as scalarIR.Unary).value) .. ")))"
    end

    local bitwise = {["band"] = "&", ["bor"] = "|", ["bxor"] = "^"}
    local operator = bitwise[operation]
    if operator ~= nil then
        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    if operation == "lshift" or operation == "rshift" or operation == "arshift" then
        local left = "nupp_u32(" .. emit.scalar(binary.left) .. ")"
        local shift = "(nupp_u32(" .. emit.scalar(binary.right) .. ") & 31u)"
        if operation == "lshift" then
            return "((int32_t)(" .. left .. " << " .. shift .. "))"
        elseif operation == "rshift" then
            return "((int32_t)(" .. left .. " >> " .. shift .. "))"
        end

        return "nupp_arshift(" .. left .. ", " .. shift .. ")"
    end

    if operation == "mod" then
        return "fmod(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    end
    if operation == "pow" then
        return "pow(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    elseif operation == "helper_call" then
        local call = node as scalarIR.HelperCall
        local parts: {string} = {}
        for position, argument in ipairs(call.args) do
            parts[position] = emit.scalar(argument)
        end

        return call.cName .. "(" .. table.concat(parts, ", ") .. ")"
    elseif operation == "math" then
        return emit.math(node as scalarIR.Math)
    end

    error("no C form for scalar operation " .. tostring(operation), 0)
end

--- One operation from the closed math set.
---
--- `min` and `max` go through helpers rather than `fmin`/`fmax`, because Lua's
--- answer for them is a comparison and not IEEE `minNum`. `deg` and `rad` are
--- multiplications rather than library calls, and a two-argument `log` is a
--- ratio, which is what ordinary Nupp computes.
---
--- @raises when the intrinsic is outside the closed set
function emit.math(node: scalarIR.Math): string
    local parts: {string} = {}
    for position, argument in ipairs(node.args) do
        parts[position] = emit.scalar(argument)
    end

    return emit.mathFrom(node.intrinsic, parts)
end

--- The same, over arguments that are already rendered.
---
--- The lane expansion needs this: it renders each argument vector once into a
--- temporary and then indexes it per lane, so what it has are strings. Passing
--- them back through the expression renderer meant wrapping each in a fictional
--- node that had to be a member of the IR without being anything the IR means.
---
--- @raises when the intrinsic is outside the closed set
function emit.mathFrom(intrinsic: string, parts: {string}): string
    if intrinsic == "min" or intrinsic == "max" then
        local call = "nupp_" .. intrinsic .. "2(" .. parts[1] .. ", " .. parts[2] .. ")"
        for position = 3, #parts do
            call = "nupp_" .. intrinsic .. "2(" .. call .. ", " .. parts[position] .. ")"
        end

        return call
    end
    if intrinsic == "log" and #parts == 2 then
        return "(log(" .. parts[1] .. ") / log(" .. parts[2] .. "))"
    end
    if intrinsic == "deg" then
        return "(" .. parts[1] .. " * (180.0 / M_PI))"
    elseif intrinsic == "rad" then
        return "(" .. parts[1] .. " * (M_PI / 180.0))"
    end

    local named = {
        ["sqrt"] = "sqrt",
        ["abs"] = "fabs",
        ["floor"] = "floor",
        ["ceil"] = "ceil",
        ["sin"] = "sin",
        ["cos"] = "cos",
        ["tan"] = "tan",
        ["asin"] = "asin",
        ["acos"] = "acos",
        ["atan"] = "atan",
        ["atan2"] = "atan2",
        ["sinh"] = "sinh",
        ["cosh"] = "cosh",
        ["tanh"] = "tanh",
        ["exp"] = "exp",
        ["log"] = "log",
        ["pow"] = "pow",
        ["fmod"] = "fmod",
    }
    local name = named[intrinsic]
    if name == nil then
        error("no C form for math operation " .. tostring(intrinsic), 0)
    end

    return (name as string) .. "(" .. table.concat(parts, ", ") .. ")"
end

--- How many lane temporaries this function has named so far.
---
--- Reset by `emit.begin`, because the same IR has to render the same C. A
--- counter that carried across functions would make one function's text depend
--- on what was compiled before it, and an artifact cache keyed on the source
--- would then be wrong rather than merely cold.
local laneTemporary = 0

--- Starts one function's emission.
function emit.begin(): nil
    laneTemporary = 0
end

--- Expands a vector operation one lane at a time, each operand evaluated once.
---
--- Without the temporaries every operand is rendered into every lane slot, so a
--- vector expression is recomputed once per lane to take one element out of it,
--- and nesting multiplies that. It is what made a memory-bound kernel eight
--- times slower lane-parallel than scalar.
---
--- @param build the scalar expression for one lane, given the temporaries
---   holding the operand vectors and which lane this is
function emit.perLane(vector: string, args: {any}, build: function({string}, integer): string): string
    laneTemporary = laneTemporary + 1

    local names: {string} = {}
    local bindings: {string} = {}
    for position, argument in ipairs(args) do
        names[position] = ("lt%d_%d"):format(laneTemporary, position)
        bindings[position] = ("ks_%s %s = %s;"):format(vector, names[position], emit.lane(argument))
    end

    local _, lanes = emit.vectorParts(vector)
    local parts: {string} = {}
    for index = 0, lanes - 1 do
        parts[index + 1] = build(names, index)
    end

    return "({ " .. table.concat(bindings, " ") .. " (ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "}; })"
end

--- Every operand of one lane operation, each taken from the same lane.
local function atLane(names: {string}, index: integer): {string}
    local parts: {string} = {}
    for position, name in ipairs(names) do
        parts[position] = name .. "[" .. tostring(index) .. "]"
    end

    return parts
end

--- One lane expression, as a C expression.
---
--- Anything that is not a lane form falls through to `emit.scalar`: a uniform
--- inside a lane expression is the same value it would be in a scalar body, and
--- rendering it twice would be two chances for the two to differ.
function emit.lane(node: lane.Expr | scalarIR.Expr): string
    local operation = node.op
    local vector = tostring(node.type)

    if operation == "vmask" then
        local mask = node as lane.MaskOp
        if mask.verb == "not" then
            return "(~" .. emit.lane(mask.args[1]) .. ")"
        else
            return "(" .. emit.lane(
                mask.args[1]
            ) .. (mask.verb == "and" and " & " or " | ") .. emit.lane(mask.args[2]) .. ")"
        end
    elseif operation == "vshort" then
        -- Both sides already ran: the rewrite proved them total before it turned
        -- the short circuit into a mask, so this is the bitwise combination and
        -- not a branch.
        local short = node as lane.ShortCircuit

        return "(" .. emit.lane(
            short.args[1]
        ) .. (short.verb == "and" and " & " or " | ") .. emit.lane(short.args[2]) .. ")"
    elseif operation == "vbinary" then
        local operator = node as lane.Binary

        return "(" .. emit.lane(
            operator.args[1]
        ) .. tostring(emit.LANE_VERB[operator.verb]) .. emit.lane(operator.args[2]) .. ")"
    elseif operation == "vunary" then
        local operator = node as lane.Unary
        if operator.verb == "neg" then
            return "(-" .. emit.lane(operator.args[1]) .. ")"
        else
            -- Elementwise, through the width's own library call, so the lane
            -- form is the same operation the scalar one performs.
            local element, lanes = emit.vectorParts(vector)
            local call = element == "f32" and "sqrtf(" or "sqrt("
            local parts: {string} = {}
            for index = 0, lanes - 1 do
                parts[index + 1] = call .. emit.lane(operator.args[1]) .. "[" .. tostring(index) .. "])"
            end

            return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
        end
    elseif operation == "vsplat" then
        return "ks_splat_" .. vector .. "(" .. emit.lane((node as lane.Splat).args[1]) .. ")"
    elseif operation == "vbool_splat" then
        -- Suffixed by the mask it produces, so two gangs can share one file.
        return "ks_bool_mask_" .. vector .. "(" .. emit.lane((node as lane.BoolSplat).args[1]) .. ")"
    elseif operation == "vselect" then
        local args = (node as lane.Select).args

        return "ks_sel_" .. vector .. "(" .. emit.lane(
            args[1]
        ) .. ", " .. emit.lane(args[2]) .. ", " .. emit.lane(args[3]) .. ")"
    elseif operation == "vfield_load" then
        local load = node as lane.FieldLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]." .. load.field
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vbitwise" then
        return emit.laneBits(node as lane.Bitwise)
    elseif operation == "vround" then
        -- Out to the narrow element and straight back. One rounding, which is
        -- what makes this the same answer as the native narrow instruction.
        local rounded = node as lane.Round

        return "__builtin_convertvector(__builtin_convertvector(" .. emit.lane(
            rounded.args[1]
        ) .. ", ks_" .. rounded.narrow .. "), ks_" .. vector .. ")"
    elseif operation == "vconvert" then
        -- The arithmetic conversion, not a reinterpretation: widening is exact
        -- and narrowing rounds once, which is what the source asked for at the
        -- point it changed width.
        return "__builtin_convertvector(" .. emit.lane((node as lane.Convert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vmask_cast" then
        -- A mask lane is all ones or all zeros, so widening sign-extends -1 to
        -- -1 and narrowing truncates it to -1. Both preserve exactly the two
        -- values a mask has, which is what makes this a conversion.
        return "__builtin_convertvector(" .. emit.lane((node as lane.MaskCast).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vbits" then
        return "__builtin_convertvector(" .. emit.lane((node as lane.BitConvert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vcorrected" then
        -- One scalar helper call per lane, the same helper the scalar body
        -- calls, so the correction cannot be right in one form and wrong in the
        -- other.
        local call = node as lane.Corrected

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return call.helper .. "(" .. table.concat(atLane(names, index), ", ") .. ")"
        end)
    elseif operation == "vmath" then
        -- One scalar call per lane, rendered through the ordinary math path so
        -- the lane-parallel form cannot drift from the scalar one. Clang
        -- recognises the shape and uses a vector library call where it has one.
        local call = node as lane.Math

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return emit.mathFrom(call.intrinsic, atLane(names, index))
        end)
    end

    return emit.scalar(node as scalarIR.Expr)
end

--- The bitwise family, on the gang's bit vector.
---
--- A shift count is masked to 31 the way `nupp.math.i32` masks it. An arithmetic
--- shift reinterprets the operand as signed first, because the bit vector is
--- unsigned and C's `>>` would otherwise fill with zeros.
function emit.laneBits(node: lane.Bitwise): string
    local verb = node.verb
    local vector = tostring(node.type)
    if verb == "not" then
        return "(~" .. emit.lane(node.args[1]) .. ")"
    elseif verb == "sar" then
        return "((ks_" .. vector .. ")(((ks_i" .. vector:sub(
            2
        ) .. ")" .. emit.lane(node.args[1]) .. ") >> (" .. emit.lane(node.args[2]) .. " & 31)))"
    end

    local right = emit.lane(node.args[2])
    if verb == "shl" or verb == "shr" then
        right = "(" .. right .. " & 31)"
    end

    return "(" .. emit.lane(node.args[1]) .. tostring(emit.BITWISE[verb]) .. right .. ")"
end

--- One reified struct, as a C type whose layout the wrapper checks.
---
--- Nothing here asserts the layout matches: the generated module compares
--- `layoutof` against what the compiled object reports, at load, before the
--- wrapper is exposed. A struct whose C compiler laid it out differently is
--- caught there rather than corrupting memory here.
function emit.layout(layout: scalarIR.Layout): {string}
    local lines: {string} = {"typedef struct {"}
    for _, field in ipairs(layout.fields) do
        lines[#lines + 1] = "    " .. emit.cType(field.type) .. " " .. field.name .. ";"
    end
    lines[#lines + 1] = "} " .. layout.cName .. ";"

    return lines
end

--- The private C signature of one kernel.
---
--- A writable span is `restrict` and a readable one is not, which is the alias
--- matrix the checker proved, stated where the C compiler can use it. Nothing
--- infers it from the pointer types.
function emit.parameters(params: {any}): string
    local parts: {string} = {}
    for position, param in ipairs(params) do
        local name = "p_" .. param.name
        local layout = param.type:match("^struct:(.+)$")
        local element = layout ~= nil and ("Ks" .. (layout as string)) or emit.cType(param.type)
        if param.kind == "write_span" then
            parts[position] = element .. " *restrict " .. name
        elseif param.kind == "read_span" then
            parts[position] = "const " .. element .. " *" .. name
        else
            parts[position] = emit.cType(param.type) .. " " .. name
        end
    end
    parts[#parts + 1] = "size_t count"

    return table.concat(parts, ", ")
end

--- Where the loop starts and stops.
---
--- A guarded range was proved in bounds before this ran, so the generated loop
--- reads it rather than checking it again. Without one the whole span is
--- covered.
function emit.bounds(rangeGuard: scalarIR.RangeGuard?): {string}
    if rangeGuard == nil then
        return {"    size_t i = 0;", "    size_t end = count;"}
    end

    return {
        "    (void)count;",
        "    size_t i = (size_t)(p_" .. rangeGuard.first .. " - 1.0);",
        "    size_t end = (size_t)p_" .. rangeGuard.last .. ";",
    }
end

--- The group loop's bounds, for a body that lowered lane-parallel.
---
--- Whole groups only. The remainder runs the same body one iteration at a time,
--- because a masked final group would still read the addresses it masked off and
--- the last element of a span may be the last byte of a page.
function emit.groupBound(lanes: integer): {string}
    local width = tostring(lanes)

    return {
        "    size_t groups = (end > i) ? ((end - i) / " .. width .. ") * " .. width .. " + i : i;",
        "    for (; i < groups; i += " .. width .. ") {",
    }
end

--- Asking one function for a relaxation the source named.
---
--- Scoped to the function rather than set as a build flag, so a relaxation one
--- function asked for cannot quietly change another's answers.
function emit.contractPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang fp contract(fast)", "#endif",}
end

--- Holding the oracle scalar.
---
--- The forced-scalar body is what the lane-parallel one is compared against, so
--- it must not share its lowering -- including whatever the C compiler would
--- have done on its own.
function emit.forcedScalarPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang loop vectorize(disable) interleave(disable)", "#endif",}
end

--- The C integer type behind each gang's mask.
---
--- A mask lane is as wide as the values it selects between, so a binary64 gang
--- masks with 64-bit lanes and a 32-bit gang with 32-bit ones.
const emit.MASK_C = {
    ["m64x4"] = "long long",
    ["m32x8"] = "int",
    ["m64x2"] = "long long",
    ["m32x4"] = "int",
    ["m32x2"] = "int",
}

--- The C integer type behind one mask.
---
--- Raises rather than returning nothing. A missing entry used to reach the
--- output as the word `nil` in a typedef, which is a C compiler's problem to
--- report on whichever target first selected that gang -- and this backend's to
--- have emitted.
---
--- @raises when the mask has no C type, which is a gang naming one nobody added
function emit.maskC(mask: string): string
    local spelling = emit.MASK_C[mask]
    if spelling == nil then
        error("no C type for the mask " .. tostring(mask), 0)
    end

    return spelling as string
end

--- What every generated file starts with.
function emit.includes(): {string}
    return {
        "/* Generated from verified test-only native C IR. */",
        "#include <math.h>",
        "#include <string.h>",
        "#include <stdbool.h>",
        "#include <stddef.h>",
        "#include <stdint.h>",
        "#ifndef M_PI",
        "#define M_PI 3.14159265358979323846264338327950288",
        "#endif",
        "",
    }
end

--- What the compiled object reports about one struct's layout.
---
--- A function per measurement rather than a table of numbers, so the answers
--- come from the C compiler that actually laid the struct out and the generated
--- wrapper can compare them against what Nupp believes.
function emit.layoutReporters(symbol: string, layout: scalarIR.Layout): {string}
    local prefix = "size_t " .. symbol .. "_layout_" .. layout.name
    local lines: {string} = {prefix .. "_size(void) { return sizeof(" .. layout.cName .. "); }"}
    for _, field in ipairs(layout.fields) do
        lines[
            #lines + 1
        ] = prefix
            .. "_offset_"
            .. field.name
            .. "(void) { return offsetof("
            .. layout.cName
            .. ", "
            .. field.name
            .. "); }"
        lines[
            #lines + 1
        ] = prefix
            .. "_size_"
            .. field.name
            .. "(void) { return sizeof((("
            .. layout.cName
            .. " *)0)->"
            .. field.name
            .. "); }"
    end

    return lines
end

--- A set's keys in a fixed order, so the same IR renders the same text.
---
--- `pairs` over a set does not order it the same way in two processes, and an
--- artifact cache keyed by the generated text would then miss on every build.
local function sortedKeys(set: {[string]: boolean}): {string}
    local names: {string} = {}
    for key in pairs(set) do
        names[#names + 1] = key
    end
    table.sort(names)

    return names
end

--- One value of the given lane, repeated across the gang.
local function repeated(value: string, lanes: integer): string
    local parts: {string} = {}
    for position = 1, lanes do
        parts[position] = value
    end

    return table.concat(parts, ", ")
end

--- The vector typedefs one gang needs.
---
--- Emitted whole, and marked unused below, so a kernel that uses one shape does
--- not fail `-Werror` for a conversion the other shape would have needed.
local function vectorTypes(shape: lane.Shape): {string}
    -- Every mask this gang uses, not only the one its algebra runs at. A gang
    -- carrying elements at several widths produces masks at several widths,
    -- because a comparison yields one bit per lane as wide as what it compared.
    -- The width comes from the mask's own name rather than from the gang, which
    -- is the widest of them and not all of them.
    local masks: {[string]: boolean} = {[shape.mask] = true}
    for _, mask in pairs(shape.maskFor or {}) do
        masks[mask] = true
    end
    local lines: {string} = {}
    for _, mask in ipairs(sortedKeys(masks)) do
        local maskElement, maskLanes = emit.vectorParts(mask)
        local maskWidth = tostring(math.floor((tonumber(maskElement:match("%d+")) or 0) / 8 * maskLanes))
        lines[
            #lines + 1
        ] = "typedef " .. emit.maskC(
            mask
        ) .. " ks_" .. mask .. " __attribute__((vector_size(" .. maskWidth .. ")));"
    end

    local vectors: {[string]: boolean} = {}
    for _, vector in pairs(shape.vectorFor) do
        vectors[vector] = true
    end
    vectors[shape.bits] = true
    -- The narrow vectors a rounding goes out through. Emitted whether or not
    -- this body rounds, like everything else in the prelude, and unused there
    -- costs a typedef.
    for _, vector in pairs(shape.rounding or {}) do
        vectors[vector] = true
    end

    for _, vector in ipairs(sortedKeys(vectors)) do
        if vector ~= shape.mask then
            local element, lanes = emit.vectorParts(vector)
            local bits = tonumber(element:match("%d+")) or 0
            local width = tostring(math.floor(bits / 8 * lanes))
            lines[
                #lines + 1
            ] = "typedef " .. tostring(
                emit.VECTOR_ELEMENT_C[element]
            ) .. " ks_" .. vector .. " __attribute__((vector_size(" .. width .. ")));"

            -- The signed companion of the bit vector, for arithmetic shift.
            if vector == shape.bits and element:sub(1, 1) == "u" then
                lines[
                    #lines + 1
                ] = "typedef int" .. tostring(
                    element:match("%d+")
                ) .. "_t ks_i" .. vector:sub(2) .. " __attribute__((vector_size(" .. width .. ")));"
            end
        end
    end

    return lines
end

--- The mask helpers, and the splat and select each value-carrying vector needs.
local function vectorHelpers(shape: lane.Shape): {string}
    local unused = "static inline __attribute__((unused)) "
    local lines: {
        string
    } = {
        unused
        .. "ks_"
        .. shape.mask
        .. " ks_mask_all_"
        .. shape.mask
        .. "(void) { return (ks_"
        .. shape.mask
        .. "){"
        .. repeated(
            "-1",
            shape.lanes
        ) .. "}; }",
        unused
        .. "ks_"
        .. shape.mask
        .. " ks_bool_mask_"
        .. shape.mask
        .. "(bool v) { return v ? ks_mask_all_"
        .. shape.mask
        .. "() : (ks_"
        .. shape.mask
        .. "){"
        .. repeated(
            "0",
            shape.lanes
        ) .. "}; }",
    }

    local terms: {string} = {}
    for index = 0, shape.lanes - 1 do
        terms[index + 1] = "m[" .. tostring(index) .. "]"
    end
    lines[
        #lines + 1
    ] = unused .. "bool ks_any_" .. shape.mask .. "(ks_" .. shape.mask .. " m) { return (" .. table.concat(
        terms,
        " | "
    ) .. ") != 0; }"

    -- A splat and a select are wanted for every vector that carries values, and
    -- for nothing else. The bit vector is not one of them in a binary64 gang --
    -- it is half the width and has no mask to pair with -- but in a 32-bit gang
    -- it is also where integers live, so membership of `vectorFor` is the test
    -- rather than whether it happens to be `shape.bits`.
    local carriers: {[string]: boolean} = {}
    for _, vector in pairs(shape.vectorFor) do
        carriers[vector] = true
    end

    for _, vector in ipairs(sortedKeys(carriers)) do
        if vector ~= shape.mask then
            local element = tostring(vector:match("^(%a%d+)x"))
            -- A select blends through the mask's own integer lanes, so the mask
            -- has to be as wide as what it selects between. That is the gang's
            -- own mask where it carries one width, and this element's where it
            -- carries several.
            local blend = tostring((shape.maskFor or {})[element as lane.Element] or shape.mask)
            lines[
                #lines + 1
            ] = unused .. "ks_" .. vector .. " ks_splat_" .. vector .. "(" .. tostring(
                emit.VECTOR_ELEMENT_C[element]
            ) .. " v) { return (ks_" .. vector .. "){" .. repeated("v", shape.lanes) .. "}; }"

            -- Blend through the mask's integer lanes. A branchless select is
            -- what makes an inactive lane keep its old value instead of
            -- computing a new one, so it must not be an arithmetic idiom:
            -- multiplying by zero turns an escaped lane's infinity into a NaN
            -- and destroys it.
            lines[
                #lines + 1
            ] = unused
                .. "ks_"
                .. vector
                .. " ks_sel_"
                .. vector
                .. "(ks_"
                .. blend
                .. " m, ks_"
                .. vector
                .. " a, ks_"
                .. vector
                .. " b) { return (ks_"
                .. vector
                .. ")((m & (ks_"
                .. blend
                .. ")a) | (~m & (ks_"
                .. blend
                .. ")b)); }"
        end
    end

    return lines
end

--- The scalar helpers the generated code calls.
---
--- The binary32 corrections are here rather than left to the C library, because
--- `nupp.math.f32` defines a canonical quiet NaN and defines `min` and `max` to
--- propagate NaN, where `fminf` and `fmaxf` return the operand that is not NaN.
--- An AOT build must not change bits that `toBits` can read back.
local function scalarHelpers(): {string}
    local unused = "static inline __attribute__((unused)) "

    return {
        unused .. "uint32_t nupp_u32(double value) { return (uint32_t)value; }",
        unused .. "uint32_t nupp_u32_i32(int32_t value) { return (uint32_t)value; }",
        unused .. "uint32_t nupp_u32_u32(uint32_t value) { return value; }",
        "#define nupp_u32(value) _Generic((value), int32_t: nupp_u32_i32, uint32_t: nupp_u32_u32, default: nupp_u32)(value)",
        unused .. "int32_t nupp_arshift(uint32_t value, uint32_t shift) {",
        "    if (shift == 0u) return (int32_t)value;",
        "    uint32_t shifted = value >> shift;",
        "    if ((value & UINT32_C(0x80000000)) != 0u) shifted |= ~(UINT32_MAX >> shift);",
        "    return (int32_t)shifted;",
        "}",
        "",
        unused .. "float nupp_f32_nan(void) {",
        "    uint32_t bits = UINT32_C(0x7fc00000);",
        "    float out;",
        "    memcpy(&out, &bits, 4);",
        "    return out;",
        "}",
        unused .. "float nupp_f32_min(float left, float right) {",
        "    if (left != left || right != right) return nupp_f32_nan();",
        "    return fminf(left, right);",
        "}",
        unused .. "float nupp_f32_max(float left, float right) {",
        "    if (left != left || right != right) return nupp_f32_nan();",
        "    return fmaxf(left, right);",
        "}",
        unused .. "float nupp_f32_fma(float a, float b, float c) {",
        "    float out = fmaf(a, b, c);",
        "    return out == out ? out : nupp_f32_nan();",
        "}",
        "",
        unused .. "double nupp_min2(double left, double right) {",
        "    return left < right ? left : right;",
        "}",
        unused .. "double nupp_max2(double left, double right) {",
        "    return left > right ? left : right;",
        "}",
        "",
    }
end

--- What one gang needs before any body that uses it.
---
--- Only the parts that depend on the gang. A file whose functions chose
--- different gangs emits this once for each of them, so anything shape
--- independent would be defined twice -- which is why the scalar helpers are
--- not here.
function emit.prelude(shape: lane.Shape): {string}
    local lines = vectorTypes(shape)
    for _, line in ipairs(vectorHelpers(shape)) do
        lines[#lines + 1] = line
    end

    return lines
end

--- The helpers no gang owns, emitted once however many gangs a file uses.
function emit.scalarPrelude(): {string}
    return scalarHelpers()
end

--- One helper's C parameter list.
local function helperParams(helper: scalarIR.Helper): string
    local parts: {string} = {}
    for position, param in ipairs(helper.params) do
        parts[position] = emit.cType(param.type) .. " " .. tostring(param.cName)
    end

    return table.concat(parts, ", ")
end

--- The visible pure helpers, as C.
---
--- Result structs first, then every prototype, then every definition, so a
--- helper may call one declared after it. Each is `static inline`, because they
--- exist to be inlined into the loop and a helper that survived as a call would
--- be a call in the innermost loop of the program.
function emit.helpers(helpers: {scalarIR.Helper}): {string}
    local lines: {string} = {}
    for _, helper in ipairs(helpers) do
        if #helper.resultTypes > 1 then
            helper.cResult = helper.cName .. "_result"
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(helper.resultTypes) do
                lines[#lines + 1] = "    " .. emit.cType(resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. tostring(helper.cResult) .. ";"
        end
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        local result = helper.cResult or emit.cType(helper.resultType)
        lines[#lines + 1] = "static inline " .. result .. " " .. helper.cName .. "(" .. helperParams(helper) .. ");"
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        local result = helper.cResult or emit.cType(helper.resultType)
        lines[#lines + 1] = "static inline " .. result .. " " .. helper.cName .. "(" .. helperParams(helper) .. ") {"
        if helper.cResult ~= nil then
            local values: {string} = {}
            for position, value in ipairs(helper.values) do
                values[position] = emit.lane(value)
            end
            lines[
                #lines + 1
            ] = "    " .. tostring(helper.cResult) .. " result = {" .. table.concat(values, ", ") .. "};"
            lines[#lines + 1] = "    return result;"
        else
            lines[#lines + 1] = "    return " .. emit.lane(helper.values[1]) .. ";"
        end
        lines[#lines + 1] = "}"
        lines[#lines + 1] = ""
    end

    return lines
end

--- What a block needs from the program around it.
record emit.Body
    --- The helpers, for a multiple binding that has to name a call's result
    --- struct.
    helpers: {scalarIR.Helper}

    --- How wide a lane store is, for a body that was rewritten.
    lanes: integer
end

--- The C type one local is declared with.
---
--- A pointer to a struct element carries its own constness, because that is
--- where a shared borrow stops being writable as far as C is concerned.
local function localCType(typeName: string, mutable: boolean): string
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return (mutable and "" or "const ") .. "Ks" .. tostring(layout) .. " *"
    end

    return emit.cType(typeName) .. " "
end

--- One block of statements, scalar or lane, indented by `depth`.
function emit.block(statements: {any}, depth: integer, body: emit.Body): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)
    local temporary = 0

    --- Appends the rendering of a nested block.
    local function nested(inner: {any}): nil
        for _, line in ipairs(emit.block(inner, depth + 1, body)) do
            lines[#lines + 1] = line
        end
    end

    for _, statement in ipairs(statements) do
        local op = statement.op
        if op == "let" then
            lines[
                #lines + 1
            ] = prefix .. localCType(
                statement.type,
                statement.value.mutable == true
            ) .. statement.cName .. " = " .. emit.lane(statement.value) .. ";"
        elseif op == "multi_let" then
            temporary = temporary + 1

            local result = ""
            for _, candidate in ipairs(body.helpers) do
                if candidate.name == statement.call.helper then
                    result = tostring(candidate.cResult)
                end
            end

            local temp = "mr" .. tostring(temporary)
            lines[#lines + 1] = prefix .. result .. " " .. temp .. " = " .. emit.lane(statement.call) .. ";"
            for position, bound in ipairs(statement.bindings) do
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    bound.type
                ) .. " " .. bound.cName .. " = " .. temp .. ".v" .. tostring(position) .. ";"
            end
        elseif op == "store" then
            lines[
                #lines + 1
            ] = prefix .. scalarIR.cIdentifier("p", statement.span) .. "[i] = " .. emit.lane(statement.value) .. ";"
        elseif op == "assign" then
            -- Every value into a temporary before any is stored, because
            -- `a, b = b, a` means what it says and storing as it went would not.
            local temps: {string} = {}
            for position, entry in ipairs(statement.values) do
                temporary = temporary + 1
                temps[position] = "as" .. tostring(temporary)
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    entry.target.type
                ) .. " " .. temps[position] .. " = " .. emit.lane(entry.value) .. ";"
            end
            for position, entry in ipairs(statement.values) do
                local target = entry.target.kind == "local" and entry.target.cName or "(" .. emit.lane(
                    entry.target.object
                ) .. "->" .. entry.target.field .. ")"
                lines[#lines + 1] = prefix .. target .. " = " .. temps[position] .. ";"
            end
        elseif op == "vassign" then
            for _, entry in ipairs(statement.values) do
                local target = entry.target
                if target.kind == "vfield" then
                    -- Consecutive elements, one lane each. Clang turns the group
                    -- into an interleaving store where the target has one.
                    lines[#lines + 1] = prefix .. "{"
                    lines[
                        #lines + 1
                    ] = prefix .. "    " .. emit.cType(entry.value.type) .. " lanes = " .. emit.lane(entry.value) .. ";"
                    for index = 0, body.lanes - 1 do
                        lines[
                            #lines + 1
                        ] = prefix .. "    p_" .. target.span .. "[i + " .. tostring(
                            index
                        ) .. "]." .. target.field .. " = (" .. emit.cType(
                            target.scalarType
                        ) .. ")lanes[" .. tostring(index) .. "];"
                    end
                    lines[#lines + 1] = prefix .. "}"
                else
                    lines[#lines + 1] = prefix .. target.cName .. " = " .. emit.lane(entry.value) .. ";"
                end
            end
        elseif op == "if" then
            local nativeSwitch = statement.nativeSwitch
            if nativeSwitch and #nativeSwitch.arms == #statement.clauses then
                lines[#lines + 1] = prefix .. "switch (" .. emit.scalar(nativeSwitch.selector) .. ") {"
                for position, arm in ipairs(nativeSwitch.arms) do
                    for _, label in ipairs(arm.labels) do
                        local constant = new scalarIR.IntConstant(
                            op = "constant_i32",
                            value = label.value,
                            type = label.type,
                            source = label.source
                        )
                        lines[#lines + 1] = prefix .. "case " .. emit.scalar(constant) .. ":"
                    end
                    nested(statement.clauses[position].body)
                    lines[#lines + 1] = prefix .. "    break;"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "default:"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "    break;"
                end
                lines[#lines + 1] = prefix .. "}"
            else
                for position, clause in ipairs(statement.clauses) do
                    lines[
                        #lines + 1
                    ] = prefix .. (position == 1 and "if (" or "else if (") .. emit.lane(clause.condition) .. ") {"
                    nested(clause.body)
                    lines[#lines + 1] = prefix .. "}"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "else {"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "}"
                end
            end
        elseif op == "vwhile" then
            -- The loop runs while any lane is live, and a lane that retired
            -- stops contributing without stopping the others.
            lines[
                #lines + 1
            ] = prefix .. emit.cType(
                statement.live.type
            ) .. " " .. statement.live.cName .. " = " .. emit.lane(statement.initial) .. ";"
            lines[
                #lines + 1
            ] = prefix .. "while (ks_any_" .. tostring(statement.live.type) .. "(" .. statement.live.cName .. ")) {"
            lines[
                #lines + 1
            ] = prefix .. "    " .. emit.cType(
                statement.executing.type
            ) .. " " .. statement.executing.cName .. " = " .. statement.live.cName .. ";"
            nested(statement.body)
            lines[
                #lines + 1
            ] = prefix .. "    " .. statement.live.cName .. " &= " .. emit.lane(statement.condition) .. ";"
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vwhile_uniform" then
            -- An ordinary loop over lane-parallel statements. The condition is
            -- scalar, so this is the same `while` the scalar body emits.
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vbreak" then
            local mask = emit.lane(statement.mask)
            lines[#lines + 1] = prefix .. statement.live.cName .. " &= ~(" .. mask .. ");"
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. mask .. ");"
        elseif op == "vcontinue" then
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. emit.lane(statement.mask) .. ");"
        elseif op == "fornum" then
            local counter = statement.binding.cName
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. counter .. " = " .. emit.lane(
                statement.from
            ) .. "; " .. counter .. " <= (int32_t)" .. emit.lane(statement.to) .. "; ++" .. counter .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "while" then
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "block" then
            lines[#lines + 1] = prefix .. "{"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        else
            lines[#lines + 1] = prefix .. op .. ";"
        end
    end

    return lines
end

--- One or more programs, as one C file.
---
--- Everything shared is emitted once and everything per function once each: the
--- includes, a struct typedef, and a gang's prelude are shared, while the layout
--- reporters, the helpers and the two function bodies belong to the function
--- that needed them. Two functions reifying one struct get one typedef and two
--- sets of reporters, because a reporter is named after the symbol whose wrapper
--- checks it.
---
--- Two definitions of the same function come out per program: the real one, and
--- a forced-scalar one that is the oracle the lane-parallel body is diffed
--- against. The oracle must not share the real body's lowering, which is why it
--- keeps the scalar statements and carries a pragma refusing vectorisation --
--- including whatever the C compiler would have done on its own.
function emit.program(programs: {scalarIR.Program}): string
    emit.begin()

    local lines = emit.includes()
    local declared: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        for _, layout in ipairs(program.layouts or {}) do
            if not declared[layout.name] then
                declared[layout.name] = true
                for _, line in ipairs(emit.layout(layout)) do
                    lines[#lines + 1] = line
                end
                lines[#lines + 1] = ""
            end
            for _, line in ipairs(emit.layoutReporters(program.symbol, layout)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = ""
        end
    end

    -- One prelude per distinct gang. A file whose functions chose different
    -- gangs needs both, and the mask helpers are suffixed by their mask so the
    -- two sets do not collide.
    local emitted: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        local lanes = program.lanes
        local shape = lanes ~= nil and lane.SHAPE_BY_NAME[(lanes as scalarIR.LaneBody).shape] or lane.SHAPES[1]
        local named = (shape as lane.Shape).name
        if not emitted[named] then
            emitted[named] = true
            for _, line in ipairs(emit.prelude(shape as lane.Shape)) do
                lines[#lines + 1] = line
            end
        end
    end

    for _, line in ipairs(emit.scalarPrelude()) do
        lines[#lines + 1] = line
    end

    for _, program in ipairs(programs) do
        local helpers = program.helpers or {}
        for _, line in ipairs(emit.helpers(helpers)) do
            lines[#lines + 1] = line
        end

        local lanes = program.lanes
        local width = lanes ~= nil and (lanes as scalarIR.LaneBody).lanes or 0
        local body = new emit.Body(helpers = helpers, lanes = width)
        local params = emit.parameters(program.params)

        --- One C definition of the kernel.
        local function implementation(symbol: string, forced: boolean): nil
            lines[#lines + 1] = "__attribute__((noinline))"
            lines[#lines + 1] = "void " .. symbol .. "(" .. params .. ") {"
            if program.fpContract == true then
                for _, line in ipairs(emit.contractPragma()) do
                    lines[#lines + 1] = line
                end
            end
            for _, line in ipairs(emit.bounds(program.rangeGuard)) do
                lines[#lines + 1] = line
            end
            if forced then
                for _, line in ipairs(emit.forcedScalarPragma()) do
                    lines[#lines + 1] = line
                end
            end
            if lanes ~= nil and not forced then
                for _, line in ipairs(emit.groupBound(width)) do
                    lines[#lines + 1] = line
                end
                for _, line in ipairs(emit.block((lanes as scalarIR.LaneBody).statements, 2, body)) do
                    lines[#lines + 1] = line
                end
                lines[#lines + 1] = "    }"
            end
            lines[#lines + 1] = "    for (; i < end; ++i) {"
            for _, line in ipairs(emit.block(program.loop.statements, 2, body)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = "    }"
            lines[#lines + 1] = "}"
            lines[#lines + 1] = ""
        end

        implementation(program.symbol .. "_forced_scalar", true)
        implementation(program.symbol, false)
    end

    return table.concat(lines, "\n") .. "\n"
end

return emit
