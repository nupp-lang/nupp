module nupp.compiler.aot.emit

--[[
Rendering verified AOT IR as C.

Generated C is a backend representation and not the safety boundary. Everything
this prints was proved before it ran -- span bounds, region relationships,
conversions, lane widths -- so nothing here decides anything, and a rule that
looks like it belongs in this file almost certainly belongs in the verifier
instead.

Two things it does owe. Numeric meaning has to survive: an ordinary operator is
binary64 and is not contracted or reassociated unless the source asked, a
physical store narrows and a physical load widens, and the explicitly
fixed-width operations round where the source said they would. And the same IR
has to render the same text every time, because an artifact cache keyed by it
would otherwise miss on every build and a fingerprint would call two identical
programs different.
]]

local admit = require("nupp.compiler.aot.admit")
local bundled = require("nupp.compiler.bundled")
local reducers = require("nupp.compiler.aot.reducers")
local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")
local target = require("nupp.compiler.aot.target")
local verify = require("nupp.compiler.aot.verify")
local visit = require("nupp.compiler.aot.visit")
local simdcast = require("nupp.compiler.aot.simdcast")

local emit = {}
local explicitWidth = 0
local explicitScalar = false
local independentSpanCounts = true
local explicitFixedTypes: {[string]: boolean} = {}

--- One of the C headers under `aot/include`, as the lines of its text.
---
--- The program-independent parts of a generated file are written as C and
--- carried with the compiler like any other resource, and a file gets each of
--- them appended rather than included so `emit-c` and the wasm build keep one
--- self-contained translation unit. What a header is for and what it may be
--- conditioned on is at its top.
--- @raises when this compiler carries no header by that name
local function carried(name: string): {string}
    local text = bundled.source("/aot/include/" .. name)
    if text == nil then
        error("this compiler carries no /aot/include/" .. name)
    end
    local lines: {string} = {}
    for line in ((text as string) .. "\n"):gmatch("(.-)\n") do
        lines[#lines + 1] = line
    end
    if lines[#lines] == "" then
        lines[#lines] = nil
    end

    return lines
end

--- The C operator each single-rounded binary32 operation is.
const F32_OPERATORS = {["f32_add"] = "+", ["f32_sub"] = "-", ["f32_mul"] = "*", ["f32_div"] = "/",}

--- The C operator each wrapping int32 operation is, applied in unsigned.
const I32_WRAPPING_OPERATORS = {["i32_add"] = "+", ["i32_sub"] = "-", ["i32_mul"] = "*",}

--- The C operator each uint32 operation is.
const U32_OPERATORS = {
    ["u32_add"] = "+",
    ["u32_sub"] = "-",
    ["u32_mul"] = "*",
    ["u32_and"] = "&",
    ["u32_or"] = "|",
    ["u32_xor"] = "^",
}

--- The C operator each 64-bit operation is, applied in unsigned and cast back.
const WIDE_OPERATORS = {
    ["u64_add"] = "+",
    ["u64_sub"] = "-",
    ["u64_mul"] = "*",
    ["u64_and"] = "&",
    ["u64_or"] = "|",
    ["u64_xor"] = "^",
    ["i64_add"] = "+",
    ["i64_sub"] = "-",
    ["i64_mul"] = "*",
}

--- The C library function each math intrinsic calls.
const MATH_C = {
    ["sqrt"] = "sqrt",
    ["abs"] = "fabs",
    ["floor"] = "floor",
    ["ceil"] = "ceil",
    ["sin"] = "sin",
    ["cos"] = "cos",
    ["tan"] = "tan",
    ["asin"] = "asin",
    ["acos"] = "acos",
    ["atan"] = "atan",
    ["atan2"] = "atan2",
    ["sinh"] = "sinh",
    ["cosh"] = "cosh",
    ["tanh"] = "tanh",
    ["exp"] = "exp",
    ["log"] = "log",
    ["pow"] = "pow",
    ["fmod"] = "fmod",
}

--- The 64-bit mask operations that render as one `ks_mask64_*` helper call,
--- by the verb the helper is named for.
const MASK64_BINARY = {
    ["simd_mask64_add"] = "add",
    ["simd_mask64_and"] = "and",
    ["simd_mask64_or"] = "or",
    ["simd_mask64_xor"] = "xor",
    ["simd_mask64_shl"] = "shl",
    ["simd_mask64_shr"] = "shr",
    ["simd_mask64_prefix_xor"] = "prefix_xor",
}

const MASK64_UNARY = {
    ["simd_mask64_not"] = "not",
    ["simd_mask64_any"] = "any",
    ["simd_mask64_count"] = "count",
    ["simd_mask64_first"] = "first",
    ["simd_mask64_clear_first"] = "clear_first",
}

--- The block-of-64 SIMD operations that render as one helper call over their
--- arguments in order: the helper's name, then the C prefix each argument
--- takes -- an address, a byte narrowing, or nothing.
const BLOCK64_CALLS = {
    ["simd_block64_load_u8"] = {"block64_load_", "&", ""},
    ["simd_block64_and_byte_u8"] = {"block64_and_byte_", "", "(uint8_t)"},
    ["simd_block64_and_u8"] = {"block64_and_", "", ""},
    ["simd_block64_shr_u8"] = {"block64_shr_", "", ""},
    ["simd_block64_lookup16_u8"] = {"block64_lookup16_", "", ""},
    ["simd_block64_any_bits_u8"] = {"block64_any_bits_", "", "(uint8_t)"},
    ["simd_block64_last_u8"] = {"block64_last_", ""},
    ["simd_block64_utf8_errors_u8"] = {"block64_utf8_errors_", "", "", "", "", ""},
    ["simd_block64_eq_u8"] = {"block64_eq_", "", "(uint8_t)"},
    ["simd_block64_range_u8"] = {"block64_range_", "", "(uint8_t)", "(uint8_t)"},
    ["simd_block64_outside_range_u8"] = {"block64_outside_range_", "", "(uint8_t)", "(uint8_t)"},
}

--- One scratch write as a C statement: `helper` or its `_fixed` form, which
--- takes the buffer's compile-time width as a last argument.
local function scratchWrite(helper: string, statement: any, prefix: string): string
    local fixed = statement.fixedBound ~= nil and ", " .. tostring(statement.fixedBound) .. "u" or ""

    return prefix .. helper .. (
        statement.fixedBound ~= nil and "_fixed" or ""
    ) .. "(L, &" .. tostring(
        (statement.scratch as scalarIR.Name).cName
    ) .. ", " .. emit.scalar(
        statement.index as scalarIR.Expr
    ) .. ", " .. emit.scalar(statement.value as scalarIR.Expr) .. fixed .. ");"
end

--- The rooted bytes, their length and the slice bounds one substring names,
--- as the C helpers that take a slice spell them. An absent last bound is the
--- whole length.
local function substringArguments(sliced: scalarIR.LuaSubstring): string
    local bytes = sliced.bytes as scalarIR.Name

    return "ks_bytes_" .. tostring(
        bytes.cName
    ) .. ", ks_length_" .. tostring(
        bytes.cName
    ) .. ", " .. emit.scalar(
        sliced.first
    ) .. ", " .. (
        sliced.last ~= nil and emit.scalar(
            sliced.last as scalarIR.Expr
        ) or "(double)ks_length_" .. tostring(bytes.cName)
    )
end

local reusableScratchName: string? = nil
local builderEager = false
local fpTranscendentals = false

----------------------------------------------------------------------------
-- Names, types and literals
----------------------------------------------------------------------------

--- The exported spelling of a logical program symbol in one tier.
local function physicalSymbol(symbol: string, tier: string?): string
    return tier ~= nil and target.symbol(symbol, tier as string) or symbol
end

--- The C spelling of each ordinary binary operator.
---
--- Comparisons are here too: in C they produce `int` rather than a boolean, but
--- every use this subset admits is a condition, and the IR has already typed
--- the result.
const emit.BINARY = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "!=",
    ["and"] = "&&",
    ["or"] = "||",
}

--- How each comparison reads with its operands swapped.
local COMPARISON_SWAP: {
    [string]: string
} = {["lt"] = "gt", ["le"] = "ge", ["gt"] = "lt", ["ge"] = "le", ["eq"] = "eq", ["ne"] = "ne",}

local SIGNED_FIXED: {[string]: boolean} = {["i32"] = true, ["i64"] = true}

local INTEGER_FIXED: {[string]: boolean} = {["i32"] = true, ["u32"] = true, ["i64"] = true, ["u64"] = true}

--- The C spelling of each elementwise lane verb.
---
--- Vector extensions give these their elementwise meaning, so a lane operation
--- is written as though it were scalar and the width comes from the operand
--- types rather than from the operator.
const emit.LANE_VERB = {
    ["add"] = " + ",
    ["sub"] = " - ",
    ["mul"] = " * ",
    ["div"] = " / ",
    ["lt"] = " < ",
    ["le"] = " <= ",
    ["gt"] = " > ",
    ["ge"] = " >= ",
    ["eq"] = " == ",
    ["ne"] = " != ",
}

--- The C spelling of each bitwise verb, on the gang's bit vector.
---
--- `sar` is absent: an arithmetic shift needs the operand reinterpreted as
--- signed first, so it is not one operator.
const emit.BITWISE = {["and"] = " & ", ["or"] = " | ", ["xor"] = " ^ ", ["shl"] = " << ", ["shr"] = " >> ",}

--- The C type each IR type is spelled as.
const emit.SCALAR_C = {
    ["bool"] = "bool",
    ["f64"] = "double",
    ["f32"] = "float",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
    ["i64"] = "int64_t",
    ["u64"] = "uint64_t",
}

--- The C spelling of physical storage, distinct from the value a load creates.
const emit.SOURCE_C = {
    ["number"] = "double",
    ["float"] = "float",
    ["int8"] = "int8_t",
    ["int16"] = "int16_t",
    ["int32"] = "int32_t",
    ["uint8"] = "uint8_t",
    ["uint16"] = "uint16_t",
    ["uint32"] = "uint32_t",
    ["int64"] = "int64_t",
    ["uint64"] = "uint64_t",
}

--- The C element type behind each vector.
const emit.VECTOR_ELEMENT_C = {
    ["f64"] = "double",
    ["f32"] = "float",
    ["i8"] = "int8_t",
    ["u8"] = "uint8_t",
    ["i16"] = "int16_t",
    ["u16"] = "uint16_t",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
    ["i64"] = "int64_t",
    ["u64"] = "uint64_t",
}

--- Resolves one target-neutral explicit SIMD type for the selected tier.
local function explicitType(typeName: string): (string?, string?, integer?, string?)
    local family, element, shape = typeName:match("^simd_(%a+)_([fiu]%d+)_(.+)$")
    if family == nil or element == nil or shape == nil then
        return nil, nil, nil, nil
    end
    local bits = tonumber((element as string):match("%d+"))
    local lanes: integer? = nil
    if shape == "preferred" and bits ~= nil and bits > 0 then
        lanes = math.floor(explicitWidth * 8 / bits) as integer
    else
        lanes = tonumber((shape as string):match("^fixed(%d+)$")) as integer?
    end

    return family, element, lanes, shape
end

--- Whether an IR type is one general explicit SIMD family application.
local function genericSimdType(typeName: string): boolean
    return typeName:match(
        "^simd_vector_"
    ) ~= nil or typeName:match("^simd_mask_") ~= nil or typeName:match("^simd_species_") ~= nil
end

--- The C type of one IR type.
---
--- A vector renders as the typedef the prelude emitted for it, and a pointer to
--- a reified struct as that struct's own C name.
---
--- @raises when the IR names a type this backend has no spelling for
function emit.cType(typeName: string): string
    local scalar = emit.SCALAR_C[typeName]
    if scalar ~= nil then
        return scalar as string
    end
    local explicitFamily, explicitElement, explicitLanes = explicitType(typeName)
    if explicitFamily ~= nil then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        local suffix = tostring(explicitElement) .. "x" .. tostring(explicitLanes)
        if explicitFamily == "species" then
            return "uint32_t"
        elseif explicitFamily == "vector" then
            return (explicitScalar and "ks_scalar_exp_" or "ks_exp_") .. suffix
        elseif explicitFamily == "mask" then
            return (explicitScalar and "ks_scalar_exp_mask_" or "ks_exp_mask_") .. suffix
        elseif explicitFamily == "bitmask" then
            return "uint64_t"
        end
    end
    if typeName == "simd_species_u8" then
        return "uint32_t"
    elseif typeName == "simd_vector_u8" or typeName == "simd_mask_u8" then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        return (explicitScalar and "ks_scalar_u8x" or "ks_u8x") .. tostring(explicitWidth)
    elseif typeName == "simd_mask_bits64" then
        return "KsMaskBits64"
    elseif typeName == "simd_table_u8x16" then
        return "KsTableU8x16"
    elseif typeName == "simd_padded_string_u8" then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        return "KsPaddedStringU8x" .. tostring(explicitWidth)
    elseif typeName == "simd_block_u8x64" then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        return (explicitScalar and "KsScalarBlockU8x64x" or "KsBlockU8x64x") .. tostring(explicitWidth)
    elseif typeName == "simd_reducer_pairwise_sum"
        or typeName == "simd_reducer_pairwise_product"
        or typeName == "simd_reducer_pairwise_dot"
    then
        return "KsPairwiseF64"
    elseif typeName == "simd_reducer_compensated_sum" then
        return "KsCompensatedF64"
    elseif typeName == "simd_reducer_ordered_sum"
        or typeName == "simd_reducer_algebraic_sum"
        or typeName == "simd_reducer_ordered_product"
        or typeName == "simd_reducer_algebraic_product"
        or typeName == "simd_reducer_ordered_dot"
        or typeName == "simd_reducer_algebraic_dot"
    then
        return "double"
    end
    local _, _, reducerElement = reducers.parse(typeName)
    if reducerElement ~= nil then
        return "KsReduce_" .. reducerElement
    end
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return "Ks" .. (layout as string) .. " *"
    end
    if typeName:match("^[fmiu]%d+x%d+$") ~= nil then
        return "ks_" .. typeName
    end

    error("no C type for " .. tostring(typeName), 0)
end

--- The physical C element type for a scalar span or field.
---
--- @raises when the physical source type has no C spelling
function emit.storageC(valueType: string, sourceType: string?): string
    if sourceType ~= nil then
        local physical = emit.SOURCE_C[sourceType as string]
        if physical ~= nil then
            return physical as string
        end
        error("no C storage type for " .. tostring(sourceType), 0)
    end

    return emit.cType(valueType)
end

--- The element and lane count a vector name states.
---
--- The name is the authority rather than a table beside it, because the two
--- would otherwise be able to disagree about what `f32x8` means.
---
--- @raises when the name is not a vector type
function emit.vectorParts(vector: string): (string, integer)
    local element = vector:match("^(%a%d+)x")
    local lanes = tonumber(vector:match("x(%d+)$"))
    if element == nil or lanes == nil then
        error("not a vector type: " .. tostring(vector), 0)
    end

    return element as string, lanes as integer
end

--- A binary64 literal, spelled so C reads back exactly what Nupp meant.
---
--- A whole number needs its point, or C makes it an `int` and integer division
--- silently replaces the binary64 the source wrote.
function emit.doubleLiteral(value: string): string
    if value:match("^-?%d+$") ~= nil then
        return value .. ".0"
    end

    return value
end

----------------------------------------------------------------------------
-- Scalar expressions
----------------------------------------------------------------------------

local luaSite: function(source: scalarIR.Source?): string

--- A value comparison for the mixed pairings C converts lossily.
---
--- C's usual arithmetic conversions decide a mixed comparison by converting
--- the signed operand to unsigned, or an integer operand to binary32, so the
--- The C helper family a reducer whose state is more than one `double` uses.
---
--- Ordered and algebraic reducers accumulate into a bare `double`, so they have
--- none and every site answering nil here emits an operator instead. Naming the
--- two that do in one place keeps the six sites that construct, contribute to
--- and finalize a reducer from each growing their own copy of the list.
local function reducerHelper(order: string, operation: string, element: string?): string?
    if element ~= nil and reducers.valid(order, operation, element) then
        return reducers.helper(order, operation, element)
    end
    if order == "pairwise" then
        return operation == "product" and "ks_pairwise_f64_product_" or "ks_pairwise_f64_"
    elseif order == "compensated" then
        return "ks_compensated_f64_"
    end

    return nil
end

--- bare operator answers a different question than the source wrote and the
--- constant folder answers. Pairings whose implicit conversion preserves the
--- value keep the bare operator; the rest compare by value here.
--- The integer under a binary64 promotion, if the operand is one.
local function integerOperand(node: scalarIR.Expr): scalarIR.Expr?
    if INTEGER_FIXED[tostring(node.type)] == true then
        return node
    end
    local widened = node as any
    if widened.op == "int_to_f64" and INTEGER_FIXED[tostring((widened.value as scalarIR.Expr).type)] == true then
        return widened.value as scalarIR.Expr
    end

    return nil
end

--- A comparison between a span's count and an integer, made in integers.
---
--- The count is a `size_t` the IR carries as binary64, and the cursor idiom
--- compares a `uint32` against it on every iteration. Written as the double
--- comparison the types say, that is a conversion and a float compare each
--- time, and the C compiler cannot carry the bound it establishes to the
--- vector load it guards. Both operands are exact as integers, so the answer
--- is the same and the bound is visible.
local function countComparison(operation: string, left: scalarIR.Expr, right: scalarIR.Expr): string?
    if COMPARISON_SWAP[operation] == nil then
        return nil
    end
    local counted, other, swapped = left, right, false
    if counted.op ~= "span_count" then
        counted, other, swapped = right, left, true
    end
    if counted.op ~= "span_count" then
        return nil
    end
    local integer = integerOperand(other)
    if integer == nil then
        return nil
    end
    local count = independentSpanCounts and "count_" .. (counted as scalarIR.SpanCount).span or "count"
    local operator = emit.BINARY[operation] as string
    local relation = swapped and operation or COMPARISON_SWAP[operation] as string
    if SIGNED_FIXED[tostring((integer as scalarIR.Expr).type)] == true then
        return "ks_" .. relation .. "_i64_u64((int64_t)" .. emit.scalar(
            integer as scalarIR.Expr
        ) .. ", (uint64_t)" .. count .. ")"
    end
    if swapped then
        return "((uint64_t)" .. emit.scalar(
            integer as scalarIR.Expr
        ) .. " " .. operator .. " (uint64_t)" .. count .. ")"
    end

    return "((uint64_t)" .. count .. " " .. operator .. " (uint64_t)" .. emit.scalar(integer as scalarIR.Expr) .. ")"
end

local function mixedComparison(operation: string, left: scalarIR.Expr, right: scalarIR.Expr): string?
    local counted = countComparison(operation, left, right)
    if counted ~= nil then
        return counted
    end
    if COMPARISON_SWAP[operation] == nil or left.type == right.type then
        return nil
    end
    local operator = emit.BINARY[operation] as string
    local leftType, rightType = tostring(left.type), tostring(right.type)
    -- A binary32 operand drags the integer to float; both are exact in binary64.
    if (
        leftType == "f32" and INTEGER_FIXED[rightType] == true
    ) or (rightType == "f32" and INTEGER_FIXED[leftType] == true) then
        return "((double)" .. emit.scalar(left) .. " " .. operator .. " (double)" .. emit.scalar(right) .. ")"
    end
    -- int32 and uint32 both convert exactly into int64. Through a helper rather
    -- than as the widened operator written here: a widened int32 cannot reach
    -- uint32's upper half, so against a constant up there the comparison folds
    -- to a constant, which is the answer the source asked for and which
    -- `-Wtype-limits` refuses when it can see both operands at the site.
    if (leftType == "i32" and rightType == "u32") or (leftType == "u32" and rightType == "i32") then
        return "ks_" .. operation .. "_i32_u32(" .. emit.scalar(left) .. ", " .. emit.scalar(right) .. ")"
    end
    -- uint64 wins the usual conversions against any signed width, so a helper
    -- checks the signed operand's sign before comparing in unsigned.
    if SIGNED_FIXED[leftType] == true and rightType == "u64" then
        return "ks_" .. operation .. "_i64_u64(" .. emit.scalar(left) .. ", " .. emit.scalar(right) .. ")"
    end
    if leftType == "u64" and SIGNED_FIXED[rightType] == true then
        local swapped = COMPARISON_SWAP[operation] as string

        return "ks_" .. swapped .. "_i64_u64(" .. emit.scalar(right) .. ", " .. emit.scalar(left) .. ")"
    end

    return nil
end

--- Constant lane selections let the C backend form target shuffles without
--- runtime indices. Helper parameters ensure every input is evaluated once.
function emit.rearrange(node: scalarIR.Simd): string
    local _, element, lanes, shape = explicitType(node.type)
    local width = lanes as integer
    local native = math.floor(explicitWidth * 8 / (tonumber((element as string):match("%d+")) as number))
    local composite = shape ~= "preferred" and width ~= native
    local part = tonumber((node.args[#node.args] as scalarIR.Constant).value) as integer
    local selected: {string} = {}
    for i = 0, width - 1 do
        local row: integer = 0
        local index: integer = 0
        if node.intrinsic == "interleave" then
            local position = part * width + i
            row = position % 2
            index = math.floor(position / 2) as integer
        elseif node.intrinsic == "deinterleave" then
            local position = i * 2 + part
            row = math.floor(position / width) as integer
            index = position % width
        else
            row = i
            index = part
        end
        local value = "(" .. emit.scalar(node.args[row + 1]) .. ")"
        if explicitScalar then
            selected[i + 1] = value .. ".lane[" .. tostring(index) .. "]"
        elseif composite then
            selected[
                i + 1
            ] = value .. ".chunk[" .. tostring(math.floor(index / native)) .. "][" .. tostring(index % native) .. "]"
        else
            selected[i + 1] = value .. "[" .. tostring(index) .. "]"
        end
    end
    local contents = table.concat(selected, ", ")
    if explicitScalar then
        contents = ".lane = {" .. contents .. "}"
    elseif composite then
        local chunks: {string} = {}
        for c = 0, math.ceil(width / native) - 1 do
            local entries: {string} = {}
            for i = 1, native do
                entries[i] = selected[c * native + i] or "0"
            end
            chunks[#chunks + 1] = "{" .. table.concat(entries, ", ") .. "}"
        end
        contents = ".chunk = {" .. table.concat(chunks, ", ") .. "}"
    end

    return "(" .. emit.cType(node.type) .. "){" .. contents .. "}"
end

--- The zero-based index a generic load or store starts at, from its one-based
--- offset.
---
--- Lowering promotes the offset to binary64 so the IR has one type for it,
--- but the cursor idiom writes it as `cursor + 1` on a `uint32`, and that
--- promotion is undone here rather than carried into the helper: an integer
--- offset needs no `floor` and no float compare on the way to `size_t`, which
--- is where the C compiler can see the bounds the loop condition established.
function emit.spanFirst(offset: scalarIR.Expr): string
    local widened = offset as any
    if widened.op == "int_to_f64" then
        local inner = widened.value as scalarIR.Expr
        if inner.type == "u32" or inner.type == "u64" then
            return "nupp_first_u64((uint64_t)" .. emit.scalar(inner) .. ")"
        elseif inner.type == "i32" or inner.type == "i64" then
            return "nupp_first_i64((int64_t)" .. emit.scalar(inner) .. ")"
        end
    end

    return "nupp_first_f64(" .. emit.scalar(offset) .. ")"
end

--- A generic store statement: one whole-vector helper when no mask was
--- given, the masked one otherwise.
--- @raises when the stored value has no resolved species
function emit.genericStore(store: scalarIR.Simd): string
    if store.intrinsic == "scatter" or store.intrinsic == "scatterUnchecked" then
        return emit.indexedSimd(store)
    end
    local _, element, lanes, shape = explicitType(store.args[3].type)
    if element == nil or lanes == nil then
        error("generic SIMD store has no resolved species", 0)
    end
    local suffix = element .. "x" .. tostring(lanes)
    local helper = explicitScalar and "ks_scalar_exp_" or "ks_exp_"
    local elementBits = tonumber(element:match("%d+")) or 0
    local nativeLanes = elementBits > 0 and math.floor(explicitWidth * 8 / elementBits) or 0
    -- The verified cursor store is the whole-vector copy, as the load is.
    if store.cursor ~= nil and (shape == "preferred" or lanes == nativeLanes) then
        return helper .. "store_at_" .. suffix .. "(p_" .. tostring(
            store.span
        ) .. " + (size_t)" .. tostring(store.cursorCName) .. ", " .. emit.scalar(store.args[3]) .. ")"
    end
    local count = independentSpanCounts and "count_" .. tostring(store.span) or "count"
    local at = "p_" .. tostring(
        store.span
    ) .. ", " .. count .. ", " .. emit.spanFirst(store.args[2]) .. ", " .. emit.scalar(store.args[3])
    if store.args[4] == nil then
        return helper .. "store_full_" .. suffix .. "(" .. at .. ")"
    end

    return helper .. "store_" .. suffix .. "(" .. at .. ", " .. emit.scalar(store.args[4]) .. ")"
end

--- Indexed memory over logical lanes, including composite representations.
--- @raises when the value and index representations have different lane counts
function emit.indexedSimd(node: scalarIR.Simd): string
    local reading = node.op == "simd_load"
    local vectorType = reading and node.type or node.args[3].type
    local _, element, lanes = explicitType(vectorType)
    local _, indexElement, indexLanes = explicitType(node.args[2].type)
    if element == nil or lanes == nil or indexElement == nil or lanes ~= indexLanes then
        error("SIMD indexed memory needs matching logical lane counts", 0)
    end
    local narrow: {[string]: string} = {u8 = "uint8_t", i8 = "int8_t", u16 = "uint16_t", i16 = "int16_t"}
    local elementC = emit.SCALAR_C[element] or narrow[element]
    local maskC = "uint" .. element:sub(2) .. "_t"
    local suffix = element .. "x" .. tostring(lanes)
    local helper = explicitScalar and "ks_scalar_exp_" or "ks_exp_"
    local maskType = "simd_mask_" .. vectorType:sub(#"simd_vector_" + 1)
    local active = node.args[reading and 3 or 4]
    local count = independentSpanCounts and "count_" .. tostring(node.span) or "count"
    local parts = {
        "({ " .. emit.cType(node.args[2].type) .. " ks_indices = " .. emit.scalar(node.args[2]) .. ";",
        emit.cType(
            maskType
        ) .. " ks_active = " .. (
            active ~= nil and emit.scalar(active) or helper .. "tail_" .. suffix .. "(" .. tostring(lanes) .. "u)"
        ) .. ";",
        emit.cType(vectorType) .. " ks_values = " .. (reading and "{0}" or emit.scalar(node.args[3])) .. ";",
        tostring(
            emit.SCALAR_C[indexElement]
        ) .. " ks_index[" .. tostring(lanes) .. "]; memcpy(ks_index, &ks_indices, sizeof(ks_index));",
        maskC .. " ks_mask[" .. tostring(lanes) .. "]; memcpy(ks_mask, &ks_active, sizeof(ks_mask));",
        tostring(elementC) .. " ks_value[" .. tostring(lanes) .. "]; memcpy(ks_value, &ks_values, sizeof(ks_value));",
    }
    local native = not explicitScalar and (element:sub(2) == "32" or element:sub(2) == "64")
    if native then
        local bits = element:sub(2)
        local register = bits == "32" and "__m256i" or "__m512i"
        local zero = bits == "32" and "_mm256_setzero_si256()" or "_mm512_setzero_si512()"
        local scale = bits == "32" and "4" or "8"
        parts[#parts + 1] = "\n#if defined(__AVX512F__)\n"
        parts[#parts + 1] = "for (uint32_t ks_base = 0u; ks_base < " .. tostring(lanes) .. "u; ks_base += 8u) {"
        parts[
            #parts + 1
        ] = "int64_t ks_offsets[8] = {0}; " .. tostring(elementC) .. " ks_batch[8] = {0}; __mmask8 ks_enabled = 0;"
        parts[
            #parts + 1
        ] = "uint32_t ks_width = " .. tostring(lanes) .. "u - ks_base; if (ks_width > 8u) ks_width = 8u;"
        parts[
            #parts + 1
        ] = "for (uint32_t ks_part = 0u; ks_part < ks_width; ++ks_part) { uint32_t ks_lane = ks_base + ks_part;"
        parts[
            #parts + 1
        ] = "if (ks_mask[ks_lane] && ks_index[ks_lane] >= 1 && (uint64_t)ks_index[ks_lane] <= (uint64_t)"
            .. count
            .. ") {"
        parts[
            #parts + 1
        ] = "ks_enabled |= (__mmask8)(1u << ks_part); ks_offsets[ks_part] = (int64_t)((uint64_t)ks_index[ks_lane] - 1u); } }"
        parts[#parts + 1] = "__m512i ks_addresses; memcpy(&ks_addresses, ks_offsets, sizeof(ks_addresses));"
        if reading then
            parts[
                #parts + 1
            ] = register
                .. " ks_loaded = _mm512_mask_i64gather_epi"
                .. bits
                .. "("
                .. zero
                .. ", ks_enabled, ks_addresses, p_"
                .. tostring(
                    node.span
                ) .. ", " .. scale .. ");"
            parts[
                #parts + 1
            ] = "memcpy(ks_batch, &ks_loaded, sizeof(ks_batch)); memcpy(ks_value + ks_base, ks_batch, ks_width * sizeof(ks_batch[0]));"
        else
            parts[
                #parts + 1
            ] = "memcpy(ks_batch, ks_value + ks_base, ks_width * sizeof(ks_batch[0])); "
                .. register
                .. " ks_written; memcpy(&ks_written, ks_batch, sizeof(ks_written));"
            parts[
                #parts + 1
            ] = "_mm512_mask_i64scatter_epi" .. bits .. "(p_" .. tostring(
                node.span
            ) .. ", ks_enabled, ks_addresses, ks_written, " .. scale .. ");"
        end
        parts[#parts + 1] = "}\n#else\n"
    end
    parts[#parts + 1] = "for (uint32_t ks_lane = 0u; ks_lane < " .. tostring(lanes) .. "u; ++ks_lane) {"
    parts[
        #parts + 1
    ] = "if (ks_mask[ks_lane] && ks_index[ks_lane] >= 1 && (uint64_t)ks_index[ks_lane] <= (uint64_t)" .. count .. ") {"
    local address = "p_" .. tostring(node.span) .. "[(size_t)ks_index[ks_lane] - 1u]"
    parts[#parts + 1] = reading and "ks_value[ks_lane] = " .. address .. ";" or address .. " = ks_value[ks_lane];"
    parts[#parts + 1] = "} }"
    if native then
        parts[#parts + 1] = "\n#endif\n"
    end
    parts[#parts + 1] = reading and "memcpy(&ks_values, ks_value, sizeof(ks_value)); ks_values; })" or "(void)0; })"

    return table.concat(parts, " ")
end

--- One scalar expression, as a C expression.
--- Parenthesised generously so C preserves the IR tree's precedence.
--- @raises when verified IR names an operation with no backend implementation
function emit.scalar(node: scalarIR.Expr): string
    local operation = node.op

    if operation == "constant" then
        return emit.doubleLiteral((node as scalarIR.Constant).value)
    elseif operation == "constant_i32" then
        local integer = node as scalarIR.IntConstant
        local number = tonumber(integer.value) or 0
        if integer.type == "u32" then
            return "UINT32_C(" .. ("%.0f"):format(number) .. ")"
        elseif number == -2147483648 then
            return "(-INT32_C(2147483647) - INT32_C(1))"
        elseif number < 0 then
            return "(-INT32_C(" .. ("%.0f"):format(-number) .. "))"
        end

        return "INT32_C(" .. ("%.0f"):format(number) .. ")"
    elseif operation == "constant_i64" then
        local integer = node as scalarIR.Int64Constant
        if integer.type == "u64" then
            return "UINT64_C(" .. integer.value .. ")"
        elseif integer.value:sub(1, 1) == "-" then
            return "(-INT64_C(" .. integer.value:sub(2) .. "))"
        end

        return "INT64_C(" .. integer.value .. ")"
    elseif operation == "bool" then
        return (node as scalarIR.Bool).value and "true" or "false"
    elseif operation == "uniform" then
        return "p_" .. (node as scalarIR.Name).name
    elseif operation == "span_count" then
        return independentSpanCounts and "((double)count_" .. (
            node as scalarIR.SpanCount
        ).span .. ")" or "((double)count)"
    elseif operation == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        local _, _, element = reducers.parse(reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "init(" .. emit.scalar(reducer.initial) .. ")"
        end

        return emit.scalar(reducer.initial)
    elseif operation == "reducer_value" then
        local reducer = node as scalarIR.ReducerValue
        local name = emit.scalar(reducer.reducer)
        local _, _, element = reducers.parse(reducer.reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "value(" .. name .. ")"
        end

        return name
    elseif operation == "lua_string_length" then
        local bytes = (node as scalarIR.LuaBytes).bytes as scalarIR.Name
        return "ks_lua_string_length(L, ks_length_" .. tostring(bytes.cName) .. ")"
    elseif operation == "lua_string_byte_lua" then
        local loaded = node as scalarIR.LuaStringByte
        local bytes = loaded.bytes as scalarIR.Name
        return "ks_lua_string_byte_lua(L, ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(loaded.index) .. ")"
    elseif operation == "lua_table_get_index" then
        local loaded = node as scalarIR.LuaTableGet
        return "ks_lua_table_number(L, " .. tostring(
            (loaded.table as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(loaded.key) .. ", \"" .. luaSite(loaded.source) .. "\")"
    elseif operation == "lua_string_byte_at" then
        local loaded = node as scalarIR.LuaBytes
        local bytes = loaded.bytes as scalarIR.Name
        return "((uint32_t)ks_bytes_" .. tostring(bytes.cName) .. "[(size_t)" .. tostring(loaded.cursorCName) .. "])"
    elseif operation == "lua_string_byte" or operation == "lua_string_u32" then
        local loaded = node as scalarIR.LuaBytes
        local bytes = loaded.bytes as scalarIR.Name
        local helper = operation == "lua_string_byte" and "ks_lua_string_byte" or "ks_lua_string_u32"
        return helper .. "(L, ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(loaded.index as scalarIR.Expr) .. ")"
    elseif operation == "lua_builder_depth"
        or operation == "lua_builder_kind"
        or operation == "lua_builder_count"
        or operation == "lua_builder_state"
    then
        local query = node as scalarIR.LuaBuilderQuery
        local which = operation == "lua_builder_depth"
            and "0u"
            or operation == "lua_builder_kind"
            and "1u"
            or operation == "lua_builder_count"
            and "2u"
            or "3u"
        return "ks_lua_builder_query(L, &" .. tostring((query.builder as scalarIR.Name).cName) .. ", " .. which .. ")"
    elseif operation == "lua_builder_number_token" then
        local number = node as scalarIR.LuaBuilderNumberToken
        local bytes = number.sourceBytes as scalarIR.Name
        return "ks_lua_builder_number_token(L, &" .. tostring(
            (number.builder as scalarIR.Name).cName
        ) .. ", ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(
            bytes.cName
        ) .. ", " .. emit.scalar(
            number.start
        ) .. ", " .. emit.scalar(number.limit) .. ", " .. (builderEager and "1" or "0") .. ")"
    elseif operation == "lua_scratch_u32_get" or operation == "lua_scratch_u32_escape_get" then
        local loaded = node as scalarIR.LuaScratchU32Get
        if loaded.cursor ~= nil then
            local scratch = tostring((loaded.scratch as scalarIR.Name).cName)
            local index = operation == "lua_scratch_u32_escape_get" and scratch .. ".capacity - 1u - " .. tostring(
                loaded.cursorCName
            ) or tostring(loaded.cursorCName)
            return "((uint32_t)" .. scratch .. ".words[(size_t)(" .. index .. ")])"
        end
        if operation == "lua_scratch_u32_get" and loaded.fixedBound ~= nil then
            return "ks_lua_scratch_u32_get_fixed(L, &" .. tostring(
                (loaded.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(loaded.index) .. ", " .. tostring(loaded.fixedBound) .. "u)"
        end

        return (
            operation == "lua_scratch_u32_escape_get"
            and "ks_lua_scratch_u32_escape_get(L, &"
            or "ks_lua_scratch_u32_get(L, &"
        ) .. tostring((loaded.scratch as scalarIR.Name).cName) .. ", " .. emit.scalar(loaded.index) .. ")"
    elseif operation == "lua_scratch_u32_length" or operation == "lua_scratch_u32_escape_length" then
        return tostring(
            ((node as scalarIR.LuaScratchU32Length).scratch as scalarIR.Name).cName
        ) .. (operation == "lua_scratch_u32_escape_length" and ".escape_length" or ".length")
    elseif operation == "lua_scratch_u32_append_bits" or operation == "lua_scratch_u32_append_bits_eager" then
        local appended = node as scalarIR.LuaScratchU32AppendBits
        return (
            operation == "lua_scratch_u32_append_bits_eager"
            and "ks_lua_scratch_u32_append_bits_eager(L, &"
            or "ks_lua_scratch_u32_append_bits(L, &"
        ) .. tostring(
            (appended.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(
            appended.index
        ) .. ", " .. emit.scalar(appended.base) .. ", " .. emit.scalar(appended.bits) .. ")"
    elseif operation == "lua_scratch_u32_append_string_bits" then
        local appended = node as scalarIR.LuaScratchU32AppendStringBits
        -- One render: the three helpers share every argument except the escape
        -- scratch and its two carries, so only the name and those extras vary.
        local escaped = appended.escapeScratch ~= nil
        local call = (
            escaped
            and "ks_lua_scratch_u32_append_string_escape_bits(L, &"
            or appended.sharedEscapes
            and "ks_lua_scratch_u32_append_string_shared_bits(L, &"
            or "ks_lua_scratch_u32_append_string_bits(L, &"
        ) .. tostring((appended.scratch as scalarIR.Name).cName)
        if escaped then
            call = call .. ", &" .. tostring((appended.escapeScratch as scalarIR.Name).cName)
        end
        call = call .. ", " .. emit.scalar(
            appended.index
        ) .. ", " .. emit.scalar(
            appended.base
        ) .. ", " .. emit.scalar(
            appended.events
        ) .. ", " .. emit.scalar(appended.quotes) .. ", " .. emit.scalar(appended.slashes)
        if escaped then
            call = call .. ", " .. emit.scalar(
                appended.slashCarry as scalarIR.Expr
            ) .. ", " .. emit.scalar(appended.slashOdd as scalarIR.Expr)
        end
        return call .. ", " .. emit.scalar(appended.inString) .. ", " .. emit.scalar(appended.stringEscaped) .. ")"
    elseif operation == "lua_scratch_u8_get" then
        local loaded = node as scalarIR.LuaScratchU8Get
        if loaded.fixedBound ~= nil then
            return "ks_lua_scratch_u8_get_fixed(L, &" .. tostring(
                (loaded.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(loaded.index) .. ", " .. tostring(loaded.fixedBound) .. "u)"
        end

        return "ks_lua_scratch_u8_get(L, &" .. tostring(
            (loaded.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(loaded.index) .. ")"
    elseif operation == "local" or operation == "helper_param" then
        return (node as scalarIR.Name).cName or ""
    elseif operation == "loop_index" then
        return "((double)(i + 1u))"
    elseif operation == "load" then
        local loaded = node as scalarIR.Load
        local index = loaded.cursorCName ~= nil and "((size_t)" .. tostring(
            loaded.cursorCName
        ) .. ")" or loaded.indexCName == "i" and "i" or "((size_t)(" .. tostring(loaded.indexCName) .. " - 1))"
        local access = "p_" .. loaded.span .. "[" .. index .. "]"
        if loaded.sourceType == "int8" or loaded.sourceType == "int16" then
            return "((int32_t)" .. access .. ")"
        elseif loaded.sourceType == "uint8" or loaded.sourceType == "uint16" then
            return "((uint32_t)" .. access .. ")"
        end
        return access
    elseif operation == "element_ref" then
        local referenced = node as scalarIR.ElementRef
        local index = referenced.cursorCName ~= nil and "((size_t)" .. tostring(
            referenced.cursorCName
        ) .. ")" or referenced.indexCName == "i" and "i" or "((size_t)(" .. tostring(referenced.indexCName) .. " - 1))"
        return "(&p_" .. referenced.span .. "[" .. index .. "])"
    elseif tostring(operation):match("^simd_") ~= nil then
        local simd = node as scalarIR.Simd
        local args = simd.args
        local suffix = "u8x" .. tostring(explicitWidth)
        local helper = explicitScalar and "ks_scalar_" or "ks_"
        if operation == "simd_species"
            or operation == "simd_lanes_generic"
            or operation == "simd_splat"
            or operation == "simd_iota"
            or operation == "simd_tail"
            or operation == "simd_load"
            or operation == "simd_binary"
            or operation == "simd_unary"
            or operation == "simd_compare"
            or operation == "simd_select"
            or operation == "simd_mask_any"
            or operation == "simd_mask_all"
            or operation == "simd_mask_count"
            or operation == "simd_mask_first"
            or operation == "simd_mask_bits"
            or operation == "simd_extract"
            or operation == "simd_insert"
            or operation == "simd_permute"
            or operation == "simd_convert"
            or operation == "simd_reinterpret"
            or operation == "simd_compress"
            or operation == "simd_expand"
            or operation == "simd_prefix"
            or operation == "simd_horizontal"
        then
            local shapedType = operation == "simd_species" and simd.type or operation == "simd_lanes_generic" and args[
                1
            ].type
                or operation == "simd_load"
                and simd.type
                or operation == "simd_select"
                and simd.type
                or operation == "simd_mask_any"
                and args[
                    1
                ].type or operation == "simd_mask_all" and args[
                    1
                ].type or operation == "simd_mask_count" and args[
                    1
                ].type or operation == "simd_mask_first" and args[
                    1
                ].type or operation == "simd_mask_bits" and args[
                    1
                ].type or operation == "simd_extract" and args[
                    1
                ].type or operation == "simd_horizontal" and args[1].type or simd.type
            local _, element, lanes, shape = explicitType(shapedType)
            if element == nil or lanes == nil or shape == nil then
                error("generic SIMD operation has no resolved species", 0)
            end
            local genericSuffix = element .. "x" .. tostring(lanes)
            local genericHelper = explicitScalar and "ks_scalar_exp_" or "ks_exp_"
            local elementBits = tonumber(element:match("%d+")) or 0
            local nativeLanes = elementBits > 0 and math.floor(explicitWidth * 8 / elementBits) or 0
            local composite = shape ~= "preferred" and lanes ~= nativeLanes
            if operation == "simd_mask_bits" and lanes > 64 then
                error("explicit SIMD masks with more than 64 lanes have no uint64 representation", 0)
            end
            if operation == "simd_extract" or operation == "simd_insert" then
                local laneIndex = tonumber((args[2] as scalarIR.Constant).value)
                if laneIndex == nil or laneIndex > lanes then
                    error("explicit SIMD lane index exceeds the selected species", 0)
                end
            end
            if operation == "simd_species" or operation == "simd_lanes_generic" then
                return "UINT32_C(" .. tostring(lanes) .. ")"
            elseif operation == "simd_convert" or operation == "simd_reinterpret" then
                local _, from = explicitType(args[1].type)
                return simdcast.emit(
                    emit.scalar(args[1]),
                    from as string,
                    element,
                    emit.cType(args[1].type),
                    emit.cType(simd.type),
                    lanes,
                    explicitScalar,
                    operation == "simd_reinterpret"
                )
            elseif operation == "simd_splat" then
                return genericHelper .. "splat_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
            elseif operation == "simd_iota" then
                return genericHelper .. "iota_" .. genericSuffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ")"
            elseif operation == "simd_tail" then
                return genericHelper .. "tail_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
            elseif operation == "simd_load" then
                if simd.intrinsic == "gather" then
                    return emit.indexedSimd(simd)
                end
                -- A verified cursor access is a whole vector inside the span:
                -- one copy at the cursor, no count and no lane check. A
                -- composite vector keeps the checked form, because its last
                -- chunk may be partial and its size is not its lane count.
                if simd.cursor ~= nil and not composite then
                    return genericHelper .. "load_at_" .. genericSuffix .. "(p_" .. tostring(
                        simd.span
                    ) .. " + (size_t)" .. tostring(simd.cursorCName) .. ")"
                end
                local count = independentSpanCounts and "count_" .. tostring(simd.span) or "count"
                local at = "p_" .. tostring(simd.span) .. ", " .. count .. ", " .. emit.spanFirst(args[2])
                if args[3] == nil then
                    return genericHelper .. "load_full_" .. genericSuffix .. "(" .. at .. ")"
                end
                return genericHelper .. "load_" .. genericSuffix .. "(" .. at .. ", " .. emit.scalar(args[3]) .. ")"
            elseif operation == "simd_binary" then
                -- An extremum has no C operator and a contract a bare `<` would
                -- not keep, so every representation calls the helper the prelude
                -- generated for its lanes rather than only the two that call a
                -- helper for everything.
                local named = tostring(simd.intrinsic)
                local extremum = named:match("_min$") ~= nil or named:match("_max$") ~= nil
                if explicitScalar or composite or extremum then
                    local family = explicitType(args[1].type)
                    local name = family == "mask" and "mask_" .. tostring(simd.intrinsic) or tostring(simd.intrinsic)
                    return genericHelper .. name .. "_" .. genericSuffix .. "(" .. emit.scalar(
                        args[1]
                    ) .. ", " .. emit.scalar(args[2]) .. ")"
                end
                local operator = ({
                    add = "+",
                    sub = "-",
                    mul = "*",
                    div = "/",
                    ['and'] = "&",
                    ['or'] = "|",
                    xor = "^",
                    shl = "<<",
                    shr = ">>",
                })[tostring(simd.intrinsic)]
                return "(" .. emit.scalar(args[1]) .. " " .. tostring(operator) .. " " .. emit.scalar(args[2]) .. ")"
            elseif operation == "simd_unary" then
                if explicitScalar or composite then
                    local family = explicitType(simd.type)
                    local name = family == "mask" and "mask_not" or tostring(simd.intrinsic)
                    return genericHelper .. name .. "_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
                end
                return "(" .. (simd.intrinsic == "neg" and "-" or "~") .. emit.scalar(args[1]) .. ")"
            elseif operation == "simd_compare" then
                if explicitScalar or composite then
                    local family = explicitType(args[1].type)
                    local name = family == "mask" and "mask_" .. tostring(simd.intrinsic) or tostring(simd.intrinsic)
                    return genericHelper .. name .. "_" .. genericSuffix .. "(" .. emit.scalar(
                        args[1]
                    ) .. ", " .. emit.scalar(args[2]) .. ")"
                end
                local comparisonOperators: {
                    [string]: string
                } = {lt = "<", le = "<=", gt = ">", ge = ">=", eq = "==", ne = "!=",}
                local operator = comparisonOperators[tostring(simd.intrinsic)]
                return "(" .. emit.scalar(args[1]) .. " " .. tostring(operator) .. " " .. emit.scalar(args[2]) .. ")"
            elseif operation == "simd_select" then
                return genericHelper .. "select_" .. genericSuffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
            elseif operation == "simd_extract" then
                return genericHelper .. "extract_" .. genericSuffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ")"
            elseif operation == "simd_insert" then
                return genericHelper .. "insert_" .. genericSuffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
            elseif operation == "simd_permute" then
                if simd.intrinsic == "interleave"
                    or simd.intrinsic == "deinterleave"
                    or simd.intrinsic == "transpose"
                then
                    return emit.rearrange(simd)
                end
                local rendered: {string} = {}
                for _, argument in ipairs(args) do
                    rendered[#rendered + 1] = emit.scalar(argument)
                end
                return genericHelper .. tostring(
                    simd.intrinsic
                ) .. "_" .. genericSuffix .. "(" .. table.concat(rendered, ", ") .. ")"
            elseif operation == "simd_compress" or operation == "simd_expand" or operation == "simd_prefix" then
                local rendered: {string} = {}
                for _, argument in ipairs(args) do
                    rendered[#rendered + 1] = emit.scalar(argument)
                end
                return genericHelper .. tostring(
                    simd.intrinsic
                ) .. "_" .. genericSuffix .. "(" .. table.concat(rendered, ", ") .. ")"
            elseif operation == "simd_horizontal" then
                local rendered: {string} = {}
                for _, argument in ipairs(args) do
                    rendered[#rendered + 1] = emit.scalar(argument)
                end
                return genericHelper .. "horizontal_" .. tostring(
                    simd.intrinsic
                ) .. "_" .. genericSuffix .. "(" .. table.concat(rendered, ", ") .. ")"
            else
                local bits = genericHelper .. "bits_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
                if operation == "simd_mask_bits" then
                    return bits
                elseif operation == "simd_mask_any" then
                    return genericHelper .. "any_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
                elseif operation == "simd_mask_all" then
                    local all = lanes == 64 and "UINT64_MAX" or "((UINT64_C(1) << " .. tostring(
                        lanes
                    ) .. "u) - UINT64_C(1))"
                    return "(" .. bits .. " == " .. all .. ")"
                elseif operation == "simd_mask_count" then
                    return "((uint32_t)__builtin_popcountll(" .. bits .. "))"
                else
                    return genericHelper .. "first_" .. genericSuffix .. "(" .. emit.scalar(args[1]) .. ")"
                end
            end
        elseif operation == "simd_species_u8" or operation == "simd_lanes" then
            return "UINT32_C(" .. tostring(explicitWidth) .. ")"
        elseif operation == "simd_load_u8" then
            local count = independentSpanCounts and "count_" .. tostring(simd.span) or "count"
            return helper .. "load_" .. suffix .. "(p_" .. tostring(
                simd.span
            ) .. ", " .. count .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_load_string_u8" then
            local bytes = args[2] as scalarIR.Name
            return helper .. "load_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(args[3]) .. ")"
        elseif operation == "simd_load_stride3_u8" then
            local strideBytes = args[2] as scalarIR.Name
            return helper .. "load_stride3_" .. suffix .. "(ks_bytes_" .. tostring(
                strideBytes.cName
            ) .. ", ks_length_" .. tostring(
                strideBytes.cName
            ) .. ", " .. emit.scalar(args[3]) .. ", " .. emit.scalar(args[4]) .. ")"
        elseif operation == "simd_splat_u8" then
            return helper .. "splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_shr_u8" then
            return helper .. "shr_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_shl_u8" then
            return helper .. "shl_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_table_u8x16" then
            local values: {string} = {}
            for index, argument in ipairs(args) do
                values[index] = "(uint8_t)" .. emit.scalar(argument)
            end
            return "((KsTableU8x16){{" .. table.concat(values, ", ") .. "}})"
        elseif operation == "simd_lookup16_u8" then
            return helper .. "lookup16_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_lookup64_u8" then
            return helper .. "lookup64_" .. suffix .. "(" .. emit.scalar(
                args[1]
            ) .. ", " .. emit.scalar(
                args[2]
            ) .. ", " .. emit.scalar(args[3]) .. ", " .. emit.scalar(args[4]) .. ", " .. emit.scalar(args[5]) .. ")"
        elseif operation == "simd_align_bytes_u8" then
            return helper .. "align_" .. suffix .. "(" .. emit.scalar(
                args[1]
            ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
        elseif operation == "simd_padded_string_u8" then
            local bytes = args[1] as scalarIR.Name
            return "ks_padded_string_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ")"
        elseif operation == "simd_padded_length" then
            return "(" .. emit.scalar(args[1]) .. ").length"
        elseif operation == "simd_padded_full_length" then
            return "(" .. emit.scalar(args[1]) .. ").full_length"
        elseif operation == "simd_padded_tail_length" then
            return "(" .. emit.scalar(args[1]) .. ").tail_length"
        elseif operation == "simd_padded_load_full_u8" then
            return helper .. "padded_load_full_" .. suffix .. "(&" .. emit.scalar(
                args[1]
            ) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_padded_load_tail_u8" then
            return helper .. "padded_load_tail_" .. suffix .. "(&" .. emit.scalar(args[1]) .. ")"
        elseif BLOCK64_CALLS[tostring(operation)] ~= nil then
            local call = BLOCK64_CALLS[tostring(operation)] as {string}
            local rendered: {string} = {}
            for position = 2, #call do
                rendered[#rendered + 1] = call[position] .. emit.scalar(args[position - 1])
            end
            return helper .. call[1] .. suffix .. "(" .. table.concat(rendered, ", ") .. ")"
        elseif operation == "simd_tail_u8" then
            return helper .. "tail_" .. suffix .. "(" .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_eq_u8" then
            if explicitScalar then
                return helper .. "eq_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(
                args[1]
            ) .. " == ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[2]) .. "))"
        elseif operation == "simd_range_u8" then
            if explicitScalar then
                return helper .. "range_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(args[2]) .. ", (uint8_t)" .. emit.scalar(args[3]) .. ")"
            end
            local value = emit.scalar(args[1])
            return "((" .. value .. " >= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(
                args[2]
            ) .. ")) & (" .. value .. " <= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[3]) .. ")))"
        elseif operation == "simd_vec_and" or operation == "simd_mask_and" then
            if explicitScalar then
                return helper .. "and_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " & " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_or" or operation == "simd_mask_or" then
            if explicitScalar then
                return helper .. "or_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " | " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_xor" or operation == "simd_mask_xor" then
            if explicitScalar then
                return helper .. "xor_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " ^ " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_not" or operation == "simd_mask_not" then
            if explicitScalar then
                return helper .. "not_" .. suffix .. "(" .. emit.scalar(args[1]) .. ")"
            end
            return "(~" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_select_u8" then
            if explicitScalar then
                return helper .. "select_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
            end
            return "((" .. emit.scalar(
                args[1]
            ) .. " & " .. emit.scalar(
                args[2]
            ) .. ") | (~" .. emit.scalar(args[1]) .. " & " .. emit.scalar(args[3]) .. "))"
        elseif operation == "simd_bits" then
            return helper .. "bits_" .. suffix .. "(" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_any" then
            return "(" .. helper .. "any_" .. suffix .. "(" .. emit.scalar(args[1]) .. ") != 0u)"
        elseif operation == "simd_all" then
            local all = explicitWidth == 32 and "UINT32_MAX" or "UINT32_C(65535)"
            return "(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(args[1]) .. ") == " .. all .. ")"
        elseif operation == "simd_count" then
            return "((uint32_t)__builtin_popcount(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(
                args[1]
            ) .. ")))"
        elseif operation == "simd_mask64" then
            return "ks_mask64(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif MASK64_BINARY[tostring(operation)] ~= nil then
            return "ks_mask64_" .. tostring(
                MASK64_BINARY[tostring(operation)]
            ) .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif MASK64_UNARY[tostring(operation)] ~= nil then
            return "ks_mask64_" .. tostring(MASK64_UNARY[tostring(operation)]) .. "(" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_mask64_low" then
            return "(" .. emit.scalar(args[1]) .. ").low"
        elseif operation == "simd_mask64_high" then
            return "(" .. emit.scalar(args[1]) .. ").high"
        end
        error("no C form for SIMD operation " .. tostring(operation), 0)
    elseif operation == "field_load" then
        local field = node as scalarIR.FieldLoad

        return "(" .. emit.scalar(field.object) .. "->" .. field.field .. ")"
    elseif operation == "neg" then
        return "(-(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "not" then
        return "(!(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "narrow_f64_f32" then
        return "(float)(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "f16_to_f32" then
        return "nupp_f16_to_f32(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "f32_to_f16" then
        return "nupp_f32_to_f16(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "bf16_to_f32" then
        return "nupp_bf16_to_f32(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "f32_to_bf16" then
        return "nupp_f32_to_bf16(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "widen_f32_f64" or operation == "int_to_f64" then
        return "((double)" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "numeric_cast" then
        local converted = (node as scalarIR.Convert).value
        local target = node.type == "u32"
            and "uint32_t"
            or node.type == "i32"
            and "int32_t"
            or node.type == "u64"
            and "uint64_t"
            or "int64_t"
        -- A wrap of something that was thirty-two bits a moment ago has nothing
        -- to reduce. The promotion to binary64 is written into the IR rather
        -- than left to the emitter, so it is visible here, and reducing what it
        -- widened would be undoing work to no purpose. This is the shape a
        -- counted loop index takes on its way into a `uint32` position.
        local widened = converted as any
        if (
            node.type == "u32" or node.type == "i32"
        ) and converted.type == "f64" and widened.op == "int_to_f64" and (
            (widened.value as scalarIR.Expr).type == "i32" or (widened.value as scalarIR.Expr).type == "u32"
        ) then
            return "((" .. target .. ")" .. emit.scalar(widened.value as scalarIR.Expr) .. ")"
        end
        -- Between the two views of one thirty-two bit pattern a cast reinterprets
        -- and is exact. From any other binary64 it has to reduce first, because
        -- the source can hold values the destination cannot and C leaves that
        -- undefined rather than modular, which is what `wrap` promises.
        if (node.type == "u32" or node.type == "i32") and converted.type == "f64" then
            local wrap = node.type == "u32" and "nupp_wrap_u32(" or "nupp_wrap_i32("

            return wrap .. emit.scalar(converted) .. ")"
        end

        return "((" .. target .. ")" .. emit.scalar(converted) .. ")"
    end

    local operator = emit.BINARY[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed
        local mixed = mixedComparison(tostring(operation), binary.left, binary.right)
        if mixed ~= nil then
            return mixed as string
        end

        return "(" .. emit.scalar(binary.left) .. " " .. (operator as string) .. " " .. emit.scalar(binary.right) .. ")"
    end

    return emit.scalarCall(node)
end

--- The scalar forms that render as a call rather than an operator: the closed
--- math set, the fixed-width operations, and the corrected three.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarCall(node: scalarIR.Expr): string
    local operation = node.op

    -- C float arithmetic is single-rounded -- it does not promote to double --
    -- so this is the binary32 operation the source asked for, and the casts say
    -- so rather than relying on the operands already being float.
    local operator = F32_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((float)(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " (float)(" .. emit.scalar(binary.right) .. "))"
    end

    -- Wrapping happens in unsigned, where overflow is defined, and comes back.
    operator = I32_WRAPPING_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    operator = U32_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((uint32_t)(" .. emit.scalar(
            binary.left
        ) .. " " .. (operator as string) .. " " .. emit.scalar(binary.right) .. "))"
    end

    if operation == "u32_div" or operation == "u32_mod" then
        local binary = node as scalarIR.Fixed
        local helper = operation == "u32_div" and "nupp_u32_div" or "nupp_u32_mod"
        return helper .. "(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    end

    if operation == "u32_shl" or operation == "u32_shr" then
        local binary = node as scalarIR.Binary
        local shift = "(" .. emit.scalar(binary.right) .. " & UINT32_C(31))"
        return "((uint32_t)(" .. emit.scalar(
            binary.left
        ) .. (operation == "u32_shl" and " << " or " >> ") .. shift .. "))"
    end

    if operation == "u64_shl" or operation == "u64_shr" then
        local binary = node as scalarIR.Fixed
        local shift = "((uint64_t)(" .. emit.scalar(binary.right) .. ") & UINT64_C(63))"
        return "((uint64_t)(" .. emit.scalar(
            binary.left
        ) .. ")" .. (operation == "u64_shl" and " << " or " >> ") .. shift .. ")"
    end

    operator = WIDE_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed
        local result = "((uint64_t)(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " (uint64_t)(" .. emit.scalar(binary.right) .. "))"
        return operation:sub(1, 1) == "u" and result or "((int64_t)" .. result .. ")"
    end

    if operation == "f32_sqrt" then
        return "sqrtf(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "f32_exp" then
        return (
            fpTranscendentals and "expf(" or "nupp_f32_exp("
        ) .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u32_not" then
        return "((uint32_t)(~" .. emit.scalar((node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_popcount" then
        return "((uint32_t)__builtin_popcount(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_ctz" then
        return "nupp_u32_ctz(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u32_clz" then
        return "nupp_u32_clz(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_not" then
        return "((uint64_t)(~(uint64_t)(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")))"
    elseif operation == "u64_popcount" then
        return "((uint32_t)__builtin_popcountll((uint64_t)(" .. emit.scalar(
            (node as scalarIR.FixedUnary).value
        ) .. ")))"
    elseif operation == "u64_ctz" then
        return "nupp_u64_ctz(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_clz" then
        return "nupp_u64_clz(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_prefix_xor" then
        local bits = emit.scalar((node as scalarIR.FixedUnary).value)
        return "({ uint64_t ks_bits = "
            .. bits
            .. "; ks_bits ^= ks_bits << 1u; ks_bits ^= ks_bits << 2u; ks_bits ^= ks_bits << 4u; "
            .. "ks_bits ^= ks_bits << 8u; ks_bits ^= ks_bits << 16u; ks_bits ^= ks_bits << 32u; ks_bits; })"
    end

    local corrected = {["f32_min"] = "nupp_f32_min", ["f32_max"] = "nupp_f32_max", ["f32_fma"] = "nupp_f32_fma",}
    local helper = corrected[operation]
    if helper ~= nil then
        local parts: {string} = {}
        local three = node as scalarIR.Corrected
        if three.args ~= nil then
            for position, argument in ipairs(three.args as {scalarIR.Expr}) do
                parts[position] = emit.scalar(argument)
            end
        else
            local binary = node as scalarIR.Binary
            parts[1] = emit.scalar(binary.left)
            parts[2] = emit.scalar(binary.right)
        end

        return (helper as string) .. "(" .. table.concat(parts, ", ") .. ")"
    end

    return emit.scalarBits(node)
end

--- The bitwise family, the closed math set, and a helper call.
---
--- Bitwise work happens in unsigned, where overflow and shifts are defined, and
--- comes back as int32. Shift counts are masked to 31 the way `nupp.math.i32`
--- masks them, and an arithmetic shift goes through a helper because C's `>>`
--- on a negative signed value is implementation-defined.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarBits(node: scalarIR.Expr): string
    local operation = node.op
    local binary = node as scalarIR.Binary

    if operation == "bnot" then
        return "((int32_t)(~nupp_u32(" .. emit.scalar((node as scalarIR.Unary).value) .. ")))"
    end

    local bitwise = {["band"] = "&", ["bor"] = "|", ["bxor"] = "^"}
    local operator = bitwise[operation]
    if operator ~= nil then
        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    if operation == "lshift" or operation == "rshift" or operation == "arshift" then
        local left = "nupp_u32(" .. emit.scalar(binary.left) .. ")"
        local shift = "(nupp_u32(" .. emit.scalar(binary.right) .. ") & 31u)"
        if operation == "lshift" then
            return "((int32_t)(" .. left .. " << " .. shift .. "))"
        elseif operation == "rshift" then
            return "((int32_t)(" .. left .. " >> " .. shift .. "))"
        end

        return "nupp_arshift(" .. left .. ", " .. shift .. ")"
    end

    if operation == "mod" then
        -- Lua's `%` is floored -- `-1 % 3` is 2 -- where C's `fmod` truncates.
        return "nupp_mod(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    end
    if operation == "pow" then
        return "pow(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    elseif operation == "helper_call" then
        local call = node as scalarIR.HelperCall
        local parts: {string} = {}
        for position, argument in ipairs(call.args) do
            parts[position] = emit.scalar(argument)
        end

        local genericSimd = genericSimdType(tostring(call.type))
        for _, argument in ipairs(call.args) do
            genericSimd = genericSimd or genericSimdType(tostring(argument.type))
        end
        local name = explicitScalar and genericSimd and call.cName .. "_forced_scalar" or call.cName

        return name .. "(" .. table.concat(parts, ", ") .. ")"
    elseif operation == "math" then
        return emit.math(node as scalarIR.Math)
    end

    error("no C form for scalar operation " .. tostring(operation), 0)
end

--- One operation from the closed math set.
---
--- `min` and `max` go through helpers rather than `fmin`/`fmax`, because Lua's
--- answer for them is a comparison and not IEEE `minNum`. `deg` and `rad` are
--- multiplications rather than library calls, and a two-argument `log` is a
--- ratio, which is what ordinary Nupp computes.
---
--- @raises when the intrinsic is outside the closed set
function emit.math(node: scalarIR.Math): string
    local parts: {string} = {}
    for position, argument in ipairs(node.args) do
        parts[position] = emit.scalar(argument)
    end

    return emit.mathFrom(node.intrinsic, parts)
end

--- The same, over arguments that are already rendered.
---
--- The lane expansion needs this: it renders each argument vector once into a
--- temporary and then indexes it per lane, so what it has are strings. Passing
--- them back through the expression renderer meant wrapping each in a fictional
--- node that had to be a member of the IR without being anything the IR means.
---
--- @raises when the intrinsic is outside the closed set
function emit.mathFrom(intrinsic: string, parts: {string}): string
    if intrinsic == "min" or intrinsic == "max" then
        local call = "nupp_" .. intrinsic .. "2(" .. parts[1] .. ", " .. parts[2] .. ")"
        for position = 3, #parts do
            call = "nupp_" .. intrinsic .. "2(" .. call .. ", " .. parts[position] .. ")"
        end

        return call
    end
    if intrinsic == "log" and #parts == 2 then
        return "(log(" .. parts[1] .. ") / log(" .. parts[2] .. "))"
    end
    if intrinsic == "deg" then
        return "(" .. parts[1] .. " * (180.0 / M_PI))"
    elseif intrinsic == "rad" then
        return "(" .. parts[1] .. " * (M_PI / 180.0))"
    end

    local name = MATH_C[intrinsic]
    if name == nil then
        error("no C form for math operation " .. tostring(intrinsic), 0)
    end

    return (name as string) .. "(" .. table.concat(parts, ", ") .. ")"
end

--- How many lane temporaries this unit has named so far.
---
--- Reset by `emit.begin`, which runs once per emitted unit, because the same
--- IR has to render the same C. A counter that carried across units would make
--- one unit's text depend on what was compiled before it, and an artifact cache
--- keyed on the source would then be wrong rather than merely cold. Within a
--- unit the numbering runs on across functions, which is deterministic for the
--- same reason.
local laneTemporary = 0

local luaTemporary = 0

----------------------------------------------------------------------------
-- Lane expressions
----------------------------------------------------------------------------

--- Starts one function's emission.
function emit.begin(): nil
    laneTemporary = 0
    luaTemporary = 0
    explicitWidth = 0
    explicitScalar = false
    explicitFixedTypes = {}
    fpTranscendentals = false
end

--- Records the fixed logical SIMD shapes used by one emitted unit.
---
--- Fixed vectors are emitted on demand so an artifact does not carry helper
--- families for source types it never mentions. The semantic IR type is the
--- authority; source aliases and local names cannot affect this inventory.
local function collectExplicitFixed(programs: {scalarIR.Program}): nil
    local function remember(typeName: string?): nil
        if typeName == nil or typeName:match("_fixed%d+$") == nil then
            return
        end
        local _, element, lanes = explicitType(typeName)
        if element ~= nil and lanes ~= nil then
            explicitFixedTypes[element .. "x" .. tostring(lanes)] = true
        end
    end

    local visitor = new visit.Visitor(
        scalarExpression = function(node: scalarIR.Expr): nil
            remember(node.type)
        end,
        scalarStatement = function(node: scalarIR.Statement): nil
            remember((node as any).type)
        end
    )
    for _, program in ipairs(programs) do
        for _, param in ipairs(program.params) do
            remember(param.type)
        end
        for _, helper in ipairs(program.helpers or {}) do
            for _, param in ipairs(helper.params) do
                remember(param.type)
            end
            for _, result in ipairs(helper.resultTypes) do
                remember(result)
            end
        end
        visit.program(program, visitor)
    end
end

--- Expands a vector operation one lane at a time, each operand evaluated once.
---
--- Without the temporaries every operand is rendered into every lane slot, so a
--- vector expression is recomputed once per lane to take one element out of it,
--- and nesting multiplies that. It is what made a memory-bound kernel eight
--- times slower lane-parallel than scalar.
---
--- @param build the scalar expression for one lane, given the temporaries
---   holding the operand vectors and which lane this is
function emit.perLane(vector: string, args: {any}, build: function({string}, integer): string): string
    laneTemporary = laneTemporary + 1

    local names: {string} = {}
    local bindings: {string} = {}
    for position, argument in ipairs(args) do
        names[position] = ("lt%d_%d"):format(laneTemporary, position)
        bindings[position] = ("ks_%s %s = %s;"):format(vector, names[position], emit.lane(argument))
    end

    local _, lanes = emit.vectorParts(vector)
    local parts: {string} = {}
    for index = 0, lanes - 1 do
        parts[index + 1] = build(names, index)
    end

    return "({ " .. table.concat(bindings, " ") .. " (ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "}; })"
end

--- Every operand of one lane operation, each taken from the same lane.
local function atLane(names: {string}, index: integer): {string}
    local parts: {string} = {}
    for position, name in ipairs(names) do
        parts[position] = name .. "[" .. tostring(index) .. "]"
    end

    return parts
end

--- One lane expression, as a C expression.
---
--- Anything that is not a lane form falls through to `emit.scalar`: a uniform
--- inside a lane expression is the same value it would be in a scalar body, and
--- rendering it twice would be two chances for the two to differ.
function emit.lane(node: lane.Expr | scalarIR.Expr): string
    local operation = node.op
    local vector = tostring(node.type)

    if operation == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        local _, _, element = reducers.parse(reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "init(" .. emit.lane(reducer.initial) .. ")"
        end

        return emit.lane(reducer.initial)
    elseif operation == "reducer_value" then
        local reducer = node as scalarIR.ReducerValue
        local name = emit.lane(reducer.reducer)
        local _, _, element = reducers.parse(reducer.reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "value(" .. name .. ")"
        end

        return name
    elseif operation == "vindex" then
        local index = node as lane.Index
        local parts: {string} = {}
        local element = emit.vectorParts(vector)
        local cType = tostring(emit.VECTOR_ELEMENT_C[element])
        for position = 0, index.lanes - 1 do
            parts[position + 1] = "(" .. cType .. ")(i + " .. tostring(position + 1) .. ")"
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vmask" then
        local mask = node as lane.MaskOp
        if mask.verb == "not" then
            return "(~" .. emit.lane(mask.args[1]) .. ")"
        else
            return "(" .. emit.lane(
                mask.args[1]
            ) .. (mask.verb == "and" and " & " or " | ") .. emit.lane(mask.args[2]) .. ")"
        end
    elseif operation == "vshort" then
        -- Both sides already ran: the rewrite proved them total before it turned
        -- the short circuit into a mask, so this is the bitwise combination and
        -- not a branch.
        local short = node as lane.ShortCircuit

        return "(" .. emit.lane(
            short.args[1]
        ) .. (short.verb == "and" and " & " or " | ") .. emit.lane(short.args[2]) .. ")"
    elseif operation == "vbinary" then
        local operator = node as lane.Binary

        return "(" .. emit.lane(
            operator.args[1]
        ) .. tostring(emit.LANE_VERB[operator.verb]) .. emit.lane(operator.args[2]) .. ")"
    elseif operation == "vunary" then
        local operator = node as lane.Unary
        if operator.verb == "neg" then
            return "(-" .. emit.lane(operator.args[1]) .. ")"
        else
            -- Elementwise, through the width's own library call, so the lane
            -- form is the same operation the scalar one performs.
            local element = emit.vectorParts(vector)
            local call = element == "f32" and "sqrtf(" or "sqrt("

            return emit.perLane(vector, operator.args, function(names: {string}, index: integer): string
                return call .. names[1] .. "[" .. tostring(index) .. "])"
            end)
        end
    elseif operation == "vsplat" then
        return "ks_splat_" .. vector .. "(" .. emit.lane((node as lane.Splat).args[1]) .. ")"
    elseif operation == "vbool_splat" then
        -- Suffixed by the mask it produces, so two gangs can share one file.
        return "ks_bool_mask_" .. vector .. "(" .. emit.lane((node as lane.BoolSplat).args[1]) .. ")"
    elseif operation == "vselect" then
        local args = (node as lane.Select).args

        return "ks_sel_" .. vector .. "(" .. emit.lane(
            args[1]
        ) .. ", " .. emit.lane(args[2]) .. ", " .. emit.lane(args[3]) .. ")"
    elseif operation == "vfield_load" then
        local load = node as lane.FieldLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]." .. load.field
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vspan_load" then
        local load = node as lane.SpanLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]"
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vbitwise" then
        return emit.laneBits(node as lane.Bitwise)
    elseif operation == "vround" then
        -- Out to the narrow element and straight back. One rounding, which is
        -- what makes this the same answer as the native narrow instruction.
        local rounded = node as lane.Round

        return "__builtin_convertvector(__builtin_convertvector(" .. emit.lane(
            rounded.args[1]
        ) .. ", ks_" .. rounded.narrow .. "), ks_" .. vector .. ")"
    elseif operation == "vconvert" then
        -- The arithmetic conversion, not a reinterpretation: widening is exact
        -- and narrowing rounds once, which is what the source asked for at the
        -- point it changed width.
        return "__builtin_convertvector(" .. emit.lane((node as lane.Convert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vmask_cast" then
        -- A mask lane is all ones or all zeros, so widening sign-extends -1 to
        -- -1 and narrowing truncates it to -1. Both preserve exactly the two
        -- values a mask has, which is what makes this a conversion.
        return "__builtin_convertvector(" .. emit.lane((node as lane.MaskCast).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vbits" then
        return "__builtin_convertvector(" .. emit.lane((node as lane.BitConvert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vcorrected" then
        -- One scalar helper call per lane, the same helper the scalar body
        -- calls, so the correction cannot be right in one form and wrong in the
        -- other.
        local call = node as lane.Corrected

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return call.helper .. "(" .. table.concat(atLane(names, index), ", ") .. ")"
        end)
    elseif operation == "vmath" then
        -- One scalar call per lane, rendered through the ordinary math path so
        -- the lane-parallel form cannot drift from the scalar one. Clang
        -- recognises the shape and uses a vector library call where it has one.
        local call = node as lane.Math

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return emit.mathFrom(call.intrinsic, atLane(names, index))
        end)
    end

    return emit.scalar(node as scalarIR.Expr)
end

--- The bitwise family, on the gang's bit vector.
---
--- A shift count is masked to 31 the way `nupp.math.i32` masks it. An arithmetic
--- shift reinterprets the operand as signed first, because the bit vector is
--- unsigned and C's `>>` would otherwise fill with zeros.
function emit.laneBits(node: lane.Bitwise): string
    local verb = node.verb
    local vector = tostring(node.type)
    if verb == "not" then
        return "(~" .. emit.lane(node.args[1]) .. ")"
    elseif verb == "sar" then
        return "((ks_" .. vector .. ")(((ks_i" .. vector:sub(
            2
        ) .. ")" .. emit.lane(node.args[1]) .. ") >> (" .. emit.lane(node.args[2]) .. " & 31)))"
    end

    local right = emit.lane(node.args[2])
    if verb == "shl" or verb == "shr" then
        right = "(" .. right .. " & 31)"
    end

    return "(" .. emit.lane(node.args[1]) .. tostring(emit.BITWISE[verb]) .. right .. ")"
end

----------------------------------------------------------------------------
-- Layouts, parameters and guards
----------------------------------------------------------------------------

--- One reified struct, as a C type whose layout the wrapper checks.
---
--- Nothing here asserts the layout matches: the generated module compares
--- `layoutof` against what the compiled object reports, at load, before the
--- wrapper is exposed. A struct whose C compiler laid it out differently is
--- caught there rather than corrupting memory here.
function emit.layout(layout: scalarIR.Layout): {string}
    local lines: {string} = {"typedef struct {"}
    for _, field in ipairs(layout.fields) do
        lines[#lines + 1] = "    " .. emit.storageC(field.type, field.sourceType) .. " " .. field.name .. ";"
    end
    lines[#lines + 1] = "} " .. layout.cName .. ";"

    return lines
end

--- Which span parameters the finished body dereferences.
---
--- A body may read a span's length without ever reading through it, and then
--- the pointer is a parameter nothing uses. Generated C is compiled
--- `-Werror`, so left alone that is a build failure on a program `nupp check`
--- and `nupp aot` both accepted -- reported against a line of C the author
--- never wrote.
---
--- Read off the final IR rather than recorded during lowering, because the
--- optimizer runs in between and may be what removed the last read. A count is
--- not a dereference, so `span_count` is the one node naming a span that does
--- not put it in this set.
---
--- Uniforms are here for the same reason and one more: a guard may state a
--- precondition about a parameter the body never reads, which is a fact the
--- generated wrapper checks and the generated C has no use for. The loop's own
--- bounds are read by the loop header rather than by any IR node, so they are
--- put in by hand.
function emit.pointerSpans(program: scalarIR.Program): {[string]: boolean}
    local found: {[string]: boolean} = {}
    local rangeGuard = program.rangeGuard
    if rangeGuard ~= nil then
        found[(rangeGuard as scalarIR.RangeGuard).first] = true
        found[(rangeGuard as scalarIR.RangeGuard).last] = true
    end
    visit.program(
        program,
        new visit.Visitor(
            scalarExpression = function(node: scalarIR.Expr): nil
                if node.op == "uniform" then
                    found[(node as scalarIR.Name).name] = true
                elseif node.op == "load" or node.op == "element_ref" then
                    found[node.span] = true
                elseif node.op == "simd_load_u8" or node.op == "simd_block64_load_u8" then
                    local span = (node as scalarIR.Simd).span
                    if span ~= nil then
                        found[span as string] = true
                    end
                end
            end,
            scalarStatement = function(node: scalarIR.Statement): nil
                if node.op == "store" then
                    found[node.span] = true
                end
            end,
            laneExpression = function(node: lane.Expr): nil
                if node.op == "vfield_load" or node.op == "vspan_load" then
                    found[node.span] = true
                end
            end,
            laneTarget = function(node: lane.Target): nil
                if node.kind == "vfield" or node.kind == "vspan" then
                    found[node.span] = true
                end
            end
        )
    )

    return found
end

--- The private C signature of one kernel.
---
--- A writable span is `restrict` and a readable one is not, which is the alias
--- matrix the checker proved, stated where the C compiler can use it. Nothing
--- infers it from the pointer types.
---
--- `used` names the spans and uniforms the body actually reads. One left out is
--- marked `KS_UNUSED`, which says the parameter may go unread rather than that
--- it does, so a pointer the IR still uses and the emitter drops is caught by
--- the same `-Werror` as before.
function emit.parameters(params: {any}, independentCounts: boolean?, used: {[string]: boolean}?): string
    local parts: {string} = {}
    for position, param in ipairs(params) do
        local spanned = param.kind == "write_span" or param.kind == "read_span"
        local named = spanned or param.kind == "uniform"
        local unused = named and used ~= nil and not (used as {[string]: boolean})[param.name]
        local name = "p_" .. param.name .. (unused and " KS_UNUSED" or "")
        if param.kind == "write_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(param.type, param.sourceType)
            parts[position] = element .. " *restrict " .. name
        elseif param.kind == "read_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(param.type, param.sourceType)
            parts[position] = "const " .. element .. " *" .. name
        else
            parts[position] = emit.cType(param.type) .. " " .. name
        end
    end
    if independentCounts then
        for _, param in ipairs(params) do
            if param.kind == "write_span" or param.kind == "read_span" then
                parts[#parts + 1] = "size_t count_" .. param.name
            end
        end
    else
        parts[#parts + 1] = "size_t count"
    end

    return table.concat(parts, ", ")
end

--- Where the loop starts and stops.
---
--- A guarded range was proved in bounds before this ran, so the generated loop
--- reads it rather than checking it again. Without one the whole span is
--- covered.
function emit.bounds(rangeGuard: scalarIR.RangeGuard?): {string}
    if rangeGuard == nil then
        return {"    size_t i = 0;", "    size_t end = count;"}
    end

    return {
        "    (void)count;",
        "    size_t i = (size_t)(p_" .. rangeGuard.first .. " - 1.0);",
        "    size_t end = (size_t)p_" .. rangeGuard.last .. ";",
    }
end

--- The group loop's bounds, for a body that lowered lane-parallel.
---
--- Whole groups only. The remainder runs the same body one iteration at a time,
--- because a masked final group would still read the addresses it masked off and
--- the last element of a span may be the last byte of a page.
function emit.groupBound(lanes: integer): {string}
    local width = tostring(lanes)

    return {
        "    size_t groups = (end > i) ? ((end - i) / " .. width .. ") * " .. width .. " + i : i;",
        "    for (; i < groups; i += " .. width .. ") {",
    }
end

--- Asking one function for a relaxation the source named.
---
--- Scoped to the function rather than set as a build flag, so a relaxation one
--- function asked for cannot quietly change another's answers.
function emit.contractPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang fp contract(fast)", "#endif",}
end

--- Holding the oracle scalar.
---
--- The forced-scalar body is what the lane-parallel one is compared against, so
--- it must not share its lowering -- including whatever the C compiler would
--- have done on its own.
function emit.forcedScalarPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang loop vectorize(disable) interleave(disable)", "#endif",}
end

----------------------------------------------------------------------------
-- Includes and feature detection
----------------------------------------------------------------------------

--- What every generated file starts with: `ks_prelude.h` carried whole.
function emit.includes(): {string}
    local lines = {"/* Generated from verified test-only native C IR. */"}
    for _, line in ipairs(carried("ks_prelude.h")) do
        lines[#lines + 1] = line
    end

    return lines
end

--- The baseline runtime detector shared by every wrapper in one AOT library.
---
--- Compiler builtins account for the processor and the operating system's
--- enabled register state. This unit is compiled without an optional tier, so
--- asking the question cannot itself execute the instructions it is asking
--- about.
---
--- `__builtin_cpu_supports` is answered at run time by a support routine in the
--- compiler's own runtime library -- `__cpu_model` and `__cpu_indicator_init`.
--- Targeting the MSVC ABI links against the Microsoft runtime instead, which
--- has neither, so the builtin compiles and then fails to link. There the same
--- question is asked of `CPUID` directly, which needs no runtime library at
--- all.
function emit.featureDetector(): string
    local lines = emit.includes()
    lines[#lines + 1] = "#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))"
    lines[#lines + 1] = "#include <intrin.h>"
    lines[#lines + 1] = "#endif"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "KS_API int ks_aot_feature_tier(void) {"
    lines[#lines + 1] = "#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))"
    lines[#lines + 1] = "    int regs[4];"
    lines[#lines + 1] = "    unsigned int enabled;"
    lines[#lines + 1] = "    __cpuid(regs, 0);"
    lines[#lines + 1] = "    /* Leaf 7 is where both extended feature bits live. */"
    lines[#lines + 1] = "    if (regs[0] < 7) return 0;"
    lines[#lines + 1] = "    __cpuid(regs, 1);"
    lines[#lines + 1] = "    /* Without OSXSAVE the operating system has enabled no wider register"
    lines[#lines + 1] = "     * state and XGETBV is not available to ask which. */"
    lines[#lines + 1] = "    if ((regs[2] & (1 << 27)) == 0) return 0;"
    lines[#lines + 1] = "    enabled = (unsigned int)_xgetbv(0);"
    lines[#lines + 1] = "    /* XMM and YMM state. A processor that has AVX2 while the operating"
    lines[#lines + 1] = "     * system saves neither cannot run it. */"
    lines[#lines + 1] = "    if ((enabled & 0x6u) != 0x6u) return 0;"
    lines[#lines + 1] = "    __cpuidex(regs, 7, 0);"
    lines[#lines + 1] = "    /* And opmask, ZMM_Hi256 and Hi16_ZMM on top of those for AVX-512. */"
    lines[#lines + 1] = "    if ((enabled & 0xE6u) == 0xE6u && (regs[1] & (1 << 16)) != 0) return 2;"
    lines[#lines + 1] = "    if ((regs[1] & (1 << 5)) != 0) return 1;"
    lines[#lines + 1] = "#elif defined(__x86_64__) || defined(_M_X64)"
    lines[#lines + 1] = "    __builtin_cpu_init();"
    lines[#lines + 1] = "    if (__builtin_cpu_supports(\"avx512f\")) return 2;"
    lines[#lines + 1] = "    if (__builtin_cpu_supports(\"avx2\")) return 1;"
    lines[#lines + 1] = "#endif"
    lines[#lines + 1] = "    return 0;"
    lines[#lines + 1] = "}"

    return table.concat(lines, "\n") .. "\n"
end

--- The one symbol that says which archive a host actually linked.
---
--- An FFI lookup creates no undefined C reference, so nothing in a static
--- archive is extracted by being called from Lua: the host has to force-load it
--- and keep its symbols. That is a physical link requirement rather than
--- something a generated wrapper can recover from, so the archive exports one
--- function whose name is the component's and whose value is its contents. A
--- name that does not resolve says the archive was not linked; a value that
--- disagrees says the archive that was linked is a different build of it.
---
--- Forty-eight bits rather than sixty-four because the wrapper compares the
--- answer against a Lua number, which is exact to fifty-three.
function emit.archiveProbe(symbol: string, fingerprint: integer): string
    local lines = emit.includes()
    lines[#lines + 1] = "KS_API uint64_t " .. symbol .. "(void) {"
    lines[#lines + 1] = "    return UINT64_C(" .. string.format("%d", fingerprint) .. ");"
    lines[#lines + 1] = "}"

    return table.concat(lines, "\n") .. "\n"
end

--- How large a fixed word buffer may be and still stand on the C stack.
---
--- A thousand words is four kilobytes, which is nothing against a thread stack
--- and more than any buffer an author writes a literal capacity for. Past it
--- the buffer is Lua-owned as before, because a frame is not the place to find
--- out that a capacity was larger than the stack left.
const emit.STACK_SCRATCH_WORDS = 1024

----------------------------------------------------------------------------
-- The Lua interop prelude
----------------------------------------------------------------------------

--- How large a fixed byte buffer may be and still stand on the C stack.
---
--- Four kilobytes, the same allowance the word buffer gets, and for the same
--- reason: it is nothing against a thread stack and more than a literal
--- capacity is written for.
const emit.STACK_SCRATCH_BYTES = 4096

--- The Lua 5.1 interop prelude, for a file with a Lua-callable entry.
---
--- `ks_lua.h` carried whole. `KS_LUA_BUILDER` tells the later preludes the
--- Lua types are declared, and `KS_JSON_WIDE` asks for the exact decimal path
--- and the power-of-five table it reads, which a body that parses no wide
--- decimal leaves out.
function emit.luaPrelude(wideNumbers: boolean): {string}
    local lines: {string} = {"#define KS_LUA_BUILDER 1"}
    if wideNumbers then
        lines[#lines + 1] = "#define KS_JSON_WIDE 1"
    end
    for _, line in ipairs(carried("ks_lua.h")) do
        lines[#lines + 1] = line
    end

    return lines
end

----------------------------------------------------------------------------
-- Layout reporters
----------------------------------------------------------------------------

--- Bytes as an unambiguous C string literal.
local function cBytes(value: string): string
    local bytes: {string} = {}
    for index = 1, #value do
        bytes[index] = ("\\x%02x"):format(value:byte(index))
    end

    return '"' .. table.concat(bytes) .. '"'
end

luaSite = function(source: scalarIR.Source?): string
    return source ~= nil and tostring(
        (source as scalarIR.Source).line
    ) .. ":" .. tostring((source as scalarIR.Source).column) or "1:1"
end

--- What the compiled object reports about one struct's layout.
---
--- A function per measurement rather than a table of numbers, so the answers
--- come from the C compiler that actually laid the struct out and the generated
--- wrapper can compare them against what Nupp believes.
function emit.layoutReporters(symbol: string, layout: scalarIR.Layout): {string}
    local prefix = "KS_API size_t " .. symbol .. "_layout_" .. layout.name
    local lines: {string} = {prefix .. "_size(void) { return sizeof(" .. layout.cName .. "); }"}
    for _, field in ipairs(layout.fields) do
        lines[
            #lines + 1
        ] = prefix
            .. "_offset_"
            .. field.name
            .. "(void) { return offsetof("
            .. layout.cName
            .. ", "
            .. field.name
            .. "); }"
        lines[
            #lines + 1
        ] = prefix
            .. "_size_"
            .. field.name
            .. "(void) { return sizeof((("
            .. layout.cName
            .. " *)0)->"
            .. field.name
            .. "); }"
    end

    return lines
end

----------------------------------------------------------------------------
-- The SIMD prelude
----------------------------------------------------------------------------

--- One value of the given lane, repeated across the gang.
local function repeated(value: string, lanes: integer): string
    local parts: {string} = {}
    for position = 1, lanes do
        parts[position] = value
    end

    return table.concat(parts, ", ")
end

--- The `any` and `first` of one mask type, over its `bits` helper.
---
--- `first` asks `any` before it counts, so a scan that finds nothing pays for
--- the cheaper of the two, and the mask is evaluated once whatever it is.
local function maskQueries(prefix: string, suffix: string, mask: string, anyBody: string?): {string}
    local bits = prefix .. "bits_" .. suffix
    return {
        "static inline __attribute__((unused)) bool " .. prefix .. "any_" .. suffix .. "(" .. mask .. " value) {",
        anyBody or "    return " .. bits .. "(value) != UINT64_C(0);",
        "}",
        "static inline __attribute__((unused)) uint32_t " .. prefix .. "first_" .. suffix .. "(" .. mask .. " value) {",
        "    return "
        .. prefix
        .. "any_"
        .. suffix
        .. "(value) ? (uint32_t)__builtin_ctzll("
        .. bits
        .. "(value)) + 1u : 0u;",
        "}",
    }
end

--- Scalar executable definitions for the named horizontal contracts.
---
--- `scalar` selects the independent struct oracle; `composite` selects a fixed
--- logical species represented by several native vectors. Preferred vectors
--- use direct lane indexing. The generated dependency graph, rather than the C
--- compiler's reassociation policy, distinguishes ordered, pairwise and
--- algebraic operations.
local function genericHorizontalPrelude(
    element: any,
    suffix: string,
    vector: string,
    lanes: integer,
    scalar: boolean,
    composite: boolean
): {string}
    local lines: {string} = {}
    local prefix = scalar and "ks_scalar_exp_" or "ks_exp_"
    local unused = "static inline __attribute__((unused)) "

    local function access(name: string, index: string): string
        if scalar then
            return name .. ".lane[" .. index .. "]"
        elseif composite then
            return "ks_exp_extract_" .. suffix .. "(" .. name .. ", (double)((" .. index .. ") + 1u))"
        end

        return name .. "[" .. index .. "]"
    end

    local function signature(name: string, dot: boolean): string
        return unused
            .. element.c
            .. " "
            .. prefix
            .. "horizontal_"
            .. name
            .. "_"
            .. suffix
            .. "("
            .. vector
            .. " left"
            .. (
                dot and ", " .. vector .. " right" or ""
            ) .. ") { "
    end

    for _, operation in ipairs({"sum", "product"}) do
        local operator = operation == "sum" and "+" or "*"
        local identity = operation == "sum" and "0" or "1"
        lines[
            #lines + 1
        ] = signature(
            "ordered_" .. operation,
            false
        ) .. element.c .. " out = (" .. element.c .. ")" .. identity .. "; for (uint32_t i = 0u; i < " .. tostring(
            lanes
        ) .. "u; ++i) out = out " .. operator .. " " .. access("left", "i") .. "; return out; }"
        lines[
            #lines + 1
        ] = signature(
            "pairwise_" .. operation,
            false
        ) .. element.c .. " partials[" .. tostring(
            lanes
        ) .. "]; for (uint32_t i = 0u; i < " .. tostring(
            lanes
        ) .. "u; ++i) partials[i] = " .. access(
            "left",
            "i"
        ) .. "; uint32_t n = " .. tostring(
            lanes
        )
            .. "u; while (n > 1u) { uint32_t out = 0u; uint32_t i = 0u; for (; i + 1u < n; i += 2u) partials[out++] = partials[i] "
            .. operator
            .. " partials[i + 1u]; if (i < n) partials[out++] = partials[i]; n = out; } return partials[0]; }"
        lines[
            #lines + 1
        ] = signature(
            "algebraic_" .. operation,
            false
        )
            .. element.c
            .. " even = ("
            .. element.c
            .. ")"
            .. identity
            .. ", odd = ("
            .. element.c
            .. ")"
            .. identity
            .. "; uint32_t i = 0u; for (; i + 1u < "
            .. tostring(
                lanes
            ) .. "u; i += 2u) { even = even " .. operator .. " " .. access(
                "left",
                "i"
            ) .. "; odd = odd " .. operator .. " " .. access(
                "left",
                "i + 1u"
            ) .. "; } if (i < " .. tostring(
                lanes
            ) .. "u) even = even " .. operator .. " " .. access(
                "left",
                "i"
            ) .. "; return even " .. operator .. " odd; }"
    end

    lines[
        #lines + 1
    ] = signature(
        "ordered_dot",
        true
    ) .. element.c .. " out = (" .. element.c .. ")0; for (uint32_t i = 0u; i < " .. tostring(
        lanes
    ) .. "u; ++i) { " .. element.c .. " product = " .. access(
        "left",
        "i"
    ) .. " * " .. access("right", "i") .. "; out = out + product; } return out; }"
    lines[
        #lines + 1
    ] = signature(
        "pairwise_dot",
        true
    ) .. element.c .. " partials[" .. tostring(
        lanes
    ) .. "]; for (uint32_t i = 0u; i < " .. tostring(
        lanes
    ) .. "u; ++i) partials[i] = " .. access(
        "left",
        "i"
    ) .. " * " .. access(
        "right",
        "i"
    ) .. "; uint32_t n = " .. tostring(
        lanes
    )
        .. "u; while (n > 1u) { uint32_t out = 0u; uint32_t i = 0u; for (; i + 1u < n; i += 2u) partials[out++] = partials[i] + partials[i + 1u]; if (i < n) partials[out++] = partials[i]; n = out; } return partials[0]; }"
    local fused = element.name == "f32" and "fmaf" or element.name == "f64" and "fma" or nil
    if fused ~= nil then
        lines[
            #lines + 1
        ] = signature(
            "algebraic_dot",
            true
        )
            .. element.c
            .. " even = ("
            .. element.c
            .. ")0, odd = ("
            .. element.c
            .. ")0; uint32_t i = 0u; for (; i + 1u < "
            .. tostring(
                lanes
            ) .. "u; i += 2u) { even = " .. fused .. "(" .. access(
                "left",
                "i"
            ) .. ", " .. access(
                "right",
                "i"
            ) .. ", even); odd = " .. fused .. "(" .. access(
                "left",
                "i + 1u"
            ) .. ", " .. access(
                "right",
                "i + 1u"
            ) .. ", odd); } if (i < " .. tostring(
                lanes
            ) .. "u) even = " .. fused .. "(" .. access(
                "left",
                "i"
            ) .. ", " .. access("right", "i") .. ", even); return even + odd; }"
    end

    --- One lane of a value being built, as a C statement.
    ---
    --- A native vector and the struct oracle are both lvalues per lane; a fixed
    --- logical species spread over several of them is not, so it rebuilds
    --- through the insert helper the rest of the composite path uses.
    local function write(name: string, index: string, value: string): string
        if scalar then
            return name .. ".lane[" .. index .. "] = " .. value .. ";"
        elseif composite then
            return name
                .. " = ks_exp_insert_"
                .. suffix
                .. "("
                .. name
                .. ", (double)(("
                .. index
                .. ") + 1u), "
                .. value
                .. ");"
        end

        return name .. "[" .. index .. "] = " .. value .. ";"
    end

    local float = element.name == "f32" or element.name == "f64"
    local nan = prefix .. "nan_" .. suffix .. "()"
    if float then
        -- Self-contained rather than the scalar body's `nupp_f32_nan`: this
        -- prelude is emitted for every species a program mentions and cannot
        -- assume a program that mentions one also called binary32 math.
        local bits = element.name == "f32" and "UINT32_C(0x7fc00000)" or "UINT64_C(0x7ff8000000000000)"
        local bitsType = element.name == "f32" and "uint32_t" or "uint64_t"
        lines[
            #lines + 1
        ] = unused
            .. element.c
            .. " "
            .. prefix
            .. "nan_"
            .. suffix
            .. "(void) { "
            .. bitsType
            .. " b = "
            .. bits
            .. "; "
            .. element.c
            .. " out; memcpy(&out, &b, sizeof out); return out; }"
    end

    -- Two named NaN contracts rather than one `min`. They disagree on every
    -- pair containing a NaN and the choice is not recoverable from a call, so
    -- the name carries it: `propagating` answers the canonical NaN, which keeps
    -- a reduction over it independent of how many lanes the target chose, and
    -- `number` answers the operand that is not one, which is IEEE `minNum` and
    -- what a scan over data using NaN for a missing measurement wants.
    --
    -- Both order `-0` below `+0`, the way `nupp.math.f32.min` does: an equal
    -- pair is where the two zeros have to be told apart by sign rather than by
    -- position, and every other equal pair answers the same value either way.
    -- An integer element has neither case, so both names reach one body.
    for _, extremum in ipairs({{name = "min", c = "<", zero = "left"}, {name = "max", c = ">", zero = "right"}}) do
        local other = extremum.zero == "left" and "right" or "left"
        local zeros = "if (left == right) { return left != ("
            .. element.c
            .. ")0 ? left : (signbit(left) ? "
            .. extremum.zero
            .. " : "
            .. other
            .. "); }"
        local ordered = "return left " .. extremum.c .. " right ? left : right;"
        for _, contract in ipairs({"propagating", "number"}) do
            local named = contract .. "_" .. extremum.name
            local body = ordered
            if float and contract == "propagating" then
                body = "if (left != left || right != right) { return " .. nan .. "; } " .. zeros .. " " .. ordered
            elseif float then
                body = "if (left != left) { return right != right ? "
                    .. nan
                    .. " : right; } if (right != right) { return left; } "
                    .. zeros
                    .. " "
                    .. ordered
            end
            local pair = prefix .. named .. "2_" .. suffix
            lines[
                #lines + 1
            ] = unused
                .. element.c
                .. " "
                .. pair
                .. "("
                .. element.c
                .. " left, "
                .. element.c
                .. " right) { "
                .. body
                .. " }"

            -- Elementwise, over one pair of registers.
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " "
                .. prefix
                .. named
                .. "_"
                .. suffix
                .. "("
                .. vector
                .. " left, "
                .. vector
                .. " right) { "
                .. vector
                .. " out = left; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) " .. write(
                    "out",
                    "i",
                    pair .. "(" .. access("left", "i") .. ", " .. access("right", "i") .. ")"
                ) .. " return out; }"

            -- Horizontal, over the lanes of one register. No association order
            -- in the name: an extremum rounds nothing, so every association
            -- answers the same value and three names would have named one.
            lines[
                #lines + 1
            ] = signature(
                named,
                false
            ) .. element.c .. " out = " .. access(
                "left",
                "0u"
            ) .. "; for (uint32_t i = 1u; i < " .. tostring(
                lanes
            ) .. "u; ++i) out = " .. pair .. "(out, " .. access("left", "i") .. "); return out; }"

            -- The lane holding that answer, one-based as every lane index is.
            -- Written against `<` and the sign rule rather than by calling the
            -- pair helper, because a tie has to keep the lane it first saw and
            -- a helper answering an equal value cannot say which one that was.
            local better = "value " .. extremum.c .. " best"
            if float then
                better = better .. " || (value == best && signbit(value) != signbit(best) && signbit(" .. (
                    extremum.zero == "left" and "value" or "best"
                ) .. "))"
            end
            local step = "if (" .. better .. ") { at = i; best = value; }"
            if float and contract == "propagating" then
                -- Once a NaN has been taken nothing replaces it, so the lowest
                -- NaN lane is the answer whenever any lane is NaN.
                step = "if (best == best) { if (value != value) { at = i; best = value; } else " .. step .. " }"
            elseif float then
                -- A NaN lane is skipped and only replaced by a real value, so
                -- the answer is a NaN lane only when every lane is one.
                step = "if (value == value) { if (best != best) { at = i; best = value; } else " .. step .. " }"
            end
            lines[
                #lines + 1
            ] = unused
                .. "double "
                .. prefix
                .. "horizontal_"
                .. contract
                .. "_arg_"
                .. extremum.name
                .. "_"
                .. suffix
                .. "("
                .. vector
                .. " left) { uint32_t at = 0u; "
                .. element.c
                .. " best = "
                .. access(
                    "left",
                    "0u"
                ) .. "; for (uint32_t i = 1u; i < " .. tostring(
                    lanes
                ) .. "u; ++i) { " .. element.c .. " value = " .. access(
                    "left",
                    "i"
                ) .. "; " .. step .. " } return (double)(at + 1u); }"
        end
    end

    return lines
end

--- Fixed logical species whose size differs from one native register.
---
--- Each production value is an aggregate of preferred native vectors. This
--- keeps `Fixed<N>` target-neutral and still guarantees vector execution when
--- the logical width is smaller, larger, or not an exact register multiple.
--- The scalar twin is emitted only for the independent correctness oracle.
--- @raises when a fixed species has fewer than two or more than 64 lanes
local function fixedSimdPrelude(width: integer): {string}
    local lines: {string} = {}
    local keys: {string} = {}
    for key in pairs(explicitFixedTypes) do
        keys[#keys + 1] = key
    end
    table.sort(keys)

    local elements = {
        f64 = {name = "f64", c = "double", mask = "int64_t", bytes = 8},
        f32 = {name = "f32", c = "float", mask = "int32_t", bytes = 4},
        i8 = {name = "i8", c = "int8_t", mask = "int8_t", bytes = 1},
        u8 = {name = "u8", c = "uint8_t", mask = "int8_t", bytes = 1},
        i16 = {name = "i16", c = "int16_t", mask = "int16_t", bytes = 2},
        u16 = {name = "u16", c = "uint16_t", mask = "int16_t", bytes = 2},
        i32 = {name = "i32", c = "int32_t", mask = "int32_t", bytes = 4},
        u32 = {name = "u32", c = "uint32_t", mask = "int32_t", bytes = 4},
        i64 = {name = "i64", c = "int64_t", mask = "int64_t", bytes = 8},
        u64 = {name = "u64", c = "uint64_t", mask = "int64_t", bytes = 8},
    }
    local binaries = {
        {name = "add", c = "+"},
        {name = "sub", c = "-"},
        {name = "mul", c = "*"},
        {name = "div", c = "/"},
        {name = "and", c = "&"},
        {name = "or", c = "|"},
        {name = "xor", c = "^"},
        {name = "shl", c = "<<"},
        {name = "shr", c = ">>"},
    }
    local comparisons = {
        {name = "lt", c = "<"},
        {name = "le", c = "<="},
        {name = "gt", c = ">"},
        {name = "ge", c = ">="},
        {name = "eq", c = "=="},
        {name = "ne", c = "!="},
    }
    local unused = "static inline __attribute__((unused)) "

    for _, suffix in ipairs(keys) do
        local elementName, laneText = suffix:match("^([fiu]%d+)x(%d+)$")
        local element = elementName ~= nil and elements[elementName] or nil
        local lanes = tonumber(laneText)
        if element == nil or lanes == nil or lanes < 2 or lanes > 64 then
            error("fixed explicit SIMD species needs between 2 and 64 lanes: " .. suffix, 0)
        end
        lanes = lanes as integer
        local nativeLanes = width / element.bytes
        if lanes ~= nativeLanes then
            local chunks = math.ceil(lanes / nativeLanes) as integer
            local nativeSuffix = tostring(elementName) .. "x" .. tostring(nativeLanes)
            local vector = "ks_exp_" .. suffix
            local mask = "ks_exp_mask_" .. suffix
            local scalarVector = "ks_scalar_exp_" .. suffix
            local scalarMask = "ks_scalar_exp_mask_" .. suffix
            lines[
                #lines + 1
            ] = "typedef struct { ks_exp_" .. nativeSuffix .. " chunk[" .. tostring(chunks) .. "]; } " .. vector .. ";"
            lines[
                #lines + 1
            ] = "typedef struct { ks_exp_mask_" .. nativeSuffix .. " chunk[" .. tostring(
                chunks
            ) .. "]; } " .. mask .. ";"
            lines[
                #lines + 1
            ] = "typedef struct { " .. element.c .. " lane[" .. tostring(lanes) .. "]; } " .. scalarVector .. ";"
            lines[
                #lines + 1
            ] = "typedef struct { " .. element.mask .. " lane[" .. tostring(lanes) .. "]; } " .. scalarMask .. ";"

            local chunkSplats, chunkIotas = {}, {}
            for chunk = 0, chunks - 1 do
                chunkSplats[chunk + 1] = "ks_exp_splat_" .. nativeSuffix .. "(value)"
                chunkIotas[
                    chunk + 1
                ] = "ks_exp_iota_" .. nativeSuffix .. "(first + (" .. element.c .. ")" .. tostring(
                    chunk * nativeLanes
                ) .. " * step, step)"
            end
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_splat_"
                .. suffix
                .. "("
                .. element.c
                .. " value) { return ("
                .. vector
                .. "){{ "
                .. table.concat(
                    chunkSplats,
                    ", "
                ) .. " }}; }"
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_iota_"
                .. suffix
                .. "("
                .. element.c
                .. " first, "
                .. element.c
                .. " step) { return ("
                .. vector
                .. "){{ "
                .. table.concat(
                    chunkIotas,
                    ", "
                ) .. " }}; }"
            lines[
                #lines + 1
            ] = unused
                .. mask
                .. " ks_exp_tail_"
                .. suffix
                .. "(uint32_t active) { "
                .. mask
                .. " out; if (active > "
                .. tostring(
                    lanes
                ) .. "u) active = " .. tostring(
                    lanes
                ) .. "u; for (uint32_t c = 0u; c < " .. tostring(
                    chunks
                ) .. "u; ++c) { uint32_t base = c * " .. tostring(
                    nativeLanes
                )
                .. "u; uint32_t remaining = active > base ? active - base : 0u; out.chunk[c] = ks_exp_tail_"
                .. nativeSuffix
                .. "(remaining); } return out; }"
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_load_"
                .. suffix
                .. "(const "
                .. element.c
                .. " *source, size_t count, size_t first, "
                .. mask
                .. " active) { "
                .. vector
                .. " out; for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                )
                .. "u; ++c) out.chunk[c] = ks_exp_load_"
                .. nativeSuffix
                .. "(source, count, first >= count ? SIZE_MAX : first + (size_t)(c * "
                .. tostring(
                    nativeLanes
                ) .. "u), active.chunk[c]); return out; }"
            -- A whole fixed vector is its full native chunks, then whatever
            -- of the last chunk the lane count reaches.
            local wholeChunks = math.floor(lanes / nativeLanes) as integer
            local remainder = lanes - wholeChunks * nativeLanes
            local chunkFull: {string} = {}
            for chunk = 0, wholeChunks - 1 do
                chunkFull[
                    #chunkFull + 1
                ] = "out.chunk[" .. tostring(
                    chunk
                )
                    .. "] = ks_exp_load_full_"
                    .. nativeSuffix
                    .. "(source, count, first >= count ? SIZE_MAX : first + "
                    .. tostring(
                        chunk * nativeLanes
                    ) .. "u);"
            end
            if remainder > 0 then
                chunkFull[
                    #chunkFull + 1
                ] = "out.chunk[" .. tostring(
                    wholeChunks
                )
                    .. "] = ks_exp_load_"
                    .. nativeSuffix
                    .. "(source, count, first >= count ? SIZE_MAX : first + "
                    .. tostring(
                        wholeChunks * nativeLanes
                    ) .. "u, ks_exp_tail_" .. nativeSuffix .. "(" .. tostring(remainder) .. "u));"
            end
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_load_full_"
                .. suffix
                .. "(const "
                .. element.c
                .. " *source, size_t count, size_t first) { "
                .. vector
                .. " out; "
                .. table.concat(
                    chunkFull,
                    " "
                ) .. " return out; }"
            lines[
                #lines + 1
            ] = unused
                .. "void ks_exp_store_"
                .. suffix
                .. "("
                .. element.c
                .. " *destination, size_t count, size_t first, "
                .. vector
                .. " value, "
                .. mask
                .. " active) { for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                )
                .. "u; ++c) ks_exp_store_"
                .. nativeSuffix
                .. "(destination, count, first >= count ? SIZE_MAX : first + (size_t)(c * "
                .. tostring(
                    nativeLanes
                ) .. "u), value.chunk[c], active.chunk[c]); }"
            local chunkStore: {string} = {}
            for chunk = 0, wholeChunks - 1 do
                chunkStore[
                    #chunkStore + 1
                ] = "ks_exp_store_full_"
                    .. nativeSuffix
                    .. "(destination, count, first >= count ? SIZE_MAX : first + "
                    .. tostring(
                        chunk * nativeLanes
                    ) .. "u, value.chunk[" .. tostring(chunk) .. "]);"
            end
            if remainder > 0 then
                chunkStore[
                    #chunkStore + 1
                ] = "ks_exp_store_"
                    .. nativeSuffix
                    .. "(destination, count, first >= count ? SIZE_MAX : first + "
                    .. tostring(
                        wholeChunks * nativeLanes
                    ) .. "u, value.chunk[" .. tostring(
                        wholeChunks
                    ) .. "], ks_exp_tail_" .. nativeSuffix .. "(" .. tostring(remainder) .. "u));"
            end
            lines[
                #lines + 1
            ] = unused
                .. "void ks_exp_store_full_"
                .. suffix
                .. "("
                .. element.c
                .. " *destination, size_t count, size_t first, "
                .. vector
                .. " value) { "
                .. table.concat(
                    chunkStore,
                    " "
                ) .. " }"
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_select_"
                .. suffix
                .. "("
                .. mask
                .. " active, "
                .. vector
                .. " yes, "
                .. vector
                .. " no) { for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                )
                .. "u; ++c) yes.chunk[c] = ks_exp_select_"
                .. nativeSuffix
                .. "(active.chunk[c], yes.chunk[c], no.chunk[c]); return yes; }"
            lines[
                #lines + 1
            ] = unused
                .. "uint64_t ks_exp_bits_"
                .. suffix
                .. "("
                .. mask
                .. " value) { uint64_t out = 0u; for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                ) .. "u; ++c) out |= ks_exp_bits_" .. nativeSuffix .. "(value.chunk[c]) << (c * " .. tostring(
                    nativeLanes
                ) .. "u); " .. (
                    lanes == 64 and "" or "out &= (UINT64_C(1) << " .. tostring(lanes) .. "u) - UINT64_C(1); "
                ) .. "return out; }"
            for _, line in ipairs(maskQueries("ks_exp_", suffix, mask)) do
                lines[#lines + 1] = line
            end
            lines[
                #lines + 1
            ] = unused
                .. element.c
                .. " ks_exp_extract_"
                .. suffix
                .. "("
                .. vector
                .. " value, double lane) { uint32_t index = (uint32_t)lane - 1u; return value.chunk[index / "
                .. tostring(
                    nativeLanes
                ) .. "u][index % " .. tostring(nativeLanes) .. "u]; }"
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_insert_"
                .. suffix
                .. "("
                .. vector
                .. " value, double lane, "
                .. element.c
                .. " replacement) { uint32_t index = (uint32_t)lane - 1u; value.chunk[index / "
                .. tostring(
                    nativeLanes
                ) .. "u][index % " .. tostring(nativeLanes) .. "u] = replacement; return value; }"

            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_swizzle_pair_"
                .. suffix
                .. "("
                .. vector
                .. " first, "
                .. vector
                .. " second, "
                .. vector
                .. " indices) { "
                .. vector
                .. " out = ks_exp_splat_"
                .. suffix
                .. "(("
                .. element.c
                .. ")0); for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                )
                .. "u; ++i) { uint32_t at = (uint32_t)ks_exp_extract_"
                .. suffix
                .. "(indices, (double)(i + 1u)) - 1u; "
                .. element.c
                .. " picked = ("
                .. element.c
                .. ")0; bool found = false; if (at < "
                .. tostring(
                    lanes
                )
                .. "u) { picked = ks_exp_extract_"
                .. suffix
                .. "(first, (double)(at + 1u)); found = true; } else if ((at - "
                .. tostring(
                    lanes
                ) .. "u) < " .. tostring(
                    lanes
                ) .. "u) { picked = ks_exp_extract_" .. suffix .. "(second, (double)(at - " .. tostring(
                    lanes
                )
                .. "u + 1u)); found = true; } if (found) { out = ks_exp_insert_"
                .. suffix
                .. "(out, (double)(i + 1u), picked); } } return out; }"
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_swizzle_"
                .. suffix
                .. "("
                .. vector
                .. " value, "
                .. vector
                .. " indices) { "
                .. vector
                .. " out = ks_exp_splat_"
                .. suffix
                .. "(("
                .. element.c
                .. ")0); for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                )
                .. "u; ++i) { uint32_t at = (uint32_t)ks_exp_extract_"
                .. suffix
                .. "(indices, (double)(i + 1u)); if ((at - 1u) < "
                .. tostring(
                    lanes
                )
                .. "u) out = ks_exp_insert_"
                .. suffix
                .. "(out, (double)(i + 1u), ks_exp_extract_"
                .. suffix
                .. "(value, (double)at)); } return out; }"
            for _, permutation in ipairs({"reverse", "rotate_left", "rotate_right"}) do
                local index = permutation == "reverse" and tostring(
                    lanes
                ) .. "u - 1u - i" or permutation == "rotate_left" and "(i + n) % " .. tostring(
                    lanes
                ) .. "u" or "(i + " .. tostring(lanes) .. "u - n) % " .. tostring(lanes) .. "u"
                local countParameter = permutation == "reverse" and "" or ", double count"
                local countSetup = permutation == "reverse" and "" or "uint32_t n = (uint32_t)count % " .. tostring(
                    lanes
                ) .. "u; "
                lines[
                    #lines + 1
                ] = unused
                    .. vector
                    .. " ks_exp_"
                    .. permutation
                    .. "_"
                    .. suffix
                    .. "("
                    .. vector
                    .. " value"
                    .. countParameter
                    .. ") { "
                    .. vector
                    .. " out = ks_exp_splat_"
                    .. suffix
                    .. "(("
                    .. element.c
                    .. ")0); "
                    .. countSetup
                    .. "for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    )
                    .. "u; ++i) out = ks_exp_insert_"
                    .. suffix
                    .. "(out, (double)(i + 1u), ks_exp_extract_"
                    .. suffix
                    .. "(value, (double)("
                    .. index
                    .. " + 1u))); return out; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_align_"
                .. suffix
                .. "("
                .. vector
                .. " previous, "
                .. vector
                .. " current, double count) { "
                .. vector
                .. " out = ks_exp_splat_"
                .. suffix
                .. "(("
                .. element.c
                .. ")0); uint32_t n = (uint32_t)count; if (n > "
                .. tostring(
                    lanes
                ) .. "u) n = " .. tostring(
                    lanes
                ) .. "u; for (uint32_t i = 0u; i < " .. tostring(
                    lanes
                )
                .. "u; ++i) out = ks_exp_insert_"
                .. suffix
                .. "(out, (double)(i + 1u), i < n ? ks_exp_extract_"
                .. suffix
                .. "(previous, (double)("
                .. tostring(
                    lanes
                ) .. "u - n + i + 1u)) : ks_exp_extract_" .. suffix .. "(current, (double)(i - n + 1u))); return out; }"
            for _, packing in ipairs({"compress", "expand"}) do
                local assignment = packing == "compress"
                    and "out = ks_exp_insert_"
                    .. suffix
                    .. "(out, (double)(cursor++ + 1u), ks_exp_extract_"
                    .. suffix
                    .. "(value, (double)(i + 1u)))"
                    or "out = ks_exp_insert_"
                    .. suffix
                    .. "(out, (double)(i + 1u), ks_exp_extract_"
                    .. suffix
                    .. "(value, (double)(cursor++ + 1u)))"
                lines[
                    #lines + 1
                ] = unused
                    .. vector
                    .. " ks_exp_"
                    .. packing
                    .. "_"
                    .. suffix
                    .. "("
                    .. vector
                    .. " value, "
                    .. mask
                    .. " selected) { "
                    .. vector
                    .. " out = ks_exp_splat_"
                    .. suffix
                    .. "(("
                    .. element.c
                    .. ")0); uint64_t bits = ks_exp_bits_"
                    .. suffix
                    .. "(selected); uint32_t cursor = 0u; for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    ) .. "u; ++i) if ((bits & (UINT64_C(1) << i)) != 0u) " .. assignment .. "; return out; }"
            end
            for _, prefix in ipairs({"prefix_sum_ordered", "prefix_xor"}) do
                if prefix ~= "prefix_xor" or tostring(elementName):sub(1, 1) ~= "f" then
                    local operator = prefix == "prefix_xor" and "^" or "+"
                    lines[
                        #lines + 1
                    ] = unused
                        .. vector
                        .. " ks_exp_"
                        .. prefix
                        .. "_"
                        .. suffix
                        .. "("
                        .. vector
                        .. " value) { for (uint32_t i = 1u; i < "
                        .. tostring(
                            lanes
                        )
                        .. "u; ++i) value = ks_exp_insert_"
                        .. suffix
                        .. "(value, (double)(i + 1u), ks_exp_extract_"
                        .. suffix
                        .. "(value, (double)i) "
                        .. operator
                        .. " ks_exp_extract_"
                        .. suffix
                        .. "(value, (double)(i + 1u))); return value; }"
                end
            end

            for _, operation in ipairs(binaries) do
                if operation.name == "add"
                    or operation.name == "sub"
                    or operation.name == "mul"
                    or operation.name == "div"
                    or tostring(elementName):sub(1, 1) ~= "f" then
                    lines[
                        #lines + 1
                    ] = unused
                        .. vector
                        .. " ks_exp_"
                        .. operation.name
                        .. "_"
                        .. suffix
                        .. "("
                        .. vector
                        .. " left, "
                        .. vector
                        .. " right) { for (uint32_t c = 0u; c < "
                        .. tostring(
                            chunks
                        )
                        .. "u; ++c) left.chunk[c] = left.chunk[c] "
                        .. operation.c
                        .. " right.chunk[c]; return left; }"
                end
            end
            for _, operation in ipairs(comparisons) do
                lines[
                    #lines + 1
                ] = unused
                    .. mask
                    .. " ks_exp_"
                    .. operation.name
                    .. "_"
                    .. suffix
                    .. "("
                    .. vector
                    .. " left, "
                    .. vector
                    .. " right) { "
                    .. mask
                    .. " out; for (uint32_t c = 0u; c < "
                    .. tostring(
                        chunks
                    ) .. "u; ++c) out.chunk[c] = left.chunk[c] " .. operation.c .. " right.chunk[c]; return out; }"
            end
            for _, operation in ipairs({
                {name = "and", c = "&"},
                {name = "or", c = "|"},
                {name = "xor", c = "^"},
                {name = "eq", c = "=="},
                {name = "ne", c = "!="},
            }) do
                lines[
                    #lines + 1
                ] = unused
                    .. mask
                    .. " ks_exp_mask_"
                    .. operation.name
                    .. "_"
                    .. suffix
                    .. "("
                    .. mask
                    .. " left, "
                    .. mask
                    .. " right) { for (uint32_t c = 0u; c < "
                    .. tostring(
                        chunks
                    ) .. "u; ++c) left.chunk[c] = left.chunk[c] " .. operation.c .. " right.chunk[c]; return left; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. vector
                .. " ks_exp_neg_"
                .. suffix
                .. "("
                .. vector
                .. " value) { for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                ) .. "u; ++c) value.chunk[c] = -value.chunk[c]; return value; }"
            if tostring(elementName):sub(1, 1) ~= "f" then
                lines[
                    #lines + 1
                ] = unused
                    .. vector
                    .. " ks_exp_not_"
                    .. suffix
                    .. "("
                    .. vector
                    .. " value) { for (uint32_t c = 0u; c < "
                    .. tostring(
                        chunks
                    ) .. "u; ++c) value.chunk[c] = ~value.chunk[c]; return value; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. mask
                .. " ks_exp_mask_not_"
                .. suffix
                .. "("
                .. mask
                .. " value) { for (uint32_t c = 0u; c < "
                .. tostring(
                    chunks
                ) .. "u; ++c) value.chunk[c] = ~value.chunk[c]; return value; }"

            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_splat_"
                .. suffix
                .. "("
                .. element.c
                .. " value) { "
                .. scalarVector
                .. " out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) out.lane[i] = value; return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_iota_"
                .. suffix
                .. "("
                .. element.c
                .. " first, "
                .. element.c
                .. " step) { "
                .. scalarVector
                .. " out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) out.lane[i] = first + (" .. element.c .. ")i * step; return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarMask
                .. " ks_scalar_exp_tail_"
                .. suffix
                .. "(uint32_t active) { "
                .. scalarMask
                .. " out; if (active > "
                .. tostring(
                    lanes
                ) .. "u) active = " .. tostring(
                    lanes
                ) .. "u; for (uint32_t i = 0u; i < " .. tostring(
                    lanes
                ) .. "u; ++i) out.lane[i] = i < active ? (" .. element.mask .. ")-1 : 0; return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_load_"
                .. suffix
                .. "(const "
                .. element.c
                .. " *source, size_t count, size_t first, "
                .. scalarMask
                .. " active) { "
                .. scalarVector
                .. " out = {{0}}; if (first >= count) return out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) if (active.lane[i] && i < count - first) out.lane[i] = source[first + i]; return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_load_full_"
                .. suffix
                .. "(const "
                .. element.c
                .. " *source, size_t count, size_t first) { return ks_scalar_exp_load_"
                .. suffix
                .. "(source, count, first, ks_scalar_exp_tail_"
                .. suffix
                .. "("
                .. tostring(
                    lanes
                ) .. "u)); }"
            lines[
                #lines + 1
            ] = unused
                .. "void ks_scalar_exp_store_"
                .. suffix
                .. "("
                .. element.c
                .. " *destination, size_t count, size_t first, "
                .. scalarVector
                .. " value, "
                .. scalarMask
                .. " active) { if (first >= count) return; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) if (active.lane[i] && i < count - first) destination[first + i] = value.lane[i]; }"
            lines[
                #lines + 1
            ] = unused
                .. "void ks_scalar_exp_store_full_"
                .. suffix
                .. "("
                .. element.c
                .. " *destination, size_t count, size_t first, "
                .. scalarVector
                .. " value) { ks_scalar_exp_store_"
                .. suffix
                .. "(destination, count, first, value, ks_scalar_exp_tail_"
                .. suffix
                .. "("
                .. tostring(
                    lanes
                ) .. "u)); }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_select_"
                .. suffix
                .. "("
                .. scalarMask
                .. " active, "
                .. scalarVector
                .. " yes, "
                .. scalarVector
                .. " no) { for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) if (!active.lane[i]) yes.lane[i] = no.lane[i]; return yes; }"
            lines[
                #lines + 1
            ] = unused
                .. "uint64_t ks_scalar_exp_bits_"
                .. suffix
                .. "("
                .. scalarMask
                .. " value) { uint64_t out = 0u; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) if (value.lane[i]) out |= UINT64_C(1) << i; return out; }"
            for _, line in ipairs(maskQueries("ks_scalar_exp_", suffix, scalarMask)) do
                lines[#lines + 1] = line
            end
            lines[
                #lines + 1
            ] = unused
                .. element.c
                .. " ks_scalar_exp_extract_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value, double lane) { return value.lane[(uint32_t)lane - 1u]; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_insert_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value, double lane, "
                .. element.c
                .. " replacement) { value.lane[(uint32_t)lane - 1u] = replacement; return value; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_swizzle_pair_"
                .. suffix
                .. "("
                .. scalarVector
                .. " first, "
                .. scalarVector
                .. " second, "
                .. scalarVector
                .. " indices) { "
                .. scalarVector
                .. " out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) { uint32_t at = (uint32_t)indices.lane[i] - 1u; out.lane[i] = at < " .. tostring(
                    lanes
                ) .. "u ? first.lane[at] : (at - " .. tostring(
                    lanes
                ) .. "u) < " .. tostring(
                    lanes
                ) .. "u ? second.lane[at - " .. tostring(lanes) .. "u] : (" .. element.c .. ")0; } return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_swizzle_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value, "
                .. scalarVector
                .. " indices) { "
                .. scalarVector
                .. " out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) { uint32_t at = (uint32_t)indices.lane[i]; out.lane[i] = (at - 1u) < " .. tostring(
                    lanes
                ) .. "u ? value.lane[at - 1u] : (" .. element.c .. ")0; } return out; }"
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_reverse_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value) { "
                .. scalarVector
                .. " out; for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) out.lane[i] = value.lane[" .. tostring(lanes - 1) .. "u - i]; return out; }"
            for _, rotation in ipairs({"rotate_left", "rotate_right"}) do
                local index = rotation == "rotate_left" and "(i + n) % " .. tostring(
                    lanes
                ) .. "u" or "(i + " .. tostring(lanes) .. "u - n) % " .. tostring(lanes) .. "u"
                lines[
                    #lines + 1
                ] = unused
                    .. scalarVector
                    .. " ks_scalar_exp_"
                    .. rotation
                    .. "_"
                    .. suffix
                    .. "("
                    .. scalarVector
                    .. " value, double count) { "
                    .. scalarVector
                    .. " out; uint32_t n = (uint32_t)count % "
                    .. tostring(
                        lanes
                    ) .. "u; for (uint32_t i = 0u; i < " .. tostring(
                        lanes
                    ) .. "u; ++i) out.lane[i] = value.lane[" .. index .. "]; return out; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_align_"
                .. suffix
                .. "("
                .. scalarVector
                .. " previous, "
                .. scalarVector
                .. " current, double count) { "
                .. scalarVector
                .. " out; uint32_t n = (uint32_t)count; if (n > "
                .. tostring(
                    lanes
                ) .. "u) n = " .. tostring(
                    lanes
                ) .. "u; for (uint32_t i = 0u; i < " .. tostring(
                    lanes
                ) .. "u; ++i) out.lane[i] = i < n ? previous.lane[" .. tostring(
                    lanes
                ) .. "u - n + i] : current.lane[i - n]; return out; }"
            for _, packing in ipairs({"compress", "expand"}) do
                local assignment = packing == "compress"
                    and "out.lane[cursor++] = value.lane[i]"
                    or "out.lane[i] = value.lane[cursor++]"
                lines[
                    #lines + 1
                ] = unused
                    .. scalarVector
                    .. " ks_scalar_exp_"
                    .. packing
                    .. "_"
                    .. suffix
                    .. "("
                    .. scalarVector
                    .. " value, "
                    .. scalarMask
                    .. " selected) { "
                    .. scalarVector
                    .. " out = {{0}}; uint32_t cursor = 0u; for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    ) .. "u; ++i) if (selected.lane[i]) " .. assignment .. "; return out; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_prefix_sum_ordered_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value) { for (uint32_t i = 1u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) value.lane[i] = value.lane[i - 1u] + value.lane[i]; return value; }"
            if tostring(elementName):sub(1, 1) ~= "f" then
                lines[
                    #lines + 1
                ] = unused
                    .. scalarVector
                    .. " ks_scalar_exp_prefix_xor_"
                    .. suffix
                    .. "("
                    .. scalarVector
                    .. " value) { for (uint32_t i = 1u; i < "
                    .. tostring(
                        lanes
                    ) .. "u; ++i) value.lane[i] = value.lane[i - 1u] ^ value.lane[i]; return value; }"
            end
            for _, operation in ipairs(binaries) do
                if operation.name == "add"
                    or operation.name == "sub"
                    or operation.name == "mul"
                    or operation.name == "div"
                    or tostring(elementName):sub(1, 1) ~= "f" then
                    lines[
                        #lines + 1
                    ] = unused
                        .. scalarVector
                        .. " ks_scalar_exp_"
                        .. operation.name
                        .. "_"
                        .. suffix
                        .. "("
                        .. scalarVector
                        .. " left, "
                        .. scalarVector
                        .. " right) { for (uint32_t i = 0u; i < "
                        .. tostring(
                            lanes
                        ) .. "u; ++i) left.lane[i] = left.lane[i] " .. operation.c .. " right.lane[i]; return left; }"
                end
            end
            for _, operation in ipairs(comparisons) do
                lines[
                    #lines + 1
                ] = unused
                    .. scalarMask
                    .. " ks_scalar_exp_"
                    .. operation.name
                    .. "_"
                    .. suffix
                    .. "("
                    .. scalarVector
                    .. " left, "
                    .. scalarVector
                    .. " right) { "
                    .. scalarMask
                    .. " out; for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    )
                    .. "u; ++i) out.lane[i] = left.lane[i] "
                    .. operation.c
                    .. " right.lane[i] ? ("
                    .. element.mask
                    .. ")-1 : 0; return out; }"
            end
            for _, operation in ipairs({
                {name = "and", c = "&"},
                {name = "or", c = "|"},
                {name = "xor", c = "^"},
                {name = "eq", c = "=="},
                {name = "ne", c = "!="},
            }) do
                lines[
                    #lines + 1
                ] = unused
                    .. scalarMask
                    .. " ks_scalar_exp_mask_"
                    .. operation.name
                    .. "_"
                    .. suffix
                    .. "("
                    .. scalarMask
                    .. " left, "
                    .. scalarMask
                    .. " right) { for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    ) .. "u; ++i) left.lane[i] = left.lane[i] " .. operation.c .. " right.lane[i]; return left; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. scalarVector
                .. " ks_scalar_exp_neg_"
                .. suffix
                .. "("
                .. scalarVector
                .. " value) { for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) value.lane[i] = -value.lane[i]; return value; }"
            if tostring(elementName):sub(1, 1) ~= "f" then
                lines[
                    #lines + 1
                ] = unused
                    .. scalarVector
                    .. " ks_scalar_exp_not_"
                    .. suffix
                    .. "("
                    .. scalarVector
                    .. " value) { for (uint32_t i = 0u; i < "
                    .. tostring(
                        lanes
                    ) .. "u; ++i) value.lane[i] = ~value.lane[i]; return value; }"
            end
            lines[
                #lines + 1
            ] = unused
                .. scalarMask
                .. " ks_scalar_exp_mask_not_"
                .. suffix
                .. "("
                .. scalarMask
                .. " value) { for (uint32_t i = 0u; i < "
                .. tostring(
                    lanes
                ) .. "u; ++i) value.lane[i] = ~value.lane[i]; return value; }"
            for _, line in ipairs(genericHorizontalPrelude(element, suffix, vector, lanes as integer, false, true)) do
                lines[#lines + 1] = line
            end
            for _, line in ipairs(
                genericHorizontalPrelude(element, suffix, scalarVector, lanes as integer, true, false)
            ) do
                lines[#lines + 1] = line
            end
        end
    end

    return lines
end

--- The explicit SIMD prelude for one vector width.
---
--- `ks_simd.h` is carried whole: its reusable part sits under an include guard
--- and its per-width part is keyed on `KS_SIMD_WIDTH`, so appending it once per
--- width the file uses defines each width's packed-byte and preferred-species
--- helpers exactly once. `KS_LUA_BUILDER`, when the Lua prelude defined it,
--- selects the scratch stores that name `lua_State`. The fixed species follow
--- because they depend on which `Fixed<N>` types the program mentions.
function emit.simdPrelude(width: integer): {string}
    local lines: {string} = {"#define KS_SIMD_WIDTH " .. tostring(width)}
    for _, line in ipairs(carried("ks_simd.h")) do
        lines[#lines + 1] = line
    end
    lines[#lines + 1] = "#undef KS_SIMD_WIDTH"
    for _, line in ipairs(fixedSimdPrelude(width)) do
        lines[#lines + 1] = line
    end

    return lines
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

--- One helper's C parameter list.
local function helperParams(helper: scalarIR.Helper): string
    local parts: {string} = {}
    for position, param in ipairs(helper.params) do
        parts[position] = emit.cType(param.type) .. " " .. tostring(param.cName)
    end

    return table.concat(parts, ", ")
end

--- Whether one helper signature carries target-neutral explicit SIMD values.
local function helperHasGenericSimd(helper: scalarIR.Helper): boolean
    for _, param in ipairs(helper.params) do
        if genericSimdType(tostring(param.type)) then
            return true
        end
    end
    for _, result in ipairs(helper.resultTypes) do
        if genericSimdType(tostring(result)) then
            return true
        end
    end

    return false
end

--- The C symbol and optional result struct for one helper rendering.
local function helperNames(helper: scalarIR.Helper, scalar: boolean): (string, string?)
    local name = helper.cName .. (scalar and "_forced_scalar" or "")

    return name, #helper.resultTypes > 1 and name .. "_result" or nil
end

--- The visible pure helpers, as C.
---
--- Result structs first, then every prototype, then every definition, so a
--- helper may call one declared after it. Each is `static inline`, because they
--- exist to be inlined into the loop and a helper that survived as a call would
--- be a call in the innermost loop of the program.
function emit.helpers(helpers: {scalarIR.Helper}): {string}
    local lines: {string} = {}
    for _, helper in ipairs(helpers) do
        local variants = (helper.native == true or not helperHasGenericSimd(helper)) and {false} or {false, true}
        for _, scalar in ipairs(variants) do
            local _, resultName = helperNames(helper, scalar)
            if resultName ~= nil then
                explicitScalar = scalar
                if not scalar then
                    helper.cResult = resultName
                end
                lines[#lines + 1] = "typedef struct {"
                for position, resultType in ipairs(helper.resultTypes) do
                    lines[#lines + 1] = "    " .. emit.cType(resultType) .. " v" .. tostring(position) .. ";"
                end
                lines[#lines + 1] = "} " .. resultName .. ";"
            end
        end
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        local variants = (helper.native == true or not helperHasGenericSimd(helper)) and {false} or {false, true}
        for _, scalar in ipairs(variants) do
            explicitScalar = scalar
            local name, resultName = helperNames(helper, scalar)
            local result = resultName or emit.cType(helper.resultType)
            -- A native call names another entry in this same translation unit,
            -- which may be defined further down it.
            local linkage = helper.native == true and "" or "static inline "
            lines[#lines + 1] = linkage .. result .. " " .. name .. "(" .. helperParams(helper) .. ");"
        end
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        if helper.native ~= true then
            local variants = not helperHasGenericSimd(helper) and {false} or {false, true}
            for _, scalar in ipairs(variants) do
                explicitScalar = scalar
                local name, resultName = helperNames(helper, scalar)
                local result = resultName or emit.cType(helper.resultType)
                lines[#lines + 1] = "static inline " .. result .. " " .. name .. "(" .. helperParams(helper) .. ") {"
                if resultName ~= nil then
                    local values: {string} = {}
                    for position, value in ipairs(helper.values) do
                        values[position] = emit.lane(value)
                    end
                    lines[#lines + 1] = "    " .. resultName .. " result = {" .. table.concat(values, ", ") .. "};"
                    lines[#lines + 1] = "    return result;"
                else
                    lines[#lines + 1] = "    return " .. emit.lane(helper.values[1]) .. ";"
                end
                lines[#lines + 1] = "}"
                lines[#lines + 1] = ""
            end
        end
    end

    explicitScalar = false

    return lines
end

----------------------------------------------------------------------------
-- Bodies and Lua blocks
----------------------------------------------------------------------------

--- What a block needs from the program around it.
record emit.Body
    --- The helpers, for a multiple binding that has to name a call's result
    --- struct.
    helpers: {scalarIR.Helper}

    --- How wide a lane store is, for a body that was rewritten.
    lanes: integer

    --- Reified layouts by IR name, for legal target-specific load fusion.
    layouts: {[string]: scalarIR.Layout}

    --- The private aggregate returned by a multi-result entry.
    resultStruct: string?

    --- Erase required lane regions while emitting the independent scalar
    --- oracle from the same scalar IR.
    forceScalar: boolean?

    --- Backend-selected lane accumulators for algebraic loop reducers.
    algebraicReducers: {[string]: string}?

    --- Fresh function-local labels for scalar `repeat` continuations.
    repeatSerial: integer?
end

--- Pushes one verified construction value on the Lua stack.
--- @raises when called with a value the construction verifier does not admit
local function luaPush(value: scalarIR.Expr, prefix: string): {string}
    if value.type == "lua_table" then
        if value.op == "lua_new_table" then
            local created = value as scalarIR.LuaNewTable
            luaTemporary = luaTemporary + 1
            local slot = "lt" .. tostring(luaTemporary)
            local lines: {
                string
            } = {
                prefix .. "if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");",
                prefix .. "lua_createtable(L, ks_lua_count(L, " .. emit.scalar(
                    created.arrayCapacity
                ) .. ", \"array capacity at " .. luaSite(
                    created.source
                ) .. "\"), ks_lua_count(L, " .. emit.scalar(
                    created.hashCapacity
                ) .. ", \"hash capacity at " .. luaSite(created.source) .. "\"));",
            }
            if #(created.fields or {}) > 0 then
                lines[#lines + 1] = prefix .. "int " .. slot .. " = lua_gettop(L);"
            end
            for _, field in ipairs(created.fields or {}) do
                if field.indexed then
                    for _, line in ipairs(luaPush(field.value, prefix)) do
                        lines[#lines + 1] = line
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "lua_rawseti(L, " .. slot .. ", ks_lua_index(L, " .. emit.scalar(
                        field.key
                    ) .. ", \"" .. luaSite(field.source) .. "\"));"
                else
                    for _, part in ipairs({field.key, field.value}) do
                        for _, line in ipairs(luaPush(part, prefix)) do
                            lines[#lines + 1] = line
                        end
                    end
                    lines[#lines + 1] = prefix .. "lua_rawset(L, " .. slot .. ");"
                end
            end

            return lines
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_nil" then
        return {prefix .. "lua_pushnil(L);"}
    elseif value.type == "lua_string" then
        if value.op == "lua_string" then
            local literal = value as scalarIR.LuaString
            return {
                prefix .. "lua_pushlstring(L, " .. cBytes(literal.value) .. ", " .. tostring(#literal.value) .. "u);",
            }
        elseif value.op == "lua_string_buffer_finish" then
            return {
                prefix .. "ks_lua_string_buffer_finish(L, &" .. tostring(
                    ((value as scalarIR.LuaStringBufferFinish).buffer as scalarIR.Name).cName
                ) .. ");",
            }
        elseif value.op == "lua_concat" then
            local joined = value as scalarIR.LuaConcat
            local lines = luaPush(joined.left, prefix)
            for _, line in ipairs(luaPush(joined.right, prefix)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = prefix .. "lua_concat(L, 2);"
            return lines
        elseif value.op == "lua_substring" then
            local sliced = value as scalarIR.LuaSubstring
            return {prefix .. "ks_lua_substring(L, " .. substringArguments(sliced) .. ");"}
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_value" then
        if value.op == "lua_builder_finish" then
            return {
                prefix .. "ks_lua_builder_finish(L, &" .. tostring(
                    ((value as scalarIR.LuaBuilderFinish).builder as scalarIR.Name).cName
                ) .. ");",
            }
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "bool" then
        return {prefix .. "lua_pushboolean(L, " .. emit.scalar(value) .. ");"}
    elseif emit.SCALAR_C[value.type] ~= nil then
        return {prefix .. "lua_pushnumber(L, (double)(" .. emit.scalar(value) .. "));"}
    end

    error("no Lua construction push for " .. tostring(value.type), 0)
end

--- Emits one append without materializing literals or rooted slices as Lua strings.
local function luaStringBufferAppend(buffer: scalarIR.Expr, value: scalarIR.Expr, prefix: string): {string}
    local target = "&" .. tostring((buffer as scalarIR.Name).cName)
    if value.op == "lua_string" then
        local literal = value as scalarIR.LuaString
        return {
            prefix .. "ks_lua_string_buffer_append(L, " .. target .. ", (const unsigned char *)" .. cBytes(
                literal.value
            ) .. ", " .. tostring(#literal.value) .. "u);",
        }
    elseif value.op == "lua_substring" then
        local sliced = value as scalarIR.LuaSubstring
        return {
            prefix .. "ks_lua_string_buffer_append_slice(L, " .. target .. ", " .. substringArguments(sliced) .. ");",
        }
    elseif value.op == "local" then
        local rooted = value as scalarIR.Name
        return {
            prefix .. "ks_lua_string_buffer_append(L, " .. target .. ", ks_bytes_" .. tostring(
                rooted.cName
            ) .. ", ks_length_" .. tostring(rooted.cName) .. ");",
        }
    end
    local lines = luaPush(value, prefix)
    lines[
        #lines + 1
    ] = prefix
        .. "{ size_t ks_append_length = 0u; const unsigned char *ks_append_bytes = (const unsigned char *)lua_tolstring(L, -1, &ks_append_length); ks_lua_string_buffer_append(L, "
        .. target
        .. ", ks_append_bytes, ks_append_length); lua_settop(L, lua_gettop(L) - 1); }"

    return lines
end

--- One verified Lua-construction block.
---
--- Logical handles are C integers naming absolute Lua stack slots. The objects
--- themselves never leave the stack, so every allocating API call sees all
--- live construction values rooted.
--- @raises when invalid IR mixes Lua string and scalar assignments
function emit.luaBlock(
    statements: {scalarIR.Statement},
    depth: integer,
    body: emit.Body,
    repeatContinue: string?
): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)

    local function append(more: {string}): nil
        for _, line in ipairs(more) do
            lines[#lines + 1] = line
        end
    end

    local function nested(inner: {scalarIR.Statement}): nil
        append(emit.luaBlock(inner, depth + 1, body, repeatContinue))
    end

    local function nestedLoop(inner: {scalarIR.Statement}): nil
        append(emit.luaBlock(inner, depth + 1, body, nil))
    end

    for _, statement in ipairs(statements) do
        if statement.op == "let" and statement.type == "lua_string_buffer" then
            local started = statement.value as scalarIR.LuaStringBuffer
            lines[#lines + 1] = prefix .. "KsLuaStringBuffer " .. statement.cName .. ";"
            lines[#lines + 1] = prefix .. "ks_lua_string_buffer_init(L, &" .. statement.cName .. ");"
            append(
                luaStringBufferAppend(
                    new scalarIR.Name(
                        op = "local",
                        name = statement.name,
                        cName = statement.cName,
                        type = "lua_string_buffer"
                    ),
                    started.initial,
                    prefix
                )
            )
        elseif statement.op == "let" and statement.type == "lua_builder" then
            local started = statement.value as scalarIR.LuaBuilder
            local maxDepth = started.maxDepth ~= nil and emit.scalar(
                started.maxDepth as scalarIR.Expr
            ) or "UINT32_C(1024)"
            local stringCapacity = started.stringCapacity ~= nil and emit.scalar(
                started.stringCapacity as scalarIR.Expr
            ) or "UINT32_C(0)"
            local arrayMarker = started.arrayMarker ~= nil and tostring(
                (started.arrayMarker as scalarIR.Name).cName
            ) or "0"
            local objectMarker = started.objectMarker ~= nil and tostring(
                (started.objectMarker as scalarIR.Name).cName
            ) or "0"
            local selectionShape = started.selectionShape ~= nil and tostring(
                (started.selectionShape as scalarIR.Name).cName
            ) or "0"
            local arrayShapeMarker = started.arrayShapeMarker ~= nil and tostring(
                (started.arrayShapeMarker as scalarIR.Name).cName
            ) or "0"
            local serdeMarkers = started.serdeMarkers ~= nil and tostring(
                (started.serdeMarkers as scalarIR.Name).cName
            ) or "0"
            local constructor = started.mode == "eager" and "ks_lua_eager_builder_new" or "ks_lua_builder_new"
            local constructorTail = started.mode == "eager"
                and ");"
                or ", "
                .. selectionShape
                .. ", "
                .. arrayShapeMarker
                .. ", "
                .. serdeMarkers
                .. ");"
            lines[
                #lines + 1
            ] = prefix .. "KsLuaBuilder " .. statement.cName .. " = " .. constructor .. "(L, " .. tostring(
                (started.nullValue as scalarIR.Name).cName
            )
                .. ", "
                .. arrayMarker
                .. ", "
                .. objectMarker
                .. ", "
                .. maxDepth
                .. ", "
                .. stringCapacity
                .. constructorTail
        elseif statement.op == "let" and statement.type == "lua_scratch_u32" then
            local started = statement.value as scalarIR.LuaScratchU32
            local fixed = started.fixed
            if fixed ~= nil and (fixed as integer) <= emit.STACK_SCRATCH_WORDS then
                -- A fixed buffer small enough to stand on the C stack does. Its
                -- capacity is a literal and it cannot escape the entry, so there
                -- is nothing for Lua to own: no userdata, no registry entry
                -- keyed on a static address, and no stack slot to keep rooted.
                -- The C compiler gets an array whose size and alignment it knows
                -- and zeroes it itself.
                lines[
                    #lines + 1
                ] = prefix .. "uint32_t " .. statement.cName .. "_storage[" .. tostring(
                    fixed
                )
                    .. "] = {0}; KsLuaScratchU32 "
                    .. statement.cName
                    .. "; ks_lua_scratch_u32_stack(&"
                    .. statement.cName
                    .. ", "
                    .. statement.cName
                    .. "_storage, "
                    .. emit.scalar(
                        started.capacity
                    ) .. ");"
            else
                lines[
                    #lines + 1
                ] = prefix
                    .. "static const char "
                    .. statement.cName
                    .. "_key = 0; KsLuaScratchU32 "
                    .. statement.cName
                    .. (
                        fixed ~= nil and "; ks_lua_scratch_u32_fixed(L, &" or "; ks_lua_scratch_u32(L, &"
                    ) .. statement.cName .. ", " .. emit.scalar(
                        started.capacity
                    ) .. ", &" .. statement.cName .. "_key);"
            end
        elseif statement.op == "let" and statement.type == "lua_scratch_u8" then
            local started = statement.value as scalarIR.LuaScratchU8
            local fixedBytes = started.fixed
            if fixedBytes ~= nil and (fixedBytes as integer) <= emit.STACK_SCRATCH_BYTES then
                lines[
                    #lines + 1
                ] = prefix .. "unsigned char " .. statement.cName .. "_storage[" .. tostring(
                    fixedBytes
                )
                    .. "]; KsLuaScratchU8 "
                    .. statement.cName
                    .. " = ks_lua_scratch_u8_stack("
                    .. statement.cName
                    .. "_storage, "
                    .. emit.scalar(
                        started.capacity
                    ) .. ");"
            else
                lines[
                    #lines + 1
                ] = prefix .. "KsLuaScratchU8 " .. statement.cName .. " = " .. (
                    reusableScratchName ~= nil
                    and statement.cName == reusableScratchName
                    and "ks_lua_scratch_u8_cached(L, "
                    or "ks_lua_scratch_u8(L, "
                ) .. emit.scalar(started.capacity) .. ");"
            end
        elseif statement.op == "let" and (
            statement.type == "lua_table"
            or statement.type == "lua_string"
            or statement.type == "lua_nil"
            or statement.type == "lua_value"
        ) then
            append(luaPush(statement.value, prefix))
            lines[#lines + 1] = prefix .. "int " .. statement.cName .. " = lua_gettop(L);"
        elseif statement.op == "let" then
            lines[
                #lines + 1
            ] = prefix .. emit.cType(
                statement.type
            ) .. " " .. statement.cName .. " = " .. emit.scalar(statement.value) .. ";"
            if statement.type == "simd_species_u8" or statement.type:match("^simd_species_") ~= nil then
                lines[#lines + 1] = prefix .. "(void)" .. statement.cName .. ";"
            end
        elseif statement.op == "lua_set_index" then
            local write = statement as scalarIR.LuaSet
            append(luaPush(write.value, prefix))
            lines[
                #lines + 1
            ] = prefix .. "lua_rawseti(L, " .. tostring(
                (write.table as scalarIR.Name).cName
            ) .. ", ks_lua_index(L, " .. emit.scalar(write.key) .. ", \"" .. luaSite(write.source) .. "\"));"
        elseif statement.op == "lua_set_key" then
            local write = statement as scalarIR.LuaSet
            append(luaPush(write.key, prefix))
            append(luaPush(write.value, prefix))
            lines[#lines + 1] = prefix .. "lua_rawset(L, " .. tostring((write.table as scalarIR.Name).cName) .. ");"
        elseif statement.op == "lua_string_buffer_append" then
            local appended = statement as scalarIR.LuaStringBufferAppend
            append(luaStringBufferAppend(appended.buffer, appended.value, prefix))
        elseif statement.op == "lua_scratch_u32_set" then
            lines[#lines + 1] = scratchWrite("ks_lua_scratch_u32_set", statement, prefix)
        elseif statement.op == "lua_scratch_u8_set" then
            lines[#lines + 1] = scratchWrite("ks_lua_scratch_u8_set", statement, prefix)
        elseif statement.op == "simd_store" then
            lines[#lines + 1] = prefix .. emit.genericStore(statement as scalarIR.Simd) .. ";"
        elseif statement.op == "simd_store4_u8" then
            local store = statement as scalarIR.Simd
            local operands: {string} = {"L", "&" .. tostring((store.args[1] as scalarIR.Name).cName)}
            for index = 2, 6 do
                operands[#operands + 1] = emit.scalar(store.args[index])
            end
            lines[
                #lines + 1
            ] = prefix .. (
                explicitScalar and "ks_scalar_" or "ks_"
            ) .. "store4_u8x" .. tostring(explicitWidth) .. "(" .. table.concat(operands, ", ") .. ");"
        elseif statement.op == "lua_scratch_u8_set4" then
            lines[#lines + 1] = scratchWrite("ks_lua_scratch_u8_set4", statement, prefix)
        elseif statement.op == "lua_scratch_u8_reset" then
            local write = statement as scalarIR.LuaScratchU8Set
            lines[#lines + 1] = prefix .. tostring((write.scratch as scalarIR.Name).cName) .. ".length = 0u;"
        elseif tostring(statement.op):match("^lua_builder_") ~= nil then
            local event = statement as scalarIR.LuaBuild
            local builder = "&" .. tostring((event.builder as scalarIR.Name).cName)
            -- The builder's constructor and decoder entry are mode-specific,
            -- while events share the proven helper core. Duplicating these
            -- helpers enlarged the hot parser enough to regress escape-heavy
            -- documents despite removing one predictable mode branch.
            local helper = "ks_lua_builder_"
            local eager = builderEager and "1" or "0"
            if event.op == "lua_builder_open_array" or event.op == "lua_builder_open_object" then
                local kind = event.op == "lua_builder_open_array" and "5u" or "6u"
                lines[
                    #lines + 1
                ] = prefix .. helper .. "open(L, " .. builder .. ", " .. kind .. ", " .. emit.scalar(
                    event.capacity as scalarIR.Expr
                ) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_key" or event.op == "lua_builder_string" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. helper .. "string(L, " .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.escaped as scalarIR.Expr
                ) .. ", " .. (event.op == "lua_builder_key" and "1" or "0") .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_number_slice" or event.op == "lua_builder_integer_slice" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. (
                    event.op == "lua_builder_integer_slice"
                    and helper
                    .. "integer_slice(L, "
                    or helper
                    .. "number_slice(L, "
                ) .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(event.length as scalarIR.Expr) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_key_scratch" or event.op == "lua_builder_string_scratch" then
                lines[
                    #lines + 1
                ] = prefix .. "ks_lua_scratch_u8_push(L, &" .. tostring(
                    (event.scratch as scalarIR.Name).cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. "); " .. (
                    event.op == "lua_builder_key_scratch"
                    and helper
                    .. "key(L, "
                    .. builder
                    .. ");"
                    or helper
                    .. "pushed_scalar(L, "
                    .. builder
                    .. ", "
                    .. eager
                    .. ");"
                )
            elseif event.op == "lua_builder_key_escapes" or event.op == "lua_builder_string_escapes" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. "ks_lua_builder_string_escapes(L, " .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. ", &" .. tostring(
                    (event.escapeScratch as scalarIR.Name).cName
                ) .. ", " .. emit.scalar(
                    event.escapeIndex as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.escapeCount as scalarIR.Expr
                ) .. ", " .. (event.op == "lua_builder_key_escapes" and "1" or "0") .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_number" then
                lines[
                    #lines + 1
                ] = prefix .. helper .. "number(L, " .. builder .. ", " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_integer64" then
                lines[
                    #lines + 1
                ] = prefix .. helper .. "integer64(L, " .. builder .. ", " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. ", " .. emit.scalar(event.negative as scalarIR.Expr) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_decimal64" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. helper .. "decimal64(L, " .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.exponent as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.negative as scalarIR.Expr
                ) .. ", " .. emit.scalar(event.exact as scalarIR.Expr) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_boolean" then
                lines[
                    #lines + 1
                ] = prefix .. helper .. "boolean(L, " .. builder .. ", " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_null" then
                lines[#lines + 1] = prefix .. helper .. "null(L, " .. builder .. ", " .. eager .. ");"
            elseif event.op == "lua_builder_close" then
                lines[#lines + 1] = prefix .. helper .. "close(L, " .. builder .. ", " .. eager .. ");"
            end
        elseif statement.op == "assign" then
            local assignment = statement as scalarIR.Assign
            local hasLua = false
            for _, entry in ipairs(assignment.values) do
                hasLua = hasLua or entry.target.type == "lua_string"
            end
            if hasLua then
                if #assignment.values ~= 1 or assignment.values[1].target.type ~= "lua_string" then
                    error("mixed or multiple Lua string assignment reached emission", 0)
                end
                append(luaPush(assignment.values[1].value, prefix))
                lines[#lines + 1] = prefix .. "lua_replace(L, " .. tostring(assignment.values[1].target.cName) .. ");"
            else
                lines[#lines + 1] = prefix .. "{"
                append(emit.block({statement}, depth + 1, body))
                lines[#lines + 1] = prefix .. "}"
            end
        elseif statement.op == "if" then
            for position, clause in ipairs(statement.clauses) do
                lines[
                    #lines + 1
                ] = prefix .. (position == 1 and "if (" or "else if (") .. emit.scalar(clause.condition) .. ") {"
                nested(clause.body)
                lines[#lines + 1] = prefix .. "}"
            end
            if statement.elseBody ~= nil then
                lines[#lines + 1] = prefix .. "else {"
                nested(statement.elseBody)
                lines[#lines + 1] = prefix .. "}"
            end
        elseif statement.op == "fornum" then
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. statement.binding.cName .. " = " .. emit.scalar(
                statement.from
            ) .. "; " .. statement.binding.cName .. " <= (int32_t)" .. emit.scalar(
                statement.to
            ) .. "; ++" .. statement.binding.cName .. ") {"
            nestedLoop(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "while" then
            lines[#lines + 1] = prefix .. "while (" .. emit.scalar(statement.condition) .. ") {"
            nestedLoop(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "repeat" then
            body.repeatSerial = (body.repeatSerial or 0) + 1
            local label = "ks_repeat_continue_" .. tostring(body.repeatSerial)
            lines[#lines + 1] = prefix .. "while (true) {"
            append(emit.luaBlock(statement.body, depth + 1, body, label))
            lines[#lines + 1] = prefix .. "    " .. label .. ":"
            lines[#lines + 1] = prefix .. "    if (" .. emit.scalar(statement.condition) .. ") break;"
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "block" then
            lines[#lines + 1] = prefix .. "{"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "return" then
            for _, value in ipairs(statement.values) do
                append(luaPush(value, prefix))
            end
            lines[#lines + 1] = prefix .. "return " .. tostring(#statement.values) .. ";"
        elseif statement.op == "continue" and repeatContinue ~= nil then
            lines[#lines + 1] = prefix .. "goto " .. (repeatContinue as string) .. ";"
        else
            lines[#lines + 1] = prefix .. statement.op .. ";"
        end
    end

    return lines
end

----------------------------------------------------------------------------
-- Statements
----------------------------------------------------------------------------

--- The C type one local is declared with.
---
--- A pointer to a struct element carries its own constness, because that is
--- where a shared borrow stops being writable as far as C is concerned.
local function localCType(typeName: string, mutable: boolean): string
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return (mutable and "" or "const ") .. "Ks" .. tostring(layout) .. " *"
    end

    return emit.cType(typeName) .. " "
end

--- Whether a rewritten loop moved its recurring liveness test behind lane
--- retirement. The rewrite keeps the marked retirement at this block's top
--- level; nested loops own their own tests.
local function exitsWhenEmpty(statements: {any}): boolean
    for _, statement in ipairs(statements) do
        if statement.op == "vbreak" and statement.exitWhenEmpty == true then
            return true
        end
    end

    return false
end

--- Neon spellings for naturally interleaved pairs of scalar fields.
local NEON_PAIR: {
    [string]: any
} = {
    ["float"] = {lanes = 4, element = "f32", tuple = "float32x4x2_t", load = "vld2q_f32", alias = "ks_alias_float",},
    ["number"] = {lanes = 2, element = "f64", tuple = "float64x2x2_t", load = "vld2q_f64", alias = "ks_alias_double",},
    ["int32"] = {lanes = 4, element = "i32", tuple = "int32x4x2_t", load = "vld2q_s32", alias = "ks_alias_i32",},
    ["uint32"] = {lanes = 4, element = "u32", tuple = "uint32x4x2_t", load = "vld2q_u32", alias = "ks_alias_u32",},
}

local function physicalSource(load: lane.FieldLoad): string
    return load.sourceType or tostring(admit.CANONICAL_SOURCE[load.scalarType])
end

--- Peels the one exact arithmetic conversion a physical field load may carry.
local function fieldLoad(value: any): lane.FieldLoad?
    if value.op == "vfield_load" then
        return value as lane.FieldLoad
    elseif value.op == "vconvert" and #value.args == 1 and value.args[1].op == "vfield_load" then
        return value.args[1] as lane.FieldLoad
    end

    return nil
end

--- Describes two adjacent field loads that are one complete, padding-free AoS
--- pair. Anything less exact keeps the ordinary gather spelling.
local function neonFieldPair(first: any, second: any, body: emit.Body): any
    if first.op ~= "let" or second.op ~= "let" then
        return nil
    end

    local left = fieldLoad(first.value)
    local right = fieldLoad(second.value)
    if left == nil or right == nil then
        return nil
    end
    if left.span ~= right.span
        or left.layout ~= right.layout
        or left.lanes ~= right.lanes
        or left.field == right.field
        or left.scalarType ~= right.scalarType
        or left.type ~= right.type
        or first.type ~= second.type
    then
        return nil
    end

    local layout = body.layouts[left.layout]
    local source = physicalSource(left)
    local neon = NEON_PAIR[source]
    if layout == nil or #layout.fields ~= 2 or neon == nil or physicalSource(right) ~= source then
        return nil
    end
    local fields = (layout as scalarIR.Layout).fields
    local firstSource = fields[1].sourceType or tostring(admit.CANONICAL_SOURCE[fields[1].type])
    local secondSource = fields[2].sourceType or tostring(admit.CANONICAL_SOURCE[fields[2].type])
    if firstSource ~= source or secondSource ~= source then
        return nil
    end

    local leftIndex = fields[1].name == left.field and 0 or fields[2].name == left.field and 1 or nil
    local rightIndex = fields[1].name == right.field and 0 or fields[2].name == right.field and 1 or nil
    local nativeLanes = neon.lanes as integer
    if leftIndex == nil
        or rightIndex == nil
        or leftIndex == rightIndex
        or left.lanes % nativeLanes ~= 0
        or left.lanes
        / nativeLanes > 2
    then
        return nil
    end

    local resultElement = tostring(first.type):match("^([fiu]%d+)x")
    if resultElement == nil then
        return nil
    end

    return {
        left = left,
        right = right,
        resultType = first.type,
        resultElement = resultElement,
        leftIndex = leftIndex,
        rightIndex = rightIndex,
        neon = neon,
    }
end

--- Renders one member of a deinterleaved load, joining two physical Neon
--- registers when the selected gang is wider than one register.
local function neonPairValue(
    temps: {string},
    member: integer,
    vector: string,
    lanes: integer,
    sourceElement: string,
    resultElement: string
): string
    local loaded
    if #temps == 1 then
        loaded = temps[1] .. ".val[" .. tostring(member) .. "]"
    else
        local indices: {string} = {}
        for index = 0, lanes - 1 do
            indices[#indices + 1] = tostring(index)
        end

        loaded = "__builtin_shufflevector(" .. temps[
            1
        ] .. ".val[" .. tostring(
            member
        ) .. "], " .. temps[2] .. ".val[" .. tostring(member) .. "], " .. table.concat(indices, ", ") .. ")"
    end

    if sourceElement ~= resultElement then
        return "__builtin_convertvector(" .. loaded .. ", ks_" .. vector .. ")"
    end

    return "(ks_" .. vector .. ")" .. loaded
end

--- One block of statements, scalar or lane, indented by `depth`.
--- @raises when a multiple-result binding calls a helper the body does not
---   declare, which is malformed IR rather than anything about the source
function emit.block(statements: {any}, depth: integer, body: emit.Body, repeatContinue: string?): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)
    local temporary = 0
    local pairedPrevious = false

    --- Appends the rendering of a nested block.
    local function nested(inner: {any}): nil
        for _, line in ipairs(emit.block(inner, depth + 1, body, repeatContinue)) do
            lines[#lines + 1] = line
        end
    end

    local function nestedLoop(inner: {any}): nil
        for _, line in ipairs(emit.block(inner, depth + 1, body, nil)) do
            lines[#lines + 1] = line
        end
    end

    for position, statement in ipairs(statements) do
        local op = statement.op
        if op ~= "let" then
            pairedPrevious = false
        end
        if op == "let" then
            local pair = position > 1 and not pairedPrevious and neonFieldPair(
                statements[position - 1],
                statement,
                body
            ) or nil
            if pair ~= nil then
                -- The immediately preceding let emitted one ordinary gather.
                -- Replace it and this one with a target branch containing the
                -- paired load, retaining those gathers as the portable branch.
                lines[#lines] = nil
                temporary = temporary + 1
                local info = pair as any
                local neon = info.neon
                local chunks = info.left.lanes / (neon.lanes as integer)
                local temps: {string} = {}
                lines[#lines + 1] = prefix .. "#if defined(__aarch64__) && (defined(__clang__) || defined(__GNUC__))"
                for chunk = 0, chunks - 1 do
                    local temp = "aos" .. tostring(temporary) .. "_" .. tostring(chunk)
                    temps[#temps + 1] = temp
                    lines[
                        #lines + 1
                    ] = prefix
                        .. neon.tuple
                        .. " "
                        .. temp
                        .. " = "
                        .. neon.load
                        .. "((const "
                        .. neon.alias
                        .. " *)&p_"
                        .. info.left.span
                        .. "[i + "
                        .. tostring(
                            chunk * (neon.lanes as integer)
                        ) .. "]);"
                end
                local previous = statements[position - 1]
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    previous.type
                ) .. " " .. previous.cName .. " = " .. neonPairValue(
                    temps,
                    info.leftIndex,
                    info.resultType,
                    info.left.lanes,
                    neon.element,
                    info.resultElement
                ) .. ";"
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    statement.type
                ) .. " " .. statement.cName .. " = " .. neonPairValue(
                    temps,
                    info.rightIndex,
                    info.resultType,
                    info.right.lanes,
                    neon.element,
                    info.resultElement
                ) .. ";"
                lines[#lines + 1] = prefix .. "#else"
                lines[
                    #lines + 1
                ] = prefix .. localCType(
                    previous.type,
                    previous.value.mutable == true
                ) .. previous.cName .. " = " .. emit.lane(previous.value) .. ";"
                lines[
                    #lines + 1
                ] = prefix .. localCType(
                    statement.type,
                    statement.value.mutable == true
                ) .. statement.cName .. " = " .. emit.lane(statement.value) .. ";"
                lines[#lines + 1] = prefix .. "#endif"
                pairedPrevious = true
            elseif statement.type ~= "simd_species_u8" and statement.type:match("^simd_species_") == nil then
                lines[
                    #lines + 1
                ] = prefix .. localCType(
                    statement.type,
                    statement.value.mutable == true
                ) .. statement.cName .. " = " .. emit.lane(statement.value) .. ";"
                pairedPrevious = false
            else
                pairedPrevious = false
            end
        elseif op == "multi_let" then
            temporary = temporary + 1

            local result: string? = nil
            for _, candidate in ipairs(body.helpers) do
                if candidate.name == statement.call.helper then
                    local _, resultName = helperNames(candidate, explicitScalar and helperHasGenericSimd(candidate))
                    result = resultName
                end
            end
            if result == nil then
                error("no result struct for helper " .. tostring(statement.call.helper), 0)
            end

            local temp = "mr" .. tostring(temporary)
            lines[#lines + 1] = prefix .. tostring(result) .. " " .. temp .. " = " .. emit.lane(statement.call) .. ";"
            for position, bound in ipairs(statement.bindings) do
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    bound.type
                ) .. " " .. bound.cName .. " = " .. temp .. ".v" .. tostring(position) .. ";"
            end
        elseif op == "store" then
            local index = statement.cursorCName ~= nil and "((size_t)" .. tostring(
                statement.cursorCName
            ) .. ")" or statement.indexCName == "i" and "i" or "((size_t)(" .. tostring(
                statement.indexCName
            ) .. " - 1))"
            lines[
                #lines + 1
            ] = prefix .. scalarIR.cIdentifier(
                "p",
                statement.span
            ) .. "[" .. index .. "] = " .. emit.lane(statement.value) .. ";"
        elseif op == "assign" then
            -- Every value into a temporary before any is stored, because
            -- `a, b = b, a` means what it says and storing as it went would not.
            local temps: {string} = {}
            for position, entry in ipairs(statement.values) do
                temporary = temporary + 1
                temps[position] = "as" .. tostring(temporary)
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    entry.target.type
                ) .. " " .. temps[position] .. " = " .. emit.lane(entry.value) .. ";"
            end
            for position, entry in ipairs(statement.values) do
                local target = entry.target.kind == "local" and entry.target.cName or "(" .. emit.lane(
                    entry.target.object
                ) .. "->" .. entry.target.field .. ")"
                lines[#lines + 1] = prefix .. target .. " = " .. temps[position] .. ";"
            end
        elseif op == "vassign" then
            for _, entry in ipairs(statement.values) do
                local target = entry.target
                if target.kind == "vfield" or target.kind == "vspan" then
                    -- Consecutive elements, one lane each. Clang turns the group
                    -- into an interleaving store where the target has one.
                    lines[#lines + 1] = prefix .. "{"
                    lines[
                        #lines + 1
                    ] = prefix .. "    " .. emit.cType(entry.value.type) .. " lanes = " .. emit.lane(entry.value) .. ";"
                    for index = 0, body.lanes - 1 do
                        local address = "p_" .. target.span .. "[i + " .. tostring(index) .. "]"
                        if target.kind == "vfield" then
                            address = address .. "." .. target.field
                        end
                        lines[
                            #lines + 1
                        ] = prefix .. "    " .. address .. " = (" .. emit.storageC(
                            target.scalarType,
                            target.sourceType
                        ) .. ")lanes[" .. tostring(index) .. "];"
                    end
                    lines[#lines + 1] = prefix .. "}"
                else
                    lines[#lines + 1] = prefix .. target.cName .. " = " .. emit.lane(entry.value) .. ";"
                end
            end
        elseif op == "if" then
            local nativeSwitch = statement.nativeSwitch
            if nativeSwitch and #nativeSwitch.arms == #statement.clauses then
                lines[#lines + 1] = prefix .. "switch (" .. emit.scalar(nativeSwitch.selector) .. ") {"
                for position, arm in ipairs(nativeSwitch.arms) do
                    for _, label in ipairs(arm.labels) do
                        local constant = new scalarIR.IntConstant(
                            op = "constant_i32",
                            value = label.value,
                            type = label.type,
                            source = label.source
                        )
                        lines[#lines + 1] = prefix .. "case " .. emit.scalar(constant) .. ":"
                    end
                    lines[#lines + 1] = prefix .. "{"
                    nested(statement.clauses[position].body)
                    lines[#lines + 1] = prefix .. "    break;"
                    lines[#lines + 1] = prefix .. "}"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "default:"
                    lines[#lines + 1] = prefix .. "{"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "    break;"
                    lines[#lines + 1] = prefix .. "}"
                end
                lines[#lines + 1] = prefix .. "}"
            else
                for position, clause in ipairs(statement.clauses) do
                    lines[
                        #lines + 1
                    ] = prefix .. (position == 1 and "if (" or "else if (") .. emit.lane(clause.condition) .. ") {"
                    nested(clause.body)
                    lines[#lines + 1] = prefix .. "}"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "else {"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "}"
                end
            end
        elseif op == "vwhile" then
            -- The loop runs while any lane is live, and a lane that retired
            -- stops contributing without stopping the others.
            local immediateExit = exitsWhenEmpty(statement.body)
            lines[
                #lines + 1
            ] = prefix .. emit.cType(
                statement.live.type
            ) .. " " .. statement.live.cName .. " = " .. emit.lane(statement.initial) .. ";"
            if immediateExit then
                lines[
                    #lines + 1
                ] = prefix .. "if (ks_any_" .. tostring(statement.live.type) .. "(" .. statement.live.cName .. ")) {"
                lines[#lines + 1] = prefix .. "    while (true) {"
            else
                lines[
                    #lines + 1
                ] = prefix .. "while (ks_any_" .. tostring(statement.live.type) .. "(" .. statement.live.cName .. ")) {"
            end
            lines[
                #lines + 1
            ] = prefix .. (
                immediateExit and "        " or "    "
            ) .. emit.cType(
                statement.executing.type
            ) .. " " .. statement.executing.cName .. " = " .. statement.live.cName .. ";"
            if immediateExit then
                for _, line in ipairs(emit.block(statement.body, depth + 2, body)) do
                    lines[#lines + 1] = line
                end
            else
                nested(statement.body)
            end
            lines[
                #lines + 1
            ] = prefix .. (
                immediateExit and "        " or "    "
            ) .. statement.live.cName .. " &= " .. emit.lane(statement.condition) .. ";"
            if immediateExit then
                lines[#lines + 1] = prefix .. "    }"
            end
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vwhile_uniform" then
            -- An ordinary loop over lane-parallel statements. The condition is
            -- scalar, so this is the same `while` the scalar body emits.
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vbreak" then
            local mask = emit.lane(statement.mask)
            lines[#lines + 1] = prefix .. statement.live.cName .. " &= ~(" .. mask .. ");"
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. mask .. ");"
            if statement.exitWhenEmpty == true then
                lines[
                    #lines + 1
                ] = prefix .. "if (!ks_any_" .. tostring(
                    statement.live.type
                ) .. "(" .. statement.live.cName .. ")) break;"
            end
        elseif op == "vcontinue" then
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. emit.lane(statement.mask) .. ");"
        elseif op == "simd_store" then
            lines[#lines + 1] = prefix .. emit.genericStore(statement as scalarIR.Simd) .. ";"
        elseif op == "vreducer_add" then
            local contribution = statement as lane.ReducerAdd
            temporary = temporary + 1
            local vectorType = tostring(contribution.value.type)
            local temp = "reduce" .. tostring(temporary)
            local contributed = contribution.right ~= nil and "(" .. emit.lane(
                contribution.value
            ) .. " * " .. emit.lane(contribution.right as lane.Expr) .. ")" or emit.lane(contribution.value)
            lines[#lines + 1] = prefix .. emit.cType(vectorType) .. " " .. temp .. " = " .. contributed .. ";"
            local _, width = emit.vectorParts(vectorType)
            local algebraic = body.algebraicReducers ~= nil and body.algebraicReducers[contribution.reducer] or nil
            if contribution.order == "exact" and algebraic ~= nil then
                lines[
                    #lines + 1
                ] = prefix .. reducers.accumulate(
                    contribution.operation,
                    contribution.element as string,
                    vectorType,
                    algebraic,
                    temp
                )
            elseif contribution.order == "algebraic" and algebraic ~= nil then
                lines[
                    #lines + 1
                ] = prefix .. algebraic .. (contribution.operation == "product" and " *= " or " += ") .. temp .. ";"
            else
                local stateful = reducerHelper(contribution.order, contribution.operation, contribution.element)
                for laneIndex = 0, width - 1 do
                    if stateful ~= nil then
                        lines[
                            #lines + 1
                        ] = prefix .. stateful .. "add(&" .. contribution.reducerCName .. ", (" .. emit.cType(
                            contribution.element or "f64"
                        ) .. ")" .. temp .. "[" .. tostring(laneIndex) .. "]);"
                    else
                        local operator = contribution.operation == "product" and " *= " or " += "
                        lines[
                            #lines + 1
                        ] = prefix .. contribution.reducerCName .. operator .. "(double)" .. temp .. "[" .. tostring(
                            laneIndex
                        ) .. "];"
                    end
                end
            end
        elseif op == "reducer_add" then
            local contribution = statement as scalarIR.ReducerAdd
            local named = contribution.reducer as scalarIR.Name
            local contributed = contribution.right ~= nil and "(" .. emit.lane(
                contribution.value
            ) .. " * " .. emit.lane(contribution.right as scalarIR.Expr) .. ")" or emit.lane(contribution.value)
            local stateful = reducerHelper(contribution.order, contribution.operation, contribution.value.type)
            if stateful ~= nil then
                lines[
                    #lines + 1
                ] = prefix .. stateful .. "add(&" .. tostring(named.cName) .. ", " .. contributed .. ");"
            else
                local operator = contribution.operation == "product" and " *= " or " += "
                lines[#lines + 1] = prefix .. tostring(named.cName) .. operator .. contributed .. ";"
            end
        elseif op == "fornum" and statement.lanes ~= nil and body.forceScalar ~= true then
            local region = statement as scalarIR.Fornum
            local lanes = region.lanes as scalarIR.LaneBody
            local width = tostring(lanes.lanes)
            local algebraicReducers: {[string]: string} = {}
            local algebraicOrder: {lane.ReducerAdd} = {}
            for _, laneStatement in ipairs(lanes.statements) do
                if laneStatement.op == "vreducer_add" and reducers.parallel(laneStatement.order) then
                    local contribution = laneStatement as lane.ReducerAdd
                    algebraicOrder[#algebraicOrder + 1] = contribution
                    algebraicReducers[contribution.reducer] = "reduce_acc_" .. tostring(temporary + #algebraicOrder)
                end
            end
            local laneBody = new emit.Body(
                helpers = body.helpers,
                lanes = lanes.lanes,
                layouts = body.layouts,
                resultStruct = body.resultStruct,
                forceScalar = false,
                algebraicReducers = algebraicReducers
            )
            lines[#lines + 1] = prefix .. "{"
            for _, contribution in ipairs(algebraicOrder) do
                local accumulator = algebraicReducers[contribution.reducer] as string
                local vector = reducers.accumulatorType(
                    contribution.order,
                    contribution.element or "f64",
                    contribution.value.type
                )
                lines[
                    #lines + 1
                ] = prefix .. "    " .. emit.cType(
                    vector
                ) .. " " .. accumulator .. " = (" .. emit.cType(
                    vector
                ) .. "){" .. repeated(reducers.identity(contribution.operation), lanes.lanes) .. "};"
            end
            lines[#lines + 1] = prefix .. "    size_t i = (size_t)((int32_t)(" .. emit.lane(region.from) .. ") - 1);"
            lines[#lines + 1] = prefix .. "    size_t end = (size_t)(int32_t)(" .. emit.lane(region.to) .. ");"
            lines[
                #lines + 1
            ] = prefix .. "    size_t groups = (end > i) ? ((end - i) / " .. width .. ") * " .. width .. " + i : i;"
            lines[#lines + 1] = prefix .. "    for (; i < groups; i += " .. width .. ") {"
            for _, line in ipairs(emit.block(lanes.statements, depth + 2, laneBody)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = prefix .. "    }"
            for _, contribution in ipairs(algebraicOrder) do
                local accumulator = algebraicReducers[contribution.reducer] as string
                for laneIndex = 0, lanes.lanes - 1 do
                    if contribution.order == "exact" then
                        lines[
                            #lines + 1
                        ] = prefix .. "    " .. reducers.finish(
                            contribution.operation,
                            contribution.element as string,
                            contribution.reducerCName,
                            accumulator .. "[" .. tostring(laneIndex) .. "]"
                        )
                    else
                        local operator = contribution.operation == "product" and " *= " or " += "
                        lines[
                            #lines + 1
                        ] = prefix
                            .. "    "
                            .. contribution.reducerCName
                            .. operator
                            .. "(double)"
                            .. accumulator
                            .. "["
                            .. tostring(
                                laneIndex
                            ) .. "];"
                    end
                end
            end
            lines[
                #lines + 1
            ] = prefix
                .. "    for (int32_t "
                .. region.binding.cName
                .. " = (int32_t)i + 1; "
                .. region.binding.cName
                .. " <= (int32_t)"
                .. "end; ++"
                .. region.binding.cName
                .. ") {"
            for _, line in ipairs(emit.block(region.body, depth + 2, body)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = prefix .. "    }"
            lines[#lines + 1] = prefix .. "}"
        elseif op == "fornum" then
            local counter = statement.binding.cName
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. counter .. " = " .. emit.lane(
                statement.from
            ) .. "; " .. counter .. " <= (int32_t)" .. emit.lane(statement.to) .. "; ++" .. counter .. ") {"
            nestedLoop(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "while" then
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nestedLoop(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "repeat" then
            body.repeatSerial = (body.repeatSerial or 0) + 1
            local label = "ks_repeat_continue_" .. tostring(body.repeatSerial)
            lines[#lines + 1] = prefix .. "while (true) {"
            for _, line in ipairs(emit.block(statement.body, depth + 1, body, label)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = prefix .. "    " .. label .. ":"
            lines[#lines + 1] = prefix .. "    if (" .. emit.lane(statement.condition) .. ") break;"
            lines[#lines + 1] = prefix .. "}"
        elseif op == "block" then
            lines[#lines + 1] = prefix .. "{"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "return" then
            if #statement.values > 1 then
                local values: {string} = {}
                for position, value in ipairs(statement.values) do
                    values[position] = emit.scalar(value)
                end
                lines[
                    #lines + 1
                ] = prefix .. "return (" .. tostring(body.resultStruct) .. "){" .. table.concat(values, ", ") .. "};"
            elseif #statement.values == 1 then
                lines[#lines + 1] = prefix .. "return " .. emit.scalar(statement.values[1]) .. ";"
            else
                lines[#lines + 1] = prefix .. "return;"
            end
        elseif op == "continue" and repeatContinue ~= nil then
            lines[#lines + 1] = prefix .. "goto " .. (repeatContinue as string) .. ";"
        else
            lines[#lines + 1] = prefix .. op .. ";"
        end
    end

    return lines
end

----------------------------------------------------------------------------
-- The whole program
----------------------------------------------------------------------------

--- One or more programs, as one C file.
---
--- Everything shared is emitted once and everything per function once each: the
--- includes, a struct typedef, and a gang's prelude are shared, while the layout
--- reporters, the helpers and the two function bodies belong to the function
--- that needed them. Two functions reifying one struct get one typedef and two
--- sets of reporters, because a reporter is named after the symbol whose wrapper
--- checks it.
---
--- Two definitions of the same function come out per program: the real one, and
--- a forced-scalar one that is the oracle the lane-parallel body is diffed
--- against. The oracle must not share the real body's lowering, which is why it
--- keeps the scalar statements and carries a pragma refusing vectorisation --
--- including whatever the C compiler would have done on its own.
--- @raises when passed malformed or unverified IR
function emit.program(programs: {scalarIR.Program}, tier: string?): string
    emit.begin()
    collectExplicitFixed(programs)

    local lines = emit.includes()
    local hasBuilder = false
    local hasNumberToken = false
    for _, program in ipairs(programs) do
        hasBuilder = hasBuilder or program.entryMode == "lua-builder"
        hasNumberToken = hasNumberToken or program.usesNumberToken == true
    end
    if hasBuilder then
        for _, line in ipairs(emit.luaPrelude(hasNumberToken)) do
            lines[#lines + 1] = line
        end
    end
    local declared: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        for _, layout in ipairs(program.layouts or {}) do
            if not declared[layout.name] then
                declared[layout.name] = true
                for _, line in ipairs(emit.layout(layout)) do
                    lines[#lines + 1] = line
                end
                lines[#lines + 1] = ""
            end
            for _, line in ipairs(emit.layoutReporters(physicalSymbol(program.symbol, tier), layout)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = ""
        end
    end

    -- Lua-callable entries with several scalar results cross the private C ABI
    -- as one explicitly laid-out aggregate. The wrapper immediately unpacks it;
    -- the type never becomes part of the Nupp source API.
    for _, program in ipairs(programs) do
        local resultTypes = program.resultTypes or {}
        if program.entryMode ~= "lua-builder" and #resultTypes > 1 then
            local resultName = scalarIR.cIdentifier("KsResult", program.symbol)
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(resultTypes) do
                lines[#lines + 1] = "    " .. emit.cType(resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. resultName .. ";"
            lines[#lines + 1] = ""
        end
    end

    -- The gang types and helpers, once, when any function chose a gang. A
    -- program without a lane body contributes none. It used to fall back to the
    -- widest shape, which put that shape's typedefs and helpers in files no gang
    -- was chosen for -- and on a target whose register class is narrower than
    -- the widest shape, a 32-byte vector returned by value is exactly the
    -- `-Wpsabi` the target model exists to avoid.
    local function hasLanes(statements: {scalarIR.Statement}): boolean
        for _, statement in ipairs(statements) do
            if statement.op == "fornum" then
                local loop = statement as scalarIR.Fornum
                if loop.lanes ~= nil or hasLanes(loop.body) then
                    return true
                end
            elseif statement.op == "if" then
                for _, clause in ipairs((statement as scalarIR.If).clauses) do
                    if hasLanes(clause.body) then
                        return true
                    end
                end
                if hasLanes((statement as scalarIR.If).elseBody or {}) then
                    return true
                end
            elseif statement.op == "while" or statement.op == "repeat" or statement.op == "block" then
                if hasLanes((statement as any).body as {scalarIR.Statement}) then
                    return true
                end
            end
        end

        return false
    end

    for _, program in ipairs(programs) do
        if program.lanes ~= nil or hasLanes(program.body or {}) then
            for _, line in ipairs(carried("ks_gang.h")) do
                lines[#lines + 1] = line
            end
            break
        end
    end

    for _, line in ipairs(carried("ks_scalar.h")) do
        lines[#lines + 1] = line
    end

    local simdWidths: {[integer]: boolean} = {}
    for _, program in ipairs(programs) do
        if program.simdWidth ~= nil and not simdWidths[program.simdWidth as integer] then
            simdWidths[program.simdWidth as integer] = true
            for _, line in ipairs(emit.simdPrelude(program.simdWidth as integer)) do
                lines[#lines + 1] = line
            end
        end
    end

    for _, program in ipairs(programs) do
        explicitWidth = program.simdWidth or 0
        reusableScratchName = program.reusableScratch
        builderEager = program.builderMode == "eager"
        fpTranscendentals = program.fpTranscendentals == true
        -- Byte tables the body reads that were known when it was compiled, at
        -- file scope so the compiler has their contents and their alignment. A
        -- read spells these exactly as it spells a rooted argument, which is
        -- why nothing between the source and here had to be taught about them.
        for _, constant in ipairs(program.constants or {}) do
            if not declared[constant.cName] then
                declared[constant.cName] = true
                local bytes: {string} = {}
                for index = 1, #constant.value do
                    bytes[index] = tostring(constant.value:byte(index))
                end
                lines[#lines + 1] = ("static const size_t ks_length_%s = %d;"):format(constant.cName, #constant.value)
                lines[
                    #lines + 1
                ] = (
                    "_Alignas(4) static const unsigned char ks_bytes_%s[] = {%s};"
                ):format(constant.cName, table.concat(bytes, ","))
            end
        end

        local helpers = program.helpers or {}
        for _, line in ipairs(emit.helpers(helpers)) do
            lines[#lines + 1] = line
        end

        local lanes = program.lanes
        local width = lanes ~= nil and (lanes as scalarIR.LaneBody).lanes or 0
        local resultTypes = program.resultTypes or {}
        local resultStruct = #resultTypes > 1 and scalarIR.cIdentifier("KsResult", program.symbol) or nil
        local layouts: {[string]: scalarIR.Layout} = {}
        for _, layout in ipairs(program.layouts or {}) do
            layouts[layout.name] = layout
        end
        local body = new emit.Body(helpers = helpers, lanes = width, layouts = layouts, resultStruct = resultStruct)
        local general = program.body ~= nil
        if program.entryMode == "lua-builder" then
            explicitScalar = false
            local byteRoots = 0
            for _, param in ipairs(program.params) do
                if param.type == "lua_bytes" then
                    byteRoots = byteRoots + 1
                end
            end
            lines[#lines + 1] = "static int " .. program.symbol .. "_lua(lua_State *L) {"
            lines[
                #lines + 1
            ] = "    if (!lua_checkstack(L, " .. tostring(
                verify.builderStack(program) + byteRoots + (byteRoots > 0 and 2 or 0)
            ) .. ")) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
            for position, param in ipairs(program.params) do
                if param.kind == "uniform" then
                    local read = param.type == "bool" and "lua_toboolean(L, " .. tostring(
                        position
                    ) .. ")" or "luaL_checknumber(L, " .. tostring(position) .. ")"
                    lines[
                        #lines + 1
                    ] = "    " .. emit.cType(
                        param.type
                    ) .. " p_" .. param.name .. " = (" .. emit.cType(param.type) .. ")(" .. read .. ");"
                elseif param.kind == "scalar" and (
                    param.type == "lua_string" or param.type == "lua_bytes" or param.type == "lua_value"
                ) then
                    -- The argument itself is the root. Source uses carry this
                    -- positive absolute stack index; no GC pointer is taken.
                    if param.type == "lua_string" or param.type == "lua_bytes" then
                        lines[#lines + 1] = "    size_t ks_length_" .. tostring(param.cName) .. " = 0u;"
                        lines[
                            #lines + 1
                        ] = "    const unsigned char *ks_bytes_" .. tostring(
                            param.cName
                        ) .. " = " .. (
                            param.type == "lua_bytes" and "ks_lua_bytes" or "(const unsigned char *)luaL_checklstring"
                        ) .. "(L, " .. tostring(position) .. ", &ks_length_" .. tostring(param.cName) .. ");"
                        lines[#lines + 1] = "    (void)ks_bytes_" .. tostring(param.cName) .. ";"
                    end
                else
                    error("Lua builders currently take scalar parameters", 0)
                end
            end
            for _, line in ipairs(emit.luaBlock(program.body or {}, 1, body)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = "    return 0;"
            lines[#lines + 1] = "}"
            lines[#lines + 1] = ""
        else
            local touched = emit.pointerSpans(program)
            local independentCounts = scalarIR.independentCounts(program)
            local params = emit.parameters(program.params, independentCounts, touched)
            local cResult = #resultTypes == 0 and "void" or resultStruct ~= nil and resultStruct or emit.cType(
                resultTypes[1]
            )

            --- One C definition of the kernel.
            local function implementation(symbol: string, forced: boolean): nil
                explicitScalar = forced and program.usesSimd == true
                body.forceScalar = forced
                independentSpanCounts = independentCounts
                if forced and general then
                    -- The block may declare locals before its first loop, so a
                    -- loop pragma cannot be placed at function entry. Keep this
                    -- test-only oracle wholly scalar instead.
                    lines[#lines + 1] = "KS_SCALAR_ORACLE"
                end
                lines[#lines + 1] = "__attribute__((noinline))"
                lines[#lines + 1] = "KS_API " .. cResult .. " " .. symbol .. "(" .. params .. ") {"
                if not general and independentCounts then
                    lines[#lines + 1] = "    size_t count = count_" .. (program.loop as scalarIR.Loop).count .. ";"
                end
                if program.fpContract == true then
                    for _, line in ipairs(emit.contractPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                if not general then
                    for _, line in ipairs(emit.bounds(program.rangeGuard)) do
                        lines[#lines + 1] = line
                    end
                end
                if forced and not general then
                    for _, line in ipairs(emit.forcedScalarPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                if general then
                    for _, line in ipairs(emit.block(program.body or {}, 1, body)) do
                        lines[#lines + 1] = line
                    end
                elseif lanes ~= nil and not forced then
                    for _, line in ipairs(emit.groupBound(width)) do
                        lines[#lines + 1] = line
                    end
                    for _, line in ipairs(emit.block((lanes as scalarIR.LaneBody).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = "    }"
                end
                if not general then
                    lines[#lines + 1] = "    for (; i < end; ++i) {"
                    for _, line in ipairs(emit.block((program.loop as scalarIR.Loop).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = "    }"
                end
                lines[#lines + 1] = "}"
                lines[#lines + 1] = ""
            end

            if not general or program.usesSimd == true or program.simdRequired == true then
                implementation(physicalSymbol(program.symbol .. "_forced_scalar", tier), true)
            end
            implementation(physicalSymbol(program.symbol, tier), false)
        end
    end

    local builders: {scalarIR.Program} = {}
    local registrar: string? = nil
    for _, program in ipairs(programs) do
        if program.entryMode == "lua-builder" then
            registrar = registrar or program.registrar
            if registrar ~= program.registrar then
                error("one translation unit carried multiple Lua registrars", 0)
            end
            builders[#builders + 1] = program
        end
    end
    if #builders > 0 then
        lines[#lines + 1] = "KS_API int " .. physicalSymbol(tostring(registrar), tier) .. "(lua_State *L) {"
        lines[#lines + 1] = "    if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
        lines[#lines + 1] = "    lua_createtable(L, 0, " .. tostring(#builders) .. ");"
        lines[#lines + 1] = "    int registry = lua_gettop(L);"
        for _, program in ipairs(builders) do
            lines[
                #lines + 1
            ] = "    lua_pushlstring(L, " .. cBytes(program.name) .. ", " .. tostring(#program.name) .. "u);"
            lines[#lines + 1] = "    lua_pushcclosure(L, " .. program.symbol .. "_lua, 0);"
            lines[#lines + 1] = "    lua_rawset(L, registry);"
        end
        lines[#lines + 1] = "    return 1;"
        lines[#lines + 1] = "}"
        lines[#lines + 1] = ""
    end

    return table.concat(lines, "\n") .. "\n"
end

export = emit
