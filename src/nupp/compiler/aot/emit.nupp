module nupp.compiler.aot.emit

--[[
Rendering verified AOT IR as C.

Generated C is a backend representation and not the safety boundary. Everything
this prints was proved before it ran -- span bounds, region relationships,
conversions, lane widths -- so nothing here decides anything, and a rule that
looks like it belongs in this file almost certainly belongs in the verifier
instead.

Two things it does owe. Numeric meaning has to survive: an ordinary operator is
binary64 and is not contracted or reassociated unless the source asked, a
physical store narrows and a physical load widens, and the explicitly
fixed-width operations round where the source said they would. And the same IR
has to render the same text every time, because an artifact cache keyed by it
would otherwise miss on every build and a fingerprint would call two identical
programs different.
]]

local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")
local target = require("nupp.compiler.aot.target")

local emit = {}
local explicitWidth = 0
local explicitScalar = false

--- The exported spelling of a logical program symbol in one tier.
local function physicalSymbol(symbol: string, tier: string?): string
    return tier ~= nil and target.symbol(symbol, tier as string) or symbol
end

--- The C spelling of each ordinary binary operator.
---
--- Comparisons are here too: in C they produce `int` rather than a boolean, but
--- every use this subset admits is a condition, and the IR has already typed
--- the result.
const emit.BINARY = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "!=",
    ["and"] = "&&",
    ["or"] = "||",
}

--- The C spelling of each elementwise lane verb.
---
--- Vector extensions give these their elementwise meaning, so a lane operation
--- is written as though it were scalar and the width comes from the operand
--- types rather than from the operator.
const emit.LANE_VERB = {
    ["add"] = " + ",
    ["sub"] = " - ",
    ["mul"] = " * ",
    ["div"] = " / ",
    ["lt"] = " < ",
    ["le"] = " <= ",
    ["gt"] = " > ",
    ["ge"] = " >= ",
    ["eq"] = " == ",
    ["ne"] = " != ",
}

--- The C spelling of each bitwise verb, on the gang's bit vector.
---
--- `sar` is absent: an arithmetic shift needs the operand reinterpreted as
--- signed first, so it is not one operator.
const emit.BITWISE = {["and"] = " & ", ["or"] = " | ", ["xor"] = " ^ ", ["shl"] = " << ", ["shr"] = " >> ",}

--- The C type each IR type is spelled as.
const emit.SCALAR_C = {
    ["bool"] = "bool",
    ["f64"] = "double",
    ["f32"] = "float",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
}

--- The C spelling of physical storage, distinct from the value a load creates.
const emit.SOURCE_C = {
    ["number"] = "double",
    ["float"] = "float",
    ["int8"] = "int8_t",
    ["int16"] = "int16_t",
    ["int32"] = "int32_t",
    ["uint8"] = "uint8_t",
    ["uint16"] = "uint16_t",
    ["uint32"] = "uint32_t",
}

--- The C element type behind each vector.
const emit.VECTOR_ELEMENT_C = {["f64"] = "double", ["f32"] = "float", ["i32"] = "int32_t", ["u32"] = "uint32_t",}

--- The C type of one IR type.
---
--- A vector renders as the typedef the prelude emitted for it, and a pointer to
--- a reified struct as that struct's own C name.
---
--- @raises when the IR names a type this backend has no spelling for
function emit.cType(typeName: string): string
    local scalar = emit.SCALAR_C[typeName]
    if scalar ~= nil then
        return scalar as string
    end
    if typeName == "simd_species_u8" then
        return "uint32_t"
    elseif typeName == "simd_vector_u8" or typeName == "simd_mask_u8" then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        return (explicitScalar and "ks_scalar_u8x" or "ks_u8x") .. tostring(explicitWidth)
    elseif typeName == "simd_mask_bits64" then
        return "KsMaskBits64"
    elseif typeName == "simd_table_u8x16" then
        return "KsTableU8x16"
    elseif typeName == "simd_padded_string_u8" then
        if explicitWidth ~= 16 and explicitWidth ~= 32 then
            error("explicit SIMD width was not selected", 0)
        end
        return "KsPaddedStringU8x" .. tostring(explicitWidth)
    end
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return "Ks" .. (layout as string) .. " *"
    end
    if typeName:match("^[fmiu]%d+x%d+$") ~= nil then
        return "ks_" .. typeName
    end

    error("no C type for " .. tostring(typeName), 0)
end

--- The physical C element type for a scalar span or field.
---
--- @raises when the physical source type has no C spelling
function emit.storageC(valueType: string, sourceType: string?): string
    if sourceType ~= nil then
        local physical = emit.SOURCE_C[sourceType as string]
        if physical ~= nil then
            return physical as string
        end
        error("no C storage type for " .. tostring(sourceType), 0)
    end

    return emit.cType(valueType)
end

--- The element and lane count a vector name states.
---
--- The name is the authority rather than a table beside it, because the two
--- would otherwise be able to disagree about what `f32x8` means.
---
--- @raises when the name is not a vector type
function emit.vectorParts(vector: string): (string, integer)
    local element = vector:match("^(%a%d+)x")
    local lanes = tonumber(vector:match("x(%d+)$"))
    if element == nil or lanes == nil then
        error("not a vector type: " .. tostring(vector), 0)
    end

    return element as string, lanes as integer
end

--- A binary64 literal, spelled so C reads back exactly what Nupp meant.
---
--- A whole number needs its point, or C makes it an `int` and integer division
--- silently replaces the binary64 the source wrote.
function emit.doubleLiteral(value: string): string
    if value:match("^-?%d+$") ~= nil then
        return value .. ".0"
    end

    return value
end

--- One scalar expression, as a C expression.
---
--- Parenthesised generously: the IR carries the tree, C would reparse it by
--- precedence, and the two do not have to agree for this to be right.
--- @raises when verified IR names an operation with no backend spelling
function emit.scalar(node: scalarIR.Expr): string
    local operation = node.op

    if operation == "constant" then
        return emit.doubleLiteral((node as scalarIR.Constant).value)
    elseif operation == "constant_i32" then
        local integer = node as scalarIR.IntConstant
        local number = tonumber(integer.value) or 0
        if integer.type == "u32" then
            return "UINT32_C(" .. ("%.0f"):format(number) .. ")"
        elseif number == -2147483648 then
            return "(-INT32_C(2147483647) - INT32_C(1))"
        elseif number < 0 then
            return "(-INT32_C(" .. ("%.0f"):format(-number) .. "))"
        end

        return "INT32_C(" .. ("%.0f"):format(number) .. ")"
    elseif operation == "bool" then
        return (node as scalarIR.Bool).value and "true" or "false"
    elseif operation == "uniform" then
        return "p_" .. (node as scalarIR.Name).name
    elseif operation == "span_count" then
        return "((double)count_" .. (node as scalarIR.SpanCount).span .. ")"
    elseif operation == "lua_string_length" then
        local bytes = (node as scalarIR.LuaBytes).bytes as scalarIR.Name
        return "ks_lua_string_length(L, ks_length_" .. tostring(bytes.cName) .. ")"
    elseif operation == "lua_string_byte" or operation == "lua_string_u32" then
        local loaded = node as scalarIR.LuaBytes
        local bytes = loaded.bytes as scalarIR.Name
        local helper = operation == "lua_string_byte" and "ks_lua_string_byte" or "ks_lua_string_u32"
        return helper .. "(L, ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(loaded.index as scalarIR.Expr) .. ")"
    elseif operation == "lua_builder_depth" or operation == "lua_builder_kind" or operation == "lua_builder_count" then
        local query = node as scalarIR.LuaBuilderQuery
        local which = operation == "lua_builder_depth" and "0u" or operation == "lua_builder_kind" and "1u" or "2u"
        return "ks_lua_builder_query(L, &" .. tostring((query.builder as scalarIR.Name).cName) .. ", " .. which .. ")"
    elseif operation == "lua_scratch_u32_get" then
        local loaded = node as scalarIR.LuaScratchU32Get
        return "ks_lua_scratch_u32_get(L, &" .. tostring(
            (loaded.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(loaded.index) .. ")"
    elseif operation == "lua_scratch_u32_append_bits" then
        local appended = node as scalarIR.LuaScratchU32AppendBits
        return "ks_lua_scratch_u32_append_bits(L, &" .. tostring(
            (appended.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(
            appended.index
        ) .. ", " .. emit.scalar(appended.base) .. ", " .. emit.scalar(appended.bits) .. ")"
    elseif operation == "lua_scratch_u8_get" then
        local loaded = node as scalarIR.LuaScratchU8Get
        return "ks_lua_scratch_u8_get(L, &" .. tostring(
            (loaded.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(loaded.index) .. ")"
    elseif operation == "local" or operation == "helper_param" then
        return (node as scalarIR.Name).cName or ""
    elseif operation == "load" then
        local loaded = node as scalarIR.Load
        local index = loaded.cursorCName ~= nil and "((size_t)" .. tostring(
            loaded.cursorCName
        ) .. ")" or loaded.indexCName == "i" and "i" or "((size_t)(" .. tostring(loaded.indexCName) .. " - 1))"
        return "p_" .. loaded.span .. "[" .. index .. "]"
    elseif operation == "element_ref" then
        local referenced = node as scalarIR.ElementRef
        local index = referenced.cursorCName ~= nil and "((size_t)" .. tostring(
            referenced.cursorCName
        ) .. ")" or referenced.indexCName == "i" and "i" or "((size_t)(" .. tostring(referenced.indexCName) .. " - 1))"
        return "(&p_" .. referenced.span .. "[" .. index .. "])"
    elseif tostring(operation):match("^simd_") ~= nil then
        local simd = node as scalarIR.Simd
        local args = simd.args
        local suffix = "u8x" .. tostring(explicitWidth)
        local helper = explicitScalar and "ks_scalar_" or "ks_"
        if operation == "simd_species_u8" or operation == "simd_lanes" then
            return "UINT32_C(" .. tostring(explicitWidth) .. ")"
        elseif operation == "simd_load_u8" then
            return helper .. "load_" .. suffix .. "(p_" .. tostring(
                simd.span
            ) .. ", count_" .. tostring(simd.span) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_load_string_u8" then
            local bytes = args[2] as scalarIR.Name
            return helper .. "load_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(args[3]) .. ")"
        elseif operation == "simd_splat_u8" then
            return helper .. "splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_shr_u8" then
            return helper .. "shr_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_table_u8x16" then
            local values: {string} = {}
            for index, argument in ipairs(args) do
                values[index] = "(uint8_t)" .. emit.scalar(argument)
            end
            return "((KsTableU8x16){{" .. table.concat(values, ", ") .. "}})"
        elseif operation == "simd_lookup16_u8" then
            return helper .. "lookup16_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_align_bytes_u8" then
            return helper .. "align_" .. suffix .. "(" .. emit.scalar(
                args[1]
            ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
        elseif operation == "simd_padded_string_u8" then
            local bytes = args[1] as scalarIR.Name
            return "ks_padded_string_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ")"
        elseif operation == "simd_padded_length" then
            return "(" .. emit.scalar(args[1]) .. ").length"
        elseif operation == "simd_padded_full_length" then
            return "(" .. emit.scalar(args[1]) .. ").full_length"
        elseif operation == "simd_padded_tail_length" then
            return "(" .. emit.scalar(args[1]) .. ").tail_length"
        elseif operation == "simd_padded_load_full_u8" then
            return helper .. "padded_load_full_" .. suffix .. "(&" .. emit.scalar(
                args[1]
            ) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_padded_load_tail_u8" then
            return helper .. "padded_load_tail_" .. suffix .. "(&" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_tail_u8" then
            return helper .. "tail_" .. suffix .. "(" .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_eq_u8" then
            if explicitScalar then
                return helper .. "eq_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(
                args[1]
            ) .. " == ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[2]) .. "))"
        elseif operation == "simd_range_u8" then
            if explicitScalar then
                return helper .. "range_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(args[2]) .. ", (uint8_t)" .. emit.scalar(args[3]) .. ")"
            end
            local value = emit.scalar(args[1])
            return "((" .. value .. " >= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(
                args[2]
            ) .. ")) & (" .. value .. " <= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(args[3]) .. ")))"
        elseif operation == "simd_vec_and" or operation == "simd_mask_and" then
            if explicitScalar then
                return helper .. "and_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " & " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_or" or operation == "simd_mask_or" then
            if explicitScalar then
                return helper .. "or_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " | " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_xor" or operation == "simd_mask_xor" then
            if explicitScalar then
                return helper .. "xor_" .. suffix .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
            end
            return "(" .. emit.scalar(args[1]) .. " ^ " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_vec_not" or operation == "simd_mask_not" then
            if explicitScalar then
                return helper .. "not_" .. suffix .. "(" .. emit.scalar(args[1]) .. ")"
            end
            return "(~" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_select_u8" then
            if explicitScalar then
                return helper .. "select_" .. suffix .. "(" .. emit.scalar(
                    args[1]
                ) .. ", " .. emit.scalar(args[2]) .. ", " .. emit.scalar(args[3]) .. ")"
            end
            return "((" .. emit.scalar(
                args[1]
            ) .. " & " .. emit.scalar(
                args[2]
            ) .. ") | (~" .. emit.scalar(args[1]) .. " & " .. emit.scalar(args[3]) .. "))"
        elseif operation == "simd_bits" then
            return helper .. "bits_" .. suffix .. "(" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_any" then
            return "(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(args[1]) .. ") != 0u)"
        elseif operation == "simd_all" then
            local all = explicitWidth == 32 and "UINT32_MAX" or "UINT32_C(65535)"
            return "(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(args[1]) .. ") == " .. all .. ")"
        elseif operation == "simd_count" then
            return "((uint32_t)__builtin_popcount(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(
                args[1]
            ) .. ")))"
        elseif operation == "simd_mask64" then
            return "ks_mask64(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_mask64_and" or operation == "simd_mask64_or" or operation == "simd_mask64_xor" then
            local verb = operation == "simd_mask64_and" and "and" or operation == "simd_mask64_or" and "or" or "xor"
            return "ks_mask64_" .. verb .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_mask64_not" then
            return "ks_mask64_not(" .. emit.scalar(args[1]) .. ")"
        elseif operation == "simd_mask64_shl" or operation == "simd_mask64_shr" then
            local verb = operation == "simd_mask64_shl" and "shl" or "shr"
            return "ks_mask64_" .. verb .. "(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_mask64_prefix_xor" then
            return "ks_mask64_prefix_xor(" .. emit.scalar(args[1]) .. ", " .. emit.scalar(args[2]) .. ")"
        elseif operation == "simd_mask64_low" then
            return "(" .. emit.scalar(args[1]) .. ").low"
        elseif operation == "simd_mask64_high" then
            return "(" .. emit.scalar(args[1]) .. ").high"
        elseif operation == "simd_mask64_any" then
            return "((" .. emit.scalar(args[1]) .. ").low != 0u || (" .. emit.scalar(args[1]) .. ").high != 0u)"
        elseif operation == "simd_mask64_count" then
            return "((uint32_t)(__builtin_popcount((" .. emit.scalar(
                args[1]
            ) .. ").low) + __builtin_popcount((" .. emit.scalar(args[1]) .. ").high)))"
        elseif operation == "simd_mask64_first" then
            return "((" .. emit.scalar(
                args[1]
            ) .. ").low != 0u ? (uint32_t)__builtin_ctz((" .. emit.scalar(
                args[1]
            ) .. ").low) : ((" .. emit.scalar(
                args[1]
            ) .. ").high != 0u ? UINT32_C(32) + (uint32_t)__builtin_ctz((" .. emit.scalar(
                args[1]
            ) .. ").high) : UINT32_C(64)))"
        elseif operation == "simd_mask64_clear_first" then
            return "((" .. emit.scalar(
                args[1]
            ) .. ").low != 0u ? ks_mask64((" .. emit.scalar(
                args[1]
            ) .. ").low & ((" .. emit.scalar(
                args[1]
            ) .. ").low - 1u), (" .. emit.scalar(
                args[1]
            ) .. ").high) : ks_mask64(0u, (" .. emit.scalar(
                args[1]
            ) .. ").high & ((" .. emit.scalar(args[1]) .. ").high - 1u)))"
        end
        error("no C form for SIMD operation " .. tostring(operation), 0)
    elseif operation == "field_load" then
        local field = node as scalarIR.FieldLoad

        return "(" .. emit.scalar(field.object) .. "->" .. field.field .. ")"
    elseif operation == "neg" then
        return "(-(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "not" then
        return "(!(" .. emit.scalar((node as scalarIR.Unary).value) .. "))"
    elseif operation == "narrow_f64_f32" then
        return "(float)(" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "widen_f32_f64" or operation == "int_to_f64" then
        return "((double)" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    elseif operation == "numeric_cast" then
        local target = node.type == "u32" and "uint32_t" or "int32_t"

        return "((" .. target .. ")" .. emit.scalar((node as scalarIR.Convert).value) .. ")"
    end

    local operator = emit.BINARY[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "(" .. emit.scalar(binary.left) .. " " .. (operator as string) .. " " .. emit.scalar(binary.right) .. ")"
    end

    return emit.scalarCall(node)
end

--- The scalar forms that render as a call rather than an operator: the closed
--- math set, the fixed-width operations, and the corrected three.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarCall(node: scalarIR.Expr): string
    local operation = node.op

    -- C float arithmetic is single-rounded -- it does not promote to double --
    -- so this is the binary32 operation the source asked for, and the casts say
    -- so rather than relying on the operands already being float.
    local fixed = {["f32_add"] = "+", ["f32_sub"] = "-", ["f32_mul"] = "*", ["f32_div"] = "/",}
    local operator = fixed[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "((float)(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " (float)(" .. emit.scalar(binary.right) .. "))"
    end

    -- Wrapping happens in unsigned, where overflow is defined, and comes back.
    local wrapping = {["i32_add"] = "+", ["i32_sub"] = "-", ["i32_mul"] = "*"}
    operator = wrapping[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    local unsigned = {
        ["u32_add"] = "+",
        ["u32_sub"] = "-",
        ["u32_mul"] = "*",
        ["u32_and"] = "&",
        ["u32_or"] = "|",
        ["u32_xor"] = "^",
    }
    operator = unsigned[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Binary

        return "((uint32_t)(" .. emit.scalar(
            binary.left
        ) .. " " .. (operator as string) .. " " .. emit.scalar(binary.right) .. "))"
    end

    if operation == "u32_shl" or operation == "u32_shr" then
        local binary = node as scalarIR.Binary
        local shift = "(" .. emit.scalar(binary.right) .. " & UINT32_C(31))"
        return "((uint32_t)(" .. emit.scalar(
            binary.left
        ) .. (operation == "u32_shl" and " << " or " >> ") .. shift .. "))"
    end

    if operation == "f32_sqrt" then
        return "sqrtf(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u32_not" then
        return "((uint32_t)(~" .. emit.scalar((node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_popcount" then
        return "((uint32_t)__builtin_popcount(" .. emit.scalar((node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_ctz" then
        local value = emit.scalar((node as scalarIR.FixedUnary).value)
        return "((uint32_t)(" .. value .. " == 0u ? 32u : __builtin_ctz(" .. value .. ")))"
    elseif operation == "u32_clz" then
        local value = emit.scalar((node as scalarIR.FixedUnary).value)
        return "((uint32_t)(" .. value .. " == 0u ? 32u : __builtin_clz(" .. value .. ")))"
    end

    local corrected = {["f32_min"] = "nupp_f32_min", ["f32_max"] = "nupp_f32_max", ["f32_fma"] = "nupp_f32_fma",}
    local helper = corrected[operation]
    if helper ~= nil then
        local parts: {string} = {}
        local three = node as scalarIR.Corrected
        if three.args ~= nil then
            for position, argument in ipairs(three.args as {scalarIR.Expr}) do
                parts[position] = emit.scalar(argument)
            end
        else
            local binary = node as scalarIR.Binary
            parts[1] = emit.scalar(binary.left)
            parts[2] = emit.scalar(binary.right)
        end

        return (helper as string) .. "(" .. table.concat(parts, ", ") .. ")"
    end

    return emit.scalarBits(node)
end

--- The bitwise family, the closed math set, and a helper call.
---
--- Bitwise work happens in unsigned, where overflow and shifts are defined, and
--- comes back as int32. Shift counts are masked to 31 the way `nupp.math.i32`
--- masks them, and an arithmetic shift goes through a helper because C's `>>`
--- on a negative signed value is implementation-defined.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarBits(node: scalarIR.Expr): string
    local operation = node.op
    local binary = node as scalarIR.Binary

    if operation == "bnot" then
        return "((int32_t)(~nupp_u32(" .. emit.scalar((node as scalarIR.Unary).value) .. ")))"
    end

    local bitwise = {["band"] = "&", ["bor"] = "|", ["bxor"] = "^"}
    local operator = bitwise[operation]
    if operator ~= nil then
        return "((int32_t)(nupp_u32(" .. emit.scalar(
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(binary.right) .. ")))"
    end

    if operation == "lshift" or operation == "rshift" or operation == "arshift" then
        local left = "nupp_u32(" .. emit.scalar(binary.left) .. ")"
        local shift = "(nupp_u32(" .. emit.scalar(binary.right) .. ") & 31u)"
        if operation == "lshift" then
            return "((int32_t)(" .. left .. " << " .. shift .. "))"
        elseif operation == "rshift" then
            return "((int32_t)(" .. left .. " >> " .. shift .. "))"
        end

        return "nupp_arshift(" .. left .. ", " .. shift .. ")"
    end

    if operation == "mod" then
        return "fmod(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    end
    if operation == "pow" then
        return "pow(" .. emit.scalar(binary.left) .. ", " .. emit.scalar(binary.right) .. ")"
    elseif operation == "helper_call" then
        local call = node as scalarIR.HelperCall
        local parts: {string} = {}
        for position, argument in ipairs(call.args) do
            parts[position] = emit.scalar(argument)
        end

        return call.cName .. "(" .. table.concat(parts, ", ") .. ")"
    elseif operation == "math" then
        return emit.math(node as scalarIR.Math)
    end

    error("no C form for scalar operation " .. tostring(operation), 0)
end

--- One operation from the closed math set.
---
--- `min` and `max` go through helpers rather than `fmin`/`fmax`, because Lua's
--- answer for them is a comparison and not IEEE `minNum`. `deg` and `rad` are
--- multiplications rather than library calls, and a two-argument `log` is a
--- ratio, which is what ordinary Nupp computes.
---
--- @raises when the intrinsic is outside the closed set
function emit.math(node: scalarIR.Math): string
    local parts: {string} = {}
    for position, argument in ipairs(node.args) do
        parts[position] = emit.scalar(argument)
    end

    return emit.mathFrom(node.intrinsic, parts)
end

--- The same, over arguments that are already rendered.
---
--- The lane expansion needs this: it renders each argument vector once into a
--- temporary and then indexes it per lane, so what it has are strings. Passing
--- them back through the expression renderer meant wrapping each in a fictional
--- node that had to be a member of the IR without being anything the IR means.
---
--- @raises when the intrinsic is outside the closed set
function emit.mathFrom(intrinsic: string, parts: {string}): string
    if intrinsic == "min" or intrinsic == "max" then
        local call = "nupp_" .. intrinsic .. "2(" .. parts[1] .. ", " .. parts[2] .. ")"
        for position = 3, #parts do
            call = "nupp_" .. intrinsic .. "2(" .. call .. ", " .. parts[position] .. ")"
        end

        return call
    end
    if intrinsic == "log" and #parts == 2 then
        return "(log(" .. parts[1] .. ") / log(" .. parts[2] .. "))"
    end
    if intrinsic == "deg" then
        return "(" .. parts[1] .. " * (180.0 / M_PI))"
    elseif intrinsic == "rad" then
        return "(" .. parts[1] .. " * (M_PI / 180.0))"
    end

    local named = {
        ["sqrt"] = "sqrt",
        ["abs"] = "fabs",
        ["floor"] = "floor",
        ["ceil"] = "ceil",
        ["sin"] = "sin",
        ["cos"] = "cos",
        ["tan"] = "tan",
        ["asin"] = "asin",
        ["acos"] = "acos",
        ["atan"] = "atan",
        ["atan2"] = "atan2",
        ["sinh"] = "sinh",
        ["cosh"] = "cosh",
        ["tanh"] = "tanh",
        ["exp"] = "exp",
        ["log"] = "log",
        ["pow"] = "pow",
        ["fmod"] = "fmod",
    }
    local name = named[intrinsic]
    if name == nil then
        error("no C form for math operation " .. tostring(intrinsic), 0)
    end

    return (name as string) .. "(" .. table.concat(parts, ", ") .. ")"
end

--- How many lane temporaries this function has named so far.
---
--- Reset by `emit.begin`, because the same IR has to render the same C. A
--- counter that carried across functions would make one function's text depend
--- on what was compiled before it, and an artifact cache keyed on the source
--- would then be wrong rather than merely cold.
local laneTemporary = 0

local luaTemporary = 0

--- Starts one function's emission.
function emit.begin(): nil
    laneTemporary = 0
    luaTemporary = 0
    explicitWidth = 0
    explicitScalar = false
end

--- Expands a vector operation one lane at a time, each operand evaluated once.
---
--- Without the temporaries every operand is rendered into every lane slot, so a
--- vector expression is recomputed once per lane to take one element out of it,
--- and nesting multiplies that. It is what made a memory-bound kernel eight
--- times slower lane-parallel than scalar.
---
--- @param build the scalar expression for one lane, given the temporaries
---   holding the operand vectors and which lane this is
function emit.perLane(vector: string, args: {any}, build: function({string}, integer): string): string
    laneTemporary = laneTemporary + 1

    local names: {string} = {}
    local bindings: {string} = {}
    for position, argument in ipairs(args) do
        names[position] = ("lt%d_%d"):format(laneTemporary, position)
        bindings[position] = ("ks_%s %s = %s;"):format(vector, names[position], emit.lane(argument))
    end

    local _, lanes = emit.vectorParts(vector)
    local parts: {string} = {}
    for index = 0, lanes - 1 do
        parts[index + 1] = build(names, index)
    end

    return "({ " .. table.concat(bindings, " ") .. " (ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "}; })"
end

--- Every operand of one lane operation, each taken from the same lane.
local function atLane(names: {string}, index: integer): {string}
    local parts: {string} = {}
    for position, name in ipairs(names) do
        parts[position] = name .. "[" .. tostring(index) .. "]"
    end

    return parts
end

--- One lane expression, as a C expression.
---
--- Anything that is not a lane form falls through to `emit.scalar`: a uniform
--- inside a lane expression is the same value it would be in a scalar body, and
--- rendering it twice would be two chances for the two to differ.
function emit.lane(node: lane.Expr | scalarIR.Expr): string
    local operation = node.op
    local vector = tostring(node.type)

    if operation == "vmask" then
        local mask = node as lane.MaskOp
        if mask.verb == "not" then
            return "(~" .. emit.lane(mask.args[1]) .. ")"
        else
            return "(" .. emit.lane(
                mask.args[1]
            ) .. (mask.verb == "and" and " & " or " | ") .. emit.lane(mask.args[2]) .. ")"
        end
    elseif operation == "vshort" then
        -- Both sides already ran: the rewrite proved them total before it turned
        -- the short circuit into a mask, so this is the bitwise combination and
        -- not a branch.
        local short = node as lane.ShortCircuit

        return "(" .. emit.lane(
            short.args[1]
        ) .. (short.verb == "and" and " & " or " | ") .. emit.lane(short.args[2]) .. ")"
    elseif operation == "vbinary" then
        local operator = node as lane.Binary

        return "(" .. emit.lane(
            operator.args[1]
        ) .. tostring(emit.LANE_VERB[operator.verb]) .. emit.lane(operator.args[2]) .. ")"
    elseif operation == "vunary" then
        local operator = node as lane.Unary
        if operator.verb == "neg" then
            return "(-" .. emit.lane(operator.args[1]) .. ")"
        else
            -- Elementwise, through the width's own library call, so the lane
            -- form is the same operation the scalar one performs.
            local element, lanes = emit.vectorParts(vector)
            local call = element == "f32" and "sqrtf(" or "sqrt("
            local parts: {string} = {}
            for index = 0, lanes - 1 do
                parts[index + 1] = call .. emit.lane(operator.args[1]) .. "[" .. tostring(index) .. "])"
            end

            return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
        end
    elseif operation == "vsplat" then
        return "ks_splat_" .. vector .. "(" .. emit.lane((node as lane.Splat).args[1]) .. ")"
    elseif operation == "vbool_splat" then
        -- Suffixed by the mask it produces, so two gangs can share one file.
        return "ks_bool_mask_" .. vector .. "(" .. emit.lane((node as lane.BoolSplat).args[1]) .. ")"
    elseif operation == "vselect" then
        local args = (node as lane.Select).args

        return "ks_sel_" .. vector .. "(" .. emit.lane(
            args[1]
        ) .. ", " .. emit.lane(args[2]) .. ", " .. emit.lane(args[3]) .. ")"
    elseif operation == "vfield_load" then
        local load = node as lane.FieldLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]." .. load.field
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vspan_load" then
        local load = node as lane.SpanLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]"
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vbitwise" then
        return emit.laneBits(node as lane.Bitwise)
    elseif operation == "vround" then
        -- Out to the narrow element and straight back. One rounding, which is
        -- what makes this the same answer as the native narrow instruction.
        local rounded = node as lane.Round

        return "__builtin_convertvector(__builtin_convertvector(" .. emit.lane(
            rounded.args[1]
        ) .. ", ks_" .. rounded.narrow .. "), ks_" .. vector .. ")"
    elseif operation == "vconvert" then
        -- The arithmetic conversion, not a reinterpretation: widening is exact
        -- and narrowing rounds once, which is what the source asked for at the
        -- point it changed width.
        return "__builtin_convertvector(" .. emit.lane((node as lane.Convert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vmask_cast" then
        -- A mask lane is all ones or all zeros, so widening sign-extends -1 to
        -- -1 and narrowing truncates it to -1. Both preserve exactly the two
        -- values a mask has, which is what makes this a conversion.
        return "__builtin_convertvector(" .. emit.lane((node as lane.MaskCast).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vbits" then
        return "__builtin_convertvector(" .. emit.lane((node as lane.BitConvert).args[1]) .. ", ks_" .. vector .. ")"
    elseif operation == "vcorrected" then
        -- One scalar helper call per lane, the same helper the scalar body
        -- calls, so the correction cannot be right in one form and wrong in the
        -- other.
        local call = node as lane.Corrected

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return call.helper .. "(" .. table.concat(atLane(names, index), ", ") .. ")"
        end)
    elseif operation == "vmath" then
        -- One scalar call per lane, rendered through the ordinary math path so
        -- the lane-parallel form cannot drift from the scalar one. Clang
        -- recognises the shape and uses a vector library call where it has one.
        local call = node as lane.Math

        return emit.perLane(vector, call.args, function(names: {string}, index: integer): string
            return emit.mathFrom(call.intrinsic, atLane(names, index))
        end)
    end

    return emit.scalar(node as scalarIR.Expr)
end

--- The bitwise family, on the gang's bit vector.
---
--- A shift count is masked to 31 the way `nupp.math.i32` masks it. An arithmetic
--- shift reinterprets the operand as signed first, because the bit vector is
--- unsigned and C's `>>` would otherwise fill with zeros.
function emit.laneBits(node: lane.Bitwise): string
    local verb = node.verb
    local vector = tostring(node.type)
    if verb == "not" then
        return "(~" .. emit.lane(node.args[1]) .. ")"
    elseif verb == "sar" then
        return "((ks_" .. vector .. ")(((ks_i" .. vector:sub(
            2
        ) .. ")" .. emit.lane(node.args[1]) .. ") >> (" .. emit.lane(node.args[2]) .. " & 31)))"
    end

    local right = emit.lane(node.args[2])
    if verb == "shl" or verb == "shr" then
        right = "(" .. right .. " & 31)"
    end

    return "(" .. emit.lane(node.args[1]) .. tostring(emit.BITWISE[verb]) .. right .. ")"
end

--- One reified struct, as a C type whose layout the wrapper checks.
---
--- Nothing here asserts the layout matches: the generated module compares
--- `layoutof` against what the compiled object reports, at load, before the
--- wrapper is exposed. A struct whose C compiler laid it out differently is
--- caught there rather than corrupting memory here.
function emit.layout(layout: scalarIR.Layout): {string}
    local lines: {string} = {"typedef struct {"}
    for _, field in ipairs(layout.fields) do
        lines[#lines + 1] = "    " .. emit.storageC(field.type, field.sourceType) .. " " .. field.name .. ";"
    end
    lines[#lines + 1] = "} " .. layout.cName .. ";"

    return lines
end

--- The private C signature of one kernel.
---
--- A writable span is `restrict` and a readable one is not, which is the alias
--- matrix the checker proved, stated where the C compiler can use it. Nothing
--- infers it from the pointer types.
function emit.parameters(params: {any}, independentCounts: boolean?): string
    local parts: {string} = {}
    for position, param in ipairs(params) do
        local name = "p_" .. param.name
        if param.kind == "write_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(param.type, param.sourceType)
            parts[position] = element .. " *restrict " .. name
        elseif param.kind == "read_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(param.type, param.sourceType)
            parts[position] = "const " .. element .. " *" .. name
        else
            parts[position] = emit.cType(param.type) .. " " .. name
        end
    end
    if independentCounts then
        for _, param in ipairs(params) do
            if param.kind == "write_span" or param.kind == "read_span" then
                parts[#parts + 1] = "size_t count_" .. param.name
            end
        end
    else
        parts[#parts + 1] = "size_t count"
    end

    return table.concat(parts, ", ")
end

--- Where the loop starts and stops.
---
--- A guarded range was proved in bounds before this ran, so the generated loop
--- reads it rather than checking it again. Without one the whole span is
--- covered.
function emit.bounds(rangeGuard: scalarIR.RangeGuard?): {string}
    if rangeGuard == nil then
        return {"    size_t i = 0;", "    size_t end = count;"}
    end

    return {
        "    (void)count;",
        "    size_t i = (size_t)(p_" .. rangeGuard.first .. " - 1.0);",
        "    size_t end = (size_t)p_" .. rangeGuard.last .. ";",
    }
end

--- The group loop's bounds, for a body that lowered lane-parallel.
---
--- Whole groups only. The remainder runs the same body one iteration at a time,
--- because a masked final group would still read the addresses it masked off and
--- the last element of a span may be the last byte of a page.
function emit.groupBound(lanes: integer): {string}
    local width = tostring(lanes)

    return {
        "    size_t groups = (end > i) ? ((end - i) / " .. width .. ") * " .. width .. " + i : i;",
        "    for (; i < groups; i += " .. width .. ") {",
    }
end

--- Asking one function for a relaxation the source named.
---
--- Scoped to the function rather than set as a build flag, so a relaxation one
--- function asked for cannot quietly change another's answers.
function emit.contractPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang fp contract(fast)", "#endif",}
end

--- Holding the oracle scalar.
---
--- The forced-scalar body is what the lane-parallel one is compared against, so
--- it must not share its lowering -- including whatever the C compiler would
--- have done on its own.
function emit.forcedScalarPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang loop vectorize(disable) interleave(disable)", "#endif",}
end

--- The C integer type behind each gang's mask.
---
--- A mask lane is as wide as the values it selects between, so a binary64 gang
--- masks with 64-bit lanes and a 32-bit gang with 32-bit ones.
const emit.MASK_C = {
    ["m64x8"] = "long long",
    ["m64x4"] = "long long",
    ["m32x8"] = "int",
    ["m64x2"] = "long long",
    ["m32x4"] = "int",
    ["m32x2"] = "int",
}

--- The C integer type behind one mask.
---
--- Raises rather than returning nothing. A missing entry used to reach the
--- output as the word `nil` in a typedef, which is a C compiler's problem to
--- report on whichever target first selected that gang -- and this backend's to
--- have emitted.
---
--- @raises when the mask has no C type, which is a gang naming one nobody added
function emit.maskC(mask: string): string
    local spelling = emit.MASK_C[mask]
    if spelling == nil then
        error("no C type for the mask " .. tostring(mask), 0)
    end

    return spelling as string
end

--- What every generated file starts with.
function emit.includes(): {string}
    return {
        "/* Generated from verified test-only native C IR. */",
        "#include <math.h>",
        "#include <string.h>",
        "#include <stdbool.h>",
        "#include <stddef.h>",
        "#include <stdint.h>",
        "#include <stdlib.h>",
        "#if defined(__aarch64__)",
        "#include <arm_neon.h>",
        "#elif defined(__x86_64__) || defined(_M_X64)",
        "#include <immintrin.h>",
        "#endif",
        "/* Windows exports nothing from a shared library unless it is asked to,",
        " * so a wrapper that loaded one would find no symbol in it. Everywhere",
        " * else a definition is exported by being one. */",
        "#if defined(_WIN32)",
        "#define KS_API __declspec(dllexport)",
        "#else",
        "#define KS_API",
        "#endif",
        "/* Clang targeting MSVC defines neither __GNUC__ nor the MSVC warning set,",
        " * so keying this on __GNUC__ alone left the attribute empty on the one",
        " * compiler that still warns about an unused static function. */",
        "#if defined(__GNUC__) || defined(__clang__)",
        "#define KS_UNUSED __attribute__((unused))",
        "#else",
        "#define KS_UNUSED",
        "#endif",
        "/* The test-only scalar oracle must not be vectorized back into the thing",
        " * it exists to be compared against. Clang spells that `optnone`; GCC has",
        " * no such attribute and warns about the one it does not know, so it gets",
        " * the equivalent it does have. */",
        "#if defined(__clang__)",
        "#define KS_OPTNONE __attribute__((optnone))",
        "#elif defined(__GNUC__)",
        "#define KS_OPTNONE __attribute__((optimize(\"O0\")))",
        "#else",
        "#define KS_OPTNONE",
        "#endif",
        "/* A count that came in as a uint32_t can only overflow the byte product",
        " * where size_t is no wider than it is. On a 64-bit size_t the comparison",
        " * is provably false, which is a -Wtype-limits error rather than a guard. */",
        "#if SIZE_MAX <= 0xFFFFFFFFu",
        "#define KS_COUNT_OVERFLOWS(n, size) ((size_t)(n) > SIZE_MAX / (size))",
        "#else",
        "#define KS_COUNT_OVERFLOWS(n, size) (0)",
        "#endif",
        "#ifndef M_PI",
        "#define M_PI 3.14159265358979323846264338327950288",
        "#endif",
        "typedef struct { uint32_t low, high; } KsMaskBits64;",
        "typedef struct { uint8_t lane[16]; } KsTableU8x16;",
        "static KS_UNUSED KsMaskBits64 ks_mask64(uint32_t low, uint32_t high) { KsMaskBits64 out = {low, high}; return out; }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_and(KsMaskBits64 a, KsMaskBits64 b) { return ks_mask64(a.low & b.low, a.high & b.high); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_or(KsMaskBits64 a, KsMaskBits64 b) { return ks_mask64(a.low | b.low, a.high | b.high); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_xor(KsMaskBits64 a, KsMaskBits64 b) { return ks_mask64(a.low ^ b.low, a.high ^ b.high); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_not(KsMaskBits64 a) { return ks_mask64(~a.low, ~a.high); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_shl(KsMaskBits64 a, uint32_t n) { if (n >= 64u) return ks_mask64(0u, 0u); if (n == 0u) return a; if (n >= 32u) return ks_mask64(0u, a.low << (n - 32u)); return ks_mask64(a.low << n, (a.high << n) | (a.low >> (32u - n))); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_shr(KsMaskBits64 a, uint32_t n) { if (n >= 64u) return ks_mask64(0u, 0u); if (n == 0u) return a; if (n >= 32u) return ks_mask64(a.high >> (n - 32u), 0u); return ks_mask64((a.low >> n) | (a.high << (32u - n)), a.high >> n); }",
        "static KS_UNUSED KsMaskBits64 ks_mask64_prefix_xor(KsMaskBits64 a, bool carry) { uint32_t lo = a.low, hi = a.high; lo ^= lo << 1; lo ^= lo << 2; lo ^= lo << 4; lo ^= lo << 8; lo ^= lo << 16; hi ^= hi << 1; hi ^= hi << 2; hi ^= hi << 4; hi ^= hi << 8; hi ^= hi << 16; if ((lo & UINT32_C(0x80000000)) != 0u) hi = ~hi; if (carry) { lo = ~lo; hi = ~hi; } return ks_mask64(lo, hi); }",
        "",
    }
end

--- The baseline runtime detector shared by every wrapper in one AOT library.
---
--- Compiler builtins account for the processor and the operating system's
--- enabled register state. This unit is compiled without an optional tier, so
--- asking the question cannot itself execute the instructions it is asking
--- about.
---
--- `__builtin_cpu_supports` is answered at run time by a support routine in the
--- compiler's own runtime library -- `__cpu_model` and `__cpu_indicator_init`.
--- Targeting the MSVC ABI links against the Microsoft runtime instead, which
--- has neither, so the builtin compiles and then fails to link. There the same
--- question is asked of `CPUID` directly, which needs no runtime library at
--- all.
function emit.featureDetector(): string
    local lines = emit.includes()
    lines[#lines + 1] = "#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))"
    lines[#lines + 1] = "#include <intrin.h>"
    lines[#lines + 1] = "#endif"
    lines[#lines + 1] = ""
    lines[#lines + 1] = "KS_API int ks_aot_feature_tier(void) {"
    lines[#lines + 1] = "#if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))"
    lines[#lines + 1] = "    int regs[4];"
    lines[#lines + 1] = "    unsigned int enabled;"
    lines[#lines + 1] = "    __cpuid(regs, 0);"
    lines[#lines + 1] = "    /* Leaf 7 is where both extended feature bits live. */"
    lines[#lines + 1] = "    if (regs[0] < 7) return 0;"
    lines[#lines + 1] = "    __cpuid(regs, 1);"
    lines[#lines + 1] = "    /* Without OSXSAVE the operating system has enabled no wider register"
    lines[#lines + 1] = "     * state and XGETBV is not available to ask which. */"
    lines[#lines + 1] = "    if ((regs[2] & (1 << 27)) == 0) return 0;"
    lines[#lines + 1] = "    enabled = (unsigned int)_xgetbv(0);"
    lines[#lines + 1] = "    /* XMM and YMM state. A processor that has AVX2 while the operating"
    lines[#lines + 1] = "     * system saves neither cannot run it. */"
    lines[#lines + 1] = "    if ((enabled & 0x6u) != 0x6u) return 0;"
    lines[#lines + 1] = "    __cpuidex(regs, 7, 0);"
    lines[#lines + 1] = "    /* And opmask, ZMM_Hi256 and Hi16_ZMM on top of those for AVX-512. */"
    lines[#lines + 1] = "    if ((enabled & 0xE6u) == 0xE6u && (regs[1] & (1 << 16)) != 0) return 2;"
    lines[#lines + 1] = "    if ((regs[1] & (1 << 5)) != 0) return 1;"
    lines[#lines + 1] = "#elif defined(__x86_64__) || defined(_M_X64)"
    lines[#lines + 1] = "    __builtin_cpu_init();"
    lines[#lines + 1] = "    if (__builtin_cpu_supports(\"avx512f\")) return 2;"
    lines[#lines + 1] = "    if (__builtin_cpu_supports(\"avx2\")) return 1;"
    lines[#lines + 1] = "#endif"
    lines[#lines + 1] = "    return 0;"
    lines[#lines + 1] = "}"

    return table.concat(lines, "\n") .. "\n"
end

--- The pinned public Lua 5.1 API surface used by VM-aware AOT entries.
---
--- Kept self-contained so `emit-c` is useful without locating development
--- headers. These declarations are the public ABI declarations, not LuaJIT
--- object layouts; the artifact fingerprint names the ABI family separately.
function emit.luaPrelude(): {string}
    return {
        "#include <limits.h>",
        "typedef struct lua_State lua_State;",
        "typedef int (*lua_CFunction)(lua_State *L);",
        "extern int lua_checkstack(lua_State *L, int extra);",
        "extern int lua_gettop(lua_State *L);",
        "extern double luaL_checknumber(lua_State *L, int narg);",
        "extern const char *luaL_checklstring(lua_State *L, int narg, size_t *length);",
        "extern int lua_toboolean(lua_State *L, int index);",
        "extern void lua_createtable(lua_State *L, int narr, int nrec);",
        "extern void lua_pushnumber(lua_State *L, double value);",
        "extern void lua_pushboolean(lua_State *L, int value);",
        "extern void lua_pushnil(lua_State *L);",
        "extern const char *lua_pushlstring(lua_State *L, const char *value, size_t length);",
        "extern void *lua_newuserdata(lua_State *L, size_t size);",
        "extern void lua_pushvalue(lua_State *L, int index);",
        "extern void lua_insert(lua_State *L, int index);",
        "extern void lua_settop(lua_State *L, int index);",
        "extern void lua_pushcclosure(lua_State *L, lua_CFunction function, int upvalues);",
        "extern void lua_rawseti(lua_State *L, int index, int key);",
        "extern void lua_rawset(lua_State *L, int index);",
        "extern int luaL_error(lua_State *L, const char *format, ...);",
        "",
        "static KS_UNUSED int ks_lua_count(lua_State *L, double value, const char *what) {",
        "    if (!(value >= 0.0) || value > (double)INT_MAX || floor(value) != value)",
        "        return luaL_error(L, \"AOT builder %s must be a nonnegative integer in C API range\", what);",
        "    return (int)value;",
        "}",
        "static int ks_lua_index(lua_State *L, double value, const char *site) {",
        "    if (!(value >= 1.0) || value > (double)INT_MAX || floor(value) != value)",
        "        return luaL_error(L, \"AOT builder array index at %s must be a positive integer in C API range\", site);",
        "    return (int)value;",
        "}",
        "static KS_UNUSED double ks_lua_number_slice(lua_State *L, const unsigned char *source, size_t source_length, uint32_t start, uint32_t length, const char *what) {",
        "    size_t first = (size_t)start, count = (size_t)length;",
        "    if (first > source_length || count > source_length - first) { luaL_error(L, \"AOT %s number range is out of bounds\", what); return 0.0; }",
        "    char *end = NULL; double value = strtod((const char *)(source + first), &end);",
        "    if (end != (char *)(source + first + count)) { luaL_error(L, \"AOT %s number is invalid\", what); return 0.0; }",
        "    return value;",
        "}",
        "static KS_UNUSED double ks_lua_integer_slice(lua_State *L, const unsigned char *source, size_t source_length, uint32_t start, uint32_t length) {",
        "    size_t first = (size_t)start, count = (size_t)length;",
        "    if (first > source_length || count > source_length - first) { luaL_error(L, \"AOT value stream integer range is out of bounds\"); return 0.0; }",
        "    size_t at = 0u; int negative = 0; uint64_t integer = 0u;",
        "    if (at < count && source[first + at] == '-') { negative = 1; at += 1u; }",
        "    size_t digits = at; while (at < count && source[first + at] >= '0' && source[first + at] <= '9' && at - digits < 15u) { integer = integer * 10u + (uint64_t)(source[first + at] - '0'); at += 1u; }",
        "    if (at == count && at > digits) { double value = (double)integer; return negative ? -value : value; }",
        "    return ks_lua_number_slice(L, source, source_length, start, length, \"value stream integer\");",
        "}",
        "typedef struct {",
        "    double number;",
        "    uint32_t tag, start, length, link_start, link_count, parent, flags;",
        "} KsLuaTreeNode;",
        "typedef struct {",
        "    const unsigned char *nodes, *links, *source;",
        "    size_t node_count, link_count, source_length;",
        "    int null_index;",
        "} KsLuaTree;",
        "static int ks_tree_hex(unsigned char byte) {",
        "    if (byte >= '0' && byte <= '9') return (int)(byte - '0');",
        "    if (byte >= 'A' && byte <= 'F') return (int)(byte - 'A') + 10;",
        "    if (byte >= 'a' && byte <= 'f') return (int)(byte - 'a') + 10;",
        "    return -1;",
        "}",
        "static int ks_tree_hex4(const unsigned char *source, size_t length, size_t *at, uint32_t *value) {",
        "    if (*at > length || length - *at < 4u) return 0;",
        "    uint32_t out = 0;",
        "    for (int i = 0; i < 4; ++i) {",
        "        int digit = ks_tree_hex(source[(*at)++]);",
        "        if (digit < 0) return 0;",
        "        out = out * 16u + (uint32_t)digit;",
        "    }",
        "    *value = out;",
        "    return 1;",
        "}",
        "static size_t ks_tree_utf8(unsigned char *out, uint32_t codepoint) {",
        "    if (codepoint <= 0x7fu) { out[0] = (unsigned char)codepoint; return 1; }",
        "    if (codepoint <= 0x7ffu) { out[0] = (unsigned char)(0xc0u | (codepoint >> 6)); out[1] = (unsigned char)(0x80u | (codepoint & 0x3fu)); return 2; }",
        "    if (codepoint <= 0xffffu) { out[0] = (unsigned char)(0xe0u | (codepoint >> 12)); out[1] = (unsigned char)(0x80u | ((codepoint >> 6) & 0x3fu)); out[2] = (unsigned char)(0x80u | (codepoint & 0x3fu)); return 3; }",
        "    out[0] = (unsigned char)(0xf0u | (codepoint >> 18)); out[1] = (unsigned char)(0x80u | ((codepoint >> 12) & 0x3fu)); out[2] = (unsigned char)(0x80u | ((codepoint >> 6) & 0x3fu)); out[3] = (unsigned char)(0x80u | (codepoint & 0x3fu)); return 4;",
        "}",
        "static int ks_tree_string(lua_State *L, const KsLuaTree *tree, const KsLuaTreeNode *node) {",
        "    size_t start = (size_t)node->start, length = (size_t)node->length;",
        "    if (start > tree->source_length || length > tree->source_length - start)",
        "        return luaL_error(L, \"AOT value tree string range is out of bounds\");",
        "    const unsigned char *source = tree->source + start;",
        "    if (node->flags == 0u) { lua_pushlstring(L, (const char *)source, length); return 1; }",
        "    if (node->flags != 1u) return luaL_error(L, \"AOT value tree has an unknown string recipe\");",
        "    int base = lua_gettop(L);",
        "    unsigned char *out = (unsigned char *)lua_newuserdata(L, length > 0u ? length : 1u);",
        "    size_t at = 0, written = 0;",
        "    while (at < length) {",
        "        unsigned char byte = source[at++];",
        "        if (byte != '\\\\') { out[written++] = byte; continue; }",
        "        if (at >= length) return luaL_error(L, \"AOT value tree has an incomplete escape\");",
        "        unsigned char escaped = source[at++];",
        "        if (escaped == '\"' || escaped == '\\\\' || escaped == '/') out[written++] = escaped;",
        "        else if (escaped == 'b') out[written++] = '\\b';",
        "        else if (escaped == 'f') out[written++] = '\\f';",
        "        else if (escaped == 'n') out[written++] = '\\n';",
        "        else if (escaped == 'r') out[written++] = '\\r';",
        "        else if (escaped == 't') out[written++] = '\\t';",
        "        else if (escaped == 'u') {",
        "            uint32_t codepoint = 0;",
        "            if (!ks_tree_hex4(source, length, &at, &codepoint)) return luaL_error(L, \"AOT value tree has an invalid Unicode escape\");",
        "            if (codepoint >= 0xd800u && codepoint <= 0xdbffu) {",
        "                uint32_t low = 0;",
        "                if (at > length || length - at < 2u || source[at] != '\\\\' || source[at + 1u] != 'u') return luaL_error(L, \"AOT value tree has an unmatched high surrogate\");",
        "                at += 2u;",
        "                if (!ks_tree_hex4(source, length, &at, &low) || low < 0xdc00u || low > 0xdfffu) return luaL_error(L, \"AOT value tree has an invalid low surrogate\");",
        "                codepoint = 0x10000u + (codepoint - 0xd800u) * 0x400u + low - 0xdc00u;",
        "            } else if (codepoint >= 0xdc00u && codepoint <= 0xdfffu) return luaL_error(L, \"AOT value tree has an unmatched low surrogate\");",
        "            written += ks_tree_utf8(out + written, codepoint);",
        "        } else return luaL_error(L, \"AOT value tree has an unknown escape\");",
        "    }",
        "    lua_pushlstring(L, (const char *)out, written);",
        "    lua_insert(L, base + 1);",
        "    lua_settop(L, base + 1);",
        "    return 1;",
        "}",
        "static int ks_tree_read_node(lua_State *L, const KsLuaTree *tree, uint32_t id, KsLuaTreeNode *node) {",
        "    if (id == 0u || (size_t)id > tree->node_count) return luaL_error(L, \"AOT value tree node id is out of bounds\");",
        "    memcpy(node, tree->nodes + ((size_t)id - 1u) * sizeof(*node), sizeof(*node));",
        "    return 1;",
        "}",
        "static uint32_t ks_tree_link(lua_State *L, const KsLuaTree *tree, size_t index) {",
        "    uint32_t id = 0;",
        "    if (index >= tree->link_count) { luaL_error(L, \"AOT value tree link is out of bounds\"); return 0; }",
        "    memcpy(&id, tree->links + index * sizeof(id), sizeof(id));",
        "    return id;",
        "}",
        "static int ks_tree_push_node(lua_State *L, const KsLuaTree *tree, uint32_t id, size_t depth) {",
        "    if (depth > tree->node_count || depth > 1024u) return luaL_error(L, \"AOT value tree nesting is excessive\");",
        "    KsLuaTreeNode node; ks_tree_read_node(L, tree, id, &node);",
        "    if (node.tag == 0u) { lua_pushvalue(L, tree->null_index); return 1; }",
        "    if (node.tag == 1u || node.tag == 2u) { lua_pushboolean(L, node.tag == 1u); return 1; }",
        "    if (node.tag == 3u) {",
        "        if (node.flags == 1u) lua_pushnumber(L, node.number);",
        "        else {",
        "            double value = ks_lua_number_slice(L, tree->source, tree->source_length, node.start, node.length, \"value tree\");",
        "            lua_pushnumber(L, value);",
        "        }",
        "        return 1;",
        "    }",
        "    if (node.tag == 4u) return ks_tree_string(L, tree, &node);",
        "    if (node.tag != 5u && node.tag != 6u) return luaL_error(L, \"AOT value tree node tag is invalid\");",
        "    if ((size_t)node.link_start > tree->link_count || (size_t)node.link_count > tree->link_count - (size_t)node.link_start) return luaL_error(L, \"AOT value tree child range is out of bounds\");",
        "    if (node.tag == 6u && (node.link_count & 1u) != 0u) return luaL_error(L, \"AOT value tree object has an unmatched key\");",
        "    if (node.link_count > (uint32_t)INT_MAX) return luaL_error(L, \"AOT value tree container exceeds the C API capacity range\");",
        "    if (!lua_checkstack(L, 4)) return luaL_error(L, \"AOT builder Lua stack exhausted\");",
        "    lua_createtable(L, node.tag == 5u ? (int)node.link_count : 0, node.tag == 6u ? (int)(node.link_count / 2u) : 0);",
        "    int table_index = lua_gettop(L);",
        "    if (node.tag == 5u) {",
        "        for (uint32_t offset = 0; offset < node.link_count; ++offset) {",
        "            ks_tree_push_node(L, tree, ks_tree_link(L, tree, (size_t)node.link_start + offset), depth + 1u);",
        "            lua_rawseti(L, table_index, (int)offset + 1);",
        "        }",
        "    } else {",
        "        for (uint32_t offset = 0; offset < node.link_count; offset += 2u) {",
        "            uint32_t key_id = ks_tree_link(L, tree, (size_t)node.link_start + offset);",
        "            KsLuaTreeNode key; ks_tree_read_node(L, tree, key_id, &key);",
        "            if (key.tag != 4u) return luaL_error(L, \"AOT value tree object key is not a string\");",
        "            ks_tree_string(L, tree, &key);",
        "            ks_tree_push_node(L, tree, ks_tree_link(L, tree, (size_t)node.link_start + offset + 1u), depth + 1u);",
        "            lua_rawset(L, table_index);",
        "        }",
        "    }",
        "    return 1;",
        "}",
        "static KS_UNUSED int ks_lua_tree_push(lua_State *L, int nodes_index, int links_index, int source_index, double root_value, int null_index) {",
        "    size_t node_bytes = 0, link_bytes = 0, source_length = 0;",
        "    const char *nodes = luaL_checklstring(L, nodes_index, &node_bytes);",
        "    const char *links = luaL_checklstring(L, links_index, &link_bytes);",
        "    const char *source = luaL_checklstring(L, source_index, &source_length);",
        "    if (node_bytes % sizeof(KsLuaTreeNode) != 0u || link_bytes % sizeof(uint32_t) != 0u) return luaL_error(L, \"AOT value tree blob has an invalid size\");",
        "    int root = ks_lua_index(L, root_value, \"value tree root\");",
        "    KsLuaTree tree = {(const unsigned char *)nodes, (const unsigned char *)links, (const unsigned char *)source, node_bytes / sizeof(KsLuaTreeNode), link_bytes / sizeof(uint32_t), source_length, null_index};",
        "    return ks_tree_push_node(L, &tree, (uint32_t)root, 1u);",
        "}",
        "typedef struct { int table_index; uint32_t kind, next, count; int expects_key; } KsLuaBuildFrame;",
        "typedef struct { int null_index, root_index, frame_root_index, byte_root_index; uint32_t depth, frame_capacity; KsLuaBuildFrame *frames; KsLuaBuildFrame inline_frames[16]; unsigned char *bytes; uint32_t byte_capacity; } KsLuaBuilder;",
        "typedef struct { uint32_t *words; uint32_t capacity, length; int root_index; } KsLuaScratchU32;",
        "typedef struct { unsigned char *bytes; uint32_t capacity, length; int root_index; } KsLuaScratchU8;",
        "static KS_UNUSED uint32_t ks_lua_string_length(lua_State *L, size_t length) {",
        "    if (length > (size_t)UINT32_MAX) { luaL_error(L, \"AOT builder string exceeds uint32 range\"); return 0u; }",
        "    return (uint32_t)length;",
        "}",
        "static KS_UNUSED uint32_t ks_lua_string_byte(lua_State *L, const unsigned char *bytes, size_t length, uint32_t offset) {",
        "    if ((size_t)offset >= length) { luaL_error(L, \"AOT builder byte is out of bounds\"); return 0u; }",
        "    return (uint32_t)bytes[offset];",
        "}",
        "static KS_UNUSED uint32_t ks_lua_string_u32(lua_State *L, const unsigned char *bytes, size_t length, uint32_t index) {",
        "    if (KS_COUNT_OVERFLOWS(index, sizeof(uint32_t))) { luaL_error(L, \"AOT builder word index overflows\"); return 0u; }",
        "    size_t offset = (size_t)index * sizeof(uint32_t); uint32_t value = 0u;",
        "    if (offset > length || sizeof(uint32_t) > length - offset) { luaL_error(L, \"AOT builder word is out of bounds\"); return 0u; }",
        "    memcpy(&value, bytes + offset, sizeof(value)); return value;",
        "}",
        "static KS_UNUSED KsLuaScratchU32 ks_lua_scratch_u32(lua_State *L, uint32_t capacity) {",
        "    if (KS_COUNT_OVERFLOWS(capacity, sizeof(uint32_t))) { luaL_error(L, \"AOT scratch capacity overflows\"); capacity = 0u; }",
        "    size_t bytes = (size_t)capacity * sizeof(uint32_t);",
        "    uint32_t *words = (uint32_t *)lua_newuserdata(L, bytes == 0u ? 1u : bytes);",
        "    KsLuaScratchU32 scratch = {words, capacity, 0u, lua_gettop(L)}; return scratch;",
        "}",
        "static KS_UNUSED uint32_t ks_lua_scratch_u32_get(lua_State *L, KsLuaScratchU32 *scratch, uint32_t index) {",
        "    if (index >= scratch->length) { luaL_error(L, \"AOT scratch read is out of bounds\"); return 0u; }",
        "    return scratch->words[index];",
        "}",
        "static KS_UNUSED void ks_lua_scratch_u32_set(lua_State *L, KsLuaScratchU32 *scratch, uint32_t index, uint32_t value) {",
        "    if (index > scratch->length || index >= scratch->capacity) { luaL_error(L, \"AOT scratch write is out of bounds\"); return; }",
        "    if (index == scratch->length) { scratch->length += 1u; } scratch->words[index] = value;",
        "}",
        "static KS_UNUSED uint32_t ks_reverse_u32(uint32_t value) {",
        "    value = ((value >> 1u) & UINT32_C(0x55555555)) | ((value & UINT32_C(0x55555555)) << 1u);",
        "    value = ((value >> 2u) & UINT32_C(0x33333333)) | ((value & UINT32_C(0x33333333)) << 2u);",
        "    value = ((value >> 4u) & UINT32_C(0x0f0f0f0f)) | ((value & UINT32_C(0x0f0f0f0f)) << 4u);",
        "    value = ((value >> 8u) & UINT32_C(0x00ff00ff)) | ((value & UINT32_C(0x00ff00ff)) << 8u);",
        "    return (value >> 16u) | (value << 16u);",
        "}",
        "static KS_UNUSED uint32_t ks_lua_scratch_u32_append_bits(lua_State *L, KsLuaScratchU32 *scratch, uint32_t index, uint32_t base, KsMaskBits64 bits) {",
        "    uint32_t needed = (uint32_t)(__builtin_popcount(bits.low) + __builtin_popcount(bits.high));",
        "    if (index != scratch->length || needed > scratch->capacity - index) { luaL_error(L, \"AOT scratch bit append is out of bounds\"); return index; }",
        "#if defined(__aarch64__)",
        "    uint32_t low = ks_reverse_u32(bits.low), high = ks_reverse_u32(bits.high);",
        "    while (low != 0u) { uint32_t bit = (uint32_t)__builtin_clz(low); scratch->words[index++] = base + bit; low &= ~(UINT32_C(0x80000000) >> bit); }",
        "    while (high != 0u) { uint32_t bit = (uint32_t)__builtin_clz(high); scratch->words[index++] = base + UINT32_C(32) + bit; high &= ~(UINT32_C(0x80000000) >> bit); }",
        "#else",
        "    while (bits.low != 0u) { uint32_t bit = (uint32_t)__builtin_ctz(bits.low); scratch->words[index++] = base + bit; bits.low &= bits.low - 1u; }",
        "    while (bits.high != 0u) { uint32_t bit = (uint32_t)__builtin_ctz(bits.high); scratch->words[index++] = base + UINT32_C(32) + bit; bits.high &= bits.high - 1u; }",
        "#endif",
        "    scratch->length = index; return index;",
        "}",
        "static KS_UNUSED KsLuaScratchU8 ks_lua_scratch_u8(lua_State *L, uint32_t capacity) {",
        "    unsigned char *bytes = (unsigned char *)lua_newuserdata(L, capacity == 0u ? 1u : (size_t)capacity);",
        "    KsLuaScratchU8 scratch = {bytes, capacity, 0u, lua_gettop(L)}; return scratch;",
        "}",
        "static KS_UNUSED uint32_t ks_lua_scratch_u8_get(lua_State *L, KsLuaScratchU8 *scratch, uint32_t index) {",
        "    if (index >= scratch->length) { luaL_error(L, \"AOT byte scratch read is out of bounds\"); return 0u; } return (uint32_t)scratch->bytes[index];",
        "}",
        "static KS_UNUSED void ks_lua_scratch_u8_set(lua_State *L, KsLuaScratchU8 *scratch, uint32_t index, uint32_t value) {",
        "    if (index > scratch->length || index >= scratch->capacity || value > 255u) { luaL_error(L, \"AOT byte scratch write is out of bounds\"); return; }",
        "    if (index == scratch->length) { scratch->length += 1u; } scratch->bytes[index] = (unsigned char)value;",
        "}",
        "static KS_UNUSED int ks_lua_scratch_u8_push(lua_State *L, KsLuaScratchU8 *scratch, uint32_t start, uint32_t length) {",
        "    if (start > scratch->length || length > scratch->length - start) return luaL_error(L, \"AOT byte scratch string range is out of bounds\");",
        "    lua_pushlstring(L, (const char *)(scratch->bytes + start), (size_t)length); return 1;",
        "}",
        "static KS_UNUSED KsLuaBuilder ks_lua_builder_new(lua_State *L, int null_index, uint32_t max_depth, uint32_t byte_capacity) {",
        "    if (KS_COUNT_OVERFLOWS(max_depth, sizeof(KsLuaBuildFrame))) { luaL_error(L, \"AOT value stream depth capacity overflows\"); max_depth = 0u; }",
        "    KsLuaBuilder builder = {null_index, 0, lua_gettop(L), 0, 0u, max_depth, NULL, {{0}}, NULL, byte_capacity}; return builder;",
        "}",
        "static KS_UNUSED KsLuaBuildFrame *ks_lua_builder_frame(KsLuaBuilder *builder, uint32_t index) {",
        "    return builder->frames != NULL ? &builder->frames[index] : &builder->inline_frames[index];",
        "}",
        "static KS_UNUSED void ks_lua_builder_ensure_frames(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->frames != NULL || builder->frame_capacity <= 16u) return;",
        "    size_t bytes = (size_t)builder->frame_capacity * sizeof(KsLuaBuildFrame);",
        "    builder->frames = (KsLuaBuildFrame *)lua_newuserdata(L, bytes); memcpy(builder->frames, builder->inline_frames, sizeof(builder->inline_frames));",
        "    int destination = builder->frame_root_index + 1; lua_insert(L, destination); builder->frame_root_index = destination;",
        "    if (builder->byte_root_index >= destination) builder->byte_root_index += 1;",
        "    for (uint32_t at = 0u; at < builder->depth; ++at) builder->frames[at].table_index += 1;",
        "    if (builder->root_index >= destination) builder->root_index += 1;",
        "}",
        "static KS_UNUSED unsigned char *ks_lua_builder_bytes(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->bytes != NULL) return builder->bytes;",
        "    builder->bytes = (unsigned char *)lua_newuserdata(L, builder->byte_capacity == 0u ? 1u : (size_t)builder->byte_capacity);",
        "    int destination = builder->frame_root_index + 1; lua_insert(L, destination); builder->byte_root_index = destination;",
        "    for (uint32_t at = 0u; at < builder->depth; ++at) ks_lua_builder_frame(builder, at)->table_index += 1;",
        "    if (builder->root_index >= destination) builder->root_index += 1;",
        "    return builder->bytes;",
        "}",
        "static KS_UNUSED int ks_lua_builder_put(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->depth == 0u) {",
        "        if (builder->root_index != 0) return luaL_error(L, \"AOT value stream has more than one root\");",
        "        builder->root_index = lua_gettop(L); return 1;",
        "    }",
        "    KsLuaBuildFrame *frame = ks_lua_builder_frame(builder, builder->depth - 1u);",
        "    if (frame->kind == 5u) {",
        "        if (lua_gettop(L) != frame->table_index + 1) return luaL_error(L, \"AOT value stream value is not above its array\");",
        "        if (frame->next > (uint32_t)INT_MAX) return luaL_error(L, \"AOT value stream array exceeds C API range\");",
        "        lua_rawseti(L, frame->table_index, (int)frame->next++); return 1;",
        "    }",
        "    if (frame->expects_key) return luaL_error(L, \"AOT value stream object needs a key\");",
        "    if (lua_gettop(L) != frame->table_index + 2) return luaL_error(L, \"AOT value stream key and value are not above their object\");",
        "    if (frame->count == UINT32_MAX) return luaL_error(L, \"AOT value stream object is too large\");",
        "    lua_rawset(L, frame->table_index); frame->expects_key = 1; frame->count += 1u; return 1;",
        "}",
        "static KS_UNUSED int ks_lua_builder_open(lua_State *L, KsLuaBuilder *builder, uint32_t kind, uint32_t capacity) {",
        "    if (builder->depth >= builder->frame_capacity) return luaL_error(L, \"AOT value stream nesting exceeds its authored capacity\");",
        "    if (builder->depth == 16u && builder->frames == NULL) ks_lua_builder_ensure_frames(L, builder);",
        "    if (builder->depth == 0u && builder->root_index != 0) return luaL_error(L, \"AOT value stream has more than one root\");",
        "    if (capacity > (uint32_t)INT_MAX) return luaL_error(L, \"AOT value stream capacity exceeds C API range\");",
        "    if (!lua_checkstack(L, 4)) return luaL_error(L, \"AOT builder Lua stack exhausted\");",
        "    lua_createtable(L, kind == 5u ? (int)capacity : 0, kind == 6u ? (int)capacity : 0);",
        "    KsLuaBuildFrame *frame = ks_lua_builder_frame(builder, builder->depth++);",
        "    frame->table_index = lua_gettop(L); frame->kind = kind; frame->next = 1u; frame->count = 0u; frame->expects_key = kind == 6u;",
        "    return 1;",
        "}",
        "static KS_UNUSED uint32_t ks_lua_builder_query(lua_State *L, KsLuaBuilder *builder, uint32_t query) {",
        "    if (query == 0u) return builder->depth;",
        "    if (builder->depth == 0u) { luaL_error(L, \"AOT value stream has no current container\"); return 0u; }",
        "    KsLuaBuildFrame *frame = ks_lua_builder_frame(builder, builder->depth - 1u);",
        "    if (query == 1u) return frame->kind;",
        "    return frame->kind == 5u ? frame->next - 1u : frame->count;",
        "}",
        "static KS_UNUSED int ks_lua_builder_key(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->depth == 0u) return luaL_error(L, \"AOT value stream key is outside an object\");",
        "    KsLuaBuildFrame *frame = ks_lua_builder_frame(builder, builder->depth - 1u);",
        "    if (frame->kind != 6u || !frame->expects_key) return luaL_error(L, \"AOT value stream object is not expecting a key\");",
        "    if (lua_gettop(L) != frame->table_index + 1) return luaL_error(L, \"AOT value stream key is not above its object\");",
        "    frame->expects_key = 0; return 1;",
        "}",
        "static KS_UNUSED int ks_lua_builder_string(lua_State *L, KsLuaBuilder *builder, const unsigned char *source, size_t source_length, uint32_t start, uint32_t length, int escaped, int key) {",
        "    size_t first = (size_t)start, count = (size_t)length;",
        "    if (first > source_length || count > source_length - first) return luaL_error(L, \"AOT value stream string range is out of bounds\");",
        "    if (!escaped) lua_pushlstring(L, (const char *)(source + first), count);",
        "    else if (count <= (size_t)builder->byte_capacity) {",
        "        const unsigned char *input = source + first; unsigned char *out = ks_lua_builder_bytes(L, builder); size_t at = 0u, written = 0u;",
        "        while (at < count) {",
        "            unsigned char byte = input[at++]; if (byte != '\\\\') { out[written++] = byte; continue; }",
        "            if (at >= count) return luaL_error(L, \"AOT value stream has an incomplete escape\");",
        "            unsigned char escaped_byte = input[at++];",
        "            if (escaped_byte == '\"' || escaped_byte == '\\\\' || escaped_byte == '/') out[written++] = escaped_byte;",
        "            else if (escaped_byte == 'b') out[written++] = '\\b'; else if (escaped_byte == 'f') out[written++] = '\\f';",
        "            else if (escaped_byte == 'n') out[written++] = '\\n'; else if (escaped_byte == 'r') out[written++] = '\\r'; else if (escaped_byte == 't') out[written++] = '\\t';",
        "            else if (escaped_byte == 'u') {",
        "                uint32_t codepoint = 0u; if (!ks_tree_hex4(input, count, &at, &codepoint)) return luaL_error(L, \"AOT value stream has an invalid Unicode escape\");",
        "                if (codepoint >= 0xd800u && codepoint <= 0xdbffu) { uint32_t low = 0u; if (at > count || count - at < 2u || input[at] != '\\\\' || input[at + 1u] != 'u') return luaL_error(L, \"AOT value stream has an unmatched high surrogate\"); at += 2u; if (!ks_tree_hex4(input, count, &at, &low) || low < 0xdc00u || low > 0xdfffu) return luaL_error(L, \"AOT value stream has an invalid low surrogate\"); codepoint = 0x10000u + (codepoint - 0xd800u) * 0x400u + low - 0xdc00u; }",
        "                else if (codepoint >= 0xdc00u && codepoint <= 0xdfffu) return luaL_error(L, \"AOT value stream has an unmatched low surrogate\");",
        "                written += ks_tree_utf8(out + written, codepoint);",
        "            } else return luaL_error(L, \"AOT value stream has an unknown escape\");",
        "        }",
        "        lua_pushlstring(L, (const char *)out, written);",
        "    } else {",
        "        KsLuaTree tree = {NULL, NULL, source, 0u, 0u, source_length, builder->null_index}; KsLuaTreeNode node = {0.0, 4u, start, length, 0u, 0u, 0u, 1u}; ks_tree_string(L, &tree, &node);",
        "    }",
        "    return key ? ks_lua_builder_key(L, builder) : ks_lua_builder_put(L, builder);",
        "}",
        "static KS_UNUSED int ks_lua_builder_number_slice(lua_State *L, KsLuaBuilder *builder, const unsigned char *source, size_t source_length, uint32_t start, uint32_t length) {",
        "    double value = ks_lua_number_slice(L, source, source_length, start, length, \"value stream\");",
        "    lua_pushnumber(L, value); return ks_lua_builder_put(L, builder);",
        "}",
        "static KS_UNUSED int ks_lua_builder_integer_slice(lua_State *L, KsLuaBuilder *builder, const unsigned char *source, size_t source_length, uint32_t start, uint32_t length) {",
        "    double value = ks_lua_integer_slice(L, source, source_length, start, length);",
        "    lua_pushnumber(L, value); return ks_lua_builder_put(L, builder);",
        "}",
        "static KS_UNUSED int ks_lua_builder_close(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->depth == 0u) return luaL_error(L, \"AOT value stream close has no container\");",
        "    KsLuaBuildFrame *frame = ks_lua_builder_frame(builder, builder->depth - 1u);",
        "    if (frame->kind == 6u && !frame->expects_key) return luaL_error(L, \"AOT value stream object has an unmatched key\");",
        "    if (lua_gettop(L) != frame->table_index) return luaL_error(L, \"AOT value stream container is not on top\");",
        "    builder->depth -= 1u; return ks_lua_builder_put(L, builder);",
        "}",
        "static KS_UNUSED int ks_lua_builder_finish(lua_State *L, KsLuaBuilder *builder) {",
        "    if (builder->depth != 0u) return luaL_error(L, \"AOT value stream has an unclosed container\");",
        "    if (builder->root_index == 0) return luaL_error(L, \"AOT value stream has no root\");",
        "    if (builder->root_index != lua_gettop(L)) return luaL_error(L, \"AOT value stream root is not on top\");",
        "    return 1;",
        "}",
        "",
    }
end

--- Bytes as an unambiguous C string literal.
local function cBytes(value: string): string
    local bytes: {string} = {}
    for index = 1, #value do
        bytes[index] = ("\\x%02x"):format(value:byte(index))
    end

    return '"' .. table.concat(bytes) .. '"'
end

local function luaSite(source: scalarIR.Source?): string
    return source ~= nil and tostring(
        (source as scalarIR.Source).line
    ) .. ":" .. tostring((source as scalarIR.Source).column) or "1:1"
end

--- What the compiled object reports about one struct's layout.
---
--- A function per measurement rather than a table of numbers, so the answers
--- come from the C compiler that actually laid the struct out and the generated
--- wrapper can compare them against what Nupp believes.
function emit.layoutReporters(symbol: string, layout: scalarIR.Layout): {string}
    local prefix = "KS_API size_t " .. symbol .. "_layout_" .. layout.name
    local lines: {string} = {prefix .. "_size(void) { return sizeof(" .. layout.cName .. "); }"}
    for _, field in ipairs(layout.fields) do
        lines[
            #lines + 1
        ] = prefix
            .. "_offset_"
            .. field.name
            .. "(void) { return offsetof("
            .. layout.cName
            .. ", "
            .. field.name
            .. "); }"
        lines[
            #lines + 1
        ] = prefix
            .. "_size_"
            .. field.name
            .. "(void) { return sizeof((("
            .. layout.cName
            .. " *)0)->"
            .. field.name
            .. "); }"
    end

    return lines
end

--- A set's keys in a fixed order, so the same IR renders the same text.
---
--- `pairs` over a set does not order it the same way in two processes, and an
--- artifact cache keyed by the generated text would then miss on every build.
local function sortedKeys(set: {[string]: boolean}): {string}
    local names: {string} = {}
    for key in pairs(set) do
        names[#names + 1] = key
    end
    table.sort(names)

    return names
end

--- One value of the given lane, repeated across the gang.
local function repeated(value: string, lanes: integer): string
    local parts: {string} = {}
    for position = 1, lanes do
        parts[position] = value
    end

    return table.concat(parts, ", ")
end

--- The vector typedefs one gang needs.
---
--- Emitted whole, and marked unused below, so a kernel that uses one shape does
--- not fail `-Werror` for a conversion the other shape would have needed.
local function vectorTypes(shape: lane.Shape): {string}
    -- Every mask this gang uses, not only the one its algebra runs at. A gang
    -- carrying elements at several widths produces masks at several widths,
    -- because a comparison yields one bit per lane as wide as what it compared.
    -- The width comes from the mask's own name rather than from the gang, which
    -- is the widest of them and not all of them.
    local masks: {[string]: boolean} = {[shape.mask] = true}
    for _, mask in pairs(shape.maskFor or {}) do
        masks[mask] = true
    end
    local lines: {string} = {}
    for _, mask in ipairs(sortedKeys(masks)) do
        local maskElement, maskLanes = emit.vectorParts(mask)
        local maskWidth = tostring(math.floor((tonumber(maskElement:match("%d+")) or 0) / 8 * maskLanes))
        lines[
            #lines + 1
        ] = "typedef " .. emit.maskC(mask) .. " ks_" .. mask .. " __attribute__((vector_size(" .. maskWidth .. ")));"
    end

    local vectors: {[string]: boolean} = {}
    for _, vector in pairs(shape.vectorFor) do
        vectors[vector] = true
    end
    vectors[shape.bits] = true
    -- The narrow vectors a rounding goes out through. Emitted whether or not
    -- this body rounds, like everything else in the prelude, and unused there
    -- costs a typedef.
    for _, vector in pairs(shape.rounding or {}) do
        vectors[vector] = true
    end

    for _, vector in ipairs(sortedKeys(vectors)) do
        if vector ~= shape.mask then
            local element, lanes = emit.vectorParts(vector)
            local bits = tonumber(element:match("%d+")) or 0
            local width = tostring(math.floor(bits / 8 * lanes))
            lines[
                #lines + 1
            ] = "typedef " .. tostring(
                emit.VECTOR_ELEMENT_C[element]
            ) .. " ks_" .. vector .. " __attribute__((vector_size(" .. width .. ")));"

            -- The signed companion of the bit vector, for arithmetic shift.
            if vector == shape.bits and element:sub(1, 1) == "u" then
                lines[
                    #lines + 1
                ] = "typedef int" .. tostring(
                    element:match("%d+")
                ) .. "_t ks_i" .. vector:sub(2) .. " __attribute__((vector_size(" .. width .. ")));"
            end
        end
    end

    return lines
end

--- The mask helpers, and the splat and select each value-carrying vector needs.
local function vectorHelpers(shape: lane.Shape): {string}
    local unused = "static inline __attribute__((unused)) "
    local lines: {
        string
    } = {
        unused
        .. "ks_"
        .. shape.mask
        .. " ks_mask_all_"
        .. shape.mask
        .. "(void) { return (ks_"
        .. shape.mask
        .. "){"
        .. repeated(
            "-1",
            shape.lanes
        ) .. "}; }",
        unused
        .. "ks_"
        .. shape.mask
        .. " ks_bool_mask_"
        .. shape.mask
        .. "(bool v) { return v ? ks_mask_all_"
        .. shape.mask
        .. "() : (ks_"
        .. shape.mask
        .. "){"
        .. repeated(
            "0",
            shape.lanes
        ) .. "}; }",
    }

    local terms: {string} = {}
    for index = 0, shape.lanes - 1 do
        terms[index + 1] = "m[" .. tostring(index) .. "]"
    end
    lines[
        #lines + 1
    ] = unused .. "bool ks_any_" .. shape.mask .. "(ks_" .. shape.mask .. " m) { return (" .. table.concat(
        terms,
        " | "
    ) .. ") != 0; }"

    -- A splat and a select are wanted for every vector that carries values, and
    -- for nothing else. The bit vector is not one of them in a binary64 gang --
    -- it is half the width and has no mask to pair with -- but in a 32-bit gang
    -- it is also where integers live, so membership of `vectorFor` is the test
    -- rather than whether it happens to be `shape.bits`.
    local carriers: {[string]: boolean} = {}
    for _, vector in pairs(shape.vectorFor) do
        carriers[vector] = true
    end

    for _, vector in ipairs(sortedKeys(carriers)) do
        if vector ~= shape.mask then
            local element = tostring(vector:match("^(%a%d+)x"))
            -- A select blends through the mask's own integer lanes, so the mask
            -- has to be as wide as what it selects between. That is the gang's
            -- own mask where it carries one width, and this element's where it
            -- carries several.
            local blend = tostring((shape.maskFor or {})[element as lane.Element] or shape.mask)
            lines[
                #lines + 1
            ] = unused .. "ks_" .. vector .. " ks_splat_" .. vector .. "(" .. tostring(
                emit.VECTOR_ELEMENT_C[element]
            ) .. " v) { return (ks_" .. vector .. "){" .. repeated("v", shape.lanes) .. "}; }"

            -- Blend through the mask's integer lanes. A branchless select is
            -- what makes an inactive lane keep its old value instead of
            -- computing a new one, so it must not be an arithmetic idiom:
            -- multiplying by zero turns an escaped lane's infinity into a NaN
            -- and destroys it.
            lines[
                #lines + 1
            ] = unused
                .. "ks_"
                .. vector
                .. " ks_sel_"
                .. vector
                .. "(ks_"
                .. blend
                .. " m, ks_"
                .. vector
                .. " a, ks_"
                .. vector
                .. " b) { return (ks_"
                .. vector
                .. ")((m & (ks_"
                .. blend
                .. ")a) | (~m & (ks_"
                .. blend
                .. ")b)); }"
        end
    end

    return lines
end

--- The scalar helpers the generated code calls.
---
--- The binary32 corrections are here rather than left to the C library, because
--- `nupp.math.f32` defines a canonical quiet NaN and defines `min` and `max` to
--- propagate NaN, where `fminf` and `fmaxf` return the operand that is not NaN.
--- It also orders the two zeros, where the C library leaves which one a `+0`
--- and `-0` pair answers unspecified -- and GCC and Clang answer differently.
--- An AOT build must not change bits that `toBits` can read back.
local function scalarHelpers(): {string}
    local unused = "static inline __attribute__((unused)) "

    return {
        unused .. "uint32_t nupp_u32(double value) { return (uint32_t)value; }",
        unused .. "uint32_t nupp_u32_i32(int32_t value) { return (uint32_t)value; }",
        unused .. "uint32_t nupp_u32_u32(uint32_t value) { return value; }",
        "#define nupp_u32(value) _Generic((value), int32_t: nupp_u32_i32, uint32_t: nupp_u32_u32, default: nupp_u32)(value)",
        unused .. "int32_t nupp_arshift(uint32_t value, uint32_t shift) {",
        "    if (shift == 0u) return (int32_t)value;",
        "    uint32_t shifted = value >> shift;",
        "    if ((value & UINT32_C(0x80000000)) != 0u) shifted |= ~(UINT32_MAX >> shift);",
        "    return (int32_t)shifted;",
        "}",
        "",
        unused .. "float nupp_f32_nan(void) {",
        "    uint32_t bits = UINT32_C(0x7fc00000);",
        "    float out;",
        "    memcpy(&out, &bits, 4);",
        "    return out;",
        "}",
        unused .. "uint32_t nupp_f32_bits(float value) {",
        "    uint32_t bits;",
        "    memcpy(&bits, &value, 4);",
        "    return bits;",
        "}",
        "/* `-0.0f == 0.0f`, so an equal pair is where the two zeros have to be",
        " * told apart by their sign bit. Returning one of the operands rather",
        " * than a literal keeps this independent of how the compiler folds a",
        " * signed zero. */",
        unused .. "float nupp_f32_min(float left, float right) {",
        "    if (left != left || right != right) return nupp_f32_nan();",
        "    if (left == right) {",
        "        /* -0 is the smaller zero, so answer it when either side is one. */",
        "        if (left != 0.0f) return left;",
        "        return (nupp_f32_bits(left) & UINT32_C(0x80000000)) != 0u ? left : right;",
        "    }",
        "    return left < right ? left : right;",
        "}",
        unused .. "float nupp_f32_max(float left, float right) {",
        "    if (left != left || right != right) return nupp_f32_nan();",
        "    if (left == right) {",
        "        /* And +0 the larger, so a pair answers -0 only when both are. */",
        "        if (left != 0.0f) return left;",
        "        return (nupp_f32_bits(left) & UINT32_C(0x80000000)) == 0u ? left : right;",
        "    }",
        "    return left > right ? left : right;",
        "}",
        unused .. "float nupp_f32_fma(float a, float b, float c) {",
        "    float out = fmaf(a, b, c);",
        "    return out == out ? out : nupp_f32_nan();",
        "}",
        "",
        unused .. "double nupp_min2(double left, double right) {",
        "    return left < right ? left : right;",
        "}",
        unused .. "double nupp_max2(double left, double right) {",
        "    return left > right ? left : right;",
        "}",
        "",
    }
end

--- What one gang needs before any body that uses it.
---
--- Only the parts that depend on the gang. A file whose functions chose
--- different gangs emits this once for each of them, so anything shape
--- independent would be defined twice -- which is why the scalar helpers are
--- not here.
function emit.prelude(shape: lane.Shape): {string}
    local lines = vectorTypes(shape)
    for _, line in ipairs(vectorHelpers(shape)) do
        lines[#lines + 1] = line
    end

    return lines
end

--- The helpers no gang owns, emitted once however many gangs a file uses.
function emit.scalarPrelude(): {string}
    return scalarHelpers()
end

--- Packed-byte helpers whose semantics are independent of the instruction set.
--- Clang/GCC lower the vector comparisons and bitwise expressions; the short
--- loops here are fixed-width scalar oracles for safe tails and mask order.
function emit.simdPrelude(width: integer): {string}
    local suffix = "u8x" .. tostring(width)
    local vector = "ks_" .. suffix
    local zeros: {string} = {}
    local splats: {string} = {}
    for laneIndex = 1, width do
        zeros[laneIndex] = "0"
        splats[laneIndex] = "value"
    end
    local lines = {
        "typedef uint8_t " .. vector .. " __attribute__((vector_size(" .. tostring(width) .. ")));",
        "typedef struct { const uint8_t *source; size_t source_length; uint32_t length, full_length, tail_length; "
        .. vector
        .. " tail; } KsPaddedStringU8x"
        .. tostring(
            width
        ) .. ";",
        "static inline __attribute__((unused)) " .. vector .. " ks_splat_" .. suffix .. "(uint8_t value) {",
        "    return (" .. vector .. "){ " .. table.concat(splats, ", ") .. " };",
        "}",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_shr_"
        .. suffix
        .. "("
        .. vector
        .. " value, uint32_t count) {",
        "    if (count >= 8u) return ks_splat_" .. suffix .. "(0u);",
        "    return value >> ks_splat_" .. suffix .. "((uint8_t)count);",
        "}",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_load_"
        .. suffix
        .. "(const uint8_t *source, size_t count, uint32_t offset) {",
        "    " .. vector .. " out = (" .. vector .. "){ " .. table.concat(zeros, ", ") .. " };",
        "    if ((size_t)offset < count) {",
        "        size_t active = count - (size_t)offset;",
        "        if (active > " .. tostring(width) .. "u) active = " .. tostring(width) .. "u;",
        "        memcpy(&out, source + offset, active);",
        "    }",
        "    return out;",
        "}",
        "static inline __attribute__((unused)) KsPaddedStringU8x" .. tostring(
            width
        ) .. " ks_padded_string_" .. suffix .. "(const uint8_t *source, size_t count) {",
        "    KsPaddedStringU8x" .. tostring(width) .. " out; memset(&out, 0, sizeof(out));",
        "    if (count > (size_t)UINT32_MAX) return out;",
        "    out.source = source; out.source_length = count; out.length = (uint32_t)count;",
        "    out.tail_length = (uint32_t)(count % " .. tostring(width) .. "u);",
        "    out.full_length = (uint32_t)(count - out.tail_length);",
        "    if (out.tail_length != 0u) memcpy(&out.tail, source + out.full_length, out.tail_length);",
        "    return out;",
        "}",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_padded_load_full_"
        .. suffix
        .. "(const KsPaddedStringU8x"
        .. tostring(
            width
        ) .. " *view, uint32_t offset) {",
        "    " .. vector .. " out = (" .. vector .. "){ " .. table.concat(zeros, ", ") .. " };",
        "    if (offset >= view->full_length || offset % " .. tostring(width) .. "u != 0u) return out;",
        "    memcpy(&out, view->source + offset, " .. tostring(width) .. "u); return out;",
        "}",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_padded_load_tail_"
        .. suffix
        .. "(const KsPaddedStringU8x"
        .. tostring(
            width
        ) .. " *view) { return view->tail; }",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_lookup16_"
        .. suffix
        .. "("
        .. vector
        .. " indexes, KsTableU8x16 table) {",
        "    " .. vector .. " out = (" .. vector .. "){ " .. table.concat(zeros, ", ") .. " };",
        "#if defined(__aarch64__)",
        "    uint8x16_t lookup = vld1q_u8(table.lane);",
        width == 16
        and "    uint8x16_t input; memcpy(&input, &indexes, 16u); input = vqtbl1q_u8(lookup, input); memcpy(&out, &input, 16u);"
        or "    uint8x16_t lo, hi; memcpy(&lo, &indexes, 16u); memcpy(&hi, ((const uint8_t *)&indexes) + 16u, 16u); lo = vqtbl1q_u8(lookup, lo); hi = vqtbl1q_u8(lookup, hi); memcpy(&out, &lo, 16u); memcpy(((uint8_t *)&out) + 16u, &hi, 16u);",
        "#elif defined(__AVX2__) && " .. tostring(width) .. " == 32",
        "    __m256i input, lookup, high, shuffled; __m128i table128; memcpy(&input, &indexes, 32u); memcpy(&table128, table.lane, 16u); lookup = _mm256_broadcastsi128_si256(table128); high = _mm256_and_si256(input, _mm256_set1_epi8((char)0xf0)); shuffled = _mm256_shuffle_epi8(lookup, input); shuffled = _mm256_and_si256(shuffled, _mm256_cmpeq_epi8(high, _mm256_setzero_si256())); memcpy(&out, &shuffled, 32u);",
        "#elif defined(__SSSE3__) && " .. tostring(width) .. " == 16",
        "    __m128i input, lookup, high, shuffled; memcpy(&input, &indexes, 16u); memcpy(&lookup, table.lane, 16u); high = _mm_and_si128(input, _mm_set1_epi8((char)0xf0)); shuffled = _mm_shuffle_epi8(lookup, input); shuffled = _mm_and_si128(shuffled, _mm_cmpeq_epi8(high, _mm_setzero_si128())); memcpy(&out, &shuffled, 16u);",
        "#else",
        "    for (uint32_t i = 0; i < " .. tostring(
            width
        )
        .. "u; ++i) { uint8_t index = ((const uint8_t *)&indexes)[i]; ((uint8_t *)&out)[i] = index < 16u ? table.lane[index] : 0u; }",
        "#endif",
        "    return out;",
        "}",
        "static inline __attribute__((unused)) "
        .. vector
        .. " ks_align_"
        .. suffix
        .. "("
        .. vector
        .. " previous, "
        .. vector
        .. " current, uint32_t offset) {",
        "    " .. vector .. " out = (" .. vector .. "){ " .. table.concat(zeros, ", ") .. " };",
        "    if (offset < 1u || offset > 3u) return out;",
        "#if defined(__aarch64__)",
        width == 16
        and "    uint8x16_t a, b, r; memcpy(&a, &previous, 16u); memcpy(&b, &current, 16u); if (offset == 1u) r = vextq_u8(a, b, 15); else if (offset == 2u) r = vextq_u8(a, b, 14); else r = vextq_u8(a, b, 13); memcpy(&out, &r, 16u);"
        or "    uint8x16_t p1, c0, c1, r0, r1; memcpy(&p1, ((const uint8_t *)&previous) + 16u, 16u); memcpy(&c0, &current, 16u); memcpy(&c1, ((const uint8_t *)&current) + 16u, 16u); if (offset == 1u) { r0 = vextq_u8(p1, c0, 15); r1 = vextq_u8(c0, c1, 15); } else if (offset == 2u) { r0 = vextq_u8(p1, c0, 14); r1 = vextq_u8(c0, c1, 14); } else { r0 = vextq_u8(p1, c0, 13); r1 = vextq_u8(c0, c1, 13); } memcpy(&out, &r0, 16u); memcpy(((uint8_t *)&out) + 16u, &r1, 16u);",
        "#elif defined(__AVX2__) && " .. tostring(width) .. " == 32",
        "    __m256i a, b, bridge, r; memcpy(&a, &previous, 32u); memcpy(&b, &current, 32u); bridge = _mm256_permute2x128_si256(a, b, 0x21); if (offset == 1u) r = _mm256_alignr_epi8(b, bridge, 15); else if (offset == 2u) r = _mm256_alignr_epi8(b, bridge, 14); else r = _mm256_alignr_epi8(b, bridge, 13); memcpy(&out, &r, 32u);",
        "#elif defined(__SSSE3__) && " .. tostring(width) .. " == 16",
        "    __m128i a, b, r; memcpy(&a, &previous, 16u); memcpy(&b, &current, 16u); if (offset == 1u) r = _mm_alignr_epi8(b, a, 15); else if (offset == 2u) r = _mm_alignr_epi8(b, a, 14); else r = _mm_alignr_epi8(b, a, 13); memcpy(&out, &r, 16u);",
        "#else",
        "    memcpy(&out, ((const uint8_t *)&previous) + " .. tostring(
            width
        ) .. "u - offset, offset); memcpy(((uint8_t *)&out) + offset, &current, " .. tostring(width) .. "u - offset);",
        "#endif",
        "    return out;",
        "}",
        "static inline __attribute__((unused)) " .. vector .. " ks_tail_" .. suffix .. "(uint32_t active) {",
        "    " .. vector .. " out;",
        "    if (active > " .. tostring(width) .. "u) active = " .. tostring(width) .. "u;",
        "    for (uint32_t i = 0; i < " .. tostring(width) .. "u; ++i) out[i] = i < active ? UINT8_MAX : 0u;",
        "    return out;",
        "}",
        "static inline __attribute__((unused)) uint32_t ks_bits_" .. suffix .. "(" .. vector .. " mask) {",
        "    uint32_t bits = 0u;",
        "    const uint64_t high_bits = UINT64_C(0x8080808080808080);",
        "    const uint64_t pack_bits = UINT64_C(0x0002040810204081);",
        "    for (uint32_t i = 0; i < " .. tostring(width / 8) .. "u; ++i) {",
        "        uint64_t word;",
        "        memcpy(&word, ((const uint8_t *)&mask) + i * 8u, 8u);",
        "        bits |= (uint32_t)(((word & high_bits) * pack_bits) >> 56u) << (i * 8u);",
        "    }",
        "    return bits;",
        "}",
        "",
    }
    lines[#lines + 1] = "typedef struct { uint8_t lane[" .. tostring(width) .. "]; } ks_scalar_" .. suffix .. ";"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_load_"
        .. suffix
        .. "(const uint8_t *source, size_t count, uint32_t offset) {"
    lines[#lines + 1] = "    ks_scalar_" .. suffix .. " out = {{0}};"
    lines[#lines + 1] = "    if ((size_t)offset < count) {"
    lines[#lines + 1] = "        size_t active = count - (size_t)offset;"
    lines[#lines + 1] = "        if (active > " .. tostring(width) .. "u) active = " .. tostring(width) .. "u;"
    lines[#lines + 1] = "        memcpy(out.lane, source + offset, active);"
    lines[#lines + 1] = "    }"
    lines[#lines + 1] = "    return out;"
    lines[#lines + 1] = "}"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_splat_"
        .. suffix
        .. "(uint8_t value) { ks_scalar_"
        .. suffix
        .. " out; for (uint32_t i = 0; i < "
        .. tostring(
        width
    ) .. "u; ++i) out.lane[i] = value; return out; }"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_shr_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " value, uint32_t count) { if (count >= 8u) return ks_scalar_splat_"
        .. suffix
        .. "(0u); for (uint32_t i = 0; i < "
        .. tostring(
        width
    ) .. "u; ++i) value.lane[i] = (uint8_t)(value.lane[i] >> count); return value; }"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_padded_load_full_"
        .. suffix
        .. "(const KsPaddedStringU8x"
        .. tostring(
        width
    ) .. " *view, uint32_t offset) {"
    lines[
        #lines + 1
    ] = "    ks_scalar_" .. suffix .. " out = {{0}}; if (offset >= view->full_length || offset % " .. tostring(
        width
    ) .. "u != 0u) return out; memcpy(out.lane, view->source + offset, " .. tostring(width) .. "u); return out;"
    lines[#lines + 1] = "}"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_padded_load_tail_"
        .. suffix
        .. "(const KsPaddedStringU8x"
        .. tostring(
        width
    ) .. " *view) { ks_scalar_" .. suffix .. " out = {{0}}; memcpy(out.lane, &view->tail, " .. tostring(
        width
    ) .. "u); return out; }"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_lookup16_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " indexes, KsTableU8x16 table) { ks_scalar_"
        .. suffix
        .. " out = {{0}}; for (uint32_t i = 0; i < "
        .. tostring(
        width
    ) .. "u; ++i) out.lane[i] = indexes.lane[i] < 16u ? table.lane[indexes.lane[i]] : 0u; return out; }"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_align_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " previous, ks_scalar_"
        .. suffix
        .. " current, uint32_t offset) { ks_scalar_"
        .. suffix
        .. " out = {{0}}; if (offset < 1u || offset > 3u) return out; memcpy(out.lane, previous.lane + "
        .. tostring(
        width
    ) .. "u - offset, offset); memcpy(out.lane + offset, current.lane, " .. tostring(
        width
    ) .. "u - offset); return out; }"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_tail_"
        .. suffix
        .. "(uint32_t active) {"
    lines[#lines + 1] = "    ks_scalar_" .. suffix .. " out;"
    lines[#lines + 1] = "    if (active > " .. tostring(width) .. "u) active = " .. tostring(width) .. "u;"
    lines[
        #lines + 1
    ] = "    for (uint32_t i = 0; i < " .. tostring(width) .. "u; ++i) out.lane[i] = i < active ? UINT8_MAX : 0u;"
    lines[#lines + 1] = "    return out;"
    lines[#lines + 1] = "}"
    for _, operation in ipairs({"and", "or", "xor"}) do
        local verb = operation == "and" and "&" or operation == "or" and "|" or "^"
        lines[
            #lines + 1
        ] = "static inline __attribute__((unused)) ks_scalar_"
            .. suffix
            .. " ks_scalar_"
            .. operation
            .. "_"
            .. suffix
            .. "(ks_scalar_"
            .. suffix
            .. " a, ks_scalar_"
            .. suffix
            .. " b) {"
        lines[
            #lines + 1
        ] = "    for (uint32_t i = 0; i < " .. tostring(width) .. "u; ++i) a.lane[i] " .. verb .. "= b.lane[i];"
        lines[#lines + 1] = "    return a;"
        lines[#lines + 1] = "}"
    end
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_not_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " a) {"
    lines[#lines + 1] = "    for (uint32_t i = 0; i < " .. tostring(width) .. "u; ++i) a.lane[i] = (uint8_t)~a.lane[i];"
    lines[#lines + 1] = "    return a;"
    lines[#lines + 1] = "}"
    for _, comparison in ipairs({"eq", "range"}) do
        local parameters = comparison == "eq" and "uint8_t value" or "uint8_t low, uint8_t high"
        local condition = comparison == "eq" and "a.lane[i] == value" or "a.lane[i] >= low && a.lane[i] <= high"
        lines[
            #lines + 1
        ] = "static inline __attribute__((unused)) ks_scalar_"
            .. suffix
            .. " ks_scalar_"
            .. comparison
            .. "_"
            .. suffix
            .. "(ks_scalar_"
            .. suffix
            .. " a, "
            .. parameters
            .. ") {"
        lines[
            #lines + 1
        ] = "    for (uint32_t i = 0; i < " .. tostring(
            width
        ) .. "u; ++i) a.lane[i] = " .. condition .. " ? UINT8_MAX : 0u;"
        lines[#lines + 1] = "    return a;"
        lines[#lines + 1] = "}"
    end
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) ks_scalar_"
        .. suffix
        .. " ks_scalar_select_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " mask, ks_scalar_"
        .. suffix
        .. " yes, ks_scalar_"
        .. suffix
        .. " no) {"
    lines[
        #lines + 1
    ] = "    for (uint32_t i = 0; i < " .. tostring(
        width
    ) .. "u; ++i) yes.lane[i] = mask.lane[i] ? yes.lane[i] : no.lane[i];"
    lines[#lines + 1] = "    return yes;"
    lines[#lines + 1] = "}"
    lines[
        #lines + 1
    ] = "static inline __attribute__((unused)) uint32_t ks_scalar_bits_"
        .. suffix
        .. "(ks_scalar_"
        .. suffix
        .. " mask) {"
    lines[#lines + 1] = "    uint32_t bits = 0u;"
    lines[
        #lines + 1
    ] = "    for (uint32_t i = 0; i < " .. tostring(width) .. "u; ++i) bits |= (uint32_t)(mask.lane[i] != 0u) << i;"
    lines[#lines + 1] = "    return bits;"
    lines[#lines + 1] = "}"
    lines[#lines + 1] = ""

    return lines
end

--- One helper's C parameter list.
local function helperParams(helper: scalarIR.Helper): string
    local parts: {string} = {}
    for position, param in ipairs(helper.params) do
        parts[position] = emit.cType(param.type) .. " " .. tostring(param.cName)
    end

    return table.concat(parts, ", ")
end

--- The visible pure helpers, as C.
---
--- Result structs first, then every prototype, then every definition, so a
--- helper may call one declared after it. Each is `static inline`, because they
--- exist to be inlined into the loop and a helper that survived as a call would
--- be a call in the innermost loop of the program.
function emit.helpers(helpers: {scalarIR.Helper}): {string}
    local lines: {string} = {}
    for _, helper in ipairs(helpers) do
        if #helper.resultTypes > 1 then
            helper.cResult = helper.cName .. "_result"
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(helper.resultTypes) do
                lines[#lines + 1] = "    " .. emit.cType(resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. tostring(helper.cResult) .. ";"
        end
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        local result = helper.cResult or emit.cType(helper.resultType)
        lines[#lines + 1] = "static inline " .. result .. " " .. helper.cName .. "(" .. helperParams(helper) .. ");"
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end

    for _, helper in ipairs(helpers) do
        local result = helper.cResult or emit.cType(helper.resultType)
        lines[#lines + 1] = "static inline " .. result .. " " .. helper.cName .. "(" .. helperParams(helper) .. ") {"
        if helper.cResult ~= nil then
            local values: {string} = {}
            for position, value in ipairs(helper.values) do
                values[position] = emit.lane(value)
            end
            lines[
                #lines + 1
            ] = "    " .. tostring(helper.cResult) .. " result = {" .. table.concat(values, ", ") .. "};"
            lines[#lines + 1] = "    return result;"
        else
            lines[#lines + 1] = "    return " .. emit.lane(helper.values[1]) .. ";"
        end
        lines[#lines + 1] = "}"
        lines[#lines + 1] = ""
    end

    return lines
end

--- What a block needs from the program around it.
record emit.Body
    --- The helpers, for a multiple binding that has to name a call's result
    --- struct.
    helpers: {scalarIR.Helper}

    --- How wide a lane store is, for a body that was rewritten.
    lanes: integer

    --- The private aggregate returned by a multi-result entry.
    resultStruct: string?
end

--- Pushes one verified construction value on the Lua stack.
--- @raises when called with a value the construction verifier does not admit
local function luaPush(value: scalarIR.Expr, prefix: string): {string}
    if value.type == "lua_table" then
        if value.op == "lua_new_table" then
            local created = value as scalarIR.LuaNewTable
            luaTemporary = luaTemporary + 1
            local slot = "lt" .. tostring(luaTemporary)
            local lines: {
                string
            } = {
                prefix .. "if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");",
                prefix .. "lua_createtable(L, ks_lua_count(L, " .. emit.scalar(
                    created.arrayCapacity
                ) .. ", \"array capacity at " .. luaSite(
                    created.source
                ) .. "\"), ks_lua_count(L, " .. emit.scalar(
                    created.hashCapacity
                ) .. ", \"hash capacity at " .. luaSite(created.source) .. "\"));",
            }
            if #(created.fields or {}) > 0 then
                lines[#lines + 1] = prefix .. "int " .. slot .. " = lua_gettop(L);"
            end
            for _, field in ipairs(created.fields or {}) do
                if field.indexed then
                    for _, line in ipairs(luaPush(field.value, prefix)) do
                        lines[#lines + 1] = line
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "lua_rawseti(L, " .. slot .. ", ks_lua_index(L, " .. emit.scalar(
                        field.key
                    ) .. ", \"" .. luaSite(field.source) .. "\"));"
                else
                    for _, part in ipairs({field.key, field.value}) do
                        for _, line in ipairs(luaPush(part, prefix)) do
                            lines[#lines + 1] = line
                        end
                    end
                    lines[#lines + 1] = prefix .. "lua_rawset(L, " .. slot .. ");"
                end
            end

            return lines
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_nil" then
        return {prefix .. "lua_pushnil(L);"}
    elseif value.type == "lua_string" then
        if value.op == "lua_string" then
            local literal = value as scalarIR.LuaString
            return {
                prefix .. "lua_pushlstring(L, " .. cBytes(literal.value) .. ", " .. tostring(#literal.value) .. "u);",
            }
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_value" then
        if value.op == "lua_builder_finish" then
            return {
                prefix .. "ks_lua_builder_finish(L, &" .. tostring(
                    ((value as scalarIR.LuaBuilderFinish).builder as scalarIR.Name).cName
                ) .. ");",
            }
        elseif value.op == "lua_tree" then
            local tree = value as scalarIR.LuaTree
            return {
                prefix .. "ks_lua_tree_push(L, " .. tostring(
                    (tree.nodes as scalarIR.Name).cName
                ) .. ", " .. tostring(
                    (tree.links as scalarIR.Name).cName
                ) .. ", " .. tostring(
                    (tree.sourceBytes as scalarIR.Name).cName
                ) .. ", " .. emit.scalar(
                    tree.root
                ) .. ", " .. tostring((tree.nullValue as scalarIR.Name).cName) .. ");",
            }
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "bool" then
        return {prefix .. "lua_pushboolean(L, " .. emit.scalar(value) .. ");"}
    elseif emit.SCALAR_C[value.type] ~= nil then
        return {prefix .. "lua_pushnumber(L, (double)(" .. emit.scalar(value) .. "));"}
    end

    error("no Lua construction push for " .. tostring(value.type), 0)
end

--- One verified Lua-construction block.
---
--- Logical handles are C integers naming absolute Lua stack slots. The objects
--- themselves never leave the stack, so every allocating API call sees all
--- live construction values rooted.
function emit.luaBlock(statements: {scalarIR.Statement}, depth: integer, body: emit.Body): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)

    local function append(more: {string}): nil
        for _, line in ipairs(more) do
            lines[#lines + 1] = line
        end
    end

    local function nested(inner: {scalarIR.Statement}): nil
        append(emit.luaBlock(inner, depth + 1, body))
    end

    for _, statement in ipairs(statements) do
        if statement.op == "let" and statement.type == "lua_builder" then
            local started = statement.value as scalarIR.LuaBuilder
            local maxDepth = started.maxDepth ~= nil and emit.scalar(
                started.maxDepth as scalarIR.Expr
            ) or "UINT32_C(1024)"
            local stringCapacity = started.stringCapacity ~= nil and emit.scalar(
                started.stringCapacity as scalarIR.Expr
            ) or "UINT32_C(0)"
            lines[
                #lines + 1
            ] = prefix .. "KsLuaBuilder " .. statement.cName .. " = ks_lua_builder_new(L, " .. tostring(
                (started.nullValue as scalarIR.Name).cName
            ) .. ", " .. maxDepth .. ", " .. stringCapacity .. ");"
        elseif statement.op == "let" and statement.type == "lua_scratch_u32" then
            local started = statement.value as scalarIR.LuaScratchU32
            lines[
                #lines + 1
            ] = prefix .. "KsLuaScratchU32 " .. statement.cName .. " = ks_lua_scratch_u32(L, " .. emit.scalar(
                started.capacity
            ) .. ");"
        elseif statement.op == "let" and statement.type == "lua_scratch_u8" then
            local started = statement.value as scalarIR.LuaScratchU8
            lines[
                #lines + 1
            ] = prefix .. "KsLuaScratchU8 " .. statement.cName .. " = ks_lua_scratch_u8(L, " .. emit.scalar(
                started.capacity
            ) .. ");"
        elseif statement.op == "let" and (
            statement.type == "lua_table"
            or statement.type == "lua_string"
            or statement.type == "lua_nil"
            or statement.type == "lua_value"
        ) then
            append(luaPush(statement.value, prefix))
            lines[#lines + 1] = prefix .. "int " .. statement.cName .. " = lua_gettop(L);"
        elseif statement.op == "let" then
            lines[
                #lines + 1
            ] = prefix .. emit.cType(
                statement.type
            ) .. " " .. statement.cName .. " = " .. emit.scalar(statement.value) .. ";"
            if statement.type == "simd_species_u8" then
                lines[#lines + 1] = prefix .. "(void)" .. statement.cName .. ";"
            end
        elseif statement.op == "lua_set_index" then
            local write = statement as scalarIR.LuaSet
            append(luaPush(write.value, prefix))
            lines[
                #lines + 1
            ] = prefix .. "lua_rawseti(L, " .. tostring(
                (write.table as scalarIR.Name).cName
            ) .. ", ks_lua_index(L, " .. emit.scalar(write.key) .. ", \"" .. luaSite(write.source) .. "\"));"
        elseif statement.op == "lua_set_key" then
            local write = statement as scalarIR.LuaSet
            append(luaPush(write.key, prefix))
            append(luaPush(write.value, prefix))
            lines[#lines + 1] = prefix .. "lua_rawset(L, " .. tostring((write.table as scalarIR.Name).cName) .. ");"
        elseif statement.op == "lua_scratch_u32_set" then
            local write = statement as scalarIR.LuaScratchU32Set
            lines[
                #lines + 1
            ] = prefix .. "ks_lua_scratch_u32_set(L, &" .. tostring(
                (write.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(write.index) .. ", " .. emit.scalar(write.value) .. ");"
        elseif statement.op == "lua_scratch_u8_set" then
            local write = statement as scalarIR.LuaScratchU8Set
            lines[
                #lines + 1
            ] = prefix .. "ks_lua_scratch_u8_set(L, &" .. tostring(
                (write.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(
                write.index as scalarIR.Expr
            ) .. ", " .. emit.scalar(write.value as scalarIR.Expr) .. ");"
        elseif statement.op == "lua_scratch_u8_reset" then
            local write = statement as scalarIR.LuaScratchU8Set
            lines[#lines + 1] = prefix .. tostring((write.scratch as scalarIR.Name).cName) .. ".length = 0u;"
        elseif tostring(statement.op):match("^lua_builder_") ~= nil then
            local event = statement as scalarIR.LuaBuild
            local builder = "&" .. tostring((event.builder as scalarIR.Name).cName)
            if event.op == "lua_builder_open_array" or event.op == "lua_builder_open_object" then
                local kind = event.op == "lua_builder_open_array" and "5u" or "6u"
                lines[
                    #lines + 1
                ] = prefix .. "ks_lua_builder_open(L, " .. builder .. ", " .. kind .. ", " .. emit.scalar(
                    event.capacity as scalarIR.Expr
                ) .. ");"
            elseif event.op == "lua_builder_key" or event.op == "lua_builder_string" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. "ks_lua_builder_string(L, " .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.escaped as scalarIR.Expr
                ) .. ", " .. (event.op == "lua_builder_key" and "1" or "0") .. ");"
            elseif event.op == "lua_builder_number_slice" or event.op == "lua_builder_integer_slice" then
                local bytes = event.sourceBytes as scalarIR.Name
                lines[
                    #lines + 1
                ] = prefix .. (
                    event.op == "lua_builder_integer_slice"
                    and "ks_lua_builder_integer_slice(L, "
                    or "ks_lua_builder_number_slice(L, "
                ) .. builder .. ", ks_bytes_" .. tostring(
                    bytes.cName
                ) .. ", ks_length_" .. tostring(
                    bytes.cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(event.length as scalarIR.Expr) .. ");"
            elseif event.op == "lua_builder_key_scratch" or event.op == "lua_builder_string_scratch" then
                lines[
                    #lines + 1
                ] = prefix .. "ks_lua_scratch_u8_push(L, &" .. tostring(
                    (event.scratch as scalarIR.Name).cName
                ) .. ", " .. emit.scalar(
                    event.start as scalarIR.Expr
                ) .. ", " .. emit.scalar(
                    event.length as scalarIR.Expr
                ) .. "); " .. (
                    event.op == "lua_builder_key_scratch"
                    and "ks_lua_builder_key(L, "
                    .. builder
                    .. ");"
                    or "ks_lua_builder_put(L, "
                    .. builder
                    .. ");"
                )
            elseif event.op == "lua_builder_number" then
                lines[
                    #lines + 1
                ] = prefix .. "lua_pushnumber(L, " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. "); ks_lua_builder_put(L, " .. builder .. ");"
            elseif event.op == "lua_builder_boolean" then
                lines[
                    #lines + 1
                ] = prefix .. "lua_pushboolean(L, " .. emit.scalar(
                    event.value as scalarIR.Expr
                ) .. "); ks_lua_builder_put(L, " .. builder .. ");"
            elseif event.op == "lua_builder_null" then
                lines[
                    #lines + 1
                ] = prefix .. "lua_pushvalue(L, " .. tostring(
                    ((event.builder as scalarIR.Name).cName)
                ) .. ".null_index); ks_lua_builder_put(L, " .. builder .. ");"
            elseif event.op == "lua_builder_close" then
                lines[#lines + 1] = prefix .. "ks_lua_builder_close(L, " .. builder .. ");"
            end
        elseif statement.op == "assign" then
            -- Builder scalar assignments retain the ordinary simultaneous
            -- assignment lowering. Lua handles are immutable logical roots.
            lines[#lines + 1] = prefix .. "{"
            append(emit.block({statement}, depth + 1, body))
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "if" then
            for position, clause in ipairs(statement.clauses) do
                lines[
                    #lines + 1
                ] = prefix .. (position == 1 and "if (" or "else if (") .. emit.scalar(clause.condition) .. ") {"
                nested(clause.body)
                lines[#lines + 1] = prefix .. "}"
            end
            if statement.elseBody ~= nil then
                lines[#lines + 1] = prefix .. "else {"
                nested(statement.elseBody)
                lines[#lines + 1] = prefix .. "}"
            end
        elseif statement.op == "fornum" then
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. statement.binding.cName .. " = " .. emit.scalar(
                statement.from
            ) .. "; " .. statement.binding.cName .. " <= (int32_t)" .. emit.scalar(
                statement.to
            ) .. "; ++" .. statement.binding.cName .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "while" then
            lines[#lines + 1] = prefix .. "while (" .. emit.scalar(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "block" then
            lines[#lines + 1] = prefix .. "{"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif statement.op == "return" then
            for _, value in ipairs(statement.values) do
                append(luaPush(value, prefix))
            end
            lines[#lines + 1] = prefix .. "return " .. tostring(#statement.values) .. ";"
        else
            lines[#lines + 1] = prefix .. statement.op .. ";"
        end
    end

    return lines
end

--- The C type one local is declared with.
---
--- A pointer to a struct element carries its own constness, because that is
--- where a shared borrow stops being writable as far as C is concerned.
local function localCType(typeName: string, mutable: boolean): string
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return (mutable and "" or "const ") .. "Ks" .. tostring(layout) .. " *"
    end

    return emit.cType(typeName) .. " "
end

--- One block of statements, scalar or lane, indented by `depth`.
function emit.block(statements: {any}, depth: integer, body: emit.Body): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)
    local temporary = 0

    --- Appends the rendering of a nested block.
    local function nested(inner: {any}): nil
        for _, line in ipairs(emit.block(inner, depth + 1, body)) do
            lines[#lines + 1] = line
        end
    end

    for _, statement in ipairs(statements) do
        local op = statement.op
        if op == "let" then
            if statement.type ~= "simd_species_u8" then
                lines[
                    #lines + 1
                ] = prefix .. localCType(
                    statement.type,
                    statement.value.mutable == true
                ) .. statement.cName .. " = " .. emit.lane(statement.value) .. ";"
            end
        elseif op == "multi_let" then
            temporary = temporary + 1

            local result = ""
            for _, candidate in ipairs(body.helpers) do
                if candidate.name == statement.call.helper then
                    result = tostring(candidate.cResult)
                end
            end

            local temp = "mr" .. tostring(temporary)
            lines[#lines + 1] = prefix .. result .. " " .. temp .. " = " .. emit.lane(statement.call) .. ";"
            for position, bound in ipairs(statement.bindings) do
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    bound.type
                ) .. " " .. bound.cName .. " = " .. temp .. ".v" .. tostring(position) .. ";"
            end
        elseif op == "store" then
            local index = statement.cursorCName ~= nil and "((size_t)" .. tostring(
                statement.cursorCName
            ) .. ")" or statement.indexCName == "i" and "i" or "((size_t)(" .. tostring(
                statement.indexCName
            ) .. " - 1))"
            lines[
                #lines + 1
            ] = prefix .. scalarIR.cIdentifier(
                "p",
                statement.span
            ) .. "[" .. index .. "] = " .. emit.lane(statement.value) .. ";"
        elseif op == "assign" then
            -- Every value into a temporary before any is stored, because
            -- `a, b = b, a` means what it says and storing as it went would not.
            local temps: {string} = {}
            for position, entry in ipairs(statement.values) do
                temporary = temporary + 1
                temps[position] = "as" .. tostring(temporary)
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    entry.target.type
                ) .. " " .. temps[position] .. " = " .. emit.lane(entry.value) .. ";"
            end
            for position, entry in ipairs(statement.values) do
                local target = entry.target.kind == "local" and entry.target.cName or "(" .. emit.lane(
                    entry.target.object
                ) .. "->" .. entry.target.field .. ")"
                lines[#lines + 1] = prefix .. target .. " = " .. temps[position] .. ";"
            end
        elseif op == "vassign" then
            for _, entry in ipairs(statement.values) do
                local target = entry.target
                if target.kind == "vfield" or target.kind == "vspan" then
                    -- Consecutive elements, one lane each. Clang turns the group
                    -- into an interleaving store where the target has one.
                    lines[#lines + 1] = prefix .. "{"
                    lines[
                        #lines + 1
                    ] = prefix .. "    " .. emit.cType(entry.value.type) .. " lanes = " .. emit.lane(entry.value) .. ";"
                    for index = 0, body.lanes - 1 do
                        local address = "p_" .. target.span .. "[i + " .. tostring(index) .. "]"
                        if target.kind == "vfield" then
                            address = address .. "." .. target.field
                        end
                        lines[
                            #lines + 1
                        ] = prefix .. "    " .. address .. " = (" .. emit.storageC(
                            target.scalarType,
                            target.sourceType
                        ) .. ")lanes[" .. tostring(index) .. "];"
                    end
                    lines[#lines + 1] = prefix .. "}"
                else
                    lines[#lines + 1] = prefix .. target.cName .. " = " .. emit.lane(entry.value) .. ";"
                end
            end
        elseif op == "if" then
            local nativeSwitch = statement.nativeSwitch
            if nativeSwitch and #nativeSwitch.arms == #statement.clauses then
                lines[#lines + 1] = prefix .. "switch (" .. emit.scalar(nativeSwitch.selector) .. ") {"
                for position, arm in ipairs(nativeSwitch.arms) do
                    for _, label in ipairs(arm.labels) do
                        local constant = new scalarIR.IntConstant(
                            op = "constant_i32",
                            value = label.value,
                            type = label.type,
                            source = label.source
                        )
                        lines[#lines + 1] = prefix .. "case " .. emit.scalar(constant) .. ":"
                    end
                    lines[#lines + 1] = prefix .. "{"
                    nested(statement.clauses[position].body)
                    lines[#lines + 1] = prefix .. "    break;"
                    lines[#lines + 1] = prefix .. "}"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "default:"
                    lines[#lines + 1] = prefix .. "{"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "    break;"
                    lines[#lines + 1] = prefix .. "}"
                end
                lines[#lines + 1] = prefix .. "}"
            else
                for position, clause in ipairs(statement.clauses) do
                    lines[
                        #lines + 1
                    ] = prefix .. (position == 1 and "if (" or "else if (") .. emit.lane(clause.condition) .. ") {"
                    nested(clause.body)
                    lines[#lines + 1] = prefix .. "}"
                end
                if statement.elseBody ~= nil then
                    lines[#lines + 1] = prefix .. "else {"
                    nested(statement.elseBody)
                    lines[#lines + 1] = prefix .. "}"
                end
            end
        elseif op == "vwhile" then
            -- The loop runs while any lane is live, and a lane that retired
            -- stops contributing without stopping the others.
            lines[
                #lines + 1
            ] = prefix .. emit.cType(
                statement.live.type
            ) .. " " .. statement.live.cName .. " = " .. emit.lane(statement.initial) .. ";"
            lines[
                #lines + 1
            ] = prefix .. "while (ks_any_" .. tostring(statement.live.type) .. "(" .. statement.live.cName .. ")) {"
            lines[
                #lines + 1
            ] = prefix .. "    " .. emit.cType(
                statement.executing.type
            ) .. " " .. statement.executing.cName .. " = " .. statement.live.cName .. ";"
            nested(statement.body)
            lines[
                #lines + 1
            ] = prefix .. "    " .. statement.live.cName .. " &= " .. emit.lane(statement.condition) .. ";"
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vwhile_uniform" then
            -- An ordinary loop over lane-parallel statements. The condition is
            -- scalar, so this is the same `while` the scalar body emits.
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "vbreak" then
            local mask = emit.lane(statement.mask)
            lines[#lines + 1] = prefix .. statement.live.cName .. " &= ~(" .. mask .. ");"
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. mask .. ");"
        elseif op == "vcontinue" then
            lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. emit.lane(statement.mask) .. ");"
        elseif op == "fornum" then
            local counter = statement.binding.cName
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. counter .. " = " .. emit.lane(
                statement.from
            ) .. "; " .. counter .. " <= (int32_t)" .. emit.lane(statement.to) .. "; ++" .. counter .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "while" then
            lines[#lines + 1] = prefix .. "while (" .. emit.lane(statement.condition) .. ") {"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "block" then
            lines[#lines + 1] = prefix .. "{"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "}"
        elseif op == "return" then
            if #statement.values > 1 then
                local values: {string} = {}
                for position, value in ipairs(statement.values) do
                    values[position] = emit.scalar(value)
                end
                lines[
                    #lines + 1
                ] = prefix .. "return (" .. tostring(body.resultStruct) .. "){" .. table.concat(values, ", ") .. "};"
            elseif #statement.values == 1 then
                lines[#lines + 1] = prefix .. "return " .. emit.scalar(statement.values[1]) .. ";"
            else
                lines[#lines + 1] = prefix .. "return;"
            end
        else
            lines[#lines + 1] = prefix .. op .. ";"
        end
    end

    return lines
end

--- One or more programs, as one C file.
---
--- Everything shared is emitted once and everything per function once each: the
--- includes, a struct typedef, and a gang's prelude are shared, while the layout
--- reporters, the helpers and the two function bodies belong to the function
--- that needed them. Two functions reifying one struct get one typedef and two
--- sets of reporters, because a reporter is named after the symbol whose wrapper
--- checks it.
---
--- Two definitions of the same function come out per program: the real one, and
--- a forced-scalar one that is the oracle the lane-parallel body is diffed
--- against. The oracle must not share the real body's lowering, which is why it
--- keeps the scalar statements and carries a pragma refusing vectorisation --
--- including whatever the C compiler would have done on its own.
--- @raises when passed malformed or unverified IR
function emit.program(programs: {scalarIR.Program}, tier: string?): string
    emit.begin()

    local lines = emit.includes()
    local hasBuilder = false
    for _, program in ipairs(programs) do
        hasBuilder = hasBuilder or program.entryMode == "lua-builder"
    end
    if hasBuilder then
        for _, line in ipairs(emit.luaPrelude()) do
            lines[#lines + 1] = line
        end
    end
    local declared: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        for _, layout in ipairs(program.layouts or {}) do
            if not declared[layout.name] then
                declared[layout.name] = true
                for _, line in ipairs(emit.layout(layout)) do
                    lines[#lines + 1] = line
                end
                lines[#lines + 1] = ""
            end
            for _, line in ipairs(emit.layoutReporters(physicalSymbol(program.symbol, tier), layout)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = ""
        end
    end

    -- Lua-callable entries with several scalar results cross the private C ABI
    -- as one explicitly laid-out aggregate. The wrapper immediately unpacks it;
    -- the type never becomes part of the Nupp source API.
    for _, program in ipairs(programs) do
        local resultTypes = program.resultTypes or {}
        if program.entryMode ~= "lua-builder" and #resultTypes > 1 then
            local resultName = scalarIR.cIdentifier("KsResult", program.symbol)
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(resultTypes) do
                lines[#lines + 1] = "    " .. emit.cType(resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. resultName .. ";"
            lines[#lines + 1] = ""
        end
    end

    -- One prelude per distinct gang. A file whose functions chose different
    -- gangs needs both, and the mask helpers are suffixed by their mask so the
    -- two sets do not collide.
    --
    -- A program without a lane body contributes no gang. It used to fall back to
    -- the widest shape, which put that shape's typedefs and helpers in files no
    -- gang was chosen for -- and on a target whose register class is narrower
    -- than the widest shape, a 32-byte vector returned by value is exactly the
    -- `-Wpsabi` the target model exists to avoid.
    local emitted: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        local lanes = program.lanes
        local shape = lanes ~= nil and lane.SHAPE_BY_NAME[(lanes as scalarIR.LaneBody).shape] or nil
        if shape ~= nil then
            local named = (shape as lane.Shape).name
            if not emitted[named] then
                emitted[named] = true
                for _, line in ipairs(emit.prelude(shape as lane.Shape)) do
                    lines[#lines + 1] = line
                end
            end
        end
    end

    for _, line in ipairs(emit.scalarPrelude()) do
        lines[#lines + 1] = line
    end

    local simdWidths: {[integer]: boolean} = {}
    for _, program in ipairs(programs) do
        if program.simdWidth ~= nil and not simdWidths[program.simdWidth as integer] then
            simdWidths[program.simdWidth as integer] = true
            for _, line in ipairs(emit.simdPrelude(program.simdWidth as integer)) do
                lines[#lines + 1] = line
            end
        end
    end

    for _, program in ipairs(programs) do
        explicitWidth = program.simdWidth or 0
        local helpers = program.helpers or {}
        for _, line in ipairs(emit.helpers(helpers)) do
            lines[#lines + 1] = line
        end

        local lanes = program.lanes
        local width = lanes ~= nil and (lanes as scalarIR.LaneBody).lanes or 0
        local resultTypes = program.resultTypes or {}
        local resultStruct = #resultTypes > 1 and scalarIR.cIdentifier("KsResult", program.symbol) or nil
        local body = new emit.Body(helpers = helpers, lanes = width, resultStruct = resultStruct)
        local general = program.body ~= nil
        if program.entryMode == "lua-builder" then
            explicitScalar = false
            lines[#lines + 1] = "static int " .. program.symbol .. "_lua(lua_State *L) {"
            lines[
                #lines + 1
            ] = "    if (!lua_checkstack(L, " .. tostring(
                program.maxStack or 4
            ) .. ")) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
            for position, param in ipairs(program.params) do
                if param.kind == "uniform" then
                    local read = param.type == "bool" and "lua_toboolean(L, " .. tostring(
                        position
                    ) .. ")" or "luaL_checknumber(L, " .. tostring(position) .. ")"
                    lines[
                        #lines + 1
                    ] = "    " .. emit.cType(
                        param.type
                    ) .. " p_" .. param.name .. " = (" .. emit.cType(param.type) .. ")(" .. read .. ");"
                elseif param.kind == "scalar" and (param.type == "lua_string" or param.type == "lua_value") then
                    -- The argument itself is the root. Source uses carry this
                    -- positive absolute stack index; no GC pointer is taken.
                    if param.type == "lua_string" then
                        lines[#lines + 1] = "    size_t ks_length_" .. tostring(param.cName) .. " = 0u;"
                        lines[
                            #lines + 1
                        ] = "    const unsigned char *ks_bytes_" .. tostring(
                            param.cName
                        ) .. " = (const unsigned char *)luaL_checklstring(L, " .. tostring(
                            position
                        ) .. ", &ks_length_" .. tostring(param.cName) .. ");"
                        lines[#lines + 1] = "    (void)ks_bytes_" .. tostring(param.cName) .. ";"
                    end
                else
                    error("Lua builders currently take scalar parameters", 0)
                end
            end
            for _, line in ipairs(emit.luaBlock(program.body or {}, 1, body)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = "    return 0;"
            lines[#lines + 1] = "}"
            lines[#lines + 1] = ""
        else
            local params = emit.parameters(program.params, general)
            local cResult = #resultTypes == 0 and "void" or resultStruct ~= nil and resultStruct or emit.cType(
                resultTypes[1]
            )

            --- One C definition of the kernel.
            local function implementation(symbol: string, forced: boolean): nil
                explicitScalar = forced and program.usesSimd == true
                if forced and general then
                    -- The block may declare locals before its first loop, so a
                    -- loop pragma cannot be placed at function entry. Keep this
                    -- test-only oracle wholly scalar instead.
                    lines[#lines + 1] = "KS_OPTNONE"
                end
                lines[#lines + 1] = "__attribute__((noinline))"
                lines[#lines + 1] = "KS_API " .. cResult .. " " .. symbol .. "(" .. params .. ") {"
                if program.fpContract == true then
                    for _, line in ipairs(emit.contractPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                if not general then
                    for _, line in ipairs(emit.bounds(program.rangeGuard)) do
                        lines[#lines + 1] = line
                    end
                end
                if forced and not general then
                    for _, line in ipairs(emit.forcedScalarPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                if general then
                    for _, line in ipairs(emit.block(program.body or {}, 1, body)) do
                        lines[#lines + 1] = line
                    end
                elseif lanes ~= nil and not forced then
                    for _, line in ipairs(emit.groupBound(width)) do
                        lines[#lines + 1] = line
                    end
                    for _, line in ipairs(emit.block((lanes as scalarIR.LaneBody).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = "    }"
                end
                if not general then
                    lines[#lines + 1] = "    for (; i < end; ++i) {"
                    for _, line in ipairs(emit.block((program.loop as scalarIR.Loop).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = "    }"
                end
                lines[#lines + 1] = "}"
                lines[#lines + 1] = ""
            end

            if not general or program.usesSimd == true then
                implementation(physicalSymbol(program.symbol .. "_forced_scalar", tier), true)
            end
            implementation(physicalSymbol(program.symbol, tier), false)
        end
    end

    local builders: {scalarIR.Program} = {}
    local registrar: string? = nil
    for _, program in ipairs(programs) do
        if program.entryMode == "lua-builder" then
            registrar = registrar or program.registrar
            if registrar ~= program.registrar then
                error("one translation unit carried multiple Lua registrars", 0)
            end
            builders[#builders + 1] = program
        end
    end
    if #builders > 0 then
        lines[#lines + 1] = "KS_API int " .. physicalSymbol(tostring(registrar), tier) .. "(lua_State *L) {"
        lines[#lines + 1] = "    if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
        lines[#lines + 1] = "    lua_createtable(L, 0, " .. tostring(#builders) .. ");"
        lines[#lines + 1] = "    int registry = lua_gettop(L);"
        for _, program in ipairs(builders) do
            lines[
                #lines + 1
            ] = "    lua_pushlstring(L, " .. cBytes(program.name) .. ", " .. tostring(#program.name) .. "u);"
            lines[#lines + 1] = "    lua_pushcclosure(L, " .. program.symbol .. "_lua, 0);"
            lines[#lines + 1] = "    lua_rawset(L, registry);"
        end
        lines[#lines + 1] = "    return 1;"
        lines[#lines + 1] = "}"
        lines[#lines + 1] = ""
    end

    return table.concat(lines, "\n") .. "\n"
end

export = emit
