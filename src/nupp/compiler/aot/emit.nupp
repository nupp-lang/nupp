module nupp.compiler.aot.emit

--[[
Rendering verified AOT IR as C.

Generated C is a backend representation and not the safety boundary. Everything
this prints was proved before it ran -- span bounds, region relationships,
conversions, lane widths. C-specific choices are prepared by cplan before
rendering; source validity still belongs to the verifier.

Two things it does owe. Numeric meaning has to survive: an ordinary operator is
binary64 and is not contracted or reassociated unless the source asked, a
physical store narrows and a physical load widens, and the explicitly
fixed-width operations round where the source said they would. And the same IR
has to render the same text every time, because an artifact cache keyed by it
would otherwise miss on every build and a fingerprint would call two identical
programs different.
]]

local bundled = require("nupp.compiler.bundled")
local reducers = require("nupp.compiler.aot.reducers")
local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")
local target = require("nupp.compiler.aot.target")
local verify = require("nupp.compiler.aot.verify")
local visit = require("nupp.compiler.aot.visit")
local simdcast = require("nupp.compiler.aot.simdcast")

local cplan = require("nupp.compiler.aot.cplan")

local emit = {}

--- Fresh names belong to the entire translation unit. Target choices and
--- type caches belong to a single function variant.
record emit.Serials
    luaTemporary: integer
end

record emit.HelperName
    name: string
    result: string?
end

record emit.Context
    explicitWidth: integer
    explicitScalar: boolean
    independentSpanCounts: boolean
    explicitFixedTypes: {[string]: boolean}
    reusableScratchName: string?
    builderEager: boolean
    fpTranscendentals: boolean
    serials: emit.Serials
    types: {[string]: string}
    expressions: cplan.Expressions
    helperNames: {[string]: emit.HelperName}
    scalarHelperNames: {[string]: emit.HelperName}
end

--- Creates a context without changing its parent or the semantic IR.
function emit.context(parent: emit.Context?, program: scalarIR.Program?, scalar: boolean?): emit.Context
    local context = new emit.Context(
        explicitWidth = parent ~= nil and parent.explicitWidth or 0,
        explicitScalar = scalar == true,
        independentSpanCounts = parent == nil or parent.independentSpanCounts,
        explicitFixedTypes = parent ~= nil and parent.explicitFixedTypes or {},
        reusableScratchName = parent ~= nil and parent.reusableScratchName or nil,
        builderEager = parent ~= nil and parent.builderEager,
        fpTranscendentals = parent ~= nil and parent.fpTranscendentals,
        serials = parent ~= nil and parent.serials or new emit.Serials(luaTemporary = 0),
        types = {},
        helperNames = parent ~= nil and program == nil and parent.helperNames or {},
        scalarHelperNames = parent ~= nil and program == nil and parent.scalarHelperNames or {},
        expressions = parent ~= nil and parent.expressions or new cplan.Expressions(comparisons = {}, starts = {})
    )
    if program ~= nil then
        context.explicitWidth = program.simdWidth or 0
        context.independentSpanCounts = scalarIR.independentCounts(program)
        context.reusableScratchName = program.reusableScratch
        context.builderEager = program.builderMode == "eager"
        context.fpTranscendentals = program.fpTranscendentals == true
    end

    return context
end

--- One of the C headers under `aot/include`, as one text chunk.
---
--- The program-independent parts of a generated file are written as C and
--- carried with the compiler like any other resource, and a file gets each of
--- them appended rather than included so `emit-c` and the wasm build keep one
--- self-contained translation unit. What a header is for and what it may be
--- conditioned on is at its top.
--- @raises when this compiler carries no header by that name
function emit.carried(name: string): string
    local text = bundled.source("/aot/include/" .. name)
    if text == nil then
        error("this compiler carries no /aot/include/" .. name)
    end
    -- The enclosing translation unit supplies the separator after each chunk.

    return ((text as string):gsub("\n$", ""))
end

--- The C operator each single-rounded binary32 operation is.
const F32_OPERATORS = {["f32_add"] = "+", ["f32_sub"] = "-", ["f32_mul"] = "*", ["f32_div"] = "/",}

--- The C operator each wrapping int32 operation is, applied in unsigned.
const I32_WRAPPING_OPERATORS = {["i32_add"] = "+", ["i32_sub"] = "-", ["i32_mul"] = "*",}

--- The C operator each uint32 operation is.
const U32_OPERATORS = {
    ["u32_add"] = "+",
    ["u32_sub"] = "-",
    ["u32_mul"] = "*",
    ["u32_and"] = "&",
    ["u32_or"] = "|",
    ["u32_xor"] = "^",
}

--- The C operator each 64-bit operation is, applied in unsigned and cast back.
const WIDE_OPERATORS = {
    ["u64_add"] = "+",
    ["u64_sub"] = "-",
    ["u64_mul"] = "*",
    ["u64_and"] = "&",
    ["u64_or"] = "|",
    ["u64_xor"] = "^",
    ["i64_add"] = "+",
    ["i64_sub"] = "-",
    ["i64_mul"] = "*",
}

--- The C library function each math intrinsic calls.
const MATH_C = {
    ["sqrt"] = "sqrt",
    ["abs"] = "fabs",
    ["floor"] = "floor",
    ["ceil"] = "ceil",
    ["sin"] = "sin",
    ["cos"] = "cos",
    ["tan"] = "tan",
    ["asin"] = "asin",
    ["acos"] = "acos",
    ["atan"] = "atan",
    ["atan2"] = "atan2",
    ["sinh"] = "sinh",
    ["cosh"] = "cosh",
    ["tanh"] = "tanh",
    ["exp"] = "exp",
    ["log"] = "log",
    ["pow"] = "pow",
    ["fmod"] = "fmod",
}

--- The 64-bit mask operations that render as one `ks_mask64_*` helper call,
--- by the verb the helper is named for.
const MASK64_BINARY = {
    ["simd_mask64_add"] = "add",
    ["simd_mask64_and"] = "and",
    ["simd_mask64_or"] = "or",
    ["simd_mask64_xor"] = "xor",
    ["simd_mask64_shl"] = "shl",
    ["simd_mask64_shr"] = "shr",
    ["simd_mask64_prefix_xor"] = "prefix_xor",
}

const MASK64_UNARY = {
    ["simd_mask64_not"] = "not",
    ["simd_mask64_any"] = "any",
    ["simd_mask64_count"] = "count",
    ["simd_mask64_first"] = "first",
    ["simd_mask64_clear_first"] = "clear_first",
}

--- The generic SIMD operations, each with the type that names its species:
--- the node's own (0) or that of one argument.
const GENERIC_SPECIES = {
    ["simd_species"] = 0,
    ["simd_lanes_generic"] = 1,
    ["simd_splat"] = 0,
    ["simd_iota"] = 0,
    ["simd_tail"] = 0,
    ["simd_load"] = 0,
    ["simd_binary"] = 0,
    ["simd_unary"] = 0,
    ["simd_compare"] = 0,
    ["simd_select"] = 0,
    ["simd_mask_any"] = 1,
    ["simd_mask_all"] = 1,
    ["simd_mask_count"] = 1,
    ["simd_mask_first"] = 1,
    ["simd_mask_bits"] = 1,
    ["simd_extract"] = 1,
    ["simd_insert"] = 0,
    ["simd_permute"] = 0,
    ["simd_convert"] = 0,
    ["simd_reinterpret"] = 0,
    ["simd_compress"] = 0,
    ["simd_expand"] = 0,
    ["simd_prefix"] = 0,
    ["simd_horizontal"] = 1,
    ["simd_mask_splat"] = 0,
    ["simd_mask_convert"] = 0,
    ["simd_field_load"] = 0,
    ["simd_call"] = 0,
    ["simd_math"] = 0,
}

--- The binary32 operations whose native instruction is right about the value
--- and wrong about NaN, by the prelude function that repairs each. A lane-wise
--- `simd_call` names one of these through its intrinsic rather than naming a
--- compiled Nupp helper, which is what keeps a vector answer bit-identical to
--- the scalar one: it is the same C function on the same binary32 lane.
const CORRECTED_C = {["f32_min"] = "nupp_f32_min", ["f32_max"] = "nupp_f32_max", ["f32_fma"] = "nupp_f32_fma",}

--- The generic SIMD operations that render as one helper call over their
--- arguments in order, by the verb the helper is named for. The rest that
--- render so are named for their intrinsic.
const GENERIC_CALLS = {
    ["simd_splat"] = "splat",
    ["simd_iota"] = "iota",
    ["simd_tail"] = "tail",
    ["simd_select"] = "select",
    ["simd_extract"] = "extract",
    ["simd_insert"] = "insert",
    ["simd_mask_any"] = "any",
    ["simd_mask_first"] = "first",
    ["simd_mask_bits"] = "bits",
    ["simd_mask_splat"] = "mask_splat",
}

--- The C operator a packed generic binary or comparison intrinsic is.
const GENERIC_OPERATORS = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["and"] = "&",
    ["or"] = "|",
    ["xor"] = "^",
    ["shl"] = "<<",
    ["shr"] = ">>",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "!=",
}

--- The byte-vector logic operations, by helper verb and C operator: the
--- vector and mask forms are the same C, the scalar tier calls the helper and
--- the packed one writes the operator.
const U8_LOGIC = {
    ["simd_vec_and"] = {"and", "&"},
    ["simd_mask_and"] = {"and", "&"},
    ["simd_vec_or"] = {"or", "|"},
    ["simd_mask_or"] = {"or", "|"},
    ["simd_vec_xor"] = {"xor", "^"},
    ["simd_mask_xor"] = {"xor", "^"},
}

--- The byte-vector SIMD operations that render as one helper call over their
--- arguments in order: the helper's name, then the C prefix each argument
--- takes -- an address, a byte narrowing, or nothing.
const U8_CALLS = {
    ["simd_shr_u8"] = {"shr_", "", ""},
    ["simd_shl_u8"] = {"shl_", "", ""},
    ["simd_lookup16_u8"] = {"lookup16_", "", ""},
    ["simd_lookup64_u8"] = {"lookup64_", "", "", "", "", ""},
    ["simd_align_bytes_u8"] = {"align_", "", "", ""},
    ["simd_padded_load_full_u8"] = {"padded_load_full_", "&", ""},
    ["simd_padded_load_tail_u8"] = {"padded_load_tail_", "&"},
    ["simd_bits"] = {"bits_", ""},
    ["simd_block64_load_u8"] = {"block64_load_", "&", ""},
    ["simd_block64_and_byte_u8"] = {"block64_and_byte_", "", "(uint8_t)"},
    ["simd_block64_and_u8"] = {"block64_and_", "", ""},
    ["simd_block64_shr_u8"] = {"block64_shr_", "", ""},
    ["simd_block64_lookup16_u8"] = {"block64_lookup16_", "", ""},
    ["simd_block64_any_bits_u8"] = {"block64_any_bits_", "", "(uint8_t)"},
    ["simd_block64_last_u8"] = {"block64_last_", ""},
    ["simd_block64_utf8_errors_u8"] = {"block64_utf8_errors_", "", "", "", "", ""},
    ["simd_block64_eq_u8"] = {"block64_eq_", "", "(uint8_t)"},
    ["simd_block64_range_u8"] = {"block64_range_", "", "(uint8_t)", "(uint8_t)"},
    ["simd_block64_outside_range_u8"] = {"block64_outside_range_", "", "(uint8_t)", "(uint8_t)"},
}

--- One scratch write as a C statement: `helper` or its `_fixed` form, which
--- takes the buffer's compile-time width as a last argument.
local function scratchWrite(context: emit.Context, helper: string, statement: any, prefix: string): string
    local fixed = statement.fixedBound ~= nil and ", " .. tostring(statement.fixedBound) .. "u" or ""

    return prefix .. helper .. (
        statement.fixedBound ~= nil and "_fixed" or ""
    ) .. "(L, &" .. tostring(
        (statement.scratch as scalarIR.Name).cName
    ) .. ", " .. emit.scalar(
        context,
        statement.index as scalarIR.Expr
    ) .. ", " .. emit.scalar(context, statement.value as scalarIR.Expr) .. fixed .. ");"
end

--- The rooted bytes, their length and the slice bounds one substring names,
--- as the C helpers that take a slice spell them. An absent last bound is the
--- whole length.
local function substringArguments(context: emit.Context, sliced: scalarIR.LuaSubstring): string
    local bytes = sliced.bytes as scalarIR.Name

    return "ks_bytes_" .. tostring(
        bytes.cName
    ) .. ", ks_length_" .. tostring(
        bytes.cName
    ) .. ", " .. emit.scalar(
        context,
        sliced.first
    ) .. ", " .. (
        sliced.last ~= nil and emit.scalar(
            context,
            sliced.last as scalarIR.Expr
        ) or "(double)ks_length_" .. tostring(bytes.cName)
    )
end

----------------------------------------------------------------------------
-- Names, types and literals
----------------------------------------------------------------------------

--- The exported spelling of a logical program symbol in one tier.
local function physicalSymbol(symbol: string, tier: string?): string
    return tier ~= nil and target.symbol(symbol, tier as string) or symbol
end

--- The C spelling of each ordinary binary operator.
---
--- Comparisons are here too: in C they produce `int` rather than a boolean, but
--- every use this subset admits is a condition, and the IR has already typed
--- the result.
const emit.BINARY = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "!=",
    ["and"] = "&&",
    ["or"] = "||",
}

--- The C spelling of each elementwise lane verb.
---
--- Vector extensions give these their elementwise meaning, so a lane operation
--- is written as though it were scalar and the width comes from the operand
--- types rather than from the operator.
const emit.LANE_VERB = {
    ["add"] = " + ",
    ["sub"] = " - ",
    ["mul"] = " * ",
    ["div"] = " / ",
    ["lt"] = " < ",
    ["le"] = " <= ",
    ["gt"] = " > ",
    ["ge"] = " >= ",
    ["eq"] = " == ",
    ["ne"] = " != ",
}

--- The C spelling of each bitwise verb, on the gang's bit vector.
---
--- `sar` is absent: an arithmetic shift needs the operand reinterpreted as
--- signed first, so it is not one operator.
const emit.BITWISE = {["and"] = " & ", ["or"] = " | ", ["xor"] = " ^ ", ["shl"] = " << ", ["shr"] = " >> ",}

--- The C type each IR type is spelled as.
const emit.SCALAR_C = {
    ["bool"] = "bool",
    ["f64"] = "double",
    ["f32"] = "float",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
    ["i64"] = "int64_t",
    ["u64"] = "uint64_t",
}

--- The C spelling of physical storage, distinct from the value a load creates.
const emit.SOURCE_C = {
    ["number"] = "double",
    ["float"] = "float",
    ["int8"] = "int8_t",
    ["int16"] = "int16_t",
    ["int32"] = "int32_t",
    ["uint8"] = "uint8_t",
    ["uint16"] = "uint16_t",
    ["uint32"] = "uint32_t",
    ["int64"] = "int64_t",
    ["uint64"] = "uint64_t",
}

--- The C element type behind each vector.
const emit.VECTOR_ELEMENT_C = {
    ["f64"] = "double",
    ["f32"] = "float",
    ["i8"] = "int8_t",
    ["u8"] = "uint8_t",
    ["i16"] = "int16_t",
    ["u16"] = "uint16_t",
    ["i32"] = "int32_t",
    ["u32"] = "uint32_t",
    ["i64"] = "int64_t",
    ["u64"] = "uint64_t",
}

--- Whether the program selected an explicit SIMD width this backend emits.
local function explicitWidthSelected(context: emit.Context): boolean
    return context.explicitWidth == 16 or context.explicitWidth == 32 or context.explicitWidth == 64
end

--- The vector width of the packed byte scanner under the selected width.
---
--- The scanner's byte compares and shuffles stop at 32 bytes: AVX-512F alone
--- carries no byte-lane instructions, so a 64-byte program scans strings with
--- the 32-byte vector the tier's flags always cover.
local function byteWidth(context: emit.Context): integer
    return math.min(context.explicitWidth, 32) as integer
end

--- Resolves one target-neutral explicit SIMD type for the selected tier.
local function explicitType(context: emit.Context, typeName: string): (string?, string?, integer?, string?)
    local family, element, shape = typeName:match("^simd_(%a+)_([fiu]%d+)_(.+)$")
    if family == nil or element == nil or shape == nil then
        return nil, nil, nil, nil
    end
    local bits = tonumber((element as string):match("%d+"))
    local lanes: integer? = nil
    if shape == "preferred" and bits ~= nil and bits > 0 then
        lanes = math.floor(context.explicitWidth * 8 / bits) as integer
    else
        lanes = tonumber((shape as string):match("^fixed(%d+)$")) as integer?
    end

    return family, element, lanes, shape
end

--- Whether an IR type is one general explicit SIMD family application.
local function genericSimdType(typeName: string): boolean
    return typeName:match(
        "^simd_vector_"
    ) ~= nil or typeName:match("^simd_mask_") ~= nil or typeName:match("^simd_species_") ~= nil
end

--- The C type of one IR type.
---
--- A vector renders as the typedef the prelude emitted for it, and a pointer to
--- a reified struct as that struct's own C name.
---
--- @raises when the IR names a type this backend has no spelling for
local function resolveCType(context: emit.Context, typeName: string): string
    local scalar = emit.SCALAR_C[typeName]
    if scalar ~= nil then
        return scalar as string
    end
    local explicitFamily, explicitElement, explicitLanes = explicitType(context, typeName)
    if explicitFamily ~= nil then
        if not explicitWidthSelected(context) then
            error("explicit SIMD width was not selected", 0)
        end
        local suffix = tostring(explicitElement) .. "x" .. tostring(explicitLanes)
        if explicitFamily == "species" then
            return "uint32_t"
        elseif explicitFamily == "vector" then
            return (context.explicitScalar and "ks_scalar_exp_" or "ks_exp_") .. suffix
        elseif explicitFamily == "mask" then
            return (context.explicitScalar and "ks_scalar_exp_mask_" or "ks_exp_mask_") .. suffix
        elseif explicitFamily == "bitmask" then
            return "uint64_t"
        end
    end
    if typeName == "simd_species_u8" then
        return "uint32_t"
    elseif typeName == "simd_vector_u8" or typeName == "simd_mask_u8" then
        if not explicitWidthSelected(context) then
            error("explicit SIMD width was not selected", 0)
        end
        return (context.explicitScalar and "ks_scalar_u8x" or "ks_u8x") .. tostring(byteWidth(context))
    elseif typeName == "simd_mask_bits64" then
        return "KsMaskBits64"
    elseif typeName == "simd_table_u8x16" then
        return "KsTableU8x16"
    elseif typeName == "simd_padded_string_u8" then
        if not explicitWidthSelected(context) then
            error("explicit SIMD width was not selected", 0)
        end
        return "KsPaddedStringU8x" .. tostring(byteWidth(context))
    elseif typeName == "simd_block_u8x64" then
        if not explicitWidthSelected(context) then
            error("explicit SIMD width was not selected", 0)
        end
        return (context.explicitScalar and "KsScalarBlockU8x64x" or "KsBlockU8x64x") .. tostring(byteWidth(context))
    elseif typeName == "simd_reducer_pairwise_sum"
        or typeName == "simd_reducer_pairwise_product"
        or typeName == "simd_reducer_pairwise_dot"
    then
        return "KsPairwiseF64"
    elseif typeName == "simd_reducer_compensated_sum" then
        return "KsCompensatedF64"
    elseif typeName == "simd_reducer_ordered_sum"
        or typeName == "simd_reducer_algebraic_sum"
        or typeName == "simd_reducer_ordered_product"
        or typeName == "simd_reducer_algebraic_product"
        or typeName == "simd_reducer_ordered_dot"
        or typeName == "simd_reducer_algebraic_dot"
    then
        return "double"
    end
    local _, _, reducerElement = reducers.parse(typeName)
    if reducerElement ~= nil then
        return "KsReduce_" .. reducerElement
    end
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return "Ks" .. (layout as string) .. " *"
    end
    if typeName:match("^[fmiu]%d+x%d+$") ~= nil then
        return "ks_" .. typeName
    end

    error("no C type for " .. tostring(typeName), 0)
end

--- Resolves each physical type once for this target and scalar/vector mode.
function emit.cType(context: emit.Context, typeName: string): string
    local resolved = context.types[typeName]
    if resolved == nil then
        resolved = resolveCType(context, typeName)
        context.types[typeName] = resolved
    end

    return resolved
end

--- The physical C element type for a scalar span or field.
--- @raises when the physical source type has no C spelling
function emit.storageC(context: emit.Context, valueType: string, sourceType: string?): string
    if sourceType ~= nil then
        local physical = emit.SOURCE_C[sourceType as string]
        if physical ~= nil then
            return physical as string
        end
        error("no C storage type for " .. tostring(sourceType), 0)
    end

    return emit.cType(context, valueType)
end

--- The element and lane count a vector name states.
---
--- The name is the authority rather than a table beside it, because the two
--- would otherwise be able to disagree about what `f32x8` means.
---
--- @raises when the name is not a vector type
function emit.vectorParts(vector: string): (string, integer)
    local element = vector:match("^(%a%d+)x")
    local lanes = tonumber(vector:match("x(%d+)$"))
    if element == nil or lanes == nil then
        error("not a vector type: " .. tostring(vector), 0)
    end

    return element as string, lanes as integer
end

--- A binary64 literal, spelled so C reads back exactly what Nupp meant.
---
--- A whole number needs its point, or C makes it an `int` and integer division
--- silently replaces the binary64 the source wrote.
function emit.doubleLiteral(value: string): string
    if value:match("^-?%d+$") ~= nil then
        return value .. ".0"
    end

    return value
end

----------------------------------------------------------------------------
-- Scalar expressions
----------------------------------------------------------------------------

local luaSite: function(source: scalarIR.Source?): string

--- A value comparison for the mixed pairings C converts lossily.
---
--- C's usual arithmetic conversions decide a mixed comparison by converting
--- the signed operand to unsigned, or an integer operand to binary32, so the
--- The C helper family a reducer whose state is more than one `double` uses.
---
--- Ordered and algebraic reducers accumulate into a bare `double`, so they have
--- none and every site answering nil here emits an operator instead. Naming the
--- two that do in one place keeps the six sites that construct, contribute to
--- and finalize a reducer from each growing their own copy of the list.
local function reducerHelper(order: string, operation: string, element: string?): string?
    if element ~= nil and reducers.valid(order, operation, element) then
        return reducers.helper(order, operation, element)
    end
    if order == "pairwise" then
        return operation == "product" and "ks_pairwise_f64_product_" or "ks_pairwise_f64_"
    elseif order == "compensated" then
        return "ks_compensated_f64_"
    end

    return nil
end

--- The C operator one lane-wise explicit SIMD accumulator combines by.
const SIMD_ACCUMULATE_OPERATORS = {
    ["sum"] = "+",
    ["dot"] = "+",
    ["product"] = "*",
    ["and"] = "&",
    ["or"] = "|",
    ["xor"] = "^",
}

--- The vector an explicit SIMD region accumulates one reducer in: the
--- contributed species for an algebraic order, its unsigned counterpart for an
--- exact one so wrapping is defined until the fold recovers the signed value.
local function simdAccumulatorType(order: string, element: string?, vectorType: string): string
    if order == "exact" and element ~= nil then
        local shape = vectorType:match("^simd_vector_[fiu]%d+_(.+)$")
        return "simd_vector_u" .. element:sub(2) .. "_" .. tostring(shape)
    end

    return vectorType
end

--- bare operator answers a different question than the source wrote and the
--- constant folder answers. Pairings whose implicit conversion preserves the
--- value keep the bare operator; the rest compare by value here.
--- The integer under a binary64 promotion, if the operand is one.
local function comparisonOperand(context: emit.Context, operand: cplan.Operand): string
    local value = operand.count ~= nil and (
        context.independentSpanCounts and "count_" .. operand.count or "count"
    ) or emit.scalar(context, operand.value as scalarIR.Expr)
    return (operand.cast ~= "" and "(" .. operand.cast .. ")" or "") .. value
end

local function mixedComparison(context: emit.Context, node: scalarIR.Expr): string?
    local selected = context.expressions.comparisons[node]
    if selected == nil then
        return nil
    end
    local left = comparisonOperand(context, selected.left)
    local right = comparisonOperand(context, selected.right)
    if selected.call then
        return selected.name .. "(" .. left .. ", " .. right .. ")"
    end

    return "(" .. left .. " " .. (emit.BINARY[selected.name] as string) .. " " .. right .. ")"
end

--- Constant lane selections let the C backend form target shuffles without
--- runtime indices. Helper parameters ensure every input is evaluated once.
function emit.rearrange(context: emit.Context, node: scalarIR.Simd): string
    local _, element, lanes, shape = explicitType(context, node.type)
    local width = lanes as integer
    local native = math.floor(context.explicitWidth * 8 / (tonumber((element as string):match("%d+")) as number))
    local composite = shape ~= "preferred" and width ~= native
    local part = tonumber((node.args[#node.args] as scalarIR.Constant).value) as integer
    local selected: {string} = {}
    for i = 0, width - 1 do
        local row: integer = 0
        local index: integer = 0
        if node.intrinsic == "interleave" then
            local position = part * width + i
            row = position % 2
            index = math.floor(position / 2) as integer
        elseif node.intrinsic == "deinterleave" then
            local position = i * 2 + part
            row = math.floor(position / width) as integer
            index = position % width
        else
            row = i
            index = part
        end
        local value = "(" .. emit.scalar(context, node.args[row + 1]) .. ")"
        if context.explicitScalar then
            selected[i + 1] = value .. ".lane[" .. tostring(index) .. "]"
        elseif composite then
            selected[
                i + 1
            ] = value .. ".chunk[" .. tostring(math.floor(index / native)) .. "][" .. tostring(index % native) .. "]"
        else
            selected[i + 1] = value .. "[" .. tostring(index) .. "]"
        end
    end
    local contents = table.concat(selected, ", ")
    if context.explicitScalar then
        contents = ".lane = {" .. contents .. "}"
    elseif composite then
        local chunks: {string} = {}
        for c = 0, math.ceil(width / native) - 1 do
            local entries: {string} = {}
            for i = 1, native do
                entries[i] = selected[c * native + i] or "0"
            end
            chunks[#chunks + 1] = "{" .. table.concat(entries, ", ") .. "}"
        end
        contents = ".chunk = {" .. table.concat(chunks, ", ") .. "}"
    end

    return "(" .. emit.cType(context, node.type) .. "){" .. contents .. "}"
end

--- Renders the already-selected zero-based span offset.
--- @raises when a span offset was not selected before rendering
function emit.spanFirst(context: emit.Context, offset: scalarIR.Expr): string
    local selected = context.expressions.starts[offset]
    if selected == nil then
        error("span offset reached emission without C selection", 0)
    end
    local cast = selected.cast ~= "" and "(" .. selected.cast .. ")" or ""

    return selected.helper .. "(" .. cast .. emit.scalar(context, selected.value) .. ")"
end

--- A generic store statement: one whole-vector helper when no mask was
--- given, the masked one otherwise.
--- @raises when the stored value has no resolved species
function emit.genericStore(context: emit.Context, store: scalarIR.Simd): string
    if store.intrinsic == "scatter" or store.intrinsic == "scatterUnchecked" then
        return emit.indexedSimd(context, store)
    end
    local _, element, lanes, shape = explicitType(context, store.args[3].type)
    if element == nil or lanes == nil then
        error("generic SIMD store has no resolved species", 0)
    end
    local suffix = element .. "x" .. tostring(lanes)
    local helper = context.explicitScalar and "ks_scalar_exp_" or "ks_exp_"
    local elementBits = tonumber(element:match("%d+")) or 0
    local nativeLanes = elementBits > 0 and math.floor(context.explicitWidth * 8 / elementBits) or 0
    -- The verified cursor store is the whole-vector copy, as the load is.
    if store.cursor ~= nil and (shape == "preferred" or lanes == nativeLanes) then
        return helper .. "store_at_" .. suffix .. "(p_" .. tostring(
            store.span
        ) .. " + (size_t)" .. tostring(store.cursorCName) .. ", " .. emit.scalar(context, store.args[3]) .. ")"
    end
    local count = context.independentSpanCounts and "count_" .. tostring(store.span) or "count"
    local at = "p_" .. tostring(
        store.span
    ) .. ", " .. count .. ", " .. emit.spanFirst(context, store.args[2]) .. ", " .. emit.scalar(context, store.args[3])
    if store.args[4] == nil then
        return helper .. "store_full_" .. suffix .. "(" .. at .. ")"
    end

    return helper .. "store_" .. suffix .. "(" .. at .. ", " .. emit.scalar(context, store.args[4]) .. ")"
end

--- What a staging array of lanes says about its own alignment.
---
--- The lanes a gather and a scatter walk arrive in ordinary C arrays, and one
--- of those is the only thing in a compiled library that a Windows worker has
--- been seen to die on: at thirty-two bytes and wider, GCC decides such an
--- array deserves the vector register it means to move it with, and then moves
--- half of it with an instruction that faults unless the frame is aligned to
--- the same width -- which the Windows x64 frame is not, and which nothing in
--- the prologue makes it. The element's own alignment, asked for explicitly,
--- is what holds the array where the frame can carry it. `KS_LANE_ARRAY_ALIGN`
--- is empty everywhere else.
function emit.laneArrayAlign(element: string): string
    return "KS_LANE_ARRAY_ALIGN(" .. element .. ")"
end

--- How one explicit SIMD species is represented in the C being emitted.
record emit.Species
    element: string
    lanes: integer
    shape: string

    --- `<element>x<lanes>`, the suffix of every helper for the species.
    suffix: string

    --- `ks_exp_` or the oracle's `ks_scalar_exp_`.
    helper: string

    --- The lanes one native register holds at the selected width.
    nativeLanes: integer

    --- Whether the value is an aggregate of native chunks.
    composite: boolean
end

--- Resolves the representation of one explicit SIMD type.
--- @raises when the type is not an explicit SIMD species
local function genericSpecies(context: emit.Context, typeName: string): emit.Species
    local _, element, lanes, shape = explicitType(context, typeName)
    if element == nil or lanes == nil or shape == nil then
        error("generic SIMD operation has no resolved species", 0)
    end
    local elementBits = tonumber(element:match("%d+")) or 0
    local nativeLanes = elementBits > 0 and math.floor(context.explicitWidth * 8 / elementBits) or 0

    return new emit.Species(
        element = element,
        lanes = lanes,
        shape = shape,
        suffix = element .. "x" .. tostring(lanes),
        helper = context.explicitScalar and "ks_scalar_exp_" or "ks_exp_",
        nativeLanes = nativeLanes as integer,
        composite = shape ~= "preferred" and lanes ~= nativeLanes
    )
end

--- Lane `index` of one rendered value, in whichever of the three
--- representations the species has: a native vector indexes directly, the
--- oracle's struct through `lane`, and a composite through its chunk.
local function genericLane(context: emit.Context, species: emit.Species, rendered: string, index: integer): string
    if context.explicitScalar then
        return rendered .. ".lane[" .. tostring(index) .. "]"
    elseif species.composite then
        return rendered .. ".chunk[" .. tostring(
            math.floor(index / species.nativeLanes)
        ) .. "][" .. tostring(index % species.nativeLanes) .. "]"
    end

    return rendered .. "[" .. tostring(index) .. "]"
end

--- One vector of the species built from a C expression per lane.
local function genericAggregate(context: emit.Context, species: emit.Species, lanes: {string}): string
    local cType = species.helper .. species.suffix
    if context.explicitScalar then
        return "(" .. cType .. "){{" .. table.concat(lanes, ", ") .. "}}"
    elseif not species.composite then
        return "(" .. cType .. "){" .. table.concat(lanes, ", ") .. "}"
    end
    local chunkType = "ks_exp_" .. species.element .. "x" .. tostring(species.nativeLanes)
    local chunks: {string} = {}
    local chunkCount = math.ceil(species.lanes / species.nativeLanes) as integer
    for chunk = 0, chunkCount - 1 do
        local members: {string} = {}
        for offset = 0, species.nativeLanes - 1 do
            local index = chunk * species.nativeLanes + offset
            members[#members + 1] = index < species.lanes and lanes[index + 1] or "0"
        end
        chunks[#chunks + 1] = "(" .. chunkType .. "){" .. table.concat(members, ", ") .. "}"
    end

    return "(" .. cType .. "){{" .. table.concat(chunks, ", ") .. "}}"
end

--- A strided field access: one helper over the span, the struct's size and
--- the field's offset. A verified cursor access reads or writes whole lanes at
--- the cursor; anything else passes the count and a mask, an all-true one when
--- the access gave none.
--- @raises when the accessed value has no resolved species
function emit.genericFieldAccess(context: emit.Context, access: scalarIR.Simd, storing: boolean): string
    local species = genericSpecies(context, storing and access.args[3].type or access.type)
    local layoutC = "Ks" .. tostring(access.layout)
    local place = "sizeof(" .. layoutC .. "), offsetof(" .. layoutC .. ", " .. tostring(access.field) .. ")"
    local verb = storing and "field_store" or "field_load"
    local value = storing and ", " .. emit.scalar(context, access.args[3]) or ""
    if access.cursor ~= nil then
        return species.helper .. verb .. "_at_" .. species.suffix .. "(p_" .. tostring(
            access.span
        ) .. " + (size_t)" .. tostring(access.cursorCName) .. ", " .. place .. value .. ")"
    end
    local count = context.independentSpanCounts and "count_" .. tostring(access.span) or "count"
    local active = access.args[storing and 4 or 3]
    local mask = active ~= nil and emit.scalar(
        context,
        active
    ) or species.helper .. "mask_splat_" .. species.suffix .. "(true)"

    return species.helper .. verb .. "_" .. species.suffix .. "(p_" .. tostring(
        access.span
    ) .. ", " .. count .. ", " .. emit.spanFirst(
        context,
        access.args[2]
    ) .. ", " .. place .. value .. ", " .. mask .. ")"
end

--- Indexed memory over logical lanes, including composite representations.
--- @raises when the value and index representations have different lane counts
function emit.indexedSimd(context: emit.Context, node: scalarIR.Simd): string
    local reading = node.op == "simd_load"
    local vectorType = reading and node.type or node.args[3].type
    local _, element, lanes = explicitType(context, vectorType)
    local _, indexElement, indexLanes = explicitType(context, node.args[2].type)
    if element == nil or lanes == nil or indexElement == nil or lanes ~= indexLanes then
        error("SIMD indexed memory needs matching logical lane counts", 0)
    end
    local narrow: {[string]: string} = {u8 = "uint8_t", i8 = "int8_t", u16 = "uint16_t", i16 = "int16_t"}
    local elementC = emit.SCALAR_C[element] or narrow[element]
    local maskC = "uint" .. element:sub(2) .. "_t"
    local suffix = element .. "x" .. tostring(lanes)
    local helper = context.explicitScalar and "ks_scalar_exp_" or "ks_exp_"
    local maskType = "simd_mask_" .. vectorType:sub(#"simd_vector_" + 1)
    local active = node.args[reading and 3 or 4]
    local count = context.independentSpanCounts and "count_" .. tostring(node.span) or "count"
    local parts = {
        "({ " .. emit.cType(
            context,
            node.args[2].type
        ) .. " ks_indices = " .. emit.scalar(context, node.args[2]) .. ";",
        emit.cType(
            context,
            maskType
        ) .. " ks_active = " .. (
            active ~= nil and emit.scalar(
                context,
                active
            ) or helper .. "tail_" .. suffix .. "(" .. tostring(lanes) .. "u)"
        ) .. ";",
        emit.cType(
            context,
            vectorType
        ) .. " ks_values = " .. (reading and "{0}" or emit.scalar(context, node.args[3])) .. ";",
        tostring(
            emit.SCALAR_C[indexElement]
        ) .. " ks_index[" .. tostring(
            lanes
        ) .. "] " .. emit.laneArrayAlign(
            emit.SCALAR_C[indexElement]
        ) .. "; __builtin_memcpy(ks_index, &ks_indices, sizeof(ks_index));",
        maskC .. " ks_mask[" .. tostring(
            lanes
        ) .. "] " .. emit.laneArrayAlign(maskC) .. "; __builtin_memcpy(ks_mask, &ks_active, sizeof(ks_mask));",
        tostring(
            elementC
        ) .. " ks_value[" .. tostring(
            lanes
        ) .. "] " .. emit.laneArrayAlign(elementC) .. "; __builtin_memcpy(ks_value, &ks_values, sizeof(ks_value));",
    }
    local native = not context.explicitScalar and (element:sub(2) == "32" or element:sub(2) == "64")
    if native then
        local bits = element:sub(2)
        local register = bits == "32" and "__m256i" or "__m512i"
        local zero = bits == "32" and "_mm256_setzero_si256()" or "_mm512_setzero_si512()"
        local scale = bits == "32" and "4" or "8"
        parts[#parts + 1] = "\n#if defined(__AVX512F__)\n"
        parts[#parts + 1] = "for (uint32_t ks_base = 0u; ks_base < " .. tostring(lanes) .. "u; ks_base += 8u) {"
        parts[
            #parts + 1
        ] = "int64_t ks_offsets[8] " .. emit.laneArrayAlign(
            "int64_t"
        ) .. " = {0}; " .. tostring(
            elementC
        ) .. " ks_batch[8] " .. emit.laneArrayAlign(elementC) .. " = {0}; __mmask8 ks_enabled = 0;"
        parts[
            #parts + 1
        ] = "uint32_t ks_width = " .. tostring(lanes) .. "u - ks_base; if (ks_width > 8u) ks_width = 8u;"
        parts[
            #parts + 1
        ] = "for (uint32_t ks_part = 0u; ks_part < ks_width; ++ks_part) { uint32_t ks_lane = ks_base + ks_part;"
        parts[
            #parts + 1
        ] = "if (ks_mask[ks_lane] && ks_index[ks_lane] >= 1 && (uint64_t)ks_index[ks_lane] <= (uint64_t)"
            .. count
            .. ") {"
        parts[
            #parts + 1
        ] = "ks_enabled |= (__mmask8)(1u << ks_part); ks_offsets[ks_part] = (int64_t)((uint64_t)ks_index[ks_lane] - 1u); } }"
        parts[#parts + 1] = "__m512i ks_addresses; memcpy(&ks_addresses, ks_offsets, sizeof(ks_addresses));"
        -- GCC's intrinsic is an always-inline function whose scale argument
        -- has to have become a constant by the time the builtin expands, and
        -- MinGW GCC 14 reports it has not. Its own header spells the builtin
        -- with the literal when not optimising, so GCC gets that spelling
        -- always; Clang gets the intrinsic.
        local vectorOf = "__v8" .. (bits == "32" and "si" or "di")
        local builtinSuffix = bits == "32" and "16si" or "8di"
        if reading then
            parts[#parts + 1] = "\n#if defined(__clang__)\n"
            parts[
                #parts + 1
            ] = register
                .. " ks_loaded = _mm512_mask_i64gather_epi"
                .. bits
                .. "("
                .. zero
                .. ", ks_enabled, ks_addresses, p_"
                .. tostring(
                    node.span
                ) .. ", " .. scale .. ");"
            parts[#parts + 1] = "\n#else\n"
            parts[
                #parts + 1
            ] = register
                .. " ks_loaded = ("
                .. register
                .. ")__builtin_ia32_gatherdiv"
                .. builtinSuffix
                .. "(("
                .. vectorOf
                .. ")"
                .. zero
                .. ", p_"
                .. tostring(
                    node.span
                ) .. ", (__v8di)ks_addresses, ks_enabled, " .. scale .. ");"
            parts[#parts + 1] = "\n#endif\n"
            parts[
                #parts + 1
            ] = "memcpy(ks_batch, &ks_loaded, sizeof(ks_batch)); memcpy(ks_value + ks_base, ks_batch, ks_width * sizeof(ks_batch[0]));"
        else
            parts[
                #parts + 1
            ] = "memcpy(ks_batch, ks_value + ks_base, ks_width * sizeof(ks_batch[0])); "
                .. register
                .. " ks_written; memcpy(&ks_written, ks_batch, sizeof(ks_written));"
            parts[#parts + 1] = "\n#if defined(__clang__)\n"
            parts[
                #parts + 1
            ] = "_mm512_mask_i64scatter_epi" .. bits .. "(p_" .. tostring(
                node.span
            ) .. ", ks_enabled, ks_addresses, ks_written, " .. scale .. ");"
            parts[#parts + 1] = "\n#else\n"
            parts[
                #parts + 1
            ] = "__builtin_ia32_scatterdiv" .. builtinSuffix .. "(p_" .. tostring(
                node.span
            ) .. ", ks_enabled, (__v8di)ks_addresses, (" .. vectorOf .. ")ks_written, " .. scale .. ");"
            parts[#parts + 1] = "\n#endif\n"
        end
        parts[#parts + 1] = "}\n#else\n"
    end
    parts[#parts + 1] = "for (uint32_t ks_lane = 0u; ks_lane < " .. tostring(lanes) .. "u; ++ks_lane) {"
    parts[
        #parts + 1
    ] = "if (ks_mask[ks_lane] && ks_index[ks_lane] >= 1 && (uint64_t)ks_index[ks_lane] <= (uint64_t)" .. count .. ") {"
    local address = "p_" .. tostring(node.span) .. "[(size_t)ks_index[ks_lane] - 1u]"
    parts[#parts + 1] = reading and "ks_value[ks_lane] = " .. address .. ";" or address .. " = ks_value[ks_lane];"
    parts[#parts + 1] = "} }"
    if native then
        parts[#parts + 1] = "\n#endif\n"
    end
    parts[
        #parts + 1
    ] = reading and "__builtin_memcpy(&ks_values, ks_value, sizeof(ks_value)); ks_values; })" or "(void)0; })"

    return table.concat(parts, " ")
end

--- Bytes as an unambiguous C string literal.
local function cBytes(value: string): string
    local bytes: {string} = {}
    for index = 1, #value do
        bytes[index] = ("\\x%02x"):format(value:byte(index))
    end

    return '"' .. table.concat(bytes) .. '"'
end

--- One scalar expression, as a C expression.
--- Parenthesised generously so C preserves the IR tree's precedence.
--- @raises when verified IR names an operation with no backend implementation
function emit.scalar(context: emit.Context, node: scalarIR.Expr): string
    local operation = node.op

    if operation == "constant" then
        return emit.doubleLiteral((node as scalarIR.Constant).value)
    elseif operation == "constant_i32" then
        local integer = node as scalarIR.IntConstant
        local number = tonumber(integer.value) or 0
        if integer.type == "u32" then
            return "UINT32_C(" .. ("%.0f"):format(number) .. ")"
        elseif number == -2147483648 then
            return "(-INT32_C(2147483647) - INT32_C(1))"
        elseif number < 0 then
            return "(-INT32_C(" .. ("%.0f"):format(-number) .. "))"
        end

        return "INT32_C(" .. ("%.0f"):format(number) .. ")"
    elseif operation == "constant_i64" then
        local integer = node as scalarIR.Int64Constant
        if integer.type == "u64" then
            return "UINT64_C(" .. integer.value .. ")"
        elseif integer.value:sub(1, 1) == "-" then
            return "(-INT64_C(" .. integer.value:sub(2) .. "))"
        end

        return "INT64_C(" .. integer.value .. ")"
    elseif operation == "bool" then
        return (node as scalarIR.Bool).value and "true" or "false"
    elseif operation == "uniform" then
        return "p_" .. (node as scalarIR.Name).name
    elseif operation == "span_count" then
        return context.independentSpanCounts and "((double)count_" .. (
            node as scalarIR.SpanCount
        ).span .. ")" or "((double)count)"
    elseif operation == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        local _, _, element = reducers.parse(reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "init(" .. emit.scalar(context, reducer.initial) .. ")"
        end

        return emit.scalar(context, reducer.initial)
    elseif operation == "reducer_value" then
        local reducer = node as scalarIR.ReducerValue
        local name = emit.scalar(context, reducer.reducer)
        local _, _, element = reducers.parse(reducer.reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "value(" .. name .. ")"
        end

        return name
    elseif operation == "lua_string_match" then
        local matched = node as scalarIR.LuaStringMatch
        return "ks_lua_string_match(L, " .. emit.scalar(
            context,
            matched.bytes
        ) .. ", " .. cBytes(matched.value) .. ", " .. tostring(#matched.value) .. "u)"
    elseif operation == "lua_string_length" then
        local bytes = (node as scalarIR.LuaBytes).bytes as scalarIR.Name
        return "ks_lua_string_length(L, ks_length_" .. tostring(bytes.cName) .. ")"
    elseif operation == "lua_string_byte_lua" then
        local loaded = node as scalarIR.LuaStringByte
        local bytes = loaded.bytes as scalarIR.Name
        return "ks_lua_string_byte_lua(L, ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(context, loaded.index) .. ")"
    elseif operation == "lua_table_get_index" then
        local loaded = node as scalarIR.LuaTableGet
        return "ks_lua_table_number(L, " .. tostring(
            (loaded.table as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(context, loaded.key) .. ", \"" .. luaSite(loaded.source) .. "\")"
    elseif operation == "lua_string_byte_at" then
        local loaded = node as scalarIR.LuaBytes
        local bytes = loaded.bytes as scalarIR.Name
        return "((uint32_t)ks_bytes_" .. tostring(bytes.cName) .. "[(size_t)" .. tostring(loaded.cursorCName) .. "])"
    elseif operation == "lua_string_byte" or operation == "lua_string_u32" then
        local loaded = node as scalarIR.LuaBytes
        local bytes = loaded.bytes as scalarIR.Name
        local helper = operation == "lua_string_byte" and "ks_lua_string_byte" or "ks_lua_string_u32"
        return helper .. "(L, ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(
            bytes.cName
        ) .. ", " .. emit.scalar(context, loaded.index as scalarIR.Expr) .. ")"
    elseif operation == "lua_builder_depth"
        or operation == "lua_builder_kind"
        or operation == "lua_builder_count"
        or operation == "lua_builder_state"
    then
        local query = node as scalarIR.LuaBuilderQuery
        local which = operation == "lua_builder_depth"
            and "0u"
            or operation == "lua_builder_kind"
            and "1u"
            or operation == "lua_builder_count"
            and "2u"
            or "3u"
        return "ks_lua_builder_query(L, &" .. tostring((query.builder as scalarIR.Name).cName) .. ", " .. which .. ")"
    elseif operation == "lua_builder_number_token" then
        local number = node as scalarIR.LuaBuilderNumberToken
        local bytes = number.sourceBytes as scalarIR.Name
        return "ks_lua_builder_number_token(L, &" .. tostring(
            (number.builder as scalarIR.Name).cName
        ) .. ", ks_bytes_" .. tostring(
            bytes.cName
        ) .. ", ks_length_" .. tostring(
            bytes.cName
        ) .. ", " .. emit.scalar(
            context,
            number.start
        ) .. ", " .. emit.scalar(context, number.limit) .. ", " .. (context.builderEager and "1" or "0") .. ")"
    elseif operation == "lua_scratch_u32_get" or operation == "lua_scratch_u32_escape_get" then
        local loaded = node as scalarIR.LuaScratchU32Get
        if loaded.cursor ~= nil then
            local scratch = tostring((loaded.scratch as scalarIR.Name).cName)
            local index = operation == "lua_scratch_u32_escape_get" and scratch .. ".capacity - 1u - " .. tostring(
                loaded.cursorCName
            ) or tostring(loaded.cursorCName)
            return "((uint32_t)" .. scratch .. ".words[(size_t)(" .. index .. ")])"
        end
        if operation == "lua_scratch_u32_get" and loaded.fixedBound ~= nil then
            return "ks_lua_scratch_u32_get_fixed(L, &" .. tostring(
                (loaded.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(context, loaded.index) .. ", " .. tostring(loaded.fixedBound) .. "u)"
        end

        return (
            operation == "lua_scratch_u32_escape_get"
            and "ks_lua_scratch_u32_escape_get(L, &"
            or "ks_lua_scratch_u32_get(L, &"
        ) .. tostring((loaded.scratch as scalarIR.Name).cName) .. ", " .. emit.scalar(context, loaded.index) .. ")"
    elseif operation == "lua_scratch_u32_length" or operation == "lua_scratch_u32_escape_length" then
        return tostring(
            ((node as scalarIR.LuaScratchU32Length).scratch as scalarIR.Name).cName
        ) .. (operation == "lua_scratch_u32_escape_length" and ".escape_length" or ".length")
    elseif operation == "lua_scratch_u32_append_bits" or operation == "lua_scratch_u32_append_bits_eager" then
        local appended = node as scalarIR.LuaScratchU32AppendBits
        return (
            operation == "lua_scratch_u32_append_bits_eager"
            and "ks_lua_scratch_u32_append_bits_eager(L, &"
            or "ks_lua_scratch_u32_append_bits(L, &"
        ) .. tostring(
            (appended.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(
            context,
            appended.index
        ) .. ", " .. emit.scalar(context, appended.base) .. ", " .. emit.scalar(context, appended.bits) .. ")"
    elseif operation == "lua_scratch_u32_append_string_bits" then
        local appended = node as scalarIR.LuaScratchU32AppendStringBits
        -- One render: the three helpers share every argument except the escape
        -- scratch and its two carries, so only the name and those extras vary.
        local escaped = appended.escapeScratch ~= nil
        local call = (
            escaped
            and "ks_lua_scratch_u32_append_string_escape_bits(L, &"
            or appended.sharedEscapes
            and "ks_lua_scratch_u32_append_string_shared_bits(L, &"
            or "ks_lua_scratch_u32_append_string_bits(L, &"
        ) .. tostring((appended.scratch as scalarIR.Name).cName)
        if escaped then
            call = call .. ", &" .. tostring((appended.escapeScratch as scalarIR.Name).cName)
        end
        call = call .. ", " .. emit.scalar(
            context,
            appended.index
        ) .. ", " .. emit.scalar(
            context,
            appended.base
        ) .. ", " .. emit.scalar(
            context,
            appended.events
        ) .. ", " .. emit.scalar(context, appended.quotes) .. ", " .. emit.scalar(context, appended.slashes)
        if escaped then
            call = call .. ", " .. emit.scalar(
                context,
                appended.slashCarry as scalarIR.Expr
            ) .. ", " .. emit.scalar(context, appended.slashOdd as scalarIR.Expr)
        end
        return call .. ", " .. emit.scalar(
            context,
            appended.inString
        ) .. ", " .. emit.scalar(context, appended.stringEscaped) .. ")"
    elseif operation == "lua_scratch_u8_get" then
        local loaded = node as scalarIR.LuaScratchU8Get
        if loaded.fixedBound ~= nil then
            return "ks_lua_scratch_u8_get_fixed(L, &" .. tostring(
                (loaded.scratch as scalarIR.Name).cName
            ) .. ", " .. emit.scalar(context, loaded.index) .. ", " .. tostring(loaded.fixedBound) .. "u)"
        end

        return "ks_lua_scratch_u8_get(L, &" .. tostring(
            (loaded.scratch as scalarIR.Name).cName
        ) .. ", " .. emit.scalar(context, loaded.index) .. ")"
    elseif operation == "local" or operation == "helper_param" then
        return (node as scalarIR.Name).cName or ""
    elseif operation == "loop_index" then
        return "((double)(i + 1u))"
    elseif operation == "load" then
        local loaded = node as scalarIR.Load
        local index = loaded.cursorCName ~= nil and "((size_t)" .. tostring(
            loaded.cursorCName
        ) .. ")" or loaded.indexCName == "i" and "i" or "((size_t)(" .. tostring(loaded.indexCName) .. " - 1))"
        local access = "p_" .. loaded.span .. "[" .. index .. "]"
        if loaded.sourceType == "int8" or loaded.sourceType == "int16" then
            return "((int32_t)" .. access .. ")"
        elseif loaded.sourceType == "uint8" or loaded.sourceType == "uint16" then
            return "((uint32_t)" .. access .. ")"
        end
        return access
    elseif operation == "element_ref" then
        local referenced = node as scalarIR.ElementRef
        local index = referenced.cursorCName ~= nil and "((size_t)" .. tostring(
            referenced.cursorCName
        ) .. ")" or referenced.indexCName == "i" and "i" or "((size_t)(" .. tostring(referenced.indexCName) .. " - 1))"
        return "(&p_" .. referenced.span .. "[" .. index .. "])"
    elseif tostring(operation):match("^simd_") ~= nil then
        local simd = node as scalarIR.Simd
        local args = simd.args
        local suffix = "u8x" .. tostring(byteWidth(context))
        local helper = context.explicitScalar and "ks_scalar_" or "ks_"
        local speciesArg = GENERIC_SPECIES[tostring(operation)]
        if speciesArg ~= nil then
            local shapedType = speciesArg == 0 and simd.type or args[speciesArg as integer].type
            local _, element, lanes, shape = explicitType(context, shapedType)
            if element == nil or lanes == nil or shape == nil then
                error("generic SIMD operation has no resolved species", 0)
            end
            local genericSuffix = element .. "x" .. tostring(lanes)
            local genericHelper = context.explicitScalar and "ks_scalar_exp_" or "ks_exp_"
            local elementBits = tonumber(element:match("%d+")) or 0
            local nativeLanes = elementBits > 0 and math.floor(context.explicitWidth * 8 / elementBits) or 0
            local composite = shape ~= "preferred" and lanes ~= nativeLanes
            if operation == "simd_mask_bits" and lanes > 64 then
                error("explicit SIMD masks with more than 64 lanes have no uint64 representation", 0)
            end
            if operation == "simd_extract" or operation == "simd_insert" then
                local laneIndex = tonumber((args[2] as scalarIR.Constant).value)
                if laneIndex == nil or laneIndex > lanes then
                    error("explicit SIMD lane index exceeds the selected species", 0)
                end
            end
            if operation == "simd_species" or operation == "simd_lanes_generic" then
                return "UINT32_C(" .. tostring(lanes) .. ")"
            elseif operation == "simd_convert" or operation == "simd_reinterpret" then
                local _, from = explicitType(context, args[1].type)
                return simdcast.emit(
                    emit.scalar(context, args[1]),
                    from as string,
                    element,
                    emit.cType(context, args[1].type),
                    emit.cType(context, simd.type),
                    lanes,
                    context.explicitScalar,
                    operation == "simd_reinterpret"
                )
            elseif operation == "simd_mask_convert" then
                -- Equal lane counts by contract, so a native mask converts
                -- lane-wise; the oracle and a composite go through the bits.
                local source = genericSpecies(context, args[1].type)
                local target = genericSpecies(context, simd.type)
                local rendered = emit.scalar(context, args[1])
                if not context.explicitScalar and not source.composite and not target.composite then
                    return "__builtin_convertvector(" .. rendered .. ", " .. emit.cType(context, simd.type) .. ")"
                end
                return genericHelper
                    .. "mask_from_bits_"
                    .. target.suffix
                    .. "("
                    .. genericHelper
                    .. "bits_"
                    .. source.suffix
                    .. "("
                    .. rendered
                    .. "))"
            elseif operation == "simd_field_load" then
                return emit.genericFieldAccess(context, simd, false)
            elseif operation == "simd_call" or operation == "simd_math" then
                -- One scalar call per lane over the operand locals, gathered
                -- into a vector of the species by a brace initializer.
                local species = genericSpecies(context, simd.type)
                local operands: {string} = {}
                for position, argument in ipairs(args) do
                    operands[position] = emit.scalar(context, argument)
                end
                local elementC = emit.cType(context, element)
                local perLane: {string} = {}
                for index = 0, lanes - 1 do
                    local parts: {string} = {}
                    for position, operand in ipairs(operands) do
                        parts[position] = genericLane(context, species, operand, index)
                    end
                    if operation == "simd_math" then
                        for position, part in ipairs(parts) do
                            parts[position] = "(double)" .. part
                        end
                        perLane[
                            #perLane + 1
                        ] = "(" .. elementC .. ")" .. emit.mathFrom(context, tostring(simd.intrinsic), parts)
                    elseif CORRECTED_C[tostring(simd.intrinsic)] ~= nil then
                        -- A correction is binary32 all the way through: the lane
                        -- goes to the prelude as it stands, because widening it
                        -- would round the answer twice.
                        perLane[
                            #perLane + 1
                        ] = tostring(CORRECTED_C[tostring(simd.intrinsic)]) .. "(" .. table.concat(parts, ", ") .. ")"
                    else
                        local names = context.explicitScalar and context.scalarHelperNames or context.helperNames
                        local selected = names[tostring(simd.helper)]
                        if selected == nil then
                            error("no C helper for " .. tostring(simd.helper), 0)
                        end
                        -- A helper takes and returns binary64, so a float
                        -- species widens each lane in and narrows the result.
                        if element == "f32" then
                            for position, part in ipairs(parts) do
                                parts[position] = "(double)" .. part
                            end
                        end
                        perLane[
                            #perLane + 1
                        ] = "(" .. elementC .. ")" .. selected.name .. "(" .. table.concat(parts, ", ") .. ")"
                    end
                end
                return genericAggregate(context, species, perLane)
            elseif operation == "simd_load" then
                if simd.intrinsic == "gather" then
                    return emit.indexedSimd(context, simd)
                end
                -- A verified cursor access is a whole vector inside the span:
                -- one copy at the cursor, no count and no lane check. A
                -- composite vector keeps the checked form, because its last
                -- chunk may be partial and its size is not its lane count.
                if simd.cursor ~= nil and not composite then
                    return genericHelper .. "load_at_" .. genericSuffix .. "(p_" .. tostring(
                        simd.span
                    ) .. " + (size_t)" .. tostring(simd.cursorCName) .. ")"
                end
                local count = context.independentSpanCounts and "count_" .. tostring(simd.span) or "count"
                local at = "p_" .. tostring(simd.span) .. ", " .. count .. ", " .. emit.spanFirst(context, args[2])
                if args[3] == nil then
                    return genericHelper .. "load_full_" .. genericSuffix .. "(" .. at .. ")"
                end
                return genericHelper .. "load_" .. genericSuffix .. "(" .. at .. ", " .. emit.scalar(
                    context,
                    args[3]
                ) .. ")"
            elseif operation == "simd_binary" or operation == "simd_compare" then
                -- An extremum has no C operator and a contract a bare `<` would
                -- not keep, so every representation calls the helper the prelude
                -- defines for its lanes rather than only the two that call a
                -- helper for everything.
                local named = tostring(simd.intrinsic)
                local extremum = named:match("_min$") ~= nil or named:match("_max$") ~= nil
                if context.explicitScalar or composite or extremum then
                    local family = explicitType(context, args[1].type)
                    local name = family == "mask" and "mask_" .. named or named
                    return genericHelper .. name .. "_" .. genericSuffix .. "(" .. emit.scalar(
                        context,
                        args[1]
                    ) .. ", " .. emit.scalar(context, args[2]) .. ")"
                end
                return "(" .. emit.scalar(
                    context,
                    args[1]
                ) .. " " .. tostring(GENERIC_OPERATORS[named]) .. " " .. emit.scalar(context, args[2]) .. ")"
            elseif operation == "simd_unary" then
                if context.explicitScalar or composite then
                    local family = explicitType(context, simd.type)
                    local name = family == "mask" and "mask_not" or tostring(simd.intrinsic)
                    return genericHelper .. name .. "_" .. genericSuffix .. "(" .. emit.scalar(context, args[1]) .. ")"
                end
                return "(" .. (simd.intrinsic == "neg" and "-" or "~") .. emit.scalar(context, args[1]) .. ")"
            elseif operation == "simd_permute" and (
                simd.intrinsic == "interleave" or simd.intrinsic == "deinterleave" or simd.intrinsic == "transpose"
            ) then
                return emit.rearrange(context, simd)
            elseif operation == "simd_mask_all" or operation == "simd_mask_count" then
                local bits = genericHelper .. "bits_" .. genericSuffix .. "(" .. emit.scalar(context, args[1]) .. ")"
                if operation == "simd_mask_count" then
                    return "((uint32_t)__builtin_popcountll(" .. bits .. "))"
                end
                local all = lanes == 64 and "UINT64_MAX" or "((UINT64_C(1) << " .. tostring(
                    lanes
                ) .. "u) - UINT64_C(1))"
                return "(" .. bits .. " == " .. all .. ")"
            end
            -- Everything else is one helper call over the arguments in order,
            -- named for the operation or for the intrinsic it carries.
            local verb = GENERIC_CALLS[
                tostring(operation)
            ] or (operation == "simd_horizontal" and "horizontal_" or "") .. tostring(simd.intrinsic)
            local rendered: {string} = {}
            for _, argument in ipairs(args) do
                rendered[#rendered + 1] = emit.scalar(context, argument)
            end
            return genericHelper .. tostring(verb) .. "_" .. genericSuffix .. "(" .. table.concat(rendered, ", ") .. ")"
        elseif operation == "simd_species_u8" or operation == "simd_lanes" then
            return "UINT32_C(" .. tostring(byteWidth(context)) .. ")"
        elseif operation == "simd_load_u8" then
            local count = context.independentSpanCounts and "count_" .. tostring(simd.span) or "count"
            return helper .. "load_" .. suffix .. "(p_" .. tostring(
                simd.span
            ) .. ", " .. count .. ", " .. emit.scalar(context, args[2]) .. ")"
        elseif operation == "simd_load_string_u8" then
            local bytes = args[2] as scalarIR.Name
            return helper .. "load_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ", " .. emit.scalar(context, args[3]) .. ")"
        elseif operation == "simd_load_stride3_u8" then
            local strideBytes = args[2] as scalarIR.Name
            return helper .. "load_stride3_" .. suffix .. "(ks_bytes_" .. tostring(
                strideBytes.cName
            ) .. ", ks_length_" .. tostring(
                strideBytes.cName
            ) .. ", " .. emit.scalar(context, args[3]) .. ", " .. emit.scalar(context, args[4]) .. ")"
        elseif operation == "simd_splat_u8" then
            return helper .. "splat_" .. suffix .. "((uint8_t)" .. emit.scalar(context, args[2]) .. ")"
        elseif operation == "simd_table_u8x16" then
            local values: {string} = {}
            for index, argument in ipairs(args) do
                values[index] = "(uint8_t)" .. emit.scalar(context, argument)
            end
            return "((KsTableU8x16){{" .. table.concat(values, ", ") .. "}})"
        elseif operation == "simd_padded_string_u8" then
            local bytes = args[1] as scalarIR.Name
            return "ks_padded_string_" .. suffix .. "(ks_bytes_" .. tostring(
                bytes.cName
            ) .. ", ks_length_" .. tostring(bytes.cName) .. ")"
        elseif operation == "simd_padded_length" then
            return "(" .. emit.scalar(context, args[1]) .. ").length"
        elseif operation == "simd_padded_full_length" then
            return "(" .. emit.scalar(context, args[1]) .. ").full_length"
        elseif operation == "simd_padded_tail_length" then
            return "(" .. emit.scalar(context, args[1]) .. ").tail_length"
        elseif U8_CALLS[tostring(operation)] ~= nil then
            local call = U8_CALLS[tostring(operation)] as {string}
            local rendered: {string} = {}
            for position = 2, #call do
                rendered[#rendered + 1] = call[position] .. emit.scalar(context, args[position - 1])
            end
            return helper .. call[1] .. suffix .. "(" .. table.concat(rendered, ", ") .. ")"
        elseif operation == "simd_tail_u8" then
            return helper .. "tail_" .. suffix .. "(" .. emit.scalar(context, args[2]) .. ")"
        elseif operation == "simd_eq_u8" then
            if context.explicitScalar then
                return helper .. "eq_" .. suffix .. "(" .. emit.scalar(
                    context,
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(context, args[2]) .. ")"
            end
            return "(" .. emit.scalar(
                context,
                args[1]
            ) .. " == ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(context, args[2]) .. "))"
        elseif operation == "simd_range_u8" then
            if context.explicitScalar then
                return helper .. "range_" .. suffix .. "(" .. emit.scalar(
                    context,
                    args[1]
                ) .. ", (uint8_t)" .. emit.scalar(
                    context,
                    args[2]
                ) .. ", (uint8_t)" .. emit.scalar(context, args[3]) .. ")"
            end
            local value = emit.scalar(context, args[1])
            return "((" .. value .. " >= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(
                context,
                args[2]
            ) .. ")) & (" .. value .. " <= ks_splat_" .. suffix .. "((uint8_t)" .. emit.scalar(
                context,
                args[3]
            ) .. ")))"
        elseif U8_LOGIC[tostring(operation)] ~= nil then
            local logic = U8_LOGIC[tostring(operation)] as {string}
            if context.explicitScalar then
                return helper .. logic[
                    1
                ] .. "_" .. suffix .. "(" .. emit.scalar(
                    context,
                    args[1]
                ) .. ", " .. emit.scalar(context, args[2]) .. ")"
            end
            return "(" .. emit.scalar(
                context,
                args[1]
            ) .. " " .. logic[2] .. " " .. emit.scalar(context, args[2]) .. ")"
        elseif operation == "simd_vec_not" or operation == "simd_mask_not" then
            if context.explicitScalar then
                return helper .. "not_" .. suffix .. "(" .. emit.scalar(context, args[1]) .. ")"
            end
            return "(~" .. emit.scalar(context, args[1]) .. ")"
        elseif operation == "simd_select_u8" then
            if context.explicitScalar then
                return helper .. "select_" .. suffix .. "(" .. emit.scalar(
                    context,
                    args[1]
                ) .. ", " .. emit.scalar(context, args[2]) .. ", " .. emit.scalar(context, args[3]) .. ")"
            end
            return "((" .. emit.scalar(
                context,
                args[1]
            ) .. " & " .. emit.scalar(
                context,
                args[2]
            ) .. ") | (~" .. emit.scalar(context, args[1]) .. " & " .. emit.scalar(context, args[3]) .. "))"
        elseif operation == "simd_any" then
            return "(" .. helper .. "any_" .. suffix .. "(" .. emit.scalar(context, args[1]) .. ") != 0u)"
        elseif operation == "simd_all" then
            local all = byteWidth(context) == 32 and "UINT32_MAX" or "UINT32_C(65535)"
            return "(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(context, args[1]) .. ") == " .. all .. ")"
        elseif operation == "simd_count" then
            return "((uint32_t)__builtin_popcount(" .. helper .. "bits_" .. suffix .. "(" .. emit.scalar(
                context,
                args[1]
            ) .. ")))"
        elseif operation == "simd_mask64" then
            return "ks_mask64(" .. emit.scalar(context, args[1]) .. ", " .. emit.scalar(context, args[2]) .. ")"
        elseif MASK64_BINARY[tostring(operation)] ~= nil then
            return "ks_mask64_" .. tostring(
                MASK64_BINARY[tostring(operation)]
            ) .. "(" .. emit.scalar(context, args[1]) .. ", " .. emit.scalar(context, args[2]) .. ")"
        elseif MASK64_UNARY[tostring(operation)] ~= nil then
            return "ks_mask64_" .. tostring(
                MASK64_UNARY[tostring(operation)]
            ) .. "(" .. emit.scalar(context, args[1]) .. ")"
        elseif operation == "simd_mask64_low" then
            return "(" .. emit.scalar(context, args[1]) .. ").low"
        elseif operation == "simd_mask64_high" then
            return "(" .. emit.scalar(context, args[1]) .. ").high"
        end
        error("no C form for SIMD operation " .. tostring(operation), 0)
    elseif operation == "field_load" then
        local field = node as scalarIR.FieldLoad

        return "(" .. emit.scalar(context, field.object) .. "->" .. field.field .. ")"
    elseif operation == "neg" then
        return "(-(" .. emit.scalar(context, (node as scalarIR.Unary).value) .. "))"
    elseif operation == "not" then
        return "(!(" .. emit.scalar(context, (node as scalarIR.Unary).value) .. "))"
    elseif operation == "narrow_f64_f32" then
        return "(float)(" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "f16_to_f32" then
        return "nupp_f16_to_f32(" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "f32_to_f16" then
        return "nupp_f32_to_f16(" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "bf16_to_f32" then
        return "nupp_bf16_to_f32(" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "f32_to_bf16" then
        return "nupp_f32_to_bf16(" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "widen_f32_f64" or operation == "int_to_f64" then
        return "((double)" .. emit.scalar(context, (node as scalarIR.Convert).value) .. ")"
    elseif operation == "numeric_cast" then
        local converted = (node as scalarIR.Convert).value
        local target = node.type == "u32"
            and "uint32_t"
            or node.type == "i32"
            and "int32_t"
            or node.type == "u64"
            and "uint64_t"
            or "int64_t"
        -- A wrap of something that was thirty-two bits a moment ago has nothing
        -- to reduce. The promotion to binary64 is written into the IR rather
        -- than left to the emitter, so it is visible here, and reducing what it
        -- widened would be undoing work to no purpose. This is the shape a
        -- counted loop index takes on its way into a `uint32` position.
        local widened = converted as any
        if (
            node.type == "u32" or node.type == "i32"
        ) and converted.type == "f64" and widened.op == "int_to_f64" and (
            (widened.value as scalarIR.Expr).type == "i32" or (widened.value as scalarIR.Expr).type == "u32"
        ) then
            return "((" .. target .. ")" .. emit.scalar(context, widened.value as scalarIR.Expr) .. ")"
        end
        -- Between the two views of one thirty-two bit pattern a cast reinterprets
        -- and is exact. From any other binary64 it has to reduce first, because
        -- the source can hold values the destination cannot and C leaves that
        -- undefined rather than modular, which is what `wrap` promises.
        if (node.type == "u32" or node.type == "i32") and converted.type == "f64" then
            local wrap = node.type == "u32" and "nupp_wrap_u32(" or "nupp_wrap_i32("

            return wrap .. emit.scalar(context, converted) .. ")"
        end

        return "((" .. target .. ")" .. emit.scalar(context, converted) .. ")"
    end

    local operator = emit.BINARY[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed
        local mixed = mixedComparison(context, node)
        if mixed ~= nil then
            return mixed as string
        end

        return "(" .. emit.scalar(
            context,
            binary.left
        ) .. " " .. (operator as string) .. " " .. emit.scalar(context, binary.right) .. ")"
    end

    return emit.scalarCall(context, node)
end

--- The scalar forms that render as a call rather than an operator: the closed
--- math set, the fixed-width operations, and the corrected three.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarCall(context: emit.Context, node: scalarIR.Expr): string
    local operation = node.op

    -- C float arithmetic is single-rounded -- it does not promote to double --
    -- so this is the binary32 operation the source asked for, and the casts say
    -- so rather than relying on the operands already being float.
    local operator = F32_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((float)(" .. emit.scalar(
            context,
            binary.left
        ) .. ") " .. (operator as string) .. " (float)(" .. emit.scalar(context, binary.right) .. "))"
    end

    -- Wrapping happens in unsigned, where overflow is defined, and comes back.
    operator = I32_WRAPPING_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((int32_t)(nupp_u32(" .. emit.scalar(
            context,
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(context, binary.right) .. ")))"
    end

    operator = U32_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed

        return "((uint32_t)(" .. emit.scalar(
            context,
            binary.left
        ) .. " " .. (operator as string) .. " " .. emit.scalar(context, binary.right) .. "))"
    end

    if operation == "u32_div" or operation == "u32_mod" then
        local binary = node as scalarIR.Fixed
        local helper = operation == "u32_div" and "nupp_u32_div" or "nupp_u32_mod"
        return helper .. "(" .. emit.scalar(context, binary.left) .. ", " .. emit.scalar(context, binary.right) .. ")"
    end

    if operation == "u32_shl" or operation == "u32_shr" then
        local binary = node as scalarIR.Binary
        local shift = "(" .. emit.scalar(context, binary.right) .. " & UINT32_C(31))"
        return "((uint32_t)(" .. emit.scalar(
            context,
            binary.left
        ) .. (operation == "u32_shl" and " << " or " >> ") .. shift .. "))"
    end

    if operation == "u64_shl" or operation == "u64_shr" then
        local binary = node as scalarIR.Fixed
        local shift = "((uint64_t)(" .. emit.scalar(context, binary.right) .. ") & UINT64_C(63))"
        return "((uint64_t)(" .. emit.scalar(
            context,
            binary.left
        ) .. ")" .. (operation == "u64_shl" and " << " or " >> ") .. shift .. ")"
    end

    operator = WIDE_OPERATORS[operation]
    if operator ~= nil then
        local binary = node as scalarIR.Fixed
        local result = "((uint64_t)(" .. emit.scalar(
            context,
            binary.left
        ) .. ") " .. (operator as string) .. " (uint64_t)(" .. emit.scalar(context, binary.right) .. "))"
        return operation:sub(1, 1) == "u" and result or "((int64_t)" .. result .. ")"
    end

    if operation == "f32_sqrt" then
        return "sqrtf(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "f32_exp" then
        return (
            context.fpTranscendentals and "expf(" or "nupp_f32_exp("
        ) .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u32_not" then
        return "((uint32_t)(~" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_popcount" then
        return "((uint32_t)__builtin_popcount(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. "))"
    elseif operation == "u32_ctz" then
        return "nupp_u32_ctz(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u32_clz" then
        return "nupp_u32_clz(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_not" then
        return "((uint64_t)(~(uint64_t)(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")))"
    elseif operation == "u64_popcount" then
        return "((uint32_t)__builtin_popcountll((uint64_t)(" .. emit.scalar(
            context,
            (node as scalarIR.FixedUnary).value
        ) .. ")))"
    elseif operation == "u64_ctz" then
        return "nupp_u64_ctz(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_clz" then
        return "nupp_u64_clz(" .. emit.scalar(context, (node as scalarIR.FixedUnary).value) .. ")"
    elseif operation == "u64_prefix_xor" then
        local bits = emit.scalar(context, (node as scalarIR.FixedUnary).value)
        return "({ uint64_t ks_bits = "
            .. bits
            .. "; ks_bits ^= ks_bits << 1u; ks_bits ^= ks_bits << 2u; ks_bits ^= ks_bits << 4u; "
            .. "ks_bits ^= ks_bits << 8u; ks_bits ^= ks_bits << 16u; ks_bits ^= ks_bits << 32u; ks_bits; })"
    end

    local helper = CORRECTED_C[operation]
    if helper ~= nil then
        local parts: {string} = {}
        local three = node as scalarIR.Corrected
        if three.args ~= nil then
            for position, argument in ipairs(three.args as {scalarIR.Expr}) do
                parts[position] = emit.scalar(context, argument)
            end
        else
            local binary = node as scalarIR.Binary
            parts[1] = emit.scalar(context, binary.left)
            parts[2] = emit.scalar(context, binary.right)
        end

        return (helper as string) .. "(" .. table.concat(parts, ", ") .. ")"
    end

    return emit.scalarBits(context, node)
end

--- The bitwise family, the closed math set, and a helper call.
---
--- Bitwise work happens in unsigned, where overflow and shifts are defined, and
--- comes back as int32. Shift counts are masked to 31 the way `nupp.math.i32`
--- masks them, and an arithmetic shift goes through a helper because C's `>>`
--- on a negative signed value is implementation-defined.
---
--- @raises when the IR names an operation this backend cannot render
function emit.scalarBits(context: emit.Context, node: scalarIR.Expr): string
    local operation = node.op
    local binary = node as scalarIR.Binary

    if operation == "bnot" then
        return "((int32_t)(~nupp_u32(" .. emit.scalar(context, (node as scalarIR.Unary).value) .. ")))"
    end

    local bitwise = {["band"] = "&", ["bor"] = "|", ["bxor"] = "^"}
    local operator = bitwise[operation]
    if operator ~= nil then
        return "((int32_t)(nupp_u32(" .. emit.scalar(
            context,
            binary.left
        ) .. ") " .. (operator as string) .. " nupp_u32(" .. emit.scalar(context, binary.right) .. ")))"
    end

    if operation == "lshift" or operation == "rshift" or operation == "arshift" then
        local left = "nupp_u32(" .. emit.scalar(context, binary.left) .. ")"
        local shift = "(nupp_u32(" .. emit.scalar(context, binary.right) .. ") & 31u)"
        if operation == "lshift" then
            return "((int32_t)(" .. left .. " << " .. shift .. "))"
        elseif operation == "rshift" then
            return "((int32_t)(" .. left .. " >> " .. shift .. "))"
        end

        return "nupp_arshift(" .. left .. ", " .. shift .. ")"
    end

    if operation == "mod" then
        -- Lua's `%` is floored -- `-1 % 3` is 2 -- where C's `fmod` truncates.
        return "nupp_mod(" .. emit.scalar(context, binary.left) .. ", " .. emit.scalar(context, binary.right) .. ")"
    end
    if operation == "pow" then
        return "pow(" .. emit.scalar(context, binary.left) .. ", " .. emit.scalar(context, binary.right) .. ")"
    elseif operation == "helper_call" then
        local call = node as scalarIR.HelperCall
        local parts: {string} = {}
        for position, argument in ipairs(call.args) do
            parts[position] = emit.scalar(context, argument)
        end

        local names = context.explicitScalar and context.scalarHelperNames or context.helperNames
        local selected = names[call.helper]
        if selected == nil then
            error("no C helper for " .. call.helper, 0)
        end
        return selected.name .. "(" .. table.concat(parts, ", ") .. ")"
    elseif operation == "math" then
        return emit.math(context, node as scalarIR.Math)
    end

    error("no C form for scalar operation " .. tostring(operation), 0)
end

--- One operation from the closed math set.
---
--- `min` and `max` go through helpers rather than `fmin`/`fmax`, because Lua's
--- answer for them is a comparison and not IEEE `minNum`. `deg` and `rad` are
--- multiplications rather than library calls, and a two-argument `log` is a
--- ratio, which is what ordinary Nupp computes.
---
--- @raises when the intrinsic is outside the closed set
function emit.math(context: emit.Context, node: scalarIR.Math): string
    local parts: {string} = {}
    for position, argument in ipairs(node.args) do
        parts[position] = emit.scalar(context, argument)
    end

    return emit.mathFrom(context, node.intrinsic, parts)
end

--- The same, over arguments that are already rendered.
---
--- The lane expansion needs this: it renders each argument vector once into a
--- temporary and then indexes it per lane, so what it has are strings. Passing
--- them back through the expression renderer meant wrapping each in a fictional
--- node that had to be a member of the IR without being anything the IR means.
---
--- @raises when the intrinsic is outside the closed set
function emit.mathFrom(context: emit.Context, intrinsic: string, parts: {string}): string
    if intrinsic == "min" or intrinsic == "max" then
        local call = "nupp_" .. intrinsic .. "2(" .. parts[1] .. ", " .. parts[2] .. ")"
        for position = 3, #parts do
            call = "nupp_" .. intrinsic .. "2(" .. call .. ", " .. parts[position] .. ")"
        end

        return call
    end
    if intrinsic == "log" and #parts == 2 then
        return "(log(" .. parts[1] .. ") / log(" .. parts[2] .. "))"
    end
    if intrinsic == "deg" then
        return "(" .. parts[1] .. " * (180.0 / M_PI))"
    elseif intrinsic == "rad" then
        return "(" .. parts[1] .. " * (M_PI / 180.0))"
    end

    local name = MATH_C[intrinsic]
    if name == nil then
        error("no C form for math operation " .. tostring(intrinsic), 0)
    end

    return (name as string) .. "(" .. table.concat(parts, ", ") .. ")"
end

----------------------------------------------------------------------------
-- Lane expressions
----------------------------------------------------------------------------

--- Records the fixed logical SIMD shapes used by one emitted unit.
---
--- Fixed vectors are emitted on demand so an artifact does not carry helper
--- families for source types it never mentions. The semantic IR type is the
--- authority; source aliases and local names cannot affect this inventory.
local function collectExplicitFixed(context: emit.Context, programs: {scalarIR.Program}): nil
    local function remember(typeName: string?): nil
        if typeName == nil or typeName:match("_fixed%d+$") == nil then
            return
        end
        local _, element, lanes = explicitType(context, typeName)
        if element ~= nil and lanes ~= nil then
            context.explicitFixedTypes[element .. "x" .. tostring(lanes)] = true
        end
    end

    local visitor = new visit.Visitor(
        scalarExpression = function(node: scalarIR.Expr): nil
            remember(node.type)
        end,
        scalarStatement = function(node: scalarIR.Statement): nil
            remember((node as any).type)
        end
    )
    for _, program in ipairs(programs) do
        for _, param in ipairs(program.params) do
            remember(param.type)
        end
        for _, helper in ipairs(program.helpers or {}) do
            for _, param in ipairs(helper.params) do
                remember(param.type)
            end
            for _, result in ipairs(helper.resultTypes) do
                remember(result)
            end
        end
        visit.program(program, visitor)
    end
end

--- Expands a vector operation one lane at a time.
---
--- Every operand is a lane local by now -- the lane rewrite bound anything
--- else to one before the statement -- so each lane takes one element of a
--- name rather than of an expression rendered once per lane.
---
--- @param build the scalar expression for one lane, given the names holding
---   the operand vectors and which lane this is
--- @raises when an operand is not a lane local, which is a body the rewrite
---   did not finish rather than anything the source did
function emit.perLane(
    context: emit.Context,
    vector: string,
    args: {any},
    build: function({string}, integer): string
): string
    local names: {string} = {}
    for position, argument in ipairs(args) do
        if argument.op ~= "local" then
            error("a per-lane operand the lane rewrite did not bind: " .. tostring(argument.op))
        end
        names[position] = argument.cName as string
    end

    local _, lanes = emit.vectorParts(vector)
    local parts: {string} = {}
    for index = 0, lanes - 1 do
        parts[index + 1] = build(names, index)
    end

    return "(ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "}"
end

--- Every operand of one lane operation, each taken from the same lane.
local function atLane(names: {string}, index: integer): {string}
    local parts: {string} = {}
    for position, name in ipairs(names) do
        parts[position] = name .. "[" .. tostring(index) .. "]"
    end

    return parts
end

--- One lane expression, as a C expression.
---
--- Anything that is not a lane form falls through to `emit.scalar`: a uniform
--- inside a lane expression is the same value it would be in a scalar body, and
--- rendering it twice would be two chances for the two to differ.
function emit.lane(context: emit.Context, node: lane.Expr | scalarIR.Expr): string
    local operation = node.op
    local vector = tostring(node.type)

    if operation == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        local _, _, element = reducers.parse(reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "init(" .. emit.lane(context, reducer.initial) .. ")"
        end

        return emit.lane(context, reducer.initial)
    elseif operation == "reducer_value" then
        local reducer = node as scalarIR.ReducerValue
        local name = emit.lane(context, reducer.reducer)
        local _, _, element = reducers.parse(reducer.reducer.type)
        local helper = reducerHelper(reducer.order, reducer.operation, element)
        if helper ~= nil then
            return helper .. "value(" .. name .. ")"
        end

        return name
    elseif operation == "vindex" then
        local index = node as lane.Index
        local parts: {string} = {}
        local element = emit.vectorParts(vector)
        local cType = tostring(emit.VECTOR_ELEMENT_C[element])
        for position = 0, index.lanes - 1 do
            parts[position + 1] = "(" .. cType .. ")(i + " .. tostring(position + 1) .. ")"
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vmask" then
        local mask = node as lane.MaskOp
        if mask.verb == "not" then
            return "(~" .. emit.lane(context, mask.args[1]) .. ")"
        else
            return "(" .. emit.lane(
                context,
                mask.args[1]
            ) .. (mask.verb == "and" and " & " or " | ") .. emit.lane(context, mask.args[2]) .. ")"
        end
    elseif operation == "vshort" then
        -- Both sides already ran: the rewrite proved them total before it turned
        -- the short circuit into a mask, so this is the bitwise combination and
        -- not a branch.
        local short = node as lane.ShortCircuit

        return "(" .. emit.lane(
            context,
            short.args[1]
        ) .. (short.verb == "and" and " & " or " | ") .. emit.lane(context, short.args[2]) .. ")"
    elseif operation == "vbinary" then
        local operator = node as lane.Binary

        return "(" .. emit.lane(
            context,
            operator.args[1]
        ) .. tostring(emit.LANE_VERB[operator.verb]) .. emit.lane(context, operator.args[2]) .. ")"
    elseif operation == "vunary" then
        local operator = node as lane.Unary
        if operator.verb == "neg" then
            return "(-" .. emit.lane(context, operator.args[1]) .. ")"
        else
            -- Elementwise, through the width's own library call, so the lane
            -- form is the same operation the scalar one performs.
            local element = emit.vectorParts(vector)
            local call = element == "f32" and "sqrtf(" or "sqrt("

            return emit.perLane(context, vector, operator.args, function(names: {string}, index: integer): string
                return call .. names[1] .. "[" .. tostring(index) .. "])"
            end)
        end
    elseif operation == "vsplat" then
        return "ks_splat_" .. vector .. "(" .. emit.lane(context, (node as lane.Splat).args[1]) .. ")"
    elseif operation == "vbool_splat" then
        -- Suffixed by the mask it produces, so two gangs can share one file.
        return "ks_bool_mask_" .. vector .. "(" .. emit.lane(context, (node as lane.BoolSplat).args[1]) .. ")"
    elseif operation == "vselect" then
        local args = (node as lane.Select).args

        return "ks_sel_" .. vector .. "(" .. emit.lane(
            context,
            args[1]
        ) .. ", " .. emit.lane(context, args[2]) .. ", " .. emit.lane(context, args[3]) .. ")"
    elseif operation == "vfield_load" then
        local load = node as lane.FieldLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]." .. load.field
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vspan_load" then
        local load = node as lane.SpanLoad
        local parts: {string} = {}
        for index = 0, load.lanes - 1 do
            parts[index + 1] = "p_" .. load.span .. "[i + " .. tostring(index) .. "]"
        end

        return "((ks_" .. vector .. "){" .. table.concat(parts, ", ") .. "})"
    elseif operation == "vbitwise" then
        return emit.laneBits(context, node as lane.Bitwise)
    elseif operation == "vround" then
        -- Out to the narrow element and straight back. One rounding, which is
        -- what makes this the same answer as the native narrow instruction.
        local rounded = node as lane.Round

        return "__builtin_convertvector(__builtin_convertvector(" .. emit.lane(
            context,
            rounded.args[1]
        ) .. ", ks_" .. rounded.narrow .. "), ks_" .. vector .. ")"
    elseif operation == "vconvert" then
        -- The arithmetic conversion, not a reinterpretation: widening is exact
        -- and narrowing rounds once, which is what the source asked for at the
        -- point it changed width.
        return "__builtin_convertvector(" .. emit.lane(
            context,
            (node as lane.Convert).args[1]
        ) .. ", ks_" .. vector .. ")"
    elseif operation == "vmask_cast" then
        -- A mask lane is all ones or all zeros, so widening sign-extends -1 to
        -- -1 and narrowing truncates it to -1. Both preserve exactly the two
        -- values a mask has, which is what makes this a conversion.
        return "__builtin_convertvector(" .. emit.lane(
            context,
            (node as lane.MaskCast).args[1]
        ) .. ", ks_" .. vector .. ")"
    elseif operation == "vbits" then
        return "__builtin_convertvector(" .. emit.lane(
            context,
            (node as lane.BitConvert).args[1]
        ) .. ", ks_" .. vector .. ")"
    elseif operation == "vcorrected" then
        -- One scalar helper call per lane, the same helper the scalar body
        -- calls, so the correction cannot be right in one form and wrong in the
        -- other.
        local call = node as lane.Corrected

        return emit.perLane(context, vector, call.args, function(names: {string}, index: integer): string
            return call.helper .. "(" .. table.concat(atLane(names, index), ", ") .. ")"
        end)
    elseif operation == "vmath" then
        -- One scalar call per lane, rendered through the ordinary math path so
        -- the lane-parallel form cannot drift from the scalar one. Clang
        -- recognises the shape and uses a vector library call where it has one.
        local call = node as lane.Math

        return emit.perLane(context, vector, call.args, function(names: {string}, index: integer): string
            return emit.mathFrom(context, call.intrinsic, atLane(names, index))
        end)
    end

    return emit.scalar(context, node as scalarIR.Expr)
end

--- The bitwise family, on the gang's bit vector.
---
--- A shift count is masked to 31 the way `nupp.math.i32` masks it. An arithmetic
--- shift reinterprets the operand as signed first, because the bit vector is
--- unsigned and C's `>>` would otherwise fill with zeros.
function emit.laneBits(context: emit.Context, node: lane.Bitwise): string
    local verb = node.verb
    local vector = tostring(node.type)
    if verb == "not" then
        return "(~" .. emit.lane(context, node.args[1]) .. ")"
    elseif verb == "sar" then
        return "((ks_" .. vector .. ")(((ks_i" .. vector:sub(
            2
        ) .. ")" .. emit.lane(context, node.args[1]) .. ") >> (" .. emit.lane(context, node.args[2]) .. " & 31)))"
    end

    local right = emit.lane(context, node.args[2])
    if verb == "shl" or verb == "shr" then
        right = "(" .. right .. " & 31)"
    end

    return "(" .. emit.lane(context, node.args[1]) .. tostring(emit.BITWISE[verb]) .. right .. ")"
end

----------------------------------------------------------------------------
-- Layouts, parameters and guards
----------------------------------------------------------------------------

--- One reified struct, as a C type whose layout the wrapper checks.
---
--- Nothing here asserts the layout matches: the generated module compares
--- `layoutof` against what the compiled object reports, at load, before the
--- wrapper is exposed. A struct whose C compiler laid it out differently is
--- caught there rather than corrupting memory here.
function emit.layout(context: emit.Context, layout: scalarIR.Layout): {string}
    local lines: {string} = {"typedef struct {"}
    for _, field in ipairs(layout.fields) do
        lines[#lines + 1] = "    " .. emit.storageC(context, field.type, field.sourceType) .. " " .. field.name .. ";"
    end
    lines[#lines + 1] = "} " .. layout.cName .. ";"

    return lines
end

--- Which span parameters the finished body dereferences.
---
--- A body may read a span's length without ever reading through it, and then
--- the pointer is a parameter nothing uses. Generated C is compiled
--- `-Werror`, so left alone that is a build failure on a program `nupp check`
--- and `nupp aot` both accepted -- reported against a line of C the author
--- never wrote.
---
--- Read off the final IR rather than recorded during lowering, because the
--- optimizer runs in between and may be what removed the last read. A count is
--- not a dereference, so `span_count` is the one node naming a span that does
--- not put it in this set.
---
--- Uniforms are here for the same reason and one more: a guard may state a
--- precondition about a parameter the body never reads, which is a fact the
--- generated wrapper checks and the generated C has no use for. The loop's own
--- bounds are read by the loop header rather than by any IR node, so they are
--- put in by hand.
function emit.pointerSpans(program: scalarIR.Program): {[string]: boolean}
    local found: {[string]: boolean} = {}
    local rangeGuard = program.rangeGuard
    if rangeGuard ~= nil then
        found[(rangeGuard as scalarIR.RangeGuard).first] = true
        found[(rangeGuard as scalarIR.RangeGuard).last] = true
    end
    visit.program(
        program,
        new visit.Visitor(
            scalarExpression = function(node: scalarIR.Expr): nil
                if node.op == "uniform" then
                    found[(node as scalarIR.Name).name] = true
                elseif node.op == "load" or node.op == "element_ref" then
                    found[node.span] = true
                elseif node.op == "simd_load_u8" or node.op == "simd_block64_load_u8" then
                    local span = (node as scalarIR.Simd).span
                    if span ~= nil then
                        found[span as string] = true
                    end
                end
            end,
            scalarStatement = function(node: scalarIR.Statement): nil
                if node.op == "store" then
                    found[node.span] = true
                end
            end,
            laneExpression = function(node: lane.Expr): nil
                if node.op == "vfield_load" or node.op == "vspan_load" then
                    found[node.span] = true
                end
            end,
            laneTarget = function(node: lane.Target): nil
                if node.kind == "vfield" or node.kind == "vspan" then
                    found[node.span] = true
                end
            end
        )
    )

    return found
end

--- The private C signature of one kernel.
---
--- A writable span is `restrict` and a readable one is not, which is the alias
--- matrix the checker proved, stated where the C compiler can use it. Nothing
--- infers it from the pointer types.
---
--- `used` names the spans and uniforms the body actually reads. One left out is
--- marked `KS_UNUSED`, which says the parameter may go unread rather than that
--- it does, so a pointer the IR still uses and the emitter drops is caught by
--- the same `-Werror` as before.
function emit.parameters(
    context: emit.Context,
    params: {any},
    independentCounts: boolean?,
    used: {[string]: boolean}?
): string
    local parts: {string} = {}
    for position, param in ipairs(params) do
        local spanned = param.kind == "write_span" or param.kind == "read_span"
        local named = spanned or param.kind == "uniform"
        local unused = named and used ~= nil and not (used as {[string]: boolean})[param.name]
        local name = "p_" .. param.name .. (unused and " KS_UNUSED" or "")
        if param.kind == "write_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(context, param.type, param.sourceType)
            parts[position] = element .. " *restrict " .. name
        elseif param.kind == "read_span" then
            local layout = param.type:match("^struct:(.+)$")
            local element = layout ~= nil and (
                "Ks" .. (layout as string)
            ) or emit.storageC(context, param.type, param.sourceType)
            parts[position] = "const " .. element .. " *" .. name
        else
            parts[position] = emit.cType(context, param.type) .. " " .. name
        end
    end
    if independentCounts then
        for _, param in ipairs(params) do
            if param.kind == "write_span" or param.kind == "read_span" then
                parts[#parts + 1] = "size_t count_" .. param.name
            end
        end
    else
        parts[#parts + 1] = "size_t count"
    end

    return table.concat(parts, ", ")
end

--- Where the loop starts and stops.
---
--- A guarded range was proved in bounds before this ran, so the generated loop
--- reads it rather than checking it again. Without one the whole span is
--- covered.
function emit.bounds(rangeGuard: scalarIR.RangeGuard?): {string}
    if rangeGuard == nil then
        return {"    size_t i = 0;", "    size_t end = count;"}
    end

    return {
        "    (void)count;",
        "    size_t i = (size_t)(p_" .. rangeGuard.first .. " - 1.0);",
        "    size_t end = (size_t)p_" .. rangeGuard.last .. ";",
    }
end

--- The group loop's bounds, for a body that lowered lane-parallel.
---
--- Whole groups only. The remainder runs the same body one iteration at a time,
--- because a masked final group would still read the addresses it masked off and
--- the last element of a span may be the last byte of a page.
function emit.groupBound(lanes: integer): {string}
    local width = tostring(lanes)

    return {
        "    size_t groups = (end > i) ? ((end - i) / " .. width .. ") * " .. width .. " + i : i;",
        "    for (; i < groups; i += " .. width .. ") {",
    }
end

--- Asking one function for a relaxation the source named.
---
--- Scoped to the function rather than set as a build flag, so a relaxation one
--- function asked for cannot quietly change another's answers.
function emit.contractPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang fp contract(fast)", "#endif",}
end

--- Holding the oracle scalar.
---
--- The forced-scalar body is what the lane-parallel one is compared against, so
--- it must not share its lowering -- including whatever the C compiler would
--- have done on its own.
function emit.forcedScalarPragma(): {string}
    return {"#if defined(__clang__)", "#pragma clang loop vectorize(disable) interleave(disable)", "#endif",}
end

----------------------------------------------------------------------------
-- Includes and feature detection
----------------------------------------------------------------------------

--- What every generated file starts with: `ks_prelude.h` carried whole.
function emit.includes(): {string}
    local lines = {"/* Generated from verified test-only native C IR. */"}
    lines[#lines + 1] = emit.carried("ks_prelude.h")

    return lines
end

--- The baseline runtime detector shared by every wrapper in one AOT library:
--- `ks_feature_tier.h` as the whole of one translation unit.
function emit.featureDetector(): string
    local lines = emit.includes()
    lines[#lines + 1] = emit.carried("ks_feature_tier.h")

    return table.concat(lines, "\n") .. "\n"
end

--- The one symbol that says which archive a host actually linked.
---
--- An FFI lookup creates no undefined C reference, so nothing in a static
--- archive is extracted by being called from Lua: the host has to force-load it
--- and keep its symbols. That is a physical link requirement rather than
--- something a generated wrapper can recover from, so the archive exports one
--- function whose name is the component's and whose value is its contents. A
--- name that does not resolve says the archive was not linked; a value that
--- disagrees says the archive that was linked is a different build of it.
---
--- Forty-eight bits rather than sixty-four because the wrapper compares the
--- answer against a Lua number, which is exact to fifty-three.
function emit.archiveProbe(symbol: string, fingerprint: integer): string
    local lines = emit.includes()
    lines[#lines + 1] = "KS_API uint64_t " .. symbol .. "(void) {"
    lines[#lines + 1] = "    return UINT64_C(" .. string.format("%d", fingerprint) .. ");"
    lines[#lines + 1] = "}"

    return table.concat(lines, "\n") .. "\n"
end

--- How large a fixed word buffer may be and still stand on the C stack.
---
--- A thousand words is four kilobytes, which is nothing against a thread stack
--- and more than any buffer an author writes a literal capacity for. Past it
--- the buffer is Lua-owned as before, because a frame is not the place to find
--- out that a capacity was larger than the stack left.
const emit.STACK_SCRATCH_WORDS = 1024

----------------------------------------------------------------------------
-- The Lua interop prelude
----------------------------------------------------------------------------

--- How large a fixed byte buffer may be and still stand on the C stack.
---
--- Four kilobytes, the same allowance the word buffer gets, and for the same
--- reason: it is nothing against a thread stack and more than a literal
--- capacity is written for.
const emit.STACK_SCRATCH_BYTES = 4096

--- The Lua 5.1 interop prelude, for a file with a Lua-callable entry.
---
--- `ks_lua.h` carried whole. `KS_LUA_BUILDER` tells the later preludes the
--- Lua types are declared, and `KS_JSON_WIDE` asks for the exact decimal path
--- and the power-of-five table it reads, which a body that parses no wide
--- decimal leaves out.
function emit.luaPrelude(wideNumbers: boolean): {string}
    local lines: {string} = {"#define KS_LUA_BUILDER 1"}
    if wideNumbers then
        lines[#lines + 1] = "#define KS_JSON_WIDE 1"
    end
    lines[#lines + 1] = emit.carried("ks_lua.h")

    return lines
end

----------------------------------------------------------------------------
-- Layout reporters
----------------------------------------------------------------------------

luaSite = function(source: scalarIR.Source?): string
    return source ~= nil and tostring(
        (source as scalarIR.Source).line
    ) .. ":" .. tostring((source as scalarIR.Source).column) or "1:1"
end

--- What the compiled object reports about one struct's layout.
---
--- A function per measurement rather than a table of numbers, so the answers
--- come from the C compiler that actually laid the struct out and the generated
--- wrapper can compare them against what Nupp believes.
function emit.layoutReporters(symbol: string, layout: scalarIR.Layout): {string}
    local prefix = "KS_API size_t " .. symbol .. "_layout_" .. layout.name
    local lines: {string} = {prefix .. "_size(void) { return sizeof(" .. layout.cName .. "); }"}
    for _, field in ipairs(layout.fields) do
        lines[
            #lines + 1
        ] = prefix
            .. "_offset_"
            .. field.name
            .. "(void) { return offsetof("
            .. layout.cName
            .. ", "
            .. field.name
            .. "); }"
        lines[
            #lines + 1
        ] = prefix
            .. "_size_"
            .. field.name
            .. "(void) { return sizeof((("
            .. layout.cName
            .. " *)0)->"
            .. field.name
            .. "); }"
    end

    return lines
end

----------------------------------------------------------------------------
-- The SIMD prelude
----------------------------------------------------------------------------

--- One value of the given lane, repeated across the gang.
local function repeated(value: string, lanes: integer): string
    local parts: {string} = {}
    for position = 1, lanes do
        parts[position] = value
    end

    return table.concat(parts, ", ")
end

--- Fixed logical species whose size differs from one native register.
---
--- Each production value is an aggregate of preferred native vectors, which
--- keeps `Fixed<N>` target-neutral and still guarantees vector execution when
--- the logical width is smaller, larger, or not an exact register multiple.
--- The helpers themselves are `KS_EXP_FIXED` in `ks_simd.h`; this emits one
--- instantiation of it per species the program mentions, after the header's
--- width block has defined the native species it is built from.
--- @raises when a fixed species has fewer than two or more than 64 lanes
local function fixedSimdPrelude(context: emit.Context, width: integer): {string}
    local lines: {string} = {}
    local keys: {string} = {}
    for key in pairs(context.explicitFixedTypes) do
        keys[#keys + 1] = key
    end
    table.sort(keys)

    local elements = {
        f64 = {c = "double", mask = "int64_t", bytes = 8, kind = "FLOAT"},
        f32 = {c = "float", mask = "int32_t", bytes = 4, kind = "FLOAT"},
        i8 = {c = "int8_t", mask = "int8_t", bytes = 1, kind = "INT"},
        u8 = {c = "uint8_t", mask = "int8_t", bytes = 1, kind = "INT"},
        i16 = {c = "int16_t", mask = "int16_t", bytes = 2, kind = "INT"},
        u16 = {c = "uint16_t", mask = "int16_t", bytes = 2, kind = "INT"},
        i32 = {c = "int32_t", mask = "int32_t", bytes = 4, kind = "INT"},
        u32 = {c = "uint32_t", mask = "int32_t", bytes = 4, kind = "INT"},
        i64 = {c = "int64_t", mask = "int64_t", bytes = 8, kind = "INT"},
        u64 = {c = "uint64_t", mask = "int64_t", bytes = 8, kind = "INT"},
    }

    for _, suffix in ipairs(keys) do
        local elementName, laneText = suffix:match("^([fiu]%d+)x(%d+)$")
        local element = elementName ~= nil and elements[elementName] or nil
        local lanes = tonumber(laneText)
        if element == nil or lanes == nil or lanes < 2 or lanes > 64 then
            error("fixed explicit SIMD species needs between 2 and 64 lanes: " .. suffix, 0)
        end
        lanes = lanes as integer
        local nativeLanes = width / element.bytes
        if lanes ~= nativeLanes then
            local chunks = math.ceil(lanes / nativeLanes) as integer
            lines[
                #lines + 1
            ] = "KS_EXP_FIXED(" .. table.concat(
                {
                    suffix,
                    element.c,
                    element.mask,
                    tostring(lanes),
                    tostring(elementName) .. "x" .. tostring(nativeLanes),
                    tostring(nativeLanes),
                    tostring(chunks),
                    element.kind,
                },
                ", "
            ) .. ")"
        end
    end

    return lines
end

--- The explicit SIMD prelude for one vector width.
---
--- `ks_simd.h` is carried whole: its reusable part sits under an include guard
--- and its per-width part is keyed on `KS_SIMD_WIDTH`, so appending it once per
--- width the file uses defines each width's packed-byte and preferred-species
--- helpers exactly once. `KS_LUA_BUILDER`, when the Lua prelude defined it,
--- selects the scratch stores that name `lua_State`. The fixed species follow
--- because they depend on which `Fixed<N>` types the program mentions.
function emit.simdPrelude(context: emit.Context, width: integer): {string}
    local lines: {string} = {"#define KS_SIMD_WIDTH " .. tostring(width)}
    lines[#lines + 1] = emit.carried("ks_simd.h")
    lines[#lines + 1] = "#undef KS_SIMD_WIDTH"
    for _, line in ipairs(fixedSimdPrelude(context, width)) do
        lines[#lines + 1] = line
    end

    return lines
end

----------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------

--- One helper's C parameter list.
local function helperParams(context: emit.Context, helper: scalarIR.Helper): string
    local parts: {string} = {}
    for position, param in ipairs(helper.params) do
        parts[position] = emit.cType(context, param.type) .. " " .. tostring(param.cName)
    end

    return table.concat(parts, ", ")
end

--- Whether one helper signature carries target-neutral explicit SIMD values.
local function helperHasGenericSimd(helper: scalarIR.Helper): boolean
    for _, param in ipairs(helper.params) do
        if genericSimdType(tostring(param.type)) then
            return true
        end
    end
    for _, result in ipairs(helper.resultTypes) do
        if genericSimdType(tostring(result)) then
            return true
        end
    end

    return false
end

--- The C symbol and optional result struct for one helper rendering.
local function helperNames(helper: scalarIR.Helper, scalar: boolean): (string, string?)
    local name = helper.cName .. (scalar and "_forced_scalar" or "")

    return name, #helper.resultTypes > 1 and name .. "_result" or nil
end

--- One resolved C signature and the context its definition uses.
record emit.HelperVariant
    helper: scalarIR.Helper
    context: emit.Context
    name: string
    resultName: string?
    result: string
    parameters: string
end

--- Result structs, then prototypes, then definitions. Each inline helper's
--- physical signature is selected once and never written onto the semantic IR.
function emit.helpers(context: emit.Context, helpers: {scalarIR.Helper}): {string}
    local variants: {emit.HelperVariant} = {}
    for _, helper in ipairs(helpers) do
        local generic = helperHasGenericSimd(helper)
        local modes = (helper.native == true or not generic) and {false} or {false, true}
        for _, scalar in ipairs(modes) do
            local selected = emit.context(context, nil, scalar)
            local name, resultName = helperNames(helper, scalar)
            variants[
                #variants + 1
            ] = new emit.HelperVariant(
                helper = helper,
                context = selected,
                name = name,
                resultName = resultName,
                result = resultName or emit.cType(selected, helper.resultType),
                parameters = helperParams(selected, helper)
            )
            local selectedName = new emit.HelperName(name = name, result = resultName)
            if not scalar then
                context.helperNames[helper.name] = selectedName
            end
            if scalar or not generic or helper.native == true then
                context.scalarHelperNames[helper.name] = selectedName
            end
        end
    end
    local lines: {string} = {}
    for _, variant in ipairs(variants) do
        if variant.resultName ~= nil then
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(variant.helper.resultTypes) do
                lines[
                    #lines + 1
                ] = "    " .. emit.cType(variant.context, resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. variant.resultName .. ";"
        end
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end
    for _, variant in ipairs(variants) do
        local linkage = variant.helper.native == true and "" or "static inline "
        lines[#lines + 1] = linkage .. variant.result .. " " .. variant.name .. "(" .. variant.parameters .. ");"
    end
    if #helpers > 0 then
        lines[#lines + 1] = ""
    end
    for _, variant in ipairs(variants) do
        local helper = variant.helper
        if helper.native ~= true then
            lines[
                #lines + 1
            ] = "static inline " .. variant.result .. " " .. variant.name .. "(" .. variant.parameters .. ") {"
            if variant.resultName ~= nil then
                local values: {string} = {}
                for position, value in ipairs(helper.values) do
                    values[position] = emit.lane(variant.context, value)
                end
                lines[#lines + 1] = "    " .. variant.resultName .. " result = {" .. table.concat(values, ", ") .. "};"
                lines[#lines + 1] = "    return result;"
            else
                lines[#lines + 1] = "    return " .. emit.lane(variant.context, helper.values[1]) .. ";"
            end
            lines[#lines + 1] = "}"
            lines[#lines + 1] = ""
        end
    end

    return lines
end

----------------------------------------------------------------------------
-- Bodies and Lua blocks
----------------------------------------------------------------------------

--- What a block needs from the program around it.
record emit.Body
    --- Labels are emitted only when an edge names them.
    controlUsed: {[string]: boolean} = {}

    --- Each rooted local has one reserved Lua stack slot for the invocation,
    --- including when its declaration is executed repeatedly inside a loop.
    luaRootSlots: {[string]: integer} = {}

    controlSerial: integer = 0
    controlBreak: string?
    controlContinue: string?
    headerControl: boolean?

    --- How wide a lane store is, for a body that was rewritten.
    lanes: integer

    --- Reified layouts by IR name, for legal target-specific load fusion.
    layouts: {[string]: scalarIR.Layout}

    --- The private aggregate returned by a multi-result entry.
    resultStruct: string?

    --- Erase required lane regions while emitting the independent scalar
    --- oracle from the same scalar IR.
    forceScalar: boolean?

    --- Backend-selected lane accumulators for algebraic loop reducers.
    algebraicReducers: {[string]: string}?

    --- Fresh function-local labels for scalar `repeat` continuations.
    repeatSerial: integer?

    --- The lane-wise accumulators of the enclosing explicit SIMD region, by
    --- reducer name, for the contributions that have one.
    simdAccumulators: {[string]: string}?
end

--- Pushes one verified construction value on the Lua stack.
--- @raises when called with a value the construction verifier does not admit
local function luaPush(context: emit.Context, value: scalarIR.Expr, prefix: string): {string}
    if value.type == "lua_table" then
        if value.op == "lua_new_table" then
            local created = value as scalarIR.LuaNewTable
            context.serials.luaTemporary = context.serials.luaTemporary + 1
            local slot = "lt" .. tostring(context.serials.luaTemporary)
            local lines: {
                string
            } = {
                prefix .. "if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");",
                prefix .. "lua_createtable(L, ks_lua_count(L, " .. emit.scalar(
                    context,
                    created.arrayCapacity
                ) .. ", \"array capacity at " .. luaSite(
                    created.source
                ) .. "\"), ks_lua_count(L, " .. emit.scalar(
                    context,
                    created.hashCapacity
                ) .. ", \"hash capacity at " .. luaSite(created.source) .. "\"));",
            }
            if #(created.fields or {}) > 0 then
                lines[#lines + 1] = prefix .. "int " .. slot .. " = lua_gettop(L);"
            end
            for _, field in ipairs(created.fields or {}) do
                if field.indexed then
                    for _, line in ipairs(luaPush(context, field.value, prefix)) do
                        lines[#lines + 1] = line
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "lua_rawseti(L, " .. slot .. ", ks_lua_index(L, " .. emit.scalar(
                        context,
                        field.key
                    ) .. ", \"" .. luaSite(field.source) .. "\"));"
                else
                    for _, part in ipairs({field.key, field.value}) do
                        for _, line in ipairs(luaPush(context, part, prefix)) do
                            lines[#lines + 1] = line
                        end
                    end
                    lines[#lines + 1] = prefix .. "lua_rawset(L, " .. slot .. ");"
                end
            end

            return lines
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_nil" then
        return {prefix .. "lua_pushnil(L);"}
    elseif value.type == "lua_string" then
        if value.op == "lua_string" then
            local literal = value as scalarIR.LuaString
            return {
                prefix .. "lua_pushlstring(L, " .. cBytes(literal.value) .. ", " .. tostring(#literal.value) .. "u);",
            }
        elseif value.op == "lua_string_buffer_finish" then
            return {
                prefix .. "ks_lua_string_buffer_finish(L, &" .. tostring(
                    ((value as scalarIR.LuaStringBufferFinish).buffer as scalarIR.Name).cName
                ) .. ");",
            }
        elseif value.op == "lua_concat" then
            local joined = value as scalarIR.LuaConcat
            local lines = luaPush(context, joined.left, prefix)
            for _, line in ipairs(luaPush(context, joined.right, prefix)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = prefix .. "lua_concat(L, 2);"
            return lines
        elseif value.op == "lua_substring" then
            local sliced = value as scalarIR.LuaSubstring
            return {prefix .. "ks_lua_substring(L, " .. substringArguments(context, sliced) .. ");"}
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "lua_value" then
        if value.op == "lua_builder_finish" then
            return {
                prefix .. "ks_lua_builder_finish(L, &" .. tostring(
                    ((value as scalarIR.LuaBuilderFinish).builder as scalarIR.Name).cName
                ) .. ");",
            }
        end
        return {prefix .. "lua_pushvalue(L, " .. tostring((value as scalarIR.Name).cName) .. ");"}
    elseif value.type == "bool" then
        return {prefix .. "lua_pushboolean(L, " .. emit.scalar(context, value) .. ");"}
    elseif emit.SCALAR_C[value.type] ~= nil then
        return {prefix .. "lua_pushnumber(L, (double)(" .. emit.scalar(context, value) .. "));"}
    end

    error("no Lua construction push for " .. tostring(value.type), 0)
end

--- Emits one append without materializing literals or rooted slices as Lua strings.
local function luaStringBufferAppend(
    context: emit.Context,
    buffer: scalarIR.Expr,
    value: scalarIR.Expr,
    prefix: string
): {string}
    local target = "&" .. tostring((buffer as scalarIR.Name).cName)
    if value.op == "lua_string" then
        local literal = value as scalarIR.LuaString
        return {
            prefix .. "ks_lua_string_buffer_append(L, " .. target .. ", (const unsigned char *)" .. cBytes(
                literal.value
            ) .. ", " .. tostring(#literal.value) .. "u);",
        }
    elseif value.op == "lua_substring" then
        local sliced = value as scalarIR.LuaSubstring
        return {
            prefix .. "ks_lua_string_buffer_append_slice(L, " .. target .. ", " .. substringArguments(
                context,
                sliced
            ) .. ");",
        }
    elseif value.op == "local" then
        local rooted = value as scalarIR.Name
        return {
            prefix .. "ks_lua_string_buffer_append(L, " .. target .. ", ks_bytes_" .. tostring(
                rooted.cName
            ) .. ", ks_length_" .. tostring(rooted.cName) .. ");",
        }
    end
    local lines = luaPush(context, value, prefix)
    lines[
        #lines + 1
    ] = prefix
        .. "{ size_t ks_append_length = 0u; const unsigned char *ks_append_bytes = (const unsigned char *)lua_tolstring(L, -1, &ks_append_length); ks_lua_string_buffer_append(L, "
        .. target
        .. ", ks_append_bytes, ks_append_length); lua_settop(L, lua_gettop(L) - 1); }"

    return lines
end

type emit.Flow = scalarIR.If
    | scalarIR.Fornum
    | scalarIR.While
    | scalarIR.Repeat
    | scalarIR.Block
    | scalarIR.Break
    | scalarIR.Continue

type emit.BlockRenderer = function(cplan.Block, integer, emit.Body, string?): {string}
type emit.ExpressionRenderer = function(scalarIR.Expr | lane.Expr): string

local function hasConditionBody(statements: cplan.Block): boolean
    for _, statement in ipairs(statements) do
        local node = statement as any
        if node.conditionBody ~= nil then
            return true
        end
        if node.body ~= nil and hasConditionBody(node.body) then
            return true
        end
        if node.elseBody ~= nil and hasConditionBody(node.elseBody) then
            return true
        end
        for _, clause in ipairs(node.clauses or {}) do
            if hasConditionBody(clause.body) then
                return true
            end
        end
    end

    return false
end

--- The C control structure is shared; each backend supplies its expressions
--- and recursive block renderer, retaining its own leaf effects and returns.
local function controlFlow(
    node: emit.Flow,
    depth: integer,
    body: emit.Body,
    repeatContinue: string?,
    expression: emit.ExpressionRenderer,
    block: emit.BlockRenderer,
    nativeSwitches: boolean
): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)

    local function nested(statements: cplan.Block, continuation: string?): nil
        for _, line in ipairs(block(statements, depth + 1, body, continuation)) do
            lines[#lines + 1] = line
        end
    end

    if body.headerControl == true and (node.op == "while" or node.op == "repeat" or node.op == "fornum") then
        body.controlSerial = body.controlSerial + 1
        local suffix = tostring(body.controlSerial)
        local breakLabel, continueLabel = "ks_loop_break_" .. suffix, "ks_loop_continue_" .. suffix
        local outerBreak, outerContinue = body.controlBreak, body.controlContinue
        local loop = node as any
        local header = loop.conditionBody
        if node.op == "fornum" then
            local counter = loop.binding.cName
            lines[
                #lines + 1
            ] = prefix .. "for (int32_t " .. counter .. " = " .. expression(
                loop.from
            ) .. "; " .. counter .. " <= (int32_t)" .. expression(loop.to) .. "; ++" .. counter .. ") {"
        else
            lines[#lines + 1] = prefix .. "while (true) {"
        end
        if node.op == "while" then
            if header ~= nil then
                nested(header, repeatContinue)
            end
            body.controlUsed[breakLabel] = true
            lines[#lines + 1] = prefix .. "    if (!(" .. expression(loop.condition) .. ")) goto " .. breakLabel .. ";"
        end
        body.controlBreak, body.controlContinue = breakLabel, continueLabel
        nested(loop.body, continueLabel)
        body.controlBreak, body.controlContinue = outerBreak, outerContinue
        if body.controlUsed[continueLabel] then
            lines[#lines + 1] = prefix .. "    " .. continueLabel .. ":;"
        end
        if node.op == "repeat" then
            if header ~= nil then
                nested(header, repeatContinue)
            end
            body.controlUsed[breakLabel] = true
            lines[#lines + 1] = prefix .. "    if (" .. expression(loop.condition) .. ") goto " .. breakLabel .. ";"
        end
        lines[#lines + 1] = prefix .. "}"
        if body.controlUsed[breakLabel] then
            lines[#lines + 1] = prefix .. breakLabel .. ":;"
        end
        return lines
    end

    local function render(): nil
        return switch node.op do
            case "if" -> do
                local statement = node as scalarIR.If
                local nativeSwitch = nativeSwitches and statement.nativeSwitch or nil
                if nativeSwitch and #nativeSwitch.arms == #statement.clauses then
                    lines[#lines + 1] = prefix .. "switch (" .. expression(nativeSwitch.selector) .. ") {"
                    for position, arm in ipairs(nativeSwitch.arms) do
                        for _, label in ipairs(arm.labels) do
                            local constant = new scalarIR.IntConstant(
                                op = "constant_i32",
                                value = label.value,
                                type = label.type,
                                source = label.source
                            )
                            lines[#lines + 1] = prefix .. "case " .. expression(constant) .. ":"
                        end
                        lines[#lines + 1] = prefix .. "{"
                        nested(statement.clauses[position].body, repeatContinue)
                        lines[#lines + 1] = prefix .. "    break;"
                        lines[#lines + 1] = prefix .. "}"
                    end
                    if statement.elseBody ~= nil then
                        lines[#lines + 1] = prefix .. "default:"
                        lines[#lines + 1] = prefix .. "{"
                        nested(statement.elseBody, repeatContinue)
                        lines[#lines + 1] = prefix .. "    break;"
                        lines[#lines + 1] = prefix .. "}"
                    end
                    lines[#lines + 1] = prefix .. "}"
                else
                    for position, clause in ipairs(statement.clauses) do
                        lines[
                            #lines + 1
                        ] = prefix .. (position == 1 and "if (" or "else if (") .. expression(clause.condition) .. ") {"
                        nested(clause.body, repeatContinue)
                        lines[#lines + 1] = prefix .. "}"
                    end
                    if statement.elseBody ~= nil then
                        lines[#lines + 1] = prefix .. "else {"
                        nested(statement.elseBody, repeatContinue)
                        lines[#lines + 1] = prefix .. "}"
                    end
                end
                yield nil
            end
            case "fornum" -> do
                local statement = node as scalarIR.Fornum
                local counter = statement.binding.cName
                lines[
                    #lines + 1
                ] = prefix .. "for (int32_t " .. counter .. " = " .. expression(
                    statement.from
                ) .. "; " .. counter .. " <= (int32_t)" .. expression(statement.to) .. "; ++" .. counter .. ") {"
                nested(statement.body, nil)
                lines[#lines + 1] = prefix .. "}"
                yield nil
            end
            case "while" -> do
                local statement = node as scalarIR.While
                lines[#lines + 1] = prefix .. "while (" .. expression(statement.condition) .. ") {"
                nested(statement.body, nil)
                lines[#lines + 1] = prefix .. "}"
                yield nil
            end
            case "repeat" -> do
                local statement = node as scalarIR.Repeat
                body.repeatSerial = (body.repeatSerial or 0) + 1
                local label = "ks_repeat_continue_" .. tostring(body.repeatSerial)
                lines[#lines + 1] = prefix .. "while (true) {"
                nested(statement.body, label)
                lines[#lines + 1] = prefix .. "    " .. label .. ":"
                lines[#lines + 1] = prefix .. "    if (" .. expression(statement.condition) .. ") break;"
                lines[#lines + 1] = prefix .. "}"
                yield nil
            end
            case "block" -> do
                lines[#lines + 1] = prefix .. "{"
                nested((node as scalarIR.Block).body, repeatContinue)
                lines[#lines + 1] = prefix .. "}"
                yield nil
            end
            case "break" -> do
                if body.controlBreak ~= nil then
                    body.controlUsed[body.controlBreak] = true
                end
                lines[
                    #lines + 1
                ] = prefix .. (body.controlBreak ~= nil and "goto " .. body.controlBreak or "break") .. ";"
                yield nil
            end
            case "continue" -> do
                if body.controlContinue ~= nil then
                    body.controlUsed[body.controlContinue] = true
                end
                lines[
                    #lines + 1
                ] = prefix .. (
                    body.controlContinue ~= nil
                    and "goto "
                    .. body.controlContinue
                    or repeatContinue ~= nil
                    and "goto "
                    .. repeatContinue
                    or "continue"
                ) .. ";"
                yield nil
            end
        end
    end

    render()

    return lines
end

--- A helper call is evaluated once; its result fields introduce live bindings.
--- @raises when the verified helper has no aggregate result
local function multiLet(context: emit.Context, statement: scalarIR.MultiLet, prefix: string, temp: string): {string}
    local lines: {string} = {}
    local names = context.explicitScalar and context.scalarHelperNames or context.helperNames
    local selected = names[statement.call.helper]
    local result = selected ~= nil and selected.result or nil
    if result == nil then
        error("no result struct for helper " .. tostring(statement.call.helper), 0)
    end

    lines[#lines + 1] = prefix .. tostring(result) .. " " .. temp .. " = " .. emit.lane(context, statement.call) .. ";"
    for position, bound in ipairs(statement.bindings) do
        lines[
            #lines + 1
        ] = prefix .. emit.cType(
            context,
            bound.type
        ) .. " " .. bound.cName .. " = " .. temp .. ".v" .. tostring(position) .. ";"
    end

    return lines
end

--- One verified Lua-construction block.
---
--- Logical handles are C integers naming absolute Lua stack slots. The objects
--- themselves never leave the stack, so every allocating API call sees all
--- live construction values rooted.
--- @raises when invalid IR mixes Lua string and scalar assignments
function emit.luaBlock(
    context: emit.Context,
    statements: {scalarIR.Statement},
    depth: integer,
    body: emit.Body,
    repeatContinue: string?
): {string}
    body.headerControl = body.headerControl or hasConditionBody(statements)
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)

    local function append(more: {string}): nil
        for _, line in ipairs(more) do
            lines[#lines + 1] = line
        end
    end

    local function recursive(inner: cplan.Block, at: integer, parent: emit.Body, continuation: string?): {string}
        return emit.luaBlock(context, inner as {scalarIR.Statement}, at, parent, continuation)
    end

    local function expression(value: scalarIR.Expr | lane.Expr): string
        return emit.scalar(context, value as scalarIR.Expr)
    end

    local function render(node: scalarIR.Statement, position: integer): boolean
        return switch node.op do
            case "let" -> do
                local statement = node as scalarIR.Let
                if statement.type == "lua_string_buffer" then
                    local started = statement.value as scalarIR.LuaStringBuffer
                    lines[#lines + 1] = prefix .. "KsLuaStringBuffer " .. statement.cName .. ";"
                    lines[#lines + 1] = prefix .. "ks_lua_string_buffer_init(L, &" .. statement.cName .. ");"
                    append(
                        luaStringBufferAppend(
                            context,
                            new scalarIR.Name(
                                op = "local",
                                name = statement.name,
                                cName = statement.cName,
                                type = "lua_string_buffer"
                            ),
                            started.initial,
                            prefix
                        )
                    )
                elseif statement.type == "lua_builder" then
                    local started = statement.value as scalarIR.LuaBuilder
                    local maxDepth = started.maxDepth ~= nil and emit.scalar(
                        context,
                        started.maxDepth as scalarIR.Expr
                    ) or "UINT32_C(1024)"
                    local stringCapacity = started.stringCapacity ~= nil and emit.scalar(
                        context,
                        started.stringCapacity as scalarIR.Expr
                    ) or "UINT32_C(0)"
                    local arrayMarker = started.arrayMarker ~= nil and tostring(
                        (started.arrayMarker as scalarIR.Name).cName
                    ) or "0"
                    local objectMarker = started.objectMarker ~= nil and tostring(
                        (started.objectMarker as scalarIR.Name).cName
                    ) or "0"
                    local selectionShape = started.selectionShape ~= nil and tostring(
                        (started.selectionShape as scalarIR.Name).cName
                    ) or "0"
                    local arrayShapeMarker = started.arrayShapeMarker ~= nil and tostring(
                        (started.arrayShapeMarker as scalarIR.Name).cName
                    ) or "0"
                    local serdeMarkers = started.serdeMarkers ~= nil and tostring(
                        (started.serdeMarkers as scalarIR.Name).cName
                    ) or "0"
                    local constructor = started.mode == "eager" and "ks_lua_eager_builder_new" or "ks_lua_builder_new"
                    local constructorTail = started.mode == "eager"
                        and ");"
                        or ", "
                        .. selectionShape
                        .. ", "
                        .. arrayShapeMarker
                        .. ", "
                        .. serdeMarkers
                        .. ");"
                    lines[
                        #lines + 1
                    ] = prefix .. "KsLuaBuilder " .. statement.cName .. " = " .. constructor .. "(L, " .. tostring(
                        (started.nullValue as scalarIR.Name).cName
                    )
                        .. ", "
                        .. arrayMarker
                        .. ", "
                        .. objectMarker
                        .. ", "
                        .. maxDepth
                        .. ", "
                        .. stringCapacity
                        .. constructorTail
                elseif statement.type == "lua_scratch_u32" then
                    local started = statement.value as scalarIR.LuaScratchU32
                    local fixed = started.fixed
                    if fixed ~= nil and (fixed as integer) <= emit.STACK_SCRATCH_WORDS then
                        -- A fixed buffer small enough to stand on the C stack does. Its
                        -- capacity is a literal and it cannot escape the entry, so
                        -- there is nothing for Lua to own: no userdata, no registry
                        -- entry keyed on a static address, and no stack slot to keep
                        -- rooted. The C compiler gets an array whose size and alignment
                        -- it knows and zeroes it itself.
                        lines[
                            #lines + 1
                        ] = prefix .. "uint32_t " .. statement.cName .. "_storage[" .. tostring(
                            fixed
                        )
                            .. "] = {0}; KsLuaScratchU32 "
                            .. statement.cName
                            .. "; ks_lua_scratch_u32_stack(&"
                            .. statement.cName
                            .. ", "
                            .. statement.cName
                            .. "_storage, "
                            .. emit.scalar(
                                context,
                                started.capacity
                            ) .. ");"
                    else
                        lines[
                            #lines + 1
                        ] = prefix
                            .. "static const char "
                            .. statement.cName
                            .. "_key = 0; KsLuaScratchU32 "
                            .. statement.cName
                            .. (
                                fixed ~= nil and "; ks_lua_scratch_u32_fixed(L, &" or "; ks_lua_scratch_u32(L, &"
                            ) .. statement.cName .. ", " .. emit.scalar(
                                context,
                                started.capacity
                            ) .. ", &" .. statement.cName .. "_key);"
                    end
                elseif statement.type == "lua_scratch_u8" then
                    local started = statement.value as scalarIR.LuaScratchU8
                    local fixedBytes = started.fixed
                    if fixedBytes ~= nil and (fixedBytes as integer) <= emit.STACK_SCRATCH_BYTES then
                        lines[
                            #lines + 1
                        ] = prefix .. "unsigned char " .. statement.cName .. "_storage[" .. tostring(
                            fixedBytes
                        )
                            .. "]; KsLuaScratchU8 "
                            .. statement.cName
                            .. " = ks_lua_scratch_u8_stack("
                            .. statement.cName
                            .. "_storage, "
                            .. emit.scalar(
                                context,
                                started.capacity
                            ) .. ");"
                    else
                        lines[
                            #lines + 1
                        ] = prefix .. "KsLuaScratchU8 " .. statement.cName .. " = " .. (
                            context.reusableScratchName ~= nil
                            and statement.cName == context.reusableScratchName
                            and "ks_lua_scratch_u8_cached(L, "
                            or "ks_lua_scratch_u8(L, "
                        ) .. emit.scalar(context, started.capacity) .. ");"
                    end
                elseif (
                    statement.type == "lua_table"
                    or statement.type == "lua_string"
                    or statement.type == "lua_nil"
                    or statement.type == "lua_value"
                ) then
                    append(luaPush(context, statement.value, prefix))
                    local slot = body.luaRootSlots[statement.cName]
                    if slot ~= nil then
                        lines[
                            #lines + 1
                        ] = prefix .. "int " .. statement.cName .. " = ks_root_base + " .. tostring(slot) .. ";"
                        lines[#lines + 1] = prefix .. "lua_replace(L, " .. statement.cName .. ");"
                    else
                        lines[#lines + 1] = prefix .. "int " .. statement.cName .. " = lua_gettop(L);"
                    end
                else
                    lines[
                        #lines + 1
                    ] = prefix .. emit.cType(
                        context,
                        statement.type
                    ) .. " " .. statement.cName .. " = " .. emit.scalar(context, statement.value) .. ";"
                    if statement.type == "simd_species_u8" or statement.type:match("^simd_species_") ~= nil then
                        lines[#lines + 1] = prefix .. "(void)" .. statement.cName .. ";"
                    end
                end
                yield true
            end
            case "lua_set_index" -> do
                local statement = node as scalarIR.LuaSet
                local write = statement as scalarIR.LuaSet
                append(luaPush(context, write.value, prefix))
                lines[
                    #lines + 1
                ] = prefix .. "lua_rawseti(L, " .. tostring(
                    (write.table as scalarIR.Name).cName
                ) .. ", ks_lua_index(L, " .. emit.scalar(
                    context,
                    write.key
                ) .. ", \"" .. luaSite(write.source) .. "\"));"
                yield true
            end
            case "lua_set_key" -> do
                local statement = node as scalarIR.LuaSet
                local write = statement as scalarIR.LuaSet
                append(luaPush(context, write.key, prefix))
                append(luaPush(context, write.value, prefix))
                lines[#lines + 1] = prefix .. "lua_rawset(L, " .. tostring((write.table as scalarIR.Name).cName) .. ");"
                yield true
            end
            case "lua_string_buffer_append" -> do
                local statement = node as scalarIR.LuaStringBufferAppend
                local appended = statement as scalarIR.LuaStringBufferAppend
                append(luaStringBufferAppend(context, appended.buffer, appended.value, prefix))
                yield true
            end
            case "lua_scratch_u32_set" -> do
                local statement = node as scalarIR.LuaScratchU32Set
                lines[#lines + 1] = scratchWrite(context, "ks_lua_scratch_u32_set", statement, prefix)
                yield true
            end
            case "lua_scratch_u8_set" -> do
                local statement = node as scalarIR.LuaScratchU8Set
                lines[#lines + 1] = scratchWrite(context, "ks_lua_scratch_u8_set", statement, prefix)
                yield true
            end
            case "simd_store" -> do
                local statement = node as scalarIR.Simd
                lines[#lines + 1] = prefix .. emit.genericStore(context, statement as scalarIR.Simd) .. ";"
                yield true
            end
            case "simd_store4_u8" -> do
                local statement = node as scalarIR.Simd
                local store = statement as scalarIR.Simd
                local operands: {string} = {"L", "&" .. tostring((store.args[1] as scalarIR.Name).cName)}
                for index = 2, 6 do
                    operands[#operands + 1] = emit.scalar(context, store.args[index])
                end
                lines[
                    #lines + 1
                ] = prefix .. (
                    context.explicitScalar and "ks_scalar_" or "ks_"
                ) .. "store4_u8x" .. tostring(byteWidth(context)) .. "(" .. table.concat(operands, ", ") .. ");"
                yield true
            end
            case "lua_scratch_u8_set4" -> do
                local statement = node as scalarIR.LuaScratchU8Set
                lines[#lines + 1] = scratchWrite(context, "ks_lua_scratch_u8_set4", statement, prefix)
                yield true
            end
            case "lua_scratch_u8_reset" -> do
                local statement = node as scalarIR.LuaScratchU8Set
                local write = statement as scalarIR.LuaScratchU8Set
                lines[#lines + 1] = prefix .. tostring((write.scratch as scalarIR.Name).cName) .. ".length = 0u;"
                yield true
            end
            case "lua_builder_open_array", "lua_builder_open_object", "lua_builder_key", "lua_builder_string", "lua_builder_number", "lua_builder_number_slice", "lua_builder_integer_slice", "lua_builder_integer64", "lua_builder_decimal64", "lua_builder_boolean", "lua_builder_null", "lua_builder_close", "lua_builder_key_scratch", "lua_builder_string_scratch", "lua_builder_key_escapes", "lua_builder_string_escapes" -> do
                local statement = node as scalarIR.LuaBuild
                local event = statement as scalarIR.LuaBuild
                local builder = "&" .. tostring((event.builder as scalarIR.Name).cName)
                -- The builder's constructor and decoder entry are mode-specific,
                -- while events share the proven helper core. Duplicating these
                -- helpers enlarged the hot parser enough to regress escape-heavy
                -- documents despite removing one predictable mode branch.
                local helper = "ks_lua_builder_"
                local eager = context.builderEager and "1" or "0"
                if event.op == "lua_builder_open_array" or event.op == "lua_builder_open_object" then
                    local kind = event.op == "lua_builder_open_array" and "5u" or "6u"
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "open(L, " .. builder .. ", " .. kind .. ", " .. emit.scalar(
                        context,
                        event.capacity as scalarIR.Expr
                    ) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_key" or event.op == "lua_builder_string" then
                    local bytes = event.sourceBytes as scalarIR.Name
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "string(L, " .. builder .. ", ks_bytes_" .. tostring(
                        bytes.cName
                    ) .. ", ks_length_" .. tostring(
                        bytes.cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.start as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.length as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.escaped as scalarIR.Expr
                    ) .. ", " .. (event.op == "lua_builder_key" and "1" or "0") .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_number_slice" or event.op == "lua_builder_integer_slice" then
                    local bytes = event.sourceBytes as scalarIR.Name
                    lines[
                        #lines + 1
                    ] = prefix .. (
                        event.op == "lua_builder_integer_slice"
                        and helper
                        .. "integer_slice(L, "
                        or helper
                        .. "number_slice(L, "
                    ) .. builder .. ", ks_bytes_" .. tostring(
                        bytes.cName
                    ) .. ", ks_length_" .. tostring(
                        bytes.cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.start as scalarIR.Expr
                    ) .. ", " .. emit.scalar(context, event.length as scalarIR.Expr) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_key_scratch" or event.op == "lua_builder_string_scratch" then
                    lines[
                        #lines + 1
                    ] = prefix .. "ks_lua_scratch_u8_push(L, &" .. tostring(
                        (event.scratch as scalarIR.Name).cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.start as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.length as scalarIR.Expr
                    ) .. "); " .. (
                        event.op == "lua_builder_key_scratch"
                        and helper
                        .. "key(L, "
                        .. builder
                        .. ");"
                        or helper
                        .. "pushed_scalar(L, "
                        .. builder
                        .. ", "
                        .. eager
                        .. ");"
                    )
                elseif event.op == "lua_builder_key_escapes" or event.op == "lua_builder_string_escapes" then
                    local bytes = event.sourceBytes as scalarIR.Name
                    lines[
                        #lines + 1
                    ] = prefix .. "ks_lua_builder_string_escapes(L, " .. builder .. ", ks_bytes_" .. tostring(
                        bytes.cName
                    ) .. ", ks_length_" .. tostring(
                        bytes.cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.start as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.length as scalarIR.Expr
                    ) .. ", &" .. tostring(
                        (event.escapeScratch as scalarIR.Name).cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.escapeIndex as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.escapeCount as scalarIR.Expr
                    ) .. ", " .. (event.op == "lua_builder_key_escapes" and "1" or "0") .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_number" then
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "number(L, " .. builder .. ", " .. emit.scalar(
                        context,
                        event.value as scalarIR.Expr
                    ) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_integer64" then
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "integer64(L, " .. builder .. ", " .. emit.scalar(
                        context,
                        event.value as scalarIR.Expr
                    ) .. ", " .. emit.scalar(context, event.negative as scalarIR.Expr) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_decimal64" then
                    local bytes = event.sourceBytes as scalarIR.Name
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "decimal64(L, " .. builder .. ", ks_bytes_" .. tostring(
                        bytes.cName
                    ) .. ", ks_length_" .. tostring(
                        bytes.cName
                    ) .. ", " .. emit.scalar(
                        context,
                        event.start as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.length as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.value as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.exponent as scalarIR.Expr
                    ) .. ", " .. emit.scalar(
                        context,
                        event.negative as scalarIR.Expr
                    ) .. ", " .. emit.scalar(context, event.exact as scalarIR.Expr) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_boolean" then
                    lines[
                        #lines + 1
                    ] = prefix .. helper .. "boolean(L, " .. builder .. ", " .. emit.scalar(
                        context,
                        event.value as scalarIR.Expr
                    ) .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_null" then
                    lines[#lines + 1] = prefix .. helper .. "null(L, " .. builder .. ", " .. eager .. ");"
                elseif event.op == "lua_builder_close" then
                    lines[#lines + 1] = prefix .. helper .. "close(L, " .. builder .. ", " .. eager .. ");"
                end
                yield true
            end
            case "assign" -> do
                local statement = node as scalarIR.Assign
                local assignment = statement as scalarIR.Assign
                local hasLua = false
                for _, entry in ipairs(assignment.values) do
                    hasLua = hasLua or entry.target.type == "lua_string" or entry.target.type == "lua_nil"
                end
                if hasLua then
                    if #assignment.values ~= 1 or (
                        assignment.values[
                            1
                        ].target.type ~= "lua_string" and assignment.values[1].target.type ~= "lua_nil"
                    ) then
                        error("mixed or multiple Lua string assignment reached emission", 0)
                    end
                    append(luaPush(context, assignment.values[1].value, prefix))
                    lines[
                        #lines + 1
                    ] = prefix .. "lua_replace(L, " .. tostring(assignment.values[1].target.cName) .. ");"
                else
                    lines[#lines + 1] = prefix .. "{"
                    append(emit.block(context, {statement}, depth + 1, body))
                    lines[#lines + 1] = prefix .. "}"
                end
                yield true
            end
            case "multi_let" -> do
                append(multiLet(context, node as scalarIR.MultiLet, prefix, "mr" .. tostring(position)))
                yield true
            end
            case "return" -> do
                local statement = node as scalarIR.Return
                for _, value in ipairs(statement.values) do
                    append(luaPush(context, value, prefix))
                end
                lines[#lines + 1] = prefix .. "return " .. tostring(#statement.values) .. ";"
                yield true
            end
            case "if", "fornum", "while", "repeat", "block", "break", "continue" -> do
                append(controlFlow(node as emit.Flow, depth, body, repeatContinue, expression, recursive, false))
                yield true
            end
            case "shared_store", "phase", "simd_species_u8", "simd_species", "simd_lanes_generic", "simd_splat", "simd_iota", "simd_tail", "simd_load", "simd_binary", "simd_unary", "simd_compare", "simd_select", "simd_mask_any", "simd_mask_all", "simd_mask_count", "simd_mask_first", "simd_mask_bits", "simd_extract", "simd_insert", "simd_permute", "simd_convert", "simd_reinterpret", "simd_compress", "simd_expand", "simd_prefix", "simd_horizontal", "simd_mask_splat", "simd_mask_convert", "simd_field_load", "simd_call", "simd_math", "simd_lanes", "simd_load_u8", "simd_load_string_u8", "simd_load_stride3_u8", "simd_splat_u8", "simd_shr_u8", "simd_shl_u8", "simd_table_u8x16", "simd_lookup16_u8", "simd_lookup64_u8", "simd_align_bytes_u8", "simd_padded_string_u8", "simd_padded_length", "simd_padded_full_length", "simd_padded_tail_length", "simd_padded_load_full_u8", "simd_padded_load_tail_u8", "simd_block64_load_u8", "simd_block64_and_byte_u8", "simd_block64_and_u8", "simd_block64_shr_u8", "simd_block64_lookup16_u8", "simd_block64_any_bits_u8", "simd_block64_last_u8", "simd_block64_utf8_errors_u8", "simd_block64_eq_u8", "simd_block64_range_u8", "simd_block64_outside_range_u8", "simd_tail_u8", "simd_eq_u8", "simd_range_u8", "simd_vec_and", "simd_vec_or", "simd_vec_xor", "simd_vec_not", "simd_mask_and", "simd_mask_or", "simd_mask_xor", "simd_mask_not", "simd_select_u8", "simd_any", "simd_all", "simd_count", "simd_bits", "simd_mask64", "simd_mask64_add", "simd_mask64_and", "simd_mask64_or", "simd_mask64_xor", "simd_mask64_not", "simd_mask64_shl", "simd_mask64_shr", "simd_mask64_prefix_xor", "simd_mask64_low", "simd_mask64_high", "simd_mask64_any", "simd_mask64_count", "simd_mask64_first", "simd_mask64_clear_first", "store", "reducer_add", "simd_field_store", "simd_reducer_add", "simd_region" -> error(
                "unsupported Lua construction statement " .. node.op,
                0
            )
        end
    end

    for position, statement in ipairs(statements) do
        if render(statement, position) ~= true then
            error("unknown C statement " .. tostring(statement.op), 0)
        end
    end

    return lines
end

----------------------------------------------------------------------------
-- Statements
----------------------------------------------------------------------------

--- The C type one local is declared with.
---
--- A pointer to a struct element carries its own constness, because that is
--- where a shared borrow stops being writable as far as C is concerned.
local function localCType(context: emit.Context, typeName: string, mutable: boolean): string
    local layout = typeName:match("^ref:(.+)$")
    if layout ~= nil then
        return (mutable and "" or "const ") .. "Ks" .. tostring(layout) .. " *"
    end

    return emit.cType(context, typeName) .. " "
end

--- Whether a rewritten loop moved its recurring liveness test behind lane
--- retirement. The rewrite keeps the marked retirement at this block's top
--- level; nested loops own their own tests.
local function exitsWhenEmpty(statements: cplan.Block): boolean
    for _, statement in ipairs(statements) do
        if statement.op == "vbreak" and statement.exitWhenEmpty == true then
            return true
        end
    end

    return false
end

--- Renders one member of a deinterleaved load, joining two physical Neon
--- registers when the selected gang is wider than one register.
local function neonPairValue(
    temps: {string},
    member: integer,
    vector: string,
    lanes: integer,
    sourceElement: string,
    resultElement: string
): string
    local loaded
    if #temps == 1 then
        loaded = temps[1] .. ".val[" .. tostring(member) .. "]"
    else
        local indices: {string} = {}
        for index = 0, lanes - 1 do
            indices[#indices + 1] = tostring(index)
        end

        loaded = "__builtin_shufflevector(" .. temps[
            1
        ] .. ".val[" .. tostring(
            member
        ) .. "], " .. temps[2] .. ".val[" .. tostring(member) .. "], " .. table.concat(indices, ", ") .. ")"
    end

    if sourceElement ~= resultElement then
        return "__builtin_convertvector(" .. loaded .. ", ks_" .. vector .. ")"
    end

    return "(ks_" .. vector .. ")" .. loaded
end

--- One block of statements, scalar or lane, indented by `depth`.
--- @raises when a multiple-result binding calls a helper the body does not
---   declare, which is malformed IR rather than anything about the source
function emit.block(
    context: emit.Context,
    statements: cplan.Block,
    depth: integer,
    body: emit.Body,
    repeatContinue: string?
): {string}
    body.headerControl = body.headerControl or hasConditionBody(statements)
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)
    local temporary = 0
    local pairs = cplan.fieldPairs(statements, body.layouts)

    --- Appends the rendering of a nested block.
    local function nested(inner: cplan.Block): nil
        for _, line in ipairs(emit.block(context, inner, depth + 1, body, repeatContinue)) do
            lines[#lines + 1] = line
        end
    end

    local function recursive(inner: cplan.Block, at: integer, parent: emit.Body, continuation: string?): {string}
        return emit.block(context, inner, at, parent, continuation)
    end

    local function expression(value: scalarIR.Expr | lane.Expr): string
        return emit.lane(context, value)
    end

    local function append(more: {string}): nil
        for _, line in ipairs(more) do
            lines[#lines + 1] = line
        end
    end

    local function render(node: cplan.Statement, position: integer): boolean
        return switch node.op do
            case "let" -> do
                local statement = node as lane.Let
                local pair = pairs[position]
                if pair ~= nil then
                    temporary = temporary + 1
                    local info = pair as cplan.FieldPair
                    local neon = info.neon
                    local chunks = info.left.lanes / (neon.lanes as integer)
                    local temps: {string} = {}
                    lines[
                        #lines + 1
                    ] = prefix .. "#if defined(__aarch64__) && (defined(__clang__) || defined(__GNUC__))"
                    for chunk = 0, chunks - 1 do
                        local temp = "aos" .. tostring(temporary) .. "_" .. tostring(chunk)
                        temps[#temps + 1] = temp
                        lines[
                            #lines + 1
                        ] = prefix
                            .. neon.tuple
                            .. " "
                            .. temp
                            .. " = "
                            .. neon.load
                            .. "((const "
                            .. neon.alias
                            .. " *)&p_"
                            .. info.left.span
                            .. "[i + "
                            .. tostring(
                                chunk * (neon.lanes as integer)
                            ) .. "]);"
                    end
                    local previous = info.first
                    local statement = info.second
                    lines[
                        #lines + 1
                    ] = prefix .. emit.cType(
                        context,
                        previous.type
                    ) .. " " .. previous.cName .. " = " .. neonPairValue(
                        temps,
                        info.leftIndex,
                        info.resultType,
                        info.left.lanes,
                        neon.element,
                        info.resultElement
                    ) .. ";"
                    lines[
                        #lines + 1
                    ] = prefix .. emit.cType(
                        context,
                        statement.type
                    ) .. " " .. statement.cName .. " = " .. neonPairValue(
                        temps,
                        info.rightIndex,
                        info.resultType,
                        info.right.lanes,
                        neon.element,
                        info.resultElement
                    ) .. ";"
                    lines[#lines + 1] = prefix .. "#else"
                    lines[
                        #lines + 1
                    ] = prefix .. localCType(
                        context,
                        previous.type,
                        (previous.value as scalarIR.ElementRef).mutable == true
                    ) .. previous.cName .. " = " .. emit.lane(context, previous.value) .. ";"
                    lines[
                        #lines + 1
                    ] = prefix .. localCType(
                        context,
                        statement.type,
                        (statement.value as scalarIR.ElementRef).mutable == true
                    ) .. statement.cName .. " = " .. emit.lane(context, statement.value) .. ";"
                    lines[#lines + 1] = prefix .. "#endif"
                elseif pairs[
                    position - 1
                ] == nil and statement.type ~= "simd_species_u8" and statement.type:match("^simd_species_") == nil then
                    lines[
                        #lines + 1
                    ] = prefix .. localCType(
                        context,
                        statement.type,
                        (statement.value as scalarIR.ElementRef).mutable == true
                    ) .. statement.cName .. " = " .. emit.lane(context, statement.value) .. ";"
                end
                yield true
            end
            case "multi_let" -> do
                local statement = node as scalarIR.MultiLet
                temporary = temporary + 1

                append(multiLet(context, statement, prefix, "mr" .. tostring(temporary)))
                yield true
            end
            case "store" -> do
                local statement = node as scalarIR.Store
                local index = statement.cursorCName ~= nil and "((size_t)" .. tostring(
                    statement.cursorCName
                ) .. ")" or statement.indexCName == "i" and "i" or "((size_t)(" .. tostring(
                    statement.indexCName
                ) .. " - 1))"
                lines[
                    #lines + 1
                ] = prefix .. scalarIR.cIdentifier(
                    "p",
                    statement.span
                ) .. "[" .. index .. "] = " .. emit.lane(context, statement.value) .. ";"
                yield true
            end
            case "assign" -> do
                local statement = node as scalarIR.Assign
                -- Every value into a temporary before any is stored, because
                -- `a, b = b, a` means what it says and storing as it went would not.
                local temps: {string} = {}
                for position, entry in ipairs(statement.values) do
                    temporary = temporary + 1
                    temps[position] = "as" .. tostring(temporary)
                    lines[
                        #lines + 1
                    ] = prefix .. emit.cType(
                        context,
                        entry.target.type as string
                    ) .. " " .. temps[position] .. " = " .. emit.lane(context, entry.value) .. ";"
                end
                for position, entry in ipairs(statement.values) do
                    local target = entry.target.kind == "local" and (
                        entry.target.cName as string
                    ) or "(" .. emit.lane(
                        context,
                        entry.target.object as scalarIR.Expr
                    ) .. "->" .. (entry.target.field as string) .. ")"
                    lines[#lines + 1] = prefix .. target .. " = " .. temps[position] .. ";"
                end
                yield true
            end
            case "vassign" -> do
                local statement = node as lane.Assign
                for _, entry in ipairs(statement.values) do
                    local target = entry.target
                    if target.kind == "vfield" or target.kind == "vspan" then
                        -- Consecutive elements, one lane each. Clang turns the group
                        -- into an interleaving store where the target has one.
                        lines[#lines + 1] = prefix .. "{"
                        lines[
                            #lines + 1
                        ] = prefix .. "    " .. emit.cType(
                            context,
                            entry.value.type
                        ) .. " lanes = " .. emit.lane(context, entry.value) .. ";"
                        for index = 0, body.lanes - 1 do
                            local address = "p_" .. target.span .. "[i + " .. tostring(index) .. "]"
                            if target.kind == "vfield" then
                                address = address .. "." .. target.field
                            end
                            lines[
                                #lines + 1
                            ] = prefix .. "    " .. address .. " = (" .. emit.storageC(
                                context,
                                target.scalarType,
                                target.sourceType
                            ) .. ")lanes[" .. tostring(index) .. "];"
                        end
                        lines[#lines + 1] = prefix .. "}"
                    else
                        lines[#lines + 1] = prefix .. target.cName .. " = " .. emit.lane(context, entry.value) .. ";"
                    end
                end
                yield true
            end
            case "vwhile" -> do
                local statement = node as lane.While
                -- The loop runs while any lane is live, and a lane that retired
                -- stops contributing without stopping the others.
                local immediateExit = exitsWhenEmpty(statement.body)
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(
                    context,
                    statement.live.type
                ) .. " " .. statement.live.cName .. " = " .. emit.lane(context, statement.initial) .. ";"
                if immediateExit then
                    lines[
                        #lines + 1
                    ] = prefix .. "if (ks_any_" .. tostring(
                        statement.live.type
                    ) .. "(" .. statement.live.cName .. ")) {"
                    lines[#lines + 1] = prefix .. "    while (true) {"
                else
                    lines[
                        #lines + 1
                    ] = prefix .. "while (ks_any_" .. tostring(
                        statement.live.type
                    ) .. "(" .. statement.live.cName .. ")) {"
                end
                lines[
                    #lines + 1
                ] = prefix .. (
                    immediateExit and "        " or "    "
                ) .. emit.cType(
                    context,
                    statement.executing.type
                ) .. " " .. statement.executing.cName .. " = " .. statement.live.cName .. ";"
                if immediateExit then
                    for _, line in ipairs(emit.block(context, statement.body, depth + 2, body)) do
                        lines[#lines + 1] = line
                    end
                else
                    nested(statement.body)
                end
                lines[
                    #lines + 1
                ] = prefix .. (
                    immediateExit and "        " or "    "
                ) .. statement.live.cName .. " &= " .. emit.lane(context, statement.condition) .. ";"
                if immediateExit then
                    lines[#lines + 1] = prefix .. "    }"
                end
                lines[#lines + 1] = prefix .. "}"
                yield true
            end
            case "vwhile_uniform" -> do
                local statement = node as lane.UniformWhile
                -- An ordinary loop over lane-parallel statements. The condition is
                -- scalar, so this is the same `while` the scalar body emits.
                lines[#lines + 1] = prefix .. "while (" .. emit.lane(context, statement.condition) .. ") {"
                nested(statement.body)
                lines[#lines + 1] = prefix .. "}"
                yield true
            end
            case "vbreak" -> do
                local statement = node as lane.Break
                local mask = emit.lane(context, statement.mask)
                lines[#lines + 1] = prefix .. statement.live.cName .. " &= ~(" .. mask .. ");"
                lines[#lines + 1] = prefix .. statement.executing.cName .. " &= ~(" .. mask .. ");"
                if statement.exitWhenEmpty == true then
                    lines[
                        #lines + 1
                    ] = prefix .. "if (!ks_any_" .. tostring(
                        statement.live.type
                    ) .. "(" .. statement.live.cName .. ")) break;"
                end
                yield true
            end
            case "vcontinue" -> do
                local statement = node as lane.Continue
                lines[
                    #lines + 1
                ] = prefix .. statement.executing.cName .. " &= ~(" .. emit.lane(context, statement.mask) .. ");"
                yield true
            end
            case "simd_store" -> do
                local statement = node as scalarIR.Simd
                lines[#lines + 1] = prefix .. emit.genericStore(context, statement as scalarIR.Simd) .. ";"
                yield true
            end
            case "simd_field_store" -> do
                local statement = node as scalarIR.Simd
                lines[#lines + 1] = prefix .. emit.genericFieldAccess(context, statement, true) .. ";"
                yield true
            end
            case "simd_reducer_add" -> do
                local contribution = node as scalarIR.SimdReducerAdd
                local named = contribution.reducer as scalarIR.Name
                local species = genericSpecies(context, contribution.value.type)
                local accumulator = body.simdAccumulators ~= nil and body.simdAccumulators[named.name] or nil
                local value = emit.lane(context, contribution.value)
                local right = contribution.right ~= nil and emit.lane(
                    context,
                    contribution.right as scalarIR.Expr
                ) or nil
                local mask = emit.lane(context, contribution.mask)
                if accumulator ~= nil then
                    -- The region keeps one lane-wise accumulator: the active
                    -- lanes take the combined value and the rest keep theirs.
                    local accType = simdAccumulatorType(
                        contribution.order,
                        contribution.element,
                        contribution.value.type
                    )
                    local combined = right ~= nil and "(" .. value .. " * " .. right .. ")" or value
                    if contribution.order == "exact" then
                        combined = "__builtin_convertvector(" .. combined .. ", " .. emit.cType(context, accType) .. ")"
                    end
                    local operator = SIMD_ACCUMULATE_OPERATORS[contribution.operation] or "+"
                    local accSpecies = genericSpecies(context, accType)
                    local maskType = emit.cType(context, "simd_mask_" .. accType:sub(#"simd_vector_" + 1))
                    lines[
                        #lines + 1
                    ] = prefix
                        .. accumulator
                        .. " = "
                        .. species.helper
                        .. "select_"
                        .. accSpecies.suffix
                        .. "(("
                        .. maskType
                        .. ")"
                        .. mask
                        .. ", "
                        .. accumulator
                        .. " "
                        .. tostring(
                            operator
                        ) .. " " .. combined .. ", " .. accumulator .. ");"
                    yield true
                end
                -- Everything else folds the active lanes into the scalar
                -- reducer in ascending lane order, which is the order the
                -- source would have contributed them one at a time.
                temporary = temporary + 1
                local serial = tostring(temporary)
                local vectorC = emit.cType(context, contribution.value.type)
                lines[#lines + 1] = prefix .. "{"
                lines[#lines + 1] = prefix .. "    " .. vectorC .. " simd_value_" .. serial .. " = " .. value .. ";"
                if right ~= nil then
                    lines[#lines + 1] = prefix .. "    " .. vectorC .. " simd_right_" .. serial .. " = " .. right .. ";"
                end
                lines[
                    #lines + 1
                ] = prefix
                    .. "    uint64_t simd_bits_"
                    .. serial
                    .. " = "
                    .. species.helper
                    .. "bits_"
                    .. species.suffix
                    .. "("
                    .. mask
                    .. ");"
                local stateful = reducerHelper(contribution.order, contribution.operation, contribution.element)
                for index = 0, species.lanes - 1 do
                    local laneValue = genericLane(context, species, "simd_value_" .. serial, index)
                    if contribution.element == "bool" then
                        -- A predicate lane is a mask lane, all bits or none.
                        laneValue = "(bool)" .. laneValue
                    end
                    if right ~= nil then
                        laneValue = "(" .. laneValue .. " * " .. genericLane(
                            context,
                            species,
                            "simd_right_" .. serial,
                            index
                        ) .. ")"
                    end
                    local contributed: string
                    if stateful ~= nil then
                        contributed = stateful .. "add(&" .. tostring(named.cName) .. ", " .. laneValue .. ");"
                    else
                        local operator = contribution.operation == "product" and " *= " or " += "
                        contributed = tostring(named.cName) .. operator .. laneValue .. ";"
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "    if ((simd_bits_" .. serial .. " >> " .. tostring(
                        index
                    ) .. ") & UINT64_C(1)) " .. contributed
                end
                lines[#lines + 1] = prefix .. "}"
                yield true
            end
            case "simd_region" -> do
                local region = node as scalarIR.SimdRegion
                local accumulators: {[string]: string} = {}
                local parallel: {scalarIR.SimdRegionReducer} = {}
                lines[#lines + 1] = prefix .. "{"
                -- A parallel order over a native species accumulates lane-wise
                -- and folds once at the end; the oracle, a composite, a
                -- predicate whose lanes are a mask and every other order
                -- contribute lane by lane as they go.
                if body.forceScalar ~= true and not context.explicitScalar then
                    for _, reducer in ipairs(region.reducers) do
                        local species = genericSpecies(context, reducer.vectorType)
                        if reducers.parallel(reducer.order) and not species.composite and reducer.element ~= "bool" then
                            temporary = temporary + 1
                            local name = "simd_acc_" .. tostring(temporary)
                            accumulators[reducer.name] = name
                            parallel[#parallel + 1] = reducer
                            local accType = simdAccumulatorType(reducer.order, reducer.element, reducer.vectorType)
                            local accSpecies = genericSpecies(context, accType)
                            lines[
                                #lines + 1
                            ] = prefix .. "    " .. emit.cType(
                                context,
                                accType
                            )
                                .. " "
                                .. name
                                .. " = "
                                .. accSpecies.helper
                                .. "splat_"
                                .. accSpecies.suffix
                                .. "(("
                                .. emit.cType(
                                    context,
                                    accSpecies.element
                                ) .. ")" .. reducers.identity(reducer.operation) .. ");"
                        end
                    end
                end
                local inner = new emit.Body(
                    lanes = body.lanes,
                    layouts = body.layouts,
                    resultStruct = body.resultStruct,
                    forceScalar = body.forceScalar,
                    algebraicReducers = body.algebraicReducers,
                    repeatSerial = body.repeatSerial,
                    simdAccumulators = accumulators
                )
                append(emit.block(context, region.body, depth + 1, inner, repeatContinue))
                for _, reducer in ipairs(parallel) do
                    local accumulator = accumulators[reducer.name] as string
                    local species = genericSpecies(context, reducer.vectorType)
                    for index = 0, species.lanes - 1 do
                        local laneValue = accumulator .. "[" .. tostring(index) .. "]"
                        if reducer.order == "exact" then
                            lines[
                                #lines + 1
                            ] = prefix .. "    " .. reducers.finish(
                                reducer.operation,
                                reducer.element as string,
                                reducer.cName,
                                laneValue
                            )
                        else
                            local operator = reducer.operation == "product" and " *= " or " += "
                            lines[
                                #lines + 1
                            ] = prefix .. "    " .. reducer.cName .. operator .. "(double)" .. laneValue .. ";"
                        end
                    end
                end
                lines[#lines + 1] = prefix .. "}"
                yield true
            end
            case "vreducer_add" -> do
                local statement = node as lane.ReducerAdd
                local contribution = statement as lane.ReducerAdd
                temporary = temporary + 1
                local vectorType = tostring(contribution.value.type)
                local temp = "reduce" .. tostring(temporary)
                local contributed = contribution.right ~= nil and "(" .. emit.lane(
                    context,
                    contribution.value
                ) .. " * " .. emit.lane(
                    context,
                    contribution.right as lane.Expr
                ) .. ")" or emit.lane(context, contribution.value)
                lines[
                    #lines + 1
                ] = prefix .. emit.cType(context, vectorType) .. " " .. temp .. " = " .. contributed .. ";"
                local _, width = emit.vectorParts(vectorType)
                local algebraic = body.algebraicReducers ~= nil and body.algebraicReducers[contribution.reducer] or nil
                if contribution.order == "exact" and algebraic ~= nil then
                    lines[
                        #lines + 1
                    ] = prefix .. reducers.accumulate(
                        contribution.operation,
                        contribution.element as string,
                        vectorType,
                        algebraic,
                        temp
                    )
                elseif contribution.order == "algebraic" and algebraic ~= nil then
                    lines[
                        #lines + 1
                    ] = prefix .. algebraic .. (contribution.operation == "product" and " *= " or " += ") .. temp .. ";"
                else
                    local stateful = reducerHelper(contribution.order, contribution.operation, contribution.element)
                    for laneIndex = 0, width - 1 do
                        if stateful ~= nil then
                            lines[
                                #lines + 1
                            ] = prefix .. stateful .. "add(&" .. contribution.reducerCName .. ", (" .. emit.cType(
                                context,
                                contribution.element or "f64"
                            ) .. ")" .. temp .. "[" .. tostring(laneIndex) .. "]);"
                        else
                            local operator = contribution.operation == "product" and " *= " or " += "
                            lines[
                                #lines + 1
                            ] = prefix
                                .. contribution.reducerCName
                                .. operator
                                .. "(double)"
                                .. temp
                                .. "["
                                .. tostring(
                                    laneIndex
                                ) .. "];"
                        end
                    end
                end
                yield true
            end
            case "reducer_add" -> do
                local statement = node as scalarIR.ReducerAdd
                local contribution = statement as scalarIR.ReducerAdd
                local named = contribution.reducer as scalarIR.Name
                local contributed = contribution.right ~= nil and "(" .. emit.lane(
                    context,
                    contribution.value
                ) .. " * " .. emit.lane(
                    context,
                    contribution.right as scalarIR.Expr
                ) .. ")" or emit.lane(context, contribution.value)
                local stateful = reducerHelper(contribution.order, contribution.operation, contribution.value.type)
                if stateful ~= nil then
                    lines[
                        #lines + 1
                    ] = prefix .. stateful .. "add(&" .. tostring(named.cName) .. ", " .. contributed .. ");"
                else
                    local operator = contribution.operation == "product" and " *= " or " += "
                    lines[#lines + 1] = prefix .. tostring(named.cName) .. operator .. contributed .. ";"
                end
                yield true
            end
            case "return" -> do
                local statement = node as scalarIR.Return
                if #statement.values > 1 then
                    local values: {string} = {}
                    for position, value in ipairs(statement.values) do
                        values[position] = emit.scalar(context, value)
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "return (" .. tostring(
                        body.resultStruct
                    ) .. "){" .. table.concat(values, ", ") .. "};"
                elseif #statement.values == 1 then
                    lines[#lines + 1] = prefix .. "return " .. emit.scalar(context, statement.values[1]) .. ";"
                else
                    lines[#lines + 1] = prefix .. "return;"
                end
                yield true
            end
            case "fornum" -> do
                local statement = node as scalarIR.Fornum
                if statement.lanes ~= nil and body.forceScalar ~= true then
                    local region = statement as scalarIR.Fornum
                    local lanes = region.lanes as scalarIR.LaneBody
                    local width = tostring(lanes.lanes)
                    local algebraicReducers: {[string]: string} = {}
                    local algebraicOrder: {lane.ReducerAdd} = {}
                    for _, laneStatement in ipairs(lanes.statements) do
                        if laneStatement.op == "vreducer_add" and reducers.parallel(laneStatement.order) then
                            local contribution = laneStatement as lane.ReducerAdd
                            algebraicOrder[#algebraicOrder + 1] = contribution
                            algebraicReducers[
                                contribution.reducer
                            ] = "reduce_acc_" .. tostring(temporary + #algebraicOrder)
                        end
                    end
                    local laneBody = new emit.Body(
                        lanes = lanes.lanes,
                        layouts = body.layouts,
                        resultStruct = body.resultStruct,
                        forceScalar = false,
                        algebraicReducers = algebraicReducers
                    )
                    lines[#lines + 1] = prefix .. "{"
                    for _, contribution in ipairs(algebraicOrder) do
                        local accumulator = algebraicReducers[contribution.reducer] as string
                        local vector = reducers.accumulatorType(
                            contribution.order,
                            contribution.element or "f64",
                            contribution.value.type
                        )
                        lines[
                            #lines + 1
                        ] = prefix .. "    " .. emit.cType(
                            context,
                            vector
                        ) .. " " .. accumulator .. " = (" .. emit.cType(
                            context,
                            vector
                        ) .. "){" .. repeated(reducers.identity(contribution.operation), lanes.lanes) .. "};"
                    end
                    lines[
                        #lines + 1
                    ] = prefix .. "    size_t i = (size_t)((int32_t)(" .. emit.lane(context, region.from) .. ") - 1);"
                    lines[
                        #lines + 1
                    ] = prefix .. "    size_t end = (size_t)(int32_t)(" .. emit.lane(context, region.to) .. ");"
                    lines[
                        #lines + 1
                    ] = prefix
                        .. "    size_t groups = (end > i) ? ((end - i) / "
                        .. width
                        .. ") * "
                        .. width
                        .. " + i : i;"
                    lines[#lines + 1] = prefix .. "    for (; i < groups; i += " .. width .. ") {"
                    for _, line in ipairs(emit.block(context, lanes.statements, depth + 2, laneBody)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = prefix .. "    }"
                    for _, contribution in ipairs(algebraicOrder) do
                        local accumulator = algebraicReducers[contribution.reducer] as string
                        for laneIndex = 0, lanes.lanes - 1 do
                            if contribution.order == "exact" then
                                lines[
                                    #lines + 1
                                ] = prefix .. "    " .. reducers.finish(
                                    contribution.operation,
                                    contribution.element as string,
                                    contribution.reducerCName,
                                    accumulator .. "[" .. tostring(laneIndex) .. "]"
                                )
                            else
                                local operator = contribution.operation == "product" and " *= " or " += "
                                lines[
                                    #lines + 1
                                ] = prefix
                                    .. "    "
                                    .. contribution.reducerCName
                                    .. operator
                                    .. "(double)"
                                    .. accumulator
                                    .. "["
                                    .. tostring(
                                        laneIndex
                                    ) .. "];"
                            end
                        end
                    end
                    lines[
                        #lines + 1
                    ] = prefix
                        .. "    for (int32_t "
                        .. region.binding.cName
                        .. " = (int32_t)i + 1; "
                        .. region.binding.cName
                        .. " <= (int32_t)"
                        .. "end; ++"
                        .. region.binding.cName
                        .. ") {"
                    for _, line in ipairs(emit.block(context, region.body, depth + 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = prefix .. "    }"
                    lines[#lines + 1] = prefix .. "}"
                elseif statement.vector ~= nil and body.forceScalar ~= true then
                    -- The region in the explicit vocabulary stands in for the
                    -- counted loop whole: it reads the span count and the
                    -- species width itself, so the whole groups and the tail
                    -- are its own two statements.
                    lines[#lines + 1] = prefix .. "{"
                    for _, line in ipairs(
                        emit.block(context, statement.vector as {scalarIR.Statement}, depth + 1, body)
                    ) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = prefix .. "}"
                else
                    append(controlFlow(node as emit.Flow, depth, body, repeatContinue, expression, recursive, true))
                end
                yield true
            end
            case "if", "while", "repeat", "block", "break", "continue" -> do
                append(controlFlow(node as emit.Flow, depth, body, repeatContinue, expression, recursive, true))
                yield true
            end
            case "shared_store", "phase", "simd_species_u8", "simd_species", "simd_lanes_generic", "simd_splat", "simd_iota", "simd_tail", "simd_load", "simd_binary", "simd_unary", "simd_compare", "simd_select", "simd_mask_any", "simd_mask_all", "simd_mask_count", "simd_mask_first", "simd_mask_bits", "simd_extract", "simd_insert", "simd_permute", "simd_convert", "simd_reinterpret", "simd_compress", "simd_expand", "simd_prefix", "simd_horizontal", "simd_mask_splat", "simd_mask_convert", "simd_field_load", "simd_call", "simd_math", "simd_lanes", "simd_load_u8", "simd_load_string_u8", "simd_load_stride3_u8", "simd_splat_u8", "simd_shr_u8", "simd_shl_u8", "simd_table_u8x16", "simd_lookup16_u8", "simd_lookup64_u8", "simd_store4_u8", "simd_align_bytes_u8", "simd_padded_string_u8", "simd_padded_length", "simd_padded_full_length", "simd_padded_tail_length", "simd_padded_load_full_u8", "simd_padded_load_tail_u8", "simd_block64_load_u8", "simd_block64_and_byte_u8", "simd_block64_and_u8", "simd_block64_shr_u8", "simd_block64_lookup16_u8", "simd_block64_any_bits_u8", "simd_block64_last_u8", "simd_block64_utf8_errors_u8", "simd_block64_eq_u8", "simd_block64_range_u8", "simd_block64_outside_range_u8", "simd_tail_u8", "simd_eq_u8", "simd_range_u8", "simd_vec_and", "simd_vec_or", "simd_vec_xor", "simd_vec_not", "simd_mask_and", "simd_mask_or", "simd_mask_xor", "simd_mask_not", "simd_select_u8", "simd_any", "simd_all", "simd_count", "simd_bits", "simd_mask64", "simd_mask64_add", "simd_mask64_and", "simd_mask64_or", "simd_mask64_xor", "simd_mask64_not", "simd_mask64_shl", "simd_mask64_shr", "simd_mask64_prefix_xor", "simd_mask64_low", "simd_mask64_high", "simd_mask64_any", "simd_mask64_count", "simd_mask64_first", "simd_mask64_clear_first", "lua_builder_open_array", "lua_builder_open_object", "lua_builder_key", "lua_builder_string", "lua_builder_number", "lua_builder_number_slice", "lua_builder_integer_slice", "lua_builder_integer64", "lua_builder_decimal64", "lua_builder_boolean", "lua_builder_null", "lua_builder_close", "lua_builder_key_scratch", "lua_builder_string_scratch", "lua_builder_key_escapes", "lua_builder_string_escapes", "lua_set_index", "lua_set_key", "lua_string_buffer_append", "lua_scratch_u32_set", "lua_scratch_u8_set", "lua_scratch_u8_set4", "lua_scratch_u8_reset" -> error(
                "unsupported C kernel statement " .. node.op,
                0
            )
        end
    end

    for position, statement in ipairs(statements) do
        if render(statement, position) ~= true then
            error("unknown C statement " .. tostring(statement.op), 0)
        end
    end

    return lines
end

----------------------------------------------------------------------------
-- The whole program
----------------------------------------------------------------------------

--- One or more programs, as one C file.
---
--- Everything shared is emitted once and everything per function once each: the
--- includes, a struct typedef, and a gang's prelude are shared, while the layout
--- reporters, the helpers and the two function bodies belong to the function
--- that needed them. Two functions reifying one struct get one typedef and two
--- sets of reporters, because a reporter is named after the symbol whose wrapper
--- checks it.
---
--- Two definitions of the same function come out per program: the real one, and
--- a forced-scalar one that is the oracle the lane-parallel body is diffed
--- against. The oracle must not share the real body's lowering, which is why it
--- keeps the scalar statements and carries a pragma refusing vectorisation --
--- including whatever the C compiler would have done on its own.
--- @raises when passed malformed or unverified IR
function emit.program(programs: {scalarIR.Program}, tier: string?): string
    local context = emit.context()
    context.expressions = cplan.expressions(programs)
    collectExplicitFixed(context, programs)

    local lines = emit.includes()
    local hasBuilder = false
    local hasNumberToken = false
    for _, program in ipairs(programs) do
        hasBuilder = hasBuilder or program.entryMode == "lua-builder"
        hasNumberToken = hasNumberToken or program.usesNumberToken == true
    end
    if hasBuilder then
        for _, line in ipairs(emit.luaPrelude(hasNumberToken)) do
            lines[#lines + 1] = line
        end
    end
    local declared: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        for _, layout in ipairs(program.layouts or {}) do
            if not declared[layout.name] then
                declared[layout.name] = true
                for _, line in ipairs(emit.layout(context, layout)) do
                    lines[#lines + 1] = line
                end
                lines[#lines + 1] = ""
            end
            for _, line in ipairs(emit.layoutReporters(physicalSymbol(program.symbol, tier), layout)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = ""
        end
    end

    -- Lua-callable entries with several scalar results cross the private C ABI
    -- as one explicitly laid-out aggregate. The wrapper immediately unpacks it;
    -- the type never becomes part of the Nupp source API.
    for _, program in ipairs(programs) do
        local resultTypes = program.resultTypes or {}
        if program.entryMode ~= "lua-builder" and #resultTypes > 1 then
            local resultName = scalarIR.cIdentifier("KsResult", program.symbol)
            lines[#lines + 1] = "typedef struct {"
            for position, resultType in ipairs(resultTypes) do
                lines[#lines + 1] = "    " .. emit.cType(context, resultType) .. " v" .. tostring(position) .. ";"
            end
            lines[#lines + 1] = "} " .. resultName .. ";"
            lines[#lines + 1] = ""
        end
    end

    -- The gang types and helpers, once, when any function chose a gang. A
    -- program without a lane body contributes none. It used to fall back to the
    -- widest shape, which put that shape's typedefs and helpers in files no gang
    -- was chosen for -- and on a target whose register class is narrower than
    -- the widest shape, a 32-byte vector returned by value is exactly the
    -- `-Wpsabi` the target model exists to avoid.
    local function hasLanes(statements: {scalarIR.Statement}): boolean
        for _, statement in ipairs(statements) do
            if hasLanes((statement as any).conditionBody or {}) then
                return true
            end
            if statement.op == "fornum" then
                local loop = statement as scalarIR.Fornum
                if loop.lanes ~= nil or hasLanes(loop.body) then
                    return true
                end
            elseif statement.op == "if" then
                for _, clause in ipairs((statement as scalarIR.If).clauses) do
                    if hasLanes(clause.body) then
                        return true
                    end
                end
                if hasLanes((statement as scalarIR.If).elseBody or {}) then
                    return true
                end
            elseif statement.op == "while" or statement.op == "repeat" or statement.op == "block" then
                if hasLanes((statement as any).body as {scalarIR.Statement}) then
                    return true
                end
            end
        end

        return false
    end

    for _, program in ipairs(programs) do
        if program.lanes ~= nil or hasLanes(program.body or {}) then
            lines[#lines + 1] = emit.carried("ks_gang.h")
            break
        end
    end

    lines[#lines + 1] = emit.carried("ks_scalar.h")

    local simdWidths: {[integer]: boolean} = {}
    for _, program in ipairs(programs) do
        if program.simdWidth ~= nil and not simdWidths[program.simdWidth as integer] then
            simdWidths[program.simdWidth as integer] = true
            for _, line in ipairs(emit.simdPrelude(context, program.simdWidth as integer)) do
                lines[#lines + 1] = line
            end
        end
    end

    for _, program in ipairs(programs) do
        local context = emit.context(context, program)
        -- Byte tables the body reads that were known when it was compiled, at
        -- file scope so the compiler has their contents and their alignment. A
        -- read spells these exactly as it spells a rooted argument, which is
        -- why nothing between the source and here had to be taught about them.
        for _, constant in ipairs(program.constants or {}) do
            if not declared[constant.cName] then
                declared[constant.cName] = true
                local bytes: {string} = {}
                for index = 1, #constant.value do
                    bytes[index] = tostring(constant.value:byte(index))
                end
                lines[#lines + 1] = ("static const size_t ks_length_%s = %d;"):format(constant.cName, #constant.value)
                lines[
                    #lines + 1
                ] = (
                    "_Alignas(4) static const unsigned char ks_bytes_%s[] = {%s};"
                ):format(constant.cName, table.concat(bytes, ","))
            end
        end

        local helpers = program.helpers or {}
        for _, line in ipairs(emit.helpers(context, helpers)) do
            lines[#lines + 1] = line
        end

        local lanes = program.lanes
        local width = lanes ~= nil and (lanes as scalarIR.LaneBody).lanes or 0
        local resultTypes = program.resultTypes or {}
        local resultStruct = #resultTypes > 1 and scalarIR.cIdentifier("KsResult", program.symbol) or nil
        local layouts: {[string]: scalarIR.Layout} = {}
        for _, layout in ipairs(program.layouts or {}) do
            layouts[layout.name] = layout
        end
        local body = new emit.Body(lanes = width, layouts = layouts, resultStruct = resultStruct)
        local general = program.body ~= nil
        if program.entryMode == "lua-builder" then
            local byteRoots = 0
            for _, param in ipairs(program.params) do
                if param.type == "lua_bytes" then
                    byteRoots = byteRoots + 1
                end
            end
            lines[#lines + 1] = "static int " .. program.symbol .. "_lua(lua_State *L) {"
            lines[
                #lines + 1
            ] = "    if (!lua_checkstack(L, " .. tostring(
                verify.builderStack(program) + byteRoots + (byteRoots > 0 and 2 or 0)
            ) .. ")) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
            for position, param in ipairs(program.params) do
                if param.kind == "uniform" then
                    local read = param.type == "bool" and "lua_toboolean(L, " .. tostring(
                        position
                    ) .. ")" or "luaL_checknumber(L, " .. tostring(position) .. ")"
                    lines[
                        #lines + 1
                    ] = "    " .. emit.cType(
                        context,
                        param.type
                    ) .. " p_" .. param.name .. " = (" .. emit.cType(context, param.type) .. ")(" .. read .. ");"
                elseif param.kind == "scalar" and (
                    param.type == "lua_string" or param.type == "lua_bytes" or param.type == "lua_value"
                ) then
                    -- The argument itself is the root. Source uses carry this
                    -- positive absolute stack index; no GC pointer is taken.
                    if param.type == "lua_string" or param.type == "lua_bytes" then
                        lines[#lines + 1] = "    size_t ks_length_" .. tostring(param.cName) .. " = 0u;"
                        lines[
                            #lines + 1
                        ] = "    const unsigned char *ks_bytes_" .. tostring(
                            param.cName
                        ) .. " = " .. (
                            param.type == "lua_bytes" and "ks_lua_bytes" or "(const unsigned char *)luaL_checklstring"
                        ) .. "(L, " .. tostring(position) .. ", &ks_length_" .. tostring(param.cName) .. ");"
                        lines[#lines + 1] = "    (void)ks_bytes_" .. tostring(param.cName) .. ";"
                    end
                else
                    error("Lua builders currently take scalar parameters", 0)
                end
            end
            local rootCount: integer = 0
            visit.program(
                program,
                new visit.Visitor(scalarStatement = function(statement: scalarIR.Statement): nil
                    if statement.op == "let" and (
                        statement.type == "lua_string"
                        or statement.type == "lua_nil"
                        or statement.type == "lua_table"
                        or statement.type == "lua_value"
                    ) then
                        local name = statement.cName
                        if body.luaRootSlots[name] == nil then
                            rootCount = rootCount + 1
                            body.luaRootSlots[name] = rootCount
                        end
                    end
                end)
            )
            if rootCount > 0 then
                lines[#lines + 1] = "    int ks_root_base = lua_gettop(L);"
                lines[#lines + 1] = "    lua_settop(L, ks_root_base + " .. tostring(rootCount) .. ");"
            end
            for _, line in ipairs(emit.luaBlock(context, program.body or {}, 1, body)) do
                lines[#lines + 1] = line
            end
            lines[#lines + 1] = "    return 0;"
            lines[#lines + 1] = "}"
            lines[#lines + 1] = ""
        else
            local touched = emit.pointerSpans(program)
            local independentCounts = scalarIR.independentCounts(program)
            local params = emit.parameters(context, program.params, independentCounts, touched)
            local cResult = #resultTypes == 0 and "void" or resultStruct ~= nil and resultStruct or emit.cType(
                context,
                resultTypes[1]
            )

            --- One C definition of the kernel.
            local function implementation(symbol: string, forced: boolean): nil
                local context = emit.context(context, nil, forced and program.usesSimd == true)
                body.forceScalar = forced
                body.controlUsed = {}
                if not general and hasConditionBody((program.loop as scalarIR.Loop).statements) then
                    body.headerControl = true
                    body.controlBreak = "ks_map_break"
                    body.controlContinue = "ks_map_continue"
                end
                if forced and general then
                    -- The block may declare locals before its first loop, so a
                    -- loop pragma cannot be placed at function entry. Keep this
                    -- test-only oracle wholly scalar instead.
                    lines[#lines + 1] = "KS_SCALAR_ORACLE"
                end
                lines[#lines + 1] = "__attribute__((noinline))"
                lines[#lines + 1] = "KS_API " .. cResult .. " " .. symbol .. "(" .. params .. ") {"
                if not general and independentCounts then
                    lines[#lines + 1] = "    size_t count = count_" .. (program.loop as scalarIR.Loop).count .. ";"
                end
                if program.fpContract == true then
                    for _, line in ipairs(emit.contractPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                if not general then
                    for _, line in ipairs(emit.bounds(program.rangeGuard)) do
                        lines[#lines + 1] = line
                    end
                end
                if forced and not general then
                    for _, line in ipairs(emit.forcedScalarPragma()) do
                        lines[#lines + 1] = line
                    end
                end
                local vector = program.vector
                if general then
                    for _, line in ipairs(emit.block(context, program.body or {}, 1, body)) do
                        lines[#lines + 1] = line
                    end
                elseif vector ~= nil and not forced then
                    -- The map loop in the explicit vocabulary: its region
                    -- reads the bounds itself, so the scalar `i` and `end` are
                    -- declared for the guard's sake and not otherwise read.
                    lines[#lines + 1] = "    (void)i;"
                    lines[#lines + 1] = "    (void)end;"
                    for _, line in ipairs(emit.block(context, vector as {scalarIR.Statement}, 1, body)) do
                        lines[#lines + 1] = line
                    end
                elseif lanes ~= nil and not forced then
                    for _, line in ipairs(emit.groupBound(width)) do
                        lines[#lines + 1] = line
                    end
                    for _, line in ipairs(emit.block(context, (lanes as scalarIR.LaneBody).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    lines[#lines + 1] = "    }"
                end
                if not general and (vector == nil or forced) then
                    lines[#lines + 1] = "    for (; i < end; ++i) {"
                    for _, line in ipairs(emit.block(context, (program.loop as scalarIR.Loop).statements, 2, body)) do
                        lines[#lines + 1] = line
                    end
                    if body.controlUsed["ks_map_continue"] then
                        lines[#lines + 1] = "        ks_map_continue:;"
                    end
                    lines[#lines + 1] = "    }"
                    if body.controlUsed["ks_map_break"] then
                        lines[#lines + 1] = "    ks_map_break:;"
                    end
                end
                lines[#lines + 1] = "}"
                lines[#lines + 1] = ""
            end

            if not general or program.usesSimd == true or program.simdRequired == true then
                implementation(physicalSymbol(program.symbol .. "_forced_scalar", tier), true)
            end
            implementation(physicalSymbol(program.symbol, tier), false)
        end
    end

    local builders: {scalarIR.Program} = {}
    local registrar: string? = nil
    for _, program in ipairs(programs) do
        if program.entryMode == "lua-builder" then
            registrar = registrar or program.registrar
            if registrar ~= program.registrar then
                error("one translation unit carried multiple Lua registrars", 0)
            end
            builders[#builders + 1] = program
        end
    end
    if #builders > 0 then
        lines[#lines + 1] = "KS_API int " .. physicalSymbol(tostring(registrar), tier) .. "(lua_State *L) {"
        lines[#lines + 1] = "    if (!lua_checkstack(L, 3)) return luaL_error(L, \"AOT builder Lua stack exhausted\");"
        lines[#lines + 1] = "    lua_createtable(L, 0, " .. tostring(#builders) .. ");"
        lines[#lines + 1] = "    int registry = lua_gettop(L);"
        for _, program in ipairs(builders) do
            lines[
                #lines + 1
            ] = "    lua_pushlstring(L, " .. cBytes(program.name) .. ", " .. tostring(#program.name) .. "u);"
            lines[#lines + 1] = "    lua_pushcclosure(L, " .. program.symbol .. "_lua, 0);"
            lines[#lines + 1] = "    lua_rawset(L, registry);"
        end
        lines[#lines + 1] = "    return 1;"
        lines[#lines + 1] = "}"
        lines[#lines + 1] = ""
    end

    return table.concat(lines, "\n") .. "\n"
end

export = emit
