module nupp.compiler.aot.target

--[[
What a target can hold, which decides how wide a vector may be.

A vector register is 16, 32 or 64 bytes. 16 is one SSE2 register, which every
x86-64 has; 32 is one AVX register; and 64 is one AVX-512 register. A target
takes the widest that fits its register class and no wider: a vector wider than
the selected x86-64 tier still compiles, because the compiler splits it, but it
has no stable ABI at a function boundary. Clang says so through `-Wpsabi`, and
it is right to.

So this is where a `@simd` rewrite finds out how wide it may be.

Nothing here probes the machine by running anything. A tier is selected, not
discovered, because a build that measured the machine in front of it would
produce an artifact that only runs there.

The triples are `nupp.compiler.targetlayout`'s. This does not invent a second
vocabulary for the same thing.
]]

local targetLayout = require("nupp.compiler.targetlayout")

local target = {}

--- The widest vector each CPU feature tier has a register class for.
---
--- A tier is a name for a set of instructions a build promises the machine has.
--- These are the only ones that matter here, because the only question this
--- module answers is how wide a value can be and still have somewhere to live.
const target.TIERS = {
    --- x86-64 as the architecture defines it: SSE2, 16-byte registers.
    ["baseline"] = 16,

    --- x86-64 with AVX2, where a 32-byte vector is one register.
    ["avx2"] = 32,

    --- x86-64 with AVX-512F, where a 64-byte vector is one register.
    ["avx512f"] = 64,

    --- aarch64, whose 16-byte NEON registers are mandatory rather than optional
    --- and which pairs them for a 32-byte value without an ABI question.
    ["neon"] = 32,

    --- WebAssembly SIMD has one portable 128-bit vector register shape.
    ["simd128"] = 16,

    --- Scalar WebAssembly deliberately admits no vector rewrite.
    ["scalar"] = 0,
}

--- The tier a target gets when nothing selected one.
---
--- Conservative on x86-64 on purpose: a binary built for AVX2 does not run on a
--- machine without it, and a default that assumed otherwise would produce
--- artifacts that fail on hardware the triple says they support. Asking for
--- vectors there is asking for a tier.
const target.DEFAULT_TIERS = {
    ["x86_64"] = "baseline",
    ["i686"] = "baseline",
    ["aarch64"] = "neon",
    ["wasm32"] = "scalar",
}

--- One target the backend may compile for.
record target.Target
    --- The triple, from `targetlayout`'s vocabulary.
    triple: string

    --- The architecture it names, which is what decides the tiers available.
    architecture: string

    --- The CPU feature tier this build promises.
    tier: string
end

--- The architecture one triple names.
function target.architecture(triple: string): string
    return triple:match("^([^-]+)") or triple
end

--- The triple this machine is, or nothing when it is not a modeled target.
---
--- What tells a cross-compilation from an ordinary one, which is the only thing
--- that decides whether the compiler is told a target at all.
function target.hostTriple(): string?
    return targetLayout.hostKey()
end

--- The operating system one triple names.
---
--- Read from the triple rather than from the machine this is running on,
--- because those are the same only when nothing is being cross-compiled -- and
--- what it decides is how a shared library is produced and what it is called,
--- which belong to where the artifact will run.
function target.system(triple: string): string
    if triple:find("emscripten", 1, true) ~= nil then
        return "emscripten"
    elseif triple:find("darwin", 1, true) ~= nil then
        return "darwin"
    elseif triple:find("windows", 1, true) ~= nil then
        return "windows"
    end

    return "linux"
end

--- The tiers an architecture may select, widest last.
function target.tiers(architecture: string): {string}
    if architecture == "wasm32" then
        return {"scalar", "simd128"}
    elseif architecture == "aarch64" then
        return {"neon"}
    elseif architecture == "x86_64" then
        return {"baseline", "avx2", "avx512f"}
    end

    return {"baseline", "avx2"}
end

--- The tiers a project build carries, narrowest first.
---
--- A range is an explicit inclusive host contract. The temporary string form
--- retains the former x86-64 ceiling semantics until the stage-zero pin moves;
--- other architectures continue to read it as one exact tier.
function target.buildTiers(triple: string?, features: any): ({target.Target}?, string?)
    local base, baseErr = target.select(triple, nil)
    if base == nil then
        return nil, baseErr
    end

    local actual = base as target.Target
    local architecture = actual.architecture
    if type(features) ~= "table" and architecture ~= "x86_64" then
        local selected, selectedErr = target.select(actual.triple, features as string?)
        if selected == nil then
            return nil, selectedErr
        end

        return {selected as target.Target}, nil
    end

    local known = target.tiers(architecture)
    local first = known[1]
    local last = known[#known]
    if type(features) == "string" then
        last = features
    elseif type(features) == "table" then
        first = features.minimum as string
        last = features.maximum as string
    end
    local _, firstErr = target.select(actual.triple, first)
    if firstErr ~= nil then
        return nil, firstErr
    end
    local _, lastErr = target.select(actual.triple, last)
    if lastErr ~= nil then
        return nil, lastErr
    end

    local firstIndex, lastIndex = nil, nil
    for index, tier in ipairs(known) do
        if tier == first then
            firstIndex = index
        end
        if tier == last then
            lastIndex = index
        end
    end
    if (firstIndex as integer) > (lastIndex as integer) then
        return nil, "feature tier minimum " .. first .. " is wider than maximum " .. last
    end

    local selected: {target.Target} = {}
    for index = firstIndex as integer, lastIndex as integer do
        local one = target.select(actual.triple, known[index])
        if one ~= nil then
            selected[#selected + 1] = one as target.Target
        end
    end

    return selected, nil
end

--- A tier's stable C-symbol suffix.
function target.symbol(symbol: string, tier: string): string
    return symbol .. "__" .. tier:gsub("[^%w_]", "_")
end

--- The detector value one x86-64 tier corresponds to.
function target.rank(tier: string): integer
    if tier == "avx512f" then
        return 2
    elseif tier == "avx2" then
        return 1
    end

    return 0
end

--- Selects a target, or says why it is not one.
---
--- @param triple the target triple, or nothing for the host's
--- @param tier the CPU feature tier, or nothing for the architecture's default
--- @return the target, or nothing and what was wrong with the request
function target.select(triple: string?, tier: string?): (target.Target?, string?)
    local named = triple or targetLayout.hostKey()
    if named == nil then
        return nil, "this host is not a modeled target; name one with --target"
    end
    if not targetLayout.has(named) then
        return nil, "unknown target " .. tostring(named)
    end

    local architecture = target.architecture(named as string)
    local selected = tier or target.DEFAULT_TIERS[architecture]
    if selected == nil then
        return nil, "no feature tier is known for " .. architecture
    end

    local available = target.tiers(architecture)
    local admitted = false
    for _, one in ipairs(available) do
        if one == selected then
            admitted = true
        end
    end
    if not admitted then
        return nil, (
            "%s has no feature tier %s; it has %s"
        ):format(architecture, tostring(selected), table.concat(available, ", "))
    end

    return new target.Target(triple = named as string, architecture = architecture, tier = selected as string), nil
end

--- The vector width, in bytes, an explicit SIMD program takes on this target.
---
--- This is the width of one native register the tier's flags cover: NEON is
--- 16 bytes even though two of its registers pair without an ABI question, so a
--- `preferred` species there is one register wide. A 64-byte value only exists
--- under AVX-512F, so only that tier answers 64 and no wider block is ever
--- instantiated for the others.
function target.simdWidth(selected: target.Target): integer
    if selected.tier == "avx512f" then
        return 64
    elseif selected.tier == "avx2" then
        return 32
    end

    return 16
end

--- The vector width, in bytes, a `@simd` region groups its iterations into.
---
--- `TIERS` above, which differs from `simdWidth` only on NEON: it pairs two
--- registers for a 32-byte value without an ABI question, and a region filling
--- both measures faster than one filling a single register -- the Mandelbrot
--- kernel runs at 182 MPix/s over eight binary32 lanes against 142 over four.
---
--- The two are free to differ because they answer different questions.
--- `simdWidth` is what `preferred` means where someone wrote it, which is a
--- promise to whoever reads that source: one register. This is only what the
--- rewrite groups iterations by, which nobody writes down.
function target.simdRegionWidth(selected: target.Target): integer
    return (target.TIERS[selected.tier] or target.simdWidth(selected)) as integer
end

export = target
