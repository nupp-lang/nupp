--[[
What a target can hold, which decides what a gang can be.

A gang is 16 or 32 bytes. 32 is one AVX register on x86-64 and two NEON registers
on aarch64; 16 is one SSE2 register, which every x86-64 has. A target takes the
widest shapes that fit its register class and no wider: a 32-byte vector on
x86-64 without AVX still compiles, because the compiler splits it, but it has no
stable ABI at a function boundary. Clang says so through `-Wpsabi`, and it is
right to.

So this is where lane lowering finds out how wide it may be. The answer used to
be all or nothing -- a tier without a 32-byte register class got no lanes, which
made plain x86-64 the target the whole lowering did nothing for. Now it gets half
as many lanes, and only a target too narrow for even the 16-byte pair gets none.

A target with no gang is still not an error and not a silent scalar body: it is a
refusal that names the tier, because the fix is either selecting a wider one or
accepting that this target runs the loop one iteration at a time.

Nothing here probes the machine by running anything. A tier is selected, not
discovered, because a build that measured the machine in front of it would
produce an artifact that only runs there.

The triples are `nupp.compiler.target_layout`'s. This does not invent a second
vocabulary for the same thing.
]]

local lane = require("nupp.compiler.aot.lane")
local targetLayout = require("nupp.compiler.target_layout")

local target = {}

--- The narrowest gang there is, in bytes.
---
--- A target whose widest register class is under this has no gang at all. There
--- is no 8-byte shape, and one would be a single binary64 lane, which is a
--- scalar loop with more machinery around it.
const target.NARROWEST_GANG = 16

--- The widest vector each CPU feature tier has a register class for.
---
--- A tier is a name for a set of instructions a build promises the machine has.
--- These are the only ones that matter here, because the only question this
--- module answers is how wide a value can be and still have somewhere to live.
const target.TIERS = {
    --- x86-64 as the architecture defines it: SSE2, 16-byte registers.
    ["baseline"] = 16,

    --- x86-64 with AVX2, where a 32-byte vector is one register.
    ["avx2"] = 32,

    --- aarch64, whose 16-byte NEON registers are mandatory rather than optional
    --- and which pairs them for a 32-byte value without an ABI question.
    ["neon"] = 32,
}

--- The tier a target gets when nothing selected one.
---
--- Conservative on x86-64 on purpose: a binary built for AVX2 does not run on a
--- machine without it, and a default that assumed otherwise would produce
--- artifacts that fail on hardware the triple says they support. Asking for
--- lanes there is asking for a tier.
const target.DEFAULT_TIERS = {["x86_64"] = "baseline", ["i686"] = "baseline", ["aarch64"] = "neon",}

--- One target the backend may compile for.
record target.Target
    --- The triple, from `target_layout`'s vocabulary.
    triple: string

    --- The architecture it names, which is what decides the tiers available.
    architecture: string

    --- The CPU feature tier this build promises.
    tier: string
end

--- The architecture one triple names.
function target.architecture(triple: string): string
    return triple:match("^([^-]+)") or triple
end

--- The tiers an architecture may select, widest last.
function target.tiers(architecture: string): {string}
    if architecture == "aarch64" then
        return {"neon"}
    end

    return {"baseline", "avx2"}
end

--- Selects a target, or says why it is not one.
---
--- @param triple the target triple, or nothing for the host's
--- @param tier the CPU feature tier, or nothing for the architecture's default
--- @return the target, or nothing and what was wrong with the request
function target.select(triple: string?, tier: string?): (target.Target?, string?)
    local named = triple or targetLayout.hostKey()
    if named == nil then
        return nil, "this host is not a modeled target; name one with --target"
    end
    if not targetLayout.has(named) then
        return nil, "unknown target " .. tostring(named)
    end

    local architecture = target.architecture(named as string)
    local selected = tier or target.DEFAULT_TIERS[architecture]
    if selected == nil then
        return nil, "no feature tier is known for " .. architecture
    end

    local available = target.tiers(architecture)
    local admitted = false
    for _, one in ipairs(available) do
        if one == selected then
            admitted = true
        end
    end
    if not admitted then
        return nil, (
            "%s has no feature tier %s; it has %s"
        ):format(architecture, tostring(selected), table.concat(available, ", "))
    end

    return new target.Target(triple = named as string, architecture = architecture, tier = selected as string), nil
end

--- The gangs this target can hold.
---
--- Every shape that fits in its widest register class. A tier with 16 bytes gets
--- the 16-byte pair rather than nothing: half the lanes is a smaller win than
--- the full width and a far larger one than compiling the loop an iteration at a
--- time.
---
--- A shape that does not fit is left out rather than split. A vector wider than
--- the register class still compiles, because the compiler splits it, but it has
--- no stable ABI at a function boundary -- and taking it anyway is how a gang
--- becomes a `-Wpsabi` warning in generated code.
function target.gangs(selected: target.Target): {lane.Shape}
    local widest = target.TIERS[selected.tier] or 0
    local held: {lane.Shape} = {}
    for _, shape in ipairs(lane.SHAPES) do
        if shape.bytes <= widest then
            held[#held + 1] = shape
        end
    end

    return held
end

--- Why this target has no gang, for a refusal that has to explain itself.
function target.noGangReason(selected: target.Target): string
    local wider: {string} = {}
    for _, one in ipairs(target.tiers(selected.architecture)) do
        if (target.TIERS[one] or 0) >= target.NARROWEST_GANG then
            wider[#wider + 1] = one
        end
    end
    if #wider == 0 then
        return (
            "%s has no %d-byte vector at any known feature tier"
        ):format(selected.architecture, target.NARROWEST_GANG)
    end

    return (
        "the %s feature tier has no %d-byte vector; select %s to run several iterations at once"
    ):format(selected.tier, target.NARROWEST_GANG, table.concat(wider, " or "))
end

return target
