--[[
The scalar half of the AOT IR.

One `@aot` body lowers to this: an admitted signature, the layouts its spans hold,
and structured scalar statements alongside any explicit vector operations.

There is one record per operation and `Expr` is their union, discriminated by
`op`, the way the concrete syntax tree is discriminated by `kind`. A pass that
dispatches on the tag is checked against the vocabulary rather than trusted with
it, and a module boundary that took `any` instead would put every one of these
rules back in the consumer's hands -- which the checker refuses at an exported
boundary, and is right to.

Numeric meaning is written down here rather than left to whatever a code
generator does. Ordinary Nupp arithmetic is binary64; `float`, `int32` and
`uint32` are storage and establishment facts, so a physical load widens and a
physical store narrows, and neither is an operator's business. The `f32_` and
`i32_` operations are the released fixed-width surface, where the source asked
for a width explicitly and the answer changes accordingly.

`Program.usesSimd` records explicit vector work. Target legalization sets
`Program.simdWidth` and `Program.vectorCeiling` before emission.
]]
module nupp.compiler.aot.scalar

--- What this vocabulary is on.
---
--- Carried in the IR and checked when it is read back, so an IR written by an
--- older compiler is refused rather than half-understood.
export const VERSION = 45

--- The calling convention selected for a complete AOT entry.
---
--- A kernel has no VM authority. A Lua builder is entered as a Lua C function
--- and may use only the construction operations represented below.
export type EntryMode = 'kernel' | 'lua-builder'

--- What the arithmetic in an admitted body means.
---
--- Separate from `VERSION`, which is the shape of the IR. Two compilers can
--- agree about every field of a program and disagree about whether an operator
--- contracts, and an artifact built under a contract must not be reused under
--- another. Bumped when the meaning changes, never when the spelling does.
export const NUMERIC_CONTRACT = 4

--- The symbol one `@aot` function exports.
---
--- Derived rather than chosen, and derived in one place, because the generated
--- code, the foreign declaration, and the layout reporters all have to agree
--- about it and none of them is in a position to check the others. A name
--- outside the canonical lower-camel form carries its source bytes, so distinct
--- names cannot collapse onto one snake-case symbol.
local function identifierTail(name: string): string
    local snake = name:gsub("(%u)(%u%l)", "%1_%2"):gsub("(%l)(%u)", "%1_%2")
    snake = snake:gsub("[^%w_]", "_"):lower()
    local canonical = snake:gsub("_([%l%d])", function(character: string): string
        return character:upper()
    end)
    if canonical == name then
        return snake
    end
    local encoded: {string} = {}
    for index = 1, #name do
        encoded[index] = ("%02x"):format(name:byte(index))
    end

    return snake .. "__" .. table.concat(encoded)
end

export function privateSymbol(name: string): string
    return "ks_" .. identifierTail(name)
end

--- The prefix every emitted symbol of one source file carries once it is
--- linked: the file's digest, so two modules' entries share one C namespace.
export function symbolPrefix(filename: string): string
    return "ks_" .. require("nupp.compiler.hash").digest(filename):sub(1, 16) .. "_"
end

--- An entry's symbol as the module declaring it links it: `privateSymbol`
--- under that module's prefix, which is how another module's native call
--- names it.
export function qualifiedPrivateSymbol(filename: string, name: string): string
    return symbolPrefix(filename) .. privateSymbol(name):sub(4)
end

--- `name` under `prefix`, spelled so it is a valid symbol: the unique name of
--- one local, which is not its source name because two source scopes may use
--- one name and generated code has no scope to tell them apart, and the names
--- a binding derives from a program's symbol.
export function identifier(prefix: string, name: string): string
    return prefix .. "_" .. name:gsub("[^%w_]", "_")
end

----------------------------------------------------------------------------
-- Sources and types
----------------------------------------------------------------------------

--- Where an operation came from, for a diagnostic that has to name it.
export record Source
    line: integer
    column: integer
end

--- The value types a scalar expression may have.
---
--- `f64` is what ordinary arithmetic produces. `f32`, `i32` and `u32` are
--- refinements a value has to have been established in, not spellings it may
--- claim. `bool` is what a comparison produces, and `multi` is a call with more
--- than one result, which only a multiple binding may consume.
export type Type = 'f64' | 'f32' | 'i32' | 'u32' | 'i64' | 'u64' | 'bool' | 'multi' | string

----------------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------------

--- A finite decimal literal, always binary64.
export record Constant
    op: 'constant'

    --- Kept as written, so the code generator reproduces the literal rather
    --- than a reformatting of it.
    value: string

    type: Type
    source: Source?
end

--- An exact integer literal, for a position that needs one.
export record IntConstant
    op: 'constant_i32'
    value: string
    type: Type
    source: Source?
end

--- An exact integer literal wider than the lane transform's 32-bit constants.
--- Introduced by partial evaluation only when binary64 represented the source
--- integer exactly, so the decimal spelling reaches LLVM IR without a second
--- round.
export record Int64Constant
    op: 'constant_i64'
    value: string
    type: 'i64' | 'u64'
    source: Source?
end

--- `true` or `false`.
export record Bool
    op: 'bool'
    value: boolean
    type: Type
    source: Source?
end

--- Lua nil, used as a primitive result or construction value.
export record LuaNil
    op: 'lua_nil'
    type: 'lua_nil'
    source: Source?
end

--- Bytes an admitted body reads that are known when it is compiled.
---
--- A `const` bound to a string literal, reached from inside the body. The code
--- generator writes these out as static data, so a table an author keeps in a
--- packed string is indexed as one rather than read back out of a rooted Lua
--- string the backend knows nothing about -- which is the difference between a
--- load it can align and fold and a `memcpy` from a pointer it cannot.
export record ConstantBytes
    --- The name the emitted array takes, which a read looks the bytes up by
    --- exactly as it does a rooted argument's. That is why nothing between
    --- here and the read had to learn about this.
    uniqueName: string

    value: string
end

----------------------------------------------------------------------------
-- Lua-owned values
----------------------------------------------------------------------------

--- A source string literal copied into ordinary Lua-owned storage.
export record LuaString
    op: 'lua_string'
    value: string
    type: 'lua_string'
    source: Source?
end

--- Compares a rooted string with literal bytes without allocating a case value.
export record LuaStringMatch
    op: 'lua_string_match'
    bytes: Expr
    value: string
    type: 'bool'
    source: Source?
end

--- Concatenates two ordinary Lua strings through the VM construction entry.
export record LuaConcat
    op: 'lua_concat'
    left: Expr
    right: Expr
    type: 'lua_string'
    source: Source?
end

--- Copies a Lua-style inclusive substring into ordinary Lua-owned storage.
export record LuaSubstring
    op: 'lua_substring'
    bytes: Expr
    first: Expr
    last: Expr?
    type: 'lua_string'
    source: Source?
end

--- Reads a Lua-style one-based byte from rooted string storage.
export record LuaStringByte
    op: 'lua_string_byte_lua'
    bytes: Expr
    index: Expr
    type: 'f64'
    source: Source?
end

--- Reads a numeric entry from a fresh, rooted Lua table.
export record LuaTableGet
    op: 'lua_table_get_index'
    table: Expr
    key: Expr
    type: 'f64'
    source: Source?
end

--- Starts a Lua-owned byte accumulator for an ordinary local string.
export record LuaStringBuffer
    op: 'lua_string_buffer'
    initial: Expr
    type: 'lua_string_buffer'
    source: Source?
end

--- Publishes a Lua-owned byte accumulator as a string.
export record LuaStringBufferFinish
    op: 'lua_string_buffer_finish'
    buffer: Expr
    type: 'lua_string'
    source: Source?
end

--- An authored field of a fresh table literal.
export record LuaField
    key: Expr
    value: Expr
    indexed: boolean
    source: Source?
end

--- A fresh, unpublished Lua table rooted on the native entry's Lua stack.
---
--- This is an effectful expression and is consequently admitted only as the
--- value of a `let`. The verifier rejects it anywhere a code generator could
--- evaluate it twice or move it across another allocation.
export record LuaNewTable
    op: 'lua_new_table'
    arrayCapacity: Expr
    hashCapacity: Expr
    fields: {LuaField}?
    type: 'lua_table'
    source: Source?
end

--- Starts a bounded, stack-rooted stream of ordinary Lua values.
---
--- The handle is native construction state, not a Lua value. It may be used
--- only by the value-stream statements below and finished exactly once.
export record LuaBuilder
    op: 'lua_builder'
    mode: 'eager' | 'pull' | 'serde'
    nullValue: Expr
    maxDepth: Expr?
    stringCapacity: Expr?
    arrayMarker: Expr?
    objectMarker: Expr?
    selectionShape: Expr?
    arrayShapeMarker: Expr?
    serdeMarkers: Expr?
    type: 'lua_builder'
    source: Source?
end

--- A bounded, stack-rooted native uint32 work buffer.
---
--- The handle is local construction state. Its storage is Lua-owned userdata,
--- so a builder entry may use it across allocations without exposing a raw
--- pointer to Nupp source.
export record LuaScratchU32
    op: 'lua_scratch_u32'
    capacity: Expr

    --- The word count, where the buffer is fixed: every word readable and
    --- writable from the moment it exists, so its bound is this number rather
    --- than a length that grows. Absent for an appending buffer.
    ---
    --- What this buys is not a check removed -- the check is still emitted, and
    --- still refuses an index outside the buffer. It is that the bound stops
    --- being a load. A write through the buffer may alias its length field as
    --- far as the optimizer can tell, so it reloads the bound after every
    --- store; a constant it cannot alias, and it discharges the comparison
    --- itself wherever the index is a counted loop's.
    ---
    --- That is worth more than deleting the checks. Ablated on `bench/sha256`
    --- when AOT code was still compiled through C: 0.847x the hand-written C
    --- as emitted, 0.919x with the checks gone entirely, 0.940x with them kept
    --- against a literal bound.
    fixed: integer?

    type: 'lua_scratch_u32'
    source: Source?
end

--- Reads a word from a local native scratch buffer.
export record LuaScratchU32Get
    op: 'lua_scratch_u32_get' | 'lua_scratch_u32_escape_get'
    scratch: Expr
    index: Expr

    --- A zero-based local authorized by a dominating comparison against this
    --- scratch's tracked initialized length. When present, emission reads the
    --- word directly; the verifier re-establishes the proof from the branch.
    cursor: string?

    cursorUniqueName: string?

    --- The fixed buffer's word count, carried to the access so the emitted
    --- comparison names a constant.
    fixedBound: integer?

    type: 'u32'
    source: Source?
end

--- Reads the initialized length of a local word scratch.
export record LuaScratchU32Length
    op: 'lua_scratch_u32_length' | 'lua_scratch_u32_escape_length'
    scratch: Expr
    type: 'u32'
    source: Source?
end

export record LuaScratchU8
    op: 'lua_scratch_u8'
    capacity: Expr

    --- The byte count, where the buffer is fixed: every byte readable and
    --- writable from the moment it exists, so its bound is this number rather
    --- than a length that grows. Absent for an appending buffer.
    ---
    --- What it buys is what the same field buys on a word buffer -- a bound the
    --- optimizer can discharge rather than a field it has to reload after every
    --- store -- and one thing more, because a byte buffer's storage is
    --- allocated per call where a word buffer's small enough was already
    --- inline: a fixed capacity is a literal, so the storage can be a stack
    --- array in the entry and nothing is allocated at all. `bench/sha256` put
    --- the two together at about a hundred nanoseconds of a short digest.
    fixed: integer?

    type: 'lua_scratch_u8'
    source: Source?
end

export record LuaScratchU8Get
    op: 'lua_scratch_u8_get'
    scratch: Expr
    index: Expr

    --- The fixed buffer's byte count, carried to the access so the emitted
    --- comparison names a constant.
    fixedBound: integer?

    type: 'u32'
    source: Source?
end

--- Reads rooted Lua string storage without creating a substring.
export record LuaBytes
    op: 'lua_string_byte' | 'lua_string_byte_at' | 'lua_string_u32' | 'lua_string_length'
    bytes: Expr
    index: Expr?
    cursor: string?
    cursorUniqueName: string?
    type: 'u32'
    source: Source?
end

--- Publishes the single completed value produced by a stream builder.
export record LuaBuilderFinish
    op: 'lua_builder_finish'
    builder: Expr
    mode: 'eager' | 'pull' | 'serde'
    type: 'lua_value'
    source: Source?
end

--- Inspects the current container of a direct value stream.
export record LuaBuilderQuery
    op: 'lua_builder_depth' | 'lua_builder_kind' | 'lua_builder_count' | 'lua_builder_state'
    builder: Expr
    mode: 'eager' | 'pull' | 'serde'
    type: 'u32'
    source: Source?
end

--- Validates, converts, and publishes a complete JSON number token.
---
--- The low 31 bits are the byte position at which parsing stopped. Bit 31 is set
--- on success and clear on a grammar error, so source can preserve its normal
--- error-position contract without splitting the fused native operation.
export record LuaBuilderNumberToken
    op: 'lua_builder_number_token'
    builder: Expr
    mode: 'eager' | 'pull' | 'serde'
    sourceBytes: Expr
    start: Expr
    limit: Expr
    type: 'u32'
    source: Source?
end

----------------------------------------------------------------------------
-- Reads
----------------------------------------------------------------------------

--- A local, a uniform parameter, or a helper's parameter.
---
--- Three operations rather than one because they are emitted differently and
--- because only a local may be assigned to.
export record Name
    op: 'local' | 'uniform' | 'helper_param'
    name: string

    --- The name this takes in generated code, which is not the source name: two
    --- source scopes may use one name and generated code has no scope to tell
    --- them apart.
    uniqueName: string?

    mutable: boolean?
    lengthOf: string?
    builderMode: ('eager' | 'pull' | 'serde')?
    type: Type
    source: Source?
end

--- The checked count of a span parameter.
export record SpanCount
    op: 'span_count'
    span: string
    type: 'f64'
    source: Source?
end

--- The one-based index of the top-level map iteration.
---
--- CPU emission runs its physical loop zero-based and GPU emission receives a
--- zero-based dispatch position. Keeping the authored value explicit in IR is
--- what makes both backends add one at the same semantic boundary.
export record LoopIndex
    op: 'loop_index'
    type: 'f64'
    source: Source?
end

--- The zero-based workgroup and local-lane coordinates of a phased GPU entry.
export record WorkgroupIndex
    op: 'workgroup_index' | 'local_index'
    type: 'u32'
    source: Source?
end

--- A value read from statically sized workgroup scratch.
export record SharedLoad
    op: 'shared_load'
    shared: string
    index: Expr
    type: Type
    source: Source?
end

--- An element of a span holding scalars.
export record Load
    op: 'load'
    span: string

    --- The loop index. Only the loop's own consecutive index is admitted.
    index: string

    indexUniqueName: string?

    --- A zero-based append/read cursor authorized by a dominating
    --- `cursor < #span` branch. The source access is `cursor + 1`, or
    --- `cursor + k` with `cursorOffset` holding `k - 1`.
    cursor: string?

    cursorUniqueName: string?

    --- How far past the cursor the element lies, zero-based: the literal `k -
    --- 1` of a source access `cursor + k`. Absent for `cursor + 1`. The
    --- dominating check has to have bounded the cursor that many elements
    --- further below the span's count, which `scalarIR.CursorBounds` records
    --- as the room.
    cursorOffset: integer?

    type: Type
    sourceType: string?
    source: Source?
end

--- A pointer to an element of a span holding reified structs.
export record ElementRef
    op: 'element_ref'
    span: string
    index: string
    indexUniqueName: string?
    cursor: string?
    cursorUniqueName: string?
    cursorOffset: integer?
    layout: string

    --- Whether this element may be written, which follows from whether its span
    --- was declared exclusive.
    mutable: boolean

    type: Type
    source: Source?
end

--- A field of a struct element.
export record FieldLoad
    op: 'field_load'
    object: Expr
    layout: string
    field: string
    type: Type
    sourceType: string?
    source: Source?
end

----------------------------------------------------------------------------
-- Operators
----------------------------------------------------------------------------

--- Binary64 arithmetic, and the comparisons over it.
---
--- Not contracted and not reassociated: `a * b + c` is two roundings unless the
--- source asked for one, because an AOT function's answer should be a property
--- of what was written rather than of the target that compiled it.
export type BinaryOp = 'add'
    | 'sub'
    | 'mul'
    | 'div'
    | 'mod'
    | 'pow'
    | 'lt'
    | 'le'
    | 'gt'
    | 'ge'
    | 'eq'
    | 'ne'
    | 'and'
    | 'or'
    | 'band'
    | 'bor'
    | 'bxor'
    | 'lshift'
    | 'rshift'
    | 'arshift'

export record Binary
    op: BinaryOp
    left: Expr
    right: Expr
    type: Type
    source: Source?
end

--- Negation, logical negation, and bitwise complement.
export type UnaryOp = 'neg' | 'not' | 'bnot'

export record Unary
    op: UnaryOp
    value: Expr
    type: Type
    source: Source?
end

--- An operation from the closed math set.
export record Math
    op: 'math'
    intrinsic: string
    args: {Expr}
    type: Type
    source: Source?
end

--- An explicitly binary32 or wrapping fixed-width integer operation.
---
--- A binary32 operation over binary32 operands computed in binary64 and rounded
--- once is bit-identical to the native single-precision instruction, because 53
--- is at least twice 24 plus 2. That is what lets these lower directly rather
--- than being a relaxation. `f32_min`, `f32_max` and `f32_fma` are not covered by
--- that argument and carry a correction instead.
export type FixedOp = 'f32_add'
    | 'f32_sub'
    | 'f32_mul'
    | 'f32_div'
    | 'i32_add'
    | 'i32_sub'
    | 'i32_mul'
    | 'u32_add'
    | 'u32_sub'
    | 'u32_mul'
    | 'u32_div'
    | 'u32_mod'
    | 'u32_and'
    | 'u32_or'
    | 'u32_xor'
    | 'u32_shl'
    | 'u32_shr'
    | 'i32_rotl'
    | 'i32_rotr'
    | 'u32_rotl'
    | 'u32_rotr'
    | 'i64_add'
    | 'i64_sub'
    | 'i64_mul'
    | 'i64_div'
    | 'i64_mod'
    | 'i64_pow'
    | 'i64_and'
    | 'i64_or'
    | 'i64_xor'
    | 'i64_shl'
    | 'i64_shr'
    | 'i64_sar'
    | 'u64_add'
    | 'u64_sub'
    | 'u64_mul'
    | 'u64_div'
    | 'u64_mod'
    | 'u64_pow'
    | 'u64_and'
    | 'u64_or'
    | 'u64_xor'
    | 'u64_shl'
    | 'u64_shr'
    | 'u64_sar'
    | 'u64_rotl'
    | 'u64_rotr'

export record Fixed
    op: FixedOp
    left: Expr
    right: Expr
    type: Type
    source: Source?
end

--- Fixed-width operations that take one operand.
export type FixedUnaryOp = 'f32_sqrt'
    | 'f32_exp'
    | 'u32_not'
    | 'u32_popcount'
    | 'u32_ctz'
    | 'u32_clz'
    | 'i64_not'
    | 'u64_not'
    | 'u64_popcount'
    | 'u64_ctz'
    | 'u64_clz'
    | 'u64_prefix_xor'

export record FixedUnary
    op: FixedUnaryOp
    value: Expr
    type: Type
    source: Source?
end

--- `min`, `max` and `fma`, through the helper that repairs their NaN behaviour.
export type CorrectedOp = 'f32_min' | 'f32_max' | 'f32_fma'

export record Corrected
    op: CorrectedOp

    --- Present for the two-operand forms.
    left: Expr?

    right: Expr?

    --- Present for the three-operand form.
    args: {Expr}?

    type: Type
    source: Source?
end

----------------------------------------------------------------------------
-- Conversions and calls
----------------------------------------------------------------------------

--- A conversion between representations.
---
--- These are where a width changes, and the only places it does. An operator
--- never changes one, which is what keeps `float` a storage fact rather than an
--- arithmetic type.
---
--- `numeric_cast` from binary64 to a 32-bit integer is `wrap`, LuaJIT's
--- `tobit`, which rounds. `store_cast` is what a physical store of a binary64
--- into an integer field or span element does instead, LuaJIT's FFI rule:
--- truncate toward zero through `int64`, then keep the low bits. The two differ
--- on every fraction, so they are two operations rather than one read two ways.
export type ConvertOp = 'narrow_f64_f32'
    | 'widen_f32_f64'
    | 'int_to_f64'
    | 'numeric_cast'
    | 'store_cast'
    | 'f32_from_bits'
    | 'f32_to_bits'
    | 'f16_to_f32'
    | 'f32_to_f16'
    | 'bf16_to_f32'
    | 'f32_to_bf16'

export record Convert
    op: ConvertOp
    value: Expr
    type: Type
    source: Source?
end

--- A call to a visible pure helper.
--- A native-only aggregate built from one value per field, in layout order.
--- A value, as the vectors it holds are: there is no store into it, and a
--- change is a new aggregate.
export record AggregateNew
    op: 'aggregate_new'
    layout: string
    values: {Expr}
    type: Type
    source: Source?
end

--- One field of a native-only aggregate value.
export record AggregateField
    op: 'aggregate_field'
    object: Expr
    layout: string
    field: string
    type: Type
    source: Source?
end

export record HelperCall
    op: 'helper_call'
    helper: string
    uniqueName: string
    args: {Expr}

    --- One entry per result. More than one makes the call's own type `multi`.
    resultTypes: {Type}?

    type: Type
    source: Source?
end

--- A source-visible SIMD operation. Its abstract vector and mask types are
--- specialized to the selected artifact tier only when code is generated.
export record Simd
    op: 'simd_species'
        | 'simd_lanes_generic'
        | 'simd_splat'
        | 'simd_iota'
        | 'simd_tail'
        | 'simd_load'
        | 'simd_store'
        | 'simd_binary'
        | 'simd_unary'
        | 'simd_compare'
        | 'simd_select'
        | 'simd_mask_any'
        | 'simd_mask_all'
        | 'simd_mask_count'
        | 'simd_mask_first'
        | 'simd_mask_bits'
        | 'simd_extract'
        | 'simd_insert'
        | 'simd_permute'
        | 'simd_convert'
        | 'simd_reinterpret'
        | 'simd_compress'
        | 'simd_expand'
        | 'simd_prefix'
        | 'simd_horizontal'
        | 'simd_mask_splat'
        | 'simd_mask_convert'
        | 'simd_field_load'
        | 'simd_field_store'
        | 'simd_call'
        | 'simd_math'
    args: {Expr}
    span: string?
    intrinsic: string?

    --- On a `simd_load` through a rooted byte view, the string or buffer
    --- parameter whose pointer and length the load addresses. `span` names that
    --- same parameter, because it is what the bounds proof is stated against;
    --- this carries the `uniqueName` the code generator writes, which a copy of the
    --- parameter would not share.
    rooted: Name?

    --- On `simd_field_load` and `simd_field_store`, the reified layout of the
    --- span's element and the field each lane reaches within it.
    layout: string?

    field: string?

    --- On `simd_call`, the generated name of the pure helper applied per lane.
    helper: string?

    --- On a `simd_load` or `simd_store` at `cursor + 1`, the cursor a
    --- dominating `cursor + species.lanes <= #span` bounded, so the whole
    --- vector is in the span and the access is one copy with no lane check.
    cursor: string?

    cursorUniqueName: string?

    --- On a `simd_load` of `loadPairs`, `loadTriples` or `loadQuads`, which
    --- of the interleaved runs this result is, from zero. Each result is a
    --- load of the whole run in its own right.
    part: integer?

    type: Type
    source: Source?
end

--- Creates a closed reducer before its authored SIMD region.
export record ReducerInit
    op: 'reducer_init'
    order: 'ordered' | 'pairwise' | 'algebraic' | 'compensated' | 'exact' | 'integer' | 'propagating' | 'number'
    operation: 'sum'
        | 'product'
        | 'dot'
        | 'and'
        | 'or'
        | 'xor'
        | 'any'
        | 'all'
        | 'count'
        | 'min'
        | 'max'
        | 'argmin'
        | 'argmax'
    initial: Expr
    type: Type
    source: Source?
end

--- Contributes exactly once for one logical outer iteration.
---
--- It is expression-shaped only so a source method call can travel through the
--- ordinary call-statement lowering. Its `lua_effect` result is never read.
export record ReducerAdd
    op: 'reducer_add'
    reducer: Expr
    value: Expr
    right: Expr?
    order: 'ordered' | 'pairwise' | 'algebraic' | 'compensated' | 'exact' | 'integer' | 'propagating' | 'number'
    operation: 'sum'
        | 'product'
        | 'dot'
        | 'and'
        | 'or'
        | 'xor'
        | 'any'
        | 'all'
        | 'count'
        | 'min'
        | 'max'
        | 'argmin'
        | 'argmax'
    type: 'lua_effect'
    source: Source?
end

--- A masked vector contribution to a reducer, inside a `reducer_region`.
---
--- Active lanes contribute in ascending lane order; inactive lanes contribute
--- nothing. A reducer takes at most one contribution per region iteration.
export record VectorReducerAdd
    op: 'simd_reducer_add'
    reducer: Expr
    value: Expr
    mask: Expr
    right: Expr?
    order: 'ordered' | 'pairwise' | 'algebraic' | 'compensated' | 'exact' | 'integer' | 'propagating' | 'number'
    operation: 'sum'
        | 'product'
        | 'dot'
        | 'and'
        | 'or'
        | 'xor'
        | 'any'
        | 'all'
        | 'count'
        | 'min'
        | 'max'
        | 'argmin'
        | 'argmax'
    element: string?
    type: 'lua_effect'
    source: Source?
end

--- A reducer a `reducer_region` accumulates.
export record ReducerRegionAccumulator
    name: string
    uniqueName: string
    order: 'ordered' | 'pairwise' | 'algebraic' | 'compensated' | 'exact' | 'integer' | 'propagating' | 'number'
    operation: 'sum'
        | 'product'
        | 'dot'
        | 'and'
        | 'or'
        | 'xor'
        | 'any'
        | 'all'
        | 'count'
        | 'min'
        | 'max'
        | 'argmin'
        | 'argmax'
    element: string?

    --- The vector type of every contribution the region makes to it.
    vectorType: Type
end

--- The scope of a reducer's vector contributions.
---
--- A parallel order may hold a vector accumulator across the region and fold
--- it into the scalar state once the region ends; every other order folds
--- each contribution lane by lane where it is made. Either way the scalar
--- state is current when the region ends.
export record ReducerRegion
    op: 'reducer_region'
    body: {Statement}
    reducers: {ReducerRegionAccumulator}
    source: Source?
end

--- Consumes the scalar result after the reducer's SIMD region.
export record ReducerValue
    op: 'reducer_value'
    reducer: Expr
    order: 'ordered' | 'pairwise' | 'algebraic' | 'compensated' | 'exact' | 'integer' | 'propagating' | 'number'
    operation: 'sum'
        | 'product'
        | 'dot'
        | 'and'
        | 'or'
        | 'xor'
        | 'any'
        | 'all'
        | 'count'
        | 'min'
        | 'max'
        | 'argmin'
        | 'argmax'
    type: Type
    source: Source?
end

----------------------------------------------------------------------------
-- Every expression
----------------------------------------------------------------------------

--- Every scalar expression.
export type Expr = Constant
    | IntConstant
    | Int64Constant
    | Bool
    | LuaNil
    | LuaString
    | LuaStringMatch
    | LuaConcat
    | LuaSubstring
    | LuaStringByte
    | LuaTableGet
    | LuaStringBuffer
    | LuaStringBufferFinish
    | LuaNewTable
    | LuaBuilder
    | LuaScratchU32
    | LuaScratchU32Get
    | LuaScratchU32Length
    | LuaScratchU8
    | LuaScratchU8Get
    | LuaBytes
    | LuaBuilderFinish
    | LuaBuilderQuery
    | LuaBuilderNumberToken
    | LuaBuild
    | LuaScratchU32Set
    | LuaScratchU8Set
    | Name
    | SpanCount
    | LoopIndex
    | WorkgroupIndex
    | SharedLoad
    | Load
    | ElementRef
    | FieldLoad
    | AggregateNew
    | AggregateField
    | Binary
    | Unary
    | Math
    | Fixed
    | FixedUnary
    | Corrected
    | Convert
    | HelperCall
    | Simd
    | ReducerInit
    | ReducerAdd
    | VectorReducerAdd
    | ReducerValue

----------------------------------------------------------------------------
-- Assignments
----------------------------------------------------------------------------

--- Where a
--- element reached through a span.
export record Target
    kind: 'local' | 'field'
    name: string?
    uniqueName: string?
    object: Expr?
    layout: string?
    field: string?
    type: Type?
    sourceType: string?
end

--- A target and the value going into it.
export record Assignment
    target: Target
    value: Expr
end

--- Declaring a local.
export record Let
    op: 'let'
    name: string
    uniqueName: string
    value: Expr
    type: Type

    --- Whether an `assign` anywhere after this declaration targets the name.
    --- Absent, the binding is a value: nothing in the body changes it, so a
    --- fact established about it holds until the name goes out of scope, and
    --- a pass may substitute its value without asking what else writes it.
    --- Present, it is a variable, and every reader treats an assignment to it
    --- as the end of what it knew. Lowering sets it from the body it produced;
    --- the verifier refuses an `assign` to a name whose `let` does not say so.
    assigned: boolean?

    source: Source?
end

--- A local a loop carries from one iteration into the next: bound before
--- the loop and assigned somewhere in its body, so the value entering an
--- iteration is whatever the previous one left. The loop names these once so
--- that no reader has to scan the body to learn which facts its entry
--- retires; a name not listed here is the same on every iteration.
export record Carried
    name: string
    uniqueName: string
    type: Type
end

--- A name the body introduced, as the environment records it.
---
--- Not an expression: reading one produces a `local`, and this is what that
--- `local` was resolved against.
export record Binding
    kind: 'local'
    name: string
    uniqueName: string
    type: Type

    --- Whether what it was bound to may be written through, which is how a
    --- name bound to `getMut(i)` stays writable at its uses.
    mutable: boolean?

    --- Whether an `assign` after the binding targets the name; the same flag
    --- as `Let.assigned`, for a name a `multi_let` or a `fornum` binds.
    assigned: boolean?

    lengthOf: string?
    builderMode: ('eager' | 'pull' | 'serde')?

    source: Source?
end

--- One binding per result of a call that returns several.
export record MultiLet
    op: 'multi_let'
    call: HelperCall
    bindings: {Binding}
    source: Source?
end

--- Simultaneous assignment: every value computed before any is stored.
export record Assign
    op: 'assign'
    values: {Assignment}
    source: Source?
end

--- Storing through a span that holds scalars.
export record Store
    op: 'store'
    span: string
    index: string
    indexUniqueName: string?
    cursor: string?
    cursorUniqueName: string?
    cursorOffset: integer?
    value: Expr
    source: Source?
end

--- A raw-equivalent write into a fresh unpublished Lua table.
---
--- The target remains a rooted logical handle. The code generator maps it to a
--- Lua stack slot and uses the public raw-set API, which performs the VM
--- barrier without invoking a metatable.
export record LuaSet
    op: 'lua_set_index' | 'lua_set_key'
    table: Expr
    key: Expr
    value: Expr
    source: Source?
end

--- Appends a string expression to a Lua-owned byte accumulator.
export record LuaStringBufferAppend
    op: 'lua_string_buffer_append'
    buffer: Expr
    value: Expr
    source: Source?
end

--- A direct construction event applied to a bounded value stream.
---
--- `sourceBytes`, `start`, `length`, and `escaped` belong to string/key and
--- number-slice events. `value` belongs to boolean/number events. `capacity`
--- belongs to container openings. Keeping one record makes the legal shapes
--- explicit in the verifier while avoiding an open-ended call opcode.
export record LuaBuild
    op: 'lua_builder_open_array'
        | 'lua_builder_open_object'
        | 'lua_builder_key'
        | 'lua_builder_string'
        | 'lua_builder_number'
        | 'lua_builder_number_slice'
        | 'lua_builder_integer_slice'
        | 'lua_builder_integer64'
        | 'lua_builder_decimal64'
        | 'lua_builder_boolean'
        | 'lua_builder_null'
        | 'lua_builder_close'
        | 'lua_builder_key_scratch'
        | 'lua_builder_string_scratch'
        | 'lua_builder_key_escapes'
        | 'lua_builder_string_escapes'
    builder: Expr
    mode: 'eager' | 'pull' | 'serde'
    sourceBytes: Expr?
    start: Expr?
    length: Expr?
    escaped: Expr?
    value: Expr?
    negative: Expr?
    exponent: Expr?
    exact: Expr?
    capacity: Expr?
    scratch: Expr?
    escapeScratch: Expr?
    escapeIndex: Expr?
    escapeCount: Expr?
    type: 'lua_effect'
    source: Source?
end

--- Writes a word in a local native scratch buffer.
export record LuaScratchU32Set
    op: 'lua_scratch_u32_set'
    scratch: Expr
    index: Expr

    --- The fixed buffer's word count. See the read above.
    fixedBound: integer?

    value: Expr
    type: 'lua_effect'
    source: Source?
end

export record LuaScratchU8Set
    op: 'lua_scratch_u8_set' | 'lua_scratch_u8_set4' | 'lua_scratch_u8_reset'
    scratch: Expr
    index: Expr?

    --- The fixed buffer's byte count. See the read above.
    fixedBound: integer?

    value: Expr?
    type: 'lua_effect'
    source: Source?
end

----------------------------------------------------------------------------
-- Control flow
----------------------------------------------------------------------------

--- An arm of a conditional.
--- The cursor bounds a branch or loop condition proves for its body, by
--- cursor and then by span: `cursorBounds[cursor][span]` is the room the
--- condition established below the span's count -- a decimal `"k"` for k
--- elements, `"1"` from `cursor < #span` and `"k"` from the exact `cursor + k
--- - 1 < #span` or `cursor + k <= #span`, or the species type whose lane count
--- fits, from `cursor + species.lanes <= #span`. A `species@N` room records N
--- vectors, from an exact `cursor + N * species.lanes <= #span` guard, and
--- also covers derived offsets strictly below N vectors. Every vector bound
--- implies at least N elements, so `span[cursor + k]` is proven under either
--- kind of room once the room reaches k, which `simdbounds.elements` counts.
export type CursorBounds = {[string]: {[string]: string}}

--- The room a one-element bound records.
export const ONE_ELEMENT = "1"

--- How a cursor's room below one span's count carries to another's: from
--- the guard-proved `factor * #from <= #to + offset`, a cursor `r` elements
--- below `#from` is `factor * r - offset` elements below `#to`, because it
--- is no less than zero. A plain `#from <= #to` is the transfer with factor
--- one and offset zero.
export record RoomTransfer
    factor: integer
    offset: integer
end

--- Every proved transfer, by the span a cursor is bounded against and then
--- by the span the bound carries to.
export type RoomTransfers = {[string]: {[string]: {RoomTransfer}}}

--- An arm of a conditional.
export record Clause
    condition: Expr
    body: {Statement}
    cursorBounds: CursorBounds?
    source: Source?
end

export record If
    op: 'if'
    clauses: {Clause}
    elseBody: {Statement}?
    source: Source?
end

export record While
    op: 'while'

    --- Statements evaluated immediately before each condition, in the
    --- enclosing loop-control scope (and the repeat body's local scope).
    conditionBody: {Statement}?

    condition: Expr
    body: {Statement}

    --- The outer locals the body assigns; see `scalarIR.Carried`. The verifier
    --- holds it to exactly that set, so it is trusted rather than recomputed.
    carried: {Carried}

    cursorBounds: CursorBounds?
    source: Source?
end

--- A post-tested loop. The condition is the source `until` condition, so the
--- body repeats while it is false.
export record Repeat
    op: 'repeat'

    --- Statements evaluated immediately before each condition, in the
    --- enclosing loop-control scope (and the repeat body's local scope).
    conditionBody: {Statement}?

    condition: Expr
    body: {Statement}
    carried: {Carried}
    source: Source?
end

export record Fornum
    op: 'fornum'
    binding: Binding
    from: Expr
    to: Expr
    body: {Statement}

    --- Accumulators and cursors the body advances. The induction variable is
    --- not among them: it is the loop's own, bound afresh each iteration.
    carried: {Carried}

    --- The span whose count is this loop's inclusive upper bound. Present only
    --- when `from` is a constant integer of at least one and `to` is that
    --- span's checked count; it is the proof that accesses through this
    --- induction variable are in bounds.
    boundSpan: string?

    source: Source?
end

export record Block
    op: 'block'
    body: {Statement}
    source: Source?
end

--- Leaving the enclosing loop, or the current iteration of it.
---
--- Two records rather than one with two tags, because a tag that could be either
--- narrows to neither.
export record Break
    op: 'break'
    source: Source?
end

export record Continue
    op: 'continue'
    source: Source?
end

--- Returning from a general block kernel.
export record Return
    op: 'return'
    values: {Expr}
    source: Source?
end

--- A structurally disjoint write to workgroup scratch. Admission requires
--- `index` to be the stage's exact `local_index` expression.
export record SharedStore
    op: 'shared_store'
    shared: string
    index: Expr
    value: Expr
    source: Source?
end

--- A stage in a workgroup controller. Each backend completes the body for
--- every local lane before any lane enters the following statement.
export record Phase
    op: 'phase'
    body: {Statement}
    source: Source?
end

--- Every scalar statement.
---
--- `Simd` is here because some SIMD operations write rather than produce:
--- `simd_store` carries `lua_effect` and stands where a statement stands.
--- Admitting it makes that sayable rather than merely emitted.
export type Statement = Simd
    | ReducerAdd
    | VectorReducerAdd
    | ReducerRegion
    | Let
    | MultiLet
    | Assign
    | Store
    | LuaSet
    | LuaStringBufferAppend
    | LuaBuild
    | LuaScratchU32Set
    | LuaScratchU8Set
    | SharedStore
    | Phase
    | If
    | While
    | Repeat
    | Fornum
    | Block
    | Break
    | Continue
    | Return

----------------------------------------------------------------------------
-- Layouts and parameters
----------------------------------------------------------------------------

--- A stored field of a reified struct.
export record Field
    name: string
    type: Type

    --- The physical source storage. It differs from `type` for narrow integer
    --- fields, whose loads establish i32/u32 values and whose stores narrow.
    sourceType: string?

    source: Source?
end

--- A reified struct a span holds elements of.
---
--- The `uniqueName` is carried rather than derived, so the generated binding and the
--- generated code cannot disagree about what to call it.
export record Layout
    name: string
    uniqueName: string
    fields: {Field}

    --- The same fields by name, filled in when the layout is verified so a
    --- later lookup is one index rather than a scan.
    fieldTypes: {[string]: Type}?

    --- The physical storage spellings by field name.
    fieldSourceTypes: {[string]: string}?

    source: Source?

    --- A native-only aggregate rather than storage: its fields are vectors,
    --- masks, scalars or other such aggregates, typed as the values they are,
    --- and it is laid out by the code generator, never in memory a span holds.
    nativeOnly: boolean?
end

--- An atom a guard relation is stated about.
---
--- An atom and nothing else: every constant a source comparison wrote is folded
--- into the relation's offset instead, so two source forms of one fact normalize to
--- one relation rather than to two that differ in where the constant sits.
---
--- `zero` is the origin every literal is measured from, `uniform` names an
--- integer parameter, and `count` names a span whose length the term is.
export record Term
    kind: 'zero' | 'uniform' | 'count'

    --- The parameter or span named, absent for `zero`.
    name: string?

    --- A literal the span's count is multiplied by, for a `count` term only:
    --- `3 * #grey`. Absent for the count itself. Never below two, since a
    --- factor of one is the count.
    factor: integer?
end

--- A normalized relation the source guards established, `left <= right + offset`.
---
--- Every admitted comparison becomes one of these, or two for an equality. The
--- wrapper checks exactly this list and nothing else about bounds, which is what
--- makes a guard stronger than the loop needs stay stronger: the relation the
--- source wrote is the relation the caller is held to.
export record Relation
    left: Term
    right: Term
    offset: integer
    source: Source?
end

--- A range the source guarded, proved in bounds before lowering.
---
--- The generated loop reads it rather than checking it again, which is only
--- sound because the guard was checked and not merely written. The check itself
--- moves to the generated wrapper, where it runs once per call rather than once
--- per element.
export record RangeGuard
    first: string
    last: string

    --- The span the range is a range of, whose length the wrapper compares
    --- against.
    count: string

    source: Source?
end

--- The source view and checked field represented by a private column parameter.
export record SoaColumn
    --- Authored parameter and type, shared by every column of this view.
    view: string

    sourceType: string
    layout: string
    field: string
    ordinal: integer
end

--- A parameter of an admitted signature.
---
--- `type` is the physical storage the code generator and the foreign
--- declaration use; `sourceType` preserves the authored type in the checked
--- wrapper.
export record Param
    kind: 'write_span' | 'read_span' | 'uniform' | 'scalar'
    name: string
    type: Type
    sourceType: string?

    --- The checked span module whose ownership contract admitted this parameter.
    --- Native and Wasm spans share the IR memory semantics but not their runtime
    --- pointer representation, so the binding must preserve this distinction.
    spanModule: string?

    --- A scalar column expanded from an authored SoA row-view parameter.
    soa: SoaColumn?

    --- Uniforms use their parameter's unique name; Lua-builder scalars use
    --- their positive VM stack index.
    uniqueName: string?

    --- Spans only: the borrow region this parameter is, which alias facts and
    --- region declarations refer to by name.
    region: string?

    --- What the body may do through it, which follows from the borrow.
    access: ('read' | 'readwrite')?

    --- Which borrow the source wrote, so the region declaration can cite it.
    ownership: ('exclusive' | 'shared')?

    --- What a span holds, as the front end admitted it. Carried so a load
    --- through this span does not have to parse the written type again.
    element: any?

    source: Source?
end

--- A span's borrow, restated as something the backend can name.
export record Region
    id: string
    param: string
    access: 'read' | 'readwrite'

    --- The borrow this region's access was derived from, carried so the claim
    --- can be checked rather than assumed.
    proof: string

    source: Source?
end

--- What ownership settled about one pair of regions.
---
--- Two shared borrows may overlap; anything involving an exclusive one may not.
--- This is where that becomes a fact the optimizer is allowed to use, and the
--- verifier requires the matrix to be complete rather than partial: a pair with
--- no fact would be a pair whose `noalias` nobody justified.
export record AliasFact
    relation: 'disjoint' | 'may_alias'
    left: string
    right: string
    proof: 'exclusive_borrow' | 'shared_borrows' | 'soa_columns'
end

--- A length agreement the source proved between two spans.
export record Guard
    op: 'equal_count'
    left: string
    right: string
    source: Source?
end

--- A visible pure helper the body may call.
export record Helper
    name: string
    uniqueName: string
    params: {Name}

    --- One expression per result. A helper is a return list and nothing else,
    --- which is what makes inlining it sound. Empty for a
    --- native call, which has no body here to inline.
    values: {Expr}

    --- Whether this names another compiled entry rather than a body to inline.
    --- The call becomes an ordinary native call to that entry's own symbol, so
    --- the callee is compiled once and keeps its own contract.
    native: boolean?

    --- A native call into another module's entry: its symbol already carries
    --- that module's qualification, so this unit's must not be applied to it.
    qualified: boolean?

    resultTypes: {Type}

    source: Source?
end

--- The single loop an admitted body is.
---
--- `first` is `1` for a whole span and the name of a proved bound otherwise.
export record Loop
    index: string
    first: integer | string
    last: string

    --- The span whose length bounds the loop, which is the primary output.
    count: string

    statements: {Statement}
    source: Source?
end

--- A statically allocated workgroup scratch array.
export record Shared
    name: string
    element: Type
    count: integer
    initial: Expr
    source: Source?
end

--- A uniformly structured workgroup controller. Its statements include
--- `phase` nodes; loops and branches around them are uniform by verification.
export record Workgroup
    prelude: {Statement}
    groups: Expr
    dispatchSpan: string
    size: integer
    shared: {Shared}
    statements: {Statement}
    source: Source?
end

----------------------------------------------------------------------------
-- A whole program
----------------------------------------------------------------------------

--- A whole admitted `@aot` function.
---
--- Everything downstream -- the generated code, the generated wrapper, the
--- verifier -- is written from this and only this, so none of them can disagree
--- about what the function is.
export record Program
    --- Target runtime semantics for numeric-for entry. Absent generic IR uses
    --- binary64 progression without LuaJIT dual-number normalization.
    numericForRuntime: string?

    --- Captured before SIMD rewriting can erase authored loops.
    numericForRuntimeRequired: boolean?

    --- Bumped when the shape changes, so an IR written by an older compiler is
    --- refused rather than half-understood.
    version: integer

    name: string
    symbol: string

    --- The private ABI. Omitted IR from version 5 and earlier is refused by the
    --- version check rather than being guessed here.
    entryMode: EntryMode

    --- The execution family selected by the source annotation. CPU is the
    --- established native path; GPU programs are consumed by a shader emitter.
    executionTarget: ('cpu' | 'gpu')?

    --- The single stream-builder contract proved for this entry. Unlike the
    --- VM ABI, this is a compile-time fact consumed by emission; it is absent
    --- for kernels and VM-aware entries which do not use a value stream.
    builderMode: ('eager' | 'pull' | 'serde')?

    --- The byte scratch this entry may take from the reuse cache, by its
    --- unique name, or nothing when none may.
    ---
    --- A reused buffer is handed back where the entry publishes it, which is
    --- only sound when nothing writes it afterwards. That is a fact about this
    --- program, so it is proved once here and verified, rather than decided by
    --- the backend that consumes it. `visit.reusableScratch` is the derivation
    --- and the verifier re-runs it.
    reusableScratch: string?

    --- The public runtime ABI family required by a VM-aware entry.
    runtimeAbi: string?

    --- The exported registrar which returns the Lua C closure.
    registrar: string?

    params: {Param}
    layouts: {Layout}?
    regions: {Region}
    aliasFacts: {AliasFact}

    --- The facts the source guards stated, normalized, in a canonical order.
    ---
    --- The wrapper's contract. `guards` and `rangeGuard` below are claims proved
    --- from these, so a claim that does not follow from this list fails
    --- verification rather than reaching a backend.
    relations: {Relation}?

    guards: {Guard}
    helpers: {Helper}?

    --- Compile-time byte tables the body reads, in the order they were reached.
    constants: {ConstantBytes}?

    --- The original map-shaped form, or a general structured scalar body.
    --- Exactly one is present. Keeping the map form preserves its established
    --- private ABI while block kernels grow independently.
    loop: Loop?

    workgroup: Workgroup?

    body: {Statement}?

    --- Top-level scalar results. Empty is the existing `nil` ABI; several use
    --- one compiler-owned native result aggregate at the private boundary.
    resultTypes: {Type}?

    resultSourceTypes: {string}?

    --- Whether the source used the explicit SIMD vocabulary.
    usesSimd: boolean?

    --- The entry's signature carries a vector or a mask, so it is callable
    --- only from other native code: it gets no Lua wrapper, no entry in
    --- `__nuppAotCompiled`, and its declaration lowers to a stub that refuses
    --- a Lua call. The checker has already refused every such call it could
    --- see; the stub is what a dynamic one meets.
    nativeOnly: boolean?

    --- The preferred vector width selected for this target.
    simdWidth: integer?

    --- The widest vector any value in this program may be built out of, when
    --- the target's frame cannot carry whatever its registers can hold. The
    --- species width is already held to it; this is what a flat vector formed
    --- inside an operation is held to as well -- a lane conversion's, which
    --- spans the whole species however wide that species is.
    vectorCeiling: integer?

    rangeGuard: RangeGuard?

    --- Whether the source asked for fused multiply-add. Part of what the
    --- function returns rather than only how fast it gets there, which is why
    --- it travels with the IR rather than with the build.
    fpContract: boolean?

    --- Whether explicit fixed-width transcendentals may use the target's
    --- native implementation rather than the IR-owned operation sequence.
    fpTranscendentals: boolean?

    source: Source?
end

--- Whether two column parameters originate in the same authored row view.
--- Whether a value of this IR type may exist only in native code: a vector
--- or a mask. A species is a compile-time fact and a reducer is a region, so
--- neither is a value an entry could take or answer at all.
--- Whether a layout field holds a stored vector: `Fixed<N>` of a storage
--- element, laid out by the target layout model with an alignment of its own,
--- which is what the compiled object then reports beside the field's offset
--- and size.
export function storedVectorField(field: Field): boolean
    return tostring(field.type):match("^simd_vector_") ~= nil
end

--- Whether a layout holds a stored vector field.
export function holdsStoredVector(layout: Layout): boolean
    for _, field in ipairs(layout.fields) do
        if storedVectorField(field) then
            return true
        end
    end

    return false
end

export function nativeOnlyType(typeName: Type?): boolean
    local name = tostring(typeName)

    return name:match("^simd_vector_") ~= nil or name:match("^simd_mask_") ~= nil or name:match("^aggregate:") ~= nil
end

--- The layout an `aggregate:<name>` type names, or nil for any other type.
export function aggregateLayout(typeName: Type?): string?
    return tostring(typeName):match("^aggregate:(.+)$")
end

export function sameSoaView(left: Param?, right: Param?): boolean
    return left ~= nil
        and right ~= nil
        and left.soa ~= nil
        and right.soa ~= nil
        and left.soa.view == right.soa.view
        and left.soa.layout == right.soa.layout
end

local function exactIntegerText(text: string): number?
    local sign, body = text:match("^([+-]?)(.+)$")
    if body == nil then
        sign, body = "", text
    end
    local mantissa, exponentText = (body as string):match("^([^eE]+)[eE]([+-]?%d+)$")
    if mantissa == nil then
        mantissa, exponentText = body, "0"
    end
    local whole, fraction = (mantissa as string):match("^(%d*)%.(%d*)$")
    if whole == nil then
        whole = (mantissa as string):match("^(%d+)$")
        fraction = ""
    end
    if whole == nil or (whole == "" and fraction == "") then
        return nil
    end
    local exponent = tonumber(exponentText)
    if exponent == nil or exponent % 1 ~= 0 or math.abs(exponent) > 100000 then
        return nil
    end
    local digits = (whole as string) .. (fraction as string)
    local decimal = #(whole as string) + exponent
    if decimal < #digits then
        if digits:sub(decimal + 1):match("[^0]") ~= nil then
            return nil
        end
        digits = decimal > 0 and digits:sub(1, decimal) or "0"
    elseif decimal > #digits then
        digits = digits .. string.rep("0", decimal - #digits)
    end
    digits = digits:gsub("^0+", "")
    if digits == "" then
        digits = "0"
    end
    local limit = "9007199254740992"
    if #digits > #limit or (#digits == #limit and digits > limit) then
        return nil
    end

    return tonumber((sign as string) .. digits)
end

--- The integer a literal node denotes, when it denotes one exactly within
--- binary64's contiguous integers; nil for any other node.
export function exactInteger(node: Expr): number?
    if node.op ~= "constant" and node.op ~= "constant_i32" and node.op ~= "constant_i64" then
        return nil
    end
    return exactIntegerText(tostring((node as any).value))
end

--- Whether `param` is a span the entry receives as a pointer and a count.
export function isSpan(param: Param): boolean
    return param.kind == "write_span" or param.kind == "read_span"
end

--- Whether the native ABI carries independent span/view counts.
---
--- A block kernel always does. A map kernel may share its primary count only
--- when guards relate every other span to it; cursor-only spans retain their
--- independent counts so the generated body can check them.
export function independentCounts(program: Program): boolean
    if program.body ~= nil or program.workgroup ~= nil then
        return true
    end
    local spans = 0
    for _, param in ipairs(program.params) do
        if isSpan(param) then
            spans = spans + 1
        end
    end

    return #program.guards < spans - 1
end
