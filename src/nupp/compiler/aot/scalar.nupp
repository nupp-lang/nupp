--[[
The scalar half of the AOT IR.

One `@aot` body lowers to this: an admitted signature, the layouts its spans hold,
and one loop over them. It is what the lane rewrite reads and what a body that
declined lane lowering is emitted from directly.

There is one record per operation and `Expr` is their union, discriminated by
`op`, the way the concrete syntax tree is discriminated by `kind`. A pass that
dispatches on the tag is checked against the vocabulary rather than trusted with
it, and a module boundary that took `any` instead would put every one of these
rules back in the consumer's hands -- which `--strict` refuses outright, and is
right to.

Numeric meaning is written down here rather than left to whatever a C compiler
does. Ordinary Nupp arithmetic is binary64; `float`, `int32` and `uint32` are
storage and establishment facts, so a physical load widens and a physical store
narrows, and neither is an operator's business. The `f32_` and `i32_` operations
are the released fixed-width surface, where the source asked for a width
explicitly and the answer changes accordingly.
]]

local scalarIR = {}

--- What this vocabulary is on.
---
--- Carried in the IR and checked when it is read back, so an IR written by an
--- older compiler is refused rather than half-understood.
const scalarIR.VERSION = 3

--- The C symbol one `@aot` function exports.
---
--- Derived rather than chosen, and derived in one place, because the generated
--- C, the foreign declaration, and the layout reporters all have to agree about
--- it and none of them is in a position to check the others.
function scalarIR.privateSymbol(name: string): string
    local snake = name:gsub("(%u)(%u%l)", "%1_%2"):gsub("(%l)(%u)", "%1_%2")

    return "ks_" .. snake:gsub("[^%w_]", "_"):lower()
end

--- The C name of one local, which is not its source name: two source scopes may
--- use one name and C has no scope to tell them apart.
function scalarIR.cIdentifier(prefix: string, name: string): string
    return prefix .. "_" .. name:gsub("[^%w_]", "_")
end

--- Where an operation came from, for a diagnostic that has to name it.
record scalarIR.Source
    line: integer
    column: integer
end

--- The value types a scalar expression may have.
---
--- `f64` is what ordinary arithmetic produces. `f32`, `i32` and `u32` are
--- refinements a value has to have been established in, not spellings it may
--- claim. `bool` is what a comparison produces, and `multi` is a call with more
--- than one result, which only a multiple binding may consume.
type scalarIR.Type = 'f64' | 'f32' | 'i32' | 'u32' | 'bool' | 'multi' | string

--- A finite decimal literal, always binary64.
record scalarIR.Constant
    op: 'constant'

    --- Kept as written, so the emitter reproduces the literal rather than a
    --- reformatting of it.
    value: string

    type: scalarIR.Type
    source: scalarIR.Source?
end

--- An exact integer literal, for a position that needs one.
record scalarIR.IntConstant
    op: 'constant_i32'
    value: string
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- `true` or `false`.
record scalarIR.Bool
    op: 'bool'
    value: boolean
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A local, a uniform parameter, or a helper's parameter.
---
--- Three operations rather than one because they are emitted differently and
--- because only a local may be assigned to.
record scalarIR.Name
    op: 'local' | 'uniform' | 'helper_param'
    name: string

    --- The name this takes in generated C, which is not the source name: two
    --- source scopes may use one name and C has no scope to tell them apart.
    cName: string?

    mutable: boolean?
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- One element of a span holding scalars.
record scalarIR.Load
    op: 'load'
    span: string

    --- The loop index. Consecutive access is the whole of the lane rewrite's
    --- licence to run several iterations at once, so nothing else is admitted.
    index: string

    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A pointer to one element of a span holding reified structs.
record scalarIR.ElementRef
    op: 'element_ref'
    span: string
    index: string
    layout: string

    --- Whether this element may be written, which follows from whether its span
    --- was declared exclusive.
    mutable: boolean

    type: scalarIR.Type
    source: scalarIR.Source?
end

--- One field of a struct element.
record scalarIR.FieldLoad
    op: 'field_load'
    object: scalarIR.Expr
    layout: string
    field: string
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- Binary64 arithmetic, and the comparisons over it.
---
--- Not contracted and not reassociated: `a * b + c` is two roundings unless the
--- source asked for one, because an AOT function's answer should be a property
--- of what was written rather than of the target that compiled it.
record scalarIR.Binary
    op: 'add'
        | 'sub'
        | 'mul'
        | 'div'
        | 'mod'
        | 'pow'
        | 'lt'
        | 'le'
        | 'gt'
        | 'ge'
        | 'eq'
        | 'ne'
        | 'and'
        | 'or'
        | 'band'
        | 'bor'
        | 'bxor'
        | 'lshift'
        | 'rshift'
        | 'arshift'
    left: scalarIR.Expr
    right: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- Negation, logical negation, and bitwise complement.
record scalarIR.Unary
    op: 'neg' | 'not' | 'bnot'
    value: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- One operation from the closed math set.
record scalarIR.Math
    op: 'math'
    intrinsic: string
    args: {scalarIR.Expr}
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- One explicitly binary32 or wrapping int32 operation.
---
--- A binary32 operation over binary32 operands computed in binary64 and rounded
--- once is bit-identical to the native single-precision instruction, because 53
--- is at least twice 24 plus 2. That is what lets these lower directly rather
--- than being a relaxation. `f32_min`, `f32_max` and `f32_fma` are not covered by
--- that argument and carry a correction instead.
record scalarIR.Fixed
    op: 'f32_add' | 'f32_sub' | 'f32_mul' | 'f32_div' | 'i32_add' | 'i32_sub' | 'i32_mul'
    left: scalarIR.Expr
    right: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- `nupp.math.f32.sqrt`, which takes one operand.
record scalarIR.FixedUnary
    op: 'f32_sqrt'
    value: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- `min`, `max` and `fma`, through the helper that repairs their NaN behaviour.
record scalarIR.Corrected
    op: 'f32_min' | 'f32_max' | 'f32_fma'

    --- Present for the two-operand forms.
    left: scalarIR.Expr?

    right: scalarIR.Expr?

    --- Present for the three-operand form.
    args: {scalarIR.Expr}?

    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A conversion between representations.
---
--- These are where a width changes, and the only places it does. An operator
--- never changes one, which is what keeps `float` a storage fact rather than an
--- arithmetic type.
record scalarIR.Convert
    op: 'narrow_f64_f32' | 'widen_f32_f64' | 'int_to_f64' | 'numeric_cast'
    value: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A call to a visible pure helper.
record scalarIR.HelperCall
    op: 'helper_call'
    helper: string
    cName: string
    args: {scalarIR.Expr}

    --- One entry per result. More than one makes the call's own type `multi`.
    resultTypes: {scalarIR.Type}?

    type: scalarIR.Type
    source: scalarIR.Source?
end

--- Every scalar expression.
type scalarIR.Expr = scalarIR.Constant
    | scalarIR.IntConstant
    | scalarIR.Bool
    | scalarIR.Name
    | scalarIR.Load
    | scalarIR.ElementRef
    | scalarIR.FieldLoad
    | scalarIR.Binary
    | scalarIR.Unary
    | scalarIR.Math
    | scalarIR.Fixed
    | scalarIR.FixedUnary
    | scalarIR.Corrected
    | scalarIR.Convert
    | scalarIR.HelperCall

--- Where one assignment puts its value: a local, or one field of a struct
--- element reached through a span.
record scalarIR.Target
    kind: 'local' | 'field'
    name: string?
    cName: string?
    object: scalarIR.Expr?
    layout: string?
    field: string?
    type: scalarIR.Type?
end

--- One target and the value going into it.
record scalarIR.Assignment
    target: scalarIR.Target
    value: scalarIR.Expr
end

--- Declaring a local.
record scalarIR.Let
    op: 'let'
    name: string
    cName: string
    value: scalarIR.Expr
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A name the body introduced, as the environment records it.
---
--- Not an expression: reading one produces a `local`, and this is what that
--- `local` was resolved against.
record scalarIR.Binding
    kind: 'local'
    name: string
    cName: string
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- One binding per result of a call that returns several.
record scalarIR.MultiLet
    op: 'multi_let'
    call: scalarIR.HelperCall
    bindings: {scalarIR.Binding}
    source: scalarIR.Source?
end

--- Simultaneous assignment: every value computed before any is stored.
record scalarIR.Assign
    op: 'assign'
    values: {scalarIR.Assignment}
    source: scalarIR.Source?
end

--- Storing through a span that holds scalars.
record scalarIR.Store
    op: 'store'
    span: string
    index: string
    value: scalarIR.Expr
    source: scalarIR.Source?
end

--- One arm of a conditional.
record scalarIR.Clause
    condition: scalarIR.Expr
    body: {scalarIR.Statement}
    source: scalarIR.Source?
end

record scalarIR.If
    op: 'if'
    clauses: {scalarIR.Clause}
    elseBody: {scalarIR.Statement}?
    source: scalarIR.Source?
end

record scalarIR.While
    op: 'while'
    condition: scalarIR.Expr
    body: {scalarIR.Statement}
    source: scalarIR.Source?
end

record scalarIR.Fornum
    op: 'fornum'
    binding: scalarIR.Binding
    from: scalarIR.Expr
    to: scalarIR.Expr
    body: {scalarIR.Statement}
    source: scalarIR.Source?
end

record scalarIR.Block
    op: 'block'
    body: {scalarIR.Statement}
    source: scalarIR.Source?
end

--- Leaving the enclosing loop, or the current iteration of it.
---
--- Two records rather than one with two tags, because a tag that could be either
--- narrows to neither.
record scalarIR.Break
    op: 'break'
    source: scalarIR.Source?
end

record scalarIR.Continue
    op: 'continue'
    source: scalarIR.Source?
end

--- Every scalar statement.
type scalarIR.Statement = scalarIR.Let
    | scalarIR.MultiLet
    | scalarIR.Assign
    | scalarIR.Store
    | scalarIR.If
    | scalarIR.While
    | scalarIR.Fornum
    | scalarIR.Block
    | scalarIR.Break
    | scalarIR.Continue

--- One stored field of a reified struct.
record scalarIR.Field
    name: string
    type: scalarIR.Type
    source: scalarIR.Source?
end

--- A reified struct a span holds elements of.
---
--- The C name is carried rather than derived, so the generated module and the
--- generated C cannot disagree about what to call it.
record scalarIR.Layout
    name: string
    cName: string
    fields: {scalarIR.Field}

    --- The same fields by name, filled in when the layout is verified so a
    --- later lookup is one index rather than a scan.
    fieldTypes: {[string]: scalarIR.Type}?

    source: scalarIR.Source?
end

--- A range the source guarded, proved in bounds before lowering.
---
--- The generated loop reads it rather than checking it again, which is only
--- sound because the guard was checked and not merely written. The check itself
--- moves to the generated wrapper, where it runs once per call rather than once
--- per element.
record scalarIR.RangeGuard
    first: string
    last: string

    --- The span the range is a range of, whose length the wrapper compares
    --- against.
    count: string

    source: scalarIR.Source?
end

--- One parameter of an admitted signature.
---
--- Two types rather than one. `type` is what the value is physically, which the
--- generated C and the foreign declaration agree on; `sourceType` is how the
--- source spelled it, which the generated wrapper's own signature keeps so a
--- caller sees the type it wrote rather than the ABI underneath it.
record scalarIR.Param
    kind: 'write_span' | 'read_span' | 'uniform' | 'scalar'
    name: string
    type: scalarIR.Type
    sourceType: string?

    --- Spans only: the borrow region this parameter is, which alias facts and
    --- region declarations refer to by name.
    region: string?

    --- What the body may do through it, which follows from the borrow.
    access: ('read' | 'readwrite')?

    --- Which borrow the source wrote, so the region declaration can cite it.
    ownership: ('exclusive' | 'shared')?

    source: scalarIR.Source?
end

--- One span's borrow, restated as something the backend can name.
record scalarIR.Region
    id: string
    param: string
    access: 'read' | 'readwrite'

    --- The borrow this region's access was derived from, carried so the claim
    --- can be checked rather than assumed.
    proof: string

    source: scalarIR.Source?
end

--- What ownership settled about one pair of regions.
---
--- Two shared borrows may overlap; anything involving an exclusive one may not.
--- This is where that becomes a fact the C compiler is allowed to use, and the
--- verifier requires the matrix to be complete rather than partial: a pair with
--- no fact would be a pair whose `restrict` nobody justified.
record scalarIR.AliasFact
    relation: 'disjoint' | 'may_alias'
    left: string
    right: string
    proof: 'exclusive_borrow' | 'shared_borrows'
end

--- A length agreement the source proved between two spans.
record scalarIR.Guard
    op: 'equal_count'
    left: string
    right: string
    source: scalarIR.Source?
end

--- One visible pure helper the body may call.
record scalarIR.Helper
    name: string
    cName: string
    params: {scalarIR.Name}

    --- One expression per result. A helper is a return list and nothing else,
    --- which is what makes inlining it into a lane body sound.
    values: {scalarIR.Expr}

    resultType: scalarIR.Type
    resultTypes: {scalarIR.Type}
    source: scalarIR.Source?
end

--- The single loop an admitted body is.
---
--- `first` is `1` for a whole span and the name of a proved bound otherwise.
record scalarIR.Loop
    index: string
    first: integer | string
    last: string

    --- The span whose length bounds the loop, which is the primary output.
    count: string

    statements: {scalarIR.Statement}
    source: scalarIR.Source?
end

--- The lane-parallel rewrite of the loop body, when one was made and kept.
record scalarIR.LaneBody
    lanes: integer
    shape: string
    statements: {any}
end

--- One whole admitted `@aot` function.
---
--- Everything downstream -- the generated C, the generated wrapper, the
--- verifier -- is written from this and only this, so none of them can disagree
--- about what the function is.
record scalarIR.Program
    --- Bumped when the shape changes, so an IR written by an older compiler is
    --- refused rather than half-understood.
    version: integer

    name: string
    symbol: string
    params: {scalarIR.Param}
    layouts: {scalarIR.Layout}?
    regions: {scalarIR.Region}
    aliasFacts: {scalarIR.AliasFact}
    guards: {scalarIR.Guard}
    helpers: {scalarIR.Helper}?
    loop: scalarIR.Loop
    rangeGuard: scalarIR.RangeGuard?
    lanes: scalarIR.LaneBody?

    --- Whether lane lowering was asked for at all, which is separate from
    --- whether one was produced.
    wantsLanes: boolean?

    --- Whether the source asked for fused multiply-add. Part of what the
    --- function answers rather than only how fast it gets there, which is why
    --- it travels with the IR rather than with the build.
    fpContract: boolean?

    source: scalarIR.Source?
end

return scalarIR
