module nupp.compiler.aot.visit

--[[
An exhaustive walk over the closed AOT vocabularies.

IR can arrive through a decoded artifact without record metatables, so nominal
`is` tests are not a sound dispatch mechanism. Each typed entry switches on its
complete literal tag union with no `else`, and every arm names the node's typed
children. Adding an opcode therefore fails this module's check until its shape
is handled; adding a field cannot quietly disappear into a generic table walk.
]]

local lane = require("nupp.compiler.aot.lane")
local scalarIR = require("nupp.compiler.aot.scalar")

local visit = {}

type visit.ScalarRewrite = function(scalarIR.Expr): scalarIR.Expr

record visit.Visitor
    scalarExpression: (function(scalarIR.Expr): nil)?
    scalarStatement: (function(scalarIR.Statement): nil)?
    laneExpression: (function(lane.Expr): nil)?
    laneStatement: (function(lane.Statement): nil)?
    laneTarget: (function(lane.Target): nil)?
end

local scalarExpression: function(scalarIR.Expr, visit.Visitor): nil
local scalarStatement: function(scalarIR.Statement, visit.Visitor): nil
local laneExpression: function(lane.Expr, visit.Visitor): nil
local laneStatement: function(lane.Statement, visit.Visitor): nil

local function rewriteExpressions(values: {scalarIR.Expr}, rewrite: visit.ScalarRewrite): nil
    for position, value in ipairs(values) do
        values[position] = rewrite(value)
    end
end

local function rewriteOptional(value: scalarIR.Expr?, rewrite: visit.ScalarRewrite): scalarIR.Expr?
    if value ~= nil then
        return rewrite(value as scalarIR.Expr)
    end

    return nil
end

local function builderEvent(node: scalarIR.LuaBuild, rewrite: visit.ScalarRewrite): nil
    node.builder = rewrite(node.builder)
    node.sourceBytes = rewriteOptional(node.sourceBytes, rewrite)
    node.start = rewriteOptional(node.start, rewrite)
    node.length = rewriteOptional(node.length, rewrite)
    node.escaped = rewriteOptional(node.escaped, rewrite)
    node.value = rewriteOptional(node.value, rewrite)
    node.negative = rewriteOptional(node.negative, rewrite)
    node.exponent = rewriteOptional(node.exponent, rewrite)
    node.exact = rewriteOptional(node.exact, rewrite)
    node.capacity = rewriteOptional(node.capacity, rewrite)
    node.scratch = rewriteOptional(node.scratch, rewrite)
    node.escapeScratch = rewriteOptional(node.escapeScratch, rewrite)
    node.escapeIndex = rewriteOptional(node.escapeIndex, rewrite)
    node.escapeCount = rewriteOptional(node.escapeCount, rewrite)
end

local function scratchU32Set(node: scalarIR.LuaScratchU32Set, rewrite: visit.ScalarRewrite): nil
    node.scratch = rewrite(node.scratch)
    node.index = rewrite(node.index)
    node.value = rewrite(node.value)
end

local function scratchU8Set(node: scalarIR.LuaScratchU8Set, rewrite: visit.ScalarRewrite): nil
    node.scratch = rewrite(node.scratch)
    node.index = rewriteOptional(node.index, rewrite)
    node.value = rewriteOptional(node.value, rewrite)
end

--- Rewrites each direct scalar-expression child exactly once.
---
--- This is the single owner of scalar expression shape. Analyses use an
--- identity callback; transformations return replacement children.
function visit.expressionChildren(node: scalarIR.Expr, rewrite: visit.ScalarRewrite): nil
    return switch node.op do
        case "constant", "constant_i32", "constant_i64", "bool", "lua_nil", "lua_string", "local", "uniform", "helper_param", "span_count", "load", "element_ref" -> nil
        case "lua_concat" -> do
            local value = node as scalarIR.LuaConcat
            value.left = rewrite(value.left)
            value.right = rewrite(value.right)
            yield nil
        end
        case "lua_substring" -> do
            local value = node as scalarIR.LuaSubstring
            value.bytes = rewrite(value.bytes)
            value.first = rewrite(value.first)
            value.last = rewriteOptional(value.last, rewrite)
            yield nil
        end
        case "lua_string_byte_lua" -> do
            local value = node as scalarIR.LuaStringByte
            value.bytes = rewrite(value.bytes)
            value.index = rewrite(value.index)
            yield nil
        end
        case "lua_table_get_index" -> do
            local value = node as scalarIR.LuaTableGet
            value.table = rewrite(value.table)
            value.key = rewrite(value.key)
            yield nil
        end
        case "lua_string_buffer" -> do
            local value = node as scalarIR.LuaStringBuffer
            value.initial = rewrite(value.initial)
            yield nil
        end
        case "lua_string_buffer_finish" -> do
            local value = node as scalarIR.LuaStringBufferFinish
            value.buffer = rewrite(value.buffer)
            yield nil
        end
        case "lua_new_table" -> do
            local value = node as scalarIR.LuaNewTable
            value.arrayCapacity = rewrite(value.arrayCapacity)
            value.hashCapacity = rewrite(value.hashCapacity)
            for _, field in ipairs(value.fields or {}) do
                field.key = rewrite(field.key)
                field.value = rewrite(field.value)
            end
            yield nil
        end
        case "lua_tree" -> do
            local value = node as scalarIR.LuaTree
            value.nodes = rewrite(value.nodes)
            value.links = rewrite(value.links)
            value.sourceBytes = rewrite(value.sourceBytes)
            value.root = rewrite(value.root)
            value.nullValue = rewrite(value.nullValue)
            yield nil
        end
        case "lua_builder" -> do
            local value = node as scalarIR.LuaBuilder
            value.nullValue = rewrite(value.nullValue)
            value.maxDepth = rewriteOptional(value.maxDepth, rewrite)
            value.stringCapacity = rewriteOptional(value.stringCapacity, rewrite)
            value.arrayMarker = rewriteOptional(value.arrayMarker, rewrite)
            value.objectMarker = rewriteOptional(value.objectMarker, rewrite)
            value.selectionShape = rewriteOptional(value.selectionShape, rewrite)
            value.arrayShapeMarker = rewriteOptional(value.arrayShapeMarker, rewrite)
            value.serdeMarkers = rewriteOptional(value.serdeMarkers, rewrite)
            yield nil
        end
        case "lua_scratch_u32" -> do
            local value = node as scalarIR.LuaScratchU32
            value.capacity = rewrite(value.capacity)
            yield nil
        end
        case "lua_scratch_u8" -> do
            local value = node as scalarIR.LuaScratchU8
            value.capacity = rewrite(value.capacity)
            yield nil
        end
        case "lua_scratch_u32_get", "lua_scratch_u32_escape_get" -> do
            local value = node as scalarIR.LuaScratchU32Get
            value.scratch = rewrite(value.scratch)
            value.index = rewrite(value.index)
            yield nil
        end
        case "lua_scratch_u8_get" -> do
            local value = node as scalarIR.LuaScratchU8Get
            value.scratch = rewrite(value.scratch)
            value.index = rewrite(value.index)
            yield nil
        end
        case "lua_scratch_u32_length", "lua_scratch_u32_escape_length" -> do
            local value = node as scalarIR.LuaScratchU32Length
            value.scratch = rewrite(value.scratch)
            yield nil
        end
        case "lua_scratch_u32_append_bits", "lua_scratch_u32_append_bits_eager" -> do
            local value = node as scalarIR.LuaScratchU32AppendBits
            value.scratch = rewrite(value.scratch)
            value.index = rewrite(value.index)
            value.base = rewrite(value.base)
            value.bits = rewrite(value.bits)
            yield nil
        end
        case "lua_scratch_u32_append_string_bits" -> do
            local value = node as scalarIR.LuaScratchU32AppendStringBits
            value.scratch = rewrite(value.scratch)
            value.escapeScratch = rewriteOptional(value.escapeScratch, rewrite)
            value.index = rewrite(value.index)
            value.base = rewrite(value.base)
            value.events = rewrite(value.events)
            value.quotes = rewrite(value.quotes)
            value.slashes = rewrite(value.slashes)
            value.slashCarry = rewriteOptional(value.slashCarry, rewrite)
            value.slashOdd = rewriteOptional(value.slashOdd, rewrite)
            value.inString = rewrite(value.inString)
            value.stringEscaped = rewrite(value.stringEscaped)
            yield nil
        end
        case "lua_string_byte", "lua_string_byte_at", "lua_string_u32", "lua_string_length" -> do
            local value = node as scalarIR.LuaBytes
            value.bytes = rewrite(value.bytes)
            value.index = rewriteOptional(value.index, rewrite)
            yield nil
        end
        case "lua_builder_finish" -> do
            local value = node as scalarIR.LuaBuilderFinish
            value.builder = rewrite(value.builder)
            yield nil
        end
        case "lua_builder_depth", "lua_builder_kind", "lua_builder_count", "lua_builder_state" -> do
            local value = node as scalarIR.LuaBuilderQuery
            value.builder = rewrite(value.builder)
            yield nil
        end
        case "lua_builder_number_token" -> do
            local value = node as scalarIR.LuaBuilderNumberToken
            value.builder = rewrite(value.builder)
            value.sourceBytes = rewrite(value.sourceBytes)
            value.start = rewrite(value.start)
            value.limit = rewrite(value.limit)
            yield nil
        end
        case "lua_builder_open_array", "lua_builder_open_object", "lua_builder_key", "lua_builder_string", "lua_builder_number", "lua_builder_number_slice", "lua_builder_integer_slice", "lua_builder_integer64", "lua_builder_decimal64", "lua_builder_boolean", "lua_builder_null", "lua_builder_close", "lua_builder_key_scratch", "lua_builder_string_scratch", "lua_builder_key_escapes", "lua_builder_string_escapes" -> builderEvent(
            node as scalarIR.LuaBuild,
            rewrite
        )
        case "lua_scratch_u32_set" -> scratchU32Set(node as scalarIR.LuaScratchU32Set, rewrite)
        case "lua_scratch_u8_set", "lua_scratch_u8_set4", "lua_scratch_u8_reset" -> scratchU8Set(
            node as scalarIR.LuaScratchU8Set,
            rewrite
        )
        case "field_load" -> do
            local value = node as scalarIR.FieldLoad
            value.object = rewrite(value.object)
            yield nil
        end
        case "add", "sub", "mul", "div", "mod", "pow", "lt", "le", "gt", "ge", "eq", "ne", "and", "or", "band", "bor", "bxor", "lshift", "rshift", "arshift" -> do
            local value = node as scalarIR.Binary
            value.left = rewrite(value.left)
            value.right = rewrite(value.right)
            yield nil
        end
        case "f32_add", "f32_sub", "f32_mul", "f32_div", "i32_add", "i32_sub", "i32_mul", "u32_add", "u32_sub", "u32_mul", "u32_and", "u32_or", "u32_xor", "u32_shl", "u32_shr", "i64_add", "i64_sub", "i64_mul", "u64_add", "u64_sub", "u64_mul" -> do
            local value = node as scalarIR.Fixed
            value.left = rewrite(value.left)
            value.right = rewrite(value.right)
            yield nil
        end
        case "neg", "not", "bnot" -> do
            local value = node as scalarIR.Unary
            value.value = rewrite(value.value)
            yield nil
        end
        case "f32_sqrt", "u32_not", "u32_popcount", "u32_ctz", "u32_clz" -> do
            local value = node as scalarIR.FixedUnary
            value.value = rewrite(value.value)
            yield nil
        end
        case "narrow_f64_f32", "widen_f32_f64", "int_to_f64", "numeric_cast" -> do
            local value = node as scalarIR.Convert
            value.value = rewrite(value.value)
            yield nil
        end
        case "math" -> rewriteExpressions((node as scalarIR.Math).args, rewrite)
        case "helper_call" -> rewriteExpressions((node as scalarIR.HelperCall).args, rewrite)
        case "f32_min", "f32_max", "f32_fma" -> do
            local value = node as scalarIR.Corrected
            value.left = rewriteOptional(value.left, rewrite)
            value.right = rewriteOptional(value.right, rewrite)
            rewriteExpressions(value.args or {}, rewrite)
            yield nil
        end
        case "simd_species_u8", "simd_lanes", "simd_load_u8", "simd_load_string_u8", "simd_load_stride3_u8", "simd_splat_u8", "simd_shr_u8", "simd_shl_u8", "simd_table_u8x16", "simd_lookup16_u8", "simd_lookup64_u8", "simd_store4_u8", "simd_align_bytes_u8", "simd_padded_string_u8", "simd_padded_length", "simd_padded_full_length", "simd_padded_tail_length", "simd_padded_load_full_u8", "simd_padded_load_tail_u8", "simd_block64_load_u8", "simd_block64_and_byte_u8", "simd_block64_and_u8", "simd_block64_shr_u8", "simd_block64_lookup16_u8", "simd_block64_any_bits_u8", "simd_block64_last_u8", "simd_block64_utf8_errors_u8", "simd_block64_eq_u8", "simd_block64_eq_any6_u8", "simd_block64_range_u8", "simd_block64_outside_range_u8", "simd_tail_u8", "simd_eq_u8", "simd_range_u8", "simd_vec_and", "simd_vec_or", "simd_vec_xor", "simd_vec_not", "simd_mask_and", "simd_mask_or", "simd_mask_xor", "simd_mask_not", "simd_select_u8", "simd_any", "simd_all", "simd_count", "simd_bits", "simd_mask64", "simd_mask64_add", "simd_mask64_and", "simd_mask64_or", "simd_mask64_xor", "simd_mask64_not", "simd_mask64_shl", "simd_mask64_shr", "simd_mask64_prefix_xor", "simd_mask64_low", "simd_mask64_high", "simd_mask64_any", "simd_mask64_count", "simd_mask64_first", "simd_mask64_clear_first" -> rewriteExpressions(
            (node as scalarIR.Simd).args,
            rewrite
        )
    end
end

scalarExpression = function(node: scalarIR.Expr, visitor: visit.Visitor): nil
    local callback = visitor.scalarExpression
    if callback ~= nil then
        callback(node)
    end
    visit.expressionChildren(node, function(child: scalarIR.Expr): scalarIR.Expr
        scalarExpression(child, visitor)
        return child
    end)
end

local function scalarExpressions(values: {scalarIR.Expr}, visitor: visit.Visitor): nil
    for _, value in ipairs(values) do
        scalarExpression(value, visitor)
    end
end

local function scalarBlock(block: {scalarIR.Statement}, visitor: visit.Visitor): nil
    for _, statement in ipairs(block) do
        scalarStatement(statement, visitor)
    end
end

--- Rewrites direct statement expressions without entering nested block scopes.
function visit.statementExpressions(node: scalarIR.Statement, rewrite: visit.ScalarRewrite): nil
    return switch node.op do
        case "let" -> do
            local value = node as scalarIR.Let
            value.value = rewrite(value.value)
            yield nil
        end
        case "multi_let" -> do
            local value = node as scalarIR.MultiLet
            value.call = rewrite(value.call) as scalarIR.HelperCall
            yield nil
        end
        case "assign" -> do
            for _, assignment in ipairs((node as scalarIR.Assign).values) do
                assignment.target.object = rewriteOptional(assignment.target.object, rewrite)
                assignment.value = rewrite(assignment.value)
            end
            yield nil
        end
        case "store" -> do
            local value = node as scalarIR.Store
            value.value = rewrite(value.value)
            yield nil
        end
        case "lua_set_index", "lua_set_key" -> do
            local value = node as scalarIR.LuaSet
            value.table = rewrite(value.table)
            value.key = rewrite(value.key)
            value.value = rewrite(value.value)
            yield nil
        end
        case "lua_string_buffer_append" -> do
            local value = node as scalarIR.LuaStringBufferAppend
            value.buffer = rewrite(value.buffer)
            value.value = rewrite(value.value)
            yield nil
        end
        case "lua_builder_open_array", "lua_builder_open_object", "lua_builder_key", "lua_builder_string", "lua_builder_number", "lua_builder_number_slice", "lua_builder_integer_slice", "lua_builder_integer64", "lua_builder_decimal64", "lua_builder_boolean", "lua_builder_null", "lua_builder_close", "lua_builder_key_scratch", "lua_builder_string_scratch", "lua_builder_key_escapes", "lua_builder_string_escapes" -> builderEvent(
            node as scalarIR.LuaBuild,
            rewrite
        )
        case "lua_scratch_u32_set" -> scratchU32Set(node as scalarIR.LuaScratchU32Set, rewrite)
        case "lua_scratch_u8_set", "lua_scratch_u8_set4", "lua_scratch_u8_reset" -> scratchU8Set(
            node as scalarIR.LuaScratchU8Set,
            rewrite
        )
        case "if" -> do
            local value = node as scalarIR.If
            for _, clause in ipairs(value.clauses) do
                clause.condition = rewrite(clause.condition)
            end
            if value.nativeSwitch ~= nil then
                local nativeSwitch = value.nativeSwitch as scalarIR.NativeSwitch
                nativeSwitch.selector = rewrite(nativeSwitch.selector)
            end
            yield nil
        end
        case "while" -> do
            local value = node as scalarIR.While
            value.condition = rewrite(value.condition)
            yield nil
        end
        case "fornum" -> do
            local value = node as scalarIR.Fornum
            value.from = rewrite(value.from)
            value.to = rewrite(value.to)
            yield nil
        end
        case "block", "break", "continue" -> nil
        case "return" -> rewriteExpressions((node as scalarIR.Return).values, rewrite)
            --- A statement the switch does not name is walked as an expression
            --- rather than skipped. Skipping is how `simd_store4_u8` came to have
            --- its operands invisible to every pass while looking registered, and
            --- walking is the direction that fails safe.
        else -> visit.expressionChildren(node as scalarIR.Expr, rewrite)
    end
end

scalarStatement = function(node: scalarIR.Statement, visitor: visit.Visitor): nil
    local callback = visitor.scalarStatement
    if callback ~= nil then
        callback(node)
    end
    visit.statementExpressions(node, function(child: scalarIR.Expr): scalarIR.Expr
        scalarExpression(child, visitor)
        return child
    end)

    if node.op == "if" then
        local value = node as scalarIR.If
        for _, clause in ipairs(value.clauses) do
            scalarBlock(clause.body, visitor)
        end
        if value.elseBody ~= nil then
            scalarBlock(value.elseBody as {scalarIR.Statement}, visitor)
        end
    elseif node.op == "while" or node.op == "fornum" or node.op == "block" then
        scalarBlock((node as any).body as {scalarIR.Statement}, visitor)
    end
end

local function laneExpressions(values: {lane.Expr}, visitor: visit.Visitor): nil
    for _, value in ipairs(values) do
        laneExpression(value, visitor)
    end
end

laneExpression = function(node: lane.Expr, visitor: visit.Visitor): nil
    local callback = visitor.laneExpression
    if callback ~= nil then
        callback(node)
    end

    return switch node.op do
        case "local", "vfield_load", "vspan_load" -> nil
        case "vsplat" -> scalarExpressions((node as lane.Splat).args, visitor)
        case "vbool_splat" -> scalarExpression((node as lane.BoolSplat).args[1] as scalarIR.Expr, visitor)
        case "vbinary" -> laneExpressions((node as lane.Binary).args, visitor)
        case "vunary" -> laneExpressions((node as lane.Unary).args, visitor)
        case "vmask" -> laneExpressions((node as lane.MaskOp).args, visitor)
        case "vshort" -> laneExpressions((node as lane.ShortCircuit).args, visitor)
        case "vselect" -> laneExpressions((node as lane.Select).args, visitor)
        case "vmath" -> laneExpressions((node as lane.Math).args, visitor)
        case "vcorrected" -> laneExpressions((node as lane.Corrected).args, visitor)
        case "vbitwise" -> laneExpressions((node as lane.Bitwise).args, visitor)
        case "vbits" -> laneExpressions((node as lane.BitConvert).args, visitor)
        case "vround" -> laneExpressions((node as lane.Round).args, visitor)
        case "vmask_cast" -> laneExpressions((node as lane.MaskCast).args, visitor)
        case "vconvert" -> laneExpressions((node as lane.Convert).args, visitor)
    end
end

local function laneBlock(block: {any}, visitor: visit.Visitor): nil
    for _, statement in ipairs(block) do
        laneStatement(statement as lane.Statement, visitor)
    end
end

laneStatement = function(node: lane.Statement, visitor: visit.Visitor): nil
    local callback = visitor.laneStatement
    if callback ~= nil then
        callback(node)
    end

    return switch node.op do
        case "let" -> do
            local value = (node as lane.Let).value
            if tostring(value.type):match("^[fimu]%d+x%d+$") ~= nil then
                laneExpression(value as lane.Expr, visitor)
            else
                scalarExpression(value as scalarIR.Expr, visitor)
            end
            yield nil
        end
        case "vassign" -> do
            for _, assignment in ipairs((node as lane.Assign).values) do
                local targetCallback = visitor.laneTarget
                if targetCallback ~= nil then
                    targetCallback(assignment.target)
                end
                laneExpression(assignment.value, visitor)
            end
            yield nil
        end
        case "vwhile" -> do
            local value = node as lane.While
            laneExpressions({value.initial, value.condition}, visitor)
            laneBlock(value.body, visitor)
            yield nil
        end
        case "vwhile_uniform" -> do
            local value = node as lane.UniformWhile
            scalarExpression(value.condition as scalarIR.Expr, visitor)
            laneBlock(value.body, visitor)
            yield nil
        end
        case "vbreak" -> laneExpression((node as lane.Break).mask, visitor)
        case "vcontinue" -> laneExpression((node as lane.Continue).mask, visitor)
    end
end

function visit.program(program: scalarIR.Program, visitor: visit.Visitor): nil
    if program.loop ~= nil then
        scalarBlock((program.loop as scalarIR.Loop).statements, visitor)
    end
    if program.body ~= nil then
        scalarBlock(program.body as {scalarIR.Statement}, visitor)
    end
    for _, helper in ipairs(program.helpers or {}) do
        scalarExpressions(helper.values, visitor)
    end
    if program.lanes ~= nil then
        laneBlock((program.lanes as scalarIR.LaneBody).statements, visitor)
    end
end

--- The byte scratch this program may take from the reuse cache, by C name.
---
--- A reused buffer is handed back where the entry publishes it, so reuse is
--- sound only when nothing writes the buffer afterwards. The rule is
--- deliberately narrow, because being wrong shares a live buffer between two
--- calls: the program publishes exactly once anywhere, that publish is a
--- top-level statement, and every top-level statement after it is a return.
--- A decoder that publishes a string and fills again, a publish inside a loop,
--- and two publishes all fail it.
---
--- The count walks the whole program rather than its top level, so a publish
--- nested anywhere is seen; missing one is the direction that would make reuse
--- unsafe. The lowerer records the answer on the program and the verifier
--- re-runs this to check it, so there is one derivation rather than two.
function visit.reusableScratch(program: scalarIR.Program): string?
    if program.entryMode ~= "lua-builder" or program.body == nil then
        return nil
    end

    local statements = program.body as {scalarIR.Statement}
    local candidate: scalarIR.Name? = nil
    for index, statement in ipairs(statements) do
        local op = statement.op
        if op == "lua_builder_string_scratch" or op == "lua_builder_key_scratch" then
            local published = (statement as scalarIR.LuaBuild).scratch
            if published == nil or (published as scalarIR.Expr).op ~= "local" then
                return nil
            end
            for after = index + 1, #statements do
                if statements[after].op ~= "return" then
                    return nil
                end
            end
            candidate = published as scalarIR.Name
            break
        end
    end
    if candidate == nil then
        return nil
    end

    local publishes = 0
    visit.program(
        program,
        new visit.Visitor(scalarStatement = function(statement: scalarIR.Statement): nil
            local op = statement.op
            if op == "lua_builder_string_scratch" or op == "lua_builder_key_scratch" then
                publishes = publishes + 1
            end
        end)
    )
    if publishes ~= 1 then
        return nil
    end

    return (candidate as scalarIR.Name).cName
end

export = visit
