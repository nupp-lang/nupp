module nupp.compiler.aot.cplan

-- C-specific selections, made without printing text or changing semantic IR.
local scalarIR = require("nupp.compiler.aot.scalar")
local visit = require("nupp.compiler.aot.visit")
local cplan = {}

type cplan.Statement = scalarIR.Statement

--- Blocks are read-only here; preserve each producer's typed array.
type cplan.Block = {scalarIR.Statement}

record cplan.Operand
    value: scalarIR.Expr?
    count: string?
    cast: string
end

record cplan.Comparison
    call: boolean
    name: string
    left: cplan.Operand
    right: cplan.Operand
end

record cplan.SpanStart
    value: scalarIR.Expr
    helper: string
    cast: string
end

record cplan.Expressions
    comparisons: {[scalarIR.Expr]: cplan.Comparison}
    starts: {[scalarIR.Expr]: cplan.SpanStart}
end

--- How each comparison reads with its operands swapped.
local COMPARISON_SWAP: {
    [string]: string
} = {["lt"] = "gt", ["le"] = "ge", ["gt"] = "lt", ["ge"] = "le", ["eq"] = "eq", ["ne"] = "ne",}

local SIGNED_FIXED: {[string]: boolean} = {["i32"] = true, ["i64"] = true}

local INTEGER_FIXED: {[string]: boolean} = {["i32"] = true, ["u32"] = true, ["i64"] = true, ["u64"] = true}

local function integerOperand(node: scalarIR.Expr): scalarIR.Expr?
    if INTEGER_FIXED[tostring(node.type)] == true then
        return node
    end
    if node.op == "int_to_f64" then
        local inner = (node as scalarIR.Convert).value
        if INTEGER_FIXED[tostring(inner.type)] == true then
            return inner
        end
    end

    return nil
end

local function operand(value: scalarIR.Expr, cast: string?): cplan.Operand
    return new cplan.Operand(value = value, cast = cast or "")
end

--- Keep count bounds in integers, and select comparisons whose C promotions
--- would otherwise change Nupp's numeric meaning.
function cplan.comparison(operation: string, left: scalarIR.Expr, right: scalarIR.Expr): cplan.Comparison?
    if COMPARISON_SWAP[operation] == nil then
        return nil
    end
    local counted, other, swapped = left, right, false
    if counted.op ~= "span_count" then
        counted, other, swapped = right, left, true
    end
    if counted.op == "span_count" then
        local integer = integerOperand(other)
        if integer ~= nil then
            local count = new cplan.Operand(count = (counted as scalarIR.SpanCount).span, cast = "uint64_t")
            if SIGNED_FIXED[tostring(integer.type)] == true then
                local relation = swapped and operation or COMPARISON_SWAP[operation] as string
                return new cplan.Comparison(
                    call = true,
                    name = "ks_" .. relation .. "_i64_u64",
                    left = operand(integer, "int64_t"),
                    right = count
                )
            end
            local value = operand(integer, "uint64_t")
            return new cplan.Comparison(
                call = false,
                name = operation,
                left = swapped and value or count,
                right = swapped and count or value
            )
        end
    end
    if left.type == right.type then
        return nil
    end
    local leftType, rightType = tostring(left.type), tostring(right.type)
    if (leftType == "f32" and INTEGER_FIXED[rightType]) or (rightType == "f32" and INTEGER_FIXED[leftType]) then
        return new cplan.Comparison(
            call = false,
            name = operation,
            left = operand(left, "double"),
            right = operand(right, "double")
        )
    end
    if (leftType == "i32" and rightType == "u32") or (leftType == "u32" and rightType == "i32") then
        return new cplan.Comparison(
            call = true,
            name = "ks_" .. operation .. "_i32_u32",
            left = operand(left),
            right = operand(right)
        )
    end
    if SIGNED_FIXED[leftType] and rightType == "u64" then
        return new cplan.Comparison(
            call = true,
            name = "ks_" .. operation .. "_i64_u64",
            left = operand(left),
            right = operand(right)
        )
    end
    if leftType == "u64" and SIGNED_FIXED[rightType] then
        return new cplan.Comparison(
            call = true,
            name = "ks_" .. (COMPARISON_SWAP[operation] as string) .. "_i64_u64",
            left = operand(right),
            right = operand(left)
        )
    end

    return nil
end

--- Recover exact integer span offsets before rendering a binary64 promotion.
function cplan.spanStart(offset: scalarIR.Expr): cplan.SpanStart
    if offset.op == "int_to_f64" then
        local inner = (offset as scalarIR.Convert).value
        if inner.type == "u32" or inner.type == "u64" then
            return new cplan.SpanStart(value = inner, helper = "nupp_first_u64", cast = "uint64_t")
        elseif inner.type == "i32" or inner.type == "i64" then
            return new cplan.SpanStart(value = inner, helper = "nupp_first_i64", cast = "int64_t")
        end
    end

    return new cplan.SpanStart(value = offset, helper = "nupp_first_f64", cast = "")
end

--- Select each scalar operation once, shared by the function's C variants.
function cplan.expressions(programs: {scalarIR.Program}): cplan.Expressions
    local plans = new cplan.Expressions(comparisons = {}, starts = {})
    local visitor = new visit.Visitor(
        scalarExpression = function(node: scalarIR.Expr): nil
            if COMPARISON_SWAP[node.op] ~= nil then
                local binary = node as scalarIR.Fixed
                local selected = cplan.comparison(node.op, binary.left, binary.right)
                if selected ~= nil then
                    plans.comparisons[node] = selected
                end
            elseif node.op == "simd_load"
            or node.op == "simd_store"
            or node.op == "simd_field_load"
            or node.op == "simd_field_store"
            then
                local offset = (node as scalarIR.Simd).args[2]
                plans.starts[offset] = cplan.spanStart(offset)
            end
        end,
        scalarStatement = function(node: scalarIR.Statement): nil
            if node.op == "simd_store" or node.op == "simd_field_store" then
                local offset = (node as scalarIR.Simd).args[2]
                plans.starts[offset] = cplan.spanStart(offset)
            end
        end
    )
    for _, program in ipairs(programs) do
        visit.program(program, visitor)
    end

    return plans
end

export = cplan
