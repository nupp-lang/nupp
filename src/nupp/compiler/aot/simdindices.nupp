module nupp.compiler.aot.simdindices

local scalarIR = require("nupp.compiler.aot.scalar")
local shapes = require("nupp.compiler.aot.simdshape")
local indices = {}

local function indexElement(element: string?): boolean
    return element == "i32" or element == "u32" or element == "i64" or element == "u64"
end

local function speciesElement(element: string?): boolean
    return element == "f32"
        or element == "f64"
        or element == "i8"
        or element == "u8"
        or element == "i16"
        or element == "u16"
        or indexElement(element)
end

local function logicalLanes(element: string, shape: string): integer?
    local lanes = shapes.widestLanes(element, shape)
    if lanes == nil or shape:match("^fixed") ~= nil and ((lanes as integer) < 2 or (lanes as integer) > 64) then
        return nil
    end

    return lanes
end

--- The widest integer each index lane type holds exactly.
const RANGES: {
    [string]: {number}
} = {
    u32 = {0, 4294967295},
    i32 = {-2147483648, 2147483647},
    u64 = {0, 9007199254740992},
    i64 = {-9007199254740992, 9007199254740992},
}

--- An index lane's literal value: a literal, or one cast to an integer type it
--- fits (the literal may be negated first).
local function exactIndex(value: scalarIR.Expr): number?
    if value.op ~= "numeric_cast" then
        return scalarIR.exactInteger(value)
    end
    local converted = value as scalarIR.Convert
    local inner = converted.value
    local sign = 1
    if inner.op == "neg" then
        inner = (inner as scalarIR.Unary).value
        sign = -1
    end
    local exact = scalarIR.exactInteger(inner)
    if exact == nil then
        return nil
    end
    local answer = sign * (exact as number)
    local range = RANGES[tostring(converted.type)]
    if range == nil then
        return inner.type == converted.type and answer or nil
    end

    return answer >= range[1] and answer <= range[2] and answer or nil
end

--- Checks the integer element and logical shape, without selecting a tier.
function indices.matches(indexType: string, speciesType: string): boolean
    local element, shape = indexType:match("^simd_vector_([iu]%d+)_(.+)$")
    local targetElement, targetShape = speciesType:match("^simd_species_([fiu]%d+)_(.+)$")
    if element == nil or targetElement == nil or shape ~= targetShape then
        return false
    end
    if not indexElement(element) or not speciesElement(targetElement) or logicalLanes(element, shape) == nil then
        return false
    end

    return shape ~= "preferred" or element:sub(2) == targetElement:sub(2)
end

--- A constant arithmetic progression is injective when no lane wraps.
--- Preferred species use the maximum supported logical count, so the proof
--- is valid independently of tier selection. Refuse values beyond the exact
--- binary64 range rather than approximate a 64-bit proof.
function indices.unique(value: scalarIR.Expr): boolean
    if value.op ~= "simd_iota" then
        return false
    end
    local element, shape = value.type:match("^simd_vector_([iu]%d+)_(.+)$")
    if not indexElement(element) then
        return false
    end
    local args = (value as scalarIR.Simd).args
    if #args ~= 2 then
        return false
    end
    local first, step = exactIndex(args[1]), exactIndex(args[2])
    local lanes = logicalLanes(element as string, shape as string)
    if first == nil or step == nil or step == 0 or lanes == nil then
        return false
    end
    local bits = tonumber(element:sub(2)) or 0
    local signed = element:sub(1, 1) == "i"
    local low = signed and -(2 ^ (bits - 1)) or 0
    local high = 2 ^ (signed and bits - 1 or bits) - 1
    local last = first + (lanes - 1) * step

    return math.abs(first) <= 9007199254740991
        and math.abs(last) <= 9007199254740991
        and first >= low
        and first <= high
        and last >= low
        and last <= high
end

export = indices
