module nupp.compiler.aot.simdbounds

local scalarIR = require("nupp.compiler.aot.scalar")
local simdbounds = {}

--- A species lane count, optionally multiplied by a positive uint32 constant.
function simdbounds.lanes(value: scalarIR.Expr): (scalarIR.Expr?, number?)
    if value.op == "simd_lanes_generic" then
        return (value as scalarIR.Simd).args[1], 1
    elseif value.op == "u32_mul" then
        local product = value as scalarIR.Fixed
        local lane, factor = product.left, product.right
        if factor.op == "simd_lanes_generic" then
            lane, factor = factor, lane
        end
        local count = factor.op == "constant_i32"
            and factor.type == "u32"
            and tonumber((factor as scalarIR.IntConstant).value)
            or nil
        if lane.op == "simd_lanes_generic"
            and count ~= nil
            and count >= 1
            and count <= 4294967295
            and count % 1 == 0
        then
            return (lane as scalarIR.Simd).args[1], count
        end
    end

    return nil, nil
end

function simdbounds.room(species: string, count: number): string
    return count == 1 and species or species .. "@" .. tostring(count)
end

function simdbounds.covers(room: string?, species: string, count: number?): boolean
    if room == nil then
        return false
    end
    local held, multiple = (room as string):match("^(.+)@(%d+)$")
    held = held or room
    local available = tonumber(multiple) or 1
    local lanes = held:match("_fixed(%d+)$")

    return (held == species or lanes ~= nil and species:match("_fixed(%d+)$") == lanes) and available >= (count or 1)
end

--- Whether a room is a plain element count rather than a species' vectors.
function simdbounds.elementRoom(room: string): boolean
    return room:match("^%d+$") ~= nil
end

--- How many elements a room certainly holds below the count it was proved
--- against: the count itself for an element room, and for a vector room its
--- vectors times the species' lanes -- which a fixed species names, and which
--- is at least one for any other.
function simdbounds.elements(room: string?): number
    if room == nil then
        return 0
    end
    local held = room as string
    if simdbounds.elementRoom(held) then
        return tonumber(held) or 0
    end
    local species, multiple = held:match("^(.+)@(%d+)$")
    species = species or held
    local lanes = tonumber(species:match("_fixed(%d+)$")) or 1

    return lanes * (tonumber(multiple) or 1)
end

--- The room to hold once a second bound is proved for the same cursor against
--- the same root. Two element rooms keep the larger. A vector room beats an
--- element room it reaches, since it proves those elements too, and gives way
--- to one it does not; a later vector room replaces an earlier one, as the
--- vector accesses under it ask for exactly the species it names.
function simdbounds.widen(existing: string?, room: string): string
    if existing == nil then
        return room
    end
    local held = existing as string
    local heldElements, roomElements = simdbounds.elements(held), simdbounds.elements(room)
    local heldVector, roomVector = not simdbounds.elementRoom(held), not simdbounds.elementRoom(room)
    if heldVector and roomVector then
        return room
    elseif heldVector then
        return heldElements >= roomElements and held or room
    elseif roomVector then
        return roomElements >= heldElements and room or held
    end

    return roomElements >= heldElements and room or held
end

--- How many elements the dominating checks prove a cursor has below
--- `counted`: directly, below a root the entry guards prove no longer than
--- it, or carried from a root by a guard relating the two counts through a
--- factor (`transfers`, as `scalarIR.RoomTransfer` reads them). Zero when
--- nothing bounded it. `related` is the same map `coveredThrough` reads.
function simdbounds.reach(
    bounds: scalarIR.CursorBounds,
    cursor: string,
    counted: string?,
    related: {[string]: {[string]: boolean}}?,
    transfers: scalarIR.RoomTransfers?
): number
    local spans = bounds[cursor]
    if spans == nil or counted == nil then
        return 0
    end
    local most = simdbounds.elements(spans[counted as string])
    for root, room in pairs(spans) do
        local held = simdbounds.elements(room)
        local reaches = related ~= nil and (related as {[string]: {[string]: boolean}})[root] or nil
        if reaches ~= nil and reaches[counted as string] == true then
            most = math.max(most, held)
        end
        local carried = transfers ~= nil and (transfers as scalarIR.RoomTransfers)[root] or nil
        for _, transfer in ipairs(carried ~= nil and carried[counted as string] or {}) do
            most = math.max(most, transfer.factor * held - transfer.offset)
        end
    end

    return most
end

--- Whether a dominating check bounded a cursor `count` elements (one when
--- unsaid) below `counted`, as `reach` counts them.
function simdbounds.boundedThrough(
    bounds: scalarIR.CursorBounds,
    cursor: string,
    counted: string?,
    related: {[string]: {[string]: boolean}}?,
    count: number?,
    transfers: scalarIR.RoomTransfers?
): boolean
    return simdbounds.reach(bounds, cursor, counted, related, transfers) >= (count or 1)
end

--- Whether a cursor has room for `count` vectors of `species` below `counted`:
--- bounded against it directly, or against a root the entry guards prove no
--- longer than it. `related[root][span]` holds when the guards prove the root's
--- count at most the span's, so `assert(#output == #input)` lets a guard on
--- `#input` bound a store to `output`.
function simdbounds.coveredThrough(
    bounds: scalarIR.CursorBounds,
    cursor: string,
    counted: string?,
    related: {[string]: {[string]: boolean}}?,
    species: string,
    count: number?
): boolean
    local spans = bounds[cursor]
    if spans == nil or counted == nil then
        return false
    end
    if simdbounds.covers(spans[counted as string], species, count) then
        return true
    end
    for root, room in pairs(spans) do
        local reaches = related ~= nil and (related as {[string]: {[string]: boolean}})[root] or nil
        if reaches ~= nil and reaches[counted as string] == true and simdbounds.covers(room, species, count) then
            return true
        end
    end

    return false
end

local WAYS: {
    [string]: integer
} = {load_pairs = 2, load_triples = 3, load_quads = 4, store_pairs = 2, store_triples = 3, store_quads = 4,}

--- How many vectors a contiguous load or store moves: two to four for the
--- interleaved forms, one for everything else.
function simdbounds.ways(intrinsic: string?): integer
    return intrinsic ~= nil and WAYS[intrinsic as string] or 1
end

--- Whether an intrinsic is one of the interleaved loads or stores.
function simdbounds.interleaved(intrinsic: string?): boolean
    return intrinsic ~= nil and WAYS[intrinsic as string] ~= nil
end

--- A named uint32 cursor, including entry and helper parameters.
function simdbounds.cursor(value: scalarIR.Expr): scalarIR.Name?
    if value.type == "u32" and (value.op == "local" or value.op == "uniform" or value.op == "helper_param") then
        return value as scalarIR.Name
    end
    return nil
end

--- The zero-based base cursor and vector displacement in a one-based index.
function simdbounds.offset(value: scalarIR.Expr): (scalarIR.Name?, string?, number?)
    if value.op == "int_to_f64" then
        value = (value as scalarIR.Convert).value
    end
    if value.op ~= "u32_add" then
        return nil, nil, nil
    end
    local added = value as scalarIR.Fixed
    local one = added.right
    if one.op ~= "constant_i32" or one.type ~= "u32" or tonumber((one as scalarIR.IntConstant).value) ~= 1 then
        return nil, nil, nil
    end
    local base = added.left
    local named = simdbounds.cursor(base)
    if named ~= nil then
        return named, nil, 0
    elseif base.op == "u32_add" then
        local displaced = base as scalarIR.Fixed
        local species, count = simdbounds.lanes(displaced.right)
        local cursor = simdbounds.cursor(displaced.left)
        if cursor ~= nil and species ~= nil then
            return cursor, (species as scalarIR.Expr).type, count
        end
    end

    return nil, nil, nil
end

export = simdbounds
