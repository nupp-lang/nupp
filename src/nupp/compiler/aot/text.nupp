module nupp.compiler.aot.text

--[[
The readable form of an AOT program.

Not a serialisation format and not something the compiler reads back: this is
what a person opens when they want to know what the front end actually admitted,
and what a test asserts against when the claim is about the IR rather than about
the machine code under it. It is the one place the whole program appears at once
-- the signature, what ownership proved, the loop, and the vector rewrite beside
the scalar body it came from.

It keeps the spellings the vocabulary used before its families were given one tag
each. `vand` rather than `vmask`, `vtobits` rather than `vbits`, because the
reader wants the operation and not the record it happens to share.

The second half of the file prints the same vector rewrite as Nupp rather than
as IR, which is what `nupp aot --emit simd` shows. It starts at
`text.explicitExpression`.
]]

local reducers = require("nupp.compiler.aot.reducers")
local relations = require("nupp.compiler.aot.relations")
local scalarIR = require("nupp.compiler.aot.scalar")

local text = {}

--- Any operation rendered as its opcode over a list of operands.
---
--- The IR text walks every vocabulary at once, so it reads the few fields it
--- needs through a shape that says what those are rather than through the union
--- of every record that might carry them.
record text.Operands
    op: string
    type: string?
    verb: string?
    direction: string?

    --- The element a rounding names, which is the only thing that tells two
    --- roundings apart.
    element: string?

    args: {any}
end

--- Any operation rendered as its opcode over exactly two operands.
record text.Pair
    op: string
    left: any
    right: any
end

--- The opcodes whose operands are a list.
---
--- Everything else with operands has two, in `left` and `right`. `f32_fma` is
--- the one corrected operation with three, which is why it appears here and its
--- two-operand siblings do not.
const text.LIST_OPERANDS = {["f32_fma"] = true,}

--- The opcodes that wrap one operand, held in `value`.
const text.ONE_OPERAND = {
    ["widen_f32_f64"] = true,
    ["narrow_f64_f32"] = true,
    ["int_to_f64"] = true,
    ["numeric_cast"] = true,
    ["f16_to_f32"] = true,
    ["f32_to_f16"] = true,
    ["bf16_to_f32"] = true,
    ["f32_to_bf16"] = true,
    ["neg"] = true,
    ["not"] = true,
    ["bnot"] = true,
    ["f32_sqrt"] = true,
    ["f32_exp"] = true,
    ["u32_not"] = true,
    ["u32_popcount"] = true,
    ["u32_ctz"] = true,
    ["u32_clz"] = true,
    ["u64_not"] = true,
    ["u64_popcount"] = true,
    ["u64_ctz"] = true,
    ["u64_clz"] = true,
    ["u64_prefix_xor"] = true,
}

--- Where something came from, as the IR text writes it.
---
--- A missing position reads as the start of the file, which is what lowering
--- already does for a construct with no token of its own.
local function at(source: scalarIR.Source?): string
    local site = source or new scalarIR.Source(line = 1, column = 1)

    return ("@%d:%d"):format(site.line, site.column)
end

--- What one operation is called in the IR text.
function text.displayOp(node: text.Operands): string
    return node.op
end

--- One expression, and everything under it.
function text.expression(node: scalarIR.Expr): string
    local op = node.op
    if op == "load" then
        local index = node.cursor ~= nil and node.cursor .. "+1" or node.index
        return "load:" .. node.type .. " " .. node.span .. "[" .. index .. "]"
    elseif op == "span_count" then
        return "count " .. node.span
    elseif op == "loop_index" then
        return "loop_index:f64"
    elseif op == "workgroup_index" or op == "local_index" then
        return op .. ":u32"
    elseif op == "shared_load" then
        local load = node as scalarIR.SharedLoad
        return "shared_load:" .. load.type .. " " .. load.shared .. "[" .. text.expression(load.index) .. "]"
    elseif op == "element_ref" then
        local index = node.cursor ~= nil and node.cursor .. "+1" or node.index
        return "element_ref:" .. node.layout .. " " .. node.span .. "[" .. index .. "]"
    elseif op == "field_load" then
        return "field:" .. node.type .. " " .. text.expression(node.object) .. "." .. node.field
    elseif op == "uniform" or op == "local" or op == "helper_param" then
        return op .. ":" .. node.type .. " " .. (node as scalarIR.Name).name
    elseif op == "constant_i32" or op == "constant_i64" then
        return "constant:" .. node.type .. " " .. node.value
    elseif op == "constant" then
        return "constant:f64 " .. node.value
    elseif op == "bool" then
        return "bool " .. tostring(node.value)
    elseif op == "lua_nil" then
        return "lua.nil"
    elseif op == "lua_string" then
        return "lua.string " .. string.format("%q", node.value)
    elseif op == "lua_string_match" then
        local matched = node as scalarIR.LuaStringMatch
        return "lua.string_match(" .. text.expression(
            matched.bytes
        ) .. ", " .. string.format("%q", matched.value) .. ")"
    elseif op == "lua_concat" then
        return "lua.concat(" .. text.expression(node.left) .. ", " .. text.expression(node.right) .. ")"
    elseif op == "lua_substring" then
        return "lua.substring(" .. text.expression(
            node.bytes
        ) .. ", " .. text.expression(
            node.first
        ) .. (node.last ~= nil and ", " .. text.expression(node.last) or "") .. ")"
    elseif op == "lua_string_byte_lua" then
        return "lua.byte(" .. text.expression(node.bytes) .. ", " .. text.expression(node.index) .. ")"
    elseif op == "lua_table_get_index" then
        return "lua.get_index(" .. text.expression(node.table) .. ", " .. text.expression(node.key) .. ")"
    elseif op == "lua_string_buffer" then
        return "lua.string_buffer(" .. text.expression(node.initial) .. ")"
    elseif op == "lua_string_buffer_finish" then
        return "lua.string_buffer_finish(" .. text.expression(node.buffer) .. ")"
    elseif op == "lua_new_table" then
        local created = node as scalarIR.LuaNewTable
        local fields: {string} = {}
        for position, field in ipairs(created.fields or {}) do
            fields[
                position
            ] = (
                field.indexed and "index " or "key "
            ) .. text.expression(field.key) .. " = " .. text.expression(field.value)
        end
        return "lua.new_table(" .. text.expression(
            created.arrayCapacity
        ) .. ", " .. text.expression(created.hashCapacity) .. "){" .. table.concat(fields, "; ") .. "}"
    elseif op == "lua_builder" then
        local builder = node as scalarIR.LuaBuilder
        local values = {builder.mode, text.expression(builder.nullValue)}
        if builder.maxDepth ~= nil then
            values[#values + 1] = text.expression(builder.maxDepth as scalarIR.Expr)
            values[#values + 1] = text.expression(builder.stringCapacity as scalarIR.Expr)
            if builder.arrayMarker ~= nil then
                values[#values + 1] = text.expression(builder.arrayMarker as scalarIR.Expr)
                values[#values + 1] = text.expression(builder.objectMarker as scalarIR.Expr)
                if builder.selectionShape ~= nil then
                    values[#values + 1] = text.expression(builder.selectionShape as scalarIR.Expr)
                    values[#values + 1] = text.expression(builder.arrayShapeMarker as scalarIR.Expr)
                    values[#values + 1] = text.expression(builder.serdeMarkers as scalarIR.Expr)
                end
            end
        end
        return "lua.builder(" .. table.concat(values, ", ") .. ")"
    elseif op == "lua_scratch_u32" then
        return "lua.scratch_u32(" .. text.expression((node as scalarIR.LuaScratchU32).capacity) .. ")"
    elseif op == "lua_scratch_u32_get" or op == "lua_scratch_u32_escape_get" then
        local loaded = node as scalarIR.LuaScratchU32Get
        return (
            op == "lua_scratch_u32_escape_get" and "lua.scratch_u32_escape_get(" or "lua.scratch_u32_get("
        ) .. text.expression(loaded.scratch) .. ", " .. text.expression(loaded.index) .. ")"
    elseif op == "lua_scratch_u32_length" or op == "lua_scratch_u32_escape_length" then
        return (
            op == "lua_scratch_u32_escape_length" and "lua.scratch_u32_escape_length(" or "lua.scratch_u32_length("
        ) .. text.expression((node as scalarIR.LuaScratchU32Length).scratch) .. ")"
    elseif op == "lua_scratch_u32_append_bits" or op == "lua_scratch_u32_append_bits_eager" then
        local appended = node as scalarIR.LuaScratchU32AppendBits
        return (
            op == "lua_scratch_u32_append_bits_eager"
            and "lua.scratch_u32_append_bits_eager("
            or "lua.scratch_u32_append_bits("
        ) .. table.concat(
            {
                text.expression(appended.scratch),
                text.expression(appended.index),
                text.expression(appended.base),
                text.expression(appended.bits),
            },
            ", "
        ) .. ")"
    elseif op == "lua_scratch_u32_append_string_bits" then
        local appended = node as scalarIR.LuaScratchU32AppendStringBits
        local values = {
            text.expression(appended.scratch),
            text.expression(appended.index),
            text.expression(appended.base),
            text.expression(appended.events),
            text.expression(appended.quotes),
            text.expression(appended.slashes),
            text.expression(appended.inString),
            text.expression(appended.stringEscaped),
        }
        local name = "lua.scratch_u32_append_string_bits("
        if appended.sharedEscapes then
            name = "lua.scratch_u32_append_string_shared_bits("
        end
        if appended.escapeScratch ~= nil then
            values = {
                text.expression(appended.scratch),
                text.expression(appended.escapeScratch as scalarIR.Expr),
                text.expression(appended.index),
                text.expression(appended.base),
                text.expression(appended.events),
                text.expression(appended.quotes),
                text.expression(appended.slashes),
                text.expression(appended.slashCarry as scalarIR.Expr),
                text.expression(appended.slashOdd as scalarIR.Expr),
                text.expression(appended.inString),
                text.expression(appended.stringEscaped),
            }
            name = "lua.scratch_u32_append_string_escape_bits("
        end
        return name .. table.concat(values, ", ") .. ")"
    elseif op == "lua_scratch_u8" then
        return "lua.scratch_u8(" .. text.expression((node as scalarIR.LuaScratchU8).capacity) .. ")"
    elseif op == "lua_scratch_u8_get" then
        local loaded = node as scalarIR.LuaScratchU8Get
        return "lua.scratch_u8_get(" .. text.expression(loaded.scratch) .. ", " .. text.expression(loaded.index) .. ")"
    elseif op == "lua_string_length" then
        return "lua.length(" .. text.expression((node as scalarIR.LuaBytes).bytes) .. ")"
    elseif op == "lua_string_byte" or op == "lua_string_byte_at" or op == "lua_string_u32" then
        local bytes = node as scalarIR.LuaBytes
        return op .. "(" .. text.expression(bytes.bytes) .. ", " .. text.expression(bytes.index as scalarIR.Expr) .. ")"
    elseif op == "lua_builder_finish" then
        return "lua.builder_finish(" .. text.expression((node as scalarIR.LuaBuilderFinish).builder) .. ")"
    elseif op == "lua_builder_depth"
        or op == "lua_builder_kind"
        or op == "lua_builder_count"
        or op == "lua_builder_state"
    then
        return op .. "(" .. text.expression((node as scalarIR.LuaBuilderQuery).builder) .. ")"
    elseif op == "lua_builder_number_token" then
        local number = node as scalarIR.LuaBuilderNumberToken
        return op .. ":u32(" .. table.concat(
            {
                text.expression(number.builder),
                text.expression(number.sourceBytes),
                text.expression(number.start),
                text.expression(number.limit),
            },
            ", "
        ) .. ")"
    elseif op == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        return "reducer." .. reducer.order .. "." .. reducer.operation .. "(" .. text.expression(reducer.initial) .. ")"
    elseif op == "reducer_add" then
        local reducer = node as scalarIR.ReducerAdd
        return "reducer.add " .. text.expression(
            reducer.reducer
        ) .. " <- " .. text.expression(
            reducer.value
        ) .. (reducer.right ~= nil and ", " .. text.expression(reducer.right as scalarIR.Expr) or "")
    elseif op == "reducer_value" then
        local reducer = node as scalarIR.ReducerValue
        return "reducer.value " .. text.expression(reducer.reducer)
    elseif op == "simd_reducer_add" then
        local reducer = node as scalarIR.SimdReducerAdd
        return "simd.reducer." .. reducer.order .. "." .. reducer.operation .. " " .. text.expression(
            reducer.reducer
        ) .. " <- " .. text.expression(
            reducer.value
        ) .. (
            reducer.right ~= nil and ", " .. text.expression(reducer.right as scalarIR.Expr) or ""
        ) .. " if " .. text.expression(reducer.mask)
    elseif tostring(op):match("^simd_") ~= nil then
        local simd = node as scalarIR.Simd
        local values: {string} = {}
        for position, argument in ipairs(simd.args) do
            values[position] = text.expression(argument)
        end
        if simd.span ~= nil then
            values[#values + 1] = "span:" .. (simd.span as string)
        end
        if simd.field ~= nil then
            values[#values + 1] = "field:" .. tostring(simd.layout) .. "." .. (simd.field as string)
        end
        if simd.helper ~= nil then
            values[#values + 1] = "helper:" .. (simd.helper as string)
        end
        local name = tostring(op) .. (simd.intrinsic ~= nil and "." .. (simd.intrinsic as string) or "")
        return name .. ":" .. simd.type .. "(" .. table.concat(values, ", ") .. ")"
    elseif text.ONE_OPERAND[tostring(op)] == true then
        return op .. "(" .. text.expression((node as scalarIR.Unary).value) .. ")"
    end

    --- The operands of one operation, in order.
    local function operands(args: {any}): string
        local rendered: {string} = {}
        for position, argument in ipairs(args) do
            rendered[position] = text.expression(argument)
        end

        return table.concat(rendered, ", ")
    end

    if op == "math" then
        return "math." .. node.intrinsic .. "(" .. operands(node.args) .. ")"
    elseif op == "helper_call" then
        return "call " .. node.helper .. "(" .. operands(node.args) .. ")"
    elseif text.LIST_OPERANDS[tostring(op)] == true then
        local listed = node as text.Operands

        return text.displayOp(listed) .. ":" .. tostring(listed.type) .. "(" .. operands(listed.args) .. ")"
    end

    local pair = node as text.Pair

    return op .. "(" .. text.expression(pair.left) .. ", " .. text.expression(pair.right) .. ")"
end

--- One assignment target.
local function target(assignment: any): string
    if assignment.target.kind == "local" then
        return assignment.target.name
    end

    return text.expression(assignment.target.object) .. "." .. assignment.target.field
end

--- One scratch write, as `label scratch[index] = value`.
local function scratchWrite(label: string, statement: any): string
    return label .. " " .. text.expression(
        statement.scratch
    ) .. "[" .. text.expression(
        statement.index as scalarIR.Expr
    ) .. "] = " .. text.expression(statement.value as scalarIR.Expr)
end

--- What a loop carries, as a suffix on its header: nothing when it carries
--- nothing, which is most counted loops.
local function carrying(carried: {scalarIR.Carried}?): string
    if carried == nil or #(carried as {scalarIR.Carried}) == 0 then
        return ""
    end
    local names: {string} = {}
    for position, entry in ipairs(carried as {scalarIR.Carried}) do
        names[position] = entry.name .. ":" .. entry.type
    end

    return " carrying " .. table.concat(names, ", ")
end

--- One block of statements, indented by `depth`.
function text.block(statements: {any}, depth: integer): {string}
    local lines: {string} = {}
    local prefix = string.rep("  ", depth)

    --- Appends the rendering of a nested block.
    local function nested(body: {any}): nil
        for _, line in ipairs(text.block(body, depth + 1)) do
            lines[#lines + 1] = line
        end
    end

    for _, statement in ipairs(statements) do
        local op = statement.op
        if op == "let" then
            lines[
                #lines + 1
            ] = prefix .. (
                statement.assigned == true and "var " or "let "
            ) .. statement.name .. ":" .. statement.type .. " = " .. text.expression(statement.value)
        elseif op == "multi_let" then
            local names: {string} = {}
            for position, bound in ipairs(statement.bindings) do
                names[position] = (bound.assigned == true and "var " or "") .. bound.name .. ":" .. bound.type
            end
            lines[#lines + 1] = prefix .. "let " .. table.concat(names, ",") .. " = " .. text.expression(statement.call)
        elseif op == "store" then
            local index = statement.cursor ~= nil and statement.cursor .. "+1" or statement.index
            lines[
                #lines + 1
            ] = prefix .. "store " .. statement.span .. "[" .. index .. "] = " .. text.expression(statement.value)
        elseif op == "shared_store" then
            local store = statement as scalarIR.SharedStore
            lines[
                #lines + 1
            ] = prefix .. "shared_store " .. store.shared .. "[" .. text.expression(
                store.index
            ) .. "] = " .. text.expression(store.value)
        elseif op == "phase" then
            lines[#lines + 1] = prefix .. "phase"
            nested((statement as scalarIR.Phase).body)
            lines[#lines + 1] = prefix .. "barrier"
        elseif op == "lua_set_index" or op == "lua_set_key" then
            lines[
                #lines + 1
            ] = prefix .. op .. " " .. text.expression(
                statement.table
            ) .. "[" .. text.expression(statement.key) .. "] = " .. text.expression(statement.value)
        elseif op == "lua_string_buffer_append" then
            lines[
                #lines + 1
            ] = prefix .. "lua.string_buffer_append(" .. text.expression(
                statement.buffer
            ) .. ", " .. text.expression(statement.value) .. ")"
        elseif op == "lua_scratch_u32_set" then
            lines[#lines + 1] = prefix .. scratchWrite("lua.scratch_u32_set", statement)
        elseif op == "lua_scratch_u8_set" then
            lines[#lines + 1] = prefix .. scratchWrite("lua.scratch_u8_set", statement)
        elseif op == "lua_scratch_u8_set4" then
            lines[#lines + 1] = prefix .. scratchWrite("lua.scratch_u8_set4", statement)
        elseif op == "lua_scratch_u8_reset" then
            lines[
                #lines + 1
            ] = prefix .. "lua.scratch_u8_reset " .. text.expression((statement as scalarIR.LuaScratchU8Set).scratch)
        elseif tostring(op):match("^lua_builder_") ~= nil then
            local event = statement as scalarIR.LuaBuild
            local values: {string} = {text.expression(event.builder)}
            for _, value in ipairs({
                event.capacity,
                event.sourceBytes,
                event.start,
                event.length,
                event.escaped,
                event.value,
                event.negative,
                event.scratch,
                event.escapeScratch,
                event.escapeIndex,
                event.escapeCount,
            }) do
                if value ~= nil then
                    values[#values + 1] = text.expression(value as scalarIR.Expr)
                end
            end
            lines[#lines + 1] = prefix .. op .. "(" .. table.concat(values, ", ") .. ")"
        elseif op == "assign" then
            for _, assignment in ipairs(statement.values) do
                lines[#lines + 1] = prefix .. "set " .. target(assignment) .. " = " .. text.expression(assignment.value)
            end
        elseif op == "reducer_add" then
            lines[#lines + 1] = prefix .. text.expression(statement as scalarIR.ReducerAdd)
        elseif op == "simd_store" or op == "simd_field_store" then
            lines[#lines + 1] = prefix .. text.expression(statement as scalarIR.Simd)
        elseif op == "simd_reducer_add" then
            lines[#lines + 1] = prefix .. text.expression(statement as scalarIR.SimdReducerAdd)
        elseif op == "simd_region" then
            local region = statement as scalarIR.SimdRegion
            local names: {string} = {}
            for position, reducer in ipairs(region.reducers) do
                names[position] = reducer.name
            end
            lines[#lines + 1] = prefix .. "simd.region " .. table.concat(names, ", ")
            nested(region.body)
            lines[#lines + 1] = prefix .. "end"
        elseif op == "if" then
            for position, clause in ipairs(statement.clauses) do
                lines[
                    #lines + 1
                ] = prefix .. (position == 1 and "if " or "elseif ") .. text.expression(clause.condition)
                nested(clause.body)
            end
            if statement.elseBody ~= nil then
                lines[#lines + 1] = prefix .. "else"
                nested(statement.elseBody)
            end
            lines[#lines + 1] = prefix .. "end"
        elseif op == "fornum" then
            local region = statement as scalarIR.Fornum
            lines[
                #lines + 1
            ] = prefix .. (
                region.simdRequired == true and "@simd " or ""
            ) .. "for " .. (
                statement.binding.assigned == true and "var " or ""
            ) .. statement.binding.name .. " = " .. text.expression(
                statement.from
            ) .. " .. " .. text.expression(statement.to) .. carrying(region.carried)
            nested(statement.body)
            if region.vector ~= nil then
                lines[#lines + 1] = prefix .. "simd vector"
                nested(region.vector as {scalarIR.Statement})
            end
            lines[#lines + 1] = prefix .. "end"
        elseif op == "while" then
            if statement.conditionBody ~= nil then
                lines[#lines + 1] = prefix .. "condition setup"
                nested(statement.conditionBody)
            end
            lines[
                #lines + 1
            ] = prefix .. "while " .. text.expression(statement.condition) .. carrying(statement.carried)
            nested(statement.body)
            lines[#lines + 1] = prefix .. "end"
        elseif op == "repeat" then
            lines[#lines + 1] = prefix .. "repeat" .. carrying(statement.carried)
            nested(statement.body)
            if statement.conditionBody ~= nil then
                lines[#lines + 1] = prefix .. "condition setup"
                nested(statement.conditionBody)
            end
            lines[#lines + 1] = prefix .. "until " .. text.expression(statement.condition)
        elseif op == "block" then
            lines[#lines + 1] = prefix .. "block"
            nested(statement.body)
        elseif op == "return" then
            local values: {string} = {}
            for position, value in ipairs(statement.values) do
                values[position] = text.expression(value)
            end
            lines[#lines + 1] = prefix .. "return " .. table.concat(values, ", ")
        else
            lines[#lines + 1] = prefix .. op
        end
    end

    return lines
end

--- What the signature and the ownership proofs say.
local function preamble(program: scalarIR.Program): {string}
    local lines: {
        string
    } = {"native-c-ir " .. tostring(scalarIR.VERSION), "function " .. program.name, "symbol " .. program.symbol,}
    lines[#lines + 1] = "entry " .. program.entryMode
    if program.executionTarget == "gpu" then
        lines[#lines + 1] = "target gpu"
    end
    -- Printed so the reuse claim can be pinned in the IR, where it is proved,
    -- rather than by grepping the C it eventually shapes.
    if program.reusableScratch ~= nil then
        lines[#lines + 1] = "reuses scratch " .. tostring(program.reusableScratch)
    end
    if program.runtimeAbi ~= nil then
        lines[
            #lines + 1
        ] = "runtime " .. tostring(program.runtimeAbi) .. " registrar(" .. tostring(program.registrar) .. ")"
    end

    -- The contract is part of what the IR means and not a build setting,
    -- because it decides what the function answers rather than only how fast it
    -- gets there.
    if program.fpContract == true then
        lines[#lines + 1] = "contract fp-contract(fused)"
    end
    if program.fpTranscendentals == true then
        lines[#lines + 1] = "contract fp-transcendentals(native)"
    end
    if program.simdWidth ~= nil then
        lines[#lines + 1] = "simd species(uint8," .. tostring(program.simdWidth) .. ")"
    end

    lines[#lines + 1] = "layouts"
    for _, layout in ipairs(program.layouts or {}) do
        local fields: {string} = {}
        for position, field in ipairs(layout.fields) do
            fields[position] = field.name .. ":" .. field.type .. " source(" .. tostring(field.sourceType) .. ")"
        end
        lines[#lines + 1] = "  " .. layout.name .. "{" .. table.concat(fields, ",") .. "}"
    end

    lines[#lines + 1] = "params"
    for _, param in ipairs(program.params) do
        if param.region ~= nil then
            lines[
                #lines + 1
            ] = (
                "  %s %s:%s source(%s) span(%s) region(%s) %s %s"
            ):format(
                param.kind,
                param.name,
                param.type,
                tostring(param.sourceType),
                tostring(param.spanModule),
                tostring(param.region),
                tostring(param.access),
                at(param.source)
            )
        else
            lines[
                #lines + 1
            ] = (
                "  %s %s:%s source(%s) %s"
            ):format(param.kind, param.name, param.type, tostring(param.sourceType), at(param.source))
        end
    end

    lines[#lines + 1] = "aliasing"
    for _, fact in ipairs(program.aliasFacts) do
        lines[#lines + 1] = ("  %s %s %s proof(%s)"):format(fact.relation, fact.left, fact.right, fact.proof)
    end

    lines[#lines + 1] = "helpers"
    for _, helper in ipairs(program.helpers or {}) do
        lines[
            #lines + 1
        ] = ("  %s -> %s %s"):format(helper.name, table.concat(helper.resultTypes, ","), at(helper.source))
    end

    lines[#lines + 1] = "relations"
    for _, relation in ipairs(program.relations or {}) do
        lines[#lines + 1] = ("  %s %s"):format(relations.text(relation), at(relation.source))
    end

    lines[#lines + 1] = "guards"
    for _, guard in ipairs(program.guards) do
        lines[#lines + 1] = ("  equal_count %s %s %s"):format(guard.left, guard.right, at(guard.source))
    end

    local rangeGuard = program.rangeGuard
    if rangeGuard ~= nil then
        local guard = rangeGuard as scalarIR.RangeGuard
        lines[
            #lines + 1
        ] = ("  range %s %s count(%s) %s"):format(guard.first, guard.last, guard.count, at(guard.source))
    end

    local resultTypes = program.resultTypes or {}
    lines[#lines + 1] = "results " .. (#resultTypes == 0 and "nil" or table.concat(resultTypes, ","))

    local loop = program.loop
    local workgroup = program.workgroup
    if loop ~= nil then
        local scalarLoop = loop as scalarIR.Loop
        lines[
            #lines + 1
        ] = (
            "loop %s = %s .. %s count(%s) %s"
        ):format(
            scalarLoop.index,
            tostring(scalarLoop.first),
            tostring(scalarLoop.last),
            scalarLoop.count,
            at(scalarLoop.source)
        )
    elseif workgroup ~= nil then
        local phased = workgroup as scalarIR.Workgroup
        lines[
            #lines + 1
        ] = (
            "workgroups count(%s) size(%d) dispatch(%s) %s"
        ):format(text.expression(phased.groups), phased.size, phased.dispatchSpan, at(phased.source))
        for _, scratch in ipairs(phased.shared) do
            lines[
                #lines + 1
            ] = (
                "  shared %s:%s[%d] = %s %s"
            ):format(scratch.name, scratch.element, scratch.count, text.expression(scratch.initial), at(scratch.source))
        end
    else
        lines[#lines + 1] = "block"
    end

    return lines
end

--- One whole program, as text.
---
--- The vector body appears after the scalar one it was rewritten from, rather
--- than in place of it, because the two being readable side by side is what
--- makes a `@simd` rewrite reviewable at all.
function text.program(program: scalarIR.Program): string
    local lines = preamble(program)
    local loop = program.loop
    local workgroup = program.workgroup
    local statements = loop ~= nil and (
        loop as scalarIR.Loop
    ).statements or workgroup ~= nil and (workgroup as scalarIR.Workgroup).statements or program.body or {}
    if workgroup ~= nil then
        for _, line in ipairs(text.block((workgroup as scalarIR.Workgroup).prelude, 1)) do
            lines[#lines + 1] = line
        end
    end
    for _, line in ipairs(text.block(statements, 1)) do
        lines[#lines + 1] = line
    end
    if program.vector ~= nil then
        lines[#lines + 1] = "simd vector"
        for _, line in ipairs(text.block(program.vector as {scalarIR.Statement}, 1)) do
            lines[#lines + 1] = line
        end
    end

    return table.concat(lines, "\n") .. "\n"
end

--- Every program in one file, as text.
---
--- Separated by a blank line and nothing else. Each carries its own header, so
--- a reader can tell where one function ends without a marker between them.
function text.programs(programs: {scalarIR.Program}): string
    local parts: {string} = {}
    for position, program in ipairs(programs) do
        parts[position] = text.program(program)
    end

    return table.concat(parts, "\n")
end

--[[
The Nupp surface form of a rewritten `@simd` region.

`@simd` has no vector IR of its own: a marked loop is rewritten onto the same
`simd_*` operations over `Fixed<N>` species that `nupp.simd` hands a programmer.
What follows prints that rewrite back as the source somebody could have written
instead, so the answer to "what did my loop become" is a Nupp program rather
than a vector listing.

It is a printer and nothing else. Every construct below reads one IR node and
writes the surface spelling that lowers back to it; where the rewrite produces
something the surface cannot say, this refuses rather than approximating, so the
gap is reported instead of hidden behind a comment in the output.
]]

--- What one vector element is witnessed by in `nupp.mem.array`.
const text.ELEMENT_WITNESS = {
    ["f64"] = "number",
    ["f32"] = "float",
    ["i64"] = "int64",
    ["u64"] = "uint64",
    ["i32"] = "int32",
    ["u32"] = "uint32",
    ["i16"] = "int16",
    ["u16"] = "uint16",
    ["i8"] = "int8",
    ["u8"] = "uint8",
}

--- How one scalar type is written in source.
const text.SOURCE_SCALAR = {
    ["f64"] = "number",
    ["f32"] = "float",
    ["i64"] = "int64",
    ["u64"] = "uint64",
    ["i32"] = "int32",
    ["u32"] = "uint32",
    ["bool"] = "boolean",
}

--- The operator each vector or mask intrinsic is written as.
const text.SIMD_OPERATOR = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["and"] = "&",
    ["or"] = "|",
    ["xor"] = "~",
    ["shl"] = "<<",
    ["shr"] = ">>",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "~=",
}

--- The vector intrinsics written as a method rather than an operator.
const text.SIMD_EXTREMUM = {
    ["propagating_min"] = "propagatingMin",
    ["propagating_max"] = "propagatingMax",
    ["number_min"] = "numberMin",
    ["number_max"] = "numberMax",
}

--- The lane-wise `simd_call` corrections, by the operation each corrects. They
--- name the prelude's own binary32 function rather than a compiled helper.
const text.SIMD_CORRECTION = {["f32_min"] = "min", ["f32_max"] = "max", ["f32_fma"] = "fma",}

--- The operator each scalar operation is written as.
const text.SCALAR_OPERATOR = {
    ["add"] = "+",
    ["sub"] = "-",
    ["mul"] = "*",
    ["div"] = "/",
    ["mod"] = "%",
    ["pow"] = "^",
    ["lt"] = "<",
    ["le"] = "<=",
    ["gt"] = ">",
    ["ge"] = ">=",
    ["eq"] = "==",
    ["ne"] = "~=",
    ["and"] = "and",
    ["or"] = "or",
    ["u32_add"] = "+",
    ["u32_sub"] = "-",
    ["u32_mul"] = "*",
    ["u64_add"] = "+",
    ["u64_sub"] = "-",
    ["u64_mul"] = "*",
    ["i32_add"] = "+",
    ["i32_sub"] = "-",
    ["i32_mul"] = "*",
    ["i64_add"] = "+",
    ["i64_sub"] = "-",
    ["i64_mul"] = "*",
}

--- The scalar operations written as a call rather than an operator.
---
--- Binary32 arithmetic is one of them: `a + b` over two `float` values is
--- binary64 arithmetic in Nupp, and `nupp.math.f32.add(a, b)` is what says the
--- addition itself is single precision.
const text.SCALAR_CALL = {
    ["f32_add"] = "nupp.math.f32.add",
    ["f32_sub"] = "nupp.math.f32.sub",
    ["f32_mul"] = "nupp.math.f32.mul",
    ["f32_div"] = "nupp.math.f32.div",
    ["f32_min"] = "nupp.math.f32.min",
    ["f32_max"] = "nupp.math.f32.max",
    ["f32_sqrt"] = "nupp.math.f32.sqrt",
    ["f32_exp"] = "nupp.math.f32.exp",
}

--- How tightly each operator binds, so a printed expression is parenthesized
--- where the surface would read it differently and nowhere else. Extra
--- parentheses are not free here: `cursor + s.lanes <= #span` is the proof
--- shape the lowerer reads a whole-vector cursor bound out of, and it reads the
--- comparison rather than whatever a parenthesis wrapped it in.
const text.PRECEDENCE = {
    ["or"] = 1,
    ["and"] = 2,
    ["<"] = 3,
    [">"] = 3,
    ["<="] = 3,
    [">="] = 3,
    ["~="] = 3,
    ["=="] = 3,
    ["|"] = 4,
    ["~"] = 5,
    ["&"] = 6,
    ["<<"] = 7,
    [">>"] = 7,
    ["+"] = 9,
    ["-"] = 9,
    ["*"] = 10,
    ["/"] = 10,
    ["%"] = 10,
    ["^"] = 12,
}

--- What a prefix operator binds at, and what a method receiver has to bind at
--- least as tightly as to be written without parentheses.
const text.PREFIX_PRECEDENCE = 11

const text.RECEIVER_PRECEDENCE = 13

--- The explicit narrowing each `numeric_cast` is written as, keyed by the pair
--- it converts between. A conversion that is not here widens, and the surface
--- inserts it at the use site rather than naming it.
const text.SCALAR_CAST = {
    ["f64:u32"] = "nupp.math.u32.wrap",
    ["f64:i32"] = "nupp.math.i32.wrap",
    ["i32:u32"] = "nupp.math.u32.fromI32",
    ["u32:i32"] = "nupp.math.i32.fromU32",
}

--- What one printing run has settled: the species it needs declared, and the
--- surface name each IR name is written under.
record text.Explicit
    --- Species type to the local name it is declared as, and the order they
    --- were first reached in, so the declarations are stable.
    species: {[string]: string}

    order: {string}

    --- The visible pure helpers the printed functions call, and the order they
    --- were first reached in. A helper is a return list in the IR, so it can be
    --- written back out; one that names another compiled entry cannot.
    helpers: {[string]: boolean}

    helperOrder: {string}

    --- The parameters of the function being printed, by name, so an access
    --- can be held to what the surface will let it name.
    params: {[string]: scalarIR.Param}

    --- The written names in scope right now, the binding each open scope
    --- holds, and the names each scope will release. Two sibling regions reuse
    --- one rewrite name where that is a scope apart and legal, and collide
    --- where it is not -- a native local may not shadow another -- so a name
    --- already live takes a suffix and everything under it follows.
    live: {[string]: boolean}

    scopes: {{[string]: string}}

    owned: {{string}}

    --- Whether the printed module reaches for each import.
    usesArray: boolean

    usesSimd: boolean
    usesSpan: boolean
end

--- The family, element and shape of one abstract SIMD type.
local function simdParts(written: string): (string?, string?, string?)
    return written:match("^simd_(%a+)_([fiu]%d+)_(.+)$")
end

--- Refuses to print, naming the construct the surface cannot say. `what`
--- completes "the rewrite produced ...", so it says both what was reached and
--- why nothing can be written for it.
---
--- @raises always: it is reached only where the rewrite produced something the
--- surface has no spelling for, which the caller reports rather than prints.
local function unprintable(what: string): nil
    error("the rewrite produced " .. what, 0)
end

--- The surface name one IR name is printed under. Names the rewrite made
--- carry a `$` so they cannot collide with source names; the surface has no
--- such character, so it is dropped and the rest stands.
local function surfaceName(name: string): string
    return (name:gsub("^%$", ""))
end

--- Opens one scope, and closes it again releasing what it declared.
local function openScope(state: text.Explicit): nil
    state.scopes[#state.scopes + 1] = {}
    state.owned[#state.owned + 1] = {}
end

local function closeScope(state: text.Explicit): nil
    for _, written in ipairs(state.owned[#state.owned]) do
        state.live[written] = nil
    end
    state.scopes[#state.scopes] = nil
    state.owned[#state.owned] = nil
end

--- Declares one local in the innermost scope, under a name nothing live holds.
local function declareName(state: text.Explicit, name: string): string
    local base = surfaceName(name)
    local written = base
    local ordinal = 1
    while state.live[written] == true do
        ordinal = ordinal + 1
        written = base .. "_" .. tostring(ordinal)
    end
    state.live[written] = true
    local owned = state.owned[#state.owned]
    owned[#owned + 1] = written
    state.scopes[#state.scopes][name] = written

    return written
end

--- The name one binding is reached by: whatever the innermost declaration of
--- it was written under, or a parameter's own name.
local function boundName(state: text.Explicit, name: string): string
    for depth = #state.scopes, 1, -1 do
        local written = state.scopes[depth][name]
        if written ~= nil then
            return written as string
        end
    end

    return surfaceName(name)
end

--- The local name the species of one vector, mask or species type is declared
--- under, declaring it on first reach.
local function speciesFor(state: text.Explicit, written: string): string
    local _, element, shape = simdParts(written)
    if element == nil then
        unprintable("a SIMD value of type " .. written .. ", which names no species")
    end
    local speciesType = "simd_species_" .. tostring(element) .. "_" .. tostring(shape)
    local existing = state.species[speciesType]
    if existing ~= nil then
        return existing as string
    end
    local name = "s_" .. tostring(element)
    if shape ~= "preferred" then
        name = name .. "_" .. tostring(shape):gsub("^fixed", "x")
    end
    state.species[speciesType] = name
    state.order[#state.order + 1] = speciesType
    state.usesSimd = true
    state.usesArray = true

    return name
end

--- The `simd.species` call one species type is declared by.
local function speciesCall(written: string): string
    local _, element, shape = simdParts(written)
    local witness = text.ELEMENT_WITNESS[tostring(element)]
    if witness == nil then
        unprintable("a species over element " .. tostring(element) .. ", which nupp.mem.array does not witness")
    end
    local lanes = tostring(shape):match("^fixed(%d+)$")

    return "assert(simd.species(array." .. tostring(witness) .. (lanes ~= nil and ", " .. lanes or "") .. "))"
end

--- The `simd.reducer` constructor one closed contract is created by.
local function reducerConstructor(order: string, operation: string, element: string?): string
    if element ~= nil then
        for path, contract in pairs(reducers.CONSTRUCTORS) do
            if contract.order == order and contract.operation == operation and contract.element == element then
                return (path:gsub("^nupp%.simd%.", "simd."))
            end
        end
        unprintable("a " .. order .. " " .. operation .. " reducer over " .. (element as string))
    end

    return "simd.reducer." .. order .. operation:sub(1, 1):upper() .. operation:sub(2)
end

--- One expression of the rewritten region, as Nupp, parenthesized only where an
--- operator binding as loosely as `minimum` would otherwise take it apart.
function text.explicitExpression(state: text.Explicit, node: any, minimum: integer): string
    local op = tostring(node.op)

    --- One operand, printed where nothing can rebind it.
    local function at(position: integer): string
        return text.explicitExpression(state, node.args[position], 0)
    end

    --- One operand, printed as something a method may be called on.
    local function receiver(position: integer): string
        return text.explicitExpression(state, node.args[position], text.RECEIVER_PRECEDENCE)
    end

    --- One operand of a constructor that converts what it is handed and takes
    --- a binary64 to do it. Printing the conversion as well would say it twice,
    --- and its surface spelling refuses the wider argument it was written over.
    local function coerced(position: integer): string
        local operand = node.args[position]
        while operand.op == "numeric_cast" or operand.op == "int_to_f64" or operand.op == "widen_f32_f64" do
            operand = (operand as scalarIR.Convert).value
        end

        return text.explicitExpression(state, operand, 0)
    end

    --- One infix operator over two operands, at its own binding strength.
    local function infix(left: any, operator: string, right: any): string
        local level = text.PRECEDENCE[operator] as integer
        local rendered = text.explicitExpression(
            state,
            left,
            level
        ) .. " " .. operator .. " " .. text.explicitExpression(state, right, level + 1)

        return level < minimum and "(" .. rendered .. ")" or rendered
    end

    --- One prefix operator over one operand.
    local function prefix(operator: string, value: any): string
        local rendered = operator .. text.explicitExpression(state, value, text.PREFIX_PRECEDENCE)

        return text.PREFIX_PRECEDENCE < minimum and "(" .. rendered .. ")" or rendered
    end

    if op == "helper_param" then
        return (node as scalarIR.Name).name
    elseif op == "local" or op == "uniform" then
        return boundName(state, (node as scalarIR.Name).name)
    elseif op == "constant" or op == "constant_i32" or op == "constant_i64" then
        return tostring(node.value)
    elseif op == "bool" then
        return tostring(node.value)
    elseif op == "span_count" then
        state.usesSpan = true

        return "#" .. tostring((node as scalarIR.SpanCount).span)
    elseif op == "int_to_f64" or op == "widen_f32_f64" then
        -- The surface converts into binary64 wherever one is wanted, so the
        -- promotion is the context's and not a call of its own.
        return text.explicitExpression(state, (node as scalarIR.Convert).value, minimum)
    elseif op == "narrow_f64_f32" then
        return "nupp.math.f32.narrow(" .. text.explicitExpression(state, (node as scalarIR.Convert).value, 0) .. ")"
    elseif op == "numeric_cast" then
        local value = (node as scalarIR.Convert).value
        local named = text.SCALAR_CAST[tostring(value.type) .. ":" .. tostring(node.type)]
        if named == nil then
            return text.explicitExpression(state, value, minimum)
        end

        return tostring(named) .. "(" .. text.explicitExpression(state, value, 0) .. ")"
    elseif op == "neg" then
        return prefix("-", (node as scalarIR.Unary).value)
    elseif op == "not" then
        return prefix("not ", (node as scalarIR.Unary).value)
    elseif op == "simd_lanes_generic" then
        return speciesFor(state, tostring(node.args[1].type)) .. ".lanes"
    elseif op == "simd_splat" then
        return speciesFor(state, tostring(node.type)) .. ":splat(" .. at(1) .. ")"
    elseif op == "simd_iota" then
        return speciesFor(state, tostring(node.type)) .. ":iota(" .. at(1) .. ", " .. at(2) .. ")"
    elseif op == "simd_tail" then
        return speciesFor(state, tostring(node.type)) .. ":tail(" .. coerced(1) .. ")"
    elseif op == "simd_mask_splat" or op == "simd_mask_convert" then
        return speciesFor(state, tostring(node.type)) .. ":mask(" .. at(1) .. ")"
    elseif op == "simd_convert" or op == "simd_reinterpret" then
        local method = op == "simd_convert" and "convert" or "reinterpret"

        return speciesFor(state, tostring(node.type)) .. ":" .. method .. "(" .. at(1) .. ")"
    elseif op == "simd_select" then
        return receiver(1) .. ":select(" .. at(2) .. ", " .. at(3) .. ")"
    elseif op == "simd_mask_any" or op == "simd_mask_all" or op == "simd_mask_count" then
        return receiver(1) .. ":" .. op:gsub("^simd_mask_", "") .. "()"
    elseif op == "simd_unary" then
        local intrinsic = tostring(node.intrinsic)
        if intrinsic ~= "neg" and intrinsic ~= "not" then
            unprintable("the vector operation " .. intrinsic .. ", which no operator or method spells")
        end

        return prefix(intrinsic == "neg" and "-" or "~", node.args[1])
    elseif op == "simd_binary" or op == "simd_compare" then
        local intrinsic = tostring(node.intrinsic)
        local method = text.SIMD_EXTREMUM[intrinsic]
        if method ~= nil then
            return receiver(1) .. ":" .. tostring(method) .. "(" .. at(2) .. ")"
        end
        local operator = text.SIMD_OPERATOR[intrinsic]
        if operator == nil then
            unprintable("a vector " .. intrinsic)
        end

        return infix(node.args[1], tostring(operator), node.args[2])
    elseif op == "simd_math" then
        local arguments: {string} = {"math." .. tostring(node.intrinsic)}
        for position = 1, #node.args do
            arguments[#arguments + 1] = at(position)
        end

        return speciesFor(state, tostring(node.type)) .. ":map(" .. table.concat(arguments, ", ") .. ")"
    elseif op == "simd_call" then
        local correction = node.helper == nil and text.SIMD_CORRECTION[tostring(node.intrinsic)] or nil
        if correction == nil then
            unprintable(
                "a lane-wise call of " .. tostring(node.helper or node.intrinsic) .. ", which s:map does not name"
            )
        end
        local arguments: {string} = {"nupp.math.f32." .. tostring(correction)}
        for position = 1, #node.args do
            arguments[#arguments + 1] = at(position)
        end

        return speciesFor(state, tostring(node.type)) .. ":map(" .. table.concat(arguments, ", ") .. ")"
    elseif op == "simd_load" or op == "simd_field_load" or op == "simd_store" or op == "simd_field_store" then
        local access = node as scalarIR.Simd
        local reading = op == "simd_load" or op == "simd_field_load"
        local field = access.field
        state.usesSpan = true
        -- The IR admits a read through an exclusive borrow, and a rewritten
        -- read-modify-write region takes one; `Species:load` does not, so this
        -- is a region the surface has no way to write.
        local root = access.span ~= nil and state.params[access.span as string] or nil
        if reading and root ~= nil and (root as scalarIR.Param).kind == "write_span" then
            unprintable(
                "a vector read of " .. tostring(
                    access.span
                ) .. ", which is exclusive, and Species:load names a borrowed Span"
            )
        end
        local arguments: {string} = {tostring(access.span), at(2)}
        if field ~= nil then
            arguments[#arguments + 1] = string.format("%q", field as string)
        end
        local value = not reading and 3 or nil
        if value ~= nil then
            arguments[#arguments + 1] = at(value as integer)
        end
        local mask = reading and 3 or 4
        if access.args[mask] ~= nil then
            arguments[#arguments + 1] = at(mask)
        end

        return speciesFor(
            state,
            tostring(access.args[1].type)
        ) .. ":" .. (reading and "load(" or "store(") .. table.concat(arguments, ", ") .. ")"
    elseif op == "helper_call" then
        local call = node as scalarIR.HelperCall
        if state.helpers[call.helper] ~= true then
            state.helpers[call.helper] = true
            state.helperOrder[#state.helperOrder + 1] = call.helper
        end
        local arguments: {string} = {}
        for position = 1, #call.args do
            arguments[position] = at(position)
        end

        return call.helper .. "(" .. table.concat(arguments, ", ") .. ")"
    elseif op == "reducer_init" then
        local reducer = node as scalarIR.ReducerInit
        local _, _, element = reducers.parse(tostring(reducer.type))
        state.usesSimd = true

        return reducerConstructor(
            reducer.order,
            reducer.operation,
            element
        ) .. "(" .. text.explicitExpression(state, reducer.initial, 0) .. ")"
    elseif op == "reducer_value" then
        return text.explicitExpression(
            state,
            (node as scalarIR.ReducerValue).reducer,
            text.RECEIVER_PRECEDENCE
        ) .. ":value()"
    end

    local called = text.SCALAR_CALL[op]
    if called ~= nil then
        if op == "f32_sqrt" or op == "f32_exp" then
            return tostring(
                called
            ) .. "(" .. text.explicitExpression(state, (node as scalarIR.FixedUnary).value, 0) .. ")"
        end
        local pair = node as text.Pair

        return tostring(
            called
        ) .. "(" .. text.explicitExpression(
            state,
            pair.left,
            0
        ) .. ", " .. text.explicitExpression(state, pair.right, 0) .. ")"
    end
    if op == "f32_fma" then
        local corrected = node as scalarIR.Corrected
        local arguments: {string} = {}
        for position, argument in ipairs(corrected.args as {scalarIR.Expr}) do
            arguments[position] = text.explicitExpression(state, argument, 0)
        end

        return "nupp.math.f32.fma(" .. table.concat(arguments, ", ") .. ")"
    end
    local operator = text.SCALAR_OPERATOR[op]
    if operator == nil then
        unprintable("the operation " .. op .. ", which nothing here writes")
    end
    local pair = node as text.Pair

    return infix(pair.left, tostring(operator), pair.right)
end

--- One assignment target of the rewritten region.
local function explicitTarget(state: text.Explicit, assignment: any): string
    if assignment.target.kind ~= "local" then
        unprintable("an assignment to a " .. tostring(assignment.target.kind) .. ", which nothing here assigns")
    end

    return boundName(state, tostring(assignment.target.name))
end

--- One block of the rewritten region, indented by `depth`.
function text.explicitBlock(state: text.Explicit, statements: {any}, depth: integer): {string}
    local lines: {string} = {}
    local prefix = string.rep("    ", depth)

    --- Appends one nested block, under the scope the surface gives it.
    local function nested(body: {any}): nil
        openScope(state)
        for _, line in ipairs(text.explicitBlock(state, body, depth + 1)) do
            lines[#lines + 1] = line
        end
        closeScope(state)
    end

    for _, statement in ipairs(statements) do
        local op = tostring(statement.op)
        if op == "let" and statement.value.op == "simd_species" then
            -- Species bindings are hoisted to the head of the printed function
            -- and named after their element, so the region's own are dropped
            -- rather than printed twice under a name nothing reaches for.
            speciesFor(state, tostring(statement.type))
        elseif op == "let" then
            -- A vector or mask local takes its type from what made it. A
            -- binary64 one seeded with a whole number was an `integer` in the
            -- source this was rewritten from, and only an integer narrows into
            -- a 32-bit value later; anything else is annotated with its width,
            -- because the width is the point.
            local written = tostring(statement.type)
            local whole = written == "f64"
                and statement.value.op == "constant"
                and tostring(statement.value.value):match("^%-?%d+$") ~= nil
            local annotation = whole and "integer" or text.SOURCE_SCALAR[written]
            lines[
                #lines + 1
            ] = prefix .. "local " .. declareName(
                state,
                tostring(statement.name)
            ) .. (
                annotation ~= nil and ": " .. tostring(annotation) or ""
            ) .. " = " .. text.explicitExpression(state, statement.value, 0)
        elseif op == "multi_let" then
            local names: {string} = {}
            for position, bound in ipairs(statement.bindings) do
                names[position] = declareName(state, tostring(bound.name))
            end
            lines[
                #lines + 1
            ] = prefix .. "local " .. table.concat(
                names,
                ", "
            ) .. " = " .. text.explicitExpression(state, statement.call, 0)
        elseif op == "assign" then
            for _, assignment in ipairs(statement.values) do
                lines[
                    #lines + 1
                ] = prefix .. explicitTarget(
                    state,
                    assignment
                ) .. " = " .. text.explicitExpression(state, assignment.value, 0)
            end
        elseif op == "if" then
            for position, clause in ipairs(statement.clauses) do
                lines[
                    #lines + 1
                ] = prefix .. (
                    position == 1 and "if " or "elseif "
                ) .. text.explicitExpression(state, clause.condition, 0) .. " then"
                nested(clause.body)
            end
            if statement.elseBody ~= nil then
                lines[#lines + 1] = prefix .. "else"
                nested(statement.elseBody)
            end
            lines[#lines + 1] = prefix .. "end"
        elseif op == "while" then
            if statement.conditionBody ~= nil then
                unprintable("a loop whose condition needs statements of its own, which no while may hold")
            end
            lines[#lines + 1] = prefix .. "while " .. text.explicitExpression(state, statement.condition, 0) .. " do"
            nested(statement.body)
            lines[#lines + 1] = prefix .. "end"
        elseif op == "break" then
            lines[#lines + 1] = prefix .. "break"
        elseif op == "block" or op == "simd_region" then
            -- A `do` block is the scope of an explicit SIMD region: it is what
            -- the accumulators of the reducers inside it live in.
            lines[#lines + 1] = prefix .. "do"
            nested((statement as scalarIR.SimdRegion).body)
            lines[#lines + 1] = prefix .. "end"
        elseif op == "simd_store" or op == "simd_field_store" then
            lines[#lines + 1] = prefix .. text.explicitExpression(state, statement, 0)
        elseif op == "simd_reducer_add" then
            local contribution = statement as scalarIR.SimdReducerAdd
            local arguments: {string} = {text.explicitExpression(state, contribution.value, 0)}
            if contribution.right ~= nil then
                arguments[#arguments + 1] = text.explicitExpression(state, contribution.right as scalarIR.Expr, 0)
            end
            arguments[#arguments + 1] = text.explicitExpression(state, contribution.mask, 0)
            lines[
                #lines + 1
            ] = prefix .. text.explicitExpression(
                state,
                contribution.reducer,
                text.RECEIVER_PRECEDENCE
            ) .. ":" .. reducers.method(contribution.operation) .. "(" .. table.concat(arguments, ", ") .. ")"
        elseif op == "return" then
            local values: {string} = {}
            for position, value in ipairs(statement.values) do
                values[position] = text.explicitExpression(state, value, 0)
            end
            lines[#lines + 1] = prefix .. "return " .. table.concat(values, ", ")
        elseif op == "fornum" then
            local region = statement as scalarIR.Fornum
            if region.vector == nil then
                unprintable("a counted loop no @simd rewrite replaced, which only ran scalar")
            end
            -- The loop was a scope, and the rewrite that replaced it keeps one:
            -- two `@simd` loops in a body name their cursor the same thing, and
            -- a native local may not shadow another.
            lines[#lines + 1] = prefix .. "do"
            nested(region.vector as {scalarIR.Statement})
            lines[#lines + 1] = prefix .. "end"
        else
            unprintable("the statement " .. op .. ", which nothing here writes")
        end
    end

    return lines
end

--- One parameter, as the printed function declares it.
local function explicitParam(param: scalarIR.Param): string
    local kind = param.kind
    if kind == "read_span" or kind == "write_span" then
        local layout = tostring(param.type):match("^struct:(.+)$")
        local element = layout or text.SOURCE_SCALAR[tostring(param.type)] or param.sourceType
        if element == nil then
            unprintable("a span of " .. tostring(param.type) .. ", which has no written element")
        end

        return (
            kind == "write_span" and "exclusive " or "borrows "
        ) .. param.name .. ": span." .. (kind == "write_span" and "WriteSpan<" or "Span<") .. tostring(element) .. ">"
    end
    local written = param.sourceType or text.SOURCE_SCALAR[tostring(param.type)]
    if written == nil then
        unprintable("a parameter of " .. tostring(param.type) .. ", which has no written type")
    end

    return param.name .. ": " .. tostring(written)
end

--- One visible pure helper, as the printed module declares it.
---
--- A helper is a return list and its parameters in the IR, which is the whole
--- of what the source wrote; one that names another compiled entry is not, and
--- there is nothing here to write back out for it.
local function explicitHelper(state: text.Explicit, helper: scalarIR.Helper): {string}
    if helper.native == true or #helper.values == 0 then
        unprintable("a call of " .. helper.name .. ", which is compiled elsewhere and has no body here")
    end
    local params: {string} = {}
    for position, param in ipairs(helper.params) do
        local written = text.SOURCE_SCALAR[tostring(param.type)]
        if written == nil then
            unprintable("a helper parameter of " .. tostring(param.type) .. ", which has no written type")
        end
        params[position] = param.name .. ": " .. tostring(written)
    end
    local results: {string} = {}
    for position, result in ipairs(helper.resultTypes) do
        results[position] = tostring(text.SOURCE_SCALAR[tostring(result)] or result)
    end
    local returns = #results == 1 and results[1] or "(" .. table.concat(results, ", ") .. ")"
    local values: {string} = {}
    for position, value in ipairs(helper.values) do
        values[position] = text.explicitExpression(state, value, 0)
    end

    return {
        "local function " .. helper.name .. "(" .. table.concat(params, ", ") .. "): " .. returns,
        "    return " .. table.concat(values, ", "),
        "end",
        "",
    }
end

--- Whether any loop in one program was rewritten onto vector operations.
---
--- A function that runs one iteration at a time has nothing to print, and its
--- scalar body is not what this prints: it prints the rewrite.
local function vectorized(statements: {any}): boolean
    for _, statement in ipairs(statements) do
        local op = tostring(statement.op)
        if op == "fornum" and (statement as scalarIR.Fornum).vector ~= nil then
            return true
        elseif op == "block" or op == "simd_region" then
            if vectorized((statement as scalarIR.SimdRegion).body) then
                return true
            end
        elseif op == "if" then
            for _, clause in ipairs(statement.clauses) do
                if vectorized(clause.body) then
                    return true
                end
            end
            if statement.elseBody ~= nil and vectorized(statement.elseBody as {any}) then
                return true
            end
        elseif (op == "while" or op == "repeat" or op == "fornum") and vectorized(statement.body) then
            return true
        end
    end

    return false
end

--- One program's rewritten regions, as the function somebody could have
--- written instead. Nil when nothing in it was vectorized.
local function explicitFunction(program: scalarIR.Program, state: text.Explicit): {string}?
    local vector = program.vector
    local statements = program.body or {}
    if vector ~= nil then
        statements = vector as {scalarIR.Statement}
    elseif program.loop ~= nil then
        statements = (program.loop as scalarIR.Loop).statements
    end
    if vector == nil and not vectorized(statements) then
        return nil
    end
    state.params = {}
    state.live = {}
    state.scopes = {}
    state.owned = {}
    openScope(state)
    for _, param in ipairs(program.params) do
        state.params[param.name] = param
        state.live[param.name] = true
    end
    local body = text.explicitBlock(state, statements, 1)
    closeScope(state)

    local params: {string} = {}
    for position, param in ipairs(program.params) do
        params[position] = explicitParam(param)
        state.params[param.name] = param
        if param.kind == "read_span" or param.kind == "write_span" then
            state.usesSpan = true
        end
    end
    local results = program.resultTypes or {}
    local written: {string} = {}
    for position, result in ipairs(results) do
        written[position] = tostring(text.SOURCE_SCALAR[tostring(result)] or result)
    end
    local returns = #written == 0 and "nil" or #written == 1 and written[1] or "(" .. table.concat(written, ", ") .. ")"

    local lines: {string} = {}
    if program.fpContract == true then
        lines[#lines + 1] = '@relax("fp-contract")'
    end
    if program.fpTranscendentals == true then
        lines[#lines + 1] = '@relax("fp-transcendentals")'
    end
    lines[#lines + 1] = "@aot"
    -- One line while it reads as one, and a parameter per line once it does
    -- not: a rewritten kernel takes its spans, its bounds and its uniforms, and
    -- run together they are the widest line in the file.
    local signature = "local function " .. program.name .. "(" .. table.concat(params, ", ") .. "): " .. returns
    if #signature <= 100 then
        lines[#lines + 1] = signature
    else
        lines[#lines + 1] = "local function " .. program.name .. "("
        for position, param in ipairs(params) do
            lines[#lines + 1] = "    " .. param .. (position < #params and "," or "")
        end
        lines[#lines + 1] = "): " .. returns
    end
    for _, speciesType in ipairs(state.order) do
        lines[#lines + 1] = "    local " .. tostring(state.species[speciesType]) .. " = " .. speciesCall(speciesType)
    end
    for _, line in ipairs(body) do
        lines[#lines + 1] = line
    end
    lines[#lines + 1] = "end"

    return lines
end

--- Every rewritten region in one file, as one Nupp module.
---
--- A file whose functions all ran one iteration at a time prints nothing,
--- which is the honest answer: there is no rewrite to show.
function text.explicitPrograms(programs: {scalarIR.Program}): string
    local state = new text.Explicit(
        species = {},
        order = {},
        helpers = {},
        helperOrder = {},
        params = {},
        live = {},
        scopes = {},
        owned = {},
        usesArray = false,
        usesSimd = false,
        usesSpan = false
    )
    local bodies: {string} = {}
    local names: {string} = {}
    local layouts: {string} = {}
    local helpers: {string} = {}
    local seen: {[string]: boolean} = {}
    local declared: {[string]: boolean} = {}
    for _, program in ipairs(programs) do
        -- One species table per function: the declarations are its own locals,
        -- and two functions in a file rarely reach for the same set.
        state.species = {}
        state.order = {}
        local printed = explicitFunction(program, state)
        if printed ~= nil then
            for _, layout in ipairs(program.layouts or {}) do
                if not seen[layout.name] then
                    seen[layout.name] = true
                    layouts[#layouts + 1] = "local struct " .. layout.name
                    for _, field in ipairs(layout.fields) do
                        layouts[#layouts + 1] = "    " .. field.name .. ": " .. tostring(field.sourceType)
                    end
                    layouts[#layouts + 1] = "end"
                    layouts[#layouts + 1] = ""
                end
            end
            -- Helpers first: the functions that call them come after, and a
            -- helper reached from two functions is written once.
            for _, wanted in ipairs(state.helperOrder) do
                if not declared[wanted] then
                    declared[wanted] = true
                    for _, helper in ipairs(program.helpers or {}) do
                        if helper.name == wanted then
                            for _, line in ipairs(explicitHelper(state, helper)) do
                                helpers[#helpers + 1] = line
                            end
                        end
                    end
                end
            end
            names[#names + 1] = program.name
            for _, line in ipairs(printed as {string}) do
                bodies[#bodies + 1] = line
            end
            bodies[#bodies + 1] = ""
        end
    end
    if #names == 0 then
        return ""
    end

    local lines: {
        string
    } = {
        "-- The `@simd` loops of this file, as the compiler rewrote them: printed from",
        "-- the verified IR by `nupp aot --emit simd`, and not what the source says.",
    }
    if state.usesSpan then
        lines[#lines + 1] = 'local span = require("nupp.mem.span")'
    end
    if state.usesArray then
        lines[#lines + 1] = 'local array = require("nupp.mem.array")'
    end
    if state.usesSimd then
        lines[#lines + 1] = 'local simd = require("nupp.simd")'
    end
    lines[#lines + 1] = ""
    for _, line in ipairs(layouts) do
        lines[#lines + 1] = line
    end
    for _, line in ipairs(helpers) do
        lines[#lines + 1] = line
    end
    for _, line in ipairs(bodies) do
        lines[#lines + 1] = line
    end
    local exported: {string} = {}
    for position, name in ipairs(names) do
        exported[position] = name .. " = " .. name
    end
    lines[#lines + 1] = "return {" .. table.concat(exported, ", ") .. "}"

    return table.concat(lines, "\n") .. "\n"
end

export = text
