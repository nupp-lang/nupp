module nupp.compiler.aot.gpuartifact

--[[
Backend-neutral artifacts for the checked GPU kernel subset.

SPIR-V is the native WGPU artifact and WGSL is the browser WebGPU artifact.
Both are emitted from the same verified scalar IR and share the compiler-owned
buffer order, uniform layout, entrypoint and dispatch shape below.
]]

local scalarIR = require("nupp.compiler.aot.scalar")
local spirvemit = require("nupp.compiler.aot.spirvemit")
local visit = require("nupp.compiler.aot.visit")
local wgslemit = require("nupp.compiler.aot.wgslemit")

local gpuartifact = {}

record gpuartifact.Artifact
    spirv: string

    --- Browser source for the exact integer WebGPU profile. Native WGPU
    --- artifacts remain valid even when their IR lies outside that profile.
    wgsl: string?

    entrypoint: string
    readonly: {scalarIR.Param}
    writable: {scalarIR.Param}
    uniforms: {scalarIR.Param}
    uniformBytes: integer
    threads: integer

    --- The span whose length bounds the dispatch.
    countSpan: string

    --- Spans the kernel addresses by the dispatch index or a length guard
    --- promises equal, so the host binding must hold their buffers to the
    --- dispatch length. A span reached only through proved cursors is absent:
    --- its bound check travels inside the shader.
    exactCounts: {[string]: boolean}

    --- Whether declaration replacements may publish their generated nominal
    --- surfaces from a declared module.
    exportTypes: boolean?
end

const STORAGE_TYPE: {
    [string]: boolean
} = {float = true, int8 = true, int16 = true, int32 = true, uint8 = true, uint16 = true, uint32 = true,}

const UNIFORM_TYPE: {[string]: boolean} = {f32 = true, i32 = true, u32 = true,}

local function identifier(value: string): string
    return (value:gsub("[^%w_]", "_"))
end

local function fixedStorage(param: scalarIR.Param): boolean
    return param.type:match("^struct:") ~= nil
        or (param.sourceType ~= nil and STORAGE_TYPE[param.sourceType as string] == true)
end

--- The GPU subset rule a verified program breaks, or nil when it breaks none.
---
--- One place for every rule, so what the subset admits can be read top to
--- bottom -- and so a rule is a value the caller reports, not a raise it has to
--- tell from a compiler bug.
local function outsideSubset(
    program: scalarIR.Program,
    spans: {scalarIR.Param},
    writable: {scalarIR.Param},
    uniforms: {scalarIR.Param},
    uniformBytes: integer
): string?
    if program.executionTarget ~= "gpu" then
        return "GPU emission requires @aot(target = \"gpu\")"
    end
    local loop = program.loop
    local workgroup = program.workgroup
    if program.entryMode ~= "kernel" or (loop ~= nil) == (workgroup ~= nil) then
        return "GPU entry must be a map or phased workgroup kernel"
    end
    if loop ~= nil
        and ((loop as scalarIR.Loop).first ~= 1 or (loop as scalarIR.Loop).last ~= (loop as scalarIR.Loop).count)
    then
        return "GPU entry must dispatch one complete span"
    end
    for _, param in ipairs(program.params) do
        if param.kind == "read_span" or param.kind == "write_span" then
            if not fixedStorage(param) then
                return "GPU span must have fixed-width elements"
            end
        elseif param.kind == "uniform" then
            if param.type == "bool" then
                return "GPU boolean uniforms are not yet supported"
            elseif UNIFORM_TYPE[param.type] ~= true then
                return "GPU uniform must have fixed width"
            end
        else
            return "GPU subset does not admit scalar ABI parameters"
        end
    end
    if #writable < 1 then
        return "GPU kernels require a writable span"
    end
    for _, param in ipairs(uniforms) do
        for _, span in ipairs(spans) do
            if param.name == span.name .. "_count" then
                return "GPU uniform name collides with a span count: " .. param.name
            elseif param.name == span.name .. "_offset" then
                return "GPU uniform name collides with a span offset: " .. param.name
            end
        end
    end
    if uniformBytes > 128 then
        return "GPU uniform block exceeds 128 bytes"
    end

    return nil
end

--- Emits one verified GPU program, or says which subset rule it violates.
---
--- Browser builds require the narrower WGSL profile; native builds retain WGSL
--- only when the same program happens to satisfy it.
--- @return the artifact, or nil and the rule the program is outside
function gpuartifact.program(program: scalarIR.Program, browser: boolean?): (gpuartifact.Artifact?, string?)
    local loop = program.loop
    local workgroup = program.workgroup
    local readonly: {scalarIR.Param} = {}
    local writable: {scalarIR.Param} = {}
    local uniforms: {scalarIR.Param} = {}
    local spans: {scalarIR.Param} = {}
    for _, param in ipairs(program.params) do
        if param.kind == "read_span" then
            readonly[#readonly + 1] = param
            spans[#spans + 1] = param
        elseif param.kind == "write_span" then
            writable[#writable + 1] = param
        elseif param.kind == "uniform" then
            uniforms[#uniforms + 1] = param
        end
    end
    for _, param in ipairs(writable) do
        spans[#spans + 1] = param
    end
    local uniformBytes = 4 * (1 + 2 * #spans + #uniforms)
    local rule = outsideSubset(program, spans, writable, uniforms, uniformBytes)
    if rule ~= nil then
        return nil, rule
    end

    local exactCounts: {[string]: boolean} = {}
    for _, guard in ipairs(program.guards) do
        exactCounts[guard.left] = true
        exactCounts[guard.right] = true
    end
    visit.program(
        program,
        new visit.Visitor(
            scalarExpression = function(value: scalarIR.Expr): nil
                if (value.op == "load" or value.op == "element_ref") and (value as any).cursor == nil then
                    exactCounts[(value as any).span as string] = true
                end
            end,
            scalarStatement = function(statement: scalarIR.Statement): nil
                if statement.op == "store" and (statement as scalarIR.Store).cursor == nil then
                    exactCounts[(statement as scalarIR.Store).span] = true
                end
            end
        )
    )

    local threads: integer = workgroup ~= nil and (workgroup as scalarIR.Workgroup).size or 256
    local spirv = spirvemit.program(program, readonly, writable, uniforms, threads)
    local wgsl, profile = wgslemit.program(program, readonly, writable, uniforms, threads)
    if browser and wgsl == nil then
        return nil, profile
    end

    return new gpuartifact.Artifact(
        spirv = spirv,
        wgsl = wgsl,
        entrypoint = identifier(program.symbol) .. "_gpu",
        readonly = readonly,
        writable = writable,
        uniforms = uniforms,
        uniformBytes = uniformBytes,
        threads = threads,
        countSpan = workgroup ~= nil and (workgroup as scalarIR.Workgroup).dispatchSpan
        or (loop as scalarIR.Loop).count,
        exactCounts = exactCounts
    ), nil
end

export = gpuartifact
