--[[
Rendering a diagnostic for a person to read.

The one place that turns a diagnostic into the conventional
`file:line:col: severity: code: message` line, with the offending source line
under it and a caret run marking the range. The CLI and the build both report
through here, so a compiler error looks the same wherever it surfaced.

Colour comes from `nupp.compiler.ansi`, which decides once whether stderr is something
worth writing escape codes to; when it is not, the styles are identity functions
and what comes out is byte-for-byte what it always was. The caret run is painted
in the severity's own colour, so the eye reaches the marked span by the same
route it reached the word "error".

A whole report is built up and written once. stderr is unbuffered, so a line at
a time was a write syscall per line — five or six per diagnostic — where the
reader only ever sees the finished report anyway.

See `docs/diagnostics.md` for the shape of what is being rendered, and
`nupp check --json` for the form meant for programs.
]]

local ansi = require("nupp.compiler.ansi")

local diagnostics = {}

local REPORTED = {note = "note", warning = "warning"}

--- Whether a diagnostic stops a build. A note and a warning are reported and stepped
--- over; everything else is an error, including a diagnostic with no severity, since
--- everything that predates severities was one.
function diagnostics.isFatal(e: {
    readonly severity: string?
}): boolean
    return REPORTED[e.severity] == nil
end

local function readFile(path)
    local file = io.open(path, "rb")
    if not file then
        return nil
    end
    local source = file:read("*a")
    file:close()

    return source
end

local function lineText(source, wanted)
    if not source or not wanted or wanted < 1 then
        return nil
    end
    local line, start = 1, 1
    while line < wanted do
        local newline = source:find("\n", start, true)
        if not newline then
            return nil
        end
        start, line = newline + 1, line + 1
    end
    local finish = source:find("\n", start, true) or (#source + 1)

    return source:sub(start, finish - 1):gsub("\r$", "")
end

--- The quoted source line and the caret run under it, appended to the report. Nothing
--- is appended when the source could not be read, since a rail with no line beside it
--- says less than leaving it out.
local function writeSourceMark(out, style, paint, source, diagnostic)
    local shown = lineText(source, diagnostic.line)
    if not shown then
        return
    end
    local number = tostring(diagnostic.line)
    local col = math.max(1, diagnostic.col or 1)
    -- Tabs are copied through rather than counted as one column, so the carets land
    -- under the span however the line was indented.
    local prefix = shown:sub(1, col - 1):gsub("[^\t]", " ")
    local available = math.max(1, #shown - col + 1)
    local length = math.max(1, math.min(diagnostic.length or 1, available))
    local rail = style.gutter(" " .. number .. " |")
    local blank = style.gutter(" " .. (" "):rep(#number) .. " |")
    out[#out + 1] = rail .. " " .. shown .. "\n"
    out[#out + 1] = blank .. " " .. prefix .. paint("^" .. ("~"):rep(length - 1)) .. "\n"
end

--- Writes diagnostics and returns whether an error was present.
function diagnostics.report(values: {any}): boolean
    if #values == 0 then
        return false
    end
    local style = ansi.style(io.stderr)
    local failed = false
    local sources = {}
    local out: {string} = {}
    local function sourceFor(path)
        if not path then
            return nil
        end
        if sources[path] == nil then
            sources[path] = readFile(path) or false
        end

        return sources[path] or nil
    end

    for _, diagnostic in ipairs(values) do
        local severity = REPORTED[diagnostic.severity] or "error"
        if severity == "error" then
            failed = true
        end
        local paint = ansi.forSeverity(style, severity)
        local code = diagnostic.code or ""
        if diagnostic.lint then
            -- The name is what a suppression or a config entry writes, so it is said
            -- beside the code rather than instead of it.
            code = code ~= "" and (code .. " " .. diagnostic.lint) or diagnostic.lint
        end
        if code ~= "" then
            code = style.faint(code .. ":") .. " "
        end
        out[
            #out + 1
        ] = style.path(
            ("%s:%d:%d:"):format(diagnostic.filename or "?", diagnostic.line or 0, diagnostic.col or 0)
        ) .. " " .. paint(severity) .. ": " .. code .. style.strong(diagnostic.msg or "error") .. "\n"
        writeSourceMark(out, style, paint, sourceFor(diagnostic.filename), diagnostic)
        local notePaint = ansi.forSeverity(style, "note")
        for _, related in ipairs(diagnostic.related or {}) do
            out[
                #out + 1
            ] = style.path(
                (
                    "%s:%d:%d:"
                ):format(related.filename or diagnostic.filename or "?", related.line or 0, related.col or 0)
            ) .. " " .. notePaint("note") .. ": " .. (related.message or "related location") .. "\n"
            writeSourceMark(out, style, notePaint, sourceFor(related.filename or diagnostic.filename), related)
        end
        for _, note in ipairs(diagnostic.notes or {}) do
            out[#out + 1] = notePaint("note") .. ": " .. note .. "\n"
        end
        if diagnostic.help then
            out[#out + 1] = ansi.forSeverity(style, "help")("help") .. ": " .. diagnostic.help .. "\n"
        end
    end
    io.stderr:write(table.concat(out))

    return failed
end

return diagnostics
