module nupp.compiler.bundled

--[[
The declarations the compiler carries with it.

A build leaves them on disk beside the compiled modules. The stage-0 bundle
cannot: it is one file, and one file cannot bring a directory along, so it
carries them inside itself as a preloaded module of path -> source. One read
answers for both.

Deliberately only the compiler's own declarations, and deliberately not a general
virtual filesystem layered under every read. A VFS would let an in-memory entry
shadow a real file the user wrote at the same path, and then which one wins is a
question the language would have to answer forever. This answers a much smaller
one: where the compiler keeps its own prelude.

A module of its own because two callers want it and they are on opposite sides of
the compiler. The checker loads the prelude through it, and documentation renders
the same declarations through it; a shared leaf is what keeps the second from
importing the first.
]]

local bundled = {}

local function moduleDir(): string
    local source = debug.getinfo(1, "S").source
    return source:match("^@(.*)[/\\]") or "."
end

local function readFile(path: string): string?
    local file = io.open(path, "rb")
    if not file then
        return nil
    end
    local content = file:read("*a")
    file:close()

    return content
end

local embedded: any = nil

--- The checkout these carried files were copied out of, when there is one.
---
--- Nothing to compare against in the two cases that answer nil: a stamped binary
--- carries its declarations inside itself, and a compiler loaded straight from
--- `src` is already reading the only copy there is.
local function checkoutRoot(): string?
    local dir = moduleDir():gsub("\\", "/")
    if dir:match("/src/nupp/compiler$") then
        return nil
    end

    return dir:match("^(.*)/build/nupp/compiler$") or os.getenv("NUPP_COMPILER_ROOT")
end

--- Where a carried file was copied from. The build writes the declarations under
--- `src/nupp/compiler/decls` beside the compiled modules as `/decls`, and
--- everything else it carries keeps the path it has under `src`.
---
--- A guess, in the sense that the manifest owns the real mapping and this does not
--- read it. It is a safe one: a path this gets wrong names a file that is not
--- there, and a file that is not there is one this says nothing about.
local function sourcePath(root: string, relative: string): string
    if relative:sub(1, 7) == "/decls/" then
        return root .. "/src/nupp/compiler" .. relative
    end

    return root .. "/src" .. relative
end

--- Where a carried file was copied from, or nil when nothing carried it.
---
--- Exported because the mapping above is the fragile half of this: it restates
--- what the manifest already says, and a test that walks it is what keeps the two
--- from drifting apart in silence.
---
--- @param relative the path under the compiled modules, beginning with a slash
--- @return the path in `src` it was copied from, or nil outside a checkout
function bundled.sourcePathFor(relative: string): string?
    local root = checkoutRoot()
    if root == nil then
        return nil
    end

    return sourcePath(root, relative)
end

local staleRelative: {string} = {}
local staleSeen: {[string]: boolean} = {}

--- Records a carried file that no longer matches the source it was copied from.
local function noteStale(relative: string, carried: string): nil
    if staleSeen[relative] then
        return
    end
    local root = checkoutRoot()
    if root == nil then
        return
    end
    local current = readFile(sourcePath(root, relative))
    if current ~= nil and current ~= carried then
        staleSeen[relative] = true
        staleRelative[#staleRelative + 1] = relative
    end
end

--- The carried declarations this run read that its checkout has since changed.
---
--- Empty for a stamped binary and for a compiler running out of `src`, which are
--- the two shapes with nothing to disagree with. Only files actually read are
--- reported, so this costs one extra read of each declaration a command reaches
--- rather than a walk of everything the compiler carries.
---
--- @return the paths, in the spelling `source` takes, or an empty list
function bundled.staleDeclarations(): {string}
    return staleRelative
end

--- The source of one declaration the compiler carries, or nil when it carries no such
--- file.
---
--- `relative` is the path under the compiled modules, leading slash and all:
--- `/decls/prelude.d.nupp`.
---
--- @param relative the path under the compiled modules, beginning with a slash
--- @return the source, or nil when this compiler carries no file by that name
function bundled.source(relative: string): string?
    if embedded == nil then
        local preloaded = package.preload["nupp.embedded"]
        embedded = preloaded and preloaded() or false
    end
    if embedded and embedded[relative] then
        return embedded[relative]
    end
    local carried = readFile(moduleDir() .. relative)
    if carried ~= nil then
        noteStale(relative, carried)
    end

    return carried
end

--- The directory the compiled compiler modules were loaded from.
---
--- @return the directory, without a trailing separator, or "." when there is none
function bundled.moduleDir(): string
    return moduleDir()
end

--- Every carried file under one directory, in the same spelling `source` takes.
---
--- The counterpart to `source` for a caller that has a directory rather than a
--- filename: `bundled.source` answers about a path already known, and a project
--- template is a tree whose shape is the template's business rather than this
--- compiler's. Both readings are here for the same reason `source` has two -- a
--- stamped binary is one file and a development tree is a directory -- and they
--- have to agree, so the disk walk returns the same leading-slash relative
--- spellings the embedded keys use.
---
--- Sorted, so a caller that hashes or prints the result gets one answer.
---
--- @param prefix the directory under the compiled modules, beginning with a slash
--- @return the paths under it, beginning with a slash, or an empty list
function bundled.list(prefix: string): {string}
    if embedded == nil then
        local preloaded = package.preload["nupp.embedded"]
        embedded = preloaded and preloaded() or false
    end
    local found: {string} = {}
    if embedded then
        for path in pairs(embedded as {[string]: string}) do
            if path:sub(1, #prefix + 1) == prefix .. "/" then
                found[#found + 1] = path
            end
        end
        table.sort(found)

        return found
    end
    -- No embedded table means the modules were loaded from a directory, so the
    -- files are beside them. `nupp.io.files` rather than `nupp.compiler.fs`
    -- because this module is a leaf on purpose: the checker and the doc
    -- generator both load it, and a require here would drag one into the other.
    local pending: {string} = {prefix}
    while #pending > 0 do
        local relative = table.remove(pending) as string
        for _, entry in ipairs(nupp.io.files.list(moduleDir() .. relative) or {}) do
            local child = relative .. "/" .. entry.name
            if entry.kind == "directory" then
                pending[#pending + 1] = child
            elseif entry.kind == "file" then
                found[#found + 1] = child
            end
        end
    end
    table.sort(found)

    return found
end

export = bundled
