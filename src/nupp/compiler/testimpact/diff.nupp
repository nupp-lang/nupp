@!internal

module nupp.compiler.testimpact.diff

-- Repository change discovery for impact-selected test runs.
--
-- The runner consumes this module through runner.impact. Keeping Git details
-- here gives the selector one normalized description of committed, staged,
-- unstaged, untracked, deleted, and renamed paths.
local process = require("nupp.compiler.build.process")
local fs = require("nupp.compiler.fs")

local diff = {}

local function normalize(path)
    return fs.normalize(path):gsub("^%./", "")
end

local function trim(output)
    return (output:gsub("[%s\r\n]+$", ""))
end

local function failure(code, reason, details)
    return {available = false, code = code, reason = reason, details = details, changes = {}, paths = {},}
end

local function capture(argv, cwd, captureProcess)
    return captureProcess(argv, {cwd = cwd})
end

local function nulFields(output)
    local fields = {}
    local first = 1
    while first <= #output do
        local last = output:find("\0", first, true)
        if not last then
            fields[#fields + 1] = output:sub(first)
            break
        end
        fields[#fields + 1] = output:sub(first, last - 1)
        first = last + 1
    end

    return fields
end

local statusNames = {
    A = "added",
    C = "copied",
    D = "deleted",
    M = "modified",
    R = "renamed",
    T = "type-changed",
    U = "unmerged",
    X = "unknown",
}

local function parseNameStatus(output, source)
    local fields = nulFields(output)
    local changes = {}
    local index = 1
    while index <= #fields do
        local rawStatus = fields[index]
        index = index + 1
        local statusCode = rawStatus:sub(1, 1)
        local oldPath
        local path
        if statusCode == "R" or statusCode == "C" then
            oldPath = fields[index]
            path = fields[index + 1]
            index = index + 2
        else
            path = fields[index]
            index = index + 1
        end
        if not path then
            return nil, "truncated git name-status output"
        end
        changes[
            #changes + 1
        ] = {
            status = statusNames[statusCode] or "unknown",
            rawStatus = rawStatus,
            path = normalize(path),
            oldPath = oldPath and normalize(oldPath) or nil,
            sources = {source},
        }
    end

    return changes
end

local function parseUntracked(output)
    local changes = {}
    for _, path in ipairs(nulFields(output)) do
        changes[#changes + 1] = {status = "added", rawStatus = "?", path = normalize(path), sources = {"untracked"},}
    end

    return changes
end

local statusPriority = {
    modified = 1,
    ["type-changed"] = 2,
    added = 3,
    deleted = 3,
    copied = 4,
    renamed = 5,
    unmerged = 6,
    unknown = 7,
}

local function mergeChanges(groups)
    local merged = {}
    local byIdentity = {}
    for _, group in ipairs(groups) do
        for _, change in ipairs(group) do
            local key = (change.oldPath or "") .. "\0" .. change.path
            local prior = byIdentity[key]
            if not prior then
                prior = change
                byIdentity[key] = prior
                merged[#merged + 1] = prior
            else
                prior.sources[#prior.sources + 1] = change.sources[1]
                if (statusPriority[change.status] or 0) > (statusPriority[prior.status] or 0) then
                    prior.status = change.status
                    prior.rawStatus = change.rawStatus
                end
            end
        end
    end
    table.sort(merged, function(left, right)
        local leftKey = (left.oldPath or "") .. "\0" .. left.path
        local rightKey = (right.oldPath or "") .. "\0" .. right.path
        return leftKey < rightKey
    end)
    for _, change in ipairs(merged) do
        table.sort(change.sources)
    end

    return merged
end

local function changedPaths(changes)
    local seen = {}
    local paths = {}
    for _, change in ipairs(changes) do
        if change.oldPath and not seen[change.oldPath] then
            seen[change.oldPath] = true
            paths[#paths + 1] = change.oldPath
        end
        if change.path and not seen[change.path] then
            seen[change.path] = true
            paths[#paths + 1] = change.path
        end
    end
    table.sort(paths)

    return paths
end

--- Discovers repository-relative changes for an impact query.
---
--- With no ref, the base is HEAD and only working-tree changes are returned.
--- With a ref, committed changes from merge-base(ref, HEAD) to HEAD are added.
--- `capture` is injectable for focused tests; ordinary callers use the
--- compiler's argv-based process utility.
---
--- Success is `{available, root, head, base, ref?, paths, changes}`. Each
--- change has `{status, rawStatus, path, oldPath?, sources}`. Failure is the
--- same plain-data boundary with `available = false`, `code`, `reason`, and
--- `details`, plus empty path and change arrays.
function diff.discover(options)
    options = options or {}
    local cwd = options.cwd or "."
    local captureProcess = options.capture or process.capture

    local rootCode, rootOutput = capture({"git", "rev-parse", "--show-toplevel"}, cwd, captureProcess)
    if rootCode ~= 0 then
        return failure("git-unavailable", "test impact discovery requires a Git work tree", trim(rootOutput))
    end
    local root = normalize(trim(rootOutput))

    local headCode, headOutput = capture({"git", "rev-parse", "--verify", "HEAD"}, root, captureProcess)
    if headCode ~= 0 then
        return failure("head-unavailable", "test impact discovery requires a committed HEAD", trim(headOutput))
    end
    local head = trim(headOutput)
    local base = head
    local groups = {}

    if options.ref then
        local refCode, refOutput = capture(
            {"git", "rev-parse", "--verify", tostring(options.ref)},
            root,
            captureProcess
        )
        if refCode ~= 0 then
            return failure("invalid-ref", "cannot resolve impact base " .. tostring(options.ref), trim(refOutput))
        end
        local resolvedRef = trim(refOutput)
        local baseCode, baseOutput = capture({"git", "merge-base", resolvedRef, head}, root, captureProcess)
        if baseCode ~= 0 then
            return failure(
                "merge-base-unavailable",
                "cannot find a merge base for " .. tostring(options.ref) .. " and HEAD",
                trim(baseOutput)
            )
        end
        base = trim(baseOutput)
        local committedCode, committedOutput = capture(
            {"git", "diff", "--name-status", "-z", "-M", base, head, "--"},
            root,
            captureProcess
        )
        if committedCode ~= 0 then
            return failure("committed-diff-failed", "cannot read committed changes", trim(committedOutput))
        end
        local committed, parseError = parseNameStatus(committedOutput, "committed")
        if not committed then
            return failure("invalid-git-output", parseError, "committed diff")
        end
        groups[#groups + 1] = committed
    end

    local stagedCode, stagedOutput = capture(
        {"git", "diff", "--cached", "--name-status", "-z", "-M", head, "--"},
        root,
        captureProcess
    )
    if stagedCode ~= 0 then
        return failure("staged-diff-failed", "cannot read staged changes", trim(stagedOutput))
    end
    local staged, stagedError = parseNameStatus(stagedOutput, "staged")
    if not staged then
        return failure("invalid-git-output", stagedError, "staged diff")
    end
    groups[#groups + 1] = staged

    local unstagedCode, unstagedOutput = capture(
        {"git", "diff", "--name-status", "-z", "-M", "--"},
        root,
        captureProcess
    )
    if unstagedCode ~= 0 then
        return failure("unstaged-diff-failed", "cannot read unstaged changes", trim(unstagedOutput))
    end
    local unstaged, unstagedError = parseNameStatus(unstagedOutput, "unstaged")
    if not unstaged then
        return failure("invalid-git-output", unstagedError, "unstaged diff")
    end
    groups[#groups + 1] = unstaged

    local untrackedCode, untrackedOutput = capture(
        {"git", "ls-files", "--others", "--exclude-standard", "-z", "--"},
        root,
        captureProcess
    )
    if untrackedCode ~= 0 then
        return failure("untracked-diff-failed", "cannot read untracked paths", trim(untrackedOutput))
    end
    groups[#groups + 1] = parseUntracked(untrackedOutput)

    local changes = mergeChanges(groups)

    return {
        available = true,
        root = root,
        head = head,
        base = base,
        ref = options.ref,
        changes = changes,
        paths = changedPaths(changes),
    }
end

diff.normalizePath = normalize

export = diff
