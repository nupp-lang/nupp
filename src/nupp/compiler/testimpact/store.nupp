@!internal

module nupp.compiler.testimpact.store

--[[
This module stores the authoritative observation behind diff-directed test
selection.

The runner observes names and paths in whatever order its workers finish. This
module turns that observation into sorted, integer-indexed plain data, then
keeps it through the compiler's binary store. A reader either receives the
exact graph it asked for or no graph at all: the project revision, host,
runner-facing catalog, graph builder and format all take part in the stamp.

Only an unfiltered, successful, complete run may replace the last graph. The
store writes atomically and treats an unreadable binary as absent, while the
validation here rejects decoded-but-malformed data before selection can trust
an id from it.
]]

local binaryStore = require("nupp.compiler.build.store")
local fs = require("nupp.compiler.fs")

local impact = {}

--- Separates graph compatibility from the binary store's envelope version.
--- Bump this whenever the arrays written below change meaning or shape.
local FORMAT: integer = 1

--- Identifies the code which derives edges, separately from their shape.
local BUILDER: string = "test-impact-graph/2"

--- Lists the exact identity fields in their encoded order.
local STAMP_FIELDS = {
    "project",
    "revision",
    "operatingSystem",
    "architecture",
    "runtime",
    "targetProfile",
    "suiteCatalog",
    "stableIds",
}

local function nonempty(value: any): string?
    if type(value) == "string" and value ~= "" then
        return value
    end

    return nil
end

local function stampsOf(stamps: any): {string}?, string?
    if type(stamps) ~= "table" then
        return nil, "test-impact stamps are missing"
    end
    local out: {string} = {}
    for _, field in ipairs(STAMP_FIELDS) do
        local value = nonempty(stamps[field])
        if not value then
            return nil, "test-impact stamp " .. field .. " is missing"
        end
        out[#out + 1] = value
    end

    return out, nil
end

--- Builds a collision-free store stamp for one exact graph identity.
local function cacheStamp(stamps: any): string?, string?
    local values, problem = stampsOf(stamps)
    if not values then
        return nil, problem
    end
    local parts = {BUILDER, tostring(FORMAT)}
    for index, value in ipairs(values) do
        parts[#parts + 1] = STAMP_FIELDS[index]
        parts[#parts + 1] = tostring(#value)
        parts[#parts + 1] = value
    end

    return table.concat(parts, "\0"), nil
end

local function normalizedPath(path: any): string?
    path = nonempty(path)
    if not path then
        return nil
    end
    path = fs.normalize(path)
    if path == "" or path == "." or path:sub(1, 1) == "/" or path:match("^[A-Za-z]:/") then
        return nil
    end

    local parts: {string} = {}
    for part in path:gmatch("[^/]+") do
        if part == ".." then
            if #parts == 0 then
                return nil
            end
            table.remove(parts)
        elseif part ~= "." and part ~= "" then
            parts[#parts + 1] = part
        end
    end
    path = table.concat(parts, "/")
    if path == "" then
        return nil
    end

    return path
end

--- Builds the stable external identity of a case.
---
--- Length-prefixing keeps a separator inside either component from making two
--- pairs equal.
function impact.caseIdentity(suitePath: string, caseId: string): string?, string?
    local suite = normalizedPath(suitePath)
    local id = nonempty(caseId)
    if not suite then
        return nil, "test-impact suite path is missing"
    end
    if not id then
        return nil, "test-impact case id is missing"
    end

    return tostring(#suite) .. ":" .. suite .. tostring(#id) .. ":" .. id, nil
end

local function sortedStrings(set: {[string]: boolean}): {string}
    local out: {string} = {}
    for value in pairs(set) do
        out[#out + 1] = value
    end
    table.sort(out)

    return out
end

local function stringSet(values: any, label: string): {[string]: boolean}?, string?
    local out: {[string]: boolean} = {}
    if values == nil then
        return out, nil
    end
    if type(values) ~= "table" then
        return nil, label .. " must be an array"
    end
    for _, value in ipairs(values) do
        value = nonempty(value)
        if not value then
            return nil, label .. " contains an empty value"
        end
        out[value] = true
    end

    return out, nil
end

local function addStrings(into: {[string]: boolean}, values: {[string]: boolean}): nil
    for value in pairs(values) do
        into[value] = true
    end
end

local function idsFor(set: {[string]: boolean}, ids: {[string]: integer}): {integer}
    local out: {integer} = {}
    for value in pairs(set) do
        local id = ids[value]
        if id then
            out[#out + 1] = id
        end
    end
    table.sort(out)

    return out
end

local function edgeLess(left: {integer}, right: {integer}): boolean
    return left[1] < right[1] or (left[1] == right[1] and left[2] < right[2])
end

local function edgeKey(moduleName: string, provenance: string): string
    return tostring(#moduleName) .. ":" .. moduleName .. tostring(#provenance) .. ":" .. provenance
end

local function rootsOf(
    owner: any,
    modules: {[string]: boolean},
    provenance: {[string]: boolean},
    label: string
): ({[string]: {string}}?, string?)
    local out: {[string]: {string}} = {}
    local roots = owner.roots
    if roots == nil then
        return out, nil
    end
    if type(roots) ~= "table" then
        return nil, label .. " roots must be an array"
    end
    for _, root in ipairs(roots) do
        if type(root) ~= "table" then
            return nil, label .. " root must be a record"
        end
        local moduleName = nonempty(root.module)
        local from = nonempty(root.provenance)
        if not moduleName or not from then
            return nil, label .. " root needs module and provenance"
        end
        modules[moduleName] = true
        provenance[from] = true
        out[edgeKey(moduleName, from)] = {moduleName, from}
    end

    return out, nil
end

local function encodedRoots(
    roots: {[string]: {string}},
    modules: {[string]: integer},
    provenance: {[string]: integer}
): {{integer}}
    local out: {{integer}} = {}
    for _, edge in pairs(roots) do
        out[#out + 1] = {assert(modules[edge[1]]), assert(provenance[edge[2]])}
    end
    table.sort(out, edgeLess)

    return out
end

local function ownerMetadata(
    owner: any,
    uncertainty: {[string]: boolean},
    label: string
): (boolean?, {[string]: boolean}?, string?)
    local safe = owner.sliceSafe
    if safe == nil then
        safe = false
    end
    if type(safe) ~= "boolean" then
        return nil, nil, label .. " sliceSafe must be boolean"
    end
    local uncertain, problem = stringSet(owner.uncertainty, label .. " uncertainty")
    if not uncertain then
        return nil, nil, problem
    end
    addStrings(uncertainty, uncertain)

    return safe, uncertain, nil
end

--- Turns a runner observation into deterministic, interned plain data.
---
--- The input is deliberately ordinary tables so the Lua runner and child
--- fragments do not need compiler record constructors. Its documented shape is:
---
---     stamps = {project, revision, operatingSystem, architecture, runtime,
---               targetProfile, suiteCatalog, stableIds}
---     paths = {path, ...}
---     modules = {{name, path?, dependencies = {module, ...}}, ...}
---     suites = {{path, sliceSafe, uncertainty?, roots?, cases = {
---         {id, sliceSafe, uncertainty?, roots?}, ...}}, ...}
---
--- Flags `complete`, `successful`, and `unfiltered` describe the producing run.
function impact.canonical(observation: any): any?, string?
    if type(observation) ~= "table" then
        return nil, "test-impact observation is missing"
    end
    local stampValues, stampProblem = stampsOf(observation.stamps)
    if not stampValues then
        return nil, stampProblem
    end

    local pathSet, moduleSet = {}, {}
    local provenanceSet, uncertaintySet = {}, {}
    local paths, pathProblem = stringSet(observation.paths, "test-impact paths")
    if not paths then
        return nil, pathProblem
    end
    for path in pairs(paths) do
        local normalized = normalizedPath(path)
        if not normalized then
            return nil, "test-impact paths contains an invalid path"
        end
        pathSet[normalized] = true
    end

    local moduleInputs: {[string]: any} = {}
    if type(observation.modules) ~= "table" then
        return nil, "test-impact modules must be an array"
    end
    for _, module in ipairs(observation.modules) do
        if type(module) ~= "table" then
            return nil, "test-impact module must be a record"
        end
        local name = nonempty(module.name)
        if not name then
            return nil, "test-impact module name is missing"
        end
        if moduleInputs[name] then
            return nil, "duplicate test-impact module " .. name
        end
        local path = module.path and normalizedPath(module.path) or nil
        if module.path ~= nil and not path then
            return nil, "test-impact module path is invalid"
        end
        if path then
            pathSet[path] = true
        end
        local dependencies, problem = stringSet(module.dependencies, "test-impact module dependencies")
        if not dependencies then
            return nil, problem
        end
        moduleInputs[name] = {path = path, dependencies = dependencies}
        moduleSet[name] = true
        addStrings(moduleSet, dependencies)
    end

    local suiteInputs: {[string]: any} = {}
    if type(observation.suites) ~= "table" then
        return nil, "test-impact suites must be an array"
    end
    for _, suite in ipairs(observation.suites) do
        if type(suite) ~= "table" then
            return nil, "test-impact suite must be a record"
        end
        local path = normalizedPath(suite.path)
        if not path then
            return nil, "test-impact suite path is missing"
        end
        if suiteInputs[path] then
            return nil, "duplicate test-impact suite " .. path
        end
        pathSet[path] = true
        local safe, uncertain, metadataProblem = ownerMetadata(suite, uncertaintySet, "suite " .. path)
        if safe == nil then
            return nil, metadataProblem
        end
        local roots, rootProblem = rootsOf(suite, moduleSet, provenanceSet, "suite " .. path)
        if not roots then
            return nil, rootProblem
        end
        local cases: {[string]: any} = {}
        if type(suite.cases) ~= "table" then
            return nil, "suite " .. path .. " cases must be an array"
        end
        for _, case in ipairs(suite.cases) do
            if type(case) ~= "table" then
                return nil, "suite " .. path .. " case must be a record"
            end
            local id = nonempty(case.id)
            if not id then
                return nil, "suite " .. path .. " case id is missing"
            end
            if cases[id] then
                return nil, "duplicate test-impact case " .. assert(impact.caseIdentity(path, id))
            end
            local caseSafe, caseUncertain, caseProblem = ownerMetadata(
                case,
                uncertaintySet,
                "case " .. assert(impact.caseIdentity(path, id))
            )
            if caseSafe == nil then
                return nil, caseProblem
            end
            local caseRoots, caseRootProblem = rootsOf(
                case,
                moduleSet,
                provenanceSet,
                "case " .. assert(impact.caseIdentity(path, id))
            )
            if not caseRoots then
                return nil, caseRootProblem
            end
            cases[id] = {safe = caseSafe, uncertainty = caseUncertain, roots = caseRoots}
        end
        suiteInputs[path] = {safe = safe, uncertainty = uncertain, roots = roots, cases = cases}
    end

    local pathList = sortedStrings(pathSet)
    local moduleList = sortedStrings(moduleSet)
    local suiteList = sortedStrings(
        (function(): {[string]: boolean}
            local set: {[string]: boolean} = {}
            for path in pairs(suiteInputs) do
                set[path] = true
            end

            return set
        end)()
    )
    local provenanceList = sortedStrings(provenanceSet)
    local uncertaintyList = sortedStrings(uncertaintySet)
    local pathIds, moduleIds, provenanceIds, uncertaintyIds = {}, {}, {}, {}
    for id, value in ipairs(pathList) do
        pathIds[value] = id
    end
    for id, value in ipairs(moduleList) do
        moduleIds[value] = id
    end
    for id, value in ipairs(provenanceList) do
        provenanceIds[value] = id
    end
    for id, value in ipairs(uncertaintyList) do
        uncertaintyIds[value] = id
    end

    local modulePaths, dependencies = {}, {}
    for id, name in ipairs(moduleList) do
        local input = moduleInputs[name]
        modulePaths[id] = input and input.path and assert(pathIds[input.path]) or 0
        dependencies[id] = input and idsFor(input.dependencies, moduleIds) or {}
    end

    local suitePathIds, suiteSliceSafe, suiteUncertainty, suiteRoots = {}, {}, {}, {}
    local cases, caseSliceSafe, caseUncertainty, caseRoots = {}, {}, {}, {}
    for suiteId, path in ipairs(suiteList) do
        local suite = suiteInputs[path]
        suitePathIds[suiteId] = assert(pathIds[path])
        suiteSliceSafe[suiteId] = suite.safe
        suiteUncertainty[suiteId] = idsFor(suite.uncertainty, uncertaintyIds)
        suiteRoots[suiteId] = encodedRoots(suite.roots, moduleIds, provenanceIds)
        local caseIds = sortedStrings(
            (function(): {[string]: boolean}
                local set: {[string]: boolean} = {}
                for id in pairs(suite.cases) do
                    set[id] = true
                end

                return set
            end)()
        )
        for _, caseId in ipairs(caseIds) do
            local case = suite.cases[caseId]
            cases[#cases + 1] = {suiteId, caseId}
            caseSliceSafe[#caseSliceSafe + 1] = case.safe
            caseUncertainty[#caseUncertainty + 1] = idsFor(case.uncertainty, uncertaintyIds)
            caseRoots[#caseRoots + 1] = encodedRoots(case.roots, moduleIds, provenanceIds)
        end
    end

    return {
        format = FORMAT,
        builder = BUILDER,
        stamps = stampValues,
        complete = observation.complete == true,
        successful = observation.successful == true,
        unfiltered = observation.unfiltered == true,
        paths = pathList,
        modules = moduleList,
        modulePaths = modulePaths,
        moduleDependencies = dependencies,
        provenance = provenanceList,
        uncertainty = uncertaintyList,
        suites = suitePathIds,
        suiteSliceSafe = suiteSliceSafe,
        suiteUncertainty = suiteUncertainty,
        suiteRoots = suiteRoots,
        cases = cases,
        caseSliceSafe = caseSliceSafe,
        caseUncertainty = caseUncertainty,
        caseRoots = caseRoots,
    }, nil
end

local function isArray(value: any): boolean
    if type(value) ~= "table" then
        return false
    end
    local length = #value
    for key in pairs(value) do
        if type(key) ~= "number" or key < 1 or key > length or key % 1 ~= 0 then
            return false
        end
    end

    return true
end

local function sortedStringArray(value: any): boolean
    if not isArray(value) then
        return false
    end
    local previous: string?
    for _, item in ipairs(value) do
        if type(item) ~= "string" or item == "" or (previous and previous >= item) then
            return false
        end
        previous = item
    end

    return true
end

local function sortedIds(value: any, maximum: integer): boolean
    if not isArray(value) then
        return false
    end
    local previous = 0
    for _, id in ipairs(value) do
        if type(id) ~= "number" or id % 1 ~= 0 or id <= previous or id > maximum then
            return false
        end
        previous = id
    end

    return true
end

local function validRoots(value: any, modules: integer, provenance: integer): boolean
    if not isArray(value) then
        return false
    end
    local lastModule, lastProvenance = 0, 0
    for _, edge in ipairs(value) do
        if not isArray(edge) or #edge ~= 2 then
            return false
        end
        local moduleId, provenanceId = edge[1], edge[2]
        if type(moduleId) ~= "number"
            or moduleId % 1 ~= 0
            or moduleId < 1
            or moduleId > modules
            or type(provenanceId) ~= "number"
            or provenanceId % 1 ~= 0
            or provenanceId < 1
            or provenanceId > provenance
            or moduleId < lastModule
            or (moduleId == lastModule and provenanceId <= lastProvenance)
        then
            return false
        end
        lastModule, lastProvenance = moduleId, provenanceId
    end

    return true
end

local function exactStamps(left: any, right: {string}): boolean
    if not isArray(left) or #left ~= #right then
        return false
    end
    for index, value in ipairs(right) do
        if left[index] ~= value then
            return false
        end
    end

    return true
end

local function validGraph(graph: any, expectedStamps: {string}): boolean
    if type(graph) ~= "table"
        or graph.format ~= FORMAT
        or graph.builder ~= BUILDER
        or graph.complete ~= true
        or graph.successful ~= true
        or graph.unfiltered ~= true
        or not exactStamps(graph.stamps, expectedStamps)
        or not sortedStringArray(graph.paths)
        or not sortedStringArray(graph.modules)
        or not sortedStringArray(graph.provenance)
        or not sortedStringArray(graph.uncertainty)
        or not isArray(graph.modulePaths)
        or #graph.modulePaths ~= #graph.modules
        or not isArray(graph.moduleDependencies)
        or #graph.moduleDependencies ~= #graph.modules
        or not isArray(graph.suites)
        or not isArray(graph.suiteSliceSafe)
        or #graph.suiteSliceSafe ~= #graph.suites
        or not isArray(graph.suiteUncertainty)
        or #graph.suiteUncertainty ~= #graph.suites
        or not isArray(graph.suiteRoots)
        or #graph.suiteRoots ~= #graph.suites
        or not isArray(graph.cases)
        or not isArray(graph.caseSliceSafe)
        or #graph.caseSliceSafe ~= #graph.cases
        or not isArray(graph.caseUncertainty)
        or #graph.caseUncertainty ~= #graph.cases
        or not isArray(graph.caseRoots)
        or #graph.caseRoots ~= #graph.cases
    then
        return false
    end
    local lastSuitePath = 0
    for index, pathId in ipairs(graph.suites) do
        if type(pathId) ~= "number"
            or pathId % 1 ~= 0
            or pathId <= lastSuitePath
            or pathId > #graph.paths
            or type(graph.suiteSliceSafe[index]) ~= "boolean"
            or not sortedIds(graph.suiteUncertainty[index], #graph.uncertainty)
            or not validRoots(graph.suiteRoots[index], #graph.modules, #graph.provenance)
        then
            return false
        end
        lastSuitePath = pathId
    end
    for index, pathId in ipairs(graph.modulePaths) do
        if type(pathId) ~= "number"
            or pathId % 1 ~= 0
            or pathId < 0
            or pathId > #graph.paths
            or not sortedIds(graph.moduleDependencies[index], #graph.modules)
        then
            return false
        end
    end
    local lastSuite, lastCase = 0, ""
    for index, case in ipairs(graph.cases) do
        if not isArray(case) or #case ~= 2 then
            return false
        end
        local suiteId, caseId = case[1], case[2]
        if type(suiteId) ~= "number"
            or suiteId % 1 ~= 0
            or suiteId < 1
            or suiteId > #graph.suites
            or type(caseId) ~= "string"
            or caseId == ""
            or suiteId < lastSuite
            or (suiteId == lastSuite and caseId <= lastCase)
            or type(graph.caseSliceSafe[index]) ~= "boolean"
            or not sortedIds(graph.caseUncertainty[index], #graph.uncertainty)
            or not validRoots(graph.caseRoots[index], #graph.modules, #graph.provenance)
        then
            return false
        end
        lastSuite, lastCase = suiteId, caseId
    end

    return true
end

--- Publishes an authoritative graph. Ineligible observations do not touch the
--- previous file.
function impact.publish(path: string?, observation: any): boolean, string?
    if type(observation) ~= "table"
        or observation.complete ~= true
        or observation.successful ~= true
        or observation.unfiltered ~= true
    then
        return false, "only a complete, successful, unfiltered test run may publish an impact graph"
    end
    local graph, problem = impact.canonical(observation)
    if not graph then
        return false, problem
    end
    local stamp, stampProblem = cacheStamp(observation.stamps)
    if not stamp then
        return false, stampProblem
    end
    local file = binaryStore.openValue(path, stamp)
    file.set(graph)
    file.save()

    return true, nil
end

--- Reads the graph for one exact identity. Every incompatible or malformed
--- state is an ordinary miss.
function impact.load(path: string?, stamps: any): any?
    local stamp = cacheStamp(stamps)
    local expected = stampsOf(stamps)
    if not stamp or not expected then
        return nil
    end
    local graph = binaryStore.openValue(path, stamp).value
    if not validGraph(graph, expected) then
        return nil
    end

    return graph
end

impact.FORMAT = FORMAT
impact.BUILDER = BUILDER
impact.cacheStamp = cacheStamp

export = impact
