module nupp.compiler.vm.coregraphcontracts

local program = require("nupp.compiler.vm.programgraph")
local graph = require("nupp.compiler.vm.graph")
local schema = require("nupp.compiler.vm.coregraphschema")
local semantic = require("nupp.compiler.vm.coregraphverify")
local cst = require("nupp.compiler.syntax.cst")
local contracts = {}
local bounds = schema.limits()

local function need(ok: any, message: string): any
    assert(ok, "core graph contracts: " .. message)
    return ok
end

-- `action()`, its refusal naming the source at `node` in `path`.
local function located(path: any, node: any, action: function(): any): any
    local ok, result = pcall(action)
    if ok then
        return result
    end
    local token = type(node) == "table" and cst.firstToken(node) or nil
    if type(result) == "string" and token then
        result = result .. " at " .. tostring(path) .. ":" .. tostring(token.line) .. ":" .. tostring(token.col)
    end
    error(result, 0)
end

local function plain(value: any): nil
    need(type(value) == "table" and getmetatable(value) == nil, "plain semantic table required")
end

local function fields(value: any, allowed: string): nil
    plain(value)
    for key in pairs(value) do
        need(
            type(key) == "string"
            and key:match("^[A-Za-z_][A-Za-z0-9_]*$")
            and (" " .. allowed .. " "):find(" " .. key .. " ", 1, true),
            "unknown semantic field " .. tostring(key)
        )
    end
end

local function integer(value: any, maximum: integer): integer
    if not (type(value) == "number" and value >= 0 and value <= maximum and value % 1 == 0) then
        need(false, "invalid bounded integer " .. tostring(value) .. " (at most " .. tostring(maximum) .. ")")
    end
    return value as integer
end

local function dense(value: any, maximum: integer): integer
    plain(value)
    local length = integer(#value, maximum)
    local count = 0
    for key in pairs(value) do
        need(type(key) == "number" and key >= 1 and key <= length and key % 1 == 0, "sparse semantic array")
        count += 1
    end
    need(count == length, "sparse semantic array")

    return length
end

local function text(value: any): string
    need(type(value) == "string" and #value <= 1048576, "bounded source text required")
    return value
end

local function empty(value: any, description: string): nil
    need(value == nil or type(value) == "table" and next(value) == nil, "unsupported " .. description)
end

local function scalar(value: any, numeric: boolean, dynamic: boolean?): string
    -- An owned value passes as the value it owns, and a literal or const
    -- one as its base type's.
    while dynamic
        and value
        and (
            value.tag == "affine"
            or value.tag == "borrowed"
            or value.tag == "pinned"
            or value.tag == "literal"
            or value.tag == "const"
        ) do
        value = value.tag == "literal" and value.base or value.inner
    end
    need(value and value.tag ~= "literal" and value.tag ~= "const", "qualified scalar signatures are unsupported")
    -- v8 passes strings, tables and functions as dynamic values, checked where
    -- used.
    if dynamic
        and (value.tag == "string" or value.tag == "typevar" or value.tag == "nominal" and value.declKind == "record" or value.tag == "array" or value.tag == "map" or value.tag == "table" or value.tag == "shape" or value.tag == "func" or value.tag == "userdata" or value.tag == "carray" or value.tag == "ptr" or value.tag == "ctype" or value.tag == "intersection" or value.tag == "typeobject" or value.tag == "nominal" and value.declKind == "interface" or value.tag == "never"
        -- Thread protocols erase to the existing tagged scheduler value.
        or value.tag == "thread" or value.tag == "protocolThread"
        -- Fixed-width numbers are integers and floats at run time.
        or value.tag == "int8"
        or value.tag == "int16"
        or value.tag == "int32"
        or value.tag == "uint8"
        or value.tag == "uint16"
        or value.tag == "uint32"
        or value.tag == "uint64"
        or value.tag == "float32"
        -- A metatable is a table; a type a generic computes (a const
        -- parameter's `N`) erases as a type parameter does.
        or value.tag == "metatable" or value.tag == "neutral" or value.tag == "any" or value.tag == "unknown") then
        return "value"
    end
    -- An optional or other union is dynamic too, each member admissible.
    if dynamic and value.tag == "union" and #(value.members or {}) > 0 then
        for _, member in ipairs(value.members) do
            scalar(member, numeric, dynamic)
        end
        return "value"
    end
    need(
        value.tag == "boolean"
        or value.tag == "nil"
        or numeric and (value.tag == "number" or value.tag == "float64" or value.tag == "int64"),
        "unsupported scalar signature: " .. tostring(
            value.tag
        ) .. (value.declKind and " " .. tostring(value.declKind) or "")
    )

    return (value.tag == "float64" or value.tag == "int64") and "number" or value.tag
end

-- The wire's absent index, for a dynamic call's missing target.
local ABSENT = 4294967295

-- A callable signature record from a checked function type. A
-- constructor's results are dropped (`resultsIgnored`): they may be open,
-- and its result kind is any value.
local function typeSignature(signature: any, numeric: boolean, dynamic: boolean, resultsIgnored: boolean?): any
    need(signature and signature.tag == "func", "checked function type required")
    -- From v8 a typed `...` passes its values in a pack, the last parameter.
    local tail = signature.paramPack and signature.paramPack.tail
    local variadic = signature.vararg == true
    -- A generic tail (`...: A...`) erases to values, as plain generics do,
    -- and so does one a type computes (`...: unpackof F(T)`).
    local erasedTail = tail and (tail.kind == "generic" or tail.kind == "unknown" or tail.kind == "computed")
    -- A borrowed `...` (`borrows ...: any`) stays its caller's: a static fact.
    need(
        not variadic
        or dynamic
        and tail
        and (tail.kind == "homogeneous" or erasedTail)
        and (tail.mode == nil or tail.mode == "borrows"),
        "unsupported callable signature: a `...` of kind " .. tostring(tail and tail.kind)
    )
    need(not signature.foreign, "unsupported callable signature: foreign")
    need(not signature.comptimeOnly, "unsupported callable signature: compile-time only")
    -- From v8 plain and const type parameters erase to dynamic values, and
    -- what a result preserves of, borrows from or partitions out of its
    -- parameters is a static ownership fact.
    for _, key in ipairs({
        "typeParams",
        "packParams",
        "constParams",
        "borrowsParams",
        "preservesResults",
        "partitionResults",
        "preservesPaths"
    }) do
        local erased = dynamic
            and (
                key == "typeParams"
                or key == "packParams"
                or key == "constParams"
                or key == "borrowsParams"
                or key == "partitionResults"
                or key == "preservesResults"
                or key == "preservesPaths"
            )
        if not erased then
            empty(signature[key], "callable " .. key)
        end
    end
    local params, result = {}, nil
    for _, pack in ipairs(resultsIgnored and {signature.paramPack} or {signature.paramPack, signature.retPack}) do
        -- Open results (`R...`) are as many as the caller keeps.
        -- An unannotated function's results are open: any number of values.
        need(
            pack
            and (
                not pack.tail
                or variadic and pack == signature.paramPack
                or (dynamic or pack.tail.kind == "unknown" and #pack.head == 0) and pack == signature.retPack
            )
            and not pack.alternatives,
            "closed signature pack required"
        )
        dense(pack.head, 240)
        need(dense(pack.modes, 240) == #pack.head, "signature modes differ")
        for at, mode in ipairs(pack.modes) do
            -- A parameter's ownership mode is the checker's fact: at run
            -- time the value passes as it is.
            need(
                mode == "plain"
                or mode == "scoped" and pack.head[at].tag == "func"
                or (mode == "borrows" or mode == "takes" or mode == "exclusive") and pack == signature.paramPack,
                "qualified scalar signature: " .. tostring(mode)
            )
        end
    end
    -- v8 admits up to sixteen fixed results, as dynamic values.
    local results: integer = 1
    if resultsIgnored then
        need(dense(signature.params, 239) == #signature.paramPack.head, "checked parameter pack differs")
        result = "value"
    else
        results = dense(signature.rets, dynamic and 16 or 1)
        if signature.retPack.tail ~= nil and #signature.retPack.head == 0 then
            results = 0
        end
        need(
            dense(signature.params, 239) == #signature.paramPack.head and #signature.retPack.head == results,
            "fixed single-result signature required"
        )
    end
    for index, value in ipairs(signature.params) do
        need(value == signature.paramPack.head[index], "checked parameter pack differs")
        params[index] = scalar(value, numeric, dynamic)
    end
    for index, value in ipairs((resultsIgnored or results == 0) and {} or signature.rets) do
        need(value == signature.retPack.head[index], "checked result pack differs")
        result = scalar(value, numeric, dynamic)
    end
    -- RetN and the caller's frame carry the counts, so the signature needs
    -- only the kind.
    -- None, as a function that returns nothing, is read as values are.
    if results ~= 1 or not resultsIgnored and signature.retPack.tail ~= nil then
        result = "value"
    end
    if variadic then
        if not erasedTail then
            scalar(tail.type, numeric, dynamic)
        end
        params[#params + 1] = "value"
        return {kind = "callable", params = params, result = result, variadic = true}
    end

    return {kind = "callable", params = params, result = result}
end

local function checkedSignature(owner: any, numeric: boolean, dynamic: boolean): any
    local signature = need(owner.signature, "checked callable signature required")
    need(
        signature.tag == "func" and owner.body.signatureType == signature,
        "checked callable signature identity differs"
    )
    -- From v8 a call through a value makes a summary unknown, and a
    -- coroutine's yield runs on the core (`threads`): only an external effect
    -- is refused.
    local summary = owner.body.effectSummary
    need(summary and (summary.top == false or dynamic) and summary.external == false, "unknown callable effects")

    local result = typeSignature(signature, numeric, dynamic, owner.node.kind == "constructorDecl")
    -- A method's receiver is its first parameter on the core, though its
    -- function type leaves it out: a `:` method's implicit one, or the `self`
    -- an instance method in a record body spells.
    if owner.body.coreSelfParam
        or owner.node.kind == "inlineMethod" and not owner.node.inlineStatic
        or owner.node.kind == "constructorDecl"
    then
        table.insert(result.params, 1, "value")
    end

    return result
end

local function intern(signatures: any, index: any, signature: any): integer
    local key = signature.kind .. ":" .. table.concat(
        signature.params,
        ","
    ) .. (signature.variadic and "..." or "") .. "->" .. signature.result
    local previous = index[key]
    if previous ~= nil then
        return previous
    end
    local id = #signatures
    signature.id = id
    signatures[id + 1], index[key] = signature, id

    return id
end

-- Diagnostic names describe the issued source call, never its runtime target.
local function diagnostic(call: any, protected: boolean): any
    if protected then
        return {method = false}
    end
    if call.kind == "forinStmt" then
        return {method = false, name = "for iterator"}
    end
    if call.kind == "methodCall" then
        return {method = true, name = call.name.text}
    end
    local callee = call.obj
    while callee and callee.kind == "paren" do
        callee = callee.expr
    end
    if callee and callee.kind == "name" then
        return {method = false, name = callee.token.text}
    elseif callee and callee.kind == "dotIndex" then
        return {method = false, name = callee.name.text}
    end

    return {method = false}
end

function contracts.normalize(compiled: any, version: integer?): (any, any)
    local v: integer = version or 2
    local numeric, loops = v >= 3, v >= 5
    fields(compiled, "graphs header catalog")
    local p, graphs = compiled.catalog, compiled.graphs
    need(type(p) == "table", "authentic checked catalog required")
    dense(graphs, bounds.owners)
    fields(compiled.header, "shapes modules entry")
    need(dense(compiled.header.shapes, 1048576) == 0, "shape-free graph catalog required")
    local moduleCount = dense(compiled.header.modules, bounds.modules)
    need(moduleCount > 0 and dense(p.modules, bounds.modules) == moduleCount, "complete module table required")
    -- From v8 a program's modules run as their requirers call them.
    need(not loops or moduleCount == 1 or v >= 8, "loop profile requires one scalar initializer")
    need(#p.owners == #graphs, "complete graph table required")
    for _, key in ipairs({"externals", "externalReferences"}) do
        need(type(p[key]) == "table" and next(p[key]) == nil, "unsupported catalog " .. key)
    end
    -- The ownership intrinsics the core runs: transfers, partition, drop.
    need(type(p.intrinsics) == "table", "checked intrinsics required")
    for _, intrinsic in ipairs(p.intrinsics) do
        need(
            program.executableIntrinsic(intrinsic.node),
            "unsupported catalog intrinsic " .. tostring(intrinsic.operation)
        )
    end
    local requireSite
    -- From v8 every require is a site of its own, each naming one of the
    -- program's modules.
    local requiresites: {any} = {}
    need(type(p.imports) == "table" and type(p.requires) == "table", "checked import tables required")
    if v >= 8 and (#p.imports ~= 0 or #p.requires ~= 0) then
        local byname, bychunk = {}, {}
        for _, module in ipairs(p.modules) do
            byname[module.name], bychunk[module.chunk] = module, module
        end
        need(type(p.requireByNode) == "table", "checked require source required")
        -- A require that selects only types is erased: it loads nothing.
        local loading = {}
        for _, site in ipairs(p.requires) do
            if not (
                type(site) == "table"
                and (site.typeOnly and type(site.node) == "table" and site.node.typeOnlyRequire or site.corecalls)
            ) then
                loading[#loading + 1] = site
            end
        end
        for _, site in ipairs(loading) do
            local target = type(site) == "table" and byname[site.module] or nil
            need(
                target ~= nil
                and type(site.node) == "table"
                and site.target == target.chunk
                and not site.typeOnly
                and (
                    (
                        site.node.runtimeLoader == "require"
                        or site.qualified and (site.library ~= nil or site.node.qualifiedModule == site.module)
                    )
                )
                and p.requireByNode[site.node] == site,
                "checked require target or source identity differs"
            )
            requiresites[#requiresites + 1] = site
        end
        for _, imported in ipairs(p.imports) do
            local binding = type(imported) == "table"
                and type(imported.binding) == "number"
                and p.bindings[imported.binding + 1]
                or nil
            local target = type(imported) == "table" and bychunk[imported.target] or nil
            need(
                type(binding) == "table"
                and type(binding.definition) == "table"
                and target ~= nil
                and graph.coremodule(binding.definition.requiredModule) == target.name,
                "checked import target or source identity differs"
            )
        end
    elseif #p.imports ~= 0 or #p.requires ~= 0 then
        need(
            moduleCount == 2 and #p.imports == 1 and #p.requires == 1,
            "only one checked two-module import is executable"
        )
        requireSite = p.requires[1]
        local imported = p.imports[1]
        local first = p.modules[1]
        need(
            type(requireSite) == "table" and type(imported) == "table" and type(first) == "table",
            "checked import records required"
        )
        need(type(requireSite.node) == "table" and type(p.requireByNode) == "table", "checked require source required")
        local binding = type(imported.binding) == "number" and p.bindings[imported.binding + 1] or nil
        need(type(binding) == "table" and type(binding.definition) == "table", "checked import binding required")
        need(
            requireSite.owner == p.entry
            and requireSite.target == first.chunk
            and requireSite.module == first.name
            and not requireSite.typeOnly
            and requireSite.node.runtimeLoader == "require"
            and p.requireByNode[requireSite.node] == requireSite
            and imported.target == first.chunk
            and graph.coremodule(binding.definition.requiredModule) == first.name,
            "checked import target or source identity differs"
        )
        requiresites = {requireSite}
    end
    local definition = schema.describe(v)
    local output: any = {
        schema = definition,
        entry = integer(compiled.header.entry, bounds.owners - 1),
        modules = {},
        catalog = {},
        signatures = {},
        graphs = {},
        contracts = {}
    }
    local diagnostics = {}
    need(output.entry == p.entry, "entry owner differs")
    local signatureIndex, callEdges, admitted = {}, {}, {}
    for _, item in ipairs(definition.operations) do
        admitted[item.name] = item
    end
    local modulesByOwner = {}
    for index, module in ipairs(compiled.header.modules) do
        fields(module, "name path chunk")
        need(
            module.name == p.modules[index].name
            and module.path == p.modules[index].path
            and module.chunk == p.modules[index].chunk
            and module.chunk == index - 1
            and need(p.owners[module.chunk + 1], "module initializer is missing").kind == "module",
            "module initializer binding differs"
        )
        local record = {
            name = text(module.name),
            path = text(module.path),
            chunk = integer(module.chunk, bounds.owners - 1)
        }
        output.modules[index], modulesByOwner[module.chunk] = record, record
    end
    need(modulesByOwner[output.entry] ~= nil, "entry initializer is not cataloged")
    for index = 1, dense(p.owners, bounds.owners) do
        local owner = p.owners[index]
        need(v >= 7 or dense(owner.captures, 256) == 0, "captures are unsupported")
        local record: any = {
            id = integer(owner.id, bounds.owners - 1),
            kind = owner.kind,
            graph = index - 1,
            effect = 0
        }
        need(record.id == index - 1, "owner order differs")
        if owner.kind == "function" then
            record.parent = integer(owner.parent, bounds.owners - 1)
            record.signature = intern(
                output.signatures,
                signatureIndex,
                located(
                    owner.scope and owner.scope.path,
                    owner.node,
                    function(): any
                        return checkedSignature(owner, numeric, v >= 8)
                    end
                )
            )
        else
            need(
                owner.kind == "module" and modulesByOwner[owner.id] ~= nil and owner.parent == nil,
                "unsupported initializer owner"
            )
        end
        output.catalog[index], callEdges[index] = record, {}
        output.graphs[index] = semantic.copyGraph(graphs[index], v, true)
    end
    -- This is the authoritative source-side gate. Decoders must never call it
    -- with fabricated checker objects. Call-front adds callsite membership.
    program.verifyGraphs(p, graphs)
    local foundRequires = 0
    for index, g in ipairs(output.graphs) do
        need(g.programOwner == index - 1, "graph owner order differs")
        local record = output.catalog[index]
        for bi, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                local policy = need(admitted[op], "unsupported operation " .. op)
                if op == "Closure" then
                    need(v >= 7 or #block.args[at] == 1, "captures are unsupported")
                elseif op == "Require" then
                    foundRequires += 1
                    local constant = need(g.constants[block.args[at][1] + 1], "require name is missing")
                    local position = need(g.positions[block.pos[at]], "require graph position is missing")
                    -- The site of this owner's require of this module at this
                    -- position.
                    local matched = nil
                    for _, site in ipairs(requiresites) do
                        local token = site.owner == record.id and cst.firstToken(site.node) or nil
                        if token
                            and constant.kind == "str"
                            and constant.value == site.module
                            and position.line == token.line
                            and position.column == token.col
                        then
                            matched = site
                        end
                    end
                    need(matched ~= nil, "require graph differs from checked callsite")
                end
                record.effect = math.max(record.effect, policy.effect)
            end
            if block.term.kind == "invoke" then
                need(not loops or v >= 7, "calls are outside scalar loop profile")
                local source = graphs[index].blocks[bi].term.contract
                local site = need(p.callByNode and p.callByNode[source.call], "checked call-front membership required")
                need(
                    p.calls
                    and p.calls[site.id + 1] == site
                    and site.owner == record.id
                    and site.node == source.call
                    and (source.dynamic or site.definition == source.definition),
                    "foreign checked callsite"
                )
                -- A dynamic call has no target; its signature comes from the
                -- call's checked function type and is checked when it runs.
                local target = {id = ABSENT, signature = 0}
                if source.dynamic then
                    need(v >= 8, "dynamic calls are outside this profile")
                    target.signature = intern(
                        output.signatures,
                        signatureIndex,
                        located(
                            graphs[index].source and graphs[index].source.path,
                            source.call,
                            function(): any
                                return typeSignature(source.callSignature, numeric, true)
                            end
                        )
                    )
                else
                    need(
                        p.functionsByDefinition[source.definition] == source.owner
                        and p.owners[source.owner.id + 1] == source.owner,
                        "foreign checked call target"
                    )
                    target = output.catalog[source.owner.id + 1]
                    need(target.kind == "function", "initializer is not callable")
                end
                local id = #output.contracts
                output.contracts[id + 1] = {
                    id = id,
                    owner = record.id,
                    block = block.id,
                    callsite = integer(site.id, bounds.calls - 1),
                    target = target.id,
                    signature = target.signature,
                    effect = 1,
                    -- pcall(f, ...): the callee runs as a protected call.
                    protected = source.protected == true or nil,
                    -- xpcall(f, handler, ...): its handler is staged apart.
                    handled = source.handled == true or nil
                }
                diagnostics[id + 1] = diagnostic(source.call, source.protected == true)
                block.term.contract = id
                record.effect = 1
                if not source.dynamic then
                    callEdges[index][#callEdges[index] + 1] = target.id + 1
                end
            end
        end
    end
    need(foundRequires == #requiresites, "checked require graph is incomplete")
    -- v7 admits recursion; its depth is bounded by the entry's frame pool.
    if v < 7 then
        semantic.topological(output.catalog, callEdges, nil)
    end
    for index, g in ipairs(output.graphs) do
        local owner = output.catalog[index]
        local signature = owner.kind == "module" and {kind = "initializer", params = {}}
            or output.signatures[owner.signature + 1]
        local result = semantic.resultKind(g, signature, output)
        if owner.kind == "module" then
            need(g.nparams == 0, "initializer has parameters")
            owner.signature = intern(output.signatures, signatureIndex, {
                kind = "initializer",
                params = {},
                result = result
            })
        else
            need(
                result == signature.result or v >= 8 and (result == "value" or signature.result == "value"),
                "graph result differs from checked signature"
            )
        end
    end

    return output, diagnostics
end

export = contracts
