module nupp.compiler.vm.coregraphcontracts

local program = require("nupp.compiler.vm.programgraph")
local graph = require("nupp.compiler.vm.graph")
local schema = require("nupp.compiler.vm.coregraphschema")
local semantic = require("nupp.compiler.vm.coregraphverify")
local cst = require("nupp.compiler.syntax.cst")
local graphcalls = require("nupp.compiler.vm.graphcalls")
local lexer = require("nupp.compiler.syntax.lexer")
local bounds = schema.limits()

local function need(ok: any, message: string): any
    -- The message is built only for a failure: checks run millions of times.
    if not ok then
        error("core graph contracts: " .. message, 0)
    end
    return ok
end

-- `action()`, its refusal naming the source at `node` in `path`.
local function located(path: any, node: any, action: function(): any): any
    local ok, result = pcall(action)
    if ok then
        return result
    end
    local token = type(node) == "table" and cst.firstToken(node) or nil
    if type(result) == "string" and token then
        result = result .. " at " .. tostring(path) .. ":" .. tostring(token.line) .. ":" .. tostring(token.col)
    end
    error(result, 0)
end

local function plain(value: any): nil
    need(type(value) == "table" and getmetatable(value) == nil, "plain semantic table required")
end

local function fields(value: any, allowed: string): nil
    plain(value)
    for key in pairs(value) do
        need(
            type(key) == "string"
            and key:match("^[A-Za-z_][A-Za-z0-9_]*$")
            and (" " .. allowed .. " "):find(" " .. key .. " ", 1, true),
            "unknown semantic field " .. tostring(key)
        )
    end
end

local function integer(value: any, maximum: integer): integer
    if not (type(value) == "number" and value >= 0 and value <= maximum and value % 1 == 0) then
        need(false, "invalid bounded integer " .. tostring(value) .. " (at most " .. tostring(maximum) .. ")")
    end
    return value as integer
end

local function dense(value: any, maximum: integer): integer
    plain(value)
    local length = integer(#value, maximum)
    local count = 0
    for key in pairs(value) do
        need(type(key) == "number" and key >= 1 and key <= length and key % 1 == 0, "sparse semantic array")
        count += 1
    end
    need(count == length, "sparse semantic array")

    return length
end

local function text(value: any): string
    need(type(value) == "string" and #value <= 1048576, "bounded source text required")
    return value
end

local function empty(value: any, description: string): nil
    need(value == nil or type(value) == "table" and next(value) == nil, "unsupported " .. description)
end

local function scalar(value: any, numeric: boolean, dynamic: boolean?): string
    -- An owned value passes as the value it owns, and a literal or const
    -- one as its base type's.
    while dynamic
        and value
        and (
            value.tag == "affine"
            or value.tag == "borrowed"
            or value.tag == "pinned"
            or value.tag == "literal"
            or value.tag == "const"
        ) do
        value = value.tag == "literal" and value.base or value.inner
    end
    need(value and value.tag ~= "literal" and value.tag ~= "const", "qualified scalar signatures are unsupported")
    -- v8 passes strings, tables and functions as dynamic values, checked where
    -- used.
    if dynamic
        and (value.tag == "string" or value.tag == "typevar" or value.tag == "nominal" and value.declKind == "record" or value.tag == "array" or value.tag == "map" or value.tag == "table" or value.tag == "shape" or value.tag == "func" or value.tag == "userdata" or value.tag == "carray" or value.tag == "ptr" or value.tag == "ctype" or value.tag == "intersection" or value.tag == "typeobject" or value.tag == "nominal" and value.declKind == "interface" or value.tag == "never"
        -- Thread protocols erase to the existing tagged scheduler value.
        or value.tag == "thread" or value.tag == "protocolThread"
        -- Fixed-width numbers are integers and floats at run time.
        or value.tag == "int8"
        or value.tag == "int16"
        or value.tag == "int32"
        or value.tag == "uint8"
        or value.tag == "uint16"
        or value.tag == "uint32"
        or value.tag == "uint64"
        or value.tag == "float32"
        -- A metatable is a table; a type a generic computes (a const
        -- parameter's `N`) erases as a type parameter does.
        or value.tag == "metatable" or value.tag == "neutral" or value.tag == "any" or value.tag == "unknown"
        -- A struct is storage of its bytes (taggedstructs).
        or value.tag == "nominal" and value.declKind == "struct") then
        return "value"
    end
    -- An optional or other union is dynamic too, each member admissible.
    if dynamic and value.tag == "union" and #(value.members or {}) > 0 then
        for _, member in ipairs(value.members) do
            scalar(member, numeric, dynamic)
        end
        return "value"
    end
    need(
        value.tag == "boolean"
        or value.tag == "nil"
        or numeric and (value.tag == "number" or value.tag == "float64" or value.tag == "int64"),
        "unsupported scalar signature: " .. tostring(
            value.tag
        ) .. (value.declKind and " " .. tostring(value.declKind) or "")
    )

    return (value.tag == "float64" or value.tag == "int64") and "number" or value.tag
end

-- The wire's absent index, for a dynamic call's missing target.
local ABSENT = 4294967295

-- A callable signature record from a checked function type. A
-- constructor's results are dropped (`resultsIgnored`): they may be open,
-- and its result kind is any value.
local function typeSignature(signature: any, numeric: boolean, dynamic: boolean, resultsIgnored: boolean?): any
    need(signature and signature.tag == "func", "checked function type required")
    -- From v8 a typed `...` passes its values in a pack, the last parameter.
    local tail = signature.paramPack and signature.paramPack.tail
    local variadic = signature.vararg == true
    -- A generic tail (`...: A...`) erases to values, as plain generics do,
    -- and so does one a type computes (`...: unpackof F(T)`).
    local erasedTail = tail and (tail.kind == "generic" or tail.kind == "unknown" or tail.kind == "computed")
    -- A borrowed `...` (`borrows ...: any`) stays its caller's: a static fact.
    need(
        not variadic
        or dynamic
        and tail
        and (tail.kind == "homogeneous" or erasedTail)
        and (tail.mode == nil or tail.mode == "borrows"),
        "unsupported callable signature: a `...` of kind " .. tostring(tail and tail.kind)
    )
    need(not signature.foreign, "unsupported callable signature: foreign")
    need(not signature.comptimeOnly, "unsupported callable signature: compile-time only")
    -- From v8 plain and const type parameters erase to dynamic values, and
    -- what a result preserves of, borrows from or partitions out of its
    -- parameters is a static ownership fact.
    for _, key in ipairs({
        "typeParams",
        "packParams",
        "constParams",
        "borrowsParams",
        "preservesResults",
        "partitionResults",
        "preservesPaths"
    }) do
        local erased = dynamic
            and (
                key == "typeParams"
                or key == "packParams"
                or key == "constParams"
                or key == "borrowsParams"
                or key == "partitionResults"
                or key == "preservesResults"
                or key == "preservesPaths"
            )
        if not erased then
            empty(signature[key], "callable " .. key)
        end
    end
    local params, result = {}, nil
    local alternatives = not resultsIgnored and signature.retPack and signature.retPack.alternatives ~= nil
    if alternatives then
        need(dynamic, "finite result alternatives require dynamic values")
        graph.validatesignature(signature)
    end
    for _, pack in ipairs((
        resultsIgnored or alternatives
    ) and {signature.paramPack} or {signature.paramPack, signature.retPack}) do
        -- Open results (`R...`) are as many as the caller keeps.
        -- An unannotated function's results are open: any number of values.
        need(
            pack
            and (
                not pack.tail
                or variadic and pack == signature.paramPack
                or (dynamic or pack.tail.kind == "unknown" and #pack.head == 0) and pack == signature.retPack
            )
            and not pack.alternatives,
            "closed signature pack required"
        )
        dense(pack.head, 240)
        need(dense(pack.modes, 240) == #pack.head, "signature modes differ")
        for at, mode in ipairs(pack.modes) do
            -- A parameter's ownership mode is the checker's fact: at run
            -- time the value passes as it is.
            need(
                mode == "plain"
                or mode == "scoped" and pack.head[at].tag == "func"
                or (mode == "borrows" or mode == "takes" or mode == "exclusive") and pack == signature.paramPack,
                "qualified scalar signature: " .. tostring(mode)
            )
        end
    end
    -- v8 admits up to sixteen fixed results, as dynamic values.
    local results: integer = 1
    if resultsIgnored then
        need(dense(signature.params, 239) == #signature.paramPack.head, "checked parameter pack differs")
        result = "value"
    elseif alternatives then
        results = 0
        result = "value"
    else
        results = dense(signature.rets, dynamic and graph.MAX_RESULTS or 1)
        if signature.retPack.tail ~= nil and #signature.retPack.head == 0 then
            results = 0
        end
        need(
            dense(signature.params, 239) == #signature.paramPack.head and #signature.retPack.head == results,
            "fixed single-result signature required"
        )
    end
    for index, value in ipairs(signature.params) do
        need(value == signature.paramPack.head[index], "checked parameter pack differs")
        params[index] = scalar(value, numeric, dynamic)
    end
    for index, value in ipairs((resultsIgnored or results == 0) and {} or signature.rets) do
        need(value == signature.retPack.head[index], "checked result pack differs")
        result = scalar(value, numeric, dynamic)
    end
    -- RetN and the caller's frame carry the counts, so the signature needs
    -- only the kind.
    -- None, as a function that returns nothing, is read as values are.
    if results ~= 1 or not resultsIgnored and signature.retPack.tail ~= nil then
        result = "value"
    end
    if variadic then
        if not erasedTail then
            scalar(tail.type, numeric, dynamic)
        end
        params[#params + 1] = "value"
        return {kind = "callable", params = params, result = result, variadic = true}
    end

    return {kind = "callable", params = params, result = result}
end

local function checkedSignature(owner: any, numeric: boolean, dynamic: boolean): any
    local signature = need(owner.signature, "checked callable signature required")
    need(
        signature.tag == "func" and owner.body.signatureType == signature,
        "checked callable signature identity differs"
    )
    -- From v8 a call through a value makes a summary unknown, and a
    -- coroutine's yield runs on the core (`threads`): only an external effect
    -- is refused.
    local summary = owner.body.effectSummary
    need(summary and (summary.top == false or dynamic) and summary.external == false, "unknown callable effects")

    local result = typeSignature(signature, numeric, dynamic, owner.node.kind == "constructorDecl")
    -- A method's receiver is its first parameter on the core, though its
    -- function type leaves it out: a `:` method's implicit one, or the `self`
    -- an instance method in a record body spells.
    if owner.body.coreSelfParam
        or owner.node.kind == "inlineMethod" and not owner.node.inlineStatic
        or owner.node.kind == "constructorDecl"
    then
        table.insert(result.params, 1, "value")
    end

    return result
end

-- What makes two signature records one: interning keeps a record per key.
export function signatureKey(signature: any): string
    return signature.kind .. ":" .. table.concat(
        signature.params,
        ","
    ) .. (signature.variadic and "..." or "") .. "->" .. signature.result
end

local function intern(signatures: any, index: any, signature: any): integer
    local key = signatureKey(signature)
    local previous = index[key]
    if previous ~= nil then
        return previous
    end
    local id = #signatures
    signature.id = id
    signatures[id + 1], index[key] = signature, id

    return id
end

-- Forward only the private host-binding calls of a checked standard installer.
-- These rows affect error context alone, never call targets or signatures.
const FORWARD_NONE = 0
const FORWARD_CALL = 1
const FORWARD_RECEIVER = 2

local forwarding: {
    [string]: {[string]: string}
} = {
    [
        "nupp.runtime.standardio"
    ] = {
        openFile = "open",
        fileLines = "lines",
        inputFile = "input",
        outputFile = "output",
        closeFile = "close",
        fileType = "type",
        readFile = "read",
        writeFile = "write",
        flushFile = "flush"
    },
    ["nupp.runtime.standardos"] = {remove = "remove", rename = "rename"},
    ["io.internal.process"] = {seek = "seek", setvbuf = "setvbuf"}
}

local function localinitializer(p: any, chunk: any, definition: any): any
    local binding = definition and p.byDefinition[definition]
    if not binding or binding.owner ~= chunk.id then
        return nil
    end
    for _, block in ipairs(chunk.body.blocks) do
        for _, stat in ipairs(block.stats or {}) do
            if stat.kind == "localStmt" then
                for index, token in ipairs(stat.names or {}) do
                    if token.definition == definition and token == definition.token then
                        return stat.exprs and stat.exprs[index]
                    end
                end
            end
        end
    end

    return nil
end

-- A checked Process method passes its receiver and arguments unchanged to the
-- imported file formatter. Its public caller, not the helper call, names errors.
local function fileforward(p: any, owner: any, call: any, member: string): boolean
    local node = owner.node
    local chunk = p.owners[owner.parent + 1]
    local record = p.recordMembers[node]
    if owner.scope.name ~= "io.internal.process"
        or node.kind ~= "inlineMethod"
        or node.inlineStatic
        or not record
        or not node.name
        or node.name.text ~= owner.name
        or node.name.definition ~= owner.definition
        or p.functionsByDefinition[owner.definition] ~= owner
        or p.byBody[owner.body] ~= owner
        or not chunk
        or chunk.kind ~= "module"
        or chunk.scope ~= owner.scope
        or call.kind ~= "call"
        or call.obj.kind ~= "dotIndex"
        or call.obj.name.text ~= member
        or call.obj.obj.kind ~= "name"
    then
        return false
    end
    local declared = false
    for declaration in pairs(p.recordDecls) do
        if declaration.name and declaration.name.definition == record and declaration.name.text == "Process" then
            for _, entry in ipairs(declaration.entries or {}) do
                declared = declared or entry == node
            end
        end
    end
    if not declared then
        return false
    end
    local definition = call.obj.obj.token.definition
    local original = localinitializer(p, chunk, definition)
    local site = original and p.requireByNode[original]
    if not definition
        or definition.reassigned
        or definition.requiredModule ~= "io.internal.fileformat"
        or not original
        or original.kind ~= "call"
        or original.runtimeLoader ~= "require"
        or original.requiredModule ~= "io.internal.fileformat"
        or not site
        or site.node ~= original
        or site.owner ~= chunk.id
        or site.module ~= "io.internal.fileformat"
        or site.target == nil
    then
        return false
    end
    local target = p.owners[site.target + 1]
    local issued = p.callByNode[call]
    if not target
        or target.kind ~= "module"
        or target.scope.name ~= site.module
        or not issued
        or issued.node ~= call
        or issued.owner ~= owner.id
    then
        return false
    end
    local params, args = graph.parameters(owner.body), call.args.exprs
    if #params ~= 3 or #args ~= #params then
        return false
    end
    for index, parameter in ipairs(params) do
        if not parameter.name
            or args[index].kind ~= "name"
            or args[index].token.definition ~= parameter.name.definition
        then
            return false
        end
    end

    return true
end

-- Whether `node` is `rawget(_G, root)`: Lua's own library table `root`.
local function rawgetroot(node: any, root: string): boolean
    return node.kind == "call"
        and node.obj.kind == "name"
        and node.obj.token.text == "rawget"
        and node.obj.token.definition ~= nil
        and node.obj.token.definition.filename == "nupp:lua.d.nupp"
        and #node.args.exprs == 2
        and node.args.exprs[1].kind == "name"
        and node.args.exprs[1].token.text == "_G"
        and node.args.exprs[1].token.definition ~= nil
        and node.args.exprs[1].token.definition.filename == "nupp:lua.d.nupp"
        and node.args.exprs[2].kind == "string"
        and lexer.stringValue(node.args.exprs[2].token.text) == root
end

-- Whether a chunk local's initializer `value` is Lua's own library table
-- `root`: `rawget(_G, root)`, or a call with no arguments of a function the
-- chunk declares that reads it so (standardos finds the core's os library
-- when nothing has published it yet).
local function hostlibrary(p: any, value: any, root: string): boolean
    if rawgetroot(value, root) then
        return true
    end
    if value.kind ~= "call" or value.obj.kind ~= "name" or #value.args.exprs ~= 0 then
        return false
    end
    local finder = p.functionsByDefinition[value.obj.token.definition or false]
    if not finder or finder.node.kind ~= "localFuncStmt" or finder.definition.reassigned then
        return false
    end
    local found = false
    local walk: function(any): nil
    walk = function(node: any): nil
        if found or type(node) ~= "table" or cst.isToken(node) then
            return
        end
        if node.kind == "call" and rawgetroot(node, root) then
            found = true
            return
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(finder.node.body)

    return found
end

local function forwardcontext(p: any, owner: any, call: any): integer
    local methods = forwarding[owner.scope.name]
    local member = methods and methods[owner.name]
    if not member or owner.kind ~= "function" then
        return FORWARD_NONE
    end
    if owner.scope.name == "io.internal.process" then
        return fileforward(p, owner, call, member) and FORWARD_CALL or FORWARD_NONE
    end
    local declaration = owner.node.kind == "localFuncStmt" and owner.node.name
        or owner.node.kind == "funcStmt" and #owner.node.name == 1 and owner.node.name[1]
    if not declaration
        or not owner.definition
        or p.functionsByDefinition[owner.definition] ~= owner
        or p.byBody[owner.body] ~= owner
        or declaration.definition ~= owner.definition
        or declaration.text ~= owner.name
    then
        return FORWARD_NONE
    end
    local chunk = p.owners[owner.parent + 1]
    if not chunk or chunk.kind ~= "module" or chunk.scope ~= owner.scope then
        return FORWARD_NONE
    end
    local root = owner.scope.name == "nupp.runtime.standardio" and "io" or "os"
    if call.kind == "methodCall" then
        local receiver = call.obj and call.obj.kind == "name" and call.obj.token
        local expected = owner.name == "writeFile" and "processOutput" or "processInput"
        if (owner.name == "readFile" or owner.name == "writeFile" or owner.name == "fileLines")
            and call.name.text == member
            and receiver
            and receiver.text == expected
            and localinitializer(p, chunk, receiver.definition) ~= nil
        then
            return FORWARD_RECEIVER
        end
        return FORWARD_NONE
    end
    local callee = call.kind == "call" and call.obj
    local definition = callee and callee.kind == "name" and callee.token.definition
    local value = localinitializer(p, chunk, definition)
    if not value
        or value.kind ~= "dotIndex"
        or value.name.text ~= member
        or value.obj.kind ~= "name"
        or definition.reassigned
    then
        return FORWARD_NONE
    end
    local original = localinitializer(p, chunk, value.obj.token.definition)
    if not original or value.obj.token.definition.reassigned or not hostlibrary(p, original, root) then
        return FORWARD_NONE
    end

    return FORWARD_CALL
end

-- Diagnostic names describe the issued source call, never its runtime target.
-- The kind of name callee `name` is to the call in `owner`, as Lua's
-- debug.getinfo says it: a global where no declaration binds it (a chunk's
-- global or the prelude's), a local where `owner` declares it, and an
-- upvalue where a function around it does.
local function namekind(p: any, owner: any, name: any): string
    local token = name.token
    local definition = token.definition
    if definition == nil or p.globals and p.globals[token] ~= nil or graphcalls.preludeName(name) then
        return "global"
    end
    local first, last = cst.firstToken(owner.node), cst.lastToken(owner.node)
    local at = definition.token and definition.token.offset
    if at ~= nil and first ~= nil and last ~= nil and first.offset <= at and at <= last.offset then
        return "local"
    end

    return "upvalue"
end

-- A call's diagnostic row: whether it is a method call, the name it gives
-- the function it calls and what kind of name that is.
local function diagnostic(p: any, owner: any, call: any, protected: boolean): any
    if protected then
        return {method = false}
    end
    if call.kind == "forinStmt" then
        return {method = false, name = "for iterator", namewhat = "for iterator"}
    end
    if call.kind == "methodCall" then
        return {method = true, name = call.name.text}
    end
    local callee = call.obj
    -- `(f as any)(x)` names f, as the call it compiles to does.
    while callee and (callee.kind == "paren" or callee.kind == "castExpr") do
        callee = callee.expr
    end
    if callee and callee.kind == "name" then
        return {method = false, name = callee.token.text, namewhat = namekind(p, owner, callee)}
    elseif callee and callee.kind == "dotIndex" then
        return {method = false, name = callee.name.text, namewhat = "field"}
    end

    return {method = false}
end

local function tailcalls(p: any, owner: any): {[any]: boolean}
    local found: {[any]: boolean} = {}
    if p.cleanupOwners[owner.id] then
        return found
    end
    local walk: function(any): nil
    walk = function(node: any): nil
        if type(node) ~= "table" then
            return
        end
        local nested = p.byBody[node]
        if nested and nested ~= owner then
            return
        end
        if node.kind == "returnStmt" and #node.exprs == 1 then
            local call = node.exprs[1]
            local site = (call.kind == "call" or call.kind == "methodCall") and p.callByNode[call]
            if site and site.owner == owner.id then
                found[call] = true
            end
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(owner.body)

    return found
end

-- What normalizing any owner of checked catalog `p` at profile `v` reads: the
-- profile's schema and admitted operations, and the require sites its graphs
-- answer, by the owner that makes each. A whole program normalizes every owner
-- against it (`normalize`); a module piece its own (nupp.compiler.vm.corepiece).
-- `moduleCount` is how many modules the program carries.
export function admit(p: any, v: integer, moduleCount: integer): any
    local loops = v >= 5
    for _, key in ipairs({"externals", "externalReferences"}) do
        need(type(p[key]) == "table" and next(p[key]) == nil, "unsupported catalog " .. key)
    end
    -- The ownership intrinsics the core runs: transfers, partition, drop.
    need(type(p.intrinsics) == "table", "checked intrinsics required")
    for _, intrinsic in ipairs(p.intrinsics) do
        need(
            program.executableIntrinsic(intrinsic.node),
            "unsupported catalog intrinsic " .. tostring(intrinsic.operation)
        )
    end
    local requireSite
    -- From v8 every require is a site of its own, each naming one of the
    -- program's modules.
    local requiresites: {any} = {}
    need(type(p.imports) == "table" and type(p.requires) == "table", "checked import tables required")
    if v >= 8 and (#p.imports ~= 0 or #p.requires ~= 0) then
        local byname, bychunk = {}, {}
        for _, module in ipairs(p.modules) do
            byname[module.name], bychunk[module.chunk] = module, module
        end
        need(type(p.requireByNode) == "table", "checked require source required")
        -- A require that selects only types is erased: it loads nothing, and nor
        -- does one of a module the program does not carry, which is required by
        -- name when it runs.
        local loading = {}
        for _, site in ipairs(p.requires) do
            if not (type(
                site
            ) == "table"
                and (site.typeOnly and type(
                    site.node
                ) == "table" and site.node.typeOnlyRequire
                or site.corecalls
                or site.absent and site.target == nil and site.node.runtimeLoader == "require"
                -- A chunk's qualified path into the running program's module.
                or site.absent and site.target == nil and site.qualified and p.chunk)) then
                loading[#loading + 1] = site
            end
        end
        for _, site in ipairs(loading) do
            local target = type(site) == "table" and byname[site.module] or nil
            need(
                target ~= nil
                and type(site.node) == "table"
                and site.target == target.chunk
                and not site.typeOnly
                and (
                    (
                        site.node.runtimeLoader == "require"
                        or site.qualified
                        and (
                            site.library ~= nil
                            or site.node.qualifiedModule ~= nil
                            and graph.coremodule(site.node.qualifiedModule) == site.module
                        )
                    )
                )
                and p.requireByNode[site.node] == site,
                "checked require target or source identity differs"
            )
            requiresites[#requiresites + 1] = site
        end
        for _, imported in ipairs(p.imports) do
            local binding = type(imported) == "table"
                and type(imported.binding) == "number"
                and p.bindings[imported.binding + 1]
                or nil
            local target = type(imported) == "table" and bychunk[imported.target] or nil
            need(
                type(binding) == "table"
                and type(binding.definition) == "table"
                and target ~= nil
                and imported.projection == binding.builtinImport
                and program.importmodule(p, binding) == target.name,
                "checked import target or source identity differs"
            )
        end
    elseif #p.imports ~= 0 or #p.requires ~= 0 then
        need(
            moduleCount == 2 and #p.imports == 1 and #p.requires == 1,
            "only one checked two-module import is executable"
        )
        requireSite = p.requires[1]
        local imported = p.imports[1]
        local first = p.modules[1]
        need(
            type(requireSite) == "table" and type(imported) == "table" and type(first) == "table",
            "checked import records required"
        )
        need(type(requireSite.node) == "table" and type(p.requireByNode) == "table", "checked require source required")
        local binding = type(imported.binding) == "number" and p.bindings[imported.binding + 1] or nil
        need(type(binding) == "table" and type(binding.definition) == "table", "checked import binding required")
        need(
            requireSite.owner == p.entry
            and requireSite.target == first.chunk
            and requireSite.module == first.name
            and not requireSite.typeOnly
            and requireSite.node.runtimeLoader == "require"
            and p.requireByNode[requireSite.node] == requireSite
            and imported.target == first.chunk
            and graph.coremodule(binding.definition.requiredModule) == first.name,
            "checked import target or source identity differs"
        )
        requiresites = {requireSite}
    end
    local definition = schema.describe(v)
    local admitted = {}
    for _, item in ipairs(definition.operations) do
        admitted[item.name] = item
    end
    -- Each owner's require sites, in the order a graph's requires match them.
    local sitesByOwner: {[integer]: {any}} = {}
    for _, site in ipairs(requiresites) do
        local list = sitesByOwner[site.owner] or {}
        sitesByOwner[site.owner] = list
        list[#list + 1] = site
    end

    return {
        catalog = p,
        version = v,
        numeric = v >= 3,
        loops = loops,
        schema = definition,
        admitted = admitted,
        requiresites = requiresites,
        sitesByOwner = sitesByOwner
    }
end

-- The frame a whole program normalizes in: every owner's id is its checked one.
local function programFrame(): any
    return {
        id = function(id: integer): integer?
            return id
        end,
        callsite = function(site: any): integer?
            return integer(site.id, bounds.calls - 1)
        end
    }
end

-- A normalization in progress over `admission`, in `frame`: the semantic
-- tables it fills, in the order owners are recorded. `frame.id(id)` is the id
-- of checked owner `id` in the frame, nil for one outside it, which only a
-- frame with `foreign(owner, signature)` admits as a call's target, naming
-- it by the id that returns. `frame.callsite(site)` is a contract's callsite,
-- and `frame.relocate(g)`, when given, rewrites a semantic graph copy's owner
-- ids into the frame, and `frame.module(name)`, when given, hears each module
-- a graph requires.
export function open(admission: any, frame: any?): any
    return {
        admission = admission,
        frame = frame or programFrame(),
        output = {schema = admission.schema, modules = {}, catalog = {}, signatures = {}, graphs = {}, contracts = {}},
        diagnostics = {},
        signatureIndex = {},
        callEdges = {},
        -- By checked owner id, each module record the frame holds.
        modulesByOwner = {},
        -- The require operations matched to their checked sites.
        foundRequires = 0
    }
end

-- The id of `signature` in `unit`'s signature table, interned there.
export function sign(unit: any, signature: any): integer
    return intern(unit.output.signatures, unit.signatureIndex, signature)
end

-- The first pass for checked `owner`, lowered to graph `g`: its catalog record
-- and signature, and its graph's semantic copy, in the frame.
export function enter(unit: any, owner: any, g: any): nil
    local a, output, frame = unit.admission, unit.output, unit.frame
    local p, v = a.catalog, a.version as integer
    local index = #output.catalog + 1
    need(v >= 7 or dense(owner.captures, 256) == 0, "captures are unsupported")
    local record: any = {
        id = integer(frame.id(owner.id), bounds.owners - 1),
        kind = owner.kind,
        graph = index - 1,
        effect = 0
    }
    need(record.id == index - 1, "owner order differs")
    if owner.kind == "function" then
        record.parent = integer(frame.id(owner.parent), bounds.owners - 1)
        record.signature = intern(
            output.signatures,
            unit.signatureIndex,
            located(
                owner.scope and owner.scope.path,
                owner.node,
                function(): any
                    return checkedSignature(owner, a.numeric, v >= 8)
                end
            )
        )
    else
        need(
            owner.kind == "module" and unit.modulesByOwner[owner.id] ~= nil and owner.parent == nil,
            "unsupported initializer owner"
        )
    end
    output.catalog[index], unit.callEdges[index] = record, {}
    local copied = semantic.copyGraph(g, v, true)
    if frame.relocate then
        frame.relocate(copied)
    end
    output.graphs[index] = copied
    -- The checked program is the authority for every id but this one.
    need(p.owners[owner.id + 1] == owner, "foreign checked owner")
end

-- The second pass for the `index`th recorded owner, checked `owner` lowered
-- to `source`: its operations' effects, its require operations matched to
-- their checked sites, and a contract and call diagnostic for each call.
export function contract(unit: any, index: integer, owner: any, source: any): nil
    local a, frame = unit.admission, unit.frame
    local output, p, v = unit.output, a.catalog, a.version as integer
    local g = output.graphs[index]
    need(g.programOwner == index - 1, "graph owner order differs")
    local record = output.catalog[index]
    local tails = v >= 8 and tailcalls(p, owner) or {}
    local sites = a.sitesByOwner[owner.id] or {}
    for bi, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            local policy = need(a.admitted[op], "unsupported operation " .. op)
            if op == "Closure" then
                need(v >= 7 or #block.args[at] == 1, "captures are unsupported")
            elseif op == "Require" then
                unit.foundRequires += 1
                local constant = need(g.constants[block.args[at][1] + 1], "require name is missing")
                local position = need(g.positions[block.pos[at]], "require graph position is missing")
                -- The site of this owner's require of this module at this
                -- position.
                local matched = nil
                for _, site in ipairs(sites) do
                    local token = cst.firstToken(site.node)
                    if token
                        and constant.kind == "str"
                        and constant.value == site.module
                        and position.line == token.line
                        and position.column == token.col
                    then
                        matched = site
                    end
                end
                need(matched ~= nil, "require graph differs from checked callsite")
                if frame.module then
                    frame.module(constant.value)
                end
            end
            record.effect = math.max(record.effect, policy.effect)
        end
        if block.term.kind == "invoke" then
            need(not a.loops or v >= 7, "calls are outside scalar loop profile")
            local call = source.blocks[bi].term.contract
            local site = need(p.callByNode and p.callByNode[call.call], "checked call-front membership required")
            need(
                p.calls
                and p.calls[site.id + 1] == site
                and site.owner == owner.id
                and site.node == call.call
                and (call.dynamic or site.definition == call.definition),
                "foreign checked callsite"
            )
            -- A dynamic call has no target; its signature comes from the
            -- call's checked function type and is checked when it runs.
            local target, signature = ABSENT, 0
            if call.dynamic then
                need(v >= 8, "dynamic calls are outside this profile")
                signature = intern(
                    output.signatures,
                    unit.signatureIndex,
                    located(
                        source.source and source.source.path,
                        call.call,
                        function(): any
                            return typeSignature(call.callSignature, a.numeric, true)
                        end
                    )
                )
            else
                need(
                    p.functionsByDefinition[call.definition] == call.owner
                    and p.owners[call.owner.id + 1] == call.owner,
                    "foreign checked call target"
                )
                local id = frame.id(call.owner.id)
                if id ~= nil then
                    local held = output.catalog[id + 1]
                    need(held.kind == "function", "initializer is not callable")
                    target, signature = held.id, held.signature
                else
                    -- An owner outside the frame is named by its own
                    -- signature, which linking holds the owner to.
                    need(call.owner.kind == "function", "initializer is not callable")
                    signature = intern(
                        output.signatures,
                        unit.signatureIndex,
                        located(
                            call.owner.scope and call.owner.scope.path,
                            call.owner.node,
                            function(): any
                                return checkedSignature(call.owner, a.numeric, v >= 8)
                            end
                        )
                    )
                    target = frame.foreign(call.owner, signature)
                end
            end
            local id = #output.contracts
            output.contracts[id + 1] = {
                id = id,
                owner = record.id,
                block = block.id,
                callsite = frame.callsite(site),
                target = target,
                signature = signature,
                effect = 1,
                -- pcall(f, ...): the callee runs as a protected call.
                protected = call.protected == true or nil,
                -- xpcall(f, handler, ...): its handler is staged apart.
                handled = call.handled == true or nil
            }
            local row = diagnostic(p, owner, call.call, call.protected == true)
            row.tail = tails[call.call] == true or nil
            row.forward = forwardcontext(p, owner, call.call)
            if row.forward ~= FORWARD_NONE then
                local methods = forwarding[owner.scope.name]
                local member = methods and methods[owner.name]
                need(member ~= nil, "checked forwarding member missing")
                if owner.scope.name == "io.internal.process" then
                    row.name = "?"
                else
                    local root = owner.scope.name == "nupp.runtime.standardio" and "io" or "os"
                    row.name = root .. "." .. (member as string)
                end
            end
            unit.diagnostics[id + 1] = row
            block.term.contract = id
            record.effect = 1
            if not call.dynamic then
                unit.callEdges[index][#unit.callEdges[index] + 1] = target + 1
            end
        end
    end
end

-- The third pass for the `index`th recorded owner: its graph's result kind,
-- which a module's initializer signature takes and a function's checked
-- signature must admit. `view` answers the graph's references (the semantic
-- tables by default). Returns the kind.
export function settle(unit: any, index: integer, view: any?): string
    local output, v = unit.output, unit.admission.version as integer
    local g, owner = output.graphs[index], output.catalog[index]
    local signature = owner.kind == "module" and {kind = "initializer", params = {}}
        or output.signatures[owner.signature + 1]
    local kind = semantic.resultKind(g, signature, view or output)
    if owner.kind == "module" then
        need(g.nparams == 0, "initializer has parameters")
        owner.signature = intern(output.signatures, unit.signatureIndex, {
            kind = "initializer",
            params = {},
            result = kind
        })
    else
        need(
            kind == signature.result or v >= 8 and (kind == "value" or signature.result == "value")
            -- Every return answering nil, where the checker gave a result,
            -- is a function that ends only by raising (`error(...)` last):
            -- its end is unreachable, and answers nil.
            or v >= 8 and kind == "nil",
            "graph result differs from checked signature: " .. tostring(
                g.name
            ) .. " in " .. tostring(g.path) .. " answers " .. tostring(kind) .. ", not " .. tostring(signature.result)
        )
    end

    return kind
end

export function normalize(compiled: any, version: integer?): (any, any)
    local v: integer = version or 2
    fields(compiled, "graphs header catalog")
    local p, graphs = compiled.catalog, compiled.graphs
    need(type(p) == "table", "authentic checked catalog required")
    dense(graphs, bounds.owners)
    fields(compiled.header, "shapes modules entry")
    need(dense(compiled.header.shapes, 1048576) == 0, "shape-free graph catalog required")
    local moduleCount = dense(compiled.header.modules, bounds.modules)
    need(moduleCount > 0 and dense(p.modules, bounds.modules) == moduleCount, "complete module table required")
    -- From v8 a program's modules run as their requirers call them.
    need(v < 5 or moduleCount == 1 or v >= 8, "loop profile requires one scalar initializer")
    need(#p.owners == #graphs, "complete graph table required")
    local unit = open(admit(p, v, moduleCount))
    local output = unit.output
    output.entry = integer(compiled.header.entry, bounds.owners - 1)
    need(output.entry == p.entry, "entry owner differs")
    for index, module in ipairs(compiled.header.modules) do
        fields(module, "name path chunk")
        need(
            module.name == p.modules[index].name
            and module.path == p.modules[index].path
            and module.chunk == p.modules[index].chunk
            and module.chunk == index - 1
            and need(p.owners[module.chunk + 1], "module initializer is missing").kind == "module",
            "module initializer binding differs"
        )
        local record = {
            name = text(module.name),
            path = text(module.path),
            chunk = integer(module.chunk, bounds.owners - 1)
        }
        output.modules[index], unit.modulesByOwner[module.chunk] = record, record
    end
    need(unit.modulesByOwner[output.entry] ~= nil, "entry initializer is not cataloged")
    for index = 1, dense(p.owners, bounds.owners) do
        enter(unit, p.owners[index], graphs[index])
    end
    -- This is the authoritative source-side gate. Decoders must never call it
    -- with fabricated checker objects. Call-front adds callsite membership.
    program.verifyGraphs(p, graphs)
    for index, g in ipairs(graphs) do
        contract(unit, index, p.owners[index], g)
    end
    need(unit.foundRequires == #unit.admission.requiresites, "checked require graph is incomplete")
    -- v7 admits recursion; its depth is bounded by the entry's frame pool.
    if v < 7 then
        semantic.topological(output.catalog, unit.callEdges, nil)
    end
    for index in ipairs(output.graphs) do
        settle(unit, index, nil)
    end

    return output, unit.diagnostics
end
