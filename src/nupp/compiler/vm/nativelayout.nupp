module nupp.compiler.vm.nativelayout

local targetLayout = require("nupp.compiler.targetlayout")

-- Physical layout is a property of the checked Nupp type and the native target.
local function checkedLayout(node: any, arguments: integer, explicitTarget: string?): any
    assert(node.typeArgs and #node.typeArgs == 1, "native layout requires one explicit type argument")
    assert(node.args and #(node.args.exprs or {}) == arguments, "native layout argument count")
    local subject = assert(node.typeArgs[1].resolvedType, "native layout requires a checked type")
    local target = explicitTarget or assert(targetLayout.hostKey(), "native layout requires a supported host target")
    local measured, reason = targetLayout.of(subject, target)
    assert(measured, "native layout: " .. tostring(reason))

    return measured
end

export function constant(node: any, property: "size" | "alignment", target: string?): string
    return tostring(checkedLayout(node, 0, target)[property])
end

export function fieldOffset(node: any, target: string?): string
    local measured = checkedLayout(node, 1, target)
    local argument = node.args.exprs[1]
    assert(argument.kind == "string", "native field offset requires a literal field name")
    local name = argument.token.value or argument.token.text:sub(2, -2)
    for _, field in ipairs(measured.fields) do
        if field.name == name then
            assert(not field.bitWidth, "native field offset requires an addressable field")
            return tostring(field.offset)
        end
    end
    error("native field offset: unknown field " .. name, 0)
end
