-- The operations HOST_FILES takes first, and how many arguments follow
-- each: the file calls' (nupp.runtime.filecalls), then the reactor's, the
-- poller's (nupp.runtime.pollcalls) and the blocking-work pool's
-- (nupp.runtime.poolcalls), which guestreactor answers, then the process
-- layer's (nupp.runtime.processcalls), which guestprocess answers. Each
-- group's operations are consecutive, its bounds `<GROUP>_FIRST` and
-- `<GROUP>_LAST`; requiring one of its declaration modules loads nothing.
export type Operation = {
    name: string,
    library: string,
    operation: integer,
    arguments: integer
}

export type Group = {
    name: string,
    call: string,
    modules: {string},
    operations: {Operation}
}

local grouprows: {Group} = {
    {
        name = "FILES",
        call = "HOST_FILES",
        modules = {"filecalls"},
        operations = {
            {name = "FILE_OPEN", library = "filecalls.open", operation = 1, arguments = 2},
            {name = "FILE_READ", library = "filecalls.read", operation = 2, arguments = 2},
            {name = "FILE_WRITE", library = "filecalls.write", operation = 3, arguments = 3},
            {name = "FILE_SEEK", library = "filecalls.seek", operation = 4, arguments = 3},
            {name = "FILE_CLOSE", library = "filecalls.close", operation = 5, arguments = 1},
            {name = "FILE_REASON", library = "filecalls.reason", operation = 6, arguments = 1}
        }
    },
    {
        name = "REACTOR",
        call = "HOST_FILES",
        modules = {"pollcalls", "poolcalls"},
        operations = {
            {name = "POLL_OPEN", library = "pollcalls.open", operation = 7, arguments = 0},
            {name = "POLL_ARM", library = "pollcalls.arm", operation = 8, arguments = 3},
            {name = "POLL_WAIT", library = "pollcalls.wait", operation = 9, arguments = 2},
            {name = "POLL_PIPE", library = "pollcalls.pipe", operation = 10, arguments = 0},
            {name = "POOL_START", library = "poolcalls.start", operation = 11, arguments = 1},
            {name = "POOL_OPEN", library = "poolcalls.open", operation = 12, arguments = 2},
            {name = "POOL_READ", library = "poolcalls.read", operation = 13, arguments = 2},
            {name = "POOL_WRITE", library = "poolcalls.write", operation = 14, arguments = 3},
            {name = "POOL_TAKE", library = "poolcalls.take", operation = 15, arguments = 0},
            {name = "POOL_FINISH", library = "poolcalls.finish", operation = 16, arguments = 2},
            {name = "POOL_CANCEL", library = "poolcalls.cancel", operation = 17, arguments = 1}
        }
    },
    {
        -- The process layer's: a pipe for a child's stream, spawning, watching
        -- and no longer watching a child's exit, collecting it, signalling
        -- its group, ending this process, and running every finalizer first.
        name = "PROCESS",
        call = "HOST_FILES",
        modules = {"processcalls"},
        operations = {
            {name = "PROCESS_PIPE", library = "processcalls.pipe", operation = 18, arguments = 1},
            {name = "PROCESS_SPAWN", library = "processcalls.spawn", operation = 19, arguments = 2},
            {name = "PROCESS_WATCH", library = "processcalls.watch", operation = 20, arguments = 2},
            {name = "PROCESS_UNWATCH", library = "processcalls.unwatch", operation = 21, arguments = 2},
            {name = "PROCESS_REAP", library = "processcalls.reap", operation = 22, arguments = 1},
            {name = "PROCESS_KILL", library = "processcalls.kill", operation = 23, arguments = 2},
            {name = "PROCESS_EXIT", library = "processcalls.exit", operation = 24, arguments = 1},
            {name = "PROCESS_CLOSE", library = "processcalls.close", operation = 25, arguments = 0}
        }
    },
    {
        -- The scheduler's primitives (nupp.runtime.taskcalls), which the
        -- TASKS call takes: a task of a function and the pack of its
        -- arguments; running one until it returns, fails, parks or yields,
        -- its park answered with a value; parking the running task; the
        -- running task; a task's record, and setting it; the monotonic clock
        -- in milliseconds; waiting some milliseconds; and installing the
        -- threads' shared metatable and the function closing a task.
        name = "TASK",
        call = "TASKS",
        modules = {"taskcalls"},
        operations = {
            {name = "TASK_NEW", library = "taskcalls.new", operation = 1, arguments = 2},
            {name = "TASK_RUN", library = "taskcalls.run", operation = 2, arguments = 2},
            {name = "TASK_PARK", library = "taskcalls.park", operation = 3, arguments = 0},
            {name = "TASK_CURRENT", library = "taskcalls.current", operation = 4, arguments = 0},
            {name = "TASK_DATA", library = "taskcalls.data", operation = 5, arguments = 1},
            {name = "TASK_SETDATA", library = "taskcalls.setdata", operation = 6, arguments = 2},
            {name = "TASK_NOW", library = "taskcalls.now", operation = 7, arguments = 0},
            {name = "TASK_SLEEP", library = "taskcalls.sleep", operation = 8, arguments = 1},
            {name = "TASK_INSTALL", library = "taskcalls.install", operation = 9, arguments = 2}
        }
    }
}

-- The state tables some calls keep between steps, which the compiler reads
-- and writes too: each field's key, from 1, and the width the runtime reads
-- the key at.
export type Layout = {
    name: string,
    kind: string,
    fields: {string}
}

local layoutrows: {Layout} = {
    -- `for ... in s:gmatch(p)`: the subject, the pattern, and the byte offsets
    -- the next search starts at and the last match ended at; the match's
    -- captures (or the whole match) from CAPTURES on.
    {name = "GMATCH", kind = "uint64", fields = {"SUBJECT", "PATTERN", "SOURCE", "LAST", "CAPTURES"}},
    -- `for k, v in pairs(t)`: the table, the key the step goes on after, and
    -- the pair it leaves.
    {name = "PAIRS", kind = "uint64", fields = {"TABLE", "AFTER", "KEY", "VALUE"}},
    -- table.sort with a comparator: the list, the comparator, the two values
    -- it is asked about and its answer, then the merge sort's own fields.
    {
        name = "SORT",
        kind = "int64",
        fields = {
            "LIST",
            "LESS",
            "A",
            "B",
            "ANSWER",
            "N",
            "WIDTH",
            "LO",
            "MID",
            "HI",
            "I",
            "J",
            "K",
            "BUFFER",
            "PENDING"
        }
    },
    -- string.gsub with a function replacement: the subject, the pattern and
    -- the function, the step's own fields, the captures the function is
    -- called with and its answer.
    {
        name = "GSUB",
        kind = "int64",
        fields = {
            "SUBJECT",
            "PATTERN",
            "FUNCTION",
            "SRC",
            "LAST",
            "N",
            "LIMIT",
            "PIECES",
            "CAPTURES",
            "ANSWER",
            "AT",
            "END",
            "PENDING",
            "ANCHOR",
            "COPY",
            "COUNT"
        }
    }
}

-- The element kinds of storage (corestorage) and of a packed table's array
-- part (coretables), by the checked element type: the runtime's constant
-- names each, which the guest artifact producer holds to this table.
export type Element = {
    name: string,
    module: string,
    element: string,
    kind: integer
}

local elementrows: {Element} = {
    {name = "UINT8", module = "corestorage", element = "uint8", kind = 1},
    {name = "INT8", module = "corestorage", element = "int8", kind = 2},
    {name = "UINT16", module = "corestorage", element = "uint16", kind = 3},
    {name = "INT16", module = "corestorage", element = "int16", kind = 4},
    {name = "UINT32", module = "corestorage", element = "uint32", kind = 5},
    {name = "INT32", module = "corestorage", element = "int32", kind = 6},
    {name = "UINT64", module = "corestorage", element = "uint64", kind = 7},
    {name = "INT64", module = "corestorage", element = "int64", kind = 8},
    {name = "FLOAT32", module = "corestorage", element = "float32", kind = 9},
    {name = "FLOAT64", module = "corestorage", element = "float64", kind = 10},
    -- Booleans pack in a table's array part only.
    {name = "PACKED_BOOLEAN", module = "coretables", element = "boolean", kind = 11}
}

local ids: {[string]: integer} = {}
local singles: {[string]: Call} = {}
local packs: {[string]: integer} = {}
local metas: {[integer]: boolean} = {}
local files: {[string]: Operation} = {}
-- The call each operation's library function rides.
local calls: {[string]: integer} = {}

-- Every id is one call's, and every name one id's; a range subject's ids are
-- consecutive.
do
    local taken: {[integer]: string} = {}
    for _, subject in ipairs(subjectrows) do
        local low: integer, high: integer = LIMIT, 0
        for _, entry in ipairs(subject.calls) do
            assert(entry.id >= 1 and entry.id < LIMIT, "core library id out of range: " .. entry.name)
            assert(taken[entry.id] == nil, "core library id " .. entry.id .. " taken twice: " .. entry.name)
            assert(ids[entry.name] == nil, "core library call named twice: " .. entry.name)
            taken[entry.id] = entry.name
            ids[entry.name] = entry.id
            low = math.min(low, entry.id) as integer
            high = math.max(high, entry.id) as integer
            if entry.call then
                assert(singles[entry.call] == nil, "core library function answered twice: " .. entry.call)
                assert(
                    entry.min and entry.max and entry.min >= 1 and entry.max >= entry.min,
                    "core library arity: " .. entry.name
                )
                singles[entry.call] = entry
            end
            if entry.packs then
                assert(packs[entry.packs] == nil, "core library pack answered twice: " .. entry.packs)
                packs[entry.packs] = entry.id
            end
            if entry.meta then
                metas[entry.id] = true
            end
        end
        assert(not subject.range or high - low + 1 == #subject.calls, "core library range has a gap: " .. subject.name)
    end
    -- Operations are numbered within the call they ride.
    local operations: {[string]: {[integer]: boolean}} = {}
    for _, group in ipairs(grouprows) do
        assert(ids[group.call], "operation group of no call: " .. group.name)
        local taken: {[integer]: boolean} = operations[group.call] or {}
        operations[group.call] = taken
        local first = group.operations[1].operation
        for index, row in ipairs(group.operations) do
            assert(not taken[row.operation], "operation taken twice: " .. row.name)
            assert(row.operation == first + index - 1, "operation group has a gap: " .. group.name)
            taken[row.operation] = true
            files[row.library] = row
            calls[row.library] = ids[group.call] as integer
        end
    end
end

-- The key of field `field` in state layout `layout`.
export function key(layout: string, field: string): integer
    for _, row in ipairs(layoutrows) do
        if row.name == layout then
            for index, name in ipairs(row.fields) do
                if name == field then
                    return index
                end
            end
        end
    end
    error("no core library state field " .. layout .. "." .. field)
end

-- A copy of the state layouts, for the generator.
export function layouts(): {Layout}
    local result = {}
    for index, row in ipairs(layoutrows) do
        local fields = {}
        for at, name in ipairs(row.fields) do
            fields[at] = name
        end
        result[index] = {name = row.name, kind = row.kind, fields = fields}
    end

    return result
end

-- The kind a packed array part of checked element type `element` takes, or
-- nil when that type does not pack.
export function packedkind(element: string): integer?
    for _, row in ipairs(elementrows) do
        if row.element == element then
            return row.kind
        end
    end

    return nil
end

-- A copy of the element kinds, for the producer's check.
export function elements(): {Element}
    local result = {}
    for index, row in ipairs(elementrows) do
        result[index] = {name = row.name, module = row.module, element = row.element, kind = row.kind}
    end

    return result
end

-- A call's id, by its name; an unknown name is an error.
export function id(name: string): integer
    local found = ids[name]
    assert(found ~= nil, "no core library call " .. name)

    return found
end

-- The call answering library function `library` with one result, or nil.
export function single(library: string?): Call?
    if library == nil then
        return nil
    end

    return singles[library]
end

-- The id of the call answering every result of `library` as a pack, or nil.
export function packed(library: string?): integer?
    if library == nil then
        return nil
    end

    return packs[library]
end

-- The operation library function `library` stands for, or nil.
export function operation(library: string?): Operation?
    if library == nil then
        return nil
    end

    return files[library]
end

-- The id of the call operation library function `library` rides.
export function opcall(library: string): integer
    local found = calls[library]
    assert(found ~= nil, "no operation " .. library)

    return found
end

-- Whether call `call`'s operands may call a metamethod in its place.
export function meta(call: integer): boolean
    return metas[call] == true
end

-- The graph immediate of call `call`, in method form or not.
export function immediate(call: integer, method: boolean): integer
    return method and call + METHOD_FORM or call
end

-- The id and the method form a graph immediate `word` carries.
export function split(word: integer): (integer, boolean)
    if word >= METHOD_FORM then
        return word - METHOD_FORM, true
    end

    return word, false
end

-- A copy of the subjects, for the generator.
export function subjects(): {Subject}
    local result = {}
    for index, subject in ipairs(subjectrows) do
        local calls = {}
        for at, entry in ipairs(subject.calls) do
            calls[
                at
            ] = {
                name = entry.name,
                id = entry.id,
                text = entry.text,
                call = entry.call,
                min = entry.min,
                max = entry.max,
                packs = entry.packs,
                meta = entry.meta
            }
        end
        result[index] = {name = subject.name, range = subject.range, calls = calls}
    end

    return result
end

-- A copy of the file operation groups, for the generator.
export function groups(): {Group}
    local result = {}
    for index, group in ipairs(grouprows) do
        local operations, modules = {}, {}
        for at, row in ipairs(group.operations) do
            operations[
                at
            ] = {name = row.name, library = row.library, operation = row.operation, arguments = row.arguments}
        end
        for at, name in ipairs(group.modules) do
            modules[at] = name
        end
        result[index] = {name = group.name, call = group.call, modules = modules, operations = operations}
    end

    return result
end

-- The declaration modules whose calls are file operations, by module name,
-- and the name a call of each is spelled with.
export function callmodules(): {[string]: string}
    local result = {}
    for _, group in ipairs(grouprows) do
        for _, name in ipairs(group.modules) do
            result["nupp.runtime." .. name] = name
        end
    end

    return result
end
