module nupp.compiler.vm.corelibrary

-- The core's library calls (the core-only LibCall instruction), defined once.
-- The compiler reads this table to emit them, and nupp.core.librarycallsgen
-- writes the runtime's constants from it
-- (native/core/src/nupp/runtime/core/librarycalls.nupp), which the native
-- units harness holds to exactly what the generator writes.
--
-- Each call has a name, the constant both sides spell it by, and an id no
-- other call shares. A call may also say:
--
--   text     the coretexts name its errors give it ("bad argument #1 to
--            'sub'"), when it reports one
--   call     the library function it answers with one result, and `min` and
--            `max`, the arguments that function admits, self included
--   packs    the library function whose every result it answers, as a pack
--            {[0] = n, ...} the compiler reads in order
--   meta     whether its operands may call a metamethod in its place
--
-- A subject marked `range` keeps its ids consecutive, so the runtime tells
-- its calls apart by `<SUBJECT>_FIRST` and `<SUBJECT>_LAST`.

export type Call = {
    name: string,
    id: integer,
    text: string?,
    call: string?,
    min: integer?,
    max: integer?,
    packs: string?,
    meta: boolean?
}

export type Subject = {
    name: string,
    range: boolean,
    calls: {Call}
}

-- Ids are below this, so the graph's immediate can carry the method-form flag
-- above every id.
export const LIMIT = 65536
-- A call in method form (`s:rep(n)`): its errors count arguments from the one
-- after self, as Lua's do. The graph's LibCall immediate adds this to the id;
-- the instruction carries it as COUNT_METHOD_FORM in its argument-count byte.
export const METHOD_FORM = 65536
export const COUNT_METHOD_FORM = 128
-- The most arguments a library call stages.
export const ARGUMENTS = 4

