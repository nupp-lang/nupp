module nupp.compiler.vm.native

-- The checked native IR is shared with the other CPU backends. This adapter
-- consumes its representations and control flow without importing a backend.
local lowering = require("nupp.compiler.aot.lower")
local verify = require("nupp.compiler.aot.verify")
local shapes = require("nupp.compiler.aot.simdshape")
local native = {}
local kinds = {u8 = 0, i8 = 1, u16 = 2, i16 = 3, u32 = 4, i32 = 5, u64 = 6, i64 = 7, f32 = 8, f64 = 9}
local REFUSED = {}

local function refuse()
    error(REFUSED, 0)
end

local function translate(program, body)
    if program.body == nil
        or not program.usesSimd
        or program.entryMode ~= "kernel"
        or program.workgroup
        or #(program.helpers or {}) > 0
        or #(program.constants or {}) > 0
        or #(program.resultTypes or {}) > 1
    then
        refuse()
    end
    local code, constants, names, spans = {}, {}, {}, {}
    local ni, nf, nv = 0, 0, 0

    local function emit(...)
        code[#code + 1] = {...}
        return #code
    end

    local function patch(at, destination)
        code[at][#code[at]] = destination - at - 1
    end

    local function alloc(ty)
        local family, element, shape = shapes.parts(ty)
        if family then
            local bits = assert(shapes.bits(element))
            shape = assert(shape)
            local lanes = shape:match("^fixed(%d+)$")
            lanes = lanes and tonumber(lanes) or 128 / (tonumber(shape:match("^lanesof(%d+)$")) or bits)
            if lanes < 2 or lanes > 64 or lanes % 1 ~= 0 then
                refuse()
            end
            local r = {class = family, kind = kinds[element], lanes = lanes, regs = {}, type = ty}
            if family == "vector" or family == "mask" then
                for i = 1, math.ceil(lanes * bits / 128) do
                    r.regs[i] = nv
                    nv = nv + 1
                end
            elseif family ~= "species" then
                refuse()
            end
            return r
        end
        if ty == "f64" or ty == "f32" then
            local r = {class = "f", reg = nf, type = ty};
            nf = nf + 1;
            return r
        end
        if kinds[ty] ~= nil or ty == "bool" then
            local r = {class = "i", reg = ni, type = ty};
            ni = ni + 1;
            return r
        end
        refuse()
    end

    local function ik(k)
        local r = alloc("u64");
        emit("IK", r.reg, k);
        r.signedFits = k >= 0 and k <= 9007199254740991
        return r
    end

    local function floating(r)
        if r.class == "f" then
            return r
        end
        if r.class ~= "i" or r.type == "u64" and not r.signedFits then
            refuse()
        end
        local d = alloc("f64");
        emit("IToF", d.reg, r.reg);

        return d
    end

    local function integer(r)
        if r.class == "i" then
            return r
        end
        -- General floating-to-integer conversions have distinct rounding and
        -- overflow contracts. Only exact constants are admitted below.
        refuse()
    end

    local function move(dst, src)
        if dst.class ~= src.class then
            refuse()
        end
        if dst.class == "f" or dst.class == "i" then
            emit(dst.class == "f" and "FMov" or "IMov", dst.reg, src.reg)
        elseif dst.class == "vector" or dst.class == "mask" then
            if dst.type ~= src.type or #dst.regs ~= #src.regs then
                refuse()
            end
            for i, r in ipairs(dst.regs) do
                emit("VMov", r, src.regs[i])
            end
        elseif dst.class ~= "species" then
            refuse()
        end
    end

    for i, p in ipairs(program.params) do
        if p.kind == "read_span" or p.kind == "write_span" then
            local physical = {
                uint8 = 0,
                int8 = 1,
                uint16 = 2,
                int16 = 3,
                uint32 = 4,
                int32 = 5,
                uint64 = 6,
                int64 = 7,
                float = 8,
                number = 9
            }
            local kind = physical[p.sourceType or ""] or kinds[p.type]
            if kind == nil or p.soa then
                refuse()
            end
            local len = alloc("u64")
            len.signedFits = true
            spans[p.name] = {reg = i, len = len, kind = kind, write = p.kind == "write_span"}
            emit("SpanLen", len.reg, i, kind)
        elseif p.kind == "uniform" and kinds[p.type] ~= nil then
            local r = alloc(p.type);
            emit(r.class == "f" and "FUnbox" or "IUnbox", r.reg, i);
            names[p.uniqueName or p.name] = r
        else
            refuse()
        end
    end
    local expression

    local function binary(op, a, b, ty)
        local d = alloc(ty)
        local compare = {eq = "Eq", ne = "Ne", lt = "Lt", le = "Le", gt = "Lt", ge = "Le"}
        if compare[op] then
            if op == "gt" or op == "ge" then
                a, b = b, a
            end
            local float = a.class == "f" or b.class == "f"
            if float then
                a, b = floating(a), floating(b)
            end
            local prefix = float and "FCmp" or "ICmp"
            if not float and (compare[op] == "Lt" or compare[op] == "Le") and a.type:sub(1, 1) == "i" then
                prefix = "ICmpS"
            end
            emit(prefix .. compare[op], d.reg, a.reg, b.reg)
        elseif op == "and" or op == "or" then
            emit(op == "and" and "IAnd" or "IOr", d.reg, integer(a).reg, integer(b).reg)
        elseif ty == "f64" then
            local operations: {[string]: string} = {add = "FAdd", sub = "FSub", mul = "FMul", div = "FDiv"}
            local operation = operations[op]
            if not operation then
                refuse()
            end
            emit(operation, d.reg, floating(a).reg, floating(b).reg)
        else
            local operations: {
                [string]: string
            } = {u32_add = "IAdd", u32_sub = "ISub", u64_add = "IAdd", u64_sub = "ISub"}
            local operation = operations[op]
            if not operation then
                refuse()
            end
            emit(operation, d.reg, integer(a).reg, integer(b).reg)
            if ty == "u32" then
                emit("IMaskU32", d.reg, d.reg)
            end
        end

        return d
    end

    local function guardExpr(e)
        if e.kind == "paren" then
            return guardExpr(e.expr)
        end
        if e.kind == "binop" then
            local op = ({
                ["=="] = "eq",
                ["~="] = "ne",
                ["<"] = "lt",
                ["<="] = "le",
                [">"] = "gt",
                [">="] = "ge",
                ["and"] = "and",
                ["or"] = "or"
            })[e.op.text]
            if not op then
                refuse()
            end
            local a, b = guardExpr(e.lhs), guardExpr(e.rhs)
            if (op == "and" or op == "or") and (a.type ~= "bool" or b.type ~= "bool") then
                refuse()
            end
            return binary(op, a, b, "bool")
        end
        if e.kind == "unop" and e.op.text == "#" and e.operand.kind == "name" then
            local s = spans[e.operand.token.text];
            if not s then
                refuse()
            end;
            return s.len
        end
        if e.kind == "number" then
            local n = tonumber(e.token.text);
            if not n or n < 0 or n % 1 ~= 0 then
                refuse()
            end;
            return ik(n)
        end
        refuse()
    end

    -- Preserve authored guard errors and their order. The native IR has
    -- already proved these are the complete, inert precondition prefix.
    for _, stat in ipairs(body.body.stats or {}) do
        local guard = lowering.guardForm(stat)
        if not guard then
            break
        end
        if guard.discarded then
            refuse()
        end
        local condition = guardExpr(guard.cond)
        if condition.type ~= "bool" then
            refuse()
        end
        local call = guard.asserted and stat.expr or stat.clauses[1].body.stats[1].expr
        local message = call.args.exprs[guard.asserted and 2 or 1]
        if message and message.kind ~= "string" then
            refuse()
        end
        local text = message and (loadstring("return " .. message.token.text))() or "assertion failed!"
        constants[#constants + 1] = {kind = "str", value = text}
        if not guard.asserted then
            local zero = ik(0);
            condition = binary("eq", condition, zero, "bool")
        end
        local fail = emit("JmpIfIZero", condition.reg, 0)
        local skip = emit("Jmp", 0)
        patch(fail, #code + 1);
        emit("Raise", #constants - 1);
        patch(skip, #code + 1)
    end

    local function name(e)
        return names[e.uniqueName or e.name] or refuse()
    end

    expression = function(e)
        if e.op == "local" or e.op == "uniform" then
            return name(e)
        end
        if e.op == "constant" or e.op == "constant_i32" or e.op == "constant_i64" then
            local n = tonumber(e.value);
            if not n or e.type ~= "f64" and e.type ~= "f32" and math.abs(n) > 9007199254740991 then
                refuse()
            end
            local d = alloc(e.type);
            emit(d.class == "f" and "FK" or "IK", d.reg, n);
            return d
        end
        if e.op == "bool" then
            return ik(e.value and 1 or 0)
        end
        if e.op == "span_count" then
            return spans[e.span].len
        end
        if e.op == "int_to_f64" then
            return floating(expression(e.value))
        end
        if e.op == "narrow_f64_f32" then
            local source = floating(expression(e.value))
            local v = alloc("simd_vector_f32_fixed4")
            emit("VSplatN", v.regs[1], source.reg, 8)
            local d = alloc("f32")
            emit("VExtractN", d.reg, v.regs[1], 8, 0)
            return d
        end
        if e.op == "widen_f32_f64" then
            return expression(e.value)
        end
        if e.op == "numeric_cast" then
            if e.value.op == "constant" then
                local number = tonumber(e.value.value)
                local bits = shapes.bits(e.type)
                if number
                    and bits
                    and e.type ~= "f32"
                    and e.type ~= "f64"
                    and math.abs(number) <= 9007199254740991
                    and number % 1 == 0
                then
                    if bits < 64 then
                        number = number % (2 ^ bits)
                        if e.type:sub(1, 1) == "i" and number >= 2 ^ (bits - 1) then
                            number = number - 2 ^ bits
                        end
                    end
                    local d = alloc(e.type);
                    emit("IK", d.reg, number);
                    return d
                end
            end
            local r = expression(e.value)
            if r.class == "i" and (e.type == "u64" or e.type == "u32") then
                local d = alloc(e.type);
                emit(e.type == "u32" and "IMaskU32" or "IMov", d.reg, r.reg);
                d.signedFits = e.type == "u32" or r.type == "u32" or r.signedFits
                return d
            end
            -- Tail counts are a difference of a physical span count and its
            -- nonnegative cursor. Both are exact machine integers.
            if e.value.op == "sub" and e.value.left.op == "span_count" and e.value.right.op == "int_to_f64" then
                local a, b = spans[e.value.left.span].len, expression(e.value.right.value)
                return binary("u32_sub", a, b, "u32")
            end
            refuse()
        end
        if e.left and e.right then
            return binary(e.op, expression(e.left), expression(e.right), e.type)
        end
        if e.op == "simd_species" then
            return alloc(e.type)
        end
        if e.op == "simd_lanes_generic" then
            return ik(expression(e.args[1]).lanes)
        end
        if e.op == "simd_tail" then
            local shape = alloc(e.type);
            local active = integer(expression(e.args[1]));
            local max = ik(shape.lanes)
            local below = binary("le", active, max, "bool")
            local d = alloc("u32");
            emit("IMov", d.reg, max.reg)
            local skip = emit("JmpIfIZero", below.reg, 0);
            emit("IMov", d.reg, active.reg);
            patch(skip, #code + 1)
            shape.active = d.reg
            local per = 16 / assert(
                ({[0] = 1, [1] = 1, [2] = 2, [3] = 2, [4] = 4, [5] = 4, [6] = 8, [7] = 8, [8] = 4, [9] = 8})[shape.kind]
            )
            for i, r in ipairs(shape.regs) do
                local offset = (i - 1) * per
                emit("VPrefix", r, d.reg, shape.kind, offset, math.min(per, shape.lanes - offset))
            end
            return shape
        end
        if e.op == "simd_splat" then
            local d = alloc(e.type);
            local a = expression(e.args[1])
            if d.kind >= 8 then
                a = floating(a)
            else
                a = integer(a)
            end
            for _, r in ipairs(d.regs) do
                emit("VSplatN", r, a.reg, d.kind)
            end
            return d
        end
        if e.op == "simd_load" or e.op == "simd_store" then
            local species = expression(e.args[1]);
            local s = spans[e.span]
            if not s or e.rooted or species.kind ~= s.kind then
                refuse()
            end
            local index = e.args[2]
            -- This is the typed IR conversion chain for the one-based index.
            -- Keep the explicit u32 wrap; do not infer nonwrapping from text.
            if index.op ~= "int_to_f64" then
                refuse()
            end
            local at = integer(expression(index.value));
            local zero = alloc("u64");
            emit("IAddK", zero.reg, at.reg, -1)
            local store = e.op == "simd_store"
            local value = store and expression(e.args[3]) or alloc(e.type)
            local mask = e.args[store and 4 or 3]
            local active = mask and expression(mask) or ik(species.lanes)
            if mask and (active.class ~= "mask" or active.active == nil or active.lanes ~= species.lanes) then
                refuse()
            end
            if store and (not s.write or value.class ~= "vector") then
                refuse()
            end
            if mask then
                active = {reg = active.active}
            end
            emit("SpanBounds", s.reg, zero.reg, active.reg, s.kind, store and 1 or 0)
            local widths: {
                [integer]: integer
            } = {[0] = 1, [1] = 1, [2] = 2, [3] = 2, [4] = 4, [5] = 4, [6] = 8, [7] = 8, [8] = 4, [9] = 8}
            local per = 16 / assert(widths[s.kind])
            for i, r in ipairs(value.regs) do
                local offset = (i - 1) * per;
                local lanes = math.min(per, species.lanes - offset)
                if store then
                    emit("SpanStore", s.reg, zero.reg, r, active.reg, s.kind, offset, lanes)
                else
                    emit("SpanLoad", r, s.reg, zero.reg, active.reg, s.kind, offset, lanes)
                end
            end
            return value
        end
        if e.op == "simd_binary"
            or e.op == "simd_unary"
            or e.op == "simd_compare"
            or e.op == "simd_select"
            or e.op == "simd_math"
        then
            local supported = {
                add = true,
                sub = true,
                mul = true,
                div = true,
                neg = true,
                ["and"] = true,
                ["or"] = true,
                xor = true,
                ["not"] = true,
                eq = true,
                ne = true,
                lt = true,
                le = true,
                gt = true,
                ge = true,
                select = true,
                sqrt = true,
                abs = true,
                floor = true,
                ceil = true,
                fma = true
            }
            if not supported[e.intrinsic] then
                refuse()
            end
            local d = alloc(e.type);
            local args = {}
            for _, a in ipairs(e.args) do
                args[#args + 1] = expression(a)
            end
            for _, a in ipairs(args) do
                if (a.class ~= "vector" and a.class ~= "mask") or a.kind ~= d.kind or a.lanes ~= d.lanes then
                    refuse()
                end
            end
            if #args < 1 or #args > 3 then
                refuse()
            end
            local operation = e.intrinsic
            if args[1].class == "mask" and (operation == "eq" or operation == "ne") then
                operation = operation == "eq" and "maskEq" or "maskNe"
            end
            for i, r in ipairs(d.regs) do
                emit(
                    "VOp",
                    operation,
                    d.kind,
                    r,
                    args[1].regs[i],
                    (args[2] or args[1]).regs[i],
                    (args[3] or args[1]).regs[i]
                )
            end
            return d
        end
        if e.op == "simd_mask_any" then
            local a = expression(e.args[1]);
            if a.class ~= "mask" then
                refuse()
            end
            -- Padding in a partial native register is not a logical lane.
            local widths: {
                [integer]: integer
            } = {[0] = 1, [1] = 1, [2] = 2, [3] = 2, [4] = 4, [5] = 4, [6] = 8, [7] = 8, [8] = 4, [9] = 8}
            if a.lanes * assert(widths[a.kind]) % 16 ~= 0 then
                refuse()
            end
            local d = ik(0)
            for _, r in ipairs(a.regs) do
                local t = alloc("bool");
                emit("VAny", t.reg, r);
                emit("IOr", d.reg, d.reg, t.reg)
            end
            return d
        end
        if e.op == "simd_horizontal" and e.intrinsic == "algebraic_sum" then
            local a = expression(e.args[1]);
            if a.kind ~= 9 then
                refuse()
            end
            local d = alloc("f64");
            emit("FK", d.reg, 0)
            for lane = 0, a.lanes - 1 do
                local t = alloc("f64");
                emit("VExtractN", t.reg, a.regs[math.floor(lane / 2) + 1], 9, lane % 2);
                emit("FAdd", d.reg, d.reg, t.reg)
            end
            return d
        end
        refuse()
    end
    local block
    block = function(stats)
        for _, s in ipairs(stats) do
            if s.op == "let" then
                local value = expression(s.value)
                if value.active ~= nil and not s.assigned then
                    names[s.uniqueName or s.name] = value
                else
                    local d = alloc(s.type);
                    move(d, value);
                    names[s.uniqueName or s.name] = d
                end
            elseif s.op == "assign" then
                local values = {};
                for i, a in ipairs(s.values) do
                    values[i] = expression(a.value)
                end
                for i, a in ipairs(s.values) do
                    move(name(a.target), values[i])
                end
            elseif s.op == "while" then
                local top = #code + 1;
                block(s.conditionBody or {})
                local c = integer(expression(s.condition));
                local exit = emit("JmpIfIZero", c.reg, 0)
                block(s.body);
                local back = emit("Jmp", 0);
                patch(back, top);
                patch(exit, #code + 1)
            elseif s.op == "if" then
                local ends = {}
                for _, clause in ipairs(s.clauses) do
                    local c = integer(expression(clause.condition));
                    local next = emit("JmpIfIZero", c.reg, 0)
                    block(clause.body);
                    ends[#ends + 1] = emit("Jmp", 0);
                    patch(next, #code + 1)
                end
                block(s.elseBody or {});
                for _, at in ipairs(ends) do
                    patch(at, #code + 1)
                end
            elseif s.op == "block" then
                block(s.body)
            elseif s.op == "return" then
                if #s.values == 0 then
                    emit("RetNil")
                elseif #s.values == 1 then
                    local r = expression(s.values[1]);
                    if r.class ~= "f" then
                        refuse()
                    end
                    emit("FBox", #program.params + 1, r.reg);
                    emit("Ret", #program.params + 1)
                else
                    refuse()
                end
            elseif s.op == "simd_store" then
                expression(s)
            else
                refuse()
            end
        end
    end
    block(program.body);
    emit("RetNil")
    if ni >= 240 or nf >= 240 or nv >= 250 then
        refuse()
    end

    return {code = code, consts = constants, nregs = #program.params + 2, nfregs = math.max(ni, nf), nvregs = nv}
end

function native.plans(root: any): any
    local declarations = lowering.scan(root, true)
    local hasSimd = false
    for _, moduleName in pairs(declarations.modules) do
        hasSimd = hasSimd or moduleName == "nupp.simd"
    end
    if not hasSimd then
        return {}
    end
    local plans = {}
    local applications = {}
    for _, application in ipairs(declarations.applications) do
        applications[#applications + 1] = application
    end
    for _, declaration in pairs(declarations.helpers) do
        applications[#applications + 1] = {tail = declaration, chain = {}}
    end
    for _, application in ipairs(applications) do
        local context = new lowering.Context(checked = true, vectors = true, nativeCpu = true, reject = refuse)
        local ok, result = pcall(function()
            local program = verify.program(lowering.program(declarations, application, true, context))
            return translate(program, application.tail.body)
        end)
        if ok then
            plans[application.tail.body] = result
        elseif result ~= REFUSED then
            error(result, 0)
        end
    end

    return plans
end

export = native
