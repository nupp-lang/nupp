module nupp.compiler.vm.coregraphexecutable

local contracts = require("nupp.compiler.vm.coregraphcontracts")
local semantic = require("nupp.compiler.vm.coregraphverify")
local copies = require("nupp.compiler.vm.graphcopies")
local bytecode = require("nupp.compiler.vm.corebytecode")
local opcodes = require("nupp.compiler.vm.opcodes")
local schema = require("nupp.compiler.vm.coregraphschema")
local corelibrary = require("nupp.compiler.vm.corelibrary")
local executable = {}
local issued = setmetatable({}, {__mode = "k"})
local bounds = schema.limits()

local function need(ok: any, message: string): any
    assert(ok, "core executable: " .. message)
    return ok
end

local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local output = {}
    for key, item in pairs(value) do
        output[key] = copy(item)
    end

    return output
end

local function same(value: any, expected: any): boolean
    if type(value) ~= type(expected) then
        return false
    elseif type(value) ~= "table" then
        return value == expected
    elseif getmetatable(value) ~= nil then
        return false
    end
    for key, item in pairs(expected) do
        if not same(value[key], item) then
            return false
        end
    end
    for key in pairs(value) do
        if expected[key] == nil then
            return false
        end
    end

    return true
end

-- Operations whose operands are not values: constant pool indexes, module
-- targets and catalog owners.
-- How many leading operands of an operation are immediates, not values: all
-- of K, Require and GetUpval, and the target or library id that Closure and
-- LibCall carry before their value operands.
local immediateOperands: {[string]: integer} = {K = 1, Require = 1, GetUpval = 1, Closure = 1, LibCall = 1}

-- Closed blocks keep every non-parameter value inside one block, so a slot is
-- reused across blocks and, within a block, after the value's last use.
-- Handlers read their operands before writing the result, so a result may
-- take the slot of an operand that dies at the same instruction.
local function assignSlots(g: any): (any, integer)
    local slotOf: {[integer]: integer} = {}
    local highest: integer = 0
    for _, block in ipairs(g.blocks) do
        local last: {[integer]: integer} = {}
        local count = #block.op

        local function use(value: integer?, at: integer): nil
            if value ~= nil and value > g.nparams then
                last[value] = at
            end
        end

        for at, op in ipairs(block.op) do
            local args = block.args[at]
            for index = (immediateOperands[op] or 0) + 1, #args do
                use(args[index], at)
            end
        end
        local term = block.term
        use(term.value, count + 1)
        for _, value in ipairs(term.values or {}) do
            use(value, count + 1)
        end
        use(term.spread, count + 1)
        use(term.callee, count + 1)
        for _, value in ipairs(term.args or {}) do
            use(value, count + 1)
        end
        for _, edge in ipairs(term.edges) do
            for _, value in ipairs(edge.args) do
                use(value, count + 1)
            end
        end
        local free: {integer} = {}
        local nextSlot: integer = 0

        local function take(value: integer): nil
            local slot: integer
            if #free > 0 then
                table.sort(free, function(x: integer, y: integer): boolean
                    return x > y
                end)
                slot = table.remove(free) as integer
            else
                slot = nextSlot
                nextSlot += 1
            end
            slotOf[value] = slot
            highest = math.max(highest, slot + 1) as integer
        end

        local function release(value: integer, at: integer): nil
            if (last[value] or 0) <= at then
                free[#free + 1] = slotOf[value] as integer
            end
        end

        for _, value in ipairs(block.params) do
            if value > g.nparams then
                take(value)
            end
        end
        for _, value in ipairs(block.params) do
            if value > g.nparams then
                release(value, 0)
            end
        end
        for at, op in ipairs(block.op) do
            local seen: {[integer]: boolean} = {}
            local args = block.args[at]
            for index = (immediateOperands[op] or 0) + 1, #args do
                local value = args[index]
                if value > g.nparams and not seen[value] and last[value] == at then
                    seen[value] = true
                    free[#free + 1] = slotOf[value] as integer
                end
            end
            local dst = block.dst[at]
            if dst ~= nil and dst ~= 0 then
                take(dst)
                release(dst, at)
            end
        end
    end

    return slotOf, highest
end

local function derive(g: any, catalog: any): any
    local maximumArguments: integer = 0
    local metaCalls = false
    -- A function that destroys owners lands errors from its calls.
    local lands = false
    -- From v8, whether a `require` of a computed name may start any module.
    local anyModule = false
    for _, block in ipairs(g.blocks) do
        -- A capturing closure stages its captures in the call window too.
        for at, op in ipairs(block.op) do
            if op == "Closure" then
                need(#block.args[at] - 1 <= 63, "closure capture capacity")
                maximumArguments = math.max(maximumArguments, #block.args[at] - 1) as integer
            elseif op == "LibCall" then
                maximumArguments = math.max(maximumArguments, #block.args[at] - 1) as integer
                -- .., /, //, tostring and unary minus may call a metamethod.
                local id = corelibrary.split(block.args[at][1])
                if catalog.schema.version >= 8 and corelibrary.meta(id) then
                    maximumArguments = math.max(maximumArguments, 3) as integer
                    metaCalls = true
                end
                if catalog.schema.version >= 8 and id == corelibrary.id("MODULE_REQUIRE") then
                    anyModule = true
                elseif catalog.schema.version >= 8 then
                    -- Any other library function may call a function value
                    -- back: sort's comparator, gsub's replacement, a
                    -- metamethod print or format reaches.
                    metaCalls = true
                end
            elseif op == "Destroy" then
                maximumArguments = math.max(maximumArguments, 3) as integer
                metaCalls = true
                lands = true
            elseif op == "GetIdx"
                or op == "SetIdx"
                or catalog.schema.version >= 8
                and (
                    op == "Add"
                    or op == "Sub"
                    or op == "Mul"
                    or op == "Mod"
                    or op == "Len"
                    or op == "Lt"
                    or op == "Le"
                    or op == "Eq"
                )
            then
                -- A metamethod (__index, __newindex, __add, __len, ...) is
                -- called from the top of the call window: its callee, then up
                -- to three arguments.
                maximumArguments = math.max(maximumArguments, 3) as integer
                metaCalls = true
            end
        end
        if block.term.kind == "invoke" then
            need(#block.term.args <= 63, "fixed CallK argument capacity")
            maximumArguments = math.max(maximumArguments, #block.term.args) as integer
            -- xpcall's handler is staged past the arguments and the results,
            -- and called from the four slots at the top of the window, above
            -- them all.
            local contract = catalog.contracts[block.term.contract + 1]
            -- A dynamic call may reach a table with __call, which takes the
            -- table as an extra first argument.
            if contract and catalog.schema.version >= 8 and contract.target == catalog.schema.absent then
                maximumArguments = math.max(maximumArguments, #block.term.args + 1) as integer
            end
            if contract and contract.handled then
                local results: integer = math.max(#block.term.args, #(block.term.results or {}), 2) as integer
                if block.term.spread then
                    results = math.max(results, 64) as integer
                end
                maximumArguments = math.max(maximumArguments, results + 5) as integer
                metaCalls = true
            end
            -- Several results land after the callee slot; a spread call stages
            -- its pack there too, in 63 argument slots.
            maximumArguments = math.max(maximumArguments, #(block.term.results or {})) as integer
            if block.term.spread then
                maximumArguments = math.max(maximumArguments, 64) as integer
            end
        elseif block.term.kind == "return" then
            need(block.term.value ~= nil, "absent return is not executable")
            -- Several results are staged from the call base for RetN; RetV
            -- stages up to sixteen.
            maximumArguments = math.max(maximumArguments, #(block.term.values or {})) as integer
            if block.term.spread then
                maximumArguments = math.max(maximumArguments, 16) as integer
            end
        end
    end
    need(g.nparams <= 63, "fixed parameter capacity")
    local valueBase = (g.nparams as integer) + 2
    local slotOf, slotCount = assignSlots(g)
    local scratch = valueBase + slotCount
    local callBase = scratch + 1
    local highest = callBase + math.max(maximumArguments, 1)
    need(highest < 250, "physical slots including call/copy scratch exceed capacity")
    local instructions, positions, starts, patches, calls = {}, {}, {}, {}, {}
    -- The module chunks this function's static requires name.
    local requires: {integer} = {}
    local closureCount: integer = 0
    -- A block that can reach itself runs repeatedly. Instance creation there is
    -- unbounded until closures live on the collected heap.
    local inLoop = {}
    for _, block in ipairs(g.blocks) do
        local seen, pending = {}, {}
        for _, edge in ipairs(block.term.edges or {}) do
            pending[#pending + 1] = edge.target
        end
        while #pending > 0 and not inLoop[block.id] do
            local target = table.remove(pending)
            if target == block.id then
                inLoop[block.id] = true
            elseif not seen[target] then
                seen[target] = true
                for _, edge in ipairs(g.blocks[target].term.edges or {}) do
                    pending[#pending + 1] = edge.target
                end
            end
        end
    end

    local function physical(value: integer): integer
        need(g.types[value] == "v", "non-tagged executable value")
        return value <= g.nparams and value
            or valueBase + (need(slotOf[value], "value has no assigned slot") as integer)
    end

    local function emit(instruction: any, position: integer): integer
        if not bytecode.coreOnly()[instruction[1]] then
            opcodes.check(instruction)
        end
        instructions[#instructions + 1] = instruction
        positions[#instructions] = position
        need(#instructions <= 1048576, "instruction budget exceeded")

        return #instructions
    end

    local function jump(target: integer, position: integer): nil
        patches[#patches + 1] = {at = emit({"Jmp", 0}, position), operand = 2, target = target}
    end

    -- `results` call results come first, from the slots after the callee.
    local function edgeCopies(edge: any, position: integer, results: integer): nil
        local params = g.blocks[edge.target].params
        local destinations, sources = {}, {}
        local offset: integer = results
        for index = 1, results do
            destinations[index], sources[index] = physical(params[index]), callBase + index
        end
        for index, source in ipairs(edge.args) do
            destinations[index + offset] = physical(params[index + offset])
            sources[index + offset] = physical(source)
        end
        need(#destinations == #params, "continuation parameter count differs")
        for _, move in ipairs(copies.schedule(destinations, sources, scratch)) do
            emit({"Move", move[1], move[2]}, position)
        end
        jump(edge.target, position)
    end

    for _, block in ipairs(g.blocks) do
        starts[block.id] = #instructions + 1
        for at, op in ipairs(block.op) do
            local args, dst, position = block.args[at], block.dst[at], block.pos[at]
            local _ = switch op do
                case "K" -> do
                    emit({"K", physical(dst), args[1]}, position)
                    yield nil
                end
                case "Require" -> do
                    local constant = need(g.constants[args[1] + 1], "require name index differs")
                    need(constant.kind == "str", "require needs a static module name")
                    local target
                    for _, module in ipairs(catalog.modules) do
                        if module.name == constant.value then
                            target = module.chunk
                        end
                    end
                    -- Modules load lazily from v8, so a module may require
                    -- any other, its partner in a cycle included.
                    need(
                        target ~= nil
                        and (target < g.programOwner or catalog.schema.version >= 8 and target ~= g.programOwner),
                        "forward or cyclic require is unsupported"
                    )
                    requires[#requires + 1] = target as integer
                    emit({"Require", physical(dst), target}, position)
                    yield nil
                end
                case "Add", "Sub", "Mul", "Mod", "Lt", "Le", "Eq" -> do
                    emit({op, physical(dst), physical(args[1]), physical(args[2])}, position)
                    yield nil
                end
                case "Nil" -> do
                    emit({"Nil", physical(dst)}, position)
                    yield nil
                end
                case "Move" -> do
                    emit({"Move", physical(dst), physical(args[1])}, position)
                    yield nil
                end
                case "Closure" -> do
                    if catalog.schema.version < 7 then
                        need(#args == 1, "zero-capture executable closure required")
                        need(not inLoop[block.id], "closure created in a loop is unbounded")
                        emit({"NewClosure", physical(dst), args[1], scratch, 0}, position)
                        closureCount += 1
                    else
                        -- v7 closures live on the collected heap; their captures are
                        -- staged after callBase.
                        for index = 2, #args do
                            emit({"Move", callBase + index - 1, physical(args[index])}, position)
                        end
                        emit({"NewClosure", physical(dst), args[1], callBase, #args - 1}, position)
                    end
                    yield nil
                end
                case "NewCell", "GetCell" -> do
                    emit({op, physical(dst), physical(args[1])}, position)
                    yield nil
                end
                case "SetCell" -> do
                    emit({"SetCell", physical(args[1]), physical(args[2])}, position)
                    yield nil
                end
                case "GetUpval" -> do
                    emit({"GetUpval", physical(dst), args[1]}, position)
                    yield nil
                end
                case "NewTable" -> do
                    emit({"NewTable", physical(dst)}, position)
                    yield nil
                end
                case "GetIdx" -> do
                    emit({"GetIdx", physical(dst), physical(args[1]), physical(args[2])}, position)
                    yield nil
                end
                case "SetIdx" -> do
                    emit({"SetIdx", physical(args[1]), physical(args[2]), physical(args[3])}, position)
                    yield nil
                end
                case "Len" -> do
                    emit({"Len", physical(dst), physical(args[1])}, position)
                    yield nil
                end
                case "Destroy" -> do
                    emit({"Destroy", physical(args[1]), physical(args[2])}, position)
                    yield nil
                end
                case "MathFloor" -> do
                    emit({"MathFloor", physical(dst), physical(args[1])}, position)
                    yield nil
                end
                case "Not" -> do
                    emit({"Not", physical(dst), physical(args[1])}, position)
                    yield nil
                end
                case "LibCall" -> do
                    for index = 2, #args do
                        emit({"Move", callBase + index - 1, physical(args[index])}, position)
                    end
                    -- The id and its argument count, which carries the
                    -- method-form flag.
                    local id, method = corelibrary.split(args[1])
                    local count = #args - 1
                    if method then
                        count += corelibrary.COUNT_METHOD_FORM
                    end
                    emit({"LibCall", physical(dst), id, callBase, count}, position)
                    yield nil
                end
                else -> error("core executable: unsupported graph operation " .. op, 0)
            end
        end
        local term, position = block.term, block.term.pos or 0
        local _ = switch term.kind do
            case "return" -> do
                if term.spread then
                    for index, value in ipairs(term.values or {}) do
                        emit({"Move", callBase + index - 1, physical(value)}, position)
                    end
                    emit({"RetV", callBase, #(term.values or {}), physical(term.spread)}, position)
                elseif term.values and #term.values > 1 then
                    for index, value in ipairs(term.values) do
                        emit({"Move", callBase + index - 1, physical(value)}, position)
                    end
                    emit({"RetN", callBase, #term.values}, position)
                else
                    emit({"Ret", physical(term.value)}, position)
                end
                yield nil
            end
            case "jump" -> do
                edgeCopies(term.edges[1], position, 0)
                yield nil
            end
            case "branch" -> do
                local at = emit({"JmpIf", physical(term.value), 0}, position)
                edgeCopies(term.edges[2], position, 0)
                instructions[at][3] = #instructions - at
                edgeCopies(term.edges[1], position, 0)
                yield nil
            end
            case "invoke" -> do
                local contract = catalog.contracts[term.contract + 1]
                need(contract.owner == g.programOwner and contract.block == block.id, "callsite owner differs")
                -- All source values were evaluated by the common graph frontend.
                -- The entire staging window is disjoint from every SSA location.
                emit({"Move", callBase, physical(term.callee)}, position)
                local nargs = contract.handled and #term.args - 1 or #term.args
                for index = 1, nargs do
                    emit({"Move", callBase + index, physical(term.args[index])}, position)
                end
                local wanted: integer = term.results and #term.results or 1
                local captured: integer = contract.handled and math.max(wanted, 2) or wanted
                -- An open call takes every result as one pack: its instruction
                -- wants none, and its one slot holds the pack.
                local encoded = term.open and 0 or wanted
                -- xpcall's handler: past the arguments and the results.
                -- A callable table inserts its receiver before the arguments.
                local handlerSlot = callBase + 1 + math.max(term.spread and 64 or nargs + 1, captured)
                if contract.handled then
                    emit({"Move", handlerSlot, physical(term.args[#term.args])}, position)
                end
                local at: integer
                if contract.protected then
                    at = emit(
                        {
                            "PCall",
                            contract.target,
                            callBase,
                            callBase,
                            nargs,
                            captured,
                            term.spread and physical(term.spread) + 1 or 0
                        },
                        position
                    )
                    if contract.handled then
                        -- After a failure, the handler's answer replaces the error.
                        emit({"XPHandle", callBase + 1, handlerSlot, wanted}, position)
                    end
                elseif term.spread then
                    at = emit(
                        {"CallV", contract.target, callBase, callBase, #term.args, encoded, physical(term.spread)},
                        position
                    )
                else
                    at = emit({"CallK", contract.target, callBase, callBase, #term.args, encoded}, position)
                end
                calls[
                    #calls + 1
                ] = {
                    pc = at - 1,
                    resumePC = at,
                    contract = term.contract,
                    target = contract.target,
                    signature = contract.signature,
                    argumentBase = callBase,
                    argumentCount = nargs,
                    resultSlot = callBase + 1,
                    wanted = captured,
                    spread = term.spread ~= nil,
                    discarded = term.result == nil,
                    inLoop = inLoop[block.id] == true
                }
                edgeCopies(term.edges[1], position, term.results and #term.results or term.result ~= nil and 1 or 0)
                yield nil
            end
            else -> error("core executable: unsupported terminator", 0)
        end
    end
    for _, patch in ipairs(patches) do
        instructions[patch.at][patch.operand] = need(starts[patch.target], "missing executable block") - patch.at - 1
    end
    local encoded = {}
    for index, instruction in ipairs(instructions) do
        encoded[index] = bytecode.encode(instruction)
    end

    local blockPCs = {}
    for index, start in ipairs(starts) do
        blockPCs[index] = start - 1
    end
    -- The source line of each instruction (0 where none is known) and the
    -- chunk an error position names, as Lua's chunkid shortens a file name.
    local lines: {integer} = {}
    local chunk: string? = nil
    for index = 1, #instructions do
        local at = g.positions and g.positions[positions[index] or 0]
        lines[index] = at and at.line or 0
        if chunk == nil and at and at.source and type(at.source.path) == "string" then
            local name = at.source.path as string
            chunk = #name <= 59 and name or "..." .. name:sub(#name - 55)
        end
    end

    return {
        owner = g.programOwner,
        nparams = g.nparams,
        valueCount = highest + 1,
        copyScratch = scratch,
        callBase = callBase,
        maximumArguments = maximumArguments,
        instructionCount = #instructions,
        code = table.concat(encoded),
        instructions = instructions,
        positions = positions,
        lines = lines,
        chunk = chunk,
        blockPCs = blockPCs,
        constants = copy(g.constants),
        calls = calls,
        metaCalls = metaCalls,
        requires = requires,
        anyModule = anyModule,
        lands = lands,
        closureCount = closureCount
    }
end

-- Frames a recursive program may nest: a call past them raises Lua's "stack
-- overflow". The guest catalog admits this bound (guestcatalog.depthbound),
-- and the entry's frame pool is sized for it.
executable.depthbound = 200000

-- The deepest stack of frames `successors` admits when no function is on it
-- twice: the longest path through its strongly connected components, each
-- weighing the functions in it (the nodes up to `functions`; a later node is
-- a junction that holds no frame). A stack within a component holds each of
-- its functions once at most, so this bounds every non-recursive stack.
local function deepest(functions: integer, successors: {{integer}}): integer
    local order, low, held, component, longest = {}, {}, {}, {}, {}
    local stack: {integer} = {}
    local visited: integer, components: integer, result: integer = 0, 0, 0
    for root = 1, #successors do
        if order[root] == nil then
            visited += 1
            order[root], low[root], held[root] = visited, visited, true
            stack[#stack + 1] = root
            local work: {{integer}} = {{root, 1}}
            while #work > 0 do
                local top = work[#work]
                local node, at = top[1], top[2]
                local edges = successors[node]
                if at <= #edges then
                    top[2] = at + 1
                    local next = edges[at]
                    if order[next] == nil then
                        visited += 1
                        order[next], low[next], held[next] = visited, visited, true
                        stack[#stack + 1] = next
                        work[#work + 1] = {next, 1}
                    elseif held[next] then
                        low[node] = math.min(low[node], order[next])
                    end
                else
                    work[#work] = nil
                    if #work > 0 then
                        local parent = work[#work][1]
                        low[parent] = math.min(low[parent], low[node])
                    end
                    if low[node] == order[node] then
                        -- Every component it reaches outside itself is done.
                        components += 1
                        local members: {integer} = {}
                        repeat
                            local member = stack[#stack]
                            stack[#stack] = nil
                            held[member] = nil
                            component[member] = components
                            members[#members + 1] = member
                        until member == node
                        local weight: integer, below: integer = 0, 0
                        for _, member in ipairs(members) do
                            if member <= functions then
                                weight += 1
                            end
                            for _, next in ipairs(successors[member]) do
                                if component[next] ~= components then
                                    below = math.max(below, longest[component[next]])
                                end
                            end
                        end
                        longest[components] = weight + below
                        result = math.max(result, weight + below)
                    end
                end
            end
        end
    end

    return result
end

local function deriveCatalog(normalized: any): any
    semantic.semantic(normalized)
    local functions, total = {}, 0
    for index, g in ipairs(normalized.graphs) do
        functions[index] = derive(g, normalized)
        total += functions[index].instructionCount
        need(total <= bounds.instructions, "complete executable instruction budget exceeded")
    end
    local bounds, visiting = {}, {}
    local recursive = false

    -- v7 creates no instances (its closures are heap objects), so a cycle only
    -- deepens frames, which the entry bounds with depthbound.
    local function bound(index: integer): any
        if bounds[index] then
            return bounds[index]
        end
        if visiting[index] then
            need(normalized.schema.version >= 7, "recursive executable call graph")
            recursive = true
            return {instances = 0, depth = 1}
        end
        visiting[index] = true
        local fn = functions[index]
        local instances, depth = fn.closureCount, 1
        -- So does a metamethod an access may call.
        if fn.metaCalls then
            recursive = true
        end
        for _, call in ipairs(fn.calls) do
            -- A dynamic call's callee is unknown: bound its depth like recursion.
            if call.target == normalized.schema.absent then
                recursive = true
            else
                local child = bound((call.target as integer) + 1)
                need(not call.inLoop or child.instances == 0, "call in a loop creates unbounded instances")
                instances += child.instances
                depth = math.max(depth, child.depth + 1)
                need(instances <= 1048576, "entry instance budget exceeded")
            end
        end
        bounds[index] = {instances = instances, depth = depth}
        visiting[index] = nil

        return bounds[index]
    end

    for index = 1, #functions do
        bound(index)
    end
    local initializers, capacity, creations = {}, 1, 0
    for index, module in ipairs(normalized.modules) do
        local owner = module.chunk
        local extent = bounds[owner + 1]
        initializers[index] = owner
        capacity = math.max(capacity, extent.instances)
        creations += extent.instances
        need(creations <= 1048576, "module instance budget exceeded")
    end
    -- Frames nest through static calls and, from v8, through requires: a
    -- module's chunk runs as a call from its first requirer, and a `require`
    -- of a computed name may start any module (through the junction past the
    -- functions). A chunk runs once, so a require cycle nests no further than
    -- its members; before v8 each chunk is its own entry.
    local successors: {{integer}} = {}
    local junction = #functions + 1
    local chunks: {integer} = {}
    for _, module in ipairs(normalized.modules) do
        chunks[#chunks + 1] = (module.chunk as integer) + 1
    end
    for index, fn in ipairs(functions) do
        local edges: {integer} = {}
        for _, call in ipairs(fn.calls) do
            if call.target ~= normalized.schema.absent then
                edges[#edges + 1] = (call.target as integer) + 1
            end
        end
        if normalized.schema.version >= 8 then
            for _, target in ipairs(fn.requires) do
                edges[#edges + 1] = (target as integer) + 1
            end
            if fn.anyModule then
                edges[#edges + 1] = junction
            end
        end
        successors[index] = edges
    end
    successors[junction] = chunks
    local depth = math.max(deepest(#functions, successors), 1)
    if recursive then
        depth = math.max(depth, executable.depthbound)
    end

    return {
        version = normalized.schema.version >= 3 and normalized.schema.version or 1,
        profile = normalized.schema.version >= 3 and normalized.schema.profile or "boolean-nil-acyclic-one-result",
        entry = normalized.entry,
        initializers = initializers,
        semantic = normalized,
        functions = functions,
        instructionCount = total,
        instanceCapacity = capacity,
        instanceCreations = creations,
        frameDepth = depth
    }
end

-- The retained checker objects are immutable borrows within this build process.
-- This issuer is not a native loader or production frame/effect authority.
function executable.fromChecked(compiled: any, version: integer?): any
    local normalized, diagnostics = contracts.normalize(compiled, version)
    need(
        #normalized.modules <= 3 or normalized.schema.version >= 8,
        "at most three module initializers are executable before v8"
    )
    need(normalized.modules[#normalized.modules].chunk == normalized.entry, "entry module must initialize last")
    local result = deriveCatalog(normalized)
    local required = false
    for _, diagnostic in ipairs(diagnostics) do
        required = required or diagnostic.tail == true
    end
    for _, g in ipairs(normalized.graphs) do
        for _, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                if op == "LibCall" and corelibrary.split(block.args[at][1]) == corelibrary.id("ARGUMENT_ERROR") then
                    required = true
                end
            end
        end
    end
    if required then
        need(normalized.schema.version == 8, "argument diagnostics require checked source profile 8")
        result.diagnostics = diagnostics
    end
    issued[result] = {compiled = compiled, version = version, snapshot = copy(result)}

    return result
end

function executable.validate(result: any): nil
    local state = need(type(result) == "table" and rawget(issued, result), "unissued executable catalog")
    need(same(result, state.snapshot), "issued executable metadata changed")
    local normalized, diagnostics = contracts.normalize(state.compiled, state.version)
    need(same(normalized, state.snapshot.semantic), "checked catalog changed")
    if state.snapshot.diagnostics then
        need(same(diagnostics, state.snapshot.diagnostics), "checked call diagnostics changed")
    end
end

function executable.checkedOwner(result: any, id: integer): any
    executable.validate(result)
    local state = issued[result]
    local owner = need(state.compiled.catalog.owners[id + 1], "unknown checked owner")
    need(owner.id == id, "checked owner identity differs")

    return owner
end

export = executable
