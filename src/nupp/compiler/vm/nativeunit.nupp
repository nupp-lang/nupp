module nupp.compiler.vm.nativeunit

const assert2 = require("assert")

local physical = require("nupp.compiler.vm.nativephysical")
local cst = require("nupp.compiler.syntax.cst")
local construction = require("nupp.compiler.vm.construction")
local owners: any = setmetatable({}, {__mode = "k"})
local options: any = setmetatable({}, {__mode = "k"})

local function need(ok: any, message: string): any
    assert2(ok, "native unit: " .. message)
    return ok
end

local function read(path: string): string?
    local file = io.open(path, "rb")
    if not file then
        return nil
    end
    local source = file:read("*a")
    file:close()

    return source
end

-- Membership only: the common function walker remains the sole lowering.
-- Canonical CST children exclude checker/type backreferences and their cycles.
local function collect(body: any): any
    local found, ordinal = {}, 0
    local visit: function(any, any, integer?): nil
    visit = function(node, parent, index)
        if cst.isToken(node) then
            return
        end
        need(found[node] == nil, "checked syntax occurrence is shared")
        ordinal = ordinal + 1
        found[
            node
        ] = {
            parent = parent,
            index = index,
            kind = node.kind,
            ordinal = ordinal,
            inferredType = node.inferredType,
            ownershipIntrinsic = node.ownershipIntrinsic,
            structConstruct = node.structConstruct,
            constructorCall = node.constructorCall,
            constructorEntry = node.constructorEntry
        }
        if node ~= body and node.kind == "funcbody" then
            return
        end
        for at, child in ipairs(node) do
            visit(child, node, at)
        end
    end
    visit(body, nil, nil)

    return found
end

export function functionsFrom(parsed: any, scope: any): any
    scope.functions, scope.exports = {}, {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local node = stat.kind == "exportStmt" and stat.stat or stat
            if node and (node.kind == "localFuncStmt" or node.kind == "funcStmt") then
                local body = node.body
                local name = node.kind == "localFuncStmt" and node.name.text or node.name.base.text
                local kinds, annotations, types, definitions, modeTokens = {}, {}, {}, {}, {}
                for index, parameter in ipairs(body.params) do
                    kinds[index] = parameter.type.resolvedType.tag
                    annotations[index] = parameter.type.resolvedType
                    definitions[index] = parameter.name.definition
                    types[index] = parameter.name.definition.type
                    modeTokens[index] = parameter.modeTok
                end
                local result = body.signatureType.rets[1] and body.signatureType.rets[1].tag
                local fn = {
                    name = name,
                    node = node,
                    body = body,
                    scope = scope,
                    paramKinds = kinds,
                    checkedSignature = body.signatureType,
                    parameterAnnotations = annotations,
                    parameterTypes = types,
                    parameterDefinitions = definitions,
                    parameterModeTokens = modeTokens,
                    parameterModes = body.signatureType.paramModes,
                    parameterPack = body.signatureType.paramPack,
                    resultType = body.signatureType.rets[1],
                    resultKind = result or "nil"
                }
                scope.functions[name] = fn
                if stat.kind == "exportStmt" then
                    scope.exports[name] = fn
                end
            end
        end
    end

    return scope.functions
end

export function constantsFrom(tree: any): any
    local constants = {}
    for _, block in ipairs(tree.root.blocks) do
        for _, stat in ipairs(block.stats) do
            if stat.kind == "exportStmt" and stat.stat and stat.stat.kind == "localStmt" then
                local declared = stat.stat
                if declared.isConst and #declared.names == 1 and declared.exprs[1].kind == "number" then
                    constants[declared.names[1].text] = declared.exprs[1].token.text:gsub("[Uu]?[Ll][Ll]$", "")
                end
            end
        end
    end

    return constants
end

export function constants(parsed: any, scope: any): nil

    scope.constants = {}
    for _, block in ipairs(parsed.root.blocks) do
        for _, stat in ipairs(block.stats) do
            local declared = stat.kind == "exportStmt" and stat.stat or stat
            if declared
                and declared.kind == "localStmt"
                and declared.isConst
                and #declared.names == 1
                and declared.exprs[1].kind == "number"
            then
                local token = declared.names[1]
                scope.constants[token.definition or token] = declared.exprs[1]
            end
        end
    end
    scope.exportedConstants = constantsFrom(parsed)
end

local function token(fn: any): any
    return fn.node.kind == "localFuncStmt" and fn.node.name or fn.node.name.base
end

local function mapSame(actual: any, held: any): boolean
    if type(actual) ~= "table" or getmetatable(actual) ~= nil then
        return false
    end
    for key, value in pairs(held) do
        if actual[key] ~= value then
            return false
        end
    end
    for key, value in pairs(actual) do
        if held[key] ~= value then
            return false
        end
    end

    return true
end

local function copyMap(source: any): any
    local result = {}
    for key, value in pairs(source or {}) do
        result[key] = value
    end

    return result
end

-- Checked CST/type records have their original compiler record metatables.
-- Compare raw fields without invoking iteration/index hooks; exposed issuer
-- maps still use the stricter plain-map check above.
local function copyRecord(source: any): any
    local fields = {}
    for key, value in next, source do
        fields[key] = value
    end

    return {metatable = getmetatable(source), fields = fields}
end

local function recordSame(actual: any, held: any): boolean
    if type(actual) ~= "table" or getmetatable(actual) ~= held.metatable then
        return false
    end
    for key, value in next, held.fields do
        if rawget(actual, key) ~= value then
            return false
        end
    end
    for key, value in next, actual do
        if rawget(held.fields, key) ~= value then
            return false
        end
    end

    return true
end

local function validateCleanup(saved: any): nil
    occurrence(saved.owner, saved.annotation)
    need(
        saved.annotation.resolvedType == saved.type
        and saved.annotation.arguments == saved.arguments
        and mapSame(saved.arguments, saved.argumentsMap)
        and saved.arguments[2] == saved.terminal
        and recordSame(saved.terminal, saved.terminalMap)
        and saved.token.definition == saved.definition
        and mapSame(saved.token, saved.tokenMap)
        and not saved.definition.reassigned,
        "cleanup annotation declaration changed"
    )
    need(
        saved.type.cleanups == saved.chain
        and mapSame(saved.chain, saved.chainMap)
        and recordSame(saved.cleanup, saved.cleanupMap),
        "checked cleanup record changed"
    )
    need(
        token(saved.target).definition == saved.definition
        and saved.target.checkedSignature == saved.signature
        and saved.target.body == saved.targetBody
        and saved.target.body.signatureType == saved.signature
        and token(saved.target).cleanupRegistrations == saved.registrations
        and mapSame(saved.registrations, saved.registrationsMap)
        and mapSame(saved.registration, saved.registrationMap)
        and recordSame(saved.registered, saved.registeredMap),
        "cleanup registration changed"
    )
end

local function validate(state: any, source: boolean): nil
    need(not state.invalid, "sealed unit was invalidated")
    -- A test build is tested, not proven (runtime plan, "Direction"): it skips
    -- re-reading every source and re-walking every owner on each graph.
    if state.tested then
        return
    end
    if source then
        for path, text in pairs(state.sources) do
            if (read(path) or false) ~= text then
                state.invalid = true
                error("native unit: sealed source changed: " .. path, 0)
            end
        end
    end
    physical.validateContext(state.context)
    need(mapSame(state.modules, state.moduleMap), "module map changed")
    for _, saved in ipairs(state.scopes) do
        local scope = saved.scope
        need(
            getmetatable(scope) == nil and scope.name == saved.name and scope.path == saved.path,
            "module identity changed"
        )
        need(mapSame(scope.functions, saved.functions) and mapSame(scope.exports, saved.exports), "owner map changed")
        need(
            scope.checkedExports == saved.checkedExports and getmetatable(scope.checkedExports) == nil,
            "checked export record changed"
        )
        need(
            mapSame(scope.constants, saved.constants) and mapSame(scope.exportedConstants, saved.exportedConstants),
            "constant map changed"
        )
        for node, literal in pairs(saved.literals) do
            need(
                node.kind == "number"
                and node.token == literal.token
                and node.token.text == literal.text
                and node.inferredType == literal.type,
                "checked constant changed"
            )
        end
        need(mapSame(scope.checkedExports.valueDefs, saved.valueDefs), "export definitions changed")
        need(mapSame(scope.checkedExports.typeDefs, saved.typeDefs), "type definitions changed")
        need(mapSame(scope.checkedExports.types, saved.types), "export types changed")
        need(mapSame(scope.checkedExports.values, saved.values), "export values changed")
    end
    for _, saved in ipairs(state.cleanupBindings) do
        validateCleanup(saved)
    end
    for fn, held in pairs(state.owners) do
        need(
            getmetatable(fn) == nil and fn.node == held.node and fn.body == held.body and fn.scope == held.scope,
            "owner identity changed"
        )
        need(fn.definition == held.definition and token(fn).definition == held.definition, "owner definition changed")
        need(
            fn.node.body == held.body
            and fn.checkedSignature == held.signature
            and fn.body.signatureType == held.signature,
            "owner signature changed"
        )
        need(not held.definition.reassigned, "function declaration was reassigned")
    end
end

-- The incremental project stays private. Its import/update/overlay APIs never
-- escape this constructor; every file must exist before checking starts.
export function session(projectRoot: string, requested: any, target: string, include: any?, tested: boolean?): any
    -- Lazy imports avoid native profile -> unit -> checker -> profile loading.
    local incremental = require("nupp.compiler.project.incremental")
    local trivia = require("nupp.compiler.syntax.triviaarena")
    trivia.installDefault(require("nupp.compiler.syntax.triviaarena.table"))
    require("nupp.compiler.project.projectconfig")
    require("nupp.compiler.hash")
    need(type(requested) == "table" and #requested > 0, "nonempty module batch required")
    local roots = {}
    for index, path in ipairs(include or {"src", "native/core/src"}) do
        roots[index] = path
    end
    local project = incremental.new(projectRoot, {
        cache = false,
        nativeCompilerServices = false,
        config = {include = roots}
    })
    local state: any = {
        projectRoot = projectRoot,
        errorDefinition = project.env.globals.error.definition,
        context = physical.new(target),
        sources = {},
        checked = {},
        modules = {},
        scopes = {},
        owners = {},
        definitions = {},
        bindings = {},
        cleanupBindings = {},
        invalid = false,
        tested = tested == true
    }

    local function remember(path: string, text: any): nil
        need(state.sources[path] == nil or state.sources[path] == text, "source changed during check: " .. path)
        state.sources[path] = text
    end

    local function snapshot(path: string): nil
        local text = need(read(path), "source is not staged: " .. path)
        need(project.fileText(path) == text, "checked source revision differs: " .. path)
        remember(path, text)
    end

    local function load(path: string): any
        if state.checked[path] then
            return state.checked[path]
        end
        snapshot(path)
        local result = project.checkFile(path)
        for _, diagnostic in ipairs(result.diags or {}) do
            need(diagnostic.severity ~= "error", tostring(diagnostic.code) .. ": " .. tostring(diagnostic.msg))
        end
        need(
            result.result and result.exports and not result.syntax and not result.missing,
            "checked module required: " .. path
        )
        need(project.fileText(path) == state.sources[path], "checked source revision differs")
        state.checked[path] = result
        for _, name in ipairs(project.moduleDependencies(path)) do
            local dependency = project.modulePath(name)
            if dependency then
                load(dependency)
            end
        end
        for _, dependency in ipairs(project.projectDependencies(path)) do
            for _, dependencyPath in ipairs(project.projectDependencyPaths(dependency.name, dependency.key)) do
                snapshot(dependencyPath)
            end
        end
        for _, input in ipairs(project.externalInputs(path)) do
            -- Missing include candidates are also stable inputs: changing their
            -- existence must invalidate the unit rather than silently resolve.
            local bytes = read(input.path) or false
            need(
                (project.externalFile(input.path) or false) == bytes,
                "checked external revision differs: " .. input.path
            )
            remember(input.path, bytes)
        end

        return result
    end

    local requestedNames = {}
    for _, request in ipairs(requested) do
        need(
            type(request.path) == "string" and type(request.moduleName) == "string",
            "explicit module path/name required"
        )
        need(not requestedNames[request.moduleName], "duplicate requested module")
        requestedNames[request.moduleName] = request.path
        need(project.modulePath(request.moduleName) == request.path, "requested module resolution differs")
        load(request.path)
    end
    -- Freeze declaration-index sources too: these can supply nominal types even
    -- when a module's expression graph never invokes them.
    for _, path in ipairs(project.projectFiles()) do
        snapshot(path)
    end
    local config = projectRoot .. "/nupp.lua"
    remember(config, read(config) or false)
    for name, path in pairs(requestedNames) do
        local checked = state.checked[path]
        local parsed = checked.result
        need(parsed.declaredModuleName == name, "checked module name differs")
        local scope = {name = name, path = path, checkedExports = checked.exports}
        local functions = functionsFrom(parsed, scope)
        constants(parsed, scope)
        state.modules[name] = scope
        for _, fn in pairs(functions) do
            local definition = need(token(fn).definition, "checked function definition required")
            fn.definition = definition
            local held = {
                state = state,
                node = fn.node,
                body = fn.body,
                scope = scope,
                definition = definition,
                signature = fn.checkedSignature,
                occurrences = collect(fn.body)
            }
            state.owners[fn], owners[fn], state.definitions[definition] = held, held, fn
        end
    end
    -- Cleanup records are not interned: the declaration registration and the
    -- affine annotation carry distinct records. Bind their checked declaration
    -- token before comparing the registered ID and signature, then seal both.
    for owner, held in pairs(state.owners) do
        for annotation in pairs(held.occurrences) do
            local t = annotation.resolvedType
            local arguments = annotation.arguments
            if t and t.tag == "affine" and arguments and #arguments == 2 then
                local terminal = arguments[2]
                local named = nil
                for _, child in ipairs(terminal) do
                    if cst.isToken(child) and child.kind == "name" then
                        named = child
                    end
                end
                local target = named and state.definitions[named.definition] or nil
                if target then
                    local registrations = token(target).cleanupRegistrations or {}
                    for _, cleanup in ipairs(t.cleanups) do
                        for _, registration in ipairs(registrations) do
                            local registered = registration.cleanup
                            if cleanup.kind == "function"
                                and registered.kind == "function"
                                and cleanup.id == registered.id
                                and cleanup.functionType == target.checkedSignature
                                and registered.functionType == target.checkedSignature
                                and not registration.after
                            then
                                state.cleanupBindings[
                                    #state.cleanupBindings + 1
                                ] = {
                                    owner = owner,
                                    annotation = annotation,
                                    type = t,
                                    arguments = arguments,
                                    argumentsMap = copyMap(arguments),
                                    terminal = terminal,
                                    terminalMap = copyRecord(terminal),
                                    token = named,
                                    tokenMap = copyMap(named),
                                    definition = named.definition,
                                    target = target,
                                    targetBody = target.body,
                                    signature = target.checkedSignature,
                                    chain = t.cleanups,
                                    chainMap = copyMap(t.cleanups),
                                    cleanup = cleanup,
                                    cleanupMap = copyRecord(cleanup),
                                    registrations = registrations,
                                    registrationsMap = copyMap(registrations),
                                    registration = registration,
                                    registrationMap = copyMap(registration),
                                    registered = registered,
                                    registeredMap = copyRecord(registered)
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    -- Owners borrow checked CST/type objects immutably. This API seals the
    -- issued records and scalar constant inputs; it is not a validator for
    -- arbitrary in-place corruption of the entire checked syntax/type graph.
    -- Export keys and implementation definitions are separate. This first
    -- bridge accepts direct function definitions only; synthetic table exports
    -- and arbitrary value aliases are refused instead of guessed from names.
    for _, scope in pairs(state.modules) do
        scope.exports = {}
        for name, definition in pairs(scope.checkedExports.valueDefs or {}) do
            local fn = state.definitions[definition]
            if fn then
                scope.exports[name] = fn
                state.bindings[definition] = {definition = definition, owner = fn, scope = scope, name = name}
            end
        end
        local literals = {}
        for _, node in pairs(scope.constants) do
            literals[node] = {token = node.token, text = node.token.text, type = node.inferredType}
        end
        state.scopes[
            #state.scopes + 1
        ] = {
            scope = scope,
            name = scope.name,
            path = scope.path,
            functions = copyMap(scope.functions),
            exports = copyMap(scope.exports),
            checkedExports = scope.checkedExports,
            constants = copyMap(scope.constants),
            exportedConstants = copyMap(scope.exportedConstants),
            literals = literals,
            valueDefs = copyMap(scope.checkedExports.valueDefs),
            typeDefs = copyMap(scope.checkedExports.typeDefs),
            types = copyMap(scope.checkedExports.types),
            values = copyMap(scope.checkedExports.values)
        }
    end
    state.moduleMap = copyMap(state.modules)
    local api = {}
    function api.validate(): boolean
        validate(state, true)
        return true
    end

    function api.module(name: string): any
        validate(state, false)
        return need(state.modules[name], "module is outside sealed batch")
    end

    function api.options(fn: any, abi: string): any
        validate(state, true)
        need(state.owners[fn], "owner is outside sealed batch")
        need(abi == "leaf" or abi == "handler" or abi == "support", "explicit native ABI required")
        local result = {modules = state.modules, abi = abi, nativeUnit = api}
        if abi == "leaf" then
            result.physicalTarget = target
        end
        options[
            result
        ] = {state = state, fn = fn, abi = abi, unit = api, target = result.physicalTarget, fields = copyMap(result)}

        return result
    end

    state.api = api
    validate(state, true)

    return api
end

-- Called once at graph construction, not for every operation. Copied options
-- and public lookalikes do not acquire the private unit's target context.
export function begin(fn: any, supplied: any): any
    local held = owners[fn]
    if not held then
        need(supplied.nativeUnit == nil, "unknown unit owner/options")
        return nil
    end
    local issued = need(options[supplied], "issued unit options required")
    need(issued.state == held.state and issued.fn == fn, "options owner differs")
    need(mapSame(supplied, issued.fields) and supplied.modules == held.state.modules, "unit options changed")
    validate(held.state, true)

    return issued.target and held.state.context or nil
end

export function finish(fn: any): nil
    local held = owners[fn]
    if held then
        validate(held.state, true)
    end
end

export function contains(fn: any): boolean
    return owners[fn] ~= nil
end

export function occurrence(fn: any, node: any): boolean
    local held = need(owners[fn], "unknown occurrence owner")
    need(
        not held.state.invalid
        and fn.body == held.body
        and fn.node == held.node
        and fn.node.body == held.body
        and fn.scope == held.scope
        and fn.definition == held.definition,
        "occurrence owner changed"
    )
    need(type(node) == "table", "checked occurrence required")
    if held.state.tested then
        need(held.occurrences[node], "occurrence is outside checked owner")
        return true
    end
    local current = node
    while current do
        local saved = need(held.occurrences[current], "occurrence is outside checked owner")
        need(current.kind == saved.kind, "checked occurrence kind changed")
        if saved.parent == nil then
            need(current == held.body, "checked occurrence root changed")
        else
            need(saved.parent[saved.index] == current, "checked occurrence parent changed")
        end
        current = saved.parent
    end

    return true
end

-- Return the original checked type only while its occurrence is unchanged.
export function checkedOccurrenceType(fn: any, node: any): any
    occurrence(fn, node)
    local checked = owners[fn].occurrences[node].inferredType
    need(node.inferredType == checked, "checked occurrence type changed")
    return checked
end

-- Detached enumeration of the same private membership index, not a source
-- authority object. Consumers still authenticate each selected occurrence.
export function occurrences(fn: any): any
    local held = need(owners[fn], "unknown occurrence owner")
    local result = {}
    for node, saved in pairs(held.occurrences) do
        occurrence(fn, node)
        result[saved.ordinal] = node
    end

    return result
end

-- This classifies an already checked occurrence for service reachability only.
-- Representation and borrowed-root validation remain in physical.borrowView.
export function borrowFrom(fn: any, call: any): boolean
    occurrence(fn, call)
    local saved = owners[fn].occurrences[call]
    need(call.ownershipIntrinsic == saved.ownershipIntrinsic, "checked ownership intrinsic changed")
    if saved.ownershipIntrinsic ~= "borrowFrom" then
        return false
    end
    need(
        call.kind == "call"
        and call.inferredType == saved.inferredType
        and #call.args.exprs == 2
        and call.args.exprs[2].kind == "name",
        "checked borrowFrom occurrence changed"
    )
    occurrence(fn, call.obj)
    occurrence(fn, call.args.exprs[1])
    occurrence(fn, call.args.exprs[2])

    return true
end

-- A plain struct constructor `S(...)` is lowered through its construction
-- wrapper, not an ordinary call edge. Physical localRecipe
-- retains layout/storage admission.
export function localConstructionChild(fn: any, call: any): boolean
    occurrence(fn, call)
    local held = owners[fn]
    local saved = held.occurrences[call]
    need(
        call.structConstruct == saved.structConstruct
        and call.constructorCall == saved.constructorCall
        and call.constructorEntry == saved.constructorEntry,
        "checked construction call changed"
    )
    if not construction.bare(call) then
        return false
    end
    local parent, checked = construction.of(call), saved.inferredType
    need(
        parent.kind == "newExpr"
        and parent.call == call
        and parent.inferredType == checked
        and call.inferredType == saved.inferredType
        and checked
        and checked == saved.inferredType
        and checked.tag == "nominal"
        and checked.declKind == "struct"
        and saved.structConstruct
        and not saved.constructorCall
        and not saved.constructorEntry
        and (not checked.constructors or #checked.constructors == 0),
        "plain checked construction child required"
    )
    occurrence(fn, call.obj)

    return true
end

export function callee(fn: any, call: any): any
    local held = need(owners[fn], "unknown caller owner")
    local state = held.state
    -- begin() validated the sealed transaction. Resolution stays identity-only
    -- and does not reread every source or rescan every owner per instruction.
    need(
        not state.invalid and fn.scope == held.scope and fn.body == held.body and fn.definition == held.definition,
        "caller owner changed"
    )
    if call.kind ~= "call" then
        return nil
    end
    if call.obj.kind == "name" then
        local definition = call.obj.token.definition
        need(definition and not definition.reassigned, "unstable local callee")
        -- Unknown globals remain the profile's responsibility (including any
        -- supported intrinsic); no body is guessed from their textual name.
        return state.definitions[definition]
    end
    if call.obj.kind == "dotIndex" and call.obj.obj.kind == "name" then
        local receiver = call.obj.obj.token.definition
        need(receiver and not receiver.reassigned and receiver.requiredModule, "unstable imported module")
        local scope = state.modules[receiver.requiredModule]
        -- Non-unit modules still go through the native profile's existing
        -- checked intrinsic contracts. They never acquire a body binding here.
        if not scope then
            return nil
        end
        local definition = call.obj.name.definition
        need(
            definition and scope.checkedExports.valueDefs[call.obj.name.text] == definition,
            "imported member definition differs"
        )
        local binding = need(state.bindings[definition], "export has no exact function-body binding")
        need(
            binding.scope == scope and binding.definition == definition and not definition.reassigned,
            "export binding differs"
        )
        return binding.owner
    end
    error("native unit: unsupported callee expression", 0)
end

export function call(fn: any, call: any, target: any): nil
    if owners[fn] or owners[target] then
        need(
            owners[fn] and owners[target] and owners[fn].state == owners[target].state,
            "callee belongs to another unit"
        )
        need(callee(fn, call) == target, "checked callee definition differs")
    end
end

-- Closed declaration-only OS module. Function bodies remain under the ordinary
-- unit resolver; this API cannot bind an arbitrary foreign module or symbol.
-- Closed service construction uses these owner-bound lookups, never a copied
-- module/options table supplied by the caller.
export function ownerModule(fn: any, name: string): any
    local held = need(owners[fn], "unknown service owner")
    validate(held.state, false)
    return need(held.state.modules[name], "service module is outside sealed unit")
end

export function ownerContext(fn: any): any
    local held = need(owners[fn], "unknown service context owner")
    validate(held.state, false)
    return held.state.context
end

export function ownerOptions(fn: any, abi: string): any
    local held = need(owners[fn], "unknown service owner")
    return held.state.api.options(fn, abi)
end

export function sameOwners(left: any, right: any): boolean
    local a, b = owners[left], owners[right]
    return a ~= nil and b ~= nil and a.state == b.state
end

-- The literal text remains source evidence, not an allocated guest string.
-- Shadowed names never acquire raising semantics from their text.
export function cleanupTypes(fn: any, site: any): any
    occurrence(fn, site)
    local result, seen = {}, {}

    local function add(t: any): nil
        if t and t.tag == "affine" and not seen[t] then
            seen[t] = true
            result[#result + 1] = t
        end
    end

    add(site.inferredType)
    local localOwners = site.kind == "localStmt" and site.automaticOwners
    for index, owner in pairs(localOwners or {}) do
        need(
            site.kind == "localStmt"
            and owner.stat == site
            and owner.index == index
            and owner.expr == site.exprs[index]
            and owner.token == site.names[index]
            and owner.entry.automaticOwner == owner,
            "automatic cleanup owner differs"
        )
        need(owner.type == owner.entry.t and owner.cleanups == owner.type.cleanups, "automatic cleanup type differs")
        add(owner.type)
    end
    for _, parameter in ipairs(fn.body.params) do
        if site == parameter then
            add(parameter.type.resolvedType)
        end
    end
    for index, annotation in ipairs(fn.body.rets or {}) do
        if site == annotation then
            local result, resolved = fn.checkedSignature.rets[index], annotation.resolvedType
            -- Primitive result syntax need not retain resolvedType. Only an
            -- affine result participates in the cleanup declaration bridge.
            if result and result.tag == "affine" or resolved and resolved.tag == "affine" then
                need(resolved == result, "checked cleanup result annotation changed")
                add(resolved)
            end
        end
    end

    return result
end

export function cleanupTarget(fn: any, site: any, t: any, cleanup: any): any
    local held = need(owners[fn], "unknown cleanup owner")
    local present = false
    for _, candidate in ipairs(cleanupTypes(fn, site)) do
        if candidate == t then
            present = true
        end
    end
    need(present and t.tag == "affine", "cleanup type is not from checked site")
    present = false
    for _, candidate in ipairs(t.cleanups) do
        if candidate == cleanup then
            present = true
        end
    end
    need(present and cleanup.kind == "function" and cleanup.functionType, "closed free-function cleanup required")
    local result = nil
    for _, saved in ipairs(held.state.cleanupBindings) do
        if saved.cleanup == cleanup then
            validateCleanup(saved)
            need(result == nil or result == saved.target, "ambiguous checked cleanup")
            result = saved.target
        end
    end

    return need(result, "cleanup declaration is outside sealed unit")
end

export function literalRaise(fn: any, callsite: any): any
    local held = need(owners[fn], "unknown raise owner")
    occurrence(fn, callsite)
    if callsite.kind ~= "call"
        or callsite.obj.kind ~= "name"
        or callsite.obj.token.definition ~= held.state.errorDefinition
    then
        return nil
    end
    need(not callsite.obj.token.definition.reassigned and #callsite.args.exprs == 1, "closed literal raise required")
    local argument = callsite.args.exprs[1]
    occurrence(fn, argument)
    local token = argument.token
    local location = fn.scope.name .. "." .. fn.name .. " at " .. fn.scope.path .. ":" .. tostring(
        token and token.line or 0
    )
    need(
        argument.kind == "string" and token and token.kind == "string",
        "service error requires a checked literal string: " .. location
    )
    local source = held.state.sources[fn.scope.path]
    need(
        source
        and argument[1] == token
        and type(token.text) == "string"
        and type(token.offset) == "number"
        and token.offset >= 1
        and token.offset % 1 == 0
        and source:sub(token.offset, token.offset + #token.text - 1) == token.text,
        "service error literal token changed: " .. location
    )
    local lexer = require("nupp.compiler.syntax.lexer")
    local literal = lexer.stringValue(token.text)
    local checked = held.occurrences[argument].inferredType
    local types = require("nupp.compiler.types")
    need(
        literal ~= nil
        and checked
        and checked == argument.inferredType
        and checked.tag == "literal"
        and checked.base == types.string
        and checked.constant == literal,
        "service error requires a checked literal string: " .. location
    )

    return {definition = held.state.errorDefinition, literal = literal, node = callsite}
end

local function externalDeclaration(fn: any, callsite: any, moduleName: string, file: string, label: string): any
    local held = need(owners[fn], label .. " caller is outside sealed unit")
    occurrence(fn, callsite)
    need(
        callsite.kind == "call" and callsite.obj.kind == "dotIndex" and callsite.obj.obj.kind == "name",
        label .. " call requires a checked imported member"
    )
    local receiver = callsite.obj.obj.token.definition
    local definition = callsite.obj.name.definition
    local path = held.state.projectRoot .. "/src/nupp/runtime/vm/" .. file
    need(
        receiver and not receiver.reassigned and receiver.requiredModule == moduleName,
        label .. " receiver identity differs"
    )
    need(
        definition and definition.filename == path and held.state.sources[path] ~= nil,
        label .. " declaration is not the frozen source"
    )
    occurrence(fn, callsite.obj)
    occurrence(fn, callsite.obj.obj)
    local actual = held.occurrences[callsite.obj].inferredType
    need(actual == callsite.obj.inferredType, label .. " checked signature occurrence changed")
    local record = receiver.type
    while record and (record.tag == "const" or record.tag == "literal") do
        record = record.tag == "literal" and record.base or record.inner
    end
    need(record and record.tag == "typeobject", label .. " checked declaration table required")
    record = record.of
    while record and (record.tag == "const" or record.tag == "literal") do
        record = record.tag == "literal" and record.base or record.inner
    end
    need(record and record.tag == "nominal", label .. " checked record required")
    local name = callsite.obj.name.text
    -- Match the checker's declaration-table member lookup, including Self
    -- specialization, while retaining the checked occurrence's exact identity.
    local member = record.staticByname and record.staticByname[name]
    local memberDefinition = record.staticFieldDefs and record.staticFieldDefs[name]
    if not member then
        member = record.byname and record.byname[name]
        memberDefinition = record.fieldDefs and record.fieldDefs[name]
    end
    need(member and memberDefinition == definition, label .. " checked member identity differs")
    local generics = require("nupp.compiler.types.generics")
    local resolved = generics.specializeSelf(record, member, record)
    local types = require("nupp.compiler.types")
    -- Imported dot members retain resolvedType before the checker applies its
    -- interned sendable callable view. Both identities must still agree.
    need(
        callsite.obj.resolvedType == resolved and types.withSendable(resolved) == actual,
        label .. " checked member signature differs"
    )

    return {
        definition = definition,
        receiver = receiver,
        signature = callsite.obj.inferredType,
        context = held.state.context,
        path = path,
        owner = fn,
        name = name,
        call = callsite
    }
end

export function osDeclaration(fn: any, callsite: any): any
    validate(need(owners[fn], "OS caller is outside sealed unit").state, true)
    return externalDeclaration(fn, callsite, "nupp.runtime.vm.os", "os.d.nupp", "OS")
end

export function intrinsicDeclaration(fn: any, callsite: any): any
    validate(need(owners[fn], "intrinsic caller is outside sealed unit").state, true)
    return externalDeclaration(fn, callsite, "nupp.runtime.vm.intrinsics", "intrinsics.d.nupp", "intrinsic")
end

-- One synchronous read-only query checks the original unit once, then every
-- original imported occurrence. There is no cached permission or skip flag.
export function externalDeclarations(entry: any, sites: any): any
    local held = need(owners[entry], "external batch entry is outside sealed unit")
    need(type(sites) == "table" and getmetatable(sites) == nil, "plain external site batch required")
    validate(held.state, true)
    local result = {}
    for _, site in ipairs(sites) do
        need(type(site) == "table" and getmetatable(site) == nil, "plain external site required")
        local caller = need(owners[site.owner], "external batch caller is outside sealed unit")
        need(caller.state == held.state, "external batch caller belongs to another unit")
        need(result[site.call] == nil, "external batch occurrence repeated")
        if site.kind == "os" then
            result[site.call] = externalDeclaration(site.owner, site.call, "nupp.runtime.vm.os", "os.d.nupp", "OS")
        elseif site.kind == "intrinsic" then
            result[
                site.call
            ] = externalDeclaration(
                site.owner,
                site.call,
                "nupp.runtime.vm.intrinsics",
                "intrinsics.d.nupp",
                "intrinsic"
            )
        else
            error("native unit: unsupported external batch kind", 0)
        end
    end

    return result
end

-- The call occurrence and exported value belong to the same sealed checking
-- transaction. An imported callable may be a distinct public signature object.
export function callSignature(fn: any, callsite: any, target: any): (any, any)
    occurrence(fn, callsite)
    occurrence(fn, callsite.obj)
    call(fn, callsite, target)
    local state = owners[fn].state
    local actual = owners[fn].occurrences[callsite.obj].inferredType
    need(actual == callsite.obj.inferredType, "checked call signature occurrence changed")
    local exported = target.checkedSignature
    if callsite.obj.kind == "dotIndex" then
        local scope = target.scope
        local name = callsite.obj.name.text
        need(scope.exports[name] == target, "checked export target changed")
        exported = scope.checkedExports.values[name]
        local saved
        for _, snapshot in ipairs(state.scopes) do
            if snapshot.scope == scope then
                saved = snapshot.values[name]
            end
        end
        need(exported ~= nil and exported == saved, "checked export signature changed")
    end

    return actual, exported
end
