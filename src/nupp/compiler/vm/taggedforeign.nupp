module nupp.compiler.vm.taggedforeign

-- A guest program's call of a `cdef function` in the tagged profile: one
-- library call (FOREIGN_CALL) with the function's descriptor and a pack of
-- its arguments, which the core answers by calling it through the generic
-- foreign call (src/nupp/runtime/core/guestforeign.nupp).
--
-- The descriptor is the result's kind and each argument's, one letter each,
-- those past a variadic function's declared ones after VARIADIC; then a NUL,
-- the library ("" for the program's own symbols), a NUL and the symbol. A
-- struct passed or answered by value is its full recursive member type
-- description (taggedstructs) in place of a letter.
const taggedvalues = require("nupp.compiler.vm.taggedvalues")
const taggedstructs = require("nupp.compiler.vm.taggedstructs")
const nativeos = require("nupp.compiler.vm.nativeos")
const libraries = require("nupp.compiler.project.libraries")
const layouts = require("nupp.compiler.targetlayout")
const data = require("nupp.compiler.vm.derivedmembers")
const calls = require("nupp.compiler.vm.graphcalls")
const corelibrary = require("nupp.compiler.vm.corelibrary")
const FACTORY = "nupp.runtime.provider.coreforeignvalue"
const need = taggedvalues.need

-- The letter of each C kind, as the core reads it.
const CODES: {[string]: string} = {
    voidptr = "p",
    ptr = "p",
    string = "s",
    -- A `const char *`: a string passed, and answered as the string it
    -- points at, nil for NULL, as the core keeps no C pointer values.
    cstring = "s",
    boolean = "b",
    int32 = "i",
    uint32 = "u",
    int64 = "l",
    integer = "l",
    uint64 = "L",
    float32 = "f",
    float64 = "d",
    number = "d"
}
const VOID = "v"
const VARIADIC = "."
-- The library a `cdef function` without `from` names.
const DEFAULT_LIBRARY = "<default>"

-- The platform loader takes filenames. A bare logical name such as `z`
-- uses the host's shared-library naming convention.
local function libraryFile(library: string): string
    if library == DEFAULT_LIBRARY or library == "" then
        return ""
    end
    if library:sub(1, 1) == "@" or library:find("[./\\\\]") then
        return library
    end
    local target = layouts.hostKey()
    if target == nil or not target:find("windows", 1, true) then
        library = library:gsub("^lib", "")
    end

    return libraries.filename(library, target)
end

-- The letter of a foreign argument's or result's kind: a literal or a
-- constant is its base type's, and a pointer that may be NULL (`T*?`) the
-- pointer's, as nil passes and answers NULL.
local function code(given: any): string
    local aggregate = taggedstructs.aggregate(given)
    if aggregate then
        return aggregate
    end
    local t = nativeos.passed(given)
    if t and t.tag == "union" and t.hasNil and #(t.members or {}) == 2 then
        t = nativeos.passed(t.members[1].tag == "nil" and t.members[2] or t.members[1])
    end

    return need(
        t and CODES[t.tag],
        "a foreign call kind is not a C scalar, pointer or string: " .. tostring(t and t.tag)
    )
end

-- The descriptor of the foreign call `node`, whose callee has the checked
-- foreign signature `signature`.
local function signatureOf(signature: any): {string}
    need(
        signature.tag == "func"
        and #signature.rets <= 1
        and not signature.borrowsResult
        and (signature.ffiOut == nil or #signature.ffiOut == 0),
        "a guest foreign call requires a plain C signature"
    )
    local codes = {signature.rets[1] and code(signature.rets[1]) or VOID}
    for _, parameter in ipairs(signature.params) do
        codes[#codes + 1] = code(parameter)
    end

    return codes
end

export function descriptor(node: any, signature: any): string
    if node.nativeLibraryProblem then
        error("NUPP2912: " .. node.nativeLibraryProblem, 0)
    end
    local kind, library, symbol = (
        need(node.cdefIdentity, "a foreign call names its cdef") as string
    ):match("^(.-)\0(.-)\0(.*)$")
    need(kind == "function" and symbol and symbol:match("^[%a_][%w_]*$"), "foreign symbol identity")
    local codes = signatureOf(signature)
    local exprs = node.args.exprs or {}
    local variadic = signature.paramPack and signature.paramPack.tail ~= nil
    need(#exprs == #signature.params or variadic and #exprs > #signature.params, "foreign argument count")
    if variadic then
        codes[#codes + 1] = VARIADIC
        for index = #signature.params + 1, #exprs do
            need(exprs[index].kind ~= "vararg", "a foreign call cannot spread `...`")
            need(taggedstructs.origin(exprs[index].inferredType) == nil, "a struct is not a variadic argument")
            codes[#codes + 1] = code(exprs[index].inferredType)
        end
    end

    return table.concat(codes) .. "\0" .. libraryFile(library as string) .. "\0" .. symbol
end

local function runtimeSpec(signature: any, library: string?, symbol: string, counted: any): any
    local codes = signatureOf(signature)
    need(not signature.paramPack.tail, "a variadic C declaration has no fixed callable signature")
    local plan: any = {
        descriptor = table.concat(codes) .. "\0" .. libraryFile(library or "") .. "\0" .. symbol,
        physical = #signature.params,
        arguments = 0,
        pointers = {},
        plain = {},
    }
    for index in ipairs(signature.params) do
        local pointer = counted and counted.pointerAt[index]
        if pointer then
            plan.arguments += 1
            local countCode = codes[(pointer.countIndex as integer) + 1]
            local limit = countCode == "i" and 2147483647 or countCode == "u" and 4294967295 or nil
            plan.pointers[
                #plan.pointers + 1
            ] = {index = index, argument = plan.arguments, count = pointer.countIndex, limit = limit,}
        elseif not (counted and counted.mappedCounts[index]) then
            plan.arguments += 1
            plan.plain[#plan.plain + 1] = {index = index, argument = plan.arguments}
        end
    end

    return plan
end

local function factory(ctx: any, node: any, member: string, spec: any): integer
    local payload = ctx.hold(data.plainData(ctx, node, spec))
    local name = data.plainData(ctx, node, FACTORY)
    local module = ctx.emit(node, "LibCall", {corelibrary.id("MODULE_REQUIRE"), name}, "tagged")
    local key = data.plainData(ctx, node, member)
    local callee = ctx.emit(node, "GetIdx", {module, key}, "tagged")
    local site = need(taggedvalues.catalog(ctx).foreignFactories[node], "foreign factory call is missing")
    local call = site.node
    local answer = ctx.invoke(node, callee, {ctx.readHeld(payload)}, calls.dynamicInvokeContract(call, 1), true)
    ctx.release(payload)

    return taggedvalues.landed(ctx, node, answer)
end

export function declare(ctx: any, stat: any): integer
    need(not stat.nativeLibraryProblem, tostring(stat.nativeLibraryProblem))
    local value = ctx.hold(
        factory(
            ctx,
            stat,
            "bind",
            runtimeSpec(stat.physicalSignatureType, stat.resolvedLibrary, stat.name.text, stat.countedAbi)
        )
    )
    for _, registration in ipairs(stat.name.cleanupRegistrations or {}) do
        local key = data.plainData(ctx, stat, registration.cleanup.key)
        ctx.emit(stat, "LibCall", {corelibrary.id("CLEANUP_SET"), key, ctx.readHeld(value)}, "tagged")
    end
    local made = ctx.readHeld(value)
    ctx.release(value)

    return made
end

export function header(ctx: any, node: any): integer
    local functions: {[string]: any} = {}
    for name, subject in pairs(node.cheaderExports) do
        if subject.tag == "func" then
            local ok, spec = pcall(runtimeSpec, subject, node.cheaderLib, name, nil)
            functions[name] = ok and spec or {problem = tostring(spec)}
        end
    end

    return factory(ctx, node, "namespace", {constants = node.cheaderConstants or {}, functions = functions})
end
