module nupp.compiler.vm.nativephysical

local fixed = require("nupp.compiler.types.fixedwidth")
local targetLayout = require("nupp.compiler.targetlayout")
local construction = require("nupp.compiler.vm.construction")
local qualifiers = {affine = true, borrowed = true, pinned = true}
local contexts: any = setmetatable({}, {__mode = "k"})
local origins: any = setmetatable({}, {__mode = "k"})
local accesses: any = setmetatable({}, {__mode = "k"})
local casts: any = setmetatable({}, {__mode = "k"})
local constructions: any = setmetatable({}, {__mode = "k"})
local localOrigins: any = setmetatable({}, {__mode = "k"})
local signatures: any = setmetatable({}, {__mode = "k"})
local views: any = setmetatable({}, {__mode = "k"})
local stores: any = setmetatable({}, {__mode = "k"})
local graphOwners: any = setmetatable({}, {__mode = "k"})

local function need(ok: any, message: string): any
    assert(ok, "native physical: " .. message)
    return ok
end

local function recordFields(value: any): any
    local saved = {}
    for key, item in pairs(value) do
        saved[key] = item
    end

    return saved
end

local function sameRecord(value: any, saved: any): nil
    need(getmetatable(value) == nil, "issued physical record metatable changed")
    for key, item in pairs(saved) do
        need(value[key] == item, "issued physical record field changed: " .. tostring(key))
    end
    for key in pairs(value) do
        need(saved[key] ~= nil, "issued physical record field added: " .. tostring(key))
    end
end

export function new(target: string): any
    need(targetLayout.has(target), "explicit supported target required")
    local context = {target = target, abi = targetLayout.ABI}
    contexts[context] = {target = target}
    return context
end

export function validateContext(context: any): boolean
    local held = need(contexts[context], "unknown target context")
    need(context.target == held.target and context.abi == targetLayout.ABI, "target context changed")
    return true
end

local function derive(context: any, checked: any): any
    validateContext(context)
    need(checked and type(checked.id) == "string" and checked.id ~= "", "resolved checked type required")
    local raw, ownership = checked, {}
    while qualifiers[raw.tag] or raw.tag == "literal" or raw.tag == "const" do
        if qualifiers[raw.tag] then
            ownership[#ownership + 1] = raw
        end
        raw = raw.tag == "literal" and raw.base or raw.inner
    end
    local nullable = false
    local representation = raw
    local layoutType = raw
    if raw.tag == "union" then
        need(raw.hasNil and #raw.members == 2, "only one optional pointer type is supported")
        representation = raw.members[1].tag == "nil" and raw.members[2] or raw.members[1]
        if representation.tag == "borrowed" then
            need(#ownership == 0, "optional pointer has nested ownership")
            ownership[1] = representation
            representation = representation.inner
            layoutType = representation
        end
        need(representation.tag == "ptr" or representation.tag == "voidptr", "optional value is not a pointer")
        nullable = true
    end
    local pointer = representation.tag == "ptr" or representation.tag == "voidptr"
    need(
        (representation.tag == "nominal" and representation.declKind == "struct")
        or pointer
        or fixed.isPhysical(representation)
        or representation.tag == "boolean"
        or representation.tag == "nil",
        "unsupported physical value type"
    )
    local loaded = fixed.loaded(raw)
    local layout = nil
    if representation.tag ~= "nil" then
        local why
        -- Optional qualifiers change capability, not the pointer's storage.
        -- Keep raw/checked identity; only layout uses the proven pointer arm.
        layout, why = targetLayout.of(layoutType, context.target)
        need(layout, why or "type has no target layout")
    end
    local pointee = representation.tag == "ptr" and representation.elem or nil
    local declaration = pointee and pointee.tag == "nominal" and (pointee.origin or pointee) or nil
    local descriptor = {
        context = context,
        checkedType = checked,
        storageType = raw,
        valueType = loaded,
        ownership = ownership,
        nullable = nullable,
        pointee = pointee,
        declaration = declaration,
        machineKind = (pointer or representation.tag == "nominal") and "voidptr" or loaded.tag,
        layout = layout,
        storageBytes = layout and layout.size or 0,
        signed = representation.tag:sub(1, 3) == "int",
        arithmetic = false
    }

    return descriptor
end

local function sameLayout(actual: any, expected: any): boolean
    if actual == nil or expected == nil then
        return actual == expected
    end
    for _, key in ipairs({"target", "abi", "size", "alignment", "fingerprint"}) do
        if actual[key] ~= expected[key] then
            return false
        end
    end
    if type(actual.fields) ~= "table" or type(actual.offsets) ~= "table" or #actual.fields ~= #expected.fields then
        return false
    end
    for index, field in ipairs(expected.fields) do
        local found = actual.fields[index]
        if type(found) ~= "table" then
            return false
        end
        for _, key in ipairs({"name", "offset", "size", "alignment", "bitOffset", "bitWidth"}) do
            if found[key] ~= field[key] then
                return false
            end
        end
    end
    for name, offset in pairs(expected.offsets) do
        if actual.offsets[name] ~= offset then
            return false
        end
    end
    for name, offset in pairs(actual.offsets) do
        if expected.offsets[name] ~= offset then
            return false
        end
    end

    return true
end

export function validate(descriptor: any): boolean
    local held = need(origins[descriptor], "unknown physical descriptor")
    local expected = derive(held.context, held.checkedType)
    for _, key in ipairs({
        "context",
        "checkedType",
        "storageType",
        "valueType",
        "nullable",
        "pointee",
        "declaration",
        "machineKind",
        "storageBytes",
        "signed",
        "arithmetic"
    }) do
        need(descriptor[key] == expected[key], "descriptor " .. key .. " changed")
    end
    need(type(descriptor.ownership) == "table" and #descriptor.ownership == #expected.ownership, "ownership changed")
    for index, qualifier in ipairs(expected.ownership) do
        need(descriptor.ownership[index] == qualifier, "ownership identity changed")
    end
    need(sameLayout(descriptor.layout, expected.layout), "descriptor layout changed")

    return true
end

export function describe(context: any, checked: any): any
    local descriptor = derive(context, checked)
    origins[descriptor] = {context = context, checkedType = checked}
    return descriptor
end

export function same(left: any, right: any): boolean
    validate(left)
    validate(right)
    if localOrigins[left] ~= localOrigins[right]
        or left.context ~= right.context
        or left.checkedType ~= right.checkedType
        or left.pointee ~= right.pointee
        or left.declaration ~= right.declaration
        or left.nullable ~= right.nullable
        or #left.ownership ~= #right.ownership
    then
        return false
    end
    for index, qualifier in ipairs(left.ownership) do
        if qualifier ~= right.ownership[index] then
            return false
        end
    end

    return true
end

export function pointerType(checked: any): boolean
    local value, qualified = checked, false
    while value and (qualifiers[value.tag] or value.tag == "const" or value.tag == "literal") do
        qualified = qualified or qualifiers[value.tag] == true
        value = value.tag == "literal" and value.base or value.inner
    end
    if value and value.tag == "union" then
        for _, member in ipairs(value.members) do
            if pointerType(member) or member.tag == "voidptr" then
                return true
            end
        end
    end

    return value ~= nil and (value.tag == "ptr" or qualified and value.tag == "voidptr")
end

-- Fixed private lazy edge: nativeservice already imports nativeunit, which
-- imports this module. The graph/closed producer retains the service module.
local function serviceModule(): any
    local moduleName = "nativeservice"
    return require("nupp.compiler.vm." .. moduleName)
end

local function ownedboundary(capability: any, owner: any, parameter: integer?): any
    return serviceModule().builderownership(capability, owner, parameter)
        or serviceModule().arenaOwnership(capability, owner, parameter)
end

local function signatureShape(owner: any, context: any, serviceSignature: any?): any
    local body, checked = owner.body, owner.checkedSignature
    need(owner.node.body == body and body.signatureType == checked, "checked signature owner differs")
    need(owner.scope.functions[owner.name] == owner, "checked signature declaration differs")
    local token = owner.node.kind == "localFuncStmt" and owner.node.name or owner.node.name.base
    need(
        token
        and token.definition
        and token.definition.token == token
        and not token.definition.reassigned
        and (owner.definition == nil or owner.definition == token.definition),
        "checked pointer definition differs"
    )
    need(
        checked
        and checked.tag == "func"
        and not checked.foreign
        and not checked.vararg
        and not checked.yieldPack
        and not checked.resumePack
        and not body.generics
        and not body.captureTakes
        and checked.paramPack
        and not checked.paramPack.tail
        and not checked.paramPack.alternatives
        and checked.retPack
        and not checked.retPack.tail
        and not checked.retPack.alternatives
        and #checked.rets <= 1
        and #checked.retPack.head == #checked.rets
        and #checked.params == #body.params
        and #checked.paramPack.head == #body.params
        and owner.parameterPack == checked.paramPack
        and owner.parameterModes == checked.paramModes
        and owner.resultType == checked.rets[1],
        "closed retained pointer signature required"
    )
    local dependent = checked.borrowsParam
    need(
        not checked.borrowsSelf
        and (
            dependent == nil and checked.borrowsResult == nil
            or type(dependent) == "number"
            and dependent % 1 == 0
            and dependent >= 1
            and dependent <= #body.params
            and checked.borrowsResult == 1
            and checked.paramModes[dependent] == "borrows"
        ),
        "single borrowed-result source required"
    )
    for _, key in ipairs({
        "borrowsParams",
        "preservesResults",
        "partitionResults",
        "preservesPaths",
        "typeParams",
        "packParams",
        "constParams"
    }) do
        need(
            checked[key] == nil or next(checked[key]) == nil,
            "pointer result lifetime or generic contract is unsupported"
        )
    end
    local params, borrowing = {}, false
    for index, parameter in ipairs(body.params) do
        local annotation, definition = parameter.type.resolvedType, parameter.name.definition
        need(
            owner.parameterAnnotations[index] == annotation
            and owner.parameterDefinitions[index] == definition
            and owner.parameterTypes[index] == definition.type
            and owner.parameterModeTokens[index] == parameter.modeTok
            and checked.params[index] == annotation
            and checked.paramPack.head[index] == annotation,
            "retained pointer parameter differs"
        )
        if pointerType(annotation) or annotation.tag == "voidptr" and checked.paramModes[index] == "borrows" then
            local declared = describe(context, annotation)
            need(#declared.ownership == 0, "plain pointer annotation required")
            local mode = checked.paramModes[index]
            need(checked.paramPack.modes[index] == mode, "pointer parameter pack mode differs")
            if mode == "borrows" then
                local unit = require("nupp.compiler.vm.nativeunit")
                need(unit.contains(owner), "borrowed pointer requires sealed checked unit")
                need(
                    definition.type.tag == "borrowed"
                    and definition.type.inner == annotation
                    and (parameter.modeTok == nil or parameter.modeTok.text == "borrows"),
                    "checked borrowed parameter binding differs"
                )
                params[index], borrowing = describe(context, definition.type), true
            elseif mode == "takes" then
                need(serviceSignature ~= nil, "takes pointer requires a private service signature")
                local owned = ownedboundary(serviceSignature, owner, index)
                need(owned == definition.type, "service takes binding changed")
                params[index] = describe(context, owned)
            else
                need(
                    mode == "plain" and parameter.modeTok == nil and definition.type == annotation,
                    "plain nonnullable pointer parameter required"
                )
                params[index] = declared
            end
        else
            need(
                checked.paramModes[index] == "plain"
                and checked.paramPack.modes[index] == "plain"
                and parameter.modeTok == nil
                and definition.type == annotation,
                "nonpointer parameters require plain checked transport"
            )
            params[index] = false
        end
    end
    local result = nil
    local managed = serviceSignature and serviceModule().managedResult(serviceSignature, owner) or nil
    need(
        not borrowing or not pointerType(owner.resultType) or dependent ~= nil or managed ~= nil,
        "borrowed pointer result requires dependent source"
    )
    if pointerType(owner.resultType) then
        result = describe(context, owner.resultType)
        local owning = false
        if owner.resultType.tag == "affine" then
            need(serviceSignature ~= nil, "affine pointer requires a private service signature")
            owning = ownedboundary(serviceSignature, owner) == owner.resultType
        end
        need(
            (
                dependent == nil and #result.ownership == 0
                or dependent == nil and owning and #result.ownership == 1 and result.ownership[1] == owner.resultType
                or dependent ~= nil and #result.ownership == 1 and result.ownership[1].tag == "borrowed"
            )
            and checked.retPack.head[1] == owner.resultType
            and checked.retPack.modes[1] == "plain",
            "checked pointer result capability differs"
        )
    end
    if dependent then
        need(result and params[dependent] and params[dependent] ~= false, "borrowed result is not a pointer")
    end

    return {
        owner = owner,
        context = context,
        checkedSignature = checked,
        params = params,
        result = result,
        borrowing = borrowing,
        dependent = dependent,
        managed = managed
    }
end

-- A result's dependency is instantiated at its checked call, never inferred
-- from pointer bits. Binding counters are not consulted after scope teardown.
local function rootSnapshot(node: any): any
    local facts = node.resultCapabilityFacts and node.resultCapabilityFacts[1] or node.capabilityFacts
    local roots = need(facts and facts.roots, "checked borrowed expression roots required")
    need(#roots > 0, "checked borrowed expression roots are empty")
    local saved, keys = {}, {}
    for index, root in ipairs(roots) do
        need(root.definition and root.definition.token, "borrow root declaration required")
        saved[index], keys[index] = root, root.definition
    end
    for index in pairs(roots) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #saved,
            "borrow root array is not dense"
        )
    end

    return {node = node, facts = facts, roots = roots, saved = saved, keys = keys}
end

local function validateRoots(dependency: any): nil
    if dependency.node then
        local node = dependency.node
        local facts = node.resultCapabilityFacts and node.resultCapabilityFacts[1] or node.capabilityFacts
        need(facts == dependency.facts and facts.roots == dependency.roots, "borrow root facts changed")
        sameRecord(facts.roots, dependency.saved)
        for index, root in ipairs(dependency.saved) do
            need(root.definition == dependency.keys[index], "borrow root declaration changed")
        end
    end
end

local function sameDependency(left: any, right: any): boolean
    if left == nil or right == nil then
        return left == right
    end
    validateRoots(left);
    validateRoots(right)
    if #left.keys ~= #right.keys then
        return false
    end
    for index, key in ipairs(left.keys) do
        if key ~= right.keys[index] then
            return false
        end
    end

    return true
end

-- Pending Heap calls may use an original borrowed formal whose name has no
-- expression root facts. This is not a fallback for local borrowed values.
local function heapCallRoots(owner: any, node: any): (any, any)
    local facts = node.resultCapabilityFacts and node.resultCapabilityFacts[1] or node.capabilityFacts
    if facts and facts.roots ~= nil then
        return rootSnapshot(node), nil
    end
    for _, absent in pairs({facts = facts, capability = node.capabilityFacts}) do
        need(
            type(absent) == "table" and getmetatable(absent) == nil and next(absent) == nil,
            "Heap formal requires absent expression facts"
        )
    end
    local unit = require("nupp.compiler.vm.nativeunit")
    local checkedType = unit.checkedOccurrenceType(owner, node)
    need(node.kind == "name" and node.token and node.token.definition, "Heap root requires an original formal name")
    local definition = node.token.definition
    local index
    for at, candidate in ipairs(owner.parameterDefinitions) do
        if candidate == definition then
            need(index == nil, "Heap formal definition is repeated")
            index = at
        end
    end
    need(index ~= nil, "Heap name without expression roots is not a formal")
    local parameter = owner.body.params[index]
    local checked = owner.checkedSignature
    local annotation = owner.parameterAnnotations[index]
    need(
        checked == owner.body.signatureType
        and parameter.name.definition == definition
        and parameter.type.resolvedType == annotation
        and owner.parameterTypes[index] == definition.type
        and owner.parameterModes[index] == "borrows"
        and owner.parameterModeTokens[index] == parameter.modeTok
        and (parameter.modeTok == nil or parameter.modeTok.text == "borrows")
        and checked.params[index] == annotation
        and checked.paramPack.head[index] == annotation
        and checked.paramModes[index] == "borrows"
        and checked.paramPack.modes[index] == "borrows"
        and checkedType == definition.type
        and checkedType.tag == "borrowed"
        and checkedType.inner == annotation,
        "Heap formal checked borrow contract differs"
    )

    return {
        keys = {definition}
    }, {
        owner = owner,
        node = node,
        token = node.token,
        definition = definition,
        index = index,
        parameter = parameter,
        parameterName = parameter.name,
        parameterType = parameter.type,
        modeToken = parameter.modeTok,
        checked = checked,
        annotation = annotation,
        checkedType = checkedType,
        facts = facts,
        capabilityFacts = node.capabilityFacts,
        resultCapabilityFacts = node.resultCapabilityFacts
    }
end

local function withDependency(descriptor: any, dependency: any): any
    local copied = describe(descriptor.context, descriptor.checkedType)
    origins[copied].dependency = dependency
    return copied
end

export function dependent(descriptor: any): boolean
    validate(descriptor)
    local dependency = origins[descriptor].dependency
    if dependency then
        validateRoots(dependency)
    end

    return dependency ~= nil
end

-- A scalar/raw ABI has no pointer signature, but its local capabilities still
-- belong to one original checked function. This private graph binding survives
-- pruning; a copied graph or public owner label does not acquire it.
export function bindGraphOwner(g: any, owner: any): nil
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, owner.body)
    need(graphOwners[g] == nil and g.source == nil and #g.blocks == 0, "physical graph owner already bound")
    local sidecar = need(g.nativePhysical, "physical graph sidecar required")
    validateContext(sidecar.context)
    need(sidecar.context == unit.ownerContext(owner), "physical graph owner target context differs")
    graphOwners[
        g
    ] = {
        owner = owner,
        body = owner.body,
        sidecar = sidecar,
        context = sidecar.context,
        signature = sidecar.signature,
        native = g.native,
        nativeFields = recordFields(g.native),
        parameters = recordFields(g.native.params),
        nparams = g.nparams,
        path = owner.scope.path,
        module = owner.scope.name,
        name = owner.name
    }
end

export function graphOwner(g: any): any
    local held = graphOwners[g]
    if not held then
        return nil
    end
    need(
        g.nativePhysical == held.sidecar
        and held.sidecar.context == held.context
        and held.sidecar.signature == held.signature
        and g.native == held.native,
        "physical graph owner sidecar changed"
    )
    validateContext(held.context)
    sameRecord(g.native, held.nativeFields)
    sameRecord(g.native.params, held.parameters)
    need(g.nparams == held.nparams, "physical graph owner parameter count changed")
    require("nupp.compiler.vm.nativeunit").occurrence(held.owner, held.body)
    need(
        g.source
        and g.source.path == held.path
        and g.source.module == held.module
        and g.source.name == held.name
        and held.owner.scope.path == held.path
        and held.owner.scope.name == held.module
        and held.owner.name == held.name
        and held.owner.scope.functions[held.name] == held.owner,
        "physical graph owner source changed"
    )
    if held.signature then
        validateSignature(held.signature)
        need(held.signature.owner == held.owner, "physical graph owner signature differs")
    end

    return held.owner
end

export function qualifiedGraphValue(g: any, descriptor: any): boolean
    local owner = need(graphOwner(g), "qualified graph value requires original checked owner")
    validate(descriptor)
    if descriptor.checkedType.tag == "affine" then
        return affineValue(owner, descriptor)
    end
    local origin = origins[descriptor]
    local dependency = origin.dependency
    need(dependent(descriptor), "qualified graph local lacks checked dependency")
    local unit = require("nupp.compiler.vm.nativeunit")
    if dependency.node then
        unit.occurrence(owner, dependency.node)
        return true
    end
    if origin.ownerBorrow then
        validateCast(origin.ownerBorrow)
        local view = views[origin.ownerBorrow]
        need(view.owner == owner, "qualified graph owner projection differs")
        unit.occurrence(owner, view.node)
        return true
    end
    local signature = need(g.nativePhysical.signature, "qualified graph formal requires checked signature")
    for index, parameter in ipairs(signature.params) do
        if parameter
            and borrowingParameter(signature, index)
            and #dependency.keys == 1
            and dependency.keys[1] == owner.parameterDefinitions[index]
            and sameDependency(dependency, origins[parameter].dependency)
        then
            -- Authenticate the backing owner here. The operation's issued view
            -- separately proves any pointee, optionality or representation change.
            return true
        end
    end
    error("native physical: qualified graph dependency owner differs", 0)
end

export function sameValue(left: any, right: any): boolean
    return same(left, right)
        and sameDependency(origins[left].dependency, origins[right].dependency)
        and origins[left].field == origins[right].field
        and origins[left].ownerSource == origins[right].ownerSource
        and origins[left].ownerBorrow == origins[right].ownerBorrow
        and origins[left].managed == origins[right].managed
end

-- Only SSA transport may combine different raw field origins. Ordinary value
-- equality remains strict, and roots/local storage must agree on every edge.
local function compatibleTransport(left: any, right: any): boolean
    return same(left, right)
        and sameDependency(origins[left].dependency, origins[right].dependency)
        and origins[left].ownerSource == origins[right].ownerSource
        and origins[left].ownerBorrow == origins[right].ownerBorrow
        and origins[left].managed == origins[right].managed
end

local function carryOrigin(source: any, target: any): nil
    origins[target].dependency = origins[source].dependency
    origins[target].field = origins[source].field
    origins[target].transport = origins[source].transport
    origins[target].ownerBorrow = origins[source].ownerBorrow
    origins[target].ownerSource = origins[source].ownerSource
    origins[target].managed = origins[source].managed
    localOrigins[target] = localOrigins[source]
end

export function copyValue(g: any, source: any): any
    validate(source)
    if source.storageType.tag == "nominal" then
        return source
    end
    local target = describe(source.context, source.checkedType)
    carryOrigin(source, target)
    -- No one incoming field access can authorize all paths through this phi.
    origins[target].field = nil
    origins[target].phi = true
    origins[target].transport = {graph = setmetatable({g}, {__mode = "v"}), incoming = {}}

    return target
end

-- Called after ordinary SSA/edge verification. Rebuild the private origin
-- union from actual incoming edges, so pruning/remapping needs no ID cache.
export function verifyTransport(g: any): nil
    need(g.native ~= nil, "physical transport requires native graph")
    local values, destinations, incoming = g.nativePhysical.values, {}, {}
    local descriptorValues, incomingValues = {}, {}
    for _, block in ipairs(g.blocks) do
        for _, value in ipairs(block.params) do
            local descriptor = values[value]
            local transport = descriptor and origins[descriptor].transport
            if transport and origins[descriptor].phi then
                need(transport.graph[1] == g and not destinations[transport], "physical phi destination differs")
                destinations[transport], incoming[transport] = value, {}
            end
        end
    end
    for value, descriptor in pairs(values) do
        descriptorValues[descriptor] = descriptorValues[descriptor] == nil and value or false
        local transport = origins[descriptor].transport
        if transport and origins[descriptor].phi then
            need(destinations[transport] == value, "physical phi must define one block parameter")
        end
    end
    for _, block in ipairs(g.blocks) do
        local offset = block.term.kind == "invoke" and block.term.result ~= nil and 1 or 0
        for _, edge in ipairs(block.term.edges) do
            local params = g.blocks[edge.target].params
            for index, value in ipairs(edge.args) do
                local source, target = values[value], values[params[index + offset]]
                local transport = target and origins[target].transport
                if transport and origins[target].phi then
                    need(
                        source and compatibleTransport(source, target),
                        "physical phi type, roots or local origin differ"
                    )
                    local inputs = incoming[transport]
                    inputs[#inputs + 1] = source
                    local targetValue = params[index + offset]
                    local valueInputs = incomingValues[targetValue] or {}
                    valueInputs[#valueInputs + 1] = value
                    incomingValues[targetValue] = valueInputs
                else
                    need(
                        source == nil and target == nil or source and target and sameValue(source, target),
                        "graph edge physical type mismatch"
                    )
                end
            end
        end
    end
    -- The list is private and conveys no extra field/call permission. Its
    -- entries may themselves be phis, retaining loop provenance without an
    -- expanding path walk or selecting one predecessor as the origin.
    for transport, inputs in pairs(incoming) do
        need(#inputs > 0, "physical phi lacks an incoming value")
        transport.incoming = setmetatable(inputs, {__mode = "v"})
    end
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            local args = block.args[at]
            local access = op == "NativeStore" and args[4].field
            local captured = access and accesses[access].transport
            if captured then
                need(captured.graph[1] == g, "captured field graph differs")
                local root = need(descriptorValues[captured.source.receiver], "captured field receiver is not unique")
                local queue, seen, found = {args[1]}, {}, false
                local cursor: integer = 1
                while cursor <= #queue do
                    local value = queue[cursor]
                    cursor = cursor + 1
                    if value == root then
                        found = true
                    elseif not seen[value] then
                        seen[value] = true
                        local inputs = need(incomingValues[value], "captured field receiver transport differs")
                        for _, input in ipairs(inputs) do
                            queue[#queue + 1] = input
                        end
                    end
                end
                need(found, "captured field receiver lacks original SSA input")
            end
        end
    end
end

local function bindingExpression(owner: any, node: any, key: any, checked: any?): any
    require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
    need(key.token and key.token.definition == key, "checked binding definition required")
    local found
    if node.kind == "localStmt" then
        for index, token in ipairs(node.names) do
            if token.definition == key then
                local expression = need(node.exprs[index], "physical binding requires an explicit RHS")
                if checked == nil or expression.inferredType == checked then
                    found = expression
                end
            end
        end
    elseif node.kind == "assignStmt" then
        for index, target in ipairs(node.targets) do
            if target.kind == "name" and target.token.definition == key then
                local expression = need(node.exprs[index], "physical assignment requires an explicit RHS")
                if checked == nil or expression.inferredType == checked then
                    found = expression
                end
            end
        end
    end

    return need(found, "physical binding occurrence differs")
end

local function widening(source: any, target: any): boolean
    validate(source)
    validate(target)
    if source.context ~= target.context
        or source.machineKind ~= "voidptr"
        or target.machineKind ~= "voidptr"
        or source.nullable
        or not target.nullable
        or source.pointee ~= target.pointee
        or source.declaration ~= target.declaration
        or source.storageBytes ~= target.storageBytes
        or source.layout.alignment ~= target.layout.alignment
        or #source.ownership ~= #target.ownership
    then
        return false
    end
    for index, qualifier in ipairs(source.ownership) do
        if qualifier ~= target.ownership[index] then
            return false
        end
    end

    return true
end

export function binding(owner: any, source: any, node: any, key: any): any
    local expression = bindingExpression(owner, node, key, source.checkedType)
    need(expression.inferredType == source.checkedType, "binding checked RHS differs")
    local target = describe(source.context, key.type)
    need(widening(source, target), "only checked nonnull-to-optional binding widening is supported")
    carryOrigin(source, target)
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "binding",
        owner = owner,
        node = node,
        definition = key,
        expression = expression,
        sourceType = expression.inferredType,
        checked = key.type,
        fields = recordFields(contract)
    }

    return contract
end

export function assignment(owner: any, node: any, key: any, before: any, after: any): boolean
    if not compatibleTransport(before, after) then
        return false
    end
    bindingExpression(owner, node, key)
    need(before.checkedType == key.type and after.checkedType == key.type, "physical assignment checked type differs")

    return compatibleTransport(before, after)
end

-- These records retain checked type identities; the ABI pointer word alone
-- cannot authorize a typed argument, return, field access or lifetime escape.
-- Borrow modes retain the sealed checker's contract. Mapping validity and the
-- backing arena's lifetime remain the caller's core-service preconditions.
export function signature(owner: any, context: any, call: any?, caller: any?, serviceSignature: any?): any
    local needed = pointerType(owner.resultType)
    for _, value in ipairs(owner.parameterAnnotations or {}) do
        needed = needed or pointerType(value)
    end
    if not needed then
        return nil
    end
    need(context ~= nil, "typed signature requires physical target")
    local contract = signatureShape(owner, context, serviceSignature)
    for index, descriptor in ipairs(contract.params) do
        if descriptor and #descriptor.ownership == 1 and descriptor.ownership[1].tag == "borrowed" then
            origins[descriptor].dependency = {keys = {owner.parameterDefinitions[index]}}
        end
    end
    if contract.dependent then
        if call then
            require("nupp.compiler.vm.nativeunit").occurrence(caller, call)
        end
        local dependency = call and rootSnapshot(call) or {keys = {owner.parameterDefinitions[contract.dependent]}}
        contract.result = withDependency(contract.result, dependency)
    end
    local callSignature, exportSignature
    if call and caller and require("nupp.compiler.vm.nativeunit").contains(caller) then
        callSignature, exportSignature = require("nupp.compiler.vm.nativeunit").callSignature(caller, call, owner)
    end
    local heapCalls = {}
    if serviceSignature and call and caller then
        for index, descriptor in ipairs(contract.params) do
            if descriptor then
                local proof = serviceModule().heapCallUse(serviceSignature, caller, call, index)
                if proof then
                    local roots, formal = heapCallRoots(caller, call.args.exprs[index])
                    heapCalls[index] = {proof = proof, roots = roots, formal = formal}
                end
            end
        end
    end
    signatures[
        contract
    ] = {
        owner = owner,
        context = context,
        checked = contract.checkedSignature,
        serviceSignature = serviceSignature,
        heapCalls = heapCalls,
        node = owner.node,
        body = owner.body,
        scope = owner.scope,
        name = owner.name,
        path = owner.scope.path,
        module = owner.scope.name,
        definition = (owner.node.kind == "localFuncStmt" and owner.node.name or owner.node.name.base).definition,
        call = call,
        callSignature = callSignature,
        exportSignature = exportSignature,
        object = call and call.obj or nil,
        caller = caller,
        callerNode = caller and caller.node,
        callerBody = caller and caller.body,
        callerScope = caller and caller.scope,
        callerName = caller and caller.name,
        fields = recordFields(contract),
        parameters = recordFields(contract.params)
    }
    validateSignature(contract)
    for index, descriptor in ipairs(contract.params) do
        if descriptor and descriptor.checkedType.tag == "affine" then
            origins[descriptor].ownerSource = {signature = contract, parameter = index}
        end
    end
    if contract.result and contract.result.checkedType.tag == "affine" and call then
        origins[contract.result].ownerSource = {signature = contract, call = call, caller = caller}
    end
    if contract.managed and call then
        origins[
            contract.result
        ].managed = {signature = contract, call = call, caller = caller, owner = owner, proof = contract.managed}
    end

    return contract
end

export function validateSignature(contract: any): boolean
    local held = need(signatures[contract], "unknown checked pointer signature")
    need(getmetatable(contract) == nil, "issued physical record metatable changed")
    local owner = held.owner
    need(
        contract.owner == owner
        and contract.context == held.context
        and contract.checkedSignature == held.checked
        and owner.node == held.node
        and owner.body == held.body
        and owner.scope == held.scope
        and owner.name == held.name
        and owner.scope.path == held.path
        and owner.scope.name == held.module,
        "pointer signature owner/source changed"
    )
    local token = owner.node.kind == "localFuncStmt" and owner.node.name or owner.node.name.base
    need(token.definition == held.definition, "pointer definition identity changed")
    local expected = signatureShape(owner, held.context, held.serviceSignature)
    need(
        expected.checkedSignature == held.checked
        and #contract.params == #expected.params
        and contract.borrowing == expected.borrowing
        and contract.dependent == expected.dependent
        and contract.managed == expected.managed,
        "pointer signature changed"
    )
    for index, descriptor in ipairs(expected.params) do
        need(
            descriptor == false and contract.params[index] == false
            or descriptor and contract.params[index] and same(contract.params[index], descriptor),
            "pointer parameter type changed"
        )
    end
    for index in pairs(contract.params) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #expected.params,
            "pointer parameter index changed"
        )
    end
    need(
        expected.result == nil and contract.result == nil
        or expected.result and contract.result and same(contract.result, expected.result),
        "pointer result type changed"
    )
    if held.call then
        local call = held.call
        if expected.borrowing then
            local unit = require("nupp.compiler.vm.nativeunit")
            need(held.caller and unit.contains(held.caller), "borrowed call requires sealed caller")
            unit.call(held.caller, call, owner)
        end
        need(call.kind == "call" and call.obj == held.object, "pointer call expression changed")
        local sig = call.obj.inferredType
        while sig and (sig.tag == "const" or sig.tag == "literal") do
            sig = sig.tag == "literal" and sig.base or sig.inner
        end
        if held.callSignature then
            local actual, exported = require("nupp.compiler.vm.nativeunit").callSignature(held.caller, call, owner)
            need(
                actual == held.callSignature and exported == held.exportSignature and sig == actual,
                "pointer call/export signature identity changed"
            )
            for _, candidate in ipairs({actual, exported}) do
                need(
                    candidate.tag == "func"
                    and not candidate.foreign
                    and not candidate.vararg
                    and not candidate.yieldPack
                    and not candidate.resumePack
                    and candidate.paramPack
                    and not candidate.paramPack.tail
                    and not candidate.paramPack.alternatives
                    and candidate.retPack
                    and not candidate.retPack.tail
                    and not candidate.retPack.alternatives
                    and #candidate.params == #held.checked.params
                    and #candidate.rets == #held.checked.rets
                    and #candidate.paramPack.head == #candidate.params
                    and #candidate.retPack.head == #candidate.rets
                    and candidate.borrowsParam == held.checked.borrowsParam
                    and candidate.borrowsResult == held.checked.borrowsResult,
                    "pointer exported signature shape differs"
                )
                for index, value in ipairs(held.checked.params) do
                    need(
                        candidate.params[index] == value
                        and candidate.paramPack.head[index] == value
                        and candidate.paramModes[index] == held.checked.paramModes[index]
                        and candidate.paramPack.modes[index] == held.checked.paramPack.modes[index],
                        "pointer exported parameter differs"
                    )
                end
                for index, value in ipairs(held.checked.rets) do
                    need(
                        candidate.rets[index] == value
                        and candidate.retPack.head[index] == value
                        and candidate.retPack.modes[index] == held.checked.retPack.modes[index],
                        "pointer exported result differs"
                    )
                end
            end
        else
            need(sig == held.checked, "pointer call checked signature differs: " .. owner.name)
        end
        need(
            owner.resultType == nil
            or call.inferredType == owner.resultType
            or owner.resultType.tag == "nil" and call.inferredType == nil,
            "pointer call checked result differs: " .. owner.name
        )
        local definition = call.obj.kind == "name" and call.obj.token.definition
            or call.obj.kind == "dotIndex" and call.obj.name.definition
        need(definition == held.definition, "pointer call checked declaration differs")
        need(#call.args.exprs == #expected.params, "pointer call argument count differs")
        for index, descriptor in ipairs(expected.params) do
            local checked = held.checked.params[index]
            if descriptor and call.args.exprs[index].kind == "nilExpr" then
                local expression = call.args.exprs[index]
                require("nupp.compiler.vm.nativeunit").occurrence(held.caller, expression)
                need(
                    expression.inferredType
                    and expression.inferredType.tag == "nil"
                    and descriptor.nullable
                    and (
                        #descriptor.ownership == 0
                        or #descriptor.ownership == 1 and descriptor.ownership[1].tag == "borrowed"
                    ),
                    "literal nil requires an optional checked pointer parameter"
                )
            elseif descriptor then
                local actual = describe(held.context, call.args.exprs[index].inferredType)
                -- This is the checked source relation, not the SSA argument
                -- permission. An affine argument still needs its separately
                -- issued borrowed view before NativeLeafCall can consume it.
                local borrowedOwner = held.caller
                    and held.callSignature
                    and descriptor.checkedType.tag == "borrowed"
                    and actual.checkedType.tag == "affine"
                    and descriptor.checkedType.inner == actual.checkedType.inner
                need(
                    argument(descriptor, actual)
                    or borrowedOwner
                    or held.caller and serviceModule().isUnitModule(held.caller.scope.name)
                    or held.heapCalls[index]
                    and serviceModule().validateHeapCallUse(
                        held.heapCalls[index].proof,
                        held.serviceSignature,
                        held.caller,
                        call,
                        index
                    ) == call.args.exprs[index],
                    "pointer call argument checked type differs"
                )
            elseif checked.tag == "voidptr" then
                need(
                    call.args.exprs[index].inferredType == checked
                    or held.caller and serviceModule().isUnitModule(held.caller.scope.name),
                    "pointer call argument checked type differs"
                )
            end
        end
    end
    if contract.dependent then
        need(dependent(contract.result), "borrowed result dependency missing")
        local dependency = origins[contract.result].dependency
        if held.call then
            require("nupp.compiler.vm.nativeunit").occurrence(held.caller, held.call)
            need(dependency.node == held.call, "borrowed result belongs to another call")
        else
            need(
                #dependency.keys == 1 and dependency.keys[1] == owner.parameterDefinitions[contract.dependent],
                "borrowed result formal differs"
            )
        end
    end
    for index, use in pairs(held.heapCalls) do
        local argument = serviceModule().validateHeapCallUse(
            use.proof,
            held.serviceSignature,
            held.caller,
            held.call,
            index
        )
        if use.formal then
            local roots, formal = heapCallRoots(held.caller, argument)
            need(formal ~= nil, "Heap formal acquired substituted expression roots")
            sameRecord(formal, use.formal)
            need(sameDependency(roots, use.roots), "Heap formal dependency changed")
        else
            validateRoots(use.roots)
        end
    end
    sameRecord(contract.params, held.parameters)
    sameRecord(contract, held.fields)

    return true
end

local function pointerShape(parameter: any, actual: any): boolean
    return parameter.context == actual.context
        and parameter.machineKind == "voidptr"
        and actual.machineKind == "voidptr"
        and parameter.pointee == actual.pointee
        and parameter.declaration == actual.declaration
        and (parameter.nullable or not actual.nullable)
        and parameter.storageBytes == actual.storageBytes
end

export function argument(parameter: any, actual: any): boolean
    validate(parameter)
    validate(actual)
    if #parameter.ownership == 0 then
        return #actual.ownership == 0 and pointerShape(parameter, actual) and not dependent(actual)
    end
    need(
        #parameter.ownership == 1 and parameter.ownership[1].tag == "borrowed",
        "unsupported pointer parameter capability"
    )
    local ownership = #actual.ownership == 0 or #actual.ownership == 1 and actual.ownership[1].tag == "borrowed"

    return ownership and pointerShape(parameter, actual)
end

local function heapArgument(sig: any, index: integer, actual: any): any
    local saved = signatures[sig]
    local use = saved.heapCalls[index]
    if not use then
        return nil
    end
    local arg = serviceModule().validateHeapCallUse(use.proof, saved.serviceSignature, saved.caller, saved.call, index)
    validate(actual)
    need(
        actual.checkedType == arg.inferredType
        and #actual.ownership == 1
        and actual.ownership[1].tag == "borrowed"
        and pointerShape(sig.params[index], actual)
        and sameDependency(origins[actual].dependency, use.roots),
        "Heap call argument lost its original dependency"
    )

    return use
end

-- Bind only during source lowering. Verification never invents a lifetime
-- permission and no plain descriptor replaces the borrowed SSA value.
export function bindHeapCall(sig: any, index: integer, actual: any): nil
    validateSignature(sig)
    local use = heapArgument(sig, index, actual)
    if use then
        need(use.actual == nil or use.actual == actual, "Heap call argument was rebound")
        use.actual = actual
    end
end

export function callArgumentPermission(sig: any, index: integer, actual: any): boolean
    validateSignature(sig)
    local use = heapArgument(sig, index, actual)
    if use then
        need(use.actual ~= nil and sameValue(use.actual, actual), "Heap call lacks its emitted argument binding")
        return true
    end

    return argument(sig.params[index], actual)
end

export function hasHeapCallUse(sig: any): boolean
    validateSignature(sig)
    return next(signatures[sig].heapCalls) ~= nil
end

export function borrowingParameter(sig: any, index: integer): boolean
    validateSignature(sig)
    local descriptor = sig.params[index]
    return descriptor ~= nil
        and descriptor ~= false
        and #descriptor.ownership == 1
        and descriptor.ownership[1].tag == "borrowed"
end

export function validateCall(sig: any, source: any): boolean
    validateSignature(sig)
    local held = signatures[sig]
    local caller = held.caller
    need(
        held.call
        and caller
        and caller.node == held.callerNode
        and caller.body == held.callerBody
        and caller.node.body == held.callerBody
        and caller.scope == held.callerScope
        and caller.name == held.callerName
        and caller.scope.functions[caller.name] == caller,
        "call-specific pointer signature required"
    )
    need(
        source
        and source.path == caller.scope.path
        and source.module == caller.scope.name
        and source.name == caller.name,
        "pointer caller graph source differs"
    )

    return true
end

export function callArgument(sig: any, index: integer, node: any): boolean
    validateSignature(sig)
    local held = signatures[sig]
    return held.call ~= nil and held.call.args.exprs[index] == node and borrowingParameter(sig, index)
end

local function localCallOrigin(sig: any, index: integer, descriptor: any): any
    validateSignature(sig)
    local origin = localOrigin(descriptor)
    if not origin then
        return nil
    end
    local held = signatures[sig]
    need(held.call and held.caller and origin.owner == held.caller, "local pointer call belongs to another owner")
    need(sig.params[index] and pointerShape(sig.params[index], descriptor), "local pointer call changes checked layout")
    need(
        sig.result == nil and held.owner.resultKind ~= "voidptr"
        or serviceModule().builderacquisition(held.caller, held.call, held.owner, index),
        "local pointer call cannot return a pointer"
    )

    return origin
end

-- Record the actual local instance before emission. Verification may validate
-- this association, but cannot mint a new scoped lifetime permission.
export function bindLocalCall(sig: any, index: integer, descriptor: any): nil
    local origin = localCallOrigin(sig, index, descriptor)
    if not origin then
        return
    end
    local held = signatures[sig]
    held.localCalls = held.localCalls or {}
    local saved = held.localCalls[index]
    if saved then
        need(saved.origin == origin, "local pointer call instance changed")
        return
    end
    local scoped
    if not callArgument(sig, index, held.call.args.exprs[index]) then
        need(
            #sig.params[index].ownership == 0 and #descriptor.ownership == 0,
            "local pointer requires borrowed or reviewed plain formal"
        )
        scoped = require("nupp.compiler.vm.nativeservice").scopedCall(held.caller, held.call, held.owner, index)
    end
    held.localCalls[index] = {origin = origin, scoped = scoped}
    if serviceModule().builderacquisition(held.caller, held.call, held.owner, index) then
        need(sig.result and origins[sig.result].ownerSource, "Builder call lacks its acquired result")
        origins[sig.result].ownerSource.stack = origin
    end
end

export function validateLocalCall(sig: any, index: integer, descriptor: any): boolean
    local origin = localCallOrigin(sig, index, descriptor)
    if not origin then
        return true
    end
    local held = signatures[sig]
    local saved = held.localCalls and held.localCalls[index]
    need(saved and saved.origin == origin, "local pointer call instance changed")
    if callArgument(sig, index, held.call.args.exprs[index]) then
        need(saved.scoped == nil, "borrowed local call permission changed")
    else
        require(
            "nupp.compiler.vm.nativeservice"
        ).validateScopedCall(saved.scoped, held.caller, held.call, held.owner, index)
    end

    return true
end

export function returnValue(sig: any, descriptor: any): boolean
    validateSignature(sig)
    if sig.result == nil or descriptor == nil then
        return sig.result == descriptor
    end
    local expected = sig.result
    validate(descriptor)
    local managed = origins[descriptor].managed
    if sig.managed then
        return managed ~= nil
            and managed.returnProof ~= nil
            and serviceModule().validateManagedReturn(
                managed.returnProof,
                sig.owner,
                managed.source,
                managed.node
            ) == descriptor.checkedType
            and pointerShape(expected, descriptor)
    end
    if managed then
        return false
    end

    if #expected.ownership == 1 and expected.ownership[1].tag == "affine" then
        -- A terminal-less takes binding is not the constructor's returned
        -- obligation, even when both have the same pointer representation.
        return same(expected, descriptor)
    end

    return pointerShape(expected, descriptor)
        and #expected.ownership == #descriptor.ownership
        and sameDependency(origins[expected].dependency, origins[descriptor].dependency)
end

-- Raw pointer bits do not acquire a pointee, borrow or local lifetime by
-- returning. Typed/nullable/qualified results still require their signature.
export function rawReturn(descriptor: any): boolean
    validate(descriptor)
    return descriptor.checkedType.tag == "voidptr"
        and descriptor.storageType.tag == "voidptr"
        and descriptor.machineKind == "voidptr"
        and not descriptor.nullable
        and descriptor.pointee == nil
        and #descriptor.ownership == 0
        and not dependent(descriptor)
        and not localOrigin(descriptor)
        and origins[descriptor].managed == nil
end

export function callInput(sig: any, index: integer, descriptor: any, access: any?): boolean
    validateSignature(sig)
    if sig.dependent ~= index then
        return true
    end
    validate(descriptor)
    local dependency = origins[descriptor].dependency
    if access and dependency == nil then
        validateField(access)
        need(
            access.storage == descriptor and callArgument(sig, index, access.node),
            "dependent call field source differs"
        )
        dependency = origins[access.receiver].dependency
    end

    return dependency ~= nil and sameDependency(dependency, origins[sig.result].dependency)
end

export function callResult(sig: any, descriptor: any): boolean
    validateSignature(sig)
    if sig.result == nil or descriptor == nil then
        return sig.result == descriptor
    end

    return sig.result == descriptor and sameValue(sig.result, descriptor)
end

export function sameSignature(left: any, right: any): boolean
    validateSignature(left)
    validateSignature(right)
    if left.owner ~= right.owner
        or left.context ~= right.context
        or left.checkedSignature ~= right.checkedSignature
        or #left.params ~= #right.params
    then
        return false
    end
    for index, descriptor in ipairs(left.params) do
        local other = right.params[index]
        if descriptor == false and other ~= false or descriptor and (not other or not same(descriptor, other)) then
            return false
        end
    end

    return left.result == nil and right.result == nil
        or left.result ~= nil and right.result ~= nil and same(left.result, right.result)
end

export function cast(source: any, node: any, owner: any?): any
    validate(source)
    need(source.machineKind == "voidptr" and not source.nullable, "pointer cast requires nonnullable source")
    need(node and node.kind == "castExpr" and node.expr, "checked pointer cast required")
    need(node.expr.inferredType == source.checkedType, "cast checked source differs")
    local target = describe(source.context, node.inferredType)
    need(
        target.machineKind == "voidptr" and #source.ownership == #target.ownership,
        "pointer cast changes ownership or nullability"
    )
    if #source.ownership ~= 0 then
        require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
        need(
            #source.ownership == 1
            and source.ownership[1].tag == "borrowed"
            and target.ownership[1].tag == "borrowed"
            and dependent(source),
            "pointer cast loses borrowed source"
        )
        origins[target].dependency = rootSnapshot(node)
        need(sameDependency(origins[source].dependency, origins[target].dependency), "cast borrow roots differ")
    end
    local localOwner = localOrigins[source]
    if localOwner then
        validate(target)
        need(
            target.machineKind == "voidptr" and #target.ownership == 0 and not target.nullable,
            "plain nonnullable pointer representation required"
        )
        validateLocal(localOwner)
        need(
            target.storageType.tag == "ptr" and target.pointee == localOwner.checkedType,
            "local address must retain exact struct pointee"
        )
        localOrigins[target] = localOwner
    else
        need(
            source.storageBytes == target.storageBytes and source.layout.alignment == target.layout.alignment,
            "pointer representation differs"
        )
    end
    origins[target].field = origins[source].field
    origins[target].transport = origins[source].transport
    origins[target].managed = origins[source].managed
    localOrigins[target] = localOrigins[source]
    local contract = {source = source, target = target, node = node}
    casts[
        contract
    ] = {
        source = source,
        target = target,
        node = node,
        expression = node.expr,
        owner = owner,
        sourceType = node.expr.inferredType,
        targetType = node.inferredType,
        fields = recordFields(contract)
    }

    return contract
end

-- Origins are created by a checked call-specific signature or an exact
-- takes formal. Equal affine types cannot substitute one local owner for
-- another. Binding retains the original descriptor and SSA cleanup value.
local function acquiredOrigin(owner: any, source: any, expression: any): any
    local origin = need(origins[source].ownerSource, "affine source lacks checked acquisition origin")
    local sig = origin.signature
    validateSignature(sig)
    local held = signatures[sig]
    need(
        origin.call == expression
        and origin.caller == owner
        and held.call == expression
        and held.caller == owner
        and sig.result
        and same(sig.result, source),
        "affine acquisition source differs"
    )
    require("nupp.compiler.vm.nativeunit").occurrence(owner, expression)
    need(expression.inferredType == source.checkedType, "affine acquisition checked type differs")

    return origin
end

-- Validation only: every affine graph value retains an issued formal,
-- acquisition or reviewed creation origin. Equal pointer types are insufficient.
export function affineValue(owner: any, descriptor: any): boolean
    validate(descriptor)
    if descriptor.checkedType.tag ~= "affine" then
        return false
    end
    local origin = need(origins[descriptor].ownerSource, "affine graph value lacks ownership origin")
    local service = serviceModule()
    if origin.creation then
        if service.isbuilderreturn(origin.creation) then
            return service.validatebuildervalue(origin.creation, owner, descriptor)
        end
        return service.validateArenaValue(origin.creation, owner, descriptor)
    end
    local sig = origin.signature
    validateSignature(sig)
    local held = signatures[sig]
    if origin.parameter then
        need(
            sig.owner == owner
            and sig.params[origin.parameter]
            and sameValue(sig.params[origin.parameter], descriptor)
            and ownedboundary(held.serviceSignature, owner, origin.parameter) == descriptor.checkedType,
            "affine parameter origin differs"
        )
    else
        acquiredOrigin(owner, descriptor, origin.call)
        need(
            ownedboundary(held.serviceSignature, sig.owner) == descriptor.checkedType,
            "affine acquisition constructor differs"
        )
    end

    return true
end

-- This is a source-identity query, not an owning-pointer conversion.
export function arenaForward(owner: any, source: any, expression: any, sig: any): any
    validateSignature(sig)
    need(sig.owner == owner, "Arena forwarding caller differs")
    local expected = serviceModule().arenaOwnership(signatures[sig].serviceSignature, owner)
    need(source.checkedType == expected, "Arena forwarding obligation differs")
    local origin = acquiredOrigin(owner, source, expression)
    local home = require("nupp.compiler.vm.nativeunit").ownerModule(owner, "nupp.runtime.vm.arena")
    need(origin.signature.owner == home.functions.openWith, "Arena forwarding constructor differs")

    return origin
end

export function sameArenaOwner(left: any, right: any): boolean
    validate(left)
    validate(right)
    local origin = origins[left].ownerSource
    return origin ~= nil and origin == origins[right].ownerSource and same(left, right)
end

-- A detached identity query. Pending managed transport never grants rooting,
-- generic pointer escape, or an executable entry permission.
export function managedOrigin(descriptor: any): any
    validate(descriptor)
    local origin = origins[descriptor].managed
    if not origin then
        return nil
    end
    if origin.returnProof then
        serviceModule().validateManagedReturn(origin.returnProof, origin.owner, origin.source, origin.node)
    else
        validateSignature(origin.signature)
        local saved = signatures[origin.signature]
        need(
            saved.call == origin.call
            and saved.caller == origin.caller
            and saved.owner == origin.owner
            and origin.signature.managed == origin.proof,
            "managed result call origin changed"
        )
    end

    return {owner = origin.owner, caller = origin.caller, call = origin.call, proof = origin.proof, node = origin.node}
end

export function managedReturnView(owner: any, source: any, node: any, proof: any): any
    validate(source)
    local checked = serviceModule().validateManagedReturn(proof, owner, source, node)
    need(
        source.checkedType == checked
        and source.machineKind == "voidptr"
        and not source.nullable
        and #source.ownership == 0
        and not localOrigins[source],
        "managed return representation differs"
    )
    local target = describe(source.context, checked)
    origins[target].managed = {owner = owner, source = source, node = node, returnProof = proof, proof = proof}
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "managedReturn",
        owner = owner,
        source = source,
        target = target,
        node = node,
        checked = checked,
        proof = proof,
        fields = recordFields(contract)
    }

    return contract
end

-- Preserve the exact existing checked dependency, including nullable
-- success. The new SSA row is only an identity; it grants no new lifetime.
export function dependentReturnView(owner: any, source: any, node: any, sig: any): any
    validateSignature(sig)
    local held = signatures[sig]
    need(sig.owner == owner and held.call == nil, "dependent return needs its definition signature")
    serviceModule().dependentReturn(held.serviceSignature, owner)
    require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
    need(
        sig.dependent == 1
        and source.machineKind == "voidptr"
        and not localOrigins[source]
        and returnValue(sig, source),
        "dependent return source lacks its exact backing dependency"
    )
    local target = describe(source.context, source.checkedType)
    carryOrigin(source, target)
    -- The source may be a phi. Retain its origin union, not its private
    -- destination flag: this descriptor belongs to a new operation result.
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "dependentReturn",
        owner = owner,
        node = node,
        checked = source.checkedType,
        source = source,
        target = target,
        signature = sig,
        fields = recordFields(contract)
    }

    return contract
end

-- The target's affine qualifier comes only from the closed service plan. A
-- public cast or copied descriptor cannot mint the plan or a new obligation.
export function arenaReturnView(owner: any, source: any, node: any, proof: any): any
    validate(source)
    local checked = serviceModule().validateArenaReturn(proof, owner, source, node)
    need(
        source.machineKind == "voidptr"
        and not source.nullable
        and (source.checkedType == checked or source.checkedType == checked.inner)
        and not localOrigins[source],
        "Arena return source cannot create this obligation"
    )
    local target = describe(source.context, checked)
    origins[target].ownerSource = origins[source].ownerSource or {creation = proof}
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "arenaReturn",
        owner = owner,
        node = node,
        checked = checked,
        proof = proof,
        fields = recordFields(contract),
        sourceType = source.checkedType,
        source = source,
        target = target,
        origin = origins[target].ownerSource
    }

    return contract
end

-- The qualifier owns a handle while the borrowed caller-local descriptor stays
-- live. It grants no mapping ownership or general pointer-return conversion.
export function builderreturnview(owner: any, source: any, node: any, proof: any): any
    validate(source)
    local checked = serviceModule().validatebuilderreturn(proof, owner, source, node)
    need(
        source.machineKind == "voidptr"
        and not source.nullable
        and source.checkedType == checked.inner
        and not localOrigins[source],
        "Builder return requires its exact formal pointer"
    )
    local target = describe(source.context, checked)
    origins[target].ownerSource = {creation = proof}
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "builderreturn",
        owner = owner,
        node = node,
        checked = checked,
        proof = proof,
        fields = recordFields(contract),
        source = source,
        target = target,
        origin = origins[target].ownerSource
    }

    return contract
end

export function buildercleanupoperand(owner: any, source: any, expression: any, target: any): boolean
    validate(source)
    validateSignature(target)
    local origin = acquiredOrigin(owner, source, expression)
    local home = require("nupp.compiler.vm.nativeunit").ownerModule(owner, "nupp.runtime.core.corestrings")
    local bound = serviceModule().builderownership(signatures[target].serviceSignature, target.owner, 1)
    need(
        target.owner == home.exports.close
        and origin.signature.owner == home.exports.open
        and source.checkedType.tag == "affine"
        and source.checkedType.inner == bound.inner
        and #source.checkedType.cleanups == 1
        and source.checkedType.cleanups[1].functionType == target.owner.checkedSignature
        and origin.stack
        and origin.stack.owner == owner,
        "Builder cleanup lost its exact stack acquisition or handle terminal"
    )
    validateLocal(origin.stack)

    return true
end

export function arenaCleanupOperand(owner: any, source: any, expression: any, target: any): boolean
    validate(source)
    validateSignature(target)
    local service = serviceModule()
    local bound = service.arenaOwnership(signatures[target].serviceSignature, target.owner, 1)
    local origin = acquiredOrigin(owner, source, expression)
    local home = require("nupp.compiler.vm.nativeunit").ownerModule(owner, "nupp.runtime.vm.arena")
    local constructor = home.functions.openWith
    if service.isUnitModule(owner.scope.name) then
        local unit = require("nupp.compiler.vm.nativeunit")
        constructor = unit.callee(owner, expression)
        need(
            constructor == home.exports.open or constructor == home.exports.openGrowable,
            "Arena cleanup source acquisition differs"
        )
    elseif owner.scope.name == "nupp.runtime.core.heapentry" then
        local unit = require("nupp.compiler.vm.nativeunit")
        need(
            owner == unit.ownerModule(owner, "nupp.runtime.core.heapentry").exports.run,
            "Arena cleanup caller differs"
        )
        constructor = home.exports.open
        need(unit.callee(owner, expression) == constructor, "Arena cleanup source acquisition differs")
    end
    need(
        target.owner == home.exports.close
        and origin.signature.owner == constructor
        and source.checkedType.tag == "affine"
        and source.checkedType.inner == bound.inner
        and #source.checkedType.cleanups == 1
        and source.checkedType.cleanups[1].functionType == target.owner.checkedSignature,
        "Arena cleanup instance or exact terminal differs"
    )

    return true
end

-- Entry validation retains the signature's existing takes origin. A consumed
-- formal is not a local acquisition and gains no automatic cleanup registration.
export function takesEntry(owner: any, sig: any, source: any, node: any, key: any, value: integer): nil
    validateSignature(sig)
    validate(source)
    local held = signatures[sig]
    need(
        sig.owner == owner
        and held.call == nil
        and held.serviceSignature ~= nil
        and value >= 1
        and value <= #owner.body.params
        and owner.body.params[value] == node
        and owner.parameterDefinitions[value] == key
        and node.name.definition == key
        and sig.params[value] == source
        and owner.parameterModes[value] == "takes"
        and key.type == source.checkedType,
        "takes entry requires its exact checked parameter and SSA"
    )
    local origin = need(origins[source].ownerSource, "takes entry lacks issued parameter origin")
    need(
        origin.signature == sig
        and origin.parameter == value
        and origin.call == nil
        and origin.binding == nil
        and ownedboundary(held.serviceSignature, owner, value) == source.checkedType,
        "takes entry ownership origin differs"
    )
end

export function bindOwner(owner: any, source: any, node: any, key: any): nil
    require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
    need(node.kind == "localStmt", "owning assignment transfer is unsupported")
    local cleanup = require("nupp.compiler.vm.functioncleanup")
    local found
    for index, token in ipairs(node.names) do
        if token.definition == key then
            local automatic = need(cleanup.localOwner(node, index), "checked automatic owner required")
            need(automatic.type == source.checkedType, "automatic owner type differs")
            local origin = acquiredOrigin(owner, source, automatic.expr)
            need(origin.binding == nil or origin.binding == automatic, "affine acquisition already bound")
            origin.binding = automatic
            found = true
        end
    end
    need(found, "owning local definition differs")
end

-- A use of an owning pointer borrows its checked binding; it does not move
-- the source value or erase its cleanup obligation. The original descriptor
-- remains affine. Only the new NativePointerView result has this projection.
local function ownerEvidence(owner: any, source: any, node: any, sig: any?): any
    local unit = require("nupp.compiler.vm.nativeunit")
    local cleanup = require("nupp.compiler.vm.functioncleanup")
    unit.occurrence(owner, node)
    validate(source)
    need(
        source.checkedType.tag == "affine"
        and #source.ownership == 1
        and source.ownership[1] == source.checkedType
        and source.machineKind == "voidptr"
        and not source.nullable
        and source.checkedType.inner.tag == "ptr",
        "owner view requires an exact nonnull affine pointer"
    )
    need(
        node.kind == "name" and node.token.definition and node.inferredType == source.checkedType,
        "checked owning name required"
    )
    local definition = node.token.definition
    need(definition.type == source.checkedType, "owning binding type differs")
    for index, parameter in ipairs(owner.parameterDefinitions) do
        if parameter == definition then
            need(sig and sig.owner == owner, "takes view requires its issued signature")
            validateSignature(sig)
            local held = signatures[sig]
            local origin = need(origins[source].ownerSource, "takes source lacks issued parameter origin")
            need(origin.signature == sig and origin.parameter == index, "takes source parameter differs")
            need(held.serviceSignature ~= nil, "takes view requires private service capability")
            need(
                owner.parameterModes[index] == "takes" and sig.params[index].checkedType == source.checkedType,
                "takes binding signature differs"
            )
            return {
                mode = "takes",
                definition = definition,
                record = owner.body.params[index],
                index = index,
                sourceType = source.checkedType,
                signature = sig
            }
        end
    end
    for _, stat in ipairs(unit.occurrences(owner)) do
        if stat.kind == "localStmt" then
            for index, token in ipairs(stat.names) do
                if token.definition == definition then
                    local automatic = need(cleanup.localOwner(stat, index), "checked automatic owner required")
                    need(automatic.type == source.checkedType, "automatic owner type differs")
                    local origin = acquiredOrigin(owner, source, automatic.expr)
                    need(origin.binding == automatic, "owning local source differs")
                    return {
                        mode = "local",
                        definition = definition,
                        record = automatic,
                        stat = stat,
                        index = index,
                        sourceType = source.checkedType
                    }
                end
            end
        end
    end
    error("native physical: owner occurrence lacks checked acquisition", 0)
end

export function ownerView(owner: any, source: any, node: any, sig: any?): any
    local evidence = ownerEvidence(owner, source, node, sig)
    local checked = require("nupp.compiler.types").borrowed(source.checkedType.inner)
    local target = describe(source.context, checked)
    carryOrigin(source, target)
    origins[target].dependency = {keys = {evidence.definition}}
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "owner",
        owner = owner,
        node = node,
        checked = checked,
        sourceType = source.checkedType,
        evidence = evidence,
        signature = sig,
        fields = recordFields(contract)
    }
    origins[target].ownerBorrow = contract

    return contract
end

-- Only a checked borrowing call operand gets a projection. Takes operands
-- still use the affine source and fail at their separate unimplemented gate.
export function ownerArgument(sig: any, index: integer, source: any, callerSignature: any?): any
    validateSignature(sig)
    local held = signatures[sig]
    need(
        held.call and held.caller and borrowingParameter(sig, index),
        "owner argument requires exact checked borrowing call"
    )
    local node = held.call.args.exprs[index]
    local contract = ownerView(held.caller, source, node, callerSignature)
    views[contract].callSignature, views[contract].argument = sig, index
    need(argument(sig.params[index], contract.target), "owner argument pointee differs")

    return contract
end

local function ownerReceiver(receiver: any, node: any): any
    local contract = origins[receiver].ownerBorrow
    if not contract then
        return nil
    end
    validateCast(contract)
    local view = views[contract]
    require("nupp.compiler.vm.nativeunit").occurrence(view.owner, node)
    need(node.kind == "name" and node.token.definition == view.evidence.definition, "owner receiver definition differs")
    need(
        node.inferredType == view.sourceType or node.inferredType == view.checked,
        "owner receiver checked type differs"
    )
    if node.capabilityFacts and node.capabilityFacts.roots then
        need(sameDependency(origins[receiver].dependency, rootSnapshot(node)), "owner receiver roots differ")
    end
    need(
        same(receiver, contract.target)
        and sameDependency(origins[receiver].dependency, origins[contract.target].dependency),
        "owner receiver projection differs"
    )

    return view.owner
end

-- The checker can distribute a borrow into an optional arm at a read.
-- This relation preserves both checked types; it does not issue a new borrow.
local function optionalBorrowShape(source: any, target: any, definition: any): boolean
    local checked = source.checkedType
    local optional = checked.tag == "borrowed" and checked.inner
    local union = target.checkedType
    if not optional
        or optional.tag ~= "union"
        or not optional.hasNil
        or #optional.members ~= 2
        or union.tag ~= "union"
        or not union.hasNil
        or #union.members ~= 2
    then
        return false
    end
    local pointer = optional.members[1].tag == "nil" and optional.members[2] or optional.members[1]
    local member = union.members[1].tag == "nil" and union.members[2] or union.members[1]

    return definition.type == checked
        and (pointer.tag == "ptr" or pointer.tag == "voidptr")
        and member.tag == "borrowed"
        and member.inner == pointer
        and source.nullable
        and target.nullable
        and #source.ownership == 1
        and source.ownership[1] == checked
        and #target.ownership == 1
        and target.ownership[1] == member
        and pointerShape(source, target)
        and pointerShape(target, source)
end

-- Refined/nil/borrow views are issued from checked occurrences. The graph
-- separately verifies the actual null predicate or zero input before use.
export function occurrence(owner: any, source: any, node: any): any
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, node)
    validate(source)
    local target = describe(source.context, node.inferredType)
    if node.kind == "name" and node.token.definition and optionalBorrowShape(source, target, node.token.definition) then
        need(unit.checkedOccurrenceType(owner, node) == target.checkedType, "optional borrowed checked type differs")
        local dependency = need(origins[source].dependency, "optional borrowed occurrence lost source dependency")
        local roots = rootSnapshot(node)
        need(sameDependency(dependency, roots), "optional borrowed occurrence roots differ")
        carryOrigin(source, target)
        local contract = {source = source, target = target, node = node}
        views[
            contract
        ] = {
            mode = "optionalBorrow",
            owner = owner,
            node = node,
            checked = node.inferredType,
            definition = node.token.definition,
            source = source,
            target = target,
            roots = roots,
            dependency = dependency,
            fields = recordFields(contract)
        }
        return contract
    end
    need(
        node.kind == "name"
        and node.token.definition
        and source.nullable
        and not target.nullable
        and target.machineKind == "voidptr"
        and source.pointee == target.pointee
        and #source.ownership == #target.ownership,
        "checked nonnull pointer occurrence required"
    )
    local dependency = origins[source].dependency
    if dependency then
        if node.capabilityFacts and node.capabilityFacts.roots then
            origins[target].dependency = rootSnapshot(node)
            need(sameDependency(dependency, origins[target].dependency), "refined borrow roots differ")
        else
            need(
                #dependency.keys == 1 and dependency.keys[1] == node.token.definition,
                "refined formal borrow identity differs"
            )
            origins[target].dependency = dependency
        end
    end
    origins[target].field = origins[source].field
    origins[target].transport = origins[source].transport
    origins[target].ownerBorrow = origins[source].ownerBorrow
    origins[target].ownerSource = origins[source].ownerSource
    origins[target].managed = origins[source].managed
    localOrigins[target] = localOrigins[source]
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "nonnull",
        owner = owner,
        node = node,
        checked = node.inferredType,
        definition = node.token.definition,
        fields = recordFields(contract)
    }

    return contract
end

-- Context comes only from an authenticated checked call or return site.
-- The existing nil-view graph rule additionally requires actual zero bits.
export function nilArgument(sig: any, index: integer): any
    validateSignature(sig)
    local held = signatures[sig]
    local node = held.call and held.call.args.exprs[index]
    if not node or node.kind ~= "nilExpr" then
        return nil
    end
    local formal = sig.params[index]
    need(formal and formal.nullable, "literal nil requires an optional pointer formal")
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(held.caller, held.call)
    unit.occurrence(held.caller, node)
    local target = describe(held.context, held.checked.params[index])
    need(
        node.inferredType
        and node.inferredType.tag == "nil"
        and target.nullable
        and #target.ownership == 0
        and argument(formal, target),
        "contextual nil argument type differs"
    )
    local contract = {target = target, node = node}
    views[
        contract
    ] = {
        mode = "nil",
        contextual = "argument",
        owner = held.caller,
        signature = sig,
        index = index,
        site = held.call,
        node = node,
        expression = node,
        nilType = node.inferredType,
        checked = target.checkedType,
        fields = recordFields(contract)
    }

    return contract
end

export function nilReturn(sig: any, owner: any, statement: any): any
    validateSignature(sig)
    local held = signatures[sig]
    need(
        held.owner == owner and held.call == nil and statement.kind == "returnStmt" and #statement.exprs == 1,
        "contextual nil return owner or statement differs"
    )
    local node = statement.exprs[1]
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, statement)
    unit.occurrence(owner, node)
    local target = describe(held.context, held.checked.rets[1])
    need(
        node.kind == "nilExpr"
        and node.inferredType
        and node.inferredType.tag == "nil"
        and target.nullable
        and #target.ownership == 0
        and returnValue(sig, target),
        "contextual nil return requires a plain optional pointer result"
    )
    local contract = {target = target, node = node}
    views[
        contract
    ] = {
        mode = "nil",
        contextual = "return",
        owner = owner,
        signature = sig,
        site = statement,
        node = node,
        expression = node,
        nilType = node.inferredType,
        checked = target.checkedType,
        fields = recordFields(contract)
    }

    return contract
end

export function nilView(owner: any, context: any, node: any): any
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, node)
    need(node.kind == "castExpr" and node.expr.kind == "nilExpr", "checked typed nil cast required")
    local target = describe(context, node.inferredType)
    need(
        target.machineKind == "voidptr" and target.nullable and #target.ownership == 0,
        "typed nil requires optional plain pointer"
    )
    local contract = {target = target, node = node}
    views[
        contract
    ] = {
        mode = "nil",
        owner = owner,
        node = node,
        expression = node.expr,
        checked = node.inferredType,
        fields = recordFields(contract)
    }

    return contract
end

export function borrowView(owner: any, source: any, node: any): any
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, node)
    need(
        node.kind == "call"
        and node.ownershipIntrinsic == "borrowFrom"
        and #node.args.exprs == 2
        and node.args.exprs[2].kind == "name",
        "checked borrowFrom occurrence required"
    )
    validate(source)
    local target = describe(source.context, node.inferredType)
    need(
        #source.ownership == 0
        and #target.ownership == 1
        and target.ownership[1].tag == "borrowed"
        and source.machineKind == "voidptr"
        and source.storageType == target.storageType,
        "borrowFrom representation differs"
    )
    origins[target].dependency = rootSnapshot(node)
    local root = node.args.exprs[2].token.definition
    need(
        #origins[target].dependency.keys == 1 and origins[target].dependency.keys[1] == root,
        "borrowFrom root differs from checked source"
    )
    origins[target].field = origins[source].field
    origins[target].transport = origins[source].transport
    localOrigins[target] = localOrigins[source]
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "borrow",
        owner = owner,
        node = node,
        expression = node.args.exprs[1],
        root = node.args.exprs[2],
        definition = root,
        checked = node.inferredType,
        fields = recordFields(contract)
    }

    return contract
end

-- Address extraction is an existing checked intrinsic. It exposes scalar bits,
-- never a new pointer capability; source ownership and roots remain immutable.
export function address(owner: any, source: any, node: any): any
    require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
    validate(source)
    local callee = node.obj
    local sig = callee and callee.inferredType
    need(
        node.kind == "call"
        and callee
        and callee.kind == "dotIndex"
        and callee.obj.kind == "name"
        and callee.obj.token.definition
        and callee.obj.token.definition.requiredModule == "nupp.runtime.vm.intrinsics"
        and callee.name.text == "address"
        and callee.name.definition
        and sig
        and sig.tag == "func"
        and #sig.params == 1
        and sig.params[1].tag == "voidptr"
        and #sig.rets == 1
        and sig.rets[1].tag == "uint64"
        and #node.args.exprs == 1
        and node.unsafeOwnershipOperation == "borrowed pointer passed to a plain parameter",
        "checked address intrinsic required"
    )
    need(
        source.machineKind == "voidptr"
        and not source.nullable
        and #source.ownership == 1
        and source.ownership[1].tag == "borrowed"
        and dependent(source)
        and node.args.exprs[1].inferredType == source.checkedType,
        "address requires exact nonnullable borrowed source"
    )
    local target = describe(source.context, node.inferredType)
    need(target.machineKind == "uint64" and #target.ownership == 0, "address result must be scalar")
    local contract = {source = source, target = target, node = node}
    views[
        contract
    ] = {
        mode = "address",
        owner = owner,
        node = node,
        checked = node.inferredType,
        expression = node.args.exprs[1],
        callee = callee,
        definition = callee.name.definition,
        moduleDefinition = callee.obj.token.definition,
        signature = sig,
        parameter = sig.params[1],
        result = sig.rets[1],
        params = sig.params,
        rets = sig.rets,
        fields = recordFields(contract)
    }

    return contract
end

export function borrowArgument(contract: any, descriptor: any): boolean
    validateCast(contract)
    local held = views[contract]
    need(held and held.mode == "borrow", "borrow view required")
    validate(descriptor)

    return descriptor.context == contract.target.context
        and sameDependency(origins[descriptor].dependency, origins[contract.target].dependency)
end

export function viewKind(contract: any): string?
    local held = views[contract]
    return held and held.mode or nil
end

-- Run only after the ordinary graph verifier has established SSA and edges.
-- Work backwards through actual edges, translating phi arguments and retaining
-- branch truth constraints. This recognizes short-circuit null guards without
-- recreating the checker's syntax analysis. Unproved cyclic paths refuse.
export function verifyViews(g: any): nil
    local definitions, predecessors = {}, {}
    for index, block in ipairs(g.blocks) do
        predecessors[index] = predecessors[index] or {}
        for at, op in ipairs(block.op) do
            if block.dst[at] ~= 0 then
                definitions[block.dst[at]] = {op = op, args = block.args[at]}
            end
        end
        for edgeIndex, edge in ipairs(block.term.edges) do
            predecessors[edge.target] = predecessors[edge.target] or {}
            table.insert(predecessors[edge.target], {source = index, edge = edge, index = edgeIndex})
        end
    end

    local function zero(value: integer): boolean
        local d = definitions[value]
        if not d or d.op ~= "NativePointer" then
            return false
        end
        local bits = definitions[d.args[1]]

        return bits ~= nil and bits.op == "NativeConstant" and bits.args[1] == "0"
    end

    local function guarded(start: integer, pointer: integer): boolean
        local active, work = {}, 0
        local visit: function(integer, integer, any): boolean
        visit = function(index, value, facts)
            work = work + 1
            need(work <= 100000, "nonnull proof work limit exceeded")
            local block = g.blocks[index]
            for condition, truth in pairs(facts) do
                local d = definitions[condition]
                if d and d.op == "NativeBoolean" and d.args[1] ~= truth then
                    return true
                end
                if d and d.op == "NativeICmp" and (d.args[3] == "==" or d.args[3] == "~=") then
                    local compared = d.args[1] == value and zero(d.args[2]) or d.args[2] == value and zero(d.args[1])
                    if compared and (d.args[3] == "~=") == truth then
                        return true
                    end
                end
            end
            if index == 1 or active[index] or #predecessors[index] == 0 then
                return false
            end
            active[index] = true
            for _, incoming in ipairs(predecessors[index]) do
                local replaced = {}
                for at, parameter in ipairs(block.params) do
                    replaced[parameter] = incoming.edge.args[at]
                end
                local prior, possible = {}, true
                for condition, truth in pairs(facts) do
                    local key = replaced[condition] or condition
                    if prior[key] ~= nil and prior[key] ~= truth then
                        possible = false
                    end
                    prior[key] = truth
                end
                local term = g.blocks[incoming.source].term
                if term.kind == "branch" then
                    local truth = incoming.index == 1
                    if prior[term.value] ~= nil and prior[term.value] ~= truth then
                        possible = false
                    end
                    prior[term.value] = truth
                end
                if possible and not visit(incoming.source, replaced[value] or value, prior) then
                    active[index] = nil
                    return false
                end
            end
            active[index] = nil

            return true
        end

        return visit(start, pointer, {})
    end

    for index, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            if op == "NativeStore" and block.args[at][4].retention then
                local args = block.args[at]
                if nilStore(args[4].retention) then
                    need(zero(args[3]), "nil field store requires actual zero input")
                end
            elseif op == "NativePointerView" then
                local args = block.args[at]
                local mode = viewKind(args[2])
                if mode == "nil" then
                    need(zero(args[1]), "typed nil view requires actual zero input")
                elseif mode == "nonnull" then
                    need(guarded(index, args[1]), "nonnull occurrence lacks graph null guard")
                end
            end
        end
    end
end

export function validateViewOwner(contract: any, source: any): nil
    local held = views[contract] or casts[contract]
    if held and held.owner then
        local owner = held.owner
        need(
            source
            and source.path == owner.scope.path
            and source.module == owner.scope.name
            and source.name == owner.name,
            "pointer occurrence graph owner differs"
        )
    end
end

export function validateCast(contract: any): boolean
    local view = views[contract]
    if view then
        require("nupp.compiler.vm.nativeunit").occurrence(view.owner, view.node)
        sameRecord(contract, view.fields)
        need(
            view.node == contract.node
            and (
                view.mode == "binding"
                or view.mode == "owner"
                or view.mode == "arenaReturn"
                or view.mode == "builderreturn"
                or view.mode == "dependentReturn"
                or view.mode == "managedReturn"
                or view.mode == "nil" and view.contextual ~= nil
                or view.node.inferredType == view.checked
            )
            and contract.target.checkedType == view.checked,
            "pointer occurrence type changed"
        )
        validate(contract.target)
        if contract.source then
            validate(contract.source)
        end
        if view.mode == "managedReturn" then
            need(
                serviceModule().validateManagedReturn(
                    view.proof,
                    view.owner,
                    contract.source,
                    view.node
                ) == view.checked
                and contract.source == view.source
                and contract.target == view.target
                and origins[contract.target].managed.returnProof == view.proof
                and origins[contract.target].managed.source == view.source,
                "managed return view identity changed"
            )
        elseif view.mode == "dependentReturn" then
            validateSignature(view.signature)
            local held = signatures[view.signature]
            serviceModule().dependentReturn(held.serviceSignature, view.owner)
            need(
                view.signature.owner == view.owner
                and held.call == nil
                and contract.source == view.source
                and contract.target == view.target
                and view.source ~= view.target
                and sameValue(view.source, view.target)
                and origins[view.target].dependency == origins[view.source].dependency
                and origins[view.target].transport == origins[view.source].transport
                and origins[view.target].phi == nil
                and not localOrigins[view.source]
                and not localOrigins[view.target]
                and returnValue(view.signature, view.source),
                "dependent return identity or backing changed"
            )
        elseif view.mode == "builderreturn" then
            local checked = serviceModule().validatebuilderreturn(view.proof, view.owner, contract.source, view.node)
            need(
                contract.source == view.source
                and contract.target == view.target
                and checked == view.checked
                and origins[contract.target].ownerSource == view.origin,
                "Builder return ownership view changed"
            )
        elseif view.mode == "arenaReturn" then
            local checked = serviceModule().validateArenaReturn(view.proof, view.owner, contract.source, view.node)
            need(
                contract.source == view.source
                and contract.target == view.target
                and checked == view.checked
                and contract.source.checkedType == view.sourceType
                and contract.target.context == contract.source.context
                and contract.target.pointee == contract.source.pointee
                and origins[contract.target].ownerSource == view.origin,
                "Arena return ownership view changed"
            )
        elseif view.mode == "owner" then
            local evidence = ownerEvidence(view.owner, contract.source, view.node, view.signature)
            if view.callSignature then
                validateSignature(view.callSignature)
                local call = signatures[view.callSignature]
                need(
                    call.caller == view.owner
                    and call.call.args.exprs[view.argument] == view.node
                    and borrowingParameter(view.callSignature, view.argument)
                    and argument(view.callSignature.params[view.argument], contract.target),
                    "owning borrowed call occurrence differs"
                )
            end
            sameRecord(evidence, view.evidence)
            need(
                contract.source.checkedType == view.sourceType
                and view.checked == require("nupp.compiler.types").borrowed(view.sourceType.inner)
                and contract.target.context == contract.source.context
                and contract.target.pointee == contract.source.pointee
                and origins[contract.target].ownerBorrow == contract
                and #origins[contract.target].dependency.keys == 1
                and origins[contract.target].dependency.keys[1] == evidence.definition,
                "owner projection changed"
            )
        elseif view.mode == "binding" then
            need(
                bindingExpression(view.owner, view.node, view.definition, view.sourceType) == view.expression
                and view.definition.type == view.checked
                and view.expression.inferredType == view.sourceType
                and contract.source.checkedType == view.sourceType
                and widening(contract.source, contract.target)
                and sameDependency(origins[contract.source].dependency, origins[contract.target].dependency)
                and localOrigins[contract.source] == localOrigins[contract.target]
                and origins[contract.source].transport == origins[contract.target].transport,
                "optional binding occurrence changed"
            )
        elseif view.mode == "optionalBorrow" then
            need(
                require("nupp.compiler.vm.nativeunit").checkedOccurrenceType(view.owner, view.node) == view.checked,
                "optional borrowed checked type differs"
            )
            need(
                contract.source == view.source
                and contract.target == view.target
                and view.node.kind == "name"
                and view.node.token.definition == view.definition
                and optionalBorrowShape(contract.source, contract.target, view.definition)
                and origins[contract.source].dependency == view.dependency
                and origins[contract.target].dependency == view.dependency
                and sameDependency(view.dependency, view.roots)
                and origins[contract.source].field == origins[contract.target].field
                and origins[contract.source].transport == origins[contract.target].transport
                and origins[contract.source].ownerSource == origins[contract.target].ownerSource
                and origins[contract.source].ownerBorrow == origins[contract.target].ownerBorrow
                and localOrigins[contract.source] == localOrigins[contract.target],
                "optional borrowed occurrence changed"
            )
        elseif view.mode == "nonnull" then
            need(
                view.node.kind == "name"
                and view.node.token.definition == view.definition
                and contract.source.nullable
                and not contract.target.nullable
                and contract.source.pointee == contract.target.pointee
                and sameDependency(origins[contract.source].dependency, origins[contract.target].dependency)
                and localOrigins[contract.source] == localOrigins[contract.target]
                and origins[contract.source].transport == origins[contract.target].transport,
                "nonnull occurrence changed"
            )
        elseif view.mode == "nil" then
            if view.contextual then
                validateSignature(view.signature)
                local held = signatures[view.signature]
                require("nupp.compiler.vm.nativeunit").occurrence(view.owner, view.site)
                need(
                    view.node == view.expression
                    and view.node.kind == "nilExpr"
                    and view.node.inferredType == view.nilType
                    and view.nilType.tag == "nil"
                    and contract.target.nullable
                    and #contract.target.ownership == 0,
                    "contextual nil occurrence changed"
                )
                if view.contextual == "argument" then
                    need(
                        held.caller == view.owner
                        and held.call == view.site
                        and held.call.args.exprs[view.index] == view.node
                        and held.checked.params[view.index] == view.checked
                        and argument(view.signature.params[view.index], contract.target),
                        "contextual nil call binding changed"
                    )
                else
                    need(
                        view.contextual == "return"
                        and held.owner == view.owner
                        and held.call == nil
                        and view.site.kind == "returnStmt"
                        and #view.site.exprs == 1
                        and view.site.exprs[1] == view.node
                        and held.checked.rets[1] == view.checked
                        and returnValue(view.signature, contract.target),
                        "contextual nil return binding changed"
                    )
                end
            else
                need(
                    view.node.kind == "castExpr"
                    and view.node.expr == view.expression
                    and view.expression.kind == "nilExpr"
                    and contract.target.nullable,
                    "typed nil occurrence changed"
                )
            end
        elseif view.mode == "address" then
            need(
                view.node.obj == view.callee
                and view.node.unsafeOwnershipOperation == "borrowed pointer passed to a plain parameter"
                and view.callee.inferredType == view.signature
                and view.callee.name.definition == view.definition
                and view.callee.name.text == "address"
                and view.callee.obj.token.definition == view.moduleDefinition
                and view.moduleDefinition.requiredModule == "nupp.runtime.vm.intrinsics"
                and view.signature.params == view.params
                and view.signature.rets == view.rets
                and #view.params == 1
                and #view.rets == 1
                and view.params[1] == view.parameter
                and view.rets[1] == view.result
                and view.parameter.tag == "voidptr"
                and view.result.tag == "uint64"
                and view.node.args.exprs[1] == view.expression
                and #view.node.args.exprs == 1
                and view.expression.inferredType == contract.source.checkedType
                and not contract.source.nullable
                and #contract.source.ownership == 1
                and contract.source.ownership[1].tag == "borrowed"
                and dependent(contract.source)
                and contract.target.machineKind == "uint64",
                "borrowed address occurrence changed"
            )
        else
            need(
                view.mode == "borrow"
                and view.node.ownershipIntrinsic == "borrowFrom"
                and view.node.args.exprs[1] == view.expression
                and view.node.args.exprs[2] == view.root
                and view.root.token.definition == view.definition
                and view.expression.inferredType == contract.source.checkedType
                and #contract.source.ownership == 0
                and #contract.target.ownership == 1
                and contract.target.ownership[1].tag == "borrowed"
                and contract.source.storageType == contract.target.storageType,
                "borrowFrom occurrence changed"
            )
            need(dependent(contract.target), "borrowFrom dependency missing")
        end
        return true
    end
    local held = need(casts[contract], "unknown checked pointer cast")
    if #contract.source.ownership ~= 0 then
        require("nupp.compiler.vm.nativeunit").occurrence(held.owner, held.node)
    end
    need(getmetatable(contract) == nil, "issued physical record metatable changed")
    need(
        contract.source == held.source and contract.target == held.target and contract.node == held.node,
        "pointer cast identity changed"
    )
    need(
        held.node.kind == "castExpr"
        and held.node.expr == held.expression
        and held.expression.inferredType == held.sourceType
        and held.node.inferredType == held.targetType,
        "pointer cast checked types changed"
    )
    validate(contract.source)
    validate(contract.target)
    need(
        not contract.source.nullable
        and #contract.source.ownership == #contract.target.ownership
        and sameDependency(origins[contract.source].dependency, origins[contract.target].dependency)
        and origins[contract.source].managed == origins[contract.target].managed,
        "pointer cast capability changed"
    )
    need(
        contract.source.checkedType == held.sourceType
        and contract.target.checkedType == held.targetType
        and contract.source.context == contract.target.context
        and (
            localOrigins[contract.source] ~= nil
            or contract.source.storageBytes == contract.target.storageBytes
            and contract.source.layout.alignment == contract.target.layout.alignment
        ),
        "pointer cast representation changed"
    )

    local localOwner = localOrigins[contract.source]
    if localOwner then
        validateLocal(localOwner)
        need(
            localOrigins[contract.target] == localOwner
            and contract.target.storageType.tag == "ptr"
            and contract.target.pointee == localOwner.checkedType,
            "local address origin changed"
        )
    end
    sameRecord(contract, held.fields)

    return true
end

-- Only an ordinary checked dependent call can supply an expression receiver.
-- Its private result snapshot must name this exact call, including after the
-- common walker transports a staged LHS through block parameters.
local function callReceiver(owner: any, receiver: any, call: any): (any, any, any)
    local unit = require("nupp.compiler.vm.nativeunit")
    unit.occurrence(owner, call)
    need(call.kind == "call" and call.ownershipIntrinsic == nil, "ordinary dependent receiver call required")
    local target = need(unit.callee(owner, call), "dependent receiver call lacks checked target")
    local actual, exported = unit.callSignature(owner, call, target)
    local checked = target.checkedSignature
    local parameter = checked and checked.borrowsParam
    need(
        checked
        and checked.tag == "func"
        and not checked.foreign
        and type(parameter) == "number"
        and parameter % 1 == 0
        and parameter >= 1
        and parameter <= #checked.params
        and checked.paramModes[parameter] == "borrows"
        and checked.borrowsResult == 1
        and #checked.rets == 1
        and #receiver.ownership == 1
        and receiver.ownership[1].tag == "borrowed",
        "single checked dependent receiver result required"
    )
    local dependency = origins[receiver].dependency
    need(
        dependency and dependency.node == call and sameDependency(dependency, rootSnapshot(call)),
        "borrowed receiver is not this checked call result"
    )

    return target, actual, exported
end

local function fieldContract(receiver: any, node: any, write: boolean, sig: any?, sourceOwner: any?): any
    validate(receiver)
    local borrowed = #receiver.ownership ~= 0
    local projected = borrowed and ownerReceiver(receiver, node.obj) or nil
    if projected then
        need(sourceOwner == nil or sourceOwner == projected, "owner receiver source differs")
        require("nupp.compiler.vm.nativeunit").occurrence(projected, node)
        if sig then
            validateSignature(sig)
            need(sig.owner == projected, "owner receiver signature differs")
        end
    elseif borrowed then
        local owner = sourceOwner or sig and sig.owner
        need(owner ~= nil, "qualified access requires checked owner")
        if sig then
            validateSignature(sig)
            need(sig.owner == owner, "qualified access owner/signature differs")
        end
        require("nupp.compiler.vm.nativeunit").occurrence(owner, node)
        need(
            node.obj and (node.obj.kind == "name" or node.obj.kind == "call") and dependent(receiver),
            "borrowed field requires checked rooted receiver"
        )
        local dependency = origins[receiver].dependency
        if node.obj.kind == "call" then
            callReceiver(owner, receiver, node.obj)
        elseif node.obj.capabilityFacts and node.obj.capabilityFacts.roots then
            need(sameDependency(dependency, rootSnapshot(node.obj)), "borrowed receiver roots differ")
        else
            need(sig ~= nil, "borrowed formal access requires checked signature")
            local parameter = nil
            for index, definition in ipairs(owner.parameterDefinitions) do
                if node.obj.token.definition == definition then
                    parameter = index
                end
            end
            need(
                parameter
                and borrowingParameter(sig, parameter)
                and pointerShape(sig.params[parameter], receiver)
                and sameDependency(dependency, origins[sig.params[parameter]].dependency),
                "borrowed receiver owner differs"
            )
        end
    end
    need(not receiver.nullable, "nullable access requires a checked nonnull refinement")
    local owner = receiver.pointee
    need(owner and owner.tag == "nominal" and owner.declKind == "struct", "typed struct pointer required")
    need(node and node.kind == "dotIndex" and node.obj and node.name, "checked direct field access required")
    need(projected or node.obj.inferredType == receiver.checkedType, "receiver checked type differs")
    if borrowed then
        need(node.unsafeOwnershipOperation == nil, "borrowed access cannot use unsafe ownership escape")
    else
        need(
            node.unsafeOwnershipOperation == "raw pointer dereference",
            "checked unsafe pointer access required: " .. node.name.text .. " write=" .. tostring(
                write
            ) .. " marker=" .. tostring(node.unsafeOwnershipOperation)
        )
    end
    need((node.assignmentTarget == true) == write, "read/write access differs")
    if write then
        need(node.fixedWidthPhysicalStore == true, "checked physical store required")
    end
    local name = node.name.text
    local definitions = write and owner.writeFieldDefs or owner.fieldDefs
    local declaration = need(definitions and definitions[name], "field permission is absent")
    need(node.name.definition == declaration, "field declaration identity differs")
    local fields = write and owner.writeByname or owner.byname
    local storage = need(fields and fields[name], "field storage type is absent")
    need(not declaration.bitWidth, "bitfield access is unsupported")
    local described = describe(receiver.context, storage)
    need(#described.ownership == 0, "qualified field requires a lifetime permission proof")
    local expected = write and storage or fixed.loaded(storage)
    need(node.resolvedType == expected, "checked field result type differs: " .. name)
    local layout, why = targetLayout.of(owner, receiver.context.target)
    need(layout, why or "pointee has no target layout")
    local member = nil
    for _, field in ipairs(layout.fields) do
        if field.name == name then
            member = field
            break
        end
    end
    need(member and not member.bitWidth, "field lacks whole-scalar layout")
    need(member.size == described.storageBytes, "field storage width differs")
    need(member.offset >= 0 and member.offset + member.size <= layout.size, "field lies outside pointee layout")

    return {
        receiver = receiver,
        node = node,
        borrowSignature = borrowed and sig or nil,
        declaration = declaration,
        name = name,
        storage = described,
        valueType = expected,
        write = write,
        offset = member.offset,
        width = member.size,
        alignment = member.alignment,
        signed = described.signed,
        layout = layout
    }
end

export function field(receiver: any, node: any, write: boolean, sig: any?, owner: any?): any
    local sourceOwner = owner or sig and sig.owner
    local access = fieldContract(receiver, node, write, sig, sourceOwner)
    if access.storage.machineKind == "voidptr" then
        require("nupp.compiler.vm.nativeunit").occurrence(sourceOwner, node)
        origins[access.storage].field = access
    end
    local callTarget, callSignature, callExport
    if #receiver.ownership ~= 0 and node.obj.kind == "call" then
        callTarget, callSignature, callExport = callReceiver(sourceOwner, receiver, node.obj)
    end
    accesses[
        access
    ] = {
        receiver = receiver,
        node = node,
        owner = sourceOwner,
        object = node.obj,
        token = node.name,
        write = write,
        signature = sig,
        callTarget = callTarget,
        callSignature = callSignature,
        callExport = callExport,
        receiverRoots = #receiver.ownership ~= 0
        and (node.obj.kind == "call" or node.obj.capabilityFacts and node.obj.capabilityFacts.roots)
        and rootSnapshot(node.obj)
        or nil,
        name = access.name,
        declaration = access.declaration,
        fields = recordFields(access)
    }

    return access
end

-- A staged LHS keeps its original checked field permission. Resuming it
-- through a phi needs a new exact receiver contract, not same-type authority.
-- verifyTransport checks the actual incoming SSA paths after the CFG closes.
export function rebindField(g: any, access: any, receiver: any): any
    validateField(access)
    if receiver == access.receiver then
        return access
    end
    need(
        access.write and receiver and compatibleTransport(access.receiver, receiver),
        "physical store receiver identity differs"
    )
    local origin = origins[receiver]
    need(origin.phi and origin.transport.graph[1] == g, "physical store receiver lacks held transport")
    local held = accesses[access]
    local rebound = field(receiver, held.node, held.write, held.signature, held.owner)
    accesses[rebound].transport = {graph = setmetatable({g}, {__mode = "v"}), source = access}

    return rebound
end

export function validateField(access: any): boolean
    local held = need(accesses[access], "unknown physical field contract")
    if access.storage.machineKind == "voidptr" then
        require("nupp.compiler.vm.nativeunit").occurrence(held.owner, held.node)
    end
    need(getmetatable(access) == nil, "issued physical record metatable changed")
    need(held.node.obj == held.object and held.node.name == held.token, "checked field expression identity changed")
    if held.receiverRoots then
        validateRoots(held.receiverRoots)
    end
    if held.callTarget then
        local target, sig, exported = callReceiver(held.owner, held.receiver, held.object)
        need(
            target == held.callTarget and sig == held.callSignature and exported == held.callExport,
            "dependent field call binding changed"
        )
    end
    local expected = fieldContract(held.receiver, held.node, held.write, held.signature, held.owner)
    need(expected.name == held.name and expected.declaration == held.declaration, "checked member identity changed")
    for _, key in ipairs({
        "receiver",
        "node",
        "borrowSignature",
        "declaration",
        "name",
        "valueType",
        "write",
        "offset",
        "width",
        "alignment",
        "signed"
    }) do
        need(access[key] == expected[key], "field " .. key .. " changed")
    end
    need(same(access.storage, expected.storage), "field storage type changed")
    need(sameLayout(access.layout, expected.layout), "field layout changed")
    sameRecord(access, held.fields)
    if held.transport then
        local source = held.transport.source
        validateField(source)
        need(
            held.transport.graph[1] ~= nil
            and source.node == access.node
            and source.write
            and access.write
            and compatibleTransport(source.receiver, access.receiver),
            "captured field source differs"
        )
    end

    return true
end

-- Fixed scalar locals are private helper-arena storage, never heap objects.
-- Checked CST/type objects are immutable borrows from the issuing compilation.
local function localRecipe(owner: any, context: any, node: any): any
    need(
        owner
        and owner.node
        and owner.node.body == owner.body
        and owner.scope.functions[owner.name] == owner
        and owner.checkedSignature == owner.body.signatureType,
        "local construction requires exact checked owner"
    )
    need(node and node.kind == "newExpr" and construction.plain(node.call), "checked construction required")
    local call, checked = node.call, node.inferredType
    need(
        checked
        and checked.tag == "nominal"
        and checked.declKind == "struct"
        and call.inferredType == checked
        and call.structConstruct
        and not call.constructorEntry
        and not call.constructorCall,
        "plain checked struct construction required"
    )
    need(not checked.constructors or #checked.constructors == 0, "custom constructor unsupported")
    local layout, why = targetLayout.of(checked, context.target)
    need(layout, why or "local lacks target layout")
    need(
        layout.size > 0 and layout.size <= 4096 and layout.alignment > 0 and layout.alignment <= 16,
        "local extent/alignment exceeds helper bound"
    )
    local fields, byname = {}, {}
    for index, slot in ipairs(layout.fields) do
        local storage = checked.byname and checked.byname[slot.name]
        need(
            storage
            and fixed.isPhysical(storage)
            and not qualifiers[storage.tag]
            and not slot.bitWidth
            and not slot.bitOffset,
            "local requires whole fixed scalar fields"
        )
        local scalar = describe(context, storage)
        need(
            slot.size == scalar.storageBytes and slot.offset >= 0 and slot.offset + slot.size <= layout.size,
            "local scalar layout differs"
        )
        fields[index] = {name = slot.name, offset = slot.offset, width = slot.size, storage = storage}
        byname[slot.name] = fields[index]
    end
    need(#fields > 0 and #fields <= 64, "local field count exceeds bound")
    local bindings, params, nodes, seen = {}, {}, {}, {}
    need(type(call.recordFields) == "table", "checked constructor field order required")
    for index, given in ipairs(call.recordFields) do
        local slot = need(byname[given.name], "initializer field absent from layout")
        need(not seen[given.name], "duplicate physical initializer")
        seen[given.name] = true
        local expression = need(given.node or given.defaultValue, "initializer expression absent")
        local source = need(expression.inferredType, "checked initializer type absent")
        while source.tag == "literal" or source.tag == "const" do
            source = source.tag == "literal" and source.base or source.inner
        end
        local kind = source.tag
        if kind == "integer" then
            need(
                expression.kind == "number"
                and expression.inferredType.tag == "literal"
                and type(expression.inferredType.constant) == "number"
                and fixed.physicalLiteralFits(expression.inferredType.constant, slot.storage),
                "narrow local initializer requires checked literal"
            )
            kind = slot.storage.tag:sub(1, 4) == "uint" and "uint64" or "int64"
        end
        need(
            kind == "int64"
            or kind == "uint64"
            or kind == "float32"
            or kind == "float64"
            or kind == "int32"
            or kind == "uint32",
            "unsupported local initializer representation"
        )
        local storageFloat = slot.storage.tag == "float32" or slot.storage.tag == "float64"
        local sourceFloat = kind == "float32" or kind == "float64"
        need(
            storageFloat == sourceFloat and (not storageFloat or kind == slot.storage.tag),
            "physical local initializer needs explicit numeric conversion"
        )
        bindings[
            index
        ] = {
            name = slot.name,
            offset = slot.offset,
            width = slot.width,
            storage = slot.storage,
            node = expression,
            binding = given
        }
        params[index], nodes[index] = kind, expression
    end

    return {
        owner = owner,
        context = context,
        node = node,
        checkedType = checked,
        layout = layout,
        fields = fields,
        bindings = bindings,
        params = params,
        nodes = nodes,
        result = "voidptr"
    }
end

export function localConstruction(owner: any, context: any, node: any): any
    local contract = localRecipe(owner, context, node)
    local descriptor = describe(context, contract.checkedType)
    contract.descriptor = descriptor
    constructions[
        contract
    ] = {owner = owner, context = context, node = node, descriptor = descriptor, fields = recordFields(contract)}
    localOrigins[descriptor] = contract

    return contract
end

export function validateLocal(contract: any): boolean
    local held = need(constructions[contract], "unknown local construction")
    sameRecord(contract, held.fields)
    local expected = localRecipe(held.owner, held.context, held.node)
    for _, key in ipairs({"owner", "context", "node", "checkedType", "result"}) do
        need(contract[key] == expected[key], "local construction identity changed")
    end
    need(
        contract.descriptor == held.descriptor and localOrigins[held.descriptor] == contract,
        "local descriptor identity changed"
    )
    need(sameLayout(contract.layout, expected.layout), "local layout changed")
    for _, key in ipairs({"fields", "bindings", "params", "nodes"}) do
        need(type(contract[key]) == "table" and #contract[key] == #expected[key], "local recipe extent changed")
        for index, item in ipairs(expected[key]) do
            local actual = contract[key][index]
            if key == "fields" or key == "bindings" then
                need(type(actual) == "table", "local field recipe changed")
                for name, value in pairs(item) do
                    need(actual[name] == value, "local field recipe identity changed")
                end
            else
                need(actual == item, "local operand recipe changed")
            end
        end
    end

    return true
end

export function localOrigin(descriptor: any): any
    validate(descriptor)
    local contract = localOrigins[descriptor]
    if contract then
        validateLocal(contract)
    end

    return contract
end

export function fieldOrigin(descriptor: any): any
    validate(descriptor)
    local access = origins[descriptor].field
    if access then
        validateField(access)
    end

    return access
end

export function validateFieldOwner(access: any, source: any): nil
    validateField(access)
    local owner = accesses[access].owner
    if owner then
        need(
            source
            and source.path == owner.scope.path
            and source.module == owner.scope.name
            and source.name == owner.name,
            "field result graph owner differs"
        )
    end
end

-- A retained borrowed store is the existing unsafe source assertion. This
-- contract checks its exact occurrence, types and roots, not arena outlives.
export function store(access: any, owner: any, rhs: any, descriptor: any?): any
    validateField(access)
    require("nupp.compiler.vm.nativeunit").occurrence(owner, rhs)
    need(access.write and access.storage.machineKind == "voidptr", "checked pointer field store required")
    local zero = rhs.kind == "nilExpr"
    if zero then
        need(
            descriptor == nil and access.storage.nullable and rhs.inferredType.tag == "nil",
            "nil store requires optional pointer field"
        )
    else
        validate(descriptor)
        need(
            descriptor.checkedType == rhs.inferredType and pointerShape(access.storage, descriptor),
            "pointer store representation differs"
        )
        need(
            #descriptor.ownership == 0
            or #descriptor.ownership == 1
            and descriptor.ownership[1].tag == "borrowed"
            and dependent(descriptor)
            and rhs.unsafeOwnershipOperation == "borrowed pointer stored through a reference",
            "borrowed field retention requires checked unsafe store"
        )
    end
    local dependency = descriptor and origins[descriptor].dependency or nil
    local roots, formal = nil, nil
    if dependency then
        if rhs.capabilityFacts and rhs.capabilityFacts.roots then
            roots = rootSnapshot(rhs)
            need(sameDependency(dependency, roots), "stored pointer roots differ")
        else
            need(
                rhs.kind == "name" and #dependency.keys == 1 and rhs.token.definition == dependency.keys[1],
                "stored formal root differs"
            )
            for index, definition in ipairs(owner.parameterDefinitions) do
                if definition == rhs.token.definition and owner.parameterModes[index] == "borrows" then
                    formal = definition
                end
            end
            need(formal, "stored borrowed expression roots required")
        end
    end
    local proof = {field = access, source = descriptor, node = rhs}
    stores[
        proof
    ] = {
        owner = owner,
        node = rhs,
        checked = rhs.inferredType,
        zero = zero,
        unsafe = rhs.unsafeOwnershipOperation,
        roots = roots,
        formal = formal,
        fields = recordFields(proof)
    }

    return proof
end

export function validateStore(proof: any): boolean
    local held = need(stores[proof], "unknown checked pointer store")
    sameRecord(proof, held.fields)
    require("nupp.compiler.vm.nativeunit").occurrence(held.owner, held.node)
    validateField(proof.field)
    need(
        proof.field.write
        and proof.field.storage.machineKind == "voidptr"
        and proof.node == held.node
        and held.node.inferredType == held.checked
        and held.node.unsafeOwnershipOperation == held.unsafe,
        "checked pointer store changed"
    )
    if held.zero then
        need(
            proof.source == nil
            and held.node.kind == "nilExpr"
            and held.checked.tag == "nil"
            and proof.field.storage.nullable,
            "checked nil store changed"
        )
    else
        validate(proof.source)
        need(
            proof.source.checkedType == held.checked and pointerShape(proof.field.storage, proof.source),
            "pointer store representation changed"
        )
        if held.roots or held.formal then
            local dependency = origins[proof.source].dependency
            if held.roots then
                validateRoots(held.roots)
            end
            need(
                held.unsafe == "borrowed pointer stored through a reference"
                and (
                    held.roots and sameDependency(dependency, held.roots)
                    or held.formal
                    and held.node.kind == "name"
                    and held.node.token.definition == held.formal
                    and dependency
                    and #dependency.keys == 1
                    and dependency.keys[1] == held.formal
                ),
                "stored pointer root/permission changed"
            )
        else
            need(#proof.source.ownership == 0, "pointer store loses borrowed permission")
        end
    end

    return true
end

export function storeValue(proof: any, access: any, descriptor: any?, source: any): boolean
    validateStore(proof)
    local owner = stores[proof].owner
    return proof.field == access
        and proof.source == descriptor
        and source.path == owner.scope.path
        and source.module == owner.scope.name
        and source.name == owner.name
end

export function nilStore(proof: any): boolean
    validateStore(proof)
    return stores[proof].zero
end

export function booleanField(access: any): boolean
    validateField(access)
    need(
        access.storage.storageType.tag == "boolean"
        and access.valueType.tag == "boolean"
        and access.width == 1
        and not access.signed,
        "exact Boolean field required"
    )

    return true
end

-- Only existing issuers can place records in these private maps. Retaining a
-- record borrows its checked objects; it neither copies them nor issues a call,
-- storage, mapping or lifetime permission to an unrecognized table.
export function retainIssued(value: any): any
    if type(value) ~= "table" then
        return nil
    end
    if accesses[value] then
        validateField(value)
    elseif casts[value] or views[value] then
        validateCast(value)
    elseif signatures[value] then
        validateSignature(value)
    elseif stores[value] then
        validateStore(value)
    elseif constructions[value] then
        validateLocal(value)
    else
        return nil
    end

    return value
end

-- Keep storage width separate from the value produced by a checked load.
local integerStorage = {
    int8 = true,
    uint8 = true,
    int16 = true,
    uint16 = true,
    int32 = true,
    uint32 = true,
    int64 = true,
    uint64 = true
}

export function integerField(access: any): string
    validateField(access)
    need(integerStorage[access.storage.storageType.tag], "physical field requires integer storage")
    local kind = fixed.loaded(access.storage.storageType).tag
    need(
        kind == "int32" or kind == "uint32" or kind == "int64" or kind == "uint64",
        "physical field requires an exact projected integer"
    )

    return kind
end
