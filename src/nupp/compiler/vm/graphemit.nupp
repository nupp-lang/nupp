module nupp.compiler.vm.graphemit

--[[
The image of a finished lowering: every function's closed-block graph,
encoded beside the header the image carries (shapes, modules, entry), and
the listing inspection shows of a function, which is the stream the runtime
derives from its graph.
]]

local convert = require("nupp.compiler.vm.convert")
local G = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")

local graphemit = {}

--- The image's shape table as the graph codec takes it: slot types by
--- name, a record slot naming its shape's index, and the identity a shape
--- of a module's own record carries.
function graphemit.shapes(order: {any}): {any}
    local shapes = {}
    for i, shape in ipairs(order) do
        local slots = {}
        for j, slot in ipairs(shape.slots) do
            local ty = slot.ty as string
            local record = ty:match("^rec:(%d+)$")
            slots[j] = {name = slot.name, type = record and "rec" or ty, record = record and tonumber(record) or nil}
        end
        local identity = shape.module and shape.module .. ":" .. shape.name
        if identity and not shape.physical and identity:find("^[%w_.]+:[%w_]+$") then
            shapes[i] = {name = shape.name, identity = identity, slots = slots}
        else
            shapes[i] = {name = shape.name, slots = slots}
        end
    end

    return shapes
end

--- The image of `functions` under `header` (`shapes` in allocation order,
--- `modules` with each one's chunk and path, `entry`). Each function is
--- converted, handed to `seen` with what was kept of it, encoded, and its
--- blocks and constants let go: what the lowering built shrinks as the image
--- grows.
--- @raises string when a function's blocks do not convert or a kernel's
--- graph does not verify.
function graphemit.image(functions: {any}, header: any, seen: (function(f: any, kept: any): nil)?): string
    local encoder = graphimage.encoder()
    for i = 1, #functions do
        local f = functions[i]
        local kept = convert.blocks(f)
        if seen then
            seen(f, kept)
        end
        if kept.graph then
            encoder.add(kept.graph)
        else
            encoder.addRegisters(kept)
        end
        f.blocks, f.current, f.graph, f.consts, f.constIndex = {}, nil, nil, {}, {}
    end

    return encoder.finish({shapes = graphemit.shapes(header.shapes), modules = header.modules, entry = header.entry})
end

-- The stream the runtime derives from a register-form function, as
-- `graph::derive` lays it out: blocks in order, a jump to the next block
-- left out, a branch whose untaken target is next as one test.
local function derive(kept: any): any
    local code, starts, patches = {}, {}, {}
    local blocks = kept.blocks
    local box = kept.nparams + 1

    local function emit(...: any): nil
        code[#code + 1] = {...}
    end

    local function jump(target: integer): nil
        patches[#patches + 1] = {at = #code + 1, target = target, field = 2}
        emit("Jmp", 0)
    end

    for bi = 1, #blocks do
        local b = blocks[bi]
        starts[bi] = #code + 1
        for k = 1, #b.code do
            code[#code + 1] = b.code[k]
        end
        local t = b.term
        local kind, targets = t.kind, t.targets
        if kind == "jump" then
            if targets[1] ~= bi + 1 then
                jump(targets[1])
            end
        elseif kind == "branch" then
            local reg, integer = t.value % 256, t.value >= 256
            if not integer and targets[1] ~= bi + 1 and targets[2] == bi + 1 then
                patches[#patches + 1] = {at = #code + 1, target = targets[1], field = 3}
                emit("JmpIf", reg, 0)
            else
                patches[#patches + 1] = {at = #code + 1, target = targets[2], field = 3}
                emit(integer and "JmpIfIZero" or "JmpIfNot", reg, 0)
                if targets[1] ~= bi + 1 then
                    jump(targets[1])
                end
            end
        elseif kind == "returns" then
            emit("RetN", t.value, t.count)
        elseif kind == "raise" then
            emit("Raise", t.constant)
        elseif t.value == nil then
            emit("RetNil")
        else
            local class, reg = math.floor(t.value / 256), t.value % 256
            if class == 2 and kept.ret == "f" then
                emit("FRet", reg)
            elseif class == 2 then
                emit("FBox", box, reg)
                emit("Ret", box)
            elseif class == 1 then
                emit("IBox", box, reg)
                emit("Ret", box)
            else
                emit("Ret", reg)
            end
        end
    end
    for _, p in ipairs(patches) do
        code[p.at][p.field] = starts[p.target] - p.at - 1
    end

    return {code = code, consts = kept.constants, nregs = kept.registers[1], nfregs = kept.registers[2]}
end

-- Every byte outside printable ASCII is escaped, so a listing is ASCII text
-- whatever bytes a string constant holds.
local function quote(s: string): string
    return '"' .. s:gsub('[%c"\\\128-\255]', function(c: string): string
        return string.format("\\%03d", c:byte())
    end) .. '"'
end

--- What inspection shows of function `f`, given what was kept of it: its
--- instructions as the runtime derives them, each with its source line, and
--- the function's text in the image listing format.
function graphemit.listing(f: any, kept: any): any
    local derived = kept.graph and G.lower(kept.graph) or derive(kept)
    local lines: {
        string
    } = {
        (
            "function %s %d %d %d %d %s:%s%s"
        ):format(
            f.name:gsub("%s", "_"),
            f.id,
            f.nparams,
            derived.nregs,
            derived.nfregs,
            table.concat(f.sig or {}),
            f.ret or "v",
            f.vararg and " vararg" or ""
        )
    }
    if f.module then
        lines[#lines + 1] = "  source " .. f.module
    end
    for i, c in ipairs(derived.consts) do
        local value = c.value
        if c.kind == "str" then
            value = quote(value as string)
        elseif c.kind == "num" then
            value = ("%.17g"):format(value as number)
        end
        lines[#lines + 1] = ("  const %d %s %s"):format(i - 1, c.kind, tostring(value))
    end
    -- The source line of every instruction, run-length encoded: `L` for one
    -- instruction, `LxN` for N in a row, 0 where none is known.
    local runs: {string} = {}
    local runLine: integer?, runCount = nil, 0
    for _, ins in ipairs(derived.code) do
        local line = ins.line or 0
        if line == runLine then
            runCount = runCount + 1
        else
            if runLine then
                runs[#runs + 1] = runCount > 1 and (runLine .. "x" .. runCount) or tostring(runLine)
            end
            runLine, runCount = line, 1
        end
    end
    if runLine and not (#runs == 0 and runLine == 0) then
        runs[#runs + 1] = runCount > 1 and (runLine .. "x" .. runCount) or tostring(runLine)
        lines[#lines + 1] = "  lines " .. table.concat(runs, " ")
    end
    local instructions = {}
    for pc, ins in ipairs(derived.code) do
        local parts = {}
        for i, value in ipairs(ins as {any}) do
            parts[i] = type(value) == "number" and ("%.17g"):format(value as number) or tostring(value)
        end
        local text = table.concat(parts, " ")
        lines[#lines + 1] = "  " .. text
        instructions[pc] = {pc = pc - 1, op = ins[1], text = ("%04d %s"):format(pc - 1, text), line = ins.line}
    end
    lines[#lines + 1] = "end"

    return {
        name = f.name,
        what = f.parent and "function" or "chunk",
        instructions = instructions,
        image = table.concat(lines, "\n")
    }
end

export = graphemit
