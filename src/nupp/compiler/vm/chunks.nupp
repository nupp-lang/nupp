module nupp.compiler.vm.chunks

local parser = require("nupp.compiler.syntax.parser")
local lower = require("nupp.compiler.vm.lower")
local sourceLoader: any = nil

--- Lower a Lua chunk without assigning Nupp types to its dynamic tables.
--- @raises string when parsing or lowering fails.
export function image(source: string, filename: string?, environment: boolean?): string
    local path = filename or "=(loadstring)"
    local tree = parser.parse(source, path)
    assert(#tree.errors == 0, "chunk did not parse: " .. path)
    return lower.emit(
        "vm.chunk",
        {},
        function(name: string): string?
            return name == "vm.chunk" and path or nil
        end,
        function(_: string, _: string): table
            return tree.root
        end,
        environment
    )
end

--- The modules that add to Lua's own tables the Nupp members a plain chunk
--- reads, as the requires `metadata.expand` hoists load them for a checked
--- module: `os.monotonic` loads `os`'s, and a bare read of `os` might reach any
--- member, so it does too. `math` is the VM's own, as `legacylower` lowers a
--- checked module's reads of it.
---
--- Each is named below `nupp.runtime`, where every one of them lives, so the
--- require that loads it keeps a literal prefix and cannot reach the tools.
local function installers(root: any): {string}
    local found: {string} = {}
    local seen: {[string]: boolean} = {}
    local extensions: any = nil

    local function note(name: string, member: string?): nil
        if name == "math" then
            return
        end
        extensions = extensions or require("nupp.compiler.builtinextensions")
        local module: string? = extensions.installer(name, member)
        local below = module and module:match("^nupp%.runtime%.(.+)$")
        if below ~= nil and not seen[below] then
            seen[below] = true
            found[#found + 1] = below
        end
    end

    local function visit(node: any): nil
        if type(node) ~= "table" then
            return
        end
        local skip = nil
        if node.kind == "name" and node.token then
            note(node.token.text)
        elseif node.kind == "dotIndex" and node.obj and node.obj.kind == "name" and node.obj.token and node.name then
            note(node.obj.token.text, node.name.text)
            skip = node.obj
        end
        for _, child in ipairs(node) do
            if child ~= skip then
                visit(child)
            end
        end
    end

    visit(root)

    return found
end

--- Install source loading only in a host that exposes the image loader.
export function install(): boolean
    local loadImage = rawget(_G, "__nupp_load_image")
    if not loadImage then
        return false
    end

    local environments: any = setmetatable({}, {__mode = "k"})

    -- `mode` and `env` follow LuaJIT's `load(chunk, name, mode, env)`: only
    -- text is ever loaded here, and `env` stands in for a later `setfenv`.
    local function compileChunk(source: string, filename: string?, _: string?, env: table?): (any, string?)
        local path = filename or "=(loadstring)"
        local tree = parser.parse(source, path)
        if #tree.errors > 0 then
            return nil, "chunk did not parse: " .. path
        end
        -- The Lua backend loads generated text to validate its syntax. Native
        -- lowering is needed only if the returned function is actually called.
        local compiled = nil
        local context = {value = env or _G}
        local installs: {string}? = installers(tree.root)

        local function prepare()
            if not compiled then
                compiled = loadImage(image(source, path, true))
            end
        end

        local function chunk(...)
            -- Before the chunk's first run, as a checked module's hoisted
            -- requires run before its body.
            for _, below in ipairs(installs or {}) do
                require("nupp.runtime." .. below)
            end
            installs = nil
            prepare()

            return compiled(context, ...)
        end

        environments[chunk] = {context = context, prepare = prepare}

        return chunk, nil
    end

    rawset(_G, "setfenv", function(chunk: any, environment: table): any
        local entry = assert(environments[chunk], "setfenv requires a source-loaded chunk")
        assert(type(environment) == "table", "environment must be a table")
        entry.context.value = environment
        entry.prepare()

        return chunk
    end)
    rawset(_G, "getfenv", function(chunk: any): table
        local entry = environments[chunk]
        return entry and entry.context.value or _G
    end)

    rawset(_G, "__nupp_compile_chunk", compileChunk)
    rawset(_G, "loadfile", function(path: string, mode: string?, env: table?): (any, string?)
        local file, problem = io.open(path, "rb")
        if not file then
            -- Worded as Lua's, which callers search for to tell a missing file
            -- from a broken one: `cannot open <path>: <reason>`.
            local reason = tostring(problem)
                :gsub("^" .. path:gsub("%p", "%%%0") .. ": ", "")
                :gsub(" %(os error %d+%)$", "")
            return nil, "cannot open " .. path .. ": " .. reason
        end
        local source = file:read("*a")
        file:close()

        -- Lua names a file's chunk `@path`, which its errors print as given.

        return compileChunk(source, "@" .. path, mode, env)
    end)

    rawset(_G, "dofile", function(path: string): any
        local chunk, problem = assert(rawget(_G, "loadfile"))(path)
        assert(chunk, problem)
        return chunk()
    end)

    if not sourceLoader then
        sourceLoader = function(name: string): any
            local relative = name:gsub("%.", "/")
            local misses = {}
            for pattern in package.path:gmatch("[^;]+") do
                local path = pattern:gsub("%?", function(): string
                    return relative
                end)
                local file = io.open(path, "rb")
                if file then
                    local source = file:read("*a")
                    file:close()
                    local chunk, problem = compileChunk(source, "@" .. path)
                    assert(chunk, problem)
                    return chunk
                end
                misses[#misses + 1] = "\n\tno file '" .. path .. "'"
            end

            return table.concat(misses)
        end
        table.insert(package.loaders, sourceLoader)
    end

    return true
end
