module nupp.compiler.vm.nativeframecontract

-- Private build-time provenance. There is no owner/effect registration API.
-- Only build() can enter issuance, using the fixed producer's frozen source
-- snapshot. The host build source/filesystem is trusted. Borrowed checked CST
-- and type objects remain immutable, as in nativeunit; this is not a sandbox.
-- The closed producer must preserve Result/Code identity and use authenticated
-- selection/linking. Generic allocation/selection and raw machine words remain
-- available for legacy diagnostics; rebuilding unissued artifacts through them
-- does not carry this proof. This is not an authenticity scheme for raw bytes.
local contract = {}
local owners: any = setmetatable({}, {__mode = "k"})
local graphs: any = setmetatable({}, {__mode = "k"})
local markers: any = setmetatable({}, {__mode = "k"})
local sources: any = setmetatable({}, {__mode = "k"})
local current: any = nil
local probeModule = "nupp.runtime.core.framecontractprobe"
local negativeCases = {
    RejectNoState = "State has no successful",
    RejectSetupFailure = "State has no successful",
    RejectNoSuccess = "State has no successful",
    RejectWrongSuccess = "State has no successful",
    RejectOtherResult = "State has no successful",
    RejectStaleFrame = "invalidated frame",
    RejectStalePC = "invalidated frame",
    RejectStaleWindow = "invalidated frame",
    RejectStaleAlias = "invalidated frame",
    RejectPreparedAfterStore = "invalidated prepared",
    RejectWrongContext = "context identity differs",
    RejectJoinFailure = "State has no successful",
    RejectRefreshBeforePublish = "CODE_START was not refreshed",
    RejectUnknownCall = "State has no successful",
    RejectPreparedOffset = "invalidated frame",
    RejectJoinedFrame = "mixed or missing owner",
    RejectLoadedBeforePublish = "invalidated frame",
}

local paths = {
    {"nupp.runtime.core.arena", "native/core/src/nupp/runtime/core/arena.nupp"},
    {"nupp.runtime.core.frames", "native/core/src/nupp/runtime/core/frames.nupp"},
    {"nupp.runtime.core.context", "native/core/src/nupp/runtime/core/context.nupp"},
    {"nupp.runtime.core.frameaccess", "native/core/src/nupp/runtime/core/frameaccess.nupp"},
    {"nupp.runtime.vm.values", "src/nupp/runtime/vm/values.nupp"},
    {probeModule, "native/core/tests/frame-contract-probe.nupp"}
}

local function need(ok: any, message: string): any
    assert(ok, "native final frame: " .. message)
    return ok
end

local function read(path: string): string
    local file = assert(io.open(path, "rb"), "native final frame: missing frozen source: " .. path)
    local text = file:read("*a")
    file:close()
    return text
end

-- Graph columns contain plain data. Physical context and the issuance marker
-- are separately held by identity, never copied or turned into permissions.
local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    need(getmetatable(value) == nil, "graph seal requires plain records")
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item)
    end

    return result
end

local function same(actual: any, saved: any): boolean
    if type(actual) ~= "table" or type(saved) ~= "table" then
        return actual == saved
    end
    if getmetatable(actual) ~= nil then
        return false
    end
    for key, value in pairs(saved) do
        if not same(actual[key], value) then
            return false
        end
    end
    for key in pairs(actual) do
        if saved[key] == nil then
            return false
        end
    end

    return true
end

local function shape(g: any): any
    local result = {}
    for key, value in pairs(g) do
        if key ~= "nativeFinalFrame" and key ~= "nativePhysical" then
            result[key] = value
        end
    end

    return result
end

local function validateSource(state: any): nil
    need(read(state.snapshotPath) == state.snapshotText, "frozen build snapshot changed")
    for path, text in pairs(state.snapshot.sources) do
        need(read(state.root .. "/" .. path) == text, "reviewed source changed: " .. path)
    end
    need(state.unit.validate(), "sealed checked unit changed")
    if state.frames then
        local exports = state.frames.checkedExports
        need(
            exports.typeDefs.State == state.stateDefinition
            and exports.typeDefs.Frame == state.frameDefinition
            and exports.types.State == state.stateType
            and exports.types.Frame == state.frameType,
            "checked State/Frame identity changed"
        )
        local layout = require("nupp.compiler.targetlayout")
        need(
            same(layout.of(state.stateType, state.snapshot.target), state.stateLayout)
            and same(layout.of(state.frameType, state.snapshot.target), state.frameLayout),
            "checked State/Frame target layout changed"
        )
    end
end

-- Called by the ordinary native profile, only inside this producer's lowering
-- transaction. Reusing an issued owner outside it cannot mint another graph.
function contract.initialize(owner: any, g: any): nil
    local state = owners[owner]
    if not state then
        return
    end
    need(current and current.state == state and current.owner == owner, "owner outside closed construction")
    local marker = {}
    local held = {
        state = state,
        owner = owner,
        marker = marker,
        abi = g.native.abi,
        calls = {},
        final = state.finalOwners[owner] == true
    }
    graphs[g], markers[marker], g.nativeFinalFrame = held, g, marker
    current.graph = g
end

function contract.record(ctx: any, node: any, op: string, args: any): nil
    local held = graphs[ctx.g]
    if not held then
        return
    end
    need(current and current.graph == ctx.g and current.owner == ctx.fn, "operation outside closed construction")
    if op == "NativeLeafCall" then
        local unit = require("nupp.compiler.vm.nativeunit")
        local target = need(unit.callee(ctx.fn, node), "call lacks sealed checked declaration")
        need(owners[target] == held.state, "call target outside fixed source set")
        local index = #ctx.block.op
        held.calls[ctx.block] = held.calls[ctx.block] or {}
        held.calls[
            ctx.block
        ][
            index
        ] = {
            target = target,
            declaration = args[1],
            operands = copy(args),
            result = ctx.block.dst[index],
            role = held.state.roles[target]
        }
    end
end

function contract.finish(ctx: any): nil
    local held = graphs[ctx.g]
    if not held then
        return
    end
    need(current and current.graph == ctx.g, "finish outside closed construction")
    sources[ctx.g.source] = ctx.g
    held.physical, held.seal = ctx.g.nativePhysical, copy(shape(ctx.g))
    if held.physical then
        held.context, held.values, held.valueMap = held.physical.context, held.physical.values, {}
        for key, descriptor in pairs(held.values) do
            held.valueMap[key] = descriptor
        end
    end
    validateSource(held.state)
end

-- Always called by graph.verify. A marker is not the registry: removing it
-- from an issued graph or copying it to another graph is a refusal, not a
-- route back to the legacy FrameRecover verifier.
function contract.verify(g: any): boolean
    local held = graphs[g]
    if not held then
        need(g.nativeFinalFrame == nil and not sources[g.source], "copied final graph is unissued")
        need(not g.source or g.source.module ~= probeModule, "closed probe graph is unissued")
        return false
    end
    need(g.nativeFinalFrame == held.marker and markers[held.marker] == g, "final graph marker changed")
    need(g.native.abi == held.abi and held.owner.nativeABI == held.abi, "issued ABI changed")
    need(
        g.source
        and g.source.path == held.owner.scope.path
        and g.source.module == held.owner.scope.name
        and g.source.name == held.owner.name,
        "final graph source owner changed"
    )
    if held.seal then
        need(g.nativePhysical == held.physical and same(shape(g), held.seal), "issued graph changed")
        if held.physical then
            need(
                held.physical.context == held.context
                and held.physical.values == held.values
                and getmetatable(held.values) == nil,
                "issued physical context changed"
            )
            for key, descriptor in pairs(held.valueMap) do
                need(held.values[key] == descriptor, "issued physical value changed")
            end
            for key, descriptor in pairs(held.values) do
                need(held.valueMap[key] == descriptor, "issued physical value changed")
            end
        end
    else
        need(current and current.graph == g, "unsealed graph escaped construction")
    end
    for block, entries in pairs(held.calls) do
        need(g.blocks[block.id] == block, "call block changed")
        for index, call in pairs(entries) do
            need(
                block.op[index] == "NativeLeafCall"
                and block.dst[index] == call.result
                and block.args[index][1] == call.declaration
                and same(block.args[index], call.operands),
                "checked callsite changed"
            )
        end
    end
    if held.final then
        require("nupp.compiler.vm.nativeframeverify").verify(g, held.calls)
    end

    return held.final
end

function contract.requireOriginal(g: any, owner: any): boolean
    local held = graphs[g]
    if not held then
        need(not owners[owner], "issued owner requires its original graph")
        return false
    end
    need(held.owner == owner, "graph owner substitution")
    contract.verify(g)
    validateSource(held.state)

    return true
end

-- The checked context used to lower dispatch is part of the issued unit,
-- not interchangeable with a structurally compatible public scope record.
function contract.requireContext(g: any, owner: any, context: any): nil
    local held = need(graphs[g], "authenticated graph required")
    need(held.owner == owner and context == held.state.context, "checked context substitution")
end

function contract.target(g: any, owner: any, targetGraph: any, targetOwner: any): nil
    local held = need(graphs[g], "authenticated caller required")
    need(held.owner == owner and owners[targetOwner] == held.state, "callee unit differs")
    need(held.state.resolved[targetOwner] == targetGraph, "callee graph substitution")
    need(contract.requireOriginal(targetGraph, targetOwner), "authenticated callee required")
end

function contract.refuse(g: any, route: string): nil
    need(
        not graphs[g]
        and g.nativeFinalFrame == nil
        and not sources[g.source]
        and (not g.source or g.source.module ~= probeModule),
        route .. " does not carry final frame provenance"
    )
end

-- Fixed build input, not create(manifest, owners, effects). The dedicated
-- driver snapshots the reviewed sources before compiling this producer and
-- binds that snapshot/image/output in its receipt. No caller module list,
-- effect map, state parameter index or annotation can enter this function.
function contract.build(): any
    need(current == nil, "nested construction")
    local root = need(os.getenv("NUPP_COMPILER_ROOT"), "build source root required")
    local snapshotPath = root .. "/build/core-frame-contract/snapshot.json"
    local snapshotText = read(snapshotPath)
    local snapshot = require("nupp.codec.json").decode(snapshotText)
    need(snapshot.version == 1 and snapshot.target == "aarch64-apple-darwin", "fixed snapshot version/target")
    local requested = {}
    for index, entry in ipairs(paths) do
        need(snapshot.sources[entry[2]] == read(root .. "/" .. entry[2]), "canonical source snapshot differs")
        local path = entry[1] == probeModule
            and root .. "/build/core-frame-contract/source/nupp/runtime/core/framecontractprobe.nupp"
            or root .. "/" .. entry[2]
        need(read(path) == snapshot.sources[entry[2]], "staged reviewed module differs")
        requested[index] = {moduleName = entry[1], path = path}
    end
    for _, path in ipairs({"src/nupp/runtime/vm/intrinsics.d.nupp", "src/nupp/runtime/vm/values.nupp"}) do
        need(snapshot.sources[path] == read(root .. "/" .. path), "runtime source snapshot differs")
    end
    local unit = require("nupp.compiler.vm.nativeunit").session(root, requested, snapshot.target, {
        "src",
        "native/core/src",
        "build/core-frame-contract/source"
    })
    local state: any = {
        root = root,
        snapshotPath = snapshotPath,
        snapshotText = snapshotText,
        snapshot = snapshot,
        unit = unit,
        roles = {},
        resolved = {},
        finalOwners = {}
    }
    local scopes, all = {}, {}
    for _, entry in ipairs(paths) do
        local scope = unit.module(entry[1])
        scopes[entry[1]] = scope
        -- The existing values module supplies checked literal constants only.
        -- Its functions are not admitted as final-frame service bodies.
        if scope.name ~= "nupp.runtime.vm.values" then
            for name, owner in pairs(scope.functions) do
                owners[owner] = state
                all[#all + 1] = {name = scope.name .. "." .. name, owner = owner}
            end
        end
    end
    local frames = scopes["nupp.runtime.core.frames"]
    state.stateDefinition = need(frames.checkedExports.typeDefs.State, "checked State definition")
    state.frameDefinition = need(frames.checkedExports.typeDefs.Frame, "checked Frame definition")
    state.frames = frames
    state.stateType = need(frames.checkedExports.types.State, "checked State type")
    state.frameType = need(frames.checkedExports.types.Frame, "checked Frame type")
    local layout = require("nupp.compiler.targetlayout")
    state.stateLayout = copy(need(layout.of(state.stateType, snapshot.target), "State target layout"))
    state.frameLayout = copy(need(layout.of(state.frameType, snapshot.target), "Frame target layout"))
    state.context = scopes["nupp.runtime.core.context"]
    local probe = scopes[probeModule]
    state.probe = need(probe.exports.CoreFrameContract, "fixed handler declaration")
    state.finalOwners[state.probe] = true
    state.finalOwners[need(probe.exports.CoreFrameTrue, "fixed true-edge handler declaration")] = true
    for name in pairs(negativeCases) do
        state.finalOwners[need(probe.exports[name], "fixed negative handler declaration")] = true
    end
    state.roles[need(probe.exports.setup, "fixed setup declaration")] = "setup"
    state.roles[need(frames.exports.publish, "canonical publish declaration")] = "publish"
    local access = scopes["nupp.runtime.core.frameaccess"]
    for _, role in ipairs({"active", "values", "integers", "floats", "code", "pc", "refresh"}) do
        state.roles[need(access.exports[role], "checked accessor declaration")] = role
    end
    table.sort(all, function(a: any, b: any): boolean
        return a.name < b.name
    end)
    -- Like incremental.hostServices, defer compiler-only dependencies until
    -- this closed build entry runs. The dedicated producer statically includes
    -- both modules; graph verification alone must not enter this import cycle.
    local lowerName, profileName = "lower", "nativegraph"
    local lower: any = require("nupp.compiler.vm." .. lowerName)
    local profile: any = require("nupp.compiler.vm." .. profileName)
    local resolved, refusals = {}, {}
    for _, item in ipairs(all) do
        item.owner.nativeABI = state.finalOwners[item.owner] and "handler" or "leaf"
    end
    local ok, problem = pcall(function(): nil
        for _, item in ipairs(all) do
            current = {state = state, owner = item.owner}
            local abi = item.owner.nativeABI
            local expected = item.owner.scope == probe and negativeCases[item.owner.name]
            if expected then
                local passed, failure = pcall(function(): any
                    return lower.functionGraph(item.owner, unit.options(item.owner, abi), profile)
                end)
                need(
                    not passed and tostring(failure):find("native final frame: " .. expected, 1, true),
                    "negative body missed dataflow refusal: " .. item.name .. ": " .. tostring(failure)
                )
                refusals[#refusals + 1] = {name = item.owner.name, diagnostic = tostring(failure)}
            else
                local passed, g = pcall(function(): any
                    return lower.functionGraph(item.owner, unit.options(item.owner, abi), profile)
                end)
                need(passed, item.name .. ": " .. tostring(g))
                state.resolved[item.owner] = g
                resolved[item.name] = {graph = g, owner = item.owner}
            end
            current = nil
        end
        validateSource(state)
    end)
    current = nil
    need(ok, tostring(problem))

    return {
        resolved = resolved,
        context = state.context,
        probe = probeModule .. ".CoreFrameContract",
        refusals = refusals
    }
end

export = contract
