module nupp.compiler.vm.nativeframecontract

-- Private build-time provenance. There is no owner/effect registration API.
-- Only build() can enter issuance, using the fixed producer's frozen source
-- snapshot. The host build source/filesystem is trusted. Borrowed checked CST
-- and type objects remain immutable, as in nativeunit; this is not a sandbox.
-- The closed producer must preserve Result/Code identity and use authenticated
-- selection/linking. Generic allocation/selection and raw machine words remain
-- available for legacy diagnostics; rebuilding unissued artifacts through them
-- does not carry this proof. This is not an authenticity scheme for raw bytes.
local physical = require("nupp.compiler.vm.nativephysical")
local nativeos = require("nupp.compiler.vm.nativeos")
local service = require("nupp.compiler.vm.nativeservice")
local owners: any = setmetatable({}, {__mode = "k"})
local graphs: any = setmetatable({}, {__mode = "k"})
local markers: any = setmetatable({}, {__mode = "k"})
local sources: any = setmetatable({}, {__mode = "k"})
local current: any = nil
local probeModule = "nupp.runtime.core.framecontractprobe"
local returnModule = "nupp.runtime.core.returncontractprobe"
local guestModule = "nupp.runtime.core.guesthandlers"
local guestBuilds: any = setmetatable({}, {__mode = "k"})
local heapBuilds: any = setmetatable({}, {__mode = "k"})
local negativeCases = {
    RejectNoState = "State has no successful",
    RejectSetupFailure = "State has no successful",
    RejectNoSuccess = "State has no successful",
    RejectWrongSuccess = "State has no successful",
    RejectOtherResult = "State has no successful",
    RejectStaleFrame = "invalidated frame",
    RejectStalePC = "invalidated frame",
    RejectStaleWindow = "invalidated frame",
    RejectStaleAlias = "invalidated frame",
    RejectPreparedAfterStore = "invalidated prepared",
    RejectWrongContext = "context identity differs",
    RejectJoinFailure = "State has no successful",
    RejectRefreshBeforePublish = "CODE_START was not refreshed",
    RejectUnknownCall = "State has no successful",
    RejectPreparedOffset = "invalidated frame",
    RejectJoinedFrame = "mixed or missing owner",
    RejectLoadedBeforePublish = "invalidated frame",
}

local returnCases = {
    RejectReturnNoSuccess = "State has no successful",
    RejectReturnFailure = "invalidated frame",
    RejectReturnOtherResult = "State has no successful",
    RejectReturnWrongState = "State has no successful",
    RejectReturnStaleFrame = "invalidated frame",
    RejectReturnStaleWindow = "invalidated frame",
    RejectReturnStaleCode = "invalidated frame",
    RejectReturnStalePC = "invalidated frame",
    RejectReturnLoaded = "invalidated frame",
    RejectReturnSelectedLate = "invalidated frame",
    RejectReturnOldCaller = "invalidated frame",
    RejectReturnJoin = "State has no successful",
    RejectReturnWrongContext = "context identity differs",
    RejectReturnOldRefresh = "CODE_START was not refreshed",
    RejectReturnChildOffset = "invalidated frame",
    RejectReturnUnknownCall = "State has no successful",
}

local sharedPaths = {
    {"nupp.runtime.core.arena", "native/core/src/nupp/runtime/core/arena.nupp"},
    {"nupp.runtime.core.frames", "native/core/src/nupp/runtime/core/frames.nupp"},
    {"nupp.runtime.core.context", "native/core/src/nupp/runtime/core/context.nupp"},
    {"nupp.runtime.core.frameaccess", "native/core/src/nupp/runtime/core/frameaccess.nupp"},
    {"nupp.runtime.vm.values", "src/nupp/runtime/vm/values.nupp"}
}

local function need(ok: any, message: string): any
    assert(ok, "native final frame: " .. message)
    return ok
end

local function read(path: string): string
    local file = assert(io.open(path, "rb"), "native final frame: missing frozen source: " .. path)
    local text = file:read("*a")
    file:close()
    return text
end

-- Plain graph data is copied structurally. Issued physical contracts retain
-- their exact identity and revalidate their borrowed checked objects instead
-- of recursively traversing CST/type graphs. The issuance marker and physical
-- context remain separately held, never copied into permissions.
local function copy(value: any, active: any?): any
    if type(value) ~= "table" then
        return value
    end
    if nativeos.isIssued(value) then
        nativeos.validate(value);
        return value
    end
    if service.isIssued(value) then
        service.validateIssued(value);
        return value
    end
    local retained = physical.retainIssued(value)
    if retained then
        return retained
    end
    need(getmetatable(value) == nil, "graph seal requires plain records")
    local visiting = active or {}
    need(not visiting[value], "graph seal rejects unissued cyclic records")
    visiting[value] = true
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item, visiting)
    end
    visiting[value] = nil

    return result
end

local function same(actual: any, saved: any): boolean
    if type(actual) ~= "table" or type(saved) ~= "table" then
        return actual == saved
    end
    if nativeos.isIssued(saved) then
        nativeos.validate(saved)
        return actual == saved
    end
    if service.isIssued(saved) then
        service.validateIssued(saved)
        return actual == saved
    end
    -- Inspect the saved issued identity before the candidate's fields. A
    -- structural copy cannot substitute for the original proof object.
    local retained = physical.retainIssued(saved)
    if retained then
        return actual == retained
    end
    if physical.retainIssued(actual) or getmetatable(actual) ~= nil then
        return false
    end
    for key, value in pairs(saved) do
        if not same(actual[key], value) then
            return false
        end
    end
    for key in pairs(actual) do
        if saved[key] == nil then
            return false
        end
    end

    return true
end

local function shape(g: any): any
    local result = {}
    for key, value in pairs(g) do
        if key ~= "nativeFinalFrame" and key ~= "nativePhysical" then
            result[key] = value
        end
    end

    return result
end

local function guestExecutable(): any
    local name = "coregraphexecutable"
    return require("nupp.compiler.vm." .. name)
end

local function validateSource(state: any): nil
    if state.serviceCatalog then
        service.validateCatalog(state.serviceCatalog);
        return
    end
    need(read(state.snapshotPath) == state.snapshotText, "frozen build snapshot changed")
    for path, text in pairs(state.snapshot.sources) do
        need(read(state.root .. "/" .. path) == text, "reviewed source changed: " .. path)
    end
    need(state.unit.validate(), "sealed checked unit changed")
    if state.executable then
        guestExecutable().validate(state.executable)
    end
    if state.frames then
        local exports = state.frames.checkedExports
        need(
            exports.typeDefs.State == state.stateDefinition
            and exports.typeDefs.Frame == state.frameDefinition
            and exports.types.State == state.stateType
            and exports.types.Frame == state.frameType,
            "checked State/Frame identity changed"
        )
        local layout = require("nupp.compiler.targetlayout")
        need(
            same(layout.of(state.stateType, state.snapshot.target), state.stateLayout)
            and same(layout.of(state.frameType, state.snapshot.target), state.frameLayout),
            "checked State/Frame target layout changed"
        )
    end
end

-- Called by the ordinary native profile, only inside this producer's lowering
-- transaction. Reusing an issued owner outside it cannot mint another graph.
export function initialize(owner: any, g: any): nil
    local state = owners[owner]
    if not state then
        return
    end
    need(current and current.state == state and current.owner == owner, "owner outside closed construction")
    local marker = {}
    local held = {
        state = state,
        owner = owner,
        marker = marker,
        abi = g.native.abi,
        calls = {},
        final = state.finalOwners[owner] == true
    }
    graphs[g], markers[marker], g.nativeFinalFrame = held, g, marker
    current.graph = g
end

export function record(ctx: any, node: any, op: string, args: any): nil
    local held = graphs[ctx.g]
    if not held then
        return
    end
    need(current and current.graph == ctx.g and current.owner == ctx.fn, "operation outside closed construction")
    if op == "NativeLeafCall" then
        local unit = require("nupp.compiler.vm.nativeunit")
        local target = held.state.serviceCatalog and service.recordTarget(ctx.g, args[1], node)
            or need(unit.callee(ctx.fn, node), "call lacks sealed checked declaration")
        need(owners[target] == held.state, "call target outside fixed source set")
        local index = #ctx.block.op
        held.calls[ctx.block] = held.calls[ctx.block] or {}
        held.calls[
            ctx.block
        ][
            index
        ] = {
            target = target,
            declaration = args[1],
            operands = copy(args),
            result = ctx.block.dst[index],
            role = held.state.roles[target]
        }
    end
end

export function finish(ctx: any): nil
    local held = graphs[ctx.g]
    if not held then
        return
    end
    need(current and current.graph == ctx.g, "finish outside closed construction")
    sources[ctx.g.source] = ctx.g
    held.physical, held.seal = ctx.g.nativePhysical, copy(shape(ctx.g))
    if held.physical then
        held.context, held.values, held.valueMap = held.physical.context, held.physical.values, {}
        held.signature = physical.retainIssued(held.physical.signature)
        need(held.signature == held.physical.signature, "physical signature is unissued")
        for key, descriptor in pairs(held.values) do
            held.valueMap[key] = descriptor
        end
    end
    validateSource(held.state)
end

-- Always called by graph.verify. A marker is not the registry: removing it
-- from an issued graph or copying it to another graph is a refusal, not a
-- route back to the legacy FrameRecover verifier.
export function verify(g: any): boolean
    local held = graphs[g]
    if not held then
        need(g.nativeFinalFrame == nil and not sources[g.source], "copied final graph is unissued")
        need(
            not g.source
            or service.isUnitModule(g.source.module)
            or (g.source.module ~= probeModule and g.source.module ~= returnModule and g.source.module ~= guestModule),
            "closed probe graph is unissued"
        )
        return false
    end
    need(g.nativeFinalFrame == held.marker and markers[held.marker] == g, "final graph marker changed")
    need(g.native.abi == held.abi and held.owner.nativeABI == held.abi, "issued ABI changed")
    need(
        g.source
        and g.source.path == held.owner.scope.path
        and g.source.module == held.owner.scope.name
        and g.source.name == held.owner.name,
        "final graph source owner changed"
    )
    if held.seal then
        need(g.nativePhysical == held.physical and same(shape(g), held.seal), "issued graph changed")
        if held.physical then
            need(
                held.physical.context == held.context
                and held.physical.signature == held.signature
                and physical.retainIssued(held.signature) == held.signature
                and held.physical.values == held.values
                and getmetatable(held.values) == nil,
                "issued physical context changed"
            )
            for key, descriptor in pairs(held.valueMap) do
                need(held.values[key] == descriptor, "issued physical value changed")
            end
            for key, descriptor in pairs(held.values) do
                need(held.valueMap[key] == descriptor, "issued physical value changed")
            end
        end
    else
        need(current and current.graph == g, "unsealed graph escaped construction")
    end
    for block, entries in pairs(held.calls) do
        need(g.blocks[block.id] == block, "call block changed")
        for index, call in pairs(entries) do
            need(
                block.op[index] == "NativeLeafCall"
                and block.dst[index] == call.result
                and block.args[index][1] == call.declaration
                and same(block.args[index], call.operands),
                "checked callsite changed"
            )
        end
    end
    if held.final then
        require("nupp.compiler.vm.nativeframeverify").verify(g, held.calls, held.state.guestEntry)
    end

    return held.final
end

export function requireOriginal(g: any, owner: any): boolean
    local held = graphs[g]
    if not held then
        need(not owners[owner], "issued owner requires its original graph")
        return false
    end
    need(held.owner == owner, "graph owner substitution")
    verify(g)
    validateSource(held.state)

    return true
end

-- Tagged words use the same eight-byte mechanical slot recipe, but only the
-- original sealed guest handlers carry the required final owner/bounds proof.
export function requireGuestSlots(g: any): nil
    local held = need(graphs[g], "original guest handler graph required")
    need(held.seal and held.final and held.state.guestEntry and held.abi == "handler", "sealed guest handler required")
    need(verify(g), "verified guest handler required")
end

-- The checked context used to lower dispatch is part of the issued unit,
-- not interchangeable with a structurally compatible public scope record.
export function requireContext(g: any, owner: any, context: any): nil
    local held = need(graphs[g], "authenticated graph required")
    need(held.owner == owner and context == held.state.context, "checked context substitution")
end

-- Executable roots are stricter than internal checked call targets. A raw
-- allocator cannot become an entry by selecting its already-issued graph.
export function requireEntry(g: any, owner: any): nil
    need(requireOriginal(g, owner), "entry requires original issued graph")
    local held = graphs[g]
    if held.state.serviceCatalog then
        need(held.state.executable and held.state.executable[owner], "service owner is internal-only")
        local moduleName = "nativecellcontract"
        local cell: any = require("nupp.compiler.vm." .. moduleName)
        cell.requireEntry(g, held.state.resolved)
    end
end

export function target(g: any, owner: any, targetGraph: any, targetOwner: any): nil
    local held = need(graphs[g], "authenticated caller required")
    need(held.owner == owner and owners[targetOwner] == held.state, "callee unit differs")
    need(held.state.resolved[targetOwner] == targetGraph, "callee graph substitution")
    need(requireOriginal(targetGraph, targetOwner), "authenticated callee required")
end

export function refuse(g: any, route: string): nil
    need(
        not graphs[g]
        and g.nativeFinalFrame == nil
        and not sources[g.source]
        and (
            not g.source
            or service.isUnitModule(g.source.module)
            or (g.source.module ~= probeModule and g.source.module ~= returnModule and g.source.module ~= guestModule)
        ),
        route .. " does not carry final frame provenance"
    )
end

-- Fixed build input, not create(manifest, owners, effects). The dedicated
-- driver snapshots the reviewed sources before compiling this producer and
-- binds that snapshot/image/output in its receipt. No caller module list,
-- effect map, state parameter index or annotation can enter this function.
local function assemble(returns: boolean): any
    local moduleName = returns and returnModule or probeModule
    local directory = returns and "core-return-contract" or "core-frame-contract"
    local sourceName = returns and "return-contract-probe" or "frame-contract-probe"
    local entryName = returns and "CoreReturnContract" or "CoreFrameContract"
    local trueName = returns and "CoreReturnTrue" or "CoreFrameTrue"
    local cases = returns and returnCases or negativeCases
    local paths = {}
    for index, entry in ipairs(sharedPaths) do
        paths[index] = entry
    end
    paths[#paths + 1] = {moduleName, "native/core/tests/" .. sourceName .. ".nupp"}
    need(current == nil, "nested construction")
    local root = need(os.getenv("NUPP_COMPILER_ROOT"), "build source root required")
    local snapshotPath = root .. "/build/" .. directory .. "/snapshot.json"
    local snapshotText = read(snapshotPath)
    local snapshot = require("nupp.serde.internal.json.values").decode(snapshotText)
    need(snapshot.version == 1 and snapshot.target == "aarch64-apple-darwin", "fixed snapshot version/target")
    local requested = {}
    for index, entry in ipairs(paths) do
        need(snapshot.sources[entry[2]] == read(root .. "/" .. entry[2]), "canonical source snapshot differs")
        local path = entry[1] == moduleName
            and root .. "/build/" .. directory .. "/source/nupp/runtime/core/" .. (
                returns and "returncontractprobe" or "framecontractprobe"
            ) .. ".nupp"
            or root .. "/" .. entry[2]
        need(read(path) == snapshot.sources[entry[2]], "staged reviewed module differs")
        requested[index] = {moduleName = entry[1], path = path}
    end
    for _, path in ipairs({"src/nupp/runtime/vm/intrinsics.d.nupp", "src/nupp/runtime/vm/values.nupp"}) do
        need(snapshot.sources[path] == read(root .. "/" .. path), "runtime source snapshot differs")
    end
    local unit = require("nupp.compiler.vm.nativeunit").session(root, requested, snapshot.target, {
        "src",
        "native/core/src",
        "build/" .. directory .. "/source"
    })
    local state: any = {
        root = root,
        snapshotPath = snapshotPath,
        snapshotText = snapshotText,
        snapshot = snapshot,
        unit = unit,
        roles = {},
        resolved = {},
        finalOwners = {}
    }
    local scopes, all = {}, {}
    for _, entry in ipairs(paths) do
        local scope = unit.module(entry[1])
        scopes[entry[1]] = scope
        -- The existing values module supplies checked literal constants only.
        -- Its functions are not admitted as final-frame service bodies.
        if scope.name ~= "nupp.runtime.vm.values" then
            for name, owner in pairs(scope.functions) do
                owners[owner] = state
                all[#all + 1] = {name = scope.name .. "." .. name, owner = owner}
            end
        end
    end
    local frames = scopes["nupp.runtime.core.frames"]
    state.stateDefinition = need(frames.checkedExports.typeDefs.State, "checked State definition")
    state.frameDefinition = need(frames.checkedExports.typeDefs.Frame, "checked Frame definition")
    state.frames = frames
    state.stateType = need(frames.checkedExports.types.State, "checked State type")
    state.frameType = need(frames.checkedExports.types.Frame, "checked Frame type")
    local layout = require("nupp.compiler.targetlayout")
    state.stateLayout = copy(need(layout.of(state.stateType, snapshot.target), "State target layout"))
    state.frameLayout = copy(need(layout.of(state.frameType, snapshot.target), "Frame target layout"))
    state.context = scopes["nupp.runtime.core.context"]
    local probe = scopes[moduleName]
    state.probe = need(probe.exports[entryName], "fixed handler declaration")
    state.finalOwners[state.probe] = true
    state.finalOwners[need(probe.exports[trueName], "fixed true-edge handler declaration")] = true
    for name in pairs(cases) do
        state.finalOwners[need(probe.exports[name], "fixed negative handler declaration")] = true
    end
    state.roles[need(probe.exports.setup, "fixed setup declaration")] = "setup"
    state.roles[need(frames.exports.publish, "canonical publish declaration")] = "publish"
    if returns then
        state.roles[need(frames.exports.returnScalar, "canonical return declaration")] = "returnScalar"
    end
    local access = scopes["nupp.runtime.core.frameaccess"]
    for _, role in ipairs({"active", "values", "integers", "floats", "code", "pc", "refresh"}) do
        state.roles[need(access.exports[role], "checked accessor declaration")] = role
    end
    table.sort(all, function(a: any, b: any): boolean
        return a.name < b.name
    end)
    -- Like incremental.hostServices, defer compiler-only dependencies until
    -- this closed build entry runs. The dedicated producer statically includes
    -- both modules; graph verification alone must not enter this import cycle.
    local lowerName, profileName = "lower", "nativegraph"
    local lower: any = require("nupp.compiler.vm." .. lowerName)
    local profile: any = require("nupp.compiler.vm." .. profileName)
    local resolved, refusals = {}, {}
    for _, item in ipairs(all) do
        item.owner.nativeABI = state.finalOwners[item.owner] and "handler" or "leaf"
    end
    local ok, problem = pcall(function(): nil
        for _, item in ipairs(all) do
            current = {state = state, owner = item.owner}
            local abi = item.owner.nativeABI
            local expected = item.owner.scope == probe and cases[item.owner.name]
            if expected then
                local passed, failure = pcall(function(): any
                    return lower.functionGraph(item.owner, unit.options(item.owner, abi), profile)
                end)
                need(
                    not passed and tostring(failure):find("native final frame: " .. expected, 1, true),
                    "negative body missed dataflow refusal: " .. item.name .. ": " .. tostring(failure)
                )
                refusals[#refusals + 1] = {name = item.owner.name, diagnostic = tostring(failure)}
            else
                local passed, g = pcall(function(): any
                    return lower.functionGraph(item.owner, unit.options(item.owner, abi), profile)
                end)
                need(passed, item.name .. ": " .. tostring(g))
                state.resolved[item.owner] = g
                resolved[item.name] = {graph = g, owner = item.owner}
            end
            current = nil
        end
        validateSource(state)
    end)
    current = nil
    need(ok, tostring(problem))

    return {resolved = resolved, context = state.context, probe = moduleName .. "." .. entryName, refusals = refusals}
end

-- Independent fixed build entries: the accepted publish proof never reads the
-- return probe or its snapshot. No public source/effect/owner parameters exist.
export function build(): any
    return assemble(false)
end

export function buildReturn(): any
    return assemble(true)
end

-- Actual guest entry is a separate closed build, independent of both diagnostic
-- probe snapshots. The enum selects reviewed source fixtures, never a caller
-- path, owner/effect map, checked callback or arbitrary raw graph.
-- Operations a pure scalar leaf may contain: word and float arithmetic,
-- comparisons, conversions and selects. No load, store, pointer, slot,
-- program, helper, dispatch or allocation operation is admitted.
local pureOperations: {[string]: boolean} = {}
for _, name in ipairs({
    "NativeConstant",
    "NativeBoolean",
    "NativeSelect",
    "NativeAsWord",
    "NativeWordCast",
    "NativeICmp",
    "NativeFCmp",
    "NativeIMul",
    "NativeUDiv",
    "NativeURem",
    "NativeSDiv",
    "NativeSRem",
    "NativeIntToFloat",
    "NativeFloatToInt",
    "NativeFloatBits",
    "NativeFloatFromBits",
    "NativeFloor",
    "NativeCeil",
    "NativeSqrt",
    "IAdd",
    "ISub",
    "IAnd",
    "IOr",
    "IXor",
    "INot",
    "IShl",
    "IShrU",
    "FAdd",
    "FSub",
    "FMul",
    "FDiv",
    "FNeg",
    "Move",
    "NativeLeafCall"
}) do
    pureOperations[name] = true
end

-- A pureScalar role is issued before lowering and proven after it, inside the
-- same closed build: the build fails unless every reachable callee graph is
-- scalar-only. The final-frame verifier relies on this proof.
local function provePure(state: any, roots: any): nil
    local pending, seen = {}, {}
    for _, owner in ipairs(roots) do
        pending[#pending + 1] = owner
    end
    while #pending > 0 do
        local owner = table.remove(pending)
        if not seen[owner] then
            seen[owner] = true
            local g = need(state.resolved[owner], "pure scalar leaf was not lowered")
            local held = need(graphs[g], "pure scalar leaf graph is unissued")
            need(held.abi == "leaf" and not held.final, "pure scalar owner is not a leaf")
            for _, kind in ipairs(owner.paramKinds) do
                need(kind ~= "voidptr", "pure scalar leaf takes an address")
            end
            for _, block in ipairs(g.blocks) do
                for index, op in ipairs(block.op) do
                    need(pureOperations[op], "pure scalar leaf uses " .. tostring(op))
                    if op == "NativeLeafCall" then
                        local call = need(held.calls[block] and held.calls[block][index], "pure call lacks origin")
                        pending[#pending + 1] = call.target
                    end
                end
                need(
                    block.term.kind == "return" or block.term.kind == "jump" or block.term.kind == "branch",
                    "pure scalar leaf transfers control"
                )
            end
        end
    end
end

-- The checked-source graph profile each fixed guest case is built under.
local guestVersions: {
    [string]: integer
} = {
    numberAdd = 3,
    numberNegativeZero = 3,
    numberNaN = 3,
    numberBranch = 4,
    numberLoop = 5,
    numberLoopZero = 5,
    numericFor = 6,
    numericFloat = 6,
    numericModZero = 6,
    numericOverflow = 6,
    numericControl = 6,
    workloadLoops = 6
}

-- The closed guest unit (session, roles, every lowered core graph and the
-- negative refusals) does not depend on the guest program, so one process
-- builds it once per snapshot directory and binds each case's program to it.
local guestUnits: any = {}

local function assembleGuest(caseName: string, audited: boolean): any
    local fixtures = {
        raw = "catalog-boolean",
        boolean = "catalog-boolean",
        nilValue = "catalog-nil",
        live = "catalog-live",
        fresh = "catalog-fresh",
        nested = "catalog-nested",
        branchTrue = "catalog-branch-true",
        branchFalse = "catalog-branch-false",
        branchElseif = "catalog-branch-elseif",
        branchLive = "catalog-branch-live",
        modulePair = "catalog-module-main",
        moduleTriple = "catalog-module-triple",
        numberAdd = "catalog-number-add",
        numberNegativeZero = "catalog-number-negative-zero",
        numberNaN = "catalog-number-nan",
        numberBranch = "catalog-number-branch",
        numberLoop = "catalog-number-loop",
        numberLoopZero = "catalog-number-loop-zero",
        numericFor = "catalog-numeric-for",
        numericFloat = "catalog-numeric-float",
        numericModZero = "catalog-numeric-modzero",
        numericOverflow = "catalog-numeric-overflow",
        numericControl = "catalog-numeric-control",
        workloadLoops = "catalog-workload-loops"
    }
    local fixture = need(fixtures[caseName], "unknown fixed guest program")
    need(current == nil, "nested construction")
    local root = need(os.getenv("NUPP_COMPILER_ROOT"), "build source root required")
    local directory = audited and "core-guest-audit"
        or caseName == "raw" and "core-guest-raw-entry"
        or "core-guest-programs"
    local snapshotPath = root .. "/build/" .. directory .. "/snapshot.json"
    local snapshotText = read(snapshotPath)
    local snapshot = require("nupp.serde.internal.json.values").decode(snapshotText)
    need(snapshot.version == 1 and snapshot.target == "aarch64-apple-darwin", "fixed guest snapshot target")
    local paths = {}
    for index, item in ipairs(sharedPaths) do
        paths[index] = item
    end
    for _, name in ipairs({"instances", "guestcatalog", "guestentry", "guestops", "guesthandlers"}) do
        paths[#paths + 1] = {"nupp.runtime.core." .. name, "native/core/src/nupp/runtime/core/" .. name .. ".nupp"}
    end
    if caseName == "raw" then
        for _, name in ipairs({
            "rawwire",
            "rawheader",
            "rawroles",
            "rawshape",
            "rawcatalogpolicy",
            "rawcatalog",
            "rawbudgetpolicy",
            "rawbudget",
            "rawsemanticpolicy",
            "rawsemantics",
            "rawexecutablepolicy",
            "rawexecutable"
        }) do
            paths[#paths + 1] = {"nupp.runtime.core." .. name, "native/core/src/nupp/runtime/core/" .. name .. ".nupp"}
        end
    end
    local negativeModule = "nupp.runtime.core.guestnegatives"
    local auditModule = "nupp.runtime.core.guestaudit"
    paths[#paths + 1] = {negativeModule, "native/core/tests/guest-contract-negatives.nupp"}
    if audited then
        paths[#paths + 1] = {auditModule, "native/core/tests/guest-lifecycle-audit.nupp"}
    end
    local requested = {}
    for index, item in ipairs(paths) do
        need(snapshot.sources[item[2]] == read(root .. "/" .. item[2]), "guest canonical source changed")
        local path = root .. "/" .. item[2]
        if item[1] == negativeModule then
            path = root .. "/build/" .. directory .. "/source/nupp/runtime/core/guestnegatives.nupp"
        end
        if item[1] == auditModule then
            path = root .. "/build/" .. directory .. "/source/nupp/runtime/core/guestaudit.nupp"
        end
        need(read(path) == snapshot.sources[item[2]], "staged guest source differs")
        requested[index] = {moduleName = item[1], path = path}
    end
    for _, path in ipairs({
        "src/nupp/runtime/vm/intrinsics.d.nupp",
        "src/nupp/runtime/vm/program.d.nupp",
        "src/nupp/runtime/vm/slots.d.nupp"
    }) do
        need(snapshot.sources[path] == read(root .. "/" .. path), "guest intrinsic declaration changed")
    end
    local cached = guestUnits[directory]
    if cached then
        need(cached.snapshotText == snapshotText, "guest snapshot changed within one producer process")
    end
    local unit = cached and cached.unit
        or require("nupp.compiler.vm.nativeunit").session(root, requested, snapshot.target, {
            "src",
            "native/core/src",
            "build/" .. directory .. "/source"
        })
    local state: any = cached and cached.state
        or {
            root = root,
            snapshotPath = snapshotPath,
            snapshotText = snapshotText,
            snapshot = snapshot,
            unit = unit,
            roles = {},
            resolved = {},
            finalOwners = {}
        }
    state.executable = nil
    local scopes, all = {}, {}
    for _, item in ipairs(paths) do
        local scope = unit.module(item[1])
        scopes[item[1]] = scope
        if scope.name ~= "nupp.runtime.vm.values" then
            for name, owner in pairs(scope.functions) do
                owners[owner] = state
                all[#all + 1] = {name = scope.name .. "." .. name, owner = owner}
            end
        end
    end
    local frames = scopes["nupp.runtime.core.frames"]
    state.frames, state.context = frames, scopes["nupp.runtime.core.context"]
    state.stateDefinition, state.frameDefinition = frames.checkedExports.typeDefs.State, frames.checkedExports.typeDefs.Frame
    state.stateType, state.frameType = frames.checkedExports.types.State, frames.checkedExports.types.Frame
    local layout = require("nupp.compiler.targetlayout")
    state.stateLayout = copy(need(layout.of(state.stateType, snapshot.target), "State layout"))
    state.frameLayout = copy(need(layout.of(state.frameType, snapshot.target), "Frame layout"))
    state.guestEntry = {valueCountOffset = need(state.frameLayout.offsets.valueCount, "Frame count offset")}
    local handlers = scopes[guestModule]
    local handlerNames = {"K", "Nil", "Move", "NewClosure", "CallK", "Ret", "Jmp", "JmpIf", "Invalid"}
    -- Each profile dispatches the numeric handlers it admits (coregraphschema).
    local version = guestVersions[caseName] or 2
    if caseName == "modulePair" then
        table.insert(handlerNames, 2, "Require")
    end
    local introduced: {[string]: integer} = {Add = 3, Lt = 4, Sub = 6, Mul = 6, Mod = 6, Le = 6, Eq = 6}
    for _, name in ipairs({"Add", "Lt", "Sub", "Mul", "Mod", "Le", "Eq"}) do
        if version >= introduced[name] then
            table.insert(handlerNames, 2, name)
        end
    end
    for _, name in ipairs(handlerNames) do
        state.finalOwners[need(handlers.exports[name], "fixed guest handler")] = true
    end
    local pureRoots = {}
    for _, name in ipairs({"arithmetic", "order", "equal"}) do
        local owner = need(handlers.functions[name], "numeric scalar leaf")
        state.roles[owner] = "pureScalar"
        pureRoots[#pureRoots + 1] = owner
    end
    -- Every declared handler is checked as a final frame, even when this
    -- program's dispatch table does not select it.
    for _, name in ipairs({"Require", "Add", "Sub", "Mul", "Mod", "Lt", "Le", "Eq"}) do
        state.finalOwners[need(handlers.exports[name], "fixed guest handler")] = true
    end
    local cases = {
        NoScalar = "return lacks exact checked scalar",
        WrongScalar = "root completion lacks exact checked scalar",
        NoRootIdentity = "root completion lacks exact checked scalar",
        NoCompletion = "transport exit lacks",
        NoFinishSuccess = "transport exit lacks",
        WrongState = "State context differs",
        SignedNegativeSlot = "slot lacks checked window bound",
        SignedCountCast = "slot lacks checked window bound",
        WrongCountWidth = "slot lacks checked window bound",
        StaleFrame = "invalidated frame",
        RereadAfterUnknown = "State has no successful",
        WrongResume = "publish resume identity differs"
    }
    local negatives = scopes[negativeModule]
    for name in pairs(cases) do
        state.finalOwners[need(negatives.exports[name], "fixed guest negative")] = true
    end
    for _, role in ipairs({"publish", "returnScalar"}) do
        state.roles[need(frames.exports[role], "checked frame transition")] = role
    end
    local access = scopes["nupp.runtime.core.frameaccess"]
    for _, role in ipairs({"active", "values", "integers", "floats", "code", "pc", "refresh"}) do
        state.roles[need(access.exports[role], "checked frame accessor")] = role
    end
    local ops = scopes["nupp.runtime.core.guestops"]
    local roles = {
        state = "entryState",
        current = "current",
        charge = "charge",
        constant = "constant",
        constantPresent = "constantPresent",
        moduleValue = "moduleValue",
        closure = "closure",
        prepare = "prepare",
        result = "scalarResult",
        root = "root",
        finish = "finish",
        branch = "branch",
        checkpoint = "checkpoint",
        failure = "failure",
        fail = "fail",
        resume = "resume"
    }
    for name, role in pairs(roles) do
        state.roles[need(ops.exports[name], "checked guest service")] = role
    end
    local parserName, checkerName, environmentName = "syntax.parser", "check", "project.env"
    local parser: any = require("nupp.compiler." .. parserName)
    local checker: any = require("nupp.compiler." .. checkerName)
    local environment: any = require("nupp.compiler." .. environmentName)
    local fixtureNames = caseName == "modulePair" and {"catalog-module-prefix", fixture}
        or caseName == "moduleTriple" and {"catalog-module-prefix", "catalog-module-middle", fixture}
        or {fixture}
    local project: any = nil
    if caseName == "modulePair" or caseName == "moduleTriple" then
        local incremental: any = require("nupp.compiler.project.incremental")
        require("nupp.compiler.project.projectconfig")
        require("nupp.compiler.hash")
        project = incremental.new(root, {
            cache = false,
            nativeCompilerServices = false,
            config = {include = {"src", "build/" .. directory .. "/source"}}
        })
    end
    local modules = {}
    local moduleName: string = ""
    for _, name in ipairs(fixtureNames) do
        local guestPath = "native/core/tests/" .. name .. ".nupp"
        local source = read(root .. "/" .. guestPath)
        need(snapshot.sources[guestPath] == source, "checked guest source differs")
        local parsed = parser.parse(source, root .. "/" .. guestPath)
        need(#parsed.errors == 0, "guest source parse failed")
        local declared = need(
            require("nupp.compiler.syntax.cst").declaredModule(parsed.root),
            "guest module declaration required"
        )
        local diagnostics
        local checkedPath = root .. "/" .. guestPath
        if project then
            checkedPath = root .. "/build/" .. directory .. "/source/" .. declared:gsub("%.", "/") .. ".nupp"
            need(read(checkedPath) == source, "staged checked guest source differs")
            need(project.modulePath(declared) == checkedPath, "checked guest module resolution differs")
            need(project.fileText(checkedPath) == source, "checked guest source revision differs")
            local checked = project.checkFile(checkedPath)
            parsed, diagnostics = need(checked.result, "checked guest result required"), checked.diags
            need(checked.exports and parsed.declaredModuleName == declared, "checked guest exports differ")
            need(project.fileText(checkedPath) == source, "checked guest source changed")
        else
            local env = environment.new(root, {memoryOnly = true, cache = false, nativeCompilerServices = false})
            diagnostics = checker.check(parsed, root .. "/" .. guestPath, env, {
                moduleName = declared,
                strict = false,
                lints = {["unused-binding"] = "off"}
            })
        end
        for _, diagnostic in ipairs(diagnostics) do
            need(diagnostic.severity ~= "error", diagnostic.msg)
        end
        modules[#modules + 1] = {name = declared, path = checkedPath, parsed = parsed, diagnostics = diagnostics}
        moduleName = declared
    end
    local programName, taggedName = "programgraph", "taggedprofile"
    local program: any = require("nupp.compiler.vm." .. programName)
    local tagged: any = require("nupp.compiler.vm." .. taggedName)
    local catalog = program.describe(modules, moduleName)
    state.executable = guestExecutable().fromChecked(
        program.compile(catalog, version >= 5 and tagged.forVersion(version) or tagged),
        version
    )
    validateSource(state)
    table.sort(all, function(a: any, b: any): boolean
        return a.name < b.name
    end)
    local lowerName, profileName = "lower", "nativegraph"
    local lower: any = require("nupp.compiler.vm." .. lowerName)
    local profile: any = require("nupp.compiler.vm." .. profileName)
    for _, item in ipairs(all) do
        item.owner.nativeABI = state.finalOwners[item.owner] and "handler" or "leaf"
    end
    local resolved, refusals = {}, {}
    if cached then
        resolved, refusals = cached.resolved, cached.refusals
    end
    local ok, problem = pcall(function(): nil
        if cached then
            return
        end
        for _, item in ipairs(all) do
            current = {state = state, owner = item.owner}
            local passed, g = pcall(function(): any
                return lower.functionGraph(item.owner, unit.options(item.owner, item.owner.nativeABI), profile)
            end)
            local expected = item.owner.scope == negatives and cases[item.owner.name]
            if expected then
                need(
                    not passed and tostring(g):find("native final frame: " .. expected, 1, true),
                    "guest negative missed refusal: " .. item.name .. ": " .. tostring(g)
                )
                refusals[#refusals + 1] = {name = item.owner.name, diagnostic = tostring(g)}
            else
                need(passed, item.name .. ": " .. tostring(g))
                if item.owner.scope == handlers and state.finalOwners[item.owner] and item.owner.name ~= "Invalid" then
                    require("nupp.compiler.vm.corebytecode").checkHandler(item.owner.name, g)
                end
                state.resolved[item.owner] = g
                resolved[item.name] = {graph = g, owner = item.owner}
            end
            current = nil
        end
        provePure(state, pureRoots)
        for name, expected in pairs({
            ForgePureStore = "pure scalar leaf uses NativePointer",
            ForgePureCaller = "pure scalar leaf uses NativePointer",
            ForgePureAddress = "pure scalar leaf takes an address"
        }) do
            local owner = need(negatives.functions[name], "fixed pure scalar negative")
            local passed, problem = pcall(provePure, state, {owner})
            need(
                not passed and tostring(problem):find(expected, 1, true),
                "pure scalar negative missed refusal: " .. name .. ": " .. tostring(problem)
            )
            refusals[#refusals + 1] = {name = name, diagnostic = tostring(problem)}
        end
        validateSource(state)
    end)
    current = nil
    need(ok, tostring(problem))
    if not cached then
        guestUnits[
            directory
        ] = {snapshotText = snapshotText, unit = unit, state = state, resolved = resolved, refusals = refusals}
    end
    local result = {
        resolved = resolved,
        context = state.context,
        scopes = scopes,
        executable = state.executable,
        handlers = handlerNames,
        caseName = caseName,
        audited = audited,
        refusals = refusals
    }
    local scopeMap = {}
    for name, scope in pairs(scopes) do
        scopeMap[name] = scope
    end
    guestBuilds[
        result
    ] = {
        state = state,
        resolved = resolved,
        context = state.context,
        scopes = scopes,
        scopeMap = scopeMap,
        executable = state.executable,
        handlers = copy(handlerNames),
        caseName = caseName,
        audited = audited
    }

    return result
end

export function buildGuest(caseName: string): any
    return assembleGuest(caseName, false)
end

-- Supplemental test-only leaves have no final-frame roles. The production
-- factory neither requests nor compiles their source.
export function buildGuestAudit(caseName: string): any
    return assembleGuest(caseName, true)
end

-- A public record is not a capability by shape. Final writer/shim publication
-- must retain this exact issuance plus every original graph/owner/callee.
export function validateGuest(result: any): nil
    local held = need(
        type(result) == "table" and getmetatable(result) == nil and rawget(guestBuilds, result),
        "unissued guest build"
    )
    need(
        result.resolved == held.resolved
        and result.context == held.context
        and result.scopes == held.scopes
        and result.executable == held.executable
        and result.caseName == held.caseName
        and result.audited == held.audited
        and same(result.handlers, held.handlers),
        "guest build changed"
    )
    need(getmetatable(result.scopes) == nil and getmetatable(result.resolved) == nil, "guest maps must remain plain")
    for name, scope in pairs(held.scopeMap) do
        need(result.scopes[name] == scope, "guest scope identity changed")
    end
    for name, scope in pairs(result.scopes) do
        need(held.scopeMap[name] == scope, "guest scope inventory changed")
    end
    validateSource(held.state)
    local count = 0
    for name, item in pairs(result.resolved) do
        need(
            name == item.owner.scope.name .. "." .. item.owner.name and held.state.resolved[item.owner] == item.graph,
            "guest resolved owner changed"
        )
        need(requireOriginal(item.graph, item.owner), "guest graph unissued")
        count += 1
    end
    local expected = 0
    for _ in pairs(held.state.resolved) do
        expected += 1
    end
    need(count == expected, "guest resolved inventory changed")
end

-- The allocator/collector service closure uses the same original Result/Code
-- issuance as final-frame services. Its scalar service policy is distinct from
-- final-frame ownership verification; no frame or collection claim is added.
export function buildHeapServices(): any
    need(current == nil, "nested construction")
    local catalogbuild = service.build()
    local state = {
        serviceCatalog = catalogbuild.catalog,
        roles = {},
        resolved = {},
        finalOwners = {},
        context = nil,
        executable = {}
    }
    local all = service.owners(catalogbuild.catalog)
    for _, owner in ipairs(all) do
        owners[owner], owner.nativeABI = state, "leaf"
    end
    local lowerName, profileName, cleanupName = "lower", "nativegraph", "nativecleanup"
    local lower: any = require("nupp.compiler.vm." .. lowerName)
    local base: any = require("nupp.compiler.vm." .. profileName)
    local cleanup: any = require("nupp.compiler.vm." .. cleanupName)
    local scopedProfile = cleanup.profile(base)
    local resolved = {}
    local building = ""
    local ok, problem = pcall(function(): nil
        for _, owner in ipairs(all) do
            building = owner.scope.name .. "." .. owner.name .. " (" .. owner.scope.path .. ")"
            local options = service.options(catalogbuild.catalog, owner)
            local signature = service.signature(owner, options)
            local profile = service.needsCleanup(signature) and scopedProfile or base
            current = {state = state, owner = owner}
            local g = lower.functionGraph(owner, options, profile)
            state.resolved[owner] = g
            resolved[owner.scope.name .. "." .. owner.name] = {graph = g, owner = owner}
            current = nil
        end
    end)
    current = nil
    need(ok, (not ok and "heap service " .. building .. ": " or "") .. tostring(problem))
    validateSource(state)

    local roots
    for _, g in pairs(state.resolved) do
        local roles = service.entryRoles(g)
        if roles then
            need(roots == nil, "multiple source-owned heap entries")
            roots = roles
        end
    end
    need(roots, "source-owned heap entry is absent")
    -- Traversal roots are not executable roots. In particular, a collector
    -- accepting an external Heap could resume failed storage under a new scope
    -- even when its own result is scalar. Only the exact source-owned workload
    -- and its C setup/teardown services are entry candidates.
    local entries = {
        roots.owner,
        roots.pagesInitialize,
        roots.scopeInitialize,
        roots.scopeClose,
        roots.pagesAcquireEntry,
        roots.pagesReleaseEntry
    }
    need(#entries == 6, "heap entry boundary is incomplete")
    for _, owner in ipairs(entries) do
        need(state.resolved[owner], "heap entry lacks its original checked graph")
        need(not state.executable[owner], "heap entry boundary repeats an owner")
        state.executable[owner] = true
    end
    local result = {
        resolved = resolved,
        entries = entries,
        context = nil,
        inventory = service.inventory(catalogbuild.catalog)
    }
    local entryMap = {}
    for index, owner in ipairs(entries) do
        entryMap[index] = owner
    end
    heapBuilds[result] = {state = state, resolved = resolved, entries = entries, entryMap = entryMap}

    return result
end

export function validateHeapServices(result: any): nil
    local held = need(heapBuilds[result], "unissued heap service build")
    need(
        getmetatable(result) == nil
        and result.resolved == held.resolved
        and result.entries == held.entries
        and getmetatable(result.resolved) == nil
        and getmetatable(result.entries) == nil,
        "heap service build changed"
    )
    validateSource(held.state)
    need(#result.entries == #held.entryMap, "heap executable entry inventory changed")
    for index, owner in ipairs(held.entryMap) do
        need(result.entries[index] == owner, "heap executable entry owner changed")
    end
    for key in pairs(result.entries) do
        need(
            type(key) == "number" and key % 1 == 0 and key >= 1 and key <= #held.entryMap,
            "heap executable entry inventory changed"
        )
    end
    local count: integer = 0
    for name, item in pairs(result.resolved) do
        need(
            name == item.owner.scope.name .. "." .. item.owner.name and held.state.resolved[item.owner] == item.graph,
            "heap resolved owner changed"
        )
        need(requireOriginal(item.graph, item.owner), "heap graph unissued")
        count += 1
    end
    local expected: integer = 0
    for _ in pairs(held.state.resolved) do
        expected += 1
    end
    need(count == expected, "heap resolved inventory changed")
end
