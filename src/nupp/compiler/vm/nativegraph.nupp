module nupp.compiler.vm.nativegraph

local graph = require("nupp.compiler.vm.graph")
local physical = require("nupp.compiler.vm.nativephysical")
local construction = require("nupp.compiler.vm.construction")
local unit = require("nupp.compiler.vm.nativeunit")
local finalframe = require("nupp.compiler.vm.nativeframecontract")
local nativelayout = require("nupp.compiler.vm.nativelayout")
local programcontract = require("nupp.compiler.vm.programcontract")
local slotcontract = require("nupp.compiler.vm.slotcontract")
local helpercontract = require("nupp.compiler.vm.helpercontract")
local framecontract = require("nupp.compiler.vm.framecontract")

local nativeos = require("nupp.compiler.vm.nativeos")
local service = require("nupp.compiler.vm.nativeservice")
local nativegraph = {booleanKind = "boolean"}

local arithmetic = {
    ["+"] = "IAdd",
    ["-"] = "ISub",
    ["*"] = "NativeIMul",
    ["&"] = "IAnd",
    ["|"] = "IOr",
    ["~"] = "IXor",
    ["<<"] = "IShl",
    [">>"] = "IShrU"
}
local floatArithmetic = {["+"] = "FAdd", ["-"] = "FSub", ["*"] = "FMul", ["/"] = "FDiv"}
local comparisons = {["=="] = true, ["~="] = true, ["<"] = true, ["<="] = true, [">"] = true, [">="] = true}
local exactKinds = {voidptr = true, int64 = true, uint64 = true, boolean = true, float32 = true, float64 = true}
local floatKinds = {float32 = true, float64 = true}
local projectedKinds = {int32 = true, uint32 = true}
local integerKinds = {int32 = true, uint32 = true, int64 = true, uint64 = true}
local intrinsicUnary = {
    asWord = {"NativeAsWord", "boolean", "uint64"},
    floor = {"NativeFloor", "float64", "float64"},
    ceil = {"NativeCeil", "float64", "float64"},
    sqrt = {"NativeSqrt", "float64", "float64"},
    neg = {"FNeg", "float64", "float64"},
    toFloat = {"NativeIntToFloat", "int64", "float64"},
    unsignedFloat = {"NativeIntToFloat", "uint64", "float64"},
    toInt = {"NativeFloatToInt", "float64", "int64"},
    unsignedInt = {"NativeFloatToInt", "float64", "uint64"},
    index = {"NativeWordCast", "uint64", "int64"},
    word = {"NativeWordCast", "int64", "uint64"},
    pointer = {"NativePointer", "uint64", "voidptr"},
    address = {"NativeAddress", "voidptr", "uint64"},
    bits = {"NativeFloatBits", "float64", "uint64"},
    fromBits = {"NativeFloatFromBits", "uint64", "float64"}
}
local intrinsicCalls = {
    both = {op = "IAnd", params = {"boolean", "boolean"}, result = "boolean"},
    either = {op = "IOr", params = {"boolean", "boolean"}, result = "boolean"},
    chooseWord = {op = "NativeSelect", params = {"boolean", "uint64", "uint64"}, result = "uint64"},
    chooseIndex = {op = "NativeSelect", params = {"boolean", "int64", "int64"}, result = "int64"}
}
local memoryIntrinsics = {
    load8 = {kind = "int64", width = 1, signed = false, write = false},
    load16 = {kind = "int64", width = 2, signed = false, write = false},
    load32 = {kind = "int64", width = 4, signed = true, write = false},
    load64 = {kind = "uint64", width = 8, signed = false, write = false},
    loadIndex = {kind = "int64", width = 8, signed = true, write = false},
    loadPointer = {kind = "voidptr", width = 8, signed = false, write = false},
    loadFloat = {kind = "float64", width = 8, signed = false, write = false},
    store8 = {kind = "uint64", width = 1, signed = false, write = true},
    store16 = {kind = "uint64", width = 2, signed = false, write = true},
    store32 = {kind = "int64", width = 4, signed = true, write = true},
    store64 = {kind = "uint64", width = 8, signed = false, write = true},
    storeIndex = {kind = "int64", width = 8, signed = true, write = true},
    storePointer = {kind = "voidptr", width = 8, signed = false, write = true},
    storeFloat = {kind = "float64", width = 8, signed = false, write = true}
}

-- Classification only, shared with the private service effect inventory.
-- Unknown primitives may enter guest execution or mutate roots. Knowing a
-- name here never authenticates a checked declaration or admits a call.
function nativegraph.intrinsicHazards(name: string): (boolean, boolean)
    local memory = memoryIntrinsics[name]
    if memory then
        return false, memory.write
    end
    if intrinsicUnary[name]
        or intrinsicCalls[name]
        or name == "sizeOf"
        or name == "alignmentOf"
        or name == "fieldOffset"
        or name == "layout"
        or name == "offset"
    then
        return false, false
    end

    return true, true
end

local function memoryContract(specification: any, borrowed: boolean?): any
    return {
        source = borrowed and "borrowed" or "live",
        kind = specification.kind,
        width = specification.width,
        signed = specification.signed,
        write = specification.write
    }
end

local wrappers = {literal = "base", const = "inner"}

local function need(ok: any, message: string): any
    assert(ok, "native graph: " .. message)
    return ok
end

local function exactKind(t: any): string
    while t and wrappers[t.tag] do
        t = t[wrappers[t.tag]]
    end
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            if exactKind(member) ~= "boolean" then
                return "union"
            end
        end
        return "boolean"
    end

    return t and t.tag or "missing"
end

local function signature(n: any, params: {string}, result: string): nil
    local t = n.obj.inferredType
    while t and wrappers[t.tag] do
        t = t[wrappers[t.tag]]
    end
    need(
        t
        and t.tag == "func"
        and #t.params == #params
        and t.retPack
        and not t.retPack.tail
        and not t.retPack.alternatives
        and #t.rets <= 1
        and #t.retPack.head == #t.rets,
        "closed checked call signature required"
    )
    for index, kind in ipairs(params) do
        need(exactKind(t.params[index]) == kind, "call parameter kind differs from its contract")
    end
    need((#t.rets == 0 and "nil" or exactKind(t.rets[1])) == result, "call result kind differs from its contract")
    need(#(n.args.exprs or {}) == #params, "call argument count differs from its contract")
end

local function member(n: any): (string?, string?)
    if n.kind ~= "dotIndex" or n.obj.kind ~= "name" then
        return nil, nil
    end
    local definition = n.obj.token.definition

    return definition and definition.requiredModule or nil, n.name.text
end

local function integerText(n: any): string
    local text = n.token.text:gsub("[Uu]?[Ll][Ll]$", "")
    need(text:match("^%d+$") or text:match("^0[xX]%x+$"), "exact integer literal required")
    return text
end

-- ABI selection is supplied by the checked compilation request. It is not
-- inferred from a function or opcode name.
function nativegraph.admits(fn: any): boolean
    return fn.scope ~= nil and fn.body ~= nil and fn.paramKinds ~= nil
end

function nativegraph.isSupport(fn: any): boolean
    return fn.nativeABI == "support"
end

function nativegraph.isLeaf(fn: any): boolean
    return fn.nativeABI == "leaf"
end

function nativegraph.initialize(fn: any, options: any): any
    need(nativegraph.admits(fn), "checked native function required")
    local sharedContext = unit.begin(fn, options)
    local serviceSignature = service.signature(fn, options)
    local abi = options.abi or fn.nativeABI
    need(abi == "handler" or abi == "leaf" or abi == "support", "explicit native ABI required")
    need(options.physicalTarget == nil or abi == "leaf", "physical graphs require leaf ABI")
    local body = fn.body
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain native function required")
    need(
        #body.params == #fn.paramKinds and (#body.params >= 1 or serviceSignature ~= nil) and #body.params <= 8,
        "native parameter count"
    )
    fn.nativeABI = abi
    local context = options.physicalTarget and (sharedContext or physical.new(options.physicalTarget)) or nil
    local declaration = abi == "leaf" and graph.nativeLeafDeclaration(fn, context, nil, nil, serviceSignature) or nil
    local result = declaration and declaration.result or fn.resultKind
    local params = declaration and declaration.params or fn.paramKinds
    need(
        result == "uint64"
        or abi == "leaf" and (result == "int64" or result == "boolean" or result == "nil" or result == "voidptr"),
        "exact native result required"
    )
    for index, parameter in ipairs(body.params) do
        local kind = params[index]
        need(exactKinds[kind], "exact native parameter required")
        need(
            exactKind(parameter.type and parameter.type.resolvedType) == fn.paramKinds[index],
            "checked native parameter kind"
        )
        if abi == "handler" then
            need(#body.params == 6 and kind == "voidptr", "six raw pointer handler parameters required")
        end
    end
    local g = graph.newNative(params, result, abi)
    if serviceSignature then
        service.attach(g, serviceSignature)
    end
    if options.physicalTarget ~= nil then
        need(
            fn.checkedSignature == body.signatureType
            and fn.parameterPack == body.signatureType.paramPack
            and fn.parameterModes == body.signatureType.paramModes
            and fn.resultType == body.signatureType.rets[1],
            "retained checked physical signature required"
        )
        for index, parameter in ipairs(body.params) do
            need(
                fn.parameterAnnotations[index] == parameter.type.resolvedType
                and fn.parameterDefinitions[index] == parameter.name.definition
                and fn.parameterTypes[index] == parameter.name.definition.type
                and fn.parameterModeTokens[index] == parameter.modeTok,
                "physical parameter metadata differs"
            )
        end
        g.nativePhysical = {context = context, values = {}, signature = declaration.physical}
        if declaration.physical then
            for index, descriptor in ipairs(declaration.physical.params) do
                if descriptor then
                    g.nativePhysical.values[index] = descriptor
                end
            end
        end
    end
    if g.nativePhysical and unit.contains(fn) then
        physical.bindGraphOwner(g, fn)
    end
    fn.physicalContext = g.nativePhysical and g.nativePhysical.context or nil
    finalframe.initialize(fn, g)

    return g
end

function nativegraph.kind(t: any): string
    return exactKind(t)
end

function nativegraph.valueKind(g: any, value: integer): string
    return need(g.exactTypes[value], "missing exact value kind")
end

function nativegraph.newValue(g: any, kind: string): integer
    return graph.nativeValue(g, kind)
end

function nativegraph.localKind(token: any, fn: any): string
    local kind = exactKind(token.inferredType)
    if fn.physicalContext
        and (physical.pointerType(token.inferredType) or kind == "nominal" and token.inferredType.declKind == "struct")
    then
        kind = "voidptr"
    end
    need(
        exactKinds[kind] or fn.physicalContext and projectedKinds[kind],
        "exact native local kind required: " .. fn.name .. "." .. token.text .. " is " .. kind
    )

    return kind
end

function nativegraph.entryBindings(ctx: any, node: any?): nil
    service.entryBindings(ctx, node)
end

function nativegraph.copyValue(g: any, original: integer): integer
    local value = graph.nativeValue(g, nativegraph.valueKind(g, original))
    if g.nativePhysical then
        local descriptor = g.nativePhysical.values[original]
        if descriptor then
            g.nativePhysical.values[value] = physical.copyValue(g, descriptor)
        end
    end

    return value
end

function nativegraph.initializeBinding(ctx: any, node: any, key: any, value: integer): integer
    if ctx.g.nativePhysical then
        local descriptor = ctx.g.nativePhysical.values[value]
        if descriptor then
            physical.validate(descriptor)
            if descriptor.checkedType.tag == "affine" and key.type == descriptor.checkedType then
                if ctx.fn.body.params[value] == node then
                    physical.takesEntry(ctx.fn, ctx.g.nativePhysical.signature, descriptor, node, key, value)
                else
                    physical.bindOwner(ctx.fn, descriptor, node, key)
                end
            end
            if key.type ~= descriptor.checkedType then
                local contract = physical.binding(ctx.fn, descriptor, node, key)
                value = ctx.emit(node, "NativePointerView", {value, contract}, "voidptr")
                descriptor = contract.target
                ctx.g.nativePhysical.values[value] = descriptor
            end
            local origin = physical.localOrigin(descriptor)
            if descriptor.storageType.tag == "nominal" then
                need(
                    origin and origin.owner == ctx.fn and node.kind == "localStmt",
                    "physical aggregate binding requires its construction"
                )
                local found = false
                for index, token in ipairs(node.names) do
                    if (token.definition or token) == key then
                        local expression = node.exprs[index]
                        while expression and expression.kind == "paren" do
                            expression = expression.expr
                        end
                        -- `S(...)` is lowered through its construction wrapper.
                        found = expression == origin.node or construction.of(expression) == origin.node
                    end
                end
                need(found, "physical aggregate copy is unsupported")
            end
        else
            need(exactKind(key.type) ~= "ptr", "typed pointer local requires checked view")
        end
    end

    return value
end

function nativegraph.writeBinding(ctx: any, node: any, key: any, previous: integer, value: integer): integer
    value = nativegraph.initializeBinding(ctx, node, key, value)
    if ctx.g.nativePhysical then
        local before, after = ctx.g.nativePhysical.values[previous], ctx.g.nativePhysical.values[value]
        need(
            before == nil and after == nil
            or before
            and after
            and (physical.sameValue(before, after) or physical.assignment(ctx.fn, node, key, before, after)),
            "physical assignment changes checked type, roots or local origin"
        )
    end

    return value
end

function nativegraph.readBinding(ctx: any, node: any, key: any, value: integer, expected: string?): integer
    need(expected == nil or nativegraph.valueKind(ctx.g, value) == expected, "local changes exact kind")
    local descriptor = ctx.g.nativePhysical and ctx.g.nativePhysical.values[value]
    if descriptor then
        physical.validate(descriptor)
        if descriptor.storageType.tag == "nominal" then
            need(node.inferredType == descriptor.checkedType, "physical local read changes checked type")
            need(ctx.localAddressNode == node, "physical aggregate is only usable through its address cast")
        elseif node.inferredType ~= descriptor.checkedType then
            local contract = physical.occurrence(ctx.fn, descriptor, node)
            local refined = ctx.emit(node, "NativePointerView", {value, contract}, "voidptr")
            ctx.g.nativePhysical.values[refined] = contract.target
            return refined
        end
    end

    return value
end

function nativegraph.checkedPragma(ctx: any, node: any): nil
    need(
        ctx.g.nativePhysical
        and node.name
        and node.name.text == "unsafe"
        and node.annotationDefinition
        and node.annotationDefinition.name == "unsafe",
        "checked unsafe scope required for physical profile"
    )
end

function nativegraph.cast(ctx: any, node: any, expected: string?): integer?
    local sidecar = need(ctx.g.nativePhysical, "physical pointer casts require explicit target")
    local from, to = exactKind(node.expr.inferredType), exactKind(node.inferredType)
    if projectedKinds[from] then
        need(to == "int64" or to == "uint64", "projected integer cast requires an exact word result")
        need(expected == nil or expected == to, "projected integer cast changes exact result kind")
        local value = ctx.expression(node.expr, from)
        if not value then
            return nil
        end
        return ctx.emit(node, "NativeWordCast", {value}, to)
    end
    need(expected == nil or expected == "voidptr", "pointer cast changes machine representation")
    local operand = node.expr
    while operand.kind == "paren" do
        operand = operand.expr
    end
    local previous = ctx.localAddressNode
    ctx.localAddressNode = operand
    local source = ctx.expression(node.expr, "voidptr")
    ctx.localAddressNode = previous
    if not source then
        return nil
    end
    local descriptor = sidecar.values[source]
    local contract = node.expr.kind == "nilExpr" and physical.nilView(ctx.fn, sidecar.context, node)
        or physical.cast(need(descriptor, "pointer cast source lacks checked physical type"), node, ctx.fn)
    local value = ctx.emit(node, "NativePointerView", {source, contract}, "voidptr")
    sidecar.values[value] = contract.target

    return value
end

function nativegraph.construction(ctx: any, node: any, expected: string?): integer?
    local sidecar = need(ctx.g.nativePhysical, "physical local requires explicit target")
    need(
        ctx.g.native.abi == "leaf" and ctx.block == ctx.g.blocks[1],
        "physical local construction must be in the entry block"
    )
    need(expected == nil or expected == "voidptr", "physical local machine kind differs")
    local contract = physical.localConstruction(ctx.fn, sidecar.context, node)
    -- Evaluate all checked scalar initializers in their recorded source order.
    -- Storage is private until initialization completes; no address exists in
    -- source bindings during argument evaluation, including nested helper calls.
    local operands = ctx.operands(contract.nodes, contract.params)
    if not operands then
        return nil
    end
    need(ctx.block == ctx.g.blocks[1], "branching physical initializer unsupported")
    table.insert(operands, 1, contract)
    local value = ctx.emit(node, "NativeLocal", operands, "voidptr")
    sidecar.values[value] = contract.descriptor

    return value
end

function nativegraph.fieldRead(ctx: any, node: any, expected: string?): integer?
    local checked = node.obj.inferredType
    local raw = checked and (checked.tag == "borrowed" or checked.tag == "affine") and checked.inner or checked
    if not raw or exactKind(raw) ~= "ptr" then
        return nativegraph.constant(ctx, node, expected)
    end
    local sidecar = need(ctx.g.nativePhysical, "physical field requires explicit target")
    local receiver = ctx.expression(node.obj, "voidptr")
    if not receiver then
        return nil
    end
    local descriptor = need(sidecar.values[receiver], "field receiver lacks checked physical type")
    if descriptor.checkedType.tag == "affine" then
        local view = physical.ownerView(ctx.fn, descriptor, node.obj, sidecar.signature)
        receiver = ctx.emit(node.obj, "NativePointerView", {receiver, view}, "voidptr")
        descriptor = view.target
        sidecar.values[receiver] = descriptor
    end
    local access = physical.field(descriptor, node, false, sidecar.signature, ctx.fn)
    local pointer = access.storage.machineKind == "voidptr"
    local boolean = access.valueType.tag == "boolean"
    local kind = pointer and "voidptr" or boolean and "boolean" or physical.integerField(access)
    need(expected == nil or expected == kind, "physical field changes projected result kind")
    local value = ctx.emit(node, "NativeFieldLoad", {receiver, access}, kind)
    if pointer then
        sidecar.values[value] = access.storage
    end

    return value
end

-- The common walker retains this receiver before evaluating any RHS. The
-- write reuses the checked field contract and emits a normal memory store.
function nativegraph.assignmentTarget(ctx: any, node: any, rhs: any): any
    local sidecar = need(ctx.g.nativePhysical, "physical assignment requires explicit target")
    need(node.kind == "dotIndex", "physical assignment requires a checked field")
    local receiver = ctx.expression(node.obj, "voidptr")
    local descriptor = need(sidecar.values[receiver], "field receiver lacks checked physical type")
    if descriptor.checkedType.tag == "affine" then
        local view = physical.ownerView(ctx.fn, descriptor, node.obj, sidecar.signature)
        receiver = ctx.emit(node.obj, "NativePointerView", {receiver, view}, "voidptr")
        descriptor = view.target
        sidecar.values[receiver] = descriptor
    end
    local access = physical.field(descriptor, node, true, sidecar.signature, ctx.fn)
    local fieldKind = access.storage.machineKind
    if fieldKind == "voidptr" or fieldKind == "boolean" then
        if fieldKind == "boolean" then
            physical.booleanField(access)
        end
        return {receiver = receiver, access = access, kind = fieldKind, rhs = rhs}
    end
    physical.integerField(access)
    local kind = exactKind(rhs.inferredType)
    -- Unsuffixed integer literals have no raw word representation until this
    -- checked store requests one. General number/integer bindings still refuse.
    local literal = rhs
    while literal.kind == "paren" do
        literal = literal.expr
    end
    if (kind == "integer" or kind == "number")
        and (
            literal.kind == "number"
            or literal.kind == "unop" and literal.op.text == "-" and literal.operand.kind == "number"
        )
    then
        kind = "int64"
    end
    need(integerKinds[kind], "physical store requires an exact integer RHS")

    return {receiver = receiver, access = access, kind = kind}
end

function nativegraph.assignTarget(ctx: any, node: any, target: any, receiver: integer, value: integer): nil
    local access = physical.rebindField(ctx.g, target.access, ctx.g.nativePhysical.values[receiver])
    local retention = nil
    if access.storage.machineKind == "voidptr" then
        retention = physical.store(access, ctx.fn, target.rhs, ctx.g.nativePhysical.values[value])
    elseif access.storage.machineKind == "boolean" then
        physical.booleanField(access)
    else
        physical.integerField(access)
    end
    need(ctx.g.nativePhysical.values[receiver] == access.receiver, "physical store receiver identity differs")
    local offset = ctx.emit(node, "NativeConstant", {tostring(access.offset)}, "int64")
    ctx.emit(
        node,
        "NativeStore",
        {
            receiver,
            offset,
            value,
            {
                source = "borrowed",
                kind = target.kind,
                width = access.width,
                signed = access.signed,
                write = true,
                field = access,
                retention = retention
            }
        },
        nil
    )
end

function nativegraph.emit(ctx: any, node: any, op: string, args: any, kind: string?): integer?
    local value = graph.emitNative(ctx.g, ctx.block, op, args, kind, ctx.position(node))
    finalframe.record(ctx, node, op, args)
    service.recordArena(ctx, node, op, args)
    return value
end

function nativegraph.finish(ctx: any): nil
    service.finish(ctx.g)
    unit.finish(ctx.fn)
    finalframe.finish(ctx)
end

function nativegraph.resolveCallee(ctx: any, call: any): (boolean, any)
    local redirected = service.target(ctx, call)
    if redirected then
        return true, redirected
    end
    if unit.contains(ctx.fn) then
        return true, unit.callee(ctx.fn, call)
    end

    return false, nil
end

local function bindLocalCalls(ctx: any, declaration: any, operands: any): nil
    if not declaration.physical then
        return
    end
    for index in ipairs(declaration.physical.params) do
        local descriptor = ctx.g.nativePhysical.values[operands[index]]
        if not descriptor then
            local view = physical.nilArgument(declaration.physical, index)
            if view then
                local value = ctx.emit(view.node, "NativePointerView", {operands[index], view}, "voidptr")
                descriptor = view.target
                ctx.g.nativePhysical.values[value] = descriptor
                operands[index] = value
            end
        end
        if descriptor
            and descriptor.checkedType.tag == "affine"
            and physical.borrowingParameter(declaration.physical, index)
        then
            local view = physical.ownerArgument(declaration.physical, index, descriptor, ctx.g.nativePhysical.signature)
            local value = ctx.emit(view.node, "NativePointerView", {operands[index], view}, "voidptr")
            descriptor = view.target
            ctx.g.nativePhysical.values[value] = descriptor
            operands[index] = value
        end
        if descriptor then
            physical.bindHeapCall(declaration.physical, index, descriptor)
        end
        if descriptor and physical.localOrigin(descriptor) then
            physical.bindLocalCall(declaration.physical, index, descriptor)
        end
    end
end

local function leafDeclaration(ctx: any, call: any, target: any): any
    local redirected = service.redirect(ctx, call) or service.raise(ctx, call) ~= nil
    return graph.nativeLeafDeclaration(
        target,
        ctx.g.nativePhysical and ctx.g.nativePhysical.context or nil,
        not redirected and call or nil,
        not redirected and ctx.fn or nil,
        service.calleeSignature(ctx, call, target)
    )
end

function nativegraph.declaration(ctx: any, call: any, target: any): any
    if service.redirect(ctx, call) then
        return leafDeclaration(ctx, call, target)
    end
    unit.call(ctx.fn, call, target)
    need(target and target.node and target.body and target.scope, "checked callee definition required")
    need(target.nativeABI ~= "handler", "a handler requires dispatch")
    local result = target.resultKind or "nil"
    signature(call, target.paramKinds, result)
    if ctx.g.nativePhysical
        and target.nativeABI ~= "support"
        and physical.signature(
            target,
            ctx.g.nativePhysical.context,
            call,
            ctx.fn,
            service.calleeSignature(ctx, call, target)
        ) ~= nil
    then
        return leafDeclaration(ctx, call, target)
    end
    for _, kind in ipairs(target.paramKinds) do
        need(exactKinds[kind], "composed helper requires exact parameter kinds")
    end
    need(result == "nil" or exactKinds[result], "composed helper requires exact result kind")
    need(
        target.node.body == target.body and target.scope.functions and target.scope.functions[target.name] == target,
        "checked callee source identity"
    )
    need(#target.body.params == #target.paramKinds, "checked callee parameter count")
    for index, parameter in ipairs(target.body.params) do
        need(
            exactKind(parameter.type and parameter.type.resolvedType) == target.paramKinds[index],
            "checked callee parameter kind"
        )
    end
    local checked = target.body.signatureType
    need(checked and #checked.rets <= 1, "checked callee result count")
    local actual = #checked.rets == 0 and "nil" or exactKind(checked.rets[1])
    need(actual == result, "checked callee result kind")

    return {
        moduleName = target.scope.name,
        name = target.name,
        params = target.paramKinds,
        result = result,
        abi = target.nativeABI or "leaf",
        source = {path = target.scope.path, module = target.scope.name, name = target.name}
    }
end

function nativegraph.inlineContract(ctx: any, call: any, target: any, returns: boolean): any
    local declaration = nativegraph.declaration(ctx, call, target)
    need(target.nativeABI ~= "support", "support functions require tail transfer")
    need(
        returns and target.resultKind == ctx.fn.resultKind
        or not returns and (target.resultKind == nil or target.resultKind == "nil"),
        "helper continuation differs from its result"
    )

    return declaration
end

local function helperDeclaration(ctx: any, n: any, moduleName: string, name: string): any
    local options = ctx.options
    need(options.helperModules and options.helperModules[moduleName], "helper module is not admitted")
    local checked = n.obj.inferredType
    while checked and wrappers[checked.tag] do
        checked = checked[wrappers[checked.tag]]
    end
    need(checked and checked.tag == "func" and #checked.rets <= 1, "checked helper signature required")
    local params = {}
    for index, parameter in ipairs(checked.params) do
        params[index] = exactKind(parameter)
        need(exactKinds[params[index]], "helper parameter requires an exact native kind")
    end
    local result = #checked.rets == 0 and "nil" or exactKind(checked.rets[1])
    need(result == "nil" or exactKinds[result], "helper result requires an exact native kind")
    need(#(n.args.exprs or {}) == #params, "helper argument count differs from its declaration")

    return {
        moduleName = moduleName,
        name = name,
        params = params,
        result = result,
        effects = helpercontract.read(n.obj.name.definition, name),
        normalReturn = helpercontract.normalReturn(n.obj.name.definition, name)
    }
end

function nativegraph.valueLiteral(ctx: any, node: any, expected: string?): integer
    need(
        node.kind == "nilExpr" and expected == "voidptr" and ctx.g.nativePhysical,
        "native value literal requires pointer nil"
    )
    local zero = ctx.emit(node, "NativeConstant", {"0"}, "uint64")

    return ctx.emit(node, "NativePointer", {zero}, "voidptr")
end

function nativegraph.literal(ctx: any, n: any, expected: string?): integer
    local emit = ctx.emit
    if n.kind == "number" then
        local kind = expected or exactKind(n.inferredType)
        need(
            kind == "int64" or kind == "uint64" or ctx.g.nativePhysical and projectedKinds[kind],
            "integer literal needs an exact integer kind"
        )
        return emit(n, "NativeConstant", {integerText(n)}, kind) as integer
    end
    need(expected == nil or expected == "boolean", "boolean literal changes exact kind")

    return emit(n, "NativeBoolean", {n.kind == "true" or n.kind == "trueExpr"}, "boolean") as integer
end

function nativegraph.constant(ctx: any, n: any, expected: string?): integer
    local options = ctx.options
    local scope = ctx.scope
    local emit = ctx.emit
    if n.kind == "name" then
        local constant = scope.constants and scope.constants[n.token.definition or n.token]
        need(constant and constant.kind == "number", "name is not a checked local binding")
        local kind = expected or exactKind(constant.inferredType)
        need(kind == "int64" or kind == "uint64", "module constant requires an exact integer kind")
        return emit(n, "NativeConstant", {integerText(constant)}, kind) as integer
    end
    local moduleName, name = member(n)
    local home = moduleName and options.modules and options.modules[moduleName]
    local text = home and home.exportedConstants and home.exportedConstants[name]
    need(
        type(text) == "string" and (text:match("^%d+$") or text:match("^0[xX]%x+$")),
        "checked exact module constant required"
    )
    need(expected == "int64" or expected == "uint64", "module constant needs an exact integer kind")

    return emit(n, "NativeConstant", {text}, expected) as integer
end

function nativegraph.unary(ctx: any, n: any, expected: string?): integer?
    local expression = ctx.expression
    local emit = ctx.emit
    local kind = exactKind(n.inferredType)
    -- The checker can mark an unsuffixed negative literal as int64 while a
    -- checked physical comparison needs the int32 field's representation.
    -- Only the original integer token may project; graph verification checks
    -- its signed range before the code can be selected.
    if ctx.g.nativePhysical
        and (expected == "int64" or expected == "int32")
        and n.op.text == "-"
        and n.operand.kind == "number"
        and (
            kind == "integer"
            or kind == "number"
            or expected == "int32"
            and kind == "int64"
            and (n.operand.token.text:match("^%d+$") or n.operand.token.text:match("^0[xX]%x+$"))
        )
    then
        kind = expected
    end
    need(expected == nil or expected == kind, "unary expression changes exact kind")
    if n.op.text == "not" then
        need(
            kind == "boolean" and exactKind(n.operand.inferredType) == "boolean",
            "native not requires checked Boolean operand"
        )
        local value = expression(n.operand, "boolean")
        if not value then
            return nil
        end
        local no = emit(n, "NativeBoolean", {false}, "boolean")
        return emit(n, "NativeICmp", {value, no, "=="}, "boolean") as integer
    elseif n.op.text == "-"
        and (kind == "int64" or ctx.g.nativePhysical and kind == "int32")
        and n.operand.kind == "number"
    then
        return emit(n, "NativeConstant", {"-" .. integerText(n.operand)}, kind) as integer
    elseif n.op.text == "~" then
        need(kind == "int64" or kind == "uint64", "integer complement requires an exact kind")
        local value = expression(n.operand, kind)
        if not value then
            return nil
        end
        return emit(n, "INot", {value}, kind) as integer
    elseif n.op.text == "-" and floatKinds[kind] then
        local value = expression(n.operand, kind)
        if not value then
            return nil
        end
        return emit(n, "FNeg", {value}, kind) as integer
    end
    error("native graph: unsupported checked unary operator " .. n.op.text, 0)
end

-- Flow narrowing to a literal does not replace a checked local's fixed
-- representation. Operand evaluation still verifies the actual bound SSA kind.
local function narrowedIntegerBinding(node: any): string?
    while node.kind == "paren" do
        node = node.expr
    end
    local definition = node.kind == "name" and node.token.definition
    local declared = definition and definition.type
    if node.inferredType and node.inferredType.tag == "literal" and declared and integerKinds[declared.tag] then
        return declared.tag
    end

    return nil
end

function nativegraph.binary(ctx: any, n: any, expected: string?): integer?
    local emit = ctx.emit
    local operator = n.op.text
    if comparisons[operator] then
        need(expected == nil or expected == "boolean", "comparison produces a boolean")
        local kind = narrowedIntegerBinding(n.lhs) or narrowedIntegerBinding(n.rhs) or exactKind(n.lhs.inferredType)
        if ctx.g.nativePhysical
            and (physical.pointerType(n.lhs.inferredType) or physical.pointerType(n.rhs.inferredType))
        then
            need(operator == "==" or operator == "~=", "pointer ordering is unsupported")
            kind = "voidptr"
        end
        if not (exactKinds[kind] or ctx.g.nativePhysical and projectedKinds[kind]) then
            kind = exactKind(n.rhs.inferredType)
        end
        need(
            exactKinds[kind] or ctx.g.nativePhysical and projectedKinds[kind],
            "comparison needs an exact operand kind"
        )
        local operands = ctx.operands({n.lhs, n.rhs}, {kind, kind})
        if not operands then
            return nil
        end
        local lhs, rhs = operands[1], operands[2]
        return emit(n, floatKinds[kind] and "NativeFCmp" or "NativeICmp", {lhs, rhs, operator}, "boolean") as integer
    end
    local kind = exactKind(n.inferredType)
    need(kind == "int64" or kind == "uint64" or floatKinds[kind], "exact scalar arithmetic required")
    need(expected == nil or expected == kind, "arithmetic changes exact kind")
    if kind == "int64" and (operator == "//" or operator == "%") then
        local operands = ctx.operands({n.lhs, n.rhs}, {kind, kind})
        if not operands then
            return nil
        end
        local lhs, rhs = operands[1], operands[2]
        -- Lua floors: truncate, then step toward negative infinity when the
        -- remainder is nonzero and its sign differs from the divisor's. A
        -- zero divisor is the caller's to exclude; the machine yields zero.
        local quotient = emit(n, "NativeSDiv", {lhs, rhs}, kind) as integer
        local remainder = emit(n, "NativeSRem", {lhs, rhs}, kind) as integer
        local zero = emit(n, "NativeConstant", {"0"}, kind) as integer
        local nonzero = emit(n, "NativeICmp", {remainder, zero, "~="}, "boolean") as integer
        local signs = emit(n, "IXor", {remainder, rhs}, kind) as integer
        local differ = emit(n, "NativeICmp", {signs, zero, "<"}, "boolean") as integer
        local exact, stepped
        if operator == "//" then
            local one = emit(n, "NativeConstant", {"1"}, kind) as integer
            exact, stepped = quotient, emit(n, "ISub", {quotient, one}, kind) as integer
        else
            exact, stepped = remainder, emit(n, "IAdd", {remainder, rhs}, kind) as integer
        end
        local adjusted = emit(n, "NativeSelect", {differ, stepped, exact}, kind) as integer

        return emit(n, "NativeSelect", {nonzero, adjusted, exact}, kind) as integer
    end
    local op = need(
        kind == "uint64" and operator == "//" and "NativeUDiv"
        or kind == "uint64" and operator == "%" and "NativeURem"
        or (floatKinds[kind] and floatArithmetic or arithmetic)[operator],
        "unsupported arithmetic operator"
    )
    local operands = ctx.operands({n.lhs, n.rhs}, {kind, kind})
    if not operands then
        return nil
    end
    local lhs, rhs = operands[1], operands[2]

    return emit(n, op, {lhs, rhs}, kind) as integer
end

-- The shared frontend owns the CFG; this profile only admits and compares an
-- exact numeric case. Guarded, type and computed cases remain outside it.
function nativegraph.switchCase(ctx: any, value: any, subject: integer, kind: string): integer
    need(kind == "int64" or kind == "uint64", "native switch needs an exact integer selector")
    need(value.kind == "number", "native switch case needs a numeric literal")
    local candidate = need(ctx.expression(value, kind), "native switch case lost its value")

    return ctx.emit(value, "NativeICmp", {subject, candidate, "=="}, "boolean") as integer
end

function nativegraph.call(ctx: any, n: any, expected: string?): integer?
    if service.raise(ctx, n) then
        nativegraph.statementCall(ctx, n)
        return nil
    end
    local options = ctx.options
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    local emit = ctx.emit
    local moduleName, name = member(n.obj)
    local args = n.args.exprs or {}
    if n.ownershipIntrinsic == "borrowFrom" then
        need(
            ctx.g.nativePhysical and expected == "voidptr" and #args == 2,
            "borrowFrom requires physical pointer result"
        )
        local operands = ctx.operands(args, {"voidptr", "voidptr"})
        if not operands then
            return nil
        end
        local source = need(ctx.g.nativePhysical.values[operands[1]], "borrowFrom requires checked pointer view")
        local contract = physical.borrowView(ctx.fn, source, n)
        need(
            physical.borrowArgument(
                contract,
                need(ctx.g.nativePhysical.values[operands[2]], "borrowFrom source lacks checked dependency")
            ),
            "borrowFrom source dependency differs"
        )
        local value = emit(n, "NativeBorrowPointer", {operands[1], operands[2], contract}, "voidptr")
        ctx.g.nativePhysical.values[value] = contract.target
        return value
    end
    local target = ctx.callee(n)
    if target and target.nativeABI ~= "support" then
        ctx.checkedCallee(n, target)
        local declaration = leafDeclaration(ctx, n, target)
        declaration = service.declaration(ctx, n, target, declaration)
        need(declaration.abi == "leaf", "scalar call requires leaf ABI")
        need(declaration.result ~= "nil", "void leaf cannot be consumed as a value")
        need(expected == nil or expected == declaration.result, "leaf call changes exact result kind")
        local operands = ctx.operands(args, service.sourceParameters(ctx, n, declaration))
        if not operands then
            return nil
        end
        operands = service.operands(ctx, declaration, operands)
        bindLocalCalls(ctx, declaration, operands)
        table.insert(operands, 1, declaration)
        if ctx.g.nativeService and service.needsCleanup(ctx.g.nativeService) then
            ctx.beforeCall(n)
        end
        local value = emit(n, "NativeLeafCall", operands, declaration.result) as integer
        if declaration.physical and declaration.physical.result then
            ctx.g.nativePhysical.values[value] = declaration.physical.result
        end
        return service.afterCall(ctx, n, declaration, value)
    elseif moduleName == "nupp.runtime.vm.frames" then
        local access = framecontract.read(n.obj.name.definition, name as string)
        local result = access.kind == "status" and "int64" or "voidptr"
        local kinds = access.kind == "window" and {"voidptr", "voidptr"} or {"voidptr"}
        signature(n, kinds, result)
        need(expected == nil or expected == result, "frame access changes exact kind")
        local operands = ctx.operands(args, kinds)
        if not operands then
            return nil
        end
        operands[#operands + 1] = access
        return emit(
            n,
            access.kind == "status" and "FrameStatus" or (access.kind == "recover" and "FrameRecover" or "FrameWindow"),
            operands,
            result
        ) as integer
    elseif moduleName == "nupp.runtime.vm.program" then
        local contract = programcontract.read(n.obj.name.definition, name as string)
        signature(n, {"voidptr", "int64"}, contract.result)
        need(expected == nil or expected == contract.result, "program load changes exact kind")
        local operands = ctx.operands(args, {"voidptr", "int64"})
        if not operands then
            return nil
        end
        local base, offset = operands[1], operands[2]
        return emit(n, "ProgramLoad", {base, offset, contract}, contract.result) as integer
    elseif moduleName == "nupp.runtime.vm.slots" then
        local contract = slotcontract.read(n.obj.name.definition, name as string)
        need(not contract.write, "slot write is a statement")
        if contract.class == "vararg" then
            signature(n, {"voidptr", "int64"}, contract.kind)
            need(expected == nil or expected == contract.kind, "vararg read changes exact kind")
            local operands = ctx.operands(args, {"voidptr", "int64"})
            if not operands then
                return nil
            end
            operands[3] = contract
            return emit(n, "FrameVarargRead", operands, contract.kind) as integer
        end
        signature(n, {"voidptr", "voidptr", "int64"}, contract.kind)
        need(expected == nil or expected == contract.kind, "slot read changes exact kind")
        local operands = ctx.operands(args, {"voidptr", "voidptr", "int64"})
        if not operands then
            return nil
        end
        local frame, window, slot = operands[1], operands[2], operands[3]
        return emit(n, "FrameSlotRead", {frame, window, slot, contract}, contract.kind) as integer
    elseif moduleName == "nupp.runtime.vm.os" then
        local declaration = nativeos.call(ctx.fn, n)
        need(declaration.name ~= "unmapPages", "unmap is a source statement")
        need(expected == nil or expected == declaration.result, "OS result changes exact kind")
        local operands = ctx.operands(args, declaration.params)
        if not operands then
            return nil
        end
        table.insert(operands, 1, declaration)
        local value = emit(n, "NativeHelperCall", operands, declaration.result) as integer
        local descriptor = nativeos.result(declaration)
        if descriptor then
            need(ctx.g.nativePhysical, "OS pointer result requires physical context")
            ctx.g.nativePhysical.values[value] = descriptor
        end
        return value
    elseif moduleName and options.helperModules and options.helperModules[moduleName] then
        local declaration = helperDeclaration(ctx, n, moduleName, name as string)
        need(declaration.result ~= "nil", "helper effect is a statement")
        need(expected == nil or expected == declaration.result, "helper changes exact result kind")
        local operands = ctx.operands(args, declaration.params)
        if not operands then
            return nil
        end
        table.insert(operands, 1, declaration)
        return emit(n, "NativeHelperCall", operands, declaration.result) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and (name == "sizeOf" or name == "alignmentOf") then
        signature(n, {}, "uint64")
        need(expected == nil or expected == "uint64", "native type layout changes exact kind")
        local property = name == "sizeOf" and "size" or "alignment"
        return emit(
            n,
            "NativeConstant",
            {nativelayout.constant(n, property, ctx.g.nativePhysical and ctx.g.nativePhysical.context.target or nil)},
            "uint64"
        ) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "fieldOffset" then
        signature(n, {"string"}, "int64")
        need(expected == nil or expected == "int64", "native field offset changes exact kind")
        return emit(
            n,
            "NativeConstant",
            {nativelayout.fieldOffset(n, ctx.g.nativePhysical and ctx.g.nativePhysical.context.target or nil)},
            "int64"
        ) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "layout" then
        signature(n, {"string"}, "int64")
        need(expected == nil or expected == "int64", "layout offset changes exact kind")
        need(args[1].kind == "string", "literal ABI layout name required")
        return emit(n, "NativeLayout", {args[1].token.value or args[1].token.text:sub(2, -2)}, "int64") as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and memoryIntrinsics[name] then
        local access = memoryContract(memoryIntrinsics[name], leaf)
        need(not access.write, "native memory write is a statement")
        signature(n, {"voidptr", "int64"}, access.kind)
        need(expected == nil or expected == access.kind, "native load changes exact kind")
        local operands = ctx.operands(args, {"voidptr", "int64"})
        if not operands then
            return nil
        end
        operands[3] = access
        return emit(n, "NativeLoad", operands, access.kind) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and intrinsicCalls[name] then
        local operation = intrinsicCalls[name]
        signature(n, operation.params, operation.result)
        need(expected == nil or expected == operation.result, "intrinsic changes exact result kind")
        local operands = ctx.operands(args, operation.params)
        if not operands then
            return nil
        end
        return emit(n, operation.op, operands, operation.result) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and intrinsicUnary[name] then
        local operation = intrinsicUnary[name]
        signature(n, {operation[2]}, operation[3])
        need(expected == nil or expected == operation[3], "intrinsic changes exact result kind")
        local operand = expression(args[1], operation[2])
        if not operand then
            return nil
        end
        local descriptor = ctx.g.nativePhysical and ctx.g.nativePhysical.values[operand]
        if operation[1] == "NativeAddress" and descriptor and #descriptor.ownership ~= 0 then
            local contract = physical.address(ctx.fn, descriptor, n)
            return emit(n, "NativeBorrowAddress", {operand, contract}, "uint64") as integer
        end
        local value = emit(n, operation[1], {operand}, operation[3]) as integer
        if ctx.g.nativePhysical and operation[1] == "NativePointer" then
            local descriptor = physical.describe(ctx.g.nativePhysical.context, n.inferredType)
            need(
                descriptor.storageType.tag == "voidptr" and #descriptor.ownership == 0 and not descriptor.nullable,
                "native pointer result requires checked plain pointer"
            )
            ctx.g.nativePhysical.values[value] = descriptor
        end
        return value
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "offset" then
        signature(n, {"voidptr", "int64"}, "voidptr")
        need(expected == nil or expected == "voidptr", "pointer offset changes exact kind")
        local operands = ctx.operands(args, {"voidptr", "int64"})
        if not operands then
            return nil
        end
        local base, offset = operands[1], operands[2]
        local value = emit(n, "PointerOffset", {base, offset}, "voidptr") as integer
        service.arenaOffset(ctx, n, value)
        if ctx.g.nativePhysical and not ctx.g.nativePhysical.values[value] then
            local descriptor = physical.describe(ctx.g.nativePhysical.context, n.inferredType)
            need(
                descriptor.storageType.tag == "voidptr" and #descriptor.ownership == 0 and not descriptor.nullable,
                "raw pointer offset requires checked plain result"
            )
            ctx.g.nativePhysical.values[value] = descriptor
        end
        return value
    end
    error("native graph: unsupported checked call " .. tostring(moduleName) .. "." .. tostring(name), 0)
end

function nativegraph.statementCall(ctx: any, call: any): nil
    local options = ctx.options
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    local emit = ctx.emit
    local moduleName, name = member(call.obj)
    local args = call.args.exprs or {}
    local raising = service.raise(ctx, call)
    if raising then
        need(type(ctx.fail) == "function", "service failure cleanup is not installed")
        local target = raising.target
        local declaration = leafDeclaration(ctx, call, target)
        declaration = service.declaration(ctx, call, target, declaration)
        local code = emit(call, "NativeConstant", {"1"}, "uint64")
        local owner = emit(call, "NativeConstant", {tostring(raising.owner)}, "uint64")
        local site = emit(call, "NativeConstant", {tostring(raising.site)}, "uint64")
        emit(call, "NativeLeafCall", {declaration, service.scope(ctx), code, owner, site}, nil)
        ctx.fail(call)
    elseif service.redirect(ctx, call) then
        local target = service.target(ctx, call)
        local declaration = leafDeclaration(ctx, call, target)
        need(declaration.result == "nil", "OS scalar result must be bound")
        declaration = service.declaration(ctx, call, target, declaration)
        local operands = ctx.operands(args, service.sourceParameters(ctx, call, declaration))
        if not operands then
            return nil
        end
        operands = service.operands(ctx, declaration, operands)
        bindLocalCalls(ctx, declaration, operands)
        table.insert(operands, 1, declaration)
        if ctx.g.nativeService and service.needsCleanup(ctx.g.nativeService) then
            ctx.beforeCall(call)
        end
        emit(call, "NativeLeafCall", operands, nil)
        local _ = service.afterCall(ctx, call, declaration, nil)
    elseif moduleName == "nupp.runtime.vm.slots" then
        local contract = slotcontract.read(call.obj.name.definition, name as string)
        need(contract.write, "slot read is not a statement")
        signature(call, {"voidptr", "voidptr", "int64", contract.kind}, "nil")
        local operands = ctx.operands(args, {"voidptr", "voidptr", "int64", contract.kind})
        if not operands then
            return nil
        end
        local frame, window, slot, value = operands[1], operands[2], operands[3], operands[4]
        emit(call, "FrameSlotWrite", {frame, window, slot, value, contract}, nil)
    elseif moduleName == "nupp.runtime.vm.intrinsics" and memoryIntrinsics[name] then
        local access = memoryContract(memoryIntrinsics[name], leaf)
        need(access.write, "native memory read is not a statement")
        signature(call, {"voidptr", "int64", access.kind}, "nil")
        local operands = ctx.operands(args, {"voidptr", "int64", access.kind})
        if not operands then
            return nil
        end
        operands[4] = access
        emit(call, "NativeStore", operands, nil)
    elseif moduleName == "nupp.runtime.vm.os" then
        local declaration = nativeos.call(ctx.fn, call)
        need(declaration.name == "unmapPages", "OS scalar result must be bound")
        local operands = ctx.operands(args, declaration.params)
        if not operands then
            return nil
        end
        table.insert(operands, 1, declaration)
        local status = emit(call, "NativeHelperCall", operands, "uint64") as integer
        local out = nativeos.status(declaration)
        local offset = emit(call, "NativeConstant", {tostring(out.offset)}, "int64") as integer
        emit(
            call,
            "NativeStore",
            {
                out.parameter,
                offset,
                status,
                {source = "borrowed", kind = "uint64", width = 8, signed = false, write = true}
            },
            nil
        )
    elseif moduleName and options.helperModules and options.helperModules[moduleName] then
        local declaration = helperDeclaration(ctx, call, moduleName, name as string)
        need(declaration.result == "nil", "helper result must be bound explicitly")
        local operands = ctx.operands(args, declaration.params)
        if not operands then
            return nil
        end
        table.insert(operands, 1, declaration)
        emit(call, "NativeHelperCall", operands, nil)
    elseif ctx.callee(call) then
        local target = ctx.callee(call)
        if target.nativeABI ~= "support" and target.resultKind == "nil" then
            ctx.checkedCallee(call, target)
            local declaration = leafDeclaration(ctx, call, target)
            declaration = service.declaration(ctx, call, target, declaration)
            need(declaration.result == "nil", "void statement requires a checked void leaf")
            local operands = ctx.operands(args, service.sourceParameters(ctx, call, declaration))
            if not operands then
                return nil
            end
            operands = service.operands(ctx, declaration, operands)
            bindLocalCalls(ctx, declaration, operands)
            table.insert(operands, 1, declaration)
            if ctx.g.nativeService and service.needsCleanup(ctx.g.nativeService) then
                ctx.beforeCall(call)
            end
            emit(call, "NativeLeafCall", operands, nil)
            local _ = service.afterCall(ctx, call, declaration, nil)
        elseif leaf and target.nativeABI ~= "support" then
            expression(call, nil)
        else
            ctx.inline(call, target, false)
        end
    else
        error("native graph: unsupported checked statement call", 0)
    end
end

function nativegraph.returnStatement(ctx: any, stat: any): nil
    local fn = ctx.fn
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    if leaf then
        if ctx.g.native.result == "nil" then
            need(
                #stat.exprs == 0 or #stat.exprs == 1 and stat.exprs[1].kind == "nilExpr",
                "void leaf return must be empty or explicit nil"
            )
            ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(stat)}
        else
            need(#stat.exprs == 1, "native leaf returns one scalar")
            local value = expression(stat.exprs[1], ctx.g.native.result)
            if not value then
                return
            end
            if ctx.g.nativePhysical then
                local signature = ctx.g.nativePhysical.signature
                local descriptor = ctx.g.nativePhysical.values[value]
                local expected = signature and signature.result
                if expected and expected.nullable and stat.exprs[1].kind == "nilExpr" then
                    local view = physical.nilReturn(signature, fn, stat)
                    value = ctx.emit(stat.exprs[1], "NativePointerView", {value, view}, "voidptr")
                    descriptor = view.target
                    ctx.g.nativePhysical.values[value] = descriptor
                end
                need(
                    expected == nil
                    and (
                        descriptor == nil
                        or fn.resultType and fn.resultType.tag == "voidptr" and physical.rawReturn(descriptor)
                    )
                    or expected and descriptor and physical.returnValue(signature, descriptor),
                    "return changes checked physical pointer type"
                )
            end
            ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
        end
        ctx.block = nil
    else
        need(#stat.exprs == 1 and stat.exprs[1].kind == "call", "native transfer return required")
        local call = stat.exprs[1]
        local moduleName, name = member(call.obj)
        local target = ctx.callee(call)
        if moduleName == "nupp.runtime.vm.intrinsics" and name == "dispatch" then
            signature(call, {"voidptr", "voidptr", "voidptr", "voidptr", "voidptr", "voidptr"}, "uint64")
            local args = ctx.operands(call.args.exprs, {
                "voidptr",
                "voidptr",
                "voidptr",
                "voidptr",
                "voidptr",
                "voidptr"
            })
            if not args then
                return
            end
            ctx.block.term = {kind = "dispatch", args = args, edges = {}, pos = ctx.position(stat)}
            ctx.block = nil
        elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "fail" then
            signature(call, {}, "uint64")
            ctx.block.term = {kind = "nativeFail", edges = {}, pos = ctx.position(stat)}
            ctx.block = nil
        elseif target and target.nativeABI == "support" then
            local declaration = ctx.checkedCallee(call, target)
            need(declaration.result == "uint64", "support transfer requires a status result")
            declaration.abi = "support"
            declaration.effects = {mayCollect = true, mayPark = true, mayRaise = true, pure = false}
            local args = ctx.operands(call.args.exprs, declaration.params)
            if not args then
                return
            end
            ctx.block.term = {
                kind = "nativeTail",
                callee = declaration,
                args = args,
                edges = {},
                pos = ctx.position(stat)
            }
            ctx.block = nil
        elseif target then
            ctx.inline(call, target, true)
        else
            error("native graph: unsupported checked transfer", 0)
        end
    end
end

-- Only an authenticated void leaf may end without an explicit return.
function nativegraph.fallthrough(ctx: any, node: any): nil
    need(ctx.g.native.abi == "leaf" and ctx.g.native.result == "nil", "native scalar or handler cannot fall through")
    need(
        graph.nativeLeafDeclaration(
            ctx.fn,
            ctx.g.nativePhysical and ctx.g.nativePhysical.context or nil,
            nil,
            nil,
            ctx.g.nativeService
        ).result == "nil",
        "checked void fallthrough required"
    )
    ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(node)}
    ctx.block = nil
end

-- Compatibility entry only; the shared lowering owns all CST traversal.
function nativegraph.compile(fn: any, options: any): any
    local functiongraph = require("nupp.compiler.vm.functiongraph")
    return functiongraph.compile(fn, options, nativegraph)
end

export = nativegraph
