module nupp.compiler.vm.nativegraph

local graph = require("nupp.compiler.vm.graph")
local nativelayout = require("nupp.compiler.vm.nativelayout")
local programcontract = require("nupp.compiler.vm.programcontract")
local slotcontract = require("nupp.compiler.vm.slotcontract")
local helpercontract = require("nupp.compiler.vm.helpercontract")
local framecontract = require("nupp.compiler.vm.framecontract")

local nativegraph = {booleanKind = "boolean"}

local arithmetic = {
    ["+"] = "IAdd",
    ["-"] = "ISub",
    ["*"] = "NativeIMul",
    ["&"] = "IAnd",
    ["|"] = "IOr",
    ["~"] = "IXor",
    ["<<"] = "IShl",
    [">>"] = "IShrU"
}
local floatArithmetic = {["+"] = "FAdd", ["-"] = "FSub", ["*"] = "FMul", ["/"] = "FDiv"}
local comparisons = {["=="] = true, ["~="] = true, ["<"] = true, ["<="] = true, [">"] = true, [">="] = true}
local exactKinds = {voidptr = true, int64 = true, uint64 = true, boolean = true, float32 = true, float64 = true}
local floatKinds = {float32 = true, float64 = true}
local intrinsicUnary = {
    asWord = {"NativeAsWord", "boolean", "uint64"},
    floor = {"NativeFloor", "float64", "float64"},
    ceil = {"NativeCeil", "float64", "float64"},
    sqrt = {"NativeSqrt", "float64", "float64"},
    neg = {"FNeg", "float64", "float64"},
    toFloat = {"NativeIntToFloat", "int64", "float64"},
    unsignedFloat = {"NativeIntToFloat", "uint64", "float64"},
    toInt = {"NativeFloatToInt", "float64", "int64"},
    unsignedInt = {"NativeFloatToInt", "float64", "uint64"},
    index = {"NativeWordCast", "uint64", "int64"},
    word = {"NativeWordCast", "int64", "uint64"},
    pointer = {"NativePointer", "uint64", "voidptr"},
    address = {"NativeAddress", "voidptr", "uint64"},
    bits = {"NativeFloatBits", "float64", "uint64"},
    fromBits = {"NativeFloatFromBits", "uint64", "float64"}
}
local intrinsicCalls = {
    both = {op = "IAnd", params = {"boolean", "boolean"}, result = "boolean"},
    either = {op = "IOr", params = {"boolean", "boolean"}, result = "boolean"},
    chooseWord = {op = "NativeSelect", params = {"boolean", "uint64", "uint64"}, result = "uint64"},
    chooseIndex = {op = "NativeSelect", params = {"boolean", "int64", "int64"}, result = "int64"}
}
local memoryIntrinsics = {
    load8 = {kind = "int64", width = 1, signed = false, write = false},
    load16 = {kind = "int64", width = 2, signed = false, write = false},
    load32 = {kind = "int64", width = 4, signed = true, write = false},
    load64 = {kind = "uint64", width = 8, signed = false, write = false},
    loadIndex = {kind = "int64", width = 8, signed = true, write = false},
    loadPointer = {kind = "voidptr", width = 8, signed = false, write = false},
    loadFloat = {kind = "float64", width = 8, signed = false, write = false},
    store8 = {kind = "uint64", width = 1, signed = false, write = true},
    store16 = {kind = "uint64", width = 2, signed = false, write = true},
    store32 = {kind = "int64", width = 4, signed = true, write = true},
    store64 = {kind = "uint64", width = 8, signed = false, write = true},
    storeIndex = {kind = "int64", width = 8, signed = true, write = true},
    storePointer = {kind = "voidptr", width = 8, signed = false, write = true},
    storeFloat = {kind = "float64", width = 8, signed = false, write = true}
}

local function memoryContract(specification: any, borrowed: boolean?): any
    return {
        source = borrowed and "borrowed" or "live",
        kind = specification.kind,
        width = specification.width,
        signed = specification.signed,
        write = specification.write
    }
end

local wrappers = {literal = "base", const = "inner"}

local function need(ok: any, message: string): any
    assert(ok, "native graph: " .. message)
    return ok
end

local function exactKind(t: any): string
    while t and wrappers[t.tag] do
        t = t[wrappers[t.tag]]
    end
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            if exactKind(member) ~= "boolean" then
                return "union"
            end
        end
        return "boolean"
    end

    return t and t.tag or "missing"
end

local function signature(n: any, params: {string}, result: string): nil
    local t = n.obj.inferredType
    while t and wrappers[t.tag] do
        t = t[wrappers[t.tag]]
    end
    need(
        t
        and t.tag == "func"
        and #t.params == #params
        and t.retPack
        and not t.retPack.tail
        and not t.retPack.alternatives
        and #t.rets <= 1
        and #t.retPack.head == #t.rets,
        "closed checked call signature required"
    )
    for index, kind in ipairs(params) do
        need(exactKind(t.params[index]) == kind, "call parameter kind differs from its contract")
    end
    need((#t.rets == 0 and "nil" or exactKind(t.rets[1])) == result, "call result kind differs from its contract")
    need(#(n.args.exprs or {}) == #params, "call argument count differs from its contract")
end

local function member(n: any): (string?, string?)
    if n.kind ~= "dotIndex" or n.obj.kind ~= "name" then
        return nil, nil
    end
    local definition = n.obj.token.definition

    return definition and definition.requiredModule or nil, n.name.text
end

local function integerText(n: any): string
    local text = n.token.text:gsub("[Uu]?[Ll][Ll]$", "")
    need(text:match("^%d+$") or text:match("^0[xX]%x+$"), "exact integer literal required")
    return text
end

-- ABI selection is supplied by the checked compilation request. It is not
-- inferred from a function or opcode name.
function nativegraph.admits(fn: any): boolean
    return fn.scope ~= nil and fn.body ~= nil and fn.paramKinds ~= nil
end

function nativegraph.isSupport(fn: any): boolean
    return fn.nativeABI == "support"
end

function nativegraph.isLeaf(fn: any): boolean
    return fn.nativeABI == "leaf"
end

function nativegraph.initialize(fn: any, options: any): any
    need(nativegraph.admits(fn), "checked native function required")
    local abi = options.abi or fn.nativeABI
    need(abi == "handler" or abi == "leaf" or abi == "support", "explicit native ABI required")
    local body = fn.body
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain native function required")
    need(#body.params == #fn.paramKinds and #body.params >= 1 and #body.params <= 8, "native parameter count")
    local result = fn.resultKind
    need(
        result == "uint64" or abi == "leaf" and (result == "boolean" or result == "nil"),
        "exact native result required"
    )
    for index, parameter in ipairs(body.params) do
        local kind = fn.paramKinds[index]
        need(exactKinds[kind], "exact native parameter required")
        need(exactKind(parameter.type and parameter.type.resolvedType) == kind, "checked native parameter kind")
        if abi == "handler" then
            need(#body.params == 6 and kind == "voidptr", "six raw pointer handler parameters required")
        end
    end
    fn.nativeABI = abi
    if abi == "leaf" then
        need(graph.nativeLeafDeclaration(fn).result == result, "checked native result kind")
    end

    return graph.newNative(fn.paramKinds, result, abi)
end

function nativegraph.kind(t: any): string
    return exactKind(t)
end

function nativegraph.valueKind(g: any, value: integer): string
    return need(g.exactTypes[value], "missing exact value kind")
end

function nativegraph.newValue(g: any, kind: string): integer
    return graph.nativeValue(g, kind)
end

function nativegraph.localKind(token: any, fn: any): string
    local kind = exactKind(token.inferredType)
    need(exactKinds[kind], "exact native local kind required: " .. fn.name .. "." .. token.text .. " is " .. kind)
    return kind
end

function nativegraph.emit(ctx: any, node: any, op: string, args: any, kind: string?): integer?
    return graph.emitNative(ctx.g, ctx.block, op, args, kind, ctx.position(node))
end

function nativegraph.declaration(ctx: any, call: any, target: any): any
    need(target and target.node and target.body and target.scope, "checked callee definition required")
    need(target.nativeABI ~= "handler", "a handler requires dispatch")
    local result = target.resultKind or "nil"
    signature(call, target.paramKinds, result)
    for _, kind in ipairs(target.paramKinds) do
        need(exactKinds[kind], "composed helper requires exact parameter kinds")
    end
    need(result == "nil" or exactKinds[result], "composed helper requires exact result kind")
    need(
        target.node.body == target.body and target.scope.functions and target.scope.functions[target.name] == target,
        "checked callee source identity"
    )
    need(#target.body.params == #target.paramKinds, "checked callee parameter count")
    for index, parameter in ipairs(target.body.params) do
        need(
            exactKind(parameter.type and parameter.type.resolvedType) == target.paramKinds[index],
            "checked callee parameter kind"
        )
    end
    local checked = target.body.signatureType
    need(checked and #checked.rets <= 1, "checked callee result count")
    local actual = #checked.rets == 0 and "nil" or exactKind(checked.rets[1])
    need(actual == result, "checked callee result kind")

    return {
        moduleName = target.scope.name,
        name = target.name,
        params = target.paramKinds,
        result = result,
        abi = target.nativeABI or "leaf",
        source = {path = target.scope.path, module = target.scope.name, name = target.name}
    }
end

function nativegraph.inlineContract(ctx: any, call: any, target: any, returns: boolean): any
    local declaration = nativegraph.declaration(ctx, call, target)
    need(target.nativeABI ~= "support", "support functions require tail transfer")
    need(
        returns and target.resultKind == ctx.fn.resultKind
        or not returns and (target.resultKind == nil or target.resultKind == "nil"),
        "helper continuation differs from its result"
    )

    return declaration
end

local function helperDeclaration(ctx: any, n: any, moduleName: string, name: string): any
    local options = ctx.options
    need(options.helperModules and options.helperModules[moduleName], "helper module is not admitted")
    local checked = n.obj.inferredType
    while checked and wrappers[checked.tag] do
        checked = checked[wrappers[checked.tag]]
    end
    need(checked and checked.tag == "func" and #checked.rets <= 1, "checked helper signature required")
    local params = {}
    for index, parameter in ipairs(checked.params) do
        params[index] = exactKind(parameter)
        need(exactKinds[params[index]], "helper parameter requires an exact native kind")
    end
    local result = #checked.rets == 0 and "nil" or exactKind(checked.rets[1])
    need(result == "nil" or exactKinds[result], "helper result requires an exact native kind")
    need(#(n.args.exprs or {}) == #params, "helper argument count differs from its declaration")

    return {
        moduleName = moduleName,
        name = name,
        params = params,
        result = result,
        effects = helpercontract.read(n.obj.name.definition, name),
        normalReturn = helpercontract.normalReturn(n.obj.name.definition, name)
    }
end

function nativegraph.literal(ctx: any, n: any, expected: string?): integer
    local emit = ctx.emit
    if n.kind == "number" then
        local kind = expected or exactKind(n.inferredType)
        need(kind == "int64" or kind == "uint64", "integer literal needs an exact integer kind")
        return emit(n, "NativeConstant", {integerText(n)}, kind) as integer
    end
    need(expected == nil or expected == "boolean", "boolean literal changes exact kind")

    return emit(n, "NativeBoolean", {n.kind == "true" or n.kind == "trueExpr"}, "boolean") as integer
end

function nativegraph.constant(ctx: any, n: any, expected: string?): integer
    local options = ctx.options
    local scope = ctx.scope
    local emit = ctx.emit
    if n.kind == "name" then
        local constant = scope.constants and scope.constants[n.token.definition or n.token]
        need(constant and constant.kind == "number", "name is not a checked local binding")
        local kind = expected or exactKind(constant.inferredType)
        need(kind == "int64" or kind == "uint64", "module constant requires an exact integer kind")
        return emit(n, "NativeConstant", {integerText(constant)}, kind) as integer
    end
    local moduleName, name = member(n)
    local home = moduleName and options.modules and options.modules[moduleName]
    local text = home and home.exportedConstants and home.exportedConstants[name]
    need(
        type(text) == "string" and (text:match("^%d+$") or text:match("^0[xX]%x+$")),
        "checked exact module constant required"
    )
    need(expected == "int64" or expected == "uint64", "module constant needs an exact integer kind")

    return emit(n, "NativeConstant", {text}, expected) as integer
end

function nativegraph.unary(ctx: any, n: any, expected: string?): integer
    local expression = ctx.expression
    local emit = ctx.emit
    local kind = exactKind(n.inferredType)
    need(expected == nil or expected == kind, "unary expression changes exact kind")
    if n.op.text == "-" and kind == "int64" and n.operand.kind == "number" then
        return emit(n, "NativeConstant", {"-" .. integerText(n.operand)}, kind) as integer
    elseif n.op.text == "~" then
        need(kind == "int64" or kind == "uint64", "integer complement requires an exact kind")
        return emit(n, "INot", {expression(n.operand, kind)}, kind) as integer
    elseif n.op.text == "-" and floatKinds[kind] then
        return emit(n, "FNeg", {expression(n.operand, kind)}, kind) as integer
    end
    error("native graph: unsupported checked unary operator " .. n.op.text, 0)
end

function nativegraph.binary(ctx: any, n: any, expected: string?): integer
    local expression = ctx.expression
    local emit = ctx.emit
    local operator = n.op.text
    if comparisons[operator] then
        need(expected == nil or expected == "boolean", "comparison produces a boolean")
        local kind = exactKind(n.lhs.inferredType)
        if not exactKinds[kind] then
            kind = exactKind(n.rhs.inferredType)
        end
        need(exactKinds[kind], "comparison needs an exact operand kind")
        local lhs, rhs = expression(n.lhs, kind), expression(n.rhs, kind)
        return emit(n, floatKinds[kind] and "NativeFCmp" or "NativeICmp", {lhs, rhs, operator}, "boolean") as integer
    end
    local kind = exactKind(n.inferredType)
    need(kind == "int64" or kind == "uint64" or floatKinds[kind], "exact scalar arithmetic required")
    need(expected == nil or expected == kind, "arithmetic changes exact kind")
    local op = need(
        kind == "uint64" and operator == "//" and "NativeUDiv"
        or (floatKinds[kind] and floatArithmetic or arithmetic)[operator],
        "unsupported arithmetic operator"
    )
    local lhs = expression(n.lhs, kind)
    local rhs = expression(n.rhs, kind)

    return emit(n, op, {lhs, rhs}, kind) as integer
end

function nativegraph.call(ctx: any, n: any, expected: string?): integer
    local options = ctx.options
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    local emit = ctx.emit
    local moduleName, name = member(n.obj)
    local args = n.args.exprs or {}
    local target = ctx.callee(n)
    if target and target.nativeABI ~= "support" then
        ctx.checkedCallee(n, target)
        local declaration = graph.nativeLeafDeclaration(target)
        need(declaration.abi == "leaf", "scalar call requires leaf ABI")
        need(declaration.result ~= "nil", "void leaf cannot be consumed as a value")
        need(expected == nil or expected == declaration.result, "leaf call changes exact result kind")
        local operands = {declaration}
        for index, kind in ipairs(declaration.params) do
            operands[index + 1] = expression(args[index], kind)
        end
        return emit(n, "NativeLeafCall", operands, declaration.result) as integer
    elseif moduleName == "nupp.runtime.vm.frames" then
        local access = framecontract.read(n.obj.name.definition, name as string)
        local result = access.kind == "status" and "int64" or "voidptr"
        local kinds = access.kind == "window" and {"voidptr", "voidptr"} or {"voidptr"}
        signature(n, kinds, result)
        need(expected == nil or expected == result, "frame access changes exact kind")
        local operands = {expression(args[1], "voidptr")}
        if access.kind == "window" then
            operands[2] = expression(args[2], "voidptr")
            operands[3] = access
        else
            operands[2] = access
        end
        return emit(
            n,
            access.kind == "status" and "FrameStatus" or (access.kind == "recover" and "FrameRecover" or "FrameWindow"),
            operands,
            result
        ) as integer
    elseif moduleName == "nupp.runtime.vm.program" then
        local contract = programcontract.read(n.obj.name.definition, name as string)
        signature(n, {"voidptr", "int64"}, contract.result)
        need(expected == nil or expected == contract.result, "program load changes exact kind")
        local base = expression(args[1], "voidptr")
        local offset = expression(args[2], "int64")
        return emit(n, "ProgramLoad", {base, offset, contract}, contract.result) as integer
    elseif moduleName == "nupp.runtime.vm.slots" then
        local contract = slotcontract.read(n.obj.name.definition, name as string)
        need(not contract.write, "slot write is a statement")
        if contract.class == "vararg" then
            signature(n, {"voidptr", "int64"}, contract.kind)
            need(expected == nil or expected == contract.kind, "vararg read changes exact kind")
            return emit(
                n,
                "FrameVarargRead",
                {expression(args[1], "voidptr"), expression(args[2], "int64"), contract},
                contract.kind
            ) as integer
        end
        signature(n, {"voidptr", "voidptr", "int64"}, contract.kind)
        need(expected == nil or expected == contract.kind, "slot read changes exact kind")
        local frame = expression(args[1], "voidptr")
        local window = expression(args[2], "voidptr")
        local slot = expression(args[3], "int64")
        return emit(n, "FrameSlotRead", {frame, window, slot, contract}, contract.kind) as integer
    elseif moduleName and options.helperModules and options.helperModules[moduleName] then
        local declaration = helperDeclaration(ctx, n, moduleName, name as string)
        need(declaration.result ~= "nil", "helper effect is a statement")
        need(expected == nil or expected == declaration.result, "helper changes exact result kind")
        local operands = {declaration}
        for index, kind in ipairs(declaration.params) do
            operands[index + 1] = expression(args[index], kind)
        end
        return emit(n, "NativeHelperCall", operands, declaration.result) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and (name == "sizeOf" or name == "alignmentOf") then
        signature(n, {}, "uint64")
        need(expected == nil or expected == "uint64", "native type layout changes exact kind")
        local property = name == "sizeOf" and "size" or "alignment"
        return emit(n, "NativeConstant", {nativelayout.constant(n, property)}, "uint64") as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "fieldOffset" then
        signature(n, {"string"}, "int64")
        need(expected == nil or expected == "int64", "native field offset changes exact kind")
        return emit(n, "NativeConstant", {nativelayout.fieldOffset(n)}, "int64") as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "layout" then
        signature(n, {"string"}, "int64")
        need(expected == nil or expected == "int64", "layout offset changes exact kind")
        need(args[1].kind == "string", "literal ABI layout name required")
        return emit(n, "NativeLayout", {args[1].token.value or args[1].token.text:sub(2, -2)}, "int64") as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and memoryIntrinsics[name] then
        local access = memoryContract(memoryIntrinsics[name], leaf)
        need(not access.write, "native memory write is a statement")
        signature(n, {"voidptr", "int64"}, access.kind)
        need(expected == nil or expected == access.kind, "native load changes exact kind")
        return emit(
            n,
            "NativeLoad",
            {expression(args[1], "voidptr"), expression(args[2], "int64"), access},
            access.kind
        ) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and intrinsicCalls[name] then
        local operation = intrinsicCalls[name]
        signature(n, operation.params, operation.result)
        need(expected == nil or expected == operation.result, "intrinsic changes exact result kind")
        local operands = {}
        for index, kind in ipairs(operation.params) do
            operands[index] = expression(args[index], kind)
        end
        return emit(n, operation.op, operands, operation.result) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and intrinsicUnary[name] then
        local operation = intrinsicUnary[name]
        signature(n, {operation[2]}, operation[3])
        need(expected == nil or expected == operation[3], "intrinsic changes exact result kind")
        return emit(n, operation[1], {expression(args[1], operation[2])}, operation[3]) as integer
    elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "offset" then
        signature(n, {"voidptr", "int64"}, "voidptr")
        need(expected == nil or expected == "voidptr", "pointer offset changes exact kind")
        local base = expression(args[1], "voidptr")
        local offset = expression(args[2], "int64")
        return emit(n, "PointerOffset", {base, offset}, "voidptr") as integer
    end
    error("native graph: unsupported checked call " .. tostring(moduleName) .. "." .. tostring(name), 0)
end

function nativegraph.statementCall(ctx: any, call: any): nil
    local options = ctx.options
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    local emit = ctx.emit
    local moduleName, name = member(call.obj)
    local args = call.args.exprs or {}
    if moduleName == "nupp.runtime.vm.slots" then
        local contract = slotcontract.read(call.obj.name.definition, name as string)
        need(contract.write, "slot read is not a statement")
        signature(call, {"voidptr", "voidptr", "int64", contract.kind}, "nil")
        local frame = expression(args[1], "voidptr")
        local window = expression(args[2], "voidptr")
        local slot = expression(args[3], "int64")
        local value = expression(args[4], contract.kind)
        emit(call, "FrameSlotWrite", {frame, window, slot, value, contract}, nil)
    elseif moduleName == "nupp.runtime.vm.intrinsics" and memoryIntrinsics[name] then
        local access = memoryContract(memoryIntrinsics[name], leaf)
        need(access.write, "native memory read is not a statement")
        signature(call, {"voidptr", "int64", access.kind}, "nil")
        emit(
            call,
            "NativeStore",
            {expression(args[1], "voidptr"), expression(args[2], "int64"), expression(args[3], access.kind), access},
            nil
        )
    elseif moduleName and options.helperModules and options.helperModules[moduleName] then
        local declaration = helperDeclaration(ctx, call, moduleName, name as string)
        need(declaration.result == "nil", "helper result must be bound explicitly")
        local operands = {declaration}
        for index, kind in ipairs(declaration.params) do
            operands[index + 1] = expression(args[index], kind)
        end
        emit(call, "NativeHelperCall", operands, nil)
    elseif ctx.callee(call) then
        local target = ctx.callee(call)
        if target.nativeABI ~= "support" and target.resultKind == "nil" then
            ctx.checkedCallee(call, target)
            local declaration = graph.nativeLeafDeclaration(target)
            need(declaration.result == "nil", "void statement requires a checked void leaf")
            local operands = {declaration}
            for index, kind in ipairs(declaration.params) do
                operands[index + 1] = expression(args[index], kind)
            end
            emit(call, "NativeLeafCall", operands, nil)
        elseif leaf and target.nativeABI ~= "support" then
            expression(call, nil)
        else
            ctx.inline(call, target, false)
        end
    else
        error("native graph: unsupported checked statement call", 0)
    end
end

function nativegraph.returnStatement(ctx: any, stat: any): nil
    local fn = ctx.fn
    local leaf = ctx.g.native.abi == "leaf"
    local expression = ctx.expression
    if leaf then
        if ctx.g.native.result == "nil" then
            need(
                #stat.exprs == 0 or #stat.exprs == 1 and stat.exprs[1].kind == "nilExpr",
                "void leaf return must be empty or explicit nil"
            )
            ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(stat)}
        else
            need(#stat.exprs == 1, "native leaf returns one scalar")
            local value = expression(stat.exprs[1], fn.resultKind)
            ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
        end
        ctx.block = nil
    else
        need(#stat.exprs == 1 and stat.exprs[1].kind == "call", "native transfer return required")
        local call = stat.exprs[1]
        local moduleName, name = member(call.obj)
        local target = ctx.callee(call)
        if moduleName == "nupp.runtime.vm.intrinsics" and name == "dispatch" then
            signature(call, {"voidptr", "voidptr", "voidptr", "voidptr", "voidptr", "voidptr"}, "uint64")
            local args = {}
            for index, argument in ipairs(call.args.exprs) do
                args[index] = expression(argument, "voidptr")
            end
            ctx.block.term = {kind = "dispatch", args = args, edges = {}, pos = ctx.position(stat)}
            ctx.block = nil
        elseif moduleName == "nupp.runtime.vm.intrinsics" and name == "fail" then
            signature(call, {}, "uint64")
            ctx.block.term = {kind = "nativeFail", edges = {}, pos = ctx.position(stat)}
            ctx.block = nil
        elseif target and target.nativeABI == "support" then
            local declaration = ctx.checkedCallee(call, target)
            need(declaration.result == "uint64", "support transfer requires a status result")
            declaration.abi = "support"
            declaration.effects = {mayCollect = true, mayPark = true, mayRaise = true, pure = false}
            local args = {}
            for index, kind in ipairs(declaration.params) do
                args[index] = expression(call.args.exprs[index], kind)
            end
            ctx.block.term = {
                kind = "nativeTail",
                callee = declaration,
                args = args,
                edges = {},
                pos = ctx.position(stat)
            }
            ctx.block = nil
        elseif target then
            ctx.inline(call, target, true)
        else
            error("native graph: unsupported checked transfer", 0)
        end
    end
end

-- Only an authenticated void leaf may end without an explicit return.
function nativegraph.fallthrough(ctx: any, node: any): nil
    need(ctx.g.native.abi == "leaf" and ctx.g.native.result == "nil", "native scalar or handler cannot fall through")
    need(graph.nativeLeafDeclaration(ctx.fn).result == "nil", "checked void fallthrough required")
    ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(node)}
    ctx.block = nil
end

-- Compatibility entry only; the shared lowering owns all CST traversal.
function nativegraph.compile(fn: any, options: any): any
    local lower = require("nupp.compiler.vm.lower")
    return lower.functionGraph(fn, options, nativegraph)
end

export = nativegraph
