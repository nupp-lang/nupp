module nupp.compiler.vm.nativeos

local unit = require("nupp.compiler.vm.nativeunit")
local physical = require("nupp.compiler.vm.nativephysical")
local effects = require("nupp.compiler.vm.helpercontract")
local layout = require("nupp.compiler.targetlayout")
local issued: any = setmetatable({}, {__mode = "k"})
local definitions = {
    mapPages = {slot = 0, params = {"uint64"}, result = "voidptr", cResult = "uint64"},
    unmapPages = {slot = 1, params = {"voidptr", "uint64"}, result = "nil", cResult = "uint64"},
    pageSize = {slot = 2, params = {}, result = "uint64", cResult = "uint64"},
    argument = {slot = 3, params = {"uint64", "voidptr", "uint64"}, result = "int64", cResult = "int64"},
    poolStart = {slot = 4, params = {"uint64"}, result = "int64", cResult = "int64"},
    poolSubmit = {slot = 5, params = {"uint64", "uint64", "voidptr", "uint64"}, result = "int64", cResult = "int64"},
    poolTake = {slot = 6, params = {}, result = "int64", cResult = "int64"},
    poolFinish = {slot = 7, params = {"uint64", "voidptr", "uint64"}, result = "int64", cResult = "int64"},
    poolCancel = {slot = 8, params = {"uint64"}, result = "int64", cResult = "int64"},
    atomicload64 = {slot = 9, params = {"voidptr", "int64"}, result = "uint64", cResult = "uint64"},
    atomiccas64 = {slot = 10, params = {"voidptr", "int64", "uint64", "uint64"}, result = "uint64", cResult = "uint64"},
    securefill = {slot = 11, params = {"voidptr", "uint64"}, result = "int64", cResult = "int64"},
    poolsettle = {slot = 12, params = {"uint64"}, result = "int64", cResult = "int64"},
    dlopen = {slot = 13, params = {"voidptr", "int64"}, result = "voidptr", cResult = "voidptr"},
    dlsym = {slot = 14, params = {"voidptr", "voidptr"}, result = "voidptr", cResult = "voidptr"},
    dlclose = {slot = 15, params = {"voidptr"}, result = "int64", cResult = "int64", narrow = "int32"},
    -- Not a function: the table foreign calls cache their resolved symbols
    -- in, foreignSlots words the bridge zeroes.
    foreignTable = {slot = 16, table = true},
    -- Not imports: routines the selector writes where they are called
    -- (s0.select). The generic foreign call takes a block of words and
    -- answers x0; the other answers the address of the table above.
    foreignCall = {routine = "call", params = {"voidptr"}, result = "uint64", cResult = "uint64"},
    foreignCells = {routine = "cells", params = {}, result = "voidptr", cResult = "voidptr"}
}

local function need(value: any, message: string): any
    assert(value, "native OS: " .. message)
    return value
end

-- How many imports the bridge passes: the slots run 0 to one less, each
-- one import's. A shim refuses a bridge whose table is not this long, and
-- the linker an import index past it.
local imports: integer = 0
do
    local taken: {[integer]: string} = {}
    for name, spec in pairs(definitions) do
        if spec.routine == nil then
            need(taken[spec.slot] == nil, "OS import slot taken twice: " .. name)
            taken[spec.slot] = name
            imports += 1
        end
    end
    for slot = 0, imports - 1 do
        need(taken[slot] ~= nil, "OS import slots have a gap")
    end
end

export function importCount(): integer
    return imports
end

-- How many symbols and libraries one program's foreign calls may resolve:
-- the words of the bridge's table (`SLOTS` in native/core/bridge/src/library.rs).
const FOREIGN_SLOTS: integer = 1024

export function foreignSlots(): integer
    return FOREIGN_SLOTS
end

-- The words below this are the linked code's, one per symbol and library
-- (nupp.core.link); the guest's foreign calls cache theirs in the rest
-- (`KERNEL_CELLS` in native/core/src/nupp/runtime/core/guestforeign.nupp).
const KERNEL_CELLS: integer = 512

export function kernelCells(): integer
    return KERNEL_CELLS
end

-- The import slots a foreign call's resolution reads: the table, dlopen and dlsym.
export function foreignImports(): (integer, integer, integer)
    return definitions.foreignTable.slot, definitions.dlopen.slot, definitions.dlsym.slot
end

-- The exact kinds a foreign call passes and answers, as the C ABI does.
local foreignKinds: {
    [string]: boolean
} = {
    voidptr = true,
    int32 = true,
    uint32 = true,
    int64 = true,
    uint64 = true,
    boolean = true,
    float32 = true,
    float64 = true
}

-- The C results that arrive in fewer than 64 bits, which the caller extends.
local narrowKinds: {[string]: boolean} = {int32 = true, uint32 = true}
local WIDENED: {[string]: string} = {int32 = "int64", uint32 = "uint64"}

-- The identity the checker recorded for a call of a `cdef function`
-- ("function", its library and its symbol), nil for any other call.
local function cdefOf(call: any): string?
    if call.kind ~= "call" or call.obj.kind ~= "name" or not call.cdefCall then
        return nil
    end

    return call.cdefIdentity
end

-- Whether `call` calls a `cdef function` its module declares.
export function isForeign(call: any): boolean
    return cdefOf(call) ~= nil
end

-- The type a foreign argument or result passes as: a literal's or a
-- constant's base type, any other as it is.
export function passed(t: any): any
    if t and t.tag == "literal" then
        return passed(t.base)
    elseif t and t.tag == "const" then
        return passed(t.inner)
    end

    return t
end

-- The exact kind a foreign argument or result has: an integer literal or an
-- `integer` is int64, as the core holds both.
local function foreignKind(given: any): string
    local t = passed(given)
    local tag = t and (t.tag == "integer" and "int64" or t.tag) or nil

    return need(tag and foreignKinds[tag] and tag, "foreign call kind is not a C scalar or pointer")
end

local function same(actual: any, expected: any): nil
    need(type(actual) == "table" and getmetatable(actual) == nil, "plain contract required")
    for key, value in pairs(actual) do
        need(expected[key] == value, "contract field changed")
    end
    for key, value in pairs(expected) do
        need(actual[key] == value, "contract field missing")
    end
end

local function shape(bound: any): any
    local spec = need(definitions[bound.name], "unsupported OS import")
    local checked = bound.signature
    need(
        checked
        and checked.tag == "func"
        and checked.paramPack
        and checked.retPack
        and not checked.paramPack.tail
        and not checked.retPack.tail
        and not checked.retPack.alternatives
        and #checked.params == #spec.params
        and #checked.paramPack.head == #spec.params
        and #checked.rets == 1
        and #checked.retPack.head == 1,
        "closed OS signature required"
    )
    for index, kind in ipairs(spec.params) do
        need(
            checked.params[index].tag == kind
            and checked.paramPack.head[index] == checked.params[index]
            and checked.paramModes[index] == "plain",
            "OS parameter differs"
        )
    end
    local result = checked.rets[1]
    need(checked.retPack.head[1] == result and not checked.borrowsResult, "OS result contract differs")
    if bound.name == "mapPages" then
        local descriptor = physical.describe(bound.context, result)
        need(
            descriptor.machineKind == "voidptr"
            and descriptor.nullable
            and #descriptor.ownership == 0
            and descriptor.pointee == nil,
            "map must retain optional void pointer result"
        )
    else
        need(result.tag == spec.result, "OS result differs")
    end
    local effect = effects.read(bound.definition, bound.name)
    need(not effect.mayCollect and not effect.mayPark and not effect.mayRaise and not effect.pure, "OS effects differ")
    need(effects.normalReturn(bound.definition, bound.name) == nil, "OS normal-return contract differs")

    return spec
end

local function pageOwner(owner: any, name: string): boolean
    if owner.scope.name ~= "nupp.runtime.core.pagemappings" then
        return false
    end
    return unit.ownerModule(owner, "nupp.runtime.core.pagemappings").exports[name] == owner
end

local function statusOutput(bound: any): any
    if bound.name ~= "unmapPages" then
        return nil
    end
    local owner = bound.owner
    -- The exact wrappers keep the real C status in a separately retained
    -- explicit Scope. A nil OS result never silently discards that status.
    need(
        (pageOwner(owner, "unmapOwned") or pageOwner(owner, "releaseEntry") or pageOwner(owner, "releaseshared"))
        and owner.paramKinds[1] == "voidptr",
        "unmap requires explicit owned wrapper scope"
    )
    local scope = need(
        unit.ownerModule(owner, "nupp.runtime.core.pagemappings").checkedExports.types.Scope,
        "checked page Scope required"
    )
    local target = need(layout.of(scope, bound.context.target), "page Scope layout required")
    local status = need(target.offsets.status, "page Scope status field")
    need(
        scope.byname.status.tag == "uint64" and status % 8 == 0 and status <= target.size - 8,
        "page Scope status layout"
    )

    return {parameter = 1, offset = status, bytes = target.size, type = scope}
end

export function call(owner: any, call: any): any
    local bound = unit.osDeclaration(owner, call)
    local spec = shape(bound)
    need(#call.args.exprs == #spec.params, "OS source argument count")
    local params, snapshot = {}, {}
    for index, kind in ipairs(spec.params) do
        params[index], snapshot[index] = kind, kind
    end
    local out = statusOutput(bound)
    local effect = {mayCollect = false, mayPark = false, mayRaise = false, pure = false}
    local machineResult = bound.name == "mapPages" and "voidptr" or spec.cResult
    local declaration = {
        moduleName = "nupp.runtime.vm.os",
        name = bound.name,
        params = params,
        result = machineResult,
        effects = effect
    }
    local result = bound.name == "mapPages" and physical.describe(bound.context, bound.signature.rets[1]) or nil
    issued[
        declaration
    ] = {
        bound = bound,
        slot = spec.slot,
        routine = spec.routine,
        params = snapshot,
        effect = effect,
        result = result,
        out = out,
        narrow = spec.narrow,
        fields = {
            moduleName = declaration.moduleName,
            name = declaration.name,
            params = params,
            result = machineResult,
            effects = effect
        }
    }

    return declaration
end

-- A call of a `cdef function` its sealed unit declares: a direct C call
-- through the symbol the first call resolves and the bridge's table keeps
-- (s0.select). Arguments past a variadic function's declared ones take the
-- kinds the caller gives them. A 32-bit C result reads as int64 where the
-- caller expects one or names no kind, since the call extends it.
export function foreign(owner: any, site: any, expected: string?): any
    local identity = need(cdefOf(site), "foreign site requires a cdef function")
    local definition = site.obj.token.definition
    need(
        unit.callee(owner, site) == nil and not (definition and definition.reassigned),
        "foreign callee is not its cdef"
    )
    local kind, library, symbol = (identity as string):match("^(.-)\0(.-)\0(.*)$")
    need(kind == "function" and symbol and symbol:match("^[%a_][%w_]*$"), "foreign symbol identity")
    local signature = site.obj.inferredType
    need(
        signature
        and signature.tag == "func"
        and signature.foreign
        and #signature.rets <= 1
        and not signature.borrowsResult
        and (signature.ffiOut == nil or #signature.ffiOut == 0),
        "foreign site requires a plain C signature"
    )
    local params, snapshot = {}, {}
    for index, parameter in ipairs(signature.params) do
        local mode = signature.paramModes and signature.paramModes[index] or "plain"
        need(mode == "plain" or mode == "borrows", "foreign parameter ownership")
        params[index] = foreignKind(parameter)
    end
    local fixed = #params
    local variadic = signature.paramPack.tail ~= nil
    local exprs = site.args.exprs or {}
    need(#exprs == fixed or variadic and #exprs > fixed, "foreign source argument count")
    for index = fixed + 1, #exprs do
        params[index] = foreignKind(exprs[index].inferredType)
    end
    table.move(params, 1, #params, 1, snapshot)
    local narrow = nil
    local machineResult = "nil"
    if signature.rets[1] then
        machineResult = foreignKind(signature.rets[1])
        if narrowKinds[machineResult] then
            narrow = machineResult
            -- Read as the 64-bit kind unless the caller asks for the narrow one.
            if expected == "int64" or expected == "uint64" then
                machineResult = expected
            elseif expected == nil then
                machineResult = WIDENED[machineResult]
            end
        end
    end
    local effect = {mayCollect = false, mayPark = false, mayRaise = false, pure = false}
    local declaration = {
        moduleName = "nupp.runtime.vm.foreign",
        name = symbol,
        params = params,
        result = machineResult,
        effects = effect
    }
    issued[
        declaration
    ] = {
        bound = {owner = owner, call = site, identity = identity, signature = signature},
        foreign = {
            library = library == "<default>" and "" or library,
            symbol = symbol,
            fixed = variadic and fixed or nil
        },
        params = snapshot,
        effect = effect,
        narrow = narrow,
        fields = {
            moduleName = declaration.moduleName,
            name = declaration.name,
            params = params,
            result = machineResult,
            effects = effect
        }
    }

    return declaration
end

-- What a foreign call resolves: its library ("" for the program's own
-- symbols), its symbol and, when it is variadic, how many arguments it
-- declares; nil for an OS import.
export function binding(declaration: any): any?
    validate(declaration)
    local resolved = issued[declaration].foreign
    return resolved and {library = resolved.library, symbol = resolved.symbol, fixed = resolved.fixed} or nil
end

-- The name a routine the selector writes in place is called by: the
-- generic foreign call, or the table's address with its import slot; nil
-- for an import or a foreign symbol.
export function routine(declaration: any): string?
    validate(declaration)
    local name = issued[declaration].routine
    if name == "cells" then
        return "routine\0cells\0" .. tostring(definitions.foreignTable.slot)
    end

    return name and "routine\0" .. name or nil
end

-- The C result a call answers in fewer than 64 bits, which the caller
-- extends: "int32" or "uint32", or nil.
export function narrow(declaration: any): string?
    validate(declaration)
    return issued[declaration].narrow
end

export function isIssued(declaration: any): boolean
    return issued[declaration] ~= nil
end

export function validate(declaration: any, owner: any?): any
    local held = need(issued[declaration], "unissued import contract")
    same(declaration, held.fields)
    same(declaration.params, held.params)
    same(declaration.effects, {mayCollect = false, mayPark = false, mayRaise = false, pure = false})
    if held.foreign then
        local bound = held.bound
        need(owner == nil or owner == bound.owner, "foreign source owner differs")
        need(
            cdefOf(bound.call) == bound.identity and bound.call.obj.inferredType == bound.signature,
            "foreign checked source changed"
        )
        return true
    end
    local bound = unit.osDeclaration(held.bound.owner, held.bound.call)
    need(owner == nil or owner == bound.owner, "OS source owner differs")
    need(
        bound.definition == held.bound.definition
        and bound.signature == held.bound.signature
        and bound.context == held.bound.context,
        "OS checked source changed"
    )
    need(shape(bound).slot == held.slot, "OS slot changed")
    local out = statusOutput(bound)
    if out then
        need(held.out ~= nil, "OS status output missing")
        same(out, held.out)
    else
        need(held.out == nil, "OS status output invented")
    end
    if held.result then
        physical.validate(held.result)
    end

    return true
end

export function result(declaration: any): any
    validate(declaration)
    return issued[declaration].result
end

export function status(declaration: any): any
    validate(declaration)
    local out = issued[declaration].out
    return out and {parameter = out.parameter, offset = out.offset, bytes = out.bytes} or nil
end

export function slot(declaration: any, owner: any?): integer
    validate(declaration, owner)
    return issued[declaration].slot
end

-- Runtime heap images may not expose unjournaled C mappings. Generic checked
-- graph inspection can describe mapPages, but authenticated publication admits
-- it only through the fixed ledger wrapper or the entry metadata bootstrap
-- in the same retained unit. Bootstrap storage has its own terminal owner.
export function ownedSlot(declaration: any, owner: any): integer
    local index = slot(declaration, owner)
    if index == 0 then
        need(
            pageOwner(owner, "map") or pageOwner(owner, "acquireEntry") or pageOwner(owner, "acquireshared"),
            "published map requires owned ledger wrapper"
        )
    end

    return index
end

export function graph(declaration: any, g: any, args: any, dst: integer): nil
    validate(declaration)
    local held = issued[declaration]
    local owner = held.bound.owner
    need(
        g.source
        and g.source.path == owner.scope.path
        and g.source.module == owner.scope.name
        and g.source.name == owner.name,
        "OS graph source differs"
    )
    if held.result then
        need(
            g.nativePhysical
            and g.nativePhysical.context == held.bound.context
            and g.nativePhysical.values[dst] == held.result,
            "OS optional result origin differs"
        )
    end
    if held.out then
        need(g.exactTypes[held.out.parameter] == "voidptr", "OS status output is not the explicit wrapper scope")
    end
end

-- Raw status is a visible SSA value and its scope write is a normal graph store.
-- No machine-only mutation is hidden behind the source's nil result.
export function verifyStores(g: any): nil
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            local declaration = op == "NativeHelperCall" and block.args[index][1] or nil
            local held = declaration and issued[declaration]
            if held and held.out then
                validate(declaration)
                need(
                    block.op[index + 1] == "NativeConstant"
                    and block.args[index + 1][1] == tostring(held.out.offset)
                    and g.exactTypes[block.dst[index + 1]] == "int64"
                    and block.op[index + 2] == "NativeStore",
                    "unmap status capture is incomplete"
                )
                local stored = block.args[index + 2]
                need(
                    stored[1] == held.out.parameter
                    and stored[2] == block.dst[index + 1]
                    and stored[3] == block.dst[index],
                    "unmap status output differs"
                )
                same(stored[4], {source = "borrowed", kind = "uint64", width = 8, signed = false, write = true})
            end
        end
    end
end
