module nupp.compiler.vm.functiongraph

local graph = require("nupp.compiler.vm.graph")
local cst = require("nupp.compiler.syntax.cst")
local cleanup = require("nupp.compiler.vm.functioncleanup")
local frontend = {}

local function need(ok: any, message: string): any
    assert(ok, "function graph: " .. message)
    return ok
end

-- Profiles select operations and contracts. This module alone traverses
-- checked syntax, resolves lexical bindings and constructs closed CFG blocks.
function frontend.compile(fn: any, options: any, profile: any): any
    need(fn and fn.body and fn.scope and fn.node, "checked function owner required")
    local moduleOwner = fn.kind == "module"
    need(
        moduleOwner and fn.node == fn.body and fn.body.kind == "chunk"
        or not moduleOwner and (fn.node.body == fn.body or fn.node == fn.body and fn.body.kind == "shortfn"),
        "checked owner body identity required"
    )
    need(
        type(fn.name) == "string" and type(fn.scope.path) == "string" and type(fn.scope.name) == "string",
        "checked function source required"
    )
    need(type(profile) == "table", "explicit lowering profile required")
    options = options or {}
    local initialize = moduleOwner and need(profile.initializeModule, "profile does not support module initialization")
        or profile.initialize
    local g = initialize(fn, options)
    g.source = {path = fn.scope.path, module = fn.scope.name, name = fn.name}
    local body, scope = fn.body, fn.scope
    local block = graph.block(g)
    local bindings: {[any]: integer} = {}
    local bindingOrder: {any} = {}
    -- Opaque temporary keys use the same ordered transport as lexical keys.
    -- Only explicit handles are read after a block change; SSA ids never remap
    -- behind a profile's back.
    local handles = {}
    local inlining, loops = {}, {}
    -- Only an explicit profile opts into cleanup and failure control. Legacy
    -- profiles keep their existing graph operations and refusal boundaries.
    local cleanupEnabled = profile.cleanupPlan ~= nil
    local cleanups, cleanupOwners, returnRoots = {}, {}, {}
    if cleanupEnabled then
        for _, name in ipairs({
            "cleanupFlag",
            "cleanupAllowed",
            "cleanupRun",
            "cleanupStatus",
            "failure",
            "stageReturn",
            "rootReturn",
            "rootBacking",
            "closeReturnRoots",
            "retainRootBacking",
            "finishReturn"
        }) do
            need(type(profile[name]) == "function", "cleanup profile lacks " .. name)
        end
    end
    -- An anonymous `...` has no name; its node keys the hidden pack parameter.
    local varargKey: any = nil
    for index, parameter in ipairs(moduleOwner and {} or graph.parameters(body)) do
        local key = parameter.name and not parameter.vararg and (parameter.name.definition or parameter.name)
            or parameter
        if parameter.vararg then
            varargKey = key
        end
        bindings[key] = index
        bindingOrder[#bindingOrder + 1] = key
    end
    local ctx: any = {g = g, fn = fn, options = options}
    -- The pack of extra arguments in a variadic function, as it is bound now.
    ctx.varargPack = function(): integer
        need(varargKey ~= nil, "`...` outside a variadic function")
        return need(bindings[varargKey], "variadic pack binding")
    end

    local function context(): nil
        ctx.block, ctx.scope = block, scope
    end

    local function position(node: any): integer
        local token = need(cst.firstToken(node), "source position required")
        local id = graph.position(g, token.line, token.col)
        g.positions[id].source = {moduleName = scope.name, path = scope.path}
        return id
    end

    ctx.position = position

    local function emit(node: any, op: string, args: any, kind: string?): integer?
        context()
        return profile.emit(ctx, node, op, args, kind)
    end

    ctx.emit = emit
    ctx.hasContinuation = function(): boolean
        return block ~= nil
    end
    ctx.storage = function(key: any): integer
        return need(bindings[key], "capture requires an initialized lexical binding")
    end
    ctx.bind = function(key: any, value: integer): nil
        need(bindings[key] == nil, "duplicate local binding")
        bindings[key] = value
        bindingOrder[#bindingOrder + 1] = key
    end

    ctx.hold = function(value: integer): any
        need(g.types[value] ~= nil, "held value is outside the graph")
        local handle = {}
        handles[handle], bindings[handle] = true, value
        bindingOrder[#bindingOrder + 1] = handle

        return handle
    end
    ctx.readHeld = function(handle: any): integer
        need(handles[handle] ~= nil, "foreign held-value handle")
        need(handles[handle] == true, "released held-value handle")
        return need(bindings[handle], "released held-value handle")
    end
    ctx.release = function(handle: any): nil
        ctx.readHeld(handle)
        handles[handle], bindings[handle] = false, nil
        for index, key in ipairs(bindingOrder) do
            if key == handle then
                table.remove(bindingOrder, index)
                return
            end
        end
        error("function graph: held-value order is incomplete", 0)
    end

    local function heldScope(): any
        local active = {}
        for _, key in ipairs(bindingOrder) do
            if handles[key] ~= nil then
                need(handles[key] == true, "branch restored a released held-value handle")
                active[key] = true
            end
        end

        return active
    end

    local function checkHeldScope(active: any): nil
        for _, key in ipairs(bindingOrder) do
            if handles[key] ~= nil then
                need(handles[key] == true, "branch restored a released held-value handle")
                need(active[key], "profile leaked a held-value handle")
                active[key] = nil
            end
        end
        need(next(active) == nil, "profile released an enclosing held-value handle")
    end

    -- Evaluate left to right, retaining every earlier operand until the last
    -- expression finishes. This helper neither selects syntax nor operations.
    ctx.operands = function(nodes: any, kinds: any): any
        local held, values = {}, {}
        for index, kind in ipairs(kinds) do
            local value = ctx.expression(nodes[index], kind)
            if not block then
                for previous = #held, 1, -1 do
                    ctx.release(held[previous])
                end
                return nil
            end
            held[index] = ctx.hold(value)
        end
        for index, handle in ipairs(held) do
            values[index] = ctx.readHeld(handle)
        end
        for index = #held, 1, -1 do
            ctx.release(held[index])
        end

        return values
    end

    local function initializeBinding(node: any, key: any, value: integer): integer
        context()
        return profile.initializeBinding and profile.initializeBinding(ctx, node, key, value) or value
    end

    local function writeBinding(node: any, key: any, value: integer): nil
        if cleanupEnabled then
            need(not cleanup.type(key.type), "assignment to an owning local requires reinitialization support")
        end
        context()
        bindings[key] = profile.writeBinding and profile.writeBinding(ctx, node, key, bindings[key], value) or value
    end

    local function invoke(name: string, node: any, expected: any): any
        context()
        local hook = need(profile[name], "profile lacks " .. name)
        local active = heldScope()
        local value = hook(ctx, node, expected)
        block = ctx.block
        checkHeldScope(active)

        return value
    end

    local branch: function(string?): any
    local resume: function(any): nil
    local jump: function(any, any): nil
    local currentEdge: function(any): any
    local expression: function(any, string?): integer?
    local unwind: function(integer, any, string, any?): nil
    local registerCleanup: function(any, any, any, integer): nil
    local transfer: function(any, any): nil
    local expressionBody: function(any, string?): integer?
    expressionBody = function(node: any, expected: string?): integer?
        if node.kind == "paren" then
            return expression(node.expr, expected)
        elseif node.kind == "name" then
            local value = bindings[node.token.definition or node.token]
            if value == nil then
                return invoke("constant", node, expected)
            end
            context()
            if profile.readBinding then
                return profile.readBinding(ctx, node, node.token.definition or node.token, value, expected)
            end
            need(expected == nil or profile.valueKind(g, value) == expected, "local changes exact kind")
            return value as integer
        elseif node.kind == "funcExpr" or node.kind == "shortfn" then
            return invoke("closure", node, expected)
        elseif profile.valueLiteral
            and (node.kind == "string" or node.kind == "dedentString" or node.kind == "nilExpr")
        then
            return invoke("valueLiteral", node, expected)
        elseif node.kind == "number"
            or node.kind == "true"
            or node.kind == "false"
            or node.kind == "trueExpr"
            or node.kind == "falseExpr"
        then
            return invoke("literal", node, expected)
        elseif node.kind == "newExpr" then
            return invoke("construction", node, expected)
        elseif node.kind == "castExpr" then
            return invoke("cast", node, expected)
        elseif node.kind == "dotIndex" then
            return invoke(profile.fieldRead and "fieldRead" or "constant", node, expected)
        elseif node.kind == "vararg" then
            return invoke("vararg", node, expected)
        elseif node.kind == "tableExpr" then
            return invoke("tableConstructor", node, expected)
        elseif node.kind == "bracketIndex" then
            return invoke("indexRead", node, expected)
        elseif node.kind == "unop" then
            return invoke("unary", node, expected)
        elseif node.kind == "call" then
            return invoke("call", node, expected)
        elseif node.kind == "methodCall" and profile.methodCall then
            return invoke("methodCall", node, expected)
        elseif node.kind == "switchExpr" then
            need(profile.switchCase and not cleanupEnabled, "numeric switch profile required")
            need(node.elseCase and #node.cases > 0, "numeric switch requires an else arm")
            local selectorKind = profile.kind(node.selector.inferredType)
            local resultKind = profile.kind(node.inferredType)
            need(expected == nil or expected == resultKind, "switch changes exact result kind")
            local selector = expression(node.selector, selectorKind)
            if not block then
                return nil
            end
            local handle = ctx.hold(selector as integer)
            local done = branch(resultKind)

            local function armValue(arm: any): integer?
                local value = need(arm.expr, "numeric switch arm needs an expression")
                if value.kind ~= "doExpr" then
                    return expression(value, resultKind)
                end
                local stats = need(value.body and value.body.stats, "numeric switch do body required")
                need(#stats > 0 and stats[#stats].kind == "yieldStmt", "numeric switch do arm must yield")
                for index = 1, #stats - 1 do
                    need(stats[index].kind == "callStmt", "numeric switch do arm only admits calls before yield")
                    invoke("statementCall", stats[index].expr, nil)
                    if not block then
                        return nil
                    end
                end

                return expression(need(stats[#stats].value, "numeric switch yield needs a value"), resultKind)
            end

            local function complete(arm: any): nil
                local value = armValue(arm)
                if block then
                    local edge = currentEdge(done)
                    table.insert(edge.args, 1, need(value, "numeric switch arm loses its value"))
                    block.term = {kind = "jump", edges = {edge}, pos = position(arm)}
                    block = nil
                end
            end

            for _, arm in ipairs(node.cases) do
                need(
                    arm.patternKind == "static" and not arm.guard and #arm.values == 1,
                    "numeric switch admits one unguarded static value per arm"
                )
                context()
                local matched = profile.switchCase(ctx, arm.values[1], ctx.readHeld(handle), selectorKind)
                need(block ~= nil and profile.valueKind(g, matched) == profile.booleanKind, "numeric switch match kind")
                local parent = block
                local yes, no = branch(), branch()
                parent.term = {kind = "branch", value = matched, edges = {yes.edge, no.edge}, pos = position(arm)}
                resume(yes)
                complete(arm)
                resume(no)
            end
            complete(node.elseCase)
            resume(done)
            ctx.release(handle)
            context()

            return done.result
        elseif node.kind == "istring" and profile.interpolation then
            return invoke("interpolation", node, expected)
        elseif node.kind == "binop" then
            local operator = node.op.text
            if operator ~= "and" and operator ~= "or" then
                return invoke("binary", node, expected)
            end
            need(not profile.checkLogical or profile.checkLogical(ctx, node), "unsupported logical expression")
            local boolean = profile.booleanKind
            need(expected == nil or expected == boolean, "logical expression requires boolean result")
            need(
                profile.kind(node.inferredType) == boolean
                and profile.kind(node.lhs.inferredType) == boolean
                and profile.kind(node.rhs.inferredType) == boolean,
                "logical expression requires exact booleans"
            )
            local cleanupDepth = #cleanups
            local lhs = expression(node.lhs, boolean)
            if not block then
                return nil
            end
            need(
                not cleanupEnabled or #cleanups == cleanupDepth,
                "owning temporaries in logical expressions require conditional cleanup"
            )
            assert(lhs ~= nil, "function graph: continued logical operand requires a value")
            local key = {}
            bindings[key], bindingOrder[#bindingOrder + 1] = lhs, key
            local parent = block
            local right, done = branch(), branch()
            bindings[key], bindingOrder[#bindingOrder] = nil, nil
            parent.term = {
                kind = "branch",
                value = lhs,
                edges = operator == "and" and {right.edge, done.edge} or {done.edge, right.edge},
                pos = position(node)
            }
            resume(right)
            local rhs = expression(node.rhs, boolean)
            need(
                not cleanupEnabled or #cleanups == cleanupDepth,
                "owning temporaries in logical expressions require conditional cleanup"
            )
            if block then
                assert(rhs ~= nil, "function graph: continued logical operand requires a value")
                bindings[key] = rhs
                jump(done, node)
            end
            resume(done)
            local result = bindings[key]
            bindings[key], bindingOrder[#bindingOrder] = nil, nil
            context()
            return result as integer
        end
        error("function graph: unsupported checked expression " .. tostring(node.kind), 0)
    end
    expression = function(node: any, expected: string?): integer?
        if cleanupEnabled then
            need(
                not node.automaticOwnerReinit and not node.automaticOwnerReinitializations and not node.affineAggregate,
                "owner reinitialization or aggregate cleanup is unsupported"
            )
        end
        local value = expressionBody(node, expected)
        if not block then
            return nil
        end
        assert(value ~= nil, "function graph: continued expression requires a value")
        -- A fresh result owns its cleanup before a later initializer/argument
        -- can fail. Publishing it as a local owner or taking it consumes
        -- this temporary, never the original owner's obligation twice.
        if cleanupEnabled and block and node.kind == "call" then
            local t = cleanup.type(node.inferredType)
            if t then
                registerCleanup(node, node.statementOwner or node, t, value)
            end
        end

        return value
    end
    ctx.expression = expression
    branch = function(resultKind: string?, resultCount: integer?): any
        local target = graph.block(g)
        local result
        local results = {}
        if resultKind then
            -- A call's results are the continuation's leading parameters.
            for index = 1, resultCount or 1 do
                results[index] = profile.newValue(g, resultKind)
                target.params[index] = results[index]
            end
            result = results[1]
        end
        local transported, order, args, keys = {}, {}, {}, {}
        for _, key in ipairs(bindingOrder) do
            local value = bindings[key]
            order[#order + 1] = key
            if value <= g.nparams
                and (handles[key] == true or key.token and key.token.definition == key and not key.reassigned)
            then
                transported[key] = value
            else
                local parameter = (
                    profile.copyValue and profile.copyValue(g, value)
                    or profile.newValue(g, profile.valueKind(g, value))
                )
                target.params[#target.params + 1] = parameter
                args[#args + 1] = value
                keys[#keys + 1] = key
                transported[key] = parameter
            end
        end

        return {
            block = target,
            result = result,
            results = results,
            bindings = transported,
            order = order,
            keys = keys,
            edge = {target = target.id, args = args}
        }
    end

    resume = function(state: any): nil
        block, bindings, bindingOrder = state.block, state.bindings, state.order
    end

    currentEdge = function(state: any): any
        local args = {}
        for _, key in ipairs(state.order) do
            if state.bindings[key] <= g.nparams then
                need(bindings[key] == state.bindings[key], "loop changes a function parameter binding")
            end
        end
        for index, key in ipairs(state.keys) do
            args[index] = need(bindings[key], "loop loses a checked local binding")
        end

        return {target = state.block.id, args = args}
    end

    jump = function(state: any, node: any): nil
        block.term = {kind = "jump", edges = {currentEdge(state)}, pos = position(node)}
        block = nil
    end

    -- A loop a library form builds, table.sort's comparator calls: `step`
    -- answers a value whose truth goes round again, and `body` emits one
    -- iteration. What either needs across iterations it holds.
    ctx.loop = function(node: any, step: any, body: any): nil
        local before = need(block, "loop after terminator")
        local header = branch()
        before.term = {kind = "jump", edges = {header.edge}, pos = position(node)}
        resume(header)
        context()
        local condition = step(ctx, node)
        block = ctx.block
        if not block then
            return
        end
        local enter, exit = branch(), branch()
        block.term = {kind = "branch", value = condition, edges = {enter.edge, exit.edge}, pos = position(node)}
        block = nil
        resume(enter)
        context()
        body(ctx, node)
        block = ctx.block
        if block then
            jump(header, node)
        end
        resume(exit)
        context()
    end

    -- How many results a last call supplies when `count` targets outnumber the
    -- expressions, or nil when the profile has no multi-result calls.
    local function spreadCall(exprs: any, count: integer): integer?
        local last = exprs[#exprs]
        if not profile.callResults or not last or count <= #exprs then
            return nil
        end
        if last.kind ~= "call" and last.kind ~= "methodCall" and last.kind ~= "vararg" then
            return nil
        end

        return count - #exprs + 1
    end

    local function flag(node: any, value: boolean): integer
        context()
        local result = profile.cleanupFlag(ctx, node, value)
        need(
            ctx.block == block and profile.valueKind(g, result) == profile.booleanKind,
            "cleanup flag must be an ordinary Boolean value"
        )

        return result
    end

    local function removeBinding(key: any): nil
        bindings[key] = nil
        for index, item in ipairs(bindingOrder) do
            if item == key then
                table.remove(bindingOrder, index)
                return
            end
        end
        need(block == nil, "missing cleanup binding")
    end

    registerCleanup = function(site: any, owner: any, t: any, value: integer): nil
        need(cleanupEnabled and block, "cleanup acquisition requires an active cleanup profile")
        need(cleanupOwners[owner] == nil, "cleanup owner registered twice")
        context()
        local active = heldScope()
        local plan = need(profile.cleanupPlan(ctx, site, t, t.cleanups, owner), "checked cleanup plan required")
        need(ctx.block == block, "cleanup planning must not change control flow")
        checkHeldScope(active)
        local entry = {owner = owner, site = site, plan = plan, value = {}, live = {}, temporary = site.kind == "call"}
        ctx.bind(entry.value, value)
        ctx.bind(entry.live, flag(site, true))
        cleanups[#cleanups + 1], cleanupOwners[owner] = entry, entry
    end

    transfer = function(node: any, owner: any): nil
        local entry = need(cleanupOwners[cleanup.move(owner)], "transfer lacks a registered checked owner")
        bindings[entry.live] = flag(node, false)
    end

    local function expressionOwner(node: any): any
        local source = cleanup.source(node)
        if not source then
            return nil
        end
        if source.automaticOwnerMove then
            return cleanup.move(source.automaticOwnerMove)
        elseif source.kind == "call" and cleanup.type(source.inferredType) then
            return source.statementOwner or source
        end

        return nil
    end

    local function transferExpression(node: any): nil
        local owner = expressionOwner(node)
        if owner then
            transfer(node, owner)
        end
    end

    -- A profile calls this only after resolving the checked callee and
    -- evaluating every argument, immediately before the actual call. Nested
    -- calls have already updated their own independent live flags.
    ctx.beforeCall = function(node: any): nil
        need(cleanupEnabled and block and node.kind == "call", "checked call transfer requires cleanup profile")
        for _, move in ipairs(node.automaticOwnerMoves or {}) do
            transfer(node, move)
        end
        local t = node.obj.inferredType
        need(t and t.tag == "func" and t.paramPack, "checked closed call signature required")
        for index, argument in ipairs(node.args.exprs) do
            if t.paramPack.modes and t.paramPack.modes[index] == "takes" then
                local source = cleanup.source(argument)
                if source and source.kind == "call" and cleanup.type(source.inferredType) then
                    transfer(source, source.statementOwner or source)
                end
            end
        end
        context()
    end

    local function runCleanup(entry: any, node: any, reason: string): nil
        local condition, parent = bindings[entry.live], block
        local yes, done = branch(), branch()
        parent.term = {kind = "branch", value = condition, edges = {yes.edge, done.edge}, pos = position(node)}
        resume(yes)
        context()
        local permission = profile.cleanupAllowed(ctx, node, entry.plan)
        need(
            ctx.block == block and profile.valueKind(g, permission) == profile.booleanKind,
            "cleanup requires an explicit backing-retention guard"
        )
        local checked, allowed = block, branch()
        checked.term = {
            kind = "branch",
            value = permission,
            edges = {allowed.edge, currentEdge(done)},
            pos = position(node)
        }
        resume(allowed)
        -- A retained outer scope leaves this owner live; never disarm or
        -- invoke its terminal merely because an inner operation failed.
        -- Clear before invoking a terminal, including a failing terminal.
        -- cleanupRun must retain sticky failure and continue cleanup; it
        -- must not use the ordinary afterCall error edge recursively.
        bindings[entry.live] = flag(node, false)
        context()
        local active = heldScope()
        profile.cleanupRun(ctx, node, entry.plan, bindings[entry.value], reason)
        block = ctx.block
        need(block ~= nil, "cleanup must continue to remaining obligations")
        checkHeldScope(active)
        jump(done, node)
        resume(done)
    end

    unwind = function(depth: integer, node: any, reason: string, retained: any?): nil
        need(depth >= 0 and depth <= #cleanups, "invalid cleanup depth")
        for index = #cleanups, depth + 1, -1 do
            local entry = cleanups[index]
            if not retained or not retained[entry] then
                runCleanup(entry, node, reason)
            end
        end
        context()
    end

    local function finishTemporaries(depth: integer, node: any): nil
        local hadTemporary = false
        for index = #cleanups, depth + 1, -1 do
            local entry = cleanups[index]
            if entry.temporary then
                hadTemporary = true
                if block then
                    runCleanup(entry, node, "statement")
                end
                removeBinding(entry.live)
                removeBinding(entry.value)
                cleanupOwners[entry.owner] = nil
                table.remove(cleanups, index)
            end
        end
        context()
        if block and hadTemporary then
            local success = profile.cleanupStatus(ctx, node)
            ctx.afterCall(node, nil, success)
        end
    end

    local function forgetCleanups(depth: integer): nil
        for index = #cleanups, depth + 1, -1 do
            local entry = cleanups[index]
            removeBinding(entry.live)
            removeBinding(entry.value)
            cleanupOwners[entry.owner], cleanups[index] = nil, nil
        end
    end

    local function protectedRoots(): any
        local protected = {}
        for _, entry in ipairs(returnRoots) do
            for owner in pairs(entry.backing) do
                protected[owner] = true
            end
        end

        return protected
    end

    local function closeRoots(node: any, reason: string): nil
        for index = #returnRoots, 1, -1 do
            local entry = returnRoots[index]
            local condition, parent = bindings[entry.live], block
            local yes, done = branch(), branch()
            parent.term = {kind = "branch", value = condition, edges = {yes.edge, done.edge}, pos = position(node)}
            resume(yes)
            context()
            local active = heldScope()
            -- Closing is nonallocating/nonraising, but may refuse. The profile
            -- records sticky failure; a refusal retains registrations and all
            -- backing owners. Never retry close or release that storage here.
            local success = profile.closeReturnRoots(ctx, node, entry.plan, reason)
            need(
                ctx.block == block and profile.valueKind(g, success) == profile.booleanKind,
                "return root retirement requires an explicit success condition"
            )
            checkHeldScope(active)
            local closing, closed, refused = block, branch(), branch()
            closing.term = {kind = "branch", value = success, edges = {closed.edge, refused.edge}, pos = position(node)}
            resume(refused)
            context()
            profile.retainRootBacking(ctx, node, entry.plan)
            need(ctx.block == block, "root backing retention must not change control flow")
            unwind(0, node, "failure", protectedRoots())
            invoke("failure", node, nil)
            need(block == nil, "root retirement refusal must terminate")
            resume(closed)
            bindings[entry.live] = flag(node, false)
            jump(done, node)
            resume(done)
        end
        context()
    end

    ctx.fail = function(node: any): nil
        need(cleanupEnabled and block, "failure requires an active cleanup profile")
        if profile.beforeFailure then
            -- A profile may retain caller-owned backing before any lexical
            -- terminal runs. It must preserve this failure continuation.
            context()
            local active = heldScope()
            profile.beforeFailure(ctx, node)
            need(ctx.block == block and block.term == nil, "failure preparation must preserve control flow")
            checkHeldScope(active)
        end
        unwind(0, node, "failure", protectedRoots())
        closeRoots(node, "failure")
        unwind(0, node, "failure")
        invoke("failure", node, nil)
        need(block == nil, "failure profile must terminate")
    end

    ctx.afterCall = function(node: any, value: integer?, success: integer): integer?
        need(
            cleanupEnabled and block and profile.valueKind(g, success) == profile.booleanKind,
            "call continuation requires a checked Boolean success condition"
        )
        local parent = block
        local no = branch()
        local held = value and ctx.hold(value) or nil
        local yes = branch()
        parent.term = {kind = "branch", value = success, edges = {yes.edge, no.edge}, pos = position(node)}
        resume(no)
        ctx.fail(node)
        resume(yes)
        local result = held and ctx.readHeld(held) or nil
        if held then
            ctx.release(held)
        end
        context()

        return result
    end

    local function finishScope(depth: integer, node: any): nil
        local hadCleanup = #cleanups > depth
        if block then
            unwind(depth, node, "scope")
        end
        forgetCleanups(depth)
        if block and hadCleanup then
            context()
            local success = profile.cleanupStatus(ctx, node)
            ctx.afterCall(node, nil, success)
        end
    end

    local function cleanupReturn(node: any, falling: boolean): nil
        -- A handler returns only by transfer (dispatch, failure or a support
        -- tail), never a staged value, and its scope belongs to the entry.
        if g.native and g.native.abi == "handler" then
            need(not falling, "a handler ends in a transfer")
            invoke("returnStatement", node, nil)
            return
        end
        -- The profile stages zero/one result and roots it before any terminal
        -- can allocate. SSA retention alone is deliberately not a GC proof.
        context()
        local stage = profile.stageReturn(ctx, node, falling)
        block = ctx.block
        if not block then
            return
        end
        -- A guest function stages up to sixteen results and a spread pack.
        need(
            stage and stage.values and (#stage.values <= 1 or g.native == nil and #stage.values <= 17),
            "closed staged return required"
        )
        local held = {}
        for index, value in ipairs(stage.values) do
            held[index] = ctx.hold(value)
        end
        context()
        local roots = need(profile.rootReturn(ctx, node, stage, held), "return cleanup requires a root plan")
        block = ctx.block
        need(block ~= nil, "return rooting must retain a success continuation")
        local rootEntry = {plan = roots, live = {}, backing = {}}
        -- The profile must bind these to checked ownership identities and
        -- prove their eventual teardown cannot allocate after root retirement.
        -- Neither helper names nor raw pointer machine kinds establish this.
        for _, owner in ipairs(profile.rootBacking(ctx, node, roots)) do
            rootEntry.backing[need(cleanupOwners[owner], "root backing lacks a registered checked owner")] = true
        end
        need(ctx.block == block, "root backing query must not change control flow")
        ctx.bind(rootEntry.live, flag(node, true))
        returnRoots[#returnRoots + 1] = rootEntry
        local retained = {}
        if not falling then
            for _, value in ipairs(node.exprs or {}) do
                local owner = expressionOwner(value)
                if owner then
                    retained[need(cleanupOwners[owner], "returned owner lacks cleanup")] = true
                end
            end
        end
        -- A selected owning result is still ours until all other cleanup has
        -- succeeded. If a terminal fails, the failure path also discharges it.
        local protected = protectedRoots()
        for entry in pairs(retained) do
            protected[entry] = true
        end
        unwind(0, node, "return", protected)
        local success = profile.cleanupStatus(ctx, node)
        ctx.afterCall(node, nil, success)
        closeRoots(node, "return")
        unwind(0, node, "return", retained)
        success = profile.cleanupStatus(ctx, node)
        ctx.afterCall(node, nil, success)
        for entry in pairs(retained) do
            transfer(node, entry.owner)
        end
        local values = {}
        for index, handle in ipairs(held) do
            values[index] = ctx.readHeld(handle)
        end
        context()
        profile.finishReturn(ctx, node, stage, values, roots)
        block = ctx.block
        need(block == nil, "staged return must terminate after cleanup status is checked")
        for index = #held, 1, -1 do
            ctx.release(held[index])
        end
        need(returnRoots[#returnRoots] == rootEntry, "return root scopes must be nested")
        returnRoots[#returnRoots] = nil
        removeBinding(rootEntry.live)
    end

    -- `spread` is a variadic pack whose values follow the fixed arguments;
    -- `open` keeps every result, as one pack.
    ctx.invoke = function(
        node: any,
        calleeValue: integer,
        args: any,
        contract: any,
        keepResult: boolean,
        spread: integer?,
        open: boolean?
    ): integer?
        need(g.native == nil and g.types[calleeValue] == "v", "guest invoke requires a tagged callee")
        local parent = need(block, "invoke after terminator")
        local continuation = branch(keepResult and "tagged" or nil)
        parent.term = {
            kind = "invoke",
            callee = calleeValue,
            args = args,
            contract = contract,
            result = continuation.result,
            spread = spread,
            open = open == true or nil,
            edges = {continuation.edge},
            pos = position(node)
        }
        resume(continuation)
        context()

        return continuation.result
    end
    -- A call keeping `count` results, as `local a, b = f()` does.
    ctx.invokeMany = function(
        node: any,
        calleeValue: integer,
        args: any,
        contract: any,
        count: integer,
        spread: integer?
    ): {integer}
        need(g.native == nil and g.types[calleeValue] == "v", "guest invoke requires a tagged callee")
        need(count >= 1 and count <= 16, "a call keeps one to sixteen results")
        local parent = need(block, "invoke after terminator")
        local continuation = branch("tagged", count)
        parent.term = {
            kind = "invoke",
            callee = calleeValue,
            args = args,
            contract = contract,
            result = continuation.result,
            results = continuation.results,
            spread = spread,
            edges = {continuation.edge},
            pos = position(node)
        }
        resume(continuation)
        context()

        return continuation.results
    end

    local function callee(call: any): any
        if call.kind ~= "call" then
            return nil
        end
        if profile.resolveCallee then
            local handled, target = profile.resolveCallee(ctx, call)
            if handled then
                return target
            end
        end
        if options.program then
            need(call.obj.kind == "name", "qualified or indirect callee lacks a stable composition target")
            local token = call.obj.token
            local definition = token and token.definition
            local target = definition and options.program.functionsByDefinition[definition]
            need(not target or not definition.reassigned, "composed function declaration was reassigned")
            return target
        end
        if call.obj.kind == "name" then
            local target = scope.functions and scope.functions[call.obj.token.text]
            if target then
                local token = target.node.kind == "funcStmt" and target.node.name.base or target.node.name
                need(
                    token and call.obj.token.definition == (token.definition or token),
                    "composed call must name its checked declaration"
                )
            end
            return target
        elseif call.obj.kind == "dotIndex" and call.obj.obj.kind == "name" then
            local definition = call.obj.obj.token.definition
            local moduleName = definition and definition.requiredModule
            local home = moduleName and options.modules and options.modules[moduleName]
            return home and home.exports and home.exports[call.obj.name.text] or nil
        end

        return nil
    end

    ctx.callee = callee
    ctx.checkedCallee = function(call: any, target: any): any
        context()
        return profile.declaration(ctx, call, target)
    end

    local statements: function(any): nil

    local function inline(call: any, target: any, returns: boolean): nil
        need(not cleanupEnabled, "cleanup profiles require ordinary calls, not body inlining")
        context()
        local declaration = profile.inlineContract(ctx, call, target, returns)
        need(not inlining[target], "recursive composed helper")
        local values = ctx.operands(call.args.exprs, target.paramKinds)
        local outerBindings, outerOrder, outerScope = bindings, bindingOrder, scope
        bindings, bindingOrder, scope = {}, {}, target.scope
        for index, key in ipairs(outerOrder) do
            bindings[key], bindingOrder[index] = outerBindings[key], key
        end
        for index, parameter in ipairs(graph.parameters(target.body)) do
            local key = parameter.name.definition or parameter.name
            bindings[key] = values[index]
            bindingOrder[#bindingOrder + 1] = key
        end
        g.compositions = g.compositions or {}
        g.compositions[#g.compositions + 1] = declaration
        inlining[target] = true
        statements(target.body.body.stats)
        inlining[target] = nil
        need(returns and block == nil or not returns and block ~= nil, "composed helper continuation is incomplete")
        if not returns then
            for _, key in ipairs(outerOrder) do
                outerBindings[key] = need(bindings[key], "composed helper loses caller binding")
            end
        end
        bindings, bindingOrder, scope = outerBindings, outerOrder, outerScope
        context()
    end

    ctx.inline = inline
    statements = function(stats: any): nil
        for _, stat in ipairs(stats) do
            local statementDepth = #cleanups
            if cleanupEnabled and not block then
                return
            end
            need(block ~= nil or stat.kind == "emptyStmt", "statement after dispatch")
            context()
            if cleanupEnabled then
                need(
                    not stat.automaticOwnerReinit
                    and not stat.ownerCleanupGuards
                    and not stat.affineAggregate
                    and not stat.affineInitializer,
                    "partial, reinitialized or closure owner cleanup is unsupported"
                )
            end
            if profile.checkStatement then
                profile.checkStatement(ctx, stat)
            end
            if stat.kind == "localStmt" then
                if stat.pattern then
                    invoke("erasedPattern", stat, nil)
                else
                    need(#stat.exprs <= #stat.names, "too many local initializer values")
                    need(profile.missingLocal or #stat.names == #stat.exprs, "plain initialized locals required")
                    local values = {}
                    -- A last call fills every remaining name with its results.
                    local spread, spreadValues = spreadCall(stat.exprs, #stat.names), nil
                    -- All RHS see the old lexical environment. Publication and
                    -- cell allocation happen only after every RHS was evaluated.
                    for index, token in ipairs(stat.names) do
                        local kind = profile.localKind(token, fn)
                        local value
                        if spread and index >= #stat.exprs then
                            if index == #stat.exprs then
                                spreadValues = profile.callResults(ctx, stat.exprs[index], spread)
                            end
                            value = spreadValues and spreadValues[index - #stat.exprs + 1]
                        elseif stat.exprs[index] then
                            value = expression(stat.exprs[index], kind)
                        else
                            value = invoke("missingLocal", stat, kind)
                        end
                        if not block then
                            for previous = #values, 1, -1 do
                                ctx.release(values[previous])
                            end
                            finishTemporaries(statementDepth, stat)
                            return
                        end
                        values[index] = ctx.hold(value)
                    end
                    for index, token in ipairs(stat.names) do
                        local key = token.definition or token
                        local value = ctx.readHeld(values[index])
                        if cleanupEnabled then
                            local owner = cleanup.localOwner(stat, index)
                            if owner then
                                transferExpression(stat.exprs[index])
                                registerCleanup(stat, owner, owner.type, value)
                            end
                        end
                        ctx.bind(key, initializeBinding(stat, key, value))
                    end
                    for index = #values, 1, -1 do
                        ctx.release(values[index])
                    end
                end
            elseif stat.kind == "funcStmt" and profile.functionStatement then
                invoke("functionStatement", stat, nil)
            elseif stat.kind == "localFuncStmt" and profile.closure then
                local key = stat.name.definition or stat.name
                local initial = invoke("recursiveBinding", stat, key)
                if initial then
                    ctx.bind(key, initial)
                end
                local value = invoke("closure", stat, nil)
                if initial then
                    writeBinding(stat, key, value)
                else
                    ctx.bind(key, initializeBinding(stat, key, value))
                end
            elseif stat.kind == "assignStmt" then
                local spread, spreadValues = spreadCall(stat.exprs, #stat.targets), nil
                need(
                    #stat.targets == #stat.exprs or spread ~= nil,
                    "parallel local assignment requires one value per target"
                )
                local values, targets = {}, {}
                -- Capture every LHS address before the RHS list. A later RHS
                -- may branch or change memory, so receivers are held as SSA.
                for index, target in ipairs(stat.targets) do
                    if target.kind == "name" then
                        local key = target.token.definition or target.token
                        local previous = need(bindings[key], "assignment requires a checked local binding")
                        targets[index] = {key = key, kind = profile.valueKind(g, previous)}
                    else
                        local prepared = invoke("assignmentTarget", target, stat.exprs[index])
                        if not block then
                            for _, old in ipairs(targets) do
                                if old.heldReceiver then
                                    ctx.release(old.heldReceiver)
                                end
                            end
                            finishTemporaries(statementDepth, stat)
                            return
                        end
                        prepared.heldReceiver = ctx.hold(prepared.receiver)
                        -- A keyed target evaluates its key before the values too.
                        if prepared.index then
                            prepared.heldIndex = ctx.hold(prepared.index)
                        end
                        targets[index] = prepared
                    end
                end
                for index, target in ipairs(targets) do
                    local value
                    if spread and index >= #stat.exprs then
                        if index == #stat.exprs then
                            spreadValues = profile.callResults(ctx, stat.exprs[index], spread)
                        end
                        value = spreadValues and spreadValues[index - #stat.exprs + 1]
                    else
                        value = expression(stat.exprs[index], target.kind)
                    end
                    if not block then
                        for previous = #values, 1, -1 do
                            ctx.release(values[previous])
                        end
                        for _, old in ipairs(targets) do
                            if old.heldReceiver then
                                ctx.release(old.heldReceiver)
                            end
                        end
                        finishTemporaries(statementDepth, stat)
                        return
                    end
                    values[index] = ctx.hold(value)
                end
                -- Lua stores right to left: a repeated destination retains
                -- its leftmost assignment. All RHS values are already held.
                for index = #targets, 1, -1 do
                    if not block then
                        break
                    end
                    local target = targets[index]
                    if target.key then
                        writeBinding(stat, target.key, ctx.readHeld(values[index]))
                    else
                        context()
                        profile.assignTarget(
                            ctx,
                            stat.targets[index],
                            target,
                            ctx.readHeld(target.heldReceiver),
                            ctx.readHeld(values[index])
                        )
                        block = ctx.block
                    end
                end
                for index = #values, 1, -1 do
                    ctx.release(values[index])
                end
                for index = #targets, 1, -1 do
                    if targets[index].heldReceiver then
                        ctx.release(targets[index].heldReceiver)
                    end
                    if targets[index].heldIndex then
                        ctx.release(targets[index].heldIndex)
                    end
                end
            elseif stat.kind == "callStmt" then
                invoke("statementCall", stat.expr, nil)
            elseif stat.kind == "ifStmt" then
                -- A condition call can append a temporary held result before
                -- resuming into a new binding table. Keep only the enclosing
                -- lexical/held scope, not that predecessor's mutated array.
                local originalBindings, originalOrder = {}, {}
                for _, key in ipairs(bindingOrder) do
                    originalOrder[#originalOrder + 1] = key
                    originalBindings[key] = bindings[key]
                end
                local incoming = {}

                local function continuation(): nil
                    if block then
                        incoming[#incoming + 1] = {block = block, bindings = bindings}
                    end
                end

                for _, clause in ipairs(stat.clauses) do
                    need(not clause.binding, "unsupported checked binding clause")
                    local conditionDepth = #cleanups
                    local condition = expression(clause.cond, profile.booleanKind)
                    if not block then
                        break
                    end
                    need(
                        not cleanupEnabled or #cleanups == conditionDepth,
                        "owning temporaries in a condition require conditional cleanup"
                    )
                    local parent = block
                    local yes, no = branch(), branch()
                    parent.term = {
                        kind = "branch",
                        value = condition,
                        edges = {yes.edge, no.edge},
                        pos = position(clause)
                    }
                    resume(yes)
                    local depth = #cleanups
                    statements(clause.body.stats)
                    if cleanupEnabled then
                        finishScope(depth, clause)
                    end
                    continuation()
                    resume(no)
                end
                if stat.elseClause and block then
                    local depth = #cleanups
                    statements(stat.elseClause.body.stats)
                    if cleanupEnabled then
                        finishScope(depth, stat.elseClause)
                    end
                end
                continuation()
                block = nil
                bindings, bindingOrder = {}, {}
                if #incoming > 0 then
                    local join = graph.block(g)
                    local transported = {}
                    for _, key in ipairs(originalOrder) do
                        local original = originalBindings[key]
                        local unchanged = original <= g.nparams
                        for _, state in ipairs(incoming) do
                            need(
                                state.bindings[key] ~= nil,
                                handles[key] ~= nil and "conditional loses an enclosing held-value handle"
                                or "conditional loses a checked local"
                            )
                            unchanged = unchanged and state.bindings[key] == original
                        end
                        bindingOrder[#bindingOrder + 1] = key
                        if unchanged then
                            bindings[key] = original
                        else
                            local parameter = (
                                profile.copyValue and profile.copyValue(g, original)
                                or profile.newValue(g, profile.valueKind(g, original))
                            )
                            join.params[#join.params + 1] = parameter
                            transported[#transported + 1] = key
                            bindings[key] = parameter
                        end
                    end
                    for _, state in ipairs(incoming) do
                        local args = {}
                        for index, key in ipairs(transported) do
                            args[index] = state.bindings[key]
                        end
                        state.block.term = {
                            kind = "jump",
                            edges = {{target = join.id, args = args}},
                            pos = position(stat)
                        }
                    end
                    block = join
                end
            elseif stat.kind == "whileStmt" then
                local before = block
                local header = branch()
                before.term = {kind = "jump", edges = {header.edge}, pos = position(stat)}
                resume(header)
                local conditionDepth = #cleanups
                local condition = expression(stat.cond, profile.booleanKind)
                need(
                    not cleanupEnabled or #cleanups == conditionDepth,
                    "owning temporaries in a loop condition require iteration cleanup"
                )
                if not block then
                    finishTemporaries(statementDepth, stat)
                    return
                end
                local body, exit = branch(), branch()
                block.term = {kind = "branch", value = condition, edges = {body.edge, exit.edge}, pos = position(stat)}
                loops[#loops + 1] = {exit = exit, continueTo = header, cleanupDepth = #cleanups}
                resume(body)
                local depth = #cleanups
                statements(stat.body.stats)
                if cleanupEnabled then
                    finishScope(depth, stat)
                end
                if block then
                    jump(header, stat)
                end
                loops[#loops] = nil
                resume(exit)
            elseif stat.kind == "fornumStmt" or stat.kind == "forinStmt" and profile.genericFor then
                -- The profile evaluates all three controls before the loop
                -- variable is bound, since it may shadow a name they use, and
                -- owns their numeric meaning: mode, direction and the end test.
                -- This frontend owns only the blocks: header, body, latch, exit.
                -- A generic `for` takes the same shape from the profile, which also
                -- binds its loop names at the top of each iteration.
                local generic = stat.kind == "forinStmt"
                local plan = invoke(generic and "genericFor" or "numericFor", stat, nil)
                if not block then
                    finishTemporaries(statementDepth, stat)
                    return
                end
                need(#plan.values >= 1 and plan.values[1] > g.nparams, "numeric for counter must be a fresh value")
                local held = {}
                for index, value in ipairs(plan.values) do
                    held[index] = ctx.hold(value)
                end

                local function controls(): any
                    local result = {}
                    for index, handle in ipairs(held) do
                        result[index] = ctx.readHeld(handle)
                    end

                    return result
                end

                -- Lua's shape: a guard before the first iteration and a test
                -- after every advance. They differ for floating NaN controls,
                -- so the profile supplies both; either may be negated.
                local function test(hook: any): (integer, boolean)
                    context()
                    local value, negate = hook(ctx, stat, controls())
                    need(ctx.block == block, "numeric for test must stay in its block")
                    return value, negate == true
                end

                local function decide(value: integer, negate: boolean, enter: any, leave: any): nil
                    block.term = {
                        kind = "branch",
                        value = value,
                        edges = negate and {leave, enter} or {enter, leave},
                        pos = position(stat)
                    }
                    block = nil
                end

                local guard, negateGuard = test(plan.first)
                local before = block
                local body, exit = branch(), branch()
                block = before
                decide(guard, negateGuard, body.edge, exit.edge)
                resume(body)
                -- `continue` advances the counter, so the latch exists before
                -- the body. Its parameters are the body's loop-carried state.
                local latch = branch()
                loops[#loops + 1] = {exit = exit, continueTo = latch, cleanupDepth = #cleanups}
                if generic then
                    context()
                    local bound = plan.bind(ctx, stat, controls())
                    block = ctx.block
                    for index, name in ipairs(stat.names) do
                        local key = name.definition or name
                        ctx.bind(
                            key,
                            initializeBinding(stat, key, need(bound[index], "generic for name lacks a value"))
                        )
                    end
                else
                    local key = stat.var.definition or stat.var
                    ctx.bind(key, initializeBinding(stat, key, controls()[1]))
                end
                local depth = #cleanups
                statements(stat.body.stats)
                if cleanupEnabled then
                    finishScope(depth, stat)
                end
                if block then
                    jump(latch, stat)
                end
                loops[#loops] = nil
                resume(latch)
                context()
                local advanced, wrapped = plan.advance(ctx, stat, controls())
                need(ctx.block == block, "numeric for advance must stay in its block")
                bindings[held[1]] = advanced
                if wrapped then
                    local stay = branch()
                    decide(wrapped, false, currentEdge(exit), stay.edge)
                    resume(stay)
                end
                local continuing, negate = test(plan.test)
                decide(continuing, negate, currentEdge(body), currentEdge(exit))
                resume(exit)
                for index = #held, 1, -1 do
                    ctx.release(held[index])
                end
            elseif stat.kind == "repeatStmt" then
                -- The condition is evaluated in the body's scope and closes it;
                -- a true condition leaves, a false one goes round again.
                local before = block
                local header = branch()
                before.term = {kind = "jump", edges = {header.edge}, pos = position(stat)}
                resume(header)
                local exit = branch()
                loops[#loops + 1] = {exit = exit, cleanupDepth = #cleanups}
                local depth = #cleanups
                statements(stat.body.stats)
                if block then
                    local condition = expression(stat.cond, profile.booleanKind)
                    if block then
                        if cleanupEnabled then
                            finishScope(depth, stat)
                        end
                        block.term = {
                            kind = "branch",
                            value = condition,
                            edges = {currentEdge(exit), currentEdge(header)},
                            pos = position(stat)
                        }
                        block = nil
                    end
                end
                loops[#loops] = nil
                resume(exit)
            elseif stat.kind == "breakStmt" or stat.kind == "continueStmt" then
                local loop = need(loops[#loops], "loop transfer outside a checked loop")
                if cleanupEnabled then
                    unwind(loop.cleanupDepth, stat, stat.kind)
                    local success = profile.cleanupStatus(ctx, stat)
                    ctx.afterCall(stat, nil, success)
                end
                need(stat.kind == "breakStmt" or loop.continueTo ~= nil, "continue in repeat is unsupported")
                jump(stat.kind == "breakStmt" and loop.exit or loop.continueTo, stat)
            elseif stat.kind == "doStmt" then
                local outer = {}
                for index, key in ipairs(bindingOrder) do
                    outer[index] = key
                end
                local depth = #cleanups
                statements(stat.body.stats)
                if cleanupEnabled then
                    finishScope(depth, stat)
                end
                local scoped = {}
                for _, key in ipairs(outer) do
                    scoped[key] = bindings[key]
                end
                bindings, bindingOrder = scoped, outer
            elseif stat.kind == "pragmaStmt" then
                invoke("checkedPragma", stat, nil)
                statements({need(stat.stat, "scoped pragma body required")})
            elseif stat.kind == "exportStmt" and profile.exportStatement then
                if stat.stat then
                    invoke("exportStatement", stat, nil)
                    statements({stat.stat})
                else
                    invoke("exportStatement", stat, nil)
                end
            elseif stat.kind == "recordDecl" and profile.recordValue then
                -- A record's name can hold a table of its methods.
                invoke("erasedStatement", stat, nil)
                local key = stat.name and stat.name.definition
                -- Its methods may name it: then a cell holds it from before
                -- they are made, as a local function's does.
                local initial = key and invoke("recursiveBinding", stat, key)
                if initial then
                    ctx.bind(key, initial)
                end
                local value = key and invoke("recordValue", stat, nil)
                if value and block then
                    if initial then
                        writeBinding(stat, key, value)
                    else
                        ctx.bind(key, initializeBinding(stat, key, value))
                    end
                end
            elseif stat.kind == "moduleStmt" or stat.kind == "typeAlias" or stat.kind == "recordDecl" then
                invoke("erasedStatement", stat, nil)
            elseif stat.kind == "returnStmt" then
                if cleanupEnabled then
                    cleanupReturn(stat, false)
                else
                    invoke("returnStatement", stat, nil)
                end
            elseif stat.kind ~= "emptyStmt" then
                error("function graph: unsupported checked statement " .. tostring(stat.kind), 0)
            end
            if cleanupEnabled then
                finishTemporaries(statementDepth, stat)
            end
        end
    end
    if profile.entryBindings then
        context()
        for index, parameter in ipairs(moduleOwner and {} or graph.parameters(body)) do
            local key = parameter.name and not parameter.vararg and (parameter.name.definition or parameter.name)
                or parameter
            bindings[key] = initializeBinding(parameter, key, index)
        end
        invoke("entryBindings", fn.node, nil)
    end
    -- A named vararg is bound on entry, a table of the extra arguments.
    local parameters = moduleOwner and {} or graph.parameters(body)
    local named = parameters[#parameters]
    if named and named.vararg and named.name and profile.namedVararg then
        context()
        local key = named.name.definition or named.name
        local value = invoke("namedVararg", named, nil)
        ctx.bind(key, initializeBinding(named.name, key, value))
    end
    if moduleOwner then
        for _, sourceBlock in ipairs(body.blocks) do
            need(sourceBlock.kind == "block" and sourceBlock.stats, "unsupported module initializer block")
            statements(sourceBlock.stats)
        end
    else
        need(body.body and body.body.stats, "statement-bodied function required")
        statements(body.body.stats)
    end
    if block and cleanupEnabled then
        cleanupReturn(fn.node, true)
    elseif block and profile.fallthrough then
        invoke("fallthrough", fn.node, nil)
    end
    if cleanupEnabled then
        forgetCleanups(0)
    end
    need(next(heldScope()) == nil, "function leaked a held-value handle")
    need(block == nil, "function falls through without a return or transfer")
    graph.verify(g)
    if profile.finish then
        profile.finish(ctx)
    end

    return g
end

export = frontend
