module nupp.compiler.vm.metadata

-- Expand checked metadata into ordinary syntax understood by the VM emitter.
-- Recipes and descriptors come from semantic analysis, never generated Lua.
local metadata = {}

-- Declaration keys are spelled independently of the checkout's location.
local portable = require("nupp.compiler.reflection").portableKey

local function node(kind, fields)
    local result: table = fields or {}
    result.kind = kind
    local keys, children = {}, {}
    for key in pairs(fields or {}) do
        keys[#keys + 1] = key
    end
    table.sort(keys)
    for _, key in ipairs(keys) do
        local value = fields[key]
        if type(value) == "table" then
            if value.kind then
                children[#children + 1] = value
            else
                for _, child in ipairs(value) do
                    if type(child) == "table" and child.kind then
                        children[#children + 1] = child
                    end
                end
            end
        end
    end
    for _, child in ipairs(children) do
        result[#result + 1] = child
    end

    return result
end

local function name(text)
    return node("name", {token = {text = text}})
end

local function field(subject, member)
    return node("dotIndex", {obj = subject, name = {text = member}})
end

local function call(subject, arguments)
    return node("call", {obj = subject, args = node("args", {exprs = arguments})})
end

local function data(value)
    local kind = type(value)
    if kind == "nil" then
        return node("nilExpr")
    elseif kind == "boolean" then
        return node(value and "trueExpr" or "falseExpr")
    elseif kind == "string" then
        local quoted = '"' .. value:gsub('[%c"\\\128-\255]', function(character)
            return string.format("\\%03d", character:byte())
        end) .. '"'
        return node("string", {token = {text = quoted}})
    elseif kind == "number" then
        return node("number", {token = {text = string.format("%.17g", value)}})
    else
        assert(kind == "table", "metadata must be plain data")
    end
    local keys = {}
    for key in pairs(value) do
        keys[#keys + 1] = key
    end
    table.sort(keys, function(a, b)
        if type(a) ~= type(b) then
            return type(a) < type(b)
        end
        if type(a) == "boolean" then
            return not a and b
        end

        return a < b
    end)
    local fields = {}
    for _, key in ipairs(keys) do
        fields[#fields + 1] = node("fieldBracket", {key = data(key), value = data(value[key])})
    end

    return node("tableExpr", {fields = fields})
end

metadata.literal = data

function metadata.foreignSignature(declaration)
    local signature = assert(declaration.cAbiSignature, "C function has no checked ABI signature")
    assert(signature.schema == 1 and signature.convention == "c", "unsupported VM C function ABI")
    local scalars = {
        boolean = "bool",
        integer = "int32",
        number = "number",
        float = "float",
        int8 = "int8",
        int16 = "int16",
        int32 = "int32",
        int64 = "int64",
        uint8 = "uint8",
        uint16 = "uint16",
        uint32 = "uint32",
        uint64 = "uint64",
        ptr = "pointer",
        carray = "pointer",
        string = "pointer",
        cstring = "pointer",
        voidptr = "pointer"
    }

    local function scalar(subject, parameter)
        while subject
            and (
                subject.tag == "const" or subject.tag == "affine" or subject.tag == "borrowed" or subject.tag == "owned"
            ) do
            subject = subject.inner
        end
        if subject and subject.tag == "union" and subject.hasNil and #(subject.members or {}) == 2 then
            local first, second = subject.members[1], subject.members[2]
            local other = first.tag == "nil" and second or first
            if other.tag == "ptr" or other.tag == "cstring" or other.tag == "voidptr" or other.tag == "func" then
                return scalar(other, parameter)
            end
        end
        -- A C function pointer. As a parameter, the runtime lends a Nupp function a
        -- trampoline for the call or passes a retained callback's own; as a
        -- result, it is a foreign function callable under this signature.
        if subject and subject.tag == "func" then
            assert(not subject.varargs, "a VM C callback cannot be variadic")
            local params = {}
            for index, inner in ipairs(subject.params or {}) do
                local kind = scalar(inner)
                assert(
                    type(kind) == "string" and kind ~= "callback",
                    "unsupported VM C callback parameter " .. tostring(
                        index
                    ) .. " type " .. tostring(inner and inner.tag)
                )
                params[index] = kind
            end
            local callbackResult = "void"
            if subject.rets and subject.rets[1] then
                callbackResult = assert(
                    scalar(subject.rets[1]),
                    "unsupported VM C callback result type " .. tostring(subject.rets[1].tag)
                )
            end

            return {kind = "callback", params = params, result = callbackResult}
        end
        -- A C struct or union by value, named by its declaration; the runtime
        -- lays it out from the storage type that declaration defined.
        if subject and subject.tag == "nominal" and subject.declKind == "struct" then
            local identity = subject.runtimeDeclarationKey or subject.cdefIdentity
            if identity then
                return {kind = subject.cdefKind == "union" and "union" or "struct", identity = identity}
            end
        end
        if parameter and subject then
            local readonly = subject.tag == "string" or subject.tag == "cstring"
            local element = (subject.tag == "ptr" or subject.tag == "carray") and subject.elem or nil
            while element and (element.tag == "affine" or element.tag == "borrowed" or element.tag == "owned") do
                element = element.inner
            end
            readonly = readonly or element and element.tag == "const"
            if readonly then
                return {kind = "pointer", readonly = true}
            end
        end

        return subject and scalars[subject.tag]
    end

    -- What a counted pointer or an out slot holds: a scalar by name, or a
    -- struct by its declaration identity, which the runtime resolves to the
    -- struct's storage type when the call runs.
    local function stored(subject)
        while subject
            and (
                subject.tag == "const"
                or subject.tag == "affine"
                or subject.tag == "borrowed"
                or subject.tag == "owned"
                or subject.tag == "genericAlias"
            ) do
            subject = subject.inner or subject.body
        end
        if subject and subject.tag == "nominal" and subject.declKind == "struct" then
            return {
                kind = "struct",
                identity = assert(
                    subject.runtimeDeclarationKey or subject.cdefIdentity,
                    "a struct crossing a C boundary has no declaration identity"
                )
            }
        end

        return scalar(subject)
    end

    -- Which output each out slot is, by its C position, for its success rule.
    local outputs = {}
    local physical = declaration.physicalSignatureType
    for _, output in ipairs(physical and physical.ffiOut or {}) do
        outputs[output.cIndex] = output
    end
    local positions = {}
    for index, parameter in ipairs(signature.params or {}) do
        positions[parameter.name] = index
    end
    local counts = {}
    for _, parameter in ipairs(signature.params or {}) do
        if parameter.countedBy then
            counts[assert(positions[parameter.countedBy], "countedBy names no parameter")] = true
        end
    end
    -- A variadic function's extra arguments are typed per call, from their
    -- values, by C's default promotions.
    local result = {params = {}, result = "void", success = "always", variadic = signature.varargs or nil}
    for index, parameter in ipairs(signature.params or {}) do
        local subject = parameter.type
        while subject and (subject.tag == "affine" or subject.tag == "borrowed" or subject.tag == "owned") do
            subject = subject.inner
        end
        if parameter.mode == "out" then
            -- A slot the callee fills and the caller is handed: the value for a
            -- scalar or struct, a foreign pointer for a pointer.
            assert(subject and subject.tag == "ptr", "a VM C out parameter is a pointer to its slot")
            local output = outputs[index]
            result.params[
                index
            ] = {
                kind = "out",
                type = assert(
                    stored(subject.elem),
                    "unsupported VM C out parameter " .. tostring(index) .. " slot type"
                )
            }
            result.success = output and output.success or result.success
        elseif parameter.countedBy then
            -- A span the caller passes, which reaches C as its first element's
            -- address and fills the count parameter it names with its length.
            assert(subject and subject.tag == "ptr", "a VM C counted parameter is a pointer")
            local element = subject.elem
            local readonly = element and element.tag == "const"
            result.params[
                index
            ] = {
                kind = "counted",
                element = assert(stored(element), "unsupported VM C counted element type"),
                write = not readonly,
                count = positions[parameter.countedBy],
                countName = parameter.countedBy
            }
        elseif counts[index] then
            result.params[index] = {kind = "count", type = assert(scalar(subject), "unsupported VM C count type")}
        else
            result.params[
                index
            ] = assert(
                scalar(parameter.type, true),
                "unsupported VM C parameter " .. tostring(
                    index
                ) .. " type " .. tostring(parameter.type and parameter.type.tag)
            )
        end
    end
    if signature.result then
        result.result = assert(
            scalar(signature.result),
            "unsupported VM C result type " .. tostring(signature.result.tag)
        )
    end

    return result
end

--- A header namespace's bindings: each function's C signature, as a `cdef`
--- declaration of it would carry, or the reason it has none, and each enum
--- member's value. The runtime binds a function when it is first used.
function metadata.headerNamespace(exports, constants)
    local cabi = require("nupp.compiler.cinterop.cabi")
    local signatures, values = {}, {}
    local names = {}
    for name in pairs(exports or {}) do
        names[#names + 1] = name
    end
    table.sort(names)
    for _, name in ipairs(names) do
        local subject = exports[name]
        if subject and subject.tag == "func" then
            local params = {}
            for index, parameter in ipairs(subject.params or {}) do
                params[index] = {name = "arg" .. tostring(index), type = parameter, mode = "plain"}
            end
            local declaration = {
                cAbiSignature = cabi.functionRecord(
                    name,
                    params,
                    subject.rets and subject.rets[1],
                    subject.varargs,
                    "c"
                )
            }
            local ok, signature = pcall(metadata.foreignSignature, declaration)
            if ok then
                signatures[name] = signature
            else
                signatures[
                    name
                ] = {
                    unsupported = (
                        "C function %s cannot be called on the VM: %s"
                    ):format(name, (tostring(signature):gsub("^[^:]*:%d+: ", "")))
                }
            end
        elseif constants and constants[name] ~= nil then
            values[name] = constants[name]
        end
    end

    return signatures, values
end

--- A struct's runtime identity: its declaration's, and for an instance of a
--- generic struct, that followed by its type arguments, so each instance is
--- its own storage type and every module spells one instance alike.
function metadata.structIdentity(subject)
    local origin = subject.origin or subject
    local identity = origin.runtimeDeclarationKey or origin.cdefIdentity
    if subject.origin and identity then
        local types = require("nupp.compiler.types")
        local arguments = {}
        for index, argument in ipairs(subject.typeArgs or {}) do
            arguments[index] = types.tostring(argument)
        end
        for _, argument in ipairs(subject.constArgs or {}) do
            arguments[#arguments + 1] = tostring(argument.value ~= nil and argument.value or argument.id)
        end
        identity = identity .. "<" .. table.concat(arguments, ",") .. ">"
    end

    return identity
end

-- Layout facts come from the checked nominal graph under an explicit target.
-- Unsupported layouts keep their reason so unrelated declarations can still
-- compile; asking the native provider for that layout reports the failure.
function metadata.structLayout(declaration, target)
    local nominal = declaration.resolvedType
    local label = nominal and (nominal.runtimePath or nominal.name) or declaration.name.text
    local unavailable = {kind = "struct", name = label, supported = false, target = target}
    if not target then
        unavailable.error = "VM struct layout requires an explicit layoutTarget"
        return unavailable
    end
    local layouts = require("nupp.compiler.targetlayout")
    unavailable.abi = layouts.ABI
    local active = {}
    local scalars = {
        boolean = true,
        integer = true,
        number = true,
        float = true,
        int8 = true,
        int16 = true,
        int32 = true,
        int64 = true,
        uint8 = true,
        uint16 = true,
        uint32 = true,
        uint64 = true
    }
    local types = require("nupp.compiler.types")

    -- What a pointer field points at, unwrapping the nullable spelling. Nil when
    -- the type is not a pointer a struct can hold.
    local function pointerOf(subject)
        if subject.tag == "union" and subject.hasNil and #(subject.members or {}) == 2 then
            local other = subject.members[1].tag == "nil" and subject.members[2] or subject.members[1]
            return other and pointerOf(other) or nil
        end
        if subject.tag == "ptr" or subject.tag == "cstring" or subject.tag == "voidptr" then
            return subject
        end
        if subject.tag == "func" and subject.foreign then
            return subject
        end

        return nil
    end

    local describe
    describe = function(subject)
        while subject and (subject.tag == "const" or subject.tag == "genericAlias") do
            subject = subject.inner or subject.body
        end
        if not subject then
            return nil, "unresolved stored type"
        end
        local pointer = pointerOf(subject)
        if pointer then
            -- A pointer holds an address and never its pointee, so the pointee is
            -- named rather than described: a linked struct stays finite, and a
            -- change inside the pointee leaves this layout alone.
            local measured, reason = layouts.of(subject, target)
            if not measured then
                return nil, reason
            end
            local result = {kind = "pointer", size = measured.size, alignment = measured.alignment}
            local pointee = pointer.tag == "ptr" and pointer.elem or nil
            while pointee and (pointee.tag == "const" or pointee.tag == "genericAlias") do
                pointee = pointee.inner or pointee.body
            end
            local signature = "*"
            if pointer.tag == "cstring" then
                result.pointee, signature = "cstring", "*cstring"
            elseif pointer.tag == "func" then
                -- A function pointer field carries its C signature, which a
                -- retained callback stored in it is bound to.
                local ok, described = pcall(metadata.foreignSignature, {
                    cAbiSignature = {
                        schema = 1,
                        convention = "c",
                        symbol = "",
                        params = {{name = "callback", type = pointer, mode = "plain"}}
                    }
                })
                local callback = ok and described.params[1] or nil
                local key = "function"
                if type(callback) == "table" and callback.kind == "callback" then
                    result.signature = callback
                    key = "function(" .. table.concat(callback.params, ",") .. "):" .. tostring(callback.result)
                end
                result.pointee, signature = key, "*" .. key
            elseif pointee and scalars[pointee.tag] then
                result.pointee, signature = pointee.tag, "*" .. pointee.tag
            elseif pointee and pointee.tag == "nominal" and pointee.declKind == "struct" then
                local identity = pointee.runtimeDeclarationKey or pointee.cdefIdentity
                result.pointee = "struct"
                result.target = identity
                -- Named as declared, not by identity: one layout answers one
                -- fingerprint whichever module declares it.
                signature = "*" .. tostring(pointee.name)
            end

            return result, nil, signature
        end
        local tag = subject.tag
        if tag == "nominal" then
            if #(subject.typeParams or {}) > 0
                or #(subject.packParams or {}) > 0
                or #(subject.constParams or {}) > 0
                or #(subject.packArgs or {}) > 0
            then
                return nil, "a generic struct has a layout only once its type arguments are known"
            end
            local origin = subject.origin or subject
            if not (origin.runtimeDeclarationKey or origin.cdefIdentity) then
                return nil, "the struct has no canonical runtime declaration identity"
            end
        end
        if not scalars[tag] and tag ~= "carray" and not (tag == "nominal" and subject.declKind == "struct") then
            return nil, "unsupported VM stored type " .. tostring(tag)
        end
        if active[subject] then
            return nil, "a recursive by-value struct has no finite layout"
        end
        local measured, reason = layouts.of(subject, target)
        if not measured then
            return nil, reason
        end
        local result = {
            kind = tag == "nominal" and (subject.cdefKind or "struct") or tag == "carray" and "array" or tag,
            size = measured.size,
            alignment = measured.alignment
        }
        if scalars[tag] then
            return result, nil, tag
        end
        active[subject] = true
        if tag == "carray" then
            local element, problem, signature = describe(subject.elem)
            active[subject] = nil
            if not element then
                return nil, problem
            end
            result.element, result.count = element, subject.count
            return result, nil, "[" .. tostring(subject.count) .. "]" .. signature
        end
        result.name, result.fields = subject.runtimePath or subject.name, {}
        result.typeName = (subject.moduleName and subject.moduleName .. ":" or "") .. result.name
        result.identity = metadata.structIdentity(subject)
        local signatures = {}
        for index, fieldLayout in ipairs(measured.fields) do
            local name = fieldLayout.name
            local fieldType = subject.byname[name]
            local member, problem, signature = describe(fieldType)
            if not member then
                active[subject] = nil
                return nil, "field " .. name .. ": " .. tostring(problem)
            end
            member.name, member.offset = name, fieldLayout.offset
            member.ctype = types.cName(fieldType)
                or type(member.pointee) == "string" and member.pointee:sub(1, 8) == "function" and "void *"
                or nil
            if fieldLayout.bitWidth then
                -- A bitfield is read and written through its storage unit: the
                -- declared type's bytes at `offset`, of which it is `bitWidth`
                -- bits starting `bitOffset` bits from the least significant.
                member.bitOffset, member.bitWidth = fieldLayout.bitOffset, fieldLayout.bitWidth
                signature = signature .. ":" .. tostring(fieldLayout.bitOffset) .. "+" .. tostring(fieldLayout.bitWidth)
            end
            local following = measured.fields[index + 1]
            local padding = result.kind == "union" and measured.size - fieldLayout.size
                or (following and following.offset or measured.size) - fieldLayout.offset - fieldLayout.size
            -- Bitfields sharing one unit leave no bytes between them.
            member.padding = padding > 0 and padding or 0
            result.fields[#result.fields + 1] = member
            signatures[#signatures + 1] = name .. ":" .. signature
        end
        active[subject] = nil
        -- The fingerprint describes the layout: the declared name and every
        -- field, nested structs expanded, but not the declaring module, so
        -- the same declaration in two modules answers the same.
        local signature = tostring(subject.name) .. "{" .. table.concat(signatures, ",") .. "}"
        result.fingerprint = measured.fingerprint .. "|fields=" .. signature

        return result, nil, signature
    end
    local result, reason = describe(nominal)
    if not result then
        unavailable.error = "VM struct layout: " .. tostring(reason)
        return unavailable
    end
    result.supported, result.target, result.abi = true, target, layouts.ABI
    result.name = label

    return result
end

local function required(module)
    return call(name("require"), {data(module)})
end

local function invoke(subject, arguments)
    return node("callStmt", {expr = call(subject, arguments)})
end

local function assign(target, value)
    return node("assignStmt", {targets = {target}, exprs = {value}})
end

local function body(parameters, statements)
    local params = {}
    for _, parameter in ipairs(parameters) do
        params[#params + 1] = {name = {text = parameter}}
    end

    return node("funcbody", {params = params, body = node("block", {stats = statements})})
end

local function path(text)
    local result
    -- A declaration another module owns is spelled `require("module").Name`.
    local module, rest = text:match('^require%("([^"]+)"%)%.(.+)$')
    if module then
        result, text = required(module), rest
    end
    for member in text:gmatch("[^.]+") do
        result = result and field(result, member) or name(member)
    end

    return assert(result, "empty metadata path")
end

local function constructors(declaration, identity, statements)
    local nominal = declaration.resolvedType
    for _, entry in ipairs(declaration.entries or {}) do
        if entry.kind == "constructorDecl" then
            local index = tostring(entry.constructorIndex or 1)
            local initializer = "__nuppInit" .. index
            local receiver = "\0constructor:self"
            local writes = {node("localStmt", {names = {{text = receiver}}, exprs = {name("self")}})}
            for _, member in ipairs(nominal.fieldOrder or {}) do
                local default = nominal.fieldDefaults and nominal.fieldDefaults[member]
                if default then
                    writes[#writes + 1] = assign(field(name("self"), member), data(default.value))
                end
            end
            for _, statement in ipairs(entry.body.body.stats or {}) do
                writes[#writes + 1] = statement
            end
            writes[#writes + 1] = node("returnStmt", {exprs = {name(receiver)}})
            local initBody = {}
            for key, value in pairs(entry.body) do
                if type(key) ~= "number" then
                    initBody[key] = value
                end
            end
            local initBlock = {}
            for key, value in pairs(entry.body.body) do
                if type(key) ~= "number" then
                    initBlock[key] = value
                end
            end
            initBlock.stats = writes
            initBody.body = node("block", initBlock)
            initBody.vmConstructorSelf = receiver
            statements[#statements + 1] = assign(
                field(identity, initializer),
                node("funcExpr", {
                    body = node("funcbody", initBody)
                })
            )
            local parameters, arguments = {}, {
                node("newExpr", {
                    inferredType = nominal,
                    call = {recordFields = {}, args = {exprs = {}}, vmStructWitness = identity}
                })
            }
            for position, parameter in ipairs(entry.body.params or {}) do
                if position > 1 then
                    assert(not parameter.vararg and not parameter.namedVararg, "constructor varargs are not supported")
                    parameters[#parameters + 1] = parameter.name.text
                    arguments[#arguments + 1] = name(parameter.name.text)
                end
            end
            statements[#statements + 1] = assign(
                field(identity, "__nuppCtor" .. index),
                node("funcExpr", {
                    body = body(parameters, {
                        node("returnStmt", {
                            exprs = {call(field(identity, initializer), arguments)}
                        })
                    })
                })
            )
        end
    end
end

function metadata.declaration(declaration, identity)
    local statements = {}
    local recipe = declaration.deriveRecipe
    local nominal = declaration.resolvedType
    constructors(declaration, identity, statements)
    if declaration.declKind == "struct" then
        -- A struct's declaration is callable, as a LuaJIT ctype is: `T(...)`
        -- initializes a native value of it.
        local construct = body({"self"}, {
            node("returnStmt", {
                exprs = {
                    call(
                        node("bracketIndex", {
                            obj = name("self"),
                            expr = data("\0nupp:structType")
                        }),
                        {node("vararg")}
                    )
                }
            })
        })
        construct.params[#construct.params + 1] = {vararg = true}
        statements[#statements + 1] = invoke(name("setmetatable"), {
            identity,
            node("tableExpr", {
                fields = {node("fieldBracket", {key = data("__call"), value = node("funcExpr", {body = construct})})}
            })
        })
    end
    local reflect = field(field(name("_G"), "nupp"), "__reflect")
    -- Derived members read the reflection runtime (Debug renders through
    -- `nupp.reflect.runtime`); on LuaJIT an earlier chunk has always installed
    -- it, but an image installs what its own declarations use.
    if nominal and (nominal.runtimeReflectionNeeded or recipe) then
        statements[#statements + 1] = invoke(field(required("nupp.compiler.runtime.reflect"), "install"), {
            field(name("_G"), "nupp")
        })
    end
    if nominal and (nominal.runtimeReflectionNeeded or recipe and recipe.data and recipe.data.json) then
        local reflection = require("nupp.compiler.reflection")
        statements[#statements + 1] = invoke(field(reflect, "register"), {
            identity,
            data(reflection.describe(nominal, nominal.runtimePath or nominal.name)),
            data(reflection.runtimeReferences(nominal))
        })
    end
    -- Defaults the declaration takes from the interfaces it implements, read
    -- from the table each interface keeps them on.
    for _, taken in ipairs(declaration.inheritedDefaultNames or {}) do
        local member = taken.member or taken.name
        statements[
            #statements + 1
        ] = assign(field(identity, member), field(path(taken.from), taken.fromMember or member))
    end
    if not recipe then
        return statements
    end
    statements[#statements + 1] = invoke(field(required("nupp.derive"), "install"), {field(name("_G"), "nupp")})
    if recipe.initializer and nominal and #(nominal.constructorEntries or {}) == 0 then
        local parameters, writes = {"self"}, {}
        for _, member in ipairs(nominal.fieldOrder or {}) do
            local memberType = nominal.byname and nominal.byname[member]
            if memberType
                and memberType.tag ~= "typeobject"
                and not (nominal.nestedTypes and nominal.nestedTypes[member])
                and not (nominal.privateFields and nominal.privateFields[member])
            then
                local parameter = "a" .. #parameters
                parameters[#parameters + 1] = parameter
                local value = name(parameter)
                local default = nominal.fieldDefaults and nominal.fieldDefaults[member]
                if default then
                    writes[#writes + 1] = node("ifStmt", {
                        clauses = {
                            node("ifClause", {
                                cond = node("binop", {
                                    op = {text = "=="},
                                    lhs = value,
                                    rhs = data(nil)
                                }),
                                body = node("block", {stats = {assign(value, data(default.value))}})
                            })
                        }
                    })
                end
                writes[#writes + 1] = assign(field(name("self"), member), value)
            end
        end
        writes[#writes + 1] = node("returnStmt", {exprs = {name("self")}})
        statements[#statements + 1] = assign(
            field(identity, recipe.initializer),
            node("funcExpr", {
                body = body(parameters, writes)
            })
        )
    end
    local entryName = "\0derive:" .. recipe.key
    statements[#statements + 1] = node("localStmt", {
        names = {{text = entryName}},
        exprs = {
            call(field(field(field(name("_G"), "nupp"), "__derive"), "register"), {
                data(recipe.key),
                identity,
                data(recipe)
            })
        }
    })

    local function argument(value)
        if value.kind == "receiver" then
            return name("self")
        elseif value.kind == "entry" then
            return name(entryName)
        elseif value.kind == "argument" then
            return name(value.name)
        elseif value.kind == "field" then
            return field(name("self"), value.name)
        elseif value.kind == "constant" then
            return data(value.value)
        elseif value.kind == "witness" then
            local subject = assert(
                declaration.deriveWitnesses and declaration.deriveWitnesses[value.witnessIndex],
                "missing derived type witness"
            )
            -- The witness carries its reflection blueprint with it, registered
            -- on first use, as the Lua generator's `ensure` does.
            local reflection = require("nupp.compiler.reflection")
            local describe = node("funcExpr", {
                body = body({}, {
                    node("returnStmt", {
                        exprs = {
                            data(reflection.describe(subject, subject.runtimePath or subject.name)),
                            data(reflection.runtimeReferences(subject))
                        }
                    })
                })
            })
            return call(field(field(field(name("_G"), "nupp"), "__reflect"), "ensure"), {
                path(assert(value.runtimePath)),
                describe
            })
        elseif value.kind == "array" then
            local fields = {}
            for _, item in ipairs(value.values or {}) do
                fields[#fields + 1] = node("fieldItem", {value = argument(item)})
            end
            return node("tableExpr", {fields = fields})
        end
        error("unknown derived argument " .. tostring(value.kind))
    end

    for _, member in ipairs(recipe.members or {}) do
        assert(member.operation == "forward.v1", "unknown derived member operation")
        local parameters = {}
        for index, parameter in ipairs(member.paramNames or {}) do
            parameters[index] = member.namespace == "instance" and index == 1 and "self"
                or parameter ~= "" and parameter
                or ("a" .. index)
        end
        local arguments = {}
        for _, item in ipairs(member.arguments or {}) do
            arguments[#arguments + 1] = argument(item)
        end
        local helper = member.helper.localPath and path(member.helper.localPath)
            or field(required(member.helper.module), member.helper.member)
        statements[#statements + 1] = assign(
            field(identity, member.name),
            node("funcExpr", {
                body = body(parameters, {
                    node("returnStmt", {exprs = {call(helper, arguments)}})
                })
            })
        )
    end

    return statements
end

-- Type witnesses, as the Lua generator's witness plan places them: a value
-- of type `Type<R>` carries R's reflection blueprint, registered on first use,
-- and every record a witness reaches is linked to the declarations its fields
-- name so `nupp.reflect.runtimeType` can find them.
local function witnesses(root)
    local plan = require("nupp.compiler.typewitness").collect(root, root.vmModuleExports)
    if next(plan.values) == nil and #plan.ordered == 0 then
        return {}
    end
    local reflection = require("nupp.compiler.reflection")
    local reflect = field(field(name("_G"), "nupp"), "__reflect")
    local descriptions = {}

    local function describe(subject)
        -- The description is computed once; each site gets its own nodes.
        local found = descriptions[subject]
        if not found then
            found = {
                reflection.describe(subject, subject.runtimePath or subject.name),
                reflection.runtimeReferences(subject)
            }
            descriptions[subject] = found
        end

        return node("funcExpr", {body = body({}, {node("returnStmt", {exprs = {data(found[1]), data(found[2])}})})})
    end

    local function wrap(value, subject)
        local ensured = call(field(reflect, "ensure"), {value, describe(subject)})
        if value.kind ~= "name" then
            return ensured
        end

        -- Reading a name again runs no user code, and once the blueprint is
        -- known the witness costs a lookup rather than a closure. Each read
        -- is its own node: analysis visits a node once.
        local function again()
            local copy = {}
            for key, item in pairs(value) do
                copy[key] = item
            end

            return copy
        end

        return node("paren", {
            expr = node("binop", {
                op = {text = "or"},
                lhs = node("binop", {
                    op = {text = "and"},
                    lhs = call(field(reflect, "known"), {again()}),
                    rhs = again()
                }),
                rhs = ensured
            })
        })
    end

    -- Replace each witnessed value where its parent holds it, leaving the
    -- checked node itself as it was. A wrapper is never revisited, so the
    -- value inside it stays unwrapped; its own children are visited directly.
    local seen, replaced = {}, {}
    local replace

    local function substitute(value)
        local result = replaced[value]
        if not result then
            result = wrap(value, plan.values[value])
            replaced[value] = result
            seen[result] = true
            replace(value)
        end

        return result
    end

    replace = function(current)
        if type(current) ~= "table" or seen[current] then
            return
        end
        seen[current] = true
        for key, child in pairs(current) do
            if type(child) == "table" and plan.values[child] then
                current[key] = substitute(child)
            elseif type(child) == "table" and not child.kind and key ~= "token" then
                for index, item in ipairs(child) do
                    if type(item) == "table" and plan.values[item] then
                        child[index] = substitute(item)
                    end
                end
            end
        end
        for _, child in ipairs(current) do
            replace(child)
        end
        replace(current.foldedExpression)
    end
    replace(root)

    -- Each block holding a witnessed declaration opens with its cells; a
    -- module-level one is the shared cell other modules' references find.
    local groups = 0
    for _, item in ipairs(plan.ordered) do
        local group = item.group
        if not group.vmName then
            groups = groups + 1
            group.vmName = "\0witness:" .. groups
            local cells = {}
            for index, member in ipairs(group.items) do
                local key = portable(member.type.runtimeDeclarationKey or member.type.declarationKey)
                local cell
                if member.top and key then
                    cell = call(field(reflect, "declaration"), {data(key)})
                else
                    cell = data({key = key})
                end
                cells[index] = node("fieldItem", {value = cell})
            end
            local opening = node("localStmt", {
                names = {{text = group.vmName}},
                exprs = {
                    node("tableExpr", {
                        fields = cells
                    })
                }
            })
            local block = item.block
            table.insert(block.stats, 1, opening)
            table.insert(block, 1, opening)
        end
    end

    local function cell(member)
        return node("bracketIndex", {obj = name(member.group.vmName), expr = data(member.slot)})
    end

    local links = {}
    for _, item in ipairs(plan.ordered) do
        local targets = {}
        for _, target in ipairs(item.targets) do
            local value = target.localTarget and cell(target.localTarget) or call(field(reflect, "reference"), {
                data(portable(target.key)),
                data(target.module)
            })
            targets[#targets + 1] = node("fieldItem", {value = value})
        end
        links[item.node] = function(identity)
            return invoke(field(reflect, "link"), {identity, cell(item), node("tableExpr", {fields = targets})})
        end
    end

    -- The witness runtime precedes everything, the cells included.
    local install = invoke(field(required("nupp.compiler.runtime.typewitness"), "install"), {field(name("_G"), "nupp")})
    local rootBlock = root.blocks[1]
    table.insert(rootBlock.stats, 1, install)
    table.insert(rootBlock, 1, install)

    return links
end

-- The VM storage scalar a `ctype<T>` names, by the type's tag.
local STORAGE_SCALARS: {
    [string]: string
} = {
    int8 = "int8",
    uint8 = "uint8",
    int16 = "int16",
    uint16 = "uint16",
    int32 = "int32",
    uint32 = "uint32",
    int64 = "int64",
    uint64 = "uint64",
    integer = "integer",
    float = "float",
    number = "number",
    boolean = "boolean",
}

-- What `ffi.typeof<T>()` is on the VM, which has no `ffi`: the storage
-- descriptor `carray` and the storage provider take. A struct's is the one its
-- declaration defines; a scalar's is the provider's canonical descriptor.
local function storageDescriptor(call)
    local witness = call.inferredType
    local subject = witness and witness.tag == "ctype" and witness.of or nil
    if subject and subject.tag == "nominal" and subject.declKind == "struct" and call.ffiTypeName then
        -- A declaration whose layout this target cannot give has no descriptor;
        -- its layout record says why.
        local reason = field(field(path(call.ffiTypeName), "\0nupp:structLayout"), "error")
        return node("binop", {
            op = {text = "or"},
            lhs = field(path(call.ffiTypeName), "\0nupp:structType"),
            rhs = node("call", {obj = name("error"), args = node("args", {exprs = {reason, data(2)}})})
        })
    end
    local scalar = subject and STORAGE_SCALARS[subject.tag]
    if scalar then
        return node("call", {
            obj = field(required("nupp.runtime.provider.nativestorage"), "scalar"),
            args = node("args", {exprs = {data(scalar)}})
        })
    end

    return node("call", {
        obj = name("error"),
        args = node("args", {
            exprs = {data("nupp: this ffi.typeof names no VM storage type"), data(2)}
        })
    })
end

function metadata.expand(root, moduleName: string?)
    local seen = {}
    local managed = false
    local reflects = false
    local effects = {}
    local qualified: {[string]: boolean} = {}
    local qualifiedOrder: {string} = {}
    local links = witnesses(root)

    local function replaceCall(current, replacement)
        for index = #current, 1, -1 do
            current[index] = nil
        end
        current.kind = replacement.kind
        current.obj = replacement.obj
        current.args = replacement.args
        current.name = replacement.name
        current.overloadMember = nil
        current.ownershipIntrinsic = nil
        current.recoverManagedAlias = nil
        current.managedAliasPolicy = nil
        for _, child in ipairs(replacement) do
            current[#current + 1] = child
        end
        managed = true
    end

    -- Makes `current` the parenthesized `replacement`, in place, so every parent
    -- holding the node sees the new expression.
    local function replaceExpression(current, replacement)
        for index = #current, 1, -1 do
            current[index] = nil
        end
        current.kind = "paren"
        current.expr = replacement
        current.obj, current.args, current.name = nil, nil, nil
        current.ffiIntrinsic = nil
        current[1] = replacement
    end

    local function visit(current)
        if type(current) ~= "table" or seen[current] then
            return
        end
        seen[current] = true
        managed = managed or current.requiresManagedRuntime == true
        local namespace = (current.kind == "name" or current.kind == "dotIndex") and current.qualifiedModule
        if namespace and namespace ~= moduleName and not qualified[namespace] then
            qualified[namespace] = true
            qualifiedOrder[#qualifiedOrder + 1] = namespace
        end
        if current.compilerFeatureEffect then
            effects[current.compilerFeatureEffect] = true
        end
        for _, effect in ipairs(current.compilerFeatureEffects or {}) do
            effects[effect] = true
        end
        for _, effect in ipairs(
            current.materializationObservation and current.materializationObservation.runtimeFeatures or {}
        ) do
            effects[effect] = true
        end
        reflects = reflects
            or current.kind == "dotIndex"
            and current.obj
            and current.obj.kind == "name"
            and current.obj.token
            and current.obj.token.text == "nupp"
            and current.name
            and current.name.text == "reflect"
        if current.kind == "call" and current.ffiIntrinsic == "typeof" then
            replaceExpression(current, storageDescriptor(current))
        elseif current.kind == "call" and current.soaLayout and current.soaOperation then
            -- The SoA intrinsics take the checker's declared-field specification,
            -- as the Lua backend's layout helper does; the VM's `nupp.mem.soa`
            -- measures the fields from the row's storage descriptor.
            local spec = current.soaLayout
            local arguments = current.args and current.args.exprs or {}
            local raw = data({name = spec.name, spec = spec.spec, printed = spec.printed})
            local soa = required("nupp.mem.soa")
            local lowered
            if current.soaOperation == "allocate" then
                lowered = call(field(soa, "_allocate"), {arguments[1] or data(nil), arguments[2] or data(nil), raw})
            else
                lowered = call(field(soa, "_layout"), {raw, arguments[1] or data(nil)})
            end
            for index = #current, 1, -1 do
                current[index] = nil
            end
            current.obj, current.args = lowered.obj, lowered.args
            current.soaLayout, current.soaOperation = nil, nil
            for _, child in ipairs(lowered) do
                current[#current + 1] = child
            end
        elseif current.kind == "call" and current.ownershipIntrinsic == "manage" then
            local value = "\0managed:value"
            local cleanup = call(name("nupp"), {name(value)})
            cleanup.ownershipIntrinsic = "attemptAll"
            cleanup.ownerCleanups = assert(current.managedCleanups)
            local callback = node("funcExpr", {body = body({value}, {node("callStmt", {expr = cleanup})})})
            replaceCall(
                current,
                call(field(field(name("_G"), "nupp"), "__manage"), {
                    assert(current.args.exprs[1]),
                    callback,
                    data(current.managedPolicy or "")
                })
            )
        elseif current.kind == "call" and current.recoverManagedAlias then
            replaceCall(current, call(field(field(name("_G"), "nupp"), "__recoverAlias"), current.args.exprs))
        elseif current.kind == "methodCall" and current.managedAliasPolicy then
            replaceCall(
                current,
                node("methodCall", {
                    obj = current.obj,
                    name = {text = "_downcast"},
                    args = node("args", {exprs = {data(current.managedAliasPolicy)}})
                })
            )
        end
        -- A record declared in another record's body is that record's member:
        -- qualified by it, as `record Outer.Inner` would be.
        if current.kind == "recordDecl" and current.name then
            for _, entry in ipairs(current.entries or {}) do
                if entry.kind == "recordDecl" and entry.name and not entry.qualifiers then
                    local qualifiers = {}
                    for _, qualifier in ipairs(current.qualifiers or {}) do
                        qualifiers[#qualifiers + 1] = qualifier
                    end
                    qualifiers[#qualifiers + 1] = current.name
                    entry.qualifiers = qualifiers
                    entry.vmNested = true
                end
            end
        end
        if current.kind == "recordDecl" and not current.vmMetadata then
            local identity
            for _, qualifier in ipairs(current.qualifiers or {}) do
                identity = identity and field(identity, qualifier.text) or name(qualifier.text)
            end
            identity = identity and field(identity, current.name.text) or name(current.name.text)
            current.vmMetadata = metadata.declaration(current, identity)
            if links[current] then
                current.vmMetadata[#current.vmMetadata + 1] = links[current](identity)
            end
            for _, statement in ipairs(current.vmMetadata) do
                current[#current + 1] = statement
            end
        end
        for _, child in ipairs(current) do
            visit(child)
        end
    end

    visit(root)
    if managed and not root.vmManagedRuntime then
        local namespace = field(name("_G"), "nupp")
        local install = invoke(field(required("nupp.runtime.managed"), "install"), {namespace, name("_G")})
        local block = root.blocks[1]
        table.insert(block.stats, 1, install)
        block[#block + 1] = install
        root.vmManagedRuntime = true
    end
    -- A module a qualified namespace reaches loads with this one, as the Lua
    -- backend's hoisted require loaded it, rather than at its first use.
    if not root.vmQualifiedRequires then
        local block = root.blocks[1]
        for index, namespace in ipairs(qualifiedOrder) do
            local statement: any = node("callStmt", {expr = required(namespace)})
            table.insert(block.stats as {any}, index, statement)
        end
        root.vmQualifiedRequires = true
    end
    -- The field codec is installed as the Lua backend's bootstrap installed
    -- it, as module-level statements whose locals the materialized codecs
    -- address.
    local installers = not root.vmFeatureInstallers and require("nupp.compiler.stdlib").vmInstallers(effects) or nil
    if installers then
        local parsed = require("nupp.compiler.syntax.parser").parse(installers, "=stdlib")
        assert(#parsed.errors == 0, "feature installers do not parse")
        local block = root.blocks[1]
        for index, statement in ipairs((parsed.root as any).blocks[1].stats) do
            table.insert(block.stats, index, statement)
        end
        root.vmFeatureInstallers = true
    end
    -- `nupp.reflect` is installed by whatever chunk first needs it; on LuaJIT an
    -- earlier chunk always had, but a program image installs what it reads.
    if reflects and not root.vmReflectRuntime then
        local install = invoke(field(required("nupp.compiler.runtime.reflect"), "install"), {field(name("_G"), "nupp")})
        local block = root.blocks[1]
        table.insert(block.stats, 1, install)
        block[#block + 1] = install
        root.vmReflectRuntime = true
    end
end

export = metadata
