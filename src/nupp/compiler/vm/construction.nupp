--[[
Checked constructions, as the lowerings see them.

The checker marks every call that builds a record or a struct with
`construction`: calling the declaration, `R(...)`, is the call alone. The
lowerings are written against a `newExpr` wrapping that call, the form the
compiler's own synthesized constructors also build, so a checked construction
is handed to them through one stable wrapper per call, built here and never
written into the checked tree.
]]
module nupp.compiler.vm.construction

local wrappers: any = setmetatable({}, {__mode = "k"})

--- Whether a node is a checked construction call.
export function bare(node: any): boolean
    return type(node) == "table" and node.kind == "call" and node.construction == true
end

--- The `newExpr` a construction is lowered as: the node itself when it already
--- is one, the one wrapper of a checked construction call, or nil for anything
--- else.
export function of(node: any): any
    if type(node) ~= "table" then
        return nil
    end
    if node.kind == "newExpr" then
        return node
    end
    if not bare(node) then
        return nil
    end
    local wrapper = wrappers[node]
    if wrapper == nil then
        wrapper = {kind = "newExpr", call = node, inferredType = node.inferredType, node}
        wrappers[node] = wrapper
    end

    return wrapper
end

--- Whether a construction call is plain: built from its fields, with no
--- declared constructor to run.
export function plain(call: any): boolean
    return type(call) == "table" and call.construction == true and not call.constructorCall
end
