--[[
Checked constructions in both spellings.

The checker marks every call that builds a record or a struct with
`construction`. `new R(...)` wraps that call in a `newExpr`; calling the
declaration, `R(...)`, is the call alone. Lowerings are written against the
wrapped form, so a bare construction is handed to them through one stable
wrapper per call, built here and never written into the checked tree.
]]
module nupp.compiler.vm.construction

local wrappers: any = setmetatable({}, {__mode = "k"})

--- Whether a node is a construction call no `new` wraps.
export function bare(node: any): boolean
    return type(node) == "table" and node.kind == "call" and node.construction == true and node.wrapped ~= true
end

--- The `newExpr` a construction is lowered as: the node itself when `new`
--- spelled it, the one wrapper of a bare construction call, or nil for anything
--- else, the call a `new` wraps among them.
export function of(node: any): any
    if type(node) ~= "table" then
        return nil
    end
    if node.kind == "newExpr" then
        return node
    end
    if not bare(node) then
        return nil
    end
    local wrapper = wrappers[node]
    if wrapper == nil then
        wrapper = {kind = "newExpr", call = node, inferredType = node.inferredType, node}
        wrappers[node] = wrapper
    end

    return wrapper
end

--- Whether a construction call is plain: built from its fields, with no
--- declared constructor to run, which is what `isNew` says of the call a `new`
--- wraps.
export function plain(call: any): boolean
    return type(call) == "table" and call.construction == true and not call.constructorCall
end
