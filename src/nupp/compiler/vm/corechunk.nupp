module nupp.compiler.vm.corechunk

--[[
Lua source to a binary chunk the native core installs into its running
program: what Lua's `load` compiles text with there (nupp.runtime.luaload).
The text is checked as plain Lua, lowered in the tagged profile and written
by nupp.compiler.vm.coreartifact. Its chunk is a function of `...`; a name no
declaration binds is a field of the running program's `_G`, and a module it
requires is the running program's, found by name as the call runs.
]]
local parser = require("nupp.compiler.syntax.parser")
local types = require("nupp.compiler.types")
local cst = require("nupp.compiler.syntax.cst")
local triviaarena = require("nupp.compiler.syntax.triviaarena")
local checker: any = require("nupp.compiler.check")
local environment: any = require("nupp.compiler.project.env")
local bundled = require("nupp.compiler.bundled")
local program = require("nupp.compiler.vm.programgraph")
local tagged = require("nupp.compiler.vm.taggedprofile")
local executable = require("nupp.compiler.vm.coregraphexecutable")
local writer = require("nupp.compiler.vm.coreartifact")

-- The graph profile and executable version the core runs.
const VERSION = 8
-- The module a chunk is compiled as; it is never registered by name.
const MODULE = "nupp.chunk"
-- The checker reads a source as plain Lua by this suffix.
const LUA_SUFFIX = ".lua"
-- A chunk is the body of a function of `...`, whose globals are fields of
-- its environment (Lua's _ENV): the table `load` was given, else the running
-- program's `_G` (nupp.runtime.luaload.environment, required by a computed
-- name the checker does not read). The opening shares the first line, so
-- every line keeps its number.
const ENVIRONMENT = "__nupp_env"
-- And the library functions as the program started, which a call through
-- a global calls the core for directly while the environment holds them.
const BUILTINS = "__nupp_builtins"
const ENVIRONMENT_OPENING = "local __nupp_env, __nupp_builtins = require(\"nupp.runtime.\" .. \"luaload\").environment() "
const OPENING = ENVIRONMENT_OPENING .. "return function(...) "
-- A Nupp module's chunk is the module itself, its environment declared on
-- its module line: its value is the module's, made afresh each time the
-- chunk starts (a module instance), and its requires go through its
-- environment's `require`.
const NUPP_SUFFIX = ".nupp"
const CLOSING = "\nend\n"

-- Calls `visit` with each call's argument list in the tree under `node`.
local function eachArguments(node: any, visit: function(any): nil): nil
    if type(node) ~= "table" or cst.isToken(node) then
        return
    end
    if node.kind == "args" then
        visit(node)
    end
    for _, child in ipairs(node) do
        eachArguments(child, visit)
    end
end

-- Lua's `f "s"` and `f {...}` written as the calls of one argument they are,
-- which is the only form the core's lowering calls by.
local function positional(node: any): nil
    if node.exprs == nil then
        if node.str ~= nil then
            local token = node.str
            local literal: any = cst.StringLit(kind = "string")
            literal.token = cst.add(literal, token)
            for index, child in ipairs(node) do
                if child == token then
                    node[index] = literal
                end
            end
            node.exprs, node.str = {literal}, nil
        elseif node.table ~= nil then
            node.exprs, node.table = {node.table}, nil
        end
    end
end

-- Gives `any` to the call arguments checking left untyped (those of a call
-- the checker reads itself, `ffi.cdef [[...]]`): a chunk passes them as values.
local function untyped(node: any): nil
    for _, argument in ipairs(node.exprs or {}) do
        if argument.inferredType == nil then
            argument.inferredType = types.any
        end
    end
end

-- The core has no FFI: the lexer keeps its trivia in tables.
triviaarena.installDefault(require("nupp.compiler.syntax.triviaarena.table"))

-- The checking environment, made once: its prelude is the costly part.
local held: any = nil
-- Directories checked against beside the checkout (checkingRoot).
local extraRoots: {string} = {}

local function checkingEnvironment(): any
    if held == nil then
        -- The checkout the compiler's declarations are read from, which the
        -- core names only through its environment.
        local named = os.getenv("NUPP_COMPILER_ROOT")
        local root = named ~= nil and named ~= "" and named or environment.compilerRoot() or "."
        bundled.checkout(root)
        held = environment.new(root, {
            -- Module sources are found on disk only under extra roots.
            memoryOnly = #extraRoots == 0,
            cache = false,
            nativeCompilerServices = false,
            -- C declarations a checked module makes (`cdef`, import-c) are read
            -- by the C-header service: the VM's libclang on the host, the
            -- core's corecdecl over the same library on the core.
            compilerServices = {cheader = require("nupp.compiler.cinterop.cheader")},
            -- The checkout's nupp.lua configures its projects, not a chunk;
            -- reading it would load Lua text from within `load`.
            config = {include = extraRoots}
        })
    end

    return held
end

--- Checks chunk sources against the modules under `path` too, beside the
--- checkout's: a guest build's staged fixtures, which its module instance
--- fixtures require.
export function checkingRoot(path: string): nil
    for _, root in ipairs(extraRoots) do
        if root == path then
            return
        end
    end
    extraRoots[#extraRoots + 1] = path
    -- The environment indexes its roots as it is made.
    held = nil
end

-- Marks the opening's own require, which finds the environment the rest
-- of the chunk reads: it is the running program's, whatever the
-- environment holds.
local function markOpening(root: any): nil
    local found = false

    local function visit(node: any): nil
        if found or type(node) ~= "table" or cst.isToken(node) then
            return
        end
        if node.kind == "call" and node.obj and node.obj.kind == "name" and node.obj.token.text == "require" then
            node.chunkOpening, found = true, true
            return
        end
        for _, child in ipairs(node) do
            visit(child)
        end
    end

    visit(root)
end

-- A message about chunk `display` at `line`, as Lua positions one.
local function positioned(display: string, line: integer?, message: any): string
    return display .. ":" .. tostring(line or 0) .. ": " .. tostring(message)
end

-- `text` parsed as the chunk at `path`, or nil and its first syntax error.
local function parsed(text: string, path: string, display: string): (any, string?)
    local tree: any = parser.parse(text, path)
    if #tree.errors > 0 then
        local problem = tree.errors[1]
        return nil, positioned(display, problem.line, problem.msg or problem.message)
    end
    markOpening(tree.root)

    return tree, nil
end

-- What checking a chunk's tree as module `name` finds.
local function checked(tree: any, path: string, name: string): {any}
    return checker.check(tree, path, checkingEnvironment(), {
        moduleName = name,
        strict = false,
        lints = {["unused-binding"] = "off"}
    })
end

-- The program catalog of Lua source `text` as a chunk, or nil and a message
-- for text that does not parse. What the checker finds does not refuse it:
-- Lua's loaders refuse only syntax, and a chunk's values are dynamic where
-- its checking found them wanting. Its Lua source (debug.getinfo's) is
-- `source`, the name the loader was given, or "=" and `display`.
export function describe(text: string, display: string, source: string?): (any, string?)
    local path = display .. LUA_SUFFIX
    local tree, problem = parsed(OPENING .. text .. CLOSING, path, display)
    if tree == nil then
        return nil, problem
    end
    eachArguments(tree.root, positional)
    local diagnostics = checked(tree, path, MODULE)
    tree.moduleName = tree.moduleName or MODULE
    eachArguments(tree.root, untyped)
    local catalog = program.describe(
        {
            {
                name = MODULE,
                path = display,
                chunkname = source or "=" .. display,
                parsed = tree,
                diagnostics = diagnostics
            }
        },
        MODULE,
        {chunk = true, environment = ENVIRONMENT, builtins = BUILTINS}
    )

    return catalog, nil
end

-- A module instance's requires go through its environment's `require`,
-- which may answer another module or a fixture's stand-in for one: each
-- require (but the opening's) is a call of the global `require`, the local
-- it binds an ordinary local, and a path through that local (`log.warner`,
-- `gccalls.install(f)`) a read of what it holds, by name. Only the checker's
-- record of which module each names goes; its types stay.
local function requiresThroughEnvironment(root: any, path: string): nil
    local function visit(node: any): nil
        if type(node) ~= "table" then
            return
        end
        if cst.isToken(node) then
            local definition = node.definition
            if definition ~= nil and definition.filename == path and definition.requiredModule ~= nil then
                definition.requiredModule = nil
            end
            return
        end
        -- A standard library root (`io`, `require("io")`) projects the
        -- running program's builtin library, and stays as it is.
        if node.standardRoot ~= nil then
            return
        end
        -- So do the opening's require and a require of types alone, which
        -- loads nothing.
        if node.kind == "call" and node.runtimeLoader == "require" then
            if node.chunkOpening or node.typeOnlyRequire then
                return
            end
            -- What the environment's require answers is any value.
            node.runtimeLoader = nil
            node.inferredType = node.inferredType or types.any
            if node.args ~= nil then
                untyped(node.args)
            end
        end
        node.qualifiedModule = nil
        node.requiredModule = nil
        for _, child in ipairs(node) do
            visit(child)
        end
    end

    visit(root)
end

-- The program catalog of Nupp module source `text` as a chunk, its checked
-- types honored, or nil and a message where it does not parse or check:
-- its value is the module's, and its requires and globals go through its
-- environment. `display` names it in errors and `source` is its Lua source,
-- "@" and `display` without it.
export function describeModule(text: string, display: string, source: string?): (any, string?)
    local path = string.sub(display, -#NUPP_SUFFIX) == NUPP_SUFFIX and display or display .. NUPP_SUFFIX
    -- The environment is declared where the module statement ends, on its
    -- line, so every line keeps its number.
    local plain, problem = parsed(text, path, display)
    if plain == nil then
        return nil, problem
    end
    -- A module without a module statement is named by its path under a
    -- checkout's src/, as the standard library's are, and its environment
    -- is declared where its first statement starts.
    local name, statement = cst.declaredModule(plain.root)
    local wrapped: string? = nil
    local last = statement and cst.lastToken(statement)
    if last ~= nil then
        local at = last.offset + #last.text - 1
        wrapped = string.sub(text, 1, at) .. " " .. ENVIRONMENT_OPENING .. string.sub(text, at + 1)
    else
        local relative = string.match(path, "^src/(.+)%.nupp$") or string.match(path, "/src/(.+)%.nupp$")
        local first = plain.root.blocks
            and plain.root.blocks[1]
            and plain.root.blocks[1].stats
            and plain.root.blocks[1].stats[1]
        local token = first and cst.firstToken(first)
        if relative ~= nil and token ~= nil then
            name = (string.gsub(string.gsub(relative as string, "/init$", ""), "/", "."))
            wrapped = string.sub(text, 1, token.offset - 1) .. ENVIRONMENT_OPENING .. string.sub(text, token.offset)
        end
    end
    if name == nil or wrapped == nil then
        return nil, positioned(display, 0, "a module instance needs a module declaration")
    end
    local tree, wrappedProblem = parsed(wrapped as string, path, display)
    if tree == nil then
        return nil, wrappedProblem
    end
    local diagnostics = checked(tree, path, name as string)
    for _, diagnostic in ipairs(diagnostics) do
        if diagnostic.severity == "error" then
            return nil, positioned(display, diagnostic.line, diagnostic.msg)
        end
    end
    requiresThroughEnvironment(tree.root, path)
    local catalog = program.describe(
        {{name = name, path = path, chunkname = source or "@" .. display, parsed = tree, diagnostics = diagnostics}},
        name,
        {chunk = true, module = true, environment = ENVIRONMENT, builtins = BUILTINS}
    )

    return catalog, nil
end

-- A describer of chunk source: `describe` or `describeModule`.
local type Describer = function(string, string, string?): (any, string?)

-- What `use` makes of the chunk `text` describes, or nil and why it does not
-- parse.
local function described(
    describer: Describer,
    text: string,
    display: string,
    source: string?,
    use: function(any): any
): (any, string?)
    local catalog, refused = describer(text, display, source)
    if catalog == nil then
        return nil, refused
    end

    return use(catalog), nil
end

-- The binary chunk of the source `describer` reads, or nil and a message.
local function compiled(describer: Describer, text: string, display: string, source: string?): (string?, string?)
    local ok, result, problem = pcall(function(): (string?, string?)
        return described(describer, text, display, source, function(catalog: any): any
            return writer.chunk(executable.fromChecked(program.compile(catalog, tagged.forVersion(VERSION)), VERSION))
        end)
    end)
    if not ok then
        return nil, display .. ": " .. tostring(result)
    end

    return result, problem
end

--- Compile Lua source `text` to a binary chunk. `display` is the name its
--- errors cite (Lua's chunkid of the chunk's name) and `source` that name
--- itself, which debug.getinfo answers ("@" and a file for `loadfile`);
--- without it, "=" and `display`. Answers the chunk, or nil and a message as
--- Lua's loaders do.
export function compile(text: string, display: string, source: string?): (string?, string?)
    return compiled(describe, text, display, source)
end

--- Compile Nupp module source `text` to a binary chunk whose start makes an
--- instance of the module (describeModule): `display` names it in errors and
--- `source` is its Lua source, "@" and `display` without it. Answers the
--- chunk, or nil and a message.
export function compileModule(text: string, display: string, source: string?): (string?, string?)
    return compiled(describeModule, text, display, source)
end

--- Everything that keeps Lua source `text` from compiling as a chunk, across
--- all of it (program.inventory), or nil and a message where it does not parse.
export function inventory(text: string, display: string): (any, string?)
    return described(describe, text, display, nil, function(catalog: any): any
        return program.inventory(catalog, tagged.forVersion(VERSION))
    end)
end
