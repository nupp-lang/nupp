module nupp.compiler.vm.nativeframeverify

-- Final-core facts are separate from legacy VM FrameRecover conventions.
-- The caller is the private source issuer. This verifier never issues roles.

local function need(ok: any, message: string): any
    assert(ok, "native final frame: " .. message)
    return ok
end

local function copy(source: any): any
    local result = {}
    for key, value in pairs(source) do
        result[key] = value
    end

    return result
end

local function clone(state: any): any
    return {
        values = copy(state.values),
        active = copy(state.active),
        refreshed = copy(state.refreshed),
        pending = copy(state.pending),
        proven = copy(state.proven),
        failed = state.failed,
        completed = state.completed
    }
end

export function verify(g: any, calls: any, entry: any?): nil
    need(g.native.abi == "handler" and g.nparams == 6, "final probe handler signature")
    local atoms, inputs, degree, queue = {}, {}, {}, {}

    local function atom(key: string, fields: any): any
        if not atoms[key] then
            fields.id = key
            atoms[key] = fields
        end

        return atoms[key]
    end

    local unknown = atom("unknown", {kind = "unknown"})

    local function raw(id: integer): any
        return atom("raw:" .. id, {kind = "raw"})
    end

    local function value(state: any, id: integer): any
        return need(state.values[id], "missing transported value fact")
    end

    local function alive(state: any, fact: any, comparison: boolean?): nil
        need(fact ~= unknown, "mixed or missing owner at join")
        if fact.kind == "pending" and not comparison then
            need(
                fact.test == "nonzero" and state.pending[fact] and state.active[fact.owner.state] == fact.owner,
                "invalidated prepared address/status is not a pointer"
            )
        elseif fact.owner and fact.kind ~= "pending" then
            need(state.active[fact.owner.state] == fact.owner, "invalidated frame/window/code/PC alias")
        end
        if fact.kind == "alias" then
            alive(state, fact.base)
        end
    end

    local function ownership(state: any, fact: any): any
        if fact.owner then
            return fact.owner
        end
        if fact.kind == "alias" then
            return ownership(state, fact.base)
        end

        return state.active[fact.id] or state.refreshed[fact.id]
    end

    local function stateOwner(state: any, address: any): any
        alive(state, address)
        need(address.kind == "raw", "State address lacks exact setup identity")
        return need(state.active[address.id], "State has no successful setup/publish edge")
    end

    local function frameOwner(state: any, address: any, frame: any): any
        local owner = stateOwner(state, address)
        alive(state, frame)
        need(frame.kind == "frame" and frame.owner == owner, "active Frame owner differs")
        return owner
    end

    local function kill(state: any): nil
        state.active, state.refreshed, state.pending, state.proven = {}, {}, {}, {}
        state.completed = false
    end

    local function access(state: any, kind: string, owner: any): any
        return atom(kind .. ":" .. owner.id, {kind = kind, owner = owner})
    end

    local function refine(state: any, condition: any, yes: boolean): nil
        if condition.kind ~= "comparison" then
            return
        end
        local pending, literal = condition.left, condition.right
        if pending.kind == "constant" then
            pending, literal = literal, pending
        end
        if entry and condition.unsigned and condition.right.kind == "count" then
            local owner = condition.right.owner
            if (condition.operator == ">=" and not yes) or (condition.operator == "<" and yes) then
                state.proven["slot:" .. condition.left.id .. ":" .. owner.id] = true
            end
        end
        if literal.kind ~= "constant" or pending.kind ~= "pending" then
            return
        end
        local equal = condition.operator == "=="
        if not equal and condition.operator ~= "~=" then
            return
        end
        local succeeds = pending.test == "nonzero" and literal.text == "0" and yes ~= equal
            or pending.test == "one" and literal.text == "1" and yes == equal
        if state.pending[pending] then
            if succeeds then
                if pending.proof then
                    state.proven[pending.proof] = true
                end
                if pending.completes then
                    state.completed = true
                elseif pending.activates ~= false then
                    state.active[pending.owner.state] = pending.owner
                end
            elseif entry and pending.fails and pending.test == "one" and literal.text == "1" and yes ~= equal then
                state.failed = true
            end
        end
    end

    local function contextOwner(state: any, ctx: any, frame: any, pc: any?): any
        need(entry and ctx.kind == "context" and ctx.id == "entry-context", "executable context differs")
        local owner = need(state.active["entry-state"], "State has no successful entry/transition edge")
        alive(state, frame)
        need(frame.kind == "frame" and frame.owner == owner, "executable Frame owner differs")
        if pc then
            alive(state, pc)
            need(pc.kind == "pc" and pc.owner == owner, "executable PC owner differs")
        end

        return owner
    end

    local function check(state: any, dst: integer, owner: any, test: string, proof: string?, fails: boolean?): any
        local result = atom("checked:" .. dst .. ":" .. owner.id, {
            kind = "pending",
            owner = owner,
            test = test,
            proof = proof,
            activates = false,
            fails = fails
        })
        state.pending[result] = true

        return result
    end

    local function transfer(block: any, incoming: any): any
        local state = clone(incoming)
        for index, op in ipairs(block.op) do
            local args, dst = block.args[index], block.dst[index]
            local result: any = dst ~= 0 and raw(dst) or nil
            local _ = switch op do
                case "NativeBoolean" -> do
                    need(entry ~= nil, "unsupported authority boolean")
                    result = raw(dst)
                    yield nil
                end
                case "NativeConstant" -> do
                    result = atom("constant:" .. tostring(args[1]), {kind = "constant", text = tostring(args[1])})
                    yield nil
                end
                case "NativePointer", "NativeAddress", "NativeWordCast" -> do
                    result = value(state, args[1])
                    alive(state, result)
                    if entry and result.pcResult then
                        need(state.proven[result.proof], "branch target lacks success")
                        result = atom("pc-result:" .. result.id, {kind = "pc", owner = result.owner})
                    end
                    yield nil
                end
                case "PointerOffset", "IAdd", "ISub" -> do
                    local first, second = value(state, args[1]), value(state, args[2])
                    alive(state, first)
                    alive(state, second)
                    local owner = ownership(state, first) or ownership(state, second)
                    if owner then
                        result = atom("alias:" .. dst .. ":" .. owner.id, {kind = "alias", owner = owner, base = first})
                    end
                    yield nil
                end
                case "NativeFloatFromBits", "NativeFloatBits", "FAdd", "NativeSelect", "IAnd" -> do
                    if op == "NativeFloatFromBits" or op == "FAdd" then
                        need(g.exactTypes[dst] == "float64", "numeric operation result is not a float")
                    else
                        need(g.exactTypes[dst] == "uint64", "numeric operation result is not a word")
                    end
                    for _, source in ipairs(args) do
                        alive(state, value(state, source))
                    end
                    -- Arithmetic and bitcasts cannot mint Frame/PC/window authority.
                    result = raw(dst)
                    yield nil
                end
                case "NativeFCmp" -> do
                    need(g.exactTypes[dst] == "boolean", "floating comparison result is not boolean")
                    alive(state, value(state, args[1]))
                    alive(state, value(state, args[2]))
                    -- A scalar comparison does not establish frame or catalog
                    -- authority.
                    result = raw(dst)
                    yield nil
                end
                case "NativeICmp" -> do
                    local left, right = value(state, args[1]), value(state, args[2])
                    alive(state, left, true)
                    alive(state, right, true)
                    result = atom("compare:" .. dst .. ":" .. left.id .. ":" .. right.id, {
                        kind = "comparison",
                        left = left,
                        right = right,
                        operator = args[3],
                        unsigned = g.exactTypes[args[1]] == "uint64" and g.exactTypes[args[2]] == "uint64"
                    })
                    yield nil
                end
                case "NativeLoad" -> do
                    local base, offset = value(state, args[1]), value(state, args[2])
                    alive(state, base)
                    alive(state, offset)
                    local owner = ownership(state, base) or ownership(state, offset)
                    if entry
                        and base.kind == "frame"
                        and offset.kind == "constant"
                        and offset.text == tostring(entry.valueCountOffset)
                        and args[3].kind == "uint64"
                        and args[3].width == 8
                        and args[3].signed == false
                        and args[3].write == false
                        and args[3].source == "live"
                    then
                        result = access(state, "count", base.owner)
                    elseif owner then
                        -- A loaded word might itself be an address. Conservatively
                        -- retain its owner even for ordinary scalar contents.
                        result = atom("loaded:" .. dst .. ":" .. owner.id, {kind = "loaded", owner = owner})
                    end
                    yield nil
                end
                case "ProgramLoad" -> do
                    need(entry ~= nil, "program access requires closed executable entry")
                    local pc, offset = value(state, args[1]), value(state, args[2])
                    alive(state, pc)
                    alive(state, offset)
                    need(
                        pc.kind == "pc" and state.proven["current:" .. pc.owner.id],
                        "program load lacks current code proof"
                    )
                    need(offset.kind == "constant", "program offset is not a fixed recipe field")
                    local at = tonumber(offset.text)
                    local access = args[3]
                    need(at and at >= 0 and at + access.width <= 16, "program field crosses instruction")
                    result = atom("program:" .. dst .. ":" .. pc.owner.id, {kind = "loaded", owner = pc.owner})
                    yield nil
                end
                case "FrameSlotRead", "FrameSlotWrite" -> do
                    need(entry ~= nil, "slot access requires closed executable entry")
                    local frame, window, slot = value(state, args[1]), value(state, args[2]), value(state, args[3])
                    alive(state, frame)
                    alive(state, window)
                    alive(state, slot)
                    need(
                        frame.kind == "frame" and window.kind == "values" and frame.owner == window.owner,
                        "slot window owner differs"
                    )
                    need(state.proven["slot:" .. slot.id .. ":" .. frame.owner.id], "slot lacks checked window bound")
                    local descriptor = args[op == "FrameSlotRead" and 4 or 5]
                    need(descriptor.class == "v" and descriptor.kind == "uint64", "unsupported executable slot class")
                    if op == "FrameSlotWrite" then
                        alive(state, value(state, args[4]))
                    else
                        result = atom("slot-value:" .. dst .. ":" .. frame.owner.id, {
                            kind = "loaded",
                            owner = frame.owner
                        })
                    end
                    yield nil
                end
                case "NativeStore" -> do
                    for operand = 1, 3 do
                        alive(state, value(state, args[operand]))
                    end
                    kill(state)
                    yield nil
                end
                case "NativeLeafCall" -> do
                    local call = need(calls[block] and calls[block][index], "call lacks checked source origin")
                    local operands = {}
                    for operand = 2, #args do
                        operands[operand - 1] = value(state, args[operand])
                        alive(state, operands[operand - 1])
                    end
                    local role = call.role
                    if entry and role == "entryState" then
                        need(
                            operands[1].kind == "context" and operands[1].id == "entry-context",
                            "State context differs"
                        )
                        need(state.active["entry-state"], "State has no successful entry/transition edge")
                        result = atom("entry-state", {kind = "raw"})
                    elseif entry
                        and (role == "current" or role == "charge" or role == "scalarResult" or role == "branch")
                    then
                        local prior = contextOwner(state, operands[1], operands[2], operands[3])
                        if role == "current" then
                            result = check(state, dst, prior, "nonzero", "current:" .. prior.id)
                        elseif role == "charge" then
                            result = check(state, dst, prior, "one", "charged:" .. prior.id, true)
                        elseif role == "scalarResult" then
                            result = check(state, dst, prior, "one", "scalar:" .. operands[4].id .. ":" .. prior.id)
                        else
                            result = check(state, dst, prior, "nonzero", "pc:" .. dst .. ":" .. prior.id)
                            result.pcResult = true
                        end
                    elseif entry and role == "resume" then
                        local prior = contextOwner(state, operands[1], operands[2], operands[3])
                        result = atom("resume:" .. dst .. ":" .. prior.id, {
                            kind = "resume",
                            owner = prior,
                            pc = operands[3]
                        })
                    elseif entry and role == "prepare" then
                        local prior = contextOwner(state, operands[1], operands[2], operands[3])
                        need(
                            state.proven["charged:" .. prior.id] and state.proven["current:" .. prior.id],
                            "prepare lacks charged current call"
                        )
                        result = check(state, dst, prior, "nonzero", "prepared:" .. dst)
                        result.prepared, result.pc = true, operands[3]
                    elseif entry and role == "root" then
                        local prior = contextOwner(state, operands[1], operands[2])
                        result = check(state, dst, prior, "one", "root:" .. prior.id)
                    elseif entry and role == "finish" then
                        local prior = contextOwner(state, operands[1], operands[2])
                        need(
                            state.proven["root:" .. prior.id]
                            and state.proven["scalar:" .. operands[3].id .. ":" .. prior.id],
                            "root completion lacks exact checked scalar"
                        )
                        kill(state)
                        result = check(state, dst, prior, "one", nil)
                        result.completes = true
                    elseif entry
                        and (
                            role == "constant"
                            or role == "constantPresent"
                            or role == "moduleValue"
                            or role == "closure"
                            or role == "checkpoint"
                        )
                    then
                        local prior = contextOwner(state, operands[1], operands[2], operands[3])
                        need(state.proven["current:" .. prior.id], "entry helper lacks current code proof")
                        if role == "closure" or role == "moduleValue" then
                            need(state.proven["charged:" .. prior.id], "closure lacks charge")
                        end
                        if dst ~= 0 then
                            result = atom("helper-value:" .. dst .. ":" .. prior.id, {kind = "loaded", owner = prior})
                        end
                    elseif entry and (role == "failure" or role == "fail") then
                        need(
                            operands[1].kind == "context" and operands[1].id == "entry-context",
                            "failure context differs"
                        )
                        if role == "fail" then
                            contextOwner(state, operands[1], operands[2], operands[3])
                        end
                        kill(state)
                        state.failed = true
                    elseif role == "setup" then
                        need(operands[1].kind == "raw", "setup State identity")
                        kill(state)
                        local owner = atom("setup:" .. dst, {kind = "owner", state = operands[1].id})
                        result = atom("prepared:" .. dst, {kind = "pending", owner = owner, test = "nonzero"})
                        state.pending[result] = true
                    elseif role == "publish" then
                        local prior = frameOwner(state, operands[1], operands[2])
                        need(
                            operands[3].kind == "pending"
                            and operands[3].test == "nonzero"
                            and operands[3].owner == prior,
                            "prepared child belongs to another State/epoch"
                        )
                        if entry then
                            need(
                                operands[3].prepared and state.proven[operands[3].proof],
                                "publish lacks prepared child success"
                            )
                            need(
                                operands[4].kind == "resume"
                                and operands[4].owner == prior
                                and operands[4].pc == operands[3].pc,
                                "publish resume identity differs"
                            )
                        end
                        kill(state)
                        local owner = atom("publish:" .. dst, {kind = "owner", state = prior.state})
                        result = atom("published:" .. dst, {kind = "pending", owner = owner, test = "one"})
                        state.pending[result] = true
                    elseif role == "returnScalar" then
                        local prior = frameOwner(state, operands[1], operands[2])
                        if entry then
                            need(
                                state.proven["scalar:" .. operands[3].id .. ":" .. prior.id],
                                "return lacks exact checked scalar"
                            )
                        end
                        -- The selected scalar is consumed before the service retires
                        -- the callee. Even a failure invalidates cached authority.
                        -- The checked body restores the real parent only on one.
                        kill(state)
                        local owner = atom("return:" .. dst, {kind = "owner", state = prior.state})
                        result = atom("returned:" .. dst, {kind = "pending", owner = owner, test = "one"})
                        state.pending[result] = true
                    elseif role == "active" then
                        result = access(state, "frame", stateOwner(state, operands[1]))
                    elseif role == "refresh" then
                        local owner = frameOwner(state, operands[1], operands[2])
                        need(
                            operands[3].kind == "context" and operands[3].id == "entry-context",
                            "context identity differs"
                        )
                        state.refreshed[operands[3].id] = owner
                    elseif role == "values"
                        or role == "integers"
                        or role == "floats"
                        or role == "code"
                        or role == "pc"
                    then
                        result = access(state, role, frameOwner(state, operands[1], operands[2]))
                    elseif entry and role == "pureScalar" then
                        -- The closed producer issues this role only after proving
                        -- the callee's graph has no memory, pointer, slot, program
                        -- or dispatch operations and calls only other such leaves.
                        -- Its word result therefore carries no authority.
                        need(g.exactTypes[dst] == "uint64", "pure scalar result is not a word")
                        result = raw(dst)
                    else
                        -- No silent purity inference from a name, signature or
                        -- scalar result. Unmodeled calls invalidate all facts.
                        kill(state)
                        result = unknown
                    end
                    yield nil
                end
                else -> do
                    -- The fixed handler needs only this small address/control
                    -- vocabulary. Helpers use the ordinary leaf graph path.
                    error("native final frame: unsupported authority operation " .. op, 0)
                end
            end
            if dst ~= 0 then
                state.values[dst] = result
            end
        end
        local term = block.term
        if term.kind == "dispatch" then
            local args = term.args
            local frame = value(state, args[6])
            alive(state, frame)
            need(frame.kind == "frame", "dispatch lacks current Frame")
            for index, kind in ipairs({"pc", "values", "integers", "floats"}) do
                local fact = value(state, args[index])
                alive(state, fact)
                need(fact.kind == kind and fact.owner == frame.owner, "dispatch PC/code/windows owner mismatch")
            end
            local ctx = value(state, args[5])
            need(
                ctx.kind == "context" and ctx.id == "entry-context" and state.refreshed[ctx.id] == frame.owner,
                "CODE_START was not refreshed for owner"
            )
        elseif term.kind == "branch" then
            alive(state, value(state, term.value))
        else
            need(term.kind == "jump" or term.kind == "nativeFail", "unsupported final continuation")
            if entry and term.kind == "nativeFail" then
                need(state.failed or state.completed, "transport exit lacks failure or completed root")
            end
        end

        return state
    end

    -- This first transition slice admits acyclic handler CFGs. Runtime service
    -- loops remain ordinary checked leaves. Cyclic epoch widening is pending.
    local reachable, pending = {[1] = true}, {1}
    local cursor: integer = 1
    while cursor <= #pending do
        local block = g.blocks[pending[cursor]]
        cursor = cursor + 1
        for _, edge in ipairs(block.term.edges) do
            degree[edge.target] = (degree[edge.target] or 0) + 1
            if not reachable[edge.target] then
                reachable[edge.target] = true
                pending[#pending + 1] = edge.target
            end
        end
    end
    local initial = {
        values = {},
        active = {},
        refreshed = {},
        pending = {},
        proven = {},
        failed = false,
        completed = false
    }
    for id = 1, g.nparams do
        initial.values[id] = raw(id)
    end
    initial.values[5] = atom("entry-context", {kind = "context"})
    if entry then
        local owner = atom("entry-owner", {kind = "owner", state = "entry-state"})
        initial.active[owner.state], initial.refreshed["entry-context"] = owner, owner
        for index, kind in ipairs({"pc", "values", "integers", "floats"}) do
            initial.values[index] = access(initial, kind, owner)
        end
        initial.values[6] = access(initial, "frame", owner)
    end
    inputs[1], queue[1] = initial, 1
    cursor = 1
    while cursor <= #queue do
        local id = queue[cursor]
        cursor = cursor + 1
        local block = g.blocks[id]
        local output = transfer(block, inputs[id])
        for edgeIndex, edge in ipairs(block.term.edges) do
            local state = clone(output)
            if block.term.kind == "branch" then
                refine(state, value(state, block.term.value), edgeIndex == 1)
            end
            state.values = {}
            for parameter = 1, g.nparams do
                state.values[parameter] = output.values[parameter]
            end
            for index, parameter in ipairs(g.blocks[edge.target].params) do
                state.values[parameter] = value(output, edge.args[index])
            end
            local previous = inputs[edge.target]
            if not previous then
                inputs[edge.target] = state
            else
                for parameter, fact in pairs(previous.values) do
                    if state.values[parameter] ~= fact then
                        previous.values[parameter] = unknown
                    end
                end
                for address, owner in pairs(previous.active) do
                    if state.active[address] ~= owner then
                        previous.active[address] = nil
                    end
                end
                for fact in pairs(previous.pending) do
                    if not state.pending[fact] then
                        previous.pending[fact] = nil
                    end
                end
                previous.failed = previous.failed and state.failed
                previous.completed = previous.completed and state.completed
                for proof in pairs(previous.proven) do
                    if not state.proven[proof] then
                        previous.proven[proof] = nil
                    end
                end
                for address, owner in pairs(previous.refreshed) do
                    if state.refreshed[address] ~= owner then
                        previous.refreshed[address] = nil
                    end
                end
            end
            degree[edge.target] = degree[edge.target] - 1
            if degree[edge.target] == 0 then
                queue[#queue + 1] = edge.target
            end
        end
    end
    need(#queue == #pending, "cyclic final-frame continuation is not admitted")
end
