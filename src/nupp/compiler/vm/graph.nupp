module nupp.compiler.vm.graph

--- The typed closed-block control-flow graph every backend consumes: the VM
--- image, Cranelift and the GPU emitters. Blocks are closed: a value a block
--- reads is one of its parameters, defined earlier in the block, or one of
--- the function's parameters, which are immutable and visible everywhere.
--- SSA value ids are distinct from the slot hints the derived instruction
--- stream lays registers out by. Columns are plain tables; nothing here
--- allocates a table per instruction.
local graphsignatures = require("nupp.compiler.vm.graphsignatures")

local graphnative = require("nupp.compiler.vm.graphnative")
local graphcalls = require("nupp.compiler.vm.graphcalls")
local graphverify = require("nupp.compiler.vm.graphverify")
local graphprune = require("nupp.compiler.vm.graphprune")
local graphlower = require("nupp.compiler.vm.graphlower")
local lowered = graphsignatures.lowered
local nativeArithmetic = graphsignatures.nativeArithmetic
local nativeClasses = graphsignatures.nativeClasses
local nativeOnly = graphsignatures.nativeOnly
local operationArity = graphsignatures.operationArity
local parsed = graphsignatures.parsed

-- The operations' signatures, parsed and as written, and the register classes.
export const signatures = graphsignatures.parsed
export const signatureText = graphsignatures.signatures
export const classes = graphsignatures.classes

--- A graph for a function of `nparams` boxed parameters. The parameters are
--- the first `nparams` value ids, class `v`, one slot each, usable in every
--- block without being passed.
export function new(nparams: integer): any
    local g = {
        nparams = nparams,
        blocks = {},
        types = {},
        slots = {},
        counts = {v = 0, i = 0, f = 0, x = 0},
        constants = {},
        positions = {},
        certificates = {}
    }
    for i = 1, nparams do
        g.types[i], g.slots[i] = "v", i
    end

    return g
end

export function value(g: any, ty: string, slot: integer?): integer
    local id = #g.types + 1
    if slot == nil then
        slot = g.counts[ty]
        g.counts[ty] = (slot as integer) + 1
    end
    g.types[id], g.slots[id] = ty, slot

    return id
end

-- Native graph signatures describe logical arguments, independent of
-- the downstream machine calling convention.
export function newNative(parameterKinds: {string}, resultKind: string, abi: string): any
    local g = new(#parameterKinds)
    local params = {}
    g.exactTypes = {}
    for i, kind in ipairs(parameterKinds) do
        local class = assert(nativeClasses[kind], "native parameter requires an exact scalar kind")
        params[i] = kind
        g.types[i], g.slots[i], g.exactTypes[i] = class, g.counts[class], kind
        g.counts[class] = g.counts[class] + 1
    end
    g.native = {params = params, result = resultKind, abi = abi}

    return g
end

--- Allocates an exact native value in the graph's existing storage classes.
export function nativeValue(g: any, kind: string, slot: integer?): integer
    assert(
        g.native ~= nil and nativeClasses[kind] and (kind ~= "int32" and kind ~= "uint32" or g.nativePhysical ~= nil),
        "invalid native graph value kind"
    )
    local id = value(g, nativeClasses[kind], slot)
    g.exactTypes[id] = kind

    return id
end

export function block(g: any): any
    local b = {id = #g.blocks + 1, params = {}, op = {}, dst = {}, args = {}, pos = {}, cert = {}}
    g.blocks[b.id] = b
    return b
end

--- A source position, shared by every instruction emitted at it.
export function position(g: any, line: integer, column: integer): integer
    local positions = g.positions
    positions[#positions + 1] = {line = line, column = column}
    return #positions
end

--- The certificate an elided span access cites: the guard, cursor and span
--- length values that justify it.
export function certificate(g: any, guard: integer, cursor: integer, span: integer): integer
    local certificates = g.certificates
    certificates[#certificates + 1] = {guard = guard, cursor = cursor, span = span}
    return #certificates
end

--- Appends an instruction; the result, when the opcode has one, is a fresh
--- value on the next free slot of its class, or on `slot` when given (a call
--- window's base, which the arguments above it were placed by).
--- @raises string when the opcode is unknown, a terminator, or given the
--- wrong number of operands.
export function emit(g: any, b: any, op: string, args: any, pos: integer?, cert: integer?, slot: integer?): integer?
    local sig = parsed[op]
    if sig == nil then
        error("unknown graph operation: " .. op, 0)
    elseif not operationArity(sig, args) then
        error("graph operation arity: " .. op, 0)
    elseif sig.terminator then
        error("terminator opcode inside a block: " .. op, 0)
    end
    local class = sig.result
    local id = class ~= "-" and value(g, lowered[class], slot) or nil
    local at = #b.op + 1
    b.op[at], b.dst[at], b.args[at], b.pos[at], b.cert[at] = op, id or 0, args, pos or 0, cert or 0

    return id
end

--- Appends a native operation without erasing its exact kind or contracts.
export function emitNative(g: any, b: any, op: string, args: any, kind: string?, pos: integer?): integer?
    assert(g.native ~= nil and (nativeOnly[op] or nativeArithmetic[op]), "unsupported native graph operation")
    local sig = assert(parsed[op], "unknown native graph operation")
    assert(operationArity(sig, args) and not sig.terminator, "invalid native operation arity")
    if sig.variadic then
        assert(type(args[1]) == "table", "native helper requires its checked declaration")
    end
    local hasResult = sig.result ~= "-" and not (sig.variadic and args[1].result == "nil")
    local result: integer? = nil
    if hasResult then
        assert(kind ~= nil and nativeClasses[kind], "native result requires an exact kind")
        result = nativeValue(g, kind as string)
    else
        assert(kind == nil, "native effect has no result kind")
    end
    local at = #b.op + 1
    b.op[at], b.dst[at], b.args[at], b.pos[at], b.cert[at] = op, result or 0, args, pos or 0, 0

    return result
end

-- A body's parameters as the core binds them: a method's implicit receiver
-- (attached by programgraph) first.
export function parameters(body: any): {any}
    local params = {}
    if body.coreSelfParam then
        params[1] = body.coreSelfParam
    end
    for _, parameter in ipairs(body.params or {}) do
        params[#params + 1] = parameter
    end

    return params
end

-- The graph's signatures, native contracts, call contracts, verifier, passes and
-- lowering, each its subject module's.
export const closureTarget = graphsignatures.closureTarget
export const nativeLeafDeclaration = graphnative.nativeLeafDeclaration
export const omits = graphcalls.omits
export const checking = graphcalls.checking
export const libraryValue = graphcalls.libraryValue
export const libraryModule = graphcalls.libraryModule
export const mayUseIo = graphcalls.mayUseIo
export const mayUseScheduler = graphcalls.mayUseScheduler
export const mayTakeLibraryValue = graphcalls.mayTakeLibraryValue
export const corecallmodule = graphcalls.corecallmodule
export const erased = graphcalls.erased
export const coremodule = graphcalls.coremodule
export const dynamicRequire = graphcalls.dynamicRequire
export const coreLibraryField = graphcalls.coreLibraryField
export const coreLibraryCall = graphcalls.coreLibraryCall
export const packedcall = graphcalls.packedcall
export const genericiterator = graphcalls.genericiterator
export const iteratorcontract = graphcalls.iteratorcontract
export const dynamicmethodcontract = graphcalls.dynamicmethodcontract
export const dynamicInvokeContract = graphcalls.dynamicInvokeContract
export const expandsResults = graphcalls.expandsResults
export const spreadsLast = graphcalls.spreadsLast
export const callbackArgument = graphcalls.callbackArgument
export const callbackInvokeContract = graphcalls.callbackInvokeContract
export const protectedInvokeContract = graphcalls.protectedInvokeContract
export const constructContract = graphcalls.constructContract
export const invokeContract = graphcalls.invokeContract
export const verify = graphverify.verify
export const verifyGuestStructure = graphverify.verifyGuestStructure
export const prune = graphprune.prune
export const dropUnreachable = graphprune.dropUnreachable
export const regions = graphprune.regions
export const lower = graphlower.lower
