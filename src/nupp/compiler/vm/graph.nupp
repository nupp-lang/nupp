module nupp.compiler.vm.graph

--- The typed closed-block control-flow graph every backend consumes: the VM
--- image, Cranelift and the GPU emitters. Blocks are closed: a value a block
--- reads is one of its parameters, defined earlier in the block, or one of
--- the function's parameters, which are immutable and visible everywhere.
--- SSA value ids are distinct from the slot hints the derived instruction
--- stream lays registers out by. Columns are plain tables; nothing here
--- allocates a table per instruction.
local graph = {}

local frameverify = require("nupp.compiler.vm.frameverify")
local finalframe = require("nupp.compiler.vm.nativeframecontract")
local graphcopies = require("nupp.compiler.vm.graphcopies")
local physical = require("nupp.compiler.vm.nativephysical")
local nativeos = require("nupp.compiler.vm.nativeos")
local service = require("nupp.compiler.vm.nativeservice")

-- One signature per opcode: the result class is the uppercase letter, at the
-- position the VM's operand order puts it; every other letter is one operand.
--   v i f x   a value, integer, float or vector register value
--   #         a small immediate (a count, width, kind, flag or offset)
--   k         a constant-pool index
--   n         a function index in the image
--   h         a shape index in the image
--   s         a named immediate (a SIMD operation or element kind)
--   w         a value-slot immediate: a register window's base, raw until
--             P4 gives windows ids; a call's window base is its result
--   L  D      a wide signed integer or a float literal
--   j  t      a jump offset or table, only on terminator opcodes
-- An opcode listed under `terminators` never appears inside a block: the
-- terminator records produce it. Graph-only macros expand when lowered.
local opcodes = require("nupp.compiler.vm.opcodes")
local reactorcalls = require("nupp.compiler.vm.reactorcalls")

-- A signature spells one instruction's operands in order, a letter each: a
-- register of class v, i, f or x, uppercase where the instruction defines
-- it; `w` a window base register; `k` a constant index, `j` a jump offset,
-- `n` a function id, `t` a jump table, `h` a shape, `s` a name; `#`, `L` and
-- `D` immediates, the last two a wide integer and a double, which the image
-- codec spells differently. Every VM opcode's signature derives from the
-- opcode table, so the graph keeps no second account of an instruction.
-- What the table cannot say is pinned here: which immediates are wide or
-- double, and the class a kind operand decides for the SIMD scalar ops,
-- since a graph value has one class.
local payloads = {
    IK = {[2] = "L"},
    IAddK = {[3] = "L"},
    FK = {[2] = "D"},
    VLoadM = {[4] = "L"},
    VStoreM = {[4] = "L"},
    VLoad = {[4] = "L"},
    VStore = {[4] = "L"},
    LoopFact = {[2] = "L"}
}
local pinned = {VSplatN = "Xf#", VExtractN = "Fx##"}
local classLetters = {k = "k", j = "j", fn = "n", t = "t", s = "h", name = "s", n = "#"}

local function derive(name: string): string
    local described = assert(opcodes.describe(name), name)
    local bases = {}
    for i = 1, #described.windows do
        local base = tonumber(described.windows[i]:match("@(%d+)%+"))
        if base then
            bases[base] = true
        end
    end
    local letters = {}
    local operands = described.operands
    for position = 1, #operands do
        local operand = operands[position]
        local class, mode = operand.class, operand.mode
        local letter: string
        if class == "v" or class == "i" or class == "f" or class == "x" then
            -- A register both read and written is a use: a kernel's graph
            -- never holds one, and register-form code names registers.
            if mode == "def" then
                letter = class:upper()
            elseif bases[position] then
                letter = "w"
            else
                letter = class
            end
        else
            letter = classLetters[class] or (class:sub(1, 2) == "sk" and (mode == "def" and "S" or "s")) or "?"
        end
        local payload = payloads[name]
        if payload and payload[position] then
            letter = payload[position] as string
        end
        letters[position] = letter
    end

    return table.concat(letters)
end

local signatures: {[string]: string} = {}
for _, name in ipairs(opcodes.names()) do
    signatures[name] = pinned[name] or derive(name)
end
-- Graph-only macros, expanded by the lowering.
-- A closure's captures are tagged SSA uses. The executable NewClosure
-- window is derived only after verification and value transport.
signatures.Closure = "Vn"
-- Core-only library intrinsics: the final core implements them as opcodes
-- outside the frozen VM's table (corebytecode.coreOnly).
signatures.MathFloor = "Vv"
signatures.LibCall = "V#"
-- An affine value's destructor called on it at the end of its scope.
signatures.Destroy = "vv"
signatures.U32Load = "Ivi"
signatures.U32Store = "vii"
signatures.U32Add = "Iii"
signatures.U32Sub = "Iii"
signatures.SpanEqual = "vvk"
signatures.VSplatI = "Xi#"
signatures.VExtractI = "Ix##"
-- Native systems operations use the same closed-block graph. Their exact
-- Nupp kinds and static contracts are verified before machine emission.
signatures.NativeConstant = "I#"
signatures.NativeHelperCall = "I#"
signatures.NativeLeafCall = "I#"
signatures.NativeLocal = "I#"
signatures.NativeLoad = "Iii#"
signatures.NativeStore = "iia#"
signatures.NativeLayout = "I#"
signatures.NativePointer = "Ii"
signatures.NativePointerView = "Ii#"
signatures.NativeBorrowPointer = "Iii#"
signatures.NativeFieldLoad = "Ii#"
signatures.NativeAddress = "Ii"
signatures.NativeBorrowAddress = "Ii#"
signatures.ProgramLoad = "Iii#"
signatures.FrameSlotRead = "Iiii#"
signatures.FrameVarargRead = "Iii#"
signatures.FrameStatus = "Ii#"
signatures.FrameRecover = "Ii#"
signatures.FrameWindow = "Iii#"
signatures.FrameSlotWrite = "iiia#"
signatures.PointerOffset = "Iii"
signatures.NativeBoolean = "I#"
signatures.NativeIMul = "Iii"
signatures.NativeUDiv = "Iii"
signatures.NativeURem = "Iii"
signatures.NativeSDiv = "Iii"
signatures.NativeSRem = "Iii"
signatures.NativeICmp = "Iii#"
signatures.NativeFCmp = "Iff#"
signatures.NativeAsWord = "Ii"
signatures.NativeSelect = "Iiaa"
signatures.NativeWordCast = "Ii"
signatures.NativeIntToFloat = "Fi"
signatures.NativeFloatToInt = "If"
signatures.NativeFloatConvert = "Ff"
signatures.NativeFloatBits = "If"
signatures.NativeFloatFromBits = "Fi"
signatures.NativeFloat32Bits = "If"
signatures.NativeFloat32FromBits = "Fi"
signatures.NativeRoundFloat32 = "Ff"
signatures.NativeFloor = "Ff"
signatures.NativeCeil = "Ff"
signatures.NativeSqrt = "Ff"
local nativeOnly = {
    NativeConstant = true,
    NativeHelperCall = true,
    NativeLeafCall = true,
    NativeLocal = true,
    NativeLoad = true,
    NativeStore = true,
    NativeLayout = true,
    NativePointer = true,
    NativePointerView = true,
    NativeBorrowPointer = true,
    NativeFieldLoad = true,
    NativeAddress = true,
    NativeBorrowAddress = true,
    ProgramLoad = true,
    FrameSlotRead = true,
    FrameVarargRead = true,
    FrameStatus = true,
    FrameRecover = true,
    FrameWindow = true,
    FrameSlotWrite = true,
    PointerOffset = true,
    NativeBoolean = true,
    NativeIMul = true,
    NativeUDiv = true,
    NativeURem = true,
    NativeSDiv = true,
    NativeSRem = true,
    NativeICmp = true,
    NativeFCmp = true,
    NativeAsWord = true,
    NativeSelect = true,
    NativeWordCast = true,
    NativeIntToFloat = true,
    NativeFloatToInt = true,
    NativeFloatConvert = true,
    NativeFloatBits = true,
    NativeFloatFromBits = true,
    NativeFloat32Bits = true,
    NativeFloat32FromBits = true,
    NativeRoundFloat32 = true,
    NativeFloor = true,
    NativeCeil = true,
    NativeSqrt = true
}
local nativeArithmetic = {
    IAdd = true,
    ISub = true,
    NativeIMul = true,
    NativeUDiv = true,
    NativeURem = true,
    NativeSDiv = true,
    NativeSRem = true,
    IAnd = true,
    IOr = true,
    IXor = true,
    INot = true,
    IShl = true,
    IShrU = true,
    FAdd = true,
    FSub = true,
    FMul = true,
    FDiv = true,
    FNeg = true
}
local nativeClasses = {
    voidptr = "i",
    int32 = "i",
    uint32 = "i",
    int64 = "i",
    uint64 = "i",
    boolean = "i",
    float32 = "f",
    float64 = "f"
}
local nativeFloatKinds = {float32 = true, float64 = true}
local terminators = {
    Jmp = true,
    JmpIf = true,
    JmpIfNot = true,
    JmpIfIZero = true,
    IJmpIfUle = true,
    IJmpIfUlt = true,
    Switch = true,
    Ret = true,
    RetNil = true,
    RetN = true,
    FRet = true,
    Raise = true,
    Park = true
}
local macros = {
    Closure = true,
    MathFloor = true,
    LibCall = true,
    Destroy = true,
    U32Load = true,
    U32Store = true,
    U32Add = true,
    U32Sub = true,
    SpanEqual = true,
    VSplatI = true,
    VExtractI = true
}

-- Each signature parsed once: the result class, its position among the
-- operands, and one class letter per operand, so no verifier or lowering pass
-- slices strings per instruction.
local parsed: {[string]: any} = {}
local lowered = {V = "v", I = "i", F = "f", X = "x"}
for op, sig in pairs(signatures) do
    local args, result, at = {}, "-", 0
    for j = 1, #sig do
        local c = sig:sub(j, j)
        if lowered[c] then
            result, at = c, j
        else
            args[#args + 1] = c
        end
    end
    parsed[
        op
    ] = {
        result = result,
        resultAt = at,
        args = args,
        n = #args,
        terminator = terminators[op] == true,
        macro = macros[op] == true
    }
end
-- A named helper keeps all value operands in the same graph columns. Only
-- its checked declaration is immediate metadata; arguments remain visible to
-- the common closed-block verifier and transport pruning.
parsed.NativeHelperCall.variadic = true
parsed.NativeLeafCall.variadic = true
parsed.NativeLocal.variadic = true
parsed.Closure.variadic = true
parsed.Closure.variadicClass = "v"
parsed.Closure.coreOnly = true
parsed.MathFloor.coreOnly = true
parsed.LibCall.coreOnly = true
parsed.Destroy.coreOnly = true
parsed.LibCall.variadic = true
parsed.LibCall.variadicClass = "v"

local function operationArity(sig: any, args: any): boolean
    return #args == sig.n or sig.variadic == true and #args >= sig.n
end

local function operandClass(sig: any, index: integer): string
    return sig.args[index] or (sig.variadic and (sig.variadicClass or "a"))
end

graph.signatures = parsed
graph.signatureText = signatures

-- The complete program verifier supplies target existence, lexical ownership
-- and capture-layout checks. This seam does not resolve a function by name.
function graph.closureTarget(op: string, args: any): (integer?, integer?)
    if op ~= "Closure" then
        return nil, nil
    end
    local target = args[1]
    assert(
        type(target) == "number" and target >= 0 and target < 4294967295 and target % 1 == 0,
        "invalid closure function identity"
    )

    return target as integer, #args - 1
end

local classes = {v = 0, i = 1, f = 2, x = 3}
graph.classes = classes

--- A graph for a function of `nparams` boxed parameters. The parameters are
--- the first `nparams` value ids, class `v`, one slot each, usable in every
--- block without being passed.
function graph.new(nparams: integer): any
    local g = {
        nparams = nparams,
        blocks = {},
        types = {},
        slots = {},
        counts = {v = 0, i = 0, f = 0, x = 0},
        constants = {},
        positions = {},
        certificates = {}
    }
    for i = 1, nparams do
        g.types[i], g.slots[i] = "v", i
    end

    return g
end

function graph.value(g: any, ty: string, slot: integer?): integer
    local id = #g.types + 1
    if slot == nil then
        slot = g.counts[ty]
        g.counts[ty] = (slot as integer) + 1
    end
    g.types[id], g.slots[id] = ty, slot

    return id
end

-- Native graph signatures describe logical arguments, independent of
-- the downstream machine calling convention.
function graph.newNative(parameterKinds: {string}, resultKind: string, abi: string): any
    local g = graph.new(#parameterKinds)
    local params = {}
    g.exactTypes = {}
    for i, kind in ipairs(parameterKinds) do
        local class = assert(nativeClasses[kind], "native parameter requires an exact scalar kind")
        params[i] = kind
        g.types[i], g.slots[i], g.exactTypes[i] = class, g.counts[class], kind
        g.counts[class] = g.counts[class] + 1
    end
    g.native = {params = params, result = resultKind, abi = abi}

    return g
end

--- Allocates an exact native value in the graph's existing storage classes.
function graph.nativeValue(g: any, kind: string, slot: integer?): integer
    assert(
        g.native ~= nil and nativeClasses[kind] and (kind ~= "int32" and kind ~= "uint32" or g.nativePhysical ~= nil),
        "invalid native graph value kind"
    )
    local id = graph.value(g, nativeClasses[kind], slot)
    g.exactTypes[id] = kind

    return id
end

function graph.block(g: any): any
    local b = {id = #g.blocks + 1, params = {}, op = {}, dst = {}, args = {}, pos = {}, cert = {}}
    g.blocks[b.id] = b
    return b
end

--- A source position, shared by every instruction emitted at it.
function graph.position(g: any, line: integer, column: integer): integer
    local positions = g.positions
    positions[#positions + 1] = {line = line, column = column}
    return #positions
end

--- The certificate an elided span access cites: the guard, cursor and span
--- length values that justify it.
function graph.certificate(g: any, guard: integer, cursor: integer, span: integer): integer
    local certificates = g.certificates
    certificates[#certificates + 1] = {guard = guard, cursor = cursor, span = span}
    return #certificates
end

--- Appends an instruction; the result, when the opcode has one, is a fresh
--- value on the next free slot of its class, or on `slot` when given (a call
--- window's base, which the arguments above it were placed by).
--- @raises string when the opcode is unknown, a terminator, or given the
--- wrong number of operands.
function graph.emit(g: any, b: any, op: string, args: any, pos: integer?, cert: integer?, slot: integer?): integer?
    local sig = parsed[op]
    if sig == nil then
        error("unknown graph operation: " .. op, 0)
    elseif not operationArity(sig, args) then
        error("graph operation arity: " .. op, 0)
    elseif sig.terminator then
        error("terminator opcode inside a block: " .. op, 0)
    end
    local class = sig.result
    local id = class ~= "-" and graph.value(g, lowered[class], slot) or nil
    local at = #b.op + 1
    b.op[at], b.dst[at], b.args[at], b.pos[at], b.cert[at] = op, id or 0, args, pos or 0, cert or 0

    return id
end

--- Appends a native operation without erasing its exact kind or contracts.
function graph.emitNative(g: any, b: any, op: string, args: any, kind: string?, pos: integer?): integer?
    assert(g.native ~= nil and (nativeOnly[op] or nativeArithmetic[op]), "unsupported native graph operation")
    local sig = assert(parsed[op], "unknown native graph operation")
    assert(operationArity(sig, args) and not sig.terminator, "invalid native operation arity")
    if sig.variadic then
        assert(type(args[1]) == "table", "native helper requires its checked declaration")
    end
    local hasResult = sig.result ~= "-" and not (sig.variadic and args[1].result == "nil")
    local result: integer? = nil
    if hasResult then
        assert(kind ~= nil and nativeClasses[kind], "native result requires an exact kind")
        result = graph.nativeValue(g, kind as string)
    else
        assert(kind == nil, "native effect has no result kind")
    end
    local at = #b.op + 1
    b.op[at], b.dst[at], b.args[at], b.pos[at], b.cert[at] = op, result or 0, args, pos or 0, 0

    return result
end

-- How many leading continuation parameters an invoke's results fill: one per
-- kept result, none for a discarded one.
local function resultOffset(t: any): integer
    if t.kind ~= "invoke" then
        return 0
    end
    if t.results then
        return #t.results
    end

    return t.result ~= nil and 1 or 0
end

-- A body's parameters as the core binds them: a method's implicit receiver
-- (attached by programgraph) first.
function graph.parameters(body: any): {any}
    local params = {}
    if body.coreSelfParam then
        params[1] = body.coreSelfParam
    end
    for _, parameter in ipairs(body.params or {}) do
        params[#params + 1] = parameter
    end

    return params
end

local function nativeContract(value: any, fields: any): nil
    assert(type(value) == "table", "native operation requires a contract")
    for name in pairs(value) do
        assert(fields[name], "unknown native contract field")
    end
end

local function nativeInteger(text: any, kind: string): nil
    assert(type(text) == "string", "native integer constant requires exact text")
    local negative = text:sub(1, 1) == "-"
    local digits = negative and text:sub(2) or text
    local base = 10
    if digits:sub(1, 2):lower() == "0x" then
        base, digits = 16, digits:sub(3)
        assert(digits:match("^%x+$"), "invalid native integer constant")
    else
        assert(digits:match("^%d+$"), "invalid native integer constant")
    end
    local limbs: {number} = {0, 0, 0, 0}
    for i = 1, #digits do
        local carry = tonumber(digits:sub(i, i), base) as number
        for j = 1, 4 do
            local value = limbs[j] * base + carry
            limbs[j], carry = value % 65536, math.floor(value / 65536)
        end
        assert(carry == 0, "native integer constant exceeds 64 bits")
    end
    if kind == "int32" or kind == "uint32" then
        assert(limbs[3] == 0 and limbs[4] == 0, "native constant exceeds 32 bits")
        if kind == "int32" then
            assert(
                limbs[2] < 32768 or negative and limbs[2] == 32768 and limbs[1] == 0,
                "native constant exceeds int32"
            )
        else
            assert(not negative, "native uint32 constant cannot be negative")
        end
    elseif kind == "int64" then
        assert(
            limbs[4] < 32768 or (negative and limbs[4] == 32768 and limbs[1] == 0 and limbs[2] == 0 and limbs[3] == 0),
            "native constant exceeds int64"
        )
    else
        assert(kind == "uint64" and not negative, "native constant requires an integer kind")
    end
end

local function checkedNativeKind(t: any): string
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            assert(checkedNativeKind(member) == "boolean", "checked native union kind")
        end
        return "boolean"
    end

    return t and t.tag or "missing"
end

-- A declaration is derived from its checked function owner, never a name list.
-- The machine sink also binds this source/signature to the retained target.
function graph.nativeLeafDeclaration(fn: any, context: any?, call: any?, caller: any?, serviceSignature: any?): any
    assert(type(fn) == "table" and fn.node and fn.body and fn.scope, "checked native leaf owner required")
    assert(
        fn.node.body == fn.body and fn.nativeABI ~= "handler" and fn.nativeABI ~= "support",
        "native leaf checked body identity"
    )
    assert(fn.scope.functions and fn.scope.functions[fn.name] == fn, "native leaf checked declaration identity")
    local params, body = {}, fn.body
    local pointer = physical.signature(fn, context, call, caller, serviceSignature)
    assert(
        #body.params == #fn.paramKinds and (#body.params >= 1 or serviceSignature ~= nil) and #body.params <= 8,
        "native leaf checked parameter count"
    )
    for index, parameter in ipairs(body.params) do
        local kind = pointer and pointer.params[index] and parameter.type.resolvedType.tag
            or checkedNativeKind(parameter.type and parameter.type.resolvedType)
        assert(kind == fn.paramKinds[index], "native leaf checked parameter kind")
        if pointer and pointer.params[index] then
            kind = pointer.params[index].machineKind
        end
        assert(nativeClasses[kind], "native leaf checked parameter kind")
        params[index] = kind
    end
    local signature = body.signatureType
    assert(
        signature
        and signature.retPack
        and not signature.retPack.tail
        and not signature.retPack.alternatives
        and #signature.rets <= 1
        and #signature.retPack.head == #signature.rets,
        "native leaf requires a closed checked result"
    )
    local result = pointer and pointer.result and signature.rets[1].tag
        or #signature.rets == 0 and "nil"
        or checkedNativeKind(signature.rets[1])
    assert(
        result == fn.resultKind
        and (
            result == "uint64"
            or result == "int64"
            or result == "boolean"
            or result == "nil"
            or result == "voidptr" and signature.rets[1].tag == "voidptr"
            or pointer and pointer.result
        ),
        "native leaf checked result kind"
    )

    local declaration = {
        moduleName = fn.scope.name,
        name = fn.name,
        params = params,
        result = pointer and pointer.result and pointer.result.machineKind or result,
        abi = "leaf",
        physical = pointer,
        source = {path = fn.scope.path, module = fn.scope.name, name = fn.name}
    }

    return serviceSignature and service.checked(serviceSignature, fn, declaration) or declaration
end

local function declarationSource(declaration: any): nil
    assert(
        type(declaration.moduleName) == "string" and declaration.moduleName:match("^[%a_][%w_%.]*$"),
        "native checked declaration module"
    )
    assert(
        type(declaration.name) == "string" and declaration.name:match("^[%a_][%w_]*$"),
        "native checked declaration name"
    )
    local source = declaration.source
    nativeContract(source, {path = true, module = true, name = true})
    assert(
        type(source.path) == "string"
        and #source.path > 0
        and source.module == declaration.moduleName
        and source.name == declaration.name,
        "native checked declaration source"
    )
end

local function verifyNativeOperation(g: any, op: string, args: any, dst: integer, constants: any): nil
    local kinds, kind = g.exactTypes, g.exactTypes[dst]
    local physicalValues = g.nativePhysical and g.nativePhysical.values
    if physicalValues then
        local sig = parsed[op]
        for index, value in ipairs(args) do
            if classes[operandClass(sig, index)] or operandClass(sig, index) == "a" then
                local descriptor = physicalValues[value]
                if descriptor
                    and (
                        descriptor.pointee ~= nil
                        or descriptor.nullable
                        or #descriptor.ownership ~= 0
                        or physical.localOrigin(descriptor) ~= nil
                    )
                then
                    assert(
                        index == 1
                        and (
                            op == "NativePointerView"
                            or op == "NativeFieldLoad"
                            or op == "NativeBorrowAddress"
                            or op == "NativeStore" and args[4].field ~= nil
                        )
                        or op == "NativeStore" and index == 3 and args[4].retention ~= nil
                        or op == "NativeBorrowPointer"
                        or op == "NativeICmp" and (args[3] == "==" or args[3] == "~=")
                        or op == "NativeLeafCall"
                        and index > 1
                        and (
                            args[1].physical ~= nil
                            or args[1].service and service.publicationArgument(g, args[1], index - 1, value)
                        )
                        or service.isTestGraph(g),
                        "typed pointer operation boundary is unsupported"
                    )
                end
            end
        end
        if physicalValues[dst] then
            assert(
                op == "NativePointer"
                or op == "PointerOffset"
                or op == "NativePointerView"
                or op == "NativeBorrowPointer"
                or op == "NativeFieldLoad"
                or op == "NativeLocal"
                or op == "NativeLeafCall" and args[1].physical ~= nil
                or op == "NativeHelperCall"
                and nativeos.isIssued(args[1])
                and nativeos.result(args[1]) == physicalValues[dst],
                "unsupported physical value origin"
            )
        end
    end
    if g.native.abi == "leaf" then
        assert(
            (op ~= "NativeHelperCall" or nativeos.isIssued(args[1]))
            and op ~= "ProgramLoad"
            and op ~= "FrameSlotRead"
            and op ~= "FrameSlotWrite"
            and op ~= "FrameVarargRead"
            and op ~= "FrameStatus"
            and op ~= "FrameRecover"
            and op ~= "FrameWindow",
            "native leaf cannot access VM state or invoke managed helpers"
        )
    end

    local function hasKind(value: integer, expected: string): nil
        assert(kinds[value] == expected, "native graph operand kind mismatch")
    end

    if op == "NativeLocal" then
        local contract = args[1]
        physical.validateLocal(contract)
        assert(
            g.source
            and g.source.path == contract.owner.scope.path
            and g.source.module == contract.owner.scope.name
            and g.source.name == contract.owner.name,
            "physical local checked source owner differs"
        )
        assert(
            g.native.abi == "leaf"
            and physicalValues
            and kind == "voidptr"
            and physicalValues[dst] == contract.descriptor
            and #args == #contract.params + 1,
            "physical local construction contract differs"
        )
        for index, parameter in ipairs(contract.params) do
            hasKind(args[index + 1], parameter)
            assert(not physicalValues[args[index + 1]], "local initializer cannot contain a pointer")
        end
    elseif op == "NativeLeafCall" then
        assert(g.native.abi == "leaf" or g.native.abi == "handler", "scalar leaf calls require a leaf or handler graph")
        local declaration = args[1]
        nativeContract(declaration, {
            moduleName = true,
            name = true,
            params = true,
            result = true,
            abi = true,
            source = true,
            physical = true,
            service = true
        })
        declarationSource(declaration)
        if declaration.service then
            service.callGraph(g, declaration, args)
        end
        assert(declaration.abi == "leaf", "native leaf declaration ABI")
        assert(
            type(declaration.params) == "table"
            and (#declaration.params >= 1 or declaration.service ~= nil)
            and #declaration.params <= 8
            and #args == #declaration.params + 1,
            "native leaf argument count"
        )
        for index, parameter in pairs(declaration.params) do
            assert(
                type(index) == "number"
                and index % 1 == 0
                and index >= 1
                and index <= #declaration.params
                and nativeClasses[parameter],
                "native leaf exact parameter kind"
            )
        end
        for index, parameter in ipairs(declaration.params) do
            hasKind(args[index + 1], parameter)
        end
        assert(
            declaration.result == "nil" and dst == 0 and kind == nil
            or (
                declaration.result == "uint64"
                or declaration.result == "int64"
                or declaration.result == "boolean"
                or declaration.result == "voidptr"
            )
            and kind == declaration.result,
            "native leaf result kind"
        )
        local pointer = declaration.physical
        if pointer then
            physical.validateSignature(pointer)
            assert(
                g.nativePhysical and pointer.context == g.nativePhysical.context,
                "pointer call target context differs"
            )
            assert(
                #pointer.params == (
                    declaration.service and service.sourceCount(declaration.service) or #declaration.params
                )
                and pointer.owner.scope.name == declaration.moduleName
                and pointer.owner.name == declaration.name
                and pointer.owner.scope.path == declaration.source.path,
                "pointer call source differs"
            )
            local arenaCleanup = declaration.service and service.arenaCleanup(g, declaration)
            local redirected = declaration.service and service.redirectedCall(g, declaration)
            if not arenaCleanup and not redirected then
                physical.validateCall(pointer, g.source)
            end
            for index, parameter in ipairs(pointer.params) do
                local actual = physicalValues[args[index + 1]]
                if actual and physical.localOrigin(actual) then
                    assert(
                        physical.validateLocalCall(pointer, index, actual),
                        "local pointer call lacks lifetime proof"
                    )
                end
                assert(
                    parameter == false or declaration.params[index] == parameter.machineKind,
                    "pointer call machine parameter differs"
                )
                assert(
                    parameter == false and (actual == nil or actual.pointee == nil)
                    or parameter
                    and actual
                    and (
                        arenaCleanup and index == 1 and service.arenaCleanup(g, declaration, actual)
                        or not arenaCleanup and physical.callArgumentPermission(pointer, index, actual)
                    )
                    or service.isTestGraph(g),
                    "pointer call argument descriptor differs"
                )
                if pointer.dependent == index then
                    assert(
                        actual and physical.callInput(pointer, index, actual, physical.fieldOrigin(actual))
                        or service.isTestGraph(g),
                        "dependent call argument root differs"
                    )
                end
            end
            local actual = physicalValues[dst]
            assert(
                pointer.result == nil or declaration.result == pointer.result.machineKind,
                "pointer call machine result differs"
            )
            assert(
                pointer.result == nil and actual == nil
                or pointer.result and actual and physical.callResult(pointer, actual),
                "pointer call result descriptor differs"
            )
        end
    elseif op == "NativeHelperCall" then
        local declaration = args[1]
        if nativeos.isIssued(declaration) then
            nativeos.graph(declaration, g, args, dst)
        end
        nativeContract(declaration, {
            moduleName = true,
            name = true,
            params = true,
            result = true,
            effects = true,
            normalReturn = true
        })
        assert(
            type(declaration.moduleName) == "string" and declaration.moduleName:match("^nupp%.runtime%.vm%.[%w_]+$"),
            "native helper requires its declared module"
        )
        assert(
            type(declaration.name) == "string" and declaration.name:match("^[%a_][%w_]*$"),
            "native helper requires its declared name"
        )
        assert(type(declaration.params) == "table" and #declaration.params == #args - 1, "native helper argument count")
        for index = 1, #declaration.params do
            local parameter = declaration.params[index]
            assert(nativeClasses[parameter], "native helper requires exact parameter kinds")
            hasKind(args[index + 1], parameter)
        end
        for index in pairs(declaration.params) do
            assert(
                type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #declaration.params,
                "native helper parameters must be dense"
            )
        end
        assert(
            declaration.result == "nil" and dst == 0
            or nativeClasses[declaration.result] and kind == declaration.result,
            "native helper result kind mismatch"
        )
        local normal = declaration.normalReturn
        if normal ~= nil then
            nativeContract(normal, {context = true, frame = true, outcomes = true, synchronized = true})
            assert(
                type(normal.context) == "number"
                and normal.context >= 1
                and normal.context % 1 == 0
                and declaration.params[normal.context] == "voidptr"
                and normal.frame == "caller"
                and normal.outcomes == "ready-error"
                and normal.synchronized == true,
                "invalid helper normal-return authority"
            )
        end
        local effects = declaration.effects
        nativeContract(effects, {mayCollect = true, mayPark = true, mayRaise = true, pure = true})
        assert(
            type(effects.mayCollect) == "boolean"
            and type(effects.mayPark) == "boolean"
            and type(effects.mayRaise) == "boolean"
            and type(effects.pure) == "boolean",
            "native helper requires declared effects"
        )
        assert(
            not effects.pure or not (effects.mayCollect or effects.mayPark or effects.mayRaise),
            "native pure helper cannot collect, park or raise"
        )
    elseif op == "NativeBorrowAddress" then
        hasKind(args[1], "voidptr")
        local contract = args[2]
        physical.validateCast(contract)
        physical.validateViewOwner(contract, g.source)
        assert(
            kind == "uint64"
            and physicalValues
            and physical.viewKind(contract) == "address"
            and physicalValues[args[1]] == contract.source
            and physicalValues[dst] == nil,
            "borrowed address source/result differs"
        )
    elseif op == "NativeBorrowPointer" then
        hasKind(args[1], "voidptr");
        hasKind(args[2], "voidptr")
        local contract = args[3]
        physical.validateCast(contract)
        physical.validateViewOwner(contract, g.source)
        assert(
            kind == "voidptr"
            and physicalValues
            and physical.viewKind(contract) == "borrow"
            and physicalValues[args[1]] == contract.source
            and physicalValues[dst] == contract.target
            and physicalValues[args[2]]
            and physical.borrowArgument(contract, physicalValues[args[2]]),
            "borrow pointer operands differ"
        )
    elseif op == "NativePointerView" then
        hasKind(args[1], "voidptr")
        assert(kind == "voidptr" and physicalValues, "physical pointer view requires sidecars")
        local contract = args[2]
        physical.validateCast(contract)
        physical.validateViewOwner(contract, g.source)
        assert(
            physical.viewKind(contract) ~= "borrow" and physical.viewKind(contract) ~= "address",
            "borrow/address view requires dedicated operation"
        )
        assert(
            physicalValues[args[1]] == contract.source and physicalValues[dst] == contract.target,
            "physical pointer view source/result identity differs"
        )
    elseif op == "NativeFieldLoad" then
        hasKind(args[1], "voidptr")
        assert(physicalValues, "physical field load requires sidecars")
        local access = args[2]
        physical.validateField(access)
        assert(physicalValues[args[1]] == access.receiver, "physical field receiver identity differs")
        assert(
            not access.borrowSignature or access.borrowSignature == g.nativePhysical.signature,
            "borrowed field signature owner differs"
        )
        assert(not access.write, "physical field load cannot write")
        if access.storage.machineKind == "voidptr" then
            physical.validateFieldOwner(access, g.source)
            assert(
                kind == "voidptr"
                and physicalValues[dst] == access.storage
                and access.width == 8
                and not access.signed
                and #access.storage.ownership == 0
                and physical.fieldOrigin(physicalValues[dst]) == access,
                "pointer field must retain its actual checked result type"
            )
        elseif access.valueType.tag == "boolean" then
            assert(kind == "boolean" and physical.booleanField(access), "physical Boolean field differs")
        else
            assert(
                kind == physical.integerField(access) and access.valueType.tag == kind,
                "physical field load changes projected result type"
            )
        end
    elseif op == "NativeLoad" or op == "NativeStore" then
        local write = op == "NativeStore"
        local contract = args[write and 4 or 3]
        nativeContract(contract, {
            source = true,
            kind = true,
            width = true,
            signed = true,
            write = true,
            field = true,
            retention = true
        })
        assert(contract.field or contract.retention == nil, "retention requires checked field")
        local source = g.native.abi == "leaf" and "borrowed" or "live"
        assert(
            contract.source == source and contract.write == write,
            "native memory requires " .. source .. " access semantics"
        )
        assert(type(contract.signed) == "boolean", "native memory requires explicit signedness")
        local width, memoryKind = contract.width, contract.kind
        assert(width == 1 or width == 2 or width == 4 or width == 8, "native memory width")
        if contract.field then
            local access = contract.field
            physical.validateFieldOwner(access, g.source)
            assert(
                not access.borrowSignature or access.borrowSignature == g.nativePhysical.signature,
                "borrowed store signature owner differs"
            )
            assert(
                write and access.write and physicalValues and physicalValues[args[1]] == access.receiver,
                "physical store receiver identity differs"
            )
            assert(width == access.width and contract.signed == access.signed, "physical store layout differs")
            assert(
                constants[args[2]] == tostring(access.offset) and kinds[args[2]] == "int64",
                "physical store offset differs from checked field"
            )
            if access.storage.machineKind == "voidptr" then
                assert(
                    memoryKind == "voidptr"
                    and contract.retention
                    and physical.storeValue(contract.retention, access, physicalValues[args[3]], g.source),
                    "pointer field store lacks exact checked retention"
                )
            elseif access.storage.machineKind == "boolean" then
                assert(
                    memoryKind == "boolean" and physical.booleanField(access) and not contract.retention,
                    "Boolean field store differs"
                )
            else
                physical.integerField(access)
                assert(
                    not contract.retention
                    and (
                        memoryKind == "int32"
                        or memoryKind == "uint32"
                        or memoryKind == "int64"
                        or memoryKind == "uint64"
                    ),
                    "physical store requires an exact integer RHS"
                )
            end
        elseif memoryKind == "float64" or memoryKind == "float32" then
            assert(width == (memoryKind == "float64" and 8 or 4) and not contract.signed, "native float memory width")
        elseif width == 8 then
            assert(
                memoryKind == "int64" or memoryKind == "uint64" or memoryKind == "voidptr",
                "native memory exact kind"
            )
            assert(contract.signed == (memoryKind == "int64"), "native memory signedness")
        elseif width == 4 then
            assert(memoryKind == "int64" and contract.signed, "native signed word memory")
        else
            assert(memoryKind == (write and "uint64" or "int64") and not contract.signed, "native narrow memory kind")
        end
        hasKind(args[1], "voidptr")
        hasKind(args[2], "int64")
        if write then
            hasKind(args[3], memoryKind)
            assert(dst == 0, "native store has no result")
        else
            assert(kind == memoryKind, "native load result kind")
        end
    elseif op == "NativeLayout" then
        assert(kind == "int64" and type(args[1]) == "string" and args[1]:match("^[%w_%.]+$"), "native ABI layout name")
    elseif op == "NativePointer" or op == "NativeAddress" then
        if physicalValues and physicalValues[dst] then
            local descriptor = physicalValues[dst]
            assert(
                op == "NativePointer"
                and descriptor.storageType.tag == "voidptr"
                and #descriptor.ownership == 0
                and not descriptor.nullable
                and not physical.dependent(descriptor),
                "generic pointer origin cannot establish a pointee"
            )
        end
        hasKind(args[1], op == "NativePointer" and "uint64" or "voidptr")
        assert(kind == (op == "NativePointer" and "voidptr" or "uint64"), "native pointer bit conversion kind")
    elseif op == "NativeConstant" then
        nativeInteger(args[1], kind)
    elseif op == "NativeBoolean" then
        assert(kind == "boolean" and type(args[1]) == "boolean", "native boolean constant required")
    elseif op == "NativeICmp" or op == "NativeFCmp" then
        assert(kind == "boolean", "native comparison result must be boolean")
        local operandKind = kinds[args[1]]
        hasKind(args[2], operandKind)
        if op == "NativeFCmp" then
            assert(nativeFloatKinds[operandKind], "native float comparison requires an exact float kind")
        else
            assert(
                operandKind == "int32"
                or operandKind == "uint32"
                or operandKind == "int64"
                or operandKind == "uint64"
                or operandKind == "voidptr"
                or operandKind == "boolean",
                "native integer comparison requires exact scalar operands"
            )
        end
        assert(
            args[3] == "=="
            or args[3] == "~="
            or args[3] == "<"
            or args[3] == "<="
            or args[3] == ">"
            or args[3] == ">=",
            "invalid native comparison predicate"
        )
    elseif op == "NativeAsWord" then
        hasKind(args[1], "boolean")
        assert(kind == "uint64", "native boolean conversion produces a word")
    elseif op == "NativeSelect" then
        hasKind(args[1], "boolean")
        assert(nativeClasses[kind], "native selection requires an exact result kind")
        hasKind(args[2], kind)
        hasKind(args[3], kind)
    elseif op == "NativeWordCast" then
        local source = kinds[args[1]]
        assert(
            (
                (source == "int64" or source == "uint64" or source == "voidptr")
                and (kind == "int64" or kind == "uint64" or kind == "voidptr")
            )
            or physicalValues and (source == "int32" or source == "uint32") and (kind == "int64" or kind == "uint64"),
            "native word cast requires exact word/pointer kinds"
        )
    elseif op == "NativeIntToFloat" then
        assert(
            kinds[args[1]] == "int64" or kinds[args[1]] == "uint64",
            "native integer conversion requires exact signedness"
        )
        assert(nativeFloatKinds[kind], "native integer conversion requires an exact float result")
    elseif op == "NativeFloatToInt" then
        assert(nativeFloatKinds[kinds[args[1]]], "native float conversion requires an exact source kind")
        assert(kind == "int64" or kind == "uint64", "native float conversion requires exact integer signedness")
    elseif op == "NativeFloatConvert" then
        assert(
            nativeFloatKinds[kinds[args[1]]] and nativeFloatKinds[kind],
            "native float conversion requires exact widths"
        )
    elseif op == "NativeFloatBits" or op == "NativeFloat32Bits" then
        hasKind(args[1], "float64")
        assert(kind == "uint64", "native float encoding produces a word")
    elseif op == "NativeFloatFromBits" or op == "NativeFloat32FromBits" then
        hasKind(args[1], "uint64")
        assert(kind == "float64", "native float decoding produces float64")
    elseif op == "NativeFloor" or op == "NativeCeil" or op == "NativeSqrt" then
        assert(nativeFloatKinds[kind], "native float operation requires an exact width")
        hasKind(args[1], kind)
    elseif op == "NativeRoundFloat32" then
        hasKind(args[1], "float64")
        assert(kind == "float64", "float32 rounding promotes its result to float64")
    elseif op == "ProgramLoad" then
        hasKind(args[1], "voidptr")
        hasKind(args[2], "int64")
        local contract = args[3]
        nativeContract(contract, {source = true, kind = true, lifetime = true, result = true, width = true})
        local widths = {uint8 = 1, int32 = 4, int64 = 8, uint64 = 8, float64 = 8}
        local result = contract.kind == "float64" and "float64" or (contract.kind == "uint64" and "uint64" or "int64")
        assert(
            contract.source == "code"
            and contract.lifetime == "body"
            and widths[contract.kind] ~= nil
            and contract.width == widths[contract.kind]
            and contract.result == result
            and kind == result,
            "invalid native program contract"
        )
    elseif op == "FrameStatus" or op == "FrameRecover" or op == "FrameWindow" then
        local context = g.native.abi == "handler" and 5 or 2
        assert(args[1] == context, "native frame context identity mismatch")
        hasKind(args[1], "voidptr")
        local access = args[op == "FrameWindow" and 3 or 2]
        nativeContract(access, {kind = true, class = true})
        local expected = op == "FrameStatus" and "status" or (op == "FrameRecover" and "recover" or "window")
        assert(
            access.kind == expected and kind == (op == "FrameStatus" and "int64" or "voidptr"),
            "invalid native frame contract"
        )
        if op == "FrameWindow" then
            hasKind(args[2], "voidptr")
            assert(
                access.class == "v" or access.class == "i" or access.class == "f",
                "invalid native frame window class"
            )
        else
            assert(access.class == nil, "native frame status/recovery has no window class")
        end
    elseif op == "FrameVarargRead" then
        hasKind(args[1], "voidptr")
        hasKind(args[2], "int64")
        local contract = args[3]
        nativeContract(contract, {class = true, kind = true, write = true, width = true})
        assert(
            contract.class == "vararg"
            and contract.kind == "uint64"
            and contract.write == false
            and contract.width == 8
            and kind == "uint64",
            "invalid native vararg contract"
        )
    elseif op == "FrameSlotRead" or op == "FrameSlotWrite" then
        hasKind(args[1], "voidptr")
        hasKind(args[2], "voidptr")
        hasKind(args[3], "int64")
        -- This profile preserves the entry frame and its matching logical window.
        local write = op == "FrameSlotWrite"
        local contract = args[write and 5 or 4]
        local windows = {v = 2, i = 3, f = 4}
        nativeContract(contract, {class = true, kind = true, write = true, width = true})
        assert(windows[contract.class] ~= nil, "native slot frame/window identity mismatch")
        assert(
            windows[contract.class] ~= nil
            and contract.width == 8
            and contract.write == write
            and (
                (contract.class == "f" and contract.kind == "float64")
                or (contract.class == "v" and contract.kind == "uint64")
                or (contract.class == "i" and (contract.kind == "int64" or contract.kind == "uint64"))
            ),
            "invalid native slot contract"
        )
        if write then
            hasKind(args[4], contract.kind)
        else
            assert(kind == contract.kind, "native slot result kind mismatch")
        end
    elseif op == "PointerOffset" then
        if physicalValues and physicalValues[dst] and not service.arenaOffsetOrigin(g, args, dst) then
            -- Raw offset preserves only the unchecked machine pointer. It
            -- cannot establish a pointee, dependency or local-storage origin.
            for _, value in ipairs({args[1], dst}) do
                local descriptor = physicalValues[value]
                assert(
                    not descriptor
                    or descriptor.storageType.tag == "voidptr"
                    and #descriptor.ownership == 0
                    and not descriptor.nullable
                    and not physical.dependent(descriptor)
                    and not physical.localOrigin(descriptor),
                    "raw pointer offset cannot establish a typed or owned origin"
                )
            end
        end
        hasKind(args[1], "voidptr")
        hasKind(args[2], "int64")
        assert(kind == "voidptr", "native pointer offset result kind")
    elseif op == "NativeUDiv" or op == "NativeURem" then
        assert(kind == "uint64" and #args == 2, "native division requires two unsigned words")
        hasKind(args[1], "uint64")
        hasKind(args[2], "uint64")
    elseif op == "NativeSDiv" or op == "NativeSRem" then
        assert(kind == "int64" and #args == 2, "native signed division requires two signed words")
        hasKind(args[1], "int64")
        hasKind(args[2], "int64")
    elseif nativeArithmetic[op] then
        assert(
            op:sub(1, 1) == "F" and nativeFloatKinds[kind]
            or (op:sub(1, 1) == "I" or op == "NativeIMul") and (kind == "int64" or kind == "uint64")
            or (op == "IAnd" or op == "IOr") and kind == "boolean",
            "native arithmetic result kind"
        )
        for _, value in ipairs(args) do
            hasKind(value, kind)
        end
    else
        error("unsupported native graph operation", 0)
    end
end

-- Invoke contracts retain checked source identities as expected ABI evidence.
-- They do not authenticate a callee SSA value's runtime FunctionInfo or owner.
local function dense(values: any): nil
    assert(type(values) == "table", "invoke requires a dense array")
    local count = 0
    for index in pairs(values) do
        assert(
            type(index) == "number" and index >= 1 and index % 1 == 0 and index <= #values,
            "invoke requires a dense array"
        )
        count = count + 1
    end
    assert(count == #values, "invoke requires a dense array")
end

-- Whether a call giving `given` arguments leaves off only parameters that
-- admit nil, which Lua then passes: `f()` of `f(size: integer?)`.
function graph.omits(called: any, given: integer): boolean
    if given >= #called.params then
        return false
    end
    for index = given + 1, #called.params do
        local t = called.params[index]
        while t and (t.tag == "const" or t.tag == "literal") do
            t = t.tag == "literal" and t.base or t.inner
        end
        if not (t and (t.tag == "nil" or t.tag == "any" or t.tag == "unknown" or t.tag == "union" and t.hasNil)) then
            return false
        end
    end

    return true
end

-- The fixed-width number types, which pass as values.
local fixedwidths: {
    [string]: boolean
} = {int8 = true, int16 = true, int32 = true, uint8 = true, uint16 = true, uint32 = true, uint64 = true, float32 = true}

-- The call whose contract is being checked, and the module it is in, for
-- a refusal to name.
local checkingcall: any = nil
local checkingpath: string? = nil

function graph.checking(path: string?): nil
    checkingpath = path
end

local function checkingat(): string
    local node = checkingcall
    while type(node) == "table" and node.kind ~= nil and node.line == nil do
        node = node.obj or node[1]
    end
    local token = type(node) == "table" and (node.token or node.name or node) or nil
    if type(token) ~= "table" or token.line == nil then
        return ""
    end

    return " in the call at " .. tostring(checkingpath) .. ":" .. tostring(token.line)
end

local invokeScalar: function(any): nil

-- The signature a call to `owner` is checked through. A generic function
-- calling itself is typed `any` inside its own body; the call names that
-- function by definition, so its declared signature is the call's.
local function callsignatureof(owner: any, call: any): any
    local called = call.calleeType or call.signatureType
    if type(called) == "table" and called.tag == "any" and owner.signature and owner.signature.typeParams then
        return owner.signature
    end

    return called
end

-- The reference types a value of which passes tagged, however instantiated.
local referenceTags: {
    [string]: boolean
} = {
    nominal = true,
    typevar = true,
    array = true,
    map = true,
    table = true,
    shape = true,
    func = true,
    userdata = true,
    intersection = true,
    typeobject = true,
    any = true,
    unknown = true,
}

-- Whether a generic callee's declared parameter and the call's instantiated
-- one pass the same way: a type parameter takes whatever it is instantiated
-- to, and two reference types are both a tagged value.
local sameValue: function(any, any): boolean
sameValue = function(declared: any, instantiated: any): boolean
    local function bare(t: any): any
        while t and (t.tag == "affine" or t.tag == "borrowed" or t.tag == "pinned" or t.tag == "const") do
            t = t.inner
        end
        return t
    end

    declared, instantiated = bare(declared), bare(instantiated)
    if declared == nil or instantiated == nil then
        return false
    elseif declared == instantiated then
        return true
    end
    -- A union passes as each of its members does, member for member.
    if declared.tag == "union" and instantiated.tag == "union" then
        if #declared.members ~= #instantiated.members then
            return false
        end
        for index, member in ipairs(declared.members) do
            if not sameValue(member, instantiated.members[index]) then
                return false
            end
        end
        return true
    end

    return declared.tag == "typevar" or referenceTags[declared.tag] == true and referenceTags[instantiated.tag] == true
end
invokeScalar = function(t: any): nil
    -- An owned value passes as the value it owns; its cleanup is the
    -- graph's, not the call's.
    while t
        and (t.tag == "literal" or t.tag == "const" or t.tag == "affine" or t.tag == "borrowed" or t.tag == "pinned") do
        t = t.tag == "literal" and t.base or t.inner
    end
    -- A union of admitted types (integer | number, say) passes as a value.
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            invokeScalar(member)
        end
        return
    end
    assert(
        t
        and (t.tag == "int64" or t.tag == "number" or t.tag == "float64" or t.tag == "boolean" or t.tag == "string" or t.tag == "nil"
        -- Tables and functions pass as values; core graph contracts admit
        -- them from profile v8.
        or t.tag == "array"
        or t.tag == "map"
        or t.tag == "table"
        or t.tag == "shape"
        or t.tag == "func"
        or t.tag == "userdata"
        -- Fixed-width numbers are integers and floats at run time.
        or fixedwidths[t.tag] == true
        -- Storage and views of it are values on the core's heap.
        or t.tag == "carray" or t.tag == "ptr" or t.tag == "ctype" or t.tag == "intersection" or t.tag == "typeobject"
        -- A metatable (what `setmetatable` answers its table as) is a table.
        or t.tag == "metatable" or t.tag == "nominal" and t.declKind == "interface"
        -- A function that never returns gives no value to check.
        or t.tag == "never"
        -- A plain type parameter erases to a value, as does a type a
        -- generic computes (a const parameter's `N`), and a record is a table.
        or t.tag == "typevar" or t.tag == "neutral" or t.tag == "nominal" and t.declKind == "record"
        -- `any` and `unknown` are values checked where they are used.
        or t.tag == "any" or t.tag == "unknown"),
        "invoke requires a checked scalar type, got " .. tostring(t and t.tag) .. checkingat()
    )
end

-- `resultsIgnored`: a constructor's results, which its construction drops, may
-- be open.
local function invokeSignature(signature: any, resultsIgnored: boolean?): nil
    assert(
        type(signature) == "table" and signature.tag == "func",
        "invoke requires a checked function signature, got " .. tostring(
            type(signature) == "table" and signature.tag or signature
        ) .. checkingat()
    )
    -- What a coroutine body yields and resumes with (`yieldPack`,
    -- `resumePack`) is a static protocol; at run time the values pass as
    -- packs, which the core does not check against it.
    -- A function that never returns (`noreturn`) is called as any is: its
    -- error unwinds past the call.
    assert(
        not signature.foreign and not signature.comptimeOnly,
        "invoke of a foreign or compile-time signature is outside the guest subset"
    )
    -- A typed `...` is a homogeneous tail; its values pass in a pack. A
    -- generic one (`...: A...`) erases to values, as plain generics do, and
    -- so does one a type computes (`...: unpackof F(T)`, string.format's).
    local tail = signature.paramPack and signature.paramPack.tail
    if signature.vararg then
        assert(
            tail
            and (
                tail.kind == "homogeneous"
                or tail.kind == "generic"
                or tail.kind == "unknown"
                or tail.kind == "computed"
            )
            -- A borrowed `...` stays its caller's: a static fact.
            and (tail.mode == nil or tail.mode == "borrows") and not signature.paramPack.alternatives,
            "invoke signature is outside the scalar guest subset"
        )
        if tail.kind == "homogeneous" then
            invokeScalar(tail.type)
        end
    end
    -- Plain type parameters and packs erase: their values pass as dynamic
    -- values, as const parameters do: they are types the body cannot read.
    -- What a result preserves of, borrows from or partitions out of its
    -- parameters is a static ownership fact the collected guest heap has no
    -- use for.
    -- A borrowed result is what its source keeps alive, a static fact: at
    -- run time it is a value, which the collector keeps alive itself.
    -- Open results (`R...`) are as many as the caller keeps.
    for _, pack in ipairs(resultsIgnored and {signature.paramPack} or {signature.paramPack, signature.retPack}) do
        assert(
            type(pack) == "table"
            and (not pack.tail or pack == signature.paramPack and signature.vararg or pack == signature.retPack)
            and not pack.alternatives,
            "invoke requires closed parameter and result packs"
        )
        dense(pack.head)
        dense(pack.modes)
        assert(#pack.modes == #pack.head, "invoke pack modes differ")
        for index, t in ipairs(pack.head) do
            -- A scoped callback cannot escape, and a borrowed argument stays
            -- its caller's; at run time each passes as a value.
            assert(
                pack.modes[index] == "plain"
                or pack.modes[index] == "scoped" and t and t.tag == "func"
                or (pack.modes[index] == "borrows" or pack.modes[index] == "takes" or pack.modes[index] == "exclusive")
                and pack == signature.paramPack,
                "invoke ownership mode is unsupported: " .. tostring(pack.modes[index])
            )
            invokeScalar(t)
        end
    end
    dense(signature.params)
    assert(#signature.paramPack.head == #signature.params, "invoke parameter pack arity differs")
    if not resultsIgnored then
        dense(signature.rets)
        -- None is a function that returns nothing: a caller keeping one
        -- reads nil, and one taking them all takes none. An unannotated
        -- function's are open, any number of values.
        local open = signature.retPack.tail ~= nil and #signature.retPack.head == 0
        assert(
            (#signature.retPack.head == #signature.rets or open) and #signature.rets <= 16,
            "invoke requires at most sixteen checked scalar results"
        )
        if not open then
            for index, t in ipairs(signature.rets) do
                assert(signature.retPack.head[index] == t, "invoke result pack identity differs")
            end
        end
    end
    for index, t in ipairs(signature.params) do
        assert(signature.paramPack.head[index] == t, "invoke parameter pack identity differs")
    end
end

-- The signatures calls through `any` values are checked against, one per
-- call so a contract's identity check finds it.
local anySignatures: {[any]: any} = setmetatable({}, {__mode = "k"})
-- A dynamic method call's signature: the receiver and its arguments in, as
-- many values out as it keeps, all `any`.
local methodsignatures: {[any]: any} = setmetatable({}, {__mode = "k"})

local function invokeContract(contract: any): nil
    checkingcall = contract.call
    if contract.dynamic then
        nativeContract(contract, {
            dynamic = true,
            method = true,
            call = true,
            callSignature = true,
            effects = true,
            protected = true,
            handled = true,
            callback = true,
            given = true,
            spread = true,
            iterator = true
        })
        local call, called = contract.call, contract.callSignature
        -- A method the program has no body for, `b:put(x)` on a declared
        -- type: read from the receiver and called with it first.
        if contract.method then
            assert(
                type(call) == "table"
                and call.kind == "methodCall"
                and methodsignatures[call] == called
                and not call.scalarIntrinsic
                and not call.ownershipIntrinsic
                and not call.runtimeLoader,
                "dynamic method identity differs"
            )
            invokeSignature(called)
            assert(call.args and call.args.kind == "args", "invoke requires explicit positional arguments")
            dense(call.args.exprs)
            local spreads = #call.args.exprs > 0 and call.args.exprs[#call.args.exprs].kind == "vararg"
            assert(
                #call.args.exprs + 1 == #called.params + (spreads and 1 or 0) and (called.vararg == true) == spreads,
                "dynamic method arity differs"
            )
            for index, argument in ipairs(call.args.exprs) do
                if not (spreads and index == #call.args.exprs) then
                    invokeScalar(argument.inferredType)
                end
            end
            assert(
                contract.effects.mayCollect == true
                and contract.effects.mayRaise == true
                and contract.effects.mayPark == false
                and contract.effects.pure == false,
                "invoke requires conservative scalar guest effects"
            )
            return
        end
        -- A generic `for` calling its iterator: the state and the control
        -- in, as many values out as it names, checked as a call through
        -- `any` is.
        if contract.iterator then
            assert(
                type(call) == "table"
                and call.kind == "forinStmt"
                and graph.genericiterator(call)
                and anySignatures[call] == called
                and contract.given == 2,
                "iterator invoke identity differs"
            )
            invokeSignature(called)
            assert(
                contract.effects.mayCollect == true
                and contract.effects.mayRaise == true
                and contract.effects.mayPark == false
                and contract.effects.pure == false,
                "invoke requires conservative scalar guest effects"
            )
            return
        end
        -- A library call's callback: the argument it calls, with the values
        -- the library supplies.
        local callback = contract.callback
        local argument = callback and call.args and call.args.exprs[callback]
        -- pcall(f, ...): the callee is the first argument, and the rest are its
        -- arguments.
        local protected = contract.protected == true
        -- xpcall's second argument is its message handler.
        local offset = protected and (contract.handled == true and 2 or 1) or 0
        assert(
            type(call) == "table"
            and (call.kind == "call" or callback and call.kind == "methodCall")
            and (
                protected
                and call.args
                and call.args.exprs[1]
                and (call.args.exprs[1].inferredType == called or anySignatures[call] == called)
                or callback and argument and argument.inferredType == called
                or not protected and not callback and (call.calleeType == called or anySignatures[call] == called)
            )
            and not call.scalarIntrinsic
            and not call.ownershipIntrinsic
            and not call.runtimeLoader,
            "dynamic invoke call identity differs"
        )
        invokeSignature(called)
        assert(call.args and call.args.kind == "args", "invoke requires explicit positional arguments")
        dense(call.args.exprs)
        local given = #call.args.exprs - offset
        if callback then
            assert(
                contract.spread == true and contract.given == 0
                or type(contract.given) == "number"
                and contract.given % 1 == 0
                and (contract.given == #called.params or called.vararg and contract.given > #called.params),
                "callback arity differs"
            )
            assert(
                contract.effects.mayCollect == true
                and contract.effects.mayRaise == true
                and contract.effects.mayPark == false
                and contract.effects.pure == false,
                "invoke requires conservative scalar guest effects"
            )
            return
        end
        assert(
            given == #called.params
            or called.vararg and given > #called.params
            or given > 0 and graph.spreadsLast(call)
            or graph.omits(called, given),
            "invoke checked call arity differs"
        )
        for index, argument in ipairs(call.args.exprs) do
            if index > offset and argument.kind ~= "vararg" then
                invokeScalar(argument.inferredType)
            end
        end
        assert(
            contract.effects.mayCollect == true
            and contract.effects.mayRaise == true
            and contract.effects.mayPark == false
            and contract.effects.pure == false,
            "invoke requires conservative scalar guest effects"
        )
        return
    end
    nativeContract(contract, {
        owner = true,
        body = true,
        definition = true,
        signature = true,
        call = true,
        callSignature = true,
        summary = true,
        effects = true,
        construct = true
    })
    local owner, call = contract.owner, contract.call
    assert(
        type(owner) == "table"
        and owner.kind == "function"
        and owner.node
        and owner.scope
        and owner.node.body == contract.body
        and owner.body == contract.body
        and owner.signature == contract.signature
        and owner.body.signatureType == contract.signature,
        "invoke checked body identity differs"
    )
    -- A coroutine's yield switches threads on the core (`threads`), so a
    -- body that yields is called as any is; an external effect is refused.
    local summary = contract.summary
    assert(
        type(summary) == "table" and owner.body.effectSummary == summary and summary.external == false,
        "invoke requires a proven body summary"
    )
    local definition = contract.definition
    assert(
        type(definition) == "table"
        and owner.definition == definition
        and definition.token
        and definition.token.definition == definition
        and not definition.reassigned
        and not definition.runtimeLoader
        and not definition.scalarIntrinsic,
        "invoke checked declaration identity differs"
    )
    -- A method call names its method by definition and passes its receiver
    -- first.
    local method = type(call) == "table" and call.kind == "methodCall"
    -- A construction calls its constructor, named by its synthetic definition,
    -- with the instance first, through the constructor's signature.
    local construct = contract.construct == true
    assert(
        type(call) == "table"
        and (
            construct
            and call.kind == "call"
            and call.constructorEntry
            and call.constructorEntry.declaration == owner.node
            and owner.node.coreDefinition == definition
            and call.signatureType == contract.callSignature
            or not construct
            and (
                call.kind == "call" and call.obj and call.obj.kind == "name" and call.obj.token.definition == definition
                or method and call.name and call.name.definition == definition
            )
            and callsignatureof(owner, call) == contract.callSignature
        )
        and not call.cdefCall
        and not call.scalarIntrinsic
        and not call.ownershipIntrinsic
        and not call.affineClosureCall
        and not call.runtimeLoader,
        "invoke checked call identity differs" .. checkingat()
    )
    invokeSignature(contract.signature, construct)
    invokeSignature(contract.callSignature)
    local signature, called = contract.signature, contract.callSignature
    -- A construction answers its instance whatever the constructor returns.
    assert(
        #signature.params == #called.params
        and (construct or signature.rets[1] == called.rets[1] or sameValue(signature.rets[1], called.rets[1])),
        "invoke checked call signature differs: "
        .. #signature.params
        .. " and "
        .. #called.params
        .. " parameters, results "
        .. tostring(
            signature.rets[1] and signature.rets[1].tag
        ) .. " and " .. tostring(called.rets[1] and called.rets[1].tag) .. checkingat()
    )
    for index, t in ipairs(signature.params) do
        assert(
            t == called.params[index] or sameValue(t, called.params[index]),
            "invoke checked parameter identity differs: " .. tostring(
                t and t.tag
            ) .. " and " .. tostring(called.params[index] and called.params[index].tag) .. checkingat()
        )
    end
    assert(call.args and call.args.kind == "args", "invoke requires explicit positional arguments")
    dense(call.args.exprs)
    -- A method's function type leaves out its receiver, on both sides.
    assert(
        #call.args.exprs == #called.params
        or called.vararg and #call.args.exprs > #called.params
        or #call.args.exprs > 0 and graph.spreadsLast(call)
        or graph.omits(called, #call.args.exprs),
        "invoke checked call arity differs"
    )
    for index, argument in ipairs(call.args.exprs) do
        -- A `...` last spreads its pack; its values are checked by the callee.
        local spread = argument.kind == "vararg" and index == #call.args.exprs
        if not spread then
            invokeScalar(argument.inferredType)
        end
        assert(
            (argument.kind ~= "vararg" or spread) and argument.kind ~= "namedArg" and argument.kind ~= "pluckArg",
            "invoke argument expansion is unsupported"
        )
    end
    nativeContract(contract.effects, {mayCollect = true, mayRaise = true, mayPark = true, pure = true})
    assert(
        contract.effects.mayCollect == true
        and contract.effects.mayRaise == true
        and contract.effects.mayPark == false
        and contract.effects.pure == false,
        "invoke requires conservative scalar guest effects"
    )
end

-- A call through a function value: no known callee, the call's checked
-- function type and the same conservative effects. The callee is resolved,
-- and its signature checked, when the call runs. Core functions never
-- suspend, so the value's unknown body cannot either.
-- The library function a call names, when the final core implements it as
-- an operation: `math.floor` on the prelude's `math`. Otherwise nil.
local coreLibrary: {[string]: boolean} = {
    ["math.floor"] = true,
    ["math.f32.narrow"] = true,
    ["storagecalls.allocate"] = true,
    ["storagecalls.allocbytes"] = true,
    ["storagecalls.view"] = true,
    ["storagecalls.cast"] = true,
    ["storagecalls.copy"] = true,
    ["storagecalls.fill"] = true,
    ["storagecalls.text"] = true,
    ["storagecalls.fromstring"] = true,
    ["storagecalls.elements"] = true,
    ["storagecalls.elementkind"] = true,
    ["math.u32.wrap"] = true,
    ["math.i32.wrap"] = true,
    assert = true,
    rawequal = true,
    next = true,
    tostring = true,
    tonumber = true,
    select = true,
    ["os.getenv"] = true,
    ["os.monotonic"] = true,
    collectgarbage = true,
    ["hostcalls.arguments"] = true,
    ["hostcalls.setcleanup"] = true,
    ["filecalls.open"] = true,
    ["filecalls.read"] = true,
    ["filecalls.write"] = true,
    ["filecalls.seek"] = true,
    ["filecalls.close"] = true,
    ["filecalls.reason"] = true,
    pcall = true,
    xpcall = true,
    error = true,
    setmetatable = true,
    getmetatable = true,
    type = true,
    ["math.abs"] = true,
    ["math.ceil"] = true,
    ["math.max"] = true,
    ["math.min"] = true,
    ["math.tointeger"] = true,
    ["math.type"] = true,
    ["math.sqrt"] = true,
    ["math.exp"] = true,
    ["math.log"] = true,
    ["math.sin"] = true,
    ["math.cos"] = true,
    ["math.tan"] = true,
    ["math.asin"] = true,
    ["math.acos"] = true,
    ["math.atan"] = true,
    ["math.fmod"] = true,
    ["math.random"] = true,
    ["math.randomseed"] = true,
    rawget = true,
    rawset = true,
    ["table.concat"] = true,
    ["table.insert"] = true,
    ["table.remove"] = true,
    ["table.unpack"] = true,
    ["table.sort"] = true,
    ["table.move"] = true,
    ["table.freeze"] = true,
    ["table.isfrozen"] = true,
    ["string.reverse"] = true,
    print = true,
    ["string.format"] = true,
    ["string.gmatch"] = true,
    ["string.sub"] = true,
    ["string.byte"] = true,
    ["string.char"] = true,
    ["string.rep"] = true,
    ["string.upper"] = true,
    ["string.lower"] = true,
    ["string.len"] = true,
    ["string.find"] = true,
    ["string.match"] = true,
    ["string.gsub"] = true,
    ["coroutine.create"] = true,
    ["coroutine.resume"] = true,
    ["coroutine.yield"] = true,
    ["coroutine.status"] = true,
    ["coroutine.wrap"] = true,
    ["coroutine.running"] = true,
    ["coroutine.isyieldable"] = true,
    ["coroutine.close"] = true,
    -- `require` of a computed name, or through `_G`.
    ["require.dynamic"] = true
}

-- The reactor's calls are core library calls too.
for name in pairs(reactorcalls.operations) do
    coreLibrary[name] = true
end

local function preludeName(node: any): boolean
    local definition = node and node.kind == "name" and node.token and node.token.definition
    return type(definition) == "table" and definition.filename == "nupp:lua.d.nupp"
end

-- The library functions `nupp.runtime.libraryvalues` carries, which a name
-- of one taken as a value (not called) reads.
local libraryValues: {
    [string]: boolean
} = {
    _G = true,
    _VERSION = true,
    math = true,
    string = true,
    table = true,
    next = true,
    pairs = true,
    select = true,
    ["string.char"] = true,
    ["string.find"] = true,
    ["string.match"] = true,
    ["string.sub"] = true,
    ["string.rep"] = true,
    ["string.format"] = true,
    ["string.gsub"] = true,
    ["table.concat"] = true,
    ["table.insert"] = true,
    ["math.type"] = true,
    ["math.max"] = true,
    ["math.min"] = true,
    ["math.tointeger"] = true,
    package = true,
    require = true,
    tostring = true,
    tonumber = true,
    type = true,
    error = true,
    rawget = true,
    rawset = true,
    setmetatable = true,
    getmetatable = true,
    ["math.floor"] = true,
    ["math.ceil"] = true,
    ["math.abs"] = true,
    ["math.sqrt"] = true,
    ["string.upper"] = true,
    ["string.lower"] = true,
    ["string.len"] = true,
    ["string.reverse"] = true,
    ["string.byte"] = true,
    ["os.getenv"] = true,
    debug = true,
    io = true,
    os = true
}

-- The library name `node` reads when it names a library function, `tostring`
-- or `string.upper`, outside the callee of a call the core makes itself.
function graph.libraryValue(node: any): string?
    local name: string? = nil
    if node and node.kind == "name" and preludeName(node) then
        name = node.token.text
    elseif node and node.kind == "dotIndex" and node.name and preludeName(node.obj) then
        name = node.obj.token.text .. "." .. node.name.text
    end

    return name and libraryValues[name] and name or nil
end

-- The module whose `functions` carries library value `name`: Lua's `io` and
-- `os`, the libraries themselves, are `nupp.runtime.luaio` and
-- `nupp.runtime.luaos`; the others are `nupp.runtime.libraryvalues`.
function graph.libraryModule(name: string): string
    if name == "io" then
        return "nupp.runtime.luaio"
    elseif name == "os" then
        return "nupp.runtime.luaos"
    end

    return "nupp.runtime.libraryvalues"
end

-- Whether an unchecked tree may read Lua's `io`: a name spelled `io`
-- anywhere, `io.open(...)` and `io.cli` alike. A builder reads it to carry
-- `nupp.runtime.luaio`; carrying it needlessly costs nothing.
function graph.mayUseIo(root: any): boolean
    local found = false
    local walk: function(any): nil
    walk = function(node: any): nil
        if found or type(node) ~= "table" then
            return
        end
        if node.kind == "name" and node.token and node.token.text == "io" then
            found = true
            return
        end
        for _, child in ipairs(node) do
            walk(child)
        end
    end
    walk(root)

    return found
end

-- Whether an unchecked tree may take a library function as a value: a name
-- or field spelled as one, outside a call's callee. A builder reads it to
-- carry `nupp.runtime.libraryvalues`; carrying it needlessly costs nothing.
function graph.mayTakeLibraryValue(root: any): boolean
    local found = false
    local walk: function(any, boolean): nil
    walk = function(node: any, callee: boolean): nil
        if found or type(node) ~= "table" then
            return
        end
        if not callee then
            if node.kind == "name" and node.token and libraryValues[node.token.text] then
                found = true
                return
            end
            if node.kind == "dotIndex"
                and node.name
                and node.obj
                and node.obj.kind == "name"
                and node.obj.token
                and libraryValues[node.obj.token.text .. "." .. node.name.text]
            then
                found = true
                return
            end
        end
        -- `math.floor` reads a field of the library, not the library table.
        if node.kind == "dotIndex" and node.obj and node.obj.kind == "name" then
            return
        end
        for _, child in ipairs(node) do
            walk(child, (node.kind == "call" or node.kind == "methodCall") and child == node.obj)
        end
    end
    walk(root, false)

    return found
end

-- The declaration modules whose functions the core implements as library
-- calls: a call of one is that call, and requiring the module loads
-- nothing.
local corecallmodules: {
    [string]: string
} = {
    ["nupp.runtime.storagecalls"] = "storagecalls",
    ["nupp.runtime.hostcalls"] = "hostcalls",
    ["nupp.runtime.filecalls"] = "filecalls"
}
for name, short in pairs(reactorcalls.modules) do
    corecallmodules[name] = short
end

function graph.corecallmodule(name: string?): boolean
    return name ~= nil and corecallmodules[name] ~= nil
end

-- Whether a statement is a comptime helper the checker ran while compiling,
-- or the `@comptime` pragma before one: the program never sees it, as the
-- VM's lowering leaves it out.
function graph.erased(node: any): boolean
    local kind = node.kind
    if kind == "pragmaStmt" and node.name and node.name.text == "comptime" and node.stat then
        local target = node.stat
        while target.kind == "exportStmt" and target.stat do
            target = target.stat
        end
        return graph.erased(target)
    end

    return (kind == "localStmt" or kind == "localFuncStmt" or kind == "funcStmt")
        and (node.comptimeFunction ~= nil or node.comptimeTok ~= nil)
end

-- The image module the core answers a host module's `require` with: the
-- portable FIFO buffer for `string.buffer`, until the heap's byte objects
-- carry one, the portable BitOp library for `bit`, and storage on the guest
-- heap for the VM's FFI storage. Any other name is its own.
local coremodules: {
    [string]: string
} = {
    ["string.buffer"] = "nupp.runtime.provider.tablebuffer",
    bit = "nupp.runtime.provider.scalarbitops",
    ["nupp.vm.storagebinding"] = "nupp.runtime.provider.heapstorage"
}

function graph.coremodule(name: string): string
    return coremodules[name] or name
end

-- A `require` whose module the checker could not name: of a computed name,
-- or of any name through `_G`. The core looks it up among the image's.
function graph.dynamicRequire(call: any): boolean
    local obj = call and call.kind == "call" and call.obj
    if not obj or call.typeOnlyRequire then
        return false
    end
    if call.runtimeLoader == "require" then
        return call.requiredModule == nil
    end

    return obj.kind == "dotIndex"
        and obj.name ~= nil
        and obj.name.text == "require"
        and preludeName(obj.obj)
        and obj.obj.token.text == "_G"
end

local function stringType(t: any): boolean
    while t and (t.tag == "const" or t.tag == "literal") do
        t = t.tag == "const" and t.inner or t.base
    end
    return t ~= nil and t.tag == "string"
end

-- The library constants the core folds: `math.huge` and its kin, by name.
local coreConstants: {
    [string]: boolean
} = {["math.huge"] = true, ["math.pi"] = true, ["math.maxinteger"] = true, ["math.mininteger"] = true}

--- The library constant a field read names (`math.pi`), or nil.
function graph.coreLibraryField(node: any): string?
    if node and node.kind == "dotIndex" and node.name and preludeName(node.obj) then
        local name = node.obj.token.text .. "." .. node.name.text
        return coreConstants[name] and name or nil
    end

    return nil
end

function graph.coreLibraryCall(call: any): string?
    if graph.dynamicRequire(call) then
        return "require.dynamic"
    end
    local name
    if call and call.kind == "methodCall" and call.name and stringType(call.obj and call.obj.inferredType) then
        name = "string." .. call.name.text
    elseif call and call.kind == "call" and preludeName(call.obj) then
        name = call.obj.token.text
    elseif call
        and call.kind == "call"
        and call.obj
        and call.obj.kind == "dotIndex"
        and call.obj.name
        and preludeName(call.obj.obj)
    then
        name = call.obj.obj.token.text .. "." .. call.obj.name.text
    elseif call
        and call.kind == "call"
        and call.obj
        and call.obj.kind == "dotIndex"
        and call.obj.name
        and call.obj.obj
        and call.obj.obj.kind == "dotIndex"
        and call.obj.obj.name
        and preludeName(call.obj.obj.obj)
    then
        -- A library's nested table: `math.f32.narrow`.
        name = call.obj.obj.obj.token.text .. "." .. call.obj.obj.name.text .. "." .. call.obj.name.text
    elseif call
        and call.kind == "call"
        and call.obj
        and call.obj.kind == "dotIndex"
        and call.obj.name
        and call.obj.obj
        and call.obj.obj.kind == "name"
        and call.obj.obj.token
        and call.obj.obj.token.definition
        and corecallmodules[call.obj.obj.token.definition.requiredModule or ""] ~= nil
    then
        -- A core call module's function: `calls.allocbytes(n)`.
        name = tostring(corecallmodules[call.obj.obj.token.definition.requiredModule]) .. "." .. call.obj.name.text
    elseif call and call.kind == "call" and call.obj and call.obj.namespacePath == "math.random" then
        -- `math.random` is also a standard module path, which the checker
        -- resolves as one: its root is then not the prelude's name.
        name = "math.random"
    end
    -- The prelude's `unpack` is `table.unpack`.
    if name == "unpack" then
        name = "table.unpack"
    end

    return name and coreLibrary[name] and name or nil
end

-- The library calls with several results, which answer them as a pack.
local packedlibrary: {
    [string]: boolean
} = {
    ["string.find"] = true,
    ["string.match"] = true,
    ["string.byte"] = true,
    ["string.gsub"] = true,
    ["table.unpack"] = true,
    next = true,
    ["coroutine.resume"] = true,
    ["coroutine.yield"] = true,
    ["coroutine.running"] = true,
    ["coroutine.close"] = true
}

--- Whether `expr` is a library call with several results.
function graph.packedcall(expr: any): boolean
    if expr == nil or expr.kind ~= "call" and expr.kind ~= "methodCall" then
        return false
    end
    local library = graph.coreLibraryCall(expr)

    return library ~= nil and packedlibrary[library] == true
end

-- The signature a call through an `any` value is checked against: its
-- arguments and `count` results, all `any`.
local function anySignature(call: any, count: integer, skipped: integer?): any
    local held = anySignatures[call]
    if held and #held.rets == count then
        return held
    end
    -- pcall's own arguments (`skipped`) come before the callee's.
    local params, modes = {}, {}
    for index = 1, #(call.args and call.args.exprs or {}) - (skipped or 0) do
        params[index], modes[index] = {tag = "any"}, "plain"
    end
    local rets, retModes = {}, {}
    for index = 1, count do
        rets[index], retModes[index] = {tag = "any"}, "plain"
    end
    local signature = {
        tag = "func",
        params = params,
        paramPack = {head = params, modes = modes},
        rets = rets,
        retPack = {head = rets, modes = retModes}
    }
    anySignatures[call] = signature

    return signature
end

-- Whether a function type's results are one of several packs, as a wrapped
-- coroutine's are (what it yields, or what it returns): its calls are
-- checked as calls through `any` are.
local function alternativeresults(called: any): boolean
    return called.tag == "func" and called.retPack ~= nil and called.retPack.alternatives ~= nil
end

-- Whether a generic `for` calls its iterator: any but the forms the profile
-- lowers itself, `ipairs(t)`, `pairs(t)` and `s:gmatch(p)`.
function graph.genericiterator(stat: any): boolean
    local source = stat.exprs and stat.exprs[1]
    if source == nil then
        return false
    end
    if #stat.exprs == 1
        and source.kind == "call"
        and (source.resolvedGlobal == "ipairs" or source.resolvedGlobal == "pairs")
    then
        return false
    end

    return not (#stat.exprs == 1 and graph.coreLibraryCall(source) == "string.gmatch")
end

-- The contract of a generic `for`'s call of its iterator, keeping `count`
-- results: two values in, all `any`.
function graph.iteratorcontract(stat: any, count: integer): any
    local held = anySignatures[stat]
    if held == nil or #held.rets ~= count then
        local params, modes = {{tag = "any"}, {tag = "any"}}, {"plain", "plain"}
        local rets, retModes = {}, {}
        for index = 1, count do
            rets[index], retModes[index] = {tag = "any"}, "plain"
        end
        held = {
            tag = "func",
            params = params,
            paramPack = {head = params, modes = modes},
            rets = rets,
            retPack = {head = rets, modes = retModes}
        }
        anySignatures[stat] = held
    end
    local contract = {
        dynamic = true,
        iterator = true,
        given = 2,
        call = stat,
        callSignature = held,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

-- `count`: the results the call keeps, which a call through `any` declares.
function graph.dynamicmethodcontract(call: any, count: integer?): any
    local signature = methodsignatures[call]
    if signature == nil or #signature.rets ~= (count or 1) then
        -- A `...` last passes its values after the others, as a variadic
        -- callee takes them.
        local exprs = call.args and call.args.exprs or {}
        local spreads = #exprs > 0 and exprs[#exprs].kind == "vararg"
        local params, modes = {{tag = "any"}}, {"plain"}
        for index = 1, #exprs - (spreads and 1 or 0) do
            params[index + 1], modes[index + 1] = {tag = "any"}, "plain"
        end
        local rets, retModes = {}, {}
        for index = 1, count or 1 do
            rets[index], retModes[index] = {tag = "any"}, "plain"
        end
        signature = {
            tag = "func",
            params = params,
            vararg = spreads or nil,
            paramPack = {
                head = params,
                modes = modes,
                tail = spreads and {kind = "unknown", type = {tag = "any"}} or nil
            },
            rets = rets,
            retPack = {head = rets, modes = retModes}
        }
        methodsignatures[call] = signature
    end
    local contract = {
        dynamic = true,
        method = true,
        call = call,
        callSignature = signature,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

function graph.dynamicInvokeContract(call: any, count: integer?): any
    -- A call through `any`, or through a value its metatable's __call makes
    -- callable, is checked against the call itself.
    local called = call.calleeType
    if called and (called.tag ~= "func" or alternativeresults(called)) then
        called = anySignature(call, count or 1)
    end
    local contract = {
        dynamic = true,
        call = call,
        callSignature = called,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

-- Whether a call last in a list gives other than exactly one result, a fixed
-- count or an open one: then the list takes them all, as a pack.
function graph.expandsResults(expr: any): boolean
    -- A library call with several results gives them all, as Lua's do.
    if graph.packedcall(expr) then
        return true
    end
    if expr == nil or expr.kind ~= "call" or expr.runtimeLoader ~= nil or graph.coreLibraryCall(expr) ~= nil then
        return false
    end
    local called = expr.calleeType
    if called ~= nil and alternativeresults(called) then
        return true
    end
    if called == nil or called.tag ~= "func" then
        -- Through `any`, as many as the callee gives.
        return called ~= nil and called.tag == "any"
    end
    local pack = called.retPack

    return pack ~= nil and (pack.tail ~= nil or #pack.head ~= 1)
end

-- Whether a call's last argument spreads a pack: `...`, or a call whose
-- results it takes all of, pcall's and xpcall's among them.
function graph.spreadsLast(call: any): boolean
    local exprs = call.args and call.args.exprs or {}
    local last = exprs[#exprs]
    local library = last ~= nil and last.kind == "call" and graph.coreLibraryCall(last) or nil

    return last ~= nil
        and (last.kind == "vararg" or graph.expandsResults(last) or library == "pcall" or library == "xpcall")
end

-- The argument a library call calls back, by its index among the call's
-- arguments: table.sort's comparator, or string.gsub's replacement when it
-- is a function. Nil for any other call.
function graph.callbackArgument(call: any): integer?
    local library = graph.coreLibraryCall(call)
    local exprs = call and call.args and call.args.exprs
    if library == "table.sort" and exprs and #exprs == 2 then
        return 2
    end
    if library == "string.gsub" and exprs then
        local index = call.kind == "methodCall" and 2 or 3
        local replacement = exprs[index]
        local t = replacement and replacement.inferredType
        if t and t.tag == "func" then
            return index
        end
    end

    return nil
end

-- The contract of a library call's call of its callback with `given` values,
-- or with `spread` a pack of them.
function graph.callbackInvokeContract(call: any, given: integer, spread: boolean?): any
    local argument = graph.callbackArgument(call)
    assert(argument ~= nil, "call takes no callback")
    local contract = {
        dynamic = true,
        callback = argument,
        given = given,
        spread = spread == true or nil,
        call = call,
        callSignature = call.args.exprs[argument].inferredType,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

-- The contract of `pcall(f, ...)`'s call of f, through f's checked type;
-- for `xpcall(f, handler, ...)` too, handled.
function graph.protectedInvokeContract(call: any): any
    local callee = call.args and call.args.exprs and call.args.exprs[1]
    local handled = graph.coreLibraryCall(call) == "xpcall"
    -- A callee through `any`, or one whose results are alternatives (a
    -- wrapped coroutine's), is checked against the call itself.
    local called = callee and callee.inferredType
    if called and (called.tag ~= "func" or alternativeresults(called)) then
        called = anySignature(call, 1, handled and 2 or 1)
    end
    local contract = {
        dynamic = true,
        protected = true,
        handled = handled or nil,
        call = call,
        callSignature = called,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

-- The contract of `new R(...)`'s call of R's constructor `owner`.
function graph.constructContract(owner: any, call: any): any
    local contract = {
        owner = owner,
        body = owner.body,
        definition = owner.definition,
        signature = owner.signature,
        call = call,
        callSignature = call.signatureType,
        summary = owner.body.effectSummary,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false},
        construct = true
    }
    invokeContract(contract)

    return contract
end

function graph.invokeContract(owner: any, call: any): any
    local contract = {
        owner = owner,
        body = owner.body,
        definition = owner.definition,
        signature = owner.signature,
        call = call,
        callSignature = callsignatureof(owner, call),
        summary = owner.body.effectSummary,
        effects = {mayCollect = true, mayRaise = true, mayPark = false, pure = false}
    }
    invokeContract(contract)

    return contract
end

local edgeCounts = {
    invoke = 1,
    jump = 1,
    branch = 2,
    ["return"] = 0,
    returns = 0,
    raise = 0,
    park = 1,
    dispatch = 0,
    nativeTail = 0,
    nativeFail = 0
}

local function verifyGraph(g: any, invokeArity: any): nil
    local blocks, types, slots, counts = g.blocks, g.types, g.slots, g.counts
    if not (#blocks > 0 and #blocks <= 100000 and #types == #slots) then
        error("assertion failed", 0)
    end
    local nparams = g.nparams
    if not (nparams >= 0 and nparams < 240 and nparams % 1 == 0 and #types >= nparams) then
        error("assertion failed", 0)
    end
    local native = g.native ~= nil
    local physicalOwner = physical.graphOwner(g)
    if g.nativePhysical then
        assert(native and type(g.nativePhysical.values) == "table", "native physical sidecars require native graph")
        -- Handler/managed admission must first model these accesses in frameverify.
        assert(g.native.abi == "leaf", "physical graphs require leaf ABI")
        physical.validateContext(g.nativePhysical.context)
        for value, descriptor in pairs(g.nativePhysical.values) do
            assert(
                type(value) == "number" and value % 1 == 0 and value >= 1 and value <= #types,
                "physical invalid value is unsupported"
            )
            physical.validate(descriptor)
            if #descriptor.ownership ~= 0 then
                local signature, matched = g.nativePhysical.signature, physical.dependent(descriptor)
                if physicalOwner then
                    matched = physical.qualifiedGraphValue(g, descriptor)
                else
                    assert(signature, "qualified graph value requires original checked owner or signature")
                    assert(
                        not require("nupp.compiler.vm.nativeunit").contains(signature.owner),
                        "qualified unit graph requires original checked owner"
                    )
                    if descriptor.checkedType.tag == "affine" then
                        matched = physical.affineValue(signature.owner, descriptor)
                    end
                    for index, parameter in ipairs(signature.params) do
                        if parameter
                            and physical.borrowingParameter(signature, index)
                            and physical.same(descriptor, parameter)
                        then
                            matched = true
                        end
                    end
                end
                assert(matched, "borrowed graph value differs from checked parameter")
            end
            assert(
                descriptor.context == g.nativePhysical.context
                and descriptor.machineKind == "voidptr"
                and g.exactTypes[value] == "voidptr",
                "physical value type/context differs"
            )
        end
    end
    if g.nativePhysical and g.nativePhysical.signature then
        local signature = g.nativePhysical.signature
        physical.validateSignature(signature)
        assert(
            signature.context == g.nativePhysical.context
            and #signature.params == (g.nativeService and service.sourceCount(g.nativeService) or nparams)
            and g.source
            and signature.owner.scope.path == g.source.path
            and signature.owner.scope.name == g.source.module
            and signature.owner.name == g.source.name,
            "physical graph signature owner/context differs"
        )
        for index, descriptor in ipairs(signature.params) do
            local actual = g.nativePhysical.values[index]
            assert(
                descriptor == false and actual == nil
                or descriptor and actual and physical.sameValue(descriptor, actual),
                "physical entry parameter differs"
            )
        end
    elseif g.nativePhysical then
        for value in pairs(g.nativePhysical.values) do
            assert(value > nparams, "physical parameter requires checked signature")
        end
    end
    if g.exactTypes ~= nil and not native then
        assert(type(g.exactTypes) == "table" and #g.exactTypes == #types, "missing graph exact types")
        for index, kind in ipairs(g.exactTypes) do
            assert(
                nativeClasses[kind] == types[index] or kind == "boolean" and types[index] == "v",
                "invalid graph exact type"
            )
        end
    end
    if native then
        local signature = g.native
        assert(
            type(signature) == "table"
            and (
                signature.result == "uint64"
                or signature.abi == "leaf"
                and (
                    signature.result == "int64"
                    or signature.result == "boolean"
                    or signature.result == "nil"
                    or signature.result == "voidptr"
                )
            ),
            "invalid native result signature"
        )
        if signature.abi == "handler" then
            assert(#signature.params == 6 and nparams == 6, "invalid native handler signature")
            for i = 1, 6 do
                assert(signature.params[i] == "voidptr", "native handler parameter kind")
            end
        elseif signature.abi == "support" then
            assert(
                nparams >= 2
                and #signature.params == nparams
                and signature.params[1] == "voidptr"
                and signature.params[2] == "voidptr",
                "invalid native support signature"
            )
            for _, kind in ipairs(signature.params) do
                assert(nativeClasses[kind] ~= nil, "native support exact parameter kind")
            end
        else
            assert(
                signature.abi == "leaf" and (nparams >= 1 or g.nativeService ~= nil) and nparams <= 8,
                "invalid native leaf signature"
            )
            assert(#signature.params == nparams, "native leaf parameter count")
            for _, kind in ipairs(signature.params) do
                assert(
                    kind == "voidptr" or kind == "int64" or kind == "uint64" or kind == "boolean",
                    "native leaf parameter kind"
                )
            end
        end
        assert(type(g.exactTypes) == "table" and #g.exactTypes == #types, "missing native exact types")
        for i = 1, #types do
            assert(nativeClasses[g.exactTypes[i]] == types[i], "invalid native exact type")
            if g.exactTypes[i] == "int32" or g.exactTypes[i] == "uint32" then
                assert(g.nativePhysical, "projected physical integers require checked physical context")
            end
        end
        for i = 1, nparams do
            assert(signature.params[i] == g.exactTypes[i], "native entry parameter kind")
        end
        assert(#g.certificates == 0, "native certificate transport is outside the leaf profile")
    end
    -- Count all incoming edges, including unreachable predecessors. An invoke
    -- result is defined only by its dedicated continuation's first parameter.
    local incoming, hasInvoke = {}, false
    for _, block in ipairs(blocks) do
        hasInvoke = hasInvoke or block.term and block.term.kind == "invoke"
    end
    if hasInvoke then
        dense(blocks)
        for _, block in ipairs(blocks) do
            assert(block.term, "unterminated graph block")
            dense(block.term.edges)
            for _, edge in ipairs(block.term.edges) do
                assert(
                    type(edge) == "table"
                    and type(edge.target) == "number"
                    and edge.target >= 1
                    and edge.target <= #blocks
                    and edge.target % 1 == 0,
                    "bad invoke graph edge"
                )
                dense(edge.args)
                incoming[edge.target] = (incoming[edge.target] or 0) + 1
            end
        end
    end
    local defined = {}
    -- Per block: the values usable here (its parameters and earlier results)
    -- and the slot hints taken, keyed by class so classes never collide.
    local localValues, occupied = {}, {}
    local classBase = {v = 0, i = 1000000, f = 2000000, x = 3000000}

    local function valueId(v: any): boolean
        return type(v) == "number" and v >= 1 and v <= #types and v % 1 == 0
    end

    local function define(v: any): nil
        if not valueId(v) then
            error("graph value id outside dense table", 0)
        end
        local ty, slot = types[v], slots[v]
        if not (ty and not defined[v]) then
            error("duplicate graph definition", 0)
        end
        if not (counts[ty] and slot >= 0 and slot % 1 == 0 and slot < counts[ty]) then
            error("assertion failed", 0)
        end
        local key = classBase[ty] + slot
        if occupied[key] then
            error("overlapping graph slot hints", 0)
        end
        occupied[key] = true
        defined[v], localValues[v] = true, true
    end

    for i = 1, nparams do
        if not (
            native and types[i] == "i" and slots[i] == i - 1 or not native and types[i] == "v" and slots[i] == i
        ) then
            error("function parameters are the first value ids", 0)
        end
        defined[i] = true
    end

    local function usable(v: any): boolean
        return valueId(v) and (localValues[v] == true or v <= nparams)
    end

    local ncerts = #g.certificates
    local localContracts, localCount, localBytes = {}, 0, 0
    for index = 1, #blocks do
        local b = blocks[index]
        local ops, dsts, allArgs, params, certs = b.op, b.dst, b.args, b.params, b.cert
        if not (b.id == index and #ops == #dsts and #ops == #allArgs and #ops == #b.pos and #ops == #certs) then
            error("assertion failed", 0)
        end
        localValues, occupied = {}, {}
        local constants = {}
        for i = 1, #params do
            if not (params[i] > nparams) then
                error("function parameters are not block parameters", 0)
            end
            define(params[i])
        end
        if index == 1 and #params > 0 then
            error("entry parameters come from the frame", 0)
        end
        for i = 1, #ops do
            local sig = assert(parsed[ops[i]], "unknown graph operation")
            local args, argClasses = allArgs[i], sig.args
            if not operationArity(sig, args) then
                error("graph operation arity", 0)
            end
            if sig.terminator then
                error("terminator opcode inside a block", 0)
            end
            if ops[i] == "Closure" then
                assert(not native, "closure construction requires a guest graph")
                graph.closureTarget(ops[i], args)
            end
            if not native then
                assert(not nativeOnly[ops[i]], "native operation requires a native graph")
            end
            for j = 1, #args do
                local ty = operandClass(sig, j)
                if classes[ty] or ty == "a" then
                    local v = args[j]
                    if not (usable(v)) then
                        error(
                            "graph use outside its closed block: value " .. tostring(
                                v
                            ) .. " in block " .. index .. " by " .. ops[i],
                            0
                        )
                    end
                    if not (ty == "a" or types[v] == ty) then
                        error(
                            "graph value class mismatch: value " .. tostring(
                                v
                            ) .. " in block " .. index .. " by " .. ops[i],
                            0
                        )
                    end
                end
            end
            if not (certs[i] >= 0 and certs[i] <= ncerts) then
                error("certificate outside the table", 0)
            end
            local result = sig.result
            if native and sig.variadic and args[1].result == "nil" then
                result = "-"
            end
            if result ~= "-" then
                if not (
                    native and types[dsts[i]] == nativeClasses[g.exactTypes[dsts[i]]]
                    or not native and types[dsts[i]] == lowered[result]
                ) then
                    error("assertion failed", 0)
                end
                define(dsts[i])
            elseif not (dsts[i] == 0) then
                error("assertion failed", 0)
            end
            if native then
                assert(
                    b.pos[i] >= 0 and b.pos[i] % 1 == 0 and b.pos[i] <= #g.positions,
                    "native source position outside table"
                )
                verifyNativeOperation(g, ops[i], args, dsts[i], constants)
                if ops[i] == "NativeConstant" then
                    constants[dsts[i]] = args[1]
                elseif ops[i] == "NativeLocal" then
                    local contract = args[1]
                    assert(
                        index == 1 and not localContracts[contract],
                        "physical local requires unique entry construction"
                    )
                    localContracts[contract] = true
                    localCount, localBytes = localCount
                        + 1, localBytes
                        + contract.layout.size
                        + contract.layout.alignment
                        - 1
                    assert(localCount <= 64 and localBytes <= 65536, "physical local arena extent exceeds bound")
                end
            end
        end
        local t = assert(b.term, "unterminated graph block")
        local kind = t.kind
        local edges = t.edges
        if native then
            local pos = t.pos or 0
            assert(pos >= 0 and pos % 1 == 0 and pos <= #g.positions, "native terminator source position outside table")
        end
        if kind == "invoke" then
            assert(not native, "invoke requires a guest graph")
            nativeContract(t, {
                kind = true,
                callee = true,
                args = true,
                contract = true,
                result = true,
                results = true,
                spread = true,
                open = true,
                edges = true,
                pos = true
            })
            assert(t.open == nil or t.open == true and t.results == nil, "an open invoke keeps one pack")
            local arity = invokeArity(t, index)
            dense(t.args)
            assert(#t.args == arity, "invoke must retain every evaluated argument")
            assert(usable(t.callee) and types[t.callee] == "v", "invoke callee must be usable tagged SSA")
            assert(
                t.spread == nil or usable(t.spread) and types[t.spread] == "v",
                "invoke spread must be usable tagged SSA"
            )
            for _, value in ipairs(t.args) do
                assert(usable(value) and types[value] == "v", "invoke argument must be usable tagged SSA")
            end
            assert(#edges == 1, "invoke requires one continuation")
            local continuation = blocks[edges[1].target]
            assert(
                continuation and continuation.id ~= 1 and incoming[continuation.id] == 1,
                "invoke continuation must have one predecessor"
            )
            dense(continuation.params)
            if t.result ~= nil then
                assert(
                    valueId(t.result) and types[t.result] == "v" and continuation.params[1] == t.result,
                    "invoke result must be the first tagged continuation parameter"
                )
                assert(not usable(t.result), "invoke result cannot be defined before its continuation")
            end
            if t.results ~= nil then
                dense(t.results)
                assert(#t.results >= 1 and #t.results <= 16 and t.results[1] == t.result, "invoke results")
                for i, value in ipairs(t.results) do
                    assert(
                        valueId(value) and types[value] == "v" and continuation.params[i] == value,
                        "invoke results must lead the tagged continuation parameters"
                    )
                end
            end
            local pos = t.pos or 0
            assert(
                type(pos) == "number" and pos >= 0 and pos % 1 == 0 and pos <= #g.positions,
                "invoke source position outside table"
            )
        elseif kind == "dispatch" then
            assert(
                native
                and (g.native.abi == "handler" or g.native.abi == "support")
                and type(t.args) == "table"
                and #t.args == 6,
                "invalid native dispatch"
            )
            for i = 1, 6 do
                assert(usable(t.args[i]) and g.exactTypes[t.args[i]] == "voidptr", "native dispatch operand kind")
                local descriptor = g.nativePhysical and g.nativePhysical.values[t.args[i]]
                assert(
                    not descriptor or descriptor.pointee == nil and not physical.localOrigin(descriptor),
                    "typed pointer dispatch is unsupported"
                )
            end
            local pos = t.pos or 0
            assert(pos >= 0 and pos % 1 == 0 and pos <= #g.positions, "native dispatch source position outside table")
        elseif kind == "nativeTail" then
            assert(
                native and (g.native.abi == "handler" or g.native.abi == "support"),
                "native tail transfer requires a managed graph"
            )
            local declaration = t.callee
            nativeContract(declaration, {
                moduleName = true,
                name = true,
                params = true,
                result = true,
                abi = true,
                effects = true,
                source = true
            })
            declarationSource(declaration)
            assert(declaration.abi == "support" and declaration.result == "uint64", "native tail support ABI mismatch")
            assert(
                type(declaration.params) == "table"
                and #declaration.params >= 2
                and type(t.args) == "table"
                and #t.args == #declaration.params,
                "native tail argument count"
            )
            for index, parameter in ipairs(declaration.params) do
                local descriptor = g.nativePhysical and g.nativePhysical.values[t.args[index]]
                assert(
                    not descriptor or descriptor.pointee == nil and not physical.localOrigin(descriptor),
                    "typed pointer tail call is unsupported"
                )
                assert(
                    nativeClasses[parameter] and usable(t.args[index]) and g.exactTypes[t.args[index]] == parameter,
                    "native tail operand kind"
                )
            end
            assert(
                declaration.params[1] == "voidptr"
                and declaration.params[2] == "voidptr"
                and t.args[1] == 1
                and t.args[2] == (g.native.abi == "handler" and 5 or 2),
                "native tail changes original pc/context identity"
            )
            local effects = declaration.effects
            nativeContract(effects, {mayCollect = true, mayPark = true, mayRaise = true, pure = true})
            assert(
                effects.mayCollect == true
                and effects.mayPark == true
                and effects.mayRaise == true
                and effects.pure == false,
                "native tail requires conservative managed effects"
            )
        elseif kind == "nativeFail" then
            assert(
                native
                and (
                    g.native.abi == "handler"
                    or g.native.abi == "support"
                    or g.native.abi == "leaf" and service.isFailure(g, t)
                )
                and t.args == nil
                and t.value == nil,
                "native failure exit requires a handler graph and carries no values"
            )
        elseif native and kind == "branch" then
            assert(usable(t.value) and g.exactTypes[t.value] == "boolean", "native branch requires a boolean condition")
        elseif native and kind == "return" then
            assert(g.native.abi == "leaf", "native handler cannot return a scalar")
            local descriptor = t.value and g.nativePhysical and g.nativePhysical.values[t.value]
            assert(
                not descriptor or not physical.localOrigin(descriptor),
                "physical local address cannot escape through return"
            )
            assert(
                g.native.result == "nil" and t.value == nil
                or g.native.result ~= "nil" and usable(t.value) and g.exactTypes[t.value] == g.native.result,
                "native leaf return kind"
            )
            if g.nativePhysical then
                local signature = g.nativePhysical.signature
                local expected = signature and signature.result
                local actual = t.value and g.nativePhysical.values[t.value]
                assert(
                    expected == nil and (actual == nil or g.native.result == "voidptr" and physical.rawReturn(actual))
                    or expected and actual and physical.returnValue(signature, actual),
                    "physical return descriptor differs"
                )
            end
        elseif native and kind ~= "jump" then
            error("native graph requires a jump, branch, dispatch or leaf return", 0)
        elseif kind == "branch" then
            if not (usable(t.value) and (types[t.value] == "i" or types[t.value] == "v")) then
                error("graph branch condition", 0)
            end
        elseif kind == "switch" then
            if not (usable(t.value) and types[t.value] == "i") then
                error("graph switch index", 0)
            end
            if not (#edges >= 1) then
                error("switch without a default edge", 0)
            end
        elseif kind == "return" then
            if t.value then
                if not (
                    usable(t.value) and (types[t.value] == "f" or types[t.value] == "v" or types[t.value] == "i")
                ) then
                    error("graph return value", 0)
                end
            end
            for _, value in ipairs(t.values or {}) do
                if not (usable(value) and types[value] == "v") then
                    error("graph return values", 0)
                end
            end
            if t.spread ~= nil and not (usable(t.spread) and types[t.spread] == "v") then
                error("graph return spread", 0)
            end
        elseif kind == "park" then
            if not (usable(t.value) and (types[t.value] == "f" or types[t.value] == "v")) then
                error("graph park value", 0)
            end
        elseif kind == "returns" then
            if not (t.value and usable(t.value) and types[t.value] == "v" and type(t.count) == "number") then
                error("graph returns window", 0)
            end
        elseif kind == "raise" then
            if not (t.constant >= 0 and t.constant < #g.constants) then
                error("raise constant outside the pool", 0)
            end
        elseif kind ~= "jump" then
            error("unknown terminator", 0)
        end
        if kind ~= "switch" then
            if not (#edges == edgeCounts[kind]) then
                error("assertion failed", 0)
            end
        end
        for ei = 1, #edges do
            local e = edges[ei]
            if not (type(e.target) == "number" and e.target >= 1 and e.target <= #blocks and e.target % 1 == 0) then
                error("bad graph target", 0)
            end
            local target = assert(blocks[e.target], "bad graph target")
            local args, targetParams = e.args, target.params
            local offset = resultOffset(t)
            if not (e.target ~= 1 and #args + offset == #targetParams) then
                error("bad graph edge arity", 0)
            end
            for i = 1, #args do
                local v = args[i]
                if not (usable(v)) then
                    error(
                        "graph use outside its closed block: value " .. tostring(
                            v
                        ) .. " on the edge from block " .. index .. " to " .. e.target,
                        0
                    )
                end
                if not (types[v] == types[targetParams[i + offset]]) then
                    error(
                        "graph value class mismatch: value " .. tostring(
                            v
                        ) .. " on the edge from block " .. index .. " to " .. e.target,
                        0
                    )
                end
                if g.exactTypes ~= nil then
                    assert(g.exactTypes[v] == g.exactTypes[targetParams[i + offset]], "graph edge exact kind mismatch")

                end
            end
        end
    end
    for v = 1, #types do
        if not (defined[v]) then
            error("undefined graph value", 0)
        end
    end
    if g.nativePhysical then
        physical.verifyTransport(g)
        physical.verifyViews(g)
    end
    local final = finalframe.verify(g)
    -- Test builds are tested, not proven (runtime plan, "Direction").
    if native and g.native.abi ~= "leaf" and not final and not service.isUnitModule(g.source and g.source.module) then
        frameverify.verify(g)
    end
    local certs = g.certificates
    for i = 1, #certs do
        local c = certs[i]
        if not (types[c.guard] == "i" and types[c.cursor] == "i" and types[c.span] == "i") then
            error("certificate cites values outside the integer class", 0)
        end
    end
end

function graph.verify(g: any): nil
    verifyGraph(g, function(term: any, index: integer): integer
        invokeContract(term.contract)
        -- A library call's callback takes the values the library supplies, and
        -- a generic `for`'s iterator its state and control.
        if term.contract.callback or term.contract.iterator then
            return term.contract.given
        end
        -- A spread `...` last is the term's pack, not one of its arguments; a
        -- method call's receiver is its first one.
        local count: integer = #term.contract.call.args.exprs
        if term.spread then
            count -= 1
        end
        if term.contract.call.kind == "methodCall" or term.contract.construct then
            count += 1
        end
        -- pcall's first argument is the callee.
        if term.contract.protected then
            count -= 1
        end
        -- Parameters a call leaves off are passed as nil. A declared
        -- method's function type leaves out its receiver; a dynamic one's
        -- signature is the call's own. xpcall's handler follows the callee's
        -- arguments.
        local method = term.contract.call.kind == "methodCall"
        local handler: integer = term.contract.protected and term.contract.handled == true and 1 or 0
        if (term.contract.call.kind == "call" or method and not term.contract.dynamic)
            and not term.spread
            and not term.contract.construct
            and graph.omits(term.contract.callSignature, (method and count - 1 or count) - handler)
        then
            count = #term.contract.callSignature.params + (method and 1 or 0) + handler
        end

        return count
    end)
    if g.native then
        nativeos.verifyStores(g);
        service.verifyScope(g)
    end

end

-- Structural SSA validation only. Numeric arities do not prove checked source,
-- catalog membership, effects, or executable admission. Those remain separate.
function graph.verifyGuestStructure(g: any, arities: any): nil
    assert(
        g.native == nil and g.nativePhysical == nil and g.exactTypes == nil,
        "guest structure cannot admit native or physical sidecars"
    )
    dense(arities)
    assert(#arities == #g.blocks, "guest structure requires one arity per block")
    for index, block in ipairs(g.blocks) do
        local arity = arities[index]
        if block.term and block.term.kind == "invoke" then
            assert(
                type(arity) == "number" and arity >= 0 and arity < 240 and arity % 1 == 0,
                "invalid numeric invoke arity"
            )
            local id = block.term.contract
            assert(
                type(id) == "number" and id >= 0 and id < 1048576 and id % 1 == 0,
                "guest structure requires numeric contract IDs"
            )
        else
            assert(arity == 4294967295, "non-invoke block must have absent arity")
        end
    end
    verifyGraph(g, function(term: any, index: integer): integer
        return arities[index]
    end)
end

--- Removes the transported parameters no block uses downstream, with the
--- values that only fed them. Nothing else is deleted: every instruction
--- with a result keeps it, so an instruction that may fail still runs.
function graph.prune(g: any): nil
    finalframe.refuse(g, "pruning")
    local used = {}
    local blocks = g.blocks
    local nparams = g.nparams
    -- Instruction operands, terminator values and certificates are the roots.
    for bi = 1, #blocks do
        local b = blocks[bi]
        local ops, allArgs = b.op, b.args
        for i = 1, #ops do
            local sig, args = parsed[ops[i]], allArgs[i]
            for j = 1, #args do
                if classes[operandClass(sig, j)] or operandClass(sig, j) == "a" then
                    used[args[j]] = true
                end
            end
        end
        if b.term.value then
            used[b.term.value] = true
        end
        for _, value in ipairs(b.term.values or {}) do
            used[value] = true
        end
        if b.term.spread then
            used[b.term.spread] = true
        end
        if b.term.kind == "invoke" then
            used[b.term.callee] = true
            for _, value in ipairs(b.term.results or {}) do
                used[value] = true
            end
        end
        if b.term.kind == "dispatch" or b.term.kind == "nativeTail" or b.term.kind == "invoke" then
            for _, value in ipairs(b.term.args) do
                used[value] = true
            end
        end
    end
    local certs = g.certificates
    for i = 1, #certs do
        used[certs[i].guard], used[certs[i].cursor], used[certs[i].span] = true, true, true
    end
    -- A used parameter makes every argument feeding it used. Edges are few,
    -- so passes over them until nothing changes beat per-parameter lists.
    local changed = true
    while changed do
        changed = false
        for bi = 1, #blocks do
            local term = blocks[bi].term
            local offset = resultOffset(term)
            local edges = term.edges
            for ei = 1, #edges do
                local e = edges[ei]
                local params, args = blocks[e.target].params, e.args
                for i = offset + 1, #params do
                    local v = args[i - offset]
                    if used[params[i]] and not used[v] then
                        used[v] = true
                        changed = true
                    end
                end
            end
        end
    end
    -- Surviving values are renumbered densely, the function parameters first
    -- so they keep their ids. Each block records which of its parameter
    -- positions survived so edge arguments compact to match.
    local remap, types, slots, exactTypes, physicalTypes = {}, {}, {}, {}, {}
    local count: integer = 0
    local gTypes, gSlots = g.types, g.slots

    local function keep(v: integer): integer
        count = count + 1
        remap[v], types[count], slots[count] = count, gTypes[v], gSlots[v]
        if g.exactTypes ~= nil then
            exactTypes[count] = g.exactTypes[v]
        end
        if g.nativePhysical then
            physicalTypes[count] = g.nativePhysical.values[v]
        end

        return count
    end

    for i = 1, nparams do
        keep(i)
    end
    for bi = 1, #blocks do
        local b = blocks[bi]
        local params, n, survived = b.params, 0, {}
        for i = 1, #params do
            local v = params[i]
            local live = used[v] == true
            survived[i] = live
            if live then
                n = n + 1
                params[n] = keep(v)
            end
        end
        for i = #params, n + 1, -1 do
            params[i] = nil
        end
        b.survived = survived
        b.keyNames, b.keyIndex = nil, nil
        b.env, b.names, b.facts, b.held = nil, nil, nil, nil
        local dst = b.dst
        for i = 1, #dst do
            local v = dst[i]
            if v ~= 0 then
                dst[i] = keep(v)
            end
        end
    end
    -- Operands, terminator values and edge arguments renumber in one pass;
    -- edge arguments also compact to the parameters that survived.
    for bi = 1, #blocks do
        local b = blocks[bi]
        local ops, allArgs = b.op, b.args
        for i = 1, #ops do
            local sig, args = parsed[ops[i]], allArgs[i]
            for j = 1, #args do
                if classes[operandClass(sig, j)] or operandClass(sig, j) == "a" then
                    args[j] = assert(remap[args[j]])
                end
            end
        end
        local t = b.term
        if t.value then
            t.value = assert(remap[t.value])
        end
        for i = 1, #(t.values or {}) do
            t.values[i] = assert(remap[t.values[i]])
        end
        t.spread = t.spread and assert(remap[t.spread]) or nil
        local offset = resultOffset(t)
        if t.kind == "invoke" then
            t.callee = assert(remap[t.callee])
            -- Removing the unused edge result changes only the consumer to
            -- discard. The scalar call contract and every input remain.
            t.result = t.result and remap[t.result] or nil
            -- Several results keep their positions, so all of them survive.
            if t.results then
                for i = 1, #t.results do
                    t.results[i] = assert(remap[t.results[i]])
                end
            end
        end
        if t.kind == "dispatch" or t.kind == "nativeTail" or t.kind == "invoke" then
            for i = 1, #t.args do
                t.args[i] = assert(remap[t.args[i]])
            end
        end
        local edges = t.edges
        for ei = 1, #edges do
            local e = edges[ei]
            local survived, args, n = blocks[e.target].survived, e.args, 0
            for i = offset + 1, #survived do
                if survived[i] then
                    n = n + 1
                    args[n] = assert(remap[args[i - offset]])
                end
            end
            for i = #args, n + 1, -1 do
                args[i] = nil
            end
        end
    end
    for bi = 1, #blocks do
        blocks[bi].survived = nil
    end
    for i = 1, #certs do
        local c = certs[i]
        c.guard, c.cursor, c.span = assert(remap[c.guard]), assert(remap[c.cursor]), assert(remap[c.span])
    end
    if g.map then
        g.map.index = assert(remap[g.map.index])
        g.map.count = assert(remap[g.map.count])
    end
    g.types, g.slots = types, slots
    if g.exactTypes ~= nil then
        g.exactTypes = exactTypes
    end
    if g.nativePhysical then
        g.nativePhysical.values = physicalTypes
    end
end

--- Drops the blocks no path from the entry reaches, as after a loop whose
--- body always leaves (`for _ in pairs(t) do return true end`), and the values
--- only they defined. Blocks and values are renumbered densely in order, so
--- the function parameters keep their ids; nothing reachable changes.
function graph.dropUnreachable(g: any): nil
    local blocks = g.blocks
    local reached: {[integer]: boolean} = {[1] = true}
    local order: {integer} = {1}
    local at: integer = 1
    while at <= #order do
        local b = blocks[order[at]]
        at += 1
        for _, edge in ipairs(b.term and b.term.edges or {}) do
            if not reached[edge.target] then
                reached[edge.target] = true
                order[#order + 1] = edge.target
            end
        end
    end
    if #order == #blocks then
        return
    end
    local blockRemap: {[integer]: integer} = {}
    local kept = {}
    for index, b in ipairs(blocks) do
        if reached[index] then
            kept[#kept + 1] = b
            blockRemap[index] = #kept
        end
    end
    -- What the kept blocks define: their parameters and results.
    local defined: {[integer]: boolean} = {}
    for v = 1, g.nparams do
        defined[v] = true
    end
    for _, b in ipairs(kept) do
        for _, v in ipairs(b.params) do
            defined[v] = true
        end
        for _, v in ipairs(b.dst) do
            if v ~= 0 then
                defined[v] = true
            end
        end
    end
    local remap: {[integer]: integer} = {}
    local types, slots, exactTypes, physicalTypes = {}, {}, {}, {}
    local count: integer = 0
    for v = 1, #g.types do
        if defined[v] then
            count += 1
            remap[v], types[count], slots[count] = count, g.types[v], g.slots[v]
            if g.exactTypes ~= nil then
                exactTypes[count] = g.exactTypes[v]
            end
            if g.nativePhysical then
                physicalTypes[count] = g.nativePhysical.values[v]
            end
        end
    end

    local function value(v: integer): integer
        local renumbered = remap[v]
        assert(renumbered ~= nil, "a reachable block uses a value only an unreachable one defines")
        return renumbered as integer
    end

    for index, b in ipairs(kept) do
        b.id = index
        for i, v in ipairs(b.params) do
            b.params[i] = value(v)
        end
        for i, v in ipairs(b.dst) do
            if v ~= 0 then
                b.dst[i] = value(v)
            end
        end
        for i, op in ipairs(b.op) do
            local sig, args = parsed[op], b.args[i]
            for j = 1, #args do
                if classes[operandClass(sig, j)] or operandClass(sig, j) == "a" then
                    args[j] = value(args[j])
                end
            end
        end
        local t = b.term
        t.value = t.value and value(t.value) or nil
        for i, v in ipairs(t.values or {}) do
            t.values[i] = value(v)
        end
        t.spread = t.spread and value(t.spread) or nil
        if t.kind == "invoke" then
            t.callee = value(t.callee)
            t.result = t.result and value(t.result) or nil
            for i, v in ipairs(t.results or {}) do
                t.results[i] = value(v)
            end
        end
        if t.kind == "dispatch" or t.kind == "nativeTail" or t.kind == "invoke" then
            for i, v in ipairs(t.args) do
                t.args[i] = value(v)
            end
        end
        for _, edge in ipairs(t.edges) do
            edge.target = assert(blockRemap[edge.target])
            for i, v in ipairs(edge.args) do
                edge.args[i] = value(v)
            end
        end
    end
    for _, c in ipairs(g.certificates) do
        c.guard, c.cursor, c.span = value(c.guard), value(c.cursor), value(c.span)
    end
    if g.map then
        g.map.index, g.map.count = value(g.map.index), value(g.map.count)
    end
    g.blocks, g.types, g.slots = kept, types, slots
    if g.exactTypes ~= nil then
        g.exactTypes = exactTypes
    end
    if g.nativePhysical then
        g.nativePhysical.values = physicalTypes
    end
end

--- The region tree the frontend's annotations describe, as parallel columns:
--- region `r` has `kinds[r]` ("body", "loop", "then" or "else"), `parents[r]`
--- (0 at the root), `heads[r]` (the loop header or the branching block),
--- `entries[r]` (the first block inside, 0 for an empty arm), `continues[r]`
--- (a loop's continue block) and `merges[r]` (the block after it). Every
--- block belongs to exactly one region, in `blockRegion`. A frontend annotates
--- a loop header with `{kind = "loop", merge, continuing}` and a branching
--- block with `{kind = "selection", merge}` (`"guard"` when one arm raises,
--- `"clamp"` for a tail clamp, which the structured GPU walk does not take);
--- an arm may end in a return or a raise instead of reaching the merge.
--- Nothing is inferred: an unannotated
--- branch, a block reached twice, or a block the tree never reaches is an
--- error.
--- @raises string when the annotations do not describe the graph.
function graph.regions(g: any): any
    local blocks = g.blocks
    local kinds, parents, heads, entries, continues, merges = {"body"}, {0}, {1}, {1}, {0}, {0}
    local blockRegion = {}

    local function open(
        kind: string,
        parent: integer,
        head: integer,
        entry: integer,
        continuing: integer,
        merge: integer
    ): integer
        local r = #kinds + 1
        kinds[
            r
        ], parents[r], heads[r], entries[r], continues[r], merges[r] = kind, parent, head, entry, continuing, merge

        return r
    end

    local path
    path = function(id: integer, stop: integer, region: integer): nil
        while id ~= stop do
            local b = blocks[id]
            if not b then
                error("invalid region block", 0)
            end
            if blockRegion[id] then
                error("region crosses another region or has an unmarked cycle", 0)
            end
            blockRegion[id] = region
            local t, r = b.term, b.region
            if r and r.kind == "loop" then
                if not (t.kind == "branch" and t.edges[2].target == r.merge) then
                    error("loop exit differs from its merge", 0)
                end
                local continuing = blocks[r.continuing]
                if not continuing then
                    error("loop has no continue block", 0)
                end
                if not (continuing.term.kind == "jump" and continuing.term.edges[1].target == id) then
                    error("invalid loop back edge", 0)
                end
                local loop = open("loop", region, id, t.edges[1].target, r.continuing, r.merge)
                blockRegion[id] = loop
                path(t.edges[1].target, r.continuing, loop)
                if blockRegion[r.continuing] then
                    error("continue block has another entry", 0)
                end
                blockRegion[r.continuing] = loop
                id = r.merge
            elseif t.kind == "branch" then
                if not (
                    r and (r.kind == "selection" or r.kind == "guard" or r.kind == "clamp") and blocks[r.merge]
                ) then
                    error("selection has no merge", 0)
                end
                local yes, no = t.edges[1].target, t.edges[2].target
                local thenArm = open("then", region, id, yes == r.merge and 0 or yes, 0, r.merge)
                path(yes, r.merge, thenArm)
                local elseArm = open("else", region, id, no == r.merge and 0 or no, 0, r.merge)
                path(no, r.merge, elseArm)
                id = r.merge
            else
                if r then
                    error("region on a non-branch", 0)
                end
                if t.kind == "jump" or t.kind == "park" or t.kind == "invoke" then
                    id = t.edges[1].target
                elseif t.kind == "switch" then
                    error("switch regions are outside this slice", 0)
                else
                    -- A return or raise ends the path wherever it is.
                    id = stop
                end
            end
        end
    end
    path(1, 0, 1)
    for i = 1, #blocks do
        if not blockRegion[i] then
            error("block outside the region tree", 0)
        end
    end

    return {
        kinds = kinds,
        parents = parents,
        heads = heads,
        entries = entries,
        continues = continues,
        merges = merges,
        blockRegion = blockRegion,
        count = #kinds
    }
end

local moves = {v = "Move", i = "IMov", f = "FMov", x = "VMov"}

--- The executable stream the graph derives: slot layout from the hints,
--- parallel edge copies through one scratch register per class, blocks laid
--- out in order with the jump to the next block elided. The Rust loader
--- derives the same stream from the image; this one is what inspection
--- shows.
--- @raises string when the graph does not verify, a float-returning function
--- returns another class, or the slots exceed the register classes.
function graph.lower(g: any): any
    assert(g.native == nil, "native graph requires machine emission")
    for _, block in ipairs(g.blocks) do
        assert(not block.term or block.term.kind ~= "invoke", "invoke requires final-core call lowering")
    end
    graph.verify(g)
    local code, starts, patches = {}, {}, {}
    local lengthSlots = {}
    local nparams, counts = g.nparams, g.counts
    local types, slots = g.types, g.slots
    local entryOps = g.blocks[1].op
    for i = 1, #entryOps do
        if entryOps[i] == "SpanLen" then
            lengthSlots[g.blocks[1].args[i][1]] = slots[g.blocks[1].dst[i]]
        end
    end
    -- Value-class registers: the parameters, the boxing scratch, then the
    -- value slots and their copy scratch.
    local valueBase = nparams + 2
    -- The copy scratch is the unused base of the closure window. Captures
    -- follow it, outside every SSA slot, so repeated sources and edge-copy
    -- cycles cannot be overwritten by staging or by the closure result.
    local captureBase, captureCount = valueBase + counts.v, 0
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            if op == "Closure" then
                captureCount = math.max(captureCount, #block.args[at] - 1)
            end
        end
    end
    assert(captureBase + captureCount < 250, "graph register capacity")

    local function physical(v: integer): any
        local ty = types[v]
        if ty == "v" then
            return v <= nparams and v or valueBase + slots[v]
        end

        return slots[v]
    end

    local function scratch(ty: string): integer
        return ty == "v" and valueBase + counts.v or counts[ty]
    end

    local function emit(...: any): integer
        local instruction = {...}
        opcodes.check(instruction)
        code[#code + 1] = instruction
        return #code
    end

    local function jump(target: integer): nil
        patches[#patches + 1] = {at = emit("Jmp", 0), target = target}
    end

    -- Copies for one edge, class by class, in ascending destination order:
    -- a copy whose destination no pending copy still reads goes first, and a
    -- cycle breaks by moving one destination to the class's scratch slot.
    local function copies(e: any, fallthrough: number?): nil
        local targetParams = g.blocks[e.target].params
        local order = {"v", "i", "f", "x"}
        for ci = 1, 4 do
            local ty = order[ci]
            local destinations, sources = {}, {}
            for i = 1, #targetParams do
                local dst, src = targetParams[i], e.args[i]
                if types[dst] == ty then
                    destinations[#destinations + 1] = physical(dst)
                    sources[#sources + 1] = physical(src)
                end
            end
            for _, move in ipairs(graphcopies.schedule(destinations, sources, scratch(ty))) do
                emit(moves[ty], move[1], move[2])
            end
        end
        if e.target ~= fallthrough then
            jump(e.target)
        end
    end

    local positions = g.positions
    local blocks = g.blocks
    for bi = 1, #blocks do
        local b = blocks[bi]
        starts[b.id] = #code + 1
        for i = 1, #b.op do
            local op = b.op[i]
            local sig = parsed[op]
            local argClasses, args = sig.args, b.args[i]
            local ins = {op}
            local argAt = 0
            for j = 1, sig.n + (sig.result ~= "-" and 1 or 0) do
                if j == sig.resultAt then
                    ins[#ins + 1] = physical(b.dst[i])
                else
                    argAt = argAt + 1
                    local letter, arg = argClasses[argAt], args[argAt]
                    if classes[letter] then
                        ins[#ins + 1] = physical(arg)
                    elseif letter == "w" then
                        ins[#ins + 1] = valueBase + arg
                    else
                        ins[#ins + 1] = arg
                    end
                end
            end
            local from = #code + 1
            if op == "Closure" then
                for capture = 2, #args do
                    emit("Move", captureBase + capture - 1, physical(args[capture]))
                end
                emit("NewClosure", physical(b.dst[i]), args[1], captureBase, #args - 1)
            elseif op == "U32Add" or op == "U32Sub" then
                emit(op == "U32Add" and "IAdd" or "ISub", ins[2], ins[3], ins[4])
                emit("IMaskU32", ins[2], ins[2])
            elseif op == "U32Load" or op == "U32Store" then
                local store = op == "U32Store"
                local param, index = ins[store and 2 or 3], ins[store and 3 or 4]
                local one, vector = scratch("i"), scratch("x")
                emit("IK", one, 1)
                emit("SpanBounds", param, index, one, 4, store and 1 or 0)
                if store then
                    emit("VSplatN", vector, ins[4], 4)
                    emit("SpanStore", param, index, vector, one, 4, 0, 1)
                else
                    emit("SpanLoad", vector, param, index, one, 4, 0, 1)
                    emit("VExtractN", ins[2], vector, 4, 0)
                end
            elseif op == "SpanEqual" then
                local flag = scratch("i")
                emit("ICmpNe", flag, assert(lengthSlots[args[1]]), assert(lengthSlots[args[2]]))
                emit("JmpIfIZero", flag, 1)
                emit("Raise", ins[4])
            elseif op == "VSplatI" then
                ins[1] = "VSplatN"
                code[#code + 1] = ins
            elseif op == "VExtractI" then
                ins[1] = "VExtractN"
                code[#code + 1] = ins
            else
                code[#code + 1] = ins
            end
            local pos = b.pos[i]
            if pos ~= 0 then
                local line = positions[pos].line
                for at = from, #code do
                    code[at].line = line
                end
            end
        end
        local t = b.term
        if t.kind == "jump" then
            copies(t.edges[1], b.id + 1)
        elseif t.kind == "branch" then
            local test = types[t.value] == "v" and "JmpIfNot" or "JmpIfIZero"

            local function same(e: any): boolean
                local params = blocks[e.target].params
                for i = 1, #params do
                    if physical(params[i]) ~= physical(e.args[i]) then
                        return false
                    end
                end

                return true
            end

            local identity = same(t.edges[2])
            if types[t.value] == "v"
                and t.edges[1].target ~= b.id + 1
                and t.edges[2].target == b.id + 1
                and identity
                and same(t.edges[1])
            then
                -- The false edge falls through: one jump on the true edge.
                patches[
                    #patches + 1
                ] = {at = emit("JmpIf", physical(t.value), 0), target = t.edges[1].target, field = 3}
            elseif identity then
                patches[#patches + 1] = {at = emit(test, physical(t.value), 0), target = t.edges[2].target, field = 3}
                copies(t.edges[1], b.id + 1)
            else
                local branch = emit(test, physical(t.value), 0)
                copies(t.edges[1])
                code[branch][3] = #code - branch
                copies(t.edges[2], b.id + 1)
            end
        elseif t.kind == "switch" then
            -- Each case lands on its own copies when they are not identity,
            -- laid out after the switch; the table is patched to them.
            local tables = g.tables or {}
            g.tables = tables
            local entry = {at = emit("Switch", physical(t.value), #tables), targets = {}}
            tables[#tables + 1] = entry
            local edges = t.edges
            local trampolines = {}
            for ei = 1, #edges do
                local e = edges[ei]
                local identity = true
                local targetParams = blocks[e.target].params
                for i = 1, #targetParams do
                    identity = identity and physical(targetParams[i]) == physical(e.args[i])
                end
                if identity then
                    entry.targets[ei] = {block = e.target}
                else
                    trampolines[#trampolines + 1] = ei
                    entry.targets[ei] = {code = 0}
                end
            end
            for ti = 1, #trampolines do
                local ei = trampolines[ti]
                entry.targets[ei].code = #code + 1
                copies(edges[ei])
            end
        elseif t.kind == "raise" then
            emit("Raise", t.constant)
        elseif t.kind == "returns" then
            emit("RetN", physical(t.value), t.count)
        elseif t.kind == "park" then
            local v = t.value
            local reg = physical(v)
            if types[v] == "f" then
                reg = nparams + 1
                emit("FBox", reg, physical(v))
            end
            -- The resume entry is the instruction after the park: the edge's
            -- target starts there, or a jump reaches it.
            copies(t.edges[1], t.edges[1].target)
            emit("Park", reg)
            if t.edges[1].target ~= b.id + 1 then
                jump(t.edges[1].target)
            end
        elseif t.value then
            local v = t.value
            if g.ret == "f" then
                if not (types[v] == "f") then
                    error("float-returning function returns another class", 0)
                end
                emit("FRet", physical(v))
            elseif types[v] == "f" then
                emit("FBox", nparams + 1, physical(v))
                emit("Ret", nparams + 1)
            elseif types[v] == "i" then
                emit("IBox", nparams + 1, physical(v))
                emit("Ret", nparams + 1)
            else
                emit("Ret", physical(v))
            end
        else
            emit("RetNil")
        end
    end
    for pi = 1, #patches do
        local p = patches[pi]
        code[p.at][p.field or 2] = starts[p.target] - p.at - 1
    end
    local tables = {}
    if g.tables then
        for ti = 1, #g.tables do
            local entry = g.tables[ti]
            local offsets = {}
            for ei = 1, #entry.targets do
                local target = entry.targets[ei]
                local at = target.block and starts[target.block] or target.code
                offsets[ei] = at - entry.at - 1
            end
            tables[ti] = offsets
        end
        g.tables = nil
    end
    if not (counts.i < 239 and counts.f < 239 and counts.x < 249 and valueBase + counts.v < 250) then
        error("graph register capacity", 0)
    end

    return {
        code = code,
        consts = g.constants,
        tables = tables,
        nregs = valueBase + (counts.v > 0 and counts.v + 1 or 0) + captureCount,
        nfregs = math.max(counts.i, counts.f) + (g.map and 2 or 1),
        nvregs = counts.x + 1,
        graph = g
    }
end

export = graph
