module nupp.compiler.vm.guestprofile

local graph = require("nupp.compiler.vm.graph")
export const booleanKind = "boolean"
local wrappers = {literal = "base", const = "inner"}
local arithmetic = {["+"] = "IAdd", ["-"] = "ISub", ["&"] = "IAnd", ["|"] = "IOr", ["~"] = "IXor"}
local comparisons = {["=="] = "ICmpEq", ["~="] = "ICmpNe", ["<"] = "ICmpSLt", ["<="] = "ICmpSLe"}

local function need(ok: any, message: string, ...: any): any
    if not ok then
        assert(ok, "guest graph: " .. string.format(message, ...))
    end
    return ok
end

export function kind(t: any): string
    while t and wrappers[t.tag] do
        t = t[wrappers[t.tag]]
    end
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            if kind(member) ~= "boolean" then
                return "union"
            end
        end
        return "boolean"
    end
    local exact = t and t.tag or "missing"

    return exact == "integer" and "int64" or exact
end

local function scalar(exact: string): nil
    need(exact == "int64" or exact == "boolean", "unsupported exact kind %s", exact)
end

export function initializeModule(fn: any, options: any): any
    error("guest graph: module initializer execution is not established", 0)
end

export function initialize(fn: any, options: any): any
    local body = fn.body
    need(
        fn.node.kind ~= "inlineMethod"
        and fn.node.kind ~= "constructorDecl"
        and (not fn.node.name or not fn.node.name.method),
        "guest methods and constructors are unsupported"
    )
    need(body and #body.params == 0 and #fn.paramKinds == 0, "initial guest profile requires zero parameters")
    need(not body.varargParam and not body.generics and not body.captureTakes, "plain closed guest function required")
    local result = fn.resultKind == "integer" and "int64" or fn.resultKind
    scalar(result or "missing")
    local g = graph.new(0)
    g.exactTypes = {}
    g.guestResult = result

    return g
end

export function valueKind(g: any, id: integer): string
    return need(g.exactTypes[id], "missing exact value kind")
end

export function newValue(g: any, exact: string): integer
    scalar(exact)
    local id = graph.value(g, "i")
    g.exactTypes[id] = exact
    return id
end

export function localKind(token: any, fn: any): string
    local exact = kind(token.inferredType)
    scalar(exact)
    return exact
end

-- The common lowering owns traversal and binding state. These callbacks only
-- choose ordinary graph operations and evaluate operands in source order.
export function emit(ctx: any, node: any, op: string, args: any, exact: string?): integer?
    if exact then
        scalar(exact)
    end
    local id = graph.emit(ctx.g, ctx.block, op, args, ctx.position(node))
    if id then
        need(exact ~= nil, "operation result requires exact kind")
        ctx.g.exactTypes[id] = exact
    else
        need(exact == nil, "effect cannot have an exact result kind")
    end

    return id
end

local function decimal(node: any, negative: boolean): string
    local text = node.token.text
    need(not text:match("[Uu][Ll][Ll]$"), "unsigned literal is unsupported")
    text = text:gsub("[Ll][Ll]$", "")
    need(text:match("^%d+$"), "exact decimal integer literal required")
    text = text:gsub("^0+", "")
    if text == "" then
        text = "0"
    end
    local bound = negative and "9223372036854775808" or "9223372036854775807"
    need(#text < #bound or #text == #bound and text <= bound, "literal outside signed64 range")

    return negative and text ~= "0" and "-" .. text or text
end

export function literal(ctx: any, node: any, expected: string?): integer
    if node.kind == "number" then
        need(expected == nil or expected == "int64", "integer literal changes exact kind")
        local exact = kind(node.inferredType)
        need(exact == "integer" or exact == "int64" or exact == "number", "unsupported literal kind %s", exact)
        return ctx.emit(node, "IK", {decimal(node, false)}, "int64")
    end
    need(
        node.kind == "true" or node.kind == "false" or node.kind == "trueExpr" or node.kind == "falseExpr",
        "unsupported literal"
    )
    need(expected == nil or expected == "boolean", "boolean literal changes exact kind")
    local value = (node.kind == "true" or node.kind == "trueExpr") and "1" or "0"

    return ctx.emit(node, "IK", {value}, "boolean")
end

export function constant(ctx: any, node: any, expected: string?): integer
    local catalog = ctx.options.program
    local definition = node.kind == "name" and node.token.definition or nil
    local constant = catalog and definition and catalog.immutable[definition]
    need(constant ~= nil, "reference requires a checked immutable module scalar constant")
    need(
        constant.kind == "int64" or constant.kind == "true" or constant.kind == "false",
        "unsupported module constant kind"
    )
    local scalarKind = constant.kind == "int64" and "int64" or "boolean"
    need(expected == nil or expected == scalarKind, "module constant changes exact kind")
    if constant.kind == "int64" then
        -- The initial profile admits signed decimal scalars only. Use its exact
        -- lexical range check even though the wider catalog can retain hex.
        local source = constant.node
        while source.kind == "paren" do
            source = source.expr
        end
        local negative = source.kind == "unop"
        return ctx.emit(node, "IK", {decimal(negative and source.operand or source, negative)}, scalarKind)
    end

    return ctx.emit(node, "IK", {constant.kind == "true" and "1" or "0"}, scalarKind)
end

export function unary(ctx: any, node: any, expected: string?): integer
    local operator = node.op.text
    local exact = operator == "not" and "boolean" or "int64"
    need(expected == nil or expected == exact, "unary expression changes exact kind")
    need(kind(node.inferredType) == exact, "unsupported unary result kind")
    if operator == "-" and node.operand.kind == "number" then
        need(kind(node.operand.inferredType) ~= "uint64", "unsigned negation is unsupported")
        return ctx.emit(node, "IK", {decimal(node.operand, true)}, "int64")
    end
    need(operator == "-" or operator == "~" or operator == "not", "unsupported unary operator %s", operator)
    local value = ctx.expression(node.operand, exact)
    if operator == "~" then
        return ctx.emit(node, "INot", {value}, "int64")
    end
    local zero = ctx.emit(node, "IK", {"0"}, exact)

    return ctx.emit(
        node,
        operator == "not" and "ICmpEq" or "ISub",
        operator == "not" and {value, zero} or {zero, value},
        exact
    )
end

export function binary(ctx: any, node: any, expected: string?): integer
    local operator = node.op.text
    local comparison = comparisons[operator] or operator == ">" or operator == ">="
    if comparison then
        need(expected == nil or expected == "boolean", "comparison produces a boolean")
        local exact = kind(node.lhs.inferredType)
        scalar(exact)
        need(exact == "int64" or operator == "==" or operator == "~=", "ordered boolean comparison is unsupported")
        local operands = ctx.operands({node.lhs, node.rhs}, {exact, exact})
        local left, right = operands[1], operands[2]
        local operation = comparisons[operator]
        if operator == ">" or operator == ">=" then
            operation = operator == ">" and "ICmpSLt" or "ICmpSLe"
            left, right = right, left
        end
        return ctx.emit(node, operation, {left, right}, "boolean")
    end
    need(expected == nil or expected == "int64", "integer operation changes exact kind")
    need(kind(node.inferredType) == "int64", "unsupported binary result kind")
    local operation = need(arithmetic[operator], "unsupported integer operator %s", operator)
    local operands = ctx.operands({node.lhs, node.rhs}, {"int64", "int64"})
    local left, right = operands[1], operands[2]

    return ctx.emit(node, operation, {left, right}, "int64")
end

export function call(ctx: any, node: any, expected: string?): integer
    error("guest graph: calls are outside the initial profile", 0)
end

export function statementCall(ctx: any, site: any): nil
    error("guest graph: statement calls are outside the initial profile", 0)
end

export function returnStatement(ctx: any, stat: any): nil
    need(#stat.exprs == 1, "exactly one scalar return required")
    local exact = ctx.g.guestResult
    local value = ctx.expression(stat.exprs[1], exact)
    if exact == "boolean" then
        value = ctx.emit(stat, "BoolFromI", {value}, "boolean")
    end
    ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
    ctx.block = nil
end
