local byName: {[string]: Text} = {}

-- Every id is one text's, and every name one id's.
do
    local taken: {[integer]: string} = {}
    for _, entry in ipairs(texts) do
        assert(entry.id >= 1, "core text id out of range: " .. entry.name)
        assert(taken[entry.id] == nil, "core text id " .. entry.id .. " taken twice: " .. entry.name)
        assert(byName[entry.name] == nil, "core text named twice: " .. entry.name)
        assert(entry.name:match("^TEXT_") or entry.name:match("^NAME_"), "core text name prefix: " .. entry.name)
        assert(#entry.text > 0, "empty core text: " .. entry.name)
        taken[entry.id] = entry.name
        byName[entry.name] = entry
    end
end

-- A text's id, by its name; an unknown name is an error.
export function id(name: string): integer
    return assert(byName[name], "no core text " .. name).id
end

-- A copy of the texts, for the generator.
export function all(): {Text}
    local result = {}
    for index, entry in ipairs(texts) do
        result[index] = {name = entry.name, id = entry.id, text = entry.text}
    end

    return result
end
