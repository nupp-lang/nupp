module nupp.compiler.vm.lower

--- Bytecode lowering and image writing from checked syntax. Project loading
--- is supplied by the caller.
local lower = {}

--- When set, called once per emission with the entry name, the functions in
--- image order (each with its code, constants and register counts) and the
--- header the image carries beside them, for the graph conversion.
const lowerstate = require("nupp.compiler.vm.lowerstate")

const {type Fn} = require("nupp.compiler.vm.lowerstate")
lower.graphSink = nil as function(entry: string, functions: {Fn}, header: table)?

--- When set, maps each module's source path before the image records it: a
--- program image names paths relative to the project or the compiler.
lower.pathMapper = nil as(function(path: string): string?)?

const graphemit = require("nupp.compiler.vm.graphemit")
const nodeLine = lowerstate.nodeLine
const SPILL_AT = lowerstate.SPILL_AT

--- What a coverage build asks of the lowering: `path` names the file a module's
--- hits are filed under, or nil for a module left uninstrumented, and `manifests`
--- receives each instrumented module's sites by module name.
type lower.CoverageRequest = {
    path: function(name: string, source: string): string?,
    manifests: {[string]: any}
}

--- The module an instrumented image carries for its counters. It installs the
--- recorder the Lua generator writes into each instrumented file, once, into
--- `_G.__nuppCoverage`, shared by every module and image in the process, and
--- answers the table one file's counts are kept in. An instrumented function
--- asks for that table once on entry and counts in it directly: a call per
--- statement made a covered run on the interpreter twelve times slower.
const COVERAGE_RUNTIME = "nupp.runtime.coveragecounter"

const COVERAGE_RUNTIME_SOURCE = [[
local function install()
    local c = _G.__nuppCoverage
    if not c then
        c = {hits = {}}
        function c.hit(p, i)
            local f = c.hits[p] or {}
            c.hits[p] = f
            local k = tostring(i)
            f[k] = (f[k] or 0) + 1
        end
        function c.branch(p, i, v)
            local f = c.hits[p] or {}
            c.hits[p] = f
            local k = tostring(i) .. (v and ":true" or ":false")
            f[k] = (f[k] or 0) + 1
            return v
        end
        _G.__nuppCoverage = c
    end
    return c
end
install()
local function counters(p)
    local hits = install().hits
    local f = hits[p]
    if not f then
        f = {}
        hits[p] = f
    end
    return f
end
return {counters = counters}
]]

--- Emit the module graph rooted at `entryName`, including explicitly named
--- dynamic dependencies. `resolve` returns a source path or nil for a host
--- module; `check` returns the checked syntax tree for that path. Each call
--- owns its shapes, functions, capture analysis and output buffers.
---
--- `coverage` instruments the modules it names with the sites
--- `nupp.compiler.coverage` numbers. Without it nothing about the image changes.
function lower.emit(
    entryName: string,
    extras: {string},
    resolve: function(name: string, soft: boolean?): string?,
    check: function(name: string, path: string): table,
    environment: boolean?,
    listing: table?,
    layoutTarget: string?,
    coverage: lower.CoverageRequest?,
    reuse: table?,
    functionsOut: table?
): string
    local assignedNames = {}
    -- Names the module ever assigns a `%` or `//` result, by name: a zero
    -- divisor makes those nan or an infinity whatever the checker says, which
    -- an integer register cannot hold.
    local SURVEY = {}
    local SURVEY_EXAMPLE = {}

    local function tokText(tok): string
        return tok.value ~= nil and tok.value or tok.text
    end

    local function tyTag(t)
        return type(t) == "table" and t.tag or "?"
    end

    local function simdType(t)
        while type(t) == "table" and t.inner do
            t = t.inner
        end
        if tyTag(t) == "union" then
            for _, member in ipairs(t.members or {}) do
                local found = simdType(member)
                if found then
                    return found
                end
            end
        end
        if tyTag(t) ~= "nominal" then
            return nil
        end
        local origin = t.origin or t
        if origin.moduleName ~= "nupp.simd" and origin.sealedModule ~= "nupp.simd" then
            return nil
        end
        local family = origin.name
        if family ~= "Species" and family ~= "Vector" and family ~= "Mask" then
            return nil
        end
        local element = (t.typeArgs or {})[1]
        while type(element) == "table" and element.inner do
            element = element.inner
        end
        assert(element and element.tag, "SIMD element is unresolved")

        return {family = family, element = element.tag}
    end

    -- Shapes ---------------------------------------------------------------------
    -- A shape is keyed by its record's nominal type, which is one object per
    -- declaration across the module graph; two modules may each declare an
    -- `Error`. `shapes` maps the bare name to the shapes declared under it,
    -- the current module's first, for the syntax that names a record bare
    -- (`function R:m()`, `x is R`).
    local shapes, shapeOrder = {}, {}
    local shapesByNominal = setmetatable({}, {__mode = "k"})
    -- Reusing modules lowered by an earlier emit (`nupp.compiler.vm.relink`):
    -- the shape registry is read and written through its recording proxies.
    local linker = reuse and require("nupp.compiler.vm.relink").new(reuse) or nil
    if linker then
        shapes, shapesByNominal = linker.watch(shapes, shapesByNominal, shapeOrder)
    end
    local currentModule = nil
    local nativePlans = {}

    local function shapeOfNominal(t)
        if type(t) ~= "table" then
            return nil
        end
        local s = shapesByNominal[t]
        if s then
            return s
        end
        if t.declarationKey and shapesByNominal[t.declarationKey] then
            return shapesByNominal[t.declarationKey]
        end
        if t.origin and t.origin ~= t then
            return shapeOfNominal(t.origin)
        end

        return nil
    end

    local function shapeByBareName(name)
        local list = shapes[name]
        if not list then
            return nil
        end
        for _, s in ipairs(list) do
            if s.module == currentModule then
                return s
            end
        end

        return list[1]
    end

    local foreignShape

    local function slotTy(t)
        local tag = tyTag(t)
        if tag == "number"
            or tag == "int64"
            or tag == "uint64"
            or tag == "float64"
            or tag == "float32"
            or tag == "int8"
            or tag == "uint8"
            or tag == "int16"
            or tag == "uint16"
            or tag == "int32"
            or tag == "uint32"
        then
            return "num"
        end
        if tag == "string" then
            return "str"
        elseif tag == "boolean" then
            return "bool"
        elseif tag == "nominal" then
            local shape = shapeOfNominal(t) or foreignShape(t)
            if shape and shape.id and not shape.physical then
                return "rec:" .. shape.id
            end
        elseif tag == "literal" then
            return slotTy(t.base)
        end

        return "any"
    end

    -- A member a supertype contributes that may hold nil gets no slot: it lives
    -- in the record's overflow part, allocated when the first such member is
    -- written. `cst.Hints` gives every syntax node some two hundred optional
    -- checker hints, and as slots they made each node about 1.8 KB of nils the
    -- collector scanned and swept; a node now costs its own fields. Reads and
    -- writes go by name, through the overflow probe.
    local function inheritedInOverflow(t)
        local tag = tyTag(t)
        return tag == "any" or tag == "unknown" or tag == "nil" or (tag == "union" and t.hasNil == true)
    end

    local function declareShape(node)
        -- An interface has no runtime identity: no shape, erased casts, field access by
        -- name. Nor does an annotation schema, which exists only for the checker.
        if node.declKind == "interface" or node.isAnnotationDefinition then
            return nil
        end
        local name = tokText(node.name)
        local nominal = node.resolvedType
        if nominal and shapeOfNominal(nominal) then
            return shapeOfNominal(nominal)
        end
        if not nominal then
            -- A record the checker gave no type (a declaration inside a function
            -- it did not reach): one shape per bare name is all there is.
            local known = shapes[name] and shapes[name][1]
            if known then
                return known
            end
        end
        local shape = {id = #shapeOrder, name = name, slots = {}, slotIndex = {}, node = node, module = currentModule}
        if node.declKind == "struct" or node.kind == "cdefStruct" then
            shape.physical = true
            shape.layout = require("nupp.compiler.vm.metadata").structLayout(node, layoutTarget)
        end
        shapes[name] = shapes[name] or {}
        table.insert(shapes[name], shape)
        if nominal then
            shapesByNominal[nominal] = shape;
            if nominal.declarationKey then
                shapesByNominal[nominal.declarationKey] = shape
            end
        end
        shapeOrder[#shapeOrder + 1] = shape
        local methods = {}
        for _, entry in ipairs(node.entries) do
            if entry.kind == "fieldDecl" then
                local fname = tokText(entry.name)
                shape.slotIndex[fname] = #shape.slots
                shape.slots[
                    #shape.slots + 1
                ] = {name = fname, ty = slotTy(nominal and nominal.byname and nominal.byname[fname])}
            elseif entry.kind == "inlineMethod" then
                methods[tokText(entry.name)] = true
            end
        end
        -- The members a supertype contributes (`record R is Hints`), which the
        -- checker folded into the nominal type: slots after the declared ones.
        if nominal and type(nominal.byname) == "table" then
            local inherited = {}
            for fname in pairs(nominal.byname) do
                if type(fname) == "string"
                    and shape.slotIndex[fname] == nil
                    and not methods[fname]
                    and (shape.physical or not inheritedInOverflow(nominal.byname[fname]))
                then
                    inherited[#inherited + 1] = fname
                end
            end
            table.sort(inherited)
            for _, fname in ipairs(inherited) do
                shape.slotIndex[fname] = #shape.slots
                shape.slots[#shape.slots + 1] = {name = fname, ty = slotTy(nominal.byname[fname])}
            end
        end

        return shape
    end

    -- A table constructor the checker types as a closed set of named fields gets
    -- a shape of its own, shared by every constructor with the same field set:
    -- the plan's structural object, slots by offset at the constructor and
    -- by name, through a per-site cache, everywhere it is read.
    local function structShape(ty)
        if tyTag(ty) ~= "shape" or type(ty.fields) ~= "table" or #ty.fields == 0 then
            return nil
        end
        local names = {}
        for i, field in ipairs(ty.fields) do
            names[i] = type(field) == "table" and field.name or tostring(field)
        end
        local name = "struct:" .. table.concat(names, ",")
        if shapes[name] then
            return shapes[name]
        end
        local shape = {id = #shapeOrder, name = name, slots = {}, slotIndex = {}}
        shapes[name] = shape
        shapeOrder[#shapeOrder + 1] = shape
        for _, fname in ipairs(names) do
            shape.slotIndex[fname] = #shape.slots
            -- Untyped slots: a constructor's field type is inferred from its first
            -- value, and `x and y or nil` is typed without the nil, so a numeric
            -- slot here would refuse a nil the program means to store.
            shape.slots[#shape.slots + 1] = {name = fname, ty = "any"}
        end

        return shape
    end

    -- A record another image declares: its shape is rebuilt from the checked
    -- type in the order `declareShape` gives it, under the same identity, so
    -- the loader resolves both images to one shape and one method table.
    -- The module a nominal type was declared in, which a type restored from
    -- another module's interface keeps only in its runtime declaration key.
    -- The key separates its parts with NUL, and a declaration with no module
    -- (`<chunk>`) has no identity to share.
    local function declaringModule(t)
        local owner = t.moduleName
            or type(t.runtimeDeclarationKey) == "string" and t.runtimeDeclarationKey:match("^([^%z]+)")
            or nil
        if owner and owner:find("^[%w_.]+$") then
            return owner
        end

        return nil
    end

    foreignShape = function(t)
        local owner = declaringModule(t)
        if (t.declKind ~= "record" and t.declKind ~= "struct")
            or type(t.fieldOrder) ~= "table"
            or not owner
            or owner == currentModule
        then
            return nil
        end
        local name = (t.name or ""):match("([%w_]+)$") or ""
        -- Registered before its slots (a record may hold itself) but numbered
        -- after them, so a slot never names a shape the image declares later.
        local shape = {name = name, slots = {}, slotIndex = {}, module = owner}
        if t.declKind == "struct" then
            -- Laid out from its type, as its own module lays out its declaration.
            shape.physical = true
            shape.node = {resolvedType = t}
            shape.layout = require(
                "nupp.compiler.vm.metadata"
            ).structLayout({resolvedType = t, name = {text = name}}, layoutTarget)
        end
        shapesByNominal[t] = shape
        if t.declarationKey then
            shapesByNominal[t.declarationKey] = shape
        end
        local byname = type(t.byname) == "table" and t.byname or {}
        local methods = type(t.methodEntries) == "table" and t.methodEntries or {}
        for _, fname in ipairs(t.fieldOrder) do
            shape.slotIndex[fname] = #shape.slots
            shape.slots[#shape.slots + 1] = {name = fname, ty = slotTy(byname[fname])}
        end
        local inherited = {}
        for fname in pairs(byname) do
            if type(fname) == "string"
                and shape.slotIndex[fname] == nil
                and methods[fname] == nil
                and (shape.physical or not inheritedInOverflow(byname[fname]))
            then
                inherited[#inherited + 1] = fname
            end
        end
        table.sort(inherited)
        for _, fname in ipairs(inherited) do
            shape.slotIndex[fname] = #shape.slots
            shape.slots[#shape.slots + 1] = {name = fname, ty = slotTy(byname[fname])}
        end
        shape.id = #shapeOrder
        shapes[name] = shapes[name] or {}
        table.insert(shapes[name], shape)
        shapeOrder[#shapeOrder + 1] = shape

        return shape
    end

    local function shapeOf(ty)
        -- An ownership qualifier wraps the type it qualifies.
        while type(ty) == "table" and (ty.tag == "borrowed" or ty.tag == "affine" or ty.tag == "owned") and ty.inner do
            ty = ty.inner
        end
        if tyTag(ty) == "nominal" then
            if ty.declKind == "interface" then
                return nil
            end
            local bare = shapeByBareName((ty.name or ""):match("([%w_]+)$") or "")
            -- A bare name settles only within the type's own module: another
            -- module's record of the same name is a different shape.
            local owner = declaringModule(ty)
            if bare and owner and bare.module ~= owner then
                bare = nil
            end
            return shapeOfNominal(ty) or bare or foreignShape(ty)
        end
    end

    local PHYSICAL_SCALARS = {
        boolean = 0,
        int8 = 1,
        uint8 = 2,
        int16 = 3,
        uint16 = 4,
        integer = 5,
        int32 = 5,
        uint32 = 6,
        int64 = 7,
        uint64 = 8,
        float32 = 9,
        float64 = 10,
        number = 10
    }

    local function physicalField(shape, name)
        local layout = shape and shape.physical and shape.layout
        if not layout or not layout.supported then
            return nil
        end
        for ordinal, field in ipairs(layout.fields) do
            -- A bitfield is part of its storage unit, which the dynamic field
            -- operation masks and shifts; only whole scalars are physical.
            local kind = not field.bitWidth and PHYSICAL_SCALARS[field.kind] or nil
            if field.name == name and kind ~= nil then
                return {
                    identity = layout.identity,
                    name = name,
                    ordinal = ordinal - 1,
                    offset = field.offset,
                    kind = kind
                }
            end
        end

        return nil
    end

    local function physicalSet(f: Fn, object, field, value)
        f:op(
            "SetPhys",
            object,
            f:const("str", field.identity),
            f:const("str", field.name),
            field.ordinal,
            field.offset,
            field.kind,
            value
        )
    end

    -- Functions --------------------------------------------------------------------
    local functions: {Fn} = {}

    local function newFn(name: string, parent: Fn?): Fn
        local f = new lowerstate.Fn(
            id = #functions,
            name = name,
            module = currentModule,
            parent = parent,
            environment = environment == true
        )
        functions[#functions + 1] = f

        return f
    end

    -- Coverage ---------------------------------------------------------------------
    -- The sites of the module being lowered, when it is instrumented. A function
    -- of such a module holds its file's counts table in a register it loads on
    -- entry, and a site adds one to its key there, the key the Lua generator's
    -- recorder uses: the site's number, and for a branch the outcome after it.
    local covered = nil

    -- The register holding the counts table, taken before the body is lowered so
    -- nothing the body does reuses it. Its load is put in front of the function
    -- once the body is lowered, as the capture loads are, and only when a site
    -- asked for it.
    local function reserveCoverageCounts(f: Fn)
        if covered then
            local r = f:reg()
            f.declTop = math.max(f.declTop or 0, r + 1)
            f.coverageCounts = r
        end
    end

    local function coverageCounts(f: Fn)
        f.coverageUsed = true

        return assert(f.coverageCounts, "coverage counted outside an instrumented function")
    end

    local function count(f: Fn, key)
        local counts = coverageCounts(f)
        local mark = f.nregs
        local n, one = f:reg(), f:reg()
        local name = f:const("str", key)
        f:op("GetField", n, counts, name)
        local present = f:label()
        f:branch("JmpIf", n, present)
        f:op("K", n, f:const("num", 0))
        f:place(present)
        f:op("K", one, f:const("num", 1))
        f:op("Add", n, n, one)
        f:op("SetField", counts, name, n)
        f.nregs = mark
    end

    -- Loads the counts table on entry, once the body has asked for it.
    local function loadCoverageCounts(f: Fn)
        if not f.coverageUsed then
            return
        end
        local callee, base, path = f:reg(), f:reg(), f:reg()
        local entry = f:entry().code
        local line = entry[1] and entry[1].line
        local prologue: {
            table
        } = {
            {"Require", callee, f:const("str", COVERAGE_RUNTIME)},
            {"GetField", callee, callee, f:const("str", "counters")},
            {"K", path, f:const("str", covered.manifest.path)},
            {"CallDyn", callee, base, 1},
            {"Move", f.coverageCounts, base},
        }
        for i = #prologue, 1, -1 do
            prologue[i].line = line
            table.insert(entry, 1, prologue[i])
        end
    end

    local function coverStatement(f: Fn, node)
        local id = covered and covered.statements[node]
        if id then
            f.curLine = nodeLine(node) or f.curLine
            count(f, tostring(id))
        end
    end

    -- Counts the outcome `value` took, by Lua truthiness.
    local function coverBranch(f: Fn, node, value)
        local id = covered and covered.branches[node]
        if id then
            local falseCase, done = f:label(), f:label()
            f:branch("JmpIfNot", value, falseCase)
            count(f, id .. ":true")
            f:jump(done)
            f:place(falseCase)
            count(f, id .. ":false")
            f:place(done)
        end
    end

    local BUILTINS = {}
    for _, n in ipairs({
        "pairs",
        "ipairs",
        "next",
        "type",
        "tostring",
        "tonumber",
        "error",
        "assert",
        "select",
        "print",
        "rawequal",
        "rawget",
        "rawset",
        "setmetatable",
        "getmetatable",
        "unpack"
    }) do
        BUILTINS[n] = true
    end
    -- Only implemented library functions can become builtin constants. Other
    -- members remain runtime lookups, including optional host facilities. The
    -- `os` and `io` members are host effects, never hot, and replacing one is
    -- how a program substitutes its environment, so those are looked up when
    -- called, as Lua does.
    for name in (
        "string.byte string.sub string.find string.char string.rep string.format "
        .. "string.gsub string.gmatch string.len string.upper string.lower string.match string.reverse "
        .. "table.concat table.insert table.remove table.unpack table.sort "
        .. "math.floor math.min math.max math.abs math.ceil math.sqrt math.log math.fmod math.modf math.frexp "
        .. "bit.band bit.bor bit.bxor bit.bnot bit.lshift bit.rshift bit.arshift bit.tobit bit.rol bit.ror bit.bswap bit.tohex"
    ):gmatch("%S+") do
        BUILTINS[name] = true
    end
    local LIBS = {string = true, table = true, math = true, bit = true, os = true, io = true}
    local BITOPS = {["&"] = "IAnd", ["|"] = "IOr", ["~"] = "IXor", ["<<"] = "IShl", [">>"] = "IShrU"}
    -- The customary spellings the language accepts beside Lua's own.
    local OPERATOR_SPELLINGS = {["&&"] = "and", ["||"] = "or", ["!="] = "~=", ["!"] = "not"}
    -- Global tables the runtime provides as modules.
    local GLOBAL_MODULES = {
        _G = true,
        package = true,
        os = true,
        io = true,
        bit = true,
        debug = true,
        math = true,
        string = true,
        table = true
    }

    local function isNumeric(t)
        local tag = tyTag(t)
        if tag == "float64" or tag == "float32" then
            return true
        end
        if tag == "literal" then
            return isNumeric(t.base)
        end

        return false
    end

    local function isInteger(t)
        local tag = tyTag(t)
        if tag == "integer" or tag == "int64" then
            return true
        elseif tag == "literal" then
            return isInteger(t.base)
        end

        return false
    end

    local function wideKind(t)
        if tyTag(t) == "literal" then
            return wideKind(t.base)
        end
        local tag = tyTag(t)

        return tag == "int64" and "i64" or tag == "uint64" and "u64" or nil
    end

    local function unsignedProducer(node)
        if node.kind == "paren" then
            return unsignedProducer(node.expr)
        end
        if wideKind(node.inferredType) ~= "u64" then
            return false
        end
        if node.kind == "number" then
            return true
        end
        if node.kind == "unop" then
            return tokText(node.op) == "-" or tokText(node.op) == "~"
        end
        if node.kind == "binop" then
            local op = tokText(node.op)
            return op == "+"
                or op == "-"
                or op == "*"
                or op == "/"
                or op == "//"
                or op == "%"
                or op == "^"
                or op == "&"
                or op == "|"
                or op == "~"
                or op == "<<"
                or op == ">>"
                or op == "~>>"
        end

        return false
    end

    -- Whether a value's numeric type is the checker's approximation for
    -- arithmetic that reached an `any` operand rather than a proof.
    local function untrustedValue(n)
        if n.kind == "paren" then
            return untrustedValue(n.expr)
        end

        return n.primitiveUntrusted == true
    end

    local function isIntegerish(n)
        if n.kind == "paren" then
            return isIntegerish(n.expr)
        end
        if n.kind == "number" then
            local text = tokText(n.token);
            local v = tonumber(text);
            return v ~= nil and v == math.floor(v) and not text:find("[%.eE]") and not text:find("^0[xX]")
        end

        return isInteger(n.inferredType)
    end

    local function coerce(f: Fn, reg, class, want, dst)
        if class == want then
            if dst and dst ~= reg then
                f:op(want == "f" and "FMov" or (want == "i" or want == "u") and "IMov" or "Move", dst, reg)
                return dst
            end
            return reg
        end
        if want == "v" then
            dst = dst or f:reg()
            if class == "i" or class == "u" then
                f:op(class == "u" and "UBox" or "IBox", dst, reg)
            else
                f:op("FBox", dst, reg)
            end
            return dst
        end
        if class == "u" or want == "u" then
            -- Signedness belongs to the typed register, not to its bit pattern.
            -- Cross-class conversions pass through the exact value boundary.
            dst = dst or f:freg()
            local value = reg
            if class ~= "v" then
                value = f:reg()
                f:op(class == "u" and "UBox" or class == "i" and "IBox" or "FBox", value, reg)
            end
            f:op(want == "u" and "UUnbox" or want == "i" and "IUnbox" or "FUnbox", dst, value)
            return dst
        end
        if want == "f" then
            dst = dst or f:freg()
            if class == "i" then
                f:op("IToF", dst, reg)
            else
                f:op("FUnbox", dst, reg)
            end
            return dst
        end
        dst = dst or f:freg()
        if class == "f" then
            f:op("FToI", dst, reg)
        else
            f:op("IUnbox", dst, reg)
        end

        return dst
    end

    local expr, block, stmt, stmtReclaim, defineFunction, markCaptures, callInto, emitClosure, emitIs, openSpill, emitCall, emitSafeCall, deferCleanup, rearmCleanup, registerCleanups
    local queueModule
    -- Expression kinds that write their destination only after every read of
    -- their operands, so the destination may be a register the operands name.
    -- A table constructor writes first and then reads its fields; `and`, `or`,
    -- `??` and the concatenation accumulator write before later operands.
    local DST_SAFE = {
        call = true,
        methodCall = true,
        dotIndex = true,
        bracketIndex = true,
        number = true,
        string = true,
        trueExpr = true,
        falseExpr = true,
        ["nil"] = true,
        nilExpr = true,
        unop = true,
        name = true,
        funcExpr = true,
        shortfn = true,
        castExpr = true
    }

    local function dstSafe(node)
        while node.kind == "paren" do
            node = node.expr
        end
        if node.kind == "binop" then
            local op = tokText(node.op);
            return op ~= "and" and op ~= "or" and op ~= "??" and op ~= ".."
        end

        return DST_SAFE[node.kind] == true
    end

    local function exprAs(f: Fn, node, want, dst)
        local pass = (want == "v" and dst and dstSafe(node)) and dst or nil
        local r, c = expr(f, node, pass, want)
        return coerce(f, r, c, want, dst)
    end

    -- Indexing accepts the value a producer actually answered, including nil
    -- from an open result pack. Its inferred element type does not establish
    -- an integer or float register. Numeric literals establish their own value.
    local function indexOperand(f: Fn, node)
        local literal = node
        while literal.kind == "paren" do
            literal = literal.expr
        end
        if literal.kind == "number"
            and isNumeric(literal.inferredType)
            and not wideKind(node.inferredType)
            and not wideKind(literal.inferredType)
            and not node.wideIntegerLiteralTag
            and not literal.wideIntegerLiteralTag
        then
            local class = isIntegerish(literal) and "i" or "f"
            return exprAs(f, node, class), class
        end
        local reg, class = expr(f, node)
        if class == "i" or class == "f" then
            return reg, class
        end

        return coerce(f, reg, class, "v"), "v"
    end

    -- Emits a condition and the branch to `otherwise` taken when it is false:
    -- a typed comparison branches on its integer register, anything else on
    -- its value.
    local function condBranch(f: Fn, node, site, otherwise: lowerstate.Block): nil
        if covered and site and covered.branches[site] then
            -- Counted on the value Lua truthiness reads, as the generator's probe
            -- counts it, so a typed comparison is not tested in its register.
            local v = exprAs(f, node, "v")
            coverBranch(f, site, v)
            f:branch("JmpIfNot", v, otherwise)
            return
        end
        local r, c = expr(f, node, nil, "cond")
        if c == "b" then
            f:branch("JmpIfIZero", r, otherwise)
            return
        end
        f:branch("JmpIfNot", coerce(f, r, c, "v"), otherwise)
    end

    -- Whether an expression's natural home is a value register (or a number
    -- literal), so arithmetic and comparison on it stay in the value domain
    -- rather than unboxing into the typed files and boxing the result back.
    local function valueDomain(f: Fn, node)
        local k = node.kind
        if k == "paren" then
            return valueDomain(f, node.expr)
        end
        if k == "number" or k == "string" or k == "call" or k == "methodCall" or k == "bracketIndex" then
            return true
        end
        if k == "name" then
            local r, c, cell = f:lookup(tokText(node.token))
            if r then
                return cell or c == "v"
            end
            return true
        elseif k == "dotIndex" then
            local shape = shapeOf(node.obj.inferredType)
            local fname = tokText(node.name)
            return not (
                shape
                and shape.slotIndex[fname]
                and shape.slots[shape.slotIndex[fname] + 1].ty == "num"
                and isNumeric(node.inferredType)
            )
        elseif k == "binop" then
            return valueDomain(f, node.lhs) and valueDomain(f, node.rhs)
        elseif k == "unop" then
            return valueDomain(f, node.operand)
        end

        return false
    end

    -- A cast to a record whose operand is a table constructor of named fields,
    -- bare or through `setmetatable`: the shape, the constructor, and the
    -- metatable expression to evaluate for its effects (or nil).
    local function recordConstructorCast(f: Fn, node)
        local shape = shapeOf(node.inferredType)
        if not shape or shape.physical or shape.name:sub(1, 7) == "struct:" then
            return nil
        end
        local e = node.expr
        while e and e.kind == "paren" and e.expr do
            e = e.expr
        end
        local tbl, meta
        if e and e.kind == "tableExpr" then
            tbl = e
        elseif e
            and e.kind == "call"
            and e.obj.kind == "name"
            and tokText(e.obj.token) == "setmetatable"
            and not f:binding("setmetatable")
        then
            local args = e.args and e.args.exprs or {}
            if args[1] and args[1].kind == "tableExpr" then
                tbl = args[1];
                meta = args[2]
            end
        end
        if not tbl then
            return nil
        end
        for _, field in ipairs(tbl.fields) do
            if field.kind ~= "fieldNamed" then
                return nil
            end
        end

        return shape, tbl, meta
    end

    -- `builtins::SCALAR_OPS`, by kind.
    local SCALAR_KIND = {}
    for i, n in ipairs({
        "u32.wrap",
        "u32.add",
        "u32.sub",
        "u32.andBits",
        "u32.orBits",
        "u32.xorBits",
        "u32.shiftLeft",
        "u32.shiftRightLogical",
        "u32.fromI32",
        "u32.toI32",
        "i32.wrap",
        "i32.add",
        "i32.sub",
        "i32.andBits",
        "i32.orBits",
        "i32.xorBits",
        "i32.fromU32",
        "i32.toU32",
        "u32.mul",
        "i32.mul",
        "u32.notBits",
        "i32.notBits",
        "u32.rotateLeft",
        "u32.rotateRight",
        "i32.shiftRightArithmetic"
    }) do
        SCALAR_KIND[n] = i - 1
    end
    -- `int32` bit operators by the `Scalar` kinds that compute them.
    local INT32_BITS: {
        [string]: {string}
    } = {
        ["&"] = {"i32.andBits"},
        ["|"] = {"i32.orBits"},
        ["~"] = {"i32.xorBits"},
        ["<<"] = {"u32.shiftLeft", "u32.toI32"},
        [">>"] = {"u32.shiftRightLogical", "u32.toI32"},
        ["~>>"] = {"i32.shiftRightArithmetic"},
    }
    local INT32_UNARY_BITS: {[string]: {string}} = {["~"] = {"i32.notBits"}}
    local IS_TYPE = {
        string = "string",
        number = "number",
        boolean = "boolean",
        table = "table",
        thread = "thread",
        userdata = "userdata",
        integer = "number",
        float32 = "number",
        float64 = "number",
        int64 = "number",
        uint64 = "number",
        ["function"] = "function"
    }

    local function builtinRegisters(f: Fn, name, values, dst)
        dst = dst or f:reg()
        local callee, base = f:reg(), f:reg()
        for _ = 1, #values do
            f:reg()
        end
        f:op("K", callee, f:const("builtin", name))
        for index, value in ipairs(values) do
            f:op("Move", base + index, value)
        end
        f:op("CallDyn", callee, base, #values)
        f:op("Move", dst, base)

        return dst
    end

    local function structDescriptor(witness)
        return {kind = "dotIndex", obj = witness, name = {text = "\0nupp:structType"}}
    end

    local function inlineImplicitSelf(entry)
        local first = entry.body and entry.body.params and entry.body.params[1]
        return not entry.inlineStatic and not (first and first.name and first.name.text == "self")
    end

    local function shapeTest(f: Fn, shape, value, dst)
        if shape.physical then
            local identity = f:reg()
            f:op(
                "K",
                identity,
                f:const("str", shape.node.resolvedType.runtimeDeclarationKey or shape.node.resolvedType.cdefIdentity)
            )
            builtinRegisters(f, "storage.structIs", {value, identity}, dst)
        else
            f:op("IsRec", dst, value, shape.id)
        end
    end

    -- `x is T`, as the Lua backend decides it: settled by the checker, a nil
    -- test, or a `type()` comparison for a primitive.
    emitIs = function(f: Fn, node, dst)
        dst = dst or f:reg()
        local t = node.type
        -- The record a test names, seen through an ownership wrapper (a Closeable
        -- record resolves to one) and declared here or in another image.
        local targetShape = not node.provenStatically and not node.refutedStatically and shapeOf(node.typeTestTarget)
            or nil

        local function typeTest(prim)
            local call = {
                kind = "call",
                obj = {kind = "name", token = {text = "type"}, inferredType = {tag = "any"}},
                args = {exprs = {node.expr}},
                inferredType = {tag = "string"}
            }
            local tv = exprAs(f, call, "v")
            local kv = f:reg();
            f:op("K", kv, f:const("str", prim))
            f:op("Eq", dst, tv, kv)
        end

        if node.provenStatically then
            if node.provenNeedsNil then
                local v = exprAs(f, node.expr, "v");
                local n = f:reg();
                f:op("Nil", n);
                f:op("Ne", dst, v, n)
            else
                f:op("K", dst, f:const("true", ""))
            end
        elseif node.refutedStatically then
            f:op("K", dst, f:const("false", ""))
        elseif t.kind == "tname" and t.base.kind == "nil" then
            local v = exprAs(f, node.expr, "v");
            local n = f:reg();
            f:op("Nil", n);
            f:op("Eq", dst, v, n)
        elseif wideKind(node.typeTestTarget) then
            local callee, base, value = f:reg(), f:reg(), f:reg()
            f:op("K", callee, f:const("builtin", "wide." .. wideKind(node.typeTestTarget) .. ".is"))
            exprAs(f, node.expr, "v", value)
            f:op("CallDyn", callee, base, 1)
            f:op("Move", dst, base)
        elseif t.wherePredicate then
            -- A `where` refinement is the declaration's own answer to `is`, and the
            -- only one an interface has. The checker renders it as a Lua test of one
            -- subject; the subject is evaluated once and bound for it.
            local test = node.vmWhereTest
            if not test then
                local text = require("nupp.compiler.types.predicate").test(t.wherePredicate, "__nuppIsSubject")
                local parsed = require("nupp.compiler.syntax.parser").parse("return " .. text, "=where")
                assert(#parsed.errors == 0, "refinement test does not parse: " .. text)
                test = (parsed.root.blocks[1].stats[1] as any).exprs[1]
                node.vmWhereTest = test
            end
            f:push()
            local subject = f:declare("__nuppIsSubject", "v")
            exprAs(f, node.expr, "v", subject)
            exprAs(f, test, "v", dst)
            f:pop()
        elseif targetShape then
            local value = exprAs(f, node.expr, "v")
            shapeTest(f, targetShape, value, dst)
        elseif t.kind == "tname" and #t == 1 and IS_TYPE[t.base.text] then
            typeTest(IS_TYPE[t.base.text])
        elseif t.primitiveTest then
            typeTest(t.primitiveTest)
        elseif t.kind == "tfunc" then
            typeTest("function")
        elseif t.recordName and (shapeOfNominal(t.resolvedType) or shapeByBareName(t.recordName)) then
            local v = exprAs(f, node.expr, "v");
            shapeTest(f, shapeOfNominal(t.resolvedType) or shapeByBareName(t.recordName), v, dst)
        elseif t.recordNames then
            -- One of several records: the subject is read once, tested in order.
            local v = exprAs(f, node.expr, "v")
            local found = f:label()
            for i, rn in ipairs(t.recordNames) do
                local sh = assert(shapeByBareName(rn), "is-test against unknown record " .. tostring(rn))
                shapeTest(f, sh, v, dst)
                if i < #t.recordNames then
                    f:branch("JmpIf", dst, found)
                end
            end
            f:place(found)
        else
            error("is-test against " .. tostring(t.kind) .. " is not in this emitter")
        end

        return dst, "v"
    end

    -- Erased casts preserve a trailing call's result pack; parentheses close it.
    local function multiCall(e)
        while e.kind == "castExpr" do
            e = e.expr
        end
        return (e.kind == "call" or e.kind == "methodCall" or e.kind == "safeCall")
            and not e.scalarIntrinsic
            and not e.ownershipIntrinsic
    end

    -- A call with results landing at `dst..`: eight registers are reserved above
    -- the base so a callee's extra results have somewhere to go.
    callInto = function(f: Fn, node, dst, extraSelf)
        local base = dst
        local nargs = 0
        if node.spiInterface then
            -- An interface has no runtime witness. The checker resolves the
            -- exported declaration to the provider index's canonical key.
            assert(not extraSelf, "SPI loading has no implicit receiver")
            while f.nregs < base + 2 do
                f:reg()
            end
            f:op("K", base + 1, f:const("str", node.spiInterface))
            return base, 1
        end
        local args = node.args and node.args.exprs or {}
        if node.args and node.args.loweredArgs then
            local lowered = node.args.loweredArgs
            local offset = extraSelf and 1 or 0
            while f.nregs < base + #lowered + offset + 1 do
                f:reg()
            end
            -- A pluck from a dotted path binds each prefix of that path once, in
            -- parameter order, after any argument it must stay behind; each plucked
            -- field is then read where its parameter sits, as the Lua backend did.
            local lastDotted = 0
            for index, argument in ipairs(lowered) do
                if argument.generatedKind == "field" and argument.source and argument.source.kind == "dotIndex" then
                    lastDotted = index
                end
            end
            if lastDotted > 0 then
                local paths, early = {}, {}

                local function pathChain(node)
                    if node.kind == "name" then
                        return {node}
                    elseif node.kind == "dotIndex" and node.name then
                        local chain = pathChain(node.obj)
                        if chain then
                            chain[#chain + 1] = node
                        end
                        return chain
                    end

                    return nil
                end

                local function bindPath(source)
                    local chain = pathChain(source)
                    if not chain then
                        return nil
                    end
                    local key = tokText(chain[1].token)
                    local register = paths[key]
                    if not register then
                        register = f:reg()
                        exprAs(f, chain[1], "v", register)
                        paths[key] = register
                    end
                    for index = 2, #chain do
                        local node = chain[index]
                        key = key .. "\0" .. tokText(node.name)
                        local next = paths[key]
                        if not next then
                            next = f:reg()
                            exprAs(
                                f,
                                {
                                    kind = "dotIndex",
                                    obj = {kind = "vmRegister", reg = register, inferredType = node.obj.inferredType},
                                    name = node.name,
                                    overloadMember = node.overloadMember,
                                },
                                "v",
                                next
                            )
                            paths[key] = next
                        end
                        register = next
                    end

                    return register
                end

                local bases = {}
                for index, argument in ipairs(lowered) do
                    if argument.generatedKind == "field" and argument.source and argument.source.kind == "dotIndex" then
                        bases[argument] = bindPath(argument.source) or exprAs(f, argument.source, "v")
                    elseif argument.generatedKind == "expr" and index < lastDotted then
                        early[argument] = exprAs(f, argument.expr, "v")
                    end
                end
                if extraSelf then
                    f:op("Move", base + 1, extraSelf)
                end
                for i, argument in ipairs(lowered) do
                    local target = base + offset + i
                    if argument.generatedKind == "nil" then
                        f:op("Nil", target)
                    elseif argument.generatedKind == "field" then
                        local source = bases[argument] or exprAs(f, argument.source, "v")
                        f:op("GetField", target, source, f:const("str", argument.name))
                    elseif early[argument] then
                        f:op("Move", target, early[argument])
                    else
                        exprAs(f, argument.expr, "v", target)
                    end
                end
                return base, #lowered + offset
            end
            -- Evaluate in source order, then arrange the checker's parameter map.
            local evaluated = {}
            for _, argument in ipairs(args) do
                local value = (argument.kind == "namedArg" or argument.kind == "pluckArg") and argument.value
                    or argument
                evaluated[value] = exprAs(f, value, "v")
            end
            if extraSelf then
                f:op("Move", base + 1, extraSelf)
            end
            for i, argument in ipairs(lowered) do
                local target = base + offset + i
                if argument.generatedKind == "nil" then
                    f:op("Nil", target)
                elseif argument.generatedKind == "field" then
                    local source = evaluated[argument.source] or exprAs(f, argument.source, "v")
                    f:op("GetField", target, source, f:const("str", argument.name))
                else
                    local source = evaluated[argument.expr] or exprAs(f, argument.expr, "v")
                    f:op("Move", target, source)
                end
            end
            return base, #lowered + offset
        end
        if node.trailingCallableCall then
            local offset = extraSelf and 1 or 0
            while f.nregs < base + #args + offset + 1 do
                f:reg()
            end
            local values = {}
            for i, argument in ipairs(args) do
                values[i] = exprAs(f, argument, "v")
            end
            if extraSelf then
                f:op("Move", base + 1, extraSelf)
            end
            f:op("Move", base + offset + 1, values[#values])
            for i = 1, #values - 1 do
                f:op("Move", base + offset + i + 1, values[i])
            end
            return base, #values + offset
        end
        local argRegs = {}
        if extraSelf then
            nargs = nargs + 1;
            argRegs[1] = extraSelf
        end
        local spread, trailing
        for i, a in ipairs(args) do
            if a.kind == "vararg" and i == #args then
                spread = a
            elseif multiCall(a) and i == #args then
                trailing = a
            else
                nargs = nargs + 1;
                argRegs[nargs] = a
            end
        end
        -- Only the arguments are reserved: a callee's extra results land above
        -- the top, which nothing holds live, inside the frame's nine-word slack.
        while f.nregs < base + nargs + 1 do
            f:reg()
        end
        for i, a in ipairs(argRegs) do
            if type(a) == "number" then
                if a ~= base + i then
                    f:op("Move", base + i, a)
                end
            else
                exprAs(f, a, "v", base + i)
            end
        end
        -- A trailing call passes everything it returned, flagged by 64 on the
        -- count: its results follow the fixed arguments in the registers.
        if trailing then
            emitCall(f, trailing, base + nargs + 1, 8, true);
            return base, nargs + 64
        end
        -- A trailing `...` spreads this frame's own varargs, flagged by 128 on
        -- the count; the runtime copies them from below the header.
        if spread then
            assert(f.vararg, "... outside a vararg function");
            return base, nargs + 128
        end

        return base, nargs
    end

    -- A call's window is reserved above every register in use, so the callee
    -- and receiver values evaluated first are not clobbered by the arguments;
    -- the results are then moved down to `dst` (`nres` of them).
    -- `local byte = string.byte`: a local the module never assigns to, bound to
    -- a library function, so a call through it can become an intrinsic.
    local function markLibraryLocals(f: Fn, names, exprs)
        for i, nameTok in ipairs(names) do
            local e = exprs[i]
            local name = tokText(nameTok)
            if not environment
                and e
                and e.kind == "dotIndex"
                and e.obj.kind == "name"
                and tokText(e.obj.token) == "string"
                and not f:binding("string")
                and not assignedNames[name]
            then
                local entry = f.scopes[#f.scopes][name]
                if entry then
                    entry.builtin = "string." .. tokText(e.name)
                end
            end
        end
    end

    -- `string.byte(s, i)` with one result wanted, `s` a string and `i` an
    -- integer by the checker: one opcode instead of a builtin call.
    local function emitStrByte(f: Fn, node, dst, nres)
        local args = node.args and node.args.exprs or {}
        if #args ~= 2 or (nres or 1) > 1 then
            return false
        end
        if tyTag(args[1].inferredType) ~= "string" or not isIntegerish(args[2]) then
            return false
        end
        local s = exprAs(f, args[1], "v")
        local i = exprAs(f, args[2], "i")
        f:op("StrByte", dst, s, i)

        return true
    end

    local function emitSimd(f: Fn, operation, ty, operands, dst, nres)
        -- Evaluate once in source order before placing the argument window.
        local args = {}
        for i, operand in ipairs(operands) do
            if operation == "transpose" and i == #operands and (multiCall(operand) or operand.kind == "vararg") then
                local count = ty.lanes - #args
                local at = f:reg()
                for _ = 2, count do
                    f:reg()
                end
                if operand.kind == "vararg" then
                    assert(f.vararg, "... outside a vararg function")
                    f:op("VarargN", at, count)
                else
                    emitCall(f, operand, at, count)
                end
                for j = 0, count - 1 do
                    args[#args + 1] = at + j
                end
            else
                args[#args + 1] = exprAs(f, operand, "v")
            end
        end
        local base = f:reg()
        for _, value in ipairs(args) do
            local r = f:reg()
            f:op("Move", r, value)
        end
        f:op("Simd", operation, ty.element, base, #args, ty.sourceElement or ty.element)
        if dst then
            local resultCounts: {
                [string]: integer
            } = {interleave = 2, deinterleave = 2, loadPairs = 2, loadTriples = 3, loadQuads = 4}
            local results = operation == "transpose" and #args or resultCounts[operation] or 1
            for i = 0, (nres or 1) - 1 do
                if i < results then
                    f:op("Move", dst + i, base + i)
                else
                    f:op("Nil", dst + i)
                end
            end
            return dst
        end

        return base
    end

    local function simdIterator(f: Fn, node, ty, dst)
        local object = exprAs(f, node.obj, "v")
        local count = exprAs(f, node.args.exprs[1], "v")
        local zero = f:reg()
        f:op("K", zero, f:const("num", 1))
        local base = f:reg()
        for _, value in ipairs({object, count, zero}) do
            local capture = f:reg()
            f:op("NewCell", capture, value)
        end
        local inner = newFn("simd.over", f)
        inner.nparams, inner.sig, inner.ret = 0, {}, "v"
        local species, limit, cursor = inner:reg(), inner:reg(), inner:reg()
        for i, r in ipairs({species, limit, cursor}) do
            inner:op("GetUpval", r, i - 1)
        end
        inner:op("GetCell", species, species)
        inner:op("GetCell", limit, limit)
        local first, active = inner:reg(), inner:reg()
        inner:op("GetCell", first, cursor)
        local at, stop, width, room, valid = inner:freg(), inner:freg(), inner:freg(), inner:freg(), inner:freg()
        inner:op("IUnbox", at, first)
        inner:op("IUnbox", stop, limit)
        inner:op("ICmpSLe", valid, at, stop)
        local exit = inner:label()
        inner:branch("JmpIfIZero", valid, exit)
        local call, selfReg, countReg = inner:reg(), inner:reg(), inner:reg()
        inner:op("Move", selfReg, species)
        inner:op("Simd", "lanes", ty.element, call, 1)
        inner:op("IUnbox", width, call)
        inner:op("ISub", room, stop, at)
        inner:op("IAddK", room, room, 1)
        inner:op("Move", selfReg, species)
        inner:op("IBox", countReg, room)
        inner:op("Simd", "tail", ty.element, call, 2)
        inner:op("Move", active, call)
        inner:op("IAdd", at, at, width)
        inner:op("IBox", call, at)
        inner:op("SetCell", cursor, call)
        inner:op("RetN", first, 2)
        inner:place(exit)
        inner:op("RetNil")
        f:op("NewClosure", dst, inner.id, base, 3)
    end

    local function simdCall(f: Fn, node, dst, nres)
        local args = node.args and node.args.exprs or {}
        local ty = node.kind == "methodCall" and simdType(node.obj.inferredType) or nil
        local operation
        local operands = {}
        if ty then
            operation = tokText(node.name)
            if operation == "over" then
                assert(#args == 1, "SIMD over requires one count")
                simdIterator(f, node, ty, dst)
                for i = 1, nres - 1 do
                    f:op("Nil", dst + i)
                end
                return true
            elseif operation == "scatter" then
                local indices = args[2]
                local indexType = indices and indices.kind == "methodCall" and simdType(indices.obj.inferredType)
                assert(
                    indexType and indexType.family == "Species" and tokText(indices.name) == "iota",
                    "SIMD scatter needs provably unique indices; use scatterUnchecked for an explicit uniqueness assertion"
                )

                local function constant(n)
                    if n and (n.kind == "paren" or n.kind == "castExpr") then
                        return constant(n.expr)
                    end
                    if n and n.kind == "unop" and tokText(n.op) == "-" then
                        local value = constant(n.operand)
                        return value and -value
                    end
                    if n and n.kind == "number" then
                        local value = tonumber((tokText(n.token):gsub("_", ""):gsub("[uUlL]+$", "")))
                        if value and math.abs(value) < 9007199254740992 and value % 1 == 0 then
                            return value
                        end
                    end

                    return nil
                end

                local first, step = constant(indices.args.exprs[1]), constant(indices.args.exprs[2])
                local unsigned = indexType.element == "uint32" or indexType.element == "uint64"
                local low = unsigned and 0 or indexType.element == "int32" and -2147483648 or -9007199254740991
                local high = indexType.element == "uint32" and 4294967295
                    or indexType.element == "int32" and 2147483647
                    or 9007199254740991
                local last = first and step and first + 63 * step
                assert(
                    first and step and step ~= 0 and first >= low and first <= high and last >= low and last <= high,
                    "SIMD scatter requires constant non-wrapping iota indices; use scatterUnchecked for an explicit uniqueness assertion"
                )
            end
            operands[1] = node.obj
            if operation == "widen" or operation == "narrow" then
                ty = assert(simdType(node.inferredType), "SIMD width change has no result species")
            elseif operation == "convert" or operation == "reinterpret" then
                ty.sourceElement = assert(
                    simdType(args[1].inferredType),
                    "SIMD conversion has no source species"
                ).element
            end
        else
            local callee = node.obj
            local definition = callee and callee.token and callee.token.definition
            local identity = callee and (callee.exactCallExport or definition and definition.exactCallExport)
            if identity
                and identity.module == "nupp.simd"
                and (identity.member == "species" or identity.member == "vectors")
            then
                ty = simdType(node.inferredType)
                operation = "species"
            elseif identity and identity.module == "nupp.simd" and identity.member == "transpose" then
                local targetlayout = require("nupp.compiler.targetlayout")
                local pack = node.argumentPack
                assert(pack and not pack.tail and not pack.alternatives, "SIMD transpose needs a fixed row pack")
                local rows = pack.head
                assert(#rows >= 2 and #rows <= 64, "SIMD transpose needs between 2 and 64 fixed-width rows")
                local element, lanes = targetlayout.storageVector(rows[1])
                assert(element and lanes == #rows, "SIMD transpose needs a square tile of fixed-width vectors")
                for _, rowType in ipairs(rows) do
                    local rowElement, rowLanes = targetlayout.storageVector(rowType)
                    assert(
                        rowElement == element and rowLanes == lanes,
                        "SIMD transpose rows must have the same vector type"
                    )
                end
                ty = {family = "Vector", element = element, lanes = lanes}
                operation = "transpose"
            elseif node.simdMath then
                ty = args[1] and simdType(args[1].inferredType)
                operation = node.simdMath
            elseif node.simdHorizontal then
                ty = args[1] and simdType(args[1].inferredType)
                operation = node.simdHorizontal:match("^horizontal%.(.+)$")
                if operation:match("^propagating") or operation:match("^number") then
                    operation = "horizontal." .. operation
                end
            end
        end
        if not ty or not operation then
            return false
        end
        for _, arg in ipairs(args) do
            operands[#operands + 1] = arg
        end
        emitSimd(f, operation, ty, operands, dst, nres)

        return true
    end

    -- `all` asks for everything the call returns (a trailing `return f()`),
    -- which `RetN` reads from `last_nres`; otherwise exactly `nres` values.
    -- `f?.(...)`, `o?.:m(...)` and `o:m?.(...)`: each guarded value is tested
    -- against nil, and a nil skips the call, which then answers one nil.
    emitSafeCall = function(f: Fn, node, dst, nres, all)
        local absent = f:reg()
        f:op("Nil", absent)
        local skipped, done = f:label(), f:label()

        local function guard(value)
            local present = f:reg()
            f:op("Ne", present, value, absent)
            f:branch("JmpIfNot", present, skipped)
        end

        if node.kind == "safeCall" then
            local callee = exprAs(f, node.obj, "v")
            guard(callee)
            emitCall(
                f,
                {
                    kind = "call",
                    obj = {kind = "vmRegister", reg = callee},
                    args = node.args,
                    trailingCallableCall = node.trailingCallableCall,
                },
                dst,
                nres,
                all
            )
        else
            local receiver = exprAs(f, node.obj, "v")
            if node.safeObj then
                guard(receiver)
            end
            if node.safeMethod then
                local method = f:reg()
                local name = node.trailingCallableMember or node.overloadMember or tokText(node.name)
                f:op("GetField", method, receiver, f:const("str", name))
                guard(method)
            end
            -- The receiver is already evaluated: the ordinary method call
            -- reads it from its register.
            local obj, safeObj, safeMethod = node.obj, node.safeObj, node.safeMethod
            node.obj, node.safeObj, node.safeMethod = {kind = "vmRegister", reg = receiver}, nil, nil
            emitCall(f, node, dst, nres, all)
            node.obj, node.safeObj, node.safeMethod = obj, safeObj, safeMethod
        end
        f:jump(done)
        f:place(skipped)
        if all then
            -- The results are counted at run time: `select(1, nil)` is one nil.
            while f.nregs < dst + 3 do
                f:reg()
            end
            local callee = f:reg()
            f:op("K", callee, f:const("builtin", "select"))
            f:op("K", dst + 1, f:const("num", 1))
            f:op("Nil", dst + 2)
            f:op("CallDyn", callee, dst, 2)
        else
            for i = 0, nres - 1 do
                f:op("Nil", dst + i)
            end
        end
        f:place(done)
    end

    emitCall = function(f: Fn, node, dst, nres, all)
        nres = nres or 1
        if node.kind == "castExpr" then
            emitCall(f, node.expr, dst, nres, all)
            return
        end
        if node.kind == "safeCall" or (node.kind == "methodCall" and (node.safeObj or node.safeMethod)) then
            emitSafeCall(f, node, dst, nres, all)
            return
        end
        -- `error(message, level)` carries its own line, which Lua prefixes to
        -- the message: the runtime sees no caller pc on every tier. The
        -- callee is still read as written, so a replaced `error` is called.
        local errorArgs = node.kind == "call"
            and node.obj
            and node.obj.kind == "name"
            and tokText(node.obj.token) == "error"
            and not f:binding("error")
            and node.args
            and not node.args.loweredArgs
            and node.args.exprs
        if errorArgs and #errorArgs >= 1 and #errorArgs <= 2 then
            local last = errorArgs[#errorArgs]
            if not multiCall(last) and last.kind ~= "vararg" then
                local site = f:reg()
                f:op("K", site, f:const("builtin", "error.site"))
                local line = {kind = "number", token = {text = tostring(nodeLine(node) or 0)}}
                emitCall(
                    f,
                    {
                        kind = "call",
                        obj = {kind = "vmRegister", reg = site},
                        args = {exprs = {node.obj, line, errorArgs[1], errorArgs[2] or {kind = "nil"}}},
                    },
                    dst,
                    nres,
                    all
                )
                return
            end
        end
        if node.carrayElem then
            local descriptor = exprAs(f, structDescriptor(node.carrayElem), "v")
            local count = exprAs(f, node.args.exprs[2], "v")
            local element = node.carrayElem.inferredType
            local shape = element and shapeOf(element.tag == "typeobject" and element.of or element)
            if shape and shape.physical and not shape.layout.supported then
                local reason = f:reg()
                f:op("K", reason, f:const("str", shape.layout.error))
                builtinRegisters(f, "error", {reason}, dst)
                return
            end
            builtinRegisters(f, "storage.allocateArray", {descriptor, count}, dst)
            return
        elseif node.cheaderCdef then
            -- A header's library namespace: its functions bind on first use.
            local metadata = require("nupp.compiler.vm.metadata")
            local signatures, constants = metadata.headerNamespace(node.cheaderExports, node.cheaderConstants)
            local library = f:reg()
            if node.cheaderLib then
                f:op("K", library, f:const("str", node.cheaderLib))
            else
                f:op("Nil", library)
            end
            local described = exprAs(f, metadata.literal(signatures), "v")
            local valued = exprAs(f, metadata.literal(constants), "v")
            builtinRegisters(f, "foreign.namespace", {library, described, valued}, dst)
            return
        elseif node.layoutOf then
            local witness = exprAs(f, node.args.exprs[1], "v")
            builtinRegisters(f, "storage.layout", {witness}, dst)
            return
        end
        if simdCall(f, node, dst, nres) then
            return
        end
        if node.ownershipIntrinsic then
            -- Transfers are erased; resolved terminal operations run cleanups.
            local oi = node.ownershipIntrinsic
            local args = node.args and node.args.exprs or {}
            local src = oi == "region" and args[2] or args[1]
            if oi == "drop" or oi == "attemptAll" then
                if oi == "attemptAll" then
                    registerCleanups(f, node.cleanupRegistrations)
                end
                local guards = {}
                for i, guard in pairs(node.ownerCleanupGuards or {}) do
                    for _, slot in ipairs(f.cleanupOwners and f.cleanupOwners[guard.owner] or {}) do
                        if slot.field == guard.field then
                            guards[i] = f:reg()
                            f:op("CleanupLive", guards[i], slot.depth)
                        end
                    end
                end
                local value = exprAs(f, src, "v")
                local depth = f.cleanupDepth or 0
                for i = #(node.ownerCleanups or {}), 1, -1 do
                    deferCleanup(f, value, node.ownerCleanups[i], guards[i])
                end
                f:op("Unwind", depth)
                f.cleanupDepth = depth
                f:op("Nil", dst)
                return
            end
            if oi == "adopt"
                or oi == "release"
                or oi == "borrow"
                or oi == "borrowFrom"
                or oi == "region"
                or oi == "drop"
            then
                if src then
                    exprAs(f, src, "v", dst)
                else
                    f:op("Nil", dst)
                end
                for i = 1, nres - 1 do
                    f:op("Nil", dst + i)
                end
                return
            elseif oi == "pin" then
                -- The pointer, holding its anchor for as long as it lives.
                local pointer = exprAs(f, args[1], "v")
                local anchor = args[2] and exprAs(f, args[2], "v") or nil
                if not anchor then
                    anchor = f:reg()
                    f:op("Nil", anchor)
                end
                builtinRegisters(f, "foreign.pin", {pointer, anchor}, dst)
                for i = 1, nres - 1 do
                    f:op("Nil", dst + i)
                end
                return
            elseif oi == "partition" then
                -- Its value is the pair it was handed: the second and third arguments.
                while f.nregs < dst + math.max(nres, 2) do
                    f:reg()
                end
                if args[2] then
                    exprAs(f, args[2], "v", dst)
                else
                    f:op("Nil", dst)
                end
                if nres >= 2 then
                    if args[3] then
                        exprAs(f, args[3], "v", dst + 1)
                    else
                        f:op("Nil", dst + 1)
                    end
                end
                for i = 2, nres - 1 do
                    f:op("Nil", dst + i)
                end
                return
            end
            error("ownership intrinsic " .. tostring(oi) .. " is not in this emitter")
        end
        local callee = node.obj
        if node.scalarIntrinsic
            and SCALAR_KIND[node.scalarIntrinsic]
            and nres == 1
            and node.args
            and (#node.args.exprs == 1 or #node.args.exprs == 2)
            and node.args.exprs[#node.args.exprs].kind ~= "vararg"
            and not (node.args.exprs[#node.args.exprs].kind == "call" and #node.args.exprs == 2 and false)
        then
            -- The common fixed-width intrinsics as one opcode the typed tier
            -- lowers inline; a unary one names its operand twice.
            local sargs = node.args.exprs
            local a = exprAs(f, sargs[1], "v")
            local bb = sargs[2] and exprAs(f, sargs[2], "v") or a
            f:op("Scalar", SCALAR_KIND[node.scalarIntrinsic], dst, a, bb)
            return
        end
        if node.scalarIntrinsic then
            -- A fixed-width scalar intrinsic the checker named: a builtin of the
            -- runtime, whatever path spelled it.
            local top = dst == f.nregs - 1
            local sargs = node.args and node.args.exprs or {}
            local argc = #sargs
            local lastArg = sargs[#sargs]
            local slack = (
                lastArg
                and (lastArg.kind == "call" or lastArg.kind == "methodCall")
                and not lastArg.ownershipIntrinsic
                and not lastArg.scalarIntrinsic
            )
                and 8
                or 0
            local base, fr
            if top then
                base = dst;
                while f.nregs < base + argc + 2 + slack do
                    f:reg()
                end;
                fr = f:reg()
            else
                fr = f:reg();
                base = math.max(dst, f.nregs)
            end
            local shared = {
                ["f32.exp"] = true,
                ["f32.fromF16Bits"] = true,
                ["f32.toF16Bits"] = true,
                ["f32.fromBF16Bits"] = true,
                ["f32.toBF16Bits"] = true
            }
            if shared[node.scalarIntrinsic] then
                queueModule("nupp.vm.math")
                f:op("Require", fr, f:const("str", "nupp.vm.math"))
                for member in node.scalarIntrinsic:gmatch("[^.]+") do
                    local value = f:reg()
                    f:op("GetField", value, fr, f:const("str", member))
                    f:op("Move", fr, value)
                end
            else
                f:op("K", fr, f:const("builtin", "scalar." .. node.scalarIntrinsic))
            end
            local base2, nargs = callInto(f, node, base)
            f:op("CallDyn", fr, base2, nargs)
            if nres > 0 and not all then
                f:op("PadResults", base2, nres)
            end
            if base2 ~= dst then
                for i = 0, nres - 1 do
                    f:op("Move", dst + i, base2 + i)
                end
            end
            return
        end
        if callee.kind == "name" then
            local bnd = f:binding(tokText(callee.token))
            if bnd and bnd.builtin == "string.byte" and emitStrByte(f, node, dst, nres) then
                return
            end
        elseif callee.kind == "dotIndex"
            and callee.obj.kind == "name"
            and not environment
            and tokText(callee.obj.token) == "string"
            and tokText(callee.name) == "byte"
            and not f:binding("string")
        then
            if emitStrByte(f, node, dst, nres) then
                return
            end
        end

        local function finish(base)
            if nres > 0 and not all then
                f:op("PadResults", base, nres)
            end
            if base ~= dst then
                for i = 0, nres - 1 do
                    f:op("Move", dst + i, base + i)
                end
            end
        end

        -- When the destination is the highest register in use, the call's window
        -- starts there and the results land in place; the callee and receiver
        -- are evaluated above the reserved window.
        local top = dst == f.nregs - 1
        local argc = 0
        local args0 = node.args and node.args.exprs or {}
        for _, a in ipairs(args0) do
            if a.kind ~= "vararg" then
                argc = argc + 1
            end
        end
        -- A trailing call's results land past the arguments: the callee and
        -- receiver, evaluated above the window, must stay clear of them.
        local lastArg = args0[#args0]
        local slack = lastArg and multiCall(lastArg) and 8 or 0
        if node.kind == "methodCall" then
            -- Lua reads the method before the arguments run. A record's method is
            -- its shape's, but a dynamic receiver's field can be replaced by an
            -- argument, so it is read first unless every argument is inert.
            local inert = true
            for _, argument in ipairs(node.args and node.args.exprs or {}) do
                local kind = argument.kind
                inert = inert
                    and (
                        kind == "number"
                        or kind == "string"
                        or kind == "name"
                        or kind == "nil"
                        or kind == "nilExpr"
                        or kind == "trueExpr"
                        or kind == "falseExpr"
                        or kind == "vmRegister"
                    )
            end
            if not inert and not shapeOf(node.obj.inferredType) and not node.trailingCallableMember then
                local receiver = exprAs(f, node.obj, "v")
                local method = f:reg()
                f:op("GetField", method, receiver, f:const("str", node.overloadMember or tokText(node.name)))
                local base = math.max(dst, f.nregs)
                local base2, nargs = callInto(f, node, base, receiver)
                f:op("CallDyn", method, base2, nargs)
                finish(base2)
                return
            end
            -- Otherwise the window is placed above the receiver once it exists.
            local base, o
            if top then
                base = dst;
                while f.nregs < base + argc + 3 + slack do
                    f:reg()
                end;
                o = exprAs(f, node.obj, "v", base + 1)
            else
                o = exprAs(f, node.obj, "v");
                base = math.max(dst, f.nregs)
            end
            local base, nargs = callInto(f, node, base, o)
            f:op(
                "CallMethod",
                f:const("str", node.trailingCallableMember or node.overloadMember or tokText(node.name)),
                base,
                nargs
            )
            finish(base)
            return
        end
        if callee.kind == "name" then
            local name = tokText(callee.token)
            if not environment and name == "pcall" and not f:binding(name) then
                local args = node.args.exprs
                -- The window starts at the destination only when nothing lives
                -- above it: assigning to an earlier local placed the arguments
                -- over the locals declared after it.
                local base = top and dst or math.max(dst, f.nregs)
                while f.nregs < base + #args + 8 do
                    f:reg()
                end
                local last = args[#args]
                local trailing = #args > 1 and multiCall(last)
                local varargs = #args > 1 and last.kind == "vararg"
                for i, a in ipairs(args) do
                    if not ((trailing or varargs) and i == #args) then
                        exprAs(f, a, "v", base + i)
                    end
                end
                if trailing then
                    emitCall(f, last, base + #args, 8, true);
                    f:op("PCall", base, (#args - 2) + 64)
                elseif varargs then
                    f:op("PCall", base, (#args - 2) + 128)
                else
                    f:op("PCall", base, #args - 1)
                end
                finish(base)
                return
            end
            if not environment and name == "require" and not f:binding(name) and nres <= 1 and not all then
                local a = node.args.exprs[1]
                if a.kind == "string" then
                    f:op("Require", dst, f:const("str", (loadstring("return " .. tokText(a.token)))()))
                else
                    local r = exprAs(f, a, "v");
                    f:op("RequireV", dst, r)
                end
                return
            end
        end
        -- Otherwise the window is placed above the callee once it exists.
        local base, fr
        if top then
            base = dst;
            while f.nregs < base + argc + 2 + slack do
                f:reg()
            end;
            fr = exprAs(f, callee, "v")
        else
            fr = exprAs(f, callee, "v");
            base = math.max(dst, f.nregs)
        end
        local base, nargs = callInto(f, node, base)
        local fid = callee.kind == "name" and f:knownFid(tokText(callee.token))
        if fid then
            f:op("CallK", fid, fr, base, nargs, nres)
        else
            f:op("CallDyn", fr, base, nargs)
        end
        finish(base)
    end

    -- An owned temporary loaned for one statement closes when that statement
    -- completes: its cleanups are deferred here, where the call's first result
    -- lands, and `stmtReclaim` unwinds to before the statement.
    local emitCallBody = emitCall
    emitCall = function(f: Fn, node, dst, nres, all)
        if node.kind == "call" and node.admitName then
            -- `nupp.admit(value)`: what the checker proved costs nothing; what it
            -- could not is tested on the value, read once, and refused when false.
            local supplied = node.args and node.args.exprs and node.args.exprs[1]
            if not node.admitPredicate then
                exprAs(f, supplied, "v", dst)
            else
                local test = node.vmAdmitTest
                if not test then
                    local text = require(
                        "nupp.compiler.types.predicate"
                    ).render(node.admitPredicate, "__nuppAdmitValue")
                    local parsed = require("nupp.compiler.syntax.parser").parse("return " .. text, "=admit")
                    assert(#parsed.errors == 0, "admission test does not parse: " .. text)
                    test = (parsed.root.blocks[1].stats[1] as any).exprs[1]
                    node.vmAdmitTest = test
                end
                f:push()
                local subject = f:declare("__nuppAdmitValue", "v")
                exprAs(f, supplied, "v", subject)
                local admitted = exprAs(f, test, "v")
                local pass = f:label()
                f:branch("JmpIf", admitted, pass)
                local message, level = f:reg(), f:reg()
                f:op(
                    "K",
                    message,
                    f:const("str", "value is not established as " .. (node.admitName or "a constrained type"))
                )
                f:op("K", level, f:const("num", 2))
                builtinRegisters(f, "error", {message, level})
                f:place(pass)
                f:op("Move", dst, subject)
                f:pop()
            end
            for extra = 1, (nres or 1) - 1 do
                f:op("Nil", dst + extra)
            end
            return
        end
        local plan = node.formatIntrinsic
        if plan then
            -- A format holding `%?` was rewritten by the checker to `%s`; each
            -- argument it marked is rendered through its own `debug` method.
            local arguments = node.args and node.args.exprs or {}
            local offset = plan.argumentOffset or 0
            local format = f:reg()
            f:op("K", format, f:const("str", plan.format))
            local values = {format}
            for index = offset + 1, #arguments do
                local value = exprAs(f, arguments[index], "v")
                if (plan.debugArguments or {})[index - offset] then
                    value = exprAs(
                        f,
                        {
                            kind = "methodCall",
                            obj = {kind = "vmRegister", reg = value},
                            name = {text = "debug"},
                            args = {kind = "args", exprs = {}},
                        },
                        "v"
                    )
                end
                values[#values + 1] = value
            end
            builtinRegisters(f, "string.format", values, dst)
            for extra = 1, (nres or 1) - 1 do
                f:op("Nil", dst + extra)
            end
            return
        end
        emitCallBody(f, node, dst, nres, all)
        local owner = node.statementOwner
        if owner and #(owner.cleanups or {}) > 0 then
            for i = #owner.cleanups, 1, -1 do
                deferCleanup(f, dst, owner.cleanups[i])
            end
        end
    end

    local function wideOperation(f: Fn, name, args, dst)
        dst = dst or f:reg()
        local callee = f:reg()
        local base = f:reg()
        for _ = 1, #args do
            f:reg()
        end
        f:op("K", callee, f:const("builtin", name))
        for i, arg in ipairs(args) do
            exprAs(f, arg, "v", base + i)
        end
        f:op("CallDyn", callee, base, #args)
        f:op("Move", dst, base)

        return dst, "v"
    end

    local function spanAccess(f: Fn, node, value, dst)
        dst = dst or f:reg()
        local base, receiver, index = f:reg(), f:reg(), f:reg()
        local stored = value and f:reg() or nil
        exprAs(f, node.obj, "v", receiver)
        exprAs(f, node.expr, "v", index)
        if stored then
            f:op("Move", stored, value)
        end
        f:op("CallMethod", f:const("str", value and "set" or "get"), base, value and 3 or 2)
        if not value then
            f:op("Move", dst, base)
        end

        return dst, "v"
    end

    -- SoA row views have no Lua metatable either: a row, a row's field and a
    -- projected column are checked methods of the VM's `nupp.mem.soa` view,
    -- which owns the columns. `receiver` is the view, `arguments` its operands.
    local function soaAccess(f: Fn, method, receiver, arguments, value, dst)
        dst = dst or f:reg()
        -- The call reads its operands from consecutive registers, so all of them
        -- are claimed before any operand's own temporaries are.
        local base = f:reg()
        local operands = {f:reg()}
        for _ = 1, value and #arguments + 1 or #arguments do
            operands[#operands + 1] = f:reg()
        end
        exprAs(f, receiver, "v", operands[1])
        for index, argument in ipairs(arguments) do
            if type(argument) == "number" then
                f:op("K", operands[index + 1], f:const("num", argument))
            else
                exprAs(f, argument, "v", operands[index + 1])
            end
        end
        if value then
            f:op("Move", operands[#operands], value)
        end
        f:op("CallMethod", f:const("str", method), base, #operands)
        if not value then
            f:op("Move", dst, base)
        end

        return dst, "v"
    end

    -- The view, row index and field ordinal of `rows[i].name` over a SoA view.
    local function soaField(node)
        local row = node.kind == "dotIndex" and node.soaField and node.obj
        if row and row.kind == "bracketIndex" and row.soaRow then
            return row.obj, row.expr, node.soaField.ordinal
        end

        return nil
    end

    expr = function(f: Fn, node, dst, want)
        local k = node.kind
        if k == "paren" then
            return expr(f, node.expr, dst, want)
        elseif k == "vmRegister" then
            -- A value the lowering already holds, such as a guarded receiver.
            return node.reg, "v"
        end
        -- The checker identifies indexed views. Their public operators use
        -- checked library methods even when the view has no Lua metatable.
        if k == "bracketIndex" and node.indexedAccess and node.indexedAccess.adapter == "span" then
            return spanAccess(f, node, nil, (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil)
        end
        if node.soaFieldProjection and (k == "dotIndex" or k == "bracketIndex") then
            local free = (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil
            return soaAccess(f, "fieldBySlot", node.obj, {node.soaFieldProjection.ordinal}, nil, free)
        end
        if k == "bracketIndex" and node.soaRow then
            local free = (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil
            return soaAccess(f, "get", node.obj, {node.expr}, nil, free)
        end
        do
            local view, index, ordinal = soaField(node)
            if view then
                local free = (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil
                return soaAccess(f, "getField", view, {index, ordinal}, nil, free)
            end
        end
        if k == "unop" and node.indexedLength and node.operand then
            local d = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg()
            local receiver = exprAs(f, node.operand, "v")
            f:op("GetField", d, receiver, f:const("str", "count"))
            return d, "v"
        end
        if k == "dotIndex" then
            local field = physicalField(shapeOf(node.obj.inferredType), node.overloadMember or tokText(node.name))
            if field then
                local object = exprAs(f, node.obj, "v")
                local class = "v"
                if want == "f" and (field.kind >= 1 and field.kind <= 6 or field.kind >= 9) then
                    class = "f"
                elseif want == "i" and field.kind == 7 then
                    class = "i"
                elseif want == "u" and field.kind == 8 then
                    class = "u"
                end
                local destination = class == "v" and (dst or f:reg()) or f:freg()
                local opcode = class == "f" and "GetPhysF"
                    or class == "i" and "GetPhysI"
                    or class == "u" and "GetPhysU"
                    or "GetPhys"
                -- The runtime guards the live receiver and layout. Erased casts
                -- retain ordinary field access and conversion on the slow path.
                f:op(
                    opcode,
                    destination,
                    object,
                    f:const("str", field.identity),
                    f:const("str", field.name),
                    field.ordinal,
                    field.offset,
                    field.kind
                )
                return destination, class
            end
        end
        if node.simdIntrinsic then
            local operands = k == "binop" and {node.lhs, node.rhs} or {node.operand}
            local ty = simdType(operands[1].inferredType) or simdType(node.inferredType)
            local names = {
                ["+"] = "add",
                ["-"] = "sub",
                ["*"] = "mul",
                ["/"] = "div",
                ["//"] = "idiv",
                ["%"] = "mod",
                ["&"] = "and",
                ["|"] = "or",
                ["~"] = "xor",
                ["<<"] = "shl",
                [">>"] = "shr",
                ["~>>"] = "sar",
                ["=="] = "eq",
                ["~="] = "ne",
                ["<"] = "lt",
                ["<="] = "le",
                [">"] = "lt",
                [">="] = "le"
            }
            local op = node.simdIntrinsic
            local operation = names[op]
            if k == "unop" then
                operation = (op == "~" or ty.family == "Mask") and "not" or "neg"
            elseif op == ">" or op == ">=" then
                -- Preserve operand evaluation order; the native operation owns
                -- the comparison direction.
                operation = op == ">" and "gt" or "ge"
            end
            if ty.family == "Mask" and (operation == "eq" or operation == "ne") then
                operation = operation == "eq" and "maskEq" or "maskNe"
            end
            assert(operation, "unsupported VM SIMD operator " .. tostring(op))
            return emitSimd(f, operation, assert(ty), operands, want == "v" and dst or nil), "v"
        end
        if k == "dotIndex" and tokText(node.name) == "lanes" then
            local ty = simdType(node.obj.inferredType)
            if ty then
                return emitSimd(f, "lanes", ty, {node.obj}, want == "v" and dst or nil), "v"
            end
        end
        local numeric = isNumeric(node.inferredType)
        local integer = isInteger(node.inferredType)
        if k == "binop" and node.fixedArithmetic then
            local a = exprAs(f, node.lhs, "v")
            local b = exprAs(f, node.rhs, "v")
            local d = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg()
            f:op("Scalar", assert(SCALAR_KIND[node.fixedArithmetic]), d, a, b)
            return d, "v"
        end
        if k == "unop" and node.fixedArithmetic then
            local a = exprAs(f, node.operand, "v")
            local d = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg()
            f:op("Scalar", assert(SCALAR_KIND[node.fixedArithmetic]), d, a, a)
            return d, "v"
        end
        -- A bit operator the checker typed `int32` has BitOp's thirty-two bit
        -- meaning, as the Lua backend gives it, rather than the integer
        -- file's sixty-four: `x << 9` wraps and `x >> 16` shifts in zeros at
        -- bit 31. The shifts reinterpret the unsigned result as the signed
        -- one the operator answers.
        local int32Bits = (k == "binop" or k == "unop")
            and node.inferredType
            and node.inferredType.tag == "int32"
            and (k == "unop" and INT32_UNARY_BITS or INT32_BITS)[tokText(node.op)]
        if int32Bits then
            local a = exprAs(f, k == "unop" and node.operand or node.lhs, "v")
            local b = k == "unop" and a or exprAs(f, node.rhs, "v")
            local d = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg()
            f:op("Scalar", assert(SCALAR_KIND[int32Bits[1]]), d, a, b)
            if int32Bits[2] then
                f:op("Scalar", assert(SCALAR_KIND[int32Bits[2]]), d, d, d)
            end
            return d, "v"
        end
        local wide = wideKind(node.inferredType)
        if k == "number" and not node.inferredType then
            local literal = tokText(node.token):gsub("_", ""):lower()
            if literal:match("ull$") then
                wide = "u64"
            elseif literal:match("ll$") then
                wide = "i64"
            elseif literal:sub(1, 2) == "0x" then
                wide = not (literal:find("%.") or literal:find("p")) and "i64" or nil
            elseif not (literal:find("%.") or literal:find("e")) then
                local digits = literal:gsub("^0+", "")
                if #digits < 19 or (#digits == 19 and digits <= "9223372036854775807") then
                    wide = "i64"
                end
            end
        end
        if k == "number" and (wide or node.wideIntegerLiteralTag) then
            local tag = node.wideIntegerLiteralTag or (wide == "u64" and "uint64" or "int64")
            local text = node.wideIntegerLiteralText or tokText(node.token):gsub("_", ""):gsub("[uUlL]+$", "")
            if tag == "int64" and text:sub(1, 2):lower() == "0x" and #text > 18 then
                text = "0x" .. text:sub(-16)
            end
            local d = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg()
            f:op("K", d, f:const(tag, text))
            return d, "v"
        end
        if k == "binop" then
            local leftWide, rightWide = wideKind(node.lhs.inferredType), wideKind(node.rhs.inferredType)
            local family = wide
                or (leftWide and rightWide and ((leftWide == "u64" or rightWide == "u64") and "u64" or "i64"))
            local op = tokText(node.op)
            if not family
                and (op == "&" or op == "|" or op == "~" or op == "<<" or op == ">>" or op == "~>>")
                and (not node.inferredType or tyTag(node.inferredType) == "any" or tyTag(node.inferredType) == "number")
            then
                family = "i64"
            end
            local operations = {
                ["+"] = "add",
                ["-"] = "sub",
                ["*"] = "mul",
                ["/"] = "div",
                ["//"] = "idiv",
                ["%"] = "mod",
                ["^"] = "pow",
                ["&"] = "and",
                ["|"] = "or",
                ["~"] = "xor",
                ["<<"] = "shl",
                [">>"] = "shr",
                ["~>>"] = "sar",
                ["=="] = "eq",
                ["~="] = "ne",
                ["<"] = "lt",
                ["<="] = "le",
                [">"] = "lt",
                [">="] = "le"
            }
            -- An erased assertion can claim uint64 for a negative or fractional
            -- value. Only these producer nodes establish an unsigned operand;
            -- other operations retain the wide helper's coercion contract.
            if family == "u64" and unsignedProducer(node.lhs) and unsignedProducer(node.rhs) then
                local direct = {["+"] = "IAdd", ["-"] = "ISub", ["&"] = "IAnd", ["|"] = "IOr", ["~"] = "IXor"}
                if direct[op] then
                    local a = exprAs(f, node.lhs, "u")
                    local b = exprAs(f, node.rhs, "u")
                    local d = f:freg()
                    f:op(direct[op], d, a, b)
                    return d, "u"
                end
            end
            -- Equality keeps its value contract even when flow analysis has
            -- narrowed an optional producer to an integer. A missing byte
            -- or open result still compares with nil without conversion.
            if op == "/" or op == "^" or op == "==" or op == "~=" then
                family = nil
            end
            if family and operations[op] then
                local args = (op == ">" or op == ">=") and {node.rhs, node.lhs} or {node.lhs, node.rhs}
                return wideOperation(
                    f,
                    "wide." .. family .. "." .. operations[op],
                    args,
                    (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil
                )
            end
        end
        if k == "unop"
            and tokText(node.op) == "~"
            and not wide
            and (not node.inferredType or tyTag(node.inferredType) == "any" or tyTag(node.inferredType) == "number")
        then
            wide = "i64"
        end
        if k == "unop" and wide and (tokText(node.op) == "-" or tokText(node.op) == "~") then
            return wideOperation(
                f,
                "wide." .. wide .. (tokText(node.op) == "-" and ".neg" or ".not"),
                {node.operand},
                (want ~= "f" and want ~= "i" and want ~= "u") and dst or nil
            )
        end
        if k == "number" then
            local n = assert(tonumber(tokText(node.token)), "invalid numeric literal")
            if want ~= "i" and want ~= "u" and want ~= "f" then
                dst = dst or f:reg();
                f:op("K", dst, f:const("num", n));
                return dst, "v"
            end
            if want == "i" and isIntegerish(node) then
                local ir = f:freg();
                f:op("IK", ir, string.format("%d", n));
                return ir, "i"
            end
            local fr = f:freg();
            f:op("FK", fr, n)
            return fr, "f"
        end
        if k == "binop"
            and isIntegerish(node.lhs)
            and isIntegerish(node.rhs)
            and (want == "i" or want == "f" or not (valueDomain(f, node.lhs) and valueDomain(f, node.rhs)))
        then
            local op = tokText(node.op)
            local map = {["+"] = "IAdd", ["-"] = "ISub"}
            if map[op] then
                local a = exprAs(f, node.lhs, "i");
                local bb = exprAs(f, node.rhs, "i");
                local d = f:freg();
                f:op(map[op], d, a, bb);
                return d, "i"
            end
            local cmp = {["<"] = "ICmpSLt", ["<="] = "ICmpSLe", [">"] = "ICmpSLt", [">="] = "ICmpSLe"}
            if cmp[op] then
                local a = exprAs(f, node.lhs, "i");
                local bb = exprAs(f, node.rhs, "i");
                local i = f:freg()
                if op == ">" or op == ">=" then
                    f:op(cmp[op], i, bb, a)
                else
                    f:op(cmp[op], i, a, bb)
                end
                if want == "cond" then
                    return i, "b"
                end
                local d = f:reg();
                f:op("BoolFromI", d, i);
                return d, "v"
            end
        end
        if numeric and k == "binop" then
            local op = tokText(node.op)
            local map = {["+"] = "FAdd", ["-"] = "FSub", ["*"] = "FMul", ["/"] = "FDiv", ["%"] = "FMod"}
            if map[op]
                and isNumeric(node.lhs.inferredType)
                and isNumeric(node.rhs.inferredType)
                and want ~= "f"
                and want ~= "i"
                and valueDomain(f, node.lhs)
                and valueDomain(f, node.rhs)
            then
                local a = exprAs(f, node.lhs, "v");
                local b = exprAs(f, node.rhs, "v")
                local vmap = {["+"] = "Add", ["-"] = "Sub", ["*"] = "Mul", ["/"] = "Div", ["%"] = "Mod"}
                dst = dst or f:reg();
                f:op(vmap[op], dst, a, b);
                return dst, "v"
            end
            if map[op] and isNumeric(node.lhs.inferredType) and isNumeric(node.rhs.inferredType) then
                local a = exprAs(f, node.lhs, "f");
                local b = exprAs(f, node.rhs, "f")
                local d = f:freg();
                f:op(map[op], d, a, b);
                return d, "f"
            end
        end
        if k == "binop" and tokText(node.op) == "//" then
            local a = exprAs(f, node.lhs, "v");
            local b = exprAs(f, node.rhs, "v")
            dst = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg();
            f:op("IDiv", dst, a, b);
            return dst, "v"
        end
        if k == "binop" and tokText(node.op) == "^" then
            local a = exprAs(f, node.lhs, "v");
            local b = exprAs(f, node.rhs, "v")
            dst = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or f:reg();
            f:op("Pow", dst, a, b);
            return dst, "v"
        end
        if k == "binop" and BITOPS[tokText(node.op)] then
            local a = exprAs(f, node.lhs, "i");
            local b = exprAs(f, node.rhs, "i");
            local d = f:freg();
            f:op(BITOPS[tokText(node.op)], d, a, b);
            return d, "i"
        end
        if k == "unop" and tokText(node.op) == "~" then
            local a = exprAs(f, node.operand, "i");
            local d = f:freg();
            f:op("INot", d, a);
            -- A narrow unsigned complement stays in its width, as the binary
            -- operators' results do.
            local ty = node.inferredType
            while type(ty) == "table" and ty.tag == "literal" and ty.base do
                ty = ty.base
            end
            local masks = {uint8 = 0xFF, uint16 = 0xFFFF, uint32 = 0xFFFFFFFF}
            local mask = type(ty) == "table" and masks[ty.tag]
            if mask then
                local m = f:freg()
                f:op("IK", m, mask)
                f:op("IAnd", d, d, m)
            end
            return d, "i"
        end
        if numeric and k == "unop" and tokText(node.op) == "-" then
            local a = exprAs(f, node.operand, "f");
            local d = f:freg();
            f:op("FNeg", d, a);
            return d, "f"
        end
        if numeric and k == "unop" and tokText(node.op) == "#" then
            if want ~= "f" and want ~= "i" and want ~= "u" then
                local a = exprAs(f, node.operand, "v");
                dst = dst or f:reg();
                f:op("Len", dst, a);
                return dst, "v"
            end
            local a = exprAs(f, node.operand, "v");
            local d = f:freg();
            f:op("LenF", d, a);
            return d, "f"
        end
        if k == "vararg" then
            dst = dst or f:reg();
            f:op("VarargN", dst, 1);
            return dst, "v"
        elseif k == "isExpr" then
            return emitIs(f, node, dst)
        elseif k == "name" then
            local name = tokText(node.token)
            local r, c, cell, spill = f:lookup(name)
            if spill then
                local d = f:loadSpill(spill)
                if cell then
                    f:op("GetCell", d, d)
                end
                if numeric and want == "f" then
                    local fr = f:freg();
                    f:op("FUnbox", fr, d);
                    return fr, "f"
                end
                return d, "v"
            end
            if r and cell then
                local d = f:reg();
                f:op("GetCell", d, r)
                if numeric and want == "f" then
                    local fr = f:freg();
                    f:op("FUnbox", fr, d);
                    return fr, "f"
                end
                return d, "v"
            end
            if r then
                return r, c
            end
            local ui = f:upvalue(name)
            if ui then
                local cellReg = f:upvalReg(ui)
                local d = f:reg();
                f:op("GetCell", d, cellReg)
                if numeric and want == "f" then
                    local fr = f:freg();
                    f:op("FUnbox", fr, d);
                    return fr, "f"
                end
                return d, "v"
            end
        end
        if numeric and k == "dotIndex" then
            local shape = shapeOf(node.obj.inferredType)
            local fname = tokText(node.name)
            if shape
                and not shape.physical
                and shape.slotIndex[fname]
                and shape.slots[shape.slotIndex[fname] + 1].ty == "num"
            then
                local o = exprAs(f, node.obj, "v")
                local d = f:freg();
                f:op("GetSlotF", d, o, shape.slotIndex[fname], shape.id);
                return d, "f"
            end
        end
        if numeric and k == "bracketIndex" then
            local o = exprAs(f, node.obj, "v");
            local d = f:reg()
            local i, keyClass = indexOperand(f, node.expr)
            f:op(keyClass == "i" and "GetIdxI" or keyClass == "f" and "GetIdxF" or "GetIdx", d, o, i)
            if want == "i" and integer then
                local ir = f:freg();
                f:op("IUnbox", ir, d);
                return ir, "i"
            end
            if want == "f" then
                local fr = f:freg();
                f:op("FUnbox", fr, d);
                return fr, "f"
            end
            return d, "v"
        end
        if k == "binop" then
            local op = tokText(node.op)
            local cmp = {
                ["<"] = "FCmpLt",
                ["<="] = "FCmpLe",
                [">"] = "FCmpLt",
                [">="] = "FCmpLe",
                ["=="] = "FCmpEq",
                ["~="] = "FCmpNe"
            }
            if cmp[op]
                and isNumeric(node.lhs.inferredType)
                and isNumeric(node.rhs.inferredType)
                and not (valueDomain(f, node.lhs) and valueDomain(f, node.rhs))
                and not ((op == "==" or op == "~=") and (valueDomain(f, node.lhs) or valueDomain(f, node.rhs)))
            then
                local a = exprAs(f, node.lhs, "f");
                local b = exprAs(f, node.rhs, "f")
                local i = f:freg()
                if op == ">" or op == ">=" then
                    f:op(cmp[op], i, b, a)
                else
                    f:op(cmp[op], i, a, b)
                end
                if want == "cond" then
                    return i, "b"
                end
                local d = f:reg();
                f:op("BoolFromI", d, i);
                return d, "v"
            end
        elseif k == "doExpr" then
            -- A block whose `yield v` statements each end it with a value.
            dst = dst or f:reg()
            f.yields = f.yields or {}
            f.yields[#f.yields + 1] = {dst = dst, done = f:label(), depth = f.cleanupDepth or 0}
            block(f, node.body)
            local y = table.remove(f.yields)
            f:place(y.done)
            return dst, "v"
        elseif k == "switchExpr" then
            dst = dst or f:reg()
            local subject = f:reg()
            exprAs(f, node.selector, "v", subject)
            f:op("Nil", dst)
            f:push()
            local selectorName = "\0switch" .. subject
            f.scopes[#f.scopes][selectorName] = new lowerstate.Binding(reg = subject, class = "v")
            local selector = {kind = "name", token = {text = selectorName}}
            local mark, fmark = f.nregs, f.nfregs
            local done = f:label()
            for _, arm in ipairs(node.cases or {}) do
                local matched = f:reg()
                if arm.patternKind == "static" then
                    local found = f:label()
                    for _, value in ipairs(arm.values or {}) do
                        local candidate = exprAs(f, value, "v")
                        f:op("Eq", matched, subject, candidate)
                        f:branch("JmpIf", matched, found)
                    end
                    f:place(found)
                else
                    emitIs(f, {type = arm.type, expr = selector}, matched)
                end
                coverBranch(f, arm, matched)
                local nextArm = f:label()
                f:branch("JmpIfNot", matched, nextArm)
                f:push()
                coverStatement(f, arm)

                local function bind(name, value)
                    local reg, cell = f:declare(name, "v")
                    f:op(cell and "NewCell" or "Move", reg, value)
                end

                if arm.binding then
                    bind(tokText(arm.binding), subject)
                end
                for _, field in ipairs(arm.fields or {}) do
                    local value = f:reg()
                    f:op("GetField", value, subject, f:const("str", tokText(field.name)))
                    bind(tokText(field.alias or field.name), value)
                end
                if arm.guard and arm.guard.expr then
                    condBranch(f, arm.guard.expr, nil, nextArm)
                end
                exprAs(f, arm.expr or {kind = "doExpr", body = arm.body}, "v", dst)
                f:jump(done)
                f:pop()
                f:place(nextArm)
                f.nregs, f.nfregs = mark, fmark
            end
            if node.elseCase then
                local arm = node.elseCase
                coverStatement(f, arm)
                exprAs(f, arm.expr or {kind = "doExpr", body = arm.body}, "v", dst)
            end
            f:place(done)
            f:pop()
            return dst, "v"
        end
        -- Everything else lands in a value register.
        dst = (want ~= "f" and want ~= "i" and want ~= "u" and dst) or nil
        dst = dst or f:reg()
        if k == "number" then
            f:op("K", dst, f:const("num", assert(tonumber(tokText(node.token)))))
        elseif k == "string" then
            -- Decoded by the lexer's rules rather than by `loadstring`, which on
            -- the VM compiles a chunk holding this same literal and so never
            -- returns for one its fast path cannot read.
            local raw = tokText(node.token)
            local value = raw
            local first = raw:sub(1, 1)
            if first == '"' or first == "'" or first == "`" then
                value = assert(require("nupp.compiler.syntax.lexer").stringValue(raw), "literal " .. raw)
            elseif first == "[" then
                local equals = assert(raw:match("^%[(=*)%["), "literal " .. raw)
                local body = raw:sub(#equals + 3, #raw - #equals - 2)
                -- Lua reads each of \n, \r, \r\n and \n\r in a long string as one
                -- newline, and drops the newline that follows the opener.
                body = body:gsub("\r\n", "\n"):gsub("\n\r", "\n"):gsub("\r", "\n")
                value = body:sub(1, 1) == "\n" and body:sub(2) or body
            end
            f:op("K", dst, f:const("str", value))
        elseif k == "orExitExpr" then
            -- `e or return`, `e or break`, `e or continue`: the operand runs once into
            -- fixed registers, its first value decides, and that value is the
            -- expression's. `or return` returns the whole pack through an ordinary
            -- return, so it discharges what it leaves as a written one would.
            local width = node.exitKind == "return" and math.max(node.orExitWidth or 1, 1) or 1
            local base = f.nregs
            while f.nregs < base + width + 8 do
                f:reg()
            end
            if width > 1 and multiCall(node.operand) then
                emitCall(f, node.operand, base, width)
            else
                exprAs(f, node.operand, "v", base)
                for index = 2, width do
                    f:op("Nil", base + index - 1)
                end
            end
            local proceed = f:label()
            f:branch("JmpIf", base, proceed)
            if node.exitKind == "return" then
                local values = {}
                for index = 1, width do
                    values[index] = {kind = "vmRegister", reg = base + index - 1}
                end
                stmt(f, {kind = "returnStmt", exprs = values})
            else
                stmt(f, {kind = node.exitKind == "break" and "breakStmt" or "continueStmt"})
            end
            f:place(proceed)
            f:op("Move", dst, base)
        elseif k == "istring" then
            -- `text ${value} text`: each literal piece as written, each value
            -- through the `tostring` builtin (never a local of that name), joined
            -- left to right.
            local started = false
            local mark = f.nregs
            for _, child in ipairs(node) do
                local piece = nil
                if child.kind == "istringOpen" or child.kind == "istringMid" then
                    piece = tokText(child):sub(2, -3)
                elseif child.kind == "istringClose" then
                    piece = tokText(child):sub(2, -2)
                end
                local value = nil
                if piece ~= nil then
                    if #piece > 0 then
                        local lexer = require("nupp.compiler.syntax.lexer")
                        value = f:reg()
                        f:op("K", value, f:const("str", assert(lexer.stringValue("`" .. piece .. "`"), piece)))
                    end
                elseif type(child) == "table" and child.kind then
                    value = builtinRegisters(f, "tostring", {exprAs(f, child, "v")})
                end
                if value then
                    if started then
                        f:op("Concat", dst, dst, value)
                    else
                        f:op("Move", dst, value)
                        started = true
                    end
                    f.nregs = math.max(mark, f.declTop or 0)
                end
            end
            if not started then
                f:op("K", dst, f:const("str", ""))
            end
        elseif k == "dedentString" then
            local lexer = require("nupp.compiler.syntax.lexer")
            f:op("K", dst, f:const("str", lexer.dedentLongString(tokText(node.token))))
        elseif k == "trueExpr" then
            f:op("K", dst, f:const("true", ""))
        elseif k == "falseExpr" then
            f:op("K", dst, f:const("false", ""))
        elseif k == "nil" or k == "nilExpr" then
            f:op("Nil", dst)
        elseif node.namespacePath
            and (node.namespacePath == "nupp.math" or node.namespacePath:sub(1, 10) == "nupp.math.")
        then
            queueModule("nupp.vm.math")
            f:op("Require", dst, f:const("str", "nupp.vm.math"))
            for member in node.namespacePath:sub(11):gmatch("[^.]+") do
                local value = f:reg()
                f:op("GetField", value, dst, f:const("str", member))
                f:op("Move", dst, value)
            end
        elseif (k == "name" or k == "dotIndex") and (node.qualifiedModule or node.compilerModule) then
            -- The checker resolves namespace projections, including shadowing.
            -- A matching file alone is not evidence of a runtime module.
            local name = node.qualifiedModule or node.compilerModule
            queueModule(name)
            f:op("Require", dst, f:const("str", name))
            for _, member in ipairs(node.qualifiedMembers or {}) do
                local t = f:reg();
                f:op("GetField", t, dst, f:const("str", member));
                f:op("Move", dst, t)
            end
        elseif k == "name" then
            local name = tokText(node.token)
            if environment then
                f:globals(dst)
                local value = f:reg()
                f:op("GetField", value, dst, f:const("str", name))
                f:op("Move", dst, value)
            elseif BUILTINS[name] then
                f:op("K", dst, f:const("builtin", name))
            elseif name == "pcall" then
                f:op("K", dst, f:const("builtin", "pcall"))
            elseif GLOBAL_MODULES[name] then
                f:op("Require", dst, f:const("str", name))
            elseif name == "loadstring" or name == "load" then
                f:op("K", dst, f:const("builtin", "loadstring"))
            elseif name == "require" then
                f:op("K", dst, f:const("builtin", "require"))
            else
                -- Unbound Lua names read the global table. Checked Nupp names
                -- have already passed resolution before reaching the emitter.
                f:op("Require", dst, f:const("str", "_G"));
                local t = f:reg();
                f:op("GetField", t, dst, f:const("str", name));
                f:op("Move", dst, t)
            end
        elseif k == "binop" then
            local op = tokText(node.op)
            -- The result lands in `dst`, allocated before the operands, so every
            -- register they take is dead once the operation is emitted.
            local operandMark, operandFloatMark = f.nregs, f.nfregs
            if op == "and" or op == "or" then
                exprAs(f, node.lhs, "v", dst)
                local settled = f:label()
                f:branch(op == "and" and "JmpIfNot" or "JmpIf", dst, settled)
                exprAs(f, node.rhs, "v", dst)
                f:place(settled)
            elseif op == "??" then
                exprAs(f, node.lhs, "v", dst)
                local n = f:reg();
                f:op("Nil", n);
                local c = f:reg();
                f:op("Ne", c, dst, n)
                local settled = f:label()
                f:branch("JmpIf", c, settled)
                exprAs(f, node.rhs, "v", dst)
                f:place(settled)
            elseif op == ".." then
                -- A chain `a .. b .. c ..` is one accumulator and one operand at a
                -- time: string concatenation associates, and nesting it right as
                -- the grammar does would hold a register per operand.
                local parts = {}
                local dispatching = false

                local function flatten(n)
                    if n.kind == "binop" and tokText(n.op) == ".." then
                        dispatching = dispatching or n.plainConcat ~= true
                        flatten(n.lhs);
                        flatten(n.rhs)
                    else
                        parts[#parts + 1] = n
                    end
                end

                flatten(node)
                local mark = f.nregs
                if dispatching and #parts > 2 then
                    -- An operand that may carry `__concat` sees the chain as
                    -- Lua builds it: every operand evaluated in order, then
                    -- joined from the right, so `a .. t .. b` asks `t .. b` first.
                    local held = {}
                    for i = 1, #parts do
                        held[i] = f:reg()
                        exprAs(f, parts[i], "v", held[i])
                    end
                    f:op("Concat", dst, held[#parts - 1], held[#parts])
                    for i = #parts - 2, 1, -1 do
                        f:op("Concat", dst, held[i], dst)
                    end
                else
                    exprAs(f, parts[1], "v", dst)
                    for i = 2, #parts do
                        f.nregs = math.max(mark, f.declTop or 0)
                        local b = exprAs(f, parts[i], "v")
                        f:op("Concat", dst, dst, b)
                    end
                end
            else
                local a = exprAs(f, node.lhs, "v");
                local b = exprAs(f, node.rhs, "v")
                -- Bitwise operators on values the checker did not type as
                -- integers are LuaJIT's 32-bit `bit` library, as the Lua backend
                -- spelled them.
                local bitwise = {
                    ["&"] = "bit.band",
                    ["|"] = "bit.bor",
                    ["~"] = "bit.bxor",
                    ["<<"] = "bit.lshift",
                    [">>"] = "bit.rshift",
                    ["~>>"] = "bit.arshift"
                }
                local map = {
                    ["^"] = "Pow",
                    ["//"] = "IDiv",
                    ["+"] = "Add",
                    ["-"] = "Sub",
                    ["*"] = "Mul",
                    ["/"] = "Div",
                    ["%"] = "Mod",
                    ["<"] = "Lt",
                    ["<="] = "Le",
                    ["=="] = "Eq",
                    [".."] = "Concat",
                    ["~="] = "Ne",
                    [">"] = "Gt",
                    [">="] = "Ge"
                }
                local name = bitwise[op] or assert(map[op], "operator " .. op)
                if bitwise[op] then
                    builtinRegisters(f, name, {a, b}, dst)
                elseif name == "Gt" then
                    f:op("Lt", dst, b, a)
                elseif name == "Ge" then
                    f:op("Le", dst, b, a)
                else
                    f:op(name, dst, a, b)
                end
            end
            f.nregs = math.max(operandMark, f.declTop or 0)
            f.nfregs = math.max(operandFloatMark, f.fdeclTop or 0)
        elseif k == "unop" then
            local op = tokText(node.op)
            local a = exprAs(f, node.operand, "v")
            if op == "not" then
                f:op("Not", dst, a)
            elseif op == "-" then
                f:op("Neg", dst, a)
            elseif op == "#" then
                f:op("Len", dst, a)
            else
                error("unop " .. op)
            end
        elseif k == "ternary" then
            local c = exprAs(f, node.cond, "v")
            local otherwise, done = f:label(), f:label()
            f:branch("JmpIfNot", c, otherwise)
            exprAs(f, node.ifTrue, "v", dst)
            f:jump(done)
            f:place(otherwise)
            exprAs(f, node.ifFalse, "v", dst)
            f:place(done)
        elseif k == "dotIndex" then
            local fname = node.overloadMember or tokText(node.name)
            if not environment
                and node.obj.kind == "name"
                and LIBS[tokText(node.obj.token)]
                and not f:binding(tokText(node.obj.token))
            then
                local full = tokText(node.obj.token) .. "." .. fname
                -- Library members that are values rather than functions.
                if full == "math.huge" then
                    f:op("K", dst, f:const("num", math.huge))
                elseif full == "math.pi" then
                    f:op("K", dst, f:const("num", math.pi))
                elseif BUILTINS[full] then
                    f:op("K", dst, f:const("builtin", full))
                else
                    f:op("Require", dst, f:const("str", tokText(node.obj.token)));
                    local t = f:reg();
                    f:op("GetField", t, dst, f:const("str", fname));
                    f:op("Move", dst, t)
                end
            else
                local shape = shapeOf(node.obj.inferredType)
                local o = exprAs(f, node.obj, "v")
                local slot = shape and not shape.physical and shape.slotIndex[fname]
                if slot then
                    f:op("GetSlot", dst, o, slot, shape.id)
                else
                    f:op("GetField", dst, o, f:const("str", fname))
                end
                if node.fieldTake then
                    -- A field taken out of a record whose own cleanup closes it
                    -- leaves nil behind, so that cleanup finds nothing to close twice.
                    local none = f:reg()
                    f:op("Nil", none)
                    if slot then
                        f:op("SetSlot", o, slot, none, shape.id)
                    else
                        f:op("SetField", o, f:const("str", fname), none)
                    end
                end
            end
        elseif k == "bracketIndex" then
            local o = exprAs(f, node.obj, "v")
            local i, keyClass = indexOperand(f, node.expr)
            f:op(keyClass == "i" and "GetIdxI" or keyClass == "f" and "GetIdxF" or "GetIdx", dst, o, i)
        elseif k == "call" or k == "methodCall" or k == "safeCall" then
            emitCall(f, node, dst)
        elseif k == "safeIndex" or k == "safeBracket" then
            -- `o?.name` and `o?.[key]`: nil when `o` is.
            local o = exprAs(f, node.obj, "v")
            f:op("Nil", dst)
            local present = f:reg()
            f:op("Ne", present, o, dst)
            local skip = f:label()
            f:branch("JmpIfNot", present, skip)
            if k == "safeIndex" then
                f:op("GetField", dst, o, f:const("str", node.overloadMember or tokText(node.name)))
            else
                local key = exprAs(f, node.expr, "v")
                f:op("GetIdx", dst, o, key)
            end
            f:place(skip)
        elseif k == "newExpr" then
            local call = node.call
            if call.constructorCall then
                local lowered = {}
                for key, value in pairs(call) do
                    lowered[key] = value
                end
                lowered.constructorCall = nil
                lowered.obj = {
                    kind = "dotIndex",
                    obj = call.obj,
                    name = {text = "__nuppCtor" .. tostring(call.constructorIndex or 1)}
                }
                emitCall(f, lowered, dst)
                return dst, "v"
            end
            local shape = shapeOf(node.inferredType)
            if not shape then
                local t = node.inferredType
                local keys = {}
                if type(t) == "table" then
                    for k, v in pairs(t) do
                        keys[
                            #keys + 1
                        ] = k .. "=" .. (
                            type(v) == "table" and ("{" .. tostring(v.tag) .. ":" .. tostring(v.name) .. "}")
                            or tostring(v)
                        )
                    end
                end
                table.sort(keys)
                error(
                    "new of unknown record " .. tostring(
                        type(t) == "table" and t.name or tyTag(t)
                    ) .. " [" .. table.concat(keys, " ") .. "]"
                )
            end
            -- A record or struct another module declares (a `global struct` among
            -- them) carries what that module's image attaches, so it loads first.
            if shape.module and shape.module ~= currentModule then
                local loaded = f:reg()
                f:op("Require", loaded, f:const("str", shape.module))
            end
            local instance = shape.physical
                and not shape.layout.supported
                and tyTag(node.inferredType) == "nominal"
                and node.inferredType.origin
                and node.inferredType
                or nil
            local instanceLayout = instance
                and require(
                    "nupp.compiler.vm.metadata"
                ).structLayout({resolvedType = instance, name = {text = instance.name}}, layoutTarget)
                or nil
            if instanceLayout and instanceLayout.supported then
                -- An instance of a generic struct is a storage type of its own,
                -- defined (once, by identity) where it is first constructed and
                -- sharing its declaration's methods.
                local described = exprAs(f, require("nupp.compiler.vm.metadata").literal(instanceLayout), "v")
                local witness = exprAs(
                    f,
                    assert(call.vmStructWitness or call.obj, "struct construction has no witness"),
                    "v"
                )
                local physical = builtinRegisters(f, "storage.structDefine", {described, witness})
                emitCall(
                    f,
                    {
                        kind = "methodCall",
                        obj = {kind = "vmRegister", reg = physical},
                        name = {text = "new"},
                        args = {exprs = {}}
                    },
                    dst
                )
            elseif shape.physical then
                if not shape.layout.supported then
                    local reason = f:reg()
                    f:op("K", reason, f:const("str", shape.layout.error))
                    builtinRegisters(f, "error", {reason}, dst)
                    return dst, "v"
                end
                emitCall(
                    f,
                    {
                        kind = "methodCall",
                        obj = structDescriptor(
                            assert(call.vmStructWitness or call.obj, "struct construction has no witness")
                        ),
                        name = {text = "new"},
                        args = {exprs = {}}
                    },
                    dst
                )
            else
                f:op("NewRecord", dst, shape.id)
            end
            local fields = call.recordFields
            if not fields then
                fields = {}
                for _, argument in ipairs(call.args.exprs or {}) do
                    assert(argument.kind == "namedArg", "unchecked positional construction in " .. f.name)
                    fields[#fields + 1] = {name = tokText(argument.name), node = argument.value}
                end
            end
            assert(
                not (shape.physical and shape.layout.kind == "union") or #fields <= 1,
                "a union constructor initializes at most one member"
            )
            local fieldMark, fieldFloatMark = f.nregs, f.nfregs
            for _, field in ipairs(fields) do
                f.nregs = math.max(fieldMark, f.declTop or 0)
                f.nfregs = math.max(fieldFloatMark, f.fdeclTop or 0)
                local slot = shape.slotIndex[field.name]
                assert(
                    slot or not shape.physical,
                    "constructor field " .. field.name .. " missing from " .. tostring(
                        shape.module
                    ) .. "." .. shape.name .. " in " .. tostring(
                        f.module
                    ) .. "." .. f.name .. " at line " .. tostring(nodeLine(node))
                )
                local value = field.isDefault and require("nupp.compiler.vm.metadata").literal(field.defaultValue)
                    or field.node
                if shape.physical then
                    local v = exprAs(f, value, "v")
                    local physical = physicalField(shape, field.name)
                    if physical then
                        physicalSet(f, dst, physical, v)
                    else
                        f:op("SetField", dst, f:const("str", field.name), v)
                    end
                elseif not slot then
                    -- An inherited optional member, kept in the overflow part.
                    local v = exprAs(f, value, "v");
                    f:op("SetField", dst, f:const("str", field.name), v)
                elseif shape.slots[slot + 1].ty == "num" and isNumeric(value.inferredType) then
                    local v = exprAs(f, value, "f");
                    f:op("SetSlotF", dst, slot, v, shape.id)
                else
                    local v = exprAs(f, value, "v");
                    f:op("SetSlot", dst, slot, v, shape.id)
                end
            end
            -- A function member the construction leaves out is what the
            -- declaration's table holds under that name, which on LuaJIT the
            -- instance reaches through `__index`: `function R.f` defines it.
            local nominal = tyTag(node.inferredType) == "nominal" and node.inferredType or nil
            local declaration = call.obj or call.vmStructWitness
            if nominal and declaration and not shape.physical then
                local given = {}
                for _, field in ipairs(fields) do
                    given[field.name] = true
                end
                local missing = {}
                for _, slot in ipairs(shape.slots) do
                    local member = nominal.byname and nominal.byname[slot.name]
                    if not given[slot.name] and tyTag(member) == "func" then
                        missing[#missing + 1] = slot.name
                    end
                end
                if #missing > 0 then
                    f.nregs = math.max(fieldMark, f.declTop or 0)
                    f.nfregs = math.max(fieldFloatMark, f.fdeclTop or 0)
                    local owner = exprAs(f, declaration, "v")
                    local v = f:reg()
                    for _, member in ipairs(missing) do
                        f:op("GetField", v, owner, f:const("str", member))
                        f:op("SetSlot", dst, shape.slotIndex[member], v, shape.id)
                    end
                end
            end
        elseif k == "tableExpr" then
            local items, named = 0, 0
            for _, field in ipairs(node.fields) do
                if field.kind == "fieldItem" then
                    items = items + 1
                else
                    named = named + 1
                end
            end
            local struct = items == 0 and structShape(node.inferredType)
            if struct then
                local every = true
                for _, field in ipairs(node.fields) do
                    if field.kind ~= "fieldNamed" or not struct.slotIndex[tokText(field.name)] then
                        every = false
                    end
                end
                if every then
                    f:op("NewRecord", dst, struct.id)
                    local fieldMark, fieldFloatMark = f.nregs, f.nfregs
                    for _, field in ipairs(node.fields) do
                        f.nregs = math.max(fieldMark, f.declTop or 0)
                        f.nfregs = math.max(fieldFloatMark, f.fdeclTop or 0)
                        local slot = struct.slotIndex[tokText(field.name)]
                        if struct.slots[slot + 1].ty == "num" and isNumeric(field.value.inferredType) then
                            local fv = exprAs(f, field.value, "f");
                            f:op("SetSlotF", dst, slot, fv, struct.id)
                        else
                            local v = exprAs(f, field.value, "v");
                            f:op("SetSlot", dst, slot, v, struct.id)
                        end
                    end
                    return dst, "v"
                end
            end
            if items == 1 and named == 0 and node.fields[1].value and node.fields[1].value.kind == "vararg" then
                f:op("VarargTable", dst);
                return dst, "v"
            end
            f:op("NewTableN", dst, math.min(items, 255), math.min(named, 255))
            local n = 0
            -- Each field's temporaries die with it: a constructor with hundreds
            -- of entries must not hold a register per entry.
            local fieldMark, fieldFloatMark = f.nregs, f.nfregs
            for fieldIndex, field in ipairs(node.fields) do
                f.nregs = math.max(fieldMark, f.declTop or 0)
                f.nfregs = math.max(fieldFloatMark, f.fdeclTop or 0)
                if field.kind == "fieldNamed" then
                    local v = exprAs(f, field.value, "v")
                    f:op("SetField", dst, f:const("str", tokText(field.name)), v)
                elseif field.kind == "fieldItem" then
                    n = n + 1
                    local i = f:reg();
                    f:op("K", i, f:const("num", n))
                    if fieldIndex == #node.fields and multiCall(field.value) then
                        -- Append exactly the trailing call's result pack, including
                        -- nil holes, without treating its capacity as its length.
                        local base = f:reg()
                        while f.nregs < base + 11 do
                            f:reg()
                        end
                        local callee = f:reg()
                        f:op("K", callee, f:const("builtin", "vm.tableAppendResults"))
                        f:op("Move", base + 1, dst)
                        f:op("Move", base + 2, i)
                        emitCall(f, field.value, base + 3, 8, true)
                        f:op("CallDyn", callee, base, 66)
                    elseif fieldIndex == #node.fields and field.value.kind == "vararg" then
                        -- A trailing vararg expands even after named or positional
                        -- fields. Count it explicitly so nil holes survive.
                        local values = f:reg()
                        f:op("VarargTable", values)
                        local count = f:reg()
                        local argument = f:reg()
                        local callee = f:reg()
                        f:op("K", argument, f:const("str", "#"))
                        f:op("K", callee, f:const("builtin", "select"))
                        f:op("CallDyn", callee, count, 129)
                        local index, one, condition, value = f:reg(), f:reg(), f:reg(), f:reg()
                        f:op("K", index, f:const("num", 1))
                        f:op("K", one, f:const("num", 1))
                        local top, done = f:label(), f:label()
                        f:place(top)
                        f:op("Le", condition, index, count)
                        f:branch("JmpIfNot", condition, done)
                        f:op("GetIdx", value, values, index)
                        f:op("SetIdx", dst, i, value)
                        f:op("Add", index, index, one)
                        f:op("Add", i, i, one)
                        f:jump(top)
                        f:place(done)
                    else
                        local v = exprAs(f, field.value, "v")
                        f:op("SetIdx", dst, i, v)
                    end
                elseif field.kind == "fieldBracket" then
                    local kreg = exprAs(f, field.key, "v");
                    local v = exprAs(f, field.value, "v")
                    f:op("SetIdx", dst, kreg, v)
                else
                    error("table field " .. field.kind)
                end
            end
        elseif k == "funcExpr" or k == "shortfn" then
            emitClosure(f, k == "shortfn" and node or node.body, dst, f.name .. ".fn" .. tostring(#functions))
        elseif k == "castExpr" and recordConstructorCast(f, node) then
            -- `setmetatable({...}, R) as R` and `{...} as R`: the table is built
            -- as a record of R's shape, so every later slot access finds the
            -- shape it assumed. Preserve an explicit metatable on the object.
            local shape, tbl, meta = recordConstructorCast(f, node)
            f:op("NewRecord", dst, shape.id)
            local mark = f.nregs
            for _, field in ipairs(tbl.fields) do
                f.nregs = math.max(mark, f.declTop or 0)
                local fname = tokText(field.name)
                local slot = shape.slotIndex[fname]
                if slot and shape.slots[slot + 1].ty == "num" and isNumeric(field.value.inferredType) then
                    local fv = exprAs(f, field.value, "f");
                    f:op("SetSlotF", dst, slot, fv, shape.id)
                elseif slot then
                    local v = exprAs(f, field.value, "v");
                    f:op("SetSlot", dst, slot, v, shape.id)
                else
                    local v = exprAs(f, field.value, "v");
                    f:op("SetField", dst, f:const("str", fname), v)
                end
            end
            if meta then
                f.nregs = math.max(mark, f.declTop or 0);
                local callee, result, object, metatable = f:reg(), f:reg(), f:reg(), f:reg()
                f:op("K", callee, f:const("builtin", "setmetatable"))
                f:op("Move", object, dst)
                exprAs(f, meta, "v", metatable)
                f:op("CallDyn", callee, result, 2)
            end
            f.nregs = math.max(mark, f.declTop or 0)
        elseif k == "castExpr" then
            local v = exprAs(f, node.expr, "v", dst)
            -- `as` only asserts a type to the checker. Preserve the value;
            -- typed loads and stores validate their own physical boundaries.
            if v ~= dst then
                f:op("Move", dst, v)
            end
        else
            error("expression kind " .. tostring(k) .. " in " .. f.name)
        end

        return dst, "v"
    end

    local plainExpr = expr

    -- A `comptime` block the checker ran stands for its value, which the checker
    -- quotes as a Lua expression of plain data; that expression is lowered instead.
    local function comptimeExpression(node)
        local parsed = node.vmComptimeExpression
        if not parsed then
            -- A materialized value is rendered to the same kind of expression text.
            local text = node.comptimeValue
            if not text then
                local rendered, failure = require("nupp.compiler.comptime.materialize.ir").render(node.materializedIR)
                text = rendered or error("checked materialization IR failed: " .. tostring(failure and failure.message))
            end
            local result = require("nupp.compiler.syntax.parser").parse("return " .. text, "=comptime")
            assert(#result.errors == 0, "comptime value does not parse: " .. tostring(text))
            parsed = (result.root.blocks[1].stats[1] as any).exprs[1]
            node.vmComptimeExpression = parsed
        end

        return parsed
    end

    expr = function(f: Fn, node, dst, want)
        if node.comptimeValue or node.materializedIR then
            return plainExpr(f, comptimeExpression(node), dst, want)
        end
        local r, class = plainExpr(f, node, dst, want)
        if node.automaticOwnerReinit and node.kind ~= "paren" and node.kind ~= "castExpr" then
            -- The value written into a moved (or never filled) owner takes over
            -- that owner's cleanup slots.
            local reinit = node.automaticOwnerReinit
            local slots = f.cleanupOwners and f.cleanupOwners[reinit.owner] or {}
            if #slots > 0 then
                local value = coerce(f, r, class, "v")
                for _, slot in ipairs(slots) do
                    if slot.cleanup and (not reinit.field or reinit.field == slot.field) then
                        local cleanup = slot.cleanup
                        if reinit.field and cleanup.kind == "field" then
                            cleanup = cleanup.cleanup
                        end
                        rearmCleanup(f, value, cleanup, slot.depth)
                    end
                end
            end
        end
        if node.automaticOwnerMove and node.kind ~= "paren" and node.kind ~= "castExpr" then
            local move = node.automaticOwnerMove
            local owner = move.owner or move
            for _, slot in ipairs(f.cleanupOwners and f.cleanupOwners[owner] or {}) do
                if not move.field or move.field == slot.field then
                    f:op("DisarmAt", slot.depth)
                end
            end
        end

        return r, class
    end

    -- A closure over `funcbody`: compiled as a nested function, its captures
    -- moved into place, the closure value landing in `dst`.
    emitClosure = function(f: Fn, funcbody, dst, name, implicitSelf: boolean?)
        local inner = newFn(name, f)
        inner.curLine = f.curLine
        inner.sig = {}
        inner.implicitSelf = implicitSelf
        -- A vararg parameter is not a fixed parameter. Surplus arguments
        -- remain in the frame and are read or spread when requested.
        local fixed = {}
        for _, p in ipairs(funcbody.params or {}) do
            if p.vararg then
                inner.vararg = true
            else
                fixed[#fixed + 1] = p
            end
        end
        for i = 1, #fixed + (implicitSelf and 1 or 0) do
            inner.sig[i] = "v"
        end
        inner.nparams = #fixed + (implicitSelf and 1 or 0)
        inner.ret = "v"
        markCaptures(inner, funcbody)
        defineFunction(inner, funcbody)
        local base = f:reg()
        while f.nregs < base + #inner.upvals + 1 do
            f:reg()
        end
        for i, u in ipairs(inner.upvals) do
            if u.kind == "local" then
                f:op("Move", base + i, u.reg)
            elseif u.kind == "spill" then
                f:loadSpill(u.key, base + i)
            else
                f:op("Move", base + i, f:upvalReg(u.index))
            end
        end
        -- Taking a capture freezes its value at construction. Ordinary captures
        -- keep sharing cells, while the moved owner has a private cell.
        for _, capture in ipairs(funcbody.takenCaptures or funcbody.vmCaptureDrops or {}) do
            local ui = assert(inner.upvalIndex[capture.name], "missing taken capture")
            local value = f:reg()
            f:op("GetCell", value, base + ui + 1)
            f:op("NewCell", base + ui + 1, value)
        end
        f:op("NewClosure", dst, inner.id, base, #inner.upvals)
        if #(funcbody.takenCaptures or {}) > 0 then
            local drop = f:reg()
            emitClosure(
                f,
                {params = {}, body = {stats = {}}, vmCaptureDrops = funcbody.takenCaptures},
                drop,
                name .. ".drop"
            )
            f:op("AffineMark", dst, drop)
            for _, capture in ipairs(funcbody.takenCaptures) do
                local move = capture.move
                local owner = move and (move.owner or move)
                local slots = f.cleanupOwners and f.cleanupOwners[owner]
                if not slots and capture.outer then
                    slots = f.cleanupOwners and f.cleanupOwners[capture.outer.automaticOwner]
                end
                for _, slot in ipairs(slots or {}) do
                    if not move or not move.field or move.field == slot.field then
                        f:op("DisarmAt", slot.depth)
                    end
                end
            end
        end

        return inner
    end

    -- Multiple results: evaluate `exprs` for `count` targets into consecutive
    -- registers from `base`, the last call supplying the remainder.
    -- A call whose results are open: an intrinsic's is exactly one.

    local function exprsInto(f: Fn, exprs, count, base)
        while f.nregs < base + count do
            f:reg()
        end
        for i, e in ipairs(exprs) do
            -- `nupp.partition` answers its two parts, as a call would.
            if i == #exprs
                and i < count
                and (multiCall(e) or e.kind == "call" and e.ownershipIntrinsic == "partition")
            then
                emitCall(f, e, base + i - 1, count - i + 1)
                return
            end
            if i == #exprs and i < count and e.kind == "vararg" then
                f:op("VarargN", base + i - 1, count - i + 1);
                return
            end
            if i <= count then
                exprAs(f, e, "v", base + i - 1)
            else
                expr(f, e, nil, "v")
            end
        end
        for i = #exprs + 1, count do
            f:op("Nil", base + i - 1)
        end
    end

    -- The names an `export <decl>` publishes, as the Lua backend chooses them.
    local function exportedNames(stat)
        local names = {}
        if stat.kind == "localFuncStmt" then
            names[1] = stat.name and tokText(stat.name)
        elseif stat.kind == "funcStmt" then
            local fname = stat.name
            local dotted = false
            for _, child in ipairs(fname or {}) do
                if type(child) == "table"
                    and child.kind == "name"
                    and child ~= fname.base
                    and child ~= fname.method
                then
                    dotted = true
                end
            end
            if fname and fname.base and not fname.method and not dotted then
                names[1] = tokText(fname.base)
            end
        elseif stat.kind == "localStmt" then
            for _, t in ipairs(stat.names or {}) do
                names[#names + 1] = tokText(t)
            end
        elseif stat.kind == "cdefFunc" then
            names[1] = stat.name and tokText(stat.name)
        elseif stat.kind == "cdefStruct"
            or stat.kind == "recordDecl"
            and (stat.declKind == "record" or stat.declKind == "struct" or stat.declKind == "interface")
        then
            names[1] = stat.name and tokText(stat.name)
        end

        return names
    end

    -- The shape of a declared module's export record: one slot per exported
    -- name, in declaration order; nil when the module assigns `export = v`.
    local function exportShape(moduleName, rootBlock)
        local names, seen = {}, {}
        for _, st in ipairs(rootBlock.stats or {}) do
            if st.kind == "exportStmt" then
                if st.value then
                    return nil
                end
                local stat = st.stat
                while stat and stat.kind == "pragmaStmt" do
                    stat = stat.stat
                end
                if stat and not (stat.comptimeFunction or stat.comptimeTok or stat.isAnnotationDefinition) then
                    for _, n in ipairs(exportedNames(stat)) do
                        if not seen[n] then
                            seen[n] = true;
                            names[#names + 1] = n
                        end
                    end
                end
            end
        end
        if #names == 0 then
            return nil
        end
        local shape = {
            id = #shapeOrder,
            name = "module:" .. moduleName,
            slots = {},
            slotIndex = {},
            module = moduleName
        }
        shapeOrder[#shapeOrder + 1] = shape
        for _, fname in ipairs(names) do
            shape.slotIndex[fname] = #shape.slots;
            shape.slots[#shape.slots + 1] = {name = fname, ty = "any"}
        end

        return shape
    end

    -- The bare function names a declared module exports: locals of the chunk
    -- from its first instruction, so a closure defined earlier can reach them.
    local function exportedFunctionNames(rootBlock)
        local names = {}
        for _, st in ipairs(rootBlock.stats or {}) do
            if st.kind == "exportStmt" and st.stat then
                local stat = st.stat
                while stat and stat.kind == "pragmaStmt" do
                    stat = stat.stat
                end
                if stat and stat.kind == "funcStmt" and not (stat.comptimeFunction or stat.comptimeTok) then
                    for _, name in ipairs(exportedNames(stat)) do
                        names[#names + 1] = name
                    end
                end
            end
        end

        return names
    end

    -- An assignment evaluates its targets' tables and keys left to right before
    -- any value, as Lua does: `t()[k()] = v()` calls t, k, then v.
    -- `held` copies each into a register of its own, for a multiple assignment
    -- whose values may rebind the locals a target names.
    local function prepareTarget(f: Fn, target, plainKey, held)
        local function evaluate(node, class)
            if not held then
                return exprAs(f, node, class)
            end
            local r = class == "v" and f:reg() or f:freg()
            exprAs(f, node, class, r)

            return r
        end

        -- A struct-of-arrays row is addressed through its view and index,
        -- which the store evaluates.
        if soaField(target) or target.kind == "bracketIndex" and target.soaRow then
            return nil
        end
        if target.kind == "dotIndex" then
            return {o = evaluate(target.obj, "v")}
        elseif target.kind == "bracketIndex" and target.indexedAccess and target.indexedAccess.adapter == "span" then
            return {o = evaluate(target.obj, "v"), i = evaluate(target.expr, "v"), class = "v"}
        elseif target.kind == "bracketIndex" then
            local o = evaluate(target.obj, "v")
            if plainKey then
                return {o = o, i = evaluate(target.expr, "v"), class = "v"}
            end
            local i, keyClass = indexOperand(f, target.expr)
            if held then
                local hold = keyClass == "v" and f:reg() or f:freg()
                coerce(f, i, keyClass, keyClass, hold)
                i = hold
            end
            return {o = o, i = i, class = keyClass}
        end

        return nil
    end

    local function assignTo(f: Fn, target, valueReg, prepared)
        if target.kind == "name" then
            local r, c, cell, spill = f:lookup(tokText(target.token))
            if spill then
                if cell then
                    local t = f:loadSpill(spill);
                    f:op("SetCell", t, valueReg)
                else
                    f:storeSpill(spill, valueReg)
                end
            elseif r and cell then
                f:op("SetCell", r, valueReg)
            elseif r then
                coerce(f, valueReg, "v", c, r)
            else
                local name = tokText(target.token)
                local ui = f:upvalue(name)
                if ui then
                    local cellReg = f:upvalReg(ui);
                    f:op("SetCell", cellReg, valueReg)
                else
                    local globals = f:reg();
                    f:globals(globals);
                    f:op("SetField", globals, f:const("str", name), valueReg)
                end
            end
        elseif target.kind == "dotIndex" and soaField(target) then
            local view, index, ordinal = soaField(target)
            soaAccess(f, "setField", view, {index, ordinal}, valueReg)
        elseif target.kind == "dotIndex" then
            local shape = shapeOf(target.obj.inferredType)
            local o = prepared and prepared.o or exprAs(f, target.obj, "v")
            local fname = tokText(target.name)
            local field = physicalField(shape, fname)
            if field then
                physicalSet(f, o, field, valueReg)
            elseif shape and not shape.physical and shape.slotIndex[fname] then
                local slot = shape.slotIndex[fname]
                if shape.slots[slot + 1].ty == "num" and isNumeric(target.inferredType) then
                    local fv = f:freg();
                    f:op("FUnbox", fv, valueReg);
                    f:op("SetSlotF", o, slot, fv, shape.id)
                else
                    f:op("SetSlot", o, slot, valueReg, shape.id)
                end
            else
                f:op("SetField", o, f:const("str", fname), valueReg)
            end
        elseif target.kind == "bracketIndex" then
            if target.indexedAccess and target.indexedAccess.adapter == "span" then
                local place = target
                if prepared then
                    place = {
                        kind = "bracketIndex",
                        obj = {kind = "vmRegister", reg = prepared.o},
                        expr = {kind = "vmRegister", reg = prepared.i},
                        indexedAccess = target.indexedAccess,
                    }
                end
                spanAccess(f, place, valueReg)
                return
            end
            if target.soaRow then
                soaAccess(f, "set", target.obj, {target.expr}, valueReg)
                return
            end
            if prepared then
                local op = prepared.class == "i" and "SetIdxI" or prepared.class == "f" and "SetIdxF" or "SetIdx"
                f:op(op, prepared.o, prepared.i, valueReg)
                return
            end
            local o = exprAs(f, target.obj, "v")
            local i, keyClass = indexOperand(f, target.expr)
            f:op(keyClass == "i" and "SetIdxI" or keyClass == "f" and "SetIdxF" or "SetIdx", o, i, valueReg)
        else
            error("assignment target " .. target.kind)
        end
    end

    local function loopBegin(f: Fn)
        f.breaks[
            #f.breaks + 1
        ] = new lowerstate.Loop(exit = f:label(), next = f:label(), cleanupDepth = f.cleanupDepth or 0)
    end

    -- Where `continue` lands: the loop's own next-round step, after the body.
    local function loopContinue(f: Fn)
        f:place(f.breaks[#f.breaks].next)
    end

    local function loopEnd(f: Fn)
        f:place(table.remove(f.breaks).exit)
    end

    -- A goto's unwind learns the depth of the label it leaves to.
    local function settleGoto(jump, label)
        assert(label.depth <= jump.depth, "goto enters a cleanup scope")
        jump.unwind[2] = label.depth
    end

    -- Cleanup selection comes from the checker's resolved affine terminals.
    local function cleanupRegistry(f: Fn)
        local globals, registry = f:reg(), f:reg()
        f:op("Require", globals, f:const("str", "_G"))
        local key = f:const("str", "__nuppCleanupRegistry")
        f:op("GetField", registry, globals, key)
        local exists = f:label()
        f:branch("JmpIf", registry, exists)
        f:op("NewTableN", registry, 0, 0)
        f:op("SetField", globals, key, registry)
        f:place(exists)

        return registry
    end

    local function cleanupReference(name)
        local result
        for member in name:gmatch("[^.]+") do
            result = result and {kind = "dotIndex", obj = result, name = {text = member}}
                or {kind = "name", token = {text = member}}
        end

        return result
    end

    registerCleanups = function(f: Fn, registrations, value)
        for _, registration in ipairs(registrations or {}) do
            local callback = value
            if callback == nil then
                callback = exprAs(f, cleanupReference(registration.cleanup.name), "v")
            end
            local registry = cleanupRegistry(f)
            f:op("SetField", registry, f:const("str", registration.cleanup.key), callback)
        end
    end

    -- Keyed by module name where the environment names the VM's declarations,
    -- and by their path where it does not.
    local coroutineCleanupSuffix = "/native/crates/vm/decls/nupp/vm/ownedCoroutine.d.nupp#__nuppCloseCoroutine"

    local function closesCoroutine(cleanup): boolean
        return cleanup.kind == "function"
            and (
                cleanup.key == "nupp.vm.ownedCoroutine#__nuppCloseCoroutine"
                or cleanup.key:sub(-#coroutineCleanupSuffix) == coroutineCleanupSuffix
            )
    end

    deferCleanup = function(f: Fn, value, cleanup, guard)
        if guard and cleanup.kind ~= "field" then
            local copy = f:reg()
            f:op("Move", copy, value)
            local kept = f:label()
            f:branch("JmpIf", guard, kept)
            f:op("Nil", copy)
            f:place(kept)
            value = copy
        end
        if cleanup.kind == "method" or cleanup.kind == "closure" then
            local name = cleanup.kind == "closure" and "__nuppRelease" or cleanup.name
            f:op("DeferMethod", value, f:const("str", name))
        elseif closesCoroutine(cleanup) then
            local callback = f:reg()
            f:op("K", callback, f:const("builtin", "tasks.coDispose"))
            f:op("Defer", value, callback)
        elseif cleanup.kind == "function" and cleanup.key == "nupp:lua.d.nupp#__nuppCloseFile" then
            local callback = f:reg()
            f:op("K", callback, f:const("builtin", "file.close"))
            f:op("Defer", value, callback)
        elseif cleanup.kind == "function" then
            local origin = cleanup.key:match("^(.-)#")
            local callback
            if origin == currentModule or origin == resolve(currentModule) then
                callback = exprAs(f, cleanupReference(cleanup.name), "v")
            else
                local registry = cleanupRegistry(f)
                callback = f:reg()
                f:op("GetField", callback, registry, f:const("str", cleanup.key))
            end
            f:op("Defer", value, callback)
        elseif cleanup.kind == "field" then
            -- An absent optional owner has no fields to close.
            local field = f:reg()
            local absent = f:reg()
            f:op("Nil", field)
            local skip = f:label()
            if guard then
                f:branch("JmpIfNot", guard, skip)
            end
            f:op("Eq", absent, value, field)
            f:branch("JmpIf", absent, skip)
            f:op("GetField", field, value, f:const("str", cleanup.field))
            f:place(skip)
            deferCleanup(f, field, cleanup.cleanup, guard)
            return
        else
            error("unsupported affine cleanup " .. tostring(cleanup.kind))
        end
        f.cleanupDepth = (f.cleanupDepth or 0) + 1
    end

    -- A reinitialized owner's slot takes the new value with the cleanup it was
    -- declared with; a method cleanup is named, and resolved on the value.
    rearmCleanup = function(f: Fn, value, cleanup, depth)
        if cleanup.kind == "field" then
            local field = f:reg()
            local present = f:reg()
            f:op("Nil", present)
            f:op("Eq", present, value, present)
            f:op("Move", field, value)
            local skip = f:label()
            f:branch("JmpIf", present, skip)
            f:op("GetField", field, value, f:const("str", cleanup.field))
            f:place(skip)
            rearmCleanup(f, field, cleanup.cleanup, depth)
            return
        end
        local callback = f:reg()
        if cleanup.kind == "method" or cleanup.kind == "closure" then
            f:op("K", callback, f:const("str", cleanup.kind == "closure" and "__nuppRelease" or cleanup.name))
        elseif closesCoroutine(cleanup) then
            f:op("K", callback, f:const("builtin", "tasks.coDispose"))
        elseif cleanup.kind == "function" and cleanup.key == "nupp:lua.d.nupp#__nuppCloseFile" then
            f:op("K", callback, f:const("builtin", "file.close"))
        elseif cleanup.kind == "function" then
            local origin = cleanup.key:match("^(.-)#")
            if origin == currentModule or origin == resolve(currentModule) then
                exprAs(f, cleanupReference(cleanup.name), "v", callback)
            else
                f:op("GetField", callback, cleanupRegistry(f), f:const("str", cleanup.key))
            end
        else
            error("unsupported affine cleanup " .. tostring(cleanup.kind))
        end
        f:op("RearmAt", depth, value, callback)
    end

    local function mayBeAbsent(node)
        if not node then
            return false
        end
        if node.kind == "paren" or node.kind == "asExpr" or node.kind == "castExpr" then
            return mayBeAbsent(node.expr)
        end
        -- A field a generic record declares at a type parameter holds whatever
        -- its own code put there, and `as T` erases: the type an instantiation
        -- substitutes does not vouch for the value's representation.
        if node.kind == "dotIndex" and node.obj then
            local owner = node.obj.inferredType
            local origin = owner and owner.tag == "nominal" and owner.origin
            local declared = origin and origin.byname and origin.byname[tokText(node.name)]
            if declared and declared.tag == "typevar" then
                return true
            end
        end
        if node.kind == "bracketIndex" then
            return true
        end
        if node.kind == "call" or node.kind == "methodCall" then
            local signature = node.signatureType or node.calleeType or (node.obj and node.obj.inferredType)
            local pack = signature and signature.retPack
            if pack then
                if pack.alternatives then
                    for _, alternative in ipairs(pack.alternatives) do
                        if #(alternative.head or {}) == 0 then
                            return true
                        end
                    end
                else
                    return #(pack.head or {}) == 0
                end
            end
        end

        return false
    end

    -- An inferred alias inherits the source binding's actual representation.
    -- Parameters, cells, spills and upvalues remain boxed even when their
    -- element type is numeric; aliases must not turn a possible nil into an
    -- eager numeric conversion. Explicit annotations retain their boundaries.
    local function boxedAlias(f: Fn, node)
        while node.kind == "paren" or node.kind == "asExpr" or node.kind == "castExpr" do
            node = node.expr
        end
        if node.kind ~= "name" then
            return false
        end
        local reg, class, cell, spill = f:lookup(tokText(node.token))

        return reg == nil or class == "v" or cell == true or spill ~= nil
    end

    stmt = function(f: Fn, node)
        local k = node.kind
        -- A comptime helper ran while compiling; the program never sees it.
        if (k == "localFuncStmt" or k == "funcStmt") and (node.comptimeFunction or node.comptimeTok) then
            return
        end
        if k == "localStmt" and node.pattern then
            -- `local {x, y as v} = source`: the source is read once, then each
            -- selected field in order. A `type` selection binds nothing at run time.
            local names, types, exprs = {}, {}, {}
            local hold = nil
            for _, entry in ipairs(node.pattern) do
                if not entry.typeOnly then
                    if not hold then
                        hold = f:reg()
                        exprAs(f, node.patternSource, "v", hold)
                    end
                    local index = #names + 1
                    names[index] = entry.alias or entry.sourceName
                    types[index] = entry.type
                    exprs[
                        index
                    ] = {
                        kind = "dotIndex",
                        obj = {kind = "vmRegister", reg = hold, inferredType = node.patternSource.inferredType},
                        name = entry.sourceName,
                    }
                end
            end
            if #names > 0 then
                stmt(f, {kind = "localStmt", names = names, types = types, exprs = exprs, isConst = node.isConst})
            end
            return
        end
        if k == "localStmt" then
            local names = node.names
            local declared = {}
            for i, nameTok in ipairs(names) do
                local name = tokText(nameTok)
                local value = node.exprs and node.exprs[i]
                local ty = node.types and node.types[i] and node.types[i].resolvedType
                local class = "v"
                -- An initializer does not prove the representation of later writes.
                -- Dynamic Lua bindings can change kind; keep them boxed unless an
                -- explicit checked annotation constrains every assignment.
                -- Indexed reads and open result packs may be absent even when
                -- their element type is numeric. Preserve nil until narrowed.
                local absent = mayBeAbsent(value)
                -- Arithmetic over an `any` operand is typed `number` as an
                -- approximation the checker marks untrusted: a metamethod may
                -- answer anything, so only an annotation makes it a number slot.
                local inferred = value
                    and not untrustedValue(value)
                    and (ty or not boxedAlias(f, value))
                    and value.inferredType
                    or nil
                if not absent and not f.captured[name] and (ty or not assignedNames[name]) then
                    if isInteger(ty) or (not ty and isInteger(inferred)) then
                        class = "i"
                    elseif isNumeric(ty) or (not ty and isNumeric(inferred)) then
                        class = "f"
                    end
                end
                declared[i] = {name = name, class = class}
            end
            local exprs = node.exprs or {}
            if #names == 1 and #exprs <= 1 and not node.syntheticCapture then
                local d = declared[1]
                local value = exprs[1]
                -- The initializer sees the preceding binding, including a global
                -- in `local error = error`. Publish the new local after it runs.
                local scope = f.scopes[#f.scopes]
                local previous = scope[d.name]
                local r, cell, spill = f:declare(d.name, d.class, true)
                local binding = scope[d.name]
                scope[d.name] = previous
                if spill then
                    local v = f:reg()
                    if value then
                        exprAs(f, value, "v", v)
                    else
                        f:op("Nil", v)
                    end
                    if cell then
                        local c = f:reg();
                        f:op("NewCell", c, v);
                        v = c
                    end
                    f:storeSpill(spill, v)
                elseif cell then
                    local v = f:reg()
                    if value then
                        exprAs(f, value, "v", v)
                    else
                        f:op("Nil", v)
                    end
                    f:op("NewCell", r, v)
                elseif value then
                    exprAs(f, value, d.class, r)
                elseif d.class == "v" then
                    f:op("Nil", r)
                elseif d.class == "i" then
                    f:op("IK", r, 0)
                else
                    f:op("FK", r, 0)
                end
                scope[d.name] = binding
                markLibraryLocals(f, names, exprs)
                return
            end
            local base = f.nregs
            exprsInto(f, exprs, #names, base)
            for i, d in ipairs(declared) do
                local r, cell, spill = f:declare(d.name, d.class, true)
                if spill then
                    local v = base + i - 1
                    if cell then
                        local c = f:reg();
                        f:op("NewCell", c, v);
                        v = c
                    end
                    f:storeSpill(spill, v)
                elseif cell then
                    f:op("NewCell", r, base + i - 1)
                else
                    coerce(f, base + i - 1, "v", d.class, r)
                end
            end
            markLibraryLocals(f, names, exprs)
        elseif (k == "assignStmt" and #node.targets == 1 or k == "compoundAssign")
            and (
                (node.targets and node.targets[1] or node.target).kind == "safeIndex"
                or (node.targets and node.targets[1] or node.target).kind == "safeBracket"
            )
        then
            -- `o?.name = v` and `o?.[key] op= v`: when `o` is nil the store and its
            -- value are both skipped; otherwise it is the plain store into `o`.
            local target = node.targets and node.targets[1] or node.target
            local o = f:reg()
            exprAs(f, target.obj, "v", o)
            local none, present = f:reg(), f:reg()
            f:op("Nil", none)
            f:op("Ne", present, o, none)
            local skip = f:label()
            f:branch("JmpIfNot", present, skip)
            local holder = {kind = "vmRegister", reg = o, inferredType = target.obj.inferredType}
            local plain = target.kind == "safeIndex"
                and {
                    kind = "dotIndex",
                    obj = holder,
                    name = target.name,
                    overloadMember = target.overloadMember,
                    inferredType = target.inferredType,
                }
                or {kind = "bracketIndex", obj = holder, expr = target.expr, inferredType = target.inferredType}
            local rewritten = {}
            for key, value in pairs(node) do
                rewritten[key] = value
            end
            if node.targets then
                rewritten.targets = {plain}
            else
                rewritten.target = plain
            end
            stmt(f, rewritten)
            f:place(skip)
        elseif k == "assignStmt" then
            local targets, exprs = node.targets, node.exprs
            if #targets == 1 and #exprs == 1 then
                local target = targets[1]
                if target.kind == "name" then
                    local r, c, cell = f:lookup(tokText(target.token))
                    if r and not cell then
                        exprAs(f, exprs[1], c, r);
                        return
                    end
                end
                local prepared = prepareTarget(f, target)
                local v = exprAs(f, exprs[1], "v")
                assignTo(f, target, v, prepared)
                return
            end
            local prepared = {}
            for i, target in ipairs(targets) do
                prepared[i] = prepareTarget(f, target, false, true) or false
            end
            local base = f.nregs
            exprsInto(f, exprs, #targets, base)
            -- Stored right to left, as Lua stores them: when two targets name one
            -- place, the leftmost store is the one that stays.
            for i = #targets, 1, -1 do
                assignTo(f, targets[i], base + i - 1, prepared[i] or nil)
            end
        elseif k == "gotoStmt" then
            local name = tokText(node.name)
            local label
            for i = #f.labelScopes, 1, -1 do
                label = f.labelScopes[i].labels[name]
                if label then
                    break
                end
            end
            assert(label, "no visible label " .. name)
            local jump = {unwind = f:op("Unwind", 0), depth = f.cleanupDepth or 0}
            f:jump(label.block)
            if label.depth then
                settleGoto(jump, label)
            else
                label.pending[#label.pending + 1] = jump
            end
        elseif k == "labelStmt" then
            local scope = f.labelScopes[#f.labelScopes]
            local label = assert(scope.labels[tokText(node.name)])
            f:place(label.block)
            label.depth = label.atEnd and scope.depth or (f.cleanupDepth or 0)
            for _, jump in ipairs(label.pending) do
                settleGoto(jump, label)
            end
        elseif k == "yieldStmt" then
            local y = assert(f.yields and f.yields[#f.yields], "yield outside a do expression")
            exprAs(f, node.value, "v", y.dst)
            if (f.cleanupDepth or 0) > y.depth then
                f:op("Unwind", y.depth)
            end
            f:jump(y.done)
        elseif k == "compoundAssign" then
            -- `x op= e` is `x = x op e`; the target's own subexpressions are
            -- evaluated twice, as they are side-effect free in practice.
            local opText = tokText(node.op):sub(1, -2)
            opText = OPERATOR_SPELLINGS[opText] or opText
            local target = node.target
            -- The target's table and key are evaluated once, before the value,
            -- and read back from those registers.
            local prepared = prepareTarget(f, target, true)
            local current = target
            if prepared and target.kind == "dotIndex" then
                current = {
                    kind = "dotIndex",
                    obj = {kind = "vmRegister", reg = prepared.o, inferredType = target.obj.inferredType},
                    name = target.name,
                    overloadMember = target.overloadMember,
                    inferredType = target.inferredType,
                }
            elseif prepared then
                current = {
                    kind = "bracketIndex",
                    obj = {kind = "vmRegister", reg = prepared.o, inferredType = target.obj.inferredType},
                    expr = {kind = "vmRegister", reg = prepared.i, inferredType = target.expr.inferredType},
                    indexedAccess = target.indexedAccess,
                    inferredType = target.inferredType,
                }
            end
            local bin = {
                kind = "binop",
                lhs = current,
                rhs = node.value,
                op = {text = opText},
                inferredType = node.inferredType or node.target.inferredType,
                fixedArithmetic = node.fixedArithmetic,
                wideArithmetic = node.wideArithmetic
            }
            if target.kind == "name" then
                local r, c, cell = f:lookup(tokText(target.token))
                if r and not cell then
                    exprAs(f, bin, c, r);
                    return
                end
            end
            local v = exprAs(f, bin, "v")
            assignTo(f, target, v, prepared)
        elseif k == "withStmt" then
            local depth = f.cleanupDepth or 0
            f:push()
            for _, binding in ipairs(node.bindings or {}) do
                local value = exprAs(f, binding.expr, "v")
                local reg, cell, spill = f:declare(tokText(binding.name), "v", true)
                local stored = value
                if cell then
                    stored = f:reg()
                    f:op("NewCell", stored, value)
                end
                if spill then
                    f:storeSpill(spill, stored)
                else
                    f:op("Move", reg, stored)
                end
                for i = #(binding.ownerCleanups or {}), 1, -1 do
                    deferCleanup(f, value, binding.ownerCleanups[i])
                end
            end
            block(f, node.body)
            f:op("Unwind", depth)
            f.cleanupDepth = depth
            f:pop()
        elseif k == "doStmt" then
            block(f, node.body or node)
        elseif k == "pragmaStmt" then
            -- The pragma is compile-time only; the statement it annotates runs.
            if node.stat then
                stmt(f, node.stat)
            end
        elseif k == "callStmt" and node.expr and node.expr.logIntrinsic then
            -- `nupp.log.<severity>(...)` as a statement: the level test stands at the
            -- site, so a filtered line evaluates none of its arguments, and the
            -- module and line are constants handed to the module's view.
            local call = node.expr
            local severity = call.logIntrinsic
            local line = nodeLine(call) or 0
            local exprs = call.args and call.args.exprs or {}

            local function value(register)
                return {kind = "vmRegister", reg = register}
            end

            local function number(n)
                return {kind = "number", token = {text = tostring(n)}}
            end

            local logModule, forModule, moduleName = f:reg(), f:reg(), f:reg()
            f:op("Require", logModule, f:const("str", "nupp.log"))
            f:op("GetField", forModule, logModule, f:const("str", "forModule"))
            f:op("K", moduleName, f:const("str", currentModule or "?"))
            local view = exprAs(
                f,
                {kind = "call", obj = value(forModule), args = {kind = "args", exprs = {value(moduleName)}}},
                "v"
            )
            local on = f:reg()
            f:op("GetField", on, view, f:const("str", "on"))
            local enabled = exprAs(f, {kind = "bracketIndex", obj = value(on), expr = number(severity)}, "v")
            local skip = f:label()
            f:branch("JmpIfNot", enabled, skip)
            local message
            if call.logFormatIntrinsic then
                local plan = call.logFormatIntrinsic
                message = exprAs(
                    f,
                    {
                        kind = "call",
                        obj = value(on),
                        args = {kind = "args", exprs = exprs},
                        formatIntrinsic = {
                            format = plan.format,
                            debugArguments = plan.debugArguments,
                            argumentOffset = 1
                        },
                    },
                    "v"
                )
            elseif #exprs > 1 then
                local values = {}
                for index, argument in ipairs(exprs) do
                    values[index] = exprAs(f, argument, "v")
                end
                message = builtinRegisters(f, "string.format", values)
            else
                message = exprAs(f, exprs[1], "v")
            end
            exprAs(
                f,
                {
                    kind = "call",
                    obj = {kind = "dotIndex", obj = value(view), name = {text = "emit"}},
                    args = {kind = "args", exprs = {number(severity), number(line), value(message)}},
                },
                "v"
            )
            f:place(skip)
        elseif k == "callStmt" then
            expr(f, node.expr, nil, "v")
        elseif k == "returnStmt" then
            local exprs = node.exprs or {}
            if node.constructorReturn then
                exprs = {{kind = "name", token = {text = assert(f.constructorSelf)}}}
            end
            if #exprs == 0 then
                f:op("RetNil")
            elseif #exprs == 1 and not multiCall(exprs[1]) and exprs[1].kind ~= "vararg" then
                local r, c = expr(f, exprs[1], nil, nil)
                local vr = coerce(f, r, c, "v");
                f:op("Ret", vr)
            else
                local base = f.nregs
                local n = #exprs
                if multiCall(exprs[n]) or exprs[n].kind == "vararg" then
                    -- A trailing call's results are all returned: evaluate the others,
                    -- then it.
                    while f.nregs < base + n + 8 do
                        f:reg()
                    end
                    for i = 1, n - 1 do
                        exprAs(f, exprs[i], "v", base + i - 1)
                    end
                    if exprs[n].kind == "vararg" then
                        local callee = f:reg()
                        f:op("K", callee, f:const("builtin", "select"))
                        f:op("K", base + n, f:const("num", 1))
                        f:op("CallDyn", callee, base + n - 1, 129)
                    else
                        emitCall(f, exprs[n], base + n - 1, 8, true)
                    end
                    -- 128 | fixed: the fixed values, then exactly what the call
                    -- returned.
                    f:op("RetN", base, 128 + (n - 1))
                else
                    exprsInto(f, exprs, n, base)
                    f:op("RetN", base, n)
                end
            end
        elseif k == "exportStmt" then
            -- The Lua backend's model: a declared module's value is its exports
            -- table, `export = v` replaces it, and `export <decl>` adds the
            -- declared names to it as they are defined.
            if node.value then
                if f.exportsReg then
                    exprAs(f, node.value, "v", f.exportsReg)
                else
                    local r = exprAs(f, node.value, "v");
                    f:op("Ret", r)
                end
            elseif node.stat then
                stmt(f, node.stat)
                local stat = node.stat
                while stat and stat.kind == "pragmaStmt" do
                    stat = stat.stat
                end
                if stat
                    and f.exportsReg
                    and not (stat.comptimeFunction or stat.comptimeTok or stat.isAnnotationDefinition)
                then
                    for _, name in ipairs(exportedNames(stat)) do
                        local r = exprAs(f, {kind = "name", token = {text = name}, inferredType = {tag = "any"}}, "v")
                        f:op("SetField", f.exportsReg, f:const("str", name), r)
                    end
                end
            end
        elseif k == "ifStmt" then
            local done = f:label()
            -- A condition's temporaries die at its branch: the body starts from
            -- the registers live before the condition, or its locals would be
            -- declared above every temporary the condition used.
            local mark = f.nregs
            for _, clause in ipairs(node.clauses) do
                if clause.binding then
                    -- `if NAME = EXPR then`: the arm is taken when the value is
                    -- not nil, with NAME bound to it for that arm.
                    local value = exprAs(f, clause.cond, "v")
                    local absent, present = f:reg(), f:reg()
                    f:op("Nil", absent)
                    f:op("Ne", present, value, absent)
                    coverBranch(f, clause, present)
                    local nextClause = f:label()
                    f:branch("JmpIfNot", present, nextClause)
                    f:push()
                    local reg, cell = f:declare(tokText(clause.binding), "v")
                    f:op(cell and "NewCell" or "Move", reg, value)
                    block(f, clause.body)
                    f:pop()
                    f.nregs = math.max(mark, f.declTop or 0)
                    f:jump(done)
                    f:place(nextClause)
                else
                    local nextClause = f:label()
                    condBranch(f, clause.cond, clause, nextClause)
                    f.nregs = math.max(mark, f.declTop or 0)
                    block(f, clause.body)
                    f:jump(done)
                    f:place(nextClause)
                end
            end
            if node.elseClause then
                block(f, node.elseClause.body or node.elseClause)
            end
            f:place(done)
        elseif k == "whileStmt" then
            local top, finished = f:label(), f:label()
            f:place(top)
            local mark = f.nregs
            condBranch(f, node.cond, nil, finished)
            f.nregs = math.max(mark, f.declTop or 0)
            loopBegin(f)
            block(f, node.body)
            loopContinue(f)
            f:jump(top)
            f:place(finished)
            loopEnd(f)
        elseif k == "repeatStmt" then
            local top = f:label()
            f:place(top)
            loopBegin(f)
            f:push()
            local depth = f.cleanupDepth or 0
            for _, s in ipairs(node.body.stats or {}) do
                coverStatement(f, s)
                stmtReclaim(f, s)
            end
            loopContinue(f)
            -- The condition still sees the body's owners; they close after it,
            -- on the way out and on the way round alike. A `break` or `continue`
            -- written in it is outside the body, so it belongs to the enclosing loop.
            local own = table.remove(f.breaks)
            local c = exprAs(f, node.cond, "v")
            f.breaks[#f.breaks + 1] = own
            if (f.cleanupDepth or 0) > depth then
                f:op("Unwind", depth)
                f.cleanupDepth = depth
            end
            f:pop()
            f:branch("JmpIfNot", c, top)
            loopEnd(f)
        elseif k == "fornumStmt" then
            f:push()
            -- Evaluate all three controls before binding the body variable.
            -- It may shadow a name used by any of these expressions.
            local unsignedLoop = wideKind(node.start.inferredType) == "u64"
                or wideKind(node.stop.inferredType) == "u64"
                or (node.step and wideKind(node.step.inferredType) == "u64")
            -- The runtime stores one signed integer subtype. Unsigned counters
            -- preserve their static interpretation through the named wide ops.
            local function loopOperation(op, left, right, dst)
                if unsignedLoop then
                    local names = {Add = "add", Lt = "lt", Le = "le"}
                    wideOperation(
                        f,
                        "wide.u64." .. names[op],
                        {{kind = "vmRegister", reg = left}, {kind = "vmRegister", reg = right}},
                        dst
                    )
                else
                    f:op(op, dst, left, right)
                end
            end

            local counter, limit = f:reg(), f:reg()
            exprAs(f, node.start, "v", counter)
            exprAs(f, node.stop, "v", limit)
            local step = f:reg()
            if node.step then
                exprAs(f, node.step, "v", step)
            else
                f:op("K", step, f:const("int64", "1"))
            end
            local zero, isZero = f:reg(), f:reg()
            f:op("K", zero, f:const("int64", "0"))
            f:op("Eq", isZero, step, zero)
            local validStep = f:label()
            f:branch("JmpIfNot", isZero, validStep)
            f:op("Raise", f:const("str", "'for' step is zero"))
            f:place(validStep)
            if unsignedLoop then
                -- Exact literal controls may arrive as floats. The unsigned
                -- window validates those and retains every canonical integer bit.
                local bits = f:freg()
                for _, control in ipairs({counter, limit, step}) do
                    f:op("UUnbox", bits, control)
                    f:op("UBox", control, bits)
                end
            end

            -- Lua's integer mode depends on the initial value and step,
            -- independently of the limit. Unknown numeric subtypes are
            -- inspected once; there is no guessed sign or repeated coercion.
            local integerMode = f:reg()
            local knownStart = wideKind(node.start.inferredType)
            local knownStep = not node.step or wideKind(node.step.inferredType)
            if unsignedLoop or (knownStart and knownStep) then
                f:op("K", integerMode, f:const("true", ""))
            else
                local integerName = f:reg()
                f:op("K", integerName, f:const("str", "integer"))
                local startType = wideOperation(f, "math.type", {{kind = "vmRegister", reg = counter}})
                f:op("Eq", integerMode, startType, integerName)
                if node.step then
                    local stepType = wideOperation(f, "math.type", {{kind = "vmRegister", reg = step}})
                    local integerStep = f:reg()
                    f:op("Eq", integerStep, stepType, integerName)
                    local noninteger = f:label()
                    f:branch("JmpIfNot", integerStep, noninteger)
                    local classified = f:label()
                    f:jump(classified)
                    f:place(noninteger)
                    f:op("K", integerMode, f:const("false", ""))
                    f:place(classified)
                end
            end
            local initialized = f:label()
            f:branch("JmpIf", integerMode, initialized)
            local floating = f:freg()
            f:op("FUnbox", floating, counter)
            f:op("FBox", counter, floating)
            f:op("FUnbox", floating, limit)
            f:op("FBox", limit, floating)
            f:op("FUnbox", floating, step)
            f:op("FBox", step, floating)
            f:place(initialized)
            local ascending = f:reg()
            loopOperation("Lt", zero, step, ascending)

            local varName = tokText(node.var)
            local varCell = f.captured[varName]
            local var = f:declare(varCell and "\0for" or varName, "v")
            local top, finished, descending, body = f:label(), f:label(), f:label(), f:label()
            f:place(top)
            local continuing = f:reg()
            f:branch("JmpIfNot", ascending, descending)
            loopOperation("Le", counter, limit, continuing)
            f:jump(body)
            f:place(descending)
            loopOperation("Le", limit, counter, continuing)
            f:place(body)
            f:branch("JmpIfNot", continuing, finished)
            f:op("Move", var, counter)
            loopBegin(f)
            if varCell then
                f:push()
                local cell = f:declare(varName, "v")
                f:op("NewCell", cell, var)
            end
            block(f, node.body)
            if varCell then
                f:pop()
            end
            loopContinue(f)
            local nextCounter = f:reg()
            loopOperation("Add", counter, step, nextCounter)
            local advanced, descendingAdvance = f:label(), f:label()
            f:branch("JmpIfNot", integerMode, advanced)
            f:branch("JmpIfNot", ascending, descendingAdvance)
            local overflow = f:reg()
            loopOperation("Lt", nextCounter, counter, overflow)
            f:branch("JmpIf", overflow, finished)
            f:jump(advanced)
            f:place(descendingAdvance)
            loopOperation("Lt", counter, nextCounter, overflow)
            f:branch("JmpIf", overflow, finished)
            f:place(advanced)
            f:op("Move", counter, nextCounter)
            f:jump(top)
            f:place(finished)
            loopEnd(f)
            f:pop()
        elseif k == "forinStmt" then
            local iterator = node.exprs and node.exprs[1]
            local species = iterator and iterator.kind == "methodCall" and simdType(iterator.obj.inferredType)
            if species and species.family == "Species" and tokText(iterator.name) == "over" then
                assert(#node.exprs == 1 and #iterator.args.exprs == 1, "SIMD over requires one count")
                f:push()
                local object = exprAs(f, iterator.obj, "v")
                local limit = exprAs(f, iterator.args.exprs[1], "i")
                local call = f:reg()
                local selfReg = f:reg()
                local countReg = f:reg()
                f:op("Move", selfReg, object)
                f:op("Simd", "lanes", species.element, call, 1)
                local width = f:freg()
                local at = f:freg()
                f:op("IUnbox", width, call)
                f:op("IK", at, 1)
                f:op("ISub", at, at, width)
                local top, finished = f:label(), f:label()
                f:place(top)
                f:op("IAdd", at, at, width)
                local valid = f:freg()
                f:op("ICmpSLe", valid, at, limit)
                f:branch("JmpIfIZero", valid, finished)
                local left = f:freg()
                f:op("ISub", left, limit, at)
                f:op("IAddK", left, left, 1)
                f:op("Move", selfReg, object)
                f:op("IBox", countReg, left)
                f:op("Simd", "tail", species.element, call, 2)
                local index = f:reg()
                f:op("IBox", index, at)
                loopBegin(f)
                f:push()
                for i, nameTok in ipairs(node.names) do
                    local r, cell = f:declare(tokText(nameTok), "v")
                    local value = i == 1 and index or call
                    if i > 2 then
                        f:op("Nil", value)
                    end
                    f:op(cell and "NewCell" or "Move", r, value)
                end
                block(f, node.body)
                f:pop()
                loopContinue(f)
                f:jump(top)
                f:place(finished)
                loopEnd(f)
                f:pop()
                return
            end
            -- The generic protocol: f, s, control = explist; each round calls f(s,
            -- control).
            f:push()
            local base = f.nregs
            exprsInto(f, node.exprs, 3, base)
            local fnReg, stateReg, ctl = base, base + 1, base + 2
            while f.nregs < base + 3 do
                f:reg()
            end
            local call = f.nregs
            while f.nregs < call + math.max(#node.names, 3) + 1 do
                f:reg()
            end
            local ended = f:reg()
            local top, finished = f:label(), f:label()
            f:place(top)
            f:op("Move", call + 1, stateReg);
            f:op("Move", call + 2, ctl)
            f:op("CallDyn", fnReg, call, 2)
            f:op("PadResults", call, #node.names)
            f:op("Nil", ended)
            f:op("Eq", ended, call, ended)
            f:branch("JmpIf", ended, finished)
            f:op("Move", ctl, call)
            loopBegin(f)
            f:push()
            for i, nameTok in ipairs(node.names) do
                local name = tokText(nameTok)
                local r, cell = f:declare(name, "v")
                if cell then
                    f:op("NewCell", r, call + i - 1)
                else
                    f:op("Move", r, call + i - 1)
                end
            end
            block(f, node.body)
            f:pop()
            loopContinue(f)
            f:jump(top)
            f:place(finished)
            loopEnd(f)
            f:pop()
        elseif k == "continueStmt" then
            local loop = assert(f.breaks[#f.breaks], "continue outside a loop")
            if (f.cleanupDepth or 0) > loop.cleanupDepth then
                f:op("Unwind", loop.cleanupDepth)
            end
            f:jump(loop.next)
        elseif k == "breakStmt" then
            if (f.cleanupDepth or 0) > f.breaks[#f.breaks].cleanupDepth then
                f:op("Unwind", f.breaks[#f.breaks].cleanupDepth)
            end
            local list = assert(f.breaks[#f.breaks], "break outside a loop")
            f:jump(list.exit)
        elseif k == "localFuncStmt" then
            -- `local function f`: f is in scope in its own body, through its cell.
            local name = tokText(node.name)
            local r, cell, spill = f:declare(name, "v", true)
            local inner
            if spill then
                local c = f:reg()
                if cell then
                    local nilReg = f:reg();
                    f:op("Nil", nilReg);
                    local cellReg = f:reg();
                    f:op("NewCell", cellReg, nilReg);
                    f:storeSpill(spill, cellReg)
                    inner = emitClosure(f, node.body, c, name);
                    f:op("SetCell", cellReg, c)
                else
                    inner = emitClosure(f, node.body, c, name);
                    f:storeSpill(spill, c)
                end
            elseif cell then
                f:op("Nil", r + 0) -- placeholder; the cell is made below
                local nilReg = f:reg();
                f:op("Nil", nilReg);
                f:op("NewCell", r, nilReg)
                local c = f:reg();
                inner = emitClosure(f, node.body, c, name);
                f:op("SetCell", r, c)
            else
                inner = emitClosure(f, node.body, r, name)
            end
            if not assignedNames[name] then
                assert(f.scopes[#f.scopes][name]).fid = inner.id
            end
            if node.name.cleanupRegistrations then
                registerCleanups(f, node.name.cleanupRegistrations, exprAs(f, cleanupReference(name), "v"))
            end
        elseif k == "funcStmt" then
            local fname = node.name
            local baseName = tokText(fname.base)
            -- The dotted path is the node's own token list: name tokens after the base.
            local parts = {}
            for _, child in ipairs(fname) do
                if type(child) == "table"
                    and child.kind == "name"
                    and child ~= fname.base
                    and child ~= fname.method
                then
                    parts[#parts + 1] = tokText(child)
                end
            end
            if #parts == 0 and not fname.method then
                -- `function name() end`: an assignment to the name.
                local c = f:reg();
                emitClosure(f, node.body, c, baseName)
                assignTo(f, {kind = "name", token = fname.base}, c)
                for _, token in ipairs(fname) do
                    registerCleanups(f, token.cleanupRegistrations, c)
                end
            else
                -- `function a.b.c()` or `function a.b:m()`: walk the path, store at its
                -- end.
                local c = f:reg()
                local method = fname.method and tokText(fname.method)
                local label = baseName .. "." .. table.concat(parts, ".") .. (method and (":" .. method) or "")
                emitClosure(f, node.body, c, label, method ~= nil)
                local o = exprAs(f, {kind = "name", token = fname.base, inferredType = {tag = "any"}}, "v")
                local last = method or parts[#parts]
                local upto = method and #parts or #parts - 1
                for i = 1, upto do
                    local t = f:reg();
                    f:op("GetField", t, o, f:const("str", parts[i]));
                    o = t
                end
                f:op("SetField", o, f:const("str", last), c)
                local nominal = node.ownerNominal
                local member = nominal and nominal.byname and nominal.byname[last]
                local owner = (fname.method or tyTag(member) == "func") and shapeOfNominal(nominal) or nil
                if owner then
                    f:op("SetMethod", owner.id, f:const("str", last), c)
                end
                for _, token in ipairs(fname) do
                    registerCleanups(f, token.cleanupRegistrations, c)
                end
            end
        elseif k == "cdefFunc" then
            local metadata = require("nupp.compiler.vm.metadata")
            local signature = metadata.foreignSignature(node)
            -- The binding's temporaries are freed before the name is declared, so
            -- a module of many declarations holds one register for each.
            local mark = f.nregs
            local library = f:reg()
            if node.fromLib then
                exprAs(f, {kind = "string", token = node.fromLib}, "v", library)
            else
                f:op("Nil", library)
            end
            local symbol = f:reg()
            f:op("K", symbol, f:const("str", node.cAbiSignature.symbol))
            local descriptor = exprAs(f, metadata.literal(signature), "v")
            local bound = builtinRegisters(f, "foreign.bind", {library, symbol, descriptor})
            local value = mark
            if bound ~= mark then
                f:op("Move", mark, bound)
            end
            f.nregs = math.max(mark, f.declTop or 0)
            local register, cell, spill = f:declare(tokText(node.name), "v", true)
            if register == value then
                -- Declared where the value already is.
                value = f:reg()
                f:op("Move", value, register)
            end
            local destination = register or f:reg()
            f:op(cell and "NewCell" or "Move", destination, value)
            if spill then
                f:storeSpill(spill, destination)
            end
            -- A C function named as a terminal is found where its declaration put it.
            if node.name.cleanupRegistrations then
                registerCleanups(f, node.name.cleanupRegistrations, value)
            end
        elseif k == "recordDecl" and node.isAnnotationDefinition then
            -- Annotation schemas are compile-time model metadata, even when written
            -- with `record` or `struct`: no runtime value, shape or layout.
            return
        elseif k == "recordDecl" or k == "cdefStruct" then
            local shape = declareShape(node)
            -- The record's name is also a value: the table its static members live on
            -- (`R.new`, `R.SCHEMA`), what `function R.f()` and `export record R` see.
            if node.name and not node.qualifiers then
                local r, cell, spill = f:declare(tokText(node.name), "v", true)
                if spill then
                    local t = f:reg();
                    f:op("NewTableN", t, 0, 0);
                    if cell then
                        local c = f:reg();
                        f:op("NewCell", c, t);
                        t = c
                    end;
                    f:storeSpill(spill, t)
                elseif cell then
                    local t = f:reg();
                    f:op("NewTableN", t, 0, 0);
                    f:op("NewCell", r, t)
                else
                    f:op("NewTableN", r, 0, 0)
                end
            end
            -- An interface is erased unless it implements something: its default
            -- bodies, and what it passes on, live on its own table, the one
            -- place a declaration in another module can reach them.
            local implements = false
            if not shape and node.declKind == "interface" then
                local nominal = node.resolvedType
                implements = nominal and nominal.staticByname and next(nominal.staticByname) ~= nil or false
                for _, entry in ipairs(node.entries or {}) do
                    implements = implements or entry.kind == "inlineMethod"
                end
                for _, super in ipairs(node.supertypes or {}) do
                    implements = implements or super.interfaceName ~= nil
                end
            end
            if not shape and not implements then
                return
            end
            f:push()
            local identity: integer
            if node.qualifiers then
                local owner = {kind = "name", token = node.qualifiers[1]}
                for index = 2, #node.qualifiers do
                    owner = {kind = "dotIndex", obj = owner, name = node.qualifiers[index]}
                end
                local parent = exprAs(f, owner, "v")
                identity = f:reg()
                f:op("NewTableN", identity, 0, 0)
                f:op("SetField", parent, f:const("str", tokText(node.name)), identity)
            else
                identity = exprAs(f, {kind = "name", token = node.name}, "v")
            end
            -- A `global` declaration is also the global of its name, which a file
            -- that never requires its module reads.
            if node.visibility == "global" and not node.qualifiers then
                local globals = f:reg()
                f:globals(globals)
                f:op("SetField", globals, f:const("str", tokText(node.name)), identity)
            end
            if not shape then
                for _, entry in ipairs(node.entries) do
                    if entry.kind == "inlineMethod" then
                        local member = entry.overloadMember or tokText(entry.name)
                        local c = f:reg()
                        emitClosure(f, entry.body, c, tokText(node.name) .. ":" .. member, inlineImplicitSelf(entry))
                        f:op("SetField", identity, f:const("str", member), c)
                    end
                end
                f.declTop = math.max(f.declTop or 0, identity + 1)
                for _, generated in ipairs(node.vmMetadata or {}) do
                    stmtReclaim(f, generated)
                end
                f:pop()
                return
            end
            f:op("SetField", identity, f:const("str", "__index"), identity)
            if not shape.physical then
                f:op("SetMethod", shape.id, f:const("str", "\0nupp:recordType"), identity)
            end
            if node.declKind == "struct" or node.kind == "cdefStruct" then
                local metadata = require("nupp.compiler.vm.metadata")
                local descriptor = exprAs(f, metadata.literal(shape.layout), "v")
                local key = f:const("str", "\0nupp:structLayout")
                f:op("SetField", identity, key, descriptor)
                f:op("SetMethod", shape.id, key, descriptor)
                if shape.layout.supported then
                    local physical = builtinRegisters(f, "storage.structDefine", {descriptor, identity})
                    f:op("SetField", identity, f:const("str", "\0nupp:structType"), physical)
                end
            end
            for _, entry in ipairs(node.entries) do
                if entry.kind == "inlineMethod" then
                    local member = entry.overloadMember or tokText(entry.name)
                    local c = f:reg();
                    emitClosure(f, entry.body, c, shape.name .. ":" .. member, inlineImplicitSelf(entry))
                    if not entry.inlineStatic then
                        f:op("SetMethod", shape.id, f:const("str", member), c)
                    end
                    f:op("SetField", identity, f:const("str", member), c)
                    registerCleanups(f, entry.name.cleanupRegistrations, c)
                end
            end
            -- Metadata statements use the ordinary closure and capture path.
            -- Keep the declaration value live while their temporaries are reused.
            f.declTop = math.max(f.declTop or 0, identity + 1)
            for _, generated in ipairs(node.vmMetadata or {}) do
                stmtReclaim(f, generated)
            end
            -- A default the declaration takes from an interface is a method of
            -- its instances, as one written in its body is.
            for _, taken in ipairs(node.inheritedDefaultNames or {}) do
                local method = f:reg()
                local member = taken.member or taken.name
                f:op("GetField", method, identity, f:const("str", member))
                f:op("SetMethod", shape.id, f:const("str", member), method)
            end
            for _, member in ipairs(node.deriveRecipe and node.deriveRecipe.members or {}) do
                if member.namespace == "instance" then
                    local method = f:reg()
                    f:op("GetField", method, identity, f:const("str", member.name))
                    f:op("SetMethod", shape.id, f:const("str", member.name), method)
                end
            end
            f:pop()
            -- Records declared in this one's body are its members, made once it is.
            for _, entry in ipairs(node.entries or {}) do
                if entry.vmNested then
                    stmt(f, entry)
                end
            end
        elseif k == "emptyStmt"
            or k == "typeAlias"
            or k == "interface"
            or k == "annotationApply"
            or k == "moduleStmt"
            or k == "typeDecl"
            or k == "constTypeStmt"
        then
            -- Nothing at run time.
        else
            error("statement kind " .. tostring(k) .. " in " .. f.name)
        end
    end

    stmtReclaim = function(f: Fn, s)
        -- `local a, b = open(), open()` registers each owner as soon as its value
        -- exists, so a later value that raises still closes the earlier ones. The
        -- declaration splits into one per name when no value reads those names.
        if s.kind == "localStmt"
            and s.automaticOwners
            and not s.pattern
            and not s.vmSplit
            and #(s.names or {}) > 1
            and #(s.exprs or {}) == #s.names
        then
            local declared = {}
            for _, token in ipairs(s.names) do
                declared[tokText(token)] = true
            end
            local reads, seen = false, {}

            local function scan(n)
                if reads or type(n) ~= "table" or seen[n] then
                    return
                end
                seen[n] = true
                if n.kind == "name" and n.token and declared[tokText(n.token)] then
                    reads = true
                    return
                end
                for _, child in ipairs(n) do
                    scan(child)
                end
            end

            for _, value in ipairs(s.exprs) do
                scan(value)
            end
            if not reads then
                for index, token in ipairs(s.names) do
                    stmtReclaim(f, {
                        kind = "localStmt",
                        names = {token},
                        types = {s.types and s.types[index] or nil},
                        exprs = {s.exprs[index]},
                        isConst = s.isConst,
                        automaticOwners = {s.automaticOwners[index]},
                        vmSplit = true,
                    })
                end
                return
            end
        end
        f.curStmt = s
        f.curLine = nodeLine(s) or f.curLine
        local mark, fmark = f.nregs, f.nfregs
        local statementDepth = f.cleanupDepth or 0
        stmt(f, s)
        if s.statementCleanupOwners and (f.cleanupDepth or 0) > statementDepth then
            f:op("Unwind", statementDepth)
            f.cleanupDepth = statementDepth
        end
        if s.kind == "localStmt" then
            for index = 1, #(s.names or {}) do
                local owner = s.automaticOwners and s.automaticOwners[index]
                if owner and owner.lowerable then
                    f.cleanupOwners = f.cleanupOwners or {}
                    local slots = {}
                    f.cleanupOwners[owner] = slots
                    local value = exprAs(
                        f,
                        {kind = "name", token = {text = owner.name}, inferredType = {tag = "any"}},
                        "v"
                    )
                    local guard
                    if owner.activation then
                        guard = f:reg()
                        f:op("K", guard, f:const("false", ""))
                        local activated = f:label()
                        for _, tests in ipairs(owner.activation) do
                            local failed = f:label()
                            for _, test in ipairs(tests) do
                                local sibling = exprAs(
                                    f,
                                    {
                                        kind = "name",
                                        token = {text = owner.correlation.names[test.index]},
                                        inferredType = {tag = "any"},
                                    },
                                    "v"
                                )
                                local constant, matches = f:reg(), f:reg()
                                local kind = type(test.constant)
                                if test.constant == nil then
                                    f:op("Nil", constant)
                                else
                                    local tag = kind == "string" and "str"
                                        or kind == "number" and "num"
                                        or test.constant and "true"
                                        or "false"
                                    f:op("K", constant, f:const(tag, kind == "boolean" and "" or test.constant))
                                end
                                f:op("Eq", matches, sibling, constant)
                                f:branch("JmpIfNot", matches, failed)
                            end
                            f:op("K", guard, f:const("true", ""))
                            f:jump(activated)
                            f:place(failed)
                        end
                        f:place(activated)
                    end
                    for i = #(owner.cleanups or {}), 1, -1 do
                        local depth = f.cleanupDepth or 0
                        deferCleanup(f, value, owner.cleanups[i], guard)
                        slots[
                            #slots + 1
                        ] = {depth = depth, field = owner.cleanups[i].field, cleanup = owner.cleanups[i]}
                    end
                end
            end
        end
        local debugRegs = os.getenv("DEBUG_REGS")
        if debugRegs and f.name:find(debugRegs, 1, true) then
            io.stderr:write(
                f.name,
                " ",
                s.kind,
                " line ",
                tostring(s.line or (s[1] and s[1].line) or "?"),
                " nregs ",
                f.nregs,
                " declTop ",
                tostring(f.declTop),
                "\n"
            )
        end
        f.nregs = math.max(mark, f.declTop or 0)
        f.nfregs = math.max(fmark, f.fdeclTop or 0)
    end

    block = function(f: Fn, node)
        local depth = f.cleanupDepth or 0
        local stats = node.stats or node.body and node.body.stats or {}
        local scope = {labels = {}, depth = depth}
        local atEnd = true
        for i = #stats, 1, -1 do
            local st = stats[i]
            if st.kind == "labelStmt" then
                local name = tokText(st.name)
                assert(not scope.labels[name], "duplicate label " .. name)
                scope.labels[name] = {atEnd = atEnd, block = f:label(), pending = {}}
            elseif st.kind ~= "emptyStmt" then
                atEnd = false
            end
        end
        f.labelScopes[#f.labelScopes + 1] = scope
        f:push()
        for _, s in ipairs(stats) do
            coverStatement(f, s)
            stmtReclaim(f, s)
        end
        if (f.cleanupDepth or 0) > depth then
            f:op("Unwind", depth)
            f.cleanupDepth = depth
        end
        f:pop()
        f.labelScopes[#f.labelScopes] = nil
    end

    -- The CST keeps every syntax child in a node's array part (`cst.add`), and
    -- the checker hangs its facts off named keys: `definition` links a name to
    -- its declaration, possibly in another module. A walk over the named keys
    -- would follow those into other functions, so the walks here read the
    -- array part only.
    local function walkSyntax(node, seen, visit)
        if type(node) ~= "table" or seen[node] then
            return
        end
        seen[node] = true
        if visit(node) == false then
            return
        end
        for _, v in ipairs(node) do
            if type(v) == "table" then
                walkSyntax(v, seen, visit)
            end
        end
    end

    -- Capture analysis, scope-aware: one pass over a module resolves every
    -- name read inside a nested function to the innermost enclosing
    -- declaration, and marks that declaration's function as capturing the
    -- name (so it becomes a cell there). A function that declares `members`
    -- in one block and reads an outer `members` in another no longer confuses
    -- the two. Names that resolve to nothing are globals or module names.
    local capturedOf = setmetatable({}, {__mode = "k"})
    -- The names each function reads from an enclosing one, every function on
    -- the way to the owner included: what its upvalue registers hold at entry.
    local freeOf = setmetatable({}, {__mode = "k"})
    local fnStack = {}
    local analyzeFunction

    -- `chain` is a list of scopes, innermost last; each scope maps a name to the
    -- function body node that declared it.
    local function lookupChain(chain, name)
        for i = #chain, 1, -1 do
            local owner = chain[i][name];
            if owner then
                return owner
            end
        end

        return nil
    end

    local function noteUse(chain, name, here)
        local owner = lookupChain(chain, name)
        if owner and owner ~= here then
            capturedOf[owner] = capturedOf[owner] or {};
            capturedOf[owner][name] = true
            for i = #fnStack, 1, -1 do
                local fb = fnStack[i]
                if fb == owner then
                    break
                end
                freeOf[fb] = freeOf[fb] or {};
                freeOf[fb][name] = true
            end
        end
    end

    -- Named affine terminals are reads introduced by the checker. They need
    -- the same cells as source-level reads when cleanup runs in a closure.
    local function noteCleanup(chain, cleanup, here)
        if cleanup.kind == "function" then
            noteUse(chain, cleanup.name:match("^[^.]+"), here)
        elseif cleanup.kind == "field" then
            noteCleanup(chain, cleanup.cleanup, here)
        end
    end

    local function noteCleanups(node, chain, here)
        for _, cleanup in ipairs(node.ownerCleanups or {}) do
            noteCleanup(chain, cleanup, here)
        end
        for _, owner in pairs(node.automaticOwners or {}) do
            if owner.lowerable then
                for _, cleanup in ipairs(owner.cleanups or {}) do
                    noteCleanup(chain, cleanup, here)
                end
            end
        end
    end

    local analyzeExpr, analyzeBlock, analyzeStmt
    -- Expressions: names and nested functions, through any node shape.
    analyzeExpr = function(node, chain, here, seen)
        if type(node) ~= "table" or seen[node] then
            return
        end
        seen[node] = true
        -- A comptime or materialized value is lowered as the expression it
        -- renders to, so that is what its captures are read from.
        if node.comptimeValue or node.materializedIR then
            analyzeExpr(comptimeExpression(node), chain, here, seen)
            return
        end
        noteCleanups(node, chain, here)
        if node.kind == "name" and node.token then
            noteUse(chain, tokText(node.token), here);
            return
        end
        if node.kind == "funcExpr" or node.kind == "shortfn" then
            analyzeFunction(node.kind == "shortfn" and node or node.body, chain, seen);
            return
        end
        if node.kind == "vararg" then
            noteUse(chain, "...", here);
            return
        end
        if node.kind == "doExpr" then
            analyzeBlock(node.body, chain, here, seen)
            return
        end
        if node.kind == "switchExpr" then
            analyzeExpr(node.selector, chain, here, seen)
            for _, arm in ipairs(node.cases or {}) do
                for _, value in ipairs(arm.values or {}) do
                    analyzeExpr(value, chain, here, seen)
                end
                chain[#chain + 1] = {}
                if arm.binding then
                    chain[#chain][tokText(arm.binding)] = here
                end
                for _, field in ipairs(arm.fields or {}) do
                    chain[#chain][tokText(field.alias or field.name)] = here
                end
                analyzeExpr(arm.guard and arm.guard.expr, chain, here, seen)
                analyzeExpr(arm.expr, chain, here, seen)
                if arm.body then
                    analyzeBlock(arm.body, chain, here, seen)
                end
                chain[#chain] = nil
            end
            local fallback = node.elseCase
            if fallback then
                analyzeExpr(fallback.expr, chain, here, seen)
                if fallback.body then
                    analyzeBlock(fallback.body, chain, here, seen)
                end
            end
            return
        end
        for _, v in ipairs(node) do
            if type(v) == "table" then
                analyzeExpr(v, chain, here, seen)
            end
        end
    end
    analyzeBlock = function(block, chain, here, seen)
        chain[#chain + 1] = {}
        for _, st in ipairs(block and (block.stats or block) or {}) do
            if type(st) == "table" then
                analyzeStmt(st, chain, here, seen)
            end
        end
        chain[#chain] = nil
    end
    analyzeStmt = function(st, chain, here, seen)
        local k = st.kind
        local scope = chain[#chain]
        noteCleanups(st, chain, here)
        if k == "localStmt" then
            if st.patternSource then
                analyzeExpr(st.patternSource, chain, here, seen)
            end
            for _, e in ipairs(st.exprs or {}) do
                analyzeExpr(e, chain, here, seen)
            end
            for _, t in ipairs(st.names or {}) do
                scope[tokText(t)] = here
            end
        elseif k == "cdefFunc" then
            scope[tokText(st.name)] = here
        elseif k == "localFuncStmt" then
            scope[tokText(st.name)] = here
            analyzeFunction(st.body, chain, seen)
        elseif k == "funcStmt" then
            if st.name and st.name.base then
                noteUse(chain, tokText(st.name.base), here)
            end
            analyzeFunction(st.body, chain, seen, st.name and st.name.method ~= nil)
        elseif k == "compoundAssign" then
            analyzeExpr(st.target, chain, here, seen);
            analyzeExpr(st.value, chain, here, seen)
        elseif k == "recordDecl" or k == "cdefStruct" then
            if st.name and not st.qualifiers then
                scope[tokText(st.name)] = here
            end
            for _, entry in ipairs(st.entries or {}) do
                if entry.kind == "inlineMethod" then
                    analyzeFunction(entry.body, chain, seen, inlineImplicitSelf(entry))
                elseif entry.kind == "recordDecl" then
                    analyzeStmt(entry, chain, here, seen)
                elseif entry.kind ~= "constructorDecl" then
                    analyzeExpr(entry, chain, here, seen)
                end
            end
            chain[#chain + 1] = {}
            for _, generated in ipairs(st.vmMetadata or {}) do
                analyzeStmt(generated, chain, here, seen)
            end
            chain[#chain] = nil
        elseif k == "ifStmt" then
            for _, clause in ipairs(st.clauses or {}) do
                analyzeExpr(clause.cond, chain, here, seen);
                analyzeBlock(clause.body, chain, here, seen)
            end
            if st.elseClause then
                analyzeBlock(st.elseClause.body or st.elseClause, chain, here, seen)
            end
        elseif k == "whileStmt" then
            analyzeExpr(st.cond, chain, here, seen);
            analyzeBlock(st.body, chain, here, seen)
        elseif k == "repeatStmt" then
            chain[#chain + 1] = {}
            for _, s2 in ipairs(st.body and st.body.stats or {}) do
                analyzeStmt(s2, chain, here, seen)
            end
            analyzeExpr(st.cond, chain, here, seen)
            chain[#chain] = nil
        elseif k == "fornumStmt" then
            analyzeExpr(st.start, chain, here, seen);
            analyzeExpr(st.stop, chain, here, seen);
            if st.step then
                analyzeExpr(st.step, chain, here, seen)
            end
            chain[#chain + 1] = {[tokText(st.var)] = here}
            analyzeBlock(st.body, chain, here, seen)
            chain[#chain] = nil
        elseif k == "forinStmt" then
            for _, e in ipairs(st.exprs or {}) do
                analyzeExpr(e, chain, here, seen)
            end
            chain[#chain + 1] = {}
            for _, t in ipairs(st.names or {}) do
                chain[#chain][tokText(t)] = here
            end
            analyzeBlock(st.body, chain, here, seen)
            chain[#chain] = nil
        elseif k == "withStmt" then
            chain[#chain + 1] = {}
            for _, binding in ipairs(st.bindings or {}) do
                analyzeExpr(binding.expr, chain, here, seen)
                noteCleanups(binding, chain, here)
                chain[#chain][tokText(binding.name)] = here
            end
            analyzeBlock(st.body, chain, here, seen)
            chain[#chain] = nil
        elseif k == "doStmt" then
            analyzeBlock(st.body or st, chain, here, seen)
        elseif k == "pragmaStmt" then
            if st.stat then
                analyzeStmt(st.stat, chain, here, seen)
            end
        elseif k == "exportStmt" then
            if st.stat then
                analyzeStmt(st.stat, chain, here, seen)
            end
            if st.value then
                analyzeExpr(st.value, chain, here, seen)
            end
        else
            -- Assignments, calls, returns and the rest: expressions only.
            for _, v in ipairs(st) do
                if type(v) == "table" then
                    analyzeExpr(v, chain, here, seen)
                end
            end
        end
    end
    -- `implicitSelf` is the colon form, `function a:m()`: only there is `self`
    -- a parameter rather than whatever enclosing local the name reaches.
    analyzeFunction = function(funcbody, chain, seen, implicitSelf, predeclared)
        -- Generated metadata can share syntax nodes between functions. A read
        -- already visited in the parent still captures its binding here.
        seen = {}
        local here = funcbody
        chain[#chain + 1] = {}
        for _, p in ipairs(funcbody.params or {}) do
            if p.name then
                chain[#chain][tokText(p.name)] = here
            end
        end
        if implicitSelf then
            chain[#chain]["self"] = here
        end
        chain[#chain]["..."] = here
        for _, name in ipairs(predeclared or {}) do
            chain[#chain][name] = here
        end
        fnStack[#fnStack + 1] = funcbody
        for _, capture in ipairs(funcbody.takenCaptures or {}) do
            noteUse(chain, capture.name, here)
            for _, cleanup in ipairs(capture.type.cleanups or {}) do
                noteCleanup(chain, cleanup, here)
            end
        end
        if funcbody.expr then
            analyzeExpr(funcbody.expr, chain, here, seen)
        else
            analyzeBlock(funcbody.body, chain, here, seen)
        end
        fnStack[#fnStack] = nil
        chain[#chain] = nil
    end

    -- Run once per module over its root block; `markCaptures` then reads the result.
    local function analyzeModule(rootBlock, predeclared)
        local root = {body = rootBlock, params = {}}
        analyzeFunction(root, {}, {}, false, predeclared)
        return root
    end

    -- How many locals a body declares, nested functions included (an
    -- over-count only costs a register in a function that did not need it).
    local function declarationCount(body)
        local n = 0
        walkSyntax(body, {}, function(node)
            if node.kind == "localStmt" then
                n = n + #(node.names or {})
            elseif node.kind == "localFuncStmt"
                or node.kind == "cdefFunc"
                or node.kind == "recordDecl"
                or node.kind == "cdefStruct"
                or node.kind == "fornumStmt"
            then
                n = n + 1
            elseif node.kind == "forinStmt" then
                n = n + #(node.names or {})
            end
        end)

        return n
    end

    -- A function with more declarations than the budget gets its spill table
    -- at entry, so every spilled local below sees it.
    openSpill = function(f: Fn, body)
        if declarationCount(body) > SPILL_AT then
            f.spillReg = f:declare("\0spill", "v")
            f:op("NewTableN", f.spillReg, 0, 0)
        end
    end
    -- A local of this function is a cell when the analysis saw a nested
    -- function read it: exact per declaration site, by name per function.
    markCaptures = function(f: Fn, funcbody)
        local set = capturedOf[funcbody]
        if set then
            for name in pairs(set) do
                f.captured[name] = true
            end
        end
    end

    defineFunction = function(f: Fn, funcbody)
        local native = nativePlans[funcbody]
        if native and not f.implicitSelf then
            f.graph, f.gpu = native.graph, native.gpu
            return
        end
        f.constructorSelf = funcbody.vmConstructorSelf
        local statements = funcbody.body
        if funcbody.expr then
            statements = {stats = {{kind = "returnStmt", exprs = {funcbody.expr}}}}
        end
        local params = funcbody.params or {}
        local cellParams = {}
        if f.implicitSelf then
            if f.captured["self"] then
                local r = f:reg();
                cellParams[#cellParams + 1] = {"self", r}
            else
                f:declare("self", "v")
            end
        end
        local varargParam
        for _, p in ipairs(params) do
            if p.vararg then
                varargParam = p
            else
                local name = tokText(p.name)
                if f.captured[name] then
                    local r = f:reg();
                    cellParams[#cellParams + 1] = {name, r}
                else
                    f:declare(name, "v")
                end
            end
        end
        -- The surplus arguments stay in the frame; `...` is spread only in a call.
        if varargParam then
            assert(not varargParam.name, "a named vararg is not in this emitter")
        end
        for _, cp in ipairs(cellParams) do
            local cellReg = f:declare(cp[1]);
            f:op("NewCell", cellReg, cp[2])
        end
        reserveCoverageCounts(f)
        openSpill(f, statements)
        -- Every capture the body reads gets its register now, below the locals,
        -- so no scope's end reclaims it: the analysis's free names of this
        -- function that resolve to upvalues (a nested local of the same name
        -- declared later in the body does not hide them).
        if f.parent then
            if environment then
                f:upvalReg(assert(f:upvalue("\0environment")))
            end
            local names = {}
            for name in pairs(freeOf[funcbody] or {}) do
                names[#names + 1] = name
            end
            table.sort(names)
            for _, name in ipairs(names) do
                local ui = f:upvalue(name, true);
                if ui then
                    f:upvalReg(ui)
                end
            end

        end
        if #(funcbody.takenCaptures or {}) > 0 then
            f:op("AffineEnter")
        end
        for _, capture in ipairs(funcbody.vmCaptureDrops or {}) do
            local value = exprAs(f, {kind = "name", token = {text = capture.name}, inferredType = {tag = "any"}}, "v")
            local slots = {}
            f.cleanupOwners = f.cleanupOwners or {}
            if capture.automaticOwner then
                f.cleanupOwners[capture.automaticOwner] = slots
            end
            for i = #(capture.type.cleanups or {}), 1, -1 do
                local depth = f.cleanupDepth or 0
                deferCleanup(f, value, capture.type.cleanups[i])
                slots[#slots + 1] = {depth = depth, field = capture.type.cleanups[i].field}
            end
        end
        local entered = covered and covered.functions[funcbody]
        if entered then
            f.curLine = nodeLine(funcbody) or f.curLine
            count(f, tostring(entered))
        end
        -- EMIT_SURVEY=1 keeps going past a construct the emitter lacks: the body
        -- becomes a stub and the failure is tallied, so one run over a module
        -- graph lists everything it would need.
        if os.getenv("EMIT_SURVEY") then
            local ok, err = pcall(block, f, statements)
            if not ok then
                local key = tostring(err)
                    :gsub("^.-:%d+: ", "")
                    :gsub(" in [%w%.:_]+$", "")
                    :gsub("line %d+", "line N")
                    :gsub("declTop %d+", "")
                SURVEY[key] = (SURVEY[key] or 0) + 1
                SURVEY_EXAMPLE = SURVEY_EXAMPLE or {};
                SURVEY_EXAMPLE[key] = SURVEY_EXAMPLE[key] or (f.name .. " :: " .. tostring(err):gsub("^.-:%d+: ", ""))
                f:reset()
                f.scopes = {{}}
            end
        else
            block(f, statements)
        end
        -- Falling off the end returns nothing; after a return this lands in a
        -- block nothing reaches.
        f:op("RetNil")
        local loads = {}
        for ui, r in pairs(f.upvalRegs or {}) do
            loads[#loads + 1] = {"GetUpval", r, ui}
        end
        table.sort(loads, function(a, b)
            return a[3] < b[3]
        end)
        local entry = f:entry().code
        for i = #loads, 1, -1 do
            table.insert(entry, 1, loads[i])
        end
        loadCoverageCounts(f)
    end

    -- Modules ----------------------------------------------------------------------
    local modules, moduleOrder = {}, {}
    local modulePath = resolve
    local pendingModules = {}
    queueModule = function(name)
        pendingModules[#pendingModules + 1] = name
    end

    local function requiresOf(tree)
        local names = {}
        walkSyntax(tree, {}, function(n)
            if n.typeOnlyRequire then
                return false
            end
            -- `require("m")`, and softly `_G.require("m")`, which a facade spells
            -- to choose a provider at run time: the resolver decides whether the
            -- image carries one.
            local callee = n.kind == "call" and n.obj or nil
            local plain = callee and callee.kind == "name" and tokText(callee.token) == "require"
            local soft = callee
                and callee.kind == "dotIndex"
                and callee.obj.kind == "name"
                and tokText(callee.obj.token) == "_G"
                and tokText(callee.name) == "require"
            if (plain or soft) and n.args and n.args.exprs[1] and n.args.exprs[1].kind == "string" then
                local name = (loadstring("return " .. tokText(n.args.exprs[1].token)))()
                names[#names + 1] = soft and {name = name, soft = true} or name
            end
        end)

        return names
    end

    -- A module that loads another by a computed name says which with
    -- `@requires-dynamically NAME`, and that module belongs to the image as a
    -- literal require's does. A wildcard or `nothing` names no one module.
    local function declaredDynamically(path)
        local file = io.open(path, "rb")
        if not file then
            return {}
        end
        local text = file:read("*a")
        file:close()
        local names = {}
        for name in text:gmatch("@requires%-dynamically%s+([%w%.%*%-_]+)") do
            if name ~= "nothing" and not name:find("*", 1, true) then
                names[#names + 1] = name
            end
        end

        return names
    end

    -- Modules named in EMIT_STUBS (comma-separated) are emitted as empty
    -- exports: for a workload that loads a module whose dependencies cannot
    -- run here, when the workload itself never calls into it.
    local STUBS = {}
    for n in (os.getenv("EMIT_STUBS") or ""):gmatch("[^,]+") do
        STUBS[n] = true
    end

    local function compileModule(name, path)
        if modules[name] then
            return
        end
        modules[name] = true
        if STUBS[name] then
            local chunk = newFn("module:" .. name, nil)
            chunk.sig, chunk.ret, chunk.nparams = {}, "v", 0
            local r = chunk:reg();
            chunk:op("NewTableN", r, 0, 0);
            chunk:op("Ret", r)
            modules[name] = chunk
            moduleOrder[#moduleOrder + 1] = name
            io.stderr:write("module ", name, " stubbed\n")
            return
        end
        local runtime = coverage and name == COVERAGE_RUNTIME
        -- A kept fragment carries no coverage probes, so a covered emit lowers.
        local kept = linker and not coverage and linker.fragment(name, path)
        if kept then
            for _, entry in ipairs(kept.deps) do
                local dep = type(entry) == "table" and entry.name or entry
                local depPath = modulePath(dep, type(entry) == "table")
                if depPath then
                    compileModule(dep, depPath)
                end
            end
            if linker.replay(name, kept, functions, modules, moduleOrder, pendingModules) then
                currentModule = name
                return
            end
        end
        local tree: table = runtime
            and require("nupp.compiler.syntax.parser").parse(COVERAGE_RUNTIME_SOURCE, "=(coverage)").root as table
            or check(name, path)
        assert(tree, "check failed for " .. tostring(path))
        local rootNode = tree.root or tree
        -- Numbered before the metadata expansion adds statements of its own, which
        -- were never the source's.
        local moduleCoverage = nil
        local request = not runtime and coverage or nil
        local reportPath = request and request.path(name, path) or nil
        if request and reportPath then
            moduleCoverage = require("nupp.compiler.coverage").enumerate(rootNode, reportPath)
            request.manifests[name] = moduleCoverage.manifest
        end
        require("nupp.compiler.vm.metadata").expand(rootNode, name)
        -- Lua's string and table call forms are single arguments too. Keep the
        -- parser's nodes so source positions and checked identities survive.
        walkSyntax(rootNode, {}, function(node)
            -- `&&`, `||`, `!=` and `!` lower as the operators they spell.
            local spelled = (node.kind == "binop" or node.kind == "unop")
                and node.op
                and OPERATOR_SPELLINGS[tokText(node.op)]
            if spelled then
                node.op = {text = spelled, line = node.op.line, col = node.op.col}
            end
            if node.kind == "args" and not node.exprs then
                if node.table then
                    node.exprs = {node.table}
                elseif node.str then
                    node.exprs = {{kind = "string", token = node.str}}
                end
            end
        end)
        local stats = rootNode.blocks[1].stats
        local deps = requiresOf(rootNode)
        for _, dep in ipairs(runtime and {} or declaredDynamically(path)) do
            deps[#deps + 1] = dep
        end
        if moduleCoverage then
            compileModule(COVERAGE_RUNTIME, nil)
        end
        for _, entry in ipairs(deps) do
            local dep = type(entry) == "table" and entry.name or entry
            local depPath = modulePath(dep, type(entry) == "table")
            if depPath then
                compileModule(dep, depPath)
            elseif os.getenv("EMIT_TRACE") then
                io.stderr:write("module ", dep, " not found (left to the runtime)\n")
            end
        end
        currentModule = name
        covered = moduleCoverage
        local capture = linker and not coverage and linker.begin(name, #functions, #pendingModules)
        nativePlans = require("nupp.compiler.vm.kernels").plans(rootNode)
        for _, s in ipairs(stats) do
            if s.kind == "recordDecl" or s.kind == "cdefStruct" then
                declareShape(s)
            elseif s.kind == "exportStmt"
                and s.stat
                and (s.stat.kind == "recordDecl" or s.stat.kind == "cdefStruct")
            then
                declareShape(s.stat)
            end
        end
        -- Records declared inside functions get their shapes now too, so a
        -- constructor in a closure defined before the declaration finds them.
        walkSyntax(rootNode, {}, function(n)
            if n.kind == "recordDecl" or n.kind == "cdefStruct" then
                declareShape(n)
            end
        end)
        local chunk = newFn("module:" .. name, nil)
        chunk.sig, chunk.ret, chunk.nparams = {}, "v", 0
        local declaredModule = false
        for _, s in ipairs(stats) do
            if s.kind == "moduleStmt" then
                declaredModule = true
            end
        end
        local exportedFns = declaredModule and exportedFunctionNames(rootNode.blocks[1]) or {}
        local rootBody = analyzeModule(rootNode.blocks[1], exportedFns)
        -- Names the module assigns to anywhere, by name: a `local function` not
        -- among them keeps its closure for the module's life.
        assignedNames = {}
        walkSyntax(rootNode.blocks[1], {}, function(n)
            if n.kind == "assignStmt" then
                for i, t in ipairs(n.targets) do
                    if t.kind == "name" then
                        assignedNames[tokText(t.token)] = true
                    end
                end
            end
        end)
        markCaptures(chunk, rootBody)
        -- A module chunk is vararg, as a Lua chunk is: `require` passes it the
        -- module name and `nupp run` the program's arguments. Only a chunk that
        -- reads `...` keeps them, which leaves every other one compilable.
        walkSyntax(rootNode.blocks[1], {}, function(n)
            if n.kind == "funcbody" or n.kind == "shortfn" then
                return false
            end
            if n.kind == "vararg" then
                chunk.vararg = true
            end
        end)
        if environment then
            chunk.sig, chunk.nparams, chunk.vararg = {"v"}, 1, true
            local context = chunk:reg()
            chunk.captured["\0environment"] = true
            local cell = chunk:declare("\0environment", "v")
            chunk:op("NewCell", cell, context)
        end
        reserveCoverageCounts(chunk)
        openSpill(chunk, rootNode.blocks[1])
        if declaredModule then
            chunk.exportsReg = chunk:declare("\0exports", "v")
            -- The exports as a record of the names the module declares: a
            -- qualified reference elsewhere (`T.pack`) is then a cached slot read
            -- rather than a dictionary lookup. A module that assigns `export = v`
            -- keeps a table, since its value is whatever it chose.
            local moduleShape = exportShape(name, rootNode.blocks[1])
            if moduleShape then
                chunk:op("NewRecord", chunk.exportsReg, moduleShape.id)
            else
                chunk:op("NewTableN", chunk.exportsReg, 0, 0)
            end
            -- A module required again while it loads, by itself or through a
            -- cycle, gets the exports it is still filling, as the Lua backend's
            -- early publication gave it. A body that raises unpublishes them.
            -- One that loads SPI providers publishes nothing early, as there: a
            -- provider must not see a facade it has not finished initializing.
            local loadsSpi = false
            walkSyntax(rootNode.blocks[1], {}, function(n)
                loadsSpi = loadsSpi or n.spiInterface ~= nil
            end)
            if not loadsSpi then
                local package, loaded, key = chunk:reg(), chunk:reg(), chunk:reg()
                chunk:op("Require", package, chunk:const("str", "package"))
                chunk:op("GetField", loaded, package, chunk:const("str", "loaded"))
                chunk:op("K", key, chunk:const("str", name))
                chunk:op("SetIdx", loaded, key, chunk.exportsReg)
                chunk.nregs = chunk.nregs - 3
            end
            for _, fname in ipairs(exportedFns) do
                local r, cell = chunk:declare(fname, "v")
                if cell then
                    local t = chunk:reg();
                    chunk:op("Nil", t);
                    chunk:op("NewCell", r, t);
                    chunk.nregs = chunk.nregs - 1
                else
                    chunk:op("Nil", r)
                end
            end
        end
        if os.getenv("EMIT_SURVEY") then
            local ok, err = pcall(block, chunk, rootNode.blocks[1]);
            if not ok then
                local key = tostring(err)
                    :gsub("^.-:%d+: ", "")
                    :gsub(" in [%w%.:_]+$", "")
                    :gsub("line %d+", "line N")
                    :gsub("declTop %d+", "");
                SURVEY[key] = (SURVEY[key] or 0) + 1;
                SURVEY_EXAMPLE = SURVEY_EXAMPLE or {};
                SURVEY_EXAMPLE[key] = SURVEY_EXAMPLE[key]
                    or (chunk.name .. " :: " .. tostring(err):gsub("^.-:%d+: ", ""));
                chunk:reset()
            end
        else
            block(chunk, rootNode.blocks[1])
        end
        if chunk.exportsReg then
            chunk:op("Ret", chunk.exportsReg)
        else
            chunk:op("RetNil")
        end
        loadCoverageCounts(chunk)
        modules[name] = chunk
        moduleOrder[#moduleOrder + 1] = name
        covered = nil
        if capture then
            linker.finish(capture, chunk.id, #functions, deps, pendingModules)
        end
    end

    for _, name in ipairs(extras) do
        local p = assert(modulePath(name), "extra module " .. name);
        compileModule(name, p)
    end
    compileModule(entryName, assert(modulePath(entryName), "entry module " .. entryName))
    -- `extras.after` names modules carried beside the entry's graph, compiled
    -- once that graph is, so each is checked as the graph already loaded it.
    local after = (extras as any).after or {}
    local afterIndex = 0
    repeat
        while #pendingModules > 0 do
            local name = table.remove(pendingModules, 1);
            if not modules[name] then
                local p = modulePath(name);
                if p then
                    compileModule(name, p)
                end
            end
        end
        afterIndex = afterIndex + 1
        local name = after[afterIndex]
        if name and not modules[name] then
            local p = modulePath(name)
            if p then
                compileModule(name, p)
            end
        end
    until afterIndex > #after

    -- Output -------------------------------------------------------------------
    if functionsOut then
        -- What hot reload matches a function by across two lowerings: its
        -- lexical parent and its captured names in upvalue order.
        for _, f in ipairs(functions) do
            local captures = {}
            for captured, index in pairs(f.upvalIndex) do
                captures[index + 1] = captured
            end
            functionsOut[
                #functionsOut + 1
            ] = {id = f.id, name = f.name, parent = f.parent and f.parent.id, captures = captures}
        end
    end
    -- Each module's source path, absolute, for `debug.getinfo(1, "S").source`
    -- and error positions. A chunk's own name (`=name` or `@path`) is kept.
    local moduleList = {}
    for i, name in ipairs(moduleOrder) do
        local p = coverage and name == COVERAGE_RUNTIME and "=(coverage)" or modulePath(name)
        if p and p:sub(1, 1) ~= "/" and p:sub(1, 1) ~= "=" and p:sub(1, 1) ~= "@" then
            p = (os.getenv("PWD") or ".") .. "/" .. p
        end
        if p and lower.pathMapper then
            p = (lower.pathMapper as function(path: string): string?)(p)
        end
        moduleList[i] = {name = name, chunk = modules[name].id, path = p}
    end
    -- The header the graph image carries beside its functions.
    local header = {shapes = shapeOrder, modules = moduleList, entry = modules[entryName].id}
    if lower.graphSink then
        local sink = lower.graphSink as function(entry: string, functions: {Fn}, header: table)
        sink(entryName, functions, header)
    end
    if linker then
        for _, f in ipairs(functions) do
            linker.wrote(f)
        end
        linker.keep(functions)
        local reused: any = reuse
        reused.stats = linker.stats
    end
    local result = graphemit.image(
        functions,
        header,
        listing and function(f: Fn, g: any): nil
            if f.module == entryName then
                local entries = listing as table
                entries[#entries + 1] = graphemit.listing(f, g)
            end
        end or nil
    )
    if os.getenv("EMIT_SURVEY") then
        local rows = {};
        for k, n in pairs(SURVEY) do
            rows[#rows + 1] = {k, n}
        end;
        table.sort(rows, function(a, b)
            return a[2] > b[2]
        end);
        io.stderr:write("survey: ", #functions, " functions, ", #rows, " failure kinds\n");
        for _, r in ipairs(rows) do
            io.stderr:write(
                string.format(
                    "  %5d  %s\n         e.g. %s\n",
                    r[2],
                    r[1],
                    tostring(SURVEY_EXAMPLE and SURVEY_EXAMPLE[r[1]])
                )
            )
        end
    end

    return result
end

export = lower
