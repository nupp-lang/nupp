module nupp.compiler.vm.lower

local functiongraph = require("nupp.compiler.vm.functiongraph")
local lower = {}

-- Every admitted guest/runtime function uses this checked CST-to-CFG builder.
function lower.functionGraph(fn: any, options: any, profile: any): any
    return functiongraph.compile(fn, options, profile)
end

-- Frozen toolchain configuration. The core only calls functionGraph.
-- Keep these fields until all branch consumers have moved to the graph.
lower.pathMapper = nil as(function(path: string): string?)?
lower.graphSink = nil as(function(entry: string, functions: {any}, header: table): nil)?

type lower.CoverageRequest = {
    path: function(name: string, source: string): string?,
    manifests: {[string]: any}
}

function lower.emit(
    entryName: string,
    extras: {string},
    resolve: function(name: string, soft: boolean?): string?,
    check: function(name: string, path: string): table,
    environment: boolean?,
    listing: table?,
    layoutTarget: string?,
    coverage: lower.CoverageRequest?,
    reuse: table?,
    functionsOut: table?
): string
    local legacy = require("nupp.compiler.vm.legacylower")
    local previousPath, previousSink = legacy.pathMapper, legacy.graphSink
    legacy.pathMapper, legacy.graphSink = lower.pathMapper, lower.graphSink
    local ok, result = pcall(
        legacy.emit,
        entryName,
        extras,
        resolve,
        check,
        environment,
        listing,
        layoutTarget,
        coverage,
        reuse,
        functionsOut
    )
    legacy.pathMapper, legacy.graphSink = previousPath, previousSink
    if not ok then
        error(result, 0)
    end

    return result as string
end

-- Importers set pathMapper and graphSink on this table and the lowering reads
-- them back, so the module value has to be the table itself.
export = lower
