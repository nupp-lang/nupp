module nupp.compiler.vm.functioncleanup

local construction = require("nupp.compiler.vm.construction")

local function need(ok: any, message: string): any
    -- The message is built only for a failure: checks run millions of times.
    if not ok then
        error("function cleanup: " .. message, 0)
    end
    return ok
end

-- These are checked syntax queries, not cleanup-call authority. A profile must
-- bind each retained cleanup to its actual checked declaration and signature.
export function affine(t: any): any
    if not t or t.tag ~= "affine" then
        return nil
    end
    -- An optional owner is a union of its value and nil.
    local optional = t.inner ~= nil
        and t.inner.tag == "union"
        and t.inner.hasNil == true
        and #(t.inner.members or {}) == 2
    need(t.inner and (t.inner.tag ~= "union" or optional), "conditional owner cleanup is unsupported")
    need(#(t.cleanups or {}) > 0, "owner lacks an exact cleanup chain")
    -- An optional owner holds nil or its value; Destroy passes nil by, so a
    -- free function's cleanup needs no test. Optional methods require the
    -- profile to guard both the receiver lookup and terminal call.
    for _, item in ipairs(t.cleanups) do
        need(
            item.kind == "closure" and item.id == "generated:closure"
            or item.kind == "function" and item.functionType
            or item.kind == "method"
            and type(item.name) == "string"
            and (not optional or item.id == "method:" .. item.name),
            "only checked free-function or canonical method cleanup is supported"
        )
    end

    return t
end

-- A fresh result needs a temporary until a local, field or argument takes it.
-- A plain construction acquires its obligation at the receiving site.
export function freshOwner(node: any): boolean
    return node.inferredType ~= nil
        and node.inferredType.tag == "affine"
        and (
            node.kind == "call" and not construction.bare(node)
            or node.kind == "orExitExpr" and node.orExitProtected
            or node.kind == "funcExpr" and #(node.body.takenCaptures or {}) > 0
        )
end

export function localOwner(stat: any, index: integer): any
    local owner = stat.automaticOwners and stat.automaticOwners[index]
    if not owner then
        return nil
    end
    local token = stat.names[index]
    local exprs = stat.exprs or {}
    local initializer = exprs[index] or exprs[#exprs]
    need(
        owner.stat == stat
        and owner.index == index
        and owner.expr == initializer
        and owner.token == token
        and owner.entry
        and owner.entry.definition == token.definition
        and owner.entry.automaticOwner == owner
        and owner.type == owner.entry.t,
        "local owner does not match its checked binding"
    )
    need(
        not owner.conditional and not owner.correlated and not owner.guards,
        "conditional local owner cleanup is unsupported"
    )
    local t = need(affine(owner.type), "local owner requires an affine type")
    need(owner.cleanups == t.cleanups, "local owner cleanup chain changed")

    return owner
end

export function move(move: any): any
    need(move and not move.field and not move.owner, "partial-field ownership transfer is unsupported")
    return move
end

export function source(node: any): any
    while node
        and (
            node.kind == "paren" or node.kind == "castExpr" or node.kind == "orExitExpr" and not node.orExitProtected
        ) do
        node = node.kind == "orExitExpr" and node.operand or node.expr
    end

    return node
end
