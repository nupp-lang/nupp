module nupp.compiler.vm.functioncleanup

local cleanup = {}

local function need(ok: any, message: string): any
    assert(ok, "function cleanup: " .. message)
    return ok
end

-- These are checked syntax queries, not cleanup-call authority. A profile must
-- bind each retained cleanup to its actual checked declaration and signature.
function cleanup.type(t: any): any
    if not t or t.tag ~= "affine" then
        return nil
    end
    -- An optional owner is a union of its value and nil.
    local optional = t.inner ~= nil
        and t.inner.tag == "union"
        and t.inner.hasNil == true
        and #(t.inner.members or {}) == 2
    need(t.inner and (t.inner.tag ~= "union" or optional), "conditional owner cleanup is unsupported")
    need(#(t.cleanups or {}) > 0, "owner lacks an exact cleanup chain")
    -- An optional owner holds nil or its value; Destroy passes nil by, so a
    -- free function's cleanup needs no test. Optional methods require the
    -- profile to guard both the receiver lookup and terminal call.
    for _, item in ipairs(t.cleanups) do
        need(
            item.kind == "function" and item.functionType
            or item.kind == "method"
            and type(item.name) == "string"
            and (not optional or item.id == "method:" .. item.name),
            "only checked free-function or canonical method cleanup is supported"
        )
    end

    return t
end

function cleanup.localOwner(stat: any, index: integer): any
    local owner = stat.automaticOwners and stat.automaticOwners[index]
    if not owner then
        return nil
    end
    local token = stat.names[index]
    need(
        owner.stat == stat
        and owner.index == index
        and owner.expr == (stat.exprs or {})[index]
        and owner.token == token
        and owner.entry
        and owner.entry.definition == token.definition
        and owner.entry.automaticOwner == owner
        and owner.type == owner.entry.t,
        "local owner does not match its checked binding"
    )
    need(not owner.correlated and not owner.guards, "conditional local owner cleanup is unsupported")
    local t = need(cleanup.type(owner.type), "local owner requires an affine type")
    need(owner.cleanups == t.cleanups, "local owner cleanup chain changed")

    return owner
end

function cleanup.move(move: any): any
    need(move and not move.field and not move.owner, "partial-field ownership transfer is unsupported")
    return move
end

function cleanup.source(node: any): any
    while node and (node.kind == "paren" or node.kind == "castExpr") do
        node = node.expr
    end
    return node
end

export = cleanup
