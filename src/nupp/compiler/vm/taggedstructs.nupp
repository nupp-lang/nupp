module nupp.compiler.vm.taggedstructs

-- A guest program's structs in the tagged profile. An instance is core
-- storage of its bytes in C layout (the storage library's allocbytes), so a
-- struct handed to C is the memory C reads. A field is read and written
-- through a view of its bytes at its offset (STORAGE_VIEW), as an element of
-- the field's storage kind; a nested struct or fixed array is that view
-- itself, a reference into its parent's bytes, as the language states.
--
-- The layout is the host project's C ABI, which libffi also uses for calls.
const taggedvalues = require("nupp.compiler.vm.taggedvalues")
const corelibrary = require("nupp.compiler.vm.corelibrary")
const layouts = require("nupp.compiler.targetlayout")
const metadata = require("nupp.compiler.vm.metadata")
const derivedmembers = require("nupp.compiler.vm.derivedmembers")
const need = taggedvalues.need
const pool = taggedvalues.pool

const LAYOUT_KEY = "\0nupp:structLayout"
-- The storage element kinds (corestorage): each scalar's code.
const UINT8 = 1
const KINDS: {
    [string]: integer
} = {
    uint8 = 1,
    int8 = 2,
    uint16 = 3,
    int16 = 4,
    uint32 = 5,
    int32 = 6,
    uint64 = 7,
    int64 = 8,
    float32 = 9,
    float64 = 10,
    number = 10
}
-- A pointer field holds an address, which the core keeps as an integer.
const POINTER_KIND = 7
-- `integer` takes the width the layout gives it.
const INTEGER_KINDS: {[integer]: integer} = {[4] = 6, [8] = 8}
const UNSIGNED_KINDS: {[integer]: integer} = {[1] = 1, [2] = 3, [4] = 5, [8] = 7}
-- The active core has natural C layouts up to eight-byte alignment.
const MAX_ALIGNMENT = 8

-- The type behind ownership and constant wrappers.
local function bare(t: any): any
    while t
        and (
            t.tag == "const"
            or t.tag == "literal"
            or t.tag == "affine"
            or t.tag == "borrowed"
            or t.tag == "pinned"
            or t.tag == "genericAlias"
        ) do
        t = t.tag == "literal" and t.base or t.tag == "genericAlias" and t.body or t.inner
    end

    return t
end

-- The struct declaration a checked type names, or nil.
export function origin(t: any): any
    local subject = bare(t)
    local declared = subject and (subject.origin or subject)
    if declared and declared.tag == "nominal" and declared.declKind == "struct" then
        return declared
    end

    return nil
end

local laid: any = setmetatable({}, {__mode = "k"})

-- The struct's layout: size, alignment and each field's offset and size.
local function layout(declared: any): any
    local known = laid[declared]
    if known == nil then
        local target: string = need(layouts.hostKey(), "the core host's C layout is unavailable")
        local measured, reason = layouts.of(declared, target)
        known = need(measured, "a struct has no C layout: " .. tostring(reason))
        laid[declared] = known
    end

    return known
end

-- A type object keeps one descriptor, shared by all queries that name it.
export function attachLayout(ctx: any, declaration: any, class: any): nil
    local descriptor = metadata.structLayout(declaration, layouts.hostKey())
    local facts = ctx.hold(derivedmembers.plainData(ctx, declaration, descriptor))
    local key = ctx.emit(declaration, "K", {pool(ctx, "str", LAYOUT_KEY)}, "tagged")
    ctx.emit(declaration, "SetIdx", {ctx.readHeld(class), key, ctx.readHeld(facts)}, nil)
    ctx.release(facts)
end

export function queryLayout(ctx: any, node: any): integer?
    local subject = node.args.exprs[1]
    local witness = ctx.expression(subject, "tagged")
    if witness == nil then
        return nil
    end
    local key = ctx.emit(node, "K", {pool(ctx, "str", LAYOUT_KEY)}, "tagged")
    local facts = ctx.hold(ctx.emit(node, "GetIdx", {witness, key}, "tagged"))
    local supported = ctx.emit(node, "K", {pool(ctx, "str", "supported")}, "tagged")
    local present = ctx.emit(node, "GetIdx", {ctx.readHeld(facts), supported}, "tagged")
    local unsupported = ctx.emit(node, "Not", {present}, "tagged")
    ctx.when(node, unsupported, function(c: any): nil
        local key = c.emit(node, "K", {pool(c, "str", "error")}, "tagged")
        local message = c.emit(node, "GetIdx", {c.readHeld(facts), key}, "tagged")
        taggedvalues.landed(c, node, c.emit(node, "LibCall", {corelibrary.id("ERROR"), message}, "tagged"))
    end)
    local value = ctx.readHeld(facts)
    ctx.release(facts)

    return value
end

-- A pointer the core passes as its address: any C pointer, nullable or not.
local function pointer(t: any): boolean
    if t.tag == "union" and t.hasNil and #(t.members or {}) == 2 then
        local other = t.members[1].tag == "nil" and t.members[2] or t.members[1]
        return other ~= nil and pointer(other)
    end

    return t.tag == "ptr" or t.tag == "cstring" or t.tag == "voidptr" or t.tag == "func" and t.foreign == true
end

-- The storage kind of a scalar or pointer of `size` bytes, or nil.
local function scalarKind(t: any, size: integer): integer?
    if pointer(t) then
        return POINTER_KIND
    elseif t.tag == "integer" then
        return INTEGER_KINDS[size]
    end

    return KINDS[t.tag]
end

-- How field `name` of a struct is reached: its offset and bytes, and the
-- storage kind of a scalar one, or the element kind and count of a fixed
-- array of scalars, or the struct a nested one is.
local function member(declared: any, name: string): any
    local measured = layout(declared)
    local placed = nil
    for _, field in ipairs(measured.fields) do
        if field.name == name then
            placed = field
        end
    end
    need(placed, "a struct field is not declared: " .. name)
    local t = need(bare(declared.byname[name]), "a struct field has no type")
    local reached: any = {offset = placed.offset, size = placed.size}
    reached.nullablePointer = t.tag == "union" and t.hasNil and pointer(t)
    if placed.bitWidth ~= nil then
        reached.kind = need(UNSIGNED_KINDS[placed.size], "a bitfield has no storage kind")
        reached.bitWidth, reached.bitOffset = placed.bitWidth, placed.bitOffset
        reached.bitBoolean = t.tag == "boolean"
        reached.bitSigned = t.tag:sub(1, 3) == "int"
    elseif origin(t) then
        reached.nested = origin(t)
    elseif t.tag == "carray" then
        local element = need(bare(t.elem), "a fixed array has no element type")
        local width = (placed.size as integer) // (t.count as integer)
        reached.element = need(scalarKind(element, width), "a fixed array of structs or arrays is not lowered")
        reached.count = t.count
    else
        reached.kind = need(scalarKind(t, placed.size), "a struct field kind is not lowered: " .. tostring(t.tag))
    end

    return reached
end

local function integerConstant(ctx: any, node: any, value: integer): integer
    return ctx.emit(node, "K", {pool(ctx, "int64", tostring(value))}, "tagged") as integer
end

local function bits(ctx: any, node: any, operation: string, left: integer, right: integer): integer
    return ctx.emit(node, "LibCall", {corelibrary.id(operation), left, right}, "tagged") as integer
end

local function mask(width: integer): uint64
    return 0xffffffffffffffffULL >> ((64 - width) as uint64)
end

-- A view of `count` elements of `kind` from `offset` in `object`'s bytes.
local function view(ctx: any, node: any, object: integer, kind: integer, offset: integer, count: integer): integer
    local id = corelibrary.id("STORAGE_VIEW")
    local k = integerConstant(ctx, node, kind)
    local at = integerConstant(ctx, node, offset)
    local n = integerConstant(ctx, node, count)

    return ctx.emit(node, "LibCall", {id, object, k, at, n}, "tagged") as integer
end

-- The field the access `node` (obj.name) reaches, when obj is a struct.
export function access(node: any): any
    local declared = node.kind == "dotIndex" and node.name and origin(node.obj.inferredType)
    if not declared then
        return nil
    end

    return member(declared, node.name.text)
end

-- Reads field `field` of `object`: a scalar's value, or the view a nested
-- struct or fixed array is.
local function load(ctx: any, node: any, object: integer, field: any): integer
    if field.nested then
        return view(ctx, node, object, UINT8, field.offset, field.size)
    elseif field.element then
        return view(ctx, node, object, field.element, field.offset, field.count)
    end
    local cell = view(ctx, node, object, field.kind, field.offset, 1)

    local value = ctx.emit(node, "GetIdx", {cell, integerConstant(ctx, node, 0)}, "tagged") as integer
    if field.bitWidth ~= nil then
        local shifted = bits(ctx, node, "SHR", value, integerConstant(ctx, node, field.bitOffset))
        local value = bits(ctx, node, "BAND", shifted, integerConstant(ctx, node, mask(field.bitWidth) as integer))
        if field.bitBoolean then
            local equal = ctx.emit(node, "Eq", {value, integerConstant(ctx, node, 0)}, "tagged")
            return ctx.emit(node, "Not", {equal}, "tagged") as integer
        elseif field.bitSigned then
            local sign = integerConstant(ctx, node, (1ULL << ((field.bitWidth - 1) as uint64)) as integer)
            local flipped = bits(ctx, node, "BXOR", value, sign)
            return ctx.emit(node, "Sub", {flipped, sign}, "tagged") as integer
        end
        return value
    end
    if field.nullablePointer then
        local zero = integerConstant(ctx, node, 0)
        local absent = ctx.emit(node, "Eq", {value, zero}, "tagged")
        local none = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.select(node, absent, none, value)
    end

    return value
end

-- Writes `value` to field `field` of `object`: a scalar converted as C
-- converts it, a nested struct's or fixed array's bytes copied.
local function store(ctx: any, node: any, object: integer, field: any, value: integer): nil
    local held = ctx.hold(value)
    local receiver = ctx.hold(object)
    if field.nullablePointer then
        -- C stores a null address as zero, while the checked nullable field
        -- exposes nil. Keep ordinary uint64 fields numeric, including zero.
        local none = ctx.emit(node, "Nil", {}, "tagged")
        local absent = ctx.emit(node, "Eq", {ctx.readHeld(held), none}, "tagged")
        local zero = integerConstant(ctx, node, 0)
        ctx.write(held, ctx.select(node, absent, zero, ctx.readHeld(held)))
    end
    if field.bitWidth ~= nil then
        local wordMask = mask(field.bitWidth)
        if field.bitBoolean then
            local zero = integerConstant(ctx, node, 0)
            local one = integerConstant(ctx, node, 1)
            ctx.write(held, ctx.select(node, ctx.readHeld(held), one, zero))
        end
        local cell = view(ctx, node, ctx.readHeld(receiver), field.kind, field.offset, 1)
        local index = integerConstant(ctx, node, 0)
        local original = ctx.emit(node, "GetIdx", {cell, index}, "tagged")
        local clear = integerConstant(ctx, node, (~(wordMask << (field.bitOffset as uint64))) as integer)
        local unchanged = bits(ctx, node, "BAND", original, clear)
        local value = bits(ctx, node, "BAND", ctx.readHeld(held), integerConstant(ctx, node, wordMask as integer))
        local shifted = bits(ctx, node, "SHL", value, integerConstant(ctx, node, field.bitOffset))
        local merged = bits(ctx, node, "BOR", unchanged, shifted)
        ctx.emit(node, "SetIdx", {cell, index, merged}, nil)
    elseif field.nested or field.element then
        local bytes = view(ctx, node, ctx.readHeld(receiver), UINT8, field.offset, field.size)
        local size = integerConstant(ctx, node, field.size)
        ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_COPY"), bytes, ctx.readHeld(held), size}, "tagged")
    else
        local cell = view(ctx, node, ctx.readHeld(receiver), field.kind, field.offset, 1)
        ctx.emit(node, "SetIdx", {cell, integerConstant(ctx, node, 0), ctx.readHeld(held)}, nil)
    end
    ctx.release(receiver)
    ctx.release(held)
end

-- `obj.name` of a struct.
export function read(ctx: any, node: any, field: any, receiver: integer?): integer?
    local object = receiver or ctx.expression(node.obj, "tagged")
    if object == nil then
        return nil
    end

    return load(ctx, node, object, field)
end

-- Writes `value` to the struct field an assignment target names: the
-- receiver is the struct, `given.structField` the field.
export function assign(ctx: any, node: any, given: any, receiver: integer, value: integer): nil
    store(ctx, node, receiver, given.structField, value)
end

-- A struct's construction: its zeroed bytes, then each field written, in
-- the order given, from its argument or its default: `names[i]` is written
-- with `values[i]`.
export function construct(ctx: any, node: any, declared: any, names: {string}, values: {integer}): integer?
    local measured = layout(declared)
    local held = {}
    for index, value in ipairs(values) do
        held[index] = ctx.hold(value)
    end
    local size = integerConstant(ctx, node, measured.size)
    local made = ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_ALLOCBYTES"), size}, "tagged")
    local instance = ctx.hold(made)
    for index, name in ipairs(names) do
        store(ctx, node, ctx.readHeld(instance), member(declared, name), ctx.readHeld(held[index]))
        ctx.release(held[index])
    end
    local result = ctx.readHeld(instance)
    ctx.release(instance)
    need(result ~= nil, "a struct construction keeps its instance")

    return result
end

-- The struct a `carray(T, n)` allocation's first argument names, given its
-- checked type: a type object for T.
export function allocated(t: any): any
    local subject = bare(t)
    if subject and subject.tag == "typeobject" then
        return origin(subject.of)
    end

    return origin(subject)
end

-- The struct the elements of a `carray(T, n)` array are, or nil.
export function element(t: any): any
    local subject = bare(t)
    if subject and subject.tag == "carray" then
        return origin(subject.elem)
    end

    return nil
end

-- `carray(T, n)`: the zeroed bytes of `count` of struct `declared`, back to
-- back as C lays out an array of them.
export function allocate(ctx: any, node: any, declared: any, count: integer): integer
    local size = integerConstant(ctx, node, layout(declared).size)
    local bytes = ctx.emit(node, "Mul", {count, size}, "tagged")

    return ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_ALLOCBYTES"), bytes}, "tagged") as integer
end

-- Element `index` of an array of struct `declared`: a view of its bytes, a
-- reference into the array's, as an element of a C array is. An index past
-- either end is refused by the view.
export function elementAt(ctx: any, node: any, declared: any, array: integer, index: integer): integer
    local receiver = ctx.hold(array)
    local size = layout(declared).size
    local offset = ctx.emit(node, "Mul", {index, integerConstant(ctx, node, size)}, "tagged")
    local kind = integerConstant(ctx, node, UINT8)
    local n = integerConstant(ctx, node, size)
    local value = ctx.emit(
        node,
        "LibCall",
        {corelibrary.id("STORAGE_VIEW"), ctx.readHeld(receiver), kind, offset, n},
        "tagged"
    )
    ctx.release(receiver)

    return value as integer
end

-- Writes struct `value` over the element view `slot` of an array of struct
-- `declared`: its bytes copied, as C assigns one.
export function assignElement(ctx: any, node: any, declared: any, slot: integer, value: integer): nil
    local size = integerConstant(ctx, node, layout(declared).size)
    ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_COPY"), slot, value, size}, "tagged")
end

-- Full recursive C types, so libffi classifies structs from their actual
-- members. A size-only descriptor loses mixed floating/integer ABI classes.
const CODES: {
    [string]: string
} = {
    uint8 = "C",
    int8 = "c",
    uint16 = "H",
    int16 = "h",
    uint32 = "u",
    int32 = "i",
    uint64 = "L",
    int64 = "l",
    integer = "l",
    boolean = "b",
    float32 = "f",
    float64 = "d",
    number = "d"
}

local function describe(given: any, depth: integer): string
    need(depth < 64, "a foreign struct signature is too deep")
    local t = need(bare(given), "a foreign struct member has no type")
    local declared = origin(t)
    if declared then
        need(declared.cdefKind ~= "union", "a union is not passed by value")
        local measured = layout(declared)
        need(measured.alignment <= MAX_ALIGNMENT, "a struct aligned past eight bytes is not passed by value")
        for _, field in ipairs(measured.fields) do
            need(field.bitWidth == nil, "a bitfield struct is not passed by value")
        end
        local codes = {"("}
        for _, name in ipairs(declared.fieldOrder or {}) do
            codes[#codes + 1] = describe(declared.byname[name], depth + 1)
        end
        need(#codes > 1, "an empty struct is not passed by value")
        codes[#codes + 1] = ")"
        return table.concat(codes)
    elseif t.tag == "carray" then
        return string.rep(describe(t.elem, depth + 1), t.count)
    elseif pointer(t) then
        return "p"
    end

    return need(CODES[t.tag], "a foreign struct member is not a supported C type: " .. tostring(t.tag))
end

export function aggregate(t: any): string?
    if origin(t) == nil then
        return nil
    end
    return describe(t, 0)
end
