module nupp.compiler.vm.taggedstructs

-- A guest program's structs in the tagged profile. An instance is core
-- storage of its bytes in C layout (the storage library's allocbytes), so a
-- struct handed to C is the memory C reads. A scalar field is read and
-- written in place as the element of its storage kind at its offset
-- (STORAGE_LOAD and STORAGE_STORE), with no object made for it. A nested
-- struct or fixed array is a view of its bytes (STORAGE_VIEW), a reference
-- into its parent's, as the language states.
--
-- Beside the bytes, in the storage's header or the view's body, is the
-- struct's type id (gueststorage.structid), which names its declaration by
-- the checker's runtime key: an instance, an array of them and a nested
-- struct's view carry it. Where the static type is known nothing reads it;
-- `v is S` the checker could not settle, and a field Lua reads by name
-- through the metatable the struct provider declares for it, do. C and the
-- GPU are given the bytes alone.
--
-- The layout is the host project's C ABI, which libffi also uses for calls.
const taggedvalues = require("nupp.compiler.vm.taggedvalues")
const corelibrary = require("nupp.compiler.vm.corelibrary")
const layouts = require("nupp.compiler.targetlayout")
const metadata = require("nupp.compiler.vm.metadata")
const derivedmembers = require("nupp.compiler.vm.derivedmembers")
const scalarlanes = require("nupp.compiler.vm.scalarlanes")
const graphcalls = require("nupp.compiler.vm.graphcalls")
const constructors = require("nupp.compiler.constructors")
const need = taggedvalues.need
const pool = taggedvalues.pool

const LAYOUT_KEY = "\0nupp:structLayout"
-- The struct provider, whose `declare` a struct's declaration calls.
export const MODULE = "nupp.runtime.provider.corestructs"
-- The storage element kinds (corestorage): each scalar's code.
const UINT8 = 1
const KINDS: {
    [string]: integer
} = {
    uint8 = 1,
    int8 = 2,
    uint16 = 3,
    int16 = 4,
    uint32 = 5,
    int32 = 6,
    uint64 = 7,
    int64 = 8,
    float32 = 9,
    float64 = 10,
    number = 10
}
-- A pointer field holds an address, which the core keeps as an integer,
-- and stores the address of what it is given (corestorage's POINTER kind).
const POINTER_KIND = 7
const STORED_POINTER_KIND = 12
-- `integer` takes the width the layout gives it.
const INTEGER_KINDS: {[integer]: integer} = {[4] = 6, [8] = 8}
const UNSIGNED_KINDS: {[integer]: integer} = {[1] = 1, [2] = 3, [4] = 5, [8] = 7}
-- The active core has natural C layouts up to eight-byte alignment.
const MAX_ALIGNMENT = 8
-- A struct's bytes are one element of a block kind (corestorage.BLOCK plus
-- the struct's size), which an array of them holds side by side: indexing
-- one is a view of an element's bytes, and storing into one copies them.
const BLOCK = 0x40000000

-- The storage kind a whole struct of `size` bytes is an element of; an
-- empty struct is bytes, there being no block of none.
local function blockKind(size: integer): integer
    if size == 0 then
        return UINT8
    end

    return BLOCK + size
end

-- The type behind ownership and constant wrappers.
local function bare(t: any): any
    while t
        and (
            t.tag == "const"
            or t.tag == "literal"
            or t.tag == "affine"
            or t.tag == "borrowed"
            or t.tag == "pinned"
            or t.tag == "genericAlias"
        ) do
        t = t.tag == "literal" and t.base or t.tag == "genericAlias" and t.body or t.inner
    end

    return t
end

-- The struct declaration a checked type names, or nil.
export function origin(t: any): any
    local subject = bare(t)
    local declared = subject and (subject.origin or subject)
    if declared and declared.tag == "nominal" and declared.declKind == "struct" then
        return declared
    end

    return nil
end

local laid: any = setmetatable({}, {__mode = "k"})

-- The key that names struct declaration `declared` when the program runs,
-- which its type id is given by (gueststorage.structid): the checker's
-- runtime key, its module and its place there, so two declarations of one
-- layout in two modules are two types.
export function declarationkey(declared: any): string
    local subject = origin(declared) or declared
    local found = subject.runtimeDeclarationKey or subject.cdefIdentity or subject.declarationKey
    if type(found) == "string" then
        return found
    end

    return tostring(subject.moduleName) .. "\0struct\0" .. tostring(subject.runtimePath or subject.name)
end

-- `value` as a struct of the declaration `declared`: the type id beside a
-- view's bytes, or a struct's a C function returned, names it.
export function typed(ctx: any, node: any, declared: any, value: integer): integer
    local name = ctx.emit(node, "K", {pool(ctx, "str", declarationkey(declared))}, "tagged")

    return ctx.emit(node, "LibCall", {corelibrary.id("STRUCT_TYPED"), value, name}, "tagged") as integer
end

-- The struct's layout: size, alignment and each field's offset and size.
local function layout(declared: any): any
    local known = laid[declared]
    if known == nil then
        local target: string = need(layouts.hostKey(), "the core host's C layout is unavailable")
        local measured, reason = layouts.of(declared, target)
        known = need(measured, "a struct has no C layout: " .. tostring(reason))
        laid[declared] = known
    end

    return known
end

-- A type object keeps one descriptor, shared by all queries that name it.
export function attachLayout(ctx: any, declaration: any, class: any): nil
    local descriptor = metadata.structLayout(declaration, layouts.hostKey())
    local facts = ctx.hold(derivedmembers.plainData(ctx, declaration, descriptor))
    local key = ctx.emit(declaration, "K", {pool(ctx, "str", LAYOUT_KEY)}, "tagged")
    ctx.emit(declaration, "SetIdx", {ctx.readHeld(class), key, ctx.readHeld(facts)}, nil)
    ctx.release(facts)
end

export function queryLayout(ctx: any, node: any): integer?
    local subject = node.args.exprs[1]
    local witness = ctx.expression(subject, "tagged")
    if witness == nil then
        return nil
    end
    local key = ctx.emit(node, "K", {pool(ctx, "str", LAYOUT_KEY)}, "tagged")
    local facts = ctx.hold(ctx.emit(node, "GetIdx", {witness, key}, "tagged"))
    local supported = ctx.emit(node, "K", {pool(ctx, "str", "supported")}, "tagged")
    local present = ctx.emit(node, "GetIdx", {ctx.readHeld(facts), supported}, "tagged")
    local unsupported = ctx.emit(node, "Not", {present}, "tagged")
    ctx.when(node, unsupported, function(c: any): nil
        local key = c.emit(node, "K", {pool(c, "str", "error")}, "tagged")
        local message = c.emit(node, "GetIdx", {c.readHeld(facts), key}, "tagged")
        taggedvalues.landed(c, node, c.emit(node, "LibCall", {corelibrary.id("ERROR"), message}, "tagged"))
    end)
    local value = ctx.readHeld(facts)
    ctx.release(facts)

    return value
end

-- A pointer the core passes as its address: any C pointer, nullable or not.
local function pointer(t: any): boolean
    if t.tag == "union" and t.hasNil and #(t.members or {}) == 2 then
        local other = t.members[1].tag == "nil" and t.members[2] or t.members[1]
        return other ~= nil and pointer(other)
    end

    return t.tag == "ptr" or t.tag == "cstring" or t.tag == "voidptr" or t.tag == "func" and t.foreign == true
end

-- The struct a pointer type points at, nullable or not, or nil.
local function pointee(t: any): any
    local subject = bare(t)
    if subject and subject.tag == "union" and subject.hasNil and #(subject.members or {}) == 2 then
        subject = bare(subject.members[1].tag == "nil" and subject.members[2] or subject.members[1])
    end
    if subject and subject.tag == "ptr" then
        return origin(subject.elem)
    end

    return nil
end

-- The storage kind of a scalar or pointer of `size` bytes, or nil.
local function scalarKind(t: any, size: integer): integer?
    if pointer(t) then
        return POINTER_KIND
    elseif t.tag == "integer" then
        return INTEGER_KINDS[size]
    end

    return KINDS[t.tag]
end

-- A stored fixed-width vector, `simd.Vector<E, simd.Fixed<N>>`: what the
-- lane runtime calls its element, the storage kind of E, and N. A field of
-- one holds N elements of E, as the C array it lowers to.
local function fixedVector(t: any): any
    local element, count = layouts.storageVector(t)
    if element == nil or count == nil then
        return nil
    end
    local _, laneElement = scalarlanes.family(t)
    local kind = element == "integer" and INTEGER_KINDS[8] or KINDS[element as string]
    need(kind ~= nil and laneElement ~= nil, "a fixed vector field's element is not lowered: " .. tostring(element))

    return {element = laneElement, kind = kind, count = count}
end

-- How field `name` of a struct is reached: its offset and bytes, and the
-- storage kind of a scalar one, or the element kind and count of a fixed
-- array of scalars, or the struct a nested one is.
local function member(declared: any, name: string): any
    local measured = layout(declared)
    local placed = nil
    for _, field in ipairs(measured.fields) do
        if field.name == name then
            placed = field
        end
    end
    need(placed, "a struct field is not declared: " .. name)
    local t = need(bare(declared.byname[name]), "a struct field has no type")
    local reached: any = {offset = placed.offset, size = placed.size}
    reached.boolean = t.tag == "boolean"
    reached.pointer = pointer(t)
    reached.nullablePointer = t.tag == "union" and t.hasNil and reached.pointer
    reached.pointee = reached.pointer and pointee(t) or nil
    if placed.bitWidth ~= nil then
        reached.kind = need(UNSIGNED_KINDS[placed.size], "a bitfield has no storage kind")
        reached.bitWidth, reached.bitOffset = placed.bitWidth, placed.bitOffset
        reached.bitSigned = t.tag:sub(1, 3) == "int"
    elseif origin(t) then
        reached.nested = origin(t)
    elseif fixedVector(t) then
        reached.vector = fixedVector(t)
    elseif t.tag == "carray" then
        local element = need(bare(t.elem), "a fixed array has no element type")
        local width = (placed.size as integer) // (t.count as integer)
        reached.element = need(scalarKind(element, width), "a fixed array of structs or arrays is not lowered")
        reached.count = t.count
    else
        reached.kind = reached.boolean and UINT8
            or need(scalarKind(t, placed.size), "a struct field kind is not lowered: " .. tostring(t.tag))
    end

    return reached
end

local function integerConstant(ctx: any, node: any, value: integer): integer
    return ctx.emit(node, "K", {pool(ctx, "int64", tostring(value))}, "tagged") as integer
end

local function bits(ctx: any, node: any, operation: string, left: integer, right: integer): integer
    return ctx.emit(node, "LibCall", {corelibrary.id(operation), left, right}, "tagged") as integer
end

local function mask(width: integer): uint64
    return 0xffffffffffffffffULL >> ((64 - width) as uint64)
end

-- A view of `count` elements of `kind` from `offset` in `object`'s bytes.
local function view(ctx: any, node: any, object: integer, kind: integer, offset: integer, count: integer): integer
    local id = corelibrary.id("STORAGE_VIEW")
    local k = integerConstant(ctx, node, kind)
    local at = integerConstant(ctx, node, offset)
    local n = integerConstant(ctx, node, count)

    return ctx.emit(node, "LibCall", {id, object, k, at, n}, "tagged") as integer
end

-- The struct `declared` at the address `address` holds, a view owning
-- nothing, or nil for the null address.
local function structAt(ctx: any, node: any, declared: any, address: integer): integer
    local size = layout(declared).size
    local kind = integerConstant(ctx, node, blockKind(size))
    local count = integerConstant(ctx, node, size == 0 and 0 or 1)
    local name = ctx.emit(node, "K", {pool(ctx, "str", declarationkey(declared))}, "tagged")

    return ctx.emit(node, "LibCall", {corelibrary.id("STRUCT_AT"), address, kind, count, name}, "tagged") as integer
end

-- The element of `kind` at byte `offset` of `object`, read in place.
local function fetch(ctx: any, node: any, object: integer, kind: integer, offset: integer): integer
    local id = corelibrary.id("STORAGE_LOAD")
    local k = integerConstant(ctx, node, kind)
    local at = integerConstant(ctx, node, offset)

    return ctx.emit(node, "LibCall", {id, object, k, at}, "tagged") as integer
end

-- Writes `value` as the element of `kind` at byte `offset` of `object`.
local function put(ctx: any, node: any, object: integer, kind: integer, offset: integer, value: integer): nil
    local id = corelibrary.id("STORAGE_STORE")
    local k = integerConstant(ctx, node, kind)
    local at = integerConstant(ctx, node, offset)
    ctx.emit(node, "LibCall", {id, object, k, at, value}, "tagged")
end

local function present(t: any, optional: boolean): any
    local subject = bare(t)
    if optional and subject and subject.tag == "union" and subject.hasNil and #subject.members == 2 then
        return subject.members[1].tag == "nil" and subject.members[2] or subject.members[1]
    end

    return subject
end

-- The field the access `node` reaches when its receiver is a struct, or a
-- pointer to one, which reads as the struct it points at (STRUCT_AT).
export function access(node: any): any
    local subject = (node.kind == "dotIndex" or node.kind == "safeIndex")
        and node.name
        and present(node.obj.inferredType, node.kind == "safeIndex")
    local declared = subject and (origin(subject) or pointee(subject))
    if not declared then
        return nil
    end

    return member(declared, node.name.text)
end

-- The lane runtime's `simd.lane[member]` called with a fixed vector field's
-- element and lane count ahead of `extra`, at the callsite programgraph
-- issued for it at `node` under `key` (vectorSites).
local function laneStorage(ctx: any, node: any, key: string, member: string, vector: any, extra: {integer}): integer?
    local sites = taggedvalues.catalog(ctx).laneStorage[node]
    local site = need(sites and sites[key], "a fixed vector field lacks its lane runtime callsite")
    need(site.owner == ctx.fn.id, "a fixed vector field's callsite belongs to another owner")
    local held: {any} = {}
    for index, value in ipairs(extra) do
        held[index] = ctx.hold(value)
    end
    local name = ctx.emit(node, "K", {pool(ctx, "str", scalarlanes.MODULE)}, "tagged")
    local module = ctx.emit(node, "LibCall", {corelibrary.id("MODULE_REQUIRE"), name}, "tagged")
    local runtimeKey = ctx.emit(node, "K", {pool(ctx, "str", scalarlanes.RUNTIME)}, "tagged")
    local runtime = ctx.emit(node, "GetIdx", {module, runtimeKey}, "tagged")
    local memberKey = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
    local callee = ctx.hold(ctx.emit(node, "GetIdx", {runtime, memberKey}, "tagged"))
    local args: {
        integer
    } = {
        ctx.emit(node, "K", {pool(ctx, "str", vector.element)}, "tagged") as integer,
        integerConstant(ctx, node, vector.count)
    }
    for _, handle in ipairs(held) do
        args[#args + 1] = ctx.readHeld(handle)
    end
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    for index = #held, 1, -1 do
        ctx.release(held[index])
    end
    local keep = member == "fromstorage"
    local answer = ctx.invoke(node, value, args, graphcalls.dynamicInvokeContract(site.node, 1), keep)
    if not keep then
        return answer
    end

    return taggedvalues.landed(ctx, node, answer)
end

-- The lane runtime callsites a struct field access or construction `node`
-- needs, by key, each with its argument count: a fixed vector field read
-- ("read") and written ("write"), and each fixed vector field a
-- construction may write ("write:" and the field's name).
export function vectorSites(node: any): {[string]: integer}?
    local found: {[string]: integer} = {}
    local needed = false
    local field = (node.kind == "dotIndex" or node.kind == "safeIndex") and access(node)
    if field and field.vector then
        found.read, found.write, needed = 3, 4, true
    end
    local declared = node.kind == "newExpr" and origin(node.inferredType)
    if declared then
        for _, name in ipairs(declared.fieldOrder or {}) do
            if fixedVector(bare(declared.byname[name])) then
                found["write:" .. name], needed = 4, true
            end
        end
    end

    return needed and found or nil
end

-- Reads field `field` of `object`: a scalar's value, the view a nested
-- struct or fixed array is, or the lanes a fixed vector holds.
local function load(ctx: any, node: any, object: integer, field: any): integer
    if field.vector then
        local cells = view(ctx, node, object, field.vector.kind, field.offset, field.vector.count)
        return laneStorage(ctx, node, "read", "fromstorage", field.vector, {cells}) as integer
    elseif field.nested then
        local count = field.size == 0 and 0 or 1
        return typed(ctx, node, field.nested, view(ctx, node, object, blockKind(field.size), field.offset, count))
    elseif field.element then
        return view(ctx, node, object, field.element, field.offset, field.count)
    end
    local value = fetch(ctx, node, object, field.kind, field.offset)
    if field.bitWidth ~= nil then
        local shifted = bits(ctx, node, "SHR", value, integerConstant(ctx, node, field.bitOffset))
        value = bits(ctx, node, "BAND", shifted, integerConstant(ctx, node, mask(field.bitWidth) as integer))
        if field.bitSigned then
            local sign = integerConstant(ctx, node, (1ULL << ((field.bitWidth - 1) as uint64)) as integer)
            local flipped = bits(ctx, node, "BXOR", value, sign)
            return ctx.emit(node, "Sub", {flipped, sign}, "tagged") as integer
        end
    end
    if field.boolean then
        local zero = ctx.emit(node, "Eq", {value, integerConstant(ctx, node, 0)}, "tagged")
        return ctx.emit(node, "Not", {zero}, "tagged") as integer
    elseif field.pointee then
        -- A pointer to a struct reads as the struct it points at, as C
        -- dereferences one; the null pointer reads as nil.
        return structAt(ctx, node, field.pointee, value)
    elseif field.nullablePointer then
        local zero = integerConstant(ctx, node, 0)
        local absent = ctx.emit(node, "Eq", {value, zero}, "tagged")
        local none = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.select(node, absent, none, value)
    end

    return value
end

-- Writes `value` to field `field` of `object`: a scalar converted as C
-- converts it, a nested struct's or fixed array's bytes copied.
local function store(ctx: any, node: any, object: integer, field: any, value: integer, key: string): nil
    local held = ctx.hold(value)
    local receiver = ctx.hold(object)
    if field.boolean then
        local zero = integerConstant(ctx, node, 0)
        local one = integerConstant(ctx, node, 1)
        ctx.write(held, ctx.select(node, ctx.readHeld(held), one, zero))
    end
    if field.bitWidth ~= nil then
        local wordMask = mask(field.bitWidth)
        local original = fetch(ctx, node, ctx.readHeld(receiver), field.kind, field.offset)
        local clear = integerConstant(ctx, node, (~(wordMask << (field.bitOffset as uint64))) as integer)
        local unchanged = bits(ctx, node, "BAND", original, clear)
        local value = bits(ctx, node, "BAND", ctx.readHeld(held), integerConstant(ctx, node, wordMask as integer))
        local shifted = bits(ctx, node, "SHL", value, integerConstant(ctx, node, field.bitOffset))
        local merged = bits(ctx, node, "BOR", unchanged, shifted)
        put(ctx, node, ctx.readHeld(receiver), field.kind, field.offset, merged)
    elseif field.vector then
        local vector = field.vector
        local cells = view(ctx, node, ctx.readHeld(receiver), vector.kind, field.offset, vector.count)
        laneStorage(ctx, node, key, "intostorage", vector, {cells, ctx.readHeld(held)})
    elseif field.nested or field.element then
        local bytes = view(ctx, node, ctx.readHeld(receiver), UINT8, field.offset, field.size)
        local size = integerConstant(ctx, node, field.size)
        ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_COPY"), bytes, ctx.readHeld(held), size}, "tagged")
    else
        local kind = field.pointer and STORED_POINTER_KIND or field.kind
        put(ctx, node, ctx.readHeld(receiver), kind, field.offset, ctx.readHeld(held))
    end
    ctx.release(receiver)
    ctx.release(held)
end

-- `obj.name` of a struct.
export function read(ctx: any, node: any, field: any, receiver: integer?): integer?
    local object = receiver or ctx.expression(node.obj, "tagged")
    if object == nil then
        return nil
    end

    return load(ctx, node, object, field)
end

-- Writes `value` to the struct field an assignment target names: the
-- receiver is the struct, `given.structField` the field.
export function assign(ctx: any, node: any, given: any, receiver: integer, value: integer): nil
    store(ctx, node, receiver, given.structField, value, "write")
end

-- The zeroed storage of `count` structs `declared`, each an element: a
-- block of its bytes, which an empty struct has none of. The type id beside
-- them names the declaration.
local function allocation(ctx: any, node: any, declared: any, count: integer): integer
    local size = layout(declared).size
    local kind = integerConstant(ctx, node, blockKind(size))
    if size == 0 then
        count = integerConstant(ctx, node, 0)
    end
    local name = ctx.emit(node, "K", {pool(ctx, "str", declarationkey(declared))}, "tagged")

    return ctx.emit(node, "LibCall", {corelibrary.id("STRUCT_NEW"), kind, count, name}, "tagged") as integer
end

-- A struct's construction: its zeroed bytes, then each field written, in
-- the order given, from its argument or its default: `names[i]` is written
-- with `values[i]`.
export function construct(ctx: any, node: any, declared: any, names: {string}, values: {integer}): integer?
    local held = {}
    for index, value in ipairs(values) do
        held[index] = ctx.hold(value)
    end
    local made = allocation(ctx, node, declared, integerConstant(ctx, node, 1))
    local instance = ctx.hold(made)
    for index, name in ipairs(names) do
        store(ctx, node, ctx.readHeld(instance), member(declared, name), ctx.readHeld(held[index]), "write:" .. name)
        ctx.release(held[index])
    end
    local result = ctx.readHeld(instance)
    ctx.release(instance)
    need(result ~= nil, "a struct construction keeps its instance")

    return result
end

-- The struct a `carray(T, n)` allocation's first argument names, given its
-- checked type: a type object for T.
export function allocated(t: any): any
    local subject = bare(t)
    if subject and subject.tag == "typeobject" then
        return origin(subject.of)
    end

    return origin(subject)
end

-- The struct the elements of a `carray(T, n)` array are, or nil.
export function element(t: any, optional: boolean?): any
    local subject = present(t, optional == true)
    if subject and subject.tag == "carray" then
        return origin(subject.elem)
    end

    return nil
end

-- `carray(T, n)`: the zeroed bytes of `count` of struct `declared`, back to
-- back as C lays out an array of them.
export function allocate(ctx: any, node: any, declared: any, count: integer): integer
    return allocation(ctx, node, declared, count)
end

-- `value is S` for struct `declared`, when the checker could not settle it
-- from the value's static type: whether the type id beside its bytes names
-- that declaration.
export function test(ctx: any, node: any, declared: any, value: integer): integer
    local held = ctx.hold(value)
    local name = ctx.emit(node, "K", {pool(ctx, "str", declarationkey(declared))}, "tagged")
    local answer = ctx.emit(node, "LibCall", {corelibrary.id("STRUCT_IS"), ctx.readHeld(held), name}, "tagged")
    ctx.release(held)

    return answer as integer
end

-- Element `index` of an array of struct `declared`: a view of its bytes, a
-- reference into the array's, as an element of a C array is. An index past
-- either end is refused by the view.
export function elementAt(ctx: any, node: any, declared: any, array: integer, index: integer): integer
    local receiver = ctx.hold(array)
    local size = layout(declared).size
    local offset = ctx.emit(node, "Mul", {index, integerConstant(ctx, node, size)}, "tagged")
    local kind = integerConstant(ctx, node, blockKind(size))
    local n = integerConstant(ctx, node, size == 0 and 0 or 1)
    local value = ctx.emit(
        node,
        "LibCall",
        {corelibrary.id("STORAGE_VIEW"), ctx.readHeld(receiver), kind, offset, n},
        "tagged"
    )
    ctx.release(receiver)

    return value as integer
end

-- Writes struct `value` over the element view `slot` of an array of struct
-- `declared`: its bytes copied, as C assigns one.
export function assignElement(ctx: any, node: any, declared: any, slot: integer, value: integer): nil
    local size = integerConstant(ctx, node, layout(declared).size)
    ctx.emit(node, "LibCall", {corelibrary.id("STORAGE_COPY"), slot, value, size}, "tagged")
end

-- Full recursive C types, so libffi classifies structs from their actual
-- members. A size-only descriptor loses mixed floating/integer ABI classes.
const CODES: {
    [string]: string
} = {
    uint8 = "C",
    int8 = "c",
    uint16 = "H",
    int16 = "h",
    uint32 = "u",
    int32 = "i",
    uint64 = "L",
    int64 = "l",
    integer = "l",
    boolean = "b",
    float32 = "f",
    float64 = "d",
    number = "d"
}

local function describe(given: any, depth: integer): string
    need(depth < 64, "a foreign struct signature is too deep")
    local t = need(bare(given), "a foreign struct member has no type")
    local declared = origin(t)
    if declared then
        need(declared.cdefKind ~= "union", "a union is not passed by value")
        local measured = layout(declared)
        need(measured.alignment <= MAX_ALIGNMENT, "a struct aligned past eight bytes is not passed by value")
        for _, field in ipairs(measured.fields) do
            need(field.bitWidth == nil, "a bitfield struct is not passed by value")
        end
        local codes = {"("}
        for _, name in ipairs(declared.fieldOrder or {}) do
            codes[#codes + 1] = describe(declared.byname[name], depth + 1)
        end
        need(#codes > 1, "an empty struct is not passed by value")
        codes[#codes + 1] = ")"
        return table.concat(codes)
    elseif t.tag == "carray" then
        return string.rep(describe(t.elem, depth + 1), t.count)
    elseif pointer(t) then
        return "p"
    end

    return need(CODES[t.tag], "a foreign struct member is not a supported C type: " .. tostring(t.tag))
end

export function aggregate(t: any): string?
    if origin(t) == nil then
        return nil
    end
    return describe(t, 0)
end

-- Whether `node` declares a struct, whose table the struct provider is
-- given where the declaration runs (`declare`).
export function declaration(node: any): boolean
    return type(node) == "table"
        and node.kind == "recordDecl"
        and node.declKind == "struct"
        and not node.isAnnotationDefinition
end

-- What the struct provider reads of the struct `stat` declares, to build
-- one from Lua: its key, each stored field in order with its default, and
-- each constructor's arity.
local function described(stat: any): any
    local nominal = need(stat.resolvedType, "a struct declaration lacks its checked type")
    local spec: any = {key = declarationkey(nominal), fields = {}, defaulted = {}, defaults = {}, constructors = {}}
    for position, field in ipairs(nominal.fieldOrder or {}) do
        local declared = nominal.byname and nominal.byname[field]
        if not (declared and (declared.tag == "func" or declared.tag == "typeobject")) then
            derivedmembers.appendField(spec, field, position, nominal.fieldDefaults and nominal.fieldDefaults[field])
        end
    end
    for index, entry in ipairs(constructors.plan(nominal)) do
        spec.constructors[index] = {min = entry.min, max = entry.max}
    end

    return spec
end

-- Gives struct table `class`, the declaration `stat` made, to the struct
-- provider's `declare`, at the callsite programgraph issued for it, when
-- the program carries the provider: a table Lua calls to build one, and
-- whose instances' fields Lua reads and writes by name through the type id
-- beside their bytes. Answers false once the program stopped.
export function declare(ctx: any, stat: any, class: any): boolean
    local site = taggedvalues.catalog(ctx).structDeclares[stat]
    if site == nil then
        return true
    end
    need(site.owner == ctx.fn.id, "a struct declaration's callsite belongs to another owner")
    local spec = ctx.hold(derivedmembers.plainData(ctx, stat, described(stat)))
    local name = ctx.emit(stat, "K", {pool(ctx, "str", MODULE)}, "tagged")
    local module = ctx.emit(stat, "LibCall", {corelibrary.id("MODULE_REQUIRE"), name}, "tagged")
    local member = ctx.emit(stat, "K", {pool(ctx, "str", "declare")}, "tagged")
    local callee = ctx.hold(ctx.emit(stat, "GetIdx", {module, member}, "tagged"))
    local args: {integer} = {ctx.readHeld(class) as integer, ctx.readHeld(spec) as integer}
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    ctx.release(spec)
    ctx.invoke(stat, value, args, graphcalls.dynamicInvokeContract(site.node, 1), false)

    return ctx.block ~= nil
end
