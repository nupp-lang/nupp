module nupp.compiler.vm.coregraphverify

local graph = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")
local schema = require("nupp.compiler.vm.coregraphschema")
local budget = require("nupp.compiler.vm.coregraphbudget")
local bounds = schema.limits()
-- A checked graph's values before the executable assigns registers, more
-- than a raw image's (schema `values`): a block passes every live binding as
-- a parameter, so a long chunk's top level holds many.
const GRAPH_VALUES = 1048576

local function need(ok: any, message: string): any
    -- The message is built only for a failure: checks run millions of times.
    if not ok then
        error("core graph contracts: " .. message, 0)
    end
    return ok
end

local function plain(value: any): nil
    need(type(value) == "table" and getmetatable(value) == nil, "plain semantic table required")
end

local function fields(value: any, allowed: string): nil
    plain(value)
    for key in pairs(value) do
        need(
            type(key) == "string"
            and key:match("^[A-Za-z_][A-Za-z0-9_]*$")
            and (" " .. allowed .. " "):find(" " .. key .. " ", 1, true),
            "unknown semantic field " .. tostring(key)
        )
    end
end

local function integer(value: any, maximum: integer): integer
    if not (type(value) == "number" and value >= 0 and value <= maximum and value % 1 == 0) then
        need(false, "invalid bounded integer " .. tostring(value) .. " (at most " .. tostring(maximum) .. ")")
    end
    return value as integer
end

local function dense(value: any, maximum: integer): integer
    plain(value)
    local length = integer(#value, maximum)
    local count = 0
    for key in pairs(value) do
        need(type(key) == "number" and key >= 1 and key <= length and key % 1 == 0, "sparse semantic array")
        count += 1
    end
    need(count == length, "sparse semantic array")

    return length
end

local function words(value: any): any
    local result = {}
    for index = 1, dense(value, 1048576) do
        result[index] = integer(value[index], 4294967295)
    end

    return result
end

local function text(value: any): string
    need(type(value) == "string" and #value <= 1048576, "bounded source text required")
    return value
end

-- A checked graph spells integer constants as source text; the semantic copy
-- holds their eight two's-complement bytes. `fromSource` selects the input form.
export function copyGraph(g: any, version: integer?, fromSource: boolean?): any
    local numeric, integers = (version or 2) >= 3, (version or 2) >= 6
    fields(g, "nparams blocks types slots counts constants positions certificates name module path programOwner source")
    local copy: any = {
        nparams = integer(g.nparams, 239),
        programOwner = integer(g.programOwner, bounds.owners - 1),
        name = text(g.name),
        module = text(g.module),
        path = text(g.path),
        blocks = {},
        types = {},
        slots = words(g.slots),
        counts = {},
        constants = {},
        positions = {},
        certificates = {}
    }
    if g.source ~= nil then
        fields(g.source, "name module path")
        copy.source = {name = text(g.source.name), module = text(g.source.module), path = text(g.source.path)}
        need(
            copy.source.name == copy.name and copy.source.module == copy.module and copy.source.path == copy.path,
            "graph source binding differs"
        )
    end
    fields(g.counts, "v i f x")
    for _, class in ipairs({"v", "i", "f", "x"}) do
        copy.counts[class] = integer(g.counts[class], GRAPH_VALUES)
        need(class == "v" or copy.counts[class] == 0, "only tagged values are admitted")
    end
    need(dense(g.types, GRAPH_VALUES) == #copy.slots, "value columns differ")
    for index, class in ipairs(g.types) do
        need(class == "v", "only tagged values are admitted")
        copy.types[index] = class
    end
    need(dense(g.certificates, 1048576) == 0, "certificates are unsupported")
    for index = 1, dense(g.constants, 65536) do
        local constant = g.constants[index]
        fields(constant, "kind value")
        local value = constant.value
        -- From v8 a uint64 literal is the integer of the same 64 bits, as
        -- the VM holds it: `18446744073709551615ULL` is -1.
        local kind = constant.kind
        if kind == "uint64" and integers and fromSource and (version or 2) >= 8 then
            kind = "int64"
        end
        if kind == "int64" and integers and fromSource then
            need(
                type(value) == "string" and (value:match("^%-?%d+$") or value:match("^%-?0[xX]%x+$")),
                "invalid integer constant text"
            )
            local ok, bytes = pcall(graphimage.wideTextBytes, value)
            need(ok, "integer constant exceeds the immediate range")
            value = bytes
        end
        need(
            constant.kind == "true"
            or constant.kind == "false"
            or constant.kind == "nil"
            or constant.kind == "str"
            or numeric and constant.kind == "num"
            or integers and kind == "int64",
            "unsupported scalar constant"
        )
        need(
            constant.kind == "str"
            and type(value) == "string"
            and #value <= ((version or 2) >= 8 and 65536 or 256)
            and (#value > 0 or (version or 2) >= 8)
            or (constant.kind == "num" or kind == "int64") and type(value) == "string" and #value == 8
            or constant.kind ~= "str" and constant.kind ~= "num" and kind ~= "int64" and value == "",
            "invalid scalar constant payload"
        )
        if constant.kind == "num" then
            local low, high = value:byte(7, 8)
            local top = low + high * 256
            need(
                (top & 0x7ff8) ~= 0x7ff8 or value == string.rep(string.char(0), 6) .. string.char(0xf8, 0x7f),
                "noncanonical numeric NaN"
            )
        elseif constant.kind == "int64" and (version or 2) < 8 then
            -- Before v8 only the signed 48-bit immediate payload is executable;
            -- v8 boxes wider constants when K loads them.
            local sign, low, high = value:byte(6, 8)
            need(
                low == 0 and high == 0 and sign < 0x80 or low == 0xff and high == 0xff and sign >= 0x80,
                "integer constant exceeds the immediate range"
            )
        end
        copy.constants[index] = {kind = kind, value = value}
    end
    for index = 1, dense(g.positions, 1048576) do
        local position = g.positions[index]
        fields(position, "line column source")
        local copied: any = {line = integer(position.line, 4294967295), column = integer(position.column, 4294967295)}
        if position.source ~= nil then
            fields(position.source, "moduleName path")
            copied.source = {moduleName = text(position.source.moduleName), path = text(position.source.path)}
        end
        copy.positions[index] = copied
        need(position.line > 0 and position.column > 0, "source positions are one-based")
    end
    for index = 1, dense(g.blocks, 4096) do
        local block = g.blocks[index]
        fields(block, "id params op dst args pos cert term")
        local b: any = {
            id = integer(block.id, 4096),
            params = words(block.params),
            op = {},
            dst = words(block.dst),
            args = {},
            pos = words(block.pos),
            cert = words(block.cert)
        }
        need(b.id == index, "block order differs")
        local count = dense(block.op, 1048576)
        need(
            count == dense(block.args, 1048576) and count == #b.dst and count == #b.pos and count == #b.cert,
            "operation columns differ"
        )
        for at = 1, count do
            b.op[at], b.args[at] = text(block.op[at]), words(block.args[at])
            need(b.cert[at] == 0 and b.pos[at] <= #copy.positions, "unsupported operation certificate/position")
        end
        local term = block.term
        plain(term)
        local kind = term.kind
        if kind == "invoke" then
            fields(term, "kind callee args contract result results spread open edges pos")
        elseif kind == "return" then
            fields(term, "kind value values spread edges pos")
        elseif kind == "branch" then
            fields(term, "kind value edges pos")
        else
            need(kind == "jump", "unsupported terminator")
            fields(term, "kind edges pos")
        end
        local t: any = {kind = kind, edges = {}}
        for _, key in ipairs({"value", "callee", "result", "spread", "pos"}) do
            if term[key] ~= nil then
                t[key] = integer(term[key], 4294967295)
            end
        end
        if t.pos ~= nil then
            need(t.pos <= #copy.positions, "invalid terminator position")
        end
        if kind == "invoke" then
            t.args = words(term.args)
            if term.results ~= nil then
                t.results = words(term.results)
                need(#t.results >= 1 and #t.results <= 16 and t.results[1] == t.result, "invoke results")
            end
            -- An open call keeps every result as one pack.
            if term.open ~= nil then
                need(term.open == true and term.results == nil and term.result ~= nil, "open invoke keeps one pack")
                t.open = true
            end
            -- The checked contract is authenticated separately and replaced by
            -- a semantic contract ID. It is never copied into persistent data.
        end
        if kind == "return" and term.values ~= nil then
            t.values = words(term.values)
            need(
                #t.values <= 16
                and (#t.values == 0 and (version or 2) >= 8 or #t.values >= 1 and t.values[1] == t.value),
                "return values"
            )
        end
        for edgeIndex = 1, dense(term.edges, 2) do
            local edge = term.edges[edgeIndex]
            fields(edge, "target args")
            t.edges[edgeIndex] = {target = integer(edge.target, 4096), args = words(edge.args)}
        end
        b.term, copy.blocks[index] = t, b
    end

    return copy
end

export function topological(nodes: any, edges: any, entry: integer?): any
    local incoming, ready, result = {}, {}, {}
    for index = 1, #nodes do
        incoming[index] = 0
    end
    for _, targets in ipairs(edges) do
        for _, target in ipairs(targets) do
            need(incoming[target] ~= nil, "invalid graph dependency")
            incoming[target] += 1
        end
    end
    if entry ~= nil then
        need(incoming[entry] == 0, "entry has an incoming edge")
        ready[1] = entry
    else
        for index = 1, #nodes do
            if incoming[index] == 0 then
                ready[#ready + 1] = index
            end
        end
    end
    local at = 1
    while at <= #ready do
        local index = ready[at]
        at += 1
        result[#result + 1] = index
        for _, target in ipairs(edges[index]) do
            incoming[target] -= 1
            if incoming[target] == 0 then
                ready[#ready + 1] = target
            end
        end
    end
    need(#result == #nodes, "cyclic or unreachable graph is unsupported")

    return result
end

-- This transient classification derives scalar kinds by a monotone SSA
-- worklist. A block parameter receives its kind from every incoming edge,
-- including loop back edges. It is not runtime handle/tag authentication.
-- function:<owner> identifies a possible code target, never a closure instance.
export function resultKind(g: any, signature: any, output: any): string
    local kinds, edges, users, pending = {}, {}, {}, {}
    -- v8 values may be dynamic: a join of different kinds widens to "value",
    -- and every scalar use of a value is checked by its handler at run time.
    local dynamic = output.schema.version >= 8

    local function fits(actual: string?, wanted: string?): boolean
        return actual == wanted or dynamic and (actual == "value" or wanted == "value")
    end

    local function assign(id: integer, kind: string): nil
        if kinds[id] ~= nil and kinds[id] ~= kind and dynamic then
            if kinds[id] ~= "value" then
                kinds[id] = "value"
                pending[#pending + 1] = id
            end
            return
        end
        need(kinds[id] == nil or kinds[id] == kind, "incompatible scalar join")
        if kinds[id] == nil then
            kinds[id] = kind
            pending[#pending + 1] = id
        end
    end

    local function apply(rule: any): nil
        local first = kinds[rule.args[1]]
        if first == nil then
            return
        end
        if rule.op == "Move" then
            assign(rule.dst, first)
            return
        end
        if rule.op == "edge" then
            assign(rule.dst, first)
            return
        end
        local second = kinds[rule.args[2]]
        if second == nil then
            return
        end
        if rule.op == "Eq" then
            assign(rule.dst, "boolean")
            return
        end
        -- A v8 operand's kind may still widen to a value as the worklist
        -- runs (a nil before a loop assigns it a number), and its handler
        -- checks it when it runs, as Lua does: only earlier profiles refuse.
        if not dynamic and not (fits(first, "number") and fits(second, "number")) then
            local at = rule.pos and g.positions[rule.pos]
            need(
                false,
                "numeric operation needs numeric operands: " .. rule.op .. " of " .. tostring(
                    first
                ) .. " and " .. tostring(
                    second
                ) .. " at " .. tostring(g.path) .. ":" .. tostring(at and at.line) .. ":" .. tostring(at and at.column)
            )
        end
        assign(rule.dst, (rule.op == "Lt" or rule.op == "Le") and "boolean" or "number")
    end

    local function propagate(op: string, args: any, dst: integer, pos: integer?): nil
        local rule = {op = op, args = args, dst = dst, pos = pos}
        for _, id in ipairs(args) do
            if users[id] == nil then
                users[id] = {}
            end
            users[id][#users[id] + 1] = rule
        end
        apply(rule)
    end

    for index, kind in ipairs(signature.params) do
        assign(index, kind)
    end
    for index, block in ipairs(g.blocks) do
        edges[index] = {}
        for at, edge in ipairs(block.term.edges) do
            edges[index][at] = edge.target
        end
        for at, op in ipairs(block.op) do
            local args = block.args[at]
            local dst = block.dst[at]
            local _ = switch op do
                case "K" -> do
                    local constant = need(g.constants[args[1] + 1], "constant index differs")
                    need(constant.kind ~= "str" or dynamic, "module name cannot be loaded as a value")
                    assign(
                        dst,
                        constant.kind == "str" and "value"
                        or constant.kind == "nil" and "nil"
                        or (constant.kind == "num" or constant.kind == "int64" or constant.kind == "uint64")
                        and "number"
                        or "boolean"
                    )
                    yield nil
                end
                case "Require" -> do
                    local constant = need(g.constants[args[1] + 1], "require name index differs")
                    need(constant.kind == "str", "require needs a static module name")
                    local target
                    for _, module in ipairs(output.modules) do
                        if module.name == constant.value then
                            target = module.chunk
                        end
                    end
                    need(
                        target ~= nil and (target < g.programOwner or output.schema.version >= 8),
                        "forward or cyclic require is unsupported"
                    )
                    local owner = need(output.catalog[target + 1], "required module owner is missing")
                    if owner.signature == nil and dynamic then
                        -- A module not verified yet, a partner in a cycle:
                        -- its value is whatever it answers.
                        assign(dst, "value")
                    else
                        local result = need(
                            output.signatures[owner.signature + 1],
                            "required module signature is missing"
                        )
                        assign(dst, result.result)
                    end
                    yield nil
                end
                case "Add", "Sub", "Mul", "Mod", "Lt", "Le", "Eq", "Move" -> do
                    propagate(op, args, dst, block.pos[at])
                    yield nil
                end
                case "Nil" -> do
                    assign(dst, "nil")
                    yield nil
                end
                case "Closure" -> do
                    need(#args == 1 or output.schema.version >= 7, "only zero-capture closures are admitted")
                    local target = need(output.catalog[args[1] + 1], "closure owner is missing")
                    need(target.kind == "function" and target.parent == g.programOwner, "closure owner differs")
                    assign(dst, "function:" .. args[1])
                    yield nil
                end
                -- Cells and captures hold any value; their uses check it at run time.
                case "NewCell" -> do
                    assign(dst, "cell")
                    yield nil
                end
                case "GetCell", "GetUpval" -> do
                    assign(dst, "value")
                    yield nil
                end
                case "SetCell" -> nil
                case "NewTable", "GetIdx" -> do
                    assign(dst, "value")
                    yield nil
                end
                case "Len" -> do
                    assign(dst, "number")
                    yield nil
                end
                case "MathFloor" -> do
                    assign(dst, "number")
                    yield nil
                end
                case "LibCall" -> do
                    assign(dst, "value")
                    yield nil
                end
                case "Not" -> do
                    assign(dst, "boolean")
                    yield nil
                end
                case "SetIdx", "Destroy" -> nil
                else -> error("core graph contracts: unsupported operation", 0)
            end
        end
        local term = block.term
        if term.kind == "invoke" then
            local contract = need(output.contracts[term.contract + 1], "invoke contract differs")
            local target = need(output.signatures[contract.signature + 1], "invoke signature differs")
            if term.results ~= nil then
                -- Several results are dynamic values whatever the callee says.
                for _, id in ipairs(term.results) do
                    assign(id, "value")
                end
            elseif term.result ~= nil and contract.protected then
                -- A protected call answers true or false before any result.
                assign(term.result, "value")
            elseif term.result ~= nil then
                assign(term.result, target.result)
            end
        end
        for _, edge in ipairs(term.edges) do
            local params = g.blocks[edge.target].params
            local offset = term.kind == "invoke" and (term.results and #term.results or term.result ~= nil and 1 or 0)
                or 0
            for at, id in ipairs(edge.args) do
                propagate("edge", {id}, params[at + offset])
            end
        end
    end

    -- Each SSA value enters pending at most once. Every operation/edge rule
    -- runs only when one of its input kinds becomes known.
    local at = 1
    while at <= #pending do
        local id = pending[at]
        at += 1
        for _, rule in ipairs(users[id] or {}) do
            apply(rule)
        end
    end

    if output.schema.version < 5 then
        topological(g.blocks, edges, 1)
    else
        local reached = {[1] = true}
        local ready: {integer} = {1}
        local nextBlock: integer = 1
        while nextBlock <= #ready do
            for _, target in ipairs(edges[ready[nextBlock]]) do
                need(g.blocks[target] ~= nil, "invalid graph dependency")
                if not reached[target] then
                    reached[target] = true
                    ready[#ready + 1] = target
                end
            end
            nextBlock += 1
        end
        if #ready ~= #g.blocks then
            local unreached = 0
            for index = 1, #g.blocks do
                if not reached[index] then
                    unreached = index
                    break
                end
            end
            local at = g.blocks[unreached] and g.blocks[unreached].term and g.positions[g.blocks[unreached].term.pos]
            need(
                false,
                "unreachable graph is unsupported: " .. tostring(
                    g.name
                ) .. " block " .. tostring(
                    unreached
                ) .. " at " .. tostring(g.path) .. ":" .. tostring(at and at.line) .. ":" .. tostring(at and at.column)
            )
        end
    end

    local returned
    for _, block in ipairs(g.blocks) do
        for _, id in ipairs(block.params) do
            need(kinds[id] ~= nil, "unresolved scalar block parameter")
        end
        for at, op in ipairs(block.op) do
            local args = block.args[at]
            need(
                op == "SetCell" or op == "SetIdx" or op == "Destroy" or kinds[block.dst[at]] ~= nil,
                "unresolved scalar operation"
            )
            if op == "MathFloor" then
                need(fits(kinds[args[1]], "number"), "numeric operation needs numeric operands")
            elseif op == "Not" then
                need(kinds[args[1]] ~= nil, "unresolved negation operand")
            elseif op == "LibCall" then
                for index = 2, #args do
                    need(kinds[args[index]] ~= nil, "unresolved library argument")
                end
            elseif op == "Destroy" then
                need(kinds[args[1]] ~= nil and kinds[args[2]] ~= nil, "unresolved destructor operand")
            elseif op == "NewCell"
                or op == "GetCell"
                or op == "SetCell"
                or op == "GetUpval"
                or op == "NewTable"
                or op == "GetIdx"
                or op == "SetIdx"
                or op == "Len"
            then
                need(op == "GetUpval" or op == "NewTable" or kinds[args[1]] ~= nil, "unresolved cell operand")
            elseif op == "Move" then
                need(kinds[args[1]] ~= nil, "unresolved scalar move")
            elseif op == "Eq" then
                need(kinds[args[1]] ~= nil and kinds[args[2]] ~= nil, "unresolved equality operand")
            elseif op ~= "K" and op ~= "Nil" and op ~= "Require" and op ~= "Closure" then
                need(
                    fits(kinds[args[1]], "number") and fits(kinds[args[2]], "number"),
                    "numeric operation needs numeric operands"
                )
            end
        end
        local term = block.term
        if term.kind == "return" then
            -- The copied term still distinguishes absent return from NIL SSA.
            local kind = term.value and need(kinds[term.value], "unresolved return") or "nil"
            -- From v8 a closure is returned as the value it is.
            if dynamic and kind:sub(1, 9) == "function:" then
                kind = "value"
            end
            -- Several results, or a spread pack, are dynamic values.
            if term.values ~= nil or term.spread ~= nil then
                need(dynamic, "several results need dynamic values")
                for _, id in ipairs(term.values or {}) do
                    need(kinds[id] ~= nil, "unresolved return")
                end
                need(term.spread == nil or kinds[term.spread] ~= nil, "unresolved spread pack")
                kind = "value"
            end
            need(
                kind == "boolean"
                or kind == "nil"
                or output.schema.version >= 3 and kind == "number"
                or dynamic and kind == "value",
                "unsupported scalar return"
            )
            need(returned == nil or returned == kind or dynamic, "incompatible scalar returns")
            returned = (returned == nil or returned == kind) and kind or "value"
        elseif term.kind == "invoke" then
            local contract = output.contracts[term.contract + 1]
            local target = output.signatures[contract.signature + 1]
            need(
                kinds[term.callee] == "function:"
                .. contract.target
                or output.schema.version >= 7
                and kinds[term.callee] == "value"
                or contract.target == output.schema.absent
                and tostring(kinds[term.callee]):match("^function:") ~= nil
                -- From v8 a dynamic call takes any value, its callee checked
                -- when it runs ("attempt to call a number value").
                or contract.target == output.schema.absent and output.schema.version >= 8 and kinds[term.callee] ~= nil,
                "actual callee provenance differs"
            )
            -- A variadic callee takes its fixed arguments and any number more.
            local fixed = target.variadic and #target.params - 1 or #target.params
            -- xpcall's handler rides last among the term's arguments.
            local given = contract.handled and #term.args - 1 or #term.args
            if not (given == fixed or target.variadic and given > fixed or term.spread ~= nil) then
                local at = g.positions[term.pos]
                need(
                    false,
                    "call arity differs: " .. tostring(
                        given
                    ) .. " given, " .. tostring(
                        fixed
                    ) .. " taken at " .. tostring(
                        g.path
                    ) .. ":" .. tostring(at and at.line) .. ":" .. tostring(at and at.column)
                )
            end
            need(term.spread == nil or kinds[term.spread] ~= nil, "unresolved spread pack")
            for at, id in ipairs(term.args) do
                need(at > fixed or fits(kinds[id], target.params[at]), "call scalar argument differs")
            end
        elseif term.kind == "branch" then
            need(
                kinds[term.value] == "boolean"
                or kinds[term.value] == "nil"
                or dynamic and kinds[term.value] == "value",
                "unsupported branch value"
            )
        end
        for _, edge in ipairs(term.edges) do
            local params = g.blocks[edge.target].params
            local offset = term.kind == "invoke" and (term.results and #term.results or term.result ~= nil and 1 or 0)
                or 0
            for at, id in ipairs(edge.args) do
                need(kinds[id] ~= nil, "unresolved edge value")
                need(fits(kinds[id], kinds[params[at + offset]]), "incompatible scalar join")
            end
        end
    end

    -- A graph with no return never returns (it only raises): its checked
    -- result holds of every return it has.
    if returned == nil and signature.kind ~= "initializer" then
        returned = signature.result
    end

    return need(returned, "missing scalar return")
end

local function same(actual: any, expected: any): nil
    need(type(actual) == type(expected), "canonical schema differs")
    if type(expected) ~= "table" then
        need(actual == expected, "canonical schema differs")
        return
    end
    for key, value in pairs(expected) do
        same(actual[key], value)
    end
    for key in pairs(actual) do
        need(expected[key] ~= nil, "canonical schema differs")
    end
end

local function reference(id: any, values: any): any
    integer(id, 4294967295)
    return need(values[id + 1], "semantic reference outside table")
end

-- Each signature record of `p`, in order.
local function checkSignatures(p: any): nil
    for index, signature in ipairs(p.signatures) do
        fields(signature, "id kind params result variadic")
        need(signature.id == index - 1, "signature order differs")
        need(
            signature.variadic == nil
            or signature.variadic == true and p.schema.version >= 8 and #signature.params >= 1,
            "variadic signature outside its profile"
        )
        need(signature.kind == "initializer" or signature.kind == "callable", "unknown signature kind")
        need(
            signature.result == "boolean"
            or signature.result == "nil"
            or p.schema.version >= 3 and signature.result == "number"
            or p.schema.version >= 8 and signature.result == "value",
            "unsupported scalar result"
        )
        dense(signature.params, 239)
        for _, kind in ipairs(signature.params) do
            need(
                kind == "boolean"
                or kind == "nil"
                or p.schema.version >= 3 and kind == "number"
                or p.schema.version >= 8 and kind == "value",
                "unsupported scalar parameter"
            )
        end
    end
end

-- What checking catalog relationships keeps across owners: the module of each
-- initializer by its owner, each module's initializer by name, the
-- signatures, contracts and callsites seen, and each graph's block arities and
-- static callees.
local function relations(p: any, modulesByOwner: any, chunks: any): any
    local scope: any = {
        modulesByOwner = modulesByOwner,
        chunks = chunks,
        signatures = {},
        arities = {},
        calls = {},
        used = {},
        sites = {},
        admitted = {},
        terms = {},
        -- Each owner's lexical root, memoized so a walk stops at the first
        -- owner already resolved: linear in owners however deep the nesting.
        roots = {}
    }
    for _, operation in ipairs(p.schema.operations) do
        scope.admitted[operation.name] = operation
    end
    for _, term in ipairs(p.schema.terms) do
        scope.terms[term.name] = term
    end

    return scope
end

local function root(p: any, scope: any, owner: any): any
    local path, ancestor, remaining = {}, owner, #p.catalog
    while ancestor.kind ~= "module" and scope.roots[ancestor] == nil do
        need(remaining > 0, "cyclic lexical parents")
        remaining -= 1
        path[#path + 1] = ancestor
        ancestor = reference(ancestor.parent, p.catalog)
    end
    local found = scope.roots[ancestor] or ancestor
    for _, item in ipairs(path) do
        scope.roots[item] = found
    end

    return found
end

-- The relationships of catalog record `index` (`owner`) of `p` and its graph:
-- its signature, lexical root and module, its closures', requires' and calls'
-- targets, and the arity of each block's call.
local function relate(p: any, scope: any, index: integer, owner: any): nil
    fields(owner, "id kind parent signature graph effect")
    need(owner.id == index - 1 and owner.graph == index - 1, "owner/graph order differs")
    need(owner.effect == 0 or owner.effect == 1, "unknown owner effect")
    local signature = reference(owner.signature, p.signatures)
    scope.signatures[owner.signature] = true
    if owner.kind == "module" then
        need(
            scope.modulesByOwner[owner.id] ~= nil
            and owner.parent == nil
            and signature.kind == "initializer"
            and #signature.params == 0,
            "invalid initializer signature/parent"
        )
    else
        need(owner.kind == "function" and signature.kind == "callable", "invalid function signature")
        need(scope.modulesByOwner[root(p, scope, owner).id] ~= nil, "foreign lexical root")
    end
    local g = p.graphs[index]
    copyGraph(g, p.schema.version)
    need(g.programOwner == owner.id and g.nparams == #signature.params, "graph owner/signature differs")
    local module = need(scope.modulesByOwner[root(p, scope, owner).id], "graph module is not cataloged")
    need(g.module == module.name and g.path == module.path, "graph module source differs")
    local arities, calls = {}, {}
    scope.arities[index], scope.calls[index] = arities, calls
    for bi, block in ipairs(g.blocks) do
        arities[bi] = 4294967295
        for at, op in ipairs(block.op) do
            local operation = need(scope.admitted[op], "unsupported semantic operation " .. op)
            if op == "Closure" then
                need(p.schema.version >= 7 or #block.args[at] == 1, "captures are unsupported")
                local target = reference(block.args[at][1], p.catalog)
                need(target.kind == "function" and target.parent == owner.id, "closure lexical target differs")
            elseif op == "Require" then
                local constant = reference(block.args[at][1], g.constants)
                need(constant.kind == "str", "require needs a static module name")
                local target = scope.chunks[constant.value]
                need(
                    target ~= nil and (target < owner.id or p.schema.version >= 8),
                    "forward or cyclic require is unsupported"
                )
            end
            need(
                #block.args[at] == #operation.args or operation.variadic and #block.args[at] > #operation.args,
                "operation operand count differs"
            )
        end
        local term = block.term
        local policy = need(scope.terms[term.kind], "unsupported semantic terminator")
        need(#term.edges == policy.edges, "terminator edge count differs")
        if term.kind == "invoke" then
            local contract = reference(term.contract, p.contracts)
            need(not scope.used[term.contract], "reused invoke contract")
            scope.used[term.contract] = true
            need(contract.owner == owner.id and contract.block == block.id, "contract owner/block differs")
            -- A dynamic call (v8) has no target: its callee is checked against
            -- the call's signature when it runs.
            local dynamic = contract.target == p.schema.absent
            need(not dynamic or p.schema.version >= 8, "dynamic call outside its profile")
            -- A dynamic call's signature is its own use: no owner need share it.
            if dynamic then
                scope.signatures[contract.signature] = true
            end
            if not dynamic then
                local target = reference(contract.target, p.catalog)
                need(
                    target.kind == "function" and contract.signature == target.signature,
                    "contract target/signature differs"
                )
                calls[#calls + 1] = target.id + 1
            end
            local called = reference(contract.signature, p.signatures)
            local fixed = called.variadic and #called.params - 1 or #called.params
            -- xpcall's handler rides last among the term's arguments.
            local given = contract.handled and #term.args - 1 or #term.args
            need(
                given == fixed or called.variadic and given > fixed or term.spread ~= nil,
                "invoke operand count differs"
            )
            arities[bi] = #term.args
        end
    end
end

-- Every signature of `p` is one an owner or a call uses.
local function checkUsed(p: any, scope: any): nil
    for index in ipairs(p.signatures) do
        need(scope.signatures[index - 1], "unused signature record")
    end
end

-- Each contract of `p` is used once, in order, with its own callsite when
-- `callsites` asks for one.
local function checkContracts(p: any, scope: any, callsites: boolean): nil
    for index, contract in ipairs(p.contracts) do
        fields(contract, "id owner block callsite target signature effect protected handled")
        need(
            contract.protected == nil or contract.protected == true and p.schema.version >= 8,
            "protected call outside its profile"
        )
        need(
            contract.handled == nil or contract.handled == true and contract.protected == true,
            "handled call is not protected"
        )
        need(contract.id == index - 1 and scope.used[index - 1], "unused or unordered contract")
        if callsites then
            integer(contract.callsite, bounds.calls - 1)
            need(not scope.sites[contract.callsite], "reused callsite identity")
            scope.sites[contract.callsite] = true
        end
        need(contract.effect == 1, "invoke effect must remain conservative")
    end
end

-- The effect each of the first `count` records of `p` declares is its graph's.
local function checkEffects(p: any, scope: any, count: integer): nil
    for index = 1, count do
        local effect = 0
        for _, block in ipairs(p.graphs[index].blocks) do
            for _, op in ipairs(block.op) do
                effect = math.max(effect, scope.admitted[op].effect)
            end
            if block.term.kind == "invoke" then
                effect = 1
            end
        end
        need(p.catalog[index].effect == effect, "owner effect differs from graph")
    end
end

-- Catalog relationships only. This does not prove usable SSA, scalar
-- provenance, checked source identity, or permission to execute. Input must
-- come from the bounded decoder or the full semantic tree-budget preflight.
export function catalog(p: any): any
    fields(p, "schema entry modules catalog signatures graphs contracts")
    need(
        type(p.schema.version) == "number" and p.schema.version >= 2 and p.schema.version <= 8,
        "unknown source graph profile"
    )
    same(p.schema, schema.describe(p.schema.version))
    local count = dense(p.catalog, bounds.owners)
    need(count > 0 and dense(p.graphs, bounds.owners) == count, "complete semantic graph table required")
    local moduleCount = dense(p.modules, bounds.modules)
    need(moduleCount > 0 and moduleCount <= count, "complete semantic module table required")
    need(
        p.schema.version < 5 or moduleCount == 1 or p.schema.version >= 8,
        "loop profile requires one scalar initializer"
    )
    dense(p.signatures, bounds.signatures)
    dense(p.contracts, bounds.calls)
    local modulesByOwner, moduleNames, chunks = {}, {}, {}
    for index, module in ipairs(p.modules) do
        fields(module, "name path chunk")
        local name, path = text(module.name), text(module.path)
        need(not moduleNames[name], "duplicate semantic module")
        moduleNames[name] = true
        chunks[name] = module.chunk
        need(module.chunk == index - 1, "initializer order differs")
        local owner = reference(module.chunk, p.catalog)
        need(owner.kind == "module" and owner.parent == nil, "initializer binding differs")
        modulesByOwner[owner.id] = {name = name, path = path}
    end
    need(modulesByOwner[p.entry] ~= nil, "entry initializer is not cataloged")
    checkSignatures(p)
    local scope = relations(p, modulesByOwner, chunks)
    for index, owner in ipairs(p.catalog) do
        relate(p, scope, index, owner)
    end
    checkUsed(p, scope)
    checkContracts(p, scope, true)
    if p.schema.version < 7 then
        topological(p.catalog, scope.calls, nil)
    end
    checkEffects(p, scope, count)

    return {arities = scope.arities, owners = count, contracts = #p.contracts}
end

export function semantic(p: any): nil
    budget.measure(p)
    local described = catalog(p)
    -- Source evidence is deliberately absent. The shared verifier only checks
    -- SSA structure with independently validated scalar arities for each block.
    for index, g in ipairs(p.graphs) do
        graph.verifyGuestStructure(g, described.arities[index])
    end
    for index, g in ipairs(p.graphs) do
        local owner = p.catalog[index]
        local signature = p.signatures[owner.signature + 1]
        local kind = resultKind(g, signature, p)
        need(
            kind == signature.result or p.schema.version >= 8 and (kind == "value" or signature.result == "value")
            -- A function that ends only by raising answers nil (contracts).
            or p.schema.version >= 8 and kind == "nil",
            "semantic result differs from signature"
        )
    end
end

-- One module's part of a v8 program, which a link joins to the others
-- (nupp.compiler.vm.corelink): `view` is shaped as a semantic catalog whose
-- first `count` catalog records are the module's owners, the first its
-- initializer, and whose later records stand for what its graphs name outside
-- it: functions, as their signatures, and other modules' initializers. Its
-- modules are its own and those it requires, named by those records. `kinds`
-- holds each graph's result kind (`resultKind`). The relationships within the
-- module are checked here; the link checks those that cross it. Returns how
-- many semantic items and text bytes the module's tables hold, toward the
-- program's budget.
export function piece(view: any, count: integer, kinds: {string}): any
    need(view.schema.version == 8, "module pieces are v8 programs")
    same(view.schema, schema.describe(view.schema.version))
    need(count > 0 and dense(view.graphs, bounds.owners) == count, "complete semantic graph table required")
    dense(view.contracts, bounds.calls)
    need(dense(view.catalog, bounds.owners) >= count, "complete semantic catalog required")
    dense(view.signatures, bounds.signatures)
    local module = view.modules[1]
    fields(module, "name path chunk")
    need(module.chunk == 0, "module piece initializer order differs")
    local chunks: {[string]: integer} = {}
    for _, item in ipairs(view.modules) do
        need(chunks[item.name] == nil, "duplicate semantic module")
        chunks[item.name] = item.chunk
    end
    local scope = relations(view, {[0] = {name = text(module.name), path = text(module.path)}}, chunks)
    checkSignatures(view)
    for index = 1, count do
        relate(view, scope, index, view.catalog[index])
    end
    -- A call outside the module uses the signature it names its callee by.
    for _, contract in ipairs(view.contracts) do
        if contract.target ~= view.schema.absent and contract.target >= count then
            scope.signatures[contract.signature] = true
        end
    end
    for index = count + 1, #view.catalog do
        local stub = view.catalog[index]
        if stub.signature ~= nil then
            scope.signatures[stub.signature] = true
        end
    end
    checkUsed(view, scope)
    checkContracts(view, scope, false)
    checkEffects(view, scope, count)
    local owners: {any} = {}
    for index = 1, count do
        owners[index] = view.catalog[index]
    end
    local measured = budget.measure({
        catalog = owners,
        signatures = view.signatures,
        graphs = view.graphs,
        contracts = view.contracts,
        module = module
    })
    for index, g in ipairs(view.graphs) do
        graph.verifyGuestStructure(g, scope.arities[index])
        local signature = view.signatures[view.catalog[index].signature + 1]
        local kind = kinds[index]
        need(
            kind == signature.result or kind == "value" or signature.result == "value" or kind == "nil",
            "semantic result differs from signature"
        )
    end

    return {items = measured.items, bytes = measured.bytes}
end
