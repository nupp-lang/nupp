--[[
Named arguments, as the core lowers them.

The checker binds `f(a, c = 3)`'s named arguments to their parameters and
records the positional list it binds to on the call's arguments
(`loweredArgs`): each value in parameter order and `nil` in a slot the call
skips. Main emits exactly that list. The core lowers the same list: the
arguments' expressions are replaced by it once, before the call is described,
and a skipped slot is a `nil` literal of its own. A plucked argument
(`{x, y} = position`) is the field read main emits, `position.x`.
]]
module nupp.compiler.vm.namedarguments

local cst = require("nupp.compiler.syntax.cst")
local T = require("nupp.compiler.types")

--- Replaces a call's named and plucked arguments with the positional list the checker
--- bound them to, answering the `nil` literals it made for skipped slots, or
--- nil when the call has no named arguments to replace.
export function normalize(call: any): {any}?
    local args = call.args
    if type(args) ~= "table" or args.kind ~= "args" or args.loweredArgs == nil then
        return nil
    end
    -- A tree described again (a library module two programs carry, or a
    -- second profile) keeps its replaced list; its `nil` literals are made
    -- once and answered again for each catalog to hold.
    if args.coreNamed then
        return args.coreSkipped
    end
    local named = false
    for _, argument in ipairs(args.exprs or {}) do
        if not cst.isToken(argument) and argument.kind == "namedArg" then
            named = true
        elseif not cst.isToken(argument) and argument.kind == "pluckArg" then
            named = true
        end
    end
    if not named then
        return nil
    end
    local token = cst.firstToken(call)
    local exprs, made = {}, {}
    for index, lowered in ipairs(args.loweredArgs) do
        if lowered.generatedKind == "expr" then
            exprs[index] = lowered.expr
        elseif lowered.generatedKind == "nil" then
            local skipped = {kind = "nilExpr", token = token, inferredType = T.nil_, token}
            exprs[index] = skipped
            made[#made + 1] = skipped
        elseif lowered.generatedKind == "field" and lowered.source and type(lowered.name) == "string" then
            -- The field read main emits: the source path, then `.name`.
            local source = lowered.source
            local at: any = cst.firstToken(source) or token
            local name = {
                kind = "name",
                text = lowered.name,
                line = at.line,
                col = at.col,
                offset = at.offset,
                trivia = {}
            }
            local pack = call.argumentPack
            exprs[
                index
            ] = {
                kind = "dotIndex",
                obj = source,
                name = name,
                pluckedField = true,
                inferredType = pack and pack.head and pack.head[index] or nil,
                name
            }
        else
            return nil
        end
    end
    args.sourceExprs, args.exprs, args.coreNamed, args.coreSkipped = args.exprs, exprs, true, made

    return made
end

-- Bind shared dotted prefixes before reading their leaf fields. Ordinary
-- arguments before a prefix still run before it, and the leaves run in the
-- checker's parameter order. Hold each staged value across later calls.
export function stagePlucks(ctx: any, nodes: any, kinds: any): (any, boolean)
    local last = 0
    for index in ipairs(kinds) do
        local node = nodes[index]
        if node.pluckedField and node.obj.kind == "dotIndex" then
            last = index
        end
    end
    if last == 0 then
        return nil, false
    end

    local held, paths, early, bases = {}, {}, {}, {}

    local function save(value: integer?): any
        if value == nil then
            return nil
        end
        local handle = ctx.hold(value)
        held[#held + 1] = handle

        return handle
    end

    local function release(): nil
        for index = #held, 1, -1 do
            ctx.release(held[index])
        end
    end

    local function readField(node: any, base: any, kind: string): integer?
        local field = {}
        for key, value in pairs(node) do
            field[key] = value
        end
        field.obj = {kind = "heldPluckSource", handle = base, inferredType = node.obj.inferredType}

        return ctx.expression(field, kind)
    end

    local function bindPath(node: any): any
        local siblings, key, parent = paths, nil, nil
        if node.kind == "name" then
            key = node.token.definition or node.token.text
        elseif node.kind == "dotIndex" then
            parent = bindPath(node.obj)
            if parent == nil then
                return nil
            end
            siblings, key = parent.fields, node.name.text
        else
            local source = save(ctx.expression(node, "tagged"))
            return source ~= nil and {handle = source, fields = {}} or nil
        end
        local bound = siblings[key]
        if bound == nil then
            local value: integer? = nil
            if parent == nil then
                value = ctx.expression(node, "tagged")
            else
                value = readField(node, parent.handle, "tagged")
            end
            local handle = save(value)
            if handle == nil then
                return nil
            end
            bound = {handle = handle, fields = {}}
            siblings[key] = bound
        end

        return bound
    end

    for index = 1, last do
        local node = nodes[index]
        if node.pluckedField then
            if node.obj.kind == "dotIndex" then
                local base = bindPath(node.obj)
                if base == nil then
                    release()
                    return nil, true
                end
                bases[index] = base.handle
            end
        elseif node.kind ~= "nilExpr" then
            early[index] = save(ctx.expression(node, kinds[index]))
            if early[index] == nil then
                release()
                return nil, true
            end
        end
    end

    local operands, values = {}, {}
    for index, kind in ipairs(kinds) do
        local handle = early[index]
        if handle == nil then
            local base = bases[index]
            local value: integer? = nil
            if base == nil then
                value = ctx.expression(nodes[index], kind)
            else
                value = readField(nodes[index], base, kind)
            end
            handle = save(value)
        end
        if handle == nil then
            release()
            return nil, true
        end
        operands[index] = handle
    end
    for index, handle in ipairs(operands) do
        values[index] = ctx.readHeld(handle)
    end
    release()

    return values, true
end
