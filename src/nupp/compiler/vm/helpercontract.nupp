module nupp.compiler.vm.helpercontract

local contract = {}
local fields = {"mayCollect", "mayPark", "mayRaise", "pure"}
local allowed = {mayCollect = true, mayPark = true, mayRaise = true, pure = true}

--- Returns the declared effects of a native helper.
---
--- The checked declaration carries plain semantic metadata, so graph consumers
--- do not need its syntax tree or a second table of helper names.
--- @raises string when the declaration is missing or inconsistent
function contract.read(definition: any, name: string): {
    mayCollect: boolean,
    mayPark: boolean,
    mayRaise: boolean,
    pure: boolean
}
    local found = nil
    for _, annotation in ipairs(definition and definition.annotations or {}) do
        if annotation.name == "vmHelperEffects" then
            assert(found == nil, "helper " .. name .. " has duplicate effect summaries")
            found = annotation
        end
    end
    assert(found ~= nil, "helper " .. name .. " has no declared effects")
    local effects: {[string]: boolean} = {}
    for _, argument in ipairs(found.arguments or {}) do
        assert(allowed[argument.name] == true, "helper " .. name .. " has an unknown effect")
        assert(effects[argument.name] == nil, "helper " .. name .. " has a duplicate effect")
        assert(
            argument.kind == "value" and type(argument.value) == "boolean",
            "helper " .. name .. " effects must be booleans"
        )
        effects[argument.name] = argument.value
    end
    for _, field in ipairs(fields) do
        assert(effects[field] ~= nil, "helper " .. name .. " has no " .. field .. " effect")
    end
    assert(
        not effects.pure or not (effects.mayCollect or effects.mayPark or effects.mayRaise),
        "helper " .. name .. " is pure but may collect, park or raise"
    )

    return {
        mayCollect = effects.mayCollect == true,
        mayPark = effects.mayPark == true,
        mayRaise = effects.mayRaise == true,
        pure = effects.pure == true,
    }
end

function contract.normalReturn(definition: any, name: string): any
    local found = nil
    for _, annotation in ipairs(definition and definition.annotations or {}) do
        if annotation.name == "vmNormalReturn" then
            assert(found == nil, "helper " .. name .. " has duplicate normal-return contracts")
            found = annotation
        end
    end
    if found == nil then
        return nil
    end
    local fields: {[string]: any} = {}
    for _, argument in ipairs(found.arguments or {}) do
        assert(argument.kind == "value", "helper " .. name .. " requires literal normal-return metadata")
        assert(
            argument.name == "context"
            or argument.name == "frame"
            or argument.name == "outcomes"
            or argument.name == "synchronized",
            "helper " .. name .. " has unknown normal-return metadata"
        )
        assert(fields[argument.name] == nil, "helper " .. name .. " has duplicate normal-return fields")
        fields[argument.name] = argument.value
    end
    assert(
        type(fields.context) == "number" and fields.context >= 1 and fields.context % 1 == 0,
        "helper " .. name .. " has invalid normal-return context"
    )
    assert(
        fields.frame == "caller" and fields.outcomes == "ready-error" and fields.synchronized == true,
        "helper " .. name .. " has invalid normal-return authority"
    )

    return {context = fields.context, frame = fields.frame, outcomes = fields.outcomes, synchronized = true}
end

export = contract
