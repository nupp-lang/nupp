module nupp.compiler.vm.residual

local graph = require("nupp.compiler.vm.graph")
local names = {IK = true, IMov = true, IAddK = true, IMaskU32 = true, IAdd = true, ISub = true, IAnd = true, IOr = true}
local operations = {
    NativeConstant = true,
    ProgramLoad = true,
    FrameSlotRead = true,
    FrameSlotWrite = true,
    PointerOffset = true,
    IAdd = true,
    ISub = true,
    IAnd = true,
    IOr = true
}
local templates: any = setmetatable({}, {__mode = "k"})
local bodies: any = setmetatable({}, {__mode = "k"})
local results: any = setmetatable({}, {__mode = "k"})

local function need(ok: any, message: string): any
    return (assert(ok, "residual: " .. message))
end

local function integer(value: any, low: number, high: number): boolean
    return type(value) == "number" and value == math.floor(value) and value >= low and value <= high
end

local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local result = {}
    for key, item in pairs(value) do
        result[key] = copy(item)
    end

    return result
end

local function resultState(result: any): any
    need(type(result) == "table", "unknown residual result")
    return need(rawget(results, result), "unknown residual result")
end

local function view(state: any): any
    return {
        graph = copy(state.graph),
        body = state.body,
        pc = state.pc,
        count = state.count,
        segments = copy(state.segments)
    }
end

local function publish(state: any): any
    local result = view(state)
    results[result] = state
    return result
end

-- A result's identity admits a fresh detached snapshot. Public fields and
-- metatables are never inspected; the exact retained body owner is preserved.
-- This authenticates compiler provenance, not loader tags or window extents.
export function snapshot(result: any): any
    return view(resultState(result))
end

-- Prototype precondition: a trusted loader supplies the existing runtime
-- dispatch catalog's tag for this checked handler. This is not a verifier for
-- untrusted bytecode or for the catalog association; production needs that
-- authoritative adapter. There is no second opcode catalog or decoder here.
export function prepare(source: any, opcode: number): any
    require("nupp.compiler.vm.nativeframecontract").refuse(source, "residual preparation")
    graph.verify(source)
    need(integer(opcode, 0, 255), "invalid opcode tag")
    need(source.native and source.native.abi == "handler", "handler graph required")
    need(source.source and names[source.source.name], "handler outside initial slice")
    need(#source.blocks == 1 and #source.blocks[1].params == 0, "single closed block required")
    local block = source.blocks[1]
    need(#block.op <= 64 and block.term.kind == "dispatch", "bounded dispatch block required")
    local constants, bindings, decoded, slots = {}, {}, {}, {}
    for index, op in ipairs(block.op) do
        need(operations[op], "unsupported operation " .. op)
        local args, dst = block.args[index], block.dst[index]
        if op == "NativeConstant" then
            local text = args[1]
            if source.exactTypes[dst] == "int64" and text:match("^%d+$") and #text <= 2 then
                constants[dst] = tonumber(text)
            end
        elseif op == "ProgramLoad" then
            local access = args[3]
            local offset = constants[args[2]]
            need(args[1] == 1 and offset ~= nil, "program load requires entry code and constant offset")
            need(access.kind == "uint8" or access.kind == "uint64", "unsupported program kind")
            need(offset >= 1 and offset + access.width <= 16, "program load exceeds instruction")
            local binding = {
                instruction = index,
                value = dst,
                offset = offset,
                width = access.width,
                kind = access.kind
            }
            bindings[#bindings + 1], decoded[dst] = binding, binding
        elseif op == "FrameSlotRead" or op == "FrameSlotWrite" then
            local access = args[op == "FrameSlotRead" and 4 or 5]
            need(access.class == "i" and access.kind == "uint64", "integer bits slot required")
            local binding = decoded[args[3]]
            need(binding and binding.kind == "uint8", "slot index requires decoded byte")
            slots[#slots + 1] = binding.value
        elseif op == "PointerOffset" then
            need(args[1] == 1 and constants[args[2]] == 16, "only next-instruction pointer allowed")
        end
    end
    need(#bindings >= 1 and #bindings <= 4, "operand binding count")
    local pc = block.term.args[1]
    local nextPointer = false
    for i, op in ipairs(block.op) do
        if block.dst[i] == pc and op == "PointerOffset" then
            nextPointer = true
        end
    end
    need(nextPointer, "dispatch must advance one instruction")
    local handle = {}
    templates[handle] = {graph = copy(source), bindings = bindings, slots = slots, opcode = opcode}

    return handle
end

-- Bytes are immutable and owned by this handle. Equal bytes retained twice
-- are distinct bodies. The owner supplies its verified integer-window extent.
export function retain(bytes: string, integerSlots: number): any
    need(
        type(bytes) == "string" and #bytes >= 32 and #bytes <= 16777216 and #bytes % 16 == 0,
        "invalid retained body extent"
    )
    need(integer(integerSlots, 1, 256), "invalid integer window extent")
    local handle = {}
    bodies[handle] = {bytes = bytes, integerSlots = integerSlots}

    return handle
end

-- Inspection returns detached data; it cannot mutate the template authority.
export function inspect(template: any): any
    return copy(need(templates[template], "unknown template"))
end

local function word(bytes: string, start: number, width: number): string
    local digits = {}
    for offset = width - 1, 0, -1 do
        digits[#digits + 1] = string.format("%02x", bytes:byte(start + offset))
    end

    return "0x" .. table.concat(digits)
end

-- expectedBody is the retained allocation identity held by the compilation
-- request. The returned result keeps that owner alive beside the bound graph.
export function bind(template: any, body: any, expectedBody: any, pc: number): any
    local prepared = need(templates[template], "unknown template")
    local retained = need(bodies[body], "unknown retained body")
    need(rawequal(body, expectedBody), "retained body identity mismatch")
    need(integer(pc, 0, #retained.bytes - 32) and pc % 16 == 0, "instruction extent or alignment")
    need(retained.bytes:byte(pc + 1) == prepared.opcode, "selected handler opcode mismatch")
    local bound = copy(prepared.graph)
    local block, values = bound.blocks[1], {}
    for _, binding in ipairs(prepared.bindings) do
        local start = pc + binding.offset + 1
        local literal = word(retained.bytes, start, binding.width)
        block.op[binding.instruction] = "NativeConstant"
        block.args[binding.instruction] = {literal}
        if binding.width == 1 then
            values[binding.value] = retained.bytes:byte(start)
        end
    end
    for _, id in ipairs(prepared.slots) do
        need(values[id] < retained.integerSlots, "slot exceeds integer window")
    end
    graph.verify(bound)

    return publish({graph = bound, template = template, body = body, pc = pc})
end

-- A bound result is a view, not authority. Stitching copies its private
-- canonical graph; aggregate results are not single-instruction bindings.
export function stitch(sequence: any): any
    need(type(sequence) == "table" and getmetatable(sequence) == nil, "plain sequence table required")
    local count = #sequence
    need(count >= 1 and count <= 64, "sequence extent")
    local entries, dense = 0, {}
    for key, result in pairs(sequence) do
        need(integer(key, 1, count), "sequence must be a dense array")
        dense[key] = result
        entries = entries + 1
    end
    need(entries == count, "sequence must be a dense array")
    local first = resultState(dense[1])
    local sources = {}
    for index, result in ipairs(dense) do
        local kept = resultState(result)
        need(kept.template ~= nil, "single bound result required")
        need(rawequal(kept.body, first.body), "sequence body identity mismatch")
        need(kept.pc == first.pc + (index - 1) * 16, "sequence must advance one instruction")
        local source = copy(kept.graph)
        local block = source.blocks[1]
        need(#source.certificates == 0, "sequence certificates unsupported")
        need(source.recovery == nil and source.recoveries == nil, "sequence recovery metadata unsupported")
        for i = 2, 6 do
            need(block.term.args[i] == i, "sequence changes a frame window or context")
        end
        for _, certificate in ipairs(block.cert) do
            need(certificate == 0, "sequence certificates unsupported")
        end
        sources[index] = source
    end
    local original = sources[1]
    local joined = graph.newNative(copy(original.native.params), original.native.result, original.native.abi)
    joined.native, joined.source = copy(original.native), copy(original.source)
    local block = graph.block(joined)
    local incoming = {1, 2, 3, 4, 5, 6}
    local segments = {}
    for index, source in ipairs(sources) do
        local from = source.blocks[1]
        local values, positions = copy(incoming), {}
        for id, position in ipairs(source.positions) do
            positions[id] = #joined.positions + 1
            joined.positions[#joined.positions + 1] = copy(position)
        end
        local start = #block.op + 1
        for at, operation in ipairs(from.op) do
            local signature = graph.signatures[operation]
            local args = {}
            for i, argument in ipairs(from.args[at]) do
                local class = signature.args[i]
                if graph.classes[class] ~= nil or class == "a" then
                    args[i] = need(values[argument], "sequence value unavailable")
                else
                    args[i] = copy(argument)
                end
            end
            local destination = from.dst[at]
            local kind = destination ~= 0 and source.exactTypes[destination] or nil
            local value = graph.emitNative(joined, block, operation, args, kind, positions[from.pos[at]] or 0)
            if destination ~= 0 then
                values[destination] = value
            end
        end
        local term = copy(from.term)
        for i, argument in ipairs(from.term.args) do
            term.args[i] = need(values[argument], "sequence dispatch value unavailable")
        end
        term.pos = positions[from.term.pos] or 0
        block.term = term
        segments[
            index
        ] = {
            pc = first.pc + (index - 1) * 16,
            source = copy(source.source),
            first = start,
            last = #block.op,
            dispatch = copy(term)
        }
        -- Dispatch preserves the value window in this bounded slice, so its
        -- reconstructed logical frame remains the same sixth graph parameter.
        incoming = {term.args[1], term.args[2], term.args[3], term.args[4], term.args[5], incoming[6]}
    end
    graph.verify(joined)

    return publish({graph = joined, body = first.body, pc = first.pc, count = #sources, segments = segments})
end
