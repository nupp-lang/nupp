module nupp.compiler.vm.nativeservice

local unit = require("nupp.compiler.vm.nativeunit")
local targetlayout = require("nupp.compiler.targetlayout")
local nativeos = require("nupp.compiler.vm.nativeos")
export const MAX_OWNERS: integer = 2048
local scopedCalls: any = setmetatable({}, {__mode = "k"})
local heapUses: any = setmetatable({}, {__mode = "k"})
local ownerCatalogs: any = setmetatable({}, {__mode = "k"})
local catalogs: any = setmetatable({}, {__mode = "k"})
local signatures: any = setmetatable({}, {__mode = "k"})
local supplied: any = setmetatable({}, {__mode = "k"})
local graphs: any = setmetatable({}, {__mode = "k"})
local calls: any = setmetatable({}, {__mode = "k"})
local failures: any = setmetatable({}, {__mode = "k"})
local unmanaged: any = setmetatable({}, {__mode = "k"})
local managedResults: any = setmetatable({}, {__mode = "k"})
local managedPlans: any = setmetatable({}, {__mode = "k"})
local managedRows: any = setmetatable({}, {__mode = "k"})
local allowed = {
    ["nupp.runtime.vm.arena"] = true,
    ["nupp.runtime.vm.heap"] = true,
    ["nupp.runtime.vm.collector"] = true,
    ["nupp.runtime.vm.marking"] = true,
    ["nupp.runtime.vm.gcweak"] = true,
    ["nupp.runtime.vm.gcfinal"] = true,
    ["nupp.runtime.vm.childwalk"] = true,
    ["nupp.runtime.vm.objectwalk"] = true,
    ["nupp.runtime.vm.values"] = true,
    ["nupp.runtime.vm.objectconstruct"] = true,
    ["nupp.runtime.vm.backing"] = true,
    ["nupp.runtime.vm.weakentries"] = true,
    ["nupp.runtime.vm.weakindex"] = true,
    ["nupp.runtime.vm.objectweak"] = true,
    ["nupp.runtime.vm.objecthash"] = true,
    ["nupp.runtime.vm.objecttable"] = true,
    ["nupp.runtime.core.pagemappings"] = true,
    ["nupp.runtime.core.servicescope"] = true,
    ["nupp.runtime.core.resourcejournal"] = true,
    ["nupp.runtime.core.hostfiles"] = true,
    ["nupp.runtime.core.hostclock"] = true,
    ["nupp.runtime.core.hostc"] = true,
    ["nupp.runtime.core.cellservice"] = true,
    ["nupp.runtime.core.heapentry"] = true,
    ["nupp.runtime.core.rootentry"] = true,
    ["nupp.runtime.core.frameroots"] = true,
    ["nupp.runtime.core.frames"] = true,
    ["nupp.runtime.core.arena"] = true
}
-- Test units (buildUnits) add their own fixture modules for one build.
local unitModules: {[string]: boolean} = {}
local rawOwners = {["nupp.runtime.core.pagemappings"] = true, ["nupp.runtime.core.servicescope"] = true}
local osNames = {
    mapPages = true,
    unmapPages = true,
    pageSize = true,
    writeOutput = true,
    readInput = true,
    monotonicNanos = true,
    argument = true,
    poolStart = true,
    poolSubmit = true,
    poolTake = true,
    poolFinish = true,
    poolCancel = true,
    poolsettle = true,
    foreignCall = true,
    foreignCells = true,
    atomicload64 = true,
    atomiccas64 = true,
    securefill = true,
    systemquery = true,
}

local function need(ok: any, message: string): any
    assert(ok, "native service: " .. message)
    return ok
end

local function member(node: any): (string?, string?)
    if node.kind ~= "dotIndex" or node.obj.kind ~= "name" then
        return nil, nil
    end
    local definition = node.obj.token.definition

    return definition and definition.requiredModule, node.name.text
end

local function held(signature: any): any
    local item = need(signatures[signature], "unissued service signature")
    need(next(signature) == nil and getmetatable(signature) == nil, "service signature changed")
    need(
        unit.contains(item.owner)
        and item.owner.body == item.body
        and item.owner.checkedSignature == item.checked
        and item.owner.scope == item.scope,
        "service checked owner changed"
    )

    return item
end

local heapEffectFlags = {"top", "external", "yields"}
local heapEffectMaps = {"writes", "escapes", "shapes", "metatables"}

local function heapEffectSnapshot(summary: any): any
    local saved = {source = summary, flags = {}, maps = {}}
    if summary ~= nil then
        need(type(summary) == "table" and getmetatable(summary) == nil, "heap effect summary must be plain")
        for _, name in ipairs(heapEffectFlags) do
            saved.flags[name] = {value = summary[name]}
        end
        for _, name in ipairs(heapEffectMaps) do
            local values = summary[name]
            need(
                values == nil or type(values) == "table" and getmetatable(values) == nil,
                "heap effect map must be plain"
            )
            local entries = {}
            for key, value in pairs(values or {}) do
                entries[key] = value
            end
            saved.maps[name] = {source = values, entries = entries}
        end
    end

    return saved
end

local function validateHeapEffect(saved: any, summary: any): nil
    need(summary == saved.source, "heap effect checked summary changed")
    if summary == nil then
        return
    end
    need(getmetatable(summary) == nil, "heap effect checked summary changed")
    for _, name in ipairs(heapEffectFlags) do
        need(summary[name] == saved.flags[name].value, "heap effect checked summary flag changed")
    end
    for _, name in ipairs(heapEffectMaps) do
        local before, values = saved.maps[name], summary[name]
        need(
            values == before.source and (values == nil or getmetatable(values) == nil),
            "heap effect checked summary map changed"
        )
        for key, value in pairs(values or {}) do
            need(before.entries[key] == value, "heap effect checked summary map changed")
        end
        for key, value in pairs(before.entries) do
            need(values[key] == value, "heap effect checked summary map changed")
        end
    end
end

-- The catalogue borrows the same checked unit, not caller-created function or
-- effect tables. Enumeration is the unit's canonical membership index; this
-- module never walks syntax or lowers an expression.
local function catalog(entry: any, roots: any, review: any): any
    need(
        unit.contains(entry)
        and (allowed[entry.scope.name] or unitModules[entry.scope.name])
        and not rawOwners[entry.scope.name],
        "entry is outside the closed allocator service modules"
    )
    local state = {
        entry = entry,
        owners = {},
        order = {},
        calls = {},
        raises = {},
        intrinsics = {},
        reverse = {},
        keys = {},
        review = review
    }
    local pending = {}

    local function add(owner: any): any
        need(
            unit.sameOwners(entry, owner) and (allowed[owner.scope.name] or unitModules[owner.scope.name]),
            "callee outside closed service unit"
        )
        local item = state.owners[owner]
        if not item then
            need(#state.order < MAX_OWNERS, "service owner limit")
            local signature = {}
            item = {
                owner = owner,
                body = owner.body,
                checked = owner.checkedSignature,
                scope = owner.scope,
                effect = owner.body.effectSummary,
                heapEffect = heapEffectSnapshot(owner.body.effectSummary),
                signature = signature,
                state = state,
                scoped = false,
                raw = rawOwners[owner.scope.name] == true,
                id = #state.order + 1,
                key = {}
            }
            signatures[signature] = item
            state.owners[owner], state.order[#state.order + 1] = item, item
            state.reverse[owner] = {}
            pending[#pending + 1] = item
        end

        return item
    end

    local function edge(from: any, target: any): nil
        add(target)
        state.reverse[target][from.owner] = true
    end

    add(entry)
    for _, root in ipairs(roots) do
        add(root)
    end
    local cursor = 1
    while cursor <= #pending do
        local item = pending[cursor]
        local owner = item.owner
        for ordinal, node in ipairs(unit.occurrences(owner)) do
            if node.kind == "call" then
                unit.occurrence(owner, node)
                local raising = unit.literalRaise(owner, node)
                if raising then
                    need(not item.raw, "infrastructure cannot raise")
                    item.scoped, item.raises = true, true
                    state.raises[
                        node
                    ] = {owner = owner, literal = raising.literal, site = ordinal, definition = raising.definition}
                    local target = need(
                        unit.ownerModule(owner, "nupp.runtime.core.servicescope").exports.fail,
                        "missing checked first-error helper"
                    )
                    edge(item, target)
                    state.calls[node] = {owner = owner, target = target, raising = true}
                else
                    local moduleName, name = member(node.obj)
                    if moduleName == "nupp.runtime.vm.os" then
                        local bound = unit.osDeclaration(owner, node)
                        need(osNames[name], "unsupported OS service")
                        if item.raw then
                            local pages = unit.ownerModule(owner, "nupp.runtime.core.pagemappings")
                            need(
                                name ~= "mapPages"
                                or owner == pages.exports.map
                                or owner == pages.exports.acquireEntry
                                or owner == pages.exports.acquireshared,
                                "raw map bypasses ownership ledger"
                            )
                            need(
                                name ~= "unmapPages"
                                or owner == pages.exports.unmapOwned
                                or owner == pages.exports.releaseEntry
                                or owner == pages.exports.releaseshared,
                                "raw unmap bypasses status capture"
                            )
                        else
                            local wrapper = unit.ownerModule(owner, "nupp.runtime.core.servicescope")
                            local target = need(wrapper.exports[name], "missing exact OS wrapper")
                            edge(item, target)
                            item.scoped = true
                            state.calls[node] = {owner = owner, target = target, os = bound}
                        end
                    elseif nativeos.isForeign(node) then
                        -- A foreign call is the C call itself (nativeos.foreign):
                        -- it neither collects nor raises and needs no scope.
                        local _ = nativeos.foreign(owner, node, nil)
                    elseif moduleName == "nupp.runtime.vm.intrinsics" then
                        local checked = unit.intrinsicDeclaration(owner, node)
                        local collects, mutates = require("nupp.compiler.vm.nativegraph").intrinsicHazards(checked.name)
                        state.intrinsics[
                            node
                        ] = {owner = owner, checked = checked, collects = collects, mutates = mutates}
                    elseif moduleName ~= "nupp.runtime.vm.intrinsics"
                        and moduleName ~= "nupp.runtime.vm.program"
                        and moduleName ~= "nupp.runtime.vm.slots"
                        and not unit.borrowFrom(owner, node)
                        and not unit.localConstructionChild(owner, node)
                    then
                        local token = node.obj.token or node.obj.name
                        local location = owner.scope.name
                            .. "."
                            .. owner.name
                            .. " at "
                            .. owner.scope.path
                            .. ":"
                            .. tostring(
                                token and token.line or 0
                            )
                        local ok, target = pcall(unit.callee, owner, node)
                        if not ok then
                            error(tostring(target) .. " [" .. location .. "]", 0)
                        end
                        need(target, "unresolved service call: " .. location)
                        edge(item, target)
                        state.calls[node] = {owner = owner, target = target}
                    end
                end
            end
            for _, t in ipairs(unit.cleanupTypes(owner, node)) do
                need(not item.raw, "explicit infrastructure has an affine cleanup")
                item.scoped, item.cleanup = true, true
                for _, cleanup in ipairs(t.cleanups) do
                    edge(item, unit.cleanupTarget(owner, node, t, cleanup))
                end
            end
        end
        cursor = cursor + 1
    end
    -- Reverse worklist computes the transitive scope closure once, including
    -- cycles; no repeated whole-owner scans and no blanket ABI extension.
    local queue = {}
    for _, item in ipairs(state.order) do
        if item.scoped then
            queue[#queue + 1] = item
        end
    end
    cursor = 1
    while cursor <= #queue do
        for caller in pairs(state.reverse[queue[cursor].owner]) do
            local item = state.owners[caller]
            if not item.scoped then
                need(not item.raw, "explicit infrastructure calls a hidden-scope service")
                item.scoped = true
                queue[#queue + 1] = item
            end
        end
        cursor = cursor + 1
    end
    for _, item in ipairs(state.order) do
        local count = #item.owner.body.params
        -- A test build's handler takes its scope from its context, not a
        -- hidden parameter: the handler ABI is fixed.
        item.handler = item.owner.nativeABI == "handler" and unitModules[item.scope.name] == true
        need(
            count <= 8 and count + (item.scoped and not item.handler and 1 or 0) <= 8,
            "service INTERNAL parameter limit"
        )
        item.sourceCount = count
        item.scopeParameter = item.scoped and not item.handler and count + 1 or nil
    end
    local scope = unit.ownerModule(entry, "nupp.runtime.core.servicescope")
    local scopeType = need(scope.checkedExports.types.ServiceScope, "checked ServiceScope required")
    local context = unit.ownerContext(entry)
    state.layout = need(targetlayout.of(scopeType, context.target), "ServiceScope layout required")
    need(
        scopeType.byname.error.tag == "uint64"
        and state.layout.offsets.error % 8 == 0
        and state.layout.offsets.error <= state.layout.size - 8,
        "ServiceScope error field"
    )
    unit.finish(entry)
    for owner in pairs(state.owners) do
        local list = ownerCatalogs[owner] or {}
        list[#list + 1] = state
        ownerCatalogs[owner] = list
    end
    local result = {}
    catalogs[result] = state

    return result
end

export function options(catalog: any, owner: any): any
    local state = need(catalogs[catalog], "unissued service catalogue")
    local item = need(state.owners[owner], "owner outside service closure")
    held(item.signature)
    local result = unit.ownerOptions(owner, owner.nativeABI or "leaf")
    supplied[result] = item

    return result
end

export function signature(owner: any, opts: any): any
    local item = supplied[opts]
    if not item then
        return nil
    end
    need(held(item.signature).owner == owner, "service options owner differs")

    return item.signature
end

export function owner(sig: any): any
    return held(sig).owner
end

-- A Builder guard owns one collector handle, not its caller's stack storage.
-- This exact reviewed constructor/terminal is separate from Arena ownership.
export function builderownership(sig: any, holder: any, parameter: integer?): any
    if holder.scope.name ~= "nupp.runtime.core.corestrings" then
        return nil
    end
    local home = unit.ownerModule(holder, "nupp.runtime.core.corestrings")
    if holder ~= home.exports.open and holder ~= home.exports.close then
        return nil
    end
    local item = held(sig)
    need(item.owner == holder and item.scoped and not item.raw, "foreign Builder ownership signature")
    local builder = need(home.checkedExports.types.Builder, "checked Builder type is absent")
    local checked = item.checked
    if parameter ~= nil then
        need(holder == home.exports.close and parameter == 1 and #holder.body.params == 1, "Builder terminal differs")
        local node = holder.body.params[1]
        local annotation, bound = node.type.resolvedType, node.name.definition.type
        need(
            checked.params[1] == annotation
            and checked.paramModes[1] == "takes"
            and annotation.tag == "ptr"
            and annotation.elem == builder
            and bound.tag == "affine"
            and bound.inner == annotation
            and #bound.cleanups == 0
            and #checked.rets == 1
            and checked.rets[1].tag == "nil",
            "checked Builder terminal binding differs"
        )
        return bound
    end
    local result = holder.resultType
    need(
        holder == home.exports.open
        and #holder.body.params == 2
        and #checked.rets == 1
        and checked.rets[1] == result
        and result.tag == "affine"
        and result.inner == checked.params[2]
        and result.inner.tag == "ptr"
        and result.inner.elem == builder
        and #result.cleanups == 1
        and result.cleanups[1].kind == "function"
        and result.cleanups[1].functionType == home.exports.close.checkedSignature
        and unit.cleanupTarget(holder, holder.body.rets[1], result, result.cleanups[1]) == home.exports.close,
        "checked Builder acquisition differs"
    )

    return result
end

export function builderacquisition(caller: any, node: any, target: any, index: integer): boolean
    if target.scope.name ~= "nupp.runtime.core.corestrings" or target.name ~= "open" or index ~= 2 then
        return false
    end
    unit.call(caller, node, target)

    return target == unit.ownerModule(caller, "nupp.runtime.core.corestrings").exports.open
end

const BUILDER_PROOF_LIMIT: integer = 1000

local function builderinterval(g: any, stop: any, boundary: integer, register: any): nil
    local rows = {}
    for _, block in ipairs(g.blocks) do
        for at, op in ipairs(block.op) do
            local call = op == "NativeLeafCall" and calls[block.args[at][1]]
            if call and call.target.owner == register then
                rows[#rows + 1] = {block = block, at = at}
            end
        end
    end
    need(#rows == 1, "Builder acquisition needs exactly one independent handle registration")
    local row = rows[1]
    local active, work = {}, 0
    local visit: function(any, boolean): nil
    visit = function(block, acquired)
        work = work + 1
        need(work <= BUILDER_PROOF_LIMIT and not active[block], "Builder acquisition proof is cyclic")
        active[block] = true
        local limit = block == stop and boundary or #block.op
        for at = 1, limit do
            if block == row.block and at == row.at then
                need(not acquired, "Builder handle registration repeated")
                acquired = true
            elseif acquired then
                need(block.op[at] ~= "NativeLeafCall", "Builder publication calls after handle acquisition")
            end
        end
        if block == stop then
            need(acquired, "Builder success bypasses handle registration")
        else
            for _, edge in ipairs(block.term and block.term.edges or {}) do
                visit(g.blocks[edge.target], acquired)
            end
        end
        active[block] = nil
    end
    visit(g.blocks[1], false)
end

local builderplans: any = setmetatable({}, {__mode = "k"})

export function isbuilderreturn(proof: any): boolean
    return builderplans[proof] ~= nil
end

export function validatebuilderreturn(proof: any, holder: any, source: any, node: any): any
    local plan = need(builderplans[proof], "unissued Builder return plan")
    need(
        next(proof) == nil
        and getmetatable(proof) == nil
        and plan.item.owner == holder
        and plan.source == source
        and plan.node == node,
        "Builder return identity differs"
    )
    local result = builderownership(plan.item.signature, holder)
    unit.occurrence(holder, node)
    need(
        node.exprs[1] == plan.expression
        and plan.expression.kind == "name"
        and plan.expression.token.definition == holder.parameterDefinitions[2]
        and source.checkedType == result.inner,
        "Builder guard must return its borrowed stack descriptor"
    )

    if plan.view then
        local found = nil
        for _, block in ipairs(plan.graph.blocks) do
            for at, op in ipairs(block.op) do
                if op == "NativePointerView" and block.args[at][2] == plan.view then
                    need(found == nil and block.args[at][1] == 2, "Builder staged formal source changed")
                    found = {block = block, at = at}
                end
            end
        end
        need(found ~= nil, "Builder ownership publication disappeared")
        builderinterval(plan.graph, found.block, (found.at as integer) - 1, plan.register)
    end

    return result
end

export function validatebuildervalue(proof: any, holder: any, descriptor: any): boolean
    local plan = need(builderplans[proof], "unissued Builder creation origin")
    validatebuilderreturn(proof, holder, plan.source, plan.node)
    need(
        plan.view and require("nupp.compiler.vm.nativephysical").same(plan.view.target, descriptor),
        "Builder creation value differs"
    )

    return true
end

local function builderreturn(ctx: any, node: any, source: any, value: integer): any
    local item = graphs[ctx.g]
    local result = builderownership(item.signature, item.owner)
    need(
        result and value == 2 and node.kind == "returnStmt" and #node.exprs == 1,
        "Builder return requires the exact second formal"
    )
    local register = unit.ownerModule(item.owner, "nupp.runtime.vm.collector").exports.handleRegister
    builderinterval(ctx.g, ctx.block, #ctx.block.op, register)
    local proof = {}
    builderplans[
        proof
    ] = {item = item, source = source, node = node, expression = node.exprs[1], graph = ctx.g, register = register}
    validatebuilderreturn(proof, item.owner, source, node)

    return proof
end

export function buildercleanup(g: any, declaration: any, actual: any?): boolean
    local call = calls[declaration]
    if not call
        or not call.cleanup
        or call.target.owner.scope.name ~= "nupp.runtime.core.corestrings"
        or call.target.owner.name ~= "close"
    then
        return false
    end
    local holder = call.caller.owner
    local acquisition = call.acquisition or call.node
    local home = unit.ownerModule(holder, "nupp.runtime.core.corestrings")
    need(
        graphs[g] == call.caller
        and call.target.owner == home.exports.close
        and acquisition.kind == "call"
        and unit.callee(holder, acquisition) == home.exports.open,
        "Builder cleanup requires its exact acquisition"
    )
    if call.acquisition then
        need(
            call.owner
            and call.node.kind == "localStmt"
            and call.owner.expr == acquisition
            and call.node.exprs[call.owner.index] == acquisition
            and call.owner.type == call.cleanupType
            and require("nupp.compiler.vm.functioncleanup").localOwner(call.node, call.owner.index) == call.owner,
            "Builder cleanup lost its lexical owner"
        )
    end
    local opened = call.caller.state.owners[home.exports.open]
    need(
        call.cleanupType == unit.checkedOccurrenceType(holder, acquisition)
        and call.cleanupType == builderownership(opened.signature, home.exports.open)
        and unit.cleanupTarget(holder, call.node, call.cleanupType, call.cleanup) == home.exports.close,
        "Builder cleanup registration differs"
    )
    validateIssued(declaration)
    if actual then
        require(
            "nupp.compiler.vm.nativephysical"
        ).buildercleanupoperand(holder, actual, acquisition, declaration.physical)
    end

    return true
end

-- Signature evidence only. The fixed reviewed service unit supplies these
-- exact owners and the checker's actual Arena/terminal identities. This query
-- grants no pointer conversion, takes-call permission or return root plan.
export function arenaOwnership(sig: any, holder: any, parameter: integer?): any
    local item = held(sig)
    need(item.owner == holder and item.scoped and not item.raw, "foreign arena ownership signature")
    local home = unit.ownerModule(holder, "nupp.runtime.vm.arena")
    need(holder.scope == home, "arena ownership requires the reviewed arena module")
    local arenaType = need(home.checkedExports.types.Arena, "checked Arena type is absent")
    local close = need(home.exports.close, "checked Arena terminal is absent")
    local closeItem = need(item.state.owners[close], "Arena terminal is outside the service closure")
    held(closeItem.signature)
    local checked = item.checked
    if parameter ~= nil then
        need(
            holder == close
            and parameter == 1
            and #holder.body.params == 1
            and #checked.rets == 1
            and checked.rets[1].tag == "nil",
            "only the exact Arena terminal takes boundary is supported"
        )
        local node = holder.body.params[1]
        local annotation, bound = node.type.resolvedType, node.name.definition.type
        need(
            checked.params[1] == annotation
            and checked.paramPack.head[1] == annotation
            and checked.paramModes[1] == "takes"
            and checked.paramPack.modes[1] == "takes"
            and node.modeTok
            and node.modeTok.text == "takes"
            and annotation.tag == "ptr"
            and annotation.elem == arenaType
            and bound.tag == "affine"
            and bound.inner == annotation
            and #(bound.cleanups or {}) == 0,
            "checked Arena takes binding differs"
        )
        return bound
    end
    need(
        holder == home.exports.open or holder == home.exports.openGrowable or holder == home.functions.openWith,
        "only the reviewed Arena constructors return ownership"
    )
    local result = holder.resultType
    need(
        #checked.rets == 1
        and checked.rets[1] == result
        and checked.retPack.head[1] == result
        and checked.retPack.modes[1] == "plain"
        and checked.borrowsParam == nil
        and checked.borrowsResult == nil
        and result.tag == "affine"
        and result.inner.tag == "ptr"
        and result.inner.elem == arenaType
        and #result.cleanups == 1,
        "checked Arena owner result differs"
    )
    local terminal = result.cleanups[1]
    need(
        terminal.kind == "function" and terminal.functionType == close.checkedSignature,
        "Arena result terminal signature differs"
    )
    -- Consume the sealed annotation/declaration bridge, never a matching name
    -- or the distinct cleanup registration record's table identity.
    need(
        unit.cleanupTarget(holder, holder.body.rets[1], result, terminal) == close,
        "Arena result lacks the exact checked terminal registration"
    )

    return result
end

-- These reviewed records borrow raw storage from an Arena, Pool, or Heap metadata.
-- Heap metadata is arena-backed; managed Header allocations are excluded.
-- This query identifies the backing contract, not a rooted managed value.
export function dependentReturn(sig: any, holder: any): any
    local item = held(sig)
    need(item.owner == holder and not item.raw, "foreign dependent return signature")
    local arena = unit.ownerModule(holder, "nupp.runtime.vm.arena")
    local heap = unit.ownerModule(holder, "nupp.runtime.vm.heap")
    local metadata = holder == heap.exports.classAt
    local builderHome = holder.scope.name == "nupp.runtime.core.corestrings"
        and unit.ownerModule(holder, "nupp.runtime.core.corestrings")
        or nil
    local builderMetadata = builderHome and holder == builderHome.exports.descriptor
    need(item.scoped or metadata or builderMetadata, "foreign dependent return signature")
    local backing
    if holder == arena.exports.alloc or holder == arena.exports.pool then
        backing = arena.checkedExports.types.Arena
    elseif holder == arena.exports.take then
        backing = arena.checkedExports.types.Pool
    elseif holder == heap.functions.zeroWords
        or holder == heap.functions.zeroSet
        or holder == heap.functions.zeroIndex
        or holder == heap.exports.create
    then
        backing = arena.checkedExports.types.Arena
    elseif builderMetadata then
        backing = builderHome.checkedExports.types.Builder
        local common = unit.ownerModule(holder, "nupp.runtime.core.storage")
        local result = holder.resultType
        need(
            result.tag == "borrowed"
            and result.inner.tag == "ptr"
            and result.inner.elem == common.checkedExports.types.Storage,
            "Builder descriptor result declaration differs"
        )
    elseif metadata then
        backing = heap.checkedExports.types.Heap
        local result = holder.resultType
        need(
            result.tag == "borrowed"
            and result.inner.tag == "ptr"
            and result.inner.elem == heap.checkedExports.types.SizeClass,
            "dependent metadata result declaration differs"
        )
    end
    -- A test build borrows from whatever its first parameter points at; the
    -- declaration check below still holds it to one borrowed pointer.
    if backing == nil and item.state.review and item.state.review.unreviewed then
        local first = holder.body.params[1]
        local declared = first and first.type and first.type.resolvedType
        backing = declared and declared.tag == "ptr" and declared.elem or nil
    end
    need(backing ~= nil, "dependent return is outside reviewed Arena/Pool storage")
    local checked, parameter = item.checked, holder.body.params[1]
    local annotation = parameter and parameter.type.resolvedType
    need(
        item.body.effectSummary == item.effect
        and checked.borrowsParam == 1
        and checked.borrowsResult == 1
        and checked.paramModes[1] == "borrows"
        and checked.paramPack.modes[1] == "borrows"
        and annotation
        and annotation.tag == "ptr"
        and annotation.elem == backing
        and parameter.name.definition == holder.parameterDefinitions[1]
        and checked.rets[1] == holder.resultType,
        "dependent return backing declaration differs"
    )

    return holder.resultType
end

-- A pending INTERNAL result obligation, distinct from an Arena borrow.
-- Recognizing the exact allocator does not authorize an executable entry.
export function managedResult(sig: any, holder: any): any
    local item = held(sig)
    need(item.owner == holder, "managed result owner differs")
    if item.scope.name ~= "nupp.runtime.vm.heap" and item.scope.name ~= "nupp.runtime.vm.collector" then
        return nil
    end
    local heap = unit.ownerModule(holder, "nupp.runtime.vm.heap")
    local collector = unit.ownerModule(holder, "nupp.runtime.vm.collector")
    if holder ~= heap.exports.allocRaw and holder ~= collector.exports.allocate then
        return nil
    end
    local checked, result = item.checked, holder.resultType
    local parameter = holder.body.params[1]
    local mode, bound = checked.paramModes[1], parameter.name.definition.type
    need(
        item.scoped
        and not item.raw
        and #holder.body.params == 3
        and checked.borrowsParam == nil
        and checked.borrowsResult == nil
        and #checked.rets == 1
        and checked.rets[1] == result
        and checked.retPack.head[1] == result
        and checked.retPack.modes[1] == "plain"
        and result.tag == "ptr"
        and result.elem == heap.checkedExports.types.Header
        and checked.params[1].tag == "ptr"
        and checked.params[1].elem == heap.checkedExports.types.Heap
        and checked.paramPack.modes[1] == mode
        and parameter.modeTok == nil
        and parameter.type.resolvedType == checked.params[1]
        and holder.parameterAnnotations[1] == checked.params[1]
        and holder.parameterDefinitions[1] == parameter.name.definition
        and holder.parameterTypes[1] == bound
        and (
            mode == "plain" and bound == checked.params[1]
            or mode == "borrows" and bound.tag == "borrowed" and bound.inner == checked.params[1]
        )
        and checked.params[2].tag == "uint64"
        and checked.params[3].tag == "uint64"
        and checked.paramModes[2] == "plain"
        and checked.paramModes[3] == "plain"
        and holder.body.effectSummary == item.effect,
        "managed allocator checked signature differs"
    )
    local proof = item.managedResult
    if not proof then
        proof = {}
        item.managedResult = proof
        managedResults[proof] = item
    end
    need(next(proof) == nil and getmetatable(proof) == nil, "managed result obligation changed")

    return proof
end

export function validateManagedResult(proof: any, holder: any): any
    local item = need(managedResults[proof], "unissued managed result obligation")
    need(managedResult(item.signature, holder) == proof, "managed result obligation owner changed")
    return holder.resultType
end

-- This is a pending use of the entry-owned Heap, not a plain-pointer view
-- or a nonescape claim. Root publication retains the Heap address until close;
-- only the closed entry's lifetime proof may discharge this obligation.
local function heapUseEvidence(sig: any, caller: any, node: any, index: integer): any
    local target = held(sig)
    if not caller or not node or index ~= 1 then
        return nil
    end
    local state = target.state
    local call = state.calls[node]
    if not call or call.owner ~= caller or call.target ~= target.owner or call.os or call.raising then
        return nil
    end
    local argument = node.args.exprs[index]
    local expected = target.checked.params[index]
    local actual = argument and argument.inferredType
    if target.checked.paramModes[index] ~= "plain" or not actual or actual.tag ~= "borrowed" then
        return nil
    end
    if caller.scope.name ~= "nupp.runtime.core.cellservice" and caller.scope.name ~= "nupp.runtime.core.heapentry" then
        return nil
    end
    local cell = unit.ownerModule(caller, "nupp.runtime.core.cellservice")
    local entry = unit.ownerModule(caller, "nupp.runtime.core.heapentry")
    local heap = unit.ownerModule(caller, "nupp.runtime.vm.heap")
    local collector = unit.ownerModule(caller, "nupp.runtime.vm.collector")
    local permitted = caller == cell.exports.construct
        and (target.owner == collector.exports.allocate or target.owner == collector.exports.initialized)
        or caller == cell.functions.validInput and target.owner == heap.exports.isLiveSlot
        or caller == entry.exports.run
        and (
            target.owner == collector.exports.fullCycle
            or target.owner == heap.exports.isLiveSlot
            or target.owner == heap.exports.destroy
        )
    if not permitted then
        return nil
    end
    need(
        expected.tag == "ptr"
        and expected.elem == heap.checkedExports.types.Heap
        and actual.inner == expected
        and argument.kind == "name"
        and argument.token.definition,
        "Heap call requires the original checked borrowed Heap"
    )
    need(
        node.unsafeOwnershipOperation == "borrowed pointer passed to a plain parameter",
        "Heap call requires its checked unsafe source relation"
    )
    unit.call(caller, node, target.owner)
    unit.occurrence(caller, argument)

    return {
        target = target,
        caller = caller,
        node = node,
        argument = argument,
        definition = argument.token.definition,
        checked = actual,
        marker = node.unsafeOwnershipOperation
    }
end

export function heapCallUse(sig: any, caller: any, node: any, index: integer): any
    local evidence = heapUseEvidence(sig, caller, node, index)
    if not evidence then
        return nil
    end
    local proof = {}
    evidence.signature, evidence.index = sig, index
    heapUses[proof] = evidence

    return proof
end

export function validateHeapCallUse(proof: any, sig: any, caller: any, node: any, index: integer): any
    local saved = need(heapUses[proof], "unissued Heap call-use obligation")
    need(
        next(proof) == nil
        and getmetatable(proof) == nil
        and saved.signature == sig
        and saved.caller == caller
        and saved.node == node
        and saved.index == index,
        "Heap call-use identity changed"
    )
    local current = need(heapUseEvidence(sig, caller, node, index), "Heap call-use source relation changed")
    need(
        current.target == saved.target
        and current.argument == saved.argument
        and current.definition == saved.definition
        and current.checked == saved.checked
        and current.marker == saved.marker,
        "Heap call-use checked evidence changed"
    )

    return saved.argument
end

-- Detached queries expose checked identities, never an issuance interface.
export function operation(g: any, declaration: any): any
    local call = need(calls[declaration], "unissued service operation")
    need(graphs[g] == call.caller, "service operation graph differs")
    local target = recordTarget(g, declaration, call.node)
    return {node = call.node, target = target, owner = call.caller.owner}
end

export function managedCall(g: any, declaration: any): any
    local opname = operation(g, declaration)
    local call = calls[declaration]
    local proof = managedResult(call.target.signature, call.target.owner)
    if not proof then
        return nil
    end

    return {
        owner = opname.owner,
        node = opname.node,
        target = opname.target,
        proof = proof,
        heap = 1,
        kind = 2,
        extent = 3
    }
end

export function cellRoles(g: any): any
    local item = need(graphs[g], "rooted cell requires an issued service graph")
    if item.scope.name ~= "nupp.runtime.core.cellservice" then
        return nil
    end
    local cell = unit.ownerModule(item.owner, "nupp.runtime.core.cellservice")
    if item.owner ~= cell.exports.construct then
        return nil
    end
    local roots = unit.ownerModule(item.owner, "nupp.runtime.core.frameroots")
    local heap = unit.ownerModule(item.owner, "nupp.runtime.vm.heap")
    local collector = unit.ownerModule(item.owner, "nupp.runtime.vm.collector")
    local objects = unit.ownerModule(item.owner, "nupp.runtime.vm.objectconstruct")
    local scope = unit.ownerModule(item.owner, "nupp.runtime.core.servicescope")
    local values = unit.ownerModule(item.owner, "nupp.runtime.vm.values")

    return {
        validInput = cell.functions.validInput,
        retain = scope.exports.retain,
        serviceScopeType = scope.checkedExports.types.ServiceScope,
        headerType = heap.checkedExports.types.Header,
        kindCell = heap.exportedConstants.KIND_CELL,
        payloadMask = values.exportedConstants.PAYLOAD,
        owner = item.owner,
        publish = roots.exports.publish,
        storeResult = roots.exports.storeResult,
        allocate = collector.exports.allocate,
        allocRaw = heap.exports.allocRaw,
        cellInitialize = objects.exports.cellInitialize,
        initialized = collector.exports.initialized,
        objectValue = heap.exports.objectValue,
        isLiveSlot = heap.exports.isLiveSlot,
        heapType = heap.checkedExports.types.Heap,
        scopeType = roots.checkedExports.types.Scope,
        resultType = roots.checkedExports.types.Result,
        cellType = heap.checkedExports.types.CellBody
    }
end

-- Exact entry identities are evidence for a separate proof, not authority.
export function entryRoles(g: any): any
    local item = need(graphs[g], "heap entry requires an issued service graph")
    if item.scope.name ~= "nupp.runtime.core.heapentry" then
        return nil
    end
    local entry = unit.ownerModule(item.owner, "nupp.runtime.core.heapentry")
    if item.owner ~= entry.exports.run then
        return nil
    end
    local arena = unit.ownerModule(item.owner, "nupp.runtime.vm.arena")
    local heap = unit.ownerModule(item.owner, "nupp.runtime.vm.heap")
    local collector = unit.ownerModule(item.owner, "nupp.runtime.vm.collector")
    local cell = unit.ownerModule(item.owner, "nupp.runtime.core.cellservice")
    local roots = unit.ownerModule(item.owner, "nupp.runtime.core.frameroots")
    local rootentry = unit.ownerModule(item.owner, "nupp.runtime.core.rootentry")
    local frames = unit.ownerModule(item.owner, "nupp.runtime.core.frames")
    local scope = unit.ownerModule(item.owner, "nupp.runtime.core.servicescope")
    local pages = unit.ownerModule(item.owner, "nupp.runtime.core.pagemappings")
    local values = unit.ownerModule(item.owner, "nupp.runtime.vm.values")

    return {
        owner = item.owner,
        open = arena.exports.open,
        close = arena.exports.close,
        pagesInitialize = pages.exports.initialize,
        scopeInitialize = scope.exports.initialize,
        pagesAcquireEntry = pages.exports.acquireEntry,
        pagesReleaseEntry = pages.exports.releaseEntry,
        scopeClose = scope.exports.close,
        create = heap.exports.create,
        destroy = heap.exports.destroy,
        fullCycle = collector.exports.fullCycle,
        isLiveSlot = heap.exports.isLiveSlot,
        construct = cell.exports.construct,
        publish = roots.exports.publish,
        closeRoots = roots.exports.close,
        start = rootentry.exports.start,
        complete = rootentry.exports.complete,
        finishRoot = frames.exports.finishRoot,
        retain = scope.exports.retain,
        bindingType = entry.checkedExports.types.Binding,
        storageType = entry.checkedExports.types.Storage,
        frameType = frames.checkedExports.types.Frame,
        nilValue = values.exportedConstants.NIL,
        heapType = heap.checkedExports.types.Heap,
        serviceScopeType = scope.checkedExports.types.ServiceScope
    }
end

-- A caller may inspect provisional graphs, but cannot select an allocator as
-- an executable entry. The rooted factory separately validates its full closure.
export function requireUnmanagedEntry(g: any): nil
    local item = graphs[g]
    if item then
        need(
            managedResult(item.signature, item.owner) == nil,
            "managed allocator requires a rooted caller; standalone entry refused"
        )
        for _, block in ipairs(g.blocks) do
            for index, op in ipairs(block.op) do
                if op == "NativeLeafCall" then
                    need(
                        managedCall(g, block.args[index][1]) == nil and not hasPublication(g, block.args[index][1]),
                        "managed call requires rooted executable publication"
                    )
                end
            end
        end
    end
end

export function sourceCount(sig: any): integer
    return held(sig).sourceCount
end

export function parameters(sig: any, source: any): any
    local item = held(sig)
    need(#source == item.sourceCount, "service checked source parameter count")
    local result = {}
    for index, kind in ipairs(source) do
        result[index] = kind
    end
    if item.scopeParameter then
        result[#result + 1] = "voidptr"
    end

    return result
end

export function attach(g: any, sig: any): nil
    local item = held(sig)
    need(g.nparams == item.sourceCount + (item.scopeParameter and 1 or 0), "service graph parameter count")
    g.nativeService, graphs[g] = sig, item
end

export function verify(g: any): nil
    if not g.nativeService then
        need(graphs[g] == nil, "service graph lost contract");
        return
    end
    local item = held(g.nativeService)
    need(
        graphs[g] == item
        and (g.native.abi == "leaf" or g.native.abi == "handler" and unitModules[item.scope.name])
        and g.nparams == item.sourceCount + (item.scopeParameter and 1 or 0),
        "service graph identity differs"
    )
    if item.scopeParameter then
        need(g.native.params[item.scopeParameter] == "voidptr", "scope ABI differs")
    end
    if g.source then
        need(
            g.source.path == item.scope.path
            and g.source.module == item.scope.name
            and g.source.name == item.owner.name,
            "service graph source differs"
        )
    end
end

export function entryBindings(ctx: any, node: any?): nil
    local item = graphs[ctx.g]
    if item and item.scoped and item.handler then
        -- The handler's context (its fifth parameter) holds the entry's scope.
        local constants = unit.ownerModule(item.owner, "nupp.runtime.core.context").exportedConstants
        local at = need(tonumber(constants.SERVICE_SCOPE), "context lacks SERVICE_SCOPE")
        local site = node or item.owner.node
        local offset = ctx.emit(site, "NativeConstant", {tostring(at)}, "int64")
        local access = {source = "live", kind = "voidptr", width = 8, signed = false, write = false}
        ctx.bind(item.key, ctx.emit(site, "NativeLoad", {5, offset, access}, "voidptr"))
    elseif item and item.scoped then
        ctx.bind(item.key, item.scopeParameter)
    end
end

export function scope(ctx: any): integer
    local item = need(graphs[ctx.g], "service graph required")
    need(item.scoped, "service has no scope operand")
    return ctx.storage(item.key)
end

export function target(ctx: any, node: any): any
    local item = graphs[ctx.g]
    if not item then
        return nil
    end
    local call = item.state.calls[node]
    if not call then
        return nil
    end
    need(call.owner == ctx.fn, "service call owner differs")
    unit.occurrence(ctx.fn, node)
    if call.raising then
        need(unit.literalRaise(ctx.fn, node) ~= nil, "checked literal raise changed")
    elseif call.os then
        local actual = unit.osDeclaration(ctx.fn, node)
        need(
            actual.definition == call.os.definition and actual.signature == call.os.signature,
            "redirected OS identity changed"
        )
    else
        unit.call(ctx.fn, node, call.target)
    end

    return call.target
end

export function calleeSignature(ctx: any, node: any, dest: any): any
    local item = graphs[ctx.g]
    if not item then
        return nil
    end
    need(target(ctx, node) == dest, "callee outside service closure")

    return item.state.owners[dest].signature
end

export function redirect(ctx: any, node: any): boolean
    local item = graphs[ctx.g]
    return item ~= nil and item.state.calls[node] ~= nil and item.state.calls[node].os ~= nil
end

export function sourceParameters(ctx: any, node: any, declaration: any): any
    local item = graphs[ctx.g]
    if not item then
        return declaration.params
    end
    local dest = held(declaration.service)
    local first = redirect(ctx, node) and 2 or 1
    local result = {}
    for index = first, dest.sourceCount do
        result[#result + 1] = declaration.params[index]
    end

    return result
end

export function declaration(ctx: any, node: any, dest: any, declaration: any): any
    local item = graphs[ctx.g]
    if not item then
        return declaration
    end
    need(target(ctx, node) == dest, "call outside service catalogue")
    local callee = item.state.owners[dest]
    local sig = callee.signature
    need(declaration.service == sig, "callee service ABI differs")
    calls[
        declaration
    ] = {
        caller = item,
        target = callee,
        node = node,
        os = item.state.calls[node].os,
        raising = item.state.calls[node].raising,
        params = declaration.params,
        kinds = {},
        result = declaration.result
    }
    for index, kind in ipairs(declaration.params) do
        calls[declaration].kinds[index] = kind
    end
    calls[declaration].fields = {}
    for key, value in pairs(declaration) do
        calls[declaration].fields[key] = value
    end

    return declaration
end

-- Retained root publication is a pending lifetime obligation, never a
-- borrowed-to-plain conversion. Only the closed entry proof can discharge it.
local function publicationEvidence(call: any): any
    local holder = call.caller.owner
    if holder.scope.name ~= "nupp.runtime.core.heapentry" and holder.scope.name ~= "nupp.runtime.core.cellservice" then
        return nil
    end
    local entry = unit.ownerModule(holder, "nupp.runtime.core.heapentry")
    local cell = unit.ownerModule(holder, "nupp.runtime.core.cellservice")
    local roots = unit.ownerModule(holder, "nupp.runtime.core.frameroots")
    if (holder ~= entry.exports.run and holder ~= cell.exports.construct)
        or call.target.owner ~= roots.exports.publish
        or call.cleanup
        or call.os
        or call.raising
    then
        return nil
    end
    local source = call.caller.state.calls[call.node]
    need(
        source and source.owner == holder and source.target == roots.exports.publish,
        "publication requires its original checked call"
    )
    unit.call(holder, call.node, roots.exports.publish)
    local expression = call.node.args.exprs[2]
    unit.occurrence(holder, expression)
    local heap = unit.ownerModule(holder, "nupp.runtime.vm.heap")
    need(
        expression.kind == "castExpr"
        and expression.expr.kind == "name"
        and expression.expr.token.definition
        and expression.type ~= nil,
        "publication requires its original Heap address cast"
    )
    local checked = expression.expr.inferredType
    local result = expression.inferredType
    need(
        checked.tag == "borrowed"
        and checked.inner.tag == "ptr"
        and checked.inner.elem == heap.checkedExports.types.Heap
        and result.tag == "borrowed"
        and result.inner.tag == "voidptr"
        and call.target.checked.params[2].tag == "voidptr",
        "publication checked Heap dependency differs"
    )

    return {
        expression = expression,
        annotation = expression.type,
        name = expression.expr,
        definition = expression.expr.token.definition,
        checked = checked,
        result = result
    }
end

local function publicationSource(g: any, decl: any): any
    local call = need(calls[decl], "unissued publication declaration")
    need(graphs[g] == call.caller, "publication graph owner differs")
    validateIssued(decl)
    local evidence = publicationEvidence(call)
    if not evidence then
        need(call.publication == nil, "publication source changed")
        return nil
    end
    local saved = need(call.publication, "publication lacks its emitted Heap binding")
    need(
        saved.graph == g
        and saved.expression == evidence.expression
        and saved.annotation == evidence.annotation
        and saved.name == evidence.name
        and saved.definition == evidence.definition
        and saved.checked == evidence.checked
        and saved.result == evidence.result,
        "publication checked source changed"
    )

    return saved
end

-- Follow only actual SSA transport to the original cast row. Every reachable
-- phi must have an anchored path; a disconnected phi cycle is not evidence.
local function publicationReaches(g: any, value: integer, row: any): boolean
    local pending, seen, inputs, anchored = {value}, {}, {}, {}
    local cursor: integer = 1
    while cursor <= #pending do
        local current = pending[cursor]
        cursor = cursor + 1
        if not seen[current] then
            seen[current] = true
            local found = false
            for _, block in ipairs(g.blocks) do
                for index, dst in ipairs(block.dst) do
                    if dst == current then
                        if block.op[index] ~= "NativePointerView" or block.args[index] ~= row then
                            return false
                        end
                        anchored[current], found = true, true
                    end
                end
                for index, parameter in ipairs(block.params) do
                    if parameter == current then
                        local incoming = {}
                        for _, prior in ipairs(g.blocks) do
                            for _, edge in ipairs(prior.term and prior.term.edges or {}) do
                                if edge.target == block.id then
                                    incoming[#incoming + 1] = edge.args[index]
                                    pending[#pending + 1] = edge.args[index]
                                end
                            end
                        end
                        if #incoming == 0 then
                            return false
                        end
                        inputs[current], found = incoming, true
                    end
                end
            end
            if not found then
                return false
            end
        end
    end
    local changed = true
    while changed do
        changed = false
        for current, incoming in pairs(inputs) do
            if not anchored[current] then
                for _, prior in ipairs(incoming) do
                    if anchored[prior] then
                        anchored[current], changed = true, true
                    end
                end
            end
        end
    end
    for current in pairs(seen) do
        if not anchored[current] then
            return false
        end
    end

    return true
end

local function bindPublication(ctx: any, decl: any, values: any): nil
    local call = calls[decl]
    local evidence = publicationEvidence(call)
    if not evidence then
        return
    end
    need(call.publication == nil, "publication binding cannot be reissued")
    local physical = require("nupp.compiler.vm.nativephysical")
    local actual = need(ctx.g.nativePhysical.values[values[2]], "publication lost its Heap descriptor")
    local row
    for _, block in ipairs(ctx.g.blocks) do
        for index, op in ipairs(block.op) do
            local args = block.args[index]
            if op == "NativePointerView" and args[2].node == evidence.expression then
                need(row == nil, "publication cast is not unique")
                row = args
            end
        end
    end
    need(row ~= nil, "publication lacks its original cast operation")
    physical.validateCast(row[2])
    need(
        row[2].source.checkedType == evidence.checked
        and row[2].target.checkedType == evidence.result
        and physical.sameValue(row[2].target, actual)
        and physical.dependent(actual),
        "publication cast lost its Heap dependency"
    )
    evidence.graph, evidence.row, evidence.view, evidence.actual = ctx.g, row, row[2], actual
    call.publication = evidence
end

export function hasPublication(g: any, decl: any): boolean
    return publicationSource(g, decl) ~= nil
end

export function publicationArgument(g: any, decl: any, index: integer, value: integer): boolean
    if index ~= 2 then
        return false
    end
    local saved = publicationSource(g, decl)
    if not saved then
        return false
    end
    local physical = require("nupp.compiler.vm.nativephysical")
    physical.validateCast(saved.view)
    local actual = g.nativePhysical and g.nativePhysical.values[value]
    need(
        saved.row[2] == saved.view
        and saved.view.node == saved.expression
        and saved.view.source.checkedType == saved.checked
        and saved.view.target.checkedType == saved.result
        and actual
        and physical.sameValue(saved.actual, actual)
        and physical.dependent(actual),
        "publication Heap descriptor changed"
    )
    need(publicationReaches(g, value, saved.row), "publication Heap SSA lineage changed")

    return true
end

export function operands(ctx: any, decl: any, values: any): any
    local call = calls[decl]
    if not call then
        return values
    end
    need(call.caller == graphs[ctx.g], "foreign service call")
    if call.os then
        table.insert(values, 1, scope(ctx))
    end
    if call.target.scoped then
        values[#values + 1] = scope(ctx)
    end
    bindPublication(ctx, decl, values)

    return values
end

export function cleanupTarget(ctx: any, node: any, t: any, cleanup: any): any
    local item = need(graphs[ctx.g], "cleanup requires issued service graph")
    local dest = unit.cleanupTarget(ctx.fn, node, t, cleanup)
    need(item.state.owners[dest], "cleanup target outside complete service catalogue")
    return dest
end

export function cleanupSignature(ctx: any, node: any, t: any, cleanup: any): any
    local dest = cleanupTarget(ctx, node, t, cleanup)
    return graphs[ctx.g].state.owners[dest].signature
end

export function cleanupDeclaration(ctx: any, node: any, t: any, cleanup: any, decl: any, holder: any?): any
    local dest = cleanupTarget(ctx, node, t, cleanup)
    local caller, callee = graphs[ctx.g], graphs[ctx.g].state.owners[dest]
    need(decl.service == callee.signature and decl.result == "nil", "cleanup boundary differs")
    local record = {
        caller = caller,
        target = callee,
        node = node,
        cleanup = cleanup,
        cleanupType = t,
        params = decl.params,
        kinds = {},
        result = decl.result,
        fields = {}
    }
    for index, kind in ipairs(decl.params) do
        record.kinds[index] = kind
    end
    for key, value in pairs(decl) do
        record.fields[key] = value
    end
    if node.kind == "localStmt" then
        need(holder and holder.stat == node, "local cleanup requires its checked owner")
        need(
            require("nupp.compiler.vm.functioncleanup").localOwner(node, holder.index) == holder and holder.type == t,
            "local cleanup acquisition type differs"
        )
        unit.occurrence(ctx.fn, holder.expr)
        need(
            holder.expr.kind == "call" and unit.checkedOccurrenceType(ctx.fn, holder.expr) == t,
            "local cleanup requires its checked acquisition call"
        )
        record.owner = holder
        record.acquisition = holder.expr
    end
    calls[decl] = record

    return decl
end

export function layout(ctx: any): any
    local item = need(graphs[ctx.g], "service graph required")
    local offsets = {}
    for key, value in pairs(item.state.layout.offsets) do
        offsets[key] = value
    end

    return {size = item.state.layout.size, offsets = offsets}
end

export function needsCleanup(sig: any): boolean
    return held(sig).scoped
end

export function raise(ctx: any, node: any): any
    local item = graphs[ctx.g]
    local raising = item and item.state.raises[node]
    if not raising then
        return nil
    end
    need(
        raising.owner == ctx.fn and unit.literalRaise(ctx.fn, node).literal == raising.literal,
        "service literal raise differs"
    )

    return {owner = item.id, site = raising.site, target = item.state.calls[node].target}
end

-- Failure is an ABI exit, not an expression producing a success value.
-- The verifier independently requires an exact sticky-error fact on this path.
export function failure(ctx: any, node: any): nil
    local item = need(graphs[ctx.g], "failure requires an issued service graph")
    need(item.scoped and ctx.fn == item.owner and ctx.block, "failure outside scoped continuation")
    local term = {kind = "nativeFail", edges = {}, pos = ctx.position(node)}
    failures[term] = {graph = ctx.g, item = item, edges = term.edges, position = term.pos}
    ctx.block.term, ctx.block = term, nil
end

export function isFailure(g: any, term: any): boolean
    local saved = failures[term]
    if not saved then
        return false
    end
    need(
        saved.graph == g and graphs[g] == saved.item and held(saved.item.signature) == saved.item,
        "foreign service failure"
    )
    need(
        getmetatable(term) == nil
        and term.kind == "nativeFail"
        and term.edges == saved.edges
        and getmetatable(term.edges) == nil
        and next(term.edges) == nil
        and term.pos == saved.position,
        "service failure changed"
    )
    for key in pairs(term) do
        need(key == "kind" or key == "edges" or key == "pos", "failure carries a value")
    end

    return true
end

-- These records cover only the actual reviewed Arena constructor chain.
-- They are not a general graph seal or a raw pointer ownership registry.
local arenaRows: any = setmetatable({}, {__mode = "k"})
local arenaPlans: any = setmetatable({}, {__mode = "k"})

local function arenaHome(item: any): any
    if item.scope.name ~= "nupp.runtime.vm.arena" then
        return nil
    end
    local home = unit.ownerModule(item.owner, "nupp.runtime.vm.arena")
    if item.owner == home.exports.open
        or item.owner == home.exports.openGrowable
        or item.owner == home.functions.openWith
    then
        arenaOwnership(item.signature, item.owner)
        return home
    end

    return nil
end

-- Row identities survive prune; phi indices do not. Follow the actual incoming
-- values, refusing cycles, to obtain a stable witness for relevant store data.
local function arenaValueKey(g: any, value: integer, active: any?): string
    if value <= g.nparams then
        return "parameter:" .. tostring(value)
    end
    active = active or {}
    need(not active[value], "Arena constructor value has cyclic provenance")
    active[value] = true
    for _, block in ipairs(g.blocks) do
        for index, dst in ipairs(block.dst) do
            if dst == value then
                active[value] = nil
                return "operation:" .. tostring(block.id) .. ":" .. tostring(index)
            end
        end
        for index, parameter in ipairs(block.params) do
            if parameter == value then
                local parts = {"phi:" .. tostring(block.id)}
                for _, prior in ipairs(g.blocks) do
                    for at, edge in ipairs(prior.term and prior.term.edges or {}) do
                        if edge.target == block.id then
                            parts[
                                #parts + 1
                            ] = tostring(
                                prior.id
                            ) .. ":" .. tostring(at) .. "=" .. arenaValueKey(g, edge.args[index], active)
                        end
                    end
                end
                need(#parts > 1, "Arena constructor phi has no input")
                active[value] = nil
                return table.concat(parts, ";")
            end
        end
    end
    error("native service: Arena constructor value has no definition", 0)
end

-- Called only by the existing common profile's emission callback. Retain
-- source/row identity for the mapping and pointer chain, plus checked stores.
export function recordArena(ctx: any, node: any, op: string, args: any): nil
    local item = graphs[ctx.g]
    if not item then
        return
    end
    if item.managedResult then
        unit.occurrence(item.owner, node)
        local list = managedRows[ctx.g] or {}
        managedRows[ctx.g] = list
        local keys, fixed = {}, {}
        for index, value in ipairs(args) do
            if type(value) == "number" then
                keys[index] = arenaValueKey(ctx.g, value)
            else
                fixed[index] = value
            end
        end
        list[
            #list + 1
        ] = {
            node = node,
            checked = node.inferredType,
            block = ctx.block,
            at = #ctx.block.op,
            op = op,
            args = args,
            keys = keys,
            fixed = fixed,
            count = #args
        }
    end
    if not arenaHome(item) then
        return
    end
    unit.occurrence(item.owner, node)
    local rows = arenaRows[ctx.g] or {}
    arenaRows[ctx.g] = rows
    local record = {node = node, block = ctx.block, at = #ctx.block.op, op = op, args = args}
    if op == "NativeStore" and args[4].field then
        record.store = {arenaValueKey(ctx.g, args[1]), arenaValueKey(ctx.g, args[2]), arenaValueKey(ctx.g, args[3])}
        record.access = args[4].field
    end
    rows[#rows + 1] = record
end

local function arenaRow(g: any, node: any, op: string): any
    local found = nil
    for _, row in ipairs(arenaRows[g] or {}) do
        if row.node == node and row.op == op then
            need(found == nil, "Arena source operation lowered more than once")
            need(
                g.blocks[row.block.id] == row.block
                and row.block.op[row.at] == op
                and row.block.args[row.at] == row.args,
                "Arena source operation changed"
            )
            found = row
        end
    end

    return need(found, "Arena source operation is absent")
end

local function arenaInitializer(holder: any, expression: any): any
    need(
        expression.kind == "name" and expression.token.definition and not expression.token.definition.reassigned,
        "Arena return requires an unchanged checked binding"
    )
    local found = nil
    for _, node in ipairs(unit.occurrences(holder)) do
        if node.kind == "localStmt" then
            for index, name in ipairs(node.names) do
                if name.definition == expression.token.definition then
                    need(found == nil and #node.names == #node.exprs, "Arena initializer differs")
                    found = node.exprs[index]
                end
            end
        end
    end

    return need(found, "Arena initializer is absent")
end

-- Only this exact raw offset in the checked constructor gets a plain voidptr
-- sidecar. It confers no mapping, ownership, bounds or dereference permission.
export function arenaOffset(ctx: any, node: any, value: integer): nil
    local item = graphs[ctx.g]
    local home = item and arenaHome(item)
    if not home or item.owner ~= home.functions.openWith then
        return
    end
    unit.occurrence(item.owner, node)
    local moduleName, name = member(node.obj)
    if moduleName ~= "nupp.runtime.vm.intrinsics" or name ~= "offset" then
        return
    end
    local physical = require("nupp.compiler.vm.nativephysical")
    local descriptor = physical.describe(ctx.g.nativePhysical.context, node.inferredType)
    need(
        descriptor.storageType.tag == "voidptr" and #descriptor.ownership == 0 and not descriptor.nullable,
        "Arena offset must remain a plain checked pointer"
    )
    local row = arenaRow(ctx.g, node, "PointerOffset")
    need(row.block.dst[row.at] == value, "Arena offset result differs")
    row.offsetDescriptor, row.offsetType = descriptor, node.inferredType
    row.offsetOperands = {arenaValueKey(ctx.g, row.args[1]), arenaValueKey(ctx.g, row.args[2])}
    ctx.g.nativePhysical.values[value] = descriptor
end

-- Only the already emitted checked constructor offset may carry this raw
-- descriptor. This validates an origin; it grants no typed arithmetic rule.
export function arenaOffsetOrigin(g: any, args: any, value: integer): boolean
    local item = graphs[g]
    local home = item and arenaHome(item)
    if not home or item.owner ~= home.functions.openWith then
        return false
    end
    for _, row in ipairs(arenaRows[g] or {}) do
        if row.offsetDescriptor and row.args == args then
            arenaRow(g, row.node, "PointerOffset")
            unit.occurrence(item.owner, row.node)
            need(
                row.block.dst[row.at] == value
                and row.node.inferredType == row.offsetType
                and g.nativePhysical.values[value] == row.offsetDescriptor,
                "Arena offset source or descriptor changed"
            )
            require("nupp.compiler.vm.nativephysical").validate(row.offsetDescriptor)
            for index = 1, 2 do
                need(arenaValueKey(g, args[index]) == row.offsetOperands[index], "Arena offset operand changed")
            end
            return true
        end
    end

    return false
end

-- Relevant pointer/word operands may be transported through joins or a
-- checked representation view. Other computations cannot invent this origin.
local function arenaReaches(g: any, value: integer, row: any, word: boolean?, active: any?): boolean
    if value == row.block.dst[row.at] then
        return true
    end
    if value <= g.nparams then
        return false
    end
    active = active or {}
    if active[value] then
        return false
    end
    active[value] = true
    for _, block in ipairs(g.blocks) do
        for index, dst in ipairs(block.dst) do
            if dst == value then
                local op, args = block.op[index], block.args[index]
                if op == "NativePointerView" and not word then
                    local physical = require("nupp.compiler.vm.nativephysical")
                    physical.validateCast(args[2])
                    local mode = physical.viewKind(args[2])
                    if mode == "nonnull" or mode == "binding" or mode == nil then
                        local result = arenaReaches(g, args[1], row, word, active)
                        active[value] = nil
                        return result
                    end
                elseif op == "NativeWordCast" and word then
                    local result = arenaReaches(g, args[1], row, word, active)
                    active[value] = nil
                    return result
                end
                active[value] = nil
                return false
            end
        end
        for index, parameter in ipairs(block.params) do
            if parameter == value then
                local found = false
                for _, prior in ipairs(g.blocks) do
                    for _, edge in ipairs(prior.term and prior.term.edges or {}) do
                        if edge.target == block.id then
                            found = true
                            if not arenaReaches(g, edge.args[index], row, word, active) then
                                active[value] = nil
                                return false
                            end
                        end
                    end
                end
                active[value] = nil
                return found
            end
        end
    end
    active[value] = nil

    return false
end

local function arenaRecipe(ctx: any, node: any, source: any): any
    local item = need(graphs[ctx.g], "Arena return requires an issued service graph")
    local home = need(arenaHome(item), "owning return is outside reviewed Arena constructors")
    unit.occurrence(item.owner, node)
    need(node.kind == "returnStmt" and #node.exprs == 1, "Arena returns exactly one owner")
    local result = arenaOwnership(item.signature, item.owner)
    local expression = node.exprs[1]
    local recipe = {
        item = item,
        home = home,
        node = node,
        expression = expression,
        result = result,
        source = source,
        block = ctx.block,
        boundary = #ctx.block.op
    }
    if item.owner ~= home.functions.openWith then
        need(
            expression.kind == "call" and target(ctx, expression) == home.functions.openWith,
            "Arena forwarding requires the exact checked constructor call"
        )
        recipe.call = expression
        recipe.mode = "forward"
    else
        local cast = arenaInitializer(item.owner, expression)
        need(
            cast.kind == "castExpr" and cast.inferredType == result.inner and expression.inferredType == result.inner,
            "Arena construction pointer type differs"
        )
        local offset = cast.expr
        local moduleName, name = member(offset.obj)
        need(
            offset.kind == "call"
            and moduleName == "nupp.runtime.vm.intrinsics"
            and name == "offset"
            and #offset.args.exprs == 2,
            "Arena construction requires its checked pointer derivation"
        )
        local map = arenaInitializer(item.owner, offset.args.exprs[1])
        local mapping = item.state.calls[map]
        local region = unit.ownerModule(item.owner, "nupp.runtime.core.servicescope")
        need(
            mapping and mapping.os and mapping.target == region.exports.mapPages,
            "Arena construction lacks the exact retained mapping wrapper"
        )
        local index = offset.args.exprs[2]
        local indexModule, indexName = member(index.obj)
        need(
            index.kind == "call"
            and indexModule == "nupp.runtime.vm.intrinsics"
            and indexName == "index"
            and #index.args.exprs == 1,
            "Arena metadata offset projection differs"
        )
        local metadata = index.args.exprs[1]
        need(
            metadata.kind == "call" and unit.callee(item.owner, metadata) == home.functions.metadataOffset,
            "Arena metadata offset helper differs"
        )
        recipe.mode, recipe.cast, recipe.offset, recipe.map, recipe.metadata = "create", cast, offset, map, metadata
    end

    return recipe
end

-- Check only the lifetime interval from this acquisition to this staged
-- return. Failure-only branches may retire their mapping, but cannot rejoin.
local function arenaInterval(g: any, recipe: any, acquisition: any, stores: any): nil
    local stop, boundary = recipe.block, recipe.boundary
    need(g.blocks[stop.id] == stop and #stop.op >= boundary, "Arena staging point changed")
    local predecessors, reaches = {}, {[stop.id] = true}
    for _, block in ipairs(g.blocks) do
        for _, edge in ipairs(block.term and block.term.edges or {}) do
            local list = predecessors[edge.target] or {}
            predecessors[edge.target] = list
            list[#list + 1] = block
        end
    end

    local function dominates(row: any): boolean
        if row.block == stop then
            return row.at <= boundary
        end
        local active, memo = {}, {}
        local visit: function(any): boolean
        visit = function(block)
            if block == row.block then
                return true
            end
            if block.id == 1 or active[block] then
                return false
            end
            if memo[block] ~= nil then
                return memo[block]
            end
            active[block] = true
            local incoming = predecessors[block.id] or {}
            local okay = #incoming > 0
            for _, prior in ipairs(incoming) do
                if not visit(prior) then
                    okay = false
                end
            end
            active[block], memo[block] = nil, okay

            return okay
        end

        return visit(stop)
    end

    need(dominates(acquisition), "Arena acquisition does not dominate publication")
    for _, row in ipairs(stores) do
        need(dominates(row), "Arena initialization does not dominate publication")
    end
    local queue = {stop}
    local cursor: integer = 1
    while cursor <= #queue do
        local block = queue[cursor]
        cursor = cursor + 1
        for _, prior in ipairs(predecessors[block.id] or {}) do
            if not reaches[prior.id] then
                reaches[prior.id] = true;
                queue[#queue + 1] = prior
            end
        end
    end
    local storeRows = {}
    for _, row in ipairs(stores) do
        storeRows[row.args] = row
    end
    local metadata = recipe.metadata and arenaRow(g, recipe.metadata, "NativeLeafCall")
    local plain = {
        NativeConstant = true,
        NativeBoolean = true,
        NativeICmp = true,
        NativePointer = true,
        NativePointerView = true,
        NativeAddress = true,
        NativeWordCast = true,
        PointerOffset = true,
        IAdd = true,
        ISub = true
    }
    local active, seen = {}, {}
    local visit: function(any, integer): nil
    visit = function(block, first)
        need(not active[block], "Arena acquisition interval has a cycle")
        if seen[block] then
            return
        end
        active[block] = true
        local last = block == stop and boundary or #block.op
        local constants = {}
        for index = first, last do
            local op, args, dst = block.op[index], block.args[index], block.dst[index]
            if op == "NativeConstant" then
                constants[dst] = args[1]
            end
            if op == "NativeLeafCall" then
                need(
                    metadata
                    and metadata.block == block
                    and metadata.at == index
                    and calls[args[1]]
                    and calls[args[1]].target.owner == recipe.home.functions.metadataOffset,
                    "Arena success interval contains a retiring, allocating or foreign call"
                )
            elseif op == "NativeStore" then
                need(storeRows[args], "Arena success interval writes outside checked initialization")
            elseif op == "NativeLoad" then
                local region = {block = {dst = {recipe.item.scopeParameter}}, at = 1}
                local memory = args[3]
                need(
                    arenaReaches(g, args[1], region)
                    and constants[args[2]] == tostring(recipe.item.state.layout.offsets.error)
                    and memory.kind == "uint64"
                    and memory.width == 8
                    and memory.signed == false
                    and memory.write == false,
                    "Arena success interval reads outside exact service status"
                )
            else
                need(plain[op], "Arena success interval contains an unsupported effect")
            end
        end
        if block ~= stop then
            need(
                block.term.kind == "jump" or block.term.kind == "branch",
                "Arena interval loses its normal continuation"
            )
            for _, edge in ipairs(block.term.edges) do
                if reaches[edge.target] then
                    need(edge.target ~= acquisition.block.id, "Arena interval reenters acquisition")
                    visit(g.blocks[edge.target], 1)
                end
            end
        end
        active[block], seen[block] = nil, true
    end
    visit(acquisition.block, acquisition.at + 1)
    need(seen[stop], "Arena staging point is unreachable from acquisition")
end

local function verifyArenaRecipe(g: any, recipe: any, value: integer): nil
    local item, home = recipe.item, recipe.home
    need(
        graphs[g] == item and arenaHome(item) == home and arenaOwnership(item.signature, item.owner) == recipe.result,
        "Arena return owner/body/signature changed"
    )
    unit.occurrence(item.owner, recipe.node)
    need(recipe.node.exprs[1] == recipe.expression, "Arena selected return changed")
    local physical = require("nupp.compiler.vm.nativephysical")
    local row, acquisition
    local stores = {}
    if recipe.mode == "forward" then
        physical.arenaForward(item.owner, recipe.source, recipe.call, g.nativePhysical.signature)
        row = arenaRow(g, recipe.call, "NativeLeafCall")
        acquisition = row
        local call = need(calls[row.args[1]], "Arena forwarding call is unissued")
        need(
            call.caller == item and call.target.owner == home.functions.openWith and call.node == recipe.call,
            "Arena forwarding callee changed"
        )
    else
        local mapping = arenaRow(g, recipe.map, "NativeLeafCall")
        acquisition = mapping
        local mapped = need(calls[mapping.args[1]], "Arena mapping call is unissued")
        need(mapped.caller == item and mapped.os and mapped.node == recipe.map, "Arena mapping owner changed")
        local offset = arenaRow(g, recipe.offset, "PointerOffset")
        local metadata = arenaRow(g, recipe.metadata, "NativeLeafCall")
        need(
            arenaReaches(g, offset.args[1], mapping) and arenaReaches(g, offset.args[2], metadata, true),
            "Arena mapping or offset SSA changed"
        )
        row = arenaRow(g, recipe.cast, "NativePointerView")
        need(arenaReaches(g, row.args[1], offset), "Arena result is not the derived mapped pointer")
        local view = row.args[2]
        physical.validateCast(view)
        need(view.node == recipe.cast and view.target.checkedType == recipe.result.inner, "Arena result cast changed")
        local seen = {}
        for _, store in ipairs(arenaRows[g] or {}) do
            if store.store then
                local args = store.args
                need(
                    store.block.op[store.at] == "NativeStore"
                    and store.block.args[store.at] == args
                    and args[4].field == store.access,
                    "Arena initialization store changed"
                )
                physical.validateField(store.access)
                for index = 1, 3 do
                    need(arenaValueKey(g, args[index]) == store.store[index], "Arena initialization operand changed")
                end
                local access = store.access
                local arenaField = recipe.result.inner.elem.writeFieldDefs[access.name] == access.declaration
                local chunkType = home.checkedExports.types.Chunk
                local chunkField = chunkType.writeFieldDefs[access.name] == access.declaration
                need(arenaField or chunkField, "Arena initialization writes foreign storage")
                need(
                    arenaReaches(g, args[1], arenaField and offset or mapping),
                    "Arena initialization receiver changed"
                )
                need(not seen[access.declaration], "Arena initialization field repeated")
                seen[access.declaration] = true
                stores[#stores + 1] = store
            end
        end
        for _, t in ipairs({recipe.result.inner.elem, home.checkedExports.types.Chunk}) do
            for _, definition in pairs(t.writeFieldDefs) do
                need(seen[definition], "Arena initialization field missing")
            end
        end
    end
    need(arenaReaches(g, value, row), "Arena staged result changed acquisition instance")
    arenaInterval(g, recipe, acquisition, stores)
end

local function managedRow(g: any, node: any, op: string): any
    local found
    for _, row in ipairs(managedRows[g] or {}) do
        if row.node == node and row.op == op then
            need(found == nil, "managed source operation was lowered more than once")
            need(
                g.blocks[row.block.id] == row.block
                and row.block.op[row.at] == op
                and row.block.args[row.at] == row.args,
                "managed source operation changed"
            )
            found = row
        end
    end

    return need(found, "managed source operation is absent")
end

local function managedRecipe(ctx: any, stage: any, source: any): any
    local item = need(graphs[ctx.g], "managed return requires an issued graph")
    local proof = need(managedResult(item.signature, item.owner), "owner has no managed result")
    local heap = unit.ownerModule(item.owner, "nupp.runtime.vm.heap")
    local node = stage.node
    unit.occurrence(item.owner, node)
    need(node.kind == "returnStmt" and #node.exprs == 1, "managed return requires one checked expression")
    local expression = node.exprs[1]
    need(
        unit.checkedOccurrenceType(item.owner, expression) == item.owner.resultType,
        "managed return checked result changed"
    )
    local recipe = {
        item = item,
        proof = proof,
        result = item.owner.resultType,
        source = source,
        node = node,
        expression = expression,
        block = ctx.block,
        boundary = #ctx.block.op,
        heap = heap,
        rows = {},
        mode = item.owner == heap.exports.allocRaw and "allocate" or "forward"
    }
    for _, row in ipairs(managedRows[ctx.g] or {}) do
        recipe.rows[#recipe.rows + 1] = row
    end
    if recipe.mode == "forward" then
        need(
            expression.kind == "call" and target(ctx, expression) == heap.exports.allocRaw,
            "managed forwarding requires the exact allocRaw call"
        )
        need(#expression.args.exprs == 3, "managed forwarding argument count differs")
        for index, argument in ipairs(expression.args.exprs) do
            unit.occurrence(item.owner, argument)
            need(
                argument.kind == "name" and argument.token.definition == item.owner.parameterDefinitions[index],
                "managed forwarding Heap, kind or extent source differs"
            )
        end
        recipe.call = expression
    else
        local cast = arenaInitializer(item.owner, expression)
        need(
            cast.kind == "castExpr" and cast.inferredType == recipe.result,
            "managed allocation requires its checked Header cast"
        )
        local pointer = cast.expr
        local decl = unit.intrinsicDeclaration(item.owner, pointer)
        need(
            decl.name == "pointer" and #pointer.args.exprs == 1,
            "managed allocation requires its checked address conversion"
        )
        recipe.cast, recipe.pointer = cast, pointer
        local found = {}
        for _, row in ipairs(recipe.rows) do
            if row.op == "NativeLeafCall" then
                local call = calls[row.args[1]]
                need(call ~= nil, "managed allocation call is unissued")
                if call.target.owner == heap.functions.allocLarge
                    or call.target.owner == heap.functions.takeSlot
                    or call.target.owner == heap.exports.classFor
                then
                    need(found[call.target.owner] == nil, "managed allocation source call repeated")
                    found[call.target.owner] = row
                end
            end
        end
        recipe.large = need(found[heap.functions.allocLarge], "managed large allocation source is absent")
        recipe.slot = need(found[heap.functions.takeSlot], "managed slot allocation source is absent")
        recipe.class = need(found[heap.exports.classFor], "managed size classification source is absent")
    end

    return recipe
end

local function verifyManagedRecipe(g: any, recipe: any, value: integer): nil
    local item = recipe.item
    need(
        graphs[g] == item and managedResult(item.signature, item.owner) == recipe.proof,
        "managed return owner changed"
    )
    unit.occurrence(item.owner, recipe.node)
    need(recipe.node.exprs[1] == recipe.expression, "managed return expression changed")
    local rows = {}
    for _, row in ipairs(recipe.rows) do
        unit.occurrence(item.owner, row.node)
        need(
            row.node.inferredType == row.checked
            and g.blocks[row.block.id] == row.block
            and row.block.op[row.at] == row.op
            and row.block.args[row.at] == row.args
            and #row.args == row.count,
            "managed checked operation changed"
        )
        for index, key in pairs(row.keys) do
            need(arenaValueKey(g, row.args[index]) == key, "managed operand provenance changed")
        end
        for index, fixed in pairs(row.fixed) do
            need(row.args[index] == fixed, "managed operation contract changed")
        end
        if row.op == "NativeLeafCall" then
            recordTarget(g, row.args[1], row.node)
        end
        rows[row.args] = row
    end
    local formal = function(index: integer): any
        return {block = {dst = {index}}, at = 1}
    end
    local resultRow
    local acquisitions = {}
    local initialization = {}
    if recipe.mode == "forward" then
        resultRow = managedRow(g, recipe.call, "NativeLeafCall")
        acquisitions[resultRow.block] = resultRow
        local call = calls[resultRow.args[1]]
        need(call.target.owner == recipe.heap.exports.allocRaw, "managed forwarding target changed")
        for index = 1, 3 do
            need(
                arenaReaches(g, resultRow.args[index + 1], formal(index), index ~= 1),
                "managed forwarding Heap, kind or extent SSA differs"
            )
        end
        local origin = require("nupp.compiler.vm.nativephysical").managedOrigin(recipe.source)
        need(
            origin
            and origin.call == recipe.call
            and origin.owner == recipe.heap.exports.allocRaw
            and origin.caller == item.owner,
            "managed forwarded result lost allocation origin"
        )
    else
        local pointer = managedRow(g, recipe.pointer, "NativePointer")
        resultRow = managedRow(g, recipe.cast, "NativePointerView")
        need(recipe.large.block ~= recipe.slot.block, "managed allocation alternatives share a block")
        acquisitions[recipe.large.block], acquisitions[recipe.slot.block] = recipe.large, recipe.slot
        need(arenaReaches(g, resultRow.args[1], pointer), "managed Header cast changed address")
        for _, row in ipairs({recipe.large, recipe.slot, recipe.class}) do
            need(arenaReaches(g, row.args[2], formal(1)), "managed allocation changed Heap")
        end
        need(arenaReaches(g, recipe.slot.args[3], recipe.class, true), "managed slot changed size class")
        -- The same checked size crosses different branch parameters before the
        -- allocation and Header store. Their phi topology is not an identity.
        -- Anchor both uses at the original classification operand; the retained
        -- row witnesses above still reject changed operations or incoming values.
        local extent = formal(recipe.class.args[3])
        need(arenaReaches(g, recipe.large.args[3], extent, true), "managed allocation changed extent")
        -- All incoming address definitions must be one of the exact successful
        -- allocation calls, never a literal address or a same-shaped call.
        local active = {}
        local addresses: function(integer): boolean
        addresses = function(candidate)
            if candidate == recipe.large.block.dst[recipe.large.at]
                or candidate == recipe.slot.block.dst[recipe.slot.at]
            then
                return true
            end
            if candidate <= g.nparams or active[candidate] then
                return false
            end
            active[candidate] = true
            for _, block in ipairs(g.blocks) do
                for index, parameter in ipairs(block.params) do
                    if parameter == candidate then
                        local count = 0
                        for _, prior in ipairs(g.blocks) do
                            for _, edge in ipairs(prior.term and prior.term.edges or {}) do
                                if edge.target == block.id then
                                    count = count + 1
                                    if not addresses(edge.args[index]) then
                                        active[candidate] = nil;
                                        return false
                                    end
                                end
                            end
                        end
                        active[candidate] = nil
                        return count > 0
                    end
                end
            end
            active[candidate] = nil

            return false
        end
        need(addresses(pointer.args[1]), "managed Header does not originate in the actual allocation")
        local fields = {}
        for _, row in ipairs(recipe.rows) do
            if row.op == "NativeStore" and row.args[4].field then
                local access = row.args[4].field
                if recipe.result.elem.writeFieldDefs[access.name] == access.declaration then
                    need(
                        not fields[access.name] and arenaReaches(g, row.args[1], resultRow),
                        "managed Header initialization identity differs"
                    )
                    fields[access.name] = row
                end
            end
        end
        for name in pairs(recipe.result.elem.writeFieldDefs) do
            initialization[#initialization + 1] = need(fields[name], "managed Header initialization field is absent")
        end
        need(arenaReaches(g, fields.kind.args[3], formal(2), true), "managed allocation changed object kind")
        need(arenaReaches(g, fields.size.args[3], extent, true), "managed Header size differs from allocation extent")
    end
    need(arenaReaches(g, value, resultRow), "managed return changed allocated instance")
    -- Scan every path that can reach this staged return, stopping at the
    -- recorded allocation/forwarding boundary. Unknown or collecting calls
    -- after acquisition cannot be hidden behind a same-type pointer return.
    local predecessors = {}
    for _, block in ipairs(g.blocks) do
        for _, edge in ipairs(block.term and block.term.edges or {}) do
            local incoming = predecessors[edge.target] or {}
            predecessors[edge.target] = incoming
            incoming[#incoming + 1] = block
        end
    end
    for _, row in ipairs(initialization) do
        local active, done = {}, {}
        local dominates: function(any): boolean
        dominates = function(block)
            if block == row.block then
                return block ~= recipe.block or row.at <= recipe.boundary
            end
            if block.id == 1 or active[block] then
                return false
            end
            if done[block] ~= nil then
                return done[block]
            end
            active[block] = true
            local incoming = predecessors[block.id] or {}
            local result = #incoming > 0
            for _, prior in ipairs(incoming) do
                if not dominates(prior) then
                    result = false;
                    break
                end
            end
            active[block], done[block] = nil, result

            return result
        end
        need(dominates(recipe.block), "managed Header initialization does not dominate return")
    end
    local active, done = {}, {}
    local visit: function(any, integer): nil
    visit = function(block, last)
        need(not active[block], "managed result interval has a cycle")
        if done[block] then
            return
        end
        active[block] = true
        local acquisition = acquisitions[block]
        need(not acquisition or acquisition.at <= last, "managed return precedes allocation")
        local first = acquisition and acquisition.at + 1 or 1
        for index = first, last do
            local op, args = block.op[index], block.args[index]
            need(rows[args] and rows[args].op == op, "managed interval contains an unissued operation")
            if op == "NativeLeafCall" then
                local call = calls[args[1]]
                need(
                    recipe.mode == "allocate" and call and call.target.owner == recipe.heap.functions.colorAt,
                    "managed result interval contains an allocating or unknown call"
                )
            elseif op == "NativeHelperCall" or op == "NativeLocal" then
                error("native service: managed result interval has an unsupported effect", 0)
            end
        end
        if not acquisition then
            local incoming = predecessors[block.id] or {}
            need(#incoming > 0 and block.id ~= 1, "managed return bypasses allocation")
            for _, prior in ipairs(incoming) do
                visit(prior, #prior.op)
            end
        end
        active[block], done[block] = nil, true
    end
    visit(recipe.block, recipe.boundary)
end

export function validateManagedReturn(proof: any, holder: any, source: any, node: any): any
    local plan = need(managedPlans[proof], "unissued managed return plan")
    need(
        next(proof) == nil
        and getmetatable(proof) == nil
        and plan.item.owner == holder
        and plan.source == source
        and plan.node == node,
        "managed return view identity differs"
    )
    need(validateManagedResult(plan.proof, holder) == plan.result, "managed result type changed")

    return plan.result
end

export function validateArenaReturn(proof: any, holder: any, source: any, node: any): any
    local plan = need(arenaPlans[proof], "unissued Arena return plan")
    need(
        next(proof) == nil
        and getmetatable(proof) == nil
        and plan.item.owner == holder
        and plan.source == source
        and plan.node == node,
        "Arena return view identity differs"
    )
    held(plan.item.signature)
    need(arenaOwnership(plan.item.signature, holder) == plan.result, "Arena result type changed")

    return plan.result
end

-- The graph inventory may validate a transported creation descriptor; only
-- the exact private return view introduced the corresponding affine origin.
export function validateArenaValue(proof: any, holder: any, descriptor: any): boolean
    local plan = need(arenaPlans[proof], "unissued Arena creation origin")
    validateArenaReturn(proof, holder, plan.source, plan.node)
    need(
        plan.mode == "create"
        and plan.view
        and require("nupp.compiler.vm.nativephysical").same(plan.view.target, descriptor),
        "Arena creation value differs"
    )

    return true
end

-- An implicit terminal has no source call node. Its existing private cleanup
-- registration is the call authority; the actual acquired instance is separate.
export function arenaCleanup(g: any, decl: any, actual: any?): boolean
    if buildercleanup(g, decl) then
        return false
    end
    local call = calls[decl]
    if not call or not call.cleanup then
        return false
    end
    -- An automatic local owns the call result after temporary ownership transfers. Its
    -- exact checked owner retains the acquisition independently of the cleanup site.
    local acquisition = call.acquisition or call.node
    if call.acquisition then
        unit.occurrence(call.caller.owner, call.node)
        local holder = call.owner
        need(
            holder
            and call.node.kind == "localStmt"
            and holder.expr == call.acquisition
            and call.node.exprs[holder.index] == call.acquisition
            and require("nupp.compiler.vm.functioncleanup").localOwner(call.node, holder.index) == holder,
            "local cleanup acquisition changed"
        )
        need(holder.type == call.cleanupType, "local cleanup acquisition type differs")
    end
    unit.occurrence(call.caller.owner, acquisition)
    local home = arenaHome(call.caller)
    local acquired
    if home then
        acquired = arenaOwnership(call.caller.signature, call.caller.owner)
    else
        local holder = call.caller.owner
        -- Test-unit fixtures acquire their own arenas, as heap entry does.
        local fixture = unitModules[holder.scope.name] == true
        need(
            fixture
            or holder.scope.name == "nupp.runtime.core.heapentry"
            and holder == unit.ownerModule(holder, "nupp.runtime.core.heapentry").exports.run,
            "implicit Arena cleanup caller is outside reviewed acquisition"
        )
        home = unit.ownerModule(holder, "nupp.runtime.vm.arena")
        local opener = acquisition.kind == "call" and unit.callee(holder, acquisition) or nil
        need(
            opener == home.exports.open or fixture and opener == home.exports.openGrowable,
            "heap entry cleanup requires its exact Arena acquisition"
        )
        local constructor = need(call.caller.state.owners[opener], "Arena acquisition is outside service closure")
        acquired = arenaOwnership(constructor.signature, constructor.owner)
    end
    need(
        graphs[g] == call.caller
        and call.target.owner == home.exports.close
        and acquisition.kind == "call"
        and call.cleanupType == unit.checkedOccurrenceType(call.caller.owner, acquisition)
        and call.cleanupType == acquired,
        "implicit Arena cleanup registration differs"
    )
    need(
        unit.cleanupTarget(call.caller.owner, call.node, call.cleanupType, call.cleanup) == call.target.owner,
        "implicit Arena cleanup target changed"
    )
    validateIssued(decl)
    if actual then
        require(
            "nupp.compiler.vm.nativephysical"
        ).arenaCleanupOperand(call.caller.owner, actual, acquisition, decl.physical)
    end

    return true
end

-- A forwarded call result is already an acquired affine owner. Unlike a raw
-- construction failure, every failure exit must consume it exactly once or
-- prove the explicit retained-backing state that forbids retirement.
local function verifyArenaFailure(g: any, record: any, failed: any, canReturn: any, scopeOrigin: any): nil
    local physical = require("nupp.compiler.vm.nativephysical")
    local definitions, incoming = {}, {}
    for _, block in ipairs(g.blocks) do
        for index, value in ipairs(block.dst) do
            if value ~= 0 then
                definitions[value] = {op = block.op[index], args = block.args[index]}
            end
        end
        for _, edge in ipairs(block.term.edges) do
            for index, value in ipairs(g.blocks[edge.target].params) do
                local list = incoming[value] or {}
                incoming[value] = list
                list[#list + 1] = edge.args[index]
            end
        end
    end

    local function holder(value: any): boolean
        if type(value) ~= "number" then
            return false
        end
        local descriptor = g.nativePhysical.values[value]

        return descriptor ~= nil and physical.sameArenaOwner(record.arena.source, descriptor)
    end

    local literal: function(integer, any, any): boolean?
    literal = function(value, facts, active)
        if facts[value] ~= nil then
            return facts[value]
        end
        if active[value] then
            return nil
        end
        local definition = definitions[value]
        if definition then
            if definition.op == "NativeBoolean" then
                return definition.args[1]
            end
            return nil
        end
        local list = incoming[value]
        if not list or #list == 0 then
            return nil
        end
        active[value] = true
        local result = literal(list[1], facts, active)
        for index = 2, #list do
            if literal(list[index], facts, active) ~= result then
                result = nil;
                break
            end
        end
        active[value] = nil

        return result
    end
    -- Cleanup is acyclic. Visit each feasible path with its own Boolean
    -- bindings rather than merging live flags from mutually exclusive edges.
    local active = {}
    local work: integer = 0
    local visit: function(any, boolean, boolean, any): nil
    visit = function(block, retired, retained, facts)
        work = work + 1
        need(work <= 10000, "Arena failure proof work limit")
        need(not canReturn[block.id], "Arena failure rejoins successful publication")
        need(not active[block], "Arena failure cleanup has a cycle")
        active[block] = true
        local constants, retainedLoads, tests = {}, {}, {}
        for index, op in ipairs(block.op) do
            local args, dst = block.args[index], block.dst[index]
            if op == "NativeConstant" then
                constants[dst] = args[1]
            end
            if op == "NativeLoad"
                and scopeOrigin[args[1]]
                and constants[args[2]] == tostring(record.item.state.layout.offsets.retainBacking)
                and args[3].kind == "uint64"
                and args[3].width == 8
                and args[3].signed == false
                and args[3].write == false
            then
                retainedLoads[dst] = true
            elseif op == "NativeICmp"
                and retainedLoads[args[1]]
                and constants[args[2]] == "0"
                and (args[3] == "==" or args[3] == "~=")
            then
                tests[dst] = args[3]
            end
            local consumes = false
            for argument = op == "NativeLeafCall" and 2 or 1, #args do
                if holder(args[argument]) then
                    need(
                        op == "NativeLeafCall"
                        and argument == 2
                        and not consumes
                        and not retired
                        and not retained
                        and arenaCleanup(g, args[1], g.nativePhysical.values[args[2]]),
                        "Arena failure reuses or misroutes its acquired owner"
                    )
                    consumes = true
                end
            end
            if consumes then
                retired = true
            end
            local call = op == "NativeLeafCall" and calls[args[1]]
            if call and call.retention then
                retained = true
            end
        end
        local term = block.term
        need(not holder(term.value), "Arena failure tests its acquired owner")
        if term.kind == "nativeFail" then
            need(isFailure(g, term), "Arena failure terminal is unissued")
            need(retired or retained, "Arena failure leaves its acquired owner live")
        else
            need(term.kind == "jump" or term.kind == "branch", "Arena failure has no cleanup exit")
            local known: boolean? = nil
            if term.kind == "branch" then
                known = literal(term.value, facts, {})
                -- Retention is sticky. Unknown/false carries no proof of
                -- zero, but a prior retention fact excludes a clear edge.
                if retained and tests[term.value] then
                    known = tests[term.value] == "~="
                end
            end
            for index, edge in ipairs(term.edges) do
                if known == nil or (index == 1) == known then
                    local nextRetained = retained
                    if tests[term.value] then
                        nextRetained = retained or (index == 1) ~= (tests[term.value] == "==")
                    end
                    local branchFacts, nextFacts = {}, {}
                    for value, truth in pairs(facts) do
                        branchFacts[value] = truth
                    end
                    if term.kind == "branch" then
                        branchFacts[term.value] = index == 1
                    end
                    for value, truth in pairs(branchFacts) do
                        nextFacts[value] = truth
                    end
                    local dest = g.blocks[edge.target]
                    for at, parameter in ipairs(dest.params) do
                        if g.exactTypes[parameter] == "boolean" then
                            nextFacts[parameter] = literal(edge.args[at], branchFacts, {})
                        end
                    end
                    visit(dest, retired, nextRetained, nextFacts)
                end
            end
        end
        active[block] = nil
    end
    for _, step in ipairs(failed) do
        visit(step.block, false, false, {})
    end
end

-- Nil has no returned root. Non-nil primitive results may instead use a
-- bounded no-effect transport interval; this grants no caller rooting claim.
export function unmanagedReturn(ctx: any, stage: any?): any
    local item = need(graphs[ctx.g], "unmanaged return requires an issued service graph")
    held(item.signature)
    local checked = item.checked
    need(
        ctx.fn == item.owner
        and item.scoped
        and checked
        and checked.retPack
        and not checked.retPack.tail
        and not checked.retPack.alternatives
        and #checked.rets == 1
        and #checked.retPack.head == 1
        and checked.retPack.head[1] == checked.rets[1]
        and item.body.effectSummary == item.effect,
        "return needs an exact root and backing plan"
    )
    if checked.rets[1].tag == "nil" then
        local proof = unmanaged[item.signature]
        if not proof then
            proof = {}
            unmanaged[item.signature] = proof
        end
        need(getmetatable(proof) == nil and next(proof) == nil, "unmanaged return capability changed")
        return proof
    end
    local kind = checked.rets[1].tag
    need(stage and #stage.values == 1 and ctx.block, "return-tail staging point required")
    local g, block, value = ctx.g, ctx.block, stage.values[1]
    local arena, arenaProof, dependent, managed, managedProof
    if kind == "affine" and builderownership(item.signature, item.owner) then
        local physical = require("nupp.compiler.vm.nativephysical")
        local source = need(
            g.nativePhysical and g.nativePhysical.values[value],
            "Builder return lacks its physical source"
        )
        local proof = builderreturn(ctx, stage.node, source, value)
        local view = physical.builderreturnview(ctx.fn, source, stage.node, proof)
        builderplans[proof].view = view
        value = ctx.emit(stage.node, "NativePointerView", {value, view}, "voidptr")
        g.nativePhysical.values[value] = view.target
        stage.values[1] = value
        kind = "voidptr"
    elseif kind == "affine" then
        local physical = require("nupp.compiler.vm.nativephysical")
        local source = need(
            g.nativePhysical and g.nativePhysical.values[value],
            "Arena return lacks its physical source"
        )
        arena = arenaRecipe(ctx, stage.node, source)
        verifyArenaRecipe(g, arena, value)
        arenaProof = {}
        arenaPlans[arenaProof] = arena
        local view = physical.arenaReturnView(ctx.fn, source, stage.node, arenaProof)
        value = ctx.emit(stage.node, "NativePointerView", {value, view}, "voidptr")
        g.nativePhysical.values[value] = view.target
        stage.values[1] = value
        arena.view = view
        kind = "voidptr"
    elseif g.nativePhysical and g.nativePhysical.signature and g.nativePhysical.signature.managed then
        local physical = require("nupp.compiler.vm.nativephysical")
        local source = need(g.nativePhysical.values[value], "managed return lacks its physical source")
        managed = managedRecipe(ctx, stage, source)
        verifyManagedRecipe(g, managed, value)
        managedProof = {}
        managedPlans[managedProof] = managed
        local view = physical.managedReturnView(ctx.fn, source, stage.node, managedProof)
        value = ctx.emit(stage.node, "NativePointerView", {value, view}, "voidptr")
        g.nativePhysical.values[value] = view.target
        stage.values[1] = value
        managed.view = view
        kind = "voidptr"
    elseif g.nativePhysical and g.nativePhysical.signature and g.nativePhysical.signature.dependent then
        local physical = require("nupp.compiler.vm.nativephysical")
        local source = need(g.nativePhysical.values[value], "dependent return lacks its physical source")
        dependent = physical.dependentReturnView(ctx.fn, source, stage.node, g.nativePhysical.signature)
        -- An explicit identity row before common holds keeps pointer phis
        -- stable across pruning without a pointer select or a new borrow.
        value = ctx.emit(stage.node, "NativePointerView", {value, dependent}, "voidptr")
        g.nativePhysical.values[value] = dependent.target
        stage.values[1] = value
        kind = "voidptr"
    else
        need(
            kind == "uint64" or kind == "int64" or kind == "boolean",
            "return-tail proof currently requires an exact integer or Boolean primitive"
        )
        need(
            g.exactTypes[value] == kind and not (g.nativePhysical and g.nativePhysical.values[value]),
            "return-tail result carries physical ownership"
        )
    end
    local definition = nil
    for index, destination in ipairs(block.dst) do
        if destination == value then
            definition = index
        end
    end
    local parameter = value <= g.nparams and value or nil
    if not definition and not parameter then
        -- A phi has no stable row after pruning compacts block parameters.
        -- Existing select preserves all integer/Boolean bits and creates an
        -- ordinary definition row. Future removal must rederive or refuse.
        local yes = ctx.emit(stage.node, "NativeBoolean", {true}, "boolean")
        value = ctx.emit(stage.node, "NativeSelect", {yes, value, value}, kind)
        stage.values[1] = value
        definition = #block.op
    end
    local proof = {}
    local record = {
        graph = g,
        item = item,
        block = block,
        kind = kind,
        checkedResult = checked.rets[1],
        arena = arena,
        arenaProof = arenaProof,
        dependent = dependent,
        managed = managed,
        managedProof = managedProof,
        boundary = #block.op,
        boundaryArgs = block.args[#block.op],
        boundaryOp = block.op[#block.op],
        definition = definition,
        definitionArgs = definition and block.args[definition],
        definitionOp = definition and block.op[definition],
        parameter = parameter
    }
    unmanaged[proof] = record
    local list = unmanaged[g] or {}
    unmanaged[g] = list
    list[#list + 1] = proof

    return proof
end

-- Validation only: callers cannot mint a plan by supplying a table or term.
export function returnTail(ctx: any, proof: any, term: any?): nil
    local item = need(graphs[ctx.g], "return plan requires an issued service graph")
    held(item.signature)
    need(
        ctx.fn == item.owner and getmetatable(proof) == nil and next(proof) == nil,
        "return plan source or capability changed"
    )
    if unmanaged[item.signature] == proof then
        need(item.checked.rets[1].tag == "nil", "nil return contract changed")
        return
    end
    local record = need(unmanaged[proof], "unissued return-tail plan")
    need(
        record.graph == ctx.g
        and record.item == item
        and item.checked.rets[1] == record.checkedResult
        and item.body.effectSummary == item.effect,
        "return-tail owner or result changed"
    )
    if term then
        need(
            record.term == nil and ctx.block and ctx.block.term == term and term.kind == "return",
            "return-tail completion differs"
        )
        record.term = term
    end
end

-- Edges may carry both a lexical binding and a held result. Keep every
-- actual alias, intersecting at success joins rather than deduplicating SSA.
local function returnAliases(g: any, edge: any, values: any): any
    local result, dest = {}, g.blocks[edge.target]
    for value in pairs(values) do
        if value <= g.nparams then
            result[value] = true
        end
    end
    for index, value in ipairs(edge.args) do
        if values[value] then
            result[dest.params[index]] = true
        end
    end

    return result
end

local function returnReachability(g: any): (any, any)
    local predecessors, reverse, canReturn, returnQueue = {}, {}, {}, {}
    for _, block in ipairs(g.blocks) do
        if block.term.kind == "return" then
            canReturn[block.id] = true
            returnQueue[#returnQueue + 1] = block.id
        end
        for _, edge in ipairs(block.term.edges) do
            local list = predecessors[edge.target] or {}
            predecessors[edge.target] = list
            list[#list + 1] = edge
            local back = reverse[edge.target] or {}
            reverse[edge.target] = back
            back[#back + 1] = block.id
        end
    end
    local returnCursor: integer = 1
    while returnCursor <= #returnQueue do
        local dest = returnQueue[returnCursor]
        returnCursor = returnCursor + 1
        for _, source in ipairs(reverse[dest] or {}) do
            if not canReturn[source] then
                canReturn[source] = true
                returnQueue[#returnQueue + 1] = source
            end
        end
    end

    return canReturn, predecessors
end

local function verifyReturnTails(g: any, item: any, origin: any): nil
    local plans = unmanaged[g] or {}
    local covered = {}
    local canReturn, predecessors = returnReachability(g)
    for _, proof in ipairs(plans) do
        local record = need(unmanaged[proof], "missing return-tail plan")
        local start = record.block
        need(
            record.graph == g
            and record.item == item
            and record.term
            and g.blocks[start.id] == start
            and #start.op >= record.boundary
            and start.args[record.boundary] == record.boundaryArgs
            and start.op[record.boundary] == record.boundaryOp,
            "return-tail staging boundary changed"
        )
        local value = record.parameter
        if record.definition then
            need(
                start.args[record.definition] == record.definitionArgs
                and start.op[record.definition] == record.definitionOp,
                "return-tail result definition changed"
            )
            value = start.dst[record.definition]
        end
        need(value and g.exactTypes[value] == record.kind, "return-tail result identity changed")
        if record.arena then
            local args = start.args[record.definition]
            need(
                start.op[record.definition] == "NativePointerView" and args[2] == record.arena.view,
                "Arena staged view changed"
            )
            validateArenaReturn(record.arenaProof, item.owner, record.arena.source, record.arena.node)
            verifyArenaRecipe(g, record.arena, args[1])
        elseif record.managed then
            local args = start.args[record.definition]
            need(
                start.op[record.definition] == "NativePointerView" and args[2] == record.managed.view,
                "managed staged view changed"
            )
            validateManagedReturn(record.managedProof, item.owner, record.managed.source, record.managed.node)
            require("nupp.compiler.vm.nativephysical").validateCast(record.managed.view)
            verifyManagedRecipe(g, record.managed, args[1])
        elseif record.dependent then
            local args = start.args[record.definition]
            local physical = require("nupp.compiler.vm.nativephysical")
            need(
                start.op[record.definition] == "NativePointerView"
                and args[2] == record.dependent
                and g.nativePhysical.values[args[1]] == record.dependent.source
                and g.nativePhysical.values[value] == record.dependent.target,
                "dependent return staging identity changed"
            )
            physical.validateCast(record.dependent)
        end
        local boundary: integer = record.boundary
        local queue: {{
            block: any,
            at: integer,
            values: any,
            zero: boolean
        }} = {{block = start, at = boundary + 1, values = {[value] = true}, zero = false}}
        local seen, allowedEdges = {}, {}
        local zeroAt = {}
        local failed, found = {}, false
        local cursor: integer = 1
        while cursor <= #queue do
            local step = queue[cursor]
            cursor = cursor + 1
            local block = step.block
            local previous, aliases, changed = seen[block], {}, seen[block] == nil
            if previous then
                for candidate in pairs(previous) do
                    if step.values[candidate] then
                        aliases[candidate] = true
                    else
                        changed = true
                    end
                end
            else
                for candidate in pairs(step.values) do
                    aliases[candidate] = true
                end
            end
            need(next(aliases) ~= nil, "return-tail joins change result identity")
            local zero = step.zero == true and (previous == nil or zeroAt[block] == true)
            if previous and zero ~= zeroAt[block] then
                changed = true
            end
            if changed then
                seen[block], zeroAt[block] = aliases, zero
                local constants, errorLoads, errorTests = {}, {}, {}
                for index = step.at, #block.op do
                    local op, args, dst = block.op[index], block.args[index], block.dst[index]
                    if op == "NativeConstant" then
                        constants[dst] = args[1]
                    elseif op == "NativeLoad" then
                        local memory, offset = args[3], constants[args[2]]
                        need(
                            origin[args[1]]
                            and memory.kind == "uint64"
                            and memory.width == 8
                            and memory.signed == false
                            and memory.write == false
                            and (
                                offset == tostring(item.state.layout.offsets.error)
                                or offset == tostring(item.state.layout.offsets.retainBacking)
                            ),
                            "return-tail load is not a checked status read"
                        )
                        if offset == tostring(item.state.layout.offsets.error) then
                            errorLoads[dst] = true
                        end
                    else
                        if op == "NativeICmp"
                            and errorLoads[args[1]]
                            and constants[args[2]] == "0"
                            and (args[3] == "==" or args[3] == "~=")
                        then
                            errorTests[dst] = args[3]
                        end
                        need(
                            op == "NativeBoolean" or op == "NativeICmp",
                            "return-tail contains a call, write or unsupported operation"
                        )
                    end
                end
                local term = block.term
                if term.kind == "return" then
                    need(
                        term == record.term and aliases[term.value] == true,
                        "return-tail publishes a different result"
                    )
                    need(zero, "return-tail lacks a dominating zero-error edge")
                    covered[term], found = true, true
                elseif term.kind == "nativeFail" then
                    need(isFailure(g, term), "return-tail failure is not issued")
                    need(
                        not record.arena or record.arena.mode ~= "forward",
                        "Arena failure leaves its acquired owner live"
                    )
                else
                    need(term.kind == "jump" or term.kind == "branch", "return-tail transfer is unsupported")
                    for edgeIndex, edge in ipairs(term.edges) do
                        local dest = g.blocks[edge.target]
                        need(dest ~= start, "return-tail cycles through its staging point")
                        local predicate = term.kind == "branch" and errorTests[term.value]
                        if predicate and ((edgeIndex == 1) ~= (predicate == "==")) then
                            need(not canReturn[dest.id], "return-tail error edge rejoins publication")
                        end
                        local forwarded = returnAliases(g, edge, aliases)
                        if canReturn[dest.id] then
                            need(next(forwarded) ~= nil, "return-tail success drops its result")
                            allowedEdges[edge] = true
                            local nextZero = zero
                            if predicate then
                                nextZero = (edgeIndex == 1) == (predicate == "==")
                            end
                            queue[#queue + 1] = {block = dest, at = 1, values = forwarded, zero = nextZero}
                        else
                            failed[#failed + 1] = {block = dest, values = forwarded}
                        end
                    end
                end
            end
        end
        need(found, "return-tail has no matching successful return")
        for block in pairs(seen) do
            if block ~= start then
                for _, edge in ipairs(predecessors[block.id] or {}) do
                    need(allowedEdges[edge], "return-tail predecessor bypasses staging")
                end
            end
        end
        if record.arena and record.arena.mode == "forward" then
            verifyArenaFailure(g, record, failed, canReturn, origin)
        else
            -- Failure-only regions can unwind. A held result may still occupy
            -- unused phi parameters before prune; it must never be consumed.
            local failureSeen = {}
            local nextFailure: integer = 1
            while nextFailure <= #failed do
                local step = failed[nextFailure]
                nextFailure = nextFailure + 1
                local block, values = step.block, step.values
                local visited, changed = failureSeen[block], failureSeen[block] == nil
                if not visited then
                    visited = {};
                    failureSeen[block] = visited
                end
                for value in pairs(values) do
                    if not visited[value] then
                        visited[value], changed = true, true
                    end
                end
                if changed then
                    need(not canReturn[block.id], "failed return-tail rejoins publication")
                    for index, op in ipairs(block.op) do
                        local first = op == "NativeLeafCall" and 2 or 1
                        for argument = first, #block.args[index] do
                            need(not visited[block.args[index][argument]], "failed return-tail consumes its result")
                        end
                    end
                    need(not visited[block.term.value], "failed return-tail tests its result")
                    for _, edge in ipairs(block.term.edges) do
                        failed[#failed + 1] = {block = g.blocks[edge.target], values = returnAliases(g, edge, visited)}
                    end
                end
            end
        end
    end
    if item.scoped and item.checked.rets[1].tag ~= "nil" then
        for _, block in ipairs(g.blocks) do
            need(block.term.kind ~= "return" or covered[block.term], "primitive return lacks verified transport tail")
        end
    end
end

export function retainRoots(ctx: any, node: any): nil
    local item = need(graphs[ctx.g], "retention requires an issued service graph")
    need(item.scoped, "retention requires explicit service scope")
    local dest = need(
        unit.ownerModule(item.owner, "nupp.runtime.core.servicescope").exports.retain,
        "retention helper is absent"
    )
    local callee = need(item.state.owners[dest], "retention helper outside closed catalog")
    -- Lazy require avoids a module import cycle; the declaration still follows
    -- the ordinary checked leaf signature and existing INTERNAL call path.
    local decl = require(
        "nupp.compiler.vm.graph"
    ).nativeLeafDeclaration(dest, ctx.g.nativePhysical and ctx.g.nativePhysical.context, nil, nil, callee.signature)
    need(
        #decl.params == 1 and decl.params[1] == "voidptr" and decl.result == "nil",
        "retention helper signature changed"
    )
    local record = {
        caller = item,
        target = callee,
        node = node,
        retention = true,
        params = decl.params,
        kinds = {"voidptr"},
        result = "nil",
        fields = {}
    }
    for key, value in pairs(decl) do
        record.fields[key] = value
    end
    calls[decl] = record
    ctx.emit(node, "NativeLeafCall", {decl, scope(ctx)}, nil)
end

export function retainConstructRoots(ctx: any, node: any): nil
    local item = graphs[ctx.g]
    if not item then
        return
    end
    local exact
    if item.scope.name == "nupp.runtime.core.cellservice" then
        exact = unit.ownerModule(item.owner, "nupp.runtime.core.cellservice").exports.construct
    elseif item.scope.name == "nupp.runtime.core.heapentry" then
        exact = unit.ownerModule(item.owner, "nupp.runtime.core.heapentry").exports.run
    else
        return
    end
    if item.owner ~= exact then
        return
    end
    need(ctx.fn == item.owner, "rooted failure owner differs")
    unit.occurrence(item.owner, node)
    retainRoots(ctx, node)
end

export function afterCall(ctx: any, node: any, decl: any, result: integer?): integer?
    local call = calls[decl]
    if not call or call.cleanup or not (call.os or call.target.scoped) then
        return result
    end
    need(type(ctx.afterCall) == "function", "service failure continuation is not installed")
    local region = scope(ctx)
    local offset = ctx.emit(node, "NativeConstant", {tostring(call.caller.state.layout.offsets.error)}, "int64")
    local status = ctx.emit(
        node,
        "NativeLoad",
        {
            region,
            offset,
            {
                source = ctx.g.native.abi == "leaf" and "borrowed" or "live",
                kind = "uint64",
                width = 8,
                signed = false,
                write = false
            }
        },
        "uint64"
    )
    local zero = ctx.emit(node, "NativeConstant", {"0"}, "uint64")
    local okay = ctx.emit(node, "NativeICmp", {status, zero, "=="}, "boolean")

    return ctx.afterCall(node, result, okay)
end

export function callGraph(g: any, decl: any, args: any): nil
    local call = need(calls[decl], "unissued service call")
    validateIssued(decl)
    if call.retention then
        need(
            call.target.owner == unit.ownerModule(call.caller.owner, "nupp.runtime.core.servicescope").exports.retain,
            "retention helper identity changed"
        )
    elseif call.cleanup then
        need(
            unit.cleanupTarget(call.caller.owner, call.node, call.cleanupType, call.cleanup) == call.target.owner,
            "cleanup registration changed"
        )
    end
    need(
        graphs[g] == call.caller
        and held(decl.service) == call.target
        and decl.params == call.params
        and decl.result == call.result,
        "service call contract changed"
    )
    need(#args == #call.kinds + 1 and #decl.params == #call.kinds, "service operand count")
    for index, kind in ipairs(call.kinds) do
        need(decl.params[index] == kind, "service parameter kind changed")
    end
    if publicationSource(g, decl) then
        need(publicationArgument(g, decl, 2, args[3]), "publication Heap binding changed")
    end
    -- Scope identity must be the entry argument or its exact CFG transport.
    -- Ordinary graph verification checks SSA/edge kinds; service.verifyScope
    -- below adds the identity constraint rather than trusting a voidptr kind.
end

export function checked(sig: any, holder: any, checked: any): any
    need(held(sig).owner == holder, "resolved service owner differs")
    checked.params = parameters(sig, checked.params)
    checked.service = sig
    return checked
end

-- Must-facts belong to actual CFG edges, never to a caller Boolean option.
-- Entry has no failure/retention fact; joins intersect every incoming path.
local function verifyFailureFlow(g: any, item: any, origin: any, reachable: any): nil
    if not item.scoped then
        return
    end
    local incoming, input, output, tests, raised = {}, {}, {}, {}, {}
    for _, block in ipairs(g.blocks) do
        incoming[block.id], output[block.id] = {}, {}
        input[
            block.id
        ] = {
            error = block.id ~= 1 and reachable[block.id] == true,
            clear = block.id ~= 1 and reachable[block.id] == true
        }
    end
    for _, block in ipairs(g.blocks) do
        local constants, loads, comparisons = {}, {}, {}
        raised[block.id] = {}
        for index, op in ipairs(block.op) do
            local args, dst = block.args[index], block.dst[index]
            if op == "NativeConstant" and (g.exactTypes[dst] == "int64" or g.exactTypes[dst] == "uint64") then
                constants[dst] = args[1]
            elseif op == "NativeLoad" and origin[args[1]] then
                local access, offset = args[3], constants[args[2]]
                need(
                    access.kind == "uint64"
                    and access.width == 8
                    and access.signed == false
                    and access.write == false
                    and g.exactTypes[dst] == "uint64",
                    "service scope load changes exact representation"
                )
                if offset == tostring(item.state.layout.offsets.error) then
                    loads[dst] = "error"
                elseif offset == tostring(item.state.layout.offsets.retainBacking) then
                    loads[dst] = "retain"
                else
                    need(false, "service scope load outside status fields")
                end
            elseif op == "NativeICmp"
                and loads[args[1]]
                and constants[args[2]] == "0"
                and g.exactTypes[args[1]] == "uint64"
                and g.exactTypes[args[2]] == "uint64"
                and (args[3] == "==" or args[3] == "~=")
            then
                comparisons[dst] = {field = loads[args[1]], equal = args[3] == "=="}
            elseif op == "NativeLeafCall" then
                local call = need(calls[args[1]], "unissued call in scoped service graph")
                loads, comparisons = {}, {}
                if call.raising then
                    local evidence = item.state.raises[call.node]
                    need(
                        evidence
                        and constants[args[3]] == "1"
                        and constants[args[4]] == tostring(item.id)
                        and constants[args[5]] == tostring(evidence.site),
                        "literal failure arguments changed"
                    )
                    raised[block.id][index] = true
                elseif call.retention then
                    raised[block.id][index] = true
                end
            end
            -- Hidden scope cannot be published, cast or used as an arbitrary
            -- address. Only exact status loads and authenticated call slots use it.
            for argument, value in ipairs(args) do
                if type(value) == "number" and origin[value] then
                    local permitted = op == "NativeLoad" and argument == 1
                    if op == "NativeLeafCall" then
                        local call = calls[args[1]]
                        local parameter = call
                            and ((call.os or call.raising or call.retention) and 1 or call.target.scopeParameter)
                        permitted = parameter ~= nil and argument == parameter + 1
                    end
                    need(permitted, "service scope escapes or is mutated outside its closed helpers")
                end
            end
        end
        tests[block.id] = block.term.kind == "branch" and comparisons[block.term.value] or nil
        for index, edge in ipairs(block.term.edges or {}) do
            incoming[edge.target][#incoming[edge.target] + 1] = {block = block.id, edge = index}
            output[block.id][index] = {error = reachable[block.id] == true, clear = reachable[block.id] == true}
        end
    end
    local changed = true
    while changed do
        changed = false
        for _, block in ipairs(g.blocks) do
            local fact = {error = false, clear = false}
            if block.id ~= 1 and reachable[block.id] and #incoming[block.id] > 0 then
                fact.error, fact.clear = true, true
                for _, predecessor in ipairs(incoming[block.id]) do
                    local edge = output[predecessor.block][predecessor.edge]
                    fact.error = fact.error and reachable[predecessor.block] == true and edge.error
                    fact.clear = fact.clear and reachable[predecessor.block] == true and edge.clear
                end
            end
            input[block.id] = {error = fact.error, clear = fact.clear}
            for index, op in ipairs(block.op) do
                if op == "NativeLeafCall" then
                    fact.clear = false
                end
                if raised[block.id][index] then
                    fact.error = true
                end
            end
            local test = tests[block.id]
            for index in ipairs(block.term.edges or {}) do
                local edge = {error = fact.error, clear = fact.clear}
                if test then
                    local zero = (index == 1) == test.equal
                    if test.field == "error" then
                        edge.error = not zero
                    else
                        edge.clear = zero
                    end
                end
                local previous = output[block.id][index]
                if edge.error ~= previous.error or edge.clear ~= previous.clear then
                    output[block.id][index], changed = edge, true
                end
            end
        end
    end
    for _, block in ipairs(g.blocks) do
        local error, clear = input[block.id].error, input[block.id].clear
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local call = calls[block.args[index][1]]
                if call.cleanup then
                    need(reachable[block.id] and clear, "cleanup lacks current retained-backing permission")
                end
                clear = false
                if raised[block.id][index] then
                    error = true
                end
            end
        end
        if isFailure(g, block.term) then
            need(reachable[block.id] and error, "service failure lacks a dominating nonzero error edge")
        end
    end
end

export function verifyScope(g: any): nil
    verify(g)
    local item = graphs[g]
    if not item then
        return
    end
    -- Test builds are tested, not proven (runtime plan, "Direction").
    if unitModules[item.owner.scope.name] then
        return
    end
    local reachable, queue = {[1] = true}, {1}
    local cursor: integer = 1
    while cursor <= #queue do
        for _, edge in ipairs(g.blocks[queue[cursor]].term.edges or {}) do
            if not reachable[edge.target] then
                reachable[edge.target] = true
                queue[#queue + 1] = edge.target
            end
        end
        cursor = cursor + 1
    end
    local origin, incoming = {}, {}
    if item.scoped then
        origin[item.scopeParameter] = true
    end
    for _, block in ipairs(g.blocks) do
        incoming[block.id] = {}
        for _, value in ipairs(block.params) do
            origin[value] = reachable[block.id] == true
        end
    end
    for _, block in ipairs(g.blocks) do
        for _, edge in ipairs(block.term.edges or {}) do
            local dest = g.blocks[edge.target]
            for index, value in ipairs(dest.params) do
                local list = incoming[dest.id][value] or {}
                incoming[dest.id][value] = list
                list[#list + 1] = {block = block.id, value = edge.args[index]}
            end
        end
    end
    local changed = true
    while changed do
        changed = false
        for _, block in ipairs(g.blocks) do
            for _, value in ipairs(block.params) do
                if origin[value] then
                    local edges = incoming[block.id][value] or {}
                    local valid = #edges > 0
                    for _, edge in ipairs(edges) do
                        if not reachable[edge.block] or not origin[edge.value] then
                            valid = false
                        end
                    end
                    if not valid then
                        origin[value], changed = false, true
                    end
                end
            end
        end
    end
    -- A mixed phi cannot hide a scope escape by losing exact identity.
    local tainted = {}
    if item.scoped then
        tainted[item.scopeParameter] = true
    end
    changed = true
    while changed do
        changed = false
        for _, block in ipairs(g.blocks) do
            for _, edge in ipairs(block.term.edges or {}) do
                for index, value in ipairs(edge.args) do
                    local dest = g.blocks[edge.target].params[index]
                    if tainted[value] and not tainted[dest] then
                        tainted[dest], changed = true, true
                    end
                end
            end
        end
    end
    for value in pairs(tainted) do
        need(origin[value], "service scope phi changes identity")
    end
    for _, block in ipairs(g.blocks) do
        need(not block.term.value or not origin[block.term.value], "service scope escapes through terminator")
    end
    verifyFailureFlow(g, item, origin, reachable)
    -- Test-unit fixtures are tested, not proven (runtime plan, "Direction").
    if not unitModules[item.owner.scope.name] then
        verifyReturnTails(g, item, origin)
    end
    local canReturn = returnReachability(g)
    for _, block in ipairs(g.blocks) do
        for index, op in ipairs(block.op) do
            if op == "NativeLeafCall" then
                local args = block.args[index]
                local call = calls[args[1]]
                if call then
                    callGraph(g, args[1], args)
                    if not call.cleanup and (call.os or call.target.scoped) then
                        need(
                            #block.op == index + 4
                            and block.op[index + 1] == "NativeConstant"
                            and block.args[index + 1][1] == tostring(item.state.layout.offsets.error)
                            and block.op[index + 2] == "NativeLoad"
                            and block.args[index + 2][2] == block.dst[index + 1]
                            and origin[block.args[index + 2][1]]
                            and block.args[index + 2][3].kind == "uint64"
                            and block.args[index + 2][3].width == 8
                            and block.args[index + 2][3].signed == false
                            and block.args[index + 2][3].write == false
                            and g.exactTypes[block.dst[index + 2]] == "uint64"
                            and g.exactTypes[block.dst[index + 3]] == "uint64"
                            and block.op[index + 3] == "NativeConstant"
                            and block.args[index + 3][1] == "0"
                            and block.op[index + 4] == "NativeICmp"
                            and block.args[index + 4][1] == block.dst[index + 2]
                            and block.args[index + 4][2] == block.dst[index + 3]
                            and block.args[index + 4][3] == "=="
                            and block.term.kind == "branch"
                            and block.term.value == block.dst[index + 4],
                            "service result lacks immediate exact success continuation"
                        )
                        need(
                            not canReturn[block.term.edges[2].target],
                            "failed service continuation rejoins normal return"
                        )
                        local result = block.dst[index]
                        if result ~= 0 then
                            for _, value in ipairs(block.term.edges[2].args) do
                                need(value ~= result, "failed service result escapes into cleanup")
                            end
                        end
                    end
                    local parameter = (call.os or call.raising or call.retention) and 1 or call.target.scopeParameter
                    if parameter then
                        need(
                            reachable[block.id] and origin[args[parameter + 1]],
                            "call scope is not the retained entry scope"
                        )
                    end
                end
            end
        end
    end
end

export function inventory(catalog: any): any
    local state = need(catalogs[catalog], "unissued service catalogue")
    local result = {}
    for _, item in ipairs(state.order) do
        result[
            #result + 1
        ] = {
            moduleName = item.scope.name,
            name = item.owner.name,
            sourceParameters = item.sourceCount,
            machineParameters = item.sourceCount + (item.scopeParameter and 1 or 0),
            hasScope = item.scoped,
            raises = item.raises == true
        }
    end

    return result
end

local scopedPolicy = {
    ["nupp.runtime.core.corestrings.open"] = {[2] = true},
    ["nupp.runtime.core.sharedbacking.releaselocal"] = {[1] = true},
    ["nupp.runtime.vm.arena.grow"] = {[1] = true},
    ["nupp.runtime.vm.childwalk.childRun"] = {[3] = true},
    ["nupp.runtime.vm.childwalk.childPairs"] = {[2] = true},
    ["nupp.runtime.vm.childwalk.childNext"] = {[2] = true},
    ["nupp.runtime.vm.objectwalk.objectNext"] = {[2] = true},
    ["nupp.runtime.vm.objectwalk.sweepNext"] = {[2] = true},
    ["nupp.runtime.vm.gcweak.weakCycleClearNext"] = {[2] = true}
}

-- This closed raw-lifetime policy is reviewed source, not inferred escape
-- analysis. It grants no retention, suspension or publication permission.
export function scopedCall(caller: any, node: any, dest: any, index: integer): any
    unit.call(caller, node, dest)
    unit.occurrence(caller, node)
    local policy = scopedPolicy[dest.scope.name .. "." .. dest.name]
    -- Test builds are tested, not proven (runtime plan, "Direction").
    need(
        policy and policy[index] or unitModules[caller.scope.name] or unitModules[dest.scope.name],
        "plain call lacks reviewed scoped lifetime policy"
    )
    local state = nil
    for _, candidate in ipairs(ownerCatalogs[caller] or {}) do
        local call = candidate.calls[node]
        if call and call.owner == caller and call.target == dest and not call.os and not call.raising then
            state = candidate
            break
        end
    end
    need(state ~= nil, "scoped call is outside closed service catalogue")
    local proof = {}
    scopedCalls[
        proof
    ] = {
        state = state,
        caller = caller,
        node = node,
        target = dest,
        index = index,
        callerBody = caller.body,
        targetBody = dest.body
    }

    return proof
end

export function validateScopedCall(proof: any, caller: any, node: any, dest: any, index: integer): nil
    local saved = need(scopedCalls[proof], "unissued scoped-call proof")
    need(
        next(proof) == nil
        and getmetatable(proof) == nil
        and saved.caller == caller
        and saved.node == node
        and saved.target == dest
        and saved.index == index
        and caller.body == saved.callerBody
        and dest.body == saved.targetBody,
        "scoped-call identity changed"
    )
    unit.call(caller, node, dest)
    unit.occurrence(caller, node)
end

export function isIssued(value: any): boolean
    return signatures[value] ~= nil or calls[value] ~= nil or failures[value] ~= nil
end

export function validateIssued(value: any): nil
    if failures[value] then
        isFailure(failures[value].graph, value);
        return
    end
    if signatures[value] then
        held(value);
        return
    end
    local call = need(calls[value], "unissued service record")
    need(
        value.service == call.target.signature and value.params == call.params and value.result == call.result,
        "service call record changed"
    )
    local dest = held(value.service).owner
    need(
        value.moduleName == dest.scope.name
        and value.name == dest.name
        and value.source
        and getmetatable(value.source) == nil
        and value.source.path == dest.scope.path
        and value.source.module == dest.scope.name
        and value.source.name == dest.name,
        "service declaration source changed"
    )
    for key in pairs(value.source) do
        need(key == "path" or key == "module" or key == "name", "service source field added")
    end
    need(
        getmetatable(value) == nil and getmetatable(value.params) == nil and #value.params == #call.kinds,
        "service record shape changed"
    )
    for key, expected in pairs(call.fields) do
        need(value[key] == expected, "service record field changed")
    end
    for key in pairs(value) do
        need(call.fields[key] ~= nil, "service record field added")
    end
    for index, kind in ipairs(call.kinds) do
        need(value.params[index] == kind, "service call kind changed")
    end
end

local paths = {
    {"nupp.runtime.vm.arena", "src/nupp/runtime/vm/arena.nupp"},
    {"nupp.runtime.vm.heap", "src/nupp/runtime/vm/heap.nupp"},
    {"nupp.runtime.vm.collector", "src/nupp/runtime/vm/collector.nupp"},
    {"nupp.runtime.vm.marking", "src/nupp/runtime/vm/marking.nupp"},
    {"nupp.runtime.vm.gcweak", "src/nupp/runtime/vm/gcweak.nupp"},
    {"nupp.runtime.vm.gcfinal", "src/nupp/runtime/vm/gcfinal.nupp"},
    {"nupp.runtime.vm.childwalk", "src/nupp/runtime/vm/childwalk.nupp"},
    {"nupp.runtime.vm.objectwalk", "src/nupp/runtime/vm/objectwalk.nupp"},
    {"nupp.runtime.vm.objectconstruct", "src/nupp/runtime/vm/objectconstruct.nupp"},
    {"nupp.runtime.vm.backing", "src/nupp/runtime/vm/backing.nupp"},
    {"nupp.runtime.vm.weakentries", "src/nupp/runtime/vm/weakentries.nupp"},
    {"nupp.runtime.vm.weakindex", "src/nupp/runtime/vm/weakindex.nupp"},
    {"nupp.runtime.vm.objectweak", "src/nupp/runtime/vm/objectweak.nupp"},
    {"nupp.runtime.vm.objecthash", "src/nupp/runtime/vm/objecthash.nupp"},
    {"nupp.runtime.vm.objecttable", "src/nupp/runtime/vm/objecttable.nupp"},
    {"nupp.runtime.vm.values", "src/nupp/runtime/vm/values.nupp"},
    {"nupp.runtime.core.pagemappings", "native/core/src/nupp/runtime/core/pagemappings.nupp"},
    {"nupp.runtime.core.servicescope", "native/core/src/nupp/runtime/core/servicescope.nupp"},
    {"nupp.runtime.core.resourcejournal", "native/core/src/nupp/runtime/core/resourcejournal.nupp"},
    {"nupp.runtime.core.cellservice", "native/core/src/nupp/runtime/core/cellservice.nupp"},
    {"nupp.runtime.core.heapentry", "native/core/src/nupp/runtime/core/heapentry.nupp"},
    {"nupp.runtime.core.rootentry", "native/core/src/nupp/runtime/core/rootentry.nupp"},
    {"nupp.runtime.core.frameroots", "native/core/src/nupp/runtime/core/frameroots.nupp"},
    {"nupp.runtime.core.frames", "native/core/src/nupp/runtime/core/frames.nupp"},
    {"nupp.runtime.core.arena", "native/core/src/nupp/runtime/core/arena.nupp"}
}
local roots = {
    {"nupp.runtime.vm.arena", "open"},
    {"nupp.runtime.vm.arena", "openGrowable"},
    {"nupp.runtime.vm.arena", "close"},
    {"nupp.runtime.vm.heap", "create"},
    {"nupp.runtime.vm.heap", "destroy"},
    {"nupp.runtime.vm.collector", "allocate"},
    {"nupp.runtime.vm.collector", "fullCycle"},
    {"nupp.runtime.vm.objectconstruct", "cellInitialize"},
    {"nupp.runtime.vm.objectconstruct", "closureInitialize"},
    {"nupp.runtime.core.pagemappings", "initialize"},
    {"nupp.runtime.core.pagemappings", "acquireEntry"},
    {"nupp.runtime.core.pagemappings", "releaseEntry"},
    {"nupp.runtime.core.servicescope", "initialize"},
    {"nupp.runtime.core.servicescope", "close"},
    {"nupp.runtime.core.servicescope", "retain"},
    {"nupp.runtime.core.cellservice", "construct"},
    {"nupp.runtime.core.heapentry", "run"},
    {"nupp.runtime.vm.collector", "initialized"}
}

local function read(path: string): string
    local file = io.open(path, "rb")
    if not file then
        error("native service: missing reviewed service source: " .. path)
    end
    local text = file:read("*a")
    file:close()

    return text
end

local function reviewUnchanged(review: any): nil
    if review.unreviewed then
        return
    end
    need(read(review.path) == review.text, "service build snapshot changed")
    for path, text in pairs(review.snapshot.sources) do
        need(read(review.root .. "/" .. path) == text, "reviewed service source changed: " .. path)
    end
end

-- Fixed producer input and fixed source closure, following the existing closed
-- final-frame producer boundary. The host build filesystem and reviewed
-- snapshot are trusted; this is not arbitrary-source nonescape authentication.
export function build(): any
    local root = need(os.getenv("NUPP_COMPILER_ROOT"), "build source root required")
    local path = root .. "/build/core-heap-services/snapshot.json"
    local text = read(path)
    local snapshot = require("nupp.serde.internal.json.values").decode(text)
    need(snapshot.version == 1 and snapshot.target == "aarch64-apple-darwin", "service snapshot version/target")
    local requested = {}
    for index, source in ipairs(paths) do
        need(snapshot.sources[source[2]] == read(root .. "/" .. source[2]), "service source snapshot differs")
        requested[index] = {moduleName = source[1], path = root .. "/" .. source[2]}
    end
    for _, source in ipairs({
        "src/nupp/runtime/vm/os.d.nupp",
        "src/nupp/runtime/vm/intrinsics.d.nupp",
        "src/nupp/compiler/vm/nativeservice.nupp",
        "src/nupp/compiler/vm/nativeos.nupp"
    }) do
        need(snapshot.sources[source] == read(root .. "/" .. source), "service policy snapshot differs")
    end
    local review = {root = root, path = path, text = text, snapshot = snapshot}
    reviewUnchanged(review)
    local verified = unit.session(root, requested, snapshot.target)
    local entries = {}
    for index, source in ipairs(roots) do
        entries[index] = need(verified.module(source[1]).exports[source[2]], "fixed service entry is missing")
    end
    local result = catalog(entries[1], entries, review)

    return {catalog = result, entries = entries}
end

local function sourceExists(path: string): boolean
    local file = io.open(path, "rb")
    if not file then
        return false
    end
    file:close()

    return true
end

-- A test build: the runtime service modules plus caller-supplied fixture
-- modules, with the given fixture functions as roots. It reviews no snapshot
-- and is never an executable admission; the core's own code is tested, not
-- proven (runtime plan, "Direction").
export function buildUnits(fixtures: any, rootNames: any, handlers: {[string]: boolean}?): any
    local root = need(os.getenv("NUPP_COMPILER_ROOT"), "build source root required")
    local requested, seen = {}, {}
    for _, fixture in ipairs(fixtures) do
        requested[#requested + 1] = {moduleName = fixture.moduleName, path = fixture.path}
        seen[fixture.moduleName], unitModules[fixture.moduleName] = true, true
    end
    for _, source in ipairs(paths) do
        if not seen[source[1]] then
            seen[source[1]] = true
            requested[#requested + 1] = {moduleName = source[1], path = root .. "/" .. source[2]}
        end
    end
    local include = {"src", "native/core/src"}
    for _, fixture in ipairs(fixtures) do
        if fixture.include then
            include[#include + 1] = fixture.include
        end
    end
    -- Runtime modules the fixtures require, transitively, join the session so
    -- their functions can be called, under the same test-build checks.
    local cursor = 1
    while cursor <= #requested do
        local text = ""
        local file = io.open(requested[cursor].path, "rb")
        if file then
            text = file:read("*a") or ""
            file:close()
        end
        for name in text:gmatch('require%("(nupp%.runtime%.[%w%.]+)"%)') do
            if not seen[name] then
                local relative = name:gsub("%.", "/") .. ".nupp"
                for _, base in ipairs({"src", "native/core/src"}) do
                    local candidate = root .. "/" .. base .. "/" .. relative
                    if not seen[name] and sourceExists(candidate) then
                        seen[name] = true
                        unitModules[name] = true
                        requested[#requested + 1] = {moduleName = name, path = candidate}
                    end
                end
            end
        end
        cursor = cursor + 1
    end
    local verified = unit.session(root, requested, "aarch64-apple-darwin", include, true)
    local entries = {}
    for _, item in ipairs(rootNames) do
        local region = verified.module(item[1])
        entries[
            #entries + 1
        ] = need(region.exports[item[2]] or region.functions[item[2]], "unit root is missing: " .. item[2])
        -- Handler roots are lowered with the handler ABI.
        entries[#entries].nativeABI = handlers and handlers[item[1] .. "." .. item[2]] and "handler" or nil
    end
    -- The infrastructure roots (scope retention, close, the page ledger)
    -- belong to every service closure.
    for _, source in ipairs(roots) do
        if source[1] == "nupp.runtime.core.pagemappings" or source[1] == "nupp.runtime.core.servicescope" then
            entries[#entries + 1] = need(verified.module(source[1]).exports[source[2]], "service root is missing")
        end
    end
    local result = catalog(entries[1], entries, {unreviewed = true})

    return {catalog = result, entries = entries, session = verified}
end

-- True for any graph lowered for a test build's catalog, the runtime under test
-- included, and for graphs of its fixture modules.
export function isTestGraph(g: any): boolean
    local item = graphs[g]
    if item and item.state.review and item.state.review.unreviewed then
        return true
    end

    return isUnitModule(g.source and g.source.module)
end

-- True for fixture modules of a test build. Ownership-provenance checks that
-- name the reviewed runtime callers accept these callers instead.
export function isUnitModule(name: string?): boolean
    return name ~= nil and unitModules[name] == true
end

export function owners(catalogue: any): any
    local state = need(catalogs[catalogue], "unissued service catalogue")
    reviewUnchanged(state.review)
    local result = {}
    for index, item in ipairs(state.order) do
        result[index] = item.owner
    end

    return result
end

export function validateCatalog(catalogue: any): nil
    local state = need(catalogs[catalogue], "unissued service catalogue")
    reviewUnchanged(state.review)
    unit.finish(state.entry)
end

-- Read-only upper bounds for the reviewed service closure. These two bits do
-- not issue a managed result, a root token, or a noncollecting call permission.
-- Raw writes may alias roots; the ordinary effect summary conservatively keeps
-- them hazardous until an actual caller proves the destination relationship.
export function heapEffects(catalogue: any, holder: any): (boolean, boolean)
    local state = need(catalogs[catalogue], "unissued service catalogue")
    need(state.owners[holder] ~= nil, "heap effect owner is outside service catalogue")
    reviewUnchanged(state.review)
    unit.finish(state.entry)
    local collector = unit.ownerModule(state.entry, "nupp.runtime.vm.collector")
    local heap = unit.ownerModule(state.entry, "nupp.runtime.vm.heap")
    local weak = unit.ownerModule(state.entry, "nupp.runtime.vm.gcweak")
    -- Exact checked bodies that enter collector phases or invalidate managed
    -- storage. Mapping pages and growing the gray stack are not collection.
    local collecting = {}

    local function seed(dest: any): nil
        need(dest ~= nil and unit.sameOwners(state.entry, dest), "heap effect seed belongs to a foreign checked unit")
        collecting[dest] = true
    end

    seed(collector.exports.startCycle)
    seed(collector.functions.markSome)
    seed(collector.functions.sweepSome)
    seed(collector.exports.checkOracle)
    seed(heap.exports.destroy)
    seed(heap.functions.releaseLarge)
    seed(heap.exports.retire)
    seed(heap.exports.recycle)
    seed(heap.exports.reclaim)
    seed(weak.exports.release)
    local effects, queue = {}, {}
    for _, item in ipairs(state.order) do
        held(item.signature)
        validateHeapEffect(item.heapEffect, item.body.effectSummary)
        local summary = item.effect
        -- Unknown/external effects and escaped storage can mutate registered
        -- roots. Host box allocation is deliberately not guest collection.
        local mutates = summary == nil
            or summary.top ~= false
            or summary.external ~= false
            or summary.yields ~= false
            or summary.writes == nil
            or next(summary.writes) ~= nil
            or summary.escapes == nil
            or next(summary.escapes) ~= nil
            or summary.shapes == nil
            or next(summary.shapes) ~= nil
            or summary.metatables == nil
            or next(summary.metatables) ~= nil
        local collects = collecting[item.owner] == true
        effects[item.owner] = {collects = collects, mutates = mutates}
        if collects or mutates then
            queue[#queue + 1] = item.owner
        end
    end
    local sites = {}
    for node, primitive in pairs(state.intrinsics) do
        sites[#sites + 1] = {owner = primitive.owner, call = node, kind = "intrinsic"}
    end
    for node, call in pairs(state.calls) do
        if call.os then
            sites[#sites + 1] = {owner = call.owner, call = node, kind = "os"}
        end
    end
    local declarations = unit.externalDeclarations(state.entry, sites)
    for node, primitive in pairs(state.intrinsics) do
        local actual = declarations[node]
        local verified = primitive.checked
        need(
            actual.definition == verified.definition
            and actual.receiver == verified.receiver
            and actual.signature == verified.signature
            and actual.name == verified.name
            and actual.context == verified.context,
            "heap effect intrinsic binding changed"
        )
        local effect = effects[primitive.owner]
        effect.collects = effect.collects or primitive.collects
        effect.mutates = effect.mutates or primitive.mutates
        if primitive.collects or primitive.mutates then
            queue[#queue + 1] = primitive.owner
        end
    end
    -- Validate the exact resolved calls before using the private reverse edges.
    -- Cleanup edges are part of the same unit's checked terminal registrations.
    for node, call in pairs(state.calls) do
        if call.raising then
            need(unit.literalRaise(call.owner, node) ~= nil, "heap effect raise changed")
        elseif call.os then
            local actual = declarations[node]
            need(
                actual.definition == call.os.definition and actual.signature == call.os.signature,
                "heap effect OS declaration changed"
            )
        else
            unit.call(call.owner, node, call.target)
        end
    end
    local cursor = 1
    while cursor <= #queue do
        local dest = queue[cursor]
        cursor = cursor + 1
        local source = effects[dest]
        for caller in pairs(state.reverse[dest]) do
            local previous = effects[caller]
            local collects = previous.collects or source.collects
            local mutates = previous.mutates or source.mutates
            if collects ~= previous.collects or mutates ~= previous.mutates then
                previous.collects, previous.mutates = collects, mutates
                queue[#queue + 1] = caller
            end
        end
    end
    local result = effects[holder]

    return result.collects, result.mutates
end

export function recordTarget(g: any, decl: any, node: any): any
    local call = need(calls[decl], "unissued service operation")
    need(graphs[g] == call.caller, "service operation owner/site differs")
    -- A terminal retains its checked acquisition/binding declaration, but
    -- runs at an actual exit occurrence. Ordinary calls retain exact sites.
    if call.cleanup then
        unit.occurrence(call.caller.owner, node)
    else
        need(call.node == node, "service operation owner/site differs")
    end
    validateIssued(decl)
    if call.retention then
        need(
            call.target.owner == unit.ownerModule(call.caller.owner, "nupp.runtime.core.servicescope").exports.retain,
            "retention helper source differs"
        )
    elseif call.cleanup then
        need(
            unit.cleanupTarget(call.caller.owner, call.node, call.cleanupType, call.cleanup) == call.target.owner,
            "service cleanup source differs"
        )
    elseif call.os then
        local actual = unit.osDeclaration(call.caller.owner, node)
        need(
            actual.definition == call.os.definition and actual.signature == call.os.signature,
            "service OS source differs"
        )
    elseif call.raising then
        need(unit.literalRaise(call.caller.owner, node), "service raise source differs")
    else
        unit.call(call.caller.owner, node, call.target.owner)
    end

    return call.target.owner
end

-- A redirected OS call has a checked external source call and a different
-- exact Nupp wrapper target. Its existing private service record binds both;
-- it cannot carry an ordinary same-target physical call-site signature.
export function redirectedCall(g: any, decl: any): boolean
    local call = calls[decl]
    if not call or not call.os then
        return false
    end
    need(graphs[g] == call.caller, "redirected pointer caller differs")
    validateIssued(decl)
    local catalogCall = call.caller.state.calls[call.node]
    need(
        catalogCall
        and catalogCall.owner == call.caller.owner
        and catalogCall.target == call.target.owner
        and catalogCall.os == call.os,
        "redirected pointer catalog binding differs"
    )
    need(recordTarget(g, decl, call.node) == call.target.owner, "redirected pointer source identity differs")
    need(decl.physical and decl.physical.owner == call.target.owner, "redirected pointer signature owner differs")

    return true
end

export function finish(g: any): nil
    local item = graphs[g]
    if item then
        verifyScope(g)
        reviewUnchanged(item.state.review)
        unit.finish(item.owner)
    end
end
