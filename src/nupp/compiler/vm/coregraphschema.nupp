module nupp.compiler.vm.coregraphschema

local graphsignatures = require("nupp.compiler.vm.graphsignatures")
local opcodes = require("nupp.compiler.vm.opcodes")
local schema = {}

-- Program-size bounds: the one source the contracts, codec, verifier, budget,
-- executable and the generated native policies read. Each stays finite and
-- checked, since a raw image is a trust boundary. Per program: owners (module
-- initializers and functions), signatures, modules, call sites (`calls`),
-- executable instructions, and the semantic tree's items and text bytes
-- (`treeitems`, `treetext`). Per function: blocks, values and items
-- (operations, operands, positions). Sized for the compiler on the core:
-- about 400 modules and tens of thousands of functions.
type schema.Limits = {
    owners: integer,
    signatures: integer,
    modules: integer,
    calls: integer,
    instructions: integer,
    treeitems: integer,
    treetext: integer,
    blocks: integer,
    values: integer,
    items: integer
}

local bounds: schema.Limits = {
    owners = 65536,
    signatures = 65536,
    modules = 65536,
    calls = 16777216,
    instructions = 16777216,
    treeitems = 268435456,
    treetext = 1073741824,
    blocks = 4096,
    values = 65536,
    items = 1048576
}

-- A fresh copy of the program-size bounds.
function schema.limits(): schema.Limits
    return {
        owners = bounds.owners,
        signatures = bounds.signatures,
        modules = bounds.modules,
        calls = bounds.calls,
        instructions = bounds.instructions,
        treeitems = bounds.treeitems,
        treetext = bounds.treetext,
        blocks = bounds.blocks,
        values = bounds.values,
        items = bounds.items
    }
end

-- The most bytes a guest artifact holds: the native bridge's region limits
-- are held to it (native/core/bridge reads this function's literal). Apart
-- from `limits`, which a raw image's schema describes.
function schema.artifactBytes(): integer
    return 1073741824
end

-- IDs and admission policy are versioned here. Operand definitions are copied
-- from the canonical graph tables; these rows do not define execution behavior.
local operations = {
    {name = "K", signature = "Vk", effect = 0, provenance = "constant"},
    {name = "Require", signature = "Vk", effect = 1, provenance = "module"},
    {name = "Nil", signature = "V", effect = 0, provenance = "nil"},
    {name = "Move", signature = "Vv", effect = 0, provenance = "copy"},
    -- Zero captures do not make creation pure: each evaluation still creates
    -- an instance. Catalog owner identity is not closure value identity.
    {name = "Closure", signature = "Vn", effect = 1, provenance = "function"}
}

local function copyArray(values: any): any
    local result = {}
    for index, value in ipairs(values) do
        result[index] = value
    end

    return result
end

-- describe() supplies the semantic schema. wire() supplies physical records
-- consumed by the host codec and generated native layout checks.
-- Checked-source profiles grow monotonically: each version admits everything
-- the previous one did, except that v5 and v6 exclude calls, Require and
-- Closure because those loop profiles do not bound repeated allocation; v7
-- admits them again, and the executable refuses a closure created in a loop.
-- Only v2 has a raw wire form; v3 and later are trusted checked-source input.
function schema.describe(version: integer?): any
    local v: integer = version or 2
    assert(v >= 2 and v <= 8, "unknown source graph profile")
    local loops = v >= 5
    local policies = {}
    for _, policy in ipairs(operations) do
        if not loops or v >= 7 or policy.name ~= "Require" and policy.name ~= "Closure" then
            policies[#policies + 1] = policy
        end
    end
    local arithmetic = {}
    if v >= 3 then
        arithmetic[#arithmetic + 1] = "Add"
    end
    if v >= 4 then
        arithmetic[#arithmetic + 1] = "Lt"
    end
    if v >= 6 then
        for _, name in ipairs({"Sub", "Mul", "Mod", "Le", "Eq"}) do
            arithmetic[#arithmetic + 1] = name
        end
    end
    for _, name in ipairs(arithmetic) do
        policies[#policies + 1] = {name = name, signature = "Vvv", effect = v >= 6 and 1 or 0, provenance = "number"}
    end
    -- v7 closures capture by value or through cells on the collected heap.
    if v >= 7 then
        policies[#policies + 1] = {name = "NewCell", signature = "Vv", effect = 1, provenance = "cell"}
        policies[#policies + 1] = {name = "GetCell", signature = "Vv", effect = 0, provenance = "cell"}
        policies[#policies + 1] = {name = "SetCell", signature = "vv", effect = 1, provenance = "cell"}
        policies[#policies + 1] = {name = "GetUpval", signature = "V#", effect = 0, provenance = "capture"}
    end
    if v >= 8 then
        policies[#policies + 1] = {name = "NewTable", signature = "V", effect = 1, provenance = "table"}
        policies[#policies + 1] = {name = "GetIdx", signature = "Vvv", effect = 1, provenance = "table"}
        policies[#policies + 1] = {name = "SetIdx", signature = "vvv", effect = 1, provenance = "table"}
        policies[#policies + 1] = {name = "Len", signature = "Vv", effect = 1, provenance = "table"}
        policies[#policies + 1] = {name = "MathFloor", signature = "Vv", effect = 1, provenance = "number"}
        policies[#policies + 1] = {name = "LibCall", signature = "V#", effect = 1, provenance = "library"}
        policies[#policies + 1] = {name = "Destroy", signature = "vv", effect = 1, provenance = "cleanup"}
        policies[#policies + 1] = {name = "Not", signature = "Vv", effect = 0, provenance = "boolean"}
    end
    local scalarKinds: any = {{id = 0, name = "boolean"}, {id = 1, name = "nil"}}
    if v >= 3 then
        scalarKinds[#scalarKinds + 1] = {id = 2, name = "number"}
    end
    local terms: any = {
        {id = 0, name = "return", edges = 0, effect = 0},
        {id = 1, name = "jump", edges = 1, effect = 0},
        {id = 2, name = "branch", edges = 2, effect = 0}
    }
    if not loops or v >= 7 then
        terms[#terms + 1] = {id = 3, name = "invoke", edges = 1, effect = 1}
    end
    local profiles = {
        "boolean-nil-acyclic-import-v2",
        "number-add-source-v3",
        "number-branch-source-v4",
        "number-loop-source-v5",
        "numeric-loop-source-v6",
        "numeric-call-source-v7",
        "table-source-v8"
    }
    local described: any = {
        magic = "NUPPCGRF",
        version = v,
        profile = profiles[v - 1],
        byteOrder = "little",
        alignment = 8,
        absent = 4294967295,
        limits = schema.limits(),
        scalarKinds = scalarKinds,
        effects = {
            {id = 0, mayCollect = false, mayRaise = false, mayPark = false, pure = true},
            {id = 1, mayCollect = true, mayRaise = true, mayPark = false, pure = false}
        },
        terms = terms,
        operations = {},
        sections = {
            {id = 0, name = "schema", fields = {"version", "profile", "operations", "terms", "scalarKinds", "effects"}},
            {id = 1, name = "catalog", fields = {"id", "kind", "parent", "signature", "graph", "effect"}},
            {id = 2, name = "signatures", fields = {"id", "kind", "params", "result"}},
            {
                id = 3,
                name = "graphs",
                fields = {
                    "programOwner",
                    "nparams",
                    "counts",
                    "types",
                    "slots",
                    "constants",
                    "blocks",
                    "positions",
                    "certificates",
                    "name",
                    "module",
                    "path",
                    "source"
                }
            },
            {id = 4, name = "blocks", fields = {"id", "params", "op", "dst", "args", "pos", "cert", "term"}},
            {
                id = 5,
                name = "terms",
                fields = {"kind", "value", "callee", "args", "contract", "result", "edges", "pos"}
            },
            {
                id = 6,
                name = "contracts",
                fields = {"id", "owner", "block", "callsite", "target", "signature", "effect"}
            },
            {id = 7, name = "positions", fields = {"line", "column", "source"}},
            {id = 8, name = "sourceBindings", fields = {"name", "module", "path"}},
            {id = 9, name = "positionSources", fields = {"moduleName", "path"}}
        },
        directory = {"kind:u32", "stride:u32", "count:u64", "offset:u64", "bytes:u64"},
        capabilities = {
            native = false,
            physical = false,
            captures = v >= 7,
            varargs = false,
            suspension = false,
            external = false,
            cachedStream = false
        },
        returns = {
            absentValueProduces = 0,
            presentValueProduces = 1,
            signatureNilIsVoid = false,
            paddingBelongsToCaller = true
        },
        runtimeChecks = {calleeOwner = true, scalarArguments = true, scalarResult = true}
    }
    for index, policy in ipairs(policies) do
        local signature = assert(graphsignatures.parsed[policy.name], "missing canonical graph signature")
        assert(graphsignatures.signatures[policy.name] == policy.signature, "canonical graph signature changed")
        assert(not signature.terminator, "operation became a terminator")
        local ordinary = opcodes.describe(policy.name)
        if ordinary then
            assert(not ordinary.frame and #ordinary.windows == 0, "implicit operation transport is unsupported")
        else
            assert(signature.coreOnly and signature.macro, "unknown graph-only operation")
        end
        described.operations[
            index
        ] = {
            id = index - 1,
            name = policy.name,
            signature = graphsignatures.signatures[policy.name],
            args = copyArray(signature.args),
            result = signature.result,
            resultAt = signature.resultAt,
            arity = signature.n,
            variadic = signature.variadic == true,
            variadicClass = signature.variadicClass,
            effect = policy.effect,
            admittedCaptureCount = policy.name == "Closure" and v < 7 and 0 or nil
        }
    end

    return described
end

-- Validation metadata only. Keep describe() and the wire schema unchanged.
-- These attributes classify persistent scalar provenance, not execution.
function schema.validationPolicy(): any
    local described, result = schema.describe(), {}
    for index, operation in ipairs(described.operations) do
        result[
            index
        ] = {
            id = operation.id,
            name = operation.name,
            args = copyArray(operation.args),
            result = operation.result,
            provenance = operations[index].provenance
        }
    end

    return result
end

-- Fixed records carry references and spans, never executable opcode policy.
-- Each field descriptor is consumed by both writer and reader. The profile's
-- canonical operation signatures still come from describe()/graph.signatures.
local wireRecords: {
    any
} = {
    {"schema", 16, "version:u32 profile:u32 capabilities:u32 returns:u32"},
    {"catalog", 24, "id:u32 kind:u32 parent:u32 signature:u32 graph:u32 effect:u32"},
    {"signatures", 24, "id:u32 kind:u32 result:u32 paramsFirst:u32 paramsCount:u32 reserved:zero"},
    {
        "graphs",
        80,
        "owner:u32 nparams:u32 nv:u32 ni:u32 nf:u32 nx:u32 valuesFirst:u32 valuesCount:u32 constantsFirst:u32 constantsCount:u32 blocksFirst:u32 blocksCount:u32 positionsFirst:u32 positionsCount:u32 name:u32 module:u32 path:u32 source:u32 certificates:zero reserved:zero"
    },
    {"blocks", 24, "id:u32 paramsFirst:u32 paramsCount:u32 opsFirst:u32 opsCount:u32 term:u32"},
    {
        "terms",
        40,
        "kind:u32 value:u32 callee:u32 result:u32 contract:u32 pos:u32 argsFirst:u32 argsCount:u32 edgesFirst:u32 edgesCount:u32"
    },
    {"contracts", 32, "id:u32 owner:u32 block:u32 callsite:u32 target:u32 signature:u32 effect:u32 reserved:zero"},
    {"positions", 16, "line:u32 column:u32 source:u32 reserved:zero"},
    {"sourceBindings", 16, "name:u32 module:u32 path:u32 reserved:zero"},
    {"positionSources", 8, "moduleName:u32 path:u32"},
    {"modules", 16, "name:u32 path:u32 chunk:u32 reserved:zero"},
    {"values", 8, "class:zero slot:u32"},
    {"constants", 8, "kind:u32 payload:u32"},
    {"operations", 24, "opcode:u32 dst:u32 argsFirst:u32 argsCount:u32 pos:u32 cert:zero"},
    {"edges", 16, "target:u32 argsFirst:u32 argsCount:u32 reserved:zero"},
    {"words", 4, "value:u32"},
    {"strings", 16, "offset:u64 bytes:u32 reserved:zero"},
    {"bytes", 1, ""}
}

-- Physical ownership and references are independent of SSA/type semantics.
-- Root sections own their rows; spans/singletons own non-interned child rows;
-- string references share interned rows and charge decoded string expansion.
local wireShapes: {
    any
} = {
    {"schema", 1, ""},
    {
        "catalog",
        bounds.owners,
        "id:ref:catalog kind:enum:ownerKinds parent:optionalRef:catalog signature:ref:signatures graph:ref:graphs effect:enum:effects"
    },
    {
        "signatures",
        bounds.signatures,
        "id:ref:signatures kind:enum:signatureKinds result:enum:scalarKinds paramsFirst:span:words:paramsCount:239"
    },
    {
        "graphs",
        bounds.owners,
        "owner:ref:catalog valuesFirst:span:values:valuesCount:65536 constantsFirst:span:constants:constantsCount:65536 blocksFirst:span:blocks:blocksCount:4096 positionsFirst:span:positions:positionsCount:1048576 name:string module:string path:string source:optionalOwned:sourceBindings"
    },
    {
        "blocks",
        nil,
        "paramsFirst:span:words:paramsCount:65536 opsFirst:span:operations:opsCount:1048576 term:owned:terms"
    },
    {
        "terms",
        nil,
        "kind:enum:terms contract:optionalRef:contracts argsFirst:span:words:argsCount:239 edgesFirst:span:edges:edgesCount:2"
    },
    {
        "contracts",
        bounds.calls,
        "id:ref:contracts owner:ref:catalog target:ref:catalog signature:ref:signatures effect:enum:effects"
    },
    {"positions", nil, "source:optionalOwned:positionSources"},
    {"sourceBindings", nil, "name:string module:string path:string"},
    {"positionSources", nil, "moduleName:string path:string"},
    {"modules", bounds.modules, "name:string path:string chunk:ref:catalog"},
    {"constants", nil, "kind:enum:constantKinds payload:string"},
    {"operations", nil, "opcode:enum:operations argsFirst:span:words:argsCount:1048576"},
    {"edges", nil, "argsFirst:span:words:argsCount:65536"}
}

-- The raw v2 wire, the untrusted loader's input. Its aggregate limits (a
-- 64 MiB file, 1,048,576 records and as much expansion across the program)
-- hold a raw image to about 12,000 owners, below the program-size bounds
-- above. That is deliberate: the raw profile executes one scalar initializer
-- (K, Nil, Move, Ret) and is not how a compiler-sized program reaches the
-- core, which is the checked v8 catalog (coregraphexecutable, guestartifact).
-- When the native raw loader is bound to that catalog, these limits are
-- raised with its executable profile.
function schema.wire(): any
    local result: any = {
        magic = "NUPPCGRF",
        version = 2,
        profile = 2,
        headerBytes = 48,
        directoryBytes = 32,
        fileLimit = 67108864,
        recordsLimit = 1048576,
        stringLimit = 16777216,
        expandedLimit = 1048576,
        sections = {},
        ownerKinds = {{id = 0, name = "module"}, {id = 1, name = "function"}},
        signatureKinds = {{id = 0, name = "initializer"}, {id = 1, name = "callable"}},
        constantKinds = {
            {id = 0, name = "nil"},
            {id = 1, name = "true"},
            {id = 2, name = "false"},
            {id = 3, name = "str"}
        },
        header = {},
        directory = {}
    }

    local function descriptor(name: string, stride: integer, declaration: string): any
        local fields, offset = {}, 0
        for field, kind in declaration:gmatch("(%w+):(%w+)") do
            fields[#fields + 1] = {name = field, kind = kind, offset = offset}
            offset += kind == "u64" and 8 or 4
        end
        assert(offset == stride or stride == 1 and #fields == 0, "wire descriptor stride differs")

        return {name = name, stride = stride, fields = fields}
    end

    result.policy = {version = result.version, profile = result.profile, capabilities = 0, returns = 1}
    result.header = descriptor(
        "header",
        40,
        "version:u32 profile:u32 sections:u32 entry:u32 bytes:u64 flags:zero reserved:zero directory:u64"
    )
    result.directory = descriptor("directory", 32, "kind:u32 stride:u32 count:u64 offset:u64 bytes:u64")
    for index, row in ipairs(wireRecords) do
        local item = descriptor(row[1], row[2], row[3])
        item.id = index - 1
        result.sections[index] = item
    end

    local definition = schema.describe()
    result.absent = definition.absent
    local byName = {}
    result.shape = {
        stringItemLimit = 1048576,
        roles = {"word", "zero", "bounded64", "enum", "ref", "optionalRef", "owned", "optionalOwned", "span", "string"}
    }
    for _, section in ipairs(result.sections) do
        byName[section.name] = section
        for _, field in ipairs(section.fields) do
            field.role = {kind = field.kind == "u64" and "bounded64" or field.kind == "zero" and "zero" or "word"}
        end
    end
    for _, rule in ipairs(wireShapes) do
        local section = assert(byName[rule[1]])
        section.rootLimit = rule[2]
        local fields = {}
        for _, field in ipairs(section.fields) do
            fields[field.name] = field
        end
        for declaration in rule[3]:gmatch("%S+") do
            local parts = {}
            for part in declaration:gmatch("[^:]+") do
                parts[#parts + 1] = part
            end
            local field = assert(fields[parts[1]], "unknown wire shape field")
            local role: any = {kind = parts[2]}
            if role.kind == "enum" then
                role.limit = #assert(result[parts[3]] or definition[parts[3]], "unknown wire enum")
            elseif role.kind ~= "string" then
                role.target = assert(byName[parts[3]], "unknown wire shape target").id
            end
            if role.kind == "span" then
                role.count = assert(fields[parts[4]], "unknown wire span count").name
                role.countOffset = fields[parts[4]].offset
                role.limit = assert(tonumber(parts[5]))
            end
            field.role = role
        end
    end

    return result
end

export = schema
