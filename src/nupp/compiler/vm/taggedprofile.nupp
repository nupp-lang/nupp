module nupp.compiler.vm.taggedprofile

local graph = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")
local corelibrary = require("nupp.compiler.vm.corelibrary")
local graphcalls = require("nupp.compiler.vm.graphcalls")
local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local indexedviews = require("nupp.compiler.types.indexedviews")
local indexedaccess = require("nupp.compiler.vm.indexedaccess")
local taggedvalues = require("nupp.compiler.vm.taggedvalues")
local taggedcalls = require("nupp.compiler.vm.taggedcalls")
local taggedstatements = require("nupp.compiler.vm.taggedstatements")
local scalartypeof = require("nupp.compiler.vm.scalartypeof")
local ownedclosures = require("nupp.compiler.vm.ownedclosures")
local construction = require("nupp.compiler.vm.construction")
local taggedstructs = require("nupp.compiler.vm.taggedstructs")
local exportforwarders = require("nupp.compiler.vm.exportforwarders")
local derivedmembers = require("nupp.compiler.vm.derivedmembers")
local recordcallables = require("nupp.compiler.vm.recordcallables")
local taggedforeign = require("nupp.compiler.vm.taggedforeign")
local taggedpredicate = require("nupp.compiler.vm.taggedpredicate")
local scalarcapabilities = require("nupp.compiler.vm.scalarcapabilities")
local scalarlanes = require("nupp.compiler.vm.scalarlanes")
local columnaraccess = require("nupp.compiler.vm.columnaraccess")
export const booleanKind = "tagged"
local binding = taggedvalues.binding
local catalog = taggedvalues.catalog
local cleanupProfile = taggedstatements.cleanupProfile
local construct = taggedcalls.construct
local coroutinepack = taggedcalls.coroutinepack
local coroutinepacked = taggedcalls.coroutinepacked
local defaultConstant = taggedcalls.defaultConstant
local fieldSlot = taggedvalues.fieldSlot
local interfacetype = taggedvalues.interfacetype
local keyedByName = taggedvalues.keyedByName
local invoke = taggedcalls.invoke
local invokeMethod = taggedcalls.invokeMethod
local invokeProtected = taggedcalls.invokeProtected
local landed = taggedvalues.landed
local libraryCall = taggedcalls.libraryCall
local qualifiedvalue = taggedvalues.qualifiedvalue
local librarypack = taggedcalls.librarypack
local need = taggedvalues.need
local numericFor = taggedstatements.numericFor
local ordinaryCaptures = taggedvalues.ordinaryCaptures
local ownership = taggedcalls.ownership
local packSpec = taggedcalls.packSpec
local packedkind = taggedvalues.packedkind
local pool = taggedvalues.pool
local printValues = taggedcalls.printValues
local recordOrigin = taggedvalues.recordOrigin
local requireSite = taggedcalls.requireSite
local sortWith = taggedcalls.sortWith
local stringSpec = taggedcalls.stringSpec
local typeKind = taggedvalues.typeKind
local valuespack = taggedcalls.valuespack
local typeNames = taggedvalues.typeNames

-- Each of `nodes` evaluated as a tagged value, or nil once one ends the block.
local function taggedOperands(ctx: any, nodes: {any}): {any}?
    local kinds = {}
    for index = 1, #nodes do
        kinds[index] = "tagged"
    end

    return ctx.operands(nodes, kinds)
end

-- An operation on a vector or a mask (scalarlanes): its operands in source
-- order, then `simd.lane[member]` called with the operation's name and
-- element ahead of them, through `any` at the operation's own callsite.
local function laneCall(ctx: any, node: any, keepResult: boolean, count: integer?): any
    local site = need(catalog(ctx).laneCalls[node], "lane operation lacks its checked callsite")
    local operation = site.node.laneOperation
    local kinds: {string} = {}
    for index = 1, #operation.operands do
        kinds[index] = "tagged"
    end
    local values = ctx.operands(operation.operands, kinds)
    if values == nil then
        return nil
    end
    local held: {any} = {}
    for index, value in ipairs(values) do
        held[index] = ctx.hold(value)
    end
    local name = ctx.emit(node, "K", {pool(ctx, "str", scalarlanes.MODULE)}, "tagged")
    local module = ctx.emit(node, "LibCall", {corelibrary.id("MODULE_REQUIRE"), name}, "tagged")
    local runtimeKey = ctx.emit(node, "K", {pool(ctx, "str", scalarlanes.RUNTIME)}, "tagged")
    local runtime = ctx.emit(node, "GetIdx", {module, runtimeKey}, "tagged")
    local memberKey = ctx.emit(node, "K", {pool(ctx, "str", operation.member)}, "tagged")
    local callee = ctx.hold(ctx.emit(node, "GetIdx", {runtime, memberKey}, "tagged"))
    local args: {integer} = {}
    for _, text in ipairs(operation.leads) do
        args[#args + 1] = ctx.emit(node, "K", {pool(ctx, "str", text)}, "tagged")
    end
    for _, handle in ipairs(held) do
        args[#args + 1] = ctx.readHeld(handle)
    end
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    for index = #held, 1, -1 do
        ctx.release(held[index])
    end
    if count ~= nil then
        -- `local a, b = v:interleave(w)` keeps each of the operation's results.
        local contract = graph.dynamicInvokeContract(site.node, count)
        return landed(ctx, node, ctx.invokeMany(node, value, args, contract, count))
    end
    local answer = ctx.invoke(node, value, args, graph.dynamicInvokeContract(site.node, 1), keepResult)
    if not keepResult then
        return answer
    end

    return landed(ctx, node, answer)
end

-- The profile's hooks with each lane operation (scalarlanes) lowered as a
-- call of the lane runtime ahead of what they lower.
local function laneOperations(profile: any): nil
    local function routed(hook: string): nil
        local lower = profile[hook]
        if lower == nil then
            return
        end
        profile[hook] = function(ctx: any, node: any, expected: string?): integer?
            if catalog(ctx).laneCalls[node] ~= nil then
                need(expected == nil or expected == "tagged", "lane operation requires tagged destination")
                return laneCall(ctx, node, true)
            end

            return lower(ctx, node, expected)
        end
    end

    routed("binary")
    routed("unary")
    routed("call")
    routed("methodCall")
    local results = profile.callResults
    if results ~= nil then
        profile.callResults = function(ctx: any, node: any, count: integer): any
            if catalog(ctx).laneCalls[node] ~= nil then
                return laneCall(ctx, node, true, count)
            end
            return results(ctx, node, count)
        end
    end
    local statement = profile.statementCall
    if statement ~= nil then
        profile.statementCall = function(ctx: any, node: any): nil
            if catalog(ctx).laneCalls[node] ~= nil then
                laneCall(ctx, node, false)
                return
            end
            statement(ctx, node)
        end
    end
end

-- Function `member` of the core's struct provider (columnaraccess), called
-- through `any` at `site` with `values`, each already evaluated.
local function providerInvoke(ctx: any, node: any, site: any, member: string, values: {integer}): integer?
    local held: {any} = {}
    for index, value in ipairs(values) do
        held[index] = ctx.hold(value)
    end
    local name = ctx.emit(node, "K", {pool(ctx, "str", columnaraccess.MODULE)}, "tagged")
    local module = ctx.emit(node, "LibCall", {corelibrary.id("MODULE_REQUIRE"), name}, "tagged")
    local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
    local callee = ctx.hold(ctx.emit(node, "GetIdx", {module, key}, "tagged"))
    local args: {integer} = {}
    for index, handle in ipairs(held) do
        args[index] = ctx.readHeld(handle)
    end
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    for index = #held, 1, -1 do
        ctx.release(held[index])
    end

    return landed(ctx, node, ctx.invoke(node, value, args, graph.dynamicInvokeContract(site.node, 1), true))
end

-- The struct provider call `node` is (columnaraccess.call): `ffi.typeof<T>()`
-- of a struct, its declaration's table given, or of a scalar, its name; a
-- columnar allocation or layout, given the checker's field specification.
local function providerCall(ctx: any, node: any): integer?
    local site = need(catalog(ctx).columnarCalls[node], "struct provider call lacks its checked callsite")
    local described = site.node.columnarCall
    if described.member == "descriptor" then
        local token = need(site.classToken, "struct descriptor lacks its declaration")
        local class = ctx.expression({kind = "name", token = token, token}, "tagged")
        if class == nil then
            return nil
        end
        return providerInvoke(ctx, node, site, "descriptor", {class})
    elseif described.member == "scalar" then
        local scalar = ctx.emit(node, "K", {pool(ctx, "str", described.scalar)}, "tagged")
        return providerInvoke(ctx, node, site, "scalar", {scalar})
    end
    local kinds: {string} = {}
    for index = 1, #described.operands do
        kinds[index] = "tagged"
    end
    local operands = ctx.operands(described.operands, kinds)
    if operands == nil then
        return nil
    end
    local held: {any} = {}
    for index, value in ipairs(operands) do
        held[index] = ctx.hold(value)
    end
    local layout = described.layout
    local spec = derivedmembers.plainData(ctx, node, {name = layout.name, spec = layout.spec, printed = layout.printed})
    local values: {integer} = {}
    if described.specFirst then
        values[1] = spec
    end
    for _, handle in ipairs(held) do
        values[#values + 1] = ctx.readHeld(handle)
    end
    if not described.specFirst then
        values[#values + 1] = spec
    end
    for index = #held, 1, -1 do
        ctx.release(held[index])
    end

    return providerInvoke(ctx, node, site, described.member, values)
end

-- The ordinal a columnar field method takes.
local function ordinalValue(ctx: any, node: any, access: any): integer
    return ctx.emit(node, "K", {pool(ctx, "int64", tostring(access.ordinal))}, "tagged") as integer
end

-- A read of a columnar view (columnaraccess.methods): its getter called with
-- the view, the row's index and the field's ordinal it names.
local function columnarRead(ctx: any, node: any, access: any): integer?
    local nodes = access.index ~= nil and {access.view, access.index} or {access.view}
    local kinds = access.index ~= nil and {"tagged", "tagged"} or {"tagged"}
    local prepared = ctx.operands(nodes, kinds)
    if prepared == nil then
        return nil
    end
    if access.ordinal ~= nil then
        local held: {any} = {}
        for index, value in ipairs(prepared) do
            held[index] = ctx.hold(value)
        end
        local ordinal = ordinalValue(ctx, node, access)
        for index, handle in ipairs(held) do
            prepared[index] = ctx.readHeld(handle)
        end
        for index = #held, 1, -1 do
            ctx.release(held[index])
        end
        prepared[#prepared + 1] = ordinal
    end

    return invokeMethod(ctx, access.read, true, nil, prepared)
end

-- The profile's hooks with the struct provider's calls and columnar views'
-- rows and fields (columnaraccess) lowered ahead of what they lower.
local function columnarOperations(profile: any): nil
    local call = profile.call
    profile.call = function(ctx: any, node: any, expected: string?): integer?
        if catalog(ctx).columnarCalls[node] ~= nil then
            need(expected == nil or expected == "tagged", "struct provider call requires tagged destination")
            return providerCall(ctx, node)
        end

        return call(ctx, node, expected)
    end
    local statementCall = profile.statementCall
    profile.statementCall = function(ctx: any, node: any): nil
        if catalog(ctx).columnarCalls[node] ~= nil then
            providerCall(ctx, node)
            return
        end
        statementCall(ctx, node)
    end
    for _, hook in ipairs({"fieldRead", "indexRead"}) do
        local lower = profile[hook]
        profile[hook] = function(ctx: any, node: any, expected: string?): integer?
            local access = catalog(ctx).columnarByNode[node]
            if access ~= nil then
                need(expected == nil or expected == "tagged", "columnar view read requires tagged destination")
                return columnarRead(ctx, node, access) as integer
            end

            return lower(ctx, node, expected)
        end
    end
    local assignmentTarget = profile.assignmentTarget
    profile.assignmentTarget = function(ctx: any, node: any, rhs: any): any
        local access = catalog(ctx).columnarByNode[node]
        if access ~= nil and access.write ~= nil then
            -- The view and the row's index, once, whatever the assignment
            -- reads and writes.
            local operands = ctx.operands({access.view, access.index}, {"tagged", "tagged"})
            if operands == nil then
                return {receiver = 0, kind = "tagged"}
            end
            return {receiver = operands[1], index = operands[2], kind = "tagged", columnar = access}
        end

        return assignmentTarget(ctx, node, rhs)
    end
    local readAssignment = profile.readAssignment
    profile.readAssignment = function(ctx: any, node: any, target: any): integer
        local access = target.columnar
        if access ~= nil then
            need(access.kind == "field", "a compound assignment to a whole columnar row is not admitted")
            local receiver, index = ctx.readHeld(target.heldReceiver), ctx.readHeld(target.heldIndex)
            local ordinal = ordinalValue(ctx, node, access)
            return invokeMethod(ctx, access.read, true, nil, {receiver, index, ordinal}) as integer
        end

        return readAssignment(ctx, node, target)
    end
    local assignTarget = profile.assignTarget
    profile.assignTarget = function(ctx: any, node: any, target: any, receiver: integer, value: integer): nil
        local access = target.columnar
        if access == nil then
            assignTarget(ctx, node, target, receiver, value)
            return
        end
        local index = ctx.readHeld(target.heldIndex)
        if access.kind == "field" then
            local held = ctx.hold(value)
            local ordinal = ordinalValue(ctx, node, access)
            invokeMethod(ctx, access.write, false, nil, {receiver, index, ordinal, ctx.readHeld(held)})
            ctx.release(held)
            return
        end
        invokeMethod(ctx, access.write, false, nil, {receiver, index, value})
    end
end

local function scalarwitness(ctx: any, node: any): any
    local described = catalog(ctx).scalartypes
    return described and described.witnesses[node] or nil
end

-- `tostring(x)` of a uint64, whose 64 bits the core holds as an integer:
-- its unsigned decimal. A negative integer is 2^64 more than it reads, so
-- its digits are those of q = (x >>> 1) // 5, the unsigned quotient by ten,
-- then the remainder x - 10q, which wraps back into 0 through 9. Any further
-- arguments are still evaluated, though tostring ignores them.
local function unsignedText(ctx: any, node: any, arguments: {any}): integer?
    local operands = taggedOperands(ctx, arguments)
    if operands == nil then
        return nil
    end
    local value = ctx.hold(operands[1])

    local function integer(n: integer): integer
        return ctx.emit(node, "K", {pool(ctx, "int64", tostring(n))}, "tagged") as integer
    end

    local function call(name: string, args: {integer}): integer
        return ctx.emit(node, "LibCall", {corelibrary.id(name), table.unpack(args)}, "tagged") as integer
    end

    local signed = call("TOSTRING", {ctx.readHeld(value)})
    local half = call("SHR", {ctx.readHeld(value), integer(1)})
    local quotient = call("FLOOR_DIVIDE", {half, integer(5)})
    local tens = ctx.emit(node, "Mul", {quotient, integer(10)}, "tagged")
    local remainder = ctx.emit(node, "Sub", {ctx.readHeld(value), tens}, "tagged")
    local unsigned = call("CONCAT2", {call("TOSTRING", {quotient}), call("TOSTRING", {remainder})})
    local negative = ctx.emit(node, "Lt", {ctx.readHeld(value), integer(0)}, "tagged")
    ctx.release(value)

    return ctx.select(node, negative, unsigned, signed)
end

export function initializeModule(fn: any, options: any): any
    need(options.program and options.program.owners[fn.id + 1] == fn, "checked module owner required")
    return graph.new(0)
end

local function setup(fn: any, options: any, alternatives: boolean): any
    need(options.program and options.program.owners[fn.id + 1] == fn, "checked function owner required")
    need(
        fn.node.kind == "localFuncStmt"
        or fn.node.kind == "funcExpr"
        or fn.node.kind == "funcStmt"
        or fn.node.kind == "inlineMethod"
        or fn.node.kind == "constructorDecl"
        or fn.node.kind == "shortfn",
        "unsupported function declaration form"
    )
    -- Plain type parameters erase, and so do const ones (`const N: integer`):
    -- a const parameter is a type, never a value the body reads.
    if fn.node.kind ~= "constructorDecl" and fn.signature.retPack.alternatives then
        need(alternatives, "correlated result alternatives are unsupported")
        graph.validatesignature(fn.signature)
    else
        need(
            fn.node.kind == "constructorDecl" or #fn.signature.rets <= graph.MAX_RESULTS,
            "a function returns at most sixteen results"
        )
    end
    ordinaryCaptures(fn)
    local params = graph.parameters(fn.body)
    for index, parameter in ipairs(params) do
        -- A `...` last is the hidden pack parameter, named or not.
        local pack = parameter.vararg and index == #params
        need(
            -- `takes`, `borrows` and `exclusive` are ownership facts the
            -- checker settled: the core passes the value.
            (parameter.name and not parameter.vararg or pack) and not parameter.constTok,
            "parameter ownership or variadic lowering is unsupported"
        )
    end

    return graph.new(#params)
end

export function initialize(fn: any, options: any): any
    return setup(fn, options, false)
end

export function valueKind(g: any, id: integer): string
    need(g.types[id] == "v", "tagged value required")
    return "tagged"
end

export function newValue(g: any, kind: string): integer
    need(kind == "tagged", "tagged value required")
    return graph.value(g, "v")
end

export function localKind(token: any, fn: any): string
    return "tagged"
end

export function emit(ctx: any, node: any, op: string, args: any, kind: string?): integer?
    need(kind == nil or kind == "tagged", "tagged result required")
    return graph.emit(ctx.g, ctx.block, op, args, ctx.position(node))
end

export function literal(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "literal requires tagged destination")
    local constant = need(
        catalog(ctx).byNode[node],
        "literal lacks checked constant identity: " .. tostring(
            node.kind
        ) .. " at line " .. tostring(node.token and node.token.line or node.op and node.op.line)
    )
    if constant.kind == "nil" then
        return ctx.emit(node, "Nil", {}, "tagged")
    end
    local value = constant.bytes
    if constant.kind == "int64" or constant.kind == "uint64" then
        value = constant.text
    end

    return ctx.emit(node, "K", {pool(ctx, constant.kind, value)}, "tagged")
end

export function valueLiteral(ctx: any, node: any, expected: string?): integer
    return literal(ctx, node, expected)
end

-- The order a comptime table's keys are built in: numbers, then strings,
-- then booleans, each in its own order, so a value builds the same way twice.
local function keyBefore(a: any, b: any): boolean
    local ranks: {[string]: integer} = {number = 1, string = 2, boolean = 3}
    local ra, rb = ranks[type(a)], ranks[type(b)]
    if ra ~= rb then
        return ra < rb
    elseif type(a) == "boolean" then
        return a == false and b == true
    end

    return a < b
end

-- Plain data a comptime block produced, built as the program runs: a scalar
-- as its constant, a table as a fresh one holding its keys' values.
local function comptimeData(ctx: any, node: any, value: any): integer
    local kind = type(value)
    if value == nil then
        return ctx.emit(node, "Nil", {}, "tagged") as integer
    elseif kind == "boolean" then
        return ctx.emit(node, "K", {pool(ctx, value and "true" or "false", "")}, "tagged") as integer
    elseif kind == "string" then
        return ctx.emit(node, "K", {pool(ctx, "str", value)}, "tagged") as integer
    elseif kind == "number" then
        if math.type(value) == "integer" then
            return ctx.emit(node, "K", {pool(ctx, "int64", tostring(value))}, "tagged") as integer
        end
        return ctx.emit(node, "K", {pool(ctx, "num", graphimage.floatBytes(value as number))}, "tagged") as integer
    end
    need(kind == "table", "a comptime value is plain data")
    local keys = {}
    for key in pairs(value) do
        keys[#keys + 1] = key
    end
    table.sort(keys, keyBefore)
    local held = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
    for _, key in ipairs(keys) do
        local heldKey = ctx.hold(comptimeData(ctx, node, key))
        local entry = comptimeData(ctx, node, value[key])
        if ctx.block == nil then
            ctx.release(heldKey)
            ctx.release(held)
            return nil as any
        end
        ctx.emit(node, "SetIdx", {ctx.readHeld(held), ctx.readHeld(heldKey), entry}, nil)
        ctx.release(heldKey)
    end
    local result = ctx.readHeld(held)
    ctx.release(held)

    return result as integer
end

-- The runtime module whose keyed field codec a materialized
-- `types.reflect.fieldcodec` calls.
const RUNTIME_REFLECT = "nupp.compiler.runtime.reflect"

local function stringConstant(ctx: any, node: any, text: string): integer
    return ctx.emit(node, "K", {pool(ctx, "str", text)}, "tagged") as integer
end

-- IR `item` of the materialized comptime value `node`
-- (nupp.compiler.comptime.materialize.ir), lowered as the expression it
-- renders to: its type objects read through the references the program
-- graph issued, and its calls made through `any` at the callsites it
-- issued. Closures are not lowered yet.
local materialized: function(any, any, any): integer?
materialized = function(ctx: any, node: any, item: any): integer?
    local made = need(catalog(ctx).materializations[node], "a materialization was not discovered")
    local tag = item.tag
    if tag == "literal" then
        return defaultConstant(ctx, node, item.value)
    elseif tag == "helper" then
        need(item.name == "nupp.fieldcodec.keyed", "a materialization names an unknown helper")
        local name = stringConstant(ctx, node, RUNTIME_REFLECT)
        local loader = corelibrary.immediate(corelibrary.id("MODULE_REQUIRE"), false)
        local module = ctx.emit(node, "LibCall", {loader, name}, "tagged")
        return ctx.emit(node, "GetIdx", {module, stringConstant(ctx, node, "keyedFieldCodec")}, "tagged")
    elseif tag == "typeobject" then
        local value: integer? = nil
        for member in (item.path as string):gmatch("[^.]+") do
            if value == nil then
                local token = need(made.tokens[member], "a materialized type object has no reference")
                value = ctx.expression({kind = "name", token = token, token}, "tagged")
                if value == nil then
                    return nil
                end
            else
                value = ctx.emit(node, "GetIdx", {value, stringConstant(ctx, node, member)}, "tagged")
            end
        end
        return value
    elseif tag == "field" then
        local object = materialized(ctx, node, item.object)
        return object and ctx.emit(node, "GetIdx", {object, stringConstant(ctx, node, item.name)}, "tagged")
    elseif tag == "table" then
        local held = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
        local entries = {}
        for index, child in ipairs(item.array or {}) do
            entries[#entries + 1] = {key = index, value = child}
        end
        for _, field in ipairs(item.fields or {}) do
            entries[#entries + 1] = {key = field.name, value = field.value}
        end
        for _, entry in ipairs(entries) do
            local value = materialized(ctx, node, entry.value)
            if value == nil or ctx.block == nil then
                ctx.release(held)
                return nil
            end
            local key = type(entry.key) == "string" and stringConstant(ctx, node, entry.key)
                or ctx.emit(node, "K", {pool(ctx, "int64", tostring(entry.key))}, "tagged")
            ctx.emit(node, "SetIdx", {ctx.readHeld(held), key, value}, nil)
        end
        local result = ctx.readHeld(held)
        ctx.release(held)
        return result
    elseif tag == "call" then
        local call = need(made.calls[item], "a materialized call has no callsite")
        local parts = {item.callee}
        for _, argument in ipairs(item.args or {}) do
            parts[#parts + 1] = argument
        end
        local held = {}
        for index, part in ipairs(parts) do
            local value = materialized(ctx, node, part)
            if value == nil or ctx.block == nil then
                for _, handle in ipairs(held) do
                    ctx.release(handle)
                end
                return nil
            end
            held[index] = ctx.hold(value)
        end
        local values = {}
        for index, handle in ipairs(held) do
            values[index] = ctx.readHeld(handle)
            ctx.release(handle)
        end
        local callee = table.remove(values, 1)
        return ctx.invoke(call, callee, values, graph.dynamicInvokeContract(call, 1), true)
    end

    error("tagged graph: a comptime materialization's " .. tostring(tag) .. " is not lowered on the core yet", 0)
end

-- A `comptime` block the checker ran stands for the value it produced,
-- which the checker quoted as Lua source of plain data, or, materialized,
-- the code it chose to make it.
export function comptime(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "comptime requires tagged destination")
    if node.materializedIR ~= nil then
        return materialized(ctx, node, node.materializedIR) as integer
    end
    local text = need(node.comptimeValue, "a comptime block lacks its checked value")
    local chunk = need(load("return " .. text, "=comptime", "t", {}), "a comptime value does not load")

    return comptimeData(ctx, node, chunk())
end

export function constant(ctx: any, node: any, expected: string?): integer
    if node.captureValue then
        for _, item in ipairs(ctx.fn.captures) do
            local capture = item.ownership
            if item.mode == "take"
                and item.inner == node.token.definition
                and capture
                and capture.automaticOwner
                and capture.automaticOwner.expr == node
                and capture.automaticOwner.stat == ctx.fn.body.captureBindingStat
            then
                return ctx.emit(node, "GetUpval", {item.id}, "tagged")
            end
        end
        error("tagged graph: capture initializer lacks its checked taking slot", 0)
    end

    local value = qualifiedvalue(ctx, node) or taggedvalues.globalValue(ctx, node)
    if value ~= nil then
        return value
    end
    local token = cst.firstToken(node)
    error(
        "tagged graph: unresolved lexical or external value: " .. tostring(
            node.kind
        ) .. (
            node.name and node.name.text and " ." .. node.name.text or ""
        ) .. (
            node.obj and " on " .. tostring(node.obj.inferredType and node.obj.inferredType.tag) or ""
        ) .. " " .. tostring(
            token and token.text
        ) .. " at " .. tostring(ctx.fn and ctx.fn.scope and ctx.fn.scope.path) .. ":" .. tostring(token and token.line),
        0
    )
end

-- A reassigned local's own copy of a parameter's value (functiongraph).
export function freshLocal(ctx: any, node: any, value: integer): integer
    return ctx.emit(node, "Move", {value}, "tagged") as integer
end

-- A static switch case is equality dispatch: its constant against the
-- selector, as Lua's == compares them.
export function switchCase(ctx: any, value: any, subject: integer, kind: string): integer
    local candidate = need(ctx.expression(value, "tagged"), "switch case lost its value")

    return ctx.emit(value, "Eq", {subject, candidate}, "tagged") as integer
end

export function unary(ctx: any, node: any, expected: string?): integer
    need(catalog(ctx).byNode[node] ~= nil, "nonliteral unary operations are unsupported")
    return literal(ctx, node, expected)
end

export function binary(ctx: any, node: any, expected: string?): integer?
    return taggedstatements.binary(ctx, node, expected, 2)
end

export function checkLogical(ctx: any, node: any): boolean
    error("tagged graph: logical expressions are outside lexical construction", 0)
end

export function missingLocal(ctx: any, node: any, expected: string?): integer
    return ctx.emit(node, "Nil", {}, "tagged")
end

export function initializeBinding(ctx: any, node: any, key: any, value: integer): integer
    local b = binding(ctx, key)
    need(b.owner == ctx.fn.id and b.storage ~= "erased", "invalid local storage owner")
    if catalog(ctx).classCells[key] then
        local cell = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
        local slot = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
        ctx.emit(node, "SetIdx", {ctx.readHeld(cell), slot, value}, nil)
        local answer = ctx.readHeld(cell)
        ctx.release(cell)
        return answer
    end

    return b.storage == "cell" and ctx.emit(node, "NewCell", {value}, "tagged") or value
end

export function readBinding(ctx: any, node: any, key: any, value: integer, expected: string?): integer
    need(expected == nil or expected == "tagged", "lexical read requires tagged value")
    if catalog(ctx).classCells[key] then
        local slot = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
        return ctx.emit(node, "GetIdx", {value, slot}, "tagged")
    end

    return binding(ctx, key).storage == "cell" and ctx.emit(node, "GetCell", {value}, "tagged") or value
end

export function writeBinding(ctx: any, node: any, key: any, previous: integer, value: integer): integer
    local b = binding(ctx, key)
    -- A function statement fills the cell made for it before its closure, a
    -- recursive local or a hoisted export.
    need(
        not b.definition.constant or node.kind == "localFuncStmt" or node.kind == "funcStmt",
        "assignment to immutable declaration"
    )
    if b.storage == "cell" then
        if catalog(ctx).classCells[key] then
            local slot = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
            ctx.emit(node, "SetIdx", {previous, slot, value}, nil)
        else
            ctx.emit(node, "SetCell", {previous, value}, nil)
        end
        return previous
    end
    need(b.owner == ctx.fn.id, "assignment cannot replace captured value storage")

    return value
end

export function recordBindings(ctx: any, stats: any): nil
    for _, stat in ipairs(stats) do
        local node = stat.kind == "exportStmt" and stat.stat or stat
        if node and recordcallables.record(node) then
            local key = node.name.definition
            if catalog(ctx).classCells[key] and not ctx.bound(key) then
                ctx.bind(key, ctx.emit(node, "NewTable", {}, "tagged"))
            end
        end
    end
end

export function entryBindings(ctx: any, node: any): nil
    ordinaryCaptures(ctx.fn)
    for _, item in ipairs(ctx.fn.captures) do
        local value = ctx.emit(node, "GetUpval", {item.id}, "tagged")
        if item.mode ~= "take" then
            ctx.bind(item.definition, value)
        end
    end
end

export function recursiveBinding(ctx: any, node: any, key: any): integer?
    if catalog(ctx).classCells[key] then
        return ctx.emit(node, "NewTable", {}, "tagged")
    end
    if binding(ctx, key).storage == "cell" then
        local value = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.emit(node, "NewCell", {value}, "tagged")
    end

    return nil
end

export function closure(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "closure requires tagged destination")
    need(
        node.kind == "localFuncStmt"
        or node.kind == "funcExpr"
        or node.kind == "funcStmt"
        or node.kind == "inlineMethod"
        or node.kind == "constructorDecl"
        or node.kind == "shortfn",
        "unsupported function declaration form"
    )
    -- A short function `|x| -> e` is its own body.
    local body = node.kind == "shortfn" and node or node.body
    local target = need(catalog(ctx).byBody[body], "closure lacks checked owner")
    need(target.node == node and target.parent == ctx.fn.id, "closure owner identity mismatch")
    ordinaryCaptures(target)
    local args = {target.id}
    for _, item in ipairs(target.captures) do
        -- Forward the stored value itself. A shared cell must not be read and
        -- reconstructed when an intermediate closure forwards it.
        args[#args + 1] = item.mode == "take" and ctx.readname(node, item.definition) or ctx.storage(item.definition)
    end

    local value = ctx.emit(node, "Closure", args, "tagged")
    if #(target.body.takenCaptures or {}) > 0 then
        return ownedclosures.wrap(ctx, node, value)
    end

    return value
end

export function call(ctx: any, node: any, expected: string?): integer?
    need(expected == nil or expected == "tagged", "call requires tagged destination")
    if node.runtimeLoader == "require" then
        local projected = qualifiedvalue(ctx, node)
        if projected ~= nil then
            return projected
        end
        local item = requireSite(ctx, node)
        need(not item.typeOnly, "type-only require cannot produce a runtime value")
        if item.corecalls then
            return ctx.emit(node, "Nil", {}, "tagged")
        end
        if item.absent then
            return libraryCall(ctx, node, corelibrary.id("MODULE_REQUIRE"), node.args.exprs)
        end
        return ctx.emit(node, "Require", {pool(ctx, "str", item.module)}, "tagged")
    end

    local witness = scalarwitness(ctx, node)
    if witness then
        local checked = scalartypeof.describe(node)
        need(
            checked
            and checked.definition == witness.definition
            and checked.subject == witness.subject
            and checked.kind == witness.kind
            and witness.owner == ctx.fn.id,
            "scalar witness identity differs"
        )
        local module = ctx.expression(witness.base, "tagged")
        local member = ctx.emit(node, "K", {pool(ctx, "str", scalartypeof.MEMBER)}, "tagged")
        local callee = ctx.emit(node, "GetIdx", {module, member}, "tagged")
        local kind = ctx.emit(node, "K", {pool(ctx, "str", witness.kind)}, "tagged")
        local contract = graph.invokeContract(witness.target, witness.call)
        return landed(ctx, node, ctx.invoke(node, callee, {kind}, contract, true)) as integer
    end

    return invoke(ctx, node, true)
end

export function statementCall(ctx: any, node: any): nil
    if node.runtimeLoader == "require" or scalarwitness(ctx, node) then
        call(ctx, node, nil)
    else
        invoke(ctx, node, false)
    end
end

export function erasedPattern(ctx: any, stat: any): nil
    local source = need(stat.patternSource, "pattern lacks checked source")
    local item = requireSite(ctx, source)
    need(item.typeOnly and #stat.pattern > 0, "runtime destructuring is unsupported")
    for _, entry in ipairs(stat.pattern) do
        need(entry.typeOnly ~= nil, "mixed runtime destructuring is unsupported")
    end
end

export function erasedStatement(ctx: any, stat: any, physicalStructs: boolean?): nil
    if stat.kind == "recordDecl" and (stat.declKind == "interface" or stat.isAnnotationDefinition) then
        return
    end
    if stat.kind == "recordDecl" then
        -- A record of fields declares a type only; its values are built where
        -- they are constructed. Methods in its body are stored on the table its
        -- name holds (`recordValue`).
        -- A record's type parameters erase: its instances hold values.
        need(
            stat.declKind == "record" or physicalStructs and stat.declKind == "struct",
            "unsupported record declaration: " .. tostring(
                stat.declKind
            ) .. " " .. tostring(stat.name and stat.name.text)
        )
        for _, entry in ipairs(stat.entries or {}) do
            need(
                entry.kind == "fieldDecl" or entry.kind == "inlineMethod" or entry.kind == "constructorDecl"
                -- A metamethod declaration is a contract; the record's table
                -- holds whatever fulfills it.
                or entry.kind == "metamethodDecl"
                -- A nested type declares a type only, and so does a nested
                -- record of fields alone, built where it is constructed. One
                -- with methods holds a table of its own (`recordValue`).
                or entry.kind == "typeAlias" or entry.kind == "recordDecl"
                -- An array part (`{T}` in the body) types the record's integer
                -- keys; it declares no value.
                or entry.kind == "arrayPart",
                "unsupported record entry: " .. tostring(entry.kind) .. " in " .. tostring(stat.name and stat.name.text)
            )
        end
        return
    end
    -- A `cdef function` declares what its calls call (taggedforeign), and a
    -- `cdef struct` the layout its instances have (taggedstructs).
    need(
        stat.kind == "moduleStmt" or stat.kind == "typeAlias" or stat.kind == "cdefFunc" or stat.kind == "cdefStruct",
        "unsupported erased statement"
    )
end

export function checkStatement(ctx: any, stat: any): nil
    taggedstatements.checkStatement(ctx, stat, 2)
end

-- A true constant, for the cleanup protocol's conditions: a guest error
-- unwinds in the runtime, so no call or terminal reports failure here.

-- A profile for one checked-source graph version (see coregraphschema).
export function forVersion(version: integer): any
    local profile = {}
    -- Every export of this module, which is the version 2 profile.
    for name, member in pairs(require("nupp.compiler.vm.taggedprofile")) do
        profile[name] = member
    end
    profile.erasedStatement = function(ctx: any, stat: any): nil
        erasedStatement(ctx, stat, version >= 8)
    end
    profile.checkStatement = function(ctx: any, stat: any): nil
        taggedstatements.checkStatement(ctx, stat, version)
    end
    -- `local {a, b as c} = source`: the source once, then each value
    -- entry's field in order; a `type` entry's place is nil. A source that
    -- selects only types is erased.
    profile.patternvalues = function(ctx: any, stat: any): {any}?
        local runtime = false
        for _, entry in ipairs(stat.pattern) do
            if not entry.typeOnly then
                runtime = true
            end
        end
        if not runtime then
            erasedPattern(ctx, stat)
            return {}
        end
        local source = ctx.expression(need(stat.patternSource, "pattern lacks checked source"), "tagged")
        if source == nil then
            return nil
        end
        local values: {any} = {}
        for index, entry in ipairs(stat.pattern) do
            if not entry.typeOnly then
                local field = ctx.emit(stat, "K", {pool(ctx, "str", entry.sourceName.text)}, "tagged")
                values[index] = ctx.emit(stat, "GetIdx", {source, field}, "tagged")
            end
        end

        return values
    end
    -- A module with named exports: its export table, published as the
    -- module's value before its body runs.
    -- The modules a chunk's qualified paths name load as it starts, before
    -- its own exports are made, as one hidden require each.
    -- Whether `value` is nil, a branch's condition (`a ?? b`).
    profile.isNil = function(ctx: any, node: any, value: integer): integer
        local none = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.emit(node, "Eq", {value, none}, "tagged") as integer
    end
    profile.qualifiedLoads = function(ctx: any, node: any): nil
        -- A program that requires a computed name has its entry register the
        -- image's modules by name before anything runs.
        local p = catalog(ctx)
        local entry = p.modules[#p.modules]
        -- A chunk's requires are the running program's, which registered them.
        if p.dynamicRequires and not p.chunk and entry and entry.chunk == ctx.fn.id then
            local names = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
            local registered: {[string]: integer} = {}
            for _, module in ipairs(p.modules) do
                for _, name in ipairs(graph.coremodulenames(module.name)) do
                    need(
                        registered[name] == nil or registered[name] == module.chunk,
                        "dynamic module name has conflicting chunks: " .. name
                    )
                    registered[name] = module.chunk
                    local key = ctx.emit(node, "K", {pool(ctx, "str", name)}, "tagged")
                    local chunk = ctx.emit(node, "K", {pool(ctx, "int64", tostring(module.chunk))}, "tagged")
                    ctx.emit(node, "SetIdx", {ctx.readHeld(names), key, chunk}, nil)
                end
            end
            ctx.emit(node, "LibCall", {corelibrary.id("MODULE_NAMES"), ctx.readHeld(names)}, "tagged")
            ctx.release(names)
        end
        for _, site in ipairs(catalog(ctx).qualifiedLoads[ctx.fn.id] or {}) do
            ctx.emit(site.node, "Require", {pool(ctx, "str", site.module)}, "tagged")
        end
    end
    profile.moduleExports = function(ctx: any, node: any): integer
        local exports = ctx.emit(node, "NewTable", {}, "tagged")
        return ctx.emit(node, "LibCall", {corelibrary.id("MODULE_PUBLISH"), exports}, "tagged") as integer
    end
    -- A module a require cycle can re-enter publishes forwarders for the
    -- functions it exports, as main does.
    profile.exportForwarders = function(ctx: any, node: any): integer?
        return exportforwarders.publish(ctx)
    end
    -- After a named export's statement: each name it declared, stored in the
    -- export table under that name.
    profile.exportNames = function(ctx: any, stat: any): nil
        local inner = stat.stat
        local names: {any} = {}
        if inner.kind == "localFuncStmt" or inner.kind == "recordDecl" then
            names = {inner.name}
        elseif inner.kind == "localStmt" then
            names = inner.names
        elseif inner.kind == "funcStmt" then
            need(inner.name and inner.name.base and #(inner.name.parts or {}) <= 1, "an exported function is named")
            names = {inner.name.base}
        end
        for _, name in ipairs(names) do
            local key = name.definition or name
            local value = ctx.readname(stat, key)
            if value ~= nil then
                local text = need(name.text or name.token and name.token.text, "an exported name has its text")
                local field = ctx.emit(stat, "K", {pool(ctx, "str", text)}, "tagged")
                ctx.emit(stat, "SetIdx", {ctx.readHeld(ctx.exports), field, value}, nil)
                taggedvalues.noteExport(ctx, text)
                exportforwarders.bind(ctx, stat, text, value)
            end
        end
    end
    -- `@unsafe` before a statement: the checker trusted what it says, a yield
    -- with affine values live; the statement runs as it would without it.
    -- `@aot` asks for ahead-of-time code, which the core has no backend
    -- for, and `@allow` quiets a lint: either way the statement runs as
    -- written. `@nosuspend` is the checker's proof that nothing in it
    -- suspends, which it holds without the core's help.
    -- Built-in `@deprecated` records tooling metadata; its declaration still
    -- runs as written and its checked migration lint remains unchanged.
    -- `@cli`, `@debug` and `@event` configure what a derive generates and
    -- `@syntax` an editor's highlighting: metadata the checker read. Main
    -- emits the statement each annotates as written. `@derive` is admitted on
    -- a record whose recipe the core makes (derivedmembers). Checked custom
    -- annotations and their declarations carry metadata without running code.
    local pragmas: {[string]: boolean} = {
        unsafe = true,
        aot = true,
        allow = true,
        nosuspend = true,
        -- Effect regions the checker holds the body to; nothing runs for them.
        noalloc = true,
        noraise = true,
        deprecated = true,
        cli = true,
        debug = true,
        event = true,
        syntax = true
    }
    profile.checkedPragma = function(ctx: any, node: any): nil
        local name = node.name and node.name.text
        local definition = node.annotationDefinition
        local target = node.stat
        while target and (target.kind == "pragmaStmt" or target.kind == "exportStmt") do
            target = target.stat
        end
        local derived = name == "derive" and target ~= nil and catalog(ctx).derives[target] ~= nil
        local declared = name == "annotation"
            and target ~= nil
            and target.kind == "recordDecl"
            and node.definesAnnotation ~= nil
            and node.definesAnnotation == target.annotationDefinition
            and node.definesAnnotation.declaration == target
        local custom = definition
            and not definition.builtin
            and definition.arguments == "typed"
            and target ~= nil
            and node.semanticAnnotationTarget == target
        need(
            (pragmas[name or ""] == true or derived or declared or custom)
            and definition
            and definition.name == name
            and (name ~= "deprecated" or definition.builtin == true),
            "only a checked @unsafe, @aot, @allow, @nosuspend, @noalloc, @noraise, @deprecated, @cli, @debug, @event, "
            .. "@syntax, "
            .. "lowered @derive, or checked custom annotation is admitted, not @"
            .. tostring(
                name
            )
        )
    end
    profile.binary = function(ctx: any, node: any, expected: string?): integer?
        return taggedstatements.binary(ctx, node, expected, version)
    end
    if version >= 6 then
        profile.numericFor = function(ctx: any, stat: any, expected: any): any
            return numericFor(ctx, stat, version)
        end
    end
    -- v8 tables: empty constructors, keyed reads and writes, and length.
    if version >= 8 then
        profile.switchGuards = true
        profile.scalarVectorFallback = true
        profile.initialize = function(fn: any, options: any): any
            return setup(fn, options, true)
        end
        -- A binding condition keeps false and rejects only nil.
        profile.bindingCondition = function(ctx: any, clause: any, value: integer): integer
            local none = ctx.emit(clause, "Nil", {}, "tagged")
            local absent = ctx.emit(clause, "Eq", {value, none}, "tagged")
            return ctx.emit(clause, "Not", {absent}, "tagged") as integer
        end
        profile.absentBinding = function(ctx: any, clause: any): boolean
            local facts = catalog(ctx).absentBindings
            local fact = facts and facts[clause]
            if fact ~= nil then
                need(
                    scalarcapabilities.absentBinding(clause)
                    and fact.owner == ctx.fn.id
                    and fact.call == clause.cond
                    and fact.body == clause.body,
                    "scalar capability binding differs"
                )
            end

            return fact ~= nil
        end
        profile.tableConstructor = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "table requires tagged destination")
            -- `{...}` copies the pack; a positional `...` or call giving other
            -- than one result last among the entries gives them all, appended.
            if #node.fields == 1 and node.fields[1].kind == "fieldItem" and node.fields[1].value.kind == "vararg" then
                return ctx.emit(node, "LibCall", {corelibrary.id("PACK_COPY"), ctx.varargPack()}, "tagged") as integer
            end
            local tail = node.fields[#node.fields]
            local appends = tail ~= nil
                and tail.kind == "fieldItem"
                and (tail.value.kind == "vararg" or graph.expandsResults(tail.value))
            for index, field in ipairs(node.fields) do
                need(
                    field.value == nil or field.value.kind ~= "vararg" or appends and index == #node.fields,
                    "`...` among other table entries"
                )
            end
            -- Entries are evaluated in order, keys before their values, and
            -- each is stored as it is made, as Lua's are, so a long
            -- constructor holds one entry at a time: positional ones at 1,
            -- 2, ..., named ones at their string.
            local entries = {}
            local position = 0
            for index, field in ipairs(node.fields) do
                if appends and index == #node.fields then
                    break
                end
                if field.kind == "fieldItem" then
                    position += 1
                    entries[#entries + 1] = {kind = "int64", text = tostring(position), value = field.value}
                elseif field.kind == "fieldNamed" then
                    local name = need(field.name, "named field lacks a name").text
                    entries[#entries + 1] = {kind = "str", text = name, value = field.value}
                elseif field.kind == "fieldBracket" then
                    entries[#entries + 1] = {key = field.key, value = field.value}
                else
                    error("tagged graph: unsupported table constructor entry", 0)
                end
            end
            -- A checked `{T}` whose elements pack is made packed, with room
            -- for its positional entries (runtime Decision 15).
            local packed = packedkind(node)
            local result = packed
                and ctx.emit(
                    node,
                    "LibCall",
                    {
                        corelibrary.id("TABLE_NEWARRAY"),
                        ctx.emit(node, "K", {pool(ctx, "int64", tostring(packed))}, "tagged"),
                        ctx.emit(node, "K", {pool(ctx, "int64", tostring(position))}, "tagged")
                    },
                    "tagged"
                )
                or ctx.emit(node, "NewTable", {}, "tagged")
            if #entries > 0 then
                local table = ctx.hold(result)
                for _, entry in ipairs(entries) do
                    local operands = entry.key and ctx.operands({entry.key, entry.value}, {
                        "tagged",
                        "tagged"
                    }) or ctx.operands({entry.value}, {"tagged"})
                    if operands == nil then
                        ctx.release(table)
                        return nil as any
                    end
                    local key = entry.key and operands[1]
                        or ctx.emit(node, "K", {pool(ctx, entry.kind, entry.text)}, "tagged")
                    ctx.emit(node, "SetIdx", {ctx.readHeld(table), key, operands[#operands]}, nil)
                end
                result = ctx.readHeld(table)
                ctx.release(table)
            end
            if appends then
                -- The tail's values go at the next positions, from its pack.
                local held = ctx.hold(result)
                local pack = tail.value.kind == "vararg" and ctx.varargPack() or taggedcalls.openinvoke(ctx, tail.value)
                if pack == nil or ctx.block == nil then
                    ctx.release(held)
                    return nil as any
                end
                local start = ctx.emit(node, "K", {pool(ctx, "int64", tostring(position + 1))}, "tagged")
                ctx.emit(node, "LibCall", {corelibrary.id("PACK_APPEND"), ctx.readHeld(held), pack, start}, "tagged")
                result = ctx.readHeld(held)
                ctx.release(held)
            end

            return result as integer
        end
        profile.indexRead = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "index requires tagged destination")
            local access = catalog(ctx).indexedByNode[node]
            if access ~= nil or indexedaccess.read(node) ~= nil then
                need(access ~= nil, "indexed span lacks its issued catalog entry")
                indexedaccess.verify(access, node, ctx.fn.id)
                -- As in the VM adapter: receiver, index, then getter lookup.
                local arguments = ctx.operands({node.obj, node.expr}, {"tagged", "tagged"})
                if arguments == nil then
                    return nil as any
                end
                return invokeMethod(ctx, access.call, true, nil, arguments) as integer
            end
            local operands = ctx.operands({node.obj, node.expr}, {"tagged", "tagged"})
            if operands == nil then
                return nil as any
            end
            -- An element of an array of structs is a view of its bytes.
            local declared = taggedstructs.element(node.obj.inferredType, node.kind == "safeBracket")
            if declared then
                return taggedstructs.elementAt(ctx, node, declared, operands[1], operands[2])
            end

            return ctx.emit(node, "GetIdx", operands, "tagged") as integer
        end
        -- Records lower onto core tables keyed by their field names, as a
        -- record with an array part already is. Records are identity objects,
        -- so this is exact; a dedicated record layout is a later optimization.
        profile.structValue = function(ctx: any, node: any): integer
            local class = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
            taggedstructs.attachLayout(ctx, node, class)
            local value = ctx.readHeld(class)
            ctx.release(class)

            return value
        end
        profile.foreignValue = function(ctx: any, node: any): integer?
            if catalog(ctx).foreignValues[node.name.definition] then
                return taggedforeign.declare(ctx, node)
            end
            return nil
        end
        profile.construction = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "record requires tagged destination")
            local origin = recordOrigin(node.inferredType)
            local callsite = node.call
            local declared = taggedstructs.origin(node.inferredType)
            if declared and callsite and callsite.constructorEntry then
                -- A struct's constructor runs on its zeroed bytes with each
                -- field default written, as a record's runs on its table.
                return construct(ctx, node, declared, function(c: any): integer?
                    local names, values = {}, {}
                    for _, field in ipairs(declared.fieldOrder or {}) do
                        local default = declared.fieldDefaults and declared.fieldDefaults[field]
                        if default then
                            names[#names + 1] = field
                            values[#values + 1] = defaultConstant(c, node, default.value)
                        end
                    end

                    return taggedstructs.construct(c, node, declared, names, values)
                end) as integer
            end
            if declared then
                need(callsite and type(callsite.recordFields) == "table", "only plain struct construction is admitted")
                local nodes, names, defaults = {}, {}, {}
                for _, binding in ipairs(callsite.recordFields) do
                    if binding.node then
                        nodes[#nodes + 1], names[#names + 1] = binding.node, binding.name
                    else
                        need(binding.isDefault, "struct initializer is missing")
                        defaults[#defaults + 1] = binding
                    end
                end
                local values = taggedOperands(ctx, nodes)
                if values == nil then
                    return nil as any
                end
                for _, binding in ipairs(defaults) do
                    values[#values + 1] = defaultConstant(ctx, node, binding.defaultValue)
                    names[#names + 1] = binding.name
                end
                return taggedstructs.construct(ctx, node, declared, names, values) as integer
            end
            if origin and callsite and callsite.constructorEntry then
                return construct(ctx, node, origin) as integer
            end
            need(
                origin and callsite and not callsite.constructorEntry and type(callsite.recordFields) == "table",
                "only plain record construction is admitted"
            )
            -- Written fields are expressions; a default is its closed value.
            local nodes, kinds, slots, defaults = {}, {}, {}, {}
            for _, binding in ipairs(callsite.recordFields) do
                if binding.node then
                    nodes[#nodes + 1], kinds[#kinds + 1] = binding.node, "tagged"
                    slots[#slots + 1] = binding.name
                else
                    need(binding.isDefault, "record initializer is missing")
                    defaults[#defaults + 1] = binding
                end
            end
            -- The record's table is the instance's metatable. It is what the
            -- callee evaluates to, which runs before the arguments, as any
            -- call's callee does.
            local class = ctx.expression(callsite.obj, "tagged")
            if class == nil then
                return nil as any
            end
            local heldClass = ctx.hold(class)
            local values = ctx.operands(nodes, kinds)
            if values == nil then
                ctx.release(heldClass)
                return nil as any
            end
            for _, binding in ipairs(defaults) do
                values[#values + 1] = defaultConstant(ctx, node, binding.defaultValue)
                slots[#slots + 1] = binding.name
            end
            local record = ctx.emit(node, "NewTable", {}, "tagged")
            for index, value in ipairs(values) do
                ctx.emit(node, "SetIdx", {record, taggedvalues.slotKey(ctx, node, origin, slots[index]), value}, nil)
            end
            local held = ctx.hold(record)
            ctx.emit(
                node,
                "LibCall",
                {corelibrary.id("SETMETATABLE"), ctx.readHeld(held), ctx.readHeld(heldClass)},
                "tagged"
            )
            record = ctx.readHeld(held)
            ctx.release(held)
            ctx.release(heldClass)
            -- Until the record is complete, a failure still unwinds its initializers.
            for _, binding in ipairs(callsite.recordFields) do
                if binding.takesInitializer then
                    ctx.takeArgument(binding.node)
                end
            end

            return record as integer
        end
        profile.fieldRead = function(ctx: any, node: any, expected: string?): integer
            -- A declared module's qualified path: the module, as a require
            -- answers it, then the members the path names in it.
            local library = qualifiedvalue(ctx, node)
            if library ~= nil then
                return library
            end
            -- math.huge, math.pi, math.maxinteger and math.mininteger fold.
            local libraryField = graph.coreLibraryField(node)
            if libraryField == "math.huge" or libraryField == "math.pi" then
                local number = libraryField == "math.pi" and math.pi or math.huge
                return ctx.emit(node, "K", {pool(ctx, "num", graphimage.floatBytes(number))}, "tagged") as integer
            elseif libraryField == "math.maxinteger" then
                return ctx.emit(node, "K", {pool(ctx, "int64", "9223372036854775807")}, "tagged") as integer
            elseif libraryField == "math.mininteger" then
                return ctx.emit(node, "K", {pool(ctx, "int64", "-9223372036854775808")}, "tagged") as integer
            end
            local field = taggedstructs.access(node)
            if field ~= nil then
                return taggedstructs.read(ctx, node, field) as integer
            end
            -- A record's metatable can also be attached to a named table.
            -- Its field name reaches either layout through the runtime adapter.
            local slot = fieldSlot(ctx, node.obj.inferredType, node.name and node.name.text)
            -- In a chunk any field is read by its name, whatever the checker
            -- made of its receiver.
            local plain = slot == nil
                and (
                    keyedByName(node.obj.inferredType)
                    or typeKind(node.obj.inferredType) == "string"
                    or catalog(ctx).chunk
                )
                and node.name ~= nil
            if slot == nil and not plain then
                return constant(ctx, node, expected)
            end
            local object = ctx.expression(node.obj, "tagged")
            if object == nil then
                return nil as any
            end
            -- A static overload is stored under the member the checker selected.
            local member = node.overloadMember or node.name.text
            local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")

            return ctx.emit(node, "GetIdx", {object, key}, "tagged") as integer
        end
        profile.isGlobal = taggedvalues.isGlobal
        -- A whole-record cleanup still runs after an optional field leaves.
        profile.clearOwnedField = function(ctx: any, node: any, receiver: integer, field: string): nil
            local key = ctx.emit(node, "K", {pool(ctx, "str", field)}, "tagged")
            local none = ctx.emit(node, "Nil", {}, "tagged")
            ctx.emit(node, "SetIdx", {receiver, key, none}, nil)
        end
        profile.assignmentTarget = function(ctx: any, node: any, rhs: any): any
            -- A chunk's global is a field of the running program's `_G`.
            if taggedvalues.isGlobal(ctx, node) then
                local globals = taggedvalues.globalTable(ctx, node)
                local name = ctx.emit(node, "K", {pool(ctx, "str", node.token.text)}, "tagged")
                return {receiver = globals, index = name, kind = "tagged"}
            end
            if node.kind == "dotIndex" then
                -- A struct's field is written through a view (taggedstructs).
                local field = taggedstructs.access(node)
                local slot = fieldSlot(ctx, node.obj.inferredType, node.name and node.name.text)
                -- `R.f = ...` writes the table a record's name holds.
                local plain = slot == nil
                    and (keyedByName(node.obj.inferredType) or catalog(ctx).chunk)
                    and node.name ~= nil
                need(field ~= nil or slot ~= nil or plain, "only record and table field assignment is admitted")
                local object = ctx.expression(node.obj, "tagged")
                if object == nil then
                    return {receiver = 0, kind = "tagged"}
                elseif field ~= nil then
                    return {receiver = object, kind = "tagged", structField = field}
                end
                local held = ctx.hold(object)
                local key = ctx.emit(node, "K", {pool(ctx, "str", node.name.text)}, "tagged")
                object = ctx.readHeld(held)
                ctx.release(held)
                return {receiver = object, index = key, kind = "tagged"}
            end
            need(node.kind == "bracketIndex", "only keyed assignment targets are admitted")
            local access = catalog(ctx).indexedByNode[node]
            if access ~= nil or indexedaccess.write(node) ~= nil then
                need(access ~= nil and access.writing, "indexed span lacks its issued setter")
                indexedaccess.verify(access, node, ctx.fn.id)
            end
            local operands = ctx.operands({node.obj, node.expr}, {"tagged", "tagged"})
            if operands == nil then
                return {receiver = 0, kind = "tagged"}
            end
            -- A struct written to an array of them is copied over its bytes.
            local declared = taggedstructs.element(node.obj.inferredType)
            if declared then
                local slot = taggedstructs.elementAt(ctx, node, declared, operands[1], operands[2])
                return {receiver = slot, kind = "tagged", structElement = declared}
            end

            return {receiver = operands[1], index = operands[2], kind = "tagged", indexed = access}
        end
        profile.readAssignment = function(ctx: any, node: any, target: any): integer
            local receiver = ctx.readHeld(target.heldReceiver)
            if target.structField then
                return taggedstructs.read(ctx, node, target.structField, receiver) as integer
            elseif target.structElement then
                return receiver
            end
            need(target.indexed == nil, "compound span assignment needs a checked getter and setter")

            return ctx.emit(node, "GetIdx", {receiver, ctx.readHeld(target.heldIndex)}, "tagged") as integer
        end
        profile.assignTarget = function(ctx: any, node: any, target: any, receiver: integer, value: integer): nil
            if target.structField then
                taggedstructs.assign(ctx, node, target, receiver, value)
                return
            end
            if target.structElement then
                taggedstructs.assignElement(ctx, node, target.structElement, receiver, value)
                return
            end
            if target.indexed then
                local access = target.indexed
                indexedaccess.verify(access, node, ctx.fn.id)
                invokeMethod(ctx, access.call, false, nil, {receiver, ctx.readHeld(target.heldIndex), value})
                return
            end
            need(indexedaccess.write(node) == nil, "indexed span lacks its issued setter")
            ctx.emit(node, "SetIdx", {receiver, ctx.readHeld(target.heldIndex), value}, nil)
        end

        -- A loop over a state table advanced by library step `id`, which
        -- answers whether it continues and leaves the bound names from key
        -- `offset + 1` on.
        local function stepped(stat: any, state: integer, id: integer, offset: integer): any
            local function step(c: any, node: any, v: any): (integer, boolean)
                return c.emit(node, "LibCall", {id, v[1]}, "tagged"), false
            end

            return {
                values = {state},
                first = step,
                test = step,
                advance = function(c: any, node: any, v: any): (integer, integer?)
                    return v[1], nil
                end,
                bind = function(c: any, node: any, v: any): any
                    local bound = {}
                    for index = 1, #stat.names do
                        local key = c.emit(node, "K", {pool(c, "int64", tostring(offset + index))}, "tagged")
                        bound[index] = c.emit(node, "GetIdx", {v[1], key}, "tagged")
                    end

                    return bound
                end
            }
        end

        -- `for i, v in ipairs(t)`: i counts from 1 while t[i] is not nil. The
        -- element is read for the test and again for the body, which only a
        -- metatable could tell apart; the core has none yet.
        profile.genericFor = function(ctx: any, stat: any): any
            local source = stat.exprs[1]
            -- `for k, v in pairs(t)`: a state table {t, key, k, v} the next
            -- step advances, leaving the pair at keys 3 and 4.
            if #stat.exprs == 1 and source.kind == "call" and source.resolvedGlobal == "pairs" then
                need(#(source.args.exprs or {}) == 1 and #stat.names <= 2, "pairs takes one table")
                local t = ctx.expression(source.args.exprs[1], "tagged")
                if t == nil then
                    return nil
                end
                local held = ctx.hold(t)
                local state = ctx.emit(stat, "NewTable", {}, "tagged")
                local subjectKey = ctx.emit(
                    stat,
                    "K",
                    {pool(ctx, "int64", tostring(corelibrary.key("PAIRS", "TABLE")))},
                    "tagged"
                )
                ctx.emit(stat, "SetIdx", {state, subjectKey, ctx.readHeld(held)}, nil)
                ctx.release(held)

                return stepped(stat, state, corelibrary.id("NEXT_STEP"), corelibrary.key("PAIRS", "KEY") - 1)
            end
            -- `for names in f, s, c`: f(s, c) each step, as Lua runs any
            -- iterator, a wrapped coroutine's included; the loop leaves at a
            -- nil first result.
            if graph.genericiterator(stat) then
                need(#stat.names >= 1 and #stat.names <= 16, "a generic for names one to sixteen values")
                local values: any = nil
                if #stat.exprs == 1 and graph.expandsResults(source) then
                    values = profile.callResults(ctx, source, 3)
                else
                    need(#stat.exprs <= 3, "a generic for takes at most three values")
                    local kinds = {}
                    for index = 1, #stat.exprs do
                        kinds[index] = "tagged"
                    end
                    values = ctx.operands(stat.exprs, kinds)
                end
                if values == nil then
                    return nil
                end
                local controls = {}
                for index = 1, 3 do
                    controls[index] = values[index] or ctx.emit(stat, "Nil", {}, "tagged")
                end

                return {
                    values = controls,
                    iterate = function(c: any, node: any, v: any): {integer}?
                        local contract = graph.iteratorcontract(stat, #stat.names)
                        return landed(c, node, c.invokeMany(node, v[1], {v[2], v[3]}, contract, #stat.names))
                    end,
                    ended = function(c: any, node: any, first: integer): integer
                        local none = c.emit(node, "Nil", {}, "tagged")
                        return c.emit(node, "Eq", {first, none}, "tagged")
                    end,
                    none = function(c: any, node: any): integer
                        return c.emit(node, "Nil", {}, "tagged")
                    end
                }
            end
            need(
                #stat.exprs == 1
                and source.kind == "call"
                and source.resolvedGlobal == "ipairs"
                and #(source.args.exprs or {}) == 1
                and #stat.names >= 1
                and #stat.names <= 2,
                "only `for i, v in ipairs(t)` is admitted"
            )
            local t = ctx.expression(source.args.exprs[1], "tagged")
            if t == nil then
                return nil
            end
            local held = ctx.hold(t)
            local first = ctx.emit(stat, "K", {pool(ctx, "int64", "1")}, "tagged")
            t = ctx.readHeld(held)
            ctx.release(held)

            local function present(c: any, node: any, v: any): (integer, boolean)
                local element = c.emit(node, "GetIdx", {v[2], v[1]}, "tagged")
                local none = c.emit(node, "Nil", {}, "tagged")
                return c.emit(node, "Eq", {element, none}, "tagged"), true
            end

            return {
                values = {first, t},
                first = present,
                test = present,
                advance = function(c: any, node: any, v: any): (integer, integer?)
                    local one = c.emit(node, "K", {pool(c, "int64", "1")}, "tagged")
                    return c.emit(node, "Add", {v[1], one}, "tagged"), nil
                end,
                bind = function(c: any, node: any, v: any): any
                    return {v[1], c.emit(node, "GetIdx", {v[2], v[1]}, "tagged")}
                end
            }
        end
        -- `a or b` and `a and b` branch on Lua truthiness.
        profile.checkLogical = function(ctx: any, node: any): boolean
            return true
        end
        profile.kind = function(t: any): string
            return "tagged"
        end
        -- A block nothing reaches (after a loop body that always leaves) is
        -- dropped rather than verified.
        profile.dropUnreachable = true
        -- Statements that end in a call that never returns end there.
        profile.unreachableEnds = true
        -- `e as T` is a static cast: the value is the operand's.
        profile.cast = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "cast requires tagged destination")
            return ctx.expression(node.expr, "tagged") as integer
        end
        -- `v is T`: settled by the checker, a nil test, an integer's subtype,
        -- or `type(v)` against a primitive's name.
        profile.typeTest = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "a type test requires tagged destination")
            if node.refutedStatically or node.provenStatically and not node.provenNeedsNil then
                local answer = node.refutedStatically and "false" or "true"
                return ctx.emit(node, "K", {pool(ctx, answer, "")}, "tagged") as integer
            end
            local t = need(node.type, "a type test lacks its type")
            if node.provenNeedsNil or t.kind == "tname" and t.base and t.base.kind == "nil" then
                local value = ctx.expression(need(node.expr, "a type test lacks its value"), "tagged")
                if value == nil then
                    return nil as any
                end
                local none = ctx.emit(node, "Nil", {}, "tagged")
                local absent = ctx.emit(node, "Eq", {value, none}, "tagged")
                if node.provenNeedsNil then
                    return ctx.emit(node, "Not", {absent}, "tagged") as integer
                end
                return absent as integer
            end
            -- A refinement is the declaration's own answer, and the only one an
            -- interface has.
            if t.wherePredicate then
                return taggedpredicate.test(ctx, node, t.wherePredicate) as integer
            end
            local record = catalog(ctx).recordTests[node]
            if record then
                local value = ctx.expression(node.expr, "tagged")
                if value == nil then
                    return nil as any
                end
                local held = ctx.hold(value)
                local class = ctx.expression(record.expression, "tagged")
                if class == nil or ctx.block == nil then
                    ctx.release(held)
                    return nil as any
                end
                local answer = ctx.emit(
                    node,
                    "LibCall",
                    {corelibrary.id("RECORD_IS"), ctx.readHeld(held), class},
                    "tagged"
                )
                ctx.release(held)
                return answer as integer
            end
            local target = node.typeTestTarget
            while target and target.tag == "literal" do
                target = target.base
            end
            local tag = target and target.tag
            -- int64 is the integer: its test is the number's subtype.
            local id: integer = 32
            local answer: string? = nil
            if tag == "int64" or tag == "uint64" or tag == "integer" then
                id, answer = 43, "integer"
            elseif t.kind == "tname" and #t == 1 and t.base and typeNames[t.base.text] then
                answer = typeNames[t.base.text]
            elseif t.primitiveTest then
                answer = t.primitiveTest
            elseif t.kind == "tfunc" then
                answer = "function"
            end
            if answer == nil then
                error(
                    "tagged graph: a type test against " .. tostring(
                        t.recordName or t.kind
                    ) .. " is unsupported (records, unions and refinements)",
                    0
                )
            end
            local found = libraryCall(ctx, node, id, {node.expr})
            if found == nil or ctx.block == nil then
                return nil as any
            end
            local name = ctx.emit(node, "K", {pool(ctx, "str", answer)}, "tagged")

            return ctx.emit(node, "Eq", {found, name}, "tagged") as integer
        end
        -- `...` in a single-value context: the pack's first value.
        profile.vararg = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "`...` requires tagged destination")
            local key = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
            return ctx.emit(node, "GetIdx", {ctx.varargPack(), key}, "tagged") as integer
        end
        -- `function T.f(...)` and `function T:m(...)`: the closure stored into the
        -- table T names, as Lua does. One level of name only.
        -- The table a record's methods are stored in, when its name is bound.
        -- A call through anything but a name has no declaration to compose
        -- with: it calls the value it evaluates when it runs.
        profile.resolveCallee = function(_: any, callsite: any): (boolean, any)
            if callsite.obj.kind ~= "name" then
                return true, nil
            end
            return false, nil
        end
        -- The table a record's name holds, with every method its body
        -- declares stored by name, as `function R:m` stores one. It is its
        -- instances' metatable, its own __index, so metamethods written on it
        -- apply to them.
        local recordTable: function(any, any): integer?
        profile.recordValue = function(ctx: any, stat: any): integer?
            if catalog(ctx).byDefinition[stat.name.definition] == nil then
                return nil
            end
            return recordTable(ctx, stat)
        end
        -- `record t.R`: the record's table, stored in the table `t` names
        -- under R, where `new t.R` and `function t.R:m()` find it.
        profile.qualifiedRecord = function(ctx: any, stat: any, value: integer): nil
            local qualifier = stat.qualifiers[1]
            need(#stat.qualifiers == 1 and qualifier.definition ~= nil, "a qualified record names one table")
            local held = ctx.hold(value)
            local owner = ctx.expression({kind = "name", token = qualifier, qualifier}, "tagged")
            if owner == nil or ctx.block == nil then
                ctx.release(held)
                return
            end
            local key = ctx.emit(stat, "K", {pool(ctx, "str", stat.name.text)}, "tagged")
            ctx.emit(stat, "SetIdx", {owner, key, ctx.readHeld(held)}, nil)
            ctx.release(held)
        end
        recordTable = function(ctx: any, stat: any): integer?
            local held = ctx.hold(ctx.emit(stat, "NewTable", {}, "tagged"))
            local indexKey = ctx.emit(stat, "K", {pool(ctx, "str", "__index")}, "tagged")
            ctx.emit(stat, "SetIdx", {ctx.readHeld(held), indexKey, ctx.readHeld(held)}, nil)
            if stat.declKind == "struct" then
                taggedstructs.attachLayout(ctx, stat, held)
            end
            -- A default it takes from an interface is read from that
            -- interface's table, under the member it has here.
            for _, taken in ipairs(stat.inheritedDefaultNames or {}) do
                local tokens = catalog(ctx).inheritTokens[stat] or {}
                local token = need(
                    tokens[taken] or tokens[taken.from],
                    "an inherited default from an interface not in the program: " .. tostring(taken.from)
                )
                local parent: integer? = nil
                if token.qualifiedModule then
                    local site = need(catalog(ctx).requireByNode[token], "inherited default lacks its require")
                    local loaded = ctx.emit(stat, "Require", {pool(ctx, "str", site.module)}, "tagged")
                    local name = ctx.emit(stat, "K", {pool(ctx, "str", token.inheritFrom)}, "tagged")
                    parent = ctx.emit(stat, "GetIdx", {loaded, name}, "tagged")
                elseif token.kind == "call" then
                    -- A chunk's: what its require answers for the module.
                    local loaded = ctx.expression(token, "tagged")
                    if loaded == nil then
                        ctx.release(held)
                        return nil
                    end
                    local name = ctx.emit(stat, "K", {pool(ctx, "str", token.inheritFrom)}, "tagged")
                    parent = ctx.emit(stat, "GetIdx", {loaded, name}, "tagged")
                else
                    parent = ctx.expression({kind = "name", token = token, token}, "tagged")
                end
                if parent == nil then
                    ctx.release(held)
                    return nil
                end
                local fromKey = ctx.emit(stat, "K", {pool(ctx, "str", taken.fromMember or taken.name)}, "tagged")
                local method = ctx.emit(stat, "GetIdx", {parent, fromKey}, "tagged")
                local memberKey = ctx.emit(stat, "K", {pool(ctx, "str", taken.member or taken.name)}, "tagged")
                ctx.emit(stat, "SetIdx", {ctx.readHeld(held), memberKey, method}, nil)
            end
            for _, entry in ipairs(stat.entries or {}) do
                -- A constructor is stored under a key no field name can be;
                -- each body of an overloaded method under its own member.
                local name = entry.kind == "inlineMethod" and (entry.overloadMember or entry.name.text)
                    or entry.kind == "constructorDecl" and "\0new" .. tostring(entry.constructorIndex)
                    or nil
                if name then
                    local func = ctx.hold(closure(ctx, entry))
                    local key = ctx.emit(entry, "K", {pool(ctx, "str", name)}, "tagged")
                    ctx.emit(entry, "SetIdx", {ctx.readHeld(held), key, ctx.readHeld(func)}, nil)
                    ctx.release(func)
                elseif entry.kind == "recordDecl" and entry.name and ctx.bound(entry.name.definition) then
                    -- The nested record was made first; its table is reached
                    -- through the declaration's, as `R.Nested`.
                    local nested = ctx.hold(ctx.expression({kind = "name", token = entry.name, entry.name}, "tagged"))
                    local key = ctx.emit(entry, "K", {pool(ctx, "str", entry.name.text)}, "tagged")
                    ctx.emit(entry, "SetIdx", {ctx.readHeld(held), key, ctx.readHeld(nested)}, nil)
                    ctx.release(nested)
                end
            end
            -- A derive recipe's members, after the declaration's own, as main
            -- makes them.
            if not derivedmembers.emit(ctx, stat, held) or not recordcallables.emit(ctx, stat, held) then
                ctx.release(held)
                return nil
            end
            local value = ctx.readHeld(held)
            ctx.release(held)

            return value as integer
        end
        -- `text ${value} text`: each literal piece as written and each value
        -- through tostring, joined left to right.
        profile.interpolation = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "interpolation requires tagged destination")
            local held: any = nil

            local function join(value: integer): nil
                if held == nil then
                    held = ctx.hold(value)
                    return
                end
                local joined = ctx.emit(
                    node,
                    "LibCall",
                    {corelibrary.id("CONCAT2"), ctx.readHeld(held), value},
                    "tagged"
                )
                ctx.release(held)
                held = ctx.hold(joined)
            end

            for _, child in ipairs(node) do
                local piece = nil
                if child.kind == "istringOpen" or child.kind == "istringMid" then
                    piece = child.text:sub(2, -3)
                elseif child.kind == "istringClose" then
                    piece = child.text:sub(2, -2)
                end
                if piece ~= nil then
                    if #piece > 0 then
                        local text = need(lexer.stringValue("`" .. piece .. "`"), "interpolated text")
                        join(ctx.emit(child, "K", {pool(ctx, "str", text)}, "tagged") as integer)
                    end
                elseif type(child) == "table" and child.kind then
                    local value = ctx.expression(child, "tagged")
                    if value == nil then
                        if held then
                            ctx.release(held)
                        end
                        return nil as any
                    end
                    join(ctx.emit(child, "LibCall", {corelibrary.id("TOSTRING"), value}, "tagged") as integer)
                end
            end
            if held == nil then
                return ctx.emit(node, "K", {pool(ctx, "str", "")}, "tagged") as integer
            end
            local value = ctx.readHeld(held)
            ctx.release(held)

            return value
        end
        -- `...items`: the pack as a table with its count as `n`.
        profile.namedVararg = function(ctx: any, parameter: any): integer
            return ctx.emit(parameter, "LibCall", {corelibrary.id("PACK_NAMED"), ctx.varargPack()}, "tagged") as integer
        end
        -- Sets each cleanup function a declaration names in the core's
        -- registry, under its checked key, as the declaration binds it.
        profile.cleanupRegistrations = function(ctx: any, stat: any, value: any): nil
            local tokens = {}
            if stat.kind == "localFuncStmt" then
                tokens[1] = stat.name
            else
                for _, part in ipairs(stat.name) do
                    if cst.isToken(part) then
                        tokens[#tokens + 1] = part
                    end
                end
            end
            for _, token in ipairs(tokens) do
                for _, registration in ipairs(token.cleanupRegistrations or {}) do
                    local key = ctx.emit(stat, "K", {pool(ctx, "str", registration.cleanup.key)}, "tagged")
                    ctx.emit(stat, "LibCall", {corelibrary.id("CLEANUP_SET"), key, value}, "tagged")
                end
            end
        end
        profile.functionStatement = function(ctx: any, stat: any): nil
            local name = stat.name
            local fields = {}
            for _, part in ipairs(name) do
                if part ~= name.base and cst.isToken(part) and part.kind == "name" then
                    fields[#fields + 1] = part.text
                end
            end
            need(#fields >= 1, "a function statement names a field of a table")
            local owner = ctx.expression(
                {kind = "name", token = name.base, inferredType = name.base.inferredType, name.base},
                "tagged"
            )
            if owner == nil then
                return
            end
            -- `function a.b.c()`: the table the path names before its last
            -- field.
            for index = 1, #fields - 1 do
                local key = ctx.emit(stat, "K", {pool(ctx, "str", fields[index])}, "tagged")
                owner = ctx.emit(stat, "GetIdx", {owner, key}, "tagged")
            end
            local held = ctx.hold(owner)
            local func = ctx.hold(closure(ctx, stat))
            local key = ctx.emit(stat, "K", {pool(ctx, "str", fields[#fields])}, "tagged")
            ctx.emit(stat, "SetIdx", {ctx.readHeld(held), key, ctx.readHeld(func)}, nil)
            profile.cleanupRegistrations(ctx, stat, ctx.readHeld(func))
            ctx.release(func)
            ctx.release(held)
        end

        profile.safeCall = function(ctx: any, node: any, expected: string?): integer?
            need(expected == nil or expected == "tagged", "an optional call requires a tagged destination")
            return taggedcalls.safeinvoke(ctx, node, true)
        end

        -- `count` results of a call, for `local a, b = f()` and its kin.
        profile.callResults = function(ctx: any, node: any, count: integer): {integer}?
            if node.kind == "safeCall" then
                return taggedcalls.safeinvoke(ctx, node, true, count)
            end
            if scalarwitness(ctx, node) then
                local first = call(ctx, node, "tagged")
                if first == nil then
                    return nil
                end
                local values = {first}
                for index = 2, count do
                    values[index] = ctx.emit(node, "Nil", {}, "tagged")
                end
                return values
            end
            if node.ownershipIntrinsic then
                return ownership(ctx, node, count)
            end
            -- `local a, b = ...` reads the pack in order; past its end is nil.
            if node.kind == "vararg" then
                local values = {}
                for index = 1, count do
                    local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
                    values[index] = ctx.emit(node, "GetIdx", {ctx.varargPack(), key}, "tagged")
                end
                return values
            end
            local site = catalog(ctx).callByNode[node]
            if node.kind == "methodCall" and site and site.method then
                return invokeMethod(ctx, node, true, count)
            end
            if graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall" then
                return invokeProtected(ctx, node, true, count)
            end
            -- A library call spreading `...` calls its function's value.
            if graphcalls.spreadsLibrary(node) then
                return invoke(ctx, node, true, true, count)
            end
            -- A library call with several results answers a pack, read in
            -- order; past its end is nil. So does select(n, ...), every value
            -- from index n on.
            local selects = graph.selectsValues(node)
            if selects or graph.packedcall(node) then
                local pack: integer? = nil
                if selects then
                    pack = taggedcalls.openinvoke(ctx, node)
                else
                    pack = librarypack(ctx, node)
                end
                if pack == nil or ctx.block == nil then
                    return nil
                end
                local held = ctx.hold(pack)
                local values = {}
                for index = 1, count do
                    local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
                    values[index] = ctx.emit(node, "GetIdx", {ctx.readHeld(held), key}, "tagged")
                end
                ctx.release(held)
                return values
            end
            -- Any other library call gives its one result, and the names
            -- past it nil, as a Lua function with one result does.
            if graph.coreLibraryCall(node) ~= nil then
                local first = ctx.expression(node, "tagged")
                if first == nil or ctx.block == nil then
                    return nil
                end
                local held = ctx.hold(first)
                local values = {}
                for index = 2, count do
                    values[index] = ctx.emit(node, "Nil", {}, "tagged")
                end
                values[1] = ctx.readHeld(held)
                ctx.release(held)
                return values
            end
            need(node.kind == "call" and node.runtimeLoader ~= "require", "only plain calls spread their results")

            return invoke(ctx, node, true, true, count)
        end

        local function emptyReturn(ctx: any, node: any, at: any?): nil
            local value = version >= 8 and ctx.emit(node, "Nil", {}, "tagged") or taggedcalls.emptyresults(ctx, node)
            ctx.block.term = {
                kind = "return",
                value = value,
                values = version >= 8 and {} or nil,
                spread = version < 8 and value or nil,
                edges = {},
                pos = ctx.position(at or node)
            }
            ctx.block = nil
        end

        profile.returnValues = function(ctx: any, node: any, values: {integer}): nil
            ctx.block.term = {kind = "return", value = values[1], values = values, edges = {}, pos = ctx.position(node)}
            ctx.block = nil
        end

        -- A bare return follows its checked result pack. A last call
        -- supplies as many results as the function declares, as Lua passes
        -- every result of `return f()` on.
        profile.returnStatement = function(ctx: any, stat: any): nil
            if #stat.exprs == 0 then
                if taggedcalls.emptyreturn(ctx.fn.signature, version >= 8) then
                    emptyReturn(ctx, stat)
                    return
                end
                local value = ctx.emit(stat, "Nil", {}, "tagged")
                ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
                ctx.block = nil
                return
            end
            local last = stat.exprs[#stat.exprs]
            -- `return a, ...` gives the fixed values, then the whole pack.
            if last.kind == "vararg" then
                local fixed, kinds = {}, {}
                for index = 1, #stat.exprs - 1 do
                    fixed[index], kinds[index] = stat.exprs[index], "tagged"
                end
                need(#fixed <= 16, "a return gives at most sixteen results")
                local values = ctx.operands(fixed, kinds)
                if values == nil then
                    return
                end
                local pack = ctx.varargPack()
                ctx.block.term = {
                    kind = "return",
                    value = values[1] or pack,
                    values = #values > 0 and values or nil,
                    spread = pack,
                    edges = {},
                    pos = ctx.position(stat)
                }
                ctx.block = nil
                return
            end
            local declared: integer = ctx.fn.signature and #ctx.fn.signature.rets or 1
            local lastSite = catalog(ctx).callByNode[last]
            -- A construction or layout query always answers one value.
            local scalarLast = scalarwitness(ctx, last) ~= nil or construction.bare(last) or last.layoutOf ~= nil
            local libraryLast = graph.coreLibraryCall(last)
            local spreads = last.kind == "call"
                and not scalarLast
                and last.runtimeLoader ~= "require"
                and libraryLast == nil
                or version >= 8 and last.kind == "safeCall"
                or last.kind == "methodCall" and lastSite ~= nil and lastSite.method
                or (last.kind == "call" or last.kind == "methodCall") and packSpec(libraryLast) ~= nil
                or libraryLast == "pcall"
                or libraryLast == "xpcall"
                or graph.selectsValues(last)
            -- A tail call supplies its actual result count. A declared trailing
            -- optional result can be absent, as with a successful read.
            local resultPack = ctx.fn.signature and ctx.fn.signature.retPack
            local openReturn = not scalarLast
                and resultPack
                and (
                    resultPack.tail ~= nil
                    or resultPack.alternatives ~= nil
                    or version >= 8 and #resultPack.head > 1 and graphcalls.allowsNil(resultPack.head[#resultPack.head])
                )
                and (
                    last.kind == "call"
                    and last.runtimeLoader ~= "require"
                    and graph.coreLibraryCall(last) == nil
                    and (resultPack.alternatives == nil or lastSite and not lastSite.construct)
                    or version >= 8 and last.kind == "safeCall"
                    or last.kind == "methodCall" and lastSite and lastSite.method
                    or graph.packedcall(last)
                    or graphcalls.spreadsLibrary(last)
                    or libraryLast == "pcall"
                    or libraryLast == "xpcall"
                    or graph.selectsValues(last)
                )
            if openReturn then
                local fixed, kinds = {}, {}
                for index = 1, #stat.exprs - 1 do
                    fixed[index], kinds[index] = stat.exprs[index], "tagged"
                end
                need(#fixed <= 16, "a return gives at most sixteen results")
                local operands = ctx.operands(fixed, kinds)
                if operands == nil then
                    return
                end
                local held = {}
                for index, value in ipairs(operands) do
                    held[index] = ctx.hold(value)
                end
                local pack = taggedcalls.openinvoke(ctx, last)
                if pack == nil or ctx.block == nil then
                    for _, handle in ipairs(held) do
                        ctx.release(handle)
                    end
                    return
                end
                local values = {}
                for index, handle in ipairs(held) do
                    values[index] = ctx.readHeld(handle)
                    ctx.release(handle)
                end
                ctx.block.term = {
                    kind = "return",
                    value = values[1] or pack,
                    values = #values > 0 and values or nil,
                    spread = pack,
                    edges = {},
                    pos = ctx.position(stat)
                }
                ctx.block = nil
                return
            end
            local spread: integer? = spreads and declared > #stat.exprs and declared - #stat.exprs + 1 or nil
            if #stat.exprs == 1 and not spread then
                return returnStatement(ctx, stat)
            end
            need(#stat.exprs + (spread or 1) - 1 <= 16, "a return gives at most sixteen results")
            local held = {}
            for index, expr in ipairs(stat.exprs) do
                if index < #stat.exprs or not spread then
                    local value = ctx.expression(expr, "tagged")
                    if value == nil then
                        for _, handle in ipairs(held) do
                            ctx.release(handle)
                        end
                        return
                    end
                    held[#held + 1] = ctx.hold(value)
                else
                    local results = profile.callResults(ctx, expr, spread)
                    if results == nil then
                        for _, handle in ipairs(held) do
                            ctx.release(handle)
                        end
                        return
                    end
                    for _, value in ipairs(results) do
                        held[#held + 1] = ctx.hold(value)
                    end
                end
            end
            local values = {}
            for index, handle in ipairs(held) do
                values[index] = ctx.readHeld(handle)
                ctx.release(handle)
            end
            profile.returnValues(ctx, stat, values)
        end
        profile.fallthrough = function(ctx: any, node: any): nil
            if not ctx.exports and taggedcalls.emptyreturn(ctx.fn.signature, version >= 8) then
                emptyReturn(ctx, node, node.eof or node)
                return
            end
            -- A module with named exports answers its export table.
            local value = ctx.exports and taggedvalues.moduleValue(ctx, node) or ctx.emit(node, "Nil", {}, "tagged")
            ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(node.eof or node)}
            ctx.block = nil
        end
        local libraryCallOrCall: function(any, any, string?): integer?
        -- A chunk's library call through a global: the core's own operation
        -- while the chunk's environment holds the function the program
        -- started with there, else a call of what it holds, as Lua resolves
        -- a global name through its environment.
        profile.call = function(ctx: any, node: any, expected: string?): integer?
            if catalog(ctx).guarded[node] == nil then
                return libraryCallOrCall(ctx, node, expected)
            end
            if catalog(ctx).chunkModule and graphcalls.owningAssert(node) then
                -- The checked assertion passes through the original owner.
                if graphcalls.spreadsLibrary(node) then
                    local builtin = taggedvalues.guardedOriginal(ctx, node)
                    return invoke(ctx, node, true, true, nil, nil, builtin)
                end
                return libraryCallOrCall(ctx, node, expected)
            end
            local actual = ctx.hold(taggedvalues.guardedCallee(ctx, node))
            local original = taggedvalues.guardedOriginal(ctx, node)
            local same = ctx.hold(ctx.emit(node, "Eq", {ctx.readHeld(actual), original}, "tagged"))
            local result = ctx.hold(ctx.emit(node, "Nil", {}, "tagged"))

            -- One way of making the call, whose value is the result.
            local function arm(lower: function(any): integer?): function(any, any): nil
                return function(c: any, site: any): nil
                    local value = lower(c)
                    if value ~= nil and c.block then
                        c.write(result, value)
                    end
                end
            end

            ctx.when(
                node,
                ctx.readHeld(same),
                arm(function(c: any): integer?
                    return libraryCallOrCall(c, node, expected)
                end)
            )
            local different = ctx.emit(node, "Not", {ctx.readHeld(same)}, "tagged")
            ctx.when(
                node,
                different,
                arm(function(c: any): integer?
                    node.chunkDynamic = true
                    local value = invoke(c, node, true, true, nil, nil, c.readHeld(actual))
                    node.chunkDynamic = nil
                    return value
                end)
            )
            local value = ctx.readHeld(result)
            for _, handle in ipairs({actual, same, result}) do
                ctx.release(handle)
            end

            return value
        end
        libraryCallOrCall = function(ctx: any, node: any, expected: string?): integer?
            if node.cheaderCdef and catalog(ctx).chunk then
                return taggedforeign.header(ctx, node)
            end
            if node.layoutOf then
                return taggedstructs.queryLayout(ctx, node)
            end
            if scalarwitness(ctx, node) then
                return call(ctx, node, expected)
            end
            if node.ownershipIntrinsic then
                local results = ownership(ctx, node, 1)
                if results == nil then
                    return nil
                end
                return results[1]
            end
            -- `require` of a computed name: the module the image holds by it.
            if graph.dynamicRequire(node) then
                need(#(node.args.exprs or {}) == 1, "require takes one module name")
                return libraryCall(ctx, node, corelibrary.id("MODULE_REQUIRE"), node.args.exprs)
            end
            if node.runtimeLoader == "require" then
                return call(ctx, node, expected)
            end
            -- `carray(T, n)` allocates n of struct T; T names a layout, not a
            -- value the program reads.
            if node.carrayElem then
                local declared = need(
                    taggedstructs.allocated(node.carrayElem.inferredType),
                    "carray allocates an array of a struct"
                )
                local count = ctx.expression(need(node.args.exprs[2], "carray takes a count"), "tagged")
                if count == nil then
                    return nil
                end
                return taggedstructs.allocate(ctx, node, declared, count)
            end
            local library = graph.coreLibraryCall(node)
            -- A library call spreading `...` where its core form cannot calls
            -- the library function's value with that pack, as Lua does.
            if graphcalls.spreadsLibrary(node) then
                return invoke(ctx, node, true, true)
            end
            local arguments = node.args.exprs or {}
            if library == "tostring" and arguments[1] and typeKind(arguments[1].inferredType) == "uint64" then
                return unsignedText(ctx, node, arguments)
            end
            if library == "tostring" or library == "table.concat" then
                return libraryCall(
                    ctx,
                    node,
                    library == "tostring" and corelibrary.id("TOSTRING") or corelibrary.id("TABLE_CONCAT"),
                    node.args.exprs or {}
                )
            elseif library == "assert" then
                -- assert(v [, message]): v, its one result here, or the
                -- message raised.
                local count = #(node.args.exprs or {})
                need(count >= 1 and count <= 2, "assert takes a value and an optional message")
                return libraryCall(ctx, node, corelibrary.id("ASSERT"), node.args.exprs)
            elseif library == "tonumber" then
                local count = #(node.args.exprs or {})
                need(count == 1 or count == 2, "tonumber takes a value and an optional base")
                return libraryCall(
                    ctx,
                    node,
                    count == 2 and corelibrary.id("TONUMBER_BASE") or corelibrary.id("TONUMBER"),
                    node.args.exprs
                )
            elseif library == "pcall" or library == "xpcall" then
                return invokeProtected(ctx, node, true)
            elseif library == "error" then
                -- error(value [, level]): a string value gets the position the
                -- level names.
                local count = #(node.args.exprs or {})
                need(count >= 1 and count <= 2, "error takes a value and an optional level")
                return libraryCall(ctx, node, corelibrary.id("ERROR"), node.args.exprs)
            elseif library == "select" then
                -- select over the pack: "#" reads its count at key 0.
                -- So is a call's results, last, as an open call's pack, and
                -- any other values, packed in order.
                local args = node.args.exprs or {}
                need(#args >= 1, "select takes an index")
                local first = args[1]
                local pooled = catalog(ctx).byNode[first]
                if pooled and pooled.kind == "str" and pooled.bytes == "#" then
                    local pack = taggedcalls.selectvalues(ctx, node)
                    if pack == nil or ctx.block == nil then
                        return nil
                    end
                    local zero = ctx.emit(node, "K", {pool(ctx, "int64", "0")}, "tagged")
                    return ctx.emit(node, "GetIdx", {pack, zero}, "tagged") as integer
                end
                local index = ctx.expression(first, "tagged")
                if index == nil then
                    return nil
                end
                local held = ctx.hold(index)
                local pack = taggedcalls.selectvalues(ctx, node)
                if pack == nil or ctx.block == nil then
                    ctx.release(held)
                    return nil
                end
                local value = ctx.emit(node, "LibCall", {corelibrary.id("SELECT"), pack, ctx.readHeld(held)}, "tagged")
                ctx.release(held)
                return value as integer
            elseif library == "setmetatable"
                or library == "getmetatable"
                or library == "rawget"
                or library == "rawset"
            then
                -- Metatables: __index and __newindex tables are followed by
                -- GetIdx and SetIdx; the library calls set and read them.
                local spec: {
                    [string]: {integer}
                } = {
                    setmetatable = {corelibrary.id("SETMETATABLE"), 2},
                    getmetatable = {corelibrary.id("GETMETATABLE"), 1},
                    rawget = {corelibrary.id("RAWGET"), 2},
                    rawset = {corelibrary.id("RAWSET"), 3}
                }
                local form: {integer} = need(spec[library as string], "metatable library call")
                need(#(node.args.exprs or {}) == form[2], tostring(library) .. " argument count is not admitted")
                return libraryCall(ctx, node, form[1], node.args.exprs)
            elseif library == "string.format" then
                return libraryCall(ctx, node, corelibrary.id("STRING_FORMAT"), node.args.exprs or {})
            elseif library == "print" then
                return printValues(ctx, node)
            elseif library == "math.random" then
                -- Without arguments a placeholder nil selects a floating draw.
                local args = node.args.exprs or {}
                need(#args <= 2, "math.random takes at most two arguments")
                if #args == 0 then
                    local none = ctx.emit(node, "Nil", {}, "tagged")
                    return ctx.emit(node, "LibCall", {corelibrary.id("MATH_RANDOM_FLOAT"), none}, "tagged") as integer
                end
                return libraryCall(ctx, node, corelibrary.id("MATH_RANDOM"), args)
            elseif library == "table.sort" then
                -- Without a comparator the sort step compares with `<` itself.
                local count = #(node.args.exprs or {})
                need(count == 1 or count == 2, "table.sort takes a table and an optional comparator")
                if count == 2 then
                    return sortWith(ctx, node)
                end
                return libraryCall(ctx, node, corelibrary.id("TABLE_SORT"), node.args.exprs)
            elseif library == "type" then
                need(#(node.args.exprs or {}) == 1, "type takes one value")
                return libraryCall(ctx, node, corelibrary.id("TYPE"), node.args.exprs)
            elseif library == "os.getenv" then
                need(#(node.args.exprs or {}) == 1, "os.getenv takes one name")
                return libraryCall(ctx, node, corelibrary.id("OS_GETENV"), node.args.exprs)
            elseif library == "hostcalls.collector" then
                need(#(node.args.exprs or {}) == 1, "hostcalls.collector takes its struct word count")
                return libraryCall(ctx, node, corelibrary.id("FOREIGN_COLLECTOR"), node.args.exprs)
            elseif library == "os.monotonic" or library == "hostcalls.arguments" then
                -- No arguments: a placeholder nil is the call's one value.
                need(#(node.args.exprs or {}) == 0, tostring(library) .. " takes no arguments")
                local none = ctx.emit(node, "Nil", {}, "tagged")
                local id = library == "os.monotonic" and corelibrary.id("OS_MONOTONIC")
                    or corelibrary.id("HOST_ARGUMENTS")
                return ctx.emit(node, "LibCall", {id, none}, "tagged") as integer
            elseif corelibrary.operation(library) then
                -- The file calls are one library call, the operation first.
                local spec = need(corelibrary.operation(library), "file call")
                local args = node.args.exprs or {}
                need(#args == spec.arguments, tostring(library) .. " argument count is not admitted")
                local evaluated = taggedOperands(ctx, args)
                if evaluated == nil then
                    return nil
                end
                local operation = ctx.emit(node, "K", {pool(ctx, "int64", tostring(spec.operation))}, "tagged")
                local operands: {any} = {corelibrary.opcall(library as string), operation}
                for _, value in ipairs(evaluated) do
                    operands[#operands + 1] = value
                end
                return landed(ctx, node, ctx.emit(node, "LibCall", operands, "tagged")) as integer
            elseif library == "collectgarbage" then
                -- collectgarbage(opt, ...): without an option, "collect";
                -- "param" takes a name and a value.
                local args = node.args.exprs or {}
                need(#args <= 3, "collectgarbage takes an option and two arguments")
                if #args == 0 then
                    local none = ctx.emit(node, "Nil", {}, "tagged")
                    return landed(
                        ctx,
                        node,
                        ctx.emit(node, "LibCall", {corelibrary.id("COLLECTGARBAGE"), none}, "tagged")
                    ) as integer
                end
                return libraryCall(ctx, node, corelibrary.id("COLLECTGARBAGE"), args)
            elseif coroutinepacked[library or ""] then
                -- Kept as one value: its pack's first.
                local pack = coroutinepack(ctx, node)
                if pack == nil then
                    return nil
                end
                local key = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
                return ctx.emit(node, "GetIdx", {pack, key}, "tagged") as integer
            elseif library == "coroutine.isyieldable" then
                need(#(node.args.exprs or {}) == 0, "coroutine.isyieldable takes no arguments")
                local none = ctx.emit(node, "Nil", {}, "tagged")
                return ctx.emit(node, "LibCall", {corelibrary.id("COROUTINE_ISYIELDABLE"), none}, "tagged") as integer
            elseif library == "string.char" and #(node.args.exprs or {}) > 1 then
                -- Several bytes: each one's string, joined in order. An
                -- out-of-range byte is reported as the first argument.
                local args = node.args.exprs
                local last = args[#args]
                need(
                    last.kind ~= "vararg" and not graph.expandsResults(last),
                    "string.char cannot spread its last argument yet"
                )
                local operands = taggedOperands(ctx, args)
                if operands == nil then
                    return nil
                end
                local held = {}
                for index, value in ipairs(operands) do
                    held[index] = ctx.hold(value)
                end
                local text: any = nil
                for index = 1, #held do
                    local byte = landed(
                        ctx,
                        node,
                        ctx.emit(node, "LibCall", {corelibrary.id("STRING_CHAR"), ctx.readHeld(held[index])}, "tagged")
                    )
                    if byte ~= nil and ctx.block ~= nil and text ~= nil then
                        local before = text
                        byte = landed(
                            ctx,
                            node,
                            ctx.emit(node, "LibCall", {corelibrary.id("CONCAT2"), ctx.readHeld(before), byte}, "tagged")
                        )
                        ctx.release(before)
                        text = nil
                    end
                    if byte == nil or ctx.block == nil then
                        if text ~= nil then
                            ctx.release(text)
                        end
                        for previous = #held, 1, -1 do
                            ctx.release(held[previous])
                        end
                        return nil
                    end
                    text = ctx.hold(byte)
                end
                local result = ctx.readHeld(text)
                ctx.release(text)
                for index = #held, 1, -1 do
                    ctx.release(held[index])
                end
                return result as integer
            elseif library == "coroutine.create" and #(node.args.exprs or {}) > 1 then
                -- create(f, ...): the arguments after f bound, as one pack.
                local args = node.args.exprs
                local body = ctx.expression(args[1], "tagged")
                if body == nil then
                    return nil
                end
                local held = ctx.hold(body)
                local rest = {}
                for index = 2, #args do
                    rest[#rest + 1] = args[index]
                end
                local pack = valuespack(ctx, node, rest)
                if pack == nil then
                    ctx.release(held)
                    return nil
                end
                local value = ctx.readHeld(held)
                ctx.release(held)
                return landed(
                    ctx,
                    node,
                    ctx.emit(node, "LibCall", {corelibrary.id("COROUTINE_CREATE"), value, pack}, "tagged")
                ) as integer
            elseif stringSpec(library) then
                local spec: {integer} = need(stringSpec(library), "string library call")
                local count = #(node.args.exprs or {})
                need(count >= spec[2] and count <= spec[3], tostring(library) .. " argument count is not admitted")
                return libraryCall(ctx, node, spec[1], node.args.exprs)
            elseif library == "math.floor" then
                need(#(node.args.exprs or {}) == 1, "math.floor takes one number")
                local operand = ctx.expression(node.args.exprs[1], "tagged")
                if operand == nil then
                    return nil
                end
                return ctx.emit(node, "MathFloor", {operand}, "tagged") as integer
            end
            need(expected == nil or expected == "tagged", "call requires tagged destination")

            return invoke(ctx, node, true, true)
        end
        -- s:format(...) on a checked string.
        profile.methodCall = function(ctx: any, node: any, expected: string?): integer?
            need(expected == nil or expected == "tagged", "method call requires tagged destination")
            local site = catalog(ctx).callByNode[node]
            if site and site.method then
                return invokeMethod(ctx, node, true)
            end
            local library = graph.coreLibraryCall(node)
            -- A thread's methods (`co:resume(x)`) are the coroutine library's.
            if coroutinepacked[library or ""] then
                local pack = coroutinepack(ctx, node)
                if pack == nil then
                    return nil
                end
                local key = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
                return ctx.emit(node, "GetIdx", {pack, key}, "tagged") as integer
            end
            need(
                library == "string.format" or stringSpec(library) ~= nil,
                "only string library method calls are admitted"
            )
            local arguments = {node.obj}
            for _, argument in ipairs(node.args.exprs or {}) do
                arguments[#arguments + 1] = argument
            end
            if library == "string.format" then
                return libraryCall(ctx, node, corelibrary.id("STRING_FORMAT"), arguments)
            end
            local spec: {integer} = need(stringSpec(library), "string library call")
            need(
                #arguments >= spec[2] and #arguments <= spec[3],
                tostring(library) .. " argument count is not admitted"
            )

            return libraryCall(ctx, node, spec[1], arguments)
        end
        profile.statementCall = function(ctx: any, node: any): nil
            local site = catalog(ctx).callByNode[node]
            if node.kind == "safeCall" then
                taggedcalls.safeinvoke(ctx, node, false)
            elseif node.layoutOf
                or graph.dynamicRequire(node)
                or node.ownershipIntrinsic
                or scalarwitness(ctx, node)
            then
                profile.call(ctx, node, nil)
            elseif node.runtimeLoader == "require" then
                statementCall(ctx, node)
            elseif node.kind == "methodCall" and site and site.method then
                invokeMethod(ctx, node, false)
            elseif node.kind == "methodCall" and coroutinepacked[graph.coreLibraryCall(node) or ""] then
                profile.methodCall(ctx, node, nil)
            elseif graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall" then
                invokeProtected(ctx, node, false)
            elseif node.kind == "call" and graph.coreLibraryCall(node) ~= nil then
                -- error, setmetatable and the other library calls made for
                -- their effect.
                profile.call(ctx, node, nil)
            else
                invoke(ctx, node, false, true)
            end
        end
        profile.unary = function(ctx: any, node: any, expected: string?): integer?
            if node.fixedArithmetic then
                return taggedstatements.scalar(ctx, node, node.fixedArithmetic, {node.operand})
            elseif node.op
                and node.op.text == "~"
                and typeKind(node.inferredType) == "int32"
                and node.fixedWidthEstablished
                and node.fixedWidthEstablished.int32
            then
                return taggedstatements.scalar(ctx, node, "i32.notBits", {node.operand})
            end
            if node.op and (node.op.kind or node.op.text) == "not" then
                need(expected == nil or expected == "tagged", "negation requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil
                end
                return ctx.emit(node, "Not", {operand}, "tagged") as integer
            end
            if node.op and node.op.text == "#" then
                need(expected == nil or expected == "tagged", "length requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil
                end
                local view = indexedviews.describe(node.operand.inferredType)
                local marked = node.indexedLength
                if marked ~= nil or view ~= nil then
                    indexedaccess.descriptor(
                        node.operand,
                        marked,
                        "indexed length lacks its checked sealed view descriptor"
                    )
                    local slot = fieldSlot(ctx, node.operand.inferredType, "count")
                    need(
                        slot ~= nil or keyedByName((view as indexedviews.Descriptor).nominal),
                        "indexed length count layout is unavailable"
                    )
                    local origin = recordOrigin(node.operand.inferredType)
                    local key = slot ~= nil and origin ~= nil and taggedvalues.slotKey(ctx, node, origin, "count")
                        or ctx.emit(node, "K", {pool(ctx, "str", "count")}, "tagged")
                    return ctx.emit(node, "GetIdx", {operand, key}, "tagged") as integer
                end
                return ctx.emit(node, "Len", {operand}, "tagged") as integer
            end
            -- `-x` as `x * -1`, which is Lua's negation for both kinds: it
            -- flips a float's sign (so -0.0 survives) and wraps an integer.
            if node.op and node.op.text == "-" and catalog(ctx).byNode[node] == nil then
                need(expected == nil or expected == "tagged", "negation requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil
                end
                -- An operand not known to be a number may be a table with
                -- __unm, which the library call tries first.
                local kind = typeKind(node.operand.inferredType)
                if kind ~= "number" and kind ~= "float64" and kind ~= "int64" then
                    return ctx.emit(node, "LibCall", {corelibrary.id("UNM"), operand}, "tagged") as integer
                end
                local held = ctx.hold(operand)
                local minusOne = ctx.emit(node, "K", {pool(ctx, "int64", "-1")}, "tagged")
                operand = ctx.readHeld(held)
                ctx.release(held)
                return ctx.emit(node, "Mul", {operand, minusOne}, "tagged") as integer
            end

            -- `~x`, a core library call (guestnumbers).
            if node.op and node.op.text == "~" and catalog(ctx).byNode[node] == nil then
                need(expected == nil or expected == "tagged", "bitwise not requires tagged destination")
                return libraryCall(ctx, node, corelibrary.id("BNOT"), {node.operand})
            end

            return unary(ctx, node, expected)
        end
    end

    if version >= 8 then
        profile.finish = function(ctx: any): nil
            local g = ctx.g
            need(
                g.native == nil and g.exactTypes == nil and g.nativePhysical == nil,
                "transport compaction requires a tagged source graph"
            )
            for _, kind in ipairs(g.types) do
                need(kind == "v", "transport compaction requires tagged values")
            end
            need(g.counts.i == 0 and g.counts.f == 0 and g.counts.x == 0, "tagged graph has physical slot hints")
            -- The frontend verified the original graph. Remove only unused
            -- transport, then compact hints before the core's bounded copy.
            graph.prune(g)
            local count: integer = 0
            for value = g.nparams + 1, #g.types do
                g.slots[value] = count
                count += 1
            end
            g.counts.v = count
            graph.verify(g)
        end
        local withCleanup: any = nil
        profile.forOwner = function(p: any, owner: any): any
            -- Plain Lua chunks have no checked ownership. A checked Nupp
            -- module instance keeps the same cleanups as a linked module.
            if (p.chunk and not p.chunkModule) or not (p.cleanupOwners and p.cleanupOwners[owner.id]) then
                return profile
            end
            withCleanup = withCleanup or cleanupProfile(profile)

            return withCleanup
        end
        laneOperations(profile)
        columnarOperations(profile)
    end

    return profile
end

export function exportStatement(ctx: any, stat: any): nil
    need(ctx.fn.kind == "module", "an export belongs to a module")
    -- A named export's statement runs as it is; exportNames stores it.
    if stat.stat then
        need(ctx.exports ~= nil, "named exports need the module's export table")
        return
    end
    need(stat.value, "export needs a value")
    local value = ctx.expression(stat.value, "tagged")
    ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
    ctx.block = nil
end

export function returnStatement(ctx: any, stat: any): nil
    need(#stat.exprs <= 1, "multiple results are unsupported")
    local value = stat.exprs[1] and ctx.expression(stat.exprs[1], "tagged") or nil
    ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
    ctx.block = nil
end

export function fallthrough(ctx: any, node: any): nil
    ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(node.eof or node)}
    ctx.block = nil
end
