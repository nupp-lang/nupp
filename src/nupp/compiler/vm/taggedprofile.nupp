module nupp.compiler.vm.taggedprofile

local graph = require("nupp.compiler.vm.graph")
local graphimage = require("nupp.compiler.vm.graphimage")
local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local tagged = {booleanKind = "tagged"}

-- The graphs built with the cleanup protocol (a graph carries no extra
-- fields), whose calls report ownership moves to it.
local cleanupGraphs: {[any]: boolean} = setmetatable({}, {__mode = "k"})

-- After a call in a function that owns affine values: when an error landed
-- here, the failure path destroys the owners and raises it again.
local function landed(ctx: any, node: any, result: any): any
    if not cleanupGraphs[ctx.g] or ctx.block == nil then
        return result
    end
    local none = ctx.emit(node, "Nil", {}, "tagged")
    local status = ctx.emit(node, "LibCall", {45, none}, "tagged")
    if type(result) == "table" then
        local held = {}
        for index, value in ipairs(result) do
            held[index] = ctx.hold(value)
        end
        ctx.afterCall(node, nil, status)
        local values = {}
        for index, handle in ipairs(held) do
            values[index] = ctx.readHeld(handle)
            ctx.release(handle)
        end
        return values
    end

    return ctx.afterCall(node, result, status)
end

local function need(ok: any, message: string): any
    assert(ok, "tagged graph: " .. message)
    return ok
end

local function catalog(ctx: any): any
    local p = need(ctx.options.program, "checked program catalog required")
    need(p.owners[ctx.fn.id + 1] == ctx.fn, "foreign checked owner")
    return p
end

local function binding(ctx: any, key: any): any
    return need(catalog(ctx).byDefinition[key], "missing checked lexical declaration")
end

-- A borrowing capture moves nothing: the closure reads the owner as any
-- capture reads its value. A taking one needs the closure to own it.
local function ordinaryCaptures(owner: any): nil
    for _, item in ipairs(owner.captures) do
        need(
            item.mode == "value" or item.mode == "cell" or item.mode == "borrow",
            "taking captures require ownership cleanup and lifetime lowering"
        )
    end
end

function tagged.initializeModule(fn: any, options: any): any
    need(options.program and options.program.owners[fn.id + 1] == fn, "checked module owner required")
    return graph.new(0)
end

function tagged.initialize(fn: any, options: any): any
    need(options.program and options.program.owners[fn.id + 1] == fn, "checked function owner required")
    need(
        fn.node.kind == "localFuncStmt"
        or fn.node.kind == "funcExpr"
        or fn.node.kind == "funcStmt"
        or fn.node.kind == "inlineMethod"
        or fn.node.kind == "constructorDecl",
        "unsupported function declaration form"
    )
    local body = fn.body
    -- Plain type parameters erase; packs and const parameters do not.
    need(not body.generics or next(fn.signature.constParams or {}) == nil, "const generic parameters are unsupported")
    need(
        -- A constructor's results are dropped: its construction is the instance.
        -- Open results (`R...`) return as many as there are.
        fn.node.kind == "constructorDecl" or #fn.signature.rets <= 16 and not fn.signature.retPack.alternatives,
        "correlated result alternatives are unsupported"
    )
    ordinaryCaptures(fn)
    local params = graph.parameters(body)
    for index, parameter in ipairs(params) do
        -- A `...` last is the hidden pack parameter, named or not.
        local pack = parameter.vararg and index == #params
        need(
            -- `takes`, `borrows` and `exclusive` are ownership facts the
            -- checker settled: the core passes the value.
            (parameter.name and not parameter.vararg or pack) and not parameter.constTok,
            "parameter ownership or variadic lowering is unsupported"
        )
    end

    return graph.new(#params)
end

function tagged.valueKind(g: any, id: integer): string
    need(g.types[id] == "v", "tagged value required")
    return "tagged"
end

function tagged.newValue(g: any, kind: string): integer
    need(kind == "tagged", "tagged value required")
    return graph.value(g, "v")
end

function tagged.localKind(token: any, fn: any): string
    return "tagged"
end

function tagged.emit(ctx: any, node: any, op: string, args: any, kind: string?): integer?
    need(kind == nil or kind == "tagged", "tagged result required")
    return graph.emit(ctx.g, ctx.block, op, args, ctx.position(node))
end

-- The string library calls guestlib implements: id and the argument counts
-- admitted, the string itself included.
local stringLibrary: {[string]: {integer}} = {
    ["string.sub"] = {11, 2, 3},
    ["string.byte"] = {12, 1, 3},
    ["string.char"] = {13, 1, 1},
    ["string.rep"] = {14, 2, 3},
    ["string.upper"] = {15, 1, 1},
    ["string.lower"] = {16, 1, 1},
    ["string.len"] = {17, 1, 1},
    ["string.find"] = {18, 2, 4},
    ["string.match"] = {19, 2, 3},
    ["string.gsub"] = {26, 3, 4},
    ["string.reverse"] = {66, 1, 1},
    -- The math library calls guestlib implements.
    ["math.abs"] = {38, 1, 1},
    ["math.ceil"] = {39, 1, 1},
    ["math.max"] = {40, 1, 4},
    ["math.min"] = {41, 1, 4},
    ["math.tointeger"] = {42, 1, 1},
    ["math.type"] = {43, 1, 1},
    ["math.sqrt"] = {44, 1, 1},
    ["math.f32.narrow"] = {91, 1, 1},
    ["math.u32.wrap"] = {92, 1, 1},
    ["storagecalls.allocbytes"] = {94, 1, 1},
    ["storagecalls.allocate"] = {95, 2, 2},
    ["storagecalls.view"] = {96, 3, 4},
    ["storagecalls.cast"] = {103, 2, 2},
    ["storagecalls.copy"] = {97, 3, 3},
    ["storagecalls.fill"] = {98, 3, 3},
    ["storagecalls.text"] = {99, 2, 2},
    ["storagecalls.fromstring"] = {100, 1, 1},
    ["storagecalls.elements"] = {101, 1, 1},
    ["storagecalls.elementkind"] = {102, 1, 1},
    ["math.i32.wrap"] = {93, 1, 1},
    rawequal = {88, 2, 2},
    next = {89, 1, 2},
    ["math.exp"] = {57, 1, 1},
    ["math.log"] = {58, 1, 2},
    ["math.sin"] = {59, 1, 1},
    ["math.cos"] = {60, 1, 1},
    ["math.tan"] = {61, 1, 1},
    ["math.asin"] = {62, 1, 1},
    ["math.acos"] = {63, 1, 1},
    ["math.atan"] = {64, 1, 2},
    ["math.fmod"] = {65, 2, 2},
    -- The table library calls guestlib implements, by the same shape.
    ["table.insert"] = {34, 2, 3},
    ["table.remove"] = {35, 1, 2},
    ["table.unpack"] = {36, 1, 3},
    ["table.move"] = {67, 4, 5},
    ["table.freeze"] = {114, 1, 1},
    ["table.isfrozen"] = {115, 1, 1},
    -- The coroutine library calls answering one value.
    ["coroutine.create"] = {75, 1, 1},
    ["coroutine.status"] = {78, 1, 1},
    ["coroutine.wrap"] = {79, 1, 1}
}

local function stringSpec(library: string?): {integer}?
    if library == nil then
        return nil
    end

    return stringLibrary[library]
end

-- The string library calls with several results: the id of the form that
-- answers every result as a pack.
local packLibrary: {
    [string]: integer
} = {
    ["string.find"] = 23,
    ["string.match"] = 24,
    ["string.byte"] = 25,
    ["string.gsub"] = 27,
    ["table.unpack"] = 37,
    next = 90,
    ["coroutine.resume"] = 76,
    ["coroutine.yield"] = 77,
    ["coroutine.running"] = 80,
    ["coroutine.close"] = 82
}

-- The coroutine calls answering a pack, which coroutinepack makes.
local coroutinepacked: {
    [string]: boolean
} = {["coroutine.resume"] = true, ["coroutine.yield"] = true, ["coroutine.running"] = true, ["coroutine.close"] = true}

local function packSpec(library: string?): integer?
    if library == nil then
        return nil
    end

    return packLibrary[library]
end

local gsubWith: function(any, any, any, boolean): integer
local packedCall: function(any, any, any, integer): integer
local librarypack: function(any, any): integer?

-- A core library call (guestlib): its arguments staged as values.
local function libraryCall(ctx: any, node: any, id: integer, arguments: any): integer
    -- gsub with a function replacement calls it, so it is a loop.
    if (id == 26 or id == 27) and graph.callbackArgument(node) ~= nil then
        return gsubWith(ctx, node, arguments, id == 27)
    end
    -- string.format and table.move past four arguments, or spreading a
    -- `...` or a call's results last, take the rest packed.
    local last = arguments[#arguments]
    if (id == 2 or id == 67)
        and (#arguments > 4 or #arguments > 1 and (last.kind == "vararg" or graph.expandsResults(last)))
    then
        return packedCall(ctx, node, arguments, id == 2 and 54 or 68)
    end
    need(#arguments >= 1 and #arguments <= 4, "core library calls take one to four arguments")
    need(arguments[#arguments].kind ~= "vararg", "a library call cannot spread `...` yet")
    local kinds = {}
    for index = 1, #arguments do
        kinds[index] = "tagged"
    end
    local operands = ctx.operands(arguments, kinds)
    if operands == nil then
        return nil as any
    end
    -- A call in method form (`s:rep(n)`) sets the id's high bit, so its
    -- errors count arguments from the one after self, as Lua's do.
    table.insert(operands, 1, node.kind == "methodCall" and id + 128 or id)

    -- A function that owns affine values lands an error the library raises
    -- here as it lands one from a call.

    return landed(ctx, node, ctx.emit(node, "LibCall", operands, "tagged")) as integer
end

-- The nominal record type behind a checked type, or nil.
local function recordOrigin(t: any): any
    -- Ownership qualifiers (affine, borrowed, pinned) wrap the record type.
    while t
        and (t.tag == "const" or t.tag == "literal" or t.tag == "affine" or t.tag == "borrowed" or t.tag == "pinned") do
        t = t.tag == "literal" and t.base or t.inner
    end
    local origin = t and (t.origin or t)
    if origin and origin.tag == "nominal" and origin.declKind == "record" and origin.fieldOrder then
        return origin
    end

    return nil
end

-- The record behind a checked type when the program declares it, whose
-- instances keep fields in slots. A record a declaration file describes is
-- a table the host or Lua code makes, keyed by its field names.
local function ownrecord(ctx: any, t: any): any
    local origin = recordOrigin(t)
    if origin and catalog(ctx).recordDecls[origin.deriveDeclaration] then
        return origin
    end

    return nil
end

-- A record field's key: its position in the declaration order.
local function recordSlot(origin: any, name: string?): integer?
    if origin == nil or name == nil then
        return nil
    end
    for index, field in ipairs(origin.fieldOrder) do
        if field == name then
            return index
        end
    end

    return nil
end

-- A field's slot in a value of type `t`: its record's, or, for a union of
-- records, the slot every member gives it when they all agree.
local function fieldSlot(ctx: any, t: any, name: string?): integer?
    local slot = recordSlot(ownrecord(ctx, t), name)
    while slot == nil and t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    if slot ~= nil or not t or t.tag ~= "union" or #(t.members or {}) == 0 then
        return slot
    end
    for _, member in ipairs(t.members) do
        local found = recordSlot(ownrecord(ctx, member), name)
        if found == nil or slot ~= nil and found ~= slot then
            return nil
        end
        slot = found
    end

    return slot
end

local function pool(ctx: any, kind: string, value: any): integer
    local index = #ctx.g.constants
    ctx.g.constants[index + 1] = {kind = kind, value = value}
    return index
end

function tagged.literal(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "literal requires tagged destination")
    local constant = need(
        catalog(ctx).byNode[node],
        "literal lacks checked constant identity: " .. tostring(
            node.kind
        ) .. " at line " .. tostring(node.token and node.token.line or node.op and node.op.line)
    )
    if constant.kind == "nil" then
        return ctx.emit(node, "Nil", {}, "tagged")
    end
    local value = constant.bytes
    if constant.kind == "int64" or constant.kind == "uint64" then
        value = constant.text
    end

    return ctx.emit(node, "K", {pool(ctx, constant.kind, value)}, "tagged")
end

function tagged.valueLiteral(ctx: any, node: any, expected: string?): integer
    return tagged.literal(ctx, node, expected)
end

-- A library function taken as a value: `nupp.runtime.libraryvalues`'s
-- function under its name, the module required as any is.
local function libraryValue(ctx: any, node: any): integer?
    local site = catalog(ctx).requireByNode[node]
    if not site or not site.library then
        return nil
    end
    need(site.owner == ctx.fn.id, "foreign library value")
    local loaded = ctx.emit(node, "Require", {pool(ctx, "str", site.module)}, "tagged")
    local functionsKey = ctx.emit(node, "K", {pool(ctx, "str", "functions")}, "tagged")
    local functions = ctx.emit(node, "GetIdx", {loaded, functionsKey}, "tagged")
    local key = ctx.emit(node, "K", {pool(ctx, "str", site.library)}, "tagged")

    return ctx.emit(node, "GetIdx", {functions, key}, "tagged")
end

function tagged.constant(ctx: any, node: any, expected: string?): integer
    local value = libraryValue(ctx, node)
    if value ~= nil then
        return value
    end
    local token = cst.firstToken(node)
    error(
        "tagged graph: unresolved lexical or external value: " .. tostring(
            node.kind
        ) .. (
            node.name and node.name.text and " ." .. node.name.text or ""
        ) .. (
            node.obj and " on " .. tostring(node.obj.inferredType and node.obj.inferredType.tag) or ""
        ) .. " " .. tostring(
            token and token.text
        ) .. " at " .. tostring(ctx.fn and ctx.fn.scope and ctx.fn.scope.path) .. ":" .. tostring(token and token.line),
        0
    )
end

function tagged.unary(ctx: any, node: any, expected: string?): integer
    need(catalog(ctx).byNode[node] ~= nil, "nonliteral unary operations are unsupported")
    return tagged.literal(ctx, node, expected)
end

local function typeKind(t: any): string
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    return t and t.tag or "missing"
end

-- Whether a value of type `t` is an interface's: a table its fields are
-- read from by name.
local function interfacetype(t: any): boolean
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    return t ~= nil and t.tag == "nominal" and t.declKind == "interface"
end

-- Fixed widths are integers and floats at run time; uint64 is not, since
-- past 2^63 its order is not int64's.
local narrowIntegers: {
    [string]: boolean
} = {int64 = true, int8 = true, int16 = true, int32 = true, uint8 = true, uint16 = true, uint32 = true,}

local function numberType(t: any): boolean
    local kind = typeKind(t)
    return kind == "number" or kind == "float64" or kind == "float32"
end

local function integerType(t: any): boolean
    return narrowIntegers[typeKind(t)] == true
end

local numericType: function(any): boolean
numericType = function(t: any): boolean
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    -- A union of numbers (`integer | number`) is a number either way.
    if t and t.tag == "union" and #(t.members or {}) > 0 then
        for _, member in ipairs(t.members) do
            if not numericType(member) then
                return false
            end
        end
        return true
    end

    return numberType(t) or integerType(t)
end

local arithmetic = {["+"] = "Add", ["-"] = "Sub", ["*"] = "Mul", ["%"] = "Mod"}
local ordering = {["<"] = "Lt", ["<="] = "Le", [">"] = "Lt", [">="] = "Le", ["=="] = "Eq"}

local function scalarType(t: any): boolean
    local kind = typeKind(t)
    return kind == "boolean" or kind == "nil"
end

-- Before v6 only float addition and less-than are admitted. v6 admits the
-- dynamic numeric operators over checked integer, float or number operands;
-- `a > b` evaluates both operands in order and then compares as `b < a`.
local function binary(ctx: any, node: any, expected: string?, version: integer): integer
    local operation = node.op.text
    need(expected == nil or expected == "tagged", "tagged result required")
    -- From v8 `..`, `/`, `//` and the bitwise operators are core library
    -- calls (guestlib, guestbits).
    local library = version >= 8
        and ({
            [".."] = 5,
            ["/"] = 6,
            ["//"] = 7,
            ["^"] = 56,
            ["&"] = 107,
            ["|"] = 108,
            ["~"] = 109,
            ["<<"] = 110,
            [">>"] = 111,
        })[operation]
    if library then
        return libraryCall(ctx, node, library, {node.lhs, node.rhs})
    end
    -- From v8 `a ~= b` is `not (a == b)`.
    if operation == "~=" and version >= 8 then
        local operands = ctx.operands({node.lhs, node.rhs}, {"tagged", "tagged"})
        if operands == nil then
            return nil as any
        end
        local equal = ctx.emit(node, "Eq", operands, "tagged")
        return ctx.emit(node, "Not", {equal}, "tagged")
    end
    local admits = version >= 6 and numericType or numberType
    local op = arithmetic[operation] or ordering[operation]
    need(
        version >= 6 and op ~= nil or operation == "+" or operation == "<",
        version >= 6 and "unsupported numeric operator" or "only number addition is admitted"
    )
    if arithmetic[operation] then
        need(version >= 8 or admits(node.inferredType), "number result required")
    else
        need(typeKind(node.inferredType) == "boolean", "boolean result required")
    end
    if operation == "==" then
        -- Equality compares any checked scalars: numbers exactly, Booleans
        -- and nil by identity.
        admits = function(t: any): boolean
            return numericType(t) or scalarType(t)
        end
    end
    -- From v8 operands may be dynamic values; the handlers check them.
    if version < 8 then
        need(admits(node.lhs.inferredType), "left number required")
        need(admits(node.rhs.inferredType), "right number required")
    end
    local operands = ctx.operands({node.lhs, node.rhs}, {"tagged", "tagged"})
    if operands == nil then
        return nil as any
    end
    if operation == ">" or operation == ">=" then
        operands = {operands[2], operands[1]}
    end

    return ctx.emit(node, op, operands, "tagged")
end

function tagged.binary(ctx: any, node: any, expected: string?): integer
    return binary(ctx, node, expected, 2)
end

function tagged.checkLogical(ctx: any, node: any): boolean
    error("tagged graph: logical expressions are outside lexical construction", 0)
end

function tagged.missingLocal(ctx: any, node: any, expected: string?): integer
    return ctx.emit(node, "Nil", {}, "tagged")
end

function tagged.initializeBinding(ctx: any, node: any, key: any, value: integer): integer
    local b = binding(ctx, key)
    need(b.owner == ctx.fn.id and b.storage ~= "erased", "invalid local storage owner")
    return b.storage == "cell" and ctx.emit(node, "NewCell", {value}, "tagged") or value
end

function tagged.readBinding(ctx: any, node: any, key: any, value: integer, expected: string?): integer
    need(expected == nil or expected == "tagged", "lexical read requires tagged value")
    return binding(ctx, key).storage == "cell" and ctx.emit(node, "GetCell", {value}, "tagged") or value
end

function tagged.writeBinding(ctx: any, node: any, key: any, previous: integer, value: integer): integer
    local b = binding(ctx, key)
    need(not b.definition.constant or node.kind == "localFuncStmt", "assignment to immutable declaration")
    if b.storage == "cell" then
        ctx.emit(node, "SetCell", {previous, value}, nil)
        return previous
    end
    need(b.owner == ctx.fn.id, "assignment cannot replace captured value storage")

    return value
end

function tagged.entryBindings(ctx: any, node: any): nil
    ordinaryCaptures(ctx.fn)
    for _, item in ipairs(ctx.fn.captures) do
        local value = ctx.emit(node, "GetUpval", {item.id}, "tagged")
        ctx.bind(item.definition, value)
    end
end

function tagged.recursiveBinding(ctx: any, node: any, key: any): integer?
    if binding(ctx, key).storage == "cell" then
        local value = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.emit(node, "NewCell", {value}, "tagged")
    end

    return nil
end

function tagged.closure(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "closure requires tagged destination")
    need(
        node.kind == "localFuncStmt"
        or node.kind == "funcExpr"
        or node.kind == "funcStmt"
        or node.kind == "inlineMethod"
        or node.kind == "constructorDecl",
        "unsupported function declaration form"
    )
    local target = need(catalog(ctx).byBody[node.body], "closure lacks checked owner")
    need(target.node == node and target.parent == ctx.fn.id, "closure owner identity mismatch")
    ordinaryCaptures(target)
    local args = {target.id}
    for _, item in ipairs(target.captures) do
        -- Forward the stored value itself. A shared cell must not be read and
        -- reconstructed when an intermediate closure forwards it.
        args[#args + 1] = ctx.storage(item.definition)
    end

    return ctx.emit(node, "Closure", args, "tagged")
end

local function requireSite(ctx: any, node: any): any
    local item = need(catalog(ctx).requireByNode[node], "only checked static require calls are supported")
    need(item.owner == ctx.fn.id and node.runtimeLoader == "require", "foreign require callsite")
    need(
        type(item.module) == "string" and (item.target ~= nil or item.typeOnly or item.corecalls),
        "dynamic or missing require target is unsupported: " .. tostring(item.module)
    )

    return item
end

-- A checked call. With `count`, it keeps that many results and answers them
-- as a list.
-- With `open`, it keeps every result as one pack.
local function invoke(ctx: any, node: any, keepResult: boolean, dynamic: boolean?, count: integer?, open: boolean?): any
    -- A library call with several results is open already: its pack.
    if open and graph.packedcall(node) then
        return librarypack(ctx, node)
    end
    local p = catalog(ctx)
    local site = need(
        p.callByNode[node],
        "ordinary call lacks checked callsite DEBUG " .. tostring(
            node.kind
        ) .. " " .. tostring(
            node.obj and node.obj.token and node.obj.token.text
        ) .. " " .. tostring(
            node.obj and node.obj.name and node.obj.name.text
        ) .. " line " .. tostring(
            node.obj and node.obj.token and node.obj.token.line
        ) .. " " .. tostring(graph.coreLibraryCall(node)) .. " open " .. tostring(open)
    )
    need(site.owner == ctx.fn.id, "callsite belongs to another owner")
    local target = ctx.callee(node)
    local contract
    if target == nil and dynamic then
        -- From v8 a call through a function value is resolved when it runs.
        need(p.functionsByDefinition[site.definition] == nil, "dynamic call names a declaration")
        contract = graph.dynamicInvokeContract(node, count)
    else
        need(target, "call requires a stable checked declaration")
        need(
            p.owners[target.id + 1] == target and p.functionsByDefinition[site.definition] == target,
            "call target belongs to another catalog"
        )
        contract = graph.invokeContract(target, node)
    end
    -- The declaration supplies an expected contract, never the runtime callee.
    -- Evaluate that callee before any argument, and retain its snapshot across
    -- every nested call. Runtime FunctionInfo authentication remains pending.
    local callee = ctx.hold(ctx.expression(node.obj, "tagged"))
    -- A `...` last spreads its whole pack after the fixed arguments, and so
    -- does a call last that gives other than one result.
    local exprs = node.args.exprs
    local spreads = #exprs > 0 and exprs[#exprs].kind == "vararg"
    local expands = #exprs > 0 and not spreads and graph.expandsResults(exprs[#exprs])
    local fixed, kinds = {}, {}
    for index, expr in ipairs(exprs) do
        if index < #exprs or not spreads and not expands then
            fixed[#fixed + 1], kinds[#kinds + 1] = expr, "tagged"
        end
    end
    local args = ctx.operands(fixed, kinds)
    -- Parameters the call leaves off are nil, as Lua passes them.
    if args ~= nil and not spreads and not expands and graph.omits(contract.callSignature, #args) then
        while #args < #contract.callSignature.params do
            args[#args + 1] = ctx.emit(node, "Nil", {}, "tagged")
        end
    end
    local pack = spreads and ctx.varargPack() or nil
    if expands and args ~= nil then
        local held = {}
        for index, arg in ipairs(args) do
            held[index] = ctx.hold(arg)
        end
        pack = invoke(ctx, exprs[#exprs], true, true, nil, true)
        for index, handle in ipairs(held) do
            args[index] = ctx.readHeld(handle)
            ctx.release(handle)
        end
        if pack == nil or ctx.block == nil then
            ctx.release(callee)
            return nil
        end
    end
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    if cleanupGraphs[ctx.g] and node.kind == "call" then
        ctx.beforeCall(node)
    end
    if count then
        return landed(ctx, node, ctx.invokeMany(node, value, args, contract, count, pack))
    end

    return landed(ctx, node, ctx.invoke(node, value, args, contract, keepResult, pack, open))
end

-- A field's default, which the checker keeps as its closed value: an
-- integer, float, string, Boolean, an explicit `nil`, or a table of those,
-- built fresh for each construction.
local defaultConstant: function(any, any, any): integer
defaultConstant = function(ctx: any, node: any, value: any): integer
    if type(value) == "table" then
        local keys = {}
        for key in pairs(value) do
            keys[#keys + 1] = key
        end
        -- Integer keys first in order, then names, so the build is the same
        -- every compile.
        table.sort(keys, function(a: any, b: any): boolean
            if type(a) ~= type(b) then
                return type(a) == "number"
            end
            return a < b
        end)
        local held = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
        for _, key in ipairs(keys) do
            local item = ctx.hold(defaultConstant(ctx, node, value[key]))
            local slot = type(key) == "string" and ctx.emit(node, "K", {pool(ctx, "str", key)}, "tagged")
                or ctx.emit(
                    node,
                    "K",
                    {
                        pool(
                            ctx,
                            "int64",
                            tostring(
                                need(
                                    math.type(key) == "integer" and key,
                                    "a table default key is not an integer or name"
                                )
                            )
                        )
                    },
                    "tagged"
                )
            ctx.emit(node, "SetIdx", {ctx.readHeld(held), slot, ctx.readHeld(item)}, nil)
            ctx.release(item)
        end
        local result = ctx.readHeld(held)
        ctx.release(held)
        return result as integer
    end
    if value == nil then
        return ctx.emit(node, "Nil", {}, "tagged") as integer
    elseif type(value) == "string" then
        return ctx.emit(node, "K", {pool(ctx, "str", value)}, "tagged") as integer
    elseif type(value) == "boolean" then
        return ctx.emit(node, "K", {pool(ctx, value and "true" or "false", "")}, "tagged") as integer
    end
    if math.type(value) == "float" then
        return ctx.emit(node, "K", {pool(ctx, "num", graphimage.floatBytes(value as number))}, "tagged") as integer
    end
    need(
        math.type(value) == "integer",
        "only integer, float, string, Boolean and table field defaults are admitted, got " .. type(value)
    )

    return ctx.emit(node, "K", {pool(ctx, "int64", tostring(value))}, "tagged") as integer
end

-- `new R(...)` with a constructor: a fresh instance with R's field
-- defaults, then R's constructor called with it first (from the table R's
-- name holds); the instance is the value.
local function construct(ctx: any, node: any, origin: any): any
    local p = catalog(ctx)
    local call = node.call
    local site = need(p.callByNode[call], "construction lacks its checked callsite")
    need(site.construct and site.owner == ctx.fn.id, "construction callsite belongs to another owner")
    local target = need(p.functionsByDefinition[site.definition], "construction lacks its constructor")
    local contract = graph.constructContract(target, call)
    local class = site.classExpr and ctx.expression(site.classExpr, "tagged")
        or ctx.expression({kind = "name", token = site.classToken, site.classToken}, "tagged")
    if class == nil then
        return nil
    end
    local heldClass = ctx.hold(class)
    local name = "\0new" .. tostring(call.constructorEntry.index)
    local key = ctx.emit(node, "K", {pool(ctx, "str", name)}, "tagged")
    local callee = ctx.hold(ctx.emit(node, "GetIdx", {ctx.readHeld(heldClass), key}, "tagged"))
    local instance = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
    ctx.emit(node, "LibCall", {28, ctx.readHeld(instance), ctx.readHeld(heldClass)}, "tagged")
    ctx.release(heldClass)
    for _, field in ipairs(origin.fieldOrder or {}) do
        local default = origin.fieldDefaults and origin.fieldDefaults[field]
        if default then
            local value = defaultConstant(ctx, node, default.value)
            local slot = need(recordSlot(origin, field), "record field is not declared")
            local slotKey = ctx.emit(node, "K", {pool(ctx, "int64", tostring(slot))}, "tagged")
            ctx.emit(node, "SetIdx", {ctx.readHeld(instance), slotKey, value}, nil)
        end
    end
    local exprs, kinds = {}, {}
    for _, argument in ipairs(call.args and call.args.exprs or {}) do
        need(argument.kind ~= "vararg", "a constructor call cannot spread `...` yet")
        exprs[#exprs + 1], kinds[#kinds + 1] = argument, "tagged"
    end
    local args = ctx.operands(exprs, kinds)
    if args == nil then
        return nil
    end
    local first: integer = ctx.readHeld(instance)
    table.insert(args, 1, first)
    local value = ctx.readHeld(callee)
    ctx.release(callee)
    ctx.invoke(call, value, args, contract, false)
    local result = ctx.readHeld(instance)
    ctx.release(instance)

    return result
end

-- pcall(f, ...): f called as a protected call, its results after true, or
-- false and the error. With `count`, it keeps that many results.
-- xpcall(f, handler, ...) is the same call with its handler, evaluated
-- second and carried last among the arguments, answering in the error's
-- place.
local function invokeProtected(ctx: any, node: any, keepResult: boolean, count: integer?): any
    local p = catalog(ctx)
    local site = need(p.callByNode[node], "pcall lacks checked callsite")
    need(site.protected and site.owner == ctx.fn.id, "pcall callsite belongs to another owner")
    local exprs = node.args.exprs or {}
    need(#exprs >= 1, "pcall takes a function")
    local contract = graph.protectedInvokeContract(node)
    local callee = ctx.expression(exprs[1], "tagged")
    if callee == nil then
        return nil
    end
    local held = ctx.hold(callee)
    local handled = graph.coreLibraryCall(node) == "xpcall"
    need(not handled or #exprs >= 2, "xpcall takes a function and a message handler")
    local rest, kinds = {}, {}
    for index = 2, #exprs do
        need(exprs[index].kind ~= "vararg", "pcall cannot spread `...` yet")
        rest[#rest + 1], kinds[#kinds + 1] = exprs[index], "tagged"
    end
    local operands = ctx.operands(rest, kinds)
    local value = ctx.readHeld(held)
    ctx.release(held)
    if operands == nil then
        return nil
    end
    local args = operands
    if handled then
        args = {}
        for index = 2, #operands do
            args[#args + 1] = operands[index]
        end
        args[#args + 1] = operands[1]
    end
    -- A protected call takes errors, but not a closing coroutine's
    -- unwinding, which lands here when this function owns affine values.
    if count then
        return landed(ctx, node, ctx.invokeMany(node, value, args, contract, count))
    end

    return landed(ctx, node, ctx.invoke(node, value, args, contract, keepResult))
end

-- table.sort(t, f): a merge sort the sort step advances until it needs f's
-- answer, which a call of f here gives it. The step leaves the state table
-- {t, f, a, b, answer, ...} asking whether a sorts before b, and answers
-- false once t is sorted.
local function sortWith(ctx: any, node: any): integer
    local p = catalog(ctx)
    local site = need(p.callByNode[node], "table.sort lacks its comparator's callsite")
    need(site.field and site.owner == ctx.fn.id, "comparator callsite belongs to another owner")
    local operands = ctx.operands(node.args.exprs, {"tagged", "tagged"})
    if operands == nil then
        return nil as any
    end
    local state = ctx.hold(ctx.emit(node, "LibCall", {48, operands[1], operands[2]}, "tagged"))
    local contract = graph.callbackInvokeContract(node, 2)
    ctx.loop(
        node,
        function(c: any, n: any): integer
            return c.emit(n, "LibCall", {49, c.readHeld(state)}, "tagged")
        end,
        function(c: any, n: any): nil
            local fields = {}
            for index = 2, 4 do
                local key = c.emit(n, "K", {pool(c, "int64", tostring(index))}, "tagged")
                fields[index] = c.emit(n, "GetIdx", {c.readHeld(state), key}, "tagged")
            end
            if cleanupGraphs[c.g] then
                c.beforeCall(n)
            end
            local answer = landed(c, n, c.invoke(n, fields[2], {fields[3], fields[4]}, contract, true))
            if c.block == nil then
                return
            end
            local key = c.emit(n, "K", {pool(c, "int64", "5")}, "tagged")
            c.emit(n, "SetIdx", {c.readHeld(state), key, answer}, nil)
        end
    )
    ctx.release(state)
    if ctx.block == nil then
        return nil as any
    end

    return ctx.emit(node, "Nil", {}, "tagged") as integer
end

-- A library call `id` with its first argument and the rest in a pack, the
-- count at key 0: string.format with more than three values, table.move
-- with a destination.
-- Whether a value of type `t` may have a metatable: anything but a string,
-- number, Boolean or nil.
local function mayhavemeta(t: any): boolean
    while t and (t.tag == "const" or t.tag == "literal") do
        t = t.tag == "literal" and t.base or t.inner
    end
    if t == nil then
        return true
    end
    local tag = t.tag

    return not (
        tag == "string" or tag == "number" or tag == "int64" or tag == "float64" or tag == "boolean" or tag == "nil"
    )
end

-- The values of `exprs` as one pack, the count at key 0: a `...` or a call
-- giving other than one result last gives them all. With `texts`, each fixed
-- value that may have a metatable is its tostring, its __tostring called.
local function valuespack(ctx: any, node: any, exprs: any, texts: boolean?): integer
    local last = exprs[#exprs]
    local tail = last ~= nil and (last.kind == "vararg" or graph.expandsResults(last))
    local fixed, kinds = {}, {}
    for index, expr in ipairs(exprs) do
        if index < #exprs or not tail then
            fixed[#fixed + 1], kinds[#kinds + 1] = expr, "tagged"
        end
    end
    local operands = {}
    if #fixed > 0 then
        operands = ctx.operands(fixed, kinds)
        if operands == nil then
            return nil as any
        end
    end
    if texts then
        for index, operand in ipairs(operands) do
            if mayhavemeta(fixed[index].inferredType) then
                operands[index] = ctx.emit(node, "LibCall", {1, operand}, "tagged")
            end
        end
    end
    local pack = ctx.emit(node, "NewTable", {}, "tagged")
    for index, operand in ipairs(operands) do
        local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
        ctx.emit(node, "SetIdx", {pack, key, operand}, nil)
    end
    if tail then
        local held = ctx.hold(pack)
        local values = last.kind == "vararg" and ctx.varargPack() or invoke(ctx, last, true, true, nil, true)
        if values == nil or ctx.block == nil then
            ctx.release(held)
            return nil as any
        end
        local start = ctx.emit(node, "K", {pool(ctx, "int64", tostring(#operands + 1))}, "tagged")
        local counted = ctx.emit(node, "K", {pool(ctx, "true", "")}, "tagged")
        ctx.emit(node, "LibCall", {74, ctx.readHeld(held), values, start, counted}, "tagged")
        pack = ctx.readHeld(held)
        ctx.release(held)
    else
        local zero = ctx.emit(node, "K", {pool(ctx, "int64", "0")}, "tagged")
        local count = ctx.emit(node, "K", {pool(ctx, "int64", tostring(#operands))}, "tagged")
        ctx.emit(node, "SetIdx", {pack, zero, count}, nil)
    end

    return pack
end

-- A library call's first argument and the rest of them as one pack.
packedCall = function(ctx: any, node: any, arguments: any, id: integer): integer
    local first = ctx.expression(arguments[1], "tagged")
    if first == nil then
        return nil as any
    end
    local held = ctx.hold(first)
    local rest = {}
    for index = 2, #arguments do
        rest[#rest + 1] = arguments[index]
    end
    local pack = valuespack(ctx, node, rest)
    if pack == nil or ctx.block == nil then
        ctx.release(held)
        return nil as any
    end
    local value = ctx.emit(node, "LibCall", {id, ctx.readHeld(held), pack}, "tagged")
    ctx.release(held)

    return value as integer
end

-- print(...): its values in a pack, written as one line.
-- An ownership intrinsic's `count` values: a transfer's, the value it
-- moves; `partition`'s, its two parts. The ownership is the checker's.
local function ownership(ctx: any, node: any, count: integer): {integer}?
    local operation = node.ownershipIntrinsic
    local args = node.args and node.args.exprs or {}
    -- A `drop` runs its owner's cleanups now; with none it ends its
    -- value's life. Either way it is nil.
    if operation == "drop" then
        if next(node.ownerCleanups or {}) ~= nil then
            need(ctx.dropOwner ~= nil and ctx.dropOwner(node), "drop of an owner this function does not hold")
            if ctx.block == nil then
                return nil
            end
        elseif args[1] and ctx.expression(args[1], "tagged") == nil then
            return nil
        end
        local results = {}
        for index = 1, count do
            results[index] = ctx.emit(node, "Nil", {}, "tagged")
        end
        return results
    end
    local sources = operation == "partition" and {args[2], args[3]} or {operation == "region" and args[2] or args[1]}
    local present, kinds = {}, {}
    for index = 1, math.min(count, #sources) do
        if sources[index] then
            present[#present + 1], kinds[#kinds + 1] = sources[index], "tagged"
        end
    end
    local operands = #present > 0 and ctx.operands(present, kinds) or {}
    if operands == nil then
        return nil
    end
    local results, at = {}, 0
    for index = 1, count do
        if index <= #sources and sources[index] then
            at = at + 1
            results[index] = operands[at]
        else
            results[index] = ctx.emit(node, "Nil", {}, "tagged")
        end
    end

    return results
end

local function printValues(ctx: any, node: any): integer
    local pack = valuespack(ctx, node, node.args.exprs or {}, true)
    if pack == nil then
        return nil as any
    end

    return ctx.emit(node, "LibCall", {55, pack}, "tagged") as integer
end

-- coroutine.resume(co, ...), coroutine.yield(...) and coroutine.running():
-- each answers its results as one pack, and resume and yield take their
-- values as one.
local function coroutinepack(ctx: any, node: any): integer
    local library = graph.coreLibraryCall(node)
    local exprs = node.args.exprs or {}
    if library == "coroutine.running" then
        need(#exprs == 0, "coroutine.running takes no arguments")
        local none = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.emit(node, "LibCall", {80, none}, "tagged") as integer
    elseif library == "coroutine.yield" then
        local pack = valuespack(ctx, node, exprs)
        if pack == nil then
            return nil as any
        end
        -- In a function that owns affine values a closing coroutine's
        -- unwinding lands at its yield, as an error lands at a call.
        if cleanupGraphs[ctx.g] then
            local held = ctx.hold(pack)
            ctx.beforeCall(node)
            pack = ctx.readHeld(held)
            ctx.release(held)
        end
        return landed(ctx, node, ctx.emit(node, "LibCall", {77, pack}, "tagged")) as integer
    elseif library == "coroutine.close" then
        need(#exprs == 1, "coroutine.close takes a coroutine")
        local thread = ctx.expression(exprs[1], "tagged")
        if thread == nil then
            return nil as any
        end
        return ctx.emit(node, "LibCall", {82, thread}, "tagged") as integer
    end
    need(#exprs >= 1, "coroutine.resume takes a coroutine")
    local thread = ctx.expression(exprs[1], "tagged")
    if thread == nil then
        return nil as any
    end
    local held = ctx.hold(thread)
    local rest = {}
    for index = 2, #exprs do
        rest[#rest + 1] = exprs[index]
    end
    local pack = valuespack(ctx, node, rest)
    if pack == nil then
        ctx.release(held)
        return nil as any
    end
    local value = ctx.readHeld(held)
    ctx.release(held)

    return ctx.emit(node, "LibCall", {76, value, pack}, "tagged") as integer
end

-- A library call with several results, as the pack of them: a string
-- library call's or table.unpack's pack form, or a coroutine call.
librarypack = function(ctx: any, node: any): integer?
    local library = graph.coreLibraryCall(node)
    if coroutinepacked[library or ""] then
        return coroutinepack(ctx, node)
    end
    local spec: {integer} = need(stringSpec(library), "string library call")
    local arguments = {}
    if node.kind == "methodCall" then
        arguments[1] = node.obj
    end
    for _, argument in ipairs(node.args.exprs or {}) do
        arguments[#arguments + 1] = argument
    end
    need(#arguments >= spec[2] and #arguments <= spec[3], tostring(library) .. " argument count is not admitted")

    return libraryCall(ctx, node, need(packSpec(library), "library call with one result"), arguments)
end

-- string.gsub(s, p, f [, n]): the gsub step advances to each match and
-- leaves its captures as a pack, f is called with them, and its answer
-- replaces the match. The finished string comes alone or, with `all`, in a
-- pack with the count.
gsubWith = function(ctx: any, node: any, arguments: any, all: boolean): integer
    local p = catalog(ctx)
    local site = need(p.callByNode[node], "gsub lacks its function's callsite")
    need(site.field and site.owner == ctx.fn.id, "gsub callsite belongs to another owner")
    need(#arguments == 3 or #arguments == 4, "gsub takes a subject, pattern, function and an optional count")
    local kinds = {}
    for index = 1, #arguments do
        kinds[index] = "tagged"
    end
    local operands = ctx.operands(arguments, kinds)
    if operands == nil then
        return nil as any
    end
    table.insert(operands, 1, 50)
    local state = ctx.hold(ctx.emit(node, "LibCall", operands, "tagged"))
    local contract = graph.callbackInvokeContract(node, 0, true)
    ctx.loop(
        node,
        function(c: any, n: any): integer
            return c.emit(n, "LibCall", {51, c.readHeld(state)}, "tagged")
        end,
        function(c: any, n: any): nil
            local fnKey = c.emit(n, "K", {pool(c, "int64", "3")}, "tagged")
            local fn = c.emit(n, "GetIdx", {c.readHeld(state), fnKey}, "tagged")
            local packKey = c.emit(n, "K", {pool(c, "int64", "9")}, "tagged")
            local captures = c.emit(n, "GetIdx", {c.readHeld(state), packKey}, "tagged")
            if cleanupGraphs[c.g] then
                c.beforeCall(n)
            end
            local answer = landed(c, n, c.invoke(n, fn, {}, contract, true, captures))
            if c.block == nil then
                return
            end
            local key = c.emit(n, "K", {pool(c, "int64", "10")}, "tagged")
            c.emit(n, "SetIdx", {c.readHeld(state), key, answer}, nil)
        end
    )
    local finished = ctx.readHeld(state)
    ctx.release(state)
    if ctx.block == nil then
        return nil as any
    end

    return ctx.emit(node, "LibCall", {all and 53 or 52, finished}, "tagged") as integer
end

-- A record method call, `c:m(...)`: the method is loaded from the table the
-- record's name holds and called with the receiver first. With `count`, it
-- keeps that many results and answers them as a list.
local function invokeMethod(ctx: any, node: any, keepResult: boolean, count: integer?): any
    local p = catalog(ctx)
    local site = need(p.callByNode[node], "method call lacks checked callsite")
    need(site.method and site.owner == ctx.fn.id, "method callsite belongs to another owner")
    local contract
    if site.dynamic then
        contract = graph.dynamicmethodcontract(node, count)
    else
        local target = need(p.functionsByDefinition[site.definition], "method call lacks its checked method")
        contract = graph.invokeContract(target, node)
    end
    -- A `...` last spreads its whole pack after the other arguments.
    local arguments = node.args.exprs or {}
    local spreads = #arguments > 0 and arguments[#arguments].kind == "vararg"
    local exprs, kinds = {node.obj}, {"tagged"}
    for index, argument in ipairs(arguments) do
        need(argument.kind ~= "vararg" or index == #arguments, "`...` spreads only last")
        if not (spreads and index == #arguments) then
            exprs[#exprs + 1], kinds[#kinds + 1] = argument, "tagged"
        end
    end
    -- The overload the checker selected has a member of its own.
    local member = node.overloadMember or node.name.text
    local value: integer = 0
    local args: any = nil
    if site.dynamic then
        -- The method the receiver answers for its name.
        local receiver = ctx.expression(node.obj, "tagged")
        if receiver == nil then
            return nil
        end
        local heldReceiver = ctx.hold(receiver)
        local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
        local callee = ctx.hold(ctx.emit(node, "GetIdx", {ctx.readHeld(heldReceiver), key}, "tagged"))
        table.remove(exprs, 1)
        table.remove(kinds, 1)
        local rest = ctx.operands(exprs, kinds)
        value = ctx.readHeld(callee)
        ctx.release(callee)
        local first = ctx.readHeld(heldReceiver)
        ctx.release(heldReceiver)
        if rest == nil then
            return nil
        end
        args = {first}
        for _, item in ipairs(rest) do
            args[#args + 1] = item
        end
    elseif site.metatable then
        -- Another module's record: its table is the receiver's metatable.
        local receiver = ctx.expression(node.obj, "tagged")
        if receiver == nil then
            return nil
        end
        local heldReceiver = ctx.hold(receiver)
        local class = ctx.emit(node, "LibCall", {29, ctx.readHeld(heldReceiver)}, "tagged")
        local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
        local callee = ctx.hold(ctx.emit(node, "GetIdx", {class, key}, "tagged"))
        table.remove(exprs, 1)
        table.remove(kinds, 1)
        local rest = ctx.operands(exprs, kinds)
        value = ctx.readHeld(callee)
        ctx.release(callee)
        local first = ctx.readHeld(heldReceiver)
        ctx.release(heldReceiver)
        if rest == nil then
            return nil
        end
        args = {first}
        for _, item in ipairs(rest) do
            args[#args + 1] = item
        end
    else
        local class = ctx.expression({kind = "name", token = site.classToken, site.classToken}, "tagged")
        if class == nil then
            return nil
        end
        local heldClass = ctx.hold(class)
        local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
        local callee = ctx.hold(ctx.emit(node, "GetIdx", {ctx.readHeld(heldClass), key}, "tagged"))
        ctx.release(heldClass)
        args = ctx.operands(exprs, kinds)
        value = ctx.readHeld(callee)
        ctx.release(callee)
        if args == nil then
            return nil
        end
    end
    local pack = spreads and ctx.varargPack() or nil
    -- In a function that owns affine values a method call moves what it
    -- takes, and an error lands at it, as at any call.
    if cleanupGraphs[ctx.g] then
        local held = ctx.hold(value)
        local heldArgs = {}
        for index, arg in ipairs(args) do
            heldArgs[index] = ctx.hold(arg)
        end
        ctx.beforeCall(node)
        value = ctx.readHeld(held)
        ctx.release(held)
        for index, handle in ipairs(heldArgs) do
            args[index] = ctx.readHeld(handle)
            ctx.release(handle)
        end
    end
    if count then
        return landed(ctx, node, ctx.invokeMany(node, value, args, contract, count, pack))
    end

    return landed(ctx, node, ctx.invoke(node, value, args, contract, keepResult, pack))
end

function tagged.call(ctx: any, node: any, expected: string?): integer
    need(expected == nil or expected == "tagged", "call requires tagged destination")
    if node.runtimeLoader == "require" then
        local item = requireSite(ctx, node)
        need(not item.typeOnly, "type-only require cannot produce a runtime value")
        if item.corecalls then
            return ctx.emit(node, "Nil", {}, "tagged")
        end
        return ctx.emit(node, "Require", {pool(ctx, "str", item.module)}, "tagged")
    end

    return invoke(ctx, node, true) as integer
end

function tagged.statementCall(ctx: any, node: any): nil
    if node.runtimeLoader == "require" then
        tagged.call(ctx, node, nil)
    else
        invoke(ctx, node, false)
    end
end

function tagged.erasedPattern(ctx: any, stat: any): nil
    local source = need(stat.patternSource, "pattern lacks checked source")
    local item = requireSite(ctx, source)
    need(item.typeOnly and #stat.pattern > 0, "runtime destructuring is unsupported")
    for _, entry in ipairs(stat.pattern) do
        need(entry.typeOnly ~= nil, "mixed runtime destructuring is unsupported")
    end
end

-- Whether record declaration `stat` declares fields and nested types only.
local function fieldsOnly(stat: any): boolean
    for _, entry in ipairs(stat.entries or {}) do
        if entry.kind ~= "fieldDecl" and entry.kind ~= "typeAlias" then
            return false
        end
    end

    return true
end

function tagged.erasedStatement(ctx: any, stat: any): nil
    -- An interface declares a type only, and has no value.
    if stat.kind == "recordDecl" and stat.declKind == "interface" then
        return
    end
    if stat.kind == "recordDecl" then
        -- A record of fields declares a type only; its values are built where
        -- they are constructed. Methods in its body are stored on the table its
        -- name holds (`recordValue`).
        -- A record's type parameters erase: its instances hold values.
        need(
            stat.declKind == "record",
            "only plain record declarations are admitted: " .. tostring(
                stat.declKind
            ) .. " " .. tostring(stat.name and stat.name.text)
        )
        for _, entry in ipairs(stat.entries or {}) do
            need(
                entry.kind == "fieldDecl" or entry.kind == "inlineMethod" or entry.kind == "constructorDecl"
                -- A metamethod declaration is a contract; the record's table
                -- holds whatever fulfills it.
                or entry.kind == "metamethodDecl"
                -- A nested type declares a type only, and so does a nested
                -- record of fields alone, built where it is constructed.
                or entry.kind == "typeAlias" or entry.kind == "recordDecl" and fieldsOnly(entry),
                "unsupported record entry: " .. tostring(entry.kind) .. " in " .. tostring(stat.name and stat.name.text)
            )
        end
        return
    end
    need(stat.kind == "moduleStmt" or stat.kind == "typeAlias", "unsupported erased statement")
end

local function booleanCondition(t: any): boolean
    while t and (t.tag == "literal" or t.tag == "const" or t.tag == "constrained") do
        t = t.tag == "const" and t.inner or t.base
    end
    if t and t.tag == "union" and #t.members > 0 then
        for _, member in ipairs(t.members) do
            if not booleanCondition(member) then
                return false
            end
        end
        return true
    end

    return t ~= nil and t.tag == "boolean"
end

local function checkStatement(ctx: any, stat: any, version: integer): nil
    if stat.kind == "ifStmt" then
        for _, clause in ipairs(stat.clauses) do
            need(not clause.binding, "binding conditions are unsupported")
            need(version >= 8 or booleanCondition(clause.cond.inferredType), "if condition requires a checked Boolean")
        end
    elseif stat.kind == "whileStmt" and version == 5 then
        need(
            stat.cond.kind == "binop" and stat.cond.op.text == "<" and booleanCondition(stat.cond.inferredType),
            "loop condition requires checked numeric less-than"
        )
    elseif (stat.kind == "whileStmt" or stat.kind == "repeatStmt") and version >= 6 then
        need(version >= 8 or booleanCondition(stat.cond.inferredType), "loop condition requires a checked Boolean")
    end
    local loopControl = stat.kind == "breakStmt" or stat.kind == "continueStmt" or stat.kind == "repeatStmt"
    need(
        (version >= 5 or stat.kind ~= "whileStmt")
        and (version >= 6 or stat.kind ~= "fornumStmt" and not loopControl)
        and (version >= 8 or stat.kind ~= "forinStmt"),
        "control flow is outside lexical construction"
    )
    need(not stat.comptimeFunction and not stat.comptimeTok, "compile-time declarations are unsupported")
end

function tagged.checkStatement(ctx: any, stat: any): nil
    checkStatement(ctx, stat, 2)
end

local function stepSign(ctx: any, stat: any): integer
    if stat.step == nil then
        return 1
    end
    local constant = catalog(ctx).byNode[stat.step]
    -- A dynamic step needs the runtime zero-step error and a runtime
    -- direction; both wait for guest errors.
    need(
        constant and (constant.kind == "int64" or constant.kind == "num"),
        "numeric for step must be a numeric literal"
    )
    local value = need(tonumber(constant.text), "numeric for step literal")
    need(value == value and value ~= 0, "'for' step is zero")

    return value > 0 and 1 or -1
end

-- Lua's integer mode depends on the initial value and the step, never the
-- limit; any other combination runs in floating point. Controls whose
-- subtype is only known at run time are refused until math.type exists.
local function numericFor(ctx: any, stat: any): any
    local sign = stepSign(ctx, stat)
    local startType = stat.start.inferredType
    local integerMode = integerType(startType) and (stat.step == nil or integerType(stat.step.inferredType))
    need(
        integerMode or numberType(startType) and typeKind(startType) == "float64",
        "numeric for needs a statically integer or float initial value"
    )
    -- A limit of no static number type is checked as the loop starts.
    local dynamicLimit = typeKind(stat.stop.inferredType) == "any"
    need(dynamicLimit or numericType(stat.stop.inferredType), "numeric for limit must be a number")
    local nodes = {stat.start, stat.stop}
    if stat.step then
        nodes[3] = stat.step
    end
    local kinds = {}
    for index in ipairs(nodes) do
        kinds[index] = "tagged"
    end
    local values = ctx.operands(nodes, kinds)
    if values == nil then
        return nil
    end
    if dynamicLimit then
        local start = ctx.hold(values[1])
        local step = values[3] and ctx.hold(values[3]) or nil
        values[2] = ctx.emit(stat, "LibCall", {113, values[2]}, "tagged")
        values[1] = ctx.readHeld(start)
        ctx.release(start)
        if step then
            values[3] = ctx.readHeld(step)
            ctx.release(step)
        end
    end
    if stat.step == nil then
        values[3] = ctx.emit(stat, "K", {pool(ctx, "int64", "1")}, "tagged")
    end
    if values[1] <= ctx.g.nparams then
        values[1] = ctx.emit(stat, "Move", {values[1]}, "tagged")
    end

    -- Integer mode compares the counter with the limit exactly. A descending
    -- loop continues while not counter < limit, which also runs on toward the
    -- minimum integer for a NaN limit, as Lua's limit clipping does. A float
    -- loop's guard is "not past the limit", so NaN controls run it once.
    local function compare(c: any, node: any, counter: integer, limit: integer): (integer, boolean)
        if sign > 0 then
            return c.emit(node, "Le", {counter, limit}, "tagged"), false
        elseif integerMode then
            return c.emit(node, "Lt", {counter, limit}, "tagged"), true
        end

        return c.emit(node, "Le", {limit, counter}, "tagged"), false
    end

    return {
        values = values,
        first = function(c: any, node: any, v: any): (integer, boolean)
            if integerMode then
                return compare(c, node, v[1], v[2])
            end
            return c.emit(node, "Lt", sign > 0 and {v[2], v[1]} or {v[1], v[2]}, "tagged"), true
        end,
        test = function(c: any, node: any, v: any): (integer, boolean)
            return compare(c, node, v[1], v[2])
        end,
        advance = function(c: any, node: any, v: any): (integer, integer?)
            local advanced = c.emit(node, "Add", {v[1], v[3]}, "tagged")
            if not integerMode then
                return advanced, nil
            end
            -- Integer counters wrap at 64 bits; a wrapped sum ends the loop.
            local wrapped = c.emit(node, "Lt", sign > 0 and {advanced, v[1]} or {v[1], advanced}, "tagged")

            return advanced, wrapped
        end
    }
end

-- A true constant, for the cleanup protocol's conditions: a guest error
-- unwinds in the runtime, so no call or terminal reports failure here.

local function always(ctx: any, node: any): integer
    return ctx.emit(node, "K", {pool(ctx, "true", "")}, "tagged") as integer
end

-- The profile a function that owns affine values is built with: the
-- common cleanup protocol (functiongraph), its terminals called through
-- Destroy, which reaches each destructor through the table its record's name
-- holds. Returns stage at most one value.
local function cleanupProfile(base: any): any
    local profile = {}
    for name, member in pairs(base) do
        profile[name] = member
    end
    profile.forOwner = nil
    profile.initialize = function(owner: any, options: any): any
        local g = base.initialize(owner, options)
        cleanupGraphs[g] = true
        return g
    end
    profile.initializeModule = function(owner: any, options: any): any
        local g = base.initializeModule(owner, options)
        cleanupGraphs[g] = true
        return g
    end
    profile.cleanupFlag = function(ctx: any, node: any, value: boolean): integer
        return ctx.emit(node, "K", {pool(ctx, value and "true" or "false", "")}, "tagged") as integer
    end
    profile.cleanupPlan = function(ctx: any, site: any, t: any, chain: any): any
        local inner = t and t.tag == "affine" and t.inner
        local origin = inner and (inner.origin or inner)
        local declaration = origin and origin.deriveDeclaration
        local tokens = catalog(ctx).cleanupTokens[site]
        -- A method cleanup (`close`) is looked up on the value as it is
        -- destroyed, whatever implements it.
        local dynamic = false
        for _, item in ipairs(chain) do
            dynamic = dynamic or item.kind == "method"
        end
        if dynamic then
            local names = {}
            for _, item in ipairs(chain) do
                need(item.kind == "method", "a method cleanup chain mixes in a function")
                names[#names + 1] = item.name
            end
            return {names = names}
        end
        -- Cleanups that are not the record's own methods are functions read
        -- from the core's registry by key.
        local methods = declaration ~= nil and declaration.kind == "recordDecl" and declaration.name ~= nil
        for _, item in ipairs(chain) do
            local record = tostring(item.name):match("^(.-)%.[%w_]+$")
            methods = methods and record == declaration.name.text
        end
        if not methods then
            local keys = {}
            for _, item in ipairs(chain) do
                keys[#keys + 1] = need(item.key, "a cleanup function lacks its key")
            end
            return {keys = keys}
        end
        local token = need(tokens and declaration and tokens[declaration], "cleanup site lacks its record reference")
        local methods = {}
        for _, item in ipairs(chain) do
            local record, method = tostring(item.name):match("^(.-)%.([%w_]+)$")
            need(method and record == declaration.name.text, "only a record's own method cleans it up")
            methods[#methods + 1] = method
        end

        return {token = token, methods = methods}
    end
    profile.cleanupAllowed = always
    profile.cleanupStatus = always
    profile.cleanupRun = function(ctx: any, node: any, plan: any, value: integer, reason: string): nil
        local held = ctx.hold(value)
        if plan.names then
            for index = #plan.names, 1, -1 do
                local key = ctx.emit(node, "K", {pool(ctx, "str", plan.names[index])}, "tagged")
                local callee = ctx.emit(node, "GetIdx", {ctx.readHeld(held), key}, "tagged")
                ctx.emit(node, "Destroy", {callee, ctx.readHeld(held)}, nil)
            end
            ctx.release(held)
            return
        end
        if plan.keys then
            for index = #plan.keys, 1, -1 do
                local key = ctx.emit(node, "K", {pool(ctx, "str", plan.keys[index])}, "tagged")
                local callee = ctx.emit(node, "LibCall", {105, key}, "tagged")
                ctx.emit(node, "Destroy", {callee, ctx.readHeld(held)}, nil)
            end
            ctx.release(held)
            return
        end
        for index = #plan.methods, 1, -1 do
            local class = plan.token.foreign and ctx.emit(node, "LibCall", {29, ctx.readHeld(held)}, "tagged")
                or ctx.expression({kind = "name", token = plan.token, plan.token}, "tagged")
            local key = ctx.emit(node, "K", {pool(ctx, "str", plan.methods[index])}, "tagged")
            local callee = ctx.emit(node, "GetIdx", {class, key}, "tagged")
            ctx.emit(node, "Destroy", {callee, ctx.readHeld(held)}, nil)
        end
        ctx.release(held)
    end
    -- Unreachable while every status is true; a failure still has to end its
    -- block, so it raises.
    -- The landed error goes on, as it was, once the owners are destroyed.
    profile.failure = function(ctx: any, node: any): nil
        local none = ctx.emit(node, "Nil", {}, "tagged")
        ctx.emit(node, "LibCall", {46, none}, "tagged")
        ctx.block.term = {kind = "return", value = none, edges = {}, pos = ctx.position(node)}
        ctx.block = nil
    end
    -- Every value a return gives, staged before the owners are destroyed: a
    -- `...`, an open call or a call last giving more than one spread, the
    -- pack staged last.
    profile.stageReturn = function(ctx: any, node: any, falling: boolean): any
        -- A module with named exports answers its export table.
        if falling and ctx.exports then
            return {values = {ctx.readHeld(ctx.exports)}}
        end
        local exprs = not falling and node.exprs or {}
        if #exprs == 0 then
            return {values = {}}
        end
        local last = exprs[#exprs]
        local declared: integer = ctx.fn.signature and #ctx.fn.signature.rets or 1
        local open = ctx.fn.signature and ctx.fn.signature.retPack and ctx.fn.signature.retPack.tail ~= nil
        local spreads = last.kind == "vararg" or open and graph.expandsResults(last)
        local expands = not spreads and declared > #exprs and graph.expandsResults(last)
        local fixed, kinds = {}, {}
        for index, expr in ipairs(exprs) do
            if index < #exprs or not spreads and not expands then
                fixed[#fixed + 1], kinds[#kinds + 1] = expr, "tagged"
            end
        end
        need(#fixed <= 16, "a return gives at most sixteen results")
        local values = {}
        if #fixed > 0 then
            values = ctx.operands(fixed, kinds)
            if values == nil then
                return nil
            end
        end
        if spreads or expands then
            local held = {}
            for index, value in ipairs(values) do
                held[index] = ctx.hold(value)
            end
            local tail: any = nil
            if last.kind == "vararg" then
                tail = ctx.varargPack()
            elseif spreads then
                tail = invoke(ctx, last, true, true, nil, true)
            else
                tail = base.callResults(ctx, last, declared - #exprs + 1)
            end
            for index, handle in ipairs(held) do
                values[index] = ctx.readHeld(handle)
                ctx.release(handle)
            end
            if tail == nil or ctx.block == nil then
                return nil
            end
            if spreads then
                values[#values + 1] = tail
                need(#values <= 17, "a return gives at most sixteen results")
                return {values = values, spread = true}
            end
            for _, value in ipairs(tail) do
                values[#values + 1] = value
            end
            need(#values <= 16, "a return gives at most sixteen results")
        end

        return {values = values}
    end
    profile.rootReturn = function(ctx: any, node: any, stage: any, held: any): any
        return {}
    end
    profile.rootBacking = function(ctx: any, node: any, roots: any): {any}
        return {}
    end
    profile.closeReturnRoots = function(ctx: any, node: any, plan: any, reason: string): integer
        return always(ctx, node)
    end
    profile.retainRootBacking = function(ctx: any, node: any, plan: any): nil
    end
    profile.finishReturn = function(ctx: any, node: any, stage: any, values: any, roots: any): nil
        if stage.spread then
            -- The pack staged last spreads after the fixed values.
            local pack = values[#values]
            local fixed = {}
            for index = 1, #values - 1 do
                fixed[index] = values[index]
            end
            ctx.block.term = {
                kind = "return",
                value = fixed[1] or pack,
                values = #fixed > 0 and fixed or nil,
                spread = pack,
                edges = {},
                pos = ctx.position(node)
            }
        elseif #values > 1 then
            ctx.block.term = {kind = "return", value = values[1], values = values, edges = {}, pos = ctx.position(node)}
        else
            local value = values[1] or ctx.emit(node, "Nil", {}, "tagged")
            ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(node)}
        end
        ctx.block = nil
    end

    return profile
end

-- A profile for one checked-source graph version (see coregraphschema).
function tagged.forVersion(version: integer): any
    local profile = {}
    for name, member in pairs(tagged) do
        profile[name] = member
    end
    profile.checkStatement = function(ctx: any, stat: any): nil
        checkStatement(ctx, stat, version)
    end
    -- `local {a, b as c} = source`: the source once, then each value
    -- entry's field in order; a `type` entry's place is nil. A source that
    -- selects only types is erased.
    profile.patternvalues = function(ctx: any, stat: any): {any}?
        local runtime = false
        for _, entry in ipairs(stat.pattern) do
            if not entry.typeOnly then
                runtime = true
            end
        end
        if not runtime then
            tagged.erasedPattern(ctx, stat)
            return {}
        end
        local source = ctx.expression(need(stat.patternSource, "pattern lacks checked source"), "tagged")
        if source == nil then
            return nil
        end
        local values: {any} = {}
        for index, entry in ipairs(stat.pattern) do
            if not entry.typeOnly then
                local field = ctx.emit(stat, "K", {pool(ctx, "str", entry.sourceName.text)}, "tagged")
                values[index] = ctx.emit(stat, "GetIdx", {source, field}, "tagged")
            end
        end

        return values
    end
    -- A module with named exports: its export table, published as the
    -- module's value before its body runs.
    -- The modules a chunk's qualified paths name load as it starts, before
    -- its own exports are made, as one hidden require each.
    -- Whether `value` is nil, a branch's condition (`a ?? b`).
    profile.isNil = function(ctx: any, node: any, value: integer): integer
        local none = ctx.emit(node, "Nil", {}, "tagged")
        return ctx.emit(node, "Eq", {value, none}, "tagged") as integer
    end
    profile.qualifiedLoads = function(ctx: any, node: any): nil
        -- A program that requires a computed name has its entry register the
        -- image's modules by name before anything runs.
        local p = catalog(ctx)
        local entry = p.modules[#p.modules]
        if p.dynamicRequires and entry and entry.chunk == ctx.fn.id then
            local names = ctx.hold(ctx.emit(node, "NewTable", {}, "tagged"))
            for _, module in ipairs(p.modules) do
                local key = ctx.emit(node, "K", {pool(ctx, "str", module.name)}, "tagged")
                local chunk = ctx.emit(node, "K", {pool(ctx, "int64", tostring(module.chunk))}, "tagged")
                ctx.emit(node, "SetIdx", {ctx.readHeld(names), key, chunk}, nil)
            end
            ctx.emit(node, "LibCall", {86, ctx.readHeld(names)}, "tagged")
            ctx.release(names)
        end
        for _, site in ipairs(catalog(ctx).qualifiedLoads[ctx.fn.id] or {}) do
            ctx.emit(site.node, "Require", {pool(ctx, "str", site.module)}, "tagged")
        end
    end
    profile.moduleExports = function(ctx: any, node: any): integer
        local exports = ctx.emit(node, "NewTable", {}, "tagged")
        return ctx.emit(node, "LibCall", {84, exports}, "tagged") as integer
    end
    -- After a named export's statement: each name it declared, stored in the
    -- export table under that name.
    profile.exportNames = function(ctx: any, stat: any): nil
        local inner = stat.stat
        local names: {any} = {}
        if inner.kind == "localFuncStmt" or inner.kind == "recordDecl" then
            names = {inner.name}
        elseif inner.kind == "localStmt" then
            names = inner.names
        elseif inner.kind == "funcStmt" then
            need(inner.name and inner.name.base and #(inner.name.parts or {}) <= 1, "an exported function is named")
            names = {inner.name.base}
        end
        for _, name in ipairs(names) do
            local key = name.definition or name
            local value = ctx.readname(stat, key)
            if value ~= nil then
                local text = need(name.text or name.token and name.token.text, "an exported name has its text")
                local field = ctx.emit(stat, "K", {pool(ctx, "str", text)}, "tagged")
                ctx.emit(stat, "SetIdx", {ctx.readHeld(ctx.exports), field, value}, nil)
            end
        end
    end
    -- `@unsafe` before a statement: the checker trusted what it says, a yield
    -- with affine values live; the statement runs as it would without it.
    -- `@aot` asks for ahead-of-time code, which the core has no backend
    -- for, and `@allow` quiets a lint: either way the statement runs as
    -- written.
    local pragmas: {[string]: boolean} = {unsafe = true, aot = true, allow = true}
    profile.checkedPragma = function(ctx: any, node: any): nil
        local name = node.name and node.name.text
        need(
            pragmas[name or ""] == true and node.annotationDefinition and node.annotationDefinition.name == name,
            "only a checked @unsafe, @aot or @allow scope is admitted, not @" .. tostring(name)
        )
    end
    profile.binary = function(ctx: any, node: any, expected: string?): integer
        return binary(ctx, node, expected, version)
    end
    if version >= 6 then
        profile.numericFor = function(ctx: any, stat: any, expected: any): any
            return numericFor(ctx, stat)
        end
    end
    -- v8 tables: empty constructors, keyed reads and writes, and length.
    if version >= 8 then
        profile.tableConstructor = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "table requires tagged destination")
            -- `{...}` copies the pack; a positional `...` or call giving other
            -- than one result last among the entries gives them all, appended.
            if #node.fields == 1 and node.fields[1].kind == "fieldItem" and node.fields[1].value.kind == "vararg" then
                return ctx.emit(node, "LibCall", {21, ctx.varargPack()}, "tagged") as integer
            end
            local tail = node.fields[#node.fields]
            local appends = tail ~= nil
                and tail.kind == "fieldItem"
                and (tail.value.kind == "vararg" or graph.expandsResults(tail.value))
            for index, field in ipairs(node.fields) do
                need(
                    field.value == nil or field.value.kind ~= "vararg" or appends and index == #node.fields,
                    "`...` among other table entries"
                )
            end
            -- Entries are evaluated in order, keys before their values, then
            -- stored: positional ones at 1, 2, ..., named ones at their string.
            local nodes, kinds, keys = {}, {}, {}
            local position = 0
            for index, field in ipairs(node.fields) do
                if appends and index == #node.fields then
                    break
                end
                if field.kind == "fieldItem" then
                    position += 1
                    keys[#keys + 1] = {kind = "int64", text = tostring(position)}
                elseif field.kind == "fieldNamed" then
                    keys[#keys + 1] = {kind = "str", text = need(field.name, "named field lacks a name").text}
                elseif field.kind == "fieldBracket" then
                    nodes[#nodes + 1], kinds[#kinds + 1] = field.key, "tagged"
                    keys[#keys + 1] = {kind = "value", at = #nodes}
                else
                    error("tagged graph: unsupported table constructor entry", 0)
                end
                nodes[#nodes + 1], kinds[#kinds + 1] = field.value, "tagged"
                keys[#keys].valueAt = #nodes
            end
            local values = {}
            if #nodes > 0 then
                values = ctx.operands(nodes, kinds)
                if values == nil then
                    return nil as any
                end
            end
            local result = ctx.emit(node, "NewTable", {}, "tagged")
            for _, key in ipairs(keys) do
                local k = key.at and values[key.at] or ctx.emit(node, "K", {pool(ctx, key.kind, key.text)}, "tagged")
                ctx.emit(node, "SetIdx", {result, k, values[key.valueAt]}, nil)
            end
            if appends then
                -- The tail's values go at the next positions, from its pack.
                local held = ctx.hold(result)
                local pack = tail.value.kind == "vararg" and ctx.varargPack()
                    or invoke(ctx, tail.value, true, true, nil, true)
                if pack == nil or ctx.block == nil then
                    ctx.release(held)
                    return nil as any
                end
                local start = ctx.emit(node, "K", {pool(ctx, "int64", tostring(position + 1))}, "tagged")
                ctx.emit(node, "LibCall", {74, ctx.readHeld(held), pack, start}, "tagged")
                result = ctx.readHeld(held)
                ctx.release(held)
            end

            return result as integer
        end
        profile.indexRead = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "index requires tagged destination")
            local operands = ctx.operands({node.obj, node.expr}, {"tagged", "tagged"})
            if operands == nil then
                return nil as any
            end

            return ctx.emit(node, "GetIdx", operands, "tagged") as integer
        end
        -- Records lower onto core tables for now: field i of the declaration
        -- order is key i. Records are identity objects, so this is exact; a
        -- dedicated record layout is a later optimization.
        profile.construction = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "record requires tagged destination")
            local origin = recordOrigin(node.inferredType)
            local call = node.call
            if origin and call and call.constructorEntry then
                return construct(ctx, node, origin) as integer
            end
            need(
                origin and call and not call.constructorEntry and type(call.recordFields) == "table",
                "only plain record construction is admitted"
            )
            -- Written fields are expressions; a default is its closed value.
            local nodes, kinds, slots, defaults = {}, {}, {}, {}
            for _, binding in ipairs(call.recordFields) do
                if binding.node then
                    nodes[#nodes + 1], kinds[#kinds + 1] = binding.node, "tagged"
                    slots[#slots + 1] = need(recordSlot(origin, binding.name), "record field is not declared")
                else
                    need(binding.isDefault, "record initializer is missing")
                    defaults[#defaults + 1] = binding
                end
            end
            local values = ctx.operands(nodes, kinds)
            if values == nil then
                return nil as any
            end
            for _, binding in ipairs(defaults) do
                values[#values + 1] = defaultConstant(ctx, node, binding.defaultValue)
                slots[#slots + 1] = need(recordSlot(origin, binding.name), "record field is not declared")
            end
            local record = ctx.emit(node, "NewTable", {}, "tagged")
            for index, value in ipairs(values) do
                local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(slots[index]))}, "tagged")
                ctx.emit(node, "SetIdx", {record, key, value}, nil)
            end
            -- The record's table is the instance's metatable.
            local held = ctx.hold(record)
            local class = ctx.expression(call.obj, "tagged")
            if class == nil then
                ctx.release(held)
                return nil as any
            end
            ctx.emit(node, "LibCall", {28, ctx.readHeld(held), class}, "tagged")
            record = ctx.readHeld(held)
            ctx.release(held)

            return record as integer
        end
        profile.fieldRead = function(ctx: any, node: any, expected: string?): integer
            -- A declared module's qualified path: the module, as a require
            -- answers it, then the members the path names in it.
            local library = libraryValue(ctx, node)
            if library ~= nil then
                return library
            end
            local site = catalog(ctx).requireByNode[node]
            if site and site.qualified then
                need(site.owner == ctx.fn.id, "foreign qualified path")
                local value = ctx.emit(node, "Require", {pool(ctx, "str", site.module)}, "tagged")
                for _, member in ipairs(node.qualifiedMembers or {}) do
                    local key = ctx.emit(node, "K", {pool(ctx, "str", member)}, "tagged")
                    value = ctx.emit(node, "GetIdx", {value, key}, "tagged")
                end
                return value as integer
            end
            -- math.huge, math.pi, math.maxinteger and math.mininteger fold.
            local libraryField = graph.coreLibraryField(node)
            if libraryField == "math.huge" or libraryField == "math.pi" then
                local number = libraryField == "math.pi" and math.pi or math.huge
                return ctx.emit(node, "K", {pool(ctx, "num", graphimage.floatBytes(number))}, "tagged") as integer
            elseif libraryField == "math.maxinteger" then
                return ctx.emit(node, "K", {pool(ctx, "int64", "9223372036854775807")}, "tagged") as integer
            elseif libraryField == "math.mininteger" then
                return ctx.emit(node, "K", {pool(ctx, "int64", "-9223372036854775808")}, "tagged") as integer
            end
            local slot = fieldSlot(ctx, node.obj.inferredType, node.name and node.name.text)
            -- A field of a plain table is its string key, and so is one of a
            -- record's name (`R.f`), which holds the table of its methods.
            local tag = typeKind(node.obj.inferredType)
            local plain = slot == nil
                and (
                    tag == "table"
                    or tag == "map"
                    or tag == "array"
                    or tag == "shape"
                    or tag == "typeobject"
                    or tag == "any"
                    or tag == "typevar"
                    or interfacetype(node.obj.inferredType)
                    or recordOrigin(node.obj.inferredType) ~= nil
                )
                and node.name ~= nil
            if slot == nil and not plain then
                return tagged.constant(ctx, node, expected)
            end
            local object = ctx.expression(node.obj, "tagged")
            if object == nil then
                return nil as any
            end
            local key = plain and ctx.emit(node, "K", {pool(ctx, "str", node.name.text)}, "tagged")
                or ctx.emit(node, "K", {pool(ctx, "int64", tostring(slot))}, "tagged")

            return ctx.emit(node, "GetIdx", {object, key}, "tagged") as integer
        end
        profile.assignmentTarget = function(ctx: any, node: any, rhs: any): any
            if node.kind == "dotIndex" then
                local slot = fieldSlot(ctx, node.obj.inferredType, node.name and node.name.text)
                local tag = typeKind(node.obj.inferredType)
                -- `R.f = ...` writes the table a record's name holds.
                local plain = slot == nil
                    and (
                        tag == "table"
                        or tag == "map"
                        or tag == "array"
                        or tag == "shape"
                        or tag == "typeobject"
                        or tag == "any"
                        or tag == "typevar"
                        or interfacetype(node.obj.inferredType)
                        or recordOrigin(node.obj.inferredType) ~= nil
                    )
                    and node.name ~= nil
                need(slot ~= nil or plain, "only record and table field assignment is admitted")
                local object = ctx.expression(node.obj, "tagged")
                if object == nil then
                    return {receiver = 0, kind = "tagged"}
                end
                local held = ctx.hold(object)
                local key = plain and ctx.emit(node, "K", {pool(ctx, "str", node.name.text)}, "tagged")
                    or ctx.emit(node, "K", {pool(ctx, "int64", tostring(slot))}, "tagged")
                object = ctx.readHeld(held)
                ctx.release(held)
                return {receiver = object, index = key, kind = "tagged"}
            end
            need(node.kind == "bracketIndex", "only keyed assignment targets are admitted")
            local operands = ctx.operands({node.obj, node.expr}, {"tagged", "tagged"})
            if operands == nil then
                return {receiver = 0, kind = "tagged"}
            end

            return {receiver = operands[1], index = operands[2], kind = "tagged"}
        end
        profile.assignTarget = function(ctx: any, node: any, target: any, receiver: integer, value: integer): nil
            ctx.emit(node, "SetIdx", {receiver, ctx.readHeld(target.heldIndex), value}, nil)
        end

        -- A loop over a state table advanced by library step `id`, which
        -- answers whether it continues and leaves the bound names from key
        -- `offset + 1` on.
        local function stepped(stat: any, state: integer, id: integer, offset: integer): any
            local function step(c: any, node: any, v: any): (integer, boolean)
                return c.emit(node, "LibCall", {id, v[1]}, "tagged"), false
            end

            return {
                values = {state},
                first = step,
                test = step,
                advance = function(c: any, node: any, v: any): (integer, integer?)
                    return v[1], nil
                end,
                bind = function(c: any, node: any, v: any): any
                    local bound = {}
                    for index = 1, #stat.names do
                        local key = c.emit(node, "K", {pool(c, "int64", tostring(offset + index))}, "tagged")
                        bound[index] = c.emit(node, "GetIdx", {v[1], key}, "tagged")
                    end

                    return bound
                end
            }
        end

        -- `for i, v in ipairs(t)`: i counts from 1 while t[i] is not nil. The
        -- element is read for the test and again for the body, which only a
        -- metatable could tell apart; the core has none yet.
        profile.genericFor = function(ctx: any, stat: any): any
            local source = stat.exprs[1]
            -- `for a, b in s:gmatch(p)`: a state table {s, p, src, last}
            -- advanced by the gmatch step, which leaves the match from key 5.
            if #stat.exprs == 1 and graph.coreLibraryCall(source) == "string.gmatch" then
                need(#(source.args.exprs or {}) == 1 and #stat.names <= 4, "gmatch takes one pattern")
                local operands = ctx.operands({source.obj, source.args.exprs[1]}, {"tagged", "tagged"})
                if operands == nil then
                    return nil
                end
                local held = {ctx.hold(operands[1]), ctx.hold(operands[2])}
                local state = ctx.emit(stat, "NewTable", {}, "tagged")
                for index, handle in ipairs(held) do
                    local key = ctx.emit(stat, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
                    ctx.emit(stat, "SetIdx", {state, key, ctx.readHeld(handle)}, nil)
                    ctx.release(handle)
                end
                local srcKey = ctx.emit(stat, "K", {pool(ctx, "int64", "3")}, "tagged")
                local zero = ctx.emit(stat, "K", {pool(ctx, "int64", "0")}, "tagged")
                ctx.emit(stat, "SetIdx", {state, srcKey, zero}, nil)

                return stepped(stat, state, 4, 4)
            end
            -- `for k, v in pairs(t)`: a state table {t, key, k, v} the next
            -- step advances, leaving the pair at keys 3 and 4.
            if #stat.exprs == 1 and source.kind == "call" and source.resolvedGlobal == "pairs" then
                need(#(source.args.exprs or {}) == 1 and #stat.names <= 2, "pairs takes one table")
                local t = ctx.expression(source.args.exprs[1], "tagged")
                if t == nil then
                    return nil
                end
                local held = ctx.hold(t)
                local state = ctx.emit(stat, "NewTable", {}, "tagged")
                local subjectKey = ctx.emit(stat, "K", {pool(ctx, "int64", "1")}, "tagged")
                ctx.emit(stat, "SetIdx", {state, subjectKey, ctx.readHeld(held)}, nil)
                ctx.release(held)

                return stepped(stat, state, 8, 2)
            end
            -- `for names in f, s, c`: f(s, c) each step, as Lua runs any
            -- iterator, a wrapped coroutine's included; the loop leaves at a
            -- nil first result.
            if graph.genericiterator(stat) then
                need(#stat.names >= 1 and #stat.names <= 16, "a generic for names one to sixteen values")
                local values: any = nil
                if #stat.exprs == 1 and graph.expandsResults(source) then
                    values = profile.callResults(ctx, source, 3)
                else
                    need(#stat.exprs <= 3, "a generic for takes at most three values")
                    local kinds = {}
                    for index = 1, #stat.exprs do
                        kinds[index] = "tagged"
                    end
                    values = ctx.operands(stat.exprs, kinds)
                end
                if values == nil then
                    return nil
                end
                local controls = {}
                for index = 1, 3 do
                    controls[index] = values[index] or ctx.emit(stat, "Nil", {}, "tagged")
                end

                return {
                    values = controls,
                    iterate = function(c: any, node: any, v: any): {integer}?
                        local contract = graph.iteratorcontract(stat, #stat.names)
                        return landed(c, node, c.invokeMany(node, v[1], {v[2], v[3]}, contract, #stat.names))
                    end,
                    ended = function(c: any, node: any, first: integer): integer
                        local none = c.emit(node, "Nil", {}, "tagged")
                        return c.emit(node, "Eq", {first, none}, "tagged")
                    end,
                    none = function(c: any, node: any): integer
                        return c.emit(node, "Nil", {}, "tagged")
                    end
                }
            end
            need(
                #stat.exprs == 1
                and source.kind == "call"
                and source.resolvedGlobal == "ipairs"
                and #(source.args.exprs or {}) == 1
                and #stat.names >= 1
                and #stat.names <= 2,
                "only `for i, v in ipairs(t)` is admitted"
            )
            local t = ctx.expression(source.args.exprs[1], "tagged")
            if t == nil then
                return nil
            end
            local held = ctx.hold(t)
            local first = ctx.emit(stat, "K", {pool(ctx, "int64", "1")}, "tagged")
            t = ctx.readHeld(held)
            ctx.release(held)

            local function present(c: any, node: any, v: any): (integer, boolean)
                local element = c.emit(node, "GetIdx", {v[2], v[1]}, "tagged")
                local none = c.emit(node, "Nil", {}, "tagged")
                return c.emit(node, "Eq", {element, none}, "tagged"), true
            end

            return {
                values = {first, t},
                first = present,
                test = present,
                advance = function(c: any, node: any, v: any): (integer, integer?)
                    local one = c.emit(node, "K", {pool(c, "int64", "1")}, "tagged")
                    return c.emit(node, "Add", {v[1], one}, "tagged"), nil
                end,
                bind = function(c: any, node: any, v: any): any
                    return {v[1], c.emit(node, "GetIdx", {v[2], v[1]}, "tagged")}
                end
            }
        end
        -- `a or b` and `a and b` branch on Lua truthiness.
        profile.checkLogical = function(ctx: any, node: any): boolean
            return true
        end
        profile.kind = function(t: any): string
            return "tagged"
        end
        -- `e as T` is a static cast: the value is the operand's.
        profile.cast = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "cast requires tagged destination")
            return ctx.expression(node.expr, "tagged") as integer
        end
        -- `...` in a single-value context: the pack's first value.
        profile.vararg = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "`...` requires tagged destination")
            local key = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
            return ctx.emit(node, "GetIdx", {ctx.varargPack(), key}, "tagged") as integer
        end
        -- `function T.f(...)` and `function T:m(...)`: the closure stored into the
        -- table T names, as Lua does. One level of name only.
        -- The table a record's methods are stored in, when its name is bound.
        -- A call through anything but a name has no declaration to compose
        -- with: it calls the value it evaluates when it runs.
        profile.resolveCallee = function(_: any, call: any): (boolean, any)
            if call.obj.kind ~= "name" then
                return true, nil
            end
            return false, nil
        end
        -- The table a record's name holds, with every method its body
        -- declares stored by name, as `function R:m` stores one. It is its
        -- instances' metatable, its own __index, so metamethods written on it
        -- apply to them.
        profile.recordValue = function(ctx: any, stat: any): integer?
            if catalog(ctx).byDefinition[stat.name.definition] == nil then
                return nil
            end
            local held = ctx.hold(ctx.emit(stat, "NewTable", {}, "tagged"))
            local indexKey = ctx.emit(stat, "K", {pool(ctx, "str", "__index")}, "tagged")
            ctx.emit(stat, "SetIdx", {ctx.readHeld(held), indexKey, ctx.readHeld(held)}, nil)
            -- Its field names, each to its slot, under a key no field name
            -- can be: a read or write of an instance by name, where no type
            -- gave the slot, finds the field there.
            -- An interface's instances are its implementers': no slots.
            local order = stat.declKind ~= "interface" and stat.resolvedType and stat.resolvedType.fieldOrder or {}
            if #order > 0 then
                local fields = ctx.hold(ctx.emit(stat, "NewTable", {}, "tagged"))
                for slot, field in ipairs(order) do
                    local name = ctx.emit(stat, "K", {pool(ctx, "str", field)}, "tagged")
                    local at = ctx.emit(stat, "K", {pool(ctx, "int64", tostring(slot))}, "tagged")
                    ctx.emit(stat, "SetIdx", {ctx.readHeld(fields), name, at}, nil)
                end
                local fieldsKey = ctx.emit(stat, "K", {pool(ctx, "str", "\0fields")}, "tagged")
                ctx.emit(stat, "SetIdx", {ctx.readHeld(held), fieldsKey, ctx.readHeld(fields)}, nil)
                ctx.release(fields)
            end
            -- A default it takes from an interface is read from that
            -- interface's table, under the member it has here.
            for _, taken in ipairs(stat.inheritedDefaultNames or {}) do
                local tokens = catalog(ctx).inheritTokens[stat] or {}
                local token = need(
                    tokens[taken.from],
                    "an inherited default from an interface not in the program: " .. tostring(taken.from)
                )
                local parent: integer? = nil
                if token.qualifiedModule then
                    local site = need(catalog(ctx).requireByNode[token], "inherited default lacks its require")
                    local loaded = ctx.emit(stat, "Require", {pool(ctx, "str", site.module)}, "tagged")
                    local name = ctx.emit(stat, "K", {pool(ctx, "str", token.inheritFrom)}, "tagged")
                    parent = ctx.emit(stat, "GetIdx", {loaded, name}, "tagged")
                else
                    parent = ctx.expression({kind = "name", token = token, token}, "tagged")
                end
                if parent == nil then
                    ctx.release(held)
                    return nil
                end
                local fromKey = ctx.emit(stat, "K", {pool(ctx, "str", taken.fromMember or taken.name)}, "tagged")
                local method = ctx.emit(stat, "GetIdx", {parent, fromKey}, "tagged")
                local memberKey = ctx.emit(stat, "K", {pool(ctx, "str", taken.member or taken.name)}, "tagged")
                ctx.emit(stat, "SetIdx", {ctx.readHeld(held), memberKey, method}, nil)
            end
            for _, entry in ipairs(stat.entries or {}) do
                -- A constructor is stored under a key no field name can be;
                -- each body of an overloaded method under its own member.
                local name = entry.kind == "inlineMethod" and (entry.overloadMember or entry.name.text)
                    or entry.kind == "constructorDecl" and "\0new" .. tostring(entry.constructorIndex)
                    or nil
                if name then
                    local closure = ctx.hold(tagged.closure(ctx, entry))
                    local key = ctx.emit(entry, "K", {pool(ctx, "str", name)}, "tagged")
                    ctx.emit(entry, "SetIdx", {ctx.readHeld(held), key, ctx.readHeld(closure)}, nil)
                    ctx.release(closure)
                end
            end
            local value = ctx.readHeld(held)
            ctx.release(held)

            return value as integer
        end
        -- `text ${value} text`: each literal piece as written and each value
        -- through tostring, joined left to right.
        profile.interpolation = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "interpolation requires tagged destination")
            local held: any = nil

            local function join(value: integer): nil
                if held == nil then
                    held = ctx.hold(value)
                    return
                end
                local joined = ctx.emit(node, "LibCall", {5, ctx.readHeld(held), value}, "tagged")
                ctx.release(held)
                held = ctx.hold(joined)
            end

            for _, child in ipairs(node) do
                local piece = nil
                if child.kind == "istringOpen" or child.kind == "istringMid" then
                    piece = child.text:sub(2, -3)
                elseif child.kind == "istringClose" then
                    piece = child.text:sub(2, -2)
                end
                if piece ~= nil then
                    if #piece > 0 then
                        local text = need(lexer.stringValue("`" .. piece .. "`"), "interpolated text")
                        join(ctx.emit(child, "K", {pool(ctx, "str", text)}, "tagged") as integer)
                    end
                elseif type(child) == "table" and child.kind then
                    local value = ctx.expression(child, "tagged")
                    if value == nil then
                        if held then
                            ctx.release(held)
                        end
                        return nil as any
                    end
                    join(ctx.emit(child, "LibCall", {1, value}, "tagged") as integer)
                end
            end
            if held == nil then
                return ctx.emit(node, "K", {pool(ctx, "str", "")}, "tagged") as integer
            end
            local value = ctx.readHeld(held)
            ctx.release(held)

            return value
        end
        -- `...items`: the pack as a table with its count as `n`.
        profile.namedVararg = function(ctx: any, parameter: any): integer
            return ctx.emit(parameter, "LibCall", {73, ctx.varargPack()}, "tagged") as integer
        end
        -- Sets each cleanup function a declaration names in the core's
        -- registry, under its checked key, as the declaration binds it.
        profile.cleanupRegistrations = function(ctx: any, stat: any, value: any): nil
            local tokens = {}
            if stat.kind == "localFuncStmt" then
                tokens[1] = stat.name
            else
                for _, part in ipairs(stat.name) do
                    if cst.isToken(part) then
                        tokens[#tokens + 1] = part
                    end
                end
            end
            for _, token in ipairs(tokens) do
                for _, registration in ipairs(token.cleanupRegistrations or {}) do
                    local key = ctx.emit(stat, "K", {pool(ctx, "str", registration.cleanup.key)}, "tagged")
                    ctx.emit(stat, "LibCall", {104, key, value}, "tagged")
                end
            end
        end
        profile.functionStatement = function(ctx: any, stat: any): nil
            local name = stat.name
            local fields = {}
            for _, part in ipairs(name) do
                if part ~= name.base and cst.isToken(part) and part.kind == "name" then
                    fields[#fields + 1] = part.text
                end
            end
            need(#fields >= 1, "a function statement names a field of a table")
            local owner = ctx.expression(
                {kind = "name", token = name.base, inferredType = name.base.inferredType, name.base},
                "tagged"
            )
            if owner == nil then
                return
            end
            -- `function a.b.c()`: the table the path names before its last
            -- field.
            for index = 1, #fields - 1 do
                local key = ctx.emit(stat, "K", {pool(ctx, "str", fields[index])}, "tagged")
                owner = ctx.emit(stat, "GetIdx", {owner, key}, "tagged")
            end
            local held = ctx.hold(owner)
            local closure = ctx.hold(tagged.closure(ctx, stat))
            local key = ctx.emit(stat, "K", {pool(ctx, "str", fields[#fields])}, "tagged")
            ctx.emit(stat, "SetIdx", {ctx.readHeld(held), key, ctx.readHeld(closure)}, nil)
            profile.cleanupRegistrations(ctx, stat, ctx.readHeld(closure))
            ctx.release(closure)
            ctx.release(held)
        end
        -- `count` results of a call, for `local a, b = f()` and its kin.
        profile.callResults = function(ctx: any, node: any, count: integer): {integer}?
            if node.ownershipIntrinsic then
                return ownership(ctx, node, count)
            end
            -- `local a, b = ...` reads the pack in order; past its end is nil.
            if node.kind == "vararg" then
                local values = {}
                for index = 1, count do
                    local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
                    values[index] = ctx.emit(node, "GetIdx", {ctx.varargPack(), key}, "tagged")
                end
                return values
            end
            local site = catalog(ctx).callByNode[node]
            if node.kind == "methodCall" and site and site.method then
                return invokeMethod(ctx, node, true, count)
            end
            if graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall" then
                return invokeProtected(ctx, node, true, count)
            end
            -- A library call with several results answers a pack, read in
            -- order; past its end is nil.
            if graph.packedcall(node) then
                local pack = librarypack(ctx, node)
                if pack == nil then
                    return nil
                end
                local held = ctx.hold(pack)
                local values = {}
                for index = 1, count do
                    local key = ctx.emit(node, "K", {pool(ctx, "int64", tostring(index))}, "tagged")
                    values[index] = ctx.emit(node, "GetIdx", {ctx.readHeld(held), key}, "tagged")
                end
                ctx.release(held)
                return values
            end
            need(node.kind == "call" and node.runtimeLoader ~= "require", "only plain calls spread their results")
            need(graph.coreLibraryCall(node) == nil, "library calls answer one result")

            return invoke(ctx, node, true, true, count)
        end
        -- A bare `return`, or the end of a body, answers nil. A last call
        -- supplies as many results as the function declares, as Lua passes
        -- every result of `return f()` on.
        profile.returnStatement = function(ctx: any, stat: any): nil
            if #stat.exprs == 0 then
                local value = ctx.emit(stat, "Nil", {}, "tagged")
                ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
                ctx.block = nil
                return
            end
            local last = stat.exprs[#stat.exprs]
            -- `return a, ...` gives the fixed values, then the whole pack.
            if last.kind == "vararg" then
                local fixed, kinds = {}, {}
                for index = 1, #stat.exprs - 1 do
                    fixed[index], kinds[index] = stat.exprs[index], "tagged"
                end
                need(#fixed <= 16, "a return gives at most sixteen results")
                local values = ctx.operands(fixed, kinds)
                if values == nil then
                    return
                end
                local pack = ctx.varargPack()
                ctx.block.term = {
                    kind = "return",
                    value = values[1] or pack,
                    values = #values > 0 and values or nil,
                    spread = pack,
                    edges = {},
                    pos = ctx.position(stat)
                }
                ctx.block = nil
                return
            end
            local declared: integer = ctx.fn.signature and #ctx.fn.signature.rets or 1
            local lastSite = catalog(ctx).callByNode[last]
            local spreads = last.kind == "call"
                and last.runtimeLoader ~= "require"
                and graph.coreLibraryCall(last) == nil
                or last.kind == "methodCall" and lastSite ~= nil and lastSite.method
                or (last.kind == "call" or last.kind == "methodCall") and packSpec(graph.coreLibraryCall(last)) ~= nil
            -- A function with open results (`R...`) returns every result of a
            -- call last in its return, as a pack the return spreads.
            local openReturn = ctx.fn.signature
                and ctx.fn.signature.retPack
                and ctx.fn.signature.retPack.tail ~= nil
                and last.kind == "call"
                and last.runtimeLoader ~= "require"
                and graph.coreLibraryCall(last) == nil
            if openReturn then
                local fixed, kinds = {}, {}
                for index = 1, #stat.exprs - 1 do
                    fixed[index], kinds[index] = stat.exprs[index], "tagged"
                end
                need(#fixed <= 16, "a return gives at most sixteen results")
                local operands = ctx.operands(fixed, kinds)
                if operands == nil then
                    return
                end
                local held = {}
                for index, value in ipairs(operands) do
                    held[index] = ctx.hold(value)
                end
                local pack = invoke(ctx, last, true, true, nil, true)
                if pack == nil or ctx.block == nil then
                    for _, handle in ipairs(held) do
                        ctx.release(handle)
                    end
                    return
                end
                local values = {}
                for index, handle in ipairs(held) do
                    values[index] = ctx.readHeld(handle)
                    ctx.release(handle)
                end
                ctx.block.term = {
                    kind = "return",
                    value = values[1] or pack,
                    values = #values > 0 and values or nil,
                    spread = pack,
                    edges = {},
                    pos = ctx.position(stat)
                }
                ctx.block = nil
                return
            end
            local spread: integer? = spreads and declared > #stat.exprs and declared - #stat.exprs + 1 or nil
            if #stat.exprs == 1 and not spread then
                return tagged.returnStatement(ctx, stat)
            end
            need(#stat.exprs + (spread or 1) - 1 <= 16, "a return gives at most sixteen results")
            local held = {}
            for index, expr in ipairs(stat.exprs) do
                if index < #stat.exprs or not spread then
                    local value = ctx.expression(expr, "tagged")
                    if value == nil then
                        for _, handle in ipairs(held) do
                            ctx.release(handle)
                        end
                        return
                    end
                    held[#held + 1] = ctx.hold(value)
                else
                    local results = profile.callResults(ctx, expr, spread)
                    if results == nil then
                        for _, handle in ipairs(held) do
                            ctx.release(handle)
                        end
                        return
                    end
                    for _, value in ipairs(results) do
                        held[#held + 1] = ctx.hold(value)
                    end
                end
            end
            local values = {}
            for index, handle in ipairs(held) do
                values[index] = ctx.readHeld(handle)
                ctx.release(handle)
            end
            ctx.block.term = {kind = "return", value = values[1], values = values, edges = {}, pos = ctx.position(stat)}
            ctx.block = nil
        end
        profile.fallthrough = function(ctx: any, node: any): nil
            -- A module with named exports answers its export table.
            local value = ctx.exports and ctx.readHeld(ctx.exports) or ctx.emit(node, "Nil", {}, "tagged")
            ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(node.eof or node)}
            ctx.block = nil
        end
        profile.call = function(ctx: any, node: any, expected: string?): integer
            if node.ownershipIntrinsic then
                local results = ownership(ctx, node, 1)
                if results == nil then
                    return nil as any
                end
                return results[1]
            end
            -- `require` of a computed name: the module the image holds by it.
            if graph.dynamicRequire(node) then
                need(#(node.args.exprs or {}) == 1, "require takes one module name")
                return libraryCall(ctx, node, 85, node.args.exprs)
            end
            if node.runtimeLoader == "require" then
                return tagged.call(ctx, node, expected)
            end
            local library = graph.coreLibraryCall(node)
            need(library ~= "io.write", "io.write's result, its file, is not yet supported")
            if library == "tostring" or library == "table.concat" then
                return libraryCall(ctx, node, library == "tostring" and 1 or 3, node.args.exprs or {})
            elseif library == "assert" then
                -- assert(v [, message]): v, its one result here, or the
                -- message raised.
                local count = #(node.args.exprs or {})
                need(count >= 1 and count <= 2, "assert takes a value and an optional message")
                return libraryCall(ctx, node, 87, node.args.exprs)
            elseif library == "tonumber" then
                local count = #(node.args.exprs or {})
                need(count == 1 or count == 2, "tonumber takes a value and an optional base")
                return libraryCall(ctx, node, count == 2 and 106 or 9, node.args.exprs)
            elseif library == "pcall" or library == "xpcall" then
                return invokeProtected(ctx, node, true) as integer
            elseif library == "error" then
                -- error(value [, level]): a string value gets the position the
                -- level names.
                local count = #(node.args.exprs or {})
                need(count >= 1 and count <= 2, "error takes a value and an optional level")
                return libraryCall(ctx, node, 22, node.args.exprs)
            elseif library == "select" then
                -- select over the pack: "#" reads its count at key 0.
                -- So is a call's results, last, as an open call's pack.
                local args = node.args.exprs or {}
                need(
                    #args == 2 and (args[2].kind == "vararg" or graph.expandsResults(args[2])),
                    "select takes an index and `...` or a call"
                )

                local function values(): integer?
                    if args[2].kind == "vararg" then
                        return ctx.varargPack()
                    end
                    return invoke(ctx, args[2], true, true, nil, true)
                end

                local first = args[1]
                local constant = catalog(ctx).byNode[first]
                if constant and constant.kind == "str" and constant.bytes == "#" then
                    local pack = values()
                    if pack == nil or ctx.block == nil then
                        return nil as any
                    end
                    local zero = ctx.emit(node, "K", {pool(ctx, "int64", "0")}, "tagged")
                    return ctx.emit(node, "GetIdx", {pack, zero}, "tagged") as integer
                end
                local index = ctx.expression(first, "tagged")
                if index == nil then
                    return nil as any
                end
                local held = ctx.hold(index)
                local pack = values()
                if pack == nil or ctx.block == nil then
                    ctx.release(held)
                    return nil as any
                end
                local value = ctx.emit(node, "LibCall", {20, pack, ctx.readHeld(held)}, "tagged")
                ctx.release(held)
                return value as integer
            elseif library == "setmetatable"
                or library == "getmetatable"
                or library == "rawget"
                or library == "rawset"
            then
                -- Metatables: __index and __newindex tables are followed by
                -- GetIdx and SetIdx; the library calls set and read them.
                local spec: {
                    [string]: {integer}
                } = {setmetatable = {28, 2}, getmetatable = {29, 1}, rawget = {30, 2}, rawset = {31, 3}}
                local form: {integer} = need(spec[library as string], "metatable library call")
                need(#(node.args.exprs or {}) == form[2], tostring(library) .. " argument count is not admitted")
                return libraryCall(ctx, node, form[1], node.args.exprs)
            elseif library == "string.format" then
                return libraryCall(ctx, node, 2, node.args.exprs or {})
            elseif library == "print" then
                return printValues(ctx, node)
            elseif library == "math.random" or library == "math.randomseed" then
                -- Without arguments a placeholder nil is the call's one value.
                local args = node.args.exprs or {}
                local random = library == "math.random"
                need(#args <= 2, tostring(library) .. " takes at most two arguments")
                if #args == 0 then
                    local none = ctx.emit(node, "Nil", {}, "tagged")
                    return ctx.emit(node, "LibCall", {random and 71 or 72, none}, "tagged") as integer
                end
                return libraryCall(ctx, node, random and 69 or 70, args)
            elseif library == "table.sort" then
                -- Without a comparator the sort step compares with `<` itself.
                local count = #(node.args.exprs or {})
                need(count == 1 or count == 2, "table.sort takes a table and an optional comparator")
                if count == 2 then
                    return sortWith(ctx, node)
                end
                return libraryCall(ctx, node, 47, node.args.exprs)
            elseif library == "type" then
                need(#(node.args.exprs or {}) == 1, "type takes one value")
                return libraryCall(ctx, node, 32, node.args.exprs)
            elseif library == "os.getenv" then
                need(#(node.args.exprs or {}) == 1, "os.getenv takes one name")
                return libraryCall(ctx, node, 10, node.args.exprs)
            elseif coroutinepacked[library or ""] then
                -- Kept as one value: its pack's first.
                local pack = coroutinepack(ctx, node)
                if pack == nil then
                    return nil as any
                end
                local key = ctx.emit(node, "K", {pool(ctx, "int64", "1")}, "tagged")
                return ctx.emit(node, "GetIdx", {pack, key}, "tagged") as integer
            elseif library == "coroutine.isyieldable" then
                need(#(node.args.exprs or {}) == 0, "coroutine.isyieldable takes no arguments")
                local none = ctx.emit(node, "Nil", {}, "tagged")
                return ctx.emit(node, "LibCall", {81, none}, "tagged") as integer
            elseif stringSpec(library) then
                local spec: {integer} = need(stringSpec(library), "string library call")
                local count = #(node.args.exprs or {})
                need(count >= spec[2] and count <= spec[3], tostring(library) .. " argument count is not admitted")
                return libraryCall(ctx, node, spec[1], node.args.exprs)
            elseif library == "math.floor" then
                need(#(node.args.exprs or {}) == 1, "math.floor takes one number")
                local operand = ctx.expression(node.args.exprs[1], "tagged")
                if operand == nil then
                    return nil as any
                end
                return ctx.emit(node, "MathFloor", {operand}, "tagged") as integer
            end
            need(expected == nil or expected == "tagged", "call requires tagged destination")

            return invoke(ctx, node, true, true) as integer
        end
        -- s:format(...) on a checked string.
        profile.methodCall = function(ctx: any, node: any, expected: string?): integer
            need(expected == nil or expected == "tagged", "method call requires tagged destination")
            local site = catalog(ctx).callByNode[node]
            if site and site.method then
                return invokeMethod(ctx, node, true) as integer
            end
            local library = graph.coreLibraryCall(node)
            need(
                library == "string.format" or stringSpec(library) ~= nil,
                "only string library method calls are admitted"
            )
            local arguments = {node.obj}
            for _, argument in ipairs(node.args.exprs or {}) do
                arguments[#arguments + 1] = argument
            end
            if library == "string.format" then
                return libraryCall(ctx, node, 2, arguments)
            end
            local spec: {integer} = need(stringSpec(library), "string library call")
            need(
                #arguments >= spec[2] and #arguments <= spec[3],
                tostring(library) .. " argument count is not admitted"
            )

            return libraryCall(ctx, node, spec[1], arguments)
        end
        profile.statementCall = function(ctx: any, node: any): nil
            local site = catalog(ctx).callByNode[node]
            if graph.dynamicRequire(node) or node.ownershipIntrinsic then
                profile.call(ctx, node, nil)
            elseif node.runtimeLoader == "require" then
                tagged.statementCall(ctx, node)
            elseif node.kind == "methodCall" and site and site.method then
                invokeMethod(ctx, node, false)
            elseif graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall" then
                invokeProtected(ctx, node, false)
            elseif graph.coreLibraryCall(node) == "io.write" then
                -- io.write(...): its values in a pack, written as they are.
                local pack = valuespack(ctx, node, node.args.exprs or {})
                if pack ~= nil then
                    ctx.emit(node, "LibCall", {83, pack}, "tagged")
                end
            elseif node.kind == "call" and graph.coreLibraryCall(node) ~= nil then
                -- error, setmetatable and the other library calls made for
                -- their effect.
                profile.call(ctx, node, nil)
            else
                invoke(ctx, node, false, true)
            end
        end
        profile.unary = function(ctx: any, node: any, expected: string?): integer
            if node.op and node.op.text == "not" then
                need(expected == nil or expected == "tagged", "negation requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil as any
                end
                return ctx.emit(node, "Not", {operand}, "tagged") as integer
            end
            if node.op and node.op.text == "#" then
                need(expected == nil or expected == "tagged", "length requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil as any
                end
                return ctx.emit(node, "Len", {operand}, "tagged") as integer
            end
            -- `-x` as `x * -1`, which is Lua's negation for both kinds: it
            -- flips a float's sign (so -0.0 survives) and wraps an integer.
            if node.op and node.op.text == "-" and catalog(ctx).byNode[node] == nil then
                need(expected == nil or expected == "tagged", "negation requires tagged destination")
                local operand = ctx.expression(node.operand, "tagged")
                if operand == nil then
                    return nil as any
                end
                -- An operand not known to be a number may be a table with
                -- __unm, which the library call tries first.
                local kind = typeKind(node.operand.inferredType)
                if kind ~= "number" and kind ~= "float64" and kind ~= "int64" then
                    return ctx.emit(node, "LibCall", {33, operand}, "tagged") as integer
                end
                local held = ctx.hold(operand)
                local minusOne = ctx.emit(node, "K", {pool(ctx, "int64", "-1")}, "tagged")
                operand = ctx.readHeld(held)
                ctx.release(held)
                return ctx.emit(node, "Mul", {operand, minusOne}, "tagged") as integer
            end

            -- `~x`, a core library call (guestbits).
            if node.op and node.op.text == "~" and catalog(ctx).byNode[node] == nil then
                need(expected == nil or expected == "tagged", "bitwise not requires tagged destination")
                return libraryCall(ctx, node, 112, {node.operand})
            end

            return tagged.unary(ctx, node, expected)
        end
    end

    if version >= 8 then
        local withCleanup: any = nil
        profile.forOwner = function(p: any, owner: any): any
            if not (p.cleanupOwners and p.cleanupOwners[owner.id]) then
                return profile
            end
            withCleanup = withCleanup or cleanupProfile(profile)

            return withCleanup
        end
    end

    return profile
end

function tagged.exportStatement(ctx: any, stat: any): nil
    need(ctx.fn.kind == "module", "an export belongs to a module")
    -- A named export's statement runs as it is; exportNames stores it.
    if stat.stat then
        need(ctx.exports ~= nil, "named exports need the module's export table")
        return
    end
    need(stat.value, "export needs a value")
    local value = ctx.expression(stat.value, "tagged")
    ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
    ctx.block = nil
end

function tagged.returnStatement(ctx: any, stat: any): nil
    need(#stat.exprs <= 1, "multiple results are unsupported")
    local value = stat.exprs[1] and ctx.expression(stat.exprs[1], "tagged") or nil
    ctx.block.term = {kind = "return", value = value, edges = {}, pos = ctx.position(stat)}
    ctx.block = nil
end

function tagged.fallthrough(ctx: any, node: any): nil
    ctx.block.term = {kind = "return", edges = {}, pos = ctx.position(node.eof or node)}
    ctx.block = nil
end

export = tagged
