module nupp.compiler.vm.programgraph

local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local graph = require("nupp.compiler.vm.graph")
local construction = require("nupp.compiler.vm.construction")
local builtinextensions = require("nupp.compiler.builtinextensions")
local taggedvalues = require("nupp.compiler.vm.taggedvalues")
local opcodes = require("nupp.compiler.vm.opcodes")
local graphimage = require("nupp.compiler.vm.graphimage")
local graphemit = require("nupp.compiler.vm.graphemit")
local graphcalls = require("nupp.compiler.vm.graphcalls")
local lower = require("nupp.compiler.vm.lower")
local scalartypeof = require("nupp.compiler.vm.scalartypeof")
local ownedcallables = require("nupp.compiler.vm.ownedcallables")
local forwardedexports = require("nupp.compiler.vm.forwardedexports")
local derivedrecipes = require("nupp.compiler.vm.derivedrecipes")
local indexedaccess = require("nupp.compiler.vm.indexedaccess")

local typeSyntax = {
    tconst = true,
    tkeyof = true,
    twriteof = true,
    tliteral = true,
    tname = true,
    ttypecall = true,
    tparen = true,
    tmap = true,
    tshape = true,
    tshapeField = true,
    ttuple = true,
    tpack = true,
    tpackUnion = true,
    tarray = true,
    tfunc = true,
    tfuncParam = true,
    topt = true,
    tptr = true,
    tcarray = true,
    tmember = true,
    tmapped = true,
    tunion = true,
    tintersection = true,
    errorType = true,
    tpredicate = true,
    tborrows = true,
    tpreserves = true,
    generics = true,
    annotationApply = true,
}

local function bindingMode(definition: any): string
    -- bindType/bindPack create lexical definitions too. Only bindVar records
    -- a function depth, including a nominal declaration's runtime value.
    -- A `cdef function` has none: its calls name it (taggedforeign).
    if definition.functionDepth == nil or definition.cdef and definition.cdefIdentity ~= nil then
        return "type"
    end
    return definition.constant and "value" or "cell"
end

-- The ownership intrinsics the core runs: transfers, which answer the value
-- they move, and `partition`, which answers its two parts. Their ownership
-- is the checker's; at run time each is its value.
local executableintrinsics: {
    [string]: boolean
} = {adopt = true, release = true, borrow = true, borrowFrom = true, region = true, partition = true}

-- Whether the core runs ownership intrinsic call `node`: an executable one,
-- or a `drop`, which runs its owner's cleanups then.
local function executable(node: any): boolean
    local operation = node.ownershipIntrinsic

    return executableintrinsics[operation] == true or operation == "drop" and not node.cleanupRegistrations
end

local function need(ok: any, message: string): any
    -- The message is built only for a failure: checks run millions of times.
    if not ok then
        error("program graph: " .. message, 0)
    end
    return ok
end

local function initializerpositions(p: any, owner: integer, base: any, extension: any): (integer, integer)
    local baseIndex: integer = 0
    local extensionIndex: integer = 0
    for position, load in ipairs(p.qualifiedLoads[owner] or {}) do
        if load == base then
            need(baseIndex == 0, "checked builtin base must initialize before its extension exactly once")
            baseIndex = position
        elseif load == extension then
            need(extensionIndex == 0, "checked builtin base must initialize before its extension exactly once")
            extensionIndex = position
        end
    end

    return baseIndex, extensionIndex
end

-- A checked builtin table read selects the extension's shared host table.
-- The declaration anchors distinguish it from an authored local of that name.
export function builtinprojection(node: any): any
    if (node.kind ~= "name" and node.kind ~= "call") or node.standardRoot == nil then
        return nil
    end
    local root = node.standardRoot
    need(type(root) == "string" and builtinextensions.has(root), "invalid checked builtin root")
    local module = builtinextensions.installer(root, nil)
    -- Direct roots such as assert and warn retain their library routing.
    if module == nil then
        return nil
    end
    local loader = node.kind == "call"
    if loader and node.typeOnlyRequire then
        return nil
    end
    local token = loader and node.obj and node.obj.kind == "name" and node.obj.token or node.token
    local definition = token and token.definition
    local name = loader and "require" or root
    need(
        token
        and token.text == name
        and definition
        and definition.filename == "nupp:lua.d.nupp"
        and definition.name == name
        and definition.token
        and definition.token.text == name,
        "checked builtin projection lacks its prelude declaration"
    )
    if loader then
        local args = node.args
        local exprs = args and args.exprs or {}
        local argument = #exprs == 1 and not args.str and not args.table and exprs[1] or nil
        local literal = argument and (argument.kind == "string" or argument.kind == "dedentString") and argument.token
            or #exprs == 0 and args and not args.table and args.str
        need(
            node.runtimeLoader == "require"
            and node.requiredModule == root
            and literal
            and lexer.literalstring(literal.text, argument ~= nil and argument.kind == "dedentString") == root,
            "checked builtin projection lacks its literal loader"
        )
    end
    need(
        node.namespacePath == root
        and node.qualifiedModule == module
        and type(node.qualifiedMembers) == "table"
        and #node.qualifiedMembers == 1
        and node.qualifiedMembers[1] == "value",
        "checked builtin projection differs from its extension"
    )

    return {
        root = root,
        module = module,
        token = token,
        definition = definition,
        declaration = definition.token,
        members = {"value"},
        loader = loader
    }
end

export function importmodule(p: any, b: any): string?
    local imported = b.builtinImport
    if imported then
        local declaration, index = imported.declaration, imported.index
        local node = imported.node
        local current = builtinprojection(node)
        local original = imported.projection
        local site = p.requireByNode[node]
        need(
            declaration.kind == "localStmt"
            and declaration.names[index] == b.token
            and (
                not imported.pattern and not declaration.pattern and declaration.exprs[index] == node
                or imported.pattern
                and declaration.pattern
                and declaration.pattern[index] == imported.pattern
                and not imported.pattern.typeOnly
                and declaration.patternSource == node
                and (imported.pattern.alias or imported.pattern.sourceName) == b.token
            )
            and b.token == b.definition.token
            and p.byDefinition[b.definition] == b
            and imported.owner == b.owner
            and site
            and site.owner == b.owner
            and site.node == node
            and site.builtin
            and site.qualified
            and site.builtin.root == original.root
            and site.builtin.module == original.module
            and site.builtin.token == original.token
            and site.builtin.definition == original.definition
            and site.builtin.declaration == original.declaration
            and site.builtin.loader == true
            and current
            and current.loader
            and current.root == b.definition.requiredModule
            and current.root == original.root
            and current.module == original.module
            and original.loader == true
            and #original.members == 1
            and original.members[1] == "value"
            and current.token == original.token
            and current.definition == original.definition
            and current.declaration == original.declaration
            and site.module == graph.coremodule(current.module),
            "checked builtin import differs from its initializer"
        )
        return graph.coremodule(current.module)
    end

    return p.scalartypes.definitions[b.definition] and scalartypeof.MODULE
        or graph.coremodule(b.definition.requiredModule)
end

-- Whether the core runs ownership intrinsic call `node`.
export function executableIntrinsic(node: any): boolean
    return executable(node)
end

local function storagePlan(p: any): any
    local storage = {}
    for _, b in ipairs(p.bindings) do
        storage[b.definition] = b.mode == "type" and "erased" or "value"
    end
    for _, owner in ipairs(p.owners) do
        for _, item in ipairs(owner.captures) do
            local b = need(p.bindings[item.binding + 1], "capture binding is missing")
            -- A record's methods may name the record, whose table holds them:
            -- its binding is a cell made before them, as a local function's is.
            local ownRecord = p.recordMembers[owner.node] == b.definition
            -- An exported function may be captured before its statement runs:
            -- a cell made as the module starts holds it from then on.
            local hoisted = p.hoistedFunctions[b.definition] == true or p.assignedFunctions[b.definition] == true
            if b.mode == "cell" or item.recursive or ownRecord or hoisted then
                storage[b.definition] = "cell"
            end
        end
    end

    return storage
end

local function kind(t: any): string
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    return t and t.tag or "missing"
end

-- Values are kept beside their source and exact bytes. Integers never pass
-- through tonumber; float NaNs use the graph image's canonical quiet NaN.
local function literal(node: any): any
    if node.kind == "paren" then
        return literal(node.expr)
    end
    local negative = node.kind == "unop" and node.op.text == "-" and node.operand.kind == "number"
    local value = negative and node.operand or node
    if value.kind == "number" then
        local text = value.token.text:gsub("_", "")
        local ty = kind(value.inferredType)
        local integer = ty == "integer" or ty == "int64" or ty == "uint64"
        text = text:gsub("[Uu]?[Ll][Ll]$", "")
        text = (negative and "-" or "") .. text
        if integer then
            return {kind = ty == "uint64" and "uint64" or "int64", text = text, bytes = graphimage.wideTextBytes(text)}
        end
        local number = need(tonumber(text), "unsupported float literal " .. text)
        -- Unary negation of a parsed positive zero retains its IEEE sign even
        -- when the host parses an integer-looking zero as an integer.
        if negative and number == 0 then
            number = -0.0
        end
        return {kind = "num", text = text, bytes = graphimage.floatBytes(number)}
    elseif value.kind == "string" then
        return {kind = "str", bytes = need(lexer.literalstring(value.token.text), "unsupported string literal")}
    elseif value.kind == "dedentString" then
        return {kind = "str", bytes = lexer.dedentLongString(value.token.text)}
    elseif value.kind == "trueExpr" or value.kind == "falseExpr" or value.kind == "nilExpr" then
        return {
            kind = value.kind == "trueExpr" and "true" or value.kind == "falseExpr" and "false" or "nil",
            bytes = ""
        }
    end

    return nil
end

local function functionName(node: any, id: integer): string
    if node.kind == "localFuncStmt" or node.kind == "inlineMethod" then
        return node.name.text
    elseif node.kind == "funcStmt" then
        local parts = {}
        for _, token in ipairs(node.name) do
            parts[#parts + 1] = token.text
        end
        return table.concat(parts)
    end

    return "<function " .. tostring(id) .. ">"
end

-- This walk discovers semantic owners, not instructions. Only ordered CST
-- children are visited: named fields alias them and checker metadata has cycles.
-- A `:` method's receiver is implicit: the checker binds `self` without a
-- declaring token, so its references carry no definition. The core gives it
-- one, as a synthetic first parameter, and points every `self` in the body
-- at it, except inside nested methods, which have their own receiver.
local function implicitSelf(node: any, body: any): any
    if body.coreSelfParam ~= nil or not (node.kind == "funcStmt" and node.name.method) then
        return body.coreSelfParam
    end
    local token: any = {
        kind = "name",
        text = "self",
        line = node.name.method.line,
        col = node.name.method.col,
        offset = node.name.method.offset,
        trivia = {}
    }
    local definition: any = {lexical = true, token = token, functionDepth = 0, constant = true, implicitSelf = true}
    token.definition = definition
    local mark: function(any): nil
    mark = function(item: any): nil
        if type(item) ~= "table" then
            return
        end
        if cst.isToken(item) then
            if item.text == "self" and item.definition == nil then
                item.definition = definition
            end
            return
        end
        if item ~= body and (item.kind == "funcStmt" and item.name.method or item.kind == "inlineMethod") then
            return
        end
        for _, child in ipairs(item) do
            mark(child)
        end
    end
    mark(body)
    body.coreSelfParam = {kind = "param", name = token, implicitSelf = true}

    return body.coreSelfParam
end

export function parameters(body: any): {any}
    return graph.parameters(body)
end

-- Whether `node` is a name a chunk reads as a global: one no declaration in
-- it binds.
local function chunkGlobal(p: any, node: any): boolean
    if not p.chunk or node.kind ~= "name" or not node.token then
        return false
    end
    local definition = node.token.definition

    return definition == nil or p.byDefinition[definition] == nil
end

-- Calls `visit` with every token in the tree under `node`, and `enter`, when
-- given, with every node.
local function eachToken(node: any, visit: function(any): nil, enter: (function(any): nil)?): nil
    if type(node) ~= "table" then
        return
    end
    if cst.isToken(node) then
        visit(node)
        return
    end
    if enter then
        enter(node)
    end
    for _, child in ipairs(node) do
        eachToken(child, visit, enter)
    end
end

-- The library calls a chunk guards: those it makes through a global name
-- (`print`, `io.write`) other than the forms the core lowers itself around
-- the call (pcall, xpcall, require, a callback's library). Answers the
-- library's name, which keys the function the program started with.
local UNGUARDED: {[string]: boolean} = {pcall = true, xpcall = true, ["require.dynamic"] = true}

local function guardedLibrary(p: any, node: any): string?
    local library = graph.coreLibraryCall(node)
    if library == nil or UNGUARDED[library] or graph.callbackArgument(node) ~= nil or p.callByNode[node] ~= nil then
        return nil
    end
    local callee = node.obj
    local root = callee and callee.kind == "dotIndex" and callee.obj or callee
    if root == nil or root.kind ~= "name" or not chunkGlobal(p, root) then
        return nil
    end
    if callee ~= root and (callee.obj ~= root or callee.name == nil) then
        return nil
    end

    return library
end

-- A function statement naming a local declared before it (`local f` then
-- `function f()`) assigns that local, as in Lua; the checker declares the
-- statement's name anew. This points the statement's name, and every name
-- the checker resolved to it, at the local it assigns.
local function assignForwardLocals(root: any, replaced: {[any]: any}): nil
    local declared: {any} = {}
    local statements: {any} = {}
    eachToken(
        root,
        function(token: any): nil
            local definition = token.definition
            if definition and definition.token == token and definition.lexical and definition.scopeFrom then
                declared[#declared + 1] = definition
            end
        end,
        function(node: any): nil
            local base = node.kind == "funcStmt" and node.name and node.name.base
            if base and #node.name == 1 and base.definition and base.definition.token == base then
                statements[#statements + 1] = base
            end
        end
    )
    local changed = false
    for _, base in ipairs(statements) do
        local own = base.definition
        local found: any = nil
        for _, definition in ipairs(declared) do
            if definition ~= own
                and definition.name == own.name
                and definition.token.offset < base.offset
                and definition.scopeFrom <= base.offset
                and base.offset <= definition.scopeTo
                and (found == nil or definition.scopeFrom > found.scopeFrom)
            then
                found = definition
            end
        end
        if found then
            replaced[own], changed = found, true
        end
    end
    if not changed then
        return
    end
    eachToken(root, function(token: any): nil
        local to = token.definition and replaced[token.definition]
        if to then
            token.definition = to
        end
    end)
end

-- `options.chunk` describes a chunk Lua's `load` compiles (nupp.compiler.vm.corechunk):
-- a name no declaration binds is a global, a field of the running program's
-- `_G`, and every module it requires is the running program's, by name.
export function describe(modules: {any}, entryModule: string, options: any?): any
    local p: any = {
        chunk = options ~= nil and options.chunk == true,
        -- In a chunk, the name tokens that read or write a global, each to
        -- the read of the chunk's environment it is a field of.
        globals = {},
        -- In a chunk, the name of the local its environment is in, and of
        -- the one the library functions as the program started are in.
        environment = options ~= nil and options.environment or nil,
        builtins = options ~= nil and options.builtins or nil,
        -- In a chunk, the library calls through a global, each to what its
        -- guard reads: the call is the core's own while the environment
        -- still holds the function the program started with.
        guarded = {},
        modules = {},
        owners = {},
        bindings = {},
        constants = {},
        references = {},
        externals = {},
        externalReferences = {},
        intrinsics = {},
        externalsByDefinition = {},
        imports = {},
        requires = {},
        requireByNode = {},
        scalartypes = {imports = {}, definitions = {}, witnesses = {}},
        callables = {},
        -- Executable references the checker resolved to no declaration.
        unresolved = {},
        -- By module chunk id, the forwarders a module in a require cycle
        -- publishes for the functions it exports.
        forwards = {},
        -- By record declaration, the derived members it makes.
        derives = {},
        qualifiedLoads = {},
        calls = {},
        callByNode = {},
        indexedByNode = {},
        -- Per cleanup site (a local's statement), the record
        -- declaration whose destructor it runs, mapped to a synthetic
        -- reference to that record's name.
        cleanupTokens = {},
        -- For each declaration that takes defaults from interfaces of its own
        -- module, a reference to each one's table, by the interface's
        -- runtime name.
        inheritTokens = {},
        -- Every record declaration in the program's modules.
        recordDecls = {},
        -- Runtime class references issued for checked nominal record tests.
        recordTests = {},
        -- The owners (by id) with any such site.
        cleanupOwners = {},
        -- The definition of the record each method or constructor written in
        -- a record body belongs to, by its node.
        recordMembers = {},
        -- The definitions of the functions a module exports, which the checker
        -- hoists: a closure made above the declaration may already name one.
        hoistedFunctions = {},
        -- The locals a function statement assigns after their declaration
        -- (`local f` ... `function f()`), which closures made between hold.
        assignedFunctions = {},
        byDefinition = {},
        functionsByDefinition = {},
        byBody = {},
        byNode = {},
        immutable = {}
    }
    local moduleNames, topLevel, sourcePaths = {}, {}, {}
    -- Function statements' own names, which name the locals they assign.
    local forwardNames: {[any]: any} = {}
    for _, input in ipairs(modules) do
        need(type(input.name) == "string" and type(input.path) == "string", "module source required")
        need(not moduleNames[input.name], "duplicate module " .. input.name)
        sourcePaths[input.path] = true
        local parsed = need(input.parsed, "checked parse required")
        need(parsed.root and parsed.symbols and parsed.moduleName == input.name, "checked module identity required")
        -- Once per checked tree: a project shares its trees across programs.
        if parsed.forwardNames == nil then
            parsed.forwardNames = {}
            assignForwardLocals(parsed.root, parsed.forwardNames)
        end
        for own, assigned in pairs(parsed.forwardNames) do
            forwardNames[own] = assigned
        end
        need(input.diagnostics ~= nil and #parsed.errors == 0, "checked diagnostics required")
        -- A chunk compiles whatever its checking found, as Lua's `load` does.
        for _, diagnostic in ipairs(input.diagnostics) do
            need(p.chunk or diagnostic.severity ~= "error", "module has checker errors")
        end
        local scope: any = {name = input.name, path = input.path, constants = {}, functions = {}, exports = {}}
        local owner: any = {
            id = #p.owners,
            kind = "module",
            name = "<init>",
            node = parsed.root,
            body = parsed.root,
            scope = scope,
            captures = {},
            constants = {},
            paramKinds = {},
            captureByDefinition = {}
        }
        p.owners[#p.owners + 1] = owner
        p.byBody[owner.body] = owner
        for _, block in ipairs(parsed.root.blocks) do
            for _, stat in ipairs(block.stats or {}) do
                local declared = stat.kind == "exportStmt" and stat.stat or stat
                topLevel[declared] = true
                local name = graph.hoistedFunctionName(stat)
                if name and name.definition then
                    p.hoistedFunctions[name.definition] = true
                end
            end
        end
        local module = {name = input.name, path = input.path, chunk = owner.id, parsed = parsed}
        p.modules[#p.modules + 1], moduleNames[input.name] = module, module
        for _, alias in ipairs(graph.coremodulenames(input.name)) do
            need(moduleNames[alias] == nil or moduleNames[alias] == module, "duplicate core module " .. alias)
            moduleNames[alias] = module
        end
        for _, imported in ipairs(scalartypeof.imports(parsed.root)) do
            p.scalartypes.imports[imported.loader] = imported
            p.scalartypes.definitions[imported.definition] = imported
            for _, witness in ipairs(imported.sites) do
                p.scalartypes.witnesses[witness.node] = witness
            end
        end
        if input.name == entryModule then
            p.entry = owner.id
        end
    end
    need(p.entry ~= nil, "entry module is missing")

    local function binding(token: any, owner: any): nil
        local definition = token.definition
        if definition and definition.lexical and definition.token == token then
            need(p.byDefinition[definition] == nil, "duplicate checked declaration")
            local b: any = {
                id = #p.bindings,
                definition = definition,
                token = token,
                owner = owner.id,
                mode = bindingMode(definition)
            }
            p.bindings[#p.bindings + 1], p.byDefinition[definition] = b, b
        end
    end

    -- The record name each method written in a record body belongs to.
    local inlineRecords: {[any]: any} = {}
    -- The declarations of comptime helpers, which the program never sees.
    local erasedDefinitions: {[any]: boolean} = {}
    local discover: function(any, any): nil
    discover = function(node: any, owner: any): nil
        if cst.isToken(node) then
            binding(node, owner)
            return
        end
        if graph.erased(node) then
            -- What it declares exists only while compiling.
            local function forget(item: any): nil
                if cst.isToken(item) then
                    if item.definition then
                        erasedDefinitions[item.definition] = true
                    end
                    return
                end
                for _, child in ipairs(item) do
                    forget(child)
                end
            end

            forget(node)
            return
        end
        if node.kind == "recordDecl" then
            p.recordDecls[node] = true
        end
        local base = node.kind == "funcStmt" and node.name and node.name.base
        if base and base.definition and base.definition.token ~= base then
            p.assignedFunctions[base.definition] = true
        end
        if node.kind == "recordDecl" and node.name then
            for _, entry in ipairs(node.entries or {}) do
                if entry.kind == "inlineMethod" or entry.kind == "constructorDecl" then
                    inlineRecords[entry] = node.name
                    p.recordMembers[entry] = node.name.definition
                end
            end
        end
        if node.kind == "funcbody" then
            need(p.byBody[node] == owner, "unsupported checked function owner")
        end
        local isDeclaration = cst.FUNCTION_DECLARATIONS[node.kind]
        local body = node.kind == "shortfn" and node or isDeclaration and node.body
        need(not isDeclaration or body ~= nil, "function declaration lacks a checked body")
        if body and p.byBody[body] ~= owner then
            local where = cst.firstToken(node)
            local signature = need(
                body.signatureType,
                "checked function signature required at " .. tostring(
                    owner.scope.path
                ) .. ":" .. tostring(where and where.line)
            )
            local child: any = {
                id = #p.owners,
                kind = "function",
                name = functionName(node, #p.owners),
                node = node,
                body = body,
                parent = owner.id,
                scope = owner.scope,
                signature = signature,
                paramKinds = {},
                captures = {},
                constants = {},
                captureByDefinition = {}
            }
            local receiver = implicitSelf(node, body)
            if receiver then
                binding(receiver.name, child)
            end
            local params = parameters(body)
            for index, parameter in ipairs(params) do
                -- A `...` last is a hidden parameter holding the pack of extra
                -- arguments (a table with its count at key 0). A named one is a
                -- local the function binds from it on entry.
                if parameter.vararg and index == #params then
                    child.variadic = true
                    child.paramKinds[index] = "value"
                    -- It binds like a value parameter, keyed by its node.
                    local b: any = {
                        id = #p.bindings,
                        definition = parameter,
                        token = parameter,
                        owner = child.id,
                        mode = "value",
                        pack = true
                    }
                    p.bindings[#p.bindings + 1], p.byDefinition[parameter] = b, b
                else
                    need(
                        parameter.name and not parameter.vararg,
                        "parameter ownership or variadic lowering is unsupported"
                    )
                    child.paramKinds[index] = kind(parameter.name.inferredType)
                end
            end
            child.resultKind = #signature.rets == 1 and kind(signature.rets[1]) or nil
            local declaration = (node.kind == "localFuncStmt" or node.kind == "inlineMethod") and node.name
                or node.kind == "funcStmt" and node.name[#node.name]
                or nil
            -- A constructor has no name: it is given a synthetic one, which its
            -- construction callsites name.
            if node.kind == "constructorDecl" and inlineRecords[node] then
                local record = inlineRecords[node]
                local token: any = {
                    kind = "name",
                    text = "constructor",
                    line = record.line,
                    col = record.col,
                    offset = record.offset,
                    trivia = {}
                }
                token.definition = {lexical = true, token = token, functionDepth = 0, constant = true}
                node.coreDefinition = token.definition
                declaration = token
            end
            if declaration then
                child.definition = need(declaration.definition, "checked function declaration required")
                need(
                    p.functionsByDefinition[child.definition] == nil,
                    "multiple bodies for checked function declaration"
                )
                p.functionsByDefinition[child.definition] = child
            end
            p.owners[#p.owners + 1], p.byBody[body] = child, child
            if node.kind == "shortfn" then
                for _, part in ipairs(node) do
                    discover(part, child)
                end
            else
                for _, part in ipairs(node) do
                    discover(part, part == body and child or owner)
                end
            end
            return
        end
        for _, child in ipairs(node) do
            discover(child, owner)
        end
        if node.kind == "localStmt" then
            for index, token in ipairs(node.names) do
                local pattern = node.pattern and node.pattern[index]
                local value = pattern and not pattern.typeOnly and node.patternSource
                    or not pattern and node.exprs and node.exprs[index]
                local projection = value and builtinprojection(value)
                if projection and projection.loader then
                    local b = need(p.byDefinition[token.definition], "builtin import declaration missing")
                    b.builtinImport = {
                        declaration = node,
                        index = index,
                        node = value,
                        owner = owner.id,
                        projection = projection,
                        pattern = pattern
                    }
                end
            end
        end
    end
    -- All module and function identities exist before references are resolved.
    for _, module in ipairs(p.modules) do
        discover(module.parsed.root, p.owners[module.chunk + 1])
        for _, definition in ipairs(module.parsed.symbols) do
            need(
                not definition.lexical
                or p.byDefinition[definition] ~= nil
                or erasedDefinitions[definition]
                or forwardNames[definition] ~= nil,
                "checked declaration outside ordered syntax is unsupported: " .. tostring(
                    definition.name
                ) .. " in " .. module.path .. ":" .. tostring(definition.token and definition.token.line)
            )
        end
    end
    -- A chunk's environment and the library functions as the program
    -- started: the declarations of the locals its opening makes.
    if p.chunk then
        for _, b in ipairs(p.bindings) do
            if p.owners[b.owner + 1].kind == "module" then
                if b.definition.name == p.environment then
                    p.chunkEnvironment = b.definition
                elseif b.definition.name == p.builtins then
                    p.chunkBuiltins = b.definition
                end
            end
        end
        need(p.chunkEnvironment ~= nil, "chunk environment declaration is missing")
    end
    -- The checker names an exported function a call reaches before its
    -- statement by the definition it hoisted, which the statement then
    -- replaces. Such a call names the function the statement declares.
    local hoistedReferences: function(any): nil
    hoistedReferences = function(node: any): nil
        if cst.isToken(node) then
            local definition = node.definition
            local declared = definition and definition.token and definition.token.definition
            if declared ~= definition and p.hoistedFunctions[declared] and p.byDefinition[definition] == nil then
                node.definition = declared
            end
            return
        end
        for _, child in ipairs(node) do
            hoistedReferences(child)
        end
    end
    if next(p.hoistedFunctions) ~= nil then
        for _, module in ipairs(p.modules) do
            hoistedReferences(module.parsed.root)
        end
    end

    local scalarTarget: any = nil
    if next(p.scalartypes.witnesses) ~= nil then
        for _, owner in ipairs(p.owners) do
            if owner.kind == "function"
                and owner.scope.name == scalartypeof.MODULE
                and owner.name == scalartypeof.MEMBER
            then
                need(scalarTarget == nil, "ambiguous scalar storage factory")
                scalarTarget = owner
            end
        end
        need(scalarTarget and scalarTarget.definition, "checked scalar storage factory is missing")
        need(
            #scalarTarget.signature.params == 1
            and scalarTarget.signature.params[1].tag == "string"
            and #scalarTarget.signature.rets == 1
            and scalarTarget.signature.rets[1].tag == "any",
            "scalar storage factory signature differs"
        )
        for _, witness in pairs(p.scalartypes.witnesses) do
            local token = cst.firstToken(witness.node)
            witness.target = scalarTarget
            witness.call = {
                kind = "call",
                token = token,
                obj = {kind = "name", token = {text = scalartypeof.MEMBER, definition = scalarTarget.definition}},
                calleeType = scalarTarget.signature,
                args = {
                    kind = "args",
                    exprs = {
                        {
                            kind = "string",
                            token = {text = string.format("%q", witness.kind)},
                            inferredType = scalarTarget.signature.params[1]
                        }
                    }
                }
            }
        end
    end

    local capture: function(any, any, string?): any
    capture = function(owner: any, b: any, mode: string?): any
        need(owner.id ~= b.owner, "cannot capture an owned local")
        need(b.mode ~= "type", "erased type declaration cannot be captured")
        local existing = owner.captureByDefinition[b.definition]
        if existing then
            need(mode == nil or existing.mode == mode, "conflicting capture modes")
            return existing
        end
        local parent = need(
            owner.parent ~= nil and p.owners[owner.parent + 1],
            "capture escapes lexical ancestry: " .. tostring(
                b.definition.name
            ) .. " of " .. tostring(
                b.definition.filename
            ) .. ":" .. tostring(
                b.definition.token and b.definition.token.line
            ) .. " from " .. tostring(owner.scope and owner.scope.path)
        )
        local source = parent.id == b.owner and b.id or capture(parent, b, nil).id
        local item: any = {
            id = #owner.captures,
            binding = b.id,
            definition = b.definition,
            mode = mode or b.mode,
            sourceOwner = parent.id,
            sourceKind = parent.id == b.owner and "local" or "capture",
            source = source,
            recursive = owner.definition == b.definition
        }
        owner.captures[#owner.captures + 1], owner.captureByDefinition[b.definition] = item, item

        return item
    end

    -- Ownership clauses have checker-resolved outer bindings. Install them
    -- before ordinary reads so explicit take/borrow modes cannot be lost.
    for _, owner in ipairs(p.owners) do
        if owner.kind == "function" then
            for _, spec in ipairs({
                {items = owner.body.takenCaptures, mode = "take"},
                {items = owner.body.borrowCaptures, mode = "borrow"}
            }) do
                for _, item in ipairs(spec.items or {}) do
                    local definition = item.outer and item.outer.definition
                    local b = need(p.byDefinition[definition], "ownership capture lacks checked outer declaration")
                    local captured = capture(owner, b, spec.mode)
                    captured.ownership = item
                    captured.inner = item.inner and item.inner.definition or nil
                end
            end
        end
    end

    local loopForms: {[any]: boolean} = {}

    -- Registers the qualified read `node` makes of `module` in `owner`, with
    -- what else its site says (`fields`).
    local function qualifiedSite(owner: any, node: any, module: string, fields: {[string]: any}): nil
        local item: any = {
            id = #p.requires,
            owner = owner.id,
            node = node,
            module = module,
            typeOnly = false,
            qualified = true
        }
        for key, value in pairs(fields) do
            item[key] = value
        end
        p.requires[#p.requires + 1], p.requireByNode[node] = item, item
    end

    local reference: function(any, any): nil

    -- A read of the chunk's environment where global `token` is, in `owner`:
    -- a reference of its own, which capture analysis carries into closures.
    local function chunkLocalRead(token: any, owner: any, name: string, definition: any): any
        local read: any = {
            kind = "name",
            text = name,
            line = token.line,
            col = token.col,
            offset = token.offset,
            trivia = {},
            definition = definition
        }
        reference(read, owner)

        return read
    end

    local function environmentRead(token: any, owner: any): any
        return chunkLocalRead(token, owner, p.environment, p.chunkEnvironment)
    end

    reference = function(token: any, owner: any): nil
        local definition = token and token.definition
        local location = tostring(
            token and token.text
        ) .. " at " .. owner.scope.path .. ":" .. tostring(token and token.line)
        -- A chunk reads a name nothing declares, or what the prelude declares
        -- (`io`, `require`), as the running program's global of that name.
        if p.chunk and (definition == nil or definition.token ~= token and p.byDefinition[definition] == nil) then
            p.globals[token] = environmentRead(token, owner)
            return
        end
        -- Recorded rather than raised, so an inventory names every one;
        -- compile refuses a catalog that has any.
        if definition == nil then
            p.unresolved[#p.unresolved + 1] = {owner = owner.id, token = token, location = location}
            return
        end
        if definition.token == token then
            return
        end
        local b = p.byDefinition[definition]
        if not b then
            need(
                definition.token and type(definition.filename) == "string" and not sourcePaths[definition.filename],
                "lexical reference has no catalog declaration: " .. location .. " declared " .. tostring(
                    definition.name
                ) .. " at " .. tostring(
                    definition.filename
                ) .. ":" .. tostring(definition.token and definition.token.line)
            )
            local external = p.externalsByDefinition[definition]
            if not external then
                external = {
                    id = #p.externals,
                    definition = definition,
                    path = definition.filename,
                    token = definition.token,
                    -- Where it is first read, for the refusal to name.
                    first = location
                }
                p.externals[#p.externals + 1], p.externalsByDefinition[definition] = external, external
            end
            p.externalReferences[#p.externalReferences + 1] = {owner = owner.id, external = external.id, token = token}
            return
        end
        local role = b.mode == "type" and "type" or "value"
        p.references[#p.references + 1] = {token = token, binding = b.id, owner = owner.id, role = role}
        if role == "value" and b.owner ~= owner.id then
            capture(owner, b, nil)
        end
    end

    -- The chunk being collected, and the modules its qualified paths load as
    -- it starts: one site each, at the first path that names the module.
    local currentChunk: any = nil
    local loaded: {[any]: {[string]: any}} = {}

    -- One qualified source site, shared by eager paths and callable factories.
    local function qualifiedload(owner: any, module: any, node: any): any
        local site = {
            id = #p.requires,
            owner = owner.id,
            node = node,
            module = module.name,
            typeOnly = false,
            target = module.chunk,
            qualified = true
        }
        p.requires[#p.requires + 1], p.requireByNode[node] = site, site

        return site
    end

    -- A hidden require of `module` that chunk `owner` makes as it starts,
    -- before its own body (ahead of the others when `first`), positioned at
    -- `token`.
    local function eagerLoad(owner: any, module: any, token: any, first: boolean): any
        local load = {kind = "qualifiedLoad", qualifiedModule = module.name, token}
        local eager = qualifiedload(owner, module, load)
        eager.eager = true
        local loads = p.qualifiedLoads[owner.id] or {}
        p.qualifiedLoads[owner.id] = loads
        table.insert(loads, first and 1 or #loads + 1, eager)

        return eager
    end

    local function registerindexed(indexed: any): nil
        if indexed == nil then
            return
        end
        need(p.indexedByNode[indexed.node] == nil, "indexed span has duplicate access plans")
        p.indexedByNode[indexed.node] = indexed
        local item = {
            id = #p.calls,
            owner = indexed.owner,
            node = indexed.call,
            method = true,
            dynamic = true,
            indexed = indexed
        }
        p.calls[#p.calls + 1], p.callByNode[indexed.call] = item, item
    end

    local collect: function(any, any): nil
    collect = function(node: any, owner: any): nil
        if cst.isToken(node) or typeSyntax[node.kind] or graph.erased(node) then
            return
        end
        -- An annotation's arguments are metadata the checker read; main emits
        -- only the statement it annotates.
        if node.kind == "annotationArg" then
            return
        end
        local bodyOwner = p.byBody[node]
        if bodyOwner then
            owner = bodyOwner
        end
        registerindexed(indexedaccess.prepare(node, owner.id))
        if node.kind == "assignStmt" then
            for index, target in ipairs(node.targets) do
                registerindexed(indexedaccess.preparewrite(target, owner.id, node, index))
            end
        end
        local witness = p.scalartypes.witnesses[node]
        if witness then
            witness.owner = owner.id
            reference(witness.base.token, owner)
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = witness.call,
                definition = witness.target.definition,
                scalarWitness = witness
            }
            p.calls[#p.calls + 1], p.callByNode[witness.call] = item, item
            return
        end
        if node.kind == "isExpr"
            and not node.provenStatically
            and not node.refutedStatically
            and not (node.type and node.type.wherePredicate)
        then
            local origin = taggedvalues.recordOrigin(node.typeTestTarget)
            local declaration = origin and origin.deriveDeclaration
            if declaration and p.recordDecls[declaration] then
                local definition = need(declaration.name.definition, "record test lacks its checked declaration")
                local anchor = need(cst.firstToken(node), "record test lacks its source position")
                local expression: any = nil
                local token: any = nil
                if definition.filename == owner.scope.path then
                    local base = declaration.qualifiers and declaration.qualifiers[1] or declaration.name
                    token = {
                        kind = "name",
                        text = base.text,
                        line = anchor.line,
                        col = anchor.col,
                        offset = anchor.offset,
                        trivia = {},
                        definition = base.definition
                    }
                    reference(token, owner)
                    expression = {kind = "name", token = token, token}
                    if declaration.qualifiers and #declaration.qualifiers > 0 then
                        need(#declaration.qualifiers == 1, "record test has an unsupported qualified declaration")
                        expression = {
                            kind = "dotIndex",
                            obj = expression,
                            name = declaration.name,
                            expression,
                            declaration.name
                        }
                    end
                else
                    local foreign = need(
                        moduleNames[origin.moduleName],
                        "record test declaration is not in the program"
                    )
                    need(foreign.path == definition.filename, "record test crosses its checked module identity")
                    local members = {}
                    for member in (origin.runtimePath or declaration.name.text):gmatch("[%w_]+") do
                        members[#members + 1] = member
                    end
                    expression = {kind = "dotIndex", qualifiedModule = foreign.name, qualifiedMembers = members, anchor}
                    local site = {
                        id = #p.requires,
                        owner = owner.id,
                        node = expression,
                        module = foreign.name,
                        typeOnly = false,
                        target = foreign.chunk,
                        qualified = true
                    }
                    p.requires[#p.requires + 1], p.requireByNode[expression] = site, site
                end
                p.recordTests[
                    node
                ] = {
                    owner = owner.id,
                    origin = origin,
                    declaration = declaration,
                    expression = expression,
                    token = token
                }
            end
        end
        -- Checked builtin projections take precedence over legacy library
        -- tables. Ordinary qualified paths keep their unbound/module roots.
        local projection = builtinprojection(node)
        local qualified = (projection or node.kind == "dotIndex")
            and node.qualifiedModule
            and moduleNames[node.qualifiedModule]
        -- A chunk's qualified path into a module it does not hold is into
        -- the running program's, required by name where it is read.
        if p.chunk and not qualified and (projection or node.kind == "dotIndex") and node.qualifiedModule then
            qualifiedSite(owner, node, graph.coremodule(node.qualifiedModule), {builtin = projection, absent = true})
            return
        end
        if projection then
            need(qualified, "checked builtin projection module is missing: " .. projection.module)
        end
        if qualified then
            local root = node
            while root and root.kind == "dotIndex" do
                root = root.obj
            end
            local rootDefinition = root and root.kind == "name" and root.token and root.token.definition
            if root
                and (projection or root.kind == "name" and (rootDefinition == nil or rootDefinition.kind == "module"))
            then
                local item = {
                    id = #p.requires,
                    owner = owner.id,
                    node = node,
                    module = qualified.name,
                    typeOnly = false,
                    target = qualified.chunk,
                    qualified = true,
                    builtin = projection
                }
                p.requires[#p.requires + 1], p.requireByNode[node] = item, item
                local seen = loaded[currentChunk] or {}
                loaded[currentChunk] = seen
                local base: any = nil
                if projection then
                    local name = graph.libraryModule(projection.root)
                    local module = need(moduleNames[name], "checked builtin base module is missing: " .. name)
                    if not seen[name] then
                        seen[name] = eagerLoad(currentChunk, module, projection.token, false)
                    end
                    base = seen[name]
                end
                if not seen[node.qualifiedModule] then
                    seen[
                        node.qualifiedModule
                    ] = eagerLoad(currentChunk, qualified, projection and projection.token or root.token, false)
                end
                if projection then
                    local extension = seen[node.qualifiedModule]
                    local baseIndex, extensionIndex = initializerpositions(p, currentChunk.id, base, extension)
                    need(baseIndex > 0 and extensionIndex > 0, "checked builtin initializer is missing")
                    if baseIndex > extensionIndex then
                        local loads = p.qualifiedLoads[currentChunk.id]
                        table.remove(loads, baseIndex)
                        table.insert(loads, extensionIndex, base)
                    end
                    item.initializers = {
                        base = base,
                        extension = seen[node.qualifiedModule],
                        token = base.node[1],
                        extensionToken = seen[node.qualifiedModule].node[1],
                        owner = currentChunk.id
                    }
                end
                return
            end
        end
        -- Plain Lua library values retain their legacy implementation when
        -- the checker supplied no extension projection for this read.
        local libraryValue = graph.libraryValue(node)
        local valuesModule = libraryValue and graph.libraryModule(libraryValue)
        local values = valuesModule and moduleNames[valuesModule]
        if libraryValue and values then
            qualifiedSite(owner, node, valuesModule as string, {target = values.chunk, library = libraryValue})
            return
        end
        -- `for i, v in ipairs(t)` and `pairs(t)` are loop forms the profile lowers
        -- itself: the iterator is never called, so it is neither a reference nor a
        -- call.
        if node.kind == "forinStmt"
            and node.exprs
            and node.exprs[1]
            and node.exprs[1].kind == "call"
            and (node.exprs[1].resolvedGlobal == "ipairs" or node.exprs[1].resolvedGlobal == "pairs")
        then
            loopForms[node.exprs[1]] = true
        end
        -- Library intrinsics the core implements as operations (math.floor) are
        -- forms too: the global they name is never read, unless the call
        -- spreads `...` where its form cannot, calling the function's value.
        if node.kind == "call" and graph.coreLibraryCall(node) and not graphcalls.spreadsLibrary(node) then
            loopForms[node] = true
        end
        -- So are the library constants it folds (math.pi).
        if graph.coreLibraryField(node) then
            loopForms[node] = true
        end

        -- An affine local runs its record's destructor at
        -- scope exit, reached through the table the record's name holds: a
        -- synthetic reference per site, which capture analysis transports.
        local function cleanupToken(site: any, t: any, anchor: any): nil
            local inner = t and t.tag == "affine" and t.inner
            local origin = inner and (inner.origin or inner)
            local declaration = origin and origin.deriveDeclaration
            -- Cleanups that are not the record's own methods are functions
            -- the core's registry holds by their checked keys.
            local methods = declaration ~= nil and declaration.kind == "recordDecl" and declaration.name ~= nil
            for _, item in ipairs(t and t.cleanups or {}) do
                local record = tostring(item.name):match("^(.-)%.[%w_]+$")
                methods = methods and record == declaration.name.text
            end
            if not methods then
                if t and t.tag == "affine" and #(t.cleanups or {}) > 0 then
                    p.cleanupTokens[site] = p.cleanupTokens[site] or {}
                    p.cleanupTokens[site].registry = true
                    p.cleanupOwners[owner.id] = true
                end
                return
            end
            -- Another module's record: its table is the owned instance's
            -- metatable, which the cleanup reads.
            if declaration.name.definition and declaration.name.definition.filename ~= owner.scope.path then
                p.cleanupTokens[site] = p.cleanupTokens[site] or {}
                p.cleanupTokens[site][declaration] = {foreign = true, text = declaration.name.text}
                p.cleanupOwners[owner.id] = true
                return
            end
            local token: any = {
                kind = "name",
                text = declaration.name.text,
                line = anchor.line,
                col = anchor.col,
                offset = anchor.offset,
                trivia = {},
                definition = declaration.name.definition
            }
            reference(token, owner)
            p.cleanupTokens[site] = p.cleanupTokens[site] or {}
            p.cleanupTokens[site][declaration] = token
            p.cleanupOwners[owner.id] = true
        end

        if node.kind == "recordDecl" and node.inheritedDefaultNames and #node.inheritedDefaultNames > 0 then
            local tokens = {}
            for _, super in ipairs(node.supertypes or {}) do
                local resolved = super.resolvedSupertype
                local origin = resolved and (resolved.origin or resolved)
                local declaration = origin and origin.deriveDeclaration
                local definition = declaration and declaration.name and declaration.name.definition
                local foreign = origin and origin.moduleName and moduleNames[origin.moduleName]
                if super.interfaceName and definition and definition.filename ~= owner.scope.path and foreign then
                    -- Another module's interface: that module, required, and its
                    -- export by the interface's name.
                    tokens[
                        super.interfaceName
                    ] = {qualifiedModule = origin.moduleName, inheritFrom = declaration.name.text}
                elseif super.interfaceName and definition and definition.filename == owner.scope.path then
                    local token: any = {
                        kind = "name",
                        text = declaration.name.text,
                        line = node.name.line,
                        col = node.name.col,
                        offset = node.name.offset,
                        trivia = {},
                        definition = definition
                    }
                    reference(token, owner)
                    tokens[super.interfaceName] = token
                end
            end
            -- Each checked inherited member emits its own require, in order.
            -- Issue a distinct anchored site for each, rather than sharing the
            -- superinterface's site across multiple emitted operations.
            for _, taken in ipairs(node.inheritedDefaultNames) do
                local from = tokens[taken.from]
                if from and from.qualifiedModule then
                    local foreign = moduleNames[from.qualifiedModule]
                    local site = {
                        kind = "dotIndex",
                        qualifiedModule = foreign.name,
                        inheritFrom = from.inheritFrom,
                        inheritedDefault = taken,
                        cst.firstToken(node)
                    }
                    local item = {
                        id = #p.requires,
                        owner = owner.id,
                        node = site,
                        module = foreign.name,
                        typeOnly = false,
                        target = foreign.chunk,
                        qualified = true
                    }
                    p.requires[#p.requires + 1], p.requireByNode[site] = item, item
                    tokens[taken] = site
                end
            end
            p.inheritTokens[node] = tokens
        end
        if ownedcallables.taking(node) then
            local plan = ownedcallables.prepare(p, node, owner)
            p.callables[node] = plan
            local site = {
                id = #p.calls,
                owner = owner.id,
                node = plan.call,
                definition = plan.target.definition,
                callable = plan
            }
            p.calls[#p.calls + 1], p.callByNode[plan.call] = site, site
            local load = {kind = "qualifiedLoad", qualifiedModule = ownedcallables.MODULE, cst.firstToken(node)}
            local module = need(moduleNames[ownedcallables.MODULE], "consuming callable module is missing")
            local loader = qualifiedload(owner, module, load)
            loader.callable = plan
            plan.loader = loader
            for _, captured in ipairs(plan.captures) do
                cleanupToken(node, captured.type, captured.token)
            end
        end
        if derivedrecipes.derived(node) then
            local plan = derivedrecipes.prepare(p, node, owner)
            p.derives[node] = plan
            for _, made in ipairs(derivedrecipes.steps(plan)) do
                local site = {
                    id = #p.calls,
                    owner = owner.id,
                    node = made.call,
                    definition = made.target.definition,
                    derived = plan
                }
                p.calls[#p.calls + 1], p.callByNode[made.call] = site, site
            end
            local load = {kind = "qualifiedLoad", qualifiedModule = derivedrecipes.MODULE, cst.firstToken(node)}
            local module = need(moduleNames[derivedrecipes.MODULE], "derive factory module is missing")
            plan.loader = qualifiedload(owner, module, load)
            plan.loader.derived = plan
        end
        if node.kind == "localStmt" and node.automaticOwners then
            for index, automatic in pairs(node.automaticOwners) do
                local anchor = node.names and node.names[index]
                if anchor then
                    cleanupToken(node, automatic.type, anchor)
                end
            end
        end
        -- `drop(v)` of a value no local owner holds (a taken parameter, a
        -- fresh result) runs v's cleanups itself, from this site.
        if node.kind == "call"
            and node.ownershipIntrinsic == "drop"
            and next(node.ownerCleanups or {}) ~= nil
            and cst.firstToken(node)
        then
            cleanupToken(node, node.ownerType, cst.firstToken(node))
        end
        -- `R(...)` is lowered through its construction wrapper.
        local built = construction.of(node)
        -- `R(...)` of a plain record builds its value in place, so the
        -- record's name is a type use there, not a read of its runtime value.
        if built and built.call.recordFields and not built.call.constructorEntry then
            loopForms[built.call] = true
            -- Construction reads the record's table, its instances' metatable:
            -- by its name, or through the module that declares it.
            if built.call.obj and built.call.obj.kind == "name" then
                reference(built.call.obj.token, owner)
            elseif built.call.obj then
                collect(built.call.obj, owner)
            end
        end
        -- `R(...)` with a constructor calls it, the fresh instance first,
        -- through the table R's name holds.
        local entry = built and built.call.constructorEntry
        local declaration = entry and entry.declaration
        local foreignRecord = declaration
            and declaration.coreDefinition
            and inlineRecords[declaration]
            and inlineRecords[declaration].definition.filename ~= owner.scope.path
        if foreignRecord then
            -- A record another module declares is that module's export:
            -- `m.R(...)` reads R's table through m's, which the caller
            -- references as it does any value.
            need(
                built.call.obj and built.call.obj.kind ~= "name",
                "another module's record is constructed through its module"
            )
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = built.call,
                definition = declaration.coreDefinition,
                construct = true,
                classExpr = built.call.obj
            }
            p.calls[#p.calls + 1], p.callByNode[built.call] = item, item
            loopForms[built.call] = true
            collect(built.call.obj, owner)
        elseif declaration and declaration.coreDefinition and inlineRecords[declaration] then
            local base = inlineRecords[declaration]
            local classToken: any = {
                kind = "name",
                text = base.text,
                line = base.line,
                col = base.col,
                offset = base.offset,
                trivia = {},
                definition = base.definition
            }
            reference(classToken, owner)
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = built.call,
                definition = declaration.coreDefinition,
                construct = true,
                classToken = classToken
            }
            p.calls[#p.calls + 1], p.callByNode[built.call] = item, item
            loopForms[built.call] = true
        end
        if node.kind == "name" and not graphcalls.discardTarget(node) then
            reference(node.token, owner)
        elseif node.kind == "recordDecl" and node.qualifiers and node.qualifiers[1].definition then
            -- `record t.R` stores its table in the table `t` names.
            reference(node.qualifiers[1], owner)
        elseif node.kind == "funcname" then
            -- A qualified declaration reads its receiver, whereas a plain
            -- function declaration introduces its own checked binding.
            reference(node.base, owner)
        end
        local loader = node.kind == "call" and node.runtimeLoader == "require" and not graph.dynamicRequire(node)
        if graph.dynamicRequire(node) then
            p.dynamicRequires = true
        end
        if loader then
            local scalarImport = p.scalartypes.imports[node]
            local name = scalarImport and scalartypeof.MODULE
                or node.requiredModule and graph.coremodule(node.requiredModule)
            local target = name and moduleNames[name]
            local item = {
                id = #p.requires,
                owner = owner.id,
                node = node,
                module = name,
                typeOnly = node.typeOnlyRequire == true,
                target = target and target.chunk or nil,
                scalarImport = scalarImport
            }
            -- A core call module loads nothing; its binding is nil.
            item.corecalls = graph.corecallmodule(node.requiredModule) or nil
            -- A module the program does not carry (`ffi`, which no source
            -- provides) is required by name when the call runs, so it fails
            -- there as Lua's require does.
            if target == nil
                and not item.typeOnly
                and not item.corecalls
                and not scalarImport
                and type(node.requiredModule) == "string"
            then
                item.module, item.absent = node.requiredModule, true
                p.dynamicRequires = true
            end
            p.requires[#p.requires + 1], p.requireByNode[node] = item, item
        end
        local intrinsic = node.kind == "call" and node.ownershipIntrinsic
        if intrinsic then
            -- The checker resolves the reserved callee before ordinary name
            -- inference. Its marker is a dependency, not a fabricated binding.
            p.intrinsics[#p.intrinsics + 1] = {id = #p.intrinsics, owner = owner.id, node = node, operation = intrinsic}
        end
        -- pcall is a library form whose name is never read, but it calls its
        -- first argument, so it is a callsite all the same.
        local protected = node.kind == "call"
            and (graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall")
        -- A library function the core does not call itself, called by its
        -- name, is called through its value (`nupp.runtime.libraryvalues`).
        local throughValue = node.kind == "call"
            and node.obj.kind == "name"
            and (
                graph.libraryValue(node.obj) ~= nil
                and moduleNames[graph.libraryModule(graph.libraryValue(node.obj) as string)] ~= nil
                or chunkGlobal(p, node.obj) and graph.coreLibraryCall(node) == nil
            )
        if node.kind == "call"
            and node.obj.kind == "name"
            and not throughValue
            and not loader
            and not intrinsic
            and (not loopForms[node] or protected)
        then
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node,
                definition = node.obj.token.definition,
                protected = protected or nil
            }
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A call through anything but a name (`R.f(...)`, `t[i](x)`, `f()()`,
        -- a cast) calls the value it evaluates, resolved when it runs.
        -- So does a library call taking a function it calls back, which is
        -- that function's callsite: table.sort's comparator, and gsub's
        -- function replacement, in `s:gsub(p, f)` form too.
        if node.kind == "call"
            and (node.obj.kind ~= "name" or throughValue)
            and not loader
            and not intrinsic
            and (not loopForms[node] or graph.callbackArgument(node) ~= nil)
            or node.kind == "methodCall" and graph.callbackArgument(node) ~= nil
        then
            local item = {id = #p.calls, owner = owner.id, node = node, field = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A chunk's library call through a global (`print(x)`, `io.write(s)`)
        -- calls what its environment holds: the core's own operation while
        -- that is the function the program started with, else a call of it.
        local guard = p.chunk and p.chunkBuiltins ~= nil and node.kind == "call" and guardedLibrary(p, node)
        if guard then
            local root = node.obj.kind == "dotIndex" and node.obj.obj or node.obj
            p.globals[root.token] = p.globals[root.token] or environmentRead(root.token, owner)
            p.guarded[
                node
            ] = {
                library = guard,
                root = root,
                builtins = chunkLocalRead(cst.firstToken(node), owner, p.builtins, p.chunkBuiltins)
            }
            local item = {id = #p.calls, owner = owner.id, node = node, field = true, guarded = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A generic `for` over anything but ipairs, pairs or gmatch calls its
        -- iterator each step: the statement is that call's callsite.
        if node.kind == "forinStmt" and graph.genericiterator(node) then
            local item = {id = #p.calls, owner = owner.id, node = node, iterator = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A record method call reaches its method through the table the
        -- record's name holds, so the caller references that binding: a
        -- synthetic token per call, which capture analysis then transports.
        local method = node.kind == "methodCall" and node.name and node.name.definition
        local target = method and p.functionsByDefinition[method]
        local base = target and target.node.kind == "funcStmt" and target.node.name.method and target.node.name.base
            or target
            and target.node.kind == "inlineMethod"
            and not target.node.inlineStatic
            and inlineRecords[target.node]
            or nil
        -- `function t.R:m()` names its record through the table `t`, which
        -- holds it: its table is the receiver's metatable, as for another
        -- module's record.
        local nested = false
        if target and target.node.kind == "funcStmt" and target.node.name.method then
            for _, part in ipairs(target.node.name) do
                nested = nested or cst.isToken(part) and part.kind == "."
            end
        end
        if base and (nested or base.definition.filename ~= owner.scope.path) then
            -- Another module's record: its table is the receiver's metatable.
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node,
                definition = method,
                method = true,
                metatable = true
            }
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        elseif base then
            local classToken: any = {
                kind = "name",
                text = base.text,
                line = node.name.line,
                col = node.name.col,
                offset = node.name.offset,
                trivia = {},
                definition = base.definition
            }
            reference(classToken, owner)
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node,
                definition = method,
                method = true,
                classToken = classToken
            }
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        elseif node.kind == "methodCall"
            and node.name
            and target == nil
            and graph.coreLibraryCall(node) == nil
            and p.callByNode[node] == nil
        then
            -- A method the program holds no body for, as a declared type's:
            -- read from the receiver when the call runs.
            local item = {id = #p.calls, owner = owner.id, node = node, method = true, dynamic = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A parenthesized literal is registered at the literal itself, which is
        -- what lowering reads once it has looked through the parentheses.
        local constant = node.kind ~= "paren" and literal(node)
        if constant then
            constant.id, constant.owner, constant.node = #p.constants, owner.id, node
            p.constants[#p.constants + 1], p.byNode[node] = constant, constant
            owner.constants[#owner.constants + 1] = constant.id
            return
        end
        for _, child in ipairs(node) do
            if not (intrinsic or loader or loopForms[node]) or child ~= node.obj then
                collect(child, owner)
            end
        end
        if node.kind == "localStmt"
            and node.isConst
            and topLevel[node]
            and owner.kind == "module"
            and not node.pattern
        then
            for index, token in ipairs(node.names) do
                local b = need(p.byDefinition[token.definition], "const declaration missing")
                local constant = node.exprs and p.byNode[node.exprs[index]]
                if constant and not b.definition.reassigned then
                    b.initializer = node.exprs[index]
                    p.immutable[b.definition] = constant
                end
            end
        end
    end
    local stringbase = moduleNames[graph.libraryModule("string")]
    for _, module in ipairs(p.modules) do
        currentChunk = p.owners[module.chunk + 1]
        if stringbase and stringbase ~= module and graph.mayTakeLibraryValue(module.parsed.root) then
            local seen = loaded[currentChunk] or {}
            loaded[currentChunk] = seen
            seen[stringbase.name] = eagerLoad(currentChunk, stringbase, cst.firstToken(module.parsed.root), true)
        end
        collect(module.parsed.root, currentChunk)
    end
    for _, b in ipairs(p.bindings) do
        local required = b.definition.requiredModule
        -- A chunk's local of a module the running program holds is the
        -- value its require answers by name.
        local foreign = p.chunk and required and moduleNames[importmodule(p, b)] == nil
        if required and not graph.corecallmodule(required) and not foreign then
            local target = moduleNames[importmodule(p, b)]
            -- Recorded rather than raised, as an unresolved reference is.
            if target == nil then
                p.unresolved[
                    #p.unresolved + 1
                ] = {
                    owner = b.owner,
                    token = b.token,
                    location = "required checked module " .. required .. " (not carried)"
                }
            else
                p.imports[#p.imports + 1] = {binding = b.id, target = target.chunk, projection = b.builtinImport}
            end
        end
    end

    -- An image carrying the module behind `warn` and the finalizers loads it
    -- as its entry starts, so it is installed before any finalizer runs: one
    -- eager require, as a qualified path's.
    local warns = moduleNames[graph.WARN_MODULE]
    local entry = p.modules[#p.modules]
    if warns and entry and warns ~= entry then
        eagerLoad(p.owners[entry.chunk + 1], warns, cst.firstToken(entry.parsed.root), true)
    end
    -- A module a require cycle can re-enter publishes each function it exports
    -- as a forwarder as it starts, as main does: one checked factory call per
    -- function, from one hidden load of the factory's module.
    local cyclic = forwardedexports.cyclic(modules)
    for _, module in ipairs(p.modules) do
        if cyclic[module.name] then
            local chunk = p.owners[module.chunk + 1]
            local factory = need(moduleNames[forwardedexports.MODULE], "export forwarding module is missing")
            local plan = forwardedexports.prepare(p, chunk)
            p.forwards[chunk.id] = plan
            for _, item in ipairs(plan.functions) do
                local site = {
                    id = #p.calls,
                    owner = chunk.id,
                    node = item.call,
                    definition = item.target.definition,
                    forward = plan
                }
                p.calls[#p.calls + 1], p.callByNode[item.call] = site, site
            end
            local load = {
                kind = "qualifiedLoad",
                qualifiedModule = forwardedexports.MODULE,
                cst.firstToken(plan.functions[1].stat)
            }
            plan.loader = qualifiedload(chunk, factory, load)
            plan.loader.forward = plan
        end
    end
    -- Capture ownership mode is independent of its transported representation.
    -- Only shared mutable bindings and recursive declaration self-references
    -- require a cell; a recursive const function still needs publication after
    -- its closure has captured that cell.
    local storage = storagePlan(p)
    for _, b in ipairs(p.bindings) do
        b.storage = storage[b.definition]
    end
    for _, owner in ipairs(p.owners) do
        for _, item in ipairs(owner.captures) do
            item.storage = p.bindings[item.binding + 1].storage
        end
    end
    verify(p)

    return p
end

export function verify(p: any): boolean
    need(p.owners and p.modules and p.bindings and p.constants, "catalog required")
    need(p.entry ~= nil and p.owners[p.entry + 1] and p.owners[p.entry + 1].kind == "module", "invalid module entry")
    local modules = {}
    for _, module in ipairs(p.modules) do
        local owner = need(p.owners[module.chunk + 1], "invalid initializer reference")
        need(
            owner.kind == "module" and owner.node == module.parsed.root and owner.body == module.parsed.root,
            "initializer must own checked module root"
        )
        need(
            owner.scope.name == module.name and owner.scope.path == module.path and not modules[module.name],
            "module identity mismatch"
        )
        modules[module.name] = owner
    end
    local currentScalarImports, currentScalarWitnesses = {}, {}
    for _, module in ipairs(p.modules) do
        for _, imported in ipairs(scalartypeof.imports(module.parsed.root)) do
            currentScalarImports[imported.loader] = imported
            for _, witness in ipairs(imported.sites) do
                currentScalarWitnesses[witness.node] = witness
            end
        end
    end
    for loader, imported in pairs(p.scalartypes.imports) do
        local current = need(currentScalarImports[loader], "scalar import no longer has exclusive checked witnesses")
        need(
            imported.loader == loader
            and imported.definition == current.definition
            and p.scalartypes.definitions[imported.definition] == imported
            and #imported.sites == #current.sites,
            "scalar import declaration differs"
        )
    end
    for loader in pairs(currentScalarImports) do
        need(p.scalartypes.imports[loader], "scalar import is missing from the catalog")
    end
    for node, witness in pairs(p.scalartypes.witnesses) do
        local current = need(currentScalarWitnesses[node], "scalar witness no longer has its checked identity")
        local target = witness.target
        need(
            witness.node == node
            and witness.base == current.base
            and witness.definition == current.definition
            and witness.subject == current.subject
            and witness.kind == current.kind
            and p.scalartypes.definitions[witness.definition]
            and p.owners[witness.owner + 1],
            "scalar witness identity differs"
        )
        need(
            target
            and p.owners[target.id + 1] == target
            and target.kind == "function"
            and target.scope.name == scalartypeof.MODULE
            and target.name == scalartypeof.MEMBER
            and p.functionsByDefinition[target.definition] == target,
            "scalar factory declaration differs"
        )
        local call = witness.call
        need(
            call.kind == "call"
            and call.token == cst.firstToken(node)
            and call.obj.kind == "name"
            and call.obj.token.definition == target.definition
            and call.calleeType == target.signature
            and #call.args.exprs == 1
            and call.args.exprs[1].kind == "string"
            and call.args.exprs[1].token.text == string.format("%q", witness.kind)
            and call.args.exprs[1].inferredType == target.signature.params[1],
            "scalar factory argument differs"
        )
        local site = need(p.callByNode[call], "scalar witness lacks its checked callsite")
        need(
            site.node == call
            and p.calls[site.id + 1] == site
            and site.scalarWitness == witness
            and site.owner == witness.owner
            and site.definition == target.definition,
            "scalar witness callsite differs"
        )
        graph.invokeContract(target, call)
    end
    for node in pairs(currentScalarWitnesses) do
        need(p.scalartypes.witnesses[node], "scalar witness is missing from the catalog")
    end
    for definition, b in pairs(p.byDefinition) do
        need(b.definition == definition and p.bindings[b.id + 1] == b, "stale binding identity map")
    end
    for definition, owner in pairs(p.functionsByDefinition) do
        need(owner.definition == definition and p.owners[owner.id + 1] == owner, "stale function identity map")
    end
    for node, constant in pairs(p.byNode) do
        need(constant.node == node and p.constants[constant.id + 1] == constant, "stale constant identity map")
    end
    for definition, external in pairs(p.externalsByDefinition) do
        need(
            external.definition == definition and p.externals[external.id + 1] == external,
            "stale external identity map"
        )
    end
    for index, external in ipairs(p.externals) do
        need(
            external.id == index - 1 and p.externalsByDefinition[external.definition] == external,
            "external identity mismatch"
        )
        need(
            external.token == external.definition.token
            and external.path == external.definition.filename
            and not p.byDefinition[external.definition],
            "external declaration mismatch"
        )
        for _, module in ipairs(p.modules) do
            need(module.path ~= external.path, "external declaration belongs to a catalog module")
        end
    end
    local requireNodes = {}
    for index, item in ipairs(p.requires) do
        local node = item.node
        need(item.id == index - 1 and p.owners[item.owner + 1], "invalid require callsite owner")
        if item.qualified then
            if item.callable then
                ownedcallables.verify(p, item.callable)
            end
            if item.forward then
                forwardedexports.verify(p, item.forward)
            end
            if item.derived then
                derivedrecipes.verify(p, item.derived)
            end
            -- A chunk's absent module initializes in the running program.
            if item.builtin and not item.absent then
                local current = builtinprojection(node)
                local original = item.builtin
                need(
                    current
                    and current.root == original.root
                    and graph.coremodule(current.module) == item.module
                    and current.module == original.module
                    and current.token == original.token
                    and current.definition == original.definition
                    and current.declaration == original.declaration
                    and current.loader == original.loader
                    and #original.members == 1
                    and original.members[1] == "value"
                    and item.library == nil,
                    "checked builtin projection anchors changed"
                )
                local initializers = need(item.initializers, "checked builtin initializers are missing")
                local base, extension = initializers.base, initializers.extension
                local owner = modules[p.owners[item.owner + 1].scope.name]
                need(
                    owner
                    and initializers.owner == owner.id
                    and base
                    and extension
                    and base ~= extension
                    and base.module == graph.libraryModule(current.root)
                    and extension.module == graph.coremodule(current.module)
                    and base.owner == owner.id
                    and extension.owner == owner.id
                    and base.eager == true
                    and extension.eager == true
                    and base.node[1] == initializers.token
                    and extension.node[1] == initializers.extensionToken
                    and p.requires[base.id + 1] == base
                    and p.requires[extension.id + 1] == extension,
                    "checked builtin initializer anchors changed"
                )
                local baseIndex, extensionIndex = initializerpositions(p, owner.id, base, extension)
                need(
                    baseIndex > 0 and extensionIndex > baseIndex,
                    "checked builtin base must initialize before its extension"
                )
            end
            need(
                (
                    item.library ~= nil and (node.kind == "name" or node.kind == "dotIndex")
                    or (
                        node.kind == "dotIndex"
                        or item.builtin and (node.kind == "name" or node.kind == "call")
                        or item.eager and node.kind == "qualifiedLoad"
                        or item.callable and node.kind == "qualifiedLoad"
                        or item.forward and node.kind == "qualifiedLoad"
                        or item.derived and node.kind == "qualifiedLoad"
                    )
                    and node.qualifiedModule ~= nil
                    and graph.coremodule(node.qualifiedModule) == item.module
                )
                and not requireNodes[node],
                "qualified path lacks its checked module"
            )
            need(p.requireByNode[node] == item and not item.typeOnly, "require callsite metadata mismatch")
        else
            need(
                node.kind == "call" and node.runtimeLoader == "require" and not requireNodes[node],
                "require callsite lacks checked loader identity"
            )
            need(
                p.requireByNode[node] == item
                and item.scalarImport == p.scalartypes.imports[node]
                and item.module == (
                    item.scalarImport and scalartypeof.MODULE
                    or node.requiredModule and graph.coremodule(node.requiredModule)
                )
                and item.typeOnly == (node.typeOnlyRequire == true),
                "require callsite metadata mismatch"
            )
        end
        local target = item.module and modules[item.module]
        need(item.target == (target and target.id or nil), "require callsite target mismatch")
        requireNodes[node] = true
    end
    for node, item in pairs(p.requireByNode) do
        need(item.node == node and p.requires[item.id + 1] == item, "stale require callsite map")
    end
    local referenceOwners = {}
    for _, reference in ipairs(p.externalReferences) do
        local external = need(p.externals[reference.external + 1], "invalid external reference")
        need(
            p.owners[reference.owner + 1] and reference.token.definition == external.definition,
            "external reference identity mismatch"
        )
        referenceOwners[reference.token] = reference.owner
    end
    local intrinsicNodes = {}
    for index, intrinsic in ipairs(p.intrinsics) do
        need(intrinsic.id == index - 1 and p.owners[intrinsic.owner + 1], "invalid intrinsic owner")
        need(
            intrinsic.node.kind == "call"
            and intrinsic.node.ownershipIntrinsic == intrinsic.operation
            and type(intrinsic.operation) == "string"
            and not intrinsicNodes[intrinsic.node],
            "checked intrinsic identity mismatch"
        )
        intrinsicNodes[intrinsic.node] = true
    end
    local constantOwners = {}
    for body, owner in pairs(p.byBody) do
        need(owner.body == body and p.owners[owner.id + 1] == owner, "missing reserved owner")
    end
    local storage = storagePlan(p)
    for index, b in ipairs(p.bindings) do
        need(b.id == index - 1 and p.owners[b.owner + 1], "invalid binding owner")
        -- A variadic pack has no declaration: its parameter node keys it.
        need(
            b.pack and b.definition == b.token and b.definition.vararg and p.byDefinition[b.definition] == b
            or b.definition == b.token.definition
            and b.definition.token == b.token
            and p.byDefinition[b.definition] == b,
            "binding identity mismatch"
        )
        need(b.mode == (b.pack and "value" or bindingMode(b.definition)), "binding mode mismatch")
        need(b.storage == storage[b.definition], "binding storage mismatch")
    end
    for index, owner in ipairs(p.owners) do
        need(owner.id == index - 1 and p.byBody[owner.body] == owner, "owner identity mismatch")
        need(modules[owner.scope.name] ~= nil, "owner module is missing")
        if owner.kind == "function" then
            need(owner.parent ~= nil and owner.parent < owner.id and owner.parent >= 0, "invalid lexical parent")
            need(p.owners[owner.parent + 1].scope == owner.scope, "parent crosses modules")
            need(
                not owner.definition or p.functionsByDefinition[owner.definition] == owner,
                "function declaration identity mismatch"
            )
            need(
                owner.body.signatureType == owner.signature
                and (owner.node == owner.body or owner.node.body == owner.body),
                "checked function identity mismatch"
            )
        else
            need(
                owner.kind == "module" and modules[owner.scope.name] == owner and owner.parent == nil,
                "invalid initializer owner"
            )
        end
        for definition, item in pairs(owner.captureByDefinition) do
            need(item.definition == definition and owner.captures[item.id + 1] == item, "stale capture identity map")
        end
        for slot, item in ipairs(owner.captures) do
            local b = need(p.bindings[item.binding + 1], "capture binding is missing")
            need(
                item.id == slot - 1
                and item.definition == b.definition
                and owner.captureByDefinition[b.definition] == item,
                "capture identity mismatch"
            )
            need(item.storage == b.storage, "capture storage mismatch")
            need(item.sourceOwner == owner.parent, "capture must cross one lexical parent")
            local parent = need(p.owners[item.sourceOwner + 1], "capture parent missing")
            if item.sourceKind == "local" then
                need(b.owner == parent.id and item.source == b.id, "invalid local capture source")
            else
                local source = parent.captures[item.source + 1]
                need(
                    item.sourceKind == "capture" and source and source.binding == b.id,
                    "invalid forwarded capture source"
                )
            end
            need(item.recursive == (owner.definition == b.definition), "recursive capture identity mismatch")
            if item.mode == "take" or item.mode == "borrow" then
                need(
                    item.ownership and item.ownership.outer.definition == b.definition,
                    "ownership capture identity mismatch"
                )
                local list = item.mode == "take" and owner.body.takenCaptures or owner.body.borrowCaptures
                local found = false
                for _, checked in ipairs(list or {}) do
                    found = found or checked == item.ownership
                end
                need(found, "ownership capture lacks checked contract")
                need(
                    item.inner == (item.ownership.inner and item.ownership.inner.definition or nil),
                    "taken binding identity mismatch"
                )
            else
                need(item.mode == b.mode, "invalid capture mode")
            end
        end
        for _, id in ipairs(owner.constants) do
            need(p.constants[id + 1] and p.constants[id + 1].owner == owner.id, "invalid owner constant reference")
            need(not constantOwners[id], "duplicate owner constant reference")
            constantOwners[id] = true
        end
    end
    for _, imported in ipairs(p.imports) do
        local b = need(p.bindings[imported.binding + 1], "invalid import binding")
        local target = need(p.owners[imported.target + 1], "invalid import initializer")
        need(
            target.kind == "module"
            and imported.projection == b.builtinImport
            and importmodule(p, b) == target.scope.name,
            "checked import target mismatch"
        )
    end
    for _, reference in ipairs(p.references) do
        local b = need(p.bindings[reference.binding + 1], "invalid lexical reference")
        local owner = need(p.owners[reference.owner + 1], "invalid reference owner")
        need(reference.token.definition == b.definition, "reference declaration identity mismatch")
        referenceOwners[reference.token] = reference.owner
        local captured = owner.captureByDefinition[b.definition]
        need(reference.role == (b.mode == "type" and "type" or "value"), "reference role mismatch")
        need(
            reference.role == "type" or owner.id == b.owner or captured and owner.captures[captured.id + 1] == captured,
            "reference lacks capture transport"
        )
    end
    need(type(p.calls) == "table", "invalid callsite array")
    local callCount = 0
    for index in pairs(p.calls) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #p.calls,
            "invalid callsite array index"
        )
        callCount = callCount + 1
    end
    need(callCount == #p.calls, "incomplete callsite array")
    for declaration, tokens in pairs(p.inheritTokens) do
        local binding = p.byDefinition[declaration.name.definition]
        for _, taken in ipairs(declaration.inheritedDefaultNames or {}) do
            local from = tokens[taken.from]
            if from and from.qualifiedModule then
                local token = tokens[taken]
                local site = token and p.requireByNode[token]
                need(
                    site
                    and site.node == token
                    and binding
                    and site.owner == binding.owner
                    and site.module == graph.coremodule(from.qualifiedModule)
                    and token.inheritedDefault == taken
                    and token.inheritFrom == from.inheritFrom
                    and cst.firstToken(token) == cst.firstToken(declaration),
                    "foreign inherited default lacks its checked require site"
                )
            end
        end
    end
    for node, item in pairs(p.recordTests) do
        need(
            node.kind == "isExpr"
            and taggedvalues.recordOrigin(node.typeTestTarget) == item.origin
            and item.origin.deriveDeclaration == item.declaration
            and p.recordDecls[item.declaration]
            and p.owners[item.owner + 1],
            "record test declaration identity mismatch"
        )
        if item.token then
            local base = item.declaration.qualifiers and item.declaration.qualifiers[1] or item.declaration.name
            need(
                referenceOwners[item.token] == item.owner and item.token.definition == base.definition,
                "record test lacks its checked class reference"
            )
            local expression = item.expression
            if item.declaration.qualifiers and #item.declaration.qualifiers > 0 then
                need(
                    expression.kind == "dotIndex" and expression.name == item.declaration.name,
                    "record test class expression mismatch"
                )
                expression = expression.obj
            end
            need(expression.kind == "name" and expression.token == item.token, "record test class expression mismatch")

        else
            local site = p.requireByNode[item.expression]
            need(
                site and site.owner == item.owner and site.module == item.origin.moduleName,
                "record test lacks its checked module reference"
            )
            need(
                item.expression.qualifiedModule == item.origin.moduleName
                and table.concat(
                    item.expression.qualifiedMembers,
                    "."
                ) == (item.origin.runtimePath or item.declaration.name.text),
                "record test module expression mismatch"
            )

        end
    end
    for index, item in ipairs(p.calls) do
        local node = item.node
        need(item.id == index - 1 and p.owners[item.owner + 1], "invalid callsite owner")
        if item.indexed then
            local access = item.indexed
            need(
                p.indexedByNode[access.node] == access
                and p.callByNode[node] == item
                and node == access.call
                and item.method
                and item.dynamic
                and item.definition == nil,
                "indexed span callsite identity mismatch"
            )
            indexedaccess.verify(access, access.node, item.owner)
        elseif item.callable then
            ownedcallables.verify(p, item.callable)
        elseif item.forward then
            forwardedexports.verify(p, item.forward)
        elseif item.derived then
            derivedrecipes.verify(p, item.derived)
        elseif item.scalarWitness then

            local witness = item.scalarWitness
            need(
                p.scalartypes.witnesses[witness.node] == witness
                and node == witness.call
                and p.callByNode[node] == item
                and item.definition == witness.target.definition
                and item.owner == witness.owner
                and referenceOwners[witness.base.token] == item.owner,
                "scalar callsite lacks its checked source witness"
            )
        elseif item.method and item.dynamic then
            need(
                node.kind == "methodCall"
                and p.callByNode[node] == item
                and item.definition == nil
                and p.functionsByDefinition[node.name.definition] == nil,
                "dynamic method callsite identity mismatch"
            )
        elseif item.method then
            need(
                node.kind == "methodCall" and p.callByNode[node] == item and node.name.definition == item.definition,
                "method callsite identity mismatch"
            )
            need(
                item.metatable or referenceOwners[item.classToken] == item.owner,
                "method callsite does not belong to its checked owner"
            )
        elseif item.iterator then
            need(
                node.kind == "forinStmt"
                and graph.genericiterator(node)
                and p.callByNode[node] == item
                and item.definition == nil,
                "iterator callsite identity mismatch"
            )
        elseif item.construct then
            need(
                node.kind == "call"
                and p.callByNode[node] == item
                and node.constructorEntry
                and node.constructorEntry.declaration.coreDefinition == item.definition,
                "construction callsite identity mismatch"
            )
            need(
                item.classExpr or referenceOwners[item.classToken] == item.owner,
                "construction callsite does not belong to its owner"
            )
        elseif item.field then
            need(
                (node.kind == "call" and node.obj.kind ~= "name"
                -- A library function called by its name through its value.
                or node.kind == "call" and graph.libraryValue(node.obj) ~= nil
                or node.kind == "call" and chunkGlobal(p, node.obj) and graph.coreLibraryCall(node) == nil
                or item.guarded == true and p.guarded[node] ~= nil
                or node.kind == "methodCall"
                and graph.callbackArgument(node) ~= nil)
                and p.callByNode[node] == item
                and item.definition == nil
                and not node.runtimeLoader
                and not node.ownershipIntrinsic,
                "field callsite identity mismatch"
            )
        else
            need(
                node.kind == "call"
                and node.obj.kind == "name"
                and not node.runtimeLoader
                and not node.ownershipIntrinsic,
                "callsite lacks ordinary checked call identity"
            )
            need(
                p.callByNode[node] == item and node.obj.token.definition == item.definition,
                "callsite declaration identity mismatch"
            )
            need(
                item.protected or referenceOwners[node.obj.token] == item.owner,
                "callsite does not belong to its checked owner"
            )
        end
    end
    for _, plan in pairs(p.callables) do
        ownedcallables.verify(p, plan)
    end
    for _, plan in pairs(p.forwards) do
        forwardedexports.verify(p, plan)
    end
    for _, plan in pairs(p.derives) do
        derivedrecipes.verify(p, plan)
    end
    for node, access in pairs(p.indexedByNode) do
        local site = need(p.callByNode[access.call], "indexed span lacks its issued callsite")
        need(site.indexed == access, "indexed span callsite points to another operator")
        indexedaccess.verify(access, node, site.owner)
    end
    for node, item in pairs(p.callByNode) do
        need(item.node == node and p.calls[item.id + 1] == item, "stale callsite map")
    end
    for index, constant in ipairs(p.constants) do
        need(constantOwners[index - 1], "constant missing from owner")
        need(
            constant.id == index - 1 and p.owners[constant.owner + 1] and p.byNode[constant.node] == constant,
            "invalid constant identity"
        )
        local expected = need(literal(constant.node), "constant no longer literal")
        need(
            expected.kind == constant.kind and expected.bytes == constant.bytes and expected.text == constant.text,
            "constant payload mismatch"
        )
    end
    for definition, constant in pairs(p.immutable) do
        local b = need(p.byDefinition[definition], "immutable binding missing")
        need(
            definition.constant and not definition.reassigned and p.owners[b.owner + 1].kind == "module",
            "mutable initializer cannot be substituted"
        )
        need(
            p.constants[constant.id + 1] == constant and constant.owner == b.owner and b.initializer == constant.node,
            "immutable constant reference mismatch"
        )
    end

    return true
end

export function select(p: any, moduleName: string, name: string): any
    verify(p)
    local selected
    for _, owner in ipairs(p.owners) do
        if owner.kind == "function" and owner.scope.name == moduleName and owner.name == name then
            need(selected == nil, "ambiguous selected function")
            selected = owner
        end
    end

    return need(selected, "missing checked function")
end

-- One owner's graph from a verified catalog whose external references and
-- intrinsics the caller has established for this owner.
local function ownerGraph(p: any, owner: any, profile: any): any
    need(p.owners[owner.id + 1] == owner, "foreign function owner")
    graph.checking(owner.scope and owner.scope.path)
    -- A profile may give a function that acquires cleanups its own variant.
    local chosen = profile.forOwner and profile.forOwner(p, owner) or profile
    local g = lower.functionGraph(owner, {program = p}, chosen)
    g.name, g.module, g.path, g.programOwner = owner.name, owner.scope.name, owner.scope.path, owner.id

    return g
end

export function functionGraph(p: any, owner: any, profile: any): any
    verify(p)
    need(p.owners[owner.id + 1] == owner, "foreign function owner")
    for _, item in ipairs(p.unresolved) do
        need(item.owner ~= owner.id, "unresolved executable reference " .. item.location)
    end
    for _, reference in ipairs(p.externalReferences) do
        need(reference.owner ~= owner.id, "external execution bindings are not established")
    end
    for _, intrinsic in ipairs(p.intrinsics) do
        need(
            intrinsic.owner ~= owner.id or executable(intrinsic.node),
            "intrinsic execution is not established: " .. intrinsic.operation
        )
    end

    return ownerGraph(p, owner, profile)
end

local function explicitOperands(op: string): nil
    local described = opcodes.describe(op)
    if described then
        need(
            #described.windows == 0 and not described.frame,
            "core program requires explicit SSA operands instead of implicit windows/frame reads: " .. op
        )
    end
end

-- Every checked owner has exactly one graph. This verifies program references;
-- capture storage modes, runtime roots and execution admission remain separate.
export function verifyGraphs(p: any, graphs: {any}): nil
    verify(p)
    need(#graphs == #p.owners, "incomplete graph table")
    for index in pairs(graphs) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #p.owners,
            "invalid graph table index"
        )
    end
    for index = 1, #p.owners do
        local g = graphs[index]
        need(type(g) == "table", "incomplete graph table")
        local owner = p.owners[index]
        need(g.native == nil, "core guest program cannot admit a native graph")
        local nparams = owner.kind == "module" and 0 or #graph.parameters(owner.body)
        need(g.nparams == nparams, "graph parameter count differs from checked owner")
        need(g.programOwner == owner.id, "graph owner identity mismatch")
        need(
            g.name == owner.name and g.module == owner.scope.name and g.path == owner.scope.path,
            "graph owner source mismatch"
        )
        graph.verify(g)
        for _, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                local args = block.args[at]
                need(op ~= "NewClosure", "core program requires explicit closure capture SSA operands")
                explicitOperands(op)
                local targetId, captureCount = graph.closureTarget(op, args)
                if targetId ~= nil then
                    local target = need(p.owners[targetId + 1], "invalid closure function reference")
                    need(target.kind == "function", "closure target is not a function")
                    need(target.parent == g.programOwner, "closure crosses lexical parent")
                    need(captureCount == #target.captures, "closure capture count mismatch")
                elseif op == "GetUpval" then
                    local captureId = args[1]
                    need(
                        type(captureId) == "number"
                        and captureId >= 0
                        and captureId < #owner.captures
                        and captureId % 1 == 0,
                        "invalid graph capture reference"
                    )
                end
            end
            if block.term.kind == "invoke" then
                local contract = block.term.contract
                local site = need(p.callByNode[contract.call], "invoke lacks checked callsite")
                need(site.owner == owner.id, "invoke callsite belongs to another owner")
                if contract.dynamic then
                    need(p.functionsByDefinition[site.definition] == nil, "dynamic invoke names a declaration")
                else
                    local target = contract.owner
                    need(
                        p.owners[target.id + 1] == target
                        and p.functionsByDefinition[site.definition] == target
                        and target.definition == contract.definition,
                        "invoke callee belongs to another catalog"
                    )
                end
            end
            if block.term.kind == "returns" then
                explicitOperands("RetN")
            end
        end
        for _, constant in ipairs(g.constants) do
            if constant.kind == "func" then
                local functionId = constant.value
                need(
                    type(functionId) == "number"
                    and functionId >= 0
                    and functionId < #p.owners
                    and functionId % 1 == 0
                    and p.owners[functionId + 1].kind == "function",
                    "invalid graph function reference"
                )
            end
        end
    end
end

-- The externals no execution binding answers, each with where it is first used.
local function unboundExternals(p: any): {string}
    local names = {}
    for _, external in ipairs(p.externals) do
        names[
            #names + 1
        ] = tostring(external.definition and external.definition.name) .. " (" .. tostring(external.first) .. ")"
    end

    return names
end

-- The intrinsics the profile cannot execute, each with its source position.
local function unexecutableIntrinsics(p: any): {string}
    local names = {}
    for _, intrinsic in ipairs(p.intrinsics) do
        if not executable(intrinsic.node) then
            local token = cst.firstToken(intrinsic.node)
            names[
                #names + 1
            ] = tostring(
                intrinsic.operation
            ) .. " (" .. tostring(
                p.owners[intrinsic.owner + 1].scope.path
            ) .. ":" .. tostring(token and token.line) .. ")"
        end
    end

    return names
end

-- No graph is omitted, and no image is returned after a partial lowering.
-- Profiles must explicitly support real module initializer owners.
export function compile(p: any, profile: any): any
    verify(p)
    if #p.unresolved > 0 then
        local first = p.unresolved[1]
        need(
            false,
            "unresolved executable reference " .. first.location .. " and " .. tostring(#p.unresolved - 1) .. " more"
        )
    end
    local externals = unboundExternals(p)
    need(#externals == 0, "external execution bindings are not established: " .. table.concat(externals, ", "))
    local intrinsics = unexecutableIntrinsics(p)
    need(#intrinsics == 0, "intrinsic execution is not established: " .. table.concat(intrinsics, ", "))
    -- The whole catalog is verified and every intrinsic established above, and
    -- no external is bound, so no owner holds an external reference: each
    -- owner lowers without verifying the catalog again, which made compiling
    -- quadratic in the program's owners.
    need(#p.externalReferences == 0, "external execution bindings are not established")
    local graphs, modules = {}, {}
    for index, owner in ipairs(p.owners) do
        graphs[index] = ownerGraph(p, owner, profile)
    end
    for index, module in ipairs(p.modules) do
        modules[index] = {name = module.name, path = module.path, chunk = module.chunk}
    end
    verifyGraphs(p, graphs)

    return {graphs = graphs, header = {shapes = {}, modules = modules, entry = p.entry}, catalog = p}
end

--- Everything that keeps a program from compiling, gathered rather than raised
--- at the first: unbound externals, intrinsics the profile cannot execute, and
--- each owner whose lowering refuses. Owners lower independently of whether
--- the program as a whole could, so a refusal names its own cause. Returns no
--- image; a program with an empty inventory compiles with `compile`.
export function inventory(p: any, profile: any): any
    verify(p)
    local refused = {}
    for _, owner in ipairs(p.owners) do
        local ok, problem = pcall(ownerGraph, p, owner, profile)
        if not ok then
            refused[
                #refused + 1
            ] = {
                owner = owner.id,
                kind = owner.kind,
                path = owner.scope and owner.scope.path,
                problem = tostring(problem)
            }
        end
    end

    local unresolved = {}
    for _, item in ipairs(p.unresolved) do
        unresolved[#unresolved + 1] = {owner = item.owner, location = item.location}
    end

    return {
        externals = unboundExternals(p),
        intrinsics = unexecutableIntrinsics(p),
        owners = refused,
        unresolved = unresolved
    }
end

export function image(p: any, profile: any): string
    local complete = compile(p, profile)
    return graphemit.image(complete.graphs, complete.header)
end
