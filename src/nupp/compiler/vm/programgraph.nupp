module nupp.compiler.vm.programgraph

local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local graph = require("nupp.compiler.vm.graph")
local opcodes = require("nupp.compiler.vm.opcodes")
local graphimage = require("nupp.compiler.vm.graphimage")
local graphemit = require("nupp.compiler.vm.graphemit")
local lower = require("nupp.compiler.vm.lower")
local program = {}

local typeSyntax = {
    tconst = true,
    tkeyof = true,
    twriteof = true,
    tliteral = true,
    tname = true,
    ttypecall = true,
    tparen = true,
    tmap = true,
    tshape = true,
    tshapeField = true,
    ttuple = true,
    tpack = true,
    tpackUnion = true,
    tarray = true,
    tfunc = true,
    tfuncParam = true,
    topt = true,
    tptr = true,
    tcarray = true,
    tmember = true,
    tmapped = true,
    tunion = true,
    tintersection = true,
    errorType = true,
    tpredicate = true,
    tborrows = true,
    tpreserves = true,
    generics = true,
    annotationApply = true,
}

local function bindingMode(definition: any): string
    -- bindType/bindPack create lexical definitions too. Only bindVar records
    -- a function depth, including a nominal declaration's runtime value.
    if definition.functionDepth == nil then
        return "type"
    end
    return definition.constant and "value" or "cell"
end

local function need(ok: any, message: string): any
    assert(ok, "program graph: " .. message)
    return ok
end

local function storagePlan(p: any): any
    local storage = {}
    for _, b in ipairs(p.bindings) do
        storage[b.definition] = b.mode == "type" and "erased" or "value"
    end
    for _, owner in ipairs(p.owners) do
        for _, item in ipairs(owner.captures) do
            local b = need(p.bindings[item.binding + 1], "capture binding is missing")
            -- A record's methods may name the record, whose table holds them:
            -- its binding is a cell made before them, as a local function's is.
            local ownRecord = p.recordMembers[owner.node] == b.definition
            if b.mode == "cell" or item.recursive or ownRecord then
                storage[b.definition] = "cell"
            end
        end
    end

    return storage
end

local function kind(t: any): string
    while t and (t.tag == "literal" or t.tag == "const") do
        t = t.tag == "literal" and t.base or t.inner
    end
    return t and t.tag or "missing"
end

-- Values are kept beside their source and exact bytes. Integers never pass
-- through tonumber; float NaNs use the graph image's canonical quiet NaN.
local function literal(node: any): any
    if node.kind == "paren" then
        return literal(node.expr)
    end
    local negative = node.kind == "unop" and node.op.text == "-" and node.operand.kind == "number"
    local value = negative and node.operand or node
    if value.kind == "number" then
        local text = value.token.text:gsub("_", "")
        local ty = kind(value.inferredType)
        local integer = ty == "integer" or ty == "int64" or ty == "uint64"
        text = text:gsub("[Uu]?[Ll][Ll]$", "")
        text = (negative and "-" or "") .. text
        if integer then
            return {kind = ty == "uint64" and "uint64" or "int64", text = text, bytes = graphimage.wideTextBytes(text)}
        end
        local number = need(tonumber(text), "unsupported float literal " .. text)
        -- Unary negation of a parsed positive zero retains its IEEE sign even
        -- when the host parses an integer-looking zero as an integer.
        if negative and number == 0 then
            number = -0.0
        end
        return {kind = "num", text = text, bytes = graphimage.floatBytes(number)}
    elseif value.kind == "string" then
        local raw = value.token.text
        local bytes = lexer.stringValue(raw)
        if bytes == nil then
            local equals = need(raw:match("^%[(=*)%["), "unsupported string literal")
            local decoded = raw:sub(#equals + 3, -#equals - 3):gsub("\r\n", "\n"):gsub("\n\r", "\n"):gsub("\r", "\n")
            bytes = decoded:gsub("^\n", "")
        end
        return {kind = "str", bytes = bytes}
    elseif value.kind == "dedentString" then
        return {kind = "str", bytes = lexer.dedentLongString(value.token.text)}
    elseif value.kind == "trueExpr" or value.kind == "falseExpr" or value.kind == "nilExpr" then
        return {
            kind = value.kind == "trueExpr" and "true" or value.kind == "falseExpr" and "false" or "nil",
            bytes = ""
        }
    end

    return nil
end

local function functionName(node: any, id: integer): string
    if node.kind == "localFuncStmt" or node.kind == "inlineMethod" then
        return node.name.text
    elseif node.kind == "funcStmt" then
        local parts = {}
        for _, token in ipairs(node.name) do
            parts[#parts + 1] = token.text
        end
        return table.concat(parts)
    end

    return "<function " .. tostring(id) .. ">"
end

-- This walk discovers semantic owners, not instructions. Only ordered CST
-- children are visited: named fields alias them and checker metadata has cycles.
-- A `:` method's receiver is implicit: the checker binds `self` without a
-- declaring token, so its references carry no definition. The core gives it
-- one, as a synthetic first parameter, and points every `self` in the body
-- at it, except inside nested methods, which have their own receiver.
local function implicitSelf(node: any, body: any): any
    if body.coreSelfParam ~= nil or not (node.kind == "funcStmt" and node.name.method) then
        return body.coreSelfParam
    end
    local token: any = {
        kind = "name",
        text = "self",
        line = node.name.method.line,
        col = node.name.method.col,
        offset = node.name.method.offset,
        trivia = {}
    }
    local definition: any = {lexical = true, token = token, functionDepth = 0, constant = true, implicitSelf = true}
    token.definition = definition
    local mark: function(any): nil
    mark = function(item: any): nil
        if type(item) ~= "table" then
            return
        end
        if cst.isToken(item) then
            if item.text == "self" and item.definition == nil then
                item.definition = definition
            end
            return
        end
        if item ~= body and (item.kind == "funcStmt" and item.name.method or item.kind == "inlineMethod") then
            return
        end
        for _, child in ipairs(item) do
            mark(child)
        end
    end
    mark(body)
    body.coreSelfParam = {kind = "param", name = token, implicitSelf = true}

    return body.coreSelfParam
end

program.parameters = graph.parameters

function program.describe(modules: {any}, entryModule: string): any
    local p: any = {
        modules = {},
        owners = {},
        bindings = {},
        constants = {},
        references = {},
        externals = {},
        externalReferences = {},
        intrinsics = {},
        externalsByDefinition = {},
        imports = {},
        requires = {},
        requireByNode = {},
        calls = {},
        callByNode = {},
        -- Per cleanup site (a local's statement), the record
        -- declaration whose destructor it runs, mapped to a synthetic
        -- reference to that record's name.
        cleanupTokens = {},
        -- The owners (by id) with any such site.
        cleanupOwners = {},
        -- The definition of the record each method or constructor written in
        -- a record body belongs to, by its node.
        recordMembers = {},
        byDefinition = {},
        functionsByDefinition = {},
        byBody = {},
        byNode = {},
        immutable = {}
    }
    local moduleNames, topLevel, sourcePaths = {}, {}, {}
    for _, input in ipairs(modules) do
        need(type(input.name) == "string" and type(input.path) == "string", "module source required")
        need(not moduleNames[input.name], "duplicate module " .. input.name)
        sourcePaths[input.path] = true
        local parsed = need(input.parsed, "checked parse required")
        need(parsed.root and parsed.symbols and parsed.moduleName == input.name, "checked module identity required")
        need(input.diagnostics ~= nil and #parsed.errors == 0, "checked diagnostics required")
        for _, diagnostic in ipairs(input.diagnostics) do
            need(diagnostic.severity ~= "error", "module has checker errors")
        end
        local scope: any = {name = input.name, path = input.path, constants = {}, functions = {}, exports = {}}
        local owner: any = {
            id = #p.owners,
            kind = "module",
            name = "<init>",
            node = parsed.root,
            body = parsed.root,
            scope = scope,
            captures = {},
            constants = {},
            paramKinds = {},
            captureByDefinition = {}
        }
        p.owners[#p.owners + 1] = owner
        p.byBody[owner.body] = owner
        for _, block in ipairs(parsed.root.blocks) do
            for _, stat in ipairs(block.stats or {}) do
                topLevel[stat.kind == "exportStmt" and stat.stat or stat] = true
            end
        end
        local module = {name = input.name, path = input.path, chunk = owner.id, parsed = parsed}
        p.modules[#p.modules + 1], moduleNames[input.name] = module, module
        if input.name == entryModule then
            p.entry = owner.id
        end
    end
    need(p.entry ~= nil, "entry module is missing")

    local function binding(token: any, owner: any): nil
        local definition = token.definition
        if definition and definition.lexical and definition.token == token then
            need(p.byDefinition[definition] == nil, "duplicate checked declaration")
            local b: any = {
                id = #p.bindings,
                definition = definition,
                token = token,
                owner = owner.id,
                mode = bindingMode(definition)
            }
            p.bindings[#p.bindings + 1], p.byDefinition[definition] = b, b
        end
    end

    -- The record name each method written in a record body belongs to.
    local inlineRecords: {[any]: any} = {}
    local discover: function(any, any): nil
    discover = function(node: any, owner: any): nil
        if cst.isToken(node) then
            binding(node, owner)
            return
        end
        if node.kind == "recordDecl" and node.name then
            for _, entry in ipairs(node.entries or {}) do
                if entry.kind == "inlineMethod" or entry.kind == "constructorDecl" then
                    inlineRecords[entry] = node.name
                    p.recordMembers[entry] = node.name.definition
                end
            end
        end
        if node.kind == "funcbody" then
            need(p.byBody[node] == owner, "unsupported checked function owner")
        end
        local isDeclaration = cst.FUNCTION_DECLARATIONS[node.kind]
        local body = node.kind == "shortfn" and node or isDeclaration and node.body
        need(not isDeclaration or body ~= nil, "function declaration lacks a checked body")
        if body and p.byBody[body] ~= owner then
            local signature = need(body.signatureType, "checked function signature required")
            local child: any = {
                id = #p.owners,
                kind = "function",
                name = functionName(node, #p.owners),
                node = node,
                body = body,
                parent = owner.id,
                scope = owner.scope,
                signature = signature,
                paramKinds = {},
                captures = {},
                constants = {},
                captureByDefinition = {}
            }
            local receiver = implicitSelf(node, body)
            if receiver then
                binding(receiver.name, child)
            end
            local params = program.parameters(body)
            for index, parameter in ipairs(params) do
                -- A `...` last is a hidden parameter holding the pack of extra
                -- arguments (a table with its count at key 0). A named one is a
                -- local the function binds from it on entry.
                if parameter.vararg and index == #params then
                    child.variadic = true
                    child.paramKinds[index] = "value"
                    -- It binds like a value parameter, keyed by its node.
                    local b: any = {
                        id = #p.bindings,
                        definition = parameter,
                        token = parameter,
                        owner = child.id,
                        mode = "value",
                        pack = true
                    }
                    p.bindings[#p.bindings + 1], p.byDefinition[parameter] = b, b
                else
                    need(
                        parameter.name and not parameter.vararg,
                        "parameter ownership or variadic lowering is unsupported"
                    )
                    child.paramKinds[index] = kind(parameter.name.inferredType)
                end
            end
            child.resultKind = #signature.rets == 1 and kind(signature.rets[1]) or nil
            local declaration = (node.kind == "localFuncStmt" or node.kind == "inlineMethod") and node.name
                or node.kind == "funcStmt" and node.name[#node.name]
                or nil
            -- A constructor has no name: it is given a synthetic one, which its
            -- construction callsites name.
            if node.kind == "constructorDecl" and inlineRecords[node] then
                local record = inlineRecords[node]
                local token: any = {
                    kind = "name",
                    text = "constructor",
                    line = record.line,
                    col = record.col,
                    offset = record.offset,
                    trivia = {}
                }
                token.definition = {lexical = true, token = token, functionDepth = 0, constant = true}
                node.coreDefinition = token.definition
                declaration = token
            end
            if declaration then
                child.definition = need(declaration.definition, "checked function declaration required")
                need(
                    p.functionsByDefinition[child.definition] == nil,
                    "multiple bodies for checked function declaration"
                )
                p.functionsByDefinition[child.definition] = child
            end
            p.owners[#p.owners + 1], p.byBody[body] = child, child
            if node.kind == "shortfn" then
                for _, part in ipairs(node) do
                    discover(part, child)
                end
            else
                for _, part in ipairs(node) do
                    discover(part, part == body and child or owner)
                end
            end
            return
        end
        for _, child in ipairs(node) do
            discover(child, owner)
        end
    end
    -- All module and function identities exist before references are resolved.
    for _, module in ipairs(p.modules) do
        discover(module.parsed.root, p.owners[module.chunk + 1])
        for _, definition in ipairs(module.parsed.symbols) do
            need(
                not definition.lexical or p.byDefinition[definition] ~= nil,
                "checked declaration outside ordered syntax is unsupported"
            )
        end
    end

    for _, b in ipairs(p.bindings) do
        local required = b.definition.requiredModule
        if required then
            local target = need(moduleNames[required], "required checked module is missing: " .. required)
            p.imports[#p.imports + 1] = {binding = b.id, target = target.chunk}
        end
    end

    local capture: function(any, any, string?): any
    capture = function(owner: any, b: any, mode: string?): any
        need(owner.id ~= b.owner, "cannot capture an owned local")
        need(b.mode ~= "type", "erased type declaration cannot be captured")
        local existing = owner.captureByDefinition[b.definition]
        if existing then
            need(mode == nil or existing.mode == mode, "conflicting capture modes")
            return existing
        end
        local parent = need(owner.parent ~= nil and p.owners[owner.parent + 1], "capture escapes lexical ancestry")
        local source = parent.id == b.owner and b.id or capture(parent, b, nil).id
        local item: any = {
            id = #owner.captures,
            binding = b.id,
            definition = b.definition,
            mode = mode or b.mode,
            sourceOwner = parent.id,
            sourceKind = parent.id == b.owner and "local" or "capture",
            source = source,
            recursive = owner.definition == b.definition
        }
        owner.captures[#owner.captures + 1], owner.captureByDefinition[b.definition] = item, item

        return item
    end

    -- Ownership clauses have checker-resolved outer bindings. Install them
    -- before ordinary reads so explicit take/borrow modes cannot be lost.
    for _, owner in ipairs(p.owners) do
        if owner.kind == "function" then
            for _, spec in ipairs({
                {items = owner.body.takenCaptures, mode = "take"},
                {items = owner.body.borrowCaptures, mode = "borrow"}
            }) do
                for _, item in ipairs(spec.items or {}) do
                    local definition = item.outer and item.outer.definition
                    local b = need(p.byDefinition[definition], "ownership capture lacks checked outer declaration")
                    local captured = capture(owner, b, spec.mode)
                    captured.ownership = item
                    captured.inner = item.inner and item.inner.definition or nil
                end
            end
        end
    end

    local loopForms: {[any]: boolean} = {}

    local function reference(token: any, owner: any): nil
        local definition = token and token.definition
        local location = tostring(
            token and token.text
        ) .. " at " .. owner.scope.path .. ":" .. tostring(token and token.line)
        need(definition ~= nil, "unresolved executable reference " .. location)
        if definition.token == token then
            return
        end
        local b = p.byDefinition[definition]
        if not b then
            need(
                definition.token and type(definition.filename) == "string" and not sourcePaths[definition.filename],
                "lexical reference has no catalog declaration: " .. location .. " declared " .. tostring(
                    definition.name
                ) .. " at " .. tostring(
                    definition.filename
                ) .. ":" .. tostring(definition.token and definition.token.line)
            )
            local external = p.externalsByDefinition[definition]
            if not external then
                external = {
                    id = #p.externals,
                    definition = definition,
                    path = definition.filename,
                    token = definition.token
                }
                p.externals[#p.externals + 1], p.externalsByDefinition[definition] = external, external
            end
            p.externalReferences[#p.externalReferences + 1] = {owner = owner.id, external = external.id, token = token}
            return
        end
        local role = b.mode == "type" and "type" or "value"
        p.references[#p.references + 1] = {token = token, binding = b.id, owner = owner.id, role = role}
        if role == "value" and b.owner ~= owner.id then
            capture(owner, b, nil)
        end
    end

    local collect: function(any, any): nil
    collect = function(node: any, owner: any): nil
        if cst.isToken(node) or typeSyntax[node.kind] then
            return
        end
        local bodyOwner = p.byBody[node]
        if bodyOwner then
            owner = bodyOwner
        end
        -- `for i, v in ipairs(t)` and `pairs(t)` are loop forms the profile lowers
        -- itself: the iterator is never called, so it is neither a reference nor a
        -- call.
        if node.kind == "forinStmt"
            and node.exprs
            and node.exprs[1]
            and node.exprs[1].kind == "call"
            and (node.exprs[1].resolvedGlobal == "ipairs" or node.exprs[1].resolvedGlobal == "pairs")
        then
            loopForms[node.exprs[1]] = true
        end
        -- Library intrinsics the core implements as operations (math.floor) are
        -- forms too: the global they name is never read.
        if node.kind == "call" and graph.coreLibraryCall(node) then
            loopForms[node] = true
        end
        -- So are the library constants it folds (math.pi).
        if graph.coreLibraryField(node) then
            loopForms[node] = true
        end

        -- An affine local runs its record's destructor at
        -- scope exit, reached through the table the record's name holds: a
        -- synthetic reference per site, which capture analysis transports.
        local function cleanupToken(site: any, t: any, anchor: any): nil
            local inner = t and t.tag == "affine" and t.inner
            local origin = inner and (inner.origin or inner)
            local declaration = origin and origin.deriveDeclaration
            if not (declaration and declaration.kind == "recordDecl" and declaration.name) then
                return
            end
            local token: any = {
                kind = "name",
                text = declaration.name.text,
                line = anchor.line,
                col = anchor.col,
                offset = anchor.offset,
                trivia = {},
                definition = declaration.name.definition
            }
            reference(token, owner)
            p.cleanupTokens[site] = p.cleanupTokens[site] or {}
            p.cleanupTokens[site][declaration] = token
            p.cleanupOwners[owner.id] = true
        end

        if node.kind == "localStmt" and node.automaticOwners then
            for index, automatic in pairs(node.automaticOwners) do
                local anchor = node.names and node.names[index]
                if anchor then
                    cleanupToken(node, automatic.type, anchor)
                end
            end
        end
        -- `new R(...)` of a plain record builds its value in place, so the
        -- record's name is a type use there, not a read of its runtime value.
        if node.kind == "newExpr" and node.call and node.call.recordFields and not node.call.constructorEntry then
            loopForms[node.call] = true
            -- Construction reads the record's table, its instances' metatable.
            if node.call.obj and node.call.obj.kind == "name" then
                reference(node.call.obj.token, owner)
            end
        end
        -- `new R(...)` with a constructor calls it, the fresh instance first,
        -- through the table R's name holds.
        local entry = node.kind == "newExpr" and node.call and node.call.constructorEntry
        local declaration = entry and entry.declaration
        if declaration and declaration.coreDefinition and inlineRecords[declaration] then
            local base = inlineRecords[declaration]
            local classToken: any = {
                kind = "name",
                text = base.text,
                line = base.line,
                col = base.col,
                offset = base.offset,
                trivia = {},
                definition = base.definition
            }
            reference(classToken, owner)
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node.call,
                definition = declaration.coreDefinition,
                construct = true,
                classToken = classToken
            }
            p.calls[#p.calls + 1], p.callByNode[node.call] = item, item
            loopForms[node.call] = true
        end
        if node.kind == "name" then
            reference(node.token, owner)
        elseif node.kind == "funcname" then
            -- A qualified declaration reads its receiver, whereas a plain
            -- function declaration introduces its own checked binding.
            reference(node.base, owner)
        end
        local loader = node.kind == "call" and node.runtimeLoader == "require"
        if loader then
            local target = node.requiredModule and moduleNames[node.requiredModule]
            local item = {
                id = #p.requires,
                owner = owner.id,
                node = node,
                module = node.requiredModule,
                typeOnly = node.typeOnlyRequire == true,
                target = target and target.chunk or nil
            }
            p.requires[#p.requires + 1], p.requireByNode[node] = item, item
        end
        local intrinsic = node.kind == "call" and node.ownershipIntrinsic
        if intrinsic then
            -- The checker resolves the reserved callee before ordinary name
            -- inference. Its marker is a dependency, not a fabricated binding.
            p.intrinsics[#p.intrinsics + 1] = {id = #p.intrinsics, owner = owner.id, node = node, operation = intrinsic}
        end
        -- pcall is a library form whose name is never read, but it calls its
        -- first argument, so it is a callsite all the same.
        local protected = node.kind == "call"
            and (graph.coreLibraryCall(node) == "pcall" or graph.coreLibraryCall(node) == "xpcall")
        if node.kind == "call"
            and node.obj.kind == "name"
            and not loader
            and not intrinsic
            and (not loopForms[node] or protected)
        then
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node,
                definition = node.obj.token.definition,
                protected = protected or nil
            }
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A call through anything but a name (`R.f(...)`, `t[i](x)`, `f()()`,
        -- a cast) calls the value it evaluates, resolved when it runs.
        -- So does a library call taking a function it calls back, which is
        -- that function's callsite: table.sort's comparator, and gsub's
        -- function replacement, in `s:gsub(p, f)` form too.
        if node.kind == "call"
            and node.obj.kind ~= "name"
            and not loader
            and not intrinsic
            and (not loopForms[node] or graph.callbackArgument(node) ~= nil)
            or node.kind == "methodCall" and graph.callbackArgument(node) ~= nil
        then
            local item = {id = #p.calls, owner = owner.id, node = node, field = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A generic `for` over anything but ipairs, pairs or gmatch calls its
        -- iterator each step: the statement is that call's callsite.
        if node.kind == "forinStmt" and graph.genericiterator(node) then
            local item = {id = #p.calls, owner = owner.id, node = node, iterator = true}
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A record method call reaches its method through the table the
        -- record's name holds, so the caller references that binding: a
        -- synthetic token per call, which capture analysis then transports.
        local method = node.kind == "methodCall" and node.name and node.name.definition
        local target = method and p.functionsByDefinition[method]
        local base = target and target.node.kind == "funcStmt" and target.node.name.method and target.node.name.base
            or target
            and target.node.kind == "inlineMethod"
            and not target.node.inlineStatic
            and inlineRecords[target.node]
            or nil
        if base then
            local classToken: any = {
                kind = "name",
                text = base.text,
                line = node.name.line,
                col = node.name.col,
                offset = node.name.offset,
                trivia = {},
                definition = base.definition
            }
            reference(classToken, owner)
            local item = {
                id = #p.calls,
                owner = owner.id,
                node = node,
                definition = method,
                method = true,
                classToken = classToken
            }
            p.calls[#p.calls + 1], p.callByNode[node] = item, item
        end
        -- A parenthesized literal is registered at the literal itself, which is
        -- what lowering reads once it has looked through the parentheses.
        local constant = node.kind ~= "paren" and literal(node)
        if constant then
            constant.id, constant.owner, constant.node = #p.constants, owner.id, node
            p.constants[#p.constants + 1], p.byNode[node] = constant, constant
            owner.constants[#owner.constants + 1] = constant.id
            return
        end
        for _, child in ipairs(node) do
            if not (intrinsic or loader or loopForms[node]) or child ~= node.obj then
                collect(child, owner)
            end
        end
        if node.kind == "localStmt"
            and node.isConst
            and topLevel[node]
            and owner.kind == "module"
            and not node.pattern
        then
            for index, token in ipairs(node.names) do
                local b = need(p.byDefinition[token.definition], "const declaration missing")
                local constant = node.exprs and p.byNode[node.exprs[index]]
                if constant and not b.definition.reassigned then
                    b.initializer = node.exprs[index]
                    p.immutable[b.definition] = constant
                end
            end
        end
    end
    for _, module in ipairs(p.modules) do
        collect(module.parsed.root, p.owners[module.chunk + 1])
    end
    -- Capture ownership mode is independent of its transported representation.
    -- Only shared mutable bindings and recursive declaration self-references
    -- require a cell; a recursive const function still needs publication after
    -- its closure has captured that cell.
    local storage = storagePlan(p)
    for _, b in ipairs(p.bindings) do
        b.storage = storage[b.definition]
    end
    for _, owner in ipairs(p.owners) do
        for _, item in ipairs(owner.captures) do
            item.storage = p.bindings[item.binding + 1].storage
        end
    end
    program.verify(p)

    return p
end

function program.verify(p: any): boolean
    need(p.owners and p.modules and p.bindings and p.constants, "catalog required")
    need(p.entry ~= nil and p.owners[p.entry + 1] and p.owners[p.entry + 1].kind == "module", "invalid module entry")
    local modules = {}
    for _, module in ipairs(p.modules) do
        local owner = need(p.owners[module.chunk + 1], "invalid initializer reference")
        need(
            owner.kind == "module" and owner.node == module.parsed.root and owner.body == module.parsed.root,
            "initializer must own checked module root"
        )
        need(
            owner.scope.name == module.name and owner.scope.path == module.path and not modules[module.name],
            "module identity mismatch"
        )
        modules[module.name] = owner
    end
    for definition, b in pairs(p.byDefinition) do
        need(b.definition == definition and p.bindings[b.id + 1] == b, "stale binding identity map")
    end
    for definition, owner in pairs(p.functionsByDefinition) do
        need(owner.definition == definition and p.owners[owner.id + 1] == owner, "stale function identity map")
    end
    for node, constant in pairs(p.byNode) do
        need(constant.node == node and p.constants[constant.id + 1] == constant, "stale constant identity map")
    end
    for definition, external in pairs(p.externalsByDefinition) do
        need(
            external.definition == definition and p.externals[external.id + 1] == external,
            "stale external identity map"
        )
    end
    for index, external in ipairs(p.externals) do
        need(
            external.id == index - 1 and p.externalsByDefinition[external.definition] == external,
            "external identity mismatch"
        )
        need(
            external.token == external.definition.token
            and external.path == external.definition.filename
            and not p.byDefinition[external.definition],
            "external declaration mismatch"
        )
        for _, module in ipairs(p.modules) do
            need(module.path ~= external.path, "external declaration belongs to a catalog module")
        end
    end
    local requireNodes = {}
    for index, item in ipairs(p.requires) do
        local node = item.node
        need(item.id == index - 1 and p.owners[item.owner + 1], "invalid require callsite owner")
        need(
            node.kind == "call" and node.runtimeLoader == "require" and not requireNodes[node],
            "require callsite lacks checked loader identity"
        )
        need(
            p.requireByNode[node] == item
            and item.module == node.requiredModule
            and item.typeOnly == (node.typeOnlyRequire == true),
            "require callsite metadata mismatch"
        )
        local target = item.module and modules[item.module]
        need(item.target == (target and target.id or nil), "require callsite target mismatch")
        requireNodes[node] = true
    end
    for node, item in pairs(p.requireByNode) do
        need(item.node == node and p.requires[item.id + 1] == item, "stale require callsite map")
    end
    local referenceOwners = {}
    for _, reference in ipairs(p.externalReferences) do
        local external = need(p.externals[reference.external + 1], "invalid external reference")
        need(
            p.owners[reference.owner + 1] and reference.token.definition == external.definition,
            "external reference identity mismatch"
        )
        referenceOwners[reference.token] = reference.owner
    end
    local intrinsicNodes = {}
    for index, intrinsic in ipairs(p.intrinsics) do
        need(intrinsic.id == index - 1 and p.owners[intrinsic.owner + 1], "invalid intrinsic owner")
        need(
            intrinsic.node.kind == "call"
            and intrinsic.node.ownershipIntrinsic == intrinsic.operation
            and type(intrinsic.operation) == "string"
            and not intrinsicNodes[intrinsic.node],
            "checked intrinsic identity mismatch"
        )
        intrinsicNodes[intrinsic.node] = true
    end
    local constantOwners = {}
    for body, owner in pairs(p.byBody) do
        need(owner.body == body and p.owners[owner.id + 1] == owner, "missing reserved owner")
    end
    local storage = storagePlan(p)
    for index, b in ipairs(p.bindings) do
        need(b.id == index - 1 and p.owners[b.owner + 1], "invalid binding owner")
        -- A variadic pack has no declaration: its parameter node keys it.
        need(
            b.pack and b.definition == b.token and b.definition.vararg and p.byDefinition[b.definition] == b
            or b.definition == b.token.definition
            and b.definition.token == b.token
            and p.byDefinition[b.definition] == b,
            "binding identity mismatch"
        )
        need(b.mode == (b.pack and "value" or bindingMode(b.definition)), "binding mode mismatch")
        need(b.storage == storage[b.definition], "binding storage mismatch")
    end
    for index, owner in ipairs(p.owners) do
        need(owner.id == index - 1 and p.byBody[owner.body] == owner, "owner identity mismatch")
        need(modules[owner.scope.name] ~= nil, "owner module is missing")
        if owner.kind == "function" then
            need(owner.parent ~= nil and owner.parent < owner.id and owner.parent >= 0, "invalid lexical parent")
            need(p.owners[owner.parent + 1].scope == owner.scope, "parent crosses modules")
            need(
                not owner.definition or p.functionsByDefinition[owner.definition] == owner,
                "function declaration identity mismatch"
            )
            need(
                owner.body.signatureType == owner.signature
                and (owner.node == owner.body or owner.node.body == owner.body),
                "checked function identity mismatch"
            )
        else
            need(
                owner.kind == "module" and modules[owner.scope.name] == owner and owner.parent == nil,
                "invalid initializer owner"
            )
        end
        for definition, item in pairs(owner.captureByDefinition) do
            need(item.definition == definition and owner.captures[item.id + 1] == item, "stale capture identity map")
        end
        for slot, item in ipairs(owner.captures) do
            local b = need(p.bindings[item.binding + 1], "capture binding is missing")
            need(
                item.id == slot - 1
                and item.definition == b.definition
                and owner.captureByDefinition[b.definition] == item,
                "capture identity mismatch"
            )
            need(item.storage == b.storage, "capture storage mismatch")
            need(item.sourceOwner == owner.parent, "capture must cross one lexical parent")
            local parent = need(p.owners[item.sourceOwner + 1], "capture parent missing")
            if item.sourceKind == "local" then
                need(b.owner == parent.id and item.source == b.id, "invalid local capture source")
            else
                local source = parent.captures[item.source + 1]
                need(
                    item.sourceKind == "capture" and source and source.binding == b.id,
                    "invalid forwarded capture source"
                )
            end
            need(item.recursive == (owner.definition == b.definition), "recursive capture identity mismatch")
            if item.mode == "take" or item.mode == "borrow" then
                need(
                    item.ownership and item.ownership.outer.definition == b.definition,
                    "ownership capture identity mismatch"
                )
                local list = item.mode == "take" and owner.body.takenCaptures or owner.body.borrowCaptures
                local found = false
                for _, checked in ipairs(list or {}) do
                    found = found or checked == item.ownership
                end
                need(found, "ownership capture lacks checked contract")
                need(
                    item.inner == (item.ownership.inner and item.ownership.inner.definition or nil),
                    "taken binding identity mismatch"
                )
            else
                need(item.mode == b.mode, "invalid capture mode")
            end
        end
        for _, id in ipairs(owner.constants) do
            need(p.constants[id + 1] and p.constants[id + 1].owner == owner.id, "invalid owner constant reference")
            need(not constantOwners[id], "duplicate owner constant reference")
            constantOwners[id] = true
        end
    end
    for _, imported in ipairs(p.imports) do
        local b = need(p.bindings[imported.binding + 1], "invalid import binding")
        local target = need(p.owners[imported.target + 1], "invalid import initializer")
        need(
            target.kind == "module" and b.definition.requiredModule == target.scope.name,
            "checked import target mismatch"
        )
    end
    for _, reference in ipairs(p.references) do
        local b = need(p.bindings[reference.binding + 1], "invalid lexical reference")
        local owner = need(p.owners[reference.owner + 1], "invalid reference owner")
        need(reference.token.definition == b.definition, "reference declaration identity mismatch")
        referenceOwners[reference.token] = reference.owner
        local captured = owner.captureByDefinition[b.definition]
        need(reference.role == (b.mode == "type" and "type" or "value"), "reference role mismatch")
        need(
            reference.role == "type" or owner.id == b.owner or captured and owner.captures[captured.id + 1] == captured,
            "reference lacks capture transport"
        )
    end
    need(type(p.calls) == "table", "invalid callsite array")
    local callCount = 0
    for index in pairs(p.calls) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #p.calls,
            "invalid callsite array index"
        )
        callCount = callCount + 1
    end
    need(callCount == #p.calls, "incomplete callsite array")
    for index, item in ipairs(p.calls) do
        local node = item.node
        need(item.id == index - 1 and p.owners[item.owner + 1], "invalid callsite owner")
        if item.method then
            need(
                node.kind == "methodCall" and p.callByNode[node] == item and node.name.definition == item.definition,
                "method callsite identity mismatch"
            )
            need(referenceOwners[item.classToken] == item.owner, "method callsite does not belong to its checked owner")
        elseif item.iterator then
            need(
                node.kind == "forinStmt"
                and graph.genericiterator(node)
                and p.callByNode[node] == item
                and item.definition == nil,
                "iterator callsite identity mismatch"
            )
        elseif item.construct then
            need(
                node.kind == "call"
                and p.callByNode[node] == item
                and node.constructorEntry
                and node.constructorEntry.declaration.coreDefinition == item.definition,
                "construction callsite identity mismatch"
            )
            need(referenceOwners[item.classToken] == item.owner, "construction callsite does not belong to its owner")
        elseif item.field then
            need(
                (
                    node.kind == "call" and node.obj.kind ~= "name"
                    or node.kind == "methodCall" and graph.callbackArgument(node) ~= nil
                )
                and p.callByNode[node] == item
                and item.definition == nil
                and not node.runtimeLoader
                and not node.ownershipIntrinsic,
                "field callsite identity mismatch"
            )
        else
            need(
                node.kind == "call"
                and node.obj.kind == "name"
                and not node.runtimeLoader
                and not node.ownershipIntrinsic,
                "callsite lacks ordinary checked call identity"
            )
            need(
                p.callByNode[node] == item and node.obj.token.definition == item.definition,
                "callsite declaration identity mismatch"
            )
            need(
                item.protected or referenceOwners[node.obj.token] == item.owner,
                "callsite does not belong to its checked owner"
            )
        end
    end
    for node, item in pairs(p.callByNode) do
        need(item.node == node and p.calls[item.id + 1] == item, "stale callsite map")
    end
    for index, constant in ipairs(p.constants) do
        need(constantOwners[index - 1], "constant missing from owner")
        need(
            constant.id == index - 1 and p.owners[constant.owner + 1] and p.byNode[constant.node] == constant,
            "invalid constant identity"
        )
        local expected = need(literal(constant.node), "constant no longer literal")
        need(
            expected.kind == constant.kind and expected.bytes == constant.bytes and expected.text == constant.text,
            "constant payload mismatch"
        )
    end
    for definition, constant in pairs(p.immutable) do
        local b = need(p.byDefinition[definition], "immutable binding missing")
        need(
            definition.constant and not definition.reassigned and p.owners[b.owner + 1].kind == "module",
            "mutable initializer cannot be substituted"
        )
        need(
            p.constants[constant.id + 1] == constant and constant.owner == b.owner and b.initializer == constant.node,
            "immutable constant reference mismatch"
        )
    end

    return true
end

function program.select(p: any, moduleName: string, name: string): any
    program.verify(p)
    local selected
    for _, owner in ipairs(p.owners) do
        if owner.kind == "function" and owner.scope.name == moduleName and owner.name == name then
            need(selected == nil, "ambiguous selected function")
            selected = owner
        end
    end

    return need(selected, "missing checked function")
end

function program.functionGraph(p: any, owner: any, profile: any): any
    program.verify(p)
    need(p.owners[owner.id + 1] == owner, "foreign function owner")
    for _, reference in ipairs(p.externalReferences) do
        need(reference.owner ~= owner.id, "external execution bindings are not established")
    end
    for _, intrinsic in ipairs(p.intrinsics) do
        need(intrinsic.owner ~= owner.id, "intrinsic execution is not established: " .. intrinsic.operation)
    end
    -- A profile may give a function that acquires cleanups its own variant.
    local chosen = profile.forOwner and profile.forOwner(p, owner) or profile
    local g = lower.functionGraph(owner, {program = p}, chosen)
    g.name, g.module, g.path, g.programOwner = owner.name, owner.scope.name, owner.scope.path, owner.id

    return g
end

local function explicitOperands(op: string): nil
    local described = opcodes.describe(op)
    if described then
        need(
            #described.windows == 0 and not described.frame,
            "core program requires explicit SSA operands instead of implicit windows/frame reads: " .. op
        )
    end
end

-- Every checked owner has exactly one graph. This verifies program references;
-- capture storage modes, runtime roots and execution admission remain separate.
function program.verifyGraphs(p: any, graphs: {any}): nil
    program.verify(p)
    need(#graphs == #p.owners, "incomplete graph table")
    for index in pairs(graphs) do
        need(
            type(index) == "number" and index % 1 == 0 and index >= 1 and index <= #p.owners,
            "invalid graph table index"
        )
    end
    for index = 1, #p.owners do
        local g = graphs[index]
        need(type(g) == "table", "incomplete graph table")
        local owner = p.owners[index]
        need(g.native == nil, "core guest program cannot admit a native graph")
        local nparams = owner.kind == "module" and 0 or #graph.parameters(owner.body)
        need(g.nparams == nparams, "graph parameter count differs from checked owner")
        need(g.programOwner == owner.id, "graph owner identity mismatch")
        need(
            g.name == owner.name and g.module == owner.scope.name and g.path == owner.scope.path,
            "graph owner source mismatch"
        )
        graph.verify(g)
        for _, block in ipairs(g.blocks) do
            for at, op in ipairs(block.op) do
                local args = block.args[at]
                need(op ~= "NewClosure", "core program requires explicit closure capture SSA operands")
                explicitOperands(op)
                local targetId, captureCount = graph.closureTarget(op, args)
                if targetId ~= nil then
                    local target = need(p.owners[targetId + 1], "invalid closure function reference")
                    need(target.kind == "function", "closure target is not a function")
                    need(target.parent == g.programOwner, "closure crosses lexical parent")
                    need(captureCount == #target.captures, "closure capture count mismatch")
                elseif op == "GetUpval" then
                    local captureId = args[1]
                    need(
                        type(captureId) == "number"
                        and captureId >= 0
                        and captureId < #owner.captures
                        and captureId % 1 == 0,
                        "invalid graph capture reference"
                    )
                end
            end
            if block.term.kind == "invoke" then
                local contract = block.term.contract
                local site = need(p.callByNode[contract.call], "invoke lacks checked callsite")
                need(site.owner == owner.id, "invoke callsite belongs to another owner")
                if contract.dynamic then
                    need(p.functionsByDefinition[site.definition] == nil, "dynamic invoke names a declaration")
                else
                    local target = contract.owner
                    need(
                        p.owners[target.id + 1] == target
                        and p.functionsByDefinition[site.definition] == target
                        and target.definition == contract.definition,
                        "invoke callee belongs to another catalog"
                    )
                end
            end
            if block.term.kind == "returns" then
                explicitOperands("RetN")
            end
        end
        for _, constant in ipairs(g.constants) do
            if constant.kind == "func" then
                local functionId = constant.value
                need(
                    type(functionId) == "number"
                    and functionId >= 0
                    and functionId < #p.owners
                    and functionId % 1 == 0
                    and p.owners[functionId + 1].kind == "function",
                    "invalid graph function reference"
                )
            end
        end
    end
end

-- No graph is omitted, and no image is returned after a partial lowering.
-- Profiles must explicitly support real module initializer owners.
function program.compile(p: any, profile: any): any
    program.verify(p)
    if #p.externals ~= 0 then
        local names = {}
        for _, external in ipairs(p.externals) do
            names[#names + 1] = tostring(external.definition and external.definition.name)
        end
        need(false, "external execution bindings are not established: " .. table.concat(names, ", "))
    end
    need(#p.intrinsics == 0, "intrinsic execution is not established")
    local graphs, modules = {}, {}
    for index, owner in ipairs(p.owners) do
        graphs[index] = program.functionGraph(p, owner, profile)
    end
    for index, module in ipairs(p.modules) do
        modules[index] = {name = module.name, path = module.path, chunk = module.chunk}
    end
    program.verifyGraphs(p, graphs)

    return {graphs = graphs, header = {shapes = {}, modules = modules, entry = p.entry}, catalog = p}
end

function program.image(p: any, profile: any): string
    local complete = program.compile(p, profile)
    return graphemit.image(complete.graphs, complete.header)
end

export = program
