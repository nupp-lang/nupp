--[[
The lint registry.

The lints, as opposed to the type errors. A type error says the program does not
mean what it says it means, and nothing configures or silences it. A lint says
the program means something its author probably did not intend, which is a
judgement, so it carries a level a project can move and a suppression a statement
can apply.

A lint's level lives here and nowhere else, so changing a default is one edit and
`nupp lints` cannot drift from what the checker does. See `docs/lints.md`.
]]

local lints = {}

--- One lint: what to call it, what it is about, and how loud it is by default.
record lints.Lint
    --- What a person writes in an `@allow`.
    name: string

    --- What survives the name being reconsidered.
    code: string

    --- Which taxonomy entry it belongs to.
    category: string

    --- The level it runs at when a project says nothing.
    level: string

    --- One line, for `nupp lints`.
    summary: string
end

--- Every lint, in the order `nupp lints` reports them.
lints.all = {
    new lints.Lint(
        name = "missing-require",
        code = "NUPP2120",
        category = "correctness",
        level = "error",
        summary = "a project module is used without being required"
    ),
    new lints.Lint(
        name = "exhaustiveness",
        code = "NUPP2107",
        category = "correctness",
        level = "warning",
        summary = "a dispatch leaves members of a closed set unhandled"
    ),
    new lints.Lint(
        name = "string-pointer",
        code = "NUPP2501",
        category = "suspicious",
        level = "warning",
        summary = "a pointer taken from a Lua string"
    ),
    new lints.Lint(
        name = "jit-callback",
        code = "NUPP2502",
        category = "suspicious",
        level = "warning",
        summary = "a C callback left on the JIT"
    ),
    new lints.Lint(
        name = "lossy-narrowing",
        code = "NUPP2503",
        category = "suspicious",
        level = "warning",
        summary = "lossy integer narrowing"
    ),
    new lints.Lint(
        name = "customary-operator",
        code = "NUPP2504",
        category = "style",
        level = "warning",
        summary = "a customary operator where Lua has a word"
    ),
    new lints.Lint(
        name = "loop-invariant-closure",
        code = "NUPP2505",
        category = "suspicious",
        level = "warning",
        summary = "a loop builds the same function every iteration"
    ),
    new lints.Lint(
        name = "undocumented-raise",
        code = "NUPP2506",
        category = "suspicious",
        level = "warning",
        summary = "a documented function raises without saying so"
    ),
    new lints.Lint(
        name = "unused-binding",
        code = "NUPP2507",
        category = "suspicious",
        level = "warning",
        summary = "a local is declared and nothing reads it"
    ),
    new lints.Lint(
        name = "discarded-result",
        code = "NUPP2508",
        category = "suspicious",
        level = "warning",
        summary = "a call with nothing to do but return has its result dropped"
    ),
    new lints.Lint(
        name = "reifiable-record",
        code = "NUPP2509",
        category = "performance",
        level = "off",
        summary = "a record whose fields would all live in C memory"
    ),
    new lints.Lint(
        name = "gradual-projection",
        code = "NUPP2511",
        category = "suspicious",
        level = "warning",
        summary = "an associated type was erased because inference did not reach its head"
    ),
    new lints.Lint(
        name = "else-if",
        code = "NUPP2510",
        category = "style",
        level = "warning",
        summary = "a conditional chain written as separate ifs"
    ),
    new lints.Lint(
        name = "positional-record-construction",
        code = "NUPP2512",
        category = "style",
        level = "warning",
        summary = "a record built by field order rather than by naming its fields"
    ),
    new lints.Lint(
        name = "deprecated",
        code = "NUPP2513",
        category = "suspicious",
        level = "warning",
        summary = "use of an API marked deprecated"
    ),
    new lints.Lint(
        name = "jit-boundary",
        code = "NUPP2514",
        category = "suspicious",
        level = "warning",
        summary = "an FFI boundary cannot safely run on a compiled trace"
    ),
}

-- Both spellings reach the same lint: a name is what a person writes, a code is what
-- survives the name being reconsidered.
local byKey: {[string]: lints.Lint} = {}
for _, lint in ipairs(lints.all) do
    byKey[lint.name] = lint
    byKey[lint.code] = lint
end

-- The taxonomy is declared beside the registry so configuration validation and its
-- descriptions have one source. `everyLintIsWellFormed` also keeps every category
-- useful by requiring at least one member.
local CATEGORIES: {
    [string]: string
} = {
    correctness = "the program is very likely wrong",
    suspicious = "legal, and probably not meant",
    style = "it works and reads badly",
    performance = "a declaration is paying for something it does not use",
    migration = "a construct a newer spelling replaces",
}

-- The levels a lint may be configured to. `off` is a lint's alone: a type error is not
-- a judgement to disagree with.
local LEVELS: {[string]: boolean} = {off = true, note = true, warning = true, error = true,}

-- The categories whose members may default to `off`, so a project meets them by asking
-- rather than by being told.
--
-- Every other lint answers "is this program wrong", which is worth saying unprompted. A
-- performance suggestion answers "would a different declaration be faster", and the
-- honest answer depends on how the value is used -- how many are built, and whether
-- they are built in a loop -- which no declaration states. Reported unprompted it would
-- fire on every small record of numbers, most of which are not hot, and a lint that is
-- usually noise trains its reader to silence the category before ever meeting the case
-- it was written for. `nupp lints` is where these are discovered.
--
-- Migration lints report spellings that remain correct while a replacement is being
-- adopted. Migration tooling opts in to find them without adding noise to every build.
local OPT_IN: {[string]: boolean} = {performance = true, migration = true}

--- What each category is for, keyed by its name.
lints.categories = CATEGORIES

--- The levels a lint may be configured to.
lints.levels = LEVELS

--- The categories whose members may default to `off`, keyed by name.
lints.optIn = OPT_IN

--- The lint a name or a code refers to, or nil.
---
--- @param key the lint's name or its code
function lints.get(key: string): lints.Lint?
    return byKey[key]
end

--- The level a lint runs at, given a project's `lints` configuration. A category is
--- applied first so a name written beside it still wins.
---
--- @param lint the registry entry
--- @param config the project's lints table, or nil
--- @return "off", "note", "warning" or "error"
function lints.level(lint: lints.Lint, config: {[string]: string}?): string
    local level = lint.level
    if config then
        local byCategory = config[lint.category]
        if byCategory and LEVELS[byCategory] then
            level = byCategory
        end
        local byName = config[lint.name] or config[lint.code]
        if byName and LEVELS[byName] then
            level = byName
        end
    end

    return level
end

return lints
