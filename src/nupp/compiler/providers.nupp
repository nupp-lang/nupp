module nupp.compiler.providers

--[[
Prototype runtime-provider selection for portable standard-library facilities.

The compiler records one explicit module name and installs a lazy adapter for
the host boundary the checked standard module already opens. It never searches
for an installed implementation and it emits nothing when no provider was
selected.

Only JSON is wired for the spike. The point is to exercise the seam end to end:
manifest validation, generated selection, lazy loading, contract validation and
suppression of the native provider build. Runtime behavior lives in the checked
`nupp.runtime.seam.json` module; this compiler module emits only a call that
names the selected module.
]]

local providers = {}
local runtimeBackend = require("nupp.runtime.backend")
local jsonSeam = require("nupp.runtime.seam.json")

local KNOWN = {json = true,}

function providers.names(): {string}
    local names = {}
    for name in pairs(KNOWN) do
        names[#names + 1] = name
    end
    table.sort(names)

    return names
end

function providers.validate(selected: any, label: string): boolean?, string?
    if selected == nil then
        return true
    end
    if type(selected) ~= "table" then
        return nil, label .. " must be a table"
    end
    for name, moduleName in pairs(selected) do
        if type(name) ~= "string" or not KNOWN[name] then
            return nil, label .. " names no provider contract " .. tostring(name)
        end
        if type(moduleName) ~= "string" or moduleName == "" then
            return nil, label .. "." .. name .. " must be a non-empty module name"
        end
        if name == "json" and moduleName == "jsonNative" then
            return nil, label .. ".json must name an adapter module, not jsonNative itself"
        end
    end

    return true
end

--- Removes native features replaced by an explicit runtime provider.
function providers.withoutNative(effects: {[string]: boolean}, selected: {[string]: string}?): {[string]: boolean}
    if selected and selected.json then
        effects["native.json"] = nil
    end

    return effects
end

--- Generated before a module body, and empty when no reached effect selected one.
function providers.bootstrap(effects: {[string]: any}?, selected: {[string]: string}?): string
    if selected and selected.json and effects and effects["native.json"] then
        return (
            "require(%q).install(require(%q).backend(%q));"
        ):format(runtimeBackend.moduleName, jsonSeam.moduleName, selected.json)
    end

    return ""
end

export = providers
