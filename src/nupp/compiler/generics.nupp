--[[
Substitution and instantiation over interned types.

A generic declaration is one type with binders in it; every use is that type with
the binders replaced. Doing the replacing, and working out what to replace them
with from the arguments at a call, are operations on types alone — no scopes, no
tree, nothing to report — so they live here rather than inside the checker that
decides when to ask for them.

Applying the same arguments to the same declaration yields the identical type, so
`Box<number>` is `Box<number>` everywhere.
]]

local T = require("nupp.compiler.types")
local narrowing = require("nupp.compiler.narrowing")

local generics = {}

--- A type, as nupp.compiler.types builds them.
local type Type = T.Type

--- What a binder stands for, per instantiation.
local type Bindings = {[any]: any}

--- What becomes of a binder the map does not name. Preserving leaves it standing,
--- which is what rebinding one binder among several needs; materializing fills it with
--- `any`, which is what a call site does with a binder inference never reached.
---
--- These are never written at a call site: `rebind` and `materialize` below name the
--- choice, so no caller passes a flag and none of them can pick by accident.
local EMPTY: Bindings = {}

local PRESERVE = "preserve"
local MATERIALIZE = "materialize"

--- Normalization state, carried through the walk when one is running. Absent means
--- the walk is an ordinary substitution and a projection is rebuilt, not reduced.
---
--- Findings are collected as data. The type layer does not diagnose: a cycle is a fact
--- about the types, and which code is at fault is the checker's to say.
local type Normalizing = {
    --- Projection answers currently being reduced, so a cycle is met once rather than
    --- followed forever.
    active: {[string]: boolean},

    --- Their labels, innermost last, so the cycle can be reported as the loop it is.
    path: {string},

    --- Projections whose head reduced to `any`, in the order met. The result is `any`
    --- there, and this is what later tells a lint the `any` came from a projection
    --- rather than from somebody writing one.
    gradual: {string},

    --- The labels on a cycle, once one is found.
    cycle: {string}?
}

local reduceProjection: function(
    head: Type,
    name: string,
    map: Bindings,
    unmapped: string,
    norm: Normalizing
): Type

local substWith: function(t: Type, map: Bindings, unmapped: string, norm: Normalizing?): Type

--- A pack with its binders replaced per `map`, unmapped ones per `unmapped`.
local substPackWith: function(pack: T.Pack, map: Bindings, unmapped: string, norm: Normalizing?): T.Pack

substPackWith = function(pack: T.Pack, map: Bindings, unmapped: string, norm: Normalizing?): T.Pack
    if pack.alternatives then
        local alternatives = {}
        for j, arm in ipairs(pack.alternatives) do
            alternatives[j] = substPackWith(arm, map, unmapped, norm)
        end
        return T.packUnion(alternatives)
    end
    local head, modes = {}, {}
    for j, value in ipairs(pack.head) do
        head[j] = substWith(value, map, unmapped, norm)
        modes[j] = pack.modes[j] or "plain"
    end
    local tail = pack.tail
    if tail and tail.kind == "homogeneous" then
        tail = {kind = "homogeneous", type = substWith(tail.type, map, unmapped, norm), mode = tail.mode}
    elseif tail and tail.kind == "generic" then
        local replacement = map[tail.var]
        if replacement and replacement.tag == "pack" then
            for j, value in ipairs(replacement.head) do
                head[#head + 1] = value
                modes[#modes + 1] = replacement.modes[j] or "plain"
            end
            tail = replacement.tail
        elseif unmapped == PRESERVE then
            -- Left standing: the caller is rebinding something else and this pack
            -- binder is still the pack binder it was.
            tail = tail
        else
            tail = {kind = "unknown", type = T.any}
        end
    end

    return T.pack(head, tail, modes)
end

substWith = function(t: Type, map: Bindings, unmapped: string, norm: Normalizing?): Type
    if not T.hasTypevar(t) and not (norm ~= nil and T.hasProjection(t)) then
        return t
    end
    local tag = t.tag
    if tag == "projection" then
        local head = substWith(t.of, map, unmapped, norm)
        if not norm then
            -- Substituted, not reduced. Making the head concrete is what makes a
            -- projection reducible; running that to a fixed point is `normalize`.
            return T.projection(head, t.name)
        end

        return reduceProjection(head, t.name, map, unmapped, norm)
    end
    if tag == "typevar" then
        local bound = map[t]
        if bound then
            return bound
        end

        return unmapped == PRESERVE and t or T.any
    elseif tag == "array" then
        return T.array(substWith(t.elem, map, unmapped, norm))
    elseif tag == "map" then
        return T.indexer(
            t.readable and substWith(t.key, map, unmapped, norm) or nil,
            t.readable and substWith(t.value, map, unmapped, norm) or nil,
            t.writeKey and substWith(t.writeKey, map, unmapped, norm) or nil,
            t.writeValue and substWith(t.writeValue, map, unmapped, norm) or nil
        )
    elseif tag == "tuple" then
        local elems: {Type} = {}
        for j, e in ipairs(t.elems) do
            elems[j] = substWith(e, map, unmapped, norm)
        end
        return T.tuple(elems)
    elseif tag == "shape" then
        local fields = {}
        for j, f in ipairs(t.fields) do
            fields[
                j
            ] = {
                name = f.name,
                read = f.read and substWith(f.read, map, unmapped, norm) or nil,
                write = f.write and substWith(f.write, map, unmapped, norm) or nil
            }
        end
        return T.shape(
            fields,
            {
                readKey = t.indexReadKey and substWith(t.indexReadKey, map, unmapped, norm) or nil,
                readValue = t.indexReadValue and substWith(t.indexReadValue, map, unmapped, norm) or nil,
                writeKey = t.indexWriteKey and substWith(t.indexWriteKey, map, unmapped, norm) or nil,
                writeValue = t.indexWriteValue and substWith(t.indexWriteValue, map, unmapped, norm) or nil,
            },
            t.fresh
        )
    elseif tag == "union" then
        local members: {Type} = {}
        for j, m in ipairs(t.members) do
            members[j] = substWith(m, map, unmapped, norm)
        end
        return T.union(members)
    elseif tag == "intersection" then
        local members: {Type} = {}
        for j, m in ipairs(t.members) do
            members[j] = substWith(m, map, unmapped, norm)
        end
        return T.intersection(members)
    elseif tag == "ptr" then
        return T.ptr(substWith(t.elem, map, unmapped, norm))
    elseif tag == "owned" then
        return T.owned(substWith(t.inner, map, unmapped, norm), t.cleanups)
    elseif tag == "borrowed" then
        return T.borrowed(substWith(t.inner, map, unmapped, norm))
    elseif tag == "pinned" then
        return T.pinned(substWith(t.inner, map, unmapped, norm))
    elseif tag == "metatable" then
        return T.metatable(substWith(t.of, map, unmapped, norm))
    elseif tag == "protocolThread" then
        return T.protocolThread(
            substPackWith(t.startPack, map, unmapped, norm),
            substPackWith(t.resumePack, map, unmapped, norm),
            substPackWith(t.yieldPack, map, unmapped, norm),
            substPackWith(t.returnPack, map, unmapped, norm)
        )
    elseif tag == "genericAlias" then
        return substWith(t.body, map, unmapped, norm)
    elseif tag == "func" then
        local paramPack = substPackWith(t.paramPack, map, unmapped, norm)
        local retPack = substPackWith(t.retPack, map, unmapped, norm)
        local params, rets = paramPack.head, retPack.head
        local bounds: {Type}? = nil
        if t.typeBounds then
            bounds = {}
            for j, b in ipairs(t.typeBounds) do
                bounds[j] = substWith(b, map, unmapped, norm)
            end
        end
        return T.func(params, rets, t.vararg, t.paramModes, t.predicate, t.typeParams, bounds, t.borrowsParam, t.borrowsSelf, t.borrowsParams, t.ffiOut, t.varargType and substWith(
            t.varargType, map, unmapped, norm) or nil, t.noreturn, paramPack, retPack, t.packParams, t.yieldPack and substPackWith(
            t.yieldPack, map, unmapped, norm) or nil, t.resumePack and substPackWith(t.resumePack, map, unmapped, norm) or nil,
            -- Substitution changes what a function takes and answers, never whether
            -- calling it may suspend. Dropping the qualifier here would silently
            -- downgrade every generic call site to may-yield.
            t.noYield, t.paramNames)
    end

    return t
end

--- One projection, reduced as far as it goes.
---
--- Three answers rather than one. A gradual head makes the projection `any`, and says
--- so, because that `any` is the feature declining to say anything rather than somebody
--- writing `any`. A head that is still a binder, or a declaration that answers nothing
--- of this name, leaves the projection standing -- that is what "opaque" means, and it
--- is a normal form, not a failure. Only an answer reduces, and reducing it recurses,
--- which is what makes this a fixed point rather than one hop.
reduceProjection = function(head: Type, name: string, map: Bindings, unmapped: string, norm: Normalizing): Type
    if head == T.any then
        norm.gradual[#norm.gradual + 1] = name

        return T.any
    end
    if head.tag ~= "nominal" then
        return T.projection(head, name)
    end
    -- Deliberately not `nestedTypes`: a plain nested alias answers no contract, so a
    -- private alias that happens to share a name with somebody's associated type is
    -- not an answer and must not reduce one.
    local answers = (head as T.Nominal).associatedAnswers
    local answer = answers and answers[name] or nil
    if not answer then
        return T.projection(head, name)
    end
    local key = head.id .. "." .. name
    local label = T.tostring(head) .. "." .. name
    if norm.active[key] then
        -- Met twice on one chain. Record the loop from where it was entered and stop,
        -- leaving the projection standing: `any` here would turn a program that cannot
        -- be typed into one that silently checks.
        if not norm.cycle then
            local loop: {string} = {}
            local from = nil
            for j, seen in ipairs(norm.path) do
                if seen == label then
                    from = j
                    break
                end
            end
            for j = from or #norm.path, #norm.path do
                loop[#loop + 1] = norm.path[j]
            end
            loop[#loop + 1] = label
            norm.cycle = loop
        end

        return T.projection(head, name)
    end
    norm.active[key] = true
    norm.path[#norm.path + 1] = label
    -- Recursing with the state is what makes this a fixed point: an answer that is
    -- itself a projection reduces here rather than being handed back half done.
    local reduced = substWith(answer, map, unmapped, norm)
    norm.path[#norm.path] = nil
    norm.active[key] = nil

    return reduced
end

--- What normalizing produced.
type generics.Normalized = {
    --- The reduced type. A projection nothing could reduce is still that projection,
    --- and one on a cycle is where the walk stopped -- never `any`.
    type: Type,

    --- Projections whose head was gradual, in the order met. Empty when none were.
    gradual: {string},

    --- The labels on a cycle, when the walk met one.
    cycle: {string}?
}

--- Reduces every projection in `t` to a fixed point.
---
--- Separate from substitution on purpose. Substituting a head is what makes a
--- projection reducible, and a constructor that reduced one hop would look like this
--- and quietly not be it. Normalizing an already normalized type returns it unchanged.
---
--- @param t the type to reduce
function generics.normalize(t: Type): generics.Normalized
    if not T.hasProjection(t) then
        return {type = t, gradual = {}}
    end
    local norm: Normalizing = {active = {}, path = {}, gradual = {}}
    local reduced = substWith(t, EMPTY, PRESERVE, norm)

    return {type = reduced, gradual = norm.gradual, cycle = norm.cycle}
end

--- What normalizing a value sequence produced.
type generics.NormalizedPack = {pack: T.Pack, gradual: {string}, cycle: {string}?}

--- `generics.normalize` for a value sequence.
function generics.normalizePack(pack: T.Pack): generics.NormalizedPack
    local norm: Normalizing = {active = {}, path = {}, gradual = {}}
    local reduced = substPackWith(pack, EMPTY, PRESERVE, norm)

    return {pack = reduced, gradual = norm.gradual, cycle = norm.cycle}
end

--- Rebuilds `t` with the binders `map` names replaced, and every other binder left
--- standing. This is what rebinding one thing among several means: `self` over an
--- inherited member, a declaration's parameters over a member that also has its own.
--- Using the materializing form for that erased the binders it was not rebinding, and
--- a generic method quietly stopped inferring.
---
--- @param t the type to substitute into
--- @param map what each binder stands for
function generics.rebind(t: Type, map: Bindings): Type
    return substWith(t, map, PRESERVE, nil)
end

--- Rebuilds `t` with the binders `map` names replaced, and every binder it does not
--- name filled with `any`. This is what a call site does once inference has run: a
--- parameter nothing reached leaves the application gradual rather than leaking a
--- binder into the caller.
---
--- @param t the type to substitute into
--- @param map what inference worked out
function generics.materialize(t: Type, map: Bindings): Type
    return substWith(t, map, MATERIALIZE, nil)
end

--- `generics.rebind` for a value sequence.
function generics.rebindPack(pack: T.Pack, map: Bindings): T.Pack
    return substPackWith(pack, map, PRESERVE, nil)
end

--- `generics.materialize` for a value sequence.
function generics.materializePack(pack: T.Pack, map: Bindings): T.Pack
    return substPackWith(pack, map, MATERIALIZE, nil)
end

--- Instantiates a generic function as one monomorphic callable. This is used when a
--- universally generic function value is assigned to a concrete function type; the
--- target signature supplies the arguments that an ordinary call would have supplied.
function generics.instantiateFunction(t: T.Func, map: Bindings): T.Func
    local concrete = substWith(t, map, MATERIALIZE, nil)
    if concrete.tag ~= "func" then
        return t
    end

    return T.func(
        concrete.paramPack.head,
        concrete.retPack.head,
        concrete.paramPack.tail ~= nil,
        concrete.paramPack.modes,
        concrete.predicate,
        nil,
        nil,
        concrete.borrowsParam,
        concrete.borrowsSelf,
        concrete.borrowsParams,
        concrete.ffiOut,
        concrete.varargType,
        concrete.noreturn,
        concrete.paramPack,
        concrete.retPack,
        nil,
        concrete.yieldPack,
        concrete.resumePack,
        concrete.noYield,
        concrete.paramNames
    ) as T.Func
end

--- Structurally matches an actual value sequence against a declared pack.
function generics.unifyPack(param: T.Pack, arg: T.Pack, map: Bindings): nil
    if param.alternatives then
        for _, arm in ipairs(param.alternatives) do
            generics.unifyPack(arm, arg, map)
        end
        return
    end
    for j, expected in ipairs(param.head) do
        generics.unify(expected, T.packAt(arg, j) or T.nil_, map)
    end
    local tail = param.tail
    if not tail then
        return
    end
    if tail.kind == "generic" then
        local rest, modes = {}, {}
        for j = #param.head + 1, #arg.head do
            rest[#rest + 1] = arg.head[j]
            modes[#modes + 1] = arg.modes[j] or "plain"
        end
        local actualTail = #param.head < #arg.head and arg.tail or arg.tail
        local remaining = T.pack(rest, actualTail, modes)
        local prior = map[tail.var]
        if prior then
            for j, value in ipairs(remaining.head) do
                generics.unify(T.packAt(prior, j) or T.nil_, value, map)
            end
        else
            map[tail.var] = remaining
        end
    elseif tail.kind == "homogeneous" then
        for j = #param.head + 1, #arg.head do
            generics.unify(tail.type, arg.head[j], map)
        end
        if arg.tail and arg.tail.kind == "homogeneous" then
            generics.unify(tail.type, arg.tail.type, map)
        end
    end
end

-- Applying type arguments to a generic declaration yields a distinct nominal whose
-- fields are substituted. Identical arguments give the identical type, so the
-- instantiations are kept rather than rebuilt.
local instantiations: {[string]: T.Nominal} = {}

--- The nominal `n` stands for once its parameters hold `map`.
---
--- @param n the generic declaration
--- @param map what each binder stands for
function generics.instantiate(n: T.Nominal, map: Bindings): T.Nominal
    local parts = {n.id}
    for _, tv in ipairs(n.typeParams or {}) do
        parts[#parts + 1] = (map[tv] or T.any).id
    end
    local key = table.concat(parts, "|")
    local cached = instantiations[key]
    if cached then
        return cached
    end
    local inst = T.nominal(n.name, n.declKind)
    inst.origin = n
    inst.typeArgs = {}
    for j, tv in ipairs(n.typeParams or {}) do
        inst.typeArgs[j] = map[tv] or T.any
    end
    inst.fieldOrder = n.fieldOrder
    inst.expansions = n.expansions
    inst.arrayOf = n.arrayOf and substWith(n.arrayOf, map, PRESERVE, nil) or nil
    inst.fieldDefs = n.fieldDefs
    inst.writeFieldDefs = n.writeFieldDefs
    inst.staticFieldDefs = n.staticFieldDefs
    inst.staticWriteFieldDefs = n.staticWriteFieldDefs
    inst.selfType = n.selfType
    inst.supertypes = {}
    for j, parent in ipairs(n.supertypes or {}) do
        inst.supertypes[j] = substWith(parent, map, PRESERVE, nil)
    end
    -- cached before the members are filled in, so a declaration that names itself finds
    -- the instantiation under way rather than recurring
    instantiations[key] = inst
    for name, ft in pairs(n.byname) do
        inst.byname[name] = substWith(ft, map, PRESERVE, nil)
    end
    for name, ft in pairs(n.writeByname or {}) do
        inst.writeByname[name] = substWith(ft, map, PRESERVE, nil)
    end
    for name, ft in pairs(n.staticByname or {}) do
        inst.staticByname[name] = substWith(ft, map, PRESERVE, nil)
    end
    for name, ft in pairs(n.staticWriteByname or {}) do
        inst.staticWriteByname[name] = substWith(ft, map, PRESERVE, nil)
    end
    inst.overloadedMethods = {}
    inst.overloadedStatics = {}
    inst.methodEntries = {}
    inst.methodDispatchEntries = {}
    inst.staticEntries = {}
    for name in pairs(n.overloadedMethods or {}) do
        inst.overloadedMethods[name] = true
    end
    for name in pairs(n.overloadedStatics or {}) do
        inst.overloadedStatics[name] = true
    end
    for name, entries in pairs(n.methodEntries or {}) do
        local specialized = {}
        for j, entry in ipairs(entries) do
            specialized[
                j
            ] = {
                signature = substWith(entry.signature, map, PRESERVE, nil),
                declaration = entry.declaration,
                member = entry.member,
                parameterKey = entry.parameterKey,
                definition = entry.definition,
            }
        end
        inst.methodEntries[name] = specialized
    end
    for name, entries in pairs(n.methodDispatchEntries or {}) do
        local specialized = {}
        for j, entry in ipairs(entries) do
            specialized[
                j
            ] = {
                signature = substWith(entry.signature, map, PRESERVE, nil),
                declaration = entry.declaration,
                member = entry.member,
                parameterKey = entry.parameterKey,
                definition = entry.definition,
            }
        end
        inst.methodDispatchEntries[name] = specialized
    end
    for name, entries in pairs(n.staticEntries or {}) do
        local specialized = {}
        for j, entry in ipairs(entries) do
            specialized[
                j
            ] = {
                signature = substWith(entry.signature, map, PRESERVE, nil),
                declaration = entry.declaration,
                member = entry.member,
                parameterKey = entry.parameterKey,
                definition = entry.definition,
            }
        end
        inst.staticEntries[name] = specialized
    end
    inst.indexReadKey = n.indexReadKey and substWith(n.indexReadKey, map, PRESERVE, nil) or nil
    inst.indexReadValue = n.indexReadValue and substWith(n.indexReadValue, map, PRESERVE, nil) or nil
    inst.indexWriteKey = n.indexWriteKey and substWith(n.indexWriteKey, map, PRESERVE, nil) or nil
    inst.indexWriteValue = n.indexWriteValue and substWith(n.indexWriteValue, map, PRESERVE, nil) or nil
    for name, ft in pairs(n.metamethods or {}) do
        inst.metamethods[name] = substWith(ft, map, PRESERVE, nil)
    end
    inst.constructors = {}
    inst.constructorEntries = {}
    for j, signature in ipairs(n.constructors or {}) do
        local specialized = substWith(signature, map, PRESERVE, nil)
        inst.constructors[j] = specialized
        local entry = n.constructorEntries and n.constructorEntries[j] or nil
        inst.constructorEntries[
            j
        ] = {
            signature = specialized,
            declaration = entry and entry.declaration or nil,
            index = entry and entry.index or j,
        }
    end

    return inst
end

--- Structurally matches an argument type against a parameter type, accumulating what
--- the binders must stand for. Repeat bindings union together, so a binder in two
--- positions holds what both arguments were.
---
--- @param param the declared parameter type, binders and all
--- @param arg what the call passed there
--- @param map accumulates the bindings
function generics.unify(param: Type, arg: Type, map: Bindings): nil
    param, arg = T.unwrapOwnership(param), T.unwrapOwnership(arg)
    if not T.hasTypevar(param) then
        return
    end
    local tag = param.tag
    if tag == "typevar" then
        if arg ~= T.any and arg ~= T.nil_ then
            -- A binder in two positions holds what both arguments were. An index by a
            -- computed key has no name to narrow, so the previous binding is read into
            -- one.
            local bound = map[param]
            map[param] = bound and T.union({bound, arg}) or arg
        end
    elseif tag == "array" then
        if arg.tag == "array" then
            generics.unify(param.elem, arg.elem, map)
        elseif arg.tag == "tuple" then
            for _, e in ipairs(arg.elems) do
                generics.unify(param.elem, e, map)
            end
        end
    elseif tag == "metatable" then
        -- `metatable<T>` is how a registrar asks for a declaration's own table, so the
        -- receiver it describes is what binds T -- and what the bound is then checked
        -- against.
        if arg.tag == "metatable" then
            generics.unify(param.of, arg.of, map)
        end
    elseif tag == "map" then
        if arg.tag == "map" then
            if param.readable and arg.readable then
                generics.unify(param.key, arg.key, map)
                generics.unify(param.value, arg.value, map)
            end
            if param.writeKey and arg.writeKey then
                generics.unify(param.writeKey, arg.writeKey, map)
                generics.unify(param.writeValue, arg.writeValue, map)
            end
        end
    elseif tag == "union" then
        -- "T?"-style params: subtract the concrete members from the argument, the
        -- residue binds the typevar (assert(x: T?): T with x: number? binds T = number,
        -- not number?)
        local tv: Type? = nil
        local rest: {Type} = {}
        for _, m in ipairs(param.members) do
            if m.tag == "typevar" and not tv then
                tv = m
            else
                rest[#rest + 1] = m
            end
        end
        if tv then
            local residue = arg
            for _, r in ipairs(rest) do
                residue = narrowing.subtract(residue, r)
            end
            generics.unify(tv, residue, map)
        end
        for _, r in ipairs(rest) do
            generics.unify(r, arg, map)
        end
    elseif tag == "intersection" then
        -- Every conjunct constrains the same runtime argument. In particular this lets
        -- `T & Bound` infer T while compatibility proves the other contracts.
        for _, member in ipairs(param.members) do
            generics.unify(member, arg, map)
        end
    elseif tag == "shape" then
        local reads = arg.tag == "shape" and arg.byname or (arg.tag == "nominal" and arg.byname)
        local writes = arg.tag == "shape" and arg.writeByname or (arg.tag == "nominal" and arg.writeByname)
        if reads or writes then
            for _, f in ipairs(param.fields) do
                local read = reads and reads[f.name]
                local write = writes and writes[f.name]
                if f.read and read then
                    generics.unify(f.read, read, map)
                end
                if f.write and write then
                    generics.unify(f.write, write, map)
                end
            end
        end
    elseif tag == "func" then
        if arg.tag == "func" then
            generics.unifyPack(param.paramPack, arg.paramPack, map)
            generics.unifyPack(param.retPack, arg.retPack, map)
        end
    elseif tag == "nominal" then
        if arg.tag == "nominal" then
            local po = param.origin or param
            local ao = arg.origin or arg
            if po == ao then
                for j, p in ipairs(param.typeArgs or {}) do
                    local a = arg.typeArgs and arg.typeArgs[j]
                    if a then
                        generics.unify(p, a, map)
                    end
                end
            end
        end
    elseif tag == "ptr" then
        if arg.tag == "ptr" then
            generics.unify(param.elem, arg.elem, map)
        end
    end
end

--- A member's type as the receiver reaching it sees it: `self` inside a declaration
--- stands for whatever the value actually is, which is what lets an inherited contract
--- be rebound to the child that included it.
---
--- @param owner the declaration the member belongs to
--- @param ft the member's type
--- @param receiver what `self` stands for here, `owner` by default
function generics.specializeSelf(owner: Type?, ft: Type, receiver: Type?): Type
    if ft.tag == "intersection" then
        local members = {}
        for j, member in ipairs(ft.members) do
            members[j] = generics.specializeSelf(owner, member, receiver)
        end
        return T.intersection(members)
    end
    if owner and owner.tag == "nominal" and owner.selfType then
        -- Rebinding, not materializing: `self` is the only binder this names, and a
        -- method's own parameters have to survive it. The materializing form replaced
        -- each with `any`, so a generic method stopped inferring and its result fit
        -- wherever it was put.
        return generics.rebind(ft, {[owner.selfType] = receiver or owner})
    end

    return ft
end

--- A method's type as a plain function, receiver removed. Method-call receivers are
--- passed implicitly, so `o:m(x)` checks against the signature without its first
--- parameter.
---
--- @param ft the method's type
function generics.dropSelf(ft: Type): Type
    if ft.tag == "intersection" then
        local members = {}
        for j, member in ipairs(ft.members) do
            members[j] = generics.dropSelf(member)
        end
        return T.intersection(members)
    end
    if ft.tag == "func" and #ft.params >= 1 then
        local params: {Type} = {}
        local modes: {string} = {}
        local names: {string} = {}
        for j = 2, #ft.params do
            params[#params + 1] = ft.params[j]
        end
        for j = 2, #ft.params do
            modes[#modes + 1] = ft.paramModes and ft.paramModes[j] or "plain"
            names[#names + 1] = ft.paramNames and ft.paramNames[j] or ""
        end
        local paramPack = T.pack(params, ft.paramPack.tail, modes)
        return T.func(params, ft.rets, ft.vararg, modes, nil, ft.typeParams, ft.typeBounds, ft.borrowsParam, ft.borrowsSelf, ft.borrowsParams, ft.ffiOut, ft.varargType, ft.noreturn, paramPack, ft.retPack, ft.packParams, ft.yieldPack, ft.resumePack,
            -- Adjusting the receiver rewrites a parameter list, not an effect.
            ft.noYield, names)
    end

    return ft
end

--- The same in reverse: a function stored as a member takes the receiver first, which
--- is the shape a declaration file writes.
---
--- @param ft the function's type
--- @param selfType what the receiver is
--- @param selfMode the receiver's ownership mode, "plain" by default
function generics.addSelf(ft: Type, selfType: Type, selfMode: string?): Type
    if ft.tag == "intersection" then
        local members = {}
        for j, member in ipairs(ft.members) do
            members[j] = generics.addSelf(member, selfType, selfMode)
        end
        return T.intersection(members)
    end
    if ft.tag ~= "func" then
        return ft
    end
    local params: {Type} = {selfType}
    local modes: {string} = {selfMode or "plain"}
    local names: {string} = {"self"}
    for _, p in ipairs(ft.params) do
        params[#params + 1] = p
    end
    for _, mode in ipairs(ft.paramModes or {}) do
        modes[#modes + 1] = mode
    end
    for _, name in ipairs(ft.paramNames or {}) do
        names[#names + 1] = name
    end
    local paramPack = T.pack(params, ft.paramPack.tail, modes)

    return T.func(
        params,
        ft.rets,
        ft.vararg,
        modes,
        ft.predicate,
        ft.typeParams,
        ft.typeBounds,
        ft.borrowsParam,
        ft.borrowsSelf,
        ft.borrowsParams,
        ft.ffiOut,
        ft.varargType,
        ft.noreturn,
        paramPack,
        ft.retPack,
        ft.packParams,
        ft.yieldPack,
        ft.resumePack,
        ft.noYield,
        names
    )
end

return generics
