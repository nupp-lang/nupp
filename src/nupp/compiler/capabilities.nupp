module nupp.compiler.capabilities

-- Source representations and calling conventions are fixed by the target dialect.
local capabilities = {}

local CONTRACTS = {
    bitops = {service = "numeric.bitops", effect = "runtime.bitops"},
    int64 = {service = "numeric.int64", effect = "runtime.int64"},
    structvalue = {service = "representation.structvalue", effect = "runtime.structvalue"},
    cstorage = {service = "representation.cstorage", effect = "runtime.cstorage"},
    simd = {service = "numeric.simd", effect = "runtime.simd"},
    cinterop = {},
    presize = {compiler = true},
}

--- Resolves compiler-owned capabilities without loading or selecting providers.
function capabilities.resolve(dialect: string): any
    local resolved = {dialect = dialect, byName = {}}
    for name, contract in pairs(CONTRACTS) do
        local kind = "missing"
        if dialect == "luajit" or dialect == "luajit-compat" then
            kind = "native"
        elseif dialect == "lua51" then
            if contract.compiler then
                kind = "compiler"
            elseif contract.service then
                kind = "service"
            end
        end
        resolved.byName[name] = {kind = kind, name = name, service = contract.service, effect = contract.effect}
    end

    return resolved
end

--- Looks up one compiler-owned capability, rejecting invented names.
function capabilities.get(resolved: any, name: string): any
    local capability = resolved and resolved.byName and resolved.byName[name] or nil
    assert(CONTRACTS[name] ~= nil and capability ~= nil, "unknown language capability " .. name)

    return capability
end

--- The checker's capability resolution, computed once and remembered on its options.
local function resolution(checker: any): any
    local resolved = checker.opts._capabilityResolution
    if resolved == nil then
        resolved = capabilities.resolve(checker.opts.dialect)
        checker.opts._capabilityResolution = resolved
    end

    return resolved
end

--- Whether a target has one compiler-owned capability, without reporting.
---
--- For a caller deciding what to do next rather than only what to say. `require`
--- answers the same question by reporting it.
function capabilities.available(checker: any, name: string): boolean
    return capabilities.get(resolution(checker), name).kind ~= "missing"
end

--- Reports a missing capability at the source construct that requires it.
function capabilities.require(checker: any, name: string, at: any): boolean
    local capability = capabilities.get(resolution(checker), name)
    if capability.kind ~= "missing" then
        return true
    end
    checker.diag("NUPP3006", at, ("the `%s` dialect has no `%s` capability"):format(checker.opts.dialect, name))

    return false
end

export = capabilities
