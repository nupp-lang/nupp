module nupp.compiler.capabilities

-- Source representations and calling conventions are fixed by the compiler: every
-- artifact runs on the VM, so each capability is native unless a caller narrows it.

-- The exported require function validates a capability; it never loads code.
const _DYNAMIC_REQUIRES = "@requires-dynamically nothing"

local CONTRACTS: {[string]: {
    effect: string?,
    compiler: boolean?
}} = {
    bitops = {effect = "runtime.bitops"},
    int64 = {effect = "runtime.int64"},
    structvalue = {effect = "runtime.structvalue"},
    cstorage = {effect = "runtime.cstorage"},
    simd = {compiler = true},
    cinterop = {},
    presize = {compiler = true},
}

--- Resolves compiler-owned capabilities without loading or selecting providers.
export function resolve(): any
    local resolved = {byName = {}}
    for name, contract in pairs(CONTRACTS) do
        resolved.byName[name] = {kind = "native", name = name, effect = contract.effect}
    end

    return resolved
end

--- Looks up one compiler-owned capability, rejecting invented names.
export function get(resolved: any, name: string): any
    local capability = resolved and resolved.byName and resolved.byName[name] or nil
    assert(CONTRACTS[name] ~= nil and capability ~= nil, "unknown language capability " .. name)

    return capability
end

--- The checker's capability resolution, computed once and remembered on its options.
local function resolution(checker: any): any
    local resolved = checker.opts._capabilityResolution
    if resolved == nil then
        resolved = resolve()
        checker.opts._capabilityResolution = resolved
    end

    return resolved
end

--- Whether a target has one compiler-owned capability, without reporting.
---
--- For a caller deciding what to do next rather than only what to say. `require`
--- answers the same question by reporting it.
export function available(checker: any, name: string): boolean
    return get(resolution(checker), name).kind ~= "missing"
end

--- Reports a missing capability at the source construct that requires it.
export function require(checker: any, name: string, at: any): boolean
    local capability = get(resolution(checker), name)
    if capability.kind ~= "missing" then
        return true
    end
    local because = capability.reason and ": " .. capability.reason or ""
    checker.diag("NUPP3006", at, ("this compiler has no `%s` capability%s"):format(name, because))

    return false
end
