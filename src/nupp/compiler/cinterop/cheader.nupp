module nupp.compiler.cinterop.cheader

--[[
Typing a C header at compile time, with no import step.

The header is handed to the compiler's own `ffi.cdef`, and the resulting
declarations are read back out through `ffi.typeinfo`. LuaJIT's C parser is
therefore the source of truth for what a header declares rather than a separate
pattern matcher. The sizes it reports are the ones that hold on the machine
doing the build, so `long` and `size_t` follow the target platform instead of a
generated bindings file.

Most headers a project owns need no preprocessing at all: dropping the
directives is enough for LuaJIT. A conditional is not, since only a preprocessor
can pick its branch, so one is refused unless C itself settles it. Headers that
pull in a system include closure, or branch, need `cc -E` first, which the caller
asks for explicitly.
]]

local T = require("nupp.compiler.types")
local cdecl = require("nupp.compiler.cinterop.cdecl")
local hash = require("nupp.compiler.hash")

local cheader = {}

-- C type inspection only needs LuaJIT. File and preprocessor operations resolve
-- their host services lazily so the browser can use the same declaration model.
local function hostService(name: string): any
    return require("nupp.compiler." .. name)
end

--- What a struct tag already stands for in the program being checked, so a header met
--- twice keeps one identity. Nil when nothing has declared it yet.
type cheader.Resolver = function(tag: string): T.Type?

--- How a header is read. `preprocess` runs the system compiler first, for headers whose
--- declarations are written in a vocabulary their includes define.
type cheader.Options = {
    @readonly preprocess: boolean?,
    @readonly cc: string?,
    @readonly ccArgs: {string}?,
    @readonly read: (function(path: string): string?)?,

    --- The path as the program wrote it, for messages.
    @readonly display: string?
}

--- A header as the checker takes it: what it declares, and the text to hand the
--- program's own FFI so the declarations exist at run time too.
type cheader.Header = {
    exports: {[string]: T.Type},
    cdef: string,
    sourcePath: string,
    dependencies: {string},
    semanticFingerprint: string
}

type cheader.Provenance = {
    cdef: string,
    sourcePath: string,
    dependencies: {string},
    semanticFingerprint: string,

    --- The text as LuaJIT parses it at check time: `cdef` with every line in place.
    parseText: string?,

    --- Where each line of `parseText` came from, when the header was preprocessed.
    origins: {{
        file: string,
        line: integer
    }?}?
}

local INT_BY_BITS = {
    [8] = {T.int8, T.uint8},
    [16] = {T.int16, T.uint16},
    [32] = {T.int32, T.uint32},
    [64] = {T.int64, T.uint64},
}

local modelFunction -- defined below; a pointer may be to a function
local adoptStruct -- defined below; aggregate references may be recursive

--- The declaration key of a C aggregate. LuaJIT keeps one C declaration namespace per
--- process, so a tag or a typedef name means one aggregate wherever a header spelled
--- it, and every header that includes the same declaration must share its key. Tags
--- and typedef names are separate namespaces in C, so the key says which it is in.
local function cDeclarationKey(aggregateKind: string, namespace: string, name: string): string
    return "c\0" .. namespace .. "\0" .. aggregateKind .. "\0" .. name
end

-- Every struct type this process has built from LuaJIT's registry, by ctype id. A
-- tag names one registry entry, so it names one type too, whether the struct was met
-- through `cheader` or through a type string: two identities for one tag made the
-- checker answer "Hfa is not a Hfa" to a program passing a struct it built with
-- `ffi.new` to the header's own function.
local adoptedById: {[integer]: T.Type} = {}

-- A neutral C declaration type, as the Nupp type that stands for it.
local function nuppType(model, structs, resolver)
    local kind = model and model.kind or "unknown"
    if kind == "void" then
        return nil -- no value
    elseif kind == "boolean" then
        return T.boolean
    elseif kind == "float" then
        return model.bits == 32 and T.float or T.number
    elseif kind == "integer" then
        local pair = INT_BY_BITS[model.bits]
        if not pair then
            return T.number
        end
        return model.unsigned and pair[2] or pair[1]
    elseif kind == "pointer" then
        local pointee = model.to
        local readOnly = model.const
        if pointee and pointee.kind == "integer" and pointee.bits == 8 and not pointee.unsigned and readOnly then
            -- A const plain or signed character pointer is C text, and LuaJIT fills
            -- one straight from a Lua string. A writable one is a buffer LuaJIT will
            -- not fill from an immutable string, so it stays a byte pointer below, as
            -- import-c renders it. Unsigned character pointers are byte pointers too.
            return T.optional(T.cstring)
        end
        -- Every C pointer may be NULL, and the header does not say which ones are, so
        -- an imported pointer is nullable. A cdef written by hand keeps whatever it
        -- says.
        if pointee and pointee.kind == "function" then
            -- a C function pointer: the shape a callback must match
            return T.optional(modelFunction(pointee, structs, resolver))
        end
        if pointee and (pointee.kind == "struct" or pointee.kind == "union") then
            local named = structs and structs[pointee.id]
            if not named and resolver and pointee.name then
                named = resolver(pointee.name)
            end
            if not named and pointee.id then
                named = adoptedById[pointee.id]
            end
            if not named and pointee.name then
                named = adoptStruct(pointee.name, pointee.kind)
            end
            if named then
                -- the header said whether it writes through this pointer
                if readOnly then
                    named = T.constOf(named)
                end
                return T.optional(T.ptr(named))
            end
        end
        if pointee and pointee.kind ~= "void" then
            local element = nuppType(pointee, structs, resolver)
            if element and element ~= T.any then
                if readOnly then
                    element = T.constOf(element)
                end
                return T.optional(T.ptr(element))
            end
        end
        if readOnly then
            return T.optional(T.constOf(T.voidptr))
        end
        return T.optional(T.voidptr)
    elseif kind == "struct" or kind == "union" then
        local named = structs and structs[model.id]
        if not named and resolver and model.name then
            named = resolver(model.name)
        end
        if not named and model.id then
            named = adoptedById[model.id]
        end
        if not named and model.name then
            named = adoptStruct(model.name, kind)
        end
        if named then
            return named
        end
        return T.voidptr
    elseif kind == "enum" then
        local pair = INT_BY_BITS[model.bits]
        if not pair then
            return T.any
        end
        return model.unsigned and pair[2] or pair[1]
    elseif kind == "array" then
        local element = nuppType(model.of, structs, resolver)
        if element and model.count then
            return T.carray(element, model.count)
        end
        return T.any
    end

    return T.any
end

modelFunction = function(fn, structs, resolver)
    local params = {}
    for _, param in ipairs(fn.params or {}) do
        params[#params + 1] = nuppType(param.type, structs, resolver) or T.any
    end
    local rets = {}
    local ret = nuppType(fn.returns, structs, resolver)
    if ret then
        rets[1] = ret
    end

    return T.func(
        params,
        rets,
        fn.vararg,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        true
    )
end

local function newlinesOf(text: string): string
    return (text:gsub("[^\n]", ""))
end

local function linesOf(text: string): {string}
    local lines: {string} = {}
    for line in (text .. "\n"):gmatch("(.-)\n") do
        lines[#lines + 1] = line
    end

    return lines
end

-- A conditional that tests `__cplusplus`, which a C compiler never defines, so its
-- branch is known without a preprocessor. Answers whether the branch it opens is
-- taken, or nil when the line is some other conditional.
local function cplusplusBranch(line: string): boolean?
    local compact = line:gsub("%s+", "")
    if compact == "#ifdef__cplusplus" or compact == "#ifdefined(__cplusplus)" or compact == "#ifdefined__cplusplus" then
        return false
    end
    if compact == "#ifndef__cplusplus"
        or compact == "#if!defined(__cplusplus)"
        or compact == "#if!defined__cplusplus"
    then
        return true
    end

    return nil
end

-- The name a whole-file include guard tests, from its opening line.
local function guardName(line: string): string?
    return line:match("^%s*#%s*ifndef%s+([%a_][%w_]*)%s*$")
        or line:match("^%s*#%s*if%s*!%s*defined%s*%(%s*([%a_][%w_]*)%s*%)%s*$")
        or line:match("^%s*#%s*if%s*!%s*defined%s+([%a_][%w_]*)%s*$")
end

-- The lines of a header read without a preprocessor, as LuaJIT will see them:
-- comments and directives blanked, every line still where it was, so a line LuaJIT
-- reports is the header's own.
--
-- Dropping directives is enough for most project headers, but not for a
-- conditional. Both branches of `#ifdef _WIN32 ... #else ... #endif` reached LuaJIT,
-- which kept the first, and a block under `#if 0` was declared. So a conditional is
-- refused, naming its line, unless it is one whose branch C itself settles: the
-- whole-file include guard, which is taken, and a test of `__cplusplus`, which is not.
local function unpreprocessedLines(text: string, display: string): ({string}?, string?)
    text = text:gsub("/%*.-%*/", function(comment)
        return " " .. newlinesOf(comment)
    end)
    local lines = linesOf(text)
    for index, line in ipairs(lines) do
        lines[index] = line:gsub("//.*$", "")
    end

    -- The guard: the first line that says anything opens it, the next defines the
    -- name it tests, and its #endif is the last line that says anything.
    local significant: {integer} = {}
    for index, line in ipairs(lines) do
        if line:match("%S") then
            significant[#significant + 1] = index
        end
    end
    local guardAt: integer? = nil
    local name = significant[1] and guardName(lines[significant[1]]) or nil
    local define = significant[2] and lines[significant[2]]:match("^%s*#%s*define%s+([%a_][%w_]*)") or nil
    local last = significant[#significant]
    if name and name == define and last and lines[last]:match("^%s*#%s*endif") then
        guardAt = significant[1]
    end

    local out: {string} = {}
    local stack: {{
        kind: string,
        taken: boolean,
        sawElse: boolean
    }} = {}

    local function live(): boolean
        for _, frame in ipairs(stack) do
            if not frame.taken then
                return false
            end
        end

        return true
    end

    local function refuse(index: integer, why: string): ({string}?, string?)
        return nil, ("%s:%d: %s"):format(display, index, why)
    end

    for index, line in ipairs(lines) do
        local directive = line:match("^%s*#%s*(%a*)")
        if directive then
            out[index] = ""
            local head = line:match("^%s*(#%s*%a*[^\n]*)") or line
            head = head:gsub("%s+$", "")
            if directive == "if" or directive == "ifdef" or directive == "ifndef" then
                local branch = cplusplusBranch(line)
                if index == guardAt then
                    stack[#stack + 1] = {kind = "guard", taken = true, sawElse = false}
                elseif branch ~= nil then
                    stack[#stack + 1] = {kind = "cplusplus", taken = branch, sawElse = false}
                else
                    return refuse(
                        index,
                        head
                        .. " needs cheader's \"preprocess\" argument, since only the preprocessor can pick its branch"
                    )
                end
            elseif directive == "elif" or directive == "elifdef" or directive == "elifndef" then
                return refuse(
                    index,
                    head .. " needs cheader's \"preprocess\" argument, since only the preprocessor can pick its branch"
                )
            elseif directive == "else" then
                local top = stack[#stack]
                if not top or top.kind ~= "cplusplus" or top.sawElse then
                    return refuse(
                        index,
                        "#else needs cheader's \"preprocess\" argument, since only the preprocessor can pick its branch"
                    )
                end
                top.taken = not top.taken
                top.sawElse = true
            elseif directive == "endif" then
                if #stack == 0 then
                    return refuse(index, "#endif closes no conditional")
                end
                stack[#stack] = nil
            end
        else
            out[index] = live() and line or ""
        end
    end
    if #stack > 0 then
        return nil, display .. ": a conditional is never closed"
    end

    return out
end

-- The lines of a preprocessed header, with the linemarkers and pragmas the
-- preprocessor left behind blanked, and where each line came from.
local function preprocessedLines(text: string): ({string}, {{
    file: string,
    line: integer
}?})
    local lines = linesOf(text)
    local origins: {{
        file: string,
        line: integer
    }?} = {}
    local file: string = "?"
    local number: integer = 0
    for index, line in ipairs(lines) do
        local marker, markerFile = line:match('^%s*#%s*(%d+)%s+"([^"]*)"')
        if marker then
            file, number = markerFile, (tonumber(marker) as integer) - 1
            lines[index] = ""
        elseif line:match("^%s*#") then
            number = number + 1
            lines[index] = ""
        else
            number = number + 1
            origins[index] = {file = file, line = number}
        end
    end

    return lines, origins
end

-- The line of a NUL byte, if the text holds one. LuaJIT reads its input as a C
-- string, so everything after a NUL would silently be no header at all.
local function nulLine(text: string): integer?
    local at = text:find("%z")
    if not at then
        return nil
    end
    local _, newlines = text:sub(1, at):gsub("\n", "")

    return newlines + 1
end

-- Only meaningful when the preprocessor runs, but cheap to record always.
local toolchainCache = {}

local function toolchainTag(opts)
    if not opts.preprocess then
        return "-"
    end
    local argv = {opts.cc or "cc"}
    for _, arg in ipairs(opts.ccArgs or {}) do
        argv[#argv + 1] = arg
    end
    argv[#argv + 1] = "--version"
    local key = table.concat(argv, "\0")
    local hit = toolchainCache[key]
    if hit then
        return hit
    end
    local code, output = hostService("process").capture(argv)
    local version = code == 0 and output:match("[^\r\n]+") or "unknown"
    toolchainCache[key] = version

    return version
end

local function toolchainIdentity(opts)
    local parts = {opts.cc or "cc"}
    for _, arg in ipairs(opts.ccArgs or {}) do
        parts[#parts + 1] = arg
    end
    parts[#parts + 1] = toolchainTag(opts)

    return table.concat(parts, "\0")
end

local function compilerArgv(opts, ...)
    local argv = {opts.cc or "cc"}
    for _, arg in ipairs(opts.ccArgs or {}) do
        argv[#argv + 1] = arg
    end
    for _, arg in ipairs({...}) do
        argv[#argv + 1] = arg
    end

    return argv
end

local function dependencyPaths(text, sourcePath)
    local paths = hostService("shellsyntax").depfile:match(text) or {}
    if #paths == 0 then
        paths[1] = sourcePath
    end
    local unique, out = {}, {}
    for _, path in ipairs(paths) do
        path = hostService("fs").canonical(path)
        if not unique[path] then
            unique[path] = true
            out[#out + 1] = path
        end
    end
    table.sort(out)

    return out
end

local function preprocessHeader(path, opts)
    local depPath = os.tmpname()
    local argv = compilerArgv(opts, "-E", "-MD", "-MF", depPath, "-MT", "nupp_header", "-xc", path)
    local code, expanded = hostService("process").capture(argv)
    local depText = hostService("fs").readFile(depPath)
    os.remove(depPath)
    if code ~= 0 then
        return nil, nil, expanded ~= "" and expanded or ("cannot preprocess " .. path)
    end
    if not depText then
        return nil, nil, "compiler did not report dependencies for " .. path
    end
    if #expanded == 0 then
        return nil, nil, "cc -E produced no output for " .. path
    end

    return expanded, dependencyPaths(depText, path)
end

local function semanticText(text)
    text = text:gsub("%s+", " ")
    text = text:gsub("%s*([{}%(%)%[%],;%*])%s*", "%1")
    return text:match("^%s*(.-)%s*$") or text
end

local cache = {}

local function provenance(path: string, opts: cheader.Options?): (cheader.Provenance?, string?, boolean?)
    opts = opts or {} as cheader.Options
    local display = opts.display or path
    path = hostService("fs").canonical(path)
    local source = opts.read and opts.read(path) or hostService("fs").readFile(path)
    if not source then
        return nil, "cannot read " .. path, true
    end
    local nul = nulLine(source)
    if nul then
        return nil, ("%s:%d: the header holds a NUL byte, and LuaJIT would read nothing past it"):format(display, nul)
    end
    local dependencies = {path}
    local lines, origins
    if opts.preprocess then
        local expanded, discovered, problem = preprocessHeader(path, opts)
        if not expanded then
            return nil, problem
        end
        dependencies = discovered
        lines, origins = preprocessedLines(expanded)
    else
        local read, problem = unpreprocessedLines(source, display)
        if not read then
            return nil, problem
        end
        lines = read
    end
    local parseText = table.concat(lines, "\n")
    -- What runs is the same text without the lines that hold nothing, since every
    -- line of it becomes a line of generated Lua.
    local kept: {string} = {}
    for _, line in ipairs(lines) do
        if line:match("%S") then
            kept[#kept + 1] = line
        end
    end
    local text = table.concat(kept, "\n")
    local semanticFingerprint = hash.digest(
        table.concat({"cheader-v2", cdecl.abiTag(), toolchainIdentity(opts), semanticText(text)}, "\0")
    )

    return {
        cdef = text,
        sourcePath = path,
        dependencies = dependencies,
        semanticFingerprint = semanticFingerprint,
        parseText = parseText,
        origins = origins,
    }
end

cheader.provenance = provenance

-- Declarations a program makes with a literal ffi.cdef block are given to the
-- compiler's own FFI as well, so the type strings that follow mean something here too.
-- Keyed by content: declaring the same block twice is an error in the FFI rather than a
-- no-op.
local declaredBlocks = {}
local declaredNames: {[string]: {[string]: boolean}} = {}

--- Declares a block once per process and answers what it named.
---
--- The names are cached with the verdict because a repeated block introduces
--- nothing the second time: LuaJIT already holds it, so the id diff underneath
--- would be empty and a second checker run over the same source would see an
--- `ffi.C` missing everything that source declared.
function cheader.declare(text: string): boolean, string?, {[string]: boolean}?
    if declaredBlocks[text] ~= nil then
        return declaredBlocks[text], nil, declaredNames[text]
    end
    local ok, err, names = cdecl.declare(text)
    declaredBlocks[text] = ok
    declaredNames[text] = names or {}
    if not ok then
        return false, err
    end

    return true, nil, declaredNames[text]
end

-- The nupp type a literal C type string stands for, e.g. "struct Point" or "uint8_t *".
-- `resolver` maps a struct tag to a type the program has already declared, so a cdef
-- struct keeps its identity here. Structs met through a type string rather than a
-- declaration: built once and shared, so two mentions of the same tag are the same
-- type.
local adopted = {}

local function adoptingResolver(resolver)
    return function(tag)
        if resolver then
            local known = resolver(tag)
            if known then
                return known
            end
        end

        return adoptStruct(tag, "struct") or adoptStruct(tag, "union")
    end
end

adoptStruct = function(tag, aggregateKind)
    aggregateKind = aggregateKind or "struct"
    local key = aggregateKind .. " " .. tag
    local hit = adopted[key]
    if hit then
        return hit
    end
    local model = cdecl.typeFromString(key)
    if not model or model.kind ~= aggregateKind then
        return nil
    end
    local known = model.id and adoptedById[model.id] or nil
    if known then
        adopted[key] = known
        return known
    end
    local declaration = cdecl.structById(model.id)
    if not declaration then
        return nil
    end
    local nominal = T.nominal(tag, "struct", cDeclarationKey(aggregateKind, "tag", tag))
    nominal.cdefName = tag
    nominal.cdefKind = aggregateKind
    nominal.fieldOrder = {}
    -- before decoding, so a self-reference terminates
    adopted[key] = nominal
    adoptedById[declaration.id] = nominal
    for _, field in ipairs(declaration.fields) do
        local fieldType = nuppType(field.type, nil, adoptingResolver(nil)) or T.any
        nominal.byname[field.name] = fieldType
        nominal.writeByname[field.name] = fieldType
        nominal.fieldOrder[#nominal.fieldOrder + 1] = field.name
    end

    return nominal
end

function cheader.typeFromString(spec: string, resolver: cheader.Resolver?): T.Type?, string?
    local model, err = cdecl.typeFromString(spec)
    if not model then
        return nil, err
    end

    return nuppType(model, nil, adoptingResolver(resolver))
end

-- The functions named by `only`, modelled as nupp types. This is what ffi.C and
-- ffi.load hold. `only` is the set the checked program declared; without it the
-- answer would be the whole process, which is every other program the compiler
-- happened to check and the compiler's own bindings besides.
function cheader.declaredFunctions(resolver: cheader.Resolver?, only: {[string]: boolean}?): {[string]: T.Type}
    local out = {}
    local r = adoptingResolver(resolver)
    for name, fn in pairs(cdecl.declaredFunctions(only)) do
        out[name] = modelFunction(fn, nil, r)
    end

    return out
end

-- Returns { exports = {name -> type}, cdef = string } or nil plus a reason.
-- `opts.preprocess` runs the system compiler first, for headers whose declarations are
-- written in a vocabulary their includes define.

--- Loads a header. A failure is the reason, and a third result saying the header
--- could not be read at all, which is what lets a caller try its next candidate path
--- without mistaking a header that failed to parse for one that is not there.
function cheader.load(path: string, opts: cheader.Options?): (cheader.Header?, string?, boolean?)
    opts = opts or {} as cheader.Options
    local observed, problem, missing = provenance(path, opts)
    if not observed then
        return nil, problem, missing
    end
    local text = observed.cdef
    local dependencies = observed.dependencies
    local semanticFingerprint = observed.semanticFingerprint
    -- Key after preprocessing: an included header is part of the declarations even
    -- when the primary file's bytes did not move.
    local key = table.concat({semanticFingerprint, table.concat(dependencies, "\0")}, "\0")
    local hit = cache[key]
    if hit then
        return {
            exports = hit.exports,
            cdef = hit.cdef,
            sourcePath = observed.sourcePath,
            dependencies = dependencies,
            semanticFingerprint = semanticFingerprint,
        }
    end

    local parsed, err = cdecl.inspect(observed.parseText or text)
    if not parsed then
        -- LuaJIT names a line of the text it was given, and leaves it off when it is
        -- the first. That is the header's own line unless the header was
        -- preprocessed, when the linemarkers say whose line it is.
        local message = tostring(err)
        local line = (tonumber(message:match("at line (%d+)$") or "") or 1) as integer
        message = message:gsub("%s*at line %d+$", "")
        local where = opts.display or path
        local origin = observed.origins and observed.origins[line] or nil
        if origin then
            where = origin.file .. ":" .. tostring(origin.line)
        elseif not observed.origins then
            where = where .. ":" .. tostring(line)
        end
        return nil, ("LuaJIT could not parse %s: %s"):format(where, message)
    end

    -- Structs first, so a function mentioning one can refer to it. One this process
    -- already built a type for keeps that type.
    local structs, exports = {}, {}
    local fresh: {[integer]: boolean} = {}
    for _, declaration in ipairs(parsed.structs) do
        local nominal = adoptedById[declaration.id]
        if not nominal then
            nominal = T.nominal(
                declaration.name,
                "struct",
                cDeclarationKey(declaration.kind, declaration.typedefName and "typedef" or "tag", declaration.name)
            )
            nominal.cdefName = declaration.name
            nominal.cdefKind = declaration.kind
            nominal.fieldOrder = {}
            adoptedById[declaration.id] = nominal
            if not declaration.typedefName then
                adopted[declaration.kind .. " " .. declaration.name] = nominal
            end
            fresh[declaration.id] = true
        end
        structs[declaration.id] = nominal
    end
    for _, declaration in ipairs(parsed.structs) do
        local nominal = structs[declaration.id]
        for _, field in ipairs(fresh[declaration.id] and declaration.fields or {}) do
            local fieldType = nuppType(field.type, structs) or T.any
            nominal.byname[field.name] = fieldType
            nominal.writeByname[field.name] = fieldType
            nominal.fieldOrder[#nominal.fieldOrder + 1] = field.name
        end
    end
    for _, fn in ipairs(parsed.functions) do
        exports[fn.name] = modelFunction(fn, structs)
    end
    -- An enum's members are constants the library namespace answers, as import-c
    -- exports them. C gives them `int` in every place they appear.
    for _, declaration in ipairs(parsed.enums) do
        for _, member in ipairs(declaration.values) do
            if exports[member.name] == nil then
                exports[member.name] = T.int32
            end
        end
    end

    local result = {
        exports = exports,
        cdef = text,
        sourcePath = observed.sourcePath,
        dependencies = dependencies,
        semanticFingerprint = semanticFingerprint,
    }
    cache[key] = result

    return result
end

export = cheader
