module nupp.compiler.cinterop.importc

--[[
Ejecting a typed Nupp module from a C header.

The pipeline: `cc -E` preprocesses; the linemarkers it leaves attribute every
line to its origin file, so only the requested header's own declarations are
kept; decoration LuaJIT does not read is normalized away, while the attributes it
lays declarations out by are kept; LuaJIT's own C parser supplies a neutral
declaration model through `nupp.compiler.cinterop.cdecl`; and that model is
emitted as typed `cdef` declarations. A struct is emitted only when its rendering
lays out exactly as the header's does. Anything the Nupp C surface cannot express
is ejected as a comment, since the output is a committed, hand-editable file, never a
black box.

Constants come from two places and land together: an enum's members, which
LuaJIT's model carries with the type, and a second `-dM` pass over the object-like
macros the header defines itself, of which the numerically evaluable ones are
emitted. A name declared twice keeps its first meaning.
]]

local importc = {}
local cdecl = require("nupp.compiler.cinterop.cdecl")
local process = require("nupp.compiler.process")
local hash = require("nupp.compiler.hash")

----------------------------------------------------------------------------
-- Running the preprocessor
----------------------------------------------------------------------------

local function readFile(path)
    local f = io.open(path, "rb")
    if not f then
        return nil
    end
    local s = f:read("*a")
    f:close()

    return s
end

local function capture(argv)
    local code, out = process.capture(argv)
    if code ~= 0 then
        return nil
    end

    return out
end

local function normalizedPath(path)
    return (path:gsub("\\", "/"))
end

local function basename(path)
    return normalizedPath(path):match("([^/]+)$") or path
end

-- cpp normally writes the input path back verbatim, but some drivers canonicalize it
-- first. The target is the first linemarker with its basename: preprocessing enters
-- the input before it can enter an included file, so this also distinguishes an
-- included sibling that happens to have the same basename.
local function targetMarker(preprocessed, headerPath)
    local wanted = normalizedPath(headerPath)
    local fallback = nil
    for file in preprocessed:gmatch('#%s*%d+%s+"([^"]*)"') do
        local normalized = normalizedPath(file)
        if normalized == wanted then
            return file
        end
        if not fallback and basename(normalized) == basename(wanted) then
            fallback = file
        end
    end

    return fallback or headerPath
end

-- Keeps only lines attributed (by cpp linemarkers) to the exact target header, and
-- says which line of the header each kept line was: a linemarker names the line that
-- follows it, and every line after that is one more.
local function filterToHeader(preprocessed: string, headerPath: string): (string, {integer})
    local target = targetMarker(preprocessed, headerPath)
    local keep: {string} = {}
    local lines: {integer} = {}
    local current = ""
    local lineNumber: integer = 0
    for line in (preprocessed .. "\n"):gmatch("(.-)\n") do
        local number, file = line:match('^#%s*(%d+)%s+"([^"]*)"')
        if file then
            current = file
            lineNumber = ((tonumber(number) or 1) as integer) - 1
        else
            lineNumber = lineNumber + 1
            if current == target and line:match("%S") then
                keep[#keep + 1] = line
                lines[#lines + 1] = lineNumber
            end
        end
    end

    return table.concat(keep, "\n"), lines
end

----------------------------------------------------------------------------
-- Splitting the output into statements
----------------------------------------------------------------------------

-- Attributes LuaJIT's parser reads and lays out by. They stay, because dropping one
-- is what turned a packed or aligned struct into a plain one with the same fields.
local LUAJIT_ATTRIBUTES: {
    [string]: boolean
} = {
    aligned = true,
    packed = true,
    mode = true,
    vector_size = true,
    regparm = true,
    cdecl = true,
    thiscall = true,
    fastcall = true,
    stdcall = true,
    sseregparm = true,
}

-- Attributes that change a layout, a calling convention or a symbol, which LuaJIT
-- would skip without a word. A declaration carrying one is refused rather than
-- imported as the declaration it would be without it.
local REFUSED_ATTRIBUTES: {
    [string]: boolean
} = {
    ext_vector_type = true,
    matrix_type = true,
    ms_struct = true,
    gcc_struct = true,
    transparent_union = true,
    ms_abi = true,
    sysv_abi = true,
    vectorcall = true,
    regcall = true,
    pcs = true,
    overloadable = true,
    swiftcall = true,
    swiftasynccall = true,
    preserve_most = true,
    preserve_all = true,
    aarch64_vector_pcs = true,
    aarch64_sve_pcs = true,
}

-- What a refused attribute is replaced with, so the declaration holding it can be
-- found and reported once the text is split into statements.
local REFUSED_MARKER = "__nupp_refused_attribute_"

-- Every rewrite below keeps the newlines of what it replaces, so a statement's line
-- in the rewritten text is still its line in the header.
local function newlinesOf(text: string): string
    return (text:gsub("[^\n]", ""))
end

-- The top-level items of an attribute list: `aligned(8), packed` is two.
local function attributeItems(list: string): {string}
    local items: {string} = {}
    local depth, start = 0, 1
    for index = 1, #list do
        local ch = list:sub(index, index)
        if ch == "(" then
            depth = depth + 1
        elseif ch == ")" then
            depth = depth - 1
        elseif ch == "," and depth == 0 then
            items[#items + 1] = list:sub(start, index - 1)
            start = index + 1
        end
    end
    items[#items + 1] = list:sub(start)

    return items
end

local function rewriteAttribute(whole: string, parens: string, keepLayout: boolean?): string
    local kept: {string} = {}
    for _, item in ipairs(attributeItems(parens:sub(3, -3))) do
        local name = item:match("^%s*([%a_][%w_]*)")
        if name then
            local bare = name:gsub("^__", ""):gsub("__$", "")
            if REFUSED_ATTRIBUTES[bare] then
                return " " .. REFUSED_MARKER .. bare .. " " .. newlinesOf(whole)
            end
            if keepLayout and LUAJIT_ATTRIBUTES[bare] then
                kept[#kept + 1] = (item:gsub("^%s+", ""):gsub("%s+$", ""))
            end
        end
    end
    if #kept == 0 then
        return " " .. newlinesOf(whole)
    end

    return " __attribute__((" .. table.concat(kept, ", ") .. ")) " .. newlinesOf(whole)
end

-- Strips compiler-specific decoration LuaJIT's parser may reject. With `keepLayout`,
-- the attributes LuaJIT lays a declaration out by survive; without it, every attribute
-- goes, which is what a scan that only looks for names wants.
local function normalize(text: string, keepLayout: boolean?): string
    for _, spelling in ipairs({"__attribute__", "__attribute"}) do
        text = text:gsub(spelling .. "%s*(%(%b()%))", function(parens)
            -- A lone pair of parentheses is not an attribute list, and whatever it is
            -- stays as written.
            if parens:sub(1, 2) ~= "((" then
                return nil
            end
            return rewriteAttribute(spelling .. parens, parens, keepLayout)
        end)
    end
    text = text:gsub("__asm__%s*%b()", newlinesOf)
    text = text:gsub("__asm%s*%b()", newlinesOf)
    text = text:gsub("__inline__", "inline"):gsub("__inline", "inline")
    for _, word in ipairs({
        "__restrict__",
        "__restrict",
        "__extension__",
        "_Nullable",
        "_Nonnull",
        "_Null_unspecified"
    }) do
        text = text:gsub(word, "")
    end

    return text
end

--- One statement of a header: its text, the header line it starts on, and whether a
--- `#pragma pack` was in force while it was written.
type importc.Statement = {
    text: string,
    line: integer?,
    packed: boolean
}

-- `#pragma pack(...)` state after one directive, as a stack of alignments. An empty
-- stack or a zero top means the default layout.
local function applyPack(directive: string, stack: {integer}): {integer}
    local args = directive:match("^%s*#%s*pragma%s+pack%s*(%b())")
    if not args then
        return stack
    end
    local parts: {string} = {}
    for part in args:sub(2, -2):gmatch("[^,]+") do
        parts[#parts + 1] = (part:gsub("^%s+", ""):gsub("%s+$", ""))
    end
    local current = stack[#stack] or 0
    if parts[1] == "push" then
        stack[#stack + 1] = (tonumber(parts[#parts]) or current) as integer
    elseif parts[1] == "pop" then
        stack[#stack] = nil
    else
        -- `pack(N)` replaces the top; `pack()` restores the default.
        stack[math.max(#stack, 1)] = (tonumber(parts[1]) or 0) as integer
    end

    return stack
end

-- Splits into statements at ';' outside braces; a struct body rides along with its
-- statement.
--
-- A directive line the preprocessor left behind, which in practice is a `#pragma`, is
-- not part of any statement. Glued onto the declaration after it, as it once was, it
-- took that declaration with it: LuaJIT skips an unknown pragma to the end of its
-- line, and a statement joined onto one line has nothing after that. The pragma that
-- matters, `pack`, is tracked instead, so a struct laid out under it can be refused.
local function statements(text: string, lineMap: {integer}?): {importc.Statement}
    local out: {importc.Statement} = {}
    local buf: {string} = {}
    local depth = 0
    local line: integer = 1
    local startLine: integer? = nil
    local atLineStart = true
    local pack: {integer} = {}
    local packed = false
    local index = 1
    local length = #text

    local function reset()
        buf = {}
        startLine = nil
        packed = false
    end

    while index <= length do
        local ch = text:sub(index, index)
        if atLineStart and ch == "#" then
            local eol = text:find("\n", index, true) or (length + 1)
            pack = applyPack(text:sub(index, eol - 1), pack)
            index = eol
        else
            local discard = false
            if ch == "{" then
                depth = depth + 1

            elseif ch == "}" then
                depth = depth - 1
                if depth == 0 then
                    local prefix = table.concat(buf):gsub("^%s+", "")
                    local aggregate = prefix:match("^typedef%s+struct%f[%W]")
                        or prefix:match("^typedef%s+union%f[%W]")
                        or prefix:match("^typedef%s+enum%f[%W]")
                        or prefix:match("^struct%f[%W]")
                        or prefix:match("^union%f[%W]")
                        or prefix:match("^enum%f[%W]")
                    if prefix:find("%b()") and not aggregate then
                        -- A function definition has no declaration-ending semicolon.
                        -- Drop it here so it cannot glue itself to the declaration
                        -- which follows. Header-only functions are inventoried by the
                        -- bridge scanner separately.
                        reset()
                        discard = true
                    end
                end
            end
            if discard then
                -- The closing brace belongs to the discarded definition.
            elseif ch == ";" and depth == 0 then
                local stmt = table.concat(buf):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                if #stmt > 0 then
                    out[
                        #out + 1
                    ] = {
                        text = stmt,
                        line = startLine and (lineMap and lineMap[startLine] or startLine),
                        packed = packed,
                    }
                end
                reset()
            else
                if not ch:match("%s") then
                    startLine = startLine or line
                    local top = pack[#pack]
                    packed = packed or (top ~= nil and top > 0)
                end
                buf[#buf + 1] = ch
            end
            if ch == "\n" then
                line = line + 1
                atLineStart = true
            elseif not ch:match("%s") then
                atLineStart = false
            end
            index = index + 1
        end
    end

    return out
end

-- Collects simple `typedef <base> <name>;` declarations and resolves them through
-- LuaJIT before the target header is inspected. A header's own vocabulary (uLong,
-- Bytef, ...) commonly comes from included headers that were removed by linemarker
-- filtering. cpp linemarkers carry no semicolon, so they glue onto the statement that
-- follows when text is split into statements; drop them first.
local function stripLinemarkers(text)
    local out = {}
    for line in (text .. "\n"):gmatch("(.-)\n") do
        if not line:match("^#") then
            out[#out + 1] = line
        end
    end

    return table.concat(out, "\n")
end

-- In declaration order, which is the only order C can read them in: a typedef names a
-- type that an earlier one had to introduce. Darwin's headers reach `ino_t` through
-- `__darwin_ino64_t` through `__uint64_t`, so any other order hands LuaJIT a name it
-- has not met yet. Sorting these to make the output deterministic bought determinism
-- the header already had, and paid for it by failing on every real system header.
--
-- A name repeated by two headers keeps its first spelling; a later identical typedef is
-- legal C and adds nothing.
local function collectTypedefs(stmts: {importc.Statement})
    local defs, seen = {}, {}
    for _, statement in ipairs(stmts) do
        local stmt = statement.text
        if stmt:match("^typedef%f[%W]") and not stmt:find("[{}()]") and not stmt:find(REFUSED_MARKER, 1, true) then
            local body = stmt:gsub("^typedef%s+", "")
            local base, name = body:match("^(.-)%s*%f[%w_]([%a_][%w_]*)$")
            if base and name and base:match("%S") and not seen[name] then
                seen[name] = true
                defs[#defs + 1] = {name = name, base = (base:gsub("^%s+", ""):gsub("%s+$", "")),}
            end
        end
    end

    return defs
end

----------------------------------------------------------------------------
-- Rendering a C type
----------------------------------------------------------------------------

local INTEGER_TYPE = {
    [8] = {"int8", "uint8"},
    [16] = {"int16", "uint16"},
    [32] = {"int32", "uint32"},
    [64] = {"int64", "uint64"},
}

local RESERVED = {
    ["and"] = true,
    ["break"] = true,
    ["do"] = true,
    ["else"] = true,
    ["elseif"] = true,
    ["end"] = true,
    ["false"] = true,
    ["for"] = true,
    ["function"] = true,
    ["goto"] = true,
    ["if"] = true,
    ["in"] = true,
    ["local"] = true,
    ["nil"] = true,
    ["not"] = true,
    ["or"] = true,
    ["repeat"] = true,
    ["return"] = true,
    ["then"] = true,
    ["true"] = true,
    ["until"] = true,
    ["while"] = true,
}

local function identifier(name)
    return name and name:match("^[%a_][%w_]*$") and not RESERVED[name]
end

local renderType
local renderFunctionType

-- A name for what a struct reference points at, whether the struct has its own tag or
-- only a typedef's.
local function aggregateName(model, knownStructs): string?
    return model and (model.name or (model.id and knownStructs[model.id] or nil)) or nil
end

-- Nupp's cdef surface deliberately gives byte strings and opaque primitive pointers
-- friendly boundary types. Struct identity and every numeric width, however, come from
-- LuaJIT's parsed model rather than from C spelling.
--
-- A type with no rendering comes back as nil and the reason, which is what the skip
-- that follows reports.
renderType = function(model, knownStructs): (string?, string?)
    local kind = model and model.kind or "unknown"
    if kind == "boolean" then
        return "boolean"
    elseif kind == "float" then
        if model.bits == 32 then
            return "float"
        end
        if model.bits == 64 then
            return "number"
        end
        return nil, ("a %d-bit float"):format(model.bits or 0)
    elseif kind == "integer" or kind == "enum" then
        local pair = INTEGER_TYPE[model.bits]
        if not pair then
            return nil, ("a %d-bit integer"):format(model.bits or 0)
        end
        return model.unsigned and pair[2] or pair[1]
    elseif kind == "struct" or kind == "union" then
        local name = aggregateName(model, knownStructs)
        if name and knownStructs[name] then
            return name
        end
        return nil, ("%s %s is not imported"):format(kind, tostring(name or "(anonymous)"))
    elseif kind == "pointer" then
        local pointee = model.to
        if pointee and pointee.kind == "integer" and pointee.bits == 8 and model.const then
            return "cstring?"
        end
        if pointee and pointee.kind == "function" then
            local rendered, why = renderFunctionType(pointee, knownStructs)
            return rendered and (rendered .. "?") or nil, why
        end
        local pointeeName = aggregateName(pointee, knownStructs)
        if pointee
            and (pointee.kind == "struct" or pointee.kind == "union")
            and pointeeName
            and knownStructs[pointeeName]
        then
            return (model.const and "const " or "") .. pointeeName .. "*?"
        end
        if pointee and pointee.kind == "void" then
            return "voidptr"
        end
        local rendered, why = renderType(pointee, knownStructs)
        if rendered then
            return (model.const and "const " or "") .. rendered .. "*?"
        end
        return nil, why
    elseif kind == "array" then
        local element, why = renderType(model.of, knownStructs)
        if not element then
            return nil, why
        end
        if not model.count or model.count < 0 or model.count % 1 ~= 0 then
            return nil, "an array with no fixed length"
        end
        return element .. "[" .. tostring(model.count) .. "]"
    elseif kind == "vector" then
        return nil, "a vector type"
    elseif kind == "complex" then
        return nil, "a complex type"
    end

    return nil, "a C type Nupp does not spell"
end

renderFunctionType = function(fn, knownStructs): (string?, string?)
    local params = {}
    for _, param in ipairs(fn.params or {}) do
        local rendered, why = renderType(param.type, knownStructs)
        if not rendered then
            return nil, why
        end
        params[#params + 1] = rendered
    end
    if fn.vararg then
        params[#params + 1] = "..."
    end
    local out = "function(" .. table.concat(params, ", ") .. ")"
    if fn.returns and fn.returns.kind ~= "void" then
        local ret, why = renderType(fn.returns, knownStructs)
        if not ret then
            return nil, why
        end
        out = out .. ": " .. ret
    end

    return out
end

-- The C member declaration a rendered field lowers to, spelled from the same model
-- decisions `renderType` made: the widths it chose, and a pointer for every kind of
-- pointer, since all of them are one pointer wide. LuaJIT lays these out, and the
-- answer is compared with the header's own layout.
local function probeDeclarator(model, name: string, knownStructs): string?
    local kind = model and model.kind or "unknown"
    if kind == "integer" or kind == "enum" then
        if not INTEGER_TYPE[model.bits] then
            return nil
        end
        return ("%sint%d_t %s"):format(model.unsigned and "u" or "", model.bits, name)
    elseif kind == "boolean" then
        return "bool " .. name
    elseif kind == "float" then
        return (model.bits == 32 and "float " or "double ") .. name
    elseif kind == "pointer" then
        return "void *" .. name
    elseif kind == "struct" or kind == "union" then
        if model.name then
            return kind .. " " .. model.name .. " " .. name
        end
        local typedef = model.id and knownStructs[model.id] or nil
        return typedef and (typedef .. " " .. name) or nil
    elseif kind == "array" and model.count then
        return probeDeclarator(model.of, name .. "[" .. tostring(model.count) .. "]", knownStructs)
    end

    return nil
end

-- Why a struct as rendered would not lay out the way the header's does, or nil when it
-- would. Size, alignment, and every member's offset and bit position are compared.
-- What moves them without changing any member's type -- packing, an aligned member or
-- typedef -- shows up here and nowhere else.
local function layoutProblem(declaration, knownStructs): string?
    local body = {}
    for _, field in ipairs(declaration.fields) do
        local member = probeDeclarator(field.type, field.name, knownStructs)
        if not member then
            return ("member %s has no C spelling"):format(field.name)
        end
        body[#body + 1] = member .. (field.bitWidth and (" : " .. tostring(field.bitWidth)) or "") .. ";"
    end
    local rendered, err = cdecl.layout(declaration.kind, table.concat(body, " "))
    if not rendered then
        return "the rendered members do not parse: " .. tostring(err)
    end
    if rendered.size ~= declaration.size then
        return ("it is %s bytes in C and %s as rendered"):format(tostring(declaration.size), tostring(rendered.size))
    end
    if rendered.align ~= declaration.align then
        return (
            "it is aligned to %s bytes in C and %s as rendered"
        ):format(tostring(declaration.align), tostring(rendered.align))
    end
    for index, field in ipairs(declaration.fields) do
        local other = rendered.fields[index]
        if not other
            or other.offset ~= field.offset
            or other.bitPos ~= field.bitPos
            or other.bitWidth ~= field.bitWidth
        then
            return (
                "member %s is at offset %s in C and %s as rendered"
            ):format(field.name, tostring(field.offset), tostring(other and other.offset))
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- Macros
----------------------------------------------------------------------------

-- Object-like #define names declared by the header itself.
local function headerMacroNames(rawHeader)
    local names = {}
    for name, after in rawHeader:gmatch("#%s*define%s+([%a_][%w_]*)([^\n]?)") do
        if after ~= "(" then
            names[#names + 1] = name
        end
    end

    return names
end

-- `cc -dM` prints one definition per line. An empty macro, which every include guard
-- is, is `#define NAME` with nothing after it, so a value is read to the end of its own
-- line: reading across the newline took the next definition as this one's value and
-- lost that definition.
local function macroValues(dmOutput: string): {[string]: string}
    local values: {[string]: string} = {}
    for line in (dmOutput .. "\n"):gmatch("([^\n]*)\n") do
        local name, rest = line:gsub("\r$", ""):match("^%s*#%s*define%s+([%a_][%w_]*)(.*)$")
        if name and rest:sub(1, 1) ~= "(" then
            values[name] = (rest:gsub("^%s+", ""):gsub("%s+$", ""))
        end
    end

    return values
end

-- A macro's value is C, so it is evaluated the way C evaluates it: octal literals,
-- truncating division, a remainder with the dividend's sign, typed integer literals
-- and their conversions, `float` rounding. Handing the text to Lua instead gave `0644`
-- the value 644 and `7 / 2` the value 3.5.
--
-- Values are held as Lua numbers and have to stay exact, so a result or an operand
-- outside +/-2^53 is refused rather than rounded.

local EXACT = 2 ^ 53

--- One C constant: an integer of a C integer type, a double or float, or a string.
type importc.CValue = {
    kind: string,
    value: number?,
    text: string?,
    bits: integer?,
    unsigned: boolean?,
    rank: integer?,
    single: boolean?
}

local TWO_CHAR_OPERATORS: {
    [string]: boolean
} = {
    ["<<"] = true,
    [">>"] = true,
    ["<="] = true,
    [">="] = true,
    ["=="] = true,
    ["!="] = true,
    ["&&"] = true,
    ["||"] = true,
}
local ONE_CHAR_OPERATORS = "+-*/%&|^~!<>?:()"

type importc.CToken = {
    kind: string,
    text: string
}

local function cTokens(text: string): ({importc.CToken}?, string?)
    local tokens: {importc.CToken} = {}
    local index = 1
    local length = #text
    while index <= length do
        local ch = text:sub(index, index)
        if ch:match("%s") then
            index = index + 1
        elseif ch:match("%d") or (ch == "." and text:sub(index + 1, index + 1):match("%d")) then
            local stop = index
            while stop <= length do
                local d = text:sub(stop, stop)
                if d:match("[eEpP]") and text:sub(stop + 1, stop + 1):match("[%+%-]") then
                    stop = stop + 2
                elseif d:match("[%w_%.]") then
                    stop = stop + 1
                else
                    break
                end
            end
            tokens[#tokens + 1] = {kind = "number", text = text:sub(index, stop - 1)}
            index = stop
        elseif ch:match("[%a_]") then
            local word = text:match("^[%a_][%w_]*", index) as string
            if text:sub(index + #word, index + #word):match("['\"]") then
                return nil, "a wide or Unicode literal"
            end
            tokens[#tokens + 1] = {kind = "name", text = word}
            index = index + #word
        elseif ch == "'" or ch == '"' then
            local stop = index + 1
            while stop <= length and text:sub(stop, stop) ~= ch do
                if text:sub(stop, stop) == "\\" then
                    stop = stop + 1
                end
                stop = stop + 1
            end
            if stop > length then
                return nil, "an unterminated literal"
            end
            tokens[#tokens + 1] = {kind = ch == "'" and "char" or "string", text = text:sub(index + 1, stop - 1)}
            index = stop + 1
        elseif TWO_CHAR_OPERATORS[text:sub(index, index + 1)] then
            tokens[#tokens + 1] = {kind = "op", text = text:sub(index, index + 1)}
            index = index + 2
        elseif ONE_CHAR_OPERATORS:find(ch, 1, true) then
            tokens[#tokens + 1] = {kind = "op", text = ch}
            index = index + 1
        else
            return nil, ("%q is not part of a constant expression"):format(ch)
        end
    end

    return tokens
end

local SIMPLE_ESCAPES: {
    [string]: integer
} = {n = 10, t = 9, r = 13, a = 7, b = 8, f = 12, v = 11, ["\\"] = 92, ["'"] = 39, ['"'] = 34, ["?"] = 63,}

-- The bytes a C character or string literal body stands for. An octal escape is
-- octal, which Lua's decimal `\ddd` is not.
local function literalBytes(body: string): ({integer}?, string?)
    local bytes: {integer} = {}
    local index = 1
    while index <= #body do
        local ch = body:sub(index, index)
        if ch ~= "\\" then
            bytes[#bytes + 1] = ch:byte()
            index = index + 1
        else
            local escape = body:sub(index + 1, index + 1)
            local simple = SIMPLE_ESCAPES[escape]
            if simple then
                bytes[#bytes + 1] = simple
                index = index + 2
            elseif escape:match("[0-7]") then
                local digits = body:match("^[0-7][0-7]?[0-7]?", index + 1) as string
                local value = tonumber(digits, 8) as integer
                if value > 255 then
                    return nil, "an escape wider than a byte"
                end
                bytes[#bytes + 1] = value
                index = index + 1 + #digits
            elseif escape == "x" then
                local digits = body:match("^%x+", index + 2)
                local value = digits and tonumber(digits, 16) or nil
                if not digits or not value or value > 255 then
                    return nil, "an escape wider than a byte"
                end
                bytes[#bytes + 1] = value as integer
                index = index + 2 + #digits
            else
                return nil, "an escape Nupp does not read"
            end
        end
    end

    return bytes
end

-- The C integer types by rank: int, long, long long. `long` is the ABI's.
local longBits: integer? = nil

local function integerType(rank: integer, unsigned: boolean): importc.CValue
    if not longBits then
        longBits = ((cdecl.sizeof("long") or 8) * 8) as integer
    end
    local bits = rank == 1 and 32 or rank == 2 and longBits or 64

    return {kind = "int", bits = bits, unsigned = unsigned, rank = rank}
end

local function integerValue(value: number, t: importc.CValue): importc.CValue
    return {kind = "int", value = value, bits = t.bits, unsigned = t.unsigned, rank = t.rank}
end

-- The C type an integer literal has: the first of its candidate types that holds it.
local function integerLiteral(text: string): (importc.CValue?, string?)
    local digits, suffix, base = text:match("^0[xX](%x+)([uUlL]*)$")
    base = 16
    if not digits then
        digits, suffix = text:match("^0[bB]([01]+)([uUlL]*)$")
        base = 2
    end
    if not digits then
        digits, suffix = text:match("^(0[0-7]*)([uUlL]*)$")
        base = 8
    end
    if not digits then
        digits, suffix = text:match("^([1-9]%d*)([uUlL]*)$")
        base = 10
    end
    if not digits or not suffix then
        return nil
    end
    local value = tonumber(digits, base) as number
    if value > EXACT then
        return nil, text .. " is too large to hold exactly"
    end
    local lower = suffix:lower()
    local unsigned = lower:find("u", 1, true) ~= nil
    local _, longs = lower:gsub("l", "")
    if #lower > 3 or longs > 2 then
        return nil
    end
    for rank = longs + 1, 3 do
        local signed = integerType(rank, false)
        if not unsigned and value <= 2 ^ ((signed.bits as integer) - 1) - 1 then
            return integerValue(value, signed)
        end
        local unsignedType = integerType(rank, true)
        if (unsigned or base ~= 10) and value <= 2 ^ (unsignedType.bits as integer) - 1 then
            return integerValue(value, unsignedType)
        end
    end

    return nil, text .. " has no C integer type"
end

local function numberLiteral(text: string): (importc.CValue?, string?)
    local integer, why = integerLiteral(text)
    if integer or why then
        return integer, why
    end
    local hex = text:match("^0[xX]") ~= nil
    local body, suffix = text:match("^(.-)([fFlL]?)$")
    local isFloat = body ~= nil
        and (body:find(".", 1, true) or (not hex and body:find("[eE]")) or (hex and body:find("[pP]")))
    local value = isFloat and tonumber(body) or nil
    if not value then
        return nil, text .. " is not a C number"
    end
    local single = suffix == "f" or suffix == "F"

    return {kind = "float", value = single and cdecl.float32(value) or value, single = single}
end

-- C's conversion of an integer to an integer type: modulo the width, as every target
-- Nupp runs on does for a signed destination too.
local function convertInteger(value: number, t: importc.CValue): (number?, string?)
    local width = 2 ^ (t.bits as integer)
    local converted = value % width
    if not t.unsigned and converted >= width / 2 then
        converted = converted - width
    end
    if math.abs(converted) > EXACT then
        return nil, "the value is too large to hold exactly"
    end

    return converted
end

-- The type both operands of an arithmetic operator are converted to.
local function commonType(a: importc.CValue, b: importc.CValue): importc.CValue
    if a.unsigned == b.unsigned then
        return (a.rank as integer) >= (b.rank as integer) and a or b
    end
    local u = a.unsigned and a or b
    local s = a.unsigned and b or a
    if (u.rank as integer) >= (s.rank as integer) then
        return u
    end
    if (s.bits as integer) > (u.bits as integer) then
        return s
    end

    return integerType(s.rank as integer, true)
end

-- A result that has to fit its type. Signed overflow is undefined in C, so it is
-- refused; an unsigned result wraps.
local function fitted(value: number, t: importc.CValue): (importc.CValue?, string?)
    if math.abs(value) > EXACT * 2 then
        return nil, "the value is too large to hold exactly"
    end
    if t.unsigned then
        local converted, why = convertInteger(value, t)
        if not converted then
            return nil, why
        end
        return integerValue(converted, t)
    end
    local half = 2 ^ ((t.bits as integer) - 1)
    if value < -half or value > half - 1 then
        return nil, "the expression overflows its C type"
    end
    if math.abs(value) > EXACT then
        return nil, "the value is too large to hold exactly"
    end

    return integerValue(value, t)
end

local bit = require("bit") as {
    band: function(...: number): integer,
    bor: function(...: number): integer,
    bxor: function(...: number): integer,
    bnot: function(x: number): integer
}

local WORD = 2 ^ 32

local function halves(value: number): (number, number)
    return math.floor(value / WORD) % WORD, value % WORD
end

local function joined(high: number, low: number, t: importc.CValue): (importc.CValue?, string?)
    high, low = high % WORD, low % WORD
    local value
    if t.bits == 32 then
        value = (not t.unsigned and low >= WORD / 2) and low - WORD or low
    else
        value = (not t.unsigned and high >= WORD / 2) and (high - WORD) * WORD + low or high * WORD + low
    end
    if math.abs(value) > EXACT then
        return nil, "the value is too large to hold exactly"
    end

    return integerValue(value, t)
end

-- Integer promotion: every value here already has at least `int`'s rank except the
-- narrow result of a cast, which promotes back to `int`.
local INT: integer = 1

local function truth(v: importc.CValue): boolean
    return (v.value as number) ~= 0
end

local function boolValue(yes: boolean): importc.CValue
    return integerValue(yes and 1 or 0, integerType(INT, false))
end

local function arithmetic(op: string, a: importc.CValue, b: importc.CValue): (importc.CValue?, string?)
    if a.kind == "string" or b.kind == "string" then
        return nil, "a string is not an arithmetic operand"
    end
    if op == "&&" then
        return boolValue(truth(a) and truth(b))
    elseif op == "||" then
        return boolValue(truth(a) or truth(b))
    end
    if a.kind == "float" or b.kind == "float" then
        local x, y = a.value as number, b.value as number
        local single = (a.kind ~= "float" or a.single == true) and (b.kind ~= "float" or b.single == true)
        local r
        if op == "+" then
            r = x + y
        elseif op == "-" then
            r = x - y
        elseif op == "*" then
            r = x * y
        elseif op == "/" then
            r = x / y
        elseif op == "<" then
            return boolValue(x < y)
        elseif op == ">" then
            return boolValue(x > y)
        elseif op == "<=" then
            return boolValue(x <= y)
        elseif op == ">=" then
            return boolValue(x >= y)
        elseif op == "==" then
            return boolValue(x == y)
        elseif op == "!=" then
            return boolValue(x ~= y)
        else
            return nil, "`" .. op .. "` needs integer operands"
        end
        return {kind = "float", value = single and cdecl.float32(r) or r, single = single}
    end

    -- A shift takes its left operand's type; everything else converts both.
    if op == "<<" or op == ">>" then
        local count = b.value as number
        if count < 0 or count >= (a.bits as integer) then
            return nil, "a shift by " .. tostring(count) .. " is undefined"
        end
        local x = a.value as number
        if op == ">>" then
            return integerValue(math.floor(x / 2 ^ count), a)
        elseif not a.unsigned and x < 0 then
            return nil, "shifting a negative value left is undefined"
        elseif not a.unsigned then
            return fitted(x * 2 ^ count, a)
        else
            return fitted((x * 2 ^ count) % 2 ^ (a.bits as integer), a)
        end
    end

    local t = commonType(a, b)
    local x, whyX = convertInteger(a.value as number, t)
    local y, whyY = convertInteger(b.value as number, t)
    if not x or not y then
        return nil, whyX or whyY
    end
    if op == "+" then
        return fitted(x + y, t)
    elseif op == "-" then
        return fitted(x - y, t)
    elseif op == "*" then
        return fitted(x * y, t)
    elseif op == "/" or op == "%" then
        if y == 0 then
            return nil, "the expression divides by zero"
        end
        local ux, uy = math.abs(x), math.abs(y)
        local q = math.floor(ux / uy)
        local r = ux - q * uy
        if r < 0 then
            q, r = q - 1, r + uy
        elseif r >= uy then
            q, r = q + 1, r - uy
        end
        local result = op == "/" and (((x < 0) ~= (y < 0)) and -q or q) or (x < 0 and -r or r)
        return fitted(result, t)
    elseif op == "&" or op == "|" or op == "^" then
        local xh, xl = halves(x)
        local yh, yl = halves(y)
        local f = op == "&" and bit.band or op == "|" and bit.bor or bit.bxor
        return joined(f(xh, yh), f(xl, yl), t)
    elseif op == "<" then
        return boolValue(x < y)
    elseif op == ">" then
        return boolValue(x > y)
    elseif op == "<=" then
        return boolValue(x <= y)
    elseif op == ">=" then
        return boolValue(x >= y)
    elseif op == "==" then
        return boolValue(x == y)
    elseif op == "!=" then
        return boolValue(x ~= y)
    end

    return nil, "`" .. op .. "` is not a constant operator"
end

-- The type names a constant expression may cast to, by their spelling with single
-- spaces. A `char` cast is left out: whether plain `char` is signed is the target's.
local function castType(spelling: string): importc.CValue?
    local pointerBits = ((cdecl.sizeof("void *") or 8) * 8) as integer
    local pointerRank = pointerBits == 32 and 1 or (longBits == 64 and 2 or 3)
    local narrow = {
        ["signed char"] = {8, false},
        ["unsigned char"] = {8, true},
        ["short"] = {16, false},
        ["short int"] = {16, false},
        ["signed short"] = {16, false},
        ["unsigned short"] = {16, true},
        ["unsigned short int"] = {16, true},
        int8_t = {8, false},
        uint8_t = {8, true},
        int16_t = {16, false},
        uint16_t = {16, true},
    }
    local hit = narrow[spelling]
    if hit then
        return {kind = "int", bits = hit[1], unsigned = hit[2], rank = 0}
    end
    local ranked = {
        ["int"] = {INT, false},
        ["signed"] = {INT, false},
        ["signed int"] = {INT, false},
        ["unsigned"] = {INT, true},
        ["unsigned int"] = {INT, true},
        int32_t = {INT, false},
        uint32_t = {INT, true},
        ["long"] = {2, false},
        ["long int"] = {2, false},
        ["signed long"] = {2, false},
        ["unsigned long"] = {2, true},
        ["unsigned long int"] = {2, true},
        ["long long"] = {3, false},
        ["long long int"] = {3, false},
        ["signed long long"] = {3, false},
        ["unsigned long long"] = {3, true},
        ["unsigned long long int"] = {3, true},
        int64_t = {longBits == 64 and 2 or 3, false},
        uint64_t = {longBits == 64 and 2 or 3, true},
        size_t = {pointerRank, true},
        uintptr_t = {pointerRank, true},
        intptr_t = {pointerRank, false},
        ptrdiff_t = {pointerRank, false},
    }
    local rank = ranked[spelling]
    if rank then
        return integerType(rank[1] as integer, rank[2] as boolean)
    end
    if spelling == "float" or spelling == "double" then
        return {kind = "float", single = spelling == "float"}
    end

    return nil
end

local function cast(t: importc.CValue, v: importc.CValue): (importc.CValue?, string?)
    if v.kind == "string" then
        return nil, "a string cannot be cast to a number"
    end
    if t.kind == "float" then
        local value = v.value as number
        return {kind = "float", value = t.single and cdecl.float32(value) or value, single = t.single}
    end
    local value = v.value as number
    if v.kind == "float" then
        if value ~= value or value == math.huge or value == -math.huge then
            return nil, "the value is not finite"
        end
        value = value < 0 and math.ceil(value) or math.floor(value)
    end
    local converted, why = convertInteger(value, t)
    if not converted then
        return nil, why
    end
    if (t.rank as integer) < INT then
        -- promoted back to int wherever it is used
        return integerValue(converted, integerType(INT, false))
    end

    return integerValue(converted, t)
end

-- A precedence-climbing reader over expanded tokens that evaluates as it goes.
local BINARY_PRECEDENCE: {
    [string]: integer
} = {
    ["||"] = 1,
    ["&&"] = 2,
    ["|"] = 3,
    ["^"] = 4,
    ["&"] = 5,
    ["=="] = 6,
    ["!="] = 6,
    ["<"] = 7,
    [">"] = 7,
    ["<="] = 7,
    [">="] = 7,
    ["<<"] = 8,
    [">>"] = 8,
    ["+"] = 9,
    ["-"] = 9,
    ["*"] = 10,
    ["/"] = 10,
    ["%"] = 10,
}

local function evaluateTokens(tokens: {importc.CToken}): (importc.CValue?, string?)
    local position: integer = 1

    local function peek(): importc.CToken?
        return tokens[position]
    end

    local expression

    local function castAhead(): (importc.CValue?, integer?)
        local words: {string} = {}
        local index: integer = position + 1
        while tokens[index] and tokens[index].kind == "name" do
            words[#words + 1] = tokens[index].text
            index = index + 1
        end
        if #words > 0 and tokens[index] and tokens[index].text == ")" then
            local t = castType(table.concat(words, " "))
            if t then
                return t, index + 1
            end
        end

        return nil, nil
    end

    local function unary(): (importc.CValue?, string?)
        local upcoming = peek()
        if not upcoming then
            return nil, "the expression ends early"
        end
        local token: importc.CToken = upcoming
        if token.kind == "op"
            and (token.text == "-" or token.text == "+" or token.text == "~" or token.text == "!")
        then
            position = position + 1
            local operand, why = unary()
            if not operand then
                return nil, why
            end
            if operand.kind == "string" then
                return nil, "a string is not an arithmetic operand"
            end
            if token.text == "!" then
                return boolValue(not truth(operand))
            elseif token.text == "+" then
                return operand
            elseif token.text == "-" and operand.kind == "float" then
                return {kind = "float", value = -(operand.value as number), single = operand.single}
            elseif token.text == "-" then
                return fitted(-(operand.value as number), operand)
            elseif operand.kind == "float" then
                return nil, "`~` needs an integer operand"
            else
                local high, low = halves(operand.value as number)
                return joined(bit.bnot(high), bit.bnot(low), operand)
            end
        end
        if token.kind == "op" and token.text == "(" then
            local t, after = castAhead()
            if t and after then
                position = after
                local operand, why = unary()
                if not operand then
                    return nil, why
                end
                return cast(t, operand)
            end
            position = position + 1
            local inner, why = expression(0)
            if not inner then
                return nil, why
            end
            local close = peek()
            if not close or close.text ~= ")" then
                return nil, "an unbalanced parenthesis"
            end
            position = position + 1
            return inner
        end
        position = position + 1
        if token.kind == "number" then
            return numberLiteral(token.text)
        elseif token.kind == "char" then
            local bytes, why = literalBytes(token.text)
            if not bytes or #bytes ~= 1 then
                return nil, why or "a character constant holds one byte"
            end
            -- plain `char` is signed or not per target, so only ASCII is certain
            if bytes[1] > 127 then
                return nil, "a character constant outside ASCII"
            end
            return integerValue(bytes[1], integerType(INT, false))
        elseif token.kind == "string" then
            local parts: {string} = {}
            local current: importc.CToken? = token
            while current and current.kind == "string" do
                local bytes, why = literalBytes(current.text)
                if not bytes then
                    return nil, why
                end
                for _, byte in ipairs(bytes) do
                    parts[#parts + 1] = string.char(byte)
                end
                current = peek()
                if current and current.kind == "string" then
                    position = position + 1
                end
            end
            return {kind = "string", text = table.concat(parts)}
        elseif token.kind == "name" then
            return nil, "names " .. token.text .. ", which is not a constant"
        end

        return nil, "`" .. token.text .. "` cannot start an expression"
    end

    expression = function(minimum: integer): (importc.CValue?, string?)
        local first, why = unary()
        if not first then
            return nil, why
        end
        local left: importc.CValue = first
        while true do
            local token = peek()
            if not token or token.kind ~= "op" then
                break
            end
            if token.text == "?" and minimum == 0 then
                position = position + 1
                local yes, whyYes = expression(0)
                if not yes then
                    return nil, whyYes
                end
                local colon = peek()
                if not colon or colon.text ~= ":" then
                    return nil, "a conditional without `:`"
                end
                position = position + 1
                local no, whyNo = expression(0)
                if not no then
                    return nil, whyNo
                end
                if left.kind == "string" then
                    return nil, "a string is not a condition"
                end
                local chosen = truth(left) and yes or no
                if yes.kind == "int" and no.kind == "int" then
                    local t = commonType(yes, no)
                    local converted, whyConvert = convertInteger(chosen.value as number, t)
                    if not converted then
                        return nil, whyConvert
                    end
                    return integerValue(converted, t)
                end
                return chosen
            end
            local precedence = BINARY_PRECEDENCE[token.text]
            if not precedence or precedence <= minimum then
                break
            end
            position = position + 1
            local right, whyRight = expression(precedence)
            if not right then
                return nil, whyRight
            end
            local combined, whyCombined = arithmetic(token.text, left, right)
            if not combined then
                return nil, whyCombined
            end
            left = combined
        end

        return left
    end

    local value, why = expression(0)
    if not value then
        return nil, why
    end
    if position <= #tokens then
        return nil, "`" .. tokens[position].text .. "` is not part of a constant expression"
    end

    return value
end

-- Object-like macros are substituted as tokens, the way the preprocessor does it, so
-- `#define A 1 + 2` inside `A * 3` is 7 rather than 9. A macro is not expanded inside
-- its own expansion.
local function expandMacros(
    tokens: {importc.CToken},
    values: {[string]: string},
    active: {[string]: boolean}
): ({importc.CToken}?, string?)
    local out: {importc.CToken} = {}
    for _, token in ipairs(tokens) do
        local body = token.kind == "name" and not active[token.text] and values[token.text] or nil
        if body then
            local inner, why = cTokens(body)
            if not inner then
                return nil, why
            end
            active[token.text] = true
            local expanded, whyExpanded = expandMacros(inner, values, active)
            active[token.text] = nil
            if not expanded then
                return nil, whyExpanded
            end
            for _, one in ipairs(expanded) do
                out[#out + 1] = one
            end
        else
            out[#out + 1] = token
        end
    end

    return out
end

-- A Lua string literal holding exactly `bytes`, with every byte that is not plain
-- printable ASCII written as a decimal escape.
local function luaString(bytes: string): string
    return '"' .. bytes:gsub('[%c"\\\128-\255]', function(ch)
        return ("\\%03d"):format(ch:byte())
    end) .. '"'
end

-- The shortest decimal spelling that reads back as the same double.
local function numberText(value: number): string
    if value == 0 then
        return "0"
    end
    if value % 1 == 0 and math.abs(value) <= EXACT then
        return ("%.0f"):format(value)
    end
    for digits = 15, 17 do
        local text = ("%." .. tostring(digits) .. "g"):format(value)
        if tonumber(text) == value then
            return text
        end
    end

    return ("%.17g"):format(value)
end

--- A macro value as a Nupp constant expression and its Nupp type, or nil and why not.
local function macroConstant(value: string, values: {[string]: string}, name: string): (string?, string?)
    local tokens, why = cTokens(value)
    if not tokens then
        return nil, why
    end
    local expanded, whyExpanded = expandMacros(tokens, values, {[name] = true})
    if not expanded then
        return nil, whyExpanded
    end
    local result, whyResult = evaluateTokens(expanded)
    if not result then
        return nil, whyResult
    end
    if result.kind == "string" then
        return luaString(result.text as string), "string"
    end
    local number = result.value as number
    if number ~= number or number == math.huge or number == -math.huge then
        return nil, "the value is not finite"
    end

    return numberText(number), "number"
end

local function balancedEnd(text, startAt, open, close)
    local depth = 0
    for index = startAt, #text do
        local ch = text:sub(index, index)
        if ch == open then
            depth = depth + 1
        elseif ch == close then
            depth = depth - 1
            if depth == 0 then
                return index
            end
        end
    end

    return nil
end

----------------------------------------------------------------------------
-- Static inline functions
----------------------------------------------------------------------------

-- The bridge admits the deliberately small first-release inline family: a named
-- internal-linkage definition with an ordinary parameter list. The original C
-- compiler still validates the emitted definition; this scanner only identifies the
-- candidate and never interprets its body.
--
-- `text` is the target header as the preprocessor left it, so a definition in a block
-- this platform compiles out is not a candidate: bridging one wrote C that called a
-- function nothing declared. Attributes are blanked, at their own length so positions
-- still index `text`, because `__attribute__((...))` would otherwise read as the name
-- of the function.
local function staticInlineSignatures(text: string)
    local scan = text:gsub("__attribute_?_?%s*%b()", function(attribute)
        return (attribute:gsub("[^\n]", " "))
    end)
    local found = {}
    local cursor = 1
    while true do
        local startAt, after, name = scan:find("%f[%w_]static%s+inline%s+.-%f[%w_]([%a_][%w_]*)%s*%(", cursor)
        if not startAt then
            break
        end
        local open = scan:find("(", (after as integer) - 1, true)
        local close = open and balancedEnd(scan, open, "(", ")") or nil
        local body = close and scan:find("%S", close + 1) or nil
        if body and scan:sub(body, body) == "{" then
            local signature = text:sub(startAt, close):gsub("^static%s+inline%s+", ""):gsub("%s+", " ")
            local bodyEnd = balancedEnd(scan, body, "{", "}")
            found[#found + 1] = {name = name, signature = signature, startAt = startAt, endAt = bodyEnd or close}
            cursor = (bodyEnd or close) + 1
        else
            cursor = (close or after) + 1
        end
    end

    return found
end

local function withoutStaticInlineDefinitions(text: string): string
    local definitions = staticInlineSignatures(text)
    local out = {}
    local cursor = 1
    for _, definition in ipairs(definitions) do
        out[#out + 1] = text:sub(cursor, definition.startAt - 1)
        out[#out + 1] = newlinesOf(text:sub(definition.startAt, definition.endAt))
        cursor = definition.endAt + 1
    end
    out[#out + 1] = text:sub(cursor)

    return table.concat(out)
end

local RECIPE_C_TYPE = {
    boolean = "_Bool",
    float = "float",
    number = "double",
    integer = "int32_t",
    int8 = "int8_t",
    int16 = "int16_t",
    int32 = "int32_t",
    int64 = "int64_t",
    uint8 = "uint8_t",
    uint16 = "uint16_t",
    uint32 = "uint32_t",
    uint64 = "uint64_t",
}

local function recipeCType(spec)
    if type(spec) ~= "string" then
        return nil
    end
    spec = spec:gsub("%?", ""):gsub("^%s+", ""):gsub("%s+$", "")

    return RECIPE_C_TYPE[spec]
end

local function functionMacroArities(raw)
    local out = {}
    -- In C the opening parenthesis must immediately follow the macro name.
    for name, params in raw:gmatch("#%s*define%s+([%a_][%w_]*)(%b())") do
        local body = params:sub(2, -2)
        local count = body:match("^%s*$") and 0 or 1
        for _ in body:gmatch(",") do
            count = count + 1
        end
        out[name] = body:find("%.%.%.", 1, false) and -1 or count
    end

    return out
end

local function cString(value)
    return '"' .. value:gsub("\\", "\\\\"):gsub('"', '\\"') .. '"'
end

--- An explicit owning return promises a non-null allocation. C pointers import as
--- nullable by default, but Rust `Box<T>` cannot be null, and its terminal has to
--- receive the same representation as the affine result.
local function ownedPointer(rendered: string): string
    return rendered:sub(-1) == "?" and rendered:sub(1, -2) or rendered
end

----------------------------------------------------------------------------
-- What an import is asked for
----------------------------------------------------------------------------

--- What an import was asked for: the compiler that preprocesses the header, the flags
--- it needs to find what the header includes, and the library the generated
--- declarations load from.
type importc.Options = {
    @readonly cc: string?,
    @readonly cppflags: {string}?,
    @readonly lib: string?,

    --- Canonical name for a generated declared module. Direct library callers may
    --- omit this to retain the legacy fragment form.
    @readonly module: string?,

    --- Generate C wrappers for target-header static inline functions.
    @readonly bridge: boolean?,

    --- Explicit signatures for selected function-like macros.
    @readonly macros: {[string]: any}?,

    --- Ownership facts the C header cannot express. A returned pointer may name
    --- its cleanup, and a function may name the parameter positions it consumes.
    @readonly ownership: {
        returns: {[string]: string}?,
        takes: {[string]: {integer}}?
    }?,

    --- Header spelling used by the generated translation unit.
    @readonly bridgeInclude: string?
}

type importc.Disposition = {
    name: string?,
    kind: string,
    reason: string?,
    detail: string?,
    symbol: string?,

    --- The header line the declaration starts on, when it is known.
    line: integer?
}

type importc.Details = {
    direct: integer,
    bridged: integer,
    skipped: integer,
    dispositions: {importc.Disposition},
    bridgeSource: string?
}

-- Main entry: returns the .nupp module text and a list of warnings.
function importc.import(headerPath: string, opts: importc.Options?): string?, {string}, importc.Details?
    opts = opts or {} as importc.Options
    local warnings = {}
    local raw = readFile(headerPath)
    if not raw then
        return nil, {"cannot read " .. headerPath}
    end
    local headerBase = basename(headerPath)
    local ownership = opts.ownership or {}
    local returnedOwned = ownership.returns or {}
    local takenParameters = ownership.takes or {}
    local cleanupTerminals = {}
    for _, cleanup in pairs(returnedOwned) do
        cleanupTerminals[cleanup] = true
    end
    local cc = opts.cc or "cc"
    local cpp = {cc, "-E"}
    for _, flag in ipairs(opts.cppflags or {}) do
        cpp[#cpp + 1] = flag
    end
    cpp[#cpp + 1] = "-xc"
    cpp[#cpp + 1] = headerPath
    local preprocessed = capture(cpp)
    local macros = {cc, "-E", "-dM"}
    for _, flag in ipairs(opts.cppflags or {}) do
        macros[#macros + 1] = flag
    end
    macros[#macros + 1] = "-xc"
    macros[#macros + 1] = headerPath
    local dm = capture(macros) or ""
    if not preprocessed or #preprocessed == 0 then
        return nil, {"cc -E produced no output for " .. headerPath}
    end

    -- The target's own lines, rewritten without moving any of them, so a statement's
    -- line is still the header's.
    local filtered, lineMap = filterToHeader(preprocessed, headerPath)
    local targetText = normalize(filtered, true)
    local text = withoutStaticInlineDefinitions(targetText)
    local targetStatements = statements(text, lineMap)

    -- The type vocabulary comes from the whole translation unit: a header's own
    -- declarations are usually written in typedefs that live in the headers it
    -- includes, and those were filtered out above.
    --
    -- What the target header declares itself is left out of it. Those statements are
    -- about to be parsed as the target, and a name LuaJIT already holds cannot be
    -- declared twice, since pre-declaring one here would fail the parse of the very
    -- header being imported.
    local ownTypedefs = {}
    for _, def in ipairs(collectTypedefs(targetStatements)) do
        ownTypedefs[def.name] = true
    end
    local typedefText = {}
    for _, def in ipairs(collectTypedefs(statements(normalize(stripLinemarkers(preprocessed), true)))) do
        if not ownTypedefs[def.name] then
            typedefText[#typedefText + 1] = ("typedef %s %s;"):format(def.base, def.name)
        end
    end

    -- LuaJIT's parser is the arbiter and the source of the declarations we render.
    -- Included simple typedefs supply the vocabulary removed when the target header was
    -- isolated through cpp linemarkers.
    --
    -- Declaration by declaration, so one the parser will not take costs itself and not
    -- the header. `fcntl.h` holds one struct laid out from a type whose definition
    -- another header owns, and taking the file as one unit spent `open` and `fcntl` on
    -- it.
    --
    -- A statement carrying an attribute that would change it unseen is not offered to
    -- LuaJIT at all: LuaJIT would take it, without the attribute.
    local units: {string} = {}
    local unitStatements: {importc.Statement} = {}
    local refusedStatements: {importc.Statement} = {}
    for _, statement in ipairs(targetStatements) do
        if statement.text:find(REFUSED_MARKER, 1, true) then
            refusedStatements[#refusedStatements + 1] = statement
        else
            units[#units + 1] = statement.text .. ";"
            unitStatements[#units] = statement
        end
    end
    local parsed, ffiErr = cdecl.inspect(units, typedefText)
    if not parsed then
        return nil, {"LuaJIT cdef: " .. tostring(ffiErr)}
    end

    local function lineOf(unit: integer?): integer?
        local statement = unit and unitStatements[unit] or nil
        return statement and statement.line or nil
    end

    -- `header.h:12: ` when the line is known, for a warning.
    local function where(line: integer?): string
        return line and (headerBase .. ":" .. tostring(line) .. ": ") or ""
    end

    -- ` at header.h:12` when the line is known, for a comment.
    local function at(line: integer?): string
        return line and (" at " .. headerBase .. ":" .. tostring(line)) or ""
    end

    local out = {}
    local exports: {string} = {}
    local knownStructs = {}
    local details = {direct = 0, bridged = 0, skipped = #parsed.rejected + #refusedStatements, dispositions = {},}
    for _, reject in ipairs(parsed.rejected) do
        details.dispositions[
            #details.dispositions + 1
        ] = {kind = "skipped", reason = "parse-failure", detail = reject.reason, line = lineOf(reject.unit),}
    end

    local function emit(line)
        out[#out + 1] = line
    end

    emit(("-- generated by nupp import-c from %s"):format(headerBase))
    emit("-- committed and hand-editable: fix or extend freely, re-import")
    emit("-- only when the header changes.")
    if opts.module then
        emit("")
        emit("module " .. opts.module)
    end
    emit("")

    -- What the parser would not take, said in the file that is missing it and again on
    -- the way out. The count is the part that carries: one skipped declaration out of
    -- thirty is a header with a corner in it, and twenty-seven out of thirty is a
    -- vocabulary that broke upstream and a module not worth having.
    local rejectedTotal = #parsed.rejected + #refusedStatements
    if rejectedTotal > 0 then
        for _, statement in ipairs(refusedStatements) do
            local attribute = statement.text:match(REFUSED_MARKER .. "([%w_]+)") or "?"
            local reason = ("the %s attribute changes it in a way LuaJIT would not see"):format(attribute)
            emit(("-- import-c: skipped declaration%s (unsupported-attribute: %s)"):format(at(statement.line), reason))
            emit("--   " .. statement.text:gsub(REFUSED_MARKER, "__attribute__ "):sub(1, 100))
            details.dispositions[
                #details.dispositions + 1
            ] = {kind = "skipped", reason = "unsupported-attribute", detail = reason, line = statement.line,}
            warnings[#warnings + 1] = where(statement.line) .. "skipped a declaration: " .. reason
        end
        for _, reject in ipairs(parsed.rejected) do
            emit(("-- import-c: skipped declaration%s (%s)"):format(at(lineOf(reject.unit)), reject.reason))
            emit("--   " .. reject.text:sub(1, 100))
        end
        emit("")
        local first = parsed.rejected[1] and parsed.rejected[1].reason or "an unsupported attribute"
        warnings[
            #warnings + 1
        ] = ("%d of %d declarations skipped: %s"):format(rejectedTotal, parsed.declared + #refusedStatements, first)
    end

    -- One skip, said three ways: a comment in the file that is missing the declaration,
    -- a disposition for tools, and, for a layout the rendering would have got wrong, a
    -- warning on the way out.
    local function skip(kind: string, name: string?, reason: string, detail: string?, line: integer?, warn: boolean?)
        emit(
            (
                "-- import-c: skipped %s %s%s (%s%s)"
            ):format(kind, tostring(name), at(line), reason, detail and (": " .. detail) or "")
        )
        details.skipped = details.skipped + 1
        details.dispositions[
            #details.dispositions + 1
        ] = {name = name, kind = "skipped", reason = reason, detail = detail, line = line,}
        if warn then
            warnings[
                #warnings + 1
            ] = ("%sskipped %s %s: %s"):format(where(line), kind, tostring(name), detail or reason)
        end
    end

    -- A struct is imported only when the rendering is the same struct: every member
    -- named and rendered, and the rendered members laying out at the header's offsets.
    -- Anything else was the struct that checked, loaded, and was the wrong size.
    for _, declaration in ipairs(parsed.structs) do
        local name = declaration.name
        local line = lineOf(declaration.unit)
        local unitStatement = declaration.unit and unitStatements[declaration.unit] or nil
        local fields: {string} = {}
        local reason, detail, warn = nil, nil, false
        if not identifier(name) then
            reason, detail = "reserved-name", "its name is not a Nupp identifier"
        else
            knownStructs[name] = true
            knownStructs[declaration.id] = name -- self pointers are legal
        end
        if not reason and declaration.anonymous > 0 then
            reason, detail, warn = "anonymous-member", "an anonymous member's fields would promote into it", true
        end
        if not reason and declaration.unnamed > 0 then
            reason, detail, warn = "unnamed-member", "an unnamed member or bitfield pads it", true
        end
        if not reason and declaration.size == nil and #declaration.fields > 0 then
            reason, detail = "incomplete", "C gives it no size"
        end
        if not reason then
            for _, field in ipairs(declaration.fields) do
                local rendered, why = renderType(field.type, knownStructs)
                if not identifier(field.name) then
                    reason, detail = "reserved-name", ("member %s is not a Nupp identifier"):format(field.name)
                elseif not rendered then
                    reason, detail = "unsupported-field-type", ("member %s is %s"):format(field.name, tostring(why))
                elseif field.bitWidth and field.type and field.type.kind == "boolean" then
                    reason, detail = "unsupported-field-type", ("member %s is a bool bitfield"):format(field.name)
                end
                if reason then
                    break
                end
                fields[
                    #fields + 1
                ] = "   " .. field.name .. ": " .. (
                    rendered as string
                ) .. (field.bitWidth and " : " .. tostring(field.bitWidth) or "")
            end
        end
        if not reason and unitStatement and unitStatement.packed then
            reason, detail, warn = "pragma-pack", "it is laid out under #pragma pack", true
        end
        if not reason and declaration.size ~= nil then
            local problem = layoutProblem(declaration, knownStructs)
            if problem then
                reason, detail, warn = "layout-mismatch", problem, true
            end
        end
        if not reason then
            if declaration.size == nil then
                -- A handle: a pointer to it is an ordinary parameter or result, and it
                -- never exists by value.
                emit(("-- import-c: %s is incomplete in C: use it only behind a pointer"):format(name))
            end
            emit("cdef " .. declaration.kind .. " " .. name)
            for _, field in ipairs(fields) do
                emit(field)
            end
            emit("end")
            emit("")
            exports[#exports + 1] = name
            details.dispositions[
                #details.dispositions + 1
            ] = {name = name, kind = "type-only", detail = declaration.size == nil and "incomplete" or nil,}
        else
            knownStructs[name] = nil
            knownStructs[declaration.id] = nil
            skip(declaration.kind, name, reason, detail, line, warn)
        end
    end

    for _, fn in ipairs(parsed.functions) do
        local params = {}
        local ok = identifier(fn.name) and true or false
        local why: string? = not ok and "its name is not a Nupp identifier" or nil
        local takes = {}
        for _, position in ipairs(takenParameters[fn.name] or {}) do
            takes[position] = true
        end
        for index, param in ipairs(ok and fn.params or {}) do
            local rendered, renderWhy = renderType(param.type, knownStructs)
            if not rendered then
                ok = false
                why = ("parameter %d is %s"):format(index, tostring(renderWhy))
                break
            end
            if takes[index] and cleanupTerminals[fn.name] then
                rendered = ownedPointer(rendered)
            end
            local name = identifier(param.name) and param.name or "arg" .. index
            params[#params + 1] = (takes[index] and "takes " or "") .. name .. ": " .. rendered
        end
        if fn.vararg then
            params[#params + 1] = "..."
        end
        local ret
        if ok and fn.returns and fn.returns.kind ~= "void" then
            local renderWhy
            ret, renderWhy = renderType(fn.returns, knownStructs)
            if not ret then
                ok = false
                why = "its result is " .. tostring(renderWhy)
            else
                local cleanup = returnedOwned[fn.name]
                if cleanup then
                    ret = "affine(" .. ownedPointer(ret) .. ", " .. (cleanup as string) .. ")"
                end
            end
        end
        if ok then
            local sig = "cdef function " .. fn.name .. "(" .. table.concat(params, ", ") .. ")"
            if ret then
                sig = sig .. ": " .. ret
            end
            if opts.lib then
                sig = sig .. (" from %q"):format(opts.lib)
            end
            emit(sig)
            exports[#exports + 1] = fn.name
            details.direct = details.direct + 1
            details.dispositions[#details.dispositions + 1] = {name = fn.name, kind = "direct"}
        else
            local reason = identifier(fn.name) and "unsupported-c-type" or "reserved-name"
            skip("function", fn.name, reason, why, lineOf(fn.unit))
        end
    end

    local bridgeLines = {}
    local bridgeAliases = {}

    local function bridgePreamble()
        if #bridgeLines > 0 then
            return
        end
        bridgeLines[#bridgeLines + 1] = "#include <stdint.h>"
        bridgeLines[#bridgeLines + 1] = "#if defined(_WIN32)"
        bridgeLines[#bridgeLines + 1] = "#define NUPP_BRIDGE_EXPORT __declspec(dllexport)"
        bridgeLines[#bridgeLines + 1] = "#else"
        bridgeLines[#bridgeLines + 1] = '#define NUPP_BRIDGE_EXPORT __attribute__((visibility("default")))'
        bridgeLines[#bridgeLines + 1] = "#endif"
        bridgeLines[#bridgeLines + 1] = "#include " .. cString(opts.bridgeInclude or headerPath)
        bridgeLines[#bridgeLines + 1] = ""
    end

    local function addBridge(fn, logicalName, cDeclaration, callExpression)
        local params = {}
        local callArgs = {}
        local ok = identifier(logicalName) and true or false
        for index, param in ipairs(fn.params or {}) do
            local rendered = renderType(param.type, knownStructs)
            if not rendered then
                ok = false
                break
            end
            local name = identifier(param.name) and param.name or "arg" .. tostring(index)
            params[#params + 1] = name .. ": " .. rendered
            callArgs[#callArgs + 1] = name
        end
        local ret = nil
        if fn.returns and fn.returns.kind ~= "void" then
            ret = renderType(fn.returns, knownStructs)
            ok = ok and ret ~= nil
        end
        if not ok then
            warnings[#warnings + 1] = "bridge skipped " .. logicalName .. ": unsupported C type"
            details.skipped = details.skipped + 1
            details.dispositions[
                #details.dispositions + 1
            ] = {name = logicalName, kind = "skipped", reason = "unsupported-bridge-type",}
            return
        end
        local identity = table.concat({"c-bridge-v1", headerBase, logicalName, cDeclaration}, "\0")
        local symbol = "__nupp_bridge_" .. hash.sha256(identity):sub(1, 24)
        bridgePreamble()
        -- The name as a whole identifier: `_` is part of one, so `vec2` must not
        -- match the front of `vec2_t`.
        local wrapperDeclaration = cDeclaration:gsub("%f[%w_]" .. logicalName .. "%f[^%w_]", symbol, 1)
        bridgeLines[#bridgeLines + 1] = "NUPP_BRIDGE_EXPORT " .. wrapperDeclaration .. " {"
        local call = callExpression or (logicalName .. "(" .. table.concat(callArgs, ", ") .. ")")
        bridgeLines[#bridgeLines + 1] = (ret and "    return " or "    ") .. call .. ";"
        bridgeLines[#bridgeLines + 1] = "}"
        bridgeLines[#bridgeLines + 1] = ""

        local sig = "cdef function " .. symbol .. "(" .. table.concat(params, ", ") .. ")"
        if ret then
            sig = sig .. ": " .. ret
        end
        if opts.lib then
            sig = sig .. (" from %q"):format(opts.lib)
        end
        emit(sig)
        emit("local " .. logicalName .. " = " .. symbol)
        bridgeAliases[#bridgeAliases + 1] = logicalName
        exports[#exports + 1] = logicalName
        details.bridged = details.bridged + 1
        details.dispositions[
            #details.dispositions + 1
        ] = {name = logicalName, kind = callExpression and "bridge-macro" or "bridge-inline", symbol = symbol,}
    end

    local candidates = staticInlineSignatures(targetText)
    if opts.bridge then
        local prototypes = {}
        for _, candidate in ipairs(candidates) do
            prototypes[#prototypes + 1] = candidate.signature .. ";"
        end
        local inlineParsed = #prototypes > 0 and cdecl.inspect(prototypes, typedefText) or nil
        local byName = {}
        for _, fn in ipairs(inlineParsed and inlineParsed.functions or {}) do
            byName[fn.name] = fn
        end
        for _, candidate in ipairs(candidates) do
            local fn = byName[candidate.name]
            if fn then
                addBridge(fn, candidate.name, candidate.signature)
            else
                warnings[
                    #warnings + 1
                ] = "bridge skipped " .. candidate.name .. ": signature was not accepted by LuaJIT"
                details.skipped = details.skipped + 1
            end
        end
    else
        for _, candidate in ipairs(candidates) do
            emit(
                "-- import-c: skipped function "
                .. candidate.name
                .. " (static inline needs --bridge-out or bindings.bridge)"
            )
            warnings[#warnings + 1] = "static inline " .. candidate.name .. " needs a configured C bridge"
            details.skipped = details.skipped + 1
            details.dispositions[
                #details.dispositions + 1
            ] = {name = candidate.name, kind = "skipped", reason = "bridge-required",}
        end
    end

    local macroArities = functionMacroArities(raw)
    local macroNames: {string} = {}
    local configuredMacros = opts.macros or {}
    for name in pairs(configuredMacros) do
        macroNames[#macroNames + 1] = name
    end
    table.sort(macroNames)
    for _, name in ipairs(macroNames) do
        local recipe = configuredMacros[name]
        local parameters = type(recipe) == "table" and recipe.parameters or nil
        local result = type(recipe) == "table" and recipe.result or nil
        local arity = macroArities[name]
        local valid = identifier(name) and type(parameters) == "table" and arity and arity >= 0 and #parameters == arity
        local cparams, nparams, args = {}, {}, {}
        if valid then
            for index, spec in ipairs(parameters) do
                local ctype = recipeCType(spec)
                if not ctype then
                    valid = false
                    break
                end
                local arg = "arg" .. tostring(index - 1)
                cparams[#cparams + 1] = ctype .. " " .. arg
                nparams[#nparams + 1] = {name = arg, type = assert(cdecl.typeFromString(ctype))}
                args[#args + 1] = arg
            end
        end
        local cresult = result and recipeCType(result) or "void"
        if result and not cresult then
            valid = false
        end
        if valid then
            local fn = {
                params = nparams,
                returns = result and assert(cdecl.typeFromString(cresult)) or {kind = "void"},
            }
            local declaration = cresult .. " " .. name .. "(" .. (
                #cparams > 0 and table.concat(cparams, ", ") or "void"
            ) .. ")"
            addBridge(fn, name, declaration, name .. "(" .. table.concat(args, ", ") .. ")")
        else
            warnings[#warnings + 1] = "bridge skipped macro " .. name .. ": invalid or mismatched signature"
            details.skipped = details.skipped + 1
            details.dispositions[
                #details.dispositions + 1
            ] = {name = name, kind = "skipped", reason = "invalid-macro-signature",}
        end
    end
    if #bridgeAliases > 0 then
        emit("")
    end

    -- constants
    local constLines: {string} = {}
    local taken = {}

    local function constant(name, typeName, expr)
        if not identifier(name) or taken[name] then
            return
        end
        taken[name] = true
        constLines[#constLines + 1] = ("local %s: %s = %s"):format(name, typeName, expr)
        exports[#exports + 1] = name
    end

    -- An enum's members, which are what a header declares an enum for. The type itself
    -- is already an integer everywhere it appears, and C's own enum tag checks nothing
    -- a caller could rely on, so the members come across as the named constants they
    -- are, and are usable anywhere `int32` is.
    for _, declaration in ipairs(parsed.enums or {}) do
        for _, member in ipairs(declaration.values) do
            constant(member.name, "int32", tostring(member.value))
        end
    end

    -- The header's own object-like macros, evaluated as C. One that defines nothing,
    -- as an include guard does, is not a constant and is not reported; one whose
    -- value is not a constant expression is skipped with the reason.
    local values = macroValues(dm)
    local seenMacros: {[string]: boolean} = {}
    for _, name in ipairs(headerMacroNames(raw)) do
        local value = values[name]
        if value and value ~= "" and not seenMacros[name] and not taken[name] and identifier(name) then
            seenMacros[name] = true
            local expr, typeOrWhy = macroConstant(value, values, name)
            if expr then
                constant(name, typeOrWhy as string, expr)
            else
                skip("macro", name, "untranslatable-macro", typeOrWhy)
            end
        end
    end
    if #constLines > 0 then
        emit("")
        for _, line in ipairs(constLines) do
            emit(line)
        end
    end

    -- Module shape. A named output is a real declared module; the unnamed form is
    -- retained for callers that use this function as a declaration fragment.
    emit("")
    local pairsOut = {}
    for _, name in ipairs(exports) do
        pairsOut[#pairsOut + 1] = name .. " = " .. name
    end
    emit((opts.module and "export = { " or "return { ") .. table.concat(pairsOut, ", ") .. " }")
    emit("")

    if #bridgeLines > 0 then
        details.bridgeSource = table.concat(bridgeLines, "\n") .. "\n"
    end

    return table.concat(out, "\n"), warnings, details
end

export = importc
