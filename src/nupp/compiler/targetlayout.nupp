module nupp.compiler.targetlayout

--[[
Compiler-owned C layouts for declared build targets.

The runtime `layoutof` helper asks LuaJIT's FFI about the machine running the
generated program. This module deliberately does not: it implements the subset of C
layout nupp's reified type vocabulary can express, keyed by an explicit target triple.
That makes a folded size a property of the build target rather than the compiler host.
]]

local record targetLayout
    ABI: integer
    keys: function(): {string}
    has: function(string?): boolean
    hostKey: function(): string?
    of: function(any, string): (any?, string?)
    vector: function(string, integer, integer): (targetLayout.Vector?, string?)
    storageVector: function(any): (string?, integer?)
    luaVectorAlignment: function(integer, integer): integer
    VECTOR_ELEMENT_BYTES: {[string]: integer}
end

--- The storage a `Fixed<N>` vector field would occupy: its payload bytes, the
--- alignment the target gives it, the padding that makes up the difference,
--- and the size it occupies in a struct or an array stride.
type targetLayout.Vector = {
    payload: integer,
    alignment: integer,
    padding: integer,
    size: integer
}

targetLayout.ABI = 1

local type Scalar = {
    size: integer,
    alignment: integer
}

local type Model = {
    key: string,
    pointer: Scalar,
    int64: Scalar,
    number: Scalar,
    vector: Vector,
    bitfields: string
}

--- What a target gives a vector in memory: the largest alignment one may
--- claim. A vector's natural alignment is its payload rounded up to a power of
--- two, as every C ABI below gives a `vector_size` type, and the cap is where
--- that stops: what the target's allocator guarantees, since a `Fixed<N>` field
--- the allocator cannot align is a field the kernel cannot load aligned.
---
--- Evidence, recorded before any storage field is admitted:
--- - AAPCS64 (Arm 64-bit Procedure Call Standard, 5.1.2): short vectors of 8
---   and 16 bytes are aligned to their size; macOS, Linux and Windows `malloc`
---   on arm64 return 16-byte aligned memory.
--- - x86-64 System V ABI (3.1.2): `__m128` 16, `__m256` 32, `__m512` 64; glibc
---   and macOS `malloc` guarantee 16. Windows x64 `HeapAlloc` guarantees 16.
--- - i686 System V and MSVC: `malloc` guarantees 8; `__m128` wants 16, which a
---   plain allocation does not give, so the cap is 8 and a 16-byte vector field
---   is unaligned there.
--- - wasm32 (Emscripten): `v128` is 16-byte aligned and dlmalloc returns
---   16-byte aligned memory.
---
--- A payload that is not a power of two, `Fixed<3>` of `float` at 12 bytes,
--- aligns to the next power of two under the cap, 16, and pads to it, so its
--- size is 16 and an array of them strides by 16. A payload past the cap,
--- `Fixed<8>` of `float` at 32 bytes on a 16-byte target, aligns to the cap and
--- pads to a multiple of it. Masks have no storage representation here.
local type Vector = {maximumAlignment: integer}

--- A bitfield's `offset` and `size` are its storage unit's: the declared
--- type's bytes it is read and written through, as LuaJIT's `offsetof` answers.
--- `bitOffset` counts from that unit's least significant bit, which is where
--- every target below allocates first.
local type Field = {
    name: string,
    offset: integer,
    size: integer,
    alignment: integer,
    bitOffset: integer?,
    bitWidth: integer?
}

local function scalar(size: integer, alignment: integer?): Scalar
    return {size = size, alignment = alignment or size}
end

-- Every currently reifiable scalar is fixed-width. The only distinctions among the
-- supported ABIs are therefore pointer width, the 32-bit aggregate alignment of
-- double/int64, and how bitfields share storage units. Adding C long or vector
-- types would require another model field rather than silently borrowing one of
-- these.
--
-- Bitfields follow one of two rule families. `sysv` is the GCC and Clang rule the
-- System V, AAPCS64 and Emscripten ABIs share: a bitfield takes the next free bits
-- unless that would cross a boundary of its declared type's size, when it starts
-- at that boundary, and a following ordinary field starts at the next byte its
-- alignment allows. `msvc` is Microsoft's: consecutive bitfields share a unit
-- only while their declared types have the same size and the unit has room, and
-- every unit occupies its declared type's whole size.
local LP64 = {
    pointer = scalar(8),
    int64 = scalar(8),
    number = scalar(8),
    vector = {maximumAlignment = 16},
    bitfields = "sysv",
}
local LP64_MSVC = {
    pointer = scalar(8),
    int64 = scalar(8),
    number = scalar(8),
    vector = {maximumAlignment = 16},
    bitfields = "msvc",
}
local ILP32_SYSV = {
    pointer = scalar(4),
    int64 = scalar(8, 4),
    number = scalar(8, 4),
    vector = {maximumAlignment = 8},
    bitfields = "sysv",
}
local ILP32_MSVC = {
    pointer = scalar(4),
    int64 = scalar(8),
    number = scalar(8),
    vector = {maximumAlignment = 8},
    bitfields = "msvc",
}
local WASM32 = {
    pointer = scalar(4),
    int64 = scalar(8),
    number = scalar(8),
    vector = {maximumAlignment = 16},
    bitfields = "sysv",
}

local MODELS: {[string]: Model} = {}

local function install(keys: {string}, profile: any)
    for _, key in ipairs(keys) do
        MODELS[
            key
        ] = {
            key = key,
            pointer = profile.pointer,
            int64 = profile.int64,
            number = profile.number,
            vector = profile.vector,
            bitfields = profile.bitfields,
        }
    end
end

install({"x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu", "x86_64-apple-darwin", "aarch64-apple-darwin",}, LP64)
install({"x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc"}, LP64_MSVC)
install({"i686-unknown-linux-gnu"}, ILP32_SYSV)
install({"i686-pc-windows-msvc"}, ILP32_MSVC)
install({"wasm32-unknown-emscripten"}, WASM32)

local ORDERED_KEYS = {
    "aarch64-apple-darwin",
    "aarch64-pc-windows-msvc",
    "aarch64-unknown-linux-gnu",
    "i686-pc-windows-msvc",
    "i686-unknown-linux-gnu",
    "wasm32-unknown-emscripten",
    "x86_64-apple-darwin",
    "x86_64-pc-windows-msvc",
    "x86_64-unknown-linux-gnu",
}

function targetLayout.keys(): {string}
    local out = {}
    for index, key in ipairs(ORDERED_KEYS) do
        out[index] = key
    end

    return out
end

function targetLayout.has(key: string?): boolean
    return key ~= nil and MODELS[key] ~= nil
end

--- The explicit target key for the VM running the compiler, when modeled.
--- Cross-target callers pass their own key and never reach this function.
function targetLayout.hostKey(): string?
    local nativeKey = rawget(_G, "__nuppHostTargetLayout")
    if nativeKey ~= nil then
        return MODELS[nativeKey] and nativeKey or nil
    end
    local architectures: {[string]: string} = {x64 = "x86_64", x86 = "i686", arm64 = "aarch64"}
    local systems: {[string]: string} = {OSX = "apple-darwin", Linux = "unknown-linux-gnu", Windows = "pc-windows-msvc"}
    local host: any = rawget(_G, "jit")
    local architecture = host and architectures[host.arch] or nil
    local system = host and systems[host.os] or nil
    local key = architecture and system and architecture .. "-" .. system or nil

    return key and MODELS[key] and key or nil
end

local function roundUp(value: integer, alignment: integer): integer
    return math.floor((value + alignment - 1) / alignment) * alignment
end

--- The storage a `Fixed<lanes>` vector of an element `elementBytes` wide
--- occupies under `key`, by the contract above. It is what a storage struct
--- holding such a field is laid out by: `of` below, the generated C
--- declaration and the native emitter all take their answer from here.
function targetLayout.vector(key: string, elementBytes: integer, lanes: integer): (targetLayout.Vector?, string?)
    local model = MODELS[key]
    if not model then
        return nil, "unknown target layout key " .. tostring(key)
    end
    if elementBytes < 1 or lanes < 1 or elementBytes % 1 ~= 0 or lanes % 1 ~= 0 then
        return nil, "a vector has a positive whole element width and lane count"
    end
    local payload = elementBytes * lanes
    local natural = elementBytes
    while natural < payload do
        natural = natural * 2
    end
    local alignment = math.min(natural, model.vector.maximumAlignment) as integer
    if alignment < elementBytes then
        alignment = elementBytes
    end
    local size = roundUp(payload, alignment)

    return {payload = payload, alignment = alignment, padding = size - payload, size = size}, nil
end

--- The storage width of each element a vector field may have, by the
--- element type's tag.
const VECTOR_ELEMENT_BYTES: {
    [string]: integer
} = {
    float32 = 4,
    float64 = 8,
    number = 8,
    int8 = 1,
    uint8 = 1,
    int16 = 2,
    uint16 = 2,
    int32 = 4,
    uint32 = 4,
    int64 = 8,
    uint64 = 8,
}

targetLayout.VECTOR_ELEMENT_BYTES = VECTOR_ELEMENT_BYTES

--- The element tag and lane count of a `simd.Vector<T, simd.Fixed<N>>` whose
--- element is a storage width: the one vector shape with a layout that does
--- not depend on the CPU tier, and so the one a storage struct may hold. Nil
--- for a mask, a preferred species, a species derived from one, and anything
--- that is not a vector.
function targetLayout.storageVector(t: any): (string?, integer?)
    local raw = t
    while raw ~= nil and (raw.tag == "const" or raw.tag == "affine" or raw.tag == "borrowed" or raw.tag == "pinned") do
        raw = raw.inner
    end
    while raw ~= nil and raw.tag == "genericAlias" do
        raw = raw.body
    end
    if raw == nil or raw.tag ~= "nominal" then
        return nil, nil
    end
    local origin = raw.origin or raw
    if origin.moduleName ~= "nupp.simd" or origin.name ~= "Vector" then
        return nil, nil
    end
    local arguments = raw.typeArgs or {}
    local element = arguments[1]
    while element ~= nil and element.tag == "const" do
        element = element.inner
    end
    if element == nil or VECTOR_ELEMENT_BYTES[element.tag as string] == nil then
        return nil, nil
    end
    local species = arguments[2]
    local speciesOrigin = species ~= nil and (species.origin or species) or nil
    if species == nil
        or species.tag ~= "nominal"
        or speciesOrigin.moduleName ~= "nupp.simd"
        or speciesOrigin.name ~= "Fixed"
    then
        return nil, nil
    end
    local count = (species.constArgs or {})[1]
    if count == nil or count.tag ~= "constLiteral" or count.domain ~= "integer" then
        return nil, nil
    end

    return element.tag as string, count.value as integer
end

--- The alignment the Lua form gives a stored `Fixed<N>` field, through the
--- `aligned` attribute on its C array. Every host LuaJIT runs on here is a
--- 64-bit target or Wasm, whose allocators guarantee 16 bytes, so this is the
--- LP64 answer; a 32-bit host would want its own key's cap.
function targetLayout.luaVectorAlignment(elementBytes: integer, lanes: integer): integer
    local laid = targetLayout.vector("x86_64-unknown-linux-gnu", elementBytes, lanes)

    return (laid as targetLayout.Vector).alignment
end

local FIXED: {
    [string]: Scalar
} = {
    boolean = scalar(1),
    float32 = scalar(4),
    integer = scalar(4),
    int8 = scalar(1),
    int16 = scalar(2),
    int32 = scalar(4),
    uint8 = scalar(1),
    uint16 = scalar(2),
    uint32 = scalar(4),
}

--- Computes a complete runtime layout for `t` under `key`.
---
--- The accepted types are exactly the runtime shapes nupp can reify into a C struct:
--- fixed-width scalars, pointers (including nullable pointers and C function
--- pointers), fixed arrays, and structs and unions composed from those, with
--- bitfields of integer and boolean types. A pointer never follows its pointee.
function targetLayout.of(t: any, key: string): any?, string?
    local model = MODELS[key]
    if not model then
        return nil, "unknown layout target " .. tostring(key)
    end

    local active: {[any]: boolean} = {}
    local layoutType: function(any): (Scalar?, string?, {Field}?, {[string]: integer}?)

    layoutType = function(subject: any): Scalar?, string?, {Field}?, {[string]: integer}?
        if not subject then
            return nil, "the type is unresolved"
        end
        local fixed = FIXED[subject.tag]
        if fixed then
            return fixed
        elseif subject.tag == "literal" and type(subject.constant) == "number" then
            -- A tag field holds one integer value at the width of a C enumerator.
            return FIXED.int32
        elseif subject.tag == "number" or subject.tag == "float64" then
            return model.number
        elseif subject.tag == "int64" or subject.tag == "uint64" then
            return model.int64
        elseif subject.tag == "cstring" or subject.tag == "voidptr" or subject.tag == "ptr" then
            return model.pointer
        elseif subject.tag == "func" and subject.foreign then
            -- A C function pointer, which is what a callback field holds.
            return model.pointer
        elseif subject.tag == "union" and subject.hasNil and #subject.members == 2 then
            local other = subject.members[1].tag == "nil" and subject.members[2] or subject.members[1]
            if other
                and (
                    other.tag == "ptr"
                    or other.tag == "cstring"
                    or other.tag == "voidptr"
                    or other.tag == "func" and other.foreign
                )
            then
                return model.pointer
            end
        elseif subject.tag == "union" then
            -- A union of pointers is one pointer whichever member it holds.
            local pointers = true
            for _, member in ipairs(subject.members) do
                if member.tag ~= "nil" and member.tag ~= "ptr" then
                    pointers = false
                end
            end
            if pointers then
                return model.pointer
            end
        elseif subject.tag == "carray" then
            if not subject.count or subject.count < 0 then
                return nil, "an unsized C array has no compile-time layout"
            end
            local element, why = layoutType(subject.elem)
            if not element then
                return nil, why
            end
            return scalar(element.size * (subject.count as integer), element.alignment)
        elseif subject.tag == "nominal" and subject.declKind ~= "struct" then
            local element, lanes = targetLayout.storageVector(subject)
            if element ~= nil then
                -- A stored vector field: its payload padded to its alignment, as
                -- the contract above states, so the next field and the array
                -- stride see the padded size.
                local laid = targetLayout.vector(
                    key,
                    VECTOR_ELEMENT_BYTES[element as string] as integer,
                    lanes as integer
                )
                local vector = laid as targetLayout.Vector
                return scalar(vector.size, vector.alignment)
            end
            local origin = subject.origin or subject
            if origin.moduleName == "nupp.simd" and origin.name == "Mask" then
                return nil, "a mask has no storage layout"
            elseif origin.moduleName == "nupp.simd" and origin.name == "Vector" then
                return nil, "a vector of a tier-dependent species has no target-independent layout"
            end
        elseif subject.tag == "nominal" and subject.declKind == "struct" then
            if active[subject] then
                return nil, "a by-value struct cycle has no finite layout"
            end
            active[subject] = true
            local fields, offsets = {}, {}
            -- The cursor counts bits, so a bitfield can end partway through a byte.
            local cursor: integer, aggregateAlignment: integer = 0, 1
            local isUnion = subject.cdefKind == "union"
            -- The storage unit Microsoft's rule is filling: its byte offset and
            -- size, and the bits of it already taken. Nil when the last field was
            -- not a bitfield.
            local unitOffset: integer?, unitSize: integer?, unitUsed: integer = nil, nil, 0
            for _, name in ipairs(subject.fieldOrder or {}) do
                local definition = subject.fieldDefs and subject.fieldDefs[name]
                local width: integer? = definition and definition.bitWidth as integer? or nil
                local fieldType = subject.byname and subject.byname[name] or nil
                local one, why = layoutType(fieldType)
                if not one then
                    active[subject] = nil
                    return nil, ("field %q %s"):format(name, why or "has no layout")
                end
                local offset: integer
                local bitOffset: integer? = nil
                if width then
                    local unitBits = one.size * 8
                    if not FIXED[fieldType.tag] and fieldType.tag ~= "int64" and fieldType.tag ~= "uint64"
                        or fieldType.tag == "float32"
                        or fieldType.tag == "float64"
                        or width < 1
                        or width > unitBits
                    then
                        active[subject] = nil
                        return nil, ("bitfield %q has no C layout"):format(name)
                    end
                    if isUnion then
                        offset, bitOffset = 0, 0
                        cursor = math.max(cursor, one.size * 8)
                    elseif model.bitfields == "msvc" then
                        if unitOffset ~= nil and unitSize == one.size and unitUsed + width <= unitBits then
                            offset, bitOffset = unitOffset as integer, unitUsed
                            unitUsed = unitUsed + width
                        else
                            offset = roundUp(roundUp(cursor, 8) // 8, one.alignment)
                            unitOffset, unitSize, unitUsed = offset, one.size, width
                            bitOffset = 0
                            cursor = (offset + one.size) * 8
                        end
                    else
                        local start = cursor
                        if start // unitBits ~= (start + width - 1) // unitBits then
                            start = roundUp(start, unitBits)
                        end
                        offset = (start // unitBits) * one.size
                        bitOffset = start - offset * 8
                        cursor = start + width
                    end
                else
                    unitOffset = nil
                    offset = isUnion and 0 or roundUp(roundUp(cursor, 8) // 8, one.alignment)
                    cursor = isUnion and math.max(cursor, one.size * 8) or (offset + one.size) * 8
                end
                fields[
                    #fields + 1
                ] = {
                    name = name,
                    offset = offset,
                    size = one.size,
                    alignment = one.alignment,
                    bitOffset = bitOffset,
                    bitWidth = width,
                }
                offsets[name] = offset
                if one.alignment > aggregateAlignment then
                    aggregateAlignment = one.alignment
                end
            end
            active[subject] = nil
            if #fields == 0 then
                return nil, "an empty struct has no C layout"
            end
            return scalar(
                roundUp(roundUp(cursor, 8) // 8, aggregateAlignment),
                aggregateAlignment
            ), nil, fields, offsets
        end

        return nil, ("%s has no runtime layout"):format(tostring(subject.tag))
    end

    local measured, why, fields, offsets = layoutType(t)
    if not measured then
        return nil, why
    end
    fields, offsets = fields or {}, offsets or {}
    local parts = {key, "abi=" .. targetLayout.ABI}
    if t.cdefKind then
        parts[#parts + 1] = "aggregate=" .. t.cdefKind
    end
    for _, field in ipairs(fields) do
        parts[#parts + 1] = ("%s@%d:%d/%d"):format(field.name, field.offset, field.size, field.alignment)
        if field.bitWidth then
            parts[#parts] = parts[#parts] .. ("+%d.%d"):format(field.bitOffset as integer, field.bitWidth as integer)
        end
    end
    parts[#parts + 1] = ("size=%d/align=%d"):format(measured.size, measured.alignment)

    return {
        target = key,
        abi = targetLayout.ABI,
        size = measured.size,
        alignment = measured.alignment,
        fields = fields,
        offsets = offsets,
        fingerprint = table.concat(parts, "|"),
    }
end

export = targetLayout
