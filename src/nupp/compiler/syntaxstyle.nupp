module nupp.compiler.syntaxstyle

--[[
What colour a Nupp token is, independent of what the colour is written in.

Two renderers ask: the documentation generator, which spells an answer as an HTML
class, and the terminal, which spells it as an escape. They have to agree -- a
`record` name that is a type on the website and a variable in `nupp bc` reads as
two languages -- so the decision lives here and neither renderer makes one.

The answer is a style name: `keyword`, `type`, `string`, and the rest of the set
`nuppdoc-token-*` and the terminal palette are both keyed by. Classification is
contextual, because Nupp's syntax is: `record` is a keyword only where a
declaration can start, and a bare name is a type, a call or a binding depending
on what the semantic layer made of it.
]]

local lexer = require("nupp.compiler.lexer")
local parser = require("nupp.compiler.parser")
local semantic = require("nupp.compiler.lsp.semantic")
local types = require("nupp.compiler.types")

local syntaxstyle = {}

--- One run of source and the style it carries, in source order and covering
--- every byte. `style` is absent for text that carries no colour of its own:
--- whitespace, and the separators between tokens.
type syntaxstyle.Span = {
    text: string,
    style: string?
}

local TYPE_NAMES = {borrowed = true, ctype = true, metatable = true, owned = true, pinned = true,}
for name in pairs(types.builtins) do
    TYPE_NAMES[name] = true
end

local CONTEXTUAL_KEYWORDS = {
    ["as"] = true,
    associated = true,
    borrows = true,
    cdef = true,
    comptime = true,
    constructor = true,
    continue = true,
    exclusive = true,
    from = true,
    takes = true,
    const = true,
    global = true,
    interface = true,
    handle = true,
    ["is"] = true,
    keyof = true,
    satisfies = true,
    ["new"] = true,
    nosuspend = true,
    out = true,
    preserves = true,
    record = true,
    metamethod = true,
    scoped = true,
    ["sealed"] = true,
    suspension = true,
    unpackof = true,
    where = true,
    with = true,
    writekeyof = true,
    writeof = true,
    readonly = true,
    releases = true,
    retains = true,
    resumes = true,
    struct = true,
    type = true,
    writeonly = true,
    yields = true,
}

local LITERAL_KEYWORDS = {["false"] = true, ["nil"] = true, ["true"] = true}

-- `comptime` and `nosuspend` change when code runs rather than what it does, so they
-- get the directive colour used for annotations instead of blending into ordinary
-- control keywords -- matching the Scintillua and VS Code grammars.
local DIRECTIVE_KEYWORDS = {comptime = true, nosuspend = true}

local PUNCTUATION = {
    ["("] = true,
    [")"] = true,
    ["["] = true,
    ["]"] = true,
    ["{"] = true,
    ["}"] = true,
    [","] = true,
    [";"] = true,
    [":"] = true,
    ["."] = true,
    ["@"] = true,
}

local TYPE_DECLARATIONS: {[string]: boolean} = {interface = true, record = true, struct = true, type = true,}

--- The declarations whose next name is the thing being declared, which is what
--- makes that name a type rather than whatever a bare name would otherwise be.
syntaxstyle.TYPE_DECLARATIONS = TYPE_DECLARATIONS

local SYNTAX_STYLES = {
    decorator = "meta",
    keyword = "keyword",
    type = "type",
    struct = "type",
    interface = "type",
    typeParameter = "type",
    ["function"] = "function",
    method = "function",
    property = "property",
    parameter = "variable",
    variable = "variable",
}

local function tokenStyle(tokens, index, syntaxKinds)
    local token = tokens[index]
    local previous = tokens[index - 1]
    local following = tokens[index + 1]
    if token.kind == "name" then
        local syntaxKind = syntaxKinds[token]
        -- The semantic layer calls a directive a keyword, which it is; the colour says
        -- which kind of one, so the directive answers before that. It answers after the
        -- other semantic kinds, so a binding that merely spells one of these names is
        -- still coloured as the binding it is.
        if syntaxKind == "keyword" and DIRECTIVE_KEYWORDS[token.text] then
            return "meta"
        end
        local syntaxStyle = SYNTAX_STYLES[syntaxKind]
        if syntaxStyle then
            return syntaxStyle
        end
        if DIRECTIVE_KEYWORDS[token.text] then
            return "meta"
        end
        if CONTEXTUAL_KEYWORDS[token.text] then
            return "keyword"
        end
        if TYPE_NAMES[token.text] or token.text:match("^%u") then
            return "type"
        end
        if previous and previous.text == "@" then
            return "meta"
        end
        if previous and previous.kind == "function" then
            return "function"
        end
        if previous and previous.text == "metamethod" then
            return "function"
        end
        if previous and TYPE_DECLARATIONS[previous.text] then
            return "type"
        end
        if following and following.text == "(" then
            return "function"
        end
        if previous and (previous.text == "." or previous.text == ":") then
            return "property"
        end
        return "variable"
    elseif lexer.KEYWORDS[token.kind] then
        return LITERAL_KEYWORDS[token.text] and "boolean" or "keyword"
    elseif token.kind == "string"
        or token.kind == "istringOpen"
        or token.kind == "istringMid"
        or token.kind == "istringClose"
    then
        return "string"
    elseif token.kind == "number" then
        return "number"
    elseif PUNCTUATION[token.text] then
        return token.text == "@" and "meta" or "punctuation"
    end

    return "operator"
end

--- The style one token carries, given the tokens around it and what the semantic
--- layer made of the names among them.
---
--- @param tokens the parse's token list
--- @param index which token to classify
--- @param syntaxKinds the semantic kinds, by token
--- @return the style name
--- @raises never
function syntaxstyle.token(tokens: {any}, index: integer, syntaxKinds: any): string
    return tokenStyle(tokens, index, syntaxKinds)
end

--- Classifies a whole source into spans, comments and whitespace included.
---
--- Source that does not parse has no spans: a renderer that asked for colour gets
--- nothing to paint and shows the text it already had. `nupp bc` only ever asks
--- about a file that just compiled, so that path is a fallback rather than a
--- case, but a renderer must not be the thing that reports a parse error.
---
--- @param source the Nupp source to classify
--- @param name the chunk name parse errors would be reported against
--- @return the spans, in source order, or nothing when the source does not parse
--- @raises never
function syntaxstyle.spans(source: string, name: string?): {syntaxstyle.Span}?
    local parsed: any
    local ok = pcall(function(): nil
        parsed = parser.parse(source, name or "highlight.nupp")
    end)
    if not ok or parsed == nil then
        return nil
    end
    local tokens = parsed.tokens
    local kinds: any = semantic.syntaxKinds(parsed)
    local spans: {syntaxstyle.Span} = {}
    for index, token in ipairs(tokens) do
        for trivia = 1, token.triviaCount do
            local kind = lexer.triviaKind(token, trivia)
            local text = lexer.triviaText(token, trivia)
            local commented = kind == "comment" or kind == "hashbang"
            spans[#spans + 1] = {text = text, style = commented and "comment" or nil}
        end
        if token.kind ~= "eof" then
            spans[#spans + 1] = {text = token.text, style = tokenStyle(tokens, index, kinds)}
        end
    end

    return spans
end

export = syntaxstyle
