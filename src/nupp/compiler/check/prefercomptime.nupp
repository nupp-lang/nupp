module nupp.compiler.check.prefercomptime

--[[
A closed runtime function doing work the comptime evaluator can erase.

This is deliberately a lint rather than implicit partial evaluation. Moving work to
checking changes when failures happen and spends the compiler's bounded evaluation
budget, so source has to ask for it. The lint asks the same bounded evaluator that an
explicit `comptime do` uses instead of maintaining a weaker syntactic imitation of its
environment. It is opt-in and first applies cheap shape filters: only no-input
functions containing real work reach evaluation.
]]

local cst = require("nupp.compiler.cst")
local lints = require("nupp.compiler.lints")
local state = require("nupp.compiler.check.state")

local prefercomptime = {}

local WORK = {
    call = true,
    forinStmt = true,
    fornumStmt = true,
    methodCall = true,
    repeatStmt = true,
    tableExpr = true,
    whileStmt = true,
}

local function worthwhile(node): boolean
    local found = false
    local valid = true
    local function walk(value)
        if not valid or not value or cst.isToken(value) then
            return
        end
        if value.kind == "comptimeExpr" then
            valid = false
            return
        end
        if WORK[value.kind] then
            found = true
        end
        if value.kind == "funcbody" or value.kind == "shortfn" or value.kind == "funcExpr" then
            return
        end
        for _, child in ipairs(value) do
            walk(child)
        end
    end

    walk(node)

    return valid and found
end

local function evaluate(c: state.Checker, body: any): (string?, string?)
    local source = "comptime do\n" .. cst.textOf(body.body) .. "\nend"
    local comptime = require(
        "nupp.compiler.comptime"
    ) as {evaluateDirect: function(any, any, any, any, any): (string?, any, any, any)}
    local quoted, _, failure, envelope = comptime.evaluateDirect(body, body.body, {}, {}, c.comptimeFunctions)
    if failure or envelope or not quoted or quoted:sub(1, 1) == "{" then
        return nil, source
    end

    return quoted, source
end

local function fix(c: state.Checker, body: any): {any}?
    local block = body.body
    local first, last = cst.firstToken(block), cst.lastToken(block)
    local source = c.result and c.result.source
    if not first or not last or type(source) ~= "string" then
        return nil
    end
    local finish = last.offset + #last.text
    local original = source:sub(first.offset, finish - 1)
    local indent = string.rep(" ", math.max(first.col - 1, 0))
    local inner = indent .. "    "
    local normalized = original:gsub("\n" .. indent, "\n")
    local replacement = "return comptime do\n" .. inner .. normalized:gsub(
        "\n",
        "\n" .. inner
    ) .. "\n" .. indent .. "end"

    return {
        c.edits.fix("evaluate the body with `comptime do`", {
            offset = first.offset,
            length = finish - first.offset,
            newText = replacement,
        })
    }
end

--- Reports one ordinary function declaration when explicit comptime evaluation can
--- replace meaningful runtime work with a materially smaller scalar literal.
function prefercomptime.check(c: state.Checker, declaration: any, body: any, receiver: boolean): nil
    local lint = lints.get("prefer-comptime")
    if not lint or lints.level(
        lint,
        c.lintConfig
    ) == "off" or c.suppressed(
        lint.code
    ) or declaration.comptimeFunction or receiver or body.generics or #(
        body.params or {}
    ) ~= 0 or not worthwhile(body.body) then
        return
    end

    local quoted, candidate = evaluate(c, body)
    if not quoted or not candidate or #candidate < #quoted + 32 then
        return
    end

    c.diag(
        lint.code,
        declaration.name or body,
        "this no-input function does closed deterministic work every time it is called",
        fix(c, body),
        {help = ("evaluate the body with `comptime do`; it reduces to `%s`"):format(quoted)}
    )
end

export = prefercomptime
