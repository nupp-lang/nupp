module nupp.compiler.check.operators

--[[
Which operators are which, and what they dispatch to.

Plain data, shared by the passes that dispatch on an operator token. The families
follow LuaJIT's primitive families rather than the grammar's precedence levels,
because what matters here is which operands an operator accepts, not how tightly
it binds.
]]

local operators = {}

--- A set of operator tokens.
local type Set = {[string]: boolean}

--- FFI operations whose first argument names a type.
operators.ffiTypeFirst = {
    ["new"] = true,
    ["cast"] = true,
    ["istype"] = true,
    ["typeof"] = true,
    ["sizeof"] = true,
    ["alignof"] = true,
} as Set

--- Arithmetic, which takes numbers or a metamethod contract.
operators.arith = {
    ["+"] = true,
    ["-"] = true,
    ["*"] = true,
    ["/"] = true,
    ["%"] = true,
    ["^"] = true,
    ["//"] = true,
} as Set

--- Bitwise, which takes integers and gives one back.
operators.bitops = {["&"] = true, ["|"] = true, ["~"] = true, ["<<"] = true, [">>"] = true, ["~>>"] = true,} as Set

--- Comparison, which gives a boolean whatever it takes.
operators.compare = {["<"] = true, [">"] = true, ["<="] = true, [">="] = true, ["=="] = true, ["~="] = true,} as Set

--- The short-circuiting pair, whose right side is only reached under what the left side
--- proved.
operators.logical = {["and"] = true, ["or"] = true,} as Set

--- The metamethod an operator consults when its operands are not primitive.
operators.metamethod = {
    ["+"] = "__add",
    ["-"] = "__sub",
    ["*"] = "__mul",
    ["/"] = "__div",
    ["%"] = "__mod",
    ["^"] = "__pow",
    [".."] = "__concat",
} as {[string]: string}

--- The metamethods a declaration may contract for.
operators.contractMetamethod = {
    __call = true,
    __index = true,
    __newindex = true,
    __add = true,
    __sub = true,
    __mul = true,
    __div = true,
    __mod = true,
    __pow = true,
    __unm = true,
    __concat = true,
    __len = true,
    __eq = true,
    __lt = true,
    __le = true,
    __tostring = true,
} as Set

--- Every key the Lua dialect gives meaning to in a metatable, so a misspelling in a
--- literal one is caught rather than silently ignored.
operators.runtimeMetamethod = {
    __call = true,
    __index = true,
    __newindex = true,
    __mode = true,
    __metatable = true,
    __tostring = true,
    __len = true,
    __add = true,
    __sub = true,
    __mul = true,
    __div = true,
    __mod = true,
    __pow = true,
    __unm = true,
    __concat = true,
    __eq = true,
    __lt = true,
    __le = true,
    __gc = true,
    __pairs = true,
    __ipairs = true,
} as Set

local T = require("nupp.compiler.types")
local relations = require("nupp.compiler.types.relations")
local narrowing = require("nupp.compiler.types.narrowing")
local cst = require("nupp.compiler.syntax.cst")
local lexer = require("nupp.compiler.syntax.lexer")
local state = require("nupp.compiler.check.state")
local fixedWidth = require("nupp.compiler.types.fixedwidth")
local indexedViews = require("nupp.compiler.types.indexedviews")
local capabilities = require("nupp.compiler.capabilities")

local isA = relations.isA
local subtract = narrowing.subtract

--- A type, as nupp.compiler.types builds them.
local type Type = T.Type

--- A node of the tree being checked.
local type Node = cst.Node

--- A token, as the lexer produced it.
local type Token = lexer.Token

--- Whether ordinary arithmetic over this operand keeps a whole number whole.
---
--- Ordinary arithmetic is binary64, so no operand keeps its fixed-width
--- refinement through it -- but whether the result is still an integer is a
--- separate question, and `int32` and `uint32` answer it the way `integer` does.
--- That is not a new claim about either: `fixedwidth.widenedName` already says
--- both widen to `integer`, and that `float` widens to `number`.
---
--- It matters because a cursor is written `uint32` and then indexes with
--- `cursor + 1`. Calling that sum a `number` left a checked view append with no
--- spelling that both checked and compiled.
--- The intrinsic each fixed-width arithmetic operator lowers to.
local FIXED_ARITHMETIC: {[string]: string} = {["+"] = "add", ["-"] = "sub", ["*"] = "mul"}

local function integral(t: Type): boolean
    if fixedWidth.isValue(t) then
        return fixedWidth.widenedName(t) == "integer"
    end

    return t ~= T.any and isA(t, T.integer)
end

local function floating(t: Type): boolean
    t = T.unwrapOwnership(t)
    if t.tag == "literal" then
        return floating(t.base)
    elseif t.tag == "const" then
        return floating(t.inner)
    elseif t.tag == "union" then
        for _, member in ipairs(t.members) do
            if not floating(member) then
                return false
            end
        end
        return #t.members > 0
    end

    return t.tag == "float32" or t.tag == "float64"
end

--- Whether a checked type is one compiler-owned explicit SIMD family.
local function simdFamily(t: Type): string?
    if t.tag == "const" then
        t = t.inner
    end
    if t.tag ~= "nominal" then
        return nil
    end
    local origin = (t.origin or t) as T.Nominal
    if origin.moduleName ~= "nupp.simd" and origin.sealedModule ~= "nupp.simd" then
        return nil
    end
    local admitted = {Vector = true, Mask = true, Species = true,}

    return admitted[origin.name] == true and origin.name or nil
end

--- The scalar element named by a compiler-owned SIMD family application.
local function simdElement(t: Type): Type?
    if t.tag == "const" then
        t = t.inner
    end
    if simdFamily(t) == nil or t.tag ~= "nominal" then
        return nil
    end

    return (t.typeArgs or {})[1]
end

--- Whether a SIMD element has a closed fixed-width bit representation.
---
--- The storage-only widths count: a vector of `uint8` keeps its physical lane
--- width, so a byte table lookup or a nibble split is a bitwise operation on it
--- the same way it is on a `uint32` vector.
local function simdIntegerElement(t: Type): boolean
    local element = simdElement(t)
    if element == nil then
        return false
    end
    element = T.unwrapOwnership(element)

    return fixedWidth.isValue(element) and fixedWidth.widenedName(element) == "integer"
        or fixedWidth.isStorageOnly(element)
        or element.tag == "int64"
        or element.tag == "uint64"
end

--- Reports `customary-operator` when an operator was written in its C spelling. The two
--- forms mean exactly the same thing, so this is a house style question and nothing
--- more: a project that prefers `&&` turns the lint off, and a file that wants it once
--- writes `@allow("customary-operator")`.
local function customaryOperator(c: state.Checker, opTok: Token)
    -- The lexer folds both spellings into one token kind, so the text is all that is
    -- left to say which one the author chose.
    local classic = lexer.CUSTOMARY[opTok.text]
    if not classic then
        return
    end
    c.diag(
        "NUPP2504",
        opTok,
        ("%s is the customary spelling of %s"):format(opTok.text, classic),
        {c.edits.fix(("change to `%s`"):format(classic), c.edits.replaceWithWord(opTok, classic))},
        {help = ("write %s"):format(classic)}
    )
end

--- Installs the operator expressions on a run.
---
--- @param c the run's state
--- @return the expression kinds this family answers
function operators.install(c: state.Checker): state.ExprHandlers

    local function orderingFamily(t)
        if t == T.any then
            return "any"
        end
        if isA(t, T.number) or t.tag == "int64" or t.tag == "uint64" then
            -- LuaJIT orders a boxed 64-bit integer against a Lua number or the
            -- other box, converting to compare.
            return "number"
        end
        if isA(t, T.string) then
            return "string"
        end
        if t.tag == "union" then
            local family = nil
            for _, member in ipairs(t.members) do
                if member ~= T.nil_ then
                    local found = orderingFamily(member)
                    if not found or found == "any" then
                        return found
                    end
                    if family and family ~= found then
                        return nil
                    end
                    family = found
                end
            end
            return family
        end

        return nil
    end

    local handlers = {}

    --- The fixed width `+`, `-` and `*` answer, or nothing when they answer
    --- `integer` as before.
    ---
    --- One operand must be typed at the width and both must be established at
    --- it: an exact integer literal beside a `uint32` is a `uint32`, an erased
    --- `as uint32` beside one is not, and `1 + 1` is still an integer. A
    --- literal spelled as a number, `x * 1.0`, asks for a number and gets one.
    --- Mixed widths answer nothing rather than guess which one wins -- except
    --- in an `@aot` body, where a `uint32`-typed operand established at
    --- `int32` too (a byte read, which holds either) beside an `int32` takes
    --- the signed reading, so an `int32` carry accumulates bytes as the
    --- wrapping signed add would.
    local function fixedArithmeticTarget(lt: Type, rt: Type, lhs: any, rhs: any): Type?
        local left = T.unwrapOwnership(lt)
        local right = T.unwrapOwnership(rt)
        local leftTag = left.tag
        local rightTag = right.tag
        if leftTag == "int64" or leftTag == "uint64" or rightTag == "int64" or rightTag == "uint64" then
            return nil
        end
        local target = (leftTag == "uint32" or rightTag == "uint32") and T.uint32
            or (leftTag == "int32" or rightTag == "int32") and T.int32
            or nil
        if target == nil then
            return nil
        end
        for _, operand in ipairs({left, right}) do
            if operand.tag == "literal"
                and ((operand as T.Literal).base == T.number or (operand as T.Literal).base == T.float)
            then
                return nil
            end
        end
        local other = target == T.uint32 and "int32" or "uint32"
        if leftTag == other or rightTag == other then
            local body = c.functionBodies[#c.functionBodies]
            if body == nil or body.aotRequired ~= true then
                return nil
            end
            for _, width in ipairs({T.int32, T.uint32}) do
                if c.fixedWidth.established(lhs, width) and c.fixedWidth.established(rhs, width) then
                    return width
                end
            end

            return nil
        end
        if c.fixedWidth.established(lhs, target as Type) and c.fixedWidth.established(rhs, target as Type) then
            return target
        end

        return nil
    end

    --- Whether a
    ---
    --- The same condition the retired structured lowering put on them, spelled here
    --- against the checker's establishment facts rather than against lowered IR.
    --- An exact literal in range carries both integer facts from `markLiteral`,
    --- so it satisfies this without a special case.
    local function fixedBitOperand(operand: any): boolean
        return c.fixedWidth.established(operand, T.int32) or c.fixedWidth.established(operand, T.uint32)
    end

    handlers.unop = function(node: cst.Unop): Type
        local operand = node.operand
        local opTok = node.op
        if not operand or not opTok then
            return T.any
        end
        customaryOperator(c, opTok)
        local t = c.infer(operand)
        if t.tag == "const" then
            t = t.inner
        end
        local op = opTok.kind
        if op == "-" then
            local mm = c.metamethodOf(t, "__unm")
            if mm then
                local family = simdFamily(t)
                if family == "Vector" or family == "Mask" then
                    (node as any).simdIntrinsic = op
                end
                return c.applyContract(mm, {t}, {operand}, node, "__unm")
            end
            if c.dynamicOperand(t) then
                return T.any
            end
            c.numericOperand(t, node, op)
            if t.tag == "int64" or t.tag == "uint64" then
                capabilities.require(c, "int64", opTok)
                node.wideArithmetic = true
                return t
            end
            if t.tag == "literal" and type(t.constant) == "number" then
                local value = -(t.constant as number)
                c.fixedWidth.markLiteral(node, value)
                return T.literal(value, t.base)
            end
            return (t == T.any or fixedWidth.isValue(t)) and T.number or t
        elseif op == "~" then
            local family = simdFamily(t)
            if family == "Vector" or family == "Mask" then
                if family == "Vector" and not simdIntegerElement(t) then
                    c.diag("NUPP2003", node, "bitwise SIMD operators require an integer vector element")
                end
                (node as any).simdIntrinsic = op
                return t
            end
            local wide = t.tag == "int64" or t.tag == "uint64"
            capabilities.require(c, wide and "int64" or "bitops", opTok)
            if wide then
                node.wideArithmetic = true
            end
            c.numericOperand(t, node, op)
            if not wide and fixedBitOperand(operand) then
                local target = t.tag == "uint32" and T.uint32 or T.int32
                if target == T.uint32 then
                    node.fixedArithmetic = "u32.notBits"
                end
                c.fixedWidth.mark(node, target)

                return target
            end

            return wide and t or T.integer
        elseif op == "#" then
            local view = indexedViews.describe(t)
            if view then
                local receiverDefinition = operand.kind == "name" and operand.token and operand.token.definition or nil
                node.indexedLength = {
                    adapter = view.adapter,
                    descriptor = view,
                    receiverDefinition = receiverDefinition,
                }
                return view.fixedCount or T.integer
            end
            local mm = c.metamethodOf(t, "__len")
            if mm then
                return c.applyContract(mm, {t}, {operand}, node, "__len")
            end
            if not (t == T.any or isA(t, T.string) or isA(t, T.table_)) then
                c.diag("NUPP2003", node, ("cannot apply '#' to %s"):format(T.tostring(t)))
            end
            return T.integer
        else -- not
            return T.boolean
        end
    end

    --- Every value selectable from a logical expression must carry its own
    --- width proof. A false intermediate in `flag and u32 or 0` never reaches
    --- the result, whereas an erased cast on either selected arm still does.
    local function selectedWidth(node: any, target: Type, truthyOnly: boolean?): boolean
        if node.kind == "paren" then
            return selectedWidth(node.expr, target, truthyOnly)
        end
        local inferred = node.inferredType
        if inferred == nil then
            return false
        end
        local truthy, falsy = narrowing.truthiness(inferred)
        if truthyOnly == true and (truthy == nil or truthy == T.never)
            or truthyOnly == false and (falsy == nil or falsy == T.never)
        then
            return true
        end
        if node.kind == "binop" and node.op and (node.op.kind == "and" or node.op.kind == "or") then
            local leftTruthy, leftFalsy = narrowing.truthiness(node.lhs.inferredType)
            local isAnd = node.op.kind == "and"
            local selectedLeft, reachesRight = leftTruthy, leftFalsy
            if isAnd then
                selectedLeft, reachesRight = leftFalsy, leftTruthy
            end
            local leftNeeded = selectedLeft ~= nil
                and selectedLeft ~= T.never
                and (truthyOnly == nil or truthyOnly ~= isAnd)
            return (not leftNeeded or selectedWidth(node.lhs, target, not isAnd))
                and (reachesRight == nil or reachesRight == T.never or selectedWidth(node.rhs, target, truthyOnly))
        end

        return c.fixedWidth.established(node, target)
    end

    handlers.binop = function(node: cst.Binop): Type
        local opTok, lhs, rhs = node.op, node.lhs, node.rhs
        if not opTok or not lhs or not rhs then
            return T.any
        end
        customaryOperator(c, opTok)
        local op = opTok.kind
        local lt, rt
        if operators.logical[op] then
            -- the rhs is only evaluated under the lhs outcome: narrow it
            lt = c.infer(lhs)
            local facts = c.analyzeCond(lhs)
            c.pushScope()
            c.applyFacts(op == "and" and facts.t or facts.f)
            rt = c.infer(rhs)
            c.popScope()
        else
            lt, rt = c.infer(lhs), c.infer(rhs)
        end
        if (operators.logical[op] or op == "??") and (c.ownershipKind(lt) or c.ownershipKind(rt)) then
            c.diag("NUPP2602", node, "an ownership-bearing value cannot be selected by a logical operator", nil, {
                help = "move or drop the owner explicitly in each control-flow branch"
            })
        end
        if operators.arith[op] then
            local mmName = op ~= "//" and operators.metamethod[op] or nil
            if op == "//" and simdFamily(lt) == "Vector" then
                -- A vector has no `__idiv` to find: floor division takes the
                -- operands `/` takes and answers the same vector.
                mmName = "__div"
            end
            local mm = mmName and (c.metamethodOf(lt, mmName) or c.metamethodOf(rt, mmName)) or nil
            if mm then
                -- A contract was only looked for under a name, so finding one is what
                -- proves there was one.
                if simdFamily(lt) == "Vector" then
                    -- The generator routes a lane operator through the one-lane
                    -- runtime where the body runs as Lua.
                    (node as any).simdIntrinsic = op
                end
                return c.applyContract(mm, {lt, rt}, {lhs, rhs}, node, mmName as string)
            end
            local leftPayload = T.unwrapOwnership(lt)
            if (op == "+" or op == "-") and leftPayload.tag == "ptr" and isA(rt, T.integer) then
                if c.ownershipKind(lt) ~= "borrowed" then
                    c.diag("NUPP2604", node, "pointer arithmetic requires a rooted borrowed pointer")
                    return leftPayload
                end
                local roots = c.own.provenanceOwners(lhs)
                if #roots > 0 then
                    c.own.capabilityFacts(node).roots = roots
                end
                if c.unsafeDepth == 0 then
                    c.diag(
                        "NUPP2604",
                        node,
                        "unchecked pointer arithmetic requires @unsafe (pointer + offset); use a span for bounds"
                    )
                    return T.borrowed(leftPayload)
                end
                -- Unsafe made the bounds assertion; borrowFrom can immediately attach
                -- the resulting raw address to the span/root chosen by the caller.
                node.unsafeOwnershipOperation = "unchecked pointer arithmetic"
                return leftPayload
            end
            if c.dynamicOperand(lt) or c.dynamicOperand(rt) then
                return T.any
            end
            c.numericOperand(lt, lhs, op)
            c.numericOperand(rt, rhs, op)
            if lt == T.any or rt == T.any then
                -- Arithmetic over a gradual operand may dispatch a metamethod whose
                -- result is not numeric. Keep the useful numeric approximation, but
                -- do not later treat it as proof that a colon receiver is primitive.
                (node as any).primitiveUntrusted = true
            end
            if op == "/" or op == "^" then
                return T.float
            end
            local fixedTarget = fixedArithmeticTarget(lt, rt, lhs, rhs)
            local fixedOperation = FIXED_ARITHMETIC[op]
            if fixedTarget ~= nil and fixedOperation ~= nil then
                -- Both operands are established at one thirty-two bit width and
                -- one of them is typed with it, so the result is that width
                -- wrapped: the `u32.add` identity and its siblings, which the
                -- backends lower as one operation. `+ - *` only; division leaves the
                -- width, and a literal beside a literal stays an integer.
                c.fixedWidth.mark(node, fixedTarget as Type)
                local family = (fixedTarget as Type).tag == "uint32" and "u32." or "i32."
                node.fixedArithmetic = family .. (fixedOperation as string)

                return fixedTarget as Type
            end
            local leftInteger = integral(lt) or lt.tag == "uint64"
            local rightInteger = integral(rt) or rt.tag == "uint64"
            if leftInteger and rightInteger then
                local result = (lt.tag == "uint64" or rt.tag == "uint64") and T.uint64 or T.integer
                capabilities.require(c, "int64", opTok)
                node.wideArithmetic = true
                return result
            end
            if floating(lt) or floating(rt) then
                return T.float
            end
            return T.number

        elseif op == ".." then
            local mm = c.metamethodOf(lt, "__concat") or c.metamethodOf(rt, "__concat")
            if mm then
                return c.applyContract(mm, {lt, rt}, {lhs, rhs}, node, "__concat")
            end
            -- Whether this concatenation is the primitive one, which only this point
            -- knows: no `__concat` was found, and neither side is `any`. `any` is the
            -- interesting exclusion. Gradual typing lets it concatenate, and at runtime
            -- it may be a table carrying a `__concat` -- so a rewrite that assumes
            -- primitive string building (`OPT-5`) must refuse it, while the check above
            -- must allow it.
            if c.dynamicOperand(lt) or c.dynamicOperand(rt) then
                node.plainConcat = false
                return T.any
            end
            local plain = true
            for _, pair in ipairs({{lt, lhs}, {rt, rhs}}) do
                -- Each pair holds a type beside the expression it came from, which is
                -- one list of two kinds of thing rather than two lists.
                local t = pair[1] as Type
                if not (t == T.any or isA(t, T.number) or T.unwrapOwnership(t).tag == "uint64" or isA(t, T.string)) then
                    c.diag("NUPP2003", pair[2] as Node, ("cannot concatenate %s"):format(T.tostring(t)))
                    plain = false
                elseif t == T.any then
                    plain = false
                end
            end
            node.plainConcat = plain
            return T.string
        elseif operators.bitops[op] then
            local leftFamily, rightFamily = simdFamily(lt), simdFamily(rt)
            if leftFamily == "Vector" or leftFamily == "Mask" then
                if leftFamily == "Vector" and rightFamily == nil then
                    -- A scalar beside a vector splats, as it does for `+`: `bytes & 15`
                    -- and `bytes >> 4` are the nibble split, not a type error.
                    if not (isA(rt, T.number) or rt.tag == "int64" or rt.tag == "uint64") then
                        c.diag("NUPP2003", node, "explicit SIMD bitwise operands need a vector or a numeric scalar")
                    end
                elseif leftFamily ~= rightFamily or not isA(lt, rt) or not isA(rt, lt) then
                    c.diag("NUPP2003", node, "explicit SIMD bitwise operands need the same vector or mask type")
                end
                if leftFamily == "Vector" and not simdIntegerElement(lt) then
                    c.diag("NUPP2003", node, "bitwise SIMD operators require an integer vector element")
                end
                (node as any).simdIntrinsic = op
                return lt
            elseif rightFamily ~= nil then
                c.diag("NUPP2003", node, "explicit SIMD bitwise operands need the vector or mask on the left")
                return T.any
            end
            local wide = lt.tag == "int64" and lt
                or lt.tag == "uint64" and lt
                or rt.tag == "int64" and rt
                or rt.tag == "uint64" and rt
                or nil
            capabilities.require(c, wide and "int64" or "bitops", opTok)
            if wide then
                node.wideArithmetic = true
            end
            c.numericOperand(lt, lhs, op)
            c.numericOperand(rt, rhs, op)
            if not wide and fixedBitOperand(lhs) and fixedBitOperand(rhs) then
                local target = fixedArithmeticTarget(lt, rt, lhs, rhs)
                local intrinsic = ({
                    ['&'] = "andBits",
                    ['|'] = "orBits",
                    ['~'] = "xorBits",
                    ['<<'] = "shiftLeft",
                    ['>>'] = "shiftRightLogical",
                })[op]
                if target == T.uint32 and intrinsic ~= nil then
                    node.fixedArithmetic = "u32." .. intrinsic
                    c.fixedWidth.mark(node, T.uint32)
                    return T.uint32
                end
                c.fixedWidth.mark(node, T.int32)
                return T.int32
            end

            return wide or T.integer
        elseif operators.compare[op] then
            local leftFamily, rightFamily = simdFamily(lt), simdFamily(rt)
            if leftFamily == "Mask" or rightFamily == "Mask" then
                if (op ~= "==" and op ~= "~=") or leftFamily ~= "Mask" or rightFamily ~= "Mask" then
                    c.diag("NUPP2003", node, "explicit SIMD masks support equality with a compatible mask")
                    return T.any
                end
                local mm = c.metamethodOf(lt, "__eq")
                if mm == nil then
                    c.diag("NUPP2003", node, "explicit SIMD mask comparison needs compatible operands")
                    return T.any
                end
                (node as any).simdIntrinsic = op
                return c.applyContract(mm, {lt, rt}, {lhs, rhs}, node, "__eq")
            end
            if leftFamily == "Vector" or rightFamily == "Vector" then
                local mmName = (op == "==" or op == "~=") and "__eq" or (op == "<" or op == ">") and "__lt" or "__le"
                if leftFamily ~= "Vector" then
                    c.diag("NUPP2003", node, "an explicit SIMD comparison needs the vector on the left")
                    return T.any
                end
                local mm = c.metamethodOf(lt, mmName)
                if mm == nil then
                    c.diag("NUPP2003", node, "explicit SIMD comparison needs compatible vector operands")
                    return T.any
                end
                (node as any).simdIntrinsic = op
                return c.applyContract(mm, {lt, rt}, {lhs, rhs}, node, mmName)
            end
            if lt.tag == "int64" or lt.tag == "uint64" or rt.tag == "int64" or rt.tag == "uint64" then
                capabilities.require(c, "int64", opTok)
            end
            if op ~= "==" and op ~= "~=" then
                local mmName = (op == "<" or op == ">") and "__lt" or "__le"
                local left, right = lt, rt
                local leftNode, rightNode = lhs, rhs
                if op == ">" or op == ">=" then
                    left, right, leftNode, rightNode = rt, lt, rhs, lhs
                end
                local mm = c.metamethodOf(left, mmName) or c.metamethodOf(right, mmName)
                if not mm and (op == "<=" or op == ">=") then
                    mmName = "__lt"
                    left, right, leftNode, rightNode = right, left, rightNode, leftNode
                    mm = c.metamethodOf(left, mmName) or c.metamethodOf(right, mmName)
                end
                if mm then
                    c.applyContract(mm, {left, right}, {leftNode, rightNode}, node, mmName)
                else
                    local lf, rf = orderingFamily(lt), orderingFamily(rt)
                    if not (
                        lf == "any" or rf == "any" or (lf and lf == rf) or c.dynamicOperand(lt) or c.dynamicOperand(rt)
                    ) then
                        c.diag(
                            "NUPP2003",
                            node,
                            ("cannot compare %s and %s with '%s'"):format(T.tostring(lt), T.tostring(rt), op)
                        )
                    end
                end
            end
            return T.boolean
        elseif op == "??" then
            -- yields the left unless it is nil, so nil drops out of it; a left that
            -- is only nil contributes nothing but the right
            local present = subtract(lt, T.nil_)
            if present == T.nil_ then
                present = T.never
            end
            return T.union({present, rt})
        elseif operators.logical[op] then
            -- These operators select an operand value rather than producing a
            -- boolean. The left contributes its falsy possibilities to `and` and
            -- its truthy possibilities to `or`; the right is reachable on the
            -- opposite side. Keep `never` out of the union because it describes an
            -- unreachable side rather than a value the expression can produce.
            local truthy, falsy = narrowing.truthiness(lt)
            if lt == T.any then
                return T.any
            end
            local parts: {Type} = {}
            if op == "and" then
                if truthy and truthy ~= T.never then
                    parts[#parts + 1] = rt
                end
                if falsy and falsy ~= T.never then
                    parts[#parts + 1] = falsy
                end
            else -- or
                if truthy and truthy ~= T.never then
                    parts[#parts + 1] = truthy
                end
                if falsy and falsy ~= T.never then
                    parts[#parts + 1] = rt
                end
            end
            local result = #parts == 0 and T.never or T.union(parts)
            local members = result.tag == "union" and (result as T.Union).members or {result}
            local facts: {[string]: boolean} = {}
            local established: Type? = nil
            -- The current node has not been memoized by infer yet.
            (node as any).inferredType = result
            for _, target in ipairs({T.uint32, T.int32, T.float32}) do
                local hasWidth = false
                for _, member in ipairs(members) do
                    hasWidth = hasWidth or member.tag == target.tag
                end
                if isA(result, target) and selectedWidth(node, target, nil) then
                    facts[target.tag] = true
                    if hasWidth then
                        established = target
                    end
                end
            end
            (node as any).fixedWidthEstablished = next(facts) ~= nil and facts or nil
            return established or result
        end

        return T.any
    end

    return handlers
end

export = operators
