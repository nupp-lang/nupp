--[[
Whether a `local` this file introduces is read anywhere.

A binding nothing reads is either a leftover from an edit or a use that went to
the wrong name, and both are cheaper to see than to find. The other half of
`missing-require` lives here too: that lint says a module name is used without
being required, and this one says a require binds a name nothing wants.

Every name resolution goes through `lookupEntry`, so a read is recorded there
and nowhere else — the same chokepoint the capture watches ride on. That makes
a write count as a read, since an assignment resolves its target through the
same path. Reporting `x = 1` on a binding nobody reads afterwards is a
different question, asked flow-sensitively, and answering it wrongly here would
cost more than it found.

Judging has to wait for the whole file, because a use may be written below the
declaration, so a declaration only registers a candidate and the sweep runs at
the end. An `@allow` is a property of the statement it decorates and the stack
that carries it is gone by then, so whether one covered the declaration is
settled where the declaration is, and remembered.

Three kinds of binding are left alone, each for its own reason. A parameter's
presence is dictated by the signature it implements rather than by its body,
and a loop variable's by the iterator, so neither is a mistake its author is
free to correct. A name beginning with `_` says the binding is deliberate and
the value is not wanted. See `docs/lints.md`.
]]

local state = require("nupp.compiler.check.state")

local unused = {}

--- What the walk calls into this judgement with: one call as each binding is made, and
--- one at the end of the file when every use that could excuse them has been seen.
type unused.Ops = {
    --- Registers a binding to judge once the file is read.
    declared: function(tok: any, entry: any, kind: string),

    --- Reports every registered binding that nothing read.
    sweep: function()
}

--- Installs the unused-binding judgement on one run.
---
--- @param c the run's state
--- @return the operations the walk calls
function unused.install(c: state.Checker): unused.Ops
    local ops = {}

    -- Definitions something has read. Keyed by the definition rather than the entry,
    -- because a binding is re-entered whenever its type is refined — `local function`
    -- binds twice, once to be visible to its own body and once with the type that body
    -- turned out to have — and the definition is what survives that.
    c.reads = {}

    -- Declarations to judge once the file is read, in source order.
    local candidates = {}

    --- Registers a binding to judge at the end of the file. Call with the entry
    --- `bindVar` just created, so the ownership state is the one it was bound with.
    ---
    --- @param tok the name token, which is where the report lands
    --- @param entry the scope entry it bound
    --- @param kind "variable", "require" or "function", which the help text turns on
    function ops.declared(tok: any, entry: any, kind: string)
        if not tok or not entry or not entry.definition then
            return
        end
        -- A declaration file states what exists elsewhere, so nothing in it is expected
        -- to have a reader here.
        if c.declarationFile then
            return
        end
        -- `_` is how Lua already says a binding is deliberately not wanted, and a name
        -- that starts with it is saying the same thing at greater length.
        if tok.text:sub(1, 1) == "_" then
            return
        end
        -- An owned or pinned value that goes unread is already reported, and by the
        -- rule that has something to say about it: it left its scope without being
        -- consumed. Saying it twice would not add the second fact.
        if c.ownershipKind(entry.t) then
            return
        end
        candidates[
            #candidates + 1
        ] = {tok = tok, definition = entry.definition, kind = kind, module = entry.requiredModule,
            -- Settled here because the statement's `@allow` is in scope here and gone
            -- by the time the sweep runs.
            allowed = c.suppressed("unused-binding"),}
    end

    --- Reports every registered binding that nothing read. Runs once, after the last
    --- statement of the file, since a use may be written below its declaration.
    function ops.sweep()
        for _, candidate in ipairs(candidates) do
            if not candidate.allowed and not c.reads[candidate.definition] then
                local name = candidate.tok.text
                local message, help
                if candidate.kind == "require" and candidate.module then
                    message = ("nothing uses %s, so requiring %q does nothing here"):format(name, candidate.module)
                    help = "delete the require"
                elseif candidate.kind == "function" then
                    message = ("nothing uses %s"):format(name)
                    help = "delete it, or return it from the module"
                else
                    message = ("nothing uses %s"):format(name)
                    help = "delete the binding, or name it _ if it is " .. "deliberately unused"
                end
                c.diag("unused-binding", candidate.tok, message, nil, {help = help})
            end
        end
    end

    return ops
end

return unused
