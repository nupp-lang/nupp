module nupp.compiler.check.undocumentedraise

--[[
Whether a function that raises on purpose said so.

Raising is part of how a function is called. A caller who does not know has no
reason to be ready for it, and Lua has no signature to find it out from, so the
`---` run is the only place it can be said. `@raises` is where it is said, and
this asks a documented function that calls `error` to write one.

Three rules decide what is judged, and each of them is a choice:

Only a documented function. One with no `---` run has promised nothing, and a
lint that asked every function in a gradually typed language for a docblock
would be a different lint under a different name.

`error` counts and `assert` does not. There is no reason to write `error` except
to raise. Lua writes `assert` both for a caller who passed the wrong thing and
for an invariant its author believes cannot fail, and the call does not say
which; reading the second as a documented raise would ask for a promise about
something that never happens. Measured on this compiler, that spelling was a
caller's business one time in three, and a lint wrong that often is one a
project learns to silence.

A nested function's raises are its own, so the walk stops where a new body
begins. That is also what excuses a function handing a raising body to `pcall`.

It does not propagate through calls. Documenting what a callee raises is a claim
this checker cannot verify, and enforcing an unverified claim at every
intermediate frame is the trade that made `throws Exception` ubiquitous. A
caller gets the same fact by retrieval instead: `nupp lsp inspect` on the call
returns the callee's `@raises`. See `docs/reference/lints.md`.

What a raise names is checked, separately and always. `@raises Type condition`
writes a type first, and `NUPP1010` reports one that names nothing here. That is
not the propagation above: it asks what a line already claims to mean, the way
`NUPP1007` asks whether an `@param` names a real parameter, rather than deriving
a claim the function never made. A type is resolved once the file is read
through, because a raise may name a declaration written below the function that
raises it.
]]

local cst = require("nupp.compiler.syntax.cst")
local docblock = require("nupp.compiler.syntax.docblock")
local state = require("nupp.compiler.check.state")

local undocumentedraise = {}

--- What the walk calls into this judgement with: one call per named function body, at
--- the three places one is declared with a `---` run to read.
type undocumentedraise.Ops = {
    --- Reports an @param name that the documented callable does not declare, and
    --- takes down this declaration's `@raises` types for `sweep` to resolve.
    checkParams: function(stat: any, params: {any}),

    --- Reports when a documented function raises and its documentation does not say so.
    check: function(stat: any, body: any),

    --- Resolves every `@raises` type taken down during the walk, once the whole file
    --- has been read and every declaration it could name exists.
    sweep: function()
}

-- Where this body raises on its own account, or nil if it does not. `error` is
-- recognized by name, the way `neverReturns` already recognizes it, so that untyped
-- code keeps the meaning it always had.
local function raisesAt(node: any): any
    if not node or cst.isToken(node) then
        return nil
    end
    local kind = node.kind
    if kind == "funcbody" or kind == "shortfn" then
        return nil
    end
    if kind == "call" then
        local callee = node.obj
        if callee and callee.kind == "name" and callee.token and callee.token.text == "error" then
            return callee.token
        end
    end
    for _, child in ipairs(node) do
        local at = raisesAt(child)
        if at then
            return at
        end
    end

    return nil
end

--- Installs the undocumented-raise judgement on one run.
---
--- @param c the run's state
--- @return the operations the walk calls
function undocumentedraise.install(c: state.Checker): undocumentedraise.Ops
    local ops = {}
    -- One entry per `@raises` line seen, with the scope it was written in. Resolving
    -- during the walk would ask about declarations the file has not reached yet, and a
    -- raise naming a record declared below the function that raises it is ordinary.
    local written: {any} = {}

    -- A synthetic token standing where the declaration's name does. The type comes out
    -- of a comment, which has no tokens of its own, so the position a diagnostic wants
    -- is the one `NUPP1007` already reports a bad `@param` at: the declaration, which
    -- is what carries the run. It borrows the anchor's trivia arena because that is
    -- what tells `cst` a token from a node, and claims none of it.
    local function tokenLike(anchor: any, kind: string, text: string): any
        return {
            kind = kind,
            text = text,
            offset = anchor.offset,
            line = anchor.line,
            col = anchor.col,
            trivia = anchor.trivia,
            triviaFirst = anchor.triviaFirst,
            triviaCount = 0,
        }
    end

    -- The written type as the node the resolver reads, so a raise resolves through the
    -- one path that knows about lexical names, nested declarations, binder
    -- projections and other modules' exports, rather than through a second reading of
    -- the same question. `a.b.C` is built the way the parser builds it, dots included,
    -- because that is how the resolver tells a qualified name from a plain one.
    local function typeNode(spelling: string, anchor: any): any?
        local names: {string} = {}
        -- Split on the dots rather than skipping them, so `a..b` and a trailing dot are
        -- an empty segment here rather than a name silently shorter than what was
        -- written. A raise resolving to something its author did not spell is worse
        -- than one reported.
        for part in (spelling .. "."):gmatch("([^%.]*)%.") do
            if not cst.identifier(part) and part ~= "nil" then
                return nil
            end
            names[#names + 1] = part
        end
        if #names == 0 then
            return nil
        end
        local node = new cst.Tname(kind = "tname")
        node.base = cst.add(node, tokenLike(anchor, names[1] == "nil" and "nil" or "name", names[1]))
        for index = 2, #names do
            cst.add(node, tokenLike(anchor, ".", "."))
            cst.add(node, tokenLike(anchor, "name", names[index]))
        end

        return node
    end

    -- Takes down what one declaration's run said it raises. `stat` is kept rather than
    -- its position, so the diagnostic lands on the name the way every other diagnostic
    -- about this declaration does.
    local function record(stat: any, info: docblock.Doc)
        for _, raise in ipairs(info.raises) do
            written[#written + 1] = {stat = stat, raise = raise, scope = c.scope}
        end
    end

    function ops.checkParams(stat: any, params: {any})
        local info, documented = docblock.of(stat)
        if not documented then
            return
        end
        record(stat, info)
        local parameters = {}
        for _, param in ipairs(params or {}) do
            local name = param.name and param.name.text or nil
            -- A vararg written with a mode, `borrows ...: any`, keeps the mode token
            -- ahead of the dots, so the dots are found rather than assumed first.
            if not name then
                for _, child in ipairs(param) do
                    if (child as any).kind == "..." then
                        name = "..."
                    end
                end
            end
            -- `self` is also a type name, so a receiver in a function type is parsed
            -- as an unnamed parameter whose type is the contextual `self` binder.
            if not name
                and param.type
                and param.type.kind == "tname"
                and (param.type as any).base
                and (param.type as any).base.text == "self"
            then
                name = "self"
            end
            if name then
                parameters[name] = true
            end
        end
        for name in pairs(info.params) do
            if not parameters[name] then
                local label = stat.name and (stat.name.text or cst.textOf(stat.name):gsub("%s+", ""))
                    or "this declaration"
                c.diag(
                    "NUPP1007",
                    stat.name and cst.lastToken(stat.name) or stat,
                    ("@param %s names no parameter of %s"):format(name, label),
                    nil,
                    {help = "remove the @param line or spell a declared parameter's name"}
                )
            end
        end
    end

    --- Checks the docblock against the function it describes, then reports
    --- `undocumented-raise` when a documented function raises and its run does not say
    --- so. The three places that call it are the three places a function body is
    --- declared with a name to document.
    ---
    --- @param stat the declaration, which is what carries the `---` run
    --- @param body its funcbody
    function ops.check(stat: any, body: any)
        if not stat or not body then
            return
        end
        ops.checkParams(stat, body.params or {})
        local info, documented = docblock.of(stat)
        local raiseTok = raisesAt(body.body)
        if not raiseTok or not documented or #info.raises > 0 then
            return
        end
        local label = stat.name and (cst.textOf(stat.name):gsub("%s+", "")) or "this function"
        -- The name it answers to, not the table it hangs off: `function query.Q:get` is
        -- reported at `get`, the way every other diagnostic about a member is.
        local at = stat.name and cst.lastToken(stat.name) or stat
        c.diag("NUPP2506", at, ("%s raises, but its documentation does not say when"):format(label), nil, {
            help = "add an @raises line saying what makes it raise",
            related = {c.related(raiseTok, "raises here")}
        })
    end

    --- Resolves every `@raises` type the walk took down, reporting the ones that name
    --- nothing. Run once, after the file is read through, from the scope each line was
    --- written in.
    function ops.sweep()
        local restore = c.scope
        for _, entry in ipairs(written) do
            local stat, raise = entry.stat, entry.raise
            local at = stat.name and cst.lastToken(stat.name) or stat
            local label = stat.name and (cst.textOf(stat.name):gsub("%s+", "")) or "this declaration"
            local spelling = raise.type
            local node = spelling ~= "" and typeNode(spelling, at) or nil
            local resolved = nil
            if node then
                c.scope = entry.scope
                -- The resolver says what it could not find in the vocabulary of a
                -- written annotation, which is not where this reader is looking. Its
                -- diagnostics are dropped and the one below is reported in their place,
                -- so a raise that names nothing reads as a raise that names nothing.
                local before = #c.diags
                resolved = c.resolveType(node)
                for index = #c.diags, before + 1, -1 do
                    c.diags[index] = nil
                end
                c.scope = restore
                -- `any` is what recovery returns, so it is the answer both to a name
                -- that resolved to `any` and to one that resolved to nothing. Spelling
                -- it is the only thing that tells them apart, and a raise documented as
                -- `any` has said what it means.
                if resolved and resolved.tag == "any" and spelling ~= "any" then
                    resolved = nil
                end
            end
            if not resolved then
                local msg = spelling == "" and ("@raises on %s names no type"):format(label)
                    or ("@raises %s on %s names no type here"):format(spelling, label)
                c.diag("NUPP1010", at, msg, nil, {
                    help = "write `@raises Type the condition`, naming the type `error` is called with",
                })
            end
        end
        c.scope = restore
    end

    return ops
end

export = undocumentedraise
