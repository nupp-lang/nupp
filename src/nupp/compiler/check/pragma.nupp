module nupp.compiler.check.pragma

--[[
An annotation attached to a statement.

`@name(...)` before a declaration is a pragma: the statement it decorates is
checked as it would have been anyway, and the annotation is checked against the
definition that declares it. Some are the checker's own, where `@allow` silences a
lint for the statement beneath it and `@annotation` declares a new name, and the
rest are validated and recorded for whatever reads them later.

Nesting is allowed, so a statement may carry several, and the walk recurs
through the chain to reach the declaration underneath.
]]

local cst = require("nupp.compiler.cst")
local generics = require("nupp.compiler.generics")
local indexedViews = require("nupp.compiler.indexedviews")
local lints = require("nupp.compiler.lints")
local state = require("nupp.compiler.check.state")
local T = require("nupp.compiler.types")

local pragma = {}

--- A node of the tree being checked.
local type Node = cst.Node

--- Installs the pragma statement on one run.
---
--- @param c the run's state
--- @return the statement kinds this family answers
function pragma.install(c: state.Checker): state.StatHandlers
    local marks = c.marks
    local defineAnnotation = marks.defineAnnotation
    local validateAnnotation = marks.validateAnnotation
    local stringValue, nameText = marks.stringValue, marks.nameText

    local handlers = {}

    local function nominalValue(value: T.Type?): T.Nominal?
        if value ~= nil and (value.tag == "typeobject" or value.tag == "metatable") then
            value = value.of
        end
        if value ~= nil and value.tag == "genericAlias" then
            value = value.body
            if value.tag == "nominal" then
                value = value.origin or value
            end
        end

        return value ~= nil and value.tag == "nominal" and value as T.Nominal or nil
    end

    -- The source checker sees the same typed object surface the linking overlay
    -- will generate. The function body keeps its original signature on the CST,
    -- which is what AOT lowering consumes; only the value bound to its name becomes
    -- the kernel specification callers use.
    local function bindGpuSpec(target: any, body: any): nil
        local nameToken = target and target.name
        local functionType = body and body.signatureType
        if nameToken == nil or functionType == nil or functionType.tag ~= "func" then
            return
        end
        local gpuModule = c.env and c.env.resolveModule and c.env.resolveModule(c.env, "nupp.gpu") or nil
        local exports = c.env and c.env.resolveModuleExports and c.env.resolveModuleExports(c.env, "nupp.gpu") or nil
        local context = nominalValue(
            exports and exports.types.Context or (gpuModule and c.fieldType(gpuModule, "Context") or nil)
        )
        local buffer = nominalValue(
            exports and exports.types.Buffer or (gpuModule and c.fieldType(gpuModule, "Buffer") or nil)
        )
        if context == nil or buffer == nil or buffer.typeParams == nil or buffer.typeParams[1] == nil then
            c.diag("NUPP2903", nameToken, "the GPU runtime types could not be resolved")
            return
        end

        local suffix = nameToken.text .. "@" .. tostring(nameToken.offset or 0)
        local spec = T.nominal("GpuSpec<" .. suffix .. ">", "record")
        local kernel = T.nominal("GpuKernel<" .. suffix .. ">", "record")
        local binding = T.nominal("GpuBinding<" .. suffix .. ">", "record")
        local bindParams: {T.Type} = {kernel}
        local bindModes: {string} = {"borrows"}
        local bindNames: {string} = {"self"}
        local uniformParams: {T.Type} = {binding}
        local uniformModes: {string} = {"borrows"}
        local uniformNames: {string} = {"self"}
        for position, paramType in ipairs(functionType.params) do
            local element = indexedViews.spanElement(paramType)
            if element ~= nil then
                local map: {[any]: any} = {[buffer.typeParams[1]] = element}
                bindParams[#bindParams + 1] = generics.instantiate(buffer, map)
                bindModes[#bindModes + 1] = "borrows"
                bindNames[#bindNames + 1] = functionType.paramNames[position] or ""
            else
                uniformParams[#uniformParams + 1] = paramType
                uniformModes[#uniformModes + 1] = "plain"
                uniformNames[#uniformNames + 1] = functionType.paramNames[position] or ""
            end
        end
        spec.byname.compile = T.func(
            {spec, context},
            {T.borrowed(kernel)},
            false,
            {"borrows", "borrows"},
            nil,
            nil,
            nil,
            2,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            {"self", "context"}
        )
        kernel.byname.bind = T.func(
            bindParams,
            {T.borrowed(binding)},
            false,
            bindModes,
            nil,
            nil,
            nil,
            nil,
            true,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            bindNames
        )
        binding.byname.dispatch = T.func(
            uniformParams,
            {},
            false,
            uniformModes,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            uniformNames
        )
        body.gpuSpecType = spec
        c.bindVar(nameToken.text, spec)
        if target.exported then
            c.moduleFields[nameToken.text] = spec
        end
    end

    local RELAXATIONS = {
        ["function-identity"] = true,
        ["load-order"] = true,
        ["error-site"] = true,
        frames = true,
        ["gc-timing"] = true,
        ["table-order"] = true,
        -- Unlike the others, this one changes answers rather than only what is
        -- observable about how they were reached. It permits a backend to fuse
        -- `a * b + c` into one rounding, which is faster and gives a different
        -- result, so it is opt-in per function and never inferred.
        ["fp-contract"] = true,
        -- Allows platform math implementations for explicit fixed-width
        -- transcendentals instead of the IR-owned operation sequence.
        ["fp-transcendentals"] = true,
    }

    local function effectContract(application)
        local listMembers = {
            reads = true,
            writes = true,
            shapes = true,
            metatables = true,
            escapes = true,
            calls = true,
            returns = true,
        }
        local boolMembers = {allocates = true, yields = true, raises = true, external = true,}
        local contract = {
            reads = {},
            writes = {},
            shapes = {},
            metatables = {},
            escapes = {},
            calls = {},
            returns = {},
            allocates = false,
            yields = false,
            raises = false,
            external = false,
        }
        local seen = {}
        for _, arg in ipairs(application.annotationArgs or {}) do
            local name = arg.name and arg.name.text or nil
            if not name or seen[name] or not (listMembers[name] or boolMembers[name]) then
                c.diag("NUPP2112", arg, "@effects arguments must be unique named effect members")
            elseif listMembers[name] then
                seen[name] = true
                local expr = arg.expr
                if not expr or expr.kind ~= "tableExpr" then
                    c.diag("NUPP2112", arg, ("@effects.%s must be an array of strings"):format(name))
                else
                    for _, field in ipairs(expr.fields or {}) do
                        local value = field.kind == "fieldItem" and stringValue(field.value) or nil
                        if not value then
                            c.diag("NUPP2112", field, ("@effects.%s entries must be strings"):format(name))
                        else
                            contract[name][#contract[name] + 1] = value
                        end
                    end
                end
            else
                seen[name] = true
                local expr = arg.expr
                if not expr or (expr.kind ~= "trueExpr" and expr.kind ~= "falseExpr") then
                    c.diag("NUPP2112", arg, ("@effects.%s must be true or false"):format(name))
                else
                    contract[name] = expr.kind == "trueExpr"
                end
            end
        end

        return contract
    end

    handlers.pragmaStmt = function(stat: cst.PragmaStmt)
        local annotationName = stat.name
        if not annotationName then
            return
        end
        local written = annotationName.text
        local target = stat.stat
        while target and target.kind == "pragmaStmt" do
            target = target.stat
        end
        -- What the annotation decorates, and the body it carries when the decorated
        -- statement is a function: the contracts below attach to one or the other, and
        -- a stray annotation decorates nothing.
        local targetKind = target and target.kind or ""
        local targetBody: Node? = nil
        if target then
            if target.kind == "funcStmt"
                or target.kind == "localFuncStmt"
                or target.kind == "inlineMethod"
                or target.kind == "constructorDecl"
            then
                targetBody = target.body
            end
        end
        if written == "annotation" and target and targetKind == "recordDecl" then
            target.isAnnotationDefinition = true
        end
        local annotation, valid = validateAnnotation(stat, target)
        local targetAny = target as any

        -- Statement annotations wrap declarations, so put the tooling metadata on the
        -- token that will become the declaration's durable definition before the
        -- underlying statement is checked.
        if written == "deprecated" and valid and target and targetAny.deprecation then
            local function deprecate(tok)
                if tok then
                    tok.deprecation = targetAny.deprecation
                    local annotationToken = cst.firstToken(stat)
                    tok.deprecationToken = annotationToken or nil
                end
            end

            if target.kind == "localStmt" then
                for _, name in ipairs(target.names or {}) do
                    deprecate(name)
                end
            elseif target.kind == "funcStmt" and target.name then
                local _, member = c.funcOwner(target.name)
                deprecate(member or targetAny.name.base)
            else
                deprecate(targetAny.name)
            end
        end

        if written == "syntax" and valid and target and target.kind == "localStmt" then
            local values = (stat as any).annotationValues
            local value = values and values.value
            local format = value and stringValue(value.expr) or nil
            if format then
                -- This is source metadata only: any local value may carry it. The
                -- editor recognizes long-string initializers for the bundled formats.
                targetAny.embeddedStringFormat = format
            end
        end

        if not annotation then
            if stat.stat then
                c.checkStat(stat.stat)
            end
            return
        end
        if written == "annotation" then
            if stat.stat then
                c.checkStat(stat.stat)
            end
            if valid and target and targetKind == "recordDecl" then
                defineAnnotation(stat, target)
            end
            return

        elseif written == "jit" then
            if valid and targetBody then
                if targetBody.aotRequired then
                    c.diag("NUPP2901", annotationName, "@jit and @aot name different compilers for one body")
                end
                -- `@jit` asserts that a tracing contract exists. A target with
                -- no trace compiler cannot meet it, and rereading the promise
                -- as advice would let a program claim a property of its
                -- destination that the destination does not have.
                local profile = c.env and c.env.targetProfile or nil
                if profile ~= nil and not (profile as any).tracingJit then
                    c.diag(
                        "NUPP2904",
                        annotationName,
                        "@jit needs a tracing JIT, and " .. tostring((profile as any).target) .. " has none"
                    )
                end
                targetBody.jitRequired = true
            end
            if stat.stat then
                c.checkStat(stat.stat)
            end
            return

        elseif written == "aot" then
            -- `@aot` is a whole-function compilation contract, so it needs a visible
            -- body it alone owns. A constructor and an inline interface requirement
            -- both carry bodies the compiler generates around, and neither is a
            -- function value the AOT wrapper can stand in front of.
            if valid and (targetKind == "constructorDecl" or targetKind == "inlineMethod") then
                c.diag(
                    "NUPP2902",
                    annotationName,
                    (
                        "@aot cannot compile %s"
                    ):format(targetKind == "constructorDecl" and "a constructor" or "an inline interface requirement")
                )
            elseif valid and targetBody and c.functionDepth > 0 then
                -- Discovery walks the chunk's own statements, so an annotation
                -- inside another function's body was never found and the contract
                -- was silently not applied. A nested function is also a fresh
                -- value per call of its enclosing function, which is not something
                -- one wrapper can stand in front of.
                c.diag("NUPP2902", annotationName, "@aot cannot compile a function nested in another function")
            elseif valid and targetBody and targetKind ~= "localFuncStmt" then
                -- Lowering names and replaces one lexical binding. A qualified
                -- declaration assigns through a table path instead, so accepting it
                -- here would leave lowering with no entry name and no binding the
                -- generated wrapper can replace.
                c.diag("NUPP2902", annotationName, "@aot currently requires a local function declaration")
            elseif valid and targetBody then
                if targetBody.jitRequired then
                    c.diag("NUPP2901", annotationName, "@aot and @jit name different compilers for one body")
                end
                targetBody.aotRequired = true
                -- Absent, the compiler decides whether vectorizing is worth
                -- it. `vectorize = false` declines it for a body that measured
                -- worse lane-parallel; `vectorize = true` takes it whatever the
                -- estimate says. Neither says anything about whether the body
                -- compiles.
                local values = (stat as any).annotationValues
                local target = values and values.target
                local requested = target and stringValue(target.expr) or nil
                if requested ~= nil then
                    targetBody.aotTarget = requested
                end
                -- `lanes` is the withdrawn spelling, accepted so existing source
                -- keeps compiling and read only where `vectorize` is absent.
                local vectorize = values and (values.vectorize or values.lanes)
                if requested == "gpu" then
                    -- A GPU map assigns one source iteration to one invocation;
                    -- CPU register gangs are a separate lowering and do not run.
                    targetBody.vectorizeRequest = "decline"
                    if targetKind ~= "localFuncStmt" then
                        c.diag(
                            "NUPP2902",
                            annotationName,
                            "@aot(target = \"gpu\") currently requires a local function declaration"
                        )
                    end
                    if vectorize ~= nil then
                        c.diag("NUPP2115", vectorize, "@aot(target = \"gpu\") does not take a vectorize override")
                    end
                elseif vectorize and vectorize.expr and vectorize.expr.kind == "falseExpr" then
                    targetBody.vectorizeRequest = "decline"
                elseif vectorize and vectorize.expr and vectorize.expr.kind == "trueExpr" then
                    targetBody.vectorizeRequest = "prefer"
                end
            end
            if stat.stat then
                c.checkStat(stat.stat)
            end
            -- After the body is checked, so the subset walk reports against a tree the
            -- ordinary rules have already accepted. An `@aot` body that is not valid
            -- Nupp is not an AOT problem.
            if valid and targetBody and targetBody.aotRequired then
                c.aot.body(targetBody)
                local selected = c.env.config and c.env.config._target or nil
                if targetBody.aotTarget == "gpu"
                    and targetKind == "localFuncStmt"
                    and selected ~= nil
                    and selected.aot == "require"
                then
                    bindGpuSpec(target, targetBody)
                end
            end
            return

        elseif written == "derive" then
            if valid and target and target.kind == "recordDecl" then
                target.deriveApplications = target.deriveApplications or {}
                local seen = false
                for _, prior in ipairs(target.deriveApplications) do
                    if prior == stat then
                        seen = true
                        break
                    end
                end
                if not seen then
                    target.deriveApplications[#target.deriveApplications + 1] = stat
                end
            end
            if stat.stat then
                c.checkStat(stat.stat)
            end
            return

        elseif written == "effects" then
            if valid and target then
                local contract = effectContract(stat)
                target.effectContract = contract
                if targetBody then
                    targetBody.effectContract = contract
                end
            end
            if stat.stat then
                c.checkStat(stat.stat)
            end
            if valid and target and target.kind == "localStmt" and target.effectContract then
                for _, name in ipairs(target.names or {}) do
                    if name.definition then
                        name.definition.effectContract = target.effectContract
                    end
                end
            end
            return

        elseif written == "relax" then
            local relaxed = {}
            for _, arg in ipairs(stat.annotationArgs or {}) do
                local expr = arg.expr
                local value = nameText(expr) or stringValue(expr)
                if not value or not RELAXATIONS[value] then
                    c.diag(
                        "NUPP2112",
                        arg,
                        "@relax names function-identity, load-order, error-site, "
                        .. "frames, gc-timing, table-order, fp-contract, or fp-transcendentals"
                    )
                else
                    relaxed[value] = true
                end
            end
            if valid and target then
                target.relaxedGuarantees = relaxed
                if targetBody then
                    targetBody.relaxedGuarantees = relaxed
                end
            end
            if stat.stat then
                c.checkStat(stat.stat)
            end
            return

        end

        if written ~= "allow" then
            if stat.stat then
                c.checkStat(stat.stat)
            end
            return
        end

        -- @allow (CODE, ...) silences those diagnostics for the statement it
        --     decorates, and nothing outside it. With no arguments it silences
        --     everything there, which is blunt on purpose: it should look like what
        --     it is.
        local set = {}
        if not stat.annotationArgs or #stat.annotationArgs == 0 then
            set["*"] = true
        else
            for _, arg in ipairs(stat.annotationArgs) do
                local expr = arg.kind == "annotationArg" and arg.expr or nil
                local named = arg.kind == "annotationArg" and arg.name or nil
                local spelled = nil
                if expr and expr.kind == "name" then
                    local tok = expr.token
                    spelled = tok and tok.text or nil
                end
                local name = spelled or stringValue(expr)
                if named or not name then
                    c.diag("NUPP2112", arg, "@allow arguments must be lint names or codes")
                elseif not lints.get(name) then
                    -- A type error is not a judgement to disagree with, so there is
                    -- nothing here to allow.
                    c.diag("NUPP2108", arg, ("%s is not a lint, so it cannot be allowed"):format(name))
                end
                if name then
                    set[name] = true
                end
            end
        end
        c.allowed[#c.allowed + 1] = set
        if stat.stat then
            c.checkStat(stat.stat)
        end
        c.allowed[#c.allowed] = nil
    end

    return handlers
end

export = pragma
