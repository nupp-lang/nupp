module nupp.compiler.check.surfaces

--[[
The call surfaces the compiler owns on the standard library's behalf.

The checker reads them to rotate a call and record its effect; the documentation
generator reads them to print a rotated member in the order a caller writes it.
]]

--- What one compiler-owned call surface asks of the checker and the generator.
local type CompilerSurface = {
    --- The feature effect calling it records, so a target packages the runtime it
    --- needs.
    effect: string?,

    --- Whether the source form puts the callable last while the library signature
    --- keeps it first, so the checker view is rotated and lowering restores the order.
    rotate: boolean?,

    --- Whether that trailing callable is a sendable position, so an inline literal
    --- there is outlined for another Lua state without an annotation.
    sendableLast: boolean?,

    --- The runtime member each overload after the first lands on, indexed the way the
    --- declaration writes them. Two overloads of one name are the same shape at run
    --- time here -- a callable and one more value -- so routing the selected one is
    --- what keeps a type test out of the emitted call.
    overloadMembers: {[integer]: string}?,

    --- The child body may borrow the scope it is started on. A scope joins every
    --- child before it settles, so such a borrow cannot outlive what it borrows.
    bodyMayBorrowScope: boolean?
}

--- The call surfaces the compiler owns on the standard library's behalf, by public
--- module, nominal, and member. The member names here are the only ones lowering ever
--- interpolates into emitted Lua for a rotated call, so nothing user-written reaches
--- that path.
local COMPILER_SURFACES: {
    [string]: {[string]: {[string]: CompilerSurface}}
} = {
    ["nupp.workers.spi"] = {Scope = {spawn = {rotate = true, sendableLast = true,},},},
    [
        "nupp.tasks"
    ] = {
        Scope = {
            spawn = {rotate = true, overloadMembers = {[2] = "_spawnNamed"}, bodyMayBorrowScope = true,},
            fork = {effect = "runtime.workers", rotate = true, sendableLast = true,},
        },
    },
}

--- Whether `nominal.member` of `moduleName` is written with its callable last while
--- its declaration keeps it first.
local function rotates(moduleName: string, nominal: string, member: string): boolean
    local byNominal = COMPILER_SURFACES[moduleName]
    local members = byNominal and byNominal[nominal] or nil
    local surface = members and members[member] or nil

    return surface ~= nil and surface.rotate == true
end

export = {COMPILER_SURFACES = COMPILER_SURFACES, rotates = rotates}
