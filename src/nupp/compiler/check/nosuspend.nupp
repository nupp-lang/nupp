module nupp.compiler.check.nosuspend

--[[
Regions in which suspending is refused.

`nosuspend do ... end` is lexical and static: it erases to an ordinary block and
its whole effect is that a call inside it which may suspend is a diagnostic
rather than a run-time surprise. tecs raises the same refusal today, from
`checkWait`, in a frame, in a game; this is the same fact found while compiling.

The check runs after effect inference rather than during the walk, for the
reason `unused` and `discard` also do: a summary settles only once the file has
been read, and asking early gets an answer that is merely early. So a call
inside a region registers a candidate where it stands -- which is also where its
`@allow` is still in scope -- and the verdict arrives at the sweep.

Two sources answer, and which one applies is not a preference:

- a callee this file can see is answered by its inferred summary, because the
  qualifier on a function type is set at the module boundary and a local
  function never crosses one;
- a callee reached through a type -- another module's export, an alias, a
  parameter -- is answered by `noYield` on that type, which is what
  `docs/neps/0005-suspension.md` S0 put there.

Neither is a fallback for the other. A local function has no qualified type and
a foreign one has no summary here.

See `docs/neps/0005-suspension.md`.
]]

local cst = require("nupp.compiler.cst")
local state = require("nupp.compiler.check.state")

local nosuspend = {}

--- How deep a chain a diagnostic will describe before it stops naming links. A caller
--- four modules from the suspension needs the path; one that needs forty is being told
--- to read the call graph, which the compiler is supposed to have done for them.
local MAX_CHAIN = 8

--- What `install` answers with.
type nosuspend.Ops = {
    readonly region: function(any),
    readonly call: function(any),
    readonly obligation: function(any),
    readonly iterator: function(any, any),
    readonly contract: function(any, string): any,
    readonly callback: function(any, string),
    readonly cleanup: function(any, any),
    readonly sweep: function(any)
}

--- Installs the region check on one run.
---
--- @param c the run's state
--- @return the operations the walk and the end of the file call
function nosuspend.install(c: state.Checker): nosuspend.Ops
    local ops = {}

    -- Calls made inside a region, in source order, judged once inference has settled.
    local candidates: {any} = {}

    -- Calls made while a temporal obligation is live, with the obligation's name,
    -- judged once inference says which callees reach a raw yield.
    local obligations: {any} = {}

    --- Registers a call made while an owner, borrow or loan is live in this frame.
    ---
    --- A raw yield written at the call is refused where it stands, by `callexpr`; one
    --- reached through a visible helper is the same abandonment one call further
    --- away, and only the helper's summary can say so. The obligation is read here
    --- because it is a flow fact: what is live at this call is not what is live at
    --- the sweep.
    ---
    --- @param call the call expression
    function ops.obligation(call: any)
        if not call or c.unsafeDepth > 0 then
            return
        end
        local live = c.liveSuspensionObligation()
        if live then
            obligations[#obligations + 1] = {call = call, obligation = live}
        end
    end

    --- Registers a call to judge at the end of the file, if a region encloses it.
    ---
    --- @param call the call expression
    function ops.call(call: any)
        ops.obligation(call)
        if c.noSuspendDepth <= 0 or not call then
            return
        end
        -- Registered before the call is inferred, so the type the verdict falls back
        -- on is read at the sweep, once the checker has selected what runs.
        candidates[#candidates + 1] = {call = call, code = "NUPP2701", construction = call.isNew == true}
    end

    -- The type the verdict falls back on when no summary answers. The callee's own
    -- type is an overload set where several signatures were written, and a
    -- construction's is the record: in both, the signature the checker selected is
    -- the one that runs.
    local function signatureOf(call: any): any
        local target = call.calleeType
        if target and target.tag == "func" then
            return target
        end
        local signature = call.signatureType
        if signature and signature.tag == "func" then
            return signature
        end

        return target
    end

    --- Registers the implicit call a generic `for` makes to its iterator, if a region
    --- encloses the loop.
    ---
    --- The iterator is invoked once per step by the loop itself rather than by any
    --- call written in the body, so nothing else registers it. Its body is never
    --- visible here -- it is whatever the header's expression answered -- so its
    --- type is the whole of the answer.
    ---
    --- @param stat the loop
    --- @param iteratorType the type of what the header's first expression answered
    function ops.iterator(stat: any, iteratorType: any)
        if c.noSuspendDepth <= 0 or not stat then
            return
        end
        candidates[
            #candidates + 1
        ] = {
            call = stat,
            calleeType = iteratorType and iteratorType.tag == "func" and iteratorType or nil,
            code = "NUPP2701",
            iterator = true,
        }
    end

    --- Registers an operator dispatched to a declared metamethod contract, if a
    --- region encloses it.
    ---
    --- The contract's type is settled after selection, so the candidate is answered
    --- back to the caller, which fills in the signature that was chosen. One that
    --- never resolves stays unresolved, and is refused as any call the compiler
    --- cannot follow is.
    ---
    --- @param site the operator expression
    --- @param operation the metamethod's name
    --- @return the candidate to complete, or nil outside every region
    function ops.contract(site: any, operation: string): any
        if c.noSuspendDepth <= 0 or not site then
            return nil
        end
        local candidate = {call = site, calleeType = nil, code = "NUPP2701", operation = operation}
        candidates[#candidates + 1] = candidate

        return candidate
    end

    -- The regions themselves, walked at the sweep for what is discharged inside them.
    local regions: {any} = {}

    --- Registers a `nosuspend` region.
    ---
    --- What a region discharges -- an owner at its statement's boundary, a `with`
    --- acquisition, an explicit `drop` -- runs a terminal no call names, so the region
    --- is walked for those once inference can say whether each terminal parks.
    ---
    --- @param stat the region statement
    function ops.region(stat: any)
        if stat then
            regions[#regions + 1] = stat
        end
    end

    -- Callback bodies invoked from C, registered as implicit regions.
    local callbackRegions: {any} = {}
    local cleanupContracts: {any} = {}

    --- Registers a cleanup contract discharged inside a region.
    ---
    --- A terminal may suspend: running one is a settlement point, where the coroutine
    --- parks until what the resource owns has settled. That is only a problem where
    --- suspending is refused, so a cleanup outside every region is not judged at all.
    --- Visible bodies are checked after effect inference; bodyless declarations are
    --- part of the trusted boundary and their promise is accepted, exactly as foreign
    --- ownership annotations are.
    function ops.cleanup(cleanup: any, at: any)
        if c.noSuspendDepth <= 0 then
            return
        end
        cleanupContracts[#cleanupContracts + 1] = {cleanup = cleanup, at = at}
    end

    --- Registers a function body that C will call, and which therefore cannot suspend.
    ---
    --- The boundary belongs to the *invocation*, not to the kind of body: what makes
    --- this one unable to yield is that `table.sort` or `string.gsub` is on the stack
    --- when it runs, not anything about the function itself.
    ---
    --- @param body the callback's body
    --- @param where what will be calling it, named in the diagnostic
    function ops.callback(body: any, where: string)
        if not body then
            return
        end
        callbackRegions[#callbackRegions + 1] = {body = body, where = where}
    end

    -- The chain from a call to the suspension it reaches, as related locations.
    --
    -- A one-line "this may suspend" is not actionable when the suspension is four
    -- functions away. The path is found by walking each callee's body for the first
    -- call that also suspends, resolved the same way the verdict resolves one: a
    -- summary records that a body yields, not which of its callees made it yield, so
    -- the edge has to be re-found rather than read off.
    local function firstSuspendingCall(queries, body, flag)
        local found = nil
        local function walk(node)
            if not node or found or cst.isToken(node) then
                return
            end
            local kind = node.kind
            if kind == "call" or kind == "safeCall" or kind == "methodCall" then
                local reached = queries.callee and queries.callee(node) or nil
                if reached and reached.summary and reached.summary[flag] then
                    found = {info = reached, at = node}
                    return
                end
            end
            for _, child in ipairs(node) do
                walk(child)
            end
        end

        walk(body)

        return found
    end

    local function chain(queries, info, flag)
        local related, seen, current = {}, {}, info
        while current and #related < MAX_CHAIN do
            if seen[current] or not current.body then
                break
            end
            seen[current] = true
            local step = firstSuspendingCall(queries, current.body, flag or "yields")
            if not step then
                break
            end
            local callee = step.at.obj
            local token = callee and (callee.token or callee.name) or nil
            if token then
                related[
                    #related + 1
                ] = {
                    line = token.line,
                    col = token.col,
                    offset = token.offset,
                    length = #token.text,
                    msg = ("%s may suspend"):format(token.text),
                }
            end
            current = step.info
        end

        return related
    end

    -- Every call written inside a body, so a callback's region can be judged without
    -- the walk having had to know it was one.
    local function callsWithin(body: any, into: {any})
        if not body or cst.isToken(body) then
            return
        end
        local kind = body.kind
        if kind == "funcExpr" or kind == "shortfn" or kind == "localFuncStmt" or kind == "funcStmt" then
            return
        end
        if kind == "call" or kind == "safeCall" or kind == "methodCall" then
            into[#into + 1] = body
        end
        for _, child in ipairs(body.stats or {}) do
            callsWithin(child, into)
        end
        for _, child in ipairs(body) do
            callsWithin(child, into)
        end
    end

    -- Whether a terminal may park, from its visible body where this file has one and
    -- from its type where it does not.
    local function cleanupMayYield(cleanup: any, queries: any): boolean
        local token = cleanup and cleanup.token
        local info = token and queries and queries.known and queries.known(token) or nil
        local mayYield = false
        if cleanup and cleanup.functionType and cleanup.functionType.foreign then
            mayYield = false
        elseif info and info.summary then
            mayYield = info.summary.top == true or info.summary.external == true or info.summary.yields == true
            if mayYield and info.body then
                local calls = {}
                callsWithin(info.body, calls)
                local allTypedNonYielding = #calls > 0
                for _, call in ipairs(calls) do
                    local target = call.calleeType or call.signatureType
                    -- An ownership intrinsic is not a call to something that could
                    -- yield: it lowers to generated code that calls the terminals
                    -- named in it, and those are judged as the cleanups they are.
                    if call.ownershipIntrinsic then
                        target = nil
                    elseif not target or target.tag ~= "func" or not target.noYield then
                        allTypedNonYielding = false
                    end
                end
                if allTypedNonYielding then
                    mayYield = false
                end
            end
        elseif cleanup and cleanup.functionType and cleanup.functionType.tag == "func" then
            mayYield = cleanup.functionType.noYield ~= true and cleanup.visibleBody == true
        end

        return mayYield
    end

    -- The terminal a cleanup runs: a field cleanup names the function that closes
    -- the field.
    local function terminalOf(cleanup: any): any
        local operation = cleanup
        while operation and operation.kind == "field" do
            operation = operation.cleanup
        end
        if operation and operation.kind == "function" then
            return operation
        end

        return nil
    end

    -- Every terminal discharged inside a body, with where it is discharged: an owner
    -- at the statement that bound it, a `with` acquisition at its expression, and an
    -- explicit `drop` at the call. Nested functions run at a time the region does not
    -- cover.
    local function dischargedWithin(body: any, into: {any})
        if not body or cst.isToken(body) then
            return
        end
        local kind = body.kind
        if kind == "funcExpr" or kind == "shortfn" or kind == "localFuncStmt" or kind == "funcStmt" then
            return
        end
        for _, owner in ipairs(body.automaticOwners or {}) do
            for _, cleanup in ipairs(owner.cleanups or {}) do
                into[#into + 1] = {cleanup = cleanup, at = body}
            end
        end
        if kind == "withStmt" then
            for _, binding in ipairs(body.bindings or {}) do
                for _, cleanup in ipairs(binding.ownerCleanups or {}) do
                    into[#into + 1] = {cleanup = cleanup, at = binding.expr or body}
                end
            end
        end
        if body.ownershipIntrinsic == "drop" or body.ownershipIntrinsic == "attemptAll" then
            for _, cleanup in ipairs(body.ownerCleanups or {}) do
                into[#into + 1] = {cleanup = cleanup, at = body}
            end
        end
        for _, child in ipairs(body.stats or {}) do
            dischargedWithin(child, into)
        end
        for _, child in ipairs(body) do
            dischargedWithin(child, into)
        end
    end

    --- Judges every registered call once effect inference has settled.
    ---
    --- @param queries the analysis query surface, or nil when nothing was analyzed
    function ops.sweep(queries: any)
        -- A terminal is reported once per region, where it is first discharged: an
        -- owner dropped by hand is the same obligation as the one its statement
        -- would have discharged, and two reports would say one thing twice.
        for _, region in ipairs(regions) do
            local discharged: {any} = {}
            dischargedWithin(region.body, discharged)
            local reported = {}
            for _, candidate in ipairs(discharged) do
                local terminal = terminalOf(candidate.cleanup)
                if terminal and not reported[terminal] and cleanupMayYield(terminal, queries) then
                    reported[terminal] = true
                    c.diag(
                        "NUPP2701",
                        candidate.at,
                        ("cleanup %q may suspend, and this region forbids suspending"):format(terminal.name),
                        nil,
                        {help = "discharge the owner outside the region, or give it a terminal that cannot suspend"}
                    )
                end
            end
        end
        for _, candidate in ipairs(obligations) do
            local call = candidate.call
            -- Written at the call: already refused where it stands.
            if not call.rawYield then
                local info = queries and queries.callee and queries.callee(call) or nil
                if info and info.summary and info.summary.rawYields and not info.external then
                    local callee = call.obj
                    local token = callee and (callee.token or callee.name) or nil
                    c.diag(
                        "NUPP2603",
                        callee or call,
                        (
                            "%s reaches a raw coroutine.yield, and temporal obligation %q is live"
                        ):format(token and ("`" .. token.text .. "`") or "this call", candidate.obligation),
                        nil,
                        {
                            help = "suspend inside a `handle suspension` region, where a "
                            .. "handler is responsible for resuming or cancelling it",
                            related = chain(queries, info, "rawYields"),
                        }
                    )
                end
            end
        end
        for _, candidate in ipairs(cleanupContracts) do
            local cleanup = candidate.cleanup
            if cleanupMayYield(cleanup, queries) then
                c.diag(
                    "NUPP2701",
                    candidate.at,
                    ("cleanup %q may suspend, and this region forbids suspending"):format(cleanup.name),
                    nil,
                    {help = "discharge the owner outside the region, or give it a terminal that cannot suspend"}
                )
            end
        end
        for _, region in ipairs(callbackRegions) do
            local found: {any} = {}
            callsWithin(region.body, found)
            for _, call in ipairs(found) do
                candidates[#candidates + 1] = {call = call, code = "NUPP2702", where = region.where}
            end
        end
        for _, candidate in ipairs(candidates) do
            local call = candidate.call
            local callee = call.obj
            local token = callee and (callee.token or callee.name) or nil
            if candidate.iterator then
                local header = call.exprs and call.exprs[1] or nil
                token = header and cst.firstToken(header) or nil
            end
            local info = queries and queries.callee and queries.callee(call) or nil
            local mayYield, why = nil, nil
            if candidate.construction and not call.constructorEntry then
                -- A construction with no declared constructor runs no code of its
                -- own: the values are the arguments, judged where they were written.
                mayYield = false
            elseif info and info.summary and not info.external then
                -- Seen here: the summary is the answer, and a widened one is a callee
                -- that reached something this file could not follow.
                if info.summary.top then
                    mayYield, why = true, "reaches code with unknown effects"
                else
                    mayYield = info.summary.yields == true
                    why = "may suspend"
                end
            else
                local target = candidate.calleeType
                if target == nil and not candidate.iterator and not candidate.operation then
                    target = signatureOf(call)
                end
                if target and target.tag == "func" then
                    mayYield = not target.noYield
                    why = "may suspend"
                else
                    -- Nothing resolved it at all. A call the compiler cannot follow is
                    -- the case a region exists to be careful about.
                    mayYield, why = true, "cannot be resolved, so it may suspend"
                end
            end
            if mayYield then
                local named = token and ("`" .. token.text .. "`") or "this call"
                if candidate.iterator then
                    named = "the iterator " .. named
                elseif candidate.operation then
                    named = "`" .. candidate.operation .. "`"
                end
                local message
                if candidate.code == "NUPP2702" then
                    -- The boundary belongs to the invocation. Saying which call reaches
                    -- this body is the whole of the explanation: the same function is
                    -- free to suspend anywhere else.
                    message = (
                        "%s %s, and %s cannot yield across the C call that reaches it"
                    ):format(named, why, candidate.where)
                else
                    message = ("%s %s, and this region forbids suspending"):format(named, why)
                end
                c.diag(candidate.code, callee or call, message, nil, {
                    help = "call something that cannot suspend, declare the callee's type "
                    .. "`nosuspend function(...)`, or move this out of the region",
                    related = info and chain(queries, info) or nil,
                })
            end
        end
    end

    return ops as nosuspend.Ops
end

export = nosuspend
