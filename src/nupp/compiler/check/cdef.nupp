--[[
Declaring C to the checker.

`cdef struct` and `cdef function` describe memory and entry points that already
exist, so unlike the rest of the language nothing here is defined — it is
asserted, and the assertion has to be one LuaJIT's FFI can honour. Every field
must be laid out in C memory and every parameter must be a C type, which is what
the reifiability test enforces.

Ownership matters more here than anywhere: a C function that produces a resource
is the one place the checker cannot see the cleanup for itself. It is stated in
the type -- `Owned<T, cleanup>` on the return, `out p: Owned<T, cleanup>*` on an
owning output slot, or `out p: T* borrows (source)` on a borrowed one -- and
`Success<T, N>` on the return says which status means those outputs hold values.
]]

local T = require("nupp.compiler.types")
local generics = require("nupp.compiler.generics")
local cabi = require("nupp.compiler.cabi")
local cst = require("nupp.compiler.cst")
local state = require("nupp.compiler.check.state")

local cdef = {}

--- A type, as nupp.compiler.types builds them.
local type Type = T.Type

local function stringLiteral(token): string?
    if not token then
        return nil
    end
    local chunk = loadstring("return " .. token.text)
    if not chunk then
        return nil
    end
    local ok, value = pcall(chunk)

    return ok and type(value) == "string" and value or nil
end

--- Installs the cdef statements on one run.
---
--- @param c the run's state
--- @param reifiableField whether a field of that type can live in C memory, which the
---     walk owns because a GC-managed declaration answers it differently
--- @return the statement kinds this family answers
function cdef.install(
    c: state.Checker,
    reifiableField: function(t: Type, isCdef: boolean?): boolean
): state.StatHandlers
    local own = c.own
    local resolveCleanups = own.resolveCleanups
    local pointerShaped, validateCleanups = c.pointerShaped, c.validateCleanups

    local handlers = {}

    local function countedView(name: string, element: Type, at): Type
        local exports = c.env and c.env.resolveModuleExports and c.env.resolveModuleExports(c.env, "nupp.span") or nil
        local declaration = exports and exports.types and exports.types[name] or nil
        if not declaration or declaration.tag ~= "nominal" or not declaration.typeParams or not declaration.typeParams[
            1
        ] then
            c.diag("NUPP2630", at, "countedBy requires the bundled nupp.span module")
            return T.any
        end

        return generics.instantiate(declaration, {[declaration.typeParams[1]] = element})
    end

    handlers.cdefStruct = function(stat: cst.CdefStruct)
        local structName = stat.name
        if not structName then
            return
        end
        local n = T.nominal(structName.text, "struct")
        n.cdefName = structName.text
        n.cdefKind = stat.aggregateKind or "struct"
        stat.cdefIdentity = table.concat({"aggregate", n.cdefKind, structName.text}, "\0")
        n.cdefIdentity = stat.cdefIdentity
        c.bindType(structName.text, n, structName)
        if structName.definition then
            structName.definition.cdef = true
        end
        n.fieldOrder = {}
        n.fieldDefs = {}
        n.writeFieldDefs = {}
        local semanticFields = {}
        for _, e in ipairs(stat.entries) do
            local fieldName, declaredType = nil, nil
            local bitWidth = nil
            if e.kind == "fieldDecl" then
                local field = e as cst.FieldDecl
                fieldName, declaredType, bitWidth = field.name, field.type, field.bitWidth
            end
            if fieldName then
                local ft = c.resolveType(declaredType)
                local text = fieldName.text
                n.byname[text] = ft
                n.writeByname[text] = ft
                local fieldDef = c.definition(fieldName, "property")
                n.fieldDefs[text] = fieldDef
                n.writeFieldDefs[text] = fieldDef
                fieldDef.type = ft
                fieldDef.cdef = true
                c.markToken(fieldName, fieldDef, ft, "property")
                n.fieldOrder[#n.fieldOrder + 1] = text
                semanticFields[
                    #semanticFields + 1
                ] = table.concat({text, T.tostring(ft), bitWidth and bitWidth.text or ""}, ":")
                if not reifiableField(ft, true) then
                    c.diag("NUPP2203", e, ("cdef field %q: %s is not a C type"):format(text, T.tostring(ft)))
                end
                if bitWidth then
                    local width = tonumber(bitWidth.text)
                    local bits = 0
                    if ft == T.int8 or ft == T.uint8 then
                        bits = 8
                    elseif ft == T.int16 or ft == T.uint16 then
                        bits = 16
                    elseif ft == T.int32 or ft == T.uint32 then
                        bits = 32
                    elseif ft == T.int64 or ft == T.uint64 then
                        bits = 64
                    end
                    if bits == 0 or not width or width % 1 ~= 0 or width < 1 or width > bits then
                        c.diag(
                            "NUPP2203",
                            bitWidth,
                            ("bitfield %q needs an integer width from 1 through %d"):format(text, bits)
                        )
                    end
                end
            else
                c.diag("NUPP2203", e, "cdef aggregate bodies hold fields only")
            end
        end
        stat.cdefSemantic = table.concat(
            {"c-aggregate-v1", n.cdefKind, structName.text, table.concat(semanticFields, "\0")},
            "\0"
        )
        c.bindVar(structName.text, n, true, structName)
        if structName.definition then
            structName.definition.cdefIdentity = stat.cdefIdentity
        end
    end

    handlers.cdefFunc = function(stat: cst.CdefFunc)
        c.raises.checkParams(stat, stat.params or {})
        local params, paramModes, paramNames = {}, {}, {}
        local abiParams = {}
        local physicalNodes, physicalDefs = {}, {}
        local ffiOut = {}
        local logicalByName = {}
        for parameterIndex, p in ipairs(stat.params) do
            local declared, pname, modeTok = nil, nil, nil
            if p.kind == "param" then
                declared, pname, modeTok = p.type, p.name, p.modeTok
            end
            if declared then
                local pt = c.resolveType(declared)
                if pt.tag == "func" then
                    pt = T.foreignFunction(pt)
                end
                declared.resolvedType = pt
                local mode = modeTok and modeTok.text or "plain"
                local relation = declared.kind == "tborrows" and declared as cst.Tborrows or nil
                local pdef = c.definition(pname, "parameter")
                if pdef then
                    pdef.type = pt
                end
                c.markToken(pname, pdef, pt, "parameter")
                if not (reifiableField(pt, true) or pt == T.number or pt == T.string or pt.tag == "func") then
                    c.diag("NUPP2203", p, ("cdef parameter: %s is not a C type"):format(T.tostring(pt)))
                end
                if pt.tag == "nominal" and pt.declKind == "struct" and not pt.cdefName then
                    c.diag(
                        "NUPP2203",
                        p,
                        "an ordinary Nupp struct crosses a C boundary by pointer or array, not by value"
                    )
                end
                local abiCountedBy = (p as cst.Param).countedBy
                -- The ABI record is the C signature, and an ownership wrapper is not
                -- part of it. An out parameter carries the wrapper inside its pointer,
                -- so the slot is unwrapped rather than the pointer around it.
                local abiType = T.unwrapOwnership(pt)
                if abiType.tag == "ptr" and abiType.elem.tag == "affine" then
                    abiType = T.ptr(T.unwrapOwnership(abiType.elem))
                end
                abiParams[
                    #abiParams + 1
                ] = {
                    name = pname and pname.text or ("arg" .. tostring(parameterIndex)),
                    type = abiType,
                    mode = mode,
                    countedBy = abiCountedBy and abiCountedBy.text or nil,
                }
                if mode ~= "plain" and not pointerShaped(pt) then
                    c.diag("NUPP2602", p, mode .. " parameters must have a pointer-shaped type")
                end
                if mode == "out" then
                    local countedBy = (p as cst.Param).countedBy
                    if countedBy then
                        c.diag("NUPP2630", countedBy, "countedBy does not support out parameters")
                    end
                    local named = pname and pname.text or ""
                    local slot = pt.tag == "ptr" and pt.elem or nil
                    local output = nil
                    if relation then
                        output = {
                            kind = "borrowed",
                            name = named,
                            sources = relation.params or {relation.param},
                            at = relation,
                        }
                        if slot and slot.tag == "affine" then
                            c.diag("NUPP2602", relation, "a borrowed output cannot also carry an affine terminal")
                        end
                    end
                    -- `out p: Owned<T, cleanup>*` is the slot the callee writes,
                    -- holding a value the caller then owns. The contract is on the
                    -- slot's type rather than above the signature, so it sits where
                    -- the value it describes does and the ABI is unchanged.
                    if slot and slot.tag == "affine" and not output then
                        output = {
                            kind = "affine",
                            name = named,
                            cleanups = slot.cleanups,
                            transferOnly = slot.transferOnly,
                            at = p,
                        }
                    end
                    if not output then
                        c.diag(
                            "NUPP2602",
                            p,
                            "an out parameter is written `out p: Owned<T, cleanup>*` "
                            .. "or `out p: T* borrows (source)`"
                        )
                    elseif not slot or not pointerShaped(T.unwrapOwnership(slot)) then
                        c.diag("NUPP2602", p, "out parameter must have pointer-to-pointer type")
                    else
                        output.typeNode = declared
                        output.valueType = T.unwrapOwnership(slot)
                        output.cIndex = parameterIndex
                        output.hasStatus = stat.ret ~= nil
                        output.success = output.success or "pending"
                        ffiOut[#ffiOut + 1] = output
                    end
                else
                    if relation then
                        c.diag("NUPP2602", relation, "borrows (...) on a cdef parameter requires out")
                    end
                    params[#params + 1] = pt
                    paramModes[#params] = mode
                    paramNames[#params] = pname and pname.text or ""
                    physicalNodes[#params] = p
                    physicalDefs[#params] = pdef
                    logicalByName[pname and pname.text or ""] = #params
                end
            end
        end
        local rets = {}
        local abiResult = nil
        if stat.ret then
            c.cdefReturn = true
            local rt = c.resolveType(stat.ret)
            c.cdefReturn = nil
            stat.ret.resolvedType = rt
            rets[1] = rt
            -- An ownership wrapper says who discharges the result. It does not change
            -- the ABI, so what has to be a C type -- and what the ABI record carries --
            -- is the type inside it.
            local raw = T.unwrapOwnership(rt)
            abiResult = raw
            if rt.tag == "affine" then
                if not pointerShaped(raw) and raw ~= T.cstring then
                    c.diag("NUPP2203", stat.ret, "an owned cdef return must be a pointer")
                end
                local cleanups = resolveCleanups(rt.cleanups or {}, stat.ret, nil)
                local owner = T.affine(raw, cleanups)
                rets[1] = owner
                validateCleanups(owner, cleanups, stat.ret, "NUPP2615")
            end
            if not (reifiableField(raw, true) or raw == T.number) then
                c.diag("NUPP2203", stat.ret, ("cdef return: %s is not a C type"):format(T.tostring(raw)))
            end
            if rt.tag == "nominal" and rt.declKind == "struct" and not rt.cdefName then
                c.diag("NUPP2203", stat.ret, "an ordinary Nupp struct crosses a C boundary by pointer, not by value")
            end
        end
        -- Which C status means the call succeeded, and so whether each output holds a
        -- value. `Success<T, N>` and `Failure<T, N>` say it once on the return, where
        -- two outputs cannot disagree; a bare status type means every call succeeded.
        local success = stat.ret and (stat.ret as any).cdefSuccess or "always"
        for _, output in ipairs(ffiOut) do
            if output.success == "pending" then
                output.success = success
            end
            if output.success ~= "always" and not stat.ret then
                c.diag("NUPP2602", output.at or stat, "conditional output needs a C status return")
            end
            local valueType = output.success == "always" and output.valueType or T.optional(output.valueType)
            if output.kind == "affine" then
                output.cleanups = resolveCleanups(output.cleanups or {}, output.at or stat, nil)
                validateCleanups(
                    T.affine(output.valueType, output.cleanups),
                    output.cleanups,
                    output.at or stat,
                    "NUPP2615"
                )
                rets[#rets + 1] = T.affine(valueType, output.cleanups)
            else
                output.sourceParams = {}
                for _, source in ipairs(output.sources or {}) do
                    local sourceParam = source and logicalByName[source.text] or nil
                    if not sourceParam then
                        c.diag(
                            "NUPP2602",
                            source or output.at or stat,
                            ("borrowed output source %q is not an input parameter"):format(source and source.text or "")
                        )
                    else
                        c.markToken(source, physicalDefs[sourceParam], params[sourceParam], "parameter")
                        if paramModes[sourceParam] ~= "borrows" then
                            c.diag("NUPP2602", source, "a borrowed output source must be a borrows parameter")
                        end
                        output.sourceParams[#output.sourceParams + 1] = sourceParam
                    end
                end
                rets[#rets + 1] = T.borrowed(valueType)
            end
            output.returnIndex = #rets
        end
        local cdefType = T.func(
            params,
            rets,
            stat.varargs or false,
            paramModes,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            ffiOut,
            nil,
            false,
            nil,
            nil,
            nil,
            nil,
            nil,
            nil,
            paramNames,
            nil,
            true
        )
        stat.physicalSignatureType = cdefType
        local byPhysicalName = {}
        for index, name in ipairs(paramNames) do
            byPhysicalName[name] = index
        end
        local mappings, pointerAt, mappedCounts = {}, {}, {}
        local hasCountedPointers = false
        for pointerIndex, parameter in ipairs(physicalNodes) do
            local countToken = parameter.countedBy
            if countToken then
                hasCountedPointers = true
                local pointerName = paramNames[pointerIndex]
                local countName = countToken.text
                local countIndex = byPhysicalName[countName]
                local pointerType = params[pointerIndex]
                local valid = true
                if not countIndex then
                    c.diag("NUPP2630", countToken, ("countedBy names no physical count parameter %q"):format(countName))
                    valid = false
                else
                    c.markToken(countToken, physicalDefs[countIndex], params[countIndex], "parameter")
                end
                if pointerType.tag ~= "ptr" then
                    c.diag("NUPP2630", parameter, ("counted parameter %q must be a C pointer"):format(pointerName))
                    valid = false
                elseif paramModes[pointerIndex] ~= "borrows" then
                    c.diag(
                        "NUPP2630",
                        parameter,
                        ("counted pointer %q must use call-duration borrows"):format(pointerName)
                    )
                    valid = false
                end
                if countIndex then
                    if params[countIndex] ~= T.uint64 then
                        c.diag(
                            "NUPP2630",
                            physicalNodes[countIndex],
                            ("countedBy parameter %q must currently be uint64"):format(countName)
                        )
                        valid = false
                    elseif paramModes[countIndex] ~= "plain" then
                        c.diag(
                            "NUPP2630",
                            physicalNodes[countIndex],
                            ("countedBy parameter %q must be plain"):format(countName)
                        )
                        valid = false
                    end
                end
                if valid then
                    local isRead = pointerType.elem.tag == "const"
                    local element = isRead and pointerType.elem.inner or pointerType.elem
                    local mapping = {
                        kind = isRead and "read" or "write",
                        pointerIndex = pointerIndex,
                        countIndex = countIndex,
                        pointerName = pointerName,
                        countName = countName,
                        element = element,
                    }
                    mappings[#mappings + 1] = mapping
                    pointerAt[pointerIndex] = mapping
                    mappedCounts[countIndex] = true
                end
            end
        end
        if hasCountedPointers then
            if stat.varargs then
                c.diag("NUPP2630", stat, "countedBy does not support variadic C functions")
            end
            if #ffiOut > 0 then
                c.diag("NUPP2630", stat, "countedBy does not support out parameters")
            end
            table.sort(mappings, function(left, right)
                return left.pointerIndex < right.pointerIndex
            end)
            local logicalParams, logicalModes, logicalNames = {}, {}, {}
            for physicalIndex, physicalType in ipairs(params) do
                local mapping = pointerAt[physicalIndex]
                if mapping then
                    mapping.logicalIndex = #logicalParams + 1
                    logicalParams[
                        #logicalParams + 1
                    ] = countedView(
                        mapping.kind == "write" and "WriteSpan" or "Span",
                        mapping.element,
                        physicalNodes[physicalIndex]
                    )
                    logicalModes[#logicalModes + 1] = mapping.kind == "write" and "exclusive" or "borrows"
                    logicalNames[#logicalNames + 1] = mapping.pointerName
                elseif not mappedCounts[physicalIndex] then
                    logicalParams[#logicalParams + 1] = physicalType
                    logicalModes[#logicalModes + 1] = paramModes[physicalIndex]
                    logicalNames[#logicalNames + 1] = paramNames[physicalIndex]
                end
            end
            local logicalType = T.func(
                logicalParams,
                rets,
                false,
                logicalModes,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                false,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                logicalNames
            )
            stat.countedAbi = {
                mappings = mappings,
                pointerAt = pointerAt,
                mappedCounts = mappedCounts,
                logicalNames = logicalNames,
                physicalNames = paramNames,
            }
            cdefType = logicalType
        end
        local cdefName = stat.name
        stat.signatureType = cdefType
        if not cdefName then
            return
        end
        stat.cAbiSignature = cabi.functionRecord(cdefName.text, abiParams, abiResult, stat.varargs or false, "c")
        if not stat.countedAbi then
            c.cDefinedFunctions[cdefName.text] = cdefType
        end
        c.bindVar(cdefName.text, cdefType, true, cdefName, "function")
        if cdefName.definition then
            cdefName.definition.cdef = true
            local library = stringLiteral(stat.fromLib) or "<default>"
            stat.cdefIdentity = table.concat({"function", library, cdefName.text}, "\0")
            stat.cdefSemantic = table.concat(
                {
                    "c-function-v1",
                    library,
                    cdefName.text,
                    T.tostring(stat.physicalSignatureType),
                    T.tostring(stat.signatureType),
                },
                "\0"
            )
            cdefName.definition.cdefIdentity = stat.cdefIdentity
        end
    end

    return handlers
end

return cdef
