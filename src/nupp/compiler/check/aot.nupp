module nupp.compiler.check.aot

local reducerContracts = require("nupp.compiler.aot.reducers")

--[[
The source subset an `@aot` body is allowed to be.

`@aot` promises that a whole function compiles ahead of time rather than being
left to LuaJIT, so the constructs it may contain are the ones the AOT IR can
represent. This pass is the source-local half of that promise: it runs on a
checked body and names what the IR could not have taken, so a programmer hears
"a nested function has no AOT IR opcode" at the closure rather than
"lowering failed" from a backend three phases later.

It is deliberately structural. A construct declined here is declined because it
has no representation at all -- a closure, a table, varargs, `goto` -- and that
is visible in the tree without asking what anything's type is. The value-level
subset is the other half and belongs with the IR,
which is where a type is actually needed to say that some `number` is admitted
and some `any` is not. Reporting the structural half here keeps that later pass
from having to re-explain constructs it never saw.

A method call is deliberately not refused here, even though a dynamic one has no
AOT IR opcode. `span[i]` is the memory boundary the
whole feature is built on and are lowered directly rather than dispatched, so
whether a call resolves is a question about its receiver's type and belongs to
the pass that has one. Refusing the syntax would refuse the subset's own
vocabulary. An optional call is refused, because `?:` is dynamic by
construction whatever it is called on.

Each declined construct reports once and the walk does not descend into it. A
closure containing three tables is one problem with one fix, and listing the
tables inside a function that cannot be there at all is noise.

See `docs/learn/performance/ahead-of-time/index.md`.
]]

local cst = require("nupp.compiler.cst")
local state = require("nupp.compiler.check.state")

local aot = {}

--- A node of the tree being checked.
local type Node = cst.Node

--- What `install` answers with.
type aot.Ops = {readonly body: function(any)}

--- The constructs with no AOT IR representation, and what to call each one where a
--- diagnostic has to name it. A kind absent from here is not thereby admitted; it is
--- only not refused on its shape alone.
local DECLINED: {
    [string]: string
} = {
    funcExpr = "a nested function",
    shortfn = "a nested function",
    funcStmt = "a nested function",
    localFuncStmt = "a nested function",
    vararg = "varargs",
    gotoStmt = "`goto`",
    labelStmt = "a label",
    istring = "an interpolated string",
    safeCall = "an optional call",
    safeIndex = "an optional index",
    safeBracket = "an optional index",
    newExpr = "a constructor call",
    handleStmt = "suspension handling",
    unsafeStmt = "an `unsafe` region",
    unsafeOwnershipExpr = "an unsafe memory operation",
}

--- Why each declined construct is declined, in the terms the AOT contract uses. The
--- diagnostic carries this so removing the construct is an obvious next step rather
--- than a guess at what the compiler wanted instead.
local BECAUSE: {
    [string]: string
} = {
    funcExpr = "an AOT body has no closure, upvalue, or dynamic call",
    shortfn = "an AOT body has no closure, upvalue, or dynamic call",
    funcStmt = "an AOT body has no closure, upvalue, or dynamic call",
    localFuncStmt = "an AOT body has no closure, upvalue, or dynamic call",
    vararg = "an AOT function has a fixed admitted signature",
    gotoStmt = "AOT IR source maps do not yet model arbitrary jumps",
    labelStmt = "AOT IR source maps do not yet model arbitrary jumps",
    istring = "interpolated construction is not admitted; use explicit string concatenation",
    safeCall = "an AOT call must resolve statically",
    safeIndex = "an AOT body indexes only spans, structs, and fixed arrays",
    safeBracket = "an AOT body indexes only spans, structs, and fixed arrays",
    newExpr = "an AOT body creates no owner and allocates nothing",
    handleStmt = "an AOT function is non-suspending by construction",
    unsafeStmt = "`@aot` is a checked contract and does not admit unsafe operations",
    unsafeOwnershipExpr = "`@aot` is a checked contract and does not admit unsafe operations",
}

--- Installs the AOT subset walk on one run.
---
--- @param c the run's state
--- @return the operation the pragma calls once a body has been checked
function aot.install(c: state.Checker): aot.Ops
    local ops = {}

    --- Reports one declined construct.
    local function decline(node: Node, kind: string): nil
        local at = cst.firstToken(node) or node
        c.diag("NUPP2903", at, ("%s has no AOT IR representation; %s"):format(DECLINED[kind], BECAUSE[kind]))
    end

    --- Walks a checked `@aot` body and reports every construct the IR cannot take.
    ---
    --- @param node the body, or a node within it
    function ops.body(node: any): nil
        if node == nil or cst.isToken(node) then
            return
        end
        -- Exactly one top-level numeric loop is the shape lane lowering can take.
        -- It is recorded rather than required: a body of another shape is an
        -- ordinary `@aot` function that compiles scalar, and only the
        -- vectorisation check has anything to say about it.
        local body = (node as any).body
        local loops = 0
        for _, statement in ipairs(body and body.stats or {}) do
            local actual = statement
            while actual ~= nil and actual.kind == "pragmaStmt" do
                actual = actual.stat
            end
            if actual ~= nil and actual.kind == "fornumStmt" then
                loops = loops + 1
            end
        end
        (node as any).aotMapLoop = loops == 1

        local function exactCall(current: cst.Call): any?
            local callee = current.obj
            local exact = callee ~= nil and (callee as any).exactCallExport or nil
            if exact == nil and callee ~= nil and callee.kind == "dotIndex" then
                local indexed = callee as cst.DotIndex
                local base = indexed.obj
                local baseExact = base ~= nil and (base as any).exactCallExport or nil
                if baseExact ~= nil and indexed.name ~= nil then
                    exact = {identity = baseExact.identity .. "." .. indexed.name.text,}
                end
                local token = base ~= nil and base.kind == "name" and (base as cst.NameExpr).token or nil
                local definition = token ~= nil and (token as any).definition or nil
                local moduleName = definition ~= nil and definition.requiredModule or nil
                if exact == nil and moduleName ~= nil and indexed.name ~= nil then
                    exact = {identity = moduleName .. "." .. indexed.name.text,}
                end
            end
            if exact == nil and callee ~= nil and callee.kind == "name" then
                local token = (callee as cst.NameExpr).token
                local definition = token ~= nil and (token as any).definition or nil
                exact = definition ~= nil and definition.exactCallExport or nil
            end

            return exact
        end

        --- The declaration identity of a local name expression.
        local function localIdentity(current: any): any?
            if current == nil or current.kind ~= "name" then
                return nil
            end
            local token = (current as cst.NameExpr).token

            return token ~= nil and ((token as any).definition or token) or nil
        end

        --- Checks reducer ownership while the source tree and lexical binding
        --- identities are still available. Target lowering repeats these rules
        --- defensively, but `nupp check` owns the source-level contract.
        local function reducers(): nil
            local states: {[any]: any} = {}
            local ordered: {any} = {}
            local nextRegion: integer = 0

            local function constructor(current: any): (string?, string?)
                if current == nil or current.kind ~= "call" then
                    return nil, nil
                end
                local exact = exactCall(current as cst.Call)
                local identity = exact ~= nil and exact.identity or nil
                local order: string?
                local operation: string?
                if identity ~= nil then
                    local contract = reducerContracts.CONSTRUCTORS[identity]
                    if contract ~= nil then
                        return contract.order, contract.method
                    end
                    order, operation = identity:match("^nupp%.simd%.reducer%.(%a+)(%u%l+)$")
                end
                if order ~= "ordered" and order ~= "pairwise" and order ~= "algebraic" and order ~= "compensated" then
                    return nil, nil
                end
                if operation ~= "Sum" and operation ~= "Product" and operation ~= "Dot" then
                    return nil, nil
                end

                return order, operation == "Product" and "multiply" or "add"
            end

            local function diagnose(current: any, message: string): nil
                c.diag("NUPP2904", cst.firstToken(current) or current, message)
            end

            local function use(call: cst.MethodCall, region: integer?, direct: boolean): nil
                local identity = localIdentity(call.obj)
                local state_ = identity ~= nil and states[identity] or nil
                if state_ == nil or call.name == nil then
                    return
                end
                local method = call.name.text
                if method == state_.contribution then
                    if region == nil then
                        diagnose(call, "a reducer contribution belongs directly inside one @simd loop")
                        return
                    elseif not direct then
                        diagnose(
                            call,
                            "a reducer receives exactly one unconditional contribution per logical iteration"
                        )
                    end
                    if state_.region ~= nil and state_.region ~= region then
                        diagnose(call, "a reducer is scoped to exactly one @simd loop")
                    else
                        state_.region = region
                    end
                    state_.contributions = state_.contributions + 1
                    if state_.contributions > 1 then
                        diagnose(call, "a reducer receives exactly one contribution per logical iteration")
                    end
                elseif method == "value" then
                    if region ~= nil then
                        diagnose(call, "a reducer is finalized after its @simd loop")
                    elseif state_.region == nil then
                        diagnose(call, "a reducer must receive its contribution before it is finalized")
                    elseif state_.finalized then
                        diagnose(call, "a reducer is finalized exactly once")
                    else
                        state_.finalized = true
                    end
                end
            end

            local scan: function(any, integer?, boolean): nil
            scan = function(current: any, region: integer?, direct: boolean): nil
                if current == nil or cst.isToken(current) then
                    return
                end
                if current.kind == "methodCall" then
                    use(current as cst.MethodCall, region, direct)
                    direct = false
                end
                for _, child in ipairs(current as {any}) do
                    scan(child, region, false)
                end
            end

            local function simdLoop(loop: any, nested: boolean): nil
                nextRegion = nextRegion + 1
                local region = nextRegion
                if nested then
                    diagnose(loop, "an @simd loop cannot be nested in another @simd loop")
                end
                local loopBody = loop.body
                for _, statement in ipairs(loopBody ~= nil and loopBody.stats or {}) do
                    local actual = statement
                    while actual ~= nil and actual.kind == "pragmaStmt" do
                        actual = actual.stat
                    end
                    if actual ~= nil and actual.kind == "fornumStmt" and actual.simdRequired == true then
                        simdLoop(actual, true)
                    elseif statement.kind == "callStmt"
                        and statement.expr ~= nil
                        and statement.expr.kind == "methodCall"
                    then
                        use(statement.expr as cst.MethodCall, region, true)
                        for _, argument in ipairs((
                            statement.expr as cst.MethodCall
                        ).args ~= nil and (((statement.expr as cst.MethodCall).args as cst.Args).exprs or {}) or {}) do
                            scan(argument, region, false)
                        end
                    else
                        scan(statement, region, false)
                    end
                end
            end

            for _, statement in ipairs(body and body.stats or {}) do
                local actual = statement
                while actual ~= nil and actual.kind == "pragmaStmt" do
                    actual = actual.stat
                end
                if actual ~= nil and actual.kind == "localStmt" then
                    local local_ = actual as cst.LocalStmt
                    local names, expressions = local_.names or {}, local_.exprs or {}
                    if #names == 1 and #expressions == 1 then
                        local order, contribution = constructor(expressions[1])
                        if order ~= nil then
                            local identity = (names[1] as any).definition or names[1]
                            local state_ = {
                                identity = identity,
                                source = names[1],
                                contribution = contribution,
                                contributions = 0,
                                finalized = false,
                            }
                            states[identity] = state_
                            ordered[#ordered + 1] = state_
                        else
                            local copied = localIdentity(expressions[1])
                            if copied ~= nil and states[copied] ~= nil then
                                diagnose(actual, "a reducer cannot be copied or passed through another value")
                            end
                        end
                    end
                    scan(actual, nil, false)
                elseif actual ~= nil and actual.kind == "fornumStmt" and actual.simdRequired == true then
                    simdLoop(actual, false)
                else
                    scan(actual, nil, false)
                end
            end

            for _, state_ in ipairs(ordered) do
                if state_.region == nil then
                    diagnose(
                        state_.source,
                        "a reducer belongs to exactly one @simd loop and must receive one contribution"
                    )
                elseif not state_.finalized then
                    diagnose(state_.source, "a reducer is finalized exactly once after its @simd loop")
                end
            end
        end

        local walk: function(any, boolean?): nil
        walk = function(current: any, inWorkgroup: boolean?): nil
            if current == nil or cst.isToken(current) then
                return
            end
            local kind = (current as Node).kind
            if kind == "call" then
                local call = current as cst.Call
                local callee = call.obj
                local exact = exactCall(call)
                local selected = c.env.config and c.env.config._target or nil
                if selected ~= nil and selected.aot == "off" and exact ~= nil and c.opts.dialect ~= "lua51" then
                    if exact.identity == "nupp.simd.preferredU8" then
                        c.diag(
                            "NUPP2903",
                            callee or current,
                            "simd.preferredU8 creates an AOT-only value and cannot run with aot=off; "
                            .. "select aot=emit-c or aot=require"
                        )
                    elseif exact.identity == "nupp.simd.species" then
                        c.diag(
                            "NUPP2903",
                            callee or current,
                            "simd.species creates an AOT-only value and cannot run with aot=off; "
                            .. "select aot=emit-c or aot=require, or ask simd.trySpecies, "
                            .. "which answers nil where there are no vectors"
                        )
                    end
                end
                if exact ~= nil and exact.identity == "nupp.gpu.workgroups" then
                    walk(callee, false)
                    local args = call.args ~= nil and ((call.args as cst.Args).exprs or {}) or {}
                    walk(args[1], false)
                    walk(args[2], false)
                    local callback = args[3]
                    if callback ~= nil and callback.kind == "funcExpr" then
                        walk((callback as cst.FuncExpr).body, true)
                    else
                        walk(callback, false)
                    end
                    return
                end
            elseif kind == "methodCall" and inWorkgroup == true then
                local call = current as cst.MethodCall
                if call.name ~= nil and call.name.text == "run" then
                    walk(call.obj, true)
                    local args = call.args ~= nil and ((call.args as cst.Args).exprs or {}) or {}
                    local callback = args[1]
                    if callback ~= nil and callback.kind == "funcExpr" then
                        walk((callback as cst.FuncExpr).body, true)
                    else
                        walk(callback, true)
                    end
                    return
                end
            end
            if kind and DECLINED[kind] then
                decline(current as Node, kind)

                return
            end
            for _, child in ipairs(current as {any}) do
                walk(child, inWorkgroup)
            end
        end

        reducers()
        walk(node, false)
    end

    return ops
end

export = aot
