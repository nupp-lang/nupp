module nupp.compiler.check.narrow

--[[
What a condition proves, and where it holds.

Testing a value says something about it, and that something holds until the scope
it was proved in closes or the value is written to. Reading the condition is
this; computing the residue is `nupp.compiler.narrowing`, which needs only the types. The
two are separate because only this half needs to know where the walk currently
is.

A reference is narrowable when it has a key: a plain name, or a chain of field
accesses rooted at one. Anything computed has no key, since the checker cannot
tell two evaluations of it apart.
]]

local T = require("nupp.compiler.types")
local relations = require("nupp.compiler.relations")
local narrowing = require("nupp.compiler.narrowing")
local mutation = require("nupp.compiler.check.mutation")
local cst = require("nupp.compiler.cst")
local lexer = require("nupp.compiler.lexer")
local state = require("nupp.compiler.check.state")

local narrow = {}

local isA = relations.isA
local subtract = narrowing.subtract
local truthiness = narrowing.truthiness
local withoutMember = narrowing.withoutMember

--- What each name `type` can answer classifies a value as. A name with no entry,
--- such as "function", proves nothing a type could spell honestly and is left alone.
local LUA_TYPE_NAMES: {
    [string]: Type
} = {
    ["nil"] = T.nil_,
    boolean = T.boolean,
    number = T.number,
    string = T.string,
    table = T.table_,
    thread = T.thread,
    userdata = T.userdata,
    cdata = T.cdata,
}

--- A type, as nupp.compiler.types builds them.
local type Type = T.Type

--- A node of the tree being checked.
local type Node = cst.Node

--- What a condition proves, on each side of it. `t` holds where the condition is true
--- and `f` where it is false, each keyed by the reference it speaks about; `exhausted`
--- names a subject a comparison chain has now covered completely.
type narrow.Facts = {
    t: {[string]: Type},
    f: {[string]: Type},
    exhausted: string?
}

--- What the walk and the statement families ask narrowing. Four of these are promoted
--- onto the run, since every family applies facts; the rest are reached through
--- `c.facts` by the ones that branch, join, or invalidate what was proved.
--- What one call was found to write: whole references, everything beneath a
--- reference, and captured bindings.
type narrow.Cleared = {
    whole: {[string]: boolean},
    below: {[string]: boolean},
    entries: {[any]: boolean}
}

type narrow.Ops = {
    --- One map holding everything two maps held, the second winning a collision.
    mergeFacts: function(a: {[string]: Type}, b: {[string]: Type}): {[string]: Type},

    --- The key narrowing tracks a reference under, or nil when it has none.
    pathKey: function(node: Node): string?,

    --- What narrowing currently knows about a reference.
    lookupNarrowed: function(key: string): Type?,

    --- Forgets what was known about a reference and anything under it.
    clearNarrowed: function(key: string),

    --- Forgets facts beneath a reference while preserving the reference itself.
    clearNarrowedBelow: function(key: string),

    --- Forgets that a copy still speaks for what it was copied from.
    clearAliases: function(key: string),

    --- Forgets the copies of what lies beneath a reference, keeping copies of the
    --- reference itself: a write beneath it changes the one table they all name.
    clearAliasesBelow: function(key: string),

    --- Resolves a field path through a copied table reference.
    aliasTarget: function(key: string): string?,

    --- Forgets facts an arbitrary call may have invalidated through aliases or
    --- captured variables. Returns what it forgot, so a condition that made the
    --- call can be kept from proving it again.
    invalidateForCall: function(): narrow.Cleared?,

    --- The facts of a map minus those a call in the same expression forgot.
    withoutCleared: function(map: {[string]: Type}, cleared: narrow.Cleared?): {[string]: Type},

    --- Forgets what was known about a reference that was written, whole or beneath,
    --- and about every copy that spoke for it.
    clearWrite: function(key: string, belowOnly: boolean?),

    --- Forgets what a block would write before it runs again: at a loop entry, or at
    --- a label a later `goto` jumps back to.
    forgetWritten: function(block: Node?),

    --- What the functions of this file may write, read from the source once.
    summaries: function(): mutation.Summaries,

    --- What a condition proves, on each side of it.
    analyzeCond: function(cond: Node): narrow.Facts,

    --- What a discriminant test says about the value the field belongs to.
    discriminantBase: function(refNode: Node, literals: {Type}): (string?, Type?, Type?),

    --- Everything narrowing knows here, flattened innermost-first, which is what a
    --- branch leaves behind for the join.
    snapshotNarrowed: function(): {[string]: Type},

    --- Applies a narrowing map inside the current scope.
    applyFacts: function(facts: {[string]: Type})
}

--- Narrows every name bound from one correlated pack to what the surviving
--- `arms` hold at its slot: the names the group binds, and the copies made of them.
local function correlateGroup(into: {[string]: Type}, arms: {T.Pack}, group: any): nil
    for index, sibling in pairs(group.names) do
        local members = {}
        for _, arm in ipairs(arms) do
            members[#members + 1] = T.packAt(arm, index) or T.nil_
        end
        if #members > 0 then
            into[sibling] = T.union(members)
        end
    end
    for _, copy in ipairs(group.extraNames or {}) do
        local members = {}
        for _, arm in ipairs(arms) do
            members[#members + 1] = T.packAt(arm, copy.index) or T.nil_
        end
        if #members > 0 then
            into[copy.name] = T.union(members)
        end
    end
end

--- Installs the narrowing on one run.
---
--- @param c the run's state
--- @return the operations the walk calls
function narrow.install(c: state.Checker): narrow.Ops
    local facts = {}

    function facts.mergeFacts(a, b)
        local out = {}
        for k, v in pairs(a) do
            out[k] = v
        end
        for k, v in pairs(b) do
            out[k] = v
        end

        return out
    end

    -- Analyzes a condition into narrowing maps {name -> type} for the branch where it
    -- is truthy (.t) and where it is falsy (.f). v0 narrows plain variable names only
    -- (no paths).

    --- The key narrowing tracks a reference under: a name, or a chain of field accesses
    --- rooted at one. Anything computed has no key.
    function facts.pathKey(node: Node): string?
        if node.kind == "name" then
            return node.token and node.token.text or nil
        end
        if node.kind == "dotIndex" then
            local base = facts.pathKey(node.obj)
            if base and node.name then
                return base .. "." .. node.name.text
            end
        end

        return nil
    end

    --- Splits `function a.b.c:m` into the key naming its owner and the token naming the
    --- member. A method takes the whole dotted path as the owner; a plain function
    --- gives up its last segment to the member. The key matches how a qualified
    --- declaration binds, so `function types.Prim:m` finds the record declared as
    --- `record types.Prim`.
    c.funcOwner = function(fname: cst.Funcname): string?, lexer.Token?
        local names = {}
        for _, child in ipairs(fname) do
            if cst.isToken(child) and child.kind == "name" then
                names[#names + 1] = child
            end
        end
        if fname.method then
            -- the method token is in the array part too, and is not the owner
            table.remove(names)
            if #names == 0 then
                return nil, nil
            end
            local parts = {}
            for j, tok in ipairs(names) do
                parts[j] = tok.text
            end
            return table.concat(parts, "."), fname.method
        end
        if #names < 2 then
            return nil, nil
        end
        local member = table.remove(names)
        local parts = {}
        for j, tok in ipairs(names) do
            parts[j] = tok.text
        end

        return table.concat(parts, "."), member
    end

    -- The type a reference currently holds: what narrowing knows, else the declared or
    -- inferred type reached through its base.

    --- What narrowing currently knows about a reference.
    function facts.lookupNarrowed(key: string): Type?
        local sc = c.scope
        while sc do
            local t = sc.narrowed and sc.narrowed[key]
            if t then
                return t
            end
            sc = sc.parent
        end

        return nil
    end

    -- Assigning through a reference invalidates what was known about it and anything
    -- reached through it.

    --- Forgets what was known about a reference and anything under it.
    function facts.clearNarrowed(key: string)
        local sc = c.scope
        while sc do
            if sc.narrowed then
                for k in pairs(sc.narrowed) do
                    if k == key or k:sub(1, #key + 1) == key .. "." then
                        sc.narrowed[k] = nil
                    end
                end
            end
            sc = sc.parent
        end
    end

    function facts.clearNarrowedBelow(key)
        local sc = c.scope
        while sc do
            if sc.narrowed then
                for k in pairs(sc.narrowed) do
                    if k:sub(1, #key + 1) == key .. "." then
                        sc.narrowed[k] = nil
                    end
                end
            end
            sc = sc.parent
        end
    end

    c.refType = function(node)
        if not node then
            return nil
        end
        local key = facts.pathKey(node)
        if key then
            local narrowed = facts.lookupNarrowed(key)
            if narrowed then
                return narrowed
            end
        end
        if node.kind == "name" then
            return c.lookupVar(node.token.text)
        end
        if node.kind == "dotIndex" then
            local baseT = c.refType(node.obj)
            if baseT then
                return c.fieldType(baseT, node.name.text)
            end
        end

        return nil
    end

    -- Assigning to a name, or to anything a copied discriminant came from, makes the
    -- copy say nothing about it any more.
    function facts.clearAliases(key)
        local sc = c.scope
        while sc do
            for name, entry in pairs(sc.vars) do
                local from = entry.aliasPath
                if name == key or (from and (from == key or from:sub(1, #key + 1) == key .. ".")) then
                    entry.aliasNode, entry.aliasPath = nil, nil
                end
            end
            sc = sc.parent
        end
    end

    -- A copy of a copy speaks for the original too, so the path is followed as
    -- far as it goes.
    function facts.clearAliasesBelow(key)
        local sc = c.scope
        while sc do
            for _, entry in pairs(sc.vars) do
                local from = entry.aliasPath
                if from and from:sub(1, #key + 1) == key .. "." then
                    entry.aliasNode, entry.aliasPath = nil, nil
                end
            end
            sc = sc.parent
        end
    end

    function facts.aliasTarget(key)
        local resolved = nil
        local seen = {}
        local current = key
        while true do
            local root, suffix = current:match("^([^.]+)(.*)$")
            local entry = root and not seen[root] and c.lookupEntry(root) or nil
            if not (entry and entry.aliasPath) then
                break
            end
            seen[root] = true
            current = entry.aliasPath .. suffix
            resolved = current
        end

        return resolved
    end

    -- Every visible copy that speaks for something above the written path, with
    -- the spelling the path has through that copy: writing `x.f` reaches `y.f`
    -- when `y` was copied from `x`, because the two are one table. A copy of the
    -- written path itself, or of something beneath it, is left alone: it holds
    -- what it held, whatever the original now holds, and only stops speaking for
    -- it.
    local function copiesOf(key: string): {{
        name: string,
        path: string
    }}
        local out = {}
        local canonical = facts.aliasTarget(key) or key
        local sc = c.scope
        local seen = {}
        while sc do
            for name, entry in pairs(sc.vars) do
                if entry.aliasPath and not seen[name] then
                    seen[name] = true
                    local origin = facts.aliasTarget(name) or entry.aliasPath
                    if canonical:sub(1, #origin + 1) == origin .. "." then
                        out[#out + 1] = {name = name, path = name .. canonical:sub(#origin + 1)}
                    end
                end
            end
            sc = sc.parent
        end

        return out
    end

    -- A plain name is narrowed by a shadow entry rather than a map entry, so
    -- forgetting it means putting every shadow back to what was declared.
    local function clearNameNarrowing(name: string)
        local sc = c.scope
        while sc do
            local entry = sc.vars[name]
            if entry and entry.narrowing then
                entry.t = entry.decl or entry.t
                entry.narrowing = false
            end
            sc = sc.parent
        end
    end

    function facts.clearWrite(key, belowOnly)
        local targets = {key}
        local aliased = facts.aliasTarget(key)
        if aliased then
            targets[#targets + 1] = aliased
        end
        for _, copy in ipairs(copiesOf(key)) do
            targets[#targets + 1] = copy.path
        end
        for _, target in ipairs(targets) do
            if belowOnly then
                facts.clearNarrowedBelow(target)
            else
                facts.clearNarrowed(target)
                if not target:find(".", 1, true) then
                    clearNameNarrowing(target)
                end
            end
        end
    end

    local summaries: mutation.Summaries? = nil
    function facts.summaries()
        if not summaries then
            summaries = mutation.prescan(c.result and c.result.root or nil)
        end

        return summaries as mutation.Summaries
    end

    function facts.forgetWritten(block)
        if not block then
            return
        end
        local whole, below = mutation.writtenRoots(facts.summaries(), block)
        for key in pairs(whole) do
            if c.lookupEntry(key:match("^[^.]+") or key) then
                facts.clearWrite(key)
                facts.clearAliases(key)
            end
        end
        for key in pairs(below) do
            if not whole[key] and c.lookupEntry(key:match("^[^.]+") or key) then
                facts.clearWrite(key, true)
                facts.clearAliasesBelow(key)
            end
        end
    end

    function facts.invalidateForCall()
        local cleared: narrow.Cleared = {whole = {}, below = {}, entries = {}}
        for key in pairs(c.callMutationRoots or {}) do
            cleared.below[key] = true
            facts.clearWrite(key, true)
            -- A copy of something beneath no longer speaks for it, nor does a
            -- copy of anything beneath one of its own copies.
            facts.clearAliasesBelow(key)
            for _, copy in ipairs(copiesOf(key)) do
                facts.clearAliasesBelow(copy.name)
            end
        end
        c.callMutationRoots = nil
        for key in pairs(c.callMutatedNames or {}) do
            if c.lookupEntry(key:match("^[^.]+") or key) then
                cleared.whole[key] = true
                facts.clearWrite(key)
                facts.clearAliases(key)
            end
        end
        c.callMutatedNames = nil
        for mutated in pairs(c.callMutatedEntries or {}) do
            cleared.entries[mutated] = true
            if mutated.definition then
                cleared.entries[mutated.definition] = true
            end
            local sc = c.scope
            while sc do
                for _, entry in pairs(sc.vars) do
                    if entry == mutated or (mutated.definition and entry.definition == mutated.definition) then
                        if entry.narrowing then
                            entry.t = entry.decl
                            entry.narrowing = false
                        end
                    end
                end
                sc = sc.parent
            end
        end
        c.callMutatedEntries = nil

        return cleared
    end

    -- A condition that both tests a reference and calls something that writes it
    -- proves nothing about it: the write may come after the test.
    function facts.withoutCleared(map, cleared)
        if not cleared or not next(cleared.whole) and not next(cleared.below) and not next(cleared.entries) then
            return map
        end
        local out = {}
        for key, t in pairs(map) do
            local plain = key:match("^@coroutine:(.+)$") or key
            local keep = true
            for whole in pairs(cleared.whole) do
                if plain == whole or plain:sub(1, #whole + 1) == whole .. "." then
                    keep = false
                end
            end
            for below in pairs(cleared.below) do
                if plain:sub(1, #below + 1) == below .. "." then
                    keep = false
                end
            end
            local entry = c.lookupEntry(plain:match("^[^.]+") or plain)
            if entry and (cleared.entries[entry] or entry.definition and cleared.entries[entry.definition]) then
                keep = false
            end
            if keep then
                out[key] = t
            end
        end

        return out
    end

    --- What a test of a discriminant field says about the value it belongs to:
    --- `s.kind == "circle"` keeps the members of `s` whose `kind` admits the literal
    --- and drops the rest. A copied discriminant (`local kind = s.kind`) tests the
    --- field it was copied from. Nothing is said unless both sides are inhabited.
    ---
    --- @param refNode the tested reference: a field path, or a name copied from one
    --- @param literals the values the test admits
    --- @return the key of the base, what it holds where the test passed, and where it
    ---     failed
    function facts.discriminantBase(refNode: Node, literals: {Type}): string?, Type?, Type?
        local discNode: any = refNode.kind == "dotIndex" and refNode or nil
        if refNode.kind == "name" and refNode.token then
            local entry = c.lookupEntry(refNode.token.text)
            discNode = entry and entry.aliasNode or nil
        end
        if not discNode or discNode.kind ~= "dotIndex" or not discNode.obj or not discNode.name then
            return nil, nil, nil
        end
        local baseKey = facts.pathKey(discNode.obj)
        local baseT = c.refType(discNode.obj)
        if not baseKey or not baseT or baseT.tag ~= "union" then
            return nil, nil, nil
        end
        local kept, dropped = {}, {}
        for _, m in ipairs(baseT.members) do
            local ft = c.fieldType(m, discNode.name.text)
            local admits = false
            for _, litT in ipairs(literals) do
                if ft and isA(litT, ft) then
                    admits = true
                    break
                end
            end
            if admits then
                kept[#kept + 1] = m
            else
                dropped[#dropped + 1] = m
            end
        end
        if #kept == 0 or #dropped == 0 then
            return nil, nil, nil
        end

        return baseKey, T.union(kept), T.union(dropped)
    end

    --- What testing `cond` proves, on each side of the test.
    function facts.analyzeCond(cond: Node): narrow.Facts
        local none = {t = {}, f = {}}
        local kind = cond.kind
        if kind == "paren" then
            return facts.analyzeCond(cond.expr)
        elseif kind == "name" then
            local name = cond.token and cond.token.text or ""
            local vt = c.lookupVar(name)
            if vt then
                local out = {t = {}, f = {}}
                local truthy, falsy = truthiness(vt)
                if truthy then
                    out.t[name] = truthy
                end
                if falsy then
                    out.f[name] = falsy
                end
                local entry = c.lookupEntry(name)
                local group = entry and entry.packCorrelation
                local at = entry and entry.packCorrelationIndex
                if group and at then
                    local trueArms, falseArms = {}, {}
                    for _, arm in ipairs(group.pack.alternatives or {}) do
                        local value = T.packAt(arm, at) or T.nil_
                        local armTrue, armFalse = truthiness(value)
                        if armTrue then
                            trueArms[#trueArms + 1] = arm
                        end
                        if armFalse then
                            falseArms[#falseArms + 1] = arm
                        end
                    end
                    correlateGroup(out.t, trueArms, group)
                    correlateGroup(out.f, falseArms, group)
                end
                return out
            end
            return none
        elseif kind == "dotIndex" then
            -- Truthiness of a field path, the same fact a plain name gives: `if r.xs
            -- and #r.xs > 0` has to see a non-nil r.xs in the body.
            local key = facts.pathKey(cond)
            local vt = key and c.refType(cond)
            if key and vt then
                local out = {t = {}, f = {}}
                local truthy, falsy = truthiness(vt)
                if truthy then
                    out.t[key] = truthy
                end
                if falsy then
                    out.f[key] = falsy
                end
                return out
            end
            return none
        elseif kind == "call" then
            local argsNode = cond.args
            local args = argsNode and argsNode.kind == "args" and argsNode.exprs or {}
            -- `ffi.istype<T>(v)` is a type test spelled as a call
            local callee = cond.obj
            if callee and callee.kind == "dotIndex" then
                local typeArg = callee.ffiTypeArg
                local member = callee.name
                if typeArg and member and member.text == "istype" then
                    local first = args[1]
                    local key = first and facts.pathKey(first)
                    local target = cond.typeTestTarget as Type?
                    if key and first and target then
                        local vt = c.refType(first)
                        local out = {t = {}, f = {}}
                        out.t[key] = target
                        if vt then
                            out.f[key] = subtract(vt, target)
                        end
                        return out
                    end
                    return none
                end
            end
            -- calling a predicate is the same fact as writing `arg is T`, which is what
            -- lets the test live behind a named function. The call handler already
            -- ran on this condition and recorded the callee's type.
            local ft = cond.calleeType as Type?
            local predicate = ft and ft.tag == "func" and ft.predicate or nil
            if predicate then
                local arg = args[predicate.param]
                local key = arg and facts.pathKey(arg)
                if key and arg then
                    local vt = c.refType(arg)
                    local out = {t = {}, f = {}}
                    out.t[key] = predicate.type
                    if vt then
                        out.f[key] = subtract(vt, predicate.type)
                    end
                    return out
                end
            end
            return none
        elseif kind == "isExpr" then
            local key = cond.expr and facts.pathKey(cond.expr)
            -- resolved once by the `is` handler, which ran before this did
            local target = cond.typeTestTarget as Type?
            if key and target then
                local vt = c.refType(cond.expr)
                local out = {t = {}, f = {}}
                out.t[key] = target
                if vt then
                    out.f[key] = subtract(vt, target)
                end
                return out
            end
            return none
        elseif kind == "unop" and cond.op and cond.op.kind == "not" and cond.operand then
            local inner = facts.analyzeCond(cond.operand)
            return {t = inner.f, f = inner.t}
        elseif kind == "binop" then
            local opTok, lhs, rhs = cond.op, cond.lhs, cond.rhs
            if not opTok or not lhs or not rhs then
                return none
            end
            local op = opTok.kind
            if op == "==" or op == "~=" then
                -- x == nil / x ~= nil (either operand order)
                local nameNode, nilNode
                if rhs.kind == "nilExpr" then
                    nameNode, nilNode = lhs, rhs
                elseif lhs.kind == "nilExpr" then
                    nameNode, nilNode = rhs, lhs
                end
                if nilNode then
                    local key = facts.pathKey(nameNode)
                    local vt = key and c.refType(nameNode)
                    if key and vt then
                        local eqNil = {[key] = T.nil_}
                        local neNil = {[key] = subtract(vt, T.nil_)}
                        if op == "==" then
                            return {t = eqNil, f = neNil}
                        else
                            return {t = neNil, f = eqNil}
                        end
                    end
                    return none
                end
                -- `type(u) == "table"` on an `unknown` proves what the name says, in
                -- the branch the test holds in. `type` answers from a closed set, so
                -- the name is the value's whole classification; and `unknown` claimed
                -- nothing, so the one fact is the one the test adds and the other
                -- branch goes on claiming nothing. Only `unknown`: `any` is gradual
                -- and a declared type is what `is` narrows.
                local typeCall = lhs.kind == "call" and lhs or rhs.kind == "call" and rhs or nil
                local typeName = typeCall == lhs and rhs or lhs
                if typeCall and typeName and typeName.kind == "string" then
                    local typeCallee = typeCall.obj
                    local typeTok = typeCallee and typeCallee.kind == "name" and typeCallee.token or nil
                    local typeGlobal = c.env and c.env.globals and c.env.globals.type or nil
                    local typeEntry = typeTok and typeTok.text == "type" and c.lookupEntry("type") or nil
                    local typeArgs = typeCall.args
                    local subjects = typeArgs and typeArgs.kind == "args" and typeArgs.exprs or {}
                    local subject = #subjects == 1 and subjects[1] or nil
                    local subjectKey = subject and facts.pathKey(subject) or nil
                    if subjectKey
                        and subject
                        and typeGlobal
                        and typeEntry
                        and typeGlobal.definition == typeEntry.definition
                    then
                        local named = c.infer(typeName)
                        local proves = named.tag == "literal" and LUA_TYPE_NAMES[tostring(named.constant)] or nil
                        if proves and c.refType(subject) == T.unknown then
                            local proven = {[subjectKey] = proves}
                            if op == "==" then
                                return {t = proven, f = {}}
                            end
                            return {t = {}, f = proven}
                        end
                    end
                end
                -- Discriminant: `v.tag == "circle"` narrows the field to that value
                -- and, when the base is a union, keeps only the members whose field
                -- could hold it.
                local refNode, litNode
                if rhs.kind == "string"
                    or rhs.kind == "number"
                    or rhs.kind == "trueExpr"
                    or rhs.kind == "falseExpr"
                then
                    refNode, litNode = lhs, rhs
                elseif lhs.kind == "string"
                    or lhs.kind == "number"
                    or lhs.kind == "trueExpr"
                    or lhs.kind == "falseExpr"
                then
                    refNode, litNode = rhs, lhs
                end
                -- a test on a copied discriminant is a test on the field it was copied
                -- from, so narrow through to the original
                local aliasNode
                if refNode and refNode.kind == "name" then
                    local refTok = refNode.token
                    local e = refTok and c.lookupEntry(refTok.text)
                    aliasNode = e and e.aliasNode or nil
                end
                local key = refNode and facts.pathKey(refNode)
                if key then
                    local litT = c.infer(litNode)
                    local out = {t = {}, f = {}}
                    if aliasNode then
                        local aliasKey = facts.pathKey(aliasNode)
                        if aliasKey then
                            out.t[aliasKey] = litT
                            local aliasT = c.refType(aliasNode)
                            local rest = aliasT and withoutMember(aliasT, litT) or nil
                            if rest then
                                out.f[aliasKey] = rest
                            end
                        end
                    end
                    out.t[key] = litT
                    if refNode.kind == "name" and refNode.token then
                        local entry = c.lookupEntry(refNode.token.text)
                        if entry and entry.coroutineStatusName and litT.tag == "literal" and type(
                            litT.constant
                        ) == "string" then
                            out.t["@coroutine:" .. entry.coroutineStatusName] = litT
                        end
                        local group = entry and entry.packCorrelation
                        local slot = entry and entry.packCorrelationIndex
                        if group and slot then
                            local selected, rejected = {}, {}
                            for _, arm in ipairs(group.pack.alternatives or {}) do
                                local armType = T.packAt(arm, slot) or T.nil_
                                if isA(litT, armType) then
                                    selected[#selected + 1] = arm
                                else
                                    rejected[#rejected + 1] = arm
                                end
                            end
                            correlateGroup(out.t, selected, group)
                            correlateGroup(out.f, rejected, group)
                        end
                    end
                    -- what the value can still hold once this member is ruled out
                    local refT = c.refType(refNode)
                    local rest, emptied = withoutMember(refT, litT)
                    if rest then
                        out.f[key] = rest
                    elseif emptied then
                        out.exhausted = key
                    end
                    local baseKey, kept, dropped = facts.discriminantBase(refNode, {litT})
                    if baseKey and kept and dropped then
                        out.t[baseKey] = kept
                        out.f[baseKey] = dropped
                    end
                    if op == "~=" then
                        return {t = out.f, f = out.t}
                    end
                    return out
                end
                return none
            elseif op == "and" then
                -- The second conjunct is only reached when the first held, so it is
                -- analyzed knowing that: `a and b and f(a, b)` passes what `a and b`
                -- proved into the call that uses them.
                local l = facts.analyzeCond(lhs)
                c.pushScope()
                facts.applyFacts(l.t)
                local r = facts.analyzeCond(rhs)
                c.popScope()
                -- both truthy in the then-branch; falsy side is unknowable (v0)
                return {t = facts.mergeFacts(l.t, r.t), f = {}}
            elseif op == "or" then
                -- and the second disjunct is only reached when the first did not hold,
                -- which is the other side of the same fact
                local l = facts.analyzeCond(lhs)
                c.pushScope()
                facts.applyFacts(l.f)
                local r = facts.analyzeCond(rhs)
                c.popScope()
                -- Either side may be the one that held, so the truthy side knows only
                -- what both sides agree on: the union of what each proves, for a
                -- reference both speak about. A key only one side mentions could be
                -- anything on the other.
                local t = {}
                for key, lt in pairs(l.t) do
                    local rt = r.t[key]
                    if rt then
                        t[key] = T.union({lt, rt})
                    end
                end
                -- Both are falsy in the else-branch, so what is left there is what both
                -- sides left: the members they have in common.
                local fal = facts.mergeFacts(l.f, r.f)
                for key, lf in pairs(l.f) do
                    local rf = r.f[key]
                    if rf then
                        local keep, seen = {}, {}
                        for _, m in ipairs(lf.tag == "union" and lf.members or {lf}) do
                            seen[m] = true
                        end
                        for _, m in ipairs(rf.tag == "union" and rf.members or {rf}) do
                            if seen[m] then
                                keep[#keep + 1] = m
                            end
                        end
                        if #keep > 0 then
                            fal[key] = T.union(keep)
                        end
                    end
                end
                return {t = t, f = fal}
            end
            return none
        end

        return none
    end

    -- Everything narrowing knows at this point, flattened innermost-first. Taken at the
    -- end of a branch it is what that path leaves behind.
    function facts.snapshotNarrowed(): {[string]: Type}
        local out, blocked = {}, {}
        local sc = c.scope
        while sc do
            if sc.narrowed then
                for k, v in pairs(sc.narrowed) do
                    if out[k] == nil and not blocked[k] then
                        out[k] = v
                    end
                end
            end
            for k, entry in pairs(sc.vars) do
                if out[k] == nil and not blocked[k] then
                    if entry.narrowing then
                        out[k] = entry.t
                    else
                        -- a real declaration: it shadows whatever an outer scope knew
                        -- about that name, narrowing included
                        blocked[k] = true
                    end
                end
            end
            sc = sc.parent
        end

        return out
    end

    -- Narrowing a value's type does not unestablish it. A shadow entry that
    -- dropped these facts would make every fixed-width local lose its refinement
    -- the first time anything narrowed it -- including the narrowing an ordinary
    -- assignment performs -- so `x = nupp.math.f32.narrow(v)` would leave `x`
    -- unusable as a `float` on the next line.
    local function carryFixedWidth(shadow: any, entry: any): any
        local established = entry and entry.fixedWidthEstablished or nil
        if established then
            local copied = {}
            for fact in pairs(established) do
                copied[fact] = true
            end
            shadow.fixedWidthEstablished = copied
        end
        shadow.fixedWidthTrusted = entry and entry.fixedWidthTrusted or nil
        shadow.fixedWidthCallableUntrusted = entry and entry.fixedWidthCallableUntrusted or nil

        return shadow
    end

    -- Applies a narrowing map inside the CURRENT scope (callers push/pop). Narrowed
    -- entries remember the declared type (`decl`) so assignments keep checking against
    -- the declaration, not the narrowing. A narrowable reference: a plain name, or a
    -- chain of field accesses rooted at one ("cfg.server.port"). Anything computed is
    -- not tracked, since the checker cannot tell two evaluations apart.
    function facts.applyFacts(facts: {[string]: Type})
        for name, t in pairs(facts) do
            local coroutineName = name:match("^@coroutine:(.+)$")
            if coroutineName then
                local entry = c.lookupEntry(coroutineName)
                if entry then
                    local phase = t.tag == "literal" and t.constant == "dead" and "dead" or entry.threadPhase
                    c.scope.vars[
                        coroutineName
                    ] = carryFixedWidth(
                        {
                            t = entry.t,
                            narrowing = true,
                            ann = entry.ann or false,
                            constant = entry.constant or false,
                            decl = entry.decl or entry.t,
                            definition = entry.definition,
                            ownership = entry.ownership,
                            moved = c.ownershipState(entry).moved or false,
                            ownershipOrigin = c.ownershipState(entry),
                            functionDepth = entry.functionDepth or c.functionDepth,
                            threadPhase = phase,
                        },
                        entry
                    )
                end
            elseif name:find(".", 1, true) then
                c.scope.narrowed = c.scope.narrowed or {}
                c.scope.narrowed[name] = t
            else
                local entry = c.lookupEntry(name)
                local conditionalOwnership = entry and entry.packCorrelation and c.ownershipKind(t) or nil
                local moved = entry and c.ownershipState(entry).moved or false
                local ownershipOrigin = entry and c.ownershipState(entry) or nil
                if conditionalOwnership then
                    moved, ownershipOrigin = false, nil
                end
                c.scope.vars[name] = carryFixedWidth(
                    {
                        t = t,
                        narrowing = true, -- shadows a declaration; not one itself
                        -- a narrowed copy still came from where it came from, or the
                        -- second arm of a chain would forget
                        aliasNode = entry and entry.aliasNode or nil,
                        aliasPath = entry and entry.aliasPath or nil,
                        ann = entry and entry.ann or false,
                        constant = entry and entry.constant or false,
                        decl = entry and (entry.decl or entry.t) or t,
                        definition = entry and entry.definition or nil,
                        -- A correlated result can carry an owner on only one arm
                        -- (pcall's success arm is the important case). It is not a live
                        -- obligation before the discriminator is selected. Once
                        -- narrowed into that arm this shadow is the owner for the
                        -- branch and is audited when the branch scope closes; other
                        -- narrowed values continue to share their declaration's
                        -- ordinary ownership state.
                        ownership = conditionalOwnership or entry and entry.ownership or nil,
                        moved = moved,
                        ownershipOrigin = ownershipOrigin,
                        automaticOwner = entry and entry.automaticOwner or nil,
                        functionDepth = entry and entry.functionDepth or c.functionDepth,
                        threadPhase = entry and entry.threadPhase or nil,
                        wrappedProtocol = entry and entry.wrappedProtocol or nil,
                        wrappedPhase = entry and entry.wrappedPhase or nil,
                    },
                    entry
                )
            end
        end
    end

    -- Also on the checker, so a pass in another module reaches them the same way the
    -- walk does.
    c.pathKey = facts.pathKey
    c.applyFacts = facts.applyFacts
    c.analyzeCond = facts.analyzeCond
    c.lookupNarrowed = facts.lookupNarrowed

    return facts
end

export = narrow
