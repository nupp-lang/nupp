--[[
The checker: the walk, and the run it happens in.

A gradual type checker over the CST. Anything unannotated or unresolvable is
`any` and checks silently, so an untyped LuaJIT program is a valid Nupp program
that reports nothing; annotations are what turn checking on, one declaration at
a time.

This module holds the run — the scopes, the diagnostics, the per-file state — and
the statement walk that drives everything else. The questions the walk asks are
answered next door: what an expression's type is by `expr`, what a call means by
`calls`, what a declaration introduces by `declare`, what a condition proves by
`narrow`, what an annotation says by `annotate`, and what has happened to an
owned value by `ownership`. Each of those is installed on the checker and reaches
the run through it.

Diagnostics carry stable `NUPP2xxx` codes; `docs/diagnostics.md` is the
reference for their shape and their families.
]]

local T = require("nupp.compiler.types")
local consteval = require("nupp.compiler.consteval")
local lints = require("nupp.compiler.lints")
local fixits = require("nupp.compiler.check.fixits")
local annotate = require("nupp.compiler.check.annotate")
local ownership = require("nupp.compiler.check.ownership")
local loopclosure = require("nupp.compiler.check.loopclosure")
local undocumentedraise = require("nupp.compiler.check.undocumentedraise")
local unused = require("nupp.compiler.check.unused")
local discard = require("nupp.compiler.check.discard")
local nosuspendMod = require("nupp.compiler.check.nosuspend")
local analysis = require("nupp.compiler.analysis")
local narrow = require("nupp.compiler.check.narrow")
local calls = require("nupp.compiler.check.calls")
local expr = require("nupp.compiler.check.expr")
local declare = require("nupp.compiler.check.declare")
local resolve = require("nupp.compiler.check.resolve")
local bindings = require("nupp.compiler.check.bindings")
local control = require("nupp.compiler.check.control")
local functions = require("nupp.compiler.check.functions")
local cdef = require("nupp.compiler.check.cdef")
local pragma = require("nupp.compiler.check.pragma")
local metatable = require("nupp.compiler.check.metatable")
local cst = require("nupp.compiler.cst")
local annotationMod = require("nupp.compiler.annotations")
local state = require("nupp.compiler.check.state")

local checkMod = {}

--- A type, as nupp.compiler.types builds them.
local type Type = T.Type

--- A node of the tree being checked.
local type Node = cst.Node

--- A node or a token: what a diagnostic can be pointed at.
local type Child = cst.Child

-- The run's own shape is declared in nupp.compiler.check.state, because a pass has to
-- name
-- it
-- and this file requires every pass. These keep the names a caller already had.

--- One thing to report about a file.
type checkMod.Diagnostic = state.Diagnostic

--- What a condition proves, on each side of it.
type checkMod.Facts = state.Facts

--- Everything one run of the checker carries. See nupp.compiler.check.state.
type checkMod.Checker = state.Checker

-- The type algebra and the generic machinery moved out of this file; the names the
-- checker calls them by are kept, since they read as vocabulary here.

-- The lint registry lives in nupp.compiler.lints, which `nupp lints` reads too. The
-- checker
-- keeps the re-exports so a caller that already had them still works.
checkMod.lints = lints.all
checkMod.lintCategories = lints.categories
checkMod.lintLevels = lints.levels
checkMod.lintOptIn = lints.optIn
checkMod.lintLevel = lints.level
checkMod.lintFor = lints.get

-- The closed reifiable field set: numerics, bool, structs by value, pointers, nullable
-- pointers. Everything GC-managed is out.
local REIFIABLE_PRIM = {
    number = true,
    float = true,
    boolean = true,
    integer = true,
    int8 = true,
    int16 = true,
    int32 = true,
    int64 = true,
    uint8 = true,
    uint16 = true,
    uint32 = true,
    uint64 = true,
}

--- Whether a field of this type can live in reified C memory.
local function reifiableField(t: Type, isCdef: boolean?): boolean
    if REIFIABLE_PRIM[t.tag] then
        return true
    end
    -- cstring/voidptr are legal in C-declared structs only: in a GC-managed struct a
    -- "const char *" field would dangle (no anchor)
    if isCdef and (t.tag == "cstring" or t.tag == "voidptr") then
        return true
    end
    if t.tag == "nominal" and t.declKind == "struct" then
        return true
    end
    -- A fixed C array, `T[N]`, is laid out inline: N elements, no indirection, and a
    -- size the struct can be told at compile time. `T[?]` is not -- a struct whose own
    -- size depends on a count nobody has written cannot be laid out at all -- which is
    -- the whole of the difference between the two here.
    if t.tag == "carray" and t.count then
        return reifiableField(t.elem, isCdef)
    end
    if t.tag == "ptr" then
        return true
    end
    if t.tag == "union" and #t.members == 2 and t.hasNil then
        local other = t.members[1] == T.nil_ and t.members[2] or t.members[1]
        -- any pointer-shaped type may be NULL, which is what the nullable spelling
        -- records
        if other.tag == "ptr" then
            return true
        end
        if isCdef and (other == T.voidptr or other == T.cstring) then
            return true
        end
        return false
    end

    return false
end

-- Checker state per run.
--
-- env (optional): { globals = {name -> entry}, globalTypes = {name -> type}, stringLib
-- = shape type for string-method calls, resolveModule = function(env, modname) -> type?
-- } — shared across files. opts may provide declareGlobals (prelude/declaration files),
-- moduleName, an annotation registry, and a seeded module export interface for
-- recursive project declarations.

--- Whether a file is held to the strict floor when nothing said otherwise.
---
--- The extension is the answer, so a file says what it wants where anyone reading it
--- will see it. `.g.nupp` asks for the gradual layer. A plain `.lua` file is plain Lua
--- and was never making a claim. A `.d.nupp` describes an interface somebody else
--- implements, and `any` is frequently the honest type there -- `string.buffer`'s
--- `encode(v: any): string` really does take any Lua value, and no annotation this
--- project writes changes what LuaJIT accepts. Everything else is ordinary Nupp.
--- `--strict` overrides all of it by passing the answer in.
function checkMod.strictByDefault(filename: string?): boolean
    if not filename then
        return true
    end
    return not (filename:match("%.g%.nupp$") or filename:match("%.d%.nupp$") or filename:match("%.lua$"))
end

--- Every node the typed layer is written with: the type productions themselves, the
--- declarations that introduce a type, and the cast that names one.
local TYPED_LAYER: {
    [string]: string
} = {
    recordDecl = "a type declaration",
    typeAlias = "a type alias",
    castExpr = "an `as` cast",
    tname = "a type annotation",
    tarray = "a type annotation",
    tmap = "a type annotation",
    tshape = "a type annotation",
    ttuple = "a type annotation",
    tunion = "a type annotation",
    tintersection = "a type annotation",
    topt = "a type annotation",
    tfunc = "a type annotation",
    tpack = "a type annotation",
    tparen = "a type annotation",
    tptr = "a type annotation",
    tcarray = "a type annotation",
    tconst = "a type annotation",
    tliteral = "a type annotation",
    tborrows = "a type annotation",
    tpreserves = "a type annotation",
    tpredicate = "a type annotation",
    ternary = "a type annotation",
}

--- Reports the typed layer wherever it appears in a plain Lua file.
---
--- A `.lua` file is Lua: this toolchain will require, build and run one, and that is
--- the whole promise. An annotation written there reads as a claim the file does not
--- make -- the extension already settled that it is checked gradually, so the
--- annotation governs nothing, and the next person to read it has to work out that it
--- never did. Better to say so where it was written.
---
--- Reported at the outermost node and not below it, so one annotation is one diagnostic
--- however deeply its type nests.
local function reportTypedLayer(c: state.Checker, node: any)
    if type(node) ~= "table" or cst.isToken(node) then
        return
    end
    local named = TYPED_LAYER[node.kind]
    if named then
        c.diag("NUPP1006", node, named .. " is not plain Lua")
        return
    end
    for _, child in ipairs(node) do
        reportTypedLayer(c, child)
    end
end

-- The funcbody a value expression is, if it is one written out here rather than named.
-- An alias -- `M.f = someLocal` -- deliberately answers nil: what it exports is a value
-- whose definition this does not follow, and a fact nobody established is may-yield.
local function bodyOf(value: cst.Node?): cst.Node?
    if not value or cst.isToken(value) then
        return nil
    end
    if value.kind == "funcbody" then
        return value
    end
    if value.kind == "funcExpr" or value.kind == "shortfn" then
        return value.body
    end

    return nil
end

-- Whether a declaration provably cannot suspend. Anything short of an answer leaves the
-- callable may-yield, the guarantee being a positive one.
--
-- A contract outranks inference. `external` and `top` mean *inference* learned nothing,
-- which is why they disqualify an inferred summary -- but an author who wrote
-- `@effects(external = true, yields = false)` has stated the fact that inference could
-- not reach, and NUPP2112 already holds a visible body to what its contract claims.
-- Treating a declared negative as unknown would make the contract unable to say the one
-- thing it exists to say.
local function provenNonYielding(node: cst.Node?, body: cst.Node?): boolean
    local contract = node and node.effectContract or body and body.effectContract
    if contract and contract.yields ~= nil then
        return contract.yields ~= true
    end
    local summary = body and body.effectSummary
    if not summary then
        return false
    end
    if summary.top == true or summary.external == true then
        return false
    end

    return summary.yields ~= true
end

-- Stamps a callable leaf with what its own definition proved.
--
-- Provenance-guided, and it has to be: two exports with identical signatures share one
-- interned type, so a walk of the module shape alone cannot tell `M.safe` from
-- `M.waits`. The value each field was assigned is carried alongside for exactly this
-- moment.
--
-- Descent stops at a callable. A function's parameters and results are other callables,
-- belonging to other definitions, and stamping them with this function's effect would
-- be asserting something about values this declaration never saw.
local function qualifyExport(t: Type?, value: cst.Node?): Type?
    if not t then
        return t
    end
    if t.tag == "func" then
        -- No local definition to consult means nothing was learned here, and nothing
        -- learned is not the same as a guarantee refuted. A re-export -- `M.safe =
        -- B.safe` -- arrives already qualified, and stamping it may-yield because this
        -- file has no body for it would destroy the fact rather than decline to add
        -- one. The effect travels with type identity; erasing it here is what would
        -- break that.
        local body = bodyOf(value)
        local contract = value and not cst.isToken(value) and value.effectContract or nil
        if not body and not contract then
            return t
        end

        return T.withYields(t, not provenNonYielding(value, body))
    end
    -- A table of callables is the other exported shape: `M.ops = {read = ..., ...}`.
    -- Each leaf is paired with the field that produced it, so each answers for itself.
    -- An indexer is left alone rather than reconstructed: `T.shape` takes one in a
    -- decomposed form this does not hold, and dropping it would widen the export.
    if t.tag == "shape" and t.indexReadKey == nil and t.indexWriteKey == nil and value and not cst.isToken(
        value
    ) and value.kind == "tableExpr" then
        local written: {[string]: cst.Node} = {}
        for _, field in ipairs(value.fields or {}) do
            if field.kind == "fieldNamed" and field.name and field.value then
                written[field.name.text] = field.value as cst.Node
            end
        end
        local fields = {}
        for _, field in ipairs(t.fields or {}) do
            local paired = written[field.name]
            fields[
                #fields + 1
            ] = {
                name = field.name,
                read = field.read and qualifyExport(field.read, paired) or nil,
                write = field.write and qualifyExport(field.write, paired) or nil,
                type = field.type and qualifyExport(field.type, paired) or nil,
            }
        end

        return T.shape(fields, nil, true)
    end

    return t
end

-- Rebuilds the module's boundary type once effects are known.
--
-- Effects are a fixed point over the call graph and are not available while a
-- function's
-- type is being interned, so the qualifier cannot be set where the type is minted. It
-- is
-- set here instead, on the returned surface only: nothing inside this module captured
-- the new identity, because everything inside it consults the analysis directly.
local function finalizeBoundary(c: state.Checker)
    if not c.moduleType then
        return
    end
    -- A module assembled one field at a time: each export answers from the value that
    -- was assigned to it, and the surface is rebuilt from the qualified fields.
    if c.moduleTypeFromFields then
        local fields = {}
        for name, ft in pairs(c.moduleFields) do
            local qualified = qualifyExport(ft, c.moduleFieldValues[name])
            c.moduleFields[name] = qualified as Type
            if c.moduleFieldConst[name] then
                fields[#fields + 1] = {name = name, read = qualified}
            else
                fields[#fields + 1] = {name = name, type = qualified}
            end
        end
        if #fields > 0 then
            c.moduleType = T.shape(fields)
        end
        return
    end
    -- Everything else a module can return: a function directly, or a table literal
    -- built in the `return` rather than filled in beforehand. `qualifyExport` walks
    -- both, and answers the type unchanged for a surface it cannot pair with a
    -- definition -- which is what leaves an annotated or nominal export alone.
    c.moduleType = qualifyExport(c.moduleType, c.moduleReturnValue) as Type
end

-- Returns diags, moduleType (top-level return plus runtime declaration exports), and
-- the module's exported type/value interface.
function checkMod.check(
    result: state.Parse,
    filename: string?,
    env: state.Env?,
    opts: state.Options?
): {checkMod.Diagnostic}, Type?, state.ModuleExports
    opts = opts or {} as state.Options
    if opts.strict == nil then
        -- A bundled declaration is checked under its module name rather than a path, so
        -- the flag rather than the extension is what identifies one here.
        opts.strict = not opts.declarationFile and checkMod.strictByDefault(filename)
    end
    result.symbols = {}
    result.implicitSideEffects = {}
    -- Effects are compiler-recognized runtime requirements. They are not manifest
    -- switches: the build derives its native feature set from them.
    result.effects = {}
    result.moduleName = opts and opts.moduleName or env and env.moduleNameForPath and env.moduleNameForPath(
        env,
        filename
    ) or nil
    local registry = opts and opts.annotations or env and env.annotations or annotationMod.default()
    registry:removeSource(filename)

    -- One run's whole state, so the passes below reach it through `c` rather than by
    -- being lexically inside one function. See nupp.compiler.check.state.
    local c = new state.Checker {result = result, filename = filename, env = env, opts = opts,
        reducerMemo = {},
        comptimeDepth = 0,
        comptimeFunctionDepth = 0,
        comptimeFunctions = {},
        -- A declaration file describes an interface it does not own, so its bare
        -- declarations are that interface and have no table of the file's own to attach
        -- to. Bundled declarations are checked under their module name rather than a
        -- path, so they say so directly.
        declarationFile = (
        opts and (opts.declarationFile or opts.declareGlobals)
    ) and true or (filename and filename:match("%.d%.nupp$")) and true or false,
        -- The table qualified declarations attach to, so `record M.Point` in a file
        -- that returns M exports Point while `record Other.Point` does not.
        moduleLocal = cst.returnedLocal(
        result.root
    ), annotationRegistry = registry, annotationDefinitions = {}, lintConfig = opts
        and opts.lints
        or env
        and env.config
        and env.config.lints
        or nil,
        -- Fixes and the missing-require advice read the parse and the project index
        -- rather than anything the walk builds, so they are made once here and asked.
        -- See nupp.compiler.check.fixits.
        edits = fixits.new(
        result,
        env
    ), diags = {}, moduleType = nil, moduleExports = opts and opts.initialExports or {
        types = {},
        typeDefs = {},
        values = {}
    }, seenDefinitions = {}, scope = {
        vars = {},
        types = {},
        packTypes = {},
        typeDefs = {},
        pending = {},
        automaticOwners = {},
        depth = 0,
        parent = nil
    }, retStack = {}, retPackStack = {}, ownReturnStack = {}, borrowReturnStack = {}, varargPackStack = {}, yieldPackStack = {}, resumePackStack = {}, protocolStack = {}, dropOperationFieldStack = {}, validatedCleanupContracts = {}, unsafeDepth = 0, noSuspendDepth = 0, handledDepth = 0, functionDepth = 0, scopedCaptureDepth = 0, captureWatches = {}, allowed = {}, nextStat = nil, hoisting = false, resolvingAlias = {}, activeAlias = nil, lastCallRets = nil, moduleFields = {}, moduleFieldTokens = {}, moduleFieldConst = {}, moduleFieldValues = {}, constModulePaths = {}, moduleLocalAnnotated = false,}
    c.rootScope = c.scope
    c.recordEffect = function(effect: string)
        result.effects[effect] = true
    end
    -- Published alongside the module name because the pair is what says a `function
    -- m.f` in this file is a member of this module. Nothing typed needs it; an editor
    -- asked where such a member was written does.
    result.moduleLocal = c.moduleLocal

    c.visibilityOf = function(stat): string
        return cst.declVisibility(stat, c.moduleLocal)
    end

    local fix = c.edits.fix
    local insertBefore = c.edits.insertBefore
    c.missingRequire = c.edits.missingRequire

    -- Owners, borrows and pins are tracked on their own; the walk asks where a value
    -- came from and hands over what it consumes. See nupp.compiler.check.ownership.
    local own = ownership.install(c)
    c.own = own
    -- Whether a function written inside a loop had to be written there is its own
    -- question, asked at the three places a function body is checked. See
    -- nupp.compiler.check.loopclosure.
    c.loops = loopclosure.install(c)
    c.raises = undocumentedraise.install(c)
    -- Two judgements that need the whole file: whether anything read a binding, and
    -- whether a discarded call had a reason to be made. Both register candidates as the
    -- walk passes and sweep at the end. See nupp.compiler.check.unused and
    -- nupp.compiler.check.discard.
    c.unused = unused.install(c)
    c.discard = discard.install(c)
    c.nosuspend = nosuspendMod.install(c)
    resolve.install(c)
    local ownershipKind = own.ownershipKind

    --- Whether a surrounding @allow asked not to hear this lint. A lint is a judgement,
    --- so a statement may disagree with it at any level; a type error is not a
    --- judgement, and no annotation reaches one.
    local function isAllowed(lint, code: string): boolean
        if not lint then
            return false
        end
        for j = #c.allowed, 1, -1 do
            local set = c.allowed[j]
            if set[lint.name] or set[code] or set["*"] then
                return true
            end
        end

        return false
    end

    --- Whether a surrounding `@allow` has asked not to hear a lint, by name or code. A
    --- lint whose judgement needs the whole file asks this at the statement it is
    --- about, because `c.allowed` is unwound by the time such a lint reports.
    ---
    --- @param code the lint's name or its code
    c.suppressed = function(code: string): boolean
        -- `isAllowed` matches the lint's name and whichever spelling it is handed, so
        -- asking with the registry's own code is what makes an `@allow` written either
        -- way reach a lint raised by either.
        local lint = lints.get(code)
        return isAllowed(lint, lint and lint.code or code)
    end

    c.related = function(nodeOrTok, message, relatedFilename)
        local value = nodeOrTok
        local atFilename = relatedFilename
        if value and value.token then
            atFilename = atFilename or value.filename
            value = value.token
        end
        local at = cst.firstToken(value)
        if not at then
            return nil
        end

        return {
            message = message,
            filename = atFilename or filename,
            line = at.line,
            col = at.col,
            offset = at.offset,
            length = #at.text
        }
    end

    c.diag = function(code, nodeOrTok, msg, fixes, details)
        local lint = lints.get(code)
        local severity = "error"
        if lint then
            severity = lints.level(lint, c.lintConfig)
            if severity == "off" then
                return
            end
        end
        if c.hoisting or isAllowed(lint, lint and lint.code or code) then
            return
        end
        local at = cst.firstToken(nodeOrTok)
        c.diags[
            #c.diags + 1
        ] = {
            code = lint and lint.code or code,
            lint = lint and lint.name or nil,
            msg = msg,
            filename = filename,
            severity = severity,
            line = at and at.line or 0,
            col = at and at.col or 0,
            offset = at and at.offset or 0,
            length = at and #at.text or 0,
            fixes = fixes and #fixes > 0 and fixes or nil,
            help = details and details.help or nil,
            notes = details and details.notes or nil,
            related = details and details.related or nil,
        }
    end

    -- A cleanup body that resolves a name declared outside itself makes the generated
    -- region a closure over that binding, and a region with upvalues cannot be shared
    -- across executions. Every name resolution goes through lookupEntry, so watching it
    -- there is enough; the stack keeps nested scopes independent, and an inner capture
    -- is recorded for every enclosing scope it also escapes.
    c.pushScope = function()
        c.scope = {
            vars = {},
            types = {},
            packTypes = {},
            typeDefs = {},
            pending = {},
            automaticOwners = {},
            parent = c.scope,
            depth = (c.scope and c.scope.depth or 0) + 1
        }
    end

    local function auditScope(s)
        for name, entry in pairs(s.vars or {}) do
            local state = entry.ownershipOrigin or entry
            if not entry.ownershipOrigin and ownershipKind and ownershipKind(
                state.t
            ) == "owned" and not state.moved and not (
                state.automaticOwner and state.automaticOwner.lowerable
            ) then
                c.diag(
                    "NUPP2603",
                    entry.definition and entry.definition.token,
                    (
                        "owned value %q leaves scope without being consumed, "
                        .. "dropped, returned, or converted with intoRaw"
                    ):format(name)
                )
            elseif not entry.ownershipOrigin and state.retained and not state.moved then
                c.diag(
                    "NUPP2603",
                    entry.definition and entry.definition.token,
                    (
                        "pinned handle %q is still retained by C; pass it to a "
                        .. "declared releases parameter before it leaves scope"
                    ):format(name)
                )
            end
        end
    end

    c.popScope = function()
        auditScope(c.scope)
        for _, entry in pairs(c.scope.vars or {}) do
            if entry.borrowOwner then
                entry.borrowOwner.activeBorrows = math.max(0, (entry.borrowOwner.activeBorrows or 1) - 1)
            end
            for _, owner in ipairs(entry.borrowOwners or {}) do
                owner.activeBorrows = math.max(0, (owner.activeBorrows or 1) - 1)
            end
        end
        c.scope = c.scope.parent
    end
    -- Var entries: { t = type, ann = boolean, constant = boolean }. Assignment
    -- compatibility is enforced only for annotated bindings; inferred bindings stay
    -- flexible (e.g. "increment_indent = nil" to disable an inferred local function).
    c.lookupEntry = function(name)
        local s = c.scope
        while s do
            local v = s.vars[name]
            if v then
                -- Every name resolution arrives here, which makes this the one place a
                -- read has to be recorded from. See nupp.compiler.check.unused.
                if v.definition then
                    c.reads[v.definition] = true
                end
                for i = #c.captureWatches, 1, -1 do
                    -- A watch asks about the scopes between its floor and itself.
                    -- A cleanup region sets no floor and hears every outward resolution;
                    -- a closure being judged for hoisting sets the floor at its loop,
                    -- because a name that was already bound before the loop is the same
                    -- name on every iteration.
                    local watch = c.captureWatches[i]
                    local at = s.depth or 0
                    if at < watch.depth and at >= (watch.floor or 0) then
                        watch.captured = true
                    end
                end
                return v
            end
            s = s.parent
        end
        if env and env.globals then
            return env.globals[name]
        end

        return nil
    end

    --- The type a name currently holds.
    c.lookupVar = function(name: string): Type?
        local e = c.lookupEntry(name)
        return e and e.t or nil
    end

    -- Set while a hoisted alias is being resolved, so an alias that names itself
    -- reports rather than recurses forever.

    c.lookupType = function(name)
        local s = c.scope
        while s do
            local t = s.types[name]
            if t then
                return t, s.typeDefs[name]
            end
            local waiting = s.pending and s.pending[name]
            if waiting then
                local resolved = c.resolvePendingAlias(name, waiting, s)
                if resolved then
                    return resolved, s.typeDefs[name]
                end
            end
            s = s.parent
        end
        if env and env.globalTypes then
            local t = env.globalTypes[name]
            if t then
                return t, env.globalTypeDefs and env.globalTypeDefs[name] or nil
            end
        end
        if env and env.resolveProjectType then
            return env.resolveProjectType(env, filename, name)
        end

        return nil
    end
    c.lookupPack = function(name)
        local s = c.scope
        while s do
            local p = s.packTypes and s.packTypes[name]
            if p then
                return p, s.typeDefs[name]
            end
            s = s.parent
        end

        return nil
    end
    c.definition = function(tok, kind)
        if not tok then
            return nil
        end
        local def = tok.definition
        if not def or def.filename ~= filename or def.token ~= tok then
            def = {filename = filename, token = tok, name = tok.text}
        end
        if not c.seenDefinitions[def] then
            result.symbols[#result.symbols + 1] = def
            c.seenDefinitions[def] = true
        end
        if kind and (not def.kind or def.kind == "variable") then
            def.kind = kind
        end
        tok.definition = def

        return def
    end
    c.markToken = function(tok, def, t, kind)
        if not tok then
            return
        end
        tok.definition = def
        tok.inferredType = t
        tok.semanticKind = kind or def and def.kind or "variable"
    end
    c.bindVar = function(name, t, annotated, tok, kind, constant)
        local old = c.scope.vars[name]
        if tok then
            local s = c.scope
            while s do
                local existing = s.vars[name]
                if existing and existing.constant then
                    c.diag("NUPP2008", tok, ("cannot re-declare const variable %s"):format(name))
                    break
                end
                s = s.parent
            end
        end
        kind = kind or (t and t.tag == "func" and "function" or "variable")
        local def = tok and c.definition(tok, kind) or old and old.definition or nil
        if def then
            def.type = t
            def.constant = constant == true or (tok == nil and old and old.constant) or false
            if not def.kind or def.kind == "variable" then
                def.kind = kind
            end
        end
        local entry = {
            t = t,
            ann = annotated ~= nil and annotated or old and old.ann or false,
            constant = constant == true or (tok == nil and old and old.constant) or false,
            definition = def,
            ownership = t and (t.tag == "owned" or t.tag == "borrowed" or t.tag == "pinned") and t.tag or nil,
            moved = false,
            functionDepth = c.functionDepth,
        }
        c.scope.vars[name] = entry
        -- A visible `takes` body has no producer-specific cleanup witness: its mode
        -- says responsibility transferred, but its payload type does not say which
        -- producer supplied the owner. Ordinary locals carry the exact cleanup list
        -- and can therefore become lexical automatic-cleanup entries.
        if kind ~= "parameter" and t and t.tag == "owned" and #(t.cleanups or {}) > 0 then
            local automatic = {
                name = name,
                token = tok,
                entry = entry,
                cleanups = t.cleanups,
                optional = own.optionalOwned(t),
            }
            entry.automaticOwner = automatic
            c.scope.automaticOwners = c.scope.automaticOwners or {}
            c.scope.automaticOwners[#c.scope.automaticOwners + 1] = automatic
        end
        c.markToken(tok, def, t, def and def.kind or kind)
    end
    c.bindType = function(name, t, tok)
        c.scope.types[name] = t
        local kind = t and t.tag == "nominal" and t.declKind or "type"
        if kind == "record" then
            kind = "type"
        end
        if t and t.tag == "typevar" then
            kind = "typeParameter"
        end
        local def = tok and c.definition(tok, kind) or c.scope.typeDefs[name]
        if def then
            def.type, def.kind = t, kind
        end
        c.scope.typeDefs[name] = def
        c.markToken(tok, def, t, kind)
    end
    c.bindPack = function(name, p, tok)
        c.scope.packTypes[name] = p
        local def = tok and c.definition(tok, "typeParameter") or c.scope.typeDefs[name]
        if def then
            def.type, def.kind = p, "typeParameter"
        end
        c.scope.typeDefs[name] = def
        c.markToken(tok, def, nil, "typeParameter")
    end

    --- The single table a qualified declaration attaches to, or nil when the name is
    --- unqualified.
    c.qualifierOf = function(stat): string?
        local qualifiers = stat.qualifiers
        local only = qualifiers and #qualifiers == 1 and qualifiers[1] or nil
        return only and only.text or nil
    end

    --- The scope key a declaration binds under. A qualified name binds under its whole
    --- path, so `record M.Point` is reached as `M.Point` and declares no bare `Point` —
    --- the same rule `function M.f` follows. The dot keeps the key clear of any
    --- identifier.
    c.declKey = function(stat): string
        local qualifier = c.qualifierOf(stat)
        if not qualifier then
            return stat.name.text
        end

        return qualifier .. "." .. stat.name.text
    end

    --- Binds a declaration's type where its name puts it, recording the runtime path a
    --- qualified declaration lives at.
    c.bindDeclaredType = function(stat, t)
        local key = c.declKey(stat)
        -- The runtime table lives at M.Point, which is what `is` compares and
        -- construction stamps for references from inside this file.
        if t and t.tag == "nominal" and c.qualifierOf(stat) then
            t.runtimePath = key
        end
        -- The table a declaration attaches to reads as a namespace, the same as any
        -- other reference to the module it stands for.
        for _, qualifier in ipairs(stat.qualifiers or {}) do
            c.markToken(qualifier, nil, nil, "namespace")
        end
        c.bindType(key, t, stat.name)
        -- The name a reader writes is the whole path, which is what an editor should be
        -- offering and listing rather than the last segment alone.
        if c.qualifierOf(stat) and stat.name.definition then
            stat.name.definition.qualifiedName = key
        end
    end

    --- Binds the value a declaration also introduces — a record's runtime table, a
    --- struct's ctype constructor — under the same key as its type, so `M.Point{...}`
    --- is recognized as a construction.
    c.bindDeclaredVar = function(stat, t)
        c.bindVar(c.declKey(stat), t, false, stat.name)
    end

    ---------------------------------------------------------------------
    -- Type annotation resolution
    ---------------------------------------------------------------------

    -- A type parameter's identity is where its binder was written, so the file it was
    -- written in is part of it. Every caller that resolves an annotation names the file
    -- it is checking.
    c.typevarAt = function(tok, role)
        return T.typevar(tok.text, (filename as string) .. ":" .. tostring(tok.offset) .. ":" .. (role or "generic"))
    end
    c.packvarAt = function(tok, role)
        return T.packvar(
            tok.text,
            (filename as string) .. ":" .. tostring(tok.offset) .. ":" .. (role or "generic-pack")
        )
    end
    c.constvarAt = function(tok, domain, role)
        return T.constvar(
            tok.text,
            domain,
            (filename as string) .. ":" .. tostring(tok.offset) .. ":" .. (role or "generic-const")
        )
    end

    -- Binds a generic clause in its surrounding scope and resolves aligned upper bounds
    -- after each binder is visible.
    c.bindGenerics = function(generics, role)
        local params, bounds, packParams, constParams, paramKinds = {}, {}, {}, {}, {}
        local sawPack = false
        for j, nameTok in ipairs(generics and generics.names or {}) do
            local isPack = generics.packs and generics.packs[j]
            local isConst = generics.consts and generics.consts[j]
            if isConst then
                local domainToken = generics.domains and generics.domains[j]
                local domain = domainToken and domainToken.text or "unknown"
                if domain ~= "string" and domain ~= "boolean" and domain ~= "integer" then
                    c.diag(
                        "NUPP2131",
                        domainToken or nameTok,
                        "const parameter domain must be string, boolean, or integer"
                    )
                    domain = "string"
                end
                local cv = c.constvarAt(nameTok, domain, role)
                constParams[#constParams + 1] = cv
                paramKinds[j] = "const"
                c.bindType(nameTok.text, consteval.singleton(cv), nameTok)
            elseif isPack then
                sawPack = true
                local pv = c.packvarAt(nameTok, role)
                packParams[#packParams + 1] = pv
                paramKinds[j] = "pack"
                c.bindPack(nameTok.text, pv, nameTok)
            else
                if sawPack then
                    c.diag("NUPP2121", nameTok, "an ordinary type parameter cannot follow a pack parameter")
                end
                local tv = c.typevarAt(nameTok, role)
                params[#params + 1] = tv
                paramKinds[j] = "type"
                c.bindType(nameTok.text, tv, nameTok)
            end
            local boundNode = generics.bounds and generics.bounds[j]
            if boundNode then
                if isPack then
                    c.diag("NUPP2121", boundNode, "generic pack bounds are not supported")
                else
                    bounds[#params] = c.resolveType(boundNode)
                    params[#params].bound = bounds[#params]
                end
            end
        end

        return params, bounds, packParams, constParams, paramKinds
    end

    ---------------------------------------------------------------------
    -- Narrowing: facts extracted from conditions
    ---------------------------------------------------------------------

    -- The C namespace: a shape of everything the program has declared to the FFI, so
    -- ffi.C and ffi.load both carry real signatures.

    --- The type of `ffi.C`: every symbol the program has cdef'd.
    c.cNamespaceType = function(): Type
        local decls = require("nupp.compiler.cheader").declaredFunctions(function(tag)
            local found = c.lookupType(tag)
            if found and found.tag == "nominal" then
                return found
            end

            return nil
        end)
        local fields = {}
        for name, t in pairs(decls) do
            fields[#fields + 1] = {name = name, type = t}
        end
        if #fields == 0 then
            return T.any
        end

        return T.shape(fields)
    end

    -- Types an expression list against `count` targets, expanding the last expression's
    -- extra return values. See nupp.compiler.check.expr for which expressions expand.
    local EXPANDS = expr.EXPANDS

    local function affineType(t)
        if not t then
            return false
        end
        if t.tag == "owned" or t.tag == "pinned" then
            return true
        end
        if t.tag == "union" or t.tag == "intersection" then
            for _, member in ipairs(t.members) do
                if affineType(member) then
                    return true
                end
            end
        end

        return false
    end

    local function valueMode(t)
        if not t then
            return "plain"
        end
        if t.tag == "owned" or t.tag == "pinned" then
            return "takes"
        end
        if t.tag == "borrowed" then
            return "borrows"
        end

        return "plain"
    end

    local function checkPackDiscard(pack, first, at)
        if not pack then
            return false
        end
        local discarded = false
        if pack.alternatives then
            for _, arm in ipairs(pack.alternatives) do
                discarded = checkPackDiscard(arm, first, at) or discarded
            end
            return discarded
        end
        for j = first, #pack.head do
            if affineType(pack.head[j]) then
                discarded = true
            end
        end
        if pack.tail and (pack.tail.kind == "generic" or affineType(pack.tail.type)) then
            discarded = true
        end
        if discarded then
            c.diag("NUPP2605", at, "an affine value in this result pack would be discarded")
        end

        return discarded
    end

    local function inferListPack(exprs, paramModes)
        local head, modes, tail = {}, {}, nil
        exprs = exprs or {}
        for j, e in ipairs(exprs) do
            c.lastCallRets = nil
            local priorScoped = c.scopedCaptureDepth
            if paramModes and paramModes[j] == "scoped" then
                c.scopedCaptureDepth = priorScoped + 1
            end
            local valueT = c.infer(e)
            c.scopedCaptureDepth = priorScoped
            local produced = e.valuePack
            local pack = j == #exprs and EXPANDS[e.kind] and produced or nil
            if pack then
                if pack.alternatives then
                    local alternatives = {}
                    for armIndex, arm in ipairs(pack.alternatives) do
                        local armHead, armModes = {}, {}
                        for k, value in ipairs(head) do
                            armHead[k], armModes[k] = value, modes[k]
                        end
                        for k, resultT in ipairs(arm.head) do
                            armHead[#armHead + 1] = resultT
                            local mode = arm.modes[k]
                            armModes[#armModes + 1] = mode and mode ~= "plain" and mode or valueMode(resultT)
                        end
                        alternatives[armIndex] = T.pack(armHead, arm.tail, armModes)
                    end
                    return T.packUnion(alternatives)
                end
                for k, resultT in ipairs(pack.head) do
                    head[#head + 1] = resultT
                    local mode = pack.modes[k]
                    modes[#modes + 1] = mode and mode ~= "plain" and mode or valueMode(resultT)
                end
                tail = pack.tail
            else
                head[#head + 1] = valueT
                modes[#modes + 1] = valueMode(valueT)
                if produced then
                    checkPackDiscard(produced, 2, e)
                end
            end
        end

        return T.pack(head, tail, modes)
    end

    local function inferList(exprs, count)
        local pack = inferListPack(exprs)
        local out = {}
        local hasExpressions = exprs and #exprs > 0
        local limit = count and hasExpressions and count or math.min(count or #pack.head, #pack.head)
        for j = 1, limit do
            out[j] = T.packAt(pack, j) or T.nil_
        end
        if count then
            checkPackDiscard(pack, count + 1, exprs and exprs[#exprs] or nil)
        end

        return out
    end

    -- Removes members of union `t` that fit `rem`; a full wipe-out keeps `t`.

    --- `t` with everything that fits `rem` removed. Subtracting one of boolean's two
    --- values leaves the other; a type parameter is left alone, since while
    --- unsubstituted it fits everything.

    -- What a condition proves, and where it holds, is its own concern; the walk applies
    -- what it is told. See nupp.compiler.check.narrow.
    local facts = narrow.install(c)
    c.facts = facts
    local pathKey = facts.pathKey

    --- Whether calling this expression never comes back. `error` is recognized by name
    --- so that untyped code keeps the behaviour it always had; anything else has to say
    --- so, through a declared `never` result or through a body that only ever raises.
    ---
    --- @param call the called expression, if the statement had one
    local function neverReturns(call: Node?): boolean
        if not call then
            return false
        end
        local kind = call.kind
        if kind ~= "call" and kind ~= "methodCall" then
            return false
        end
        local signature = call.signatureType as Type?
        if signature and signature.tag == "func" and signature.noreturn then
            return true
        end
        if kind == "call" then
            local callee = call.obj
            if callee and callee.kind == "name" then
                local tok = callee.token
                if tok and tok.text == "error" then
                    return true
                end
            end
        end

        return false
    end

    -- True if a block unconditionally leaves the enclosing scope.

    --- Whether control always leaves this block, so it never reaches what follows.
    local function alwaysExits(block: Node?): boolean
        local stats = block and block.kind == "block" and block.stats or {}
        local last = stats[#stats]
        if not last then
            return false
        end
        local kind = last.kind
        if kind == "returnStmt" or kind == "breakStmt" or kind == "continueStmt" then
            return true
        end
        if kind == "callStmt" then
            return neverReturns(last.expr)
        end

        return false
    end

    --- Whether every path out of this block raises rather than returning: the last
    --- statement is a call that never comes back, or a `do` block or a complete `if`
    --- chain of which the same is true. This is what makes a helper that only ever
    --- throws behave as if it were declared to return `never`, without being told.
    ---
    --- @param block the body to judge
    local function alwaysRaises(block: Node?): boolean
        local stats = block and block.kind == "block" and block.stats or {}
        local last = stats[#stats]
        if not last then
            return false
        end
        local kind = last.kind
        if kind == "callStmt" then
            return neverReturns(last.expr)

        elseif kind == "doStmt" then
            return alwaysRaises(last.body)

        elseif kind == "ifStmt" then
            local otherwise = last.elseClause
            if not otherwise then
                return false
            end
            for _, clause in ipairs(last.clauses) do
                if clause.kind ~= "ifClause" and clause.kind ~= "elseifClause" then
                    return false
                end
                if not alwaysRaises(clause.body) then
                    return false
                end
            end
            if otherwise.kind ~= "elseClause" then
                return false
            end
            return alwaysRaises(otherwise.body)
        end

        return false
    end

    --- Whether anything in this function's own body returns. A nested function's
    --- returns belong to it, so the walk stops where a new body begins.
    ---
    --- @param x the node to search
    local function returnsSomewhere(x: Node): boolean
        if x.kind == "returnStmt" then
            return true
        end
        if x.kind == "funcbody" or x.kind == "shortfn" then
            return false
        end
        for _, child in ipairs(x) do
            if not cst.isToken(child) and returnsSomewhere(child as Node) then
                return true
            end
        end

        return false
    end

    -- Reaching a member and checking a call against it, construction included. See
    -- nupp.compiler.check.calls.
    local apply = calls.install(c)
    c.apply = apply

    -- A metatable literal is where a declared contract is fulfilled, so what it puts
    -- under each key is checked wherever one is written. See
    -- nupp.compiler.check.metatable.
    metatable.install(c)

    -- The type an expression has. See nupp.compiler.check.expr.
    expr.install(c)

    ---------------------------------------------------------------------
    -- Statements
    ---------------------------------------------------------------------

    -- Whether an annotation is well formed, and what one defines, is its own job; the
    -- walk only asks. See nupp.compiler.check.annotate.
    local marks = annotate.install(c)
    c.marks = marks
    local validateAnnotation = marks.validateAnnotation

    -- Checking a declaration and publishing what it declares. See
    -- nupp.compiler.check.declare.
    declare.install(c, reifiableField, fix, insertBefore, validateAnnotation)

    --- Checks one statement, in the scope it stands in.
    ---
    --- @param stat the statement node
    -- A module is written `local M = {}` and filled in one statement at a time, so the
    -- constructor says nothing about what it exports. What is put on it does, and
    -- remembering that is what lets a caller reach an exported function's type rather
    -- than an open table's.
    local function modulePath(target: Node): string?
        local key = pathKey(target)
        if not key or not c.moduleLocal then
            return nil
        end
        if key:sub(1, #c.moduleLocal + 1) ~= c.moduleLocal .. "." then
            return nil
        end

        return key
    end

    local function recordConstTableFields(path: string, value: Node?)
        if not value or value.kind ~= "tableExpr" then
            return
        end
        for _, field in ipairs(value.fields or {}) do
            if field.kind == "fieldNamed" and field.isConst and field.name then
                local fieldPath = path .. "." .. field.name.text
                c.constModulePaths[fieldPath] = true
                recordConstTableFields(fieldPath, field.value)
            end
        end
    end

    local function recordModuleField(target: Node, t: Type?, constant: boolean?, value: Node?)
        if not c.moduleLocal or target.kind ~= "dotIndex" then
            return
        end
        local base, member = target.obj, target.name
        if not base or not member or base.kind ~= "name" then
            return
        end
        local baseTok = base.token
        if not baseTok or baseTok.text ~= c.moduleLocal then
            return
        end
        c.moduleFields[member.text] = t or T.any
        c.moduleFieldTokens[member.text] = member
        if value then
            c.moduleFieldValues[member.text] = value
        end
        if constant then
            c.moduleFieldConst[member.text] = true
            local path = modulePath(target)
            if path then
                c.constModulePaths[path] = true
                recordConstTableFields(path, value)
            end
        end
    end

    local function constModuleField(target: Node): boolean
        local path = modulePath(target)
        return path ~= nil and c.constModulePaths[path] == true
    end

    -- Promoted onto the run so that the statement families below, each in its own
    -- module, can reach them without being lexically inside this function.
    c.inferList = inferList
    c.inferListPack = inferListPack
    c.checkPackDiscard = checkPackDiscard
    c.recordModuleField = recordModuleField
    c.constModuleField = constModuleField
    c.alwaysExits = alwaysExits
    c.alwaysRaises = alwaysRaises
    c.returnsSomewhere = returnsSomewhere

    -- Each statement family is its own module, installed here and reached through one
    -- table. A kind with no handler is a statement with nothing to check: empty, break,
    -- goto, label, and the error nodes recovery leaves behind.
    local statHandlers = {}
    for _, installed in ipairs({
        bindings.install(c),
        control.install(c),
        functions.install(c),
        cdef.install(c, reifiableField),
        pragma.install(c),
    }) do
        for kind, handle in pairs(installed) do
            statHandlers[kind] = handle
        end
    end
    statHandlers.recordDecl = c.checkTypedecl
    statHandlers.typeAlias = c.checkTypedecl

    local function checkStat(stat: Node)
        local handle = statHandlers[stat.kind]
        if handle then
            handle(stat)
        end
    end

    c.checkStat = checkStat

    --- Gives a hoisted nominal the identities of records nested anywhere beneath it.
    --- Their bodies are still filled when the owning declaration is checked, but an
    --- earlier statement may already name `Owner.Nested`.
    local function hoistNestedNominals(owner, entries)
        owner.nestedTypes = owner.nestedTypes or {}
        for _, entry in ipairs(entries or {}) do
            if entry.kind == "recordDecl" then
                local nested = entry.hoistedType or T.nominal(entry.name.text, entry.declKind)
                entry.hoistedType = nested
                nested.byname = nested.byname or {}
                nested.writeByname = nested.writeByname or {}
                nested.staticByname = nested.staticByname or {}
                nested.staticWriteByname = nested.staticWriteByname or {}
                nested.runtimePath = (owner.runtimePath or owner.name) .. "." .. entry.name.text
                owner.nestedTypes[entry.name.text] = nested
                hoistNestedNominals(nested, entry.entries)
            end
        end
    end

    -- Binds every type a block declares before any body is checked, so declarations in
    -- one block may name each other whatever the order. A nominal is created and bound
    -- here and filled in when its statement is reached; an alias's value waits until
    -- something names it.
    local function hoistDeclarations(block)
        for _, stat in ipairs(block.stats or {}) do
            local decl = stat
            while decl and decl.kind == "pragmaStmt" do
                decl = decl.stat
            end
            local k = decl and decl.kind
            if k == "recordDecl" and decl.name then
                local n, entry = c.declaredNominal(decl, decl.declKind)
                decl.hoistedType, decl.hoistedEntry = n, entry
                n.byname = n.byname or {}
                n.writeByname = n.writeByname or {}
                n.staticByname = n.staticByname or {}
                n.staticWriteByname = n.staticWriteByname or {}
                local key = c.declKey(decl)
                if c.qualifierOf(decl) then
                    n.runtimePath = key
                end
                hoistNestedNominals(n, decl.entries)
                c.bindType(key, n, nil)
            elseif k == "typeAlias" and decl.name and decl.value then
                local waiting = {node = decl.value, tok = decl.name, decl = decl}
                decl.hoistedAlias = waiting
                c.scope.pending[c.declKey(decl)] = waiting
            end
        end
        -- Methods, once the types they name are bound: publishing each signature now is
        -- what lets two methods call each other.
        local wasHoisting = c.hoisting
        c.hoisting = true
        for _, stat in ipairs(block.stats or {}) do
            local decl = stat
            while decl and decl.kind == "pragmaStmt" do
                decl = decl.stat
            end
            local fname = decl and decl.kind == "funcStmt" and decl.name
            local ownerKey, memberTok = nil, nil
            if fname then
                ownerKey, memberTok = c.funcOwner(fname)
            end
            if ownerKey then
                local owner = c.lookupType(ownerKey)
                local member = memberTok and memberTok.text
                local isStatic = owner and not fname.method and (
                    owner.declKind == "record" or owner.declKind == "interface"
                )
                local members = owner and (isStatic and owner.staticByname or owner.byname)
                if owner and owner.tag == "nominal" and members and member and not members[member] then
                    local signature = c.signatureOf(decl.body, fname.method and owner or nil)
                    members[member] = signature
                    if not isStatic then
                        owner.writeByname[member] = signature
                    else
                        owner.staticWriteByname[member] = signature
                    end
                end
            end
        end
        c.hoisting = wasHoisting
    end

    --- Checks every statement of a block, hoisting the declarations in it first so they
    --- may name one another whatever the order.
    ---
    --- @param block the block node
    --- @param scopeManaged whether the caller has already pushed the scope
    c.checkBlock = function(block: Node?, scopeManaged: boolean?)
        if not scopeManaged then
            c.pushScope()
        end
        if block and block.kind == "block" then
            c.scope.block = block
        end
        hoistDeclarations(block)
        local stats = block and block.kind == "block" and block.stats or {}
        local wasNext = c.nextStat
        for i, stat in ipairs(stats) do
            c.nextStat = stats[i + 1]
            checkStat(stat)
        end
        c.nextStat = wasNext
        if block and block.kind == "block" and #(c.scope.automaticOwners or {}) > 0 then
            block.automaticOwners = c.scope.automaticOwners
            local boundary = cst.lastToken(block)
            local function cleanupName(cleanup)
                if cleanup.kind == "function" then
                    return cleanup.name or cleanup.id
                elseif cleanup.kind == "method" then
                    return ":" .. cleanup.name
                elseif cleanup.kind == "field" then
                    return cleanup.field .. " -> " .. cleanupName(cleanup.cleanup)
                end
                return cleanup.id or cleanup.kind
            end
            for _, owner in ipairs(c.scope.automaticOwners) do
                owner.boundary = boundary
                local cleanups = {}
                for _, cleanup in ipairs(owner.cleanups or {}) do
                    cleanups[#cleanups + 1] = cleanupName(cleanup)
                end
                if owner.entry and owner.entry.definition then
                    owner.entry.definition.automaticCleanup = {
                        line = boundary and boundary.line or 0,
                        column = boundary and boundary.col or 0,
                        cleanups = cleanups,
                        status = owner.moved and "moved" or "automatic",
                    }
                end
            end
        end
        if not scopeManaged then
            c.popScope()
        end
    end

    -- Said once, before anything is checked, so the answer does not depend on how far
    -- checking got.
    if filename and filename:match("%.lua$") then
        for _, block in ipairs(result.root.blocks) do
            reportTypedLayer(c, block)
        end
    end

    -- Top-level statements bind into the root scope directly so that declaration files
    -- can export them and module return types resolve.
    for _, block in ipairs(result.root.blocks) do
        c.checkBlock(block, true)
    end
    auditScope(c.rootScope)

    -- A module's type is what it returned. Declarations that carry a runtime value put
    -- it on that table themselves, so there is nothing to merge in afterwards and
    -- nothing that could collide with a field already there.

    if opts and opts.declareGlobals and env then
        env.globals = env.globals or {}
        env.globalTypes = env.globalTypes or {}
        for name, entry in pairs(c.rootScope.vars) do
            env.globals[name] = entry
        end
        for name, t in pairs(c.rootScope.types) do
            env.globalTypes[name] = t
        end
        env.globalTypeDefs = env.globalTypeDefs or {}
        for name, def in pairs(c.rootScope.typeDefs) do
            env.globalTypeDefs[name] = def
        end
    end

    local facts = analysis.run(result as nupp.compiler.analysis.Target, c)
    -- The narrow direct case needs no protected call: the acquisition is the
    -- block's final statement, there is no live-interval body to raise, and every
    -- cleanup body is visible and proven non-raising by the same effect summaries
    -- used elsewhere. Everything less certain keeps the shared protected lowering.
    local effectQueries = analysis.queries(facts)
    local function cleanupNonRaising(cleanup): boolean
        if cleanup.kind == "field" then
            return cleanupNonRaising(cleanup.cleanup)
        end
        if cleanup.kind ~= "function" or not effectQueries then
            return false
        end
        local known = effectQueries.known(cleanup.token)
        if not known then
            return false
        end
        local visible = effectQueries.visible(known.summary)
        local free = visible and effectQueries.free(known.summary, {"raises"}) or false

        return free == true
    end
    for _, block in ipairs(facts.bodies or {}) do
        local owners = block.automaticOwners or {}
        if #owners == 1 then
            local owner = owners[1]
            local last = block.stats and block.stats[#block.stats] or nil
            local direct = owner.lowerable
                and owner.stat == last
                and not owner.optional
                and not owner.moved
                and owner.movedFields == nil
            for _, cleanup in ipairs(owner.cleanups or {}) do
                direct = direct and cleanupNonRaising(cleanup)
            end
            if direct then
                block.automaticDirect = owner
            end
        end
    end
    finalizeBoundary(c)
    -- Both of these needed the whole file before they could answer, so they answer here
    -- and their diagnostics are put back in source order with everything else.
    c.unused.sweep()
    c.discard.sweep(analysis.queries(facts))
    c.nosuspend.sweep(analysis.queries(facts))
    table.sort(c.diags, function(a, b)
        return a.offset < b.offset
    end)
    result.moduleExports = c.moduleExports

    return c.diags, c.moduleType, c.moduleExports
end

return checkMod
