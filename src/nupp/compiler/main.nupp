--[[
The entry point.

Everything the command line is lives under `nupp.compiler.cli`: one derived
command record per subcommand and the application that resolves and runs those
typed records. What is left here is the two things a program has to do that a
library cannot: read `arg`, and exit with a status.
]]

-- Windows opens the inherited standard streams in text mode. That changes LF
-- output to CRLF and, more seriously, changes the bytes and Content-Length of
-- an LSP frame after it was measured. CLI protocols and generated artifacts
-- are byte contracts, so put all three standard descriptors in binary mode.
if package.config:sub(1, 1) == "\\" then
    cdef function _setmode(descriptor: int32, mode: int32): int32
    const BINARY = 0x8000
    _setmode(0, BINARY)
    _setmode(1, BINARY)
    _setmode(2, BINARY)
end

local impactModule = os.getenv("NUPP_TEST_IMPACT_RUN_ID") and require("nupp.compiler.testimpact.observe") or nil
local impact = impactModule and impactModule.fromEnvironment(nil, arg) or nil
-- Before the compiler is required, because what it does decides how the rest
-- gets loaded. Impact observation starts first so this participating module is
-- not the one compiler dependency omitted from an attributed child.
require("nupp.compiler.bytecodecache").install()

local status = require("nupp.compiler.cli").main(arg)
if impact then
    local written, problem = require("nupp.compiler.testimpact.observe").finishProcess(impact, status)
    if not written then
        io.stderr:write("nupp: cannot write test impact fragment: " .. tostring(problem) .. "\n")
    end
end
os.exit(status)
