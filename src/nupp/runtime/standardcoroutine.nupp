@!internal

--[[
Structured concurrency: a scope owns the tasks spawned into it.

Open a scope, spawn children into it, and the block that holds it does not end
until every one of them has run, been cancelled, or unwound.

```nupp
local scope = coroutine.scope()
const hello = scope:spawn(|| -> "hello")
const world = scope:spawn(|| -> "world")

local greeting = hello:await() .. " " .. world:await()

assert(greeting == "hello world")
```

`scope` takes a `limit`, which parks `spawn` and `work` while that many children
are live, and a `timeoutms`, how long the scope may take. A running child
cooperates by calling `checkpoint`, which is where it learns the scope was
cancelled or its deadline passed.

```nupp
local scope = coroutine.scope(timeoutms = 1000)
const sum = scope:spawn("sum values", || -> do
    local answer: integer = 0
    for value = 1, 1000 do
        coroutine.checkpoint()
        answer = answer + value
    end

    return answer
end)

local total = sum:await()

assert(total == 500500)
```

## Growing task families

[](coroutine.gather) and [](coroutine.race) take a family that is complete when
the call is written; children cannot be added later.
[](coroutine.sus.create) makes a coroutine that inherits a handler but
does not own its result, failure, or lifetime. A server, a loading pipeline, or
a scene needs somewhere to put children found over time and one answer to what
happens when the body returns, a child fails, or the whole thing is cancelled.

Pooled CPU jobs start through [](coroutine.Scope.work); dedicated services start
through [](coroutine.Scope.worker). Both belong to a task scope. Bounded
[](coroutine.Scope.channel) endpoints carry messages while a child runs, and
leaving the scope joins its children through the suspension-aware path.

The scheduling contract is with the host rather than with each child. The host
sees one aggregate and decides when it runs; this decides which children run
then, in FIFO order, up to a bounded number of activations per host turn.
Nesting divides that bound rather than multiplying it, because the token belongs
to the turn.
]]

--- @namespace coroutine
module nupp.runtime.standardcoroutine

local source1 = require("nupp.tasks")
local suspension = require("nupp.suspension")
local suspensionContract = require("nupp.suspension.contracts")
local workerContract = require("nupp.workers.contracts")
local channelTypes = require("nupp.workers.internal.channeltypes")
local clockContract = require("nupp.runtime.contracts")
local selectedTime = require("nupp.runtime.timeprovider").provider

local function missingClock(...: any): never
    error("nupp.time: no clock provider is available", 2)
end

--- Describes a sendable function accepted by [](coroutine.Scope.work) and
--- [](coroutine.Scope.worker).
--- The returned [](coroutine.Task) represents its running job.
export type Worker = workerContract.Worker

--- Describes a task body that takes no arguments.
export type Nullary = source1.Nullary

--- Returns a child task's argument pack after validating ownership modes.
export const Parameters = workerContract.Parameters

--- Returns a worker function's argument pack after validating transfers.
export const Submitted = workerContract.Submitted

--- Returns two integer capacity arguments for a channel's message type.
---
--- `ChannelLimits(T)` checks that `T` can cross a channel. The resulting
--- arguments are the message count and retained-byte limits of
--- [](coroutine.Scope.channel).
export const ChannelLimits = workerContract.ChannelLimits

--- Returns a channel's one-message argument pack with its ownership mode.
---
--- `MessageArguments(T)` checks that `T` can cross a channel and produces one
--- `T` argument with `takes` mode, so an owned payload transfers to the send.
--- For `any`, the argument is plain and its value is copied instead.
--- [](coroutine.Sender.send) and [](coroutine.Sender.trysend) use this pack.
export const MessageArguments = workerContract.MessageArguments

export type Cancellation = source1.Cancellation
export type Scope = source1.Scope
export type Status = source1.Status
export type Task<F> = source1.Task<F>

--- Owns a channel's sending direction, bounded by the scope that created it.
export type Sender<T> = channelTypes.Sender<T>

--- Owns a channel's receiving direction, bounded by the scope that created it.
export type Receiver<T> = channelTypes.Receiver<T>

export const Cancellation = source1.Cancellation
export const Scope = source1.Scope
export const checkpoint = source1.checkpoint
export const deadline = source1.deadline
export const gather = source1.gather
export const iscancelled = source1.isCancelled
export const scope = source1.open
export const race = source1.race
export const run = source1.run

--- Waits for a callback to produce a value while the handler runs other work.
---
--- The subscription returns cleanup that runs when the wait ends or is cancelled.
--- Use [](coroutine.sus.source) when readiness needs a pump.
export const suspend: suspensionContract.Provider.["suspend"] = suspension.suspend

export const sleep: clockContract.ClockProvider.["sleep"] = selectedTime and selectedTime.sleep or missingClock
export const sleepuntil: clockContract.ClockProvider.["sleepuntil"] = selectedTime and selectedTime.sleepuntil
    or missingClock
export const wakeat: clockContract.ClockProvider.["wakeat"] = selectedTime and selectedTime.wakeat or missingClock

--- @internal
export const value: table = do
    local original = rawget(_G, "coroutine") as any
    original.Cancellation = Cancellation
    original.Scope = Scope
    original.checkpoint = checkpoint
    original.deadline = deadline
    original.gather = gather
    original.iscancelled = iscancelled
    original.scope = scope
    original.race = race
    original.run = run
    original.suspend = suspend
    original.sleep = sleep
    original.sleepuntil = sleepuntil
    original.wakeat = wakeat
    yield original
end
