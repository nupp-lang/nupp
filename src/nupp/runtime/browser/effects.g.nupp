@!internal
module nupp.runtime.browser.effects

-- Browser effects cross the one yieldable Lua/Wasm boundary as JSON. Providers
-- enqueue work while subscribing; the suspension provider yields every queued
-- request together and dispatches the corresponding responses after resumption.
--
-- That boundary is the application's root coroutine, the one the page resumes. A
-- yield from any other coroutine goes to whoever resumed that one, so a park there
-- would hand the batch to ordinary Lua and strand every request in it. The guest
-- bridge records the root on `__nuppBrowser.root`; where it has, only the root and
-- the coroutines relaying to it may park.

local json = require("nupp.runtime.provider.lunajson")
local effects = {}
local nextId: integer = 1
local queued: {any} = {}
local waiting: {[integer]: any} = {}
local hostTurns: integer = 0
local browserHost: any = rawget(_G, "__nuppBrowser")
local relays: any = setmetatable({}, {__mode = "k"})
-- The text of a request its provider will not change once queued, so the frame
-- reuses it instead of encoding the request a second time. Under emulation that
-- second encode cost as much as the rest of the guest's work for the request.
-- A provider that adds to a queued request (the worker pool batches submissions
-- into one until it ships) leaves it out.
local frozenText: any = setmetatable({}, {__mode = "k"})

-- One frame carries at most this much: the guest's text slot is one MiB and the
-- bridge adds lease descriptors beside the requests, the lent bytes share a
-- two-MiB region, and the host answers at most this many requests per frame.
const FRAME_TEXT_BYTES = 960 * 1024
const FRAME_LEASE_BYTES = 2 * 1024 * 1024
const FRAME_LEASE_DESCRIPTOR_BYTES = 96
const FRAME_REQUESTS = 256

local function invalidResponse(detail: string): never
    error("nupp: browser application returned an invalid effect response: " .. detail, 0)
end

local function decodedResponse(text: any): (any, {any})
    if type(text) ~= "string" then
        invalidResponse("expected JSON text")
    end
    local decoded, response = pcall(json.decode, text)
    if not decoded then
        invalidResponse("invalid JSON")
    end
    if type(response) ~= "table" or json.isArray(response) then
        invalidResponse("expected an object")
    end
    if response.cancelled ~= nil and type(response.cancelled) ~= "boolean" then
        invalidResponse("cancelled must be boolean")
    end
    local responses = response.responses
    if responses == nil then
        responses = {}
    elseif type(responses) ~= "table" or not json.isArray(responses) then
        invalidResponse("responses must be an array")
    end
    local count: integer = 0
    local highest: integer = 0
    for key in pairs(responses) do
        if type(key) ~= "number" or key < 1 or key % 1 ~= 0 then
            invalidResponse("responses must be an array")
        end
        count = count + 1
        highest = math.max(highest, key)
    end
    if count ~= highest then
        invalidResponse("responses must be an array")
    end
    for _, item in ipairs(responses) do
        if type(item) ~= "table" or type(item.id) ~= "number" or item.id < 1 or item.id % 1 ~= 0 then
            invalidResponse("every response needs a positive integer id")
        end
    end

    return response, responses
end

function effects.request(
    kind: string,
    payload: any,
    resume: function(any): nil,
    discard: (function(any): nil)?,
    frozen: boolean?
): function()
    local id = nextId
    nextId = nextId + 1
    payload.id = id
    payload.kind = kind
    -- Refuse an unencodable payload here, where the offender is known. Failing at
    -- park time would raise in whichever coroutine happened to carry the batch and
    -- strand every other queued request's waiter.
    local encodable, encoded = pcall(json.encode, payload)
    if not encodable then
        error("nupp: browser effect " .. kind .. " has no JSON form: " .. tostring(encoded), 0)
    end
    if frozen then
        frozenText[payload] = encoded
    end
    queued[#queued + 1] = payload
    local active = true
    waiting[id] = function(response: any): nil
        if not active then
            return
        end
        active = false
        waiting[id] = nil
        resume(response)
    end

    -- Answers whether the request was still queued, and so never reached the host.

    return function(): boolean
        if not active then
            return false
        end
        active = false
        -- The host executes whatever a park carries, so a request cancelled before
        -- it shipped must leave the queue: a cancelled write must not still happen.
        for index = #queued, 1, -1 do
            if queued[index] == payload then
                table.remove(queued, index)
                waiting[id] = nil
                return true
            end
        end
        -- Past that point the host will run the request whatever this side does, so
        -- one that hands back a resource must still hear about it: dropping the
        -- waiter would strand an open file handle for the rest of the run.
        if discard == nil then
            waiting[id] = nil
            return false
        end
        waiting[id] = function(response: any): nil
            waiting[id] = nil
            discard(response)
        end

        return false
    end
end

local function leaseIdentifiers(request: any): {any}
    local found: {any} = {}
    if request.lease ~= nil then
        found[#found + 1] = request.lease
    end
    if request.bodyLease ~= nil then
        found[#found + 1] = request.bodyLease
    end
    if request.resultLease ~= nil then
        found[#found + 1] = request.resultLease
    end
    if type(request.spans) == "table" then
        for _, span in ipairs(request.spans) do
            if type(span) == "table" and span.lease ~= nil then
                found[#found + 1] = span.lease
            end
        end
    end

    return found
end

-- Takes, in submission order, the longest prefix of the queue one frame carries.
-- A request that does not fit waits whole for the next frame, so order is never
-- traded for packing; one that could never fit goes alone and fails as before.
local function takeFrame(): ({string}, boolean, {any})
    local guestMemory: any = browserHost ~= nil and browserHost.memory or nil
    local bytesOf: any = guestMemory ~= nil and rawget(guestMemory, "leaseBytes") or nil
    local taken: {string} = {}
    local text: integer = 0
    local lent: integer = 0
    local seen: {[any]: boolean} = {}
    local count: integer = #queued
    local index: integer = 1
    while index <= count and #taken < FRAME_REQUESTS do
        local request = queued[index]
        -- A request its provider may still add to is measured as it ships.
        local encoded: string = frozenText[request] or json.encode(request)
        local requestText: integer = #encoded
        local requestLent: integer = 0
        local leases = leaseIdentifiers(request)
        for _, lease in ipairs(leases) do
            if not seen[lease] then
                requestText = requestText + FRAME_LEASE_DESCRIPTOR_BYTES
                if bytesOf ~= nil then
                    requestLent = requestLent + (bytesOf(lease) as integer)
                end
            end
        end
        if #taken > 0 and (text + requestText > FRAME_TEXT_BYTES or lent + requestLent > FRAME_LEASE_BYTES) then
            break
        end
        for _, lease in ipairs(leases) do
            seen[lease] = true
        end
        text = text + requestText
        lent = lent + requestLent
        taken[#taken + 1] = encoded
        index = index + 1
    end
    local rest: {any} = {}
    for remaining = index, count do
        rest[#rest + 1] = queued[remaining]
    end

    return taken, #rest > 0, rest
end

local preparers: {function(): boolean} = {}

--- Runs `prepare` at the start of every park, before the frame is packed.
---
--- For a provider that keeps one request it adds to until the frame ships and
--- writes its final form, leases included, only then. `prepare` answers whether
--- it made something runnable, in which case the frame must not wait.
function effects.beforePark(prepare: function(): boolean): nil
    preparers[#preparers + 1] = prepare
end

--- Whether `thread` can wait on the page, or the main thread where it is nil.
---
--- True where no root has been recorded, which is every host but the guest bridge.
function effects.canParkFrom(thread: thread?): boolean
    local root = browserHost ~= nil and browserHost.root or nil
    if root == nil then
        return true
    end
    local current: any = thread
    while current ~= nil do
        if current == root then
            return true
        end
        current = relays[current]
    end

    return false
end

--- Whether the running coroutine can wait on the page.
function effects.canPark(): boolean
    return effects.canParkFrom((coroutine.running()))
end

--- Records that the running coroutine forwards `thread`'s parks to its own resumer.
---
--- For a driver that resumes a nested coroutine and yields whatever it yields, which
--- is what makes a park there a park on the page.
function effects.relay(thread: thread): nil
    relays[thread] = coroutine.running()
end

--- Whether a request has been made that the host has not answered.
---
--- Counts what is queued and what has shipped, including a cancelled request whose
--- answer still has a resource to hand back.
function effects.outstanding(): boolean
    return next(waiting) ~= nil
end

--- How many times the page has answered a park, which is what a turn is here.
function effects.turns(): integer
    return hostTurns
end

--- Hands the queued requests to the host and dispatches what it answers.
---
--- The host answers a request when it settles rather than when its batch does, so a
--- short sleep shipped beside a scope's deadline timer is not held until the
--- deadline. `turn` says this side owes the event loop a turn and has work of its
--- own to resume, so the host answers after one with whatever has settled;
--- otherwise it answers once something has.
---
--- @raises string where the running coroutine is not the application's root, where
---     the host answers malformed or cancels the application, or where a
---     dispatched callback raises
function effects.park(operation: string, turn: boolean?): nil
    if not effects.canPark() then
        error("nupp: " .. operation .. " cannot suspend here: only the browser application's root can wait", 0)
    end
    local runnable = false
    for _, prepare in ipairs(preparers) do
        if prepare() then
            runnable = true
        end
    end
    local encoded: string
    local wake = (turn == true or runnable) and "turn" or "any"
    if #queued == 0 then
        encoded = json.encode({kind = "poll", operation = operation, wake = wake,})
    else
        local taken, more, rest = takeFrame()
        -- What stays queued ships next frame, so this one must not wait for
        -- something to settle before it is answered.
        if more then
            wake = "turn"
        end
        encoded = '{"kind":"effects","requests":[' .. table.concat(taken, ",") .. '],"wake":"' .. wake .. '"}'
        queued = rest
    end
    local responseText = coroutine.yield(encoded)
    hostTurns = hostTurns + 1
    local response, responses = decodedResponse(responseText)
    if response.cancelled then
        error("nupp: browser application was cancelled", 0)
    end
    local dispatchFailure: any = nil
    for _, item in ipairs(responses) do
        local deliver = waiting[item.id]
        if deliver ~= nil then
            local delivered, problem = pcall(deliver, item)
            if not delivered and dispatchFailure == nil then
                dispatchFailure = problem
            end
        end
    end
    if dispatchFailure ~= nil then
        error(dispatchFailure, 0)
    end
end

export = effects
