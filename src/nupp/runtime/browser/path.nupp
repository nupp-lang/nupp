@!internal

module nupp.runtime.browser.path

--[[
Browser environment for the `host.path` API 1 contract.

Resource paths use `/` as their separator. The browser has no process working
directory or host filesystem to canonicalize, so those two environmental
operations return `nil` and an explanatory message.

Lexical path manipulation remains available through [](nupp.io.path). This module
returns only environmental operations checked against the canonical PathProvider;
it introduces no alternate Path type and performs no browser request or native
filesystem access when loaded.
]]

local contracts = require("nupp.runtime.services.contracts")
local provider = {}

function provider.separator(): string
    return "/"
end

function provider.currentDirectory(): (string?, string?)
    return nil, "the browser has no process working directory"
end

function provider.canonicalize(_path: string): (string?, string?)
    return nil, "the browser has no host filesystem to canonicalize"
end

-- Check every member against the canonical path provider contract.
local checked: contracts.PathProvider = {
    separator = provider.separator,
    currentDirectory = provider.currentDirectory,
    canonicalize = provider.canonicalize,
}

export = checked
