@!internal

module nupp.runtime.browser.time

--[[
Browser implementation of [](nupp.time.spi).

`now` returns monotonic milliseconds from the Worker time origin; `wallTime`
returns Unix milliseconds. Clock reads and sleeps use the shared response channel
and may suspend. Sleeps and deadlines reject non-finite or negative values.

`wakeAt` submits an absolute monotonic deadline without suspending the subscriber.
Its callback receives whether the host completed without an error, and its
returned cancellation function cancels the outstanding request. `sleepUntil`
computes the remaining interval using the same monotonic clock.

[](nupp.time) binds these operations at require-time. Timer handles and callbacks
belong to the current browser state and are not carried into worker lanes.
]]

local response = require("nupp.runtime.browser.response")
local contracts = require("nupp.time.spi")
local effects = require("nupp.runtime.browser.effects")
local time = {}
local browserHost = rawget(_G, "__nuppBrowser")

local function clock(value: any, label: string, nonNegative: boolean): number
    if type(value) ~= "number"
        or value ~= value
        or value == math.huge
        or value == -math.huge
        or (nonNegative and value < 0)
    then
        error("nupp: browser " .. label .. " returned an invalid clock value", 3)
    end

    return value
end

local function duration(value: number, label: string): number
    if value ~= value or value < 0 or value == math.huge then
        error("nupp: " .. label .. " must be a finite non-negative number", 3)
    end
    return value
end

--- Monotonic milliseconds since the Worker time origin.
function time.now(): number
    if browserHost ~= nil then
        return clock(browserHost.now(), "monotonic clock", true)
    end
    return clock(response.await("time", {operation = "now",}), "monotonic clock", true)
end

--- Unix time in milliseconds.
function time.wallTime(): number
    return clock(response.await("time", {operation = "wall",}), "wall clock", false)
end

--- Suspends for at least `milliseconds` without blocking the Worker thread.
function time.sleep(milliseconds: number): nil
    response.await("time", {operation = "sleep", milliseconds = duration(milliseconds, "sleep duration"),})
end

--- Suspends until an absolute monotonic deadline.
function time.sleepUntil(deadline: number): nil
    local remaining = duration(deadline, "deadline") - time.now()
    if remaining <= 0 then
        return
    end
    time.sleep(remaining)
end

--- Registers a cancellable timer without suspending its subscriber.
function time.wakeAt(deadline: number, resume: function(boolean): nil): function(): nil
    return effects.request(
        "time",
        {
            operation = "until",
            deadline = duration(deadline, "deadline")
        },
        function(result: any): nil
            resume(type(result) == "table" and result.ok == true)
        end
    )
end

local checked: contracts.Provider = {
    wakeAt = time.wakeAt,
    now = time.now,
    wallTime = time.wallTime,
    sleep = time.sleep,
    sleepUntil = time.sleepUntil,
}

export = checked
