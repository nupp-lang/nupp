@!internal

module nupp.runtime.browser.storage

--[[
Browser persistent key/value implementation of `host.storage` API 1.

Operations use IndexedDB through the application Worker and may suspend until
its response arrives. Values are UTF-8 strings. Keys must be nonempty and at most
1,024 bytes. Missing keys return `nil`; removal and clearing affect the storage
namespace managed by the browser host.

The host owns database lifetime, persistence, and quota policy. Failed requests
raise through the shared response mechanism. This module owns the checked
StorageProvider table and does not retain a database handle in Lua.

[](nupp.io.storage) resolves the implementation during module loading. Child
states acquire their own provider instance and use the host's storage policy.
]]

local response = require("nupp.runtime.browser.response")
local contracts = require("nupp.runtime.services.contracts")
local storage = {}

local function key(value: string): string
    if value == "" then
        error("nupp: browser storage key must not be empty", 3)
    elseif #value > 1024 then
        error("nupp: browser storage key exceeds 1024 bytes", 3)
    end

    return value
end

function storage.get(name: string): string?
    local value = response.await("storage", {operation = "get", key = key(name),})
    return value.found and value.value as string or nil
end

function storage.set(name: string, value: string): nil
    response.await("storage", {operation = "set", key = key(name), value = value,})
end

function storage.remove(name: string): nil
    response.await("storage", {operation = "remove", key = key(name),})
end

function storage.clear(): nil
    response.await("storage", {operation = "clear",})
end

-- Check every member against the canonical storage provider contract.
local checked: contracts.StorageProvider = {
    get = storage.get,
    set = storage.set,
    remove = storage.remove,
    clear = storage.clear,
}

export = checked
