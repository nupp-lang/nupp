@!internal
module nupp.runtime.browser.playground

const assert2 = require("assert")

-- Installed only in the playground application VM. The generated program is
-- loaded from the compiler's exact output bytes, and this checked runner owns
-- output capture without synthesizing Lua source in JavaScript.

local json = require("nupp.runtime.provider.lunajson")
local utf8 = require("utf8")
-- Carry the public serialization entry points in the application VM.
local derive = require("nupp.derive")
local serde = require("serde")
local dataJson = require("serde.json")
local document = require("serde.document")
local nativeValues = require("serde.native")
local adapters = require("serde.adapters")
local codecs = require("serde.codec")
local rendering = require("serde.debug")
-- The in-memory compiler resolves these public browser facades. Carry their
-- checked implementations so imports in user programs reach the same services.
local platformLibraries = {
    function()
        return require("nupp.runtime.provider.checksum")
    end,
    function()
        return require("nupp.runtime.provider.digest")
    end,
    function()
        return require("nupp.runtime.provider.mac")
    end,
    function()
        return require("binary")
    end,
    function()
        return table.Pool
    end,
    function()
        return os.randombytes
    end,
    function()
        return require("nupp.util.internal.uuid")
    end,
    function()
        return require("assert")
    end,
    function()
        return require("io.cli")
    end,
    function()
        return require("types")
    end,
    function()
        return require("types.reflect")
    end,
    function()
        return require("types.derive")
    end,
    function()
        return require("own")
    end,
    function()
        return require("simd")
    end,
    function()
        return require("events")
    end,
    function()
        return require("io.internal.path")
    end,
    function()
        return require("io.internal.uri")
    end,
    function()
        return require("nupp.runtime.standardio")
    end,
    function()
        return os.info
    end,
    function()
        return require("coroutine")
    end,
    function()
        return require("nupp.runtime.standardmath")
    end,
    function()
        return require("binary").mac
    end,
    function()
        return require("binary").digest
    end,
    function()
        return require("binary")
    end,
    function()
        return require("nupp.io.storage")
    end,
    function()
        return require("io.http")
    end,
    function()
        return require("io.gpu")
    end,
    function()
        return require("coroutine")
    end,
    function()
        return require("nupp.workers")
    end,
}

local lines: {string} = {}
local outputBytes = 0
local OUTPUT_LIMIT = 1048576

local function printable(value: string): string
    if utf8.isvalid(value) then
        return value
    end
    local pieces: {string} = {}
    local at: integer = 1
    while at <= #value do
        local codepoint, nextAt = utf8.decodeat(value, at)
        pieces[#pieces + 1] = utf8.encode(codepoint as integer)
        at = nextAt
    end

    return table.concat(pieces)
end

_G.print = function(...: any): nil
    local values: {string} = {}
    for index = 1, select("#", ...) do
        values[index] = tostring(select(index, ...))
    end
    local line = printable(table.concat(values, "\t"))
    outputBytes = outputBytes + #line + (#lines > 0 and 1 or 0)
    if outputBytes > OUTPUT_LIMIT then
        error("nupp: playground output exceeded 1048576 bytes", 0)
    end
    lines[#lines + 1] = line
end

_G.__nuppPlaygroundRun = function(source: string): string
    if derive == nil
        or serde == nil
        or dataJson == nil
        or document == nil
        or nativeValues == nil
        or adapters == nil
        or codecs == nil
        or rendering == nil
    then
        error("nupp: derive runtime did not load", 0)
    end
    assert2(#platformLibraries == 29, "nupp: browser library loaders are missing")
    lines = {}
    outputBytes = 0
    local chunk, problem = loadstring(source, "@playground.nupp")
    if chunk == nil then
        error(problem or "generated Lua did not load", 0)
    end
    chunk()

    return json.encode({stdout = table.concat(lines, "\n"),})
end

export = {}
