@!internal

module nupp.runtime.browser.workers

--[[
Browser structured-worker implementation of `host.workers` API 1.

Each lane is a module Web Worker with its own Lua 5.1 Wasm state, initialized from
the application's verified payload. The host pool exchanges copied messages;
parallel work requires neither Wasm threads nor shared memory. Sendable function
metadata, scopes, and task results follow [](nupp.runtime.services.workers).

Replies become visible when the current state parks. `isDone` reflects the last
received reply, queued cancellation settles at a park, and a running task observes
cancellation at a checkpoint that gives its event loop a turn. Scope cleanup
settles every child and preserves the shared cancellation identity.

Requiring this module captures the catalog selections and setup modules used to
initialize child states before their consumers load. Runtime-only registrations
need explicit destination setup. No provider instance or captured Lua closure is
transferred between lanes.
]]

@allow("unused-binding")
const DYNAMIC_REQUIRES = "@requires-dynamically nothing"

local base64 = require("nupp.codec.base64")
local browserEffects = require("nupp.runtime.browser.effects")
local codec = require("nupp.runtime.browser.workercodec")
local suspension = require("nupp.suspension")
local suspensionRuntime = suspension as any
local workers = {}
local workerConfiguration = require("nupp.services").workerConfiguration()

local contracts = require("nupp.runtime.services.workers")
local type Callable = function(...: any): any
type workers.Submittable = contracts.Submittable
type workers.Task<F is Callable> = contracts.Task<F>
local type Packed = {
    values: {any},
    count: integer
}

local function pack(...: any): Packed
    return {values = {...}, count = select("#", ...)}
end

--- Runs one body protected, letting it park on the Wasm host boundary.
---
--- Stock Lua 5.1 cannot yield through `pcall`, and every wait a browser application
--- performs is a yield out to JavaScript. So the body runs on its own coroutine and
--- this forwards whatever it yields, which is the same shape the generated cleanup
--- regions use with the selected suspension provider.
local function protectedCall(body: function(): any): (boolean, any)
    -- The resumed value belongs to whichever `coroutine.yield` inside the body is
    -- waiting for it, not to the body's own parameters, which is a shape the typed
    -- coroutine pack has no way to name.
    --
    -- Created through the suspension provider so the body inherits any installed
    -- handler: a raw coroutine would park on the host boundary instead, and inside
    -- a `nupp.suspension` branch that boundary yield is discarded by the driver.
    local thread: any = suspension.create(body)
    local passed: any = nil
    while true do
        local ok, value = coroutine.resume(thread, passed)
        if not ok then
            return false, value
        end
        if coroutine.status(thread) == "dead" then
            return true, value
        end
        -- The park is the inner thread's, handed on to whoever drives this frame,
        -- which resumes it as the scheduler does every other park. Written as a
        -- raw yield because that is what forwarding is, and under `unsafe` because
        -- callers hold borrows across it -- `Scope.close` settling its tasks -- and
        -- the driver, not a handler, is what answers for the continuation.
        unsafe do
            passed = coroutine.yield(value)
        end
    end
end

local type SendableDescriptor = {
    module: string,
    member: string,
    captures: Packed
}

local registeredSendables = rawget(_G.nupp, "__workerSendables")
if type(registeredSendables) ~= "table" then
    registeredSendables = setmetatable({}, {__mode = "k"})
    rawset(_G.nupp, "__workerSendables", registeredSendables)
end
local sendableDescriptors = registeredSendables as {[any]: SendableDescriptor}
local outlinedSendables: {[string]: any} = {}

local function sendableKey(moduleName: string, member: string): string
    return moduleName .. "\0" .. member
end

--- Compiler hook: publishes an outlined body when its module loads in this Lua state.
local function defineSendable(moduleName: string, member: string, fn: any): nil
    outlinedSendables[sendableKey(moduleName, member)] = fn
end

--- Compiler hook: associates a local closure with its loadable body and captures.
local function describeSendable(fn: any, moduleName: string, member: string, ...: any): any
    sendableDescriptors[fn] = {module = moduleName, member = member, captures = pack(...)}
    return fn
end

workers.defineSendable = defineSendable
workers.describeSendable = describeSendable

-- A function with no compiler descriptor is located by scanning every loaded module
-- once; the answer is a property of the function value, so it is kept. Failures are
-- not, because the module that will publish the function may not have loaded yet.
local scannedAddresses: {[any]: {string}} = setmetatable({}, {__mode = "k"}) as {[any]: {string}}

local function callableAddress(fn: any): (string?, string?)
    local described = sendableDescriptors[fn]
    if described ~= nil then
        return described.module, described.member
    end
    local scanned = scannedAddresses[fn]
    if scanned ~= nil then
        return scanned[1], scanned[2]
    end
    local found: {string} = {}
    local loaded = package.loaded as {[any]: any}
    for moduleName, moduleValue in pairs(loaded) do
        if type(moduleName) == "string" and type(moduleValue) == "table" then
            for member, value in pairs(moduleValue as {[any]: any}) do
                if type(member) == "string" and value == fn then
                    found[#found + 1] = moduleName .. "\0" .. member
                end
            end
        end
    end
    table.sort(found)
    local address = found[1]
    if address == nil then
        return nil, nil
    end
    local moduleName, member = address:match("^(.-)%z(.*)$")
    scannedAddresses[fn] = {moduleName as string, member as string}

    return moduleName, member
end

--- The runtime state of a child computation.
local record TaskImpl
    _id: integer
    _state: string
    _values: {any}
    _count: integer
    _error: string?
    _cancelled: any
    _bytes: integer
    _observed: boolean
    _requested: boolean
    _awaiting: boolean
    _answer: any
    _resume: any
    _observer: any

    --- Waits for the child and returns exactly the values its function returned.
    await: function(TaskImpl): ...any

    --- Whether the child has settled and its reply has reached this Lua state.
    isDone: nosuspend function(TaskImpl): boolean

    status: nosuspend function(TaskImpl): string

    cancel: nosuspend function(TaskImpl, string?): boolean
end

type workers.ScopeToken = contracts.ScopeToken
type workers.Scope = contracts.Scope
workers.Scope = contracts.Scope

local TaskMT: metatable<TaskImpl> = {__index = TaskImpl}
local ScopeMT: metatable<workers.Scope> = {__index = workers.Scope}

-- The same bounds the native scheduler publishes for one lane direction. Submission
-- raises when either is reached rather than turning producer backpressure into a
-- hidden wait.
local MAX_UNSETTLED: integer = 1024
local MAX_UNSETTLED_BYTES: integer = 268435456

-- How many replies a closing scope asks for before it waits on the first of them.
-- The same number of child activations `nupp.tasks` consumes in one host turn.
local DRAIN_WINDOW: integer = 64

local unsettled: {[integer]: any} = {}
local unsettledCount: integer = 0
local unsettledBytes: integer = 0
local nextTaskId: integer = 1

-- True in a lane's own state, where the scheduler loop is what runs. A lane may not
-- open a worker scope: its state cannot submit back into the page's pool without
-- risking a lane that waits on itself.
local laneActive: boolean = false

--- Issues one pool request and answers with the value the host returned.
--- @raises where the pool refused the request or answered nothing
local function answered(item: any): any
    if item == nil then
        error("nupp: the worker pool answered nothing", 0)
    end
    if item.ok ~= true then
        error("nupp: worker scheduling failed: " .. tostring(item.error), 0)
    end

    return item.value
end

--- Applies the task starts the pool reported alongside any answer.
local function deliverStarts(value: any): nil
    for _, id in ipairs(value ~= nil and value.started or {}) do
        local task = unsettled[id as integer]
        if task ~= nil and task._state == "queued" then
            task._state = "running"
        end
    end
end

local function notifySettled(task: any): nil
    local observer = task._observer
    if observer ~= nil and observer.settled ~= nil then
        observer.settled(observer, task, task._state, task._error or task._cancelled)
    end
end

local function release(task: any): nil
    if unsettled[task._id] == nil then
        return
    end
    unsettled[task._id] = nil
    unsettledCount = unsettledCount - 1
    unsettledBytes = unsettledBytes - (task._bytes as integer)
end

local function settle(task: any, value: any): nil
    deliverStarts(value)
    if task._state == "done" or task._state == "failed" or task._state == "cancelled" then
        return
    end
    local status = value ~= nil and value.status or nil
    if status == "done" then
        local packed = codec.decode(base64.decode(value.payload as string))
        task._values = packed.values
        task._count = packed.count
        task._state = "done"
    elseif status == "cancelled" then
        task._cancelled = task._cancelled or suspensionRuntime.__taskCancellation(
            "worker task",
            value.deadline == true and "its deadline passed" or nil
        )
        task._state = "cancelled"
    else
        task._error = value ~= nil and value.error or "worker task failed without an error"
        task._state = "failed"
    end
    release(task)
    notifySettled(task)
end

--- Queues one pool request. The browser effect layer sends it with whatever else is
--- queued at the next park, so submission itself never waits.
local function poolRequest(payload: any, resume: function(any): nil): function()
    payload.setup = workerConfiguration
    return browserEffects.request("workers", payload, resume)
end

-- Submissions made between two parks travel as one request rather than one each.
-- The effect layer holds the payload table until the park encodes it, so a spawn
-- appends to a batch already queued: a thousand children cost the host one message
-- and stay well inside an application's effect budget.
local pendingSubmission: any = nil

--- Adds one submission to the batch this park will carry.
local function submit(entry: any): nil
    local batch = pendingSubmission
    if batch == nil then
        batch = {operation = "submit", tasks = {},}
        pendingSubmission = batch
        poolRequest(batch, function(item: any): nil
            pendingSubmission = nil
            local value = item ~= nil and item.ok == true and item.value or nil
            local refused = item ~= nil and item.error or "the worker pool refused a batch"
            deliverStarts(value)
            for _, rejected in ipairs(value ~= nil and value.rejected or {}) do
                local task = unsettled[rejected.task as integer]
                if task ~= nil then
                    settle(task, {status = "failed", error = rejected.error,})
                end
            end
            if value ~= nil then
                return
            end
            -- Nothing was accepted, so every child in the batch failed with it.
            for _, one in ipairs(batch.tasks) do
                local task = unsettled[one.task as integer]
                if task ~= nil then
                    settle(task, {status = "failed", error = refused,})
                end
            end
        end)
    end
    local tasks = batch.tasks as {any}
    tasks[#tasks + 1] = entry
end

function TaskImpl:isDone(): boolean
    return self._state == "done" or self._state == "failed" or self._state == "cancelled"
end

function TaskImpl:status(): string
    return self._state
end

function TaskImpl:cancel(reason: string?): boolean
    if self:isDone() or self._requested then
        return false
    end
    self._requested = true
    self._cancelled = suspensionRuntime.__taskCancellation("worker task", reason)
    poolRequest({operation = "cancel", task = self._id, reason = reason,}, function(item: any): nil
        deliverStarts(item ~= nil and item.ok == true and item.value or nil)
    end)

    return true
end

--- Asks the pool for one task's reply, at most once per task.
---
--- Registering the request is separate from waiting for it so that a scope closing
--- over many children asks for a window of replies and then waits, the way the
--- native scheduler drains every lane in one poll pass rather than locking each
--- lane again for every awaiter.
local function ensureAwait(task: any): nil
    if task._awaiting or task:isDone() then
        return
    end
    task._awaiting = true
    poolRequest({operation = "await", task = task._id,}, function(item: any): nil
        task._answer = item
        local waiters = task._resume
        if waiters ~= nil then
            task._resume = nil
            for index = 1, #waiters do
                waiters[index](true)
            end
        end
    end)
end

--- Turns one delivered reply into the task's settled state.
local function consume(task: any): nil
    local answer = task._answer
    task._answer = nil
    task._awaiting = false
    settle(task, answered(answer))
end

--- Waits for one task through the installed suspension handler, or on the host
--- boundary where there is none, exactly as an ordinary browser effect does.
local function awaitSettlement(task: any): nil
    if task:isDone() then
        return
    end
    ensureAwait(task)
    if task._answer == nil then
        -- One reply may have several awaiters, so each parks in its own slot of a
        -- waiter list; a single slot would strand every awaiter but the last.
        suspension.suspend("worker task", function(resume: function(any): nil): function()
            local waiters = task._resume
            if waiters == nil then
                waiters = {}
                task._resume = waiters
            end
            waiters[#waiters + 1] = resume

            return function(): nil
                for index = #waiters, 1, -1 do
                    if waiters[index] == resume then
                        table.remove(waiters, index)
                        break
                    end
                end
            end
        end)
    end
    -- Whichever awaiter runs first consumes the reply; later ones find the task
    -- already settled.
    if not task:isDone() then
        consume(task)
    end
end

--- Settles one task for a task scope's `fork`, answering rather than raising. The
--- same answer the native provider gives, so the task scope's failure rule holds on
--- either.
local function settleForScope(task: any): (string, {any}?, integer, any)
    task._observed = true
    awaitSettlement(task)
    if task._state == "failed" then
        return "failed", nil, 0, "nupp: worker task failed: " .. (task._error or "unknown failure")
    end
    if task._state == "cancelled" then
        return "cancelled", nil, 0, task._cancelled
    end

    return "done", task._values, task._count, nil
end

workers.settle = settleForScope

function TaskImpl:await(): ...any
    self._observed = true
    awaitSettlement(self)
    if self._state == "failed" then
        error("nupp: worker task failed: " .. (self._error or "unknown failure"), 2)
    end
    if self._state == "cancelled" then
        error(self._cancelled, 2)
    end

    return unpack(self._values, 1, self._count)
end

local function spawnImpl(self: workers.Scope, fn: any, ...: any): any
    if self._closed then
        error("nupp: cannot spawn into a closed worker scope", 2)
    end
    local moduleName, member = callableAddress(fn)
    if moduleName == nil or member == nil then
        error("nupp: this function has no sendable module outline", 2)
    end
    local descriptor = sendableDescriptors[fn]
    local captures = descriptor and descriptor.captures or pack()
    local arguments = pack(...)
    codec.validate(captures, arguments)
    local submitted = arguments
    if captures.count > 0 then
        submitted = {values = {}, count = captures.count + arguments.count}
        for index = 1, captures.count do
            submitted.values[index] = captures.values[index]
        end
        for index = 1, arguments.count do
            submitted.values[captures.count + index] = arguments.values[index]
        end
    end
    local payload = base64.encode(codec.encode(submitted))
    if unsettledCount >= MAX_UNSETTLED or unsettledBytes + #payload > MAX_UNSETTLED_BYTES then
        error("nupp: a worker queue is closed or full", 2)
    end
    local id = nextTaskId
    nextTaskId = id + 1
    local task = setmetatable(
        {
            _id = id,
            _state = "queued",
            _values = {},
            _count = 0,
            _error = nil,
            _cancelled = nil,
            _bytes = #payload,
            _observed = false,
            _requested = false,
            _awaiting = false,
            _answer = nil,
            _resume = nil,
            _observer = self._observer,
        },
        TaskMT
    )
    unsettled[id] = task
    unsettledCount = unsettledCount + 1
    unsettledBytes = unsettledBytes + #payload
    submit({task = id, module = moduleName, member = member, payload = payload, deadline = self._deadline,})
    self._tasks[#self._tasks + 1] = task
    if self._observer ~= nil and self._observer.created ~= nil then
        self._observer.created(self._observer, task)
    end

    return task
end

local spawnSurface: function<F is workers.Submittable>(
    borrows self: workers.Scope,
    F,
    ...: unpackof contracts.Submitted(F)
): workers.Task<F>
unsafe do
    spawnSurface = spawnImpl as any
end

--- Settles every child, answering the first failure the body never observed.
---
--- Every sibling settles whatever any one of them did, so a structured scope never
--- abandons a live child, and a failure nothing awaited is the caller's to raise.
local function settleAll(children: {any}, wait: function(any): nil): any?
    -- Replies are asked for ahead of the child being waited on, so closing a scope
    -- over many children costs a park for every window rather than one each. The
    -- window is bounded because a park carries every queued request together and an
    -- application's effect budget is what it has to fit inside.
    for index = 1, math.min(DRAIN_WINDOW, #children) do
        ensureAwait(children[index])
    end
    local firstFailure: any = nil
    for index, task in ipairs(children) do
        local ahead = children[index + DRAIN_WINDOW]
        if ahead ~= nil then
            ensureAwait(ahead)
        end
        local observed = task._observed == true
        local ok, problem = protectedCall(function(): nil
            wait(task)
        end)
        if ok and not observed and task._state == "failed" then
            problem = "nupp: worker task failed: " .. (task._error or "unknown failure")
            ok = false
        end
        if not ok and not observed and firstFailure == nil then
            firstFailure = problem
        end
    end

    return firstFailure
end

local function closeScope(borrows self: workers.Scope): nil
    if self._closed then
        return
    end
    self._closed = true
    local firstFailure = settleAll(self._tasks, awaitSettlement)
    if firstFailure ~= nil then
        error(firstFailure, 2)
    end
end

local function dropScope(takes self: workers.Scope): nil
    local state = unsafe release self
    closeScope(state)
end

local function cancelAllScope(self: workers.Scope, reason: string?): nil
    for _, task in ipairs(self._tasks) do
        task:cancel(reason)
    end
end

local function openScope(deadline: number?, observer: any): workers.Scope
    if laneActive then
        error("nupp: a worker task cannot open another worker scope", 3)
    end

    return setmetatable(
        {
            spawn = spawnSurface,
            close = closeScope,
            drop = dropScope,
            _cancelAll = cancelAllScope,
            _tasks = {},
            _closed = false,
            _deadline = deadline,
            _observer = observer,
        },
        ScopeMT
    ) as workers.Scope
end

--- Opens a structured family on the page's bounded worker pool.
function workers.scope(): affine(workers.Scope)
    return openScope(nil, nil)
end

workers.openScope = openScope

--- How many lanes the page's pool runs, which is what a caller sizes chunks against.
local function parallelism(): integer
    local answer: any = nil
    poolRequest({operation = "lanes",}, function(item: any): nil
        answer = item
    end)
    while answer == nil do
        browserEffects.park("worker lanes")
    end

    return (answered(answer).lanes or 1) as integer
end

workers.parallelism = parallelism

----------------------------------------------------------------------------
-- The lane
----------------------------------------------------------------------------

--- Exchanges one lane frame with the host: an optional reply, then the next task.
local function laneExchange(payload: any): any
    local answer: any = nil
    browserEffects.request("lane", payload, function(item: any): nil
        answer = item
    end)
    while answer == nil do
        browserEffects.park("worker lane")
    end

    return answered(answer)
end

local checkpointCancelled: boolean = false
local checkpointDeadline: boolean = false

local function laneCheckpoint(): (boolean, boolean)
    if checkpointCancelled then
        return true, checkpointDeadline
    end
    local answer = laneExchange({operation = "checkpoint",})
    checkpointCancelled = answer.cancelled == true
    checkpointDeadline = answer.deadline == true

    return checkpointCancelled, checkpointDeadline
end

--- Runs one task frame and answers the reply the pool should carry back.
local function runFrame(frame: any): any
    checkpointCancelled = false
    checkpointDeadline = false
    local ok, answer = protectedCall(function(): Packed
        local moduleName = frame.module as string
        local member = frame.member as string
        local moduleValue = require(moduleName)
        local callable = outlinedSendables[
            sendableKey(moduleName, member)
        ] or (type(moduleValue) == "table" and (moduleValue as {[string]: any})[member] or nil)
        if type(callable) ~= "function" then
            error(("%s.%s is not a registered sendable function"):format(moduleName, member), 0)
        end
        local arguments = codec.decode(base64.decode(frame.payload as string))

        return pack(callable(unpack(arguments.values, 1, arguments.count)))
    end)
    if not ok then
        if suspensionRuntime.__isTaskCancellation(answer) then
            local cancelled = answer as any
            return {
                operation = "reply",
                task = frame.task,
                status = "cancelled",
                deadline = cancelled.reason == "its deadline passed",
            }
        end

        return {operation = "reply", task = frame.task, status = "failed", error = tostring(answer),}
    end
    local produced = answer as Packed
    local transfer = {seen = {}, records = nil, addresses = nil}
    local rejected = codec.unsendable(produced.values, "results", 0, transfer)
    if rejected ~= nil then
        return {
            operation = "reply",
            task = frame.task,
            status = "failed",
            error = "results cannot be copied: " .. rejected,
        }
    end

    return {operation = "reply", task = frame.task, status = "done", payload = base64.encode(codec.encode(produced)),}
end

--- Runs the lane loop inside one worker Lua state. Compiler-owned bootstrap only.
---
--- The generated bundle calls this when the page's lane entry point boots the payload
--- with this module named as its worker entry, so a lane never runs the application's
--- own entry module.
function workers.runScheduler(): nil
    laneActive = true
    rawset(_G.nupp, "__workerCheckpoint", laneCheckpoint)
    local reply: any = {operation = "next"}
    while true do
        local frame = laneExchange(reply)
        if frame == nil or frame.task == nil then
            return
        end
        reply = runFrame(frame)
    end
end

@allow("unused-binding")
local checked: contracts.Provider = workers

export = workers
