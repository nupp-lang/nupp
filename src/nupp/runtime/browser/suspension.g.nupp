@!internal

module nupp.runtime.browser.suspension

--[[
Browser-effect implementation of the `suspension` API 1 contract.

Parking yields through the browser effect channel, which only the application's
root coroutine can reach: a wait with no handler anywhere else is refused, as is
one that nothing queued, in flight, or registered could complete. Source polling,
nested handler restoration, and subscription cleanup implement the same canonical
records declared by [](nupp.suspension.spi).

A bounded activation budget returns control to the browser event loop so queued
callbacks and cancellation can make progress. Resume settles a wait once;
release removes registrations without suspending. Tasks and worker lanes use
[](nupp.suspension.cancellation) for cancellation identity.

The browser host must install its effect transport before consumers load
[](nupp.suspension). Handler, source, and waiting state stays local to each Lua
state, and scheduling operations never resolve the service again.
]]

local effects = require("nupp.runtime.browser.effects")
local contract = require("nupp.suspension.spi")
local suspension = {}
local running = coroutine.running
local sources: {any} = {}
local sourceSequence: integer = 0
local sourcesVersion: integer = 0
local ownedSources: any = setmetatable({}, {__mode = "k"})

-- How many child activations an aggregate may run before it owes the host a turn.
-- The same budget the native provider spends and for the same reason: a scope that
-- never yields starves whatever else the host is driving. What a turn *is* differs.
-- Natively it is a poll of the readiness sources; here it is the page answering a
-- park, which is the only wait this host has. Deferring is an ordinary suspension on
-- that, so a driver running inside a child parks through the child's handler rather
-- than yielding its caller's coroutine out from under it.
local ACTIVATIONS_PER_TURN: integer = 64
local TURN_ORDER: integer = 30
local turnRemaining: integer = ACTIVATIONS_PER_TURN
local turnHost: any = nil
local turnGeneration: integer = -1

type suspension.Source = contract.Source
suspension.Source = contract.Source

-- The registration's own state lives on the table rather than on the record, which
-- declares only what a holder may read. Nothing outside this file reads these.
local sourcerelease: @nosuspend function(contract.Source): nil = function(self: contract.Source): nil
    const registration = self as any
    if registration._released then
        return
    end
    registration._released = true
    for index = 1, #sources do
        if rawequal(sources[index], self) then
            table.remove(sources, index)
            sourcesVersion = sourcesVersion + 1
            break
        end
    end
end

type suspension.Context = contract.Context
suspension.Context = contract.Context

local function contextsource(
    self: contract.Context,
    name: string,
    order: integer,
    poller: function(): integer,
    waiter: (function(integer): integer)?,
    active: (function(suspension.Source): boolean)?
): suspension.Source
    local source = suspension.source(name, order, poller, waiter, active)
    local associated = assert((self as any)._associated)
    associated[#associated + 1] = source
    local owned = ownedSources[self]
    if owned == nil then
        owned = {}
        ownedSources[self] = owned
    end
    owned[#owned + 1] = source

    return source
end

local function contextuses(self: contract.Context, source: suspension.Source): nil
    if source == nil or (source as any)._released then
        error("nupp: cannot use a released readiness source", 2)
    end
    local associated = assert((self as any)._associated)
    associated[#associated + 1] = source
end

local function releaseOwned(context: contract.Context): nil
    local owned = ownedSources[context]
    if owned == nil then
        return
    end
    ownedSources[context] = nil
    for index = 1, #owned do
        owned[index]:release()
    end
end

-- Not a context member: whether a park is permitted belongs to the handler in force,
-- which `canSuspend` answers.
local function contextcanPark(self: contract.Context): boolean
    const handler = (self as any)._handler
    if handler == nil then
        return effects.canPark()
    end

    return handler.canPark == nil or handler:canPark() ~= false
end

type suspension.Waiting = contract.Waiting
suspension.Waiting = contract.Waiting

local function waitingready(self: contract.Waiting): boolean
    return (self as any)._state.ready
end

local function waitingonResume(self: contract.Waiting, wake: function(): nil): nil
    -- Settle-safe, as the native provider is: a wait that has already settled wakes
    -- its scheduler now rather than storing a waker nothing will fire, so a handler
    -- may arm once and then yield until ready.
    const state = (self as any)._state
    if state.ready then
        wake()

        return
    end
    state.wake = wake
end

type suspension.Handler = contract.Handler
suspension.Handler = contract.Handler

type suspension.Installed = contract.Installed
suspension.Installed = contract.Installed

local function closeInstallation(self: any): nil
    if self._released then
        return
    end
    self._released = true
    if self._co == nil then
        suspension._main = self._previous
    else
        suspension._installed[self._co] = self._previous
    end
    self.handler:shutdown()
end

suspension._installed = setmetatable({}, {__mode = "k"})
suspension._main = nil

local function sourceBefore(left: any, right: any): boolean
    if left.order ~= right.order then
        return left.order < right.order
    end
    if left.name ~= right.name then
        return left.name < right.name
    end

    return left._sequence < right._sequence
end

local function firstSourceAfter(source: any): integer
    local first: integer = 1
    local last: integer = (#sources + 1) as integer
    while first < last do
        local middle = math.floor((first + last) / 2) as integer
        if middle <= #sources and not sourceBefore(source, sources[middle]) then
            first = middle + 1
        else
            last = middle
        end
    end

    return first
end

local function installation(): any
    local coroutine = running()
    local current = coroutine == nil and suspension._main or suspension._installed[coroutine]
    while current ~= nil and current._released do
        current = current._previous
    end

    return current
end

local function handler(): any
    local current = installation()
    return current and current.handler or nil
end

local function boundedTurnHost(): any
    local host = installation()
    if host == nil then
        return nil
    end
    while true do
        local previous = host._previous
        while previous ~= nil and previous._released do
            previous = previous._previous
        end
        if previous == nil then
            break
        end
        host = previous
    end
    if host.transparent then
        return nil
    end

    return host
end

--- The bounded host this turn belongs to, with a fresh budget once the page has
--- answered a park or the host has changed.
local function currentTurnHost(): any
    local host = boundedTurnHost()
    if host == nil then
        return nil
    end
    local generation = effects.turns()
    if turnHost ~= host or turnGeneration ~= generation then
        turnHost = host
        turnGeneration = generation
        turnRemaining = ACTIVATIONS_PER_TURN
    end

    return host
end

--- Whether the aggregate here may spend another activation before it owes a turn.
function suspension.turnAvailable(): boolean
    if currentTurnHost() == nil then
        return true
    end

    return turnRemaining > 0
end

--- Records one coroutine activation against the current turn.
function suspension.consumeTurn(): nil
    if currentTurnHost() == nil then
        return
    end
    if turnRemaining > 0 then
        turnRemaining = turnRemaining - 1
    end
end

--- Whether a registered readiness source has something outstanding, which only a
--- poll after a host turn can observe. A source that cannot say is assumed to.
local function sourcesActive(): boolean
    for index = 1, #sources do
        local source = sources[index] as any
        local active = source.active
        if not source._released and (active == nil or (active as function(suspension.Source): boolean)(source)) then
            return true
        end
    end

    return false
end

--- Waits on the page until `ready` returns true, polling what each answer woke.
---
--- A wait nothing can complete is refused rather than left polling the page: with no
--- request outstanding and no source answering that it has something pending, no
--- answer the page could give would change anything.
---
--- @raises string where nothing could complete the wait, or where the park itself
---     raises
local function hostWait(operation: string, ready: function(): boolean): nil
    while not ready() do
        local turn = sourcesActive()
        if not turn and not effects.outstanding() then
            error(("nupp: %s cannot complete: no readiness source is registered"):format(operation), 0)
        end
        effects.park(operation, turn)
        suspension.poll()
    end
end

local turnWaiters: {any} = {}
local turnSource: any = nil

--- Resumes every deferral registered before the page last answered a park.
local function openNextTurn(): integer
    local generation = effects.turns()
    local waking: {any} = {}
    for index = #turnWaiters, 1, -1 do
        local waiter = turnWaiters[index]
        if waiter.generation < generation then
            table.remove(turnWaiters, index)
            table.insert(waking, 1, waiter)
        end
    end
    for index = 1, #waking do
        waking[index].resume(true)
    end

    return #waking as integer
end

local function turnDeferralSource(): suspension.Source
    local existing = turnSource
    if existing ~= nil and not existing._released then
        return existing
    end
    local created = suspension.source("nupp.suspension.turn", TURN_ORDER, openNextTurn, nil, function(
        _: suspension.Source
    ): boolean
        return #turnWaiters > 0
    end)
    turnSource = created

    return created
end

--- Parks until the page has answered a park, which is what a turn is here.
function suspension.deferTurn(): nil
    suspension.suspend("nupp coroutine turn budget", function(
        resume: function(boolean): nil,
        context: suspension.Context
    ): function()
        context:uses(turnDeferralSource())
        local waiter = {resume = resume, generation = effects.turns(),}
        turnWaiters[#turnWaiters + 1] = waiter

        return function(): nil
            for index = #turnWaiters, 1, -1 do
                if turnWaiters[index] == waiter then
                    table.remove(turnWaiters, index)

                    break
                end
            end
        end
    end)
end

function suspension.source(
    name: string,
    order: integer,
    poller: function(): integer,
    waiter: (function(integer): integer)?,
    active: (function(suspension.Source): boolean)?
): suspension.Source
    sourceSequence = sourceSequence + 1
    local source = new contract.Source(
        release = sourcerelease,
        name = name,
        order = order,
        wait = waiter,
        active = active
    )
    const registration = source as any
    registration._sequence = sourceSequence
    registration._poller = poller
    registration._released = false
    table.insert(sources, firstSourceAfter(source), source)
    sourcesVersion = sourcesVersion + 1

    return source
end

function suspension.poll(): integer
    local settled: integer = 0
    local boundary = sourceSequence
    local version = sourcesVersion
    local index: integer = 1
    while index <= #sources do
        local source = sources[index] as any
        if source._sequence > boundary then
            index = (index + 1) as integer
        else
            settled = settled + ((source._poller as function(): integer)() or 0)
            if sourcesVersion == version then
                index = (index + 1) as integer
            else
                index = firstSourceAfter(source)
                version = sourcesVersion
            end
        end
    end

    return settled
end

function suspension.handled(): boolean
    return handler() ~= nil
end

--- Whether the handler this one is about to displace would permit a park.
---
--- Captured where it is asked rather than where it is answered, so an installation
--- that wants to defer to the one it replaced keeps asking the outer handler after
--- it has taken the slot.
function suspension.delegatedCanPark(): function(): boolean
    local captured = installation()
    -- Where there is no outer handler, the question is whether the frame asking to
    -- displace it could reach the page, not whichever child asks later.
    local capturedThread = running()

    return function(): boolean
        local current = captured
        while current ~= nil and current._released do
            current = current._previous
        end
        local outer = current ~= nil and current.handler or nil
        if outer == nil then
            return effects.canParkFrom(capturedThread)
        end
        if outer.canPark == nil then
            return true
        end

        return outer.canPark(outer) ~= false
    end
end

--- Captures how a wait is parked here, for a driver about to displace the handler.
function suspension.delegatedPark(): function(suspension.Waiting, function(): nil): nil
    local captured = installation()

    return function(waiting: suspension.Waiting, cancel: function(): nil): nil
        local current = captured
        while current ~= nil and current._released do
            current = current._previous
        end
        local outer = current ~= nil and current.handler or nil
        if outer ~= nil then
            outer.park(outer, waiting, cancel)

            return
        end
        hostWait(waiting.operation, function(): boolean
            return waiting:ready()
        end)
    end
end

--- Builds a Waiting that settles when `base` does or when `ready` returns true.
---
--- A driver parks outward on the result, so the park it hands to its host is woken
--- both by the wait it was given and by its own work becoming runnable. There is no
--- routing state to carry here: the only wait this host has is the page answering a
--- park, which `hostWait` reaches through `ready` alone.
---
--- @param base the wait a driver was handed
--- @param ready whether the driver has something of its own to do
--- @param arm registers the driver's wakers against the supplied callback
--- @return the wait to park outward on
function suspension.derive(
    base: suspension.Waiting,
    ready: function(): boolean,
    arm: function(function(): nil): nil
): suspension.Waiting
    local derived = new contract.Waiting(
        ready = function(_: contract.Waiting): boolean
            return base:ready() or ready()
        end,
        onResume = function(_: contract.Waiting, wake: function(): nil): nil
            -- Once per registration: both halves can settle in the same turn, and a
            -- scheduler queued twice for one park would run the second activation
            -- against a wait that is already over.
            local woke = false

            const function wakeOnce(): nil
                if woke then
                    return
                end
                woke = true
                wake()
            end

            base:onResume(wakeOnce)
            arm(wakeOnce)
        end,
        operation = base.operation
    )

    return derived
end

function suspension.canSuspend(): boolean
    local current = handler()
    if current == nil then
        return effects.canPark()
    end

    return current.canPark == nil or current:canPark() ~= false
end

function suspension.suspend<T>(
    operation: string,
    subscribe: function(function(T): nil, suspension.Context): (function()?)
): T
    local current = handler()
    local state: any = {ready = false, value = nil, wake = nil,}

    local function resume(value: T): nil
        if state.ready then
            error("nupp: " .. operation .. " was resumed twice", 0)
        end
        state.ready = true
        state.value = value
        if state.wake ~= nil then
            local wake = state.wake
            state.wake = nil
            wake()
        end
    end

    local context = new contract.Context(source = contextsource, uses = contextuses)
    const scoped = context as any
    scoped._handler = current
    scoped._associated = {}
    local subscribed, cancel = pcall(subscribe, resume, context)
    if not subscribed then
        releaseOwned(context)
        error(cancel, 0)
    end
    if state.ready then
        releaseOwned(context)
        return state.value as T
    end
    if cancel == nil then
        releaseOwned(context)
        error("nupp: " .. operation .. " did not provide a cancellation", 0)
    end
    if not contextcanPark(context) then
        pcall(cancel)
        releaseOwned(context)
        error("nupp: " .. operation .. " cannot suspend here", 0)
    end
    local waiting = new contract.Waiting(ready = waitingready, onResume = waitingonResume, operation = operation)
    const settlement = waiting as any
    settlement._state = state
    local parked: boolean, problem: any
    if current ~= nil then
        parked, problem = pcall(current.park, current, waiting, cancel)
    else
        parked, problem = pcall(hostWait, operation, function(): boolean
            return state.ready
        end)
    end
    if not parked then
        -- Every failed park unsubscribes: a park that raised left the subscription
        -- live, and nobody else is going to take it down.
        pcall(cancel)
        releaseOwned(context)
        error(problem, 0)
    end
    if not state.ready then
        pcall(cancel)
        releaseOwned(context)
        error("nupp: " .. operation .. " returned without resuming", 0)
    end
    releaseOwned(context)

    return state.value as T
end

-- What `install` and `installDriver` share. A driver differs only in not bounding a
-- host turn, which is one flag in the extent's own state rather than a parameter
-- either entry point asks its caller about.
local function installHandler(value: suspension.Handler, transparent: boolean): affine(contract.Installed)
    local coroutine = running()
    local previous = coroutine == nil and suspension._main or suspension._installed[coroutine]
    -- The close runs the handler's shutdown and the pumps, which the checker cannot
    -- prove non-suspending; the contract promises it, as it does for any provider.
    local owned = new contract.Installed(close = closeInstallation as any, handler = value)
    -- The coroutine's slot keeps the record as well as the caller, who holds the one
    -- obligation to close it. The extent's own state is written here rather than
    -- declared on the record, because nothing outside this file reads it.
    local installed: any = @unsafe nupp.release(owned)
    installed._co = coroutine
    installed._previous = previous
    installed.transparent = transparent
    installed._released = false
    if coroutine == nil then
        suspension._main = installed
    else
        suspension._installed[coroutine] = installed
    end

    return installed as contract.Installed
end

--- Installs `value` for suspensions performed on this coroutine.
function suspension.install(value: suspension.Handler): affine(contract.Installed)
    return installHandler(value, false)
end

--- Installs a driver's handler, which stands in front of a host rather than being one.
function suspension.installDriver(value: suspension.Handler): affine(contract.Installed)
    return installHandler(value, true)
end

function suspension.create<A..., R...>(body: function(A...): R...): thread
    local co = coroutine.create(body)
    local inherited = installation()
    if inherited ~= nil then
        suspension._installed[co] = inherited
    end

    return co
end

local _checked: contract.Provider = suspension
export = suspension
