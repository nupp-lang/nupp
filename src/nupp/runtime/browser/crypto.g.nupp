@!internal

module nupp.runtime.browser.crypto

--[[
Browser Web Crypto implementation for [](nupp.random) and UUID generation.

Requests use the application Worker's effect channel. Random bytes and HMAC
results cross that channel as base64 and return as byte-preserving Lua strings;
SHA-256 uses the host's hexadecimal result. UUIDs are formatted here with the
required version and variant bits.

Operations may suspend while the Worker completes a request. A random request
accepts at most 1,048,576 bytes, and invalid counts fail before dispatch. Host
crypto failures propagate through the shared browser response mechanism.

The crypto and UUID facades retain this module during initialization. Its values
satisfy the interfaces in [](nupp.random.spi) and [](nupp.runtime.uuid.spi); no
JavaScript function or provider instance is copied into a child Lua state.
]]

local base64 = require("nupp.codec.base64")
local contracts = require("nupp.runtime.uuid.spi")
local response = require("nupp.runtime.browser.response")
local crypto = {}

local function invalid(kind: string): never
    error("nupp: browser crypto returned invalid " .. kind, 3)
end

local function decoded(value: any, field: string, count: integer): string
    if type(value) ~= "table" or type(value[field]) ~= "string" then
        invalid(field)
    end
    local bytes = base64.decode(value[field])
    if bytes == nil or #bytes ~= count then
        invalid(field)
    end

    return bytes
end

local function random(count: integer, wallTime: boolean?): any
    if count < 0 or count ~= math.floor(count) then
        error("nupp: random byte count must be a non-negative integer", 3)
    elseif count > 1048576 then
        error("nupp: one random request cannot exceed 1048576 bytes", 3)
    end

    local value = response.await("random", {count = count, wallTime = wallTime == true,})
    local bytes = decoded(value, "bytesBase64", count)
    local timestamp: number? = nil
    if wallTime then
        local given = value.wallTimeMs
        if type(given) ~= "number" or given ~= math.floor(given) or given < 0 or given > 281474976710655 then
            invalid("wall time")
        end
        timestamp = given
    end

    return {bytes = bytes, wallTimeMs = timestamp,}
end

function crypto.randomBytes(count: integer): string
    return random(count).bytes
end

function crypto.sha256(value: string): string
    local digest = response.await("sha256", {bytesBase64 = base64.encode(value),})
    if type(digest) ~= "string" or #digest ~= 64 or digest:find("[^0-9a-f]") ~= nil then
        invalid("SHA-256 digest")
    end

    return digest
end

function crypto.digest(key: string, message: string): string
    local value = response.await("hmac-sha256", {
        keyBase64 = base64.encode(key),
        messageBase64 = base64.encode(message),
    })

    return decoded(value, "digestBase64", 32)
end

function crypto.hex(key: string, message: string): string
    local digest = crypto.digest(key, message)
    return (digest:gsub(".", function(byte: string): string
        return ("%02x"):format(byte:byte())
    end))
end

local function canonical(bytes: {integer}): string
    local hex: {string} = {}
    for index = 1, 16 do
        hex[index] = ("%02x"):format(bytes[index])
    end

    return table.concat(
        hex,
        "",
        1,
        4
    ) .. "-" .. table.concat(
        hex,
        "",
        5,
        6
    ) .. "-" .. table.concat(
        hex,
        "",
        7,
        8
    ) .. "-" .. table.concat(hex, "", 9, 10) .. "-" .. table.concat(hex, "", 11, 16)
end

local function byteTable(raw: string): {integer}
    local bytes: {integer} = {}
    for index = 1, #raw do
        bytes[index] = raw:byte(index)
    end

    return bytes
end

function crypto.uuid4(): string
    local bytes = byteTable(crypto.randomBytes(16))
    bytes[7] = bytes[7] % 16 + 64
    bytes[9] = bytes[9] % 64 + 128
    return canonical(bytes)
end

function crypto.uuid7(): string
    local generated = random(10, true)
    local timestamp = generated.wallTimeMs as integer
    local bytes: {integer} = {}
    for index = 6, 1, -1 do
        bytes[index] = timestamp % 256
        timestamp = math.floor(timestamp / 256)
    end
    local tail = generated.bytes as string
    for index = 1, 10 do
        bytes[index + 6] = tail:byte(index)
    end
    bytes[7] = bytes[7] % 16 + 112
    bytes[9] = bytes[9] % 64 + 128

    return canonical(bytes)
end

@allow("unused-binding")
const ANSWERS_UUID: contracts.Provider = {uuid4 = crypto.uuid4, uuid7 = crypto.uuid7,}
export = crypto
