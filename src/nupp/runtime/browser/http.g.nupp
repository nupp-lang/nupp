@!internal

module nupp.runtime.browser.http

--[[
Browser Fetch implementation used as a built-in module fallback.

Requests cross the browser effect channel and suspend until Fetch completes.
Request and response bodies are buffered, and browser policy controls proxies,
certificates, connections, and protocol details. `capabilities` therefore reports
all five optional transport guarantees as false.

Client and Response records implement [](nupp.io.http.spi). Body bytes
are exposed through the shared owned-reader machinery, and affine teardown
releases retained response storage and outstanding work. Request values are
borrowed rather than consumed by send.

The [](nupp.io.http) facade resolves this provider once. The application must
supply browser effects, suspension, and Wasm memory before consuming it. Operations
use the retained client and effect transport directly.
]]

local effects = require("nupp.runtime.browser.effects")
local span = require("nupp.mem.span")
local response = require("nupp.runtime.browser.response")
local suspension = require("nupp.suspension")
local uri = require("nupp.io.uri")
const {type Path} = require("nupp.io.path")
local io = require("nupp.io")
local ownedReader = require("nupp.io.internal.ownedreader")
local contracts = require("nupp.io.http.spi")
local memory = require("nupp.runtime.browser.memory") as any
local http = {}
local MAX_EXACT_INTEGER = 9007199254740991

const messages = require("nupp.io.http.messages")

type http.Capabilities = messages.Capabilities

--- Reports the guarantees of the selected HTTP provider.
function http.capabilities(): http.Capabilities
    return new messages.Capabilities(
        streamingResponse = false,
        streamingRequest = false,
        transportPolicy = false,
        connectionPolicy = false,
        protocolVersion = false
    )
end

type http.Version = messages.Version
type http.Options = messages.Options
http.Options = messages.Options
type http.Reader = messages.Reader
type http.ReaderBody = messages.ReaderBody
http.ReaderBody = messages.ReaderBody
type http.FileBody = messages.FileBody
http.FileBody = messages.FileBody
type http.RequestBody = messages.RequestBody
type http.Request = messages.Request
http.Request = messages.Request

type http.Body = io.Reader

local function whole(value: any, what: string, minimum: integer): integer
    if type(value) ~= "number" or value ~= math.floor(value) or value < minimum then
        error(("nupp: HTTP %s must be an integer of at least %d"):format(what, minimum), 3)
    end

    return value as integer
end

local function copyHeaders(values: any, what: string): {[string]: string}
    if values ~= nil and type(values) ~= "table" then
        error("nupp: HTTP " .. what .. " must be a table", 3)
    end
    local out: {[string]: string} = {}
    for name, value in pairs(values or {}) do
        if type(name) ~= "string"
            or type(value) ~= "string"
            or name == ""
            or name:find("[\r\n:]") ~= nil
            or value:find("[\r\n]") ~= nil
        then
            error("nupp: HTTP headers need valid string names and values", 3)
        end
        out[name] = value
    end

    return out
end

local function hostInteger(value: any, minimum: integer, maximum: number): integer?
    if type(value) ~= "number" or value ~= math.floor(value) or value < minimum or value > maximum then
        return nil
    end

    return value as integer
end

local function responseHeaders(values: any): ({[string]: {string}}?, string?)
    if type(values) ~= "table" then
        return nil, "browser HTTP host returned invalid response headers"
    end
    local byName: {[string]: {string}} = {}
    local count: integer = 0
    local highest: integer = 0
    for index, pair in pairs(values) do
        if type(index) ~= "number" or index < 1 or index ~= math.floor(index) then
            return nil, "browser HTTP host returned invalid response headers"
        end
        count = count + 1
        highest = math.max(highest, index) as integer
        if type(pair) ~= "table"
            or type(pair[1]) ~= "string"
            or type(pair[2]) ~= "string"
            or pair[1] == ""
            or pair[1]:find("[\r\n:]") ~= nil
            or pair[2]:find("[\r\n]") ~= nil
        then
            return nil, "browser HTTP host returned invalid response headers"
        end
        local name = pair[1]:lower()
        local entries = byName[name] or {}
        entries[#entries + 1] = pair[2]
        byName[name] = entries
    end
    if count ~= highest then
        return nil, "browser HTTP host returned invalid response headers"
    end

    return byName, nil
end

local function releaseBody(handle: integer): nil
    effects.request("http", {operation = "release-body", body = handle,}, function(): nil
    end)
end

local function orphanedResponse(answer: any): nil
    if type(answer) ~= "table" or answer.ok ~= true or type(answer.value) ~= "table" then
        return
    end
    local handle = hostInteger(answer.value.body, 1, MAX_EXACT_INTEGER)
    if handle ~= nil then
        releaseBody(handle)
    end
end

record http.Response is contracts.Response
    status: integer
    version: http.Version?
    url: uri.URI
    body: http.Body
    @private
    _headers: {[string]: {string}}
    @private
    _closed: boolean

    function ok(self): boolean
        return self.status >= 200 and self.status < 300
    end

    function getAll(self, name: string): {string}
        local values = self._headers[name:lower()] or {}
        local copy: {string} = {}
        for index = 1, #values do
            copy[index] = values[index]
        end

        return copy
    end

    function header(self, name: string): string?
        local values = self._headers[name:lower()]
        if values == nil then
            return nil
        end

        return name:lower() == "set-cookie" and values[1] or table.concat(values, ", ")
    end

    function headers(self): {[string]: string}
        local values: {[string]: string} = {}
        for name, entries in pairs(self._headers) do
            values[name] = name == "set-cookie" and entries[1] or table.concat(entries, ", ")
        end

        return values
    end

    function close(takes self): nil
        self._closed = true
        self.body:close()
    end

    function drop(takes self): nil
        self:close()
    end
end

local function makeResponse(
    status: integer,
    url: uri.URI,
    takes body: http.Body,
    headers: {[string]: {string}}
): http.Response
    return new http.Response(
        status = status,
        version = nil,
        url = url,
        body = body,
        _headers = headers,
        _closed = false
    )
end

record http.Client is contracts.Client
    @private
    _options: http.Options
    @private
    _closed: boolean
    @private
    _pending: integer

    constructor(self, options: http.Options?): http.Client
        local given: any = options or {}
        if type(given) ~= "table" then
            error("nupp: HTTP options must be a table", 2)
        end
        for _, key in ipairs({
            "userAgent",
            "connectTimeoutMs",
            "stallTimeoutMs",
            "maxRedirects",
            "maxPendingRequests",
            "maxConnections",
            "maxConnectionsPerHost",
            "insecureHosts",
            "proxy",
            "noProxy",
            "proxyCredentials",
            "compressed"
        }) do
            if given[key] ~= nil then
                error("nupp: browser HTTP does not support option " .. key, 2)
            end
        end
        self._options = new http.Options(
            headers = copyHeaders(given.headers, "default headers"),
            timeoutMs = given.timeoutMs == nil and 30000 or whole(given.timeoutMs, "timeoutMs", 1),
            maxBytes = given.maxBytes == nil and 0 or whole(given.maxBytes, "maxBytes", 0)
        )
        self._closed = false
        self._pending = 0
    end

    function flush(self): nil
    end

    function pending(self): integer
        return self._pending
    end

    function send(self, borrows request: http.Request): (http.Response?, string?)
        if self._closed then
            return nil, "the HTTP client is closed"
        end
        if type(request) ~= "table" then
            error("nupp: HTTP request must be a Request", 2)
        end
        if request.stallTimeoutMs ~= nil then
            return nil, "browser HTTP does not support stallTimeoutMs"
        end
        local url = request.url
        if url == nil or type(url.toString) ~= "function" then
            error("nupp: HTTP request url must be a URI", 2)
        end
        local scheme = url:scheme()
        if scheme ~= "http" and scheme ~= "https" then
            error("nupp: HTTP request URL must use http or https", 2)
        end
        local method = request.method or "GET"
        if type(method) ~= "string" or method == "" or method:find("[^!#$%%&'*+%.^_`|~%w%-]") ~= nil then
            error("nupp: HTTP method is not a valid token", 2)
        end
        local headers: {any} = {}
        local headerPositions: {[string]: integer} = {}

        local function addHeaders(values: {[string]: string}?): nil
            for name, value in pairs(copyHeaders(values, "headers")) do
                local lower = name:lower()
                local position = headerPositions[lower]
                if position == nil then
                    headers[#headers + 1] = {name, value}
                    headerPositions[lower] = #headers
                else
                    headers[position] = {name, value}
                end
            end
        end

        addHeaders(self._options.headers)
        addHeaders(request.headers)
        local body = request.body
        local upload: string? = nil
        if type(body) == "string" then
            upload = body as string
        elseif body is messages.ReaderBody then
            if body.length ~= nil then
                whole(body.length, "reader body length", 0)
            end
            if body.contentType ~= nil and type(body.contentType) ~= "string" then
                error("nupp: HTTP content type must be a string", 2)
            end
            local chunks: {string} = {}
            local length: integer = 0
            while true do
                local bytes, reason = body.reader:read(65536)
                if bytes == nil then
                    return nil, reason
                elseif bytes == "" then
                    break
                end
                length = length + #bytes
                if body.length ~= nil and length > body.length then
                    return nil, "HTTP upload exceeded its declared length"
                end
                chunks[#chunks + 1] = bytes
            end
            if body.length ~= nil and length ~= body.length then
                return nil, "HTTP upload ended before its declared length"
            end
            upload = table.concat(chunks)
            if body.contentType ~= nil and headerPositions["content-type"] == nil then
                headers[#headers + 1] = {"content-type", body.contentType}
                headerPositions["content-type"] = #headers
            end
        elseif body ~= nil then
            return nil, "browser HTTP file uploads require an available file host"
        end
        local descriptor: any = {
            memoryResponse = true,
            url = url:toString(),
            method = method,
            timeoutMs = request.timeoutMs == nil and self._options.timeoutMs
            or whole(request.timeoutMs, "timeoutMs", 1),
            maxBytes = request.maxBytes == nil and self._options.maxBytes or whole(request.maxBytes, "maxBytes", 0),
        }
        if #headers > 0 then
            -- An empty Lua table encodes as a JSON object, which the host cannot
            -- iterate as header pairs; no field means no headers.
            descriptor.headers = headers
        end
        local leaseRead = memory.lease as function(
            borrows pointer: const uint8[?],
            count: integer,
            writable: boolean?
        ): integer
        if upload ~= nil then
            local input = span.fromString(upload)
            local pointer, count = input:ref()
            descriptor.bodyLease = leaseRead(pointer, count, false)
        end
        self._pending = self._pending + 1
        local completed, suspended = pcall(suspension.suspend, "browser HTTP request", function(
            resume: function(any): nil
        ): function()
            return effects.request("http", descriptor, resume, orphanedResponse)
        end)
        if descriptor.bodyLease ~= nil then
            memory.releaseLease(descriptor.bodyLease)
        end
        self._pending = self._pending - 1
        if not completed then
            error(suspended, 0)
        end
        local answer = suspended as any
        if type(answer) ~= "table" or type(answer.ok) ~= "boolean" then
            return nil, "browser HTTP host returned an invalid response"
        end
        if not answer.ok then
            return nil, type(answer.error) == "string" and answer.error or "browser HTTP request failed"
        end
        local value = answer.value
        if type(value) ~= "table" then
            return nil, "browser HTTP host returned an invalid response value"
        end
        local body = hostInteger(value.body, 1, MAX_EXACT_INTEGER)
        if body == nil then
            return nil, "browser HTTP host returned an invalid body handle"
        end
        local bodyBytes = hostInteger(value.bodyBytes, 0, MAX_EXACT_INTEGER)
        local status = hostInteger(value.status, 100, 599)
        local byName, headersProblem = responseHeaders(value.headers)
        if bodyBytes == nil or (descriptor.maxBytes > 0 and bodyBytes > descriptor.maxBytes) then
            releaseBody(body)
            return nil, "browser HTTP host returned an invalid body length"
        elseif status == nil then
            releaseBody(body)
            return nil, "browser HTTP host returned an invalid status"
        elseif byName == nil then
            releaseBody(body)
            return nil, headersProblem
        end
        local storage = io.newBuffer(bodyBytes)
        local lease = storage:reserveWrite(0, bodyBytes)
        do
            local output = lease:span()
            do
                local pointer, count = output:ref()
                local leaseWrite = memory.lease as function(
                    exclusive pointer: uint8[?],
                    count: integer,
                    writable: boolean?
                ): integer
                local token = leaseWrite(pointer, count, true)
                local copied, result = pcall(response.await, "http", {
                    operation = "read-body",
                    body = body,
                    lease = token
                })
                memory.releaseLease(token)
                if not copied then
                    releaseBody(body)
                    error(result, 0)
                end
                if type(result) ~= "table" or result.bytes ~= bodyBytes then
                    releaseBody(body)
                    error("nupp: browser HTTP host returned an invalid copied byte count", 0)
                end
            end
            nupp.drop(output)
        end
        lease:commit(bodyBytes)
        local responseBody = ownedReader.newOwnedReader(storage)
        -- The host follows redirects, so the URL it answers is the last hop
        -- rather than the one the request named.
        local finalUrl = request.url
        if type(value.url) == "string" and value.url ~= "" then
            local landed = uri.newURI(value.url)
            if landed ~= nil then
                finalUrl = landed
            end
        end

        return makeResponse(status, finalUrl, responseBody, byName)
    end

    function close(takes self): nil
        self._closed = true
    end
end

local function client(options: messages.Options?): contracts.Client
    return new http.Client(options)
end

export = {client = client, capabilities = http.capabilities}
