@!internal
module nupp.runtime.browser.uri

--[[
The browser implementation parses absolute URIs for the `host.uri` API 1
contract, as the WHATWG URL Standard does.

A page host that answers `__nuppBrowser.url` hands the text to its own `URL`,
which brings the host's IDNA mapping with it; the canonical text it answers is
then read back into components. Without one, for instance on a hostless
portable target, [](nupp.io.uri.whatwg) parses the text itself and refuses a
special-scheme host that needs IDNA.

Either way text that is not valid UTF-8 or holds a NUL byte is refused first,
with the reasons the native provider gives. Parsing performs no network or
effect request. [](nupp.io.uri) retains the parser during module initialization
and constructs its shared public URI values from the returned components.
]]

local contracts = require("nupp.io.uri.spi")
const whatwg = require("nupp.io.uri.whatwg")
local browserHost: any = rawget(_G, "__nuppBrowser")
local provider = {}

-- Browser URI parsing supplies components; the public URI value and its
-- operations are owned by nupp.io.uri on every host.
function provider.parse(text: string): (contracts.UriParts?, string?)
    local hostParse: any = browserHost ~= nil and browserHost.url or nil
    if hostParse == nil then
        return whatwg.parse(text)
    end
    -- The host would percent-encode what the native provider refuses, so the
    -- refusals are made here, where every provider makes them.
    local refused = whatwg.refusal(text)
    if refused ~= nil then
        return nil, refused
    end
    local answer = hostParse(text)
    if type(answer) ~= "table" or type(answer.href) ~= "string" then
        local problem = type(answer) == "table" and answer.error or nil
        return nil, type(problem) == "string" and problem or "invalid URL"
    end

    -- The host's text is canonical, so reading it back only splits it: its
    -- host has already been through IDNA and is kept as the host wrote it.
    local parts, reason = whatwg.parse(answer.href, nil, true)

    return parts, reason
end

local checked: contracts.UriTextProvider = {parse = provider.parse}
export = checked
