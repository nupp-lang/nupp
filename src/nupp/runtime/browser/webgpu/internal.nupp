@!internal
module nupp.runtime.browser.webgpu.internal
local response = require("nupp.runtime.browser.response")
local memory = require("nupp.runtime.wasm") as any
local storage = require("nupp.runtime.storage")
local span = require("nupp.mem.span")
local {type Span, type WriteSpan} = require("nupp.mem.span")
local shared = require("nupp.gpu.types")
local api = require("nupp.gpu.api")
local operations = require("nupp.gpu.operations")
local gpu = {}
type gpu.Buffer<T> = shared.Buffer<T>
gpu.Buffer = shared.Buffer
type gpu.Kernel = shared.Kernel
gpu.Kernel = shared.Kernel
type gpu.ArtifactSet = shared.ArtifactSet
gpu.ArtifactSet = shared.ArtifactSet

type gpu.Shared<T> = shared.Shared<T>
gpu.Shared = shared.Shared
type gpu.Phases = shared.Phases
gpu.Phases = shared.Phases

gpu.destroyContext = shared.destroyContext
gpu.bufferIsDense = operations.bufferIsDense
record gpu.Binding is api.Binding
    readonly _anchor: any
    readonly _kernel: gpu.Kernel
    readonly _read: {integer}
    readonly _write: {integer}
    readonly _readCounts: {integer}
    readonly _writeCounts: {integer}
    readonly _readOffsets: {integer}
    readonly _writeOffsets: {integer}
    readonly _context: any
    readonly _handle: any
    readonly _uniformBytes: integer
    readonly _readonlyBuffers: integer
    _spanCounts: {integer}
    _spanOffsets: {integer}
    _released: boolean

    --- Number of elements dispatched by this binding.
    readonly count: integer

    --- Attaches a resident buffer to one read-only slot. A dispatch-indexed
    --- span asks for `matchCount`, which holds the buffer to one element per
    --- dispatched thread; a cursor-proved span passes false and may be any
    --- length, because its bound check runs inside the shader.
    --- @internal
    setRead: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Attaches a resident buffer to one writable slot.
    --- @internal
    setWrite: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Enqueues the binding with a compiler-laid-out uniform block.
    --- @internal
    dispatchWords: function(borrows self: gpu.Binding, scalars: {uint32}): nil

    dispatchPacked: function(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
end

record gpu.Context is api.KernelContext
    _handle: any
    _closed: boolean

    --- Releases the device, compiled kernels, and resident buffers.
    drop: nosuspend function(takes self: Context): nil

    _destroy: nosuspend function(state: any): nil

    --- Native provider family selected for this device.
    driver: function(borrows self: Context): string

    --- Allocates a typed resident device buffer.
    buffer: function<T>(borrows self: Context, element: ctype<T>, count: integer): api.Buffer<T> borrows (self)

    --- Allocates a dense row-major resident tensor.
    tensor: function<T>(borrows self: Context, element: ctype<T>, shape: {integer}): api.Buffer<T> borrows (self)

    --- Compiles the artifacts emitted beside an `@aot(target = "gpu")` body.
    --- The selected provider chooses its source member from this set.
    --- @internal
    compileGenerated: function(
        borrows self: Context,
        artifacts: gpu.ArtifactSet,
        readonlyBuffers: integer,
        writableBuffers: integer,
        uniformBytes: integer,
        threads: integer?
    ): api.Kernel borrows (self)

    --- Starts attaching a generated kernel to resident buffers. `count` is the
    --- dispatch length, which the compiler takes from the kernel's primary
    --- span; the generated binding fills every slot before dispatching.
    --- @internal
    bindKernel: function(borrows self: Context, borrows kernel: api.Kernel, count: integer): api.Binding borrows (self)

    --- Releases one root buffer's device storage without closing the context.
    --- Refused while commands are queued; synchronize first. Any view of the
    --- buffer is invalid afterwards, and using one raises.
    releaseBuffer: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Releases a compiled kernel no binding uses any more.
    --- @internal
    releaseKernel: function(borrows self: Context, borrows kernel: api.Kernel): nil

    --- Releases a binding's host-side attachment. The kernel and buffers it
    --- named remain the context's.
    --- @internal
    releaseBinding: function(borrows self: Context, exclusive binding: api.Binding): nil

    --- Copies a complete shared span into a resident buffer or view and
    --- enqueues its transfer. It does not wait.
    upload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>, borrows source: span.Span<T>): nil

    --- Enqueues a complete resident-buffer or view download without waiting.
    enqueueDownload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Submits the accumulated command stream and waits for it.
    synchronize: function(borrows self: Context): nil

    --- Copies a download completed by `synchronize()` into a complete writable
    --- span. No GPU work or waiting happens here.
    readDownloaded: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil

    --- Convenience CPU boundary: enqueue, synchronize, and copy out.
    download: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil
end

local function live(borrows context: gpu.Context): nil
    if context._closed then
        error("nupp: GPU context is closed", 3)
    end
end

local function answerHandle(answer: any, field: string): integer
    local handle = answer[field]
    if type(handle) ~= "number" or handle < 1 or handle % 1 ~= 0 then
        error("nupp: browser GPU returned an invalid " .. field .. " handle", 3)
    end

    return handle as integer
end

local contextdestroy = shared.markClosed

function gpu.Context.driver(borrows self: gpu.Context): string
    live(self)
    return "webgpu"
end

function gpu.Context.buffer<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    count: integer
): shared.Buffer<T> borrows (self)
    local width = storage.sizeOf(element)
    live(self)
    if count < 1 or count > 268435456 // width then
        error("nupp: browser GPU buffer count is outside the portable limit", 2)
    end
    local answer = response.await("gpu", {operation = "runtime-create-buffer", bytes = count * width,})

    return new shared.Buffer(
        _anchor = self,
        _handle = answerHandle(answer, "buffer"),
        _width = width,
        _released = false,
        _offset = 0,
        _capacity = count,
        _root = true,
        _shape = {count},
        _strides = {1},
        count = count
    )
end

function gpu.Context.compileGenerated(
    borrows self: gpu.Context,
    artifacts: gpu.ArtifactSet,
    readonlyBuffers: integer,
    writableBuffers: integer,
    uniformBytes: integer,
    threads: integer?
): gpu.Kernel borrows (self)
    live(self)
    local wgsl = artifacts.wgsl
    local group = threads or 256
    if wgsl == nil or #wgsl == 0 then
        error("nupp: browser GPU kernels need WGSL", 2)
    end
    if readonlyBuffers < 0 or writableBuffers < 1 or readonlyBuffers + writableBuffers > 8 then
        error("nupp: browser GPU kernels take up to eight storage buffers", 2)
    end
    if uniformBytes < 4 or uniformBytes > 128 or uniformBytes % 4 ~= 0 or group < 1 or group > 256 then
        error("nupp: browser GPU kernel has an invalid portable layout", 2)
    end
    local answer = response.await("gpu", {
        operation = "runtime-compile",
        wgsl = wgsl,
        entrypoint = artifacts.entrypoint,
        readonly = readonlyBuffers,
        writable = writableBuffers,
        uniformBytes = uniformBytes,
        threads = group,
    })

    return new shared.Kernel(
        _anchor = self,
        _handle = answerHandle(answer, "kernel"),
        _readonlyBuffers = readonlyBuffers,
        _writableBuffers = writableBuffers,
        _uniformBytes = uniformBytes,
        _threads = group
    )
end

function gpu.Binding.setRead<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released or slot < 0 or slot >= self._kernel._readonlyBuffers or buffer._released then
        error("nupp: browser GPU read binding is invalid", 2)
    end
    if matchCount and buffer.count ~= self.count then
        error("nupp: browser GPU dispatch-indexed buffer has the wrong count", 2)
    end
    self._read[slot + 1] = buffer._handle
    self._readCounts[slot + 1] = buffer.count
    self._readOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.setWrite<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released or slot < 0 or slot >= self._kernel._writableBuffers or buffer._released then
        error("nupp: browser GPU write binding is invalid", 2)
    end
    if matchCount and buffer.count ~= self.count then
        error("nupp: browser GPU dispatch-indexed buffer has the wrong count", 2)
    end
    self._write[slot + 1] = buffer._handle
    self._writeCounts[slot + 1] = buffer.count
    self._writeOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.dispatchWords(borrows self: gpu.Binding, scalars: {uint32}): nil
    if self._released
        or #self._read ~= self._kernel._readonlyBuffers
        or #self._write ~= self._kernel._writableBuffers
    then
        error("nupp: browser GPU binding is incomplete", 2)
    end
    local words: {uint32} = {nupp.math.u32.wrap(self.count)}
    for _, values in ipairs({self._readCounts, self._writeCounts, self._readOffsets, self._writeOffsets, scalars}) do
        for _, value in ipairs(values) do
            words[#words + 1] = nupp.math.u32.wrap(value as integer)
        end
    end
    if #words * 4 ~= self._kernel._uniformBytes then
        error("nupp: browser GPU uniform block has the wrong size", 2)
    end
    local allocation = memory.allocate(#words * 4)
    local pointer = memory.pointer(allocation, 0, 1)
    for index, value in ipairs(words) do
        memory.store(pointer, (index - 1) * 4, "uint32", value)
    end
    local lease = memory.lease(pointer, #words * 4)
    response.await("gpu", {
        operation = "runtime-dispatch",
        kernel = self._kernel._handle,
        read = self._read,
        write = self._write,
        count = self.count,
        lease = lease,
    })
    memory.releaseLease(lease)
end

function gpu.Context.upload<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    borrows source: Span<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    local pointer, count = source:ref()
    if count ~= buffer.count or buffer._released or not buffer._root then
        error("nupp: browser GPU upload span length does not match its buffer", 2)
    end
    local leasePointer = memory.lease as function(
        borrows pointer: const T[?],
        bytes: integer,
        writable: boolean?
    ): integer
    local lease = leasePointer(pointer, count * buffer._width)
    response.await("gpu", {operation = "runtime-upload", buffer = buffer._handle, lease = lease,})
    memory.releaseLease(lease)
end

function gpu.Context.enqueueDownload<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    if buffer._released then
        error("nupp: browser GPU buffer was released", 2)
    end
end

function gpu.Context.synchronize(borrows self: gpu.Context): nil
    live(self)
    response.await("gpu", {operation = "runtime-synchronize",})
end

function gpu.Context.readDownloaded<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    local pointer, count = destination:ref()
    if count ~= buffer.count or buffer._released or not buffer._root then
        error("nupp: browser GPU download span length does not match its buffer", 2)
    end
    local leasePointer = memory.lease as function(exclusive pointer: T[?], bytes: integer, writable: boolean?): integer
    local lease = leasePointer(pointer, count * buffer._width, true)
    response.await("gpu", {operation = "runtime-download", buffer = buffer._handle, lease = lease,})
    memory.releaseLease(lease)
end

function gpu.Context.download<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    self:enqueueDownload(buffer)
    self:synchronize()
    self:readDownloaded(buffer, destination)
end

function gpu.Context.releaseBuffer<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    buffer._released = true
end

function gpu.Context.releaseKernel(borrows self: gpu.Context, borrows kernelValue: api.Kernel): nil
    local kernel = kernelValue as gpu.Kernel
    response.await("gpu", {operation = "runtime-destroy-kernel", kernel = kernel._handle,})
end

function gpu.Context.releaseBinding(borrows self: gpu.Context, exclusive bindingValue: api.Binding): nil
    local binding = bindingValue as gpu.Binding
    binding._released = true
end

function gpu.Binding.dispatchPacked(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
    error("nupp: linear32 GPU dispatch requires scalar words", 2)
end

function gpu.Context.bindKernel(
    borrows self: gpu.Context,
    borrows kernelValue: api.Kernel,
    count: integer
): gpu.Binding borrows (self)
    local kernel = kernelValue as gpu.Kernel
    live(self)
    if count < 0 or count > 4294967295 then
        error("nupp: GPU dispatch count must be a uint32", 2)
    end

    return new gpu.Binding(
        _anchor = self,
        _context = self,
        _handle = nil,
        _uniformBytes = kernel._uniformBytes,
        _readonlyBuffers = kernel._readonlyBuffers,
        _spanCounts = {},
        _spanOffsets = {},
        _kernel = kernel,
        _read = {},
        _write = {},
        _readCounts = {},
        _writeCounts = {},
        _readOffsets = {},
        _writeOffsets = {},
        _released = false,
        count = count
    )
end

function gpu.Context.drop(takes self: gpu.Context): nil
    local state = unsafe release self
    state._destroy(state)
end

function gpu.Context.tensor<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    shape: {integer}
): api.Buffer<T> borrows (self)
    return operations.tensor(self, element, shape)
end

function gpu.open(): affine(api.KernelContext, api.destroyContext)
    response.await("gpu", {operation = "runtime-open",})
    return new gpu.Context(_destroy = contextdestroy, _closed = false, _handle = nil)
end

export const open = gpu.open
