@!internal
module nupp.runtime.browser.webgpu.internal

--[[
The browser resident-compute implementation supplies the built-in WebGPU
fallback.

`open` acquires a WebGPU context through the browser effect channel. Buffers,
kernels, and bindings retain host identifiers while implementing the canonical
[](nupp.gpu.api) interfaces. Generated shader artifacts and layout facts
determine binding slots, uniform bytes, element counts, and supported
operations.

Upload and download use the selected linear-memory storage implementation.
Synchronization and host responses may suspend. Context-dependent values retain
their context borrows, and affine cleanup uses the shared `destroyContext`
identity to release device resources without substituting a provider-local type.

The browser application must install WebGPU effects and memory before requiring
[](nupp.gpu). Its facade binds `open` directly; dispatch and cleanup use
retained context state without service lookups. Context cleanup queues
destruction of unreleased host resources without suspending.
]]

local response = require("nupp.runtime.browser.response")
local effects = require("nupp.runtime.browser.effects")
local requestNosuspend = effects.request as @nosuspend function(string, any, function(any): nil): function()
local memory = require("nupp.runtime.browser.memory") as any
local storage = require("nupp.runtime.storage")
local array = require("nupp.mem.array")
local span = require("nupp.mem.span")
local {type Span, type WriteSpan} = require("nupp.mem.span")
local shared = require("nupp.gpu.types")
local api = require("nupp.gpu.api")
local operations = require("nupp.gpu.operations")
local layoutFacts = require("nupp.gpu.layoutfacts").layoutFacts
local gpu = {}
type gpu.Buffer<T> = shared.Buffer<T>
gpu.Buffer = shared.Buffer
type gpu.Kernel = shared.Kernel
gpu.Kernel = shared.Kernel
type gpu.ArtifactSet = shared.ArtifactSet
gpu.ArtifactSet = shared.ArtifactSet

type gpu.Shared<T> = shared.Shared<T>
gpu.Shared = shared.Shared
type gpu.Phases = shared.Phases
gpu.Phases = shared.Phases

gpu.destroyContext = shared.destroyContext
record gpu.Binding is api.Binding
    @readonly
    _anchor: any
    @readonly
    _kernel: gpu.Kernel
    @readonly
    _read: {integer}
    @readonly
    _write: {integer}
    @readonly
    _readCounts: {integer}
    @readonly
    _writeCounts: {integer}
    @readonly
    _readOffsets: {integer}
    @readonly
    _writeOffsets: {integer}
    @readonly
    _bufferStates: {any}
    @readonly
    _context: any
    @readonly
    _uniformBytes: integer
    @readonly
    _readonlyBuffers: integer
    _released: boolean

    --- Number of elements dispatched by this binding.
    @readonly
    count: integer

    --- Attaches a resident buffer to one read-only slot. A dispatch-indexed
    --- span asks for `matchCount`, which holds the buffer to one element per
    --- dispatched thread; a cursor-proved span passes false and may be any
    --- length, because its bound check runs inside the shader.
    --- @internal
    setRead: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Attaches a resident buffer to one writable slot.
    --- @internal
    setWrite: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Enqueues the binding with a compiler-laid-out uniform block.
    --- @internal
    dispatchWords: function(borrows self: gpu.Binding, scalars: {uint32}): nil

    dispatchPacked: function(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
end

record gpu.Context is api.KernelContext
    _closed: boolean
    _buffers: {integer}
    _kernels: {integer}

    --- Closes the context and makes its resources unavailable.
    drop: @nosuspend function(takes self: Context): nil

    _destroy: @nosuspend function(state: any): nil

    --- WebGPU provider family selected for this context.
    driver: function(borrows self: Context): string

    --- Allocates a typed resident device buffer.
    buffer: function<T>(borrows self: Context, element: ctype<T>, count: integer): api.Buffer<T> borrows (self)

    --- Allocates a dense row-major resident tensor.
    tensor: function<T>(borrows self: Context, element: ctype<T>, shape: {integer}): api.Buffer<T> borrows (self)

    --- Compiles the artifacts emitted beside an `@aot(target = "gpu")` body.
    --- The selected provider chooses its source member from this set.
    --- @internal
    compileGenerated: function(
        borrows self: Context,
        artifacts: gpu.ArtifactSet,
        readonlyBuffers: integer,
        writableBuffers: integer,
        uniformBytes: integer,
        threads: integer?
    ): api.Kernel borrows (self)

    --- Starts attaching a generated kernel to resident buffers. `count` is the
    --- dispatch length, which the compiler takes from the kernel's primary
    --- span; the generated binding fills every slot before dispatching.
    --- @internal
    bindKernel: function(borrows self: Context, borrows kernel: api.Kernel, count: integer): api.Binding borrows (self)

    --- Releases one root buffer's device storage without closing the context.
    --- A queued readback is discarded. Every view of the buffer becomes
    --- unavailable, and using one raises.
    releaseBuffer: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Releases a compiled kernel no binding uses any more.
    --- @internal
    releaseKernel: function(borrows self: Context, borrows kernel: api.Kernel): nil

    --- Releases a binding's host-side attachment. The kernel and buffers it
    --- named remain the context's.
    --- @internal
    releaseBinding: function(borrows self: Context, exclusive binding: api.Binding): nil

    --- Copies a complete shared span into a resident buffer or view and
    --- enqueues its transfer. It does not wait.
    upload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>, borrows source: span.Span<T>): nil

    --- Enqueues a complete resident-buffer or view download without waiting.
    enqueueDownload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Submits the accumulated command stream and waits for it.
    synchronize: function(borrows self: Context): nil

    --- Copies a download completed by `synchronize()` into a complete writable
    --- span. No GPU work or waiting happens here.
    readDownloaded: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil

    --- Convenience CPU boundary: enqueue, synchronize, and copy out.
    download: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil
end

local function live(borrows context: gpu.Context): nil
    if context._closed then
        error("nupp: GPU context is closed", 3)
    end
end

local function answerHandle(answer: any, field: string): integer
    if type(answer) ~= "table" then
        error("nupp: browser GPU returned an invalid " .. field .. " handle", 3)
    end
    local handle = answer[field]
    if type(handle) ~= "number" or handle < 1 or handle > 4294967295 or handle % 1 ~= 0 then
        error("nupp: browser GPU returned an invalid " .. field .. " handle", 3)
    end

    return handle as integer
end

local function isHandle(value: any): boolean
    return type(value) == "number" and value >= 1 and value <= 4294967295 and value % 1 == 0
end

local function rememberHandle(handles: {integer}, handle: integer, field: string): nil
    for _, value in ipairs(handles) do
        if value == handle then
            error("nupp: browser GPU returned a duplicate " .. field .. " handle", 3)
        end
    end
    handles[#handles + 1] = handle
end

local function orphanDestroy(field: string, operation: string): function(any): nil
    return function(answer: any): nil
        local value = type(answer) == "table" and answer.ok == true and answer.value or nil
        local handle = type(value) == "table" and value[field] or nil
        if not isHandle(handle) then
            return
        end
        requestNosuspend("gpu", {operation = operation, [field] = handle,}, function(_answer: any): nil
        end)
    end
end

local destroyOrphanBuffer = orphanDestroy("buffer", "runtime-destroy-buffer")
local destroyOrphanKernel = orphanDestroy("kernel", "runtime-destroy-kernel")

local function awaitLease(lease: integer, request: any): nil
    local completed, problem = pcall(response.await, "gpu", request)
    memory.releaseLease(lease)
    if not completed then
        error(problem, 0)
    end
end

local function forgetHandle(handles: {integer}, handle: integer): nil
    for index, value in ipairs(handles) do
        if value == handle then
            handles[index] = handles[#handles]
            handles[#handles] = nil
            return
        end
    end
end

local function contextdestroy(state: any): nil
    if state._closed then
        return
    end
    shared.markClosed(state)
    requestNosuspend(
        "gpu",
        {operation = "runtime-close", buffers = state._buffers, kernels = state._kernels,},
        function(_answer: any): nil
        end
    )
end

local contextdestroyNosuspend = contextdestroy as @nosuspend function(any): nil

function gpu.Context.driver(borrows self: gpu.Context): string
    live(self)
    return "webgpu"
end

function gpu.Context.buffer<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    count: integer
): shared.Buffer<T> borrows (self)
    local width = storage.sizeOf(element)
    live(self)
    if count < 1 or count > 268435456 // width or count % 1 ~= 0 then
        error("nupp: browser GPU buffer count is outside the portable limit", 2)
    end
    local answer = response.await(
        "gpu",
        {operation = "runtime-create-buffer", bytes = count * width,},
        destroyOrphanBuffer
    )

    local handle = answerHandle(answer, "buffer")
    rememberHandle(self._buffers, handle, "buffer")

    return new shared.Buffer(
        _elementType = nil as T,
        _anchor = self,
        _context = self,
        _handle = handle,
        _width = width,
        _state = {released = false},
        _offset = 0,
        _capacity = count,
        _root = true,
        _shape = {count},
        _strides = {1},
        count = count
    )
end

function gpu.Context.compileGenerated(
    borrows self: gpu.Context,
    artifacts: gpu.ArtifactSet,
    readonlyBuffers: integer,
    writableBuffers: integer,
    uniformBytes: integer,
    threads: integer?
): gpu.Kernel borrows (self)
    live(self)
    local wgsl = artifacts.wgsl
    local group = threads or 256
    if wgsl == nil or #wgsl == 0 or #artifacts.entrypoint == 0 then
        error("nupp: browser GPU kernels need WGSL", 2)
    end
    if readonlyBuffers < 0 or writableBuffers < 1 or readonlyBuffers + writableBuffers > 8 then
        error("nupp: browser GPU kernels take up to eight storage buffers", 2)
    end
    local spans = readonlyBuffers + writableBuffers
    if uniformBytes < 4 * (1 + 2 * spans)
        or uniformBytes > 128
        or uniformBytes % 4 ~= 0
        or group < 1
        or group > 256
    then
        error("nupp: browser GPU kernel has an invalid portable layout", 2)
    end
    local answer = response.await(
        "gpu",
        {
            operation = "runtime-compile",
            wgsl = wgsl,
            entrypoint = artifacts.entrypoint,
            readonly = readonlyBuffers,
            writable = writableBuffers,
            uniformBytes = uniformBytes,
            threads = group,
        },
        destroyOrphanKernel
    )

    local handle = answerHandle(answer, "kernel")
    rememberHandle(self._kernels, handle, "kernel")

    return new shared.Kernel(
        _anchor = self,
        _handle = handle,
        _readonlyBuffers = readonlyBuffers,
        _writableBuffers = writableBuffers,
        _uniformBytes = uniformBytes,
        _threads = group,
        _released = false
    )
end

--- The allocation states bound on one side of a binding: its read slots or its
--- write slots.
local function boundStates(borrows binding: gpu.Binding, writing: boolean): {any}
    local readonly = binding._kernel._readonlyBuffers
    local first = writing and readonly + 1 or 1
    local last = writing and readonly + binding._kernel._writableBuffers or readonly
    local states: {any} = {}
    for index = first, last do
        local state = binding._bufferStates[index]
        if state ~= nil then
            states[#states + 1] = state
        end
    end

    return states
end

function gpu.Binding.setRead<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released or self._kernel._released then
        error("nupp: browser GPU binding or kernel was released", 2)
    end
    if slot < 0
        or slot >= self._kernel._readonlyBuffers
        or buffer._context ~= self._anchor
        or buffer._state.released
    then
        error("nupp: browser GPU read binding is invalid", 2)
    end
    local _, extent, dense = layoutFacts(buffer._shape, buffer._strides, 2)
    if matchCount and (not dense or extent ~= self.count) then
        error("nupp: browser GPU dispatch-indexed buffer has the wrong count", 2)
    end
    operations.refuseReadWriteAlias(boundStates(self, true), buffer)
    self._read[slot + 1] = buffer._handle
    self._bufferStates[slot + 1] = buffer._state
    self._readCounts[slot + 1] = extent
    self._readOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.setWrite<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released or self._kernel._released then
        error("nupp: browser GPU binding or kernel was released", 2)
    end
    if slot < 0
        or slot >= self._kernel._writableBuffers
        or buffer._context ~= self._anchor
        or buffer._state.released
    then
        error("nupp: browser GPU write binding is invalid", 2)
    end
    local _, extent, dense, injective = layoutFacts(buffer._shape, buffer._strides, 2)
    if not injective or extent ~= buffer.count then
        error("nupp: browser GPU writable buffer is not a disjoint span", 2)
    end
    if matchCount and (not dense or extent ~= self.count) then
        error("nupp: browser GPU dispatch-indexed buffer has the wrong count", 2)
    end
    operations.refuseReadWriteAlias(boundStates(self, false), buffer)
    self._write[slot + 1] = buffer._handle
    self._bufferStates[self._kernel._readonlyBuffers + slot + 1] = buffer._state
    self._writeCounts[slot + 1] = extent
    self._writeOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.dispatchWords(borrows self: gpu.Binding, scalars: {uint32}): nil
    if self._released or self._kernel._released then
        error("nupp: browser GPU binding or kernel was released", 2)
    end
    for index = 1, self._kernel._readonlyBuffers do
        if self._read[index] == nil then
            error("nupp: browser GPU binding is incomplete", 2)
        end
    end
    for index = 1, self._kernel._writableBuffers do
        if self._write[index] == nil then
            error("nupp: browser GPU binding is incomplete", 2)
        end
    end
    for _, state in ipairs(self._bufferStates) do
        if state.released then
            error("nupp: browser GPU binding contains a released buffer", 2)
        end
    end
    local words: {uint32} = {nupp.math.u32.wrap(self.count)}
    for _, values in ipairs({self._readCounts, self._writeCounts, self._readOffsets, self._writeOffsets, scalars}) do
        for _, value in ipairs(values) do
            words[#words + 1] = nupp.math.u32.wrap(value as integer)
        end
    end
    if #words * 4 ~= self._kernel._uniformBytes then
        error("nupp: browser GPU uniform block has the wrong size", 2)
    end
    local allocation = array.scalar(array.uint32, #words)
    local writable = allocation:write()
    for index, value in ipairs(words) do
        writable[index] = value
    end
    nupp.drop(writable)
    local pointer = allocation:read():ref()
    local leasePointer = memory.lease as function(borrows pointer: const uint32[?], bytes: integer): integer
    local lease = leasePointer(pointer, #words * 4)
    awaitLease(lease, {
        operation = "runtime-dispatch",
        kernel = self._kernel._handle,
        read = self._read,
        write = self._write,
        count = self.count,
        lease = lease,
    })
end

function gpu.Context.upload<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    borrows source: Span<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    local pointer, count = source:ref()
    if buffer._context ~= self or buffer._state.released or not buffer:isDense() then
        error("nupp: browser GPU upload buffer is unavailable in this context", 2)
    end
    if count ~= buffer.count then
        error("nupp: browser GPU upload span length does not match its buffer", 2)
    end
    local leasePointer = memory.lease as function(
        borrows pointer: const T[?],
        bytes: integer,
        writable: boolean?
    ): integer
    local lease = leasePointer(pointer, count * buffer._width)
    awaitLease(lease, {
        operation = "runtime-upload",
        buffer = buffer._handle,
        offset = buffer._offset * buffer._width,
        bytes = count * buffer._width,
        lease = lease,
    })
end

function gpu.Context.enqueueDownload<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    if buffer._context ~= self or buffer._state.released or not buffer:isDense() then
        error("nupp: browser GPU download buffer is unavailable in this context", 2)
    end
    response.await("gpu", {
        operation = "runtime-enqueue-download",
        buffer = buffer._handle,
        offset = buffer._offset * buffer._width,
        bytes = buffer.count * buffer._width,
    })
end

function gpu.Context.synchronize(borrows self: gpu.Context): nil
    live(self)
    response.await("gpu", {operation = "runtime-synchronize",})
end

function gpu.Context.readDownloaded<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    local pointer, count = destination:ref()
    if buffer._context ~= self or buffer._state.released or not buffer:isDense() then
        error("nupp: browser GPU download buffer is unavailable in this context", 2)
    end
    if count ~= buffer.count then
        error("nupp: browser GPU download span length does not match its buffer", 2)
    end
    local leasePointer = memory.lease as function(exclusive pointer: T[?], bytes: integer, writable: boolean?): integer
    local lease = leasePointer(pointer, count * buffer._width, true)
    awaitLease(lease, {operation = "runtime-read-download", buffer = buffer._handle, lease = lease,})
end

function gpu.Context.download<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    self:enqueueDownload(buffer)
    self:synchronize()
    self:readDownloaded(buffer, destination)
end

function gpu.Context.releaseBuffer<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    live(self)
    if buffer._context ~= self then
        error("nupp: browser GPU buffer belongs to another context", 2)
    elseif buffer._state.released then
        error("nupp: browser GPU buffer was released", 2)
    elseif not buffer._root then
        error("nupp: a GPU view borrows its buffer; release the root buffer", 2)
    end
    buffer._state.released = true
    response.await("gpu", {operation = "runtime-destroy-buffer", buffer = buffer._handle,})
    forgetHandle(self._buffers, buffer._handle)
end

function gpu.Context.releaseKernel(borrows self: gpu.Context, borrows kernelValue: api.Kernel): nil
    local kernel = kernelValue as gpu.Kernel
    live(self)
    if kernel._anchor ~= self then
        error("nupp: browser GPU kernel belongs to another context", 2)
    elseif kernel._released then
        error("nupp: browser GPU kernel was released", 2)
    end
    kernel._released = true
    response.await("gpu", {operation = "runtime-destroy-kernel", kernel = kernel._handle,})
    forgetHandle(self._kernels, kernel._handle)
end

function gpu.Context.releaseBinding(borrows self: gpu.Context, exclusive bindingValue: api.Binding): nil
    local binding = bindingValue as gpu.Binding
    live(self)
    if binding._anchor ~= self then
        error("nupp: browser GPU binding belongs to another context", 2)
    end
    binding._released = true
end

function gpu.Binding.dispatchPacked(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
    error("nupp: linear32 GPU dispatch requires scalar words", 2)
end

function gpu.Context.bindKernel(
    borrows self: gpu.Context,
    borrows kernelValue: api.Kernel,
    count: integer
): gpu.Binding borrows (self)
    local kernel = kernelValue as gpu.Kernel
    live(self)
    if kernel._anchor ~= self then
        error("nupp: browser GPU kernel belongs to another context", 2)
    elseif kernel._released then
        error("nupp: browser GPU kernel was released", 2)
    end
    if count < 1 or count > 4294967295 or count % 1 ~= 0 then
        error("nupp: GPU dispatch count must be from 1 through 4294967295", 2)
    end

    return new gpu.Binding(
        _anchor = self,
        _context = self,
        _uniformBytes = kernel._uniformBytes,
        _readonlyBuffers = kernel._readonlyBuffers,
        _kernel = kernel,
        _read = {},
        _write = {},
        _readCounts = {},
        _writeCounts = {},
        _readOffsets = {},
        _writeOffsets = {},
        _bufferStates = {},
        _released = false,
        count = count
    )
end

function gpu.Context.drop(takes self: gpu.Context): nil
    local state = @unsafe nupp.release(self)
    state._destroy(state)
end

function gpu.Context.tensor<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    shape: {integer}
): api.Buffer<T> borrows (self)
    return operations.tensor(self, element, shape)
end

function gpu.open(): affine(api.KernelContext, api.destroyContext)
    local answer = response.await("gpu", {operation = "runtime-open",})
    if type(answer) ~= "table" or answer.driver ~= "webgpu" then
        error("nupp: browser GPU returned an invalid open response", 2)
    end

    return new gpu.Context(_destroy = contextdestroyNosuspend, _closed = false, _buffers = {}, _kernels = {})
end

export const open = gpu.open
