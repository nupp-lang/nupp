@!internal
module nupp.runtime.browser.host

--[[
The page's answers to [](nupp.host) requests.

A frame's host traffic is one `host` effect, `x`, carrying binary records
([](nupp.runtime.browser.hostwire)) in a read lease and lending a writable
inbox for the page's records back. Requests wait as Lua records until the frame
is about to ship, and only then are encoded, so a call cancelled before that
never reaches the page. The page answers `x` at the end of its frame with
whatever answers and inbound messages are ready, and holds the frame until
something is, so a waiting application does not spin.

Bytes up to one MiB travel inside the records, copied from the caller's span
when the frame ships; a call's caller is suspended until then, so its span is
alive, and a post or send copies its bytes when it is made. A larger argument
is uploaded first in one-MiB `upload` effects the page reassembles, and the
call's record waits for them. A byte result small enough rides the inbox;
a larger one stays with the page, announced, until the caller admits it against
the guest's reassembly budget and `fetch`es it into storage it owns. The page
releases a result when its last byte is fetched, or when the guest abandons it;
until then it is the page's. A caller cancelled before that point never
received its result, so the page releases it rather than `late`.
]]

local effects = require("nupp.runtime.browser.effects")
local suspension = require("nupp.suspension")
local suspensionHost = require("nupp.suspension.host")
local suspensionContract = require("nupp.suspension.spi")
local values = require("nupp.host.internal.values")
local wire = require("nupp.runtime.browser.hostwire")
local json = require("nupp.runtime.provider.lunajson")
local ffi = require("ffi")

local unpackValues: any = rawget(_G, "unpack") or (table as any).unpack

local provider = {}

--- The guest memory committed to byte results being fetched, at most. The
--- application guest has about 44 MiB in all, so this stays a fifth of it.
const RESULT_BUDGET_BYTES = 8 * 1024 * 1024

--- How many posts may wait to ship before posting raises.
const MAX_PENDING_POSTS = 1024

--- The inbox a frame lends to begin with, and the most it ever lends.
const INBOX_BYTES = 4096

const MAX_INBOX_BYTES = 1024 * 1024

local memoryModule: any = nil

local function memory(): any
    if memoryModule == nil then
        memoryModule = require("nupp.runtime.browser.memory")
    end

    return memoryModule
end

local function report(kind: string, problem: any): nil
    io.stderr:write("nupp: host " .. kind .. ": " .. tostring(problem) .. "\n")
end

local refusingHandler = new suspensionContract.Handler(
    park = function(_: any, _: any, _: any): nil
        error("nupp: a host late handler cannot suspend; release with host.post", 0)
    end,
    canPark = function(_: any): boolean
        return false
    end,
    shutdown = function(_: any): nil
    end
)

-- Runs `late` where nothing may park, so a call that would wait raises instead.
local function runLate(kind: string, late: any, ...: any): nil
    local installed = suspensionHost.install(refusingHandler)
    local ok, problem = pcall(late, ...)
    installed:close()
    if not ok then
        report(kind, "late handler failed: " .. tostring(problem))
    end
end

----------------------------------------------------------------------------
-- The frame
----------------------------------------------------------------------------

local nextRecord = 1
local nextTransfer = 1
-- Records waiting for the next frame, in the order they were made.
local pending: {any} = {}
local pendingPosts = 0
-- Calls the page has been sent and not yet answered, by record id.
local calls: {[integer]: any} = {}
local callCount = 0
local routes: {[string]: any} = {}
local routeCount = 0
local inboxBytes: integer = INBOX_BYTES
-- The frame request waiting to ship, kept queued while anything is owed so the
-- effect layer knows this provider is waiting on the page.
local frame: any = nil
-- Senders `block` suspended until the frame that holds their stream ships.
local blockedSenders: {any} = {}
-- The buffer one frame at a time reuses. A frame prepared but not yet answered
-- still owns its buffer, so another frame gets its own.
local spareWriter: any = nil
local unanswered: integer = 0

local function newRecord(op: integer, kind: string?): any
    local id = nextRecord
    nextRecord = nextRecord + 1
    return {op = op, id = id, kind = kind}
end

local function needsFrame(): boolean
    return #pending > 0 or callCount > 0 or routeCount > 0
end

local ensureFrame: function(): nil

-- Packs one value list. A byte value is copied into the records from its
-- pointer, which a call's suspended caller or a post's own copy keeps alive.
local function writeValues(writer: any, list: any): nil
    local count = list.n as integer
    wire.u16(writer, count)
    for position = 1, count do
        local value = list[position]
        local tag = list.tags[position]
        if tag == "nil" then
            wire.u8(writer, wire.NIL)
        elseif tag == "boolean" then
            wire.u8(writer, value and wire.TRUE or wire.FALSE)
        elseif tag == "number" then
            wire.u8(writer, wire.NUMBER)
            wire.f64(writer, value)
        elseif tag == "string" then
            wire.u8(writer, wire.STRING)
            wire.sized(writer, value, #value)
        elseif tag == "bytes" then
            wire.u8(writer, wire.BYTES)
            wire.sized(writer, value.pointer, value.size)
        else
            wire.u8(writer, wire.UPLOAD)
            wire.u32(writer, value.transfer)
        end
    end
end

local function writeRecord(writer: any, record: any): nil
    wire.u8(writer, record.op)
    wire.u32(writer, record.id)
    local op = record.op
    if op == wire.CALL or op == wire.POST or op == wire.SEND then
        wire.u16(writer, #record.kind)
        wire.raw(writer, record.kind, #record.kind)
        writeValues(writer, record.values)
    elseif op == wire.ABANDON then
        wire.u32(writer, record.result)
    elseif op == wire.ABORT then
        wire.u32(writer, record.transfer)
    elseif op == wire.ROUTES then
        wire.sized(writer, record.text, #record.text)
    end
end

-- Writes the waiting records into the frame request just before it ships,
-- with the inbox it lends. A record whose uploads have not all arrived waits,
-- and past one MiB of records the rest wait for the next frame.
local function prepareFrame(): boolean
    local current = frame
    if current == nil then
        return false
    end
    local writer: any = nil
    if unanswered == 0 and spareWriter ~= nil then
        writer = spareWriter
        wire.reset(writer)
    else
        writer = wire.writer(1024)
    end
    local kept: {any} = {}
    local shipped: {any} = {}
    for _, record in ipairs(pending) do
        local size = (record.size or 64) as integer
        -- A record larger than one frame's share ships alone.
        if (record.uploads or 0) > 0 or (writer.length > 0 and writer.length + size > values.CHUNK_BYTES) then
            kept[#kept + 1] = record
        else
            writeRecord(writer, record)
            shipped[#shipped + 1] = record
        end
    end
    pending = kept
    for _, record in ipairs(shipped) do
        record.shipped = true
        if record.op == wire.POST then
            pendingPosts = pendingPosts - 1
        end
    end
    -- One buffer carries the records out and the page's answers back: the page
    -- reads the records, then writes over them. Every lease costs the bridge a
    -- copy each way and a descriptor in the frame's text, so a frame lends one.
    local records = writer.length
    local size = math.max(records, inboxBytes) as integer
    if writer.capacity < size then
        local grown = wire.writer(size)
        wire.raw(grown, writer.buffer, records)
        writer = grown
    end
    current.writer = writer
    current.inbox = writer.buffer
    current.inboxBytes = size
    unanswered = unanswered + 1
    current.inboxLease = memory().lease(writer.buffer, size, true)
    current.payload.spans = {{lease = current.inboxLease, bytes = size}}
    current.payload.records = records
    frame = nil
    -- A sender a full stream blocked may send into the next frame now, and
    -- since it can run, this frame must not wait for the page.
    local blocked = blockedSenders
    blockedSenders = {}
    for _, resume in ipairs(blocked) do
        resume(true)
    end

    return #blocked > 0
end

effects.beforePark(prepareFrame)

local function readValues(reader: any, count: integer): (any, any)
    local decoded: any = {}
    local fetches: any = nil
    for position = 1, count do
        local tag = wire.readU8(reader)
        if tag == wire.FALSE then
            decoded[position] = false
        elseif tag == wire.TRUE then
            decoded[position] = true
        elseif tag == wire.NUMBER then
            decoded[position] = wire.readF64(reader)
        elseif tag == wire.STRING then
            decoded[position] = wire.readString(reader, wire.readU32(reader))
        elseif tag == wire.BYTES then
            local text = wire.readString(reader, wire.readU32(reader))
            decoded[position] = values.byteSpan(text, ffi.cast("const uint8_t *", text), #text)
        elseif tag == wire.FETCH then
            fetches = fetches or {}
            fetches[#fetches + 1] = {index = position, size = wire.readU32(reader)}
        elseif tag ~= wire.NIL then
            error("nupp: a host answer carried an unknown value tag " .. tostring(tag), 0)
        end
    end

    return decoded, fetches
end

local function control(record: any): nil
    pending[#pending + 1] = record
    ensureFrame()
end

-- Hands a late answer to `late`, or has the page release a result the caller
-- never came to own.
local function deliverLate(entry: any, answer: any): nil
    if not answer.ok then
        return
    end
    if answer.result ~= 0 then
        local record = newRecord(wire.ABANDON)
        record.result = answer.result
        control(record)
        return
    end
    if entry.late ~= nil then
        runLate(entry.kind, entry.late, unpackValues(answer.values, 1, answer.count))
    end
end

local function deliverAnswer(id: integer, answer: any): nil
    local entry = calls[id]
    if entry == nil then
        return
    end
    calls[id] = nil
    callCount = callCount - 1
    if entry.cancelled then
        deliverLate(entry, answer)
    elseif entry.resume ~= nil then
        -- Held until the caller takes it: a task cancelled after this resumed it
        -- but before it ran never does, and the answer is then late's.
        entry.answer = answer
        entry.resume(answer)
    end
end

local function deliverMessage(kind: string, list: any, count: integer): nil
    local route = routes[kind]
    if route == nil then
        return
    end
    local delivered, problem = pcall(route.deliver, unpackValues(list, 1, count))
    if not delivered then
        report(kind, "delivery failed: " .. tostring(problem))
    end
end

-- Reads the page's records out of a frame's inbox: answers to calls, routed
-- messages, and what each route's policy dropped where the messages start.
local function readInbox(current: any, written: integer): nil
    local reader = wire.reader(current.inbox, written)
    local messages: any = nil
    while wire.remaining(reader) > 0 do
        local op = wire.readU8(reader)
        if op == wire.ANSWER then
            local id = wire.readU32(reader)
            local ok = wire.readU8(reader) == 1
            if ok then
                local result = wire.readU32(reader)
                local count = wire.readU16(reader)
                local decoded, fetches = readValues(reader, count)
                deliverAnswer(id, {ok = true, result = result, count = count, values = decoded, fetches = fetches})
            else
                deliverAnswer(id, {ok = false, error = wire.readString(reader, wire.readU32(reader))})
            end
        elseif op == wire.MESSAGE then
            local kind = wire.readString(reader, wire.readU16(reader))
            local count = wire.readU16(reader)
            local decoded = readValues(reader, count)
            messages = messages or {}
            messages[#messages + 1] = {kind = kind, values = decoded, count = count}
        elseif op == wire.DROPPED then
            local kind = wire.readString(reader, wire.readU16(reader))
            local count = wire.readU32(reader)
            local route = routes[kind]
            if route ~= nil then
                route.dropped = route.dropped + count
            end
        else
            error("nupp: a host frame's inbox held an unknown record " .. tostring(op), 0)
        end
    end
    if messages ~= nil then
        -- Observers run here, outside any task, so nothing they do may wait.
        local installed = suspensionHost.install(refusingHandler)
        for _, message in ipairs(messages) do
            deliverMessage(message.kind, message.values, message.count)
        end
        installed:close()
    end
end

local function frameAnswered(current: any, response: any): nil
    unanswered = unanswered - 1
    spareWriter = current.writer
    if current.inboxLease ~= nil then
        memory().releaseLease(current.inboxLease)
    end
    if type(response) == "table" and response.ok == true and type(response.value) == "table" then
        local value = response.value
        local written = value.written
        if type(written) == "number" and written > 0 and written <= current.inboxBytes then
            readInbox(current, written as integer)
        end
        local more = value.more
        if type(more) == "number" and more > 0 then
            inboxBytes = math.floor(
                math.min(MAX_INBOX_BYTES, math.max(inboxBytes * 2, (written or 0) + more))
            ) as integer
        elseif inboxBytes > INBOX_BYTES and (written or 0) < inboxBytes / 4 then
            inboxBytes = math.max(INBOX_BYTES, math.floor(inboxBytes / 2)) as integer
        end
    elseif type(response) == "table" and response.ok == false then
        report("frame", response.error)
    end
    ensureFrame()
end

ensureFrame = function(): nil
    if frame ~= nil or not needsFrame() then
        return
    end
    local current: any = {payload = {op = "x"}}
    frame = current
    effects.request("host", current.payload, function(response: any): nil
        frameAnswered(current, response)
    end)
end

----------------------------------------------------------------------------
-- Arguments
----------------------------------------------------------------------------

-- Classifies a request's arguments into a list the frame packs later. A byte
-- argument is lent by pointer for a call, copied for a post or send, and past
-- one MiB in a request, uploaded first; a post or send may not carry that much.
local function argumentList(kind: string, copyBytes: boolean, ...: any): (any, integer, any)
    local count = select("#", ...)
    local list: any = {n = count, tags = {}}
    local size: integer = 64 + #kind
    local carried: integer = 0
    local uploads: any = nil
    for position = 1, count do
        local tag, value, length = values.classify(kind, position, (select(position, ...)))
        if tag == "bytes" then
            local bytes = length as integer
            if carried + bytes > values.CHUNK_BYTES then
                if copyBytes then
                    error(
                        string.format("nupp: host %s carries more than the one MiB of bytes a post or send may", kind),
                        0
                    )
                end
                uploads = uploads or {}
                local transfer = nextTransfer
                nextTransfer = nextTransfer + 1
                uploads[#uploads + 1] = {transfer = transfer, pointer = value, size = bytes}
                list.tags[position] = "upload"
                list[position] = {transfer = transfer}
                size = size + 8
            else
                local pointer: any = value
                local anchor: any = nil
                if copyBytes then
                    anchor = ffi.string(value, bytes)
                    pointer = anchor
                end
                list.tags[position] = "bytes"
                list[position] = {pointer = pointer, size = bytes, anchor = anchor}
                size = size + bytes + 8
                carried = carried + bytes
            end
        else
            list.tags[position] = tag
            list[position] = value
            size = size + (tag == "string" and #value or 0) + 12
        end
    end

    return list, size, uploads
end

----------------------------------------------------------------------------
-- Uploads and fetches, for bytes past what one frame carries
----------------------------------------------------------------------------

-- Queues each upload's chunks as effects of their own; the call's record waits
-- until the page has every chunk. Answers the cancel functions and leases.
local function queueUploads(record: any, uploads: any): (any, any)
    local cancels: any = {}
    local leases: any = {}
    local guestMemory = memory()
    for _, upload in ipairs(uploads) do
        local base: any = ffi.cast("const uint8_t *", upload.pointer)
        local offset = 0
        while offset < upload.size do
            local length = math.min(values.CHUNK_BYTES, upload.size - offset)
            local lease = guestMemory.lease(base + offset, length, false)
            leases[#leases + 1] = lease
            record.uploads = (record.uploads or 0) + 1
            cancels[#cancels + 1] = effects.request(
                "host",
                {
                    op = "upload",
                    transfer = upload.transfer,
                    offset = offset,
                    total = upload.size,
                    spans = {{lease = lease, bytes = length}},
                },
                function(response: any): nil
                    guestMemory.releaseLease(lease)
                    record.uploads = record.uploads - 1
                    if type(response) == "table" and response.ok == false then
                        record.uploadFailure = record.uploadFailure or response.error
                    end
                end,
                nil,
                true
            )
            offset = offset + length
        end
    end

    return cancels, leases
end

local admittedBytes: integer = 0
local admissionWaiters: {any} = {}

local function release(amount: integer): nil
    admittedBytes = admittedBytes - amount
    while #admissionWaiters > 0 do
        local waiter = admissionWaiters[1]
        if admittedBytes + waiter.size > RESULT_BUDGET_BYTES then
            return
        end
        table.remove(admissionWaiters, 1)
        admittedBytes = admittedBytes + (waiter.size as integer)
        waiter.resume(true)
    end
end

-- Waits until `size` more bytes fit the guest's reassembly budget, then holds
-- them for the caller. Waiters are admitted in arrival order.
local function admit(kind: string, size: integer): nil
    if #admissionWaiters == 0 and admittedBytes + size <= RESULT_BUDGET_BYTES then
        admittedBytes = admittedBytes + size
        return
    end
    suspension.suspend("host " .. kind .. " result admission", function(resume: function(any): nil): function()
        local waiter = {size = size, resume = resume}
        admissionWaiters[#admissionWaiters + 1] = waiter
        return function(): nil
            for index = #admissionWaiters, 1, -1 do
                if admissionWaiters[index] == waiter then
                    table.remove(admissionWaiters, index)
                end
            end
        end
    end)
end

local function abandon(result: integer): nil
    local record = newRecord(wire.ABANDON)
    record.result = result
    control(record)
end

-- Fetches the byte results the page announced into storage the caller owns. The
-- page owns them until the last byte arrives; a caller stopped before that
-- abandons them, and the page releases them itself.
local function fetchBytes(kind: string, result: integer, announced: any, decoded: any): nil
    local total: integer = 0
    for _, entry in ipairs(announced) do
        local size = entry.size as integer
        if size > values.MAX_INBOUND_BYTES then
            abandon(result)
            error("nupp: host " .. kind .. " answered a byte value larger than 8 MiB", 0)
        end
        total = total + size
    end
    if total > RESULT_BUDGET_BYTES then
        abandon(result)
        error(string.format("nupp: host %s answered %d bytes, more than the 8 MiB a result may hold", kind, total), 0)
    end
    local admitted, admissionProblem = pcall(admit, kind, total)
    if not admitted then
        abandon(result)
        error(admissionProblem, 0)
    end
    local storage: any = {}
    local guestMemory = memory()
    local fetched, problem = pcall(suspension.suspend, "host " .. kind .. " result", function(
        resume: function(any): nil
    ): function()
        local outstanding = 0
        local failure: any = nil
        local cancels: any = {}
        local leases: any = {}

        local function settled(response: any): nil
            outstanding = outstanding - 1
            if failure == nil and (type(response) ~= "table" or response.ok ~= true) then
                failure = type(response) == "table" and response.error or "invalid fetch response"
            end
            if outstanding == 0 then
                resume(failure)
            end
        end

        for index, entry in ipairs(announced) do
            local size = entry.size as integer
            local buffer = ffi.new("uint8_t[?]", math.max(size, 1))
            storage[index] = buffer
            local offset = 0
            while offset < size do
                local length = math.min(values.CHUNK_BYTES, size - offset)
                local lease = guestMemory.lease(buffer + offset, length, true)
                leases[#leases + 1] = lease
                outstanding = outstanding + 1
                cancels[#cancels + 1] = effects.request(
                    "host",
                    {
                        op = "fetch",
                        result = result,
                        index = entry.index,
                        offset = offset,
                        spans = {{lease = lease, bytes = length}},
                    },
                    function(response: any): nil
                        guestMemory.releaseLease(lease)
                        settled(response)
                    end,
                    nil,
                    true
                )
                offset = offset + length
            end
        end
        if outstanding == 0 then
            resume(nil)
        end

        return function(): nil
            for _, cancel in ipairs(cancels) do
                cancel()
            end
            for _, lease in ipairs(leases) do
                guestMemory.releaseLease(lease)
            end
            abandon(result)
        end
    end)
    release(total)
    if not fetched then
        error(problem, 0)
    end
    if problem ~= nil then
        abandon(result)
        error("nupp: host " .. kind .. " result could not be fetched: " .. tostring(problem), 0)
    end
    for index, entry in ipairs(announced) do
        decoded[entry.index] = values.byteSpan(storage[index], storage[index], entry.size)
    end
end

----------------------------------------------------------------------------
-- Requests
----------------------------------------------------------------------------

function provider.attached(): boolean
    return true
end

function provider.call(kind: string, late: any, ...: any): ...any
    local list, size, uploads = argumentList(kind, false, ...)
    local record = newRecord(wire.CALL, kind)
    record.values = list
    record.size = size
    local uploadCancels: any = nil
    local uploadLeases: any = nil
    if uploads ~= nil then
        uploadCancels, uploadLeases = queueUploads(record, uploads)
    end
    local entry: any = {kind = kind, late = late, cancelled = false, resume = nil, answer = nil}
    local ok, suspended = pcall(suspension.suspend, "host " .. kind, function(resume: function(any): nil): function()
        entry.resume = resume
        calls[record.id] = entry
        callCount = callCount + 1
        pending[#pending + 1] = record
        ensureFrame()

        return function(): nil
            entry.resume = nil
            if entry.answer ~= nil then
                local answer = entry.answer
                entry.answer = nil
                deliverLate(entry, answer)
                return
            end
            if not record.shipped then
                -- Never sent: the page will not hear of it at all.
                for index = #pending, 1, -1 do
                    if pending[index] == record then
                        table.remove(pending, index)
                    end
                end
                if calls[record.id] == entry then
                    calls[record.id] = nil
                    callCount = callCount - 1
                end
            else
                entry.cancelled = true
                local cancel = newRecord(wire.CANCEL)
                cancel.id = record.id
                control(cancel)
            end
            if uploadCancels ~= nil then
                local anyShipped = false
                for _, cancel in ipairs(uploadCancels) do
                    if not cancel() then
                        anyShipped = true
                    end
                end
                if anyShipped then
                    for _, upload in ipairs(uploads) do
                        local abort = newRecord(wire.ABORT)
                        abort.transfer = upload.transfer
                        control(abort)
                    end
                end
            end
        end
    end)
    if uploadLeases ~= nil then
        local guestMemory = memory()
        for _, lease in ipairs(uploadLeases) do
            guestMemory.releaseLease(lease)
        end
    end
    if not ok then
        error(suspended, 0)
    end
    local answer = suspended as any
    entry.answer = nil
    if not answer.ok then
        error("nupp: host " .. kind .. " failed: " .. tostring(answer.error), 0)
    end
    local decoded = answer.values
    if answer.fetches ~= nil then
        fetchBytes(kind, answer.result, answer.fetches, decoded)
    end

    return unpackValues(decoded, 1, answer.count)
end

function provider.post(kind: string, ...: any): nil
    if pendingPosts >= MAX_PENDING_POSTS then
        error("nupp: host " .. kind .. " cannot be posted: 1024 posts are already waiting to ship", 0)
    end
    local list, size = argumentList(kind, true, ...)
    local record = newRecord(wire.POST, kind)
    record.values = list
    record.size = size
    pendingPosts = pendingPosts + 1
    pending[#pending + 1] = record
    ensureFrame()
end

----------------------------------------------------------------------------
-- Streams
----------------------------------------------------------------------------

function provider.send(kind: string, policy: string, limit: integer, ...: any): nil
    local held: integer = 0
    local oldest: integer? = nil
    for index, record in ipairs(pending) do
        if record.op == wire.SEND and record.kind == kind then
            held = held + 1
            oldest = oldest or index
        end
    end
    -- `latest` keeps one message whatever the limit says.
    if held >= (policy == "latest" and 1 or limit) then
        if policy == "latest" or policy == "dropOldest" then
            table.remove(pending, oldest as integer)
        else
            -- `block`: wait for the waiting messages to ship, then send.
            suspension.suspend("host stream " .. kind, function(resume: function(any): nil): function()
                blockedSenders[#blockedSenders + 1] = resume
                return function(): nil
                    for index = #blockedSenders, 1, -1 do
                        if blockedSenders[index] == resume then
                            table.remove(blockedSenders, index)
                        end
                    end
                end
            end)
            provider.send(kind, policy, limit, ...)
            return
        end
    end
    local list, size = argumentList(kind, true, ...)
    local record = newRecord(wire.SEND, kind)
    record.values = list
    record.size = size
    pending[#pending + 1] = record
    ensureFrame()
end

-- What the page needs to apply each route's policy where the messages start.
local function routesRecord(): any
    local policies: any = {}
    for kind, route in pairs(routes) do
        policies[kind] = {p = route.policy, l = route.limit}
    end
    local record = newRecord(wire.ROUTES)
    record.text = json.encode(json.asObject(policies))
    record.size = 64 + #record.text

    return record
end

function provider.route(kind: string, policy: string, limit: integer, deliver: any): (any, any)
    if routes[kind] ~= nil then
        error("nupp: host stream " .. kind .. " is already routed; close that route first", 0)
    end
    local route: any = {deliver = deliver, policy = policy, limit = limit, dropped = 0}
    routes[kind] = route
    routeCount = routeCount + 1
    -- The page applies policies where messages start, so it hears of every
    -- change, in order with whatever else this turn sends.
    control(routesRecord())

    local function stop(): nil
        if routes[kind] == route then
            routes[kind] = nil
            routeCount = routeCount - 1
            control(routesRecord())
        end
    end

    local function dropped(): integer
        return route.dropped
    end

    return stop, dropped
end

export = provider
