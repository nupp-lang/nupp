@!internal
module nupp.runtime.browser.files

local effects = require("nupp.runtime.browser.effects")
local messages = require("nupp.io.files.messages")
local appPaths = require("nupp.io.files.path")
local io = require("nupp.io")
local span = require("nupp.mem.span")
local suspension = require("nupp.suspension")
local memory = require("nupp.runtime.browser.memory") as any

local files = {}
local pending: integer = 0
local READ_SIZE: integer = 65536
local ORIGINS = {set = 0, current = 1, ["end"] = 2,}
local MODES = {r = true, w = true, a = true, ["r+"] = true, ["w+"] = true, ["a+"] = true,}
local APPLICATION_KINDS = {configuration = true, data = true, cache = true,}
local MAX_EXACT_INTEGER: integer = 9007199254740991

local function unavailable(operation: string): string
    return "browser files do not support " .. operation
end

local function descriptor(value: any, level: integer): any
    if not appPaths.is(value) then
        error("nupp: browser file paths must come from an application path", level)
    end
    local described = appPaths.descriptor(value as appPaths.ApplicationPath)
    if described.provider ~= "browser" then
        error("nupp: browser file paths must come from this browser provider", level)
    end

    return {root = described.root, parts = described.parts,}
end

local function whole(value: any, what: string, level: integer): integer
    if type(value) ~= "number"
        or value ~= math.floor(value as number)
        or math.abs(value as number) > MAX_EXACT_INTEGER
    then
        error("nupp: io.files " .. what .. " must be an integer", level)
    end

    return value as integer
end

local function positive(value: any, what: string, level: integer): integer
    local answer = whole(value, what, level + 1)
    if answer < 1 then
        error("nupp: io.files " .. what .. " must be positive", level)
    end

    return answer
end

local function counted(value: any, what: string, level: integer): integer
    local answer = whole(value, what, level + 1)
    if answer < 0 then
        error("nupp: io.files " .. what .. " must not be negative", level)
    end

    return answer
end

local function protocol(value: any, field: string, minimum: integer): (integer?, string?)
    if type(value) ~= "table" then
        return nil, "browser file host returned no " .. field
    end
    local answer = (value as any)[field]
    if type(answer) ~= "number"
        or answer ~= math.floor(answer as number)
        or (answer as number) < minimum
        or (answer as number) > MAX_EXACT_INTEGER
    then
        return nil, "browser file host returned an invalid " .. field
    end

    return answer as integer, nil
end

local function effect(operation: string, path: any?, extra: any?, discard: (function(any): nil)?): (any?, string?)
    local payload = extra or {}
    payload.operation = operation
    if path ~= nil then
        local described = descriptor(path, 4)
        payload.root = described.root
        payload.parts = described.parts
    end
    local completed, suspended = pcall(suspension.suspend, "browser file operation", function(
        resume: function(any): nil
    ): function()
        return effects.request("files", payload, resume, discard)
    end)
    if not completed then
        -- The wait failed, not the file operation: a cancelled task, or an
        -- application the page cancelled. Answering that as a file error would let
        -- the task carry on as though nothing had asked it to stop.
        if payload.lease ~= nil then
            memory.releaseLease(payload.lease)
        end
        error(suspended, 0)
    end
    local answer = suspended as any
    if type(answer) ~= "table" or type(answer.ok) ~= "boolean" then
        return nil, "browser file host returned an invalid response"
    end
    if not answer.ok then
        return nil, type(answer.error) == "string" and answer.error or "browser file operation failed"
    end

    return answer.value, nil
end

function files.capabilities(): messages.Capabilities
    local value = effect("capabilities", nil)
    local available = type(value) == "table" and value.available == true
    return new messages.Capabilities(
        available = available,
        arbitraryPaths = false,
        symbolicLinks = false,
        readOnlyAttributes = false,
        glob = false,
        rename = false,
        atomicWrite = false,
        temporaryPaths = false,
        concurrentOpenHandles = false,
        currentDirectory = false,
        userFolders = false,
        executableDirectory = false,
        persistentStorageRequest = available and value.persistentAvailable == true
    )
end

function files.applicationPath(
    kind: string,
    organization: string,
    application: string
): (appPaths.ApplicationPath?, string?)
    if APPLICATION_KINDS[kind] == nil then
        return nil, "unknown application path kind"
    end
    local path = appPaths.browser(kind, organization, application)
    local value, reason = effect("create-directory", path)
    if reason ~= nil then
        return nil, reason
    end
    if type(value) ~= "table" or value.created ~= true then
        return nil, "browser file host returned an invalid create result"
    end

    return path, nil
end

function files.info(path: any): (messages.Info?, string?)
    local value, reason = effect("info", path)
    if value == nil then
        return nil, reason
    end

    local kind = type(value) == "table" and value.kind or nil
    local size = type(value) == "table" and value.size or nil
    local modified = type(value) == "table" and value.modified or nil
    if (kind ~= "file" and kind ~= "directory")
        or type(size) ~= "number"
        or size ~= math.floor(size as number)
        or (size as number) < 0
        or (size as number) > MAX_EXACT_INTEGER
        or type(modified) ~= "number"
        or modified ~= modified
        or modified == math.huge
        or modified == -math.huge
    then
        return nil, "browser file host returned invalid metadata"
    end

    return new messages.Info(kind = kind, size = size, modified = modified, readOnly = false), nil
end

function files.exists(path: any): boolean
    local value = files.info(path)
    return value ~= nil
end

function files.isFile(path: any): boolean
    local value = files.info(path)
    return value ~= nil and value.kind == "file"
end

function files.isDirectory(path: any): boolean
    local value = files.info(path)
    return value ~= nil and value.kind == "directory"
end

function files.isSymlink(path: any): (boolean?, string?)
    descriptor(path, 2)
    return nil, unavailable("symbolic links")
end

function files.readLink(path: any): (string?, string?)
    descriptor(path, 2)
    return nil, unavailable("symbolic links")
end

function files.createSymlink(target: any, link: any, kind: any): (boolean, string?)
    descriptor(target, 2)
    descriptor(link, 2)
    return false, unavailable("symbolic links")
end

function files.setReadOnly(path: any, readOnly: boolean): (boolean, string?)
    descriptor(path, 2)
    return false, unavailable("read-only attributes")
end

function files.createDirectory(path: any): (boolean, string?)
    local value, reason = effect("create-directory", path)
    if value == nil then
        return false, reason
    end

    return type(value) == "table" and value.created == true, type(value) == "table" and value.created == true and nil
        or "browser file host returned an invalid create result"
end

function files.remove(path: any, recursive: boolean?): (boolean, string?)
    local value, reason = effect("remove", path, {recursive = recursive == true,})
    if value == nil then
        return false, reason
    end

    return type(value) == "table" and value.removed == true, type(value) == "table" and value.removed == true and nil
        or "browser file host returned an invalid remove result"
end

function files.rename(from: any, to: any): (boolean, string?)
    descriptor(from, 2)
    descriptor(to, 2)
    return false, unavailable("rename")
end

function files.list(path: any): ({messages.Entry}?, string?)
    local value, reason = effect("list", path)
    if value == nil then
        return nil, reason
    end
    if type(value) ~= "table" then
        return nil, "browser file host returned an invalid directory listing"
    end
    local entries: {messages.Entry} = {}
    for _, entry in ipairs(value) do
        if type(entry) ~= "table"
            or type(entry.name) ~= "string"
            or entry.name == ""
            or (entry.kind ~= "file" and entry.kind ~= "directory")
        then
            return nil, "browser file host returned an invalid directory entry"
        end
        entries[#entries + 1] = new messages.Entry(name = entry.name, kind = entry.kind)
    end

    return entries, nil
end

function files.glob(path: any): ({string}?, string?)
    descriptor(path, 2)
    return nil, unavailable("glob")
end

local record File is io.Reader, io.Writer
    @private
    _handle: integer
    @private
    _closed: boolean

    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local wanted = math.min(positive(count, "File:read count", 2), READ_SIZE)
        local destination = io.newBuffer(wanted)
        local lease = destination:reserveWrite(0, wanted)
        local got: integer?
        local reason: string?
        do
            local output = lease:span()
            got, reason = self:readSpan(output)
            nupp.drop(output)
        end
        lease:commit(got or 0)
        if got == nil then
            return nil, reason
        end

        return destination:getString(), nil
    end

    function readSpan(exclusive self, exclusive destination: span.Writable<uint8>): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local pointer, capacity = destination:ref()
        local count = positive(math.min(capacity, READ_SIZE), "File:readSpan destination length", 2)
        local leaseRead = memory.lease as function(
            exclusive pointer: uint8[?],
            count: integer,
            writable: boolean?
        ): integer
        local lease = leaseRead(pointer, count, true)
        local value, reason = effect("file-read", nil, {handle = self._handle, lease = lease, count = count,})
        memory.releaseLease(lease)
        if value == nil then
            return nil, reason
        end
        local got, invalid = protocol(value, "bytes", 0)
        if got ~= nil and got > count then
            return nil, "browser file host returned an invalid byte count"
        end

        return got, invalid
    end

    function readInto(
        exclusive self,
        exclusive destination: io.Buffer,
        offset: integer?,
        count: integer?
    ): (integer?, string?)
        local from = counted(offset or 0, "File:readInto offset", 2)
        local wanted = math.min(positive(count or READ_SIZE, "File:readInto count", 2), READ_SIZE)
        local lease = destination:reserveWrite(from, wanted)
        local got: integer?
        local reason: string?
        do
            local output = lease:span()
            got, reason = self:readSpan(output)
            nupp.drop(output)
        end
        if got == nil then
            lease:commit(0)
            return nil, reason
        end
        lease:commit(got)

        return got, nil
    end

    function transferTo(exclusive self, exclusive destination: io.Writer): (integer?, string?)
        local total: integer = 0
        while true do
            local chunk, reason = self:read(READ_SIZE)
            if chunk == nil then
                return nil, reason
            end
            if #chunk == 0 then
                return total, nil
            end
            local wrote, failure = destination:write(chunk)
            if not wrote then
                return nil, failure
            end
            total = total + #chunk
        end
    end

    function write(exclusive self, bytes: string): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end
        local source = span.fromString(bytes)
        local wrote, reason = self:writeSpan(source)
        if wrote == nil then
            return false, reason
        end
        if wrote ~= #bytes then
            return false, "browser file host performed a short write"
        end

        return true, nil
    end

    function writeSpan(exclusive self, borrows source: span.ByteSpan): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local total: integer = 0
        while total < #source do
            local count = math.min(READ_SIZE, #source - total)
            local chunk = source:slice(total + 1, total + count)
            local pointer = chunk:ref()
            local leaseWrite = memory.lease as function(
                borrows pointer: const uint8[?],
                count: integer,
                writable: boolean?
            ): integer
            local lease = leaseWrite(pointer, count, false)
            local value, reason = effect("file-write", nil, {handle = self._handle, lease = lease, count = count,})
            memory.releaseLease(lease)
            if value == nil then
                return nil, reason
            end
            local wrote, invalid = protocol(value, "bytes", 0)
            if wrote == nil then
                return nil, invalid
            end
            if wrote ~= count then
                return nil, "browser file host performed a short write"
            end
            total = total + wrote
        end

        return total, nil
    end

    function size(borrows self): (integer?, string?)
        if self._closed then
            error("nupp: io.files File is closed", 2)
        end
        local value, reason = effect("file-size", nil, {handle = self._handle,})
        if value == nil then
            return nil, reason
        end

        return protocol(value, "size", 0)
    end

    function seek(exclusive self, offset: integer?, origin: messages.Origin?): (integer?, string?)
        if self._closed then
            error("nupp: io.files File is closed", 2)
        end
        local whence = ORIGINS[origin or "set"]
        if whence == nil then
            error("nupp: io.files has no seek origin named " .. tostring(origin), 2)
        end

        local value, reason = effect("file-seek", nil, {
            handle = self._handle,
            offset = whole(offset or 0, "seek offset", 2),
            origin = whence,
        })
        if value == nil then
            return nil, reason
        end

        return protocol(value, "position", 0)
    end

    function position(exclusive self): (integer?, string?)
        return self:seek(0, "current")
    end

    function flush(borrows self): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end
        local value, reason = effect("file-flush", nil, {handle = self._handle,})
        if value == nil then
            return false, reason
        end
        if type(value) ~= "table" or value.flushed ~= true then
            return false, "browser file host returned an invalid flush result"
        end

        return true, nil
    end

    function isReleased(borrows self): boolean
        return self._closed
    end

    close: @nosuspend function(takes self: File): nil
end

function File.close(takes self: File): nil
    local state = @unsafe nupp.release(self)
    if state._closed then
        return
    end
    state._closed = true
    effects.request("files", {operation = "file-close", handle = state._handle,}, function(): nil
    end)
end

-- An open cancelled after it shipped still opened a file over in the host, and an
-- OPFS access handle is exclusive: without this the file stays locked until the
-- run ends, because no File was ever built to close it.
local function closeOrphan(response: any): nil
    if type(response) == "table"
        and response.ok
        and type(response.value) == "table"
        and type(response.value.handle) == "number"
        and response.value.handle == math.floor(response.value.handle)
        and response.value.handle >= 1
        and response.value.handle <= MAX_EXACT_INTEGER
    then
        effects.request("files", {operation = "file-close", handle = response.value.handle,}, function(): nil
        end)
    end
end

function files.open(path: any, mode: messages.Mode?): (affine(File?), string?)
    local selected = mode or "r"
    if MODES[selected] == nil then
        error("nupp: io.files has no mode named " .. tostring(mode), 2)
    end
    local value, reason = effect("open", path, {mode = selected,}, closeOrphan)
    if value == nil then
        return nil, reason
    end
    local handle, invalid = protocol(value, "handle", 1)
    if handle == nil then
        return nil, invalid
    end

    return new File(_handle = handle, _closed = false), nil
end

local function wholeRead(path: any): (string?, string?)
    pending = pending + 1
    local opened, reason = files.open(path, "r")
    if opened == nil then
        pending = pending - 1
        return nil, reason
    end
    local file = opened as File
    local pieces: {string} = {}
    while true do
        local chunk, failure = file:read(READ_SIZE)
        if chunk == nil then
            file:close()
            pending = pending - 1
            return nil, failure
        end
        if #chunk == 0 then
            break
        end
        pieces[#pieces + 1] = chunk
    end
    file:close()
    pending = pending - 1

    return table.concat(pieces), nil
end

function files.read(path: any): (string?, string?)
    return wholeRead(path)
end

local function wholeWrite(path: any, bytes: any, mode: messages.Mode): (boolean, string?)
    if type(bytes) ~= "string" and (type(bytes) ~= "table" or bytes.getString == nil) then
        error("nupp: io.files contents must be bytes or a byte view", 3)
    end
    local text = type(bytes) == "string" and bytes or bytes:getString()
    pending = pending + 1
    local opened, reason = files.open(path, mode)
    if opened == nil then
        pending = pending - 1
        return false, reason
    end
    local file = opened as File
    local wrote, failure = file:write(text)
    file:close()
    pending = pending - 1

    return wrote, failure
end

function files.write(path: any, bytes: any): (boolean, string?)
    return wholeWrite(path, bytes, "w")
end

function files.append(path: any, bytes: any): (boolean, string?)
    return wholeWrite(path, bytes, "a")
end

function files.writeAtomic(path: any, bytes: any): (boolean, string?)
    descriptor(path, 2)
    return false, unavailable("atomic replacement")
end

function files.copy(from: any, to: any): (boolean, string?)
    local bytes, reason = wholeRead(from)
    if bytes == nil then
        return false, reason
    end

    return wholeWrite(to, bytes, "w")
end

function files.pendingTransfers(): integer
    return pending
end

function files.lines(path: any): (messages.LineIterator?, string?)
    local bytes, reason = wholeRead(path)
    if bytes == nil then
        return nil, reason
    end
    local at: integer = 1

    return function(): string?
        if at > #bytes then
            return nil
        end
        local stop = bytes:find("\n", at, true)
        local line: string
        if stop == nil then
            line, at = bytes:sub(at), #bytes + 1
        else
            line, at = bytes:sub(at, stop - 1), stop + 1
        end
        if line:sub(-1) == "\r" then
            line = line:sub(1, -2)
        end

        return line
    end, nil
end

function files.createTemporaryFile(options: messages.TemporaryOptions?): (nil, string?)
    return nil, unavailable("temporary paths")
end

function files.createTemporaryDirectory(options: messages.TemporaryOptions?): (nil, string?)
    return nil, unavailable("temporary paths")
end

function files.currentDirectory(): (string?, string?)
    return nil, unavailable("a current directory")
end

function files.userFolder(which: messages.UserFolder): (string?, string?)
    return nil, unavailable("user folders")
end

function files.executableDirectory(): (string?, string?)
    return nil, unavailable("an executable directory")
end

function files.requestPersistentStorage(): (boolean, string?)
    local value, reason = effect("persist", nil)
    if value == nil then
        return false, reason
    end
    if type(value) ~= "table" or type(value.granted) ~= "boolean" then
        return false, "browser file host returned an invalid persistence result"
    end

    return value.granted == true, value.granted == true and nil or "persistent storage was not granted"
end

export = files
