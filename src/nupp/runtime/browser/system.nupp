@!internal
module nupp.runtime.browser.system

--[[Browser host.system API 1 implementation for the Wasm32 Nupp ABI.

The fixed facts describe browser execution with 32-bit little-endian pointers.
The parallelism query suspends through the browser response protocol and returns
the host's estimate, which is an integer of at least one. No worker pool is opened.
The public system facade retains this query and these values at module load.
]]

const response = require("nupp.runtime.browser.response")

export const platform: string = "browser"
export const architecture: string = "wasm32"
export const endianness: string = "little"
export const pointerBits: integer = 32

export function availableParallelism(): integer
    local answer = response.await("system", {})
    return answer.availableParallelism as integer
end
