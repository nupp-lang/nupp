@!internal
module nupp.runtime.storage

local representation = require("binary._representation")
local provider = assert(representation.storage, "nupp.runtime.storage: no implementation is available for the target")

export const allocateBytes = provider.allocbytes
export const borrowString = provider.borrowstring
export const copy = provider.copy
export const fill = provider.fill
export const sizeOf = provider.sizeof
export const string = provider.string
export const decodeUint8 = provider.decodeuint8
export const encodeUint8 = provider.encodeuint8
export const decodeInt8 = provider.decodeint8
export const encodeInt8 = provider.encodeint8
export const decodeUint16 = provider.decodeuint16
export const encodeUint16 = provider.encodeuint16
export const decodeInt16 = provider.decodeint16
export const encodeInt16 = provider.encodeint16
export const decodeUint32 = provider.decodeuint32
export const encodeUint32 = provider.encodeuint32
export const decodeInt32 = provider.decodeint32
export const encodeInt32 = provider.encodeint32
export const decodeUint64 = provider.decodeuint64
export const encodeUint64 = provider.encodeuint64
export const decodeInt64 = provider.decodeint64
export const encodeInt64 = provider.encodeint64
export const decodeFloat32 = provider.decodefloat32
export const encodeFloat32 = provider.encodefloat32
export const decodeFloat64 = provider.decodefloat64
export const encodeFloat64 = provider.encodefloat64
export const castBytes = provider.castbytes
export const castElements = provider.castelements
export const scalar = provider.scalar
export const descriptor = provider.descriptor
export const allocateArray = provider.allocarray
export const boundedCount = provider.boundedcount
export const layout = provider.layout
export const reference = provider.reference
