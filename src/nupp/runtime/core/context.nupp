module nupp.runtime.core.context

export const REMAINING: int64 = 0
export const CANCELLED: int64 = 8
export const STATUS: int64 = 16
export const CODE_START: int64 = 24
export const ERROR_PC: int64 = 32
export const UNLIMITED: uint64 = 0xffffffffffffffffULL
export const BUDGET_STATUS: uint64 = 2ULL
export const CANCELLED_STATUS: uint64 = 3ULL
-- A guest error no protected call took, such as integer modulo by zero; the
-- program has reported it on standard error (guestreport). ERROR_OWNER and
-- ERROR_PC identify the raise.
export const GUEST_ERROR_STATUS: uint64 = 6ULL

-- The entry owns this mapped extent; dispatch remains immutable while active.
export const SIZE: int64 = 128
export const DISPATCH_TABLE: int64 = 40

-- These fields belong to the closed catalog entry. Diagnostic entries leave
-- them unused; they do not infer final-frame authority from their raw contents.
export const STATE: int64 = 48
export const CATALOG: int64 = 56
export const REGISTRY: int64 = 64
export const ROOT_CONTROL: int64 = 72
export const ORIGINAL_ROOT: int64 = 80
export const ROOT_SERIAL: int64 = 88
export const WORLD: int64 = 96
export const ERROR_OWNER: int64 = 104
export const MODULE_ORDINAL: int64 = 112
-- The entry's guestscope.Services, shared by every module: its first field is
-- the service scope handlers make scoped calls with, and it holds the heap.
export const SERVICE_SCOPE: int64 = 120
