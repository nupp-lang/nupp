module nupp.runtime.core.rawbudget

const native = require("nupp.runtime.vm.intrinsics")
const header = require("nupp.runtime.core.rawheader")
const wire = require("nupp.runtime.core.rawwire")
const roles = require("nupp.runtime.core.rawroles")
const policy = require("nupp.runtime.core.rawbudgetpolicy")

-- Internal phase-4 helper. Only its caller's freshly admitted private catalog
-- descriptor may be passed here. A caller-supplied descriptor is not authority.
local function count(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("count")
    )
end

local function row(descriptor: voidptr, section: uint64, index: uint64, offset: uint64): uint64
    local address = native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("data")
    )

    return native.word(native.load32(native.pointer(address), native.index(index * wire.stride(section) + offset)))
        & roles.absent
end

local function charge(counters: voidptr, items: uint64, bytes: uint64): uint64
    local oldItems, oldBytes = native.load64(counters, 0), native.load64(counters, 8)
    if items > policy.itemLimit - oldItems or bytes > policy.textLimit - oldBytes then
        return 0ULL
    end
    native.store64(counters, 0, oldItems + items)
    native.store64(counters, 8, oldBytes + bytes)

    return 1ULL
end

local function termFields(descriptor: voidptr, counters: voidptr, index: uint64): uint64
    local kind = row(descriptor, wire.S_terms, index, roles.F_terms_kind)
    if charge(counters, policy.termItems(kind), policy.termBytes(kind)) == 0ULL then
        return 0ULL
    end
    local mask = policy.termOptionalFields(kind)
    if (mask & policy.F_pos) ~= 0ULL and row(descriptor, wire.S_terms, index, roles.F_terms_pos) ~= roles.absent then
        if charge(counters, policy.B_termField_pos_items, policy.B_termField_pos_bytes) == 0ULL then
            return 0ULL
        end
    end
    if (mask & policy.F_value) ~= 0ULL
        and row(descriptor, wire.S_terms, index, roles.F_terms_value) ~= roles.absent
    then
        if charge(counters, policy.B_termField_value_items, policy.B_termField_value_bytes) == 0ULL then
            return 0ULL
        end
    end
    if (mask & policy.F_callee) ~= 0ULL
        and row(descriptor, wire.S_terms, index, roles.F_terms_callee) ~= roles.absent
    then
        if charge(counters, policy.B_termField_callee_items, policy.B_termField_callee_bytes) == 0ULL then
            return 0ULL
        end
    end
    if (mask & policy.F_result) ~= 0ULL
        and row(descriptor, wire.S_terms, index, roles.F_terms_result) ~= roles.absent
    then
        if charge(counters, policy.B_termField_result_items, policy.B_termField_result_bytes) == 0ULL then
            return 0ULL
        end
    end
    if (mask & policy.F_contract) ~= 0ULL
        and row(descriptor, wire.S_terms, index, roles.F_terms_contract) ~= roles.absent
    then
        if charge(counters, policy.B_termField_contract_items, policy.B_termField_contract_bytes) == 0ULL then
            return 0ULL
        end
    end

    return 1ULL
end

export function admitted(descriptor: voidptr, counters: voidptr): uint64
    native.store64(counters, 0, 0ULL)
    native.store64(counters, 8, 0ULL)
    if policy.maxDepthBound > policy.depthLimit
        or charge(counters, policy.B_root_items, policy.B_root_bytes) == 0ULL
    then
        return 0ULL
    end
    local section = 0ULL
    while section < wire.sectionCount do
        local amount = count(descriptor, section)
        -- Shape caps amount at 2^20; generated costs fit 16 bits. Products
        -- remain below 2^36 before subtraction-based cumulative checks.
        if section ~= wire.S_bytes
            and charge(counters, policy.sectionItems(section) * amount, policy.sectionBytes(section) * amount) == 0ULL
        then
            return 0ULL
        end
        local index = 0ULL
        while section ~= wire.S_bytes and index < amount do
            local field = 0ULL
            while field < roles.fieldCount(section) do
                local metadata = roles.field(section, field)
                local offset, kind = metadata & 255ULL, (metadata >> 8ULL) & 15ULL
                if kind == roles.R_string then
                    local id = row(descriptor, section, index, offset)
                    local bytes = row(descriptor, wire.S_strings, id, roles.F_strings_bytes)
                    if charge(counters, 0ULL, bytes) == 0ULL then
                        return 0ULL
                    end
                end
                local bytes = policy.enumBytes(section, offset, row(descriptor, section, index, offset))
                if charge(counters, 0ULL, bytes) == 0ULL then
                    return 0ULL
                end
                field = field + 1ULL
            end
            if section == wire.S_catalog
                and row(descriptor, section, index, roles.F_catalog_parent) ~= roles.absent
            then
                if charge(counters, policy.B_parent_items, policy.B_parent_bytes) == 0ULL then
                    return 0ULL
                end
            end
            if section == wire.S_terms and termFields(descriptor, counters, index) == 0ULL then
                return 0ULL
            end
            if section == wire.S_signatures then
                local first = row(descriptor, section, index, roles.F_signatures_paramsFirst)
                local length = row(descriptor, section, index, roles.F_signatures_paramsCount)
                local at = 0ULL
                while at < length do
                    local scalar = row(descriptor, wire.S_words, first + at, roles.F_words_value)
                    if charge(counters, 0ULL, policy.scalarKindsBytes(scalar)) == 0ULL then
                        return 0ULL
                    end
                    at = at + 1ULL
                end
            end
            index = index + 1ULL
        end
        section = section + 1ULL
    end

    return 1ULL
end
