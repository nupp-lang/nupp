module nupp.runtime.core.rawheader

const native = require("nupp.runtime.vm.intrinsics")
const wire = require("nupp.runtime.core.rawwire")

-- The caller lends actual mapped spans and retains immutable input until the
-- descriptor retires. Arithmetic checks cannot prove mappings. Calls serialize.
-- Actual helper/control storage must already be disjoint from borrowed data
-- and output before entering selected code: its prologue may save/spill there.
-- These checks also reject inconsistent claimed spans; they do not authenticate
-- arbitrary pointers. This service admits only the header and directory.
export struct Descriptor
    phase: uint64
    data: uint64
    dataBytes: uint64
    entry: uint64
    sectionCount: uint64
    reserved: uint64
end

export struct Section
    data: uint64
    count: uint64
    bytes: uint64
end

local function range(base: uint64, bytes: uint64): uint64
    if base == 0ULL or bytes == 0ULL or (base & 7ULL) ~= 0ULL or bytes > 0xffffffffffffffffULL - base then
        return 0ULL
    end

    return 1ULL
end

local function overlaps(a: uint64, an: uint64, b: uint64, bn: uint64): boolean
    return a < b + bn and b < a + an
end

local function u32(data: voidptr, at: uint64): uint64
    return native.word(native.load32(data, native.index(at))) & 0xffffffffULL
end

export function admit(
    data: voidptr,
    dataBytes: uint64,
    out: voidptr,
    outBytes: uint64,
    pool: voidptr,
    poolBytes: uint64,
    helper: voidptr,
    helperBytes: uint64
): uint64
    local d, o, p, h = native.address(data), native.address(out), native.address(pool), native.address(helper)
    local descriptorBytes = native.sizeOf<Descriptor>() + wire.sectionCount * native.sizeOf<Section>()
    if range(d, dataBytes) == 0ULL
        or range(o, outBytes) == 0ULL
        or range(p, poolBytes) == 0ULL
        or range(h, helperBytes) == 0ULL
    then
        return 0ULL
    end
    if dataBytes < wire.minimumBytes
        or dataBytes > wire.fileLimit
        or outBytes < descriptorBytes
        or poolBytes < 8ULL
        or helperBytes < 16ULL
    then
        return 0ULL
    end
    if overlaps(d, dataBytes, o, outBytes)
        or overlaps(d, dataBytes, p, poolBytes)
        or overlaps(d, dataBytes, h, helperBytes)
        or overlaps(o, outBytes, p, poolBytes)
        or overlaps(o, outBytes, h, helperBytes)
        or overlaps(p, poolBytes, h, helperBytes)
    then
        return 0ULL
    end
    local at = 0ULL
    while at < descriptorBytes do
        if native.load64(out, native.index(at)) ~= 0ULL then
            return 0ULL
        end
        at = at + 8ULL
    end
    if wire.magic(data) == 0ULL
        or u32(data, wire.H_version) ~= wire.version
        or u32(data, wire.H_profile) ~= wire.profile
        or u32(data, wire.H_sections) ~= wire.sectionCount
        or u32(data, wire.H_flags) ~= 0ULL
        or u32(data, wire.H_reserved) ~= 0ULL
        or u32(data, wire.H_bytes + 4ULL) ~= 0ULL
        or u32(data, wire.H_directory + 4ULL) ~= 0ULL
        or u32(data, wire.H_bytes) ~= dataBytes
        or u32(data, wire.H_directory) ~= wire.headerBytes
    then
        return 0ULL
    end
    local section, previous, records, expansion = 0ULL, wire.minimumBytes, 0ULL, 0ULL
    while section < wire.sectionCount do
        local row = wire.headerBytes + section * wire.directoryBytes
        local stride = wire.stride(section)
        if u32(data, row + wire.D_kind) ~= section
            or u32(data, row + wire.D_stride) ~= stride
            or u32(data, row + wire.D_count + 4ULL) ~= 0ULL
            or u32(data, row + wire.D_offset + 4ULL) ~= 0ULL
            or u32(data, row + wire.D_bytes + 4ULL) ~= 0ULL
        then
            return 0ULL
        end
        local count, offset, bytes = u32(
            data,
            row + wire.D_count
        ), u32(data, row + wire.D_offset), u32(data, row + wire.D_bytes)
        if offset ~= ((previous + 7ULL) & 0xfffffffffffffff8ULL) or offset > dataBytes then
            return 0ULL
        end
        while previous < offset do
            if native.load8(data, native.index(previous)) ~= 0 then
                return 0ULL
            end
            previous = previous + 1ULL
        end
        -- The wire's aggregate limits, which hold a raw image to about
        -- 12,000 owners: the raw profile's executable subset is one scalar
        -- initializer, and compiler-sized programs load as checked v8
        -- catalogs instead (see coregraphschema.wire).
        if section == wire.S_bytes then
            if count > wire.stringLimit then
                return 0ULL
            end
        else
            if count > wire.recordsLimit - records then
                return 0ULL
            end
            records = records + count
            local charge = count * wire.expansion(section)
            if charge > wire.expandedLimit - expansion then
                return 0ULL
            end
            expansion = expansion + charge
        end
        if bytes ~= count * stride or bytes > dataBytes - offset then
            return 0ULL
        end
        if section == wire.S_schema then
            if count ~= 1ULL or wire.policy(data, native.index(offset)) == 0ULL then
                return 0ULL
            end
        elseif section == wire.S_catalog then
            if u32(data, wire.H_entry) >= count then
                return 0ULL
            end
        end
        previous = offset + bytes
        section = section + 1ULL
    end
    if previous ~= dataBytes then
        return 0ULL
    end
    -- No refusing operation follows. All directory loads stay within the
    -- immutable checked input; all stores stay within fresh borrowed output.
    native.store64(out, native.fieldOffset<Descriptor>("data"), d)
    native.store64(out, native.fieldOffset<Descriptor>("dataBytes"), dataBytes)
    native.store64(out, native.fieldOffset<Descriptor>("entry"), u32(data, wire.H_entry))
    native.store64(out, native.fieldOffset<Descriptor>("sectionCount"), wire.sectionCount)
    section = 0ULL
    while section < wire.sectionCount do
        local row = wire.headerBytes + section * wire.directoryBytes
        local target = native.offset(
            out,
            native.index(native.sizeOf<Descriptor>() + section * native.sizeOf<Section>())
        )
        native.store64(target, native.fieldOffset<Section>("data"), d + u32(data, row + wire.D_offset))
        native.store64(target, native.fieldOffset<Section>("count"), u32(data, row + wire.D_count))
        native.store64(target, native.fieldOffset<Section>("bytes"), u32(data, row + wire.D_bytes))
        section = section + 1ULL
    end
    native.store64(out, native.fieldOffset<Descriptor>("phase"), 1ULL)

    return 1ULL
end
