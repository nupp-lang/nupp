module nupp.runtime.core.gueststorage

-- The storage calls on the core (storagecalls): allocate and allocbytes,
-- views, casts, copies, fills and texts of storage, and a storage value's
-- elements read, written and stepped through.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const tables = require("nupp.runtime.core.coretables")
const ints = require("nupp.runtime.core.coreintegers")
const corestorage = require("nupp.runtime.core.corestorage")
const strings = require("nupp.runtime.core.corestrings")
const guestscope = require("nupp.runtime.core.guestscope")
const texts = require("nupp.runtime.core.guesttexts")
const librarycalls = require("nupp.runtime.core.librarycalls")
const librarytexts = require("nupp.runtime.core.librarytexts")
const guestvalues = require("nupp.runtime.core.guestvalues")

-- No index: an error was raised instead.
const NOINDEX: uint64 = 0xffffffffffffffffULL
const MAX_SCALAR_ALIGNMENT: uint64 = 8ULL

-- The element a key names in storage `object`, zero-based, or NOINDEX once
-- "index out of range" is raised for a key that names none.
local function storageindex(ctx: voidptr, object: uint64, key: uint64): uint64
    local index = NOINDEX
    if ints.isInteger(key) then
        index = ints.bitsOf(key)
    elseif key & values.QNAN ~= values.QNAN then
        -- A float that is a whole number names that index.
        local x = native.fromBits(key)
        local whole = native.toInt(x)
        if native.toFloat(whole) == x and whole >= 0 then
            index = native.word(whole)
        end
    end
    if index == NOINDEX or index >= corestorage.elementcount(object) then
        guestscope.raise(ctx, texts.textvalue(ctx, librarytexts.TEXT_INDEX_RANGE), 1ULL)
        return NOINDEX
    end

    return index
end

-- storage[key] for GetIdx: the element, or values.TRUE once an error is
-- raised.
export function storageget(ctx: voidptr, subject: uint64, key: uint64): uint64
    local object = subject & values.PAYLOAD
    local index = storageindex(ctx, object, key)
    if index == NOINDEX then
        return values.TRUE
    end
    local kind = corestorage.elementkind(object)
    if corestorage.isblock(kind) then
        -- A block (a struct) is a view of its bytes, a reference into the
        -- storage's, as an element of a C array of structs is.
        @unsafe do
            local h = guestvalues.guestheap(ctx)
            local made = corestorage.newview(h, object, kind, index * corestorage.elementwidth(kind), 1ULL)
            if made == 0ULL then
                error("not enough memory")
            end
            tables.drain(h)
            return values.TAG_OBJ | made
        end
    end
    if not corestorage.readable(
        object,
        index * corestorage.elementwidth(corestorage.elementkind(object)),
        corestorage.elementwidth(corestorage.elementkind(object))
    ) then
        error("nupp: stale, closed or uninitialized Buffer read")
    end
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local value = corestorage.readelement(h, object, index)
        tables.drain(h)
        return value
    end
end

-- A C pointer is stored as its address. The checked borrow keeps its backing
-- storage alive while the pointer is in use.
local function pointerbits(ctx: voidptr, value: uint64): uint64
    if corestorage.isstorage(value) then
        local source = value & values.PAYLOAD
        if not corestorage.readable(source, 0ULL, 0ULL) then
            error("nupp: stale or closed storage for a C pointer field")
        end

        return corestorage.storagebase(source)
    elseif value == values.NIL then
        return 0ULL
    end

    return native.word(guestvalues.intarg(ctx, value, 0, 2ULL))
end

-- Whether `value` is a number: an integer or a float.
local function isnumber(value: uint64): boolean
    return ints.isInteger(value) or value & values.QNAN ~= values.QNAN or value == values.QNAN
end

-- The bits a `kind` element stores for number `value`. A float stored as an
-- integer kind is truncated toward zero, as C converts one.
local function numberbits(kind: uint64, value: uint64): uint64
    local floating = kind == corestorage.FLOAT32 or kind == corestorage.FLOAT64
    if ints.isInteger(value) then
        if floating then
            return ints.toFloatBits(ints.bitsOf(value))
        end
        return ints.bitsOf(value)
    elseif not floating then
        return native.word(native.toInt(native.fromBits(value)))
    end

    return value
end

-- A block (a struct) stored as element `index`: the bytes of `value`, a
-- block at least as wide, copied over the element's.
local function storeblock(ctx: voidptr, object: uint64, kind: uint64, index: uint64, value: uint64): uint64
    local width = corestorage.elementwidth(kind)
    if not corestorage.isstorage(value) then
        guestscope.raise(ctx, texts.textvalue(ctx, librarytexts.TEXT_STORAGE), 1ULL)
        return 1ULL
    end
    local source = value & values.PAYLOAD
    if corestorage.bytelength(source) < width or not corestorage.readable(source, 0ULL, width) then
        error("nupp: a struct element is written from a narrower or unreadable value")
    end
    corestorage.copybytes(corestorage.storagebase(object) + index * width, corestorage.storagebase(source), width)

    return 0ULL
end

-- storage[key] = value for SetIdx: 0, or 1 once an error is raised.
export function storageset(ctx: voidptr, subject: uint64, key: uint64, value: uint64): uint64
    local object = subject & values.PAYLOAD
    if not corestorage.iswritable(object) then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_WRITABLE_STORAGE, 0ULL, subject)
    end
    local index = storageindex(ctx, object, key)
    if index == NOINDEX then
        return 1ULL
    end
    local kind = corestorage.elementkind(object)
    if kind == corestorage.POINTER then
        return corestorage.writeelement(object, index, pointerbits(ctx, value))
    elseif corestorage.isblock(kind) then
        return storeblock(ctx, object, kind, index, value)
    end
    if not isnumber(value) then
        guestscope.raise(ctx, texts.textvalue(ctx, librarytexts.TEXT_NUMBER_EXPECTED), 1ULL)
        return 1ULL
    end
    corestorage.writeelement(object, index, numberbits(kind, value))

    return 0ULL
end

-- This predicate exposes no raw address. Invalid ownership, unreadable extents,
-- non-scalar alignments and overflowing address arithmetic all answer false.
export function aligned(ctx: voidptr, subject: uint64, offset: uint64, alignment: uint64): uint64
    local object = strings.header(subject)
    if object == 0ULL then
        if not corestorage.isstorage(subject) then
            return values.FALSE
        end
        object = subject & values.PAYLOAD
    end
    if not ints.isInteger(offset) or not ints.isInteger(alignment) then
        return values.FALSE
    end
    local by = ints.bitsOf(offset)
    local boundary = ints.bitsOf(alignment)
    if boundary == 0ULL
        or boundary > MAX_SCALAR_ALIGNMENT
        or boundary & (boundary - 1ULL) ~= 0ULL
        or by > corestorage.bytelength(object)
        or not corestorage.readable(object, by, 0ULL)
    then
        return values.FALSE
    end
    local base = corestorage.storagebase(object)
    if base > NOINDEX - by then
        return values.FALSE
    end
    if (base + by) % boundary == 0ULL then
        return values.TRUE
    end

    return values.FALSE
end

-- New zeroed storage of `n` elements of `kind`, an integer value.
export function allocate(ctx: voidptr, kind: uint64, n: uint64): uint64
    local code = corestorage.elementwidth(ints.bitsOf(kind))
    if not ints.isInteger(kind) or code == 0ULL or ints.bitsOf(kind) == corestorage.POINTER then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_NUMBER, 0ULL, kind)
    end
    if not ints.isInteger(n) or native.index(ints.bitsOf(n)) < 0 then
        texts.argumentError(ctx, 2ULL, librarytexts.TEXT_NUMBER, 0ULL, n)
    end
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local made = corestorage.newstorage(h, ints.bitsOf(kind), ints.bitsOf(n))
        if made == 0ULL then
            error("not enough memory")
        end
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end

-- Argument `position`, storage: its header address.
local function storageargument(ctx: voidptr, value: uint64, position: uint64): uint64
    if not corestorage.isstorage(value) then
        texts.argumentError(ctx, position, librarytexts.TEXT_STORAGE, 0ULL, value)
    end

    return value & values.PAYLOAD
end

-- Stores a C pointer as its address. A checked borrow keeps the backing
-- storage alive for the foreign code that reads the field.
export function storePointer(ctx: voidptr, destination: uint64, value: uint64): uint64
    local cell = storageargument(ctx, destination, 1ULL)
    local address = pointerbits(ctx, value)
    if corestorage.elementkind(cell) ~= corestorage.UINT64 or corestorage.writeelement(cell, 0ULL, address) ~= 0ULL then
        error("nupp: a C pointer field needs a writable address slot")
    end

    return values.NIL
end

-- Argument `position`, a count of no more than `limit`.
local function countargument(ctx: voidptr, value: uint64, position: uint64, limit: uint64): uint64
    if not ints.isInteger(value) or native.index(ints.bitsOf(value)) < 0 or ints.bitsOf(value) > limit then
        texts.argumentError(ctx, position, 0ULL, librarytexts.TEXT_INDEX_RANGE, value)
    end

    return ints.bitsOf(value)
end

-- The byte offset a struct field access names in storage `object`, for an
-- element of `kind`: the offset, once it and the kind are checked against
-- the storage's bytes.
local function fieldoffset(ctx: voidptr, object: uint64, kind: uint64, offset: uint64): uint64
    local width = corestorage.elementwidth(ints.bitsOf(kind))
    if not ints.isInteger(kind) or width == 0ULL or corestorage.isblock(ints.bitsOf(kind)) then
        texts.argumentError(ctx, 2ULL, librarytexts.TEXT_NUMBER, 0ULL, kind)
    end
    local at = countargument(ctx, offset, 3ULL, corestorage.bytelength(object))
    if not corestorage.readable(object, at, width) then
        error("nupp: stale, closed or out of range struct field")
    end

    return at
end

-- A struct field's value read in place (STORAGE_LOAD): the element of
-- `kind` at byte `offset` of `subject`, with no view of it made. A pointer
-- field loads as its address.
export function loadat(ctx: voidptr, subject: uint64, kind: uint64, offset: uint64): uint64
    local object = storageargument(ctx, subject, 1ULL)
    local at = fieldoffset(ctx, object, kind, offset)
    local code = ints.bitsOf(kind)
    if code == corestorage.POINTER then
        code = corestorage.UINT64
    end
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local value = corestorage.loadelement(h, code, corestorage.storagebase(object) + at, 0ULL)
        tables.drain(h)
        return value
    end
end

-- A struct field written in place (STORAGE_STORE): `value` as the element
-- of `kind` at byte `offset` of `subject`, a pointer kind storing the
-- address of what it names.
export function storeat(ctx: voidptr, subject: uint64, kind: uint64, offset: uint64, value: uint64): uint64
    local object = storageargument(ctx, subject, 1ULL)
    if not corestorage.iswritable(object) then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_WRITABLE_STORAGE, 0ULL, subject)
    end
    local at = fieldoffset(ctx, object, kind, offset)
    local code = ints.bitsOf(kind)
    local base = corestorage.storagebase(object) + at
    if code == corestorage.POINTER then
        corestorage.storeelement(corestorage.UINT64, base, 0ULL, pointerbits(ctx, value))
        return values.NIL
    end
    if not isnumber(value) then
        texts.argumentError(ctx, 4ULL, librarytexts.TEXT_NUMBER, 0ULL, value)
    end
    corestorage.storeelement(code, base, 0ULL, numberbits(code, value))

    return values.NIL
end

-- The storage views (`STORAGE_VIEW` through `STORAGE_CAST`),
-- given `n` arguments.
export function storagecall(ctx: voidptr, id: uint64, n: uint64, a: uint64, b: uint64, c: uint64, d: uint64): uint64
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        if id == librarycalls.STORAGE_FROMSTRING then
            local s = strings.header(a)
            if s == 0ULL then
                texts.argumentError(ctx, 1ULL, librarytexts.TEXT_STRING, 0ULL, a)
            end
            local length = strings.length(s)
            local made = corestorage.newstorage(h, corestorage.UINT8, length)
            if made == 0ULL then
                error("not enough memory")
            end
            corestorage.copybytes(corestorage.storagebase(made), (native.pointer(s) as heap.Header*).auxPtr, length)
            tables.drain(h)
            return values.TAG_OBJ | made
        end
        local object: uint64 = 0ULL
        if id == librarycalls.STORAGE_VIEW or id == librarycalls.STORAGE_CAST then
            object = strings.header(a)
        end
        if object == 0ULL then
            object = storageargument(ctx, a, 1ULL)
        end
        local size = corestorage.bytelength(object)
        if id == librarycalls.STORAGE_ELEMENTS then
            return values.TAG_INTEGER | corestorage.elementcount(object)
        elseif id == librarycalls.STORAGE_ELEMENTKIND then
            return values.TAG_INTEGER | corestorage.elementkind(object)
        elseif id == librarycalls.STORAGE_VIEW or id == librarycalls.STORAGE_CAST then
            local kind: uint64 = 0ULL
            if ints.isInteger(b) then
                kind = ints.bitsOf(b)
            end
            local width = corestorage.elementwidth(kind)
            if width == 0ULL or kind == corestorage.POINTER and id ~= librarycalls.STORAGE_VIEW then
                texts.argumentError(ctx, 2ULL, librarytexts.TEXT_NUMBER, 0ULL, b)
            end
            local offset: uint64 = 0ULL
            if id == librarycalls.STORAGE_VIEW then
                offset = countargument(ctx, c, 3ULL, size)
            end
            local count = (size - offset) // width
            if id == librarycalls.STORAGE_VIEW and n >= 4ULL and d ~= values.NIL then
                count = countargument(ctx, d, 4ULL, count)
            end
            local made = corestorage.newview(h, object, kind, offset, count)
            if made == 0ULL then
                error("not enough memory")
            end
            tables.drain(h)
            return values.TAG_OBJ | made
        elseif id == librarycalls.STORAGE_COPY then
            if not corestorage.iswritable(object) then
                texts.argumentError(ctx, 1ULL, librarytexts.TEXT_WRITABLE_STORAGE, 0ULL, a)
            end
            -- The source is storage or a string.
            local s = strings.header(b)
            local from: uint64 = 0ULL
            local available: uint64 = 0ULL
            local source: uint64 = 0ULL
            if s ~= 0ULL then
                from = (native.pointer(s) as heap.Header*).auxPtr
                available = strings.length(s)
            else
                source = storageargument(ctx, b, 2ULL)
                available = corestorage.bytelength(source)
            end
            local limit = size
            if available < limit then
                limit = available
            end
            local count = countargument(ctx, c, 3ULL, limit)
            if source ~= 0ULL then
                if not corestorage.copyreadable(source, object, count) then
                    error("nupp: stale, closed or uninitialized Buffer copy source")
                end
                from = corestorage.storagebase(source)
            end
            corestorage.copybytes(corestorage.storagebase(object), from, count)
            return values.NIL
        elseif id == librarycalls.STORAGE_FILL then
            if not corestorage.iswritable(object) then
                texts.argumentError(ctx, 1ULL, librarytexts.TEXT_WRITABLE_STORAGE, 0ULL, a)
            end
            local count = countargument(ctx, b, 2ULL, size)
            local byte: uint64 = 0ULL
            if ints.isInteger(c) then
                byte = ints.bitsOf(c)
            end
            corestorage.fillbytes(corestorage.storagebase(object), count, byte)
            return values.NIL
        end
        -- STORAGE_TEXT: the first `count` bytes as a string.
        local count = countargument(ctx, b, 2ULL, size)
        if not corestorage.readable(object, 0ULL, count) then
            error("nupp: stale, closed or uninitialized Buffer text")
        end
        local made = strings.make(h, corestorage.storagebase(object), count)
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end

-- storage + n: a view from `n` elements in, through its end; values.TRUE
-- once "index out of range" is raised for an `n` outside it.
export function storageoffset(ctx: voidptr, subject: uint64, step: uint64): uint64
    local object = subject & values.PAYLOAD
    local count = corestorage.elementcount(object)
    if not ints.isInteger(step) or native.index(ints.bitsOf(step)) < 0 or ints.bitsOf(step) > count then
        guestscope.raise(ctx, texts.textvalue(ctx, librarytexts.TEXT_INDEX_RANGE), 1ULL)
        return values.TRUE
    end
    local n = ints.bitsOf(step)
    local kind = corestorage.elementkind(object)
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local made = corestorage.newview(h, object, kind, n * corestorage.elementwidth(kind), count - n)
        if made == 0ULL then
            error("not enough memory")
        end
        tables.drain(h)
        return values.TAG_OBJ | made
    end
end
