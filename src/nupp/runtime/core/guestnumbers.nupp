module nupp.runtime.core.guestnumbers

-- Numbers in the core library: tonumber, with a base too, a numeric for's
-- limit, the math library and the arithmetic operators that may meet a
-- metamethod, Lua's bitwise operators on 64-bit integers, and the
-- fixed-width math the prelude adds to Lua's: binary32 rounding
-- (`math.f32`) and 32-bit integer wrapping (`math.u32`, `math.i32`).
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const context = require("nupp.runtime.core.context")
const ints = require("nupp.runtime.core.coreintegers")
const strings = require("nupp.runtime.core.corestrings")
const guestscope = require("nupp.runtime.core.guestscope")
const texts = require("nupp.runtime.core.guesttexts")
const librarytexts = require("nupp.runtime.core.librarytexts")
const tables = require("nupp.runtime.core.coretables")
const clock = require("nupp.runtime.core.hostclock")
const numbers = require("nupp.runtime.core.hostnumbers")
const guestvalues = require("nupp.runtime.core.guestvalues")
const librarycalls = require("nupp.runtime.core.librarycalls")
const scalarkinds = require("nupp.runtime.core.scalarkinds")
const corestorage = require("nupp.runtime.core.corestorage")

-- Lua's unary minus of a number: integers wrap, floats change sign.
export function negate(ctx: voidptr, a: uint64): uint64
    if ints.isInteger(a) then
        return guestscope.integer(ctx, 0ULL - ints.bitsOf(a))
    end
    local x = guestvalues.floatof(a)
    if x == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, a)
    end

    -- Times -1.0 (its bits, since a leaf has no unary minus), as Lua negates.

    return guestvalues.floatvalue(native.bits(native.fromBits(x) * native.fromBits(0xbff0000000000000ULL)))
end

-- An integral float as the integer it equals when one does, else nil.
export function integral(ctx: voidptr, value: uint64): uint64
    if ints.isInteger(value) then
        return value
    end
    if guestvalues.isfloat(value) and ints.integralFloat(value) then
        return guestscope.integer(ctx, ints.floatToBits(value))
    end

    return values.NIL
end

-- math.abs: integers wrap at the minimum, as Lua's do.
export function mathAbs(ctx: voidptr, a: uint64): uint64
    guestvalues.numarg(ctx, a, 1ULL)
    if ints.isInteger(a) then
        local bits = ints.bitsOf(a)
        if bits >> 63ULL == 1ULL then
            return guestscope.integer(ctx, 0ULL - bits)
        end
        return a
    end

    return guestvalues.floatvalue(a & 0x7fffffffffffffffULL)
end

-- math.ceil: an integer when the result fits one, else the float.
export function mathCeil(ctx: voidptr, a: uint64): uint64
    guestvalues.numarg(ctx, a, 1ULL)
    if ints.isInteger(a) then
        return a
    end
    local minusOne = native.fromBits(0xbff0000000000000ULL)
    local ceiled = guestvalues.floatvalue(native.bits(native.floor(native.fromBits(a) * minusOne) * minusOne))
    local exact = integral(ctx, ceiled)
    if exact ~= values.NIL then
        return exact
    end

    return ceiled
end

-- a < b for two numbers: exact between integers, through floats otherwise.
local function numberLess(a: uint64, b: uint64): boolean
    if ints.isInteger(a) and ints.isInteger(b) then
        return native.index(ints.bitsOf(a)) < native.index(ints.bitsOf(b))
    end

    return native.fromBits(guestvalues.floatof(a)) < native.fromBits(guestvalues.floatof(b))
end

-- math.max and math.min over one to four numbers: the first extreme one, as
-- given (an integer stays one).
export function mathExtreme(
    ctx: voidptr,
    count: uint64,
    a: uint64,
    b: uint64,
    c: uint64,
    d: uint64,
    largest: boolean
): uint64
    if count == 0ULL then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_NUMBER, 0ULL, values.NIL)
    end
    local best = guestvalues.numarg(ctx, a, 1ULL)
    local i: uint64 = 2ULL
    while i <= count do
        local next = b
        if i == 3ULL then
            next = c
        elseif i == 4ULL then
            next = d
        end
        guestvalues.numarg(ctx, next, i)
        if largest and numberLess(best, next) or not largest and numberLess(next, best) then
            best = next
        end
        i = i + 1ULL
    end

    return best
end

-- math.type: "integer", "float", or nil for anything else.
export function mathType(ctx: voidptr, a: uint64): uint64
    local state = strings.Builder(0ULL, 0ULL)
    @unsafe do
        if not ints.isInteger(a) and not guestvalues.isfloat(a) then
            return values.NIL
        end
        local h = guestvalues.guestheap(ctx)
        local builderLifetime = strings.open(h, state as strings.Builder*)
        local builder = state as strings.Builder*
        local refused: uint64 = 0ULL
        if ints.isInteger(a) then
            refused = strings.appendWord(h, builder, 0x72656765746e69ULL, 7ULL)
        else
            refused = strings.appendWord(h, builder, 0x74616f6c66ULL, 5ULL)
        end
        if refused ~= 0ULL then
            strings.release(builder)
            error("not enough memory")
        end
        local s = strings.finish(h, builder)
        tables.drain(h)
        return values.TAG_OBJ | s
    end
end

-- Lua's /: always float.
export function divide(ctx: voidptr, a: uint64, b: uint64): uint64
    local x = guestvalues.floatof(a)
    local y = guestvalues.floatof(b)
    if x == values.NIL or y == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return guestvalues.floatvalue(native.bits(native.fromBits(x) / native.fromBits(y)))
end

-- Lua's //: floor division, integer for integers (raising for zero) and
-- float otherwise.
export function floorDivide(ctx: voidptr, a: uint64, b: uint64): uint64
    if ints.isInteger(a) and ints.isInteger(b) then
        local x = native.index(ints.bitsOf(a))
        local y = native.index(ints.bitsOf(b))
        if y == 0 then
            texts.libraryError(ctx, librarytexts.TEXT_IDIV_ZERO)
        end
        if y == -1 then
            return guestscope.integer(ctx, 0ULL - native.word(x))
        end
        return guestscope.integer(ctx, native.word(x // y))
    end
    local x = guestvalues.floatof(a)
    local y = guestvalues.floatof(b)
    if x == values.NIL or y == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return guestvalues.floatvalue(native.bits(native.floor(native.fromBits(x) / native.fromBits(y))))
end

local function space(c: uint64): boolean
    return c == 32ULL or (c >= 9ULL and c <= 13ULL)
end

local function hexDigit(c: uint64): uint64
    if c >= 48ULL and c <= 57ULL then
        return c - 48ULL
    elseif c >= 97ULL and c <= 102ULL then
        return c - 87ULL
    elseif c >= 65ULL and c <= 70ULL then
        return c - 55ULL
    end

    return 16ULL
end

-- Lua's tonumber: numbers as they are; strings by l_str2int (optional sign,
-- decimal or wrapping hexadecimal, surrounding space); nil for any other
-- value or text that is not a numeral. Other text, a decimal past int64
-- included, is read as a float by C's strtod through the host.
export function tonumber(ctx: voidptr, value: uint64): uint64
    local cell = strings.Builder(0ULL, 0ULL)
    if ints.isInteger(value) or guestvalues.floatof(value) ~= values.NIL then
        return value
    end
    local s = strings.header(value)
    if s == 0ULL then
        if value == values.NIL then
            texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_VALUE_EXPECTED, values.NIL)
        end
        return values.NIL
    end
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local slotLifetime = strings.open(h, cell as strings.Builder*)
        local p = strings.bytes(s)
        local finish = p + strings.length(s)
        while p < finish and space(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        local negative = false
        if p < finish and native.word(native.load8(native.pointer(p), 0)) == 45ULL then
            negative = true
            p = p + 1ULL
        end
        local bits: uint64 = 0ULL
        local digits: uint64 = 0ULL
        local overflow = false
        local hex = p + 1ULL < finish
            and native.word(native.load8(native.pointer(p), 0)) == 48ULL
            and (native.word(native.load8(native.pointer(p), 1)) | 32ULL) == 120ULL
        if hex then
            p = p + 2ULL
            while p < finish and hexDigit(native.word(native.load8(native.pointer(p), 0))) < 16ULL do
                bits = bits * 16ULL + hexDigit(native.word(native.load8(native.pointer(p), 0)))
                digits = digits + 1ULL
                p = p + 1ULL
            end
        else
            while p < finish do
                local c = native.word(native.load8(native.pointer(p), 0))
                if c < 48ULL or c > 57ULL then
                    break
                end
                local d = c - 48ULL
                -- Past 2^63 - 1 (2^63 when negative) is a float numeral.
                local last: uint64 = 7ULL
                if negative then
                    last = 8ULL
                end
                if bits > 922337203685477580ULL or (bits == 922337203685477580ULL and d > last) then
                    overflow = true
                end
                bits = bits * 10ULL + d
                digits = digits + 1ULL
                p = p + 1ULL
            end
        end
        local numeral = digits > 0ULL and not overflow
        while p < finish and space(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        if numeral and p == finish then
            if negative then
                bits = 0ULL - bits
            end
            return ints.make(guestvalues.guestheap(ctx), bits)
        end
        -- Otherwise a float numeral by C's strtod, as Lua's l_str2d reads one;
        -- like it, text holding an n or N (inf, nan) is refused first.
        local q = strings.bytes(s)
        while q < finish do
            if native.word(native.load8(native.pointer(q), 0)) | 32ULL == 110ULL then
                return values.NIL
            end
            q = q + 1ULL
        end
        -- The bits land in a builder's word backing.
        local slot = cell as strings.Builder*
        if strings.reserve(guestvalues.guestheap(ctx), slot, 8ULL) ~= 0ULL then
            error("not enough memory")
        end
        local parsed = numbers.parseNumber(
            native.pointer(strings.bytes(s)),
            strings.length(s),
            native.pointer(strings.descriptor(slotLifetime).base)
        )
        local bits = native.load64(native.pointer(strings.descriptor(slotLifetime).base), 0)
        strings.release(slot)
        if parsed ~= 1 then
            return values.NIL
        end

        return guestvalues.floatvalue(bits)
    end
end

-- C's math functions, by their number.
const C_POW: uint64 = 0ULL
export const C_EXP: uint64 = 1ULL
const C_LOG: uint64 = 2ULL
const C_LOG2: uint64 = 3ULL
const C_LOG10: uint64 = 4ULL
export const C_SIN: uint64 = 5ULL
export const C_COS: uint64 = 6ULL
export const C_TAN: uint64 = 7ULL
export const C_ASIN: uint64 = 8ULL
export const C_ACOS: uint64 = 9ULL
export const C_ATAN2: uint64 = 10ULL
const C_FMOD: uint64 = 11ULL
-- What an unknown one answers: a quiet NaN.
const UNKNOWN: uint64 = 0x7ff8000000000000ULL

cdef function pow(x: float64, y: float64): float64
cdef function exp(x: float64): float64
cdef function log(x: float64): float64
cdef function log2(x: float64): float64
cdef function log10(x: float64): float64
cdef function sin(x: float64): float64
cdef function cos(x: float64): float64
cdef function tan(x: float64): float64
cdef function asin(x: float64): float64
cdef function acos(x: float64): float64
cdef function atan2(y: float64, x: float64): float64
cdef function fmod(x: float64, y: float64): float64

-- C's math function `op` of the binary64 bits `x` (and `y` for the
-- two-operand ones), as binary64 bits.
local function cmath(op: uint64, x: uint64, y: uint64): uint64
    local a = native.fromBits(x)
    local b = native.fromBits(y)
    if op == C_POW then
        return native.bits(pow(a, b))
    elseif op == C_EXP then
        return native.bits(exp(a))
    elseif op == C_LOG then
        return native.bits(log(a))
    elseif op == C_LOG2 then
        return native.bits(log2(a))
    elseif op == C_LOG10 then
        return native.bits(log10(a))
    elseif op == C_SIN then
        return native.bits(sin(a))
    elseif op == C_COS then
        return native.bits(cos(a))
    elseif op == C_TAN then
        return native.bits(tan(a))
    elseif op == C_ASIN then
        return native.bits(asin(a))
    elseif op == C_ACOS then
        return native.bits(acos(a))
    elseif op == C_ATAN2 then
        return native.bits(atan2(a, b))
    elseif op == C_FMOD then
        return native.bits(fmod(a, b))
    end

    return UNKNOWN
end

-- C's math function `op` of the numbers a and b, as a float.
export function hostMath(op: uint64, a: uint64, b: uint64): uint64
    return guestvalues.floatvalue(cmath(op, guestvalues.floatof(a), guestvalues.floatof(b)))
end

-- a ^ b: always a float, by C's pow.
export function power(ctx: voidptr, a: uint64, b: uint64): uint64
    if guestvalues.floatof(a) == values.NIL or guestvalues.floatof(b) == values.NIL then
        texts.faultError(ctx, guestscope.FAULT_ARITH, a, b)
    end

    return hostMath(C_POW, a, b)
end

-- math.log(x [, base]): base 2 and 10 by their own functions, any other as
-- a quotient of natural logarithms.
export function mathLog(ctx: voidptr, count: uint64, x: uint64, base: uint64): uint64
    local value = guestvalues.numarg(ctx, x, 1ULL)
    if count < 2ULL then
        return hostMath(C_LOG, value, value)
    end
    -- 2.0 and 10.0 by their bits.
    local b = guestvalues.floatof(guestvalues.numarg(ctx, base, 2ULL))
    if b == 0x4000000000000000ULL then
        return hostMath(C_LOG2, value, value)
    elseif b == 0x4024000000000000ULL then
        return hostMath(C_LOG10, value, value)
    end
    local numerator = native.fromBits(cmath(C_LOG, guestvalues.floatof(value), 0ULL))
    local denominator = native.fromBits(cmath(C_LOG, guestvalues.floatof(base), 0ULL))

    return guestvalues.floatvalue(native.bits(numerator / denominator))
end

-- math.fmod(a, b): for integers, the remainder of truncated division (an
-- error for zero); otherwise C's fmod.
export function mathFmod(ctx: voidptr, a: uint64, b: uint64): uint64
    local x = guestvalues.numarg(ctx, a, 1ULL)
    local y = guestvalues.numarg(ctx, b, 2ULL)
    if ints.isInteger(x) and ints.isInteger(y) then
        local n = ints.bitsOf(x)
        local d = ints.bitsOf(y)
        if d == 0ULL then
            texts.argumentError(ctx, 2ULL, 0ULL, librarytexts.TEXT_ZERO, b)
        end
        local negative = native.index(n) < 0
        local magnitude = n
        if negative then
            magnitude = 0ULL - n
        end
        local divisor = d
        if native.index(d) < 0 then
            divisor = 0ULL - d
        end
        local r = magnitude % divisor
        if negative then
            r = 0ULL - r
        end
        return guestscope.integer(ctx, r)
    end

    return hostMath(C_FMOD, x, y)
end

-- math.random's four words of state, in the services.
local function randomBase(ctx: voidptr): uint64
    @unsafe do
        return native.address(
            native.offset(
                native.loadPointer(ctx, context.SERVICE_SCOPE),
                native.fieldOffset<guestscope.Services>("random0")
            )
        )
    end
end

local function rotateLeft(x: uint64, n: uint64): uint64
    return (x << n) | (x >> (64ULL - n))
end

-- xoshiro256**, as Lua 5.5 draws: the next value, advancing the state.
local function nextRandom(state: uint64): uint64
    @unsafe do
        local s = native.pointer(state)
        local s0 = native.load64(s, 0)
        local s1 = native.load64(s, 8)
        local s2 = native.load64(s, 16) ~ s0
        local s3 = native.load64(s, 24) ~ s1
        local result = rotateLeft(s1 * 5ULL, 7ULL) * 9ULL
        native.store64(s, 0, s0 ~ s3)
        native.store64(s, 8, s1 ~ s2)
        native.store64(s, 16, s2 ~ (s1 << 17ULL))
        native.store64(s, 24, rotateLeft(s3, 45ULL))
        return result
    end
end

-- Lua's setseed: the two seeds, 0xff so the state is never zero, and
-- sixteen draws discarded to spread them.
local function seedRandom(state: uint64, n1: uint64, n2: uint64): nil
    @unsafe do
        local s = native.pointer(state)
        native.store64(s, 0, n1)
        native.store64(s, 8, 0xffULL)
        native.store64(s, 16, n2)
        native.store64(s, 24, 0ULL)
        local i: int64 = 0
        while i < 16 do
            nextRandom(state)
            i = i + 1
        end
    end
end

-- The state, seeded from the host on first use as Lua seeds at startup.
local function randomState(ctx: voidptr): uint64
    @unsafe do
        local state = randomBase(ctx)
        local s = native.pointer(state)
        if native.load64(s, 0) | native.load64(s, 8) | native.load64(s, 16) | native.load64(s, 24) == 0ULL then
            seedRandom(state, clock.randomSeed(), 0ULL)
        end
        return state
    end
end

-- Lua's project: `ran` into [0, n], uniformly, drawing again while the
-- smallest all-ones mask covering n leaves it above n.
local function project(s: uint64, ran: uint64, n: uint64): uint64
    local lim = n
    local sh: uint64 = 1ULL
    while lim & (lim + 1ULL) ~= 0ULL do
        lim = lim | (lim >> sh)
        sh = sh * 2ULL
    end
    local value = ran & lim
    while value > n do
        value = nextRandom(s) & lim
    end

    return value
end

-- math.random(): a float in [0, 1) from the top 53 bits; (m): an integer in
-- [1, m], or any integer for 0; (m, n): an integer in [m, n].
export function mathRandom(ctx: voidptr, count: uint64, a: uint64, b: uint64): uint64
    local s = randomState(ctx)
    local rv = nextRandom(s)
    if count == 0ULL then
        local scaled = native.fromBits(ints.toFloatBits(rv >> 11ULL)) * native.fromBits(0x3ca0000000000000ULL)
        return guestvalues.floatvalue(native.bits(scaled))
    end
    local low: int64 = 1
    local up: int64 = 0
    if count == 1ULL then
        up = guestvalues.intarg(ctx, a, 0, 1ULL)
        if up == 0 then
            return guestscope.integer(ctx, rv)
        end
    else
        low = guestvalues.intarg(ctx, a, 0, 1ULL)
        up = guestvalues.intarg(ctx, b, 0, 2ULL)
    end
    if low > up then
        texts.argumentError(ctx, 1ULL, 0ULL, librarytexts.TEXT_EMPTY_INTERVAL, a)
    end

    return guestscope.integer(ctx, project(s, rv, native.word(up) - native.word(low)) + native.word(low))
end

-- math.randomseed([n1 [, n2]]): seeds the state, from the host and a draw
-- when no seed is given; answers the first seed.
export function mathRandomseed(ctx: voidptr, count: uint64, a: uint64, b: uint64): uint64
    local n1: uint64 = 0ULL
    local n2: uint64 = 0ULL
    if count == 0ULL then
        n1 = clock.randomSeed()
        n2 = nextRandom(randomState(ctx))
    else
        n1 = native.word(guestvalues.intarg(ctx, a, 0, 1ULL))
        n2 = native.word(guestvalues.intarg(ctx, b, 0, 2ULL))
    end
    seedRandom(randomBase(ctx), n1, n2)

    return guestscope.integer(ctx, n1)
end

-- A numeric for's limit as a number: a number as it is, a numeral string
-- converted, as Lua's forlimit does; anything else raises as Lua 5.5 does.
export function forlimit(ctx: voidptr, value: uint64): uint64
    local number = values.NIL
    if value ~= values.NIL then
        number = tonumber(ctx, value)
    end
    if number == values.NIL then
        texts.forLimitError(ctx, value)
    end

    return number
end

local function numeralspace(c: uint64): boolean
    return c == 32ULL or (c >= 9ULL and c <= 13ULL)
end

-- The digit `c` spells in bases up to 36, or 36 for none.
local function numeraldigit(c: uint64): uint64
    if c >= 48ULL and c <= 57ULL then
        return c - 48ULL
    end
    local upper = c & 0xdfULL
    if upper >= 65ULL and upper <= 90ULL then
        return upper - 55ULL
    end

    return 36ULL
end

-- tonumber(s, base): as Lua's b_str2int, surrounding space and an optional
-- sign around at least one digit below `base`, wrapping past 64 bits; nil
-- for any other text.
export function tonumberbase(ctx: voidptr, value: uint64, base: uint64): uint64
    -- A nil base is the one-value form.
    if base == values.NIL then
        return tonumber(ctx, value)
    end
    guestscope.nameLibrary(ctx, librarytexts.NAME_TONUMBER)
    local radix = native.word(guestvalues.intarg(ctx, base, 0, 2ULL))
    local s = strings.header(value)
    if s == 0ULL then
        texts.argumentError(ctx, 1ULL, librarytexts.TEXT_STRING, 0ULL, value)
    end
    if radix < 2ULL or radix > 36ULL then
        texts.argumentError(ctx, 2ULL, 0ULL, librarytexts.TEXT_BASE_RANGE, base)
    end
    @unsafe do
        local p = strings.bytes(s)
        local finish = p + strings.length(s)
        while p < finish and numeralspace(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        local negative = false
        if p < finish and native.word(native.load8(native.pointer(p), 0)) == 45ULL then
            negative = true
            p = p + 1ULL
        elseif p < finish and native.word(native.load8(native.pointer(p), 0)) == 43ULL then
            p = p + 1ULL
        end
        local bits: uint64 = 0ULL
        local digits: uint64 = 0ULL
        while p < finish do
            local c = native.word(native.load8(native.pointer(p), 0))
            local d = numeraldigit(c)
            if d == 36ULL then
                break
            end
            if d >= radix then
                return values.NIL
            end
            bits = bits * radix + d
            digits = digits + 1ULL
            p = p + 1ULL
        end
        if digits == 0ULL then
            return values.NIL
        end
        while p < finish and numeralspace(native.word(native.load8(native.pointer(p), 0))) do
            p = p + 1ULL
        end
        if p ~= finish then
            return values.NIL
        end
        if negative then
            bits = 0ULL - bits
        end
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local h = native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
        return ints.make(h, bits)
    end
end

-- Lua's bitwise operators on 64-bit integers: `&`, `|`, `~`, `<<`, `>>` and
-- unary `~`. A float operand with an exact integer value takes part as that
-- integer; any other float, and any value that is not a number, is an error.
local function bitnumber(value: uint64): boolean
    return ints.isInteger(value) or value & values.QNAN ~= values.QNAN or value == values.QNAN
end

local function bitconvertible(value: uint64): boolean
    return ints.isInteger(value) or value & values.QNAN ~= values.QNAN and ints.integralFloat(value)
end

-- A convertible value's integer bits.
local function bitsof(value: uint64): uint64
    if ints.isInteger(value) then
        return ints.bitsOf(value)
    end

    return ints.floatToBits(value)
end

-- `x` shifted left by `n` bits, right when `n` is negative; 64 or more
-- either way shifts every bit out.
local function shiftleft(x: uint64, n: int64): uint64
    if n <= -64 or n >= 64 then
        return 0ULL
    elseif n >= 0 then
        return x << native.word(n)
    end

    return x >> native.word(0 - n)
end

-- The operation `id` makes of `a` and `b` (`b` unused for `~a`).
export function bitcall(ctx: voidptr, id: uint64, a: uint64, b: uint64): uint64
    -- `~a` is Lua's operation on a and a.
    local right = b
    if id == librarycalls.BNOT then
        right = a
    end
    -- Two numbers fail for want of an integer value; otherwise the first
    -- operand that is not a number is named.
    if not bitconvertible(a) or not bitconvertible(right) then
        if bitnumber(a) and bitnumber(right) then
            texts.faultError(ctx, guestscope.FAULT_NOINT, a, right)
        end
        texts.faultError(ctx, guestscope.FAULT_BITWISE, a, right)
    end
    local x = bitsof(a)
    local y = bitsof(right)
    local result: uint64 = 0ULL
    if id == librarycalls.BAND then
        result = x & y
    elseif id == librarycalls.BOR then
        result = x | y
    elseif id == librarycalls.BXOR then
        result = x ~ y
    elseif id == librarycalls.SHL then
        result = shiftleft(x, native.index(y))
    elseif id == librarycalls.SHR then
        result = shiftleft(x, 0 - native.index(y))
    else
        result = x ~ 0xffffffffffffffffULL
    end
    @unsafe do
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local h = native.pointer(native.load64(services, native.fieldOffset<guestscope.Services>("heap"))) as heap.Heap*
        return ints.make(h, result)
    end
end

const U32_BITS: uint64 = 32ULL
const U32_MASK: uint64 = 0xffffffffULL
const I32_SIGN_BIT: uint64 = 0x80000000ULL
const I32_SIGN_EXTENSION: uint64 = 0xffffffff00000000ULL
const U32_COUNT_MASK: uint64 = 31ULL

-- Signed32 words are sign extended only at the boundary; the common kernel
-- computes on exact low32 bit patterns, never through binary64 arithmetic.
local function signed32(bits: uint64): uint64
    local low = bits & U32_MASK
    return native.chooseWord(low >= I32_SIGN_BIT, low | I32_SIGN_EXTENSION, low)
end

-- The generated selector identifies a checked family and operation. Comparisons
-- return tagged booleans; all other operations return exact integer bits.
export function scalarbits(selector: uint64, left: uint64, right: uint64): uint64
    local family = selector >> scalarkinds.SELECTOR_SHIFT
    local operation = selector & scalarkinds.SELECTOR_MASK
    if family == scalarkinds.U64 then
        if operation == scalarkinds.ANDBITS then
            return left & right
        elseif operation == scalarkinds.SUB then
            return left - right
        end
        error("invalid64-bit scalar operation")
    end
    if family ~= scalarkinds.I32 and family ~= scalarkinds.U32 then
        error("invalid scalar family")
    end
    local a = left & U32_MASK
    local b = right & U32_MASK
    local count = b & U32_COUNT_MASK
    local result = a
    if operation == scalarkinds.ADD then
        result = a + b
    elseif operation == scalarkinds.SUB then
        result = a - b
    elseif operation == scalarkinds.MUL then
        result = a * b
    elseif operation == scalarkinds.ANDBITS then
        result = a & b
    elseif operation == scalarkinds.ORBITS then
        result = a | b
    elseif operation == scalarkinds.XORBITS then
        result = a ~ b
    elseif operation == scalarkinds.NOTBITS then
        result = a ~ U32_MASK
    elseif operation == scalarkinds.SHIFTLEFT then
        result = a << count
    elseif operation == scalarkinds.SHIFTRIGHTLOGICAL then
        result = a >> count
    elseif operation == scalarkinds.SHIFTRIGHTARITHMETIC then
        result = a >> count
        if a >= I32_SIGN_BIT then
            result = result | (U32_MASK << (U32_BITS - count))
        end
    elseif operation == scalarkinds.ROTATELEFT then
        result = (a << count) | (a >> ((U32_BITS - count) & U32_COUNT_MASK))
    elseif operation == scalarkinds.ROTATERIGHT then
        result = (a >> count) | (a << ((U32_BITS - count) & U32_COUNT_MASK))
    elseif operation == scalarkinds.LESSTHAN or operation == scalarkinds.LESSOREQUAL then
        local less = a < b
        if family == scalarkinds.I32 then
            less = native.index(signed32(a)) < native.index(signed32(b))
        end
        return native.chooseWord(less or operation == scalarkinds.LESSOREQUAL and a == b, values.TRUE, values.FALSE)
    elseif operation == scalarkinds.DIV or operation == scalarkinds.MOD then
        if b == 0ULL then
            result = 0ULL
        elseif operation == scalarkinds.DIV then
            result = a // b
        else
            result = a % b
        end
    elseif operation == scalarkinds.POPCOUNT then
        result = 0ULL
        local rest = a
        while rest ~= 0ULL do
            result = result + 1ULL
            rest = rest & (rest - 1ULL)
        end
    elseif operation == scalarkinds.TRAILINGZEROS or operation == scalarkinds.LEADINGZEROS then
        result = U32_BITS
        if a ~= 0ULL then
            result = 0ULL
            local probe = native.chooseWord(operation == scalarkinds.LEADINGZEROS, I32_SIGN_BIT, 1ULL)
            while a & probe == 0ULL do
                result = result + 1ULL
                if operation == scalarkinds.LEADINGZEROS then
                    probe = probe >> 1ULL
                else
                    probe = probe << 1ULL
                end
            end
        end
    elseif operation ~= scalarkinds.WRAP
        and operation ~= scalarkinds.FROMU32
        and operation ~= scalarkinds.TOU32
        and operation ~= scalarkinds.FROMI32
        and operation ~= scalarkinds.TOI32
    then
        error("invalid32-bit scalar operation")
    end
    local signed = family == scalarkinds.I32
    if operation == scalarkinds.TOU32 or operation == scalarkinds.FROMI32 then
        signed = false
    elseif operation == scalarkinds.FROMU32 or operation == scalarkinds.TOI32 then
        signed = true
    end

    return native.chooseWord(signed, signed32(result), result & U32_MASK)
end

local function scalarword(ctx: voidptr, value: uint64, position: uint64): uint64
    if value == values.NIL then
        texts.argumentError(ctx, position, librarytexts.TEXT_NUMBER, 0ULL, value)
    end
    return native.word(guestvalues.intarg(ctx, value, 0, position))
end

export function scalarcall(ctx: voidptr, id: uint64, a: uint64, b: uint64): uint64
    local selector = scalarkinds.selector(id)
    if selector == 0ULL then
        error("invalid scalar library call")
    end
    local operation = selector & scalarkinds.SELECTOR_MASK
    local left = scalarword(ctx, a, 1ULL)
    local right: uint64 = 0ULL
    if operation == scalarkinds.ADD
        or operation == scalarkinds.SUB
        or operation == scalarkinds.MUL
        or operation == scalarkinds.ANDBITS
        or operation == scalarkinds.ORBITS
        or operation == scalarkinds.XORBITS
        or operation == scalarkinds.SHIFTLEFT
        or operation == scalarkinds.SHIFTRIGHTLOGICAL
        or operation == scalarkinds.SHIFTRIGHTARITHMETIC
        or operation == scalarkinds.ROTATELEFT
        or operation == scalarkinds.ROTATERIGHT
        or operation == scalarkinds.LESSTHAN
        or operation == scalarkinds.LESSOREQUAL
        or operation == scalarkinds.DIV
        or operation == scalarkinds.MOD
    then
        right = scalarword(ctx, b, 2ULL)
    end
    local result = scalarbits(selector, left, right)
    if operation == scalarkinds.LESSTHAN or operation == scalarkinds.LESSOREQUAL then
        return result
    end

    return guestscope.integer(ctx, result)
end

-- The fixed-width call `id` (math.f32.narrow, math.u32.wrap or
-- math.i32.wrap) of `a`.
export function widthcall(ctx: voidptr, id: uint64, a: uint64): uint64
    if id == librarycalls.MATH_F32_NARROW then
        return guestvalues.floatvalue(corestorage.narrow(guestvalues.floatof(guestvalues.numarg(ctx, a, 1ULL))))
    end
    return scalarcall(ctx, id, a, values.NIL)
end
