    if native.load8(data, 5) ~= 71 then
        return 0ULL
    end
    if native.load8(data, 6) ~= 82 then
        return 0ULL
    end
    if native.load8(data, 7) ~= 70 then
        return 0ULL
    end

    return 1ULL
end

export function policy(data: voidptr, at: int64): uint64
    if (native.word(native.load32(data, at + 0)) & 0xffffffffULL) ~= 2ULL then
        return 0ULL
    end
    if (native.word(native.load32(data, at + 4)) & 0xffffffffULL) ~= 2ULL then
        return 0ULL
    end
    if (native.word(native.load32(data, at + 8)) & 0xffffffffULL) ~= 0ULL then
        return 0ULL
    end
    if (native.word(native.load32(data, at + 12)) & 0xffffffffULL) ~= 1ULL then
        return 0ULL
    end

    return 1ULL
end
