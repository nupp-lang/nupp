export function magic(data: voidptr): uint64
    if native.load8(data, 0) ~= 78 then
        return 0ULL
    end
    if native.load8(data, 1) ~= 85 then
        return 0ULL
    end
    if native.load8(data, 2) ~= 80 then
        return 0ULL
    end
    if native.load8(data, 3) ~= 80 then
        return 0ULL
