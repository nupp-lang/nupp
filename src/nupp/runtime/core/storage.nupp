module nupp.runtime.core.storage

-- Core-only byte storage. The caller owns this descriptor and its heap outlives
-- the backing. Initialize requires an all-zero fresh descriptor; release clears
-- every field and is idempotent. Counts and cursors are bytes: read <= len <= cap.
-- A nonzero kind is caller-validated representation metadata, never a width.
--
-- Growth and release cannot collect, suspend, or call guest code. Refusal leaves
-- the descriptor and its bytes unchanged. Growth preserves [0,len), zeros the
-- new capacity, and invalidates old raw pointers. Append relocates an initialized
-- source range within its own backing before using it after growth. External
-- source pointers must name count readable bytes and remain valid through reserve.
-- A zero CopyStats pointer disables accounting; no shared VM layout is extended.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const backing = require("nupp.runtime.vm.backing")
const shared = require("nupp.runtime.core.sharedbacking")
const pages = require("nupp.runtime.core.pagemappings")

export const OK: uint64 = 0ULL
export const INVALID: uint64 = 1ULL
export const NO_MEMORY: uint64 = 2ULL
-- Scalar kinds 1 through 10 and packed booleans 11 retain their existing ids.
export const TAGGED_VALUES: uint64 = 12ULL
export const POOLED: uint64 = 0ULL
export const SHARED: uint64 = 1ULL
export const GENERIC: uint64 = 0ULL
export const BUFFER: uint64 = 1ULL
export const BUSY: uint64 = 3ULL
export const CLEANUP_FAILED: uint64 = 4ULL
const MIN_CAPACITY: uint64 = 64ULL
const WORD_BYTES: uint64 = 8ULL
const MAX_GENERATION: uint64 = 0xffffffffffffffffULL

export struct Storage
    base: uint64
    len: uint64
    cap: uint64
    read: uint64
    kind: uint64
    mode: uint64
    role: uint64
    block: uint64
    generation: uint64
    writer: uint64
    pending: uint64
    closed: uint64
    error: uint64
end

export struct CopyStats
    bytes: uint64
end

-- Fresh-only descriptor initialization, never a release operation. These fields
-- are private ownership/lease metadata; base/len/cap/read remain the byte tuple.
export function clear(borrows s: Storage*): nil
    @unsafe do
        s.base = 0ULL
        s.len = 0ULL
        s.cap = 0ULL
        s.read = 0ULL
        s.kind = 0ULL
        s.mode = POOLED
        s.role = GENERIC
        s.block = 0ULL
        s.generation = 0ULL
        s.writer = 0ULL
        s.pending = 0ULL
        s.closed = 0ULL
        s.error = 0ULL
    end
end

export function maximum(): uint64
    return backing.wordBackingMaximum() * WORD_BYTES
end

local function valid(s: Storage*): boolean
    @unsafe do
        return s.kind ~= 0ULL
            and s.read <= s.len
            and s.len <= s.cap
            and s.cap <= maximum()
            and s.mode == POOLED
            and s.role == GENERIC
            and s.block == 0ULL
            and s.generation == 0ULL
            and s.writer == 0ULL
            and s.pending == 0ULL
            and s.closed == 0ULL
            and ((s.cap == 0ULL and s.base == 0ULL) or (s.cap > 0ULL and s.base ~= 0ULL))
    end
end

-- Copies and fills go a run of four words at a time, the bytes past the
-- last run one by one.
const RUN_BYTES: uint64 = 32ULL

local function zero(base: uint64, count: uint64): nil
    local to = native.pointer(base)
    local i: uint64 = 0ULL
    while i + RUN_BYTES <= count do
        local at = native.index(i)
        native.store64(to, at, 0ULL)
        native.store64(to, at + 8, 0ULL)
        native.store64(to, at + 16, 0ULL)
        native.store64(to, at + 24, 0ULL)
        i = i + RUN_BYTES
    end
    while i < count do
        native.store8(to, native.index(i), 0ULL)
        i = i + 1ULL
    end
end

-- Copies the bytes of a copy past its last whole run, from `whole` to
-- `count`: up from the first, or down from the last.
local function copytail(to: voidptr, from: voidptr, whole: uint64, count: uint64, up: boolean): nil
    local last = native.index(count - 1ULL)
    local k: uint64 = 0ULL
    while whole + k < count do
        local at = native.chooseIndex(up, native.index(whole + k), last - native.index(k))
        native.store8(to, at, native.word(native.load8(from, at)))
        k = k + 1ULL
    end
end

-- Both ranges are caller-proven and may overlap, including in either direction.
-- A copy toward lower addresses goes up from the start and one toward higher
-- addresses down from the end, so no load reads a byte a store has already
-- written: whatever a run stores lies wholly before (or after) every byte
-- still to be loaded. Each run is loaded whole before any of it is stored.
export function copy(target: uint64, source: uint64, count: uint64, stats: CopyStats*): nil
    local to = native.pointer(target)
    local from = native.pointer(source)
    local up = target <= source
    local whole = count - count % RUN_BYTES
    if not up then
        copytail(to, from, whole, count, up)
    end
    local i: uint64 = 0ULL
    while i < whole do
        local at = native.chooseIndex(up, native.index(i), native.index(whole - RUN_BYTES - i))
        local w0 = native.load64(from, at)
        local w1 = native.load64(from, at + 8)
        local w2 = native.load64(from, at + 16)
        local w3 = native.load64(from, at + 24)
        native.store64(to, at, w0)
        native.store64(to, at + 8, w1)
        native.store64(to, at + 16, w2)
        native.store64(to, at + 24, w3)
        i = i + RUN_BYTES
    end
    if up then
        copytail(to, from, whole, count, up)
    end
    if native.address(stats as voidptr) ~= 0ULL then
        @unsafe stats.bytes = stats.bytes + count
    end
end

export function initialize(h: heap.Heap*, s: Storage*, kind: uint64, length: uint64, capacity: uint64): uint64
    @unsafe do
        if native.address(h as voidptr) == 0ULL
            or kind == 0ULL
            or length > capacity
            or capacity > maximum()
            or s.base ~= 0ULL
            or s.len ~= 0ULL
            or s.cap ~= 0ULL
            or s.read ~= 0ULL
            or s.kind ~= 0ULL
            or s.mode ~= POOLED
            or s.role ~= GENERIC
            or s.block ~= 0ULL
            or s.generation ~= 0ULL
            or s.writer ~= 0ULL
            or s.pending ~= 0ULL
            or s.closed ~= 0ULL
            or s.error ~= 0ULL
        then
            return INVALID
        end
        local base: uint64 = 0ULL
        if capacity > 0ULL then
            base = backing.wordBackingTake(h, (capacity + WORD_BYTES - 1ULL) // WORD_BYTES)
            if base == 0ULL then
                return NO_MEMORY
            end
            zero(base, capacity)
        end
        s.base = base
        s.len = length
        s.cap = capacity
        s.kind = kind

        return OK
    end
end

-- additional is room after len, not after the read cursor.
export function reserve(h: heap.Heap*, s: Storage*, additional: uint64, stats: CopyStats*): uint64
    @unsafe do
        if native.address(h as voidptr) == 0ULL or not valid(s) or additional > maximum() - s.len then
            return INVALID
        end
        local wanted = s.len + additional
        if wanted <= s.cap then
            return OK
        end
        local capacity = wanted
        if s.cap <= maximum() // 2ULL and capacity < s.cap * 2ULL then
            capacity = s.cap * 2ULL
        end
        if capacity < MIN_CAPACITY then
            capacity = MIN_CAPACITY
        end
        local fresh = backing.wordBackingTake(h, (capacity + WORD_BYTES - 1ULL) // WORD_BYTES)
        if fresh == 0ULL then
            return NO_MEMORY
        end
        zero(fresh, capacity)
        copy(fresh, s.base, s.len, stats)
        local before = s.base
        s.base = fresh
        s.cap = capacity
        backing.wordBackingRelease(before)

        return OK
    end
end

export function append(h: heap.Heap*, s: Storage*, source: uint64, count: uint64, stats: CopyStats*): uint64
    @unsafe do
        if not valid(s) or count > maximum() - s.len or (count > 0ULL and source == 0ULL) then
            return INVALID
        end
        local aliases = false
        local offset: uint64 = 0ULL
        if s.base ~= 0ULL and source >= s.base and source <= s.base + s.cap then
            offset = source - s.base
            if offset > s.len or count > s.len - offset then
                return INVALID
            end
            aliases = true
        end
        local status = reserve(h, s, count, stats)
        if status ~= OK then
            return status
        end
        local from = source
        if aliases then
            from = s.base + offset
        end
        copy(s.base + s.len, from, count, stats)
        s.len = s.len + count

        return OK
    end
end

-- The caller has initialized count bytes beginning at base + len.
export function commit(s: Storage*, count: uint64): uint64
    @unsafe do
        if not valid(s) or count > s.cap - s.len then
            return INVALID
        end
        s.len = s.len + count

        return OK
    end
end

export function consume(s: Storage*, count: uint64): uint64
    @unsafe do
        if not valid(s) or count > s.len - s.read then
            return INVALID
        end
        s.read = s.read + count

        return OK
    end
end

export function truncate(s: Storage*, length: uint64): uint64
    @unsafe do
        if not valid(s) or length < s.read or length > s.len then
            return INVALID
        end
        s.len = length

        return OK
    end
end

export function reset(s: Storage*): nil
    @unsafe do
        s.len = 0ULL
        s.read = 0ULL
    end
end

export function release(s: Storage*): nil
    @unsafe do
        local base = s.base
        clear(s)
        backing.wordBackingRelease(base)
    end
end

-- Buffer state owns shared backing from its first allocation. Empty state may
-- advertise capacity without a block; reset never reuses a published block.
-- These entry points cannot collect, suspend, or call guest code. The managed
-- adapter completes its lease before bufferadmit publishes admission.
local function buffervalid(s: Storage*): boolean
    @unsafe do
        return s.mode == SHARED
            and s.role == BUFFER
            and s.kind ~= 0ULL
            and s.closed == 0ULL
            and s.read <= s.len
            and s.len <= s.cap
            and s.cap <= maximum()
            and ((s.block == 0ULL and s.base == 0ULL and s.len == 0ULL) or (s.block ~= 0ULL and s.base ~= 0ULL))
    end
end

-- INVALID preserves pending ownership. FAILED consumes it; retain only the
-- first OS error, never an address that could be released a second time.
export function bufferfinish(s: Storage*): uint64
    local state = pages.Scope(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
    @unsafe do
        if s.pending == 0ULL then
            return OK
        end
        local scope = state as pages.Scope*
        local status = shared.releaselocal(scope, native.pointer(s.pending))
        if status == shared.INVALID then
            return INVALID
        end
        s.pending = 0ULL
        if status == shared.FAILED then
            if s.error == 0ULL then
                s.error = scope.status
            end
            return CLEANUP_FAILED
        end
        return OK
    end
end

-- A live provider acknowledges an error only when it surfaces that consumed
-- failure to the caller. Retained pending ownership keeps its first error.
export function bufferack(s: Storage*): uint64
    @unsafe do
        if s.pending ~= 0ULL then
            return 0ULL
        end
        local status = s.error
        s.error = 0ULL
        return status
    end
end

export function bufferinitialize(s: Storage*, kind: uint64, capacity: uint64): uint64
    @unsafe do
        if kind == 0ULL
            or capacity > maximum()
            or s.base ~= 0ULL
            or s.len ~= 0ULL
            or s.cap ~= 0ULL
            or s.read ~= 0ULL
            or s.kind ~= 0ULL
            or s.mode ~= POOLED
            or s.role ~= GENERIC
            or s.block ~= 0ULL
            or s.generation ~= 0ULL
            or s.writer ~= 0ULL
            or s.pending ~= 0ULL
            or s.closed ~= 0ULL
            or s.error ~= 0ULL
        then
            return INVALID
        end
        s.kind = kind
        s.cap = capacity
        s.mode = SHARED
        s.role = BUFFER
        return OK
    end
end

-- Publish the complete fresh tuple before retiring the old ownership. A
-- cleanup refusal leaves that ownership in pending and cannot roll back a
-- tuple whose old block may already have been consumed.
local function buffermove(
    s: Storage*,
    capacity: uint64,
    generation: uint64,
    stats: CopyStats*,
    mappedLimit: uint64
): uint64
    @unsafe do
        -- Admission is noncollecting. Bound peak ownership before creating a
        -- mapping: retiring the old block can refuse and leave it pending.
        local mapped = pages.sharedextent(capacity)
        if mapped == 0ULL or mapped > mappedLimit then
            return NO_MEMORY
        end
        local remaining = mappedLimit - mapped
        if s.block ~= 0ULL then
            local current = shared.mapped(native.pointer(s.block))
            if current > remaining then
                return NO_MEMORY
            end
            remaining = remaining - current
        end
        if s.pending ~= 0ULL and shared.mapped(native.pointer(s.pending)) > remaining then
            return NO_MEMORY
        end
        local fresh = shared.create(capacity)
        if fresh == nil then
            return NO_MEMORY
        end
        local base = native.address(shared.bytes(fresh))
        zero(base, capacity)
        copy(base, s.base, s.len, stats)
        s.pending = s.block
        s.block = native.address(fresh)
        s.base = base
        s.cap = capacity
        s.generation = generation
        return bufferfinish(s)
    end
end

local function buffercapacity(s: Storage*, wanted: uint64): uint64
    @unsafe do
        local capacity = wanted
        if s.cap <= maximum() // 2ULL and capacity < s.cap * 2ULL then
            capacity = s.cap * 2ULL
        end
        if capacity < MIN_CAPACITY then
            capacity = MIN_CAPACITY
        end
        return capacity
    end
end

-- minimum is absolute advertised capacity. No initialized byte is changed.
export function bufferreserve(s: Storage*, minimum: uint64, stats: CopyStats*, mappedLimit: uint64): uint64
    @unsafe do
        if not buffervalid(s) or minimum > maximum() then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        local status = bufferfinish(s)
        if status ~= OK then
            return status
        end
        if minimum <= s.cap then
            return OK
        end
        if s.generation == MAX_GENERATION then
            return INVALID
        end
        local generation = s.generation + 1ULL
        if s.block == 0ULL then
            s.generation = generation
            s.cap = buffercapacity(s, minimum)
            return OK
        end
        return buffermove(s, buffercapacity(s, minimum), generation, stats, mappedLimit)
    end
end

-- Mint a unique prepared capability while no writer is admitted. The caller
-- may allocate and publish its owned lease after this returns. A failed
-- publication owns no active writer; a newer preparation invalidates this
-- token, so stale cleanup can never cancel a later admission.
export function bufferprepare(s: Storage*, offset: uint64, count: uint64): uint64
    @unsafe do
        if not buffervalid(s) or offset > maximum() or count > maximum() - offset or s.generation == MAX_GENERATION then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        local status = bufferfinish(s)
        if status ~= OK then
            return status
        end
        s.generation = s.generation + 1ULL
        return OK
    end
end

-- Admit the gap as well as the payload before exposing a pointer. Existing
-- tickets force a detach only for actual overlap; consumed bytes remain part
-- of initialized [0,len), and unused capacity is never copied. A zero-sized
-- lease writes neither payload nor gap, but still excludes another writer.
local function bufferwrite(
    s: Storage*,
    offset: uint64,
    count: uint64,
    stats: CopyStats*,
    mappedLimit: uint64,
    generation: uint64
): uint64
    @unsafe do
        if not buffervalid(s) or offset > maximum() or count > maximum() - offset then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        local status = bufferfinish(s)
        if status ~= OK then
            return status
        end
        local wanted = offset + count
        if count == 0ULL then
            wanted = offset
        end
        if wanted > s.cap or s.block == 0ULL then
            local capacity = s.cap
            if wanted > capacity then
                capacity = buffercapacity(s, wanted)
            end
            status = buffermove(s, capacity, generation, stats, mappedLimit)
            if status ~= OK then
                return status
            end
        end
        local first = offset
        local extent = count
        if count > 0ULL and first > s.len then
            first = s.len
            extent = wanted - first
        end
        local admission = shared.writebegin(native.pointer(s.block), first, extent)
        if admission == shared.WRITE_SHARED then
            status = buffermove(s, s.cap, generation, stats, mappedLimit)
            if status ~= OK then
                return status
            end
            admission = shared.writebegin(native.pointer(s.block), first, extent)
        end
        if admission == shared.WRITE_BUSY then
            return BUSY
        end
        if admission ~= shared.WRITE_READY then
            return INVALID
        end
        s.generation = generation
        s.writer = generation
        return OK
    end
end

-- Core-internal synchronous writes already hold all needed results and can
-- prepare/admit together. This preserves their original token behavior.
export function bufferstart(s: Storage*, offset: uint64, count: uint64, stats: CopyStats*, mappedLimit: uint64): uint64
    @unsafe do
        if s.generation == MAX_GENERATION then
            return INVALID
        end
        return bufferwrite(s, offset, count, stats, mappedLimit, s.generation + 1ULL)
    end
end

-- The managed adapter calls this only after its owned lease is complete.
-- All capability/view/token objects exist; success is followed only by the
-- nonallocating return. The immutable prepared view supplies offset/count.
-- The managed caller validates its original prepared view and consumes that
-- view's one-shot admission right on success; a numeric token alone is not
-- an admission authority.
export function bufferadmit(
    s: Storage*,
    token: uint64,
    offset: uint64,
    count: uint64,
    stats: CopyStats*,
    mappedLimit: uint64
): uint64
    @unsafe do
        if token == 0ULL or token ~= s.generation then
            return INVALID
        end
        return bufferwrite(s, offset, count, stats, mappedLimit, token)
    end
end

-- offset/reserved come from the managed, immutable admitted lease, not guest
-- arguments. The core adapter verifies its owner, generation, and bounds.
export function buffercommit(s: Storage*, token: uint64, offset: uint64, reserved: uint64, used: uint64): uint64
    @unsafe do
        if not buffervalid(s)
            or token == 0ULL
            or s.writer ~= token
            or token ~= s.generation
            or offset > s.cap
            or reserved > s.cap - offset
            or used > reserved
        then
            return INVALID
        end
        if used > 0ULL then
            if offset > s.len then
                zero(s.base + s.len, offset - s.len)
            end
            if offset + used > s.len then
                s.len = offset + used
            end
        end
        if not shared.writeend(native.pointer(s.block)) then
            return INVALID
        end
        s.writer = 0ULL
        return OK
    end
end

-- Token zero and stale tokens are harmless cleanup, including a lease whose
-- constructor failed before admission. They never cancel somebody else's IO.
export function bufferdrop(s: Storage*, token: uint64): nil
    @unsafe do
        if token ~= 0ULL and s.writer == token and s.generation == token then
            if shared.writeend(native.pointer(s.block)) then
                s.writer = 0ULL
            end
        end
    end
end

export function bufferconsume(s: Storage*, count: uint64): uint64
    @unsafe do
        if not buffervalid(s) or count > s.len - s.read then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        s.read = s.read + count
        return OK
    end
end

-- Shrink is lazy: it changes no byte. A later regrowth goes through admission
-- and checks tickets over the bytes it will actually initialize.
export function buffertruncate(s: Storage*, length: uint64): uint64
    @unsafe do
        if not buffervalid(s) or length > s.len then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        s.len = length
        if s.read > length then
            s.read = length
        end
        return OK
    end
end

export function bufferreset(s: Storage*): uint64
    @unsafe do
        if not buffervalid(s) or s.generation == MAX_GENERATION then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        local status = bufferfinish(s)
        if status ~= OK then
            return status
        end
        s.pending = s.block
        s.base = 0ULL
        s.block = 0ULL
        s.len = 0ULL
        s.read = 0ULL
        s.generation = s.generation + 1ULL
        return bufferfinish(s)
    end
end

export function bufferclose(s: Storage*): uint64
    @unsafe do
        if s.mode ~= SHARED or s.role ~= BUFFER then
            return INVALID
        end
        if s.writer ~= 0ULL then
            return BUSY
        end
        local status = bufferfinish(s)
        if status ~= OK then
            return status
        end
        if s.closed ~= 0ULL then
            return OK
        end
        s.pending = s.block
        s.block = 0ULL
        s.base = 0ULL
        s.len = 0ULL
        s.cap = 0ULL
        s.read = 0ULL
        s.closed = 1ULL
        return bufferfinish(s)
    end
end
