module nupp.runtime.core.hostepoll

-- The readiness system calls on Linux, behind hostpoll's shape: an epoll
-- set, one-shot per descriptor, and a pidfd for each child whose exit is
-- watched. A build for a Linux target takes this module where a macOS one
-- takes hostpoll; the core's compiler targets aarch64-apple-darwin alone
-- today, so this has been checked but never run. A watch's pidfd rides in
-- its event and is closed when the exit is reported; one unwatched before
-- then stays open until the program ends.
const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const strings = require("nupp.runtime.core.corestrings")
const c = require("nupp.runtime.core.hostc")

-- One epoll event, as aarch64 Linux lays it out.
cdef struct EpollEvent
    events: uint32
    data: uint64
end

cdef function epoll_create1(flags: int64): int32
cdef function epoll_ctl(epoll: int64, op: int64, fd: int64, borrows event: voidptr): int32
cdef function epoll_wait(epoll: int64, borrows events: voidptr, room: int64, millis: int64): int32
cdef function syscall(number: int64, ...): int64
cdef function close(fd: int64): int32

-- Interest and readiness, as pollcalls encodes them.
const READABLE: uint64 = 1ULL
const WRITABLE: uint64 = 2ULL
const HANGUP: uint64 = 4ULL
const FAILED: uint64 = 8ULL
const EXITED: uint64 = 16ULL
const EVENT_BITS: uint64 = 5ULL
const FOREVER: uint64 = 0xffffffffffffffffULL
const NANOS_PER_MILLI: uint64 = 1000000ULL
const MILLIS_LIMIT: uint64 = 0x7fffffffULL
-- An exit's event data: this bit, the pidfd above PIDFD_SHIFT, the pid below.
const PROCESS: uint64 = 0x8000000000000000ULL
const PIDFD_SHIFT: uint64 = 32ULL
const PID_MASK: uint64 = 0xffffffffULL
const PIDFD_MASK: uint64 = 0x7fffffffULL

-- The C library's, on Linux.
const EPOLL_CLOEXEC: int64 = 0x80000
const EPOLL_CTL_ADD: int64 = 1
const EPOLL_CTL_DEL: int64 = 2
const EPOLL_CTL_MOD: int64 = 3
const EPOLLIN: uint64 = 0x1ULL
const EPOLLOUT: uint64 = 0x4ULL
const EPOLLERR: uint64 = 0x8ULL
const EPOLLHUP: uint64 = 0x10ULL
const EPOLLRDHUP: uint64 = 0x2000ULL
const EPOLLONESHOT: uint64 = 0x40000000ULL
const ENOENT: int64 = 2
const SYS_PIDFD_OPEN: int64 = 434

-- Room for one event in builder `b`: its address, valid until `b` grows.
local function room(h: heap.Heap*, borrows b: strings.Builder*): uint64
    @unsafe do
        if strings.reserve(h, b, native.sizeOf<EpollEvent>()) ~= 0ULL then
            error("not enough memory")
        end

        return strings.descriptor(b).base
    end
end

-- Registers `target` with `events` and `data`, modifying it when it is
-- registered already: 0.
local function register(h: heap.Heap*, epoll: uint64, target: int64, events: uint64, data: uint64): int64
    local state = strings.Builder(0ULL, 0ULL)
    @unsafe do
        local lifetime = strings.open(h, state as strings.Builder*)
        local event = native.pointer(room(h, lifetime))
        native.store32(event, native.fieldOffset<EpollEvent>("events"), native.index(events))
        native.store64(event, native.fieldOffset<EpollEvent>("data"), data)
        local modified: int64 = epoll_ctl(native.index(epoll), EPOLL_CTL_MOD, target, event)
        if modified == 0 then
            return 0
        end
        if c.failure() ~= 0 - ENOENT then
            return c.failure()
        end
        local added: int64 = epoll_ctl(native.index(epoll), EPOLL_CTL_ADD, target, event)
        if added ~= 0 then
            return c.failure()
        end

        return 0
    end
end

-- A new poller's descriptor, not inherited across exec.
export function open(): int64
    local epoll: int64 = epoll_create1(EPOLL_CLOEXEC)
    if epoll < 0 then
        return c.failure()
    end

    return epoll
end

-- Sets the readiness `poller` waits for on `fd` to `interest`, one-shot for
-- the whole descriptor: 0.
export function arm(h: heap.Heap*, poller: uint64, fd: uint64, interest: uint64): int64
    if (interest & (READABLE | WRITABLE)) == 0ULL then
        local removed: int64 = epoll_ctl(native.index(poller), EPOLL_CTL_DEL, native.index(fd), native.pointer(0ULL))
        if removed == 0 or c.failure() == 0 - ENOENT then
            return 0
        end
        return c.failure()
    end
    local events = EPOLLONESHOT | EPOLLRDHUP
    if (interest & READABLE) ~= 0ULL then
        events = events | EPOLLIN
    end
    if (interest & WRITABLE) ~= 0ULL then
        events = events | EPOLLOUT
    end

    return register(h, poller, native.index(fd), events, fd)
end

-- Has `poller` report child `pid`'s exit once, as its pidfd turning readable.
export function watch(h: heap.Heap*, poller: uint64, pid: uint64): int64
    local pidfd = syscall(SYS_PIDFD_OPEN, native.index(pid), 0)
    if pidfd < 0 then
        return c.failure()
    end
    local data = PROCESS | (native.word(pidfd) & PIDFD_MASK) << PIDFD_SHIFT | (pid & PID_MASK)
    local status = register(h, poller, pidfd, EPOLLIN | EPOLLONESHOT, data)
    if status ~= 0 then
        local _: int64 = close(pidfd)
    end

    return status
end

-- Stops watching child `pid`'s exit. Its pidfd closes when the exit is
-- reported, so there is nothing to remove here: 0.
export function unwatch(h: heap.Heap*, poller: uint64, pid: uint64): int64
    local _ = h
    local _ = poller
    local _ = pid

    return 0
end

-- Waits at most `nanos` nanoseconds (all ones: without limit), rounded up
-- to milliseconds, for one event, as hostpoll.wait answers it.
export function wait(h: heap.Heap*, poller: uint64, nanos: uint64): int64
    local state = strings.Builder(0ULL, 0ULL)
    local events: uint64 = 0ULL
    local data: uint64 = 0ULL
    local millis: int64 = -1
    if nanos ~= FOREVER then
        local rounded = (nanos + NANOS_PER_MILLI - 1ULL) // NANOS_PER_MILLI
        if rounded > MILLIS_LIMIT then
            rounded = MILLIS_LIMIT
        end
        millis = native.index(rounded)
    end
    @unsafe do
        local lifetime = strings.open(h, state as strings.Builder*)
        local event = native.pointer(room(h, lifetime))
        local count: int64 = epoll_wait(native.index(poller), event, 1, millis)
        if count < 0 then
            if c.interrupted() then
                return 0
            end
            return c.failure()
        end
        if count == 0 then
            return 0
        end
        events = native.word(native.load32(event, native.fieldOffset<EpollEvent>("events")))
        data = native.load64(event, native.fieldOffset<EpollEvent>("data"))
    end
    if (data & PROCESS) ~= 0ULL then
        local _: int64 = close(native.index((data >> PIDFD_SHIFT) & PIDFD_MASK))
        return native.index((data & PID_MASK) << EVENT_BITS | EXITED)
    end
    local bits: uint64 = 0ULL
    if (events & EPOLLIN) ~= 0ULL then
        bits = bits | READABLE
    end
    if (events & EPOLLOUT) ~= 0ULL then
        bits = bits | WRITABLE
    end
    if (events & (EPOLLHUP | EPOLLRDHUP)) ~= 0ULL then
        bits = bits | HANGUP
    end
    if (events & EPOLLERR) ~= 0ULL then
        bits = bits | FAILED
    end

    return native.index(data << EVENT_BITS | bits)
end
