    elseif id == 88ULL then
        -- "dead"
        return strings.appendWord(h, b, 0x64616564ULL, 4ULL)
    elseif id == 89ULL then
        -- "cannot resume dead coroutine"
        return strings.appendWord(h, b, 0x7220746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x656420656d757365ULL, 8ULL)
            | strings.appendWord(h, b, 0x756f726f63206461ULL, 8ULL)
            | strings.appendWord(h, b, 0x656e6974ULL, 4ULL)
    elseif id == 90ULL then
        -- "cannot resume non-suspended coroutine"
        return strings.appendWord(h, b, 0x7220746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f6e20656d757365ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e65707375732d6eULL, 8ULL)
            | strings.appendWord(h, b, 0x6f726f6320646564ULL, 8ULL)
            | strings.appendWord(h, b, 0x656e697475ULL, 5ULL)
    elseif id == 91ULL then
        -- "attempt to yield from outside a coroutine"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x646c656979206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x756f206d6f726620ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061206564697374ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e6974756f726f63ULL, 8ULL)
            | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == 92ULL then
        -- "coroutine"
        return strings.appendWord(h, b, 0x6e6974756f726f63ULL, 8ULL) | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == 93ULL then
        -- "create"
        return strings.appendWord(h, b, 0x657461657263ULL, 6ULL)
    elseif id == 94ULL then
        -- "resume"
        return strings.appendWord(h, b, 0x656d75736572ULL, 6ULL)
    elseif id == 95ULL then
        -- "yield"
        return strings.appendWord(h, b, 0x646c656979ULL, 5ULL)
    elseif id == 96ULL then
        -- "status"
        return strings.appendWord(h, b, 0x737574617473ULL, 6ULL)
    elseif id == 97ULL then
        -- "wrap"
        return strings.appendWord(h, b, 0x70617277ULL, 4ULL)
    elseif id == 98ULL then
        -- "isyieldable"
        return strings.appendWord(h, b, 0x61646c6569797369ULL, 8ULL) | strings.appendWord(h, b, 0x656c62ULL, 3ULL)
    elseif id == 99ULL then
        -- "function"
        return strings.appendWord(h, b, 0x6e6f6974636e7566ULL, 8ULL)
    elseif id == 100ULL then
        -- "cannot close main thread"
        return strings.appendWord(h, b, 0x6320746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x69616d2065736f6cULL, 8ULL)
            | strings.appendWord(h, b, 0x646165726874206eULL, 8ULL)
    elseif id == 101ULL then
        -- "cannot close a normal coroutine"
        return strings.appendWord(h, b, 0x6320746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e20612065736f6cULL, 8ULL)
            | strings.appendWord(h, b, 0x6f63206c616d726fULL, 8ULL)
            | strings.appendWord(h, b, 0x656e6974756f72ULL, 7ULL)
    elseif id == 102ULL then
        -- "close"
        return strings.appendWord(h, b, 0x65736f6c63ULL, 5ULL)
    elseif id == 104ULL then
        -- "stack overflow"
        return strings.appendWord(h, b, 0x766f206b63617473ULL, 8ULL) | strings.appendWord(h, b, 0x776f6c667265ULL, 6ULL)
    elseif id == 105ULL then
        -- "object length is not an integer"
        return strings.appendWord(h, b, 0x6c207463656a626fULL, 8ULL)
            | strings.appendWord(h, b, 0x7369206874676e65ULL, 8ULL)
            | strings.appendWord(h, b, 0x206e6120746f6e20ULL, 8ULL)
            | strings.appendWord(h, b, 0x72656765746e69ULL, 7ULL)
    elseif id == 106ULL then
        -- "attempt to yield across a C-call boundary"
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x646c656979206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2073736f72636120ULL, 8ULL)
            | strings.appendWord(h, b, 0x6c6c61632d432061ULL, 8ULL)
            | strings.appendWord(h, b, 0x7261646e756f6220ULL, 8ULL)
            | strings.appendWord(h, b, 0x79ULL, 1ULL)
    elseif id == 107ULL then
        -- "require"
        return strings.appendWord(h, b, 0x65726975716572ULL, 7ULL)
    elseif id == 108ULL then
        -- "assertion failed!"
        return strings.appendWord(h, b, 0x6f69747265737361ULL, 8ULL)
            | strings.appendWord(h, b, 0x64656c696166206eULL, 8ULL)
            | strings.appendWord(h, b, 0x21ULL, 1ULL)
    elseif id == 109ULL then
        -- "number expected"
        return strings.appendWord(h, b, 0x65207265626d756eULL, 8ULL)
            | strings.appendWord(h, b, 0x64657463657078ULL, 7ULL)
    elseif id == 110ULL then
        -- "storage"
        return strings.appendWord(h, b, 0x656761726f7473ULL, 7ULL)
    elseif id == 111ULL then
        -- "base out of range"
        return strings.appendWord(h, b, 0x74756f2065736162ULL, 8ULL)
            | strings.appendWord(h, b, 0x676e617220666f20ULL, 8ULL)
            | strings.appendWord(h, b, 0x65ULL, 1ULL)
    elseif id == 112ULL then
        -- "bad 'for' limit (number expected, got "
        return strings.appendWord(h, b, 0x726f662720646162ULL, 8ULL)
            | strings.appendWord(h, b, 0x2074696d696c2027ULL, 8ULL)
            | strings.appendWord(h, b, 0x207265626d756e28ULL, 8ULL)
            | strings.appendWord(h, b, 0x6465746365707865ULL, 8ULL)
            | strings.appendWord(h, b, 0x20746f67202cULL, 6ULL)
    elseif id == 113ULL then
        -- "table has a protected metatable"
        return strings.appendWord(h, b, 0x616820656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x746f727020612073ULL, 8ULL)
            | strings.appendWord(h, b, 0x656d206465746365ULL, 8ULL)
            | strings.appendWord(h, b, 0x656c6261746174ULL, 7ULL)
    elseif id == 114ULL then
        -- "freeze"
        return strings.appendWord(h, b, 0x657a65657266ULL, 6ULL)
    elseif id == 115ULL then
        -- "isfrozen"
        return strings.appendWord(h, b, 0x6e657a6f72667369ULL, 8ULL)
    elseif id == 116ULL then
        -- "table is already frozen"
        return strings.appendWord(h, b, 0x736920656c626174ULL, 8ULL)
            | strings.appendWord(h, b, 0x79646165726c6120ULL, 8ULL)
            | strings.appendWord(h, b, 0x6e657a6f726620ULL, 7ULL)
    elseif id == 117ULL then
        -- "invalid option '"
        return strings.appendWord(h, b, 0x2064696c61766e69ULL, 8ULL)
            | strings.appendWord(h, b, 0x27206e6f6974706fULL, 8ULL)
    elseif id == 118ULL then
        -- "collectgarbage"
        return strings.appendWord(h, b, 0x677463656c6c6f63ULL, 8ULL) | strings.appendWord(h, b, 0x656761627261ULL, 6ULL)
    elseif id == 119ULL then
        -- "parked"
        return strings.appendWord(h, b, 0x64656b726170ULL, 6ULL)
    elseif id == 120ULL then
        -- "cannot resume a scheduled coroutine"
        return strings.appendWord(h, b, 0x7220746f6e6e6163ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120656d757365ULL, 8ULL)
            | strings.appendWord(h, b, 0x656c756465686373ULL, 8ULL)
            | strings.appendWord(h, b, 0x74756f726f632064ULL, 8ULL)
            | strings.appendWord(h, b, 0x656e69ULL, 3ULL)
    elseif id == 121ULL then
        -- "(error object is a "
        return strings.appendWord(h, b, 0x6f20726f72726528ULL, 8ULL)
            | strings.appendWord(h, b, 0x7369207463656a62ULL, 8ULL)
            | strings.appendWord(h, b, 0x206120ULL, 3ULL)
    elseif id == 122ULL then
        -- " value"
        return strings.appendWord(h, b, 0x65756c617620ULL, 6ULL)
    elseif id == 123ULL then
        -- "__gc"
        return strings.appendWord(h, b, 0x63675f5fULL, 4ULL)
    elseif id == 124ULL then
        -- "__mode"
        return strings.appendWord(h, b, 0x65646f6d5f5fULL, 6ULL)
    elseif id == 125ULL then
        -- "warn warn: "
        return strings.appendWord(h, b, 0x726177206e726177ULL, 8ULL) | strings.appendWord(h, b, 0x203a6eULL, 3ULL)
    elseif id == 126ULL then
        -- "error in __gc ("
        return strings.appendWord(h, b, 0x6e6920726f727265ULL, 8ULL)
            | strings.appendWord(h, b, 0x282063675f5f20ULL, 7ULL)
    elseif id == 127ULL then
        -- "error object is not a string"
        return strings.appendWord(h, b, 0x626f20726f727265ULL, 8ULL)
            | strings.appendWord(h, b, 0x207369207463656aULL, 8ULL)
            | strings.appendWord(h, b, 0x7473206120746f6eULL, 8ULL)
            | strings.appendWord(h, b, 0x676e6972ULL, 4ULL)
    elseif id == 128ULL then
        -- "attempt to call a "
        return strings.appendWord(h, b, 0x2074706d65747461ULL, 8ULL)
            | strings.appendWord(h, b, 0x206c6c6163206f74ULL, 8ULL)
            | strings.appendWord(h, b, 0x2061ULL, 2ULL)
    elseif id == 144ULL then
        -- " (metamethod '__gc')"
        return strings.appendWord(h, b, 0x656d6174656d2820ULL, 8ULL)
            | strings.appendWord(h, b, 0x5f5f2720646f6874ULL, 8ULL)
            | strings.appendWord(h, b, 0x29276367ULL, 4ULL)
    elseif id == 129ULL then
        -- "collect"
        return strings.appendWord(h, b, 0x7463656c6c6f63ULL, 7ULL)
    elseif id == 130ULL then
        -- "stop"
        return strings.appendWord(h, b, 0x706f7473ULL, 4ULL)
    elseif id == 131ULL then
        -- "restart"
        return strings.appendWord(h, b, 0x74726174736572ULL, 7ULL)
    elseif id == 132ULL then
        -- "count"
        return strings.appendWord(h, b, 0x746e756f63ULL, 5ULL)
    elseif id == 133ULL then
        -- "step"
        return strings.appendWord(h, b, 0x70657473ULL, 4ULL)
    elseif id == 134ULL then
        -- "isrunning"
        return strings.appendWord(h, b, 0x6e696e6e75727369ULL, 8ULL) | strings.appendWord(h, b, 0x67ULL, 1ULL)
    elseif id == 135ULL then
        -- "generational"
        return strings.appendWord(h, b, 0x69746172656e6567ULL, 8ULL) | strings.appendWord(h, b, 0x6c616e6fULL, 4ULL)
    elseif id == 136ULL then
        -- "incremental"
        return strings.appendWord(h, b, 0x6e656d6572636e69ULL, 8ULL) | strings.appendWord(h, b, 0x6c6174ULL, 3ULL)
    elseif id == 137ULL then
        -- "param"
        return strings.appendWord(h, b, 0x6d61726170ULL, 5ULL)
    elseif id == 138ULL then
        -- "minormul"
        return strings.appendWord(h, b, 0x6c756d726f6e696dULL, 8ULL)
    elseif id == 139ULL then
        -- "majorminor"
        return strings.appendWord(h, b, 0x6e696d726f6a616dULL, 8ULL) | strings.appendWord(h, b, 0x726fULL, 2ULL)
    elseif id == 140ULL then
        -- "minormajor"
        return strings.appendWord(h, b, 0x6a616d726f6e696dULL, 8ULL) | strings.appendWord(h, b, 0x726fULL, 2ULL)
    elseif id == 141ULL then
        -- "pause"
        return strings.appendWord(h, b, 0x6573756170ULL, 5ULL)
    elseif id == 142ULL then
        -- "stepmul"
        return strings.appendWord(h, b, 0x6c756d70657473ULL, 7ULL)
    elseif id == 143ULL then
        -- "stepsize"
        return strings.appendWord(h, b, 0x657a697370657473ULL, 8ULL)
    elseif id == 145ULL then
        -- "writable storage"
        return strings.appendWord(h, b, 0x656c626174697277ULL, 8ULL)
            | strings.appendWord(h, b, 0x656761726f747320ULL, 8ULL)
    elseif id == 146ULL then
        -- "secure random source failed: "
        return strings.appendWord(h, b, 0x7220657275636573ULL, 8ULL)
            | strings.appendWord(h, b, 0x6f73206d6f646e61ULL, 8ULL)
            | strings.appendWord(h, b, 0x6961662065637275ULL, 8ULL)
            | strings.appendWord(h, b, 0x203a64656cULL, 5ULL)
    elseif id == 147ULL then
        -- "'__call' chain too long"
        return strings.appendWord(h, b, 0x276c6c61635f5f27ULL, 8ULL)
            | strings.appendWord(h, b, 0x74206e6961686320ULL, 8ULL)
            | strings.appendWord(h, b, 0x676e6f6c206f6fULL, 7ULL)
    elseif id == 148ULL then
        -- "main"
        return strings.appendWord(h, b, 0x6e69616dULL, 4ULL)
    elseif id == 149ULL then
        -- "Lua"
        return strings.appendWord(h, b, 0x61754cULL, 3ULL)
    elseif id == 150ULL then
        -- "C"
        return strings.appendWord(h, b, 0x43ULL, 1ULL)
    elseif id == 151ULL then
        -- "=[C]"
        return strings.appendWord(h, b, 0x5d435b3dULL, 4ULL)
    elseif id == 152ULL then
        -- "[C]"
        return strings.appendWord(h, b, 0x5d435bULL, 3ULL)
    elseif id == 153ULL then
        -- "global"
        return strings.appendWord(h, b, 0x6c61626f6c67ULL, 6ULL)
    elseif id == 154ULL then
        -- "local"
        return strings.appendWord(h, b, 0x6c61636f6cULL, 5ULL)
    elseif id == 155ULL then
        -- "method"
        return strings.appendWord(h, b, 0x646f6874656dULL, 6ULL)
    elseif id == 156ULL then
        -- "field"
        return strings.appendWord(h, b, 0x646c656966ULL, 5ULL)
    elseif id == 157ULL then
        -- "upvalue"
        return strings.appendWord(h, b, 0x65756c61767075ULL, 7ULL)
    elseif id == 158ULL then
        -- "for iterator"
        return strings.appendWord(h, b, 0x7265746920726f66ULL, 8ULL) | strings.appendWord(h, b, 0x726f7461ULL, 4ULL)
    elseif id == 159ULL then
        -- "boolean"
        return strings.appendWord(h, b, 0x6e61656c6f6f62ULL, 7ULL)
    elseif id == 160ULL then
        -- "nil"
        return strings.appendWord(h, b, 0x6c696eULL, 3ULL)
    end

    return 0ULL
end
