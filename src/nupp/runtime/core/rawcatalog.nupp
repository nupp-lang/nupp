module nupp.runtime.core.rawcatalog

const native = require("nupp.runtime.vm.intrinsics")
const shape = require("nupp.runtime.core.rawshape")
const header = require("nupp.runtime.core.rawheader")
const wire = require("nupp.runtime.core.rawwire")
const fields = require("nupp.runtime.core.rawroles")
const policy = require("nupp.runtime.core.rawcatalogpolicy")

-- Phase 3 is bounded catalog metadata validity only. Borrowed immutable input
-- remains caller-owned; this does not prove SSA, scalar values or execution.
--
-- The catalog maps, in order: a bitmap of used signatures, a bitmap of used
-- contracts and one of claimed callsite identities, then the call graph in
-- compressed rows (an offset per owner plus one, and a target per call edge,
-- at most one edge per contract record), each owner's in-degree, the ready
-- queue, and a bitmap of owners whose lexical parents reach the entry. All
-- linear in owners and records, never in owners squared.
local function catalogBytes(): uint64
    return (
        policy.signatures >> 3ULL
    ) + (
        policy.calls >> 2ULL
    ) + (policy.owners + 1ULL) * 8ULL + wire.recordsLimit * 8ULL + policy.owners * 16ULL + (policy.owners >> 3ULL)
end

export function workspaceBytes(records: uint64, strings: uint64): uint64
    local shaped = shape.workspaceBytes(records, strings)
    if shaped == 0ULL then
        return 0ULL
    end
    local catalog = catalogBytes()
    if shaped < catalog then
        shaped = catalog
    end

    return native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>() + shaped
end

local function count(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("count")
    )
end

local function row(descriptor: voidptr, section: uint64, index: uint64, offset: uint64): uint64
    local address = native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("data")
    )

    return native.word(native.load32(native.pointer(address), native.index(index * wire.stride(section) + offset)))
        & fields.absent
end

local function marked(bits: voidptr, id: uint64): uint64
    return native.load64(bits, native.index((id >> 6ULL) * 8ULL)) & (1ULL << (id & 63ULL))
end

local function mark(bits: voidptr, id: uint64): uint64
    local at, mask = (id >> 6ULL) * 8ULL, 1ULL << (id & 63ULL)
    local previous = native.load64(bits, native.index(at))
    native.store64(bits, native.index(at), previous | mask)
    if (previous & mask) ~= 0ULL then
        return 0ULL
    end

    return 1ULL
end

local function signatures(descriptor: voidptr, used: voidptr): uint64
    local index = 0ULL
    while index < count(descriptor, wire.S_signatures) do
        if row(descriptor, wire.S_signatures, index, fields.F_signatures_id) ~= index
            or marked(used, index) == 0ULL
        then
            return 0ULL
        end
        local first = row(descriptor, wire.S_signatures, index, fields.F_signatures_paramsFirst)
        local length = row(descriptor, wire.S_signatures, index, fields.F_signatures_paramsCount)
        local at = 0ULL
        while at < length do
            if row(descriptor, wire.S_words, first + at, fields.F_words_value) >= policy.scalarKinds then
                return 0ULL
            end
            at = at + 1ULL
        end
        index = index + 1ULL
    end

    return 1ULL
end

-- `rooted` marks the owners whose lexical parents are known to reach the
-- entry initializer, so each walk stops at the first one and every owner is
-- walked once: linear in owners, however deep the nesting.
local function owner(descriptor: voidptr, index: uint64, used: voidptr, rooted: voidptr): uint64
    local entry = native.load64(descriptor, native.fieldOffset<header.Descriptor>("entry"))
    local signature = row(descriptor, wire.S_catalog, index, fields.F_catalog_signature)
    if row(descriptor, wire.S_catalog, index, fields.F_catalog_id) ~= index
        or row(descriptor, wire.S_catalog, index, fields.F_catalog_graph) ~= index
    then
        return 0ULL
    end
    if marked(used, signature) == 0ULL then
        if mark(used, signature) == 0ULL then
            return 0ULL
        end
    end
    local kind = row(descriptor, wire.S_catalog, index, fields.F_catalog_kind)
    local signatureKind = row(descriptor, wire.S_signatures, signature, fields.F_signatures_kind)
    if kind == policy.Owner_module then
        if index ~= entry
            or row(descriptor, wire.S_catalog, index, fields.F_catalog_parent) ~= fields.absent
            or signatureKind ~= policy.Signature_initializer
            or row(descriptor, wire.S_signatures, signature, fields.F_signatures_paramsCount) ~= 0ULL
        then
            return 0ULL
        end
    else
        if kind ~= policy.Owner_function or signatureKind ~= policy.Signature_callable then
            return 0ULL
        end
        local ancestor, remaining = index, count(descriptor, wire.S_catalog)
        while marked(rooted, ancestor) == 0ULL
            and row(descriptor, wire.S_catalog, ancestor, fields.F_catalog_kind) ~= policy.Owner_module do
            if remaining == 0ULL then
                return 0ULL
            end
            remaining = remaining - 1ULL
            ancestor = row(descriptor, wire.S_catalog, ancestor, fields.F_catalog_parent)
            if ancestor >= count(descriptor, wire.S_catalog) then
                return 0ULL
            end
        end
        if marked(rooted, ancestor) == 0ULL and ancestor ~= entry then
            return 0ULL
        end
        local at = index
        while at ~= ancestor do
            mark(rooted, at)
            at = row(descriptor, wire.S_catalog, at, fields.F_catalog_parent)
        end
    end

    return 1ULL
end

local function graphShape(descriptor: voidptr, index: uint64): uint64
    local params = row(descriptor, wire.S_graphs, index, fields.F_graphs_nparams)
    local signature = row(descriptor, wire.S_catalog, index, fields.F_catalog_signature)
    if params > policy.parameters
        or params ~= row(descriptor, wire.S_signatures, signature, fields.F_signatures_paramsCount)
        or row(descriptor, wire.S_graphs, index, fields.F_graphs_owner) ~= index
        or row(descriptor, wire.S_graphs, index, fields.F_graphs_nv) > policy.values
        or row(descriptor, wire.S_graphs, index, fields.F_graphs_ni) ~= 0ULL
        or row(descriptor, wire.S_graphs, index, fields.F_graphs_nf) ~= 0ULL
        or row(descriptor, wire.S_graphs, index, fields.F_graphs_nx) ~= 0ULL
    then
        return 0ULL
    end
    local name = row(descriptor, wire.S_graphs, index, fields.F_graphs_name)
    local moduleName = row(descriptor, wire.S_graphs, index, fields.F_graphs_module)
    local path = row(descriptor, wire.S_graphs, index, fields.F_graphs_path)
    if moduleName ~= row(descriptor, wire.S_modules, 0ULL, fields.F_modules_name)
        or path ~= row(descriptor, wire.S_modules, 0ULL, fields.F_modules_path)
    then
        return 0ULL
    end
    local source = row(descriptor, wire.S_graphs, index, fields.F_graphs_source)
    if source ~= fields.absent then
        if name ~= row(descriptor, wire.S_sourceBindings, source, fields.F_sourceBindings_name)
            or moduleName ~= row(descriptor, wire.S_sourceBindings, source, fields.F_sourceBindings_module)
            or path ~= row(descriptor, wire.S_sourceBindings, source, fields.F_sourceBindings_path)
        then
            return 0ULL
        end
    end
    local first = row(descriptor, wire.S_graphs, index, fields.F_graphs_positionsFirst)
    local length = row(descriptor, wire.S_graphs, index, fields.F_graphs_positionsCount)
    local at = 0ULL
    while at < length do
        if row(descriptor, wire.S_positions, first + at, fields.F_positions_line) == 0ULL
            or row(descriptor, wire.S_positions, first + at, fields.F_positions_column) == 0ULL
        then
            return 0ULL
        end
        at = at + 1ULL
    end

    return 1ULL
end

local function operations(descriptor: voidptr, block: uint64, ownerId: uint64, positions: uint64): uint64
    local first = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsFirst)
    local length = row(descriptor, wire.S_blocks, block, fields.F_blocks_opsCount)
    local at, effect = 0ULL, policy.pureEffect
    while at < length do
        local opcode = row(descriptor, wire.S_operations, first + at, fields.F_operations_opcode)
        local rule = policy.operation(opcode)
        if row(descriptor, wire.S_operations, first + at, fields.F_operations_argsCount) ~= (rule >> 8ULL)
            or row(descriptor, wire.S_operations, first + at, fields.F_operations_pos) > positions
        then
            return fields.absent
        end
        if opcode == policy.Operation_Closure then
            local args = row(descriptor, wire.S_operations, first + at, fields.F_operations_argsFirst)
            local target = row(descriptor, wire.S_words, args, fields.F_words_value)
            if target >= count(descriptor, wire.S_catalog)
                or row(descriptor, wire.S_catalog, target, fields.F_catalog_kind) ~= policy.Owner_function
                or row(descriptor, wire.S_catalog, target, fields.F_catalog_parent) ~= ownerId
            then
                return fields.absent
            end
        end
        if (rule & 255ULL) > effect then
            effect = rule & 255ULL
        end
        at = at + 1ULL
    end

    return effect
end

local function termShape(descriptor: voidptr, term: uint64, positions: uint64): uint64
    local kind = row(descriptor, wire.S_terms, term, fields.F_terms_kind)
    local position = row(descriptor, wire.S_terms, term, fields.F_terms_pos)
    if position ~= fields.absent and position > positions then
        return 0ULL
    end
    if row(descriptor, wire.S_terms, term, fields.F_terms_edgesCount) ~= (policy.term(kind) >> 8ULL) then
        return 0ULL
    end
    if kind == policy.Term_invoke then
        if row(descriptor, wire.S_terms, term, fields.F_terms_value) ~= fields.absent then
            return 0ULL
        end
    else
        if row(descriptor, wire.S_terms, term, fields.F_terms_callee) ~= fields.absent
            or row(descriptor, wire.S_terms, term, fields.F_terms_result) ~= fields.absent
            or row(descriptor, wire.S_terms, term, fields.F_terms_contract) ~= fields.absent
            or row(descriptor, wire.S_terms, term, fields.F_terms_argsFirst) ~= 0ULL
            or row(descriptor, wire.S_terms, term, fields.F_terms_argsCount) ~= 0ULL
        then
            return 0ULL
        end
        if kind == policy.Term_jump and row(descriptor, wire.S_terms, term, fields.F_terms_value) ~= fields.absent then
            return 0ULL
        end
    end
    local first = row(descriptor, wire.S_terms, term, fields.F_terms_edgesFirst)
    local length = row(descriptor, wire.S_terms, term, fields.F_terms_edgesCount)
    local at = 0ULL
    while at < length do
        if row(descriptor, wire.S_edges, first + at, fields.F_edges_target) > policy.blocks then
            return 0ULL
        end
        at = at + 1ULL
    end

    return 1ULL
end

-- The callee owner of a well-formed invoke, or `fields.absent`.
local function invoke(descriptor: voidptr, term: uint64, ownerId: uint64, blockId: uint64, used: voidptr): uint64
    local id = row(descriptor, wire.S_terms, term, fields.F_terms_contract)
    if id >= count(descriptor, wire.S_contracts) then
        return fields.absent
    end
    if mark(used, id) == 0ULL
        or row(descriptor, wire.S_contracts, id, fields.F_contracts_owner) ~= ownerId
        or row(descriptor, wire.S_contracts, id, fields.F_contracts_block) ~= blockId
    then
        return fields.absent
    end
    local target = row(descriptor, wire.S_contracts, id, fields.F_contracts_target)
    local signature = row(descriptor, wire.S_contracts, id, fields.F_contracts_signature)
    if row(descriptor, wire.S_catalog, target, fields.F_catalog_kind) ~= policy.Owner_function
        or signature ~= row(descriptor, wire.S_catalog, target, fields.F_catalog_signature)
        or row(
            descriptor,
            wire.S_terms,
            term,
            fields.F_terms_argsCount
        ) ~= row(descriptor, wire.S_signatures, signature, fields.F_signatures_paramsCount)
    then
        return fields.absent
    end

    return target
end

-- Owners are scanned in order, so the call edges arrive grouped by caller:
-- each owner's offset is the edge count before its scan. Every edge consumes
-- a distinct contract, which bounds the edges by the contract records.
local function graphs(descriptor: voidptr, used: voidptr, offsets: voidptr, targets: voidptr, degree: voidptr): uint64
    local index, edges = 0ULL, 0ULL
    while index < count(descriptor, wire.S_catalog) do
        native.store64(offsets, native.index(index * 8ULL), edges)
        if graphShape(descriptor, index) == 0ULL then
            return 0ULL
        end
        local first = row(descriptor, wire.S_graphs, index, fields.F_graphs_blocksFirst)
        local length = row(descriptor, wire.S_graphs, index, fields.F_graphs_blocksCount)
        local positions = row(descriptor, wire.S_graphs, index, fields.F_graphs_positionsCount)
        local at, effect = 0ULL, policy.pureEffect
        while at < length do
            local block = first + at
            if row(descriptor, wire.S_blocks, block, fields.F_blocks_id) ~= at + 1ULL then
                return 0ULL
            end
            local current = operations(descriptor, block, index, positions)
            if current == fields.absent then
                return 0ULL
            end
            if current > effect then
                effect = current
            end
            local term = row(descriptor, wire.S_blocks, block, fields.F_blocks_term)
            if termShape(descriptor, term, positions) == 0ULL then
                return 0ULL
            end
            if row(descriptor, wire.S_terms, term, fields.F_terms_kind) == policy.Term_invoke then
                local target = invoke(descriptor, term, index, at + 1ULL, used)
                if target == fields.absent or edges >= wire.recordsLimit then
                    return 0ULL
                end
                native.store64(targets, native.index(edges * 8ULL), target)
                edges = edges + 1ULL
                local slot = native.index(target * 8ULL)
                native.store64(degree, slot, native.load64(degree, slot) + 1ULL)
                effect = policy.invokeEffect
            end
            at = at + 1ULL
        end
        if row(descriptor, wire.S_catalog, index, fields.F_catalog_effect) ~= effect then
            return 0ULL
        end
        index = index + 1ULL
    end
    native.store64(offsets, native.index(index * 8ULL), edges)

    return 1ULL
end

local function contracts(descriptor: voidptr, used: voidptr, sites: voidptr): uint64
    local index = 0ULL
    while index < count(descriptor, wire.S_contracts) do
        local site = row(descriptor, wire.S_contracts, index, fields.F_contracts_callsite)
        if row(descriptor, wire.S_contracts, index, fields.F_contracts_id) ~= index
            or marked(used, index) == 0ULL
            or site >= policy.calls
            or row(descriptor, wire.S_contracts, index, fields.F_contracts_effect) ~= policy.invokeEffect
        then
            return 0ULL
        end
        if mark(sites, site) == 0ULL then
            return 0ULL
        end
        index = index + 1ULL
    end

    return 1ULL
end

-- Exported for the catalog units, which run it on call graphs of their own.
export function acyclic(offsets: voidptr, targets: voidptr, degree: voidptr, queue: voidptr, owners: uint64): uint64
    -- Kahn's algorithm over the compressed rows: every edge, repeated calls
    -- included, is counted into degree once and released once, so the work is
    -- linear in owners and edges.
    local ready, index = 0ULL, 0ULL
    while index < owners do
        if native.load64(degree, native.index(index * 8ULL)) == 0ULL then
            native.store64(queue, native.index(ready * 8ULL), index)
            ready = ready + 1ULL
        end
        index = index + 1ULL
    end
    index = 0ULL
    while index < ready do
        local from = native.load64(queue, native.index(index * 8ULL))
        local edge = native.load64(offsets, native.index(from * 8ULL))
        local last = native.load64(offsets, native.index((from + 1ULL) * 8ULL))
        while edge < last do
            local target = native.load64(targets, native.index(edge * 8ULL))
            local at = native.index(target * 8ULL)
            local previous = native.load64(degree, at)
            if previous == 0ULL then
                return 0ULL
            end
            native.store64(degree, at, previous - 1ULL)
            if previous == 1ULL then
                if ready >= owners then
                    return 0ULL
                end
                native.store64(queue, native.index(ready * 8ULL), target)
                ready = ready + 1ULL
            end
            edge = edge + 1ULL
        end
        index = index + 1ULL
    end
    if ready ~= owners then
        return 0ULL
    end

    return 1ULL
end

local function catalog(descriptor: voidptr, work: voidptr): uint64
    local owners = count(descriptor, wire.S_catalog)
    local entry = native.load64(descriptor, native.fieldOffset<header.Descriptor>("entry"))
    if owners == 0ULL
        or owners > policy.owners
        or count(descriptor, wire.S_graphs) ~= owners
        or count(descriptor, wire.S_signatures) > policy.signatures
        or count(descriptor, wire.S_contracts) > policy.calls
        or count(descriptor, wire.S_modules) ~= 1ULL
        or row(descriptor, wire.S_modules, 0ULL, fields.F_modules_chunk) ~= entry
        or row(descriptor, wire.S_catalog, entry, fields.F_catalog_kind) ~= policy.Owner_module
    then
        return 0ULL
    end
    local callBytes = policy.calls >> 3ULL
    local used = native.offset(work, native.index(policy.signatures >> 3ULL))
    local sites = native.offset(used, native.index(callBytes))
    local offsets = native.offset(sites, native.index(callBytes))
    local targets = native.offset(offsets, native.index((policy.owners + 1ULL) * 8ULL))
    local degree = native.offset(targets, native.index(wire.recordsLimit * 8ULL))
    local queue = native.offset(degree, native.index(policy.owners * 8ULL))
    local rooted = native.offset(queue, native.index(policy.owners * 8ULL))
    local index = 0ULL
    while index < owners do
        if owner(descriptor, index, work, rooted) == 0ULL then
            return 0ULL
        end
        index = index + 1ULL
    end
    if signatures(descriptor, work) == 0ULL
        or graphs(descriptor, used, offsets, targets, degree) == 0ULL
        or contracts(descriptor, used, sites) == 0ULL
        or acyclic(offsets, targets, degree, queue, owners) == 0ULL
    then
        return 0ULL
    end

    return 1ULL
end

local function range(base: uint64, bytes: uint64): uint64
    if base == 0ULL or bytes == 0ULL or (base & 7ULL) ~= 0ULL or bytes > 0xffffffffffffffffULL - base then
        return 0ULL
    end
    return 1ULL
end

local function overlaps(a: uint64, an: uint64, b: uint64, bn: uint64): boolean
    return a < b + bn and b < a + an
end

export function admit(
    data: voidptr,
    dataBytes: uint64,
    out: voidptr,
    outBytes: uint64,
    pool: voidptr,
    poolBytes: uint64,
    helper: voidptr,
    helperBytes: uint64
): uint64
    local d, o, p, h = native.address(data), native.address(out), native.address(pool), native.address(helper)
    local descriptor = native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>()
    local fixed = workspaceBytes(0ULL, 0ULL)
    if range(d, dataBytes) == 0ULL
        or range(o, outBytes) == 0ULL
        or range(p, poolBytes) == 0ULL
        or range(h, helperBytes) == 0ULL
    then
        return 0ULL
    end
    if dataBytes < wire.minimumBytes
        or dataBytes > wire.fileLimit
        or outBytes < descriptor
        or poolBytes < fixed
        or helperBytes < 16ULL
    then
        return 0ULL
    end
    if overlaps(d, dataBytes, o, outBytes)
        or overlaps(d, dataBytes, p, poolBytes)
        or overlaps(d, dataBytes, h, helperBytes)
        or overlaps(o, outBytes, p, poolBytes)
        or overlaps(o, outBytes, h, helperBytes)
        or overlaps(p, poolBytes, h, helperBytes)
    then
        return 0ULL
    end
    local at = 0ULL
    while at < descriptor do
        if native.load64(out, native.index(at)) ~= 0ULL then
            return 0ULL
        end
        at = at + 8ULL
    end
    at = 0ULL
    while at < descriptor do
        native.store64(pool, native.index(at), 0ULL)
        at = at + 8ULL
    end
    local work = native.offset(pool, native.index(descriptor))
    if shape.admit(data, dataBytes, pool, descriptor, work, poolBytes - descriptor, helper, helperBytes) == 0ULL then
        return 0ULL
    end
    -- Phase-2 shape workspace is dead. Reuse it for bounded catalog maps only.
    at = 0ULL
    while at < fixed - descriptor do
        native.store64(work, native.index(at), 0ULL)
        at = at + 8ULL
    end
    if catalog(pool, work) == 0ULL then
        return 0ULL
    end
    at = 8ULL
    while at < descriptor do
        native.store64(out, native.index(at), native.load64(pool, native.index(at)))
        at = at + 8ULL
    end
    native.store64(out, native.fieldOffset<header.Descriptor>("phase"), 3ULL)

    return 1ULL
end
