module nupp.runtime.core.rawexecutable

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const raw = require("nupp.runtime.core.rawsemantics")
const header = require("nupp.runtime.core.rawheader")
const wire = require("nupp.runtime.core.rawwire")
const fields = require("nupp.runtime.core.rawroles")
const catalog = require("nupp.runtime.core.guestcatalog")
const policy = require("nupp.runtime.core.rawexecutablepolicy")

-- This first raw executable profile has one initializer, one block, scalar
-- K/Nil/Move operations and an explicit scalar Ret. The request's dispatch
-- and code span come from the retained, authenticated core entry, not wire.
export struct Request
    data: uint64
    dataBytes: uint64
    output: uint64
    outputBytes: uint64
    pool: uint64
    poolBytes: uint64
    helper: uint64
    helperBytes: uint64
    dispatch: uint64
    dispatchCount: uint64
    codeBytes: uint64
end

local function range(base: uint64, bytes: uint64): boolean
    return base ~= 0ULL and bytes ~= 0ULL and (base & 7ULL) == 0ULL and bytes <= 0xffffffffffffffffULL - base
end

local function overlaps(a: uint64, an: uint64, b: uint64, bn: uint64): boolean
    return a < b + bn and b < a + an
end

local function count(descriptor: voidptr, section: uint64): uint64
    return native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("count")
    )
end

local function row(descriptor: voidptr, section: uint64, index: uint64, offset: uint64): uint64
    local address = native.load64(
        descriptor,
        native.index(
            native.sizeOf<header.Descriptor>() + section * native.sizeOf<header.Section>()
        ) + native.fieldOffset<header.Section>("data")
    )

    return native.word(native.load32(native.pointer(address), native.index(index * wire.stride(section) + offset)))
        & fields.absent
end

local function physical(descriptor: voidptr, first: uint64, value: uint64, nv: uint64): uint64
    if value == 0ULL or value > nv then
        return 250ULL
    end
    return 2ULL + row(descriptor, wire.S_values, first + value - 1ULL, fields.F_values_slot)
end

local function word(out: voidptr, offset: uint64, value: uint64): nil
    native.store64(out, native.index(offset), value)
end

-- A rejected request never writes output. The raw phase-4 descriptor is
-- recomputed inside this call; a caller-supplied phase word grants nothing.
-- Publication is the final version store after all bounds and operands pass.
export function admit(request: voidptr): uint64
    if not range(native.address(request), native.sizeOf<Request>()) then
        return 0ULL
    end
    if wire.version ~= policy.version
        or wire.profile ~= policy.profile
        or policy.Op_K ~= 0ULL
        or policy.Op_Require ~= 1ULL
        or policy.Op_Nil ~= 2ULL
        or policy.Op_Move ~= 3ULL
    then
        return 0ULL
    end
    local d = native.load64(request, native.fieldOffset<Request>("data"))
    local dn = native.load64(request, native.fieldOffset<Request>("dataBytes"))
    local o = native.load64(request, native.fieldOffset<Request>("output"))
    local on = native.load64(request, native.fieldOffset<Request>("outputBytes"))
    local p = native.load64(request, native.fieldOffset<Request>("pool"))
    local pn = native.load64(request, native.fieldOffset<Request>("poolBytes"))
    local h = native.load64(request, native.fieldOffset<Request>("helper"))
    local hn = native.load64(request, native.fieldOffset<Request>("helperBytes"))
    local dispatch = native.load64(request, native.fieldOffset<Request>("dispatch"))
    local handlers = native.load64(request, native.fieldOffset<Request>("dispatchCount"))
    local codeBytes = native.load64(request, native.fieldOffset<Request>("codeBytes"))
    local descriptorBytes = native.sizeOf<header.Descriptor>() + wire.sectionCount * native.sizeOf<header.Section>()
    if not range(d, dn)
        or not range(o, on)
        or not range(p, pn)
        or not range(h, hn)
        or handlers <= policy.Byte_Ret
        or handlers > 256ULL
        or codeBytes < 4ULL
        or codeBytes >= 134217728ULL
        or not range(dispatch, handlers * 8ULL)
        or pn <= descriptorBytes
        or on < native.sizeOf<catalog.DescriptorV1>()
    then
        return 0ULL
    end
    if overlaps(o, on, d, dn)
        or overlaps(o, on, p, pn)
        or overlaps(o, on, h, hn)
        or overlaps(o, on, dispatch, handlers * 8ULL)
        or overlaps(dispatch, handlers * 8ULL, d, dn)
        or overlaps(dispatch, handlers * 8ULL, p, pn)
        or overlaps(dispatch, handlers * 8ULL, h, hn)
        or overlaps(native.address(request), native.sizeOf<Request>(), o, on)
        or overlaps(native.address(request), native.sizeOf<Request>(), p, pn)
        or overlaps(native.address(request), native.sizeOf<Request>(), h, hn)
    then
        return 0ULL
    end
    local i: uint64 = 0ULL
    while i < handlers do
        local offset = native.load64(native.pointer(dispatch), native.index(i * 8ULL))
        if (offset & 3ULL) ~= 0ULL or offset > codeBytes - 4ULL then
            return 0ULL
        end
        i = i + 1ULL
    end
    local phase = native.pointer(p)
    local pool = native.pointer(p + descriptorBytes)
    if raw.admit(
        native.pointer(d),
        dn,
        phase,
        descriptorBytes,
        pool,
        pn - descriptorBytes,
        native.pointer(h),
        hn
    ) == 0ULL then
        return 0ULL
    end
    if native.load64(phase, native.fieldOffset<header.Descriptor>("phase")) ~= 4ULL
        or count(phase, wire.S_catalog) ~= 1ULL
        or count(phase, wire.S_signatures) ~= 1ULL
        or count(phase, wire.S_graphs) ~= 1ULL
        or count(phase, wire.S_modules) ~= 1ULL
        or count(phase, wire.S_contracts) ~= 0ULL
        or count(phase, wire.S_blocks) ~= 1ULL
        or count(phase, wire.S_terms) ~= 1ULL
    then
        return 0ULL
    end
    local graph = 0ULL
    local nv = row(phase, wire.S_graphs, graph, fields.F_graphs_nv)
    local valuesFirst = row(phase, wire.S_graphs, graph, fields.F_graphs_valuesFirst)
    local constantsFirst = row(phase, wire.S_graphs, graph, fields.F_graphs_constantsFirst)
    local constants = row(phase, wire.S_graphs, graph, fields.F_graphs_constantsCount)
    local blocksFirst = row(phase, wire.S_graphs, graph, fields.F_graphs_blocksFirst)
    local opsFirst = row(phase, wire.S_blocks, blocksFirst, fields.F_blocks_opsFirst)
    local ops = row(phase, wire.S_blocks, blocksFirst, fields.F_blocks_opsCount)
    local term = row(phase, wire.S_blocks, blocksFirst, fields.F_blocks_term)
    local signature = row(phase, wire.S_catalog, 0ULL, fields.F_catalog_signature)
    if signature ~= 0ULL
        or row(phase, wire.S_modules, 0ULL, fields.F_modules_chunk) ~= 0ULL
        or row(phase, wire.S_graphs, graph, fields.F_graphs_nparams) ~= 0ULL
        or row(phase, wire.S_graphs, graph, fields.F_graphs_ni) ~= 0ULL
        or row(phase, wire.S_graphs, graph, fields.F_graphs_nf) ~= 0ULL
        or row(phase, wire.S_graphs, graph, fields.F_graphs_nx) ~= 0ULL
        or nv == 0ULL
        or nv > 245ULL
        or ops == 0ULL
        or ops >= 1048576ULL
        or constants > 65536ULL
        or row(phase, wire.S_blocks, blocksFirst, fields.F_blocks_paramsCount) ~= 0ULL
        or row(phase, wire.S_terms, term, fields.F_terms_kind) ~= 0ULL
        or row(phase, wire.S_terms, term, fields.F_terms_value) == fields.absent
    then
        return 0ULL
    end
    local ret = physical(phase, valuesFirst, row(phase, wire.S_terms, term, fields.F_terms_value), nv)
    if ret >= 250ULL then
        return 0ULL
    end
    local records = native.sizeOf<catalog.DescriptorV1>()
    local signatures = records + native.sizeOf<catalog.Function>()
    local contracts = signatures + native.sizeOf<catalog.Signature>()
    local targets = contracts
    local constantOffset = targets + 8ULL
    local codeOffset = constantOffset + constants * 8ULL
    local dispatchOffset = codeOffset + (ops + 1ULL) * 16ULL
    local needed = dispatchOffset + handlers * 8ULL
    if needed > on or needed > 67108864ULL then
        return 0ULL
    end
    i = 0ULL
    while i < needed do
        if native.load64(native.pointer(o), native.index(i)) ~= 0ULL then
            return 0ULL
        end
        i = i + 8ULL
    end
    i = 0ULL
    while i < ops do
        local op = opsFirst + i
        local kind = row(phase, wire.S_operations, op, fields.F_operations_opcode)
        local args = row(phase, wire.S_operations, op, fields.F_operations_argsFirst)
        local nargs = row(phase, wire.S_operations, op, fields.F_operations_argsCount)
        local dst = physical(phase, valuesFirst, row(phase, wire.S_operations, op, fields.F_operations_dst), nv)
        if dst >= 250ULL then
            return 0ULL
        end
        local admitted = switch kind do
            case 0 -> nargs == 1ULL and row(phase, wire.S_words, args, fields.F_words_value) < constants
            case 1 -> false
            case 2 -> nargs == 0ULL
            case 3 -> nargs == 1ULL
                and physical(phase, valuesFirst, row(phase, wire.S_words, args, fields.F_words_value), nv) < 250ULL
            else -> false
        end
        if not admitted then
            return 0ULL
        end
        i = i + 1ULL
    end
    i = 0ULL
    while i < constants do
        local kind = row(phase, wire.S_constants, constantsFirst + i, fields.F_constants_kind)
        if kind > 2ULL then
            return 0ULL
        end
        i = i + 1ULL
    end
    -- All refusal paths end above. The descriptor is not valid until its
    -- version word is stored last, after code and dispatch have been copied.
    local out = native.pointer(o)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("bytes")), needed)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("ownerCount")), 1ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("entry")), 0ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("records")), records)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("signatures")), signatures)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("signatureCount")), 1ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("contracts")), contracts)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("contractCount")), 0ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("targets")), targets)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("instanceBound")), 1ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("frameDepth")), 1ULL)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("dispatch")), dispatchOffset)
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("handlerCount")), handlers)
    local fn = records
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("id")), 0ULL)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("parentPlusOne")), 0ULL)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("kind")), catalog.INITIALIZER)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("signature")), 0ULL)
    word(
        out,
        fn + native.word(native.fieldOffset<catalog.Function>("effect")),
        row(phase, wire.S_catalog, 0ULL, fields.F_catalog_effect)
    )
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("code")), codeOffset)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("instructionCount")), ops + 1ULL)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("valueCount")), nv + 5ULL)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("constants")), constantOffset)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("constantCount")), constants)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("firstCall")), 0ULL)
    word(out, fn + native.word(native.fieldOffset<catalog.Function>("callCount")), 0ULL)
    local sig = signatures
    word(out, sig + native.word(native.fieldOffset<catalog.Signature>("parameterCount")), 0ULL)
    local resultKind = catalog.NIL
    if row(phase, wire.S_signatures, 0ULL, fields.F_signatures_result) == 0ULL then
        resultKind = catalog.BOOLEAN
    end
    word(out, sig + native.word(native.fieldOffset<catalog.Signature>("resultKind")), resultKind)
    word(out, sig + native.word(native.fieldOffset<catalog.Signature>("parameters")), constantOffset)
    word(out, targets, 0ULL)
    i = 0ULL
    while i < constants do
        local kind = row(phase, wire.S_constants, constantsFirst + i, fields.F_constants_kind)
        local value = values.NIL
        if kind == 1ULL then
            value = values.TRUE
        elseif kind == 2ULL then
            value = values.FALSE
        end
        word(out, constantOffset + i * 8ULL, value)
        i = i + 1ULL
    end
    i = 0ULL
    while i < ops do
        local op = opsFirst + i
        local kind = row(phase, wire.S_operations, op, fields.F_operations_opcode)
        local base = codeOffset + i * 16ULL
        native.store8(
            out,
            native.index(base + 1ULL),
            physical(phase, valuesFirst, row(phase, wire.S_operations, op, fields.F_operations_dst), nv)
        )
        local _ = switch kind do
            case 0 -> do
                native.store8(out, native.index(base), policy.Byte_K)
                native.store32(
                    out,
                    native.index(base + 4ULL),
                    native.index(
                        row(
                            phase,
                            wire.S_words,
                            row(phase, wire.S_operations, op, fields.F_operations_argsFirst),
                            fields.F_words_value
                        )
                    )
                )
                yield 0ULL
            end
            case 2 -> do
                native.store8(out, native.index(base), policy.Byte_Nil)
                yield 0ULL
            end
            case 3 -> do
                native.store8(out, native.index(base), policy.Byte_Move)
                native.store8(
                    out,
                    native.index(base + 2ULL),
                    physical(
                        phase,
                        valuesFirst,
                        row(
                            phase,
                            wire.S_words,
                            row(phase, wire.S_operations, op, fields.F_operations_argsFirst),
                            fields.F_words_value
                        ),
                        nv
                    )
                )
                yield 0ULL
            end
            else -> 0ULL
        end
        i = i + 1ULL
    end
    native.store8(out, native.index(codeOffset + ops * 16ULL), policy.Byte_Ret)
    native.store8(out, native.index(codeOffset + ops * 16ULL + 1ULL), ret)
    i = 0ULL
    while i < handlers do
        word(out, dispatchOffset + i * 8ULL, native.load64(native.pointer(dispatch), native.index(i * 8ULL)))
        i = i + 1ULL
    end
    word(out, native.word(native.fieldOffset<catalog.DescriptorV1>("version")), 1ULL)

    return 1ULL
end
