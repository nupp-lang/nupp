module nupp.runtime.core.guestforeign

-- Checked guest C calls. Nupp keeps types, values and lifetime policy;
-- upstream libffi lays out arguments/results and enters the foreign ABI.
const native = require("nupp.runtime.vm.intrinsics")
const os = require("nupp.runtime.vm.os")
const values = require("nupp.runtime.vm.values")
const guestvalues = require("nupp.runtime.core.guestvalues")
const strings = require("nupp.runtime.core.corestrings")
const corestorage = require("nupp.runtime.core.corestorage")
const ints = require("nupp.runtime.core.coreintegers")
const tables = require("nupp.runtime.core.coretables")
const foreignabi = require("nupp.runtime.core.foreignabi")
const guestscope = require("nupp.runtime.core.guestscope")
const context = require("nupp.runtime.core.context")

cdef function dlopen(borrows path: voidptr, mode: int64): voidptr
cdef function dlsym(borrows library: voidptr, borrows name: voidptr): voidptr
cdef function dlerror(): voidptr
cdef function strlen(borrows text: voidptr): uint64
cdef function malloc(bytes: uint64): voidptr
cdef function free(takes block: voidptr)
cdef function memcpy(exclusive target: voidptr, borrows source: voidptr, bytes: uint64): voidptr
cdef function dlclose(borrows library: voidptr): int32

const WORD: int64 = 8

-- The bridge's table (`SLOTS` in native/crates/core-bridge/src/library.rs) and the
-- words of it the linked code keeps (nativeos.kernelCells): the guest's
-- entries follow, each its key's length (0 past the last), the address and
-- the key's bytes, a word at a time.
const TABLE_BYTES: int64 = 8192
const KERNEL_BYTES: int64 = 4096
const ENTRY_BYTES: int64 = 16

-- dlopen's RTLD_NOW.
const LOAD_NOW: int64 = 2

-- The descriptor's letters: its result's kind and each argument's, those
-- past a variadic function's declared ones after VARIADIC. int64 ("l") and
-- uint64 ("L") are the words they are, and need no letter here.
const VOID: uint64 = 0x76ULL
const POINTER: uint64 = 0x70ULL
const TEXT: uint64 = 0x73ULL
const BOOLEAN: uint64 = 0x62ULL
const INT32: uint64 = 0x69ULL
const UINT32: uint64 = 0x75ULL
const FLOAT32: uint64 = 0x66ULL
const FLOAT64: uint64 = 0x64ULL
const VARIADIC: uint64 = 0x2eULL
const SIGN32: uint64 = 0x80000000ULL
const LOW32: uint64 = 0xffffffffULL
const BYTE: uint64 = 0xffULL

-- binary64 and binary32, for float arguments and results.
const FRACTION64: uint64 = 0x000fffffffffffffULL
const IMPLICIT64: uint64 = 0x0010000000000000ULL
const EXPONENT64: uint64 = 0x7ffULL
const INFINITY64: uint64 = 0x7ff0000000000000ULL
const BIAS64: int64 = 1023
const FRACTION_BITS64: uint64 = 52ULL
const FRACTION32: uint64 = 0x7fffffULL
const IMPLICIT32: uint64 = 0x800000ULL
const EXPONENT32: uint64 = 0xffULL
const INFINITY32: uint64 = 0x7f800000ULL
const QUIET32: uint64 = 0x7fc00000ULL
const BIAS32: int64 = 127
const FRACTION_BITS32: uint64 = 23ULL
-- The fraction bits binary32 drops of binary64's, and the shift past which
-- nothing is left to round.
const DROPPED: int64 = 29
const VANISHES: int64 = 54

-- Whether a kind passes in a float register.
local function floating(kind: uint64): boolean
    return kind == FLOAT32 or kind == FLOAT64
end

-- binary64 `bits` rounded to the nearest binary32, ties to even.
local function narrowed(bits: uint64): uint64
    local sign = (bits >> 32ULL) & SIGN32
    local exponent = native.index((bits >> FRACTION_BITS64) & EXPONENT64)
    local fraction = bits & FRACTION64
    if exponent == native.index(EXPONENT64) then
        if fraction == 0ULL then
            return sign | INFINITY32
        end
        return sign | QUIET32 | (fraction >> native.word(DROPPED))
    end
    -- A binary64 subnormal is far below the least binary32 one.
    if exponent == 0 then
        return sign
    end
    local biased = exponent - BIAS64 + BIAS32
    if biased >= native.index(EXPONENT32) then
        return sign | INFINITY32
    end
    local shift = DROPPED
    if biased <= 0 then
        shift = DROPPED + 1 - biased
        biased = 0
    end
    if shift >= VANISHES then
        return sign
    end
    local significand = fraction | IMPLICIT64
    local kept = significand >> native.word(shift)
    local rest = significand & ((1ULL << native.word(shift)) - 1ULL)
    local half = 1ULL << native.word(shift - 1)
    if rest > half or rest == half and kept & 1ULL == 1ULL then
        kept = kept + 1ULL
    end
    if biased == 0 then
        return sign | kept
    end
    -- A rounding that carries out of the significand raises the exponent.

    return sign | ((native.word(biased) << FRACTION_BITS32) + kept - IMPLICIT32)
end

-- binary32 `bits` as the binary64 it is exactly.
local function widened(bits: uint64): uint64
    local sign = (bits & SIGN32) << 32ULL
    local fraction = bits & FRACTION32
    local exponent = native.index((bits >> FRACTION_BITS32) & EXPONENT32)
    if exponent == native.index(EXPONENT32) then
        return sign | INFINITY64 | (fraction << native.word(DROPPED))
    end
    if exponent == 0 and fraction == 0ULL then
        return sign
    elseif exponent == 0 then
        -- A subnormal: shifted until its leading bit is the implicit one.
        exponent = 1
        while fraction & IMPLICIT32 == 0ULL do
            fraction = fraction << 1ULL
            exponent = exponent - 1
        end
        fraction = fraction & FRACTION32
    end

    return sign | (native.word(exponent - BIAS32 + BIAS64) << FRACTION_BITS64) | (fraction << native.word(DROPPED))
end

-- Whether the `count` bytes at `a` and `b` are the same.
local function same(a: voidptr, b: voidptr, count: int64): boolean
    local index: int64 = 0
    while index < count do
        if native.load8(a, index) ~= native.load8(b, index) then
            return false
        end
        index = index + 1
    end

    return true
end

-- The address the table keeps for the `count` bytes of `key`, or else
-- `address`, which is kept for the key when it is not 0 and fits.
local function cache(key: voidptr, count: int64, address: uint64): uint64
    @unsafe do
        local cells = os.foreignCells()
        local at = KERNEL_BYTES
        while at + ENTRY_BYTES <= TABLE_BYTES do
            local stored = native.index(native.load64(cells, at))
            if stored == 0 then
                break
            end
            if stored == count and same(native.offset(cells, at + ENTRY_BYTES), key, count) then
                return native.load64(cells, at + WORD)
            end
            at = at + ENTRY_BYTES + (stored + WORD - 1) // WORD * WORD
        end
        if address == 0ULL or at + ENTRY_BYTES + count > TABLE_BYTES then
            return address
        end
        local index: int64 = 0
        while index < count do
            native.store8(cells, at + ENTRY_BYTES + index, native.word(native.load8(key, index)))
            index = index + 1
        end
        native.store64(cells, at + WORD, address)
        -- The length last: an entry is whole once it shows.
        native.storeIndex(cells, at, count)

        return address
    end
end

-- The C bootstrap supplies only its initial artifact directory, as immutable
-- startup metadata. Nupp constructs artifact-relative names and calls the OS
-- loader itself; no C wrapper owns path or library policy.
local function openLibrary(key: voidptr): uint64
    @unsafe do
        if native.load8(key, 0) ~= 0x40 then
            return native.address(dlopen(key, LOAD_NOW))
        end
        local name = malloc(32ULL)
        if native.address(name) == 0ULL then
            error("foreign loader allocation failed")
        end
        -- The NUL-terminated name "nupp_core_artifact_directory".
        native.store64(name, 0, 0x726f635f7070756eULL)
        native.store64(name, 8, 0x6166697472615f65ULL)
        native.store64(name, 16, 0x63657269645f7463ULL)
        native.store64(name, 24, 0x79726f74ULL)
        local process = dlopen(native.pointer(0ULL), LOAD_NOW)
        if native.address(process) == 0ULL then
            free(name)
            error("foreign loader cannot open its process")
        end
        local _ = dlerror()
        local marker = dlsym(process, name)
        local failed = native.address(dlerror()) ~= 0ULL
        free(name)
        local _ = dlclose(process)
        if failed or native.address(marker) == 0ULL then
            -- The frozen reference transport still anchors its own @ paths.
            return native.address(dlopen(key, LOAD_NOW))
        end
        local directory = native.loadPointer(marker, 0)
        if native.address(directory) == 0ULL then
            error("foreign loader has no artifact directory")
        end
        local rootBytes, libraryBytes = strlen(directory), strlen(key)
        local relative: int64 = 1
        while native.word(relative) < libraryBytes and native.load8(key, relative) == 0x2f do
            relative = relative + 1
        end
        local suffixBytes = libraryBytes - native.word(relative) + 1ULL
        local path = malloc(rootBytes + suffixBytes + 1ULL)
        if native.address(path) == 0ULL then
            error("foreign loader allocation failed")
        end
        local _ = memcpy(path, directory, rootBytes)
        native.store8(path, native.index(rootBytes), 0x2fULL)
        local _ = memcpy(native.offset(path, native.index(rootBytes) + 1), native.offset(key, relative), suffixBytes)
        local library = dlopen(path, LOAD_NOW)
        free(path)
        return native.address(library)
    end
end

-- The address of the function the descriptor's library and symbol name,
-- the `count` bytes at `key`: the library's name ("" for the program
-- itself), a NUL and the symbol, which a NUL ends.
local function resolve(key: voidptr, count: int64): uint64
    @unsafe do
        local kept = cache(key, count, 0ULL)
        if kept ~= 0ULL then
            return kept
        end
        local libraryBytes = native.index(strlen(key)) + 1
        local library = cache(key, libraryBytes, 0ULL)
        local opened = library == 0ULL
        if opened then
            if native.load8(key, 0) == 0 then
                library = native.address(dlopen(native.pointer(0ULL), LOAD_NOW))
            else
                library = openLibrary(key)
            end
        end
        if library == 0ULL then
            error("foreign call: its library cannot be loaded")
        end
        local symbol = native.offset(key, libraryBytes)
        local _ = dlerror()
        local address = native.address(dlsym(native.pointer(library), symbol))
        local failed = native.address(dlerror()) ~= 0ULL
        if failed or address == 0ULL then
            if opened then
                local _ = dlclose(native.pointer(library))
            end
            error("foreign call: its symbol is not in its library")
        end
        -- The bridge's symbol table and generated call sites live for the
        -- process. Their code and any returned data therefore pin this loader
        -- reference for the process too; unloading cannot be quiescent earlier.
        -- Cache the owner as well as its symbols so each library opens once.
        -- shortcut: a full fixed table retains uncached owners, grow the table
        -- with the bridge if programs exceed its current symbol capacity.
        local _ = cache(key, libraryBytes, library)
        return cache(key, count, address)
    end
end

-- The NUL-ended bytes of string argument `value` at `position`, 0 for
-- nil. A number's text, or a string whose bytes no NUL follows, is made
-- into a string that one does, kept in the pack so it lives through the
-- call.
local function text(ctx: voidptr, pack: uint64, position: uint64, value: uint64): uint64
    if value == values.NIL then
        return 0ULL
    end
    local s = guestvalues.strarg(ctx, value, position)
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        if native.load8(native.pointer(strings.bytes(s)), native.index(strings.length(s))) ~= 0 then
            s = strings.make(h, strings.bytes(s), strings.length(s))
        end
        if s ~= strings.header(value) then
            guestvalues.packput(h, pack, position, values.TAG_OBJ | s)
        end

        return strings.bytes(s)
    end
end

-- Argument `position`'s word as `kind` passes it: an integer extended from
-- its width, a float's bits (binary32's in the low half), a Boolean 0 or 1,
-- a pointer's address. As a variadic argument a binary32 is promoted.
local function word(ctx: voidptr, pack: uint64, position: uint64, kind: uint64, named: boolean): uint64
    local value = tables.get(pack, values.TAG_INTEGER | position)
    if floating(kind) then
        local bits = guestvalues.floatof(guestvalues.numarg(ctx, value, position))
        if kind == FLOAT32 and named then
            return narrowed(bits)
        end
        return bits
    elseif kind == BOOLEAN then
        if value == values.TRUE then
            return 1ULL
        elseif value ~= values.FALSE then
            error("foreign call: a Boolean argument is not a Boolean")
        end
        return 0ULL
    elseif kind == TEXT then
        return text(ctx, pack, position, value)
    elseif kind == POINTER then
        if value == values.NIL then
            return 0ULL
        elseif strings.header(value) ~= 0ULL then
            return text(ctx, pack, position, value)
        elseif corestorage.isstorage(value) then
            -- A struct or storage passed where C takes a pointer: its bytes.
            return corestorage.storagebase(value & values.PAYLOAD)
        end
    end
    local bits = native.word(guestvalues.intarg(ctx, value, 0, position))
    if kind == INT32 then
        return ((bits & LOW32) ~ SIGN32) - SIGN32
    elseif kind == UINT32 then
        return bits & LOW32
    end

    return bits
end

-- The value `kind` makes of what the call answered: `x0`, or the float
-- the block's d0 word holds.
local function result(ctx: voidptr, kind: uint64, x0: uint64, d0: uint64): uint64
    local h = guestvalues.guestheap(ctx)
    if kind == VOID then
        return values.NIL
    elseif kind == FLOAT64 then
        return guestvalues.floatvalue(d0)
    elseif kind == FLOAT32 then
        return guestvalues.floatvalue(widened(d0 & LOW32))
    elseif kind == BOOLEAN then
        if x0 & BYTE ~= 0ULL then
            return values.TRUE
        end
        return values.FALSE
    elseif kind == INT32 then
        return ints.make(h, ((x0 & LOW32) ~ SIGN32) - SIGN32)
    elseif kind == UINT32 then
        return ints.make(h, x0 & LOW32)
    elseif kind == POINTER and x0 == 0ULL or kind == TEXT and x0 == 0ULL then
        return values.NIL
    elseif kind == TEXT then
        @unsafe do
            return values.TAG_OBJ | strings.make(h, x0, strlen(native.pointer(x0)))
        end
    end

    return ints.make(h, x0)
end

-- Copies bytes without allocating after their addresses have been taken.
local function copy(target: voidptr, source: voidptr, count: int64): nil
    local index: int64 = 0
    while index < count do
        native.store8(target, index, native.word(native.load8(source, index)))
        index = index + 1
    end
end

local function structargument(pack: uint64, position: uint64, size: uint64): uint64
    local value = tables.get(pack, values.TAG_INTEGER | position)
    if not corestorage.isstorage(value) or corestorage.bytelength(value & values.PAYLOAD) < size then
        error("foreign call: a struct argument is not its struct")
    end

    return value & values.PAYLOAD
end

-- The descriptor, ffi_cif, type tree, argument pointers and scalar slots
-- share one rooted builder. The pack roots all input strings/storage and
-- the result. Nothing can collect or park while libffi holds their addresses.
export function call(ctx: voidptr, descriptor: uint64, packValue: uint64): uint64
    local d = strings.header(descriptor)
    local state = strings.Builder(0ULL, 0ULL)
    if d == 0ULL or packValue & values.TAG_MASK ~= values.TAG_OBJ then
        error("foreign call: its descriptor or arguments are malformed")
    end
    local count = guestvalues.intvalue(tables.get(packValue & values.PAYLOAD, values.TAG_INTEGER))
    local pack = packValue & values.PAYLOAD
    @unsafe do
        local h = guestvalues.guestheap(ctx)
        local length = native.index(strings.length(d))
        local source = native.pointer(strings.bytes(d))
        local kinds: int64 = 0
        while kinds < length and native.load8(source, kinds) ~= 0 do
            kinds = kinds + 1
        end
        if kinds == 0 or kinds >= length then
            error("foreign call: its descriptor is malformed")
        end
        local workBytes = foreignabi.bytes(kinds, count)
        local lifetime = strings.open(h, state as strings.Builder*)
        if strings.reserve(h, lifetime, native.word(workBytes + length + 1)) ~= 0ULL then
            error("not enough memory")
        end
        local workspace = native.pointer(strings.descriptor(lifetime).base)
        local bytes = native.offset(workspace, workBytes)
        local at: int64 = 0
        while at < workBytes do
            native.store64(workspace, at, 0ULL)
            at = at + WORD
        end
        copy(bytes, native.pointer(strings.bytes(d)), length)
        native.store8(bytes, length, 0ULL)
        local resultType = native.pointer(foreignabi.prepare(workspace, bytes, kinds, count))
        -- Coerce strings before taking pointers into any managed storage.
        local position: uint64 = 0ULL
        at = foreignabi.after(bytes, 0, kinds)
        while at < kinds do
            local kind = native.word(native.load8(bytes, at))
            if kind ~= VARIADIC then
                position = position + 1ULL
                local value = tables.get(pack, values.TAG_INTEGER | position)
                if kind == TEXT or kind == POINTER and strings.header(value) ~= 0ULL then
                    text(ctx, pack, position, value)
                end
            end
            at = foreignabi.after(bytes, at, kinds)
        end
        local resultKind = native.word(native.load8(bytes, 0))
        local made: uint64 = 0ULL
        if resultKind == foreignabi.STRUCT then
            local size = native.load64(resultType, 0)
            -- libffi may use ffi_arg storage even for a narrow result.
            made = corestorage.newstorage(h, corestorage.UINT8, native.chooseWord(size < 8ULL, 8ULL, size))
            if made == 0ULL then
                error("not enough memory")
            end
            guestvalues.packput(h, pack, native.word(count) + 1ULL, values.TAG_OBJ | made)
            tables.drain(h)
        end
        local fn = resolve(native.offset(bytes, kinds + 1), length - kinds - 1)
        local named = true
        position = 0ULL
        at = foreignabi.after(bytes, 0, kinds)
        while at < kinds do
            local kind = native.word(native.load8(bytes, at))
            if kind == VARIADIC then
                named = false
            else
                local slot = native.index(position) * WORD
                position = position + 1ULL
                local address = native.offset(workspace, foreignabi.scalars(count) + slot)
                if kind == foreignabi.STRUCT then
                    local ctype = native.loadPointer(workspace, foreignabi.CIF_BYTES + slot)
                    local held = structargument(pack, position, native.load64(ctype, 0))
                    address = native.pointer(corestorage.storagebase(held))
                else
                    native.store64(address, 0, word(ctx, pack, position, kind, named))
                end
                native.store64(workspace, foreignabi.arguments(count) + slot, native.address(address))
            end
            at = foreignabi.after(bytes, at, kinds)
        end
        local target = native.offset(workspace, foreignabi.answer(count))
        if made ~= 0ULL then
            target = native.pointer(corestorage.storagebase(made))
        end
        foreignabi.invoke(workspace, fn, target, count)
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        if foreignabi.failed(native.load64(services, native.fieldOffset<guestscope.Services>("foreignClosures"))) then
            error("foreign collector: wrong thread or record shape")
        end
        if made ~= 0ULL then
            return values.TAG_OBJ | made
        end
        local bits = native.load64(target, 0)
        return result(ctx, resultKind, bits, bits)
    end
end

-- The C visitor's signature is two integer/pointer structs of the given
-- word count and a record pointer. Registrations are entry-owned and immutable;
-- repeated requests reuse one. They cannot retain managed Nupp closures.
export function collector(ctx: voidptr, words: uint64): uint64
    @unsafe do
        local size = guestvalues.intarg(ctx, words, 0, 1ULL)
        local services = native.loadPointer(ctx, context.SERVICE_SCOPE)
        local slot = native.offset(services, native.fieldOffset<guestscope.Services>("foreignClosures"))
        local registration = foreignabi.collector(size, os.foreignCollector(), slot)
        return ints.make(
            guestvalues.guestheap(ctx),
            native.load64(native.pointer(registration), foreignabi.CLOSURE_CODE)
        )
    end
end
