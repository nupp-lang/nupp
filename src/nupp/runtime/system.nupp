@!internal
--[[Retains the current system provider and its executing ABI facts.]]
module nupp.runtime.system

local contract = require("nupp.runtime.contracts")
local provider: contract.SystemProvider = require("nupp.runtime.bindings.system")
if provider.platform == "" or provider.architecture == "" then
    error("system provider must name its platform and architecture", 2)
end
if provider.endianness ~= "little" and provider.endianness ~= "big" then
    error("system provider endianness must be little or big", 2)
end
if provider.pointerbits ~= 32 and provider.pointerbits ~= 64 then
    error("system provider pointerBits must be 32 or 64", 2)
end

--- The operating system, lowercase.
---
--- `macos`, `linux`, `windows`, `bsd`, or `browser`. An unrecognized host
--- returns its own name lowercased rather than a placeholder, so a new platform
--- reads as itself.
export const platform = provider.platform

--- The instruction set, by its canonical name.
---
--- Names include `aarch64`, `x86_64`, `x86`, and `wasm32`. This is what is
--- executing, so an x86_64 binary under Rosetta returns `x86_64`.
export const architecture = provider.architecture

--- Byte order: `little` everywhere Nupp runs today, or `big`.
export const endianness: "little" | "big" = provider.endianness as "little" | "big"

--- Pointer width for the executing ABI, either `32` or `64`.
---
--- The browser ABI is 32-bit even when its guest instruction set is not
--- `wasm32`.
export const pointerBits = provider.pointerbits

--- Estimates how many execution units this process may actually use.
---
--- At least 1. Native hosts include operating-system restrictions in the
--- estimate, while browser hosts use the value their browser exposes. It opens
--- no worker pool, so it is a fair default for the `limit` one is opened with.
---
--- ```nupp:fragment
--- local scope = coroutine.scope(limit = os.info().parallelism)
--- for _, shard in ipairs(shards) do
---     scope:work(shard, jobs.shard)
--- end
--- ```
---
--- @return the estimate, never below one
export const availableParallelism = provider.availableparallelism
