@!internal

module nupp.runtime.libraryvalues

--[[
The core's library functions as values. A call of `tostring` is an operation
the core makes itself; `tostring` passed, stored, or handed to `pcall` is the
function here under its name, which makes that call. A program's image carries
this module when it takes a library function as a value.
]]

local hostcalls = require("nupp.runtime.hostcalls")
local scalarcalls = require("nupp.runtime.scalarcalls")

export const functions: {[string]: any} = {
    -- The ambient `package` table: its `loaded` and `preload` as Lua's, empty
    -- because the image holds the modules, and fields a program sets on it.
    package = {loaded = {}, preload = {}, path = "", cpath = "", config = "/\n;\n?\n!\n-\n"},
    require = function(name: string): any
        return require(name)
    end,
    tostring = function(value: any): string
        return tostring(value)
    end,
    tonumber = function(value: any): number?
        return tonumber(value)
    end,
    type = function(value: any): string
        return type(value)
    end,
    error = function(value: any, level: integer?): nil
        error(value, level or 1)
    end,
    rawget = function(t: table, key: any): any
        return rawget(t, key)
    end,
    rawset = function(t: table, key: any, value: any): table
        return rawset(t, key, value)
    end,
    setmetatable = function(t: table, metatable: table?): table
        return setmetatable(t, metatable)
    end,
    getmetatable = function(value: any): any
        return getmetatable(value)
    end,
    ["math.floor"] = function(x: number): number
        return math.floor(x)
    end,
    ["math.ceil"] = function(x: number): number
        return math.ceil(x)
    end,
    ["math.abs"] = function(x: number): number
        return math.abs(x)
    end,
    ["math.sqrt"] = function(x: number): number
        return math.sqrt(x)
    end,
    ["string.upper"] = function(s: string): string
        return string.upper(s)
    end,
    ["string.lower"] = function(s: string): string
        return string.lower(s)
    end,
    ["string.len"] = function(s: string): integer
        return string.len(s)
    end,
    ["string.reverse"] = function(s: string): string
        return string.reverse(s)
    end,
    ["string.byte"] = function(s: string, i: integer?, j: integer?): ...integer
        return string.byte(s, i, j)
    end,
    ["coroutine.create"] = function(body: any, ...: any): thread
        return coroutine.create(body, ...)
    end,
    ["coroutine.resume"] = function(co: thread, ...: any): ...any
        return coroutine.resume(co, ...)
    end,
    ["coroutine.yield"] = function(...: any): ...any
        return coroutine.yield(...)
    end,
    ["coroutine.status"] = function(co: thread): string
        return coroutine.status(co)
    end,
    ["coroutine.wrap"] = function(body: any): any
        return coroutine.wrap(body)
    end,
    ["coroutine.running"] = function(): (thread?, boolean)
        return coroutine.running()
    end,
    ["coroutine.isyieldable"] = function(): boolean
        return coroutine.isyieldable()
    end,
    ["coroutine.close"] = function(co: thread): (boolean, any)
        return coroutine.close(co)
    end,
    -- The core's debug library: none of its functions yet.
    debug = {},
    ["os.getenv"] = function(name: string): string?
        return os.getenv(name)
    end,
    _VERSION = "Lua 5.5",
    next = function(t: table, key: any): (any, any)
        return next(t, key)
    end,
    pairs = function(t: table): (function(table, any): (any, any), table, nil)
        return next, t, nil
    end,
    select = function(n: any, ...: any): ...any
        if n == "#" then
            return select("#", ...)
        end

        return select(n as integer, ...)
    end,
    ["string.char"] = function(...: integer): string
        local parts: {string} = {}
        for index = 1, select("#", ...) do
            parts[index] = string.char((select(index, ...)))
        end

        return table.concat(parts)
    end,
    ["string.find"] = function(s: string, pattern: string, init: integer?, plain: boolean?): ...any
        return string.find(s, pattern, init, plain)
    end,
    ["string.match"] = function(s: string, pattern: string, init: integer?): ...any
        return string.match(s, pattern, init)
    end,
    ["string.sub"] = function(s: string, i: integer, j: integer?): string
        return string.sub(s, i, j)
    end,
    ["string.rep"] = function(s: string, n: integer, sep: string?): string
        return string.rep(s, n, sep)
    end,
    ["string.format"] = function(format: string, ...: any): string
        return string.format(format, ...)
    end,
    ["string.gmatch"] = function(s: string, pattern: string): function(): ...any
        local state = hostcalls.gmatchstate(s, pattern)
        return function(): ...any
            local pack = hostcalls.gmatchvalues(state)
            return table.unpack(pack, 1, pack[0] as integer)
        end
    end,
    ["string.gsub"] = function(s: string, pattern: string, replacement: any, n: integer?): (string, integer)
        if type(replacement) == "function" then
            return string.gsub(s, pattern, replacement as function(...: string): any, n)
        end

        return string.gsub(s, pattern, replacement as string | {[string]: string}, n)
    end,
    ["table.concat"] = function(t: {string}, sep: string?, i: integer?, j: integer?): string
        return table.concat(t, sep, i, j)
    end,
    ["table.insert"] = function(t: {any}, position: any, value: any): nil
        if value == nil then
            t[#t + 1] = position
        else
            table.insert(t, position as integer, value)
        end
    end,
    ["math.type"] = function(x: any): string?
        return math.type(x)
    end,
    ["math.max"] = function(x: number, ...: number): number
        local best = x
        for index = 1, select("#", ...) do
            best = math.max(best, (select(index, ...)))
        end

        return best
    end,
    ["math.min"] = function(x: number, ...: number): number
        local best = x
        for index = 1, select("#", ...) do
            best = math.min(best, (select(index, ...)))
        end

        return best
    end,
    ["math.tointeger"] = function(x: any): integer?
        return math.tointeger(x)
    end,
}

-- The library tables by name, `math` and `string` and `table`: the functions
-- above under their field names, and `math`'s constants.
local mathmembers: {
    [string]: any
} = {huge = math.huge, pi = math.pi, maxinteger = math.maxinteger, mininteger = math.mininteger}
local stringmembers: {[string]: any} = {}
local libraries: {[string]: {[string]: any}} = {math = mathmembers, string = stringmembers, table = {}, coroutine = {}}
for name, value in pairs(functions) do
    local library, field = string.match(name, "^(%a+)%.(%a+)$")
    local members = library and libraries[library]
    if members ~= nil then
        members[field as string] = value
    end
end
-- Scalar functions and namespace aliases read these same canonical tables.
mathmembers.i32 = {}
mathmembers.i32.wrap = function(value: integer): int32
    return scalarcalls.i32wrap(value)
end
mathmembers.i32.add = function(a: int32, b: int32): int32
    return scalarcalls.i32add(a, b)
end
mathmembers.i32.sub = function(a: int32, b: int32): int32
    return scalarcalls.i32sub(a, b)
end
mathmembers.i32.mul = function(a: int32, b: int32): int32
    return scalarcalls.i32mul(a, b)
end
mathmembers.i32.andbits = function(a: int32, b: int32): int32
    return scalarcalls.i32andbits(a, b)
end
mathmembers.i32.orbits = function(a: int32, b: int32): int32
    return scalarcalls.i32orbits(a, b)
end
mathmembers.i32.xorbits = function(a: int32, b: int32): int32
    return scalarcalls.i32xorbits(a, b)
end
mathmembers.i32.notbits = function(a: int32): int32
    return scalarcalls.i32notbits(a)
end
mathmembers.i32.shiftleft = function(a: int32, count: integer): int32
    return scalarcalls.i32shiftleft(a, count)
end
mathmembers.i32.shiftrightarithmetic = function(a: int32, count: integer): int32
    return scalarcalls.i32shiftrightarithmetic(a, count)
end
mathmembers.i32.rotateleft = function(a: int32, count: integer): int32
    return scalarcalls.i32rotateleft(a, count)
end
mathmembers.i32.rotateright = function(a: int32, count: integer): int32
    return scalarcalls.i32rotateright(a, count)
end
mathmembers.i32.lessthan = function(a: int32, b: int32): boolean
    return scalarcalls.i32lessthan(a, b)
end
mathmembers.i32.lessorequal = function(a: int32, b: int32): boolean
    return scalarcalls.i32lessorequal(a, b)
end
mathmembers.i32.fromu32 = function(a: uint32): int32
    return scalarcalls.i32fromu32(a)
end
mathmembers.i32.tou32 = function(a: int32): uint32
    return scalarcalls.i32tou32(a)
end
mathmembers.u32 = {}
mathmembers.u32.wrap = function(value: integer): uint32
    return scalarcalls.u32wrap(value)
end
mathmembers.u32.add = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32add(a, b)
end
mathmembers.u32.sub = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32sub(a, b)
end
mathmembers.u32.mul = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32mul(a, b)
end
mathmembers.u32.div = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32div(a, b)
end
mathmembers.u32.mod = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32mod(a, b)
end
mathmembers.u32.andbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32andbits(a, b)
end
mathmembers.u32.orbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32orbits(a, b)
end
mathmembers.u32.xorbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32xorbits(a, b)
end
mathmembers.u32.notbits = function(a: uint32): uint32
    return scalarcalls.u32notbits(a)
end
mathmembers.u32.shiftleft = function(a: uint32, count: integer): uint32
    return scalarcalls.u32shiftleft(a, count)
end
mathmembers.u32.shiftrightlogical = function(a: uint32, count: integer): uint32
    return scalarcalls.u32shiftrightlogical(a, count)
end
mathmembers.u32.rotateleft = function(a: uint32, count: integer): uint32
    return scalarcalls.u32rotateleft(a, count)
end
mathmembers.u32.rotateright = function(a: uint32, count: integer): uint32
    return scalarcalls.u32rotateright(a, count)
end
mathmembers.u32.lessthan = function(a: uint32, b: uint32): boolean
    return scalarcalls.u32lessthan(a, b)
end
mathmembers.u32.lessorequal = function(a: uint32, b: uint32): boolean
    return scalarcalls.u32lessorequal(a, b)
end
mathmembers.u32.fromi32 = function(a: int32): uint32
    return scalarcalls.u32fromi32(a)
end
mathmembers.u32.toi32 = function(a: uint32): int32
    return scalarcalls.u32toi32(a)
end
mathmembers.u32.popcount = function(a: uint32): uint32
    return scalarcalls.u32popcount(a)
end
mathmembers.u32.trailingzeros = function(a: uint32): uint32
    return scalarcalls.u32trailingzeros(a)
end
mathmembers.u32.leadingzeros = function(a: uint32): uint32
    return scalarcalls.u32leadingzeros(a)
end
mathmembers.u64 = {}
mathmembers.u64.andbits = function(a: uint64, b: uint64): uint64
    return scalarcalls.u64andbits(a, b)
end
mathmembers.u64.sub = function(a: uint64, b: uint64): uint64
    return scalarcalls.u64sub(a, b)
end
mathmembers.f32 = {
    narrow = function(value: number): float32
        return scalarcalls.f32narrow(value)
    end
}

for library, members in pairs(libraries) do
    functions[library] = members
end

-- Builtin strings share this mutable metatable and the actual public library.
hostcalls.stringmeta({__index = stringmembers})

-- `_G`: the library functions above by their global names, and itself.
local globals: {[string]: any} = {}
for name, value in pairs(functions) do
    if string.find(name, ".", 1, true) == nil then
        globals[name] = value
    end
end
globals._G = globals
-- `arg`: the program's arguments, as Lua's standalone interpreter sets it.
globals.arg = hostcalls.arguments()
-- `nupp`: the runtime's namespace, which reflection and derive install
-- into, as the VM's globals carry it.
globals.nupp = {}
functions._G = globals

-- A separately initialized base library publishes its existing table into
-- both value routes before a standard extension reads it through `_G`.
export function publish(name: string, value: any): nil
    functions[name] = value
    globals[name] = value
end
