@!internal

module nupp.runtime.libraryvalues

--[[
The core's library functions as values. A call of `tostring` is an operation
the core makes itself; `tostring` passed, stored, or handed to `pcall` is the
function here under its name, which makes that call. A program's image carries
this module when it takes a library function as a value.
]]

local hostcalls = require("nupp.runtime.hostcalls")
local scalarcalls = require("nupp.runtime.scalarcalls")
local debugcalls = require("nupp.runtime.debugcalls")

local type PairIterator = @nosuspend function(): ((any, any) | (nil))

-- The ambient `package` table: its `loaded` and `preload` as Lua's, and
-- fields a program sets on it. `loaded` holds the standard libraries, as
-- Lua's does (require("coroutine") is the coroutine table); the image
-- holds the other modules.
-- Its `config` starts with the directory separator, Windows' own there, as
-- Lua's does: the path library reads which rules to spell paths by from it.
const PLATFORM = 0
const SEPARATOR = hostcalls.systemtext(PLATFORM) == "windows" and "\\" or "/"
const ambient = {loaded = {}, preload = {}, path = "", cpath = "", config = SEPARATOR .. "\n;\n?\n!\n-\n"}
-- What Lua's require names a preload's module source as.
const PRELOAD = ":preload:"

--- What `require` answers for module `name` whose loader answered `value`:
--- it, or what the loader left in package.loaded, or true; kept there.
export function settle(name: string, value: any): any
    local settled = value ?? ambient.loaded[name] ?? true
    ambient.loaded[name] = settled

    return settled
end

-- The options debug.getinfo answers when it is given none: every field
-- but the active lines.
const ALL_OPTIONS = "flnSrtu"

-- Lua's debug.getinfo([thread,] f [, what]): a table of what the core knows
-- of the function at level `f` (1 its caller) or of function `f`, the fields
-- `what`'s option letters name; nil for a level no function is at. Its own
-- frame is the first level debugcalls counts, so a caller's level is one
-- further out than it says: every debugcalls call is made here, in it.
local function getinfo(...: any): any
    local f: any, what: any = ...
    if type(f) == "thread" then
        error("bad argument #1 to 'getinfo' (another thread's levels are not available on the core)", 2)
    end
    local options: string = ALL_OPTIONS
    if what ~= nil then
        if type(what) ~= "string" and type(what) ~= "number" then
            error("bad argument #2 to 'getinfo' (string expected, got " .. type(what) .. ")", 2)
        end
        options = tostring(what)
    end
    if string.sub(options, 1, 1) == ">" then
        error("bad argument #2 to 'getinfo' (invalid option)", 2)
    end
    local target: any = f
    if type(f) ~= "function" then
        local number = (type(f) == "number" or type(f) == "string") and tonumber(f) or nil
        if number == nil then
            error(
                "bad argument #1 to 'getinfo' (number expected, got " .. (f == nil and "no value" or type(f)) .. ")",
                2
            )
        end
        local level = math.tointeger(number)
        if level == nil then
            error("bad argument #1 to 'getinfo' (number has no integer representation)", 2)
        end
        target = level + 1
    end
    if debugcalls.what(target) == nil then
        return nil
    end
    local info: {[string]: any} = {}
    for index = 1, #options do
        local option = string.sub(options, index, index)
        if option == "S" then
            info.source = debugcalls.source(target) or "=?"
            info.short_src = debugcalls.short(target) or "?"
            info.linedefined = debugcalls.defined(target)
            info.lastlinedefined = debugcalls.lastdefined(target)
            info.what = debugcalls.what(target)
        elseif option == "l" then
            info.currentline = debugcalls.line(target)
        elseif option == "u" then
            info.nups = debugcalls.upvalues(target)
            info.nparams = debugcalls.params(target)
            info.isvararg = debugcalls.vararg(target)
        elseif option == "n" then
            info.name = debugcalls.name(target)
            info.namewhat = debugcalls.namewhat(target) or ""
        elseif option == "r" then
            -- What a hook was handed; outside one, none.
            info.ftransfer = 0
            info.ntransfer = 0
        elseif option == "t" then
            info.istailcall = debugcalls.tailcall(target)
        elseif option == "f" then
            info.func = debugcalls.func(target)
        elseif option == "L" then
            error("bad argument #2 to 'getinfo' (active lines are not available on the core)", 2)
        else
            error("bad argument #2 to 'getinfo' (invalid option)", 2)
        end
    end

    return info
end

-- The levels luaL_traceback lists before and after the ones it skips, when
-- there are more than both together.
const TRACEBACK_HEAD = 10
const TRACEBACK_TAIL = 11

-- Lua's pushglobalfuncname: the name a library table in package.loaded
-- holds function `fn` under, `_G`'s without a prefix, or nil.
local function globalname(fn: any): string?
    if fn == nil then
        return nil
    end
    for module, members in pairs(ambient.loaded) do
        if type(members) == "table" then
            for name, value in pairs(members as {[any]: any}) do
                if type(name) == "string" and rawequal(value, fn) then
                    if module == "_G" then
                        return name as string
                    end
                    return tostring(module) .. "." .. (name as string)
                end
            end
        end
    end

    return nil
end

-- How a traceback line names the function a level runs, as Lua 5.5's
-- does: the name its call gives it, the main chunk, a Lua function by
-- where it is defined, a C function by its global name, or "?".
local function functionname(info: {[string]: any}): string
    local namewhat = info.namewhat
    if type(namewhat) == "string" and namewhat ~= "" then
        return namewhat .. " '" .. tostring(info.name) .. "'"
    elseif info.what == "main" then
        return "main chunk"
    elseif info.what ~= "C" then
        return "function <" .. tostring(info.short_src) .. ":" .. tostring(info.linedefined) .. ">"
    end
    local name = globalname(info.func)
    if name ~= nil then
        return "function '" .. name .. "'"
    end

    return "?"
end

-- Lua's debug.traceback([thread,] [message [, level]]): `message` and a
-- "stack traceback:" listing a line for each level from `level` (1, the
-- caller, by default) outward, skipping the middle of a deep stack as Lua
-- does. A message that is neither a string nor a number nor nil is
-- answered as it is. Another thread's levels are not available on the
-- core: its listing is empty. getinfo counts this function as its first
-- level, Lua's level 0, so Lua's level `n` is getinfo's `n + 1`.
local function traceback(...: any): any
    local first: any = ...
    local message: any, level: any = ...
    local current = true
    local position = 2
    if type(first) == "thread" then
        local _: any, threadMessage: any, threadLevel: any = ...
        message, level = threadMessage, threadLevel
        current = rawequal(first, (coroutine.running()))
        position = 3
    end
    if message ~= nil and type(message) ~= "string" and type(message) ~= "number" then
        return message
    end
    local start: integer = current and 1 or 0
    if level ~= nil then
        local number = (type(level) == "number" or type(level) == "string") and tonumber(level) or nil
        local exact = number ~= nil and math.tointeger(number) or nil
        if exact == nil then
            error(
                "bad argument #" .. tostring(
                    position
                ) .. " to 'traceback' (number expected, got " .. type(level) .. ")",
                2
            )
        end
        start = exact as integer
    end
    local parts: {string} = {}
    if message ~= nil then
        parts[1] = tostring(message) .. "\n"
    end
    parts[#parts + 1] = "stack traceback:"
    if current and start >= 0 then
        local last = start - 1
        while getinfo(last + 2, "S") ~= nil do
            last = last + 1
        end
        local limit = last - start > TRACEBACK_HEAD + TRACEBACK_TAIL and TRACEBACK_HEAD or -1
        local at = start
        while true do
            local info = getinfo(at + 1, "Slntf")
            if info == nil then
                break
            end
            at = at + 1
            local shown = limit
            limit = limit - 1
            if shown == 0 then
                local skipped = last - at - TRACEBACK_TAIL + 1
                parts[#parts + 1] = "\n\t...\t(skipping " .. tostring(skipped) .. " levels)"
                at = at + skipped
            else
                local line = info.currentline
                if type(line) == "number" and line > 0 then
                    parts[#parts + 1] = "\n\t" .. tostring(info.short_src) .. ":" .. tostring(line) .. ": in "
                else
                    parts[#parts + 1] = "\n\t" .. tostring(info.short_src) .. ": in "
                end
                parts[#parts + 1] = functionname(info)
                if info.istailcall == true then
                    parts[#parts + 1] = "\n\t(...tail calls...)"
                end
            end
        end
    end

    return table.concat(parts)
end

-- Lua's luaL_checkany: library function `name` was passed `count` values,
-- fewer than reach its argument `index`. Lua refuses a missing argument where
-- it takes a nil one, `tonumber()` where `tonumber(nil)` answers nil.
local function present(count: integer, index: integer, name: string): nil
    if count < index then
        error(string.format("bad argument #%d to '%s' (value expected)", index, name), 3)
    end
end

export const functions: {[string]: any} = {
    package = ambient,
    -- `require` as a value looks where Lua's looks first, package.loaded
    -- then package.preload, which a program fills; then the image's modules.
    require = function(name: string): (any, any)
        local loaded = ambient.loaded[name]
        if loaded ~= nil then
            return loaded
        end
        local preload = ambient.preload[name]
        if preload ~= nil then
            return settle(name, preload(name, PRELOAD)), PRELOAD
        end

        return require(name)
    end,
    tostring = function(...: any): string
        present(select("#", ...), 1, "tostring")
        local value: any = ...
        return tostring(value)
    end,
    tonumber = function(...: any): number?
        present(select("#", ...), 1, "tonumber")
        local value: any, base: any = ...
        if base == nil then
            return tonumber(value)
        end

        return tonumber(value, base as integer)
    end,
    type = function(...: any): string
        present(select("#", ...), 1, "type")
        local value: any = ...
        return type(value)
    end,
    error = function(value: any, level: integer?): nil
        -- A level counts from its caller, a frame further out than the
        -- library function's own.
        local at = level or 1
        error(value, at > 0 and at + 1 or at)
    end,
    assert = function(...: any): ...any
        local count = select("#", ...)
        if count == 0 then
            error("bad argument #1 to 'assert' (value expected)", 2)
        end
        local value, message = ...
        if not value then
            if count < 2 then
                message = "assertion failed!"
            end
            -- As main's and Lua's: the message as it is, with no position.
            error(message, 0)
        end

        return ...
    end,
    rawget = function(t: table, ...: any): any
        present(select("#", ...) + 1, 2, "rawget")
        local key: any = ...
        return rawget(t, key)
    end,
    rawset = function(t: table, ...: any): table
        present(select("#", ...) + 1, 3, "rawset")
        local key: any, value: any = ...
        return rawset(t, key, value)
    end,
    setmetatable = function(t: table, ...: any): table
        -- Lua takes a nil metatable, but not a missing one.
        if select("#", ...) == 0 then
            error("bad argument #2 to 'setmetatable' (nil or table expected, got no value)", 2)
        end
        local metatable: any = ...

        return setmetatable(t, metatable as table?)
    end,
    getmetatable = function(...: any): any
        present(select("#", ...), 1, "getmetatable")
        local value: any = ...
        return getmetatable(value)
    end,
    ["math.floor"] = function(x: number): number
        return math.floor(x)
    end,
    ["math.ceil"] = function(x: number): number
        return math.ceil(x)
    end,
    ["math.abs"] = function(x: number): number
        return math.abs(x)
    end,
    ["math.sqrt"] = function(x: number): number
        return math.sqrt(x)
    end,
    ["string.upper"] = function(s: string): string
        return string.upper(s)
    end,
    ["string.lower"] = function(s: string): string
        return string.lower(s)
    end,
    ["string.len"] = function(s: string): integer
        return string.len(s)
    end,
    ["string.reverse"] = function(s: string): string
        return string.reverse(s)
    end,
    ["string.byte"] = function(s: string, i: integer?, j: integer?): ...integer
        return string.byte(s, i, j)
    end,
    ["coroutine.create"] = function(body: any, ...: any): thread
        return coroutine.create(body, ...)
    end,
    ["coroutine.resume"] = function(co: thread, ...: any): ...any
        return coroutine.resume(co, ...)
    end,
    ["coroutine.yield"] = function(...: any): ...any
        return coroutine.yield(...)
    end,
    ["coroutine.status"] = function(co: thread): string
        return coroutine.status(co)
    end,
    ["coroutine.wrap"] = function(body: any): any
        return coroutine.wrap(body)
    end,
    ["coroutine.running"] = function(): (thread?, boolean)
        return coroutine.running()
    end,
    ["coroutine.isyieldable"] = function(): boolean
        return coroutine.isyieldable()
    end,
    ["coroutine.close"] = function(co: thread): (boolean, any)
        return coroutine.close(co)
    end,
    ["debug.getinfo"] = getinfo,
    ["debug.traceback"] = traceback,
    ["os.getenv"] = function(name: string): string?
        return os.getenv(name)
    end,
    _VERSION = "Lua 5.5",
    next = function(t: table, key: any): (any, any)
        return next(t, key)
    end,
    -- ipairs as a value: Lua's step through t[1], t[2], ... until a nil,
    -- read with the indexing t's metatable gives.
    ipairs = function(...: any): (function(any, integer): (integer?, any), any, integer)
        present(select("#", ...), 1, "ipairs")
        local t: any = ...

        local function step(source: any, index: integer): (integer?, any)
            local following = index + 1
            local value = source[following]
            if value == nil then
                return nil, nil
            end

            return following, value
        end

        return step, t, 0
    end,
    pairs = function(borrows t: table): PairIterator borrows (t)
        -- The builtin traverses synchronously and retains no table beyond the call.
        local nextPair = next as @nosuspend function(borrows source: table, key: any?): (any, any)
        local key: any = nil
        local finished = false
        local iterate: @nosuspend function(): (
            (any, any) | (nil)
        ) borrows (t) = function(): ((any, any) | (nil)) borrows (t)
            if finished then
                return nil
            end
            local found, value = nextPair(t, key)
            key = found
            if found == nil then
                finished = true
                return nil
            end

            return found, value
        end

        return iterate
    end,
    -- The base functions the core calls itself, as values: a chunk Lua's
    -- load compiled calls them through its environment once it no longer
    -- holds these (nupp.compiler.vm.corechunk).
    print = function(...: any): nil
        print(...)
    end,
    pcall = function(f: any, ...: any): ...any
        return pcall(f, ...)
    end,
    xpcall = function(f: any, handler: any, ...: any): ...any
        return xpcall(f, handler, ...)
    end,
    rawequal = function(...: any): boolean
        local count = select("#", ...)
        present(count, 1, "rawequal")
        present(count, 2, "rawequal")
        local a: any, b: any = ...

        return rawequal(a, b)
    end,
    select = function(n: any, ...: any): ...any
        if n == "#" then
            return select("#", ...)
        end

        return select(n as integer, ...)
    end,
    ["string.char"] = function(...: integer): string
        local parts: {string} = {}
        for index = 1, select("#", ...) do
            parts[index] = string.char((select(index, ...)))
        end

        return table.concat(parts)
    end,
    ["string.find"] = function(s: string, pattern: string, init: integer?, plain: boolean?): ...any
        return string.find(s, pattern, init, plain)
    end,
    ["string.match"] = function(s: string, pattern: string, init: integer?): ...any
        return string.match(s, pattern, init)
    end,
    ["string.sub"] = function(s: string, i: integer, j: integer?): string
        return string.sub(s, i, j)
    end,
    ["string.rep"] = function(s: string, n: integer, sep: string?): string
        return string.rep(s, n, sep)
    end,
    ["string.format"] = function(format: string, ...: any): string
        return string.format(format, ...)
    end,
    ["string.gmatch"] = function(s: string, pattern: string): function(): ...any
        local state = hostcalls.gmatchstate(s, pattern)
        return function(): ...any
            local pack = hostcalls.gmatchvalues(state)
            return table.unpack(pack, 1, pack[0] as integer)
        end
    end,
    ["string.gsub"] = function(s: string, pattern: string, replacement: any, n: integer?): (string, integer)
        if type(replacement) == "function" then
            return string.gsub(s, pattern, replacement as function(...: string): any, n)
        elseif type(replacement) == "table" then
            -- Read through its __index, as Lua reads it.
            return string.gsub(s, pattern, replacement as {[string]: string}, n)
        end

        return string.gsub(s, pattern, replacement as string | {[string]: string}, n)
    end,
    ["table.concat"] = function(t: {string}, sep: string?, i: integer?, j: integer?): string
        return table.concat(t, sep, i, j)
    end,
    ["table.unpack"] = function(t: any, i: integer?, j: integer?): ...any
        return table.unpack(t, i, j)
    end,
    unpack = function(t: any, i: integer?, j: integer?): ...any
        return table.unpack(t, i, j)
    end,
    -- Made here as a named vararg is rather than by the core's own form,
    -- which a compiler that does not declare table.pack yet cannot check.
    ["table.pack"] = function(...: any): any
        local packed: any = {...}
        packed.n = select("#", ...)

        return packed
    end,
    ["table.insert"] = function(t: {any}, position: any, value: any): nil
        if value == nil then
            t[#t + 1] = position
        else
            table.insert(t, position as integer, value)
        end
    end,
    ["table.new"] = function(narray: number, nhash: number): table
        return table.new(narray, nhash)
    end,
    ["table.clear"] = function(t: table)
        table.clear(t)
    end,
    ["table.clone"] = function(t: table): table
        return table.clone(t)
    end,
    ["math.random"] = function(...: any): number
        local count = select("#", ...)
        if count == 0 then
            return math.random()
        elseif count == 1 then
            return math.random((select(1, ...) as integer))
        elseif count == 2 then
            return math.random((select(1, ...) as integer), (select(2, ...) as integer))
        end
        error("wrong number of arguments to 'random'", 2)
    end,
    ["math.randomseed"] = function(seed: any, ...: any): nil
        if type(seed) ~= "number" then
            error("expected an integer", 2)
        end
        if seed ~= seed or seed == math.huge or seed == -math.huge or seed % 1 ~= 0 then
            error("expected an exact integer", 2)
        end
        if seed < math.mininteger or seed > math.maxinteger then
            error("integer out of range", 2)
        end
        hostcalls.seedrandom(seed)
    end,
    ["math.type"] = function(x: any): string?
        return math.type(x)
    end,
    ["math.max"] = function(x: number, ...: number): number
        local best = x
        for index = 1, select("#", ...) do
            best = math.max(best, (select(index, ...)))
        end

        return best
    end,
    ["math.min"] = function(x: number, ...: number): number
        local best = x
        for index = 1, select("#", ...) do
            best = math.min(best, (select(index, ...)))
        end

        return best
    end,
    ["math.tointeger"] = function(x: any): integer?
        return math.tointeger(x)
    end,
}

-- The library tables by name, `math` and `string` and `table`: the functions
-- above under their field names, and `math`'s constants.
local mathmembers: {
    [string]: any
} = {huge = math.huge, pi = math.pi, maxinteger = math.maxinteger, mininteger = math.mininteger}
local stringmembers: {[string]: any} = {}
local libraries: {
    [string]: {[string]: any}
} = {math = mathmembers, string = stringmembers, table = {}, coroutine = {}, debug = {}}
for name, value in pairs(functions) do
    local library, field = string.match(name, "^(%a+)%.(%a+)$")
    local members = library and libraries[library]
    if members ~= nil then
        members[field as string] = value
    end
end
-- Scalar functions and namespace aliases read these same canonical tables.
mathmembers.i32 = {}
mathmembers.i32.wrap = function(value: integer): int32
    return scalarcalls.i32wrap(value)
end
mathmembers.i32.add = function(a: int32, b: int32): int32
    return scalarcalls.i32add(a, b)
end
mathmembers.i32.sub = function(a: int32, b: int32): int32
    return scalarcalls.i32sub(a, b)
end
mathmembers.i32.mul = function(a: int32, b: int32): int32
    return scalarcalls.i32mul(a, b)
end
mathmembers.i32.andbits = function(a: int32, b: int32): int32
    return scalarcalls.i32andbits(a, b)
end
mathmembers.i32.orbits = function(a: int32, b: int32): int32
    return scalarcalls.i32orbits(a, b)
end
mathmembers.i32.xorbits = function(a: int32, b: int32): int32
    return scalarcalls.i32xorbits(a, b)
end
mathmembers.i32.notbits = function(a: int32): int32
    return scalarcalls.i32notbits(a)
end
mathmembers.i32.shiftleft = function(a: int32, count: integer): int32
    return scalarcalls.i32shiftleft(a, count)
end
mathmembers.i32.shiftrightarithmetic = function(a: int32, count: integer): int32
    return scalarcalls.i32shiftrightarithmetic(a, count)
end
mathmembers.i32.rotateleft = function(a: int32, count: integer): int32
    return scalarcalls.i32rotateleft(a, count)
end
mathmembers.i32.rotateright = function(a: int32, count: integer): int32
    return scalarcalls.i32rotateright(a, count)
end
mathmembers.i32.lessthan = function(a: int32, b: int32): boolean
    return scalarcalls.i32lessthan(a, b)
end
mathmembers.i32.lessorequal = function(a: int32, b: int32): boolean
    return scalarcalls.i32lessorequal(a, b)
end
mathmembers.i32.fromu32 = function(a: uint32): int32
    return scalarcalls.i32fromu32(a)
end
mathmembers.i32.tou32 = function(a: int32): uint32
    return scalarcalls.i32tou32(a)
end
mathmembers.u32 = {}
mathmembers.u32.wrap = function(value: integer): uint32
    return scalarcalls.u32wrap(value)
end
mathmembers.u32.add = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32add(a, b)
end
mathmembers.u32.sub = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32sub(a, b)
end
mathmembers.u32.mul = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32mul(a, b)
end
mathmembers.u32.div = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32div(a, b)
end
mathmembers.u32.mod = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32mod(a, b)
end
mathmembers.u32.andbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32andbits(a, b)
end
mathmembers.u32.orbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32orbits(a, b)
end
mathmembers.u32.xorbits = function(a: uint32, b: uint32): uint32
    return scalarcalls.u32xorbits(a, b)
end
mathmembers.u32.notbits = function(a: uint32): uint32
    return scalarcalls.u32notbits(a)
end
mathmembers.u32.shiftleft = function(a: uint32, count: integer): uint32
    return scalarcalls.u32shiftleft(a, count)
end
mathmembers.u32.shiftrightlogical = function(a: uint32, count: integer): uint32
    return scalarcalls.u32shiftrightlogical(a, count)
end
mathmembers.u32.rotateleft = function(a: uint32, count: integer): uint32
    return scalarcalls.u32rotateleft(a, count)
end
mathmembers.u32.rotateright = function(a: uint32, count: integer): uint32
    return scalarcalls.u32rotateright(a, count)
end
mathmembers.u32.lessthan = function(a: uint32, b: uint32): boolean
    return scalarcalls.u32lessthan(a, b)
end
mathmembers.u32.lessorequal = function(a: uint32, b: uint32): boolean
    return scalarcalls.u32lessorequal(a, b)
end
mathmembers.u32.fromi32 = function(a: int32): uint32
    return scalarcalls.u32fromi32(a)
end
mathmembers.u32.toi32 = function(a: uint32): int32
    return scalarcalls.u32toi32(a)
end
mathmembers.u32.popcount = function(a: uint32): uint32
    return scalarcalls.u32popcount(a)
end
mathmembers.u32.trailingzeros = function(a: uint32): uint32
    return scalarcalls.u32trailingzeros(a)
end
mathmembers.u32.leadingzeros = function(a: uint32): uint32
    return scalarcalls.u32leadingzeros(a)
end
mathmembers.u64 = {}
mathmembers.u64.andbits = function(a: uint64, b: uint64): uint64
    return scalarcalls.u64andbits(a, b)
end
mathmembers.u64.sub = function(a: uint64, b: uint64): uint64
    return scalarcalls.u64sub(a, b)
end
mathmembers.u64.trailingzeros = function(a: uint64): uint32
    return scalarcalls.u64trailingzeros(a)
end
local float32Members: {[string]: any} = {
    narrow = function(value: number): float32
        return scalarcalls.f32narrow(value)
    end
}
mathmembers.f32 = float32Members

for library, members in pairs(libraries) do
    functions[library] = members
end

-- Builtin strings share this mutable metatable and the actual public library.
hostcalls.stringmeta({__index = stringmembers})

-- `_G`: the library functions above by their global names, and itself.
local globals: {[string]: any} = {}
for name, value in pairs(functions) do
    if string.find(name, ".", 1, true) == nil then
        globals[name] = value
    end
end
globals._G = globals
-- Lua's package.loaded holds `_G` and each standard library table.
ambient.loaded._G = globals
for library in pairs(libraries) do
    ambient.loaded[library] = globals[library]
end
-- `arg`: the program's arguments, as Lua's standalone interpreter sets it.
globals.arg = hostcalls.arguments()
-- `nupp`: the runtime's namespace, which reflection and derive install
-- into, as the VM's globals carry it.
globals.nupp = {}
functions._G = globals

-- Reuse the portable implementations for operations without a core call.
local portablemath = require("nupp.compiler.runtime.math")
local binary32 = portablemath.binary32
for name, implementation in pairs(binary32) do
    if float32Members[name] == nil then
        float32Members[name] = implementation
    end
end
-- And the portable math members the core has none of (`math.lerp`,
-- `math.vec2`), as the VM's bootstrap installs them into `math`. The
-- fixed-width families the core answers keep its own members.
local portable: {[string]: any} = {}
portablemath.install(portable)
for name, member in pairs(portable) do
    if mathmembers[name] == nil then
        mathmembers[name] = member
    end
end

-- Each library function as the program started, by its name (`print`,
-- `io.write`): a chunk Lua's load compiled calls the core directly while
-- its environment still holds that function, and what replaced it when not.
export const originals: {[string]: any} = {}
for name, value in pairs(functions) do
    if type(value) == "function" then
        originals[name] = value
    end
end

-- A separately initialized base library publishes its existing table into
-- both value routes before a standard extension reads it through `_G`.
export function publish(name: string, value: any): nil
    functions[name] = value
    globals[name] = value
    if type(value) == "table" then
        ambient.loaded[name] = value
        for member, entry in pairs(value as table) do
            if type(member) == "string" and type(entry) == "function" then
                originals[name .. "." .. member] = entry
            end
        end
    elseif type(value) == "function" then
        originals[name] = value
    end
end
