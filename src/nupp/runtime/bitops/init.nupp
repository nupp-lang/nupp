module nupp.runtime.bitops

--[[
The implementation behind the explicit bit-operation facade. LuaJIT artifacts
select the native `bit` provider; packages may advertise another provider with
the same names and signatures.

Every operand is normalized to a signed 32-bit word first, so a wider integer
has to be split into limbs by whoever holds it.
]]

local spi = require("nupp.spi")
local contracts = require("nupp.runtime.bitops.spi")

local provider: contracts.Provider = do
    const chosen = spi.select(spi.load(contracts.Provider))
    if chosen ~= nil then
        yield chosen
    end
    yield _G.require("bit") as contracts.Provider
end

export = provider
