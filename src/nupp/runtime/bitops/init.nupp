module nupp.runtime.bitops

--[[
What a bitwise operator lowers to on a target without one.

`a & b` compiles to `a & b` on LuaJIT and to a call on this module under
`--dialect lua51`, so a program reaches it by writing the operator rather than
by naming it. On a host with the native provider it *is* LuaJIT's `bit`; on
stock Lua it is the scalar fallback beneath
[](nupp.runtime.bitops.spi.BitopsProvider), which answers to the same
names and signatures.

Every operand is normalized to a signed 32-bit word first, so a wider integer
has to be split into limbs by whoever holds it.
]]

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")
local contracts = require("nupp.runtime.bitops.spi")

local provider: contracts.BitopsProvider = do
    local chosen: contracts.BitopsProvider?
    local tied = false
    for candidate in spi.load(contracts.BitopsProvider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.runtime.bitops: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    if target.dialect ~= "lua51" then
        yield _G.require("bit") as contracts.BitopsProvider
    end
    yield _G.require("nupp.runtime.provider.scalarbitops") as contracts.BitopsProvider
end

export = provider
