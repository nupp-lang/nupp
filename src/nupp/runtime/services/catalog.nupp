    ["nupp.runtime.representation"] = "representation.cstorage",

    ["nupp.suspension"] = "suspension",
    ["nupp.io.process"] = "host.process",
    ["nupp.io.tls"] = "host.tls",
    ["nupp.io.net"] = "host.net",
    ["nupp.text.buffer"] = "text.buffer",
    ["nupp.runtime.bitops"] = "numeric.bitops",
    ["nupp.runtime.int64"] = "numeric.int64",
    ["nupp.codec.json.provider"] = "data.json",
    ["nupp.crypto"] = "host.crypto",
    ["nupp.io.storage"] = "host.storage",
    ["nupp.time"] = "host.time",
    ["nupp.io.path.provider"] = "host.path",
    ["nupp.io.uri.provider"] = "host.uri",
}

