module nupp.runtime.services.compression

--[[Canonical `nupp.compression` API 1 stream catalog.

Providers expose retained format descriptors. A descriptor creates independent
encoder and decoder state, and every state operation is span based. Step results
are three scalars: input consumed, output written and one of the integer status
constants below. Providers retain neither span and perform no service lookup from
a state operation.
]]

local {type ByteSpan, type ByteWriteSpan} = require("nupp.mem.span")
local services = require("nupp.services")

--- The step needs another input chunk.
export const NEED_INPUT = 1

--- The step filled its output and must be called with more space.
export const NEED_OUTPUT = 2

--- The complete stream and its wrapper trailer have been processed.
export const FINISHED = 3

--- Common identity carried by provider-specific encoder parameter records.
export interface EncoderParameters
    readonly format: string
end

--- Common identity carried by provider-specific decoder parameter records.
export interface DecoderParameters
    readonly format: string
end

--- Independent incremental compression state.
export affine interface Encoder is nupp.Closeable
    terminal close: nosuspend function(takes self: Encoder): nil
    write: function(
        exclusive self: Encoder,
        borrows input: ByteSpan,
        exclusive output: ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
    flush: function(exclusive self: Encoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
    finish: function(exclusive self: Encoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
end

--- Independent incremental decompression state.
export affine interface Decoder is nupp.Closeable
    terminal close: nosuspend function(takes self: Decoder): nil
    read: function(
        exclusive self: Decoder,
        borrows input: ByteSpan,
        exclusive output: ByteWriteSpan
    ): (integer?, integer?, integer?, string?)
    finishInput: function(exclusive self: Decoder, exclusive output: ByteWriteSpan): (integer?, integer?, string?)
end

--- Immutable format identity and typed state factories.
export interface Format
    readonly name: string
    createEncoder: function(self: Format, parameters: EncoderParameters?): Encoder
    createDecoder: function(self: Format, parameters: DecoderParameters?): Decoder
end

--- A selectable implementation catalog.
export interface Provider
    readonly formats: {[string]: Format}
end

local comptime function shape(info: nupp.reflect.Info): any
    local result = {}
    for _, field in ipairs(info.fields) do
        local kinds = {}
        if field.type ~= nil then
            local node = info.types[field.type]
            local arms = node.members
            if node.kind == "union" and arms ~= nil then
                for _, arm in ipairs(arms) do
                    kinds[#kinds + 1] = info.types[arm].kind
                end
            else
                kinds[1] = node.kind
            end
        end
        result[#result + 1] = {name = field.name, kinds = kinds}
    end

    return result
end

--- Select during setup before the compression facade loads.
export const service: services.Service<Provider> = services.define("nupp.compression", 1, nil, comptime do
    return shape(nupp.reflect(Provider))
end)
