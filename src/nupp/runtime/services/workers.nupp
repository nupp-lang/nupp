module nupp.runtime.services.workers

--[[
Typed structured-worker contract for `host.workers` API 1.

Import `service` to select an implementation before requiring [](nupp.workers).
A provider owns its lane scheduler, but uses the canonical Scope, PublicScope,
ScopeToken, Task, and submitted-signature types declared here. Generic spawn must
preserve the exact argument and result packs of the sendable function.

Arguments and results cross isolated Lua states as copies. Only explicitly
supported engine-backed affine owners move; arbitrary closures, pointers,
coroutines, and Lua-owned affine resources cannot be copied as task arguments.
Runtime validation must also reject unsupported value graphs that static types
cannot exclude. A task's result count preserves embedded and trailing nil values.
`await` returns that exact pack or raises failure/cancellation; `isDone` reports
terminal settlement, `status` reports scheduler state, and `cancel` reports
whether it made the first cancellation request.

Scope cleanup settles all children, including those never awaited, before
propagating unobserved failure. Cancellation uses
[](nupp.runtime.services.cancellation). Blocking waits cooperate with the selected
suspension implementation and must not acquire a new service during settlement.

Before loading child consumers, initialize each lane from the artifact catalog,
replay catalog-backed named selections, and require setup modules registered with
`nupp.services.setupWorkers`. Capture that configuration before workers become
active. Instances and Lua closures are never transferred; runtime-only
registrations require explicit setup in the destination state.
]]

local services = require("nupp.services")
local workers = {}

-- What a handle is parameterized by: any function, since a task type is derived from
-- the signature alone and says nothing about where the function came from.
local type Callable = function(...: any): any

--- What may actually be submitted: a module member, or an outlined literal whose
--- effectively-final captures can be copied to another lane. Exported so a task scope
--- can hold its `fork` to the same bound without linking this module.
type workers.Submittable = sendable function(...: any): any

--- Whether one type is an engine-backed owner a lane boundary moves rather than
--- copies: a [](nupp.mem.heap) array of a fixed-width element. The storage lives in
--- neither Lua heap, so handing its pointer to another lane is sound, and the affine
--- layer consumes the sender's binding where the move is written. The element names
--- here must agree with the runtime tag map in `nupp.mem.heap`. See NEP 21.
local comptime function movableOwner(T: type): boolean
    local described = nupp.types.describe(T) as {[string]: any}
    if described.kind ~= "reference" then
        return false
    end
    local nominal = described.nominal as {[string]: any}
    if nominal == nil or nominal.moduleName ~= "nupp.mem.heap" or nominal.name ~= "Array" then
        return false
    end
    local arguments = nupp.types.arguments(T)
    if arguments[1] == nil then
        return false
    end
    local element = nupp.types.describe(arguments[1]) as {[string]: any}
    if element.kind ~= "primitive" then
        return false
    end
    local movable = {
        uint8 = true,
        int8 = true,
        uint16 = true,
        int16 = true,
        uint32 = true,
        int32 = true,
        uint64 = true,
        int64 = true,
        float = true,
        number = true,
    }

    return movable[element.name as string] == true
end

--- Why one type in a submitted signature can never cross a lane boundary, or nil when
--- nothing about it rules that out.
---
--- Arguments and results are copied between isolated Lua states, so a type no copy can
--- reproduce is a mistake in the signature rather than in one call. Only what can never
--- cross is named here. `any`, a bare `table`, and a record say nothing definite about
--- the value that will arrive, and identity -- a cycle, a repeated table, depth -- is a
--- property of values rather than of their types. Both stay with the copy itself.
---
--- The walk terminates on a self-referential type because the edge that would close the
--- loop is one the compile-time view of a type does not carry.
local comptime function unsendable(T: type, label: string): string?
    local named = {
        thread = "a thread",
        userdata = "userdata",
        cdata = "cdata",
        cstring = "a C string",
        voidptr = "a pointer",
    }
    local pending = {{at = T, path = label}}
    local index: integer = 1
    while index <= #pending do
        local item = pending[index]
        index = index + 1
        local kind = nupp.types.kind(item.at)
        if kind == "primitive" then
            local why = named[nupp.types.describe(item.at).name]
            if why ~= nil then
                return item.path .. " is " .. why
            end
        elseif kind == "function" then
            return item.path .. " is a function"
        elseif kind == "affine" then
            -- An affine owner of engine-backed storage moves: the message carries its
            -- pointer, and the receiving lane becomes the one owner. Anything whose
            -- representation lives in a Lua heap keeps the refusal.
            local inner = nupp.types.elements(item.at)
            if inner == nil or not movableOwner(inner[1]) then
                return item.path .. " is an affine owner"
            end
        elseif kind == "ptr" or kind == "carray" then
            return item.path .. " is a C pointer"
        elseif kind == "array" then
            for _, element in ipairs(nupp.types.elements(item.at)) do
                pending[#pending + 1] = {at = element, path = item.path .. "[]"}
            end
        elseif kind == "tuple" then
            for position, member in ipairs(nupp.types.elements(item.at)) do
                pending[#pending + 1] = {at = member, path = item.path .. "[" .. tostring(position) .. "]"}
            end
        elseif kind == "union" or kind == "intersection" then
            for position, member in ipairs(nupp.types.elements(item.at)) do
                pending[#pending + 1] = {at = member, path = item.path .. " (alternative " .. tostring(position) .. ")"}
            end
        elseif kind == "const" or kind == "borrowed" or kind == "pinned" then
            for _, inner in ipairs(nupp.types.elements(item.at)) do
                pending[#pending + 1] = {at = inner, path = item.path}
            end
        elseif kind == "shape" then
            for _, field in ipairs(nupp.types.describe(item.at).fields or {}) do
                if field.read ~= nil then
                    pending[#pending + 1] = {at = field.read, path = item.path .. "." .. field.name}
                end
            end
        end
    end

    return nil
end

--- The arguments a submitted function takes, once its whole signature is known to be
--- copyable. Reached only from `spawn`: naming `Task<F>` describes a handle rather than
--- a crossing, so a signature is held to this where it is submitted and nowhere else.
comptime function workers.Submitted(F: type): typepack
    if nupp.types.kind(F) ~= "function" then
        return nupp.types.error("a worker task must name a function type")
    end
    local packs = {{of = nupp.types.parameters(F), what = "argument"}, {of = nupp.types.results(F), what = "result"},}
    for _, one in ipairs(packs) do
        local described = nupp.types.describe(one.of)
        -- An ownership mode is a promise about one Lua heap: the caller's. Named before
        -- the types are walked, because a pack carrying one cannot be rebuilt at all
        -- and would otherwise report that instead of the reason.
        local headTypes = described.head as {any} or {}
        for position, mode in ipairs(described.modes or {}) do
            -- One exception: a `takes` parameter whose type is an engine-backed owner
            -- is a move rather than a copy, and the affine layer consumes the caller's
            -- binding at the spawn. Every other ownership mode keeps the refusal.
            local moved = mode == "takes" and one.what == "argument" and movableOwner(headTypes[position])
            if mode ~= "plain" and not moved then
                return nupp.types.error(
                    one.what .. " " .. tostring(
                        position
                    ) .. " is an owner or a borrow, which cannot cross into another Lua state"
                )
            end
        end
        for position, member in ipairs(described.head or {}) do
            local why = unsendable(member, one.what .. " " .. tostring(position))
            if why ~= nil then
                return nupp.types.error(why .. ", which cannot cross into another Lua state")
            end
        end
        if described.tail ~= nil then
            local why = unsendable(described.tail, "every extra " .. one.what)
            if why ~= nil then
                return nupp.types.error(why .. ", which cannot cross into another Lua state")
            end
        end
    end

    return nupp.types.parameters(F)
end

local comptime function TaskType(F: type): type
    if nupp.types.kind(F) ~= "function" then
        return nupp.types.error("a worker task must name a function type")
    end
    return nupp.types.shape({
        {
            name = "await",
            read = nupp.types.function_(
                nupp.types.pack({
                    nupp.types.any
                }),
                nupp.types.results(F)
            ),
        },
        {
            name = "isDone",
            read = nupp.types.function_(
                nupp.types.pack({
                    nupp.types.any
                }),
                nupp.types.pack({
                    nupp.types.boolean
                })
            ),
        },
        {
            name = "status",
            read = nupp.types.function_(
                nupp.types.pack({
                    nupp.types.any
                }),
                nupp.types.pack({
                    nupp.types.string
                })
            ),
        },
        {
            name = "cancel",
            read = nupp.types.function_(
                nupp.types.pack({
                    nupp.types.any,
                    nupp.types.optional(nupp.types.string)
                }),
                nupp.types.pack({nupp.types.boolean})
            ),
        },
    })
end

--- The typed handle for one submitted function.
type workers.Task<F is Callable> = TaskType(F)

--- The cleanup contract a structured worker scope carries.
affine interface workers.ScopeToken
    terminal readonly drop: function(takes self: workers.ScopeToken): nil
end

--- A lexical family of parallel child tasks.
record workers.Scope is workers.ScopeToken
    _scheduler: any
    _tasks: {any}
    _closed: boolean
    _deadline: number?
    _observer: any

    --- Starts one sendable function with copied arguments.
    spawn: function<F is workers.Submittable>(
        borrows self: workers.Scope,
        F,
        ...: unpackof workers.Submitted(F)
    ): workers.Task<F>

    --- Waits for every child. Idempotent.
    close: function(borrows self: workers.Scope): nil

    --- Closes the scope on every structured exit. A settling terminal: under a
    --- suspension handler it parks until every child has settled, and without one it
    --- blocks.
    drop: function(takes self: workers.Scope): nil

    _cancelAll: function(workers.Scope, string?): nil
end

interface workers.PublicScope is workers.ScopeToken
    readonly spawn: function<F is workers.Submittable>(
        borrows self: workers.PublicScope,
        F,
        ...: unpackof workers.Submitted(F)
    ): workers.Task<F>
    readonly close: function(borrows self: workers.PublicScope): nil
    readonly drop: function(takes self: workers.PublicScope): nil
end

--- Complete worker implementation protocol, including structured-task integration.
--- Implement generic spawn and ownership guarantees through the shared scope types.
interface workers.Provider
    --- Creates an affine structured scope that settles children during cleanup.
    readonly scope: function(): affine(workers.PublicScope)

    --- Creates canonical scope state for task integration, with an optional
    --- monotonic deadline and observer.
    readonly openScope: function(deadline: number?, observer: any): workers.Scope

    --- Waits for a task and returns status, packed values, exact count, and problem.
    --- Status is done, failed, or cancelled; cancellation preserves its shared
    --- identity.
    readonly settle: function(task: any): (string, {any}?, integer, any)

    --- Reports the scheduler's available worker parallelism.
    readonly parallelism: function(): integer

    --- Runs provider scheduler progress using its retained lane state.
    readonly runScheduler: function(): nil

    --- Associates an executable function with its module/member identity.
    readonly defineSendable: function(moduleName: string, member: string, fn: any): nil

    --- Describes a submitted function and captures for destination-lane execution.
    readonly describeSendable: function(fn: any, moduleName: string, member: string, ...: any): any
end

local comptime function shape(info: nupp.reflect.Info): any
    local result = {}
    for _, field in ipairs(info.fields) do
        local kinds = {}
        if field.type ~= nil then
            local node = info.types[field.type]
            local arms = node.members
            if node.kind == "union" and arms ~= nil then
                for _, arm in ipairs(arms) do
                    kinds[#kinds + 1] = info.types[arm].kind
                end
            else
                kinds[1] = node.kind
            end
        end
        result[#result + 1] = {name = field.name, kinds = kinds}
    end

    return result
end

local service: services.Service<workers.Provider> = services.define("host.workers", 1, nil, comptime do
    return shape(nupp.reflect(workers.Provider))
end)

--- Canonical host.workers API 1 handle; select before the workers facade loads.
workers.service = service

workers.Scope = workers.Scope

export = workers
