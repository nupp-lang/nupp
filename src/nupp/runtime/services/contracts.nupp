    return shape(nupp.reflect(TimeProvider))
end)

export record UriParts
    text: string
    scheme: string
    authority: string?
    username: string
    password: string?
    host: string?
    port: integer?
    path: string
    query: string?
    fragment: string?
end

export interface UriTextProvider
    readonly parse: function(text: string): (UriParts?, string?)
end

export const uri: services.Service<UriTextProvider> = services.define("host.uri", 1, nil, comptime do
    return shape(nupp.reflect(UriTextProvider))
end)

