@!internal

--[[
Lua's `load`, `loadfile`, `dofile` and LuaJIT's `loadstring` on the native
core. A binary chunk installs into the running program
(`hostcalls.install`), whose entry answers the chunk's function as it
starts. A text chunk is compiled to one by the compiler running on the core
(`nupp.compiler.vm.corechunk`), which a program carries by naming it
(`@requires-dynamically`); one that only returns a literal answers it
without, as the compiler's own `loadstring("return " .. token)` reads a
literal's value. A compiled chunk's globals are fields of the environment
`load` was given, as Lua's _ENV, else of the running program's `_G`.
]]
module nupp.runtime.luaload

const hostcalls = require("nupp.runtime.hostcalls")
const libraryvalues = require("nupp.runtime.libraryvalues")
const chunkfiles = require("nupp.runtime.chunkfiles")
const corecallvalues = require("nupp.runtime.corecallvalues")

-- The environment (Lua's _ENV) `load` was given for the chunk now starting.
local pending: table? = nil

--- The environment a chunk the compiler wrote reads its globals from, as it
--- starts: the table `load` was given, else the running program's `_G`; and
--- the library functions as the program started, which the chunk calls the
--- core for directly while its environment holds them.
export function environment(): (any, any)
    return pending or libraryvalues.functions._G, libraryvalues.originals
end

-- The compiler a text chunk compiles with, required by a name the program
-- carries only where it names it.
const COMPILER = "nupp.compiler.vm.corechunk"
-- What requiring it answered: its module, or false where it is not carried
-- or raised as it loaded, and then why.
local compiler: any = nil
local missing: string = ""

local function textCompiler(): any
    if compiler == nil then
        -- While it loads there is none: a require of a module it does not
        -- carry compiles nothing (requirevalue).
        compiler = false
        local loader: function(string): any = require
        local ok, found = pcall(loader, COMPILER)
        compiler = ok and found or false
        missing = ok and "" or tostring(found)
    end

    return compiler or nil
end

-- The byte a binary chunk starts with, as Lua's signature does.
const BINARY = 27
const DEFAULT_MODE = "bt"
const READER_NAME = "=(load)"
-- How much of a string chunk's first line its name shows.
const SHOWN = 40

-- What a short string's escape after `\` stands for, where it is one byte.
const ESCAPES: {
    [string]: string
} = {
    n = "\n",
    t = "\t",
    r = "\r",
    a = "\a",
    b = "\b",
    f = "\f",
    v = "\v",
    ["\\"] = "\\",
    ["\""] = "\"",
    ["'"] = "'",
    ["\n"] = "\n"
}
-- The largest byte a decimal escape names, and the largest code point a
-- `\u{...}` escape does.
const BYTE_LIMIT = 255
const CODE_LIMIT = 0x7FFFFFFF

-- Code point `code` in UTF-8, as Lua's `\u{...}` escape writes it, up to
-- the six bytes Lua allows.
local function utf8bytes(code: integer): string
    if code < 0x80 then
        return string.char(code)
    end
    local tail: {string} = {}
    local limit = 0x3F
    while code > limit do
        table.insert(tail, 1, string.char(0x80 | (code & 0x3F)))
        code = code >> 6
        limit = limit >> 1
    end
    local lead = (0xFF << (7 - #tail)) & 0xFF

    return string.char(lead | code) .. table.concat(tail)
end

-- The value of short string literal `body`, quotes included, or nil when
-- it is not exactly one.
local function shortstring(body: string): string?
    local quote = body:sub(1, 1)
    local out: {string} = {}
    local at = 2
    while at <= #body do
        local c = body:sub(at, at)
        if c == quote then
            return at == #body and table.concat(out) or nil
        elseif c == "\n" then
            return nil
        elseif c == "\\" then
            local e = body:sub(at + 1, at + 1)
            local simple = ESCAPES[e]
            if simple ~= nil then
                out[#out + 1] = simple
                at = at + 2
            elseif e == "x" then
                local hex = body:match("^%x%x", at + 2)
                if hex == nil then
                    return nil
                end
                out[#out + 1] = string.char(tonumber(hex, 16) as integer)
                at = at + 4
            elseif e == "z" then
                at = at + 2 + #(body:match("^%s*", at + 2) as string)
            elseif e == "u" then
                local hex = body:match("^{(%x+)}", at + 2)
                local code = hex and tonumber(hex, 16) as integer?
                if hex == nil or code == nil or code > CODE_LIMIT then
                    return nil
                end
                out[#out + 1] = utf8bytes(code)
                at = at + 4 + #hex
            elseif e:match("^%d$") then
                local digits = body:match("^%d%d?%d?", at + 1) as string
                local code = tonumber(digits) as integer
                if code > BYTE_LIMIT then
                    return nil
                end
                out[#out + 1] = string.char(code)
                at = at + 1 + #digits
            else
                return nil
            end
        else
            out[#out + 1] = c
            at = at + 1
        end
    end

    return nil
end

-- The value of long string literal `body`, brackets included, or nil.
local function longstring(body: string): string?
    local level = body:match("^%[(=*)%[")
    if level == nil then
        return nil
    end
    local close = "]" .. level .. "]"
    local open = #level + 2
    if body:sub(-#close) ~= close or #body < open + #close then
        return nil
    end
    local text = body:sub(open + 1, #body - #close)
    if text:find(close, 1, true) ~= nil then
        return nil
    end
    -- A newline straight after the opening bracket is not part of it.
    if text:sub(1, 1) == "\n" then
        text = text:sub(2)
    end

    return text
end

-- The value of a text chunk that only returns one literal (a number, a
-- string, true, false or nil): what Lua's loaders answer for one without
-- the compiler. Answers whether it is one, and the value.
local function literal(text: string): (boolean, any)
    local body = text:match("^%s*return%s+(.-)%s*;?%s*$")
    if body == nil then
        return false, nil
    elseif body == "true" then
        return true, true
    elseif body == "false" then
        return true, false
    elseif body == "nil" then
        return true, nil
    end
    local first = body:sub(1, 1)
    if first == "\"" or first == "'" then
        local value = shortstring(body)
        return value ~= nil, value
    elseif first == "[" then
        local value = longstring(body)
        return value ~= nil, value
    elseif body:match("^%-?%.?%d") then
        local value = tonumber(body)
        return value ~= nil, value
    end

    return false, nil
end

-- The name an error message gives chunk `name`, as Lua's `luaO_chunkid` does.
local function chunkid(name: string): string
    local first = name:sub(1, 1)
    if first == "=" or first == "@" then
        return name:sub(2)
    end
    local line = name:match("^[^\n]*") as string
    if #line < #name or #line > SHOWN then
        return "[string \"" .. line:sub(1, SHOWN) .. "...\"]"
    end

    return "[string \"" .. line .. "\"]"
end

-- The text of chunk `chunk`: itself, or the pieces a reader function
-- answers until one is nil or empty; nil and a message for a reader that
-- answers anything else.
local function gather(chunk: any): (string?, string?)
    if type(chunk) == "string" then
        return chunk as string, nil
    end
    local pieces: {string} = {}
    while true do
        local piece: any = chunk()
        if piece == nil or piece == "" then
            break
        end
        if type(piece) ~= "string" then
            return nil, "reader function must return a string"
        end
        pieces[#pieces + 1] = piece as string
    end

    return table.concat(pieces), nil
end

-- Binary chunk `bytes` installed and started with environment `env` (Lua's
-- _ENV): what its entry answers, or nil and why it does not install.
local function started(bytes: string, chunkname: string, env: table?): (any, string?)
    local entry = hostcalls.install(bytes)
    if entry == nil then
        return nil, chunkid(chunkname) .. ": bad binary format (not a chunk this core loads)"
    end

    -- A chunk the compiler wrote reads its environment as it starts.
    pending = env
    local ok, value = pcall(function(): any
        return hostcalls.start(entry)
    end)
    pending = nil
    if not ok then
        error(value, 0)
    end

    return value, nil
end

-- The checkout sources are read from: where NUPP_COMPILER_ROOT names, else
-- the working directory.
local function checkout(): string?
    local named = os.getenv("NUPP_COMPILER_ROOT")

    return named ~= nil and named ~= "" and named or nil
end

-- The name a chunk is kept under for the file at `path` (chunkfiles): its
-- path below the checkout, as the host compiled it, or `path` itself.
local function keptname(path: string): string
    local root = checkout()
    if root ~= nil and path:sub(1, #root + 1) == root .. "/" then
        return path:sub(#root + 2)
    end

    return path
end

-- The text of the file at `path`, or nil and why it does not open.
local function contents(path: string): (string?, string?)
    local file, reason = io.open(path, "rb")
    if file == nil then
        return nil, tostring(reason)
    end
    local text: string = file:read("a") or ""
    file:close()

    return text, nil
end

-- The binary chunk of source `text` named `chunkname`, the file at `path`
-- when there is one: itself where it is one, else the chunk kept for it
-- (chunkfiles, by its path or its text), else what the compiler on the core
-- makes of it, as a module instance for `module`; or nil and why it does
-- not compile. A file's Unix exec line is skipped, as Lua skips it.
local function compiled(text: string, chunkname: string, path: string?, module: boolean): (string?, string?)
    if text:byte(1) == BINARY then
        return text, nil
    end
    local kept = chunkfiles.lookup(path and keptname(path), text)
    if kept ~= nil then
        return kept, nil
    end
    local compile = textCompiler()
    if compile == nil then
        return nil, chunkid(chunkname) .. ": text chunks need the compiler, which did not load: " .. missing
    end
    if module then
        return compile.compileModule(text, chunkid(chunkname), chunkname)
    end

    return compile.compile(path and chunkfiles.execLineSkipped(text) or text, chunkid(chunkname), chunkname)
end

local function loadchunk(chunk: any, name: string?, mode: string?, env: table?): (any, string?)
    if type(chunk) ~= "string" and type(chunk) ~= "function" then
        error("bad argument #1 to 'load' (string expected, got " .. type(chunk) .. ")", 2)
    end
    local text, problem = gather(chunk)
    if text == nil then
        return nil, problem
    end
    local chunkname = name or (type(chunk) == "string" and text or READER_NAME)
    local allowed = mode or DEFAULT_MODE
    local binary = text:byte(1) == BINARY
    if binary and not allowed:find("b", 1, true) then
        return nil, "attempt to load a binary chunk (mode is '" .. allowed .. "')"
    elseif not binary and not allowed:find("t", 1, true) then
        return nil, "attempt to load a text chunk (mode is '" .. allowed .. "')"
    end
    if not binary then
        local found, value = literal(text)
        if found then
            return function(): any
                return value
            end, nil
        end
        local bytes, problem = compiled(text, chunkname, nil, false)
        if bytes == nil then
            return nil, problem
        end
        text = bytes as string
    end

    return started(text, chunkname, env)
end

--- A fresh instance of the Nupp module whose source, or binary chunk
--- (`nupp.compiler.vm.corechunk.compileModule`'s), is the file at `path`: its
--- body runs again in a copy of its own, its globals are fields of `env`
--- and its requires call `env.require`, which may
--- answer a stand-in for any module, the core's own calls
--- (`nupp.runtime.gccalls`) included. Answers the module's value, and raises
--- what reading, compiling or running it raises.
export function instance(path: string, env: table): any
    local text, reason = contents(path)
    if text == nil then
        error("cannot open " .. tostring(reason), 2)
    end
    local chunkname = "@" .. path
    local bytes, refused = compiled(text, chunkname, path, true)
    if bytes == nil then
        error(refused, 2)
    end
    local value, problem = started(bytes, chunkname, env)
    if problem ~= nil then
        error(problem, 2)
    end

    return value
end

local function loadpath(filename: string?, mode: string?, env: table?): (any, string?)
    local text: string = ""
    local name = "=stdin"
    if filename == nil then
        text = io.read("a") or ""
    else
        local read, reason = contents(filename)
        if read == nil then
            return nil, "cannot open " .. tostring(reason)
        end
        text = read
        name = "@" .. filename
    end
    -- A chunk compiled from this very text ahead of time, where one is kept
    -- (chunkfiles), loads in its place.
    local kept = filename ~= nil and chunkfiles.lookup(filename, text) or nil

    return loadchunk(kept ?? chunkfiles.execLineSkipped(text), name, mode, env)
end

local function runpath(filename: string?): ...any
    local chunk, problem = loadpath(filename, nil, nil)
    if chunk == nil then
        error(problem, 0)
    end

    return chunk()
end

-- What the core says of a module its image does not hold.
const NOT_IN_IMAGE = "no module of that name in the image"

-- The first file `package.path`'s templates name for module `name` that
-- opens, as Lua's package.searchpath finds it, or nil.
local function searchpath(name: string, templates: string): string?
    local file = name:gsub("%.", "/")
    for template in templates:gmatch("[^;]+") do
        local candidate = template:gsub("%?", file)
        local handle = io.open(candidate, "rb")
        if handle ~= nil then
            handle:close()
            return candidate
        end
    end

    return nil
end

-- Where a module the image does not carry has its source, below the
-- checkout: Nupp before Lua, as the VM's loader looks.
const SOURCE_TEMPLATES: {string} = {"src/?.nupp", "src/?/init.nupp", "src/?.lua", "src/?/init.lua"}
const NUPP_SUFFIX = ".nupp"

-- Module `name` from its source under the checkout's src/, which the image
-- does not carry: its kept chunk, else compiled on the core, Nupp source as
-- a module instance whose requires go through the program's `require`.
-- Answers what it settles as, and the file; nil where there is no source.
local function sourcemodule(name: string): (any, string?)
    if compiler == false then
        -- The compiler itself, while it loads, or a program without it.
        return nil, nil
    end
    local file = name:gsub("%.", "/")
    local root = checkout()
    for _, template in ipairs(SOURCE_TEMPLATES) do
        local relative = template:gsub("%?", file)
        local path = relative
        local text = contents(path)
        if text == nil and root ~= nil then
            path = root .. "/" .. relative
            text = contents(path)
        end
        if text ~= nil then
            local module = relative:sub(-#NUPP_SUFFIX) == NUPP_SUFFIX
            local bytes, problem = compiled(text, "@" .. path, path, module)
            if bytes == nil then
                error("error loading module '" .. name .. "' from file '" .. path .. "':\n\t" .. tostring(problem), 3)
            end
            local value: any = nil
            if module then
                value = started(bytes, "@" .. path, libraryvalues.functions._G)
            else
                local chunk: any = started(bytes, "@" .. path, nil)
                value = chunk(name, path)
            end

            return libraryvalues.settle(name, value), path
        end
    end

    return nil, nil
end

-- Lua's `require` for chunks: the program's (package.loaded, package.preload,
-- then the modules its image holds), then a Lua file on `package.path`,
-- loaded as `loadfile` loads one, as Lua's file searcher does, then a
-- module's source under the checkout (sourcemodule).
local programRequire: function(string): (any, any) = libraryvalues.functions.require

local function requirevalue(name: string): (any, any)
    local ok, value, extra = pcall(programRequire, name)
    if ok then
        return value, extra
    end
    local ambient: any = libraryvalues.functions.package
    local filename = type(value) == "string"
        and (value as string):find(NOT_IN_IMAGE, 1, true) ~= nil
        and searchpath(name, tostring(ambient.path))
        or nil
    if filename ~= nil then
        local chunk, problem = loadpath(filename, nil, nil)
        if chunk ~= nil then
            return libraryvalues.settle(name, chunk(name, filename)), filename
        end
        error("error loading module '" .. name .. "' from file '" .. filename .. "':\n\t" .. tostring(problem), 2)
    end
    if type(value) == "string" and (value as string):find(NOT_IN_IMAGE, 1, true) ~= nil then
        local found, source = sourcemodule(name)
        if source ~= nil then
            return found, source
        end
    end
    error(value, 0)
end

export const functions: {
    [string]: any
} = {load = loadchunk, loadstring = loadchunk, loadfile = loadpath, dofile = runpath, require = requirevalue}

-- Lua chunks read the loaders as globals (`pcall(dofile, path)`).
for name, value in pairs(functions) do
    libraryvalues.publish(name, value)
end

-- A module instance's require of a core call module its environment stands
-- in for nothing answers the module's operations as values, as Lua's
-- require answers what package.loaded holds.
for name, value in pairs(corecallvalues.modules) do
    libraryvalues.functions.package.loaded[name] = value
end
