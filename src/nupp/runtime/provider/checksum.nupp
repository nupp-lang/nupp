@!internal
module nupp.runtime.provider.checksum

--[[Built-in incremental checksum catalog for `nupp.checksum` API 1.

Module initialization retains the fixed algorithm descriptors from the ordinary
checksum implementation. It creates no mutable algorithm state. Factories return
independent affine contexts; updates keep bounded state and do not retain spans.
The public facade selects and validates this catalog during require-time assembly.
Calls through retained descriptors perform no service resolution.
]]

local contract = require("nupp.runtime.services.checksum")
local builtin = require("nupp.checksum.internal.builtin")
local algorithms: {[string]: contract.Algorithm} = {}
for _, name in ipairs(builtin.names()) do
    algorithms[name] = assert(builtin.lookup(name))
end
local provider: contract.Provider = {algorithms = algorithms}
export = provider
