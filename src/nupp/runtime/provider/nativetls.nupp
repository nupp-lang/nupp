@!internal

module nupp.runtime.provider.nativetls

--[[
The VM's native TLS provider for [](nupp.io.tls): the same polling protocol as
the LuaJIT provider, written over the VM's `nupp.vm.net` primitives. Sessions
take the stream handles of [](nupp.runtime.provider.nativenet), whose readiness
pump also drives them, and destroying a session closes the stream it owns.
]]

local contract = require("nupp.io.tls.spi")
const host = require("nupp.vm.net")

local function reason(prefix: string, problem: string?): string
    return prefix .. ": " .. (problem or "unknown error")
end

local provider: contract.Provider = {
    wrap = function(
        self: contract.Provider,
        handle: any,
        server: boolean,
        hostname: string,
        certificate: string,
        privateKey: string,
        authority: string?,
        protocols: string,
        verify: boolean
    ): (any?, string?)
        local session, problem = host.tlsWrap(
            handle as integer,
            server,
            hostname,
            certificate,
            privateKey,
            authority,
            protocols,
            verify
        )
        if session == nil then
            return nil, reason("nupp: could not start the session", problem)
        end

        return session
    end,

    handshake = function(self: contract.Provider, session: any): (boolean?, string?)
        local ready, problem = host.tlsHandshake(session as integer)
        if ready == nil then
            return nil, reason("nupp: the handshake failed", problem)
        end

        return ready
    end,

    verified = function(self: contract.Provider, session: any): boolean
        return host.tlsVerified(session as integer)
    end,

    resumed = function(self: contract.Provider, session: any): boolean
        return host.tlsResumed(session as integer)
    end,

    read = function(self: contract.Provider, session: any, wanted: integer): (string?, string?)
        local bytes, problem = host.tlsRead(session as integer, wanted)
        if problem ~= nil then
            return nil, reason("nupp: could not read", problem)
        end

        return bytes
    end,

    write = function(self: contract.Provider, session: any, bytes: string): (integer?, string?)
        local count, problem = host.tlsWrite(session as integer, bytes)
        if problem ~= nil then
            return nil, reason("nupp: could not write", problem)
        end

        return count
    end,

    flushed = function(self: contract.Provider, session: any): (boolean, string?)
        local done, problem = host.tlsFlushed(session as integer)
        if problem ~= nil then
            return false, reason("nupp: could not flush", problem)
        end

        return done
    end,

    closeNotify = function(self: contract.Provider, session: any): (boolean, string?)
        local done, problem = host.tlsCloseNotify(session as integer)
        if problem ~= nil then
            return false, reason("nupp: could not send close_notify", problem)
        end

        return done
    end,

    destroy = function(self: contract.Provider, session: any): nil
        host.tlsDestroy(session as integer)
    end,

    connected = function(self: contract.Provider, session: any): boolean
        return host.tlsConnected(session as integer)
    end,

    protocol = function(self: contract.Provider, session: any): string?
        return host.tlsProtocol(session as integer)
    end,
}

export = provider
