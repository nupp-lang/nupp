@!internal
module nupp.runtime.provider.nativegpu
local native = require("nupp.runtime.native")
local layoutFacts = require("nupp.gpu.layoutfacts").layoutFacts
local span = require("nupp.mem.span")
local ffi = native.ffi
local C = native.C
native.ffi.cdef[[
int32_t nuppNativeV2GpuContextCreate(uint64_t *);
int32_t nuppNativeV2GpuContextDescription(uint64_t, uint8_t *, size_t, size_t *);
int32_t nuppNativeV2GpuContextRelease(uint64_t);
int32_t nuppNativeV2GpuBufferCreate(uint64_t, uint64_t, uint64_t *);
int32_t nuppNativeV2GpuBufferRelease(uint64_t, uint64_t);
int32_t nuppNativeV2GpuBufferUpload(uint64_t, uint64_t, uint64_t, const void *, size_t);
int32_t nuppNativeV2GpuKernelCreate(
    uint64_t, const uint8_t *, size_t, const char *, size_t,
    uint32_t, uint32_t, uint64_t, uint32_t, uint32_t, uint32_t, uint64_t *);
int32_t nuppNativeV2GpuKernelRelease(uint64_t, uint64_t);
int32_t nuppNativeV2GpuBindingsCreate(uint64_t, uint64_t, uint64_t *);
int32_t nuppNativeV2GpuBindingsRelease(uint64_t, uint64_t);
int32_t nuppNativeV2GpuBindingsSetBuffer(
    uint64_t, uint64_t, int32_t, uint32_t, uint64_t, uint64_t, uint64_t);
int32_t nuppNativeV2GpuDispatch(
    uint64_t, uint64_t, uint32_t, uint32_t, uint32_t, const uint8_t *, size_t);
int32_t nuppNativeV2GpuDownloadQueue(uint64_t, uint64_t, uint64_t, uint64_t);
int32_t nuppNativeV2GpuSynchronize(uint64_t);
int32_t nuppNativeV2GpuDownloadRead(
    uint64_t, uint64_t, uint64_t, uint64_t, void *, size_t);
]]

local shared = require("nupp.gpu.types")
local api = require("nupp.gpu.api")
local operations = require("nupp.gpu.operations")
local gpu = {}
type gpu.Buffer<T> = shared.Buffer<T>
gpu.Buffer = shared.Buffer
type gpu.Kernel = shared.Kernel
gpu.Kernel = shared.Kernel
type gpu.ArtifactSet = shared.ArtifactSet
gpu.ArtifactSet = shared.ArtifactSet

type gpu.Shared<T> = shared.Shared<T>
gpu.Shared = shared.Shared
type gpu.Phases = shared.Phases
gpu.Phases = shared.Phases

gpu.destroyContext = shared.destroyContext
gpu.bufferIsDense = operations.bufferIsDense
record gpu.Binding is api.Binding
    readonly _anchor: any
    readonly _kernel: gpu.Kernel
    readonly _read: {integer}
    readonly _write: {integer}
    readonly _readCounts: {integer}
    readonly _writeCounts: {integer}
    readonly _readOffsets: {integer}
    readonly _writeOffsets: {integer}
    readonly _context: any
    readonly _handle: any
    readonly _uniformBytes: integer
    readonly _readonlyBuffers: integer
    _spanCounts: {integer}
    _spanOffsets: {integer}
    _released: boolean

    --- Number of elements dispatched by this binding.
    readonly count: integer

    --- Attaches a resident buffer to one read-only slot. A dispatch-indexed
    --- span asks for `matchCount`, which holds the buffer to one element per
    --- dispatched thread; a cursor-proved span passes false and may be any
    --- length, because its bound check runs inside the shader.
    --- @internal
    setRead: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Attaches a resident buffer to one writable slot.
    --- @internal
    setWrite: function<T>(
        borrows self: gpu.Binding,
        slot: integer,
        borrows buffer: api.Buffer<T>,
        matchCount: boolean
    ): nil

    --- Enqueues the binding with a compiler-laid-out uniform block.
    --- @internal
    dispatchWords: function(borrows self: gpu.Binding, scalars: {uint32}): nil

    dispatchPacked: function(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
end

record gpu.Context is api.KernelContext
    _handle: any
    _closed: boolean

    --- Releases the device, compiled kernels, and resident buffers.
    drop: nosuspend function(takes self: Context): nil

    _destroy: nosuspend function(state: any): nil

    --- Native provider family selected for this device.
    driver: function(borrows self: Context): string

    --- Allocates a typed resident device buffer.
    buffer: function<T>(borrows self: Context, element: ctype<T>, count: integer): api.Buffer<T> borrows (self)

    --- Allocates a dense row-major resident tensor.
    tensor: function<T>(borrows self: Context, element: ctype<T>, shape: {integer}): api.Buffer<T> borrows (self)

    --- Compiles the artifacts emitted beside an `@aot(target = "gpu")` body.
    --- The selected provider chooses its source member from this set.
    --- @internal
    compileGenerated: function(
        borrows self: Context,
        artifacts: gpu.ArtifactSet,
        readonlyBuffers: integer,
        writableBuffers: integer,
        uniformBytes: integer,
        threads: integer?
    ): api.Kernel borrows (self)

    --- Starts attaching a generated kernel to resident buffers. `count` is the
    --- dispatch length, which the compiler takes from the kernel's primary
    --- span; the generated binding fills every slot before dispatching.
    --- @internal
    bindKernel: function(borrows self: Context, borrows kernel: api.Kernel, count: integer): api.Binding borrows (self)

    --- Releases one root buffer's device storage without closing the context.
    --- Refused while commands are queued; synchronize first. Any view of the
    --- buffer is invalid afterwards, and using one raises.
    releaseBuffer: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Releases a compiled kernel no binding uses any more.
    --- @internal
    releaseKernel: function(borrows self: Context, borrows kernel: api.Kernel): nil

    --- Releases a binding's host-side attachment. The kernel and buffers it
    --- named remain the context's.
    --- @internal
    releaseBinding: function(borrows self: Context, exclusive binding: api.Binding): nil

    --- Copies a complete shared span into a resident buffer or view and
    --- enqueues its transfer. It does not wait.
    upload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>, borrows source: span.Span<T>): nil

    --- Enqueues a complete resident-buffer or view download without waiting.
    enqueueDownload: function<T>(borrows self: Context, borrows buffer: api.Buffer<T>): nil

    --- Submits the accumulated command stream and waits for it.
    synchronize: function(borrows self: Context): nil

    --- Copies a download completed by `synchronize()` into a complete writable
    --- span. No GPU work or waiting happens here.
    readDownloaded: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil

    --- Convenience CPU boundary: enqueue, synchronize, and copy out.
    download: function<T>(
        borrows self: Context,
        borrows buffer: api.Buffer<T>,
        exclusive destination: span.WriteSpan<T>
    ): nil
end

local function live(borrows self: gpu.Context): any
    if self._closed or self._handle == nil then
        error("nupp: GPU context is closed", 3)
    end
    return self._handle
end

-- Keep the element type on the span crossing the native boundary. Casting the
-- pointer to bytes would erase its borrow provenance; only the C declaration
-- needs to forget the pointee type.
local function uploadTyped<T>(
    context: any,
    buffer: any,
    borrows source: const T[?],
    offset: integer,
    bytes: integer
): integer
    local call = C.nuppNativeV2GpuBufferUpload as function(
        any,
        any,
        integer,
        borrows source: const T[?],
        integer
    ): integer

    return call(context, buffer, offset, source, bytes)
end

local function readTyped<T>(
    context: any,
    buffer: any,
    borrows destination: T[?],
    offset: integer,
    bytes: integer
): integer
    local call = C.nuppNativeV2GpuDownloadRead as function(
        any,
        any,
        integer,
        integer,
        borrows destination: T[?],
        integer
    ): integer

    return call(context, buffer, offset, bytes, destination, bytes)
end

local function dispatchNative(
    context: any,
    bindings: any,
    count: integer,
    borrows uniforms: const uint8[?],
    bytes: integer
): integer
    local call = C.nuppNativeV2GpuDispatch as function(
        any,
        any,
        integer,
        integer,
        integer,
        borrows uniforms: const uint8[?],
        integer
    ): integer

    return call(context, bindings, count, 1, 1, uniforms, bytes)
end

local contextdestroy = require("nupp.runtime.provider.nativegpurelease").destroy

function gpu.Context.driver(borrows self: gpu.Context): string
    local length = ffi.new("size_t[1]")
    local handle = live(self)
    native.succeeded(C.nuppNativeV2GpuContextDescription(handle, nil, 0, length), 2)
    local output = ffi.new("uint8_t[?]", length[0] + 1)
    native.succeeded(C.nuppNativeV2GpuContextDescription(handle, output, length[0] + 1, length), 2)

    return ffi.string(output, length[0])
end

function gpu.Context.buffer<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    count: integer
): shared.Buffer<T> borrows (self)
    if count < 0 then
        error("nupp: GPU buffer count cannot be negative", 2)
    end
    local width = ffi.sizeof(element) as integer
    if width <= 0 or count == 0 or count > 4294967295 // width then
        error("nupp: GPU buffer must contain 1 through 4294967295 bytes", 2)
    end
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeV2GpuBufferCreate(live(self), width * count, output), 2)
    local handle = output[0]

    return new shared.Buffer(
        _anchor = self,
        _handle = handle,
        _width = width,
        _offset = 0,
        _capacity = count,
        _root = true,
        _released = false,
        _shape = {count},
        _strides = {1},
        count = count
    )
end

function gpu.Context.compileGenerated(
    borrows self: gpu.Context,
    artifacts: gpu.ArtifactSet,
    readonlyBuffers: integer,
    writableBuffers: integer,
    uniformBytes: integer,
    threads: integer?
): gpu.Kernel borrows (self)
    local group = threads or 256
    if readonlyBuffers < 0 or readonlyBuffers > 16 or writableBuffers < 1 or writableBuffers > 16 then
        error("nupp: generated GPU kernels take up to 16 read and 1 through 16 write buffers", 2)
    end
    if uniformBytes < 0 or uniformBytes > 128 then
        error("nupp: GPU uniform block must be from 0 through 128 bytes", 2)
    end
    if group < 1 or group > 1024 then
        error("nupp: GPU thread group must be from 1 through 1024", 2)
    end
    local spans = readonlyBuffers + writableBuffers
    if uniformBytes < 4 * (1 + 2 * spans) then
        error("nupp: GPU uniform block does not contain the generated span header", 2)
    end
    if artifacts.spirv == nil or #artifacts.spirv == 0 or #artifacts.entrypoint == 0 then
        error("nupp: native GPU kernels need non-empty SPIR-V and an entrypoint", 2)
    end
    local output = ffi.new("uint64_t[1]")
    native.succeeded(
        C.nuppNativeV2GpuKernelCreate(
            live(self),
            artifacts.spirv,
            #artifacts.spirv,
            artifacts.entrypoint,
            #artifacts.entrypoint,
            readonlyBuffers,
            writableBuffers,
            uniformBytes,
            group,
            1,
            1,
            output
        ),
        2
    )
    local handle = output[0]

    return new shared.Kernel(
        _anchor = self,
        _handle = handle,
        _uniformBytes = uniformBytes,
        _readonlyBuffers = readonlyBuffers,
        _writableBuffers = writableBuffers,
        _threads = group
    )
end

function gpu.Context.releaseBuffer<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if not buffer._root then
        error("nupp: a GPU view borrows its buffer; release the root buffer", 2)
    end
    native.succeeded(C.nuppNativeV2GpuBufferRelease(live(self), buffer._handle), 2)
end

function gpu.Context.releaseKernel(borrows self: gpu.Context, borrows kernelValue: api.Kernel): nil
    local kernel = kernelValue as gpu.Kernel
    native.succeeded(C.nuppNativeV2GpuKernelRelease(live(self), kernel._handle), 2)
end

function gpu.Context.releaseBinding(borrows self: gpu.Context, exclusive bindingValue: api.Binding): nil
    local binding = bindingValue as gpu.Binding
    if binding._released then
        return
    end
    native.succeeded(C.nuppNativeV2GpuBindingsRelease(live(self), binding._handle), 2)
    binding._released = true
end

function gpu.Binding.setRead<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released then
        error("nupp: GPU binding was released", 2)
    end
    local _, extent, dense = layoutFacts(buffer._shape, buffer._strides, 2)
    if matchCount and not dense then
        error("nupp: dispatch-indexed GPU buffers must be dense", 2)
    end
    if matchCount and extent ~= self.count then
        error("nupp: a dispatch-indexed buffer must hold one element per dispatched thread", 2)
    end
    if slot < 0 or slot >= self._readonlyBuffers then
        error("nupp: read binding slot is outside the compiled kernel", 2)
    end
    native.succeeded(
        C.nuppNativeV2GpuBindingsSetBuffer(
            self._context,
            self._handle,
            0,
            slot,
            buffer._handle,
            0,
            buffer._capacity * buffer._width
        ),
        2
    )
    self._spanCounts[slot + 1] = extent
    self._spanOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.setWrite<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchCount: boolean
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if self._released then
        error("nupp: GPU binding was released", 2)
    end
    local _, extent, dense, injective = layoutFacts(buffer._shape, buffer._strides, 2)
    if not injective or extent ~= buffer.count then
        error("nupp: writable GPU tensor views must be disjoint and cover one complete span extent", 2)
    end
    if matchCount and not dense then
        error("nupp: dispatch-indexed GPU buffers must be dense", 2)
    end
    if matchCount and extent ~= self.count then
        error("nupp: a dispatch-indexed buffer must hold one element per dispatched thread", 2)
    end
    local writable = #self._spanCounts - self._readonlyBuffers
    if slot < 0 or slot >= writable then
        error("nupp: write binding slot is outside the compiled kernel", 2)
    end
    native.succeeded(
        C.nuppNativeV2GpuBindingsSetBuffer(
            self._context,
            self._handle,
            1,
            slot,
            buffer._handle,
            0,
            buffer._capacity * buffer._width
        ),
        2
    )
    local position = self._readonlyBuffers + slot + 1
    self._spanCounts[position] = extent
    self._spanOffsets[position] = buffer._offset
end

function gpu.Binding.dispatchPacked(borrows self: gpu.Binding, uniforms: any, uniformBytes: integer): nil
    if self._released then
        error("nupp: GPU binding was released", 2)
    end
    if uniformBytes ~= self._uniformBytes then
        error("nupp: generated GPU uniform block has the wrong size", 2)
    end
    local spans = #self._spanCounts
    unsafe do
        local words = ffi.cast<uint32[?]>(uniforms)
        words[0] = self.count
        for index = 1, spans do
            words[index] = self._spanCounts[index]
            words[spans + index] = self._spanOffsets[index]
        end
    end
    local uniformPointer = ffi.cast<const uint8[?]>(uniforms)
    native.succeeded(dispatchNative(self._context, self._handle, self.count, uniformPointer, uniformBytes), 2)
end

function gpu.Context.upload<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    borrows source: span.Span<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if not gpu.bufferIsDense(buffer) then
        error("nupp: GPU uploads require a dense tensor view", 2)
    end
    if #source ~= buffer.count then
        error("nupp: GPU upload span length does not match its buffer", 2)
    end
    local pointer, count = source:ref()
    native.succeeded(
        uploadTyped(live(self), buffer._handle, pointer, buffer._offset * buffer._width, buffer._width * count),
        2
    )
end

function gpu.Context.enqueueDownload<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if not gpu.bufferIsDense(buffer) then
        error("nupp: GPU downloads require a dense tensor view", 2)
    end
    native.succeeded(
        C.nuppNativeV2GpuDownloadQueue(
            live(self),
            buffer._handle,
            buffer._offset * buffer._width,
            buffer.count * buffer._width
        ),
        2
    )
end

function gpu.Context.synchronize(borrows self: gpu.Context): nil
    native.succeeded(C.nuppNativeV2GpuSynchronize(live(self)), 2)
end

function gpu.Context.readDownloaded<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: span.WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    if not gpu.bufferIsDense(buffer) then
        error("nupp: GPU downloads require a dense tensor view", 2)
    end
    if #destination ~= buffer.count then
        error("nupp: GPU download span length does not match its buffer", 2)
    end
    local pointer, count = destination:ref()
    native.succeeded(
        readTyped(live(self), buffer._handle, pointer, buffer._offset * buffer._width, buffer._width * count),
        2
    )
end

function gpu.Context.download<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: span.WriteSpan<T>
): nil
    local buffer = bufferValue as gpu.Buffer<T>
    self:enqueueDownload(buffer)
    self:synchronize()
    self:readDownloaded(buffer, destination)
end

--- Opens the preferred WGPU compute device.
--- @export
--- @raises when WGPU has no compatible compute adapter

function gpu.Binding.dispatchWords(borrows self: gpu.Binding, scalars: {uint32}): nil
    error("nupp: native GPU dispatch requires a packed uniform block", 2)
end

function gpu.Context.bindKernel(
    borrows self: gpu.Context,
    borrows kernelValue: api.Kernel,
    count: integer
): gpu.Binding borrows (self)
    local kernel = kernelValue as gpu.Kernel
    if count < 0 or count > 4294967295 then
        error("nupp: GPU dispatch count must be from 0 through 4294967295", 2)
    end
    local context = live(self)
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeV2GpuBindingsCreate(context, kernel._handle, output), 2)
    local handle = output[0]
    local spans = kernel._readonlyBuffers + kernel._writableBuffers
    local spanCounts: {integer} = {}
    local spanOffsets: {integer} = {}
    for index = 1, spans do
        spanCounts[index] = 0
        spanOffsets[index] = 0
    end

    return new gpu.Binding(
        _anchor = self,
        _kernel = kernel,
        _read = {},
        _write = {},
        _readCounts = {},
        _writeCounts = {},
        _readOffsets = {},
        _writeOffsets = {},
        _context = context,
        _handle = handle,
        _uniformBytes = kernel._uniformBytes,
        _readonlyBuffers = kernel._readonlyBuffers,
        _spanCounts = spanCounts,
        _spanOffsets = spanOffsets,
        _released = false,
        count = count
    )
end

function gpu.Context.drop(takes self: gpu.Context): nil
    local state = unsafe release self
    state._destroy(state)
end

function gpu.Context.tensor<T>(
    borrows self: gpu.Context,
    element: ctype<T>,
    shape: {integer}
): api.Buffer<T> borrows (self)
    return operations.tensor(self, element, shape)
end

function gpu.open(): affine(api.KernelContext, api.destroyContext)
    native.requireFeature(4, "GPU support")
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeV2GpuContextCreate(output), 2)
    local handle = output[0]

    return new gpu.Context(_destroy = contextdestroy, _handle = handle, _closed = false)
end

export const open = gpu.open
