@!internal
--[[
Native resident-compute implementation bound to native targets.

`open` creates a device context through [](nupp.runtime.native). The artifact
must carry the native GPU feature and a compatible host driver. Generated shader
artifacts, layout facts, buffer counts, and binding offsets are checked before
dispatch; this module does not choose the compiler's target representation.

Context, buffer, kernel, and binding operations implement [](nupp.gpu.api).
Provider records retain native handles privately while exported values preserve
the canonical public identities and context borrows. The context, its buffers,
kernels and bindings are closeable; closing a child or the context must not leave
a dependent handle usable.

Applications use [](io.gpu), which imports this implementation on native targets
and exports its `open` function directly. Uploads, dispatches, synchronization, and readback
operate on the retained context without further service resolution.
]]
module nupp.runtime.provider.nativegpu

local native = require("nupp.runtime.native")
local suspension = require("nupp.suspension")
local layoutFacts = require("nupp.gpu.layoutfacts").layoutFacts
local span = require("binary.span")
local ffi = native.ffi
local C = native.C
native.ffi.cdef[[
int32_t nuppNativeGpuCostsOutput(const uint8_t *, size_t);
int32_t nuppNativeGpuCostsEnabled(void);
int32_t nuppNativeGpuCostMetadata(uint64_t, uint64_t, int32_t, const uint8_t *, size_t);
int32_t nuppNativeGpuContextCreate(uint64_t *);
int32_t nuppNativeGpuContextDescription(uint64_t, uint8_t *, size_t, size_t *);
int32_t nuppNativeGpuContextRelease(uint64_t);
int32_t nuppNativeGpuBufferCreate(uint64_t, uint64_t, uint64_t *);
int32_t nuppNativeGpuBufferRelease(uint64_t, uint64_t);
int32_t nuppNativeGpuBufferUpload(uint64_t, uint64_t, uint64_t, const void *, size_t);
int32_t nuppNativeGpuKernelCreate(
    uint64_t, const uint8_t *, size_t, const char *, size_t,
    uint32_t, uint32_t, uint64_t, uint32_t, uint32_t, uint32_t, uint64_t *);
int32_t nuppNativeGpuKernelRelease(uint64_t, uint64_t);
int32_t nuppNativeGpuBindingsCreate(uint64_t, uint64_t, uint64_t *);
int32_t nuppNativeGpuBindingsRelease(uint64_t, uint64_t);
int32_t nuppNativeGpuBindingsSetBuffer(
    uint64_t, uint64_t, int32_t, uint32_t, uint64_t, uint64_t, uint64_t);
int32_t nuppNativeGpuDispatch(
    uint64_t, uint64_t, uint32_t, uint32_t, uint32_t, const uint8_t *, size_t);
int32_t nuppNativeGpuDownloadQueue(uint64_t, uint64_t, uint64_t, uint64_t);
int32_t nuppNativeGpuSynchronize(uint64_t);
int32_t nuppNativeGpuSynchronizeReady(uint64_t, uint32_t *);
int32_t nuppNativeGpuDownloadRead(
    uint64_t, uint64_t, uint64_t, uint64_t, void *, size_t);
]]

local shared = require("nupp.gpu.types")
local api = require("nupp.gpu.api")
local operations = require("nupp.gpu.operations")
local {type Scalar} = require("nupp.array")
local gpu = {}

--- @internal
record gpu.Binding is api.Binding
    @readonly _anchor: any

    --- The kernel's state, which the binding reads but does not own.
    @readonly _kernel: shared.KernelView

    @readonly _read: {integer}
    @readonly _write: {integer}
    @readonly _readCounts: {integer}
    @readonly _writeCounts: {integer}
    @readonly _readOffsets: {integer}
    @readonly _writeOffsets: {integer}
    @readonly _bufferStates: {any}
    @readonly _context: any
    @readonly _handle: any
    @readonly _uniformBytes: integer
    @readonly _readonlyBuffers: integer
    _spanCounts: {integer}
    _spanOffsets: {integer}
    _released: boolean

    @readonly count: integer

end

record gpu.Context is api.KernelContext
    _handle: any
    _closed: boolean

    _destroy: @nosuspend function(state: any): nil

    _allocate: function<T>(
        borrows self: Context,
        elementType: T?,
        element: any,
        count: integer,
        dimensions: {integer}?,
        strides: {integer}?
    ): affine(api.Buffer<T>) borrows (self)

    _releaseBuffer: function(borrows self: Context, buffer: any): nil
    _releaseKernel: function(borrows self: Context, handle: any): nil

end

local function live(borrows self: gpu.Context): any
    if self._closed or self._handle == nil then
        error("nupp: GPU context is closed", 3)
    end
    return self._handle
end

local function whole(value: any, what: string, minimum: integer, maximum: integer): integer
    if type(value) ~= "number" or value ~= math.floor(value) or value < minimum or value > maximum then
        error(("nupp: GPU %s must be an integer from %d through %d"):format(what, minimum, maximum), 3)
    end

    return value as integer
end

-- Keep the element type on the span crossing the native boundary. Casting the
-- pointer to bytes would erase its borrow provenance; only the C declaration
-- needs to forget the pointee type.
local function uploadTyped<T>(
    context: any,
    buffer: any,
    borrows source: const T[?],
    offset: integer,
    bytes: integer
): integer
    local call = C.nuppNativeGpuBufferUpload as function(
        any,
        any,
        integer,
        borrows source: const T[?],
        integer
    ): integer

    return call(context, buffer, offset, source, bytes)
end

local function readTyped<T>(
    context: any,
    buffer: any,
    borrows destination: T[?],
    offset: integer,
    bytes: integer
): integer
    local call = C.nuppNativeGpuDownloadRead as function(
        any,
        any,
        integer,
        integer,
        borrows destination: T[?],
        integer
    ): integer

    return call(context, buffer, offset, bytes, destination, bytes)
end

--- The per-dimension workgroup bound every WebGPU device guarantees.
const WORKGROUPS_PER_DIMENSION = 65535

--- Dispatches `count` invocations of a kernel `threads` lanes wide. One
--- dimension holds at most 65535 workgroups, so a longer dispatch folds into
--- rows of that many and the generated shader recovers the linear index from
--- the row; its `index < count` guard retires the tail of the last row. Only a
--- dispatch past 65535 rows is refused, by the device's own check.
local function dispatchNative(
    context: any,
    bindings: any,
    count: integer,
    threads: integer,
    borrows uniforms: const uint8[?],
    bytes: integer
): integer
    local call = C.nuppNativeGpuDispatch as function(
        any,
        any,
        integer,
        integer,
        integer,
        borrows uniforms: const uint8[?],
        integer
    ): integer
    local groups = math.ceil(count / threads)
    if groups <= WORKGROUPS_PER_DIMENSION then
        return call(context, bindings, count, 1, 1, uniforms, bytes)
    end
    local rows = math.ceil(groups / WORKGROUPS_PER_DIMENSION)

    return call(context, bindings, WORKGROUPS_PER_DIMENSION * threads, rows, 1, uniforms, bytes)
end

local contextdestroy = require("nupp.runtime.provider.nativegpurelease").destroy

--- Selects process-local JSONL GPU costs; nil restores NUPP_GPU_COSTS.
function gpu.costsOutput(path: string?): nil
    native.requireFeature(4, "GPU cost instrumentation")
    native.succeeded(C.nuppNativeGpuCostsOutput(path, path and #path or 0), 2)
end

local function costMetadata(context: any, handle: any, kernel: boolean, metadata: any): nil
    if C.nuppNativeGpuCostsEnabled() == 0 then
        return
    end
    local json = require("serde.json")
    if kernel then
        metadata.readonlyNames = json.asarray(metadata.readonlyNames or {})
        metadata.writableNames = json.asarray(metadata.writableNames or {})
    end
    local encoded = json.encodevalue(metadata)
    native.succeeded(C.nuppNativeGpuCostMetadata(context, handle, kernel and 1 or 0, encoded, #encoded), 2)
end

local function costLayout(
    context: any,
    handle: any,
    shape: {integer},
    strides: {integer},
    width: integer,
    offset: integer,
    count: integer
): nil
    if C.nuppNativeGpuCostsEnabled() == 0 then
        return
    end
    costMetadata(context, handle, false, {
        shape = shape,
        strides = strides,
        elementBytes = width,
        elementOffset = offset,
        count = count,
        conversion = "none: typed span bytes preserved"
    })
end

function gpu.Context.driver(borrows self: gpu.Context): string
    local length = ffi.new("size_t[1]")
    local handle = live(self)
    local probed = C.nuppNativeGpuContextDescription(handle, nil, 0, length)
    if probed ~= native.BUFFER_TOO_SMALL then
        native.succeeded(probed, 2)
    end
    local output = ffi.new("uint8_t[?]", length[0])
    native.succeeded(C.nuppNativeGpuContextDescription(handle, output, length[0], length), 2)

    return ffi.string(output, length[0])
end

function gpu.Context.buffer<T>(
    borrows self: gpu.Context,
    element: Scalar<T> | Type<T>,
    count: integer
): affine(api.Buffer<T>) borrows (self)
    return self:_allocate(nil as T, operations.elementType(element), count)
end

function gpu.Context.tensor<T>(
    borrows self: gpu.Context,
    element: Scalar<T> | Type<T>,
    shape: {integer}
): affine(api.Buffer<T>) borrows (self)
    local count, strides, dimensions = operations.denseShape(shape)
    return self:_allocate(nil as T, operations.elementType(element), count, dimensions, strides)
end

function gpu.Context._allocate<T>(
    borrows self: gpu.Context,
    elementType: T?,
    element: any,
    count: integer,
    dimensions: {integer}?,
    strides: {integer}?
): affine(shared.Buffer<T>) borrows (self)
    count = whole(count, "buffer count", 0, 4294967295)
    local width = ffi.sizeof(element) as integer
    if width <= 0 or count == 0 or count > 4294967295 // width then
        error("nupp: GPU buffer must contain 1 through 4294967295 bytes", 3)
    end
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeGpuBufferCreate(live(self), width * count, output), 3)
    local handle = output[0]
    costMetadata(live(self), handle, false, {format = tostring(element), elementBytes = width, shape = {count}})

    return shared.Buffer<T>(
        _elementType = nil,
        _anchor = self,
        _context = self,
        _handle = handle,
        _width = width,
        _offset = 0,
        _capacity = count,
        _root = true,
        _state = {released = false},
        _shape = dimensions or {count},
        _strides = strides or {1},
        count = count
    )
end

function gpu.Context.compilegenerated(
    borrows self: gpu.Context,
    artifacts: api.ArtifactSet,
    readonlybuffers: integer,
    writablebuffers: integer,
    uniformbytes: integer,
    threads: integer?
): api.Kernel borrows (self)
    readonlybuffers = whole(readonlybuffers, "read buffer count", 0, 16)
    writablebuffers = whole(writablebuffers, "write buffer count", 1, 16)
    uniformbytes = whole(uniformbytes, "uniform byte count", 0, 128)
    local group = whole(threads or 256, "thread group", 1, 1024)
    if uniformbytes % 4 ~= 0 then
        error("nupp: GPU uniform block must be from 0 through 128 bytes and aligned to four bytes", 2)
    end
    local spans = readonlybuffers + writablebuffers
    if uniformbytes < 4 * (1 + 2 * spans) then
        error("nupp: GPU uniform block does not contain the generated span header", 2)
    end
    local artifact: any = artifacts
    local spirv, entrypoint = artifact.spirv, artifact.entrypoint
    if type(spirv) ~= "string" or #spirv == 0 or type(entrypoint) ~= "string" or #entrypoint == 0 then
        error("nupp: native GPU kernels need non-empty SPIR-V and an entrypoint", 2)
    end
    local output = ffi.new("uint64_t[1]")
    native.succeeded(
        C.nuppNativeGpuKernelCreate(
            live(self),
            spirv,
            #spirv,
            entrypoint,
            #entrypoint,
            readonlybuffers,
            writablebuffers,
            uniformbytes,
            group,
            1,
            1,
            output
        ),
        2
    )
    local handle = output[0]
    local identity = artifacts as any
    costMetadata(live(self), handle, true, {
        sourceFile = identity.sourcefile,
        sourceLine = identity.sourceline,
        artifactId = identity.artifactid,
        readonlyNames = identity.readonlynames,
        writableNames = identity.writablenames,
        entrypoint = entrypoint
    })

    return shared.Kernel(
        _anchor = self,
        _handle = handle,
        _uniformBytes = uniformbytes,
        _readonlyBuffers = readonlybuffers,
        _writableBuffers = writablebuffers,
        _threads = group,
        _released = false
    )
end

function gpu.Context._releaseBuffer(borrows self: gpu.Context, buffer: any): nil
    if self._closed or self._handle == nil then
        return
    end
    native.succeeded(C.nuppNativeGpuBufferRelease(self._handle, buffer._handle), 3)
end

function gpu.Context._releaseKernel(borrows self: gpu.Context, handle: any): nil
    if self._closed or self._handle == nil then
        return
    end
    native.succeeded(C.nuppNativeGpuKernelRelease(self._handle, handle), 3)
end

function gpu.Binding.close(borrows self: gpu.Binding): nil
    local binding = self
    if binding._released then
        return
    end
    binding._released = true
    local context = binding._anchor
    if context._closed or context._handle == nil then
        return
    end
    native.succeeded(C.nuppNativeGpuBindingsRelease(context._handle, binding._handle), 2)
end

--- The allocation states bound on a side of a binding: its read slots or its
--- write slots.
local function boundStates(borrows binding: gpu.Binding, writing: boolean): {any}
    local readonly = binding._kernel._readonlyBuffers
    local first = writing and readonly + 1 or 1
    local last = writing and readonly + binding._kernel._writableBuffers or readonly
    local states: {any} = {}
    for index = first, last do
        local state = binding._bufferStates[index]
        if state ~= nil then
            states[#states + 1] = state
        end
    end

    return states
end

function gpu.Binding.setread<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchcount: boolean
): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    slot = whole(slot, "read binding slot", 0, 15)
    if self._released or self._kernel._released then
        error("nupp: GPU binding was released", 2)
    end
    if buffer._context ~= self._anchor or buffer._state.released then
        error("nupp: GPU read buffer is unavailable in this context", 2)
    end
    local _, extent, dense = layoutFacts(buffer._shape, buffer._strides, 2)
    if matchcount and not dense then
        error("nupp: dispatch-indexed GPU buffers must be dense", 2)
    end
    if matchcount and extent ~= self.count then
        error("nupp: a dispatch-indexed buffer must hold one element per dispatched thread", 2)
    end
    if slot < 0 or slot >= self._readonlyBuffers then
        error("nupp: read binding slot is outside the compiled kernel", 2)
    end
    operations.refuseReadWriteAlias(boundStates(self, true), buffer._state)
    costLayout(
        self._context,
        buffer._handle,
        buffer._shape,
        buffer._strides,
        buffer._width,
        buffer._offset,
        buffer.count
    )
    native.succeeded(
        C.nuppNativeGpuBindingsSetBuffer(
            self._context,
            self._handle,
            0,
            slot,
            buffer._handle,
            0,
            buffer._capacity * buffer._width
        ),
        2
    )
    self._read[slot + 1] = 1
    self._bufferStates[slot + 1] = buffer._state
    self._spanCounts[slot + 1] = extent
    self._spanOffsets[slot + 1] = buffer._offset
end

function gpu.Binding.setwrite<T>(
    borrows self: gpu.Binding,
    slot: integer,
    borrows bufferValue: api.Buffer<T>,
    matchcount: boolean
): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    slot = whole(slot, "write binding slot", 0, 15)
    if self._released or self._kernel._released then
        error("nupp: GPU binding was released", 2)
    end
    if buffer._context ~= self._anchor or buffer._state.released then
        error("nupp: GPU write buffer is unavailable in this context", 2)
    end
    local _, extent, dense, injective = layoutFacts(buffer._shape, buffer._strides, 2)
    if not injective or extent ~= buffer.count then
        error("nupp: writable GPU tensor views must be disjoint and cover one complete span extent", 2)
    end
    if matchcount and not dense then
        error("nupp: dispatch-indexed GPU buffers must be dense", 2)
    end
    if matchcount and extent ~= self.count then
        error("nupp: a dispatch-indexed buffer must hold one element per dispatched thread", 2)
    end
    local writable = #self._spanCounts - self._readonlyBuffers
    if slot < 0 or slot >= writable then
        error("nupp: write binding slot is outside the compiled kernel", 2)
    end
    operations.refuseReadWriteAlias(boundStates(self, false), buffer._state)
    costLayout(
        self._context,
        buffer._handle,
        buffer._shape,
        buffer._strides,
        buffer._width,
        buffer._offset,
        buffer.count
    )
    native.succeeded(
        C.nuppNativeGpuBindingsSetBuffer(
            self._context,
            self._handle,
            1,
            slot,
            buffer._handle,
            0,
            buffer._capacity * buffer._width
        ),
        2
    )
    self._write[slot + 1] = 1
    local position = self._readonlyBuffers + slot + 1
    self._bufferStates[position] = buffer._state
    self._spanCounts[position] = extent
    self._spanOffsets[position] = buffer._offset
end

function gpu.Binding.dispatchpacked(borrows self: gpu.Binding, uniforms: any, uniformbytes: integer): nil
    if self._released or self._kernel._released then
        error("nupp: GPU binding or kernel was released", 2)
    end
    for index = 1, self._kernel._readonlyBuffers do
        if self._read[index] == nil then
            error("nupp: GPU binding is incomplete", 2)
        end
    end
    for index = 1, self._kernel._writableBuffers do
        if self._write[index] == nil then
            error("nupp: GPU binding is incomplete", 2)
        end
    end
    for _, state in ipairs(self._bufferStates) do
        if state.released then
            error("nupp: GPU binding contains a released buffer", 2)
        end
    end
    if uniformbytes ~= self._uniformBytes then
        error("nupp: generated GPU uniform block has the wrong size", 2)
    end
    local spans = #self._spanCounts
    @unsafe do
        local words = ffi.cast<uint32[?]>(uniforms)
        words[0] = self.count
        for index = 1, spans do
            words[index] = self._spanCounts[index]
            words[spans + index] = self._spanOffsets[index]
        end
    end
    local uniformPointer = ffi.cast<const uint8[?]>(uniforms)
    native.succeeded(
        dispatchNative(self._context, self._handle, self.count, self._kernel._threads, uniformPointer, uniformbytes),
        2
    )
end

function gpu.Context.upload<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    borrows source: span.Span<T>
): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    if buffer._context ~= self or buffer._state.released then
        error("nupp: GPU upload buffer is unavailable in this context", 2)
    end
    if not buffer:isdense() then
        error("nupp: GPU uploads require a dense tensor view", 2)
    end
    if #source ~= buffer.count then
        error("nupp: GPU upload span length does not match its buffer", 2)
    end
    costLayout(live(self), buffer._handle, buffer._shape, buffer._strides, buffer._width, buffer._offset, buffer.count)
    local pointer, count = source:ref()
    native.succeeded(
        uploadTyped(live(self), buffer._handle, pointer, buffer._offset * buffer._width, buffer._width * count),
        2
    )
end

function gpu.Context.enqueuedownload<T>(borrows self: gpu.Context, borrows bufferValue: api.Buffer<T>): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    if buffer._context ~= self or buffer._state.released then
        error("nupp: GPU download buffer is unavailable in this context", 2)
    end
    if not buffer:isdense() then
        error("nupp: GPU downloads require a dense tensor view", 2)
    end
    costLayout(live(self), buffer._handle, buffer._shape, buffer._strides, buffer._width, buffer._offset, buffer.count)
    native.succeeded(
        C.nuppNativeGpuDownloadQueue(
            live(self),
            buffer._handle,
            buffer._offset * buffer._width,
            buffer.count * buffer._width
        ),
        2
    )
end

const READINESS_FEATURE = 16384

-- Whether the context's submitted work has finished, or why that cannot be told.
-- Never blocks: while the work runs, the provider advances the readiness generation
-- once it is done.
local function workDone(handle: any, ready: any): (boolean, string?)
    if C.nuppNativeGpuSynchronizeReady(handle, ready) ~= 0 then
        return false, "nupp: " .. ffi.string(C.nuppNativeLastError())
    end

    return ready[0] ~= 0, nil
end

--- Parks until the context's submitted work finishes, then settles its downloads.
---
--- The wait is a suspension on the readiness generation every native family
--- shares, so a task deadline or a cancellation reaches it and other work keeps
--- running meanwhile; a frame with nobody to yield to sleeps until the device is
--- done. Only mapping the finished downloads happens in the blocking call.
--- @raises string when the context is closed, the device cannot be waited for, or
---     the work it finished reports a validation failure or device fault
function gpu.Context.synchronize(borrows self: gpu.Context): nil
    local handle = live(self)
    native.requireFeature(READINESS_FEATURE, "readiness")
    local ready = ffi.new("uint32_t[1]")
    local done, failure = workDone(handle, ready)
    if not done and failure == nil then
        -- The check's failure is the waiter's to raise, not the driver's that polled
        -- it, so it is handed over through the resumption.
        failure = suspension.suspend("GPU synchronize", function(
            resume: function(string?),
            context: suspension.Context
        ): function()?
            local waiting = true
            context:source(
                "nupp-gpu",
                native.READINESS_PRIORITY,
                native.pump(function(): integer
                    if not waiting then
                        return 0
                    end
                    local finished, reason = workDone(handle, ready)
                    if not finished and reason == nil then
                        return 0
                    end
                    waiting = false
                    resume(reason)

                    return 1
                end)
            )

            return function(): nil
                waiting = false
            end
        end)
    end
    if failure ~= nil then
        error(failure, 2)
    end
    native.succeeded(C.nuppNativeGpuSynchronize(handle), 2)
end

function gpu.Context.readdownloaded<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: span.WriteSpan<T>
): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    if buffer._context ~= self or buffer._state.released then
        error("nupp: GPU download buffer is unavailable in this context", 2)
    end
    if not buffer:isdense() then
        error("nupp: GPU downloads require a dense tensor view", 2)
    end
    if #destination ~= buffer.count then
        error("nupp: GPU download span length does not match its buffer", 2)
    end
    local pointer, count = destination:ref()
    native.succeeded(
        readTyped(live(self), buffer._handle, pointer, buffer._offset * buffer._width, buffer._width * count),
        2
    )
end

function gpu.Context.download<T>(
    borrows self: gpu.Context,
    borrows bufferValue: api.Buffer<T>,
    exclusive destination: span.WriteSpan<T>
): nil
    local buffer = own.borrow(bufferValue as shared.Buffer<T>)
    self:enqueuedownload(buffer)
    self:synchronize()
    self:readdownloaded(buffer, destination)
end

--- Opens the preferred WGPU compute device.
--- @export
--- @raises string when WGPU has no compatible compute adapter

function gpu.Binding.dispatchwords(borrows self: gpu.Binding, scalars: {uint32}): nil
    error("nupp: native GPU dispatch requires a packed uniform block", 2)
end

function gpu.Context.bindkernel(
    borrows self: gpu.Context,
    borrows kernelValue: api.Kernel,
    count: integer
): api.Binding borrows (self)
    local kernel = kernelValue as shared.Kernel
    if kernel._anchor ~= self then
        error("nupp: GPU kernel belongs to another context", 2)
    elseif kernel._released then
        error("nupp: GPU kernel was released", 2)
    end
    count = whole(count, "dispatch count", 1, 4294967295)
    local context = live(self)
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeGpuBindingsCreate(context, kernel._handle, output), 2)
    local handle = output[0]
    local spans = kernel._readonlyBuffers + kernel._writableBuffers
    local spanCounts: {integer} = {}
    local spanOffsets: {integer} = {}
    for index = 1, spans do
        spanCounts[index] = 0
        spanOffsets[index] = 0
    end

    return gpu.Binding(
        _anchor = self,
        _kernel = kernel as any as shared.KernelView,
        _read = {},
        _write = {},
        _readCounts = {},
        _writeCounts = {},
        _readOffsets = {},
        _writeOffsets = {},
        _bufferStates = {},
        _context = context,
        _handle = handle,
        _uniformBytes = kernel._uniformBytes,
        _readonlyBuffers = kernel._readonlyBuffers,
        _spanCounts = spanCounts,
        _spanOffsets = spanOffsets,
        _released = false,
        count = count
    )
end

function gpu.Context.close(takes self: gpu.Context): nil
    local state = @unsafe own.release(self)
    state._destroy(state)
end

--- Opens and closes a device to learn whether one can be opened.
function gpu.available(): boolean
    if not pcall(native.requireFeature, 4, "GPU support") then
        return false
    end
    local output = ffi.new("uint64_t[1]")
    if C.nuppNativeGpuContextCreate(output) ~= 0 then
        return false
    end
    C.nuppNativeGpuContextRelease(output[0])

    return true
end

function gpu.open(): api.KernelContext
    native.requireFeature(4, "GPU support")
    local output = ffi.new("uint64_t[1]")
    native.succeeded(C.nuppNativeGpuContextCreate(output), 2)
    local handle = output[0]

    return gpu.Context(_destroy = contextdestroy, _handle = handle, _closed = false)
end

export const available = gpu.available
export const open = gpu.open
export const costsOutput = gpu.costsOutput
