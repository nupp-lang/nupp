@!internal
--[[Built-in HMAC-SHA256 catalog for `binary.Mac` API 1.

Initialization creates only the immutable 32-byte algorithm descriptor. Each
factory invocation creates independent keyed incremental state through the fixed
Nupp digest implementation. The public MAC facade owns output allocation, encoding,
and consuming cleanup. No keyed state, provider instance, or closure crosses a
worker boundary; each Lua state loads this module independently. Operations use
retained implementation functions without discovery.
]]
module nupp.runtime.provider.mac

local contract = require("binary.mac.internal.contracts")
local {type State} = require("binary.digest.internal.contracts")
local builtin = require("nupp.digest.internal.builtin")
local record Algorithm is contract.Algorithm
    @readonly name: string = "hmac-sha256"
    @readonly digestsize: integer = 32
    function create(self, key: string): State
        return builtin.hmacSha256(key)
    end
end
local provider: contract.Provider = {algorithms = {["hmac-sha256"] = Algorithm()}}
export = provider
