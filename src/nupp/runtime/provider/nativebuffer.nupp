@!internal

module nupp.runtime.provider.nativebuffer

--[[
The VM's `text.buffer` provider: the runtime's native `string.buffer`, the
same FIFO byte buffer LuaJIT provides, adapted to the single public Buffer
type in [](nupp.text.internal.buffer). The FFI pointer methods (`ref`,
`reserve`, `commit`, `putcdata`) are refused on the VM.
]]

local native = require("string.buffer")
local {type Buffer} = require("nupp.text.internal.buffer")

--- Creates an empty FIFO byte buffer. A size hint is accepted and ignored; an
--- options table is passed to the host library, which refuses serialization
--- dictionaries.
export function new(size: (integer | table)?, options: table?): Buffer
    if options ~= nil then
        return native.new(size, options) as any
    end
    if size ~= nil then
        return native.new(size) as any
    end

    return native.new() as any
end
