@!internal

--[[
Native FIFO buffer constructor used by implementation conformance tests.

The constructor is LuaJIT's `string.buffer.new` function directly. It returns
the native object with its pointer and serialization operations intact.
Requiring this module allocates no individual buffer.
]]
module nupp.runtime.provider.nativebuffer

local native = require("string.buffer")

--- Creates a native FIFO buffer without wrapping its object or constructor.
export const new: function(size: (integer | table)?, options: table?): native.Buffer = native.new
