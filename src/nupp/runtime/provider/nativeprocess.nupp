module nupp.runtime.provider.nativeprocess

local host = require("nupp.vm.process")
local shared = require("io.internal.process.types")
local provider = {}
const SIGNAL_BASE = 128
const INT32_MIN = -2147483648
const INT32_MAX = 2147483647

-- Older VM hosts report a failed start by its reason alone; the core also
-- returns the platform error code.
function provider.spawn(_: any, options: shared.SpawnOptions): (any?, any?, any?, any?, integer, string?, integer?)
    -- Public option names stop here; the frozen host consumes this private descriptor.
    local child, input, output, errors, pid, problem, code = host.spawn({
        args = options.args,
        cwd = options.cwd,
        env = options.env,
        clearEnv = options.clearenv,
        stdin = options.stdin,
        stdout = options.stdout,
        stderr = options.stderr,
        timeoutMs = options.timeoutms,
    })
    if child == nil and code == nil and problem ~= nil then
        -- The frozen host kept std::io::Error's complete display text, whose
        -- final suffix retains raw_os_error even though the result omitted it.
        local legacy = tonumber(problem:match("%(os error (%-?%d+)%)$"))
        if legacy ~= nil and legacy ~= 0 and legacy >= INT32_MIN and legacy <= INT32_MAX then
            code = legacy as integer
        end
    end

    return child, input, output, errors, pid, problem, code
end

function provider.poll(_: any, child: any): shared.Exit?
    local code, killed, signal = host.poll(child)
    if code ~= nil then
        -- The frozen Unix host encodes a signal as 128 plus its number.
        if signal == nil and killed and package.config:sub(1, 1) ~= "\\" and code >= SIGNAL_BASE then
            signal = code - SIGNAL_BASE
        end
        return {exitcode = code, killed = killed, timedout = false, signal = signal}
    end
end

function provider.kill(_: any, child: any, force: boolean): nil
    host.kill(child, force)
end

function provider.read(_: any, stream: any, count: integer): string?
    return host.read(stream, count)
end

function provider.write(_: any, stream: any, bytes: string): (integer, boolean)
    return host.write(stream, bytes)
end

function provider.closestream(_: any, stream: any): (boolean, string?)
    return host.closeStream(stream)
end

function provider.reap(_: any, child: any): (boolean, string?)
    return host.reap(child)
end

function provider.now(_: any): number
    return require("nupp.vm.clock").now()
end

function provider.waitready(_: any, interest: shared.Interest, milliseconds: number): integer
    return host.waitReady(interest, milliseconds)
end

export = provider
