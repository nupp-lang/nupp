@!internal
module nupp.runtime.provider.corerecord

-- The program's global `nupp`, which types.reflect installs its runtime on,
-- reached through the globals table package.loaded holds as `_G`: `_G`
-- itself names no binding a program the core builds holds, and a require
-- through it is dynamic, so the compiler that builds this one (stage zero)
-- never compiles the core library modules it would otherwise reach.
local function reflectionNamespace(): any
    local globals: any = _G.require("_G")
    local namespace: any = rawget(globals, "nupp")
    if namespace == nil then
        namespace = {}
        rawset(globals, "nupp", namespace)
    end

    return namespace
end

local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local fresh: any = {}
    for key, item in pairs(value) do
        fresh[key] = copy(item)
    end

    return fresh
end

local function nominal(owner: any, spec: any, domain: any): any
    if domain.self then
        return owner
    end
    if domain.cell then
        return spec.cells[domain.cell][1]
    end
    local class: any = nil
    if domain.bound then
        class = spec.imports[domain.bound]
    elseif spec.environment then
        class = spec.loader(domain.module)
    else
        class = require(domain.module)
    end
    for _, member in ipairs(domain.path) do
        class = class[member]
    end

    return class
end

local function admits(owner: any, spec: any, domains: any, value: any): boolean
    for _, domain in ipairs(domains) do
        if domain.literal then
            if value == domain.value then
                return true
            end
        elseif domain.nominal then
            if domain.kind ~= "record" then
                return true
            end
            local mt: any = type(value) == "table" and getmetatable(value)
            if type(value) == "table" and type(mt) == "table" then
                local class = nominal(owner, spec, domain)
                if type(class) == "table" and mt.__index == class then
                    return true
                end
            end
        elseif domain.kind == "any" or type(value) == domain.kind then
            return true
        end
    end

    return false
end

export function create(owner: any, spec: any): any
    local blueprint = spec.blueprint
    if spec.blueprintChunks ~= nil then
        local codec = require("nupp.compiler.project.plaincodec")
        blueprint = codec.decode(table.concat(spec.blueprintChunks))
    end
    if blueprint ~= nil then
        owner["\0nupp:reflection"] = {blueprint = blueprint, references = spec.references}
        -- The declaration's `reflect` member answers its descriptor, as the
        -- VM's witness registration gives it one (typewitness), unless the
        -- record declares a `reflect` of its own.
        if rawget(owner, "reflect") == nil then
            rawset(owner, "reflect", function(): any
                local namespace = reflectionNamespace()
                require("nupp.compiler.runtime.typewitness").install(namespace)
                if namespace.__reflect.get == nil then
                    require("nupp.compiler.runtime.reflect").install(namespace)
                end

                return namespace.__reflect.get(owner)
            end)
        end
    end
    if spec.declarationKey ~= nil then
        -- The declaration's cell holds its table, and the cells of the
        -- declarations its descriptor names are where
        -- `types.reflect.runtimetype` finds theirs.
        local namespace = reflectionNamespace()
        require("nupp.compiler.runtime.typewitness").install(namespace)
        local reflect: any = namespace.__reflect
        local children: {any} = {}
        for _, target in ipairs(spec.targets or {}) do
            children[#children + 1] = reflect.reference(target.key, target.module)
        end
        reflect.link(owner, reflect.declaration(spec.declarationKey), children)
    end

    local function construct(_: any, ...: any): any
        local count = select("#", ...)
        local chosen = 1
        if #spec.constructors > 1 then
            chosen = 0
            for index, entry in ipairs(spec.constructors) do
                local accepted = count >= entry.min and count <= entry.max
                if accepted then
                    for position, domains in ipairs(entry.params) do
                        if not admits(owner, spec, domains, (select(position, ...))) then
                            accepted = false
                            break
                        end
                    end
                end
                if accepted then
                    chosen = index
                    break
                end
            end
            if chosen == 0 then
                error("no constructor accepts these arguments", 2)
            end
        end
        local instance: any = setmetatable({}, owner)
        for index, field in ipairs(spec.fields) do
            local position: integer = spec.positions[index]
            local value: any = nil
            if #spec.constructors == 0 then
                value = (select(position, ...))
            end
            if (#spec.constructors > 0 or count < position) and spec.defaulted[index] then
                value = copy(spec.defaults[index])
            end
            instance[field] = value
        end
        if #spec.constructors > 0 then
            owner["\0new" .. tostring(chosen)](instance, ...)
        end

        return instance
    end

    -- Each constructor is also the declaration's member `__nuppCtor<i>`: a
    -- function of that constructor's own arguments answering a fresh
    -- instance, as the VM's declarations carry, which construction driven by
    -- reflection (serde's declaration access) calls by its index.
    for index in ipairs(spec.constructors) do
        local initialize = "\0new" .. tostring(index)
        owner["__nuppCtor" .. tostring(index)] = function(...: any): any
            local instance: any = setmetatable({}, owner)
            for position, field in ipairs(spec.fields) do
                if spec.defaulted[position] then
                    instance[field] = copy(spec.defaults[position])
                end
            end
            owner[initialize](instance, ...)

            return instance
        end
    end

    setmetatable(owner, {__call = construct, __metatable = false})

    return owner
end
