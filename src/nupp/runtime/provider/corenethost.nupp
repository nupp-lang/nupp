@!internal
module nupp.runtime.provider.corenethost

const netcalls = require("nupp.runtime.netcalls")
const pollcalls = require("nupp.runtime.pollcalls")

const LISTEN = 1
const CONNECT = 2
const ACCEPT = 3
const CONNECT_POLL = 4
const CLOSE = 5
const READ = 6
const WRITE = 7
const ENDED = 8
const PENDING = 9
const SHUTDOWN = 10
const SHUTTING = 11
const ADDRESS = 12
const NODELAY = 13
const KEEPALIVE = 14
const ERROR = 15
const BIND_DATAGRAM = 16
const RECEIVE_DATAGRAM = 17
const SEND_DATAGRAM = 18
const BROADCAST = 19
const MULTICAST_TTL = 20
const MULTICAST_LOOP = 21
const JOIN = 22
const LEAVE = 23
const LISTEN_LOCAL = 24
const CONNECT_LOCAL = 25
const TLS_WRAP = 26
const TLS_HANDSHAKE = 27
const TLS_READ = 28
const TLS_WRITE = 29
const TLS_FLUSHED = 30
const TLS_CLOSE = 31
const TLS_READY = 32
const TLS_VERIFIED = 33
const TLS_RESUMED = 34
const TLS_PROTOCOL = 35
const TLS_ERROR = 36
const AGAIN = -2147483648
const TLS_FAILED = -2147483647
const MAX_WAIT_MS = 2147483647
const NANOS_PER_MS = 1000000

local function reason(code: integer): string
    const result = netcalls.receive(ERROR, code, 0)

    return type(result) == "string" and result as string or "socket error " .. tostring(code)
end

local function handle(result: integer): (integer?, string?)
    if result == AGAIN then
        return nil, nil
    elseif result < 0 then
        return nil, reason(result)
    end

    return result
end

local function changed(result: integer): (boolean, string?)
    if result < 0 then
        return false, reason(result)
    end

    return true
end

export function listen(host: string, port: integer, backlog: integer, reuse: boolean): (integer?, string?)
    if port < 0 or port > 65535 or backlog <= 0 or backlog > MAX_WAIT_MS then
        return nil, "invalid TCP listen options"
    end
    const option = port | (backlog << 16) | (reuse and (1 << 48) or 0)

    return handle(netcalls.send(LISTEN, option, host))
end

export function connect(host: string, port: integer, timeout: integer): (integer?, string?)
    if port < 0 or port > 65535 or timeout < 0 or timeout > MAX_WAIT_MS then
        return nil, "invalid TCP connect options"
    end

    return handle(netcalls.send(CONNECT, port | timeout << 16, host))
end

export function accept(listener: integer): (integer?, string?)
    return handle(netcalls.number(ACCEPT, listener, 0))
end

export function connectPoll(request: integer): (integer?, string?)
    return handle(netcalls.number(CONNECT_POLL, request, 0))
end

local function close(key: integer): nil
    local _ = netcalls.number(CLOSE, key, 0)
end

export const closeListener = close
export const closeConnect = close
export const closeStream = close

export function read(stream: integer, wanted: integer): (string?, string?)
    local result = netcalls.receive(READ, stream, wanted)
    if type(result) == "string" then
        return result as string
    elseif result == AGAIN then
        return ""
    end

    return nil, reason(result as integer)
end

export function write(stream: integer, bytes: string): (integer?, string?)
    local result = netcalls.send(WRITE, stream, bytes)
    if result == AGAIN then
        return 0
    end

    return handle(result)
end

export function pending(stream: integer): integer
    const result = netcalls.number(PENDING, stream, 0)

    return result < 0 and 0 or result
end

export function ended(stream: integer): boolean
    return netcalls.number(ENDED, stream, 0) == 1
end

export function writeFailed(stream: integer): boolean
    return netcalls.number(PENDING, stream, 0) < 0
end

export function shuttingDown(stream: integer): boolean
    return netcalls.number(SHUTTING, stream, 0) == 1
end

export function shutdownWrite(stream: integer): (boolean, string?)
    return changed(netcalls.number(SHUTDOWN, stream, 0))
end

export function address(stream: integer, peer: boolean): (string?, integer?)
    const result = netcalls.receive(ADDRESS, stream, peer and 1 or 0)
    if type(result) ~= "string" then
        return nil, nil
    end
    local port, host = string.match(result as string, "^(%d+)\n(.+)$")

    return host, port and math.tointeger(tonumber(port)) or nil
end

export function listenerPort(listener: integer): integer
    local _, port = address(listener, false)

    return port or -1
end

export function noDelay(stream: integer, enable: boolean): (boolean, string?)
    return changed(netcalls.number(NODELAY, stream, enable and 1 or 0))
end

export function keepAlive(stream: integer, enable: boolean, delay: integer): (boolean, string?)
    if delay < 0 or delay > 4294967295 then
        return false, "invalid keepalive delay"
    end
    const enabledDelay = delay > 0 and delay + 1 or 2

    return changed(netcalls.number(KEEPALIVE, stream, enable and enabledDelay or 0))
end

local poller: integer? = nil

export function sleep(milliseconds: integer): nil
    local token = poller
    if token == nil then
        token = pollcalls.open()
        if token < 0 then
            error("could not open socket poller", 0)
        end
        poller = token
    end
    local bounded = math.max(0, math.min(MAX_WAIT_MS, milliseconds)) as integer
    if pollcalls.waitOwner(token, bounded * NANOS_PER_MS) < 0 then
        error("could not pump socket readiness", 0)
    end
end

export function snapshot(): nil
    sleep(0)
end

export function listenPath(path: string, backlog: integer): (integer?, string?)
    return handle(netcalls.send(LISTEN_LOCAL, backlog, path))
end

export function connectPath(path: string, timeout: integer): (integer?, string?)
    return handle(netcalls.send(CONNECT_LOCAL, timeout, path))
end

export function bindDatagram(host: string, port: integer, reuse: boolean): (integer?, string?)
    if port < 0 or port > 65535 then
        return nil, "invalid datagram port"
    end

    return handle(netcalls.send(BIND_DATAGRAM, port | (reuse and (1 << 48) or 0), host))
end

export const datagramPort = listenerPort
export const closeDatagram = close

export function receive(socket: integer, maximum: integer): (string?, string?, integer?, boolean?, string?)
    const result = netcalls.receive(RECEIVE_DATAGRAM, socket, maximum)
    if type(result) == "number" then
        if result == AGAIN then
            return nil
        end

        return nil, nil, nil, nil, reason(result as integer)
    end
    const wire = result as string
    local port, truncated, host, start = string.match(wire, "^(%d+)\n([01])\n([^\n]+)\n()")
    if start == nil then
        return nil, nil, nil, nil, "invalid datagram address from the reactor"
    end

    return wire:sub(start), host, math.tointeger(tonumber(port)), truncated == "1"
end

export function sendTo(socket: integer, host: string, port: integer, bytes: string): (boolean, string?)
    return changed(netcalls.send(SEND_DATAGRAM, socket, tostring(port) .. "\n" .. host .. "\n" .. bytes))
end

export function broadcast(socket: integer, enabled: boolean): (boolean, string?)
    return changed(netcalls.number(BROADCAST, socket, enabled and 1 or 0))
end

export function multicastTtl(socket: integer, ttl: integer): (boolean, string?)
    return changed(netcalls.number(MULTICAST_TTL, socket, ttl))
end

export function multicastLoop(socket: integer, enabled: boolean): (boolean, string?)
    return changed(netcalls.number(MULTICAST_LOOP, socket, enabled and 1 or 0))
end

export function membership(socket: integer, group: string, interface: string, join: boolean): (boolean, string?)
    return changed(netcalls.send(join and JOIN or LEAVE, socket, group .. "\n" .. interface .. "\n"))
end

local function counted(value: string): string
    return tostring(#value) .. "\n" .. value
end

export function tlsWrap(
    stream: integer,
    server: boolean,
    hostname: string,
    certificate: string,
    privateKey: string,
    authority: string?,
    protocols: string,
    verify: boolean
): (integer?, string?)
    if hostname:find("\n", 1, true) ~= nil or hostname:find("\0", 1, true) ~= nil then
        close(stream)

        return nil, "invalid TLS hostname"
    end
    const flags = (server and 1 or 0) | (verify and 2 or 0) | (authority ~= nil and 4 or 0)
    const settings = string.char(
        flags
    ) .. hostname .. "\n" .. counted(
        certificate
    ) .. counted(privateKey) .. counted(authority or "") .. counted(protocols)
    const session = netcalls.send(TLS_WRAP, stream, settings)
    if session < 0 then
        close(stream)

        return nil, "TLS configuration was refused: " .. reason(session)
    end

    return session
end

local function tlsReason(session: integer, code: integer): string
    if code == TLS_FAILED then
        const message = netcalls.receive(TLS_ERROR, session, 0)

        return type(message) == "string" and message as string or "TLS engine failure"
    end

    return reason(code)
end

export function tlsHandshake(session: integer): (boolean?, string?)
    const result = netcalls.number(TLS_HANDSHAKE, session, 0)
    if result == AGAIN then
        return false
    elseif result < 0 then
        return nil, tlsReason(session, result)
    end

    return result == 1
end

export function tlsRead(session: integer, wanted: integer): (string?, string?)
    const result = netcalls.receive(TLS_READ, session, wanted)
    if type(result) == "string" then
        return result as string
    elseif result == AGAIN then
        return nil
    end

    return nil, tlsReason(session, result as integer)
end

export function tlsWrite(session: integer, bytes: string): (integer?, string?)
    const result = netcalls.send(TLS_WRITE, session, bytes)
    if result == AGAIN then
        return nil
    elseif result < 0 then
        return nil, tlsReason(session, result)
    end

    return result
end

local function tlsProgress(operation: integer, session: integer): (boolean, string?)
    const result = netcalls.number(operation, session, 0)
    if result < 0 and result ~= AGAIN then
        return false, tlsReason(session, result)
    end

    return result == 1
end

export function tlsFlushed(session: integer): (boolean, string?)
    return tlsProgress(TLS_FLUSHED, session)
end

export function tlsCloseNotify(session: integer): (boolean, string?)
    return tlsProgress(TLS_CLOSE, session)
end

export function tlsConnected(session: integer): boolean
    return netcalls.number(TLS_READY, session, 0) == 1
end

export function tlsVerified(session: integer): boolean
    return netcalls.number(TLS_VERIFIED, session, 0) == 1
end

export function tlsResumed(session: integer): boolean
    return netcalls.number(TLS_RESUMED, session, 0) == 1
end

export function tlsProtocol(session: integer): string?
    const result = netcalls.receive(TLS_PROTOCOL, session, 0)
    if type(result) == "string" and result ~= "" then
        return result as string
    end

    return nil
end

export const tlsDestroy = close
