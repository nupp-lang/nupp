@!internal
module nupp.runtime.provider.corederive

-- The core's half of main's derive emission. Main registers a declaration's
-- recipe with `nupp.derive` and stores, on the declaration's table, a member
-- for each forwarding recipe entry that calls its helper with the arguments
-- the entry names. The core lowers the same steps as calls of these
-- factories, each handed the recipe data main renders.

const derive = require("nupp.derive")
const storage = require("nupp.runtime.storagecalls")
const heap = require("nupp.runtime.provider.heapstorage")

-- The registry main reaches through `_G.nupp.__derive`, installed on a table
-- of this module's own so no global is needed.
local namespace: any = {}
derive.install(namespace)

-- A constant as main renders it: a fresh table for each evaluation.
local function copy(value: any): any
    if type(value) ~= "table" then
        return value
    end
    local fresh: any = {}
    for key, item in pairs(value) do
        fresh[key] = copy(item)
    end

    return fresh
end

-- Which of a recipe's defaults are tables, so copied for each evaluation:
-- known once, so that filling storage asks no default its type.
local function copiedDefaults(spec: any): {boolean}
    local copied: {boolean} = {}
    for index = 1, #spec.fields do
        copied[index] = type(spec.defaults[index]) == "table"
    end

    return copied
end

-- The default of field `index`, as main renders it.
local function default(spec: any, copied: {boolean}, index: integer): any
    if copied[index] then
        return copy(spec.defaults[index])
    end

    return spec.defaults[index]
end

-- One forwarding argument of a call, from the member's own arguments.
local function argument(spec: any, entry: any, given: any): any
    local kind = spec.kind
    if kind == "receiver" then
        return given[1]
    elseif kind == "entry" then
        return entry
    elseif kind == "witness" then
        return entry.mt
    elseif kind == "argument" then
        return given[spec.position]
    elseif kind == "field" then
        return given[1][spec.name]
    elseif kind == "constant" then
        return copy(spec.value)
    elseif kind == "array" then
        local values: any = {}
        for index, child in ipairs(spec.values) do
            values[index] = argument(child, entry, given)
        end
        return values
    end
    error("unknown derived forwarding argument " .. tostring(kind))
end

--- Registers declaration `owner`'s recipe, answering its registry entry.
export function register(owner: any, recipe: any): any
    return namespace.__derive.register(recipe.key, owner, recipe)
end

--- A member forwarding to helper `spec.member` of module `spec.module` with
--- the arguments `spec.arguments` name, as main's
--- `function(params) return _G.require(module)[member](args) end` does: the
--- helper is loaded when the member is first called.
export function member(entry: any, spec: any): any
    return function(...: any): ...any
        local given: any = {...}
        local values: any = {}
        for index, item in ipairs(spec.arguments) do
            values[index] = argument(item, entry, given)
        end

        local helper = _G.require(spec.module)[spec.member]

        return helper(table.unpack(values, 1, #spec.arguments))
    end
end

const signedKind: {[integer]: string} = {[4] = "int32", [8] = "int64"}
const unsignedKind: {[integer]: string} = {[1] = "uint8", [2] = "uint16", [4] = "uint32", [8] = "uint64"}
-- The core's storage view for C pointers. Assigning to it stores the address
-- of a borrowed value, or a zero address for nil.
const POINTER_VIEW = 12

-- Writes a number field in place (corestore), or nil when the compiler
-- that lowered corestore predates its store: then it loads, but its store
-- reads a call module that is not there and raises, so a field is written
-- through a view of it instead, which allocates the view. A store into a
-- byte of scratch storage tells which, once.
local function inplaceStore(): any
    local loaded, corestore = pcall(function(): any
        return require("nupp.runtime.provider.corestore")
    end)
    if not loaded or corestore == nil then
        return nil
    end
    local scratch = storage.allocbytes(1)
    if not pcall(corestore.store, scratch, heap.scalar("uint8").kind, 0, 0) then
        return nil
    end

    return corestore.store
end

const inplace: any = inplaceStore()

local function structInitializer(layout: any, spec: any): any
    assert(layout.supported, layout.error)
    local byName: {[string]: any} = {}
    for _, field in ipairs(layout.fields) do
        byName[field.name] = field
    end
    local fields: {any} = {}
    for index, name in ipairs(spec.fields) do
        local field = assert(byName[name], "derived initializer has no layout for field " .. name)
        local kind = field.kind
        local composite = kind == "array" or kind == "struct" or kind == "union" or kind == "vector"
        local scalar: string
        if composite or kind == "boolean" then
            scalar = "uint8"
        elseif field.bitWidth ~= nil or kind == "pointer" then
            scalar = assert(unsignedKind[field.size], "unsupported derived struct field width")
        elseif kind == "integer" then
            scalar = assert(signedKind[field.size], "unsupported derived struct integer width")
        else
            scalar = kind
        end
        local storageKind = kind == "pointer" and POINTER_VIEW or heap.scalar(scalar).kind
        -- A plain number field is written in place; a pointer, bit field or
        -- composite one through a view.
        local direct = not composite and field.bitWidth == nil and kind ~= "pointer"
        fields[index] = {field = field, storageKind = storageKind, composite = composite, direct = direct}
    end
    local copied = copiedDefaults(spec)

    -- The arguments are read where they were passed, and a number field
    -- written in place where the core can, so filling storage allocates
    -- nothing.

    return function(self: any, ...: any): any
        for index, entry in ipairs(fields) do
            local field = entry.field
            local value: any = (select(index, ...))
            if value == nil and spec.defaulted[index] then
                value = default(spec, copied, index)
            end
            if field.kind == "boolean" then
                value = value and 1 or 0
            end
            if inplace ~= nil and entry.direct and value ~= nil then
                inplace(self, entry.storageKind, field.offset, value)
            elseif field.bitWidth ~= nil then
                local cell = storage.view(self, entry.storageKind, field.offset, 1)
                local shift = field.bitOffset as uint64
                local mask = 0xffffffffffffffffULL >> ((64 - field.bitWidth) as uint64)
                local original = cell[0] as uint64
                cell[0] = (original & ~(mask << shift)) | (((value as uint64) & mask) << shift)
            elseif entry.composite then
                local bytes = storage.view(self, entry.storageKind, field.offset, field.size)
                storage.copy(bytes, value, field.size)
            else
                local cell = storage.view(self, entry.storageKind, field.offset, 1)
                cell[0] = value
            end
        end

        return self
    end
end

--- Returns an initializer for existing storage. It fills the fields from
--- arguments or applies defaults and runs the constructor.
export function initializer(owner: any, spec: any): any
    local layout = owner["\0nupp:structLayout"]
    if layout then
        return structInitializer(layout, spec)
    end
    local copied = copiedDefaults(spec)
    if spec.constructor ~= nil then
        local constructor = assert(owner[spec.constructor], "derived constructor is missing")
        return function(self: any, ...: any): any
            for index, field in ipairs(spec.fields) do
                self[field] = default(spec, copied, index)
            end
            constructor(self, ...)

            return self
        end
    end

    return function(self: any, ...: any): any
        for index, field in ipairs(spec.fields) do
            local value: any = (select(index, ...))
            if value == nil and spec.defaulted[index] then
                value = default(spec, copied, index)
            end
            self[field] = value
        end

        return self
    end
end
