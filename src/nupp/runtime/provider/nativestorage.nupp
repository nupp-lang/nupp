@!internal
--[[
LuaJIT FFI implementation used as a built-in module fallback.

Allocations, casts, scalar descriptors, and struct layouts use native pointers
and the target ABI. The published representation is `native`; byte codecs use
native scalar layout and byte order. This implementation cannot serve a target
compiled for linear-memory offsets.

The [](binary._representation) facade validates the representation before
publishing it. Borrowed string pointers and casts retain the source lifetime in
the canonical signatures; a provider must not turn a borrowed view into an owner.
Copies and fills operate on the caller's bounded regions and do not allocate a
replacement destination.

FFI owns allocated cdata. Raw pointer operations require valid extents from the
caller; `boundedCount` preserves the requested count without discovering native
pointer bounds. Applications use
public memory and buffer APIs rather than depending on these FFI objects.
]]
module nupp.runtime.provider.nativestorage

export const representation = "native"
local ffi = require("ffi")

export function allocbytes(count: integer): uint8[?]
    -- `ffi.new` rejects a negative or oversized extent itself, but turns a
    -- nonfinite one into a zero-byte allocation, and nothing bounds-checks cdata
    -- afterwards: every write through it is simply out of range. A checked caller
    -- cannot reach that, since the count is an `integer`; the table is also an SPI
    -- provider that plain Lua reads members from. Same floor as `allocateArray`.
    assert(count >= 0 and count % 1 == 0, "nupp: storage byte extent must be a whole, finite count")

    return ffi.new<uint8[?]>(count)
end

export function borrowstring(borrows bytes: string): const uint8[?] borrows (bytes)
    return ffi.cast<const uint8[?]>(bytes)
end

export function copy(borrows destination: any, borrows source: any, count: integer): nil
    ffi.copy(destination, source, count)
end

-- A struct reference is a pointer to its row here, so a row handed out of a
-- `T[?]` clears with the same call as the array it sits in.
export function fill(destination: any, count: integer, value: integer): nil
    ffi.fill(destination, count, value)
end

export function sizeof(element: any): integer
    return ffi.sizeof(element) as integer
end

local stringBytes: function(borrows source: any, count: integer): string = ffi.string as any

export function string(borrows source: any, count: integer): string
    return stringBytes(source, count)
end

export function decodeuint8(bytes: string): uint32
    local holder = ffi.new<uint8[1]>()
    @unsafe do
        ffi.copy(holder, bytes, 1)
        return holder[0]
    end
end

export function encodeuint8(value: uint32): string
    local holder = ffi.new<uint8[1]>()
    @unsafe do
        holder[0] = value
    end

    return ffi.string(holder, 1)
end

export function decodeint8(bytes: string): int32
    local holder = ffi.new<int8[1]>()
    @unsafe do
        ffi.copy(holder, bytes, 1)
        return holder[0]
    end
end

export function encodeint8(value: int32): string
    local holder = ffi.new<int8[1]>()
    @unsafe do
        holder[0] = value
    end

    return ffi.string(holder, 1)
end

