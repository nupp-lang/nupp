    return ffi.string(holder, 8)
end

export function castbytes(borrows pointer: any): const uint8[?] borrows (pointer)
    return ffi.cast<const uint8[?]>(pointer)
end

export function castelements<T>(element: ctype<T>, pointer: any): any
    local pointerSpec = "const $ *"
    local pointerType = ffi.typeof(pointerSpec, element)
    @unsafe do
        return ffi.cast(pointerType, pointer) as T[?]
    end
end

local scalarTypes: {[string]: any} = {}
local arrayTypes: any = {}
export function scalar(kind: string): any
    local result = scalarTypes[kind]
    if result == nil then
        local spelling = kind == "float" and "float" or kind == "number" and "double" or kind .. "_t"
        result = ffi.typeof(spelling)
        scalarTypes[kind] = result
    end

    return result
end

export function descriptor(value: any): any
    return ffi.typeof(value)
end

export function allocarray(element: any, count: integer): any
    local width = ffi.sizeof(element) as integer
    assert(
        count >= 0 and count % 1 == 0 and count <= math.floor(2147483647 / math.max(width, 1)),
        "nupp: storage array extent exceeds native allocation limit"
    )
    local physical = arrayTypes[element]
    if physical == nil then
        local spelling = "$[?]"
        physical = ffi.typeof(spelling, element)
        arrayTypes[element] = physical
    end

    return ffi.new(physical, count)
end

-- Raw references require the caller to supply their readable extent.
export function boundedcount(borrows source: any, count: integer): integer
    return count
end
