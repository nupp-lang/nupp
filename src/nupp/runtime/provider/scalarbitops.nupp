module nupp.runtime.provider.scalarbitops

-- Portable BitOp-compatible 32-bit words. This is the deliberately slow host
-- provider; generated LuaJIT keeps using the VM's native operations.

local MODULUS = 4294967296
local SIGN = 2147483648

local function unsigned(value: number): number
    if value ~= value or value == math.huge or value == -math.huge then
        return 0
    end
    local whole = math.floor(value)
    local fraction = value - whole
    if fraction > 0.5 or fraction == 0.5 and whole % 2 ~= 0 then
        whole = whole + 1
    end

    return whole % MODULUS
end

local function signed(value: number): integer
    value = unsigned(value)
    return (value >= SIGN and value - MODULUS or value) as integer
end

local function combine(left: number, right: number, operation: string): integer
    left, right = unsigned(left), unsigned(right)
    local place, answer = 1, 0
    for _ = 1, 32 do
        local a, b = left % 2, right % 2
        local selected = operation == "and" and a == 1 and b == 1 or operation == "or" and (
            a == 1 or b == 1
        ) or operation == "xor" and a ~= b
        if selected then
            answer = answer + place
        end
        left, right, place = math.floor(left / 2), math.floor(right / 2), place * 2
    end

    return signed(answer)
end

local function fold(operation: string, identity: number, first: number, ...: number): integer
    local answer = combine(identity, first, operation)
    for index = 1, select("#", ...) do
        answer = combine(answer, select(index, ...), operation)
    end

    return answer
end

local function tobit(value: number): integer
    return signed(value)
end

local function band(first: number, ...: number): integer
    return fold("and", -1, first, ...)
end

local function bor(first: number, ...: number): integer
    return fold("or", 0, first, ...)
end

local function bxor(first: number, ...: number): integer
    return fold("xor", 0, first, ...)
end

local function bnot(value: number): integer
    return signed(MODULUS - 1 - unsigned(value))
end

local function lshift(value: number, count: number): integer
    return signed(unsigned(value) * 2 ^ (unsigned(count) % 32))
end

local function rshift(value: number, count: number): integer
    return signed(math.floor(unsigned(value) / 2 ^ (unsigned(count) % 32)))
end

local function arshift(value: number, count: number): integer
    count = unsigned(count) % 32
    value = signed(value)
    return signed(math.floor(value / 2 ^ count))
end

local function rol(value: number, count: number): integer
    count = unsigned(count) % 32
    if count == 0 then
        return signed(value)
    end

    return bor(lshift(value, count), rshift(value, 32 - count))
end

local function ror(value: number, count: number): integer
    return rol(value, 32 - unsigned(count) % 32)
end

local function bswap(value: number): integer
    local b0 = band(value, 0xff)
    local b1 = band(rshift(value, 8), 0xff)
    local b2 = band(rshift(value, 16), 0xff)
    local b3 = band(rshift(value, 24), 0xff)

    return bor(lshift(b0, 24), lshift(b1, 16), lshift(b2, 8), b3)
end

local function tohex(value: number, digits: number?): string
    digits = digits or 8
    local upper = digits < 0
    digits = math.abs(signed(digits))
    if digits == 0 then
        return ""
    end
    local text = ("%08x"):format(unsigned(value))
    text = digits > 8 and string.rep("0", digits - 8) .. text or text:sub(-digits)

    return upper and text:upper() or text
end

export = {
    tobit = tobit,
    band = band,
    bor = bor,
    bxor = bxor,
    bnot = bnot,
    lshift = lshift,
    rshift = rshift,
    arshift = arshift,
    rol = rol,
    ror = ror,
    bswap = bswap,
    tohex = tohex,
}
