-- The headers' API version, which the library must answer.
const VERSION = 0x1d000101

-- dlopen's RTLD_NOW, and RTLD_NOW | RTLD_GLOBAL on Darwin and on Linux.
const OPEN_NOW: int32 = 2
const OPEN_GLOBAL_DARWIN: int32 = 0xa
const OPEN_GLOBAL_LINUX: int32 = 0x102

--- `WGPUCallbackMode_AllowSpontaneous`: wgpu-native calls back from inside the
--- call that settles the operation, on the calling thread.
export const CALLBACK_SPONTANEOUS: integer = 3

export const STATUS_SUCCESS: integer = 1
export const BUFFER_USAGE_MAP_READ: integer = 0x1
export const BUFFER_USAGE_COPY_SRC: integer = 0x4
export const BUFFER_USAGE_COPY_DST: integer = 0x8
export const BUFFER_USAGE_UNIFORM: integer = 0x40
export const BUFFER_USAGE_STORAGE: integer = 0x80
export const BUFFER_USAGE_QUERY_RESOLVE: integer = 0x200
export const BUFFER_BINDING_UNIFORM: integer = 2
export const BUFFER_BINDING_STORAGE: integer = 3
export const BUFFER_BINDING_READ_ONLY_STORAGE: integer = 4
export const SHADER_STAGE_COMPUTE: integer = 0x4
export const MAP_MODE_READ: integer = 0x1
export const QUERY_TYPE_TIMESTAMP: integer = 2
export const FEATURE_TIMESTAMP_QUERY: integer = 9
export const FEATURE_LEVEL_CORE: integer = 2
export const POWER_HIGH_PERFORMANCE: integer = 2
export const ERROR_FILTER_VALIDATION: integer = 1
export const ERROR_TYPE_NO_ERROR: integer = 1
export const STYPE_SHADER_SOURCE_SPIRV: integer = 0x1
export const STYPE_SHADER_SOURCE_WGSL: integer = 0x2
export const STYPE_INSTANCE_EXTRAS: integer = 0x00030004

-- `WGPUInstanceBackend` bits, for the WGPU_BACKEND names wgpu reads.
const BACKENDS: {[string]: integer} = {vulkan = 1, gl = 2, gles = 2, metal = 4, dx12 = 8, d3d12 = 8}

-- `WGPUBackendType`, as wgpu's own `Backend::to_str` spells each.
const BACKEND_NAMES: {
    [integer]: string
} = {[1] = "noop", [2] = "webgpu", [4] = "dx12", [5] = "metal", [6] = "vulkan", [7] = "gl", [8] = "gl",}

--- The name wgpu gives a `WGPUBackendType`.
export function backendname(value: integer): string
    return BACKEND_NAMES[value] or "empty"
end

--- The instance backends WGPU_BACKEND asks for, or zero for every one.
--- @raises string when a name in the variable is not a backend
export function requestedbackends(): integer
    local wanted = os.getenv("WGPU_BACKEND")
    if wanted == nil or wanted == "" then
        return 0
    end
    local bits = 0
    for name in wanted:lower():gmatch("[^,%s]+") do
        local bit = BACKENDS[name]
        if bit == nil then
            error(("WGPU_BACKEND names unknown backend %q"):format(name), 0)
        end
        bits = bits | bit
    end

    return bits as integer
end

-- Opens `path` where declarations that name no library find it.
local function openGlobal(path: string): nil
    if WINDOWS then
        assert(LoadLibraryA(path) ~= nil, "cannot load the wgpu-native library " .. path)
        return
    end
    -- The modes differ, and Darwin's means RTLD_DEEPBIND to glibc, so the
    -- host is told by a symbol only Darwin's C library has.
    local darwin = dlsym(dlopen(nil, OPEN_NOW), "mach_absolute_time") ~= nil
    local name: any = path
    if dlopen(name, darwin and OPEN_GLOBAL_DARWIN or OPEN_GLOBAL_LINUX) == nil then
        local why: any = dlerror()
        error("cannot load the wgpu-native library " .. path .. ": " .. tostring(why), 0)
    end
end

local loaded: {[string]: any}? = nil

--- The library's functions by name, opening it the first time.
--- @raises string when the library is not named, does not load or is another version
export function library(): {[string]: any}
    if loaded ~= nil then
        return loaded
    end
    local path = assert(
        os.getenv("NUPP_WGPU_LIBRARY"),
        "NUPP_WGPU_LIBRARY must name the digest-verified wgpu-native library"
    )
    openGlobal(path)
    assert(wgpuGetVersion() == VERSION, "wgpu-native version does not match the pinned headers")
    -- A declaration is called, not held: each is reached through a function.
    local result: {[string]: any} = {
        wgpuBufferGetConstMappedRange = function(buffer: any, offset: any, size: any): any
            return wgpuBufferGetConstMappedRange(buffer, offset, size)
        end,
        wgpuGetVersion = function(): any
            return wgpuGetVersion()
        end,
        wgpuCreateInstance = function(descriptor: any): any
            return wgpuCreateInstance(descriptor)
        end,
        wgpuInstanceRelease = function(instance: any): nil
            wgpuInstanceRelease(instance)
        end,
        wgpuInstanceProcessEvents = function(instance: any): nil
            wgpuInstanceProcessEvents(instance)
        end,
        wgpuInstanceRequestAdapter = function(instance: any, options: any, callback: any): any
            return wgpuInstanceRequestAdapter(instance, options, callback)
        end,
        wgpuAdapterGetInfo = function(adapter: any, info: any): any
            return wgpuAdapterGetInfo(adapter, info)
        end,
        wgpuAdapterInfoFreeMembers = function(info: any): nil
            wgpuAdapterInfoFreeMembers(info)
        end,
        wgpuAdapterGetLimits = function(adapter: any, limits: any): any
            return wgpuAdapterGetLimits(adapter, limits)
        end,
        wgpuAdapterHasFeature = function(adapter: any, feature: any): any
            return wgpuAdapterHasFeature(adapter, feature)
        end,
        wgpuAdapterRequestDevice = function(adapter: any, descriptor: any, callback: any): any
            return wgpuAdapterRequestDevice(adapter, descriptor, callback)
        end,
        wgpuAdapterRelease = function(adapter: any): nil
            wgpuAdapterRelease(adapter)
        end,
        wgpuDeviceGetQueue = function(device: any): any
            return wgpuDeviceGetQueue(device)
        end,
        wgpuDeviceGetLimits = function(device: any, limits: any): any
            return wgpuDeviceGetLimits(device, limits)
        end,
        wgpuDeviceCreateBuffer = function(device: any, descriptor: any): any
            return wgpuDeviceCreateBuffer(device, descriptor)
        end,
        wgpuDeviceCreateBindGroupLayout = function(device: any, descriptor: any): any
            return wgpuDeviceCreateBindGroupLayout(device, descriptor)
        end,
        wgpuDeviceCreatePipelineLayout = function(device: any, descriptor: any): any
            return wgpuDeviceCreatePipelineLayout(device, descriptor)
        end,
        wgpuDeviceCreateShaderModule = function(device: any, descriptor: any): any
            return wgpuDeviceCreateShaderModule(device, descriptor)
        end,
        wgpuDeviceCreateComputePipeline = function(device: any, descriptor: any): any
            return wgpuDeviceCreateComputePipeline(device, descriptor)
        end,
        wgpuDeviceCreateBindGroup = function(device: any, descriptor: any): any
            return wgpuDeviceCreateBindGroup(device, descriptor)
        end,
        wgpuDeviceCreateCommandEncoder = function(device: any, descriptor: any): any
            return wgpuDeviceCreateCommandEncoder(device, descriptor)
        end,
        wgpuDeviceCreateQuerySet = function(device: any, descriptor: any): any
            return wgpuDeviceCreateQuerySet(device, descriptor)
        end,
        wgpuDevicePushErrorScope = function(device: any, filter: any): nil
            wgpuDevicePushErrorScope(device, filter)
        end,
        wgpuDevicePopErrorScope = function(device: any, callback: any): any
            return wgpuDevicePopErrorScope(device, callback)
        end,
        wgpuDevicePoll = function(device: any, wait: any, submission: any): any
            return wgpuDevicePoll(device, wait, submission)
        end,
        wgpuDeviceDestroy = function(device: any): nil
            wgpuDeviceDestroy(device)
        end,
        wgpuDeviceRelease = function(device: any): nil
            wgpuDeviceRelease(device)
        end,
        wgpuQueueWriteBuffer = function(queue: any, buffer: any, offset: any, data: any, size: any): nil
            wgpuQueueWriteBuffer(queue, buffer, offset, data, size)
        end,
        wgpuQueueSubmit = function(queue: any, count: any, commands: any): nil
            wgpuQueueSubmit(queue, count, commands)
        end,
        wgpuQueueGetTimestampPeriod = function(queue: any): any
            return wgpuQueueGetTimestampPeriod(queue)
        end,
        wgpuQueueRelease = function(queue: any): nil
            wgpuQueueRelease(queue)
        end,
        wgpuBufferMapAsync = function(buffer: any, mode: any, offset: any, size: any, callback: any): any
            return wgpuBufferMapAsync(buffer, mode, offset, size, callback)
        end,
        wgpuBufferUnmap = function(buffer: any): nil
            wgpuBufferUnmap(buffer)
        end,
        wgpuBufferDestroy = function(buffer: any): nil
            wgpuBufferDestroy(buffer)
        end,
        wgpuBufferRelease = function(buffer: any): nil
            wgpuBufferRelease(buffer)
        end,
        wgpuCommandEncoderBeginComputePass = function(encoder: any, descriptor: any): any
            return wgpuCommandEncoderBeginComputePass(encoder, descriptor)
        end,
        wgpuCommandEncoderCopyBufferToBuffer = function(
            encoder: any,
            source: any,
            sourceOffset: any,
            destination: any,
            destinationOffset: any,
            size: any
        ): nil
            wgpuCommandEncoderCopyBufferToBuffer(encoder, source, sourceOffset, destination, destinationOffset, size)
        end,
        wgpuCommandEncoderResolveQuerySet = function(
            encoder: any,
            querySet: any,
            first: any,
            count: any,
            destination: any,
            offset: any
        ): nil
            wgpuCommandEncoderResolveQuerySet(encoder, querySet, first, count, destination, offset)
        end,
        wgpuCommandEncoderFinish = function(encoder: any, descriptor: any): any
            return wgpuCommandEncoderFinish(encoder, descriptor)
        end,
        wgpuCommandEncoderRelease = function(encoder: any): nil
            wgpuCommandEncoderRelease(encoder)
        end,
        wgpuCommandBufferRelease = function(commands: any): nil
            wgpuCommandBufferRelease(commands)
        end,
        wgpuComputePassEncoderSetPipeline = function(pass: any, pipeline: any): nil
            wgpuComputePassEncoderSetPipeline(pass, pipeline)
        end,
        wgpuComputePassEncoderSetBindGroup = function(
            pass: any,
            index: any,
            group: any,
            offsetCount: any,
            offsets: any
        ): nil
            wgpuComputePassEncoderSetBindGroup(pass, index, group, offsetCount, offsets)
        end,
        wgpuComputePassEncoderDispatchWorkgroups = function(pass: any, x: any, y: any, z: any): nil
            wgpuComputePassEncoderDispatchWorkgroups(pass, x, y, z)
        end,
        wgpuComputePassEncoderEnd = function(pass: any): nil
            wgpuComputePassEncoderEnd(pass)
        end,
        wgpuComputePassEncoderRelease = function(pass: any): nil
            wgpuComputePassEncoderRelease(pass)
        end,
        wgpuComputePipelineGetBindGroupLayout = function(pipeline: any, index: any): any
            return wgpuComputePipelineGetBindGroupLayout(pipeline, index)
        end,
        wgpuComputePipelineRelease = function(pipeline: any): nil
            wgpuComputePipelineRelease(pipeline)
        end,
        wgpuBindGroupRelease = function(group: any): nil
            wgpuBindGroupRelease(group)
        end,
        wgpuBindGroupLayoutRelease = function(layout: any): nil
            wgpuBindGroupLayoutRelease(layout)
        end,
        wgpuPipelineLayoutRelease = function(layout: any): nil
            wgpuPipelineLayoutRelease(layout)
        end,
        wgpuShaderModuleRelease = function(module: any): nil
            wgpuShaderModuleRelease(module)
        end,
        wgpuQuerySetDestroy = function(querySet: any): nil
            wgpuQuerySetDestroy(querySet)
        end,
        wgpuQuerySetRelease = function(querySet: any): nil
            wgpuQuerySetRelease(querySet)
        end,
    }
    loaded = result

    return result
end

-- A record's words (`KEPT_*` in native/corebridge/main.c): the calls it was
-- offered, the entry bytes it keeps, how many fit, and the calls that found
-- no room. Each entry is three words -- the call's two leading arguments and
-- its text's length -- and the text, padded to a word.
const RECORD_HEADER_WORDS = 4
const ENTRY_WORDS = 3
const WORD = 8
const LOW32 = 0xffffffff
-- Room for a request's message, and for the faults a device reports
-- between two drains.
const REQUEST_BYTES = 4096
const FAULT_BYTES = 16384

-- A new record with room for `bytes` of entries.
local function newRecord(bytes: integer): any
    local record: any = storage.allocarray(storage.scalar("uint64"), RECORD_HEADER_WORDS + bytes // WORD)
    record[2] = bytes

    return record
end

-- The calls `record` kept, each `{first, second, message}`, and how many found
-- no room; the record is emptied.
local function drain(record: any): ({{[string]: any}}, integer)
    local used = tonumber(record[1]) as integer
    local dropped = tonumber(record[3]) as integer
    local kept: {{[string]: any}} = {}
    if used > 0 then
        local bytes = storage.string(record, RECORD_HEADER_WORDS * WORD + used)
        local at: integer = RECORD_HEADER_WORDS * WORD
        local last = at + used
        while at < last do
            local word = at // WORD
            local length = tonumber(record[word + 2]) as integer
            local text = bytes:sub(at + ENTRY_WORDS * WORD + 1, at + ENTRY_WORDS * WORD + length)
            kept[#kept + 1] = {first = record[word], second = record[word + 1], message = text}
            at = (at + ENTRY_WORDS * WORD + (length + WORD - 1) // WORD * WORD) as integer
        end
    end
    record[0], record[1], record[3] = 0, 0, 0

    return kept, dropped
end

-- Each request's record by the key it is taken with, until it is taken, and
-- each device's fault records by its key.
local settled: {[integer]: any} = {}
local faults: {[integer]: {any}} = {}
local nextToken: integer = 0

--- A fresh request's first userdata and the key its result is taken with.
export function token(): (any, integer)
    nextToken = (nextToken + 1) as integer
    local record = newRecord(REQUEST_BYTES)
    settled[nextToken] = record

    return record, nextToken
end

--- What the callback for `key` delivered -- its `status`, `value` (the
--- object it passed, or nil), `kind` and `message` -- or false if it has not run.
export function take(key: integer): any
    local record = settled[key]
    settled[key] = nil
    if record == nil or tonumber(record[0]) == 0 then
        return false
    end
    local kept = drain(record)
    local call = kept[1] or {first = 0, second = 0, message = ""}
    local status = (call.first as integer) & LOW32
    local second = call.second as integer

    return {
        status = status,
        value = second ~= 0 and second or nil,
        kind = second & LOW32,
        message = call.message or "",
    }
end

--- Starts collecting faults for one device: the first userdata of its lost
--- callback, that of its uncaptured-error callback, and its key.
export function faultsink(): (any, any, integer)
    nextToken = (nextToken + 1) as integer
    local lost, uncaptured = newRecord(FAULT_BYTES), newRecord(FAULT_BYTES)
    faults[nextToken] = {lost, uncaptured}

    return lost, uncaptured, nextToken
end

const LOST_REASONS: {
    [integer]: string
} = {[1] = "Unknown", [2] = "Destroyed", [3] = "CallbackCancelled", [4] = "FailedCreation",}

const ERROR_TYPES: {
    [integer]: string
} = {[2] = "Validation Error", [3] = "Out of Memory", [4] = "Internal error", [5] = "Unknown error",}

--- How wgpu describes an error type.
export function errortype(value: integer): string
    return ERROR_TYPES[value] or ("error type " .. tostring(value))
end

--- Takes every fault recorded for a device since the last call.
export function takefaults(key: integer): {string}
    local records = faults[key]
    if records == nil then
        return {}
    end
    local recorded: {string} = {}
    local missed = 0
    local errors, errorsMissed = drain(records[2])
    for _, call in ipairs(errors) do
        local text = call.message as string
        recorded[#recorded + 1] = text ~= "" and text or errortype((call.second as integer) & LOW32)
    end
    local lost, lostMissed = drain(records[1])
    for _, call in ipairs(lost) do
        local reason = (call.second as integer) & LOW32
        recorded[
            #recorded + 1
        ] = ("device lost (%s): %s"):format(LOST_REASONS[reason] or tostring(reason), call.message)
    end
    missed = errorsMissed + lostMissed
    if missed > 0 then
        recorded[#recorded + 1] = ("%d more GPU faults were not kept"):format(missed)
    end

    return recorded
end

--- Stops collecting faults for a device.
export function dropfaults(key: integer): nil
    faults[key] = nil
end

local keepers: {[string]: any}? = nil

-- The address of the bridge's keeper `name`.
local function keeper(name: string): any
    local found: any = nil
    if WINDOWS then
        found = GetProcAddress(GetModuleHandleA(nil), name)
    else
        found = dlsym(dlopen(nil, OPEN_NOW), name)
    end

    assert(found ~= nil, "the core's C bridge has no GPU callback " .. name)

    return found
end

--- The callback each request and device fault is reported through.
export function callbacks(): {[string]: any}
    if keepers == nil then
        local pair = keeper("nupp_core_keep_pair_text")
        keepers = {
            adapter = pair,
            device = pair,
            map = keeper("nupp_core_keep_text"),
            scope = pair,
            lost = pair,
            error = pair
        }
    end

    return keepers as {[string]: any}
end

export function view(text: string?): any
    return memory.view(text)
end

export function pause(milliseconds: integer): nil
    if milliseconds <= 0 then
        return
    end
    if WINDOWS then
        Sleep(milliseconds as uint32)
    else
        usleep((milliseconds * 1000) as uint32)
    end
end
