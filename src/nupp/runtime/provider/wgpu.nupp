@!internal
module nupp.runtime.provider.wgpu

--[[
The pinned wgpu-native compute ABI through Nupp's checked native calls.

The library is the one `NUPP_WGPU_LIBRARY` names, opened the first time
[](library) is asked for it and never before, so a program that does not use the
GPU needs none. It is opened into the global namespace, where the declarations
below, which name no library, find it.

wgpu-native reports through callbacks, which C cannot enter Nupp through. Each
callback is one of the C bridge's keepers (`nupp_core_keep_pair_text` and
`nupp_core_keep_text` in native/corebridge/main.c): it copies the call into the
record its first userdata names, which this module reads once the call that
settled the request has returned.
]]

local memory = require("nupp.runtime.provider.wgpumemory")
local storage = require("nupp.vm.storagebinding")

const WINDOWS = package.config:sub(1, 1) == "\\"

cdef function dlopen(path: voidptr?, mode: int32): voidptr?
cdef function dlsym(borrows library: voidptr?, name: string): voidptr?
cdef function dlerror(): cstring?
cdef function LoadLibraryA(path: string): voidptr?
cdef function GetModuleHandleA(name: voidptr?): voidptr?
cdef function GetProcAddress(borrows library: voidptr?, name: string): voidptr?
cdef function usleep(microseconds: uint32): int32
cdef function Sleep(milliseconds: uint32)

cdef function wgpuGetVersion(): uint32
cdef function wgpuCreateInstance(borrows descriptor: voidptr?): voidptr?
cdef function wgpuInstanceRelease(borrows instance: voidptr)
cdef function wgpuInstanceProcessEvents(borrows instance: voidptr)
cdef function wgpuInstanceRequestAdapter(
    borrows instance: voidptr,
    borrows options: voidptr?,
    callback: memory.CallbackInfo
): memory.Future
cdef function wgpuAdapterGetInfo(borrows adapter: voidptr, borrows info: voidptr): uint32
cdef function wgpuAdapterInfoFreeMembers(info: memory.AdapterInfo)
