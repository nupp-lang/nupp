@!internal
module nupp.runtime.provider.nativecrypto

--[[Native cryptographic randomness for the host.crypto API 1 contract.

The native host fills a fresh temporary byte allocation from its secure random
source. The result is copied into an owned Lua string; no pointer escapes. Counts
are bounded to one MiB, and zero returns an empty string without calling the host.
Native failure raises with the host diagnostic. This module is carried only by
native targets and is selected by nupp.crypto during module initialization.
]]

const native = require("nupp.runtime.native")
native.ffi.cdef[[
int32_t nuppNativeV2RandomBytes(uint8_t *, size_t);
]]

--- Returns cryptographically secure random bytes from the selected host.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises when the count is invalid or the host cannot supply randomness
export function randomBytes(count: integer): string
    if count < 0 or count ~= math.floor(count) or count > 1048576 then
        error("random byte count must be an integer between 0 and 1048576", 2)
    end
    if count == 0 then
        return ""
    end
    local output = native.ffi.new("uint8_t[?]", count)
    native.succeeded(native.C.nuppNativeV2RandomBytes(output, count), 2)

    return native.ffi.string(output, count)
end
