module nupp.runtime.provider.wasmstoragefactory

--[[Checked struct values over an opaque, bounds-checked Wasm memory service.]]

local factory = {}

local WIDTHS = {
    boolean = {1, 1},
    float = {4, 4},
    integer = {4, 4},
    int8 = {1, 1},
    int16 = {2, 2},
    int32 = {4, 4},
    uint8 = {1, 1},
    uint16 = {2, 2},
    uint32 = {4, 4},
    number = {8, 8},
    int64 = {8, 8},
    uint64 = {8, 8},
}

local function roundUp(value: integer, alignment: integer): integer
    return math.floor((value + alignment - 1) / alignment) * alignment
end

function factory.new(memory: any): any
    local provider: any = {referenceValued = true}
    local descriptors: any = setmetatable({}, {__mode = "k"})
    for _, name in ipairs({"allocate", "pointer", "offset", "load", "store", "copy", "lease", "releaseLease"}) do
        provider[name] = memory[name]
    end

    local scalarCache: {[string]: any} = {}
    function provider.scalar(kind: string): any
        local cached = scalarCache[kind]
        if cached ~= nil then
            return cached
        end
        local width = assert(WIDTHS[kind], "nupp: Wasm storage has no scalar " .. tostring(kind))
        local spelling = kind == "boolean"
            and "bool"
            or kind == "number"
            and "double"
            or kind == "float"
            and "float"
            or kind == "integer"
            and "int32_t"
            or kind
            .. "_t"
        local physical: any = {kind = kind, ctype = spelling, size = width[1], alignment = width[2],}
        function physical:read(pointer: any, byteOffset: integer): any
            return memory.load(pointer, byteOffset, self.kind)
        end

        function physical:write(pointer: any, byteOffset: integer, value: any): nil
            memory.store(pointer, byteOffset, self.kind, value)
        end

        function physical:zero(): any
            if self.kind == "int64" or self.kind == "uint64" then
                return memory.int64[self.kind](0)
            end
            return self.kind == "boolean" and false or 0
        end

        physical.new = physical.zero
        function physical:copy(value: any): any
            local allocation = memory.allocate(self.size)
            local pointer = memory.pointer(allocation, 0, 1)
            self:write(pointer, 0, value)
            return self:read(pointer, 0)
        end

        function physical:isa(value: any): boolean
            if self.kind == "boolean" then
                return type(value) == "boolean"
            end

            if self.kind == "int64" or self.kind == "uint64" then
                return memory.isWide(value, self.kind == "uint64")
            end

            return type(value) == "number"
        end

        descriptors[physical] = true
        scalarCache[kind] = physical

        return physical
    end

    function provider.allocateArray(element: any, count: integer): any
        assert(descriptors[element], "nupp: arrays require a physical storage descriptor")
        local width = element.size as integer
        assert(
            count >= 0 and count % 1 == 0 and width >= 0 and count <= math.floor(4294967295 / math.max(width, 1)),
            "nupp: storage array extent exceeds memory32"
        )

        return memory.typed(memory.pointer(memory.allocate(width * count), 0, 1), element, count)
    end

    function provider.boundedCount(source: any, count: integer): integer
        assert(count >= 0 and count % 1 == 0 and count <= #source, "nupp: span extent exceeds its allocation")
        return count
    end

    function provider.allocateBytes(count: integer): any
        return provider.allocateArray(provider.scalar("uint8"), count)
    end

    function provider.borrowString(bytes: string): any
        return memory.typed(memory.borrowString(bytes), provider.scalar("uint8"))
    end

    function provider.castBytes(pointer: any): any
        return memory.typed(pointer, provider.scalar("uint8"))
    end

    function provider.castElements(element: any, pointer: any): any
        return memory.typed(pointer, element)
    end

    function provider.copy(destination: any, source: any, count: integer): nil
        memory.copy(destination, type(source) == "string" and memory.borrowString(source) or source, count)
    end

    -- A struct or fixed-array reference is a table naming its page and byte
    -- offset, where the host's fill wants a pointer. A byte-strided pointer
    -- advanced to that offset addresses the same bytes, so a row handed out of a
    -- `T[?]` clears the way the array it sits in does.
    function provider.fill(destination: any, count: integer, value: integer): nil
        if type(destination) == "table" then
            local pointer = rawget(destination, "__nuppWasmPointer")
            local byteOffset = rawget(destination, "__nuppWasmOffset")
            assert(pointer ~= nil and byteOffset ~= nil, "nupp: fill needs a pointer or a struct reference")
            destination = memory.offset(memory.typed(pointer, provider.scalar("uint8")), byteOffset)
        end
        memory.fill(destination, count, value)
    end

    function provider.sizeOf(element: any): integer
        assert(descriptors[element], "nupp: sizes are answered for physical storage descriptors")
        return element.size as integer
    end

    provider.string = memory.string

    function provider.decodeUint8(bytes: string): any
        return memory.decode("uint8", bytes)
    end

    function provider.encodeUint8(value: any): string
        return memory.encode("uint8", value)
    end

    function provider.decodeInt8(bytes: string): any
        return memory.decode("int8", bytes)
    end

    function provider.encodeInt8(value: any): string
        return memory.encode("int8", value)
    end

    function provider.decodeUint16(bytes: string): any
        return memory.decode("uint16", bytes)
    end

    function provider.encodeUint16(value: any): string
        return memory.encode("uint16", value)
    end

    function provider.decodeInt16(bytes: string): any
        return memory.decode("int16", bytes)
    end

    function provider.encodeInt16(value: any): string
        return memory.encode("int16", value)
    end

    function provider.decodeUint32(bytes: string): any
        return memory.decode("uint32", bytes)
    end

    function provider.encodeUint32(value: any): string
        return memory.encode("uint32", value)
    end

    function provider.decodeInt32(bytes: string): any
        return memory.decode("int32", bytes)
    end

    function provider.encodeInt32(value: any): string
        return memory.encode("int32", value)
    end

    function provider.decodeUint64(bytes: string): any
        return memory.decode("uint64", bytes)
    end

    function provider.encodeUint64(value: any): string
        return memory.encode("uint64", value)
    end

    function provider.decodeInt64(bytes: string): any
        return memory.decode("int64", bytes)
    end

    function provider.encodeInt64(value: any): string
        return memory.encode("int64", value)
    end

    function provider.decodeFloat32(bytes: string): any
        return memory.decode("float", bytes)
    end

    function provider.encodeFloat32(value: any): string
        return memory.encode("float", value)
    end

    function provider.decodeFloat64(bytes: string): any
        return memory.decode("number", bytes)
    end

    function provider.encodeFloat64(value: any): string
        return memory.encode("number", value)
    end

    function provider.reference(resolve: function(): any): any
        local reference: any = {size = 4, alignment = 4, ctype = "pointer", resolve = resolve}
        function reference:read(pointer: any, byteOffset: integer): any
            return memory.loadReference(pointer, byteOffset)
        end

        function reference:write(pointer: any, byteOffset: integer, value: any): nil
            if value ~= nil then
                -- A typed projection retains the allocation and readonly permission.
                value = memory.typed(value, resolve())
            end
            memory.storeReference(pointer, byteOffset, value)
        end

        descriptors[reference] = true

        return reference
    end

    local arrayCache: any = setmetatable({}, {__mode = "k"})
    function provider.array(element: any, count: integer): any
        assert(count >= 0 and count % 1 == 0, "nupp: fixed array count must be a nonnegative integer")
        local cached = arrayCache[element]
        if cached == nil then
            cached = {};
            arrayCache[element] = cached
        end
        if cached[count] ~= nil then
            return cached[count]
        end
        assert(
            element.size >= 0 and count <= math.floor(4294967295 / math.max(element.size, 1)),
            "nupp: fixed array extent exceeds memory32"
        )
        local fixed: any = {
            element = element,
            ctype = tostring(element.ctype) .. "[" .. tostring(count) .. "]",
            count = count,
            size = element.size * count,
            alignment = element.alignment,
        }
        local instances: any = {}
        function instances.__index(self: any, index: any): any
            if type(index) ~= "number" or index % 1 ~= 0 or index < 0 or index >= count then
                error("fixed-array index out of bounds", 2)
            end
            return element:read(
                rawget(self, "__nuppWasmPointer"),
                rawget(self, "__nuppWasmOffset") + index * element.size
            )
        end

        function instances.__newindex(self: any, index: any, value: any): nil
            if type(index) ~= "number" or index % 1 ~= 0 or index < 0 or index >= count then
                error("fixed-array index out of bounds", 2)
            end
            element:write(
                rawget(self, "__nuppWasmPointer"),
                rawget(self, "__nuppWasmOffset") + index * element.size,
                value
            )
        end

        function fixed:read(pointer: any, byteOffset: integer): any
            return setmetatable(
                {__nuppWasmPointer = pointer, __nuppWasmOffset = byteOffset, __nuppWasmType = self,},
                instances
            )
        end

        function fixed:write(pointer: any, byteOffset: integer, value: any): nil
            assert(self:isa(value), "nupp: cannot store a value of another fixed-array type")
            memory.copyAt(
                pointer,
                byteOffset,
                rawget(value, "__nuppWasmPointer"),
                rawget(value, "__nuppWasmOffset"),
                self.size
            )
        end

        function fixed:new(): any
            local allocation = memory.allocate(self.size)
            return self:read(memory.pointer(allocation, 0, 1), 0)
        end

        fixed.zero = fixed.new
        function fixed:copy(value: any): any
            local out = self:new()
            self:write(rawget(out, "__nuppWasmPointer"), 0, value)
            return out
        end

        function fixed:isa(value: any): boolean
            return type(
                value
            ) == "table" and getmetatable(value) == instances and rawget(value, "__nuppWasmType") == self
        end

        descriptors[fixed] = true
        cached[count] = fixed

        return fixed
    end

    function provider.define(layout: any, methods: table): any
        local cursor: integer = 0
        local bitCursor: integer = 0
        local aggregateAlignment: integer = 1
        local fields, byName = {}, {}
        for _, declared in ipairs(layout.fields) do
            local physical = declared.type or provider.scalar(declared.kind)
            local physicalAlignment = physical.alignment as integer
            local physicalSize = physical.size as integer
            local shift: integer = 0
            if declared.bits ~= nil then
                local bits = declared.bits as integer
                assert(bits > 0 and bits <= physicalSize * 8, "nupp: invalid bitfield width")
                local unit = physicalSize * 8
                if bitCursor % unit + bits > unit then
                    bitCursor = roundUp(bitCursor, unit)
                end
                cursor = math.floor(bitCursor / 8) as integer
                shift = bitCursor % 8
                bitCursor = bitCursor + bits
            else
                cursor = roundUp(math.ceil(bitCursor / 8) as integer, physicalAlignment)
                bitCursor = (cursor + physicalSize) * 8
            end
            local field = {
                name = declared.name,
                type = physical,
                offset = cursor,
                size = physicalSize,
                alignment = physicalAlignment,
                bits = declared.bits,
                shift = shift,
                kind = declared.kind,
            }
            fields[#fields + 1] = field
            byName[field.name] = field
            cursor = math.ceil(bitCursor / 8) as integer
            if physicalAlignment > aggregateAlignment then
                aggregateAlignment = physicalAlignment
            end
        end

        local instances: any = {}
        local fixed: any = {
            name = layout.name,
            ctype = layout.name,
            fields = fields,
            size = roundUp(cursor, aggregateAlignment),
            alignment = aggregateAlignment,
        }
        function instances.__index(self: any, name: any): any
            local method = methods.__index and methods.__index[name]
            if method ~= nil then
                return method
            end
            local field = byName[name]
            if field == nil then
                error("nupp: " .. layout.name .. " has no field " .. tostring(name), 2)
            end

            if field.bits ~= nil then
                return memory.bits(
                    rawget(self, "__nuppWasmPointer"),
                    rawget(self, "__nuppWasmOffset") + field.offset,
                    field.shift,
                    field.bits,
                    field.kind
                )
            end

            return field.type:read(rawget(self, "__nuppWasmPointer"), rawget(self, "__nuppWasmOffset") + field.offset)
        end

        function instances.__newindex(self: any, name: any, value: any): nil
            local field = byName[name]
            if field == nil then
                error("nupp: " .. layout.name .. " has no field " .. tostring(name), 2)
            end
            if field.bits ~= nil then
                memory.bits(
                    rawget(self, "__nuppWasmPointer"),
                    rawget(self, "__nuppWasmOffset") + field.offset,
                    field.shift,
                    field.bits,
                    field.kind,
                    value
                )
            else
                field.type:write(
                    rawget(self, "__nuppWasmPointer"),
                    rawget(self, "__nuppWasmOffset") + field.offset,
                    value
                )
            end
        end

        function fixed:read(pointer: any, byteOffset: integer): any
            return setmetatable(
                {__nuppWasmPointer = pointer, __nuppWasmOffset = byteOffset, __nuppWasmType = self,},
                instances
            )
        end

        function fixed:write(pointer: any, byteOffset: integer, value: any): nil
            assert(self:isa(value), "nupp: cannot store a value of another struct type")
            memory.copyAt(
                pointer,
                byteOffset,
                rawget(value, "__nuppWasmPointer"),
                rawget(value, "__nuppWasmOffset"),
                self.size
            )
        end

        function fixed:zero(): any
            local allocation = memory.allocate(self.size)
            return self:read(memory.pointer(allocation, 0, 1), 0)
        end

        fixed.new = fixed.zero
        function fixed:of(...): any
            local value = self:zero()
            local args = {...}
            for index, field in ipairs(fields) do
                if args[index] ~= nil then
                    value[field.name] = args[index]
                end
            end

            return value
        end

        function fixed:copy(value: any): any
            local out = self:zero()
            self:write(rawget(out, "__nuppWasmPointer"), 0, value)
            return out
        end

        function fixed:isa(value: any): boolean
            return type(
                value
            ) == "table" and getmetatable(value) == instances and rawget(value, "__nuppWasmType") == self
        end

        setmetatable(fixed, {
            __call = function(_, ...)
                return fixed:of(...)
            end,
        })

        descriptors[fixed] = true

        return fixed
    end

    function provider.layout(subject: any): any
        local fields, offsets = {}, {}
        local fingerprint = {"wasm32", tostring(subject.name), tostring(subject.size), tostring(subject.alignment)}
        for _, field in ipairs(subject.fields or {}) do
            local spelling = field.type.resolve and (
                tostring(field.type.resolve().ctype) .. " *"
            ) or tostring(field.type.ctype)
            fingerprint[
                #fingerprint + 1
            ] = table.concat(
                {
                    field.name,
                    spelling,
                    tostring(field.offset),
                    tostring(field.size),
                    tostring(field.alignment),
                    tostring(field.bits),
                    tostring(field.shift)
                },
                ":"
            )
            offsets[field.name] = field.offset
            fields[#fields + 1] = {
                name = field.name,
                ctype = spelling,
                offset = field.offset,
                size = field.size,
                alignment = field.alignment,
                padding = 0,
                pointerType = provider.reference(
                    function()
                        return field.type
                    end
                ),
            }
        end
        for index, field in ipairs(fields) do
            local after = fields[index + 1] and fields[index + 1].offset or subject.size
            field.padding = math.max(0, after - field.offset - field.size)
        end

        return {
            name = subject.name,
            size = subject.size,
            alignment = subject.alignment,
            fields = fields,
            offsets = offsets,
            fingerprint = table.concat(fingerprint, "|"),
        }
    end

    function provider.descriptor(value: any): any
        local physical = type(value) == "table" and rawget(value, "__nuppWasmType") or nil
        assert(
            physical and descriptors[physical] and physical:isa(value),
            "nupp: storage needs a genuine physical value witness"
        )

        return physical
    end

    return provider
end

export = factory
