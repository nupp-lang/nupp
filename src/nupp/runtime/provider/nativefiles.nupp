@!internal
--[[
`nupp.runtime.provider.nativefiles` is the native filesystem provider behind the
`os` filesystem functions and `io.open`. It reaches the compiler-owned Rust
library, whose metadata, listing and cursor operations run on the caller's thread
and whose whole-file transfers run on a bounded shared lane.

The lane is bounded three ways: how many transfers may be live, how many bytes
they may hold between them, and how large one may be. Past any of the three a
submission returns a reason rather than queueing, because a queue that grows with
its callers eventually takes the process with it. `pendingTransfers` reports what
the lane is holding. A transfer waits by suspending, so a `@nosuspend` region may
describe, list and rename paths but not copy or write whole files.
]]
module nupp.runtime.provider.nativefiles

const systeminfo = require("nupp.runtime.systeminfo")

----------------------------------------------------------------------------
-- The native binding
----------------------------------------------------------------------------

const native = require("nupp.runtime.native")
const suspension = require("nupp.suspension")
const paths = require("io.internal.path")
const io = require("io")
local scalarAdapters = require("nupp.io.internal.scalars")
local privateIo = require("nupp.io")
const span = require("binary.span")
const messages = require("io.internal.files.messages")
const appPaths = require("io.internal.files.path")

-- The record is declared here rather than in the runtime cdef below, because
-- `ffi.new` names it and the checker has to know the type to accept that. It reaches
-- LuaJIT as a bare `struct` rather than a typedef, which is why the prototype below
-- writes it that way. The functions stay in the runtime declaration: they are reached
-- through the handle `nupp.runtime.native` opened, not the default namespace a `cdef
-- function` binds to.
cdef struct NuppNativeFilesInfo
    kind: uint32
    read_only: int32
    size: uint64
    modified: number
end

cdef struct NuppNativeFilesSlice
    data: cstring
    length: uint64
end

native.ffi.cdef[[
int32_t nuppNativeFilesInfo(
    struct NuppNativeFilesSlice, int32_t, struct NuppNativeFilesInfo *);
int32_t nuppNativeFilesReadLink(struct NuppNativeFilesSlice, uint64_t *);
int32_t nuppNativeFilesCreateSymlink(
    struct NuppNativeFilesSlice, struct NuppNativeFilesSlice, int32_t);
int32_t nuppNativeFilesCreateDirectory(struct NuppNativeFilesSlice);
int32_t nuppNativeFilesRemove(struct NuppNativeFilesSlice, int32_t);
int32_t nuppNativeFilesRename(
    struct NuppNativeFilesSlice, struct NuppNativeFilesSlice);
int32_t nuppNativeFilesExists(struct NuppNativeFilesSlice);
int32_t nuppNativeFilesListOpen(struct NuppNativeFilesSlice, uint64_t *);
int32_t nuppNativeFilesListNext(uint64_t, uint64_t *);
int32_t nuppNativeFilesListClose(uint64_t);
int32_t nuppNativeFilesGlob(struct NuppNativeFilesSlice, uint64_t *);
int32_t nuppNativeFilesCreateTemporary(
    struct NuppNativeFilesSlice, struct NuppNativeFilesSlice,
    struct NuppNativeFilesSlice,
    int32_t, uint64_t *);
int32_t nuppNativeFilesApplicationBase(uint32_t, uint64_t *);

int32_t nuppNativeFileOpen(struct NuppNativeFilesSlice, uint32_t, uint64_t *);
int32_t nuppNativeFileRead(uint64_t, uint8_t *, size_t, size_t *);
int32_t nuppNativeFileWrite(uint64_t, const uint8_t *, size_t, size_t *);
int32_t nuppNativeFileSeek(uint64_t, int64_t, uint32_t, int64_t *);
int32_t nuppNativeFileSize(uint64_t, int64_t *);
int32_t nuppNativeFileFlush(uint64_t);
int32_t nuppNativeFileRelease(uint64_t);

int32_t nuppNativeFilesTransferSubmitRead(
    struct NuppNativeFilesSlice, uint64_t *);
int32_t nuppNativeFilesTransferSubmitWrite(
    struct NuppNativeFilesSlice, struct NuppNativeFilesSlice,
    uint32_t, uint64_t *);
int32_t nuppNativeFilesTransferSubmitCopy(
    struct NuppNativeFilesSlice, struct NuppNativeFilesSlice, uint64_t *);
int32_t nuppNativeFilesTransferStatus(uint64_t, uint32_t *);
int32_t nuppNativeFilesTransferTakeBytes(uint64_t, uint64_t *);
int32_t nuppNativeFilesTransferCancel(uint64_t);
int32_t nuppNativeFilesTransferRelease(uint64_t);
int32_t nuppNativeFilesTransferPending(size_t *);
]]

local ffi = native.ffi
local C = native.C
const FILES_FEATURE = 128
local featureChecked = false

local function requireFiles(): nil
    if not featureChecked then
        native.requireFeature(FILES_FEATURE, "files")
        featureChecked = true
    end
end

local function slice(text: string): any
    requireFiles()
    local value = ffi.new<NuppNativeFilesSlice>()
    -- The slice points into the Lua string; every caller hands it to C and returns
    -- while `text` is still a live argument of its own, so the string outlives the
    -- call.
    @unsafe do
        value.data = text
    end
    value.length = #text

    return value
end

local function fileRead(handle: any, borrows destination: uint8[?], count: integer, wrote: any): integer
    local call = C.nuppNativeFileRead as function(
        handle: any,
        borrows destination: uint8[?],
        count: integer,
        wrote: any
    ): integer

    return call(handle, destination, count, wrote)
end

local function fileWrite(handle: any, borrows source: const uint8[?], count: integer, wrote: any): integer
    local call = C.nuppNativeFileWrite as function(
        handle: any,
        borrows source: const uint8[?],
        count: integer,
        wrote: any
    ): integer

    return call(handle, source, count, wrote)
end

-- The library numbers what a path is, what an entry is, which user folder, how a file
-- is opened, and what a seek is measured from. Each of these is its side of one of
-- those enumerations.
local KINDS = {[1] = "file", [2] = "directory", [3] = "other", [4] = "symlink",}
local ENTRIES = {f = "file", d = "directory", l = "symlink", o = "other",}
local MODES = {r = 0, w = 1, a = 2, ["r+"] = 3, ["w+"] = 4, ["a+"] = 5,}
local ORIGINS = {set = 0, current = 1, ["end"] = 2,}

local READ_SIZE: integer = 65536
-- What `nuppNativeFilesExists` answers for a name that does not resolve.
local ABSENT: integer = -1
local MAX_EXACT_INTEGER: integer = 9007199254740991
local PENDING: integer = 0
local READY: integer = 1
local FAILED: integer = 2
local CANCELED: integer = 3

-- The readiness pump this module registers with whoever is handling suspensions. It
-- sleeps on the readiness generation every native family shares, which a settled
-- transfer advances.
local SOURCE = "nupp-files"

----------------------------------------------------------------------------
-- What the filesystem answers with
----------------------------------------------------------------------------

--- What a path refers to. A `symlink` answer only ever comes from a query that
--- does not follow links.
--- @export
export type FileKind = messages.FileKind

--- How an open file may be used. The three update modes read and write: `r+` needs an
--- existing file, `w+` truncates one, and `a+` appends.
--- @export
export type Mode = messages.Mode

--- What a seek offset is measured from.
--- @export
export type Origin = messages.Origin

----------------------------------------------------------------------------
-- Owners and argument checks
----------------------------------------------------------------------------

-- Declared ahead of the records because their methods reach them, and defined below
-- because they name the records. The types are the contract either way.
local scratch: function(borrows self: File, count: integer): any

--- @raises string when value is neither a path nor a string
local function named(value: any, what: string, level: integer): string
    if type(value) == "string" then
        return value as string
    end
    if appPaths.is(value) then
        return (value as appPaths.AppPath):tostring()
    end
    if type(value) == "table" and (value as any).tostring ~= nil then
        return (value as paths.Path):tostring()
    end
    error("nupp: os " .. what .. " must be a path or a string", level)
end

--- @raises string when value is not an integer
local function whole(value: any, what: string, level: integer): integer
    if type(value) ~= "number"
        or value ~= math.floor(value as number)
        or math.abs(value as number) > MAX_EXACT_INTEGER
    then
        error("nupp: io " .. what .. " must be an integer", level)
    end

    return value as integer
end

--- @raises string when value is not a positive integer
local function positive(value: any, what: string, level: integer): integer
    local answer = whole(value, what, level + 1)
    if answer < 1 then
        error("nupp: io " .. what .. " must be positive", level)
    end

    return answer
end

-- A direct call answers a status, and a failure's reason lives on the provider's
-- thread-local error channel.
local function done(status: integer): (boolean, string?)
    if status == 0 then
        return true, nil
    end

    return false, ffi.string(C.nuppNativeLastError())
end

-- Dynamic answers cross as native byte handles. `native.bytes` copies their
-- contents into a Lua string and releases the generational handle exactly once.
local function answer(status: integer, output: any): (string?, string?)
    if status ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end

    return native.bytes(output[0]), nil
end

-- Reads through a caller-owned native buffer.
local function readBytes(handle: any, into: any, count: integer): (string?, string?)
    local output = ffi.new("size_t[1]")
    local status = C.nuppNativeFileRead(handle, into, count, output)
    if status ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end
    local got = tonumber(output[0]) as integer
    if got < 0 or got > count then
        return nil, "the native files provider returned an invalid read count"
    end
    if got == 0 then
        return "", nil
    end

    return ffi.string(into, got), nil
end

----------------------------------------------------------------------------
-- Open files
----------------------------------------------------------------------------

--- An open file, and the obligation to close it.
---
--- A file is itself a `Reader` and a `Writer`, both moving one shared cursor, so
--- it goes wherever a byte stream does.
--- @export
export record File is io.Reader, io.Writer
    --- Takes this file and adds scalar reads and writes at its shared cursor.
    --- @param self the file to take
    --- @return the scalar stream, owned by the caller
    function scalar(takes self): affine(io.ScalarStream)
        return scalarAdapters.duplex(self)
    end

    @private _handle: any
    @private _closed: boolean
    @private _scratch: any
    @private _capacity: integer

    --- Reads up to `count` bytes at the cursor.
    ---
    --- An empty answer is the end of the file.
    --- @param self this file
    --- @param count the most bytes to read
    --- @return the bytes, or nil when the file is closed
    --- @return why it could not read, when unsuccessful
    --- @raises string when count is not a positive integer
    function read(exclusive self, count: integer): (string?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local wanted = positive(count, "File:read count", 2)
        local into = scratch(self, wanted)

        return readBytes(self._handle, into, wanted)
    end

    --- Reads at the cursor directly into a checked writable span.
    --- @param self this file
    --- @param destination the positive-sized range to fill
    --- @return how many bytes were read, or nil when the file is closed
    --- @return why it could not read, when unsuccessful
    function readspan(exclusive self, exclusive destination: span.Writable<uint8>): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local wanted = positive(#destination, "File:readspan destination length", 2)
        local pointer = destination:ref()
        local output = ffi.new("size_t[1]")
        local status = fileRead(self._handle, pointer, wanted, output)
        if status ~= 0 then
            return nil, ffi.string(C.nuppNativeLastError())
        end

        local got = tonumber(output[0]) as integer
        if got < 0 or got > wanted then
            return nil, "the native files provider returned an invalid read count"
        end

        return got, nil
    end

    --- Writes bytes at the cursor.
    --- @param self this file
    --- @param bytes the bytes to write
    --- @return whether they were written
    --- @return why they were not, when unsuccessful
    --- @raises string when bytes is not a string
    function write(exclusive self, bytes: string): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end
        if type(bytes) ~= "string" then
            error("nupp: io File:write needs a string", 2)
        end
        local output = ffi.new("size_t[1]")
        local status = C.nuppNativeFileWrite(self._handle, bytes, #bytes, output)
        if status ~= 0 then
            return false, ffi.string(C.nuppNativeLastError())
        end

        local wrote = tonumber(output[0]) as integer
        if wrote ~= #bytes then
            return false, "the native files provider performed a short write"
        end

        return true, nil
    end

    --- Writes bytes from a checked shared span at the cursor.
    --- @param self this file
    --- @param source bytes valid for the duration of the call
    --- @return how many bytes moved, or nil on failure
    --- @return why it could not, when unsuccessful
    function writespan(exclusive self, borrows source: span.ByteSpan): (integer?, string?)
        if self._closed then
            return nil, "the file is closed"
        end
        local count = #source
        if count == 0 then
            return 0, nil
        end
        local pointer = source:ref()
        local output = ffi.new("size_t[1]")
        local status = fileWrite(self._handle, pointer, count, output)
        if status ~= 0 then
            return nil, ffi.string(C.nuppNativeLastError())
        end

        local wrote = tonumber(output[0]) as integer
        if wrote < 0 or wrote > count then
            return nil, "the native files provider returned an invalid write count"
        end

        return wrote, nil
    end

    --- Returns the file's byte length without moving the cursor.
    --- @param self this file
    --- @return the byte length, or nil on failure
    --- @return a failure reason, when unsuccessful
    --- @raises string when the file is closed
    function size(borrows self): (integer?, io.Error?)
        if self._closed then
            error("nupp: io File is closed", 2)
        end
        local output = ffi.new("int64_t[1]")
        local status = C.nuppNativeFileSize(self._handle, output)
        if status ~= 0 then
            return nil, privateIo.toError(ffi.string(C.nuppNativeLastError()))
        end

        return tonumber(output[0]) as integer, nil
    end

    --- Moves the cursor and returns where it landed.
    --- @param self this file
    --- @param offset the distance to move
    --- @param origin what the offset is measured from, defaulting to the start
    --- @return the new position, or nil on failure
    --- @return a failure reason, when unsuccessful
    --- @raises string when origin names no seek origin
    function seek(exclusive self, offset: integer?, origin: Origin?): (integer?, io.Error?)
        if self._closed then
            error("nupp: io File is closed", 2)
        end
        local whence = ORIGINS[origin or "set"]
        if whence == nil then
            error("nupp: io has no seek origin named " .. tostring(origin), 2)
        end
        local output = ffi.new("int64_t[1]")
        local status = C.nuppNativeFileSeek(self._handle, whole(offset or 0, "seek offset", 2), whence, output)
        if status ~= 0 then
            return nil, privateIo.toError(ffi.string(C.nuppNativeLastError()))
        end

        return tonumber(output[0]) as integer, nil
    end

    --- Returns the cursor's current position.
    --- @param self this file
    --- @return the position, or nil on failure
    --- @return a failure reason, when unsuccessful
    function position(exclusive self): (integer?, io.Error?)
        return self:seek(0, "current")
    end

    --- Pushes buffered writes at the operating system, and reports a write that
    --- failed to land.
    --- @param self this file
    --- @return whether the flush succeeded
    --- @return a failure reason, when unsuccessful
    function flush(borrows self): (boolean, string?)
        if self._closed then
            return false, "the file is closed"
        end

        return done(C.nuppNativeFileFlush(self._handle))
    end

    --- Whether this file has been closed.
    --- @param self this file
    --- @return whether it is closed
    function isreleased(borrows self): boolean
        return self._closed
    end

    --- Closes the file as an ownership terminal.
    ---
    --- Repeated calls are safe. A write that failed to land is reported by `flush`,
    --- which is the call to make before closing when that matters. Declared rather
    --- than written inline because the cleanup contract needs the `@nosuspend`, and
    --- an inline method cannot carry one.
    --- @param self this file, spent by the call
    close: @nosuspend function(takes self: File): nil
end

function File.close(takes self: File): nil
    local state = @unsafe own.release(self)
    if state._closed then
        return
    end
    state._closed = true
    local handle = state._handle
    state._handle = nil
    state._scratch = nil
    state._capacity = 0
    C.nuppNativeFileRelease(handle)
end

----------------------------------------------------------------------------
-- Temporary paths
----------------------------------------------------------------------------

--- A created temporary path, and the obligation to settle it.
---
--- Closing removes it. `persist` moves it somewhere permanent instead and discharges
--- the obligation, which is the whole reason to make one: write to a name nobody else
--- can take, then put it where it belongs.
--- @export
export record TemporaryPath is own.Closeable
    @private _text: string
    @private _directory: boolean
    @private _closed: boolean

    --- Returns the created path's text.
    --- @param self this temporary path
    --- @return the path text
    function tostring(self): string
        return self._text
    end

    --- Returns the created path as a path value.
    --- @param self this temporary path
    --- @return the path
    function path(self): paths.Path
        return paths.newpath(self._text)
    end

    --- Moves this path to a permanent destination, replacing what is there.
    --- @param self this temporary path
    --- @param destination where to move it
    --- @return whether the move happened
    --- @return a failure reason, when unsuccessful
    function persist(self, destination: string | paths.Path): (boolean, io.Error?)
        if self._closed then
            return false, privateIo.toError("the temporary path is released", "closed")
        end
        local to = named(destination, "destination path", 2)
        local moved, reason = done(C.nuppNativeFilesRename(slice(self._text), slice(to)))
        if not moved then
            return false, privateIo.toError(reason)
        end
        self._closed = true

        return true, nil
    end

    --- Whether this path has been removed or persisted.
    --- @param self this temporary path
    --- @return whether it is settled
    function isreleased(self): boolean
        return self._closed
    end

    --- Removes the path as an ownership terminal.
    ---
    --- Repeated calls, and a call after `persist`, are safe and do nothing. Declared
    --- rather than written inline because the cleanup contract needs the `@nosuspend`,
    --- and an inline method cannot carry one.
    --- @param self this temporary path, spent by the call
    close: @nosuspend function(takes self: TemporaryPath): nil

    metamethod __tostring: function(borrows self: TemporaryPath): string
end

----------------------------------------------------------------------------
-- Closing
----------------------------------------------------------------------------

function TemporaryPath.close(takes self: TemporaryPath): nil
    local state = @unsafe own.release(self)
    if state._closed then
        return
    end
    state._closed = true
    C.nuppNativeFilesRemove(slice(state._text), state._directory and 1 or 0)
end

    ;
(TemporaryPath as {[string]: any}).__tostring = function(borrows self: TemporaryPath): string
    return self:tostring()
end

-- Grown by doubling with a floor at one read, so a caller that asks for one byte at a
-- time does not reallocate for each of them.
scratch = function(borrows self: File, count: integer): any
    local state = self as any
    if count > (state._capacity as integer) then
        local size = (state._capacity as integer) * 2
        if size < count then
            size = count
        end
        if size < READ_SIZE then
            size = READ_SIZE
        end
        state._scratch = ffi.new<uint8[?]>(size)
        state._capacity = size
    end

    return state._scratch
end

-- Every whole-file transfer this program submitted and has not yet consumed. The
-- lane that runs them is bounded, so a program that submits more than it waits for is
-- something a caller can ask about.
local waits: {any} = {}

local function transferState(handle: any): (integer, string?)
    local output = ffi.new("uint32_t[1]")
    local status = C.nuppNativeFilesTransferStatus(handle, output)
    if status ~= 0 then
        return FAILED, ffi.string(C.nuppNativeLastError())
    end

    local state = tonumber(output[0]) as integer
    if state < PENDING or state > CANCELED then
        return FAILED, "the native files provider returned an invalid transfer status"
    end
    if state == FAILED then
        return state, ffi.string(C.nuppNativeLastError())
    end

    return state, nil
end

----------------------------------------------------------------------------
-- Driving the request loop
----------------------------------------------------------------------------

-- Moves every settled request off the wait list and resumes whoever was waiting for
-- it. Answers how many moved, which is what a readiness pump owes its driver.
local function harvest(): integer
    local moved: integer = 0
    local index = #waits
    while index > 0 do
        local entry = waits[index]
        if transferState(entry.handle) ~= PENDING then
            waits[index] = waits[#waits]
            waits[#waits] = nil
            moved = moved + 1
            entry.resume(true)
        end
        index = index - 1
    end

    return moved
end

local function forget(entry: any): nil
    for index = 1, #waits do
        if waits[index] == entry then
            waits[index] = waits[#waits]
            waits[#waits] = nil

            return
        end
    end
end

-- A request that has already settled is not waited for at all, so the common small
-- read never reaches the suspension machinery.
local function await(handle: any): nil
    if transferState(handle) ~= PENDING then
        return
    end
    suspension.suspend("file transfer", function(resume: function(boolean), context: any): function()?
        local entry = {handle = handle, resume = resume,}
        context:source(SOURCE, native.READINESS_PRIORITY, native.pump(harvest))
        waits[#waits + 1] = entry
        -- Settled between the status check above and the subscription: resume now and
        -- answer no cancellation, which is what a subscription that did not park owes.
        if transferState(handle) ~= PENDING then
            forget(entry)
            resume(true)

            return nil
        end

        -- Cancellation raises out of the suspension, so `settled` never runs to
        -- destroy this handle; destroying it here is what gives the lane its
        -- request and byte budget back. The worker holds its own reference to the
        -- shared state, so a transfer already running is unaffected. An abandoned
        -- park is cancelled twice by design, and the first call frees the handle,
        -- so the whole body runs once and the second call finds nothing to do.
        local cancelled = false

        return function(): nil
            if cancelled then
                return
            end
            cancelled = true
            forget(entry)
            C.nuppNativeFilesTransferCancel(handle)
            C.nuppNativeFilesTransferRelease(handle)
        end
    end)
end

-- Waits for one submitted request and answers the handle when it is ready. A failed
-- request is destroyed here, because nothing else will read it.
local function settled(handle: any): (any?, string?)
    if handle == nil or handle == 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end
    await(handle)
    local state, failure = transferState(handle)
    if state ~= READY then
        local reason = failure or (state == CANCELED and "file transfer was cancelled" or "file transfer failed")
        C.nuppNativeFilesTransferRelease(handle)

        return nil, reason
    end

    return handle, nil
end

local function transferred(handle: any): (boolean, string?)
    local ready, reason = settled(handle)
    if ready == nil then
        return false, reason
    end
    C.nuppNativeFilesTransferRelease(ready)

    return true, nil
end

local function fetched(handle: any): (string?, string?)
    local ready, reason = settled(handle)
    if ready == nil then
        return nil, reason
    end
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferTakeBytes(ready, output)
    if status ~= 0 then
        local failure = ffi.string(C.nuppNativeLastError())
        C.nuppNativeFilesTransferRelease(ready)

        return nil, failure
    end
    local out = native.bytes(output[0])
    C.nuppNativeFilesTransferRelease(ready)

    return out as string, nil
end

----------------------------------------------------------------------------
-- Naming a temporary
----------------------------------------------------------------------------

--- @raises string when value is neither nil nor a string
local function fragment(value: any, what: string, level: integer): string
    if value == nil then
        return ""
    end
    if type(value) ~= "string" then
        error("nupp: os temporary " .. what .. " must be a string", level)
    end

    return value as string
end

--- @raises string when an argument is not a string, or the directory not a path
local function temporary(directory: boolean, prefix: any, suffix: any, within: any, level: integer): (string?, string?)
    local root = within ~= nil and named(within, "temporary directory", level + 1) or ""
    local before = fragment(prefix, "prefix", level + 1)
    local after = fragment(suffix, "suffix", level + 1)

    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesCreateTemporary(
        slice(root),
        slice(before),
        slice(after),
        directory and 1 or 0,
        output
    )

    return answer(status, output)
end

--- @raises string when value is neither bytes nor a byte view
local function payload(borrows value: string | io.ByteView, what: string, level: integer): string
    if type(value) == "string" then
        return tostring(value)
    end
    if type(value) == "table" and (value as io.ByteView).getstring ~= nil then
        return (value as io.ByteView):getstring()
    end
    error("nupp: io " .. what .. " must be bytes or a byte view", level)
end

----------------------------------------------------------------------------
-- Asking about a path
----------------------------------------------------------------------------

--- Describes a path: its kind, byte size, modification time in milliseconds since
--- the Unix epoch, and whether the platform refuses writes to it.
--- @param path the path to describe
--- @param follow whether to describe what a symbolic link points at
--- @return the kind, or nil when the path cannot be described
--- @return the byte size
--- @return the modification time
--- @return whether writes are refused
--- @return a failure reason, when unsuccessful
--- @export
export function stat(path: string | paths.Path, follow: boolean): (FileKind?, integer?, number?, boolean?, string?)
    local text = named(path, "path", 2)
    local record = ffi.new<NuppNativeFilesInfo[1]>()
    if C.nuppNativeFilesInfo(slice(text), follow and 1 or 0, record) ~= 0 then
        return nil, nil, nil, nil, ffi.string(C.nuppNativeLastError())
    end
    local kind: any = nil
    local size: any = nil
    local modified: any = nil
    local readonly: any = nil
    -- A pointer is not indexable in checked code, so the one-element array the library
    -- filled is read through its own index, one scalar at a time.
    @unsafe do
        kind = record[0].kind
        size = record[0].size
        modified = record[0].modified
        readonly = record[0].read_only
    end

    -- The library answers seconds; `os` answers the milliseconds the clock does.

    return (
        KINDS[tonumber(kind) as integer] or "other"
    ) as FileKind, tonumber(size) as integer, (modified as number) * 1000, readonly ~= 0, nil
end

--- Whether a path resolves, following symbolic links. A lookup that cannot tell,
--- such as a refused permission, is a reason rather than `false`.
--- @param path the path to test
--- @return whether it resolves, or nil when the lookup failed
--- @return a failure reason, when unsuccessful
--- @export
export function exists(path: string | paths.Path): (boolean?, string?)
    local text = named(path, "path", 2)
    local status = C.nuppNativeFilesExists(slice(text)) as integer
    if status == 0 then
        return true, nil
    end
    if status == ABSENT then
        return false, nil
    end

    return nil, ffi.string(C.nuppNativeLastError())
end

--- Reads a symbolic link's target without resolving it.
--- @param path the link to read
--- @return the target, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function readLink(path: string | paths.Path): (paths.Path?, string?)
    local text = named(path, "path", 2)
    local output = ffi.new("uint64_t[1]")
    local target, reason = answer(C.nuppNativeFilesReadLink(slice(text), output), output)
    if target == nil then
        return nil, reason
    end

    return paths.newpath(target), nil
end

--- Creates a symbolic link.
---
--- `kind` selects Windows's directory link and is ignored elsewhere, because only
--- Windows distinguishes the two.
--- @param target what the link points at
--- @param link where to create the link
--- @param kind the link kind, defaulting to a file link
--- @return whether the link was created
--- @return a failure reason, when unsuccessful
--- @raises string when kind names neither a file nor a directory link
--- @export
export function createSymlink(
    target: string | paths.Path,
    link: string | paths.Path,
    kind: ("file" | "directory")?
): (boolean, string?)
    local to = named(target, "symlink target", 2)
    local at = named(link, "symlink path", 2)
    if kind ~= nil and kind ~= "file" and kind ~= "directory" then
        error("nupp: os symlink kind must be 'file' or 'directory'", 2)
    end

    return done(C.nuppNativeFilesCreateSymlink(slice(to), slice(at), kind == "directory" and 1 or 0))
end

--- Creates a directory and every missing parent.
---
--- An existing directory succeeds.
--- @param path the directory to create
--- @return whether the directory exists afterwards
--- @return a failure reason, when unsuccessful
--- @export
export function createDirectory(path: string | paths.Path): (boolean, string?)
    local text = named(path, "path", 2)

    return done(C.nuppNativeFilesCreateDirectory(slice(text)))
end

--- Removes a file, a symbolic link, or a directory.
--- @param path the path to remove
--- @param recursive whether to remove a directory's contents with it
--- @return whether the path was removed
--- @return a failure reason, when unsuccessful
--- @export
export function remove(path: string | paths.Path, recursive: boolean?): (boolean, string?)
    local text = named(path, "path", 2)
    if recursive ~= nil and type(recursive) ~= "boolean" then
        error("nupp: os recursive must be a boolean", 2)
    end

    return done(C.nuppNativeFilesRemove(slice(text), recursive and 1 or 0))
end

--- Renames a path, replacing an existing destination.
--- @param from the path to rename
--- @param to the new path
--- @return whether the rename happened
--- @return a failure reason, when unsuccessful
--- @export
export function rename(from: string | paths.Path, to: string | paths.Path): (boolean, string?)
    local source = named(from, "source path", 2)
    local destination = named(to, "destination path", 2)

    return done(C.nuppNativeFilesRename(slice(source), slice(destination)))
end

--- Yields a directory's immediate children, then nil.
--- @export
export type Entries = function(): (string?, FileKind)

-- A listing abandoned before its end keeps its directory open until the collector
-- reaches the box holding its handle, the way an unfinished `io.lines` keeps its file.
local function closeListing(box: any): nil
    C.nuppNativeFilesListClose(box[0])
end

--- Reads a directory's immediate children a batch at a time.
---
--- Each name has no directory part, and each kind describes the entry itself, so a
--- link inside a listing reads as `symlink`. The order is the platform's.
--- @param path the directory to list
--- @return an iterator over the names and kinds, or nil on failure
--- @return a failure reason, when unsuccessful
--- @raises string when a batch after the first cannot be read
--- @export
export function list(path: string | paths.Path): (Entries?, string?)
    local text = named(path, "path", 2)
    local output = ffi.new("uint64_t[1]")
    if C.nuppNativeFilesListOpen(slice(text), output) ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end
    local box: any = ffi.gc(output, closeListing)
    -- The library answers each batch as one blob: a kind byte, the name, and a NUL,
    -- repeated. An empty batch is the end.
    local batch = ffi.new("uint64_t[1]")
    local blob = ""
    local at = 1

    local function release(): nil
        if box ~= nil then
            ffi.gc(box, nil)
            closeListing(box)
            box = nil
        end
    end

    return function(): (string?, FileKind)
        while at > #blob do
            if box == nil then
                return nil, nil as any
            end
            if C.nuppNativeFilesListNext(box[0], batch) ~= 0 then
                local reason = ffi.string(C.nuppNativeLastError())
                release()
                error(text .. ": " .. reason, 2)
            end
            blob = native.bytes(batch[0])
            at = 1
            if blob == "" then
                release()
                return nil, nil as any
            end
        end
        local stop = blob:find("\0", at + 1, true) as integer
        local kind = (ENTRIES[blob:sub(at, at)] or "other") as FileKind
        local name = blob:sub(at + 1, stop - 1)
        at = stop + 1

        return name, kind
    end, nil
end

--- Expands a filesystem pattern into matching paths.
---
--- `*` and `?` match within a path component, character classes use `[abc]` or
--- `[!abc]`, and `**` crosses directory boundaries. The returned paths are sorted, and
--- no matches is an empty list.
---
--- @param pattern the filesystem pattern to expand
--- @return the matching paths, or nil when the pattern or walk fails
--- @return a failure reason, when unsuccessful
--- @export
export function glob(pattern: string): ({paths.Path}?, string?)
    if type(pattern) ~= "string" then
        error("nupp: os glob pattern must be a string", 2)
    end
    local text = pattern
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesGlob(slice(text), output)
    if status ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end
    local blob = native.bytes(output[0])
    local matches: {paths.Path} = {}
    local at = 1
    while at <= #blob do
        local stop = blob:find("\0", at, true)
        if stop == nil then
            matches[#matches + 1] = paths.newpath(blob:sub(at))
            break
        end
        matches[#matches + 1] = paths.newpath(blob:sub(at, (stop as integer) - 1))
        at = (stop as integer) + 1
    end

    return matches, nil
end

--- Reads a whole file.
---
--- #### Examples
---
--- Read a file's bytes, or report why not:
---
--- ```nupp
--- local file = assert(io.open("nupp.lua", "rb"))
--- local text = assert(file:read("*a"))
--- ```
--- @param path the file to read
--- @return the contents, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function read(path: string | paths.Path): (string?, string?)
    local text = named(path, "path", 2)
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferSubmitRead(slice(text), output)

    if status ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end

    return fetched(output[0])
end

--- Writes a whole file, replacing its contents.
--- @param path the file to write
--- @param bytes the contents
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function write(path: string | paths.Path, borrows bytes: string | io.ByteView): (boolean, string?)
    local text = named(path, "path", 2)
    local out = payload(bytes, "contents", 2)
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferSubmitWrite(slice(text), slice(out), 0, output)

    if status ~= 0 then
        return false, ffi.string(C.nuppNativeLastError())
    end

    return transferred(output[0])
end

--- Adds to the end of a file, creating it when it does not exist.
--- @param path the file to extend
--- @param bytes what to add
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function append(path: string | paths.Path, borrows bytes: string | io.ByteView): (boolean, string?)
    local text = named(path, "path", 2)
    local out = payload(bytes, "contents", 2)
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferSubmitWrite(slice(text), slice(out), 1, output)

    if status ~= 0 then
        return false, ffi.string(C.nuppNativeLastError())
    end

    return transferred(output[0])
end

--- Writes a whole file through a temporary beside it, so an interrupted write leaves
--- the destination as it was rather than half replaced.
---
--- Prefer this to `write` wherever a reader may be looking at the destination
--- while it is being replaced, since `write` truncates in place.
--- @param path the file to write
--- @param bytes the contents
--- @return whether the write succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function writeAtomic(path: string | paths.Path, borrows bytes: string | io.ByteView): (boolean, string?)
    local text = named(path, "path", 2)
    local out = payload(bytes, "contents", 2)
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferSubmitWrite(slice(text), slice(out), 2, output)

    if status ~= 0 then
        return false, ffi.string(C.nuppNativeLastError())
    end

    return transferred(output[0])
end

--- Copies a file's contents over a destination.
--- @param from the file to copy
--- @param to where to copy it
--- @return whether the copy succeeded
--- @return a failure reason, when unsuccessful
--- @export
export function copy(from: string | paths.Path, to: string | paths.Path): (boolean, string?)
    local source = named(from, "source path", 2)
    local destination = named(to, "destination path", 2)
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFilesTransferSubmitCopy(slice(source), slice(destination), output)

    if status ~= 0 then
        return false, ffi.string(C.nuppNativeLastError())
    end

    return transferred(output[0])
end

--- How many whole-file transfers this program is still holding.
---
--- Whole-file reads, writes and copies settle on worker threads, and the lane
--- that runs them is bounded. This returns what it holds, which is what a
--- program that submitted more than it consumed needs to see.
--- @return the number of live transfers
--- @export
export function pendingTransfers(): integer
    requireFiles()
    local output = ffi.new("size_t[1]")
    if C.nuppNativeFilesTransferPending(output) ~= 0 then
        return 0
    end

    return tonumber(output[0]) as integer
end

----------------------------------------------------------------------------
-- Opening and reading
----------------------------------------------------------------------------

--- Opens a file and hands over the obligation to close it.
---
--- #### Examples
---
--- Read a header without holding the whole file:
---
--- ```nupp
--- local file = assert(io.open("image.png"))
--- print(file:read(8))
--- ```
--- @param path the file to open
--- @param mode how it may be used, defaulting to reading
--- @return the open file, or nil on failure
--- @return a failure reason, when unsuccessful
--- @raises string when mode names no open mode
--- @export
export function open(path: string | paths.Path, mode: Mode?): (affine(File?), string?)
    local text = named(path, "path", 2)
    local selected = MODES[mode or "r"]
    if selected == nil then
        error("nupp: io has no mode named " .. tostring(mode), 2)
    end
    local output = ffi.new("uint64_t[1]")
    local status = C.nuppNativeFileOpen(slice(text), selected, output)
    if status ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end

    return File(_handle = output[0], _closed = false, _scratch = nil, _capacity = 0), nil
end

--- Creates a uniquely named empty file or directory and hands over the obligation
--- to remove or persist it.
---
--- The path is created rather than merely proposed, so no second caller can take the
--- name in between. Closing the returned owner removes it; `persist` settles it
--- instead, which is what makes the pair a replacement for writing over a destination
--- in place.
--- @param directory whether to create a directory rather than a file
--- @param prefix a separator-free fragment before the generated part of the name
--- @param suffix a separator-free fragment after it
--- @param within the directory to create it in, defaulting to the platform's
--- @return the created path, or nil on failure
--- @return a failure reason, when unsuccessful
--- @export
export function createTemporary(
    directory: boolean,
    prefix: string?,
    suffix: string?,
    within: any?
): (affine(TemporaryPath?), string?)
    local text, reason = temporary(directory, prefix, suffix, within, 2)
    if text == nil then
        return nil, reason
    end

    return TemporaryPath(_text = text as string, _directory = directory, _closed = false), nil
end

--- Reports the complete native filesystem surface.
export function capabilities(): messages.FsCaps
    return systeminfo.filesystem()
end

local APP_BASES = {configuration = 0, data = 1, cache = 2,}

export function apppath(kind: string, organization: string, app: string): (appPaths.AppPath?, string?)
    local code = APP_BASES[kind]
    if code == nil then
        return nil, "unknown app path kind"
    end
    requireFiles()
    local output = ffi.new("uint64_t[1]")
    local base, reason = answer(C.nuppNativeFilesApplicationBase(code, output), output)
    if base == nil then
        return nil, reason
    end
    local value = appPaths.native(base, organization, app)
    local made, failure = done(C.nuppNativeFilesCreateDirectory(slice(value:tostring())))
    if not made then
        return nil, failure
    end

    return value, nil
end

export function requestPersistentStorage(): (boolean, string?)
    return true, nil
end
