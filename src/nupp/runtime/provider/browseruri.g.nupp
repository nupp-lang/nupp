module nupp.runtime.provider.browseruri

-- Portable URI values for browser applications. The browser itself remains the
-- authority for redirect resolution during fetch; this provider covers the typed
-- absolute-URI surface used to construct requests and inspect responses.

local uri = {}

record uri.Components
    scheme: string
    userInfo: string?
    host: string?
    port: integer?
    path: string?
    query: string?
    fragment: string?
end

record uri.URI
    _text: string
    _scheme: string
    _authority: string?
    _username: string
    _password: string?
    _host: string?
    _port: integer?
    _path: string
    _query: string?
    _fragment: string?

    function toString(self): string
        return self._text
    end

    function scheme(self): string
        return self._scheme
    end

    function authority(self): string?
        return self._authority
    end

    function username(self): string
        return self._username
    end

    function password(self): string?
        return self._password
    end

    function host(self): string?
        return self._host
    end

    function port(self): integer?
        return self._port
    end

    function path(self): string
        return self._path
    end

    function query(self): string?
        return self._query
    end

    function fragment(self): string?
        return self._fragment
    end

    function userInfo(self): string?
        if self._username == "" and self._password == nil then
            return nil
        end
        return self._username .. (self._password ~= nil and ":" .. self._password or "")
    end

    function withScheme(self, value: string): uri.URI
        return assert(uri.newURI(value .. self._text:sub(#self._scheme + 1)))
    end

    function withUserInfo(self, value: string?): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = value,
                    host = self._host,
                    port = self._port,
                    path = self._path,
                    query = self._query,
                    fragment = self._fragment
                )
            )
        )
    end

    function withHost(self, value: string?): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = self:userInfo(),
                    host = value,
                    port = self._port,
                    path = self._path,
                    query = self._query,
                    fragment = self._fragment
                )
            )
        )
    end

    function withPort(self, value: integer?): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = self:userInfo(),
                    host = self._host,
                    port = value,
                    path = self._path,
                    query = self._query,
                    fragment = self._fragment
                )
            )
        )
    end

    function withPath(self, value: string): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = self:userInfo(),
                    host = self._host,
                    port = self._port,
                    path = value,
                    query = self._query,
                    fragment = self._fragment
                )
            )
        )
    end

    function withQuery(self, value: string?): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = self:userInfo(),
                    host = self._host,
                    port = self._port,
                    path = self._path,
                    query = value,
                    fragment = self._fragment
                )
            )
        )
    end

    function withFragment(self, value: string?): uri.URI
        return assert(
            uri.newURI(
                new uri.Components(
                    scheme = self._scheme,
                    userInfo = self:userInfo(),
                    host = self._host,
                    port = self._port,
                    path = self._path,
                    query = self._query,
                    fragment = value
                )
            )
        )
    end

    function concatPath(self, value: string): uri.URI
        local separator = "/"
        if self._path == "" or self._path:sub(-1) == "/" or value:sub(1, 1) == "/" then
            separator = ""
        end

        return self:withPath(self._path .. separator .. value)
    end

    function resolve(self, reference: string): (uri.URI?, string?)
        if reference:match("^[A-Za-z][A-Za-z0-9+.-]*:") then
            return uri.newURI(reference)
        end
        local prefix = self._scheme .. "://" .. (self._authority or "")
        if reference:sub(1, 1) == "/" then
            return uri.newURI(prefix .. reference)
        end
        local directory = self._path:match("^(.*)/") or ""

        return uri.newURI(prefix .. directory .. "/" .. reference)
    end

    function withEndpoint(self, endpoint: uri.URI): uri.URI
        return assert(uri.newURI(endpoint:scheme() .. "://" .. (endpoint:authority() or "") .. self._path))
    end
end

local function fromComponents(value: any): string
    local authority = ""
    if value.host ~= nil then
        authority = "//" .. (value.userInfo ~= nil and value.userInfo .. "@" or "") .. value.host
        if value.port ~= nil then
            authority = authority .. ":" .. value.port
        end
    end

    return value.scheme .. ":" .. authority .. (
        value.path or ""
    ) .. (value.query ~= nil and "?" .. value.query or "") .. (value.fragment ~= nil and "#" .. value.fragment or "")
end

function uri.newURI(value: string | uri.Components): (uri.URI?, string?)
    local text = type(value) == "string" and value or fromComponents(value)
    local scheme, remainder = text:match("^([A-Za-z][A-Za-z0-9+.-]*):(.*)$")
    if scheme == nil then
        return nil, "URI requires an absolute scheme"
    end
    scheme = scheme:lower()
    local fragment: string? = nil
    local beforeFragment, foundFragment = remainder:match("^(.-)#(.*)$")
    if beforeFragment ~= nil then
        remainder, fragment = beforeFragment, foundFragment
    end
    local query: string? = nil
    local beforeQuery, foundQuery = remainder:match("^(.-)%?(.*)$")
    if beforeQuery ~= nil then
        remainder, query = beforeQuery, foundQuery
    end
    local authority: string? = nil
    local path = remainder
    if remainder:sub(1, 2) == "//" then
        authority, path = remainder:sub(3):match("^([^/]*)(.*)$")
    end
    local username, password, host, port = "", nil, nil, nil
    if authority ~= nil then
        local userInfo, hostPort = authority:match("^(.-)@(.*)$")
        hostPort = hostPort or authority
        if userInfo ~= nil then
            username, password = userInfo:match("^([^:]*):?(.*)$")
            if password == "" and not userInfo:find(":", 1, true) then
                password = nil
            end
        end
        local namedHost, namedPort = hostPort:match("^(.-):(%d+)$")
        host = (namedHost or hostPort):lower()
        if namedPort ~= nil then
            port = tonumber(namedPort)
            if port == nil or port > 65535 then
                return nil, "URI port is outside 0 through 65535"
            end
        end
        authority = (userInfo ~= nil and userInfo .. "@" or "") .. host .. (port ~= nil and ":" .. port or "")
    end
    local normalized = scheme .. ":" .. (
        authority ~= nil and "//" .. authority or ""
    ) .. path .. (query ~= nil and "?" .. query or "") .. (fragment ~= nil and "#" .. fragment or "")

    return new uri.URI(
        _text = normalized,
        _scheme = scheme,
        _authority = authority,
        _username = username,
        _password = password,
        _host = host,
        _port = port,
        _path = path,
        _query = query,
        _fragment = fragment
    )
end

function uri.validate(value: string): (boolean, string?)
    local parsed, reason = uri.newURI(value)
    return parsed ~= nil, reason
end

function uri.isURI(value: any): boolean
    return type(value) == "table" and getmetatable(value) == uri.URI
end

export = uri
