@!internal
module nupp.runtime.provider.wgpumemory

--[[
The pinned wgpu-native ABI's structs, and the C memory a call passes them in.

A struct is allocated by name with [](new) and is typed where it is used,
through the aliases below: a struct's fields are read and written by its
layout, which a dynamic value does not carry. A scalar array is element storage,
which indexes from zero.

C holds no reference the collector sees. A struct or storage whose address a
descriptor field keeps is reachable from Nupp only while something holds it, so
[](raw), [](cast) and [](view) hold what they answer until `PINS` more have
been taken: far past the call that reads it, since wgpu-native copies what a
descriptor names before the call it is passed to returns.
]]

cdef struct WGPUStringView
    data: voidptr?
    length: uint64
end

cdef struct WGPUChainedStruct
    next: voidptr?
    sType: uint32
end

cdef struct WGPUFuture
    id: uint64
end

cdef struct WGPUCallbackInfo
    nextInChain: voidptr?
    mode: uint32
    callback: voidptr?
    userdata1: voidptr?
    userdata2: voidptr?
end

cdef struct WGPUUncapturedErrorCallbackInfo
    nextInChain: voidptr?
    callback: voidptr?
    userdata1: voidptr?
    userdata2: voidptr?
end

cdef struct WGPUNativeDisplayHandle
    type: uint32
    words: uint64[2]
end

cdef struct WGPUInstanceExtras
    chain: WGPUChainedStruct
    backends: uint64
    flags: uint64
    dx12ShaderCompiler: uint32
    gles3MinorVersion: uint32
    glFenceBehaviour: uint32
    dxcPath: WGPUStringView
    dxcMaxShaderModel: uint32
    dx12PresentationSystem: uint32
    budgetForDeviceCreation: voidptr?
    budgetForDeviceLoss: voidptr?
    displayHandle: WGPUNativeDisplayHandle
end

cdef struct WGPUInstanceDescriptor
    nextInChain: voidptr?
    requiredFeatureCount: uint64
    requiredFeatures: voidptr?
    requiredLimits: voidptr?
end

cdef struct WGPURequestAdapterOptions
    nextInChain: voidptr?
    featureLevel: uint32
    powerPreference: uint32
    forceFallbackAdapter: uint32
    backendType: uint32
    compatibleSurface: voidptr?
end

cdef struct WGPUAdapterInfo
    nextInChain: voidptr?
