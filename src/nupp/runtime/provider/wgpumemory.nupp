end

cdef struct GpuWord
    value: uint32
end

cdef struct GpuWide
    value: uint64
end

cdef struct GpuPointer
    value: voidptr?
end

local layouts: {
    [string]: any
} = {
    WGPUNativeDisplayHandle = ffi.typeof<WGPUNativeDisplayHandle>(),
    WGPUStringView = ffi.typeof<WGPUStringView>(),
    WGPUChainedStruct = ffi.typeof<WGPUChainedStruct>(),
    WGPUFuture = ffi.typeof<WGPUFuture>(),
    WGPUCallbackInfo = ffi.typeof<WGPUCallbackInfo>(),
    WGPUUncapturedErrorCallbackInfo = ffi.typeof<WGPUUncapturedErrorCallbackInfo>(),
    WGPUInstanceExtras = ffi.typeof<WGPUInstanceExtras>(),
    WGPUInstanceDescriptor = ffi.typeof<WGPUInstanceDescriptor>(),
    WGPURequestAdapterOptions = ffi.typeof<WGPURequestAdapterOptions>(),
    WGPUAdapterInfo = ffi.typeof<WGPUAdapterInfo>(),
    WGPULimits = ffi.typeof<WGPULimits>(),
    WGPUQueueDescriptor = ffi.typeof<WGPUQueueDescriptor>(),
    WGPUDeviceDescriptor = ffi.typeof<WGPUDeviceDescriptor>(),
    WGPUBufferDescriptor = ffi.typeof<WGPUBufferDescriptor>(),
    WGPUBufferBindingLayout = ffi.typeof<WGPUBufferBindingLayout>(),
    WGPUSamplerBindingLayout = ffi.typeof<WGPUSamplerBindingLayout>(),
    WGPUTextureBindingLayout = ffi.typeof<WGPUTextureBindingLayout>(),
    WGPUStorageTextureBindingLayout = ffi.typeof<WGPUStorageTextureBindingLayout>(),
    WGPUBindGroupLayoutEntry = ffi.typeof<WGPUBindGroupLayoutEntry>(),
    WGPUBindGroupLayoutDescriptor = ffi.typeof<WGPUBindGroupLayoutDescriptor>(),
    WGPUPipelineLayoutDescriptor = ffi.typeof<WGPUPipelineLayoutDescriptor>(),
    WGPUShaderSourceSPIRV = ffi.typeof<WGPUShaderSourceSPIRV>(),
    WGPUShaderSourceWGSL = ffi.typeof<WGPUShaderSourceWGSL>(),
    WGPUShaderModuleDescriptor = ffi.typeof<WGPUShaderModuleDescriptor>(),
    WGPUComputeState = ffi.typeof<WGPUComputeState>(),
    WGPUComputePipelineDescriptor = ffi.typeof<WGPUComputePipelineDescriptor>(),
    WGPUBindGroupEntry = ffi.typeof<WGPUBindGroupEntry>(),
    WGPUBindGroupDescriptor = ffi.typeof<WGPUBindGroupDescriptor>(),
    WGPUCommandEncoderDescriptor = ffi.typeof<WGPUCommandEncoderDescriptor>(),
    WGPUCommandBufferDescriptor = ffi.typeof<WGPUCommandBufferDescriptor>(),
    WGPUPassTimestampWrites = ffi.typeof<WGPUPassTimestampWrites>(),
    WGPUComputePassDescriptor = ffi.typeof<WGPUComputePassDescriptor>(),
    WGPUQuerySetDescriptor = ffi.typeof<WGPUQuerySetDescriptor>(),
}

export function descriptor(name: string): any
    local value = assert(layouts[name], "unknown GPU ABI type " .. name)
    return value
end

export function raw(value: any): any
    if type(value) == "table" and value.__gpuStorage ~= nil then
        return value.__gpuStorage
    end
    return value
end

local function scalararray(storage: any, count: integer): any
    return setmetatable({__gpuStorage = storage, count = count}, {
        __index = function(self: any, key: integer): any
            assert(key >= 0 and key < count, "GPU native array index out of range")
            return storage[key].value
        end,
        __newindex = function(self: any, key: integer, value: any): nil
            assert(key >= 0 and key < count, "GPU native array index out of range")
            storage[key].value = raw(value)
        end,
    })
end

local function allocate(name: string, count: any): any
    if name == "WGPUStringView" then
        return WGPUStringView()
    elseif name == "WGPUStringView[?]" then
        return carray(WGPUStringView, count)
    elseif name == "WGPUChainedStruct" then
        return WGPUChainedStruct()
    elseif name == "WGPUChainedStruct[?]" then
        return carray(WGPUChainedStruct, count)
    elseif name == "WGPUFuture" then
        return WGPUFuture()
    elseif name == "WGPUFuture[?]" then
        return carray(WGPUFuture, count)
    elseif name == "WGPUCallbackInfo" then
        return WGPUCallbackInfo()
    elseif name == "WGPUCallbackInfo[?]" then
        return carray(WGPUCallbackInfo, count)
    elseif name == "WGPUUncapturedErrorCallbackInfo" then
        return WGPUUncapturedErrorCallbackInfo()
    elseif name == "WGPUUncapturedErrorCallbackInfo[?]" then
        return carray(WGPUUncapturedErrorCallbackInfo, count)
    elseif name == "WGPUInstanceExtras" then
        return WGPUInstanceExtras()
    elseif name == "WGPUInstanceExtras[?]" then
        return carray(WGPUInstanceExtras, count)
    elseif name == "WGPUInstanceDescriptor" then
        return WGPUInstanceDescriptor()
    elseif name == "WGPUInstanceDescriptor[?]" then
        return carray(WGPUInstanceDescriptor, count)
    elseif name == "WGPURequestAdapterOptions" then
        return WGPURequestAdapterOptions()
    elseif name == "WGPURequestAdapterOptions[?]" then
        return carray(WGPURequestAdapterOptions, count)
    elseif name == "WGPUAdapterInfo" then
        return WGPUAdapterInfo()
    elseif name == "WGPUAdapterInfo[?]" then
        return carray(WGPUAdapterInfo, count)
    elseif name == "WGPULimits" then
        return WGPULimits()
    elseif name == "WGPULimits[?]" then
        return carray(WGPULimits, count)
    elseif name == "WGPUQueueDescriptor" then
        return WGPUQueueDescriptor()
    elseif name == "WGPUQueueDescriptor[?]" then
        return carray(WGPUQueueDescriptor, count)
    elseif name == "WGPUDeviceDescriptor" then
        return WGPUDeviceDescriptor()
    elseif name == "WGPUDeviceDescriptor[?]" then
        return carray(WGPUDeviceDescriptor, count)
    elseif name == "WGPUBufferDescriptor" then
        return WGPUBufferDescriptor()
    elseif name == "WGPUBufferDescriptor[?]" then
        return carray(WGPUBufferDescriptor, count)
    elseif name == "WGPUBufferBindingLayout" then
        return WGPUBufferBindingLayout()
    elseif name == "WGPUBufferBindingLayout[?]" then
        return carray(WGPUBufferBindingLayout, count)
    elseif name == "WGPUSamplerBindingLayout" then
        return WGPUSamplerBindingLayout()
    elseif name == "WGPUSamplerBindingLayout[?]" then
        return carray(WGPUSamplerBindingLayout, count)
    elseif name == "WGPUTextureBindingLayout" then
        return WGPUTextureBindingLayout()
    elseif name == "WGPUTextureBindingLayout[?]" then
        return carray(WGPUTextureBindingLayout, count)
    elseif name == "WGPUStorageTextureBindingLayout" then
        return WGPUStorageTextureBindingLayout()
    elseif name == "WGPUStorageTextureBindingLayout[?]" then
        return carray(WGPUStorageTextureBindingLayout, count)
    elseif name == "WGPUBindGroupLayoutEntry" then
        return WGPUBindGroupLayoutEntry()
    elseif name == "WGPUBindGroupLayoutEntry[?]" then
        return carray(WGPUBindGroupLayoutEntry, count)
    elseif name == "WGPUBindGroupLayoutDescriptor" then
        return WGPUBindGroupLayoutDescriptor()
    elseif name == "WGPUBindGroupLayoutDescriptor[?]" then
        return carray(WGPUBindGroupLayoutDescriptor, count)
    elseif name == "WGPUPipelineLayoutDescriptor" then
        return WGPUPipelineLayoutDescriptor()
    elseif name == "WGPUPipelineLayoutDescriptor[?]" then
        return carray(WGPUPipelineLayoutDescriptor, count)
    elseif name == "WGPUShaderSourceSPIRV" then
        return WGPUShaderSourceSPIRV()
    elseif name == "WGPUShaderSourceSPIRV[?]" then
        return carray(WGPUShaderSourceSPIRV, count)
    elseif name == "WGPUShaderSourceWGSL" then
        return WGPUShaderSourceWGSL()
    elseif name == "WGPUShaderSourceWGSL[?]" then
        return carray(WGPUShaderSourceWGSL, count)
    elseif name == "WGPUShaderModuleDescriptor" then
        return WGPUShaderModuleDescriptor()
    elseif name == "WGPUShaderModuleDescriptor[?]" then
        return carray(WGPUShaderModuleDescriptor, count)
    elseif name == "WGPUComputeState" then
        return WGPUComputeState()
    elseif name == "WGPUComputeState[?]" then
        return carray(WGPUComputeState, count)
    elseif name == "WGPUComputePipelineDescriptor" then
        return WGPUComputePipelineDescriptor()
    elseif name == "WGPUComputePipelineDescriptor[?]" then
        return carray(WGPUComputePipelineDescriptor, count)
    elseif name == "WGPUBindGroupEntry" then
        return WGPUBindGroupEntry()
    elseif name == "WGPUBindGroupEntry[?]" then
        return carray(WGPUBindGroupEntry, count)
    elseif name == "WGPUBindGroupDescriptor" then
        return WGPUBindGroupDescriptor()
    elseif name == "WGPUBindGroupDescriptor[?]" then
        return carray(WGPUBindGroupDescriptor, count)
    elseif name == "WGPUCommandEncoderDescriptor" then
        return WGPUCommandEncoderDescriptor()
    elseif name == "WGPUCommandEncoderDescriptor[?]" then
        return carray(WGPUCommandEncoderDescriptor, count)
    elseif name == "WGPUCommandBufferDescriptor" then
        return WGPUCommandBufferDescriptor()
    elseif name == "WGPUCommandBufferDescriptor[?]" then
        return carray(WGPUCommandBufferDescriptor, count)
    elseif name == "WGPUPassTimestampWrites" then
        return WGPUPassTimestampWrites()
    elseif name == "WGPUPassTimestampWrites[?]" then
        return carray(WGPUPassTimestampWrites, count)
    elseif name == "WGPUComputePassDescriptor" then
        return WGPUComputePassDescriptor()
    elseif name == "WGPUComputePassDescriptor[?]" then
        return carray(WGPUComputePassDescriptor, count)
    elseif name == "WGPUQuerySetDescriptor" then
        return WGPUQuerySetDescriptor()
    elseif name == "WGPUQuerySetDescriptor[?]" then
        return carray(WGPUQuerySetDescriptor, count)
    elseif name == "uint8_t[?]" then
        return scalararray(carray(GpuByte, count), count)
    elseif name == "uint32_t[?]" then
        return scalararray(carray(GpuWord, count), count)
    elseif name == "uint64_t[?]" then
        return scalararray(carray(GpuWide, count), count)
    elseif name == "WGPUCommandBuffer[?]" then
        return scalararray(carray(GpuPointer, count), count)
    elseif name == "WGPUBindGroupLayout[?]" then
        return scalararray(carray(GpuPointer, count), count)
    end
    error("unknown GPU allocation " .. name)
end

export function new(name: string, initializer: any): any
    if name == "uint64_t" then
        local value = GpuWide()
        value.value = initializer as uint64
        return value.value
    end
    local element, size = name:match("^(.-)%[(%d+)%]$")
    if element ~= nil then
        local count = tonumber(size) as integer
        local value = allocate(element .. "[?]", count)
        if initializer ~= nil then
            if type(initializer) == "table" then
                for i = 0, count - 1 do
                    value[i] = initializer[i + 1] or 0
                end
            else
                value[0] = initializer
            end
        end
        return value
    end

    return allocate(name, initializer)
end

local nativecopy = native.bind(nil, "memcpy", {
    params = {"pointer", {kind = "pointer", readonly = true}, "uint64"},
    result = "pointer"
})
export function copy(destination: any, source: any, length: integer): nil
    nativecopy(raw(destination), raw(source), length)
end

export function readstring(pointer: any, length: any): string
    local text = native.string(raw(pointer), length and tonumber(length))
    return text
end

export function cast(name: string, value: any): any
    assert(name == "WGPUChainedStruct *", "unsupported GPU pointer cast")
    return raw(value)
end

export function token(value: integer): any
    local cell = GpuWide()
    cell.value = value as uint64
    return cell
end

export function tokenvalue(pointer: any): integer
    local value = GpuWide()
    nativecopy(value, pointer, 8)
    return tonumber(value.value) as integer
end

export function view(text: string?): any
    local result: any = WGPUStringView()
    if text ~= nil then
        local bytes = carray(GpuByte, #text + 1)
        nativecopy(bytes, text, #text)
        result.data = bytes
        result.length = #text
    end

    return result
end

export function maxsize(): any
    local cell = GpuWide()
    nativecopy(cell, strings.rep(strings.char(255), 8), 8)
    return cell.value
end

-- WebGPU transfers a reference through a callback. The VM callback pointer
-- itself is lent only until return; native storage carries the owned reference
-- to the context after that callback has ended.
export function ownedslot(pointer: any): any
    local slot = GpuPointer()
    slot.value = pointer
    return slot
end

export function layoutinfo(): {[string]: any}
    local result: {[string]: any} = {}
    for name, value in pairs(layouts) do
        local fields: {[string]: integer} = {}
        for _, field in ipairs(value.fields) do
            fields[field.name] = field.offset
        end
        result[name] = {size = value.size, alignment = value.alignment, fields = fields}
    end

    return result
end
