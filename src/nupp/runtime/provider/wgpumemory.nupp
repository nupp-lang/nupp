cdef struct WGPUBindGroupEntry
    nextInChain: voidptr?
    binding: uint32
    buffer: voidptr?
    offset: uint64
    size: uint64
    sampler: voidptr?
    textureView: voidptr?
end

cdef struct WGPUBindGroupDescriptor
    nextInChain: voidptr?
    label: WGPUStringView
    layout: voidptr?
    entryCount: uint64
    entries: voidptr?
end

cdef struct WGPUCommandEncoderDescriptor
    nextInChain: voidptr?
    label: WGPUStringView
end

cdef struct WGPUCommandBufferDescriptor
    nextInChain: voidptr?
    label: WGPUStringView
end

cdef struct WGPUPassTimestampWrites
    nextInChain: voidptr?
    querySet: voidptr?
    beginningOfPassWriteIndex: uint32
    endOfPassWriteIndex: uint32
end

cdef struct WGPUComputePassDescriptor
    nextInChain: voidptr?
