end

-- What each struct is called where it is used.
export type StringView = WGPUStringView
export type ChainedStruct = WGPUChainedStruct
export type Future = WGPUFuture
export type CallbackInfo = WGPUCallbackInfo
export type UncapturedErrorCallbackInfo = WGPUUncapturedErrorCallbackInfo
export type NativeDisplayHandle = WGPUNativeDisplayHandle
export type InstanceExtras = WGPUInstanceExtras
export type InstanceDescriptor = WGPUInstanceDescriptor
export type RequestAdapterOptions = WGPURequestAdapterOptions
export type AdapterInfo = WGPUAdapterInfo
export type Limits = WGPULimits
export type QueueDescriptor = WGPUQueueDescriptor
export type DeviceDescriptor = WGPUDeviceDescriptor
export type BufferDescriptor = WGPUBufferDescriptor
export type BufferBindingLayout = WGPUBufferBindingLayout
export type SamplerBindingLayout = WGPUSamplerBindingLayout
export type TextureBindingLayout = WGPUTextureBindingLayout
export type StorageTextureBindingLayout = WGPUStorageTextureBindingLayout
export type BindGroupLayoutEntry = WGPUBindGroupLayoutEntry
export type BindGroupLayoutDescriptor = WGPUBindGroupLayoutDescriptor
export type PipelineLayoutDescriptor = WGPUPipelineLayoutDescriptor
export type ShaderSourceSPIRV = WGPUShaderSourceSPIRV
export type ShaderSourceWGSL = WGPUShaderSourceWGSL
export type ShaderModuleDescriptor = WGPUShaderModuleDescriptor
export type ComputeState = WGPUComputeState
export type ComputePipelineDescriptor = WGPUComputePipelineDescriptor
export type BindGroupEntry = WGPUBindGroupEntry
export type BindGroupDescriptor = WGPUBindGroupDescriptor
export type CommandEncoderDescriptor = WGPUCommandEncoderDescriptor
export type CommandBufferDescriptor = WGPUCommandBufferDescriptor
export type PassTimestampWrites = WGPUPassTimestampWrites
export type ComputePassDescriptor = WGPUComputePassDescriptor
export type QuerySetDescriptor = WGPUQuerySetDescriptor

local storage = require("nupp.vm.storagebinding")

cdef function memcpy(borrows target: voidptr, borrows source: voidptr, count: uint64): voidptr
cdef function strlen(borrows text: voidptr): uint64

const PINS = 256
local pins: {any} = {}
local pinned: integer = 0

-- Holds `value` until PINS more values have been held.
local function pin(value: any): any
    pinned = (pinned % PINS + 1) as integer
    pins[pinned] = value

    return value
end

--- `value` as a descriptor's pointer field takes it, held for the calls that read it.
export function raw(value: any): any
    return pin(value)
end

--- `value` as a pointer to the chained struct it starts with, held as `raw` holds it.
export function cast(name: string, value: any): any
    assert(name == "WGPUChainedStruct *", "unsupported GPU pointer cast")
    return pin(value)
end

-- A new zeroed struct of the given name.
local function struct(name: string): any
    if name == "WGPUStringView" then
        return WGPUStringView()
    elseif name == "WGPUChainedStruct" then
        return WGPUChainedStruct()
    elseif name == "WGPUFuture" then
        return WGPUFuture()
    elseif name == "WGPUCallbackInfo" then
        return WGPUCallbackInfo()
    elseif name == "WGPUUncapturedErrorCallbackInfo" then
        return WGPUUncapturedErrorCallbackInfo()
    elseif name == "WGPUNativeDisplayHandle" then
        return WGPUNativeDisplayHandle()
    elseif name == "WGPUInstanceExtras" then
        return WGPUInstanceExtras()
    elseif name == "WGPUInstanceDescriptor" then
        return WGPUInstanceDescriptor()
    elseif name == "WGPURequestAdapterOptions" then
        return WGPURequestAdapterOptions()
    elseif name == "WGPUAdapterInfo" then
        return WGPUAdapterInfo()
    elseif name == "WGPULimits" then
        return WGPULimits()
    elseif name == "WGPUQueueDescriptor" then
        return WGPUQueueDescriptor()
    elseif name == "WGPUDeviceDescriptor" then
        return WGPUDeviceDescriptor()
    elseif name == "WGPUBufferDescriptor" then
        return WGPUBufferDescriptor()
    elseif name == "WGPUBufferBindingLayout" then
        return WGPUBufferBindingLayout()
    elseif name == "WGPUSamplerBindingLayout" then
        return WGPUSamplerBindingLayout()
    elseif name == "WGPUTextureBindingLayout" then
        return WGPUTextureBindingLayout()
    elseif name == "WGPUStorageTextureBindingLayout" then
        return WGPUStorageTextureBindingLayout()
    elseif name == "WGPUBindGroupLayoutEntry" then
        return WGPUBindGroupLayoutEntry()
    elseif name == "WGPUBindGroupLayoutDescriptor" then
        return WGPUBindGroupLayoutDescriptor()
    elseif name == "WGPUPipelineLayoutDescriptor" then
        return WGPUPipelineLayoutDescriptor()
    elseif name == "WGPUShaderSourceSPIRV" then
        return WGPUShaderSourceSPIRV()
    elseif name == "WGPUShaderSourceWGSL" then
        return WGPUShaderSourceWGSL()
    elseif name == "WGPUShaderModuleDescriptor" then
        return WGPUShaderModuleDescriptor()
    elseif name == "WGPUComputeState" then
        return WGPUComputeState()
    elseif name == "WGPUComputePipelineDescriptor" then
        return WGPUComputePipelineDescriptor()
    elseif name == "WGPUBindGroupEntry" then
        return WGPUBindGroupEntry()
    elseif name == "WGPUBindGroupDescriptor" then
        return WGPUBindGroupDescriptor()
    elseif name == "WGPUCommandEncoderDescriptor" then
        return WGPUCommandEncoderDescriptor()
    elseif name == "WGPUCommandBufferDescriptor" then
        return WGPUCommandBufferDescriptor()
    elseif name == "WGPUPassTimestampWrites" then
        return WGPUPassTimestampWrites()
    elseif name == "WGPUComputePassDescriptor" then
        return WGPUComputePassDescriptor()
    elseif name == "WGPUQuerySetDescriptor" then
        return WGPUQuerySetDescriptor()
    end
    error("unknown GPU allocation " .. name)
end

-- The element kinds a scalar array may hold, by its C name. A handle is a
-- pointer, which a core word holds.
const SCALARS: {
    [string]: string
} = {
    uint8_t = "uint8",
    uint32_t = "uint32",
    uint64_t = "uint64",
    WGPUCommandBuffer = "uint64",
    WGPUBindGroupLayout = "uint64",
}

-- A new zeroed array of `count` elements named `element`.
local function array(element: string, count: integer): any
    local kind = assert(SCALARS[element], "unknown GPU allocation " .. element .. "[?]")
    return storage.allocarray(storage.scalar(kind), count)
end

--- A new zeroed struct, a scalar array (`T[?]` with its count, or `T[N]`
--- with an optional initializer: a table of its elements from 1, or its first),
--- or the `uint64_t` value `initializer`.
export function new(name: string, initializer: any): any
    if name == "uint64_t" then
        return initializer as uint64
    end
    local element, size = name:match("^(.-)%[(%d+)%]$")
    if element ~= nil then
        local count = tonumber(size) as integer
        local value = array(element, count)
        if initializer ~= nil then
            if type(initializer) == "table" then
                for i = 0, count - 1 do
                    value[i] = initializer[i + 1] or 0
                end
            else
                value[0] = initializer
            end
        end
        return value
    end
    local unsized = name:match("^(.-)%[%?%]$")
    if unsized ~= nil then
        return array(unsized, initializer as integer)
    end

    return struct(name)
end

--- Bind group layout entries for `count` buffer bindings from zero, at least one.
export function layoutentries(count: integer, visibility: integer, kind: integer, minimum: integer): any
    local entries = carray(WGPUBindGroupLayoutEntry, math.max(count, 1))
    @unsafe do
        for binding = 0, count - 1 do
            entries[binding].binding = binding
            entries[binding].visibility = visibility
            entries[binding].buffer.type = kind
            entries[binding].buffer.minBindingSize = minimum
        end
    end

    return pin(entries)
end

--- Bind group entries for `buffers` from binding zero, each `{buffer =
--- handle, offset = n, size = n}`; at least one.
export function groupentries(buffers: {any}): any
    local entries = carray(WGPUBindGroupEntry, math.max(#buffers, 1))
    @unsafe do
        for index, value in ipairs(buffers) do
            entries[index - 1].binding = index - 1
            entries[index - 1].buffer = value.buffer
            entries[index - 1].offset = value.offset
            entries[index - 1].size = value.size
        end
    end

    return pin(entries)
end

--- Copies `length` bytes from `source` to `destination`: storage, a struct,
--- an address, or a string to copy from.
export function copy(destination: any, source: any, length: integer): nil
    memcpy(destination, source, length)
end

--- The `length` bytes at `pointer`, or those before its NUL when `length` is nil.
export function readstring(pointer: any, length: any): string
    local count = length == nil and tonumber(strlen(pointer)) as integer or tonumber(length) as integer
    if count == 0 then
        return ""
    end
    local bytes: any = storage.allocbytes(count)
    memcpy(bytes, pointer, count)

    return storage.string(bytes, count)
end

--- A string view of a copy of `text`, held as `raw` holds it; a null view for nil.
export function view(text: string?): StringView
    local result = WGPUStringView()
    if text ~= nil then
        local bytes: any = pin(storage.allocbytes(#text + 1))
        local source: any = text
        memcpy(bytes, source, #text)
        result.data = bytes
        result.length = #text
    end

    return result
end

-- Every struct's layout, as the target lays it out.
local layouts: {
    [string]: any
} = {
    WGPUStringView = types.layoutof(WGPUStringView),
    WGPUChainedStruct = types.layoutof(WGPUChainedStruct),
    WGPUFuture = types.layoutof(WGPUFuture),
    WGPUCallbackInfo = types.layoutof(WGPUCallbackInfo),
    WGPUUncapturedErrorCallbackInfo = types.layoutof(WGPUUncapturedErrorCallbackInfo),
    WGPUNativeDisplayHandle = types.layoutof(WGPUNativeDisplayHandle),
    WGPUInstanceExtras = types.layoutof(WGPUInstanceExtras),
    WGPUInstanceDescriptor = types.layoutof(WGPUInstanceDescriptor),
    WGPURequestAdapterOptions = types.layoutof(WGPURequestAdapterOptions),
    WGPUAdapterInfo = types.layoutof(WGPUAdapterInfo),
    WGPULimits = types.layoutof(WGPULimits),
    WGPUQueueDescriptor = types.layoutof(WGPUQueueDescriptor),
    WGPUDeviceDescriptor = types.layoutof(WGPUDeviceDescriptor),
    WGPUBufferDescriptor = types.layoutof(WGPUBufferDescriptor),
    WGPUBufferBindingLayout = types.layoutof(WGPUBufferBindingLayout),
    WGPUSamplerBindingLayout = types.layoutof(WGPUSamplerBindingLayout),
    WGPUTextureBindingLayout = types.layoutof(WGPUTextureBindingLayout),
    WGPUStorageTextureBindingLayout = types.layoutof(WGPUStorageTextureBindingLayout),
    WGPUBindGroupLayoutEntry = types.layoutof(WGPUBindGroupLayoutEntry),
    WGPUBindGroupLayoutDescriptor = types.layoutof(WGPUBindGroupLayoutDescriptor),
    WGPUPipelineLayoutDescriptor = types.layoutof(WGPUPipelineLayoutDescriptor),
    WGPUShaderSourceSPIRV = types.layoutof(WGPUShaderSourceSPIRV),
    WGPUShaderSourceWGSL = types.layoutof(WGPUShaderSourceWGSL),
    WGPUShaderModuleDescriptor = types.layoutof(WGPUShaderModuleDescriptor),
    WGPUComputeState = types.layoutof(WGPUComputeState),
    WGPUComputePipelineDescriptor = types.layoutof(WGPUComputePipelineDescriptor),
    WGPUBindGroupEntry = types.layoutof(WGPUBindGroupEntry),
    WGPUBindGroupDescriptor = types.layoutof(WGPUBindGroupDescriptor),
    WGPUCommandEncoderDescriptor = types.layoutof(WGPUCommandEncoderDescriptor),
    WGPUCommandBufferDescriptor = types.layoutof(WGPUCommandBufferDescriptor),
    WGPUPassTimestampWrites = types.layoutof(WGPUPassTimestampWrites),
    WGPUComputePassDescriptor = types.layoutof(WGPUComputePassDescriptor),
    WGPUQuerySetDescriptor = types.layoutof(WGPUQuerySetDescriptor),
}

--- Each struct's size, alignment and field offsets, to hold against the headers.
export function layoutinfo(): {[string]: any}
    local result: {[string]: any} = {}
    for name, value in pairs(layouts) do
        local fields: {[string]: integer} = {}
        for _, field in ipairs(value.fields) do
            fields[field.name] = field.offset
        end
        result[name] = {size = value.size, alignment = value.alignment, fields = fields}
    end

    return result
end
