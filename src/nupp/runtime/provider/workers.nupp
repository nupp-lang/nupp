@!internal
module nupp.runtime.provider.workers

-- The VM's worker lanes. `nupp.workers` selects them through
-- `nupp.runtime.workersprovider` like any native provider, so a program's own
-- provider still wins.

local core: any = require("nupp.vm.tasks")
local clock = require("nupp.vm.clock")
local suspension = require("nupp.suspension")
local cancellation = require("nupp.suspension.cancellation")
local coroutines = require("nupp.suspension.internal.coroutines")
local workers = {}
local workerState = coroutines.localState("workers", function(): any
    return {live = {}}
end) as {
    live: {any},
    source: any
}
local Task: any = {}
Task.__index = Task

local function finish(task: any): boolean
    if task.done or not task.raw:isDone() then
        return false
    end
    task.done = true
    task.state = task.raw:status()
    task.values, task.count, task.problem = task.raw._values, task.raw._count, task.raw._error
    if task.state == "cancelled" then
        local problem = task.problem
        task.problem = cancellation.create(problem.operation or "worker task", problem.reason)
    end
    task.owner.registered = task.owner.registered - 1
    for index, child in ipairs(task.owner.tasks) do
        if child == task then
            table.remove(task.owner.tasks, index)
            break
        end
    end
    task.owner.observer.settled(task.owner, task, task.state, task.problem)
    for _, waiter in ipairs(task.waiters) do
        if waiter.active then
            waiter.active = false
            waiter.resume(true)
        end
    end
    task.waiters = {}

    return true
end

local function poll(): integer
    core.pollWorkers()
    local count = 0
    for index = #workerState.live, 1, -1 do
        local task = workerState.live[index]
        if finish(task) then
            count = count + 1
        end
        if task.done then
            table.remove(workerState.live, index)
        end
    end

    return count as integer
end

local function readiness(): any
    if workerState.source == nil or workerState.source.released then
        workerState.source = suspension.source(
            "nupp.vm.workers",
            30,
            poll,
            function(maxMs: integer): integer
                local count = poll()
                if count == 0 and maxMs > 0 then
                    clock.sleep(math.min(maxMs, 1))
                    return poll()
                end

                return count
            end,
            function(): boolean
                return #workerState.live > 0
            end
        )
    end

    return workerState.source
end

function Task.isDone(self: any): boolean
    poll()
    return self.done
end

function Task.status(self: any): string
    poll()
    return self.done and self.state or self.raw:status()
end

function Task.cancel(self: any, reason: string?): boolean
    return self.raw:cancel(reason)
end

function workers.settle(task: any): (string, {any}?, integer, any)
    if not task:isDone() then
        suspension.suspend("worker task", function(resume: function(boolean), context: suspension.Context): function()
            context:uses(readiness())
            local waiter = {resume = resume, active = true}
            task.waiters[#task.waiters + 1] = waiter
            return function(): nil
                waiter.active = false
            end
        end)
    end

    return task.state, task.values, task.count, task.problem
end

function workers.openScope(deadline: number?, observer: any): any
    local scope: any = {raw = core.workerOpen(), registered = 0, observer = observer, closed = false, tasks = {}}
    function scope.spawn(self: any, body: any, ...: any): any
        local task = setmetatable({raw = self.raw:fork(body, ...), owner = self, done = false, waiters = {}}, Task)
        self.tasks[#self.tasks + 1] = task
        workerState.live[#workerState.live + 1] = task
        self.registered = self.registered + 1
        observer.created(self, task)
        readiness()

        return task
    end

    function scope._cancelAll(self: any, reason: string?): nil
        for _, task in ipairs(self.tasks) do
            if not task.done then
                task:cancel(reason)
            end
        end
    end

    function scope._settleOldest(self: any): boolean
        poll()
        for _, task in ipairs(self.tasks) do
            if not task.done then
                workers.settle(task)
                return true
            end
        end

        return false
    end

    function scope.close(self: any): nil
        if self.closed then
            return
        end
        while self.tasks[1] ~= nil do
            workers.settle(self.tasks[1])
        end
        self.raw:close()
        self.tasks = {}
        self.closed = true
    end

    return scope
end

function workers.__registered(scope: any): integer
    return scope.registered as integer
end

export = workers
