@!internal
module nupp.runtime.provider.workers

-- The VM's worker lanes. `nupp.workers` reaches them through
-- `nupp.runtime.bindings.workers`, which binds them on native targets.

local core: any = require("nupp.vm.tasks")
local clock = require("nupp.vm.clock")
local suspension = require("nupp.suspension")
local cancellation = require("nupp.suspension.cancellation")
local coroutines = require("nupp.suspension.internal.coroutines")
local channels = require("nupp.runtime.provider.channels") as any
local native = require("nupp.workers.native")
local arrays = require("nupp.array") as any
local workers = {}
local workerState = coroutines.localState("workers", function(): any
    return {live = {}}
end) as {
    live: {any},
    source: any
}
local Task: any = {}
Task.__index = Task

local function finish(task: any): boolean
    if task.done or not task.raw:isDone() then
        return false
    end
    task.done = true
    task.state = task.raw:status()
    task.values, task.count, task.problem = task.raw._values, task.raw._count, task.raw._error
    if task.state == "cancelled" then
        local problem = task.problem
        task.problem = cancellation.create(problem.operation or "worker task", problem.reason)
    end
    task.owner.registered = task.owner.registered - 1
    for index, child in ipairs(task.owner.tasks) do
        if child == task then
            table.remove(task.owner.tasks, index)
            break
        end
    end
    task.owner.observer.settled(task.owner, task, task.state, task.problem)
    for _, waiter in ipairs(task.waiters) do
        if waiter.active then
            waiter.active = false
            waiter.resume(true)
        end
    end
    task.waiters = {}

    return true
end

local function poll(): integer
    core.pollWorkers()
    local count = 0
    for index = #workerState.live, 1, -1 do
        local task = workerState.live[index]
        if finish(task) then
            count = count + 1
        end
        if task.done then
            table.remove(workerState.live, index)
        end
    end

    return count as integer
end

local function readiness(): any
    if workerState.source == nil or workerState.source.released then
        workerState.source = suspension.source(
            "nupp.vm.workers",
            30,
            poll,
            function(maxMs: integer): integer
                local count = poll()
                if count == 0 and maxMs > 0 then
                    clock.sleep(math.min(maxMs, 1))
                    return poll()
                end

                return count
            end,
            function(): boolean
                return #workerState.live > 0
            end
        )
    end

    return workerState.source
end

function Task.isdone(self: any): boolean
    poll()
    return self.done
end

function Task.status(self: any): string
    poll()
    return self.done and self.state or self.raw:status()
end

function Task.cancel(self: any, reason: string?): boolean
    return self.raw:cancel(reason)
end

function workers.settle(task: any): (string, {any}?, integer, any)
    if not task:isdone() then
        suspension.suspend("worker task", function(resume: function(boolean), context: suspension.Context): function()
            context:uses(readiness())
            local waiter = {resume = resume, active = true}
            task.waiters[#task.waiters + 1] = waiter
            return function(): nil
                waiter.active = false
            end
        end)
    end
    -- The public scope owns failure reporting. Mark the host handle observed so
    -- its cleanup does not report the same failure a second time.
    pcall(task.raw.await, task.raw)

    return task.state, task.values, task.count, task.problem
end

function Task.await(self: any): ...any
    local status, values, count, problem = workers.settle(self)
    if status == "failed" or status == "cancelled" then
        error(problem, 0)
    end

    return unpack(values as {any}, 1, count)
end

local function cleanup(value: any, seen: {[any]: boolean}): nil
    if type(value) ~= "table" or seen[value] then
        return
    end
    seen[value] = true
    if native.isArray(value) then
        arrays.destroyarray(value)
        return
    end
    local direction = channels.identify(value)
    if direction ~= nil then
        channels.cleanup(value, 0)
        return
    end
    for key, item in next, value as {[any]: any} do
        cleanup(key, seen)
        cleanup(item, seen)
    end
end

function workers.channeldrop(value: any): nil
    cleanup(value, {})
end

function workers.cleanuparguments(...: any): nil
    local seen: {[any]: boolean} = {}
    for index = 1, select("#", ...) do
        cleanup((select(index, ...)), seen)
    end
end

function workers.ownsarguments(...: any): boolean
    for index = 1, select("#", ...) do
        if type((select(index, ...))) == "table" then
            return true
        end
    end

    return false
end

function workers.channel(owner: any, messages: integer, bytes: integer): (any, any)
    return channels.create(owner, messages, bytes)
end

function workers.closechannels(owner: any): nil
    channels.closeScope(owner)
end

function workers.openscope(deadline: number?, observer: any): any
    observer = observer or {
        created = function(_: any, _: any): nil
        end,
        settled = function(_: any, _: any, _: string, _: any): nil
        end,
    }
    local scope: any = {raw = core.workerOpen(), registered = 0, observer = observer, closed = false, tasks = {}}
    function scope._submit(self: any, _: boolean, body: any, ...: any): any
        if self.closed then
            error("nupp: the worker scope is closed", 2)
        end
        for index = 1, select("#", ...) do
            local direction, owner, live = channels.identify((select(index, ...)))
            if direction ~= nil then
                if not live then
                    error("nupp: invalid, closed, or moved channel endpoint", 2)
                end
                if owner ~= self and owner ~= self._channelOwner then
                    error("nupp: channel endpoint belongs to another scope", 2)
                end
            end
        end
        local task = setmetatable({raw = self.raw:fork(body, ...), owner = self, done = false, waiters = {}}, Task)
        self.tasks[#self.tasks + 1] = task
        workerState.live[#workerState.live + 1] = task
        self.registered = self.registered + 1
        observer.created(self, task)
        readiness()

        return task
    end

    function scope.spawn(self: any, body: any, ...: any): any
        local ok, task = pcall(self._submit, self, false, body, ...)
        if not ok then
            workers.cleanuparguments(...)
            error(task, 0)
        end

        return task
    end

    -- Every VM worker gets a thread of its own, up to the VM's structured
    -- thread limit, so a dedicated child is admitted as a pooled one is.
    function scope.worker(self: any, body: any, ...: any): any
        return self:spawn(body, ...)
    end

    function scope._cancelAll(self: any, reason: string?): nil
        for _, task in ipairs(self.tasks) do
            if not task.done then
                task:cancel(reason)
            end
        end
    end

    function scope._settleOldest(self: any): boolean
        poll()
        for _, task in ipairs(self.tasks) do
            if not task.done then
                workers.settle(task)
                return true
            end
        end

        return false
    end

    function scope.close(self: any): nil
        if self.closed then
            return
        end
        while self.tasks[1] ~= nil do
            workers.settle(self.tasks[1])
        end
        self.raw:close()
        channels.closeScope(self)
        self.tasks = {}
        self.closed = true
    end

    return scope
end

function workers.__registered(scope: any): integer
    return scope.registered as integer
end

export = workers
