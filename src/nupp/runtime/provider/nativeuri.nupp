@!internal
module nupp.runtime.provider.nativeuri

--[[
Native URI parser for `host.uri` API 1.

The native runtime parses an absolute URI and exposes its normalized components.
This adapter copies those components into the canonical UriParts record declared
by [](nupp.io.uri.spi), preserving absent components separately
from present empty strings. Parsing errors return `nil, message`.

A native parse handle is temporary: it is released after extracting the result,
with an FFI finalizer protecting interrupted extraction. Returned strings and
records need no native cleanup. [](nupp.io.uri) owns the public URI type and
operations; provider selection does not create an alternative URI identity.
]]

local contracts = require("nupp.io.uri.spi")
const native = require("nupp.runtime.native")
local ffi, C = native.ffi, native.C
local provider = {}

ffi.cdef[[
int32_t nuppNativeUriParse(const uint8_t *, size_t, uint64_t *);
int32_t nuppNativeUriRelease(uint64_t);
int32_t nuppNativeUriPart(uint64_t, uint32_t, uint8_t *, size_t, size_t *, int32_t *);
int32_t nuppNativeUriPort(uint64_t, int32_t *);
]]

local function part(handle: any, kind: integer): string?
    local length = ffi.new("size_t[1]")
    local present = ffi.new<int32[1]>()
    native.succeeded(C.nuppNativeUriPart(handle[0], kind, nil, 0, length, present), 3)
    if present[0] == 0 then
        return nil
    end
    if length[0] == 0 then
        return ""
    end
    local bytes = ffi.new("uint8_t[?]", length[0])
    native.succeeded(C.nuppNativeUriPart(handle[0], kind, bytes, length[0], length, present), 3)

    return ffi.string(bytes, length[0])
end

function provider.parse(text: string): (contracts.UriParts?, string?)
    local handle = ffi.new<uint64[1]>()
    if C.nuppNativeUriParse(text, #text, handle) ~= 0 then
        return nil, ffi.string(C.nuppNativeLastError())
    end
    ffi.gc(handle, function(value: any): nil
        C.nuppNativeUriRelease(value[0])
    end)
    local rawPort = ffi.new<int32[1]>()
    native.succeeded(C.nuppNativeUriPort(handle[0], rawPort), 2)
    local parts = new contracts.UriParts(
        text = part(handle, 0) as string,
        scheme = part(handle, 1) as string,
        authority = part(handle, 2),
        username = part(handle, 3) as string,
        password = part(handle, 4),
        host = part(handle, 5),
        path = part(handle, 6) as string,
        query = part(handle, 7),
        fragment = part(handle, 8),
        port = rawPort[0] >= 0 and (tonumber(rawPort[0]) as integer) or nil
    )
    C.nuppNativeUriRelease(handle[0])
    ffi.gc(handle, nil)

    return parts
end

local checked: contracts.UriTextProvider = {parse = provider.parse}
export = checked
