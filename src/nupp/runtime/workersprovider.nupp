@!internal
module nupp.runtime.workersprovider

const _DYNAMIC_REQUIRES = "@requires-dynamically nupp.runtime.provider.workers @requires-dynamically nupp.runtime.browser.workers"

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")
local contracts = require("nupp.workers.spi")

-- Optional consumers use only implementations present in their artifact. The
-- public facade's literal imports carry its built-in fallbacks when that facility
-- is actually used; this dynamic require does not add a native dependency itself.
local function available(name: string): contracts.Provider?
    local ok, value = pcall(require, name)
    if ok then
        return value as contracts.Provider
    end
    if not tostring(value):find("module '" .. name .. "' not found", 1, true) then
        error(value, 0)
    end

    return nil
end

export const provider: contracts.Provider? = do
    local chosen: contracts.Provider?
    local tied = false
    for candidate in spi.load(contracts.Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.runtime.workersprovider: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    if target.dialect ~= "lua51"
        and (package.preload["nupp.workers.native"] ~= nil or package.loaded["nupp.workers.native"] ~= nil)
    then
        yield available("nupp.runtime.provider.workers")
    end
    if rawget(_G, "__nuppWasmHost") ~= nil then
        yield available("nupp.runtime.browser.workers")
    end
    yield nil
end
