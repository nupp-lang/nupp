@!internal

--[[
The core's global warnings and finalizer failures use `debug.log`'s shared
warning function. Initialization installs the callback that runs finalizers.
]]
module nupp.runtime.luawarn

const gccalls = require("nupp.runtime.gccalls")
const log = require("debug.log")

const emit = log.warner

-- What calling `value` runs and the value it passes first: a function
-- itself, nothing; a value whose metatable has a __call, that, with the
-- value, as Lua's call does; else nil.
local function callee(value: any): (any, any)
    if type(value) == "function" then
        return value, nil
    end
    local mt: any = getmetatable(value)
    if type(mt) == "table" and rawget(mt, "__call") ~= nil then
        return rawget(mt, "__call"), value
    end

    return nil, nil
end

local function finalize(object: any): nil
    local handler = gccalls.handler(object)
    if handler == nil then
        return
    end
    local call, self = callee(handler)
    if call == nil then
        emit("error in __gc (attempt to call a " .. type(handler) .. " value (metamethod '__gc'))")
        return
    end
    local ok: boolean, problem: any = true, nil
    if self ~= nil then
        ok, problem = pcall(call, self, object)
    else
        ok, problem = pcall(call, object)
    end
    if not ok then
        local text = type(problem) == "string" and problem or "error object is not a string"
        emit("error in __gc (" .. text .. ")")
    end
end

gccalls.install(finalize)

export const functions: {[string]: any} = {warn = emit}
