@!internal

--[[UUID operations use the implementation bound for the selected target.

Public utilities use the same retained functions.]]
module nupp.runtime.uuidprovider

local target = require("nupp.runtime.target")
local contracts = require("nupp.runtime.contracts")
local provider: contracts.UuidProvider = do
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativeuuid") as contracts.UuidProvider
    end
    yield _G.require("nupp.runtime.browser.crypto") as contracts.UuidProvider
end

export = provider
