@!internal

--- What the native core's host answers about the program. A call of one is
--- the core's own library call, and requiring this module loads nothing: it
--- exists only on the core, for the library values written over it.
local record hostcalls
    --- The program's arguments as Lua's `arg` holds them: the program at 0,
    --- then its arguments from 1, a new table each call.
    arguments: function(): {[integer]: string}

    -- Installs the rooted builtin string metatable, without user-table attachment.
    stringmeta: function(meta: {[string]: any}): nil

    -- Raises an argument error using the original library call's checked site.
    argerror: function(position: integer, fallback: string, detail: string, level: integer): nil

    --- Exactly count bytes from the secure host source, or an error. The
    --- private provider validates zero and the public maximum before calling.
    randombytes: function(count: integer): string

    --- Executing platform, architecture or byte order, selected privately by 0, 1 or 2.
    systemtext: function(field: integer): string

    --- Executing pointer width or usable parallelism, selected privately by 3 or 4.
    systeminteger: function(field: integer): integer

    --- Sets `cleanup` as the destructor of the affine types that name the
    --- declaration whose checked cleanup key is `key`: what a body for that
    --- declaration would set, for one only a declaration file holds.
    setcleanup: function(key: string, cleanup: function(any): nil): nil

    --- A new full userdata whose metatable is `meta`, carrying `value`:
    --- `type` names it "userdata", and `meta` answers its fields, `tostring`
    --- and operators. The core's own libraries make them; Lua cannot
    --- replace its metatable.
    userdata: function(meta: {[string]: any}, value: any): any

    --- The value userdata `u` carries, nil for anything else.
    uservalue: function(u: any): any
end

return hostcalls
