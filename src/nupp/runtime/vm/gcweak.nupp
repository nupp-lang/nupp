module nupp.runtime.vm.gcweak

--[[
The collector's side of weak tables and of what a dead object owns
(contracts 4.10, 4.12).

A table's weak mode is two bits of its header's `aux` (keys 1, values 2),
which the object library keeps as its metatable's `__mode` says; the
collector reads only the bits. A weak table is scanned as an ephemeron
table: an entry survives when each of its weak sides is a string or a boxed
integer, which are never cleared, or already marked; only then are both sides
marked. Every weak table a cycle scanned is revisited when the gray stack
drains, since a weak side marked later makes its entry survive, and once
marking can do no more, the entries whose weak side is still white are
cleared before the sweep frees what they named.

A lookup structure that is not a root but answers references, the intern
table first, is weak too, and a hit in it passes the read barrier: while
marking a white hit is grayed, and while sweeping a white hit whitened by an
earlier cycle is a miss, since the sweep has not reached it and will free
it, where one the sweep already passed (this cycle's epoch) is a survivor.

There are no finalizers: no guest code runs for a dead object. The runtime
still tears down owned payloads outside the slot: table parts, record arrays
and overflow, iterator keys, buffer bytes and userdata host data. Weak indexes
erase entries by exact header identity before retirement or reclamation. The
released-object handoff keeps its existing kinds: the sweep counts one dead,
sets its kind to `FREED`, and preserves its payload and slot until the runtime
takes it from the released list and recycles it.
]]

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const weakindex = require("nupp.runtime.vm.weakindex")
const weakentries = require("nupp.runtime.vm.weakentries")
const marking = require("nupp.runtime.vm.marking")

export const WEAK_KEYS: uint64 = 1
export const WEAK_VALUES: uint64 = 2
export const WEAK_MODES: uint64 = 3

--- Grays a white object, answering whether it did.
local function grayIfWhite(h: heap.Heap*, value: uint64): boolean
    return marking.shadeValue(h, value)
end

-- The host and standalone tables expose the same borrowed value and bucket views.
local function markLiveEntries(h: heap.Heap*, o: heap.Header*, mode: uint64): boolean
    @unsafe do
        local t = native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES) as heap.TableBody*
        return weakentries.weakMarkViews(
            h,
            native.pointer(t.arrayPtr),
            t.arrayLen,
            native.pointer(t.hashPtr),
            t.hashCap,
            mode
        )
    end
end

-- The cycle owns ordered header/mode pairs in the allocator's existing word
-- backing. A mode is snapshotted when scanned, matching the VM's cycle contract.
-- A later metatable mode change takes effect in the next cycle.
export function weakCycleReset(h: heap.Heap*): nil
    @unsafe h.weak.count = 0ULL
end

export function weakCycleRemember(h: heap.Heap*, o: heap.Header*, mode: uint64): nil
    @unsafe do
        heap.wordsPush(h.weak, native.address(o as voidptr))
        heap.wordsPush(h.weak, mode & WEAK_MODES)
    end
end

export function weakCycleScan(h: heap.Heap*, o: heap.Header*, mode: uint64): nil
    @unsafe do
        markLiveEntries(h, o, mode)
        local t = native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES) as heap.TableBody*
        grayIfWhite(h, t.meta)
        weakCycleRemember(h, o, mode)
        o.color = heap.COLOR_BLACK
    end
end

export function scanWeak(h: heap.Heap*, o: heap.Header*): nil
    @unsafe weakCycleScan(h, o, (o.aux as uint64) & WEAK_MODES)
end

-- Each pass revisits scan order; marking's driver repeats until the gray stack
-- and these ephemeron edges reach a fixed point.
export function weakCyclePropagate(h: heap.Heap*): uint64
    @unsafe do
        local grayed: boolean = false
        local i: uint64 = 0ULL
        while i < h.weak.count do
            local o = native.pointer(heap.wordAt(h.weak, i)) as heap.Header*
            if o.kind as uint64 == heap.KIND_TABLE then
                if markLiveEntries(h, o, heap.wordAt(h.weak, i + 1ULL)) then
                    grayed = true
                end
            end
            i = i + 2ULL
        end
        return native.asWord(grayed)
    end
end

export function propagate(h: heap.Heap*): boolean
    return weakCyclePropagate(h) ~= 0ULL
end

-- The caller owns this borrowed cursor, never a second remembered-table list.
-- A returned table is fully cleared before the driver refreshes host metadata.
export struct ClearCursor
    index: uint64
    header: uint64
    changed: uint64
end

export function weakCycleClearNext(h: heap.Heap*, cursor: ClearCursor*): uint64
    @unsafe do
        cursor.header = 0ULL
        cursor.changed = 0ULL
        while cursor.index < h.weak.count do
            local i = cursor.index
            cursor.index = i + 2ULL
            local o = native.pointer(heap.wordAt(h.weak, i)) as heap.Header*
            if o.kind as uint64 == heap.KIND_TABLE then
                local mode = heap.wordAt(h.weak, i + 1ULL)
                local t = native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES) as heap.TableBody*
                local changed = native.pointer(native.address(cursor as voidptr) + 16ULL)
                local length = weakentries.weakClearViews(
                    native.pointer(t.arrayPtr),
                    t.arrayLen,
                    native.pointer(t.hashPtr),
                    t.hashCap,
                    mode,
                    changed
                )
                t.arrayLen = length
                o.auxPtr = t.arrayPtr
                o.auxLen = length
                cursor.header = native.address(o as voidptr)
                return 1ULL
            end
        end
        weakCycleReset(h)
        return 0ULL
    end
end

export function clear(h: heap.Heap*): nil
    local state = new ClearCursor(0ULL, 0ULL, 0ULL)
    local cursor = state as ClearCursor*
    while weakCycleClearNext(h, cursor) ~= 0ULL do
    end
end

--- The read barrier of a weak lookup structure (4.12): whether a hit on `o`
--- stands. While marking a white hit is grayed and stands; while sweeping a
--- white hit an earlier cycle whitened is a miss, never a resurrection.
export function lookupHit(h: heap.Heap*, o: heap.Header*): boolean
    return marking.weakLookupHit(h, o)
end

-- Keep the released-object protocol for its existing kinds while host payload
-- teardown remains. Weak index removal already happened before this decision.
local function owns(o: heap.Header*): boolean
    @unsafe do
        local kind = o.kind as uint64
        local body = native.address(o as voidptr) + heap.HEADER_BYTES
        if kind == heap.KIND_TABLE then
            local t = native.pointer(body) as heap.TableBody*
            return t.arrayPtr ~= 0 or t.hashPtr ~= 0
        elseif kind == heap.KIND_RECORD then
            local tail = native.pointer(o.auxPtr + o.auxLen * 8) as heap.RecordTail*
            return tail.arrayPtr ~= 0 or tail.extra ~= 0
        elseif kind == heap.KIND_ITER then
            return o.auxPtr ~= 0
        elseif kind == heap.KIND_BYTES or kind == heap.KIND_STORAGE then
            return o.auxPtr ~= 0 and o.auxPtr ~= body
        elseif kind == heap.KIND_USERDATA or kind == heap.KIND_INTEGER then
            return true
        end
        return (o.flags as uint64) & heap.F_INTERNED ~= 0
    end
end

--- A white object the sweep reached: reclaimed at once when it owns nothing
--- outside its slot, else retired onto the released list for the runtime.
export function release(h: heap.Heap*, o: heap.Header*): nil
    weakindex.weakErase(h, o)
    @unsafe do
        if owns(o) then
            heap.retire(h, o)
            heap.wordsPush(h.released, native.address(o as voidptr))
        else
            heap.reclaim(h, o)
        end
    end
end

--- The next object the runtime must let go of, or zero: its kind is in
--- `aux` and its payload as it was. Hand it to `recycleReleased` when done.
export function nextReleased(h: heap.Heap*): uint64
    @unsafe do
        return heap.wordsPop(h.released)
    end
end

--- Gives a released object's slot back to the allocator.
export function recycleReleased(h: heap.Heap*, address: uint64): nil
    @unsafe heap.recycle(h, native.pointer(address) as heap.Header*)
end
