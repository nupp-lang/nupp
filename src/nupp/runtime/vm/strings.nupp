module nupp.runtime.vm.strings

--[[
Strings (contracts 1.3): heap objects of kind string, or a slice of one, whose
bytes the header's payload pointer and length name. Two interned strings are
equal iff their words are, which the equality handler decides before it reaches
here; everything else about two strings is their bytes, read in place. A new
string is allocated through a helper until N05 and filled here.
]]

const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

-- Ordering past the number compare of `Lt` and `Le`: two strings by their
-- bytes, unsigned, a proper prefix the lesser. Anything else is the step's: a
-- metamethod, or the error two incomparable values raise.
export function order(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    x: uint64,
    y: uint64,
    orEqual: uint64
): uint64
    if native.both(x & values.TAG_MASK == values.TAG_OBJ, y & values.TAG_MASK == values.TAG_OBJ) then
        local xh = native.pointer(x & values.PAYLOAD)
        local yh = native.pointer(y & values.PAYLOAD)
        local xk = native.load8(xh, native.layout("Header.kind"))
        local yk = native.load8(yh, native.layout("Header.kind"))
        if native.both(
            native.either(xk == values.KIND_STRING, xk == values.KIND_SLICE),
            native.either(yk == values.KIND_STRING, yk == values.KIND_SLICE)
        ) then
            local a = native.load8(pc, 1) * 8
            local xn = native.load64(xh, native.layout("Header.aux_len"))
            local yn = native.load64(yh, native.layout("Header.aux_len"))
            local xp = native.loadPointer(xh, native.layout("Header.aux_ptr"))
            local yp = native.loadPointer(yh, native.layout("Header.aux_ptr"))
            local n = native.chooseWord(xn < yn, xn, yn)
            -- Whole words first; a word that differs holds the deciding byte
            -- within the next eight.
            local i: uint64 = 0
            local words = n & 0xfffffffffffffff8ULL
            while i < words do
                if native.load64(xp, native.index(i)) ~= native.load64(yp, native.index(i)) then
                    break
                end
                i = i + 8
            end
            while i < n do
                local xb = native.load8(xp, native.index(i))
                local yb = native.load8(yp, native.index(i))
                if xb ~= yb then
                    native.store64(regs, a, native.chooseWord(xb < yb, values.TRUE, values.FALSE))
                    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                end
                i = i + 1
            end
            local less = native.either(xn < yn, native.both(orEqual ~= 0, xn == yn))
            native.store64(regs, a, native.chooseWord(less, values.TRUE, values.FALSE))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        end
    end

    return native.slow(pc, regs, ints, floats, context, frame)
end

local function eqSlow(pc: voidptr, context: voidptr, left: uint64, right: uint64, negate: uint64): uint64
    protocol.publishPc(pc, context)
    local equal = helpers.eqSlow(context, left, right)
    local answer = native.chooseWord((equal ~= 0) == (negate == 0), values.TRUE, values.FALSE)
    return protocol.continueAfter(pc, context, native.load8(pc, 1), answer, true)
end

-- Equality of two objects of different words that are not both interned: two
-- strings by length and bytes, since an interned string and a fresh one may
-- still spell the same; anything else (boxed integers, `__eq`) by the helper.
export function equal(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    x: uint64,
    y: uint64,
    negate: uint64
): uint64
    local xh = native.pointer(x & values.PAYLOAD)
    local yh = native.pointer(y & values.PAYLOAD)
    local xk = native.load8(xh, native.layout("Header.kind"))
    local yk = native.load8(yh, native.layout("Header.kind"))
    if native.both(
        native.either(xk == values.KIND_STRING, xk == values.KIND_SLICE),
        native.either(yk == values.KIND_STRING, yk == values.KIND_SLICE)
    ) then
        local n = native.load64(xh, native.layout("Header.aux_len"))
        local same = n == native.load64(yh, native.layout("Header.aux_len"))
        if same then
            local xp = native.loadPointer(xh, native.layout("Header.aux_ptr"))
            local yp = native.loadPointer(yh, native.layout("Header.aux_ptr"))
            local i: uint64 = 0
            local words = n & 0xfffffffffffffff8ULL
            while i < words do
                if native.load64(xp, native.index(i)) ~= native.load64(yp, native.index(i)) then
                    same = false
                    break
                end
                i = i + 8
            end
            while native.both(same, i < n) do
                if native.load8(xp, native.index(i)) ~= native.load8(yp, native.index(i)) then
                    same = false
                    break
                end
                i = i + 1
            end
        end
        native.store64(
            regs,
            native.load8(pc, 1) * 8,
            native.chooseWord(same == (negate == 0), values.TRUE, values.FALSE)
        )
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return eqSlow(pc, context, x, y, negate)
    end
end

--- One byte of a string, as the struct field it is stored through: the
--- profile has no byte store intrinsic, and `bytes.Span` is a struct value a
--- frameless handler cannot build.
export struct Byte
    value: uint8
end

-- Stores one byte of a string being filled.
local function putByte(dst: voidptr, at: uint64, byte: uint64): nil
    local slot = native.offset(dst, native.index(at)) as Byte*
    @unsafe slot.value = byte
end

-- Copies the `n` bytes at `src` to `dst` from `at`: whole words, then the
-- tail. Neither side need be aligned; nothing past `n` is touched.
local function copyBytes(dst: voidptr, at: uint64, src: voidptr, n: uint64): nil
    local i: uint64 = 0
    local words = n & 0xfffffffffffffff8ULL
    while i < words do
        native.store64(dst, native.index(at + i), native.load64(src, native.index(i)))
        i = i + 8
    end
    while i < n do
        putByte(dst, at + i, native.word(native.load8(src, native.index(i))))
        i = i + 1
    end
end

-- Answers a filled string into the instruction's result register, interned
-- when it is short enough to be (contracts 1.3).
local function deliver(pc: voidptr, context: voidptr, value: uint64, n: uint64): uint64
    if n <= values.INTERN_LIMIT then
        value = helpers.intern(context, value)
    end
    return protocol.continueAfter(pc, context, native.load8(pc, 1), value, true)
end

--[[
The text of a concatenation operand the core spells itself: a string's or a
slice's bytes; the decimal digits of a boxed integer, or of a number that is
integral, below 1e14 in magnitude and not negative zero. The two operands are
visited as the two iterations of one loop, once to measure and once to write,
so the spelling is written once. A number outside that rule is the step's
(`%.14g`), as is an operand of any other kind (`__concat`, or the error).
]]
local function concatSlow(pc: voidptr, context: voidptr, x: uint64, y: uint64): uint64
    local n: uint64 = 0
    local side: int64 = 0
    while side < 2 do
        local v = native.chooseWord(side == 0, x, y)
        local digits = true
        local magnitude: uint64 = 0
        local negative = false
        if v & values.TAG_MASK == values.TAG_OBJ then
            local h = native.pointer(v & values.PAYLOAD)
            if native.load8(h, native.layout("Header.kind")) == values.KIND_INTEGER then
                local bits = native.load64(h, native.layout("Header.aux_len"))
                negative = native.both(native.load32(h, native.layout("Header.aux")) == 0, native.index(bits) < 0)
                magnitude = native.chooseWord(negative, 0 - bits, bits)
            else
                digits = false
                n = n + native.load64(h, native.layout("Header.aux_len"))
            end
        else
            local m = native.toInt(native.fromBits(v))
            negative = m < 0
            magnitude = native.word(native.chooseIndex(negative, 0 - m, m))
        end
        if digits then
            local count: uint64 = native.chooseWord(negative, 2, 1)
            local rest = magnitude // 10
            while rest ~= 0 do
                count = count + 1
                rest = rest // 10
            end
            n = n + count
        end
        side = side + 1
    end
    protocol.publishPc(pc, context)
    local result = helpers.newString(context, native.index(n))
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local dst = native.loadPointer(native.pointer(result & values.PAYLOAD), native.layout("Header.aux_ptr"))
    local at: uint64 = 0
    side = 0
    while side < 2 do
        local v = native.chooseWord(side == 0, x, y)
        local digits = true
        local magnitude: uint64 = 0
        local negative = false
        if v & values.TAG_MASK == values.TAG_OBJ then
            local h = native.pointer(v & values.PAYLOAD)
            if native.load8(h, native.layout("Header.kind")) == values.KIND_INTEGER then
                local bits = native.load64(h, native.layout("Header.aux_len"))
                negative = native.both(native.load32(h, native.layout("Header.aux")) == 0, native.index(bits) < 0)
                magnitude = native.chooseWord(negative, 0 - bits, bits)
            else
                digits = false
                local count = native.load64(h, native.layout("Header.aux_len"))
                copyBytes(dst, at, native.loadPointer(h, native.layout("Header.aux_ptr")), count)
                at = at + count
            end
        else
            local m = native.toInt(native.fromBits(v))
            negative = m < 0
            magnitude = native.word(native.chooseIndex(negative, 0 - m, m))
        end
        if digits then
            local count: uint64 = native.chooseWord(negative, 2, 1)
            local rest = magnitude // 10
            while rest ~= 0 do
                count = count + 1
                rest = rest // 10
            end
            -- The digits land last to first; a sign leads them.
            local p = at + count
            while true do
                p = p - 1
                putByte(dst, p, 48 + magnitude % 10)
                magnitude = magnitude // 10
                if magnitude == 0 then
                    break
                end
            end
            if negative then
                putByte(dst, at, 45)
            end
            at = at + count
        end
        side = side + 1
    end

    return deliver(pc, context, result, n)
end

-- `Concat`: two operands the core spells itself (see `concatSlow`) are joined
-- into a new string; anything else is the step's.
export function Concat(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local x = native.load64(regs, native.load8(pc, 2) * 8)
    local y = native.load64(regs, native.load8(pc, 3) * 8)
    local plain = true
    local side: int64 = 0
    while side < 2 do
        local v = native.chooseWord(side == 0, x, y)
        if native.either(v & values.QNAN ~= values.QNAN, v == values.QNAN) then
            local d = native.fromBits(v)
            if native.either(
                native.either(native.floor(d) ~= d, d >= 1e14),
                native.either(d <= -1e14, v == 0x8000000000000000ULL)
            ) then
                plain = false
            end
        elseif v & values.TAG_MASK == values.TAG_OBJ then
            local k = native.load8(native.pointer(v & values.PAYLOAD), native.layout("Header.kind"))
            if native.both(native.both(k ~= values.KIND_STRING, k ~= values.KIND_SLICE), k ~= values.KIND_INTEGER) then
                plain = false
            end
        else
            plain = false
        end
        side = side + 1
    end
    if plain then
        return concatSlow(pc, context, x, y)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end
