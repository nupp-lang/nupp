module nupp.runtime.vm.marking

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const objectweak = require("nupp.runtime.vm.objectweak")
const values = require("nupp.runtime.vm.values")
const childwalk = require("nupp.runtime.vm.childwalk")

-- The candidate header stays owned while these operations run. Queue growth
-- maps native backing but never collects, parks, or calls guest code.
export function shadeValue(h: heap.Heap*, value: uint64): boolean
    @unsafe do
        if value & values.TAG_MASK ~= values.TAG_OBJ then
            return false
        end
        local o = native.pointer(value & values.PAYLOAD) as heap.Header*
        if o.color as uint64 ~= heap.COLOR_WHITE then
            return false
        end
        o.color = heap.COLOR_GRAY
        heap.grayPush(h, o)
        return true
    end
end

-- Root words may contain stale or unrelated bits. Count nonnull object tags
-- before validating the slot; owned child references use shadeValue directly.
-- Gray growth only takes a pool slot or maps a new nonmoving arena chunk.
export function rootCandidate(h: heap.Heap*, value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local address = value & values.PAYLOAD
    if address == 0ULL then
        return 0ULL
    end
    if heap.isLiveSlot(h, address) then
        shadeValue(h, value)
    end

    return 1ULL
end

-- The driver has handled weak-mode and record-liveness hooks. Every child slot
-- counts, including scalars and nil. References are already valid owned objects;
-- only root candidates need the separate live-slot check.
export function scanStrong(h: heap.Heap*, o: heap.Header*): uint64
    @unsafe do
        local state = new childwalk.Cursor(0ULL, 0ULL, values.NIL)
        local cursor = state as childwalk.Cursor*
        local children = 0ULL
        while childwalk.childNext(o, cursor) ~= 0ULL do
            children = children + 1ULL
            shadeValue(h, cursor.value)
        end
        o.color = heap.COLOR_BLACK
        return children
    end
end

export function barrierShade(h: heap.Heap*, value: uint64): nil
    if shadeValue(h, value) then
        @unsafe h.stats.barrierGrays = h.stats.barrierGrays + 1
    end
end

export function insertionBarrier(h: heap.Heap*, parent: heap.Header*, child: uint64): nil
    @unsafe do
        if h.marking as uint64 == 0 then
            return
        end
        if parent.color as uint64 == heap.COLOR_BLACK then
            barrierShade(h, child)
        end
    end
end

-- Current collector state is transported by the caller before weak lookup.
export function weakLookupHit(h: heap.Heap*, o: heap.Header*): boolean
    @unsafe do
        local action = objectweak.weakLookupAction(
            native.word(h.phase),
            o.color as uint64,
            o.epoch as uint64,
            h.stats.cycles,
            heap.COLOR_WHITE,
            heap.PHASE_MARKING,
            heap.PHASE_SWEEPING
        )
        if action == 1ULL then
            barrierShade(h, heap.objectValue(o))
        elseif action == 2ULL then
            return false
        end
        return true
    end
end
