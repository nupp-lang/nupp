module nupp.runtime.vm.marking

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const objectweak = require("nupp.runtime.vm.objectweak")
const values = require("nupp.runtime.vm.values")
const childwalk = require("nupp.runtime.vm.childwalk")
const objecttable = require("nupp.runtime.vm.objecttable")

-- The candidate header stays owned while these operations run. Queue growth
-- maps native backing but never collects, parks, or calls guest code.
export function shadeValue(h: heap.Heap*, value: uint64): boolean
    @unsafe do
        if value & values.TAG_MASK ~= values.TAG_OBJ then
            return false
        end
        local o = native.pointer(value & values.PAYLOAD) as heap.Header*
        if o.color as uint64 ~= heap.COLOR_WHITE then
            return false
        end
        -- A minor collection takes an old object as marked (Decision 20).
        if h.minor ~= 0ULL and (o.flags as uint64) & heap.F_OLD ~= 0ULL then
            return false
        end
        -- A refused queue growth must leave no unqueued gray object.
        heap.grayPush(h, o)
        o.color = heap.COLOR_GRAY
        return true
    end
end

-- Root words may contain stale or unrelated bits. Count nonnull object tags
-- before validating the slot; owned child references use shadeValue directly.
-- Gray growth only takes a pool slot or maps a new nonmoving arena chunk.
export function rootCandidate(h: heap.Heap*, value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local address = value & values.PAYLOAD
    if address == 0ULL then
        return 0ULL
    end
    if heap.isLiveSlot(h, address) then
        shadeValue(h, value)
    end

    return 1ULL
end

-- Shades the object values among the `count` words at `base`; answers count.
local function shadeRun(h: heap.Heap*, base: uint64, count: uint64): uint64
    @unsafe do
        local at = base
        local stop = base + count * 8ULL
        while at < stop do
            local value = native.load64(native.pointer(at), 0)
            if value & values.TAG_MASK == values.TAG_OBJ then
                shadeValue(h, value)
            end
            at = at + 8ULL
        end

        return count
    end
end

-- Shades the key and value of each entry of hash part `t` in insertion order
-- whose value is not nil, as childwalk walks them; answers how many it shaded.
local function shadePairs(h: heap.Heap*, t: heap.ValueTable*): uint64
    @unsafe do
        if t.ptr == 0ULL then
            return 0ULL
        end
        local children: uint64 = 0ULL
        local position: uint64 = 0ULL
        -- A listed part's entries are its buckets, in order (objecttable).
        local listed = objecttable.listed(t)
        while position < t.length do
            local bucket = position
            if not listed then
                bucket = native.word(native.load32(native.pointer(t.order), native.index(position * 4ULL)))
                    & values.LOW_WORD
            end
            if bucket >= t.capacity then
                return children
            end
            local entry = t.ptr + bucket * 16ULL
            local value = native.load64(native.pointer(entry), 8)
            if value ~= values.NIL then
                local key = native.load64(native.pointer(entry), 0)
                if key & values.TAG_MASK == values.TAG_OBJ then
                    shadeValue(h, key)
                end
                if value & values.TAG_MASK == values.TAG_OBJ then
                    shadeValue(h, value)
                end
                children = children + 2ULL
            end
            position = position + 1ULL
        end

        return children
    end
end

-- The driver has handled weak-mode and record-liveness hooks. Every child slot
-- counts, including scalars and nil. References are already valid owned objects;
-- only root candidates need the separate live-slot check.
export function scanStrong(h: heap.Heap*, o: heap.Header*): uint64
    objecttable.coredeadkeys(h, o, 0ULL, 0xffffffffffffffffULL)
    @unsafe do
        local state = childwalk.Cursor(0ULL, 0ULL, values.NIL)
        -- Tables, closures and cells, most of what is marked, in line: their
        -- value runs, a table's live pairs, then its metatable.
        local kind = o.kind as uint64
        if kind == heap.KIND_TABLE or kind == heap.KIND_CLOSURE or kind == heap.KIND_CELL then
            local walked = shadeRun(h, o.auxPtr, o.auxLen)
            if kind == heap.KIND_TABLE then
                local body = native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES)
                local hash = native.offset(body, native.fieldOffset<heap.TableBody>("hashPtr")) as heap.ValueTable*
                walked = walked + shadePairs(h, hash)
                local meta = (body as heap.TableBody*).meta
                if meta ~= values.NIL then
                    shadeValue(h, meta)
                    walked = walked + 1ULL
                end
            end
            o.color = heap.COLOR_BLACK

            return walked
        end
        local cursor = state as childwalk.Cursor*
        local children = 0ULL
        while childwalk.childNext(o, cursor) ~= 0ULL do
            children = children + 1ULL
            if childwalk.candidate(o, cursor) then
                rootCandidate(h, cursor.value)
            else
                shadeValue(h, cursor.value)
            end
        end
        o.color = heap.COLOR_BLACK
        return children
    end
end

export function barrierShade(h: heap.Heap*, value: uint64): nil
    if shadeValue(h, value) then
        @unsafe h.stats.barrierGrays = h.stats.barrierGrays + 1
    end
end

export function insertionBarrier(h: heap.Heap*, parent: heap.Header*, child: uint64): nil
    @unsafe do
        if h.marking as uint64 == 0 then
            return
        end
        if parent.color as uint64 == heap.COLOR_BLACK then
            barrierShade(h, child)
        end
    end
end

-- Current collector state is transported by the caller before weak lookup.
export function weakLookupHit(h: heap.Heap*, o: heap.Header*): boolean
    @unsafe do
        local action = objectweak.weakLookupAction(
            native.word(h.phase),
            o.color as uint64,
            o.epoch as uint64,
            h.stats.cycles,
            heap.COLOR_WHITE,
            heap.PHASE_MARKING,
            heap.PHASE_SWEEPING
        )
        if action == 1ULL then
            barrierShade(h, heap.objectValue(o))
        elseif action == 2ULL then
            return false
        end
        return true
    end
end
