-- The operating-system edges native code reaches by C ABI, implemented by
-- the glue (`native/crates/vm/src/os_glue.rs`). A member `name` here is the
-- exported symbol `nupp_os_<name in snake case>`; the lowering reads each
-- signature from this declaration, so adding an edge is a line here and its
-- export in the glue. Pages first: the runtime's arenas and heap are written
-- in Nupp over them; standard input and output let a standalone harness read
-- its data and report.
-- Blocking OS I/O does not park a guest task. These entries neither collect
-- the Nupp heap nor raise guest values, and their external effects are not pure.
local record Os
    --- Maps `bytes` of zeroed, readable and writable memory at a page
    --- boundary, or nil when the system refuses.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    mapPages: function(bytes: uint64): voidptr?

    --- Unmaps what `mapPages` mapped at `base` for `bytes`.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    unmapPages: function(base: voidptr, bytes: uint64): nil

    --- Advises the system about the pages at `base`: 0 says their contents are
    --- no longer needed, 1 that they are about to be used.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    advisePages: function(base: voidptr, bytes: uint64, advice: int64): nil

    --- The system's page size in bytes.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pageSize: function(): uint64

    --- A monotonic clock in nanoseconds, for measurements.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    monotonicNanos: function(): uint64

    --- Reads up to `bytes` of standard input into `base`: the count read, 0 at
    --- its end, negative when the read failed.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    readInput: function(base: voidptr, bytes: uint64): int64

    --- Writes `bytes` at `base` to standard output: the count written, negative
    --- when the write failed.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    writeOutput: function(base: voidptr, bytes: uint64): int64

    --- Copies the environment variable named by the `nameBytes` bytes at `name`
    --- into `out`, at most `room` bytes: the value's whole length, or -1 when
    --- it is unset.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    environment: function(name: voidptr, nameBytes: uint64, out: voidptr, room: uint64): int64

    --- Writes the binary64 `bits` as Lua 5.5 writes a float, C's "%.15g" or,
    --- when that reads back as another number, "%.17g", into `out`, at most
    --- `room` bytes: the text's whole length.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    formatNumber: function(bits: uint64, out: voidptr, room: uint64): int64

    --- Reads the `bytes` at `text` as C's strtod does, the whole text but for
    --- surrounding space: 1 with the binary64 bits stored at `out`, or 0 when it
    --- is not one numeral.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    parseNumber: function(text: voidptr, bytes: uint64, out: voidptr): int64

    --- C's math function `op` of the binary64 bits `x` (and `y` for the
    --- two-operand ones), as binary64 bits: 0 pow, 1 exp, 2 log, 3 log2,
    --- 4 log10, 5 sin, 6 cos, 7 tan, 8 asin, 9 acos, 10 atan2(x, y), 11 fmod.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    mathFunction: function(op: uint64, x: uint64, y: uint64): uint64

    --- A seed for the guest's random numbers: the wall clock in nanoseconds
    --- mixed with an address and the process id, as Lua's seed mixes the
    --- time with addresses.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    randomSeed: function(): uint64

    --- Copies the program argument at `index`, 0 the program and then its
    --- arguments in order, into `out`, at most `room` bytes: its whole
    --- length, or -1 past the last. The core's bridge answers it; the VM
    --- builds its `arg` table itself.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    argument: function(index: uint64, out: voidptr, room: uint64): int64

    --- Opens the file named by the `bytes` bytes at `path` with the access
    --- `flags` asks for (1 read, 2 write, 4 create, 8 truncate, 16 append):
    --- its descriptor, or the negated error number. The core's bridge
    --- answers it and the five file calls after it, for the core's file
    --- layer.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileOpen: function(path: voidptr, bytes: uint64, flags: uint64): int64

    --- Reads at most `room` bytes from descriptor `fd` into `out`: the count
    --- read, 0 at the end, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileRead: function(fd: uint64, out: voidptr, room: uint64): int64

    --- Writes at most `bytes` bytes at `base` to descriptor `fd`: the count
    --- written, which may be fewer, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileWrite: function(fd: uint64, base: voidptr, bytes: uint64): int64

    --- Moves descriptor `fd` to the two's-complement `offset` from its start
    --- (0), its position (1) or its end (2): the new position, or the
    --- negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileSeek: function(fd: uint64, offset: uint64, whence: uint64): int64

    --- Closes descriptor `fd`: 0, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileClose: function(fd: uint64): int64

    --- Copies the system's text for the error number `code` into `out`, at
    --- most `room` bytes: its whole length.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    errorText: function(code: uint64, out: voidptr, room: uint64): int64

    --- A new poller (kqueue on macOS, epoll on Linux): its descriptor, or
    --- the negated error number. The core's bridge answers it and the
    --- eight calls after it, for the core's reactor.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pollOpen: function(): int64

    --- Sets the readiness `poller` waits for on descriptor `fd` to `interest`
    --- (1 readable, 2 writable, added together; 0 none), for one event: 0, or
    --- the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pollArm: function(poller: uint64, fd: uint64, interest: uint64): int64

    --- Waits at most `nanos` nanoseconds (all ones: without limit) for one
    --- event: its descriptor above five bits (1 readable, 2 writable, 4 hung
    --- up, 8 failed), or a child's process id above 16 for its exit; 0 when
    --- the time passed, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pollWait: function(poller: uint64, nanos: uint64): int64

    --- A nonblocking pipe: its read end's descriptor, the write end's from
    --- bit 32, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pipeOpen: function(): int64

    --- Starts the blocking-work pool's `threads` workers, once: the wake
    --- descriptor that is readable while results wait, or the negated error
    --- number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    poolStart: function(threads: uint64): int64

    --- Submits a pool job, its bytes copied now: an open of the path at
    --- `base` with access `word` (kind 1), a read of at most `bytes` bytes
    --- from descriptor `word` (2), or a write of the bytes at `base` to it
    --- (3). Its ticket, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    poolSubmit: function(kind: uint64, word: uint64, base: voidptr, bytes: uint64): int64

    --- The ticket of a finished pool job not yet taken, or 0.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    poolTake: function(): int64

    --- Collects taken pool job `ticket`, copying what a read read into `out`,
    --- at most `room` bytes: what its system call answered.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    poolFinish: function(ticket: uint64, out: voidptr, room: uint64): int64

    --- Withdraws pool job `ticket` if no worker has started it: 1, or 0.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    poolCancel: function(ticket: uint64): int64

    --- Sleeps for `nanos` nanoseconds: the scheduler's wait while nothing but
    --- its timers can wake it. Answers 0.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    sleepNanos: function(nanos: uint64): uint64

    --- A pipe for a child's standard stream, closing on exec: the end `keep`
    --- names (0 the read end, 1 the write end) nonblocking, the child's end
    --- blocking. Its read end's descriptor, the write end's from bit 32, or
    --- the negated error number. The core's bridge answers it and the six
    --- calls after it, for the core's process layer.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processPipe: function(keep: uint64): int64

    --- Starts the child the `bytes` bytes at `spec` describe, in a process
    --- group of its own, with `flags` (1 search PATH, 2 the given environment
    --- only, 4 it over this program's): its process id, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processSpawn: function(spec: voidptr, bytes: uint64, flags: uint64): int64

    --- Has `poller` report child `pid`'s exit once: 0, or the negated error
    --- number (ESRCH when it has exited already).
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processWatch: function(poller: uint64, pid: uint64): int64

    --- Stops watching child `pid`'s exit: 0, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processUnwatch: function(poller: uint64, pid: uint64): int64

    --- Collects child `pid` if it has exited: its reason (1 an exit, 2 a
    --- signal) above eight bits of its status or signal, 0 while it runs, or
    --- the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processReap: function(pid: uint64): int64

    --- Sends `signal` to child `pid`'s whole process group: 0, or the
    --- negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processKill: function(pid: uint64, signal: uint64): int64

    --- Ends this process with status `code`; it does not return.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    processExit: function(code: uint64): int64

    --- The wall clock in whole seconds since the epoch, C's time(NULL). The
    --- core's bridge answers it and the seven calls after it, for the core's
    --- `os` library.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    wallClock: function(): int64

    --- The processor time this process has used in seconds, C's clock() over
    --- CLOCKS_PER_SEC, as binary64 bits.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    cpuClock: function(): uint64

    --- Writes the nine fields of `t` broken down (in UTC when `flags` is 1,
    --- else local time) as int64 words at `out`, in C's `struct tm` order
    --- from seconds to the daylight-saving flag: 0, or -1 when the system
    --- cannot represent it.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    timeParts: function(t: uint64, flags: uint64, out: voidptr): int64

    --- C's mktime of the nine fields at `fields`, which it writes back
    --- normalized: the time, or -1.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    timeMake: function(fields: voidptr): int64

    --- strftime of the one conversion in the `bytes` bytes at `spec` for `t`
    --- broken down as timeParts breaks it, into `out`, at most `room` bytes:
    --- the text's whole length, or -1 when the system cannot represent `t`.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    timeFormat: function(t: uint64, flags: uint64, spec: voidptr, bytes: uint64, out: voidptr, room: uint64): int64

    --- Removes the file or empty directory named by the `bytes` bytes at
    --- `path`, as C's remove: 0, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileRemove: function(path: voidptr, bytes: uint64): int64

    --- Renames the file named by the `fromBytes` bytes at `from` to the
    --- `toBytes` bytes at `to`, as C's rename: 0, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileRename: function(from: voidptr, fromBytes: uint64, to: voidptr, toBytes: uint64): int64

    --- Makes a new empty file with a unique name and closes it, copying its
    --- name into `out`, at most `room` bytes: the name's whole length, or the
    --- negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileTemporary: function(out: voidptr, room: uint64): int64

    --- Opens the directory named by the `bytes` bytes at `path` below
    --- directory `fd` (the working directory when negative) without
    --- following a link: its descriptor, or the negated error number,
    --- ENOTDIR for anything that is not a directory, a link included.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    dirOpen: function(fd: uint64, path: voidptr, bytes: uint64): int64

    --- Copies the names of directory `fd`'s entries, "." and ".." aside, each
    --- followed by a NUL, into `out`, at most `room` bytes: their whole
    --- length, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    dirNames: function(fd: uint64, out: voidptr, room: uint64): int64

    --- Unlinks the entry named by the `bytes` bytes at `path` in directory
    --- `fd` (the working directory when negative), an empty directory when
    --- `directory` is 1: 0, or the negated error number.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    unlinkEntry: function(fd: uint64, path: voidptr, bytes: uint64, directory: uint64): int64

    -- The standalone core bridge supplies these raw atomics; the frozen VM
    -- does not. SeqCst access requires a naturally aligned live word.
    -- The caller owns the
    -- mapped extent and retains it throughout the operation.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    atomicload64: function(base: voidptr, offset: int64): uint64

    -- SeqCst compare-and-swap; returns the prior word whether it matched or
    -- not. Alignment and lifetime have the same preconditions as atomicload64.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    atomiccas64: function(base: voidptr, offset: int64, expected: uint64, replacement: uint64): uint64

    --- Fills exactly bytes from the host secure random source: 0 on success,
    --- otherwise its negative OS status (or a negative getrandom internal status).
    --- No result bytes are publishable after failure. The destination stays
    --- owned and writable through this noncollecting, noncallback call.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    securefill: function(base: voidptr, bytes: uint64): int64

    --- Executing facts: fields 0..2 size/fill text, 3 answers pointer bits,
    --- and 4 queries usable parallelism. Scalar queries require a zero range.
    --- Text sizing uses a zero range; a short/invalid loan writes nothing.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    systemquery: function(field: uint64, base: voidptr, room: uint64): int64

    -- Unix epoch milliseconds as binary64 bits, independent of monotonic time.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    wallMillis: function(): uint64

    -- Raw filesystem results are zero/counts or the negated OS error.
    -- Metadata output is exactly five little-endian 64-bit words.
    -- Text queries size at a zero range; short ranges publish no bytes.
    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileInfo: function(path: voidptr, bytes: uint64, follow: uint64, out: voidptr): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    fileStatus: function(fd: uint64, out: voidptr): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    readLink: function(path: voidptr, bytes: uint64, out: voidptr, room: uint64): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    makeDirectory: function(path: voidptr, bytes: uint64, mode: uint64): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    makeSymlink: function(target: voidptr, targetBytes: uint64, link: voidptr, linkBytes: uint64): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    changeMode: function(path: voidptr, bytes: uint64, mode: uint64): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    syncFile: function(fd: uint64): int64

    @vmHelperEffects(mayCollect = false, mayPark = false, mayRaise = false, pure = false)
    pathQuery: function(which: uint64, path: voidptr, bytes: uint64, out: voidptr, room: uint64): int64

end
return Os
