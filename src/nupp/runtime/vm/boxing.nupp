module nupp.runtime.vm.boxing

-- Boxing, tag checks, string bytes and record allocation.
const native = require("nupp.runtime.vm.intrinsics")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

export function TagCheckNum(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, native.load8(pc, 2))
    if native.either(value & values.QNAN ~= values.QNAN, value == values.QNAN) then
        slots.writeValue(frame, regs, native.load8(pc, 1), value)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function IBox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readInteger(frame, ints, native.load8(pc, 2))
    if native.either(value < -values.MAX_EXACT_INTEGER, values.MAX_EXACT_INTEGER < value) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        slots.writeValue(frame, regs, native.load8(pc, 1), native.bits(native.toFloat(value)))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function IUnbox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, native.load8(pc, 2))
    if native.either(value & values.QNAN ~= values.QNAN, value == values.QNAN) then
        local d = native.fromBits(value)
        if native.both(native.both(-values.INT64_RANGE <= d, d < values.INT64_RANGE), native.floor(d) == d) then
            slots.writeInteger(frame, ints, native.load8(pc, 1), native.toInt(d))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function StrByte(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, native.load8(pc, 2))
    local position = slots.readInteger(frame, ints, native.load8(pc, 3))
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & values.PAYLOAD)
        local kind = native.load8(header, native.layout("Header.kind"))
        if native.either(native.both(kind ~= 1, kind ~= 9), position < 0) then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local a = native.load8(pc, 1)
            if native.both(
                position >= 1,
                native.word(position) <= native.load64(header, native.layout("Header.aux_len"))
            ) then
                local byte = native.load8(native.loadPointer(header, native.layout("Header.aux_ptr")), position - 1)
                slots.writeValue(frame, regs, a, native.bits(native.toFloat(byte)))
            else
                slots.writeValue(frame, regs, a, values.NIL)
            end
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        end
    end
end

-- A record allocation: the collector may run, so the frame is published
-- before and the windows derived again after.
export function NewRecord(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    protocol.publishPc(pc, context)
    local value = helpers.newRecord(context, native.loadIndex(pc, 8))
    return protocol.continueAfter(pc, context, native.load8(pc, 1), value, true)
end
