module nupp.runtime.vm.boxing

-- Boxing, tag checks, string bytes and record allocation.
const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")
const numeric = require("nupp.runtime.vm.numerichelpers")

export function TagCheckNum(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, program.readByte(pc, 2))
    if native.either(value & values.QNAN ~= values.QNAN, value == values.QNAN) then
        slots.writeValue(frame, regs, program.readByte(pc, 1), value)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        protocol.publishPc(pc, context)
        numeric.numericError(context, 4)
        return native.fail()
    end
end

export function StrByte(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 2))
    local position = slots.readInteger(frame, ints, program.readByte(pc, 3))
    local valid: boolean = false
    if object & values.TAG_MASK == values.TAG_OBJ then
        local kind = native.load8(native.pointer(object & values.PAYLOAD), native.layout("Header.kind"))
        valid = kind == values.KIND_STRING or kind == values.KIND_SLICE
    end
    if not valid then
        protocol.publishPc(pc, context)
        numeric.numericError(context, 5)
        return native.fail()
    end
    local header = native.pointer(object & values.PAYLOAD)
    local length = native.load64(header, native.layout("Header.aux_len"))
    local offset = values.NO_GUARD
    if position > 0 then
        offset = native.word(position - 1)
    elseif position < 0 then
        -- Unsigned magnitude also covers the minimum signed integer.
        local back = 0ULL - native.word(position)
        if back <= length then
            offset = length - back
        end
    end
    local result = values.NIL
    if offset < length then
        local byte = native.load8(native.loadPointer(header, native.layout("Header.aux_ptr")), native.index(offset))
        result = native.bits(native.toFloat(byte))
    end
    slots.writeValue(frame, regs, program.readByte(pc, 1), result)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

-- A record allocation: the collector may run, so the frame is published
-- before and the windows derived again after.
export function NewRecord(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    protocol.publishPc(pc, context)
    local value = helpers.newRecord(context, program.readInteger(pc, 8))
    return protocol.continueAfter(pc, context, program.readByte(pc, 1), value, true)
end
