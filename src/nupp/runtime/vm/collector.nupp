module nupp.runtime.vm.collector

--[[
The collector (contracts 4): precise, incremental, non-moving tri-color
mark-sweep with an insertion barrier, paced by allocation debt at safepoints,
with the verification modes of 4.11 built in.

Marking drains the gray stack, then rescans the mutable roots (4.6); when that
grays nothing, sweeping walks the chunks in allocation order and the large
list, freeing white objects and whitening black ones with the cycle's epoch
(4.12). An object allocated while a cycle runs is black ahead of the sweep and
white behind it (4.3), which `heap.allocRaw` decides.

Roots (4.5, 4.7, 4.14, 5.1) are walked from the heap record: registered
ranges of value words (the runtime's arena records with managed fields, for
their lexical extent), registered handles with explicit release, the handle
scope stack, immutable ranges (constant pools) walked when a cycle starts but
not at the rescan, and task frame stacks followed through their frame
headers. Every candidate is accepted only when it addresses a live slot, as
a frame word may be stale.

The shared child cursor (`nupp.runtime.vm.childwalk`) reads canonical object
layouts in insertion order. Marking visits every stored value; the oracle
retains only object references from the same sequence.

Generations (runtime Decision 20) are kept as Lua 5.4's generational mode
keeps them, without moving anything. A heap whose `generational` is set runs
minor collections: they trace the young objects reachable from the roots, the
remembered old objects and the dirty cards of large old tables, then sweep
only the young, and an object that survives its second one is old. The
barrier records an old object taking a young child. Frames are roots, so a
frame store needs no barrier. A full collection frees what is dead at any age
and leaves ages as they were; with generations it runs whole, as Lua's major
collections do, unless a verification mode steps it.
]]

const native = require("nupp.runtime.vm.intrinsics")
const heap = require("nupp.runtime.vm.heap")
const values = require("nupp.runtime.vm.values")
const weak = require("nupp.runtime.vm.gcweak")
const marking = require("nupp.runtime.vm.marking")
const childwalk = require("nupp.runtime.vm.childwalk")
const objectwalk = require("nupp.runtime.vm.objectwalk")
const backing = require("nupp.runtime.vm.backing")
const objecttable = require("nupp.runtime.vm.objecttable")

--- Whether the core's heaps run minor collections (Decision 20): the switch
--- that turns them off, which leaves the incremental collector as it was.
export const GENERATIONAL: uint64 = 1ULL

--- Slots one card covers, and the fewest slots, array and hash part
--- together, of a table that carries cards rather than being remembered.
export const CARD_SLOTS: uint64 = 64ULL

export const CARD_MINIMUM: uint64 = 256ULL

--- Under stress, the minor collections between full ones; interleaved, the
--- minor collections before each incremental cycle.
const STRESS_MINORS: uint64 = 15ULL

const INTERLEAVED_MINORS: uint64 = 8ULL

--- The least allocation between minor collections.
const MINOR_FLOOR: uint64 = 262144ULL

--- No card record, or no bucket.
const NONE: uint64 = 0xffffffffffffffffULL

--- A task's frame stack as the root walk reads it (5.1): the base of its
--- words and the index of the top frame, or `NO_FRAME` once it is done.
export struct Task
    stack: uint64
    top: uint64
end

--- The top frame index of a task that has none.
export const NO_FRAME: uint64 = 0xffffffffffffffffULL

--- Header word 1's low half at the entry frame.
const NO_CALLER: uint64 = 0xffffffff

--- A budget no step exhausts.
const UNBOUNDED: uint64 = 0x1fffffffffffffffULL

-- ---- roots -----------------------------------------------------------------------

--- Registers `words` value words at `base` as roots, until `unregister`.
--- Registrations nest: the last made is the first ended, as lexical scopes
--- do (4.14).
export function register(h: heap.Heap*, base: uint64, words: uint64): nil
    @unsafe do
        heap.wordsPush(h.ranges, base)
        heap.wordsPush(h.ranges, words)
    end
end

--- The word count that marks a registered range as a frame stack: its base
--- is then a stack's descriptor (its base, limit and cursor words, as the
--- core's `arena.Segment` lays them out), and the words from the stack's base
--- to its cursor are the roots. Those past the cursor are released frames,
--- and a stack mapped for its deepest recursion is touched only as it grows.
export const SEGMENT: uint64 = 0xffffffffffffffffULL

--- Registers the frame stack `segment` describes as roots, until `unregister`.
export function registerSegment(h: heap.Heap*, segment: uint64): nil
    register(h, segment, SEGMENT)
end

--- The word count that marks a registered range as a frame stack in chunks
--- (`heap.STACK_CHUNK`): its base is the stack's first chunk, and each
--- chunk's words from its base to its cursor are roots.
export const CHAIN: uint64 = 0xfffffffffffffffeULL

--- Registers the frame stack whose first chunk is `chunk` as roots, until
--- `unregister`.
export function registerChain(h: heap.Heap*, chunk: uint64): nil
    register(h, chunk, CHAIN)
end

export function unregister(takes h: heap.Heap*): nil
    @unsafe do
        heap.wordsPop(h.ranges)
        heap.wordsPop(h.ranges)
    end
end

--- Registers a range until its local owner leaves scope.
---
--- `local rooted = collector.rooted(h, base, words)` retains the registration
--- until the lexical scope ends or the owner is dropped.
export function rooted(h: heap.Heap*, base: uint64, words: uint64): affine(heap.Heap*, unregister)
    register(h, base, words)
    return h
end

--- Registers an immutable range, a function's constant pool: walked when a
--- cycle starts and not at the rescan, since what joins it later is
--- allocated black or grayed by the barrier.
export function addConstants(h: heap.Heap*, base: uint64, words: uint64): nil
    @unsafe do
        heap.wordsPush(h.constants, base)
        heap.wordsPush(h.constants, words)
    end
end

--- Adds a task whose frames are roots; `windows` gives each function's
--- value-window words (its registers and one).
export function addTask(h: heap.Heap*, task: Task*): nil
    @unsafe heap.wordsPush(h.tasks, native.address(task as voidptr))
end

export function setWindows(h: heap.Heap*, windows: uint64): nil
    @unsafe h.windows = windows
end

--- A registered handle (4.7): a root until released, answering its index.
export function handleRegister(h: heap.Heap*, value: uint64): uint64
    @unsafe do
        local index = heap.wordsPop(h.handleFree)
        if index == 0 then
            heap.wordsPush(h.handles, value)
            return h.handles.count
        end
        heap.setWordAt(h.handles, index - 1, value)
        return index
    end
end

export function handleValue(h: heap.Heap*, index: uint64): uint64
    @unsafe do
        return heap.wordAt(h.handles, index - 1)
    end
end

export function handleRelease(h: heap.Heap*, index: uint64): nil
    @unsafe do
        heap.setWordAt(h.handles, index - 1, values.NIL)
        heap.wordsPush(h.handleFree, index)
    end
end

--- Opens a handle scope (4.7), answering the mark `scopeClose` returns to;
--- a value pushed into it is a root until then.
export function scopeOpen(h: heap.Heap*): uint64
    @unsafe do
        return h.scope.count
    end
end

export function scopePush(h: heap.Heap*, value: uint64): nil
    @unsafe heap.wordsPush(h.scope, value)
end

export function scopeClose(h: heap.Heap*, mark: uint64): nil
    @unsafe h.scope.count = mark
end

-- ---- marking -----------------------------------------------------------------------

--- Grays a white object (the one marking step every path shares).
export function shade(h: heap.Heap*, value: uint64): nil
    marking.shadeValue(h, value)
end

--- A child reached by a walk: grayed when marking, pushed onto `stack` for
--- the oracle.
local function visit(h: heap.Heap*, value: uint64, stack: heap.Words*?): nil
    @unsafe do
        if stack == nil then
            shade(h, value)
        elseif value & values.TAG_MASK == values.TAG_OBJ then
            heap.wordsPush(stack, value)
        end
    end
end

--- Grays a root candidate when it addresses a live slot (5.1).
local function shadeRoot(h: heap.Heap*, value: uint64): nil
    @unsafe h.stats.rootCandidates = h.stats.rootCandidates + marking.rootCandidate(h, value)
end

--- A root word for the oracle: pushed when it addresses a live slot.
local function rootFor(h: heap.Heap*, value: uint64, stack: heap.Words*?): nil
    @unsafe do
        if stack == nil then
            shadeRoot(h, value)
        elseif value & values.TAG_MASK == values.TAG_OBJ and heap.isLiveSlot(h, value & values.PAYLOAD) then
            heap.wordsPush(stack, value)
        end
    end
end

--- Visits every child in the canonical object order.
export function eachChild(h: heap.Heap*, o: heap.Header*, stack: heap.Words*?): nil
    @unsafe do
        local state = childwalk.Cursor(0ULL, 0ULL, values.NIL)
        local cursor = state as childwalk.Cursor*
        while childwalk.childNext(o, cursor) ~= 0ULL do
            if childwalk.candidate(o, cursor) then
                rootFor(h, cursor.value, stack)
            else
                visit(h, cursor.value, stack)
            end
        end
    end
end

--- Scans a gray object: its children grayed, itself black. A table under a
--- weak mode keeps only the entries that will survive (`gcweak`); in a minor
--- collection its old referents survive with it.
local function scanObject(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        h.stats.scanned = h.stats.scanned + 1
        if o.kind as uint64 == heap.KIND_TABLE and (o.aux as uint64) & weak.WEAK_MODES ~= 0 then
            local mode = (o.aux as uint64) & weak.WEAK_MODES
            if h.minor ~= 0ULL then
                mode = mode | weak.WEAK_MINOR
            end
            weak.weakCycleScan(h, o, mode)
        else
            marking.scanStrong(h, o)
        end
    end
end

local function rootRun(h: heap.Heap*, base: uint64, count: uint64, stack: heap.Words*?): nil
    @unsafe do
        local i: uint64 = 0
        while i < count do
            rootFor(h, native.load64(native.pointer(base), native.index(i * 8)), stack)
            i = i + 1
        end
    end
end

--- The live words of a frame stack in chunks, from its first chunk `first`.
--- The chunk above the one holding the top frame is kept for the next call;
--- those past it, which a deeper recursion left, are given back.
local function rootChain(h: heap.Heap*, first: uint64, stack: heap.Words*?): nil
    @unsafe do
        local current = first
        local chunk = first
        while chunk ~= 0ULL do
            local base = native.load64(native.pointer(chunk), 0)
            local cursor = native.load64(native.pointer(chunk), 16)
            if base ~= 0ULL and cursor > base then
                rootRun(h, base, (cursor - base) // 8ULL, stack)
            elseif chunk ~= first then
                break
            end
            current = chunk
            chunk = heap.chunkAbove(chunk)
        end
        local spare = heap.chunkAbove(current)
        if spare ~= 0ULL then
            local past = heap.chunkAbove(spare)
            if past ~= 0ULL then
                native.store64(native.pointer(spare), heap.STACK_ABOVE, 0ULL)
                heap.releaseChunks(past)
            end
        end
    end
end

--- Each (base, words) pair of a range vector; a frame stack's live words.
local function rootRanges(h: heap.Heap*, ranges: heap.Words*, stack: heap.Words*?): nil
    @unsafe do
        local i: uint64 = 0
        while i < ranges.count do
            local base = heap.wordAt(ranges, i)
            local words = heap.wordAt(ranges, i + 1)
            if words == SEGMENT then
                local first = native.load64(native.pointer(base), 0)
                local cursor = native.load64(native.pointer(base), 16)
                if first ~= 0 and cursor > first then
                    rootRun(h, first, (cursor - first) // 8, stack)
                end
            elseif words == CHAIN then
                rootChain(h, base, stack)
            else
                rootRun(h, base, words, stack)
            end
            i = i + 2
        end
    end
end

--- A task's frames (5.1), from the top frame down the caller chain: each
--- frame's value window, its closure (header word 2), and the varargs that
--- lie just below its header (their count in header word 3 from bit 49).
local function rootFrames(h: heap.Heap*, task: Task*, stack: heap.Words*?): nil
    @unsafe do
        if task.top == NO_FRAME then
            return
        end
        local words = task.stack
        local s = task.top
        while true do
            local frame = words + s * 8
            local h0 = native.load64(native.pointer(frame), 0)
            local window = native.load64(native.pointer(h.windows), native.index((h0 & values.LOW_WORD) * 8))
            rootRun(h, frame + 32, window, stack)
            rootFor(h, native.load64(native.pointer(frame), 16), stack)
            local varargs = native.load64(native.pointer(frame), 24) >> 49
            rootRun(h, frame - varargs * 8, varargs, stack)
            local caller = native.load64(native.pointer(frame), 8) & values.LOW_WORD
            if caller == NO_CALLER then
                break
            end
            s = caller
        end
    end
end

--- Walks every root; `constants` adds the immutable ranges, which a rescan
--- leaves out (4.6).
local function walkRoots(h: heap.Heap*, constants: boolean, stack: heap.Words*?): nil
    @unsafe do
        h.stats.rootWalks = h.stats.rootWalks + 1
        rootRanges(h, h.ranges, stack)
        rootRun(h, h.handles.base, h.handles.count, stack)
        rootRun(h, h.scope.base, h.scope.count, stack)
        local i: uint64 = 0
        while i < h.tasks.count do
            rootFrames(h, native.pointer(heap.wordAt(h.tasks, i)) as Task*, stack)
            i = i + 1
        end
        if constants then
            rootRanges(h, h.constants, stack)
        end
    end
end

-- ---- generations -------------------------------------------------------------------

local function flagsof(o: heap.Header*): uint64
    @unsafe do
        return o.flags as uint64
    end
end

local function setflags(o: heap.Header*, flags: uint64): nil
    @unsafe o.flags = flags
end

--- The header of an object value, or zero for any other value.
local function objectof(value: uint64): uint64
    if value & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end

    return value & values.PAYLOAD
end

--- Whether a value is a young object.
local function young(value: uint64): boolean
    local address = objectof(value)
    if address == 0ULL then
        return false
    end

    @unsafe do
        return flagsof(native.pointer(address) as heap.Header*) & heap.F_OLD == 0ULL
    end
end

--- Whether a value is an object no minor collection has passed yet: one
--- that is still young after the next.
local function fresh(value: uint64): boolean
    local address = objectof(value)
    if address == 0ULL then
        return false
    end

    @unsafe do
        return flagsof(native.pointer(address) as heap.Header*) & (heap.F_OLD | heap.F_SURVIVAL) == 0ULL
    end
end

--- Lists an old object that may hold a young one, once.
export function remember(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        if flagsof(o) & heap.F_TOUCHED ~= 0ULL then
            return
        end
        setflags(o, flagsof(o) | heap.F_TOUCHED)
        heap.wordsPush(h.remembered, native.address(o as voidptr))
        h.stats.remembers = h.stats.remembers + 1ULL
    end
end

--- Whether a store into `o` is one generations record: they are kept, and
--- `o` is old and not frozen.
local function recording(h: heap.Heap*, o: heap.Header*): boolean
    @unsafe do
        return h.generational ~= 0ULL and flagsof(o) & (heap.F_OLD | heap.F_FROZEN) == heap.F_OLD
    end
end

local function tableof(o: heap.Header*): heap.TableBody*
    @unsafe do
        return native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES) as heap.TableBody*
    end
end

--- Words of card bits over `slots` slots.
local function bitwords(slots: uint64): uint64
    return (slots + CARD_SLOTS * 64ULL - 1ULL) // (CARD_SLOTS * 64ULL)
end

--- Whether a table carries cards: a large one, not weak, whose entries a
--- minor collection may read strongly.
local function cardable(o: heap.Header*): boolean
    @unsafe do
        if o.kind as uint64 ~= heap.KIND_TABLE or (o.aux as uint64) & weak.WEAK_MODES ~= 0ULL then
            return false
        end
        local t = tableof(o)
        return t.arrayCap + t.hashCap >= CARD_MINIMUM
    end
end

local function bitword(base: uint64, i: uint64): uint64
    return native.load64(native.pointer(base), native.index(i * 8ULL))
end

local function setbitword(base: uint64, i: uint64, bits: uint64): nil
    native.store64(native.pointer(base), native.index(i * 8ULL), bits)
end

--- `words` words of zeroed card bits, or zero when there is no room.
local function takebits(h: heap.Heap*, words: uint64): uint64
    local base = backing.wordBackingTake(h, words)
    if base == 0ULL then
        return 0ULL
    end
    local i: uint64 = 0ULL
    while i < words do
        setbitword(base, i, 0ULL)
        i = i + 1ULL
    end

    return base
end

--- Lays a card record's bits out again over `arraywords` and `hashwords`
--- words, keeping the array part's bits; the hash part's are kept too, or
--- with `rehashed` all set, since its entries moved. Answers false, the
--- record as it was, when there is no room.
local function relay(h: heap.Heap*, r: uint64, arraywords: uint64, hashwords: uint64, rehashed: boolean): boolean
    @unsafe do
        local cards = h.cards
        local old = heap.wordAt(cards, r + 1ULL)
        local oldarray = heap.wordAt(cards, r + 2ULL)
        local oldhash = heap.wordAt(cards, r + 3ULL)
        local bits = takebits(h, arraywords + hashwords)
        if bits == 0ULL then
            return false
        end
        local i: uint64 = 0ULL
        while i < oldarray and i < arraywords do
            setbitword(bits, i, bitword(old, i))
            i = i + 1ULL
        end
        i = 0ULL
        while i < hashwords do
            if rehashed then
                setbitword(bits, arraywords + i, 0xffffffffffffffffULL)
            elseif i < oldhash then
                setbitword(bits, arraywords + i, bitword(old, oldarray + i))
            end
            i = i + 1ULL
        end
        backing.wordBackingRelease(old)
        heap.setWordAt(cards, r + 1ULL, bits)
        heap.setWordAt(cards, r + 2ULL, arraywords)
        heap.setWordAt(cards, r + 3ULL, hashwords)
        return true
    end
end

--- The offset of table `o`'s card record in `h.cards`, made when it has
--- none, or NONE when there is no room for one.
local function cardrecord(h: heap.Heap*, o: heap.Header*): uint64
    @unsafe do
        local address = native.address(o as voidptr)
        if flagsof(o) & heap.F_CARDS ~= 0ULL then
            local index = (o.aux as uint64) >> 8ULL
            if index ~= 0ULL then
                local at = (index - 1ULL) * 6ULL
                if at < h.cards.count and heap.wordAt(h.cards, at) == address then
                    return at
                end
            end
            return NONE
        end
        local t = tableof(o)
        local arraywords = bitwords(t.arrayCap)
        local hashwords = bitwords(t.hashCap)
        local r: uint64 = 0ULL
        if h.cardfree.count > 0ULL then
            r = heap.wordsPop(h.cardfree)
        else
            r = h.cards.count
            -- Its index, from one, is kept above aux's low byte.
            if r // 6ULL >= 0xffffffULL then
                return NONE
            end
            local k: uint64 = 0ULL
            while k < 6ULL do
                heap.wordsPush(h.cards, 0ULL)
                k = k + 1ULL
            end
        end
        local bits = takebits(h, arraywords + hashwords)
        if bits == 0ULL then
            heap.wordsPush(h.cardfree, r)
            return NONE
        end
        heap.setWordAt(h.cards, r, address)
        heap.setWordAt(h.cards, r + 1ULL, bits)
        heap.setWordAt(h.cards, r + 2ULL, arraywords)
        heap.setWordAt(h.cards, r + 3ULL, hashwords)
        heap.setWordAt(h.cards, r + 4ULL, t.hashPtr)
        heap.setWordAt(h.cards, r + 5ULL, t.hashCap)
        o.aux = ((o.aux as uint64) & 0xffULL) | ((r // 6ULL + 1ULL) << 8ULL)
        setflags(o, flagsof(o) | heap.F_CARDS)
        return r
    end
end

--- Takes a rehash of the table's hash part into its card record: its
--- entries moved, so every hash card is dirty. Answers false when the bits
--- cannot be laid out again.
local function synchash(h: heap.Heap*, r: uint64, o: heap.Header*): boolean
    @unsafe do
        local t = tableof(o)
        if heap.wordAt(h.cards, r + 4ULL) == t.hashPtr and heap.wordAt(h.cards, r + 5ULL) == t.hashCap then
            return true
        end
        if not relay(h, r, heap.wordAt(h.cards, r + 2ULL), bitwords(t.hashCap), true) then
            return false
        end
        heap.setWordAt(h.cards, r + 4ULL, t.hashPtr)
        heap.setWordAt(h.cards, r + 5ULL, t.hashCap)
        return true
    end
end

local function setbit(base: uint64, bit: uint64): nil
    local word = bit >> 6ULL
    setbitword(base, word, bitword(base, word) | (1ULL << (bit & 63ULL)))
end

--- Marks the card over array slot `i` (from 0). False when there is no room.
local function markarray(h: heap.Heap*, r: uint64, i: uint64): boolean
    @unsafe do
        local card = i // CARD_SLOTS
        local arraywords = heap.wordAt(h.cards, r + 2ULL)
        if card >> 6ULL >= arraywords then
            local wanted = arraywords * 2ULL
            if wanted <= card >> 6ULL then
                wanted = (card >> 6ULL) + 1ULL
            end
            if not relay(h, r, wanted, heap.wordAt(h.cards, r + 3ULL), false) then
                return false
            end
        end
        setbit(heap.wordAt(h.cards, r + 1ULL), card)
        h.stats.cardmarks = h.stats.cardmarks + 1ULL
        return true
    end
end

--- Marks the card over hash bucket `bucket`. False when there is no room.
local function markhash(h: heap.Heap*, r: uint64, o: heap.Header*, bucket: uint64): boolean
    @unsafe do
        if not synchash(h, r, o) then
            return false
        end
        local card = bucket // CARD_SLOTS
        if card >> 6ULL >= heap.wordAt(h.cards, r + 3ULL) then
            return false
        end
        setbit(heap.wordAt(h.cards, r + 1ULL), heap.wordAt(h.cards, r + 2ULL) * 64ULL + card)
        h.stats.cardmarks = h.stats.cardmarks + 1ULL
        return true
    end
end

--- Records that array slot `i` of old table `o` holds a young value: by
--- its card, or when the table carries none by remembering it whole.
local function arraycard(h: heap.Heap*, o: heap.Header*, i: uint64): nil
    if cardable(o) then
        local r = cardrecord(h, o)
        if r ~= NONE and markarray(h, r, i) then
            return
        end
    end
    remember(h, o)
end

--- Lets go of a table's card record, before the sweep frees the table.
local function cardsrelease(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        if flagsof(o) & heap.F_CARDS == 0ULL then
            return
        end
        local index = (o.aux as uint64) >> 8ULL
        if index ~= 0ULL then
            local r = (index - 1ULL) * 6ULL
            if r < h.cards.count and heap.wordAt(h.cards, r) == native.address(o as voidptr) then
                backing.wordBackingRelease(heap.wordAt(h.cards, r + 1ULL))
                local k: uint64 = 0ULL
                while k < 6ULL do
                    heap.setWordAt(h.cards, r + k, 0ULL)
                    k = k + 1ULL
                end
                heap.wordsPush(h.cardfree, r)
            end
        end
        o.aux = (o.aux as uint64) & 0xffULL
        setflags(o, flagsof(o) & ~heap.F_CARDS)
    end
end

--- After a full collection: the young list drops the dead and repeats (a
--- freed slot taken again is listed again), the remembered list the dead,
--- and the next full collection waits for what lives now to double.
local function afterfull(h: heap.Heap*): nil
    @unsafe do
        local list = h.young
        local kept: uint64 = 0ULL
        local i: uint64 = 0ULL
        while i < list.count do
            local address = heap.wordAt(list, i)
            if heap.isLiveSlot(h, address) then
                local o = native.pointer(address) as heap.Header*
                if flagsof(o) & (heap.F_OLD | heap.F_LISTED) == 0ULL then
                    setflags(o, flagsof(o) | heap.F_LISTED)
                    heap.setWordAt(list, kept, address)
                    kept = kept + 1ULL
                end
            end
            i = i + 1ULL
        end
        list.count = kept
        i = 0ULL
        while i < kept do
            local o = native.pointer(heap.wordAt(list, i)) as heap.Header*
            setflags(o, flagsof(o) & ~heap.F_LISTED)
            i = i + 1ULL
        end
        list = h.remembered
        kept = 0ULL
        i = 0ULL
        while i < list.count do
            local address = heap.wordAt(list, i)
            if heap.isLiveSlot(h, address)
                and flagsof(native.pointer(address) as heap.Header*) & heap.F_TOUCHED ~= 0ULL
            then
                heap.setWordAt(list, kept, address)
                kept = kept + 1ULL
            end
            i = i + 1ULL
        end
        list.count = kept
        h.genbase = h.liveBytes
        if h.genbase < 1048576ULL then
            h.genbase = 1048576ULL
        end
        h.sincefull = 0ULL
    end
end

-- ---- the barrier -------------------------------------------------------------------

--- The insertion barrier (4.2): storing a white child into a black parent
--- while marking grays the child. Every heap store runs it; outside a
--- cycle it is one load and a branch. With generations an old object taking
--- a young child is remembered (Decision 20).
export function barrier(h: heap.Heap*, parent: heap.Header*, child: uint64): nil
    marking.insertionBarrier(h, parent, child)
    if recording(h, parent) and young(child) then
        remember(h, parent)
    end
end

--- The insertion barrier alone, before a table store whose slot the
--- generational record (`arraystore`, `arrayrange`, `hashstore`) names
--- after it.
export function insertion(h: heap.Heap*, parent: heap.Header*, child: uint64): nil
    marking.insertionBarrier(h, parent, child)
end

--- After `value` is stored at array slot `i` (from 0) of table `o`.
export function arraystore(h: heap.Heap*, o: heap.Header*, i: uint64, value: uint64): nil
    if recording(h, o) and young(value) then
        arraycard(h, o, i)
    end
end

--- After the array part of table `o` took slots `first` up to `last`
--- (from 0), as when it grows over keys its hash part held.
export function arrayrange(h: heap.Heap*, o: heap.Header*, first: uint64, last: uint64): nil
    if not recording(h, o) then
        return
    end
    @unsafe do
        local t = tableof(o)
        local i = first
        while i < last and i < t.arrayLen do
            if young(native.load64(native.pointer(t.arrayPtr), native.index(i * 8ULL))) then
                arraycard(h, o, i)
            end
            i = i + 1ULL
        end
    end
end

--- After `key` and `value` are stored in the hash part of table `o`.
export function hashstore(h: heap.Heap*, o: heap.Header*, key: uint64, value: uint64): nil
    if not recording(h, o) or not (young(key) or young(value)) then
        return
    end
    if cardable(o) then
        local r = cardrecord(h, o)
        if r ~= NONE then
            @unsafe do
                local t = tableof(o)
                local bucket = objecttable.tableProbe(native.pointer(t.hashPtr), t.hashCap, t.hashMask, key)
                if bucket ~= NONE and markhash(h, r, o, bucket) then
                    return
                end
            end
        end
    end
    remember(h, o)
end

--- Freezes a table (Decision 20): it is old from now on and never written
--- again, so no store into it is recorded. The minor collections that
--- follow still trace the young objects it holds as it freezes.
export function freeze(h: heap.Heap*, o: heap.Header*): nil
    setflags(o, (flagsof(o) & ~heap.F_SURVIVAL) | heap.F_OLD | heap.F_FROZEN)
    @unsafe do
        if h.generational ~= 0ULL then
            remember(h, o)
        end
    end
end

--- An object whose words changed without the barrier, as a coroutine's
--- frames do while it runs: while marking, a black one is gray again, so
--- its words are scanned once more.
export function rescan(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        if h.marking as uint64 ~= 0 and o.color as uint64 == heap.COLOR_BLACK then
            heap.grayPush(h, o)
            o.color = heap.COLOR_GRAY
        end
    end
end

--- After a constructor has written an object's initial references (4.3a):
--- an object allocated black while marking grays its white children, as a
--- later store would through the barrier.
export function initialized(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        if h.phase == heap.PHASE_MARKING then
            eachChild(h, o, nil)
        end
    end
end

-- ---- cycles
-- --------------------------------------------------------------------------

--- Starts a cycle: marking from every root, constants included.
export function startCycle(h: heap.Heap*): nil
    @unsafe do
        h.phase = heap.PHASE_MARKING
        h.marking = 1
        h.stats.cycles = h.stats.cycles + 1
        weak.weakCycleReset(h)
        walkRoots(h, true, nil)
    end
end

--- Frees a white object: its memory goes back to the allocator, or, when
--- it owns something outside its slot, onto the released list (`gcweak`).
local function freeObject(h: heap.Heap*, o: heap.Header*): nil
    cardsrelease(h, o)
    @unsafe weak.release(h, o)
end

--- Sweeps up to `work` objects; answers whether the sweep finished.
local function sweepSome(h: heap.Heap*, work: uint64): boolean
    @unsafe do
        local state = objectwalk.Cursor(0ULL, 0ULL, 0ULL, 0ULL, 0ULL, 0ULL)
        local result = state as objectwalk.Cursor*
        local left = work
        while left > 0ULL do
            local action = objectwalk.sweepNext(h, result)
            if action == 0ULL then
                break
            end
            h.stats.swept = h.stats.swept + 1ULL
            if action == 1ULL then
                freeObject(h, native.pointer(result.header) as heap.Header*)
            end
            left = left - 1ULL
        end
        return objectwalk.sweepFinished(h) ~= 0ULL
    end
end

--- Marks with up to `budget` gray objects (4.6): when none remain the
--- mutable roots are rescanned, and when that grays nothing marking ends and
--- the sweep is set at the first slot. Answers the budget left.
local function markSome(h: heap.Heap*, budget: uint64): uint64
    @unsafe do
        local left = budget
        while true do
            while left > 0 do
                local gray = heap.grayPop(h)
                if gray == 0 then
                    break
                end
                scanObject(h, native.pointer(gray) as heap.Header*)
                left = left - 1
            end
            if left == 0 then
                return 0
            end
            walkRoots(h, false, nil)
            if heap.grayEmpty(h) and not weak.propagate(h) then
                break
            end
        end
        weak.clear(h)
        h.phase = heap.PHASE_SWEEPING
        h.marking = 0
        objectwalk.sweepBegin(h, h.stats.cycles)
        return left
    end
end

--- Sweeps with up to `work` objects; when the sweep is done the cycle ends
--- and the next threshold is twice what survived (4.10).
local function sweepPart(h: heap.Heap*, work: uint64): nil
    @unsafe do
        if sweepSome(h, work) then
            heap.compactLarge(h)
            h.phase = heap.PHASE_IDLE
            if h.liveBytes > h.stats.peakLive then
                h.stats.peakLive = h.liveBytes
            end
            h.threshold = h.liveBytes * 2
            if h.threshold < 1048576 then
                h.threshold = 1048576
            end
            afterfull(h)
        end
    end
end

--- One increment of work (`Heap::step`): marking drains up to `budget` gray
--- objects and, once it ends, sweeping frees or whitens up to four times
--- what is left of it.
export function step(h: heap.Heap*, budget: uint64): nil
    @unsafe do
        h.stats.steps = h.stats.steps + 1
        local left = budget
        if h.phase == heap.PHASE_MARKING then
            left = markSome(h, left)
            if h.phase == heap.PHASE_MARKING then
                return
            end
        end
        if h.phase == heap.PHASE_SWEEPING then
            local work = left * 4
            if left > UNBOUNDED // 4 then
                work = UNBOUNDED
            end
            sweepPart(h, work)
        end
    end
end

--- Starts a cycle and marks to its end, leaving the sweep to `sweepAll`:
--- between the two, colors say what the cycle frees.
export function markAll(h: heap.Heap*): nil
    @unsafe do
        startCycle(h)
        markSome(h, UNBOUNDED)
    end
end

--- Sweeps to the end of the cycle `markAll` marked.
export function sweepAll(h: heap.Heap*): nil
    @unsafe do
        while h.phase == heap.PHASE_SWEEPING do
            sweepPart(h, UNBOUNDED)
        end
    end
end

--- Finishes a cycle in progress, then runs one whole cycle from the current
--- roots, so an explicit collection also frees floating garbage.
export function fullCycle(h: heap.Heap*): nil
    @unsafe do
        while h.phase ~= heap.PHASE_IDLE do
            step(h, UNBOUNDED)
        end
        startCycle(h)
        while h.phase ~= heap.PHASE_IDLE do
            step(h, UNBOUNDED)
        end
        h.debt = 0
    end
end

-- ---- minor collections
-- ---------------------------------------------------------------

--- Scans a remembered old object for the young ones it holds, leaving it
--- unmarked: a minor collection never sweeps it.
local function rememberscan(h: heap.Heap*, o: heap.Header*): nil
    @unsafe do
        if o.kind as uint64 == heap.KIND_TABLE and (o.aux as uint64) & weak.WEAK_MODES ~= 0ULL then
            weak.weakCycleScan(h, o, ((o.aux as uint64) & weak.WEAK_MODES) | weak.WEAK_MINOR)
        else
            marking.scanStrong(h, o)
        end
        o.color = heap.COLOR_WHITE
    end
end

--- Whether an object holds one no minor collection has passed, which the
--- next minor collection still has to reach through it.
local function holdsfresh(o: heap.Header*): boolean
    @unsafe do
        local state = childwalk.Cursor(0ULL, 0ULL, values.NIL)
        local cursor = state as childwalk.Cursor*
        while childwalk.childNext(o, cursor) ~= 0ULL do
            if fresh(cursor.value) then
                return true
            end
        end
        return false
    end
end

--- After marking, the remembered list keeps an object only while it holds
--- a fresh one (as Lua 5.4's touched objects stay gray for two cycles), and
--- an old thread always, since its frames change without the barrier.
local function rememberkeep(h: heap.Heap*): nil
    @unsafe do
        local list = h.remembered
        local kept: uint64 = 0ULL
        local i: uint64 = 0ULL
        while i < list.count do
            local address = heap.wordAt(list, i)
            local o = native.pointer(address) as heap.Header*
            if o.kind as uint64 == heap.KIND_THREAD or holdsfresh(o) then
                heap.setWordAt(list, kept, address)
                kept = kept + 1ULL
            else
                setflags(o, flagsof(o) & ~heap.F_TOUCHED)
            end
            i = i + 1ULL
        end
        list.count = kept
    end
end

--- The array slots of card `card`: shaded when `scan`, else whether one of
--- them holds a fresh object.
local function arrayslots(h: heap.Heap*, t: heap.TableBody*, card: uint64, scan: boolean): boolean
    @unsafe do
        local i = card * CARD_SLOTS
        local last = i + CARD_SLOTS
        if last > t.arrayLen then
            last = t.arrayLen
        end
        while i < last do
            local value = native.load64(native.pointer(t.arrayPtr), native.index(i * 8ULL))
            if scan then
                marking.shadeValue(h, value)
            elseif fresh(value) then
                return true
            end
            i = i + 1ULL
        end
        return false
    end
end

--- The hash buckets of card `card`, as `arrayslots`; a removed entry, its
--- value nil, holds nothing.
local function hashslots(h: heap.Heap*, t: heap.TableBody*, card: uint64, scan: boolean): boolean
    @unsafe do
        if t.hashPtr == 0ULL then
            return false
        end
        local b = card * CARD_SLOTS
        local last = b + CARD_SLOTS
        if last > t.hashCap then
            last = t.hashCap
        end
        while b < last do
            local key = native.load64(native.pointer(t.hashPtr), native.index(b * 16ULL))
            local value = native.load64(native.pointer(t.hashPtr), native.index(b * 16ULL + 8ULL))
            if key ~= values.NIL and value ~= values.NIL then
                if scan then
                    marking.shadeValue(h, key)
                    marking.shadeValue(h, value)
                elseif fresh(key) or fresh(value) then
                    return true
                end
            end
            b = b + 1ULL
        end
        return false
    end
end

--- Each dirty card of the record at `r`: its slots shaded when `scan`,
--- else kept dirty only while one of them holds a fresh object.
local function cardwalk(h: heap.Heap*, r: uint64, scan: boolean): nil
    @unsafe do
        local t = tableof(native.pointer(heap.wordAt(h.cards, r)) as heap.Header*)
        local bits = heap.wordAt(h.cards, r + 1ULL)
        local arraywords = heap.wordAt(h.cards, r + 2ULL)
        local words = arraywords + heap.wordAt(h.cards, r + 3ULL)
        local w: uint64 = 0ULL
        while w < words do
            local word = bitword(bits, w)
            if word ~= 0ULL then
                local b: uint64 = 0ULL
                while b < 64ULL do
                    local bit = 1ULL << b
                    if word & bit ~= 0ULL then
                        local holds: boolean = false
                        if w < arraywords then
                            holds = arrayslots(h, t, w * 64ULL + b, scan)
                        else
                            holds = hashslots(h, t, (w - arraywords) * 64ULL + b, scan)
                        end
                        if not scan and not holds then
                            word = word & ~bit
                        end
                    end
                    b = b + 1ULL
                end
                if not scan then
                    setbitword(bits, w, word)
                end
            end
            w = w + 1ULL
        end
    end
end

--- Shades what the dirty cards of every carded table hold. A table whose
--- bits cannot follow its rehash is scanned whole and remembered instead.
local function cardscan(h: heap.Heap*): nil
    @unsafe do
        local r: uint64 = 0ULL
        while r < h.cards.count do
            local address = heap.wordAt(h.cards, r)
            if address ~= 0ULL then
                local o = native.pointer(address) as heap.Header*
                if synchash(h, r, o) then
                    cardwalk(h, r, true)
                else
                    remember(h, o)
                end
            end
            r = r + 6ULL
        end
    end
end

--- After marking, each card stays dirty only while it holds a fresh object.
local function cardkeep(h: heap.Heap*): nil
    @unsafe do
        local r: uint64 = 0ULL
        while r < h.cards.count do
            if heap.wordAt(h.cards, r) ~= 0ULL then
                cardwalk(h, r, false)
            end
            r = r + 6ULL
        end
    end
end

--- Sweeps the young list: an unmarked object is freed, a marked one
--- survives, and one surviving its second minor collection is promoted and
--- remembered, as the young it holds are not yet old.
local function sweepyoung(h: heap.Heap*): nil
    @unsafe do
        local list = h.young
        local kept: uint64 = 0ULL
        local i: uint64 = 0ULL
        while i < list.count do
            local address = heap.wordAt(list, i)
            local o = native.pointer(address) as heap.Header*
            local flags = flagsof(o)
            if flags & heap.F_OLD ~= 0ULL then
                -- Frozen while young: no longer this list's.
                i = i + 1ULL
            elseif o.color as uint64 == heap.COLOR_WHITE then
                h.stats.swept = h.stats.swept + 1ULL
                freeObject(h, o)
                i = i + 1ULL
            else
                o.color = heap.COLOR_WHITE
                if flags & heap.F_SURVIVAL ~= 0ULL then
                    setflags(o, (flags & ~heap.F_SURVIVAL) | heap.F_OLD)
                    h.stats.promoted = h.stats.promoted + 1ULL
                    remember(h, o)
                else
                    setflags(o, flags | heap.F_SURVIVAL)
                    heap.setWordAt(list, kept, address)
                    kept = kept + 1ULL
                end
                i = i + 1ULL
            end
        end
        list.count = kept
    end
end

--- A minor collection (Decision 20), whole: the young objects the roots,
--- the remembered objects and the dirty cards reach are marked, weak
--- entries naming dead young objects are cleared, and the young list is
--- swept. It runs only between full cycles.
export function minorcycle(h: heap.Heap*): nil
    @unsafe do
        if h.generational == 0ULL or h.phase ~= heap.PHASE_IDLE then
            return
        end
        h.stats.minors = h.stats.minors + 1ULL
        h.sincefull = h.sincefull + 1ULL
        h.minor = 1ULL
        weak.weakCycleReset(h)
        walkRoots(h, true, nil)
        cardscan(h)
        local i: uint64 = 0ULL
        while i < h.remembered.count do
            rememberscan(h, native.pointer(heap.wordAt(h.remembered, i)) as heap.Header*)
            i = i + 1ULL
        end
        while true do
            local gray = heap.grayPop(h)
            if gray ~= 0ULL then
                scanObject(h, native.pointer(gray) as heap.Header*)
            elseif not weak.propagate(h) then
                break
            end
        end
        weak.clear(h)
        rememberkeep(h)
        cardkeep(h)
        sweepyoung(h)
        h.minor = 0ULL
    end
end

-- ---- the oracle
-- -----------------------------------------------------------------------

--- Recomputes reachability from every root without touching colors and
--- compares it with the heap (`check_oracle_with`): a reachable object must
--- not be freed, and when `exact`, every live object must be reachable.
--- Answers the number of disagreements, which also accumulate in the heap.
export function checkOracle(h: heap.Heap*, exact: boolean): uint64
    @unsafe do
        local stack = h.oracleStack
        local failures: uint64 = 0
        heap.setClear(h.seen)
        stack.count = 0
        walkRoots(h, true, stack)
        while stack.count > 0 do
            local value = heap.wordsPop(stack)
            local address = value & values.PAYLOAD
            if not heap.setHas(h.seen, address) then
                heap.setAdd(h.seen, address)
                local o = native.pointer(address) as heap.Header*
                if o.kind as uint64 == heap.KIND_FREED then
                    failures = failures + 1
                else
                    eachChild(h, o, stack)
                end
            end
        end
        if exact then
            local i: uint64 = 0
            while i < h.chunks.count do
                local base = heap.wordAt(h.chunks, i)
                local slot = (native.pointer(base) as heap.ChunkHeader*).slotSize as uint64
                local used = heap.chunkUsed(h, base)
                local k: uint64 = 0
                while k < used do
                    local address = base + heap.CHUNK_HEADER_BYTES + k * slot
                    local o = native.pointer(address) as heap.Header*
                    if o.kind as uint64 ~= heap.KIND_FREED and not heap.setHas(h.seen, address) then
                        failures = failures + 1
                    end
                    k = k + 1
                end
                i = i + 1
            end
            i = 0
            while i < h.large.count do
                local address = heap.wordAt(h.large, i)
                if address ~= 0 then
                    local o = native.pointer(address) as heap.Header*
                    if o.kind as uint64 ~= heap.KIND_FREED and not heap.setHas(h.seen, address) then
                        failures = failures + 1
                    end
                end
                i = i + 1
            end
        end
        h.oracleFailures = h.oracleFailures + failures
        return failures
    end
end

-- ---- safepoints
-- ------------------------------------------------------------------------

--- Where collection may run (4.4): pays allocation debt with marking or
--- sweeping work; under stress a whole cycle every time; interleaved, one
--- small step, with the oracle at every cycle's end (4.8: safety after the
--- incremental cycle, exactness after the atomic one that follows).
---
--- With generations (Decision 20) stress runs a minor collection every time
--- and a whole cycle after every `STRESS_MINORS` of them; interleaved,
--- `INTERLEAVED_MINORS` minor collections come before each incremental
--- cycle, the oracle checking safety after each. Otherwise, as Lua 5.4's
--- generational mode is paced, a minor collection runs once allocation
--- reaches a fifth of what lived after the last full collection, and a full
--- one, whole, once what lives has doubled since.
export function safepoint(h: heap.Heap*): nil
    @unsafe do
        if not h.automatic then
            return
        end
        if h.stress then
            if h.generational ~= 0ULL and h.phase == heap.PHASE_IDLE and h.sincefull < STRESS_MINORS then
                minorcycle(h)
                if h.oracle then
                    checkOracle(h, false)
                end
                return
            end
            fullCycle(h)
            if h.oracle then
                checkOracle(h, true)
            end
            return
        end
        if h.interleave then
            if h.phase == heap.PHASE_IDLE then
                if h.generational ~= 0ULL and h.sincefull < INTERLEAVED_MINORS then
                    minorcycle(h)
                    if h.oracle then
                        checkOracle(h, false)
                    end
                    return
                end
                startCycle(h)
            end
            step(h, 2)
            if h.phase == heap.PHASE_IDLE and h.oracle then
                checkOracle(h, false)
                fullCycle(h)
                checkOracle(h, true)
            end
            return
        end
        if h.generational ~= 0ULL and h.phase == heap.PHASE_IDLE then
            local allowance = h.genbase // 5ULL
            if allowance < MINOR_FLOOR then
                allowance = MINOR_FLOOR
            end
            if h.debt < allowance then
                return
            end
            minorcycle(h)
            h.debt = 0
            if h.liveBytes > h.genbase * 2ULL then
                fullCycle(h)
            end
            return
        end
        if h.phase == heap.PHASE_IDLE then
            if h.debt < h.threshold then
                return
            end
            startCycle(h)
        end
        local budget = h.debt // 64
        if budget < 256 then
            budget = 256
        end
        step(h, budget)
        h.debt = 0
    end
end

--- Allocates an object at a safepoint: the collector may run first, so
--- every value the caller still needs must be reachable from the roots.
export function allocate(h: heap.Heap*, kind: uint64, inlineBytes: uint64): heap.Header*
    @unsafe do
        safepoint(h)
        return heap.allocRaw(h, kind, inlineBytes)
    end
end
