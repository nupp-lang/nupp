module nupp.runtime.vm.calls

-- Calls, returns, result padding and the frame driver: the frame-transition
-- protocol in Nupp. A function starting, or one with vector instructions
-- resuming anywhere, goes to its compiled frame entry when it has one, is
-- compiled when this entry makes it hot, or meets the interpreter's policy
-- for vector code; `rt_enter_frame` is that service, and the chain goes on in
-- whatever frame the context names when it is done. Compiled code is entered
-- through frame entries only: there is no second entry table and no second
-- counter.
const native = require("nupp.runtime.vm.intrinsics")
const slots = require("nupp.runtime.vm.slots")
const program = require("nupp.runtime.vm.program")
const specialization = require("nupp.runtime.vm.specialization")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

-- An unlimited budget stays at its sentinel. Finite budgets count every
-- call and taken back edge before the frame driver charges them to the VM.
local function chargeBudget(context: voidptr, budget: uint64): nil
    if budget ~= 0xffffffffffffffffULL then
        native.store64(context, native.layout("budget"), budget - 1)
    end
end

-- The frame on top goes on interpreting at `pcIndex`, its windows derived
-- from the context.
local function resumeTop(context: voidptr, pcIndex: int64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return native.dispatch(native.offset(code, pcIndex * 16), regs, ints, floats, context, frame)
end

-- After the frame driver's service: a status ends the chain; `REENTER` asks
-- the policy of whatever frame is on top now (the compiled frame returned, or
-- transferred, to one the service did not run); a pc goes on interpreting
-- the top frame there. The policy is the Rust driver's `entry`: a function
-- starting counts toward its heat while the JIT has not decided on it, and
-- goes to the service when it has a frame entry, has vector instructions, or
-- this call made it hot.
local function settle(context: voidptr, first: uint64): uint64
    local result = first
    while true do
        if result == values.ST_REENTER then
            local stack = native.loadPointer(context, native.layout("stack"))
            local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
            local header = native.load64(frame, 0)
            local fid = header & values.LOW_WORD
            local info = native.offset(
                native.loadPointer(context, native.layout("funcs")),
                native.index(fid) * native.layout("FuncInfo.size")
            )
            local pcIndex = native.index(header >> 32)
            local due = false
            local hot = false
            local vector = native.load32(info, native.layout("FuncInfo.native")) ~= 0
            if native.either(pcIndex == 0, vector) then
                local entry: uint64 = 0
                if fid < native.load64(context, native.layout("nframe_entries")) then
                    entry = native.load64(
                        native.loadPointer(context, native.layout("frame_entries")),
                        native.index(fid) * 8
                    )
                end
                if native.both(
                    native.both(pcIndex == 0, entry == 0),
                    native.load32(context, native.layout("jit_frames")) ~= 0
                ) then
                    local calls = (native.load32(info, native.layout("FuncInfo.calls")) & values.LOW_WORD) + 1
                    if calls < native.load32(context, native.layout("frame_threshold")) & values.LOW_WORD then
                        native.store32(info, native.layout("FuncInfo.calls"), calls)
                    else
                        native.store32(info, native.layout("FuncInfo.calls"), 0)
                        hot = true
                    end
                end
                due = native.either(native.either(native.both(entry ~= 0, entry ~= values.NO_GUARD), vector), hot)
            end
            if due then
                result = helpers.enterFrame(context, pcIndex, native.chooseIndex(hot, 1, 0))
            else
                return resumeTop(context, pcIndex)
            end
        elseif result >= values.ST_ERROR then
            native.store32(context, native.layout("status"), native.index(result))
            return native.fail()
        else
            local stack = native.loadPointer(context, native.layout("stack"))
            local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
            native.store64(frame, 0, (native.load64(frame, 0) & values.LOW_WORD) | (result << 32))
            return resumeTop(context, native.index(result))
        end
    end

    return native.fail()
end

-- The service for the function on top, from a frameless handler: `pc` is a
-- pc of that function, since the service reads the frame from the context.
local function enterFrameSlow(pc: voidptr, context: voidptr, pcIndex: int64, hot: int64): uint64
    return settle(context, helpers.enterFrame(context, pcIndex, hot))
end

-- The task's own entry, which the glue exports as
-- `nupp_native_runtime_resume`: the policy of the frame on top when the task
-- starts or resumes, or after Rust ran an instruction that changed the frame.
-- Exported for the glue, which finds it by name; no handler calls it.
export function resumeSlow(pc: voidptr, context: voidptr): uint64
    return settle(context, values.ST_REENTER)
end

-- The callee's frame is in place and the context names it: the policy for a
-- function starting, then the callee's code.
local function enterPushed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64
): uint64
    local code = native.loadPointer(callee, native.layout("FuncInfo.code"))
    local calleeRegs = native.offset(frame, 32)
    local calleeInts = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_i")) * 8)
    local calleeFloats = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_f")) * 8)
    -- The frame entry table is absent, not empty, when nothing is compiled:
    -- it is read only below its recorded length.
    local entry: uint64 = 0
    if fid < native.load64(context, native.layout("nframe_entries")) then
        entry = native.load64(native.loadPointer(context, native.layout("frame_entries")), native.index(fid) * 8)
    end
    local hot = false
    if native.both(entry == 0, native.load32(context, native.layout("jit_frames")) ~= 0) then
        local calls = (native.load32(callee, native.layout("FuncInfo.calls")) & values.LOW_WORD) + 1
        if calls < native.load32(context, native.layout("frame_threshold")) & values.LOW_WORD then
            native.store32(callee, native.layout("FuncInfo.calls"), calls)
        else
            native.store32(callee, native.layout("FuncInfo.calls"), 0)
            hot = true
        end
    end
    if native.either(
        native.either(
            native.both(entry ~= 0, entry ~= values.NO_GUARD),
            native.load32(callee, native.layout("FuncInfo.native")) ~= 0
        ),
        hot
    ) then
        return enterFrameSlow(code, context, 0, native.chooseIndex(hot, 1, 0))
    else
        return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
    end
end

-- The Rust core's `push`: the callee's frame goes above the caller's,
-- `supplied` argument words copied from the argument window and the
-- remaining parameters nil, and the caller's header remembers where to
-- resume. A call the stack cannot hold grows it in Rust.
export function pushFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64,
    closure: uint64,
    base: int64,
    supplied: int64
): uint64
    -- The budget: a call the task may not take yet is Rust's, which parks
    -- the task or raises at this instruction.
    local budget = native.load64(context, native.layout("budget"))
    local current = native.load64(context, native.layout("cur"))
    local next = current + ((native.load64(frame, 24) >> 33) & values.LOW_HALF)
    local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & values.LOW_WORD
    if native.either(budget == 0, next + words > native.load64(context, native.layout("cap"))) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        chargeBudget(context, budget)
        local caller = native.loadPointer(
            native.loadPointer(context, native.layout("funcs")),
            native.index(
                native.load64(frame, 0) & values.LOW_WORD
            ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
        )
        local resume = ((native.address(pc) - native.address(caller)) >> 4) + 1
        native.store64(frame, 0, (native.load64(frame, 0) & values.LOW_WORD) | (resume << 32))
        local stack = native.loadPointer(context, native.layout("stack"))
        local pushed = native.offset(stack, native.index(next * 8))
        local arguments = current + 4 + native.word(base)
        local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
        native.store64(pushed, 0, fid)
        native.store64(pushed, 8, current | (arguments << 32))
        native.store64(pushed, 16, closure)
        native.store64(pushed, 24, words << 33)
        local pushedRegs = native.offset(pushed, 32)
        -- The arguments are the caller's registers from `base + 1`; one
        -- to three of them, the common counts, are copied without a loop.
        local from = base + 1
        if supplied == 1 then
            slots.writeValue(pushed, pushedRegs, 1, slots.readValue(frame, regs, from))
        elseif supplied == 2 then
            slots.writeValue(pushed, pushedRegs, 1, slots.readValue(frame, regs, from))
            slots.writeValue(pushed, pushedRegs, 2, slots.readValue(frame, regs, from + 1))
        elseif supplied == 3 then
            slots.writeValue(pushed, pushedRegs, 1, slots.readValue(frame, regs, from))
            slots.writeValue(pushed, pushedRegs, 2, slots.readValue(frame, regs, from + 1))
            slots.writeValue(pushed, pushedRegs, 3, slots.readValue(frame, regs, from + 2))
        else
            local copied: int64 = 0
            while copied < supplied do
                slots.writeValue(pushed, pushedRegs, 1 + copied, slots.readValue(frame, regs, from + copied))
                copied = copied + 1
            end
        end
        local filled: int64 = supplied
        while filled < nparams do
            slots.writeValue(pushed, pushedRegs, 1 + filled, values.NIL)
            filled = filled + 1
        end
        native.store64(context, native.layout("cur"), next)
        return enterPushed(pc, regs, ints, floats, context, pushed, callee, fid)
    end
end

-- The rest of a call whose callee is already in the window at `base`, in
-- Rust, as `CallDyn base base nargs` would make it: a callee the core does
-- not push (a typed function, a host service, a value with `__call`), or a
-- push the core cannot make (no budget, no room). A method is resolved once,
-- so it is never resolved again; the answer is settled as the frame driver's
-- service's is.
local function callResolvedSlow(pc: voidptr, context: voidptr, base: int64, nargs: int64): uint64
    protocol.publishPc(pc, context)
    return settle(context, helpers.callResolved(context, base, nargs))
end

-- A call whose argument count is flagged, or whose callee takes varargs
-- (contracts 5.1). The arguments are `fixed` words from the window at
-- `base + 1`, then a spread: with 128 the caller's own varargs, which lie
-- below its header, their count in header word 3; with 64 the results the
-- last call left after the fixed arguments, while they are all in the window
-- (eight or fewer). A vararg callee keeps its surplus just below its own
-- header, the count in its header word 3; any other callee drops it. Both
-- flags at once, and a pack past the window, are the step's, or with
-- `resolved` (a method already resolved) Rust's from the callee on.
local function pushSpreadSlow(
    pc: voidptr,
    context: voidptr,
    fid: uint64,
    closure: uint64,
    base: int64,
    nargs: int64,
    resolved: int64
): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local current = native.load64(context, native.layout("cur"))
    local frame = native.offset(stack, native.index(current * 8))
    local regs = native.offset(frame, 32)
    local callee = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(fid) * native.layout("FuncInfo.size")
    )
    local fixed: int64 = nargs
    local count: int64 = 0
    local source = native.offset(regs, (base + 1 + nargs) * 8)
    local refused = false
    if nargs >= 128 then
        fixed = nargs & 127
        count = native.index(native.load64(frame, 24) >> 49)
        source = native.offset(frame, 0 - count * 8)
        refused = fixed >= 64
    elseif nargs >= 64 then
        fixed = nargs & 63
        count = native.loadIndex(context, native.layout("last_nres"))
        source = native.offset(regs, (base + 1 + fixed) * 8)
        refused = count > 8
    end
    local total = fixed + count
    local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
    local nvar: int64 = 0
    if native.both(native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0, total > nparams) then
        nvar = total - nparams
    end
    local budget = native.load64(context, native.layout("budget"))
    local next = current + ((native.load64(frame, 24) >> 33) & values.LOW_HALF) + native.word(nvar)
    local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & values.LOW_WORD
    if native.either(
        native.either(refused, budget == 0),
        next + words > native.load64(context, native.layout("cap"))
    ) then
        if resolved ~= 0 then
            return callResolvedSlow(pc, context, base, nargs)
        end
        return native.slow(pc, regs, regs, regs, context, frame)
    end
    chargeBudget(context, budget)
    local caller = native.loadPointer(
        native.loadPointer(context, native.layout("funcs")),
        native.index(
            native.load64(frame, 0) & values.LOW_WORD
        ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
    )
    local resume = ((native.address(pc) - native.address(caller)) >> 4) + 1
    native.store64(frame, 0, (native.load64(frame, 0) & values.LOW_WORD) | (resume << 32))
    local pushed = native.offset(stack, native.index(next * 8))
    native.store64(pushed, 0, fid)
    native.store64(pushed, 8, current | ((current + 4 + native.word(base)) << 32))
    native.store64(pushed, 16, closure)
    native.store64(pushed, 24, (words << 33) | (native.word(nvar) << 49))
    local pushedRegs = native.offset(pushed, 32)
    local pushedVarargs = native.offset(pushed, 0 - nvar * 8)
    -- Argument `i` is a fixed word or a spread word; a parameter's goes to
    -- its register, a surplus one below the header. Nothing overlaps: the
    -- callee lies above the caller's whole frame.
    local i: int64 = 0
    while i < total do
        local word: uint64 = 0
        if i < fixed then
            word = slots.readValue(frame, regs, base + 1 + i)
        else
            word = slots.readValue(frame, source, i - fixed)
        end
        if i < nparams then
            slots.writeValue(pushed, pushedRegs, 1 + i, word)
        elseif nvar > 0 then
            slots.writeValue(pushed, pushedVarargs, i - nparams, word)
        end
        i = i + 1
    end
    while i < nparams do
        slots.writeValue(pushed, pushedRegs, 1 + i, values.NIL)
        i = i + 1
    end
    native.store64(context, native.layout("cur"), next)

    return enterPushed(pc, regs, regs, regs, context, pushed, callee, fid)
end

-- The Rust core's `dynamic_call!` once the callee is a known function id:
-- typed parameters and the unavailable function stay in Rust; a flagged
-- count or a vararg callee takes the spread push.
local function dynamicCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    fid: uint64,
    closure: uint64,
    nargs: int64
): uint64
    if fid >= native.load64(context, native.layout("nfuncs")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local callee = native.offset(
            native.loadPointer(context, native.layout("funcs")),
            native.index(fid) * native.layout("FuncInfo.size")
        )
        if native.either(
            native.load32(callee, native.layout("FuncInfo.typed")) ~= 0,
            fid == native.word(native.load32(context, native.layout("unavailable_fid")) & values.LOW_WORD)
        ) then
            return native.slow(pc, regs, ints, floats, context, frame)
        elseif native.either(nargs >= 64, native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0) then
            return pushSpreadSlow(pc, context, fid, closure, program.readByte(pc, 2), nargs, 0)
        else
            local base = program.readByte(pc, 2)
            local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
            local supplied = native.chooseIndex(nargs < nparams, nargs, nparams)
            return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, closure, base, supplied)
        end
    end
end

-- A static call copies every argument word, as its Rust handler does.
export function Call(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local fid = program.readWord(pc, 8)
    local nargs = program.readByte(pc, 2)
    local callee = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(fid) * native.layout("FuncInfo.size")
    )
    if native.either(native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0, nargs >= 64) then
        return pushSpreadSlow(pc, context, fid, values.NIL, program.readByte(pc, 1), nargs, 0)
    else
        return pushFrame(
            pc,
            regs,
            ints,
            floats,
            context,
            frame,
            callee,
            fid,
            values.NIL,
            program.readByte(pc, 1),
            nargs
        )
    end
end

-- A builtin called from the core: its arguments in the window from `base + 1`
-- and its results delivered from `base` by the helper, which may grow the
-- stack. The protected calls and the task API, which park or run frames of
-- their own, are the slow-call table's and go to Rust whole.
-- CallK/CallDyn gate zero before reaching this helper; native CallMethod
-- reaches it only with the unlimited sentinel. The destination need not
-- contain the callee, so it cannot stand in for a resolved-call boundary.
local function callBuiltinSlow(pc: voidptr, context: voidptr, id: int64, base: uint64, nargs: int64): uint64
    local budget = native.load64(context, native.layout("budget"))
    chargeBudget(context, budget)
    protocol.publishPc(pc, context)
    helpers.callBuiltin(context, id, base, nargs)

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- One step of an iterator object called as a function. CallK/CallDyn have
-- already gated zero before reaching this helper.
local function callIterSlow(pc: voidptr, context: voidptr, iterator: uint64, base: uint64): uint64
    local budget = native.load64(context, native.layout("budget"))
    chargeBudget(context, budget)
    protocol.publishPc(pc, context)
    helpers.callIter(context, iterator, base)

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- The Rust core's `dynamic_call!`: a closure or a bare function value pushes
-- a frame, a builtin and an iterator run in Rust from the argument window,
-- and anything else is the interpreter's. A builtin whose arguments end in
-- the last call's results is the step's: the helper reads the result count
-- from the task record, which the core does not publish.
local function callValue(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    value: uint64,
    nargs: int64
): uint64
    if value & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(value & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if kind == 5 then
            return dynamicCall(
                pc,
                regs,
                ints,
                floats,
                context,
                frame,
                native.word(native.load32(object, native.layout("Header.aux")) & values.LOW_WORD),
                value,
                nargs
            )
        elseif kind == 8 then
            return callIterSlow(
                pc,
                context,
                value,
                native.load64(context, native.layout("cur")) + 4 + native.word(program.readByte(pc, 2))
            )
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    elseif value & values.TAG_MASK == values.TAG_FUNC then
        local upper = (value >> 32) & values.LOW_HALF
        if upper == 0 then
            return dynamicCall(pc, regs, ints, floats, context, frame, value & values.LOW_WORD, values.NIL, nargs)
        elseif upper == values.LOW_HALF then
            local id = native.index(value & values.LOW_WORD)
            if native.either(id >= 1000, native.both(nargs >= 64, nargs < 128)) then
                return native.slow(pc, regs, ints, floats, context, frame)
            elseif native.word(id) < native.load64(context, native.layout("nslow_calls"))
                and native.load8(native.loadPointer(context, native.layout("slow_calls")), id) ~= 0
            then
                return native.slow(pc, regs, ints, floats, context, frame)
            else
                return callBuiltinSlow(
                    pc,
                    context,
                    id,
                    native.load64(context, native.layout("cur")) + 4 + native.word(program.readByte(pc, 2)),
                    nargs
                )
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

-- The call target reported to the JIT's feedback, then the call itself.
-- Feedback moves no stack, but the windows are derived again anyway, since the
-- support function has only the pc and the context.
local function observeCallSlow(pc: voidptr, context: voidptr, value: uint64, nargs: int64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local fid = native.index(native.load64(frame, 0) & values.LOW_WORD)
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        fid * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    helpers.observe(context, fid, native.index(native.address(pc) - native.address(code)) >> 4, value, 0)
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return callValue(pc, regs, ints, floats, context, frame, value, nargs)
end

-- CallK and CallDyn share this body, as their Rust handlers share one. A
-- CallK site carries the function id the compiler bound the name to: the
-- callee word equal to that function is the common case, taken on one
-- compare without decoding the tag or the kind.
export function CallK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.load64(context, native.layout("budget")) == 0 then
        return native.slow(pc, regs, ints, floats, context, frame)
    end
    local nargs = program.readByte(pc, 3)
    local value = slots.readValue(frame, regs, program.readByte(pc, 1))
    if specialization.inInterpreter() and native.load32(context, native.layout("feedback")) ~= 0 then
        return observeCallSlow(pc, context, value, nargs)
    elseif value == values.TAG_FUNC | program.readWord(pc, 8) then
        return dynamicCall(pc, regs, ints, floats, context, frame, program.readWord(pc, 8), values.NIL, nargs)
    else
        return callValue(pc, regs, ints, floats, context, frame, value, nargs)
    end
end

-- The caller's frame is on top again and the context names it: resume at the
-- instruction after its call, or a function with vector instructions through the
-- service, whose compiled entries revalidate what the interpreter cannot. `delivered`
-- is the caller's logical value slot that received one result, or -1: when the caller
-- resumes at a `PadResults` of that slot, the padding is done here and the instruction
-- skipped, so a call with one result costs one dispatch less.
local function resumeCaller(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    caller: uint64,
    delivered: int64
): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local resumed = native.offset(stack, native.index(caller * 8))
    local header = native.load64(resumed, 0)
    local callerInfo = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(header & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(callerInfo, native.layout("FuncInfo.code"))
    local callerPc = native.offset(code, native.index((header >> 32) * 16))
    local callerRegs = native.offset(resumed, 32)
    local callerInts = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_i")) * 8)
    local callerFloats = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_f")) * 8)
    if native.load32(callerInfo, native.layout("FuncInfo.native")) ~= 0 then
        return enterFrameSlow(callerPc, context, native.index(header >> 32), 0)
    else
        if native.both(delivered >= 0, program.readByte(callerPc, 0) == native.layout("Code.PadResults")) then
            local base = program.readByte(callerPc, 1)
            local wanted = program.readByte(callerPc, 2)
            if native.both(base == delivered, wanted <= 8) then
                local filled: int64 = 1
                while filled < wanted do
                    slots.writeValue(resumed, callerRegs, base + filled, values.NIL)
                    filled = filled + 1
                end
                callerPc = native.offset(callerPc, 16)
            end
        end
        return native.dispatch(callerPc, callerRegs, callerInts, callerFloats, context, resumed)
    end
end

-- Compiled code resumes at the jump itself, so a service that answers the
-- jump's own pc ran nothing: the jump is taken with the windows derived
-- again. Anything else is settled as a frame entry's answer is.
local function backEdgeSlow(pc: voidptr, context: voidptr, pcIndex: int64, hot: int64): uint64
    -- Bit 1 says the conditional jump has already been taken. The guest
    -- JIT enters at its target; a caller resuming at this pc must still
    -- evaluate the condition.
    local result = helpers.enterFrame(context, pcIndex, hot + 2)
    if result == native.word(pcIndex) then
        return resumeTop(context, pcIndex + program.readSigned32(pc, 4) + 1)
    else
        return settle(context, result)
    end
end

-- A taken back edge, before it is taken: charged to the budget, and while
-- compiled frames are possible the loop moves into compiled code when its
-- function has a frame entry, or is compiled when this edge makes it hot.
-- Otherwise the jump is taken here.
export function backEdge(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    displacement: int64
): uint64
    local target = native.offset(pc, (displacement + 1) * 16)
    local budget = native.load64(context, native.layout("budget"))
    if budget == 0 then
        return native.slow(pc, regs, ints, floats, context, frame)
    end
    chargeBudget(context, budget)
    local jit = native.load32(context, native.layout("jit_frames"))
    local frames = native.load64(context, native.layout("nframe_entries"))
    if native.both(jit == 0, frames == 0) then
        return native.dispatch(target, regs, ints, floats, context, frame)
    else
        do
            local fid = native.load64(frame, 0) & values.LOW_WORD
            local info = native.offset(
                native.loadPointer(context, native.layout("funcs")),
                native.index(fid) * native.layout("FuncInfo.size")
            )
            local entry: uint64 = 0
            if fid < frames then
                entry = native.load64(
                    native.loadPointer(context, native.layout("frame_entries")),
                    native.index(fid) * 8
                )
            end
            local hot = false
            if native.both(entry == 0, jit ~= 0) then
                local calls = (native.load32(info, native.layout("FuncInfo.calls")) & values.LOW_WORD) + 1
                if calls < native.load32(context, native.layout("frame_threshold")) & values.LOW_WORD then
                    native.store32(info, native.layout("FuncInfo.calls"), calls)
                else
                    native.store32(info, native.layout("FuncInfo.calls"), 0)
                    hot = true
                end
            end
            if native.either(native.both(entry ~= 0, entry ~= values.NO_GUARD), hot) then
                local code = native.loadPointer(info, native.layout("FuncInfo.code"))
                local pcIndex = native.index(native.address(pc) - native.address(code)) >> 4
                native.store64(frame, 0, (native.load64(frame, 0) & values.LOW_WORD) | (native.word(pcIndex) << 32))
                return backEdgeSlow(pc, context, pcIndex, native.chooseIndex(hot, 1, 0))
            else
                return native.dispatch(target, regs, ints, floats, context, frame)
            end
        end
    end
end

-- A return the Rust path must take: a cleanup or protected call at or above
-- this frame, an unwind in progress, or the task's own end.
export function Ret(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(native.both(guard ~= values.NO_GUARD, guard >= current), caller == values.LOW_WORD) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local value = slots.readValue(frame, regs, program.readByte(pc, 1))
        local flags = native.load64(frame, 24)
        local indirect = (flags >> 32) & 1 ~= 0
        local resumed = native.offset(native.loadPointer(context, native.layout("stack")), native.index(caller * 8))
        -- The header is the current ABI adapter. Beyond this boundary a
        -- destination is a caller frame, a typed window and a logical slot.
        local slot: int64 = native.index(link >> 32) - native.index(caller) - 4
        local delivered: int64 = slot
        if indirect then
            delivered = -1
            local info = native.offset(
                native.loadPointer(context, native.layout("funcs")),
                native.index(native.load64(resumed, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
            )
            local off = native.load32(info, native.layout("FuncInfo.off_f"))
            local callerFloats = native.offset(resumed, off * 8)
            local floatSlot: int64 = native.index(flags & values.LOW_WORD) - native.index(caller) - off
            slots.writeFloat(resumed, callerFloats, floatSlot, native.fromBits(value))
        else
            slots.writeValue(resumed, native.offset(resumed, 32), slot, value)
        end
        native.store64(context, native.layout("result"), value)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 1)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller, delivered)
    end
end

export function RetNil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(native.both(guard ~= values.NO_GUARD, guard >= current), caller == values.LOW_WORD) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local resumed = native.offset(native.loadPointer(context, native.layout("stack")), native.index(caller * 8))
        local slot: int64 = native.index(link >> 32) - native.index(caller) - 4
        slots.writeValue(resumed, native.offset(resumed, 32), slot, values.NIL)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 0)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller, -1)
    end
end

export function RetN(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local count = program.readByte(pc, 2)
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(
        native.either(count > 8, native.both(guard ~= values.NO_GUARD, guard >= current)),
        caller == values.LOW_WORD
    ) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local resumed = native.offset(native.loadPointer(context, native.layout("stack")), native.index(caller * 8))
        local callerRegs = native.offset(resumed, 32)
        local slot: int64 = native.index(link >> 32) - native.index(caller) - 4
        local from = program.readByte(pc, 1)
        local copied: int64 = 0
        while copied < count do
            slots.writeValue(resumed, callerRegs, slot + copied, slots.readValue(frame, regs, from + copied))
            copied = copied + 1
        end
        if count == 0 then
            slots.writeValue(resumed, callerRegs, slot, values.NIL)
        end
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), native.word(count))
        return resumeCaller(pc, regs, ints, floats, context, frame, caller, -1)
    end
end

export function PadResults(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local wanted = program.readByte(pc, 2)
    if wanted > 8 then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local base = program.readByte(pc, 1)
        local filled: int64 = native.loadIndex(context, native.layout("last_nres"))
        while filled < wanted do
            slots.writeValue(frame, regs, base + filled, values.NIL)
            filled = filled + 1
        end
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

-- A dynamic call through a register is the same path as `CallK`; the Rust
-- core shares one body between the two opcodes and so does this one.
export function CallDyn(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if native.load64(context, native.layout("budget")) == 0 then
        return native.slow(pc, regs, ints, floats, context, frame)
    end
    local nargs = program.readByte(pc, 3)
    local value = slots.readValue(frame, regs, program.readByte(pc, 1))
    if specialization.inInterpreter() and native.load32(context, native.layout("feedback")) ~= 0 then
        return observeCallSlow(pc, context, value, nargs)
    else
        return callValue(pc, regs, ints, floats, context, frame, value, nargs)
    end
end

-- `VarargN d n`: the frame's first `n` varargs into `d..`, nil past the
-- ones it has (contracts 5.1: they lie below the header, their count in
-- header word 3).
export function VarargN(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local d = program.readByte(pc, 1)
    local n = program.readByte(pc, 2)
    local count = native.index(native.load64(frame, 24) >> 49)
    local varargs = native.offset(frame, 0 - count * 8)
    local i: int64 = 0
    while i < n do
        if i < count then
            slots.writeValue(frame, regs, d + i, slots.readValue(frame, varargs, i))
        else
            slots.writeValue(frame, regs, d + i, values.NIL)
        end
        i = i + 1
    end

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

-- `recv:name(...)`: the method resolved by the helper (contracts 2.x: a
-- string's from its metatable's `__index`, a record's from its shape, a
-- table's through `__index`), written into `base`, where a dynamic call
-- reads its callee, and called with the receiver as its first argument, as
-- `CallK` calls: a function or a closure pushes a frame here, a builtin
-- runs from the window, and anything else is Rust's from the resolved
-- method on. The receiver goes to the JIT's feedback first, as a receiver.
local function callMethodSlow(pc: voidptr, context: voidptr, name: uint64, base: int64, nargs: int64): uint64
    protocol.publishPc(pc, context)
    local stack = native.loadPointer(context, native.layout("stack"))
    local current = native.load64(context, native.layout("cur"))
    local frame = native.offset(stack, native.index(current * 8))
    local receiver = slots.readValue(frame, native.offset(frame, 32), base + 1)
    if specialization.inInterpreter() and native.load32(context, native.layout("feedback")) ~= 0 then
        helpers.observe(
            context,
            native.index(native.load64(frame, 0) & values.LOW_WORD),
            native.load32(context, native.layout("pc")),
            receiver,
            1
        )
    end
    local method = helpers.resolveMethod(context, receiver, name)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    -- An `__index` function may have run: the stack is derived again.
    stack = native.loadPointer(context, native.layout("stack"))
    frame = native.offset(stack, native.index(current * 8))
    local regs = native.offset(frame, 32)
    slots.writeValue(frame, regs, base, method)
    local fid = values.NO_GUARD
    local closure = values.NIL
    if method & values.TAG_MASK == values.TAG_FUNC then
        local upper = (method >> 32) & values.LOW_HALF
        if upper == 0 then
            fid = method & values.LOW_WORD
        elseif native.both(upper == values.LOW_HALF, native.either(nargs < 64, nargs >= 128)) then
            local id = native.index(method & values.LOW_WORD)
            if native.both(
                id < 1000,
                native.either(
                    native.word(id) >= native.load64(context, native.layout("nslow_calls")),
                    native.load8(native.loadPointer(context, native.layout("slow_calls")), id) == 0
                )
            ) then
                return callBuiltinSlow(pc, context, id, current + 4 + native.word(base), nargs)
            end
        end
    elseif method & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(method & values.PAYLOAD)
        if native.load8(object, native.layout("Header.kind")) == 5 then
            fid = native.word(native.load32(object, native.layout("Header.aux")) & values.LOW_WORD)
            closure = method
        end
    end
    if fid < native.load64(context, native.layout("nfuncs")) then
        local callee = native.offset(
            native.loadPointer(context, native.layout("funcs")),
            native.index(fid) * native.layout("FuncInfo.size")
        )
        if native.both(
            native.load32(callee, native.layout("FuncInfo.typed")) == 0,
            fid ~= native.word(native.load32(context, native.layout("unavailable_fid")) & values.LOW_WORD)
        ) then
            if native.either(nargs >= 64, native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0) then
                return pushSpreadSlow(pc, context, fid, closure, base, nargs, 1)
            end
            -- The push's own refusals are decided here, so it never hands
            -- the instruction back to be resolved a second time.
            local next = current + ((native.load64(frame, 24) >> 33) & values.LOW_HALF)
            local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & values.LOW_WORD
            if native.both(
                native.load64(context, native.layout("budget")) ~= 0,
                next + words <= native.load64(context, native.layout("cap"))
            ) then
                local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
                local supplied = native.chooseIndex(nargs < nparams, nargs, nparams)
                return pushFrame(pc, regs, regs, regs, context, frame, callee, fid, closure, base, supplied)
            end
        end
    end

    return callResolvedSlow(pc, context, base, nargs)
end

-- `CallMethod k base nargs`: the method named by constant `k` on the
-- receiver at `base + 1`, which `nargs` counts.
export function CallMethod(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    -- A finite call is gated before an __index callback can resolve its
    -- target. The whole-op boundary charges before resolving and calling.
    if native.load64(context, native.layout("budget")) ~= 0xffffffffffffffffULL then
        return native.slow(pc, regs, ints, floats, context, frame)
    end
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local name = native.load64(
        native.loadPointer(info, native.layout("FuncInfo.consts")),
        program.readSigned32(pc, 4) * 8
    )

    return callMethodSlow(pc, context, name, program.readByte(pc, 2), program.readByte(pc, 3))
end
