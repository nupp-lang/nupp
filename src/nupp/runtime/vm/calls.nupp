module nupp.runtime.vm.calls

-- Calls, returns, result padding and the frame driver: the frame-transition
-- protocol in Nupp. In frame mode a function starting, or one with vector
-- instructions resuming anywhere, goes to its compiled frame entry when it
-- has one, is compiled when this entry makes it hot, or meets the
-- interpreter's policy for vector code; `rt_enter_frame` is that service, and
-- the chain goes on in whatever frame the context names when it is done.
const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

-- The frame on top goes on interpreting at `pcIndex`, its windows derived
-- from the context.
local function resumeTop(context: voidptr, pcIndex: int64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & 4294967295) * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return native.dispatch(native.offset(code, pcIndex * 16), regs, ints, floats, context, frame)
end

-- After the frame driver's service: a status ends the chain; `REENTER` asks
-- the policy of whatever frame is on top now (the compiled frame returned, or
-- transferred, to one the service did not run); a pc goes on interpreting
-- the top frame there. The policy is the Rust driver's `entry`: a function
-- starting counts toward its heat while the JIT has not decided on it, and
-- goes to the service when it has a frame entry, has vector instructions, or
-- this call made it hot.
local function settle(context: voidptr, first: uint64): uint64
    local result = first
    while true do
        if result == 4294967295 then
            local stack = native.loadPointer(context, native.layout("stack"))
            local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
            local header = native.load64(frame, 0)
            local fid = header & 4294967295
            local info = native.offset(
                native.loadPointer(context, native.layout("funcs")),
                native.index(fid) * native.layout("FuncInfo.size")
            )
            local pcIndex = native.index(header >> 32)
            local due = false
            local hot = false
            if native.load32(context, native.layout("frame_mode")) ~= 0 then
                local vector = native.load32(info, native.layout("FuncInfo.native")) ~= 0
                if native.either(pcIndex == 0, vector) then
                    local entry: uint64 = 0
                    if fid < native.load64(context, native.layout("nframe_entries")) then
                        entry = native.load64(
                            native.loadPointer(context, native.layout("frame_entries")),
                            native.index(fid) * 8
                        )
                    end
                    if native.both(
                        native.both(pcIndex == 0, entry == 0),
                        native.load32(context, native.layout("jit_frames")) ~= 0
                    ) then
                        local calls = (native.load32(info, native.layout("FuncInfo.calls")) & 4294967295) + 1
                        if calls < native.load32(context, native.layout("frame_threshold")) & 4294967295 then
                            native.store32(info, native.layout("FuncInfo.calls"), calls)
                        else
                            native.store32(info, native.layout("FuncInfo.calls"), 0)
                            hot = true
                        end
                    end
                    due = native.either(
                        native.either(native.both(entry ~= 0, entry ~= 18446744073709551615ULL), vector),
                        hot
                    )
                end
            end
            if due then
                result = helpers.enterFrame(context, pcIndex, native.chooseIndex(hot, 1, 0))
            else
                return resumeTop(context, pcIndex)
            end
        elseif result >= 4294967292ULL then
            native.store32(context, native.layout("status"), native.index(result))
            return native.fail()
        else
            local stack = native.loadPointer(context, native.layout("stack"))
            local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
            native.store64(frame, 0, (native.load64(frame, 0) & 4294967295) | (result << 32))
            return resumeTop(context, native.index(result))
        end
    end

    return native.fail()
end

-- The service for the function on top, from a frameless handler: `pc` is a
-- pc of that function, since the service reads the frame from the context.
local function enterFrameSlow(pc: voidptr, context: voidptr, pcIndex: int64, hot: int64): uint64
    return settle(context, helpers.enterFrame(context, pcIndex, hot))
end

-- The task's own entry, which the glue exports as
-- `nupp_native_runtime_resume`: the policy of the frame on top when the task
-- starts or resumes, or after Rust ran an instruction that changed the frame.
-- Exported for the glue, which finds it by name; no handler calls it.
export function resumeSlow(pc: voidptr, context: voidptr): uint64
    return settle(context, 4294967295)
end

-- The callee's frame is in place and the context names it: in frame mode the
-- policy for a function starting, then the callee's code.
local function enterPushed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64
): uint64
    local code = native.loadPointer(callee, native.layout("FuncInfo.code"))
    local calleeRegs = native.offset(frame, 32)
    local calleeInts = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_i")) * 8)
    local calleeFloats = native.offset(frame, native.load32(callee, native.layout("FuncInfo.off_f")) * 8)
    if native.load32(context, native.layout("frame_mode")) == 0 then
        return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
    else
        -- The frame entry table is absent, not empty, when nothing is
        -- compiled: it is read only below its recorded length.
        local entry: uint64 = 0
        if fid < native.load64(context, native.layout("nframe_entries")) then
            entry = native.load64(native.loadPointer(context, native.layout("frame_entries")), native.index(fid) * 8)
        end
        local hot = false
        if native.both(entry == 0, native.load32(context, native.layout("jit_frames")) ~= 0) then
            local calls = (native.load32(callee, native.layout("FuncInfo.calls")) & 4294967295) + 1
            if calls < native.load32(context, native.layout("frame_threshold")) & 4294967295 then
                native.store32(callee, native.layout("FuncInfo.calls"), calls)
            else
                native.store32(callee, native.layout("FuncInfo.calls"), 0)
                hot = true
            end
        end
        if native.either(
            native.either(
                native.both(entry ~= 0, entry ~= 18446744073709551615ULL),
                native.load32(callee, native.layout("FuncInfo.native")) ~= 0
            ),
            hot
        ) then
            return enterFrameSlow(code, context, 0, native.chooseIndex(hot, 1, 0))
        else
            return native.dispatch(code, calleeRegs, calleeInts, calleeFloats, context, frame)
        end
    end
end

-- The Rust core's `count_call` and `push`: the callee's frame goes above the
-- caller's, `supplied` argument words copied from the argument window and the
-- remaining parameters nil, and the caller's header remembers where to
-- resume. Capacity is checked before the call count moves so a growing call
-- counts exactly once, in Rust; the call that reaches the threshold is left
-- uncounted for Rust as well.
local function pushFrame(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    callee: voidptr,
    fid: uint64,
    closure: uint64,
    base: int64,
    supplied: int64
): uint64
    local current = native.load64(context, native.layout("cur"))
    local next = current + ((native.load64(frame, 24) >> 33) & values.LOW_HALF)
    local words = native.load64(callee, native.layout("FuncInfo.frame_words")) & values.LOW_WORD
    if next + words > native.load64(context, native.layout("cap")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local threshold = native.load32(context, native.layout("jit_threshold"))
        local calls = native.load32(callee, native.layout("FuncInfo.calls"))
        local counting = native.both(threshold ~= 0, calls < threshold)
        local counted = calls + native.chooseIndex(counting, 1, 0)
        if native.both(counting, counted == threshold) then
            -- The call that makes the function hot is Rust's: its own count
            -- reaches the threshold and hands the call to the interpreter,
            -- which compiles the function.
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            native.store32(callee, native.layout("FuncInfo.calls"), counted)
            local caller = native.loadPointer(
                native.loadPointer(context, native.layout("funcs")),
                native.index(
                    native.load64(frame, 0) & values.LOW_WORD
                ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.code")
            )
            local resume = ((native.address(pc) - native.address(caller)) >> 4) + 1
            native.store64(frame, 0, (native.load64(frame, 0) & values.LOW_WORD) | (resume << 32))
            local stack = native.loadPointer(context, native.layout("stack"))
            local pushed = native.offset(stack, native.index(next * 8))
            local arguments = current + 4 + native.word(base)
            local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
            native.store64(pushed, 0, fid)
            native.store64(pushed, 8, current | (arguments << 32))
            native.store64(pushed, 16, closure)
            native.store64(pushed, 24, words << 33)
            local copied: int64 = 0
            while copied < supplied do
                native.store64(
                    pushed,
                    40 + copied * 8,
                    native.load64(stack, native.index((arguments + 1) * 8) + copied * 8)
                )
                copied = copied + 1
            end
            local filled: int64 = supplied
            while filled < nparams do
                native.store64(pushed, 40 + filled * 8, values.NIL)
                filled = filled + 1
            end
            native.store64(context, native.layout("cur"), next)
            return enterPushed(pc, regs, ints, floats, context, pushed, callee, fid)
        end
    end
end

-- The Rust core's `dynamic_call!` once the callee is a known function id:
-- varargs, typed parameters, the unavailable function and compiled entries
-- stay in Rust.
local function dynamicCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    fid: uint64,
    closure: uint64,
    nargs: int64
): uint64
    if fid >= native.load64(context, native.layout("nfuncs")) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local callee = native.offset(
            native.loadPointer(context, native.layout("funcs")),
            native.index(fid) * native.layout("FuncInfo.size")
        )
        if native.either(
            native.either(
                native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0,
                native.load32(callee, native.layout("FuncInfo.typed")) ~= 0
            ),
            fid == native.word(native.load32(context, native.layout("unavailable_fid")) & values.LOW_WORD)
        ) then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local base = native.load8(pc, 2)
            local nparams = native.load32(callee, native.layout("FuncInfo.nparams"))
            local supplied = native.chooseIndex(nargs < nparams, nargs, nparams)
            if native.load32(context, native.layout("frame_mode")) == 0 then
                local entry = native.load64(
                    native.loadPointer(context, native.layout("entries")),
                    native.index(fid) * 8
                )
                if entry ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                else
                    return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, closure, base, supplied)
                end
            else
                return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, closure, base, supplied)
            end
        end
    end
end

-- A static call copies every argument word, as its Rust handler does.
export function Call(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local fid = native.load64(pc, 8)
    local nargs = native.load8(pc, 2)
    local callee = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(fid) * native.layout("FuncInfo.size")
    )
    if native.either(native.load32(callee, native.layout("FuncInfo.vararg")) ~= 0, nargs >= 64) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        return pushFrame(pc, regs, ints, floats, context, frame, callee, fid, values.NIL, native.load8(pc, 1), nargs)
    end
end

-- A builtin called from the core: its arguments in the window from `base + 1`
-- and its results delivered from `base` by the helper, which may grow the
-- stack. The protected calls and the task API, which park or run frames of
-- their own, are the slow-call table's and go to Rust whole.
local function callBuiltinSlow(pc: voidptr, context: voidptr, id: int64, base: uint64, nargs: int64): uint64
    protocol.publishPc(pc, context)
    helpers.callBuiltin(context, id, base, nargs)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- One step of an iterator object called as a function.
local function callIterSlow(pc: voidptr, context: voidptr, iterator: uint64, base: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.callIter(context, iterator, base)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- The Rust core's `dynamic_call!`: a closure or a bare function value pushes
-- a frame, a builtin and an iterator run in Rust from the argument window,
-- and anything else is the interpreter's.
local function callValue(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    value: uint64,
    nargs: int64
): uint64
    if value & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(value & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if kind == 5 then
            return dynamicCall(
                pc,
                regs,
                ints,
                floats,
                context,
                frame,
                native.word(native.load32(object, native.layout("Header.aux")) & values.LOW_WORD),
                value,
                nargs
            )
        elseif kind == 8 then
            return callIterSlow(
                pc,
                context,
                value,
                native.load64(context, native.layout("cur")) + 4 + native.word(native.load8(pc, 2))
            )
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    elseif value & values.TAG_MASK == values.TAG_FUNC then
        local upper = (value >> 32) & values.LOW_HALF
        if upper == 0 then
            return dynamicCall(pc, regs, ints, floats, context, frame, value & values.LOW_WORD, values.NIL, nargs)
        elseif upper == values.LOW_HALF then
            local id = native.index(value & values.LOW_WORD)
            if id >= 1000 then
                return native.slow(pc, regs, ints, floats, context, frame)
            elseif native.word(id) < native.load64(context, native.layout("nslow_calls"))
                and native.load8(native.loadPointer(context, native.layout("slow_calls")), id) ~= 0
            then
                return native.slow(pc, regs, ints, floats, context, frame)
            else
                return callBuiltinSlow(
                    pc,
                    context,
                    id,
                    native.load64(context, native.layout("cur")) + 4 + native.word(native.load8(pc, 2)),
                    nargs
                )
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

-- The call target reported to the JIT's feedback, then the call itself.
-- Feedback moves no stack, but the windows are derived again anyway, since the
-- support function has only the pc and the context.
local function observeCallSlow(pc: voidptr, context: voidptr, value: uint64, nargs: int64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local fid = native.index(native.load64(frame, 0) & 4294967295)
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        fid * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    helpers.observe(context, fid, native.index(native.address(pc) - native.address(code)) >> 4, value, 0)
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return callValue(pc, regs, ints, floats, context, frame, value, nargs)
end

-- CallK and CallDyn share this body, as their Rust handlers share one.
export function CallK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local nargs = native.load8(pc, 3)
    local value = native.load64(regs, native.load8(pc, 1) * 8)
    if nargs >= 64 then
        return native.slow(pc, regs, ints, floats, context, frame)
    elseif native.load32(context, native.layout("feedback")) ~= 0 then
        return observeCallSlow(pc, context, value, nargs)
    else
        return callValue(pc, regs, ints, floats, context, frame, value, nargs)
    end
end

-- The caller's frame is on top again and the context names it: resume at
-- the instruction after its call, or a function with vector instructions
-- through the service, whose compiled entries revalidate what the
-- interpreter cannot.
local function resumeCaller(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    caller: uint64
): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local resumed = native.offset(stack, native.index(caller * 8))
    local header = native.load64(resumed, 0)
    local callerInfo = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(header & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(callerInfo, native.layout("FuncInfo.code"))
    local callerPc = native.offset(code, native.index((header >> 32) * 16))
    local callerRegs = native.offset(resumed, 32)
    local callerInts = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_i")) * 8)
    local callerFloats = native.offset(resumed, native.load32(callerInfo, native.layout("FuncInfo.off_f")) * 8)
    if native.both(
        native.load32(context, native.layout("frame_mode")) ~= 0,
        native.load32(callerInfo, native.layout("FuncInfo.native")) ~= 0
    ) then
        return enterFrameSlow(callerPc, context, native.index(header >> 32), 0)
    else
        return native.dispatch(callerPc, callerRegs, callerInts, callerFloats, context, resumed)
    end
end

-- Compiled code resumes at the jump itself, so a service that answers the
-- jump's own pc ran nothing: the jump is taken with the windows derived
-- again. Anything else is settled as a frame entry's answer is.
local function backEdgeSlow(pc: voidptr, context: voidptr, pcIndex: int64, hot: int64): uint64
    local result = helpers.enterFrame(context, pcIndex, hot)
    if result == native.word(pcIndex) then
        return resumeTop(context, pcIndex + native.load32(pc, 4) + 1)
    else
        return settle(context, result)
    end
end

-- A taken back edge while compiled frames are possible, before it is taken:
-- the loop moves into compiled code when its function has a frame entry, or
-- is compiled when this edge makes it hot. Otherwise the jump is taken here.
export function backEdge(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    displacement: int64
): uint64
    local target = native.offset(pc, (displacement + 1) * 16)
    if native.load32(context, native.layout("frame_mode")) == 0 then
        return native.dispatch(target, regs, ints, floats, context, frame)
    else
        local jit = native.load32(context, native.layout("jit_frames"))
        local frames = native.load64(context, native.layout("nframe_entries"))
        if native.both(jit == 0, frames == 0) then
            return native.dispatch(target, regs, ints, floats, context, frame)
        else
            local fid = native.load64(frame, 0) & 4294967295
            local info = native.offset(
                native.loadPointer(context, native.layout("funcs")),
                native.index(fid) * native.layout("FuncInfo.size")
            )
            local entry: uint64 = 0
            if fid < frames then
                entry = native.load64(
                    native.loadPointer(context, native.layout("frame_entries")),
                    native.index(fid) * 8
                )
            end
            local hot = false
            if native.both(entry == 0, jit ~= 0) then
                local calls = (native.load32(info, native.layout("FuncInfo.calls")) & 4294967295) + 1
                if calls < native.load32(context, native.layout("frame_threshold")) & 4294967295 then
                    native.store32(info, native.layout("FuncInfo.calls"), calls)
                else
                    native.store32(info, native.layout("FuncInfo.calls"), 0)
                    hot = true
                end
            end
            if native.either(native.both(entry ~= 0, entry ~= 18446744073709551615ULL), hot) then
                local code = native.loadPointer(info, native.layout("FuncInfo.code"))
                local pcIndex = native.index(native.address(pc) - native.address(code)) >> 4
                native.store64(frame, 0, (native.load64(frame, 0) & 4294967295) | (native.word(pcIndex) << 32))
                return backEdgeSlow(pc, context, pcIndex, native.chooseIndex(hot, 1, 0))
            else
                return native.dispatch(target, regs, ints, floats, context, frame)
            end
        end
    end
end

-- A return the Rust path must take: a cleanup or protected call at or above
-- this frame, an unwind in progress, or the task's own end.
export function Ret(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(native.both(guard ~= values.NO_GUARD, guard >= current), caller == values.LOW_WORD) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local value = native.load64(regs, native.load8(pc, 1) * 8)
        local flags = native.load64(frame, 24)
        local slot = native.chooseWord((flags >> 32) & 1 ~= 0, flags & values.LOW_WORD, link >> 32)
        native.store64(context, native.layout("result"), value)
        native.store64(native.loadPointer(context, native.layout("stack")), native.index(slot * 8), value)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 1)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

export function RetNil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(native.both(guard ~= values.NO_GUARD, guard >= current), caller == values.LOW_WORD) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        native.store64(native.loadPointer(context, native.layout("stack")), native.index((link >> 32) * 8), values.NIL)
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), 0)
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

export function RetN(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local count = native.load8(pc, 2)
    local guard = native.load64(context, native.layout("guard"))
    local current = native.load64(context, native.layout("cur"))
    local link = native.load64(frame, 8)
    local caller = link & values.LOW_WORD
    if native.either(
        native.either(count > 8, native.both(guard ~= values.NO_GUARD, guard >= current)),
        caller == values.LOW_WORD
    ) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local stack = native.loadPointer(context, native.layout("stack"))
        local results = native.index((link >> 32) * 8)
        local from = native.load8(pc, 1) * 8
        local copied: int64 = 0
        while copied < count do
            native.store64(stack, results + copied * 8, native.load64(regs, from + copied * 8))
            copied = copied + 1
        end
        if count == 0 then
            native.store64(stack, results, values.NIL)
        end
        native.store64(context, native.layout("cur"), caller)
        native.store64(context, native.layout("last_nres"), native.word(count))
        return resumeCaller(pc, regs, ints, floats, context, frame, caller)
    end
end

export function PadResults(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local wanted = native.load8(pc, 2)
    if wanted > 8 then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local base = native.load8(pc, 1)
        local filled: int64 = native.loadIndex(context, native.layout("last_nres"))
        while filled < wanted do
            native.store64(regs, (base + filled) * 8, values.NIL)
            filled = filled + 1
        end
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

-- A dynamic call through a register is the same path as `CallK`; the Rust
-- core shares one body between the two opcodes and so does this one.
export function CallDyn(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local nargs = native.load8(pc, 3)
    local value = native.load64(regs, native.load8(pc, 1) * 8)
    if nargs >= 64 then
        return native.slow(pc, regs, ints, floats, context, frame)
    elseif native.load32(context, native.layout("feedback")) ~= 0 then
        return observeCallSlow(pc, context, value, nargs)
    else
        return callValue(pc, regs, ints, floats, context, frame, value, nargs)
    end
end
