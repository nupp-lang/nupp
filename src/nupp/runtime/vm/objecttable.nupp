module nupp.runtime.vm.objecttable

const native = require("nupp.runtime.vm.intrinsics")
const objecthash = require("nupp.runtime.vm.objecthash")
const values = require("nupp.runtime.vm.values")
const heap = require("nupp.runtime.vm.heap")
const backing = require("nupp.runtime.vm.backing")

-- One canonical probe for hash tables and record overflow. A deleted value
-- keeps its key, so only a NIL key terminates the search. The returned bucket
-- either holds the key or is empty; MAX means no valid bucket was available.
export function tableProbe(table: voidptr, capacity: uint64, mask: uint64, key: uint64): uint64
    if native.address(table) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if key == values.NIL then
        return 0xffffffffffffffffULL
    end
    if capacity < 8ULL then
        return 0xffffffffffffffffULL
    end
    if capacity > 0x100000000ULL then
        return 0xffffffffffffffffULL
    end
    local below: uint64 = capacity - 1ULL
    if mask ~= below then
        return 0xffffffffffffffffULL
    end
    local remainder: uint64 = capacity & below
    if remainder ~= 0ULL then
        return 0xffffffffffffffffULL
    end
    local bucket: uint64 = objecthash.slotHash(key) & mask
    local probes: uint64 = 0ULL
    while probes < capacity do
        local found = native.load64(table, native.index(bucket * 16ULL))
        if found == key then
            return bucket
        end
        if found == values.NIL then
            return bucket
        end
        bucket = (bucket + 1ULL) & mask
        probes = probes + 1ULL
    end

    return 0xffffffffffffffffULL
end

-- Occupancy is at most three quarters, and order/rank store u32 indices.
-- Zero means no representable capacity, including an empty reservation.
export function tableCapacity(wanted: uint64): uint64
    if wanted == 0ULL then
        return 0ULL
    end
    if wanted > 0xc0000000ULL then
        return 0ULL
    end
    local capacity: uint64 = 8ULL
    while capacity * 3ULL < wanted * 4ULL do
        capacity = capacity << 1ULL
    end

    return capacity
end

export function tableNeedsGrowth(length: uint64, capacity: uint64): uint64
    if capacity < 8ULL then
        return 1ULL
    end
    if capacity > 0x100000000ULL then
        return 1ULL
    end
    if length >= 0xc0000000ULL then
        return 1ULL
    end
    local below: uint64 = capacity - 1ULL
    local remainder: uint64 = capacity & below
    if remainder ~= 0ULL then
        return 1ULL
    end
    if (length + 1ULL) * 4ULL > capacity * 3ULL then
        return 1ULL
    end

    return 0ULL
end

export function tableInitialize(table: voidptr, capacity: uint64): uint64
    if native.address(table) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if capacity < 8ULL then
        return 0xffffffffffffffffULL
    end
    if capacity > 0x100000000ULL then
        return 0xffffffffffffffffULL
    end
    local below: uint64 = capacity - 1ULL
    local remainder: uint64 = capacity & below
    if remainder ~= 0ULL then
        return 0xffffffffffffffffULL
    end
    local bucket: uint64 = 0ULL
    while bucket < capacity do
        native.store64(table, native.index(bucket * 16ULL), values.NIL)
        native.store64(table, native.index(bucket * 16ULL + 8ULL), 0ULL)
        bucket = bucket + 1ULL
    end

    return 0ULL
end

-- Order contains each occupied bucket once, including deleted values.
-- Borrowed source buffers stay owned and unchanged until rehash commits.
export function tableLiveCount(table: voidptr, order: voidptr, length: uint64, capacity: uint64): uint64
    if length == 0ULL then
        return 0ULL
    end
    if length > capacity then
        return 0xffffffffffffffffULL
    end
    if native.address(table) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if native.address(order) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if capacity < 8ULL then
        return 0xffffffffffffffffULL
    end
    if capacity > 0x100000000ULL then
        return 0xffffffffffffffffULL
    end
    local below: uint64 = capacity - 1ULL
    local remainder: uint64 = capacity & below
    if remainder ~= 0ULL then
        return 0xffffffffffffffffULL
    end
    local index: uint64 = 0ULL
    local live: uint64 = 0ULL
    while index < length do
        local bucket = native.word(native.load32(order, native.index(index * 4ULL))) & values.LOW_WORD
        if bucket >= capacity then
            return 0xffffffffffffffffULL
        end
        if native.load64(table, native.index(bucket * 16ULL)) == values.NIL then
            return 0xffffffffffffffffULL
        end
        if native.load64(table, native.index(bucket * 16ULL + 8ULL)) ~= values.NIL then
            live = live + 1ULL
        end
        index = index + 1ULL
    end

    return live
end

-- The target is separately owned and empty. Check dimensions, every source
-- index and target emptiness before writing; copy live entries in their old
-- order, rebuilding their ranks. The caller swaps owners only after success.
export function tableRehash(
    source: voidptr,
    order: voidptr,
    length: uint64,
    capacity: uint64,
    target: voidptr,
    targetOrder: voidptr,
    targetRank: voidptr,
    targetCapacity: uint64
): uint64
    if native.address(target) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if native.address(targetOrder) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if native.address(targetRank) == 0ULL then
        return 0xffffffffffffffffULL
    end
    if native.address(source) == native.address(target) then
        return 0xffffffffffffffffULL
    end
    if targetCapacity < 8ULL then
        return 0xffffffffffffffffULL
    end
    if targetCapacity > 0x100000000ULL then
        return 0xffffffffffffffffULL
    end
    local mask: uint64 = targetCapacity - 1ULL
    local remainder: uint64 = targetCapacity & mask
    if remainder ~= 0ULL then
        return 0xffffffffffffffffULL
    end
    local live = tableLiveCount(source, order, length, capacity)
    if live == 0xffffffffffffffffULL then
        return 0xffffffffffffffffULL
    end
    local wanted = tableCapacity(live + 1ULL)
    if wanted == 0ULL then
        return 0xffffffffffffffffULL
    end
    if wanted > targetCapacity then
        return 0xffffffffffffffffULL
    end
    local index: uint64 = 0ULL
    while index < targetCapacity do
        if native.load64(target, native.index(index * 16ULL)) ~= values.NIL then
            return 0xffffffffffffffffULL
        end
        index = index + 1ULL
    end
    index = 0ULL
    local copied: uint64 = 0ULL
    while index < length do
        local bucket = native.word(native.load32(order, native.index(index * 4ULL))) & values.LOW_WORD
        local value = native.load64(source, native.index(bucket * 16ULL + 8ULL))
        if value ~= values.NIL then
            local key = native.load64(source, native.index(bucket * 16ULL))
            local next = tableProbe(target, targetCapacity, mask, key)
            native.store64(target, native.index(next * 16ULL), key)
            native.store64(target, native.index(next * 16ULL + 8ULL), value)
            native.store32(targetOrder, native.index(copied * 4ULL), native.index(next))
            native.store32(targetRank, native.index(next * 4ULL), native.index(copied))
            copied = copied + 1ULL
        end
        index = index + 1ULL
    end

    return copied
end

-- Core callers prepare StringBody.hash on every live query and resident
-- string before using the content policy, and keep query/live-entry objects
-- rooted throughout the call. Dead NIL keys carry only opaque payloads. These
-- helpers never collect or compute an unprepared hash.
const NO_BUCKET: uint64 = 0xffffffffffffffffULL
-- Private NIL-valued core hash-key encoding, never a live Value. The catalog
-- reuses this bit pattern for serialized string offsets in a different domain;
-- those offsets are decoded before runtime stores. No payload header is read.
const DEAD_KEY: uint64 = 0x7ffe000000000000ULL

-- Requested payload extent, not allocator slot padding, identifies the tail.
-- The owner matches this collector; frozen VM tables have no such tail.
export function coretable(h: heap.Heap*, o: heap.Header*): boolean
    @unsafe do
        if o.kind as uint64 ~= heap.KIND_TABLE
            or (
                o.size as uint64
            ) < heap.HEADER_BYTES + native.sizeOf<heap.TableBody>() + native.sizeOf<heap.CoreTableTail>()
        then
            return false
        end
        local tail = native.pointer(
            native.address(o as voidptr) + heap.HEADER_BYTES + native.sizeOf<heap.TableBody>()
        ) as heap.CoreTableTail*
        return tail.owner == native.address(h as voidptr)
    end
end

-- Scan-time removal matches Lua's dead-key protocol even if a key is rooted.
-- A later minor may reclaim it without revisiting this table or card. The
-- range is in actual resident buckets; tagging never dereferences a key.
export function coredeadkeys(h: heap.Heap*, o: heap.Header*, first: uint64, last: uint64): nil
    if not coretable(h, o) then
        return
    end
    @unsafe do
        local t = native.pointer(native.address(o as voidptr) + heap.HEADER_BYTES) as heap.TableBody*
        if t.hashPtr == 0ULL then
            return
        end
        if last > t.hashCap then
            last = t.hashCap
        end
        local bucket = first
        while bucket < last do
            local offset = native.index(bucket * 16ULL)
            local key = native.load64(native.pointer(t.hashPtr), offset)
            if native.load64(native.pointer(t.hashPtr), native.index(bucket * 16ULL + 8ULL)) == values.NIL
                and key & values.TAG_MASK == values.TAG_OBJ
            then
                native.store64(native.pointer(t.hashPtr), offset, DEAD_KEY | (key & values.PAYLOAD))
            end
            bucket = bucket + 1ULL
        end
    end
end

local function corestring(key: uint64): uint64
    if key & values.TAG_MASK ~= values.TAG_OBJ then
        return 0ULL
    end
    local address = key & values.PAYLOAD
    if address == 0ULL
        or native.word(native.load8(native.pointer(address), native.fieldOffset<heap.Header>("kind"))) ~= heap.KIND_STR
    then
        return 0ULL
    end

    return address
end

local function corestringhash(address: uint64): uint64
    return native.load64(
        native.pointer(address + native.sizeOf<heap.Header>()),
        native.fieldOffset<heap.StringBody>("hash")
    )
end

local function corehash(key: uint64): uint64
    local string = corestring(key)
    if string ~= 0ULL then
        return corestringhash(string)
    end

    return objecthash.slotHash(key)
end

local function coreequal(left: uint64, right: uint64): boolean
    if left == right then
        return true
    end
    if left & 0xffff000000000000ULL == DEAD_KEY then
        return right & values.TAG_MASK == values.TAG_OBJ and left & values.PAYLOAD == right & values.PAYLOAD
    end
    local a = corestring(left)
    local b = corestring(right)
    if a == 0ULL or b == 0ULL then
        return false
    end
    local length = native.load64(native.pointer(a), native.fieldOffset<heap.Header>("auxLen"))
    if length ~= native.load64(native.pointer(b), native.fieldOffset<heap.Header>("auxLen"))
        or corestringhash(a) ~= corestringhash(b)
    then
        return false
    end
    local bytesA = native.load64(native.pointer(a), native.fieldOffset<heap.Header>("auxPtr"))
    local bytesB = native.load64(native.pointer(b), native.fieldOffset<heap.Header>("auxPtr"))
    local index: uint64 = 0ULL
    while index < length do
        if native.load8(
            native.pointer(bytesA),
            native.index(index)
        ) ~= native.load8(native.pointer(bytesB), native.index(index)) then
            return false
        end
        index = index + 1ULL
    end

    return true
end

-- Content-key variants are outside the frozen VM's raw leaf contract.
export function coreprobe(table: voidptr, capacity: uint64, mask: uint64, key: uint64): uint64
    if native.address(table) == 0ULL then
        return NO_BUCKET
    end
    if key == values.NIL then
        return NO_BUCKET
    end
    if capacity < 8ULL then
        return NO_BUCKET
    end
    if capacity > 0x100000000ULL then
        return NO_BUCKET
    end
    local below: uint64 = capacity - 1ULL
    if mask ~= below then
        return NO_BUCKET
    end
    local remainder: uint64 = capacity & below
    if remainder ~= 0ULL then
        return NO_BUCKET
    end
    local bucket: uint64 = corehash(key) & mask
    local probes: uint64 = 0ULL
    while probes < capacity do
        local found = native.load64(table, native.index(bucket * 16ULL))
        -- Scanned NIL keys are opaque. Unscanned deleted keys remain live
        -- until the next table/card scan and still compare by content.
        if coreequal(found, key) then
            return bucket
        end
        if found == values.NIL then
            return bucket
        end
        bucket = (bucket + 1ULL) & mask
        probes = probes + 1ULL
    end

    return NO_BUCKET
end

export function corerehash(
    source: voidptr,
    order: voidptr,
    length: uint64,
    capacity: uint64,
    target: voidptr,
    targetOrder: voidptr,
    targetRank: voidptr,
    targetCapacity: uint64
): uint64
    if native.address(target) == 0ULL then
        return NO_BUCKET
    end
    if native.address(targetOrder) == 0ULL then
        return NO_BUCKET
    end
    if native.address(targetRank) == 0ULL then
        return NO_BUCKET
    end
    if native.address(source) == native.address(target) then
        return NO_BUCKET
    end
    if targetCapacity < 8ULL then
        return NO_BUCKET
    end
    if targetCapacity > 0x100000000ULL then
        return NO_BUCKET
    end
    local mask: uint64 = targetCapacity - 1ULL
    local remainder: uint64 = targetCapacity & mask
    if remainder ~= 0ULL then
        return NO_BUCKET
    end
    local live = tableLiveCount(source, order, length, capacity)
    if live == NO_BUCKET then
        return NO_BUCKET
    end
    local wanted = tableCapacity(live + 1ULL)
    if wanted == 0ULL then
        return NO_BUCKET
    end
    if wanted > targetCapacity then
        return NO_BUCKET
    end
    local index: uint64 = 0ULL
    while index < targetCapacity do
        if native.load64(target, native.index(index * 16ULL)) ~= values.NIL then
            return NO_BUCKET
        end
        index = index + 1ULL
    end
    index = 0ULL
    local copied: uint64 = 0ULL
    while index < length do
        local bucket = native.word(native.load32(order, native.index(index * 4ULL))) & values.LOW_WORD
        local value = native.load64(source, native.index(bucket * 16ULL + 8ULL))
        if value ~= values.NIL then
            local key = native.load64(source, native.index(bucket * 16ULL))
            local next = coreprobe(target, targetCapacity, mask, key)
            native.store64(target, native.index(next * 16ULL), key)
            native.store64(target, native.index(next * 16ULL + 8ULL), value)
            native.store32(targetOrder, native.index(copied * 4ULL), native.index(next))
            native.store32(targetRank, native.index(next * 4ULL), native.index(copied))
            copied = copied + 1ULL
        end
        index = index + 1ULL
    end

    return copied
end

local function ownedprobe(table: voidptr, capacity: uint64, mask: uint64, key: uint64, core: boolean): uint64
    if core then
        return coreprobe(table, capacity, mask, key)
    end

    return tableProbe(table, capacity, mask, key)
end

local function ownedequal(left: uint64, right: uint64, core: boolean): boolean
    if core then
        return coreequal(left, right)
    end

    return left == right
end

-- Owned descriptors use the same pooled/mapped word backing as value arrays.
-- Buckets occupy 2*capacity words, followed by capacity u32 order and rank
-- entries. No operation collects, invokes guest code, or lends a movable view.
local function tableOwnedValid(t: heap.ValueTable*): boolean
    @unsafe do
        if t.owner == 0ULL then
            return false
        end
        if t.capacity == 0ULL then
            return t.ptr == 0ULL and t.mask == 0ULL and t.length == 0ULL and t.order == 0ULL and t.rank == 0ULL
        end
        if t.ptr == 0ULL or t.capacity < 8ULL or t.capacity > 0x100000000ULL then
            return false
        end
        if t.mask ~= t.capacity - 1ULL or t.capacity & t.mask ~= 0ULL or t.length > t.capacity then
            return false
        end
        return t.order == t.ptr + t.capacity * 16ULL and t.rank == t.ptr + t.capacity * 20ULL
    end
end

local function tableOwnedTake(owner: uint64, capacity: uint64): uint64
    local base = backing.wordBackingTake(native.pointer(owner) as heap.Heap*, capacity * 3ULL)
    if base == 0ULL then
        return 0ULL
    end
    if tableInitialize(native.pointer(base), capacity) ~= 0ULL then
        backing.wordBackingRelease(base)
        return 0ULL
    end
    local i: uint64 = 0ULL
    while i < capacity do
        native.store32(native.pointer(base + capacity * 16ULL), native.index(i * 4ULL), 0)
        native.store32(native.pointer(base + capacity * 20ULL), native.index(i * 4ULL), 0)
        i = i + 1ULL
    end

    return base
end

-- Initialization accepts a fresh empty descriptor only. Invalid extents do not
-- write it. A backing refusal leaves a valid empty descriptor with its owner.
export function tableOwnedInitialize(t: heap.ValueTable*, owner: heap.Heap*, wanted: uint64): uint64
    local address = native.address(owner as voidptr)
    local capacity = tableCapacity(wanted)
    if address == 0ULL or (wanted ~= 0ULL and capacity == 0ULL) then
        return 1ULL
    end
    @unsafe do
        if t.ptr ~= 0ULL
            or t.mask ~= 0ULL
            or t.capacity ~= 0ULL
            or t.length ~= 0ULL
            or t.order ~= 0ULL
            or t.rank ~= 0ULL
        then
            return 1ULL
        end
        t.owner = address
        if capacity == 0ULL then
            return 0ULL
        end
        local base = tableOwnedTake(address, capacity)
        if base == 0ULL then
            return 2ULL
        end
        t.ptr = base
        t.mask = capacity - 1ULL
        t.capacity = capacity
        t.order = base + capacity * 16ULL
        t.rank = base + capacity * 20ULL
        return 0ULL
    end
end

export function tableOwnedRelease(t: heap.ValueTable*): nil
    @unsafe do
        backing.wordBackingRelease(t.ptr)
        t.ptr = 0ULL
        t.mask = 0ULL
        t.capacity = 0ULL
        t.length = 0ULL
        t.order = 0ULL
        t.rank = 0ULL
    end
end

-- The source and every descriptor field remain unchanged until a separately
-- owned target has been completely initialized and rehashed successfully.
local function ownedgrow(t: heap.ValueTable*, core: boolean): uint64
    if not tableOwnedValid(t) then
        return 1ULL
    end
    @unsafe do
        local live = tableLiveCount(native.pointer(t.ptr), native.pointer(t.order), t.length, t.capacity)
        if live == 0xffffffffffffffffULL then
            return 1ULL
        end
        local capacity = tableCapacity(live + 1ULL)
        if capacity == 0ULL then
            return 1ULL
        end
        local base = tableOwnedTake(t.owner, capacity)
        if base == 0ULL then
            return 2ULL
        end
        local order = base + capacity * 16ULL
        local rank = base + capacity * 20ULL
        local copied: uint64 = 0ULL
        if core then
            copied = corerehash(
                native.pointer(t.ptr),
                native.pointer(t.order),
                t.length,
                t.capacity,
                native.pointer(base),
                native.pointer(order),
                native.pointer(rank),
                capacity
            )
        else
            copied = tableRehash(
                native.pointer(t.ptr),
                native.pointer(t.order),
                t.length,
                t.capacity,
                native.pointer(base),
                native.pointer(order),
                native.pointer(rank),
                capacity
            )
        end
        if copied ~= live then
            backing.wordBackingRelease(base)
            return 1ULL
        end
        local old = t.ptr
        t.ptr = base
        t.mask = capacity - 1ULL
        t.capacity = capacity
        t.length = copied
        t.order = order
        t.rank = rank
        backing.wordBackingRelease(old)
        return 0ULL
    end
end

-- Appends at a prevalidated empty bucket, shared by the managed table handler
-- and owned insertion. The caller has reserved room and applied GC barriers.
export function tableWriteEntry(t: heap.ValueTable*, key: uint64, value: uint64, bucket: uint64): nil
    @unsafe do
        native.store64(native.pointer(t.ptr), native.index(bucket * 16ULL), key)
        native.store64(native.pointer(t.ptr), native.index(bucket * 16ULL + 8ULL), value)
        native.store32(native.pointer(t.order), native.index(t.length * 4ULL), native.index(bucket))
        native.store32(native.pointer(t.rank), native.index(bucket * 4ULL), native.index(t.length))
        t.length = t.length + 1ULL
    end
end

local function ownedinsert(t: heap.ValueTable*, key: uint64, value: uint64, core: boolean): uint64
    if not tableOwnedValid(t) then
        return 1ULL
    end
    if key == values.NIL then
        return 0ULL
    end
    @unsafe do
        local bucket = ownedprobe(native.pointer(t.ptr), t.capacity, t.mask, key, core)
        if bucket ~= 0xffffffffffffffffULL then
            local resident = native.load64(native.pointer(t.ptr), native.index(bucket * 16ULL))
            if ownedequal(resident, key, core) then
                -- A dead identity match becomes traceable before publication.
                -- Live replacements keep their original resident key and rank.
                if core and value ~= values.NIL and resident & 0xffff000000000000ULL == DEAD_KEY then
                    native.store64(native.pointer(t.ptr), native.index(bucket * 16ULL), key)
                end
                native.store64(native.pointer(t.ptr), native.index(bucket * 16ULL + 8ULL), value)
                return 0ULL
            end
        end
        if value == values.NIL then
            return 0ULL
        end
        if tableNeedsGrowth(t.length, t.capacity) ~= 0ULL then
            local status = ownedgrow(t, core)
            if status ~= 0ULL then
                return status
            end
            bucket = ownedprobe(native.pointer(t.ptr), t.capacity, t.mask, key, core)
        end
        if bucket == 0xffffffffffffffffULL then
            return 1ULL
        end
        tableWriteEntry(t, key, value, bucket)
        return 0ULL
    end
end

local function ownedgetslot(t: heap.ValueTable*, key: uint64, core: boolean): uint64
    @unsafe do
        local bucket = ownedprobe(native.pointer(t.ptr), t.capacity, t.mask, key, core)
        if bucket == 0xffffffffffffffffULL then
            return 0ULL
        end
        local address = t.ptr + bucket * 16ULL
        if not ownedequal(native.load64(native.pointer(address), 0), key, core)
            or native.load64(native.pointer(address), 8) == values.NIL
        then
            return 0ULL
        end
        return address + 8ULL
    end
end

-- An order position includes a retained tombstone. MAX means no such entry.
export function tableOwnedEntryBucket(t: heap.ValueTable*, position: uint64): uint64
    @unsafe do
        if position >= t.length or t.ptr == 0ULL then
            return 0xffffffffffffffffULL
        end
        local bucket = native.word(native.load32(native.pointer(t.order), native.index(position * 4ULL)))
            & values.LOW_WORD
        if bucket >= t.capacity then
            return 0xffffffffffffffffULL
        end
        return bucket
    end
end

local function ownedposition(t: heap.ValueTable*, key: uint64, core: boolean): uint64
    @unsafe do
        local bucket = ownedprobe(native.pointer(t.ptr), t.capacity, t.mask, key, core)
        if bucket == 0xffffffffffffffffULL then
            return bucket
        end
        if not ownedequal(native.load64(native.pointer(t.ptr), native.index(bucket * 16ULL)), key, core) then
            return 0xffffffffffffffffULL
        end
        return native.word(native.load32(native.pointer(t.rank), native.index(bucket * 4ULL))) & values.LOW_WORD
    end
end

export function tableOwnedNextPosition(t: heap.ValueTable*, start: uint64): uint64
    @unsafe do
        local position = start
        while position < t.length do
            local bucket = tableOwnedEntryBucket(t, position)
            if bucket == 0xffffffffffffffffULL then
                return bucket
            end
            if native.load64(native.pointer(t.ptr), native.index(bucket * 16ULL + 8ULL)) ~= values.NIL then
                return position
            end
            position = position + 1ULL
        end
        return 0xffffffffffffffffULL
    end
end

local function ownednext(t: heap.ValueTable*, key: uint64, core: boolean): uint64
    local start: uint64 = 0ULL
    if key ~= values.NIL then
        local position = ownedposition(t, key, core)
        if position == 0xffffffffffffffffULL then
            return position
        end
        start = position + 1ULL
    end

    return tableOwnedNextPosition(t, start)
end

-- Logical owned backing includes buckets plus both insertion-order arrays.
export function tableOwnedBytes(t: heap.ValueTable*): uint64
    return @unsafe t.capacity * 24ULL
end

-- Identity wrappers preserve the shared VM's existing key policy.
export function tableOwnedGrow(t: heap.ValueTable*): uint64
    return ownedgrow(t, false)
end

export function tableOwnedInsert(t: heap.ValueTable*, key: uint64, value: uint64): uint64
    return ownedinsert(t, key, value, false)
end

export function tableOwnedGetSlot(t: heap.ValueTable*, key: uint64): uint64
    return ownedgetslot(t, key, false)
end

export function tableOwnedPosition(t: heap.ValueTable*, key: uint64): uint64
    return ownedposition(t, key, false)
end

export function tableOwnedNextAfter(t: heap.ValueTable*, key: uint64): uint64
    return ownednext(t, key, false)
end

-- Use one key policy consistently for a descriptor; never reinterpret an
-- identity table that may already hold multiple equal-content string keys.
-- Core wrappers require prepared hashes for all live query and resident strings.
-- Unscanned NIL keys compare by content; scanned keys match only by identity.
-- Core collectors must tag NIL OBJ keys before reclaiming their referents.
-- Initialization, release, entry buckets and next positions share no key policy.
export function coregrow(t: heap.ValueTable*): uint64
    return ownedgrow(t, true)
end

export function coreinsert(t: heap.ValueTable*, key: uint64, value: uint64): uint64
    return ownedinsert(t, key, value, true)
end

export function coregetslot(t: heap.ValueTable*, key: uint64): uint64
    return ownedgetslot(t, key, true)
end

export function coreposition(t: heap.ValueTable*, key: uint64): uint64
    return ownedposition(t, key, true)
end

export function corenext(t: heap.ValueTable*, key: uint64): uint64
    return ownednext(t, key, true)
end
