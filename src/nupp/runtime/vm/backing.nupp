module nupp.runtime.vm.backing

-- Shared word backing for canonical arrays and hash tables. The owner and its
-- arena outlive every allocation. Growth never collects or calls guest code.
const native = require("nupp.runtime.vm.intrinsics")
const arena = require("nupp.runtime.vm.arena")
const heap = require("nupp.runtime.vm.heap")
const os = require("nupp.runtime.vm.os")

export function wordBackingPrefix(): uint64
    return native.sizeOf<heap.ArrayBacking>()
end

export function wordBackingMaximum(): uint64
    return (0x7fffffffffffffffULL - wordBackingPrefix()) // 8ULL
end

export function wordBackingRelease(base: uint64): nil
    @unsafe do
        if base == 0ULL then
            return
        end
        local raw = native.pointer(base - wordBackingPrefix())
        local pool = native.load64(raw, 0)
        if pool ~= 0ULL then
            arena.give(native.pointer(pool) as arena.Pool*, raw)
        else
            os.unmapPages(raw, native.load64(raw, 8))
        end
    end
end

export function wordBackingTake(owner: heap.Heap*, capacity: uint64): uint64
    if capacity > wordBackingMaximum() then
        return 0ULL
    end
    @unsafe do
        local bytes = capacity * 8ULL + wordBackingPrefix()
        if capacity <= 4096ULL then
            local class: uint64 = 0ULL
            local room: uint64 = 4ULL
            while room < capacity do
                room = room << 1ULL
                class = class + 1ULL
            end
            local at = native.index(class * native.sizeOf<heap.ArrayPoolSlot>())
            local poolAddress = native.load64(native.pointer(owner.arrayPools), at)
            if poolAddress == 0ULL then
                local pool = arena.pool(owner.grayPool.arena, room * 8ULL + wordBackingPrefix())
                if pool == nil then
                    return 0ULL
                end
                poolAddress = native.address(pool as voidptr)
                native.store64(native.pointer(owner.arrayPools), at, poolAddress)
            end
            local currentPool = native.pointer(poolAddress) as arena.Pool*
            local raw = arena.take(currentPool)
            if raw == nil then
                return 0ULL
            end
            local prefix = raw as heap.ArrayBacking*
            prefix.pool = poolAddress
            prefix.mapped = 0ULL
            return native.address(raw as voidptr) + wordBackingPrefix()
        end
        local page = os.pageSize()
        local mapped = (bytes + page - 1ULL) & ~(page - 1ULL)
        local raw = os.mapPages(mapped)
        if raw == nil then
            return 0ULL
        end
        local prefix = raw as heap.ArrayBacking*
        prefix.pool = 0ULL
        prefix.mapped = mapped
        return native.address(raw as voidptr) + wordBackingPrefix()
    end
end
