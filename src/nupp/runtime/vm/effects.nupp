module nupp.runtime.vm.effects

@annotation(targets = {"field"})
export record vmHelperEffects
    mayCollect: boolean
    mayPark: boolean
    mayRaise: boolean
    pure: boolean
end

@annotation(targets = {"field"})
export record vmSlotAccess
    class: string
    kind: string
    write: boolean
end

@annotation(targets = {"field"})
export record vmProgramLoad
    source: string
    kind: string
    lifetime: string
end
