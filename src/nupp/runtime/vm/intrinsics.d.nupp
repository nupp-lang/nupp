-- The intrinsics the native runtime sources are written against. These
-- have no guest implementation: the native compiler must consume every call.
local record Native
    sizeOf: function<T>(): uint64
    alignmentOf: function<T>(): uint64
    stackBytes: function(size: int64): voidptr
    load16: function(base: voidptr, offset: int64): int64
    store8: function(base: voidptr, offset: int64, value: uint64): nil
    store16: function(base: voidptr, offset: int64, value: uint64): nil
    floatBits: function(value: float64): uint64
    floatFromBits: function(value: uint64): float64
    roundFloat: function(value: float64): float64
    sqrt: function(value: float64): float64
    sqrtFloat: function(value: float64): float64
    ceil: function(value: float64): float64
    fma: function(a: float64, b: float64, c: float64): float64
    fmaFloat: function(a: float64, b: float64, c: float64): float64
    unsignedMulHigh: function(a: uint64, b: uint64): uint64
    signedMulHigh: function(a: int64, b: int64): uint64
    signedQuotient: function(a: int64, b: int64): int64
    popcount: function(value: uint64): uint64
    loadFloat: function(base: voidptr, offset: int64): float64
    storeFloat: function(base: voidptr, offset: int64, value: float64): nil
    bits: function(value: float64): uint64
    fromBits: function(value: uint64): float64
    pointer: function(value: uint64): voidptr
    floor: function(value: float64): float64
    neg: function(value: float64): float64
    toFloat: function(value: int64): float64
    toInt: function(value: float64): int64
    both: function(left: boolean, right: boolean): boolean
    either: function(left: boolean, right: boolean): boolean
    chooseWord: function(condition: boolean, yes: uint64, no: uint64): uint64
    unsignedFloat: function(value: uint64): float64
    unsignedInt: function(value: float64): uint64
    index: function(value: uint64): int64
    word: function(value: int64): uint64
    address: function(value: voidptr): uint64
    chooseIndex: function(condition: boolean, yes: int64, no: int64): int64
    asWord: function(value: boolean): uint64
    layout: function(field: string): int64
    reenter: function(): uint64
    fail: function(): uint64
    load8: function(base: voidptr, offset: int64): int64
    load32: function(base: voidptr, offset: int64): int64
    load64: function(base: voidptr, offset: int64): uint64
    loadIndex: function(base: voidptr, offset: int64): int64
    loadPointer: function(base: voidptr, offset: int64): voidptr
    store32: function(base: voidptr, offset: int64, value: int64): nil
    store64: function(base: voidptr, offset: int64, value: uint64): nil
    storeIndex: function(base: voidptr, offset: int64, value: int64): nil
    storePointer: function(base: voidptr, offset: int64, value: voidptr): nil
    offset: function(base: voidptr, offset: int64): voidptr
    dispatch: function(
        pc: voidptr,
        regs: voidptr,
        ints: voidptr,
        floats: voidptr,
        context: voidptr,
        frame: voidptr
    ): uint64
    helper: function(context: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, frame: voidptr): nil
end
return Native
