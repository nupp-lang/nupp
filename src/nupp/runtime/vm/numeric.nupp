export function Mod(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return arithmeticSlow(
        pc,
        context,
        slots.readValue(frame, regs, program.readByte(pc, 2)),
