        6
    )
end

local function negateSlow(pc: voidptr, context: voidptr, value: uint64): uint64
    protocol.publishPc(pc, context)
    local kind = integerKind(value)
    if kind >= 0 then
        local result = managed.boxInteger(context, 0ULL - helpers.integerBits(value), 0)
        return protocol.continueAfter(pc, context, program.readByte(pc, 1), result, true)
    end
    local packet = native.stackBytes(24)
    helpers.unaryOperand(context, value, packet)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    if native.load64(packet, 0) ~= 0ULL then
        return protocol.continueAfter(pc, context, program.readByte(pc, 1), native.load64(packet, 8), true)
    end
    local coerced = native.load64(packet, 16)
    kind = integerKind(coerced)
    if kind >= 0 then
        local result = managed.boxInteger(context, 0ULL - helpers.integerBits(coerced), 0)
        return protocol.continueAfter(pc, context, program.readByte(pc, 1), result, true)
    end

    return protocol.continueAfter(
        pc,
        context,
        program.readByte(pc, 1),
        numberBits(native.neg(native.fromBits(coerced))),
        true
    )
end

export function Neg(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, program.readByte(pc, 2))
    if isNumber(value) then
        slots.writeValue(frame, regs, program.readByte(pc, 1), numberBits(native.neg(native.fromBits(value))))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end

    return negateSlow(pc, context, value)
end

local function integerFloatOrder(bits: uint64, unsigned: boolean, number: number): int64
    if number ~= number then
        return 2
    end
    if number >= 18446744073709551616.0 then
        return -1
    elseif number < -values.INT64_RANGE then
        return 1
    end
    local truncated: number = 0.0
    if number >= 0.0 then
        if not unsigned and native.index(bits) < 0 then
            return -1
        end
        local other = native.unsignedInt(number)
        if bits < other then
            return -1
        elseif bits > other then
            return 1
        end
        truncated = native.unsignedFloat(other)
    else
        if unsigned or native.index(bits) >= 0 then
            return 1
        end
        local other = native.toInt(number)
        if native.index(bits) < other then
            return -1
        elseif native.index(bits) > other then
            return 1
        end
        truncated = native.toFloat(other)
    end
    if number > truncated then
        return -1
    elseif number < truncated then
        return 1
    end

    return 0
end

local function numericOrder(left: uint64, right: uint64): int64
    local xkind = integerKind(left)
    local ykind = integerKind(right)
    if xkind >= 0 and ykind >= 0 then
        local x = helpers.integerBits(left)
        local y = helpers.integerBits(right)
        local xn: boolean = native.index(x) < 0
        local yn: boolean = native.index(y) < 0
        if xn ~= yn then
            return native.chooseIndex(xn, -1, 1)
        end
        if x < y then
            return -1
        elseif x > y then
            return 1
        end
        return 0
    elseif xkind >= 0 then
        return integerFloatOrder(helpers.integerBits(left), false, native.fromBits(right))
    elseif ykind >= 0 then
        local order = integerFloatOrder(helpers.integerBits(right), false, native.fromBits(left))
        return native.chooseIndex(order == 2, 2, 0 - order)
    end
    local x = native.fromBits(left)
    local y = native.fromBits(right)
    if x ~= x or y ~= y then
        return 2
    end
    if x < y then
        return -1
    elseif x > y then
        return 1
    end

    return 0
end

export function orderSlow(pc: voidptr, context: voidptr, left: uint64, right: uint64, orEqual: uint64): uint64
    protocol.publishPc(pc, context)
    if isNumeric(left) and isNumeric(right) then
        local order = numericOrder(left, right)
        local answer: boolean = order == -1 or (orEqual ~= 0ULL and order == 0)
        return protocol.continueAfter(
            pc,
            context,
            program.readByte(pc, 1),
            native.chooseWord(answer, values.TRUE, values.FALSE),
            true
        )
    end
    local callback = helpers.sharedMetamethod(context, left, right, native.chooseIndex(orEqual == 0ULL, 0, 1))
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    if callback ~= values.NIL then
        local result = helpers.binaryCallback(context, callback, left, right)
        if native.load32(context, native.layout("status")) == -4 then
            return native.fail()
        end
        local answer: boolean = result ~= values.NIL and result ~= values.FALSE
        return protocol.continueAfter(
            pc,
            context,
            program.readByte(pc, 1),
            native.chooseWord(answer, values.TRUE, values.FALSE),
            true
        )
    end
    if orEqual ~= 0ULL then
        callback = helpers.sharedMetamethod(context, left, right, 0)
        if native.load32(context, native.layout("status")) == -4 then
            return native.fail()
        end
        if callback ~= values.NIL then
            local result = helpers.binaryCallback(context, callback, right, left)
            if native.load32(context, native.layout("status")) == -4 then
                return native.fail()
            end
            local answer: boolean = result == values.NIL or result == values.FALSE
            return protocol.continueAfter(
                pc,
                context,
                program.readByte(pc, 1),
                native.chooseWord(answer, values.TRUE, values.FALSE),
                true
            )
        end
    end
    helpers.orderError(context, left, right)

    return native.fail()
end

export function equalNumbers(left: uint64, right: uint64): boolean
    return numericOrder(left, right) == 0
end
