export function LoopFact(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function GuardLenLe(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    if slots.readIntegerBits(
        frame,
        ints,
        program.readByte(pc, 1)
    ) > slots.readIntegerBits(frame, ints, program.readByte(pc, 2)) then
        return failSlow(pc, context, 3)
    end

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function FFma(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = native.fma(
        slots.readFloat(frame, floats, program.readByte(pc, 2)),
        slots.readFloat(frame, floats, program.readByte(pc, 3)),
        slots.readFloat(frame, floats, program.readByte(pc, 4))
    )
    slots.writeFloat(frame, floats, program.readByte(pc, 1), value)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VMov(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local low, high = slots.readVectorLow(frame, vecs, x), slots.readVectorHigh(frame, vecs, x)
    slots.writeVectorLow(frame, vecs, d, low)
    slots.writeVectorHigh(frame, vecs, d, high)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VSplat(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local bits = native.bits(slots.readFloat(frame, floats, x))
    slots.writeVectorLow(frame, vecs, d, bits)
    slots.writeVectorHigh(frame, vecs, d, bits)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VAdd(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local y = program.readByte(pc, 3)
    local ax, ay = native.fromBits(
        slots.readVectorLow(frame, vecs, x)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, x))
    local bx, by = native.fromBits(
        slots.readVectorLow(frame, vecs, y)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, y))
    local low, high = ax + bx, ay + by
    slots.writeVectorLow(frame, vecs, d, native.bits(low))
    slots.writeVectorHigh(frame, vecs, d, native.bits(high))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VMul(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local y = program.readByte(pc, 3)
    local ax, ay = native.fromBits(
        slots.readVectorLow(frame, vecs, x)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, x))
    local bx, by = native.fromBits(
        slots.readVectorLow(frame, vecs, y)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, y))
    local low, high = ax * bx, ay * by
    slots.writeVectorLow(frame, vecs, d, native.bits(low))
    slots.writeVectorHigh(frame, vecs, d, native.bits(high))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VFma(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local y = program.readByte(pc, 3)
    local ax, ay = native.fromBits(
        slots.readVectorLow(frame, vecs, x)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, x))
    local bx, by = native.fromBits(
        slots.readVectorLow(frame, vecs, y)
    ), native.fromBits(slots.readVectorHigh(frame, vecs, y))
    local z = program.readByte(pc, 4)
    local low = native.fma(ax, bx, native.fromBits(slots.readVectorLow(frame, vecs, z)))
    local high = native.fma(ay, by, native.fromBits(slots.readVectorHigh(frame, vecs, z)))
    slots.writeVectorLow(frame, vecs, d, native.bits(low))
    slots.writeVectorHigh(frame, vecs, d, native.bits(high))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VLane(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local bits = slots.readVectorLow(frame, vecs, x)
    if program.readByte(pc, 3) ~= 0 then
        bits = slots.readVectorHigh(frame, vecs, x)
    end
    slots.writeFloat(frame, floats, d, native.fromBits(bits))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function VAny(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local vecs = vectors(frame, context)
    local d, x = program.readByte(pc, 1), program.readByte(pc, 2)
    local bits = slots.readVectorLow(frame, vecs, x) | slots.readVectorHigh(frame, vecs, x)
    slots.writeIntegerBits(frame, ints, d, native.asWord(bits ~= 0ULL))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

