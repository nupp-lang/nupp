module nupp.runtime.vm.specialization

-- These functions have ordinary interpreter meanings. Their checked metadata
-- lets the Nupp semantic pipeline impose requirements when deriving guest code.
-- Context balance, exceptional exits and resume roots remain graph obligations.
@annotation(targets = {"function"})
export record vmSpecialization
    operation: string
end

--- Returns `value`, requiring a constant when deriving guest code.
@vmSpecialization(operation = "assertConstant")
export function assertConstant<T>(takes value: T): T preserves value
    return value
end

--- Returns `value` with a bounded domain for derived specialization.
---
--- Values outside the domain retain ordinary behavior. Bounds do not assert
--- a runtime range; the semantic consumer validates their finite variant cost.
@vmSpecialization(operation = "specializeValue")
export function specializeValue(value: int64, low: int64, high: int64): int64
    return value
end

--- Starts a specialization context without changing interpreter state.
@vmSpecialization(operation = "pushContext")
export function pushContext(key: int64): nil
end

--- Ends a specialization context without changing interpreter state.
@vmSpecialization(operation = "popContext")
export function popContext(): nil
end

--- Returns whether execution uses the ordinary interpreter meaning.
@vmSpecialization(operation = "inInterpreter")
export function inInterpreter(): boolean
    return true
end
