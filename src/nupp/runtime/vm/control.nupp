module nupp.runtime.vm.control

--[[
Protected calls, raises, cleanups and jump tables (contracts 5.2b, 6.4a,
6.5, 6.5b). A protected call is a frame like any other, with a record the
task keeps beside its frames; a cleanup is a record of the task's list,
which the core reads and rewrites in place through `cleanups` and
`ncleanups` in the context. Rust alone grows those lists, and settles what
touches the scheduler or runs code: a protected callee's return and a raise
below it, and an unwind that has cleanups to run. A frame's own cleanups are
the records at the end of the list whose frame is the frame on top; a depth
counts from the first of them.
]]

const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")
const calls = require("nupp.runtime.vm.calls")

-- PCall itself is not a budget point. Its target uses the same Nupp call
-- transfers, including typed/spread frames and managed services.
export function PCall(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return calls.protectedCallSlow(pc, context, program.readByte(pc, 1), program.readByte(pc, 2), values.NIL)
end

local function raiseSlow(pc: voidptr, context: voidptr, value: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.raise(context, value)
    return native.fail()
end

-- `Raise k`: the constant raised. The Rust frame that entered the core
-- re-raises it where a protected call can catch it (contracts 6.4a).
export function Raise(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )

    return raiseSlow(
        pc,
        context,
        native.load64(native.loadPointer(info, native.layout("FuncInfo.consts")), program.readSigned32(pc, 4) * 8)
    )
end

local function deferSlow(pc: voidptr, context: voidptr, value: uint64, callback: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.defer(context, value, callback)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- `Defer v c`: a cleanup calling `c` on `v` when its region or the frame ends.
export function Defer(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return deferSlow(
        pc,
        context,
        slots.readValue(frame, regs, program.readByte(pc, 1)),
        slots.readValue(frame, regs, program.readByte(pc, 2))
    )
end

local function deferMethodSlow(pc: voidptr, context: voidptr, value: uint64, name: uint64): uint64
    protocol.publishPc(pc, context)
    local callback = helpers.resolveCleanup(context, value, name)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    helpers.defer(context, value, callback)

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- `DeferMethod v k`: a cleanup calling the method constant `k` names on `v`,
-- resolved now; nil defers nothing that runs. A receiver that is not an
-- object, or is a string, is the step's.
export function DeferMethod(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, program.readByte(pc, 1))
    if value == values.NIL then
        return deferSlow(pc, context, value, values.NIL)
    end
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )

    return deferMethodSlow(
        pc,
        context,
        value,
        native.load64(native.loadPointer(info, native.layout("FuncInfo.consts")), program.readSigned32(pc, 4) * 8)
    )
end

-- `CleanupLive d depth`: whether the frame's cleanup at `depth` is armed.
export function CleanupLive(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local records = native.loadPointer(context, native.layout("cleanups"))
    local size = native.layout("Cleanup.size")
    local n = native.loadIndex(context, native.layout("ncleanups"))
    local current = native.load64(context, native.layout("cur"))
    local start = n
    while start > 0 do
        if native.load64(records, (start - 1) * size + native.layout("Cleanup.frame")) < current then
            break
        end
        start = start - 1
    end
    local slot = start + program.readSigned32(pc, 4)
    local live = false
    if slot < n then
        live = native.load64(records, slot * size + native.layout("Cleanup.value")) ~= values.NIL
    end
    slots.writeValue(frame, regs, program.readByte(pc, 1), native.chooseWord(live, values.TRUE, values.FALSE))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function invalidCleanupSlow(pc: voidptr, context: voidptr): uint64
    protocol.publishPc(pc, context)
    helpers.cleanupSlotError(context)
    return native.fail()
end

-- `DisarmAt depth`: the frame's cleanup at `depth` runs nothing, its value
-- transferred elsewhere. A depth past the frame's cleanups is the step's,
-- which refuses it.
export function DisarmAt(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local records = native.loadPointer(context, native.layout("cleanups"))
    local size = native.layout("Cleanup.size")
    local n = native.loadIndex(context, native.layout("ncleanups"))
    local current = native.load64(context, native.layout("cur"))
    local start = n
    while start > 0 do
        if native.load64(records, (start - 1) * size + native.layout("Cleanup.frame")) < current then
            break
        end
        start = start - 1
    end
    local slot = start + program.readSigned32(pc, 4)
    if slot >= n then
        return invalidCleanupSlow(pc, context)
    end
    native.store64(records, slot * size + native.layout("Cleanup.value"), values.NIL)
    native.store64(records, slot * size + native.layout("Cleanup.callback"), values.NIL)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

-- Re-arms the frame's cleanup at `depth`, the method `name` names on `value`
-- resolved first.
local function rearmSlow(pc: voidptr, context: voidptr, value: uint64, name: uint64, depth: int64): uint64
    protocol.publishPc(pc, context)
    local callback = helpers.resolveCleanup(context, value, name)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local records = native.loadPointer(context, native.layout("cleanups"))
    local size = native.layout("Cleanup.size")
    local n = native.loadIndex(context, native.layout("ncleanups"))
    local current = native.load64(context, native.layout("cur"))
    local start = n
    while start > 0 do
        if native.load64(records, (start - 1) * size + native.layout("Cleanup.frame")) < current then
            break
        end
        start = start - 1
    end
    if start + depth >= n then
        return invalidCleanupSlow(pc, context)
    end
    native.store64(records, (start + depth) * size + native.layout("Cleanup.value"), value)
    native.store64(records, (start + depth) * size + native.layout("Cleanup.callback"), callback)

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- `RearmAt depth v c`: the frame's cleanup at `depth` armed again with the
-- receiver `v` and callback `c`, or the method a string `c` names on `v`;
-- a nil receiver arms nothing. A string receiver of a method, a receiver
-- that is not an object, and a depth past the frame's cleanups are the
-- step's.
export function RearmAt(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local value = slots.readValue(frame, regs, program.readByte(pc, 1))
    local given = slots.readValue(frame, regs, program.readByte(pc, 2))
    local depth = program.readSigned32(pc, 4)
    local records = native.loadPointer(context, native.layout("cleanups"))
    local size = native.layout("Cleanup.size")
    local n = native.loadIndex(context, native.layout("ncleanups"))
    local current = native.load64(context, native.layout("cur"))
    local start = n
    while start > 0 do
        if native.load64(records, (start - 1) * size + native.layout("Cleanup.frame")) < current then
            break
        end
        start = start - 1
    end
    local named = false
    if given & values.TAG_MASK == values.TAG_OBJ then
        local kind = native.load8(native.pointer(given & values.PAYLOAD), native.layout("Header.kind"))
        named = native.either(kind == values.KIND_STRING, kind == values.KIND_SLICE)
    end
    if native.both(named, value ~= values.NIL) then
        return rearmSlow(pc, context, value, given, depth)
    end
    if start + depth >= n then
        return invalidCleanupSlow(pc, context)
    end
    local at = (start + depth) * size
    native.store64(records, at + native.layout("Cleanup.value"), value)
    native.store64(
        records,
        at + native.layout("Cleanup.callback"),
        native.chooseWord(value == values.NIL, values.NIL, given)
    )

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

local function unwindSlow(pc: voidptr, context: voidptr, keep: int64): uint64
    protocol.publishPc(pc, context)
    helpers.pollCleanups(context, keep)
    if native.load32(context, native.layout("status")) ~= 0 then
        return native.fail()
    end

    return protocol.continueAfter(pc, context, 0, values.NIL, false)
end

-- `Unwind depth`: the frame's cleanups from `depth` on run, latest first. A
-- region whose cleanups were all taken already (none past `depth`) ends
-- here; one with cleanups to run, and any unwind already in progress, are
-- Rust's, which calls them and may park the task while a scope closes.
export function Unwind(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local records = native.loadPointer(context, native.layout("cleanups"))
    local size = native.layout("Cleanup.size")
    local n = native.loadIndex(context, native.layout("ncleanups"))
    local current = native.load64(context, native.layout("cur"))
    local start = n
    while start > 0 do
        if native.load64(records, (start - 1) * size + native.layout("Cleanup.frame")) < current then
            break
        end
        start = start - 1
    end
    if native.either(
        native.load64(context, native.layout("guard")) == values.GUARD_ALL,
        start + program.readSigned32(pc, 4) < n
    ) then
        return unwindSlow(pc, context, start + program.readSigned32(pc, 4))
    end

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

-- `Switch i t`: jump table `t` of the frame's own function indexed by the
-- integer register `i`, its default past either end. The tables lie past
-- the function's last instruction (`FuncInfo.ncode`): a start word per
-- table, then at each start the length, the default and the offsets, each
-- relative to the next instruction. A backward target charges no budget,
-- as in the step, which does not count a switch among its back edges.
export function Switch(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local i = slots.readInteger(frame, ints, program.readByte(pc, 1))
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local tables = native.offset(
        native.loadPointer(info, native.layout("FuncInfo.code")),
        native.load32(info, native.layout("FuncInfo.ncode")) * 16
    )
    local start = program.readSigned32(tables, program.readSigned32(pc, 4) * 4)
    local offset = program.readSigned32(tables, (start + 1) * 4)
    if native.both(i >= 0, i < program.readSigned32(tables, start * 4)) then
        offset = program.readSigned32(tables, (start + 2 + i) * 4)
    end

    return native.dispatch(native.offset(pc, (offset + 1) * 16), regs, ints, floats, context, frame)
end
