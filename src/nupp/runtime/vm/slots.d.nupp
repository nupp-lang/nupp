-- Logical slots belong to a frame and a typed window in that frame. Indices
-- count slots, never bytes. A helper that can move the stack invalidates both
-- pointers; callers must derive them again from the published context.
-- Vararg reads derive their read-only Value window from the owning frame.
-- Integer bits and signed integers share storage but retain their Nupp types.
local record Slots
    @vmSlotAccess(class = "vararg", kind = "uint64", write = false)
    readVararg: function(frame: voidptr, slot: int64): uint64
    @vmSlotAccess(class = "v", kind = "uint64", write = false)
    readValue: function(frame: voidptr, window: voidptr, slot: int64): uint64
    @vmSlotAccess(class = "v", kind = "uint64", write = true)
    writeValue: function(frame: voidptr, window: voidptr, slot: int64, value: uint64): nil
    @vmSlotAccess(class = "i", kind = "uint64", write = false)
    readIntegerBits: function(frame: voidptr, window: voidptr, slot: int64): uint64
    @vmSlotAccess(class = "i", kind = "uint64", write = true)
    writeIntegerBits: function(frame: voidptr, window: voidptr, slot: int64, value: uint64): nil
    @vmSlotAccess(class = "i", kind = "int64", write = false)
    readInteger: function(frame: voidptr, window: voidptr, slot: int64): int64
    @vmSlotAccess(class = "i", kind = "int64", write = true)
    writeInteger: function(frame: voidptr, window: voidptr, slot: int64, value: int64): nil
    @vmSlotAccess(class = "f", kind = "float64", write = false)
    readFloat: function(frame: voidptr, window: voidptr, slot: int64): float64
    @vmSlotAccess(class = "f", kind = "float64", write = true)
    writeFloat: function(frame: voidptr, window: voidptr, slot: int64, value: float64): nil
    @vmSlotAccess(class = "xLow", kind = "uint64", write = false)
    readVectorLow: function(frame: voidptr, window: voidptr, slot: int64): uint64
    @vmSlotAccess(class = "xHigh", kind = "uint64", write = false)
    readVectorHigh: function(frame: voidptr, window: voidptr, slot: int64): uint64
    @vmSlotAccess(class = "xLow", kind = "uint64", write = true)
    writeVectorLow: function(frame: voidptr, window: voidptr, slot: int64, value: uint64): nil
    @vmSlotAccess(class = "xHigh", kind = "uint64", write = true)
    writeVectorHigh: function(frame: voidptr, window: voidptr, slot: int64, value: uint64): nil
end
return Slots
