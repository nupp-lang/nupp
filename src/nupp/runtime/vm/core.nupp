    local p = native.loadFloat(floats, b)
    local q = native.loadFloat(floats, c)
    native.storeFloat(floats, a, p / q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

function core.FMod(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local p = native.loadFloat(floats, b)
    local q = native.loadFloat(floats, c)
    native.storeFloat(floats, a, p - native.floor(p / q) * q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

