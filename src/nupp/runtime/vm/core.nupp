    local c = program.readByte(pc, 3)
    slots.writeIntegerBits(
        frame,
        ints,
        a,
        native.asWord(slots.readFloat(frame, floats, b) <= slots.readFloat(frame, floats, c))
    )

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function FBox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local bits = native.bits(slots.readFloat(frame, floats, b))
    if bits & values.QNAN == values.QNAN then
        slots.writeValue(frame, regs, a, values.QNAN)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        slots.writeValue(frame, regs, a, bits)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function GetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local bits = slots.readValue(frame, regs, b)
    if bits & values.TAG_MASK ~= values.TAG_OBJ then
        protocol.publishPc(pc, context)
        helpers.cellError(context, bits, 0, b)
        return native.fail()
    end
    local object = native.pointer(bits & values.PAYLOAD)
    if native.load8(object, native.layout("Header.kind")) ~= 6 then
        protocol.publishPc(pc, context)
        helpers.cellError(context, bits, 1, b)
        return native.fail()
    end
    local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
    slots.writeValue(frame, regs, a, native.load64(data, 0))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Lt(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local c = program.readByte(pc, 3)
    local x = slots.readValue(frame, regs, b)
    local y = slots.readValue(frame, regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local result = native.fromBits(x) < native.fromBits(y)
        slots.writeValue(frame, regs, a, native.chooseWord(result, values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return strings.order(pc, regs, ints, floats, context, frame, x, y, 0)
    end
end

export function Le(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local c = program.readByte(pc, 3)
    local x = slots.readValue(frame, regs, b)
    local y = slots.readValue(frame, regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local result = native.fromBits(x) <= native.fromBits(y)
        slots.writeValue(frame, regs, a, native.chooseWord(result, values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return strings.order(pc, regs, ints, floats, context, frame, x, y, 1)
    end
end

export function Not(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local x = slots.readValue(frame, regs, b)
    local result = native.either(x == values.NIL, x == values.FALSE)
    slots.writeValue(frame, regs, a, native.chooseWord(result, values.TRUE, values.FALSE))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Truthy(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local x = slots.readValue(frame, regs, b)
    slots.writeIntegerBits(frame, ints, a, native.asWord(native.both(x ~= values.NIL, x ~= values.FALSE)))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function BoolFromI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local result = slots.readInteger(frame, ints, b) ~= 0
    slots.writeValue(frame, regs, a, native.chooseWord(result, values.TRUE, values.FALSE))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function GetUpval(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2) * 8
    local bits = native.load64(frame, 16)
    if bits & values.TAG_MASK ~= values.TAG_OBJ then
        protocol.publishPc(pc, context)
        helpers.cellError(context, bits, 3, 0)
        return native.fail()
    end
    local object = native.pointer(bits & values.PAYLOAD)
    if native.load8(object, native.layout("Header.kind")) ~= 5 then
        protocol.publishPc(pc, context)
        helpers.cellError(context, bits, 4, 0)
        return native.fail()
    end
    local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
    slots.writeValue(frame, regs, a, native.load64(data, b))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function K(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = program.readByte(pc, 1)
    local index = program.readSigned32(pc, 4) * 8
    local fid = native.loadIndex(frame, 0) & values.LOW_WORD
    local funcs = native.loadPointer(context, native.layout("funcs"))
    local info = native.offset(funcs, fid * native.layout("FuncInfo.size"))
    local consts = native.loadPointer(info, native.layout("FuncInfo.consts"))
    slots.writeValue(frame, regs, a, native.load64(consts, index))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function JmpIf(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local value = slots.readValue(frame, regs, a)
    if native.both(value ~= values.NIL, value ~= values.FALSE) then
        local displacement = program.readSigned32(pc, 4)
        if displacement < 0 then
            return calls.backEdge(pc, regs, ints, floats, context, frame, displacement)
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function JmpIfNot(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local value = slots.readValue(frame, regs, a)
    if native.either(value == values.NIL, value == values.FALSE) then
        local displacement = program.readSigned32(pc, 4)
        if displacement < 0 then
            return calls.backEdge(pc, regs, ints, floats, context, frame, displacement)
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

local function lengthSlow(pc: voidptr, context: voidptr, value: uint64, asFloat: int64): uint64
    protocol.publishPc(pc, context)
    local result = helpers.objectLength(context, value)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    if asFloat ~= 0 then
        return numeric.floatUnboxSlow(pc, context, result)
    end

    return protocol.continueAfter(pc, context, program.readByte(pc, 1), result, true)
end

export function Len(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local bits = slots.readValue(frame, regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if native.either(kind == 1, kind == 9) then
            local length = native.load64(object, native.layout("Header.aux_len"))
            if length > 0x00007fffffffffffULL then
                return lengthSlow(pc, context, bits, 0)
            end
            slots.writeValue(frame, regs, a, values.TAG_INTEGER | length)
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        elseif kind == 2 then
            if native.load64(object, native.layout("Table.meta")) == values.NIL then
                local length = native.load64(object, native.layout("Header.aux_len"))
                if length > 0x00007fffffffffffULL then
                    return lengthSlow(pc, context, bits, 0)
                end
                slots.writeValue(frame, regs, a, values.TAG_INTEGER | length)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return lengthSlow(pc, context, bits, 0)
            end
        else
            return lengthSlow(pc, context, bits, 0)

        end
    else
        return lengthSlow(pc, context, bits, 0)
    end
end

export function LenF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local bits = slots.readValue(frame, regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if native.either(kind == 1, kind == 9) then
            local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
            slots.writeFloat(frame, floats, a, length)
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        elseif kind == 2 then
            if native.load64(object, native.layout("Table.meta")) == values.NIL then
                local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
                slots.writeFloat(frame, floats, a, length)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return lengthSlow(pc, context, bits, 1)
            end
        else
            return lengthSlow(pc, context, bits, 1)

        end
    else
        return lengthSlow(pc, context, bits, 1)
    end
end
