export function Jmp(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local displacement = program.readSigned32(pc, 4)
    if displacement < 0 then
        return calls.backEdge(pc, regs, ints, floats, context, frame, displacement)
    else
        return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
    end
end

export function JmpIfIZero(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local value = slots.readIntegerBits(frame, ints, a)
    if value == 0 then
        local displacement = program.readSigned32(pc, 4)
        if displacement < 0 then
            return calls.backEdge(pc, regs, ints, floats, context, frame, displacement)
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function FAdd(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local c = program.readByte(pc, 3)
    local p = slots.readFloat(frame, floats, b)
    local q = slots.readFloat(frame, floats, c)
    slots.writeFloat(frame, floats, a, p + q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

