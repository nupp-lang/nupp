    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if native.either(kind == 1, kind == 9) then
            local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
            native.storeFloat(floats, a, length)
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        elseif kind == 2 then
            if native.load64(object, native.layout("Table.meta")) == values.NIL then
                local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
                native.storeFloat(floats, a, length)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)

        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function GetIdxF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local index = native.loadFloat(floats, c)
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        if native.load8(object, native.layout("Header.kind")) == 2 then
            local length = native.load64(object, native.layout("Header.aux_len"))
            if native.both(native.fromBits(values.ONE_BITS) <= index, index <= native.unsignedFloat(length)) then
                local integer = native.unsignedInt(index)
                if index == native.unsignedFloat(integer) then
                    local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
                    local value = native.load64(data, native.index((integer - 1) * 8))
                    if native.either(
                        value ~= values.NIL,
                        native.load64(object, native.layout("Table.meta")) == values.NIL
                    ) then
                        native.store64(regs, a, value)
                        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                    else
                        return native.slow(pc, regs, ints, floats, context, frame)
                    end
                else
                    return native.slow(pc, regs, ints, floats, context, frame)
                end
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function GetIdxI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local signed = native.loadIndex(ints, c)
    local index = native.load64(ints, c)
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        if native.load8(object, native.layout("Header.kind")) == 2 then
            local length = native.load64(object, native.layout("Header.aux_len"))
            if native.both(1 <= signed, native.both(index <= length, index <= values.MAX_EXACT_INTEGER)) then
                local integer = index
                if integer == index then
                    local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
                    local value = native.load64(data, native.index((integer - 1) * 8))
                    if native.either(
                        value ~= values.NIL,
                        native.load64(object, native.layout("Table.meta")) == values.NIL
                    ) then
                        native.store64(regs, a, value)
                        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                    else
                        return native.slow(pc, regs, ints, floats, context, frame)
                    end
                else
                    return native.slow(pc, regs, ints, floats, context, frame)
                end
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

-- Calls and returns. A frame transition stays native when the frame driver
-- has nothing to do at it: outside frame mode always, and in frame mode when
-- the function entered or resumed has no compiled frame entry, no vector
-- instructions, and no JIT counting its frames. Otherwise the native chain
-- leaves with `reenter`, and Rust's `tail_entry` applies the policy to the
-- frame the chain has already pushed or popped, exactly as the Rust call and
-- return handlers do. Growth, varargs, builtins, iterators, compiled entries,
-- the JIT's call threshold, guarded returns, and feedback all leave through
-- `slow` before any state changes, so the Rust handler runs the instruction
-- once from the state it would have seen.
