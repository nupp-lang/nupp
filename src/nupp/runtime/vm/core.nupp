    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IAddK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b) + program.readWord(pc, 8))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IMaskU32(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b) & values.LOW_WORD)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

