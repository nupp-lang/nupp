function core.Jmp(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local displacement = native.load32(pc, 4)
    if displacement < 0 then
        local mode = native.load32(context, native.layout("frame_mode"))
        if mode ~= 0 then
            local frames = native.load64(context, native.layout("nframe_entries"))
            local jit = native.load32(context, native.layout("jit_frames"))
            if frames ~= 0 then
                return native.slow(pc, regs, ints, floats, context, frame)
            elseif jit ~= 0 then
                return native.slow(pc, regs, ints, floats, context, frame)
            else
                return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)

            end
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
    end
end

function core.JmpIfIZero(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local value = native.load64(ints, a)
    if value == 0 then
        local displacement = native.load32(pc, 4)
        if displacement < 0 then
            local mode = native.load32(context, native.layout("frame_mode"))
            if mode ~= 0 then
                local frames = native.load64(context, native.layout("nframe_entries"))
                local jit = native.load32(context, native.layout("jit_frames"))
                if frames ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                elseif jit ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                else
                    return native.dispatch(
                        native.offset(pc, (displacement + 1) * 16),
                        regs,
                        ints,
                        floats,
                        context,
                        frame
                    )

                end
            else
                return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
            end
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

function core.FAdd(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local p = native.loadFloat(floats, b)
    local q = native.loadFloat(floats, c)
    native.storeFloat(floats, a, p + q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

function core.FSub(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local p = native.loadFloat(floats, b)
    local q = native.loadFloat(floats, c)
    native.storeFloat(floats, a, p - q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

