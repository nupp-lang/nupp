export function FMod(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    local c = program.readByte(pc, 3)
    local p = slots.readFloat(frame, floats, b)
    local q = slots.readFloat(frame, floats, c)
    slots.writeFloat(frame, floats, a, p - native.floor(p / q) * q)

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

