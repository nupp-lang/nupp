module nupp.runtime.vm.core

-- The native interpreter core's leaf handlers: moves, constants, integer and
-- float arithmetic, comparisons, branches, boxed arithmetic, cells, upvalues,
-- slots, lengths and array reads. Ordinary Nupp, compiled through
-- `nupp.compiler.clif.lower` in handler mode. Unsupported instructions and
-- OSR return to the Rust core before any helper can move a frame or collect.
const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")

export function Move(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    native.store64(regs, a, native.load64(regs, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Nil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    native.store64(regs, a, values.NIL)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

