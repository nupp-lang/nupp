module nupp.runtime.vm.core

-- The native interpreter core's leaf handlers cover moves, constants,
-- arithmetic, comparisons, branches, cells, upvalues, lengths and array reads.
-- They lower through `nupp.compiler.clif.lower` in handler mode. Back edges
-- and frame transitions continue through the frame policy in `calls`.
const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const calls = require("nupp.runtime.vm.calls")
const strings = require("nupp.runtime.vm.strings")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")
const numeric = require("nupp.runtime.vm.numeric")

export function Move(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeValue(frame, regs, a, slots.readValue(frame, regs, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Nil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    slots.writeValue(frame, regs, a, values.NIL)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IK(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = program.readByte(pc, 1)
    slots.writeIntegerBits(frame, ints, a, program.readWord(pc, 8))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IMov(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IAddK(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b) + program.readWord(pc, 8))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IMaskU32(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeIntegerBits(frame, ints, a, slots.readIntegerBits(frame, ints, b) & values.LOW_WORD)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

