    local c = native.load8(pc, 3) * 8
    native.store64(ints, a, native.asWord(native.loadFloat(floats, b) <= native.loadFloat(floats, c)))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function FBox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.bits(native.loadFloat(floats, b))
    if bits & values.QNAN == values.QNAN then
        native.store64(regs, a, values.QNAN)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        native.store64(regs, a, bits)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function FUnbox(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & values.QNAN ~= values.QNAN then
        native.storeFloat(floats, a, native.fromBits(bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    elseif bits == values.QNAN then
        native.storeFloat(floats, a, native.fromBits(bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)

    end
end

export function GetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        if native.load8(object, native.layout("Header.kind")) == 6 then
            local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
            native.store64(regs, a, native.load64(data, 0))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Add(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local p = native.fromBits(x)
        local q = native.fromBits(y)
        local bits = native.bits(p + q)
        native.store64(regs, a, native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Sub(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local p = native.fromBits(x)
        local q = native.fromBits(y)
        local bits = native.bits(p - q)
        native.store64(regs, a, native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Mul(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local p = native.fromBits(x)
        local q = native.fromBits(y)
        local bits = native.bits(p * q)
        native.store64(regs, a, native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Mod(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local p = native.fromBits(x)
        local q = native.fromBits(y)
        local bits = native.bits(p - native.floor(p / q) * q)
        native.store64(regs, a, native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Lt(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local result = native.fromBits(x) < native.fromBits(y)
        native.store64(regs, a, native.chooseWord(result, values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Le(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local c = native.load8(pc, 3) * 8
    local x = native.load64(regs, b)
    local y = native.load64(regs, c)
    if native.both(
        native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN),
        native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    ) then
        local result = native.fromBits(x) <= native.fromBits(y)
        native.store64(regs, a, native.chooseWord(result, values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Neg(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local x = native.load64(regs, b)
    if native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN) then
        local bits = native.bits(native.neg(native.fromBits(x)))
        native.store64(regs, a, native.chooseWord(bits & values.QNAN == values.QNAN, values.QNAN, bits))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Not(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local x = native.load64(regs, b)
    local result = native.either(x == values.NIL, x == values.FALSE)
    native.store64(regs, a, native.chooseWord(result, values.TRUE, values.FALSE))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Truthy(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local x = native.load64(regs, b)
    native.store64(ints, a, native.asWord(native.both(x ~= values.NIL, x ~= values.FALSE)))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function BoolFromI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local result = native.loadIndex(ints, b) ~= 0
    native.store64(regs, a, native.chooseWord(result, values.TRUE, values.FALSE))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function GetUpval(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(frame, 16)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
        native.store64(regs, a, native.load64(data, b))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function K(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = native.load8(pc, 1) * 8
    local index = native.load32(pc, 4) * 8
    local fid = native.loadIndex(frame, 0) & values.LOW_WORD
    local funcs = native.loadPointer(context, native.layout("funcs"))
    local info = native.offset(funcs, fid * native.layout("FuncInfo.size"))
    local consts = native.loadPointer(info, native.layout("FuncInfo.consts"))
    native.store64(regs, a, native.load64(consts, index))

    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function JmpIf(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local value = native.load64(regs, a)
    if native.both(value ~= values.NIL, value ~= values.FALSE) then
        local displacement = native.load32(pc, 4)
        if displacement < 0 then
            local mode = native.load32(context, native.layout("frame_mode"))
            if mode ~= 0 then
                local frames = native.load64(context, native.layout("nframe_entries"))
                local jit = native.load32(context, native.layout("jit_frames"))
                if frames ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                elseif jit ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                else
                    return native.dispatch(
                        native.offset(pc, (displacement + 1) * 16),
                        regs,
                        ints,
                        floats,
                        context,
                        frame
                    )

                end
            else
                return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
            end
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function JmpIfNot(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local value = native.load64(regs, a)
    if native.either(value == values.NIL, value == values.FALSE) then
        local displacement = native.load32(pc, 4)
        if displacement < 0 then
            local mode = native.load32(context, native.layout("frame_mode"))
            if mode ~= 0 then
                local frames = native.load64(context, native.layout("nframe_entries"))
                local jit = native.load32(context, native.layout("jit_frames"))
                if frames ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                elseif jit ~= 0 then
                    return native.slow(pc, regs, ints, floats, context, frame)
                else
                    return native.dispatch(
                        native.offset(pc, (displacement + 1) * 16),
                        regs,
                        ints,
                        floats,
                        context,
                        frame
                    )

                end
            else
                return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
            end
        else
            return native.dispatch(native.offset(pc, (displacement + 1) * 16), regs, ints, floats, context, frame)
        end
    else
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

export function GetSlot(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        if native.both(
            native.load8(object, native.layout("Header.kind")) == 3,
            native.load32(object, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
            local slot = native.load8(pc, 3) * 8
            local value = native.load64(data, slot)
            if native.either(value ~= values.NIL, native.load8(object, native.layout("Header.flags")) & 4 == 0) then
                native.store64(regs, a, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function GetSlotF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        if native.both(
            native.load8(object, native.layout("Header.kind")) == 3,
            native.load32(object, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            local data = native.loadPointer(object, native.layout("Header.aux_ptr"))
            local slot = native.load8(pc, 3) * 8
            local value = native.load64(data, slot)
            if native.either(value & values.QNAN ~= values.QNAN, value == values.QNAN) then
                native.storeFloat(floats, a, native.fromBits(value))
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function Len(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local b = native.load8(pc, 2) * 8
    local bits = native.load64(regs, b)
    if bits & values.TAG_MASK == values.TAG_OBJ then
        local object = native.pointer(bits & values.PAYLOAD)
        local kind = native.load8(object, native.layout("Header.kind"))
        if native.either(kind == 1, kind == 9) then
            local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
            native.store64(regs, a, native.bits(length))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        elseif kind == 2 then
            if native.load64(object, native.layout("Table.meta")) == values.NIL then
                local length = native.unsignedFloat(native.load64(object, native.layout("Header.aux_len")))
                native.store64(regs, a, native.bits(length))
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return native.slow(pc, regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)

        end
    else
        return native.slow(pc, regs, ints, floats, context, frame)
    end
end

export function LenF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
