module nupp.runtime.vm.core

-- The native interpreter core's leaf handlers: moves, constants, integer and
-- float arithmetic, comparisons, branches, boxed arithmetic, cells, upvalues,
-- slots, lengths and array reads. Ordinary Nupp, compiled through
-- `nupp.compiler.clif.lower` in handler mode. Unsupported instructions return
-- to the Rust core before any helper can move a frame or collect; a back edge
-- that may enter compiled code goes through the frame driver in `calls`.
const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const values = require("nupp.runtime.vm.values")
const calls = require("nupp.runtime.vm.calls")
const strings = require("nupp.runtime.vm.strings")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

export function Move(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    local b = program.readByte(pc, 2)
    slots.writeValue(frame, regs, a, slots.readValue(frame, regs, b))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function Nil(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = program.readByte(pc, 1)
    slots.writeValue(frame, regs, a, values.NIL)
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IK(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    local a = program.readByte(pc, 1)
    slots.writeIntegerBits(frame, ints, a, program.readWord(pc, 8))
    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
end

export function IMov(
    pc: voidptr,
