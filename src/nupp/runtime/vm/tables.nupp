module nupp.runtime.vm.tables

-- Tables (contracts 2.4, 2.13, 4.2, 9): construction, the hash part's lookup
-- and insertion, the array part and its border, written against the heap
-- layout the glue measures. Allocation is the heap's until N05: a new table,
-- the array part's length and a rehash are helpers, and a key that is not yet
-- canonical (an uninterned string, a slice, an unsigned integer box) is made
-- so by one, and a store to a key a table with a metatable lacks goes to
-- the `__newindex` dispatch, the object library's until N04, as a read it
-- lacks goes to the `__index` walk; every other table operation is here. A
-- receiver that is not a plain table uses the named object-library services
-- for records, declaration tables, prototypes and diagnostics.
const native = require("nupp.runtime.vm.intrinsics")
const program = require("nupp.runtime.vm.program")
const slots = require("nupp.runtime.vm.slots")
const specialization = require("nupp.runtime.vm.specialization")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")
const managed = require("nupp.runtime.vm.recordhelpers")
const numeric = require("nupp.runtime.vm.numerichelpers")

-- A new table in register `a`, with room for `n` array and `m` hash entries.
local function newTableSlow(pc: voidptr, context: voidptr, n: int64, m: int64): uint64
    protocol.publishPc(pc, context)
    local table = helpers.newTable(context, n, m)
    return protocol.continueAfter(pc, context, program.readByte(pc, 1), table, true)
end

export function NewTable(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return newTableSlow(pc, context, 0, 0)
end

export function NewTableN(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return newTableSlow(pc, context, program.readByte(pc, 2), program.readByte(pc, 3))
end

-- A read the table itself cannot answer: another kind of receiver, or an
-- absent key under a metatable, whose `__index` the helper follows.
local function indexSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64): uint64
    protocol.publishPc(pc, context)
    local value = helpers.getField(context, object, key)
    return protocol.continueAfter(pc, context, program.readByte(pc, 1), value, true)
end

-- A dynamic key on a record, string or another non-table receiver must be
-- canonical before the named-field helper probes a shape. A key that has no
-- canonical name still reaches the receiver's existing __index behavior;
-- nil is itself a valid lookup operand, not an absent-name signal.
local function indexedReceiverSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64): uint64
    protocol.publishPc(pc, context)
    local canonical = helpers.internKey(context, key, 0)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local name = native.chooseWord(canonical ~= values.NIL, canonical, key)

    return indexSlow(pc, context, object, name)
end

-- The insertion barrier (4.2) before a store made while marking; the barrier
-- moves no stack and runs no code of the program.
local function markedStoreSlow(
    pc: voidptr,
    context: voidptr,
    parent: uint64,
    child: uint64,
    target: voidptr,
    at: int64
): uint64
    helpers.barrier(context, parent, child)
    native.store64(target, at, child)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A new entry at bucket `k` of the hash part, found empty by the probe: the
-- key and the value, then the entry's position in the insertion order
-- (contracts 2.13).
local function writeEntry(header: voidptr, key: uint64, value: uint64, k: int64): nil
    local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
    local n = native.loadIndex(header, native.layout("Table.hash_len"))
    native.store64(buckets, k * 16, key)
    native.store64(buckets, k * 16 + 8, value)
    native.store32(native.loadPointer(header, native.layout("Table.hash_order")), n * 4, k)
    native.store32(native.loadPointer(header, native.layout("Table.hash_rank")), k * 4, n)
    native.storeIndex(header, native.layout("Table.hash_len"), n + 1)
end

-- The insertion barrier for a new entry, while marking: the key when it is
-- an object, and the value.
local function barrierEntry(context: voidptr, object: uint64, key: uint64, value: uint64): nil
    if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
        if key & values.TAG_MASK == values.TAG_OBJ then
            helpers.barrier(context, object, key)
        end
        helpers.barrier(context, object, value)
    end
end

local function insertSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64, k: int64): uint64
    barrierEntry(context, object, key, value)
    writeEntry(native.pointer(object & values.PAYLOAD), key, value, k)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A hash part with no room for the key: rehashed by the helper, which drops
-- the entries whose values went nil and keeps the order of the rest, then the
-- entry inserted at the first empty bucket of the key's probe sequence.
local function growInsertSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.growHash(context, object)
    local header = native.pointer(object & values.PAYLOAD)
    local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
    local mask = native.load64(header, native.layout("Table.hash_mask"))
    local k = (((key >> 4) * values.HASH_MULTIPLIER) >> 32) & mask
    while native.load64(buckets, native.index(k * 16)) ~= values.NIL do
        k = (k + 1) & mask
    end
    barrierEntry(context, object, key, value)
    writeEntry(header, key, value, native.index(k))

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A store to a key the table lacks under a metatable: `__newindex` may
-- answer it (contracts 9), which the helper decides and dispatches.
local function newIndexSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.newIndex(context, object, key, value)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A store by a canonical key into the hash part of a plain table: the probe
-- sequence from the key's hash, the entry overwritten when the key has one
-- (a key keeps its entry when its value becomes nil), inserted at the first
-- empty bucket otherwise. Under a metatable only a present key is stored
-- raw; an absent one may have a `__newindex` to call.
local function hashStore(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    header: voidptr,
    meta: uint64,
    key: uint64,
    value: uint64
): uint64
    local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
    local mask = native.load64(header, native.layout("Table.hash_mask"))
    local k = (((key >> 4) * values.HASH_MULTIPLIER) >> 32) & mask
    if buckets ~= nil then
        while true do
            local bucket = native.load64(buckets, native.index(k * 16))
            if bucket == key then
                local at = native.index(k * 16 + 8)
                if native.both(meta ~= values.NIL, native.load64(buckets, at) == values.NIL) then
                    return newIndexSlow(pc, context, object, key, value)
                elseif native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                    return markedStoreSlow(pc, context, object, value, buckets, at)
                else
                    native.store64(buckets, at, value)
                    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                end
            end
            if bucket == values.NIL then
                break
            end
            k = (k + 1) & mask
        end
    end
    if meta ~= values.NIL then
        return newIndexSlow(pc, context, object, key, value)
    elseif value == values.NIL then
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    elseif native.either(
        buckets == nil,
        (
            native.load64(header, native.layout("Table.hash_len")) + 1
        ) * 4 > native.load64(header, native.layout("Table.hash_cap")) * 3
    ) then
        return growInsertSlow(pc, context, object, key, value)
    elseif native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
        return insertSlow(pc, context, object, key, value, native.index(k))
    else
        writeEntry(header, key, value, native.index(k))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    end
end

-- `t[#t] = nil` (contracts 9): the last entry cleared, then the array part
-- shrinks past every trailing nil.
local function trimSlow(pc: voidptr, context: voidptr, object: uint64, last: int64): uint64
    protocol.publishPc(pc, context)
    local header = native.pointer(object & values.PAYLOAD)
    local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
    native.store64(data, last * 8, values.NIL)
    local n = last
    while native.both(n > 0, native.load64(data, (n - 1) * 8) == values.NIL) do
        n = n - 1
    end
    helpers.resizeArray(context, object, n)

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- The value stored at array position `n` (zero-based) of a table the helper
-- just lengthened to hold it.
local function fillArray(context: voidptr, object: uint64, n: int64, value: uint64): nil
    local header = native.pointer(object & values.PAYLOAD)
    if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
        helpers.barrier(context, object, value)
    end
    native.store64(native.loadPointer(header, native.layout("Header.aux_ptr")), n * 8, value)
end

-- A store at the border, `t[#t + 1] = v`: the key leaves the hash part if it
-- was there, the array part grows by one for the value, and every key the
-- growth made contiguous follows it out of the hash part.
local function appendSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    local header = native.pointer(object & values.PAYLOAD)
    local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
    local mask = native.load64(header, native.layout("Table.hash_mask"))
    if buckets ~= nil then
        local k = (((key >> 4) * values.HASH_MULTIPLIER) >> 32) & mask
        while true do
            local bucket = native.load64(buckets, native.index(k * 16))
            if bucket == key then
                native.store64(buckets, native.index(k * 16 + 8), values.NIL)
                break
            end
            if bucket == values.NIL then
                break
            end
            k = (k + 1) & mask
        end
    end
    if value ~= values.NIL then
        local n = native.loadIndex(header, native.layout("Header.aux_len"))
        helpers.resizeArray(context, object, n + 1)
        fillArray(context, object, n, value)
        n = n + 1
        if buckets ~= nil then
            local migrating = true
            while migrating do
                migrating = false
                local next = native.bits(native.toFloat(n + 1))
                local k = (((next >> 4) * values.HASH_MULTIPLIER) >> 32) & mask
                while true do
                    local bucket = native.load64(buckets, native.index(k * 16))
                    if bucket == next then
                        local moved = native.load64(buckets, native.index(k * 16 + 8))
                        if moved ~= values.NIL then
                            native.store64(buckets, native.index(k * 16 + 8), values.NIL)
                            helpers.resizeArray(context, object, n + 1)
                            fillArray(context, object, n, moved)
                            n = n + 1
                            migrating = true
                        end
                        break
                    end
                    if bucket == values.NIL then
                        break
                    end
                    k = (k + 1) & mask
                end
            end
        end
    end

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A key made canonical by the helper, then the store into the hash part with
-- the windows derived again.
local function storeInternSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    local canonical = helpers.internKey(context, key, 1)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)
    local header = native.pointer(object & values.PAYLOAD)

    return hashStore(
        pc,
        regs,
        ints,
        floats,
        context,
        frame,
        object,
        header,
        native.load64(header, native.layout("Table.meta")),
        canonical,
        value
    )
end

-- Numeric keys share the object library's canonical representation, including
-- integral floats, inline integers and signed/unsigned wide integers.
local function integralKey(key: uint64): boolean
    if numeric.numericKind(key) >= 0 then
        return true
    end
    if native.either(key & values.QNAN ~= values.QNAN, key == values.QNAN) then
        local number = native.fromBits(key)
        return native.floor(number) == number
    end

    return false
end

local function storeFallbackSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    if program.readByte(pc, 0) == native.layout("Code.SetField") then
        helpers.storeField(context, object, key, value)
    else
        local canonical = key
        if program.readByte(pc, 0) == native.layout("Code.SetIdx") then
            canonical = helpers.internKey(context, key, 1)
            if native.load32(context, native.layout("status")) == -4 then
                return native.fail()
            end
        end
        helpers.newIndex(context, object, canonical, value)
    end

    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A store by any key into a table. A number key reaches the array part when
-- it is a whole number inside it or just past its border, and the hash part
-- with its bits otherwise, `-0` as `0`; nil and NaN keys are errors the step
-- raises; a key that is not canonical is made so by the helper first.
local function storeKeyed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    key: uint64,
    value: uint64
): uint64
    if integralKey(key) then
        return storeFallbackSlow(pc, context, object, key, value)
    end
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return storeFallbackSlow(pc, context, object, key, value)
    end
    local header = native.pointer(object & values.PAYLOAD)
    if native.either(
        native.load8(header, native.layout("Header.kind")) ~= 2,
        native.load8(header, native.layout("Header.flags")) & values.SPECIAL_TABLE_FLAGS ~= 0
    ) then
        return storeFallbackSlow(pc, context, object, key, value)
    end
    local meta = native.load64(header, native.layout("Table.meta"))
    local bits = key
    if native.either(key & values.QNAN ~= values.QNAN, key == values.QNAN) then
        if key == values.QNAN then
            return storeFallbackSlow(pc, context, object, key, value)
        end
        bits = native.chooseWord(key == values.NEGATIVE_ZERO, 0, key)
        local d = native.fromBits(bits)
        local length = native.load64(header, native.layout("Header.aux_len"))
        local whole = native.unsignedInt(d)
        if native.unsignedFloat(whole) == d then
            if native.both(1 <= whole, whole <= length) then
                local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
                local at = native.index((whole - 1) * 8)
                if native.both(meta ~= values.NIL, native.load64(data, at) == values.NIL) then
                    return newIndexSlow(pc, context, object, bits, value)
                elseif native.both(value == values.NIL, whole == length) then
                    return trimSlow(pc, context, object, native.index(length) - 1)
                elseif native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                    return markedStoreSlow(pc, context, object, value, data, at)
                else
                    native.store64(data, at, value)
                    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                end
            elseif whole == length + 1 then
                if meta ~= values.NIL then
                    return newIndexSlow(pc, context, object, bits, value)
                else
                    return appendSlow(pc, context, object, bits, value)
                end
            end
        end
    elseif key == values.NIL then
        return storeFallbackSlow(pc, context, object, key, value)
    elseif key & values.TAG_MASK == values.TAG_OBJ then
        local keyHeader = native.pointer(key & values.PAYLOAD)
        local keyKind = native.load8(keyHeader, native.layout("Header.kind"))
        if native.either(
            native.either(
                native.both(keyKind == 1, native.load8(keyHeader, native.layout("Header.flags")) & 1 == 0),
                keyKind == 9
            ),
            native.both(keyKind == 12, native.load32(keyHeader, native.layout("Header.aux")) ~= 0)
        ) then
            return storeInternSlow(pc, context, object, key, value)
        end
    end

    return hashStore(pc, regs, ints, floats, context, frame, object, header, meta, bits, value)
end

export function SetIdx(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 1))
    local key = slots.readValue(frame, regs, program.readByte(pc, 2))
    local value = slots.readValue(frame, regs, program.readByte(pc, 3))
    return storeKeyed(pc, regs, ints, floats, context, frame, object, key, value)
end

export function SetIdxF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 1))
    local d = slots.readFloat(frame, floats, program.readByte(pc, 2))
    local value = slots.readValue(frame, regs, program.readByte(pc, 3))
    -- The key is the float boxed: a NaN payload as the canonical quiet NaN.
    local bits = native.bits(d)
    local nan = native.both(bits & values.QNAN == values.QNAN, bits ~= values.QNAN)

    return storeKeyed(pc, regs, ints, floats, context, frame, object, native.chooseWord(nan, values.QNAN, bits), value)
end

-- The receiver reported to the JIT's feedback, then the store itself.
local function observeStoreSlow(pc: voidptr, context: voidptr, object: uint64, name: uint64, value: uint64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local fid = native.index(native.load64(frame, 0) & values.LOW_WORD)
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        fid * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    helpers.observe(context, fid, native.index(native.address(pc) - native.address(code)) >> 4, object, 1)
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return storeKeyed(pc, regs, ints, floats, context, frame, object, name, value)
end

-- A store by an interned name (contracts 2.5), including the object-library
-- protocol for declared record slots.
export function SetField(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 1))
    local value = slots.readValue(frame, regs, program.readByte(pc, 2))
    local consts = native.loadPointer(
        native.loadPointer(context, native.layout("funcs")),
        native.index(
            native.load64(frame, 0) & values.LOW_WORD
        ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.consts")
    )
    local name = native.load64(consts, program.readSigned32(pc, 4) * 8)
    if specialization.inInterpreter() and native.load32(context, native.layout("feedback")) ~= 0 then
        return observeStoreSlow(pc, context, object, name, value)
    else
        return storeKeyed(pc, regs, ints, floats, context, frame, object, name, value)
    end
end

-- A read by a canonical key from the hash part of a table: the entry's value
-- when it has one, nil when the table has no metatable, and the helper's
-- `__index` walk otherwise.
local function hashLookup(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    header: voidptr,
    meta: uint64,
    key: uint64
): uint64
    local a = program.readByte(pc, 1)
    local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
    if buckets ~= nil then
        local mask = native.load64(header, native.layout("Table.hash_mask"))
        local k = (((key >> 4) * values.HASH_MULTIPLIER) >> 32) & mask
        while true do
            local bucket = native.load64(buckets, native.index(k * 16))
            if bucket == key then
                local value = native.load64(buckets, native.index(k * 16 + 8))
                if native.either(value ~= values.NIL, meta == values.NIL) then
                    slots.writeValue(frame, regs, a, value)
                    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                end
                break
            end
            if bucket == values.NIL then
                break
            end
            k = (k + 1) & mask
        end
    end
    if meta == values.NIL then
        slots.writeValue(frame, regs, a, values.NIL)
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        return indexSlow(pc, context, object, key)
    end
end

-- A read by a key the helper makes canonical first: absent when no interned
-- string has the key's bytes, which is a miss without an allocation.
local function readInternSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64): uint64
    protocol.publishPc(pc, context)
    local canonical = helpers.internKey(context, key, 0)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local header = native.pointer(object & values.PAYLOAD)
    local meta = native.load64(header, native.layout("Table.meta"))
    if canonical == values.NIL then
        if meta == values.NIL then
            return protocol.continueAfter(pc, context, program.readByte(pc, 1), values.NIL, true)
        else
            return indexSlow(pc, context, object, key)
        end
    end
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return hashLookup(pc, regs, ints, floats, context, frame, object, header, meta, canonical)
end

-- A read by any key (contracts 2.4): the array part for a whole number inside
-- it, the hash part otherwise; another kind of receiver is the helper's.
local function readKeyed(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    key: uint64
): uint64
    if integralKey(key) then
        return indexSlow(pc, context, object, key)
    end
    local a = program.readByte(pc, 1)
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return indexSlow(pc, context, object, key)
    end
    local header = native.pointer(object & values.PAYLOAD)
    if native.load8(header, native.layout("Header.kind")) ~= 2 then
        return indexedReceiverSlow(pc, context, object, key)
    end
    local meta = native.load64(header, native.layout("Table.meta"))
    local bits = key
    if native.either(key & values.QNAN ~= values.QNAN, key == values.QNAN) then
        bits = native.chooseWord(key == values.NEGATIVE_ZERO, 0, key)
        local d = native.fromBits(bits)
        local length = native.load64(header, native.layout("Header.aux_len"))
        local whole = native.unsignedInt(d)
        if native.both(native.both(1 <= whole, whole <= length), native.unsignedFloat(whole) == d) then
            local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
            local value = native.load64(data, native.index((whole - 1) * 8))
            if native.either(value ~= values.NIL, meta == values.NIL) then
                slots.writeValue(frame, regs, a, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return indexSlow(pc, context, object, bits)
            end
        end
    elseif key == values.NIL then
        if meta == values.NIL then
            slots.writeValue(frame, regs, a, values.NIL)
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        else
            return indexSlow(pc, context, object, key)
        end
    elseif key & values.TAG_MASK == values.TAG_OBJ then
        local keyHeader = native.pointer(key & values.PAYLOAD)
        local keyKind = native.load8(keyHeader, native.layout("Header.kind"))
        if native.either(
            native.either(
                native.both(keyKind == 1, native.load8(keyHeader, native.layout("Header.flags")) & 1 == 0),
                keyKind == 9
            ),
            native.both(keyKind == 12, native.load32(keyHeader, native.layout("Header.aux")) ~= 0)
        ) then
            return readInternSlow(pc, context, object, key)
        end
    end

    return hashLookup(pc, regs, ints, floats, context, frame, object, header, meta, bits)
end

export function GetIdx(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 2))
    local key = slots.readValue(frame, regs, program.readByte(pc, 3))
    return readKeyed(pc, regs, ints, floats, context, frame, object, key)
end

export function GetIdxF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = slots.readValue(frame, regs, program.readByte(pc, 2))
    local d = slots.readFloat(frame, floats, program.readByte(pc, 3))
    -- The key is the float boxed: a NaN payload as the canonical quiet NaN.
    local bits = native.bits(d)
    local nan = native.both(bits & values.QNAN == values.QNAN, bits ~= values.QNAN)

    return readKeyed(pc, regs, ints, floats, context, frame, object, native.chooseWord(nan, values.QNAN, bits))
end

local function integerIndexSlow(pc: voidptr, context: voidptr, position: int64, storing: int64): uint64
    protocol.publishPc(pc, context)
    local key = managed.boxInteger(context, native.word(position), 0)
    if native.load32(context, native.layout("status")) == -4 then
        return native.fail()
    end
    local frame = native.offset(
        native.loadPointer(context, native.layout("stack")),
        native.index(native.load64(context, native.layout("cur")) * 8)
    )
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        native.index(native.load64(frame, 0) & values.LOW_WORD) * native.layout("FuncInfo.size")
    )
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)
    if storing ~= 0 then
        return storeKeyed(
            pc,
            regs,
            ints,
            floats,
            context,
            frame,
            slots.readValue(frame, regs, program.readByte(pc, 1)),
            key,
            slots.readValue(frame, regs, program.readByte(pc, 3))
        )
    end

    return readKeyed(pc, regs, ints, floats, context, frame, slots.readValue(frame, regs, program.readByte(pc, 2)), key)
end

export function SetIdxI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return integerIndexSlow(pc, context, slots.readInteger(frame, ints, program.readByte(pc, 2)), 1)
end

export function GetIdxI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    return integerIndexSlow(pc, context, slots.readInteger(frame, ints, program.readByte(pc, 3)), 0)
end
