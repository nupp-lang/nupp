module nupp.runtime.vm.lookup

-- Field and index lookups, stores, equality and cells: fast paths in Nupp
-- with the Rust helpers behind `...Slow` support functions.
const native = require("nupp.runtime.vm.intrinsics")
const values = require("nupp.runtime.vm.values")
const helpers = require("nupp.runtime.vm.helpers")
const protocol = require("nupp.runtime.vm.protocol")

local function getFieldSlow(pc: voidptr, context: voidptr, object: uint64, name: uint64): uint64
    protocol.publishPc(pc, context)
    local value = helpers.getField(context, object, name)
    return protocol.continueAfter(pc, context, native.load8(pc, 1), value, true)
end

-- A field read by an interned name: a record's shape table, a table's hash
-- part, or the helper for anything else.
local function getField(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    name: uint64
): uint64
    local a = native.load8(pc, 1) * 8
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & values.PAYLOAD)
        local kind = native.load8(header, native.layout("Header.kind"))
        local hash = ((name >> 4) * values.HASH_MULTIPLIER) >> 32
        if kind == 3 then
            local shape = native.offset(
                native.loadPointer(context, native.layout("shapes")),
                native.index(
                    native.word(native.load32(header, native.layout("Header.aux")) & values.LOW_WORD)
                ) * native.layout("ShapeInfo.size")
            )
            local table = native.loadPointer(shape, native.layout("ShapeInfo.table"))
            local mask = native.load64(shape, native.layout("ShapeInfo.mask"))
            local k = hash & mask
            while true do
                local bucket = native.load64(table, native.index(k * 16))
                if bucket == name then
                    local slot = native.load64(table, native.index(k * 16 + 8)) & values.LOW_WORD
                    local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
                    local value = native.load64(data, native.index(slot * 8))
                    if value ~= values.NIL then
                        native.store64(regs, a, value)
                        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                    end
                    break
                end
                if bucket == 0 then
                    break
                end
                k = (k + 1) & mask
            end
        elseif kind == 2 then
            local buckets = native.loadPointer(header, native.layout("Table.hash_ptr"))
            local meta = native.load64(header, native.layout("Table.meta"))
            if buckets ~= nil then
                local mask = native.load64(header, native.layout("Table.hash_mask"))
                local k = hash & mask
                while true do
                    local bucket = native.load64(buckets, native.index(k * 16))
                    if bucket == name then
                        local value = native.load64(buckets, native.index(k * 16 + 8))
                        if value ~= values.NIL or meta == values.NIL then
                            native.store64(regs, a, value)
                            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                        end
                        break
                    end
                    if bucket == values.NIL then
                        if meta == values.NIL then
                            native.store64(regs, a, values.NIL)
                            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                        end
                        break
                    end
                    k = (k + 1) & mask
                end
            elseif meta == values.NIL then
                native.store64(regs, a, values.NIL)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        end
        return getFieldSlow(pc, context, object, name)
    end
end

-- The receiver reported to the JIT's feedback, then the read itself.
local function observeFieldSlow(pc: voidptr, context: voidptr, object: uint64, name: uint64): uint64
    local stack = native.loadPointer(context, native.layout("stack"))
    local frame = native.offset(stack, native.index(native.load64(context, native.layout("cur")) * 8))
    local fid = native.index(native.load64(frame, 0) & values.LOW_WORD)
    local info = native.offset(
        native.loadPointer(context, native.layout("funcs")),
        fid * native.layout("FuncInfo.size")
    )
    local code = native.loadPointer(info, native.layout("FuncInfo.code"))
    helpers.observe(context, fid, native.index(native.address(pc) - native.address(code)) >> 4, object, 1)
    local regs = native.offset(frame, 32)
    local ints = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_i")) * 8)
    local floats = native.offset(frame, native.load32(info, native.layout("FuncInfo.off_f")) * 8)

    return getField(pc, regs, ints, floats, context, frame, object, name)
end

export function GetField(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 2) * 8)
    local consts = native.loadPointer(
        native.loadPointer(context, native.layout("funcs")),
        native.index(
            native.load64(frame, 0) & values.LOW_WORD
        ) * native.layout("FuncInfo.size") + native.layout("FuncInfo.consts")
    )
    local name = native.load64(consts, native.load32(pc, 4) * 8)
    if native.load32(context, native.layout("feedback")) ~= 0 then
        return observeFieldSlow(pc, context, object, name)
    else
        return getField(pc, regs, ints, floats, context, frame, object, name)
    end
end

local function eqSlow(pc: voidptr, context: voidptr, left: uint64, right: uint64, negate: uint64): uint64
    protocol.publishPc(pc, context)
    local equal = helpers.eqSlow(context, left, right)
    local answer = native.chooseWord((equal ~= 0) == (negate == 0), values.TRUE, values.FALSE)
    return protocol.continueAfter(pc, context, native.load8(pc, 1), answer, true)
end

-- Equality past the word compare: numbers by value, one object by identity,
-- two interned strings by identity, anything else by the helper.
local function equality(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    negate: uint64
): uint64
    local a = native.load8(pc, 1) * 8
    local x = native.load64(regs, native.load8(pc, 2) * 8)
    local y = native.load64(regs, native.load8(pc, 3) * 8)
    local xNumber = native.either(x & values.QNAN ~= values.QNAN, x == values.QNAN)
    local yNumber = native.either(y & values.QNAN ~= values.QNAN, y == values.QNAN)
    if native.both(xNumber, yNumber) then
        local equal = native.fromBits(x) == native.fromBits(y)
        native.store64(regs, a, native.chooseWord(equal == (negate == 0), values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    elseif x == y then
        native.store64(regs, a, native.chooseWord(negate == 0, values.TRUE, values.FALSE))
        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
    else
        local xObject = x & values.TAG_MASK == values.TAG_OBJ
        local yObject = y & values.TAG_MASK == values.TAG_OBJ
        if native.both(xObject, yObject) then
            local xInterned = native.load8(native.pointer(x & values.PAYLOAD), native.layout("Header.flags")) & 1 ~= 0
            local yInterned = native.load8(native.pointer(y & values.PAYLOAD), native.layout("Header.flags")) & 1 ~= 0
            if native.both(xInterned, yInterned) then
                native.store64(regs, a, native.chooseWord(negate ~= 0, values.TRUE, values.FALSE))
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            else
                return eqSlow(pc, context, x, y, negate)
            end
        else
            native.store64(regs, a, native.chooseWord(negate ~= 0, values.TRUE, values.FALSE))
            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
        end
    end
end

export function Eq(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    return equality(pc, regs, ints, floats, context, frame, 0)
end

export function Ne(pc: voidptr, regs: voidptr, ints: voidptr, floats: voidptr, context: voidptr, frame: voidptr): uint64
    return equality(pc, regs, ints, floats, context, frame, 1)
end

local function getIndexSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64): uint64
    protocol.publishPc(pc, context)
    local value = helpers.getIndex(context, object, key)
    return protocol.continueAfter(pc, context, native.load8(pc, 1), value, true)
end

-- A read by any key: the array part when the key is an integral number in
-- range, the helper otherwise.
export function GetIdx(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local a = native.load8(pc, 1) * 8
    local object = native.load64(regs, native.load8(pc, 2) * 8)
    local key = native.load64(regs, native.load8(pc, 3) * 8)
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & values.PAYLOAD)
        local keyNumber = native.either(key & values.QNAN ~= values.QNAN, key == values.QNAN)
        if native.both(native.load8(header, native.layout("Header.kind")) == 2, keyNumber) then
            local d = native.fromBits(key)
            local length = native.load64(header, native.layout("Header.aux_len"))
            local whole = native.unsignedInt(d)
            if native.both(
                native.both(1 <= d, d <= native.unsignedFloat(length)),
                native.unsignedFloat(whole) == d
            ) then
                local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
                local value = native.load64(data, native.index((whole - 1) * 8))
                if native.either(
                    value ~= values.NIL,
                    native.load64(header, native.layout("Table.meta")) == values.NIL
                ) then
                    native.store64(regs, a, value)
                    return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                end
            end
        end
        return getIndexSlow(pc, context, object, key)
    end
end

local function barrierStoreSlow(
    pc: voidptr,
    context: voidptr,
    parent: uint64,
    child: uint64,
    target: voidptr,
    at: int64
): uint64
    -- The insertion barrier moves no stack and runs no code of the program;
    -- the store follows it as in the Rust handlers.
    helpers.barrier(context, parent, child)
    native.store64(target, at, child)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

local function setIndexNumSlow(pc: voidptr, context: voidptr, object: uint64, position: int64, value: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.setIndexNum(context, object, position, value)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

export function SetIdxI(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local position = native.loadIndex(ints, native.load8(pc, 2) * 8)
    if native.either(position < -values.MAX_EXACT_INTEGER, values.MAX_EXACT_INTEGER < position) then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local object = native.load64(regs, native.load8(pc, 1) * 8)
        local value = native.load64(regs, native.load8(pc, 3) * 8)
        if object & values.TAG_MASK ~= values.TAG_OBJ then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local header = native.pointer(object & values.PAYLOAD)
            if native.both(
                native.load8(header, native.layout("Header.kind")) == 2,
                native.load8(header, native.layout("Header.flags")) & 160 == 0
            ) then
                local length = native.loadIndex(header, native.layout("Header.aux_len"))
                if native.both(
                    native.both(1 <= position, position <= length),
                    native.either(value ~= values.NIL, position < length)
                ) then
                    local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
                    local at = (position - 1) * 8
                    if native.either(
                        native.load64(data, at) ~= values.NIL,
                        native.load64(header, native.layout("Table.meta")) == values.NIL
                    ) then
                        if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                            return barrierStoreSlow(pc, context, object, value, data, at)
                        else
                            native.store64(data, at, value)
                            return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                        end
                    end
                end
            end
            return setIndexNumSlow(pc, context, object, position, value)
        end
    end
end

local function storeKeyedSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    protocol.publishPc(pc, context)
    helpers.storeKeyed(context, object, key, value)
    return protocol.continueAfter(pc, context, 0, 0, false)
end

-- A numeric key the array path did not take: appended to a plain dense
-- array, which runs no program code and moves no stack, or stored by the
-- helper with the key normalized.
local function appendOrStoreSlow(pc: voidptr, context: voidptr, object: uint64, key: uint64, value: uint64): uint64
    if helpers.appendPlain(context, object, native.fromBits(key), value) ~= 0 then
        return protocol.continueAfter(pc, context, 0, 0, false)
    else
        protocol.publishPc(pc, context)
        helpers.storeKeyed(context, object, key, value)
        return protocol.continueAfter(pc, context, 0, 0, false)
    end
end

-- The Rust core's `array_store!`: a store by a numeric key into the array
-- part of a plain table, under the guards its read has and the storage flags
-- that make a table something other than plain slots; the append and the
-- keyed store otherwise. `key` is `d` boxed.
local function arrayStore(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr,
    object: uint64,
    d: number,
    key: uint64,
    value: uint64
): uint64
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return storeKeyedSlow(pc, context, object, key, value)
    else
        local header = native.pointer(object & values.PAYLOAD)
        if native.both(
            native.load8(header, native.layout("Header.kind")) == 2,
            native.load8(header, native.layout("Header.flags")) & 224 == 0
        ) then
            local length = native.unsignedFloat(native.load64(header, native.layout("Header.aux_len")))
            local whole = native.unsignedInt(d)
            if native.both(
                native.both(native.both(1 <= d, d <= length), native.unsignedFloat(whole) == d),
                native.either(value ~= values.NIL, d < length)
            ) then
                local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
                local at = native.index((whole - 1) * 8)
                if native.either(
                    native.load64(data, at) ~= values.NIL,
                    native.load64(header, native.layout("Table.meta")) == values.NIL
                ) then
                    if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                        return barrierStoreSlow(pc, context, object, value, data, at)
                    else
                        native.store64(data, at, value)
                        return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
                    end
                end
            end
        end
        return appendOrStoreSlow(pc, context, object, key, value)
    end
end

export function SetIdxF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local d = native.loadFloat(floats, native.load8(pc, 2) * 8)
    local value = native.load64(regs, native.load8(pc, 3) * 8)
    -- The key is the float boxed: a NaN payload as the canonical quiet NaN.
    local bits = native.bits(d)
    local nan = native.both(bits & values.QNAN == values.QNAN, bits ~= values.QNAN)

    return arrayStore(
        pc,
        regs,
        ints,
        floats,
        context,
        frame,
        object,
        d,
        native.chooseWord(nan, values.QNAN, bits),
        value
    )
end

export function SetIdx(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local key = native.load64(regs, native.load8(pc, 2) * 8)
    local value = native.load64(regs, native.load8(pc, 3) * 8)
    if native.either(key & values.QNAN ~= values.QNAN, key == values.QNAN) then
        return arrayStore(pc, regs, ints, floats, context, frame, object, native.fromBits(key), key, value)
    else
        return storeKeyedSlow(pc, context, object, key, value)
    end
end

export function SetCell(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local cell = native.load64(regs, native.load8(pc, 1) * 8)
    local value = native.load64(regs, native.load8(pc, 2) * 8)
    if cell & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(cell & values.PAYLOAD)
        if native.load8(header, native.layout("Header.kind")) ~= 6 then
            return native.slow(pc, regs, ints, floats, context, frame)
        else
            local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
            if native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                return barrierStoreSlow(pc, context, cell, value, data, 0)
            else
                native.store64(data, 0, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        end
    end
end

-- A record slot store under the same guards as its read, plus the storage
-- flags that make a record something other than plain slots.
export function SetSlot(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local value = native.load64(regs, native.load8(pc, 3) * 8)
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & values.PAYLOAD)
        local flags = native.load8(header, native.layout("Header.flags"))
        local at = native.load8(pc, 2) * 8
        local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
        if native.both(
            native.both(native.load8(header, native.layout("Header.kind")) == 3, flags & 160 == 0),
            native.load32(header, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            if native.both(flags & 4 ~= 0, native.load64(data, at) == values.NIL) then
                return native.slow(pc, regs, ints, floats, context, frame)
            elseif native.load8(native.loadPointer(context, native.layout("marking")), 0) ~= 0 then
                return barrierStoreSlow(pc, context, object, value, data, at)
            else
                native.store64(data, at, value)
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    end
end

export function SetSlotF(
    pc: voidptr,
    regs: voidptr,
    ints: voidptr,
    floats: voidptr,
    context: voidptr,
    frame: voidptr
): uint64
    local object = native.load64(regs, native.load8(pc, 1) * 8)
    local value = native.loadFloat(floats, native.load8(pc, 3) * 8)
    if object & values.TAG_MASK ~= values.TAG_OBJ then
        return native.slow(pc, regs, ints, floats, context, frame)
    else
        local header = native.pointer(object & values.PAYLOAD)
        local flags = native.load8(header, native.layout("Header.flags"))
        local at = native.load8(pc, 2) * 8
        local data = native.loadPointer(header, native.layout("Header.aux_ptr"))
        if native.both(
            native.both(native.load8(header, native.layout("Header.kind")) == 3, flags & 160 == 0),
            native.load32(header, native.layout("Header.aux")) == native.load32(pc, 4)
        ) then
            if native.both(flags & 4 ~= 0, native.load64(data, at) == values.NIL) then
                return native.slow(pc, regs, ints, floats, context, frame)
            else
                -- A NaN payload is boxed as the canonical quiet NaN.
                local bits = native.bits(value)
                local nan = native.both(bits & values.QNAN == values.QNAN, bits ~= values.QNAN)
                native.store64(data, at, native.chooseWord(nan, values.QNAN, bits))
                return native.dispatch(native.offset(pc, 16), regs, ints, floats, context, frame)
            end
        else
            return native.slow(pc, regs, ints, floats, context, frame)
        end
    end
end
