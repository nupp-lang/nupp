@!internal

module nupp.runtime.native

--[[
The loader for the versioned Rust-native provider.
]]

local ffi = require("ffi")

ffi.cdef[[
uint32_t nuppNativeAbiVersion(void);
uint64_t nuppNativeFeatures(void);
const char *nuppNativeLastError(void);
int32_t nuppNativeBytesCopy(
    uint64_t handle,
    uint8_t *outputData,
    size_t capacity,
    size_t *outputLength
);
int32_t nuppNativeBytesRelease(uint64_t handle);
]]

local native = {}

--- The FFI used to declare feature-specific symbols.
--- @export
native.ffi = ffi

const ABI_VERSION = 2
const LIBRARY_KEY = "__nuppNativeLibrary"

local function open(): any
    local wanted = os.getenv("NUPP_NATIVE_LIBRARY")
    if wanted then
        return ffi.load(wanted)
    end
    local source = debug.getinfo(1, "S").source
    local root = source:match("^@(.+)/[^/]+$") or "."
    local library = ffi.os == "Windows" and "/lib/nupp_native.dll" or "/lib/nupp_native"
    for _, base in ipairs({root, root .. "/..", root .. "/../.."}) do
        local found, value = pcall(ffi.load, base .. library)
        if found then
            return value
        end
    end

    -- A compiler-owned binary links the host implementations it needs, but its
    -- selected provider may also contain sidecar-only facilities. Prefer that
    -- exact-feature provider over the necessarily partial process namespace.
    -- A standalone binary has no sidecar and falls through to its complete,
    -- statically linked provider here.
    local linked = pcall(function(): any
        return ffi.C.nuppNativeAbiVersion
    end)
    if linked then
        return ffi.C
    end

    -- Repeat the canonical location outside pcall so the loader's diagnostic is
    -- retained when neither a packaged nor a statically linked provider exists.

    return ffi.load(root .. library)
end

local function library(): any
    local value: any = rawget(_G, LIBRARY_KEY)
    if value == nil then
        local opened: any = open()
        local version = opened.nuppNativeAbiVersion()
        if version ~= ABI_VERSION then
            error(
                (
                    "nupp: Rust native ABI mismatch: runtime needs %d, provider has %s"
                ):format(ABI_VERSION, tostring(version)),
                3
            )
        end
        rawset(_G, LIBRARY_KEY, opened)
        value = opened
    end

    return value
end

--- Lazily resolved versioned symbols.
--- @export
native.C = setmetatable({}, {
    __index = function(self: any, symbol: string): any
        local found = library()[symbol]
        rawset(self, symbol, found)

        return found
    end,
}) as any

--- Raises the provider's copied thread-local error for a nonzero status.
--- @export
--- @raises string when status is nonzero
function native.succeeded(status: integer, level: integer): nil
    if status ~= 0 then
        error("nupp: " .. ffi.string(native.C.nuppNativeLastError()), level)
    end
end

--- Verifies that the selected versioned provider implements one facility.
--- @export
--- @raises string when the provider lacks the feature bit
function native.requireFeature(bit: integer, name: string): nil
    if native.C.nuppNativeFeatures() & bit == 0 then
        error("nupp: the Rust native provider was built without " .. name, 3)
    end
end

--- Takes an owned byte result from the provider and releases its handle.
--- @export
--- @raises string when the result cannot be copied or released
function native.bytes(handle: any): string
    local length = ffi.new("size_t[1]")
    local status = native.C.nuppNativeBytesCopy(handle, nil, 0, length)
    local count = (tonumber(length[0]) or 0) as integer
    if count == 0 then
        local released = native.C.nuppNativeBytesRelease(handle)
        native.succeeded(status, 3)
        native.succeeded(released, 3)

        return ""
    end
    -- Capacity is the expected result of probing a nonempty value.
    if status ~= 2 then
        local released = native.C.nuppNativeBytesRelease(handle)
        native.succeeded(status, 3)
        native.succeeded(released, 3)
    end

    local buffer = ffi.new("uint8_t[?]", count)
    status = native.C.nuppNativeBytesCopy(handle, buffer, count, length)
    local released = native.C.nuppNativeBytesRelease(handle)
    native.succeeded(status, 3)
    native.succeeded(released, 3)

    return ffi.string(buffer, count)
end

const AOT_RUNTIME_FEATURE = 4096

local aotRuntime: string? = nil

--- The AOT runtime's table address, as pointer-width native-endian bytes.
---
--- An LLVM-compiled Lua-builder module reaches the runtime its entries call
--- through this table rather than through symbols, and its registrar calls
--- this to find it: that keeps the module free of anything a loader would
--- have to resolve, and it is how the C lowering's loaders and the host's
--- archive registration keep working unchanged.
--- @export
--- @raises string when the provider was built without the runtime
function native.aotRuntime(): string
    local cached = aotRuntime
    if cached ~= nil then
        return cached
    end
    native.requireFeature(AOT_RUNTIME_FEATURE, "the AOT runtime")
    ffi.cdef("const void *nuppAotRuntime(void);")
    local address = native.C.nuppAotRuntime()
    if address == nil then
        error("the AOT runtime found no Lua API in this process", 2)
    end
    local cell = ffi.new("const void *[1]", address)
    local bytes = ffi.string(cell, ffi.sizeof("void *"))
    aotRuntime = bytes

    return bytes
end

export = native
