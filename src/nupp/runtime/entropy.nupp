@!internal
module nupp.runtime.entropy

local spi = require("nupp.runtime.packages")
local target = require("nupp.runtime.target")
local nativeProvider = require("nupp.vm.cryptobinding")

local contracts = require("nupp.spi")
local provider: contracts.EntropyProvider = do
    const chosen = spi.select(spi.providers<contracts.EntropyProvider>("nupp.spi.EntropyProvider"))
    if chosen ~= nil then
        yield chosen
    end
    if target.host == "native" then
        yield nativeProvider
    end
    yield _G.require("nupp.runtime.browser.crypto") as contracts.EntropyProvider
end

--- Returns cryptographically secure random bytes from the selected host.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises string when the count is invalid or the host cannot supply randomness
export const randombytes = provider.randombytes
