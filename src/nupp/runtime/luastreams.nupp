@!internal

--[[
Lua's file handles on the native core, over its file layer
(`nupp.runtime.files`): the stream under each handle, a full userdata
with the `FILE*` metatable (`hostcalls.userdata`), its methods (`read`
in every format, `write`, `lines`, `seek`, `setvbuf`, `flush` and
`close`), and Lua's results and errors for them. `nupp.runtime.luaio` is
the library over them, and `nupp.runtime.luaprocess` a process's handle.

A handle reads ahead a buffer's worth and answers every format from it, as
C's stdio does. A write collects its values and hands them to the file
before it returns, one write for the call: the core runs no finalizer at
exit yet, so bytes held past a call would be lost by a program that ends
without closing its file, where Lua's state closing (or C's `exit`) writes
them. `setvbuf("no")` writes each value as it comes.
]]
module nupp.runtime.luastreams

const files = require("nupp.runtime.files")
const luaargs = require("nupp.runtime.luaargs")
const hostcalls = require("nupp.runtime.hostcalls")

-- The bytes a read asks the file for at a time, as stdio's buffer holds.
const BUFFER = 4096

-- What reading the rest of a file asks for past its buffer: this at first,
-- doubling to the most, so a large file is read in a few dozen calls rather
-- than one for every buffer of it.
const ALL_FIRST = 65536
const ALL_MOST = 16777216

-- The longest numeral the "n" format reads, as Lua's L_MAXLENNUM.
const NUMERAL = 200

-- The most formats `lines` keeps, as Lua's MAXARGLINE.
const LINEFORMATS = 250

-- EBADF: what C's stdio answers a read of a file open only for writing, or
-- a write of one open only for reading.
const UNOPENED = 9

-- One open file: its descriptor and its read-ahead.
export record Stream
    descriptor: integer

    --- A standard file, which `close` refuses.
    standard: boolean = false

    closed: boolean = false

    --- Bytes read ahead, unread from `at` on.
    input: string = ""

    at: integer = 1

    --- The buffering `setvbuf` set: "no", "full" or "line", and its size.
    mode: string = "full"

    size: integer = 4096

    --- The error number of a read that failed since the last read began,
    --- as C's error indicator holds it; 0 when none did.
    failure: integer = 0

    --- A pipe's one direction: "r" when it only reads, "w" when it only
    --- writes, "" for a file that does either as it was opened.
    access: string = ""

end

--- A file handle's state: the stream it reads, and the one it writes when
--- that is another (a process's standard input). The handle itself is a full
--- userdata (`hostcalls.userdata`) with a file metatable, carrying this.
export type Handle = {
    stream: Stream,
    writer: Stream?
}

--- The methods of a file handle, and its metatable.
export const methods: {[string]: any} = {}

export const meta: {[string]: any} = {__index = methods, __name = "FILE*"}

-- The metatables of file handles: a plain file's, and those other modules
-- register (a process's).
local filemetas: {[any]: boolean} = {[meta] = true}

--- Makes handles with metatable `m` files: `io.type` names them and the
--- library's functions take them.
export function register(m: {[string]: any}): nil
    filemetas[m] = true
end

--- Whether `value` is a file handle.
export function isfile(value: any): boolean
    return type(value) == "userdata" and filemetas[getmetatable(value)] == true
end

--- The state file handle `handle` carries.
export function state(handle: any): Handle
    return hostcalls.uservalue(handle) as Handle
end

--- The stream a handle writes.
export function writer(handle: any): Stream
    local h = state(handle)
    return h.writer or h.stream
end

local typename = luaargs.typename
local argerror = luaargs.argerror
local integerarg = luaargs.integerarg
local stringarg = luaargs.stringarg

--- The stream of the file handle `value`, argument `position` of `name`, or
--- Lua's error at `level` past the caller.
export function streamof(value: any, position: integer, name: string, level: integer): Stream
    if not isfile(value) then
        argerror(position, name, "FILE* expected, got " .. typename(value), level + 1)
    end

    return state(value).stream
end

--- streamof for a file that must be open, as Lua's tofile.
export function openstream(value: any, position: integer, name: string, level: integer): Stream
    local s = streamof(value, position, name, level + 1)
    if s.closed then
        error("attempt to use a closed file", level + 1)
    end

    return s
end

--- A new file handle over `descriptor`, with metatable `m` (a plain file's
--- by default).
export function newhandle(descriptor: integer, standard: boolean, mode: string, m: {[string]: any}?): any
    local s = Stream(descriptor = descriptor, standard = standard, mode = mode)

    return hostcalls.userdata(m or meta, {stream = s})
end

--- A file handle over stream `s`, with metatable `m`.
export function wrap(s: Stream, m: {[string]: any}): any
    return hostcalls.userdata(m, {stream = s})
end

--- Lua's failure results for error number `code`, its text after `prefix`.
export function failure(code: integer, prefix: string?): (nil, string, integer)
    local text = files.reason(code)
    if prefix ~= nil then
        text = prefix .. ": " .. text
    end

    return nil, text, code
end

----------------------------------------------------------------------------
-- Reading
----------------------------------------------------------------------------

-- Reads ahead when what was read is spent, `wanted` bytes or the buffer's
-- size: false at the end of the file or when the read fails, whose error
-- number the stream keeps.
local function fill(s: Stream, wanted: integer?): boolean
    if s.at <= #s.input then
        return true
    end
    if s.access == "w" then
        s.failure = UNOPENED
        return false
    end
    -- An unbuffered file reads a byte at a time, as C's does.
    local size = s.mode == "no" and 1 or wanted or s.size
    local done = files.read(s.descriptor, size)
    s.input, s.at = "", 1
    if done.code ~= 0 then
        s.failure = done.code
        return false
    end
    s.input = done.text

    return done.text ~= ""
end

-- The next unread byte, or nil at the end.
local function peek(s: Stream): integer?
    if not fill(s) then
        return nil
    end

    return string.byte(s.input, s.at)
end

-- A line, without its newline when `chop`: nil when the file has ended
-- before any byte of it.
local function readline(s: Stream, chop: boolean): string?
    local parts: {string} = {}
    local newline = false
    while fill(s) do
        local stop = string.find(s.input, "\n", s.at, true)
        if stop ~= nil then
            parts[#parts + 1] = string.sub(s.input, s.at, chop and stop - 1 or stop)
            s.at = stop + 1
            newline = true
            break
        end
        parts[#parts + 1] = string.sub(s.input, s.at)
        s.at = #s.input + 1
    end
    local line = table.concat(parts)
    if newline or #line > 0 then
        return line
    end

    return nil
end

-- At most `count` bytes: nil when none are left.
local function readcount(s: Stream, count: integer): string?
    local parts: {string} = {}
    local have: integer = 0
    while have < count and fill(s) do
        local take = math.min(count - have, #s.input - s.at + 1) as integer
        parts[#parts + 1] = string.sub(s.input, s.at, s.at + take - 1)
        s.at = s.at + take
        have = have + take
    end
    if have > 0 then
        return table.concat(parts)
    end

    return nil
end

-- The rest of the file, "" at its end.
local function readall(s: Stream): string
    local parts: {string} = {}
    local wanted = math.max(s.size, ALL_FIRST) as integer
    while fill(s, wanted) do
        parts[#parts + 1] = s.at == 1 and s.input or string.sub(s.input, s.at)
        s.at = #s.input + 1
        wanted = math.min(wanted * 2, math.max(ALL_MOST, s.size)) as integer
    end

    return table.concat(parts)
end

-- Whether the next byte is a decimal or, with `hex`, a hexadecimal digit.
local function isdigit(c: integer?, hex: boolean): boolean
    if c == nil then
        return false
    end
    local byte = c as integer
    if byte >= 48 and byte <= 57 then
        return true
    end

    return hex and (byte >= 97 and byte <= 102 or byte >= 65 and byte <= 70)
end

-- A numeral, as Lua's read_number takes the longest prefix of one (at most
-- NUMERAL bytes) and then converts it: nil when that is not a number. The
-- bytes it takes stay taken either way.
local function readnumber(s: Stream): number?
    local c = peek(s)
    while c ~= nil and (c == 32 or c >= 9 and c <= 13) do
        s.at = s.at + 1
        c = peek(s)
    end
    local taken: {string} = {}
    local overflow = false

    -- Takes the byte looked at, when there is room for it.
    local function take(): boolean
        if #taken >= NUMERAL then
            overflow = true
            return false
        end
        taken[#taken + 1] = string.char(c as integer)
        s.at = s.at + 1
        c = peek(s)

        return true
    end

    -- Takes the byte looked at when it is `a` or `b`.
    local function either(a: integer, b: integer): boolean
        if c == a or c == b then
            return take()
        end
        return false
    end

    local function digits(hex: boolean): integer
        local count: integer = 0
        while isdigit(c, hex) and take() do
            count = count + 1
        end

        return count
    end

    local count: integer = 0
    local hex = false
    either(45, 43)
    if either(48, 48) then
        if either(120, 88) then
            hex = true
        else
            count = 1
        end
    end
    count = count + digits(hex)
    if either(46, 46) then
        count = count + digits(hex)
    end
    if count > 0 and (hex and either(112, 80) or not hex and either(101, 69)) then
        either(45, 43)
        digits(false)
    end
    if overflow then
        return nil
    end

    return tonumber(table.concat(taken))
end

--- The values `...` asks for, read from `s` as Lua's g_read reads them: one
--- per format until one fails, nil in its place; or, when a read failed,
--- nil, the system's text and its number. The formats are arguments
--- `position` on of `name`, for errors raised at `level` past the caller.
export function readformats(s: Stream, position: integer, name: string, level: integer, ...: any): ...any
    s.failure = 0
    local count = select("#", ...)
    local results: {any} = {}
    local n: integer = 0
    if count == 0 then
        results[1] = readline(s, true)
        n = 1
    else
        local success = true
        local index: integer = 1
        while index <= count and success do
            local format: any = select(index, ...)
            local value: any = nil
            if type(format) == "number" then
                local size = integerarg(format, position + index - 1, name, level + 1)
                if size == 0 then
                    if fill(s) then
                        value = ""
                    end
                else
                    value = readcount(s, size)
                end
            else
                local text = stringarg(format, nil, position + index - 1, name, level + 1)
                local first = string.sub(text, 1, 1) == "*" and 2 or 1
                local kind = string.sub(text, first, first)
                if kind == "n" then
                    value = readnumber(s)
                elseif kind == "l" then
                    value = readline(s, true)
                elseif kind == "L" then
                    value = readline(s, false)
                elseif kind == "a" then
                    value = readall(s)
                else
                    argerror(position + index - 1, name, "invalid format", level + 1)
                end
            end
            results[index] = value
            n = index
            success = value ~= nil
            index = index + 1
        end
    end
    if s.failure ~= 0 then
        return failure(s.failure)
    end

    return table.unpack(results, 1, n)
end

----------------------------------------------------------------------------
-- Writing
----------------------------------------------------------------------------

--- Hands the bytes read ahead back to the file, so a write lands where the
--- reading stopped: the descriptor moves back over them. A file that cannot
--- seek keeps nothing to hand back that a write would land behind.
export function unread(s: Stream): nil
    local pending = #s.input - s.at + 1
    s.input, s.at = "", 1
    if pending > 0 then
        files.seek(s.descriptor, -pending, files.FROMHERE)
    end
end

--- Writes all of `text`: the bytes written, and 0 or the error number that
--- stopped it.
export function emit(s: Stream, text: string): (integer, integer)
    if s.access == "r" then
        return 0, UNOPENED
    end
    local first: integer = 1
    while first <= #text do
        local done = files.write(s.descriptor, text, first)
        if done.code ~= 0 then
            return first - 1, done.code
        end
        if done.value <= 0 then
            -- A write that takes nothing will not take the rest: C's EIO.
            return first - 1, 5
        end
        first = first + done.value
    end

    return #text, 0
end

--- Writes `...` to the file of `handle` as Lua's g_write does, strings as
--- they are and numbers as tostring writes them: `handle`, or nil, the
--- system's text, its number and the bytes written. The values are arguments
--- `position` on of `name`; one of another type raises at `level` past the
--- caller once those before it are written.
export function writevalues(handle: any, s: Stream, position: integer, name: string, level: integer, ...: any): ...any
    unread(s)
    local pieces: {string} = {}
    local total = 0
    local count = select("#", ...)

    -- Writes the collected pieces: 0, or the error number that stopped it.
    local function drain(): integer
        if #pieces == 0 then
            return 0
        end
        local written, code = emit(s, table.concat(pieces))
        pieces = {}
        total = total + written

        return code
    end

    for index = 1, count do
        local value: any = select(index, ...)
        local text = ""
        if type(value) == "number" then
            text = tostring(value)
        elseif type(value) == "string" then
            text = value as string
        else
            drain()
            argerror(position + index - 1, name, "string expected, got " .. typename(value), level + 1)
        end
        pieces[#pieces + 1] = text
        if s.mode == "no" then
            local code = drain()
            if code ~= 0 then
                local _, text2, number = failure(code)
                return nil, text2, number, total
            end
        end
    end
    local code = drain()
    if code ~= 0 then
        local _, text, number = failure(code)
        return nil, text, number, total
    end

    return handle
end

----------------------------------------------------------------------------
-- Handles
----------------------------------------------------------------------------

--- Closes the file of `s`: true, or Lua's failure results. A standard file
--- stays open and answers nil and Lua's message.
export function closestream(s: Stream): (boolean?, string?, integer?)
    if s.standard then
        return nil, "cannot close standard file"
    end
    s.closed = true
    s.input, s.at = "", 1
    local done = files.close(s.descriptor)
    if done.code ~= 0 then
        return failure(done.code)
    end

    return true
end

--- An iterator over the values `formats` asks for, as Lua's io_readline:
--- nothing once the file is read, closing it then when `toclose`.
export function lineiterator(s: Stream, toclose: boolean, formats: {any}, count: integer): function(): ...any
    -- The results of a read and their count.
    local function packed(...: any): ({any}, integer)
        return {...}, select("#", ...)
    end

    return function(): ...any
        if s.closed then
            error("file is already closed", 2)
        end
        local results, n = packed(readformats(s, 2, "?", 2, table.unpack(formats, 1, count)))
        if results[1] ~= nil and results[1] ~= false then
            return table.unpack(results, 1, n)
        end
        if n > 1 and type(results[2]) == "string" then
            error(results[2], 2)
        end
        if toclose then
            closestream(s)
        end

        return nil
    end
end

--- The formats after the file, kept for an iterator, as Lua's aux_lines.
export function lineformats(position: integer, name: string, level: integer, ...: any): ({any}, integer)
    local count = select("#", ...)
    if count > LINEFORMATS then
        argerror(LINEFORMATS + position, name, "too many arguments", level + 1)
    end

    return {...}, count
end

--- Reads the values `...` asks for: "n", "l", "L", "a" or a byte count.
methods.read = function(self: any, ...: any): ...any
    local s = openstream(self, 1, "?", 2)

    return readformats(s, 2, "?", 2, ...)
end

--- Writes strings and numbers: the file, or Lua's failure results.
methods.write = function(self: any, ...: any): ...any
    local s = openstream(self, 1, "?", 2)

    return writevalues(self, s, 2, "?", 2, ...)
end

--- An iterator over the values `...` asks for, a line by default.
methods.lines = function(self: any, ...: any): function(): ...any
    local s = openstream(self, 1, "?", 2)
    local formats, count = lineformats(2, "?", 2, ...)

    return lineiterator(s, false, formats, count)
end

--- Writes what is buffered: true, as every write has reached the file
--- before it returned.
methods.flush = function(self: any): (boolean?, string?, integer?)
    openstream(self, 1, "?", 2)

    return true
end

--- Moves the file to `offset` from "set", "cur" or "end": the new position,
--- or Lua's failure results.
export function seekstream(
    s: Stream,
    whence: any,
    offset: any,
    position: integer,
    name: string,
    level: integer
): (integer?, string?, integer?)
    local originName = stringarg(whence, "cur", position, name, level + 1)
    local origin = originName == "set" and files.FROMSTART
        or originName == "cur" and files.FROMHERE
        or originName == "end" and files.FROMEND
        or nil
    if origin == nil then
        argerror(position, name, ("invalid option '%s'"):format(originName), level + 1)
    end
    local at = offset == nil and 0 or integerarg(offset, position + 1, name, level + 1)
    local pending = #s.input - s.at + 1
    local move = origin == files.FROMHERE and at - pending or at
    local done = files.seek(s.descriptor, move, origin as integer)
    if done.code ~= 0 then
        return failure(done.code)
    end
    s.input, s.at = "", 1

    return done.value
end

methods.seek = function(self: any, whence: any, offset: any): (integer?, string?, integer?)
    return seekstream(openstream(self, 1, "?", 2), whence, offset, 2, "?", 2)
end

export function bufferstream(
    s: Stream,
    mode: any,
    size: any,
    position: integer,
    name: string,
    level: integer
): (boolean?, string?, integer?)
    local how = stringarg(mode, nil, position, name, level + 1)
    if how ~= "no" and how ~= "full" and how ~= "line" then
        argerror(position, name, ("invalid option '%s'"):format(how), level + 1)
    end
    local bytes = size == nil and BUFFER or integerarg(size, position + 1, name, level + 1)
    s.mode = how
    s.size = bytes > 0 and bytes or BUFFER

    return true
end

--- Sets the file's buffering: "no", "full" or "line", with a size.
methods.setvbuf = function(self: any, mode: any, size: any): (boolean?, string?, integer?)
    return bufferstream(openstream(self, 1, "?", 2), mode, size, 2, "?", 2)
end

--- Closes the file: true, or Lua's failure results.
methods.close = function(self: any): (boolean?, string?, integer?)
    local s = openstream(self, 1, "?", 2)

    return closestream(s)
end

meta.__tostring = function(self: any): string
    local s = state(self).stream
    if s.closed then
        return "file (closed)"
    end

    return "file (" .. (string.match(tostring(s), "0x%x+") or "?") .. ")"
end
