@!internal
module nupp.runtime.bindings.files

local contracts = require("io.internal.files.contracts")
local target = require("nupp.runtime.target")
local implementation: contracts.Provider = do
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativefiles") as contracts.Provider
    end
    yield _G.require("nupp.runtime.browser.files") as contracts.Provider
end

-- Exported untyped while the pinned stage zero stages its own `io.files` facade,
-- which reads this module against the provider contract it was built with. The
-- importers here annotate the contract themselves.
export = implementation as any
