@!internal
module nupp.runtime.bindings.http

local contracts = require("nupp.io.http.contracts")
local target = require("nupp.runtime.target")
local implementation: contracts.Provider = do
    if target.host == "native" then
        yield _G.require("nupp.runtime.provider.nativehttp") as contracts.Provider
    end
    yield _G.require("nupp.runtime.browser.http") as contracts.Provider
end

export = implementation
