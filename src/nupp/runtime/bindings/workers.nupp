@!internal
module nupp.runtime.bindings.workers

local contracts = require("nupp.workers.contracts")
local target = require("nupp.runtime.target")
local optional = require("nupp.runtime.optional")

export const provider: contracts.Provider? = do
    if target.host == "native" then
        if package.preload["nupp.workers.native"] ~= nil or package.loaded["nupp.workers.native"] ~= nil then
            yield optional.load("nupp.runtime.provider.workers")
        end
        yield nil
    end
    if rawget(_G, "__nuppBrowser") ~= nil then
        yield optional.load("nupp.runtime.browser.workers")
    end
    yield nil
end
