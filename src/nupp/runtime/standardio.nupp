@!internal

--[[
`io` provides paths, URIs, file streams, byte storage, and readers and writers.
Its byte interfaces work over buffers, files, and HTTP response bodies.

```nupp:playground
local bytes = io.newbuffer("hello")
local reader = bytes:reader()
assert(reader:read(5) == "hello")
```

Files expose borrowed byte views through `File:reader()` and `File:writer()`.
Processes expose their individual streams; network connections, TLS sessions,
and HTTP bodies use the [](io.Reader) and [](io.Writer) interfaces. A parser
written against either contract accepts those views and streams.

See [](io.files) for the filesystem, [](io.popen) for child processes,
[](io.net) for plain and encrypted connections, and [](io.http) for the HTTP
client.

## Ownership

Buffers, views, readers, writers, and their adapters are owners. A factory that
takes a reader or writer transfers its close obligation to the adapter; a
factory that borrows a buffer or byte queue leaves that value with its caller.
`close` consumes an owner. Types that expose `isreleased` report their state
without changing it.

## Failures

Filesystem path operations and network, TLS, and HTTP operations return
[](io.Error) values for environmental failures. An error carries a portable
`kind` and the platform's `message`:

```nupp
local info, err = io.files.info("settings.json")
if info == nil and err ~= nil and err.kind == "notfound" then
    print("No settings file")
end
```

An error prints as its message and joins text the same way.
`io.open`, `io.popen`, `os.remove`, `os.rename`, Lua File methods, and the
byte-stream contracts return string reasons. Process controls such as `communicate` retain structured
errors.
]]

--- @namespace io
module nupp.runtime.standardio

local immutable = require("io.internal.bytestypes")

--- Immutable engine-owned bytes, shared across worker lanes without copying.
---
--- Slices retain the same allocation. Positions are zero-based byte offsets;
--- `view` and `viewas` borrow storage, while `tostring` copies it into a Lua string.
--- `copy` creates bytes from a string and `readfile` reads directly into storage.
--- `newbuilder` creates an owned `Bytes.Builder`; `freeze` consumes it and transfers
--- its allocation without copying. These operations require the engine host
--- supplied by a stamped binary.
export type Bytes = immutable.Bytes

export const Bytes = immutable.Bytes

local source1 = require("nupp.io")
const {type Path as NativePath} = require("io.internal.path")
const {type AppPath} = require("io.files")
local uriTypes = require("io.internal.uritypes")

--- An immutable absolute URI with normalized components.
export type URI = uriTypes.URI

export const URI = uriTypes.URI

--- Reports whether a value is a URI rather than URI text or component data.
--- @param value the value to test
--- @return whether it is a URI
export const isuri = uriTypes.isuri

--- An immutable filesystem path with platform-specific joining and splitting.
---
--- Reach for it when a program builds a filesystem name or takes one apart,
--- rather than when it reads the bytes behind one.
---
--- ```nupp
--- local source = io.newpath("src", "app", "..", "main.nupp"):normalize()
--- assert(source:tostring() == "src" .. io.sep() .. "main.nupp")
--- assert(source:filename() == "main.nupp")
--- ```
---
--- Path transformations leave the original unchanged. Two paths are equal when
--- their native text is. `tostring(path)` and `path:tostring()` return that
--- same text.
---
--- #### Building a path
---
--- `io.newpath(first, parts...)` joins its components using the current
--- platform's rules. `join` appends more to a path already built, and both
--- accept a string or another path. `Path` has no public constructor; creation
--- goes through `newpath`, which interns recent paths in a bounded LRU cache.
---
--- ```nupp
--- local native = io.newpath("out"):join("lib", "native")
--- assert(native:filename() == "native")
--- ```
---
--- `io.cwd()` returns the current working directory, and `io.sep()` returns the
--- platform's primary path separator:
---
--- ```nupp
--- local current, reason = io.cwd()
--- assert(current, reason)
--- local log = current:join("var", "app.log"):withextension("jsonl")
--- assert(log:extension() == "jsonl")
--- ```
---
--- #### Normalizing and resolving
---
--- `normalize` removes lexical `.` and `..` components without touching the
--- filesystem, so it returns even for a path that does not exist:
---
--- ```nupp
--- assert(io.newpath("src", "app", "..", "main.nupp"):normalize():stem() == "main")
--- ```
---
--- The operations that consult the process or filesystem can fail, as can a
--- relative path whose base uses a different coordinate system. Each returns
--- nil with a reason when it does.
---
--- - `absolute()` resolves the path against the process's working directory. A
---   drive-relative Windows path fails when that directory uses another drive.
--- - `resolve(parts...)` makes it absolute, appends the parts, and normalizes.
--- - `canonicalize()` asks the filesystem for the real path, following every
---   symbolic link, which requires the path to exist.
--- - `relativeto(base)` expresses the path against another one, when both share a
---   coordinate system. A path expressed against itself returns `.`, the path
---   that stays where the base already is.
---
--- ```nupp
--- local real, reason = io.newpath("."):canonicalize()
--- assert(real, reason)
--- assert(real:isabsolute())
--- ```
---
--- #### Path components
---
--- `parent` returns another path or nil. `filename`, `stem` and `extension`
--- return the final component, that component without its extension, and the
--- extension without its dot:
---
--- ```nupp
--- local source = io.newpath("src", "main.nupp")
--- assert(source:filename() == "main.nupp")
--- assert(source:stem() == "main")
--- assert(source:extension() == "nupp")
--- assert(assert(source:parent()):tostring() == "src")
--- ```
---
--- `withfilename` and `withextension` replace one component. Each takes one
--- path component and raises when handed text that is not one, so a separator
--- smuggled into a file name is reported where it was written rather than
--- carried into the path it would have produced:
---
--- ```nupp
--- local report = io.newpath("out", "report.tmp"):withextension("json")
--- assert(report:filename() == "report.json")
--- ```
---
--- `isabsolute` and `isrelative` classify a path without accessing the
--- filesystem.
---
--- `io.open`, `io.lines`, `io.input`, and `io.output` accept a path wherever
--- they accept a filename. Filesystem operations, HTTP file bodies, and child
--- working directories also accept paths.
export type Path = NativePath

--- A file handle with Lua methods and borrowed byte-stream views.
---
--- `reader` and `writer` share its cursor and must close before the file. Native
--- files retain Lua userdata handles. Browser app files can suspend while
--- reading, writing, or seeking; close does not suspend. Browser writes are
--- unbuffered, and `setvbuf` refuses other buffering modes.
export type File = io.File

--- Supplies the borrowed byte-stream methods of `File`.
export interface FileMethods
    --- Borrows the shared file cursor through a byte reader.
    ---
    --- Closing the view leaves the file open. The view cannot outlive the file.
    --- @param self the file to borrow exclusively
    --- @return the byte reader, borrowing the file
    reader: function(exclusive self: io.File): affine(source1.Reader) borrows (self)

    --- Borrows the shared file cursor through a byte writer.
    ---
    --- Closing the view leaves the file open. The view cannot outlive the file.
    --- @param self the file to borrow exclusively
    --- @return the byte writer, borrowing the file
    writer: function(exclusive self: io.File): affine(source1.Writer) borrows (self)
end

export type Buffer = source1.Buffer
export type BufferWriteLease = source1.BufferWriteLease
export type ByteQueue = source1.ByteQueue
export type ByteView = source1.ByteView
export type Error = source1.Error
export type Lines = source1.Lines
export type Reader = source1.Reader

--- @internal
export const Reader = source1.Reader

export type ScalarReader = source1.ScalarReader
export type ScalarWriter = source1.ScalarWriter

--- Scalar reads and writes over one byte handle.
---
--- See [](io.ScalarReader) and [](io.ScalarWriter) for the numeric operations
--- and ownership contract.
export type ScalarStream = source1.ScalarStream

export type Writer = source1.Writer

--- @internal
export const Writer = source1.Writer

export const Error = source1.Error
export const newbuffer = source1.newBuffer
export const newreader = source1.newReader
export const newwriter = source1.newWriter
export const readall = source1.readAll

const {type Process as ChildProcess} = require("io.internal.process")

export type Process = ChildProcess

local original: any = rawget(_G, "io")
local luaOpen = original.open
local luaLines = original.lines
local luaInput = original.input
local luaOutput = original.output
local luaClose = original.close
local luaType = original.type
local luaRead = original.read
local luaWrite = original.write
local luaFlush = original.flush
local processInput: any = nil
local processOutput: any = nil

local function fileHandle(value: any): any
    local handles: any = rawget(_G, "__nuppProcessHandles")
    if handles and handles[value] then
        return handles[value]
    end
    local files: any = rawget(_G, "__nuppFileHandles")

    return files and files[value] or nil
end

local function requireOpenFile(value: any): nil
    local child = fileHandle(value)
    if child and child.state.reaped then
        error("attempt to use a closed file", 3)
    end
end

const _URI_REQUIRES = "@requires-dynamically io.internal.uri"
local uris: any = nil

local function uriImplementation(name: string): any
    if uris == nil then
        uris = require(name)
    end
    return uris
end

--- Parses absolute URI text or assembles a URI from components.
---
--- Normalizes with the [WHATWG URL Standard](https://url.spec.whatwg.org/).
--- A host needing IDNA requires a native or browser URL parser. Successful parses
--- reuse the 1024 most recently used normalized URI values.
---
--- ```nupp
--- local address = assert(io.newuri("https://example.com/a?b=1"))
--- assert(address:host() == "example.com" and address:query() == "b=1")
--- local endpoint = assert(io.newuri(new io.URI.Components(
---     scheme = "https", host = "example.com", path = "/status"
--- )))
--- ```
--- @param value absolute URI text or components to assemble
--- @return the URI, or nil when it cannot be parsed
--- @return a failure reason, when unsuccessful
export function newuri(value: string | URI.Components): (URI?, string?)
    return uriImplementation("io.internal.uri").newuri(value)
end

--- Reports whether text parses as an absolute URI without retaining a URI value.
--- @param value the text to test
--- @return whether it parses
--- @return a failure reason, when unsuccessful
export function validateuri(value: string): (boolean, string?)
    return uriImplementation("io.internal.uri").validateuri(value)
end

const _PATH_REQUIRES = "@requires-dynamically io.internal.path"
local paths: any = nil

local function pathImplementation(name: string): any
    if paths == nil then
        paths = require(name)
    end
    return paths
end

--- Builds a path by joining components using the platform's rules.
---
--- #### Examples
---
--- ```nupp
--- local source = io.newpath("src", "main.nupp")
--- ```
--- @param first the first path component
--- @param ... the remaining path components
--- @return the joined path
export function newpath(first: string | Path, ...: string | Path): Path
    return pathImplementation("io.internal.path").newpath(first, ...)
end

--- Returns the process's current working directory.
--- @return the current directory, or nil on failure
--- @return a failure reason, when unsuccessful
export function cwd(): (Path?, string?)
    return pathImplementation("io.internal.path").cwd()
end

--- Returns the current platform's primary path separator.
--- @return the path separator
export function sep(): string
    return pathImplementation("io.internal.path").sep()
end

local function filename(value: any): any
    if type(value) == "table" then
        return value:tostring()
    end
    return value
end

const _FILE_VIEWS_REQUIRES = "@requires-dynamically io.internal.fileviews"
const _PORTABLE_FILE_REQUIRES = "@requires-dynamically io.internal.portablefile"
local fileViews: any = nil

local function views(): any
    if fileViews == nil then
        fileViews = require("io.internal.fileviews")
    end
    return fileViews
end

local function fileReader(file: any): any
    return views().reader(file)
end

local function fileWriter(file: any): any
    return views().writer(file)
end

local function decorateFile(file: any): any
    if file ~= nil then
        local meta: any = getmetatable(file)
        if meta ~= nil and type(meta.__index) == "table" then
            meta.__index.reader = fileReader
            meta.__index.writer = fileWriter
        end
    end

    return file
end

local function openFile(path: any, mode: any): ...any
    if rawget(_G, "__nuppBrowser") ~= nil then
        return require("io.internal.portablefile").open(path, mode)
    end
    local file, reason, code = luaOpen(filename(path), mode)

    return decorateFile(file), reason, code
end

local function fileLines(path: any, ...: any): ...any
    if path == nil and processInput ~= nil then
        return processInput:lines(...)
    end
    if rawget(_G, "__nuppBrowser") ~= nil and path ~= nil then
        local file, reason = openFile(path, "r")
        if file == nil then
            error(reason, 2)
        end
        local iter = file:lines(...)

        local function nextLine(ok: boolean, ...: any): ...any
            if not ok or select(1, ...) == nil then
                if original.type(file) ~= "closed file" then
                    file:close()
                end
            end
            if not ok then
                error((...), 0)
            end

            return ...
        end

        return function(): ...any
            return nextLine(pcall(iter))
        end
    end

    return luaLines(filename(path), ...)
end

local function inputFile(file: any): any
    if file == nil then
        return processInput or luaInput()
    end
    if fileHandle(file) then
        requireOpenFile(file)
        processInput = file
        return file
    end
    local result = luaInput(filename(file))
    processInput = nil

    return result
end

local function outputFile(file: any): any
    if file == nil then
        return processOutput or luaOutput()
    end
    if fileHandle(file) then
        requireOpenFile(file)
        processOutput = file
        return file
    end
    local result = luaOutput(filename(file))
    processOutput = nil

    return result
end

--- Opens a file from a filename or path using Lua file modes.
---
--- ```nupp
--- local path = io.newpath("README.md")
--- local file = assert(io.open(path, "r"))
--- print(file:read("*a"))
--- ```
---
--- Native hosts accept a filename or `io.Path`; browser hosts accept an app path
--- from [](io.files). Byte-stream views from `reader` and `writer` share the file
--- cursor and borrow its lifetime. Closing a view leaves the file open.
---
--- @param path the filename, native path, or browser app path to open
--- @param mode the mode to open it in, "r" by default
--- @return the owned file handle, or nil on failure
--- @return a failure reason, when unsuccessful
export const open = openFile as function(
    path: string | Path | AppPath,
    mode: string?
): (affine(io.File, __nuppCloseFile)?, string?)

--- Iterates over a named file, closing it at EOF, or reads the default input.
---
--- Browser app files may suspend between lines. Named files close at EOF or
--- a read error. Use `File:reader():lines(limit)` for bounded, owned line reads.
--- @param path the filename or path, or nil for the default input
--- @param format the first Lua read format, when supplied
--- @param ... the remaining Lua read formats
--- @return an iterator yielding the selected read formats
export const lines = fileLines as(function(path: (string | Path | AppPath)?): function(): string?)
    & (function(path: (string | Path | AppPath)?, format: string | number, ...: any): function(): ...any)

--- Returns or sets the default input file.
--- @param file a file handle, filename, or path, or nil to return the current file
--- @return the default input file
export const input = inputFile as function(file: (File | string | Path)?): File

--- Returns or sets the default output file.
--- @param file a file handle, filename, or path, or nil to return the current file
--- @return the default output file
export const output = outputFile as function(file: (File | string | Path)?): File

const _DYNAMIC_REQUIRES = "@requires-dynamically io.internal.process"

-- The popen feature carries this implementation when a program uses it. Merely
-- loading the byte I/O installer must not select a process provider.
local function processImplementation(name: string): any
    local ok, implementation = pcall(require, name)
    if not ok then
        error(implementation, 0)
    end

    return implementation
end

local function openProcess(command: any, options: any): ...any
    local implementation = processImplementation("io.internal.process")
    return implementation.spawn(command, options)
end

--- Starts a shell command or argument vector and returns an owned process.
---
--- A string invokes the shell; an argument array starts its first entry directly.
--- The second argument accepts Lua's "r" or "w" pipe mode, or process options.
--- The default reads stdout, inherits stdin, and inherits stderr. Set `stdin`
--- and `stderr` to "pipe" for a complete duplex exchange with `communicate`.
--- Set `mode` in an options table to choose the same file profile with other
--- controls. On Windows, "r" and "w" translate text; "rb" and "wb" preserve
--- bytes. Explicit byte streams and `communicate` always transfer raw bytes.
---
--- ```nupp
--- local child = assert(io.popen({"git", "status", "--short"}, {
---     cwd = assert(io.cwd()),
---     stderr = "pipe",
---     timeoutms = 5000,
--- }))
--- local result = assert(child:communicate())
--- print(result.output)
--- ```
---
--- Existing Lua calls keep file operations on the same process object:
---
--- ```nupp
--- local pipe = assert(io.popen("git status --short", "r"))
--- print(pipe:read("*a"))
--- local ok, reason, code = pipe:close()
--- ```
---
--- `read` and `lines` read stdout; `write`, `flush`, and `setvbuf` write stdin.
--- Explicit `close` closes the pipes and waits normally without suspending. Dropping an
--- unfinished owner terminates and reaps it. See [](io.Process) for process controls.
---
--- @param command the shell command or program and arguments
--- @param options a process options table or Lua pipe mode, "r" by default
--- @return the owned process on success
--- @return the failure message when the child could not be started
--- @return the operating-system error code, when available
export const popen = openProcess as function(
    command: string | {string},
    options: (Process.Options | string)?
): (affine(Process)?, string?, integer?)

local function closeFile(value: any): ...any
    local selected = value or processOutput
    if fileHandle(selected) then
        return selected:close()
    end

    return luaClose(value)
end

local function fileType(...: any): any
    local value: any = (...)
    local child = fileHandle(value)
    if child then
        return child.state.reaped and "closed file" or "file"
    end

    return luaType(...)
end

local function readFile(...: any): ...any
    if processInput ~= nil then
        return processInput:read(...)
    end
    return luaRead(...)
end

local function writeFile(...: any): ...any
    if processOutput ~= nil then
        return processOutput:write(...)
    end
    return luaWrite(...)
end

local function flushFile(): ...any
    if processOutput ~= nil then
        return processOutput:flush()
    end
    return luaFlush()
end

--- @internal
export const value: table = do
    original.Bytes = Bytes
    original.URI = URI
    original.newuri = newuri
    original.isuri = isuri
    original.validateuri = validateuri
    original.newpath = newpath
    original.cwd = cwd
    original.sep = sep
    original.open = open
    original.lines = lines
    original.input = input
    original.output = output
    original.Error = Error
    original.newbuffer = newbuffer
    original.Reader = Reader
    original.Writer = Writer
    original.newreader = newreader
    original.newwriter = newwriter
    original.readall = readall
    decorateFile(original.stdin)
    decorateFile(original.stdout)
    decorateFile(original.stderr)
    original.popen = popen
    original.close = closeFile
    original.type = fileType
    original.read = readFile
    original.write = writeFile
    original.flush = flushFile
    yield original
end
