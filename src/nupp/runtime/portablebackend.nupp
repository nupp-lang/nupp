module nupp.runtime.portablebackend

--[[Recommended representation backend; runtime library rocks remain explicit.]]

const Backend = require("nupp.runtime.backend")
const Bitops = require("nupp.runtime.seam.bitops")
const Structvalue = require("nupp.runtime.seam.structvalue")
const Simd = require("nupp.runtime.seam.simd")

export = Backend.new("nupp.portable", {
    Bitops.seam("bit"),
    Structvalue.seam("nupp.runtime.provider.tablestruct"),
    Simd.seam("nupp.runtime.provider.scalarsimd"),
})
