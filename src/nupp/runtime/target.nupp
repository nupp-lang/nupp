@!internal
module nupp.runtime.target

--- The VM running this code. The compiler fixes it to `luajit`, which every artifact
--- targets; source loaded without compiling detects it.
export const dialect: string = rawget(_G, "jit") ~= nil and "luajit" or "lua51"

--- The host services this code runs under, fixed by the compiler from the target.
export const host: string = rawget(_G, "__nuppBrowser") ~= nil and "browser" or "native"
