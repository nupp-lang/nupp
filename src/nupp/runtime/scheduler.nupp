@!internal

module nupp.runtime.scheduler

--[[
The native core's scheduler (Decision 18), written in Nupp over the core's
thread primitives (`nupp.runtime.taskcalls`). A task is a thread like any
coroutine; the scheduler drives it. A park passes through every coroutine
the task resumed, so a generator whose body sleeps parks the whole stack and
resumes where it was.

Whoever waits drives: a task that waits parks, and its driver runs the next
runnable one; the main thread's own stack (and any coroutine it resumed) has
no driver above it, so its wait runs the scheduler in place until it is
woken. Timers are a deadline heap here; with nothing runnable the scheduler
waits in the reactor (`nupp.runtime.reactor`) until the nearest deadline or
an I/O completion, so parked I/O and timers share one loop: the reactor's
Parker is this scheduler's park, and its waker wakes the task like any
wait. A program's image carries this module when it uses the task surface
(`coroutine.scope` and its kin), which the core reads from `functions`.

Each task's body runs under a `nupp.suspension` driver, so a library wait
made through it (a process pipe, a child's exit) parks the task like any
other park, and the scheduler polls that wait's readiness sources whenever
nothing else can run.
]]

local calls = require("nupp.runtime.taskcalls")
local pollcalls = require("nupp.runtime.pollcalls")
local reactor = require("nupp.runtime.reactor")
local nativeTimers = require("nupp.runtime.provider.nativetime")
local suspension = require("nupp.suspension")
local taskCancellation = require("nupp.suspension.cancellation")
local coroutines = require("nupp.suspension.internal.coroutines")
local readiness = require("nupp.suspension.internal.provider")
local suspensionHost = require("nupp.suspension.host")
local taskownership = require("nupp.runtime.taskownership")

-- What a run of a task answers first.
const RETURNED = 1
const FAILED = 2
const YIELDED = 4

-- How long the scheduler sleeps between polls of readiness sources while a
-- task waits through nupp.suspension: they answer only when polled.
const SOURCE_SLICE_MS = 2

-- What a cancelled park is woken with.
local CANCEL: any = {}

----------------------------------------------------------------------------
-- Cancellation
----------------------------------------------------------------------------

local cancellation = taskCancellation.create
local iscancelled = taskCancellation.is

local FailureMT: any = {}

FailureMT.__tostring = function(value: any): string
    local text = tostring(value.primary)
    for index = 1, value.suppressedCount do
        text = text .. "\ncleanup: " .. tostring(value.suppressed[index])
    end

    return text
end

local function withFailures(primary: any, suppressed: {any}, count: integer): any
    if count == 0 then
        return primary
    end

    return setmetatable({primary = primary, suppressed = suppressed, suppressedCount = count}, FailureMT)
end

----------------------------------------------------------------------------
-- The run queue and the timers
----------------------------------------------------------------------------

-- The tasks that may run, oldest first, from `head` to `tail`.
local queue: {any} = {}
local head: integer = 1
local tail: integer = 0

-- The deadline heap: entries ordered by `at`, then by `seq`.
local timers: {any} = {}
local sequence: integer = 0

local function earlier(a: any, b: any): boolean
    if a.at ~= b.at then
        return a.at < b.at
    end

    return a.seq < b.seq
end

local function addtimer(entry: any): nil
    sequence = sequence + 1
    entry.seq = sequence
    local at = #timers + 1
    timers[at] = entry
    while at > 1 do
        local parent = at // 2
        if not earlier(timers[at], timers[parent]) then
            break
        end
        timers[at], timers[parent] = timers[parent], timers[at]
        at = parent
    end
end

local function poptimer(): any
    local top = timers[1]
    local last: integer = #timers
    timers[1] = timers[last]
    timers[last] = nil
    last = last - 1
    local at: integer = 1
    while true do
        local left, right = at * 2, at * 2 + 1
        local least = at
        if left <= last and earlier(timers[left], timers[least]) then
            least = left
        end
        if right <= last and earlier(timers[right], timers[least]) then
            least = right
        end
        if least == at then
            break
        end
        timers[at], timers[least] = timers[least], timers[at]
        at = least
    end

    return top
end

local function enqueue(record: any, value: any): nil
    if record.queued then
        return
    end
    record.queued = true
    record.wake = value
    tail = tail + 1
    queue[tail] = record
end

-- A waiter: a parked task's record and the ticket its park holds, or the
-- main stack's box.
local function wake(waiter: any, value: any): nil
    local record = waiter.record
    if record == nil then
        if not waiter.done then
            waiter.done = true
            waiter.value = value
        end
        return
    end
    -- A stale ticket is a park this one no longer waits in.
    if record.ticket == waiter.ticket then
        record.ticket = record.ticket + 1
        enqueue(record, value)
    end
end

local function stale(entry: any): boolean
    local waiter = entry.waiter
    if waiter ~= nil then
        local record = waiter.record
        if record == nil then
            return waiter.done
        end
        return record.ticket ~= waiter.ticket
    end

    return entry.scope.closed or (entry.scope.live == 0 and not entry.scope.bodyActive)
end

local deadlinepassed: function(any): nil

local function fire(entry: any): nil
    if entry.waiter ~= nil then
        wake(entry.waiter, true)
    else
        deadlinepassed(entry.scope)
    end
end

-- Tasks parked on a nupp.suspension wait, and the next one to give a source turn.
local suspended: {any} = {}
local suspendCursor: integer = 0

local ownerWait: reactor.OwnerWait? = nil
local ownerActive: (function(): boolean)? = nil

-- Only a native composition with a bound owner call installs this route.
export function installOwnerWait(poll: reactor.OwnerWait?, active: (function(): boolean)?): nil
    ownerWait = poll
    ownerActive = poll ~= nil and active or nil
end

local function nativeOwnerWork(): boolean
    local active = ownerActive
    return reactor.owesPoolWork() or (active ~= nil and active())
end

local function ownerWork(): boolean
    return #suspended > 0 or nativeOwnerWork()
end

local function waitSource(): boolean
    for _ = 1, #suspended do
        local count = #suspended
        if count == 0 then
            break
        end
        suspendCursor = suspendCursor % count + 1
        if readiness.waitOnce(suspended[suspendCursor].waiting) then
            return true
        end
    end

    return false
end

local function ownerTurn(poll: reactor.OwnerWait, deadline: number): nil
    reactor.waitOwner(poll, deadline)
    suspension.poll()
end

-- The scheduler's wait while nothing can run: the reactor's, taking I/O
-- completions too with the nearest deadline as its timeout, once any I/O is
-- pending; with none, the bridge's sleep. Both clocks are the monotonic one
-- in milliseconds.
local function wait(milliseconds: number, poll: reactor.OwnerWait?): nil
    if milliseconds >= 1 and reactor.pending() == 0 and not nativeOwnerWork() and waitSource() then
        suspension.poll()
    elseif poll ~= nil then
        ownerTurn(poll, (calls.now() as number) + milliseconds)
    elseif reactor.pending() > 0 then
        reactor.wait((calls.now() as number) + milliseconds)
    else
        calls.sleep(milliseconds)
    end
end

local runone: function(any): nil

-- Runs one runnable task, or waits for the nearest timer and fires what is
-- due. Raises when nothing could ever wake the caller.
local function step(): nil
    local poll = ownerWait
    if head <= tail and poll ~= nil and ownerWork() then
        ownerTurn(poll, calls.now() as number)
    end
    if head <= tail then
        local record = queue[head]
        queue[head] = nil
        head = head + 1
        if head > tail then
            head, tail = 1, 0
        end
        runone(record)
        return
    end
    -- A source wakes its task through `wake`, whatever count it answers.
    local polling = #suspended > 0 or nativeTimers.hasPending()
    if polling then
        suspension.poll()
        if head <= tail then
            return
        end
    end
    local owner = poll ~= nil and ownerWork() and poll or nil
    while #timers > 0 and stale(timers[1]) do
        poptimer()
    end
    if #timers == 0 then
        if #suspended > 0
            and reactor.pending() == 0
            and not nativeOwnerWork()
            and not suspension.handled()
            and not readiness.hasActiveSources()
        then
            suspended[1].refuse()
            return
        end
        if polling or owner ~= nil then
            wait(SOURCE_SLICE_MS, owner)
            return
        end
        -- Only I/O can wake a task now: the reactor waits for it.
        if reactor.pending() > 0 then
            reactor.wait(nil)
            return
        end
        error("nupp: nothing can wake this wait: every task is parked", 0)
    end
    local now = calls.now() as number
    local at = timers[1].at as number
    if at > now then
        wait((polling or owner ~= nil) and math.min(at - now, SOURCE_SLICE_MS) or at - now, owner)
        now = calls.now() as number
    end
    while #timers > 0 and timers[1].at <= now do
        local entry = poptimer()
        if not stale(entry) then
            fire(entry)
        end
    end
end

----------------------------------------------------------------------------
-- Parking
----------------------------------------------------------------------------

local function current(): any
    local thread = calls.current()
    if thread == nil then
        return nil
    end

    return calls.data(thread)
end

-- The scopes each root or task opened, innermost last.
local rootscopes: {any} = {}
local coroutinescopes = coroutines.localMap("core task scopes")
local running = coroutine.running

local function openedScopes(record: any): {any}
    if record ~= nil then
        return record.opened
    end
    local thread, main = running()
    if thread == nil or main then
        return rootscopes
    end
    local opened = coroutinescopes[thread]
    if opened == nil then
        opened = {}
        coroutinescopes[thread] = opened
    end

    return opened
end

local function bodyScope(record: any): any
    local opened = openedScopes(record)
    for index = #opened, 1, -1 do
        if opened[index].bodyActive then
            return opened[index]
        end
    end

    return nil
end

local function scopeProblem(scope: any): (boolean, any)
    if scope.failed and (scope.failedFirst or scope.deliberate) then
        return true, scope.failure
    end
    if scope.cancellation ~= nil and not scope.deliberate then
        return true, scope.cancellation
    end

    return false, nil
end

local function checkScope(scope: any): nil
    if scope ~= nil then
        local failed, problem = scopeProblem(scope)
        if failed then
            error(problem, 0)
        end
    end
end

-- Waits until `arm`'s waiter is woken, answering what it was woken with.
-- A task parks; the main thread's stack runs the scheduler meanwhile. A
-- cancelled task's park raises its cancellation, unless `shielded`, whose
-- caller must go on waiting regardless (a scope settling its children).
local function park(arm: function(any): nil, shielded: boolean): any
    local record = current()
    local scope = not shielded and bodyScope(record) or nil
    checkScope(scope)
    if record ~= nil then
        if record.requested and not shielded then
            error(record.cancelled, 0)
        end
        local waiter = {record = record, ticket = record.ticket}
        arm(waiter)
        if scope ~= nil then
            scope.bodyWaiter = waiter
        end
        record.status = "parked"
        local value = calls.park()
        record.status = "running"
        if scope ~= nil then
            scope.bodyWaiter = nil
            checkScope(scope)
        end
        if record.requested and not shielded then
            error(record.cancelled, 0)
        end
        return value
    end
    local box = {done = false, value = nil}
    arm(box)
    if scope ~= nil then
        scope.bodyWaiter = box
    end
    while not box.done do
        step()
    end
    if scope ~= nil then
        scope.bodyWaiter = nil
        checkScope(scope)
    end

    return box.value
end

local function checkDuration(value: number, label: string): nil
    if value ~= value or value < 0 or value == math.huge then
        error("nupp: " .. label .. " must be a finite non-negative number", 3)
    end
end

local function sleepuntil(deadline: number): nil
    checkDuration(deadline, "deadline")
    if deadline <= (calls.now() as number) then
        return
    end
    if current() == nil and suspension.handled() then
        nativeTimers.sleepuntil(deadline)
        return
    end
    park(
        function(waiter: any): nil
            addtimer({at = deadline, waiter = waiter})
        end,
        false
    )
end

local function sleep(milliseconds: number): nil
    checkDuration(milliseconds, "sleep duration")
    if milliseconds > 0 then
        sleepuntil((calls.now() as number) + milliseconds)
    end
end

----------------------------------------------------------------------------
-- nupp.suspension
----------------------------------------------------------------------------

-- What a suspended wait's park answers once its waker fires.
local WOKEN = reactor.Completion(value = 0)
local NO_SOURCE = reactor.Completion(value = -1)

-- A suspended wait parks its task through the reactor's park until the
-- wait's own waker fires. A cancellation that wakes the park abandons the
-- wait before it is raised. Either way the task stops counting as suspended.
local function suspendpark(_: suspensionHost.Handler, waiting: suspensionHost.Waiting, cancel: function(): nil): nil
    while not waiting:ready() do
        local answer = reactor.suspend(function(resume: reactor.Waker): function(): nil
            local entry: any = {waiting = waiting, index = #suspended + 1}
            suspended[entry.index] = entry

            local function settle(): boolean
                local index = entry.index
                if index == 0 then
                    return false
                end
                local last = #suspended
                local moved = suspended[last]
                suspended[index] = moved
                moved.index = index
                suspended[last] = nil
                entry.index = 0

                return true
            end

            waiting:onresume(function(): nil
                if settle() then
                    resume(WOKEN)
                end
            end)
            entry.refuse = function(): nil
                if settle() then
                    resume(NO_SOURCE)
                end
            end

            return function(): nil
                settle()
                cancel()
            end
        end)
        if answer.value == NO_SOURCE.value then
            error(("nupp: %s cannot complete: no readiness source is registered"):format(waiting.operation), 0)
        end
    end
end

local driver = suspensionHost.Handler(
    park = suspendpark,
    canpark = function(_: suspensionHost.Handler): boolean
        return true
    end,
    shutdown = function(_: suspensionHost.Handler): nil
    end
)

local function packed(...: any): any
    return {n = select("#", ...), ...}
end

-- A task's body, entered under the driver and leaving it however it ends.
local function entered(body: any): any
    return function(...: any): ...any
        local handling = suspensionHost.installDriver(driver)
        local results = packed(pcall(body, ...))
        handling:close()
        if not results[1] then
            error(results[2], 0)
        end

        return table.unpack(results, 2, results.n)
    end
end

----------------------------------------------------------------------------
-- Tasks and scopes
----------------------------------------------------------------------------

local function final(status: string): boolean
    return status == "done" or status == "failed" or status == "cancelled"
end

local cancelscope: function(any, any, boolean): nil

local function unlink(scope: any, record: any): nil
    local children = scope.children
    local index = record.index as integer
    local last = #children
    local moved = children[last]
    children[index] = moved
    moved.index = index
    children[last] = nil
end

local function wakeall(waiters: {any}): nil
    for index = 1, #waiters do
        wake(waiters[index], true)
    end
end

-- The first failure a child has is the scope's, and cancels its siblings.
local function ownfailure(scope: any, problem: any): nil
    if not scope.failed then
        scope.failed = true
        scope.failure = problem
        scope.failedFirst = scope.cancellation == nil
        cancelscope(scope, "the scope is unwinding", false)
    else
        scope.failureCount = scope.failureCount + 1
        scope.suppressed[scope.failureCount] = problem
    end
end

local function settle(record: any, status: string, value: any): nil
    record.status = status
    if status == "done" then
        record.results = value
    else
        record.problem = value
    end
    local scope = record.scope
    scope.live = scope.live - 1
    if record.lending then
        record.lending = false
        scope.lent = scope.lent - 1
    end
    unlink(scope, record)
    if scope.onSettle ~= nil then
        scope.onSettle(record)
    elseif status == "failed" and not scope.soft then
        ownfailure(scope, value)
    end
    local waiters = record.waiters
    record.waiters = {}
    wakeall(waiters)
    local slots = scope.slots
    scope.slots = {}
    wakeall(slots)
    if scope.live == 0 then
        local closers = scope.closers
        scope.closers = {}
        wakeall(closers)
    end
end

-- A consuming callable releases only captures that it has yet to consume.
local function releaseFamily(branches: {function(): any}): (boolean, any)
    local released, releaseProblem = true, nil
    for _, body in ipairs(branches) do
        local ok, problem = pcall(taskownership.release, body)
        if not ok and released then
            released, releaseProblem = false, problem
        end
    end

    return released, releaseProblem
end

runone = function(record: any): nil
    record.queued = false
    local value = record.wake
    record.wake = nil
    if final(record.status) then
        return
    end
    -- One cancelled before it started never runs.
    if record.requested and not record.started then
        settle(record, "cancelled", record.cancelled)
        return
    end
    record.started = true
    record.status = "running"
    local answer = calls.run(record.thread, value)
    local code = answer[1]
    if code == RETURNED then
        settle(record, "done", answer)
    elseif code == FAILED then
        local problem = answer[2]
        if iscancelled(problem) and record.requested then
            settle(record, "cancelled", problem)
        else
            settle(record, "failed", problem)
        end
    elseif code == YIELDED then
        -- It gave up its turn: last in line.
        record.status = "queued"
        enqueue(record, nil)
    end
end

-- Requests a task's cancellation: a parked one is woken to raise it, a
-- running one sees it at its next park or checkpoint, one never started is
-- settled now. The scopes it opened are cancelled with it.
local function cancelrecord(record: any, cancelled: any): boolean
    if final(record.status) or record.requested then
        return false
    end
    record.requested = true
    record.cancelled = cancelled
    local opened = record.opened
    for index = 1, #opened do
        local scope = opened[index]
        if not scope.closed then
            cancelscope(scope, cancelled.reason, false)
        end
    end
    if not record.started then
        settle(record, "cancelled", cancelled)
        return true
    end
    if record.status == "parked" then
        record.ticket = record.ticket + 1
        enqueue(record, CANCEL)
    end

    return true
end

cancelscope = function(scope: any, reason: any, deliberate: boolean): nil
    if scope.cancellation == nil then
        scope.cancellation = cancellation("the task scope", reason)
        scope.deliberate = deliberate
    end
    -- A child settled by the walk leaves the list: walk a copy.
    local children: {any} = {}
    for index = 1, #scope.children do
        children[index] = scope.children[index]
    end
    for index = 1, #children do
        cancelrecord(children[index], scope.cancellation)
    end
    if scope.bodyWaiter ~= nil then
        wake(scope.bodyWaiter, nil)
    end
end

deadlinepassed = function(scope: any): nil
    if not scope.closed then
        cancelscope(scope, "its deadline passed", false)
    end
end

local ScopeMethods: any = {}
local ScopeMT: any = {__index = ScopeMethods}

local function open(limit: integer?, timeoutms: number?): any
    if limit ~= nil and (limit < 1 or limit == math.huge or limit ~= math.floor(limit)) then
        error("nupp: a task scope limit must be a positive integer", 2)
    end
    if timeoutms ~= nil and (timeoutms ~= timeoutms or timeoutms < 0 or timeoutms == math.huge) then
        error("nupp: a task scope timeout must be a finite non-negative number", 2)
    end
    local owner = current()
    local deadline: number? = nil
    if timeoutms ~= nil then
        deadline = (calls.now() as number) + timeoutms
    end
    -- A scope inside another takes the earlier deadline.
    local opened = openedScopes(owner)
    local outer = opened[#opened] or (owner ~= nil and owner.scope or nil)
    if outer ~= nil and outer.deadline ~= nil and (deadline == nil or outer.deadline < deadline) then
        deadline = outer.deadline
    end
    local scope = setmetatable(
        {
            children = {},
            live = 0,
            lent = 0,
            closers = {},
            slots = {},
            limit = limit,
            deadline = deadline,
            owner = owner,
            closed = false,
            failed = false,
            suppressed = {},
            failureCount = 0,
            deliberate = false
        },
        ScopeMT
    )
    opened[#opened + 1] = scope
    if owner ~= nil and owner.requested then
        cancelscope(scope, owner.cancelled.reason, false)
    end
    if deadline ~= nil then
        addtimer({at = deadline, scope = scope})
    end

    return scope
end

local function full(scope: any): boolean
    return scope.limit ~= nil and scope.live - scope.lent >= scope.limit
end

local function parkForSlot(scope: any): nil
    park(
        function(waiter: any): nil
            scope.slots[#scope.slots + 1] = waiter
        end,
        false
    )
end

local function prepareChild(scope: any, body: any, arguments: any): (thread, any)
    if scope.closed then
        error("nupp: the task scope is closed", 3)
    end
    checkScope(scope)
    local lender: any = nil
    while full(scope) do
        local record = current()
        if record ~= nil and record.scope == scope and not record.lending then
            lender = record
            break
        end
        parkForSlot(scope)
        checkScope(scope)
    end

    return calls.new(entered(body), arguments), lender
end

local function start(scope: any, name: any, body: any, arguments: any, releaseOnRefusal: boolean?): any
    local prepared, thread, lender = pcall(prepareChild, scope, body, arguments)
    if not prepared then
        if releaseOnRefusal then
            local released, problem = pcall(taskownership.release, body)
            if not released then
                error(withFailures(thread, {problem}, 1), 0)
            end
        end
        error(thread, 0)
    end
    local record = {
        thread = thread,
        scope = scope,
        name = name,
        status = "queued",
        ticket = 0,
        waiters = {},
        opened = {},
        requested = false,
        started = false,
        queued = false,
        index = #scope.children + 1
    }
    calls.setdata(thread, record)
    scope.children[record.index] = record
    scope.live = scope.live + 1
    if lender ~= nil then
        lender.lending = true
        scope.lent = scope.lent + 1
    end
    if scope.cancellation ~= nil then
        cancelrecord(record, scope.cancellation)
    else
        enqueue(record, nil)
    end
    if lender ~= nil then
        local reclaimed, problem = pcall(function(): nil
            while full(scope) do
                parkForSlot(scope)
            end
        end)
        lender.lending = false
        scope.lent = scope.lent - 1
        if not reclaimed then
            error(problem, 0)
        end
    end

    return thread
end

-- Passing the body first matches the method's declared signature.
ScopeMethods.spawn = function(scope: any, body: any, ...: any): any
    local arguments: any = {...}
    arguments[0] = select("#", ...)

    return start(scope, "task", body, arguments, true)
end

ScopeMethods._spawnNamed = function(scope: any, body: any, name: string): any
    return start(scope, name, body, {[0] = 0}, true)
end

ScopeMethods.work = function(scope: any, ...: any): any
    error("nupp: worker lanes are not available on the core yet", 2)
end

ScopeMethods.cancel = function(scope: any, reason: any): nil
    cancelscope(scope, reason, true)
end

-- Settles the scope: every child has run, been cancelled or unwound when it
-- returns, then the first failure a child had is raised, or the
-- cancellation a deadline caused.
ScopeMethods.close = function(scope: any): nil
    if scope.closed then
        return
    end
    local record = current()
    while scope.live > 0 do
        -- A cancelled owner still waits for its children, which it cancels.
        if record ~= nil and record.requested and scope.cancellation == nil then
            cancelscope(scope, record.cancelled.reason, false)
        end
        park(
            function(waiter: any): nil
                scope.closers[#scope.closers + 1] = waiter
            end,
            true
        )
    end
    scope.closed = true
    local opened = openedScopes(record)
    for index = #opened, 1, -1 do
        if opened[index] == scope then
            table.remove(opened, index)
            break
        end
    end
    local failed, problem = scopeProblem(scope)
    if failed then
        if scope.failed and not scope.failedFirst and not scope.deliberate then
            for index = scope.failureCount, 1, -1 do
                scope.suppressed[index + 1] = scope.suppressed[index]
            end
            scope.suppressed[1] = scope.failure
            scope.failureCount = scope.failureCount + 1
        end
        error(withFailures(problem, scope.suppressed, scope.failureCount), 0)
    end
    if record ~= nil and record.requested then
        error(record.cancelled, 0)
    end
end

-- Runs the callback synchronously and drains the scope even if it raises.
local function run(...: any): ...any
    local limit: integer? = nil
    local timeoutms: number? = nil
    local body: any
    if select("#", ...) == 1 then
        body = ...
    else
        limit, timeoutms, body = ...
    end
    local scope = open(limit, timeoutms)
    scope.bodyActive = true
    local answer = packed(pcall(body, scope))
    scope.bodyActive = false
    scope.bodyWaiter = nil
    if answer[1] then
        ScopeMethods.close(scope)
        return table.unpack(answer, 2, answer.n)
    end

    local problem = answer[2]
    local failed, owned = scopeProblem(scope)
    if failed and owned == problem then
        ScopeMethods.close(scope)
        error(problem, 0)
    end
    cancelscope(scope, "the body failed", true)
    local settled, settleProblem = pcall(ScopeMethods.close, scope)
    if settled or settleProblem == problem then
        error(problem, 0)
    end
    if scope.failed and scope.deliberate then
        local count = scope.failureCount as integer
        local suppressed: {any} = {scope.failure}
        for index = 1, count do
            suppressed[index + 1] = scope.suppressed[index]
        end
        error(withFailures(problem, suppressed, count + 1), 0)
    end

    error(withFailures(problem, {settleProblem}, 1), 0)
end

-- A racing scope records the first settlement and drains through the same
-- shielded close as an ordinary scope.
export function race(takes bodies: {function(): any}): (any, integer?)
    local branches: {function(): any} = @unsafe own.release(bodies)
    if #branches == 0 then
        return nil, nil
    end

    local scope = open(nil, nil)
    local winner: any = nil
    scope.onSettle = function(record: any): nil
        if scope.cancellation == nil and record.status ~= "cancelled" then
            winner = record
            cancelscope(scope, "another branch settled first", true)
        end
    end
    local entered, entryProblem = pcall(function(): nil
        for index, body in ipairs(branches) do
            local thread = start(scope, "a racing branch", body, {[0] = 0})
            local record = calls.data(thread)
            record.raceIndex = index
        end
    end)
    if not entered then
        cancelscope(scope, "the racing family could not start", true)
    end
    local drained, drainProblem = pcall(ScopeMethods.close, scope)
    if not scope.closed then
        error(drainProblem, 0)
    end
    scope.onSettle = nil
    local released, releaseProblem = releaseFamily(branches)
    if not drained then
        error(drainProblem, 0)
    elseif not entered then
        error(entryProblem, 0)
    elseif winner ~= nil and winner.status == "failed" then
        error(winner.problem, 0)
    elseif not released then
        error(releaseProblem, 0)
    end
    if winner == nil then
        return nil, nil
    end

    local index = winner.raceIndex as integer
    local results = winner.results
    local count = (results[0] as integer) - 1
    if count > 1 then
        error(("nupp: branch %d returned %d values, and a family branch answers one"):format(index, count), 0)
    end

    return results[2], index
end

-- Branch failures belong to their result positions and leave siblings running.
export function gather<T>(takes bodies: {function(): T}): ({T?}, {any})
    local branches: {function(): T} = @unsafe own.release(bodies)
    local values: {T?} = {}
    local errors: {any} = {}
    if #branches == 0 then
        return values, errors
    end
    local scope = open(nil, nil)
    scope.soft = true
    local records: {any} = {}
    local entered, entryProblem = pcall(function(): nil
        for index, body in ipairs(branches) do
            local thread = start(scope, "branch " .. tostring(index), body, {[0] = 0})
            records[index] = calls.data(thread)
        end
    end)
    if not entered then
        cancelscope(scope, "the task family could not start", true)
    end
    local drained, drainProblem = pcall(ScopeMethods.close, scope)
    if not scope.closed then
        error(drainProblem, 0)
    end
    local released, releaseProblem = releaseFamily(branches)
    if not drained then
        error(drainProblem, 0)
    elseif not entered then
        error(entryProblem, 0)
    elseif not released then
        error(releaseProblem, 0)
    end
    for index, record in ipairs(records) do
        if record.status == "failed" then
            errors[index] = record.problem
        elseif record.status == "done" then
            local results = record.results
            local count = (results[0] as integer) - 1
            if count > 1 then
                errors[
                    index
                ] = ("nupp: branch %d returned %d values, and a family branch answers one"):format(index, count)
            else
                values[index] = results[2]
            end
        end
    end

    return values, errors
end

----------------------------------------------------------------------------
-- Threads' methods
----------------------------------------------------------------------------

local function taskof(thread: any): any
    local record = calls.data(thread)
    if record == nil then
        error("nupp: not a task", 3)
    end

    return record
end

-- Waits for a task and answers its results, or raises its failure.
local function await(thread: any): ...any
    local record = taskof(thread)
    while not final(record.status) do
        park(
            function(waiter: any): nil
                record.waiters[#record.waiters + 1] = waiter
            end,
            false
        )
    end
    if record.status ~= "done" then
        error(record.problem, 0)
    end
    local results = record.results

    return table.unpack(results, 2, results[0] as integer)
end

-- coroutine.close of a task: its cancellation requested, its cleanups waited
-- for; Lua's results, true or false and the error that ended it.
local function closetask(thread: any): any
    local record = taskof(thread)
    if not final(record.status) then
        if current() == record then
            error("nupp: a task cannot close itself", 2)
        end
        cancelrecord(record, cancellation(record.name, "it was closed"))
        while not final(record.status) do
            park(
                function(waiter: any): nil
                    record.waiters[#record.waiters + 1] = waiter
                end,
                false
            )
        end
    end
    if record.status == "failed" then
        return {[0] = 2, false, record.problem}
    end

    return {[0] = 1, true}
end

local methods: any = {
    status = function(thread: any): string
        return coroutine.status(thread)
    end,
    resume = function(thread: any, ...: any): ...any
        return coroutine.resume(thread, ...)
    end,
    close = function(thread: any): (boolean, any)
        return coroutine.close(thread)
    end,
    await = await,
    isdone = function(thread: any): boolean
        return final(taskof(thread).status)
    end,
    cancel = function(thread: any, reason: any): boolean
        local record = taskof(thread)
        return cancelrecord(record, cancellation(record.name, reason))
    end
}

----------------------------------------------------------------------------
-- The task surface
----------------------------------------------------------------------------

local function checkpoint(): nil
    local record = current()
    if record == nil then
        -- The main thread's stack lets what is runnable now run once.
        if nativeTimers.hasPending() then
            suspension.poll()
        end
        local count = tail - head + 1
        local poll = ownerWait
        if count == 0 and poll ~= nil and ownerWork() then
            ownerTurn(poll, calls.now() as number)
        end
        for _ = 1, count do
            if head <= tail then
                step()
            end
        end
        return
    end
    if record.requested then
        error(record.cancelled, 0)
    end
    park(
        function(waiter: any): nil
            wake(waiter, true)
        end,
        false
    )
end

local function deadline(): number?
    local record = current()
    local opened = openedScopes(record)
    local scope = opened[#opened] or (record ~= nil and record.scope or nil)

    return scope ~= nil and scope.deadline or nil
end

calls.install({__index = methods}, closetask)

-- The reactor's side of a task's wait (`reactor.Parker`): its waker, made
-- before the operation is submitted, wakes the park that follows it, or
-- keeps a completion that came first for that park to answer at once.
local arming: any = nil

local function iowaker(): reactor.Waker?
    if current() == nil then
        return nil
    end
    local box: any = {waiter = nil, done = false, value = nil}
    arming = box

    return function(completion: any): nil
        if box.waiter ~= nil then
            wake(box.waiter, completion)
        else
            box.done = true
            box.value = completion
        end
    end
end

local function iopark(): reactor.Completion
    local box = arming
    arming = nil
    if box.done then
        return box.value
    end

    return park(
        function(waiter: any): nil
            box.waiter = waiter
        end,
        false
    )
end

-- Core call modules supply direct calls, so pass ordinary functions here.
local function waitOwnerCall(poller: integer, nanos: integer): integer
    return pollcalls.waitOwner(poller, nanos)
end

local function ownerActiveCall(): boolean
    return pollcalls.ownerActive()
end

reactor.install(reactor.Parker(waker = iowaker, park = iopark))
installOwnerWait(waitOwnerCall, ownerActiveCall)

export const functions: {
    [string]: any
} = {
    ["coroutine.scope"] = open,
    ["coroutine.checkpoint"] = checkpoint,
    ["coroutine.deadline"] = deadline,
    ["coroutine.gather"] = gather,
    ["coroutine.iscancelled"] = iscancelled,
    ["coroutine.run"] = run,
    ["coroutine.sleep"] = sleep,
    ["coroutine.sleepuntil"] = sleepuntil,
    ["coroutine.wakeat"] = nativeTimers.wakeat
}
