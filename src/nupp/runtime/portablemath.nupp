@!internal
module nupp.runtime.portablemath

-- Read the host function without projecting the portable prelude identity that
-- this module implements. The adapter is shared through the module cache, so
-- taking math.log as a value keeps one identity across generated modules.
local nativeLog: nosuspend function(number): number = (rawget(_G, "math") as any).log

export function log(value: number, base: number?): number
    if base == nil then
        return nativeLog(value)
    end
    return nativeLog(value) / nativeLog(base)
end

-- A resolved prelude alias can be reassigned or its table can be modified.
-- Normalize the value actually read, leaving user-supplied functions alone.
export function logFunction(value: any): any
    if value == nativeLog then
        return log
    end
    return value
end
