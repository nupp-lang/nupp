module nupp.runtime.seam.host
local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.host", suiteModuleName = "nupp.runtime.seam.hostsuite",}
local CONTRACT: common.Contract = {
    name = "host",
    version = 1,
    binding = "runtime",
    globalName = "__nuppHost",
    requiredFunctions = {"clock", "entropy"},
    requiredValues = {"files", "http", "process", "workers"},
    suiteModule = seam.suiteModuleName,
    modules = {
        ["nupp.io.files"] = "files",
        ["nupp.io.http"] = "http",
        ["nupp.io.process"] = "process",
        ["nupp.workers"] = "workers",
    },
}
function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("host:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
