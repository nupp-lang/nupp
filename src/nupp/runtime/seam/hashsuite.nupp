@!internal
module nupp.runtime.seam.hashsuite

local suite = {}

function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        assert(provider.fnv1a64("hello") == "a430d84680aabd0b", "fnv1a64 must return canonical hexadecimal")
        assert(provider.crc32("123456789") == 3421780262, "crc32 must implement the standard check vector")
        assert(provider.crc32("123456789", 0) == 3421780262, "crc32 must accept a previous checksum")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
