module nupp.runtime.seam.net

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.net", suiteModuleName = "nupp.runtime.seam.netsuite",}
local CONTRACT = common.contract("host.net", {
    globalName = "__nuppNet",
    requiredFunctions = {"asReader", "asWriter", "bind", "connect", "listen", "useBackend"},
    requiredValues = {"Backend", "Datagram", "DirectionView", "Listener", "Message", "Stream"},
    suiteModule = seam.suiteModuleName,
    modules = {["nupp.io.net"] = "",},
})

function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("host-net:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
