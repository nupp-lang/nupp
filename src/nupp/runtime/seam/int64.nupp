module nupp.runtime.seam.int64

--[[Exact third-party wide-integer contract; Nupp owns no duplicate algorithm.]]

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.int64", suiteModuleName = "nupp.runtime.seam.int64suite",}
local CONTRACT: common.Contract = {
    name = "numeric.int64",
    version = 1,
    binding = "compile",
    globalName = "__nuppInt64",
    requiredFunctions = {
        "add",
        "arshift",
        "band",
        "bnot",
        "bor",
        "bxor",
        "compare",
        "div",
        "int64",
        "lshift",
        "mod",
        "mul",
        "neg",
        "pow",
        "rshift",
        "sub",
        "toNumber",
        "toString",
        "uint64"
    },
    requiredValues = {},
    suiteModule = seam.suiteModuleName,
}
function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("int64:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
