module nupp.runtime.seam.json

--[[
Runtime binding and conformance for the `data.json` provider seam.

This is ordinary checked source rather than generated fallback code. The
compiler emits only the composition of this seam into a backend and its
installation. Adapter authors and package CI can run the seam's `test` method
explicitly; loading or building a program never executes that behavioral suite.
]]

local runtimeBackend = require("nupp.runtime.backend")
local jsonSeam = {}

jsonSeam.moduleName = "nupp.runtime.seam.json"
jsonSeam.suiteModuleName = "nupp.runtime.seam.jsonsuite"

local REQUIRED_FUNCTIONS = {"arrayOf", "asArray", "asObject", "decode", "encode", "pull", "serialize", "writer",}

--- Answers why one loaded value cannot satisfy the shallow runtime contract.
function jsonSeam.validate(value: any): string?
    if type(value) ~= "table" then
        return "module returned " .. type(value) .. ", expected table"
    end
    for _, name in ipairs(REQUIRED_FUNCTIONS) do
        if type(value[name]) ~= "function" then
            return "member " .. name .. " is " .. type(value[name]) .. ", expected function"
        end
    end
    for _, name in ipairs({"EMPTY_ARRAY", "EMPTY_OBJECT"}) do
        if type(value[name]) ~= "table" then
            return "member " .. name .. " is " .. type(value[name]) .. ", expected table"
        end
    end
    if value.NULL == nil then
        return "member NULL is absent"
    end

    return nil
end

local function failure(moduleName: string, problem: string): any
    return setmetatable({}, {
        __index = function()
            error("nupp: runtime provider " .. moduleName .. " for data.json is incompatible: " .. problem, 0)
        end,
    })
end

--- Installs one lazy provider behind the existing `jsonNative` host boundary.
--- @raises when a conflicting provider is installed or JSON was already loaded
function jsonSeam.install(moduleName: string): nil
    local selected = rawget(_G, "__nuppRuntimeProviders")
    if selected == nil then
        selected = {}
        rawset(_G, "__nuppRuntimeProviders", selected)
    end
    local prior = selected.json
    if prior ~= nil and prior ~= moduleName then
        error("nupp: runtime provider conflict for data.json: " .. prior .. " and " .. moduleName, 0)
    elseif prior ~= nil then
        return
    end
    if package.loaded.jsonNative ~= nil then
        error("nupp: data.json provider " .. moduleName .. " was selected after jsonNative was already loaded", 0)
    end
    selected.json = moduleName
    package.preload.jsonNative = function()
        local ok, value = pcall(require, moduleName)
        if not ok then
            return failure(moduleName, "could not load module: " .. tostring(value))
        end
        local problem = jsonSeam.validate(value)
        if problem ~= nil then
            return failure(moduleName, problem)
        end

        return value
    end
end

--- Runs the compiler-owned behavioral contract against one adapter module.
---
--- This command-facing suite is evidence rather than a build-time proof. It is
--- deliberately explicit so checking and building never execute a dependency.
function jsonSeam.test(moduleName: string): (boolean, string?)
    local loaded, provider = pcall(require, moduleName)
    if not loaded then
        return false, "could not load module: " .. tostring(provider)
    end
    local structural = jsonSeam.validate(provider)
    if structural ~= nil then
        return false, structural
    end
    local jsonSuite = require("nupp.runtime.seam.jsonsuite")

    return jsonSuite.test(provider)
end

--- Supplies the versioned `data.json` seam for one adapter module.
function jsonSeam.seam(moduleName: string): runtimeBackend.Seam
    local identity = require("nupp.runtime.seam.registry").get("data.json")
    local seam: any = {name = identity.name, version = identity.version, binding = identity.binding,}
    function seam:install(): nil
        jsonSeam.install(moduleName)
    end

    function seam:test(): (boolean, string?)
        return jsonSeam.test(moduleName)
    end

    return seam as runtimeBackend.Seam
end

--- Supplies a complete backend containing this runtime JSON seam.
function jsonSeam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("json:" .. moduleName, {jsonSeam.seam(moduleName)})
end

export = jsonSeam
