@!internal

module nupp.runtime.seam.jsonsuite

--[[
Behavioral contract vectors for the `data.json` seam.

The runtime seam loads this checked module only when its explicit `test` method
runs. Keeping the suite separate makes the adapter and its evidence independently
checkable without putting test-vector construction on the install path.
]]

local jsonSuite = {}

--- Runs the behavioral contract against one structurally valid implementation.
function jsonSuite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        local encoded = provider.encode({answer = 42})
        assert(type(encoded) == "string", "encode must return a string")
        assert(provider.serialize({answer = 42}) == encoded, "serialize must alias encode")
        local decoded = provider.decode(encoded, provider.NULL)
        assert(type(decoded) == "table" and decoded.answer == 42, "encode/decode must round-trip an object")
        assert(provider.encode(provider.EMPTY_ARRAY) == "[]", "EMPTY_ARRAY must encode as []")
        assert(provider.encode(provider.EMPTY_OBJECT) == "{}", "EMPTY_OBJECT must encode as {}")
        assert(provider.encode(provider.asArray({})) == "[]", "asArray must preserve an empty array")
        assert(provider.encode(provider.asObject({})) == "{}", "asObject must preserve an empty object")
        assert(provider.encode(provider.NULL) == "null", "NULL must encode as null")
        assert(provider.decode("null", provider.NULL) == provider.NULL, "NULL must decode through its replacement")

        local pulled = provider.pull('{"answer":42,"ignored":1}', {answer = true}, provider.NULL)
        assert(type(pulled) == "table" and pulled.answer == 42, "pull must retain selected object members")
        assert(pulled.ignored == nil, "pull must discard unselected object members")

        local writer = provider.writer(provider.NULL)
        local document = writer:startArray():write(1):null():close():finish()
        local values = provider.decode(document, provider.NULL)
        assert(type(values) == "table" and values[1] == 1, "writer must emit its first array member")
        assert(values[2] == provider.NULL, "writer null must use the configured replacement")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = jsonSuite
