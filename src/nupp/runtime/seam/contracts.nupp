@!internal

module nupp.runtime.seam.contracts

--[[
The declared shape of each substitutable runtime contract, and the member names
derived from it.

A seam used to carry its required members twice: once as the interface a
consumer was written against, and once as a list of strings `validate` walked at
install time. The two drifted silently, because nothing compared them -- a
provider satisfying the string list installed cleanly while answering a
different signature than the declaration promised.

The interface here is the single statement. `members` reads it with
`nupp.reflect` at compile time and hands `nupp.runtime.seam.registry` the same
names each seam used to spell out, so a member added to a contract reaches the
runtime check in `nupp.runtime.seam.module` without being written down again. A provider states conformance by projecting itself
onto the interface, which is where a mismatched signature is now reported.
]]

local contracts = {}

--- Splits one reflected contract into the members `validate` looks for.
---
--- Functions and values are checked differently at install: a function must be
--- callable, where a value only has to be there. A value whose declared type
--- names a Lua type is checked for that too, so a contract promising a table
--- says so once rather than in each seam that wanted the stricter test.
---
--- An optional member is required of nobody. It reads as a union with a `nil`
--- arm, which is also what tells a caller to reach it through a nil test.
local comptime function memberNames(info: nupp.reflect.Info): any
    local functions, values, valueTypes = {}, {}, {}
    for _, field in ipairs(info.fields) do
        const declared = field.type
        if declared ~= nil then
            const node = info.types[declared]
            local optional = false
            const arms = node.members
            if node.kind == "union" and arms ~= nil then
                for _, arm in ipairs(arms) do
                    if info.types[arm].kind == "nil" then
                        optional = true
                    end
                end
            end
            -- An optional member is named in neither list, because it is
            -- required of nobody.
            if not optional then
                if node.kind == "func" then
                    functions[#functions + 1] = field.name
                else
                    values[#values + 1] = field.name
                    if node.kind == "table" or node.kind == "string" or node.kind == "boolean" then
                        valueTypes[field.name] = node.kind
                    end
                end
            end
        end
    end

    return {functions = functions, values = values, valueTypes = valueTypes,}
end

--- What a provider does to a table it is asked to mark: takes it, marks it, and
--- hands back the same one, so the caller's type survives the round trip.
export type MarkContainer = function<T is table>(takes value: T): T preserves value

--- `data.json`, the codec `nupp.data.json` is written against.
---
--- The marking members own what they mark. `nupp.data.json.asArray` hands its
--- caller's table straight to the provider and promises to hand the same one
--- back, so a provider answering `(value: any): any` breaks that promise one
--- call further in -- which is what the checker says when this is written the
--- weaker way.
---
--- The serde members are absent from a provider that has no schema-specialized
--- decoder, which is why they are optional here and why every caller reaches
--- them through a nil test.
export interface JsonProvider
    arrayOf: function(shape: any?): any
    asArray: MarkContainer
    asObject: MarkContainer
    isArray: function(value: any): boolean
    decode: function(text: string, nullValue: any?): any
    encode: function(value: any, nullValue: any?): string
    serialize: function(value: any, nullValue: any?): string
    encoded: function(value: any, nullValue: any?): any
    encodedString: function(value: string): any
    pull: function(text: string, shape: any, nullValue: any?): any
    verified: function(text: string): any
    verifiedString: function(text: string): any
    writer: function(exclusive out: string.buffer.Buffer, nullValue: any?): any
    NULL: any
    EMPTY_ARRAY: table
    EMPTY_OBJECT: table
    compileSerde: (function(plan: any, unknownMembers: string): any)?
    decodeSerde: (function(schema: any, text: string): (any?, string?))?
    decodeSerdeBuffer: (function(schema: any, exclusive input: string.buffer.Buffer): (any?, string?))?
end

--- `data.uuid`, the identifiers `nupp.data.uuid4` and `uuid7` are projected from.
export interface UuidProvider
    uuid4: function(): string
    uuid7: function(): string
end

--- `crypto.hmac_sha256`, the accelerator `nupp.data.hash` prefers where a
--- backend installs one.
export interface HmacSha256Provider
    digest: function(key: string, message: string): string
    hex: function(key: string, message: string): string
end

--- `host.time`, which answers `nupp.time`.
export interface TimeProvider
    now: function(): number
    wallTime: function(): number
    sleep: function(milliseconds: number): nil
    sleepUntil: function(deadline: number): nil
end

--- `host.path`, the environment `nupp.io.path` resolves against.
---
--- Each answer is a value-or-reason pair, because a host that cannot say what
--- its current directory is has a reason rather than a path.
export interface PathProvider
    separator: function(): string
    currentDirectory: function(): (string?, string?)
    canonicalize: function(path: string): (string?, string?)
end

--- `host.browser_storage`, the key-value store behind `nupp.browser.storage`.
export interface BrowserStorageProvider
    get: function(name: string): string?
    set: function(name: string, value: string): nil
    remove: function(name: string): nil
    clear: function(): nil
end

--- `data.sha256`, the digest projected onto `nupp.data.sha256`.
export interface Sha256Provider
    sha256: function(message: string): string
end

--- `host.browser_crypto`, the one host object behind three seams.
---
--- A browser answers SHA-256, HMAC-SHA256 and identifiers from the same
--- WebCrypto surface, so the provider named for `host.browser_crypto` is also
--- what `data.sha256`, `crypto.hmac_sha256` and `data.uuid` select.
export interface BrowserCryptoProvider
    digest: function(key: string, message: string): string
    hex: function(key: string, message: string): string
    randomBytes: function(count: integer): string
    sha256: function(message: string): string
    uuid4: function(): string
    uuid7: function(): string
end

--- `numeric.bitops`, the BitOp surface compile-bound lowering emits against.
---
--- The folding operations are variadic because BitOp's are: `band(a, b, c)` is
--- one call there, and a provider that took exactly two would fail the third
--- argument rather than the declaration.
export interface BitopsProvider
    band: function(first: number, ...: number): number
    bor: function(first: number, ...: number): number
    bxor: function(first: number, ...: number): number
    bnot: function(value: number): number
    lshift: function(value: number, count: number): number
    rshift: function(value: number, count: number): number
    arshift: function(value: number, count: number): number
end

--- `numeric.int64`, the wide integers a dialect without cdata cannot represent.
---
--- A wide value is the provider's own representation and stays `any` here: it
--- is a boxed table portably and a cdata natively, and the contract is what
--- both answer rather than what either one is.
export interface Int64Provider
    int64: function(value: any): any
    uint64: function(value: any): any
    add: function(left: any, right: any): any
    sub: function(left: any, right: any): any
    mul: function(left: any, right: any): any
    div: function(left: any, right: any): any
    mod: function(left: any, right: any): any
    pow: function(left: any, right: any): any
    neg: function(value: any): any
    band: function(left: any, right: any): any
    bor: function(left: any, right: any): any
    bxor: function(left: any, right: any): any
    bnot: function(value: any): any
    lshift: function(value: any, count: number): any
    rshift: function(value: any, count: number): any
    arshift: function(value: any, count: number): any
    compare: function(left: any, right: any): number
    toNumber: function(value: any): number
    toString: function(value: any): string
end

--- `numeric.simd`, the lane species compile-bound vector lowering reaches.
export interface SimdProvider
    preferredU8: function(): any
    tableU8x16: function(...: number): any
    maskBits64: function(low: number, high: number): any
    alignBytes: function(previous: any, current: any, offset: number): any
    paddedStringU8: function(source: string): any
    lanes: any
end

--- `representation.structvalue`, the table layout a dialect without cdata uses.
export interface StructvalueProvider
    scalar: function(kind: string): any
    array: function(element: any, count: integer): any
    define: function(layout: any, methods: table): any
    referenceValued: any
end

--- `host.wasm`, the opaque linear memory a Lua-in-Wasm host owns.
---
--- A pointer is the host's, not Nupp's, which is why every member takes and
--- returns `any`: the guarantee is the bounds check behind them, not a shape a
--- program could construct for itself.
export interface WasmProvider
    allocate: function(bytes: integer): any
    pointer: function(allocation: any, index: integer, stride: integer): any
    offset: function(pointer: any, count: integer): any
    load: function(pointer: any, byteOffset: integer, kind: string): any
    store: function(pointer: any, byteOffset: integer, kind: string, value: any): nil
    copy: function(destination: any, source: any, bytes: integer): nil
    descriptor: function(value: any): any
end

--- `text.buffer`, the appending half of LuaJIT's `string.buffer`.
---
--- Only `new`, because that is what the standard library reaches a buffer for.
--- A provider is free to answer the FIFO reads and the serializer beside it; a
--- portable one has no way to answer the pointer methods, and nothing asks.
export interface TextBufferProvider
    new: function(size: (integer | table)?, options: table?): any
end

--- `peg`, the matching engine and only the engine.
---
--- A provider stands in for the LPeg rock a native host would stage. It cannot
--- stand in for `stdlib.peg`, which binds the runtime module into locals of the
--- chunk a materialized matcher is generated against.
export interface PegProvider
    compile: function(pattern: string): any
    match: function(pattern: any, subject: string): any?
end

--- `io.uri`, which answers `nupp.io.uri`.
export interface UriProvider
    newURI: function(value: any): (any?, string?)
    validate: function(value: string): (boolean, string?)
    isURI: function(value: any): boolean
    URI: any
    Components: any
end

--- `host.http`, which answers `nupp.io.http`.
---
--- The record members are the provider's declarations rather than shapes
--- restated here, because a body or a response is the type a program names and
--- the seam only decides which module declares it.
export interface HttpProvider
    file: function(path: string, contentType: string?): any
    reader: function(source: any, length: integer?, contentType: string?): any
    Body: any
    Client: any
    FileBody: any
    Options: any
    ReaderBody: any
    Request: any
    Response: any
end

--- The members each contract requires, by the name the registry knows it as.
---
--- A contract absent here keeps the `members` list its registry entry spells
--- out. Three are: `compute.gpu`, `host.workers` and `suspension` each own a
--- surface whose real contract is affine -- a scope token, a context, an
--- installed handler -- and an interface restating it would either lie about
--- the ownership or be something no loaded module could be checked against.
--- The registry names what a loaded table can answer for, which is the half
--- this file's `validate` tests. Adding a contract here is declaring the
--- interface above and naming it in this table.
contracts.members = {
    ["data.json"] = comptime do
        return memberNames(nupp.reflect(JsonProvider))
    end,
    ["data.sha256"] = comptime do
        return memberNames(nupp.reflect(Sha256Provider))
    end,
    ["data.uuid"] = comptime do
        return memberNames(nupp.reflect(UuidProvider))
    end,
    ["crypto.hmac_sha256"] = comptime do
        return memberNames(nupp.reflect(HmacSha256Provider))
    end,
    ["numeric.bitops"] = comptime do
        return memberNames(nupp.reflect(BitopsProvider))
    end,
    ["numeric.int64"] = comptime do
        return memberNames(nupp.reflect(Int64Provider))
    end,
    ["numeric.simd"] = comptime do
        return memberNames(nupp.reflect(SimdProvider))
    end,
    ["representation.structvalue"] = comptime do
        return memberNames(nupp.reflect(StructvalueProvider))
    end,
    ["text.buffer"] = comptime do
        return memberNames(nupp.reflect(TextBufferProvider))
    end,
    ["host.wasm"] = comptime do
        return memberNames(nupp.reflect(WasmProvider))
    end,
    ["peg"] = comptime do
        return memberNames(nupp.reflect(PegProvider))
    end,
    ["host.time"] = comptime do
        return memberNames(nupp.reflect(TimeProvider))
    end,
    ["host.path"] = comptime do
        return memberNames(nupp.reflect(PathProvider))
    end,
    ["io.uri"] = comptime do
        return memberNames(nupp.reflect(UriProvider))
    end,
    ["host.http"] = comptime do
        return memberNames(nupp.reflect(HttpProvider))
    end,
    ["host.browser_crypto"] = comptime do
        return memberNames(nupp.reflect(BrowserCryptoProvider))
    end,
    ["host.browser_storage"] = comptime do
        return memberNames(nupp.reflect(BrowserStorageProvider))
    end,
}

export = contracts
