module nupp.runtime.seam.workers

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.workers", suiteModuleName = "nupp.runtime.seam.workerssuite",}
-- `Scope` is a record and reaches the running program as its declaration table.
-- The cleanup contract it carries, `ScopeToken`, is an affine interface: a promise
-- the checker holds a provider to, with nothing of it left at run time. So the
-- shallow runtime check names the one of the two a loaded module can answer for.
local CONTRACT = common.contract("host.workers", {
    globalName = "__nuppWorkers",
    requiredFunctions = {"scope"},
    requiredValues = {"Scope"},
    suiteModule = seam.suiteModuleName,
    modules = {["nupp.workers"] = "",},
})

function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("host-workers:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
