module nupp.runtime.seam.suspension

--[[Complete replacement seam for suspension protocol and scheduling policy.]]

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.suspension", suiteModuleName = "nupp.runtime.seam.suspensionsuite",}
local CONTRACT: common.Contract = {
    name = "suspension",
    version = 1,
    binding = "runtime",
    globalName = "__nuppSuspensionProvider",
    requiredFunctions = {
        "all",
        "batch",
        "canSuspend",
        "create",
        "destroyInstalled",
        "gather",
        "handled",
        "install",
        "poll",
        "race",
        "source",
        "suspend",
    },
    requiredValues = {"Context", "Handler", "Installed", "Source", "Waiting"},
    suiteModule = seam.suiteModuleName,
    modules = {["nupp.suspension"] = "",},
}

function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("suspension:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
