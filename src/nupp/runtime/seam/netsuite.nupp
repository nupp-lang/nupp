@!internal
module nupp.runtime.seam.netsuite

local suite = {}

function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        -- Binding an ephemeral port on the loopback and asking what was bound is
        -- the smallest exercise that proves a provider is really a network: it
        -- opens a socket, the platform chooses, and the answer comes back.
        local listener = assert(provider.listen({host = "127.0.0.1", port = 0}))
        local bound = listener:port()
        listener:close()
        assert(bound > 0, "a bound listener must report the port it got")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
