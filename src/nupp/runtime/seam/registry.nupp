@!internal
module nupp.runtime.seam.registry

--[[
Single source of seam identity, version, binding, effects and substitution.

One entry per substitutable contract, and the entry is the whole statement. A
seam used to be spread over three places -- identity here, the runtime member
list in a per-contract factory module, and the declared interface in
`nupp.runtime.backend.contracts` -- and the three drifted, because nothing
compared them.

The member list now comes from the declared interface wherever a contract has
one, read with `nupp.reflect` at compile time. A contract whose real surface is
affine names its checkable half in `members` below; see the note on
`members` for why those three cannot be interfaces.

`slug` is the one name a contract owns in the source tree: it names the
conformance suite, and it is what a diagnostic and a backend declaration use to
talk about the seam.
]]

local members = require("nupp.runtime.seam.contractmembers")
local registry = {}

local CONTRACTS: {any} = {
    -- The provider module is what a selection replaces, which install has always
    -- done by preloading it. An implementation rather than a module: the declared
    -- interface at that name is the contract every provider answers, and it is what
    -- `nupp.data.json` is written against, so only the build's idea of what to
    -- compile changes. Without it the default implementation was linked, and it
    -- reaches an AOT decoder no `lua51` target can carry.
    {
        name = "data.json",
        slug = "json",
        version = 2,
        effect = "native.json",
        binding = "runtime",
        globalName = "__nuppJson",
        implementationModules = {["nupp.data.json.provider"] = true}
    },
    {
        name = "numeric.bitops",
        slug = "bitops",
        effect = "runtime.bitops",
        binding = "compile",
        globalName = "__nuppBitops"
    },
    {
        name = "representation.structvalue",
        slug = "structvalue",
        effect = "runtime.structvalue",
        binding = "compile",
        globalName = "__nuppStructvalue"
    },
    {
        name = "representation.cstorage",
        slug = "cstorage",
        effect = "runtime.cstorage",
        binding = "compile",
        globalName = "__nuppCstorage",
        implementationModules = {["nupp.runtime.storage"] = true},
    },
    {name = "host.wasm", slug = "wasm", effect = "runtime.wasm", binding = "runtime", globalName = "__nuppWasm"},
    {name = "numeric.int64", slug = "int64", effect = "runtime.int64", binding = "compile", globalName = "__nuppInt64"},
    {name = "numeric.simd", slug = "simd", effect = "runtime.simd", binding = "compile", globalName = "__nuppSimd"},
    {
        name = "suspension",
        slug = "suspension",
        effect = "runtime.suspension",
        binding = "runtime",
        globalName = "__nuppSuspensionProvider",
        modules = {["nupp.suspension"] = ""},
        members = {
            functions = {
                "canSuspend",
                "create",
                "delegatedCanPark",
                "delegatedPark",
                "destroyInstalled",
                "handled",
                "install",
                "poll",
                "source",
                "suspend",
            },
            values = {"Context", "Handler", "Installed", "Source", "Waiting"},
        }
    },
    -- The provider answers `string.buffer` itself rather than being projected into
    -- some other name: a program that builds a string writes `require("string.buffer")`
    -- either way, and its signatures name `string.buffer.Buffer` either way. What the
    -- seam decides is which module that require finds.
    --
    -- An implementation, because the declaration the compiler carries is the contract
    -- and a provider answers it. Substituting the interface as well would give the
    -- same buffer two names, and a `Buffer` from one would not be a `Buffer` to the
    -- other -- which is what happened when this was written as `modules`.
    {
        name = "text.buffer",
        slug = "textbuffer",
        effect = "runtime.text_buffer",
        binding = "runtime",
        globalName = "__nuppTextBuffer",
        implementationModules = {["string.buffer"] = true}
    },
    {
        name = "data.sha256",
        slug = "sha256",
        effect = "native.sha256",
        binding = "runtime",
        globalName = "__nuppSha256",
        exports = {["nupp.data.sha256"] = "sha256",}
    },
    {
        name = "data.uuid",
        slug = "uuid",
        effect = "native.uuid",
        binding = "runtime",
        globalName = "__nuppUuid",
        exports = {["nupp.data.uuid4"] = "uuid4", ["nupp.data.uuid7"] = "uuid7",}
    },
    {
        name = "compute.gpu",
        slug = "gpu",
        effect = "native.gpu",
        binding = "runtime",
        globalName = "__nuppGpu",
        modules = {["nupp.gpu"] = ""},
        members = {
            functions = {"open", "workgroups", "destroyContext"},
            values = {"Layout", "Buffer", "Shared", "Phases", "Context",},
        }
    },
    {
        name = "peg",
        slug = "peg",
        -- The engine, and only the engine. A provider stands in for the LPeg
        -- rock a native host would stage; it cannot stand in for `stdlib.peg`
        -- or `stdlib.peg.compile`, which bind the runtime module into locals of
        -- the chunk a materialized matcher is generated against, and a module
        -- has no way to become a local of its caller's chunk. Claiming those
        -- meant selecting this seam deleted the prologue the generated program
        -- calls, so every materialized matcher failed on a nil upvalue.
        effect = "native.lpeg",
        binding = "runtime",
        globalName = "__nuppPeg"
    },
    {
        name = "host.path",
        slug = "path",
        effect = "native.path",
        binding = "runtime",
        globalName = "__nuppPathEnvironment",
        modules = {["nupp.io.path.provider"] = ""}
    },
    {
        name = "host.uri",
        slug = "uri",
        effect = "native.uri",
        binding = "runtime",
        globalName = "__nuppUri",
        modules = {["nupp.io.uri.provider"] = ""}
    },
    {
        name = "host.time",
        slug = "time",
        effect = "native.time",
        binding = "runtime",
        globalName = "__nuppTime",
        modules = {["nupp.time"] = ""}
    },
    {
        name = "host.http",
        slug = "http",
        effect = "native.http",
        binding = "runtime",
        globalName = "__nuppHttp",
        modules = {["nupp.io.http"] = ""}
    },
    {
        name = "host.crypto",
        slug = "crypto",
        effect = "runtime.crypto",
        binding = "runtime",
        globalName = "__nuppCrypto",
        modules = {["nupp.data.crypto"] = ""}
    },
    {
        name = "host.storage",
        slug = "storage",
        effect = "runtime.storage",
        binding = "runtime",
        globalName = "__nuppStorage",
        modules = {["nupp.io.storage"] = ""}
    },
    {
        name = "host.workers",
        slug = "workers",
        version = 2,
        effect = "native.workers",
        binding = "runtime",
        globalName = "__nuppWorkers",
        modules = {["nupp.workers"] = ""},
        -- `Scope` is a record and reaches the running program as its declaration
        -- table. The cleanup contract it carries, `ScopeToken`, is affine: a promise
        -- the checker holds a provider to, with nothing of it left at run time. So
        -- this names the one of the two a loaded module can answer for.
        --
        -- The three underscored functions are what `nupp.tasks` reaches a provider
        -- through without linking it: `__scope` opens a family for a task scope to
        -- own, `__settle` waits on one task without raising, and `__parallelism`
        -- sizes a bounded fan-out. A provider missing any of them fails selection
        -- here rather than at the first `fork`. Version 2 is the one that names them.
        members = {functions = {"scope", "__scope", "__settle", "__parallelism"}, values = {"Scope"},}
    },
    -- A faster HMAC-SHA256 than the one `nupp.data.hash` compiles to, where a
    -- backend has one -- WebCrypto in a browser, a host's own kernel natively.
    -- `nupp.data.hash` is what answers when neither is installed, which is why
    -- this seam is optional rather than required.
    {
        name = "crypto.hmac_sha256",
        slug = "hmacsha256",
        effect = "runtime.hmac_sha256",
        binding = "runtime",
        globalName = "__nuppHmacSha256"
    },
}

local byName, bySlug = {}, {}
for _, untyped in ipairs(CONTRACTS) do
    local contract: any = untyped
    contract.version = contract.version or 1
    contract.effects = contract.effects or {contract.effect}
    contract.suiteModule = "nupp.runtime.seam." .. contract.slug .. "suite"
    -- The declared interface wins wherever there is one, so a member added to a
    -- contract reaches the runtime check without being written down again.
    const declared = members[contract.name] or contract.members
    assert(declared ~= nil, "seam contract " .. contract.name .. " declares no members")
    contract.requiredFunctions = declared.functions
    contract.requiredValues = declared.values
    contract.valueTypes = declared.valueTypes or {}
    assert(byName[contract.name] == nil, "duplicate seam contract " .. contract.name)
    assert(bySlug[contract.slug] == nil, "duplicate seam slug " .. contract.slug)
    byName[contract.name] = contract
    bySlug[contract.slug] = contract
end

function registry.get(name: string): any
    return assert(byName[name], "unknown seam contract " .. name)
end

function registry.find(name: string): any?
    return byName[name]
end

function registry.forSlug(slug: string): any?
    return bySlug[slug]
end

function registry.all(): {any}
    return CONTRACTS
end

export = registry
