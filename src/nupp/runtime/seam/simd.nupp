module nupp.runtime.seam.simd

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.simd", suiteModuleName = "nupp.runtime.seam.simdsuite",}
local CONTRACT = common.contract("numeric.simd", {
    globalName = "__nuppSimd",
    requiredFunctions = {"alignBytes", "maskBits64", "paddedStringU8", "preferredU8", "tableU8x16"},
    requiredValues = {"lanes"},
    suiteModule = seam.suiteModuleName,
})
function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("simd:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
