@!internal
module nupp.runtime.seam.suspensionsuite

--[[Behavioral vectors shared by scheduler and event-loop adapters.]]

local suite = {}

function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        assert(not provider.handled(), "the isolated provider must begin without an installed handler")
        assert(provider.canSuspend(), "the unhandled blocking driver must permit suspension")

        local ready = provider.suspend("contract.ready", function(resume: function(string)): nil
            resume("ready")
        end)
        assert(ready == "ready", "a synchronous subscription must not park")

        local polled = 0
        local source = provider.source("contract.source", 1, function(): integer
            polled = polled + 1

            return 1
        end)
        assert(provider.poll() == 1 and polled == 1, "poll must drive registered readiness sources")
        source:release()
        assert(provider.poll() == 0 and polled == 1, "released sources must not run")

        local order = {}
        local first, skipped, added
        first = provider.source("contract.first", 10, function(): integer
            order[#order + 1] = "first"
            first:release()
            skipped:release()
            added = provider.source("contract.added", 5, function(): integer
                order[#order + 1] = "added"
                return 0
            end)

            return 0
        end)
        local middle = provider.source("contract.middle", 20, function(): integer
            order[#order + 1] = "middle"
            return 0
        end)
        skipped = provider.source("contract.skipped", 30, function(): integer
            order[#order + 1] = "skipped"
            return 0
        end)
        provider.poll()
        assert(
            table.concat(order, ",") == "first,middle",
            "a pass must exclude added sources and skip released sources"
        )
        order = {}
        provider.poll()
        assert(table.concat(order, ",") == "added,middle", "the next pass must restore stable priority order")
        added:release()
        middle:release()

        local values = provider.all({
            function(): integer
                return 1
            end,
            function(): integer
                return 2
            end,
        })
        assert(values[1] == 1 and values[2] == 2, "all must preserve branch order")
        local gathered, errors = provider.gather({
            function(): integer
                return 3
            end,
            function(): integer
                error("contract failure")
            end,
        })
        assert(gathered[1] == 3 and errors[1] == nil and errors[2] ~= nil, "gather must isolate branch failures")

        -- A branch may run part of its body on a coroutine it creates through the
        -- provider -- a protected call's forwarder, a generated cleanup wrapper --
        -- and a park from that coroutine must still wake the branch it belongs to.
        local nestedResume: any = nil
        local nested = provider.all({
            function(): any
                local child = provider.create(function(): any
                    return provider.suspend("contract.nested", function(resume: function(any)): function()
                        nestedResume = resume
                        return function(): nil
                            nestedResume = nil
                        end
                    end)
                end)
                local passed: any = nil
                while true do
                    local resumed, value = coroutine.resume(child, passed)
                    assert(resumed, tostring(value))
                    if coroutine.status(child) == "dead" then
                        return value
                    end
                    passed = coroutine.yield(value)
                end
            end,
            function(): any
                assert(nestedResume ~= nil, "the nested park must subscribe before its sibling runs")
                local resume = nestedResume
                nestedResume = nil
                resume(42)
                return 0
            end,
        })
        assert(nested[1] == 42, "a nested coroutine's park must wake the branch that owns it")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
