module nupp.runtime.seam.iobytes

local common = require("nupp.runtime.seam.module")
local runtimeBackend = require("nupp.runtime.backend")
local seam = {moduleName = "nupp.runtime.seam.iobytes", suiteModuleName = "nupp.runtime.seam.iobytessuite",}
local CONTRACT = common.contract("io.bytes", {
    globalName = "__nuppIoBytes",
    requiredFunctions = {"newBuffer", "newQueueReader", "newScalarReader", "newScalarWriter", "newStringReader"},
    requiredValues = {"Buffer", "ByteQueue", "ByteView", "Reader", "ScalarReader", "ScalarWriter", "Writer"},
    suiteModule = seam.suiteModuleName,
    modules = {["nupp.io"] = "",},
})

function seam.validate(value: any): string?
    return common.validate(CONTRACT, value)
end

function seam.seam(moduleName: string): runtimeBackend.Seam
    return common.seam(CONTRACT, moduleName)
end

function seam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("io-bytes:" .. moduleName, {seam.seam(moduleName)})
end

export = seam
