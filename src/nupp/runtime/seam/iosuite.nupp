@!internal
module nupp.runtime.seam.iosuite
local suite = {}
function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        local ioProvider = provider.io
        assert(
            type(provider.path) == "table" and type(provider.uri) == "table",
            "the package must supply path and URI modules"
        )
        local output = ioProvider.buffer()
        local writer = ioProvider.writer(output)
        writer:u8(0xab):u32le(0x12345678):bytes("ok")
        local reader = ioProvider.reader(output:finish())
        assert(reader:u8() == 0xab and reader:u32le() == 0x12345678, "scalar codecs must round-trip")
        assert(reader:bytes(2) == "ok", "byte ranges must round-trip")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
