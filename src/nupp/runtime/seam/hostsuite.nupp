@!internal
module nupp.runtime.seam.hostsuite
local suite = {}
function suite.test(provider: any): (boolean, string?)
    local ok, problem = pcall(function()
        local before, after = provider.clock(), provider.clock()
        assert(type(before) == "number" and type(after) == "number" and after >= before, "clock must be monotonic")
        local bytes = provider.entropy(32)
        assert(type(bytes) == "string" and #bytes == 32, "entropy must return the requested bytes")
        assert(bytes ~= string.rep("\0", 32), "secure entropy may not silently return zeros")
    end)
    if not ok then
        return false, tostring(problem)
    end

    return true
end

export = suite
