module nupp.runtime.seam.bitops

--[[
Runtime binding and conformance for the `numeric.bitops` provider seam.

The selected module is loaded lazily on the first emitted operation. This file
and its separate behavioral suite are ordinary checked source; no adapter code
is embedded in generated strings.
]]

local runtimeBackend = require("nupp.runtime.backend")
local bitopsSeam = {}

bitopsSeam.moduleName = "nupp.runtime.seam.bitops"
bitopsSeam.suiteModuleName = "nupp.runtime.seam.bitopssuite"

local REQUIRED_FUNCTIONS = {"arshift", "band", "bnot", "bor", "bxor", "lshift", "rshift",}

--- Answers why one loaded value cannot satisfy the shallow runtime contract.
function bitopsSeam.validate(value: any): string?
    if type(value) ~= "table" then
        return "module returned " .. type(value) .. ", expected table"
    end
    for _, name in ipairs(REQUIRED_FUNCTIONS) do
        if type(value[name]) ~= "function" then
            return "member " .. name .. " is " .. type(value[name]) .. ", expected function"
        end
    end

    return nil
end

--- Installs one lazy BitOp-compatible provider for portable lowering.
--- @raises when a conflicting provider or global binding is already installed
function bitopsSeam.install(moduleName: string): nil
    local prior = rawget(_G, "__nuppBitopsProvider")
    if prior ~= nil and prior ~= moduleName then
        error("nupp: runtime provider conflict for numeric.bitops: " .. prior .. " and " .. moduleName, 0)
    elseif prior ~= nil then
        return
    end
    if rawget(_G, "__nuppBitops") ~= nil then
        error("nupp: numeric.bitops runtime binding already exists", 0)
    end

    local loaded: any = nil
    local function provider(): any
        if loaded ~= nil then
            return loaded
        end
        local ok, value = pcall(require, moduleName)
        if not ok then
            error(
                "nupp: runtime provider " .. moduleName .. " for numeric.bitops could not load: " .. tostring(value),
                0
            )
        end
        local problem = bitopsSeam.validate(value)
        if problem ~= nil then
            error("nupp: runtime provider " .. moduleName .. " for numeric.bitops is incompatible: " .. problem, 0)
        end
        loaded = value

        return value
    end

    rawset(_G, "__nuppBitopsProvider", moduleName)
    rawset(
        _G,
        "__nuppBitops",
        setmetatable({}, {
            __index = function(self, name)
                local value = provider()[name]
                rawset(self, name, value)

                return value
            end,
        })
    )
end

--- Runs the compiler-owned behavioral contract against one provider module.
function bitopsSeam.test(moduleName: string): (boolean, string?)
    local ok, provider = pcall(require, moduleName)
    if not ok then
        return false, "could not load module: " .. tostring(provider)
    end
    local problem = bitopsSeam.validate(provider)
    if problem ~= nil then
        return false, problem
    end
    local suite = require("nupp.runtime.seam.bitopssuite")

    return suite.test(provider)
end

--- Supplies the versioned `numeric.bitops` seam for one BitOp-compatible module.
function bitopsSeam.seam(moduleName: string): runtimeBackend.Seam
    local identity = require("nupp.runtime.seam.registry").get("numeric.bitops")
    local seam: any = {name = identity.name, version = identity.version, binding = identity.binding,}
    function seam:install(): nil
        bitopsSeam.install(moduleName)
    end

    function seam:test(): (boolean, string?)
        return bitopsSeam.test(moduleName)
    end

    return seam as runtimeBackend.Seam
end

--- Supplies a complete backend containing the bit-operation seam.
function bitopsSeam.backend(moduleName: string): runtimeBackend.Backend
    return runtimeBackend.new("bitops:" .. moduleName, {bitopsSeam.seam(moduleName)})
end

export = bitopsSeam
