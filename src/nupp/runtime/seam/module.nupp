@!internal

module nupp.runtime.seam.module

--[[
The whole runtime half of seam substitution, for every contract.

There used to be one ~23-line module per contract here, each restating the
contract's member list, its global binding name and its suite module beside a
`seam`, `validate`, `test` and `backend` that differed only in which constant
they closed over. The constants belong to `nupp.runtime.seam.registry`, which
already held the rest of the identity, so this reads them from there and every
contract goes through one implementation.

A caller names a contract, not a module: `seam("data.json", provider)` rather
than `require("nupp.runtime.seam.json").seam(provider)`.
]]

-- Required here rather than where it is read: a require inside a body is not a
-- require the module graph follows, so a build staging the seam sources would
-- carry this module without the registry it reads.
local registry = require("nupp.runtime.seam.registry")
local moduleSeam = {}

--- Every module `install` may load, for `nupp.compiler.build.cache`'s module graph.
---
--- The provider is whichever one a backend declaration names, so the graph cannot
--- read it at the `require` below: the literal is in the declaration, not here.
--- This says the range instead, and says it as a string because the graph reads
--- the built module, where a comment is gone and this is not.
@allow("unused-binding")
const DYNAMIC_REQUIRES = "@requires-dynamically nupp.runtime.provider.*"

--- One versioned unit of substitutable behavior and its conformance suite.
---
--- Declared here rather than in `nupp.runtime.backend`, which requires this
--- module to install what a declaration selects; naming the type there would
--- make the two require each other.
--- @export
export interface Seam
    readonly name: string
    readonly version: integer
    readonly binding: string
    install: function(self: Seam): nil
    test: function(self: Seam): (boolean, string?)
end

--- One resolved contract, as `nupp.runtime.seam.registry` assembles it.
export interface Contract
    readonly name: string
    readonly slug: string
    readonly version: integer
    readonly binding: string
    readonly globalName: string
    readonly requiredFunctions: {string}
    readonly requiredValues: {string}
    readonly valueTypes: {[string]: string}
    readonly suiteModule: string
    readonly modules: {[string]: string}?
    readonly implementationModules: {[string]: boolean}?
    readonly exports: {[string]: string}?
end

local function contractOf(name: string): Contract
    return registry.get(name) as Contract
end

--- Answers why one loaded value cannot satisfy a contract's runtime shape.
---
--- This repeats at run time what a provider's own conformance projection already
--- settled at compile time, for the provider nobody compiled against the contract:
--- a rock, a host-supplied table, a module reached through a name the build never
--- saw.
---
--- Functions and values are checked differently: a function must be callable,
--- where a value only has to be there. A value whose declared type names a Lua
--- type is checked for that too.
function moduleSeam.validate(name: string, value: any): string?
    const contract = contractOf(name)
    if type(value) ~= "table" then
        return "module returned " .. type(value) .. ", expected table"
    end
    for _, member in ipairs(contract.requiredFunctions) do
        if type(value[member]) ~= "function" then
            return "member " .. member .. " is " .. type(value[member]) .. ", expected function"
        end
    end
    for _, member in ipairs(contract.requiredValues) do
        if value[member] == nil then
            return "member " .. member .. " is absent"
        end
        const expected = contract.valueTypes[member]
        if expected ~= nil and type(value[member]) ~= expected then
            return "member " .. member .. " is " .. type(value[member]) .. ", expected " .. expected
        end
    end

    return nil
end

local function loadProvider(contract: Contract, moduleName: string): any
    local ok, value = pcall(require, moduleName)
    if not ok then
        error(
            "nupp: runtime provider " .. moduleName .. " for " .. contract.name .. " could not load: " .. tostring(
                value
            ),
            0
        )
    end
    local problem = moduleSeam.validate(contract.name, value)
    if problem ~= nil then
        error("nupp: runtime provider " .. moduleName .. " for " .. contract.name .. " is incompatible: " .. problem, 0)
    end

    return value
end

--- Installs one lazily loaded provider for a contract.
--- @raises when a conflicting provider or binding is already installed
function moduleSeam.install(name: string, moduleName: string): nil
    const contract = contractOf(name)
    local selections = rawget(_G, "__nuppRuntimeProviders")
    if selections == nil then
        selections = {}
        rawset(_G, "__nuppRuntimeProviders", selections)
    end
    local prior = selections[contract.name]
    if prior ~= nil and prior ~= moduleName then
        error("nupp: runtime provider conflict for " .. contract.name .. ": " .. prior .. " and " .. moduleName, 0)
    elseif prior ~= nil then
        return
    end
    if rawget(_G, contract.globalName) ~= nil then
        error("nupp: " .. contract.name .. " runtime binding already exists", 0)
    end
    -- Every remaining refusal happens before any state changes. A failure past the
    -- first write would leave the selection and binding behind, and a retried
    -- install would then return through the `prior` path as though it had worked.
    for target in pairs(contract.modules or {}) do
        if package.loaded[target] ~= nil then
            error("nupp: " .. contract.name .. " provider was selected after " .. target .. " was already loaded", 0)
        end
    end
    for target in pairs(contract.implementationModules or {}) do
        if package.loaded[target] ~= nil then
            error("nupp: " .. contract.name .. " provider was selected after " .. target .. " was already loaded", 0)
        end
    end
    local priorProjections = rawget(_G, "__nuppRuntimeModules")
    for path in pairs(contract.exports or {}) do
        local target, member = path:match("^(.*)%.([^%.]+)$")
        if not target or not member then
            error("nupp: invalid projected runtime export " .. path, 0)
        end
        if package.loaded[target] ~= nil then
            error("nupp: " .. contract.name .. " provider was selected after " .. target .. " was already loaded", 0)
        end
        local projection = priorProjections and priorProjections[target]
        if projection ~= nil and projection.loaders[member] ~= nil then
            error("nupp: more than one runtime provider supplies " .. path, 0)
        end
    end
    local binding = {}
    local loaded: any = nil
    local function provider(): any
        if loaded == nil then
            local value = loadProvider(contract, moduleName)
            loaded = value
            -- Publish the complete promised surface once the provider has loaded.
            -- Generated suspension wrappers use raw lookup for `create`: that
            -- inherits an installed handler after the provider is available, but
            -- does not recursively load the suspension provider from the protected
            -- call that is loading it.
            for _, member in ipairs(contract.requiredFunctions) do
                rawset(binding, member, value[member])
            end
            for _, member in ipairs(contract.requiredValues) do
                rawset(binding, member, value[member])
            end
        end

        return loaded
    end

    selections[contract.name] = moduleName
    setmetatable(binding, {
        __index = function(self, member)
            local value = provider()[member]
            rawset(self, member, value)

            return value
        end,
    })
    rawset(_G, contract.globalName, binding)
    for target, member in pairs(contract.modules or {}) do
        package.preload[target] = function()
            local value = provider()
            if member ~= "" then
                value = value[member]
            end
            if type(value) ~= "table" then
                error(
                    "nupp: runtime provider "
                    .. moduleName
                    .. " for "
                    .. contract.name
                    .. " member "
                    .. member
                    .. " is "
                    .. type(
                        value
                    ) .. ", expected module table",
                    0
                )
            end

            return value
        end
    end
    -- An implementation rather than a module: the declared interface at that name is
    -- the contract, so a program keeps naming the declared types and only what
    -- answers the require changes. `modules` above substitutes the interface too,
    -- which is right where the provider is the module and wrong where it implements
    -- one somebody else declared.
    local function loadImplementation(): any
        return provider()
    end

    for target in pairs(contract.implementationModules or {}) do
        package.preload[target] = loadImplementation
    end
    local projected = rawget(_G, "__nuppRuntimeModules")
    if projected == nil then
        projected = {}
        rawset(_G, "__nuppRuntimeModules", projected)
    end
    for path, providerMember in pairs(contract.exports or {}) do
        -- The refusal pass above already rejected an unparseable path.
        local matchedTarget, matchedMember = path:match("^(.*)%.([^%.]+)$")
        local target, member = matchedTarget as string, matchedMember as string
        local projection = projected[target]
        if projection == nil then
            projection = {loaders = {},}
            projected[target] = projection
            package.preload[target] = function()
                local value = {}
                for exported, loader in pairs(projection.loaders) do
                    value[exported] = loader()
                end

                return value
            end
        end
        projection.loaders[member] = function()
            return provider()[providerMember]
        end
    end
end

--- Runs the compiler-owned behavioral suite against one provider module.
---
--- This command-facing suite is evidence rather than a build-time proof. It is
--- deliberately explicit so checking and building never execute a dependency.
function moduleSeam.test(name: string, moduleName: string): (boolean, string?)
    const contract = contractOf(name)
    local ok, value = pcall(require, moduleName)
    if not ok then
        return false, "could not load module: " .. tostring(value)
    end
    local problem = moduleSeam.validate(contract.name, value)
    if problem ~= nil then
        return false, problem
    end
    local suite = require(contract.suiteModule) as any

    return suite.test(value)
end

--- Supplies the versioned seam binding one contract to one provider module.
function moduleSeam.seam(name: string, moduleName: string): Seam
    const contract = contractOf(name)
    local selected: any = {name = contract.name, version = contract.version, binding = contract.binding,}
    function selected:install(): nil
        moduleSeam.install(contract.name, moduleName)
    end

    function selected:test(): (boolean, string?)
        return moduleSeam.test(contract.name, moduleName)
    end

    return selected as Seam
end

export = moduleSeam
