@!internal
module nupp.runtime.int64

local spi = require("nupp.spi")
local contracts = require("nupp.runtime.representation.spi")
local representation = require("nupp.runtime.representation")

-- Kept optional because a module
-- carrying 64-bit integer code requires this one from its preamble, before any of
-- that code runs. `nupp.compiler.runtime.math` is such a module and the portable
-- compiler bundle carries it on stock Lua 5.1, which has no integer provider at
-- all. Loading the bundle there has to work; calling `nupp.math.u64` is the part
-- that cannot, so absence is held until a member is actually read.
local provider: contracts.Int64Provider? = do
    local chosen: contracts.Int64Provider?
    local tied = false
    for candidate in spi.load(contracts.Int64Provider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.runtime.int64: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    yield representation.integers
end
if provider ~= nil and representation.integers ~= nil then
    assert(
        provider == representation.integers,
        "nupp.runtime.int64: integers must use the target storage implementation"
    )
end
-- A present provider is exported as itself, so the ordinary path reads a plain
-- field and this module costs nothing once it has loaded.
local absent: any = setmetatable({}, {
    __index = function(_: any, name: string): any
        error("nupp.runtime.int64: this target requires an integer provider", 2)
    end,
})

export = (provider or absent) as contracts.Int64Provider
