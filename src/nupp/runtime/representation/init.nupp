module nupp.runtime.representation

local spi = require("nupp.spi")
local contracts = require("nupp.runtime.representation.spi")

export const storage: contracts.CstorageProvider? = do
    local chosen: contracts.CstorageProvider?
    local tied = false
    for candidate in spi.load(contracts.CstorageProvider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.runtime.representation: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    yield _G.require("nupp.runtime.provider.nativestorage") as contracts.CstorageProvider
end
if storage ~= nil then
    assert(storage.representation == "native", "nupp.runtime.storage: target requires native pointer storage")
end
local tableStructs: contracts.StructvalueProvider = require("nupp.runtime.provider.tablestruct")
export const structs: contracts.StructvalueProvider = storage and storage.structs or tableStructs
export const integers = storage and storage.integers or nil
export const host = storage and storage.host or nil
