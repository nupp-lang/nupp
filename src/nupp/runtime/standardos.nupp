@!internal

--[[
`os` provides process operations, system facts, clocks, and UUIDs.
Its clocks return milliseconds and distinguish elapsed time from calendar time.

```nupp
local facts = os.info()
print(facts.platform, facts.arch, facts.parallelism)
print(os.monotonic())
```

See [system services](docs/learn/runtime/system.md) for facts, clocks, and UUIDs.
]]

--- @namespace os
module nupp.runtime.standardos

local system = require("nupp.runtime.system")
local clocks = require("nupp.runtime.timeprovider").provider
local entropy = require("nupp.runtime.entropy")

local host: any = rawget(_G, "os")
local luaRemove = host.remove
local luaRename = host.rename

local function missingClock(): never
    error("nupp.time: no clock provider is available", 2)
end

--- Returns a filename for a temporary file that the caller removes explicitly.
---
--- On POSIX systems, this also creates an empty file to reserve the name.
--- Use `io.tmpfile` for an owned handle or `io.files.tmpfile` for an owned path.
--- @return the temporary filename
@deprecated(reason = "temporary filenames require manual cleanup", replacement = "io.tmpfile or io.files.tmpfile")
export const tmpname: function(): string = host.tmpname

const _FILES_REQUIRES = "@requires-dynamically nupp.runtime.bindings.files"

local function filename(value: any, position: integer): any
    if type(value) == "table" then
        if type(value.tostring) ~= "function" then
            error("bad argument #" .. tostring(position) .. " (path or string expected)", 3)
        end
        return value:tostring()
    end

    return value
end

local function implementation(name: string): any
    local ok, value = pcall(require, name)
    if not ok then
        error(value, 0)
    end

    return value
end

--- Removes a file, symbolic link, or directory.
---
--- Native hosts accept strings and `io.Path` values. Browser hosts accept
--- `io.files.AppPath` values and refuse raw paths. A populated directory
--- requires `recursive = true`; symbolic links are removed without following
--- their targets. Without that flag, native calls retain Lua's behavior.
---
--- @param path the path to remove
--- @param recursive whether to remove a directory's contents
--- @return true on success, or nil on failure
--- @return a failure reason, when unsuccessful
--- @return the native error code, when supplied by Lua
export function remove(path: io.files.Path, recursive: boolean?): (boolean?, string?, number?)
    if recursive ~= nil and type(recursive) ~= "boolean" then
        error("bad argument #2 to 'remove' (recursive must be a boolean)", 2)
    end
    if rawget(_G, "__nuppBrowser") ~= nil or recursive == true then
        local removed, reason = implementation("nupp.runtime.bindings.files").remove(path, recursive)
        if not removed then
            return nil, reason
        end
        return true
    end

    return luaRemove(filename(path, 1))
end

--- Renames a file or directory, replacing the destination when supported.
---
--- Native hosts accept strings and `io.Path` values in either position and
--- retain Lua's success and error returns. Browser hosts accept app-owned
--- paths but currently return an unsupported-operation reason.
---
--- @param from the source path
--- @param to the destination path
--- @return true on success, or nil on failure
--- @return a failure reason, when unsuccessful
--- @return the native error code, when supplied by Lua
export function rename(from: io.files.Path, to: io.files.Path): (boolean?, string?, number?)
    if rawget(_G, "__nuppBrowser") ~= nil then
        local renamed, reason = implementation("nupp.runtime.bindings.files").rename(from, to)
        if not renamed then
            return nil, reason
        end
        return true
    end

    return luaRename(filename(from, 1), filename(to, 2))
end

--- Calendar fields returned by `os.date("*t")`.
export type DateFields = os.DateFields

--- The executing ABI and the available parallelism at the time of a query.
export record Info
    @readonly platform: string
    @readonly arch: string
    @readonly endianness: "little" | "big"
    @readonly pointerbits: integer
    @readonly parallelism: integer
end

--- Returns the executing ABI's facts and current available parallelism.
export function info(): Info
    return Info(
        platform = system.platform,
        arch = system.architecture,
        endianness = system.endianness,
        pointerbits = system.pointerBits,
        parallelism = system.availableParallelism()
    )
end

--- Returns monotonic milliseconds with the host's unspecified origin.
export const monotonic: function(): number = clocks and clocks.now or missingClock

--- Returns milliseconds since the Unix epoch.
export const walltime: function(): number = clocks and clocks.walltime or missingClock

const _DYNAMIC_REQUIRES = "@requires-dynamically nupp.util.internal.uuid"

-- UUID features carry the helper; clocks and system facts do not need it.

--- Generates a random version 4 UUID using the retained host service.
export function uuid4(): string
    return implementation("nupp.util.internal.uuid").uuid4()
end

--- Generates a time-ordered version 7 UUID using the retained host service.
export function uuid7(): string
    return implementation("nupp.util.internal.uuid").uuid7()
end

--- Returns cryptographically secure random bytes from the selected host.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises string when the count is invalid or the host cannot supply randomness
export const randombytes = entropy.randombytes

--- The original host table with these shared implementations installed.
--- @internal
export const value: table = do
    local original = rawget(_G, "os") as any
    original.remove = remove
    original.rename = rename
    original.info = info
    original.monotonic = monotonic
    original.walltime = walltime
    original.uuid4 = uuid4
    original.uuid7 = uuid7
    original.randombytes = randombytes
    yield original
end
