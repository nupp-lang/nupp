@!internal

--- @namespace os
module nupp.runtime.standardos

--[[
`os` provides process operations, system facts, clocks, and UUIDs.
Its clocks return milliseconds and distinguish elapsed time from calendar time.

```nupp
local facts = os.info()
print(facts.platform, facts.arch, facts.parallelism)
print(os.monotonic())
```

See [system services](docs/learn/runtime/system.md) for facts, clocks, and UUIDs.
]]

local system = require("nupp.runtime.system")
local clocks = require("nupp.runtime.clocks").selected
local entropy = require("nupp.runtime.entropy")

--- Calendar fields returned by `os.date("*t")`.
export type DateFields = os.DateFields

--- The executing ABI and the available parallelism at the time of a query.
export record Info
    @readonly platform: string
    @readonly arch: string
    @readonly endianness: "little" | "big"
    @readonly pointerbits: integer
    @readonly parallelism: integer
end

--- Returns the executing ABI's facts and current available parallelism.
export function info(): Info
    return new Info(
        platform = system.platform,
        arch = system.architecture,
        endianness = system.endianness,
        pointerbits = system.pointerBits,
        parallelism = system.availableParallelism()
    )
end

--- Returns monotonic milliseconds with the host's unspecified origin.
export const monotonic: function(): number = clocks.now

--- Returns milliseconds since the Unix epoch.
export const walltime: function(): number = clocks.walltime

const _DYNAMIC_REQUIRES = "@requires-dynamically nupp.util.internal.uuid"

-- UUID features carry the helper; clocks and system facts do not need it.
local function uuidImplementation(name: string): any
    local ok, implementation = pcall(require, name)
    if not ok then
        error(implementation, 0)
    end

    return implementation
end

--- Generates a random version 4 UUID using the retained host service.
export function uuid4(): string
    return uuidImplementation("nupp.util.internal.uuid").uuid4()
end

--- Generates a time-ordered version 7 UUID using the retained host service.
export function uuid7(): string
    return uuidImplementation("nupp.util.internal.uuid").uuid7()
end

--- Returns cryptographically secure random bytes from the selected host.
--- @param count the requested byte count, from zero through 1048576
--- @return the generated raw bytes
--- @raises string when the count is invalid or the host cannot supply randomness
export const randombytes = entropy.randombytes

--- The original host table with these shared implementations installed.
--- @internal
export const value: table = do
    local original = rawget(_G, "os") as any
    original.info = info
    original.monotonic = monotonic
    original.walltime = walltime
    original.uuid4 = uuid4
    original.uuid7 = uuid7
    original.randombytes = randombytes
    yield original
end
