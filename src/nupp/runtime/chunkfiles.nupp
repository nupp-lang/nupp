@!internal

--[[
Lua source compiled to binary chunks ahead of time, on the host, for a core
that cannot compile text itself: `loadfile` and `dofile` answer the chunk
kept for a file whose text is the text it was compiled from, and `load` the
one kept for its text. A kept chunk is a file in the directory
NUPP_CORE_CHUNKS names, called after the source's path (or, for text, its
digest), holding a header line (MAGIC, the source's digest and its length)
and then the chunk's bytes.
]]
module nupp.runtime.chunkfiles

-- The directory kept chunks are in.
export const VARIABLE = "NUPP_CORE_CHUNKS"
const MAGIC = "nupp-core-chunk"
-- What a kept refusal's header starts with in place of MAGIC.
const REFUSED = "nupp-core-refused"
const SUFFIX = ".chunk"
const TEXT_PREFIX = "text-"
-- FNV-1a's 64-bit offset basis and prime.
const BASIS = 0xcbf29ce484222325
const PRIME = 0x100000001b3

--- The 64-bit FNV-1a digest of `text`, in hexadecimal.
export function digest(text: string): string
    local hash = BASIS
    for at = 1, #text do
        hash = (hash ~ text:byte(at)) * PRIME
    end

    return string.format("%016x", hash)
end

--- Source text `text` as Lua compiles a file of it: a first line that starts
--- with '#', a Unix exec line, is skipped, its newline kept so lines keep
--- their numbers.
export function execLineSkipped(text: string): string
    if text:sub(1, 1) ~= "#" then
        return text
    end
    local at = text:find("\n", 1, true)

    return at and text:sub(at) or ""
end

--- The name the chunk kept for source path `path` has in the directory.
export function name(path: string): string
    return (path:gsub("[^%w%.%-]", "_")) .. SUFFIX
end

--- The name the chunk kept for text `text` itself has in the directory.
export function textname(text: string): string
    return TEXT_PREFIX .. digest(text) .. SUFFIX
end

--- What a kept chunk's file holds for source `text` compiled to `chunk`.
export function contents(text: string, chunk: string): string
    return MAGIC .. " " .. digest(text) .. " " .. tostring(#text) .. "\n" .. chunk
end

--- What a kept file holds where source `text` did not compile on the host,
--- for `reason`: a compile on the core would refuse it too, slowly.
export function refusedcontents(text: string, reason: string): string
    return REFUSED .. " " .. digest(text) .. " " .. tostring(#text) .. "\n" .. reason
end

-- The directory the core keeps the chunks it compiled itself in, for the
-- next process to load in place of compiling the same text again. Its chunks
-- are one compiler's: scripts/core-cli names one per core compiler generation.
export const CACHE_VARIABLE = "NUPP_CORE_CHUNK_CACHE"

-- The directory variable `variable` names, or nil.
local function directoryOf(variable: string): string?
    local directory = os.getenv(variable)
    if directory == nil or directory == "" then
        return nil
    end

    return directory
end

-- What is kept under `magic` for source path `path` (or, when nil, for the
-- text itself) whose text is `text` in `directory`, or nil when nothing is
-- kept or what is kept is of other text.
local function keptIn(directory: string?, magic: string, path: string?, text: string): string?
    if directory == nil then
        return nil
    end
    local file = io.open(directory .. "/" .. (path ~= nil and name(path) or textname(text)), "rb")
    if file == nil then
        return nil
    end
    local held = file:read("a") or ""
    file:close()
    local header = held:match("^[^\n]*") as string
    if header ~= magic .. " " .. digest(text) .. " " .. tostring(#text) then
        return nil
    end

    return held:sub(#header + 2)
end

-- What is kept under `magic` for `path` and `text`: compiled on the host
-- ahead of time, else by an earlier process on this core compiler.
local function kept(magic: string, path: string?, text: string): string?
    return keptIn(directoryOf(VARIABLE), magic, path, text)
        or (magic == MAGIC and keptIn(directoryOf(CACHE_VARIABLE), magic, path, text) or nil)
end

--- Keeps `chunk`, compiled on the core from source `text` at path `path`
--- (or, when nil, from the text itself), where CACHE_VARIABLE names a
--- directory. A chunk that cannot be kept is compiled again next time.
export function keep(path: string?, text: string, chunk: string): nil
    local directory = directoryOf(CACHE_VARIABLE)
    if directory == nil then
        return
    end
    local destination = directory .. "/" .. (path ~= nil and name(path) or textname(text))
    local pending = destination .. "." .. digest(chunk) .. ".pending"
    local file = io.open(pending, "wb")
    if file == nil then
        return
    end
    local written = file:write(contents(text, chunk))
    file:close()
    if written == nil or not os.rename(pending, destination) then
        os.remove(pending)
    end
end

--- The chunk kept for source path `path` (or, when nil, for the text
--- itself) whose text is `text`, or nil when none is kept or the one kept
--- is of other text.
export function lookup(path: string?, text: string): string?
    return kept(MAGIC, path, text)
end

--- Why the host refused to compile source `text` at `path` (or the text
--- itself), where it kept that refusal; nil otherwise.
export function refusal(path: string?, text: string): string?
    return kept(REFUSED, path, text)
end
