@!internal

--- The native core's storage operations. A call of one is the core's own
--- library call, and requiring this module loads nothing: it exists only on
--- the core, for the storage provider written over it.
local record storagecalls
    --- New zeroed storage of `count` elements of `kind`: 1 through 10 are
    --- uint8, int8, uint16, int16, uint32, int32, uint64, int64, float32 and
    --- float64.
    allocate: function(kind: integer, count: integer): any

    --- New zeroed storage of `count` bytes.
    allocbytes: function(count: integer): uint8[?]

    --- A view of `storage`'s or a string's bytes from byte `offset`, as `count`
    --- elements of `kind` (as many as fit when omitted), keeping the storage alive.
    view: function(borrows storage: any, kind: integer, offset: integer, count: integer?): any borrows (storage)

    --- `storage`'s bytes as elements of `kind`, as many as fit: a view, which
    --- keeps the storage alive whoever holds it.
    cast: function(borrows storage: any, kind: integer): any borrows (storage)

    --- Copies `count` bytes of `source`, storage or a string, into `target`.
    copy: function(borrows target: any, borrows source: any, count: integer): nil

    --- Sets `count` bytes of `target` to `byte`.
    fill: function(borrows target: any, count: integer, byte: integer): nil

    --- The first `count` bytes of `storage` as a string.
    text: function(borrows storage: any, count: integer): string

    --- Byte storage holding a copy of `s`, read-only.
    fromstring: function(borrows s: string): const uint8[?] borrows (s)

    --- How many elements `storage` holds.
    elements: function(borrows storage: any): integer

    --- The kind of `storage`'s elements.
    elementkind: function(borrows storage: any): integer

    --- The kind a table's array part is packed as (uint8 through float64
    --- as for `allocate`, 11 for booleans), or 0 when it is general or
    --- `value` is not a table: what a test of the representation reads.
    packedkind: function(borrows value: any): integer
end

local calls: storagecalls
return calls
