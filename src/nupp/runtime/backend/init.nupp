module nupp.runtime.backend

--[[
Runtime half of a backend: installing the providers one declaration selects.

A backend is a declaration, not a module of code. It says its name and which
provider module answers each seam, and nothing else -- no constructor call, no
per-seam factory, no order for the reader to preserve. That is what lets the
compiler resolve one by reading its value instead of pattern-matching the shape
of a call it refuses to execute, and it is why a seam cannot be declared twice:
the contract name is the key.

The compiler checks the same contracts without executing any of this. An
artifact calls `install` for the backend it selected, while backend authors and
package CI call `test` explicitly to run every seam's behavioral suite.
]]

local moduleSeam = require("nupp.runtime.seam.module")
local registry = require("nupp.runtime.seam.registry")
local backend = {}

backend.moduleName = "nupp.runtime.backend"

--- One named selection of provider modules, by the contract each answers.
--- @export
export interface Declaration
    readonly name: string
    readonly seams: {[string]: string}
end

--- One contract and the module a declaration named for it.
--- @export
export interface Selection
    readonly name: string
    readonly module: string
end

--- What one declaration selects, in a stable order.
--- @raises when the declaration is malformed or names an unknown contract
function backend.selections(declared: Declaration): {Selection}
    if declared.name == "" then
        error("nupp: a backend must have a non-empty name", 2)
    end
    local selected = {}
    for name, moduleName in pairs(declared.seams) do
        if registry.find(name) == nil then
            error("nupp: backend " .. declared.name .. " selects unknown seam " .. name, 2)
        end
        if moduleName == "" then
            error("nupp: backend " .. declared.name .. " names no module for " .. name, 2)
        end
        selected[#selected + 1] = {name = name, module = moduleName,}
    end
    if #selected == 0 then
        error("nupp: backend " .. declared.name .. " must select at least one seam", 2)
    end
    -- Sorted, because a declaration is a map and its iteration order is not a
    -- fact about the backend. Installation, testing and the artifact's audit
    -- comment all read this, and all three should say the same thing twice.
    table.sort(selected, function(left: any, right: any): boolean
        return left.name < right.name
    end)

    return selected as {Selection}
end

--- Installs every provider one declaration selects.
function backend.install(declared: Declaration): nil
    for _, selected in ipairs(backend.selections(declared)) do
        moduleSeam.install(selected.name, selected.module)
    end
end

--- Runs every selected seam's explicit behavioral suite.
function backend.test(declared: Declaration): (boolean, string?)
    for _, selected in ipairs(backend.selections(declared)) do
        local ok, problem = moduleSeam.test(selected.name, selected.module)
        if not ok then
            return false, (
                "backend %s failed %s contract %d: %s"
            ):format(declared.name, selected.name, registry.get(selected.name).version, tostring(problem))
        end
    end

    return true
end

export = backend
