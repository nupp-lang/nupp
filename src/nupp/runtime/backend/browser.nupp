module nupp.runtime.backend.browser

--[[
The complete set of third-party and checked pure-Lua providers carried by the
portable compiler host. Application backends remain an independent target
choice.

`nupp.compiler.browser` requires this declaration rather than restating it. It
used to hold a second copy, because the compiler resolves against a descriptor
and could not require a module that pulled in eighteen seam factories to build
one. The two then had to be kept saying the same thing, and once did not: a
`text.buffer` entry present here and missing there made `nupp.derive`
unreachable in a browser that had a buffer provider all along.
]]

export = {
    name = "nupp.browser",
    seams = {
        ["numeric.bitops"] = "nupp.runtime.provider.scalarbitops",
        ["text.buffer"] = "nupp.runtime.provider.tablebuffer",
        ["data.json"] = "nupp.runtime.provider.lunajson",
        ["host.path"] = "nupp.runtime.provider.browserpath",
        ["peg"] = "re",
        ["numeric.simd"] = "nupp.runtime.provider.scalarsimd",
        ["suspension"] = "nupp.runtime.provider.browsersuspension",
        ["io.uri"] = "nupp.runtime.provider.browseruri",
        ["host.http"] = "nupp.runtime.provider.browserhttp",
        ["host.time"] = "nupp.runtime.provider.browsertime",
        ["host.browser_crypto"] = "nupp.runtime.provider.browsercrypto",
        ["host.browser_storage"] = "nupp.runtime.provider.browserstorage",
        ["host.workers"] = "nupp.runtime.provider.browserworkers",
        ["host.wasm"] = "nupp.runtime.provider.wasmstorage",
        ["data.sha256"] = "nupp.runtime.provider.browsercrypto",
        ["crypto.hmac_sha256"] = "nupp.runtime.provider.browsercrypto",
        ["data.uuid"] = "nupp.runtime.provider.browsercrypto",
        ["compute.gpu"] = "nupp.runtime.provider.browserwebgpu",
    },
}
