@!internal
module nupp.runtime.reflectionshape

-- Public metadata names are adapted separately from private blueprint keys.
-- Only descriptor records are copied; annotation values and defaults stay intact.

local fieldnames: {
    [string]: string
} = {["defaultValue"] = "defaultvalue", ["hasDefault"] = "hasdefault", ["typeName"] = "typename",}

local entrynames: {[string]: string} = {["defaultValue"] = "defaultvalue", ["hasDefault"] = "hasdefault",}

local nodenames: {
    [string]: string
} = {
    ["moduleName"] = "modulename",
    ["deriveKey"] = "derivekey",
    ["arrayOf"] = "arrayof",
    ["varargType"] = "varargtype",
    ["borrowedFrom"] = "borrowedfrom",
    ["borrowedFromMany"] = "borrowedfrommany",
    ["borrowedResult"] = "borrowedresult",
    ["parameterPack"] = "parameterpack",
    ["returnPack"] = "returnpack",
    ["yieldPack"] = "yieldpack",
    ["resumePack"] = "resumepack",
    ["startPack"] = "startpack",
    ["resultKind"] = "resultkind",
    ["transferOnly"] = "transferonly",
    ["countTerm"] = "countterm",
    ["readKey"] = "readkey",
    ["readValue"] = "readvalue",
    ["writeKey"] = "writekey",
    ["writeValue"] = "writevalue",
    ["associatedTypes"] = "associatedtypes",
    ["constArguments"] = "constarguments",
    ["constParameters"] = "constparameters",
    ["nestedTypes"] = "nestedtypes",
    ["noReturn"] = "noreturn",
    ["noYield"] = "noyield",
    ["packArguments"] = "packarguments",
    ["packParameters"] = "packparameters",
    ["parameterKinds"] = "parameterkinds",
    ["staticFields"] = "staticfields",
    ["typeArguments"] = "typearguments",
    ["typeBounds"] = "typebounds",
    ["typeParameters"] = "typeparameters",
}

local infonames: {[string]: string} = {["qualifiedName"] = "qualifiedname",}

local indexnames: {
    [string]: string
} = {["readKey"] = "readkey", ["readValue"] = "readvalue", ["writeKey"] = "writekey", ["writeValue"] = "writevalue",}
local constructionnames: {[string]: string} = {["requiresFactory"] = "requiresfactory"}
local cleanupnames: {[string]: string} = {["functionType"] = "functiontype"}

local function copy(value: any, names: {[string]: string}): any
    if type(value) ~= "table" then
        return value
    end
    local result: any = {}
    for key, held in pairs(value) do
        if names[key] == nil then
            result[key] = held
        end
    end
    for old, name in pairs(names) do
        if result[name] == nil and value[old] ~= nil then
            result[name] = value[old]
        end
    end

    return result
end

-- Private checker tags are normalized only at published descriptor positions.
local kindnames: {
    [string]: string
} = {
    ["protocolThread"] = "protocolthread",
    ["genericAlias"] = "genericalias",
    ["typeHandle"] = "typehandle",
    ["packResult"] = "packresult",
    ["constLiteral"] = "constliteral",
    ["constVar"] = "constvar",
    ["constOp"] = "constop",
}

local function kind(value: any): any
    return kindnames[value] or value
end

local function field(value: any): any
    local result = copy(value, fieldnames)
    if type(value) == "table" then
        result.kind = kind(value.kind)
    end

    return result
end

local function entry(value: any): any
    return copy(value, entrynames)
end

local function cleanup(value: any): any
    return copy(value, cleanupnames)
end

local function list(values: any, transform: function(any): any): any
    if type(values) ~= "table" then
        return values
    end
    local result: any = {}
    for index, value in pairs(values) do
        result[index] = transform(value)
    end

    return result
end

local entrylists = {"fields", "staticFields", "metamethods", "nestedTypes", "associatedTypes", "parameters"}

local function node(value: any): any
    local result = copy(value, nodenames)
    if type(value) ~= "table" then
        return result
    end
    result.kind = kind(value.kind)
    result.operation = value.operation == "comptimeTypeCall" and "comptimetypecall" or value.operation
    result.index = copy(value.index, indexnames)
    result.construction = copy(value.construction, constructionnames)
    result.cleanups = list(value.cleanups, cleanup)
    for _, name in ipairs(entrylists) do
        local canonical = nodenames[name] or name
        local held = value[canonical]
        if held == nil then
            held = value[name]
        end
        if held ~= nil then
            result[canonical] = list(held, entry)
        end
    end

    return result
end

-- Private descriptors and accepting-seed descriptors share this canonical boundary.
export function accept(value: any): any
    local result = copy(value, infonames)
    if type(value) == "table" then
        result.kind = kind(value.kind)
        result.fields = list(value.fields, field)
        result.types = list(value.types, node)
    end

    return result
end
