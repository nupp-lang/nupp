module nupp.text

--[[
`nupp.text` creates mutable FIFO byte buffers through a shared provider contract.
Append at one end and consume bytes from the other.

```nupp
local text = nupp.text

const out = text.newbuffer()
out:put("hello", ", ", "world")
print(out:get())
```

A buffer comes from the host. On the VM it is the runtime's native
`string.buffer`; a provider can supply another, such as the portable one written
in Nupp. Both answer to the same [](Buffer), so a program that only ever writes
and reads bytes does not notice which it has.

Use [](utf8) to validate text and walk codepoints.
]]

local spi = require("nupp.runtime.packages")

-- The default provider is loaded by name below, so image builders are told.
const _DYNAMIC_REQUIRES = "@requires-dynamically nupp.runtime.provider.nativebuffer"

local {type Buffer as SharedBuffer} = require("nupp.text.internal.buffer")
local contracts = package.nupp
local provider: contracts.BufferProvider = do
    const chosen = spi.select(spi.providers<contracts.BufferProvider>("package.nupp.BufferProvider"))
    if chosen ~= nil then
        yield chosen
    end
    yield _G.require("nupp.runtime.provider.nativebuffer") as contracts.BufferProvider
end

--- A mutable FIFO byte sequence.
export type Buffer = SharedBuffer

--- Creates an empty FIFO byte buffer.
---
--- @param size a capacity hint, or the options table when it is the only argument
--- @param options the host buffer library's options, where it has any
--- @return the buffer, holding nothing
export const newbuffer: function(size: (integer | table)?, options: table?): Buffer = provider.new
