module nupp.text

--[[
Working with text a byte at a time.

`newBuffer` hands back a FIFO byte buffer: append to one end, read from the
other, and the string is built once instead of once per concatenation.

```nupp
local text = require("nupp.text")

const out = text.newBuffer()
out:put("hello", ", ", "world")
print(out:get())
```

A buffer comes from the host. On LuaJIT it is `string.buffer`; everywhere else
it is a portable one written in Nupp. Both answer to the same [](Buffer), so a
program that only ever writes and reads bytes does not notice which it has.

[](nupp.text.utf8) is the other half of this namespace: codepoints rather than
bytes.
]]

local spi = require("nupp.spi")
local target = require("nupp.runtime.target")

local {type Buffer as SharedBuffer} = require("nupp.text.internal.buffer")
local contracts = require("nupp.text.spi")
local provider: contracts.TextBufferProvider = do
    local chosen: contracts.TextBufferProvider?
    local tied = false
    for candidate in spi.load(contracts.TextBufferProvider) do
        if chosen == nil or (candidate.priority ?? 0) > (chosen.priority ?? 0) then
            chosen = candidate
            tied = false
        elseif (candidate.priority ?? 0) == (chosen.priority ?? 0) then
            tied = true
        end
    end
    assert(not tied, "nupp.text: multiple implementations have the highest priority")
    if chosen ~= nil then
        yield chosen
    end
    if target.dialect ~= "lua51" then
        yield _G.require("nupp.runtime.provider.nativebuffer") as contracts.TextBufferProvider
    end
    yield _G.require("nupp.runtime.provider.tablebuffer") as contracts.TextBufferProvider
end

--- A mutable FIFO byte sequence.
export type Buffer = SharedBuffer

--- Creates an empty FIFO byte buffer.
---
--- @param size a capacity hint, or the options table when it is the only argument
--- @param options the host buffer library's options, where it has any
--- @return the buffer, holding nothing
export const newBuffer: function(size: (integer | table)?, options: table?): Buffer = provider.new
