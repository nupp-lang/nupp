@!internal
module nupp.tools.doc.markdownhost

-- The Markdown renderer `nupp doc` writes HTML with. The library itself is a
-- runtime provider, so the core can substitute its own without the compiler
-- naming a tools module.
const library = require("nupp.runtime.provider.markdownlibrary")

export function available(): boolean
    return library.available()
end

export const unavailable = library.unavailable

export function render(text: string): (string?, string?)
    return library.render(text)
end
