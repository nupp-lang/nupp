--[[
The markdown rendering of a module.

This is the format the site also writes beside every page as `llms.txt`, so it
has to read as prose on its own rather than as a degraded version of the HTML.
]]
module nupp.tools.doc.markdown

const {type Links} = require("nupp.tools.doc.urls")
const {type Item} = require("nupp.tools.doc.extract")
const {type Module} = require("nupp.tools.doc.extract")

local stringsMod = require("nupp.tools.doc.strings")
local extractMod = require("nupp.tools.doc.extract")
local urlsMod = require("nupp.tools.doc.urls")
local apiMod = require("nupp.tools.doc.api")

local markdownEscape, markdownCell = stringsMod.markdownEscape, stringsMod.markdownCell
local childModules = extractMod.children
local symbolLinkIndex = urlsMod.symbolLinkIndex
local rewriteSymbolLinks = urlsMod.rewriteSymbolLinks
local itemGroups = apiMod.itemGroups
local displayKind = apiMod.displayKind
local displaySignature = apiMod.displaySignature
local memberKind = apiMod.memberKind
local memberSpelling = apiMod.memberSpelling

local markdown = {}

-- Where a name reaches what documents it, for the length of one render. `anchors` holds
-- what this document renders, which is what a fragment can reach; `known` holds
-- everything the run documented, so a name this document does not carry is still told
-- apart from one nothing documents at all.
local anchors: Links? = nil
local known: Links? = nil

-- Prose an author wrote, as opposed to a signature the parser produced. Only prose is
-- searched for references: a signature is code, and `handlers[name](value)` in one is
-- an
-- index call rather than a link.
local function prose(text: string?): string
    local text = tostring(text or "")
    -- Its own binding: `anchors` is reassigned by a later run, and the callback
    -- would otherwise see it as whatever it may hold by then.
    local links = anchors
    if not links then
        return text
    end

    return rewriteSymbolLinks(text, function(name: string): string?
        return links[name] or known and known[name]
    end)
end

-- A table cell holding prose, which is the only kind of cell a reference can appear in:
-- the others hold a name or a type the parser read out of the source.
local function cell(text: string?): string
    return markdownCell(prose(text))
end

-- Markdown stops at `######`; a type nested deeply enough to reach it renders its own
-- sections at the same depth as its members rather than past the edge.
local function heading(level)
    return ("#"):rep(math.min(level, 6))
end

local function codeSpan(value: string): string
    local delimiter = "`"
    while value:find(delimiter, 1, true) do
        delimiter = delimiter .. "`"
    end
    if value:sub(1, 1) == "`" or value:sub(-1) == "`" then
        value = " " .. value .. " "
    end

    return delimiter .. value .. delimiter
end

-- What a declaration was annotated with, on its own line under the heading.
local function markdownAnnotations(out, annotations)
    if not annotations or #annotations == 0 then
        return
    end
    local marks = {}
    for index, annotation in ipairs(annotations) do
        marks[index] = codeSpan(annotation)
    end
    out[#out + 1] = table.concat(marks, " ")
    out[#out + 1] = ""
end

local function definition(out, term, description)
    out[#out + 1] = term
    local text = prose(description):gsub("\r\n?", "\n")
    local first = true
    for line in (text .. "\n"):gmatch("(.-)\n") do
        out[#out + 1] = (first and ":   " or "    ") .. line
        first = false
    end
end

local function markdownArguments(out, params, heading)
    if #params == 0 then
        return
    end
    out[#out + 1] = heading .. " Arguments"
    out[#out + 1] = ""
    for _, param in ipairs(params) do
        local spelled = (param.mode and (param.mode .. " ") or "") .. param.name
        definition(out, codeSpan(spelled) .. " - " .. codeSpan(param.type), param.text)
    end
    out[#out + 1] = ""
end

local function markdownReturns(out, returns, heading)
    if not apiMod.hasReturns(returns) then
        return
    end
    out[#out + 1] = heading .. " Returns"
    out[#out + 1] = ""
    for _, value in ipairs(returns) do
        definition(out, codeSpan(value.type), value.text)
    end
    out[#out + 1] = ""
end

-- A raise names the type `error` is called with and says what brings it about, so it
-- tabulates the way a result does: a reader comparing the ordinary exit with the
-- exceptional one reads the two tables the same way.
local function markdownRaises(out, raises, heading)
    if #raises == 0 then
        return
    end
    out[#out + 1] = heading .. " Raises"
    out[#out + 1] = ""
    out[#out + 1] = "| Type | Condition |"
    out[#out + 1] = "| --- | --- |"
    for _, raise in ipairs(raises) do
        out[#out + 1] = "| `" .. markdownEscape(raise.type) .. "` | " .. cell(raise.text) .. " |"
    end
    out[#out + 1] = ""
end

local function overloadAnchor(path, seen)
    local count = (seen[path] or 0) + 1
    seen[path] = count
    return count == 1 and path or path .. "-overload-" .. tostring(count)
end

-- The same compact, grouped overview a module uses, above the full member sections.
local type OverviewMember = {
    name: string,
    order: integer,
    text: string
}

local function byOverviewName(left: OverviewMember, right: OverviewMember): boolean
    local a, b = left.name:lower(), right.name:lower()
    return a == b and left.order < right.order or a < b
end

local function markdownMemberSummary(out, members, heading, title, path, supertypes)
    members = members or {}
    if #members == 0 and #(supertypes or {}) == 0 then
        return
    end
    for _, member in ipairs(members) do
        if member.name == (title or "Members"):lower() then
            out[#out + 1] = '<a id="' .. path .. '.members-overview"></a>'
            break
        end
    end
    local groups: {{
        title: string,
        entries: {OverviewMember}
    }} = {
        {title = "Methods", entries = {}},
        {title = "Constructors", entries = {}},
        {title = "Metamethods", entries = {}},
        {title = "Types", entries = {}},
        {title = "Fields", entries = {}},
    }
    local seen = {}
    for index, member in ipairs(members) do
        local path = overloadAnchor(member.path, seen)
        local group = groups[5]
        if member.isType or member.isAlias then
            group = groups[4]
        elseif member.isMetamethod then
            group = groups[3]
        elseif member.name == "constructor" then
            group = groups[2]
        elseif member.isFunction then
            group = groups[1]
        end
        group.entries[
            #group.entries + 1
        ] = {name = member.name, order = index, text = "[" .. codeSpan(member.name) .. "](#" .. path .. ")",}
    end
    local overview = {}
    local implemented = {}
    for _, supertype in ipairs(supertypes or {}) do
        local name = supertype:match("^([%w_.]+)") or supertype
        local owner = path:match("^(.*)%.[^.]+$")
        local target = anchors and (anchors[name] or owner and anchors[owner .. "." .. name]) or known and known[name]
        local label = codeSpan(supertype)
        implemented[#implemented + 1] = target and target ~= "" and "[" .. label .. "](" .. target .. ")" or label
    end
    if #implemented > 0 then
        overview[#overview + 1] = {title = "Implements", entries = implemented}
    end
    for _, group in ipairs(groups) do
        table.sort(group.entries, byOverviewName)
        local entries = {}
        for index, entry in ipairs(group.entries) do
            entries[index] = entry.text
        end
        overview[#overview + 1] = {title = group.title, entries = entries}
    end
    out[#out + 1] = markdown.overview(overview, heading, title or "Members")
end

-- Every member of a declaration, in the order it was written, each under a sub-heading
-- of its own naming what it is. A nested type recurses one level deeper, so a type
-- nested arbitrarily deep still gets real sub-headings instead of losing its members to
-- a flattened table.
local function renderMarkdownMembers(out, members, level)
    local hName, hSub = heading(level), heading(level + 1)
    local seen = {}
    for _, member in ipairs(members or {}) do
        local path = overloadAnchor(member.path, seen)
        local section = not member.isType and not member.isAlias
        if section then
            out[#out + 1] = "::: api-item " .. path
        end
        out[#out + 1] = '<a id="' .. path .. '"></a>'
        out[
            #out + 1
        ] = hName .. " `" .. member.name .. "` _" .. memberKind(member) .. "_" .. (member.lua and " _Lua_" or "")
        out[#out + 1] = ""
        -- A nested type's kind already spells its declaration, and what it holds is its
        -- own members below; only a field or a method has a type to show here.
        if not member.isType then
            out[#out + 1] = "```nupp"
            out[#out + 1] = memberSpelling(member)
            out[#out + 1] = "```"
            out[#out + 1] = ""
        end
        markdownAnnotations(out, member.annotations)
        if member.text ~= "" then
            out[#out + 1] = prose(member.text)
            out[#out + 1] = ""
        end
        markdownArguments(out, member.params, hSub)
        markdownReturns(out, member.returns, hSub)
        markdownRaises(out, member.raises, hSub)
        if member.isType then
            markdownMemberSummary(out, member.members, hSub, nil, path, member.supertypes)
            renderMarkdownMembers(out, member.members, level + 1)
        end
        if section then
            out[#out + 1] = ":::"
            out[#out + 1] = ""
        end
    end
end

local function renderMarkdownItem(out, item, level, bodyOnly, path)
    level = level or 3
    local h, hSub = heading(level), heading(level + 1)
    if not bodyOnly then
        out[#out + 1] = "::: api-item " .. (path or item.path)
        out[#out + 1] = '<a id="' .. (path or item.path) .. '"></a>'
        out[#out + 1] = h .. " `" .. item.name .. "` _" .. displayKind(item) .. "_" .. (item.lua and " _Lua_" or "")
        out[#out + 1] = ""
    end
    out[#out + 1] = "```nupp"
    out[#out + 1] = displaySignature(item)
    out[#out + 1] = "```"
    out[#out + 1] = ""
    if item.kind == "function" and item.readOnly then
        out[#out + 1] = "**Read-only binding.**"
        out[#out + 1] = ""
    end
    markdownAnnotations(out, item.annotations)
    if item.doc.text ~= "" then
        out[#out + 1] = prose(item.doc.text);
        out[#out + 1] = ""
    end
    if #item.typeargs > 0 then
        out[#out + 1] = hSub .. " Type parameters"
        out[#out + 1] = ""
        out[#out + 1] = "| Name | Description |"
        out[#out + 1] = "| --- | --- |"
        for _, typearg in ipairs(item.typeargs) do
            out[#out + 1] = "| `" .. markdownEscape(typearg.name) .. "` | " .. cell(typearg.text) .. " |"
        end
        out[#out + 1] = ""
    end
    markdownArguments(out, item.params, hSub)
    markdownReturns(out, item.returns, hSub)
    markdownRaises(out, item.raises, hSub)
    markdownMemberSummary(
        out,
        item.members,
        hSub,
        item.kind == "annotation" and "Values" or nil,
        path or item.path,
        item.supertypes
    )
    renderMarkdownMembers(out, item.members, level + 1)
    if not bodyOnly then
        out[#out + 1] = ":::"
        out[#out + 1] = ""
    end
end

--- Renders declarations as sections, for a page that writes its own headings around
--- them.
---
--- A module's page gets its headings from the module; a generated page that gathers
--- declarations from several files under headings of its own needs the same sections
--- without them, which is what this is. `level` is the depth an item's own name is
--- written at, so a page grouping under `##` passes 3.
---
--- @param items the declarations to render, in the order they should be read
--- @param level the heading depth of an item's name, 3 by default
--- @return the markdown, or the empty string when there is nothing to render
function markdown.items(items: {Item}, level: integer?, seen: {[string]: integer}?, legacy: boolean?): string
    local out = {}
    local seen = seen or {}
    for _, item in ipairs(items) do
        if legacy then
            local heading = "`" .. item.name .. "` _" .. displayKind(item) .. "_" .. (item.lua and " _Lua_" or "")
            local old = stringsMod.headingId(heading)
            if old ~= item.path then
                out[#out + 1] = '<span id="' .. old .. '"></span>'
            end
        end
        renderMarkdownItem(out, item, level or 3, false, overloadAnchor(item.path, seen))
    end

    return table.concat(out, "\n")
end

--- Renders a declaration for a reader which supplies its own section heading.
function markdown.itemBody(item: Item): string
    local out = {}
    renderMarkdownItem(out, item, 3, true)
    return table.concat(out, "\n")
end

-- A compact index is ordinary Markdown inside a layout directive. Its links
-- remain readable in the downloadable Markdown as well as on the site.
function markdown.overview(groups: {{
    title: string,
    entries: {string}
}}, h: string?, title: string?): string
    local ordered = {}
    for _, group in ipairs(groups) do
        table.insert(ordered, group.title == "Functions" and 1 or #ordered + 1, group)
    end
    local out = {(h or "##") .. " " .. (title or "Overview"), "", "::: api-overview"}
    local count = 0
    for _, group in ipairs(ordered) do
        if #group.entries > 0 then
            out[#out + 1] = "**" .. group.title:lower() .. "**"
            out[#out + 1] = ""
            for _, entry in ipairs(group.entries) do
                out[#out + 1] = "- " .. entry
                count = count + 1
            end
            out[#out + 1] = ""
        end
    end
    if count == 0 then
        return ""
    end
    out[#out + 1] = ":::"
    out[#out + 1] = ""

    return table.concat(out, "\n")
end

function markdown.moduleOverview(module: Module, all: {Module}, prefix: string?): string
    local groups: {{
        title: string,
        entries: {string}
    }} = {}
    local children = childModules(all, module.name)
    if #children > 0 then
        local entries: {string} = {}
        for _, child in ipairs(children) do
            local name = child.name:sub(#module.name + 2)
            local label = codeSpan(name)
            local target = prefix and prefix .. urlsMod.moduleFile(child.name) or anchors and anchors[child.name]
            entries[#entries + 1] = target and "[" .. label .. "](" .. target .. ")" or label
        end
        groups[#groups + 1] = {title = "Submodules", entries = entries}
    end
    local tail = module.name:match("([^.]+)$") or module.name
    for _, group in ipairs(itemGroups(module.items)) do
        local entries: {string} = {}
        local seen: {[string]: boolean} = {}
        for _, item in ipairs(group.items) do
            if not seen[item.path] then
                seen[item.path] = true
                local name = item.name
                if name:sub(1, #tail + 1) == tail .. "." then
                    name = name:sub(#tail + 2)
                end
                entries[#entries + 1] = "[" .. codeSpan(name) .. "](#" .. item.path .. ")"
            end
        end
        groups[#groups + 1] = {title = group.title, entries = entries}
    end

    return markdown.overview(groups)
end

--- Renders modules as a markdown document.
---
--- `all` is every module the run documented. A page renders one module at a time but
--- still has to name the ones nested under it, and only the whole set says which those
--- are; rendering the whole set at once, as `nupp doc --kind markdown` does, is the
--- case where the two arguments are the same list.
---
--- `overview` is the handwritten prose a page opens with, which is why it only makes
--- sense for a single module: it belongs to a page rather than to the set.
function markdown.render(
    modules: {Module},
    title: string?,
    all: {Module}?,
    overview: string?,
    prefix: string?,
    siteLinks: Links?
): string
    local all = all or modules
    anchors = symbolLinkIndex(modules, function(module: string, path: string?): string
        if prefix then
            return prefix .. urlsMod.moduleFile(module) .. (path and "#" .. path or "")
        end
        return "#" .. (path or module)
    end)
    known = siteLinks or symbolLinkIndex(all, function(module: string, path: string?): string
        if prefix then
            return prefix .. urlsMod.moduleFile(module) .. (path and "#" .. path or "")
        end
        return ""
    end)
    local out = {}
    if title and title ~= "" then
        out[#out + 1] = "# " .. title;
        out[#out + 1] = ""
    end
    local seen = {}
    for moduleIndex, module in ipairs(modules) do
        local rootDeclaration = false
        for _, item in ipairs(module.items) do
            rootDeclaration = rootDeclaration or item.path == module.name
        end
        out[#out + 1] = '<a id="' .. module.name .. (rootDeclaration and "-module" or "") .. '"></a>'
        out[#out + 1] = "# `" .. module.name .. "`"
        out[#out + 1] = ""
        -- An overview is what the author wanted said here, so it replaces the line that
        -- stands in for one rather than repeating the subject above it.
        if overview and overview ~= "" then
            out[#out + 1] = overview
            out[#out + 1] = ""
            if module.text ~= "" then
                out[#out + 1] = prose(module.text)
                out[#out + 1] = ""
            end
        elseif module.namespace then
            out[#out + 1] = "Modules nested under `" .. module.name .. "`. Nothing is required by this name itself."
            out[#out + 1] = ""
        elseif module.text ~= "" then
            out[#out + 1] = prose(module.text);
            out[#out + 1] = ""
        end
        out[#out + 1] = markdown.moduleOverview(module, all, prefix)
        for _, group in ipairs(itemGroups(module.items)) do
            if #group.items > 0 then
                out[#out + 1] = "::: api-group"
                if group.path == module.name then
                    out[#out + 1] = '<a id="' .. group.path .. '-group"></a>'
                end
                out[#out + 1] = "## " .. group.title
                out[#out + 1] = ""
                for _, item in ipairs(group.items) do
                    renderMarkdownItem(out, item, nil, false, overloadAnchor(item.path, seen))
                end
                out[#out + 1] = ":::"
                out[#out + 1] = ""
            end
        end
        if moduleIndex < #modules then
            out[#out + 1] = "---";
            out[#out + 1] = ""
        end
    end
    anchors, known = nil, nil

    return table.concat(out, "\n") .. "\n"
end

export = markdown
