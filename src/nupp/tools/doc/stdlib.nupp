--[[
Extracts LuaJIT declarations into module documentation and a library index.

The module pages combine the compiler's builtin declarations with the APIs
implemented in Nupp. The index keeps globals, intrinsic types, and links to
those shared pages.
]]
module nupp.tools.doc.stdlib

local bundledMod = require("nupp.compiler.bundled")
local extractMod = require("nupp.tools.doc.extract")
local markdownMod = require("nupp.tools.doc.markdown")
local stringsMod = require("nupp.tools.doc.strings")
local urlsMod = require("nupp.tools.doc.urls")
local annotationapi = require("nupp.tools.doc.annotationapi")

--- A declaration and its nested members, linked to the generated index.
export record Entry
    name: string
    path: string
    items: {Entry}?
    module: string?
    kind: string?
end

--- The builtin libraries, globals, and intrinsic types extracted for navigation.
export type Navigation = {
    libraries: {Entry},
    globals: {Entry},
    types: {Entry},
    annotations: {Entry}?
}

--- The generated page: the route it is written to, its title, and its markdown.
export type Page = {
    markdown: string,
    path: string,
    redirects: {string}?,
    source: string?,
    symbols: {[string]: string}?,
    title: string,
    navigation: Navigation?,
    modules: {extractMod.Module},
    indexModules: {extractMod.Module}?,
    globalItems: {extractMod.Item},
    typeItems: {extractMod.Item},
    annotationItems: {extractMod.Item}
}

--- Where a manifest asked the page to live, and what to call it.
export type Settings = {
    path: string?,
    title: string?
}

--- A declaration file the page renders, and how a program reaches what it declares.
---
--- `required` is the name that loads it, and its absence is what says the declarations
--- are intrinsic: the prelude's globals are there before a program asks for anything.
local record Source
    file: string
    required: string?
end

-- The compiler's own declarations, in reading order. Paths are the ones
-- [](nupp.compiler.bundled.source) answers to, so a stamped binary renders the same
-- page as a checkout without either knowing which it is.
local SOURCES: {
    Source
} = {
    new Source(file = "/decls/lua.d.nupp"),
    new Source(file = "/decls/prelude.d.nupp"),
    new Source(file = "/decls/ffi.d.nupp", required = "ffi"),
    new Source(file = "/decls/stringbuffer.d.nupp", required = "string.buffer"),
    new Source(file = "/decls/jit/util.d.nupp", required = "jit.util"),
    new Source(file = "/decls/jit/profile.d.nupp", required = "jit.profile"),
    new Source(file = "/decls/jit/zone.d.nupp", required = "jit.zone"),
    new Source(file = "/decls/jit/vmdef.d.nupp", required = "jit.vmdef"),
}

-- Lua standard-library names from the Lua 5.1 through 5.5 manual indexes.
-- https://www.lua.org/manual/5.5/contents.html (and the 5.1 through 5.4 editions).
-- https://www.lua.org/manual/5.0/manual.html#5.1 documents gcinfo;
-- https://www.lua.org/source/5.1/lbaselib.c.html installs newproxy. The public
-- path identifies the API even when its implementation belongs to Nupp.
local LUA_NAMES = {
    ["io.File.close"] = true,
    ["io.File.flush"] = true,
    ["io.File.lines"] = true,
    ["io.File.read"] = true,
    ["io.File.seek"] = true,
    ["io.File.setvbuf"] = true,
    ["io.File.write"] = true,
    ["assert"] = true,
    ["bit32.arshift"] = true,
    ["bit32.band"] = true,
    ["bit32.bnot"] = true,
    ["bit32.bor"] = true,
    ["bit32.btest"] = true,
    ["bit32.bxor"] = true,
    ["bit32.extract"] = true,
    ["bit32.lrotate"] = true,
    ["bit32.lshift"] = true,
    ["bit32.replace"] = true,
    ["bit32.rrotate"] = true,
    ["bit32.rshift"] = true,
    ["collectgarbage"] = true,
    ["coroutine.close"] = true,
    ["coroutine.create"] = true,
    ["coroutine.isyieldable"] = true,
    ["coroutine.resume"] = true,
    ["coroutine.running"] = true,
    ["coroutine.status"] = true,
    ["coroutine.wrap"] = true,
    ["coroutine.yield"] = true,
    ["debug.debug"] = true,
    ["debug.getfenv"] = true,
    ["debug.gethook"] = true,
    ["debug.getinfo"] = true,
    ["debug.getlocal"] = true,
    ["debug.getmetatable"] = true,
    ["debug.getregistry"] = true,
    ["debug.getupvalue"] = true,
    ["debug.getuservalue"] = true,
    ["debug.setfenv"] = true,
    ["debug.sethook"] = true,
    ["debug.setlocal"] = true,
    ["debug.setmetatable"] = true,
    ["debug.setupvalue"] = true,
    ["debug.setuservalue"] = true,
    ["debug.traceback"] = true,
    ["debug.upvalueid"] = true,
    ["debug.upvaluejoin"] = true,
    ["dofile"] = true,
    ["error"] = true,
    ["gcinfo"] = true,
    ["getfenv"] = true,
    ["getmetatable"] = true,
    ["io.close"] = true,
    ["io.flush"] = true,
    ["io.input"] = true,
    ["io.lines"] = true,
    ["io.open"] = true,
    ["io.output"] = true,
    ["io.popen"] = true,
    ["io.read"] = true,
    ["io.tmpfile"] = true,
    ["io.type"] = true,
    ["io.write"] = true,
    ["ipairs"] = true,
    ["load"] = true,
    ["loadfile"] = true,
    ["loadstring"] = true,
    ["math.abs"] = true,
    ["math.acos"] = true,
    ["math.asin"] = true,
    ["math.atan"] = true,
    ["math.atan2"] = true,
    ["math.ceil"] = true,
    ["math.cos"] = true,
    ["math.cosh"] = true,
    ["math.deg"] = true,
    ["math.exp"] = true,
    ["math.floor"] = true,
    ["math.fmod"] = true,
    ["math.frexp"] = true,
    ["math.ldexp"] = true,
    ["math.log"] = true,
    ["math.log10"] = true,
    ["math.max"] = true,
    ["math.min"] = true,
    ["math.modf"] = true,
    ["math.pow"] = true,
    ["math.rad"] = true,
    ["math.random"] = true,
    ["math.randomseed"] = true,
    ["math.sin"] = true,
    ["math.sinh"] = true,
    ["math.sqrt"] = true,
    ["math.tan"] = true,
    ["math.tanh"] = true,
    ["math.tointeger"] = true,
    ["math.type"] = true,
    ["math.ult"] = true,
    ["module"] = true,
    ["newproxy"] = true,
    ["next"] = true,
    ["os.clock"] = true,
    ["os.date"] = true,
    ["os.difftime"] = true,
    ["os.execute"] = true,
    ["os.exit"] = true,
    ["os.getenv"] = true,
    ["os.remove"] = true,
    ["os.rename"] = true,
    ["os.setlocale"] = true,
    ["os.time"] = true,
    ["os.tmpname"] = true,
    ["package.loadlib"] = true,
    ["package.searchpath"] = true,
    ["package.seeall"] = true,
    ["pairs"] = true,
    ["pcall"] = true,
    ["print"] = true,
    ["rawequal"] = true,
    ["rawget"] = true,
    ["rawlen"] = true,
    ["rawset"] = true,
    ["require"] = true,
    ["select"] = true,
    ["setfenv"] = true,
    ["setmetatable"] = true,
    ["string.byte"] = true,
    ["string.char"] = true,
    ["string.dump"] = true,
    ["string.find"] = true,
    ["string.format"] = true,
    ["string.gmatch"] = true,
    ["string.gsub"] = true,
    ["string.len"] = true,
    ["string.lower"] = true,
    ["string.match"] = true,
    ["string.pack"] = true,
    ["string.packsize"] = true,
    ["string.rep"] = true,
    ["string.reverse"] = true,
    ["string.sub"] = true,
    ["string.unpack"] = true,
    ["string.upper"] = true,
    ["table.concat"] = true,
    ["table.create"] = true,
    ["table.insert"] = true,
    ["table.maxn"] = true,
    ["table.move"] = true,
    ["table.pack"] = true,
    ["table.remove"] = true,
    ["table.sort"] = true,
    ["table.unpack"] = true,
    ["tonumber"] = true,
    ["tostring"] = true,
    ["type"] = true,
    ["unpack"] = true,
    ["utf8.char"] = true,
    ["utf8.codepoint"] = true,
    ["utf8.codes"] = true,
    ["utf8.len"] = true,
    ["utf8.offset"] = true,
    ["warn"] = true,
    ["xpcall"] = true,
}

local function markLua(items)
    for _, item in ipairs(items or {}) do
        local callable = item.kind == "function" or item.isFunction or item.kind == "variable"
        if LUA_NAMES[item.path] and callable then
            item.lua = true
        end
        markLua(item.members)
    end
end

local INTRO = "The API reference includes Lua functions and the libraries implemented in Nupp. "
    .. "Each module page documents both in one place; a Lua badge identifies functions with Lua API names."

local FUNCTIONS = "These functions are available without a require."
local GLOBALS = "These global variables are available without a require."

local TYPES = "The types the declarations above name in their signatures. They are "
    .. "written by the prelude rather than by a program, which is why they have no "
    .. "module of their own to be documented from."

-- A value is a global, a type is a type, and everything else on this page is a library
-- of its own. `item.module` is set on a declaration whose name qualifies it into
-- another module -- a prelude-qualified record belongs to its owning namespace
-- -- and that module documents it already.
local function isGlobal(item: extractMod.Item): boolean
    return not item.module and (item.kind == "function" or item.kind == "variable")
end

local function isType(item: extractMod.Item): boolean
    return not item.module and item.kind ~= "function" and item.kind ~= "variable"
end

local function only(items: {extractMod.Item}, wanted: function(extractMod.Item): boolean): {extractMod.Item}
    local kept = {}
    for _, item in ipairs(items) do
        if wanted(item) then
            kept[#kept + 1] = item
        end
    end

    return kept
end

local function relocateMembers(value: any): nil
    for _, member in ipairs(value.members or {}) do
        member.path = value.path .. "." .. member.name
        relocateMembers(member)
    end
end

-- A global's anchor is the name a program writes. `print` is not a member of the file
-- that declares it, and a link that said so would be naming an implementation detail a
-- reader has no other reason to learn. The types the prelude declares are named the
-- same way, for the same reason.
local function anchorByName(items: {extractMod.Item})
    for _, item in ipairs(items) do
        item.path = item.name
        relocateMembers(item)
    end
end

-- A declaration file's library is the record it hands back, and the binding underneath
-- it -- `local util: JitUtil` -- adds a second entry that repeats the first. The record
-- carries the documentation, so the binding goes.
local function withoutRedeclaredBindings(items: {extractMod.Item}): {extractMod.Item}
    local types: {[string]: boolean} = {}
    for _, item in ipairs(items) do
        if isType(item) then
            types[item.name] = true
        end
    end

    return only(items, function(item: extractMod.Item): boolean
        return not (item.kind == "variable" and types[item.signature:match(": ([%w_]+)$") or ""])
    end)
end

--- A section of the generated index, with declarations kept as structured items.
export type IndexPart = {
    markdown: string,
    items: {extractMod.Item}?
}

-- Keep declaration paths beside the labels before qualification changes their
-- displayed names. The same extracted items write the body and the navigation.
local function navigationItems(items: {any}): {Entry}
    local entries: {Entry} = {}
    for _, item in ipairs(items) do
        entries[
            #entries + 1
        ] = new Entry(name = item.name, path = item.path, items = navigationItems(item.members or {}), kind = item.kind)
    end

    return entries
end

local function libraryEntry(module: extractMod.Module): Entry
    return new Entry(
        name = module.name,
        path = stringsMod.headingId(module.name),
        items = navigationItems(module.items),
        module = module.name
    )
end

export function indexParts(document: Page): {IndexPart}
    local parts: {IndexPart} = {{markdown = "# " .. document.title .. "\n\n" .. INTRO .. "\n"}}
    local prefix = urlsMod.relativePrefix(urlsMod.routeFile(document.path))
    local owners, kinds = {}, {}
    for _, entry in ipairs(document.navigation and document.navigation.globals or {}) do
        kinds[entry.name] = entry.kind
        if entry.module then
            owners[entry.name] = entry.module
        end
    end
    local functions, globals = {}, {}
    local functionLinks, globalLinks = {}, {}
    for _, item in ipairs(document.globalItems) do
        local owner = owners[item.name]
        local isFunction = item.kind == "function" or kinds[item.name] == "function"
        local items = isFunction and functions or globals
        local links = isFunction and functionLinks or globalLinks
        if owner then
            links[#links + 1] = '<a id="' .. item.path .. '"></a>'
            links[
                #links + 1
            ] = "- [`" .. item.name .. "`](" .. prefix .. urlsMod.moduleFile(owner) .. "#" .. item.path .. ")"
        else
            items[#items + 1] = item
        end
    end
    local overview: {{
        title: string,
        entries: {string}
    }} = {}
    local moduleEntries: {string} = {}
    local sortedModules: {extractMod.Module} = {}
    for _, module in ipairs(document.indexModules or document.modules) do
        sortedModules[#sortedModules + 1] = module
    end
    table.sort(sortedModules, function(left: extractMod.Module, right: extractMod.Module): boolean
        return left.name:lower() < right.name:lower()
    end)
    for _, module in ipairs(sortedModules) do
        moduleEntries[
            #moduleEntries + 1
        ] = "[`" .. module.name .. "`](" .. prefix .. urlsMod.moduleFile(module.name) .. ")"
    end
    overview[#overview + 1] = {title = "Modules", entries = moduleEntries}

    local function overviewItems(
        title: string,
        items: {extractMod.Item},
        filter: function(extractMod.Item): boolean
    ): nil
        local entries: {string} = {}
        local sorted: {extractMod.Item} = {}
        for _, item in ipairs(items) do
            if filter(item) then
                sorted[#sorted + 1] = item
            end
        end
        table.sort(sorted, function(left: extractMod.Item, right: extractMod.Item): boolean
            local a, b = left.name:lower(), right.name:lower()
            return a == b and left.path < right.path or a < b
        end)
        for _, item in ipairs(sorted) do
            local target = owners[item.name] and prefix .. urlsMod.moduleFile(owners[item.name]) .. "#" .. item.path
                or "#" .. item.path
            entries[#entries + 1] = "[`" .. item.name .. "`](" .. target .. ")"
        end
        overview[#overview + 1] = {title = title, entries = entries}
    end

    overviewItems("Functions", document.globalItems, function(item: extractMod.Item): boolean
        return item.kind == "function" or kinds[item.name] == "function"
    end)
    overviewItems("Globals", document.globalItems, function(item: extractMod.Item): boolean
        return item.kind ~= "function" and kinds[item.name] ~= "function"
    end)
    overviewItems("Types", document.typeItems, function(): boolean
        return true
    end)
    overviewItems("Annotations", document.annotationItems, function(): boolean
        return true
    end)
    parts[#parts + 1] = {markdown = markdownMod.overview(overview)}

    local function addSection(title: string, text: string, items: {extractMod.Item}, links: {string}?): nil
        if #items == 0 and (not links or #links == 0) then
            return
        end
        parts[#parts + 1] = {markdown = "## " .. title .. "\n\n" .. text .. "\n", items = items}
        if links and #links > 0 then
            parts[#parts + 1] = {markdown = table.concat(links, "\n")}
        end
    end

    addSection("Functions", FUNCTIONS, functions, functionLinks)
    addSection("Globals", GLOBALS, globals, globalLinks)
    addSection("Types", TYPES, document.typeItems)
    addSection(
        "Annotations",
        "Annotations carry checked, type-erased metadata. "
        .. "File directives use `@!name` and occupy a separate namespace.",
        document.annotationItems
    )

    return parts
end

local function indexMarkdown(document: Page): string
    local out = {}
    for _, part in ipairs(indexParts(document)) do
        out[#out + 1] = part.markdown
        if part.items then
            out[#out + 1] = markdownMod.items(part.items, nil, nil, true)
        end
    end

    return table.concat(out, "\n")
end

--- Extracts the standard libraries and their index from the compiler's declarations.
export function page(settings: Settings?): Page?
    if not settings then
        return nil
    end
    local types: {extractMod.Item} = {}
    local globals: {extractMod.Item} = {}
    local modules: {extractMod.Module} = {}
    local qualified: {extractMod.Item} = {}
    local annotationItems = annotationapi.items()
    local navigation: Navigation = {
        libraries = {},
        globals = {},
        types = {},
        annotations = navigationItems(annotationItems)
    }
    for _, source in ipairs(SOURCES) do
        local text = bundledMod.source(source.file)
        if text then
            local path = source.file:gsub("^/", "")
            local module, _, libraries = extractMod.extract(text, path, source.required or "globals", {
                shapesAsModules = source.required == nil,
                returnedAsModule = source.required ~= nil,
                publicNames = source.file == "/decls/lua.d.nupp" and {_G = true, _VERSION = true} or nil
            })
            if module then
                for _, item in ipairs(module.items) do
                    if item.module then
                        qualified[#qualified + 1] = item
                    end
                end
                if source.required then
                    module.items = withoutRedeclaredBindings(module.items)
                    module.path = nil
                    modules[#modules + 1] = module
                    navigation.libraries[#navigation.libraries + 1] = libraryEntry(module)
                else
                    local declaredGlobals = only(module.items, isGlobal)
                    anchorByName(declaredGlobals)
                    for _, item in ipairs(declaredGlobals) do
                        if item.kind == "function" and item.signature:match("^const%s") then
                            item.readOnly = true
                        end
                        globals[#globals + 1] = item
                    end
                    for _, entry in ipairs(navigationItems(declaredGlobals)) do
                        navigation.globals[#navigation.globals + 1] = entry
                    end
                    for _, item in ipairs(only(module.items, isType)) do
                        types[#types + 1] = item
                    end
                end
            end
            for _, library in ipairs(libraries or {}) do
                library.path = nil
                modules[#modules + 1] = library
                navigation.libraries[#navigation.libraries + 1] = libraryEntry(library)
            end
        end
    end
    -- Callable namespaces may have no shape declaration to create their page.
    -- Keep qualified types with their namespace in either case.
    local byModule: {[string]: extractMod.Module} = {}
    for _, library in ipairs(modules) do
        byModule[library.name] = library
    end
    local callableTypes: {[string]: extractMod.Member} = {}
    for _, item in ipairs(qualified) do
        local name = item.module as string
        for _, member in ipairs(item.members or {}) do
            if member.isMetamethod and member.name == "__call" then
                callableTypes[name .. "." .. item.name] = member
            end
        end
        local library = byModule[name]
        if not library then
            library = {name = name, text = "", items = {}}
            byModule[name] = library
            modules[#modules + 1] = library
            navigation.libraries[#navigation.libraries + 1] = libraryEntry(library)
        end
        item.path = name .. "." .. item.name
        relocateMembers(item)
        library.items[#library.items + 1] = item
    end
    for _, item in ipairs(globals) do
        local typeName = item.signature:match(":%s*([%w_.]+)%s*$")
        local call = typeName and callableTypes[typeName] or nil
        local signature = call and extractMod.callSignature(call.type) or nil
        if item.kind == "variable" and call and signature then
            item.kind = "function"
            item.signature = signature
            item.params = {}
            for index = 2, #call.params do
                if call.params[index].name ~= "?" then
                    item.params[#item.params + 1] = call.params[index]
                end
            end
            item.returns = call.returns
            item.forms = extractMod.callForms(call.forms)
            item.typeargs = call.typeargs or {}
            for _, entry in ipairs(navigation.globals) do
                if entry.name == item.name then
                    entry.kind = "function"
                end
            end
        end
    end
    table.sort(globals, function(left: extractMod.Item, right: extractMod.Item): boolean
        return left.name:lower() < right.name:lower()
    end)
    table.sort(navigation.globals, function(left: Entry, right: Entry): boolean
        return left.name:lower() < right.name:lower()
    end)
    anchorByName(types)
    navigation.types = navigationItems(types)
    markLua(globals)
    markLua(types)
    for _, library in ipairs(modules) do
        markLua(library.items)
    end
    local symbols: {[string]: string} = {warn = "warn"}
    for _, item in ipairs(types) do
        symbols[item.name] = item.path
    end
    for _, item in ipairs(annotationItems) do
        symbols[item.name] = item.path
    end
    local document: Page = {
        path = settings.path or "api",
        title = settings.title or "API reference",
        markdown = "",
        symbols = symbols,
        navigation = navigation,
        modules = modules,
        globalItems = globals,
        typeItems = types,
        annotationItems = annotationItems
    }
    document.markdown = indexMarkdown(document)

    return document
end

--- Combines builtin declarations with the source-owned module for the same name.
export function merge(modules: {extractMod.Module}, document: Page?): nil
    if not document then
        return
    end
    local byName = {}
    for _, module in ipairs(modules) do
        byName[module.name] = module
    end

    local function mergeItems(owned, builtin)
        local merged, byPath = {}, {}

        local function append(item, fromBuiltin)
            local key = item.path
            local held = byPath[key]
            -- Distinct authored overloads all remain visible. An ambient declaration
            -- contributes prose and provenance, never another source-owned signature.
            if held and not fromBuiltin then
                local variant = item.type and item.type ~= held.type and item.type
                    or held.kind == "function"
                    and item.kind == "function"
                    and item.signature ~= held.signature
                    and item.signature
                    or nil
                if variant then
                    key = key .. "\0" .. variant
                    held = byPath[key]
                end
            end
            if held then
                local replace = (held.kind == "type" and item.kind ~= "type" and item.kind ~= "variable")
                    or (held.kind == "variable" and item.kind == "function")
                    or (held.isModuleCall and fromBuiltin and item.kind == "function")
                if replace then
                    for key, value in pairs(item) do
                        if key ~= "doc" and key ~= "members" then
                            held[key] = value
                        end
                    end
                end
                held.lua = held.lua or item.lua
                if held.doc and item.doc and held.doc.text == "" then
                    held.doc = item.doc
                end
                if held.text == "" and item.text then
                    held.text = item.text
                end
                if item.members and #item.members > 0 then
                    held.members = held.members or {}
                    mergeItems(held.members, item.members)
                end
            else
                merged[#merged + 1] = item
                byPath[key] = item
            end
        end

        for _, item in ipairs(owned) do
            append(item, false)
        end
        for _, item in ipairs(builtin) do
            append(item, true)
        end
        for index = #owned, 1, -1 do
            owned[index] = nil
        end
        for index, item in ipairs(merged) do
            owned[index] = item
        end
    end

    -- Globals with an owned facade retain their actual callable or array declaration
    -- on that page. The index and the Globals navigation only link to it.
    for _, item in ipairs(document.globalItems) do
        local owner = byName[item.name]
        if owner and not owner.namespace then
            mergeItems(owner.items, {item})
            for _, entry in ipairs(document.navigation and document.navigation.globals or {}) do
                if entry.name == item.name then
                    entry.module = owner.name
                end
            end
        end
    end
    for _, builtin in ipairs(document.modules) do
        local owned = byName[builtin.name]
        if owned then
            mergeItems(owned.items, builtin.items)
            if owned.text == "" then
                owned.text = builtin.text
            end
            owned.namespace = nil
        else
            modules[#modules + 1] = builtin
            byName[builtin.name] = builtin
        end
    end

    local function itemOrder(left, right)
        if left.kind ~= right.kind then
            return left.kind < right.kind
        end
        return left.name < right.name
    end

    -- A callable namespace is both a module and a function. Its parent's
    -- documented function also belongs on the namespace's own page.
    for _, parent in ipairs(modules) do
        for _, item in ipairs(parent.items) do
            local target = byName[item.path]
            if item.kind == "function" and target and target ~= parent then
                local copy: any = {}
                for key, value in pairs(item) do
                    copy[key] = value
                end
                copy.name = target.name:match("([^.]+)$") or target.name
                mergeItems(target.items, {copy})
            end
        end
    end
    -- A projected `__call` is the call to the module itself. Keep its old
    -- anchor on that page and expose the call on its parent as well.
    for _, module in ipairs(modules) do
        local parentName = module.name:match("^(.*)%.[^.]+$")
        local parent = parentName and byName[parentName] or nil
        if parent then
            for _, item in ipairs(module.items) do
                if item.kind == "function"
                    and (item.path == module.name .. ".__call" or item.isModuleCall and item.path == module.name)
                then
                    local found = false
                    for _, existing in ipairs(parent.items) do
                        if existing.kind == "function" and existing.name == item.name then
                            found = true
                            break
                        end
                    end
                    if not found then
                        local copy: any = {}
                        for key, value in pairs(item) do
                            copy[key] = value
                        end
                        mergeItems(parent.items, {copy})
                    end
                end
            end
        end
    end
    for _, module in ipairs(modules) do
        mergeItems(module.items, {})
        markLua(module.items)
        table.sort(module.items, itemOrder)
    end
    table.sort(modules, function(left, right)
        return left.name < right.name
    end)
    document.indexModules = modules
    document.markdown = indexMarkdown(document)
end
