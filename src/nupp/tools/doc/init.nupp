--[[
Fast, CST-native API documentation.

Documentation deliberately stops after parsing. The lossless CST already contains
declaration structure, source locations, types, and doc trivia, so invoking the
checker would add work without improving the rendered API.

A long comment at the very top of a file, this one included, is that file's module
documentation, and is rendered as markdown.
]]
module nupp.tools.doc

const {type LexError} = require("nupp.compiler.syntax.lexer")
const {type Module} = require("nupp.tools.doc.extract")
const {type Page as Page2} = require("nupp.tools.doc.urls")
const {type Param} = require("nupp.tools.doc.extract")
const {type Result} = require("nupp.tools.doc.extract")
const {type Raise} = require("nupp.compiler.syntax.docblock")
const {type Member} = require("nupp.tools.doc.extract")
const {type Links} = require("nupp.tools.doc.urls")
const {type Config as Config2} = require("nupp.tools.build.manifest")
const {type Target} = require("nupp.tools.build.manifest")

local stringsMod = require("nupp.tools.doc.strings")
local filesMod = require("nupp.tools.doc.files")
local extractMod = require("nupp.tools.doc.extract")
local lexerMod = require("nupp.compiler.syntax.lexer")
local markdownMod = require("nupp.tools.doc.markdown")
local highlightMod = require("nupp.tools.doc.highlight")
local htmlMod = require("nupp.tools.doc.html")
local assetsMod = require("nupp.tools.doc.assets")
local urlsMod = require("nupp.tools.doc.urls")
local apiMod = require("nupp.tools.doc.api")
local pageMod = require("nupp.tools.doc.page")
local collectionMod = require("nupp.tools.doc.collection")
local sweepMod = require("nupp.tools.doc.sweep")
local homeMod = require("nupp.tools.doc.home")
local frontmatterMod = require("nupp.tools.doc.frontmatter")
local diagnosticsMod = require("nupp.tools.doc.diagnostics")
local stdlibMod = require("nupp.tools.doc.stdlib")
local json = require("serde.json")
local sortedJson = require("nupp.tools.internal.sortedjson").encode

local trim, htmlEscape = stringsMod.trim, stringsMod.htmlEscape
local escapeJs = stringsMod.escapeJs
local normalize, join, dirname = filesMod.normalize, filesMod.join, filesMod.dirname
local readFile, writeFile = filesMod.readFile, filesMod.writeFile
local listFiles, privateSource = filesMod.listFiles, filesMod.privateSource
local copyPublicFiles = filesMod.copyPublicFiles
local moduleName, childModules = extractMod.moduleName, extractMod.children
local namespaceModules = extractMod.namespaces
local internalModuleName = extractMod.internalModuleName
local configureScintillua = highlightMod.configureScintillua
local markdownHtml, markdownOutline = htmlMod.markdownHtml, htmlMod.markdownOutline
local THEME, SCRIPT = assert(assetsMod.theme()), assetsMod.SCRIPT
local moduleFile, routeFile = urlsMod.moduleFile, urlsMod.routeFile
local relativePrefix, cleanRoute = urlsMod.relativePrefix, urlsMod.cleanRoute
local symbolLinkIndex, symbolLinks = urlsMod.symbolLinkIndex, urlsMod.symbolLinks
local rewriteConfiguredPageLinks = urlsMod.rewriteConfiguredPageLinks
local itemGroups = apiMod.itemGroups
local renderPage, homeHero, homeFeatures = pageMod.render, pageMod.homeHero, pageMod.homeFeatures

local doc = {}

----------------------------------------------------------------------------
-- What a site is built from
----------------------------------------------------------------------------

--- A page a manifest configured. `path` is the route it is written to; `source` is
--- the markdown read into it.
---
--- `glob` names the files instead of the routes, and the entry then stands for every
--- markdown file it matches: a page's route is where it sits, its title is its heading,
--- and the rest is what the page itself says in frontmatter. `base` is the directory
--- routes are named from and `exclude` drops files the tree holds and the site does not
--- publish.
---
--- `directory` names a whole directory of markdown instead of one file, and the entry
--- then stands for every document in it plus a generated index at `path`. A collection
--- grows by writing a file, which is the point, and so does a tree: a manifest that had
--- to name each document would fail silently the first time someone forgot.
type doc.Page = {
    base: string?,
    directory: string?,
    exclude: {string}?,
    glob: (string | {string})?,
    layout: string?,
    path: string?,
    redirects: {string}?,
    source: string?,
    title: string?
}

local type BuiltPage = {
    path: string,
    title: string,
    source: string?,
    layout: string?,
    redirects: {string}?,
    markdown: string?,
    module: Module?,
    overview: string?,
    symbols: {[string]: string}?,
    api: boolean?,
    navigationTitle: string?,
    navigation: stdlibMod.Navigation?,
    unlisted: boolean?,
    heroText: string?,
    heroTitle: string?,
    heroContent: string?,
    heroImage: string?,
    heroImageAlt: string?,
    heroActions: {{
        path: string?,
        text: string,
        theme: string?
    }}?,
    features: {{
        code: string?,
        codeLanguage: string?,
        details: string?,
        icon: string?,
        image: string?,
        imageAlt: string?,
        title: string
    }}?
}
local type SearchEntry = {
    title: string,
    url: string,
    text: string
}

--- What a manifest configured documentation to do. A build target of kind `docs` is
--- read as one of these too, which is why `kind` and `targetName` are here.
type doc.Settings = {
    customCss: string?,
    description: string?,
    diagnostics: diagnosticsMod.Settings?,
    favicon: string?,
    format: string?,
    github: string?,
    includePrivate: boolean?,
    kind: string?,
    lexers: string?,
    logo: string?,
    name: string?,
    outDir: string?,
    pages: {doc.Page}?,
    public: string?,
    sources: {string}?,
    stdlib: stdlibMod.Settings?,
    targetName: string?,
    title: string?
}

--- A page the compiler generated: the route it asked for, its title, and its
--- markdown. Both the diagnostic index and the standard library index return
--- one of these, because a page assembled from what the compiler knows is
--- configured by nothing but where it should live. `source` names the
--- handwritten file a generated page opens with, so a link written against that
--- path still resolves.
type doc.Generated = {
    markdown: string,
    path: string,
    redirects: {string}?,
    source: string?,
    symbols: {[string]: string}?,
    title: string
}

--- The manifest, as much of it as documentation reads.
type doc.Config = {
    build: {
        --- Which target the build runs by default, which is also which docs target
        --- `nupp doc` renders when a manifest declares more than one.
        default: string?,
        targets: {[string]: doc.Settings}?
    }?,
    docs: doc.Settings?,
    include: {string}?,
    name: string?
}

--- What a
--- counterpart in the settings, and `written` collects the paths the run wrote.
type doc.BuildOptions = {
    checkOnly: boolean?,
    format: string?,
    output: string?,
    sources: {string}?,
    title: string?,
    written: {string}?,

    --- Where a `--json` run gathers why it stopped, instead of stderr.
    diagnostics: {any}?
}

----------------------------------------------------------------------------
-- Extracting one file
----------------------------------------------------------------------------

--- Reads a source file as its documented declarations. Returns the module, or nil and
--- the parse errors that stopped it. A third result carries the modules an `@namespace`
--- declaration implied, empty when the file held none.
function doc.extract(
    source: string,
    path: string?,
    name: string,
    opts: extractMod.Options?
): extractMod.Module?, {LexError}?, {extractMod.Module}?
    return extractMod.extract(source, path, name, opts)
end

--- Renders extracted modules as a single markdown document. `all` is every module the
--- run documented, which is what says which modules are nested under the ones being
--- rendered; it defaults to the modules themselves. `overview` is handwritten prose to
--- open with, which only a single module's page has.
function doc.markdown(
    modules: {extractMod.Module},
    title: string?,
    all: {extractMod.Module}?,
    overview: string?,
    annotationItems: {extractMod.Item}?,
    prefix: string?,
    links: Links?
): string
    local text = markdownMod.render(modules, title, all, overview, prefix, links)
    if annotationItems and #annotationItems > 0 then
        text = text .. "\n# Annotations\n\n" .. markdownMod.items(annotationItems, 2)
    end

    return text
end

--- Renders the parse-only documentation model for external generators. The envelope
--- carries a version so consumers can reject a shape they do not understand rather
--- than silently misreading it.
function doc.json(modules: {extractMod.Module}, annotationItems: {extractMod.Item}?): string
    local function array(items, convert)
        local out = json.asarray({})
        for _, item in ipairs(items or {}) do
            out[#out + 1] = convert and convert(item) or item
        end

        return out
    end

    local function annotations(items)
        return items and array(items) or nil
    end

    local function param(value)
        return {name = value.name, type = value.type, mode = value.mode, text = value.text}
    end

    local function result(value)
        return {type = value.type, text = value.text}
    end

    -- Same two fields as a result, and deliberately the same shape: a caller reading
    -- the JSON asks what comes back and what comes out the other exit with one reader.
    local function raise(value)
        return {type = value.type, text = value.text}
    end

    local function form(value)
        return {
            signature = value.signature,
            title = value.title,
            text = value.text,
            lua = value.lua,
            params = array(value.params, param),
            returns = array(value.returns, result),
            raises = array(value.raises, raise),
            typeargs = array(value.typeargs)
        }
    end

    local member
    member = function(value)
        return {
            name = value.name,
            type = value.type,
            text = value.text,
            path = value.path,
            params = array(value.params, param),
            returns = array(value.returns, result),
            forms = value.forms and array(value.forms, form) or nil,
            raises = array(value.raises, raise),
            isFunction = value.isFunction,
            instanceMethod = value.instanceMethod,
            isMetamethod = value.isMetamethod,
            isType = value.isType,
            signature = value.signature,
            stored = value.stored,
            defaultValue = value.defaultValue,
            constructionBlocked = value.constructionBlocked,
            supertypes = value.supertypes and array(value.supertypes) or nil,
            comptimeKind = value.comptimeKind,
            lua = value.lua,
            annotationMember = value.annotationMember,
            members = value.members and array(value.members, member) or nil,
            annotations = annotations(value.annotations),
        }
    end

    local function item(value)
        local info = value.doc

        return {
            name = value.name,
            kind = value.kind,
            comptimeKind = value.comptimeKind,
            lua = value.lua,
            signature = value.signature,
            supertypes = value.supertypes and array(value.supertypes) or nil,
            constructionBlocked = value.constructionBlocked,
            annotation = value.annotation,
            path = value.path,
            module = value.module,
            line = value.line,
            doc = {
                text = info.text,
                params = info.params,
                returns = array(info.returns),
                raises = array(info.raises, raise),
                fields = info.fields,
                typeargs = info.typeargs,
                tags = info.tags,
            },
            members = array(value.members, member),
            params = array(value.params, param),
            returns = array(value.returns, result),
            forms = value.forms and array(value.forms, form) or nil,
            raises = array(value.raises, raise),
            typeargs = array(
                value.typeargs,
                function(typearg)
                    return {name = typearg.name, text = typearg.text}
                end
            ),
            annotations = annotations(value.annotations),
        }
    end

    local model = array(modules, function(value)
        return {
            name = value.name,
            path = value.path,
            text = value.text,
            items = array(value.items, item),
            documentationInternal = value.documentationInternal,
            namespace = value.namespace,
        }
    end)

    return sortedJson({schemaVersion = 3, modules = model, annotations = array(annotationItems, item)}) .. "\n"
end

----------------------------------------------------------------------------
-- Loading a project's modules
----------------------------------------------------------------------------

local function sourceFiles(root, config, settings, requested)
    local paths, seen = {}, {}
    local sources = requested and #requested > 0 and requested or settings.sources or config.include or {"."}
    for _, source in ipairs(sources) do
        local path = join(root, source)
        local candidates = path:match("%.nupp$") and {path} or listFiles(path)
        for _, candidate in ipairs(candidates) do
            candidate = normalize(candidate)
            if not seen[candidate] then
                seen[candidate] = true
                paths[#paths + 1] = candidate
            end
        end
    end
    table.sort(paths)

    return paths
end

local function byKindThenName(left, right)
    if left.kind == right.kind then
        return left.name < right.name
    end
    return left.kind < right.kind
end

local function loadModules(root, config, settings, requested)
    local modules: {Module} = {}
    local errors: {LexError | {
        filename: string,
        line: integer,
        col: integer,
        msg: string
    }} = {}
    local namespaceBacked, implied = {}, {}
    for _, path in ipairs(sourceFiles(root, config, settings, requested)) do
        local source, readErr = readFile(path)
        if not source then
            errors[#errors + 1] = {filename = path, line = 1, col = 1, msg = tostring(readErr)}
        else
            local name = moduleName(path, root, config.include or {})
            local module, parseErrors, extraModules = doc.extract(source, path, name, {
                includePrivate = settings.includePrivate
            })
            if module then
                modules[#modules + 1] = module
                for _, extra in ipairs(extraModules or {}) do
                    modules[#modules + 1] = extra
                    namespaceBacked[extra.name] = true
                    implied[extra] = true
                end
            else
                for _, err in ipairs(parseErrors as {LexError}) do
                    errors[#errors + 1] = err
                end
            end
        end
    end
    -- One require path is one page, even when two sources document it. `types.derive`
    -- is the case here: the prelude declares the surface the compiler provides, and
    -- `src/nupp/derive.nupp` implements the rest, so a reader asking for that module
    -- wants both. The module with a file behind it keeps the page and the one an
    -- `@namespace` field implied folds into it, because a page that names a source
    -- should name one a reader can open.
    local keeper = {}
    local order: {string} = {}
    for _, module in ipairs(modules) do
        local held = keeper[module.name]
        if not held then
            keeper[module.name] = module
            order[#order + 1] = module.name
        elseif implied[held] and not implied[module] then
            keeper[module.name] = module
        end
    end
    for _, module in ipairs(modules) do
        local into = keeper[module.name]
        if into ~= module then
            -- A declaration and its definition are one entry, not two anchors on the
            -- same name: the definition states the signature and the declaration is
            -- usually where the prose was written, so the page shows the first with the
            -- second filled in.
            local byPath = {}
            for _, item in ipairs(into.items) do
                byPath[item.path] = item
            end
            for _, item in ipairs(module.items) do
                local held = byPath[item.path]
                if not held then
                    into.items[#into.items + 1] = item
                    byPath[item.path] = item
                elseif held.kind == "type"
                    and held.aliasSource
                    and held.aliasSource:match("^([%w_%.]+)") == held.path
                    and item.kind ~= "type"
                then
                    -- A facade can alias the ambient declaration at its own public
                    -- path. Keep that declaration's structure, not the self-alias.
                    if held.doc.text ~= "" then
                        item.doc = held.doc
                    end
                    for index, existing in ipairs(into.items) do
                        if existing == held then
                            into.items[index] = item
                            break
                        end
                    end
                    byPath[item.path] = item
                elseif held.doc.text == "" then
                    held.doc = item.doc
                end
            end
            if into.text == "" then
                into.text = module.text
            end
            into.documentationInternal = into.documentationInternal or module.documentationInternal
            into.namespaceProjection = into.namespaceProjection or module.namespaceProjection
        end
    end
    if #order < #modules then
        local folded = {}
        for _, name in ipairs(order) do
            folded[#folded + 1] = keeper[name]
        end
        modules = folded
    end
    -- A qualified type declaration belongs to the module its name spells, even when
    -- the declaration lives in a different file. The prelude is the important case:
    -- `interface types.Debug` is written in the compiler's hidden declaration tree, but
    -- readers should find it on `nupp`, not lose it with that implementation module.
    -- An `@namespace` field describes a nested module, so its nominal belongs on
    -- that nested page rather than as a second declaration on
    -- `nupp`. Move these after every source has been read so either destination can
    -- supply its prose and source path.
    local byName = {}
    for _, module in ipairs(modules) do
        byName[module.name] = byName[module.name] or module
    end

    -- Resolve exported type aliases before filtering implementation modules. A public
    -- alias owns its documentation name, while the declaring file owns the contract.
    -- Only explicit aliases project members; exporting an entire provider table does
    -- not silently make every implementation detail a public declaration.
    local function copy(value: any): any
        if type(value) ~= "table" then
            return value
        end
        local out = {}
        for key, child in pairs(value) do
            out[key] = copy(child)
        end

        return out
    end

    local function relocateMembers(value: any): nil
        for _, member in ipairs(value.members or {}) do
            member.path = value.path .. "." .. member.name
            relocateMembers(member)
        end
    end

    -- Keep the visibility decision shared with namespace projection below. Only a
    -- real public alias supplies a display name for an implementation declaration.
    -- Which modules the site will not show. Asked twice: once to decide whether a
    -- namespace re-export has a page of its own to point at, and once to drop them.
    local internalTrees: {string} = {}
    for _, module in ipairs(modules) do
        if module.documentationInternal and module.path and module.path:match("[/\\]init%.nupp$") then
            internalTrees[#internalTrees + 1] = module.name
        end
    end

    local function hiddenModule(module: any): boolean
        if settings.includePrivate then
            return false
        end
        if module.documentationInternal or internalModuleName(module.name) then
            return true
        end
        if module.path and not module.namespaceProjection and privateSource(root, module.path) then
            return true
        end
        for _, namespace in ipairs(internalTrees) do
            if module.name == namespace or module.name:sub(1, #namespace + 1) == namespace .. "." then
                return true
            end
        end

        return false
    end

    local byPath = {}
    local declaringModule = {}

    local function indexNested(owner: any, module: any): nil
        for _, member in ipairs(owner.members or {}) do
            if member.isType or member.isAlias then
                local name = owner.name .. "." .. member.name
                local nested = {
                    name = name,
                    path = member.path,
                    line = owner.line,
                    kind = member.isAlias and "type" or member.type,
                    aliasSource = member.isAlias and member.type or nil,
                    signature = member.signature
                    or member.isAlias and ("type " .. name .. " = " .. member.type)
                    or (member.type .. " " .. name),
                    doc = {
                        text = member.text,
                        fields = {},
                        params = {},
                        returns = {},
                        raises = {},
                        tags = {},
                        typeargs = {}
                    },
                    members = member.members or {},
                    supertypes = member.supertypes,
                    constructionBlocked = member.constructionBlocked,
                    params = {},
                    returns = {},
                    raises = {},
                    typeargs = member.typeargs or {},
                }
                byPath[member.path], declaringModule[nested] = nested, module
                indexNested(nested, module)
            end
        end
    end

    for _, module in ipairs(modules) do
        for _, item in ipairs(module.items) do
            byPath[item.path] = item
            declaringModule[item] = module
            indexNested(item, module)
        end
    end

    local function reference(path: string, context: any): any
        if path:sub(1, #context.name + 1) == context.name .. "." and byPath[path] then
            return byPath[path]
        end
        local first, rest = path:match("^([%w_]+)%.(.*)$")
        first = first or path
        local imported = context.imports and context.imports[first]
        if imported then
            local member = context.importedMembers and context.importedMembers[first]
            local selected = member and (member .. (rest and "." .. rest or "")) or rest or ""
            return byPath[imported .. "." .. selected]
        end
        if (first == context.moduleLocal or first == context.name:match("([^.]+)$")) and rest then
            return byPath[context.name .. "." .. rest]
        end

        return byPath[context.name .. "." .. path] or byPath[path]
    end

    local contractFields = {}

    local function contractField(owner: any, field: any, registerPath: boolean): any
        local held = contractFields[field]
        if held then
            return held
        end
        local context = declaringModule[owner]
        local typed = field
        local signature = field.type
        local seen = {}
        while not typed.isFunction and signature:match("^[%w_%.]+$") do
            local alias = reference(signature, context)
            if not alias or seen[alias] or not alias.aliasSource then
                break
            end
            seen[alias] = true
            context, typed, signature = declaringModule[alias], alias, alias.aliasSource
            if signature:find("function", 1, true) then
                break
            end
        end
        local callable = typed.isFunction or signature:match("^%s*[@%w_()., =]*function[%s<%(]") ~= nil
        local item = {
            name = field.name,
            path = field.path,
            line = owner.line,
            kind = callable and "function" or "variable",
            signature = "const " .. field.name .. ": " .. signature,
            doc = {
                text = field.text,
                fields = {},
                params = {},
                returns = {},
                raises = field.raises,
                tags = {},
                typeargs = {}
            },
            members = field.members or {},
            params = typed.params,
            returns = typed.returns,
            forms = typed.forms,
            raises = field.raises,
            typeargs = typed.typeargs or {},
            annotations = field.annotations,
            comptimeKind = field.comptimeKind or typed.comptimeKind,
        }
        contractFields[field], declaringModule[item] = item, context
        if registerPath then
            byPath[field.path] = item
        end

        return item
    end

    local function aliasTarget(item: any, module: any): any
        local aliasText = item.aliasSource and "= " .. item.aliasSource or item.signature
        local required, selected = aliasText:match("=%s*require%s*%(%s*['\"]([^'\"]+)['\"]%s*%)%.([%w_%.]+)%s*$")
        if required and selected then
            return byPath[required .. "." .. selected]
        end
        local path = aliasText:match("=%s*([%w_%.]+)%s*$") or aliasText:match("=%s*([%w_%.]+)%b<>%s*$")
        local direct = path and reference(path, module)
        if direct then
            return direct
        end
        local alias, member = aliasText:match("=%s*([%w_]+)%.([%w_]+)%s*$")
        if not alias then
            alias, member = aliasText:match("=%s*([%w_]+)%.([%w_]+)%b<>%s*$")
        end
        if not alias then
            local plucked = aliasText:match("=%s*([%w_]+)%s*$") or aliasText:match("=%s*([%w_]+)%b<>%s*$")
            alias = plucked and module.importedMembers and module.importedMembers[plucked] and plucked or nil
            member = alias and module.importedMembers[alias] or nil
        end
        local origin = alias and module.imports and byName[module.imports[alias]] or nil
        local target = origin and byPath[origin.name .. "." .. member]
        if target then
            return target
        end
        -- Only a value declaration with an explicit type supplies this contract;
        -- a function's qualified return type is not a value alias annotation.
        if not item.aliasSource
            or not (item.signature:match("^const%s+[%w_]+%s*:") or item.signature:match("^local%s+[%w_]+%s*:"))
        then
            return nil
        end
        -- A real indexed-type annotation names the declaration that validates a
        -- selected provider function. Follow only that known contract member;
        -- arbitrary runtime alias chains remain unresolved.
        local binding, nominal, field = item.signature:match(":%s*([%w_]+)%.([%w_]+)%.%[%s*['\"]([%w_]+)['\"]%s*%]%s*$")
        if not binding then
            binding, nominal = item.signature:match(":%s*([%w_]+)%.([%w_]+)%s*$")
        end
        local contract = binding and module.imports and byName[module.imports[binding]]
        local owner = contract and byPath[contract.name .. "." .. nominal]
        local seen = {}
        while owner and not seen[owner] do
            seen[owner] = true
            local aliased = aliasTarget(owner, declaringModule[owner])
            if not aliased then
                break
            end
            owner = aliased
        end
        for _, candidate in ipairs(owner and owner.members or {}) do
            if candidate.name == field then
                return contractField(owner, candidate, true)
            end
        end
        if not field
            and owner
            and owner.aliasSource
            and owner.aliasSource:match("^%s*[@%w_()., =]*function[%s<%(]")
        then
            if not contractFields[owner] then
                contractFields[
                    owner
                ] = contractField(
                    owner,
                    {
                        name = owner.name,
                        path = owner.path,
                        type = owner.aliasSource,
                        text = owner.doc.text,
                        params = owner.params,
                        returns = owner.returns,
                        forms = owner.forms,
                        raises = owner.raises,
                        typeargs = owner.typeargs,
                        isFunction = true,
                        annotations = owner.annotations,
                        comptimeKind = owner.comptimeKind,
                    },
                    false
                )
            end
            return contractFields[owner]
        end

        return nil
    end

    local function original(item: any, seen: any): any
        if seen[item] then
            return item
        end
        seen[item] = true
        local target = aliasTarget(item, declaringModule[item])

        return target and original(target, seen) or item
    end

    -- Resolve every public alias before projecting any of them. A sibling can refer
    -- to a declaration whose alias appears later, or reaches it through another
    -- private module. Prefer a name on the page being rendered, then a deterministic
    -- public path; never invent a public module for a private import prefix.
    local publicNames = {}
    for _, module in ipairs(modules) do
        if not hiddenModule(module) then
            for _, item in ipairs(module.items) do
                local source = original(item, {})
                local names = publicNames[source] or {}
                names[#names + 1] = item
                publicNames[source] = names
                local visiting = {}

                local function nestedNames(owner: any, parentName: string, parentPath: string): nil
                    if visiting[owner] then
                        return
                    end
                    visiting[owner] = true
                    local context = declaringModule[owner]
                    for _, member in ipairs(owner.members or {}) do
                        if member.isAlias or member.isType then
                            local target = member.isAlias and reference(member.type, context) or nil
                            target = target or byPath[member.path]
                            target = target and original(target, {}) or nil
                            if target then
                                local public = {
                                    name = parentName .. "." .. member.name,
                                    path = parentPath .. "." .. member.name
                                }
                                declaringModule[public] = module
                                local aliases = publicNames[target] or {}
                                aliases[#aliases + 1] = public
                                publicNames[target] = aliases
                                nestedNames(target, public.name, public.path)
                            end
                        end
                    end
                    visiting[owner] = nil
                end

                nestedNames(source, item.name, item.path)
            end
        end
    end

    local function byPublicPath(left, right)
        return left.path < right.path
    end

    for _, names in pairs(publicNames) do
        table.sort(names, byPublicPath)
    end

    local function publicName(source: any, module: any): string?
        source = original(source, {})
        local names = publicNames[source]
        local canonical = source.name:match("([%w_]+)$")
        for _, item in ipairs(names or {}) do
            if declaringModule[item] == module and item.name == canonical then
                return item.name
            end
        end
        for _, item in ipairs(names or {}) do
            if declaringModule[item] == module then
                return item.name
            end
        end

        return names and names[1].path or nil
    end

    -- Rewrite name tokens, not strings or comments. The origin's import table
    -- resolves private sibling and plucked names; the public export graph chooses
    -- their display names. Generic binders and named fields remain local names.
    local function references(
        text: string,
        context: any,
        module: any,
        binders: any,
        declarationOffset: integer?,
        localNames: any
    ): string
        local tokens = lexerMod.lex(text)
        local scopes = {}
        for index, token in ipairs(tokens) do
            if token.text == "function" and tokens[index + 1] and tokens[index + 1].text == "<" then
                local names, depth = {}, 1
                local at: integer = index + 2
                local binder = true
                while tokens[at] and depth > 0 do
                    local value = tokens[at]
                    if depth == 1 and binder and value.kind == "name" then
                        names[value.text] = true
                        binder = false
                    end
                    if value.text == "<" then
                        depth = depth + 1
                    elseif value.text == ">" then
                        depth = depth - 1
                    elseif depth == 1 and value.text == "," then
                        binder = true
                    end
                    at = at + 1
                end
                local last: integer = at
                depth = 0
                while tokens[last] do
                    local value = tokens[last].text
                    if depth == 0 and (value == "," or value == "}" or value == ")" or value == "]") then
                        break
                    end
                    if value == "(" or value == "{" or value == "[" or value == "<" then
                        depth = depth + 1
                    elseif value == ")" or value == "}" or value == "]" or value == ">" then
                        depth = depth - 1
                    end
                    last = last + 1
                end
                scopes[#scopes + 1] = {first = index, last = last, names = names}
            end
        end
        local parts, at = {}, 1
        local index: integer = 1
        while index <= #tokens do
            local token = tokens[index]
            if token.kind == "name" then
                local last: integer = index
                local path = token.text
                while tokens[last + 1]
                    and tokens[last + 1].text == "."
                    and tokens[last + 2]
                    and tokens[last + 2].kind == "name" do
                    last = last + 2
                    path = path .. "." .. tokens[last].text
                end
                local nextToken = tokens[last + 1]
                local shadowed = binders[token.text] or token.offset == declarationOffset
                for _, scope in ipairs(scopes) do
                    shadowed = shadowed or (index >= scope.first and index < scope.last and scope.names[token.text])
                end
                local source = not shadowed and not (nextToken and nextToken.text == ":") and reference(path, context)
                    or nil
                local name = source and (localNames[original(source, {})] or publicName(source, module)) or nil
                if name then
                    parts[#parts + 1] = text:sub(at, token.offset - 1)
                    parts[#parts + 1] = name
                    at = tokens[last].offset + #tokens[last].text
                end
                index = last + 1
            else
                index = index + 1
            end
        end
        parts[#parts + 1] = text:sub(at)

        return table.concat(parts)
    end

    local declarationWords = {
        affine = true,
        cdef = true,
        comptime = true,
        const = true,
        ["function"] = true,
        global = true,
        interface = true,
        ["local"] = true,
        record = true,
        sealed = true,
        struct = true,
        ["type"] = true,
    }

    local function renamed(signature: string, member: string, name: string): string, integer?
        local tokens = lexerMod.lex(signature)
        local index: integer = 1
        while index <= #tokens do
            local token = tokens[index]
            if token.text == "@" then
                index = index + 2
                if tokens[index] and tokens[index].text == "(" then
                    local depth = 1
                    index = index + 1
                    while tokens[index] and depth > 0 do
                        local text = tokens[index].text
                        depth = depth + (text == "(" and 1 or text == ")" and -1 or 0)
                        index = index + 1
                    end
                end
            elseif declarationWords[token.text] then
                index = index + 1
            else
                local last: integer = index
                while tokens[last + 1] and tokens[last + 1].text == "." and tokens[last + 2] do
                    last = last + 2
                end
                if tokens[last].text == member then
                    return signature:sub(
                        1,
                        token.offset - 1
                    ) .. name .. signature:sub(tokens[last].offset + #tokens[last].text), token.offset
                end
                return signature, token.offset
            end
        end

        return signature
    end

    local projectedAliases = {}

    local function needsProjection(value: any): boolean
        if value.isAlias or value.supertypes then
            return true
        end
        for _, member in ipairs(value.members or {}) do
            if needsProjection(member) then
                return true
            end
        end

        return false
    end

    local function projected(item: any, module: any): any
        local candidate = original(item, {})
        if candidate == item and not needsProjection(candidate) then
            return item
        end
        local context = declaringModule[candidate]
        local localNames = {}

        local function displayReferences(text, sourceContext, targetModule, binders, offset)
            return references(text, sourceContext, targetModule, binders, offset, localNames)
        end

        local expanded = copy(candidate)
        projectedAliases[expanded] = true
        expanded.name, expanded.path, expanded.module, expanded.line = item.name, item.path, item.module, item.line
        expanded.readOnly = item.readOnly
        local binders = {}
        for _, generic in ipairs(candidate.typeargs or {}) do
            binders[generic.name] = true
        end
        -- Rename the declaration before resolving its references so a public name
        -- cannot be mistaken for an unrelated declaration in the origin module.
        local signature, declarationOffset = renamed(expanded.signature, candidate.name:match("([%w_]+)$"), item.name)
        expanded.signature = displayReferences(signature, context, module, binders, declarationOffset)
        local documented, seen = item, {}
        while documented and not seen[documented] do
            seen[documented] = true
            if documented.doc.text ~= "" then
                expanded.doc = copy(documented.doc)
                break
            end
            documented = aliasTarget(documented, declaringModule[documented])
        end

        local expanding = {}

        local function fields(value: any, path: string, sourceContext: any, parentBinders: any): nil
            local parentNames = localNames
            localNames = copy(parentNames)
            local binders = copy(parentBinders)
            for _, generic in ipairs(value.typeargs or {}) do
                binders[generic.name] = true
            end
            -- A facade can extend a private interface to add factories. Publish the
            -- inherited contract here because that base has no public page to link.
            local inherited = {}
            local flattened = false
            local bases = {}
            local present = {}
            for _, member in ipairs(value.members or {}) do
                present[member.name] = true
            end

            local function inherit(owner, ownerContext)
                for _, supertype in ipairs(owner.supertypes or {}) do
                    local base = reference(supertype, ownerContext)
                    base = base and original(base, {}) or nil
                    local baseContext = base and declaringModule[base]
                    if base
                        and hiddenModule(baseContext)
                        and not publicName(base, module)
                        and #(base.typeargs or {}) == 0
                        and not expanding[base]
                    then
                        expanding[base] = true
                        flattened = true
                        localNames[base] = value.name
                        for _, member in ipairs(base.members or {}) do
                            if not present[member.name] then
                                local copied = copy(member)
                                copied.path = path .. "." .. copied.name
                                inherited[#inherited + 1] = {member = copied, context = baseContext}
                                present[member.name] = true
                            end
                        end
                        inherit(base, baseContext)
                        expanding[base] = nil
                    else
                        bases[#bases + 1] = displayReferences(supertype, ownerContext, module, binders, nil)
                    end
                end
            end

            inherit(value, sourceContext)
            value.supertypes = #bases > 0 and bases or nil
            if value.signature and flattened then
                local depth = 0
                local tokens = lexerMod.lex(value.signature)
                for _, token in ipairs(tokens) do
                    if token.text == "is" and depth == 0 then
                        value.signature = value.signature:sub(1, token.offset - 1):gsub("%s+$", "")
                        break
                    elseif token.text == "<" or token.text == "(" or token.text == "{" or token.text == "[" then
                        depth = depth + 1
                    elseif token.text == ">" or token.text == ")" or token.text == "}" or token.text == "]" then
                        depth = depth - 1
                    end
                end
                if #bases > 0 then
                    value.signature = value.signature .. " is " .. table.concat(bases, ", ")
                end
            end
            value.type = value.type and displayReferences(value.type, sourceContext, module, binders, nil) or nil
            if value.isType and value.signature then
                local _, offset = renamed(value.signature, value.name, value.name)
                value.signature = displayReferences(value.signature, sourceContext, module, binders, offset)
            end
            for _, key in ipairs({"params", "returns", "raises"}) do
                for _, field in ipairs(value[key] or {}) do
                    field.type = displayReferences(field.type, sourceContext, module, binders, nil)
                end
            end
            for _, form in ipairs(value.forms or {}) do
                local formBinders = copy(binders)
                for _, generic in ipairs(form.typeargs) do
                    formBinders[generic.name] = true
                end
                form.signature = displayReferences(form.signature, sourceContext, module, formBinders, nil)
                for _, parts in ipairs({form.params, form.returns, form.raises}) do
                    for _, part in ipairs(parts) do
                        part.type = displayReferences(part.type, sourceContext, module, formBinders, nil)
                    end
                end
            end
            for _, field in ipairs(value.members or {}) do
                local fieldContext = sourceContext
                local target = field.isAlias and reference(field.type, sourceContext) or nil
                target = target and original(target, {}) or nil
                local entered = target and not expanding[target]
                if entered then
                    expanding[target] = true
                    fieldContext = declaringModule[target]
                    if field.text == "" then
                        field.text = target.doc.text
                    end
                    if #(target.members or {}) > 0 or #(target.supertypes or {}) > 0 then
                        field.isAlias, field.isType = nil, true
                        field.type = target.kind
                        field.signature = renamed(target.signature, target.name:match("([%w_]+)$"), field.name)
                        field.members = copy(target.members)
                        field.typeargs = copy(target.typeargs)
                        field.supertypes = copy(target.supertypes)
                        field.constructionBlocked = target.constructionBlocked
                    elseif target.aliasSource then
                        field.type = target.aliasSource
                    end
                end
                field.path = path .. "." .. field.name
                fields(field, field.path, fieldContext, binders)
                if entered then
                    expanding[target] = nil
                end
            end
            for _, entry in ipairs(inherited) do
                fields(entry.member, entry.member.path, entry.context, binders)
                value.members[#value.members + 1] = entry.member
            end
            localNames = parentNames
        end

        fields(expanded, item.path, context, binders)
        for _, raised in ipairs(expanded.doc.raises or {}) do
            raised.type = displayReferences(raised.type, context, module, binders, nil)
        end

        return expanded
    end

    for _, module in ipairs(modules) do
        local projectedItems, published = {}, {}
        for _, item in ipairs(module.items) do
            local expanded = projected(item, module)
            local key = expanded.path .. "\0" .. expanded.kind .. "\0" .. expanded.signature
            if not published[key] then
                projectedItems[#projectedItems + 1] = expanded
                published[key] = true
            end
        end
        module.items = projectedItems
    end

    -- The module a namespace re-export publishes, holding the values that reach a
    -- reader through the alias rather than through the module they were written in.
    local function aliasNamespace(module: any, item: any, origin: any): any
        local name = module.name .. "." .. item.name
        local alias = {
            name = name,
            -- The file declaring the alias, not the aliased one: the page names a
            -- source a reader can open, and an internal file is not on the site to be
            -- opened.
            path = module.path,
            text = item.doc.text ~= "" and item.doc.text or origin.text,
            items = {},
        }
        for _, candidate in ipairs(origin.items) do
            if candidate.kind == "variable" or candidate.kind == "function" then
                local copied = copy(candidate)
                copied.module = nil
                copied.path = name .. "." .. candidate.name
                relocateMembers(copied)
                alias.items[#alias.items + 1] = copied
            end
        end

        return alias
    end

    -- A public const bound to a whole required module is a namespace re-export, and the
    -- name it publishes is one the checker resolves: `app.phases.Update` reaches
    -- the aliased module's constant. A parse alone cannot say what the alias holds, so
    -- the declaration renders as a bare `const phases` naming none of it, and where the
    -- aliased module is internal its members reach the site through no other name at
    -- all. Document the module that name already answers to.
    --
    -- Values only. A value binding does not carry the aliased module's types, so
    -- `app.phases.Phase` is a spelling the checker rejects and publishing it here
    -- would document a call that does not compile. A type meant to be re-exported is
    -- written as its own `export type` alias, which `projected` above expands.
    --
    -- An aliased module the site already shows keeps its one page instead of being
    -- copied onto a second. The declaration then spells its target, which the symbol
    -- index links.
    local aliasedNamespaces: {Module} = {}
    for _, module in ipairs(modules) do
        local kept = {}
        for _, item in ipairs(module.items) do
            local binding = item.kind == "variable" and item.aliasSource and item.aliasSource:match("^[%a_][%w_]*$")
                or nil
            local imported = binding and module.imports and module.imports[binding] or nil
            local origin = imported and byName[imported] or nil
            if not origin or origin == module or byName[module.name .. "." .. item.name] then
                kept[#kept + 1] = item
            elseif hiddenModule(origin) then
                aliasedNamespaces[#aliasedNamespaces + 1] = aliasNamespace(module, item, origin)
            else
                item.signature = item.signature .. " = " .. origin.name
                kept[#kept + 1] = item
            end
        end
        module.items = kept
    end
    for _, alias in ipairs(aliasedNamespaces) do
        modules[#modules + 1] = alias
        byName[alias.name] = byName[alias.name] or alias
    end

    -- A qualified implementation declaration can have the same public path as an
    -- explicit facade alias. Keep the facade's chosen contract; an unresolved
    -- self-alias instead gets its real declaration, retaining the facade's prose.
    local function publishQualified(target: any, item: any): nil
        for index, held in ipairs(target.items) do
            if held.path == item.path then
                if held.kind == "type" and item.kind ~= "type" and not projectedAliases[held] then
                    if held.doc.text ~= "" then
                        item.doc = held.doc
                    end
                    target.items[index] = item
                elseif held.doc.text == "" then
                    held.doc = item.doc
                end
                return
            end
        end
        target.items[#target.items + 1] = item
    end

    for _, module in ipairs(modules) do
        local kept = {}
        for _, item in ipairs(module.items) do
            local target = item.module and byName[item.module] or nil
            local nested = target and byName[(item.module as string) .. "." .. item.name] or nil
            if not settings.includePrivate and item.module and internalModuleName(item.module) then
                -- Dropped outright. `record nupp.internal.Cache` belongs to a private
                -- module whether or not a file by that name was read, so it must not
                -- fall through and stay behind on whichever module happened to declare
                -- it.
            elseif nested and namespaceBacked[nested.name] then
                if item.doc.text ~= "" then
                    nested.text = item.doc.text
                end
            elseif target and target ~= module then
                item.path = (item.module as string) .. "." .. item.name
                relocateMembers(item)
                publishQualified(target, item)
            else
                kept[#kept + 1] = item
            end
        end
        module.items = kept
    end
    for _, module in ipairs(modules) do
        table.sort(module.items, byKindThenName)
    end
    if not settings.includePrivate then
        local public = {}
        for _, module in ipairs(modules) do
            if not hiddenModule(module) then
                public[#public + 1] = module
            end
        end
        modules = public
    end
    -- After the private ones are dropped, so a directory whose every module is internal
    -- does not document as an empty namespace.
    for _, namespace in ipairs(namespaceModules(modules)) do
        modules[#modules + 1] = namespace
    end
    table.sort(modules, function(left, right)
        return left.name < right.name
    end)

    return modules, errors
end

----------------------------------------------------------------------------
-- Embeds and rewritten links
----------------------------------------------------------------------------

-- `<<< @path` on its own line embeds another file's contents as a fenced code block,
-- language guessed from its extension. A page like the grammar reference is written
-- this way instead of pasting the grammar in by hand, so the two can never drift: the
-- build reads whatever bytes docs/grammar.abnf holds, every time it runs.
--
-- A directive inside a fence is a page showing the syntax rather than using it, and
-- expanding one there produces a fence inside a fence: the inner block's closing line
-- ends the outer one, and every heading after it is swallowed by the block the leftover
-- opening starts. This page documents the directive, so it is the case that matters.
-- Front matter is metadata for whatever else reads the file, and the page starts after
-- it. A collection and a swept tree read the same block for a page's place and name, so
-- removing it here is a rendering decision rather than a loss.
local stripFrontMatter = frontmatterMod.strip

local function embedFiles(root, markdown)
    local out, fence = {}, nil
    for line in (markdown .. "\n"):gmatch("(.-)\n") do
        local marker = line:match("^%s*(```+)") or line:match("^%s*(~~~+)")
        if marker then
            if not fence then
                fence = marker
            elseif marker:sub(1, 1) == fence:sub(1, 1) and #marker >= #fence then
                fence = nil
            end
        end
        local path = not fence and line:match("^<<<%s+@(%S+)%s*$")
        if path then
            local contents, err = readFile(join(root, path))
            if not contents then
                return nil, err
            end
            out[#out + 1] = "```" .. (path:match("%.([%w_]+)$") or "text")
            out[#out + 1] = (contents:gsub("\n$", ""))
            out[#out + 1] = "```"
        else
            out[#out + 1] = line
        end
    end

    return table.concat(out, "\n")
end

-- A doc comment is markdown written in a source file rather than on a page, so a link
-- in one names a repository path: `docs/learn/runtime/ownership/borrowing.md`. The API
-- page it ends up on is routed somewhere else entirely, so those paths are resolved
-- against the site's routes exactly as a configured page's are, once, before anything
-- renders.
--
-- Every prose field is rewritten rather than only the leading text, because a `@param`
-- description carries a link as readily as the sentence above it does.
local function rewriteModuleDocLinks(module: Module, pages: {Page2}, file: string): nil
    local page: Page2 = {path = ""}

    local function rewrite(text: string?): string
        if not text or text == "" then
            return text or ""
        end

        return rewriteConfiguredPageLinks(text, page, pages, file)
    end

    local function rewriteParts(params: {Param}, returns: {Result}, raises: {Raise}): nil
        for _, param in ipairs(params) do
            param.text = rewrite(param.text)
        end
        for _, result in ipairs(returns) do
            result.text = rewrite(result.text)
        end
        -- The condition is prose; the type beside it is not a page path.
        for _, raise in ipairs(raises) do
            raise.text = rewrite(raise.text)
        end
    end

    local function rewriteForms(forms: {extractMod.Form}?): nil
        for _, form in ipairs(forms or {}) do
            form.text = rewrite(form.text)
            rewriteParts(form.params, form.returns, form.raises)
            for _, typearg in ipairs(form.typeargs) do
                typearg.text = rewrite(typearg.text)
            end
        end
    end

    local rewriteMembers: (function(members: {Member}?): nil)
    rewriteMembers = function(members)
        for _, member in ipairs(members or {}) do
            member.text = rewrite(member.text)
            rewriteParts(member.params, member.returns, member.raises)
            rewriteForms(member.forms)
            rewriteMembers(member.members)
        end
    end
    module.text = rewrite(module.text)
    for _, item in ipairs(module.items) do
        item.doc.text = rewrite(item.doc.text)
        for name, text in pairs(item.doc.params) do
            item.doc.params[name] = rewrite(text)
        end
        for index, text in ipairs(item.doc.returns) do
            item.doc.returns[index] = rewrite(text)
        end
        rewriteParts(item.params, item.returns, item.raises)
        rewriteForms(item.forms)
        for _, typearg in ipairs(item.typeargs) do
            typearg.text = rewrite(typearg.text)
        end
        rewriteMembers(item.members)
    end
end

----------------------------------------------------------------------------
-- Pages
----------------------------------------------------------------------------

-- The home page's hero and showcase are written in its markdown, between markers, and
-- read back off it here. A page that carries neither region -- which is every page but
-- the one -- is answered unchanged.
local function decorate(candidate)
    if candidate.layout ~= "home" or not homeMod.decorated(candidate.markdown) then
        return candidate
    end
    local sections = homeMod.parse(candidate.markdown)
    candidate.markdown = sections.markdown
    candidate.heroTitle = sections.heroTitle
    candidate.heroText = sections.heroText
    candidate.heroContent = sections.heroContent
    candidate.heroImage = sections.heroImage
    candidate.heroImageAlt = sections.heroImageAlt
    candidate.heroActions = sections.heroActions
    candidate.features = sections.features

    return candidate
end

-- The pages one glob entry publishes, ready to be added: the tree's own files, with
-- what a collection or a generated index already publishes left out of the match.
local function sweptPages(root, configured, reserved, title)
    local exclude: {string} = {}
    for _, pattern in ipairs(reserved) do
        exclude[#exclude + 1] = pattern
    end
    for _, pattern in ipairs(configured.exclude or {}) do
        exclude[#exclude + 1] = pattern
    end
    local expanded, err = sweepMod.expand(root, {base = configured.base, exclude = exclude, glob = configured.glob})
    if not expanded then
        return nil, err
    end
    local candidates = {}
    for _, swept in ipairs(expanded) do
        local markdown, embedErr = embedFiles(root, swept.markdown)
        if not markdown then
            return nil, embedErr
        end
        candidates[#candidates + 1] = decorate({
            path = swept.path,
            -- Left unnamed when the page names itself nowhere: a module overview is
            -- prose above a generated page and is titled by the module it opens,
            -- which is known further down than here.
            title = swept.title or (swept.path == "" and title or nil),
            source = swept.source,
            layout = swept.layout,
            redirects = swept.redirects,
            markdown = markdown,
        })
    end

    return candidates
end

local function configuredPages(root, settings, title, standardLibrary: stdlibMod.Page?): {BuiltPage}?, string?
    local pages: {BuiltPage} = {}
    local seen, home = {}, false
    -- A collection publishes the documents in its directory itself. A glob over the
    -- tree that holds it would publish every one of them a second time at a route of
    -- its own, so the directories are collected before any file is matched.
    local reserved: {string} = {}
    for _, configured in ipairs(settings.pages or {}) do
        if type(configured) == "table" and configured.directory then
            reserved[#reserved + 1] = configured.directory .. "/**"
        end
    end
    -- The diagnostics prose is the same kind of file at the same kind of path, and it
    -- is already published: the generated index opens with it. Sweeping it up again
    -- would be one page claiming the route the other was written for.
    local diagnosticsSource = settings.diagnostics and settings.diagnostics.source
    if diagnosticsSource then
        reserved[#reserved + 1] = diagnosticsSource
    end
    for index, configured in ipairs(settings.pages or {}) do
        if type(configured) ~= "table" then
            return nil, "documentation page " .. index .. " must be a table"
        end
        if configured.glob then
            local expanded, expandErr = sweptPages(root, configured, reserved, title)
            if not expanded then
                return nil, expandErr
            end
            for _, swept in ipairs(expanded) do
                if seen[swept.path] then
                    return nil, "duplicate documentation page path: " .. swept.path
                end
                seen[swept.path], home = true, home or swept.path == ""
                pages[#pages + 1] = swept
            end
        elseif configured.directory then
            local expanded, expandErr = collectionMod.expand(root, configured as collectionMod.Settings)
            if not expanded then
                return nil, expandErr
            end
            for _, member in ipairs(expanded) do
                if seen[member.path] then
                    return nil, "duplicate documentation page path: " .. member.path
                end
                seen[member.path] = true
                local embedded
                embedded, expandErr = embedFiles(root, member.markdown)
                if not embedded then
                    return nil, expandErr
                end
                member.markdown = embedded
                pages[
                    #pages + 1
                ] = {
                    path = member.path,
                    title = member.title,
                    source = member.source,
                    markdown = member.markdown,
                    unlisted = member.unlisted,
                }
            end
        else
            local route = cleanRoute(configured.path)
            if not route then
                return nil, "invalid documentation page path"
            end
            if seen[route] then
                return nil, "duplicate documentation page path: " .. route
            end
            seen[route], home = true, home or route == ""
            local candidate = {}
            for key, value in pairs(configured) do
                candidate[key] = value
            end
            candidate.path = route
            candidate.markdown = ""
            if candidate.source then
                local source, err = readFile(join(root, candidate.source))
                if not source then
                    return nil, err
                end
                local fields, body = frontmatterMod.parse(source)
                candidate.title = candidate.title or fields.title
                candidate.layout = candidate.layout or fields.layout
                source, err = embedFiles(root, body)
                if not source then
                    return nil, err
                end
                candidate.markdown = source
            end
            candidate.title = candidate.title or (route == "" and title or route)
            pages[#pages + 1] = decorate(candidate)
        end
    end
    -- Which handwritten files the site actually builds, so a generated page can link
    -- the ones it can reach and name the ones it cannot. Read from the assembled pages
    -- rather than from the manifest, because a collection's documents are files the
    -- site publishes that the manifest never named.
    local published: {[string]: boolean} = {}
    for _, candidate in ipairs(pages) do
        if candidate.source then
            published[candidate.source] = true
        end
    end

    -- A generated page is one the compiler writes rather than one the manifest spells
    -- out. The diagnostic codes and the standard library declarations are both the
    -- compiler's own, so a manifest carrying either would be a copy that goes stale the
    -- first time the compiler changed.
    local function addGenerated(
        generated: doc.Generated?,
        what: string,
        api: boolean?,
        navigationTitle: string?,
        navigation: stdlibMod.Navigation?
    ): boolean?, string?
        if not generated then
            return true
        end
        local route = cleanRoute(generated.path)
        if not route then
            return nil, "invalid " .. what .. " path"
        end
        if seen[route] then
            return nil, what .. " collides with a configured page: " .. route
        end
        seen[route] = true
        pages[
            #pages + 1
        ] = {
            path = route,
            title = generated.title,
            navigationTitle = navigationTitle,
            navigation = navigation,
            markdown = generated.markdown,
            source = generated.source,
            redirects = generated.redirects,
            symbols = generated.symbols,
            api = api
        }

        return true
    end

    -- The diagnostics page is one page written two ways: the prose a person wrote about
    -- what a diagnostic is, and the index the compiler generates from its own codes. A
    -- reader learning the format and a reader holding a code are the same reader a
    -- minute apart, so they are not two routes.
    local diagnosticsSettings = settings.diagnostics
    if diagnosticsSettings and diagnosticsSettings.source then
        local prose, proseErr = readFile(join(root, diagnosticsSettings.source))
        if not prose then
            return nil, proseErr
        end
        prose, proseErr = embedFiles(root, stripFrontMatter(prose))
        if not prose then
            return nil, proseErr
        end
        diagnosticsSettings = {
            path = diagnosticsSettings.path,
            title = diagnosticsSettings.title,
            source = diagnosticsSettings.source,
            redirects = diagnosticsSettings.redirects,
            prose = prose
        }
        published[diagnosticsSettings.source] = true
    end
    local added, addErr = addGenerated(diagnosticsMod.page(diagnosticsSettings, published), "diagnostic index")
    if not added then
        return nil, addErr
    end
    added, addErr = addGenerated(
        standardLibrary,
        "standard library index",
        true,
        "API reference",
        standardLibrary and standardLibrary.navigation or nil
    )
    if not added then
        return nil, addErr
    end
    if not home then
        table.insert(pages, 1, {
            path = "",
            title = title,
            layout = "home",
            heroTitle = title,
            heroText = settings.description or "API reference generated directly from Nupp source.",
            markdown = ""
        })
    end

    return pages
end

----------------------------------------------------------------------------
-- Search and redirects
----------------------------------------------------------------------------

local function redirectHtml(target)
    return '<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="0; url=' .. htmlEscape(
        target
    ) .. '"><link rel="canonical" href="' .. htmlEscape(
        target
    ) .. '"><a href="' .. htmlEscape(target) .. '">Documentation moved</a>\n'
end

local function searchIndexJs(entries)
    local out = {"window.NUPP_SEARCH_INDEX = [\n"}
    for _, entry in ipairs(entries) do
        out[
            #out + 1
        ] = '  {title:"' .. escapeJs(
            entry.title
        ) .. '",url:"' .. escapeJs(entry.url) .. '",text:"' .. escapeJs(entry.text) .. '"},\n'
    end
    out[#out + 1] = "];\n"

    return table.concat(out)
end

local function appendSearchEntries(entries, candidate, file, markdown)
    local url = "../" .. file
    if candidate.module then
        local module = candidate.module
        entries[
            #entries + 1
        ] = {
            title = (module.namespace and "Namespace › " or "Module › ") .. module.name,
            url = url,
            text = module.name .. " " .. (module.text or ""),
        }
        for _, item in ipairs(module.items) do
            local itemText = {item.name, item.signature, item.doc.text or ""}
            for _, param in ipairs(item.params) do
                itemText[#itemText + 1] = param.name .. " " .. param.type .. " " .. (param.text or "")
            end
            for _, value in ipairs(item.returns) do
                itemText[#itemText + 1] = value.type .. " " .. (value.text or "")
            end
            for _, form in ipairs(item.forms or {}) do
                itemText[#itemText + 1] = form.signature .. " " .. (form.title or "") .. " " .. form.text
                for _, parts in ipairs({form.params, form.returns}) do
                    for _, part in ipairs(parts) do
                        itemText[#itemText + 1] = part.type .. " " .. part.text
                    end
                end
            end
            entries[
                #entries + 1
            ] = {title = "API › " .. item.name, url = url .. "#" .. item.path, text = table.concat(itemText, " ")}
            for _, member in ipairs(item.members) do
                entries[
                    #entries + 1
                ] = {
                    title = "API › " .. item.name .. "." .. member.name,
                    url = url .. "#" .. member.path,
                    text = member.name .. " " .. (member.type or "") .. " " .. (member.text or ""),
                }
            end
        end
    else
        entries[
            #entries + 1
        ] = {title = candidate.title, url = url, text = (candidate.heroText or "") .. " " .. markdown}
        for _, heading in ipairs(markdownOutline(markdown)) do
            if heading.level ~= 1 then
                entries[
                    #entries + 1
                ] = {
                    title = candidate.title .. " › " .. heading.name,
                    url = url .. "#" .. heading.path,
                    text = heading.name .. " " .. candidate.title,
                }
            end
        end
    end
end

-- The outline follows the page rather than flattening it: a heading written under a
-- section is listed under that section, so a long generated page -- every diagnostic
-- code, every LuaJIT declaration -- opens as the handful of sections it is made of
-- instead of a list of two hundred names with no shape.
-- What a declaration contributes below its own name: every member it documents, and
-- for a nested type the members of that in turn. The page already gives each of them a
-- heading and an anchor, so the outline that omitted them was the one place a record's
-- methods could not be found without scrolling.
local memberOutline: function({extractMod.Member}?): {pageMod.Entry}?

memberOutline = function(members: {extractMod.Member}?): {pageMod.Entry}?
    local entries: {pageMod.Entry} = {}
    for _, member in ipairs(members or {}) do
        entries[
            #entries + 1
        ] = pageMod.Entry(
            path = member.path,
            name = member.name,
            items = memberOutline(member.members),
            column = member.isFunction
        )
    end

    return #entries > 0 and entries or nil
end

local function appendOutline(items: {pageMod.Entry}, markdown: string?)
    for _, heading in ipairs(markdownOutline(markdown)) do
        local parent = items[#items]
        if heading.level > 2 and parent then
            local children = parent.items or {}
            children[#children + 1] = pageMod.Entry(path = heading.path, name = heading.name)
            parent.items = children
        else
            items[#items + 1] = pageMod.Entry(path = heading.path, name = heading.name)
        end
    end
end

----------------------------------------------------------------------------
-- Rendering the site
----------------------------------------------------------------------------

local function renderSite(root, outDir, modules, title, settings, standardLibrary)
    configureScintillua(root, settings)
    local ok, err = copyPublicFiles(root, outDir, settings.public)
    if not ok then
        return nil, err
    end
    local css = THEME
    if settings.customCss then
        local custom
        custom, err = readFile(join(root, tostring(settings.customCss)))
        if not custom then
            return nil, err
        end
        css = css .. "\n" .. custom
    end
    ok, err = writeFile(join(outDir, "assets/style.css"), css)
    if not ok then
        return nil, err
    end
    ok, err = writeFile(join(outDir, "assets/site.js"), SCRIPT)
    if not ok then
        return nil, err
    end
    local pages: {BuiltPage}?
    pages, err = configuredPages(root, settings, title, standardLibrary)
    if not pages then
        return nil, err
    end
    -- A configured page whose route is a module's is that module's overview: prose an
    -- author wants above the generated API, written where prose is written rather than
    -- in a doc comment that would have to hold a page. It is carried onto the module's
    -- own entry rather than kept beside it, so the module keeps its place in the
    -- navigation and one page still answers at that route.
    local configured: {[string]: BuiltPage} = {}
    local moduleRoutes: {[string]: boolean} = {}
    local ordered: {BuiltPage} = {}
    for _, candidate in ipairs(pages) do
        configured[candidate.path] = candidate
    end
    for _, module in ipairs(modules) do
        local route = moduleFile(module.name):gsub("/index%.html$", "")
        if moduleRoutes[route] then
            return nil, "two modules document to the same page: " .. route
        end
        moduleRoutes[route] = true
    end
    for _, candidate in ipairs(pages) do
        if not moduleRoutes[candidate.path] then
            -- A page that documents no module and named itself nothing is shown by its
            -- route, which is at least where the reader is.
            candidate.title = candidate.title or candidate.path
            ordered[#ordered + 1] = candidate
        end
    end
    for _, module in ipairs(modules) do
        local route = moduleFile(module.name):gsub("/index%.html$", "")
        local overview = configured[route]
        ordered[#ordered + 1] = {
            path = route,
            title = overview and overview.title or module.name,
            module = module,
            overview = overview and overview.markdown or nil,
            source = overview and overview.source or nil,
            -- An overview is folded into the module's own page, so the routes it
            -- used to answer at have to come with it or they are dropped here.
            redirects = overview and overview.redirects or nil,
        }
    end
    pages = ordered
    local linkPages = pages as {Page2}
    local navPages = pages as {pageMod.Nav}
    for _, candidate in ipairs(pages) do
        if candidate.module then
            rewriteModuleDocLinks(candidate.module, linkPages, routeFile(candidate.path))
        end
    end

    local generatedLinks: Links = {}
    for _, candidate in ipairs(pages) do
        for name, anchor in pairs(candidate.symbols or {}) do
            generatedLinks[name] = routeFile(candidate.path) .. "#" .. anchor
        end
    end
    local allMarkdown: {{
        page: BuiltPage,
        text: string
    }} = {}
    local linkIndex = symbolLinkIndex(modules, nil, generatedLinks)
    local searchEntries: {SearchEntry} = {}
    for _, candidate in ipairs(pages) do
        local linkCandidate = candidate as Page2
        local file = routeFile(candidate.path)
        local markdown, body, current = candidate.markdown or "", {}, nil
        local items: {pageMod.Entry} = {}
        if candidate.module then
            local module = candidate.module
            local children = childModules(modules, module.name)
            local overview = candidate.overview or ""
            current = module.name
            -- A module's blurb is the page's own prose wherever no overview replaces
            -- it, so whichever of the two is rendered is the one the outline lists.
            appendOutline(items, overview ~= "" and overview or module.text)
            if #children > 0 or #module.items > 0 then
                items[#items + 1] = pageMod.Entry(path = "overview", name = "Overview")
            end
            local groups = itemGroups(module.items)
            for _, group in ipairs(groups) do
                if #group.items > 0 then
                    local entries: {pageMod.Entry} = {}
                    for _, item in ipairs(group.items) do
                        entries[
                            #entries + 1
                        ] = pageMod.Entry(
                            path = item.path,
                            name = item.name,
                            items = memberOutline(item.members),
                            column = item.kind == "function"
                        )
                    end
                    items[
                        #items + 1
                    ] = pageMod.Entry(
                        path = group.path == module.name and group.path .. "-group" or group.path,
                        name = group.title,
                        items = entries
                    )
                end
            end
            local links = symbolLinks(linkIndex, module, relativePrefix(file))
            markdown = doc.markdown({module}, nil, modules, overview, nil, relativePrefix(file), links)
            body[
                #body + 1
            ] = markdownHtml(rewriteConfiguredPageLinks(markdown, linkCandidate, linkPages, file), links, 0)
        else
            local links = symbolLinks(linkIndex, nil, relativePrefix(file))
            appendOutline(items, markdown)
            -- The hero and the feature cards are read straight off the page's markdown
            -- (nupp.tools.doc.home), before the routing table below exists to
            -- rewrite their links against it. Route their links here, the same way the
            -- page's ordinary markdown is routed just below.
            for _, feature in ipairs(candidate.features or {}) do
                if feature.details then
                    feature.details = rewriteConfiguredPageLinks(feature.details, linkCandidate, linkPages, file)
                end
            end
            body[#body + 1] = homeHero(candidate, links, function(href)
                return urlsMod.resolvePageHref(href, linkCandidate, linkPages, file)
            end)
            -- A page whose markdown opens on a heading has named its own subject. One
            -- that does not is a file written for somewhere else, most often a module
            -- overview reused at a second route, and it would otherwise render with no
            -- top-level heading at all.
            if candidate.path ~= "" and markdown ~= "" and not markdown:match("^#%s") then
                body[#body + 1] = "<h1>" .. htmlEscape(candidate.title) .. "</h1>"
            end
            local renderedMarkdown = rewriteConfiguredPageLinks(markdown, linkCandidate, linkPages, file)
            local featureStart, featureEnd
            if candidate.path == "" then
                -- A home page can put its long-form feature tour directly after an
                -- interactive introduction, before its lower-priority link sections.
                featureStart, featureEnd = markdown:find("<!-- nupp:features -->", 1, true)
            end
            if candidate.api and standardLibrary then
                body[#body + 1] = markdownHtml(renderedMarkdown, links, 0)
            elseif featureStart and featureEnd then
                local introduction = rewriteConfiguredPageLinks(
                    markdown:sub(1, featureStart - 1),
                    linkCandidate,
                    linkPages,
                    file
                )
                local remainder = rewriteConfiguredPageLinks(
                    markdown:sub(featureEnd + 1),
                    linkCandidate,
                    linkPages,
                    file
                )
                body[#body + 1] = markdownHtml(introduction, links, 0)
                body[#body + 1] = homeFeatures(candidate, links)
                body[#body + 1] = markdownHtml(remainder, links, 0)
            else
                body[#body + 1] = markdownHtml(renderedMarkdown, links, 0)
            end
            if candidate.path == "" then
                if not featureStart then
                    body[#body + 1] = homeFeatures(candidate, links)
                end
            end
        end
        local html = renderPage(
            candidate.title,
            title,
            table.concat(body, "\n"),
            modules,
            current,
            items,
            file,
            settings,
            navPages,
            candidate.path,
            candidate.layout
        )
        appendSearchEntries(searchEntries, candidate, file, markdown)
        ok, err = writeFile(join(outDir, file), html)
        if not ok then
            return nil, err
        end
        -- A page that moved leaves a stub where it used to answer, so a link
        -- somebody else wrote still arrives rather than 404ing.
        for _, former in ipairs(candidate.redirects or {}) do
            local formerRoute = cleanRoute(former)
            if not formerRoute or formerRoute == "" then
                return nil, "invalid redirect route on page " .. candidate.path
            end
            local formerFile = routeFile(formerRoute)
            ok, err = writeFile(join(outDir, formerFile), redirectHtml(relativePrefix(formerFile) .. file))
            if not ok then
                return nil, err
            end
        end
        local mdFile = candidate.path == "" and "index.md" or candidate.path .. ".md"
        ok, err = writeFile(join(outDir, mdFile), markdown)
        if not ok then
            return nil, err
        end
        if candidate.path ~= "" then
            ok, err = writeFile(join(outDir, candidate.path .. "/llms.txt"), markdown)
            if not ok then
                return nil, err
            end
        end
        allMarkdown[#allMarkdown + 1] = {page = candidate, text = markdown}
    end

    local llms = {"# " .. (settings.name or title), ""}
    if settings.description and settings.description ~= "" then
        llms[#llms + 1] = "> " .. settings.description
        llms[#llms + 1] = ""
    end
    llms[#llms + 1] = "## Documentation"
    for _, entry in ipairs(allMarkdown) do
        local target = entry.page.path == "" and "index.md" or entry.page.path .. "/llms.txt"
        llms[#llms + 1] = "- [" .. (entry.page.title or entry.page.path) .. "](" .. target .. ")"
    end
    llms[#llms + 1] = ""
    llms[#llms + 1] = "- [Complete documentation](llms-full.txt)"
    ok, err = writeFile(join(outDir, "llms.txt"), table.concat(llms, "\n") .. "\n")
    if not ok then
        return nil, err
    end
    local full = {"# " .. (settings.name or title)}
    for _, entry in ipairs(allMarkdown) do
        full[#full + 1] = "\n---\n\n## " .. (entry.page.title or entry.page.path) .. "\n\n" .. trim(entry.text) .. "\n"
    end
    ok, err = writeFile(join(outDir, "llms-full.txt"), table.concat(full, "\n"))
    if not ok then
        return nil, err
    end
    ok, err = writeFile(join(outDir, "assets/search-index.js"), searchIndexJs(searchEntries))
    if not ok then
        return nil, err
    end

    return true
end

----------------------------------------------------------------------------
-- Writing the output
----------------------------------------------------------------------------

local function report(errors)
    for _, err in ipairs(errors) do
        io.stderr:write(
            (
                "%s:%d:%d: error: %s\n"
            ):format(err.filename or "?", err.line or 1, err.col or 1, err.msg or "documentation error")
        )
    end
end

--- Where a documentation target writes when the manifest names no `outDir`.
---
--- `nupp task --list` reports this and `nupp clean` removes it, so the default lives
--- here rather than being spelled again wherever it is needed: a build that writes
--- somewhere the task table does not name is a build clean can miss.
---
--- @param format site, markdown, json, or both
--- @return the path, relative to the project root
function doc.defaultOutDir(format: string?): string
    if format == "markdown" then
        return "docs/api.md"
    elseif format == "json" then
        return "build/docs.json"
    end

    return "build/docs"
end

-- Windows can briefly hold a just-written file open for antivirus scanning, which
-- turns an ordinary removal into a sharing violation moments after the write that
-- produced it. Retry rather than believe the file survives on purpose.
local function removeReplaced(path: string): nil
    for attempt = 1, 20 do
        local removed = os.remove(path)
        if removed then
            return
        end
        local deadline = os.clock() + 0.1
        while os.clock() < deadline do
        end
    end
end

-- Whether a path recorded by an earlier build names something strictly below the
-- output directory. The record is read back from that directory, which may have been
-- committed or unpacked from elsewhere, so it is input rather than state: a prefix
-- test alone passes `site/../victim`, because normalizing keeps `..`.
local function insideOutput(output: string, path: string): boolean
    if path:sub(1, #output + 1) ~= output .. "/" or path:find("%z") then
        return false
    end
    for segment in (path:sub(#output + 2) .. "/"):gmatch("([^/]*)/") do
        if segment == "" or segment == "." or segment == ".." then
            return false
        end
    end

    return true
end

-- A site directory is owned a file at a time rather than wholesale: copied public
-- assets and generated routes share it, and another target may share its parent. Keep
-- the last successful file set inside that directory, remove only its disappeared
-- members, then replace the record. Empty route directories are removed on the way up.
local function reconcileSiteFiles(output: string, written: {string}): boolean?, string?
    local statePath = join(output, ".nupp-doc-files.json")
    local previous: {any} = {}
    local encoded = readFile(statePath)
    if encoded then
        local decoded = json.decodevalue(encoded, json.NULL)
        if type(decoded) == "table" then
            previous = decoded
        end
    end
    local current: {[string]: boolean} = {}
    for _, path in ipairs(written) do
        current[normalize(path)] = true
    end
    for _, entry in ipairs(previous) do
        local path = type(entry) == "string" and normalize(entry) or ""
        if not current[path] and insideOutput(output, path) then
            removeReplaced(path)
            -- A route directory that still holds something is the ordinary case, not a
            -- contended one, and so is every directory above it: stop at the first that
            -- stays rather than retrying it and then each of its parents. Retrying a
            -- directory that is not empty costs two seconds and removes nothing, and a
            -- build that renamed a hundred routes paid it a hundred times.
            local directory = dirname(path)
            while directory ~= output and directory:sub(1, #output + 1) == output .. "/" and os.remove(directory) do
                directory = dirname(directory)
            end
        end
    end
    table.sort(written)

    return filesMod.writeFile(statePath, json.encodevalue(written) .. "\n")
end

--- Generates the documentation a target asked for. Returns the exit code, and the
--- path and format it resolved to.
---
--- The command line assembles its overrides out of parsed option values, so they arrive
--- as a plain table rather than as `doc.BuildOptions`; that is what is read out of it.
--- The manifest's own types are what callers hold: `nupp.tools.build.project` hands
--- over
--- whatever it validated, and a docs target is an ordinary build target with the
--- generator's keys on it. They arrive as those types and are read as the richer ones
--- declared above, which describe the same tables in the detail this module needs.
function doc.build(root: string?, config: Config2, settings: Target?, opts: table?): integer, string?, string?
    root = root or "."
    local config = config as doc.Config
    local settings = (settings or {}) as doc.Settings
    local opts = opts as doc.BuildOptions or {} as doc.BuildOptions
    local modules, errors = loadModules(root, config or {}, settings, opts.sources)
    local standardLibrary = stdlibMod.page(settings.stdlib)
    stdlibMod.merge(modules, standardLibrary)
    if #errors > 0 then
        if opts.diagnostics then
            local collected = opts.diagnostics as {any}
            for _, err in ipairs(errors) do
                collected[#collected + 1] = err
            end
        else
            report(errors)
        end
        return 1
    end
    if opts.checkOnly then
        return 0
    end
    local format = opts.format or settings.format or "site"
    local title = opts.title or settings.title or config.name or "Nupp API"
    -- The manifest's outDir is where its own format goes. Another format asked for
    -- on the command line writes to that format's default rather than over it.
    local configuredOutDir = format == (settings.format or "site") and settings.outDir or nil
    local output = normalize(opts.output or configuredOutDir or doc.defaultOutDir(format))
    output = join(root, output)
    -- Recording is on for the writes below and off again before returning, so a later
    -- caller without a collector cannot inherit this one's.
    local written = opts.written or {}
    filesMod.collect(written)
    local code: integer, message: string? = 0, nil
    if format == "markdown" then
        local ok, err = writeFile(
            output,
            doc.markdown(modules, title, nil, nil, standardLibrary and standardLibrary.annotationItems)
        )
        if not ok then
            code, message = 1, tostring(err)
        end
    elseif format == "site" then
        local ok, err = renderSite(root, output, modules, title, settings, standardLibrary)
        if not ok then
            code, message = 1, tostring(err)
        end
    elseif format == "both" then
        local ok, err = renderSite(root, output, modules, title, settings, standardLibrary)
        if ok then
            ok, err = writeFile(
                join(output, "api.md"),
                doc.markdown(modules, title, nil, nil, standardLibrary and standardLibrary.annotationItems)
            )
        end
        if not ok then
            code, message = 1, tostring(err)
        end
    elseif format == "json" then
        local ok, err = writeFile(output, doc.json(modules, standardLibrary and standardLibrary.annotationItems))
        if not ok then
            code, message = 1, tostring(err)
        end
    else
        code = 2
        message = "documentation format must be site, markdown, json, or both"
    end
    filesMod.collect(nil)
    if code == 0 and (format == "site" or format == "both") then
        local ok, err = reconcileSiteFiles(output, written)
        if not ok then
            code, message = 1, tostring(err)
        end
    end
    if message and opts.diagnostics then
        local collected = opts.diagnostics as {any}
        collected[#collected + 1] = require("nupp.tools.cli.report").runDiagnostic("NUPP0001", message, nil, output)
    elseif message then
        io.stderr:write("nupp: " .. message .. "\n")
    end

    return code, output, format
end

----------------------------------------------------------------------------
-- Targets from the manifest
----------------------------------------------------------------------------

-- A target's own table, plus the name it was declared under. The copy is what keeps a
-- run's overrides off the manifest the caller is still holding.
local function withName(target: doc.Settings, name: string): doc.Settings
    local copy: {[string]: any} = {}
    for key, value in pairs(target as {[string]: any}) do
        copy[key] = value
    end
    copy.targetName = name

    return copy as doc.Settings
end

--- The documentation settings a manifest configured, either as its own `docs` table or
--- as a build target of that kind. Exported because the command line needs to read them
--- before it can let options override them.
---
--- Which target, when a manifest has more than one of them, follows the same order the
--- build resolves by: the requested name, then `build.default`, then the only one there
--- is. A hash order picked a different site to write on consecutive runs, and rendering
--- somewhere the person who asked did not name is worse than saying they have to.
---
--- @param requested the target `--target` named, if it named one
--- @return the settings, or nil and why no single target answers
function doc.manifestSettings(config: doc.Config, requested: string?): doc.Settings?, string?
    local targets: {[string]: doc.Settings} = config.build and config.build.targets or {}
    if requested then
        local target = targets[requested]
        if not target then
            return nil, "unknown build target " .. requested
        end
        if target.kind ~= "docs" then
            return nil, (
                "build target %s is a %s target, not a docs target"
            ):format(requested, tostring(target.kind or "modules"))
        end

        return withName(target, requested)
    end
    if type(config.docs) == "table" then
        return config.docs as doc.Settings
    end
    local found: {{
        name: string,
        target: doc.Settings
    }} = {}
    for name, target in pairs(targets) do
        if type(target) == "table" and target.kind == "docs" then
            found[#found + 1] = {name = name, target = target}
        end
    end
    table.sort(found, function(a, b): boolean
        return a.name < b.name
    end)
    local first = found[1]
    if not first then
        return {}
    end
    if #found > 1 then
        local preferred = config.build and config.build.default or nil
        local target = preferred and targets[preferred] or nil
        if preferred and target and target.kind == "docs" then
            return withName(target, preferred)
        end
        local names: {string} = {}
        for index, entry in ipairs(found) do
            names[index] = entry.name
        end

        return nil, (
            "the manifest has %d docs targets (%s): name one with --target, "
        ):format(#found, table.concat(names, ", ")) .. "or say which the build defaults to with build.default"
    end

    return withName(first.target, first.name)
end

doc.theme = THEME
doc.highlight = highlightMod.nuppSource

export = doc
