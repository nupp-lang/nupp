module nupp.tools.doc.html

--[[
Markdown as HTML.

The Markdown itself is CommonMark with pipe tables, rendered by the provider in
[](nupp.tools.doc.markdownhost) -- `pulldown-cmark` on the VM -- which gets the
things patterns get wrong: nested emphasis, escapes, a link whose URL contains a
bracket, a `*` inside a code span.

What is not the renderer's is the fenced blocks and `:::` containers. A fence here
carries more than a language, taking an optional `[caption]` and `:line-numbers`
with an optional start, and a `::: code-group` gathers several fences into one tabbed
widget. Note, info, tip, warning, danger, see-also, and deep-dive containers
become admonitions whose bodies are still ordinary Markdown. Rather than teach a
Markdown grammar about any of that, every custom region is lifted out before the
renderer sees the document and an HTML comment is left in its place; CommonMark
passes a comment through untouched, so the rendered block goes back exactly where
it came from afterwards.
Reading the fences here also avoids the trap of reading them back out of the
output, where the whole info string has been folded into one class attribute
and `lua [caption]` no longer matches `lua`.

Headings are the other thing kept: the id is Nupp's own slug, and each carries
the anchor link the site's stylesheet expects. The renderer writes a heading as a
plain `<hN>`; each is rewritten afterwards, in order, from the heading read out of
the source. A heading a generated page ends with the kind of what it names --
`` ### `string.format` _function_ `` -- keeps that word out of its text and
renders it as the badge the module pages carry, so the outline beside the page
lists the declaration rather than the declaration and its kind.
]]
const {type Links} = require("nupp.tools.doc.urls")

local stringsMod = require("nupp.tools.doc.strings")
local highlightMod = require("nupp.tools.doc.highlight")
local urlsMod = require("nupp.tools.doc.urls")
local syntax = require("nupp.compiler.syntax.docsyntax")
local markdownhost = require("nupp.tools.doc.markdownhost")

local trim, htmlEscape = stringsMod.trim, stringsMod.htmlEscape
local headingId = stringsMod.headingId
local rewriteSymbolLinks = urlsMod.rewriteSymbolLinks
local codeHtml = highlightMod.codeHtml

local html = {}

--- A heading of a rendered document: the slug it is reachable at, the text as it
--- reads once its markup is stripped, and how deep it sits.
type html.Heading = {
    path: string,
    name: string,
    level: integer
}

local function tableHtml(headers: {string}, rows: {{string}}): string
    local out = {"<table><thead><tr>"}
    for _, header in ipairs(headers) do
        out[#out + 1] = "<th>" .. header .. "</th>"
    end
    out[#out + 1] = "</tr></thead><tbody>"
    for _, row in ipairs(rows) do
        out[#out + 1] = "<tr>"
        for _, cell in ipairs(row) do
            out[#out + 1] = "<td>" .. cell .. "</td>"
        end
        out[#out + 1] = "</tr>"
    end
    out[#out + 1] = "</tbody></table>"

    return table.concat(out)
end

local function kindClass(kind: string): string
    local class = kind:gsub("[^%w_-]+", "-")
    return (htmlEscape(class))
end

local function kindBadge(kind: string): string
    return '<span class="nuppdoc-kind-badge nuppdoc-kind-' .. kindClass(kind) .. '">' .. htmlEscape(kind) .. "</span>"
end

-- A generated API heading names a declaration and then says in one word what it is:
-- `` ### `string.format` _function_ ``. The word is a badge rather than part of the
-- name, so it is split off here. The outline and the search index then list the
-- declaration under the name a reader was looking for, and the heading renders the word
-- as the same pill the module pages carry instead of as trailing italics.
--
-- The shape is what the generated pages write and what nothing else does: a code span,
-- then emphasis holding lowercase words and nothing after it.
local function headingBadge(heading: string): string, string?
    local name, _, kind = heading:match("^(.-`[^`]+`)%s+([_*])([%l][%l ]*)%2$")
    if not name then
        return heading, nil
    end

    return name, kind
end

local function markdownOutline(text: string?): {html.Heading}
    local out, fenced = {}, nil
    for _, line in ipairs(syntax.lines:match(tostring(text or "")) or {}) do
        local marker
        fenced, marker = syntax.fenceState(line, fenced, true)
        if not marker and not fenced then
            local hashes, heading = syntax.heading:match(line)
            if hashes and heading and #hashes <= 3 then
                local name = headingBadge(heading)
                -- The slug still comes from the whole heading, badge and all: the page
                -- has been anchoring its declarations that way, and the name alone
                -- collides with the anchor a generated page writes above the heading.
                out[#out + 1] = {path = headingId(heading), name = name:gsub("[`*_]", ""), level = #hashes}
            end
        end
    end

    return out
end

local codeGroupIndex = 0
local markdownHtml: (function(text: string?, links: Links?, headingShift: integer?): string)

local ADMONITION_TITLES = {
    note = "Note",
    info = "Info",
    tip = "Tip",
    warning = "Warning",
    danger = "Danger",
    seealso = "See also",
    deepdive = "Dive deeper",
}

-- A deep dive is the one admonition a reader chooses to open. It answers a question
-- the page did not raise, so it is collapsed: the reader following a task scrolls past
-- it, and the reader who stopped to wonder gets it in one click.
local COLLAPSED = {deepdive = true}

-- `:line-numbers` on the fence, optionally `:line-numbers=12` when the excerpt starts
-- somewhere other than the top of a file.
local function lineNumberStart(options)
    local start = options and syntax.lineNumber:match(options)
    return start and (tonumber(start) as integer?) or nil
end

-- A gutter beside the code rather than numbers woven into it: a highlighted token can
-- span lines, and splitting the markup to number each one would cut it in half.
local function lineNumbersHtml(source, start)
    local out, number = {'<span class="nuppdoc-line-numbers" aria-hidden="true">'}, start
    for _ in (source .. "\n"):gmatch("(.-)\n") do
        out[#out + 1] = "<span>" .. tostring(number) .. "</span>"
        number = number + 1
    end
    out[#out + 1] = "</span>"

    return table.concat(out)
end

local function codeBlockHtml(source, language, links, firstLine)
    language = language ~= "" and language or "text"
    return '<div class="nuppdoc-code-block' .. (
        firstLine and " has-line-numbers" or ""
    ) .. '" data-lang="' .. htmlEscape(
        language
    ) .. '"><pre>' .. (
        firstLine and lineNumbersHtml(source, firstLine) or ""
    ) .. '<code class="language-' .. htmlEscape(
        language
    ) .. '">' .. codeHtml(source, language, links) .. "</code></pre></div>"
end

local function codeGroupHtml(blocks, links)
    local captioned = false
    for _, block in ipairs(blocks) do
        captioned = captioned or block.caption ~= nil
    end
    if not captioned then
        local out = {'<div class="nuppdoc-code-group" role="group">'}
        for _, block in ipairs(blocks) do
            out[#out + 1] = codeBlockHtml(block.source, block.language, links, block.firstLine)
        end
        out[#out + 1] = "</div>"
        return table.concat(out)
    end
    codeGroupIndex = codeGroupIndex + 1
    local name = "nuppdoc-code-group-" .. tostring(codeGroupIndex)
    local out = {'<div class="nuppdoc-code-group" role="radiogroup"' .. ' aria-label="Code examples">'}
    -- The tab inputs and labels live in their own row, separate from the
    -- panels: that's what lets the row scroll horizontally on overflow
    -- (see .nuppdoc-code-tabs in the theme) instead of wrapping tabs onto a
    -- second line, which read as broken for long captions like file paths.
    out[#out + 1] = '<div class="nuppdoc-code-tabs">'
    for index, block in ipairs(blocks) do
        -- A fence that named no caption still gets a tab, titled by its
        -- language, rather than silently vanishing from the group.
        local id = name .. "-" .. tostring(index)
        out[
            #out + 1
        ] = '<input class="nuppdoc-code-tab-input" type="radio"' .. ' name="' .. name .. '" id="' .. id .. '"' .. (
            index == 1 and " checked" or ""
        ) .. '><label class="nuppdoc-code-tab" for="' .. id .. '">' .. htmlEscape(
            block.caption or block.language
        ) .. "</label>"
    end
    out[#out + 1] = "</div>"
    for _, block in ipairs(blocks) do
        out[
            #out + 1
        ] = '<figure class="nuppdoc-code-panel">' .. codeBlockHtml(
            block.source,
            block.language,
            links,
            block.firstLine
        ) .. "</figure>"
    end
    out[#out + 1] = "</div>"

    return table.concat(out)
end

local function admonitionHtml(kind, title, source, links)
    title = title ~= "" and title or ADMONITION_TITLES[kind]
    local body = '<div class="nuppdoc-admonition-body">' .. markdownHtml(source, links) .. "</div>"
    local classes = "nuppdoc-admonition nuppdoc-admonition-" .. htmlEscape(kind)
    if COLLAPSED[kind] then
        return '<details class="' .. classes .. '"><summary class="nuppdoc-admonition-title">' .. htmlEscape(
            title
        ) .. "</summary>" .. body .. "</details>"
    end

    return '<aside class="' .. classes .. '" aria-label="' .. htmlEscape(
        title
    ) .. '">' .. '<p class="nuppdoc-admonition-title">' .. htmlEscape(title) .. "</p>" .. body .. "</aside>"
end

-- Reads one fence, starting at its opening line, and returns the block it describes
-- plus the index of the line after its closer.
--
-- The closer has to be at least as long as the opener, which is how a page shows a
-- fenced block: four backticks around three. Closing on any run of three instead ends
-- the outer block at the inner one's first line and leaves its closer opening a block
-- that swallows the rest of the page.
local function readFence(lines: {string}, index: integer): (any?, integer)
    local _, fence, rest = syntax.markdownFence:match(lines[index])
    if not fence then
        return nil, index
    end
    local language, options = syntax.fenceInfo:match(rest or "")
    options = trim(options or "")

    local function closes(line)
        local _, closer, closerRest = syntax.markdownFence:match(line)
        return syntax.closes(fence, closer, closerRest)
    end

    local code = {}
    index = index + 1
    while index <= #lines and not closes(lines[index]) do
        code[#code + 1] = lines[index]
        index = index + 1
    end

    return {
        language = language ~= "" and language or "text",
        caption = syntax.caption:match(options),
        firstLine = lineNumberStart(options),
        source = table.concat(code, "\n"),
    }, index + 1
end

-- Reads a `:::` region while respecting nested containers and fenced code. The inner
-- source is handed back to markdownHtml, so an admonition does not create a second,
-- less capable Markdown dialect.
local function readContainer(lines: {string}, index: integer): (string?, integer)
    local body, depth, fenced = {}, 1, nil
    index = index + 1
    while index <= #lines do
        local line = lines[index]
        local marker
        fenced, marker = syntax.fenceState(line, fenced, true)
        if not marker and not fenced then
            local marker = trim(line)
            if marker == ":::" then
                depth = depth - 1
                if depth == 0 then
                    return table.concat(body, "\n"), index + 1
                end
            elseif marker:match("^:::%s+[%w-]+") then
                depth = depth + 1
            end
        end
        body[#body + 1] = line
        index = index + 1
    end

    return nil, index
end

-- Lifts every fenced region out of the document, rendering each and leaving a comment
-- in its place. Markdown has nothing to say about a comment, so it arrives in the
-- output untouched and is swapped back for the block.
local function extractBlocks(text, links, rendered)
    local lines, out = syntax.lines:match(text) or {}, {}
    local index: integer = 1

    local function placeholder(markup)
        rendered[#rendered + 1] = markup
        out[#out + 1] = ""
        out[#out + 1] = ("<!--nuppdoc-block-%d-->"):format(#rendered)
        out[#out + 1] = ""
    end

    while index <= #lines do
        local line = lines[index]
        local marker = trim(line)
        local directive, title = syntax.directive:match(line)
        title = trim(title or "")
        if marker == "::: code-group" then
            local blocks = {}
            index = index + 1
            while index <= #lines and trim(lines[index]) ~= ":::" do
                local block, after = readFence(lines, index)
                if block then
                    blocks[#blocks + 1] = block
                    index = after
                else
                    index = index + 1
                end
            end
            placeholder(codeGroupHtml(blocks, links))
        elseif marker == "::: columns" then
            local body, after = readContainer(lines, index)
            if body then
                index = after - 1

                local groups: {{string}} = {}
                for _, bodyLine in ipairs(syntax.lines:match(body) or {}) do
                    if bodyLine:match("^##%s") then
                        groups[#groups + 1] = {}
                    end
                    if #groups > 0 then
                        local current = groups[#groups]
                        current[#current + 1] = bodyLine
                    end
                end

                local sections = {}
                for _, group in ipairs(groups) do
                    sections[
                        #sections + 1
                    ] = '<div class="nuppdoc-column">' .. markdownHtml(table.concat(group, "\n"), links, 0) .. "</div>"
                end

                placeholder('<div class="nuppdoc-columns">' .. table.concat(sections) .. "</div>")
            else
                out[#out + 1] = line
            end
        elseif directive and ADMONITION_TITLES[directive] then
            local body, after = readContainer(lines, index)
            if body then
                index = after - 1
                placeholder(admonitionHtml(directive, title, body, links))
            else
                out[#out + 1] = line
            end
        elseif syntax.markdownFence:match(lines[index]) then
            local block, after = readFence(lines, index)
            index = after - 1
            local markup = codeBlockHtml(block.source, block.language, links, block.firstLine)
            if block.caption then
                markup = '<figure class="nuppdoc-labeled-code"><figcaption>' .. htmlEscape(
                    block.caption
                ) .. '</figcaption>' .. markup .. '</figure>'
            end
            placeholder(markup)
        else
            out[#out + 1] = line
        end
        index = index + 1
    end

    return table.concat(out, "\n")
end

-- The slug of each heading, in the order they appear, and the document with the kind
-- badges taken out of them. The renderer's heading holds rendered content, which is
-- HTML by then; the id has to come from the source text, so it is computed here and
-- matched up by position. A badge is lifted for the same reason -- emphasis
-- the grammar rendered would be part of the heading's text, and the writer puts it back
-- as a pill once the name has been rendered without it.
local function headingSlugs(text)
    local slugs, out = {}, {}
    for line in (text .. "\n"):gmatch("(.-)\n") do
        local hashes, heading = line:match("^(#+)%s+(.+)$")
        if hashes then
            local name, badge = headingBadge(heading)
            -- The label is read aloud by a screen reader following the anchor, so it is
            -- the heading as it reads rather than as it was written.
            slugs[#slugs + 1] = {id = headingId(heading), text = name:gsub("[`*_]", ""), badge = badge}
            out[#out + 1] = badge and hashes .. " " .. name or line
        else
            out[#out + 1] = line
        end
    end

    return slugs, table.concat(out, "\n")
end

-- The renderer's `<hN>` headings, in order, rewritten with the id, badge and
-- anchor the source heading at the same position calls for, and moved down
-- `shift` levels.
local function rewriteHeadings(rendered: string, headings: {any}, shift: integer): string
    local index: integer = 0
    return (rendered:gsub("<h([1-6])>(.-)</h%1>", function(depth: string, content: string): string
        index = index + 1
        local heading = headings[index]
        local id = heading and heading.id or "section"
        local label = heading and heading.text or ""
        local level = tostring(math.min((tonumber(depth) as integer) + shift, 6))

        return "<h" .. level .. ' id="' .. htmlEscape(
            id
        ) .. '">' .. content .. (
            heading and heading.badge and kindBadge(heading.badge) or ""
        ) .. '<a class="nuppdoc-header-anchor" href="#' .. htmlEscape(
            id
        ) .. '" aria-label="Link to ' .. htmlEscape(label) .. '">#</a></h' .. level .. ">"
    end))
end

markdownHtml = function(text: string?, links: Links?, headingShift: integer?): string
    -- A Windows checkout hands the page to us with CRLF endings. The fenced-block
    -- pass is line-oriented and rebuilds its input with LF, so normalize before it
    -- sees a stray carriage return.
    text = tostring(text or ""):gsub("\r\n?", "\n")
    if text == "" then
        return ""
    end
    local rendered = {}
    local prepared = extractBlocks(text .. "\n", links, rendered)
    -- After the fences are lifted out, so that a link written inside a code block is
    -- code rather than a reference, and before the renderer, so that what it reads is
    -- an ordinary markdown link by then.
    if links then
        prepared = rewriteSymbolLinks(prepared, function(name: string): string?
            return links[name]
        end)
    end
    local slugs, withoutBadges = headingSlugs(prepared)
    local document, problem = markdownhost.render(withoutBadges .. "\n")
    if document == nil then
        error("nupp doc cannot render Markdown: " .. tostring(problem), 0)
    end
    local out = rewriteHeadings(document, slugs, headingShift == nil and 1 or headingShift)
    out = out:gsub("<!%-%-nuppdoc%-block%-(%d+)%-%->", function(index)
        -- A block's markup is returned by a function so that a `%` in it is never read
        -- as a capture reference.
        return rendered[tonumber(index) as integer] or ""
    end)

    return trim(out)
end

-- The same renderer where a paragraph would be in the way: a summary in a table cell is
-- a sentence, not a block. Only a document that is exactly one paragraph is unwrapped,
-- so anything longer keeps its structure.
local function inlineHtml(text: string?, links: Links?): string
    local out = markdownHtml(text, links)
    local inner = out:match("^<p>(.*)</p>$")
    if inner and not inner:find("<p>", 1, true) then
        return inner
    end

    return out
end

html.tableHtml = tableHtml

--- What a declaration is, as the pill that sits beside its name: the badge a module
--- page carries and a generated page's heading ends with.
---
--- @param kind the one word the badge reads, such as `function` or `record`
--- @return the badge's markup
html.kindBadge = kindBadge

html.markdownHtml = markdownHtml
html.inlineHtml = inlineHtml
html.markdownOutline = markdownOutline

export = html
