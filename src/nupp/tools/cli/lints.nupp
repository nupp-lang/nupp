module nupp.tools.cli.lints

--[[
`nupp lints`: the lints, and the level each one runs at here.

The levels reported are the project's own, not the defaults, so what prints is
what would be enforced in this tree. A lint whose level a project moved says so
beside its summary, since the difference is the thing worth noticing.
]]

local ansi = require("nupp.cli")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        lints = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    name = {type = "string", description = "What an @allow suppression writes."},
                    code = {
                        type = "string",
                        description = "The diagnostic code it reports under, "
                        .. "which survives the name being reconsidered."
                    },
                    category = {type = "string"},
                    level = {
                        type = "string",
                        enum = {"off", "note", "warning", "error"},
                        description = "The level this project runs it at."
                    },
                    default = {
                        type = "string",
                        enum = {"off", "note", "warning", "error"},
                        description = "The level it runs at when a project " .. "says nothing."
                    },
                    moved = {type = "boolean", description = "Whether this project moved it off " .. "its default."},
                    summary = {type = "string"},
                },
                required = {"name", "code", "category", "level", "default", "moved", "summary"},
            },
        },
    },
    required = {"lints"},
}

-- A level is a severity in everything but name, so it is painted like one; the two
-- levels that are not severities are the two that do not report anything.
local LEVEL_SEVERITY = {error = "error", warning = "warning", note = "note",}

--- A level that is not a severity is one that reports nothing, and is painted faint
--- rather than in a colour that would claim it does.
local function levelPaint(style: cliModule.Style, level: string): function(string): string
    local severity = LEVEL_SEVERITY[level]

    return severity ~= nil and ansi.severity(style, severity) or style.faint
end

local function run(options: any): integer
    local lints = require("nupp.compiler.lints")
    local project = require("nupp.tools.build.project")
    -- The project's own configuration, so what prints is what would be enforced here
    -- rather than what the defaults would have said. A directory with no `nupp.lua`
    -- is a supported configuration, answered with the default levels; only a
    -- manifest that exists and cannot be loaded is an error.
    local config: any = nil
    if require("nupp.compiler.fs").exists("nupp.lua") then
        local loaded, err = project.loadManifest(".")
        if not loaded then
            io.stderr:write(tostring(err) .. "\n")
            return 1
        end
        config = loaded
    end
    local lintConfig = config and config.lints or nil
    local style = ansi.style(io.stdout)
    local rows: {any} = {}
    for _, lint in ipairs(lints.all) do
        local level = lints.level(lint, lintConfig)
        rows[
            #rows + 1
        ] = {
            name = lint.name,
            code = lint.code,
            category = lint.category,
            level = level,
            summary = lint.summary,
            default = lint.level,
            moved = level ~= lint.level,
        }
    end
    table.sort(rows, function(a: any, b: any): boolean
        return a.name < b.name
    end)
    if options.format == "json" then
        require("nupp.tools.cli.report").write({lints = rows})
        return 0
    end
    local cells: {{cliModule.Cell}} = {}
    for _, row in ipairs(rows) do
        -- The default a project moved a lint off is an aside on the summary rather
        -- than a column, because it is absent from nearly every row.
        local note: string? = nil
        if row.moved then
            note = (" (default %s)"):format(row.default)
        end
        cells[
            #cells + 1
        ] = {
            cliModule.paintedCell(row.name, style.strong),
            cliModule.paintedCell(row.category, style.faint),
            cliModule.paintedCell(row.level, levelPaint(style, row.level)),
            new cliModule.Cell(text = row.summary, note = note),
        }
    end
    cliModule.writeTable(
        io.stdout,
        {
            columns = {
                {heading = "lint"},
                {heading = "category"},
                {heading = "level", minimumWidth = 7},
                {heading = "summary"},
            },
            rows = cells,
            style = style,
        } as cliModule.TableOptions
    )

    return 0
end

--- List the lints and the level each runs at.
---
--- Levels are off, note, warning and error; only an error stops a build.
---
--- Examples:
---
---     nupp lints
---     nupp lints --json
@cli("lints")
@derive(cliModule.Command)
local record Lints
    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    function run(self): integer
        return run(self)
    end
end

function Lints.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Lints}
