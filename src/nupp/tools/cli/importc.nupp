module nupp.tools.cli.importc

--[[
`nupp import-c`: a C header, as typed Nupp declarations.

What comes out is a module rather than a declaration file: its cdef statements
generate the ffi bindings at runtime, so the result is something a program
requires, not something the checker merely reads.
]]

local usageError = require("nupp.tools.cli.error").forCommand("import-c")
local cliModule = require("nupp.cli")
local report = require("nupp.tools.cli.report")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = report.OK,
        output = {
            type = "string",
            description = "Where the generated module was written. Absent " .. "when nothing was generated."
        },
        diagnostics = {
            type = "array",
            items = report.DIAGNOSTIC,
            description = "Why the import failed, as errors, and what the header "
            .. "contained that the bindings could not represent, as warnings. "
            .. "A warning is not a failure.",
        },
        bridgeOutput = {type = "string"},
        direct = {type = "integer"},
        bridged = {type = "integer"},
        skipped = {type = "integer"},
        dispositions = {type = "array", items = {type = "object"}},
    },
    required = {"ok", "diagnostics"},
}

--- One importer message as a diagnostic: a warning at the header line it names, when
--- it names one.
local function warningDiagnostic(header: string, warning: string): {[string]: any}
    local line, message = warning:match("^[^:]+:(%d+): (.*)$")
    return {filename = header, line = line and tonumber(line) or nil, severity = "warning", msg = message or warning,}
end

-- An inspection writes nothing, so a header outside every root still names a
-- module: its basename in the lowercase luacase a module segment is held to.
local function headerModuleName(header: string): string
    local base = (header:match("([^/\\]+)$") or header):gsub("%.[^.]*$", "")
    local name = base:lower():gsub("[^a-z0-9]", "")
    if not name:match("^[a-z]") then
        name = "c" .. name
    end

    return name
end

--- A relative output path with its `name/..` pairs folded away.
---
--- The module is named from the path's spelling, and `src/../src/x.nupp` spelled
--- the module `src....src.x`. The folding is here rather than where a path is
--- named in general, because a source loaded as `tests/../src/...` keeps the name
--- its spelling gives it, and this is a path the command is about to create. A
--- path that climbs out of the working directory keeps its leading `..`, which
--- is what refuses it below.
local function foldOutput(path: string): string
    local normalized = (path:gsub("\\", "/"))
    if normalized:sub(1, 1) == "/" or normalized:match("^[A-Za-z]:/") then
        return path
    end
    local parts: {string} = {}
    for part in normalized:gmatch("[^/]+") do
        if part == ".." and #parts > 0 and parts[#parts] ~= ".." then
            parts[#parts] = nil
        elseif part ~= "." then
            parts[#parts + 1] = part
        end
    end

    return table.concat(parts, "/")
end

local function run(options: any): integer
    local positional: {string} = {options.header}
    local paths: {string} = positional
    if #paths ~= 1 then
        return usageError("exactly one C header is required")
    end
    local header = paths[1]
    local asJson = options.format == "json"
    local reportMod = require("nupp.tools.cli.report")
    local importc = require("nupp.compiler.cinterop.importc")
    local out = options.output and foldOutput(options.output) or (headerModuleName(header) .. ".nupp")
    local config = require("nupp.tools.build.manifest").load(".")
    local envMod = require("nupp.compiler.project.env")
    local moduleName = envMod.moduleNameInRoots(envMod.projectRoots(".", config), out)
    if not options.inspect and not moduleName then
        return usageError("output must be a .nupp file beneath the project root or an include root")
    end
    -- The path names the module, and a module segment is lowercase luacase, so a path
    -- that spells anything else names a module no build accepts.
    if not options.inspect then
        for segment in (moduleName as string):gmatch("[^.]+") do
            if not segment:match("^[a-z][a-z0-9]*$") then
                local escaped = segment:gsub("%p", "%%%0")
                local suggested = out:gsub(escaped .. "(%.g%.nupp)$", headerModuleName(segment) .. "%1")
                suggested = suggested:gsub(escaped .. "(%.nupp)$", headerModuleName(segment) .. "%1")
                local problem = (
                    "%s names module segment %q; module segments are lowercase luacase"
                ):format(out, segment)
                return usageError(suggested ~= out and problem .. ", such as " .. suggested or problem)
            end
        end
    end
    local text, warnings, details = importc.import(header, {
        module = moduleName or headerModuleName(header),
        lib = options.lib,
        bridge = options.bridgeOut ~= nil,
    })

    local function diagnosticsOf(): {any}
        local values: {any} = {}
        for _, warning in ipairs(warnings) do
            values[#values + 1] = warningDiagnostic(header, warning)
        end

        return values
    end

    if not text then
        -- The importer's reason for producing nothing is its only message: the header
        -- could not be read, or the C preprocessor produced nothing from it.
        if asJson then
            local reason = tostring(warnings[1] or "cannot import " .. header)
            local code = reason:find("^cannot read ") and report.UNREADABLE or report.TOOL_FAILED
            return report.failure(REPORT_SCHEMA, {report.runDiagnostic(code, reason, nil, header)})
        end
        for _, warning in ipairs(warnings) do
            io.stderr:write("nupp: " .. warning .. "\n")
        end

        return 1
    end
    if not asJson then
        for _, warning in ipairs(warnings) do
            io.stderr:write("nupp: warning: " .. warning .. "\n")
        end
    end
    if options.inspect then
        if asJson then
            reportMod.write({
                ok = true,
                diagnostics = reportMod.diagnosticValues(diagnosticsOf()),
                direct = details and details.direct or 0,
                bridged = details and details.bridged or 0,
                skipped = details and details.skipped or 0,
                dispositions = details and details.dispositions or {},
            })
        else
            io.write(
                (
                    "direct %d, bridged %d, skipped %d\n"
                ):format(
                    details and details.direct or 0,
                    details and details.bridged or 0,
                    details and details.skipped or 0
                )
            )
        end

        return 0
    end

    -- Written with the result checked, so a full disk is a failed command rather
    -- than a truncated header reported as success. Text mode has already printed
    -- the warnings above; routing a failure through fail() would print them all
    -- again, restyled as errors.
    local fs = require("nupp.compiler.fs")

    local function write(path: string, content: string): integer?
        local wrote, writeErr = fs.writeFile(path, content)
        if wrote then
            return nil
        end
        if asJson then
            local values = diagnosticsOf()
            values[#values + 1] = report.fileDiagnostic(path, writeErr, "check that the output path is writable")
            return report.failure(REPORT_SCHEMA, values)
        end
        io.stderr:write("nupp: " .. tostring(writeErr) .. "\n")

        return 1
    end

    local bridgeOut = options.bridgeOut
    if bridgeOut and details and details.bridgeSource then
        local stopped = write(bridgeOut, details.bridgeSource)
        if stopped then
            return stopped
        end
    end
    -- Written in the one spelling `nupp fmt` produces, so the module passes the
    -- project's own format check from the moment it lands.
    local fmt = require("nupp.tools.fmt")
    local env = envMod.new(".", {config = config})
    local formatted, formatErrors = fmt.format(text, out, {
        environment = env,
        annotations = env.annotations,
        methodParens = envMod.fmtMethodParensDefault(env)
    })
    if #formatErrors == 0 then
        text = formatted
    end
    local stopped = write(out, text)
    if stopped then
        return stopped
    end
    if asJson then
        reportMod.write({
            ok = true,
            output = out,
            bridgeOutput = bridgeOut and details and details.bridgeSource and bridgeOut or nil,
            diagnostics = reportMod.diagnosticValues(diagnosticsOf()),
            direct = details and details.direct or 0,
            bridged = details and details.bridged or 0,
            skipped = details and details.skipped or 0,
            dispositions = details and details.dispositions or {},
        })
    else
        io.write(out .. "\n")
    end

    return 0
end

--- Generate typed Nupp bindings from a C header.
---
--- Examples:
---
---     nupp import-c include/widget.h
---     nupp import-c -l widget -o src/widget.nupp include/widget.h
---     nupp import-c --inspect --json include/widget.h
@cli("import-c")
@derive(cliModule.Command)
local record ImportC
    --- Write the generated module to this file.
    @cli(short = "o", value = "FILE")
    output: string?

    --- Name the native library loaded by the bindings.
    @cli(short = "l", value = "NAME")
    lib: string?

    --- Emit C wrappers for eligible static inline functions.
    @cli(value = "FILE")
    bridgeOut: string?

    --- Report declaration dispositions without writing output.
    inspect: boolean = false

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- C header to import.
    @cli(positional = "HEADER")
    header: string

    function run(self): integer
        return run(self)
    end
end

function ImportC.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = ImportC}
