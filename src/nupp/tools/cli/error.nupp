module nupp.tools.cli.error

local terminal = require("nupp.cli")

local errors = {}

--- Wraps prose without breaking long words such as option names and paths.
function errors.wrap(text: string, width: integer): {string}
    local lines: {string} = {}
    local line = ""
    for word in text:gmatch("%S+") do
        if line == "" then
            line = word
        elseif #line + #word + 1 <= width then
            line = line .. " " .. word
        else
            lines[#lines + 1] = line
            line = word
        end
    end
    if line ~= "" then
        lines[#lines + 1] = line
    end

    return lines
end

--- A message as the command line prints it: under `nupp:`, unless it already says
--- that. Library errors carry the prefix themselves, raised at level 0 as `nupp: ...`
--- or with a position as `file:line: nupp: ...`, and a second one in front reads as
--- two tools reporting one failure.
function errors.message(text: unknown): string
    local message = tostring(text)
    if message:find("^nupp:") or message:find("^[^\n]-:%d+: nupp:") then
        return message
    end

    return "nupp: " .. message
end

--- Builds the compiler's status-2 diagnostic for semantic argument combinations.
--- Lexical and conversion failures are rendered by `cli.Application` before a
--- command record is constructed.
function errors.forCommand(name: string): function(string?): integer
    return function(message: string?): integer
        local style = terminal.style(io.stderr)
        io.stderr:write(
            terminal.severity(
                style,
                "error"
            )(
                "nupp:"
            ) .. " " .. tostring(message) .. "\nTry '" .. style.strong("nupp help " .. name) .. "' for usage.\n"
        )

        return 2
    end
end

export = errors
