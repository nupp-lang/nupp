module nupp.tools.cli.bc

--[[
`nupp bc`: the bytecode a file compiles to, beside the source that made it.

The listing is of the VM image the file lowers to, shown against the source that
made it. That answers a question a typed language gets asked: what did the
annotations cost? Usually nothing, and the instructions say so more convincingly
than a benchmark does, on any machine, with no warm-up.

Only the VM-hosted compiler can answer it: the image is what that compiler
produces, so a LuaJIT-hosted run says so and stops.
]]

local usageError = require("nupp.tools.cli.error").forCommand("bc")
local report = require("nupp.tools.cli.report")
local listing = require("nupp.tools.bytecodelisting")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    description = "The bytecode of one Nupp file, by function.",
    properties = {
        ok = report.OK,
        diagnostics = report.DIAGNOSTICS,
        file = {type = "string"},
        backend = {type = "string", enum = {"vm"}},
        optLevel = {type = "integer"},
        functions = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    what = {type = "string", enum = {"chunk", "function"}},
                    firstLine = {type = "integer"},
                    lastLine = {type = "integer"},
                    instructions = {
                        type = "array",
                        items = {
                            type = "object",
                            properties = {
                                pc = {type = "integer"},
                                op = {type = "string"},
                                text = {type = "string"},
                                line = {type = "integer"},
                                inLoop = {type = "boolean"},
                            },
                            required = {"pc", "op", "text"},
                        },
                    },
                },
                required = {"what", "instructions"},
            },
        },
    },
    required = {"ok", "file", "diagnostics", "functions"},
}

--- How many columns the listing may use.
---
--- A terminal is asked how wide it is, so the file gets whatever room the window
--- has. Anything else -- a pipe, a file, a CI log -- gets the default rather
--- than a width that would make the same command produce different bytes on
--- different machines.
local function width(options: any): integer?
    if options.width ~= nil and options.width > 0 then
        return math.floor(options.width)
    end

    return cliModule.colorEnabled(io.stdout) and cliModule.columns(io.stdout) or nil
end

--- The listing's colors, wired from the terminal highlighter.
---
--- The source is highlighted once, here, rather than a line at a time inside the
--- rendering: classifying a Nupp line needs the file around it, and the listing
--- echoes a line wherever the instructions for it fall.
---
--- The highlighter is asked for here rather than at the top of this module
--- because it reaches the lexer and the parser, and requiring a command module
--- is how the CLI reads its grammar -- `nupp --help` must not load a compiler to
--- print a list of commands.
local function palette(source: string): listing.Palette
    local paint = require("nupp.tools.terminalhighlight")
    local colors = paint.palette(cliModule.colorEnabled(io.stdout))
    local rows = paint.rows(source)

    return {
        source = function(at: integer, text: string, column: integer): string
            return paint.paintRow(rows[at], text, colors, column, listing.TRUNCATED)
        end,
        gutter = function(text: string): string
            return paint.paint(colors, "comment", text)
        end,
        instruction = function(text: string): string
            return paint.bytecode(text, colors)
        end,
    }
end

local function run(options: any): integer
    local positional: {string} = {options.file}
    local paths: {string} = positional
    if #paths ~= 1 then
        return usageError("exactly one source file is required")
    end
    local path = paths[1]
    local asJson = (options.format or "text") == "json"
    local collected: {any}? = asJson and {} or nil

    -- Under `--json` a refusal is the one document the reader was promised, with the
    -- reason in it; otherwise it is the line of text it always was.
    local function fail(code: string?, message: string?): integer
        if collected then
            if code ~= nil then
                collected[#collected + 1] = report.runDiagnostic(code, message or "", nil, path)
            end
            return report.failure(REPORT_SCHEMA, collected, {file = path})
        end
        if message ~= nil then
            io.stderr:write(require("nupp.tools.cli.error").message(message) .. "\n")
        end

        return 1
    end

    local source, problem = require("nupp.compiler.fs").readFile(path)
    if not source then
        report.fileFailure(path, problem, "check that the path exists and is readable", collected)
        return fail()
    end
    if not rawget(_G, "__nupp_load_image") then
        return fail(report.TOOL_FAILED, "bytecode inspection needs the VM-hosted compiler")
    end
    if (require("nupp.tools.cli.compile").settings(options).optLevel or 0) ~= 0 then
        return fail(report.TOOL_FAILED, "VM bytecode inspection does not use Lua optimization levels")
    end
    local ok, functions = pcall(require("nupp.tools.vm.project").inspect, ".", path)
    if not ok then
        return fail(report.TOOL_FAILED, tostring(functions))
    end
    if asJson then
        io.write(
            report.encode({
                ok = true,
                file = path,
                backend = "vm",
                optLevel = 0,
                diagnostics = {},
                functions = functions
            }) .. "\n"
        )
    else
        io.write((listing.render(functions, source, {width = width(options), palette = palette(source)})))
    end

    return 0
end

--- Show the bytecode a Nupp file compiles to.
---
--- Source lines are shown beside their instructions.
---
--- Examples:
---
---     nupp bc src/main.nupp
---     nupp bc --json src/main.nupp
@cli("bc")
@derive(cliModule.Command)
local record Bytecode
    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Optimization level, matching run and build (default -O0).
    @cli(
        name = "O",
        long = false,
        pattern = "^%-O([0-2])$",
        choices = {"0", "1", "2"},
        display = "-O0, -O1, -O2",
        value = "LEVEL"
    )
    optLevel: string?

    --- Columns the listing may use. Defaults to the terminal's width.
    @cli(value = "COLUMNS")
    width: integer = 0

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Source file to inspect.
    @cli(positional = "FILE")
    file: string

    function run(self): integer
        return run(self)
    end
end

function Bytecode.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Bytecode}
