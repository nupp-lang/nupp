module nupp.tools.cli.migrate

-- `nupp migrate`: one extension-dispatched path from foreign source facts into Nupp.

local usageError = require("nupp.tools.cli.error").forCommand("migrate")
local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    properties = {
        ok = {type = "boolean"},
        check = {type = "boolean"},
        migrations = {
            type = "array",
            items = {
                type = "object",
                properties = {
                    source = {type = "string"},
                    destination = {type = "string"},
                    dialect = {type = "string"},
                    text = {type = "string"},
                    edits = {type = "array", items = {type = "object"}},
                    warnings = {type = "array", items = {type = "object"}},
                    written = {type = "boolean"},
                },
                required = {"source", "destination", "dialect", "edits", "warnings", "written"},
            },
        },
        errors = {type = "array", items = {type = "string"}},
    },
    required = {"ok", "check", "migrations", "errors"},
}

local function publicPlan(plan: any, written: boolean, includeText: boolean): any
    return {
        source = plan.source,
        destination = plan.destination,
        dialect = plan.dialect,
        text = includeText and plan.text or nil,
        edits = plan.edits,
        warnings = plan.warnings,
        written = written,
    }
end

local function run(options: any): integer
    local positional: {string} = options.files
    local paths: {string} = positional
    if #paths == 0 then
        return usageError("at least one source file is required")
    end
    local asJson = options.format == "json"
    local asking = options.check and true or false
    local dialect = options.dialect or "auto"
    local fs = require("nupp.compiler.fs")
    local planner = require("nupp.tools.migrate")
    local plans: {planner.Plan} = {}
    local errors: {string} = {}
    for _, path in ipairs(paths) do
        local source, readErr = fs.readFile(path)
        if not source then
            errors[#errors + 1] = path .. ": " .. tostring(readErr)
        else
            local plan, planErr = planner.plan(source, path, dialect)
            if not plan then
                errors[#errors + 1] = path .. ": " .. tostring(planErr)
            elseif fs.exists(plan.destination) then
                errors[#errors + 1] = plan.destination .. " already exists"
            else
                plans[#plans + 1] = plan
            end
        end
    end

    local public = {}
    local completed: {[any]: boolean} = {}
    if #errors == 0 and not asking then
        local parser = require("nupp.compiler.parser")
        local check = require("nupp.compiler.check")
        local diagnostics = require("nupp.compiler.diagnostics")
        local env = require("nupp.compiler.env").new(".")

        -- One failure stops the writing, not the reporting: every plan after it is
        -- still listed, as untouched, so a reader sees what was asked for and not
        -- only what was reached before the stop.
        local function attempt(plan: any): boolean
            local wrote, writeErr = fs.writeFile(plan.destination, plan.text)
            if not wrote then
                errors[#errors + 1] = plan.destination .. ": " .. tostring(writeErr)
                public[#public + 1] = publicPlan(plan, false, asJson)
                return false
            end
            local result = parser.parse(plan.text, plan.destination)
            local checked = #result.errors == 0 and check.check(result, plan.destination, env as {[string]: any})
                or result.errors
            local fatal = nil
            for _, diagnostic in ipairs(checked) do
                if diagnostics.isFatal(diagnostic) then
                    fatal = diagnostic
                    break
                end
            end
            if fatal then
                errors[#errors + 1] = plan.destination .. ": " .. fatal.code .. ": " .. fatal.msg
                public[#public + 1] = publicPlan(plan, true, asJson)
                return false
            end
            local removed, removeErr = os.remove(plan.source)
            if not removed then
                errors[#errors + 1] = plan.source .. ": " .. tostring(removeErr)
                public[#public + 1] = publicPlan(plan, true, asJson)
                return false
            end
            public[#public + 1] = publicPlan(plan, true, asJson)
            completed[plan] = true

            return true
        end

        local stopped = false
        for _, plan in ipairs(plans) do
            if stopped then
                public[#public + 1] = publicPlan(plan, false, asJson)
            else
                stopped = not attempt(plan)
            end
        end
    else
        for _, plan in ipairs(plans) do
            public[#public + 1] = publicPlan(plan, false, asJson)
        end
    end

    if asJson then
        require("nupp.tools.cli.report").write({
            ok = #errors == 0,
            check = asking,
            migrations = public,
            errors = errors,
        })
    else
        for _, plan in ipairs(plans) do
            -- A migration that failed or was never attempted after an earlier
            -- failure prints no success line: its story is the error below.
            if asking or completed[plan] then
                io.write(plan.source .. " -> " .. plan.destination .. (asking and " (planned)\n" or "\n"))
                for _, item in ipairs(plan.warnings) do
                    io.stderr:write(
                        ("%s:%d:%d: warning: %s: %s\n"):format(plan.source, item.line, item.col, item.code, item.msg)
                    )
                end
            end
        end
        for _, message in ipairs(errors) do
            io.stderr:write("nupp: " .. message .. "\n")
        end
    end

    return #errors == 0 and 0 or 1
end

--- Migrate typed foreign source into gradual Nupp.
---
--- Without --check, each destination is checked and written atomically before
--- its source is removed. Existing destinations are never replaced.
---
--- Examples:
---
---     nupp migrate --check src/legacy.lua
---     nupp migrate src/legacy.lua
---     nupp migrate --dialect luacats src/one.lua src/two.lua
@cli("migrate")
@derive(cliModule.Command)
local record Migrate
    --- Print the migration plan without changing files.
    check: boolean = false

    --- Resolve ambiguous comment annotations for this migration.
    @cli(value = "DIALECT")
    dialect: "auto" | "luacats" | "emmy" | "luadoc" = "auto"

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    --- Files to migrate.
    @cli(positional = "FILE")
    files: {string}

    function run(self): integer
        return run(self)
    end
end

function Migrate.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Migrate}
