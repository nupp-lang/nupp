module nupp.tools.cli.build

--[[
`nupp build`: source files, or a target the manifest configured.

Two shapes with one name. Naming files builds those files and everything they
require; naming none builds the manifest's default target. The manifest options
and the file options describe different jobs, so asking for both is refused
rather than resolved.
]]

local cliModule = require("nupp.cli")

local REPORT_SCHEMA = {
    type = "object",
    description = "What a build reported and what it produced.",
    properties = {
        diagnostics = require("nupp.tools.cli.report").DIAGNOSTICS,
        target = {type = "string", description = "The manifest target that was built."},
        platform = {type = "string", description = "The selected binary platform for a one-platform build."},
        distributionReady = {
            type = "boolean",
            description = "Whether the selected platform output is ready for public distribution."
        },
        notice = {type = "string"},
        platforms = {
            type = "array",
            description = "Per-platform outcomes for --platform all.",
            items = {
                type = "object",
                properties = {
                    platform = {type = "string"},
                    status = {type = "string", enum = {"built", "failed"}},
                    outputs = {type = "array", items = {type = "string"}},
                    error = {type = "string"},
                    distributionReady = {type = "boolean"},
                    notice = {type = "string"},
                },
                required = {"platform", "status", "outputs"},
            },
        },
        written = {
            type = "array",
            items = {type = "string"},
            description = "Every output path the build produced, sorted."
        },
        artifact = {
            type = "string",
            description = "The transportable artifact written by a bundle, binary, or component target."
        },
        spi = {
            type = "array",
            description = "Discovered SPI implementations in dependency order; selection belongs to the use site.",
            items = {
                type = "object",
                properties = {
                    interface = {type = "string"},
                    implementation = {type = "string"},
                    dependency = {type = "string"},
                },
                required = {"interface", "implementation", "dependency"},
            },
        },

        materializations = {
            type = "array",
            description = "Materialized expressions and their versioned provider and backend facts.",
            items = {
                type = "object",
                properties = {
                    source = {type = "string"},
                    line = {type = "integer"},
                    column = {type = "integer"},
                    provider = {type = "string"},
                    schema = {type = "integer"},
                    fingerprint = {type = "string"},
                    digest = {type = "string"},
                    backend = {type = "string"},
                    blueprintSize = {type = "integer"},
                    generatedSize = {type = "integer"},
                    runtimeFeatures = {type = "array", items = {type = "string"}},
                    abis = {type = "object"},
                },
                required = {
                    "source",
                    "line",
                    "column",
                    "provider",
                    "schema",
                    "fingerprint",
                    "backend",
                    "blueprintSize",
                    "generatedSize",
                    "runtimeFeatures",
                    "abis"
                },
            },
        },
        derives = {
            type = "array",
            description = "Closed derive recipes and their bounded generation facts.",
            items = {
                type = "object",
                properties = {
                    provider = {type = "string"},
                    owner = {type = "string"},
                    semanticFingerprint = {type = "string"},
                    generatedMembers = {type = "integer"},
                    canonicalBytes = {type = "integer"},
                    renderedBytes = {type = "integer"},
                    effects = {type = "array", items = {type = "string"}},
                    cached = {type = "boolean"},
                    durationMs = {type = "number"},
                    generatedLocals = {type = "integer"},
                    maxGeneratedUpvalues = {type = "integer"},
                },
                required = {
                    "provider",
                    "owner",
                    "semanticFingerprint",
                    "generatedMembers",
                    "canonicalBytes",
                    "renderedBytes",
                    "effects",
                    "cached",
                    "durationMs",
                    "generatedLocals",
                    "maxGeneratedUpvalues"
                },
            },
        },
        timing = {
            type = "object",
            description = "Where the build's wall-clock time went. Absent when a "
            .. "diagnostic stopped the build, since a run that did not finish has no "
            .. "account of itself to give.",
            properties = {
                totalMs = {type = "number", description = "Wall-clock milliseconds for the whole build."},
                compiledModules = {type = "integer"},
                reusedModules = {type = "integer"},
                parallel = require("nupp.tools.cli.report").PARALLEL,
                phases = {
                    type = "array",
                    description = "Every activity that took measurable time, longest "
                    .. "first. One activity is current at a time, so these sum to the whole. "
                    .. "A target with an ahead-of-time policy accounts for it separately "
                    .. "under aot:lookup, aot:check, aot:lower, aot:verify, aot:emit, aot:reuse, "
                    .. "aot:compile and aot:link -- respectively testing whether a completed policy "
                    .. "may be reused, checking the sources that carry an @aot body, "
                    .. "lowering them, verifying the lowered IR against the target, "
                    .. "writing the LLVM IR and the bindings, deciding what may be reused, "
                    .. "compiling objects or Wasm modules in process, and archiving or "
                    .. "linking what it produced. Plain aot is whatever the policy did "
                    .. "besides those.",
                    items = {
                        type = "object",
                        properties = {name = {type = "string"}, durationMs = {type = "number"}},
                        required = {"name", "durationMs"},
                    },
                },
                aot = {
                    type = "object",
                    description = "What the ahead-of-time policy did. Absent when the target has none.",
                    properties = {
                        checkedSources = {
                            type = "integer",
                            description = "Sources checked by the AOT policy in this build.",
                        },
                        loweredPrograms = {
                            type = "integer",
                            description = "Programs lowered by the AOT policy in this build.",
                        },
                    },
                    required = {"checkedSources", "loweredPrograms"},
                },
                slowest = {
                    type = "array",
                    description = "The costliest modules, longest first, each charged "
                    .. "for its own checking and generation and not for its dependencies'.",
                    items = {
                        type = "object",
                        properties = {module = {type = "string"}, durationMs = {type = "number"}},
                        required = {"module", "durationMs"},
                    },
                },
            },
            required = {"totalMs", "compiledModules", "reusedModules", "phases", "slowest",},
        },
        ok = {type = "boolean", description = "Whether the build completed. False when a " .. "diagnostic stopped it."},
    },
    required = {"ok", "diagnostics", "written", "materializations", "derives"},
}

local function run(options: any): integer
    local values = options
    -- `--output` names the manifest target's output directory.
    local projectOutDir: string? = values.output
    local target = values.target
    local reportMod = require("nupp.tools.cli.report")
    local asJson = values.format == "json"
    -- Under --json the diagnostics belong in the document rather than on stderr as they
    -- are found.
    local diagnostics: {any} = {}
    -- The same timing either way, and no narration when the reader is a program: it
    -- gets the numbers in the document it asked for. Naming --progress explicitly
    -- overrules that, which is how somebody watching a --json build sees it move.
    local progressMode = values.progress or (asJson and "never" or nil)
    local materializations: {any} = {}
    local derives: {any} = {}

    -- Ends the command with what the build produced.
    local function finish(code: integer, produced: {[string]: any}): integer
        if asJson then
            reportMod.write({
                ok = code == 0,
                diagnostics = reportMod.diagnosticValues(diagnostics),
                target = produced.target,
                platform = produced.platform,
                platforms = produced.platforms,
                distributionReady = produced.distributionReady,
                notice = produced.notice,
                written = produced.outputs or {},
                artifact = produced.artifact,
                materializations = produced.materializations or materializations,
                derives = produced.derives or derives,
                spi = produced.spi or {},
                timing = code == 0 and produced.timing or nil,
            })
        end

        return code
    end

    local project = require("nupp.tools.build.project")
    local produced: {[string]: any} = {}
    local code = project.build(".", {
        outDir = projectOutDir,
        target = target,
        platform = values.platform,
        host = values.host,
        diagnostics = asJson and diagnostics or nil,
        produced = asJson and produced or nil,
        progress = progressMode
    })

    return finish(code, produced)
end

--- Build a configured project target.
---
--- Builds the manifest's default or selected target. JSON output carries
--- diagnostics, written artifacts, materialization facts, and timing data.
--- Progress and timing stay on standard error so machine-readable standard
--- output remains one document.
---
--- Examples:
---
---     nupp build
---     nupp build --target app
---     nupp build --json
@cli("build")
@derive(cliModule.Command)
local record Build
    --- Build a named manifest target.
    @cli(value = "NAME")
    target: string?

    --- Build one configured binary platform, or all.
    @cli(value = "NAME")
    platform: string?

    --- Output directory, overriding the target's.
    @cli(short = "o", value = "DIR")
    output: string?

    --- Runtime host services.
    @cli(value = "HOST", choices = {"native", "browser"})
    host: string?

    --- When to report progress and timing.
    @cli(
        arity = "optionalAttached",
        constant = "always",
        constantAliases = {q = "never", quiet = "never"},
        choices = {"always", "never", "auto"},
        value = "WHEN"
    )
    progress: string?

    --- Select the report representation.
    @cli(value = "FORMAT", constantAliases = {json = "json", text = "text"})
    format: "text" | "json" = "text"

    --- Print the JSON Schema of JSON output and exit.
    schema: boolean = false

    function run(self): integer
        return run(self)
    end
end

function Build.reportSchema(): any
    return REPORT_SCHEMA
end

export = {commandType = Build}
